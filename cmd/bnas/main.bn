package "main"

import "pkg/binate/asm/assemble"
import "pkg/binate/version"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/stdx/flags"

// Binate assembler.
// Usage: bnas [-o output.o] [-arch aarch64|arm32|x64] input.s
//
// A thin CLI over pkg/binate/asm/assemble: parse args, then AssembleFile does
// the parse -> resolve -> finalize -> write pipeline (the same entry point bnc
// embeds to assemble its `.s` runtime files in-process).

// main is the entry point for the assembler CLI.
func main() {
	var args @[]@[]char = progArgs()

	var oFlag @[]char = ""
	var archName @[]char = ""
	var showVersion bool = false
	var fs @flags.FlagSet = flags.New("bnas")
	fs.StringVar(&oFlag, "o", "", "", "output object file (default: input .s -> .o)")
	fs.StringVar(&archName, "arch", "", "", "target architecture: aarch64 | arm32 | x64")
	fs.BoolVar(&showVersion, "version", "", "print version and exit")
	paths, perr := fs.Parse(args)

	if showVersion {
		fmt.Print("bnas-", version.Version, "\n")
		return
	}
	if len(perr) > 0 {
		printErr(perr, "\n")
		usage()
		os.Exit(1)
	}

	if len(paths) == 0 {
		usage()
		os.Exit(1)
	}
	if len(paths) > 1 {
		printErr("error: multiple input files not supported\n")
		os.Exit(1)
	}
	var inputPath @[]char = paths[0]

	// Default output: replace .s with .o.  oFlag is the mutable flag destination;
	// widen it to the readonly view AssembleFile takes.
	var outputPath @[]readonly char = oFlag
	if len(outputPath) == 0 {
		outputPath = defaultOutput(inputPath)
	}

	// The whole pipeline lives in pkg/binate/asm/assemble; a "" archName defers
	// to the file's `.arch` directive.
	ok, errMsg := assemble.AssembleFile(inputPath, outputPath, archName)
	if !ok {
		printErr("error: ", errMsg, "\n")
		os.Exit(1)
	}
}

// usage prints the assembler usage message to stderr.
func usage() {
	printErr("usage: bnas [-o output.o] [-arch aarch64|arm32|x64] input.s\n")
}

// progArgs returns bnas's own argument tokens: os.Args() minus the program-name
// slot at index 0, copied into a mutable @[]@[]char for parsing.  Reading argv
// through os.Args means that when bnas is run under
// the bytecode interpreter it sees the argv the interpreter installed via
// os.SetArgs, not the interpreter's own.
func progArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 {
		return make_slice(@[]char, 0)
	}
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		// full[i] is a readonly-qualified element; copy it char-by-char into an
		// owned, mutable @[]char (a readonly element can't be borrowed as the
		// mutable slice the parser holds).
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = full[i][j]
		}
		out[i - 1] = s
	}
	return out
}

// printErr writes a diagnostic to stderr via fmt.  The variadic *any takes a
// raw (*[]readonly char) or managed (@[]char) char-slice — and any mix — through
// the one formatter, so there is no need for a raw/managed overload split.
func printErr(args ...*any) {
	_, _ = fmt.Fprint(os.Stderr, args...)
}

// defaultOutput replaces a trailing `.s` with `.o`, or appends `.o`.
func defaultOutput(input @[]char) @[]readonly char {
	var s @[]char = input
	var n int = len(s)
	if n > 2 && s[n - 2] == '.' && s[n - 1] == 's' {
		var b @strings.Builder = strings.NewBuilder()
		b.Write(s[0:n - 2])
		b.Write(".o")
		return b.String()
	}
	var b @strings.Builder = strings.NewBuilder()
	b.Write(s)
	b.Write(".o")
	return b.String()
}
