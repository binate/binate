package "main"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/macho"
import "pkg/binate/asm/parse"
import "pkg/binate/buf"
import "pkg/binate/version"
import "pkg/bootstrap"
import "pkg/std/strings"

// Binate assembler.
// Usage: bnas [-o output.o] [-arch aarch64] input.s

// main is the entry point for the assembler CLI.
func main() {
	var args @[]@[]char = bootstrap.Args()

	var vi int = 0
	for vi < len(args) {
		if charsEqual(args[vi], "--version") {
			print("bnas-")
			println(version.Version)
			return
		}
		vi = vi + 1
	}

	var inputPath @[]char = ""
	var outputPath @[]readonly char = ""
	var archName @[]char = ""

	var i int = 0
	for i < len(args) {
		var arg @[]char = args[i]
		if charsEqual(arg, "-o") {
			i = i + 1
			if i >= len(args) {
				printErr("error: -o requires an argument\n")
				bootstrap.Exit(1)
			}
			outputPath = buf.CopyStr(args[i])
		} else if charsEqual(arg, "-arch") {
			i = i + 1
			if i >= len(args) {
				printErr("error: -arch requires an argument\n")
				bootstrap.Exit(1)
			}
			archName = buf.CopyStr(args[i])
		} else if len(arg) > 0 && arg[0] == '-' {
			printErr("error: unknown flag\n")
			usage()
			bootstrap.Exit(1)
		} else {
			if len(inputPath) > 0 {
				printErr("error: multiple input files not supported\n")
				bootstrap.Exit(1)
			}
			inputPath = buf.CopyStr(arg)
		}
		i = i + 1
	}

	if len(inputPath) == 0 {
		usage()
		bootstrap.Exit(1)
	}

	// Default output: replace .s with .o
	if len(outputPath) == 0 {
		outputPath = defaultOutput(inputPath)
	}

	// Create assembler
	var a @asm.Assembler = asm.New(8)
	var p @parse.Parser = parse.NewParser(a, inputPath)

	// If -arch specified on command line, set it before parsing
	if len(archName) > 0 {
		if charsEqual(archName, "aarch64") || charsEqual(archName, "arm64") {
			p.Arch = parse.ARCH_AARCH64
		} else {
			printErr("error: unknown architecture\n")
			bootstrap.Exit(1)
		}
	}

	// Parse input file
	p.ParseFile(inputPath)
	if p.HasError {
		printErrManaged(p.ErrorMsg)
		printErr("\n")
		bootstrap.Exit(1)
	}

	// Check that architecture was set
	if p.Arch == parse.ARCH_UNKNOWN {
		printErr("error: no architecture specified (use .arch directive or -arch flag)\n")
		bootstrap.Exit(1)
	}

	// Resolve fixups
	if p.Arch == parse.ARCH_AARCH64 {
		aarch64.ResolveFixups(a)
	}

	// Finalize
	var ok bool = a.Finalize()
	if !ok || a.HasError {
		printErr("error: assembly failed\n")
		bootstrap.Exit(1)
	}

	// Write output
	var writeOk bool = false
	if p.Arch == parse.ARCH_AARCH64 {
		writeOk = macho.WriteARM64(a, outputPath)
	}
	if !writeOk {
		printErr("error: failed to write output file\n")
		bootstrap.Exit(1)
	}
}

// usage prints the assembler usage message to stderr.
func usage() {
	printErr("usage: bnas [-o output.o] [-arch aarch64] input.s\n")
}

// charsEqual returns true if two char slices have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// printErr writes a raw char slice to stderr.
func printErr(msg *[]readonly char) {
	bootstrap.Write(bootstrap.STDERR, msg)
}

// printErrManaged writes a managed char slice to stderr.
func printErrManaged(msg @[]char) {
	bootstrap.Write(bootstrap.STDERR, msg)
}

// Replace .s extension with .o, or append .o
func defaultOutput(input @[]char) @[]readonly char {
	var s @[]char = input
	var n int = len(s)
	if n > 2 && s[n - 2] == '.' && s[n - 1] == 's' {
		var b @strings.Builder = strings.NewBuilder()
		b.Write(s[0:n-2])
		b.Write(".o")
		return b.String()
	}
	var b @strings.Builder = strings.NewBuilder()
	b.Write(s)
	b.Write(".o")
	return b.String()
}
