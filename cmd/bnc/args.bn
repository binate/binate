package "main"

import "pkg/binate/buf"
import "pkg/stdx/flags"

// CLIArgs holds the parsed command-line arguments for the compiler.
type CLIArgs struct {
	Filenames   @[]@[]char
	Output      @[]char
	EmitLLVM    bool
	CompileOnly bool
	ListDeps    bool // --list-deps: print every package the program depends on
	// (the full transitive set, in dependency order, one per
	// line) to stdout and exit, without type-checking or
	// compiling.  Drives external separate/incremental builds
	// (compile each listed package to a .o, then link) — the
	// program-assembly counterpart of `--pkg`.
	RuntimePath @[]char // --runtime <path>: NOT linked (bnc links no C runtime;
	// the runtime is pure Binate — pkg/builtins/rt + startup).  Retained only
	// for its DIRECTORY: a bare-metal target resolves its runtime inputs
	// (crt0.s / semihost.s / linker script) relative to dirOf(--runtime), so a
	// baremetal build passes `--runtime <dir>/crt0.s`.  A host build needs no C
	// runtime and passes no --runtime.
	PkgFlag     @[]char
	LibraryFlag @[]char // --library <pkg>: compile a facade package + its
	// transitive closure into a static archive (.a) that a C
	// program links and inits once via the well-known `bn_init`
	// symbol, then calls its `#[c_export]`'d functions.
	Debug    bool
	Verbose  bool
	TestMode bool
	VerifyIR bool // --verify-ir: run the structural IR verifier after
	// IR-gen and abort on malformed IR (off by default;
	// for CI / debugging).  See ir.SetVerifyIR.
	ClangFlags @[]@[]char
	OptLevel   int // -O0..-O3 / --optimize-level: IR optimization level (0 = none
	// = default).  DISTINCT from --cflag -On: this gates ir.RunOptPasses.  On the
	// LLVM backend, -On additionally implies a clang -On (prepended to ClangFlags,
	// so an explicit --cflag -O* still wins via clang's last-wins).  On the
	// native backend it only sets the IR level (clang is link-only there).
	Backend  @[]char // "" = default (LLVM); "native" = pkg/binate/native (aarch64 only for now)
	KeepObjs bool // --keep-objs: don't delete intermediate .o files (debugging aid)
	BuildDir @[]char // --build-dir <dir>: write intermediate .ll/.o (and the
	// default --test binary) under <dir>/.  The directory must
	// exist; bnc does not create it.  When unset, a linking build
	// creates its own unique temp dir for intermediates (so
	// concurrent builds never collide) and a deliverable-object
	// build (-c / --pkg / --library) writes to the current dir.
	BniPaths @[]@[]char // -I / --interface-path: append-and-split (':') list
	// of dirs searched for `<dir>/<path>.bni` interface
	// files.  Cc-style — repeatable, colon-separated.
	ImplPaths @[]@[]char // -L / --impl-path: same shape, for `<dir>/<path>/`
	// impl directories.
	Target @[]char // --target: target triple key (e.g. "host",
	// "arm32-linux").  Empty / "host" leaves the
	// current LP64 layout defaults in place.
	// Unknown values cause main() to exit with
	// an error before any compilation begins.
	Linker @[]char // --linker <clang|bnld>: which driver performs the final
	// link.  Default (empty) / "clang" = clang (the full C driver, all
	// targets).  "bnld" = the self-hosted linker (pkg/binate/link), ELF
	// linux-x64 / linux-aarch64 only for now — see linkWithBnld.
	LinkAfterObjs @[]@[]char // --link-after-objs <path>: extra positional
	// inputs for clang, appended AFTER the .o
	// files and AFTER targetRuntimeFiles. Used
	// by bare-metal runners to pass libgcc.a
	// whose path depends on the host's toolchain
	// layout (apt vs brew vs ...).  Repeatable.
	// Archive order matters: lld only pulls
	// symbols from an archive listed AFTER its
	// consumers.
	ShowVersion bool // --version: print the build identifier and exit (checked
	// in main() before any positional-count validation).
	Error @[]readonly char // non-empty iff arg parsing failed (unknown flag,
	// missing value, or conflicting/out-of-range optimization-level flags); a
	// ready-to-print message that main() prints before exiting.
}

// parseArgs parses compiler command-line arguments via pkg/stdx/flags.  Parsing
// stops at the first positional (the source file/dir or --test package); flags
// do not intersperse with positionals.  On a bad flag / missing value the parsed
// CLIArgs carries a non-empty Error for main() to print.  cmd/bnc imports the
// pkg/stdx/flags forwarder rather than pkg/std/flags because it is BUILDER-
// compiled and the pinned BUILDER bundle ships pkg/stdx/flags but not
// pkg/std/flags (in the tree, pkg/stdx/flags forwards to pkg/std/flags); see
// scripts/hygiene/stdx-forwarder-imports.sh.  It moves to pkg/std/flags on the
// next BUILDER bump.
func parseArgs(args @[]@[]char) CLIArgs {
	var result CLIArgs
	// The -O level has two spellings: the -O0..-O3 bool flags and the value form
	// --optimize-level.  optLevel = -1 means the value form was not given.
	var o0 bool
	var o1 bool
	var o2 bool
	var o3 bool
	var optLevel int = -1

	var fs @flags.FlagSet = flags.New("bnc")
	fs.BoolVar(&result.ShowVersion, "version", "", "print the build identifier and exit")
	fs.BoolVar(&result.Debug, "debug", "g", "emit debug info")
	fs.BoolVar(&result.Verbose, "verbose", "v", "verbose output")
	fs.BoolVar(&result.TestMode, "test", "", "compile the target package's tests into a test binary")
	fs.BoolVar(&result.VerifyIR, "verify-ir", "", "run the structural IR verifier after IR-gen")
	fs.BoolVar(&result.EmitLLVM, "emit-llvm", "", "emit LLVM IR text instead of a native binary")
	fs.BoolVar(&result.ListDeps, "list-deps", "", "print the transitive package dependencies and exit")
	fs.BoolVar(&result.CompileOnly, "c", "", "compile to a .o object without linking")
	fs.BoolVar(&result.KeepObjs, "keep-objs", "", "keep intermediate .o files")
	fs.BoolVar(&o0, "O0", "", "IR optimization level 0 (the default)")
	fs.BoolVar(&o1, "O1", "", "IR optimization level 1")
	fs.BoolVar(&o2, "O2", "", "IR optimization level 2")
	fs.BoolVar(&o3, "O3", "", "IR optimization level 3")
	fs.IntVar(&optLevel, "optimize-level", "", -1,
			"IR optimization level 0..3 (value form of -O0..-O3)")
	fs.StringVar(&result.Output, "o", "", "", "output path")
	fs.StringVar(&result.RuntimePath, "runtime", "", "",
			"runtime directory (bare-metal inputs resolve relative to it)")
	fs.StringVar(&result.Linker, "linker", "", "", "final linker: clang (default) or bnld")
	fs.StringVar(&result.PkgFlag, "pkg", "", "", "compile a single package to a .o")
	fs.StringVar(&result.LibraryFlag, "library", "", "",
			"compile a facade package + its closure into a static archive")
	fs.StringVar(&result.BuildDir, "build-dir", "", "",
			"directory for intermediate .ll/.o (must already exist)")
	fs.StringVar(&result.Backend, "backend", "", "", "codegen backend: llvm (default) or native")
	fs.StringVar(&result.Target, "target", "", "", "target key (e.g. host, arm32-linux)")
	fs.StringListVar(&result.ClangFlags, "cflag", "",
			"extra flag passed through to clang (repeatable)")
	fs.StringListVar(&result.LinkAfterObjs, "link-after-objs", "",
			"extra clang input appended after the .o files (repeatable)")
	fs.StringListSepVar(&result.BniPaths, "interface-path", "I", ':',
			"interface (.bni) search path, colon-separated (repeatable)")
	fs.StringListSepVar(&result.ImplPaths, "impl-path", "L", ':',
			"impl search path, colon-separated (repeatable)")

	var perr @[]readonly char
	result.Filenames, perr = fs.Parse(args)
	if len(perr) > 0 {
		result.Error = buf.CopyStr(perr)
		return result
	}

	// Exactly one optimization-level source at most: the -O0..-O3 bool flags and
	// the --optimize-level value form are mutually exclusive.
	var nOpt int = 0
	if o0 {
		nOpt = nOpt + 1
	}
	if o1 {
		nOpt = nOpt + 1
	}
	if o2 {
		nOpt = nOpt + 1
	}
	if o3 {
		nOpt = nOpt + 1
	}
	if optLevel >= 0 {
		nOpt = nOpt + 1
	}
	if nOpt > 1 {
		result.Error = "bnc: at most one of -O0 / -O1 / -O2 / -O3 / --optimize-level may be given"
		return result
	}
	if optLevel >= 0 {
		if optLevel > 3 {
			result.Error = "bnc: --optimize-level must be 0, 1, 2, or 3"
			return result
		}
		result.OptLevel = optLevel
	} else if o3 {
		result.OptLevel = 3
	} else if o2 {
		result.OptLevel = 2
	} else if o1 {
		result.OptLevel = 1
	}

	// -On implies a clang -On on the LLVM backend, so a single knob asks for
	// optimization.  Prepend it so an explicit --cflag -O* still wins (clang
	// honors the last -O on its command line).  On the native backend clang
	// only links, so the implication is inert and -On sets just the IR level.
	if result.OptLevel > 0 && !streq(result.Backend, "native") {
		var withOpt @[]@[]char
		withOpt = appendRawCharSlice(withOpt, optFlagLiteral(result.OptLevel))
		for k := 0; k < len(result.ClangFlags); k++ {
			withOpt = appendRawCharSlice(withOpt, result.ClangFlags[k])
		}
		result.ClangFlags = withOpt
	}
	return result
}

// optFlagLiteral maps an IR opt level (1..3) to the clang -O flag it implies on
// the LLVM backend.  Level 0 skips the implication, so only 1..3 reach here.
func optFlagLiteral(level int) *[]readonly char {
	if level == 1 {
		return "-O1"
	}
	if level == 3 {
		return "-O3"
	}
	return "-O2"
}
