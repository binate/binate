package "main"

import "pkg/stdx/slices"

// CLIArgs holds the parsed command-line arguments for the compiler.
type CLIArgs struct {
	Filenames   @[]@[]char
	Output      @[]char
	EmitLLVM    bool
	CompileOnly bool
	ListDeps    bool // --list-deps: print every package the program depends on
	// (the full transitive set, in dependency order, one per
	// line) to stdout and exit, without type-checking or
	// compiling.  Drives external separate/incremental builds
	// (compile each listed package to a .o, then link) — the
	// program-assembly counterpart of `--pkg`.
	RuntimePath @[]char
	PkgFlag     @[]char
	LibraryFlag @[]char // --library <pkg>: compile a facade package + its
	// transitive closure into a static archive (.a) that a C
	// program links and inits once via the well-known `bn_init`
	// symbol, then calls its `#[c_export]`'d functions.  See
	// explorations/plan-ffi-export-detailed.md.
	Debug    bool
	Verbose  bool
	TestMode bool
	VerifyIR bool // --verify-ir: run the structural IR verifier after
	// IR-gen and abort on malformed IR (off by default;
	// for CI / debugging).  See ir.SetVerifyIR.
	ClangFlags @[]@[]char
	Backend    @[]char // "" = default (LLVM); "native" = pkg/binate/native (aarch64 only for now)
	KeepObjs   bool // --keep-objs: don't delete intermediate .o files (debugging aid)
	BuildDir   @[]char // --build-dir <dir>: write intermediate .ll/.o (and the
	// default --test binary) under <dir>/ instead of the
	// shared /tmp/binate_* path. The directory must exist;
	// bnc does not create it. Lets concurrent test runners
	// avoid clobbering each other's intermediates.
	BniPaths @[]@[]char // -I / --interface-path: append-and-split (':') list
	// of dirs searched for `<dir>/<path>.bni` interface
	// files.  Cc-style — repeatable, colon-separated.
	ImplPaths @[]@[]char // -L / --impl-path: same shape, for `<dir>/<path>/`
	// impl directories.
	Target @[]char // --target: target triple key (e.g. "host",
	// "arm32-linux").  Empty / "host" leaves the
	// current LP64 layout defaults in place.
	// Unknown values cause main() to exit with
	// an error before any compilation begins.
	LinkAfterObjs @[]@[]char // --link-after-objs <path>: extra positional
	// inputs for clang, appended AFTER the .o
	// files and AFTER targetRuntimeFiles. Used
	// by bare-metal runners to pass libgcc.a
	// whose path depends on the host's toolchain
	// layout (apt vs brew vs ...).  Repeatable.
	// Archive order matters: lld only pulls
	// symbols from an archive listed AFTER its
	// consumers.
}

// hasVersionFlag reports whether `--version` appears anywhere in args.
// Checked before the rest of arg parsing so `bnc --version` prints the
// build identifier and exits without needing a source-file argument.
func hasVersionFlag(args @[]@[]char) bool {
	for i := 0; i < len(args); i++ {
		if streq(args[i], "--version") {
			return true
		}
	}
	return false
}

// parseArgs parses compiler command-line arguments.
func parseArgs(args @[]@[]char) CLIArgs {
	var result CLIArgs
	for i := 0; i < len(args); i++ {
		if streq(args[i], "-g") || streq(args[i], "--debug") {
			result.Debug = true
		} else if streq(args[i], "-v") || streq(args[i], "--verbose") {
			result.Verbose = true
		} else if streq(args[i], "-test") || streq(args[i], "--test") {
			result.TestMode = true
		} else if streq(args[i], "--verify-ir") {
			result.VerifyIR = true
		} else if streq(args[i], "--emit-llvm") {
			result.EmitLLVM = true
		} else if streq(args[i], "--list-deps") {
			result.ListDeps = true
		} else if streq(args[i], "-c") {
			result.CompileOnly = true
		} else if streq(args[i], "-o") {
			i++
			if i < len(args) {
				result.Output = args[i]
			}
		} else if streq(args[i], "--runtime") {
			i++
			if i < len(args) {
				result.RuntimePath = args[i]
			}
		} else if streq(args[i], "--pkg") {
			i++
			if i < len(args) {
				result.PkgFlag = args[i]
			}
		} else if streq(args[i], "--library") {
			i++
			if i < len(args) {
				result.LibraryFlag = args[i]
			}
		} else if streq(args[i], "--cflag") {
			i++
			if i < len(args) {
				result.ClangFlags = appendRawCharSlice(result.ClangFlags, args[i])
			}
		} else if streq(args[i], "--keep-objs") {
			result.KeepObjs = true
		} else if streq(args[i], "--build-dir") {
			i++
			if i < len(args) {
				result.BuildDir = args[i]
			}
		} else if streq(args[i], "-I") || streq(args[i], "--interface-path") {
			i++
			if i < len(args) {
				var parts @[]@[]char = splitColon(args[i])
				for j := 0; j < len(parts); j++ {
					result.BniPaths = slices.Append[@[]char](result.BniPaths, parts[j])
				}
			}
		} else if streq(args[i], "-L") || streq(args[i], "--impl-path") {
			i++
			if i < len(args) {
				var parts @[]@[]char = splitColon(args[i])
				for j := 0; j < len(parts); j++ {
					result.ImplPaths = slices.Append[@[]char](result.ImplPaths, parts[j])
				}
			}
		} else if streq(args[i], "-backend") || streq(args[i], "--backend") {
			i++
			if i < len(args) {
				result.Backend = args[i]
			}
		} else if streq(args[i], "--target") {
			i++
			if i < len(args) {
				result.Target = args[i]
			}
		} else if streq(args[i], "--link-after-objs") {
			i++
			if i < len(args) {
				result.LinkAfterObjs = appendRawCharSlice(result.LinkAfterObjs, args[i])
			}
		} else {
			result.Filenames = appendRawCharSlice(result.Filenames, args[i])
		}
	}
	return result
}
