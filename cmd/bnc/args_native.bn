package "main"

import "pkg/binate/buf"
import "pkg/binate/native/place"
import "pkg/std/flags"
import "pkg/std/strconv"

// nativeFlags holds the native-backend switches as parsed, between their
// registration (registerNativeFlags) and their validation into CLIArgs
// (applyNativeFlags).  The placement switches are kept as every value given, in
// order, so that a switch given as 0 or as an empty value is told apart from one
// not given at all; the last value given wins.
type nativeFlags struct {
	raxHome    bool
	noRaxHome  bool
	farDisp    int
	placeSeed  @[]@[]char
	placeMode  @[]@[]char
	probe      @[]@[]char
	probePhase @[]@[]char
}

// registerNativeFlags adds the native-backend code-generation switches to fs,
// bound to nf.  They are not IR passes, so they stay out of optflags (and so out
// of --list-opt-passes); printUsage does not list them.
//
// -fnative-place-seed=S and -fnative-place-mode=phase|shift randomize where each
// function lands in .text (place.PlaceOptions), a measurement aid for telling a
// code change's effect apart from the effect of the addresses it moves.
// -fnative-place-probe=SYM and -fnative-place-probe-phase=P put the one function
// whose mangled symbol is SYM at phase P while the code after it stays put, a
// measurement aid for what that function's own placement does.
func registerNativeFlags(fs @flags.FlagSet, nf *nativeFlags) {
	fs.BoolVar(&nf.raxHome, "fx64-rax-home", "", "native x64 backend: also home values in RAX")
	fs.BoolVar(&nf.noRaxHome, "fno-x64-rax-home", "",
			"native x64 backend: keep RAX out of the home pool (the default)")
	fs.IntVar(&nf.farDisp, "fx64-far-disp", "", 0,
			"native x64 backend (test aid): address frame slots past this displacement through a register")
	fs.StringListVar(&nf.placeSeed, "fnative-place-seed", "",
			"native backends: randomize function placement with this seed (0 = off)")
	fs.StringListVar(&nf.placeMode, "fnative-place-mode", "",
			"native function placement: phase (the default) or shift")
	fs.StringListVar(&nf.probe, "fnative-place-probe", "",
			"native function placement: probe the function with this mangled symbol")
	fs.StringListVar(&nf.probePhase, "fnative-place-probe-phase", "",
			"native function placement: the phase (0..63) of the probed function")
}

// applyNativeFlags validates nf into result.NativeOpts, or sets result.Error.
//
// The placement switches follow these rules (the one place they are stated).  Any
// of them given at all, even as -fnative-place-seed=0, is an error without
// --backend native, and with --emit-llvm (which prints LLVM IR whatever the
// backend): they are a measurement contract, so unlike -fx64-rax-home (inert off
// x64) they must not be silently ignored.  The seed must be a decimal
// integer in 0..place.PLACE_SEED_MAX, the mode phase or shift (an empty value is
// an unknown mode), and a mode needs a seed given with it.  Seed 0 turns the
// seeded filler off whatever the mode, so `--backend native
// -fnative-place-seed=0 -fnative-place-mode=M` is accepted and emits exactly what
// no placement switch does: the control arm of a seeded measurement.  The mode
// defaults to phase.  A probe needs a symbol that is not empty and a probe phase,
// a probe phase needs a probe, and the phase must be a non-negative decimal
// integer; whether it is a multiple of the target's filler unit below
// place.PLACE_SPAN is the backend's check (place.PlaceCheck), which fails the
// compile.  A probe works at any seed, seed 0 (or no seed switch) included.
func applyNativeFlags(nf *nativeFlags, result *CLIArgs) {
	if nf.raxHome && nf.noRaxHome {
		result.Error = "bnc: both -fx64-rax-home and -fno-x64-rax-home given"
		return
	}
	result.NativeOpts.X64RaxHome = nf.raxHome
	if nf.farDisp < 0 {
		result.Error = "bnc: -fx64-far-disp needs a displacement of 0 or more"
		return
	}
	result.NativeOpts.X64FarDisp = nf.farDisp

	var probing bool = len(nf.probe) > 0 || len(nf.probePhase) > 0
	if len(nf.placeSeed) == 0 && len(nf.placeMode) == 0 && !probing { return }
	if !streq(result.Backend, "native") {
		result.Error = "bnc: the -fnative-place-* switches need --backend native"
		return
	}
	if result.EmitLLVM {
		result.Error = "bnc: the -fnative-place-* switches do not apply to --emit-llvm "
				"(LLVM IR has no placement)"
		return
	}
	applyPlaceSeed(nf, result)
	if len(result.Error) == 0 && probing { applyPlaceProbe(nf, result) }
}

// applyPlaceSeed validates -fnative-place-seed / -fnative-place-mode into
// result.NativeOpts.Place (see applyNativeFlags), or sets result.Error.
func applyPlaceSeed(nf *nativeFlags, result *CLIArgs) {
	var seedGiven bool = len(nf.placeSeed) > 0
	var modeGiven bool = len(nf.placeMode) > 0
	var mode int = place.PLACE_PHASE
	if modeGiven {
		var m @[]char = nf.placeMode[len(nf.placeMode) - 1]
		if streq(m, "shift") {
			mode = place.PLACE_SHIFT
		} else if !streq(m, "phase") {
			result.Error = buf.Concat(buf.Concat("bnc: -fnative-place-mode: \"", m),
					"\" is not phase or shift")
			return
		}
	}
	result.NativeOpts.Place.Mode = mode
	if !seedGiven {
		if modeGiven { result.Error = "bnc: -fnative-place-mode needs -fnative-place-seed" }
		return
	}
	var s @[]char = nf.placeSeed[len(nf.placeSeed) - 1]
	seed, err := strconv.ParseInt(s, 10, 64)
	if present(err) || seed < 0 || seed > cast(int64, place.PLACE_SEED_MAX) {
		var msg @[]char = buf.Concat(buf.Concat("bnc: -fnative-place-seed: \"", s),
				"\" is not a decimal integer in 0..")
		result.Error = buf.Concat(msg, strconv.Itoa(place.PLACE_SEED_MAX))
		return
	}
	result.NativeOpts.Place.Seed = cast(int, seed)
}

// applyPlaceProbe validates -fnative-place-probe / -fnative-place-probe-phase into
// result.NativeOpts.Place (see applyNativeFlags), or sets result.Error.
func applyPlaceProbe(nf *nativeFlags, result *CLIArgs) {
	if len(nf.probe) == 0 {
		result.Error = "bnc: -fnative-place-probe-phase needs -fnative-place-probe"
		return
	}
	var sym @[]char = nf.probe[len(nf.probe) - 1]
	if len(sym) == 0 {
		result.Error = "bnc: -fnative-place-probe needs a symbol"
		return
	}
	if len(nf.probePhase) == 0 {
		result.Error = "bnc: -fnative-place-probe needs -fnative-place-probe-phase"
		return
	}
	var s @[]char = nf.probePhase[len(nf.probePhase) - 1]
	// 32 bits, so the value survives the cast to int on an ILP32 host too.
	phase, err := strconv.ParseInt(s, 10, 32)
	if present(err) || phase < 0 {
		result.Error = buf.Concat(buf.Concat("bnc: -fnative-place-probe-phase: \"", s),
				"\" is not a non-negative decimal integer")
		return
	}
	result.NativeOpts.Place.ProbeSym = sym
	result.NativeOpts.Place.ProbePhase = cast(int, phase)
}
