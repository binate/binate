package "main"

import "pkg/binate/buf"
import "pkg/binate/native/place"
import "pkg/std/flags"
import "pkg/std/strconv"

// nativeFlags holds the native-backend switches as parsed, between their
// registration (registerNativeFlags) and their validation into CLIArgs
// (applyNativeFlags).  The placement switches are kept as every value given, in
// order, so that a switch given as 0 or as an empty value is told apart from one
// not given at all; the last value given wins.
type nativeFlags struct {
	raxHome   bool
	noRaxHome bool
	placeSeed @[]@[]char
	placeMode @[]@[]char
}

// registerNativeFlags adds the native-backend code-generation switches to fs,
// bound to nf.  They are not IR passes, so they stay out of optflags (and so out
// of --list-opt-passes); printUsage does not list them.
//
// -fnative-place-seed=S and -fnative-place-mode=phase|shift randomize where each
// function lands in .text (place.PlaceOptions), a measurement aid for telling a
// code change's effect apart from the effect of the addresses it moves.
func registerNativeFlags(fs @flags.FlagSet, nf *nativeFlags) {
	fs.BoolVar(&nf.raxHome, "fx64-rax-home", "", "native x64 backend: also home values in RAX")
	fs.BoolVar(&nf.noRaxHome, "fno-x64-rax-home", "",
			"native x64 backend: keep RAX out of the home pool (the default)")
	fs.StringListVar(&nf.placeSeed, "fnative-place-seed", "",
			"native backends: randomize function placement with this seed (0 = off)")
	fs.StringListVar(&nf.placeMode, "fnative-place-mode", "",
			"native function placement: phase (the default) or shift")
}

// applyNativeFlags validates nf into result.NativeOpts, or sets result.Error.
//
// The placement switches follow this rule (the one place it is stated).  Either
// one given at all, even as -fnative-place-seed=0, is an error without --backend
// native: they are a measurement contract, so unlike -fx64-rax-home (inert off
// x64) they must not be silently ignored.  The seed must be a decimal integer in
// 0..place.PLACE_SEED_MAX, the mode phase or shift (an empty value is an unknown
// mode), and a mode needs a seed given with it.  Seed 0 turns placement off
// whatever the mode, so `--backend native -fnative-place-seed=0
// -fnative-place-mode=M` is accepted and emits exactly what no placement switch
// does: the control arm of a seeded measurement.  The mode defaults to phase.
func applyNativeFlags(nf *nativeFlags, result *CLIArgs) {
	if nf.raxHome && nf.noRaxHome {
		result.Error = "bnc: both -fx64-rax-home and -fno-x64-rax-home given"
		return
	}
	result.NativeOpts.X64RaxHome = nf.raxHome

	var seedGiven bool = len(nf.placeSeed) > 0
	var modeGiven bool = len(nf.placeMode) > 0
	if !seedGiven && !modeGiven { return }
	if !streq(result.Backend, "native") {
		result.Error = "bnc: -fnative-place-seed / -fnative-place-mode need --backend native"
		return
	}
	var mode int = place.PLACE_PHASE
	if modeGiven {
		var m @[]char = nf.placeMode[len(nf.placeMode) - 1]
		if streq(m, "shift") {
			mode = place.PLACE_SHIFT
		} else if !streq(m, "phase") {
			result.Error = buf.Concat(buf.Concat("bnc: -fnative-place-mode: \"", m),
					"\" is not phase or shift")
			return
		}
	}
	if !seedGiven {
		result.Error = "bnc: -fnative-place-mode needs -fnative-place-seed"
		return
	}
	var s @[]char = nf.placeSeed[len(nf.placeSeed) - 1]
	seed, err := strconv.ParseInt(s, 10, 64)
	if present(err) || seed < 0 || seed > cast(int64, place.PLACE_SEED_MAX) {
		var msg @[]char = buf.Concat(buf.Concat("bnc: -fnative-place-seed: \"", s),
				"\" is not a decimal integer in 0..")
		result.Error = buf.Concat(msg, strconv.Itoa(place.PLACE_SEED_MAX))
		return
	}
	result.NativeOpts.Place.Seed = cast(int, seed)
	result.NativeOpts.Place.Mode = mode
}
