package "main"

import "pkg/binate/buf"
import "pkg/binate/iropt"
import "pkg/binate/native/blockplan"
import "pkg/builtins/testing"

// parseArgs tests for -fnative-block-layout, as it lands in
// CLIArgs.NativeOpts.BlockLayout.

// The block layout is source when the switch is not given, on either backend.
func TestParseArgsNativeBlockLayoutDefault() testing.TestResult {
	var plain CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "foo.bn"})
	if len(plain.Error) > 0 { return fail("unexpected parse error") }
	if plain.NativeOpts.BlockLayout != blockplan.BLOCK_LAYOUT_SOURCE {
		return fail("the block layout must be source by default")
	}
	var llvm CLIArgs = parseArgs(@[]@[]char{"foo.bn"})
	if len(llvm.Error) > 0 || llvm.NativeOpts.BlockLayout != blockplan.BLOCK_LAYOUT_SOURCE {
		return fail("the LLVM backend must leave the block layout source")
	}
	return ""
}

// Each value sets its mode, in either spelling, and leaves the IR passes, the -O
// level and the clang flags alone; the last value given wins.
func TestParseArgsFNativeBlockLayout() testing.TestResult {
	var base CLIArgs = parseArgs(@[]@[]char{"-O2", "--backend", "native", "foo.bn"})
	var src CLIArgs = parseArgs(
			@[]@[]char{"-O2", "--backend", "native", "-fnative-block-layout=source", "foo.bn"})
	if len(src.Error) > 0 { return fail("unexpected parse error for source") }
	if src.NativeOpts.BlockLayout != blockplan.BLOCK_LAYOUT_SOURCE {
		return fail("source must set source")
	}
	var ft CLIArgs = parseArgs(
			@[]@[]char{"-O2", "--backend", "native", "-fnative-block-layout=fallthrough", "foo.bn"})
	if len(ft.Error) > 0 { return fail("unexpected parse error for fallthrough") }
	if ft.NativeOpts.BlockLayout != blockplan.BLOCK_LAYOUT_FALLTHROUGH {
		return fail("fallthrough must set fallthrough")
	}
	if ft.Opt.Passes != base.Opt.Passes { return fail("the switch must not change the IR passes") }
	if ft.OptLevel != base.OptLevel { return fail("the switch must not change the -O level") }
	if len(ft.ClangFlags) != len(base.ClangFlags) {
		return fail("the switch must not change the clang flags")
	}
	var dd CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "--fnative-block-layout", "fallthrough", "foo.bn"})
	if len(dd.Error) > 0 || dd.NativeOpts.BlockLayout != blockplan.BLOCK_LAYOUT_FALLTHROUGH {
		return fail("--fnative-block-layout fallthrough must set fallthrough")
	}
	var twice CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "-fnative-block-layout=fallthrough",
					"-fnative-block-layout=source", "foo.bn"})
	if len(twice.Error) > 0 || twice.NativeOpts.BlockLayout != blockplan.BLOCK_LAYOUT_SOURCE {
		return fail("the last -fnative-block-layout must win")
	}
	return ""
}

// A value that names no layout, an empty one included, is an error naming the
// switch.
func TestParseArgsNativeBlockLayoutBadValues() testing.TestResult {
	var values @[]@[]char = @[]@[]char{"", "random", "Source", "fall", "fallthrough "}
	for i := 0; i < len(values); i++ {
		var arg @[]char = buf.Concat("-fnative-block-layout=", values[i])
		var cli CLIArgs = parseArgs(@[]@[]char{"--backend", "native", arg, "foo.bn"})
		if !containsStr(cli.Error, "-fnative-block-layout") {
			return fail("a value that names no layout must be an error naming the switch")
		}
	}
	return ""
}

// The switch, given at all, source included, is an error without --backend native.
func TestParseArgsNativeBlockLayoutNeedsNativeBackend() testing.TestResult {
	var values @[]@[]char = @[]@[]char{"source", "fallthrough", "random"}
	for i := 0; i < len(values); i++ {
		var arg @[]char = buf.Concat("-fnative-block-layout=", values[i])
		if !containsStr(parseArgs(@[]@[]char{arg, "foo.bn"}).Error, "needs --backend native") {
			return fail("the switch without --backend native must be an error")
		}
		if !placeArgsRejected(@[]@[]char{"--backend", "llvm", arg, "foo.bn"}) {
			return fail("the switch with --backend llvm must be an error")
		}
	}
	return ""
}

// The switch, given at all, is an error with --emit-llvm, which prints LLVM IR
// whatever the backend and so would drop the layout.
func TestParseArgsNativeBlockLayoutRejectsEmitLLVM() testing.TestResult {
	var values @[]@[]char = @[]@[]char{"source", "fallthrough"}
	for i := 0; i < len(values); i++ {
		var arg @[]char = buf.Concat("-fnative-block-layout=", values[i])
		var cli CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "--emit-llvm", arg, "foo.bn"})
		if !containsStr(cli.Error, "does not apply to --emit-llvm") {
			return fail("the switch with --emit-llvm must be an error")
		}
	}
	return ""
}

// The switch is registered next to the IR passes' -f<pass> flags, and the flag set
// takes the first registration of a name, so an IR pass of the same name would
// capture it.
func TestNativeBlockLayoutNotAnIRPassName() testing.TestResult {
	if iropt.OptPassByName("native-block-layout") >= 0 {
		return fail("native-block-layout must not also be an IR pass name")
	}
	return ""
}
