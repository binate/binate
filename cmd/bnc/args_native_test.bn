package "main"

import "pkg/binate/iropt"
import "pkg/binate/native/place"
import "pkg/builtins/testing"

// parseArgs tests for the native-backend code-generation switches, as they land
// in CLIArgs.NativeOpts.  They are not IR passes, so they leave CLIArgs.Opt alone.

func TestParseArgsX64RaxHomeDefaultOff() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.NativeOpts.X64RaxHome { return fail("RAX homes must be off by default") }
	return ""
}

func TestParseArgsFX64RaxHome() testing.TestResult {
	// -O0 runs no IR pass, so a switch that leaked into the passes would show.
	var base CLIArgs = parseArgs(@[]@[]char{"-O0", "foo.bn"})
	var cli CLIArgs = parseArgs(@[]@[]char{"-O0", "-fx64-rax-home", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if !cli.NativeOpts.X64RaxHome { return fail("-fx64-rax-home must turn RAX homes on") }
	if cli.Opt.Passes != base.Opt.Passes {
		return fail("-fx64-rax-home must not change the IR passes")
	}
	if cli.OptLevel != base.OptLevel { return fail("-fx64-rax-home must not change the -O level") }
	if len(cli.ClangFlags) != len(base.ClangFlags) {
		return fail("-fx64-rax-home must not change the clang flags")
	}
	var dd CLIArgs = parseArgs(@[]@[]char{"--fx64-rax-home", "foo.bn"})
	if len(dd.Error) > 0 { return fail("unexpected parse error for --fx64-rax-home") }
	if !dd.NativeOpts.X64RaxHome { return fail("--fx64-rax-home must turn RAX homes on") }
	return ""
}

func TestParseArgsFnoX64RaxHome() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fno-x64-rax-home", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.NativeOpts.X64RaxHome { return fail("-fno-x64-rax-home must leave RAX homes off") }
	return ""
}

func TestParseArgsX64RaxHomeBothIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fx64-rax-home", "-fno-x64-rax-home", "foo.bn"})
	if len(cli.Error) == 0 {
		return fail("-fx64-rax-home with -fno-x64-rax-home must be an error")
	}
	return ""
}

// The switch is registered next to the IR passes' -f<pass> flags, and the flag
// set takes the first registration of a name, so an IR pass of the same name
// would capture it.
func TestX64RaxHomeNotAnIRPassName() testing.TestResult {
	if iropt.OptPassByName("x64-rax-home") >= 0 {
		return fail("x64-rax-home must not also be an IR pass name")
	}
	return ""
}

// --x-copy-stats (experimental) asks for the native backend's aggregate-copy tally: off
// by default, on with --backend native, and an error without it — the LLVM backend
// counts nothing — or with a mode that does not report it (--test, --library,
// --emit-llvm).
func TestParseArgsXCopyStats() testing.TestResult {
	var plain CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "foo.bn"})
	if len(plain.Error) > 0 || plain.CopyStats { return fail("the copy tally is off by default") }
	var on CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "--x-copy-stats", "foo.bn"})
	if len(on.Error) > 0 || !on.CopyStats {
		return fail("--x-copy-stats with --backend native turns the tally on")
	}
	var llvm CLIArgs = parseArgs(@[]@[]char{"--x-copy-stats", "foo.bn"})
	if len(llvm.Error) == 0 { return fail("--x-copy-stats needs --backend native") }
	var modes @[]@[]char = @[]@[]char{"--test", "--emit-llvm"}
	for i := 0; i < len(modes); i++ {
		var m CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "--x-copy-stats", modes[i], "foo.bn"})
		if len(m.Error) == 0 { return fail("--x-copy-stats does not report for --test / --emit-llvm") }
	}
	var lib CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "--x-copy-stats", "--library", "p"})
	if len(lib.Error) == 0 { return fail("--x-copy-stats does not report for --library") }
	return ""
}

// Function placement is off by default.
func TestParseArgsNativePlaceDefaultOff() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"--backend", "native", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.NativeOpts.Place.Seed != 0 { return fail("function placement must be off by default") }
	return ""
}

// -fnative-place-seed sets the seed in phase mode, in either spelling, and leaves the IR
// passes, the -O level and the clang flags alone; the last value given wins.
func TestParseArgsFNativePlaceSeed() testing.TestResult {
	var base CLIArgs = parseArgs(@[]@[]char{"-O2", "--backend", "native", "foo.bn"})
	var cli CLIArgs = parseArgs(
			@[]@[]char{"-O2", "--backend", "native", "-fnative-place-seed=7", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.NativeOpts.Place.Seed != 7 { return fail("-fnative-place-seed=7 must set seed 7") }
	if cli.NativeOpts.Place.Mode != place.PLACE_PHASE { return fail("phase mode is the default") }
	if cli.Opt.Passes != base.Opt.Passes {
		return fail("-fnative-place-seed must not change the IR passes")
	}
	if cli.OptLevel != base.OptLevel {
		return fail("-fnative-place-seed must not change the -O level")
	}
	if len(cli.ClangFlags) != len(base.ClangFlags) {
		return fail("-fnative-place-seed must not change the clang flags")
	}
	var dd CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "--fnative-place-seed", "7", "foo.bn"})
	if len(dd.Error) > 0 { return fail("unexpected parse error for --fnative-place-seed 7") }
	if dd.NativeOpts.Place.Seed != 7 { return fail("--fnative-place-seed 7 must set seed 7") }
	var top CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=2147483647", "foo.bn"})
	if len(top.Error) > 0 || top.NativeOpts.Place.Seed != place.PLACE_SEED_MAX {
		return fail("the largest seed must be accepted")
	}
	var twice CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=3", "-fnative-place-seed=9", "foo.bn"})
	if len(twice.Error) > 0 || twice.NativeOpts.Place.Seed != 9 {
		return fail("the last -fnative-place-seed must win")
	}
	return ""
}

// -fnative-place-mode picks shift or phase mode.
func TestParseArgsFNativePlaceMode() testing.TestResult {
	var shift CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=3", "-fnative-place-mode=shift",
					"foo.bn"})
	if len(shift.Error) > 0 { return fail("unexpected parse error for shift mode") }
	if shift.NativeOpts.Place.Mode != place.PLACE_SHIFT { return fail("mode shift must set shift") }
	if shift.NativeOpts.Place.Seed != 3 { return fail("shift mode must keep the seed") }
	var phase CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=3", "-fnative-place-mode", "phase",
					"foo.bn"})
	if len(phase.Error) > 0 { return fail("unexpected parse error for phase mode") }
	if phase.NativeOpts.Place.Mode != place.PLACE_PHASE { return fail("mode phase must set phase") }
	return ""
}

// An explicit seed 0 under --backend native is accepted with or without a mode and
// leaves placement off: the control arm of a seeded measurement uses the same switches.
func TestParseArgsNativePlaceSeedZeroIsOff() testing.TestResult {
	var bare CLIArgs = parseArgs(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=0", "foo.bn"})
	if len(bare.Error) > 0 { return fail("-fnative-place-seed=0 must be accepted") }
	if bare.NativeOpts.Place.Seed != 0 { return fail("seed 0 must leave placement off") }
	var modes @[]@[]char = @[]@[]char{"-fnative-place-mode=shift", "-fnative-place-mode=phase"}
	for i := 0; i < len(modes); i++ {
		var cli CLIArgs = parseArgs(
				@[]@[]char{"--backend", "native", "-fnative-place-seed=0", modes[i], "foo.bn"})
		if len(cli.Error) > 0 { return fail("seed 0 with a mode must be accepted") }
		if cli.NativeOpts.Place.Seed != 0 { return fail("seed 0 with a mode must leave placement off") }
	}
	return ""
}

// placeArgsRejected reports whether parseArgs rejects args.
func placeArgsRejected(args @[]@[]char) bool {
	var cli CLIArgs = parseArgs(args)
	return len(cli.Error) > 0
}

// A seed that is not a decimal integer in 0..PLACE_SEED_MAX, an unknown or empty mode,
// and a mode without a seed are errors.
func TestParseArgsNativePlaceBadValues() testing.TestResult {
	if !placeArgsRejected(@[]@[]char{"--backend", "native", "-fnative-place-seed=-1", "foo.bn"}) {
		return fail("a negative seed must be an error")
	}
	if !placeArgsRejected(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=2147483648", "foo.bn"}) {
		return fail("a seed above PLACE_SEED_MAX must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"--backend", "native", "-fnative-place-seed=abc", "foo.bn"}) {
		return fail("a non-numeric seed must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"--backend", "native", "-fnative-place-seed=", "foo.bn"}) {
		return fail("an empty seed must be an error")
	}
	if !placeArgsRejected(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=5", "-fnative-place-mode=jitter",
					"foo.bn"}) {
		return fail("an unknown mode must be an error")
	}
	if !placeArgsRejected(
			@[]@[]char{"--backend", "native", "-fnative-place-seed=5", "-fnative-place-mode=", "foo.bn"}) {
		return fail("an empty mode must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"--backend", "native", "-fnative-place-mode=shift", "foo.bn"}) {
		return fail("a mode without a seed must be an error")
	}
	return ""
}

// Either switch given at all, an explicit seed 0 or an empty mode included, is an
// error without --backend native.
func TestParseArgsNativePlaceNeedsNativeBackend() testing.TestResult {
	if !placeArgsRejected(@[]@[]char{"-fnative-place-seed=5", "foo.bn"}) {
		return fail("a seed without --backend native must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"--backend", "llvm", "-fnative-place-seed=5", "foo.bn"}) {
		return fail("a seed with --backend llvm must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"-fnative-place-seed=0", "foo.bn"}) {
		return fail("seed 0 without --backend native must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"--backend", "llvm", "-fnative-place-seed=0", "foo.bn"}) {
		return fail("seed 0 with --backend llvm must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"-fnative-place-mode=phase", "foo.bn"}) {
		return fail("a mode without --backend native must be an error")
	}
	if !placeArgsRejected(@[]@[]char{"-fnative-place-mode=", "foo.bn"}) {
		return fail("an empty mode without --backend native must be an error")
	}
	return ""
}

// The placement switches are registered next to the IR passes' -f<pass> flags, and the
// flag set takes the first registration of a name, so an IR pass of the same name would
// capture one.
func TestNativePlaceNotAnIRPassName() testing.TestResult {
	if iropt.OptPassByName("native-place-seed") >= 0 || iropt.OptPassByName("native-place-mode") >= 0 {
		return fail("native-place-seed / native-place-mode must not also be IR pass names")
	}
	return ""
}
