package "main"

import "pkg/binate/iropt"
import "pkg/builtins/testing"

// parseArgs tests for the native-backend code-generation switches, as they land
// in CLIArgs.NativeOpts.  They are not IR passes, so they leave CLIArgs.Opt alone.

func TestParseArgsX64RaxHomeDefaultOff() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.NativeOpts.X64RaxHome { return fail("RAX homes must be off by default") }
	return ""
}

func TestParseArgsFX64RaxHome() testing.TestResult {
	// -O0 runs no IR pass, so a switch that leaked into the passes would show.
	var base CLIArgs = parseArgs(@[]@[]char{"-O0", "foo.bn"})
	var cli CLIArgs = parseArgs(@[]@[]char{"-O0", "-fx64-rax-home", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if !cli.NativeOpts.X64RaxHome { return fail("-fx64-rax-home must turn RAX homes on") }
	if cli.Opt.Passes != base.Opt.Passes {
		return fail("-fx64-rax-home must not change the IR passes")
	}
	if cli.OptLevel != base.OptLevel { return fail("-fx64-rax-home must not change the -O level") }
	if len(cli.ClangFlags) != len(base.ClangFlags) {
		return fail("-fx64-rax-home must not change the clang flags")
	}
	var dd CLIArgs = parseArgs(@[]@[]char{"--fx64-rax-home", "foo.bn"})
	if len(dd.Error) > 0 { return fail("unexpected parse error for --fx64-rax-home") }
	if !dd.NativeOpts.X64RaxHome { return fail("--fx64-rax-home must turn RAX homes on") }
	return ""
}

func TestParseArgsFnoX64RaxHome() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fno-x64-rax-home", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.NativeOpts.X64RaxHome { return fail("-fno-x64-rax-home must leave RAX homes off") }
	return ""
}

func TestParseArgsX64RaxHomeBothIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fx64-rax-home", "-fno-x64-rax-home", "foo.bn"})
	if len(cli.Error) == 0 {
		return fail("-fx64-rax-home with -fno-x64-rax-home must be an error")
	}
	return ""
}

// The switch is registered next to the IR passes' -f<pass> flags, and the flag
// set takes the first registration of a name, so an IR pass of the same name
// would capture it.
func TestX64RaxHomeNotAnIRPassName() testing.TestResult {
	if iropt.OptPassByName("x64-rax-home") >= 0 {
		return fail("x64-rax-home must not also be an IR pass name")
	}
	return ""
}
