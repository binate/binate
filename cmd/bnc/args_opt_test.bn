package "main"

import "pkg/binate/iropt"
import "pkg/builtins/testing"

// parseArgs tests for the IR pass configuration: -O levels, -f<pass> /
// -fno-<pass>, and --inline-threshold, as they land in CLIArgs.Opt.

func TestParseArgsOptConfigDefaultRunsNothing() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"foo.bn"})
	if cli.Opt.Passes != 0 { return fail("-O0 default must run no pass") }
	if cli.Opt.InlineThreshold != iropt.DEFAULT_INLINE_THRESHOLD {
		return fail("expected the default inline threshold")
	}
	return ""
}

func TestParseArgsOptConfigO2RunsEveryPass() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-O2", "foo.bn"})
	for p := 0; p < iropt.NUM_OPT_PASSES; p++ {
		if !iropt.OptPassEnabled(cli.Opt, p) { return fail("-O2 must enable every pass") }
	}
	return ""
}

func TestParseArgsFnoDisablesOnePass() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-O2", "-fno-sroa", "--fno-licm", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if iropt.OptPassEnabled(cli.Opt, iropt.PASS_SROA) { return fail("-fno-sroa must disable sroa") }
	if iropt.OptPassEnabled(cli.Opt, iropt.PASS_LICM) { return fail("--fno-licm must disable licm") }
	if !iropt.OptPassEnabled(cli.Opt, iropt.PASS_MEM2REG) { return fail("mem2reg must stay on") }
	if len(cli.ClangFlags) != 1 { return fail("-O2 must still imply one clang -O") }
	return ""
}

func TestParseArgsFEnablesOnePassAtO0() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fdead-phi", "-fmem2reg", "foo.bn"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if cli.OptLevel != 0 { return fail("-f must not change the -O level") }
	if len(cli.ClangFlags) != 0 { return fail("-f must not imply a clang -O") }
	for p := 0; p < iropt.NUM_OPT_PASSES; p++ {
		var want bool = p == iropt.PASS_MEM2REG || p == iropt.PASS_DEAD_PHI
		if iropt.OptPassEnabled(cli.Opt, p) != want {
			return fail("-O0 -fmem2reg -fdead-phi must enable exactly those two passes")
		}
	}
	return ""
}

func TestParseArgsFAndFnoSamePassIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fsroa", "-fno-sroa", "foo.bn"})
	if len(cli.Error) == 0 { return fail("-fsroa with -fno-sroa must be an error") }
	return ""
}

func TestParseArgsUnknownPassIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fno-nosuchpass", "foo.bn"})
	if len(cli.Error) == 0 { return fail("an unknown pass name must be an error") }
	return ""
}

func TestParseArgsInlineThresholdInConfig() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-O1", "--inline-threshold", "40", "foo.bn"})
	if cli.Opt.InlineThreshold != 40 { return fail("--inline-threshold must reach Opt") }
	return ""
}

func TestParseArgsListOptPasses() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"--list-opt-passes"})
	if len(cli.Error) > 0 { return fail("unexpected parse error") }
	if !cli.ListOptPasses { return fail("expected ListOptPasses") }
	return ""
}
