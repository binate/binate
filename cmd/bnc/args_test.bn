// hasVersionFlag detects --version anywhere in the args so `bnc
// --version` prints the build id and exits before parseArgs requires a
// source file.
func TestHasVersionFlag() testing.TestResult {
	if !hasVersionFlag(@[]@[]char{"--version"}) {
		return fail("--version alone should be detected")
	}
	if !hasVersionFlag(@[]@[]char{"foo.bn", "--version"}) {
		return fail("--version after a positional should be detected")
	}
	if hasVersionFlag(@[]@[]char{"foo.bn", "-o", "out"}) {
		return fail("args without --version should be false")
	}
	return ""
}
