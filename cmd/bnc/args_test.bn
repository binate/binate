package "main"

import "pkg/builtins/testing"

// ============================================================
// parseArgs tests
// ============================================================

func TestParseArgsSimple() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if !seq(cli.Filenames[0], "foo.bn") { return fail("wrong filename") }
	return ""
}

func TestParseArgsOutput() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-o", "mybin", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.Output, "mybin") { return fail("wrong output") }
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	return ""
}

func TestParseArgsEmitLLVM() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--emit-llvm", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.EmitLLVM { return fail("expected emit-llvm") }
	return ""
}

func TestParseArgsOptLevelDefault() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if cli.OptLevel != 0 { return fail("expected default OptLevel 0") }
	if len(cli.ClangFlags) != 0 { return fail("default must inject no clang -O") }
	return ""
}

func TestParseArgsOptLevelImpliesClangFlag() testing.TestResult {
	// -O2 on the (default) LLVM backend sets the IR level AND prepends clang -O2.
	var args @[]@[]char = @[]@[]char{"-O2", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if cli.OptLevel != 2 { return fail("expected OptLevel 2") }
	if len(cli.ClangFlags) != 1 { return fail("expected one implied clang flag") }
	if !seq(cli.ClangFlags[0], "-O2") { return fail("expected implied -O2") }
	return ""
}

func TestParseArgsOptLevelCflagWins() testing.TestResult {
	// -O2 implies clang -O2, but an explicit --cflag -O0 must win: it is emitted
	// AFTER the implied flag, and clang honors the last -O.
	var args @[]@[]char = @[]@[]char{"-O2", "--cflag", "-O0", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if cli.OptLevel != 2 { return fail("expected OptLevel 2") }
	if len(cli.ClangFlags) != 2 { return fail("expected implied + explicit clang flags") }
	if !seq(cli.ClangFlags[0], "-O2") { return fail("implied -O2 must come first") }
	if !seq(cli.ClangFlags[1], "-O0") { return fail("explicit -O0 must come last") }
	return ""
}

func TestParseArgsOptLevelNativeInert() testing.TestResult {
	// On the native backend clang only links, so -On sets just the IR level and
	// injects no clang -O.
	var args @[]@[]char = @[]@[]char{"-O2", "--backend", "native", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if cli.OptLevel != 2 { return fail("expected OptLevel 2 on native") }
	if len(cli.ClangFlags) != 0 { return fail("native must inject no clang -O") }
	return ""
}

