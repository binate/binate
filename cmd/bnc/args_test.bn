func TestParseArgsVerifyIR() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--verify-ir", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.VerifyIR { return fail("expected VerifyIR") }
	var none @[]@[]char = @[]@[]char{"foo.bn"}
	if parseArgs(none).VerifyIR { return fail("VerifyIR should default false") }
	return ""
}

// --root used to be a flag; after the migration it is no longer
// recognized and falls through to the positional branch.  Pin that
// so a stray re-introduction of `--root` parsing breaks loudly
// instead of silently shadowing source-file args.
func TestParseArgsRootIsPositional() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/proj", "main.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 3 {
		return fail("--root should land in Filenames, not be parsed as a flag")
	}
	if !seq(cli.Filenames[0], "--root") { return fail("Filenames[0] wrong") }
	if !seq(cli.Filenames[1], "/proj") { return fail("Filenames[1] wrong") }
	if !seq(cli.Filenames[2], "main.bn") { return fail("Filenames[2] wrong") }
	return ""
}

func TestParseArgsRuntime() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--runtime", "/path/to/rt.c", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.RuntimePath, "/path/to/rt.c") { return fail("wrong runtime") }
	return ""
}

// TestParseArgsLinkAfterObjs verifies that `--link-after-objs <path>`
// is appended to CLIArgs.LinkAfterObjs (and isn't accidentally
// mis-routed to ClangFlags or Filenames).  Bare-metal runners use
// this to pipe the host's libgcc.a — whose path differs across
// apt vs Homebrew — into clang's link argv after the .o files.
func TestParseArgsLinkAfterObjs() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--link-after-objs", "/some/libgcc.a", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.LinkAfterObjs) != 1 {
		return fail("--link-after-objs should land in LinkAfterObjs")
	}
	if !seq(cli.LinkAfterObjs[0], "/some/libgcc.a") {
		return fail("wrong path in LinkAfterObjs[0]")
	}
	if len(cli.Filenames) != 1 || !seq(cli.Filenames[0], "foo.bn") {
		return fail("--link-after-objs arg leaked into Filenames")
	}
	return ""
}

// TestParseArgsLinkAfterObjsRepeatable verifies the flag accumulates
// across multiple uses, preserving order — important because lld
// pulls archive members based on the order they appear on the
// link command line.
func TestParseArgsLinkAfterObjsRepeatable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{
			"--link-after-objs", "/lib/a.a", "--link-after-objs", "/lib/b.a", "main.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.LinkAfterObjs) != 2 {
		return fail("expected 2 LinkAfterObjs entries")
	}
	if !seq(cli.LinkAfterObjs[0], "/lib/a.a") {
		return fail("first entry should be /lib/a.a")
	}
	if !seq(cli.LinkAfterObjs[1], "/lib/b.a") {
		return fail("second entry should be /lib/b.a")
	}
	return ""
}

func TestParseArgsPkg() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--pkg", "pkg/foo", "-I", "/proj"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.PkgFlag, "pkg/foo") { return fail("wrong pkg") }
	if len(cli.BniPaths) != 1 || !seq(cli.BniPaths[0], "/proj") {
		return fail("wrong -I entry")
	}
	return ""
}

// --list-deps sets ListDeps and otherwise parses like a normal compile (the
// main file is a positional argument).
func TestParseArgsListDeps() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--list-deps", "cmd/bnas"}
	var cli CLIArgs = parseArgs(args)
	if !cli.ListDeps { return fail("--list-deps should set ListDeps") }
	if len(cli.Filenames) != 1 || !seq(cli.Filenames[0], "cmd/bnas") {
		return fail("main target should be a positional filename")
	}
	// ListDeps is off unless the flag is passed.
	var plain CLIArgs = parseArgs(@[]@[]char{"main.bn"})
	if plain.ListDeps { return fail("ListDeps must default to false") }
	return ""
}

func TestParseArgsMultipleFiles() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"a.bn", "b.bn", "c.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 3 { return fail("expected 3 filenames") }
	return ""
}

func TestParseArgsEmpty() testing.TestResult {
	var args @[]@[]char
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 0 { return fail("expected 0 filenames") }
	if cli.Debug { return fail("debug should be false") }
	if cli.EmitLLVM { return fail("emit-llvm should be false") }
	return ""
}

// --build-dir <dir>: takes the next arg as the value, must not be
// confused with a positional.
func TestParseArgsBuildDir() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--build-dir", "/tmp/work", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.BuildDir, "/tmp/work") { return fail("wrong build-dir") }
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if !seq(cli.Filenames[0], "foo.bn") {
		return fail("filename should not absorb build-dir value")
	}
	return ""
}

// Default (no flag): BuildDir is empty, signaling legacy
// /tmp/binate_<base>_ layout.
func TestParseArgsBuildDirDefault() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BuildDir) != 0 { return fail("BuildDir should default to empty") }
	return ""
}

// ============================================================
// -I / --interface-path tests
// ============================================================

func TestParseArgsInterfacePathShort() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/bni-only", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 1 { return fail("expected 1 BniPath entry") }
	if !seq(cli.BniPaths[0], "/bni-only") { return fail("wrong BniPath[0]") }
	if len(cli.ImplPaths) != 0 { return fail("ImplPaths should stay empty") }
	return ""
}

func TestParseArgsInterfacePathLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--interface-path", "/bni-only", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 1 { return fail("expected 1 BniPath entry") }
	if !seq(cli.BniPaths[0], "/bni-only") { return fail("wrong BniPath[0]") }
	return ""
}

func TestParseArgsInterfacePathColonList() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/a:/b:/c", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 3 { return fail("expected 3 BniPath entries") }
	if !seq(cli.BniPaths[0], "/a") { return fail("BniPath[0] wrong") }
	if !seq(cli.BniPaths[1], "/b") { return fail("BniPath[1] wrong") }
	if !seq(cli.BniPaths[2], "/c") { return fail("BniPath[2] wrong") }
	return ""
}

func TestParseArgsInterfacePathRepeatable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{
			"-I", "/a:/b", "--interface-path", "/c", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 3 { return fail("expected 3 BniPath entries") }
	if !seq(cli.BniPaths[0], "/a") { return fail("BniPath[0] wrong") }
	if !seq(cli.BniPaths[1], "/b") { return fail("BniPath[1] wrong") }
	if !seq(cli.BniPaths[2], "/c") { return fail("BniPath[2] wrong") }
	return ""
}

