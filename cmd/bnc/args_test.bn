func TestParseArgsImplPathShort() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-L", "/impl-only", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.ImplPaths) != 1 { return fail("expected 1 ImplPath entry") }
	if !seq(cli.ImplPaths[0], "/impl-only") { return fail("wrong ImplPath[0]") }
	if len(cli.BniPaths) != 0 { return fail("BniPaths should stay empty") }
	return ""
}

func TestParseArgsImplPathLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--impl-path", "/impl-only", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.ImplPaths) != 1 { return fail("expected 1 ImplPath entry") }
	if !seq(cli.ImplPaths[0], "/impl-only") { return fail("wrong ImplPath[0]") }
	return ""
}

func TestParseArgsImplPathColonList() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-L", "/a:/b:/c", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.ImplPaths) != 3 { return fail("expected 3 ImplPath entries") }
	if !seq(cli.ImplPaths[0], "/a") { return fail("ImplPath[0] wrong") }
