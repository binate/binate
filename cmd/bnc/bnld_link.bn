package "main"

import "pkg/binate/asm/assemble"
import "pkg/binate/buf"
import "pkg/binate/link"
import "pkg/stdx/fmt"

// The `--linker bnld` path: link a program with the self-hosted linker
// (pkg/binate/link) instead of clang.  ELF (linux-x64 / linux-aarch64) and macOS Mach-O
// (macos-arm64) are supported; arm32 still requires clang.
//
// On ELF, bnld does not link the platform C runtime's crt1/Scrt1.o (finding it means
// replicating clang's sysroot/multiarch probing).  Instead we assemble our own tiny
// `_start` and add it to the link: crt1's sole job is to call libc's
// __libc_start_main, so we do exactly that.  __libc_start_main (imported from
// libc.so.6, which bnld links dynamically) performs full libc init (TLS, errno, malloc
// arena, stdio) and calls `main` — the Binate entry, emitted under the C symbol `main`
// by pkg/builtins/startup.  We are shedding the C linker/driver, not libc: linking libc
// dynamically is the sanctioned C interface on a hosted system.  macOS needs none of this
// `_start` bootstrap — dyld's LC_MAIN runs `main` after libSystem init (see
// linkMachoWithBnld).

// hostedStartX64 is the process-entry assembly for a bnld-linked hosted x86-64 ELF: a
// tiny `_start` that calls __libc_start_main(main, argc, argv, init=0, fini=0,
// rtld_fini, stack_end).  At entry ld.so leaves rsp -> argc, [rsp+8] -> argv, rdx =
// rtld_fini; SysV passes the 7th arg (stack_end) on the stack, hence the align + two
// pushes.
func hostedStartX64() *[]readonly char {
	return ".arch x64\n"
			".section text\n"
			".global _start\n"
			".global main\n"
			".global __libc_start_main\n"
			"_start:\n"
			" xor ebp, ebp\n"
			" mov r9, rdx\n"
			" pop rsi\n"
			" mov rdx, rsp\n"
			" and rsp, -16\n"
			" push rax\n"
			" push rsp\n"
			" lea rdi, [rip + main]\n"
			" xor ecx, ecx\n"
			" xor r8d, r8d\n"
			" call __libc_start_main\n"
			"Lhang:\n"
			" jmp Lhang\n"
}

// hostedStartAarch64 is the process-entry assembly for a bnld-linked hosted aarch64
// ELF: a tiny `_start` that calls __libc_start_main(main, argc, argv, init=0, fini=0,
// rtld_fini, stack_end) — all seven args in x0..x6.  At entry ld.so leaves sp -> argc,
// [sp,#8] -> argv, x0 = rtld_fini.
func hostedStartAarch64() *[]readonly char {
	return ".arch aarch64\n"
			".section text\n"
			".global _start\n"
			".global main\n"
			".global __libc_start_main\n"
			"_start:\n"
			" mov x29, #0\n"
			" mov x30, #0\n"
			" mov x5, x0\n"
			" ldr x1, [sp]\n"
			" add x2, sp, #8\n"
			" mov x6, sp\n"
			" adrp x0, main\n"
			" add x0, x0, #:lo12:main\n"
			" mov x3, #0\n"
			" mov x4, #0\n"
			" bl __libc_start_main\n"
			"Lhang:\n"
			" b Lhang\n"
}

// linkWithBnld links oFiles into `output` with bnld instead of clang.  For an ELF target
// (linux-x64 / linux-aarch64) it assembles the hosted `_start` and dynamically links the
// objects against libc; for a macOS Mach-O target (macos-arm64) it hands off to
// linkMachoWithBnld (dyld + libSystem, no _start).  Returns false with a diagnostic for
// any other target (the caller then exits).
func linkWithBnld(cli CLIArgs, oFiles @[]@[]char, output *[]readonly char) bool {
	// Partition any --link-after-objs entries into extra object/archive inputs and
	// shared-library dependencies (.so / .dylib); both are plumbed through bnld below.
	var extraObjs @[]@[]char
	var sharedLibs @[]@[]char
	extraObjs, sharedLibs = splitLinkInputs(cli.LinkAfterObjs)
	var objFormat *[]readonly char = nativeObjFormatForTarget()
	var arch *[]readonly char = nativeArchForTarget()
	if streq(objFormat, "macho") {
		return linkMachoWithBnld(oFiles, extraObjs, sharedLibs, arch, output)
	}
	if !streq(objFormat, "elf") {
		fmt.Print("error: --linker bnld supports ELF (linux-x64 / linux-aarch64) ",
				"and macOS Mach-O (macos-arm64) targets only\n")
		return false
	}
	var machine int = 0
	var startAsm *[]readonly char = ""
	if streq(arch, "x86_64") {
		machine = link.EM_X86_64
		startAsm = hostedStartX64()
	} else if streq(arch, "aarch64") {
		machine = link.EM_AARCH64
		startAsm = hostedStartAarch64()
	} else {
		fmt.Print("error: --linker bnld supports x86_64 and aarch64 only (got arch '", arch, "')\n")
		return false
	}

	// Assemble our _start (bnld links no crt1) into a scratch object next to the other
	// intermediates.  Namespaced `bnrt_start_<output>` so it cannot collide with a
	// package object, nor with another target's concurrent build to a different output.
	var dir *[]readonly char = "/tmp"
	if len(cli.BuildDir) > 0 {
		// bnlint:allow managed-to-raw-assign - cli (and its BuildDir) outlives this borrow
		dir = cli.BuildDir
	}
	var obase *[]readonly char = output
	for i := 0; i < len(output); i++ {
		if output[i] == '/' { obase = output[i + 1:] }
	}
	var stem @[]char = buf.Concat(buf.Concat(buf.Concat(dir, "/"), "bnrt_start_"), obase)
	var sPath @[]char = buf.Concat(stem, ".s")
	var oPath @[]char = buf.Concat(stem, ".o")
	writeFile(sPath, startAsm)
	sok, smsg := assemble.AssembleFile(sPath, oPath, arch, "linux")
	if !cli.KeepObjs { remove(sPath) } // the .s is consumed by assembly; drop it on all paths
	if !sok {
		fmt.Print("error: assembling the bnld startup: ", smsg, "\n")
		return false
	}

	// Link the program objects + any --link-after-objs objects + our _start, dynamic
	// against libc (the implicit libc.so.6 DT_NEEDED) plus any --link-after-objs shared
	// libraries (each shared library's SONAME becomes an additional DT_NEEDED).
	var inputs @[]@[]char = make_slice(@[]char, len(oFiles) + len(extraObjs) + 1)
	for i := 0; i < len(oFiles); i++ { inputs[i] = oFiles[i] }
	for i := 0; i < len(extraObjs); i++ { inputs[len(oFiles) + i] = extraObjs[i] }
	inputs[len(oFiles) + len(extraObjs)] = oPath
	var lerr @[]readonly char = link.LinkDynElf(inputs, "_start", machine, cast(uint64, 0x400000),
			output, sharedLibs)
	if !cli.KeepObjs { remove(oPath) }
	if len(lerr) != 0 {
		fmt.Print("error: bnld link failed: ", lerr, "\n")
		return false
	}
	return true
}

// linkMachoWithBnld links oFiles into an ad-hoc-signed dynamic arm64 Mach-O executable
// with bnld.  The entry is the program's own C `main` (`_main` on Mach-O — the
// #[c_export("main")] Binate `_entry`), which dyld's LC_MAIN calls after initializing
// libSystem; bnld binds the program's undefined symbols to libSystem, so — unlike the
// ELF path — no synthetic `_start` and no crt object are needed.  base is the code base
// (matching cmd/bnld's machoBase: segStart = base - header size lands __PAGEZERO's top
// at 0x100000000).  arm64 only (bnld's Mach-O writer targets arm64).
func linkMachoWithBnld(oFiles @[]@[]char, extraObjs @[]@[]char, sharedLibs @[]@[]char,
		arch *[]readonly char, output *[]readonly char) bool {
	if !streq(arch, "aarch64") {
		fmt.Print("error: --linker bnld Mach-O linking supports arm64 (aarch64) only ", "(got arch '",
				arch, "')\n")
		return false
	}
	// LinkDynMacho links a single libSystem (no additional dylibs), so a shared-library
	// --link-after-objs entry is not supported on the Mach-O path yet; extra objects are.
	if len(sharedLibs) > 0 {
		fmt.Print("error: --linker bnld Mach-O does not support shared-library ",
				"--link-after-objs yet\n")
		return false
	}
	var inputs @[]@[]char = make_slice(@[]char, len(oFiles) + len(extraObjs))
	for i := 0; i < len(oFiles); i++ { inputs[i] = oFiles[i] }
	for i := 0; i < len(extraObjs); i++ { inputs[len(oFiles) + i] = extraObjs[i] }
	var lerr @[]readonly char = link.LinkDynMacho(inputs, "_main", link.EM_AARCH64,
			cast(uint64, 0x100004000), output)
	if len(lerr) != 0 {
		fmt.Print("error: bnld Mach-O link failed: ", lerr, "\n")
		return false
	}
	return true
}

// isSharedLib reports whether a --link-after-objs entry is a shared library — an ELF .so
// (incl. a versioned libfoo.so.6) or a Mach-O .dylib — rather than an object or archive.
// A shared library becomes a dynamic dependency (DT_NEEDED); an object/archive links in.
func isSharedLib(p *[]readonly char) bool {
	return hasSuffix(p, ".so") || hasSuffix(p, ".dylib") || containsDotSoDot(p)
}

// containsDotSoDot reports whether p contains the substring ".so." — a versioned ELF
// shared object such as libfoo.so.6.
func containsDotSoDot(p *[]readonly char) bool {
	for i := 0; i + 4 <= len(p); i++ {
		if p[i] == '.' && p[i + 1] == 's' && p[i + 2] == 'o' && p[i + 3] == '.' { return true }
	}
	return false
}

// splitLinkInputs partitions --link-after-objs entries into extra object/archive inputs
// (the first result) and shared-library dependencies (the second).
func splitLinkInputs(entries @[]@[]char) (@[]@[]char, @[]@[]char) {
	var nShared int = 0
	for i := 0; i < len(entries); i++ {
		if isSharedLib(entries[i]) { nShared = nShared + 1 }
	}
	var objs @[]@[]char = make_slice(@[]char, len(entries) - nShared)
	var shared @[]@[]char = make_slice(@[]char, nShared)
	var oi int = 0
	var si int = 0
	for i := 0; i < len(entries); i++ {
		if isSharedLib(entries[i]) {
			shared[si] = entries[i]
			si = si + 1
		} else {
			objs[oi] = entries[i]
			oi = oi + 1
		}
	}
	return objs, shared
}
