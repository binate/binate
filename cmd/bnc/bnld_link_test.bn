package "main"

import "pkg/builtins/testing"

// The hosted `_start` generators emit a `_start` that calls __libc_start_main and
// references `main`.  (linkWithBnld's end-to-end compile+link+run is proven by
// e2e/bnc-bnld-linux.sh, which needs a target loader; these pin the entry asm
// host-independently.)

// TestHostedStartX64 checks the x86-64 entry asm.
func TestHostedStartX64() testing.TestResult {
	var s *[]readonly char = hostedStartX64()
	if !containsStr(s, ".arch x64") { return fail("x64 start missing .arch x64") }
	if !containsStr(s, "_start:") { return fail("x64 start missing _start label") }
	if !containsStr(s, "call __libc_start_main") {
		return fail("x64 start must call __libc_start_main")
	}
	if !containsStr(s, ".global main") { return fail("x64 start must reference main") }
	return ""
}

// TestHostedStartAarch64 checks the aarch64 entry asm.
func TestHostedStartAarch64() testing.TestResult {
	var s *[]readonly char = hostedStartAarch64()
	if !containsStr(s, ".arch aarch64") { return fail("aarch64 start missing .arch aarch64") }
	if !containsStr(s, "_start:") { return fail("aarch64 start missing _start label") }
	if !containsStr(s, "bl __libc_start_main") {
		return fail("aarch64 start must call __libc_start_main")
	}
	if !containsStr(s, ".global main") { return fail("aarch64 start must reference main") }
	return ""
}
