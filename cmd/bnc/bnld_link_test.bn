package "main"

import "pkg/builtins/testing"

// The hosted `_start` generators emit a `_start` that calls __libc_start_main and
// references `main`.  (linkWithBnld's end-to-end compile+link+run is proven by
// e2e/bnc-bnld-linux.sh, which needs a target loader; these pin the entry asm
// host-independently.)

// TestHostedStartX64 checks the x86-64 entry asm.
func TestHostedStartX64() testing.TestResult {
	var s *[]readonly char = hostedStartX64()
	if !containsStr(s, ".arch x64") { return fail("x64 start missing .arch x64") }
	if !containsStr(s, "_start:") { return fail("x64 start missing _start label") }
	if !containsStr(s, "call __libc_start_main") {
		return fail("x64 start must call __libc_start_main")
	}
	if !containsStr(s, ".global main") { return fail("x64 start must reference main") }
	return ""
}

// TestHostedStartAarch64 checks the aarch64 entry asm.
func TestHostedStartAarch64() testing.TestResult {
	var s *[]readonly char = hostedStartAarch64()
	if !containsStr(s, ".arch aarch64") { return fail("aarch64 start missing .arch aarch64") }
	if !containsStr(s, "_start:") { return fail("aarch64 start missing _start label") }
	if !containsStr(s, "bl __libc_start_main") {
		return fail("aarch64 start must call __libc_start_main")
	}
	if !containsStr(s, ".global main") { return fail("aarch64 start must reference main") }
	return ""
}

// TestIsSharedLib classifies shared libraries (.so / .dylib / a versioned .so.N) apart
// from objects and archives.
func TestIsSharedLib() testing.TestResult {
	if !isSharedLib("/x/libc.so") { return fail(".so is a shared lib") }
	if !isSharedLib("/x/libSystem.dylib") { return fail(".dylib is a shared lib") }
	if !isSharedLib("/x/libfoo.so.6") { return fail("versioned .so.N is a shared lib") }
	if isSharedLib("/x/foo.o") { return fail(".o is not a shared lib") }
	if isSharedLib("/x/libgcc.a") { return fail(".a is not a shared lib") }
	if isSharedLib("/x/soup") { return fail("'soup' is not a shared lib") }
	return ""
}

// TestSplitLinkInputs partitions --link-after-objs entries into objects and shared libs,
// preserving order within each partition.
func TestSplitLinkInputs() testing.TestResult {
	var entries @[]@[]char = @[]@[]char{"a.o", "libc.so", "b.a", "libm.so.6", "c.o"}
	var objs @[]@[]char
	var shared @[]@[]char
	objs, shared = splitLinkInputs(entries)
	if len(objs) != 3 { return fail("expected 3 object entries") }
	if len(shared) != 2 { return fail("expected 2 shared-lib entries") }
	if !seq(objs[0], "a.o") || !seq(objs[1], "b.a") || !seq(objs[2], "c.o") {
		return fail("object order not preserved")
	}
	if !seq(shared[0], "libc.so") || !seq(shared[1], "libm.so.6") {
		return fail("shared-lib order not preserved")
	}
	return ""
}

// splitLinkInputs on an empty list yields two empty partitions (no crash).
func TestSplitLinkInputsEmpty() testing.TestResult {
	var none @[]@[]char
	var objs @[]@[]char
	var shared @[]@[]char
	objs, shared = splitLinkInputs(none)
	if len(objs) != 0 || len(shared) != 0 {
		return fail("empty input should yield empty partitions")
	}
	return ""
}
