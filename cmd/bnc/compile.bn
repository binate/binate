package "main"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/codegen"
import "pkg/debug"
import "pkg/ir"
import "pkg/loader"
import "pkg/parser"
import "pkg/types"

// ============================================================
// Type checking
// ============================================================

// loadBuiltinBNIs loads .bni files for builtin packages into the type checker.
func loadBuiltinBNIs(c @types.Checker, ldr @loader.Loader) {
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || !pkg.Builtin { continue }
		// Try to find .bni file in loader roots
		var bniFile @ast.File = collectPkgFile(ldr, ldr.Order[i], ldr.Root)
		if bniFile != nil {
			c.LoadPackageInterface(ldr.Order[i], bniFile)
		}
	}
}

// typecheckAll type-checks all loaded packages and the main file.
func typecheckAll(ldr @loader.Loader, mainFile @ast.File) {
	var c @types.Checker = types.NewChecker()
	loadBuiltinBNIs(c, ldr)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	if mainFile != nil {
		c.Check(mainFile)
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(errs[i].Msg)
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
}

// typecheckPackages type-checks loaded packages (no main file).
func typecheckPackages(ldr @loader.Loader) {
	var c @types.Checker = types.NewChecker()
	loadBuiltinBNIs(c, ldr)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(errs[i].Msg)
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
}

// ============================================================
// Single-package compilation mode (--pkg)
// ============================================================

// compileSinglePkg compiles a single package to an object file or LLVM IR.
func compileSinglePkg(cli CLIArgs) {
	var root @[]char = buf.CopyStr(cli.RootFlag)
	var pkgPath @[]char = cli.PkgFlag
	var ldr @loader.Loader = loader.NewLoader(root)
	applyPathFlags(ldr, cli, root)

	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = quotePath(pkgPath)
	syntheticImports = appendImportSpecPtr(syntheticImports, imp)
	ldr.LoadImports(syntheticImports)

	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}

	typecheckPackages(ldr)

	var pkg @loader.Package = ldr.GetPackage(pkgPath)
	if pkg == nil || pkg.Merged == nil {
		print("error: package not found: ")
		println(pkgPath)
		bootstrap.Exit(1)
	}

	debug.Log(bootstrap.Concat("compiling ", pkgPath))

	var mod @ir.Module = ir.InitModule(quotePath(pkgPath))
	registerPkgImports(ldr, pkg, mod, root)
	if pkg.BNI != nil {
		ir.RegisterSelfTypes(pkg.BNI)
	}
	ir.GeneratePackage(pkg.Merged, mod)
	var llvmIR @[]char = codegen.EmitModule(mod)

	debug.Log("IR generation complete")

	if cli.EmitLLVM {
		print(llvmIR)
		return
	}

	var pkgName @[]char = shortName(buf.CopyStr(pkgPath))
	var base @[]char = pkgName
	if len(cli.Output) > 0 {
		base = shortName(buf.CopyStr(cli.Output))
	}
	var oPrefix @[]char = outPrefixFor(cli.BuildDir, base)
	var oFile @[]char = compileLL(llvmIR, oPrefix, pkgName)
	println(oFile)
}

// ============================================================
// Package import registration
// ============================================================

// collectPkgFile returns the AST file (BNI or merged) for a loaded package.
func collectPkgFile(ldr @loader.Loader, pkgPath *[]const char, root *[]const char) @ast.File {
	var depPkg @loader.Package = ldr.GetPackage(pkgPath)
	if depPkg == nil { return nil }
	if depPkg.Builtin {
		var bniPath @[]char = bootstrap.Concat(
			bootstrap.Concat(root, "/"),
			bootstrap.Concat(pkgPath, ".bni"))
		var bniSrc @[]uint8 = readFile(bniPath)
		if len(bniSrc) > 0 {
			var bp @parser.Parser = parser.NewInterface(bniSrc, bniPath)
			var depFile @ast.File = bp.ParseFile()
			var bniErrors @[]parser.ParseError = bp.Errors()
			if len(bniErrors) > 0 {
				return nil
			}
			return depFile
		}
		return nil
	}
	// Prefer the merged file (.bni + .bn) over .bni-alone so that
	// IR-gen sees body presence — matters for the IsCExtern / sret
	// ABI hint, where C externs (no body) need C-ABI calls and
	// pure-Binate functions (with body) use Binate ABI.
	if depPkg.Merged != nil {
		return depPkg.Merged
	}
	return depPkg.BNI
}

// registerAllStructTypes registers struct type names and fields from ALL loaded
// packages (transitive dependencies). Also registers transitive interface
// declarations for cross-package alias-chain resolution (Slice 2.9 of
// plan-cross-package-interfaces.md).
func registerAllStructTypes(ldr @loader.Loader, root *[]const char) {
	if len(ldr.Order) == 0 { return }
	var aliases @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(ldr.Order); i++ {
		var depFile @ast.File = collectPkgFile(ldr, ldr.Order[i], root)
		if depFile != nil {
			aliases = appendCharSlice(aliases, shortName(ldr.Order[i]))
			files = appendFilePtr(files, depFile)
		}
	}
	ir.RegisterStructTypes(aliases, files)
	ir.RegisterAllInterfaces(aliases, files)
}

// registerPkgImports registers a package's dependencies into its IR module.
func registerPkgImports(ldr @loader.Loader, pkg @loader.Package,
		mod @ir.Module, root *[]const char) {
	registerAllStructTypes(ldr, root)

	var aliases @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(ldr, pkg.Imports[j], root)
			if depFile != nil {
				aliases = appendCharSlice(aliases, shortName(pkg.Imports[j]))
				files = appendFilePtr(files, depFile)
			}
		}
	}

	if !streq(pkg.Path, "pkg/rt") {
		appendRtImport(ldr, root, &aliases, &files)
	}
	if !streq(pkg.Path, "pkg/bootstrap") {
		appendBootstrapImport(ldr, root, &aliases, &files)
	}
	if !streq(pkg.Path, "pkg/libc") {
		appendLibcImport(ldr, root, &aliases, &files)
	}

	ir.RegisterImports(aliases, files, mod)
}

// registerMainImports registers imports for the main package.
func registerMainImports(ldr @loader.Loader, file @ast.File, mod @ir.Module, root *[]const char) {
	registerAllStructTypes(ldr, root)

	var aliases @[]@[]char
	var files @[]@ast.File
	if len(file.Imports) > 0 {
		var imports @[]@[]char
		for i := 0; i < len(file.Imports); i++ {
			imports = appendCharSlice(imports, unquote(file.Imports[i].Path))
		}
		for j := 0; j < len(imports); j++ {
			var depFile @ast.File = collectPkgFile(ldr, imports[j], root)
			if depFile != nil {
				aliases = appendCharSlice(aliases, shortName(imports[j]))
				files = appendFilePtr(files, depFile)
			}
		}
	}

	appendRtImport(ldr, root, &aliases, &files)
	appendBootstrapImport(ldr, root, &aliases, &files)
	appendLibcImport(ldr, root, &aliases, &files)
	ir.RegisterImports(aliases, files, mod)
}

// appendRtImport adds the pkg/rt import to aliases and files if not already present.
func appendRtImport(ldr @loader.Loader, root *[]const char,
		aliases *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "rt") { return }
	}

	var rtPkg @loader.Package = ldr.GetPackage("pkg/rt")
	if rtPkg == nil { return }

	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*aliases = appendCharSlice(*aliases, "rt")
	*files = appendFilePtr(*files, rtFile)
}

// appendLibcImport adds pkg/libc to aliases and files if not already
// present. pkg/codegen and pkg/native emit direct @bn_libc__Memcpy
// calls into LLVM IR / asm for string-copy paths — every package
// that might emit a string copy needs the libc.Memcpy declaration in
// its IR module so the emitted call has a matching `declare` line.
func appendLibcImport(ldr @loader.Loader, root *[]const char,
		aliases *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "libc") { return }
	}

	var libcPkg @loader.Package = ldr.GetPackage("pkg/libc")
	if libcPkg == nil { return }

	var libcFile @ast.File
	if libcPkg.BNI != nil {
		libcFile = libcPkg.BNI
	} else if libcPkg.Merged != nil {
		libcFile = libcPkg.Merged
	}
	if libcFile == nil { return }
	*aliases = appendCharSlice(*aliases, "libc")
	*files = appendFilePtr(*files, libcFile)
}

// appendBootstrapImport adds pkg/bootstrap to aliases and files if
// not already present. The print/println builtin's IR-gen lowering
// emits direct calls into pkg/bootstrap (formatInt + Write), so
// every compiled module needs the signatures available even when
// user code doesn't import pkg/bootstrap explicitly.
//
// Prefers the merged file (.bni + .bn) over .bni-alone so that
// IR-gen can see which functions have Binate bodies and which are
// true C externs — needed for the IsCExtern / sret ABI distinction
// (see gen_import.bn:registerImportFieldsAndFuncs).
func appendBootstrapImport(ldr @loader.Loader, root *[]const char,
		aliases *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "bootstrap") { return }
	}

	var bsPkg @loader.Package = ldr.GetPackage("pkg/bootstrap")
	if bsPkg == nil { return }

	var bsFile @ast.File
	if bsPkg.Merged != nil {
		bsFile = bsPkg.Merged
	} else if bsPkg.BNI != nil {
		bsFile = bsPkg.BNI
	}
	if bsFile == nil { return }
	*aliases = appendCharSlice(*aliases, "bootstrap")
	*files = appendFilePtr(*files, bsFile)
}

// compileLL writes LLVM IR to a temp .ll file, compiles to .o, cleans up .ll.
// outPrefixFor returns the prefix string that compileLL /
// compileTestModule prepend to the per-module name + extension.
// When --build-dir is set, intermediates land at "<dir>/<name>.<ext>"
// (callers must ensure <dir> exists). Otherwise they land at
// "/tmp/binate_<base>_<name>.<ext>" — the historical layout that
// shares /tmp across concurrent runs.
func outPrefixFor(buildDir *[]const char, base *[]const char) @[]char {
	if len(buildDir) > 0 {
		return bootstrap.Concat(buildDir, "/")
	}
	return bootstrap.Concat(
		bootstrap.Concat("/tmp/binate_", base), "_")
}

// compileLL writes the LLVM IR to "<prefix><name>.ll" and compiles it
// with clang to "<prefix><name>.o". The caller supplies any path
// separator at the tail of `prefix` (e.g. trailing "_" for the legacy
// `/tmp/binate_test` style, or trailing "/" for `--build-dir <dir>`).
func compileLL(llvmIR *[]const char, prefix *[]const char, name *[]const char) @[]char {
	var llFile @[]char = bootstrap.Concat(
		prefix, bootstrap.Concat(name, ".ll"))
	var oFile @[]char = bootstrap.Concat(
		prefix, bootstrap.Concat(name, ".o"))
	writeFile(llFile, llvmIR)

	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo {
		clangArgs = appendRawCharSlice(clangArgs, "-g")
	}
	clangArgs = appendTargetFlags(clangArgs)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-c")
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, oFile)
	clangArgs = appendRawCharSlice(clangArgs, llFile)
	var exitCode int = bootstrap.Exec("clang", clangArgs)

	if exitCode != 0 {
		print("error: clang failed compiling ")
		println(name)
		print("  .ll preserved at: ")
		println(llFile)
		bootstrap.Exit(1)
	}
	remove(llFile)
	return oFile
}

// parseSourceFiles reads and parses source files, exiting on error.
func parseSourceFiles(filenames *[]@[]char) @[]@ast.File {
	var files @[]@ast.File
	for fi := 0; fi < len(filenames); fi++ {
		var src @[]uint8 = readFile(filenames[fi])
		if len(src) == 0 {
			print("error: cannot read ")
			println(filenames[fi])
			bootstrap.Exit(1)
		}
		var p @parser.Parser = parser.New(src, filenames[fi])
		var f @ast.File = p.ParseFile()
		var errors @[]parser.ParseError = p.Errors()
		if len(errors) > 0 {
			for ei := 0; ei < len(errors); ei++ {
				println(errors[ei].Msg)
			}
			bootstrap.Exit(1)
		}
		files = appendFilePtr(files, f)
	}
	return files
}

// mergeFiles merges multiple AST files, or returns the single file.
func mergeFiles(files @[]@ast.File) @ast.File {
	if len(files) == 1 {
		return files[0]
	}
	return loader.MergeFiles(files)
}

// resolveRoot determines the project root from the flag or first filename.
func resolveRoot(rootFlag *[]const char, firstFile *[]const char) *[]const char {
	if len(rootFlag) > 0 {
		return rootFlag
	}
	var root *[]const char = dirOf(firstFile)
	if len(root) == 0 {
		return "."
	}
	return root
}
