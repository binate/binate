package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/codegen"
import "pkg/binate/debug"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/native"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/std/os"
import "pkg/std/os/process"
import "pkg/stdx/fmt"
import "pkg/stdx/slices"

// ============================================================
// Type checking
// ============================================================

// typecheckAll type-checks all loaded packages and the main file,
// returning the populated Checker.  IR-gen consumes the returned
// instance — its `ExprType(id)` registry preserves the per-expression
// resolved types (and bignum-folded values on `TYP_UNTYPED_INT`
// literals / binops).
func typecheckAll(ldr @loader.Loader, mainFile @ast.File) @types.Checker {
	var c @types.Checker = types.NewChecker()
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	if mainFile != nil {
		c.Check(mainFile)
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			fmt.Println(types.FormatCheckError(errs[i]))
		}
		os.Exit(1)
	}
	debug.Log("type checking passed")
	return c
}

// typecheckPackages type-checks loaded packages (no main file).
// Returns the populated Checker for the same reasons as typecheckAll.
func typecheckPackages(ldr @loader.Loader) @types.Checker {
	var c @types.Checker = types.NewChecker()
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
		}
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			fmt.Println(types.FormatCheckError(errs[i]))
		}
		os.Exit(1)
	}
	debug.Log("type checking passed")
	return c
}

// ============================================================
// Single-package compilation mode (--pkg)
// ============================================================

// compileSinglePkg compiles a single package to an object file or LLVM IR.
func compileSinglePkg(cli CLIArgs) {
	var pkgPath @[]char = cli.PkgFlag
	var ldr @loader.Loader = loader.NewLoader()
	applyPathFlags(ldr, cli)
	// Set arch/os for #[build(...)] gating from the active target (baked-in
	// host or --target key), matching the program-compile path in main.bn.
	ldr.BuildConfig = activeBuildConfig(cli.Target)
	// COMDAT groups on weak_odr defs are ELF/COFF-only; Mach-O rejects them.
	codegen.SetEmitComdat(ldr.BuildConfig != nil && !streq(ldr.BuildConfig.OS, "darwin"))

	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = quotePath(pkgPath)
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)

	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			fmt.Println(ldr.Errors[i])
		}
		os.Exit(1)
	}

	// Force-load the implicit runtime dependencies, exactly as the whole-program
	// driver and `--test` do — a package emitted for separate compilation must
	// be as self-contained as a whole-program dependency object.  Without this,
	// a package that references a runtime helper (e.g. `rt.BoundsCheck` from any
	// slice/array index) emits the `call` with no matching `declare`, and clang
	// rejects the .ll (`use of undefined value`).  See ensureRuntimeDepsLoaded.
	// The resulting `--pkg` object is FUNCTIONALLY equivalent to the dependency
	// object the whole-program flow emits: it defines the same package symbols
	// and declares the same externs.  (It may omit some `weak external`
	// interface-id constants the whole-program path emits from program-wide impl
	// registration; those are link-safe coalesced duplicates, defined by their
	// owning package's object regardless.)
	ensureRuntimeDepsLoaded(ldr)

	var checker @types.Checker = typecheckPackages(ldr)

	var pkg @loader.Package = ldr.GetPackage(pkgPath)
	if pkg == nil || pkg.Merged == nil {
		fmt.Print("error: package not found: ", pkgPath, "\n")
		os.Exit(1)
	}

	debug.Log(buf.Concat("compiling ", pkgPath))

	var mod @ir.Module = ir.InitModule(quotePath(pkgPath))
	mod.Checker = checker
	var gc @ir.GenCtx = ir.NewGenCtx(mod)
	registerPkgImports(ldr, pkg, gc)
	if pkg.BNI != nil {
		ir.RegisterSelfTypes(checker, pkg.BNI, gc)
	}
	ir.GeneratePackage(checker, pkg.Merged, gc, pkg.Files)

	debug.Log("IR generation complete")

	if cli.EmitLLVM {
		// --emit-llvm is an LLVM-specific debug dump (there is no native-asm-text
		// equivalent); always print the LLVM IR regardless of --backend.  This
		// path bypasses compileModuleVia, so run the opt passes here too — a
		// developer inspecting -O2 IR must see the optimized form.
		ir.RunOptPasses(mod, optLevel)
		fmt.Print(codegen.EmitModule(mod))
		return
	}

	var pkgName @[]char = buf.CopyStr(shortName(pkgPath))
	var base @[]char = pkgName
	if len(cli.Output) > 0 {
		base = buf.CopyStr(shortName(cli.Output))
	}
	var oPrefix @[]char = outPrefixFor(cli.BuildDir, base)
	// Honor --backend native for a single-package build too (clang for linking
	// only; here there is no link — the caller assembles/links the .o).
	var oFile @[]char = compileModuleVia(mod, oPrefix, pkgName, streq(cli.Backend, "native"))
	fmt.Println(oFile)
}

// outPrefixFor returns the prefix string that compileLL /
// compileModuleVia prepend to the per-module name + extension.
// When --build-dir is set, intermediates land at "<dir>/<name>.<ext>"
// (callers must ensure <dir> exists). Otherwise they land at
// "/tmp/binate_<base>_<name>.<ext>" — the historical layout that
// shares /tmp across concurrent runs.
func outPrefixFor(buildDir *[]readonly char, base *[]readonly char) @[]char {
	if len(buildDir) > 0 {
		return buf.Concat(buildDir, "/")
	}
	return buf.Concat(
			buf.Concat("/tmp/binate_", base), "_")
}

// compileLL writes the LLVM IR to "<prefix><name>.ll" and compiles it
// with clang to "<prefix><name>.o". The caller supplies any path
// separator at the tail of `prefix` (e.g. trailing "_" for the legacy
// `/tmp/binate_test` style, or trailing "/" for `--build-dir <dir>`).
func compileLL(llvmIR *[]readonly char, prefix *[]readonly char, name *[]readonly char) @[]char {
	var llFile @[]char = buf.Concat(
			prefix, buf.Concat(name, ".ll"))
	var oFile @[]char = buf.Concat(
			prefix, buf.Concat(name, ".o"))
	writeFile(llFile, llvmIR)

	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo {
		clangArgs = appendRawCharSlice(clangArgs, "-g")
	}
	clangArgs = appendTargetFlags(clangArgs)
	clangArgs = appendCompileStripFlags(clangArgs)
	// Frame-pointer retention (needed by pkg/std/debug's from-code stacktrace,
	// which walks the hardware frame-pointer chain) is pinned per-function in the
	// emitted IR via the "frame-pointer"="all" attribute (codegen.writeFnDefineAttrs),
	// NOT here: clang's -fno-omit-frame-pointer is a frontend flag and is inert
	// when clang merely assembles pre-generated .ll.
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-c")
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, oFile)
	clangArgs = appendRawCharSlice(clangArgs, llFile)
	status, err := process.Run("clang", &process.Options{SearchPath: true, Args: clangArgs})
	if present(err) || !status.Success() {
		fmt.Print("error: clang failed compiling ", name, "\n")
		fmt.Print("  .ll preserved at: ", llFile, "\n")
		os.Exit(1)
	}
	remove(llFile)
	return oFile
}

// Backend compiles one IR module to a linkable object file, returning the
// .o path (empty string on failure).  It abstracts the driver's two
// code-emission strategies behind a single dispatch:
//   - llvmBackend:   codegen.EmitModule (LLVM IR text) → clang -c → .o
//   - nativeBackend: pkg/binate/native.EmitObject (direct object emission)
//
// Dependency packages always go through llvmBackend; only the main module
// honors --backend native, because the native backend is still a walking
// skeleton that only lowers the main module.
interface Backend {
	compileModule(mod @ir.Module, prefix *[]readonly char, name *[]readonly char) @[]char
}

// llvmBackend emits LLVM IR text and assembles it with clang.
type llvmBackend struct {}

// compileModule emits mod as LLVM IR and compiles it to <prefix><name>.o
// via clang.  compileLL exits the process on a clang failure, so this
// never returns empty.
func (b *llvmBackend) compileModule(mod @ir.Module, prefix *[]readonly char,
		name *[]readonly char) @[]char {
	return compileLL(codegen.EmitModule(mod), prefix, name)
}

impl *llvmBackend : Backend

// nativeBackend emits a native object directly via pkg/binate/native.
type nativeBackend struct {}

// compileModule lowers mod to <prefix><name>.o through the native backend
// for the active --target arch.  Returns empty (after printing a
// diagnostic) on an unsupported arch or an emit failure.
func (b *nativeBackend) compileModule(mod @ir.Module, prefix *[]readonly char,
		name *[]readonly char) @[]char {
	var path @[]char = buf.Concat(prefix, buf.Concat(name, ".o"))
	var arch *[]readonly char = nativeArchForTarget()
	if len(arch) == 0 {
		fmt.Print("error: --backend native has no implementation for --target ", targetTriple, "\n")
		var empty @[]char
		return empty
	}
	if !native.EmitObject(mod, arch, nativeObjFormatForTarget(), path) {
		fmt.Print("error: native backend failed to emit object (arch=", arch, ")\n")
		var empty @[]char
		return empty
	}
	return path
}

impl *nativeBackend : Backend

// compileModuleVia compiles mod to an object file with the LLVM backend, or
// the native backend when useNative is set.  Returns the .o path (empty on
// failure).  Centralizes Backend construction so callers don't repeat the
// llvm/native selection.
func compileModuleVia(mod @ir.Module, prefix *[]readonly char, name *[]readonly char,
		useNative bool) @[]char {
	// The single lowering chokepoint for the compiled path (both backends): run
	// the IR opt passes here, on the finalized module, before any backend sees it.
	ir.RunOptPasses(mod, optLevel)
	var lb llvmBackend
	var nb nativeBackend
	var be *Backend = &lb
	if useNative {
		be = &nb
	}
	return be.compileModule(mod, prefix, name)
}

// parseSourceFiles reads and parses source files, exiting on error.
func parseSourceFiles(filenames *[]@[]char) @[]@ast.File {
	var files @[]@ast.File
	for fi := 0; fi < len(filenames); fi++ {
		var src @[]uint8 = readFile(filenames[fi])
		if len(src) == 0 {
			fmt.Print("error: cannot read ", filenames[fi], "\n")
			os.Exit(1)
		}
		var p @parser.Parser = parser.New(src, filenames[fi])
		var f @ast.File = p.ParseFile()
		var errors @[]parser.ParseError = p.Errors()
		if len(errors) > 0 {
			for ei := 0; ei < len(errors); ei++ {
				fmt.Println(errors[ei].Msg)
			}
			os.Exit(1)
		}
		files = slices.Append[@ast.File](files, f)
	}
	return files
}

// mergeFiles merges multiple AST files, or returns the single file.
func mergeFiles(files @[]@ast.File) @ast.File {
	if len(files) == 1 {
		return files[0]
	}
	return loader.MergeFiles(files)
}
