package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/irgen"
import "pkg/binate/loader"
import "pkg/stdx/slices"

// ============================================================
// Package import registration
// ============================================================
//
// Helpers used by the driver to collect each loaded package's AST,
// gather the path/file lists that pkg/binate/irgen's RegisterImports /
// RegisterStructTypes / RegisterAllInterfaces expect, and ensure
// pkg/builtins/rt is always available in every compiled module (its
// declarations back compiler-emitted calls even when user code
// doesn't import it explicitly).

// collectPkgFile returns the AST file (BNI or merged) for a loaded package.
func collectPkgFile(ldr @loader.Loader, pkgPath *[]readonly char) @ast.File {
	var depPkg @loader.Package = ldr.GetPackage(pkgPath)
	if depPkg == nil { return nil }
	// Prefer the merged file (.bni + .bn) over .bni-alone so that
	// IR-gen sees body presence — matters for the sret ABI hint,
	// where an unbodied extern returning a large aggregate needs the
	// indirect-result convention while a bodied (locally-defined)
	// function is lowered normally.
	if depPkg.Merged != nil {
		return depPkg.Merged
	}
	return depPkg.BNI
}

// appendExposeClosure registers the transitive expose-closure of the module's
// direct imports: for a direct import that is a forwarder (exposes P), P's
// funcs/consts/vars are declared under P's home path, so a resolved-home
// reference `pkg/P.X` reached through the forwarder resolves to a real symbol.
// Uses collectPkgFile (the same Merged-preferring source as direct imports) so
// the C-extern/sret ABI hints match.  `roots` are the module's direct imports;
// the already-built `paths` is the exclude set, so a directly-imported package
// is not re-registered here.
func appendExposeClosure(ldr @loader.Loader, roots @[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	var closure @[]@[]char = ldr.ExposeClosure(roots, *paths)
	for i := 0; i < len(closure); i++ {
		var f @ast.File = collectPkgFile(ldr, closure[i])
		if f != nil {
			*paths = slices.Append[@[]char](*paths, closure[i])
			*files = slices.Append[@ast.File](*files, f)
		}
	}
}

// registerAllStructTypes registers struct type names and fields from ALL loaded
// packages (transitive dependencies). Also registers transitive interface
// declarations for cross-package alias-chain resolution.
func registerAllStructTypes(ldr @loader.Loader, gc @irgen.GenCtx) {
	if len(ldr.Order) == 0 { return }
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(ldr.Order); i++ {
		var depFile @ast.File = collectPkgFile(ldr, ldr.Order[i])
		if depFile != nil {
			paths = slices.Append[@[]char](paths, ldr.Order[i])
			files = slices.Append[@ast.File](files, depFile)
		}
	}
	// paths[k] carries each package's import path; the registries
	// use it directly for qualification so two same-last-segment
	// packages get distinct entries.  Only RegisterImports adds to the
	// module's import list.
	irgen.RegisterStructTypes(paths, files, gc)
	irgen.RegisterAllInterfaces(paths, files, gc)
	// Stash generic decls for EVERY transitively-loaded package, not just the
	// consumer's direct imports.  A cross-package generic body may instantiate
	// another package's generic (genlib.Sum[T] -> mid.F[T]) where that package
	// is a transitive, not direct, import; without its generic decl registered
	// the inner instantiation resolves to an empty mangled name.  Generic decls
	// are in-memory only (no `.ll`), so registering them broadly is cheap.
	irgen.RegisterGenericDecls(paths, files, gc)
}

// pathInList reports whether `p` is present in `list`.
func pathInList(list @[]@[]char, p *[]readonly char) bool {
	for i := 0; i < len(list); i++ {
		if streq(list[i], p) { return true }
	}
	return false
}

// registerGenericBodyExternDeps registers func externs, consts and vars for
// EVERY transitively-loaded package whose code a consumer lowers itself
// (irgen.ReLoweredAtConsumer: a generic declaration, or a constant expression
// re-lowered at each use) and for its imports — the packages that code may name.
// The package itself is among them when the consumer reaches it
// (Loader.ImportClosure), as the consumer can instantiate its generics without
// importing it: through a type another package's declaration names (`func Make()
// @b.Gb[int]`).  A generic body
// monomorphized at the consumer can reach a package two or more import-levels
// below: genlib.Sum[T] (consumer's direct import) instantiates mid.F[T], whose
// body calls deep.G(); mid and deep are transitive, not direct, imports.
// Scanning only the consumer's direct imports (genlib) registers mid's externs
// but never deep's; scanning ALL generic-bearing loaded packages (genlib AND
// mid) registers deep's too.  Those packages are not direct imports of the
// consumer, so RegisterImports doesn't cover them and the body's cross-package
// calls would link against undeclared symbols.  (Their structs/interfaces are
// already registered transitively by registerAllStructTypes; the func
// `declare`s, consts and vars are not.)  Keyed by full path, skipping anything
// already a direct import or already added here.  selfPath is the package
// currently being compiled; a func extern for it is SKIPPED because that TU
// already emits the function's `define` — registering an extern too would emit
// a colliding `declare` (clang: "invalid redefinition").  This is the
// native-codegen counterpart of how the VM resolves such calls via its runtime
// registry.
func registerGenericBodyExternDeps(ldr @loader.Loader, directPaths @[]@[]char,
		selfPath *[]readonly char, gc @irgen.GenCtx) {
	var paths @[]@[]char
	var files @[]@ast.File
	var reach @[]@[]char = ldr.ImportClosure(directPaths)
	for i := 0; i < len(ldr.Order); i++ {
		var p @[]char = ldr.Order[i]
		var pf @ast.File = collectPkgFile(ldr, p)
		var dp @loader.Package = ldr.GetPackage(p)
		if pf == nil || dp == nil || !irgen.ReLoweredAtConsumer(pf, dp.BNI) { continue }
		if pathInList(reach, p) && !streq(p, selfPath) && !pathInList(directPaths, p) &&
				!pathInList(paths, p) {
			paths = slices.Append[@[]char](paths, p)
			files = slices.Append[@ast.File](files, pf)
		}
		for j := 0; j < len(dp.Imports); j++ {
			var q @[]char = dp.Imports[j]
			if streq(q, selfPath) { continue }
			if pathInList(directPaths, q) { continue }
			if pathInList(paths, q) { continue }
			var qf @ast.File = collectPkgFile(ldr, q)
			if qf == nil { continue }
			paths = slices.Append[@[]char](paths, q)
			files = slices.Append[@ast.File](files, qf)
		}
	}
	// A forwarder among these only `expose`s its home, so a body reaching members
	// through it calls the HOME's funcs and upcasts via the HOME's impls: declare
	// the expose closure too (less what is already registered and selfPath).
	var exclude @[]@[]char = slices.Append[@[]char](directPaths, buf.CopyStr(selfPath))
	for i := 0; i < len(paths); i++ {
		exclude = slices.Append[@[]char](exclude, paths[i])
	}
	var closure @[]@[]char = ldr.ExposeClosure(paths, exclude)
	for i := 0; i < len(closure); i++ {
		var cf @ast.File = collectPkgFile(ldr, closure[i])
		if cf == nil { continue }
		paths = slices.Append[@[]char](paths, closure[i])
		files = slices.Append[@ast.File](files, cf)
	}
	if len(paths) > 0 {
		irgen.RegisterGenericBodyDeps(paths, files, gc)
		// Also wire these transitive packages' impls (vtables), so a
		// monomorphized generic body can upcast a receiver to one of their
		// interfaces without a nil vtable (SIGSEGV).
		irgen.RegisterImportedImpls(paths, files, gc)
	}
}

// registerPkgImports registers a package's dependencies into its IR module.
func registerPkgImports(ldr @loader.Loader, pkg @loader.Package, gc @irgen.GenCtx) {
	registerAllStructTypes(ldr, gc)

	var paths @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(ldr, pkg.Imports[j])
			if depFile != nil {
				paths = slices.Append[@[]char](paths, pkg.Imports[j])
				files = slices.Append[@ast.File](files, depFile)
			}
		}
	}

	if !streq(pkg.Path, "pkg/builtins/rt") {
		appendRtImport(ldr, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/builtins/lang") {
		appendLangImport(ldr, &paths, &files)
	}
	appendExposeClosure(ldr, pkg.Imports, &paths, &files)

	irgen.RegisterImports(paths, files, gc)
	registerGenericBodyExternDeps(ldr, pkg.Imports, pkg.Path, gc)
}

// registerMainImports registers imports for the main package.
func registerMainImports(ldr @loader.Loader, file @ast.File, gc @irgen.GenCtx) {
	registerAllStructTypes(ldr, gc)

	var paths @[]@[]char
	var files @[]@ast.File
	var imports @[]@[]char
	for i := 0; i < len(file.Imports); i++ {
		imports = slices.Append[@[]char](imports, buf.CopyStr(unquote(file.Imports[i].Path)))
	}
	for j := 0; j < len(imports); j++ {
		var depFile @ast.File = collectPkgFile(ldr, imports[j])
		if depFile != nil {
			paths = slices.Append[@[]char](paths, imports[j])
			files = slices.Append[@ast.File](files, depFile)
		}
	}

	appendRtImport(ldr, &paths, &files)
	appendLangImport(ldr, &paths, &files)
	appendExposeClosure(ldr, imports, &paths, &files)
	irgen.RegisterImports(paths, files, gc)
	registerGenericBodyExternDeps(ldr, imports, "main", gc)
}

// appendRtImport adds the pkg/builtins/rt import to paths and files if not already present.
func appendRtImport(ldr @loader.Loader, paths *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*paths); i++ {
		if streq((*paths)[i], "pkg/builtins/rt") { return }
	}

	var rtPkg @loader.Package = ldr.GetPackage("pkg/builtins/rt")
	if rtPkg == nil { return }

	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*paths = slices.Append[@[]char](*paths, "pkg/builtins/rt")
	*files = slices.Append[@ast.File](*files, rtFile)
}

// appendLangImport adds pkg/builtins/lang to paths and files if not
// already present.  lang declares the canonical Stringer / Comparable
// impls for the universe primitives, and the compiler force-loads it
// (ensureLangLoaded) so `myInt.String()` resolves without the caller
// importing lang.  A module that calls such a method therefore needs
// lang's signatures registered the same way rt's are, so the
// cross-package call's `declare` is emitted — otherwise the call is an
// undefined symbol at link.  (Naming the lang.Stringer interface type
// still requires the import; that is gated earlier, by the type
// checker, not here.)  Mirrors appendRtImport.
func appendLangImport(ldr @loader.Loader, paths *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*paths); i++ {
		if streq((*paths)[i], "pkg/builtins/lang") { return }
	}

	var langPkg @loader.Package = ldr.GetPackage("pkg/builtins/lang")
	if langPkg == nil { return }

	var langFile @ast.File
	if langPkg.Merged != nil {
		langFile = langPkg.Merged
	} else if langPkg.BNI != nil {
		langFile = langPkg.BNI
	}
	if langFile == nil { return }
	*paths = slices.Append[@[]char](*paths, "pkg/builtins/lang")
	*files = slices.Append[@ast.File](*files, langFile)
}
