package "main"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/stdx/slices"

// ============================================================
// Package import registration
// ============================================================
//
// Helpers used by the driver to collect each loaded package's AST,
// gather the alias/file lists that pkg/binate/ir's RegisterImports /
// RegisterStructTypes / RegisterAllInterfaces expect, and ensure
// pkg/builtins/rt and pkg/bootstrap are always available in every
// compiled module (their declarations back compiler-emitted calls
// even when user code doesn't import them explicitly).

// collectPkgFile returns the AST file (BNI or merged) for a loaded package.
func collectPkgFile(ldr @loader.Loader, pkgPath *[]readonly char) @ast.File {
	var depPkg @loader.Package = ldr.GetPackage(pkgPath)
	if depPkg == nil { return nil }
	// Prefer the merged file (.bni + .bn) over .bni-alone so that
	// IR-gen sees body presence — matters for the IsCExtern / sret
	// ABI hint, where C externs (no body) need C-ABI calls and
	// pure-Binate functions (with body) use Binate ABI.
	if depPkg.Merged != nil {
		return depPkg.Merged
	}
	return depPkg.BNI
}

// registerAllStructTypes registers struct type names and fields from ALL loaded
// packages (transitive dependencies). Also registers transitive interface
// declarations for cross-package alias-chain resolution (Slice 2.9 of
// plan-cross-package-interfaces.md).
func registerAllStructTypes(ldr @loader.Loader) {
	if len(ldr.Order) == 0 { return }
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(ldr.Order); i++ {
		var depFile @ast.File = collectPkgFile(ldr, ldr.Order[i])
		if depFile != nil {
			// Pass the FULL import path as the registration "alias" (not the
			// last segment): two packages sharing a final path segment would
			// otherwise key under the same short name and collide (the alias
			// map first-wins-dedups).  Source-level aliases still bind per-file
			// via pushFileImports; resolveImportPkg maps them to the full path.
			aliases = slices.Append[@[]char](aliases, ldr.Order[i])
			paths = slices.Append[@[]char](paths, ldr.Order[i])
			files = slices.Append[@ast.File](files, depFile)
		}
	}
	// paths[k] carries each package's import path; the registries
	// use it directly for qualification so two same-last-segment
	// packages get distinct entries instead of colliding under the
	// alias map.  The alias map itself is populated only by the
	// importing module's RegisterImports (direct imports), not here.
	ir.RegisterStructTypes(aliases, paths, files)
	ir.RegisterAllInterfaces(aliases, paths, files)
}

// registerPkgImports registers a package's dependencies into its IR module.
func registerPkgImports(ldr @loader.Loader, pkg @loader.Package,
		mod @ir.Module) {
	registerAllStructTypes(ldr)

	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(ldr, pkg.Imports[j])
			if depFile != nil {
				// Full import path as the registration key (same-final-segment
				// packages must not collide under the short-name alias map).
				aliases = slices.Append[@[]char](aliases, pkg.Imports[j])
				paths = slices.Append[@[]char](paths, pkg.Imports[j])
				files = slices.Append[@ast.File](files, depFile)
			}
		}
	}

	if !streq(pkg.Path, "pkg/builtins/rt") {
		appendRtImport(ldr, &aliases, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/bootstrap") {
		appendBootstrapImport(ldr, &aliases, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/builtins/lang") {
		appendLangImport(ldr, &aliases, &paths, &files)
	}

	ir.RegisterImports(aliases, paths, files, mod)
}

// registerMainImports registers imports for the main package.
func registerMainImports(ldr @loader.Loader, file @ast.File, mod @ir.Module) {
	registerAllStructTypes(ldr)

	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	if len(file.Imports) > 0 {
		var imports @[]@[]char
		for i := 0; i < len(file.Imports); i++ {
			imports = slices.Append[@[]char](imports, unquote(file.Imports[i].Path))
		}
		for j := 0; j < len(imports); j++ {
			var depFile @ast.File = collectPkgFile(ldr, imports[j])
			if depFile != nil {
				// Full import path as the registration key (see the transitive
				// registration above) so same-final-segment imports don't collide.
				aliases = slices.Append[@[]char](aliases, imports[j])
				paths = slices.Append[@[]char](paths, imports[j])
				files = slices.Append[@ast.File](files, depFile)
			}
		}
	}

	appendRtImport(ldr, &aliases, &paths, &files)
	appendBootstrapImport(ldr, &aliases, &paths, &files)
	appendLangImport(ldr, &aliases, &paths, &files)
	ir.RegisterImports(aliases, paths, files, mod)
}

// appendRtImport adds the pkg/builtins/rt import to aliases and files if not already present.
func appendRtImport(ldr @loader.Loader,
		aliases *@[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "pkg/builtins/rt") { return }
	}

	var rtPkg @loader.Package = ldr.GetPackage("pkg/builtins/rt")
	if rtPkg == nil { return }

	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*aliases = slices.Append[@[]char](*aliases, "pkg/builtins/rt")
	*paths = slices.Append[@[]char](*paths, "pkg/builtins/rt")
	*files = slices.Append[@ast.File](*files, rtFile)
}

// appendBootstrapImport adds pkg/bootstrap to aliases and files if
// not already present. The print/println builtin's IR-gen lowering
// emits direct calls into pkg/bootstrap (formatInt + Write), so
// every compiled module needs the signatures available even when
// user code doesn't import pkg/bootstrap explicitly.
//
// Prefers the merged file (.bni + .bn) over .bni-alone so that
// IR-gen can see which functions have Binate bodies and which are
// true C externs — needed for the IsCExtern / sret ABI distinction
// (see gen_import.bn:registerImportFieldsAndFuncs).
func appendBootstrapImport(ldr @loader.Loader,
		aliases *@[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "pkg/bootstrap") { return }
	}

	var bsPkg @loader.Package = ldr.GetPackage("pkg/bootstrap")
	if bsPkg == nil { return }

	var bsFile @ast.File
	if bsPkg.Merged != nil {
		bsFile = bsPkg.Merged
	} else if bsPkg.BNI != nil {
		bsFile = bsPkg.BNI
	}
	if bsFile == nil { return }
	*aliases = slices.Append[@[]char](*aliases, "pkg/bootstrap")
	*paths = slices.Append[@[]char](*paths, "pkg/bootstrap")
	*files = slices.Append[@ast.File](*files, bsFile)
}

// appendLangImport adds pkg/builtins/lang to aliases and files if not
// already present.  lang declares the canonical Stringer / Comparable
// impls for the universe primitives, and the compiler force-loads it
// (ensureLangLoaded) so `myInt.String()` resolves without the caller
// importing lang.  A module that calls such a method therefore needs
// lang's signatures registered the same way bootstrap's are, so the
// cross-package call's `declare` is emitted — otherwise the call is an
// undefined symbol at link.  (Naming the lang.Stringer interface type
// still requires the import; that is gated earlier, by the type
// checker, not here.)  Mirrors appendBootstrapImport.
func appendLangImport(ldr @loader.Loader,
		aliases *@[]@[]char, paths *@[]@[]char,
		files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "pkg/builtins/lang") { return }
	}

	var langPkg @loader.Package = ldr.GetPackage("pkg/builtins/lang")
	if langPkg == nil { return }

	var langFile @ast.File
	if langPkg.Merged != nil {
		langFile = langPkg.Merged
	} else if langPkg.BNI != nil {
		langFile = langPkg.BNI
	}
	if langFile == nil { return }
	*aliases = slices.Append[@[]char](*aliases, "pkg/builtins/lang")
	*paths = slices.Append[@[]char](*paths, "pkg/builtins/lang")
	*files = slices.Append[@ast.File](*files, langFile)
}
