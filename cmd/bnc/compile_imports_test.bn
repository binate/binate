package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/loader"
import "pkg/builtins/testing"

// Tests for compile_imports.bn — the implicit-import helpers
// (appendRtImport, appendBootstrapImport).  The earlier
// appendLibcImport was removed in plan-codegen-c-free-copies.md
// step 7: codegen no longer emits @bn_pkg__libc__Memcpy calls, so
// modules no longer need the libc.Memcpy declaration.

// makeLoaderWithPkg builds a minimal Loader with one synthetic
// package registered, for the append*Import tests.
func makeLoaderWithPkg(path *[]const char) @loader.Loader {
	var ldr @loader.Loader = make(loader.Loader)
	var bni @ast.File = make(ast.File)
	bni.PkgName = buf.CopyStr(path)
	var pkg @loader.Package = make(loader.Package)
	pkg.Path = buf.CopyStr(path)
	pkg.BNI = bni
	ldr.Packages = appendPackagePtrTest(ldr.Packages, pkg)
	return ldr
}

// appendPackagePtrTest grows a @[]@loader.Package by one element.
// (The non-test side has its own appender in pkg/binate/loader; this is a
// local copy to avoid pulling in a private helper.)
func appendPackagePtrTest(s @[]@loader.Package, v @loader.Package) @[]@loader.Package {
	var n int = len(s)
	var ns @[]@loader.Package = make_slice(@loader.Package, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendRtImport must add "rt" + the BNI file to the aliases /
// files lists when pkg/builtins/rt is in the loader.
func TestAppendRtImportAdds() testing.TestResult {
	var ldr @loader.Loader = makeLoaderWithPkg("pkg/builtins/rt")
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	var noRoot *[]const char
	appendRtImport(ldr, noRoot, &aliases, &paths, &files)
	if len(aliases) != 1 { return fail("expected 1 alias added") }
	if !seq(aliases[0], "rt") { return fail("alias should be \"rt\"") }
	if len(files) != 1 { return fail("expected 1 file added") }
	return ""
}

// When "rt" is already in aliases, appendRtImport must not add it
// a second time (avoids duplicate Func entries in the IR module).
func TestAppendRtImportNoDuplicate() testing.TestResult {
	var ldr @loader.Loader = makeLoaderWithPkg("pkg/builtins/rt")
	var aliases @[]@[]char = @[]@[]char{buf.CopyStr("rt")}
	var paths @[]@[]char = @[]@[]char{buf.CopyStr("pkg/builtins/rt")}
	var files @[]@ast.File
	var noRoot *[]const char
	appendRtImport(ldr, noRoot, &aliases, &paths, &files)
	if len(aliases) != 1 { return fail("alias should not duplicate") }
	if len(files) != 0 { return fail("file should not be added") }
	return ""
}

// When pkg/builtins/rt isn't loaded, appendRtImport must be a
// graceful no-op (the production path tolerates a missing rt pkg
// during partial loader setup in tests).
func TestAppendRtImportMissingPkg() testing.TestResult {
	var ldr @loader.Loader = make(loader.Loader)
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	var noRoot *[]const char
	appendRtImport(ldr, noRoot, &aliases, &paths, &files)
	if len(aliases) != 0 { return fail("no alias on missing pkg") }
	if len(files) != 0 { return fail("no file on missing pkg") }
	return ""
}
