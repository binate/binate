package "main"

import "pkg/builtins/testing"

// Tests for compile.bn pure functions.

// outPrefixFor: with no --build-dir the prefix is empty, so a deliverable-object
// mode's files land in the current directory (findable), NOT a shared /tmp path.
// The linking modes never reach this case — they default the build dir to a
// unique temp dir first (effectiveBuildDir).
func TestOutPrefixForNoBuildDir() testing.TestResult {
	var noDir *[]readonly char
	var p @[]char = outPrefixFor(noDir)
	if len(p) != 0 { return fail("no-build-dir prefix must be empty (current dir)") }
	return ""
}

// With --build-dir <dir>, the prefix becomes "<dir>/" — the trailing "/" is the
// path separator that compileLL / compileModuleVia glue "<modname>.<ext>" onto.
func TestOutPrefixForBuildDir() testing.TestResult {
	var p @[]char = outPrefixFor("/tmp/work")
	if !seq(p, "/tmp/work/") { return fail("build-dir prefix wrong") }
	return ""
}
