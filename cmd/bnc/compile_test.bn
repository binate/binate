package "main"

import "pkg/ast"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/loader"

// Tests for compile.bn pure functions.

func TestResolveRootWithFlag() testing.TestResult {
	var r *[]const char = resolveRoot("/my/root", "src/main.bn")
	if !seq(r, "/my/root") { return fail("should use root flag") }
	return ""
}

func TestResolveRootFromFile() testing.TestResult {
	var noRoot *[]const char
	var r *[]const char = resolveRoot(noRoot, "/proj/src/main.bn")
	if !seq(r, "/proj/src") { return fail("should derive from file") }
	return ""
}

func TestResolveRootBareFile() testing.TestResult {
	var noRoot *[]const char
	var r *[]const char = resolveRoot(noRoot, "main.bn")
	if !seq(r, ".") { return fail("should default to dot") }
	return ""
}

// outPrefixFor: when --build-dir is empty, fall back to the legacy
// shared /tmp/binate_<base>_ prefix. The trailing "_" is the
// separator that compileLL / compileModuleVia use to glue on
// "<modname>.<ext>" — must be present.
func TestOutPrefixForLegacy() testing.TestResult {
	var noDir *[]const char
	var p @[]char = outPrefixFor(noDir, "test")
	if !seq(p, "/tmp/binate_test_") { return fail("legacy prefix wrong") }
	return ""
}

// With --build-dir <dir>, the prefix becomes "<dir>/" — the trailing
// "/" is the path separator. The base argument is ignored in this
// mode (the caller-chosen dir already isolates the run).
func TestOutPrefixForBuildDir() testing.TestResult {
	var p @[]char = outPrefixFor("/tmp/work", "test")
	if !seq(p, "/tmp/work/") { return fail("build-dir prefix wrong") }
	return ""
}

// Build-dir takes precedence even when base would otherwise be set,
// and base is genuinely ignored (no leakage into the prefix).
func TestOutPrefixForBuildDirIgnoresBase() testing.TestResult {
	var p @[]char = outPrefixFor("/scratch", "compileMain")
	if !seq(p, "/scratch/") {
		return fail("build-dir prefix should ignore base")
	}
	return ""
}

// makeLoaderWithLibc builds a minimal Loader that has a synthetic
// pkg/libc package registered, for the appendLibcImport tests.
func makeLoaderWithLibc() @loader.Loader {
	var ldr @loader.Loader = make(loader.Loader)
	var libcBni @ast.File = make(ast.File)
	libcBni.PkgName = buf.CopyStr("pkg/libc")
	var pkg @loader.Package = make(loader.Package)
	pkg.Path = buf.CopyStr("pkg/libc")
	pkg.BNI = libcBni
	ldr.Packages = appendPackagePtrTest(ldr.Packages, pkg)
	return ldr
}

// appendPackagePtrTest grows a @[]@loader.Package by one element.
// (The non-test side has its own appender in pkg/loader; this is a
// local copy to avoid pulling in a private helper.)
func appendPackagePtrTest(s @[]@loader.Package, v @loader.Package) @[]@loader.Package {
	var n int = len(s)
	var ns @[]@loader.Package = make_slice(@loader.Package, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendLibcImport must add "libc" + the BNI file to the aliases /
// files lists when pkg/libc is in the loader and not yet present.
// Regression test for the missing-declare bug: every package that
// emits a string copy needs libc.Memcpy in its IR module so the
// `declare` line gets emitted alongside the call.
func TestAppendLibcImportAdds() testing.TestResult {
	var ldr @loader.Loader = makeLoaderWithLibc()
	var aliases @[]@[]char
	var files @[]@ast.File
	var noRoot *[]const char
	appendLibcImport(ldr, noRoot, &aliases, &files)
	if len(aliases) != 1 { return fail("expected 1 alias added") }
	if !seq(aliases[0], "libc") { return fail("alias should be \"libc\"") }
	if len(files) != 1 { return fail("expected 1 file added") }
	return ""
}

// When "libc" is already in aliases, appendLibcImport must not add
// it a second time (or the IR module gets duplicate Func entries).
func TestAppendLibcImportNoDuplicate() testing.TestResult {
	var ldr @loader.Loader = makeLoaderWithLibc()
	var aliases @[]@[]char = @[]@[]char{buf.CopyStr("libc")}
	var files @[]@ast.File
	var noRoot *[]const char
	appendLibcImport(ldr, noRoot, &aliases, &files)
	if len(aliases) != 1 { return fail("alias should not duplicate") }
	if len(files) != 0 { return fail("file should not be added") }
	return ""
}

// When pkg/libc isn't loaded, appendLibcImport must be a graceful
// no-op (the production path tolerates a missing libc package, e.g.
// during partial loader setup in tests).
func TestAppendLibcImportMissingPkg() testing.TestResult {
	var ldr @loader.Loader = make(loader.Loader)
	var aliases @[]@[]char
	var files @[]@ast.File
	var noRoot *[]const char
	appendLibcImport(ldr, noRoot, &aliases, &files)
	if len(aliases) != 0 { return fail("no alias on missing pkg") }
	if len(files) != 0 { return fail("no file on missing pkg") }
	return ""
}
