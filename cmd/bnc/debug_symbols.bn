package "main"

import "pkg/binate/debug"
import "pkg/std/fmt"
import "pkg/std/os/process"

// needsDebugSymbols reports whether a linked program's debug info must be gathered
// into a bundle beside it: with -g on a Mach-O target.  There the linker leaves the
// DWARF in the objects and the program only names them (its debug map), and bnc
// removes the objects after the link, so the program would have no debug info.  An
// ELF linker copies the DWARF into the program.
func needsDebugSymbols() bool {
	return debugInfo && streq(nativeObjFormatForTarget(), "macho")
}

// gatherDebugSymbols runs dsymutil on the linked program at output, which writes
// its debug info into output.dSYM, where lldb finds it.  It must run before the
// objects the program names are removed.  A no-op unless needsDebugSymbols; it
// reports false, having printed the error, when dsymutil fails.
func gatherDebugSymbols(output *[]readonly char) bool {
	if !needsDebugSymbols() { return true }
	debug.Log("gathering debug symbols")
	var args @[]@[]char
	args = appendRawCharSlice(args, output)
	status, err := process.Run("dsymutil", &process.Options{SearchPath: true, Args: args})
	if present(err) || !status.Success() {
		fmt.Println("error: dsymutil failed")
		return false
	}
	return true
}
