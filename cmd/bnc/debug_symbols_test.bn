package "main"

import "pkg/builtins/testing"

// Tests for cmd/bnc/debug_symbols.bn.  The dsymutil run itself is covered by
// e2e/debug-info-lldb.sh, which debugs a -g program on macOS.

// A Mach-O target gathers the debug info with -g only; an ELF target never does.
func TestNeedsDebugSymbols() testing.TestResult {
	resetTargetState()
	applyTarget("aarch64-darwin")
	debugInfo = true
	var macho bool = needsDebugSymbols()
	debugInfo = false
	var machoNoDebug bool = needsDebugSymbols()
	resetTargetState()
	applyTarget("x86_64-linux")
	debugInfo = true
	var elf bool = needsDebugSymbols()
	debugInfo = false
	resetTargetState()
	if !macho { return fail("a -g Mach-O link gathers its debug info") }
	if machoNoDebug { return fail("a Mach-O link without -g has no debug info to gather") }
	if elf { return fail("an ELF link copies the DWARF into the program itself") }
	return ""
}

// Without -g, gatherDebugSymbols runs nothing and succeeds, whatever the output.
func TestGatherDebugSymbolsNoopWithoutDebugInfo() testing.TestResult {
	resetTargetState()
	applyTarget("aarch64-darwin")
	debugInfo = false
	var ok bool = gatherDebugSymbols("/nonexistent/prog")
	resetTargetState()
	if !ok { return fail("gatherDebugSymbols without -g must not run dsymutil") }
	return ""
}
