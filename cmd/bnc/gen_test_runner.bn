package "main"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"
import "pkg/stdx/slices"

// testRunnerStdlibImports returns the stdlib packages the generated test
// runner imports beyond the test packages and the universally-loaded
// runtime (pkg/bootstrap, plus pkg/builtins/lang which the compiler
// force-loads for unqualified `.String()`).  test.bn force-loads these
// before typecheck so they compile and link into the test binary even
// when no test package imports them — that's what lets the runner depend
// on the stdlib (see [B] in claude-todo.md).  Adding a real dependency is
// a one-line change here plus its use in genTestRunner's main().
//
// pkg/std/os is a real dependency: the generated runner calls os.Exit for its
// exit and os.Args() for its --run filter (only the print/println sink stays
// bootstrap.Write).  pkg/std/errors is now a near-placeholder
// kept only so [B] stays exercised end-to-end; it could be dropped (with its
// stub use in main()) as a follow-up, since os is a genuine stdlib dependency.
func testRunnerStdlibImports() @[]@[]char {
	var r @[]@[]char
	r = slices.Append[@[]char](r, "pkg/std/errors")
	r = slices.Append[@[]char](r, "pkg/std/os")
	return r
}

// genTestRunner generates Binate source for a test runner main() that calls
// all discovered test functions and reports results.  The emitted binary
// accepts `--run <substr>` (or `-run <substr>`) to limit execution to test
// names containing that substring — mirrors `cmd/bni --test --run` and
// `go test -run`, but plain substring (no regex).
func genTestRunner(pkgPaths *[]@[]char, tests @[]TestFunc) @[]char {
	var cb @strings.Builder = strings.NewBuilder()
	cb.Write("package \"main\"\n\n")

	// Import test packages
	var bootstrapImported bool = false
	for i := 0; i < len(pkgPaths); i++ {
		cb.Write("import \"")
		cb.Write(pkgPaths[i])
		cb.Write("\"\n")
		if streq(pkgPaths[i], "pkg/bootstrap") {
			bootstrapImported = true
		}
	}
	if !bootstrapImported {
		cb.Write("import \"pkg/bootstrap\"\n")
	}
	// The runner's own stdlib dependencies (force-loaded by test.bn).
	// Dedup against the test packages so testing a stdlib package itself
	// doesn't emit a duplicate import.
	var stdlibImps @[]@[]char = testRunnerStdlibImports()
	for si := 0; si < len(stdlibImps); si++ {
		var already bool = false
		for pj := 0; pj < len(pkgPaths); pj++ {
			if streq(pkgPaths[pj], stdlibImps[si]) { already = true }
		}
		if !already {
			cb.Write("import \"")
			cb.Write(stdlibImps[si])
			cb.Write("\"\n")
		}
	}
	cb.Write("\n")

	// Filter-support helpers.  Prefixed with `_runner` so the names
	// don't collide with anything in the test packages being imported.
	cb.Write(
			"func _runnerStreq(a *[]readonly char, b *[]readonly char) bool {\n"
					"\tif len(a) != len(b) { return false }\n"
					"\tfor i := 0; i < len(a); i++ {\n"
					"\t\tif a[i] != b[i] { return false }\n"
					"\t}\n"
					"\treturn true\n"
					"}\n\n")

	cb.Write(
			"// _runnerFilter returns the value passed to --run / -run, or an\n"
					"// empty slice if neither flag is set.  Reads argv via os.Args()\n"
					"// (element 0 the program name, 1.. the arguments), so under the\n"
					"// bytecode interpreter it sees the argv installed via os.SetArgs.\n"
					"func _runnerFilter() @[]readonly char {\n"
					"\tvar args @[]readonly @[]readonly char = os.Args()\n"
					"\tfor i := 1; i < len(args); i++ {\n"
					"\t\tif _runnerStreq(args[i], \"--run\") && i + 1 < len(args) {\n"
					"\t\t\treturn args[i + 1]\n"
					"\t\t}\n"
					"\t\tif _runnerStreq(args[i], \"-run\") && i + 1 < len(args) {\n"
					"\t\t\treturn args[i + 1]\n"
					"\t\t}\n"
					"\t}\n"
					"\treturn \"\"\n"
					"}\n\n")

	cb.Write(
			"// _runnerShouldRun: substring match, empty filter accepts all.\n"
					"func _runnerShouldRun(name *[]readonly char, filter *[]readonly char) bool {\n"
					"\tif len(filter) == 0 { return true }\n"
					"\tif len(filter) > len(name) { return false }\n"
					"\tvar stop int = len(name) - len(filter)\n"
					"\tfor i := 0; i <= stop; i++ {\n"
					"\t\tvar match bool = true\n"
					"\t\tfor j := 0; j < len(filter); j++ {\n"
					"\t\t\tif name[i + j] != filter[j] { match = false; break }\n"
					"\t\t}\n"
					"\t\tif match { return true }\n"
					"\t}\n"
					"\treturn false\n"
					"}\n\n")

	// main function
	cb.Write(
			"func main() {\n"
					"\tvar _runnerRunFilter @[]readonly char = _runnerFilter()\n"
					"\tvar passed int = 0\n"
					"\tvar failed int = 0\n"
					"\t// [B] stub — a harmless call into a stdlib package the test\n"
					"\t// packages may not import, keeping the runner-depends-on-stdlib\n"
					"\t// path compiled+linked.  TODO: remove with the placeholder in\n"
					"\t// testRunnerStdlibImports once a real stdlib dep lands.\n"
					"\t_ = errors.New(make_slice(char, 0))\n\n")

	for i := 0; i < len(tests); i++ {
		var alias *[]readonly char = lastSegment(tests[i].PkgPath)
		var name @[]char = tests[i].FuncName

		// Skip when --run filter is non-empty and name doesn't match.
		cb.Write("\tif _runnerShouldRun(\"")
		cb.Write(name)
		cb.Write("\", _runnerRunFilter) {\n")

		// println("=== RUN   TestName")
		cb.Write("\t\tprintln(\"=== RUN   ")
		cb.Write(name)
		cb.Write("\")\n")

		// var r_N @[]char = alias.TestName()
		cb.Write("\t\tvar r_")
		stringutils.WriteInt(cb, i)
		cb.Write(" @[]char = ")
		cb.Write(alias)
		cb.Write(".")
		cb.Write(name)
		cb.Write("()\n")

		// if len(r_N) > 0 { ... } else { ... }
		cb.Write("\t\tif len(r_")
		stringutils.WriteInt(cb, i)
		cb.Write(") > 0 {\n")

		cb.Write("\t\t\tprint(\"--- FAIL: ")
		cb.Write(name)
		cb.Write(
				"\\n    \")\n"
						"\t\t\tprintln(r_")
		stringutils.WriteInt(cb, i)
		cb.Write(
				")\n"
						"\t\t\tfailed = failed + 1\n")

		cb.Write(
				"\t\t} else {\n"
						"\t\t\tprintln(\"--- PASS: ")
		cb.Write(name)
		cb.Write(
				"\")\n"
						"\t\t\tpassed = passed + 1\n"
						"\t\t}\n")

		cb.Write("\t}\n\n")
	}

	// Summary.  The pass/fail counts format via the universe `int`
	// String() impl (passed.String()), which resolves and links without
	// the runner importing pkg/builtins/lang — the compiler force-loads
	// lang (ensureLangLoaded / appendLangImport).  No bootstrap.Itoa.
	cb.Write(
			"\tprintln(\"\")\n"
					"\tif failed > 0 {\n"
					"\t\tprint(\"FAIL\\t\")\n"
					"\t\tprint(passed.String())\n"
					"\t\tprint(\" passed, \")\n"
					"\t\tprint(failed.String())\n"
					"\t\tprintln(\" failed\")\n"
					"\t\tos.Exit(1)\n"
					"\t} else {\n"
					"\t\tprint(\"ok\\t\")\n"
					"\t\tprint(passed.String())\n"
					"\t\tprintln(\" passed\")\n"
					"\t}\n"
					"}\n")
	return buf.CopyStr(cb.String())
}

// lastSegment returns the part of path after the last '/'.
func lastSegment(path *[]readonly char) *[]readonly char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { last = i + 1 }
	}
	return path[last:]
}
