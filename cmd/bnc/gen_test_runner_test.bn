package "main"

import "pkg/builtins/testing"
import "pkg/stdx/slices"

// ============================================================
// lastSegment tests
// ============================================================

func TestLastSegmentSimple() testing.TestResult {
	var s *[]readonly char = lastSegment("main")
	if !seq(s, "main") { return fail("expected main") }
	return ""
}

func TestLastSegmentOneSlash() testing.TestResult {
	var s *[]readonly char = lastSegment("pkg/binate/parser")
	if !seq(s, "parser") { return fail("expected parser") }
	return ""
}

func TestLastSegmentDeep() testing.TestResult {
	var s *[]readonly char = lastSegment("pkg/binate/asm/aarch64")
	if !seq(s, "aarch64") { return fail("expected aarch64") }
	return ""
}

// ============================================================
// genTestRunner tests
// ============================================================

func TestGenTestRunnerEmpty() testing.TestResult {
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ir"}
	var tests @[]TestFunc
	var src @[]char = genTestRunner(pkgs, tests)
	// Should contain package declaration and import
	if !hasPrefix(src, "package \"main\"") {
		return fail("should start with package main")
	}
	return ""
}

func TestGenTestRunnerWithTest() testing.TestResult {
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ir"}
	var tests @[]TestFunc
	var tf TestFunc
	tf.PkgPath = "pkg/binate/ir"
	tf.FuncName = "TestFoo"
	tests = slices.Append[TestFunc](tests, tf)
	var src @[]char = genTestRunner(pkgs, tests)
	// Should contain the test function call
	if !containsStr(src, "ir.TestFoo()") {
		return fail("should contain ir.TestFoo()")
	}
	return ""
}

// Filter machinery should be emitted into every runner, gated on
// --run.  Empty filter must accept all tests (default behavior).
func TestGenTestRunnerEmitsFilterHelpers() testing.TestResult {
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ir"}
	var tests @[]TestFunc
	var tf TestFunc
	tf.PkgPath = "pkg/binate/ir"
	tf.FuncName = "TestFoo"
	tests = slices.Append[TestFunc](tests, tf)
	var src @[]char = genTestRunner(pkgs, tests)
	if !containsStr(src, "_runnerFilter()") {
		return fail("missing _runnerFilter() emit")
	}
	if !containsStr(src, "_runnerSelected(\"TestFoo\"") {
		return fail("missing _runnerSelected gate around TestFoo")
	}
	if !containsStr(src, "os.Args()") {
		return fail("filter must read process args via os.Args()")
	}
	return ""
}

// The runner also honors --skip (exclude by substring) and --shard-index /
// --shard-count (run 1/N of the run/skip-selected set, positions where
// p % count == idx-1), mirroring cmd/bni.  Each test's gate must couple the
// --run/--skip selection with the shard-slot advance so the position is stable
// across shards.
func TestGenTestRunnerEmitsShardSkip() testing.TestResult {
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ir"}
	var tests @[]TestFunc
	var tf TestFunc
	tf.PkgPath = "pkg/binate/ir"
	tf.FuncName = "TestFoo"
	tests = slices.Append[TestFunc](tests, tf)
	var src @[]char = genTestRunner(pkgs, tests)
	if !containsStr(src, "--skip") { return fail("runner must read --skip") }
	if !containsStr(src, "--shard-index") { return fail("runner must read --shard-index") }
	if !containsStr(src, "--shard-count") { return fail("runner must read --shard-count") }
	if !containsStr(src, "_runnerTakeSlot()") {
		return fail("per-test gate must advance the shard slot via _runnerTakeSlot()")
	}
	// --skip is a comma-separated list (mirrors cmd/bni): the emitted matcher must
	// split on ',' and substring-match each part.
	if !containsStr(src, "skip[start:i]") {
		return fail("--skip must be comma-separated (multi-pattern), not a single substring")
	}
	if !containsStr(src,
			"_runnerSelected(\"TestFoo\", _runnerRunFilter, _runnerSkipFilter) && _runnerTakeSlot()") {
		return fail("TestFoo must be gated by --run/--skip selection AND the shard slot")
	}
	return ""
}

func TestGenTestRunnerSummary() testing.TestResult {
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ir"}
	var tests @[]TestFunc
	var src @[]char = genTestRunner(pkgs, tests)
	// Should contain pass/fail summary
	if !containsStr(src, "passed") {
		return fail("should contain passed in summary")
	}
	return ""
}

// The runner emits its output through pkg/std/fmt — and importantly, the
// `bnc --test` path now type-checks the runner before IR-gen so fmt's `*any`
// boxing gets the operand's resolved type (a string boxes as `*[]readonly char`,
// not its `char` element).  If a future edit drops the fmt import or otherwise
// changes how the runner emits its output, catch it here.
func TestGenTestRunnerEmitsFmt() testing.TestResult {
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ir"}
	var tests @[]TestFunc
	var tf TestFunc
	tf.PkgPath = "pkg/binate/ir"
	tf.FuncName = "TestFoo"
	tests = slices.Append[TestFunc](tests, tf)
	var src @[]char = genTestRunner(pkgs, tests)
	if !containsStr(src, "import \"pkg/std/fmt\"") {
		return fail("runner must import pkg/std/fmt")
	}
	if !containsStr(src, "fmt.Println(\"=== RUN") {
		return fail("runner must emit RUN lines via fmt.Println")
	}
	return ""
}

// ============================================================
// Helpers
// ============================================================

func containsStr(hay *[]readonly char, needle *[]readonly char) bool {
	if len(needle) == 0 { return true }
	if len(hay) < len(needle) { return false }
	for i := 0; i <= len(hay) - len(needle); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if hay[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}
