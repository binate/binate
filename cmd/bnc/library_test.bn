package "main"

import "pkg/builtins/testing"

// libraryArchivePath: an explicit -o value is used verbatim; otherwise the
// default archive is `lib<facade-short-name>.a`.

func TestLibraryArchivePathExplicit() testing.TestResult {
	var p @[]char = libraryArchivePath("out/libfoo.a", "pkg/foo")
	if !seq(p, "out/libfoo.a") {
		return fail("explicit -o path should be used verbatim")
	}
	return ""
}

func TestLibraryArchivePathDefault() testing.TestResult {
	var p @[]char = libraryArchivePath("", "pkg/foo")
	if !seq(p, "libfoo.a") {
		return fail("default archive should be lib<facade>.a (short name)")
	}
	return ""
}
