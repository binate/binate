package "main"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/codegen"
import "pkg/debug"
import "pkg/ir"
import "pkg/loader"
import "pkg/mangle"
import "pkg/native"
import "pkg/types"

// debugInfo mirrors --debug / -g for the rest of the driver to read.
// Set once in main() before any compilation happens.
var debugInfo bool
// extraClangFlags collects --cflag arguments passed through to the linker.
// Set once in main() from the parsed CLIArgs.
var extraClangFlags @[]@[]char
// targetTriple is the clang target triple to pass via `-target ...`
// to clang invocations (compile-IR-to-.o + link).  Empty for the
// default host build; set by applyTarget() when --target selects a
// non-host target.  Read by compileLL and the link steps in main()
// and runTestMode.
var targetTriple @[]char
// targetClangFlags is additional fixed clang flags for the current
// --target (after `-target <triple>`).  E.g. bare-metal targets
// need `-mfloat-abi=soft` + `-ffreestanding`; libc-host targets
// don't.  Populated by applyTarget alongside targetTriple.  Empty
// for the default host build.
var targetClangFlags @[]@[]char
// targetImplPathSuffixes is a list of impl-path directories
// relative to the binate root that should be prepended to the
// loader's impl-path when this target is active — used by the
// path mechanism to swap in target-specific runtime impls
// (e.g. arm32-baremetal swaps in runtime/baremetal_arm32/pkg/...
// over the default libc-host pkg/...).  Resolved against the
// concrete root in applyPathFlags.  Empty for the host build.
var targetImplPathSuffixes @[]@[]char
// targetRuntimeFiles is the list of additional files (relative to
// the binate root) that bnc should pass to clang at link time for
// this target — e.g. arm32-baremetal's crt0.s + semihost.s.  See
// appendTargetRuntime.  Empty for the host build.
var targetRuntimeFiles @[]@[]char
// targetLinkerScript is the linker script (relative to the binate
// root) that bnc should pass to clang via `-Wl,-T,<script>`.  Used
// by bare-metal targets to lay out memory under the host RAM map
// (e.g. QEMU virt's 0x40000000 base).  Empty for the host build.
var targetLinkerScript @[]char
// suppressHostRuntime, when true, tells the link step to NOT add
// the default `runtime/binate_runtime.c` + rt_stubs + libc_stubs.
// Used by freestanding / no-libc targets (arm32-baremetal) that
// supply their own crt0 + runtime via targetRuntimeFiles.
var suppressHostRuntime bool

// Binate compiler driver.
// Usage: bnc [flags] <file.bn|dir>

// main is the entry point for the compiler CLI.
func main() {
	var args @[]@[]char = bootstrap.Args()
	if len(args) == 0 {
		printUsage()
		bootstrap.Exit(1)
	}

	var cli CLIArgs = parseArgs(args)

	if cli.Verbose {
		debug.SetVerbose(true)
	}
	if cli.Debug {
		debugInfo = true
		codegen.SetDebugInfo(true)
	}
	extraClangFlags = cli.ClangFlags

	// Resolve --target before any type-checking happens (SizeOf
	// during type checking depends on the target layout).
	applyTarget(cli.Target)

	// --test mode: compile and run test packages
	// (Filenames are package paths, NOT source files — don't expand dirs)
	if cli.TestMode {
		runTestMode(cli)
		return
	}

	cli.Filenames = expandDirArgs(cli.Filenames)

	// --pkg mode: compile a single package
	if len(cli.PkgFlag) > 0 {
		if len(cli.BniPaths) == 0 {
			println("error: --pkg requires -I <dir> to locate the package")
			bootstrap.Exit(1)
		}
		compileSinglePkg(cli)
		return
	}

	if len(cli.Filenames) == 0 {
		printUsage()
		bootstrap.Exit(1)
	}

	var filename @[]char = cli.Filenames[0]

	// Defaults
	var output @[]char = cli.Output
	if len(output) == 0 && !cli.EmitLLVM && !cli.CompileOnly {
		output = stripExt(filename)
	}
	var runtimePath @[]char = buf.CopyStr(cli.RuntimePath)
	if len(runtimePath) == 0 {
		runtimePath = findRuntime(filename)
	}

	// Parse and merge
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var file @ast.File = mergeFiles(files)
	debug.Log("parsing complete")

	// Load imports
	var root @[]char = buf.CopyStr(resolveRoot(primaryRoot(cli), filename))
	var ldr @loader.Loader = loader.NewLoader(root)
	var binateRoot @[]char = buf.CopyStr(discoverBinateRoot(runtimePath))
	if len(binateRoot) > 0 && !streq(binateRoot, root) {
		ldr.AddRoot(binateRoot)
	}
	applyPathFlags(ldr, cli, root)
	ldr.LoadImports(file.Imports)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}
	ensureRtLoaded(ldr)
	ensureBootstrapLoaded(ldr)
	debug.Log("imports loaded")

	// Type check
	typecheckAll(ldr, file)

	// Output prefix for intermediate files. With --build-dir <d>,
	// files land at "<d>/<modname>.<ext>"; otherwise the legacy
	// "/tmp/binate_<base>_<modname>.<ext>" layout (where <base> is
	// derived from -o or the input filename) is used.
	var base @[]char = shortName(buf.CopyStr(stripExt(filename)))
	if len(output) > 0 {
		base = shortName(buf.CopyStr(output))
	}
	var outPrefix @[]char = outPrefixFor(cli.BuildDir, base)

	// Native backend (walking skeleton): only handles the main file, no deps.
	if streq(cli.Backend, "native") {
		compileMainNative(file, ldr, root, output, outPrefix, runtimePath)
		return
	}

	// Compile dependency packages.  Track which ones emit
	// a `<pkg>.__init` (top-level var initializers) so the
	// main module's init dispatcher can list them in dep order.
	var oFiles @[]@[]char
	var initPkgNames @[]@[]char
	if len(ldr.Order) > 0 {
		for i := 0; i < len(ldr.Order); i++ {
			var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
			if pkg == nil || pkg.Builtin || pkg.Merged == nil { continue }
			debug.Log(bootstrap.Concat("compiling ", ldr.Order[i]))
			var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
			registerPkgImports(ldr, pkg, mod, root)
			if pkg.BNI != nil { ir.RegisterSelfTypes(pkg.BNI) }
			ir.GeneratePackage(pkg.Merged, mod)
			if mod.HasPackageInit() {
				initPkgNames = appendRawCharSlice(initPkgNames,
					ir.PackageInitName(
						mangle.PkgShortNameFromModule(ldr.Order[i])))
			}
			var llvmIR @[]char = codegen.EmitModule(mod)
			var oFile @[]char = compileLL(llvmIR, outPrefix, shortName(ldr.Order[i]))
			oFiles = appendRawCharSlice(oFiles, oFile)
		}
	}

	// Compile main package
	debug.Log("compiling main")
	var mainMod @ir.Module = ir.InitModule(file.PkgName)
	registerMainImports(ldr, file, mainMod, root)
	ir.GeneratePackage(file, mainMod)
	// Append main's own __init last so it runs after dep inits.
	if mainMod.HasPackageInit() {
		initPkgNames = appendRawCharSlice(initPkgNames,
			ir.PackageInitName(
				mangle.PkgShortNameFromModule(file.PkgName)))
	}
	// Always emit `<main>.__init_all` and `<main>.__entry` (the
	// latter mangles to `bn_entry`, the C runtime's sole entry
	// into Binate; the former is unconditionally called by
	// `__entry`).  Both must exist for every binary so the
	// runtime's `bn_entry` extern always resolves at link time.
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()
	var mainIR @[]char = codegen.EmitModule(mainMod)
	debug.Log("IR generation complete")

	if cli.EmitLLVM {
		print(mainIR)
		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		return
	}

	var mainO @[]char = compileLL(mainIR, outPrefix, "main")
	oFiles = appendRawCharSlice(oFiles, mainO)

	if cli.CompileOnly {
		for i := 0; i < len(oFiles); i++ { println(oFiles[i]) }
		return
	}

	// Link
	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
	clangArgs = appendTargetFlags(clangArgs)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, output)
	for i := 0; i < len(oFiles); i++ { clangArgs = appendRawCharSlice(clangArgs, oFiles[i]) }
	if !suppressHostRuntime && len(runtimePath) > 0 {
		clangArgs = appendRawCharSlice(clangArgs, runtimePath)
		var rtStubs @[]char = findRtStubs(runtimePath)
		if len(rtStubs) > 0 { clangArgs = appendRawCharSlice(clangArgs, rtStubs) }
		var libcStubs @[]char = findLibcStubs(runtimePath)
		if len(libcStubs) > 0 { clangArgs = appendRawCharSlice(clangArgs, libcStubs) }
	}
	clangArgs = appendTargetRuntime(clangArgs, root)

	debug.Log("linking")
	var exitCode int = bootstrap.Exec("clang", clangArgs)
	for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
	if exitCode != 0 {
		println("error: link failed")
		bootstrap.Exit(1)
	}
	debug.Log("compilation complete")
}

// applyTarget translates the --target CLI key into a types.TargetInfo
// and applies it via types.SetTarget. Empty / "host" leaves the
// current LP64 defaults in place; any unknown key is a hard error
// before compilation begins. Recognised keys:
//   ""                — same as "host"
//   "host"            — default 64-bit LP64 layout
//   "arm32-linux"     — 32-bit ILP32 ARM Linux (hard-float ABI), with
//                       libc-host runtime cross-compiled.  v0
//                       derisking path for the bare-metal target.
//   "arm32-baremetal" — 32-bit ILP32 ARM bare-metal (soft-float),
//                       freestanding (no libc, no hosted env).  v1
//                       target — see plan-arm32-bare-metal.md.
func applyTarget(key *[]const char) {
	if len(key) == 0 || streq(key, "host") { return }
	if streq(key, "arm32-linux") {
		setArm32Layout()
		targetTriple = "armv7-linux-gnueabihf"
		return
	}
	if streq(key, "arm32-baremetal") {
		setArm32Layout()
		targetTriple = "armv7a-none-eabi"
		targetClangFlags = appendRawCharSlice(targetClangFlags, "-mfloat-abi=soft")
		targetClangFlags = appendRawCharSlice(targetClangFlags, "-ffreestanding")
		targetClangFlags = appendRawCharSlice(targetClangFlags, "-nostdlib")
		// On macOS dev boxes the bare-metal ELF link won't work
		// out of the box — Apple's `ld` rejects ELF flags like
		// -T / --target2=rel.  Install `llvm` via Homebrew and
		// pass `--cflag -fuse-ld=lld` to bnc, or run the bare-
		// metal pipeline on a Linux host where clang's default
		// linker handles ELF cross-targets.  CI's ubuntu-latest
		// runner picks up the cross-linker automatically.
		targetImplPathSuffixes = appendRawCharSlice(targetImplPathSuffixes,
			"runtime/baremetal_arm32")
		targetRuntimeFiles = appendRawCharSlice(targetRuntimeFiles,
			"runtime/baremetal_arm32/crt0.s")
		targetRuntimeFiles = appendRawCharSlice(targetRuntimeFiles,
			"runtime/baremetal_arm32/semihost.s")
		targetLinkerScript = "runtime/baremetal_arm32/baremetal.ld"
		suppressHostRuntime = true
		return
	}
	print("error: unknown --target ")
	println(key)
	bootstrap.Exit(1)
}

// setArm32Layout sets the 32-bit ILP32 layout (4-byte pointers and
// ints, 4-byte max alignment).  Shared by arm32-linux and
// arm32-baremetal; layout doesn't depend on the platform ABI or
// freestanding-ness.
func setArm32Layout() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 4
	types.SetTarget(t)
}

// appendTargetFlags adds `-target <triple>` and the per-target
// fixed clang flags to a clang argv when a non-host target is
// active.  No-op for the default host build.
func appendTargetFlags(args @[]@[]char) @[]@[]char {
	if len(targetTriple) == 0 { return args }
	args = appendRawCharSlice(args, "-target")
	args = appendRawCharSlice(args, targetTriple)
	for i := 0; i < len(targetClangFlags); i++ {
		args = appendRawCharSlice(args, targetClangFlags[i])
	}
	return args
}

// appendTargetRuntime adds the target-specific runtime files
// (relative to `root`) to a clang link argv plus the
// `-Wl,-T,<linker-script>` directive when one is set.  No-op for
// the default host build; bare-metal targets append crt0.s +
// semihost.s + the QEMU virt linker script via this path.
func appendTargetRuntime(args @[]@[]char, root *[]const char) @[]@[]char {
	for i := 0; i < len(targetRuntimeFiles); i++ {
		var abs @[]char = bootstrap.Concat(
			bootstrap.Concat(root, "/"),
			targetRuntimeFiles[i])
		args = appendRawCharSlice(args, abs)
	}
	if len(targetLinkerScript) > 0 {
		var script @[]char = bootstrap.Concat(
			bootstrap.Concat(root, "/"),
			targetLinkerScript)
		args = appendRawCharSlice(args,
			bootstrap.Concat("-Wl,-T,", script))
	}
	return args
}

// compileMainNative is the walking-skeleton native path. It generates IR for
// the main file only (no deps), emits an AArch64 Mach-O object via
// pkg/native, then invokes clang to link against runtime/binate_runtime.c.
// Limitations: aarch64 Mach-O only; skips dependency packages; functions
// other than empty main are not yet lowered (see pkg/native/aarch64).
func compileMainNative(file @ast.File, ldr @loader.Loader, root *[]const char,
	output *[]const char, outPrefix *[]const char, runtimePath *[]const char) {
	debug.Log("native: compiling main")

	// Compile dependency packages (e.g. pkg/rt) via LLVM. Until the
	// native backend grows enough to self-host the runtime, we lean on
	// the existing LLVM path for everything that isn't the main module.
	var oFiles @[]@[]char
	var initPkgNames @[]@[]char
	if len(ldr.Order) > 0 {
		for i := 0; i < len(ldr.Order); i++ {
			var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
			if pkg == nil || pkg.Builtin || pkg.Merged == nil { continue }
			debug.Log(bootstrap.Concat("native: compiling dep ", ldr.Order[i]))
			var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
			registerPkgImports(ldr, pkg, mod, root)
			if pkg.BNI != nil { ir.RegisterSelfTypes(pkg.BNI) }
			ir.GeneratePackage(pkg.Merged, mod)
			if mod.HasPackageInit() {
				initPkgNames = appendRawCharSlice(initPkgNames,
					ir.PackageInitName(
						mangle.PkgShortNameFromModule(ldr.Order[i])))
			}
			var llvmIR @[]char = codegen.EmitModule(mod)
			var oFile @[]char = compileLL(llvmIR, outPrefix, shortName(ldr.Order[i]))
			oFiles = appendRawCharSlice(oFiles, oFile)
		}
	}

	var mainMod @ir.Module = ir.InitModule(file.PkgName)
	registerMainImports(ldr, file, mainMod, root)
	ir.GeneratePackage(file, mainMod)
	// Append main's own __init last so it runs after dep inits.
	if mainMod.HasPackageInit() {
		initPkgNames = appendRawCharSlice(initPkgNames,
			ir.PackageInitName(
				mangle.PkgShortNameFromModule(file.PkgName)))
	}
	// Always emit `<main>.__init_all` and `<main>.__entry` (the
	// latter mangles to `bn_entry`, the C runtime's sole entry
	// into Binate; the former is unconditionally called by
	// `__entry`).  Without these, the link fails with
	// `_bn_entry undefined`.  Mirrors the LLVM path in main()
	// — kept in sync deliberately.
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()
	debug.Log("native: IR generation complete")

	// outPrefix already includes its trailing separator (see
	// outPrefixFor): "_" for the legacy /tmp/binate_<base>_ layout,
	// "/" for --build-dir mode.
	var mainO @[]char = bootstrap.Concat(outPrefix, "main.o")
	var ok bool = native.EmitObject(mainMod, "aarch64", mainO)
	if !ok {
		println("error: native backend failed to emit object")
		bootstrap.Exit(1)
	}
	oFiles = appendRawCharSlice(oFiles, mainO)

	// Link with the C runtime so we get int main() → bn_entry().
	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
	clangArgs = appendTargetFlags(clangArgs)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, output)
	for i := 0; i < len(oFiles); i++ { clangArgs = appendRawCharSlice(clangArgs, oFiles[i]) }
	if !suppressHostRuntime && len(runtimePath) > 0 {
		clangArgs = appendRawCharSlice(clangArgs, runtimePath)
		var rtStubs @[]char = findRtStubs(runtimePath)
		if len(rtStubs) > 0 { clangArgs = appendRawCharSlice(clangArgs, rtStubs) }
		var libcStubs @[]char = findLibcStubs(runtimePath)
		if len(libcStubs) > 0 { clangArgs = appendRawCharSlice(clangArgs, libcStubs) }
	}
	clangArgs = appendTargetRuntime(clangArgs, root)

	debug.Log("native: linking")
	var exitCode int = bootstrap.Exec("clang", clangArgs)
	for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
	if exitCode != 0 {
		println("error: native link failed")
		bootstrap.Exit(1)
	}
	debug.Log("native: compilation complete")
}
