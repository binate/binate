package "main"

import "pkg/ast"
import "pkg/binate/buf"
import "pkg/binate/debug"
import "pkg/bootstrap"
import "pkg/codegen"
import "pkg/ir"
import "pkg/loader"
import "pkg/mangle"

// debugInfo mirrors --debug / -g for the rest of the driver to read.
// Set once in main() before any compilation happens.
var debugInfo bool
// extraClangFlags collects --cflag arguments passed through to the linker.
// Set once in main() from the parsed CLIArgs.
var extraClangFlags @[]@[]char
// linkAfterObjs collects --link-after-objs paths.  Emitted as
// positional inputs to clang AFTER the .o files AND AFTER
// targetRuntimeFiles, so a static archive (e.g. libgcc.a) can pull
// symbols from earlier inputs.  Populated by parseArgs from CLIArgs.
var linkAfterObjs @[]@[]char

// Binate compiler driver.
// Usage: bnc [flags] <file.bn|dir>

// main is the entry point for the compiler CLI.
func main() {
	var args @[]@[]char = bootstrap.Args()
	if len(args) == 0 {
		printUsage()
		bootstrap.Exit(1)
	}

	var cli CLIArgs = parseArgs(args)

	if cli.Verbose {
		debug.SetVerbose(true)
	}
	if cli.Debug {
		debugInfo = true
		codegen.SetDebugInfo(true)
	}
	extraClangFlags = cli.ClangFlags
	linkAfterObjs = cli.LinkAfterObjs

	// Resolve --target before any type-checking happens (SizeOf
	// during type checking depends on the target layout).
	applyTarget(cli.Target)

	// --test mode: compile and run test packages
	// (Filenames are package paths, NOT source files — don't expand dirs)
	if cli.TestMode {
		runTestMode(cli)
		return
	}

	cli.Filenames = expandDirArgs(cli.Filenames)

	// --pkg mode: compile a single package
	if len(cli.PkgFlag) > 0 {
		if len(cli.BniPaths) == 0 {
			println("error: --pkg requires -I <dir> to locate the package")
			bootstrap.Exit(1)
		}
		compileSinglePkg(cli)
		return
	}

	if len(cli.Filenames) == 0 {
		printUsage()
		bootstrap.Exit(1)
	}

	var filename @[]char = cli.Filenames[0]

	// Defaults
	var output @[]char = cli.Output
	if len(output) == 0 && !cli.EmitLLVM && !cli.CompileOnly {
		output = stripExt(filename)
	}
	var runtimePath @[]char = buf.CopyStr(cli.RuntimePath)
	if len(runtimePath) == 0 {
		runtimePath = findRuntime(filename)
	}

	// Parse and merge
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var file @ast.File = mergeFiles(files)
	debug.Log("parsing complete")

	// Load imports
	var root @[]char = buf.CopyStr(resolveRoot(primaryRoot(cli), filename))
	var ldr @loader.Loader = loader.NewLoader(root)
	var binateRoot @[]char = buf.CopyStr(discoverBinateRoot(runtimePath))
	if len(binateRoot) > 0 && !streq(binateRoot, root) {
		ldr.AddRoot(binateRoot)
	}
	applyPathFlags(ldr, cli, root)
	ldr.LoadImports(file.Imports)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}
	ensureRtLoaded(ldr)
	ensureBootstrapLoaded(ldr)
	debug.Log("imports loaded")

	// Type check, then install the populated Checker so IR-gen can
	// consult per-expression resolved types via Checker.ExprType(id).
	// See plan-ir-gen-typed-literals.md.
	var checker @types.Checker = typecheckAll(ldr, file)
	ir.SetChecker(checker)

	// Output prefix for intermediate files. With --build-dir <d>,
	// files land at "<d>/<modname>.<ext>"; otherwise the legacy
	// "/tmp/binate_<base>_<modname>.<ext>" layout (where <base> is
	// derived from -o or the input filename) is used.
	var base @[]char = shortName(buf.CopyStr(stripExt(filename)))
	if len(output) > 0 {
		base = shortName(buf.CopyStr(output))
	}
	var outPrefix @[]char = outPrefixFor(cli.BuildDir, base)
	var useNative bool = streq(cli.Backend, "native")

	// Compile dependency packages.  Track which ones emit
	// a `<pkg>.__init` (top-level var initializers) so the
	// main module's init dispatcher can list them in dep order.
	var oFiles @[]@[]char
	var initPkgNames @[]@[]char
	if len(ldr.Order) > 0 {
		for i := 0; i < len(ldr.Order); i++ {
			var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
			if pkg == nil || pkg.Builtin || pkg.Merged == nil { continue }
			debug.Log(buf.Concat("compiling ", ldr.Order[i]))
			var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
			registerPkgImports(ldr, pkg, mod, root)
			if pkg.BNI != nil { ir.RegisterSelfTypes(pkg.BNI) }
			ir.GeneratePackage(pkg.Merged, mod)
			if mod.HasPackageInit() {
				initPkgNames = appendRawCharSlice(initPkgNames,
					ir.PackageInitName(
						mangle.PkgPathFromQuoted(ldr.Order[i])))
			}
			var llvmIR @[]char = codegen.EmitModule(mod)
			// Use the full-path-derived filename so two packages
			// sharing a last-segment short name don't clobber each
			// other's .o in --build-dir.
			var oFile @[]char = compileLL(llvmIR, outPrefix, pathFileBase(ldr.Order[i]))
			oFiles = appendRawCharSlice(oFiles, oFile)
		}
	}

	// Compile main package
	debug.Log("compiling main")
	var mainMod @ir.Module = ir.InitModule(file.PkgName)
	registerMainImports(ldr, file, mainMod, root)
	ir.GeneratePackage(file, mainMod)
	// Append main's own __init last so it runs after dep inits.
	if mainMod.HasPackageInit() {
		initPkgNames = appendRawCharSlice(initPkgNames,
			ir.PackageInitName(
				mangle.PkgPathFromQuoted(file.PkgName)))
	}
	// Always emit `<main>.__init_all` and `<main>.__entry` (the
	// latter mangles to `bn_entry`, the C runtime's sole entry
	// into Binate; the former is unconditionally called by
	// `__entry`).  Both must exist for every binary so the
	// runtime's `bn_entry` extern always resolves at link time.
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()
	debug.Log("IR generation complete")

	if cli.EmitLLVM {
		print(codegen.EmitModule(mainMod))
		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		return
	}

	// Compile the main module with the selected backend (deps above
	// always go through LLVM; only the main module honors --backend
	// native).  The backend prints its own diagnostic and returns
	// empty on failure.
	var mainO @[]char = compileModuleVia(mainMod, outPrefix, "main", useNative)
	if len(mainO) == 0 {
		bootstrap.Exit(1)
	}
	oFiles = appendRawCharSlice(oFiles, mainO)

	if cli.CompileOnly {
		for i := 0; i < len(oFiles); i++ { println(oFiles[i]) }
		return
	}

	// Link
	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
	clangArgs = appendTargetFlags(clangArgs)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, output)
	for i := 0; i < len(oFiles); i++ { clangArgs = appendRawCharSlice(clangArgs, oFiles[i]) }
	if !suppressHostRuntime && len(runtimePath) > 0 {
		clangArgs = appendRawCharSlice(clangArgs, runtimePath)
		var rtStubs @[]char = findRtStubs(runtimePath)
		if len(rtStubs) > 0 { clangArgs = appendRawCharSlice(clangArgs, rtStubs) }
		var libcStubs @[]char = findLibcStubs(runtimePath)
		if len(libcStubs) > 0 { clangArgs = appendRawCharSlice(clangArgs, libcStubs) }
	}
	clangArgs = appendTargetRuntime(clangArgs, root)
	for i := 0; i < len(linkAfterObjs); i++ {
		clangArgs = appendRawCharSlice(clangArgs, linkAfterObjs[i])
	}

	debug.Log("linking")
	var exitCode int = bootstrap.Exec("clang", clangArgs)
	for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
	if exitCode != 0 {
		println("error: link failed")
		bootstrap.Exit(1)
	}
	debug.Log("compilation complete")
}
