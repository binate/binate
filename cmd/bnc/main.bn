package "main"

import "pkg/binate/asm/assemble"
import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/codegen"
import "pkg/binate/debug"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/mangle"
import "pkg/binate/types"
import "pkg/binate/version"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/os/process"

// debugInfo mirrors --debug / -g for the rest of the driver to read.
// Set once in main() before any compilation happens.
var debugInfo bool

// extraClangFlags collects --cflag arguments passed through to the linker.
// Set once in main() from the parsed CLIArgs.
var extraClangFlags @[]@[]char

// linkAfterObjs collects --link-after-objs paths.  Emitted as
// positional inputs to clang AFTER the .o files AND AFTER
// targetRuntimeFiles, so a static archive (e.g. libgcc.a) can pull
// symbols from earlier inputs.  Populated by parseArgs from CLIArgs.
var linkAfterObjs @[]@[]char

// optLevel is the IR optimization level (-O0..-O3; 0 = none).  Set once in
// main() from the parsed CLIArgs and read by the module-lowering chokepoints
// (compileModuleVia and the --emit-llvm dump paths), which hand it to
// ir.RunOptPasses.  A package global for the same reason as extraClangFlags:
// the compile drivers thread it to deep call sites without a parameter chain.
var optLevel int

// Binate compiler driver.
// Usage: bnc [flags] <file.bn|dir>

// assembleDotSFile assembles a `.s` runtime file into a `.o` and returns the
// `.o` path, using the Binate assembler embedded in-process
// (pkg/binate/asm/assemble) — no subprocess.  bnc's bare-metal runtime files
// (arm32-baremetal crt0.s / semihost.s) are hand-written Binate assembly, so
// bnas — not clang — is their assembler; clang/lld then only links the resulting
// `.o`.  The `.o` lands in buildDir (or /tmp when unset).  arch is the assemble
// package's arch name (e.g. "arm32").  Exits the process on failure.
func assembleDotSFile(srcPath *[]readonly char, buildDir *[]readonly char,
		arch *[]readonly char) @[]char {
	// Derive the output stem (base name, no dir, no extension).
	var start int = 0
	for i := 0; i < len(srcPath); i++ {
		if srcPath[i] == '/' { start = i + 1 }
	}
	var dot int = len(srcPath)
	for i := start; i < len(srcPath); i++ {
		if srcPath[i] == '.' { dot = i }
	}
	// Namespace the object name with a `bnrt_` prefix so it cannot collide with
	// a package object in the same --build-dir: package objects are named via
	// pathFileBase, which escapes '_' -> "_U", so no package can ever produce
	// "bnrt_<stem>" (a package literally named `crt0` would otherwise map to
	// crt0.o and be silently overwritten by the runtime crt0.s object).
	var base @[]char = buf.Concat("bnrt_", buf.CopyStr(srcPath[start:dot]))
	var oPath @[]char
	if len(buildDir) > 0 {
		oPath = buf.Concat(buf.Concat(buildDir, "/"), buf.Concat(base, ".o"))
	} else {
		oPath = buf.Concat("/tmp/", buf.Concat(base, ".o"))
	}

	ok, errMsg := assemble.AssembleFile(srcPath, oPath, arch, "")
	if !ok {
		fmt.Print("error: assembling ", srcPath, ": ", errMsg, "\n")
		os.Exit(1)
	}
	return oPath
}

// assembleDotSArgs returns a copy of a clang link argv with every `.s` input
// replaced by a `.o` assembled in-process (via assembleDotSFile), plus the list
// of generated `.o` paths so the caller can delete them after the link.  A token
// that starts with '-' (a flag) or doesn't end in `.s` passes through unchanged;
// the value immediately after `-o` (the output path) is skipped even if it ends
// in `.s`, so `bnc -o foo.s` doesn't feed the output to the assembler.  Only
// positional `.s` inputs — bnc's bare-metal runtime files — are rewritten.
func assembleDotSArgs(args @[]@[]char, buildDir *[]readonly char,
		arch *[]readonly char) (@[]@[]char, @[]@[]char) {
	var out @[]@[]char
	var generated @[]@[]char
	var skipNext bool = false
	for i := 0; i < len(args); i++ {
		var arg @[]char = args[i]
		if skipNext {
			out = appendRawCharSlice(out, arg)
			skipNext = false
			continue
		}
		if streq(arg, "-o") {
			out = appendRawCharSlice(out, arg)
			skipNext = true // the next token is the output path, not an input
			continue
		}
		if len(arg) > 0 && arg[0] != '-' && hasSuffix(arg, ".s") {
			var o @[]char = assembleDotSFile(arg, buildDir, arch)
			out = appendRawCharSlice(out, o)
			generated = appendRawCharSlice(generated, o)
		} else {
			out = appendRawCharSlice(out, arg)
		}
	}
	return out, generated
}

// progArgs returns bnc's own argument tokens: os.Args() minus the program-name
// slot at index 0, copied into a mutable @[]@[]char for parsing.  Reading argv
// through os.Args means that when bnc is run under
// the bytecode interpreter it sees the argv the interpreter installed via
// os.SetArgs, not the interpreter's own.
func progArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 {
		return make_slice(@[]char, 0)
	}
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		// full[i] is a readonly-qualified element; copy it char-by-char into an
		// owned @[]char (its readonly type can't be borrowed as the
		// *[]readonly char buf.CopyStr expects).
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = full[i][j]
		}
		out[i - 1] = s
	}
	return out
}

// main is the entry point for the compiler CLI.
func main() {
	var args @[]@[]char = progArgs()
	if len(args) == 0 {
		printUsage()
		os.Exit(1)
	}

	var cli CLIArgs = parseArgs(args)
	if cli.ShowVersion {
		fmt.Print("bnc-", version.Version, "\n")
		return
	}
	if len(cli.Error) > 0 {
		fmt.Println(cli.Error)
		printUsage()
		os.Exit(1)
	}

	// Fall back to the environment for either search path the CLI left unset.
	// -I / -L win per path (a path given on the CLI ignores its env var); an
	// unset path falls back to BINATE_PACKAGE_INTERFACE_PATH / _IMPL_PATH (long
	// form) or the BINATE_BNI_PATH / BINATE_IMPL_PATH aliases.  Done here, before
	// the --pkg / --library guards and every loader build, so all modes see it.
	if len(cli.BniPaths) == 0 {
		cli.BniPaths = envPaths("BINATE_PACKAGE_INTERFACE_PATH", "BINATE_BNI_PATH")
	}
	if len(cli.ImplPaths) == 0 {
		cli.ImplPaths = envPaths("BINATE_PACKAGE_IMPL_PATH", "BINATE_IMPL_PATH")
	}

	if cli.Verbose {
		debug.SetVerbose(true)
	}
	if cli.VerifyIR {
		ir.SetVerifyIR(true)
	}
	if cli.Debug {
		debugInfo = true
		codegen.SetDebugInfo(true)
	}
	extraClangFlags = cli.ClangFlags
	linkAfterObjs = cli.LinkAfterObjs
	optLevel = cli.OptLevel

	// Resolve --target before any type-checking happens (SizeOf
	// during type checking depends on the target layout).
	applyTarget(cli.Target)

	// Validate --linker (empty/"clang" = the default clang driver; "bnld" = the
	// self-hosted linker).  Reject unknown values up front.
	if len(cli.Linker) > 0 && !streq(cli.Linker, "clang") && !streq(cli.Linker, "bnld") {
		fmt.Print("error: unknown --linker '", cli.Linker, "' (expected clang or bnld)\n")
		os.Exit(1)
	}

	// --test mode: compile and run test packages
	// (Filenames are package paths, NOT source files — don't expand dirs)
	if cli.TestMode {
		runTestMode(cli)
		return
	}

	cli.Filenames = expandDirArgs(cli.Filenames)

	// --pkg mode: compile a single package
	if len(cli.PkgFlag) > 0 {
		if len(cli.BniPaths) == 0 {
			fmt.Println("error: --pkg requires -I <dir> to locate the package")
			os.Exit(1)
		}
		compileSinglePkg(cli)
		return
	}

	// --library mode: compile a facade package + its transitive closure into a
	// static archive (.a) callable from C via the well-known `bn_init` symbol.
	if len(cli.LibraryFlag) > 0 {
		if len(cli.BniPaths) == 0 {
			fmt.Println("error: --library requires -I <dir> to locate the package")
			os.Exit(1)
		}
		compileLibrary(cli)
		return
	}

	if len(cli.Filenames) == 0 {
		printUsage()
		os.Exit(1)
	}

	var filename @[]char = cli.Filenames[0]

	// Defaults
	var output @[]char = cli.Output
	if len(output) == 0 && !cli.EmitLLVM && !cli.CompileOnly {
		output = buf.CopyStr(stripExt(filename))
	}
	// Parse and merge
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var file @ast.File = mergeFiles(files)
	debug.Log("parsing complete")

	// Load imports
	var ldr @loader.Loader = loader.NewLoader()
	applyPathFlags(ldr, cli)
	// Set arch/os for #[build(...)] gating from the active target — the
	// --target key, or this bnc's own compiled-in host (activeBuildConfig) —
	// before loading dependencies, so their per-target files/decls are gated.
	ldr.BuildConfig = activeBuildConfig(cli.Target)
	// COMDAT groups on weak_odr defs are an ELF/COFF construct; Mach-O
	// (OS "darwin") rejects them, so enable only for non-Mach-O targets.
	codegen.SetEmitComdat(ldr.BuildConfig != nil && !streq(ldr.BuildConfig.OS, "darwin"))
	ldr.LoadImports(file.Imports)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			fmt.Println(ldr.Errors[i])
		}
		os.Exit(1)
	}
	ensureRuntimeDepsLoaded(ldr)
	debug.Log("imports loaded")

	// --list-deps: print every package this program needs (the full transitive
	// set — user imports plus the implicit runtime deps, in dependency order)
	// and exit, before type-checking or compiling.  This is the set `bnc -c`
	// emits objects for, so an external driver can compile each with `--pkg`
	// (or fetch cached objects) and link — the separate/incremental-build
	// counterpart of `--pkg`.  Emitted after the ensure*Loaded calls so the
	// implicit rt/reflect/lang packages are included.
	if cli.ListDeps {
		for i := 0; i < len(ldr.Order); i++ {
			fmt.Println(ldr.Order[i])
		}
		return
	}

	// Type check, then install the populated Checker so IR-gen can
	// consult per-expression resolved types via Checker.ExprType(id).
	var checker @types.Checker = typecheckAll(ldr, file)

	// A linking build's per-module objects are throwaway intermediates: isolate
	// them in a fresh unique directory (unless --build-dir was given) so two
	// concurrent builds never write — or, worse, delete after linking — the same
	// shared /tmp objects.  -c stops after emitting deliverable objects (below),
	// which must stay findable, so it keeps the given build dir (empty => current
	// directory) and never creates a temp one.  createdBuildDir drives the
	// after-link removal of the temp dir.
	var createdBuildDir bool = false
	if !cli.CompileOnly {
		cli.BuildDir, createdBuildDir = effectiveBuildDir(cli)
	}
	var outPrefix @[]char = outPrefixFor(cli.BuildDir)
	var useNative bool = streq(cli.Backend, "native")

	// Compile dependency packages.  Track which ones emit
	// a `<pkg>.__init` (top-level var initializers) so the
	// main module's init dispatcher can list them in dep order.
	var oFiles @[]@[]char
	var initPkgNames @[]@[]char
	if len(ldr.Order) > 0 {
		for i := 0; i < len(ldr.Order); i++ {
			var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
			if pkg == nil || pkg.Merged == nil { continue }
			debug.Log(buf.Concat("compiling ", ldr.Order[i]))
			var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
			mod.Checker = checker
			var gc @ir.GenCtx = ir.NewGenCtx(mod)
			registerPkgImports(ldr, pkg, gc)
			if pkg.BNI != nil { ir.RegisterSelfTypes(checker, pkg.BNI, gc) }
			ir.GeneratePackage(checker, pkg.Merged, gc, pkg.Files)
			if mod.HasPackageInit() {
				initPkgNames = appendRawCharSlice(initPkgNames,
						ir.PackageInitName(
								mangle.PkgPathFromQuoted(ldr.Order[i])))
			}
			// Use the full-path-derived filename so two packages
			// sharing a last-segment short name don't clobber each
			// other's .o in --build-dir.  Honor --backend native for
			// dependencies too (not just the main module): a native build
			// must route EVERY package through the native backend, leaving
			// clang for linking only.
			var oFile @[]char = compileModuleVia(mod, outPrefix, pathFileBase(ldr.Order[i]), useNative)
			oFiles = appendRawCharSlice(oFiles, oFile)
		}
	}

	// Compile main package
	debug.Log("compiling main")
	var mainMod @ir.Module = ir.InitModule(file.PkgName)
	mainMod.Checker = checker
	var mainGc @ir.GenCtx = ir.NewGenCtx(mainMod)
	registerMainImports(ldr, file, mainGc)
	ir.GeneratePackage(checker, file, mainGc, make_slice(@ast.File, 0))
	// Append main's own __init last so it runs after dep inits.
	if mainMod.HasPackageInit() {
		initPkgNames = appendRawCharSlice(initPkgNames,
				ir.PackageInitName(
						mangle.PkgPathFromQuoted(file.PkgName)))
	}
	// A program's entry package must be named "main" (§17.3), and must define
	// `func main`.  Both are program-assembly checks (not per-package compile
	// checks): any package compiles independently — only the linked program
	// knows the entry package's name and whether an entry exists.
	if !mainMod.IsMainPackage() {
		fmt.Println("error: a program's entry package must be named main")
		os.Exit(1)
	}
	if !mainMod.HasMainFunc() {
		fmt.Println("error: no main function (a program must define func main in package main)")
		os.Exit(1)
	}
	// Always emit `<main>.__init_all` and `<main>.__entry` (the
	// latter mangles to `bn_entry`, the C runtime's sole entry
	// into Binate; the former is unconditionally called by
	// `__entry`).  Both must exist for every binary so the
	// runtime's `bn_entry` extern always resolves at link time.
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()
	// Satisfaction-registry wiring — native-codegen driver only (NOT the interp
	// path).  Wires `__entry` to fill the runtime registry by walking main's
	// `_pkg_satfrag` graph node, whose LEA also keeps the `__satentry` chain alive
	// under dead-strip.  After EmitMainEntry (it edits the `__entry` that call built).
	mainMod.EmitSatRegistryWiring()
	debug.Log("IR generation complete")

	if cli.EmitLLVM {
		// Bypasses compileModuleVia — run the opt passes here too (deps already
		// went through compileModuleVia above).
		ir.RunOptPasses(mainMod, optLevel)
		fmt.Print(codegen.EmitModule(mainMod))
		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		return
	}

	// Compile the main module with the selected backend.  Under --backend
	// native EVERY package (deps above + this main module) is native-lowered;
	// clang is used only for linking.  The backend prints its own diagnostic
	// and returns empty on failure.
	var mainO @[]char = compileModuleVia(mainMod, outPrefix, "main", useNative)
	if len(mainO) == 0 {
		os.Exit(1)
	}
	oFiles = appendRawCharSlice(oFiles, mainO)

	if cli.CompileOnly {
		for i := 0; i < len(oFiles); i++ { fmt.Println(oFiles[i]) }
		return
	}

	// Link with the self-hosted linker instead of clang, when asked.  linkWithBnld
	// dynamically links the objects against the platform C library — libc on ELF
	// (linux-x64 / linux-aarch64, via our own `_start`), libSystem on macOS Mach-O
	// (macos-arm64, via dyld's LC_MAIN); the intermediates are cleaned up either way.
	if streq(cli.Linker, "bnld") {
		var ok bool = linkWithBnld(cli, oFiles, output)
		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		if createdBuildDir { remove(cli.BuildDir) } // rmdir the now-empty temp dir
		if !ok { os.Exit(1) }
		debug.Log("compilation complete")
		return
	}

	// Link (clang)
	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
	clangArgs = appendTargetFlags(clangArgs)
	clangArgs = appendTargetLinkFlags(clangArgs, cli.Backend)
	clangArgs = appendLinkStripFlags(clangArgs)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, output)
	for i := 0; i < len(oFiles); i++ { clangArgs = appendRawCharSlice(clangArgs, oFiles[i]) }
	// Bare-metal targets append their runtime inputs (crt0.s, semihost.s) + the
	// linker script here, resolved relative to dirOf(--runtime).  No-op on host
	// (--runtime is not linked; only its directory anchors the baremetal files).
	clangArgs = appendTargetRuntime(clangArgs, dirOf(cli.RuntimePath))
	for i := 0; i < len(linkAfterObjs); i++ {
		clangArgs = appendRawCharSlice(clangArgs, linkAfterObjs[i])
	}
	// Any `.s` link input is Binate assembly (the bare-metal crt0.s /
	// semihost.s) — assemble each in-process and link the resulting `.o`
	// (clang stays the linker, not the assembler); non-`.s` inputs pass
	// through unchanged.  bnasObjs are the generated `.o` files, removed after
	// the link alongside the compiled objects.
	var bnasObjs @[]@[]char
	clangArgs, bnasObjs = assembleDotSArgs(clangArgs, cli.BuildDir, nativeArchForTarget())

	debug.Log("linking")
	status, err := process.Run("clang", &process.Options{SearchPath: true, Args: clangArgs})
	for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
	for i := 0; i < len(bnasObjs); i++ { remove(bnasObjs[i]) }
	if createdBuildDir { remove(cli.BuildDir) } // rmdir the now-empty temp dir
	if present(err) || !status.Success() {
		fmt.Println("error: link failed")
		os.Exit(1)
	}
	debug.Log("compilation complete")
}
