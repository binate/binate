package "main"

import "pkg/builtin/testing"

// main.bn is tested primarily through conformance tests.
// This file tests that the debugInfo global is initialized correctly.
// Target-handling tests (applyTarget, nativeArchForTarget,
// appendTargetFlags, appendTargetRuntime) live in target_test.bn
// alongside the production code in target.bn.

func TestDebugInfoDefaultFalse() testing.TestResult {
	if debugInfo { return fail("debugInfo should default to false") }
	return ""
}
