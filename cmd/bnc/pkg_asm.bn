package "main"

import "pkg/binate/asm/assemble"
import "pkg/binate/buf"
import "pkg/binate/loader"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/strings"

// assemblePkgAsmObjs assembles a package's build-included `.s` files
// (pkg.AsmFiles — the loader-provided bytes that survived their file-level
// `#[build]` gate for this target) into `.o` files and returns their paths.
// Called from every per-package compile path and appended to that package's
// objects, so the `.s`-defined symbols ship wherever the package is compiled —
// INCLUDING a plain `bnc -c` / `bnc --pkg` object set — with no per-symbol
// knowledge in the link paths.  arch/objFmt are the native target's
// (nativeArchForTarget / nativeObjFormatForTarget); objFmt ("macho"/"elf") maps
// to the assembler's OS selector so the object format matches the link.  `prefix`
// is the SAME object-path prefix compiled objects use (outPrefixFor — the
// build-dir with a trailing "/", or "" for the current directory), so an asm
// object lands beside its package's compiled `.o` in every mode.  Each object is
// named bnpkgasm_<flattened-pkg-path>_<src-base> from short basenames (not full
// absolute paths, which would overflow the filesystem's per-name limit); the
// flattened package path plus the source basename make it unique within a build
// and give it the same shared-build-dir collision profile as the compiled
// objects.  Exits the process on an assembly failure — a package `.s` that will
// not assemble is a hard error, not a skip.
func assemblePkgAsmObjs(pkg @loader.Package, arch *[]readonly char, objFmt *[]readonly char,
		prefix *[]readonly char) @[]@[]char {
	var objs @[]@[]char
	if pkg == nil || len(pkg.AsmFiles) == 0 {
		return objs
	}
	var pkgFlat @[]char = pathFileBase(pkg.Path)
	var osName *[]readonly char = "linux"
	if streq(objFmt, "macho") {
		osName = "darwin"
	}
	for i := 0; i < len(pkg.AsmFiles); i++ {
		var af @loader.AsmFile = pkg.AsmFiles[i]
		var srcBase @[]char = dropDotS(lastPathSegment(af.Path))
		var b @strings.Builder = strings.NewBuilder()
		b.Write(prefix)
		b.Write("bnpkgasm_")
		b.Write(pkgFlat)
		b.Write("_")
		b.Write(srcBase)
		var stem @[]char = buf.CopyStr(b.String())
		var sPath @[]char = buf.Concat(stem, ".s")
		var oPath @[]char = buf.Concat(stem, ".o")
		writeAsmSource(sPath, af.Src)
		ok, errMsg := assemble.AssembleFile(sPath, oPath, arch, osName)
		remove(sPath) // consumed by assembly
		if !ok {
			fmt.Print("error: assembling package assembly ", af.Path, ": ", errMsg, "\n")
			os.Exit(1)
		}
		objs = appendRawCharSlice(objs, oPath)
	}
	return objs
}

// lastPathSegment returns the final `/`-separated segment of p (p itself when it
// contains no `/`), so object names are built from short basenames rather than
// full absolute paths that would overflow the filesystem's per-name length limit.
func lastPathSegment(p *[]readonly char) @[]char {
	var start int = 0
	for i := 0; i < len(p); i++ {
		if p[i] == '/' {
			start = i + 1
		}
	}
	return buf.CopyStr(p[start:len(p)])
}

// dropDotS returns name without a trailing ".s" (a package .s file always has
// one — the loader only collects `.s` entries), so the generated object stem
// carries no confusing double extension.
func dropDotS(name *[]readonly char) @[]char {
	var n int = len(name)
	if n >= 2 && name[n - 2] == '.' && name[n - 1] == 's' {
		return buf.CopyStr(name[0:n - 2])
	}
	return buf.CopyStr(name)
}

// writeAsmSource writes the `.s` source bytes to path (create/truncate),
// exiting on an open failure like writeFile.  Takes the bytes directly (the
// loader-provided AsmFile.Src) rather than a char slice.
func writeAsmSource(path *[]readonly char, data @[]uint8) {
	f, oerr := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(oerr) {
		fmt.Print("error: cannot write ", path, "\n")
		os.Exit(1)
	}
	_, _ = f.Write(data)
	_ = f.Close()
}
