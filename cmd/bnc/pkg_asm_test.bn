package "main"

import "pkg/builtins/testing"

// lastPathSegment returns the final `/`-separated segment (short object names are
// built from basenames, not overflowing absolute paths).
func TestLastPathSegment() testing.TestResult {
	if !streq(lastPathSegment("/a/b/memzero_aarch64.s"), "memzero_aarch64.s") {
		return fail("absolute path should reduce to its basename")
	}
	if !streq(lastPathSegment("memzero.s"), "memzero.s") {
		return fail("a bare name has no segment to drop")
	}
	if !streq(lastPathSegment("/x"), "x") {
		return fail("leading-slash single segment")
	}
	if len(lastPathSegment("a/")) != 0 {
		return fail("a trailing slash yields an empty segment")
	}
	return ""
}

// dropDotS strips exactly a trailing ".s" (a package .s file always has one).
func TestDropDotS() testing.TestResult {
	if !streq(dropDotS("memzero_aarch64.s"), "memzero_aarch64") {
		return fail("a .s basename should lose its extension")
	}
	if !streq(dropDotS(".s"), "") {
		return fail("a bare .s reduces to empty")
	}
	if !streq(dropDotS("noext"), "noext") {
		return fail("a name without .s is unchanged")
	}
	if !streq(dropDotS("s"), "s") {
		return fail("a single 's' is not a .s extension")
	}
	return ""
}
