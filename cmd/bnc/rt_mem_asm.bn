package "main"

import "pkg/binate/asm/assemble"
import "pkg/binate/buf"
import "pkg/std/fmt"
import "pkg/std/os"

// Hand-written runtime memory-primitive assembly, linked by bnc to override the
// portable Binate rt.MemZero (which is #[build]-gated off on these arches — see
// impls/core/common/pkg/builtins/rt/rt_memzero.bn) with a wide-store fill that
// matches what LLVM lowers a zero-fill loop to.  The native backend emits a
// scalar word loop for the Binate MemZero; a hand-written STP / DC ZVA fill
// moves 16–64 bytes per store, which the scalar loop cannot reach.  Assembled
// in-process by the embedded assembler (pkg/binate/asm/assemble) and added to
// the link inputs on every aarch64 link (both the clang and bnld paths), so the
// rt.MemZero symbol resolves to this definition for both backends.

// rtMemAsmForArch returns the runtime memory-primitive .s text for the given
// native arch, or "" if the arch has no hand-written override (its portable
// Binate rt.MemZero is compiled and linked as usual).  aarch64 only for now.
// objFmt ("macho"/"elf") selects the symbol prefix: Mach-O prefixes global
// symbols with `_` (matching what the compiler emits for the same function),
// ELF does not.
func rtMemAsmForArch(arch *[]readonly char, objFmt *[]readonly char) @[]char {
	var sp *[]readonly char = ""
	if streq(objFmt, "macho") { sp = "_" }
	if streq(arch, "aarch64") { return rtMemAsmAarch64(sp) }
	var none @[]char
	return none
}

// rtMemAsmAarch64 is the AArch64 rt.MemZero: zero `size` (x1) bytes at `ptr`
// (x0), returning void (AAPCS64).  A 64-byte unrolled STP-of-XZR bulk (four
// 16-byte pair stores per iteration), then a 16-byte STP loop, then a byte
// tail.  A leaf using only x0/x1 — no stack frame, no callee-saved registers.
// size <= 0 is a no-op (the portable body aborts on size < 0; that path is
// never hit — Alloc only ever passes a non-negative payload size).  `symPrefix`
// is "" (ELF) or "_" (Mach-O) — the platform symbol-name prefix.  Local labels
// are `L`-prefixed so their branches resolve in-section (the Mach-O atom rule
// treats a non-`L` defined symbol as an atom boundary).
func rtMemAsmAarch64(symPrefix *[]readonly char) @[]char {
	var sym @[]char = buf.Concat(symPrefix, "bn_F3_3_pkg8_builtins2_rt1_7_MemZero")
	// Header carries the symbol name twice (`.global <sym>` + the label); the
	// instruction body is a fixed literal (adjacent string-literal concat).
	var head @[]char = buf.Concat(
			buf.Concat(buf.Concat(
					".arch aarch64\n"
							".section text\n"
							".global ",
					sym), "\n"), buf.Concat(sym, ":\n"))
	var body *[]readonly char = " cmp x1, #0\n"
			" b.le Lmz_done\n"
			"Lmz_64:\n"
			" cmp x1, #64\n"
			" b.lt Lmz_16\n"
			" stp xzr, xzr, [x0], #16\n"
			" stp xzr, xzr, [x0], #16\n"
			" stp xzr, xzr, [x0], #16\n"
			" stp xzr, xzr, [x0], #16\n"
			" sub x1, x1, #64\n"
			" b Lmz_64\n"
			"Lmz_16:\n"
			" cmp x1, #16\n"
			" b.lt Lmz_tail\n"
			" stp xzr, xzr, [x0], #16\n"
			" sub x1, x1, #16\n"
			" b Lmz_16\n"
			"Lmz_tail:\n"
			" cbz x1, Lmz_done\n"
			"Lmz_byte:\n"
			" strb wzr, [x0], #1\n"
			" sub x1, x1, #1\n"
			" cbnz x1, Lmz_byte\n"
			"Lmz_done:\n"
			" ret\n"
	return buf.Concat(head, body)
}

// assembleRtMemObj assembles the arch's runtime memory-primitive .s (if any)
// into a .o under buildDir (or /tmp) and returns its path, or "" when the arch
// has no override.  objFmt is nativeObjFormatForTarget() ("macho"/"elf"),
// mapped to the assembler's os selector so the .o matches the link's object
// format.  The object name is namespaced by the output basename (like the bnld
// _start object) so a shared --build-dir can't collide across concurrent links.
// Exits the process on an assembly failure.
func assembleRtMemObj(arch *[]readonly char, objFmt *[]readonly char, buildDir *[]readonly char,
		output *[]readonly char) @[]char {
	var src @[]char = rtMemAsmForArch(arch, objFmt)
	if len(src) == 0 { return "" }
	var dir *[]readonly char = "/tmp"
	if len(buildDir) > 0 { dir = buildDir }
	var obase *[]readonly char = output
	for i := 0; i < len(output); i++ {
		if output[i] == '/' { obase = output[i + 1:] }
	}
	var stem @[]char = buf.Concat(buf.Concat(buf.Concat(dir, "/"), "bnrt_mem_"), obase)
	var sPath @[]char = buf.Concat(stem, ".s")
	var oPath @[]char = buf.Concat(stem, ".o")
	writeFile(sPath, src)
	var osName *[]readonly char = "linux"
	if streq(objFmt, "macho") { osName = "darwin" }
	ok, errMsg := assemble.AssembleFile(sPath, oPath, arch, osName)
	remove(sPath) // consumed by assembly
	if !ok {
		fmt.Print("error: assembling rt memory runtime: ", errMsg, "\n")
		os.Exit(1)
	}
	return oPath
}
