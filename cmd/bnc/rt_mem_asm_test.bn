package "main"

import "pkg/builtins/testing"

// containsSub reports whether hay contains needle as a substring.
func containsSub(hay *[]readonly char, needle *[]readonly char) bool {
	var n int = len(needle)
	if n == 0 {
		return true
	}
	for i := 0; i + n <= len(hay); i++ {
		var ok bool = true
		for j := 0; j < n; j++ {
			if hay[i + j] != needle[j] {
				ok = false
				break
			}
		}
		if ok {
			return true
		}
	}
	return false
}

// The aarch64 override carries the mangled rt.MemZero symbol, `.arch aarch64`,
// and a wide STP-of-XZR store; on Mach-O the symbol is `_`-prefixed.
func TestRtMemAsmAarch64Macho() testing.TestResult {
	var s @[]char = rtMemAsmForArch("aarch64", "macho")
	if len(s) == 0 {
		return fail("aarch64/macho should produce runtime asm")
	}
	if !containsSub(s, ".arch aarch64") {
		return fail("missing .arch aarch64")
	}
	if !containsSub(s, ".global _bn_F3_3_pkg8_builtins2_rt1_7_MemZero") {
		return fail("missing Mach-O-prefixed MemZero symbol")
	}
	if !containsSub(s, "stp xzr, xzr, [x0], #16") {
		return fail("missing STP wide store")
	}
	return ""
}

// On ELF the same symbol appears without the Mach-O leading underscore.
func TestRtMemAsmAarch64Elf() testing.TestResult {
	var s @[]char = rtMemAsmForArch("aarch64", "elf")
	if len(s) == 0 {
		return fail("aarch64/elf should produce runtime asm")
	}
	if !containsSub(s, ".global bn_F3_3_pkg8_builtins2_rt1_7_MemZero") {
		return fail("missing ELF MemZero symbol")
	}
	if containsSub(s, ".global _bn_F3_3_pkg8_builtins2_rt1_7_MemZero") {
		return fail("ELF symbol must not carry the Mach-O underscore")
	}
	return ""
}

// Arches with no hand-asm override return empty, so the portable Binate
// rt.MemZero is compiled and linked instead.
func TestRtMemAsmNoOverride() testing.TestResult {
	if len(rtMemAsmForArch("x86_64", "elf")) != 0 {
		return fail("x86_64 should have no MemZero override")
	}
	if len(rtMemAsmForArch("arm32", "elf")) != 0 {
		return fail("arm32 should have no MemZero override")
	}
	return ""
}
