package "main"

import "pkg/ast"
import "pkg/buf"

// Per-type append helpers — O(n) copy pattern using make_slice.

// appendCharSlice appends a managed char slice to a managed slice of managed char slices.
func appendCharSlice(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendRawCharSlice copies a raw char slice and appends it to a managed slice.
func appendRawCharSlice(s @[]@[]char, v *[]const char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = buf.CopyStr(v)
	return ns
}

// appendFilePtr appends an AST file pointer to a managed slice.
func appendFilePtr(s @[]@ast.File, v @ast.File) @[]@ast.File {
	var n int = len(s)
	var ns @[]@ast.File = make_slice(@ast.File, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImportSpecPtr appends an import spec pointer to a managed slice.
func appendImportSpecPtr(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}
