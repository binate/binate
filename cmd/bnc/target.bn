package "main"

import "pkg/binate/buf"
import "pkg/binate/buildcfg"
import "pkg/binate/types"
import "pkg/builtins/build"
import "pkg/std/os"
import "pkg/stdx/fmt"

// ============================================================
// Target handling
// ============================================================
//
// applyTarget translates the --target CLI key into a
// types.TargetInfo + a clang triple + per-target clang flags, runtime
// files, impl-path suffixes, and (for bare-metal) a linker script.
// The driver code in main.bn / test.bn reads the populated vars
// during compile/link and via nativeArchForTarget when picking which
// pkg/binate/native sub-backend to dispatch to.
//
// Split out of main.bn to keep that file under the file-length soft
// cap and to co-locate every target-related piece (vars, applyTarget,
// helpers, native-backend mapping).

// targetTriple is the clang target triple to pass via `-target ...`
// to clang invocations (compile-IR-to-.o + link).  Empty for the
// default host build; set by applyTarget() when --target selects a
// non-host target.  Read by compileLL and the link steps in main()
// and runTestMode.
var targetTriple @[]char

// targetClangFlags is additional fixed clang flags for the current
// --target (after `-target <triple>`).  E.g. bare-metal targets
// need `-mfloat-abi=soft` + `-ffreestanding`; libc-host targets
// don't.  Populated by applyTarget alongside targetTriple.  Empty
// for the default host build.
var targetClangFlags @[]@[]char

// targetRuntimeFiles is the list of runtime input files that bnc passes to
// clang at link time for this target — e.g. arm32-baremetal's crt0.s +
// semihost.s.  Each is a bare filename resolved relative to dirOf(--runtime)
// (appendTargetRuntime); the bare-metal runner points --runtime at
// runtime/baremetal_arm32/crt0.s, so all of them resolve in that dir.  Empty
// for the host build, which links no C runtime — the runtime lives entirely
// in Binate (pkg/builtins/rt, startup).
var targetRuntimeFiles @[]@[]char

// targetLinkerScript is the linker script that bnc passes to clang via
// `-Wl,-T,<script>`, resolved relative to dirOf(--runtime) like
// targetRuntimeFiles.  Used by bare-metal targets to lay out memory under the
// host RAM map (e.g. QEMU virt's 0x40000000 base).  Empty for the host build.
var targetLinkerScript @[]char

// applyTarget translates the --target CLI key into a types.TargetInfo
// and applies it via types.SetTarget. Empty / "host" leaves the
// current LP64 defaults in place; any unknown key is a hard error
// before compilation begins. Recognised keys:
//   ""                — same as "host"
//   "host"            — default 64-bit LP64 layout
//   "x86_64-linux"    — SysV-AMD64 / LP64 / Linux ELF.  Native path
//                       (--backend native) routes to pkg/binate/native/x64.
//   "x86_64-darwin"   — SysV-AMD64 / LP64 / macOS Mach-O.  Same layout
//                       as x86_64-linux but Mach-O output; on Apple
//                       Silicon the result runs under Rosetta, making
//                       the amd64 native backend locally verifiable.
//   "aarch64-linux"   — AAPCS64 / LP64 / Linux ELF.  The arm64 native
//                       backend's ELF sibling of the default macOS
//                       Mach-O path.
//   "arm32-linux"     — 32-bit ILP32 ARM Linux (hard-float ABI), with
//                       libc-host runtime cross-compiled.  v0
//                       derisking path for the bare-metal target.
//   "arm32-baremetal" — 32-bit ILP32 ARM bare-metal (soft-float),
//                       freestanding (no libc, no hosted env).  v1
//                       target.
func applyTarget(key *[]readonly char) {
	if len(key) == 0 || streq(key, "host") {
		// LP64 sizes are already the default; stamp the compiled-in host arch
		// so ABI classification (types.HfaInSimd) has a discriminator even for
		// a host build that never calls SetTarget.
		types.SetArch(hostArch())
		return
	}
	if streq(key, "x86_64-linux") {
		// LP64 layout is already the default — no SetTarget needed.
		// Triple matches stock x86_64-linux-gnu clang configuration;
		// no extra clang flags required for the LLVM path (codegen
		// emits standard SysV-AMD64).  The native backend
		// (--backend native) routes to pkg/binate/native/x64 via
		// pkg/binate/native.EmitObject's "x86_64" branch (ELF output).
		targetTriple = "x86_64-linux-gnu"
		types.SetArch(types.ARCH_X64)
		return
	}
	if streq(key, "x86_64-darwin") {
		// macOS x86-64: same LP64 / SysV-AMD64 layout as Linux, but
		// Mach-O output (nativeObjFormatForTarget → "macho").  On an
		// Apple-Silicon host the resulting binary runs under Rosetta.
		// This is what makes the amd64 native backend locally
		// verifiable.
		targetTriple = "x86_64-apple-darwin"
		types.SetArch(types.ARCH_X64)
		return
	}
	if streq(key, "aarch64-linux") {
		// AArch64 Linux: LP64 layout (the default), AAPCS64, ELF
		// output (nativeObjFormatForTarget → "elf").  The arm64
		// native backend's ELF sibling of the default macOS Mach-O
		// path.
		targetTriple = "aarch64-linux-gnu"
		types.SetArch(types.ARCH_AA64)
		return
	}
	if streq(key, "arm32-linux") {
		setArm32Layout()
		// arm-linux-gnueabihf is HARD-float (AAPCS-VFP): stamp it AFTER
		// setArm32Layout (whose SetTarget resets FloatABI to the soft default),
		// so the native backend + codegen's callConvForTarget pick up the VFP
		// convention via types.Arm32HardFloat().  Baremetal stays soft (its branch
		// never stamps this).
		types.SetFloatABI(types.FLOAT_ABI_HARD)
		// Use `arm-linux-gnueabihf` (not armv7-linux-gnueabihf) so
		// clang's GCC-toolchain discovery matches the
		// `gcc-arm-linux-gnueabihf` package's `/usr/arm-linux-gnueabihf/`
		// install root — that's where the cross-binutils (including
		// `arm-linux-gnueabihf-ld`) live, and clang only finds them
		// when the triple matches the install path.  `-march=armv7-a`
		// pins the CPU.  Mirrors the arm32-baremetal config below.
		targetTriple = "arm-linux-gnueabihf"
		targetClangFlags = @[]@[]char{"-march=armv7-a"}
		return
	}
	if streq(key, "arm32-baremetal") {
		setArm32Layout()
		// Use `arm-none-eabi` (not armv7a-none-eabi) so clang's
		// GCC-toolchain discovery matches gcc-arm-none-eabi's
		// `arm-none-eabi` target directory.  `-march=armv7-a`
		// pins the CPU.
		targetTriple = "arm-none-eabi"
		// `-nostartfiles -nodefaultlibs` instead of `-nostdlib`:
		// strips libc + crt startup files, but lets us explicitly
		// add libgcc (`-lgcc`) so AEABI helpers (__aeabi_ldivmod
		// for int64 / int64, etc.) are linkable on demand.  Point
		// clang at the gcc-arm-none-eabi install root via
		// `--gcc-toolchain` so its driver adds the right -L paths
		// to the link — lld doesn't search the GCC toolchain dirs
		// on its own.  `--sysroot=/usr/lib/gcc/arm-none-eabi`
		// would also work but `--gcc-toolchain` is the more
		// targeted flag.
		// `-mno-unaligned-access`: this bare-metal environment runs with strict
		// alignment checking, so an unaligned word access faults (no handler → hang).
		// The multi-return field-offset bridge legitimately does `align 1` loads/stores
		// of a coerced `[N x iW]` field at a non-word-aligned FieldOffset (a sub-word
		// aggregate field, e.g. the trailing `Tri` of `(int8, Tri)`); without this flag
		// LLVM's armv7 backend emits a single unaligned `ldr`/`str` for them.  The flag
		// makes those byte-wise (`ldrb`/`strb`), matching the native backend's byte-wise
		// collect (storeAggFieldBytewiseArm32).  arm32-linux does NOT need it — the
		// kernel traps-and-emulates unaligned accesses.
		targetClangFlags = @[]@[]char{
				"-march=armv7-a", "-mfloat-abi=soft", "-ffreestanding", "-nostartfiles", "-nodefaultlibs",
				"-mno-unaligned-access"}
		// On macOS dev boxes the bare-metal ELF link won't work
		// out of the box — Apple's `ld` rejects ELF flags like
		// -T / --target2=rel.  Install `llvm` via Homebrew and
		// pass `--cflag -fuse-ld=lld` to bnc, or run the bare-
		// metal pipeline on a Linux host where clang's default
		// linker handles ELF cross-targets.  CI's ubuntu-latest
		// runner picks up the cross-linker automatically.
		// The baremetal-specific impl / interface search dirs
		// (impls/core/baremetal, runtime/baremetal_arm32) are
		// supplied as -I / -L entries by binate-paths --target, so
		// they aren't synthesized here.
		//
		// crt0.s (startup / _start), semihost.s (the SYS_WRITEC /
		// SYS_EXIT_EXTENDED handlers + the memcpy / abort C-free stubs) and
		// aeabi_int.s (the C-free 64-bit AEABI integer helpers — __aeabi_lmul
		// / [u]ldivmod / ll{sl,sr} / lasr) sit alongside the crt0.s the runner
		// passes as --runtime, so appendTargetRuntime resolves them (and the
		// linker script) relative to dirOf(--runtime).
		targetRuntimeFiles = @[]@[]char{"crt0.s", "semihost.s", "aeabi_int.s", "aeabi_float.s"}
		// libgcc.a now supplies only the SOFT-FLOAT AEABI helpers — the
		// 64-bit INTEGER ones are provided C-free by aeabi_int.s above,
		// which (linked as an object before the archive) resolves those
		// symbols first so libgcc's members are never pulled.  It is NOT
		// pinned here because its path depends on the host toolchain layout
		// — apt installs to
		// /usr/lib/gcc/arm-none-eabi/<v>/, brew installs to a Cellar
		// path.  The runner script probes the host and passes the
		// concrete path via `--link-after-objs` so bnc appends it
		// after the .o files (archive order matters for lld).
		// baremetal.ld resolves the same way.
		targetLinkerScript = "baremetal.ld"
		return
	}
	fmt.Print("error: unknown --target ", key, "\n")
	os.Exit(1)
}

// activeBuildConfig returns the BuildConfig that #[build(...)] gating is
// evaluated against for the given --target key — an explicit key, or this
// bnc's compiled-in host (see buildcfg.ConfigForTarget / HostConfig).  No
// build.bni is read at runtime.
func activeBuildConfig(key *[]readonly char) @buildcfg.BuildConfig {
	return buildcfg.ConfigForTarget(key)
}

// nativeArchForTarget returns the arch string pkg/binate/native.EmitObject
// expects for the currently-active target.  Derived from
// targetTriple (set by applyTarget); falls back to the host arch
// when no explicit --target was passed.
//
// Recognised mappings:
//   x86_64-linux-gnu   → "x86_64"
//   arm-none-eabi      → "arm32" (native ARM32 ELF backend, baremetal)
//   arm-linux-gnueabihf → "arm32" (native ARM32 backend, HARD-float/AAPCS-VFP —
//                          applyTarget stamps FLOAT_ABI_HARD, so the backend +
//                          codegen classify floats in VFP registers via
//                          types.Arm32HardFloat()).
//   default (host)     → the compiled-in host arch (build.Arch): "aarch64"
//                          on Apple Silicon, "x86_64" on an amd64 host.
//                          Hardcoding "aarch64" here misdirects a host native
//                          build on an x86_64 host to the arm64 backend.
//
// When this returns "", callers should hard-error rather than
// passing it through to native.EmitObject (which only knows the
// non-empty arch strings).
func nativeArchForTarget() *[]readonly char {
	if len(targetTriple) == 0 {
		if build.Arch == build.ARCH_X64 { return "x86_64" }
		if build.Arch == build.ARCH_ARM32 { return "arm32" }
		return "aarch64"
	}
	if streq(targetTriple, "x86_64-linux-gnu") {
		return "x86_64"
	}
	if streq(targetTriple, "x86_64-apple-darwin") {
		return "x86_64"
	}
	if streq(targetTriple, "aarch64-linux-gnu") {
		return "aarch64"
	}
	if streq(targetTriple, "arm-none-eabi") {
		return "arm32"
	}
	// arm-linux-gnueabihf also routes to the native arm32 backend: applyTarget
	// stamped it FLOAT_ABI_HARD, so the backend emits the hard-float (AAPCS-VFP)
	// convention.  Only reached via --backend native;
	// the LLVM path is unaffected (it never calls this).
	if streq(targetTriple, "arm-linux-gnueabihf") {
		return "arm32"
	}
	return ""
}

// nativeObjFormatForTarget returns the object-file format
// (`pkg/binate/native.EmitObject`'s `format` arg) for the active target,
// decoded from the same triple as the arch (object format is an
// independent axis from the processor backend).
//
//   empty triple (host)  → the host OS's native format (build.OS):
//                           "macho" on Darwin, "elf" on Linux/baremetal.
//                           Hardcoding "macho" here emitted an unlinkable
//                           Mach-O object on a Linux host doing a bare
//                           `--backend native` build.
//   x86_64-apple-darwin  → "macho"
//   any other triple     → "elf"    (the explicit targets are Linux:
//                           x86_64-linux-gnu, arm-linux-gnueabihf, …)
func nativeObjFormatForTarget() *[]readonly char {
	if len(targetTriple) == 0 {
		if build.OS == build.OS_DARWIN { return "macho" }
		return "elf"
	}
	if streq(targetTriple, "x86_64-apple-darwin") {
		return "macho"
	}
	return "elf"
}

// appendCompileStripFlags appends the per-compile flags that let the
// linker later dead-strip unreferenced symbols.  ELF's --gc-sections
// works at section granularity, so each function / global must land in
// its own section (-ffunction-sections / -fdata-sections) to be droppable
// individually.  Mach-O's -dead_strip is atom-based and needs no
// compile-side flag.  Without this, emitted-but-unused weak_odr data
// (function-value vtables / shims / handles, and the package descriptors)
// would be kept in every binary regardless of use.
func appendCompileStripFlags(args @[]@[]char) @[]@[]char {
	if streq(nativeObjFormatForTarget(), "elf") {
		args = appendRawCharSlice(args, "-ffunction-sections")
		args = appendRawCharSlice(args, "-fdata-sections")
	}
	return args
}

// appendLinkStripFlags appends the link flag that drops unreferenced
// symbols: -dead_strip on Mach-O (ld64, atom-based), -Wl,--gc-sections on
// ELF (which relies on the per-section compile flags above).  Roots are
// the entry point and everything reachable from it, so the runtime,
// address-taken externs, and live vtables all stay; only genuinely-unused
// definitions are removed.  The arm32-baremetal linker script already
// ENTRY(_start)s and KEEP(*(.text.startup))s the boot path, so gc-sections
// roots correctly there.
func appendLinkStripFlags(args @[]@[]char) @[]@[]char {
	if streq(nativeObjFormatForTarget(), "macho") {
		args = appendRawCharSlice(args, "-dead_strip")
	} else {
		args = appendRawCharSlice(args, "-Wl,--gc-sections")
	}
	return args
}

// setArm32Layout sets the 32-bit ILP32 layout (4-byte pointers and
// ints).  MaxAlign is 8, not 4: AAPCS (the ARM EABI used by both
// arm-linux-gnueabihf and bare-metal arm-none-eabi) aligns the 8-byte
// fundamental types (`long long` / `double`, i.e. Binate int64 / uint64
// / float64) to 8 bytes even though pointers and int are 4.  Capping at
// 4 undersizes any struct with an 8-byte member relative to the platform
// layout — e.g. os's `struct stat64` (104 bytes) reads back as 96, so the
// kernel's stat64 write overruns the buffer and SIGSEGVs.  Shared by
// arm32-linux and arm32-baremetal; AAPCS alignment is the same for both.
func setArm32Layout() {
	var t types.TargetInfo
	t.PointerSize = 4
	t.IntSize = 4
	t.MaxAlign = 8
	types.SetTarget(t)
	// After SetTarget (which resets every field); SetArch stamps just the
	// arch, so order here matters — the arm32 discriminator would otherwise
	// be lost.
	types.SetArch(types.ARCH_ARM32)
}

// hostArch maps this bnc's compiled-in host architecture (build.Arch, a
// foldable compile-time constant) to the types.ARCH_* discriminator.  Used as
// the default when --target names the host or is omitted, so a host build
// carries the right arch without an explicit SetTarget.
func hostArch() int {
	if build.Arch == build.ARCH_X64 { return types.ARCH_X64 }
	if build.Arch == build.ARCH_ARM32 { return types.ARCH_ARM32 }
	return types.ARCH_AA64
}

// appendTargetFlags adds `-target <triple>` and the per-target
// fixed clang flags to a clang argv when a non-host target is
// active.  No-op for the default host build.
func appendTargetFlags(args @[]@[]char) @[]@[]char {
	if len(targetTriple) == 0 { return args }
	args = appendRawCharSlice(args, "-target")
	args = appendRawCharSlice(args, targetTriple)
	for i := 0; i < len(targetClangFlags); i++ {
		args = appendRawCharSlice(args, targetClangFlags[i])
	}
	return args
}

// appendTargetLinkFlags adds target-specific flags that belong ONLY on the link
// (not the -c compile) step.  `backend` is cli.Backend ("" = LLVM, "native").
// Called from both link sites (the program link in main.bn and the --test
// binary link in test.bn) so they stay in lockstep.
//
// Today's only rule: the native arm32 backend materializes global/string
// addresses with an absolute (non-PIC) MOVW/MOVT code model, so its executables
// must be linked non-PIE — the gnueabihf driver defaults to -pie, under which
// the emitted R_ARM_MOVW_ABS_NC relocations are rejected ("can not be used when
// making a shared object").  Scoped to native arm32-linux: aarch64 native is
// naturally PC-relative and the LLVM arm32 path emits PIC (neither needs this),
// and the baremetal arm-none-eabi driver is not PIE by default.
func appendTargetLinkFlags(args @[]@[]char, backend *[]readonly char) @[]@[]char {
	if streq(targetTriple, "arm-linux-gnueabihf") && streq(backend, "native") {
		args = appendRawCharSlice(args, "-no-pie")
	}
	return args
}

// appendTargetRuntime adds the target-specific runtime files to a
// clang link argv plus the `-Wl,-T,<linker-script>` directive when
// one is set.  No-op for the default host build; bare-metal targets
// append crt0.s + semihost.s + the QEMU virt linker script via this
// path.  Host-toolchain archives like libgcc.a — whose concrete path
// varies between dev hosts — are passed via `--link-after-objs` from
// the runner script instead.
//
// `runtimeDir` is the bare-metal runtime directory, dirOf(--runtime): the
// runner passes `--runtime .../runtime/baremetal_arm32/crt0.s`, so crt0.s,
// semihost.s, and the linker script all resolve relative to it.  Entries that
// start with '/' pass through verbatim (already-absolute system-toolchain
// paths).  A `.s` entry (e.g. semihost.s) is appended as its own path here;
// the link driver's assembleDotSArgs post-pass turns it into an in-process-
// assembled `.o`.
func appendTargetRuntime(args @[]@[]char, runtimeDir *[]readonly char) @[]@[]char {
	for i := 0; i < len(targetRuntimeFiles); i++ {
		var entry @[]char = targetRuntimeFiles[i]
		var abs @[]char
		if len(entry) > 0 && entry[0] == '/' {
			abs = entry
		} else {
			abs = buf.Concat(
					buf.Concat(runtimeDir, "/"), entry)
		}
		args = appendRawCharSlice(args, abs)
	}
	if len(targetLinkerScript) > 0 {
		var script @[]char = buf.Concat(
				buf.Concat(runtimeDir, "/"), targetLinkerScript)
		args = appendRawCharSlice(args, buf.Concat("-Wl,-T,", script))
	}
	return args
}
