package "main"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"

// Each 64-bit --target key sets the LP64 layout whatever the host: the types
// package's default is the host's own layout, which on a 32-bit host is ILP32.

// checkLP64Target applies key over the hard-float ILP32 target arm32-linux sets --
// a 32-bit host's layout, so a key that leaves the layout alone fails on any host --
// and checks that it sets the LP64 layout and arch, and the default float ABI.  It
// restores the target it found.
func checkLP64Target(key *[]readonly char, arch int) testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(saved) }
	resetTargetState()
	defer { resetTargetState() }
	setArm32Layout()
	types.SetFloatABI(types.FLOAT_ABI_HARD)
	applyTarget(key)
	var t types.TargetInfo = types.GetTarget()
	if t.PointerSize != 8 || t.IntSize != 8 || t.MaxAlign != 8 {
		return fail(buf.Concat(key, ": the layout must be LP64"))
	}
	if t.Arch != arch { return fail(buf.Concat(key, ": the arch is wrong")) }
	if t.FloatABI != types.FLOAT_ABI_DEFAULT {
		return fail(buf.Concat(key, ": the float ABI must be the default"))
	}
	if types.TypInt().Size() != 8 { return fail(buf.Concat(key, ": int must be 8 bytes")) }
	return ""
}

func TestApplyTargetSetsLP64Layout() testing.TestResult {
	var r testing.TestResult = checkLP64Target("x86_64-linux", types.ARCH_X64)
	if len(r) > 0 { return r }
	r = checkLP64Target("x86_64-darwin", types.ARCH_X64)
	if len(r) > 0 { return r }
	r = checkLP64Target("aarch64-linux", types.ARCH_AA64)
	if len(r) > 0 { return r }
	return checkLP64Target("aarch64-darwin", types.ARCH_AA64)
}
