package "main"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/build"
import "pkg/builtins/testing"

// Each --target key sets its own target whatever the host, and the host key the
// host's: the types package's default is only the host's sizes, which on a 32-bit
// host are ILP32, with no arch or float ABI.

// checkLP64Target applies key over the hard-float ILP32 target arm32-linux sets --
// a 32-bit host's layout, so a key that leaves the layout alone fails on any host --
// and checks that it sets the LP64 layout and arch, and the default float ABI.  It
// restores the target it found.
func checkLP64Target(key *[]readonly char, arch int) testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(saved) }
	resetTargetState()
	defer { resetTargetState() }
	applyTarget("arm32-linux")
	applyTarget(key)
	var t types.TargetInfo = types.GetTarget()
	if t.PointerSize != 8 || t.IntSize != 8 || t.MaxAlign != 8 {
		return fail(buf.Concat(key, ": the layout must be LP64"))
	}
	if t.Arch != arch { return fail(buf.Concat(key, ": the arch is wrong")) }
	if t.FloatABI != types.FLOAT_ABI_DEFAULT {
		return fail(buf.Concat(key, ": the float ABI must be the default"))
	}
	if types.TypInt().Size() != 8 { return fail(buf.Concat(key, ": int must be 8 bytes")) }
	return ""
}

func TestApplyTargetSetsLP64Layout() testing.TestResult {
	var r testing.TestResult = checkLP64Target("x86_64-linux", types.ARCH_X64)
	if len(r) > 0 { return r }
	r = checkLP64Target("x86_64-darwin", types.ARCH_X64)
	if len(r) > 0 { return r }
	r = checkLP64Target("aarch64-linux", types.ARCH_AA64)
	if len(r) > 0 { return r }
	return checkLP64Target("aarch64-darwin", types.ARCH_AA64)
}

// The host key sets the host's own target over the soft-float ILP32 one: its sizes,
// arch and float ABI (hard on an arm32 linux host), not only its arch.
func TestApplyTargetHostSetsHostTarget() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(saved) }
	resetTargetState()
	defer { resetTargetState() }
	applyTarget("arm32-baremetal")
	applyTarget("host")
	var t types.TargetInfo = types.GetTarget()
	if t.PointerSize != cast(int, sizeof(*uint8)) || t.IntSize != cast(int, sizeof(int)) ||
			t.MaxAlign != 8 {
		return fail("host: the layout must be the host's sizes")
	}
	var arch int = types.ARCH_AA64
	if build.Arch == build.ARCH_X64 { arch = types.ARCH_X64 }
	if build.Arch == build.ARCH_ARM32 { arch = types.ARCH_ARM32 }
	if t.Arch != arch { return fail("host: the arch is wrong") }
	var floatABI int = types.FLOAT_ABI_DEFAULT
	if build.Arch == build.ARCH_ARM32 && build.OS == build.OS_LINUX { floatABI = types.FLOAT_ABI_HARD }
	if t.FloatABI != floatABI { return fail("host: the float ABI is wrong") }
	return ""
}
