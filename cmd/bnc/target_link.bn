package "main"

import "pkg/binate/buf"

// The target-specific parts of the clang command lines bnc builds: the dead-strip
// flags, the target triple and flags, and a bare-metal target's runtime files and
// linker script.  applyTarget (target.bn) sets the state they read.

// appendCompileStripFlags appends the per-compile flags that let the
// linker later dead-strip unreferenced symbols.  ELF's --gc-sections
// works at section granularity, so each function / global must land in
// its own section (-ffunction-sections / -fdata-sections) to be droppable
// individually.  Mach-O's -dead_strip is atom-based and needs no
// compile-side flag.  Without this, emitted-but-unused weak_odr data
// (function-value vtables / shims / handles, and the package descriptors)
// would be kept in every binary regardless of use.
func appendCompileStripFlags(args @[]@[]char) @[]@[]char {
	if streq(nativeObjFormatForTarget(), "elf") {
		args = appendRawCharSlice(args, "-ffunction-sections")
		args = appendRawCharSlice(args, "-fdata-sections")
	}
	return args
}

// appendLinkStripFlags appends the link flag that drops unreferenced
// symbols: -dead_strip on Mach-O (ld64, atom-based), -Wl,--gc-sections on
// ELF (which relies on the per-section compile flags above).  Roots are
// the entry point and everything reachable from it, so the runtime,
// address-taken externs, and live vtables all stay; only genuinely-unused
// definitions are removed.  The arm32-baremetal linker script already
// ENTRY(_start)s and KEEP(*(.text.startup))s the boot path, so gc-sections
// roots correctly there.
func appendLinkStripFlags(args @[]@[]char) @[]@[]char {
	if streq(nativeObjFormatForTarget(), "macho") {
		args = appendRawCharSlice(args, "-dead_strip")
	} else {
		args = appendRawCharSlice(args, "-Wl,--gc-sections")
	}
	return args
}

// appendTargetFlags adds `-target <triple>` and the per-target
// fixed clang flags to a clang argv when a non-host target is
// active.  No-op for the default host build.
func appendTargetFlags(args @[]@[]char) @[]@[]char {
	if len(targetTriple) == 0 { return args }
	args = appendRawCharSlice(args, "-target")
	args = appendRawCharSlice(args, targetTriple)
	for i := 0; i < len(targetClangFlags); i++ {
		args = appendRawCharSlice(args, targetClangFlags[i])
	}
	return args
}

// appendTargetLinkFlags adds target-specific flags that belong ONLY on the link
// (not the -c compile) step.  `backend` is cli.Backend ("" = LLVM, "native").
// Called from both link sites (the program link in main.bn and the --test
// binary link in test.bn) so they stay in lockstep.
//
// Today's only rule: the native arm32 backend materializes global/string
// addresses with an absolute (non-PIC) MOVW/MOVT code model, so its executables
// must be linked non-PIE — the gnueabihf driver defaults to -pie, under which
// the emitted R_ARM_MOVW_ABS_NC relocations are rejected ("can not be used when
// making a shared object").  Scoped to native arm32-linux: aarch64 native is
// naturally PC-relative and the LLVM arm32 path emits PIC (neither needs this),
// and the baremetal arm-none-eabi driver is not PIE by default.
func appendTargetLinkFlags(args @[]@[]char, backend *[]readonly char) @[]@[]char {
	if streq(targetTriple, "arm-linux-gnueabihf") && streq(backend, "native") {
		args = appendRawCharSlice(args, "-no-pie")
	}
	return args
}

// appendTargetRuntime adds the target-specific runtime files to a
// clang link argv plus the `-Wl,-T,<linker-script>` directive for
// `script` when it is set — targetLinkerScript for a program,
// targetTestLinkerScript for a `--test` binary.  No-op for the default
// host build; bare-metal targets append crt0.s + semihost.s + the QEMU
// virt linker script via this path.  Host-toolchain archives like
// libgcc.a — whose concrete path varies between dev hosts — are passed
// via `--link-after-objs` from the runner script instead.
//
// `runtimeDir` is the bare-metal runtime directory, dirOf(--runtime): the
// runner passes `--runtime .../runtime/baremetal_arm32/crt0.s`, so crt0.s,
// semihost.s, and the linker script all resolve relative to it.  The directory
// also goes on the link's search path (-L), where a script's INCLUDE finds the
// sections it shares with the target's other script.  Entries that
// start with '/' pass through verbatim (already-absolute system-toolchain
// paths).  A `.s` entry (e.g. semihost.s) is appended as its own path here;
// the link driver's assembleDotSArgs post-pass turns it into an in-process-
// assembled `.o`.
func appendTargetRuntime(args @[]@[]char, runtimeDir *[]readonly char,
		script *[]readonly char) @[]@[]char {
	for i := 0; i < len(targetRuntimeFiles); i++ {
		var entry @[]char = targetRuntimeFiles[i]
		var abs @[]char
		if len(entry) > 0 && entry[0] == '/' {
			abs = entry
		} else {
			abs = buf.Concat(
					buf.Concat(runtimeDir, "/"), entry)
		}
		args = appendRawCharSlice(args, abs)
	}
	if len(script) > 0 {
		args = appendRawCharSlice(args, "-L")
		args = appendRawCharSlice(args, runtimeDir)
		var path @[]char = buf.Concat(
				buf.Concat(runtimeDir, "/"), script)
		args = appendRawCharSlice(args, buf.Concat("-Wl,-T,", path))
	}
	return args
}
