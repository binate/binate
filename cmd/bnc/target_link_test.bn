package "main"

import "pkg/builtins/testing"

// Tests for cmd/bnc/target_link.bn — the target-specific clang flags and runtime
// inputs.  resetTargetState and strInList are in target_test.bn.

// linksSections reports whether args links the shared sections script (under
// /binate) and fails an orphan section.
func linksSections(args @[]@[]char) bool {
	return strInList(args, "-Wl,-T,/binate/baremetal_sections.ld") &&
			strInList(args, "-Wl,--orphan-handling=error")
}

func TestAppendTargetFlagsHostNoop() testing.TestResult {
	resetTargetState()
	applyTarget("host")
	var args @[]@[]char
	args = appendTargetFlags(args)
	if len(args) != 0 {
		return fail("host appendTargetFlags should add nothing")
	}
	return ""
}

func TestAppendTargetFlagsArm32Baremetal() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	var args @[]@[]char
	args = appendTargetFlags(args)
	if !strInList(args, "-target") { return fail("missing -target") }
	if !strInList(args, "arm-none-eabi") { return fail("missing triple") }
	if !strInList(args, "-nodefaultlibs") {
		return fail("missing -nodefaultlibs")
	}
	return ""
}

func TestAppendTargetRuntimeHostNoop() testing.TestResult {
	resetTargetState()
	applyTarget("host")
	var args @[]@[]char
	args = appendTargetRuntime(args, "/binate", targetLinkerScript)
	if len(args) != 0 {
		return fail("host appendTargetRuntime should add nothing")
	}
	return ""
}

// appendTargetRuntime resolves each targetRuntimeFile + the linker script
// relative to the runtime dir (dirOf(--runtime)); the test passes "/binate"
// as that dir.  crt0.s / semihost.s / the linker scripts all resolve there.
func TestAppendTargetRuntimeArm32BaremetalResolvesPaths() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	var args @[]@[]char
	args = appendTargetRuntime(args, "/binate", targetLinkerScript)
	if !strInList(args, "/binate/crt0.s") {
		return fail("crt0.s not resolved against the runtime dir")
	}
	if !strInList(args, "/binate/semihost.s") {
		return fail("semihost.s not resolved against the runtime dir")
	}
	if !strInList(args, "-Wl,-T,/binate/baremetal.ld") {
		return fail("linker script directive not emitted with -Wl,-T")
	}
	if !linksSections(args) {
		return fail("the shared sections must be linked, an orphan section failing the link")
	}
	return ""
}

// A `--test` binary links with the target's test linker script, resolved in the
// runtime dir with the shared sections, like a program's.
func TestAppendTargetRuntimeArm32BaremetalTestScript() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	var args @[]@[]char
	args = appendTargetRuntime(args, "/binate", targetTestLinkerScript)
	if !strInList(args, "-Wl,-T,/binate/baremetal_test.ld") {
		return fail("the test linker script not emitted with -Wl,-T")
	}
	if strInList(args, "-Wl,-T,/binate/baremetal.ld") {
		return fail("a test binary must not also link with the program's script")
	}
	if !linksSections(args) {
		return fail("the shared sections must be linked, an orphan section failing the link")
	}
	return ""
}

// Mach-O dead-strip is atom-based, so the link gets -dead_strip and the
// per-module compile needs no section flags.  Uses an explicit Mach-O
// target (x86_64-darwin) rather than "host" so the check holds on any host
// OS — "host" decodes to the host's native format, which is ELF on Linux
// (build.OS), so this would spuriously fail on a Linux CI runner.
func TestStripFlagsMachO() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-darwin")
	var link @[]@[]char
	link = appendLinkStripFlags(link)
	if !strInList(link, "-dead_strip") {
		return fail("Mach-O link should add -dead_strip")
	}
	if strInList(link, "-Wl,--gc-sections") {
		return fail("Mach-O link must NOT add --gc-sections")
	}
	var comp @[]@[]char
	comp = appendCompileStripFlags(comp)
	if len(comp) != 0 {
		return fail("Mach-O compile needs no section flags (-dead_strip is atom-based)")
	}
	return ""
}

// ELF --gc-sections is section-granular, so the compile must put each
// function / global in its own section (-ffunction-sections /
// -fdata-sections) and the link gets -Wl,--gc-sections (not -dead_strip).
func TestStripFlagsElf() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-linux")
	var link @[]@[]char
	link = appendLinkStripFlags(link)
	if !strInList(link, "-Wl,--gc-sections") {
		return fail("ELF link should add -Wl,--gc-sections")
	}
	if strInList(link, "-dead_strip") {
		return fail("ELF link must NOT add -dead_strip")
	}
	var comp @[]@[]char
	comp = appendCompileStripFlags(comp)
	if !strInList(comp, "-ffunction-sections") {
		return fail("ELF compile should add -ffunction-sections")
	}
	if !strInList(comp, "-fdata-sections") {
		return fail("ELF compile should add -fdata-sections")
	}
	return ""
}

// The arm32-baremetal ELF target gets the same section + gc-sections
// treatment; its linker script already ENTRY(_start)s / KEEPs the boot
// path, so gc-sections roots correctly there.
func TestStripFlagsArm32BaremetalElf() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	var link @[]@[]char
	link = appendLinkStripFlags(link)
	if !strInList(link, "-Wl,--gc-sections") {
		return fail("baremetal (ELF) link should add -Wl,--gc-sections")
	}
	var comp @[]@[]char
	comp = appendCompileStripFlags(comp)
	if !strInList(comp, "-ffunction-sections") {
		return fail("baremetal (ELF) compile should add -ffunction-sections")
	}
	return ""
}
