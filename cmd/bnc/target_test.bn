package "main"

import "pkg/builtin/testing"
import "pkg/types"

// Tests for cmd/bnc/target.bn — applyTarget translation,
// nativeArchForTarget mapping, appendTargetFlags / appendTargetRuntime
// argv production.  Split out of main_test.bn alongside the
// production-code split (cmd/bnc/target.bn).

// resetTargetState clears every applyTarget-populated package var
// so the target-helper tests below can each set up their own
// scenario without sequence dependencies.  Does NOT touch
// types.target — pkg/types has its own SetTarget contract and
// resetting it mid-test is not safe (predeclared int singletons
// would mismatch their already-initialized Width).  Tests below
// don't depend on the types-side state.
func resetTargetState() {
	var emptyStr @[]char
	var emptyList @[]@[]char
	targetTriple = emptyStr
	targetClangFlags = emptyList
	targetImplPathSuffixes = emptyList
	targetRuntimeFiles = emptyList
	targetLinkerScript = emptyStr
	suppressHostRuntime = false
}

// strInList: linear scan for a string match; used by the assertion
// helpers below to look for specific clang flags in the produced
// argv.
func strInList(list @[]@[]char, needle *[]const char) bool {
	for i := 0; i < len(list); i++ {
		if streq(list[i], needle) { return true }
	}
	return false
}

func TestApplyTargetHostNoop() testing.TestResult {
	resetTargetState()
	applyTarget("host")
	if len(targetTriple) != 0 {
		return fail("host should leave triple empty")
	}
	if len(targetClangFlags) != 0 {
		return fail("host should add no clang flags")
	}
	if len(targetImplPathSuffixes) != 0 {
		return fail("host should add no impl-path suffix")
	}
	if len(targetRuntimeFiles) != 0 {
		return fail("host should add no runtime files")
	}
	if len(targetLinkerScript) != 0 {
		return fail("host should set no linker script")
	}
	if suppressHostRuntime {
		return fail("host should NOT suppress its own runtime")
	}
	return ""
}

func TestApplyTargetEmptyKeyNoop() testing.TestResult {
	resetTargetState()
	applyTarget("")
	if len(targetTriple) != 0 {
		return fail("empty key should leave triple empty")
	}
	return ""
}

func TestApplyTargetArm32LinuxNoBaremetal() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-linux")
	if !seq(targetTriple, "arm-linux-gnueabihf") {
		return fail("arm32-linux triple wrong")
	}
	// CPU pinned via -march=armv7-a (the triple omits `v7` so
	// clang's GCC-toolchain discovery matches the cross-gcc
	// install path).
	if len(targetClangFlags) == 0 ||
			!seq(targetClangFlags[0], "-march=armv7-a") {
		return fail("arm32-linux should set -march=armv7-a")
	}
	// arm32-linux uses the libc-host runtime, so MUST NOT
	// suppress it or supply bare-metal crt0 / linker script.
	if suppressHostRuntime {
		return fail("arm32-linux should not suppress host runtime")
	}
	if len(targetRuntimeFiles) != 0 {
		return fail("arm32-linux should not add runtime files")
	}
	if len(targetLinkerScript) != 0 {
		return fail("arm32-linux should not set a linker script")
	}
	return ""
}

func TestApplyTargetX86_64LinuxTripleOnly() testing.TestResult {
	resetTargetState()
	// Stamp a known LP64 layout first; an earlier arm32-* test in
	// this run may have left types.target at PointerSize=4, and the
	// point of this test is to verify applyTarget("x86_64-linux")
	// LEAVES the layout alone, not to verify that LP64 is the
	// default.
	var before types.TargetInfo
	before.PointerSize = 8
	before.IntSize = 8
	before.MaxAlign = 8
	types.SetTarget(before)
	applyTarget("x86_64-linux")
	if !seq(targetTriple, "x86_64-linux-gnu") {
		return fail("x86_64-linux triple wrong")
	}
	var after types.TargetInfo = types.GetTarget()
	if after.PointerSize != 8 || after.IntSize != 8 || after.MaxAlign != 8 {
		return fail("x86_64-linux must not change the active layout")
	}
	// No extra clang flags / runtime files / linker script for the
	// standard libc-host SysV-AMD64 path.
	if len(targetClangFlags) != 0 {
		return fail("x86_64-linux should add no clang flags")
	}
	if len(targetRuntimeFiles) != 0 {
		return fail("x86_64-linux should add no runtime files")
	}
	if len(targetLinkerScript) != 0 {
		return fail("x86_64-linux should set no linker script")
	}
	if suppressHostRuntime {
		return fail("x86_64-linux must not suppress host runtime")
	}
	return ""
}

// nativeArchForTarget pins the mapping cmd/bnc uses to pick which
// pkg/native sub-backend handles --backend native for a given
// --target.  Defaults to "aarch64" (the only backend that currently
// produces real objects on a typical macOS arm64 dev host);
// x86_64-linux routes to "x86_64" (the Phase 2 stub); unknown
// triples return "" so the caller can hard-error.
func TestNativeArchForTargetDefaultsAarch64() testing.TestResult {
	resetTargetState()
	if !seq(nativeArchForTarget(), "aarch64") {
		return fail("default native arch should be aarch64")
	}
	return ""
}

func TestNativeArchForTargetX86_64Linux() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-linux")
	if !seq(nativeArchForTarget(), "x86_64") {
		return fail("x86_64-linux should map to x86_64 native arch")
	}
	return ""
}

func TestNativeArchForTargetArm32LinuxNoNative() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-linux")
	if len(nativeArchForTarget()) != 0 {
		return fail("arm32-linux should report no native arch (LLVM only)")
	}
	return ""
}

func TestApplyTargetArm32BaremetalPopulatesEverything() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	if !seq(targetTriple, "arm-none-eabi") {
		return fail("arm32-baremetal triple wrong")
	}
	if !strInList(targetClangFlags, "-nostartfiles") {
		return fail("missing -nostartfiles")
	}
	if !strInList(targetClangFlags, "-nodefaultlibs") {
		return fail("missing -nodefaultlibs")
	}
	// libgcc.a is not pinned into targetRuntimeFiles — its path
	// differs across hosts (apt vs brew vs ...).  The runner
	// scripts probe the host toolchain and pass the concrete path
	// via `--link-after-objs`, which feeds linkAfterObjs (asserted
	// separately in args_test.bn / TestParseArgsLinkAfterObjs).
	if !strInList(targetClangFlags, "-ffreestanding") {
		return fail("missing -ffreestanding")
	}
	if !strInList(targetClangFlags, "-mfloat-abi=soft") {
		return fail("missing -mfloat-abi=soft")
	}
	if !suppressHostRuntime {
		return fail("arm32-baremetal must suppress host runtime")
	}
	if !strInList(targetRuntimeFiles, "runtime/baremetal_arm32/crt0.s") {
		return fail("missing crt0.s")
	}
	if !strInList(targetRuntimeFiles, "runtime/baremetal_arm32/semihost.s") {
		return fail("missing semihost.s")
	}
	if !seq(targetLinkerScript, "runtime/baremetal_arm32/baremetal.ld") {
		return fail("wrong linker script")
	}
	if !strInList(targetImplPathSuffixes, "runtime/baremetal_arm32") {
		return fail("missing impl-path suffix")
	}
	// pkg/types should also reflect the 32-bit ILP32 layout.
	var info types.TargetInfo = types.GetTarget()
	if info.PointerSize != 4 { return fail("PointerSize != 4") }
	if info.IntSize != 4 { return fail("IntSize != 4") }
	return ""
}

func TestAppendTargetFlagsHostNoop() testing.TestResult {
	resetTargetState()
	applyTarget("host")
	var args @[]@[]char
	args = appendTargetFlags(args)
	if len(args) != 0 {
		return fail("host appendTargetFlags should add nothing")
	}
	return ""
}

func TestAppendTargetFlagsArm32Baremetal() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	var args @[]@[]char
	args = appendTargetFlags(args)
	if !strInList(args, "-target") { return fail("missing -target") }
	if !strInList(args, "arm-none-eabi") { return fail("missing triple") }
	if !strInList(args, "-nodefaultlibs") {
		return fail("missing -nodefaultlibs")
	}
	return ""
}

func TestAppendTargetRuntimeHostNoop() testing.TestResult {
	resetTargetState()
	applyTarget("host")
	var args @[]@[]char
	args = appendTargetRuntime(args, "/binate")
	if len(args) != 0 {
		return fail("host appendTargetRuntime should add nothing")
	}
	return ""
}

func TestAppendTargetRuntimeArm32BaremetalResolvesPaths() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	var args @[]@[]char
	args = appendTargetRuntime(args, "/binate")
	if !strInList(args, "/binate/runtime/baremetal_arm32/crt0.s") {
		return fail("crt0.s not resolved against root")
	}
	if !strInList(args, "/binate/runtime/baremetal_arm32/semihost.s") {
		return fail("semihost.s not resolved against root")
	}
	if !strInList(args, "-Wl,-T,/binate/runtime/baremetal_arm32/baremetal.ld") {
		return fail("linker script directive not emitted with -Wl,-T")
	}
	return ""
}
