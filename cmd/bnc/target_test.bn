package "main"

import "pkg/binate/buildcfg"
import "pkg/binate/types"
import "pkg/binate/types/abi"
import "pkg/builtins/build"
import "pkg/builtins/testing"

// Tests for cmd/bnc/target.bn — applyTarget translation and the
// nativeArchForTarget mapping.

// resetTargetState clears every applyTarget-populated package var
// so the target-helper tests below can each set up their own
// scenario without sequence dependencies.  Does NOT touch
// types.target: a test that needs the layout it found back saves and
// restores it (types.GetTarget / types.SetTarget).
func resetTargetState() {
	var emptyStr @[]char
	var emptyList @[]@[]char
	targetTriple = emptyStr
	targetClangFlags = emptyList
	targetRuntimeFiles = emptyList
	targetLinkerScript = emptyStr
	targetTestLinkerScript = emptyStr
}

// strInList: linear scan for a string match; used by the assertion
// helpers below to look for specific clang flags in the produced
// argv.
func strInList(list @[]@[]char, needle *[]readonly char) bool {
	for i := 0; i < len(list); i++ {
		if streq(list[i], needle) { return true }
	}
	return false
}

func TestApplyTargetHostNoop() testing.TestResult {
	resetTargetState()
	applyTarget("host")
	if len(targetTriple) != 0 {
		return fail("host should leave triple empty")
	}
	if len(targetClangFlags) != 0 {
		return fail("host should add no clang flags")
	}
	if len(targetRuntimeFiles) != 0 {
		return fail("host should add no runtime files")
	}
	if len(targetLinkerScript) != 0 || len(targetTestLinkerScript) != 0 {
		return fail("host should set no linker script")
	}
	return ""
}

func TestApplyTargetEmptyKeyNoop() testing.TestResult {
	resetTargetState()
	applyTarget("")
	if len(targetTriple) != 0 {
		return fail("empty key should leave triple empty")
	}
	return ""
}

func TestApplyTargetArm32LinuxNoBaremetal() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-linux")
	if !seq(targetTriple, "arm-linux-gnueabihf") {
		return fail("arm32-linux triple wrong")
	}
	// CPU pinned via -march=armv7ve (the triple omits `v7` so
	// clang's GCC-toolchain discovery matches the cross-gcc
	// install path).
	if len(targetClangFlags) == 0 || !seq(targetClangFlags[0], "-march=armv7ve") {
		return fail("arm32-linux should set -march=armv7ve")
	}
	// arm32-linux uses the libc-host runtime, so it supplies no
	// bare-metal crt0 / linker script.
	if len(targetRuntimeFiles) != 0 {
		return fail("arm32-linux should not add runtime files")
	}
	if len(targetLinkerScript) != 0 {
		return fail("arm32-linux should not set a linker script")
	}
	// The types-layer layout must reflect arm32 ILP32, like the baremetal
	// test asserts: 4-byte pointers/int, 8-byte MaxAlign (AAPCS32 aligns
	// int64/uint64/float64 to 8 even though pointers/int are 4).
	var info types.TargetInfo = types.GetTarget()
	if info.PointerSize != 4 { return fail("PointerSize != 4") }
	if info.IntSize != 4 { return fail("IntSize != 4") }
	if info.MaxAlign != 8 { return fail("MaxAlign != 8 (AAPCS)") }
	return ""
}

func TestApplyTargetX86_64LinuxTripleOnly() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-linux")
	if !seq(targetTriple, "x86_64-linux-gnu") {
		return fail("x86_64-linux triple wrong")
	}
	// No extra clang flags / runtime files / linker script for the
	// standard libc-host SysV-AMD64 path.
	if len(targetClangFlags) != 0 {
		return fail("x86_64-linux should add no clang flags")
	}
	if len(targetRuntimeFiles) != 0 {
		return fail("x86_64-linux should add no runtime files")
	}
	if len(targetLinkerScript) != 0 {
		return fail("x86_64-linux should set no linker script")
	}
	return ""
}

// nativeArchForTarget pins the mapping cmd/bnc uses to pick which
// pkg/binate/native sub-backend handles --backend native for a given
// --target.  With no --target applied it defaults to the compiled-in
// HOST arch (build.Arch) — not a hardcoded aarch64, since a host native
// build on an x86_64 host must route to the x64 backend, not arm64;
// x86_64-linux routes to "x86_64"; unknown triples return "" so the
// caller can hard-error.
func TestNativeArchForTargetDefaultsHostArch() testing.TestResult {
	resetTargetState()
	// Expected default mirrors nativeArchForTarget's host branch.
	var want *[]readonly char = "aarch64"
	if build.Arch == build.ARCH_X64 { want = "x86_64" }
	if build.Arch == build.ARCH_ARM32 { want = "arm32" }
	if !seq(nativeArchForTarget(), want) {
		return fail("default native arch should be the host arch (build.Arch)")
	}
	return ""
}

func TestNativeArchForTargetX86_64Linux() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-linux")
	if !seq(nativeArchForTarget(), "x86_64") {
		return fail("x86_64-linux should map to x86_64 native arch")
	}
	return ""
}

// x86_64-darwin: same SysV-AMD64 / LP64 layout as x86_64-linux, but
// the triple is x86_64-apple-darwin (so clang/the format decode pick
// Mach-O).  No extra flags.
func TestApplyTargetX86_64DarwinTriple() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-darwin")
	if !seq(targetTriple, "x86_64-apple-darwin") {
		return fail("x86_64-darwin triple should be x86_64-apple-darwin")
	}
	if len(targetClangFlags) != 0 {
		return fail("x86_64-darwin should add no clang flags")
	}
	return ""
}

func TestNativeArchForTargetX86_64Darwin() testing.TestResult {
	resetTargetState()
	applyTarget("x86_64-darwin")
	if !seq(nativeArchForTarget(), "x86_64") {
		return fail("x86_64-darwin should map to x86_64 native arch")
	}
	return ""
}

// nativeObjFormatForTarget decodes the object format from the same triple
// as the arch: the host default is the host OS's native format (build.OS —
// Mach-O on Darwin, ELF on Linux); an explicit *-darwin → Mach-O; the Linux
// triples → ELF.  Object format is an independent axis from arch.
func TestNativeObjFormatForTarget() testing.TestResult {
	resetTargetState()
	// The host default mirrors nativeObjFormatForTarget's host branch.
	var wantHost *[]readonly char = "elf"
	if build.OS == build.OS_DARWIN { wantHost = "macho" }
	if !seq(nativeObjFormatForTarget(), wantHost) {
		return fail("host (empty triple) should be the host OS's native format")
	}
	applyTarget("x86_64-linux")
	if !seq(nativeObjFormatForTarget(), "elf") {
		return fail("x86_64-linux should be ELF")
	}
	resetTargetState()
	applyTarget("x86_64-darwin")
	if !seq(nativeObjFormatForTarget(), "macho") {
		return fail("x86_64-darwin should be Mach-O")
	}
	resetTargetState()
	applyTarget("aarch64-linux")
	if !seq(nativeObjFormatForTarget(), "elf") {
		return fail("aarch64-linux should be ELF")
	}
	return ""
}

// The in-process assembler's OS follows the target: the host's, Linux for the Linux targets,
// Darwin for a Mach-O one, and none for bare metal (which gives an arm32 object bare metal's
// build attributes).
func TestNativeOsForTarget() testing.TestResult {
	resetTargetState()
	var wantHost *[]readonly char = "linux"
	if build.OS == build.OS_DARWIN { wantHost = "darwin" }
	if !seq(nativeOsForTarget(), wantHost) { return fail("host (empty triple) should be the host OS") }
	applyTarget("arm32-linux")
	if !seq(nativeOsForTarget(), "linux") { return fail("arm32-linux should be linux") }
	resetTargetState()
	applyTarget("arm32-baremetal")
	if !seq(nativeOsForTarget(), "") { return fail("arm32-baremetal should have no OS") }
	resetTargetState()
	applyTarget("x86_64-darwin")
	if !seq(nativeOsForTarget(), "darwin") { return fail("x86_64-darwin should be darwin") }
	resetTargetState()
	return ""
}

// aarch64-linux: the arm64 backend's ELF target — triple
// aarch64-linux-gnu, native arch "aarch64".
func TestApplyTargetAarch64Linux() testing.TestResult {
	resetTargetState()
	applyTarget("aarch64-linux")
	if !seq(targetTriple, "aarch64-linux-gnu") {
		return fail("aarch64-linux triple should be aarch64-linux-gnu")
	}
	if !seq(nativeArchForTarget(), "aarch64") {
		return fail("aarch64-linux should map to aarch64 native arch")
	}
	return ""
}

// arm32-linux routes to the native arm32 backend under the HARD-float
// (AAPCS-VFP) convention: nativeArchForTarget reports "arm32" and
// applyTarget stamps FLOAT_ABI_HARD, so abi.Arm32HardFloat() is true.  The
// shared types target is restored afterward so the stamp does not leak.
func TestNativeArchForTargetArm32LinuxHardFloat() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-linux")
	var arch *[]readonly char = nativeArchForTarget()
	var hard bool = abi.Arm32HardFloat()
	types.SetFloatABI(types.FLOAT_ABI_DEFAULT)
	types.SetArch(types.ARCH_UNKNOWN)
	if !seq(arch, "arm32") {
		return fail("arm32-linux should report native arch \"arm32\" (hard-float)")
	}
	if !hard {
		return fail("applyTarget(arm32-linux) should stamp FLOAT_ABI_HARD (Arm32HardFloat)")
	}
	return ""
}

// arm32-baremetal DOES have a native backend (soft-float AAPCS32) — pin that
// nativeArchForTarget routes it to "arm32", so a future edit can't silently
// drop the native baremetal path and fall back to LLVM.
func TestNativeArchForTargetArm32BaremetalNative() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	if !seq(nativeArchForTarget(), "arm32") {
		return fail("arm32-baremetal should report native arch \"arm32\"")
	}
	return ""
}

func TestApplyTargetArm32BaremetalPopulatesEverything() testing.TestResult {
	resetTargetState()
	applyTarget("arm32-baremetal")
	if !seq(targetTriple, "arm-none-eabi") {
		return fail("arm32-baremetal triple wrong")
	}
	if !strInList(targetClangFlags, "-nostartfiles") {
		return fail("missing -nostartfiles")
	}
	if !strInList(targetClangFlags, "-nodefaultlibs") {
		return fail("missing -nodefaultlibs")
	}
	// libgcc.a is not pinned into targetRuntimeFiles — its path
	// differs across hosts (apt vs brew vs ...).  The runner
	// scripts probe the host toolchain and pass the concrete path
	// via `--link-after-objs`, which feeds linkAfterObjs (asserted
	// separately in args_test.bn / TestParseArgsLinkAfterObjs).
	if !strInList(targetClangFlags, "-ffreestanding") {
		return fail("missing -ffreestanding")
	}
	if !strInList(targetClangFlags, "-mfloat-abi=soft") {
		return fail("missing -mfloat-abi=soft")
	}
	// The CPU, as arm32-linux's: the native backend's sdiv / udiv need armv7ve.
	if !strInList(targetClangFlags, "-march=armv7ve") {
		return fail("missing -march=armv7ve")
	}
	// crt0.s and semihost.s are both targetRuntimeFiles — bare filenames
	// resolved on the impl (-L) search paths at link time.
	if !strInList(targetRuntimeFiles, "crt0.s") {
		return fail("missing crt0.s")
	}
	if !strInList(targetRuntimeFiles, "semihost.s") {
		return fail("missing semihost.s")
	}
	if !strInList(targetRuntimeFiles, "aeabi_int.s") {
		return fail("missing aeabi_int.s")
	}
	if !strInList(targetRuntimeFiles, "aeabi_float.s") {
		return fail("missing aeabi_float.s")
	}
	if !seq(targetLinkerScript, "baremetal.ld") {
		return fail("wrong linker script")
	}
	if !seq(targetTestLinkerScript, "baremetal_test.ld") {
		return fail("wrong test linker script")
	}
	// pkg/binate/types should also reflect the 32-bit ILP32 layout.
	var info types.TargetInfo = types.GetTarget()
	if info.PointerSize != 4 { return fail("PointerSize != 4") }
	if info.IntSize != 4 { return fail("IntSize != 4") }
	// MaxAlign is 8, not 4: AAPCS aligns the 8-byte fundamental types
	// (int64 / uint64 / float64) to 8 even though pointers and int are 4.
	// Capping at 4 undersized any 8-byte-member struct vs the platform layout
	// (e.g. os's struct stat64 read back as 96 instead of 104 → SIGSEGV).
	if info.MaxAlign != 8 { return fail("MaxAlign != 8 (AAPCS 8-byte fundamental align)") }
	return ""
}

// targetIsHosted: Linux and macOS targets have a C library; bare metal and an
// absent build config do not.
func TestTargetIsHosted() testing.TestResult {
	if !targetIsHosted(activeBuildConfig("arm32-linux")) { return fail("arm32-linux is hosted") }
	if !targetIsHosted(activeBuildConfig("aarch64-darwin")) { return fail("aarch64-darwin is hosted") }
	if !targetIsHosted(activeBuildConfig("x86_64-linux")) { return fail("x86_64-linux is hosted") }
	if !targetIsHosted(activeBuildConfig("x86_64-darwin")) { return fail("x86_64-darwin is hosted") }
	if !targetIsHosted(activeBuildConfig("aarch64-linux")) { return fail("aarch64-linux is hosted") }
	if targetIsHosted(activeBuildConfig("arm32-baremetal")) {
		return fail("arm32-baremetal is not hosted")
	}
	var none @buildcfg.BuildConfig
	if targetIsHosted(none) { return fail("an absent build config is not hosted") }
	return ""
}
