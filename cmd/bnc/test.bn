package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/codegen"
import "pkg/binate/debug"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/mangle"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/stdx/slices"

// runTestMode compiles test packages into a test binary and runs it.
func runTestMode(cli CLIArgs) {
	if len(cli.Filenames) == 0 {
		println("error: --test requires package paths (e.g. pkg/foo)")
		bootstrap.Exit(1)
	}
	if len(cli.BniPaths) == 0 {
		println("error: --test requires -I <dir> to locate test packages")
		bootstrap.Exit(1)
	}

	var root @[]char = primaryRoot(cli)

	// Set up loader with test packages enabled
	var ldr @loader.Loader = loader.NewLoader(root)
	applyPathFlags(ldr, cli, root)
	for i := 0; i < len(cli.Filenames); i++ {
		ldr.TestPackages = slices.Append[@[]char](ldr.TestPackages, buf.CopyStr(cli.Filenames[i]))
	}

	// Load test packages and their dependencies
	debug.Log("phase: load")
	var syntheticImports @[]@ast.ImportSpec
	for i := 0; i < len(cli.Filenames); i++ {
		var imp @ast.ImportSpec = make(ast.ImportSpec)
		imp.Path = quotePath(cli.Filenames[i])
		syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	}
	ldr.LoadImports(syntheticImports)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}
	ensureRtLoaded(ldr)
	ensureBootstrapLoaded(ldr)
	ensureReflectLoaded(ldr)
	ensureLangLoaded(ldr)
	// Force-load the generated test runner's own stdlib dependencies so
	// they compile + link into the test binary even when no test package
	// imports them.  The runner is parsed after typecheck, so its imports
	// must be loaded up front — see [B] / testRunnerStdlibImports.
	var runnerStdlib @[]@[]char = testRunnerStdlibImports()
	for ri := 0; ri < len(runnerStdlib); ri++ {
		var stdlibSynth @[]@ast.ImportSpec
		var stdlibImp @ast.ImportSpec = make(ast.ImportSpec)
		stdlibImp.Path = quotePath(runnerStdlib[ri])
		stdlibSynth = slices.Append[@ast.ImportSpec](stdlibSynth, stdlibImp)
		ldr.LoadImports(stdlibSynth)
	}

	// Type check all loaded packages
	debug.Log("phase: typecheck")
	var checker @types.Checker = typecheckPackages(ldr)
	ir.SetChecker(checker)
	debug.Log("phase: post-typecheck")

	// The C runtime must be named explicitly (e.g. via `binate-paths
	// --runtime`); no auto-discovery — see the note in main.bn.  Bare-metal
	// targets supply their runtime through the target's own files.
	var runtimePath @[]char = buf.CopyStr(cli.RuntimePath)
	if len(runtimePath) == 0 && !suppressHostRuntime {
		println("error: --runtime is required to link (e.g. `binate-paths --runtime`)")
		bootstrap.Exit(1)
	}
	var binateRoot @[]char = buf.CopyStr(discoverBinateRoot(runtimePath))
	if len(binateRoot) > 0 && !streq(binateRoot, root) {
		ldr.AddRoot(binateRoot)
	}

	// Discover Test* functions in test packages
	var testFuncs @[]TestFunc
	for pi := 0; pi < len(cli.Filenames); pi++ {
		var pkgPath @[]char = cli.Filenames[pi]
		var pkg @loader.Package = ldr.GetPackage(pkgPath)
		if pkg == nil || pkg.Merged == nil {
			print("warning: no implementation for ")
			println(pkgPath)
			continue
		}
		for di := 0; di < len(pkg.Merged.Decls); di++ {
			var d @ast.Decl = pkg.Merged.Decls[di]
			if d.Kind != ast.DECL_FUNC { continue }
			if d.Body == nil { continue }
			if !hasPrefix(d.Name, "Test") { continue }
			if len(d.Params) != 0 { continue }
			if !isTestResultReturn(d, pkg.Merged.Decls) { continue }
			var tf TestFunc
			tf.PkgPath = pkgPath
			tf.FuncName = d.Name
			testFuncs = slices.Append[TestFunc](testFuncs, tf)
		}
	}

	// Generate synthetic test runner main
	var runnerSrc @[]char = genTestRunner(cli.Filenames, testFuncs)
	debug.Log("generated test runner")

	var rp @parser.Parser = parser.New(toBytes(runnerSrc), "test_runner.bn")
	var runnerFile @ast.File = rp.ParseFile()
	var runnerErrors @[]parser.ParseError = rp.Errors()
	if len(runnerErrors) > 0 {
		println("error: test runner parse failed:")
		for i := 0; i < len(runnerErrors); i++ {
			println(runnerErrors[i].Msg)
		}
		if cli.Verbose {
			println("--- generated source ---")
			println(runnerSrc)
			println("--- end ---")
		}
		bootstrap.Exit(1)
	}

	// Intermediate prefix: "<build-dir>/" or "/tmp/binate_test_".
	var outPrefix @[]char = outPrefixFor(cli.BuildDir, "test")
	var useNative bool = streq(cli.Backend, "native")

	// Compile dependency packages. Per-module backend dispatch:
	// LLVM (default) emits .ll → clang → .o; native emits Mach-O .o
	// directly via pkg/binate/native. Both produce objects clang can link.
	var oFiles @[]@[]char
	// Track which test packages emit a `<pkg>.__init` so the test
	// runner module's init dispatcher can include them. Mirrors the
	// non-test compile loop in main.bn — without this the entry
	// wrapper's __init_all() call would skip per-package var
	// initializers.
	var initPkgNames @[]@[]char
	if len(ldr.Order) > 0 {
		for i := 0; i < len(ldr.Order); i++ {
			var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
			if pkg == nil || pkg.Builtin || pkg.Merged == nil { continue }
			debug.Log(buf.Concat("phase: compile-dep-irgen ", ldr.Order[i]))
			var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
			registerPkgImports(ldr, pkg, mod, root)
			if pkg.BNI != nil { ir.RegisterSelfTypes(pkg.BNI) }
			ir.GeneratePackage(pkg.Merged, mod)
			if mod.HasPackageInit() {
				initPkgNames = appendRawCharSlice(initPkgNames,
					ir.PackageInitName(
						mangle.PkgPathFromQuoted(ldr.Order[i])))
			}
			debug.Log(buf.Concat("phase: compile-dep-emit ", ldr.Order[i]))
			// Use the full-path-derived filename so two packages
			// sharing a last-segment short name don't clobber each
			// other's .o in --build-dir.
			var oFile @[]char = compileModuleVia(mod, outPrefix,
				pathFileBase(ldr.Order[i]), useNative)
			if len(oFile) == 0 {
				println("error: native backend failed to emit object")
				bootstrap.Exit(1)
			}
			oFiles = appendRawCharSlice(oFiles, oFile)
		}
	}

	// Compile test runner main
	debug.Log("phase: runner-irgen")
	var mainMod @ir.Module = ir.InitModule("\"main\"")
	registerTestRunnerImports(ldr, runnerFile, mainMod, root, cli.Filenames)
	ir.GeneratePackage(runnerFile, mainMod)
	// Test runner is a `main` package with its own `func main()`.
	// Emit `<main>.__init_all` (calls each per-package __init in
	// dep order) and `<main>.__entry` (the `bn_entry` linker
	// symbol) — same shape as cmd/bnc/main.bn's non-test path.
	// Without these, the C runtime's `bn_entry` extern doesn't
	// resolve and the test binary fails to link.
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()

	if cli.EmitLLVM {
		var mainIR @[]char = codegen.EmitModule(mainMod)
		print(mainIR)
		if !cli.KeepObjs {
			for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		}
		return
	}

	debug.Log("phase: runner-emit")
	var mainO @[]char = compileModuleVia(mainMod, outPrefix,
		"test_main", useNative)
	if len(mainO) == 0 {
		println("error: native backend failed to emit test runner")
		bootstrap.Exit(1)
	}
	oFiles = appendRawCharSlice(oFiles, mainO)
	debug.Log("phase: link")

	// Link. With --build-dir, the binary defaults to <build-dir>/test_bin
	// (so it's cleaned up alongside the .o files); otherwise the legacy
	// /tmp/binate_test_bin path. -o on the command line still wins —
	// but the test harness doesn't pass -o, so this default is what
	// matters for concurrent runs.
	var output @[]char
	if len(cli.BuildDir) > 0 {
		output = buf.Concat(cli.BuildDir, "/test_bin")
	} else {
		output = "/tmp/binate_test_bin"
	}
	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
	clangArgs = appendTargetFlags(clangArgs)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, output)
	for i := 0; i < len(oFiles); i++ {
		clangArgs = appendRawCharSlice(clangArgs, oFiles[i])
	}
	if !suppressHostRuntime && len(runtimePath) > 0 {
		clangArgs = appendRawCharSlice(clangArgs, runtimePath)
		var rtStubs @[]char = findRtStubs(runtimePath)
		if len(rtStubs) > 0 {
			clangArgs = appendRawCharSlice(clangArgs, rtStubs)
		}
		var libcStubs @[]char = findLibcStubs(runtimePath)
		if len(libcStubs) > 0 {
			clangArgs = appendRawCharSlice(clangArgs, libcStubs)
		}
	}
	clangArgs = appendTargetRuntime(clangArgs, root)
	for i := 0; i < len(linkAfterObjs); i++ {
		clangArgs = appendRawCharSlice(clangArgs, linkAfterObjs[i])
	}

	debug.Log("linking test binary")
	var linkExit int = bootstrap.Exec("clang", clangArgs)
	if !cli.KeepObjs {
		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
	}
	if linkExit != 0 {
		println("error: link failed")
		bootstrap.Exit(1)
	}

	// Output the test binary path
	println(output)
}

// registerTestRunnerImports is like registerMainImports but uses the merged
// file (including _test.bn) for test packages, so Test* function signatures
// are available to the runner.
func registerTestRunnerImports(ldr @loader.Loader,
		file @ast.File, mod @ir.Module, root *[]readonly char,
		testPkgs *[]@[]char) {
	registerAllStructTypes(ldr, root)

	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	if len(file.Imports) > 0 {
		for i := 0; i < len(file.Imports); i++ {
			var impPath @[]char = unquote(file.Imports[i].Path)
			var depFile @ast.File = nil
			// For test packages, use merged file (includes _test.bn)
			if isTestPkg(impPath, testPkgs) {
				var pkg @loader.Package = ldr.GetPackage(impPath)
				if pkg != nil && pkg.Merged != nil {
					depFile = pkg.Merged
				}
			}
			if depFile == nil {
				depFile = collectPkgFile(ldr, impPath, root)
			}
			if depFile != nil {
				aliases = slices.Append[@[]char](aliases, shortName(impPath))
				paths = slices.Append[@[]char](paths, impPath)
				files = slices.Append[@ast.File](files, depFile)
			}
		}
	}

	appendRtImport(ldr, root, &aliases, &paths, &files)
	appendBootstrapImport(ldr, root, &aliases, &paths, &files)
	appendLangImport(ldr, root, &aliases, &paths, &files)
	ir.RegisterImports(aliases, paths, files, mod)
}

// isTestPkg returns true if path is one of the test package paths.
func isTestPkg(path *[]readonly char, testPkgs *[]@[]char) bool {
	for i := 0; i < len(testPkgs); i++ {
		if streq(path, testPkgs[i]) { return true }
	}
	return false
}

// TestFunc identifies one Test* function discovered during -test mode:
// its source package (PkgPath) and the function's name (FuncName).
// Both fields hold managed-slice copies; safe to outlive the loader.
type TestFunc struct {
	PkgPath  @[]char
	FuncName @[]char
}

// hasPrefix returns true if s starts with prefix.
func hasPrefix(s *[]readonly char, prefix *[]readonly char) bool {
	if len(s) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return false }
	}
	return true
}

// isTestResultReturn checks if a decl returns testing.TestResult,
// a local alias to @[]char (so `pkg/builtins/testing/testing_test.bn`
// can return `TestResult` unqualified and still be picked up), or
// the underlying `@[]char` shape directly. `decls` is the package's
// merged decl list, walked to resolve unqualified aliases.
func isTestResultReturn(d @ast.Decl, decls @[]@ast.Decl) bool {
	if len(d.Results) != 1 { return false }
	var r @ast.TypeExpr = d.Results[0]
	if r.Kind == ast.TEXPR_NAMED && len(r.Pkg) > 0 {
		if streq(r.Pkg, "testing") && streq(r.Name, "TestResult") {
			return true
		}
	}
	if r.Kind == ast.TEXPR_NAMED && len(r.Pkg) == 0 {
		// Unqualified named type: resolve a single level of local
		// type alias and recheck.
		var target @ast.TypeExpr = lookupLocalTypeAlias(decls, r.Name)
		if target != nil { return isManagedCharSlice(target) }
	}
	return isManagedCharSlice(r)
}

// isManagedCharSlice reports whether r is the `@[]char` type
// expression — possibly after peeling outer parens (the AST doesn't
// generate paren wrappers today, but the guard is cheap).
func isManagedCharSlice(r @ast.TypeExpr) bool {
	if r == nil { return false }
	if r.Kind != ast.TEXPR_MANAGED_SLICE { return false }
	if r.Base == nil { return false }
	if r.Base.Kind != ast.TEXPR_NAMED { return false }
	return streq(r.Base.Name, "char")
}

// lookupLocalTypeAlias scans `decls` for `type <name> = <T>` and
// returns T's TypeExpr if found, or nil. Only follows one level —
// callers handle deeper chains by recursing on the result.
func lookupLocalTypeAlias(decls @[]@ast.Decl, name *[]readonly char) @ast.TypeExpr {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_TYPE { continue }
		if !d.IsAlias { continue }
		if !streq(d.Name, name) { continue }
		return d.TypeRef
	}
	return nil
}

// toBytes converts a char slice to a managed byte slice.
func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}
