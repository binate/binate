package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/codegen"
import "pkg/binate/debug"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/mangle"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/std/os"
import "pkg/std/os/process"
import "pkg/stdx/fmt"
import "pkg/stdx/slices"

// runTestMode compiles test packages into a test binary and runs it.
func runTestMode(cli CLIArgs) {
	if len(cli.Filenames) == 0 {
		fmt.Println("error: --test requires package paths (e.g. pkg/foo)")
		os.Exit(1)
	}
	if len(cli.BniPaths) == 0 {
		fmt.Println("error: --test requires -I <dir> to locate test packages")
		os.Exit(1)
	}

	// Set up loader with test packages enabled
	var ldr @loader.Loader = loader.NewLoader()
	applyPathFlags(ldr, cli)
	// Set arch/os for #[build(...)] gating from the active target (baked-in
	// host or --target key), matching the program-compile path in main.bn.
	ldr.BuildConfig = activeBuildConfig(cli.Target)
	for i := 0; i < len(cli.Filenames); i++ {
		ldr.TestPackages = slices.Append[@[]char](ldr.TestPackages, buf.CopyStr(cli.Filenames[i]))
	}

	// Load test packages and their dependencies
	debug.Log("phase: load")
	var syntheticImports @[]@ast.ImportSpec
	for i := 0; i < len(cli.Filenames); i++ {
		var imp @ast.ImportSpec = make(ast.ImportSpec)
		imp.Path = quotePath(cli.Filenames[i])
		syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	}
	ldr.LoadImports(syntheticImports)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			fmt.Println(ldr.Errors[i])
		}
		os.Exit(1)
	}
	ensureRuntimeDepsLoaded(ldr)
	// Force-load the generated test runner's own stdlib dependencies so
	// they compile + link into the test binary even when no test package
	// imports them.  The runner is parsed after typecheck, so its imports
	// must be loaded up front — see [B] / testRunnerStdlibImports.
	var runnerStdlib @[]@[]char = testRunnerStdlibImports()
	for ri := 0; ri < len(runnerStdlib); ri++ {
		var stdlibSynth @[]@ast.ImportSpec
		var stdlibImp @ast.ImportSpec = make(ast.ImportSpec)
		stdlibImp.Path = quotePath(runnerStdlib[ri])
		stdlibSynth = slices.Append[@ast.ImportSpec](stdlibSynth, stdlibImp)
		ldr.LoadImports(stdlibSynth)
	}
	// Surface any loader error from the runner-stdlib force-load (a cycle /
	// parse error / missing package in pkg/std/errors or its deps) — this loop
	// runs after the error check above, so without this it would be swallowed
	// (same class as the ensureXLoaded gap this complements).
	failOnLoaderErrors(ldr)

	// Type check all loaded packages
	debug.Log("phase: typecheck")
	var checker @types.Checker = typecheckPackages(ldr)
	debug.Log("phase: post-typecheck")

	// Discover Test* functions in test packages
	var testFuncs @[]TestFunc
	for pi := 0; pi < len(cli.Filenames); pi++ {
		var pkgPath @[]char = cli.Filenames[pi]
		var pkg @loader.Package = ldr.GetPackage(pkgPath)
		if pkg == nil || pkg.Merged == nil {
			fmt.Print("warning: no implementation for ", pkgPath, "\n")
			continue
		}
		for di := 0; di < len(pkg.Merged.Decls); di++ {
			var d @ast.Decl = pkg.Merged.Decls[di]
			if d.Kind != ast.DECL_FUNC { continue }
			if d.Body == nil { continue }
			if !hasPrefix(d.Name, "Test") { continue }
			if len(d.Params) != 0 { continue }
			if !isTestResultReturn(d, pkg.Merged.Decls) { continue }
			var tf TestFunc
			tf.PkgPath = pkgPath
			tf.FuncName = d.Name
			testFuncs = slices.Append[TestFunc](testFuncs, tf)
		}
	}

	// Generate synthetic test runner main
	var runnerSrc @[]char = genTestRunner(cli.Filenames, testFuncs)
	debug.Log("generated test runner")

	var rp @parser.Parser = parser.New(toBytes(runnerSrc), "test_runner.bn")
	var runnerFile @ast.File = rp.ParseFile()
	var runnerErrors @[]parser.ParseError = rp.Errors()
	if len(runnerErrors) > 0 {
		fmt.Println("error: test runner parse failed:")
		for i := 0; i < len(runnerErrors); i++ {
			fmt.Println(runnerErrors[i].Msg)
		}
		if cli.Verbose {
			fmt.Println("--- generated source ---")
			fmt.Println(runnerSrc)
			fmt.Println("--- end ---")
		}
		os.Exit(1)
	}

	// Expose each discovered test function into its package's checker scope, then
	// type-check the generated runner.  IR-gen reads the checker's per-expression
	// resolved types (Checker.ExprType) — in particular the `*any` boxing of a
	// fmt operand reads the operand's resolved type to decide what to box — but
	// the runner is generated AFTER typecheckPackages, so without this its
	// expressions carry no resolved type and a string literal would box as its
	// `char` element instead of a `*[]readonly char` slice.  The whole-program
	// driver checks its main file identically (typecheckAll).  Exposing the test
	// funcs first is what lets the check resolve the runner's `pkg.TestName()`
	// calls, since test funcs live in `_test.bn` and are absent from the .bni.
	for ti := 0; ti < len(testFuncs); ti++ {
		checker.ExposeTestFunc(testFuncs[ti].PkgPath, testFuncs[ti].FuncName)
	}
	checker.Check(runnerFile)
	var runnerCheckErrs @[]types.CheckError = checker.CheckerErrors()
	if len(runnerCheckErrs) > 0 {
		fmt.Println("error: generated test runner failed type checking:")
		for i := 0; i < len(runnerCheckErrs); i++ {
			fmt.Println(types.FormatCheckError(runnerCheckErrs[i]))
		}
		os.Exit(1)
	}

	// Intermediate prefix: "<build-dir>/" or "/tmp/binate_test_".
	var outPrefix @[]char = outPrefixFor(cli.BuildDir, "test")
	var useNative bool = streq(cli.Backend, "native")

	// Compile dependency packages. Per-module backend dispatch:
	// LLVM (default) emits .ll → clang → .o; native emits Mach-O .o
	// directly via pkg/binate/native. Both produce objects clang can link.
	var oFiles @[]@[]char
	// Track which test packages emit a `<pkg>.__init` so the test
	// runner module's init dispatcher can include them. Mirrors the
	// non-test compile loop in main.bn — without this the entry
	// wrapper's __init_all() call would skip per-package var
	// initializers.
	var initPkgNames @[]@[]char
	if len(ldr.Order) > 0 {
		for i := 0; i < len(ldr.Order); i++ {
			var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
			if pkg == nil || pkg.Merged == nil { continue }
			debug.Log(buf.Concat("phase: compile-dep-irgen ", ldr.Order[i]))
			var mod @ir.Module = ir.InitModule(quotePath(ldr.Order[i]))
			mod.Checker = checker
			var gc @ir.GenCtx = ir.NewGenCtx(mod)
			registerPkgImports(ldr, pkg, gc)
			if pkg.BNI != nil { ir.RegisterSelfTypes(checker, pkg.BNI, gc) }
			ir.GeneratePackage(checker, pkg.Merged, gc, pkg.Files)
			if mod.HasPackageInit() {
				initPkgNames = appendRawCharSlice(initPkgNames,
						ir.PackageInitName(
								mangle.PkgPathFromQuoted(ldr.Order[i])))
			}
			debug.Log(buf.Concat("phase: compile-dep-emit ", ldr.Order[i]))
			// Use the full-path-derived filename so two packages
			// sharing a last-segment short name don't clobber each
			// other's .o in --build-dir.
			var oFile @[]char = compileModuleVia(mod, outPrefix, pathFileBase(ldr.Order[i]), useNative)
			if len(oFile) == 0 {
				fmt.Println("error: native backend failed to emit object")
				os.Exit(1)
			}
			oFiles = appendRawCharSlice(oFiles, oFile)
		}
	}

	// Compile test runner main
	debug.Log("phase: runner-irgen")
	var mainMod @ir.Module = ir.InitModule("\"main\"")
	// Set the checker before registerTestRunnerImports: import registration
	// emits imported packages' __Package accessors via
	// reflectPackageStructType(mainMod.Checker), so a nil checker here would
	// silently skip them for the test runner.
	mainMod.Checker = checker
	var mainGc @ir.GenCtx = ir.NewGenCtx(mainMod)
	registerTestRunnerImports(ldr, runnerFile, mainGc, cli.Filenames)
	ir.GeneratePackage(checker, runnerFile, mainGc, make_slice(@ast.File, 0))
	// Test runner is a `main` package with its own `func main()`.
	// Emit `<main>.__init_all` (calls each per-package __init in
	// dep order) and `<main>.__entry` (the `bn_entry` linker
	// symbol) — same shape as cmd/bnc/main.bn's non-test path.
	// Without these, the C runtime's `bn_entry` extern doesn't
	// resolve and the test binary fails to link.
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()
	// Satisfaction-registry wiring — native-codegen driver only.  After
	// EmitMainEntry (it edits `__entry`).  See cmd/bnc/main.bn.
	mainMod.EmitSatRegistryWiring()

	if cli.EmitLLVM {
		// Bypasses compileModuleVia — run the opt passes here too.
		ir.RunOptPasses(mainMod, optLevel)
		var mainIR @[]char = codegen.EmitModule(mainMod)
		fmt.Print(mainIR)
		if !cli.KeepObjs {
			for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		}
		return
	}

	debug.Log("phase: runner-emit")
	var mainO @[]char = compileModuleVia(mainMod, outPrefix, "test_main", useNative)
	if len(mainO) == 0 {
		fmt.Println("error: native backend failed to emit test runner")
		os.Exit(1)
	}
	oFiles = appendRawCharSlice(oFiles, mainO)
	debug.Log("phase: link")

	// Link. With --build-dir, the binary defaults to <build-dir>/test_bin
	// (so it's cleaned up alongside the .o files); otherwise the legacy
	// /tmp/binate_test_bin path. -o on the command line still wins —
	// but the test harness doesn't pass -o, so this default is what
	// matters for concurrent runs.
	var output @[]char
	if len(cli.BuildDir) > 0 {
		output = buf.Concat(cli.BuildDir, "/test_bin")
	} else {
		output = "/tmp/binate_test_bin"
	}
	var clangArgs @[]@[]char
	clangArgs = appendRawCharSlice(clangArgs, "-w")
	if debugInfo { clangArgs = appendRawCharSlice(clangArgs, "-g") }
	clangArgs = appendTargetFlags(clangArgs)
	clangArgs = appendTargetLinkFlags(clangArgs, cli.Backend)
	for cf := 0; cf < len(extraClangFlags); cf++ {
		clangArgs = appendRawCharSlice(clangArgs, extraClangFlags[cf])
	}
	clangArgs = appendRawCharSlice(clangArgs, "-o")
	clangArgs = appendRawCharSlice(clangArgs, output)
	for i := 0; i < len(oFiles); i++ {
		clangArgs = appendRawCharSlice(clangArgs, oFiles[i])
	}
	// Bare-metal targets append their runtime inputs (crt0.s, semihost.s) + the
	// linker script here, resolved relative to dirOf(--runtime).  No-op on host
	// (--runtime is not linked; only its directory anchors the baremetal files).
	clangArgs = appendTargetRuntime(clangArgs, dirOf(cli.RuntimePath))
	for i := 0; i < len(linkAfterObjs); i++ {
		clangArgs = appendRawCharSlice(clangArgs, linkAfterObjs[i])
	}
	// A `.s` link input is Binate assembly (bare-metal crt0.s / semihost.s) —
	// assemble each in-process and link the resulting `.o` (clang stays the
	// linker, not the assembler); non-`.s` inputs pass through unchanged.
	// bnasObjs are the generated `.o` files, removed after the link.
	var bnasObjs @[]@[]char
	clangArgs, bnasObjs = assembleDotSArgs(clangArgs, cli.BuildDir, nativeArchForTarget())

	debug.Log("linking test binary")
	status, err := process.Run("clang", &process.Options{SearchPath: true, Args: clangArgs})
	if !cli.KeepObjs {
		for i := 0; i < len(oFiles); i++ { remove(oFiles[i]) }
		for i := 0; i < len(bnasObjs); i++ { remove(bnasObjs[i]) }
	}
	if present(err) || !status.Success() {
		fmt.Println("error: link failed")
		os.Exit(1)
	}

	// Output the test binary path
	fmt.Println(output)
}

// registerTestRunnerImports is like registerMainImports but uses the merged
// file (including _test.bn) for test packages, so Test* function signatures
// are available to the runner.
func registerTestRunnerImports(ldr @loader.Loader, file @ast.File, gc @ir.GenCtx,
		testPkgs *[]@[]char) {
	registerAllStructTypes(ldr, gc)

	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	var directImports @[]@[]char
	if len(file.Imports) > 0 {
		for i := 0; i < len(file.Imports); i++ {
			var impPath @[]char = buf.CopyStr(unquote(file.Imports[i].Path))
			directImports = slices.Append[@[]char](directImports, impPath)
			var depFile @ast.File = nil
			// For test packages, use merged file (includes _test.bn)
			if isTestPkg(impPath, testPkgs) {
				var pkg @loader.Package = ldr.GetPackage(impPath)
				if pkg != nil && pkg.Merged != nil {
					depFile = pkg.Merged
				}
			}
			if depFile == nil {
				depFile = collectPkgFile(ldr, impPath)
			}
			if depFile != nil {
				aliases = slices.Append[@[]char](aliases, impPath)
				paths = slices.Append[@[]char](paths, impPath)
				files = slices.Append[@ast.File](files, depFile)
			}
		}
	}

	appendRtImport(ldr, &aliases, &paths, &files)
	appendLangImport(ldr, &aliases, &paths, &files)
	appendExposeClosure(ldr, directImports, &aliases, &paths, &files)
	ir.RegisterImports(aliases, paths, files, gc)
}

// isTestPkg returns true if path is one of the test package paths.
func isTestPkg(path *[]readonly char, testPkgs *[]@[]char) bool {
	for i := 0; i < len(testPkgs); i++ {
		if streq(path, testPkgs[i]) { return true }
	}
	return false
}

// TestFunc identifies one Test* function discovered during -test mode:
// its source package (PkgPath) and the function's name (FuncName).
// Both fields hold managed-slice copies; safe to outlive the loader.
type TestFunc struct {
	PkgPath  @[]char
	FuncName @[]char
}

// hasPrefix returns true if s starts with prefix.
func hasPrefix(s *[]readonly char, prefix *[]readonly char) bool {
	if len(s) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return false }
	}
	return true
}

// isTestResultReturn reports whether decl d returns the distinct named type that
// marks a `Test*` function as a test.  The canonical type is
// pkg/builtins/testing/sys.TestResult; pkg/builtins/testing re-exports it as the
// alias `testing.TestResult`.  Three spellings resolve to it: qualified
// `testing.TestResult` (packages that import testing), qualified `sys.TestResult`
// (packages that import testing/sys directly — e.g. pkg/builtins/lang's own tests,
// which name the type without closing the `testing -> lang -> testing` cycle), and
// a bare `TestResult` inside a package that declares the type locally (testing's
// own _test files).  Because TestResult is a distinct type — not a `= @[]char`
// alias — returning a bare `@[]char` (or anything else) is not a test result: the
// label is explicit and type-checked, so a `Test*`-named helper returning a plain
// char slice is not misdiscovered as a test.
//
// TODO(discovery-robustness): match by resolving the return type through the
// checker to the canonical named type instead of the "testing"/"sys"/"TestResult"
// spelling — that would tolerate an aliased import name and not hard-code the two
// package names.  See explorations/claude-todo.md.
func isTestResultReturn(d @ast.Decl, decls @[]@ast.Decl) bool {
	if len(d.Results) != 1 { return false }
	var r @ast.TypeExpr = d.Results[0]
	if r == nil { return false }
	if r.Kind != ast.TEXPR_NAMED { return false }
	if !streq(r.Name, "TestResult") { return false }
	if len(r.Pkg) > 0 {
		return streq(r.Pkg, "testing") || streq(r.Pkg, "sys")
	}
	return hasLocalTestResultType(decls)
}

// hasLocalTestResultType reports whether decls declares `type TestResult`.
// Gates acceptance of a bare `TestResult` return so it matches only inside
// pkg/builtins/testing itself, where the type is in scope unqualified.
func hasLocalTestResultType(decls @[]@ast.Decl) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_TYPE { continue }
		if streq(d.Name, "TestResult") { return true }
	}
	return false
}

// toBytes converts a char slice to a managed byte slice.
func toBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}
