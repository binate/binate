package "main"

import "pkg/binate/optflags"
import "pkg/builtins/testing"

// The placement and block-layout switches are measurement aids: they stay out of
// the usage text and out of the IR pass list --list-opt-passes prints.

func TestUsageTextOmitsHiddenNativeSwitches() testing.TestResult {
	var text *[]readonly char = usageText()
	if !containsStr(text, "usage:") { return "usageText has no usage line" }
	if containsStr(text, "native-place") { return "usageText lists a -fnative-place-* switch" }
	if containsStr(text, "native-block-layout") { return "usageText lists -fnative-block-layout" }
	if containsStr(text, "x64-rax-home") { return "usageText lists -fx64-rax-home" }
	return ""
}

func TestPassListOmitsHiddenNativeSwitches() testing.TestResult {
	var list @[]char = optflags.PassList()
	if len(list) == 0 { return "optflags.PassList is empty" }
	if containsStr(list, "native-place") { return "the IR pass list names a -fnative-place-* switch" }
	if containsStr(list, "native-block-layout") {
		return "the IR pass list names -fnative-block-layout"
	}
	if containsStr(list, "x64-rax-home") { return "the IR pass list names -fx64-rax-home" }
	return ""
}
