package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/loader"
import "pkg/bootstrap"
import "pkg/stdx/slices"

// ============================================================
// Utility functions
// ============================================================

// printUsage prints the compiler usage and flag documentation.
func printUsage() {
	print(
		"usage: binate compile.bn -- [flags] <file.bn|dir>\n"
		"       binate compile.bn -- --pkg <path> -I <dir> -L <dir> [flags]\n"
		"flags:\n"
		"  -o <name>         output name\n"
		"  -c                compile to .o files only, don't link\n"
		"  --pkg <path>      compile a single package\n"
		"  --emit-llvm       print LLVM IR to stdout\n"
		"  --runtime <path>  path to binate_runtime.c\n"
		"  -I, --interface-path <dirs>\n"
		"                    colon-separated dirs searched for `.bni` files\n"
		"                    (repeatable; later flags append)\n"
		"  -L, --impl-path <dirs>\n"
		"                    colon-separated dirs searched for impl dirs\n"
		"                    (containing `.bn` files; repeatable)\n"
		"  --target <key>    target layout: host (default), arm32-linux,\n"
		"                    arm32-baremetal\n"
		"  -g, --debug       emit DWARF debug info\n"
		"  -v, --verbose     verbose logging\n")
}

// stripExt removes the file extension from a path. Returns a managed-slice
// that shares backing with the input — input must outlive the result.
func stripExt(path @[]char) @[]char {
	var start int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			start = i + 1
		}
	}
	var dot int = -1
	for i := start; i < len(path); i++ {
		if path[i] == '.' {
			dot = i
		}
	}
	if dot > start {
		return path[:dot]
	}
	return path
}

// findRtStubs looks for rt_stubs.c alongside the runtime file.
func findRtStubs(runtimePath *[]readonly char) @[]char {
	return findStubsFile(runtimePath, "rt_stubs.c")
}

// findLibcStubs looks for libc_stubs.c alongside the runtime file and
// links it if present.  The checkout's rt now calls libc directly via
// __c_call, so the checkout ships no libc_stubs.c — this returns empty
// and nothing is linked.  Retained for transitional BUILDER runtimes
// whose prebuilt rt still references the bn_pkg__libc__* forwards; once
// BUILDER is rebuilt past the __c_call switch this is vestigial.
func findLibcStubs(runtimePath *[]readonly char) @[]char {
	return findStubsFile(runtimePath, "libc_stubs.c")
}

// findStubsFile looks for the named C file alongside the runtime file.
func findStubsFile(runtimePath *[]readonly char, name *[]readonly char) @[]char {
	var dir *[]readonly char = dirOf(runtimePath)
	var candidate @[]char
	if len(dir) > 0 {
		candidate = buf.Concat(buf.Concat(dir, "/"), name)
	} else {
		candidate = buf.CopyStr(name)
	}
	if bootstrap.Stat(candidate) == 1 {
		return candidate
	}
	var empty @[]char
	return empty
}

// discoverBinateRoot derives the binate project root from the runtime path.
// If runtimePath is ".../runtime/binate_runtime.c", the root is two levels up.
func discoverBinateRoot(runtimePath *[]readonly char) *[]readonly char {
	if len(runtimePath) == 0 {
		var empty *[]readonly char
		return empty
	}
	var runtimeDir *[]readonly char = dirOf(runtimePath)
	if len(runtimeDir) == 0 {
		var empty *[]readonly char
		return empty
	}
	return dirOf(runtimeDir)
}

// ensureRtLoaded loads pkg/builtins/rt into the loader if not already present.
func ensureRtLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/rt") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/rt\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}

// ensureBootstrapLoaded loads pkg/bootstrap into the loader if not
// already present. The compiler emits direct calls to certain
// pkg/bootstrap functions (e.g. format helpers + Write for the
// print/println builtin) regardless of whether user code imports
// pkg/bootstrap, so it must always be linked.
func ensureBootstrapLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/bootstrap") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/bootstrap\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}

// ensureReflectLoaded loads pkg/builtins/reflect into the loader if not
// already present.  The compiler synthesizes a `_Package() @reflect.Package`
// accessor for every package (Phase B of notes-package-introspection.md),
// whose return type references reflect.Package — so the type checker must
// always have reflect available to resolve it, regardless of whether user
// code imports reflect.  reflect is a .bni-only type package (no impl to
// link), so force-loading it costs only the type registration.
func ensureReflectLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/reflect") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/reflect\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}

// findRuntime searches for binate_runtime.c relative to the input file.
func findRuntime(inputFile *[]readonly char) @[]char {
	var dir *[]readonly char = dirOf(inputFile)
	var suffixes @[]@[]char = @[]@[]char{
		"runtime/binate_runtime.c",
		"../runtime/binate_runtime.c",
		"../../runtime/binate_runtime.c"}

	for i := 0; i < len(suffixes); i++ {
		var candidate @[]char
		if len(dir) > 0 {
			candidate = buf.Concat(buf.Concat(dir, "/"), suffixes[i])
		} else {
			candidate = suffixes[i]
		}
		if bootstrap.Stat(candidate) == 1 {
			return candidate
		}
	}
	for i := 0; i < len(suffixes); i++ {
		if bootstrap.Stat(suffixes[i]) == 1 {
			return suffixes[i]
		}
	}
	var empty @[]char
	return empty
}

// dirOf returns the directory portion of a path, or empty if none.
func dirOf(path *[]readonly char) *[]readonly char {
	var last int = -1
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i
		}
	}
	if last < 0 {
		var empty *[]readonly char
		return empty
	}
	return path[:last]
}

// readFile reads an entire file into a managed byte slice.
func readFile(path *[]readonly char) @[]uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int = bootstrap.Read(fd, tmp)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	bootstrap.Close(fd)
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// writeFile writes a char slice to the file at path.
func writeFile(path *[]readonly char, data *[]readonly char) {
	var fd int = bootstrap.Open(path, bootstrap.O_WRONLY + bootstrap.O_CREATE + bootstrap.O_TRUNC)
	if fd < 0 {
		print("error: cannot write ")
		println(path)
		bootstrap.Exit(1)
	}
	var buf @[]uint8 = make_slice(uint8, len(data))
	for i := 0; i < len(data); i++ {
		buf[i] = cast(uint8, data[i])
	}
	bootstrap.Write(fd, buf)
	bootstrap.Close(fd)
}

// remove deletes the file at path via rm.
func remove(path *[]readonly char) {
	var args @[]@[]char
	args = appendRawCharSlice(args, path)
	bootstrap.Exec("rm", args)
}

// shortName returns the last path component (after the final '/').
func shortName(path @[]char) @[]char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i + 1
		}
	}
	return path[last:]
}

// pathFileBase returns an identifier-safe filename base for a
// package path: each `/` becomes `__`, so two packages with the
// same last-segment short name (`pkg/alpha/widget`,
// `pkg/beta/widget`) produce distinct intermediate filenames
// (`pkg__alpha__widget.o` vs `pkg__beta__widget.o`) instead of
// colliding and clobbering each other in --build-dir.
func pathFileBase(path *[]readonly char) @[]char {
	var b buf.CharBuf = buf.New()
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			b = b.WriteStr("__")
		} else {
			b = b.WriteByte(path[i])
		}
	}
	return b.Bytes()
}

// quotePath wraps a path in double quotes.
func quotePath(path *[]readonly char) @[]char {
	var b buf.CharBuf = buf.New()
	b = b.WriteByte('"')
	b = b.WriteStr(path)
	b = b.WriteByte('"')
	return b.Bytes()
}

// unquote strips surrounding double quotes from a string.
func unquote(s @[]char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// streq returns true if two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// expandDirArgs expands directory arguments into .bn files (excluding _test.bn).
func expandDirArgs(args @[]@[]char) @[]@[]char {
	var result @[]@[]char
	for i := 0; i < len(args); i++ {
		var st int = bootstrap.Stat(args[i])
		if st != 2 {
			result = appendRawCharSlice(result, args[i])
		} else {
			var entries @[]@[]char = bootstrap.ReadDir(args[i])
			if len(entries) == 0 {
				print("error: cannot read directory ")
				println(args[i])
				bootstrap.Exit(1)
			}
			for j := 0; j < len(entries); j++ {
				if hasSuffix(entries[j], ".bn") && !hasSuffix(entries[j], "_test.bn") {
					var path @[]char = buf.Concat(
						buf.Concat(args[i], "/"), entries[j])
					result = appendRawCharSlice(result, path)
				}
			}
		}
	}
	return result
}

// hasSuffix returns true if s ends with suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(s) < len(suffix) { return false }
	var offset int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[offset + i] != suffix[i] { return false }
	}
	return true
}

// applyPathFlags appends -I / --interface-path entries to the loader's
// BniPath and -L / --impl-path entries to its ImplPath. CLI-supplied
// paths come AFTER the primary-root-derived paths, so the per-flag
// list extends (rather than replaces) the root-derived defaults.
//
// Target-specific impl-path overrides (set by applyTarget — e.g.
// arm32-baremetal swaps in runtime/baremetal_arm32) are PREPENDED
// to the loader's impl-path so they win over the default root's
// libc-host impls (first-match-wins in the loader's lookup).
// `root` is the binate source root; target-relative suffixes
// resolve against it.
func applyPathFlags(ldr @loader.Loader, cli CLIArgs, root *[]readonly char) {
	for i := 0; i < len(targetImplPathSuffixes); i++ {
		var abs @[]char = buf.Concat(
			buf.Concat(root, "/"),
			targetImplPathSuffixes[i])
		ldr.AddBniPathFront(abs)
		ldr.AddImplPathFront(abs)
	}
	for i := 0; i < len(cli.BniPaths); i++ {
		ldr.AddBniPath(cli.BniPaths[i])
	}
	for i := 0; i < len(cli.ImplPaths); i++ {
		ldr.AddImplPath(cli.ImplPaths[i])
	}
}

// splitColon splits a string on ':' (POSIX PATH style). Empty entries
// are dropped, so "A::B" yields ["A", "B"] and a trailing colon is
// benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]readonly char) @[]@[]char {
	var out @[]@[]char
	if len(s) == 0 { return out }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out = slices.Append[@[]char](out, part)
			}
			start = i + 1
		}
	}
	return out
}

// appendRawCharSlice copies a raw char slice v into a managed
// `@[]char` (via buf.CopyStr) and appends it to s.  The CopyStr is
// load-bearing — callers pass string literals and other *raw* slices
// whose backing isn't owned by the destination, so the managed-slice
// element has to own its own copy.  Not foldable into
// slices.Append[T] because of this side-effecting copy.
func appendRawCharSlice(s @[]@[]char, v *[]readonly char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = buf.CopyStr(v)
	return ns
}
