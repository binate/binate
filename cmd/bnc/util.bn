package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/loader"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/stdx/slices"

// ============================================================
// Utility functions
// ============================================================

// printUsage prints the compiler usage and flag documentation.
func printUsage() {
	fmt.Print(
			"usage: binate compile.bn -- [flags] <file.bn|dir>\n"
					"       binate compile.bn -- --pkg <path> -I <dir> -L <dir> [flags]\n"
					"flags:\n"
					"  -o <name>         output name\n"
					"  -c                compile to .o files only, don't link\n"
					"  --pkg <path>      compile a single package\n"
					"  --emit-llvm       print LLVM IR to stdout\n"
					"  -I, --interface-path <dirs>\n"
					"                    colon-separated dirs searched for `.bni` files\n"
					"                    (repeatable; later flags append)\n"
					"  -L, --impl-path <dirs>\n"
					"                    colon-separated dirs searched for impl dirs\n"
					"                    (containing `.bn` files; repeatable)\n"
					"  --target <key>    target layout: host (default), arm32-linux,\n"
					"                    arm32-baremetal\n"
					"  -g, --debug       emit DWARF debug info\n"
					"  -v, --verbose     verbose logging\n"
					"environment (a search path is used when its flag is absent):\n"
					"  BINATE_PACKAGE_INTERFACE_PATH  (alias BINATE_BNI_PATH)   like -I\n"
					"  BINATE_PACKAGE_IMPL_PATH       (alias BINATE_IMPL_PATH)  like -L\n")
}

// stripExt removes the file extension from a path. Returns a managed-slice
// that shares backing with the input — input must outlive the result.
func stripExt(path *[]readonly char) *[]readonly char {
	var start int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			start = i + 1
		}
	}
	var dot int = -1
	for i := start; i < len(path); i++ {
		if path[i] == '.' {
			dot = i
		}
	}
	if dot > start {
		return path[:dot]
	}
	return path
}

// failOnLoaderErrors prints any accumulated loader errors and exits.
// The force-load helpers below call this immediately after their own
// LoadImports so a load error (import cycle per facet-H, parse error, or
// missing package) in a force-loaded subtree is surfaced regardless of
// whether the caller already ran the driver's loader-error check before
// the force-load (otherwise such an error would be silently swallowed and
// compilation would proceed on a broken loader state).  The shape mirrors
// the driver's existing checks (e.g. compile.bn) so output is consistent.
func failOnLoaderErrors(ldr @loader.Loader) {
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			fmt.Println(ldr.Errors[i])
		}
		os.Exit(1)
	}
}

// ensureRtLoaded loads pkg/builtins/rt into the loader if not already present.
func ensureRtLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/rt") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/rt\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
	failOnLoaderErrors(ldr)
}

// ensureReflectLoaded loads pkg/builtins/reflect into the loader if not
// already present.  The compiler synthesizes a `__Package() @reflect.Package`
// accessor for every package, whose return type references
// reflect.Package — so the type checker must
// always have reflect available to resolve it, regardless of whether user
// code imports reflect.  reflect is a .bni-only type package (no impl to
// link), so force-loading it costs only the type registration.
func ensureReflectLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/reflect") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/reflect\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
	failOnLoaderErrors(ldr)
}

// ensureLangLoaded loads pkg/builtins/lang into the loader if not already
// present.  lang declares the canonical Stringer / Comparable impls for
// the universe primitives (`int.String()`, etc.); loading it runs their
// AddMethod, which attaches those methods to the global primitive type
// singletons.  Force-loading makes `myInt.String()` resolve and link
// without the caller importing lang — only NAMING the `lang.Stringer`
// interface type still needs the import (the `lang.` qualifier resolves
// against the file's own imports, which a force-load doesn't touch).
// Unused impls are dropped at link by --gc-sections / -dead_strip, so
// this costs nothing in a program that never formats a primitive.
func ensureLangLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/lang") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/lang\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
	failOnLoaderErrors(ldr)
}

// ensureStartupLoaded force-loads pkg/builtins/startup — the platform
// entry/startup glue package, force-included in
// every hosted link (like rt/lang).  It hosts the command-line-arg
// seam (`Args`/`SetArgs`, which os re-exports); the remaining entry glue (the
// hosted `main`, baremetal `_start`) comes later, once a BUILDER that
// force-includes `startup` is pinned (the entry `main` is the program root,
// force-included, so it needs BUILDER's force-load set to carry `startup` — the
// arg seam does not, it rides os's import of startup).  Force-loading here keeps
// `startup` in every hosted binary even when nothing imports os.
func ensureStartupLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/startup") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/startup\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
	failOnLoaderErrors(ldr)
}

// ensureSoftfloatLoaded loads pkg/builtins/softfloat on the soft-float
// arm32-baremetal target, whose functions back the __aeabi_* soft-float helper
// symbols (via the bnas shims in runtime/baremetal_arm32/aeabi_float.s) — the
// C-free replacement for libgcc.a's soft-float.  Hardware-float targets (x64 /
// aarch64 / arm32-linux VFP) need no soft-float, so it is not loaded there.  It
// declares functions only (zero satentries), so — like reflect / startup — it
// needs no import-edge injection into every module.
func ensureSoftfloatLoaded(ldr @loader.Loader) {
	if ldr.BuildConfig == nil { return }
	if !streq(ldr.BuildConfig.Arch, "arm32") { return }
	if !streq(ldr.BuildConfig.OS, "baremetal") { return }
	if ldr.GetPackage("pkg/builtins/softfloat") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/softfloat\""
	syntheticImports = slices.Append[@ast.ImportSpec](syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
	failOnLoaderErrors(ldr)
}

// ensureRuntimeDepsLoaded force-loads every package the compiler implicitly
// depends on: rt (bounds/div/shift checks, refcount ops), reflect (the
// synthesized `__Package()` accessor + per-package reflect Functions table),
// lang (builtin-type methods
// like `myInt.String()`), and startup (the platform entry/startup glue — the
// command-line-arg seam today, the entry `main` later).  EVERY compile entry
// point — the whole-program driver,
// `--test`, and `--pkg` single-package compilation — must call this before
// type-checking, so any package that references a runtime helper registers it as
// a module extern and codegen emits the matching `declare`.  Centralizing the
// set here (rather than repeating the calls at each site) is deliberate: a prior
// drift — `--pkg` loading only reflect — silently dropped the others, so `--pkg`
// produced malformed IR (an undeclared `rt.BoundsCheck` call) for any package
// that indexed a slice.
//
// INVARIANT (satentry graph): a force-loaded package here enters the driver's
// package set, but is a node in the decentralized `_pkg_satfrag` graph that
// rt.BuildSatRegistry walks ONLY if it is reachable via an import edge — the walk
// starts at main and follows each package's imports (m.ImportAliasPaths).  rt and
// lang carry satentries AND are injected as an import edge into every module
// (compile_imports.bn appendRtImport / appendLangImport), so their satentries
// register.  reflect and startup are safe ONLY because they carry zero satentries
// (an orphan node with no in-edge is harmlessly unreached).  A future force-load
// that carries satentries but is NOT injected as an import edge would be silently
// dropped by the walk — inject it as an edge (as rt/lang are) if so.
func ensureRuntimeDepsLoaded(ldr @loader.Loader) {
	ensureRtLoaded(ldr)
	ensureReflectLoaded(ldr)
	ensureLangLoaded(ldr)
	ensureStartupLoaded(ldr)
	ensureSoftfloatLoaded(ldr)
}

// dirOf returns the directory portion of a path, or empty if none.
func dirOf(path *[]readonly char) *[]readonly char {
	var last int = -1
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i
		}
	}
	if last < 0 {
		var empty *[]readonly char
		return empty
	}
	return path[:last]
}

// readFile reads an entire file into a managed byte slice.
func readFile(path *[]readonly char) @[]uint8 {
	f, oerr := os.Open(path)
	if present(oerr) {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		n, _ := f.Read(tmp)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	_ = f.Close()
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// writeFile writes a char slice to the file at path.
func writeFile(path *[]readonly char, data *[]readonly char) {
	f, oerr := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(oerr) {
		fmt.Print("error: cannot write ", path, "\n")
		os.Exit(1)
	}
	var buf @[]uint8 = make_slice(uint8, len(data))
	for i := 0; i < len(data); i++ {
		buf[i] = cast(uint8, data[i])
	}
	_, _ = f.Write(buf)
	_ = f.Close()
}

// remove deletes the file at path, tolerant of a missing file — removing a
// not-yet-existing output (e.g. a fresh --library archive before rebuilding it)
// is a no-op, not an error.  os.Remove returns an error for a missing path,
// which is intentionally discarded: this helper's contract is `rm -f`, a
// best-effort delete, not a checked one.
func remove(path *[]readonly char) {
	_ = os.Remove(path)
}

// shortName returns the last path component (after the final '/').
func shortName(path *[]readonly char) *[]readonly char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i + 1
		}
	}
	return path[last:]
}

// pathFileBase returns an identifier-safe filename base for a package path, used
// to name each package's intermediate object (and archive member, for
// --library) in --build-dir.  The mapping must be INJECTIVE — two distinct
// package paths must never produce the same base — or one package's object
// silently clobbers another's (a wrong/broken artifact).
//
// Each `/` becomes `__` (so `pkg/alpha/widget` and `pkg/beta/widget` get
// distinct `pkg__alpha__widget` vs `pkg__beta__widget`), AND each literal `_`
// becomes `_U`.  Escaping `_` is what makes the mapping injective: without it,
// `a/b` → `a__b` and a literal `a__b` both mapped to `a__b`.  With it, every `_`
// in the output is either the first char of a `__` pair (a former `/`) or the
// `_U` escape (a former literal `_`) — the two are told apart by the following
// char (`_` vs `U`), so no two distinct paths share an output.
func pathFileBase(path *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			b.Write("__")
		} else if path[i] == '_' {
			b.Write("_U")
		} else {
			b.WriteByte(path[i])
		}
	}
	return buf.CopyStr(b.String())
}

// quotePath wraps a path in double quotes.
func quotePath(path *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('"')
	b.Write(path)
	b.WriteByte('"')
	return buf.CopyStr(b.String())
}

// unquote strips surrounding double quotes from a string.
func unquote(s *[]readonly char) *[]readonly char {
	if len(s) >= 2 && s[0] == '"' && s[len(s) - 1] == '"' {
		return s[1:len(s) - 1]
	}
	return s
}

// streq returns true if two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// expandDirArgs expands directory arguments into .bn files (excluding _test.bn).
func expandDirArgs(args @[]@[]char) @[]@[]char {
	var result @[]@[]char
	for i := 0; i < len(args); i++ {
		fi, serr := os.Stat(args[i])
		if present(serr) || !fi.IsDir() {
			result = appendRawCharSlice(result, args[i])
		} else {
			dents, rderr := os.ReadDir(args[i])
			// os.ReadDir keeps dot-prefixed names, so reduce to the visible
			// (non-dot) entries — a hidden file (e.g. a stray ".foo.bn") must
			// not be taken as a package source.  An empty result aborts: a
			// directory argument with no visible entries is a usage error.
			var visible @[]@[]char
			if !present(rderr) {
				for j := 0; j < len(dents); j++ {
					var dnm @[]readonly char = dents[j].Name()
					if len(dnm) > 0 && dnm[0] == '.' { continue }
					visible = slices.Append[@[]char](visible, buf.CopyStr(dnm[0:len(dnm)]))
				}
			}
			if present(rderr) || len(visible) == 0 {
				fmt.Print("error: cannot read directory ", args[i], "\n")
				os.Exit(1)
			}
			for j := 0; j < len(visible); j++ {
				var name @[]char = visible[j]
				if hasSuffix(name, ".bn") && !hasSuffix(name, "_test.bn") {
					var path @[]char = buf.Concat(buf.Concat(args[i], "/"), name)
					result = appendRawCharSlice(result, path)
				}
			}
		}
	}
	return result
}

// hasSuffix returns true if s ends with suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(s) < len(suffix) { return false }
	var offset int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[offset + i] != suffix[i] { return false }
	}
	return true
}

// applyPathFlags appends -I / --interface-path entries to the loader's
// BniPath and -L / --impl-path entries to its ImplPath, in the order
// they were given on the command line.  Target-specific impl/iface
// overrides (e.g. arm32-baremetal's baremetal impls) are themselves
// expressed as -I / -L entries by the caller (binate-paths --target),
// so there is no separate root-derived prepend here.
func applyPathFlags(ldr @loader.Loader, cli CLIArgs) {
	for i := 0; i < len(cli.BniPaths); i++ {
		ldr.AddBniPath(cli.BniPaths[i])
	}
	for i := 0; i < len(cli.ImplPaths); i++ {
		ldr.AddImplPath(cli.ImplPaths[i])
	}
}

// splitColon splits a string on ':' (POSIX PATH style). Empty entries
// are dropped, so "A::B" yields ["A", "B"] and a trailing colon is
// benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]readonly char) @[]@[]char {
	var out @[]@[]char
	if len(s) == 0 { return out }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out = slices.Append[@[]char](out, part)
			}
			start = i + 1
		}
	}
	return out
}

// envPathList selects the effective env-derived search path for one of the two
// package paths.  The long/primary form wins over the short alias: if the
// primary env var was SET (present, even to the empty string) its value is used
// and the alias is not consulted; else the alias's value if it was set; else no
// entries.  The chosen value is colon-split (POSIX PATH style, via splitColon).
// Reading the environment is envPaths's job; this pure core takes the two
// Getenv results so the precedence/split logic is unit-testable (the environment
// is a shared process-wide snapshot with no per-variable setter, so it can't be
// staged inside a unit test).
func envPathList(primaryVal *[]readonly char, primarySet bool, aliasVal *[]readonly char,
		aliasSet bool) @[]@[]char {
	if primarySet { return splitColon(primaryVal) }
	if aliasSet { return splitColon(aliasVal) }
	var empty @[]@[]char
	return empty
}

// envPaths reads a package search path from the environment via its long/primary
// variable name and its short alias, returning the effective entries.  Both are
// read so all precedence lives in the unit-tested envPathList.  Used as the
// per-path fallback when the CLI gave no -I (interface) / -L (impl) entry.
func envPaths(primary *[]readonly char, alias *[]readonly char) @[]@[]char {
	pv, pset := os.Getenv(primary)
	av, aset := os.Getenv(alias)
	return envPathList(pv, pset, av, aset)
}

// appendRawCharSlice copies a raw char slice v into a managed
// `@[]char` (via buf.CopyStr) and appends it to s.  The CopyStr is
// load-bearing — callers pass string literals and other *raw* slices
// whose backing isn't owned by the destination, so the managed-slice
// element has to own its own copy.  Not foldable into
// slices.Append[T] because of this side-effecting copy.
func appendRawCharSlice(s @[]@[]char, v *[]readonly char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = buf.CopyStr(v)
	return ns
}
