package "main"

import "pkg/builtins/testing"

// ============================================================
// Test helpers
// ============================================================

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// streq tests
// ============================================================

func TestStreqEqual() testing.TestResult {
	if !streq("hello", "hello") { return fail("same strings should be equal") }
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") { return fail("different strings should not be equal") }
	return ""
}

func TestStreqDifferentLength() testing.TestResult {
	if streq("abc", "ab") { return fail("different lengths should not be equal") }
	return ""
}

func TestStreqEmpty() testing.TestResult {
	if !streq("", "") { return fail("empty strings should be equal") }
	return ""
}

// ============================================================
// hasSuffix tests
// ============================================================

func TestHasSuffixTrue() testing.TestResult {
	if !hasSuffix("hello.bn", ".bn") { return fail("should have suffix .bn") }
	return ""
}

func TestHasSuffixFalse() testing.TestResult {
	if hasSuffix("hello.go", ".bn") { return fail("should not have suffix .bn") }
	return ""
}

func TestHasSuffixTestBn() testing.TestResult {
	if !hasSuffix("foo_test.bn", "_test.bn") { return fail("should have suffix _test.bn") }
	return ""
}

func TestHasSuffixTooShort() testing.TestResult {
	if hasSuffix(".b", ".bn") { return fail("shorter than suffix should return false") }
	return ""
}

func TestHasSuffixExact() testing.TestResult {
	if !hasSuffix(".bn", ".bn") { return fail("exact match should return true") }
	return ""
}

// ============================================================
// dirOf tests
// ============================================================

func TestDirOfSimple() testing.TestResult {
	var d *[]readonly char = dirOf("/foo/bar/baz.bn")
	if !seq(d, "/foo/bar") { return fail("expected /foo/bar") }
	return ""
}

func TestDirOfNoSlash() testing.TestResult {
	var d *[]readonly char = dirOf("baz.bn")
	if len(d) > 0 { return fail("expected empty for no directory") }
	return ""
}

func TestDirOfTrailingSlash() testing.TestResult {
	var d *[]readonly char = dirOf("/foo/bar/")
	if !seq(d, "/foo/bar") { return fail("expected /foo/bar") }
	return ""
}

func TestDirOfRoot() testing.TestResult {
	var d *[]readonly char = dirOf("/foo")
	if !seq(d, "") { return fail("expected empty string") }
	return ""
}

// ============================================================
// stripExt tests
// ============================================================

func TestStripExtSimple() testing.TestResult {
	var r @[]char = stripExt("hello.bn")
	if !seq(r, "hello") { return fail("expected hello") }
	return ""
}

func TestStripExtWithPath() testing.TestResult {
	var r @[]char = stripExt("/foo/bar/hello.bn")
	if !seq(r, "/foo/bar/hello") { return fail("expected /foo/bar/hello") }
	return ""
}

func TestStripExtNoExt() testing.TestResult {
	var r @[]char = stripExt("hello")
	if !seq(r, "hello") { return fail("expected hello unchanged") }
	return ""
}

func TestStripExtMultipleDots() testing.TestResult {
	var r @[]char = stripExt("archive.tar.gz")
	// stripExt finds the last dot after the last slash
	if !seq(r, "archive.tar") { return fail("expected archive.tar") }
	return ""
}

// ============================================================
// shortName tests
// ============================================================

func TestShortNameSimple() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = shortName("/foo/bar/baz.bn")
	if !seq(r, "baz.bn") { return fail("expected baz.bn") }
	return ""
}

func TestShortNameNoSlash() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = shortName("baz.bn")
	if !seq(r, "baz.bn") { return fail("expected baz.bn unchanged") }
	return ""
}

// ============================================================
// pathFileBase tests
// ============================================================

// The common case: each `/` becomes `__`, so nested packages sharing a last
// segment (pkg/alpha/widget vs pkg/beta/widget) stay distinct.
func TestPathFileBaseSlashes() testing.TestResult {
	if !seq(pathFileBase("pkg/foo/bar"), "pkg__foo__bar") {
		return fail("expected pkg__foo__bar")
	}
	return ""
}

// A literal `_` is escaped to `_U` so it can't be confused with a `/`-derived
// `__` pair (a real package path: `ptr_q`).
func TestPathFileBaseUnderscoreEscaped() testing.TestResult {
	if !seq(pathFileBase("ptr_q"), "ptr_Uq") {
		return fail("expected ptr_Uq")
	}
	return ""
}

// Injectivity regression: `a/b` and the literal `a__b` both mapped to `a__b`
// under the old (unescaped-`_`) mapping — a silent .o / archive-member clobber
// of one package by another.  They must now map to DISTINCT bases.
func TestPathFileBaseInjectiveSlashVsUnderscores() testing.TestResult {
	var fromSlash @[]char = pathFileBase("a/b") // -> a__b
	var fromLiteral @[]char = pathFileBase("a__b") // -> a_U_Ub
	if seq(fromSlash, fromLiteral) {
		return fail("a/b and literal a__b must not collide")
	}
	if !seq(fromSlash, "a__b") { return fail("a/b should map to a__b") }
	if !seq(fromLiteral, "a_U_Ub") { return fail("a__b should map to a_U_Ub") }
	return ""
}

// A path with neither `/` nor `_` passes through unchanged.
func TestPathFileBasePlain() testing.TestResult {
	if !seq(pathFileBase("foo"), "foo") {
		return fail("expected foo unchanged")
	}
	return ""
}

// ============================================================
// quotePath tests
// ============================================================

func TestQuotePathSimple() testing.TestResult {
	var r @[]char = quotePath("pkg/foo")
	if !seq(r, "\"pkg/foo\"") { return fail("expected quoted path") }
	return ""
}

func TestQuotePathEmpty() testing.TestResult {
	var r @[]char = quotePath("")
	if !seq(r, "\"\"") { return fail("expected empty quotes") }
	return ""
}

// ============================================================
// unquote tests
// ============================================================

func TestUnquoteQuoted() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("\"hello\"")
	if !seq(r, "hello") { return fail("expected hello") }
	return ""
}

func TestUnquoteUnquoted() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("hello")
	if !seq(r, "hello") { return fail("expected hello unchanged") }
	return ""
}

func TestUnquoteEmpty() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("\"\"")
	if !seq(r, "") { return fail("expected empty string") }
	return ""
}

func TestUnquoteSingleChar() testing.TestResult {
	// bnlint:allow managed-to-raw-assign - sub-slice view of an immortal string literal
	var r *[]readonly char = unquote("x")
	if !seq(r, "x") { return fail("expected x unchanged") }
	return ""
}

// ============================================================
// discoverBinateRoot tests
// ============================================================

func TestDiscoverBinateRootNil() testing.TestResult {
	var noPath *[]readonly char
	var r *[]readonly char = discoverBinateRoot(noPath)
	if len(r) > 0 { return fail("expected empty") }
	return ""
}

func TestDiscoverBinateRootValid() testing.TestResult {
	var r *[]readonly char = discoverBinateRoot("/home/user/binate/runtime/binate_runtime.c")
	if !seq(r, "/home/user/binate") { return fail("expected /home/user/binate") }
	return ""
}

// ============================================================
// splitColon tests
// ============================================================

func TestSplitColonEmpty() testing.TestResult {
	var r @[]@[]char = splitColon("")
	if len(r) != 0 { return fail("empty input should give empty result") }
	return ""
}

func TestSplitColonSingle() testing.TestResult {
	var r @[]@[]char = splitColon("/foo")
	if len(r) != 1 { return fail("expected 1 entry") }
	if !seq(r[0], "/foo") { return fail("entry wrong") }
	return ""
}

func TestSplitColonMultiple() testing.TestResult {
	var r @[]@[]char = splitColon("/a:/b:/c")
	if len(r) != 3 { return fail("expected 3 entries") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	if !seq(r[1], "/b") { return fail("[1] wrong") }
	if !seq(r[2], "/c") { return fail("[2] wrong") }
	return ""
}

// Empty entries are dropped; "A::B" yields 2 entries, not 3.
func TestSplitColonEmptyEntries() testing.TestResult {
	var r @[]@[]char = splitColon("/a::/b")
	if len(r) != 2 { return fail("empty entry should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	if !seq(r[1], "/b") { return fail("[1] wrong") }
	return ""
}

// Trailing colon is benign — "A:" yields 1 entry, not 2.
func TestSplitColonTrailing() testing.TestResult {
	var r @[]@[]char = splitColon("/a:")
	if len(r) != 1 { return fail("trailing colon should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	return ""
}

// Leading colon is benign — ":A" yields 1 entry.
func TestSplitColonLeading() testing.TestResult {
	var r @[]@[]char = splitColon(":/a")
	if len(r) != 1 { return fail("leading colon should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	return ""
}

// appendRawCharSlice copies its raw input via CopyStr and appends
// the resulting managed-slice element.
func TestAppendRawCharSlice() testing.TestResult {
	var s @[]@[]char
	s = appendRawCharSlice(s, "hello")
	s = appendRawCharSlice(s, "world")
	if len(s) != 2 { return fail("expected len 2") }
	return ""
}
