package "main"

import "pkg/binate/buf"
import "pkg/binate/version"
import "pkg/bootstrap"
import "pkg/std/os"

// bnfmt -- the Binate source formatter.
//
// Usage:
//   bnfmt <file>            format to stdout (default)
//   bnfmt -w <file>         rewrite the file in place
//   bnfmt --check <file>    exit non-zero if the file is not already formatted
//   bnfmt --version
//
// STATUS: scaffolding.  formatSource is currently the identity, so bnfmt
// round-trips a file byte-for-byte.  This wires up the build
// (scripts/build-bnfmt.sh), the CLI, and the I/O modes; the AST-driven
// printer lands in later steps (see explorations/plan-bnfmt.md).

// main is the entry point for the formatter CLI.
func main() {
	var args @[]@[]char = bootstrap.Args()

	// --version, scanned first like the other tools.
	var vi int = 0
	for vi < len(args) {
		if charsEqual(args[vi], "--version") {
			print("bnfmt-")
			println(version.Version)
			return
		}
		vi = vi + 1
	}

	var inputPath @[]char = ""
	var write bool = false
	var check bool = false

	var i int = 0
	for i < len(args) {
		var arg @[]char = args[i]
		if charsEqual(arg, "-w") {
			write = true
		} else if charsEqual(arg, "--check") {
			check = true
		} else if len(arg) > 0 && arg[0] == '-' {
			printErr("error: unknown flag\n")
			usage()
			os.Exit(1)
		} else {
			if len(inputPath) > 0 {
				printErr("error: multiple input files not supported\n")
				os.Exit(1)
			}
			inputPath = buf.CopyStr(arg)
		}
		i = i + 1
	}

	if len(inputPath) == 0 {
		usage()
		os.Exit(1)
	}
	if write && check {
		printErr("error: -w and --check are mutually exclusive\n")
		os.Exit(1)
	}

	var src @[]uint8 = readFile(inputPath)
	var out @[]uint8 = formatSource(src)

	if check {
		// Non-zero exit iff the file is not already in formatted form.
		if !bytesEqual(src, out) {
			os.Exit(1)
		}
		return
	}
	if write {
		writeFileBytes(inputPath, out)
		return
	}
	// Default: format to stdout.
	_, _ = os.Stdout.Write(out)
}

// formatSource returns the formatted form of src.  Currently the identity
// (byte-for-byte); the AST-driven printer replaces this in later steps.
func formatSource(src @[]uint8) @[]uint8 {
	return src
}

// usage prints the formatter usage message to stderr.
func usage() {
	printErr("usage: bnfmt [-w | --check] <file>\n")
}

// charsEqual returns true if two char slices have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// bytesEqual returns true if two byte slices have identical contents.
func bytesEqual(a *[]readonly uint8, b *[]readonly uint8) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// printErr writes a raw char slice to stderr.
func printErr(msg *[]readonly char) {
	_, _ = os.Stderr.Write(msg)
}

// readFile reads the whole file at path into an owned byte slice (empty on
// error).  Copied from cmd/bnc's util; there is no shared ReadFile helper yet.
func readFile(path *[]readonly char) @[]uint8 {
	f, oerr := os.Open(path)
	if present(oerr) {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		n, _ := f.Read(tmp)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	_ = f.Close()
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// writeFileBytes writes data to the file at path, truncating it.
//
// TODO: this is a direct (non-atomic) truncate+write.  It is safe for the
// current identity round-trip (output == input), but before formatting
// output can diverge, -w must become crash-safe (write to a temp file, then
// rename over the original).  The stdlib has no os.Rename yet -- that (or a
// bootstrap.Exec("mv"), the pattern cmd/bnc uses for `rm`) is a prerequisite.
func writeFileBytes(path *[]readonly char, data *[]readonly uint8) {
	f, oerr := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC,
		cast(os.FileMode, 0o644))
	if present(oerr) {
		printErr("error: cannot write file\n")
		os.Exit(1)
	}
	_, _ = f.Write(data)
	_ = f.Close()
}
