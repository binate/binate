package "main"

import "pkg/binate/ast"
import "pkg/binate/format"
import "pkg/binate/parser"
import "pkg/binate/version"
import "pkg/std/errors"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/stdx/flags"

// bnfmt -- the Binate source formatter.
//
// Usage:
//   bnfmt <file>              format to stdout (default; exactly one file)
//   bnfmt -w <file>...        rewrite each file in place
//   bnfmt --check <file>...   exit non-zero if any file is not already formatted,
//                             naming each unformatted file on stderr
//   bnfmt --version
//
// formatSource parses <file> (a `.bni` uses interface mode, else ordinary mode)
// with comment collection and renders it via pkg/binate/format.  On a parse
// error it prints the diagnostics to stderr and leaves the file untouched (the
// caller exits non-zero and never rewrites).

// main is the entry point for the formatter CLI.
func main() {
	var args @[]@[]char = progArgs()

	var write bool = false
	var check bool = false
	var showVersion bool = false
	var fs @flags.FlagSet = flags.New("bnfmt")
	fs.BoolVar(&write, "w", "", "rewrite each file in place")
	fs.BoolVar(&check, "check", "", "exit non-zero if any file is not already formatted")
	fs.BoolVar(&showVersion, "version", "", "print version and exit")
	var paths @[]@[]char
	var perr @[]readonly char
	paths, perr = fs.Parse(args)

	// --version wins when reached: it is checked before the parse error, so
	// `--version` after another VALID flag still reports the version.  It must
	// precede any file argument or unknown flag, though — parsing stops at the
	// first positional and errors at an unknown flag, so a later --version past
	// either is never seen.
	if showVersion {
		fmt.Print("bnfmt-", version.Version, "\n")
		return
	}
	if len(perr) > 0 {
		printErr(perr, "\n")
		usage()
		os.Exit(1)
	}

	if len(paths) == 0 {
		usage()
		os.Exit(1)
	}
	if write && check {
		printErr("error: -w and --check are mutually exclusive\n")
		os.Exit(1)
	}
	// Formatting to stdout has no per-file boundary, so it takes exactly one file;
	// -w and --check operate on any number.
	if !write && !check && len(paths) > 1 {
		printErr("error: formatting to stdout accepts only one file; use -w to rewrite multiple files\n")
		os.Exit(1)
	}

	// Process every file; report all problems, then exit non-zero if any file
	// failed (a parse error, or -- in --check mode -- an unformatted file).  One
	// file's failure does not skip the rest.
	var failed bool = false
	for j := 0; j < len(paths); j++ {
		var inputPath @[]char = paths[j]
		var src @[]uint8 = readFile(inputPath)
		var out @[]uint8
		var errs @[]parser.ParseError
		out, errs = formatSource(src, inputPath)
		if len(errs) > 0 {
			// Parse error: report to stderr and never rewrite or print this file.
			for ei := 0; ei < len(errs); ei++ {
				printErr(inputPath, ": ", errs[ei].Msg, "\n")
			}
			failed = true
			continue
		}
		if check {
			// Name the file on stderr if it is not already in formatted form.
			if !bytesEqual(src, out) {
				printErr(inputPath, ": not formatted\n")
				failed = true
			}
		} else if write {
			writeFileBytes(inputPath, out)
		} else {
			// Default: format the single file to stdout.
			_, _ = os.Stdout.Write(out)
		}
	}
	if failed {
		os.Exit(1)
	}
}

// formatSource parses src (as the file at `path`) with comment collection and
// returns its canonical formatting; the second result is the parse errors, empty
// on success.  When it is non-empty the byte result is empty and the caller must
// neither rewrite the file nor print partial output.  A `.bni`
// path parses in interface mode.
func formatSource(src @[]uint8, path *[]readonly char) (@[]uint8, @[]parser.ParseError) {
	var p @parser.Parser
	if hasSuffix(path, ".bni") {
		p = parser.NewInterfaceCollecting(src, path)
	} else {
		p = parser.NewCollecting(src, path)
	}
	var f @ast.File = p.ParseFile()
	var errs @[]parser.ParseError = p.Errors()
	if len(errs) > 0 {
		var empty @[]uint8
		return empty, errs
	}
	var body @[]uint8 = charsToBytes(format.Format(f))
	// The lexer skips a `#!` shebang line (spec lex.shebang), so format.Format
	// renders only the body.  Re-emit a byte-0 shebang verbatim as the first
	// output line so a chmod +x'd script survives a reformat.  Idempotent: a
	// re-formatted file presents the same shebang as its first line, captured and
	// re-emitted identically on any later pass.
	var sh int = shebangLen(src)
	if sh == 0 {
		return body, errs
	}
	var out @[]uint8 = make_slice(uint8, sh + len(body))
	for i := 0; i < sh; i++ {
		out[i] = src[i]
	}
	for i := 0; i < len(body); i++ {
		out[sh + i] = body[i]
	}
	return out, errs
}

// shebangLen returns the byte length of a leading `#!` shebang line in src --
// through its terminating newline (included), or up to (not including)
// end-of-input or an embedded NUL if the shebang is the file's last line -- or 0
// if src does not begin with `#!`.  Mirrors the lexer's offset-0 shebang
// recognition (spec lex.shebang): the skip runs to `\n` or `\0` or EOF, and only
// the `\n` is consumed -- so bnfmt preserves exactly the bytes the lexer skips.
func shebangLen(src *[]readonly uint8) int {
	if len(src) < 2 || src[0] != '#' || src[1] != '!' {
		return 0
	}
	var i int = 0
	for i < len(src) && src[i] != '\n' && src[i] != '\0' {
		i = i + 1
	}
	if i < len(src) && src[i] == '\n' {
		return i + 1
	}
	return i
}

// charsToBytes copies a formatted char slice into an owned byte slice for output.
func charsToBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// hasSuffix reports whether s ends with suf.
func hasSuffix(s *[]readonly char, suf *[]readonly char) bool {
	if len(suf) > len(s) { return false }
	var off int = len(s) - len(suf)
	for i := 0; i < len(suf); i++ {
		if s[off + i] != suf[i] { return false }
	}
	return true
}

// usage prints the formatter usage message to stderr.
func usage() {
	printErr("usage: bnfmt [-w | --check] <file>...\n")
}

// progArgs returns bnfmt's own argument tokens: os.Args() minus the program-name
// slot at index 0, copied into a mutable @[]@[]char for parsing.  Reading argv
// through os.Args means that when bnfmt is run under
// the bytecode interpreter it sees the argv the interpreter installed via
// os.SetArgs, not the interpreter's own.
func progArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 {
		return make_slice(@[]char, 0)
	}
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		// full[i] is a readonly-qualified element; copy it char-by-char into an
		// owned, mutable @[]char (a readonly element can't be borrowed as the
		// mutable slice the parser holds).
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = full[i][j]
		}
		out[i - 1] = s
	}
	return out
}

// bytesEqual returns true if two byte slices have identical contents.
func bytesEqual(a *[]readonly uint8, b *[]readonly uint8) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// printErr writes a diagnostic to stderr via fmt.  The variadic *any lets a
// message's pieces (path, ": ", error text, "\n") print in a single call.
func printErr(args ...*any) {
	_, _ = fmt.Fprint(os.Stderr, args...)
}

// readFile reads the whole file at path into an owned byte slice (empty on
// error).  Copied from cmd/bnc's util; there is no shared ReadFile helper yet.
func readFile(path *[]readonly char) @[]uint8 {
	f, oerr := os.Open(path)
	if present(oerr) {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		n, _ := f.Read(tmp)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	_ = f.Close()
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// writeFileBytes writes data to the file at path crash-safely: it writes to a
// temporary file in the SAME directory (so the rename stays on one filesystem
// and is atomic), then renames it over the original.  A crash mid-write leaves
// the original intact (only a stray `<path>.bnfmt.tmp` may remain).
func writeFileBytes(path *[]readonly char, data *[]readonly uint8) {
	var tmp @[]char = joinStr(path, ".bnfmt.tmp")
	f, oerr := os.OpenFile(tmp, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(oerr) {
		printErr("error: cannot write file\n")
		os.Exit(1)
	}
	_, _ = f.Write(data)
	_ = f.Close()
	var rerr @errors.Error = os.Rename(tmp, path)
	if present(rerr) {
		printErr("error: cannot rename temp file into place\n")
		os.Exit(1)
	}
}

// joinStr concatenates two char slices into an owned slice.
func joinStr(a *[]readonly char, b *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(a) + len(b))
	for i := 0; i < len(a); i++ {
		out[i] = a[i]
	}
	for i := 0; i < len(b); i++ {
		out[len(a) + i] = b[i]
	}
	return out
}
