package "main"

import "pkg/binate/parser"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// strToBytes copies a source string into an owned byte slice for formatSource.
func strToBytes(s *[]readonly char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// A valid file formats without errors, and re-formatting the output is a fixpoint.
func TestFormatSourceValid() testing.TestResult {
	var src @[]uint8 = strToBytes("package \"t\"\nfunc f() int { return 1 }\n")
	var out @[]uint8
	var errs @[]parser.ParseError
	out, errs = formatSource(src, "t.bn")
	if len(errs) > 0 {
		return fail("valid source produced parse errors")
	}
	if len(out) == 0 {
		return fail("valid source produced empty output")
	}
	var out2 @[]uint8
	var errs2 @[]parser.ParseError
	out2, errs2 = formatSource(out, "t.bn")
	if len(errs2) > 0 || !bytesEqual(out, out2) {
		return fail("formatSource is not idempotent")
	}
	return ""
}

// A syntactically invalid file yields parse errors and no output (so the caller
// leaves the file untouched).
func TestFormatSourceParseError() testing.TestResult {
	var src @[]uint8 = strToBytes("package \"t\"\nfunc f( {\n")
	var out @[]uint8
	var errs @[]parser.ParseError
	out, errs = formatSource(src, "t.bn")
	if len(errs) == 0 {
		return fail("invalid source should produce parse errors")
	}
	if len(out) != 0 {
		return fail("invalid source should produce no output")
	}
	return ""
}

// A `.bni` path parses in interface mode (a signature-only file formats).
func TestFormatSourceInterface() testing.TestResult {
	var src @[]uint8 = strToBytes("package \"t\"\nfunc f() int\n")
	var out @[]uint8
	var errs @[]parser.ParseError
	out, errs = formatSource(src, "t.bni")
	if len(errs) > 0 {
		return fail("valid .bni source produced parse errors")
	}
	if len(out) == 0 {
		return fail(".bni source produced empty output")
	}
	return ""
}

func TestBytesEqual() testing.TestResult {
	var a @[]uint8 = make_slice(uint8, 2)
	a[0] = 'x'
	a[1] = 'y'
	var b @[]uint8 = make_slice(uint8, 2)
	b[0] = 'x'
	b[1] = 'y'
	if !bytesEqual(a, b) {
		return fail("equal byte slices should compare equal")
	}
	b[1] = 'z'
	if bytesEqual(a, b) {
		return fail("differing byte slices should not compare equal")
	}
	var c @[]uint8 = make_slice(uint8, 1)
	c[0] = 'x'
	if bytesEqual(a, c) {
		return fail("different-length slices should not compare equal")
	}
	return ""
}

func TestCharsEqual() testing.TestResult {
	if !charsEqual("abc", "abc") {
		return fail("equal char slices should compare equal")
	}
	if charsEqual("abc", "abd") {
		return fail("differing char slices should not compare equal")
	}
	if charsEqual("abc", "ab") {
		return fail("different-length char slices should not compare equal")
	}
	return ""
}
