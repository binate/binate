package "main"

import "pkg/binate/buf"
import "pkg/std/errors"
import "pkg/std/os"

// CLIArgs holds the parsed command-line arguments.
type CLIArgs struct {
	Filenames    @[]@[]char
	ProgArgs     @[]@[]char
	BniPaths     @[]@[]char  // -I / --interface-path: dirs searched for `.bni`.
	ImplPaths    @[]@[]char  // -L / --impl-path: dirs searched for impl dirs.
	Verbose      bool
	TestMode     bool
	Repl         bool
	// RunFilter is a substring filter for --test mode: only Test*
	// functions whose name contains this substring run.  Empty means
	// run all tests.  Mirrors `go test -run` (but plain substring,
	// not regex — keeps the bootstrap subset happy).
	RunFilter    @[]char
	// SkipFilter is a substring filter for --test mode: Test*
	// functions whose name contains this substring are SKIPPED.
	// Empty means no skipping.  Applied after RunFilter — if a
	// test passes RunFilter but matches SkipFilter, it's skipped.
	SkipFilter   @[]char
}

// primaryRoot returns bni's notion of "the binate source root" — the
// first -I entry.  Empty if no -I was passed; callers fall back to
// dirOf(firstSourceFile) (run/repl) or "." (--test) in that case.
func primaryRoot(cli CLIArgs) @[]char {
	if len(cli.BniPaths) > 0 { return buf.CopyStr(cli.BniPaths[0]) }
	var empty @[]char
	return empty
}

// parseArgs splits command-line arguments into source files, flags, and program args.
//
// Long flag style: `--word` is the standard.  Single-dash forms
// (`-verbose`, `-test`, `-run`, `-skip`, `-repl`) are accepted as
// back-compat aliases.  Single `-` is reserved for short flags
// (`-v`, `-I`, `-L`).
func parseArgs(args @[]@[]char) CLIArgs {
	var result CLIArgs
	var seenDash bool = false
	for i := 0; i < len(args); i++ {
		if streq(args[i], "--") && !seenDash {
			seenDash = true
		} else if seenDash {
			result.ProgArgs = appendCharSlice(result.ProgArgs, buf.CopyStr(args[i]))
		} else if (streq(args[i], "-I") || streq(args[i], "--interface-path")) &&
				i+1 < len(args) {
			var parts @[]@[]char = splitColon(args[i+1])
			for j := 0; j < len(parts); j++ {
				result.BniPaths = appendCharSlice(result.BniPaths, parts[j])
			}
			i++
		} else if (streq(args[i], "-L") || streq(args[i], "--impl-path")) &&
				i+1 < len(args) {
			var parts @[]@[]char = splitColon(args[i+1])
			for j := 0; j < len(parts); j++ {
				result.ImplPaths = appendCharSlice(result.ImplPaths, parts[j])
			}
			i++
		} else if streq(args[i], "-v") || streq(args[i], "-verbose") ||
				streq(args[i], "--verbose") {
			result.Verbose = true
		} else if streq(args[i], "-test") || streq(args[i], "--test") {
			result.TestMode = true
		} else if (streq(args[i], "-run") || streq(args[i], "--run")) &&
				i+1 < len(args) {
			result.RunFilter = buf.CopyStr(args[i+1])
			i++
		} else if (streq(args[i], "-skip") || streq(args[i], "--skip")) &&
				i+1 < len(args) {
			result.SkipFilter = buf.CopyStr(args[i+1])
			i++
		} else if streq(args[i], "-repl") || streq(args[i], "--repl") {
			result.Repl = true
		} else {
			result.Filenames = appendCharSlice(result.Filenames, buf.CopyStr(args[i]))
		}
	}
	return result
}

// expandDirArgs expands directory arguments into .bn files (excluding _test.bn).
func expandDirArgs(args @[]@[]char) @[]@[]char {
	var result @[]@[]char
	for i := 0; i < len(args); i++ {
		var fi @os.FileInfo
		var err @errors.Error
		fi, err = os.Stat(args[i])
		if present(err) || !fi.IsDir() {
			result = appendCharSlice(result, args[i])
		} else {
			var entries @[]@os.DirEntry
			entries, err = os.ReadDir(args[i])
			if present(err) {
				print("error: cannot read directory ")
				println(args[i])
				os.Exit(1)
			}
			for j := 0; j < len(entries); j++ {
				var nm @[]readonly char = entries[j].Name()
				if hasSuffix(nm, ".bn") && !hasSuffix(nm, "_test.bn") {
					var path @[]char = buf.Concat(
						buf.Concat(args[i], "/"), nm)
					result = appendCharSlice(result, buf.CopyStr(path))
				}
			}
		}
	}
	return result
}

// hasSuffix returns true if s ends with suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(s) < len(suffix) { return false }
	var offset int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[offset + i] != suffix[i] { return false }
	}
	return true
}
