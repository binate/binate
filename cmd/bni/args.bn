package "main"

import "pkg/binate/buf"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/stdx/containers/vec"
import "pkg/stdx/fmt"

// CLIArgs holds the parsed command-line arguments.
type CLIArgs struct {
	Filenames @vec.Vec[@[]char]
	ProgArgs  @vec.Vec[@[]char]
	BniPaths  @vec.Vec[@[]char] // -I / --interface-path: dirs searched for `.bni`.
	ImplPaths @vec.Vec[@[]char] // -L / --impl-path: dirs searched for impl dirs.
	Verbose   bool
	TestMode  bool
	Repl      bool
	// CheckNil is set by `--check-nil`: it turns on opt-in nil-pointer-deref
	// checking for a plain `bni <prog>` run (default off — a plain run stays
	// C-like/fast, byte-identical to a run without the feature).  --test and the
	// REPL enable checking unconditionally, so this flag governs only the
	// plain-run path.
	CheckNil bool
	// Script marks `-x` script mode: exactly one source file, and every arg
	// AFTER it is the program's own argv (not a bni flag or a `--` separator),
	// so an argument-taking `#!/usr/bin/env -S bni -x` script receives its
	// arguments.  See spec §17.3.1.
	Script bool
	// Version is set by `--version` when it is recognized as a bni flag (i.e. NOT
	// after a `-x` script file or a `--`); main then prints bni's version and
	// exits.  Folding it into parseArgs (rather than a separate pre-parse scan)
	// makes the version check respect `-x` the same way flag recognition does.
	Version bool
	// RunFilter is a substring filter for --test mode: only Test*
	// functions whose name contains this substring run.  Empty means
	// run all tests.  Mirrors `go test -run` (but plain substring,
	// not regex — keeps the bootstrap subset happy).
	RunFilter @[]char
	// SkipFilter is a substring filter for --test mode: Test*
	// functions whose name contains this substring are SKIPPED.
	// Empty means no skipping.  Applied after RunFilter — if a
	// test passes RunFilter but matches SkipFilter, it's skipped.
	SkipFilter @[]char
}

// primaryRoot returns bni's notion of "the binate source root" — the
// first -I entry.  Empty if no -I was passed; callers fall back to
// dirOf(firstSourceFile) (run/repl) or "." (--test) in that case.
func primaryRoot(cli CLIArgs) @[]char {
	if cli.BniPaths.Len() > 0 { return buf.CopyStr(cli.BniPaths.Get(0)) }
	var empty @[]char
	return empty
}

// parseArgs splits command-line arguments into source files, flags, and program args.
//
// Long flag style: `--word` is the standard.  Single-dash forms
// (`-verbose`, `-test`, `-run`, `-skip`, `-repl`) are accepted as
// back-compat aliases.  Single `-` is reserved for short flags
// (`-v`, `-I`, `-L`).
func parseArgs(args @[]@[]char) CLIArgs {
	var result CLIArgs
	// The four accumulator fields are vectors; initialize them so Push has a
	// live target and every returned CLIArgs carries valid (possibly empty)
	// vectors a caller can read via Len/Get without a nil check.
	result.Filenames = vec.New[@[]char]()
	result.ProgArgs = vec.New[@[]char]()
	result.BniPaths = vec.New[@[]char]()
	result.ImplPaths = vec.New[@[]char]()
	var seenDash bool = false
	var sawScriptFile bool = false
	for i := 0; i < len(args); i++ {
		if result.Script && sawScriptFile {
			// -x script mode: once the script file is seen, EVERY remaining arg is
			// the program's argv -- including a literal `--` and flag-looking args
			// -- so bni consumes none of them.
			result.ProgArgs.Push(buf.CopyStr(args[i]))
		} else if streq(args[i], "--") && !seenDash {
			seenDash = true
		} else if seenDash {
			result.ProgArgs.Push(buf.CopyStr(args[i]))
		} else if streq(args[i], "-x") {
			result.Script = true
		} else if streq(args[i], "--version") {
			result.Version = true
		} else if (streq(args[i], "-I") || streq(args[i], "--interface-path")) && i + 1 < len(args) {
			var parts @[]@[]char = splitColon(args[i + 1])
			for j := 0; j < len(parts); j++ {
				result.BniPaths.Push(parts[j])
			}
			i++
		} else if (streq(args[i], "-L") || streq(args[i], "--impl-path")) && i + 1 < len(args) {
			var parts @[]@[]char = splitColon(args[i + 1])
			for j := 0; j < len(parts); j++ {
				result.ImplPaths.Push(parts[j])
			}
			i++
		} else if streq(args[i], "-v") || streq(args[i], "-verbose") || streq(args[i], "--verbose") {
			result.Verbose = true
		} else if streq(args[i], "-test") || streq(args[i], "--test") {
			result.TestMode = true
		} else if (streq(args[i], "-run") || streq(args[i], "--run")) && i + 1 < len(args) {
			result.RunFilter = buf.CopyStr(args[i + 1])
			i++
		} else if (streq(args[i], "-skip") || streq(args[i], "--skip")) && i + 1 < len(args) {
			result.SkipFilter = buf.CopyStr(args[i + 1])
			i++
		} else if streq(args[i], "-repl") || streq(args[i], "--repl") {
			result.Repl = true
		} else if streq(args[i], "--check-nil") {
			result.CheckNil = true
		} else {
			result.Filenames.Push(buf.CopyStr(args[i]))
			// In -x mode the FIRST source file is the script; from here on every
			// arg is the program's argv (captured at the top of the loop).
			if result.Script {
				sawScriptFile = true
			}
		}
	}
	return result
}

// bniArgs returns bni's own command-line argument tokens: os.Args() minus the
// program-name slot at index 0, copied into a mutable @[]@[]char for parsing.
//
// bni reads its argv through os.Args (NOT bootstrap.Args) so that a nested bni
// (the builder-comp-int-int mode: one bni interpreting cmd/bni interpreting a
// program) sees the argv its parent installed via setProgramArgs/os.SetArgs,
// rather than the parent's full argv — which would name cmd/bni itself and
// re-invoke it forever.
func bniArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 {
		return make_slice(@[]char, 0)
	}
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		// full[i] is a readonly-qualified element; copy it out char-by-char
		// into an owned @[]char (its readonly type can't be borrowed as the
		// *[]readonly char buf.CopyStr expects).
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = full[i][j]
		}
		out[i - 1] = s
	}
	return out
}

// setProgramArgs installs, via os.SetArgs, the argv the program bni is about to
// run should see through os.Args(): element 0 the program's own path, elements
// 1.. its arguments (everything after `--`).  The interpreted program — and any
// nested bni — then reads these instead of bni's argv.  The previous value (bni's
// own args) is dropped: bni has already parsed its command line by this point.
func setProgramArgs(progName @[]char, progArgs @[]@[]char) {
	var n int = len(progArgs)
	var argv @[]@[]readonly char = make_slice(@[]readonly char, n + 1)
	argv[0] = progName
	for i := 0; i < n; i++ {
		argv[i + 1] = progArgs[i]
	}
	var widened @[]readonly @[]readonly char = argv
	os.SetArgs(widened)
}

// expandDirArgs expands directory arguments into .bn files (excluding _test.bn).
// Returns a fresh vector so the caller can assign it straight back to the
// CLIArgs.Filenames vector field.
func expandDirArgs(args @[]@[]char) @vec.Vec[@[]char] {
	var result @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < len(args); i++ {
		var fi @os.FileInfo
		var err @errors.Error
		fi, err = os.Stat(args[i])
		if present(err) || !fi.IsDir() {
			result.Push(args[i])
		} else {
			var entries @[]@os.DirEntry
			entries, err = os.ReadDir(args[i])
			if present(err) {
				fmt.Print("error: cannot read directory ", args[i], "\n")
				os.Exit(1)
			}
			for j := 0; j < len(entries); j++ {
				var nm @[]readonly char = entries[j].Name()
				// os.ReadDir keeps dot-prefixed names; skip them so a hidden
				// file (e.g. a stray ".foo.bn") is never taken as a source.
				if len(nm) > 0 && nm[0] == '.' { continue }
				if hasSuffix(nm, ".bn") && !hasSuffix(nm, "_test.bn") {
					var path @[]char = buf.Concat(
							buf.Concat(args[i], "/"), nm)
					result.Push(buf.CopyStr(path))
				}
			}
		}
	}
	return result
}

// hasSuffix returns true if s ends with suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(s) < len(suffix) { return false }
	var offset int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[offset + i] != suffix[i] { return false }
	}
	return true
}

// isDir reports whether path names an existing directory.  Used to reject a
// directory argument in -x script mode (where exactly one FILE is the script)
// before expandDirArgs would otherwise fan it out into its .bn files.
func isDir(path *[]readonly char) bool {
	var fi @os.FileInfo
	var err @errors.Error
	fi, err = os.Stat(path)
	return !present(err) && fi.IsDir()
}
