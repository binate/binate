package "main"

import "pkg/binate/buf"
import "pkg/std/errors"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/vec"
import "pkg/stdx/flags"

// CLIArgs holds the parsed command-line arguments.  A TARGET selects what bni
// does: a main package to run — its directory (-main-dir), its single source
// file (-main-file), or (when neither flag is given) the FIRST POSITIONAL,
// auto-detected as a dir or file — or one-or-more --test packages.  Everything
// after the main package is ProgArgs (the interpreted program's own argv); a
// positional under --test, or an extra one under -repl, is a usage error.
// parseArgs records any usage error in Error.
type CLIArgs struct {
	MainDir  @[]char // -main-dir <dir>: run the main package in <dir>
	MainFile @[]char // -main-file <file>: run the single-file main <file>
	// MainPath is the implicit positional main: the first positional token when
	// no -main-dir/-main-file/-test is given.  It is auto-detected as a directory
	// or a single file at run time (targetFiles), so a plain `bni foo/` or
	// `bni foo.bn` works — and a shebang `#!/usr/bin/env -S bni <flags> --` lands
	// the kernel-appended script here.
	MainPath  @[]char
	TestPkgs  @[]@[]char // -test <pkg> (repeatable): packages whose Test* to run
	Repl      bool // -repl: REPL in the main package instead of running main()
	ProgArgs  @[]@[]char // the interpreted program's own argv (the positional tail)
	BniPaths  @[]@[]char // -I / --interface-path: dirs searched for `.bni` (colon-split, repeatable).
	ImplPaths @[]@[]char // -L / --impl-path: dirs searched for impl dirs (colon-split, repeatable).
	Verbose   bool
	// CheckNil is set by `--check-nil`: it turns on opt-in nil-pointer-deref
	// checking for a plain run (default off — a plain run stays C-like/fast,
	// byte-identical to a run without the feature).  --test and the REPL enable
	// checking unconditionally, so this flag governs only the plain-run path.
	CheckNil bool
	// OptLevel is the IR optimization level (`-O <n>`, 0-3; default 0 = none)
	// applied to each module at lowering time via ir.RunOptPasses — e.g.
	// constant-index bounds-check elimination.  Note bni takes a separated value
	// (`-O 1`), not bnc's attached `-O1`, since the flags parser splits only on
	// `=`.  Applies to a plain run; --test / REPL stay at 0 for now.
	OptLevel int
	Version  bool // --version: print bni's version and exit (handled in main)
	// RunFilter is a substring filter for --test mode: only Test* functions whose
	// name contains this substring run.  Empty means run all tests.  Mirrors
	// `go test -run` (but plain substring, not regex — Binate has no regex library).
	RunFilter @[]char
	// SkipFilter is a substring filter for --test mode: Test* functions whose name
	// contains this substring are SKIPPED.  Empty means no skipping.  Applied
	// after RunFilter — a test passing RunFilter but matching SkipFilter is skipped.
	SkipFilter @[]char
	// ShardIdx / ShardCount split a package's tests across parallel runs in --test
	// mode: run the tests at positions where `pos % ShardCount == ShardIdx - 1`
	// (0-based position over the RunFilter/SkipFilter-selected set; ShardIdx is
	// 1-based).  Default 1/1 runs every test.  This is what lets a single heavy
	// package's tests be spread over several CI shards instead of timing one out.
	ShardIdx   int
	ShardCount int
	Error      @[]char // usage error, or "" when the command line is valid
}

// primaryRoot returns bni's notion of "the binate source root" — the
// first -I entry.  Empty if no -I was passed; callers fall back to
// dirOf(the main file) (run/repl) or "." (--test) in that case.
func primaryRoot(cli CLIArgs) @[]char {
	if len(cli.BniPaths) > 0 { return buf.CopyStr(cli.BniPaths[0]) }
	var empty @[]char
	return empty
}

// parseArgs parses bni's command-line arguments via pkg/stdx/flags.  The target
// is -main-dir / -main-file / -test, or — when none is given — the first
// positional (the implicit main); everything after the main package is the
// program's argv.  The old injection-prone `--`-splits-filenames rule is gone:
// `--` is just the standard end-of-flags marker, so parsing stops at the first
// positional (or `--`) and flag-looking argv reaches the program verbatim.  Any
// usage error — a flags parse error, a bad target selection, or a stray
// positional in a mode that takes none — is recorded in CLIArgs.Error.  parseArgs
// is a pure function of its arguments (no filesystem checks — the implicit
// main's dir-vs-file detection happens in main's targetFiles).
func parseArgs(args @[]@[]char) CLIArgs {
	var cli CLIArgs
	var fs @flags.FlagSet = flags.New("bni")
	fs.BoolVar(&cli.Version, "version", "", "print version and exit")
	fs.StringVar(&cli.MainDir, "main-dir", "", "", "run the main package in this directory")
	fs.StringVar(&cli.MainFile, "main-file", "", "", "run the single-file main in this file")
	fs.StringListVar(&cli.TestPkgs, "test", "", "run Test* in this package (repeatable)")
	fs.BoolVar(&cli.Repl, "repl", "", "start a REPL in the -main-* target instead of running main()")
	fs.StringListSepVar(&cli.BniPaths, "interface-path", "I", ':',
			"colon-separated dirs searched for .bni files (repeatable)")
	fs.StringListSepVar(&cli.ImplPaths, "impl-path", "L", ':',
			"colon-separated dirs searched for impl dirs (repeatable)")
	fs.BoolVar(&cli.Verbose, "verbose", "v", "verbose logging")
	fs.BoolVar(&cli.CheckNil, "check-nil", "", "enable nil-pointer-deref checking on a plain run")
	fs.IntVar(&cli.OptLevel, "O", "", 0, "IR optimization level 0-3 (e.g. bounds-check elimination)")
	fs.StringVar(&cli.RunFilter, "run", "", "", "--test: run only Test* whose name contains <substr>")
	fs.StringVar(&cli.SkipFilter, "skip", "", "", "--test: skip Test* whose name contains <substr>")
	fs.IntVar(&cli.ShardIdx, "shard-index", "", 1, "--test: 1-based shard index (with --shard-count)")
	fs.IntVar(&cli.ShardCount, "shard-count", "", 1,
			"--test: total shards to split a package's tests across")
	var perr @[]readonly char
	cli.ProgArgs, perr = fs.Parse(args)
	if len(perr) > 0 {
		cli.Error = buf.CopyStr(perr)
		return cli
	}
	if cli.ShardCount < 1 || cli.ShardIdx < 1 || cli.ShardIdx > cli.ShardCount {
		cli.Error = buf.CopyStr("--shard-index must be in [1, --shard-count], --shard-count >= 1")
		return cli
	}
	if cli.Version {
		return cli // main prints the version; no target required
	}
	// `rest` is the positional tail flags.Parse returned (already in ProgArgs);
	// how it is interpreted depends on the target.
	var rest @[]@[]char = cli.ProgArgs
	if len(cli.MainDir) > 0 && len(cli.MainFile) > 0 {
		cli.Error = "error: -main-dir and -main-file are mutually exclusive"
		return cli
	}
	var hasExplicitMain bool = len(cli.MainDir) > 0 || len(cli.MainFile) > 0
	if len(cli.TestPkgs) > 0 {
		if hasExplicitMain {
			cli.Error = "error: -test cannot be combined with -main-dir/-main-file"
			return cli
		}
		if cli.Repl {
			cli.Error = "error: -repl cannot be combined with -test"
			return cli
		}
		if len(rest) > 0 {
			cli.Error = "error: -test takes no program arguments"
			return cli
		}
		return cli // --test mode; ProgArgs stays empty
	}
	if hasExplicitMain {
		// The main package is named by a flag, so every positional is the
		// program's argv (a REPL runs no main, so it takes none).
		if cli.Repl && len(rest) > 0 {
			cli.Error = "error: -repl takes no program arguments"
			return cli
		}
		return cli // ProgArgs already == rest
	}
	// No target flag: the first positional names the main package; the rest are
	// the program's argv (a REPL takes none).  Because parsing stops at that
	// first positional, flag-looking argv tokens after it reach the program
	// verbatim — which is what makes shebang scripts (`bni <flags> -- <script>
	// <args…>`) work.
	if len(rest) == 0 {
		cli.Error = "error: no source file or directory given (or use -main-dir / -main-file / -test)"
		return cli
	}
	if cli.Repl && len(rest) > 1 {
		cli.Error = "error: -repl takes no program arguments"
		return cli
	}
	cli.MainPath = rest[0]
	cli.ProgArgs = rest[1:]
	return cli
}

// oneStr returns a one-element @[]@[]char holding s — used to feed a single
// -main-file / -main-dir target into the (slice-taking) file-resolution paths.
func oneStr(s @[]char) @[]@[]char {
	var out @[]@[]char = make_slice(@[]char, 1)
	out[0] = s
	return out
}

// bniArgs returns bni's own command-line argument tokens: os.Args() minus the
// program-name slot at index 0, copied into a mutable @[]@[]char for parsing.
//
// bni reads its argv through os.Args so that a nested bni
// (the builder-comp-int-int mode: one bni interpreting cmd/bni interpreting a
// program) sees the argv its parent installed via setProgramArgs/os.SetArgs,
// rather than the parent's full argv — which would name cmd/bni itself and
// re-invoke it forever.
func bniArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 {
		return make_slice(@[]char, 0)
	}
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		// full[i] is a readonly-qualified element; copy it out char-by-char
		// into an owned @[]char (its readonly type can't be borrowed as the
		// *[]readonly char buf.CopyStr expects).
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = full[i][j]
		}
		out[i - 1] = s
	}
	return out
}

// setProgramArgs installs, via os.SetArgs, the argv the program bni is about to
// run should see through os.Args(): element 0 the program's own path, elements
// 1.. its arguments (everything after `--`).  The interpreted program — and any
// nested bni — then reads these instead of bni's argv.  The previous value (bni's
// own args) is dropped: bni has already parsed its command line by this point.
func setProgramArgs(progName @[]char, progArgs @[]@[]char) {
	var n int = len(progArgs)
	var argv @[]@[]readonly char = make_slice(@[]readonly char, n + 1)
	argv[0] = progName
	for i := 0; i < n; i++ {
		argv[i + 1] = progArgs[i]
	}
	var widened @[]readonly @[]readonly char = argv
	os.SetArgs(widened)
}

// expandDirArgs expands directory arguments into .bn files (excluding _test.bn).
// Returns a fresh vector so the caller can assign it straight back to the
// CLIArgs.Filenames vector field.
func expandDirArgs(args @[]@[]char) @vec.Vec[@[]char] {
	var result @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < len(args); i++ {
		var fi @os.FileInfo
		var err @errors.Error
		fi, err = os.Stat(args[i])
		if present(err) || !fi.IsDir() {
			result.Push(args[i])
		} else {
			var entries @[]@os.DirEntry
			entries, err = os.ReadDir(args[i])
			if present(err) {
				fmt.Print("error: cannot read directory ", args[i], "\n")
				os.Exit(1)
			}
			for j := 0; j < len(entries); j++ {
				var nm @[]readonly char = entries[j].Name()
				// os.ReadDir keeps dot-prefixed names; skip them so a hidden
				// file (e.g. a stray ".foo.bn") is never taken as a source.
				if len(nm) > 0 && nm[0] == '.' { continue }
				if hasSuffix(nm, ".bn") && !hasSuffix(nm, "_test.bn") {
					var path @[]char = buf.Concat(
							buf.Concat(args[i], "/"), nm)
					result.Push(buf.CopyStr(path))
				}
			}
		}
	}
	return result
}

// hasSuffix returns true if s ends with suffix.
func hasSuffix(s *[]readonly char, suffix *[]readonly char) bool {
	if len(s) < len(suffix) { return false }
	var offset int = len(s) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if s[offset + i] != suffix[i] { return false }
	}
	return true
}

// isDir reports whether path names an existing directory.  Used to reject a
// directory passed to -main-file (which names exactly one source FILE; a
// directory main package is -main-dir instead).
func isDir(path *[]readonly char) bool {
	var fi @os.FileInfo
	var err @errors.Error
	fi, err = os.Stat(path)
	return !present(err) && fi.IsDir()
}
