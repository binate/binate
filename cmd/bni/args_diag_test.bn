package "main"

import "pkg/builtins/testing"

// parseArgs tests for the experimental diagnostics' flags.

// --x-type-differential names the file the type differential appends to; it is
// off (empty) by default.
func TestTypeDifferentialFlag() testing.TestResult {
	var cli CLIArgs = parseArgs(
			@[]@[]char{"--x-type-differential", "/tmp/d.txt", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(cli.TypeDiffPath, "/tmp/d.txt") { return fail("expected the differential's file") }
	if len(parseArgs(@[]@[]char{"-main-file", "f.bn"}).TypeDiffPath) != 0 {
		return fail("the differential must be off by default")
	}
	return ""
}
