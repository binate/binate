package "main"

import "pkg/binate/iropt"
import "pkg/builtins/testing"

// parseArgs tests for the IR pass configuration: -O and -f<pass> / -fno-<pass>.

func TestOptConfigDefaultRunsNothing() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if cli.Opt.Passes != 0 { return fail("bni's default must run no pass") }
	return ""
}

func TestOptConfigLevelWithFno() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-O", "2", "-fno-inline", "-main-file", "foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if iropt.OptPassEnabled(cli.Opt, iropt.PASS_INLINE) {
		return fail("-fno-inline must disable inline")
	}
	if !iropt.OptPassEnabled(cli.Opt, iropt.PASS_SROA) { return fail("-O 2 must keep sroa on") }
	return ""
}

func TestOptConfigSinglePassAtO0() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-fbce-const", "-main-file", "foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if cli.Opt.Passes != (cast(uint, 1) << cast(uint, iropt.PASS_BCE_CONST)) {
		return fail("-fbce-const alone must enable exactly bce-const")
	}
	return ""
}

func TestOptConfigFAndFnoIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-flicm", "-fno-licm", "-main-file", "foo.bn"})
	if len(cli.Error) == 0 { return fail("-flicm with -fno-licm must be an error") }
	return ""
}
