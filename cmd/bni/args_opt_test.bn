package "main"

import "pkg/binate/iropt"
import "pkg/builtins/testing"

// parseArgs tests for the IR pass configuration: the VM pass set adjusted by
// -f<pass> / -fno-<pass>.

func TestOptConfigDefaultIsVMSet() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if cli.Opt.Passes != iropt.VMOptConfig().Passes {
		return fail("bni's default must be the VM pass set")
	}
	return ""
}

func TestOptConfigFAddsAndFnoRemoves() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-finline", "-fno-mem2reg", "-main-file", "foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	var want iropt.OptConfig = iropt.WithOptPass(iropt.VMOptConfig(), iropt.PASS_INLINE, true)
	want = iropt.WithOptPass(want, iropt.PASS_MEM2REG, false)
	if cli.Opt.Passes != want.Passes {
		return fail("-finline -fno-mem2reg must adjust exactly those passes")
	}
	return ""
}

func TestOptConfigNoOptLevelFlag() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-O", "2", "-main-file", "foo.bn"})
	if len(cli.Error) == 0 { return fail("bni has no -O: the VM runs a fixed pass set") }
	return ""
}

func TestOptConfigFAndFnoIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-flicm", "-fno-licm", "-main-file", "foo.bn"})
	if len(cli.Error) == 0 { return fail("-flicm with -fno-licm must be an error") }
	return ""
}
