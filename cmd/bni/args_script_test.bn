package "main"

import "pkg/builtins/testing"

// `-x` script-mode arg parsing (spec §17.3.1 / plan-shebang.md commit 3).  In
// -x mode the FIRST source file is the sole script and every arg after it is the
// program's own argv -- bni consumes none of them.  Shared helpers seq / fail
// live in args_test.bn (same package).

// `-x s.bn a b -c`: the script is the sole filename; the rest are program argv,
// and flag-looking args after the file are NOT consumed by bni.
func TestParseArgsScriptMode() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-x", "s.bn", "a", "b", "-c"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Script { return fail("-x should set Script") }
	if len(cli.Filenames) != 1 || !seq(cli.Filenames[0], "s.bn") {
		return fail("script should be the sole filename")
	}
	if len(cli.ProgArgs) != 3 {
		return fail("expected 3 program args")
	}
	if !seq(cli.ProgArgs[0], "a") || !seq(cli.ProgArgs[1], "b") || !seq(cli.ProgArgs[2], "-c") {
		return fail("program args should be [a, b, -c]")
	}
	return ""
}

// `-x s.bn --version`: --version AFTER the script is the program's arg, so bni
// does NOT set Version (otherwise it would print bni's version, not run the
// script) -- this is the latent-bug case the pre-parse scan used to mishandle.
func TestParseArgsScriptVersionPassthrough() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-x", "s.bn", "--version"}
	var cli CLIArgs = parseArgs(args)
	if cli.Version {
		return fail("--version after the script must NOT set bni's Version")
	}
	if len(cli.ProgArgs) != 1 || !seq(cli.ProgArgs[0], "--version") {
		return fail("--version should reach the program's argv")
	}
	return ""
}

// `-x s.bn -- a`: a literal `--` after the script is passed through as a program
// arg, NOT consumed as bni's arg separator.
func TestParseArgsScriptDashPassthrough() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-x", "s.bn", "--", "a"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.ProgArgs) != 2 {
		return fail("expected 2 program args")
	}
	if !seq(cli.ProgArgs[0], "--") || !seq(cli.ProgArgs[1], "a") {
		return fail("program args should be [--, a]")
	}
	return ""
}

// `-I dir -x s.bn a`: bni flags BEFORE the script are honored; the script and
// its args follow.
func TestParseArgsScriptWithBniFlag() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "dir", "-x", "s.bn", "a"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 1 || !seq(cli.BniPaths[0], "dir") {
		return fail("-I before -x should be honored")
	}
	if len(cli.Filenames) != 1 || !seq(cli.Filenames[0], "s.bn") {
		return fail("script should be the sole filename")
	}
	if len(cli.ProgArgs) != 1 || !seq(cli.ProgArgs[0], "a") {
		return fail("program args should be [a]")
	}
	return ""
}

// `-x` with no script file: Script is set but there is no filename (runProgram
// then errors on the exactly-one-file check).
func TestParseArgsScriptNoFile() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-x"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Script { return fail("-x should set Script") }
	if len(cli.Filenames) != 0 { return fail("no script file expected") }
	return ""
}

// `--version` OUTSIDE -x mode sets the Version flag (bni prints its version).
func TestParseArgsVersionFlag() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--version"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Version { return fail("--version should set Version") }
	return ""
}

// `prog.bn -- --version`: --version AFTER `--` is the program's arg, not bni's
// flag (the non-script counterpart of the passthrough case).
func TestParseArgsVersionAfterDash() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"prog.bn", "--", "--version"}
	var cli CLIArgs = parseArgs(args)
	if cli.Version { return fail("--version after -- must not set Version") }
	if len(cli.ProgArgs) != 1 || !seq(cli.ProgArgs[0], "--version") {
		return fail("--version should be a program arg")
	}
	return ""
}

// isDir reports an existing directory (used to reject a directory `-x`
// argument).  `/tmp` exists on every host the unit tests run on (the os package
// tests use it); a fabricated path does not.
func TestIsDir() testing.TestResult {
	if !isDir("/tmp") { return fail("/tmp should be a directory") }
	if isDir("/tmp/binate_bni_nonexistent_zzz_qq") {
		return fail("a nonexistent path is not a directory")
	}
	return ""
}
