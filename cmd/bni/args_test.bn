func TestParseArgsImplPathRepeatable() testing.TestResult {
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-L"
	args[1] = "/a"
	args[2] = "--impl-path"
	args[3] = "/b:/c"
	args[4] = "foo.bn"
	var cli CLIArgs = parseArgs(args)
	if len(cli.ImplPaths) != 3 { return fail("expected 3 ImplPath entries") }
	if !seq(cli.ImplPaths[0], "/a") { return fail("ImplPath[0] wrong") }
	if !seq(cli.ImplPaths[1], "/b") { return fail("ImplPath[1] wrong") }
	if !seq(cli.ImplPaths[2], "/c") { return fail("ImplPath[2] wrong") }
