// ============================================================
// -I / --interface-path and -L / --impl-path
// ============================================================

func TestInterfacePathColonList() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-I", "/a:/b:/c", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 3 { return fail("expected 3 BniPath entries") }
	if !seq(cli.BniPaths[0], "/a") || !seq(cli.BniPaths[1], "/b") || !seq(cli.BniPaths[2], "/c") {
		return fail("wrong BniPaths")
	}
	if len(cli.ImplPaths) != 0 { return fail("ImplPaths should stay empty") }
	return ""
}

func TestInterfacePathRepeatable() testing.TestResult {
	var cli CLIArgs = parseArgs(
			@[]@[]char{"-I", "/a:/b", "--interface-path", "/c", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 3 { return fail("expected 3 BniPath entries") }
	if !seq(cli.BniPaths[2], "/c") { return fail("repeated -I should append") }
	return ""
}

func TestImplPathColonList() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-L", "/a:/b:/c", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.ImplPaths) != 3 { return fail("expected 3 ImplPath entries") }
	if !seq(cli.ImplPaths[0], "/a") || !seq(cli.ImplPaths[2], "/c") { return fail("wrong ImplPaths") }
	if len(cli.BniPaths) != 0 { return fail("BniPaths should stay empty") }
	return ""
}

func TestInterfaceAndImplPaths() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-I", "/bni", "-L", "/impl", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 1 || !seq(cli.BniPaths[0], "/bni") { return fail("wrong BniPaths") }
	if len(cli.ImplPaths) != 1 || !seq(cli.ImplPaths[0], "/impl") { return fail("wrong ImplPaths") }
	return ""
}

func TestPathDefaultEmpty() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 0 || len(cli.ImplPaths) != 0 { return fail("paths should default empty") }
	return ""
}

// primaryRoot is the first -I entry (used as the loader root), or empty.
func TestPrimaryRootFromFirstBniPath() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-I", "/my/root", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(primaryRoot(cli), "/my/root") { return fail("primaryRoot should return first -I") }
	return ""
}

func TestPrimaryRootEmptyWithoutBniPath() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(primaryRoot(cli)) != 0 { return fail("primaryRoot should be empty without -I") }
	return ""
}

// ============================================================
// helper functions
// ============================================================

func TestHasSuffixTrue() testing.TestResult {
	if !hasSuffix("hello.bn", ".bn") { return fail("should match .bn") }
	return ""
}

func TestHasSuffixFalse() testing.TestResult {
	if hasSuffix("hello.go", ".bn") { return fail("should not match .bn") }
	return ""
}

func TestHasSuffixTestBn() testing.TestResult {
	if !hasSuffix("foo_test.bn", "_test.bn") { return fail("should match _test.bn") }
	return ""
}

func TestHasSuffixTooShort() testing.TestResult {
	if hasSuffix("x", ".bn") { return fail("shorter than suffix") }
	return ""
}

func TestHasSuffixExact() testing.TestResult {
	if !hasSuffix(".bn", ".bn") { return fail("exact match should work") }
	return ""
}

// isDir reports an existing directory (used to reject a -main-file that names a
// directory).  `/tmp` exists on every host the unit tests run on; a fabricated
// path does not.
func TestIsDir() testing.TestResult {
	if !isDir("/tmp") { return fail("/tmp should be a directory") }
	if isDir("/tmp/binate_bni_nonexistent_zzz_qq") {
		return fail("a nonexistent path is not a directory")
	}
	return ""
}

// TestNoBniArgvLeakUnderTest guards the invariant that a program run under `bni
// -test` sees NONE of bni's own command line.  bni runs the tests in its own VM
// with a shared (injected-native) os, so `runTests` installs an empty program
// argv via setProgramArgs (main.bn) — a test's os.Args() must return just the
// program-name slot, not bni's `-test`/`-I`/`-L` tokens.  This is MEANINGFUL
// under the interpreter unit-test modes (builder-comp-int…), where cmd/bni's own
// tests run under an outer `bni -test` that exercises exactly this
// setProgramArgs path.  bniArgs() is os.Args() minus the program-name slot — the
// tokens the leak would appear in.
func TestNoBniArgvLeakUnderTest() testing.TestResult {
	var args @[]@[]char = bniArgs()
	for i := 0; i < len(args); i++ {
		if streq(args[i], "-test") || streq(args[i], "--test") || streq(args[i], "-I") ||
				streq(args[i], "-L") {
			return fail("bni's own argv (-test/-I/-L) leaked into the test program's os.Args()")
		}
	}
	return ""
}
