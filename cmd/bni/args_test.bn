// Mixed: -I and -L together; paths kept separate.
func TestParseArgsInterfaceAndImplPaths() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/bni", "-L", "/impl", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 1 { return fail("expected 1 BniPath") }
	if len(cli.ImplPaths) != 1 { return fail("expected 1 ImplPath") }
	if !seq(cli.BniPaths[0], "/bni") { return fail("BniPath[0] wrong") }
	if !seq(cli.ImplPaths[0], "/impl") { return fail("ImplPath[0] wrong") }
	return ""
}

// Default (no path flags): both empty.
func TestParseArgsPathDefault() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 0 { return fail("BniPaths should default to empty") }
	if len(cli.ImplPaths) != 0 { return fail("ImplPaths should default to empty") }
	return ""
}

// ============================================================
// hasSuffix tests
// ============================================================

func TestHasSuffixTrue() testing.TestResult {
	if !hasSuffix("hello.bn", ".bn") { return fail("should match .bn") }
	return ""
}

func TestHasSuffixFalse() testing.TestResult {
	if hasSuffix("hello.go", ".bn") { return fail("should not match .bn") }
	return ""
}

func TestHasSuffixTestBn() testing.TestResult {
	if !hasSuffix("foo_test.bn", "_test.bn") { return fail("should match _test.bn") }
	return ""
}

func TestHasSuffixTooShort() testing.TestResult {
	if hasSuffix("x", ".bn") { return fail("shorter than suffix") }
	return ""
}

func TestHasSuffixExact() testing.TestResult {
	if !hasSuffix(".bn", ".bn") { return fail("exact match should work") }
	return ""
}
