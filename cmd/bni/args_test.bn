package "main"

import "pkg/builtin/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// parseArgs tests
// ============================================================

func TestParseArgsSimple() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if !seq(cli.Filenames[0], "foo.bn") { return fail("wrong filename") }
	return ""
}

func TestParseArgsMultipleFiles() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"a.bn", "b.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 2 { return fail("expected 2 filenames") }
	return ""
}

func TestParseArgsWithDash() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn", "--", "arg1", "arg2"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if len(cli.ProgArgs) != 2 { return fail("expected 2 prog args") }
	if !seq(cli.ProgArgs[0], "arg1") { return fail("wrong prog arg 0") }
	return ""
}

func TestParseArgsRoot() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-root", "/my/root", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.RootOverride, "/my/root") { return fail("wrong root") }
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	return ""
}

func TestParseArgsAddRoot() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-add-root", "/extra", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.AddRoots) != 1 { return fail("expected 1 add-root") }
	if !seq(cli.AddRoots[0], "/extra") { return fail("wrong add-root") }
	return ""
}

func TestParseArgsVerbose() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-v", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Verbose { return fail("expected verbose") }
	return ""
}

func TestParseArgsVerboseLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-verbose", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Verbose { return fail("expected verbose") }
	return ""
}

func TestParseArgsEmpty() testing.TestResult {
	var args @[]@[]char
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 0 { return fail("expected 0 filenames") }
	if len(cli.ProgArgs) != 0 { return fail("expected 0 prog args") }
	return ""
}

func TestParseArgsRun() testing.TestResult {
	var args @[]@[]char =
		@[]@[]char{"--test", "--run", "TestFoo", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if !cli.TestMode { return fail("expected TestMode") }
	if !seq(cli.RunFilter, "TestFoo") { return fail("wrong --run filter") }
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if !seq(cli.Filenames[0], "pkg/foo") { return fail("wrong filename") }
	return ""
}

func TestParseArgsRunShort() testing.TestResult {
	var args @[]@[]char =
		@[]@[]char{"--test", "-run", "TestBar", "pkg/bar"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.RunFilter, "TestBar") { return fail("wrong -run filter") }
	return ""
}

func TestParseArgsRunDefaultEmpty() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--test", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.RunFilter) != 0 {
		return fail("expected empty RunFilter when --run absent")
	}
	return ""
}

// `--root` is the new long-flag form; `-root` stays as compat alias.
func TestParseArgsRootLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/my/root", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !seq(cli.RootOverride, "/my/root") { return fail("wrong --root") }
	return ""
}

func TestParseArgsAddRootLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--add-root", "/extra", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.AddRoots) != 1 { return fail("expected 1 add-root") }
	if !seq(cli.AddRoots[0], "/extra") { return fail("wrong add-root") }
	return ""
}

func TestParseArgsVerboseLongDouble() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--verbose", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Verbose { return fail("expected verbose via --verbose") }
	return ""
}

// ============================================================
// -I / --interface-path tests
// ============================================================

func TestParseArgsInterfacePathShort() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/bni-only", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 1 { return fail("expected 1 BniPath entry") }
	if !seq(cli.BniPaths[0], "/bni-only") { return fail("wrong BniPath[0]") }
	if len(cli.ImplPaths) != 0 { return fail("ImplPaths should stay empty") }
	return ""
}

func TestParseArgsInterfacePathLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--interface-path", "/bni-only", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 1 { return fail("expected 1 BniPath entry") }
	if !seq(cli.BniPaths[0], "/bni-only") { return fail("wrong BniPath[0]") }
	return ""
}

func TestParseArgsInterfacePathColonList() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/a:/b:/c", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 3 { return fail("expected 3 BniPath entries") }
	if !seq(cli.BniPaths[0], "/a") { return fail("BniPath[0] wrong") }
	if !seq(cli.BniPaths[1], "/b") { return fail("BniPath[1] wrong") }
	if !seq(cli.BniPaths[2], "/c") { return fail("BniPath[2] wrong") }
	return ""
}

func TestParseArgsInterfacePathRepeatable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/a:/b", "--interface-path", "/c", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.BniPaths) != 3 { return fail("expected 3 BniPath entries") }
	if !seq(cli.BniPaths[0], "/a") { return fail("BniPath[0] wrong") }
	if !seq(cli.BniPaths[1], "/b") { return fail("BniPath[1] wrong") }
	if !seq(cli.BniPaths[2], "/c") { return fail("BniPath[2] wrong") }
	return ""
}

