// ============================================================
// program arguments (the positional tail, run mode only)
// ============================================================

func TestProgArgs() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "f.bn", "arg1", "arg2"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.ProgArgs) != 2 { return fail("expected 2 program args") }
	if !seq(cli.ProgArgs[0], "arg1") || !seq(cli.ProgArgs[1], "arg2") { return fail("wrong ProgArgs") }
	return ""
}

// `--` lets a flag-looking program arg through without bni claiming it.
func TestProgArgsAfterDash() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "f.bn", "--", "--weird", "-x"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.ProgArgs) != 2 { return fail("expected 2 program args") }
	if !seq(cli.ProgArgs[0], "--weird") || !seq(cli.ProgArgs[1], "-x") {
		return fail("wrong ProgArgs")
	}
	return ""
}

func TestNoProgArgs() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-dir", "d"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.ProgArgs) != 0 { return fail("expected no program args") }
	return ""
}

