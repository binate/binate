func TestParseArgsRunAndSkip() testing.TestResult {
	var args @[]@[]char =
		@[]@[]char{"--test", "--run", "TestX", "--skip", "TestSlow", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
