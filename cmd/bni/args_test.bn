func TestParseArgsVerboseLongDouble() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--verbose", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Verbose { return fail("expected verbose via --verbose") }
