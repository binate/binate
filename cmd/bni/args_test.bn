func TestVerbose() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-v", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !cli.Verbose { return fail("expected verbose") }
	return ""
}

// Dash-insensitive: the single-dash long spelling still works.
func TestVerboseSingleDashLong() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-verbose", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !cli.Verbose { return fail("expected verbose via -verbose") }
	return ""
}

func TestCheckNil() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"--check-nil", "-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !cli.CheckNil { return fail("expected CheckNil") }
	return ""
}

func TestCheckNilDefaultOff() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "f.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if cli.CheckNil { return fail("CheckNil should default off") }
	return ""
}

// --version wins with no target required.
func TestVersionFlag() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"--version"})
	if !cli.Version { return fail("--version should set Version") }
	return ""
}

func TestRunFilter() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"--run", "TestFoo", "-test", "pkg/foo"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.RunFilter, "TestFoo") { return fail("wrong --run filter") }
	return ""
}

func TestSkipFilter() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"--skip", "TestSlow", "-test", "pkg/foo"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.SkipFilter, "TestSlow") { return fail("wrong --skip filter") }
	return ""
}

func TestRunSkipDefaultEmpty() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-test", "pkg/foo"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.RunFilter) != 0 || len(cli.SkipFilter) != 0 {
		return fail("--run/--skip should default empty")
