package "main"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// parseArgs tests
// ============================================================

func TestParseArgsSimple() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if !seq(cli.Filenames[0], "foo.bn") { return fail("wrong filename") }
	return ""
}

func TestParseArgsMultipleFiles() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"a.bn", "b.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 2 { return fail("expected 2 filenames") }
	return ""
}

func TestParseArgsWithDash() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn", "--", "arg1", "arg2"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	if len(cli.ProgArgs) != 2 { return fail("expected 2 prog args") }
	if !seq(cli.ProgArgs[0], "arg1") { return fail("wrong prog arg 0") }
	return ""
}

// `--root` was removed in favor of -I/-L (cc-style search paths);
// the first -I entry now seeds bni's notion of the source root.
func TestPrimaryRootFromFirstBniPath() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/my/root", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !seq(primaryRoot(cli), "/my/root") { return fail("primaryRoot should return first -I") }
	if len(cli.Filenames) != 1 { return fail("expected 1 filename") }
	return ""
}

func TestPrimaryRootEmptyWithoutBniPath() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(primaryRoot(cli)) != 0 {
		return fail("primaryRoot should be empty without -I")
	}
	return ""
}

// --root and --add-root used to be flags; after the migration neither
// is recognized and both fall through to the positional branch.  Pin
// that so a stray re-introduction breaks loudly instead of silently
// shadowing source-file args.
func TestParseArgsRootIsPositional() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/proj", "main.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 3 {
		return fail("--root should land in Filenames, not be parsed as a flag")
	}
	if !seq(cli.Filenames[0], "--root")  { return fail("Filenames[0] wrong") }
	if !seq(cli.Filenames[1], "/proj")   { return fail("Filenames[1] wrong") }
	if !seq(cli.Filenames[2], "main.bn") { return fail("Filenames[2] wrong") }
	return ""
}

func TestParseArgsAddRootIsPositional() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--add-root", "/extra", "main.bn"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Filenames) != 3 {
		return fail("--add-root should land in Filenames, not be parsed as a flag")
	}
	if !seq(cli.Filenames[0], "--add-root") { return fail("Filenames[0] wrong") }
	if !seq(cli.Filenames[1], "/extra")     { return fail("Filenames[1] wrong") }
	if !seq(cli.Filenames[2], "main.bn")    { return fail("Filenames[2] wrong") }
	return ""
}

func TestParseArgsVerbose() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-v", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
	if !cli.Verbose { return fail("expected verbose") }
	return ""
}

func TestParseArgsVerboseLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-verbose", "foo.bn"}
	var cli CLIArgs = parseArgs(args)
