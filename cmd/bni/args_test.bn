package "main"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

func seq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// ============================================================
// target selection
// ============================================================

func TestMainFileTarget() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainFile, "foo.bn") { return fail("wrong MainFile") }
	if len(cli.MainDir) != 0 || len(cli.TestPkgs) != 0 { return fail("only MainFile should be set") }
	return ""
}

func TestMainDirTarget() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-dir", "some/dir"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainDir, "some/dir") { return fail("wrong MainDir") }
	return ""
}

func TestTestTargetSingle() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-test", "pkg/foo"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.TestPkgs) != 1 || !seq(cli.TestPkgs[0], "pkg/foo") { return fail("wrong TestPkgs") }
	return ""
}

func TestTestTargetRepeatable() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-test", "pkg/a", "-test", "pkg/b"})
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.TestPkgs) != 2 { return fail("expected 2 test packages") }
	if !seq(cli.TestPkgs[0], "pkg/a") || !seq(cli.TestPkgs[1], "pkg/b") {
		return fail("wrong TestPkgs")
	}
	return ""
}

// ============================================================
// implicit positional main (no -main-* flag)
// ============================================================

// A bare first positional names the main package (dir-vs-file detected at run
// time); everything after it is the program's argv.
func TestImplicitMain() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"foo.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainPath, "foo.bn") { return fail("first positional should be the main path") }
	if len(cli.MainDir) != 0 || len(cli.MainFile) != 0 { return fail("no explicit main flag set") }
	if len(cli.ProgArgs) != 0 { return fail("no program args expected") }
	return ""
}

func TestImplicitMainWithArgs() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"foo.bn", "a", "b"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainPath, "foo.bn") { return fail("wrong MainPath") }
	if len(cli.ProgArgs) != 2 || !seq(cli.ProgArgs[0], "a") || !seq(cli.ProgArgs[1], "b") {
		return fail("wrong ProgArgs")
	}
	return ""
}

// The crux of the shebang fix: a flag-looking program arg after the implicit
// main reaches the program WITHOUT a `--`, because parsing stopped at the main.
func TestImplicitMainFlagArg() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"foo.bn", "--flag", "-x"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainPath, "foo.bn") { return fail("wrong MainPath") }
	if len(cli.ProgArgs) != 2 || !seq(cli.ProgArgs[0], "--flag") || !seq(cli.ProgArgs[1], "-x") {
		return fail("flag-looking args should reach the program verbatim")
	}
	return ""
}

// The canonical shebang form: `bni <flags> -- <script> <args>`.  The `--` ends
// bni's flags so a script named like a flag still lands as the main path.
func TestImplicitMainAfterDashDash() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-I", "x", "--", "-weird.bn", "a"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainPath, "-weird.bn") { return fail("MainPath should be the token after --") }
	if len(cli.ProgArgs) != 1 || !seq(cli.ProgArgs[0], "a") { return fail("wrong ProgArgs") }
	return ""
}

// An explicit -main-file makes every positional the program's argv (not a
// source), the counterpart of the implicit form.
func TestExplicitMainPositionalsAreArgv() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-main-file", "f.bn", "g.bn", "a"})
	if len(cli.Error) > 0 { return cli.Error }
	if !seq(cli.MainFile, "f.bn") { return fail("wrong MainFile") }
	if len(cli.MainPath) != 0 { return fail("MainPath should be unset with an explicit -main-file") }
	if len(cli.ProgArgs) != 2 || !seq(cli.ProgArgs[0], "g.bn") {
		return fail("positionals should be argv")
	}
	return ""
}

// -repl takes an implicit positional context; extra positionals are an error.
func TestReplImplicitContext() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-repl", "ctx.bn"})
	if len(cli.Error) > 0 { return cli.Error }
	if !cli.Repl { return fail("expected Repl") }
	if !seq(cli.MainPath, "ctx.bn") { return fail("repl context should be the positional") }
	return ""
}

func TestReplImplicitContextExtraIsError() testing.TestResult {
	var cli CLIArgs = parseArgs(@[]@[]char{"-repl", "ctx.bn", "extra"})
	if len(cli.Error) == 0 { return fail("a REPL takes no program arguments") }
	return ""
}

