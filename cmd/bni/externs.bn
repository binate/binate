package "main"

import "pkg/rt"
import "pkg/vm"

// registerStandardExterns binds host-package functions into the
// VM's extern registry, so BC_CALL-by-name dispatches through the
// always-shim convention via rt._call_shim_scalar (the same path
// dispatchCompiledFuncValue uses for bytecode→compiled function-
// value calls) rather than vm_extern.bn's hand-coded if-streq
// switch.
//
// Migration in progress (see claude-todo.md
// "VM extern dispatch: name → function-value registry"):
// only scalar-return signatures (≤7 int/pointer args) can route
// through the registry today.  Multi-word returns (rt.MakeManagedSlice,
// bootstrap.Args/ReadDir) and refcount-surgical paths stay in the
// hand-coded vm_extern.bn until an aggregate-trampoline shim shape
// lands.
//
// Keeping registration as a localized helper here (rather than as
// a "register-all-the-standard-things" library entry point in
// pkg/vm) keeps the binding list under cmd/bni's control and
// makes it easy to test in isolation.
func registerStandardExterns(vmInst @vm.VM) {
	// rt.Alloc — proof-of-concept slice.  See claude-todo.md.
	var allocFV *func(int) *uint8 = rt.Alloc
	vm.RegisterExtern(vmInst, "rt.Alloc",
		bit_cast(*uint8, &allocFV))
}
