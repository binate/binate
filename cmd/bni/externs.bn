package "main"

import "pkg/vm"

// registerStandardExterns is cmd/bni's local hook for populating the
// VM's extern registry at startup.  Currently a thin delegate to
// vm.RegisterStandardExterns (which covers the rt.* surface) — the
// bni-only externs that pkg/vm can't register on its own (pkg/libc
// and the C-shaped pkg/bootstrap surface) need an aggregate-shim
// shape that hasn't landed yet, so they continue to dispatch via
// vm_extern.bn's hand-coded arms.  This wrapper is the attachment
// point for those pure-C registrations once the shim work lands.
func registerStandardExterns(vmInst @vm.VM) {
	vm.RegisterStandardExterns(vmInst)
}
