package "main"

import "pkg/binate/vm"
import "pkg/bootstrap"

// registerStandardExterns is the testable entry point — a thin
// delegate to vm.RegisterStandardExterns (which covers pkg/builtins/rt,
// the host package with `.bn` bodies that BC_FUNC_VALUE can
// resolve in bytecode test contexts).  The pure-C extern set
// lives in registerPureCExterns below; cmd/bni's main calls both,
// but tests only call this one.
func registerStandardExterns(vmInst @vm.VM) {
	vm.RegisterStandardExterns(vmInst)
}

// registerPureCExterns registers the C-shaped externs (the C-only
// pkg/bootstrap surface) that have no Binate `.bn` body.  CALLABLE
// ONLY FROM NATIVE CODE (cmd/bni's main): BC_FUNC_VALUE on a function
// with no `.bn` body fails LookupFunc when run as bytecode, so test
// contexts that exercise this from bytecode would crash here.
// cmd/bni's main is always native, so the registrations succeed at
// runtime; conformance tests indirectly verify behavior via real
// cmd/bni runs.
func registerPureCExterns(vmInst @vm.VM) {
	registerBootstrapExterns(vmInst)
}

// registerBootstrapExterns binds pkg/bootstrap into the registry.
// bootstrap is native-only in the VM (cmd/bni skips lowering it), so
// every bytecode-reachable symbol is registered here: the C-shaped I/O
// (Close/Exit/Open/Read/Write/Stat/Exec/Args/ReadDir) plus the format
// helpers (formatInt/Int64/Uint/Bool/Float, Itoa).  bootstrap.Args is
// the aggregate case (returns @[]@[]char = 32-byte managed-slice
// header) — its migration via the aggregate shim eliminates the
// previous RefInc surgery in vm_extern.bn.
//
// bootstrap.Args is bound to progArgsAfterDash (NOT directly to
// bootstrap.Args), so programs running in the inner VM see args
// after `--` — matching the spec (explorations/bootstrap-subset.md
// §"Args") and the Go bootstrap interpreter.  Without this shim,
// builder-comp-int-int infinite-recurses: the inner cmd/bni would
// receive the outer's full argv (including `cmd/bni` itself) and
// re-invoke runProgram on cmd/bni for every level of nesting.
func registerBootstrapExterns(vmInst @vm.VM) {
	const scalar int = 8
	var btClose *func(int) int = bootstrap.Close
	vmInst.RegisterExtern("pkg/bootstrap.Close", bit_cast(*uint8, &btClose),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Close)))
	var btExit *func(int) = bootstrap.Exit
	vmInst.RegisterExtern("pkg/bootstrap.Exit", bit_cast(*uint8, &btExit),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Exit)))

	// Aggregate-return: bootstrap.Args / ReadDir return
	// @[]@[]char (32-byte managed-slice header).  The retbuf-style
	// aggregate shim eliminates the RefInc-surgery that the legacy
	// vm_extern.bn arms required: the shim's SSA value has no
	// scope-cleanup RefDec, so the +1 from the native call flows
	// cleanly into the retbuf and onward to the bytecode caller's
	// local without double-decrementing.
	var btArgs *func() @[]@[]char = progArgsAfterDash
	vmInst.RegisterExtern("pkg/bootstrap.Args", bit_cast(*uint8, &btArgs),
		32, bit_cast(int, _raw_func_addr(progArgsAfterDash)))

	// Slice-arg pure-C externs.  The aggregate-arg shim convention
	// (emit_funcvals.bn — `i8*` + dereference) handles the 16-byte
	// slice / managed-slice arguments through the registry's int-args
	// dispatch shape: args[i] carries the slice's address; the shim
	// loads before calling the underlying.  Pre-migration these were
	// hand-coded arms in vm_extern.bn doing the same dereference
	// inline; the registry path replaces them uniformly.
	var btStat *func(*[]readonly char) int = bootstrap.Stat
	vmInst.RegisterExtern("pkg/bootstrap.Stat", bit_cast(*uint8, &btStat),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Stat)))
	var btOpen *func(*[]readonly char, int) int = bootstrap.Open
	vmInst.RegisterExtern("pkg/bootstrap.Open", bit_cast(*uint8, &btOpen),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Open)))
	var btWrite *func(int, *[]readonly uint8) int = bootstrap.Write
	vmInst.RegisterExtern("pkg/bootstrap.Write", bit_cast(*uint8, &btWrite),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Write)))
	var btRead *func(int, *[]uint8) int = bootstrap.Read
	vmInst.RegisterExtern("pkg/bootstrap.Read", bit_cast(*uint8, &btRead),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Read)))
	var btExec *func(*[]readonly char, *[]@[]char) int = bootstrap.Exec
	vmInst.RegisterExtern("pkg/bootstrap.Exec", bit_cast(*uint8, &btExec),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.Exec)))
	var btReadDir *func(*[]readonly char) @[]@[]char = bootstrap.ReadDir
	vmInst.RegisterExtern("pkg/bootstrap.ReadDir", bit_cast(*uint8, &btReadDir),
		32, bit_cast(int, _raw_func_addr(bootstrap.ReadDir)))

	// Format helpers.  bootstrap is native-only in the VM (cmd/bni skips
	// lowering it), so these formerly-bytecode helpers must be registered
	// too — print/println lower to formatInt64 + Write.  Five return int
	// (scalar); Itoa returns @[]char (32).  formatFloat's float64 arg
	// rides the all-int shim ABI (see plan-float-arg-shim.md).
	var btFormatInt *func(int, *[]uint8) int = bootstrap.formatInt
	vmInst.RegisterExtern("pkg/bootstrap.formatInt", bit_cast(*uint8, &btFormatInt),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.formatInt)))
	var btFormatInt64 *func(int64, *[]uint8) int = bootstrap.formatInt64
	vmInst.RegisterExtern("pkg/bootstrap.formatInt64", bit_cast(*uint8, &btFormatInt64),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.formatInt64)))
	var btFormatUint *func(uint64, *[]uint8) int = bootstrap.formatUint
	vmInst.RegisterExtern("pkg/bootstrap.formatUint", bit_cast(*uint8, &btFormatUint),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.formatUint)))
	var btFormatBool *func(bool, *[]uint8) int = bootstrap.formatBool
	vmInst.RegisterExtern("pkg/bootstrap.formatBool", bit_cast(*uint8, &btFormatBool),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.formatBool)))
	var btFormatFloat *func(float64, *[]uint8) int = bootstrap.formatFloat
	vmInst.RegisterExtern("pkg/bootstrap.formatFloat", bit_cast(*uint8, &btFormatFloat),
		scalar, bit_cast(int, _raw_func_addr(bootstrap.formatFloat)))
	var btItoa *func(int) @[]char = bootstrap.Itoa
	vmInst.RegisterExtern("pkg/bootstrap.Itoa", bit_cast(*uint8, &btItoa),
		32, bit_cast(int, _raw_func_addr(bootstrap.Itoa)))
}

// argsAfterDash returns the elements of `args` after the first `--`
// separator, or an empty slice if there's no `--`.  Pure helper
// (no I/O) — exposed as a separate function so the unit test can
// exercise filtering without depending on the host process's argv.
func argsAfterDash(args @[]@[]char) @[]@[]char {
	var dashIdx int = -1
	for i := 0; i < len(args); i++ {
		if streq(args[i], "--") { dashIdx = i; break }
	}
	if dashIdx < 0 { return make_slice(@[]char, 0) }
	var n int = len(args) - (dashIdx + 1)
	var result @[]@[]char = make_slice(@[]char, n)
	for i := 0; i < n; i++ {
		result[i] = args[dashIdx + 1 + i]
	}
	return result
}

// progArgsAfterDash is the inner-VM's view of bootstrap.Args.
// Calls the host's bootstrap.Args (full argv[1..]) and strips
// everything up to and including the first `--`.  Registered in
// place of bootstrap.Args by registerBootstrapExterns; see that
// function's doc for why.
func progArgsAfterDash() @[]@[]char {
	return argsAfterDash(bootstrap.Args())
}
