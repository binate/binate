package "main"

import "pkg/bootstrap"
import "pkg/libc"
import "pkg/vm"

// registerStandardExterns is the testable entry point — a thin
// delegate to vm.RegisterStandardExterns (which covers pkg/rt,
// the host package with `.bn` bodies that BC_FUNC_VALUE can
// resolve in bytecode test contexts).  The pure-C extern set
// lives in registerPureCExterns below; cmd/bni's main calls both,
// but tests only call this one.
func registerStandardExterns(vmInst @vm.VM) {
	vm.RegisterStandardExterns(vmInst)
}

// registerPureCExterns registers the C-shaped externs (pkg/libc
// and the C-only pkg/bootstrap surface) that have no Binate `.bn`
// body.  CALLABLE ONLY FROM NATIVE CODE (cmd/bni's main):
// BC_FUNC_VALUE on a function with no `.bn` body fails LookupFunc
// when run as bytecode, so test contexts that exercise this from
// bytecode would crash here.  cmd/bni's main is always native, so
// the registrations succeed at runtime; conformance tests
// indirectly verify behavior via real cmd/bni runs.
func registerPureCExterns(vmInst @vm.VM) {
	registerLibcExterns(vmInst)
	registerBootstrapExterns(vmInst)
}

// registerLibcExterns binds pkg/libc.* into the registry.  All
// scalar-return signatures (≤ 8-byte return).  Internal helper
// of registerPureCExterns; never called from bytecode test
// contexts.
func registerLibcExterns(vmInst @vm.VM) {
	const scalar int = 8
	var libcMalloc *func(int) *uint8 = libc.Malloc
	vm.RegisterExtern(vmInst, "libc.Malloc",
		bit_cast(*uint8, &libcMalloc), scalar)
	var libcCalloc *func(int, int) *uint8 = libc.Calloc
	vm.RegisterExtern(vmInst, "libc.Calloc",
		bit_cast(*uint8, &libcCalloc), scalar)
	var libcFree *func(*uint8) = libc.Free
	vm.RegisterExtern(vmInst, "libc.Free",
		bit_cast(*uint8, &libcFree), scalar)
	var libcMemset *func(*uint8, int, int) = libc.Memset
	vm.RegisterExtern(vmInst, "libc.Memset",
		bit_cast(*uint8, &libcMemset), scalar)
	var libcMemcpy *func(*uint8, *const uint8, int) = libc.Memcpy
	vm.RegisterExtern(vmInst, "libc.Memcpy",
		bit_cast(*uint8, &libcMemcpy), scalar)
	var libcExit *func(int) = libc.Exit
	vm.RegisterExtern(vmInst, "libc.Exit",
		bit_cast(*uint8, &libcExit), scalar)
}

// registerBootstrapExterns binds the C-shaped pkg/bootstrap surface
// (Close / Exit / Args) into the registry.  bootstrap.Args is the
// aggregate case (returns @[]@[]char = 32-byte managed-slice
// header) — its migration via the aggregate shim eliminates the
// previous RefInc surgery in vm_extern.bn.  Open / Read / Write /
// Stat / Exec / ReadDir aren't migrated yet (slice-typed args
// can't be passed through the int-only shim shape).
//
// bootstrap.Args is bound to progArgsAfterDash (NOT directly to
// bootstrap.Args), so programs running in the inner VM see args
// after `--` — matching the spec (explorations/bootstrap-subset.md
// §"Args") and the Go bootstrap interpreter.  Without this shim,
// boot-comp-int-int infinite-recurses: the inner cmd/bni would
// receive the outer's full argv (including `cmd/bni` itself) and
// re-invoke runProgram on cmd/bni for every level of nesting.
func registerBootstrapExterns(vmInst @vm.VM) {
	const scalar int = 8
	var btClose *func(int) int = bootstrap.Close
	vm.RegisterExtern(vmInst, "bootstrap.Close",
		bit_cast(*uint8, &btClose), scalar)
	var btExit *func(int) = bootstrap.Exit
	vm.RegisterExtern(vmInst, "bootstrap.Exit",
		bit_cast(*uint8, &btExit), scalar)

	// Aggregate-return: bootstrap.Args / ReadDir return
	// @[]@[]char (32-byte managed-slice header).  The retbuf-style
	// aggregate shim eliminates the RefInc-surgery that the legacy
	// vm_extern.bn arms required: the shim's SSA value has no
	// scope-cleanup RefDec, so the +1 from the native call flows
	// cleanly into the retbuf and onward to the bytecode caller's
	// local without double-decrementing.
	var btArgs *func() @[]@[]char = progArgsAfterDash
	vm.RegisterExtern(vmInst, "bootstrap.Args",
		bit_cast(*uint8, &btArgs), 32)
}

// argsAfterDash returns the elements of `args` after the first `--`
// separator, or an empty slice if there's no `--`.  Pure helper
// (no I/O) — exposed as a separate function so the unit test can
// exercise filtering without depending on the host process's argv.
func argsAfterDash(args @[]@[]char) @[]@[]char {
	var dashIdx int = -1
	for i := 0; i < len(args); i++ {
		if streq(args[i], "--") { dashIdx = i; break }
	}
	if dashIdx < 0 { return make_slice(@[]char, 0) }
	var n int = len(args) - (dashIdx + 1)
	var result @[]@[]char = make_slice(@[]char, n)
	for i := 0; i < n; i++ {
		result[i] = args[dashIdx + 1 + i]
	}
	return result
}

// progArgsAfterDash is the inner-VM's view of bootstrap.Args.
// Calls the host's bootstrap.Args (full argv[1..]) and strips
// everything up to and including the first `--`.  Registered in
// place of bootstrap.Args by registerBootstrapExterns; see that
// function's doc for why.
func progArgsAfterDash() @[]@[]char {
	return argsAfterDash(bootstrap.Args())
}
