package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/loader"

// fileHasGenericDecl reports whether any top-level decl in f is generic
// (carries type parameters) — a func/type/interface whose body the consumer
// monomorphizes, and whose calls to f's package's imports need those imports'
// func signatures/externs registered (see registerGenericBodyExternDeps).
func fileHasGenericDecl(f @ast.File) bool {
	if f == nil { return false }
	for i := 0; i < len(f.Decls); i++ {
		if len(f.Decls[i].TypeParams) > 0 { return true }
	}
	return false
}

// pathInList reports whether `p` is present in `list`.
func pathInList(list @[]@[]char, p *[]readonly char) bool {
	for i := 0; i < len(list); i++ {
		if streq(list[i], p) { return true }
	}
	return false
}

// registerGenericBodyExternDeps registers func sigs/externs for the imports of
// any directly-imported package that contains GENERIC decls — the packages a
// monomorphized generic body may CALL.  The VM needs these too: even though it
// resolves symbols via its runtime registry, the call's RESULT TYPE is fixed at
// IR-gen time, and without the callee's real signature a struct-returning
// transitive call is lowered as a scalar (garbage).  Mirrors
// cmd/bnc/compile_imports.bn:registerGenericBodyExternDeps.
func registerGenericBodyExternDeps(ldr @loader.Loader, directPaths @[]@[]char,
		gc @ir.GenCtx) {
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(directPaths); i++ {
		var pf @ast.File = collectPkgFile(ldr, directPaths[i])
		if pf == nil || !fileHasGenericDecl(pf) { continue }
		var dp @loader.Package = ldr.GetPackage(directPaths[i])
		if dp == nil { continue }
		for j := 0; j < len(dp.Imports); j++ {
			var q @[]char = dp.Imports[j]
			if pathInList(directPaths, q) { continue }
			if pathInList(aliases, q) { continue }
			var qf @ast.File = collectPkgFile(ldr, q)
			if qf == nil { continue }
			aliases = appendCharSlice(aliases, q)
			paths = appendCharSlice(paths, q)
			files = appendFilePtr(files, qf)
		}
	}
	if len(aliases) > 0 {
		ir.RegisterFuncExterns(aliases, paths, files, gc)
	}
}

// registerPkgImports registers import information for IR gen.
func registerPkgImports(ldr @loader.Loader,
	pkg @loader.Package, gc @ir.GenCtx) {
	registerAllStructTypes(ldr, gc)
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(
				ldr, pkg.Imports[j])
			if depFile != nil {
				// Full import path as the registration key so two same-final-
				// segment packages don't collide under the short-name alias map.
				aliases = appendCharSlice(aliases,
					pkg.Imports[j])
				paths = appendCharSlice(paths, pkg.Imports[j])
				files = appendFilePtr(files, depFile)
			}
		}
	}
	if !streq(pkg.Path, "pkg/builtins/rt") {
		appendRtImport(ldr, &aliases, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/bootstrap") {
		appendBootstrapImport(ldr, &aliases, &paths, &files)
	}
	if !streq(pkg.Path, "pkg/builtins/lang") {
		appendLangImport(ldr, &aliases, &paths, &files)
	}
	ir.RegisterImports(aliases, paths, files, gc)
	registerGenericBodyExternDeps(ldr, pkg.Imports, gc)
}

// registerMainImports registers imports for the main package.
func registerMainImports(ldr @loader.Loader,
	file @ast.File, gc @ir.GenCtx) {
	registerAllStructTypes(ldr, gc)
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	var imports @[]@[]char
	for i := 0; i < len(file.Imports); i++ {
		imports = appendCharSlice(imports, unquote(file.Imports[i].Path))
	}
	for j := 0; j < len(imports); j++ {
		var depFile @ast.File = collectPkgFile(ldr, imports[j])
		if depFile != nil {
			// Full import path as the registration key (see above).
			aliases = appendCharSlice(aliases, imports[j])
			paths = appendCharSlice(paths, imports[j])
			files = appendFilePtr(files, depFile)
		}
	}
	appendRtImport(ldr, &aliases, &paths, &files)
	appendBootstrapImport(ldr, &aliases, &paths, &files)
	appendLangImport(ldr, &aliases, &paths, &files)
	ir.RegisterImports(aliases, paths, files, gc)
	registerGenericBodyExternDeps(ldr, imports, gc)
}

// appendRtImport adds pkg/builtins/rt as an implicit import if not already
// present.
func appendRtImport(ldr @loader.Loader,
	aliases *@[]@[]char, paths *@[]@[]char,
	files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "pkg/builtins/rt") { return }
	}
	var rtPkg @loader.Package = ldr.GetPackage(
		"pkg/builtins/rt")
	if rtPkg == nil { return }
	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*aliases = appendCharSlice(*aliases, "pkg/builtins/rt")
	*paths = appendCharSlice(*paths, "pkg/builtins/rt")
	*files = appendFilePtr(*files, rtFile)
}

// appendBootstrapImport adds pkg/bootstrap as an implicit import if
// not already present. The print/println builtin's IR-gen lowering
// emits direct calls into pkg/bootstrap (formatInt + Write), so
// every IR module needs the signatures available even when user
// code doesn't import pkg/bootstrap explicitly.
//
// Prefers the merged file (.bni + .bn) over .bni-alone so that
// IR-gen can distinguish bodied (pure-Binate) from unbodied (true
// C extern) decls — the IsCExtern / sret ABI hint depends on it.
func appendBootstrapImport(ldr @loader.Loader,
	aliases *@[]@[]char, paths *@[]@[]char,
	files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "pkg/bootstrap") { return }
	}
	var bsPkg @loader.Package = ldr.GetPackage(
		"pkg/bootstrap")
	if bsPkg == nil { return }
	var bsFile @ast.File
	if bsPkg.Merged != nil {
		bsFile = bsPkg.Merged
	} else if bsPkg.BNI != nil {
		bsFile = bsPkg.BNI
	}
	if bsFile == nil { return }
	*aliases = appendCharSlice(*aliases, "pkg/bootstrap")
	*paths = appendCharSlice(*paths, "pkg/bootstrap")
	*files = appendFilePtr(*files, bsFile)
}

// appendLangImport adds pkg/builtins/lang as an implicit import if not
// already present.  The compiler force-loads lang (ensureLangLoaded) so
// `myInt.String()` resolves without the caller importing lang; a module
// that calls such a method then needs lang's signatures registered so
// the cross-package call resolves in the IR.  Mirrors
// appendBootstrapImport (and cmd/bnc/compile_imports.bn:appendLangImport).
func appendLangImport(ldr @loader.Loader,
	aliases *@[]@[]char, paths *@[]@[]char,
	files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq((*aliases)[i], "pkg/builtins/lang") { return }
	}
	var langPkg @loader.Package = ldr.GetPackage(
		"pkg/builtins/lang")
	if langPkg == nil { return }
	var langFile @ast.File
	if langPkg.Merged != nil {
		langFile = langPkg.Merged
	} else if langPkg.BNI != nil {
		langFile = langPkg.BNI
	}
	if langFile == nil { return }
	*aliases = appendCharSlice(*aliases, "pkg/builtins/lang")
	*paths = appendCharSlice(*paths, "pkg/builtins/lang")
	*files = appendFilePtr(*files, langFile)
}

// registerAllStructTypes registers struct types from all loaded
// packages so the IR gen can resolve cross-package struct types.
// Uses ir.RegisterStructTypes which registers names across all
// packages first (qualified), then populates fields. This way
// cross-package field references like `Pos token.Pos` in ast.bni
// resolve to the actual Pos struct, not a TypInt fallback.
func registerAllStructTypes(ldr @loader.Loader, gc @ir.GenCtx) {
	if len(ldr.Order) == 0 { return }
	var aliases @[]@[]char
	var paths @[]@[]char
	var files @[]@ast.File
	for i := 0; i < len(ldr.Order); i++ {
		var depFile @ast.File = collectPkgFile(
			ldr, ldr.Order[i])
		if depFile != nil {
			// Full import path as the registration key (same-final-segment
			// packages must not collide under the short-name alias map).
			aliases = appendCharSlice(aliases,
				ldr.Order[i])
			paths = appendCharSlice(paths, ldr.Order[i])
			files = appendFilePtr(files, depFile)
		}
	}
	// paths[k] carries each package's import path; the registries
	// use it directly for qualification so two same-last-segment
	// packages get distinct entries instead of colliding under the
	// alias map.  The alias map itself is populated only by the
	// importing module's RegisterImports.
	ir.RegisterStructTypes(aliases, paths, files, gc)
	ir.RegisterAllInterfaces(aliases, paths, files, gc)
}

// collectPkgFile returns the .bni file (or merged .bn) for a loaded
// package — whichever the loader populated from the -I/-L search paths —
// or nil if the package carries no file.
func collectPkgFile(ldr @loader.Loader,
	pkgPath *[]readonly char) @ast.File {
	var pkg @loader.Package = ldr.GetPackage(
		pkgPath)
	if pkg == nil { return nil }
	// Prefer merged (.bni + .bn) so IR-gen can distinguish bodied
	// (pure-Binate) from unbodied (true C extern) decls — needed
	// for the IsCExtern / sret ABI hint.
	if pkg.Merged != nil { return pkg.Merged }
	if pkg.BNI != nil { return pkg.BNI }
	return nil
}

// shortName extracts the last component of a package path.
func shortName(path *[]readonly char) @[]char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { last = i + 1 }
	}
	return buf.CopyStr(path[last:])
}

// unquote removes surrounding quotes from a string.
func unquote(s *[]readonly char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return buf.CopyStr(s[1:len(s)-1])
	}
	return buf.CopyStr(s)
}
