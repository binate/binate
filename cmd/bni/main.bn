package "main"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/debug"
import "pkg/ir"
import "pkg/loader"
import "pkg/mangle"
import "pkg/parser"
import "pkg/types"
import "pkg/vm"

// Self-hosted bytecode interpreter.
// Usage: bni <file.bn|dir> [-- progargs...]
//        bni --test [--run <substr>] [-I <dir>] <pkg/foo> [pkg/bar ...]
//        bni --repl <file.bn|dir>

// main is the entry point for the bytecode interpreter CLI.
func main() {
	var args @[]@[]char = bootstrap.Args()
	if len(args) == 0 {
		print(
			"usage: bni <file.bn|dir> [-- args...]\n"
			"       bni --test [--run <substr>] [-I <dir>] <pkg/foo> [pkg/bar ...]\n"
			"       bni --repl <file.bn|dir>\n")
		bootstrap.Exit(1)
	}

	var cli CLIArgs = parseArgs(args)
	if cli.Verbose {
		debug.SetVerbose(true)
	}

	if cli.TestMode {
		runTests(cli)
	} else if cli.Repl {
		runRepl(cli)
	} else {
		runProgram(cli)
	}
}

// runProgram parses, type-checks, generates IR, lowers to bytecode,
// and runs main() in the VM.
func runProgram(cli CLIArgs) {
	cli.Filenames = expandDirArgs(cli.Filenames)
	if len(cli.Filenames) == 0 {
		println("error: no source files")
		bootstrap.Exit(1)
	}

	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var merged @ast.File = loader.MergeFiles(files)
	debug.Log("parsed and merged source files")

	var root @[]char = buf.CopyStr(
		resolveRoot(primaryRoot(cli), cli.Filenames[0]))

	var ldr @loader.Loader = loader.NewLoader(root)
	applyPathFlags(ldr, cli)
	ldr.LoadImports(merged.Imports)
	ensureBootstrapLoaded(ldr)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}
	debug.Log("imports loaded successfully")

	var checker @types.Checker = typecheckAll(ldr, root, merged)
	ir.SetChecker(checker)

	// Build VM and lower all packages.  Track which packages
	// emit a `<pkg>.__init` (top-level var initializers) so the
	// main module's init dispatcher can list them in dep order
	// — same shape as cmd/bnc's compile loop.
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)
	registerStandardExterns(vmInst)
	registerPureCExterns(vmInst)
	var initPkgNames @[]@[]char
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(
			ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.Merged == nil { continue }
		var mod @ir.Module = ir.InitModule(
			quotePath(ldr.Order[i]))
		registerPkgImports(ldr, pkg, mod, root, cli.BniPaths)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(pkg.BNI)
		}
		ir.GeneratePackage(pkg.Merged, mod)
		if mod.HasPackageInit() {
			initPkgNames = appendCharSlice(initPkgNames,
				ir.PackageInitName(
					mangle.PkgPathFromQuoted(
						quotePath(ldr.Order[i]))))
		}
		vmInst.LowerModule(mod)
	}

	// Lower main package, then emit + lower the init dispatcher
	// and entry wrapper.  Order matters: GeneratePackage may
	// itself add `main.__init` to mainMod, so check it BEFORE
	// emitting the dispatcher.
	var mainMod @ir.Module = ir.InitModule(merged.PkgName)
	registerMainImports(ldr, merged, mainMod, root,
		cli.BniPaths)
	ir.GeneratePackage(merged, mainMod)
	if mainMod.HasPackageInit() {
		initPkgNames = appendCharSlice(initPkgNames,
			ir.PackageInitName(
				mangle.PkgPathFromQuoted(merged.PkgName)))
	}
	mainMod.EmitInitDispatcher(initPkgNames)
	mainMod.EmitMainEntry()
	vmInst.LowerModule(mainMod)

	// Dispatch through `main.__entry` (the synthetic wrapper
	// emitted by ir.EmitMainEntry on the main module), which
	// runs the init dispatcher and then calls main.main.  Same
	// chain compiled mode goes through; this keeps a single
	// source of truth for the entry sequence.
	debug.Log("calling main.__entry()")
	var noArgs @[]int
	vmInst.CallFunc("main.__entry", noArgs)
}

// runTests discovers and runs Test* functions in the specified
// packages via the bytecode VM.
func runTests(cli CLIArgs) {
	if len(cli.Filenames) == 0 {
		println("error: --test requires package paths (e.g. pkg/foo)")
		bootstrap.Exit(1)
	}

	var root @[]char = primaryRoot(cli)
	if len(root) == 0 {
		root = buf.CopyStr(".")
	}

	// Set up loader with test packages enabled
	var ldr @loader.Loader = loader.NewLoader(root)
	applyPathFlags(ldr, cli)
	for i := 0; i < len(cli.Filenames); i++ {
		ldr.TestPackages = appendCharSlice(
			ldr.TestPackages, cli.Filenames[i])
	}

	// Synthetic imports to load test packages and their deps
	var syntheticImps @[]@ast.ImportSpec
	for i := 0; i < len(cli.Filenames); i++ {
		var imp @ast.ImportSpec = make(ast.ImportSpec)
		imp.Path = quotePath(cli.Filenames[i])
		syntheticImps = appendImportSpec(syntheticImps, imp)
	}
	ldr.LoadImports(syntheticImps)
	ensureBootstrapLoaded(ldr)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}

	var checker @types.Checker = typecheckPackages(ldr, root)
	ir.SetChecker(checker)

	// Build VM and lower all packages
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)
	registerStandardExterns(vmInst)
	registerPureCExterns(vmInst)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(
			ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.Merged == nil { continue }
		var mod @ir.Module = ir.InitModule(
			quotePath(ldr.Order[i]))
		registerPkgImports(ldr, pkg, mod, root, cli.BniPaths)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(pkg.BNI)
		}
		ir.GeneratePackage(pkg.Merged, mod)
		vmInst.LowerModule(mod)
	}

	// Discover and run Test* functions
	var passed int = 0
	var failed int = 0
	var skipped int = 0

	for pi := 0; pi < len(cli.Filenames); pi++ {
		var pkgPath @[]char = cli.Filenames[pi]
		var pkg @loader.Package = ldr.GetPackage(
			pkgPath)
		if pkg == nil || pkg.Merged == nil {
			print("warning: no implementation for ")
			println(pkgPath)
			continue
		}

		// Find Test* functions.  When --run is non-empty, only
		// include names that contain it as a substring; when --skip
		// is non-empty, exclude names that contain it (skip wins
		// over run when both match).  Mirrors `go test -run`/`-skip`
		// but plain substring.
		var testNames @[]@[]char
		for di := 0; di < len(pkg.Merged.Decls); di++ {
			var d @ast.Decl = pkg.Merged.Decls[di]
			if d.Kind != ast.DECL_FUNC { continue }
			if d.Body == nil { continue }
			if !hasPrefix(d.Name, "Test") { continue }
			if len(d.Params) != 0 { continue }
			if !isTestResultReturn(d) { continue }
			if !containsStr(d.Name, cli.RunFilter) { continue }
			if len(cli.SkipFilter) > 0 &&
					containsStr(d.Name, cli.SkipFilter) {
				skipped = skipped + 1
				continue
			}
			testNames = appendCharSlice(
				testNames, d.Name)
		}

		if len(testNames) == 0 {
			print("?   \t")
			print(pkgPath)
			println("\t[no test functions]")
			continue
		}

		var pkgFailed int = 0
		for ti := 0; ti < len(testNames); ti++ {
			print("=== RUN   ")
			println(testNames[ti])

			var noArgs @[]int
			// CallFunc looks up via the full pkgPath-qualified name
			// (matches mangle.QualifyName since 7f989ad's full-path
			// flip — short-segment forms no longer match the stored
			// keys, so every -int unit test would otherwise miss with
			// "function not found").
			var qualName @[]char = buf.Concat(
				buf.Concat(pkgPath, "."), testNames[ti])
			var rc int = vmInst.CallFunc(qualName, noArgs)
			// Test returns @[]char (testing.TestResult).
			// Empty string = pass, non-empty = fail.
			// rc is the pointer to the @[]char header.
			var failMsg @[]char = readResultStr(rc)
			if len(failMsg) > 0 {
				print("--- FAIL: ")
				println(testNames[ti])
				print("    ")
				println(failMsg)
				failed = failed + 1
				pkgFailed = pkgFailed + 1
			} else {
				print("--- PASS: ")
				println(testNames[ti])
				passed = passed + 1
			}
		}

		if pkgFailed > 0 {
			print("FAIL\t")
			println(pkgPath)
		} else {
			print("ok  \t")
			print(pkgPath)
			print("\t")
			print(bootstrap.Itoa(len(testNames)))
			println(" tests")
		}
	}

	// Summary
	println("")
	if failed > 0 {
		print("FAIL\t")
		print(bootstrap.Itoa(passed))
		print(" passed, ")
		print(bootstrap.Itoa(failed))
		print(" failed")
		if skipped > 0 {
			print(", ")
			print(bootstrap.Itoa(skipped))
			print(" skipped")
		}
		println("")
		bootstrap.Exit(1)
	} else {
		print("ok\t")
		print(bootstrap.Itoa(passed))
		print(" passed")
		if skipped > 0 {
			print(", ")
			print(bootstrap.Itoa(skipped))
			print(" skipped")
		}
		println("")
	}
}

// readResultStr reads a @[]char value from a VM stack address.
// VM functions returning @[]char put a pointer to a 4-word
// managed-slice header on the VM stack. Empty → "".
func readResultStr(addr int) @[]char {
	if addr == 0 { return "" }
	var hdr *int = bit_cast(*int, addr)
	var slen int = hdr[1]
	if slen == 0 { return "" }
	var data *uint8 = bit_cast(*uint8, hdr[0])
	var s @[]char = make_slice(char, slen)
	for i := 0; i < slen; i++ {
		s[i] = cast(char, data[i])
	}
	return s
}

// isTestResultReturn checks if a func decl has a single return
// type that is testing.TestResult or @[]char.
func isTestResultReturn(d @ast.Decl) bool {
	if len(d.Results) != 1 { return false }
	var r @ast.TypeExpr = d.Results[0]
	if r.Kind == ast.TEXPR_NAMED && len(r.Pkg) > 0 {
		if streq(r.Pkg, "testing") &&
			streq(r.Name, "TestResult") {
			return true
		}
	}
	if r.Kind == ast.TEXPR_MANAGED_SLICE && r.Base != nil {
		if r.Base.Kind == ast.TEXPR_NAMED &&
			streq(r.Base.Name, "char") {
			return true
		}
	}
	return false
}

// parseSourceFiles reads and parses all source files.
func parseSourceFiles(filenames @[]@[]char) @[]@ast.File {
	var files @[]@ast.File
	var hasErrors bool = false
	for i := 0; i < len(filenames); i++ {
		var src @[]uint8 = readFile(filenames[i])
		if len(src) == 0 {
			print("error: cannot read ")
			println(filenames[i])
			bootstrap.Exit(1)
		}
		var p @parser.Parser = parser.New(src,
			filenames[i])
		var f @ast.File = p.ParseFile()
		var errs @[]parser.ParseError = p.Errors()
		if len(errs) > 0 {
			for j := 0; j < len(errs); j++ {
				println(errs[j].Msg)
			}
			hasErrors = true
		}
		files = appendFilePtr(files, f)
	}
	if hasErrors { bootstrap.Exit(1) }
	return files
}

// resolveRoot determines the project root from the flag or first
// filename.
func resolveRoot(rootOverride *[]const char, firstFile *[]const char) *[]const char {
	if len(rootOverride) > 0 { return rootOverride }
	var root *[]const char = dirOf(firstFile)
	if len(root) == 0 { return "." }
	return root
}
