package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/buildcfg"
import "pkg/binate/debug"
import "pkg/binate/interp"
import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/mangle"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/binate/version"
import "pkg/binate/vm"
import "pkg/std/os"
import "pkg/stdx/containers/vec"
import "pkg/stdx/fmt"

// Self-hosted bytecode interpreter.
// Usage: bni <file.bn|dir> [-- progargs...]
//        bni --test [--run <substr>] [-I <dir>] <pkg/foo> [pkg/bar ...]
//        bni --repl <file.bn|dir>

// main is the entry point for the bytecode interpreter CLI.
func main() {
	var args @[]@[]char = bniArgs()
	var cli CLIArgs = parseArgs(args)
	// --version wins even alongside other flags: checked before the usage error,
	// so `--version` reported before parsing tripped is still honored.
	if cli.Version {
		fmt.Print("bni-", version.Version, "\n")
		return
	}
	if len(cli.Error) > 0 {
		fmt.Println(cli.Error)
		printUsage()
		os.Exit(1)
	}

	if cli.Verbose {
		debug.SetVerbose(true)
	}

	// Fall back to the environment for either search path the CLI left unset.
	// -I / -L win per path (a path given on the CLI ignores its env var); an
	// unset path falls back to BINATE_PACKAGE_INTERFACE_PATH / _IMPL_PATH (long
	// form) or the BINATE_BNI_PATH / BINATE_IMPL_PATH aliases.  Done before the
	// dispatch below so runProgram / runTests / runRepl (and primaryRoot) all
	// see the merged paths.
	if len(cli.BniPaths) == 0 {
		cli.BniPaths = envPaths("BINATE_PACKAGE_INTERFACE_PATH", "BINATE_BNI_PATH")
	}
	if len(cli.ImplPaths) == 0 {
		cli.ImplPaths = envPaths("BINATE_PACKAGE_IMPL_PATH", "BINATE_IMPL_PATH")
	}

	if len(cli.TestPkgs) > 0 {
		runTests(cli)
	} else if cli.Repl {
		runRepl(cli)
	} else {
		runProgram(cli)
	}
}

// printUsage prints bni's usage.
func printUsage() {
	fmt.Print(
			"usage: bni [flags] <file|dir> [args...]     run a main package (file or directory)\n"
					"       bni [flags] -main-file <file> [args...]     (explicit single-file main)\n"
					"       bni [flags] -main-dir <dir> [args...]       (explicit directory main)\n"
					"       bni [flags] -test <pkg> [-test <pkg>...]    run Test* in packages\n"
					"       bni [flags] -repl <file|dir>                interactive REPL in a module\n"
					"note: everything after the main package is the program's argv; use `--` to end\n"
					"      bni's flags (e.g. a shebang `#!/usr/bin/env -S bni <flags> --`).\n"
					"flags: -I/--interface-path <dirs>, -L/--impl-path <dirs>, -v, --check-nil,\n"
					"       --run <substr>, --skip <substr>, --version\n"
					"env: BINATE_PACKAGE_INTERFACE_PATH (alias BINATE_BNI_PATH) supplies -I,\n"
					"     BINATE_PACKAGE_IMPL_PATH (alias BINATE_IMPL_PATH) supplies -L,\n"
					"     each used only when its flag is absent\n")
}

// targetFiles resolves the -main-* target to its source-file list: the single
// file for -main-file (rejecting a directory), or the directory's .bn files for
// -main-dir.  Exits on a -main-file that is actually a directory.
func targetFiles(cli CLIArgs) @[]@[]char {
	if len(cli.MainFile) > 0 {
		if isDir(cli.MainFile) {
			fmt.Println("error: -main-file argument is a directory (use -main-dir)")
			os.Exit(1)
		}
		return oneStr(cli.MainFile)
	}
	if len(cli.MainDir) > 0 {
		if !isDir(cli.MainDir) {
			fmt.Println("error: -main-dir argument is not a directory (use -main-file)")
			os.Exit(1)
		}
		var expanded @vec.Vec[@[]char] = expandDirArgs(oneStr(cli.MainDir))
		return expanded.Items()
	}
	// Implicit positional main: auto-detect a directory (expand to its .bn files)
	// vs. a single file, so `bni foo/` and `bni foo.bn` both work.
	if isDir(cli.MainPath) {
		var expanded @vec.Vec[@[]char] = expandDirArgs(oneStr(cli.MainPath))
		return expanded.Items()
	}
	return oneStr(cli.MainPath)
}

// targetName returns the program name (argv[0]) for a run: the file or directory
// the user named, whether via -main-file/-main-dir or as the first positional.
func targetName(cli CLIArgs) @[]char {
	if len(cli.MainFile) > 0 { return buf.CopyStr(cli.MainFile) }
	if len(cli.MainDir) > 0 { return buf.CopyStr(cli.MainDir) }
	return buf.CopyStr(cli.MainPath)
}

// runProgram parses, type-checks, generates IR, lowers to bytecode,
// and runs main() in the VM.
func runProgram(cli CLIArgs) {
	// The program's own path (element 0 of the argv it will see) is the named
	// target; a -main-dir is expanded into its .bn files.
	var progName @[]char = targetName(cli)
	var fnames @[]@[]char = targetFiles(cli)
	if len(fnames) == 0 {
		fmt.Println("error: no source files")
		os.Exit(1)
	}

	var files @[]@ast.File = parseSourceFiles(fnames)
	var root @[]char = buf.CopyStr(resolveRoot(primaryRoot(cli), fnames[0]))

	// Build the embeddable interpreter, point it at the search paths (the
	// project root + the -I / -L flags), and drive load -> run.  The CLI shell
	// owns argv / stdout / the exit code; the engine returns errors as values.
	var it @interp.Interp = interp.New(8 * 1024 * 1024, interp.StandardPackages())
	// A plain run enables nil-pointer-deref checking only under `--check-nil`
	// (default off — a plain run stays C-like/fast).  --test and the REPL turn it
	// on unconditionally instead.
	it.SetEmitNilChecks(cli.CheckNil)
	it.AddBniPath(root)
	it.AddImplPath(root)
	for i := 0; i < len(cli.BniPaths); i++ {
		it.AddBniPath(cli.BniPaths[i])
	}
	for i := 0; i < len(cli.ImplPaths); i++ {
		it.AddImplPath(cli.ImplPaths[i])
	}

	var loadErrs @[]@[]char = it.LoadProgram(files)
	if len(loadErrs) > 0 {
		for i := 0; i < len(loadErrs); i++ { fmt.Println(loadErrs[i]) }
		os.Exit(1)
	}

	// Install the program's argv (os.Args) before its package init / main run:
	// os is shared (injected native), so this is what the program — and any bni
	// it nests — reads.  See setProgramArgs.
	setProgramArgs(progName, cli.ProgArgs)

	// main is void today, so its result code is ignored (matching the prior
	// inline path); RunMain's entry chain runs package init then main.main.
	var runErrs @[]@[]char
	_, runErrs = it.RunMain()
	if len(runErrs) > 0 {
		for i := 0; i < len(runErrs); i++ { fmt.Println(runErrs[i]) }
		os.Exit(1)
	}
}

// runTests discovers and runs Test* functions in the specified
// packages via the bytecode VM.
func runTests(cli CLIArgs) {
	if len(cli.TestPkgs) == 0 {
		fmt.Println("error: --test requires package paths (e.g. pkg/foo)")
		os.Exit(1)
	}

	var root @[]char = primaryRoot(cli)
	if len(root) == 0 {
		root = "."
	}

	// Set up loader with test packages enabled
	var ldr @loader.Loader = loader.NewLoader()
	ldr.AddBniPath(root)
	ldr.AddImplPath(root)
	applyPathFlags(ldr, cli)
	// The interpreter runs on (and for) the host, so gate #[build(...)] by the
	// host config baked into this bni — no build.bni read.
	ldr.BuildConfig = buildcfg.ConfigForTarget("")
	for i := 0; i < len(cli.TestPkgs); i++ {
		ldr.TestPackages = appendCharSlice(
				ldr.TestPackages, cli.TestPkgs[i])
	}

	// Load native-only DEPENDENCIES (rt + pkg/std, minus any that are
	// themselves --test targets) interface-only: they run as injected native
	// instances, so the runner needs their `.bni` but not their `.bn` — and
	// keeping their impls unparsed keeps their native-only `__c_call` out of the
	// interpreted-mode type check (TypecheckPackages sets Checker.Interpreted).
	// Mirrors interp.New's run-path interface-only load.
	ldr.InterfaceOnly = interp.NativeOnlyInterfacePaths(cli.TestPkgs)

	// Synthetic imports to load test packages and their deps
	var syntheticImps @[]@ast.ImportSpec
	for i := 0; i < len(cli.TestPkgs); i++ {
		var imp @ast.ImportSpec = make(ast.ImportSpec)
		imp.Path = quotePath(cli.TestPkgs[i])
		syntheticImps = appendImportSpec(syntheticImps, imp)
	}
	ldr.LoadImports(syntheticImps)
	interp.EnsureLangLoaded(ldr)
	interp.EnsureReflectLoaded(ldr)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			fmt.Println(ldr.Errors[i])
		}
		os.Exit(1)
	}

	var checker @types.Checker
	var tcErrs @[]@[]char
	checker, tcErrs = interp.TypecheckPackages(ldr)
	if len(tcErrs) > 0 {
		for i := 0; i < len(tcErrs); i++ { fmt.Println(tcErrs[i]) }
		os.Exit(1)
	}

	// Build VM and lower all packages.  Track which packages emit a
	// `<pkg>.__init` (top-level var initializers) so they can be run in
	// dep order before the tests — same shape as the run path's init
	// dispatcher.
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)
	interp.RegisterStandardExterns(vmInst)
	// Exempt the --test target packages from injection: a native-only package
	// under test is lowered to bytecode (the symmetric exemption in the loop
	// below), not injected, so its Test* run as bytecode.
	interp.InjectStdlibExterns(vmInst, cli.TestPkgs)
	var initPkgNames @vec.Vec[@[]char] = vec.New[@[]char]()
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(
				ldr.Order[i])
		if pkg == nil { continue }
		if pkg.Merged == nil { continue }
		// rt and every pkg/std package run as their injected compiled
		// instance, not lowered — UNLESS the package is itself a test target, in
		// which case it must be lowered so its own Test* run as bytecode (it's
		// injected only as a DEPENDENCY, never when it IS the program under test).
		// A __c_call package under test (pkg/std/os) therefore can't run its tests
		// here — its methods need the native impl — so the stdlib unit tests are
		// not run under the interpreter modes (scripts/unittest/run.sh); their
		// cross-mode coverage is the conformance/stdlib suite (stdlib injected).
		if interp.IsNativeOnlyInVM(ldr.Order[i]) && !interp.PkgIsTestTarget(ldr.Order[i], cli.TestPkgs) {
			continue
		}
		var mod @ir.Module = ir.InitModule(
				quotePath(ldr.Order[i]))
		mod.Checker = checker
		var gc @ir.GenCtx = ir.NewGenCtx(mod)
		// A test suite wants host survival: nil-pointer-deref checking is ON so a
		// nil deref in test code becomes a recoverable fault (reported as a failed
		// test below) rather than a SEGV that kills the whole runner.  Always on
		// under --test — the opt-in `--check-nil` governs only a plain run.
		gc.EmitNilChecks = true
		interp.RegisterPkgImports(ldr, pkg, gc)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(checker, pkg.BNI, gc)
		}
		ir.GeneratePackage(checker, pkg.Merged, gc, pkg.Files)
		if mod.HasPackageInit() {
			initPkgNames.Push(
					ir.PackageInitName(mangle.PkgPathFromQuoted(
							quotePath(ldr.Order[i]))))
		}
		vmInst.LowerModule(mod)
	}

	// Give the interpreted tests their own (empty) argv before any package init
	// or test runs.  os is shared (injected native), so without this a test's
	// os.Args() would read bni's OWN command line -- the --test flag plus the
	// -I/-L compiler search paths -- rather than an empty argument list.  A
	// program run under --test has no command line of its own, so os.Args() must
	// return just the program-name slot (element 0) with no arguments; e.g. a
	// test that scans os.Args() for a developer-supplied -I would otherwise pick
	// up bni's compiler -I.  Element 0 is the first test package; --run/--skip
	// stay bni's concern (filtered above), not the test program's argv.
	var noProgArgs @[]@[]char
	setProgramArgs(cli.TestPkgs[0], noProgArgs)

	// Run package var-initializers in dep order before any test.  Unlike
	// the run path, a test program has no `main.__entry` to drive the
	// init dispatcher, so a top-level `var` initialized by `<pkg>.__init`
	// would otherwise read its zero value (e.g. a string-literal slice
	// global reading as len 0).
	var initNoArgs @[]int
	for ii := 0; ii < initPkgNames.Len(); ii++ {
		vmInst.CallFunc(initPkgNames.Get(ii), initNoArgs)
	}

	// Discover and run Test* functions
	var passed int = 0
	var failed int = 0
	var skipped int = 0

	for pi := 0; pi < len(cli.TestPkgs); pi++ {
		var pkgPath @[]char = cli.TestPkgs[pi]
		var pkg @loader.Package = ldr.GetPackage(
				pkgPath)
		if pkg == nil || pkg.Merged == nil {
			fmt.Print("warning: no implementation for ", pkgPath, "\n")
			continue
		}

		// Find Test* functions.  When --run is non-empty, only
		// include names that contain it as a substring; when --skip
		// is non-empty, exclude names that contain it (skip wins
		// over run when both match).  Mirrors `go test -run`/`-skip`
		// but plain substring.
		var testNamesV @vec.Vec[@[]char] = vec.New[@[]char]()
		for di := 0; di < len(pkg.Merged.Decls); di++ {
			var d @ast.Decl = pkg.Merged.Decls[di]
			if d.Kind != ast.DECL_FUNC { continue }
			if d.Body == nil { continue }
			if !hasPrefix(d.Name, "Test") { continue }
			if len(d.Params) != 0 { continue }
			if !isTestResultReturn(d, pkg.Merged.Decls) { continue }
			if !containsStr(d.Name, cli.RunFilter) { continue }
			if len(cli.SkipFilter) > 0 && containsStr(d.Name, cli.SkipFilter) {
				skipped = skipped + 1
				continue
			}
			testNamesV.Push(d.Name)
		}

		var testNames @[]@[]char = testNamesV.Items()
		if len(testNames) == 0 {
			fmt.Print("?   \t", pkgPath, "\t[no test functions]\n")
			continue
		}

		var pkgFailed int = 0
		for ti := 0; ti < len(testNames); ti++ {
			// Shard selection: run only this shard's slice of the package's tests
			// (pos % count == index-1), so a heavy package can be split across
			// parallel CI shards.  Default 1/1 runs every test.
			if ti % cli.ShardCount != cli.ShardIdx - 1 { continue }
			fmt.Print("=== RUN   ", testNames[ti], "\n")

			var noArgs @[]int
			// CallFunc looks up via the full pkgPath-qualified name
			// (matches mangle.QualifyName since 7f989ad's full-path
			// flip — short-segment forms no longer match the stored
			// keys, so every -int unit test would otherwise miss with
			// "function not found").
			var qualName @[]char = buf.Concat(
					buf.Concat(pkgPath, "."), testNames[ti])
			var rc int = vmInst.CallFunc(qualName, noArgs)
			// A recoverable VM fault (Plan 2) — bad test code, e.g. an
			// out-of-bounds index — unwinds and leaves Status = FAULTED
			// instead of killing the runner.  Report it as a failed test
			// (carrying the fault message) and keep going: the test runner is
			// an embedder that treats a fault as a failure, not a crash.  The
			// next CallFunc resets Status.  Without this the test would read as
			// an empty (passing) result — a silent pass.
			if vmInst.Status == vm.VM_STATUS_FAULTED {
				fmt.Print("--- FAIL: ", testNames[ti], "\n")
				fmt.Print("    ", vmInst.FaultMsg, "\n")
				failed = failed + 1
				pkgFailed = pkgFailed + 1
				continue
			}
			// Test returns @[]char (testing.TestResult).
			// Empty string = pass, non-empty = fail.
			// rc is the pointer to the @[]char header.
			var failMsg @[]char = readResultStr(rc)
			if len(failMsg) > 0 {
				fmt.Print("--- FAIL: ", testNames[ti], "\n")
				fmt.Print("    ", failMsg, "\n")
				failed = failed + 1
				pkgFailed = pkgFailed + 1
			} else {
				fmt.Print("--- PASS: ", testNames[ti], "\n")
				passed = passed + 1
			}
		}

		if pkgFailed > 0 {
			fmt.Print("FAIL\t", pkgPath, "\n")
		} else {
			fmt.Print("ok  \t", pkgPath, "\t", len(testNames), " tests\n")
		}
	}

	// Summary
	fmt.Println()
	if failed > 0 {
		fmt.Print("FAIL\t", passed, " passed, ", failed, " failed")
		if skipped > 0 {
			fmt.Print(", ", skipped, " skipped")
		}
		fmt.Print("\n")
		os.Exit(1)
	} else {
		fmt.Print("ok\t", passed, " passed")
		if skipped > 0 {
			fmt.Print(", ", skipped, " skipped")
		}
		fmt.Print("\n")
	}
}

// readResultStr reads a @[]char value from a VM stack address.
// VM functions returning @[]char put a pointer to a 4-word
// managed-slice header on the VM stack. Empty → "".
func readResultStr(addr int) @[]char {
	if addr == 0 { return "" }
	var hdr *int = bit_cast(*int, addr)
	var slen int = hdr[1]
	if slen == 0 { return "" }
	var data *uint8 = bit_cast(*uint8, hdr[0])
	var s @[]char = make_slice(char, slen)
	for i := 0; i < slen; i++ {
		s[i] = cast(char, data[i])
	}
	return s
}

// isTestResultReturn checks if a func decl has a single return type that marks a
// Test* function as a test: qualified `testing.TestResult` / `sys.TestResult`, a
// bare `TestResult` inside a package that declares the type locally (testing's own
// _test files — matched via hasLocalTestResultType, mirroring cmd/bnc/test.bn), or
// `@[]char`.
func isTestResultReturn(d @ast.Decl, decls @[]@ast.Decl) bool {
	if len(d.Results) != 1 { return false }
	var r @ast.TypeExpr = d.Results[0]
	if r.Kind == ast.TEXPR_NAMED && streq(r.Name, "TestResult") {
		if len(r.Pkg) > 0 {
			return streq(r.Pkg, "testing") || streq(r.Pkg, "sys")
		}
		// Bare `TestResult`: a test only inside pkg/builtins/testing itself, where the
		// type is declared locally and in scope unqualified (its own _test files).
		return hasLocalTestResultType(decls)
	}
	if r.Kind == ast.TEXPR_MANAGED_SLICE && r.Base != nil {
		if r.Base.Kind == ast.TEXPR_NAMED && streq(r.Base.Name, "char") {
			return true
		}
	}
	return false
}

// hasLocalTestResultType reports whether decls declares `type TestResult` — gates a
// bare `TestResult` return so it is a test only inside pkg/builtins/testing.
func hasLocalTestResultType(decls @[]@ast.Decl) bool {
	for i := 0; i < len(decls); i++ {
		var d @ast.Decl = decls[i]
		if d.Kind != ast.DECL_TYPE { continue }
		if streq(d.Name, "TestResult") { return true }
	}
	return false
}

// parseSourceFiles reads and parses all source files.
func parseSourceFiles(filenames @[]@[]char) @[]@ast.File {
	var files @[]@ast.File
	var hasErrors bool = false
	for i := 0; i < len(filenames); i++ {
		var src @[]uint8 = readFile(filenames[i])
		if len(src) == 0 {
			fmt.Print("error: cannot read ", filenames[i], "\n")
			os.Exit(1)
		}
		var p @parser.Parser = parser.New(src, filenames[i])
		var f @ast.File = p.ParseFile()
		var errs @[]parser.ParseError = p.Errors()
		if len(errs) > 0 {
			for j := 0; j < len(errs); j++ {
				fmt.Println(errs[j].Msg)
			}
			hasErrors = true
		}
		files = appendFilePtr(files, f)
	}
	if hasErrors { os.Exit(1) }
	return files
}

// resolveRoot determines the project root from the flag or first
// filename.
func resolveRoot(rootOverride *[]readonly char, firstFile *[]readonly char) *[]readonly char {
	if len(rootOverride) > 0 { return rootOverride }
	var root *[]readonly char = dirOf(firstFile)
	if len(root) == 0 { return "." }
	return root
}
