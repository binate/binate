package "main"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/buf"
import "pkg/debug"
import "pkg/ir"
import "pkg/loader"
import "pkg/parser"
import "pkg/types"
import "pkg/vm"

// runRepl loads the module specified by cli.Filenames, then enters
// an interactive prompt that accepts immediate-mode statement
// lists against the loaded scope.  Tier 1 PoC: no new top-level
// declarations at the prompt, no redefinition, no forward refs,
// and no auto-`println` wrap of bare expressions (type
// `println(...)` explicitly to print).  Errors during a prompt
// turn are reported and control returns to the prompt; nothing
// in the loaded module is affected.  Ctrl-D exits.
func runRepl(cli CLIArgs) {
	cli.Filenames = expandDirArgs(cli.Filenames)
	if len(cli.Filenames) == 0 {
		println("error: --repl requires a source file or package")
		bootstrap.Exit(1)
	}

	// === Setup mirrors runProgram (parse → load imports → typecheck
	// → IR-gen → lower) but ends BEFORE invoking main, and uses
	// CheckMainPersistent so the main file's scope is left
	// installed on c.Scope for prompt entries.
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var merged @ast.File = loader.MergeFiles(files)
	debug.Log("parsed and merged source files")

	var root @[]char = buf.CopyStr(
		resolveRoot(primaryRoot(cli), cli.Filenames[0]))

	var ldr @loader.Loader = loader.NewLoader(root)
	applyPathFlags(ldr, cli)
	ldr.LoadImports(merged.Imports)
	ensureBootstrapLoaded(ldr)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}
	debug.Log("imports loaded successfully")

	// Type-check, leaving main file's scope installed on c.Scope.
	var c @types.Checker = types.NewChecker()
	loadBuiltinBNIs(c, ldr, root)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(
			ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	c.CheckMainPersistent(merged)
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(types.FormatCheckError(errs[i]))
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
	ir.SetChecker(c)

	// Build VM and lower all packages.  Match runProgram/runTests:
	// register the standard externs (rt + libc + bootstrap) and the
	// pure-C extern table before any user code runs, so prompt
	// entries that call e.g. println / bootstrap.Write resolve via
	// the registry rather than crashing with "extern not found".
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)
	registerStandardExterns(vmInst)
	registerPureCExterns(vmInst)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(
			ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.Merged == nil { continue }
		var mod @ir.Module = ir.InitModule(
			quotePath(ldr.Order[i]))
		registerPkgImports(ldr, pkg, mod, root, cli.BniPaths)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(pkg.BNI)
		}
		ir.GeneratePackage(pkg.Merged, mod)
		vmInst.LowerModule(mod)
	}

	// Lower main package.  Keep mainMod around — synthetic REPL
	// functions are appended to it and routed through LowerOneFunc
	// against this same module (so their context is main's).
	var mainMod @ir.Module = ir.InitModule(merged.PkgName)
	registerMainImports(ldr, merged, mainMod, root, cli.BniPaths)
	ir.GeneratePackage(merged, mainMod)
	vmInst.LowerModule(mainMod)

	// === REPL loop ===
	//
	// Multi-line input: lines accumulate until open-bracket depth
	// balances to 0 (i.e., every `{` and `(` has been closed).
	// While accumulating, the prompt switches to `... ` to indicate
	// the previous input is incomplete.  Brackets inside string /
	// char literals and inside `//` / `/* ... */` comments are
	// skipped.  EOF in the middle of an unbalanced block discards
	// the buffered input (silent drop — user bailed).
	println("Binate REPL (Tier 1 PoC). Ctrl-D to exit.")
	var replCounter int = 0
	var accumulated @[]uint8
	for {
		if len(accumulated) == 0 {
			print("> ")
		} else {
			print("... ")
		}
		var line @[]uint8
		var eof bool
		line, eof = readReplLine()
		if eof { println(""); return }
		// Append the line followed by a newline so the parser sees
		// the same line breaks the user typed.
		for i := 0; i < len(line); i++ {
			accumulated = appendByteRepl(accumulated, line[i])
		}
		accumulated = appendByteRepl(accumulated, 10)
		// Empty input at top level: just reprompt.
		if len(line) == 0 && computeOpenDepth(accumulated) == 0 {
			var empty @[]uint8
			accumulated = empty
			continue
		}
		// Still inside an open `{` or `(` — keep reading.
		if computeOpenDepth(accumulated) > 0 { continue }
		// Complete — evaluate and reset accumulator.
		evalReplLine(vmInst, mainMod, c, accumulated, replCounter)
		var empty @[]uint8
		accumulated = empty
		replCounter = replCounter + 1
	}
}

// evalReplLine parses a single REPL turn, dispatches between the
// top-level-decl path (Tier 2 — registers a persistent symbol) and
// the immediate-mode statement-list path (Tier 1 — synthetic
// __repl_<n>() is generated, lowered, and called).  Any errors at
// parse / check stages are reported and the function returns
// without lowering — the loaded state is unaffected.
func evalReplLine(vmInst @vm.VM, m @ir.Module, c @types.Checker,
		src @[]uint8, n int) {
	var p @parser.Parser = parser.New(src, "<repl>")
	if p.IsAtTopLevelDecl() {
		evalReplDecl(vmInst, m, c, p)
	} else {
		evalReplStmtList(vmInst, m, c, p, n)
	}
}

// evalReplDecl handles a single top-level decl typed at the
// prompt.  Currently supports DECL_FUNC, DECL_CONST (single or
// grouped), and DECL_VAR; type / method decls surface a "not yet
// supported" diagnostic from ir.GenDecl.  On success, the new
// symbol is persistent in c.Scope.  Per-kind VM-side work:
//   - func: lower + install on vm.Funcs.  Three cases:
//       * first definition → append.
//       * redefinition with the same signature → REPLACE in place
//         (LowerOneFunc); old callers see the new body.
//       * redefinition with a different signature → SHADOW
//         (LowerOneFuncShadow); funcIndex points at the new
//         entry, old callers' eager-filled CallCache slots keep
//         them routed to the OLD VMFunc (with the old signature).
//   - const: nothing (lookupConst reads moduleConsts directly).
//   - var: materialize the new global on the VM (allocate
//     storage, append name+addr to globalNames/globalAddrs).
func evalReplDecl(vmInst @vm.VM, m @ir.Module, c @types.Checker,
		p @parser.Parser) {
	var d @ast.Decl = p.ParseTopLevelDecl()
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		for i := 0; i < len(perrs); i++ {
			println(perrs[i].Msg)
		}
		return
	}
	if d == nil { return }

	// Capture the pre-check func type so we can decide replace vs
	// shadow after the checker overwrites it.
	//
	//   - Free func: look up the symbol by name in c.Scope.
	//   - Method:    walk d.Recv to its base named type and look up
	//                the method by name on that type's method set.
	//
	// We have to read this BEFORE CheckDeclInScope because the
	// checker (under c.AllowRedef) overwrites the method-set entry
	// in place via SetOrAppendMethod / overwrites the func symbol
	// in c.Scope via defineFunc.
	var oldFuncType @types.Type = nil
	if d.Kind == ast.DECL_FUNC && d.Recv == nil {
		var existing @types.Symbol = c.Scope.Lookup(d.Name)
		if existing != nil && existing.Kind == types.SYM_FUNC {
			oldFuncType = existing.Type
		}
	} else if d.Kind == ast.DECL_FUNC && d.Recv != nil {
		var existing @types.Method = c.LookupMethodForDecl(d)
		if existing != nil { oldFuncType = existing.FuncType }
	}

	var prevErrs int = len(c.CheckerErrors())
	c.CheckDeclInScope(d)
	var allErrs @[]types.CheckError = c.CheckerErrors()
	if len(allErrs) > prevErrs {
		for i := prevErrs; i < len(allErrs); i++ {
			println(types.FormatCheckError(allErrs[i]))
		}
		return
	}
	// Tier 3: if the body referenced names not yet bound, the
	// decl is parked on c.Pending (sig was registered already so
	// other code can refer to it).  Announce each freshly-parked
	// decl and (in the single-decl case) skip IR-gen — the body
	// can't be emitted with unresolved names.  A subsequent decl
	// that binds the missing names triggers RetryPendingDecls
	// below.
	//
	// DECL_GROUP is special: Stage 1 (c) of plan-repl-tier3-
	// pending-types.md splits group parking per-member, so a
	// group can have some members parked and others resolved.
	// Announce each parked member, then fall through to IR-gen
	// — genConstGroup uses currentChecker.IsPendingDecl to skip
	// the parked members (still incrementing iota for them so
	// resolved members get correct positional values).
	if c.IsDeclPending() {
		for i := c.PendingMark; i < len(c.Pending); i++ {
			announceParked(c.Pending[i])
		}
		if d.Kind != ast.DECL_GROUP {
			return
		}
	}
	var preFuncCount int = len(m.Funcs)
	var msg @[]char = ir.GenDecl(d, m)
	if len(msg) > 0 {
		println(msg)
		return
	}
	if d.Kind == ast.DECL_TYPE {
		// A managed-field struct decl emits dtor / copy / field-
		// type helpers via ensureReplStructHelpers.  Lower every
		// new entry so the VM has callable bytecode for them
		// before any subsequent code uses the new type.  Aliases,
		// named non-structs, and structs without managed fields
		// add zero funcs — this loop is a no-op for them.
		for i := preFuncCount; i < len(m.Funcs); i++ {
			vmInst.LowerOneFunc(m, m.Funcs[i])
		}
		return
	}
	if d.Kind == ast.DECL_FUNC {
		// Capture the body's index in m.Funcs BEFORE draining
		// pending dtor / copy registrations, since the drain
		// appends helpers AFTER the body.  GenDecl added exactly
		// one entry (the body) at preFuncCount.
		var f @ir.Func = m.Funcs[preFuncCount]
		// Drain pending managed-aggregate dtor / copy needs the
		// body registered.  Lower the resulting helpers BEFORE the
		// body so its eager CallCache fill resolves their names.
		var helpersStart int = len(m.Funcs)
		ir.EnsureReplBodyHelpers(m)
		for i := helpersStart; i < len(m.Funcs); i++ {
			vmInst.LowerOneFunc(m, m.Funcs[i])
		}
		if oldFuncType == nil {
			// First-time definition.
			vmInst.LowerOneFunc(m, f)
		} else {
			// Redefinition.  Compare new sig to old to choose path.
			// Method new-type lookup goes through the receiver type's
			// method set; free-func lookup goes through c.Scope.
			var newType @types.Type = nil
			if d.Recv != nil {
				var newM @types.Method = c.LookupMethodForDecl(d)
				if newM != nil { newType = newM.FuncType }
			} else {
				var newSym @types.Symbol = c.Scope.Lookup(d.Name)
				if newSym != nil { newType = newSym.Type }
			}
			if newType != nil &&
					oldFuncType.Identical(newType) {
				// Same signature: replace in place.
				vmInst.LowerOneFunc(m, f)
			} else {
				// Different signature: shadow.  Old VMFunc is
				// kept in vm.Funcs at its existing idx so any
				// caller whose CallCache already resolved it
				// continues to invoke the old shape.
				print("warning: ")
				printRedefName(d)
				println(" shadowed (incompatible signature); existing callers retain old definition")
				vmInst.LowerOneFuncShadow(m, f)
			}
		}
	}
	if d.Kind == ast.DECL_VAR {
		// GenDecl appended exactly one entry to m.Globals.
		var g @ir.Global = m.Globals[len(m.Globals) - 1]
		vm.MaterializeOneGlobal(g)
		// Run the initializer (if present and non-blank) right
		// away as a one-shot synthetic.  Mirrors what
		// generatePackageInit does for the file-load path; here
		// we evaluate exactly one assignment and call the
		// resulting function so the new global has its declared
		// value before the next prompt entry observes it.
		if d.Value != nil && !isBlankReplName(d.Name) {
			runReplVarInit(vmInst, m, d, replInitCounter)
			replInitCounter = replInitCounter + 1
		}
	}
	// Tier 3: this decl may have bound names that previously-
	// parked decls were waiting on.  Re-attempt each pending
	// entry; for each one that now resolves cleanly, IR-gen +
	// lower it.  Cheap at REPL volumes (parked count is ~0
	// for typical sessions) and safe (a still-unresolved decl
	// stays parked).
	retryPending(vmInst, m, c)
}

// printRedefName prints the user-facing name for a redefinition
// warning: bare `Name` for a free func, `RecvType.Name` for a
// method.  Helper for the shadow-warning emitter.
func printRedefName(d @ast.Decl) {
	if d.Recv != nil {
		var rb @ast.TypeExpr = d.Recv.Type
		for rb != nil {
			if rb.Kind == ast.TEXPR_POINTER ||
				rb.Kind == ast.TEXPR_MANAGED ||
				rb.Kind == ast.TEXPR_CONST ||
				rb.Kind == ast.TEXPR_PAREN {
				rb = rb.Base
			} else {
				break
			}
		}
		if rb != nil && rb.Kind == ast.TEXPR_NAMED {
			print(rb.Name)
			print(".")
		}
	}
	print(d.Name)
}

// announceParked prints a one-line "X Y parked (pending: a, b)"
// message for one freshly-parked PendingDecl.  X is the user-
// facing noun (function / variable / constant); Y is the
// decl's name.  Pulled per-decl from `pd.MissingNames`, which
// the type checker populated when this specific decl parked.
// (After Stage 1 (c) of plan-repl-tier3-pending-types.md, a
// DECL_GROUP at the prompt produces zero or more individual
// member PendingDecls — the caller iterates them and calls
// announceParked once each.  Groups are syntactic sugar.)
func announceParked(pd @types.PendingDecl) {
	print(parkedDeclLabel(pd.Decl))
	print(" parked (pending: ")
	for i := 0; i < len(pd.MissingNames); i++ {
		if i > 0 { print(", ") }
		print(pd.MissingNames[i])
	}
	println(")")
}

// parkedDeclLabel returns the "X Y" prefix used in parked /
// resolved messages.  "function f" for free funcs, "variable
// x" for vars, "constant N" for consts.
func parkedDeclLabel(d @ast.Decl) @[]char {
	if d.Kind == ast.DECL_VAR {
		return buf.Concat("variable ", d.Name)
	}
	if d.Kind == ast.DECL_CONST {
		return buf.Concat("constant ", d.Name)
	}
	return buf.Concat("function ", d.Name)
}

// retryPending walks RetryPendingDecls's output (newly-resolved
// pending decls) and runs the IR-gen + lower path on each.
// Resolved decls are first-time-defined from IR-gen's view (the
// sig was in c.Scope all along, but no IR Func / VMFunc existed
// yet), so we use the simple "first-time" path: ir.GenDecl
// followed by per-kind lowering.  No redef bookkeeping needed.
func retryPending(vmInst @vm.VM, m @ir.Module, c @types.Checker) {
	// Snapshot len(c.Pending) before retry so the loop can
	// recover each resolved decl's IotaIdx — RetryPendingDecls
	// removes resolved entries from c.Pending, so we walk the
	// pre-retry list ourselves.
	var preretry @[]@types.PendingDecl = c.Pending
	var resolved @[]@ast.Decl = c.RetryPendingDecls()
	for i := 0; i < len(resolved); i++ {
		var rd @ast.Decl = resolved[i]
		print(parkedDeclLabel(rd))
		println(" resolved")
		// Recover the resolved decl's IotaIdx so a group-member
		// const lands with the right positional value.  Free
		// top-level decls have IotaIdx == -1.
		var iotaIdx int = -1
		for j := 0; j < len(preretry); j++ {
			if preretry[j].Decl == rd {
				iotaIdx = preretry[j].IotaIdx
				break
			}
		}
		var preFuncCount int = len(m.Funcs)
		var preGlobalCount int = len(m.Globals)
		var msg @[]char
		if iotaIdx >= 0 && rd.Kind == ast.DECL_CONST {
			// Group-member const: GenConstMember handles iota
			// positioning.  GenDecl on a bare DECL_CONST would
			// route through genConst with iotaVal=0 — wrong
			// for a member parked at position N.
			ir.GenConstMember(rd, m, iotaIdx)
		} else {
			msg = ir.GenDecl(rd, m)
		}
		if len(msg) > 0 {
			println(msg)
			continue
		}
		if rd.Kind == ast.DECL_FUNC {
			// Same body-then-helpers shape as evalReplDecl's
			// first-time-define path: capture the body before the
			// drain, lower helpers first, then the body.  Strictly,
			// this drain is an optimization — a later prompt
			// entry's drain plus backfillExternCachesForName would
			// upgrade f's CallCache from -1 to the helper idx — but
			// running it now keeps the per-decl invariant ("pending
			// lists are empty after IR-gen + lower of this decl")
			// consistent across the four prompt-body paths.
			var f @ir.Func = m.Funcs[preFuncCount]
			var helpersStart int = len(m.Funcs)
			ir.EnsureReplBodyHelpers(m)
			for j := helpersStart; j < len(m.Funcs); j++ {
				vmInst.LowerOneFunc(m, m.Funcs[j])
			}
			vmInst.LowerOneFunc(m, f)
		}
		if rd.Kind == ast.DECL_VAR {
			// Same shape as evalReplDecl's DECL_VAR first-define
			// path: materialize the slot and run the initializer
			// synthetic.  Blank-name vars (`var _ T = expr`)
			// skip materialization but still run the init for
			// side effects.
			if len(m.Globals) > preGlobalCount {
				var g @ir.Global = m.Globals[len(m.Globals) - 1]
				vm.MaterializeOneGlobal(g)
			}
			if rd.Value != nil && !isBlankReplName(rd.Name) {
				runReplVarInit(vmInst, m, rd, replInitCounter)
				replInitCounter = replInitCounter + 1
			}
		}
		// DECL_CONST and DECL_GROUP (const-only groups): GenDecl
		// registers the symbol in moduleConsts; no slot
		// materialization or initializer evaluation is needed
		// since consts are folded at IR-gen time at each use
		// site.  Nothing more to do here.
	}
}

// replInitCounter feeds unique names into the per-prompt
// var-initializer synthetics so successive `var x int = 1; var
// y int = 2` entries don't collide on a single
// `__repl_var_init` symbol.
var replInitCounter int = 0

// runReplVarInit generates a one-shot synthetic function whose
// body is `<d.Name> = <d.Value>` and calls it, so a fresh
// prompt-level `var x T = expr` has its declared value before
// the next prompt entry runs.  Mirrors what
// generatePackageInit does for the file-load path; here we
// evaluate exactly one assignment.
func runReplVarInit(vmInst @vm.VM, m @ir.Module, d @ast.Decl,
		n int) {
	var stmt @ast.Stmt = ir.MakeInitAssignStmt(d)
	var stmts @[]@ast.Stmt = make_slice(@ast.Stmt, 1)
	stmts[0] = stmt
	var name @[]char = buf.Concat(
		"__repl_var_init_", bootstrap.Itoa(n))
	var f @ir.Func = ir.GenSyntheticFunc(name, stmts)
	m.AddFunc(f)
	// Drain managed-aggregate dtor / copy needs the init-stmt
	// registered.  Lower helpers first so the synthetic's eager
	// CallCache fill resolves their names.
	var helpersStart int = len(m.Funcs)
	ir.EnsureReplBodyHelpers(m)
	for i := helpersStart; i < len(m.Funcs); i++ {
		vmInst.LowerOneFunc(m, m.Funcs[i])
	}
	var vmf @vm.VMFunc = vmInst.LowerOneFunc(m, f)
	if vmf == nil { return }
	var noArgs @[]int
	vmInst.CallByVMFunc(vmf, noArgs)
}

// isBlankReplName returns true for the blank identifier `_`.
// REPL-local mirror of pkg/ir's isBlankName — the blank-init
// case is rare but we skip it to avoid generating a synthetic
// that does nothing.
func isBlankReplName(name *[]const char) bool {
	return len(name) == 1 && name[0] == cast(char, 95)
}

// evalReplStmtList handles a stmt-list turn: parse → check →
// IR-gen as synthetic __repl_<n>() → lower → call.  Identical to
// the Tier 1 path that used to live in evalReplLine.
func evalReplStmtList(vmInst @vm.VM, m @ir.Module, c @types.Checker,
		p @parser.Parser, n int) {
	var ss @[]@ast.Stmt = p.ParseStmtList()
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		for i := 0; i < len(perrs); i++ {
			println(perrs[i].Msg)
		}
		return
	}
	if len(ss) == 0 { return }
	var prevErrs int = len(c.CheckerErrors())
	c.CheckStmtListInScope(ss)
	var allErrs @[]types.CheckError = c.CheckerErrors()
	if len(allErrs) > prevErrs {
		for i := prevErrs; i < len(allErrs); i++ {
			println(types.FormatCheckError(allErrs[i]))
		}
		return
	}
	var name @[]char = buf.Concat(
		"__repl_", bootstrap.Itoa(n))
	var f @ir.Func = ir.GenSyntheticFunc(name, ss)
	m.AddFunc(f)
	// Drain managed-aggregate dtor / copy needs the stmt list
	// registered.  Lower helpers first so the synthetic's eager
	// CallCache fill resolves their names.
	var helpersStart int = len(m.Funcs)
	ir.EnsureReplBodyHelpers(m)
	for i := helpersStart; i < len(m.Funcs); i++ {
		vmInst.LowerOneFunc(m, m.Funcs[i])
	}
	var vmf @vm.VMFunc = vmInst.LowerOneFunc(m, f)
	if vmf == nil { return }
	var noArgs @[]int
	vmInst.CallByVMFunc(vmf, noArgs)
}

// REPL input handling (readReplLine, appendByteRepl,
// computeOpenDepth) lives in repl_input.bn.
