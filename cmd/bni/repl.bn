package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/repl"
import "pkg/binate/vm"
import "pkg/bootstrap"

// runRepl loads the module specified by cli.Filenames, then enters
// an interactive prompt that accepts immediate-mode statement
// lists against the loaded scope.  Tier 1 PoC: no new top-level
// declarations at the prompt, no redefinition, no forward refs,
// and no auto-`println` wrap of bare expressions (type
// `println(...)` explicitly to print).  Errors during a prompt
// turn are reported and control returns to the prompt; nothing
// in the loaded module is affected.  Ctrl-D exits.
//
// This is the CLI host around the embeddable engine in
// pkg/binate/repl: it builds the I/O sink (cliReplIO), parses the
// source + resolves the root from CLIArgs, installs the native VM
// externs, constructs the session, and drives Init / Step — reading
// each line itself (readReplLine) and rendering the next prompt from
// the returned StepResult.  The accumulation / completion / eval
// logic all lives in the engine.
func runRepl(cli CLIArgs) {
	// The CLI's sink: both channels write to stdout via print, so the
	// REPL's framing output goes exactly where it did before the sink
	// existed.  An embedding host supplies its own ReplIO.
	var io repl.ReplIO = cliReplIO()
	cli.Filenames = expandDirArgs(cli.Filenames)
	if len(cli.Filenames) == 0 {
		io.WriteErr("error: --repl requires a source file or package\n")
		bootstrap.Exit(1)
	}

	// Parse the source files and resolve the repo root from CLIArgs,
	// then hand the neutral inputs to repl.NewReplSession — it does the
	// load → typecheck → lower setup (ending BEFORE main runs) and
	// returns any setup errors as values.  The CLI reports them and
	// exits; an embedding host would surface them however it likes.
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var root @[]char = buf.CopyStr(
		resolveRoot(primaryRoot(cli), cli.Filenames[0]))
	// The host installs the VM's externs.  Keeping these native
	// bindings in the CLI (not the engine) is what lets the engine
	// live in pkg/binate/repl: a wasm/test host injects its own.
	var registerExterns @func(@vm.VM) = func(vmInst @vm.VM) {
		registerStandardExterns(vmInst)
		registerPureCExterns(vmInst)
	}
	var s @repl.ReplSession
	var errs @[]repl.ReplError
	s, errs = repl.NewReplSession(files, root, cli.BniPaths, cli.ImplPaths,
		io, registerExterns)
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			io.WriteErr(errs[i].Msg)
			io.WriteErr("\n")
		}
		bootstrap.Exit(1)
	}

	// === REPL loop ===  The host drives the engine: Init once
	// (pre-prompt; emits the banner through the sink), then Step per
	// line, rendering the prompt the last result calls for (Depth > 0 ⇒
	// continuation).  Prompts go through the host's OWN sink handle
	// (io) — the same ReplIO the session holds — so a non-CLI host
	// renders them wherever it likes.
	var r repl.StepResult = s.Init()
	for {
		if r.Depth > 0 {
			io.WriteOut("... ")
		} else {
			io.WriteOut("> ")
		}
		var line @[]uint8
		var eof bool
		line, eof = readReplLine()
		r = s.Step(line, eof)
		if r.Status == repl.STEP_EOF_CLEAN ||
				r.Status == repl.STEP_EOF_UNBALANCED {
			io.WriteOut("\n")
			return
		}
	}
}

// cliReplIO is the CLI host's sink: both channels write to stdout via
// the print builtin, so the REPL's framing output lands exactly where
// it did before the sink existed (all on fd 1).  A richer host (wasm
// worker, IDE) supplies a ReplIO that routes elsewhere and may split
// the two channels.
func cliReplIO() repl.ReplIO {
	// The typed @func vars give the closure literals their flavour
	// hint (a bare `field = func(){}` assignment isn't a hint site);
	// the closures capture nothing — they call the print builtin.
	var wOut @func(*[]readonly char) int = func(str *[]readonly char) int {
		print(str)
		return len(str)
	}
	var wErr @func(*[]readonly char) int = func(str *[]readonly char) int {
		print(str)
		return len(str)
	}
	var io repl.ReplIO
	io.WriteOut = wOut
	io.WriteErr = wErr
	return io
}
