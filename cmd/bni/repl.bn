package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/interp"
import "pkg/binate/repl"
import "pkg/binate/vm"
import "pkg/std/os"

// runRepl loads the module specified by cli.Filenames, then drives an
// interactive prompt against the loaded scope via the embeddable evaluation
// kernel in pkg/binate/repl.  Tier 1 PoC: no auto-`println` wrap of bare
// expressions (type `println(...)` explicitly to print).  Errors during a
// prompt turn are reported and control returns to the prompt; nothing in the
// loaded module is affected.  Ctrl-D exits.
//
// This is one DRIVER of the kernel: it parses the source + resolves the root
// from CLIArgs, installs the native VM externs, constructs the kernel, prints
// the banner (from KernelInfo, as data), and runs the read-accumulate loop
// (RunReadLoop) — reading each line itself (readReplLine) and rendering
// prompts + Results to stdout.  The accumulation / completeness / eval logic
// lives in the kernel + RunReadLoop, not here.
func runRepl(cli CLIArgs) {
	cli.Filenames = expandDirArgs(cli.Filenames)
	if len(cli.Filenames) == 0 {
		print("error: --repl requires a source file or package\n")
		os.Exit(1)
	}

	// Parse the source files and resolve the repo root from CLIArgs, then hand
	// the neutral inputs to repl.NewKernel — it does the load → typecheck →
	// lower setup (ending BEFORE main runs) and returns any setup errors as
	// values.  The CLI reports them and exits; an embedding driver would
	// surface them however it likes.
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var root @[]char = buf.CopyStr(
			resolveRoot(primaryRoot(cli), cli.Filenames[0]))
	// The driver installs the VM's externs.  Keeping these native bindings in
	// the CLI (not the engine) is what lets the engine live in pkg/binate/repl:
	// a wasm/test host injects its own.
	var registerExterns @func(@vm.VM) = func(vmInst @vm.VM) {
		interp.RegisterStandardExterns(vmInst)
		interp.RegisterPureCExterns(vmInst)
	}
	var s @repl.Kernel
	var errs @[]repl.Error
	s, errs = repl.NewKernel(files, root, cli.BniPaths, cli.ImplPaths, registerExterns)
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			print(errs[i].Msg)
			print("\n")
		}
		os.Exit(1)
	}

	// Banner as data → the driver prints it (the engine no longer prints it).
	print(s.KernelInfo().Banner)
	print("\n")

	// Drive the kernel via the read-loop helper, rendering prompts + Results to
	// stdout: a continuation prompt while the accumulation is still open, and
	// each turn's Notices + diagnostics printed after it evaluates.  (The typed
	// @func vars give the closure literals their flavour hint.)
	var reader @func() (@[]uint8, bool) = readReplLine
	var renderPrompt @func(repl.Completeness) = func(c repl.Completeness) {
		if c.Status == repl.COMP_INCOMPLETE {
			print("... ")
		} else {
			print("> ")
		}
	}
	var renderResult @func(repl.Result) = func(r repl.Result) {
		for i := 0; i < len(r.Notices); i++ {
			print(r.Notices[i].Msg)
			print("\n")
		}
		for i := 0; i < len(r.Err); i++ {
			print(r.Err[i].Value)
			print("\n")
		}
	}
	repl.RunReadLoop(s, reader, renderPrompt, renderResult)
	// eof: match the pre-Kernel CLI's trailing newline before returning.
	print("\n")
}
