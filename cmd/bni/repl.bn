package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/bootstrap"

// runRepl loads the module specified by cli.Filenames, then enters
// an interactive prompt that accepts immediate-mode statement
// lists against the loaded scope.  Tier 1 PoC: no new top-level
// declarations at the prompt, no redefinition, no forward refs,
// and no auto-`println` wrap of bare expressions (type
// `println(...)` explicitly to print).  Errors during a prompt
// turn are reported and control returns to the prompt; nothing
// in the loaded module is affected.  Ctrl-D exits.
func runRepl(cli CLIArgs) {
	// The CLI's sink: both channels write to stdout via print, so the
	// REPL's framing output goes exactly where it did before the sink
	// existed.  An embedding host supplies its own ReplIO.
	var io ReplIO = cliReplIO()
	cli.Filenames = expandDirArgs(cli.Filenames)
	if len(cli.Filenames) == 0 {
		io.WriteErr("error: --repl requires a source file or package\n")
		bootstrap.Exit(1)
	}

	// Parse the source files and resolve the repo root from CLIArgs,
	// then hand the neutral inputs to NewReplSession — it does the
	// load → typecheck → lower setup (ending BEFORE main runs) and
	// returns any setup errors as values.  The CLI reports them and
	// exits; an embedding host would surface them however it likes.
	var files @[]@ast.File = parseSourceFiles(cli.Filenames)
	var root @[]char = buf.CopyStr(
		resolveRoot(primaryRoot(cli), cli.Filenames[0]))
	var s @ReplSession
	var errs @[]ReplError
	s, errs = NewReplSession(files, root, cli.BniPaths, cli.ImplPaths, io)
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			io.WriteErr(errs[i].Msg)
			io.WriteErr("\n")
		}
		bootstrap.Exit(1)
	}

	// === REPL loop ===
	//
	// Multi-line input: lines accumulate until open-bracket depth
	// balances to 0 (i.e., every `{` and `(` has been closed).
	// While accumulating, the prompt switches to `... ` to indicate
	// the previous input is incomplete.  Brackets inside string /
	// char literals and inside `//` / `/* ... */` comments are
	// skipped.  EOF in the middle of an unbalanced block discards
	// the buffered input (silent drop — user bailed).
	s.outln("Binate REPL (Tier 1 PoC). Ctrl-D to exit.")
	for {
		if len(s.Accumulated) == 0 {
			s.out("> ")
		} else {
			s.out("... ")
		}
		var line @[]uint8
		var eof bool
		line, eof = readReplLine()
		if eof { s.outln(""); return }
		// Append the line followed by a newline so the parser sees
		// the same line breaks the user typed.
		for i := 0; i < len(line); i++ {
			s.Accumulated = appendByteRepl(s.Accumulated, line[i])
		}
		s.Accumulated = appendByteRepl(s.Accumulated, 10)
		// Empty input at top level: just reprompt.
		if len(line) == 0 && computeOpenDepth(s.Accumulated) == 0 {
			var empty @[]uint8
			s.Accumulated = empty
			continue
		}
		// Still inside an open `{` or `(` — keep reading.
		if computeOpenDepth(s.Accumulated) > 0 { continue }
		// Complete — evaluate and reset accumulator.
		s.evalReplLine(s.Accumulated)
		var empty @[]uint8
		s.Accumulated = empty
		s.Counter = s.Counter + 1
	}
}

// evalReplLine parses a single REPL turn, dispatches between the
// top-level-decl path (Tier 2 — registers a persistent symbol) and
// the immediate-mode statement-list path (Tier 1 — synthetic
// __repl_<n>() is generated, lowered, and called).  Any errors at
// parse / check stages are reported and the function returns
// without lowering — the loaded state is unaffected.
// evalReplDecl handles top-level decls (lives in repl_decl.bn);
// evalReplImport handles `import` directives (lives in
// repl_import.bn); evalReplStmtList handles bare statements
// (below).  Dispatch on the parser's leading-token classification.
func (s @ReplSession) evalReplLine(src @[]uint8) {
	var p @parser.Parser = parser.New(src, "<repl>")
	if p.IsAtImport() {
		s.evalReplImport(p)
		return
	}
	if p.IsAtTopLevelDecl() {
		s.evalReplDecl(p)
	} else {
		s.evalReplStmtList(p)
	}
}

// evalReplStmtList handles a stmt-list turn: parse → check →
// IR-gen as synthetic __repl_<n>() → lower → call.  Identical to
// the Tier 1 path that used to live in evalReplLine.
func (s @ReplSession) evalReplStmtList(p @parser.Parser) {
	var ss @[]@ast.Stmt = p.ParseStmtList()
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		for i := 0; i < len(perrs); i++ {
			s.errln(perrs[i].Msg)
		}
		return
	}
	if len(ss) == 0 { return }
	var prevErrs int = len(s.Chk.CheckerErrors())
	s.Chk.CheckStmtListInScope(ss)
	var allErrs @[]types.CheckError = s.Chk.CheckerErrors()
	if len(allErrs) > prevErrs {
		for i := prevErrs; i < len(allErrs); i++ {
			s.errln(types.FormatCheckError(allErrs[i]))
		}
		return
	}
	var name @[]char = buf.Concat(
		"__repl_", bootstrap.Itoa(s.Counter))
	var f @ir.Func = ir.GenSyntheticFunc(name, ss)
	s.MainMod.AddFunc(f)
	// Drain managed-aggregate dtor / copy needs the stmt list
	// registered.  Lower helpers first so the synthetic's eager
	// CallCache fill resolves their names.
	var helpersStart int = len(s.MainMod.Funcs)
	ir.EnsureReplBodyHelpers(s.MainMod)
	for i := helpersStart; i < len(s.MainMod.Funcs); i++ {
		s.Vm.LowerOneFunc(s.MainMod, s.MainMod.Funcs[i])
	}
	var vmf @vm.VMFunc = s.Vm.LowerOneFunc(s.MainMod, f)
	if vmf == nil { return }
	var noArgs @[]int
	s.Vm.CallByVMFunc(vmf, noArgs)
}

// cliReplIO is the CLI host's sink: both channels write to stdout via
// the print builtin, so the REPL's framing output lands exactly where
// it did before the sink existed (all on fd 1).  A richer host (wasm
// worker, IDE) supplies a ReplIO that routes elsewhere and may split
// the two channels.
func cliReplIO() ReplIO {
	// The typed @func vars give the closure literals their flavour
	// hint (a bare `field = func(){}` assignment isn't a hint site);
	// the closures capture nothing — they call the print builtin.
	var wOut @func(*[]const char) int = func(str *[]const char) int {
		print(str)
		return len(str)
	}
	var wErr @func(*[]const char) int = func(str *[]const char) int {
		print(str)
		return len(str)
	}
	var io ReplIO
	io.WriteOut = wOut
	io.WriteErr = wErr
	return io
}

// REPL input handling (readReplLine, appendByteRepl,
// computeOpenDepth) lives in repl_input.bn.
