package "main"

import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/types"
import "pkg/vm"

// Tests for evalReplDecl (and the surrounding decl-driver
// machinery in repl_decl.bn).  Shares toBytesRT and
// setupReplState with repl_test.bn — both files are in
// package "main".

// Tier 2: a `func` decl typed at the prompt registers a persistent
// symbol — the new function is added to the module under its real
// name, not a synthetic __repl_<n>.
func TestEvalReplDeclAddsNamedFunc() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	evalReplLine(vmInst, m, c, toBytesRT("func twice(n int) int { return n + n }\n"), 0)
	if len(m.Funcs) != before + 1 {
		return fail("decl should add one func")
	}
	var added @ir.Func = m.Funcs[before]
	// Like synthetic funcs, decl funcs get the module's pkg short
	// qualifier prefixed by IR-gen.
	if !seq(added.Name, "main.twice") {
		return fail("decl func should be named main.twice (qualified)")
	}
	return ""
}

// Parse error in a decl path: same contract — leave module alone.
func TestEvalReplDeclParseErrorPreservesState() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	// Truncated func declaration.
	evalReplLine(vmInst, m, c, toBytesRT("func broken(\n"), 0)
	if len(m.Funcs) != before {
		return fail("parse error in decl must not add a func")
	}
	return ""
}
