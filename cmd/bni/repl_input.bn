package "main"

import "pkg/std/os"

// REPL input handling: the CLI host's read side of the engine loop.
// Both concerns are standalone (no dependence on the type checker / IR
// / VM): reading a single line from stdin (readReplLine) and a one-byte
// append helper (appendByteRepl) it uses.  The multi-line continuation
// heuristic that decides whether accumulated input is complete lives in
// the engine (pkg/binate/repl's Step), not here — the host just pushes
// each line and renders the prompt Step asks for.

// readReplLine reads a line from stdin, byte by byte.  Returns the
// line bytes (without the trailing newline) and an EOF flag.  On a
// genuine EOF (no bytes read since the last line), eof is true; on
// EOF mid-line, the buffered bytes are returned with eof = false
// (the caller will see eof on the next read).
func readReplLine() (@[]uint8, bool) {
	var line @[]uint8
	var buf @[]uint8 = make_slice(uint8, 1)
	for {
		var n int
		n, _ = os.Stdin.Read(buf)
		if n <= 0 {
			return line, len(line) == 0
		}
		if buf[0] == 10 {  // '\n'
			return line, false
		}
		line = appendByteRepl(line, buf[0])
	}
}

// appendByteRepl is a minimal append helper for @[]uint8.  REPL-
// local; pkg/binate/buf has richer string helpers but this avoids pulling
// in extra surface for one byte at a time.
func appendByteRepl(s @[]uint8, b uint8) @[]uint8 {
	var n int = len(s)
	var ns @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = b
	return ns
}
