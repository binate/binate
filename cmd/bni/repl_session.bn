package "main"

import "pkg/binate/ir"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/slices"

// ReplSession owns all state that persists across REPL turns: the
// constructed-once VM / main module / checker, the per-turn counters
// and the multi-line accumulation buffer, and the session loader +
// search paths + processed-package set that mid-session `import`
// entries re-enter the load pipeline with.
//
// Threading this through the engine (rather than holding it in
// package-level globals) is what makes the REPL re-entrant — the host
// can drive one turn at a time against a session value.  Per Stage 1
// of plan-repl-embeddable.md.  The host I/O sink and the interrupt
// poll delegate join this struct in later stages.
//
// v1 keeps ONE live session per process, so the pkg/binate/ir
// process-globals (currentChecker, the import alias map) are still
// shared — see the "remove process-global session state" TODO.  Do
// NOT add new REPL globals: new per-session state belongs here.
type ReplSession struct {
	// Constructed once, shared for the session lifetime:
	Vm      @vm.VM
	MainMod @ir.Module
	Chk     @types.Checker
	// Per-turn-persistent.  Accumulated holds the in-progress
	// multi-line input; Counter feeds the __repl_<n> synthetic names:
	Counter     int
	Accumulated @[]uint8
	// Session import state, re-entered by mid-session `import` turns.
	// Ldr holds the transitive package graph + load order; Root +
	// BniPaths are the search config newly-loaded packages reuse;
	// ProcessedPkgs lists package paths already type-checked + IR-gen'd
	// + lowered, so they aren't reprocessed:
	Ldr           @loader.Loader
	Root          @[]char
	BniPaths      @[]@[]char
	ProcessedPkgs @[]@[]char
	// InitCounter feeds unique names into per-prompt var-initializer
	// synthetics so successive `var x = …; var y = …` entries don't
	// collide on one __repl_var_init symbol.
	InitCounter int
}

// newReplSession assembles a session from the parts runRepl has already
// constructed (parse → load → typecheck → lower).  The processed-package
// set is seeded from the initial load order so those packages aren't
// reprocessed when a later `import` turn pulls in one of their deps.
//
// Stage 2 of plan-repl-embeddable.md folds the construction itself into
// this constructor (returning errors as values instead of runRepl's
// bootstrap.Exit); for now runRepl builds the parts and hands them over.
func newReplSession(vmInst @vm.VM, mainMod @ir.Module,
		c @types.Checker, ldr @loader.Loader, root @[]char,
		bniPaths @[]@[]char, initialOrder @[]@[]char) @ReplSession {
	var s @ReplSession = make(ReplSession)
	s.Vm = vmInst
	s.MainMod = mainMod
	s.Chk = c
	s.Ldr = ldr
	s.Root = root
	s.BniPaths = bniPaths
	var processed @[]@[]char
	for i := 0; i < len(initialOrder); i++ {
		processed = slices.Append[@[]char](processed, initialOrder[i])
	}
	s.ProcessedPkgs = processed
	return s
}
