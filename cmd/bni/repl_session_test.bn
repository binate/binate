package "main"

import "pkg/builtins/testing"

// Tests for assembleSession (repl_session.bn).  It wires the already-
// built parts onto the session and seeds the processed-package set
// from the initial load order so a later mid-session `import` doesn't
// reprocess packages the initial load already handled.  The VM /
// module / checker / loader are only STORED here (no dereference), so
// the tests pass nil for them — the field-wiring + processed-set
// seeding is what this helper owns.  NewReplSession's full setup
// pipeline is exercised end-to-end by e2e/repl.sh.
//
// seq / fail live in args_test.bn; appendToCharSlices in
// repl_import_test.bn (all package "main").

func TestAssembleSessionSeedsProcessedPkgs() testing.TestResult {
	var order @[]@[]char
	order = appendToCharSlices(order, "main")
	order = appendToCharSlices(order, "pkg/a")
	var bni @[]@[]char
	bni = appendToCharSlices(bni, "/extra")
	var s @ReplSession = assembleSession(
		nil, nil, nil, nil, "/root", bni, order)
	if len(s.ProcessedPkgs) != 2 {
		return fail("expected ProcessedPkgs seeded with 2 entries")
	}
	if !seq(s.ProcessedPkgs[0], "main") ||
			!seq(s.ProcessedPkgs[1], "pkg/a") {
		return fail("ProcessedPkgs should mirror the initial order")
	}
	if !seq(s.Root, "/root") {
		return fail("Root should be stored verbatim")
	}
	if len(s.BniPaths) != 1 || !seq(s.BniPaths[0], "/extra") {
		return fail("BniPaths should be stored verbatim")
	}
	if s.Counter != 0 || s.InitCounter != 0 {
		return fail("per-turn counters should start at zero")
	}
	return ""
}

// An empty initial order yields an empty (not nil-dereffing) processed
// set — the seeding loop must handle the zero-package case.
func TestAssembleSessionEmptyOrder() testing.TestResult {
	var order @[]@[]char
	var bni @[]@[]char
	var s @ReplSession = assembleSession(
		nil, nil, nil, nil, "", bni, order)
	if len(s.ProcessedPkgs) != 0 {
		return fail("empty order should seed an empty processed set")
	}
	return ""
}

// appendReplError is the mechanism NewReplSession uses to return
// setup errors as VALUES (instead of printing + bootstrap.Exit, the
// pre-Stage-2 behavior).  Pin that it accumulates messages in order —
// loaderReplErrors / checkerReplErrors build on it, and the CLI shell
// prints each .Msg.  NewReplSession's full setup pipeline (incl. the
// success path) is covered end-to-end by e2e/repl.sh.
func TestAppendReplErrorAccumulatesInOrder() testing.TestResult {
	var out @[]ReplError
	out = appendReplError(out, "first")
	out = appendReplError(out, "second")
	if len(out) != 2 {
		return fail("expected two accumulated errors")
	}
	if !seq(out[0].Msg, "first") || !seq(out[1].Msg, "second") {
		return fail("error messages should be preserved in order")
	}
	return ""
}

// sinkProbe counts diagnostics a host-supplied ReplIO receives.
type sinkProbe struct {
	ErrN int
}

// A host-supplied ReplIO must actually capture the engine's framing
// output — the whole point of Stage 3.  Drive a diagnostic (a type
// error) through a session whose sink is a capturing closure over a
// managed probe, and confirm the diagnostic landed on the host's
// WriteErr channel rather than going straight to stdout.  (The probe is
// @-managed, so the capture is CAP_MANAGED — no raw-pointer warning.)
func TestReplFramingRoutesThroughSink() testing.TestResult {
	var probe @sinkProbe = make(sinkProbe)
	var wOut @func(*[]const char) int = func(str *[]const char) int {
		return len(str)
	}
	var wErr @func(*[]const char) int = func(str *[]const char) int {
		probe.ErrN = probe.ErrN + 1
		return len(str)
	}
	var io ReplIO
	io.WriteOut = wOut
	io.WriteErr = wErr
	var s @ReplSession = setupReplState()
	s.Io = io
	s.evalReplLine(toBytesRT("println(undefinedSym)\n"))
	if probe.ErrN == 0 {
		return fail("a diagnostic must route through the host WriteErr sink")
	}
	return ""
}
