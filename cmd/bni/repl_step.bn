package "main"

// Step / Init drive the REPL one host-pushed line at a time — the
// "coroutine-ish" inversion of runRepl's old for{} loop.  The host owns
// the read: it calls Init() once (pre-prompt), then Step(line, eof) per
// input line, rendering the next prompt from the returned StepResult.
// Per Stage 4 of plan-repl-embeddable.md.

// StepStatus values, carried in StepResult.Status.  (Stage 5 adds
// STEP_SUSPENDED / STEP_BROKE when the interrupt seam lands; appending
// cases is non-breaking.)
//
// These are individual `const` decls rather than a `const ( ... )`
// group: the bare-iota-member forward-reference bug they would
// otherwise trip (members invisible across the package's files) is
// fixed in the current type checker, but cmd/bni is LINTED by the
// BUILDER's bundled bnlint, whose checker predates the fix — so the
// group form fails the lint check until a BUILDER with the fix ships.
// Switch to a `const ( ... iota )` group once BUILDER_VERSION carries
// the collectDecls fix.

// STEP_NEED_MORE: input incomplete; the host shows a continuation prompt.
const STEP_NEED_MORE int = 0
// STEP_EVALUATED: the turn completed; the host shows the primary prompt.
const STEP_EVALUATED int = 1
// STEP_EOF_CLEAN: input ended at a turn boundary.
const STEP_EOF_CLEAN int = 2
// STEP_EOF_UNBALANCED: input ended mid-accumulation; the buffer was discarded.
const STEP_EOF_UNBALANCED int = 3

// StepResult is the outcome of Init / Step plus the data the host needs
// to render the NEXT prompt.  The engine never bakes prompt strings:
// Depth (0 ⇒ primary, >0 ⇒ continuation) and Counter (the In[n] index
// for the next input) let the host render however it likes.  Output is
// already flushed through the sink; StepResult carries only control +
// prompt metadata, never the output payload.
type StepResult struct {
	Status  int
	Counter int
	Depth   int
}

// stepResult builds a StepResult value.
func stepResult(status int, counter int, depth int) StepResult {
	var r StepResult
	r.Status = status
	r.Counter = counter
	r.Depth = depth
	return r
}

// Init runs any pre-prompt initialization, emits its output through the
// sink, and returns the StepResult for the first prompt.  Today the only
// pre-prompt output is the banner (setup ends before main runs); module
// init / result-echo would emit here too when they land.
func (s @ReplSession) Init() StepResult {
	s.outln("Binate REPL (Tier 1 PoC). Ctrl-D to exit.")
	return stepResult(STEP_EVALUATED, s.Counter, 0)
}

// Step feeds ONE host-read line into the session and runs until the next
// prompt is due, returning what the host should render next.  Multi-line
// input accumulates until open-bracket depth balances to 0 (every `{`
// and `(` closed; brackets inside strings / char literals / comments are
// skipped) — until then Step returns STEP_NEED_MORE so the host shows a
// continuation prompt.  eof at a turn boundary → STEP_EOF_CLEAN; eof
// mid-accumulation discards the buffered input (the user bailed) →
// STEP_EOF_UNBALANCED.  A complete turn is evaluated via evalReplLine,
// the accumulator is reset, and Counter advances.
func (s @ReplSession) Step(line *[]readonly uint8, eof bool) StepResult {
	if eof {
		if len(s.Accumulated) > 0 {
			var empty @[]uint8
			s.Accumulated = empty
			return stepResult(STEP_EOF_UNBALANCED, s.Counter, 0)
		}
		return stepResult(STEP_EOF_CLEAN, s.Counter, 0)
	}
	// Append the line followed by a newline so the parser sees the
	// same line breaks the user typed.
	for i := 0; i < len(line); i++ {
		s.Accumulated = appendByteRepl(s.Accumulated, line[i])
	}
	s.Accumulated = appendByteRepl(s.Accumulated, 10)
	// Empty input at top level: nothing to do — reprompt at primary.
	if len(line) == 0 && computeOpenDepth(s.Accumulated) == 0 {
		var empty @[]uint8
		s.Accumulated = empty
		return stepResult(STEP_EVALUATED, s.Counter, 0)
	}
	// Still inside an open `{` or `(` — keep reading.
	var depth int = computeOpenDepth(s.Accumulated)
	if depth > 0 {
		return stepResult(STEP_NEED_MORE, s.Counter, depth)
	}
	// Complete — evaluate and reset the accumulator.
	s.evalReplLine(s.Accumulated)
	var empty @[]uint8
	s.Accumulated = empty
	s.Counter = s.Counter + 1
	return stepResult(STEP_EVALUATED, s.Counter, 0)
}
