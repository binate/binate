package "main"

import "pkg/binate/repl"
import "pkg/builtins/testing"

// Tests for the CLI REPL driver (repl.bn).  runRepl itself is the interactive
// driver — exercised end-to-end by e2e/repl.sh; here we pin promptFor, the
// prompt-selection logic pulled out of runRepl's renderPrompt closure.  fail /
// seq live in args_test.bn.

// promptFor picks the continuation prompt when the accumulation is still open
// (COMP_INCOMPLETE) and the primary prompt otherwise.
func TestPromptForPrimaryAndContinuation() testing.TestResult {
	var complete repl.Completeness
	complete.Status = repl.COMP_COMPLETE
	if !seq(promptFor(complete), "> ") {
		return fail("a complete unit should get the primary prompt")
	}
	var incomplete repl.Completeness
	incomplete.Status = repl.COMP_INCOMPLETE
	incomplete.Indent = 2
	if !seq(promptFor(incomplete), "... ") {
		return fail("an open unit should get the continuation prompt")
	}
	return ""
}
