package "main"

import "pkg/binate/ast"
import "pkg/binate/ir"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/binate/vm"
import "pkg/builtins/testing"

// REPL input-helper tests (computeOpenDepth, appendByteRepl)
// live in repl_input_test.bn alongside their implementation in
// repl_input.bn.  toBytesRT below is shared with that file via
// the package.

func toBytesRT(s *[]const char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

// ============================================================
// evalReplLine tests — Tier 1 (stmt-list) and Tier 2 (decl) paths
// ============================================================

// Build a minimal main module so the checker has a scope to install
// for CheckStmtListInScope. Mirrors what runRepl does post-load,
// minus the loader / VM lowering of dependencies.
func setupReplState() @ReplSession {
	var srcStr *[]const char = "package \"main\"\nfunc main() { }\n"
	var src @[]uint8 = toBytesRT(srcStr)
	var p @parser.Parser = parser.New(src, "<test>")
	var f @ast.File = p.ParseFile()
	var c @types.Checker = types.NewChecker()
	c.CheckMainPersistent(f)
	var m @ir.Module = ir.InitModule(f.PkgName)
	ir.GeneratePackage(f, m)
	var vmInst @vm.VM = vm.NewVM(64 * 1024)
	vm.RegisterStandardExterns(vmInst)
	registerPureCExterns(vmInst)
	vmInst.LowerModule(m)
	// The import-session fields stay zero — these tests exercise the
	// stmt-list and decl paths, not mid-session `import`.
	var s @ReplSession = make(ReplSession)
	s.Vm = vmInst
	s.MainMod = m
	s.Chk = c
	return s
}

// A valid stmt-list turn must add a synthetic __repl_<n> function
// to the module — the marker the loop uses to confirm the entry
// landed. Tier 1 contract. (`println(...)` is a call-expr-stmt;
// `var x int = 1` would be routed through the top-level-decl path.)
func TestEvalReplStmtListAddsSyntheticFunc() testing.TestResult {
	var s @ReplSession = setupReplState()
	var before int = len(s.MainMod.Funcs)
	s.Counter = 7
	s.evalReplLine(toBytesRT("println(\"hi\")\n"))
	if len(s.MainMod.Funcs) != before + 1 {
		return fail("expected one new func added to module")
	}
	var added @ir.Func = s.MainMod.Funcs[before]
	// __repl_<n> is the synthetic name evalReplStmtList uses.
	// IR-gen qualifies func names with the module's pkg short name,
	// so the loaded "main" package prefixes the synthetic.
	var expected @[]char = "main.__repl_7"
	if !seq(added.Name, expected) {
		return fail("synthetic func should be named main.__repl_7")
	}
	return ""
}

// A parse error must NOT add a function. The REPL is supposed to
// leave loaded state untouched on bad input; a stray func sneaking
// in would be a regression that violates that contract.
func TestEvalReplStmtListParseErrorPreservesState() testing.TestResult {
	var s @ReplSession = setupReplState()
	var before int = len(s.MainMod.Funcs)
	// Unbalanced brace — parser rejects.
	s.evalReplLine(toBytesRT("if x {\n"))
	if len(s.MainMod.Funcs) != before {
		return fail("parse error must not add a func")
	}
	return ""
}

// A type error must NOT add a function, same contract as the
// parse-error case. `println(undefinedSym)` is a stmt (not a
// top-level decl), so the dispatch goes to evalReplStmtList; the
// reference fails to resolve in the checker.
func TestEvalReplStmtListTypeErrorPreservesState() testing.TestResult {
	var s @ReplSession = setupReplState()
	var before int = len(s.MainMod.Funcs)
	s.evalReplLine(toBytesRT("println(undefinedSym)\n"))
	if len(s.MainMod.Funcs) != before {
		return fail("type error must not add a func")
	}
	return ""
}
