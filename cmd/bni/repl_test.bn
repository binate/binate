package "main"

import "pkg/builtin/testing"

// ============================================================
// computeBraceDepth tests
// ============================================================
//
// Exercises the multi-line REPL helper that decides when
// accumulated input is complete (depth 0) or needs another
// continuation prompt (depth > 0).  The function ignores braces
// inside string / char literals and inside `//` / `/* ... */`
// comments — these tests pin those edge cases that the e2e
// transcript can't easily distinguish.

func toBytesRT(s *[]const char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func TestBraceDepthEmpty() testing.TestResult {
	if computeBraceDepth(toBytesRT("")) != 0 {
		return fail("empty input must have depth 0")
	}
	return ""
}

func TestBraceDepthSingleOpen() testing.TestResult {
	if computeBraceDepth(toBytesRT("for i := 0; i < 3; i++ {")) != 1 {
		return fail("trailing `{` must give depth 1")
	}
	return ""
}

func TestBraceDepthBalanced() testing.TestResult {
	if computeBraceDepth(toBytesRT("for i := 0; i < 3; i++ { println(i) }")) != 0 {
		return fail("balanced for-block must give depth 0")
	}
	return ""
}

func TestBraceDepthNested() testing.TestResult {
	if computeBraceDepth(toBytesRT("if x { for { } }")) != 0 {
		return fail("nested balanced braces must give depth 0")
	}
	if computeBraceDepth(toBytesRT("if x { for {")) != 2 {
		return fail("two unclosed `{` must give depth 2")
	}
	return ""
}

func TestBraceDepthBracesInString() testing.TestResult {
	if computeBraceDepth(toBytesRT("println(\"hi {world}\")")) != 0 {
		return fail("braces inside `\"...\"` must not count")
	}
	if computeBraceDepth(toBytesRT("println(\"oops {\")")) != 0 {
		return fail("`{` inside string must not affect depth")
	}
	return ""
}

func TestBraceDepthEscapedQuoteInString() testing.TestResult {
	// A `\"` inside a string is an escaped quote, not a string
	// terminator.  Ensures the escape-handling logic doesn't end
	// the string early and start counting braces in subsequent
	// raw text.
	if computeBraceDepth(toBytesRT("println(\"a \\\"b\\\" c {\")")) != 0 {
		return fail("`{` after escaped quote inside string must not count")
	}
	return ""
}

func TestBraceDepthBracesInLineComment() testing.TestResult {
	if computeBraceDepth(toBytesRT("for { // close: }")) != 1 {
		return fail("`}` inside line comment must not close the brace")
	}
	if computeBraceDepth(toBytesRT("// {{{}}}")) != 0 {
		return fail("braces in line comment must not affect depth")
	}
	return ""
}

func TestBraceDepthBracesInBlockComment() testing.TestResult {
	if computeBraceDepth(toBytesRT("for { /* close: } */")) != 1 {
		return fail("`}` inside `/* ... */` must not close the brace")
	}
	if computeBraceDepth(toBytesRT("/* {{{ */ for { }")) != 0 {
		return fail("braces in block comment must not affect depth")
	}
	return ""
}

func TestBraceDepthBracesInCharLit() testing.TestResult {
	// A single-char literal `'{'` is a char value, not an open
	// brace.  Same for `'}'`.
	if computeBraceDepth(toBytesRT("var c char = '{'")) != 0 {
		return fail("`'{'` char literal must not count as an open brace")
	}
	if computeBraceDepth(toBytesRT("for { var c char = '}' }")) != 0 {
		return fail("`'}'` char literal must not close the for-block")
	}
	return ""
}

func TestBraceDepthExtraClose() testing.TestResult {
	// More closes than opens: clamped to 0 so the parser sees the
	// imbalance and reports it as a syntax error rather than the
	// REPL hanging on a continuation prompt.
	if computeBraceDepth(toBytesRT("} extra")) != 0 {
		return fail("extra `}` must clamp depth to 0, not go negative")
	}
	return ""
}
