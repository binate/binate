package "main"

import "pkg/binate/repl"
import "pkg/builtins/testing"

// Tests for the CLI REPL host (repl.bn).  runRepl itself is the
// interactive driver — exercised end-to-end by e2e/repl.sh; here we pin
// cliReplIO, the host's sink wiring.  fail lives in args_test.bn.

// cliReplIO must wire BOTH channels to callable sinks that honour the
// WriteOut/WriteErr contract (return the number of bytes written).
// Empty writes exercise that contract without emitting visible output
// into the test stream.
func TestCliReplIOChannelsReturnLength() testing.TestResult {
	var io repl.ReplIO = cliReplIO()
	if io.WriteOut("") != 0 {
		return fail("WriteOut(\"\") should report 0 bytes written")
	}
	if io.WriteErr("") != 0 {
		return fail("WriteErr(\"\") should report 0 bytes written")
	}
	return ""
}
