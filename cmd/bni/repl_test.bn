package "main"

import "pkg/ast"
import "pkg/builtin/testing"
import "pkg/ir"
import "pkg/parser"
import "pkg/types"
import "pkg/vm"

// ============================================================
// computeOpenDepth tests
// ============================================================
//
// Exercises the multi-line REPL helper that decides when
// accumulated input is complete (depth 0) or needs another
// continuation prompt (depth > 0).  Tracks unclosed `{` and
// unclosed `(`, ignoring brackets inside string / char literals
// and inside `//` / `/* ... */` comments — these tests pin
// those edge cases that the e2e transcript can't easily
// distinguish.

func toBytesRT(s *[]const char) @[]uint8 {
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	return b
}

func TestOpenDepthEmpty() testing.TestResult {
	if computeOpenDepth(toBytesRT("")) != 0 {
		return fail("empty input must have depth 0")
	}
	return ""
}

func TestOpenDepthSingleOpen() testing.TestResult {
	if computeOpenDepth(toBytesRT("for i := 0; i < 3; i++ {")) != 1 {
		return fail("trailing `{` must give depth 1")
	}
	return ""
}

func TestOpenDepthBalanced() testing.TestResult {
	if computeOpenDepth(toBytesRT("for i := 0; i < 3; i++ { println(i) }")) != 0 {
		return fail("balanced for-block must give depth 0")
	}
	return ""
}

func TestOpenDepthNested() testing.TestResult {
	if computeOpenDepth(toBytesRT("if x { for { } }")) != 0 {
		return fail("nested balanced braces must give depth 0")
	}
	if computeOpenDepth(toBytesRT("if x { for {")) != 2 {
		return fail("two unclosed `{` must give depth 2")
	}
	return ""
}

func TestOpenDepthBracesInString() testing.TestResult {
	if computeOpenDepth(toBytesRT("println(\"hi {world}\")")) != 0 {
		return fail("braces inside `\"...\"` must not count")
	}
	if computeOpenDepth(toBytesRT("println(\"oops {\")")) != 0 {
		return fail("`{` inside string must not affect depth")
	}
	return ""
}

func TestOpenDepthEscapedQuoteInString() testing.TestResult {
	// A `\"` inside a string is an escaped quote, not a string
	// terminator.  Ensures the escape-handling logic doesn't end
	// the string early and start counting braces in subsequent
	// raw text.
	if computeOpenDepth(toBytesRT("println(\"a \\\"b\\\" c {\")")) != 0 {
		return fail("`{` after escaped quote inside string must not count")
	}
	return ""
}

func TestOpenDepthBracesInLineComment() testing.TestResult {
	if computeOpenDepth(toBytesRT("for { // close: }")) != 1 {
		return fail("`}` inside line comment must not close the brace")
	}
	if computeOpenDepth(toBytesRT("// {{{}}}")) != 0 {
		return fail("braces in line comment must not affect depth")
	}
	return ""
}

func TestOpenDepthBracesInBlockComment() testing.TestResult {
	if computeOpenDepth(toBytesRT("for { /* close: } */")) != 1 {
		return fail("`}` inside `/* ... */` must not close the brace")
	}
	if computeOpenDepth(toBytesRT("/* {{{ */ for { }")) != 0 {
		return fail("braces in block comment must not affect depth")
	}
	return ""
}

func TestOpenDepthBracesInCharLit() testing.TestResult {
	// A single-char literal `'{'` is a char value, not an open
	// brace.  Same for `'}'`.
	if computeOpenDepth(toBytesRT("var c char = '{'")) != 0 {
		return fail("`'{'` char literal must not count as an open brace")
	}
	if computeOpenDepth(toBytesRT("for { var c char = '}' }")) != 0 {
		return fail("`'}'` char literal must not close the for-block")
	}
	return ""
}

func TestOpenDepthExtraClose() testing.TestResult {
	// More closes than opens: clamped to 0 so the parser sees the
	// imbalance and reports it as a syntax error rather than the
	// REPL hanging on a continuation prompt.
	if computeOpenDepth(toBytesRT("} extra")) != 0 {
		return fail("extra `}` must clamp depth to 0, not go negative")
	}
	if computeOpenDepth(toBytesRT(") extra")) != 0 {
		return fail("extra `)` must clamp depth to 0")
	}
	return ""
}

func TestOpenDepthSingleOpenParen() testing.TestResult {
	// Multi-line `const ( ... )`: until the closing `)` arrives,
	// the input is incomplete.
	if computeOpenDepth(toBytesRT("const (")) != 1 {
		return fail("trailing `(` must give depth 1")
	}
	if computeOpenDepth(toBytesRT("const (\n  A = 10\n  B = 20\n")) != 1 {
		return fail("unclosed `(` across lines must give depth 1")
	}
	return ""
}

func TestOpenDepthBalancedParens() testing.TestResult {
	if computeOpenDepth(toBytesRT("const ( A = 10; B = 20 )")) != 0 {
		return fail("balanced const(...) must give depth 0")
	}
	if computeOpenDepth(toBytesRT("println(helper(7))")) != 0 {
		return fail("nested balanced calls must give depth 0")
	}
	return ""
}

func TestOpenDepthMixedBraceParen() testing.TestResult {
	// A `func` body that itself contains a parenthesised expression
	// — both must close before the input is considered complete.
	if computeOpenDepth(toBytesRT("func f() int {")) != 1 {
		return fail("`func f() int {` must give depth 1 (`(`+`)` cancel; `{` open)")
	}
	if computeOpenDepth(toBytesRT("func f(x int) int { return (x + 1) }")) != 0 {
		return fail("balanced func decl with paren expr must give depth 0")
	}
	return ""
}

func TestOpenDepthParensInString() testing.TestResult {
	if computeOpenDepth(toBytesRT("println(\"hi (world\")")) != 0 {
		return fail("`(` inside string must not affect depth")
	}
	if computeOpenDepth(toBytesRT("println(\"oops )\")")) != 0 {
		return fail("`)` inside string must not affect depth")
	}
	return ""
}

func TestOpenDepthParensInLineComment() testing.TestResult {
	if computeOpenDepth(toBytesRT("const ( // open: (\n")) != 1 {
		return fail("`(` inside line comment must not count")
	}
	if computeOpenDepth(toBytesRT("// (((")) != 0 {
		return fail("parens in line comment must not affect depth")
	}
	return ""
}

// ============================================================
// appendByteRepl tests
// ============================================================

func TestAppendByteReplEmpty() testing.TestResult {
	var s @[]uint8
	var r @[]uint8 = appendByteRepl(s, cast(uint8, 65))
	if len(r) != 1 { return fail("len after appendByteRepl on empty == 1") }
	if r[0] != cast(uint8, 65) { return fail("first byte == 'A'") }
	return ""
}

func TestAppendByteReplGrows() testing.TestResult {
	var s @[]uint8 = make_slice(uint8, 2)
	s[0] = cast(uint8, 1)
	s[1] = cast(uint8, 2)
	var r @[]uint8 = appendByteRepl(s, cast(uint8, 3))
	if len(r) != 3 { return fail("len after grow == 3") }
	if r[0] != cast(uint8, 1) { return fail("byte 0 preserved") }
	if r[1] != cast(uint8, 2) { return fail("byte 1 preserved") }
	if r[2] != cast(uint8, 3) { return fail("byte 2 == new") }
	return ""
}

// ============================================================
// evalReplLine tests — Tier 1 (stmt-list) and Tier 2 (decl) paths
// ============================================================

// Build a minimal main module so the checker has a scope to install
// for CheckStmtListInScope. Mirrors what runRepl does post-load,
// minus the loader / VM lowering of dependencies.
func setupReplState() (@types.Checker, @ir.Module, @vm.VM) {
	var srcStr *[]const char = "package \"main\"\nfunc main() { }\n"
	var src @[]uint8 = toBytesRT(srcStr)
	var p @parser.Parser = parser.New(src, "<test>")
	var f @ast.File = parser.ParseFile(p)
	var c @types.Checker = types.NewChecker()
	types.CheckMainPersistent(c, f)
	var m @ir.Module = ir.InitModule(f.PkgName)
	ir.GeneratePackage(f, m)
	var vmInst @vm.VM = vm.NewVM(64 * 1024)
	vm.LowerModule(vmInst, m)
	return c, m, vmInst
}

// A valid stmt-list turn must add a synthetic __repl_<n> function
// to the module — the marker the loop uses to confirm the entry
// landed. Tier 1 contract. (`println(...)` is a call-expr-stmt;
// `var x int = 1` would be routed through the top-level-decl path.)
func TestEvalReplStmtListAddsSyntheticFunc() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	evalReplLine(vmInst, m, c, toBytesRT("println(\"hi\")\n"), 7)
	if len(m.Funcs) != before + 1 {
		return fail("expected one new func added to module")
	}
	var added @ir.Func = m.Funcs[before]
	// __repl_<n> is the synthetic name evalReplStmtList uses.
	// IR-gen qualifies func names with the module's pkg short name,
	// so the loaded "main" package prefixes the synthetic.
	var expected @[]char = "main.__repl_7"
	if !seq(added.Name, expected) {
		return fail("synthetic func should be named main.__repl_7")
	}
	return ""
}

// A parse error must NOT add a function. The REPL is supposed to
// leave loaded state untouched on bad input; a stray func sneaking
// in would be a regression that violates that contract.
func TestEvalReplStmtListParseErrorPreservesState() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	// Unbalanced brace — parser rejects.
	evalReplLine(vmInst, m, c, toBytesRT("if x {\n"), 0)
	if len(m.Funcs) != before {
		return fail("parse error must not add a func")
	}
	return ""
}

// A type error must NOT add a function, same contract as the
// parse-error case. `println(undefinedSym)` is a stmt (not a
// top-level decl), so the dispatch goes to evalReplStmtList; the
// reference fails to resolve in the checker.
func TestEvalReplStmtListTypeErrorPreservesState() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	evalReplLine(vmInst, m, c, toBytesRT("println(undefinedSym)\n"), 1)
	if len(m.Funcs) != before {
		return fail("type error must not add a func")
	}
	return ""
}

// Tier 2: a `func` decl typed at the prompt registers a persistent
// symbol — the new function is added to the module under its real
// name, not a synthetic __repl_<n>.
func TestEvalReplDeclAddsNamedFunc() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	evalReplLine(vmInst, m, c, toBytesRT("func twice(n int) int { return n + n }\n"), 0)
	if len(m.Funcs) != before + 1 {
		return fail("decl should add one func")
	}
	var added @ir.Func = m.Funcs[before]
	// Like synthetic funcs, decl funcs get the module's pkg short
	// qualifier prefixed by IR-gen.
	if !seq(added.Name, "main.twice") {
		return fail("decl func should be named main.twice (qualified)")
	}
	return ""
}

// Parse error in a decl path: same contract — leave module alone.
func TestEvalReplDeclParseErrorPreservesState() testing.TestResult {
	var c @types.Checker
	var m @ir.Module
	var vmInst @vm.VM
	c, m, vmInst = setupReplState()
	var before int = len(m.Funcs)
	// Truncated func declaration.
	evalReplLine(vmInst, m, c, toBytesRT("func broken(\n"), 0)
	if len(m.Funcs) != before {
		return fail("parse error in decl must not add a func")
	}
	return ""
}
