package "main"

import "pkg/builtins/testing"

// Tests for the --test runner's result decoding (test.bn).  Test discovery itself
// is check.Checker.IsTestFunc, tested in pkg/binate/check.

// A null result address and a zero-length result both read as "" — a pass.
func TestReadResultStrEmpty() testing.TestResult {
	if len(readResultStr(0)) != 0 { return "a null result address should read as empty" }
	var hdr [4]int
	if len(readResultStr(bit_cast(int, &hdr[0]))) != 0 {
		return "a zero-length result should read as empty"
	}
	return ""
}

// A non-empty result is copied out through the managed-slice header's data and
// length words.
func TestReadResultStrCopiesText() testing.TestResult {
	var text [4]uint8
	text[0] = 'f'
	text[1] = 'a'
	text[2] = 'i'
	text[3] = 'l'
	var hdr [4]int
	hdr[0] = bit_cast(int, &text[0])
	hdr[1] = 4
	var got @[]char = readResultStr(bit_cast(int, &hdr[0]))
	if len(got) != 4 || got[0] != 'f' || got[1] != 'a' || got[2] != 'i' || got[3] != 'l' {
		return "the result text should be copied out of the header"
	}
	return ""
}
