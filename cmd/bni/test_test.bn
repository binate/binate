package "main"

import "pkg/binate/ast"
import "pkg/binate/parser"
import "pkg/builtins/testing"

// Tests for --test's Test* discovery helpers (test.bn).

// declsOf parses src and returns its top-level declarations.
func declsOf(src *[]readonly char) @[]@ast.Decl {
	var b @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ { b[i] = cast(uint8, src[i]) }
	var p @parser.Parser = parser.New(b, "t.bn")
	return p.ParseFile().Decls
}

// funcNamed returns the func decl named `name` in decls, or nil.
func funcNamed(decls @[]@ast.Decl, name *[]readonly char) @ast.Decl {
	for i := 0; i < len(decls); i++ {
		if decls[i].Kind == ast.DECL_FUNC && streq(decls[i].Name, name) { return decls[i] }
	}
	return nil
}

func TestIsTestResultReturnForms() testing.TestResult {
	var decls @[]@ast.Decl = declsOf(
			"package \"p\"\n"
					"func TestA() testing.TestResult { return \"\" }\n"
					"func TestB() @[]char { return \"\" }\n"
					"func TestC() int { return 0 }\n"
					"func TestD() TestResult { return \"\" }\n"
					"func TestE() other.TestResult { return \"\" }\n")
	if !isTestResultReturn(funcNamed(decls, "TestA"), decls) { return "testing.TestResult is a test" }
	if !isTestResultReturn(funcNamed(decls, "TestB"), decls) { return "@[]char is a test" }
	if isTestResultReturn(funcNamed(decls, "TestC"), decls) { return "int is not a test" }
	if isTestResultReturn(funcNamed(decls, "TestD"), decls) {
		return "bare TestResult without a local type is not a test"
	}
	if isTestResultReturn(funcNamed(decls, "TestE"), decls) { return "other.TestResult is not a test" }
	return ""
}

func TestBareTestResultWithLocalType() testing.TestResult {
	var decls @[]@ast.Decl = declsOf(
			"package \"testing\"\n"
					"type TestResult @[]char\n"
					"func TestD() TestResult { return \"\" }\n")
	if !hasLocalTestResultType(decls) { return "expected the local TestResult type" }
	if !isTestResultReturn(funcNamed(decls, "TestD"), decls) {
		return "bare TestResult with a local type is a test"
	}
	return ""
}
