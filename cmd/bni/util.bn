package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/loader"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/stdx/containers/vec"

// readFile reads an entire file into a byte slice.
func readFile(path *[]readonly char) @[]uint8 {
	var f @os.File
	var err @errors.Error
	f, err = os.Open(path)
	if present(err) {
		var empty @[]uint8
		return empty
	}

	var cap int = 4096
	var data @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var readBuf @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int
		n, err = f.Read(readBuf)
		if n <= 0 {
			break
		}
		// Grow if needed
		for total + n > cap {
			var newCap int = cap * 2
			var newData @[]uint8 = make_slice(uint8, newCap)
			for j := 0; j < total; j++ {
				newData[j] = data[j]
			}
			data = newData
			cap = newCap
		}
		for i := 0; i < n; i++ {
			data[total + i] = readBuf[i]
		}
		total = total + n
	}
	_ = f.Close()
	return data[0:total]
}

// streq compares two char slices.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// splitColon splits a string on ':' (POSIX PATH style). Empty
// entries are dropped, so "A::B" yields ["A", "B"]; trailing/leading
// colons are benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]readonly char) @[]@[]char {
	var out @vec.Vec[@[]char] = vec.New[@[]char]()
	if len(s) == 0 { return out.Items() }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out.Push(part)
			}
			start = i + 1
		}
	}
	return out.Items()
}

// envPathList selects the effective env-derived search path for one of the two
// package paths.  The long/primary form wins over the short alias: if the
// primary env var was SET (present, even to the empty string) its value is used
// and the alias is not consulted; else the alias's value if it was set; else no
// entries.  The chosen value is colon-split (POSIX PATH style, via splitColon).
// Reading the environment is envPaths's job; this pure core takes the two
// Getenv results so the precedence/split logic is unit-testable (the environment
// is a shared process-wide snapshot with no per-variable setter, so it can't be
// staged inside a unit test).
func envPathList(primaryVal *[]readonly char, primarySet bool, aliasVal *[]readonly char,
		aliasSet bool) @[]@[]char {
	if primarySet { return splitColon(primaryVal) }
	if aliasSet { return splitColon(aliasVal) }
	var empty @[]@[]char
	return empty
}

// envPaths reads a package search path from the environment via its long/primary
// variable name and its short alias, returning the effective entries.  Both are
// read so all precedence lives in the unit-tested envPathList.  Used as the
// per-path fallback when the CLI gave no -I (interface) / -L (impl) entry.
func envPaths(primary *[]readonly char, alias *[]readonly char) @[]@[]char {
	pv, pset := os.Getenv(primary)
	av, aset := os.Getenv(alias)
	return envPathList(pv, pset, av, aset)
}

// applyPathFlags appends -I / --interface-path entries to the loader's
// BniPath and -L / --impl-path entries to its ImplPath.  CLI-supplied
// paths come AFTER the primary-root-derived defaults — per-flag
// entries extend rather than replace them.
func applyPathFlags(ldr @loader.Loader, cli CLIArgs) {
	addLoaderPaths(ldr, cli.BniPaths.Items(), cli.ImplPaths.Items())
}

// addLoaderPaths registers the -I (bni) and --interface-path (impl)
// search lists on the loader.  Takes the path lists directly (rather
// than CLIArgs) so it composes from either the CLI flags
// (applyPathFlags) or any other caller without coupling to the arg
// struct.
func addLoaderPaths(ldr @loader.Loader, bniPaths @[]@[]char, implPaths @[]@[]char) {
	for i := 0; i < len(bniPaths); i++ {
		ldr.AddBniPath(bniPaths[i])
	}
	for i := 0; i < len(implPaths); i++ {
		ldr.AddImplPath(implPaths[i])
	}
}

// dirOf returns the directory part of a path.
func dirOf(path *[]readonly char) *[]readonly char {
	var last int = -1
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i
		}
	}
	if last < 0 {
		return ""
	}
	return path[0:last]
}

// Append helpers for managed slices
func appendCharSlice(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendFilePtr appends an AST file pointer to a managed slice.
func appendFilePtr(s @[]@ast.File, v @ast.File) @[]@ast.File {
	var n int = len(s)
	var ns @[]@ast.File = make_slice(@ast.File, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImportSpec appends an import spec to a managed slice.
func appendImportSpec(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// hasPrefix returns true if s starts with prefix.
func hasPrefix(s *[]readonly char, prefix *[]readonly char) bool {
	if len(s) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return false }
	}
	return true
}

// containsStr returns true if s contains sub as a substring. Empty
// sub matches anything.  O(len(s) * len(sub)); fine for short
// strings (test-name filtering).
func containsStr(s *[]readonly char, sub *[]readonly char) bool {
	if len(sub) == 0 { return true }
	if len(sub) > len(s) { return false }
	var stop int = len(s) - len(sub)
	for i := 0; i <= stop; i++ {
		var match bool = true
		for j := 0; j < len(sub); j++ {
			if s[i + j] != sub[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}

// quotePath wraps a path string in double quotes.
func quotePath(s *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('"')
	b.Write(s)
	b.WriteByte('"')
	// quotePath's result feeds ast.ImportSpec.Path (@[]char, an in-cone
	// type), so hand off an owned mutable copy.
	return buf.CopyStr(b.String())
}
