package "main"

import "pkg/ast"
import "pkg/bootstrap"
import "pkg/debug"
import "pkg/loader"
import "pkg/parser"
import "pkg/types"

// typecheckAll type-checks all loaded packages and a main file.
func typecheckAll(ldr @loader.Loader, root @[]char, mainFile @ast.File) {
	var c @types.Checker = types.NewChecker()
	loadBuiltinBNIs(c, ldr, root)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	if mainFile != nil {
		c.Check(mainFile)
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(errs[i].Msg)
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
}

// typecheckPackages type-checks loaded packages (no main file).
func typecheckPackages(ldr @loader.Loader, root @[]char) {
	var c @types.Checker = types.NewChecker()
	loadBuiltinBNIs(c, ldr, root)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(errs[i].Msg)
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
}

// loadBuiltinBNIs loads .bni files for builtin packages into the type checker.
func loadBuiltinBNIs(c @types.Checker, ldr @loader.Loader, root @[]char) {
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || !pkg.Builtin { continue }
		var bniPath @[]char = bootstrap.Concat(
			bootstrap.Concat(root, "/"),
			bootstrap.Concat(ldr.Order[i], ".bni"))
		var bniSrc @[]uint8 = readFile(bniPath)
		if len(bniSrc) > 0 {
			var p @parser.Parser = parser.NewInterface(bniSrc, bniPath)
			var bniFile @ast.File = p.ParseFile()
			var bniErrs @[]parser.ParseError = p.Errors()
			if len(bniErrs) == 0 {
				c.LoadPackageInterface(ldr.Order[i], bniFile)
			}
		}
	}
}

// readFile reads an entire file into a byte slice.
func readFile(path *[]const char) @[]uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 {
		var empty @[]uint8
		return empty
	}

	var cap int = 4096
	var data @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var readBuf @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int = bootstrap.Read(fd, readBuf)
		if n <= 0 {
			break
		}
		// Grow if needed
		for total + n > cap {
			var newCap int = cap * 2
			var newData @[]uint8 = make_slice(uint8, newCap)
			for j := 0; j < total; j++ {
				newData[j] = data[j]
			}
			data = newData
			cap = newCap
		}
		for i := 0; i < n; i++ {
			data[total + i] = readBuf[i]
		}
		total = total + n
	}
	bootstrap.Close(fd)
	return data[0:total]
}

// streq compares two char slices.
func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// splitColon splits a string on ':' (POSIX PATH style). Empty
// entries are dropped, so "A::B" yields ["A", "B"]; trailing/leading
// colons are benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]const char) @[]@[]char {
	var out @[]@[]char
	if len(s) == 0 { return out }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out = appendCharSlice(out, part)
			}
			start = i + 1
		}
	}
	return out
}

// applyPathFlags appends -I / --interface-path entries to the loader's
// BniPath and -L / --impl-path entries to its ImplPath. CLI-supplied
// paths come AFTER --root-derived paths, so per-flag entries extend
// (rather than replace) what the root-derived defaults provide.
func applyPathFlags(ldr @loader.Loader, cli CLIArgs) {
	for i := 0; i < len(cli.BniPaths); i++ {
		ldr.AddBniPath(cli.BniPaths[i])
	}
	for i := 0; i < len(cli.ImplPaths); i++ {
		ldr.AddImplPath(cli.ImplPaths[i])
	}
}

// dirOf returns the directory part of a path.
func dirOf(path *[]const char) *[]const char {
	var last int = -1
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i
		}
	}
	if last < 0 {
		return ""
	}
	return path[0:last]
}

// Append helpers for managed slices
func appendCharSlice(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendFilePtr appends an AST file pointer to a managed slice.
func appendFilePtr(s @[]@ast.File, v @ast.File) @[]@ast.File {
	var n int = len(s)
	var ns @[]@ast.File = make_slice(@ast.File, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImportSpec appends an import spec to a managed slice.
func appendImportSpec(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// hasPrefix returns true if s starts with prefix.
func hasPrefix(s *[]const char, prefix *[]const char) bool {
	if len(s) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return false }
	}
	return true
}

// quotePath wraps a path string in double quotes.
func quotePath(s *[]const char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = cb.WriteByte('"')
	cb = cb.WriteStr(s)
	cb = cb.WriteByte('"')
	return cb.Bytes()
}

// ensureBootstrapLoaded loads pkg/bootstrap into the loader if not
// already present. The IR-gen for the print/println builtin emits
// direct calls to certain pkg/bootstrap functions (format helpers +
// Write) regardless of whether user code imports pkg/bootstrap, so
// it must always be loaded — both for the compiler and the VM.
func ensureBootstrapLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/bootstrap") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/bootstrap\""
	syntheticImports = appendImportSpec(syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}
