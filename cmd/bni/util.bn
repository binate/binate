package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/debug"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/bootstrap"
import "pkg/std/strings"

// typecheckAll type-checks all loaded packages and a main file,
// returning the populated Checker.  IR-gen consumes the returned
// instance — see plan-ir-gen-typed-literals.md Phase A1.
func typecheckAll(ldr @loader.Loader, mainFile @ast.File) @types.Checker {
	var c @types.Checker = types.NewChecker()
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	if mainFile != nil {
		c.Check(mainFile)
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(types.FormatCheckError(errs[i]))
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
	return c
}

// typecheckPackages type-checks loaded packages (no main file).
// Returns the populated Checker for the same reasons as typecheckAll.
func typecheckPackages(ldr @loader.Loader) @types.Checker {
	var c @types.Checker = types.NewChecker()
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(types.FormatCheckError(errs[i]))
		}
		bootstrap.Exit(1)
	}
	debug.Log("type checking passed")
	return c
}

// readFile reads an entire file into a byte slice.
func readFile(path *[]readonly char) @[]uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 {
		var empty @[]uint8
		return empty
	}

	var cap int = 4096
	var data @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var readBuf @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int = bootstrap.Read(fd, readBuf)
		if n <= 0 {
			break
		}
		// Grow if needed
		for total + n > cap {
			var newCap int = cap * 2
			var newData @[]uint8 = make_slice(uint8, newCap)
			for j := 0; j < total; j++ {
				newData[j] = data[j]
			}
			data = newData
			cap = newCap
		}
		for i := 0; i < n; i++ {
			data[total + i] = readBuf[i]
		}
		total = total + n
	}
	bootstrap.Close(fd)
	return data[0:total]
}

// streq compares two char slices.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// splitColon splits a string on ':' (POSIX PATH style). Empty
// entries are dropped, so "A::B" yields ["A", "B"]; trailing/leading
// colons are benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]readonly char) @[]@[]char {
	var out @[]@[]char
	if len(s) == 0 { return out }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out = appendCharSlice(out, part)
			}
			start = i + 1
		}
	}
	return out
}

// applyPathFlags appends -I / --interface-path entries to the loader's
// BniPath and -L / --impl-path entries to its ImplPath.  CLI-supplied
// paths come AFTER the primary-root-derived defaults — per-flag
// entries extend rather than replace them.
func applyPathFlags(ldr @loader.Loader, cli CLIArgs) {
	addLoaderPaths(ldr, cli.BniPaths, cli.ImplPaths)
}

// addLoaderPaths registers the -I (bni) and --interface-path (impl)
// search lists on the loader.  Takes the path lists directly (rather
// than CLIArgs) so it composes from either the CLI flags
// (applyPathFlags) or any other caller without coupling to the arg
// struct.
func addLoaderPaths(ldr @loader.Loader, bniPaths @[]@[]char,
		implPaths @[]@[]char) {
	for i := 0; i < len(bniPaths); i++ {
		ldr.AddBniPath(bniPaths[i])
	}
	for i := 0; i < len(implPaths); i++ {
		ldr.AddImplPath(implPaths[i])
	}
}

// dirOf returns the directory part of a path.
func dirOf(path *[]readonly char) *[]readonly char {
	var last int = -1
	for i := 0; i < len(path); i++ {
		if path[i] == '/' {
			last = i
		}
	}
	if last < 0 {
		return ""
	}
	return path[0:last]
}

// Append helpers for managed slices
func appendCharSlice(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendFilePtr appends an AST file pointer to a managed slice.
func appendFilePtr(s @[]@ast.File, v @ast.File) @[]@ast.File {
	var n int = len(s)
	var ns @[]@ast.File = make_slice(@ast.File, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImportSpec appends an import spec to a managed slice.
func appendImportSpec(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// hasPrefix returns true if s starts with prefix.
func hasPrefix(s *[]readonly char, prefix *[]readonly char) bool {
	if len(s) < len(prefix) { return false }
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return false }
	}
	return true
}

// containsStr returns true if s contains sub as a substring. Empty
// sub matches anything.  O(len(s) * len(sub)); fine for short
// strings (test-name filtering).
func containsStr(s *[]readonly char, sub *[]readonly char) bool {
	if len(sub) == 0 { return true }
	if len(sub) > len(s) { return false }
	var stop int = len(s) - len(sub)
	for i := 0; i <= stop; i++ {
		var match bool = true
		for j := 0; j < len(sub); j++ {
			if s[i + j] != sub[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}

// quotePath wraps a path string in double quotes.
func quotePath(s *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('"')
	b.Write(s)
	b.WriteByte('"')
	// quotePath's result feeds ast.ImportSpec.Path (@[]char, an in-cone
	// type), so hand off an owned mutable copy.
	return buf.CopyStr(b.String())
}

// ensureBootstrapLoaded loads pkg/bootstrap into the loader if not
// already present. The IR-gen for the print/println builtin emits
// direct calls to certain pkg/bootstrap functions (format helpers +
// Write) regardless of whether user code imports pkg/bootstrap, so
// it must always be loaded — both for the compiler and the VM.
func ensureBootstrapLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/bootstrap") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/bootstrap\""
	syntheticImports = appendImportSpec(syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}

// ensureLangLoaded loads pkg/builtins/lang into the loader if not already
// present, so calling a method on a universe primitive (myInt.String())
// resolves without the caller importing lang — the VM analogue of the
// cmd/bnc force-load.  See cmd/bnc/util.bn:ensureLangLoaded and
// plan-primitives-impl-interfaces.md.
func ensureLangLoaded(ldr @loader.Loader) {
	if ldr.GetPackage("pkg/builtins/lang") != nil { return }
	var syntheticImports @[]@ast.ImportSpec
	var imp @ast.ImportSpec = make(ast.ImportSpec)
	imp.Path = "\"pkg/builtins/lang\""
	syntheticImports = appendImportSpec(syntheticImports, imp)
	ldr.LoadImports(syntheticImports)
}
