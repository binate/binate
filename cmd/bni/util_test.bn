package "main"

import "pkg/builtins/testing"

// ============================================================
// streq tests
// ============================================================

func TestStreqEqual() testing.TestResult {
	if !streq("hello", "hello") { return fail("same strings") }
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") { return fail("different strings") }
	return ""
}

func TestStreqDifferentLength() testing.TestResult {
	if streq("abc", "ab") { return fail("different lengths") }
	return ""
}

func TestStreqEmpty() testing.TestResult {
	if !streq("", "") { return fail("empty strings") }
	return ""
}

// ============================================================
// containsStr tests
// ============================================================

func TestContainsStrFound() testing.TestResult {
	if !containsStr("TestExecRefInc", "RefInc") {
		return fail("expected substring match")
	}
	return ""
}

func TestContainsStrAtStart() testing.TestResult {
	if !containsStr("TestFoo", "Test") {
		return fail("prefix should match")
	}
	return ""
}

func TestContainsStrAtEnd() testing.TestResult {
	if !containsStr("TestFoo", "Foo") {
		return fail("suffix should match")
	}
	return ""
}

func TestContainsStrMissing() testing.TestResult {
	if containsStr("TestFoo", "Bar") {
		return fail("missing substring should not match")
	}
	return ""
}

func TestContainsStrEmptySub() testing.TestResult {
	if !containsStr("hello", "") {
		return fail("empty sub should match anything")
	}
	return ""
}

func TestContainsStrSubLongerThanS() testing.TestResult {
	if containsStr("ab", "abc") {
		return fail("longer sub cannot fit")
	}
	return ""
}

// ============================================================
// dirOf tests
// ============================================================

func TestDirOfSimple() testing.TestResult {
	var d *[]readonly char = dirOf("/foo/bar/baz.bn")
	if !seq(d, "/foo/bar") { return fail("expected /foo/bar") }
	return ""
}

func TestDirOfNoSlash() testing.TestResult {
	var d *[]readonly char = dirOf("baz.bn")
	if !seq(d, "") { return fail("expected empty for no slash") }
	return ""
}

func TestDirOfTrailingSlash() testing.TestResult {
	var d *[]readonly char = dirOf("/foo/bar/")
	if !seq(d, "/foo/bar") { return fail("expected /foo/bar") }
	return ""
}

// ============================================================
// resolveRoot tests
// ============================================================

func TestResolveRootWithOverride() testing.TestResult {
	var r *[]readonly char = resolveRoot("/my/root", "src/main.bn")
	if !seq(r, "/my/root") { return fail("should use override") }
	return ""
}

func TestResolveRootFromFile() testing.TestResult {
	var r *[]readonly char = resolveRoot("", "/proj/src/main.bn")
	if !seq(r, "/proj/src") { return fail("should derive from file path") }
	return ""
}

func TestResolveRootBareFile() testing.TestResult {
	var r *[]readonly char = resolveRoot("", "main.bn")
	if !seq(r, ".") { return fail("should default to .") }
	return ""
}

// ============================================================
// splitColon tests
// ============================================================

func TestSplitColonEmpty() testing.TestResult {
	var r @[]@[]char = splitColon("")
	if len(r) != 0 { return fail("empty input should give empty result") }
	return ""
}

func TestSplitColonSingle() testing.TestResult {
	var r @[]@[]char = splitColon("/foo")
	if len(r) != 1 { return fail("expected 1 entry") }
	if !seq(r[0], "/foo") { return fail("entry wrong") }
	return ""
}

func TestSplitColonMultiple() testing.TestResult {
	var r @[]@[]char = splitColon("/a:/b:/c")
	if len(r) != 3 { return fail("expected 3 entries") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	if !seq(r[1], "/b") { return fail("[1] wrong") }
	if !seq(r[2], "/c") { return fail("[2] wrong") }
	return ""
}

func TestSplitColonEmptyEntries() testing.TestResult {
	var r @[]@[]char = splitColon("/a::/b")
	if len(r) != 2 { return fail("empty entry should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	if !seq(r[1], "/b") { return fail("[1] wrong") }
	return ""
}

func TestSplitColonTrailing() testing.TestResult {
	var r @[]@[]char = splitColon("/a:")
	if len(r) != 1 { return fail("trailing colon should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	return ""
}

func TestSplitColonLeading() testing.TestResult {
	var r @[]@[]char = splitColon(":/a")
	if len(r) != 1 { return fail("leading colon should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	return ""
}

// ============================================================
// envPathList tests (env-var package-path precedence: the pure core
// of the -I/-L env fallback; envPaths wraps it around os/sys.Getenv)
// ============================================================

// The long/primary form, when set, is used and colon-split.
func TestEnvPathListPrimarySet() testing.TestResult {
	var r @[]@[]char = envPathList("/a:/b", true, "/x", true)
	if len(r) != 2 { return fail("primary should win: expected 2 entries") }
	if !seq(r[0], "/a") { return fail("primary [0] wrong") }
	if !seq(r[1], "/b") { return fail("primary [1] wrong") }
	return ""
}

// With the primary unset, the short alias supplies the path.
func TestEnvPathListAliasFallback() testing.TestResult {
	var r @[]@[]char = envPathList("", false, "/x:/y", true)
	if len(r) != 2 { return fail("alias fallback: expected 2 entries") }
	if !seq(r[0], "/x") { return fail("alias [0] wrong") }
	if !seq(r[1], "/y") { return fail("alias [1] wrong") }
	return ""
}

// Neither set → no env entries (the CLI-only case).
func TestEnvPathListNeitherSet() testing.TestResult {
	var r @[]@[]char = envPathList("", false, "", false)
	if len(r) != 0 { return fail("neither set should yield no entries") }
	return ""
}

// A present-but-empty primary WINS: it means "no env paths", and the
// alias is not consulted (long form wins even when empty).
func TestEnvPathListPrimaryEmptyWins() testing.TestResult {
	var r @[]@[]char = envPathList("", true, "/x", true)
	if len(r) != 0 { return fail("empty-but-set primary should suppress the alias") }
	return ""
}

// The chosen value is colon-split with empty entries dropped (splitColon
// semantics), so "A::B:" yields two entries.
func TestEnvPathListDropsEmptyEntries() testing.TestResult {
	var r @[]@[]char = envPathList("/a::/b:", true, "", false)
	if len(r) != 2 { return fail("empty colon entries should be dropped") }
	if !seq(r[0], "/a") { return fail("[0] wrong") }
	if !seq(r[1], "/b") { return fail("[1] wrong") }
	return ""
}

// ============================================================
// skipMatchesAny tests
// ============================================================

func TestSkipMatchesAny() testing.TestResult {
	// Bare patterns match in ANY package (pkgPath ignored for these).
	if !skipMatchesAny("pkg/a", "TestRunFuncTypedAddScalar", "RunFuncTyped,WrapPackage") {
		return fail("should match the first bare pattern")
	}
	if !skipMatchesAny("pkg/b", "TestWrapPackageRefcountBalance", "RunFuncTyped,WrapPackage") {
		return fail("should match the second bare pattern")
	}
	if skipMatchesAny("pkg/a", "TestNewStructure", "RunFuncTyped,WrapPackage") {
		return fail("should NOT match a name containing neither pattern")
	}
	// A single bare pattern (no comma) still works — back-compat with .skip files.
	if !skipMatchesAny("pkg/a", "TestEmitDebugOne", "TestEmitDebug") {
		return fail("single bare pattern should match")
	}
	// Empty spec / all-empty parts match NOTHING (must never skip everything).
	if skipMatchesAny("pkg/a", "TestFoo", "") {
		return fail("empty spec must match nothing")
	}
	if skipMatchesAny("pkg/a", "TestFoo", ",,") {
		return fail("all-empty parts must match nothing")
	}
	return ""
}

// Package-qualified `pkg:pattern` parts skip ONLY in the matching package, so a
// batched multi-package --test can carry per-package skips safely.
func TestSkipMatchesAnyQualified() testing.TestResult {
	var spec *[]readonly char = "pkg/binate/codegen:TestEmitDebug,pkg/binate/vm:TestWide"
	// Qualified match: right package + pattern.
	if !skipMatchesAny("pkg/binate/codegen", "TestEmitDebugOne", spec) {
		return fail("qualified skip should match its own package")
	}
	if !skipMatchesAny("pkg/binate/vm", "TestWideReturn", spec) {
		return fail("qualified skip should match the second package")
	}
	// Same test name, WRONG package — must NOT skip (the cross-match this guards).
	if skipMatchesAny("pkg/binate/vm", "TestEmitDebugOne", spec) {
		return fail("qualified skip must NOT match a test in another package")
	}
	// A bare pattern mixed with qualified ones still matches in any package.
	if !skipMatchesAny("pkg/anything", "TestGlobalThing", "GlobalThing,pkg/x:Foo") {
		return fail("a bare pattern alongside qualified ones matches in any package")
	}
	// Empty pattern after the colon matches nothing.
	if skipMatchesAny("pkg/x", "TestFoo", "pkg/x:") {
		return fail("empty qualified pattern must match nothing")
	}
	return ""
}
