package "main"

import "pkg/builtin/testing"

// ============================================================
// shortName tests
// ============================================================

func TestShortNameSimple() testing.TestResult {
	var s @[]char = shortName("pkg/asm")
	if !seq(s, "asm") { return fail("expected asm") }
	return ""
}

func TestShortNameNoSlash() testing.TestResult {
	var s @[]char = shortName("main")
	if !seq(s, "main") { return fail("expected main") }
	return ""
}

func TestShortNameDeepPath() testing.TestResult {
	var s @[]char = shortName("pkg/asm/aarch64")
	if !seq(s, "aarch64") { return fail("expected aarch64") }
	return ""
}

func TestShortNameTrailingSlash() testing.TestResult {
	var s @[]char = shortName("pkg/foo/")
	if !seq(s, "") { return fail("expected empty for trailing slash") }
	return ""
}

// ============================================================
// unquote tests
// ============================================================

func TestUnquoteQuoted() testing.TestResult {
	var s @[]char = unquote("\"pkg/asm\"")
	if !seq(s, "pkg/asm") { return fail("expected pkg/asm") }
	return ""
}

func TestUnquoteUnquoted() testing.TestResult {
	var s @[]char = unquote("pkg/asm")
	if !seq(s, "pkg/asm") { return fail("unquoted should pass through") }
	return ""
}

func TestUnquoteEmpty() testing.TestResult {
	var s @[]char = unquote("")
	if !seq(s, "") { return fail("empty should stay empty") }
	return ""
}

func TestUnquoteOnlyQuotes() testing.TestResult {
	var s @[]char = unquote("\"\"")
	if !seq(s, "") { return fail("\"\" should unquote to empty") }
	return ""
}

func TestUnquoteSingleQuote() testing.TestResult {
	// A single quote is not a valid quoted form; pass-through.
	var s @[]char = unquote("\"")
	if !seq(s, "\"") { return fail("single quote should pass through") }
	return ""
}
