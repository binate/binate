package "main"

import "pkg/bootstrap"
import "pkg/ast"
import "pkg/parser"
import "pkg/types"
import "pkg/ir"
import "pkg/vm"
import "pkg/buf"
import "pkg/loader"

// main is the entry point for the bytecode interpreter CLI.
func main() {
	var rawArgs @[]@[]char = bootstrap.Args()
	if len(rawArgs) == 0 {
		println("usage: bni2 [--root dir] <file.bn>")
		bootstrap.Exit(1)
	}

	var rootOverride @[]char
	var binateRoot @[]char
	var filename @[]char
	var argIdx int = 0
	for argIdx < len(rawArgs) {
		if streq2(rawArgs[argIdx], "--root") &&
			argIdx + 1 < len(rawArgs) {
			rootOverride = rawArgs[argIdx + 1]
			argIdx = argIdx + 2
		} else if streq2(rawArgs[argIdx], "--binate-root") &&
			argIdx + 1 < len(rawArgs) {
			binateRoot = rawArgs[argIdx + 1]
			argIdx = argIdx + 2
		} else {
			filename = buf.CopyStr(rawArgs[argIdx])
			argIdx = argIdx + 1
		}
	}
	if len(filename) == 0 {
		println("usage: bni2 [--root dir] <file.bn>")
		bootstrap.Exit(1)
	}

	// Read source file
	var src @[]uint8 = readFile(filename)
	if len(src) == 0 {
		print("error: cannot read ")
		println(filename)
		bootstrap.Exit(1)
	}

	// Parse
	var p @parser.Parser = parser.New(src, filename)
	var file @ast.File = parser.ParseFile(p)
	var errs @[]parser.ParseError = parser.Errors(p)
	if len(errs) > 0 {
		for i := 0; i < len(errs); i++ {
			println(errs[i].Msg)
		}
		bootstrap.Exit(1)
	}

	// Resolve root directory for package loading
	var root @[]char
	if len(rootOverride) > 0 {
		root = rootOverride
	} else {
		root = resolveRoot(filename)
	}
	// Default binate root to root (for finding builtin .bni files)
	if len(binateRoot) == 0 {
		binateRoot = root
	}

	// Load imported packages
	var ldr @loader.Loader = loader.NewLoader(root)
	if len(binateRoot) > 0 && !streq2(binateRoot, root) {
		loader.AddRoot(ldr, binateRoot)
	}
	loader.RegisterBuiltin(ldr, "pkg/bootstrap")
	loader.LoadImports(ldr, file.Imports)
	if len(ldr.Errors) > 0 {
		for i := 0; i < len(ldr.Errors); i++ {
			println(ldr.Errors[i])
		}
		bootstrap.Exit(1)
	}

	// Type check all packages
	typecheckAll(ldr, root, binateRoot, file)

	// Create VM
	var vmInst @vm.VM = vm.NewVM(8 * 1024 * 1024)

	// Lower dependency packages in order
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = loader.GetPackage(
			ldr, ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.Merged == nil { continue }
		var mod @ir.Module = ir.InitModule(
			quotePath(ldr.Order[i]))
		registerPkgImports(ldr, pkg, mod, root)
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(pkg.BNI)
		}
		ir.GeneratePackage(pkg.Merged, mod)
		vm.LowerModule(vmInst, mod)
	}

	// Lower main package
	var mainMod @ir.Module = ir.InitModule(file.PkgName)
	registerMainImports(ldr, file, mainMod, root)
	ir.GeneratePackage(file, mainMod)
	vm.LowerModule(vmInst, mainMod)

	// Run
	var mainIdx int = vm.LookupFunc(vmInst, "main")
	if mainIdx < 0 {
		println("error: no main function")
		bootstrap.Exit(1)
	}
	var noArgs @[]int
	vm.CallFunc(vmInst, "main", noArgs)
}

// resolveRoot finds the project root by looking for a directory
// that contains pkg/. Walks up from the source file's directory.
func resolveRoot(filename []char) @[]char {
	// Find directory of the source file
	var dir @[]char = dirOf(filename)
	// Walk up looking for pkg/ directory
	for {
		if dirExists(concatPath(dir, "pkg")) {
			return dir
		}
		var parent @[]char = dirOf(dir)
		if len(parent) == 0 || streq2(parent, dir) {
			// At filesystem root — use the file's dir
			return dirOf(filename)
		}
		dir = parent
	}
	return dirOf(filename)
}

// dirOf returns the directory part of a path.
func dirOf(path []char) @[]char {
	var last int = -1
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { last = i }
	}
	if last <= 0 { return "." }
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, path[:last])
	return buf.Bytes(cb)
}

// dirExists checks if a directory exists by trying to open it.
func dirExists(path []char) bool {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return false }
	bootstrap.Close(fd)
	return true
}

// concatPath joins two path components with '/'.
func concatPath(a []char, b []char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, a)
	cb = buf.WriteByte(cb, '/')
	cb = buf.WriteStr(cb, b)
	return buf.Bytes(cb)
}

// typecheckAll type-checks all loaded packages and the main file.
func typecheckAll(ldr @loader.Loader, root []char,
	binateRoot []char, mainFile @ast.File) {
	var c @types.Checker = types.NewChecker()
	// Load builtin package interfaces (.bni files)
	loadBuiltinBNIs(c, ldr, root, binateRoot)
	// Check dependency packages
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = loader.GetPackage(
			ldr, ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			types.LoadPackageInterface(c,
				ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			types.CheckPackage(c,
				ldr.Order[i], pkg.Merged)
		}
	}
	// Check main
	types.Check(c, mainFile)
	var checkErrs @[]types.CheckError = types.CheckerErrors(c)
	if len(checkErrs) > 0 {
		for i := 0; i < len(checkErrs); i++ {
			println(checkErrs[i].Msg)
		}
		bootstrap.Exit(1)
	}
}

// loadBuiltinBNIs loads .bni files for builtin packages.
func loadBuiltinBNIs(c @types.Checker,
	ldr @loader.Loader, root []char,
	binateRoot []char) {
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = loader.GetPackage(
			ldr, ldr.Order[i])
		if pkg == nil || !pkg.Builtin { continue }
		// Try root first, then binateRoot
		// Path: root/pkg/foo.bni (not root/pkg/foo/.bni)
		var bniName @[]char = bootstrap.Concat(
			ldr.Order[i], ".bni")
		var bniPath @[]char = concatPath(root, bniName)
		var bniSrc @[]uint8 = readFile(bniPath)
		if len(bniSrc) == 0 && len(binateRoot) > 0 {
			bniPath = concatPath(binateRoot, bniName)
			bniSrc = readFile(bniPath)
		}
		if len(bniSrc) > 0 {
			var p @parser.Parser = parser.NewInterface(
				bniSrc, bniPath)
			var f @ast.File = parser.ParseFile(p)
			var errs @[]parser.ParseError = parser.Errors(p)
			if len(errs) == 0 {
				types.LoadPackageInterface(c,
					ldr.Order[i], f)
			}
		}
	}
}

// registerPkgImports registers import information for IR gen.
func registerPkgImports(ldr @loader.Loader,
	pkg @loader.Package, mod @ir.Module,
	root []char) {
	registerAllStructTypes(ldr, root)
	var aliases @[]@[]char
	var files @[]@ast.File
	if len(pkg.Imports) > 0 {
		for j := 0; j < len(pkg.Imports); j++ {
			var depFile @ast.File = collectPkgFile(
				ldr, pkg.Imports[j], root)
			if depFile != nil {
				aliases = appendStr(aliases,
					shortName(pkg.Imports[j]))
				files = appendFile(files, depFile)
			}
		}
	}
	if !streq2(pkg.Path, "pkg/rt") {
		appendRtImport(ldr, root, &aliases, &files)
	}
	ir.RegisterImports(aliases, files, mod)
}

// registerMainImports registers imports for the main package.
func registerMainImports(ldr @loader.Loader,
	file @ast.File, mod @ir.Module, root []char) {
	registerAllStructTypes(ldr, root)
	var aliases @[]@[]char
	var files @[]@ast.File
	if len(file.Imports) > 0 {
		for i := 0; i < len(file.Imports); i++ {
			var imp @[]char = unquote(file.Imports[i].Path)
			var depFile @ast.File = collectPkgFile(
				ldr, imp, root)
			if depFile != nil {
				aliases = appendStr(aliases,
					shortName(imp))
				files = appendFile(files, depFile)
			}
		}
	}
	appendRtImport(ldr, root, &aliases, &files)
	ir.RegisterImports(aliases, files, mod)
}

// appendRtImport adds pkg/rt as an implicit import if not already
// present.
func appendRtImport(ldr @loader.Loader, root []char,
	aliases *@[]@[]char, files *@[]@ast.File) {
	for i := 0; i < len(*aliases); i++ {
		if streq2((*aliases)[i], "rt") { return }
	}
	var rtPkg @loader.Package = loader.GetPackage(
		ldr, "pkg/rt")
	if rtPkg == nil { return }
	var rtFile @ast.File
	if rtPkg.BNI != nil {
		rtFile = rtPkg.BNI
	} else if rtPkg.Merged != nil {
		rtFile = rtPkg.Merged
	}
	if rtFile == nil { return }
	*aliases = appendStr(*aliases, "rt")
	*files = appendFile(*files, rtFile)
}

// registerAllStructTypes registers struct types from all loaded
// packages so the IR gen can resolve cross-package struct types.
func registerAllStructTypes(ldr @loader.Loader,
	root []char) {
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = loader.GetPackage(
			ldr, ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			ir.RegisterSelfTypes(pkg.BNI)
		}
	}
}

// collectPkgFile returns the .bni file (or merged .bn) for a
// package path.
func collectPkgFile(ldr @loader.Loader,
	pkgPath []char, root []char) @ast.File {
	var pkg @loader.Package = loader.GetPackage(
		ldr, pkgPath)
	if pkg == nil { return nil }
	if pkg.BNI != nil { return pkg.BNI }
	return pkg.Merged
}

// shortName extracts the last component of a package path.
func shortName(path []char) @[]char {
	var last int = 0
	for i := 0; i < len(path); i++ {
		if path[i] == '/' { last = i + 1 }
	}
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, path[last:])
	return buf.Bytes(cb)
}

// quotePath wraps a package path in quotes.
func quotePath(path []char) @[]char {
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteByte(cb, '"')
	cb = buf.WriteStr(cb, path)
	cb = buf.WriteByte(cb, '"')
	return buf.Bytes(cb)
}

// unquote removes surrounding quotes from a string.
func unquote(s []char) @[]char {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		var cb buf.CharBuf = buf.New()
		cb = buf.WriteStr(cb, s[1:len(s)-1])
		return buf.Bytes(cb)
	}
	var cb buf.CharBuf = buf.New()
	cb = buf.WriteStr(cb, s)
	return buf.Bytes(cb)
}

func streq2(a []char, b []char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func appendStr(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

func appendFile(s @[]@ast.File, v @ast.File) @[]@ast.File {
	var n int = len(s)
	var ns @[]@ast.File = make_slice(@ast.File, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// readFile reads the entire file at path. Returns empty slice on error.
func readFile(path @[]char) @[]uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var data @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var readBuf @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int = bootstrap.Read(fd, readBuf)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newData @[]uint8 = make_slice(uint8, newCap)
			for j := 0; j < total; j++ {
				newData[j] = data[j]
			}
			data = newData
			cap = newCap
		}
		for i := 0; i < n; i++ {
			data[total + i] = readBuf[i]
		}
		total = total + n
	}
	bootstrap.Close(fd)
	return data[0:total]
}
