package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/interp"
import "pkg/binate/link"
import "pkg/binate/parser"
import "pkg/builtins/reflect"
import "pkg/std/os"

// The `-driver <driver.bn>` path (Step 7): interpret a custom linker driver at link time,
// calling the COMPILED pkg/binate/link library.  bnld embeds the bytecode VM (via
// pkg/binate/interp), injects link's compiled instance as an extern (so the driver's
// link.* calls run compiled), loads/typechecks/lowers the driver, and calls its typed
// entry `Drive(objs, out, target) @[]char` ("" = ok).  The dual-mode showcase:
// interpreted policy driving the compiled relocation/emit hot path.

// readDriverSource reads the driver .bn into an owned byte buffer for the parser.
func readDriverSource(path *[]readonly char) (@[]uint8, bool) {
	f, oerr := os.Open(path)
	if present(oerr) { return make_slice(uint8, 0), false }
	fi, serr := f.Stat()
	if present(serr) { _ = f.Close(); return make_slice(uint8, 0), false }
	var size int = cast(int, fi.Size())
	var data @[]uint8 = make_slice(uint8, size)
	var got int = 0
	for got < size {
		// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
		var dst *[]uint8 = data[got:]
		n, rerr := f.Read(dst)
		if present(rerr) || n <= 0 { _ = f.Close(); return make_slice(uint8, 0), false }
		got = got + n
	}
	_ = f.Close()
	return data, true
}

// stripQuotes removes a surrounding pair of double quotes from a package name
// (ast.File.PkgName is the quoted form, e.g. "\"driver\"").
func stripQuotes(s *[]readonly char) @[]char {
	var lo int = 0
	var hi int = len(s)
	if hi >= 2 && s[0] == '"' && s[hi - 1] == '"' {
		lo = 1
		hi = hi - 1
	}
	var out @[]char = make_slice(char, hi - lo)
	for i := lo; i < hi; i++ { out[i - lo] = s[i] }
	return out
}

// linkInjectSet returns the standard library plus the compiled pkg/binate/link package
// (its compiler-synthesized __Package() descriptor), so a driver's link.* calls resolve
// to the compiled instance.
func linkInjectSet() @[]@reflect.Package {
	var std @[]@reflect.Package = interp.StandardPackages()
	var pkgs @[]@reflect.Package = make_slice(@reflect.Package, len(std) + 1)
	for i := 0; i < len(std); i++ { pkgs[i] = std[i] }
	pkgs[len(std)] = link.__Package()
	return pkgs
}

// runDriver loads driverPath and calls its Drive(objs, out, target) entry under the VM,
// with pkg/binate/link injected compiled.  root resolves the driver's imports (its
// ifaces/impls).  Returns "" on success or a non-empty error message.
func runDriver(driverPath *[]readonly char, root @[]char, objs @[]@[]char, out @[]char,
		target @[]char) @[]char {
	data, ok := readDriverSource(driverPath)
	if !ok { return buf.Concat("cannot read driver: ", driverPath) }
	var p @parser.Parser = parser.New(data, driverPath)
	var file @ast.File = p.ParseFile()
	var perrs @[]parser.ParseError = p.Errors()
	if len(perrs) > 0 {
		return buf.Concat("driver parse error: ", perrs[0].Msg)
	}
	var driverPkg @[]char = stripQuotes(file.PkgName)

	var it @interp.Interp = interp.New(16 * 1024 * 1024, linkInjectSet())
	// Standard search paths under the repo root (mirrors scripts/binate-paths.sh
	// --iface/--impl).  SPIKE SHORTCUT: the formula is hard-coded here; the real path
	// should take the dirs as flags (from binate-paths.sh) rather than duplicate it.
	it.AddBniPath(root)
	it.AddBniPath(buf.Concat(root, "/ifaces/core"))
	it.AddBniPath(buf.Concat(root, "/ifaces/stdlib"))
	it.AddImplPath(root)
	it.AddImplPath(buf.Concat(root, "/impls/core/common"))
	it.AddImplPath(buf.Concat(root, "/impls/core/libc"))
	it.AddImplPath(buf.Concat(root, "/impls/stdlib"))
	var files @[]@ast.File = make_slice(@ast.File, 1)
	files[0] = file
	// Load the driver as a callable package (CheckPackage-registered scope) so
	// RunFuncTyped can resolve its Drive entry — a driver is a library, not a main program.
	var loadErrs @[]@[]char = it.LoadCallable(files, driverPkg)
	if len(loadErrs) > 0 { return buf.CopyStr(loadErrs[0]) }

	var args @[]interp.Value = make_slice(interp.Value, 3)
	args[0] = interp.StringSliceValue(objs)
	args[1] = interp.StringValue(out)
	args[2] = interp.StringValue(target)
	var results @[]interp.Value
	var runErrs @[]@[]char
	results, runErrs = it.RunFuncTyped(driverPkg, "Drive", args)
	args[0].Release()
	args[1].Release()
	args[2].Release()
	if len(runErrs) > 0 { return buf.CopyStr(runErrs[0]) }
	if len(results) != 1 {
		for i := 0; i < len(results); i++ { results[i].Release() }
		return buf.CopyStr("driver Drive must return exactly one value")
	}
	var e @[]char = buf.CopyStr(results[0].AsString())
	results[0].Release()
	return e
}
