package "main"

import "pkg/binate/interp"
import "pkg/builtins/testing"

// stripQuotes must unwrap a surrounding pair of double quotes (ast.File.PkgName is the
// quoted form) and leave everything else unchanged.
func TestStripQuotesUnwraps() testing.TestResult {
	if !strEq(stripQuotes("\"driver\""), "driver") {
		return fail("quoted name should strip to driver")
	}
	if !strEq(stripQuotes("driver"), "driver") { return fail("unquoted name should be unchanged") }
	if !strEq(stripQuotes("\"\""), "") { return fail("empty-quoted should strip to empty") }
	if !strEq(stripQuotes(""), "") { return fail("empty stays empty") }
	if !strEq(stripQuotes("\"a\""), "a") { return fail("single char should strip") }
	// Asymmetric / lone quotes are NOT stripped (need a matching pair).
	if !strEq(stripQuotes("\""), "\"") { return fail("a lone quote should be unchanged") }
	if !strEq(stripQuotes("\"x"), "\"x") { return fail("open-only quote should be unchanged") }
	if !strEq(stripQuotes("x\""), "x\"") { return fail("close-only quote should be unchanged") }
	return ""
}

// linkInjectSet is the standard library plus one more package — the compiled
// pkg/binate/link — so a driver's link.* calls resolve to the compiled instance.
func TestLinkInjectSetAddsLink() testing.TestResult {
	if len(linkInjectSet()) != len(interp.StandardPackages()) + 1 {
		return fail("inject set should be StandardPackages() + link")
	}
	return ""
}
