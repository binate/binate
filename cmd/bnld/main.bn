package "main"

import "pkg/binate/buf"
import "pkg/binate/link"
import "pkg/binate/version"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/stdx/flags"

// Binate linker.
// Usage: bnld -o output [-e entry] [-target linux-x64] [-dynamic] [-L dir] [-l name]
//   obj.o lib.a ...
//
// A thin CLI over pkg/binate/link.Link: read the relocatable objects, resolve
// cross-object symbols, lay them out, patch relocations, and write a static
// ELF64 executable.

// The default load base for the hosted targets (x86-64 and aarch64).
const defaultBase uint = 0x400000

// CLIArgs holds the parsed command line.  A non-empty Error means a usage error;
// ShowVersion means "-version" was given.  Machine is resolved from Target (-1 if
// the target is unsupported).
type CLIArgs struct {
	Output      @[]char
	Entry       @[]char
	Target      @[]char
	Machine     int
	Objects     @[]@[]char
	Dynamic     bool
	ShowVersion bool
	Error       @[]char
}

// parseArgs parses bnld's argument tokens into a CLIArgs.  The `-L<dir>` search
// paths and `-l<name>` library references (attached or space-separated) are pulled
// out first — the flags package handles neither repeatable attached-value form — and
// each `-l<name>` is resolved to `<dir>/lib<name>.a` in the first `-L` dir that has
// it.  The resolved archives join the positional inputs; link order does not matter
// (archive members are extracted to a fixpoint), so they are simply appended.
func parseArgs(args @[]@[]char) @CLIArgs {
	var c @CLIArgs = make(CLIArgs)
	rest, dirs, names := splitLibArgs(args)

	var output @[]char = ""
	var entry @[]char = ""
	var target @[]char = ""
	var dynamic bool = false
	var showVersion bool = false
	var fs @flags.FlagSet = flags.New("bnld")
	fs.StringVar(&output, "o", "", "", "output executable path (required)")
	fs.StringVar(&entry, "e", "", "_start", "entry symbol name")
	fs.StringVar(&target, "target", "", "linux-x64", "target: linux-x64 | linux-aarch64")
	fs.BoolVar(&dynamic, "dynamic", "",
			"link dynamically (aarch64 only): undefined externals import from libc at load")
	fs.BoolVar(&showVersion, "version", "", "print version and exit")
	paths, perr := fs.Parse(rest)

	c.ShowVersion = showVersion
	if showVersion { return c }
	if len(perr) > 0 {
		c.Error = buf.CopyStr(perr)
		return c
	}

	libPaths, lerr := resolveLibs(dirs, names)
	if len(lerr) > 0 {
		c.Error = lerr
		return c
	}

	c.Output = output
	c.Entry = entry
	c.Target = target
	c.Dynamic = dynamic
	c.Objects = appendPaths(paths, libPaths)
	c.Machine = machineForTarget(target)

	if len(output) == 0 {
		c.Error = buf.CopyStr("error: -o output is required")
	} else if len(c.Objects) == 0 {
		c.Error = buf.CopyStr("error: no input object files")
	} else if len(entry) == 0 {
		c.Error = buf.CopyStr("error: -e entry symbol must not be empty")
	} else if c.Machine < 0 {
		c.Error = buf.Concat("error: unsupported target: ", target)
	}
	return c
}

// splitLibArgs separates `-L<dir>` and `-l<name>` (attached like `-Ldir`/`-lc`, or
// space-separated like `-L dir`/`-l c`) from the remaining argument tokens, which
// are returned for the flag parser.  Returns (rest, libDirs, libNames).
func splitLibArgs(args @[]@[]char) (@[]@[]char, @[]@[]char, @[]@[]char) {
	var rest @[]@[]char = make_slice(@[]char, len(args))
	var nRest int = 0
	var dirs @[]@[]char = make_slice(@[]char, len(args))
	var nDirs int = 0
	var names @[]@[]char = make_slice(@[]char, len(args))
	var nNames int = 0
	var i int = 0
	for i < len(args) {
		var arg @[]char = args[i]
		if isDashFlag(arg, 'L') {
			var v @[]char
			v, i = flagValue(args, i)
			dirs[nDirs] = v
			nDirs = nDirs + 1
		} else if isDashFlag(arg, 'l') {
			var v @[]char
			v, i = flagValue(args, i)
			names[nNames] = v
			nNames = nNames + 1
		} else {
			rest[nRest] = arg
			nRest = nRest + 1
			i = i + 1
		}
	}
	return rest[0:nRest], dirs[0:nDirs], names[0:nNames]
}

// isDashFlag reports whether arg is `-<c>` or `-<c>...` (a dash, the flag letter c,
// then an optional attached value).
func isDashFlag(arg *[]readonly char, c char) bool {
	return len(arg) >= 2 && arg[0] == '-' && arg[1] == c
}

// flagValue returns the value of the flag token at args[i] and the index of the
// next unconsumed token: the attached value (`-Ldir` -> "dir", advance 1) or the
// following token (`-L dir` -> args[i+1], advance 2).  A trailing bare flag with no
// following token yields "" (later reported as a missing library/dir).
func flagValue(args @[]@[]char, i int) (@[]char, int) {
	var arg @[]char = args[i]
	if len(arg) > 2 {
		var v @[]char = make_slice(char, len(arg) - 2)
		for k := 2; k < len(arg); k++ { v[k - 2] = arg[k] }
		return v, i + 1
	}
	if i + 1 < len(args) { return args[i + 1], i + 2 }
	return buf.CopyStr(""), i + 1
}

// resolveLibs resolves each `-l<name>` to `<dir>/lib<name>.a` in the first search
// dir that has it, returning the resolved archive paths.  A name that resolves
// nowhere (or an empty name) is an error.
func resolveLibs(dirs @[]@[]char, names @[]@[]char) (@[]@[]char, @[]char) {
	var out @[]@[]char = make_slice(@[]char, len(names))
	for n := 0; n < len(names); n++ {
		if len(names[n]) == 0 { return out, buf.CopyStr("error: -l requires a library name") }
		var found bool = false
		for d := 0; d < len(dirs); d++ {
			var cand @[]char = libCandidate(dirs[d], names[n])
			_, serr := os.Stat(cand)
			if !present(serr) {
				out[n] = cand
				found = true
				break
			}
		}
		if !found { return out, buf.Concat("error: cannot find -l", names[n]) }
	}
	return out, ""
}

// libCandidate builds the path `<dir>/lib<name>.a`.
func libCandidate(dir *[]readonly char, name *[]readonly char) @[]char {
	return buf.Concat(buf.Concat(buf.Concat(buf.Concat(dir, "/lib"), name), ".a"), "")
}

// appendPaths returns a fresh slice of a's elements followed by b's.
func appendPaths(a @[]@[]char, b @[]@[]char) @[]@[]char {
	var out @[]@[]char = make_slice(@[]char, len(a) + len(b))
	for i := 0; i < len(a); i++ { out[i] = a[i] }
	for i := 0; i < len(b); i++ { out[len(a) + i] = b[i] }
	return out
}

// machineForTarget maps a target name to an ELF e_machine, or -1 if unsupported.
func machineForTarget(target *[]readonly char) int {
	if strEq(target, "linux-x64") { return link.EM_X86_64 }
	if strEq(target, "linux-aarch64") { return link.EM_AARCH64 }
	return -1
}

// main is the entry point for the linker CLI.
func main() {
	var c @CLIArgs = parseArgs(progArgs())
	if c.ShowVersion {
		fmt.Print("bnld-", version.Version, "\n")
		return
	}
	if len(c.Error) > 0 {
		printErr(c.Error, "\n")
		usage()
		os.Exit(1)
	}
	var err @[]readonly char
	if c.Dynamic {
		err = link.LinkDynElf(c.Objects, c.Entry, c.Machine, defaultBase, c.Output)
	} else {
		err = link.Link(c.Objects, c.Entry, c.Machine, defaultBase, c.Output)
	}
	if len(err) != 0 {
		printErr("error: ", err, "\n")
		os.Exit(1)
	}
}

// usage prints the linker usage message to stderr.
func usage() {
	printErr("usage: bnld -o out [-e entry] [-target linux-x64|linux-aarch64]",
			" [-dynamic] [-L dir] [-l name] input.o lib.a ...\n")
}

// strEq reports whether two raw char slices have identical contents.
func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}

// progArgs returns bnld's own argument tokens: os.Args() minus the program-name
// slot at index 0, copied into a mutable @[]@[]char for parsing.  Reading argv
// through os.Args means that under the bytecode interpreter bnld sees the argv the
// interpreter installed via os.SetArgs, not the interpreter's own.
func progArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 { return make_slice(@[]char, 0) }
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ { s[j] = full[i][j] }
		out[i - 1] = s
	}
	return out
}

// printErr writes a diagnostic to stderr via fmt.  The variadic *any takes a raw
// (*[]readonly char) or managed (@[]char) char-slice through the one formatter.
func printErr(args ...*any) {
	_, _ = fmt.Fprint(os.Stderr, args...)
}
