package "main"

import "pkg/binate/buf"
import "pkg/binate/link"
import "pkg/binate/version"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/stdx/flags"

// Binate linker.
// Usage: bnld -o output [-e entry] [-target linux-x64] obj1.o obj2.o ...
//
// A thin CLI over pkg/binate/link.Link: read the relocatable objects, resolve
// cross-object symbols, lay them out, patch relocations, and write a static
// ELF64 executable.

// The default load base for the hosted x86-64 target.
const defaultBase uint = 0x400000

// CLIArgs holds the parsed command line.  A non-empty Error means a usage error;
// ShowVersion means "-version" was given.  Machine is resolved from Target (-1 if
// the target is unsupported).
type CLIArgs struct {
	Output      @[]char
	Entry       @[]char
	Target      @[]char
	Machine     int
	Objects     @[]@[]char
	ShowVersion bool
	Error       @[]char
}

// parseArgs parses bnld's argument tokens into a CLIArgs.
func parseArgs(args @[]@[]char) @CLIArgs {
	var c @CLIArgs = make(CLIArgs)
	var output @[]char = ""
	var entry @[]char = ""
	var target @[]char = ""
	var showVersion bool = false
	var fs @flags.FlagSet = flags.New("bnld")
	fs.StringVar(&output, "o", "", "", "output executable path (required)")
	fs.StringVar(&entry, "e", "", "_start", "entry symbol name")
	fs.StringVar(&target, "target", "", "linux-x64", "target: linux-x64")
	fs.BoolVar(&showVersion, "version", "", "print version and exit")
	paths, perr := fs.Parse(args)

	c.ShowVersion = showVersion
	if showVersion { return c }
	if len(perr) > 0 {
		c.Error = buf.CopyStr(perr)
		return c
	}

	c.Output = output
	c.Entry = entry
	c.Target = target
	c.Objects = paths
	c.Machine = machineForTarget(target)

	if len(output) == 0 {
		c.Error = buf.CopyStr("error: -o output is required")
	} else if len(paths) == 0 {
		c.Error = buf.CopyStr("error: no input object files")
	} else if len(entry) == 0 {
		c.Error = buf.CopyStr("error: -e entry symbol must not be empty")
	} else if c.Machine < 0 {
		c.Error = buf.Concat("error: unsupported target: ", target)
	}
	return c
}

// machineForTarget maps a target name to an ELF e_machine, or -1 if unsupported.
func machineForTarget(target *[]readonly char) int {
	if strEq(target, "linux-x64") { return link.EM_X86_64 }
	return -1
}

// main is the entry point for the linker CLI.
func main() {
	var c @CLIArgs = parseArgs(progArgs())
	if c.ShowVersion {
		fmt.Print("bnld-", version.Version, "\n")
		return
	}
	if len(c.Error) > 0 {
		printErr(c.Error, "\n")
		usage()
		os.Exit(1)
	}
	var err @[]readonly char = link.Link(c.Objects, c.Entry, c.Machine, defaultBase, c.Output)
	if len(err) != 0 {
		printErr("error: ", err, "\n")
		os.Exit(1)
	}
}

// usage prints the linker usage message to stderr.
func usage() {
	printErr("usage: bnld -o output [-e entry] [-target linux-x64] obj.o ...\n")
}

// strEq reports whether two raw char slices have identical contents.
func strEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}

// progArgs returns bnld's own argument tokens: os.Args() minus the program-name
// slot at index 0, copied into a mutable @[]@[]char for parsing.  Reading argv
// through os.Args means that under the bytecode interpreter bnld sees the argv the
// interpreter installed via os.SetArgs, not the interpreter's own.
func progArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 { return make_slice(@[]char, 0) }
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ { s[j] = full[i][j] }
		out[i - 1] = s
	}
	return out
}

// printErr writes a diagnostic to stderr via fmt.  The variadic *any takes a raw
// (*[]readonly char) or managed (@[]char) char-slice through the one formatter.
func printErr(args ...*any) {
	_, _ = fmt.Fprint(os.Stderr, args...)
}
