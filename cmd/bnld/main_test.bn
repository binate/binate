package "main"

import "pkg/binate/buf"
import "pkg/binate/link"
import "pkg/builtins/testing"
import "pkg/std/os"

func fail(msg @[]char) testing.TestResult { return msg }

// arg2 / arg4 / arg5 build small argument-token slices from string literals.
func arg1(a *[]readonly char) @[]@[]char {
	var out @[]@[]char = make_slice(@[]char, 1)
	out[0] = buf.CopyStr(a)
	return out
}

func argN(a *[]readonly char, b *[]readonly char, c *[]readonly char, d *[]readonly char,
		e *[]readonly char, n int) @[]@[]char {
	var out @[]@[]char = make_slice(@[]char, n)
	if n > 0 { out[0] = buf.CopyStr(a) }
	if n > 1 { out[1] = buf.CopyStr(b) }
	if n > 2 { out[2] = buf.CopyStr(c) }
	if n > 3 { out[3] = buf.CopyStr(d) }
	if n > 4 { out[4] = buf.CopyStr(e) }
	return out
}

// A full valid command line parses to the right fields and defaults.
func TestParseArgsValid() testing.TestResult {
	var args @[]@[]char = argN("-o", "out", "a.o", "b.o", "", 4)
	var p @CLIArgs = parseArgs(args)
	if len(p.Error) != 0 { return fail("valid args should parse without error") }
	if !strEq(p.Output, "out") { return fail("output should be 'out'") }
	if !strEq(p.Entry, "_start") { return fail("entry should default to _start") }
	if p.Machine != link.EM_X86_64 { return fail("target should default to x86-64") }
	if len(p.Objects) != 2 { return fail("expected two object files") }
	return ""
}

// -e overrides the entry symbol.
func TestParseArgsCustomEntry() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-e", "main", "-o", "out", "a.o", 5))
	if len(p.Error) != 0 { return fail("should parse") }
	if !strEq(p.Entry, "main") { return fail("entry should be 'main'") }
	return ""
}

// -dynamic requests dynamic linking; it defaults off.
func TestParseArgsDynamic() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-o", "out", "-dynamic", "a.o", "", 4))
	if len(p.Error) != 0 { return fail("dynamic args should parse") }
	if !p.Dynamic { return fail("-dynamic should set Dynamic") }
	var q @CLIArgs = parseArgs(argN("-o", "out", "a.o", "", "", 3))
	if q.Dynamic { return fail("Dynamic should default to false") }
	return ""
}

// Missing -o is a usage error.
func TestParseArgsMissingOutput() testing.TestResult {
	var p @CLIArgs = parseArgs(arg1("a.o"))
	if len(p.Error) == 0 { return fail("missing -o should be an error") }
	return ""
}

// No object files is a usage error.
func TestParseArgsNoObjects() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-o", "out", "", "", "", 2))
	if len(p.Error) == 0 { return fail("no object files should be an error") }
	return ""
}

// An unsupported target is a usage error.
func TestParseArgsUnsupportedTarget() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-o", "out", "-target", "moon", "a.o", 5))
	if len(p.Error) == 0 { return fail("unsupported target should be an error") }
	return ""
}

// -version sets ShowVersion and short-circuits validation (no missing-`-o` error
// despite there being no output/objects).
func TestParseArgsVersion() testing.TestResult {
	var p @CLIArgs = parseArgs(arg1("-version"))
	if !p.ShowVersion { return fail("-version should set ShowVersion") }
	if len(p.Error) != 0 { return fail("-version should short-circuit validation") }
	return ""
}

// An unknown flag is a parse error (not silently a positional).
func TestParseArgsUnknownFlag() testing.TestResult {
	var p @CLIArgs = parseArgs(arg1("-bogus"))
	if len(p.Error) == 0 { return fail("an unknown flag should be an error") }
	if p.ShowVersion { return fail("an unknown flag is not -version") }
	return ""
}

// An explicitly-passed supported target resolves to its machine.
func TestParseArgsExplicitTarget() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-target", "linux-x64", "-o", "out", "a.o", 5))
	if len(p.Error) != 0 { return fail("explicit linux-x64 should parse") }
	if p.Machine != link.EM_X86_64 { return fail("linux-x64 should map to x86-64") }
	return ""
}

// The aarch64 target resolves to its machine.
func TestParseArgsAArch64Target() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-target", "linux-aarch64", "-o", "out", "a.o", 5))
	if len(p.Error) != 0 { return fail("linux-aarch64 should parse") }
	if p.Machine != link.EM_AARCH64 { return fail("linux-aarch64 should map to aarch64") }
	return ""
}

// An empty entry symbol is a usage error.
func TestParseArgsEmptyEntry() testing.TestResult {
	var p @CLIArgs = parseArgs(argN("-e", "", "-o", "out", "a.o", 5))
	if len(p.Error) == 0 { return fail("an empty -e entry should be an error") }
	return ""
}

// splitLibArgs separates attached -L/-l flags from the rest.
func TestSplitLibArgsAttached() testing.TestResult {
	var args @[]@[]char = argN("-Ldir", "-lfoo", "a.o", "", "", 3)
	rest, dirs, names := splitLibArgs(args)
	if len(dirs) != 1 || !strEq(dirs[0], "dir") { return fail("-Ldir should yield dir 'dir'") }
	if len(names) != 1 || !strEq(names[0], "foo") { return fail("-lfoo should yield name 'foo'") }
	if len(rest) != 1 || !strEq(rest[0], "a.o") { return fail("the object should remain in rest") }
	return ""
}

// splitLibArgs also handles the space-separated forms `-L dir` / `-l foo`.
func TestSplitLibArgsSeparate() testing.TestResult {
	var args @[]@[]char = argN("-L", "dir", "-l", "foo", "a.o", 5)
	rest, dirs, names := splitLibArgs(args)
	if len(dirs) != 1 || !strEq(dirs[0], "dir") { return fail("-L dir should yield dir 'dir'") }
	if len(names) != 1 || !strEq(names[0], "foo") { return fail("-l foo should yield name 'foo'") }
	if len(rest) != 1 || !strEq(rest[0], "a.o") { return fail("the object should remain in rest") }
	return ""
}

// parseArgs resolves `-l<name>` to `<dir>/lib<name>.a` in a `-L` dir and appends it
// to the inputs.
func TestParseArgsResolvesLib() testing.TestResult {
	// Create a dummy archive to resolve against: /tmp/libbnldtest.a
	f, cerr := os.Create("/tmp/libbnldtest.a")
	if present(cerr) { return fail("cannot create the test archive") }
	_ = f.Close()

	var args @[]@[]char = make_slice(@[]char, 7)
	args[0] = buf.CopyStr("-o")
	args[1] = buf.CopyStr("out")
	args[2] = buf.CopyStr("-L")
	args[3] = buf.CopyStr("/tmp")
	args[4] = buf.CopyStr("-l")
	args[5] = buf.CopyStr("bnldtest")
	args[6] = buf.CopyStr("x.o")
	var c @CLIArgs = parseArgs(args)
	if len(c.Error) != 0 { return fail("parseArgs should resolve the library") }
	if len(c.Objects) != 2 { return fail("inputs should be x.o + the resolved archive") }
	if !strEq(c.Objects[0], "x.o") { return fail("the object should come first") }
	if !strEq(c.Objects[1], "/tmp/libbnldtest.a") { return fail("the resolved archive path is wrong") }
	return ""
}

// An unresolvable `-l<name>` is a usage error, not a silent drop.
func TestParseArgsMissingLib() testing.TestResult {
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = buf.CopyStr("-o")
	args[1] = buf.CopyStr("out")
	args[2] = buf.CopyStr("-L")
	args[3] = buf.CopyStr("/tmp")
	args[4] = buf.CopyStr("-ldefinitelymissing12345")
	var c @CLIArgs = parseArgs(args)
	if len(c.Error) == 0 { return fail("an unresolvable -l should be an error") }
	return ""
}

// In a dynamic ELF link, `-l<name>` prefers a shared object over a static archive: the
// .so is recorded in SharedLibs (its SONAME becomes a DT_NEEDED at link time), not
// appended as an input.
func TestParseArgsDynamicPrefersSo() testing.TestResult {
	fa, ea := os.Create("/tmp/libbnldpref.a")
	if present(ea) { return fail("cannot create the test archive") }
	_ = fa.Close()
	fs, es := os.Create("/tmp/libbnldpref.so")
	if present(es) { return fail("cannot create the test .so") }
	_ = fs.Close()
	var args @[]@[]char = make_slice(@[]char, 7)
	args[0] = buf.CopyStr("-o")
	args[1] = buf.CopyStr("out")
	args[2] = buf.CopyStr("-dynamic")
	args[3] = buf.CopyStr("-L")
	args[4] = buf.CopyStr("/tmp")
	args[5] = buf.CopyStr("-lbnldpref")
	args[6] = buf.CopyStr("x.o")
	var c @CLIArgs = parseArgs(args)
	if len(c.Error) != 0 { return fail("parseArgs should resolve the shared library") }
	if len(c.SharedLibs) != 1 || !strEq(c.SharedLibs[0], "/tmp/libbnldpref.so") {
		return fail("the .so should be recorded as a shared library")
	}
	if len(c.Objects) != 1 || !strEq(c.Objects[0], "x.o") {
		return fail("only the object should be an input (the .so is not appended)")
	}
	return ""
}

// In a dynamic ELF link, `-l<name>` falls back to the static archive when no shared
// object is present: the .a links in as an input, not recorded as a shared library.
func TestParseArgsDynamicFallsBackToArchive() testing.TestResult {
	fa, ea := os.Create("/tmp/libbnldonlyar.a")
	if present(ea) { return fail("cannot create the test archive") }
	_ = fa.Close()
	_ = os.Remove("/tmp/libbnldonlyar.so") // ensure no .so shadows the archive
	var args @[]@[]char = make_slice(@[]char, 7)
	args[0] = buf.CopyStr("-o")
	args[1] = buf.CopyStr("out")
	args[2] = buf.CopyStr("-dynamic")
	args[3] = buf.CopyStr("-L")
	args[4] = buf.CopyStr("/tmp")
	args[5] = buf.CopyStr("-lbnldonlyar")
	args[6] = buf.CopyStr("x.o")
	var c @CLIArgs = parseArgs(args)
	if len(c.Error) != 0 { return fail("parseArgs should resolve the archive") }
	if len(c.SharedLibs) != 0 { return fail("no .so exists, so SharedLibs should be empty") }
	if len(c.Objects) != 2 || !strEq(c.Objects[1], "/tmp/libbnldonlyar.a") {
		return fail("the archive should be appended as an input")
	}
	return ""
}
