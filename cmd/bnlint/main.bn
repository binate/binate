package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/lint"
import "pkg/binate/loader"
import "pkg/binate/parser"
import "pkg/binate/types"
import "pkg/builtins/bootstrap"

// Binate linter.
// Usage: bnlint -I <dir> [-L <dir>] <pkg1> [pkg2 ...]

// main is the entry point for the linter CLI.
func main() {
	var rawArgs @[]@[]char = bootstrap.Args()
	// Copy to managed slice so parseArgs is testable
	var args @[]@[]char = make_slice(@[]char, len(rawArgs))
	for i := 0; i < len(rawArgs); i++ {
		args[i] = buf.CopyStr(rawArgs[i])
	}
	var cli CLIArgs = parseArgs(args)

	if len(cli.Error) > 0 {
		println(cli.Error)
		bootstrap.Exit(1)
	}

	var result LintResult = lintPackages(primaryRoot(cli), cli.Pkgs,
		cli.BniPaths, cli.ImplPaths)

	if len(result.Error) > 0 {
		println(result.Error)
		bootstrap.Exit(1)
	}

	for i := 0; i < result.NumDiags; i++ {
		println(result.Messages[i])
	}

	if result.NumDiags > 0 {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr(bootstrap.Itoa(result.NumDiags))
		cb = cb.WriteStr(" lint diagnostic(s) found")
		println(cb.Bytes())
		bootstrap.Exit(1)
	}
}

// ============================================================
// CLI Argument Parsing
// ============================================================

type CLIArgs struct {
	Pkgs      @[]@[]char
	BniPaths  @[]@[]char  // -I / --interface-path: dirs searched for `.bni`.
	ImplPaths @[]@[]char  // -L / --impl-path: dirs searched for impl dirs.
	Error     @[]char
}

// primaryRoot returns bnlint's notion of "the binate source root" —
// the first -I entry.  Used for path-prefix stripping in diagnostics
// and as the loader's root.  Empty if no -I was passed (which
// parseArgs rejects up front).
func primaryRoot(cli CLIArgs) @[]char {
	if len(cli.BniPaths) > 0 { return buf.CopyStr(cli.BniPaths[0]) }
	var empty @[]char
	return empty
}

// parseArgs parses linter command-line arguments into a CLIArgs struct.
func parseArgs(args @[]@[]char) CLIArgs {
	var cli CLIArgs
	if len(args) == 0 {
		cli.Error = "usage: bnlint -I <dir> [-L <dirs>] <pkg1> [pkg2 ...]"
		return cli
	}

	var i int = 0
	for i < len(args) {
		if streq(args[i], "-I") || streq(args[i], "--interface-path") {
			i = i + 1
			if i >= len(args) {
				cli.Error = "error: -I/--interface-path requires a value"
				return cli
			}
			var parts @[]@[]char = splitColon(args[i])
			for j := 0; j < len(parts); j++ {
				cli.BniPaths = appendStr(cli.BniPaths, parts[j])
			}
		} else if streq(args[i], "-L") || streq(args[i], "--impl-path") {
			i = i + 1
			if i >= len(args) {
				cli.Error = "error: -L/--impl-path requires a value"
				return cli
			}
			var parts @[]@[]char = splitColon(args[i])
			for j := 0; j < len(parts); j++ {
				cli.ImplPaths = appendStr(cli.ImplPaths, parts[j])
			}
		} else {
			cli.Pkgs = appendStr(cli.Pkgs, buf.CopyStr(args[i]))
		}
		i = i + 1
	}

	if len(cli.BniPaths) == 0 {
		cli.Error = "error: -I <dir> is required (first entry sets the source root)"
		return cli
	}
	if len(cli.Pkgs) == 0 {
		cli.Error = "error: at least one package path required"
		return cli
	}
	return cli
}

// splitColon splits a string on ':' (POSIX PATH style). Empty entries
// are dropped so "A::B" → ["A", "B"]; trailing/leading colons are
// benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]readonly char) @[]@[]char {
	var out @[]@[]char
	if len(s) == 0 { return out }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out = appendStr(out, part)
			}
			start = i + 1
		}
	}
	return out
}

// ============================================================
// Lint Pipeline
// ============================================================

type LintResult struct {
	Messages @[]@[]char
	NumDiags int
	Error    @[]char
}

// lintPackages loads, type-checks, and lints the given packages.
// `root` (typically primaryRoot(cli) — the first -I entry) seeds the
// loader and supplies the prefix for diagnostic file paths.  bniPaths
// and implPaths are the full -I/-L lists; the loader walks them in
// order after `root`.
func lintPackages(root @[]char, pkgs @[]@[]char,
		bniPaths @[]@[]char, implPaths @[]@[]char) LintResult {
	var result LintResult

	// Set up loader
	var ldr @loader.Loader = loader.NewLoader(root)
	for i := 0; i < len(bniPaths); i++ {
		ldr.AddBniPath(bniPaths[i])
	}
	for i := 0; i < len(implPaths); i++ {
		ldr.AddImplPath(implPaths[i])
	}

	// Create synthetic imports for the target packages
	var imports @[]@ast.ImportSpec
	for i := 0; i < len(pkgs); i++ {
		var imp @ast.ImportSpec = make(ast.ImportSpec)
		imp.Path = quotePath(pkgs[i])
		imports = appendImport(imports, imp)
	}
	ldr.LoadImports(imports)
	if len(ldr.Errors) > 0 {
		var cb buf.CharBuf = buf.New()
		for i := 0; i < len(ldr.Errors); i++ {
			if i > 0 { cb = cb.WriteByte('\n') }
			cb = cb.WriteStr(ldr.Errors[i])
		}
		result.Error = cb.Bytes()
		return result
	}

	// Type check all packages
	var c @types.Checker = types.NewChecker()
	loadBuiltinBNIs(c, ldr)
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || pkg.Builtin { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			c.CheckPackage(ldr.Order[i], pkg.Merged)
		}
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		var cb buf.CharBuf = buf.New()
		for i := 0; i < len(errs); i++ {
			if i > 0 { cb = cb.WriteByte('\n') }
			cb = cb.WriteStr(errs[i].Msg)
		}
		cb = cb.WriteByte('\n')
		cb = cb.WriteStr("type errors found, aborting lint")
		result.Error = cb.Bytes()
		return result
	}

	// Lint the requested packages
	result.Messages = make_slice(@[]char, 64)
	// Root prefix for stripping absolute paths (include trailing /)
	var rootPrefix @[]char = buf.Concat(root, "/")
	for i := 0; i < len(pkgs); i++ {
		var pkg @loader.Package = ldr.GetPackage(pkgs[i])
		if pkg == nil || pkg.Merged == nil { continue }
		var r @lint.Result = lint.LintFile(c, pkg.Merged)
		for j := 0; j < r.NumDiags; j++ {
			var msg @[]char = formatDiag(pkgs[i], r.Diags[j], rootPrefix)
			result.Messages = appendMsg(result.Messages, result.NumDiags, msg)
			result.NumDiags = result.NumDiags + 1
		}
	}

	return result
}

// ============================================================
// Diagnostic Formatting
// ============================================================

// formatDiag formats a diagnostic as "file:line:col: [rule] message".
// If rootPrefix is non-empty, strips it from the file path for shorter output.
func formatDiag(pkgPath @[]char, d lint.Diagnostic, rootPrefix @[]char) @[]char {
	var cb buf.CharBuf = buf.New()
	if len(d.Pos.File) > 0 {
		var file *[]readonly char = stripPrefix(d.Pos.File, rootPrefix)
		cb = cb.WriteStr(file)
	} else {
		cb = cb.WriteStr(pkgPath)
	}
	cb = cb.WriteByte(':')
	cb = cb.WriteStr(bootstrap.Itoa(d.Pos.Line))
	cb = cb.WriteByte(':')
	cb = cb.WriteStr(bootstrap.Itoa(d.Pos.Col))
	cb = cb.WriteStr(": [")
	cb = cb.WriteStr(d.Rule)
	cb = cb.WriteStr("] ")
	cb = cb.WriteStr(d.Message)
	return cb.Bytes()
}

// ============================================================
// Helpers
// ============================================================

// loadBuiltinBNIs loads .bni files for builtin packages into the type checker.
func loadBuiltinBNIs(c @types.Checker, ldr @loader.Loader) {
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil || !pkg.Builtin { continue }
		var bniPath @[]char = buf.Concat(
			buf.Concat(ldr.Root, "/"),
			buf.Concat(ldr.Order[i], ".bni"))
		var bniSrc @[]uint8 = readFile(bniPath)
		if len(bniSrc) > 0 {
			var p @parser.Parser = parser.NewInterface(bniSrc, bniPath)
			var bniFile @ast.File = p.ParseFile()
			c.LoadPackageInterface(ldr.Order[i], bniFile)
		}
	}
}

// readFile reads an entire file into a managed byte slice.
func readFile(path *[]readonly char) @[]uint8 {
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int = bootstrap.Read(fd, tmp)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	bootstrap.Close(fd)
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// quotePath wraps a path in double quotes.
func quotePath(path *[]readonly char) @[]char {
	var b buf.CharBuf = buf.New()
	b = b.WriteByte('"')
	b = b.WriteStr(path)
	b = b.WriteByte('"')
	return b.Bytes()
}

// appendStr appends a managed string to a managed slice of strings.
func appendStr(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImport appends an import spec to a managed slice.
func appendImport(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendMsg stores a message at index n, growing the slice if needed.
func appendMsg(s @[]@[]char, n int, v @[]char) @[]@[]char {
	if n >= len(s) {
		var newCap int = len(s) * 2
		var ns @[]@[]char = make_slice(@[]char, newCap)
		for i := 0; i < n; i++ { ns[i] = s[i] }
		s = ns
	}
	s[n] = v
	return s
}

// stripPrefix removes a prefix from s if present.
func stripPrefix(s *[]readonly char, prefix *[]readonly char) *[]readonly char {
	if len(prefix) == 0 || len(s) < len(prefix) {
		return s
	}
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return s }
	}
	return s[len(prefix):]
}

// streq returns true if two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
