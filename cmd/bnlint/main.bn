package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/buildcfg"
import "pkg/binate/lint"
import "pkg/binate/loader"
import "pkg/binate/types"
import "pkg/binate/version"
import "pkg/std/fmt"
import "pkg/std/os"
import "pkg/std/strings"
import "pkg/std/vec"
import "pkg/stdx/flags"

// Binate linter.
// Usage: bnlint -I <dir> [-L <dir>] [--target <key>] <pkg1> [pkg2 ...]

// main is the entry point for the linter CLI.
func main() {
	// progArgs already hands back a fresh, owned @[]@[]char, so parseArgs stays
	// testable (it is fed the same shape a synthetic test builds by hand).
	var args @[]@[]char = progArgs()
	var cli CLIArgs = parseArgs(args)

	if cli.ShowVersion {
		fmt.Print("bnlint-", version.Version, "\n")
		return
	}
	if len(cli.Error) > 0 {
		fmt.Println(cli.Error)
		os.Exit(1)
	}

	// Fall back to the environment for either search path the CLI left unset.
	// -I / -L win per path (a path given on the CLI ignores its env var); an
	// unset path falls back to BINATE_PACKAGE_INTERFACE_PATH / _IMPL_PATH (long
	// form) or the BINATE_BNI_PATH / BINATE_IMPL_PATH aliases.  parseArgs no
	// longer requires -I: an interface path may instead come from the env, so
	// the "one is required" check lives here, after this fallback.
	if len(cli.BniPaths) == 0 {
		cli.BniPaths = envPaths("BINATE_PACKAGE_INTERFACE_PATH", "BINATE_BNI_PATH")
	}
	if len(cli.ImplPaths) == 0 {
		cli.ImplPaths = envPaths("BINATE_PACKAGE_IMPL_PATH", "BINATE_IMPL_PATH")
	}
	if len(cli.BniPaths) == 0 {
		fmt.Println("error: no interface search path: pass -I <dir> or set BINATE_PACKAGE_INTERFACE_PATH")
		os.Exit(1)
	}

	var result LintResult = lintPackages(primaryRoot(cli), cli.Pkgs, cli.BniPaths, cli.ImplPaths,
			cli.Target, cli.Tests, cli.Disabled)

	if len(result.Error) > 0 {
		fmt.Println(result.Error)
		os.Exit(1)
	}

	for i := 0; i < result.Messages.Len(); i++ {
		fmt.Println(result.Messages.Get(i))
	}

	if result.Messages.Len() > 0 {
		fmt.Print(result.Messages.Len(), " lint diagnostic(s) found\n")
		os.Exit(1)
	}
}

// ============================================================
// CLI Argument Parsing
// ============================================================

type CLIArgs struct {
	Pkgs      @[]@[]char
	BniPaths  @[]@[]char // -I / --interface-path: dirs searched for `.bni`.
	ImplPaths @[]@[]char // -L / --impl-path: dirs searched for impl dirs.
	// Target is the --target key whose build config gates `#[build(...)]`
	// files/decls during linting (so a file inapplicable to the target is
	// not linted or false-flagged).  Empty selects the host.  Mirrors
	// cmd/bnc's --target keys.
	Target @[]char
	// Tests: when set (--tests), the target packages' `_test.bn` files are
	// loaded and linted too.  Off by default — a package's tests are not part
	// of its public surface, and linting them is opt-in.  (Also makes an
	// unexported entity used ONLY by a test count as used, avoiding a false
	// unused-func/-global/-type on test-only helpers.)
	Tests bool
	// Disabled lists rule names passed via `--disable <rule>` (repeatable).  A
	// diagnostic whose rule is in this set is dropped before reporting — a global
	// per-rule off switch, distinct from a per-site `// bnlint:allow`.  Used to
	// turn off an advisory rule the codebase has not yet adopted (e.g. a hygiene
	// invocation disabling `borrowable-char-param` tree-wide) without silencing
	// the rest of the linter.
	Disabled    @[]@[]char
	ShowVersion bool // --version: print the version banner and exit (checked in main)
	Error       @[]char
}

// primaryRoot returns bnlint's notion of "the binate source root" —
// the first BniPath entry (from -I or, when -I is absent, the interface
// env var).  Used for path-prefix stripping in diagnostics and as the
// loader's root.  Empty only if neither supplied a path — which main
// rejects after the env fallback, before calling this.
func primaryRoot(cli CLIArgs) @[]char {
	if len(cli.BniPaths) > 0 { return buf.CopyStr(cli.BniPaths[0]) }
	var empty @[]char
	return empty
}

// parseArgs parses linter command-line arguments into a CLIArgs struct.  It is a
// pure function of its arguments (the Pkgs are the parser's positionals), so the
// unit tests feed it synthetic argument vectors directly.  An interface path is
// NOT required here — it may instead come from the BINATE_PACKAGE_INTERFACE_PATH
// / BINATE_BNI_PATH env vars, which main consults after parseArgs; main enforces
// "one is required" after that fallback.
func parseArgs(args @[]@[]char) CLIArgs {
	var cli CLIArgs
	if len(args) == 0 {
		cli.Error = "usage: bnlint -I <dir> [-L <dirs>] <pkg1> [pkg2 ...]"
		return cli
	}
	var fs @flags.FlagSet = flags.New("bnlint")
	fs.BoolVar(&cli.ShowVersion, "version", "", "print version and exit")
	fs.StringListSepVar(&cli.BniPaths, "interface-path", "I", ':',
			"colon-separated dirs searched for .bni files (repeatable)")
	fs.StringListSepVar(&cli.ImplPaths, "impl-path", "L", ':',
			"colon-separated dirs searched for impl dirs (repeatable)")
	fs.StringVar(&cli.Target, "target", "", "", "target key gating #[build(...)] (empty = host)")
	fs.BoolVar(&cli.Tests, "tests", "", "also load and lint each target's _test.bn files")
	fs.StringListVar(&cli.Disabled, "disable", "", "disable a lint rule tree-wide (repeatable)")
	var perr @[]readonly char
	cli.Pkgs, perr = fs.Parse(args)
	if len(perr) > 0 {
		cli.Error = buf.CopyStr(perr)
		return cli
	}
	if cli.ShowVersion {
		return cli // main prints the version; no packages required
	}
	if len(cli.Pkgs) == 0 {
		cli.Error = "error: at least one package path required"
		return cli
	}
	return cli
}

// splitColon splits a string on ':' (POSIX PATH style). Empty entries
// are dropped so "A::B" → ["A", "B"]; trailing/leading colons are
// benign. Each entry is a fresh managed-slice copy.
func splitColon(s *[]readonly char) @[]@[]char {
	var out @[]@[]char
	if len(s) == 0 { return out }
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == ':' {
			if i > start {
				var part @[]char = make_slice(char, i - start)
				for k := 0; k < i - start; k++ {
					part[k] = s[start + k]
				}
				out = appendStr(out, part)
			}
			start = i + 1
		}
	}
	return out
}

// ============================================================
// Lint Pipeline
// ============================================================

// isLintTarget reports whether a loaded package path is one of the
// requested lint targets (vs. a transitive dependency).  Targets get a
// full body type-check; dependencies are registered decls-only.
func isLintTarget(path *[]readonly char, targets @[]@[]char) bool {
	for i := 0; i < len(targets); i++ {
		if streq(path, targets[i]) {
			return true
		}
	}
	return false
}

// ruleDisabled reports whether `rule` was turned off via `--disable <rule>`; such
// diagnostics are dropped before reporting (a global per-rule off switch).
func ruleDisabled(disabled @[]@[]char, rule *[]readonly char) bool {
	for i := 0; i < len(disabled); i++ {
		if streq(disabled[i], rule) {
			return true
		}
	}
	return false
}

// LintResult is the outcome of linting a set of packages: the
// formatted diagnostic Messages (Messages.Len() of them), or a fatal
// Error (loader failure or a type error that aborts before linting).
type LintResult struct {
	Messages @vec.Vec[@[]readonly char]
	Error    @[]readonly char
}

// lintPackages loads, type-checks, and lints the given packages.
// `root` (typically primaryRoot(cli) — the first -I entry) seeds the
// loader and supplies the prefix for diagnostic file paths.  bniPaths
// and implPaths are the full -I/-L lists; the loader walks them in
// order after `root`.  `target` is the --target key whose build config
// gates `#[build(...)]` files/decls (empty = host).
func lintPackages(root @[]char, pkgs @[]@[]char, bniPaths @[]@[]char, implPaths @[]@[]char,
		target @[]char, tests bool, disabled @[]@[]char) LintResult {
	var result LintResult
	// Initialize Messages before any early (Error) return so every LintResult
	// carries a valid empty vector — a caller can read Messages.Len() without
	// first checking Error, and a nil @Vec would deref.
	result.Messages = vec.New[@[]readonly char]()

	// Set up loader
	var ldr @loader.Loader = loader.NewLoader()
	ldr.AddBniPath(root)
	ldr.AddImplPath(root)
	for i := 0; i < len(bniPaths); i++ {
		ldr.AddBniPath(bniPaths[i])
	}
	for i := 0; i < len(implPaths); i++ {
		ldr.AddImplPath(implPaths[i])
	}
	// --tests: load each target package's `_test.bn` files (the loader
	// includes a package's test files only when its path is in TestPackages),
	// so LintFile then lints them too.  Only the explicitly-requested targets
	// get their tests loaded — transitive dependencies keep loading impl-only.
	if tests {
		for i := 0; i < len(pkgs); i++ {
			ldr.TestPackages = appendStr(ldr.TestPackages, buf.CopyStr(pkgs[i]))
		}
	}

	// Activate build-constraint gating for the target before loading, so a
	// file/decl that doesn't apply to the target is dropped (not linted, not
	// false-flagged), and a per-target package resolves to the right variant.
	var cfgErr @[]readonly char = resolveLintConfig(ldr, target)
	if len(cfgErr) > 0 {
		result.Error = cfgErr
		return result
	}

	// Create synthetic imports for the target packages
	var imports @[]@ast.ImportSpec
	for i := 0; i < len(pkgs); i++ {
		var imp @ast.ImportSpec = make(ast.ImportSpec)
		imp.Path = quotePath(pkgs[i])
		imports = appendImport(imports, imp)
	}
	ldr.LoadImports(imports)
	if len(ldr.Errors) > 0 {
		var cb @strings.Builder = strings.NewBuilder()
		for i := 0; i < len(ldr.Errors); i++ {
			if i > 0 { cb.WriteByte('\n') }
			cb.Write(ldr.Errors[i])
		}
		result.Error = cb.String()
		return result
	}

	// Type-check loaded packages.  Body-check only the lint TARGETS;
	// for packages pulled in only as transitive dependencies, register
	// their exported surface (decls only).  A target consumes only a
	// dependency's exported declarations, so re-checking a dependency's
	// bodies is redundant — and would leak that dependency's body-level
	// errors into every importer (e.g. a dep using a language feature
	// this checker version doesn't accept would fail every target that
	// imports it, not just itself).
	var c @types.Checker = types.NewChecker()
	for i := 0; i < len(ldr.Order); i++ {
		var pkg @loader.Package = ldr.GetPackage(ldr.Order[i])
		if pkg == nil { continue }
		if pkg.BNI != nil {
			c.LoadPackageInterface(ldr.Order[i], pkg.BNI)
		}
		if pkg.Merged != nil {
			if isLintTarget(ldr.Order[i], pkgs) {
				c.CheckPackage(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
			} else {
				c.CheckPackageDecls(ldr.Order[i], pkg.Merged, pkg.Files, pkg.BNI)
			}
		}
	}
	var errs @[]types.CheckError = c.CheckerErrors()
	if len(errs) > 0 {
		var cb @strings.Builder = strings.NewBuilder()
		for i := 0; i < len(errs); i++ {
			if i > 0 { cb.WriteByte('\n') }
			cb.Write(errs[i].Msg)
		}
		cb.WriteByte('\n')
		cb.Write("type errors found, aborting lint")
		result.Error = cb.String()
		return result
	}

	// Lint the requested packages
	// Root prefix for stripping absolute paths (include trailing /)
	var rootPrefix @[]char = buf.Concat(root, "/")

	// Parse every target file's `// bnlint:allow` directives up front, so a
	// malformed (rulespec-less) directive is reported even in a file that has
	// no other findings.
	var sup @suppressSet = newSuppressSet()
	for i := 0; i < len(pkgs); i++ {
		var pkg @loader.Package = ldr.GetPackage(pkgs[i])
		if pkg == nil { continue }
		for k := 0; k < len(pkg.Files); k++ {
			var f @ast.File = pkg.Files[k]
			if f == nil || len(f.Pos.File) == 0 { continue }
			var src @[]uint8 = readFile(f.Pos.File)
			if len(src) == 0 { continue }
			scanFileInto(sup, f.Pos.File, src)
		}
	}

	for i := 0; i < len(pkgs); i++ {
		var pkg @loader.Package = ldr.GetPackage(pkgs[i])
		if pkg == nil || pkg.Merged == nil { continue }
		var r @lint.Result = lint.LintFile(c, pkg.Merged, pkg.Files)
		for j := 0; j < r.Diags.Len(); j++ {
			var d lint.Diagnostic = r.Diags.Get(j)
			if ruleDisabled(disabled, d.Rule) { continue }
			if isSuppressed(sup, d.Pos.File, d.Pos.Line, d.Rule) { continue }
			var msg @[]readonly char = formatDiag(pkgs[i], d, rootPrefix)
			result.Messages.Push(msg)
		}
	}

	// A `// bnlint:allow` with no rulespec is itself a lint error.
	for i := 0; i < sup.Bad.Len(); i++ {
		var msg @[]readonly char = formatMalformed(sup.Bad.Get(i), rootPrefix)
		result.Messages.Push(msg)
	}

	return result
}

// resolveLintConfig activates build-constraint gating on ldr for the given
// --target key.  Empty / "host" uses bnlint's own compiled-in build host
// (buildcfg.HostConfig, mirroring bnc — no build.bni read).  An explicit key
// maps via buildcfg.ConfigForTargetKey.  Returns "" on success, or a
// diagnostic for an unknown key.
func resolveLintConfig(ldr @loader.Loader, target @[]char) @[]readonly char {
	if len(target) == 0 || streq(target, "host") {
		ldr.BuildConfig = buildcfg.HostConfig()
		var ok @[]readonly char
		return ok
	}
	var cfg @buildcfg.BuildConfig
	var found bool
	cfg, found = buildcfg.ConfigForTargetKey(target)
	if !found {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("error: unknown --target ")
		cb.Write(target)
		return cb.String()
	}
	ldr.BuildConfig = cfg
	var ok @[]readonly char
	return ok
}

// ============================================================
// Diagnostic Formatting
// ============================================================
