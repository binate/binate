package "main"

import "pkg/bootstrap"
import "pkg/buf"
import "pkg/builtin/testing"
import "pkg/lint"
import "pkg/token"

// ============================================================
// parseArgs tests
// ============================================================

func TestParseArgsBasic() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/some/dir", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(cli.Root, "/some/dir") { return "wrong root" }
	if len(cli.Pkgs) != 1 { return "expected 1 pkg" }
	if !streq(cli.Pkgs[0], "pkg/foo") { return "wrong pkg" }
	return ""
}

func TestParseArgsMultiplePkgs() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/dir", "pkg/a", "pkg/b"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Pkgs) != 2 { return "expected 2 pkgs" }
	if !streq(cli.Pkgs[0], "pkg/a") { return "wrong pkg 0" }
	if !streq(cli.Pkgs[1], "pkg/b") { return "wrong pkg 1" }
	return ""
}

func TestParseArgsEmpty() testing.TestResult {
	var args @[]@[]char
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for empty args" }
	return ""
}

func TestParseArgsMissingRoot() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for missing --root" }
	return ""
}

func TestParseArgsMissingRootValue() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for --root without value" }
	return ""
}

func TestParseArgsMissingPkgs() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/dir"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for no packages" }
	return ""
}

// ============================================================
// -I / --interface-path tests
// ============================================================

func TestParseArgsInterfacePathShort() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/r", "-I", "/bni", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 1 { return "expected 1 BniPath" }
	if !streq(cli.BniPaths[0], "/bni") { return "wrong BniPath[0]" }
	if len(cli.ImplPaths) != 0 { return "ImplPaths should be empty" }
	if len(cli.Pkgs) != 1 { return "expected 1 pkg" }
	return ""
}

func TestParseArgsInterfacePathLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/r", "--interface-path", "/bni", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 1 { return "expected 1 BniPath" }
	if !streq(cli.BniPaths[0], "/bni") { return "wrong BniPath[0]" }
	return ""
}

func TestParseArgsInterfacePathColonList() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/r", "-I", "/a:/b:/c", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 3 { return "expected 3 BniPath entries" }
	if !streq(cli.BniPaths[0], "/a") { return "BniPath[0] wrong" }
	if !streq(cli.BniPaths[1], "/b") { return "BniPath[1] wrong" }
	if !streq(cli.BniPaths[2], "/c") { return "BniPath[2] wrong" }
	return ""
}

func TestParseArgsInterfacePathRepeatable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/r", "-I", "/a:/b", "--interface-path", "/c", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 3 { return "expected 3 BniPath entries" }
	if !streq(cli.BniPaths[2], "/c") { return "BniPath[2] wrong" }
	return ""
}

