package "main"

import "pkg/binate/buf"
import "pkg/binate/loader"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// ============================================================
// parseArgs tests
// ============================================================

func TestParseArgsBasic() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/some/dir", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(primaryRoot(cli), "/some/dir") { return "wrong root" }
	if len(cli.Pkgs) != 1 { return "expected 1 pkg" }
	if !streq(cli.Pkgs[0], "pkg/foo") { return "wrong pkg" }
	return ""
}

func TestParseArgsMultiplePkgs() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "pkg/a", "pkg/b"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Pkgs) != 2 { return "expected 2 pkgs" }
	if !streq(cli.Pkgs[0], "pkg/a") { return "wrong pkg 0" }
	if !streq(cli.Pkgs[1], "pkg/b") { return "wrong pkg 1" }
	return ""
}

func TestParseArgsEmpty() testing.TestResult {
	var args @[]@[]char
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for empty args" }
	return ""
}

// `--root` was removed in favor of -I/-L (cc-style search paths);
// `primaryRoot(cli)` returns the first -I entry as bnlint's notion
// of the source root (used for path-prefix stripping in diagnostics
// and as the loader's root).
func TestPrimaryRootFromFirstBniPath() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/my/root", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(primaryRoot(cli), "/my/root") {
		return "primaryRoot should return first -I"
	}
	return ""
}

// With no -I, primaryRoot returns empty.  (An interface path missing from
// BOTH -I and the env vars is rejected in main, after the env fallback —
// not in parseArgs.)  The helper itself is tested with an empty BniPaths
// slice directly.
func TestPrimaryRootEmptyWithoutBniPath() testing.TestResult {
	var cli CLIArgs
	if len(primaryRoot(cli)) != 0 {
		return "primaryRoot should be empty without -I"
	}
	return ""
}

// parseArgs no longer enforces -I: an interface path may come from the
// BINATE_PACKAGE_INTERFACE_PATH / BINATE_BNI_PATH env vars, so the
// "one is required" check moved to main (after the env fallback).  With
// packages present and no -I, parseArgs now returns cleanly with an empty
// BniPaths — main is what rejects the no-path-anywhere case.
func TestParseArgsNoBniPathNotAParseError() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) != 0 { return "no -I should no longer be a parse error" }
	if len(cli.BniPaths) != 0 { return "BniPaths should be empty" }
	if len(cli.Pkgs) != 1 { return "pkg/foo should be a package arg" }
	return ""
}

func TestParseArgsMissingIValue() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for -I without value" }
	return ""
}

func TestParseArgsMissingPkgs() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for no packages" }
	return ""
}

// ============================================================
// --disable tests
// ============================================================

func TestParseArgsDisable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "--disable", "borrowable-char-param", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Disabled) != 1 { return "expected 1 disabled rule (--disable consumed its value)" }
	if !streq(cli.Disabled[0], "borrowable-char-param") { return "wrong disabled rule" }
	if len(cli.Pkgs) != 1 || !streq(cli.Pkgs[0], "pkg/foo") { return "wrong pkg" }
	return ""
}

func TestParseArgsDisableRepeatable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "--disable", "rule-a", "--disable", "rule-b",
			"pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Disabled) != 2 { return "expected 2 disabled rules" }
	if !streq(cli.Disabled[0], "rule-a") || !streq(cli.Disabled[1], "rule-b") {
		return "wrong disabled rules"
	}
	return ""
}

func TestParseArgsDisableMissingValue() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "--disable"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for --disable without value" }
	return ""
}

// ruleDisabled is the FILTERING predicate the diagnostic loop consults
// (`if ruleDisabled(disabled, d.Rule) { continue }`) — the actual suppression
// behavior of --disable, distinct from the parse tests above which only check
// that --disable populates cli.Disabled.

func TestRuleDisabledMatch() testing.TestResult {
	var disabled @[]@[]char = @[]@[]char{"rule-a", "rule-b"}
	if !ruleDisabled(disabled, "rule-a") { return "rule-a should be disabled" }
	if !ruleDisabled(disabled, "rule-b") { return "rule-b (not just the first) should be disabled" }
	return ""
}

func TestRuleDisabledNoMatch() testing.TestResult {
	var disabled @[]@[]char = @[]@[]char{"rule-a", "rule-b"}
	if ruleDisabled(disabled, "rule-c") { return "a rule not in the list must NOT be disabled" }
	return ""
}

func TestRuleDisabledEmpty() testing.TestResult {
	var none @[]@[]char
	if ruleDisabled(none, "any-rule") { return "no rule is disabled when the --disable list is empty" }
	return ""
}

