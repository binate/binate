// ============================================================
// splitColon tests
// ============================================================

func TestSplitColonEmpty() testing.TestResult {
	var r @[]@[]char = splitColon("")
	if len(r) != 0 { return "empty input should give empty result" }
	return ""
}

func TestSplitColonSingle() testing.TestResult {
	var r @[]@[]char = splitColon("/foo")
	if len(r) != 1 { return "expected 1 entry" }
	if !streq(r[0], "/foo") { return "entry wrong" }
	return ""
}

func TestSplitColonMultiple() testing.TestResult {
	var r @[]@[]char = splitColon("/a:/b:/c")
	if len(r) != 3 { return "expected 3 entries" }
	if !streq(r[0], "/a") { return "[0] wrong" }
	if !streq(r[1], "/b") { return "[1] wrong" }
	if !streq(r[2], "/c") { return "[2] wrong" }
	return ""
}

func TestSplitColonEmptyEntries() testing.TestResult {
	var r @[]@[]char = splitColon("/a::/b")
	if len(r) != 2 { return "empty entry should be dropped" }
	return ""
}

func TestSplitColonTrailing() testing.TestResult {
	var r @[]@[]char = splitColon("/a:")
	if len(r) != 1 { return "trailing colon should be dropped" }
	if !streq(r[0], "/a") { return "[0] wrong" }
	return ""
}

func TestSplitColonLeading() testing.TestResult {
	var r @[]@[]char = splitColon(":/a")
	if len(r) != 1 { return "leading colon should be dropped" }
	if !streq(r[0], "/a") { return "[0] wrong" }
	return ""
}

// ============================================================
// formatDiag tests
// ============================================================

func TestFormatDiag() testing.TestResult {
	var d lint.Diagnostic
	d.Pos.File = "pkg/foo/bar.bn"
	d.Pos.Line = 42
	d.Pos.Col = 10
	d.Rule = "test-rule"
	d.Message = "something bad"
	var msg @[]char = formatDiag("pkg/foo", d, "")
	var expected *[]const char = "pkg/foo/bar.bn:42:10: [test-rule] something bad"
	if !streq(msg, expected) {
		var cb buf.CharBuf = buf.New()
		cb = cb.WriteStr("expected '")
		cb = cb.WriteStr(expected)
		cb = cb.WriteStr("', got '")
		cb = cb.WriteStr(msg)
		cb = cb.WriteByte('\'')
		return cb.Bytes()
	}
	return ""
}

func TestFormatDiagFallback() testing.TestResult {
	// When Pos.File is empty, falls back to pkgPath
	var d lint.Diagnostic
	d.Rule = "r"
	d.Message = "m"
	var msg @[]char = formatDiag("pkg/x", d, "")
	if !streq(msg, "pkg/x:0:0: [r] m") {
		return bootstrap.Concat("unexpected: ", msg)
	}
	return ""
}

func TestFormatDiagUsesFile() testing.TestResult {
	// When Pos.File is set, uses it instead of pkgPath
	var d lint.Diagnostic
	d.Pos.File = "src/thing.bn"
	d.Pos.Line = 5
	d.Pos.Col = 3
	d.Rule = "r"
	d.Message = "m"
	var msg @[]char = formatDiag("pkg/x", d, "")
	if !streq(msg, "src/thing.bn:5:3: [r] m") {
		return bootstrap.Concat("unexpected: ", msg)
	}
	return ""
}

func TestFormatDiagStripsRoot() testing.TestResult {
	var d lint.Diagnostic
	d.Pos.File = "/home/user/proj/pkg/foo/bar.bn"
	d.Pos.Line = 10
	d.Pos.Col = 5
	d.Rule = "r"
	d.Message = "m"
	var msg @[]char = formatDiag("pkg/foo", d, "/home/user/proj/")
	if !streq(msg, "pkg/foo/bar.bn:10:5: [r] m") {
		return bootstrap.Concat("unexpected: ", msg)
	}
	return ""
}

// ============================================================
// stripPrefix tests
// ============================================================

func TestStripPrefix() testing.TestResult {
	var result *[]const char = stripPrefix("/a/b/c.bn", "/a/b/")
	if !streq(result, "c.bn") { return bootstrap.Concat("unexpected: ", result) }
	return ""
}

func TestStripPrefixNoMatch() testing.TestResult {
	var result *[]const char = stripPrefix("other/path.bn", "/a/b/")
	if !streq(result, "other/path.bn") { return bootstrap.Concat("unexpected: ", result) }
	return ""
}

func TestStripPrefixEmpty() testing.TestResult {
	var result *[]const char = stripPrefix("path.bn", "")
	if !streq(result, "path.bn") { return bootstrap.Concat("unexpected: ", result) }
	return ""
}

