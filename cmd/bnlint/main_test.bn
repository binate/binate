// ============================================================
// --target tests
// ============================================================

func TestParseArgsTarget() testing.TestResult {
	var args @[]@[]char =
		@[]@[]char{"-I", "/dir", "--target", "arm32-baremetal", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(cli.Target, "arm32-baremetal") { return "wrong target" }
	if len(cli.Pkgs) != 1 { return "expected 1 pkg (target consumed its value)" }
	if !streq(cli.Pkgs[0], "pkg/foo") { return "wrong pkg" }
	return ""
}

func TestParseArgsTargetDefaultsEmpty() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Target) != 0 { return "target should default to empty (host)" }
	return ""
}

func TestParseArgsTargetMissingValue() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "--target"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for --target without value" }
	return ""
}

// ============================================================
// resolveLintConfig tests (the --target -> loader BuildConfig wiring)
// ============================================================

// An explicit key activates gating with the mapped arch/os config.
func TestResolveLintConfigExplicitKey() testing.TestResult {
	var ldr @loader.Loader = loader.NewLoader("/no/such/root")
	var err @[]readonly char = resolveLintConfig(ldr, "arm32-baremetal")
	if len(err) != 0 { return buf.CopyStr(err) }
	if ldr.BuildConfig == nil { return "BuildConfig should be set" }
	if !streq(ldr.BuildConfig.Arch, "arm32") { return "wrong arch" }
	if !streq(ldr.BuildConfig.OS, "baremetal") { return "wrong os" }
	return ""
}

// An unknown key is a hard error and leaves gating inactive.
func TestResolveLintConfigUnknownKey() testing.TestResult {
	var ldr @loader.Loader = loader.NewLoader("/no/such/root")
	var err @[]readonly char = resolveLintConfig(ldr, "bogus-triple")
	if len(err) == 0 { return "expected error for unknown --target" }
	if ldr.BuildConfig != nil { return "BuildConfig should stay nil on error" }
	return ""
}

// The host path with no pkg/builtins/build reachable leaves gating inactive
// (nil) without failing — graceful degradation, mirroring bnc.
func TestResolveLintConfigHostNoBuildPkg() testing.TestResult {
	var ldr @loader.Loader = loader.NewLoader("/no/such/root")
	var err @[]readonly char = resolveLintConfig(ldr, "")
	if len(err) != 0 { return buf.CopyStr(err) }
	if ldr.BuildConfig != nil {
		return "expected inactive (nil) config without a build package"
	}
	return ""
}

// ============================================================
// -I / --interface-path tests
// ============================================================

func TestParseArgsInterfacePathShort() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/bni", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 1 { return "expected 1 BniPath" }
	if !streq(cli.BniPaths[0], "/bni") { return "wrong BniPath[0]" }
	if len(cli.ImplPaths) != 0 { return "ImplPaths should be empty" }
	if len(cli.Pkgs) != 1 { return "expected 1 pkg" }
	return ""
}

func TestParseArgsInterfacePathLong() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--interface-path", "/bni", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 1 { return "expected 1 BniPath" }
	if !streq(cli.BniPaths[0], "/bni") { return "wrong BniPath[0]" }
	return ""
}

func TestParseArgsInterfacePathColonList() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/a:/b:/c", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 3 { return "expected 3 BniPath entries" }
	if !streq(cli.BniPaths[0], "/a") { return "BniPath[0] wrong" }
	if !streq(cli.BniPaths[1], "/b") { return "BniPath[1] wrong" }
	if !streq(cli.BniPaths[2], "/c") { return "BniPath[2] wrong" }
	return ""
}

func TestParseArgsInterfacePathRepeatable() testing.TestResult {
	var args @[]@[]char = @[]@[]char{
		"-I", "/a:/b",
		"--interface-path", "/c", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 3 { return "expected 3 BniPath entries" }
	if !streq(cli.BniPaths[2], "/c") { return "BniPath[2] wrong" }
	return ""
}

