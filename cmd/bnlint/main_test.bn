// ============================================================
// streq tests
// ============================================================

func TestStreqEqual() testing.TestResult {
	if !streq("hello", "hello") { return "equal strings should match" }
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") { return "different strings should not match" }
	return ""
}

func TestStreqDifferentLen() testing.TestResult {
	if streq("hi", "hello") { return "different length strings should not match" }
	return ""
}

func TestStreqEmpty() testing.TestResult {
	if !streq("", "") { return "empty strings should match" }
	return ""
}

// ============================================================
// appendStr / appendMsg tests
// ============================================================

func TestAppendStr() testing.TestResult {
	var s @[]@[]char
	s = appendStr(s, "a")
	s = appendStr(s, "b")
	if len(s) != 2 { return "expected len 2" }
	if !streq(s[0], "a") { return "wrong [0]" }
	if !streq(s[1], "b") { return "wrong [1]" }
	return ""
}

func TestAppendMsgGrowth() testing.TestResult {
	var s @[]@[]readonly char = make_slice(@[]readonly char, 2)
	var n int = 0
	s = appendMsg(s, n, "a")
	n = n + 1
	s = appendMsg(s, n, "b")
	n = n + 1
	// Should trigger growth
	s = appendMsg(s, n, "c")
	n = n + 1
	if n != 3 { return "expected 3 items" }
	if !streq(s[0], "a") { return "wrong [0]" }
	if !streq(s[1], "b") { return "wrong [1]" }
	if !streq(s[2], "c") { return "wrong [2]" }
	return ""
}

// ============================================================
// lintPackages integration test
// ============================================================

func TestLintPackagesClean() testing.TestResult {
	// Lint pkg/binate/ast — should have no lint diagnostics (it's just type defs)
	var root @[]char = findRoot()
	if len(root) == 0 { return "" }  // skip if can't determine root
	var pkgs @[]@[]char = @[]@[]char{"pkg/binate/ast"}
	var emptyPaths @[]@[]char
	var noTarget @[]char
	var result LintResult =
		lintPackages(root, pkgs, emptyPaths, emptyPaths, noTarget)
	if len(result.Error) > 0 { return buf.CopyStr(result.Error) }
	if result.NumDiags != 0 {
		return buf.Concat("expected 0 diags for pkg/binate/ast, got ", strconv.Itoa(result.NumDiags))
	}
	return ""
}

func TestLintPackagesBadPkg() testing.TestResult {
	var root @[]char = findRoot()
	if len(root) == 0 { return "" }
	var pkgs @[]@[]char = @[]@[]char{"pkg/nonexistent"}
	var emptyPaths @[]@[]char
	var noTarget @[]char
	var result LintResult =
		lintPackages(root, pkgs, emptyPaths, emptyPaths, noTarget)
	// Should get a loader error
	if len(result.Error) == 0 {
		return "expected error for nonexistent package"
	}
	return ""
}

// TestIsLintTarget checks the target-vs-dependency predicate that
// routes packages between a full body type-check (targets) and a
// decls-only registration (transitive dependencies).
func TestIsLintTarget() testing.TestResult {
	var targets @[]@[]char = @[]@[]char{"pkg/binate/vm", "cmd/bni"}
	if !isLintTarget("pkg/binate/vm", targets) {
		return "expected pkg/binate/vm to be a target"
	}
	if !isLintTarget("cmd/bni", targets) {
		return "expected cmd/bni to be a target"
	}
	if isLintTarget("pkg/binate/repl", targets) {
		return "pkg/binate/repl is not a target (dependency only)"
	}
	var none @[]@[]char
	if isLintTarget("pkg/anything", none) {
		return "empty target list: nothing is a target"
	}
	return ""
}

// findRoot picks up `-I <dir>` from the test binary's argv when the
// runner supplies one; otherwise returns empty and the caller skips.
// The builder-comp / builder-comp-comp test runners don't pass -I through
// today, so these integration tests self-skip in CI — left in place
// so they run when a developer invokes the test binary by hand with
// `... -I <binate-root>`.
func findRoot() @[]char {
	var args @[]@[]char = bootstrap.Args()
	for i := 0; i < len(args); i++ {
		if streq(args[i], "-I") && i + 1 < len(args) {
			return buf.CopyStr(args[i + 1])
		}
	}
	return ""
}
