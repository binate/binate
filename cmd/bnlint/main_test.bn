// ============================================================
// parseArgs tests
// ============================================================

func TestParseArgsBasic() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/some/dir", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(primaryRoot(cli), "/some/dir") { return "wrong root" }
	if len(cli.Pkgs) != 1 { return "expected 1 pkg" }
	if !streq(cli.Pkgs[0], "pkg/foo") { return "wrong pkg" }
	return ""
}

func TestParseArgsMultiplePkgs() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/dir", "pkg/a", "pkg/b"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Pkgs) != 2 { return "expected 2 pkgs" }
	if !streq(cli.Pkgs[0], "pkg/a") { return "wrong pkg 0" }
	if !streq(cli.Pkgs[1], "pkg/b") { return "wrong pkg 1" }
	return ""
}

func TestParseArgsEmpty() testing.TestResult {
	var args @[]@[]char
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) == 0 { return "expected error for empty args" }
	return ""
}

// `--root` was removed in favor of -I/-L (cc-style search paths);
// `primaryRoot(cli)` returns the first -I entry as bnlint's notion
// of the source root (used for path-prefix stripping in diagnostics
// and as the loader's root).
func TestPrimaryRootFromFirstBniPath() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/my/root", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if !streq(primaryRoot(cli), "/my/root") {
		return "primaryRoot should return first -I"
	}
	return ""
}

// With no -I, primaryRoot returns empty.  parseArgs surfaces that
// as the "-I is required" CLI error before main calls primaryRoot,
// so we have to inspect cli.Error to confirm the precondition; the
// helper itself is tested with an empty BniPaths slice directly.
func TestPrimaryRootEmptyWithoutBniPath() testing.TestResult {
	var cli CLIArgs
	if len(primaryRoot(cli)) != 0 {
		return "primaryRoot should be empty without -I"
	}
	return ""
}

// --root used to be a flag; after the migration it is no longer
// recognized and falls through to the positional branch (becoming
// a "pkg" arg).  Pin that so a stray re-introduction of `--root`
// parsing breaks loudly.  Pair with a -I so the "no -I" guard
// doesn't short-circuit and we exercise the actual positional path.
func TestParseArgsRootIsPositional() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"-I", "/r", "--root", "/proj", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.Pkgs) != 3 {
		return "--root should land in Pkgs, not be parsed as a flag"
	}
	if !streq(cli.Pkgs[0], "--root")  { return "Pkgs[0] wrong" }
	if !streq(cli.Pkgs[1], "/proj")   { return "Pkgs[1] wrong" }
	if !streq(cli.Pkgs[2], "pkg/foo") { return "Pkgs[2] wrong" }
	return ""
}

