// ============================================================
// splitColon tests
// ============================================================

func TestSplitColonEmpty() testing.TestResult {
	var r @[]@[]char = splitColon("")
	if len(r) != 0 { return "empty input should give empty result" }
	return ""
}

func TestSplitColonSingle() testing.TestResult {
	var r @[]@[]char = splitColon("/foo")
	if len(r) != 1 { return "expected 1 entry" }
	if !streq(r[0], "/foo") { return "entry wrong" }
	return ""
}

func TestSplitColonMultiple() testing.TestResult {
	var r @[]@[]char = splitColon("/a:/b:/c")
	if len(r) != 3 { return "expected 3 entries" }
	if !streq(r[0], "/a") { return "[0] wrong" }
	if !streq(r[1], "/b") { return "[1] wrong" }
	if !streq(r[2], "/c") { return "[2] wrong" }
	return ""
}

func TestSplitColonEmptyEntries() testing.TestResult {
	var r @[]@[]char = splitColon("/a::/b")
	if len(r) != 2 { return "empty entry should be dropped" }
	return ""
}

func TestSplitColonTrailing() testing.TestResult {
	var r @[]@[]char = splitColon("/a:")
	if len(r) != 1 { return "trailing colon should be dropped" }
	if !streq(r[0], "/a") { return "[0] wrong" }
	return ""
}

func TestSplitColonLeading() testing.TestResult {
	var r @[]@[]char = splitColon(":/a")
	if len(r) != 1 { return "leading colon should be dropped" }
	if !streq(r[0], "/a") { return "[0] wrong" }
	return ""
}

// ============================================================
// lintPackages integration tests
// ============================================================
//
// These load REAL packages from disk through the loader, so they must run with
// the current directory at the binate repo root: the unit-test runner
// (scripts/unittest/run.sh) sets CWD there, and a manual run must too.  The root
// handed to lintPackages is therefore "." (CWD-relative) — a package that cannot
// be found fails the test LOUDLY.  There is no "skip" result in the framework
// (TestResult is pass/fail), so a conditional early `return ""` would be an
// invisible green (a test that silently does nothing) — worse than a failure.
//
// These use SELF-CONTAINED targets (a nonexistent package, or a testdata
// fixture with no cross-package deps), so a single "." search path suffices.
// Linting a real stdlib-dependent package needs the full ifaces/*+impls/*
// search roots and is an integration concern covered by the bnlint-self e2e
// (e2e/bnlint-self.sh), which builds the current bnlint and lints the whole
// repo — not something to duplicate here with a hand-copied search-root list.

func TestLintPackagesBadPkg() testing.TestResult {
	var root @[]char = "."
	var pkgs @[]@[]char = @[]@[]char{"pkg/nonexistent"}
	var emptyPaths @[]@[]char
	var noTarget @[]char
	var result LintResult = lintPackages(root, pkgs, emptyPaths, emptyPaths, noTarget, false)
	// Should get a loader error
	if len(result.Error) == 0 {
		return "expected error for nonexistent package"
	}
	return ""
}

// TestLintPackagesTestsFlag exercises the --tests flag end-to-end through
// the cmd/bnlint/testdata/tests_flag fixture, whose _test.bn carries a
// deliberate unused-func (unusedHelper) plus a // bnlint:allow-suppressed
// one (suppressedHelper).  With tests=false the _test.bn is not loaded, so
// the package is clean (0 diags); with tests=true it is linted, surfacing
// exactly one finding — proving both that --tests reaches test files and
// that a directive suppresses the second.
func TestLintPackagesTestsFlag() testing.TestResult {
	var root @[]char = "."
	var pkgs @[]@[]char = @[]@[]char{"cmd/bnlint/testdata/tests_flag"}
	var emptyPaths @[]@[]char
	var noTarget @[]char

	var off LintResult = lintPackages(root, pkgs, emptyPaths, emptyPaths, noTarget, false)
	if len(off.Error) > 0 { return buf.CopyStr(off.Error) }
	if off.Messages.Len() != 0 {
		return buf.Concat("expected 0 diags without --tests, got ", strconv.Itoa(off.Messages.Len()))
	}

	var on LintResult = lintPackages(root, pkgs, emptyPaths, emptyPaths, noTarget, true)
	if len(on.Error) > 0 { return buf.CopyStr(on.Error) }
	if on.Messages.Len() != 1 {
		return buf.Concat("expected exactly 1 diag with --tests, got ", strconv.Itoa(on.Messages.Len()))
	}
	return ""
}

// TestLintPackagesAllBniGeneric lints the cmd/bnlint/testdata/generic_bni
// fixture — an all-`.bni` (all-generic) library whose bodies live in the
// `.bni` with no `.bn` impl.  Every function there is the package's exported
// API, so a plain lint run must report ZERO diagnostics.  It guards the loader
// bug where an all-`.bni` package skipped markBniExportedFuncs (the merge
// overlay that marks the exported surface is guarded on a `.bn` impl being
// present), leaving the public API marked unexported and thus false-flagged
// unused-func.
func TestLintPackagesAllBniGeneric() testing.TestResult {
	var root @[]char = "."
	var pkgs @[]@[]char = @[]@[]char{"cmd/bnlint/testdata/generic_bni"}
	var emptyPaths @[]@[]char
	var noTarget @[]char
	var result LintResult = lintPackages(root, pkgs, emptyPaths, emptyPaths, noTarget, false)
	if len(result.Error) > 0 { return buf.CopyStr(result.Error) }
	if result.Messages.Len() != 0 {
		return buf.Concat("expected 0 diags for all-.bni generic package, got ",
				strconv.Itoa(result.Messages.Len()))
	}
	return ""
}

// TestIsLintTarget checks the target-vs-dependency predicate that
// routes packages between a full body type-check (targets) and a
// decls-only registration (transitive dependencies).
func TestIsLintTarget() testing.TestResult {
	var targets @[]@[]char = @[]@[]char{"pkg/binate/vm", "cmd/bni"}
	if !isLintTarget("pkg/binate/vm", targets) {
		return "expected pkg/binate/vm to be a target"
	}
	if !isLintTarget("cmd/bni", targets) {
		return "expected cmd/bni to be a target"
	}
	if isLintTarget("pkg/binate/repl", targets) {
		return "pkg/binate/repl is not a target (dependency only)"
	}
	var none @[]@[]char
	if isLintTarget("pkg/anything", none) {
		return "empty target list: nothing is a target"
	}
	return ""
}
