// Mixed -I and -L; paths kept separate.
func TestParseArgsInterfaceAndImplPaths() testing.TestResult {
	var args @[]@[]char = @[]@[]char{"--root", "/r", "-I", "/bni", "-L", "/impl", "pkg/foo"}
	var cli CLIArgs = parseArgs(args)
	if len(cli.Error) > 0 { return cli.Error }
	if len(cli.BniPaths) != 1 { return "expected 1 BniPath" }
	if len(cli.ImplPaths) != 1 { return "expected 1 ImplPath" }
	if !streq(cli.BniPaths[0], "/bni") { return "BniPath[0] wrong" }
	if !streq(cli.ImplPaths[0], "/impl") { return "ImplPath[0] wrong" }
	return ""
}

