package "main"

import "pkg/binate/ast"
import "pkg/binate/buf"
import "pkg/binate/lint"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/strconv"
import "pkg/std/strings"

// formatDiag formats a diagnostic as "file:line:col: [rule] message".
// If rootPrefix is non-empty, strips it from the file path for shorter output.
func formatDiag(pkgPath @[]char, d lint.Diagnostic, rootPrefix @[]char) @[]readonly char {
	var cb @strings.Builder = strings.NewBuilder()
	if len(d.Pos.File) > 0 {
		var file *[]readonly char = stripPrefix(d.Pos.File, rootPrefix)
		cb.Write(file)
	} else {
		cb.Write(pkgPath)
	}
	cb.WriteByte(':')
	cb.Write(strconv.Itoa(d.Pos.Line))
	cb.WriteByte(':')
	cb.Write(strconv.Itoa(d.Pos.Col))
	cb.Write(": [")
	cb.Write(d.Rule)
	cb.Write("] ")
	cb.Write(d.Message)
	return cb.String()
}

// formatMalformed formats a rulespec-less `// bnlint:allow` directive as a
// `[bnlint-allow]` error at its position, stripping rootPrefix from the path.
func formatMalformed(b malformedDir, rootPrefix @[]char) @[]readonly char {
	var cb @strings.Builder = strings.NewBuilder()
	var file *[]readonly char = stripPrefix(b.File, rootPrefix)
	cb.Write(file)
	cb.WriteByte(':')
	cb.Write(strconv.Itoa(b.Line))
	cb.WriteByte(':')
	cb.Write(strconv.Itoa(b.Col))
	cb.Write(": [bnlint-allow] directive requires a rule name (or '*')")
	return cb.String()
}

// ============================================================
// Helpers
// ============================================================

// progArgs returns bnlint's own argument tokens: os.Args() minus the program-name
// slot at index 0, copied into a mutable @[]@[]char for parsing.  Reading argv
// through os.Args (rather than bootstrap.Args) means that when bnlint is run under
// the bytecode interpreter it sees the argv the interpreter installed via
// os.SetArgs, not the interpreter's own — see explorations/design-os-args-vm.md.
func progArgs() @[]@[]char {
	var full @[]readonly @[]readonly char = os.Args()
	var n int = len(full)
	if n <= 1 {
		return make_slice(@[]char, 0)
	}
	var out @[]@[]char = make_slice(@[]char, n - 1)
	for i := 1; i < n; i++ {
		// full[i] is a readonly-qualified element; copy it char-by-char into an
		// owned @[]char (its readonly type can't be borrowed as the
		// *[]readonly char buf.CopyStr expects).
		var m int = len(full[i])
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = full[i][j]
		}
		out[i - 1] = s
	}
	return out
}

// readFile reads an entire file into a managed byte slice.
func readFile(path *[]readonly char) @[]uint8 {
	var f @os.File
	var err @errors.Error
	f, err = os.Open(path)
	if present(err) {
		var empty @[]uint8
		return empty
	}
	var cap int = 4096
	var result @[]uint8 = make_slice(uint8, cap)
	var total int = 0
	var tmp @[]uint8 = make_slice(uint8, 4096)
	for {
		var n int
		n, err = f.Read(tmp)
		if n <= 0 { break }
		for total + n > cap {
			var newCap int = cap * 2
			var newBuf @[]uint8 = make_slice(uint8, newCap)
			for i := 0; i < total; i++ {
				newBuf[i] = result[i]
			}
			result = newBuf
			cap = newCap
		}
		for i := 0; i < n; i++ {
			result[total + i] = tmp[i]
		}
		total = total + n
	}
	_ = f.Close()
	if total == 0 {
		var empty @[]uint8
		return empty
	}
	return result[0:total]
}

// quotePath wraps a path in double quotes.
func quotePath(path *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('"')
	b.Write(path)
	b.WriteByte('"')
	// ast.ImportSpec.Path is @[]char (an in-cone type), so the quoted path
	// must be handed off as an owned mutable copy.  CopyStr is exactly that;
	// the readonly-correct alternative (a @[]readonly char Path) is a
	// separate import-path-plumbing change.
	return buf.CopyStr(b.String())
}

// appendStr appends a managed string to a managed slice of strings.
func appendStr(s @[]@[]char, v @[]char) @[]@[]char {
	var n int = len(s)
	var ns @[]@[]char = make_slice(@[]char, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// appendImport appends an import spec to a managed slice.
func appendImport(s @[]@ast.ImportSpec, v @ast.ImportSpec) @[]@ast.ImportSpec {
	var n int = len(s)
	var ns @[]@ast.ImportSpec = make_slice(@ast.ImportSpec, n + 1)
	for i := 0; i < n; i++ { ns[i] = s[i] }
	ns[n] = v
	return ns
}

// stripPrefix removes a prefix from s if present.
func stripPrefix(s *[]readonly char, prefix *[]readonly char) *[]readonly char {
	if len(prefix) == 0 || len(s) < len(prefix) {
		return s
	}
	for i := 0; i < len(prefix); i++ {
		if s[i] != prefix[i] { return s }
	}
	return s[len(prefix):]
}

// streq returns true if two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
