package "main"

import "pkg/binate/buf"
import "pkg/binate/lint"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Tests for the formatting + utility helpers in main_util.bn (formatDiag,
// stripPrefix, quotePath, streq, appendStr/appendMsg).  Shared findRoot helper
// lives in main_test.bn.

func TestFormatDiag() testing.TestResult {
	var d lint.Diagnostic
	d.Pos.File = "pkg/foo/bar.bn"
	d.Pos.Line = 42
	d.Pos.Col = 10
	d.Rule = "test-rule"
	d.Message = "something bad"
	var msg @[]readonly char = formatDiag("pkg/foo", d, "")
	var expected *[]readonly char = "pkg/foo/bar.bn:42:10: [test-rule] something bad"
	if !streq(msg, expected) {
		var cb @strings.Builder = strings.NewBuilder()
		cb.Write("expected '")
		cb.Write(expected)
		cb.Write("', got '")
		cb.Write(msg)
		cb.WriteByte('\'')
		return buf.CopyStr(cb.String())
	}
	return ""
}

func TestFormatDiagFallback() testing.TestResult {
	// When Pos.File is empty, falls back to pkgPath
	var d lint.Diagnostic
	d.Rule = "r"
	d.Message = "m"
	var msg @[]readonly char = formatDiag("pkg/x", d, "")
	if !streq(msg, "pkg/x:0:0: [r] m") {
		return buf.Concat("unexpected: ", msg)
	}
	return ""
}

func TestFormatDiagUsesFile() testing.TestResult {
	// When Pos.File is set, uses it instead of pkgPath
	var d lint.Diagnostic
	d.Pos.File = "src/thing.bn"
	d.Pos.Line = 5
	d.Pos.Col = 3
	d.Rule = "r"
	d.Message = "m"
	var msg @[]readonly char = formatDiag("pkg/x", d, "")
	if !streq(msg, "src/thing.bn:5:3: [r] m") {
		return buf.Concat("unexpected: ", msg)
	}
	return ""
}

func TestFormatDiagStripsRoot() testing.TestResult {
	var d lint.Diagnostic
	d.Pos.File = "/home/user/proj/pkg/foo/bar.bn"
	d.Pos.Line = 10
	d.Pos.Col = 5
	d.Rule = "r"
	d.Message = "m"
	var msg @[]readonly char = formatDiag("pkg/foo", d, "/home/user/proj/")
	if !streq(msg, "pkg/foo/bar.bn:10:5: [r] m") {
		return buf.Concat("unexpected: ", msg)
	}
	return ""
}

// ============================================================
// stripPrefix tests
// ============================================================

func TestStripPrefix() testing.TestResult {
	var result *[]readonly char = stripPrefix("/a/b/c.bn", "/a/b/")
	if !streq(result, "c.bn") { return buf.Concat("unexpected: ", result) }
	return ""
}

func TestStripPrefixNoMatch() testing.TestResult {
	var result *[]readonly char = stripPrefix("other/path.bn", "/a/b/")
	if !streq(result, "other/path.bn") { return buf.Concat("unexpected: ", result) }
	return ""
}

func TestStripPrefixEmpty() testing.TestResult {
	var result *[]readonly char = stripPrefix("path.bn", "")
	if !streq(result, "path.bn") { return buf.Concat("unexpected: ", result) }
	return ""
}

// ============================================================
// quotePath tests
// ============================================================

func TestQuotePath() testing.TestResult {
	var q @[]char = quotePath("pkg/foo")
	if !streq(q, "\"pkg/foo\"") {
		return buf.Concat("unexpected: ", q)
	}
	return ""
}

func TestQuotePathEmpty() testing.TestResult {
	var q @[]char = quotePath("")
	if !streq(q, "\"\"") {
		return buf.Concat("unexpected: ", q)
	}
	return ""
}

// ============================================================
// streq tests
// ============================================================

func TestStreqEqual() testing.TestResult {
	if !streq("hello", "hello") { return "equal strings should match" }
	return ""
}

func TestStreqDifferent() testing.TestResult {
	if streq("hello", "world") { return "different strings should not match" }
	return ""
}

func TestStreqDifferentLen() testing.TestResult {
	if streq("hi", "hello") { return "different length strings should not match" }
	return ""
}

func TestStreqEmpty() testing.TestResult {
	if !streq("", "") { return "empty strings should match" }
	return ""
}

// ============================================================
// appendStr / appendMsg tests
// ============================================================

func TestAppendStr() testing.TestResult {
	var s @[]@[]char
	s = appendStr(s, "a")
	s = appendStr(s, "b")
	if len(s) != 2 { return "expected len 2" }
	if !streq(s[0], "a") { return "wrong [0]" }
	if !streq(s[1], "b") { return "wrong [1]" }
	return ""
}

func TestAppendMsgGrowth() testing.TestResult {
	var s @[]@[]readonly char = make_slice(@[]readonly char, 2)
	var n int = 0
	s = appendMsg(s, n, "a")
	n = n + 1
	s = appendMsg(s, n, "b")
	n = n + 1
	// Should trigger growth
	s = appendMsg(s, n, "c")
	n = n + 1
	if n != 3 { return "expected 3 items" }
	if !streq(s[0], "a") { return "wrong [0]" }
	if !streq(s[1], "b") { return "wrong [1]" }
	if !streq(s[2], "c") { return "wrong [2]" }
	return ""
}

