package "main"

import "pkg/binate/buf"

// Lint suppression directives.
//
// A `// bnlint:allow <rulespec>` comment tells bnlint to drop a rule's finding.
// `<rulespec>` is a comma-separated list of rule names, or `*` for every rule;
// at least one is required (a bare `// bnlint:allow` is rejected — see the
// bnlint-allow diagnostic in lintPackages).  Placement is inferred:
//   - OWN-LINE (only whitespace before the `//`): suppresses the FOLLOWING line.
//   - TRAILING (code before the `//`): suppresses the SAME line.
// This lives in the driver, not pkg/binate/lint, because directives are a
// source-text concern — the lint library stays AST-only.

// suppression allows `Rule` (or "*") on line `Line` (1-based) of file `File`.
type suppression struct {
	File @[]char
	Line int
	Rule @[]char
}

// malformedDir is a `bnlint:allow` directive with no rulespec, at (File, Line,
// Col) — reported as a lint error so a bare/typo'd directive can't silently
// suppress nothing.
type malformedDir struct {
	File @[]char
	Line int
	Col  int
}

// suppressSet accumulates the directives parsed from every scanned source file.
type suppressSet struct {
	Sups  @[]suppression
	NSups int
	Bad   @[]malformedDir
	NBad  int
	Seen  @[]@[]char
	NSeen int
}

// newSuppressSet returns an empty directive set.
func newSuppressSet() @suppressSet {
	var s @suppressSet = make(suppressSet)
	s.Sups = make_slice(suppression, 8)
	s.Bad = make_slice(malformedDir, 4)
	s.Seen = make_slice(@[]char, 8)
	return s
}

// isSpace reports whether c is an in-line whitespace byte.
func isSpace(c uint8) bool {
	return c == cast(uint8, ' ') || c == cast(uint8, '\t') || c == cast(uint8, '\r')
}

// isRuleChar reports whether c may appear in a rulespec run (rule-name chars,
// `*` for all-rules, and `,` as the list separator).
func isRuleChar(c uint8) bool {
	if c >= cast(uint8, 'a') && c <= cast(uint8, 'z') { return true }
	if c >= cast(uint8, 'A') && c <= cast(uint8, 'Z') { return true }
	if c >= cast(uint8, '0') && c <= cast(uint8, '9') { return true }
	return c == cast(uint8, '-') || c == cast(uint8, '_') || c == cast(uint8, '*') ||
			c == cast(uint8, ',')
}

// litMatch reports whether src[p:] begins with the literal `lit` (within end).
func litMatch(src *[]readonly uint8, p int, end int, lit *[]readonly char) bool {
	if p + len(lit) > end { return false }
	for k := 0; k < len(lit); k++ {
		if src[p + k] != cast(uint8, lit[k]) { return false }
	}
	return true
}

// findLineComment returns the index of the `//` that starts a line comment in
// src[start:end), skipping `//` that appears inside a "…" or '…' literal, or -1.
func findLineComment(src *[]readonly uint8, start int, end int) int {
	var inStr bool = false
	var inChar bool = false
	var i int = start
	for i < end {
		var c uint8 = src[i]
		if inStr {
			if c == cast(uint8, '\\') { i = i + 2; continue }
			if c == cast(uint8, '"') { inStr = false }
			i = i + 1
			continue
		}
		if inChar {
			if c == cast(uint8, '\\') { i = i + 2; continue }
			if c == cast(uint8, '\'') { inChar = false }
			i = i + 1
			continue
		}
		if c == cast(uint8, '"') { inStr = true; i = i + 1; continue }
		if c == cast(uint8, '\'') { inChar = true; i = i + 1; continue }
		if c == cast(uint8, '/') && i + 1 < end && src[i + 1] == cast(uint8, '/') {
			return i
		}
		i = i + 1
	}
	return -1
}

// onlyWsBefore reports whether src[start:ci) is entirely whitespace.
func onlyWsBefore(src *[]readonly uint8, start int, ci int) bool {
	for i := start; i < ci; i++ {
		if !isSpace(src[i]) { return false }
	}
	return true
}

// skipSpaces advances p past in-line whitespace, bounded by end.
func skipSpaces(src *[]readonly uint8, p int, end int) int {
	for p < end && isSpace(src[p]) { p = p + 1 }
	return p
}

// sliceToChars copies src[a:b) into a fresh @[]char.
func sliceToChars(src *[]readonly uint8, a int, b int) @[]char {
	var out @[]char = make_slice(char, b - a)
	for k := 0; k < b - a; k++ {
		out[k] = cast(char, src[a + k])
	}
	return out
}

// addSuppression records that `rule` is allowed on `line` of `file`.
func addSuppression(set @suppressSet, file @[]char, line int, rule @[]char) {
	if set.NSups >= len(set.Sups) {
		var n @[]suppression = make_slice(suppression, len(set.Sups) * 2)
		for i := 0; i < set.NSups; i++ { n[i] = set.Sups[i] }
		set.Sups = n
	}
	var s suppression
	s.File = file
	s.Line = line
	s.Rule = rule
	set.Sups[set.NSups] = s
	set.NSups = set.NSups + 1
}

// addMalformed records a rulespec-less `bnlint:allow` at (file, line, col).
func addMalformed(set @suppressSet, file @[]char, line int, col int) {
	if set.NBad >= len(set.Bad) {
		var n @[]malformedDir = make_slice(malformedDir, len(set.Bad) * 2)
		for i := 0; i < set.NBad; i++ { n[i] = set.Bad[i] }
		set.Bad = n
	}
	var m malformedDir
	m.File = file
	m.Line = line
	m.Col = col
	set.Bad[set.NBad] = m
	set.NBad = set.NBad + 1
}

// wasScanned reports whether `path` has already been fed to scanFileInto (so a
// file listed twice isn't double-counted).
func wasScanned(set @suppressSet, path *[]readonly char) bool {
	for i := 0; i < set.NSeen; i++ {
		if streq(set.Seen[i], path) { return true }
	}
	return false
}

// markScanned records that `path` has been scanned.
func markScanned(set @suppressSet, path @[]char) {
	if set.NSeen >= len(set.Seen) {
		var n @[]@[]char = make_slice(@[]char, len(set.Seen) * 2)
		for i := 0; i < set.NSeen; i++ { n[i] = set.Seen[i] }
		set.Seen = n
	}
	set.Seen[set.NSeen] = path
	set.NSeen = set.NSeen + 1
}

// scanOneLine parses a directive in src[start:end) (the 1-based lineNo'th line
// of `path`) and records any suppression / malformed marker into `set`.
func scanOneLine(set @suppressSet, path @[]char, lineNo int, src *[]readonly uint8, start int,
		end int) {
	var ci int = findLineComment(src, start, end)
	if ci < 0 { return }
	var p int = ci + 2
	p = skipSpaces(src, p, end)
	if !litMatch(src, p, end, "bnlint:allow") { return }
	p = p + 12 // len("bnlint:allow")
	// The keyword must be delimited (reject e.g. "bnlint:allowlist").
	if p < end && !isSpace(src[p]) { return }
	p = skipSpaces(src, p, end)

	// OWN-LINE directive suppresses the following line; a trailing one the same.
	var target int = lineNo
	if onlyWsBefore(src, start, ci) { target = lineNo + 1 }

	// The rulespec is the leading run of rule-name / `,` / `*` bytes.
	var rs int = p
	var re int = p
	for re < end && isRuleChar(src[re]) { re = re + 1 }
	if re == rs {
		addMalformed(set, path, lineNo, ci - start + 1)
		return
	}
	// Split the run on commas into individual rules.
	var added bool = false
	var ts int = rs
	for k := rs; k <= re; k++ {
		if k == re || src[k] == cast(uint8, ',') {
			if k > ts {
				addSuppression(set, path, target, sliceToChars(src, ts, k))
				added = true
			}
			ts = k + 1
		}
	}
	if !added {
		// The run was only commas ("bnlint:allow ,,") — no real rule.
		addMalformed(set, path, lineNo, ci - start + 1)
	}
}

// scanFileInto parses every directive in `src` (the bytes of `path`) into `set`.
func scanFileInto(set @suppressSet, path *[]readonly char, src *[]readonly uint8) {
	if wasScanned(set, path) { return }
	var owned @[]char = buf.CopyStr(path)
	markScanned(set, owned)
	var lineNo int = 1
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == cast(uint8, '\n') {
			scanOneLine(set, owned, lineNo, src, start, i)
			lineNo = lineNo + 1
			start = i + 1
		}
	}
}

// isSuppressed reports whether a finding for `rule` at (file, line) is covered
// by a directive (an exact rule match or a `*` wildcard on that line).
func isSuppressed(set @suppressSet, file *[]readonly char, line int, rule *[]readonly char) bool {
	for i := 0; i < set.NSups; i++ {
		var s suppression = set.Sups[i]
		if s.Line != line { continue }
		if !streq(s.File, file) { continue }
		if streq(s.Rule, "*") || streq(s.Rule, rule) { return true }
	}
	return false
}
