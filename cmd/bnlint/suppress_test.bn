package "main"

import "pkg/builtins/testing"

// bytesOf copies a string literal into a fresh @[]uint8 for the scanner.
func bytesOf(s *[]readonly char) @[]uint8 {
	var out @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ { out[i] = cast(uint8, s[i]) }
	return out
}

// A TRAILING directive (code before the //) suppresses its own line only.
func TestSuppressSameLine() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "f.bn", bytesOf("var x = y  // bnlint:allow managed-to-raw-assign - ok\n"))
	if !isSuppressed(set, "f.bn", 1, "managed-to-raw-assign") {
		return "same-line: line 1 should be suppressed"
	}
	if isSuppressed(set, "f.bn", 2, "managed-to-raw-assign") {
		return "same-line must not leak to line 2"
	}
	if isSuppressed(set, "f.bn", 1, "other-rule") {
		return "a different rule must not match"
	}
	if set.NBad != 0 { return "no malformed expected" }
	return ""
}

// An OWN-LINE directive (only whitespace before the //) suppresses the NEXT line.
func TestSuppressOwnLine() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "f.bn", bytesOf("  // bnlint:allow unused-import\nimport \"x\"\n"))
	if !isSuppressed(set, "f.bn", 2, "unused-import") {
		return "own-line: the following line (2) should be suppressed"
	}
	if isSuppressed(set, "f.bn", 1, "unused-import") {
		return "own-line: the directive line itself must not be suppressed"
	}
	return ""
}

// A comma list allows several rules; `*` allows any rule.
func TestSuppressListAndWildcard() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "f.bn", bytesOf("a = b  // bnlint:allow r1,r2\nc = d  // bnlint:allow *\n"))
	if !isSuppressed(set, "f.bn", 1, "r1") { return "r1 should match" }
	if !isSuppressed(set, "f.bn", 1, "r2") { return "r2 should match" }
	if isSuppressed(set, "f.bn", 1, "r3") { return "r3 is not listed" }
	if !isSuppressed(set, "f.bn", 2, "anything") {
		return "* should match any rule"
	}
	return ""
}

// A rulespec-less directive is a malformed error and suppresses nothing.
func TestSuppressMalformedNoRule() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "f.bn", bytesOf("x = y  // bnlint:allow\n"))
	if set.NBad != 1 { return "a rulespec-less directive must be malformed" }
	if set.NSups != 0 { return "malformed directive must add no suppression" }
	return ""
}

// A // inside a string literal is not a directive.
func TestSuppressIgnoresStringSlashes() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "f.bn", bytesOf("var s = \"// bnlint:allow foo\"\n"))
	if set.NSups != 0 { return "a // inside a string is not a directive" }
	if set.NBad != 0 { return "no malformed for an in-string //" }
	return ""
}

// A directive in one file must not suppress findings in another.
func TestSuppressFileIsolation() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "a.bn", bytesOf("x = y  // bnlint:allow r1\n"))
	if isSuppressed(set, "b.bn", 1, "r1") {
		return "a directive in a.bn must not suppress in b.bn"
	}
	return ""
}

// The keyword must be delimited: `bnlint:allowlist` is not the directive.
func TestSuppressRejectsGluedKeyword() testing.TestResult {
	var set @suppressSet = newSuppressSet()
	scanFileInto(set, "f.bn", bytesOf("x = y  // bnlint:allowlist r1\n"))
	if set.NSups != 0 || set.NBad != 0 {
		return "bnlint:allowlist must not be treated as the directive"
	}
	return ""
}
