package "main"

import "pkg/binate/buf"
import "pkg/binate/types"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// errorHas reports whether text contains sub.
func errorHas(text *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(text); i++ {
		if streq(text[i:i + len(sub)], sub) { return true }
	}
	return false
}

// bnlint checks a package as the --target lays it out, whatever host it runs on: the
// fixture's 2^31-byte type fits x86_64-linux and is too large for arm32-linux.
func TestLintPackagesTargetLayout() testing.TestResult {
	var saved types.TargetInfo = types.GetTarget()
	defer { types.SetTarget(saved) }
	var pkgs @[]@[]char = @[]@[]char{"cmd/bnlint/testdata/target_layout"}
	var emptyPaths @[]@[]char
	var wide LintResult = lintPackages(".", pkgs, langBniPaths(), langImplPaths(), "x86_64-linux",
			false, emptyPaths)
	if len(wide.Error) > 0 { return buf.Concat("x86_64-linux: ", wide.Error) }
	if wide.Messages.Len() != 0 {
		return buf.Concat("x86_64-linux: expected 0 diags, got ", strconv.Itoa(wide.Messages.Len()))
	}
	var narrow LintResult = lintPackages(".", pkgs, langBniPaths(), langImplPaths(), "arm32-linux",
			false, emptyPaths)
	if !errorHas(narrow.Error, "type is too large") {
		return buf.Concat("arm32-linux: expected Big to be too large; got: ", narrow.Error)
	}
	return ""
}
