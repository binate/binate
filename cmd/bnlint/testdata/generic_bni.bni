package "cmd/bnlint/testdata/generic_bni"

// All-`.bni` (all-generic) library fixture, loaded ONLY by cmd/bnlint's own
// tests (TestLintPackagesAllBniGeneric).  The generic bodies live in this
// `.bni` and there is NO `.bn` impl, so the whole package IS its exported
// interface.  Every function here is public API and must NOT be flagged
// unused-func.
//
// Regression fixture for the loader bug where an all-`.bni` package skipped
// markBniExportedFuncs (the merge overlay that sets Exported is guarded on a
// `.bn` impl being present), leaving its exported funcs marked unexported —
// so unused-func treated the public API as dead code.  Tooling (hygiene, the
// unit-test runner) ignores `testdata/`, so this fixture never reaches them.

func Identity[T any](x T) T { return x }

func Pick[T any](a T, b T) T { return a }
