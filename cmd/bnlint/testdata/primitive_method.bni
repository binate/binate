package "cmd/bnlint/testdata/primitive_method"

// A fixture loaded only by cmd/bnlint's own tests (TestLintPackagesPrimitiveMethod):
// its .bn calls a primitive's method without importing pkg/builtins/lang
// (pkg0.lang.force-load), which bnlint must accept as bnc and bni do.

// Name returns x's decimal text.
func Name(x int) @[]char
