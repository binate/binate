package "cmd/bnlint/testdata/target_layout"

// A fixture loaded only by cmd/bnlint's own tests (TestLintPackagesTargetLayout):
// Big's 2^31 bytes are too large for a 32-bit target and fit a 64-bit one, so a lint
// for each --target checks the package as that target lays it out.  Its length and
// its element's fit a 32-bit int: only its size does not.

// Half is 2^30 bytes.
type Half [0x40000000]uint8

// Big is 2^31 bytes.
type Big [2]Half

// Size returns Big's size.
func Size() uint
