package "cmd/bnlint/testdata/tests_flag"

// This directory is a bnlint testdata fixture, loaded ONLY by cmd/bnlint's
// own tests (TestLintPackagesTestsFlag).  It is a package whose _test.bn
// carries a deliberate lint finding, used to prove that `bnlint --tests`
// lints test files while a plain run does not.  Tooling (the hygiene checks
// and the unit-test runner) ignores `testdata/` directories, so this
// intentionally-dirty package never reaches them.
//
// This primary file is finding-free — `main` is a reachability root, so it
// is not flagged unused-func — giving a clean baseline for the --tests-off
// assertion (a plain run of this package yields zero diagnostics).
func main() {}
