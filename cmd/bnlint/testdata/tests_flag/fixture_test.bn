package "cmd/bnlint/testdata/tests_flag"

// unusedHelper is never called from any Test/main reachability root, so
// bnlint reports it as unused-func — but ONLY when --tests loads this
// _test.bn.  It is the observable that TestLintPackagesTestsFlag asserts on:
// present with --tests, absent without.
func unusedHelper() int { return 0 }

// suppressedHelper is likewise dead, but the preceding-line directive
// suppresses its finding — so the test can also confirm that
// `// bnlint:allow` works under --tests (the package yields exactly one
// diagnostic, not two).
// bnlint:allow unused-func
func suppressedHelper() int { return 0 }
