package "main"

import "pkg/builtins/testing"

func main() {
	x := 10
	if x > 5 {
		testing.Println("greater")
	} else {
		testing.Println("not greater")
	}
	if x == 0 {
		testing.Println("zero")
	} else if x == 10 {
		testing.Println("ten")
	} else {
		testing.Println("other")
	}
	if false {
		testing.Println("bad")
	} else {
		testing.Println("good")
	}
}
