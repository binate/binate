package "main"

import "pkg/builtins/testing"

func double(n int) int {
	return n * 2
}

func fib(n int) int {
	if n <= 1 {
		return n
	}
	return fib(n - 1) + fib(n - 2)
}

func add(a int, b int) int {
	return a + b
}

func main() {
	testing.Println(double(7))
	testing.Println(add(3, 4))
	testing.Println(fib(10))
}
