package "main"

import "pkg/builtins/testing"

func main() {
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	testing.Println(len(s))
	testing.Println(s[0])
	testing.Println(s[2])

	// Managed slice with 4 elements
	var t @[]int = make_slice(int, 4)
	t[0] = 10
	t[1] = 20
	t[2] = 30
	t[3] = 40
	testing.Println(len(t))
	testing.Println(t[3])

	// Single-element managed slice
	var u @[]int = make_slice(int, 1)
	u[0] = 99
	testing.Println(len(u))
	testing.Println(u[0])
}
