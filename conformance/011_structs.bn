package "main"

import "pkg/builtins/testing"

type Point struct {
	x int
	y int
}

type Rect struct {
	min Point
	max Point
}

func main() {
	p := Point{x: 3, y: 4}
	testing.Println(p.x)
	testing.Println(p.y)
	p.x = 10
	testing.Println(p.x)

	r := Rect{
			min: Point{x: 1, y: 2}, max: Point{x: 4, y: 6}}
	testing.Println((r.max.x - r.min.x) * (r.max.y - r.min.y))
}
