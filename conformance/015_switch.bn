package "main"

import "pkg/builtins/testing"

func describe(n int) *[]readonly char {
	switch n {
	case 1:
		return "one"
	case 2:
		return "two"
	case 3:
		return "three"
	default:
		return "other"
	}
}

func main() {
	testing.Println(describe(1))
	testing.Println(describe(2))
	testing.Println(describe(3))
	testing.Println(describe(99))
}
