package "main"

import "pkg/builtins/testing"

func main() {
	// Nil slice has len 0
	var s *[]int
	testing.Println(len(s))

	// make_slice with 1 element
	var t @[]int = make_slice(int, 1)
	t[0] = 42
	testing.Println(len(t))
	testing.Println(t[0])

	// make_slice with 2 elements
	var u @[]int = make_slice(int, 2)
	u[0] = 42
	u[1] = 99
	testing.Println(len(u))
	testing.Println(u[1])
}
