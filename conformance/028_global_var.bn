package "main"

import "pkg/builtins/testing"

var counter int = 0

func increment() {
	counter = counter + 1
}

func getCounter() int {
	return counter
}

func main() {
	testing.Println(counter)
	increment()
	increment()
	increment()
	testing.Println(getCounter())
	counter = 100
	testing.Println(counter)
}
