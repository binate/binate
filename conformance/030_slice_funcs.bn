package "main"

import "pkg/builtins/testing"

func sum(s *[]int) int {
	total := 0
	for v in s {
		total = total + v
	}
	return total
}

func maxVal(s *[]int) int {
	m := s[0]
	for i := 1; i < len(s); i++ {
		if s[i] > m {
			m = s[i]
		}
	}
	return m
}

func main() {
	var arr [3]int = [3]int{10, 20, 30}
	testing.Println(sum(arr[:]))
	testing.Println(maxVal(arr[:]))

	var arr2 [5]int = [5]int{10, 20, 30, 5, 50}
	testing.Println(sum(arr2[:]))
	testing.Println(maxVal(arr2[:]))
}
