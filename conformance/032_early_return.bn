package "main"

import "pkg/builtins/testing"

func findFirst(s *[]int, target int) int {
	for i := 0; i < len(s); i++ {
		if s[i] == target {
			return i
		}
	}
	return -1
}

func isEven(n int) bool {
	if n % 2 == 0 {
		return true
	}
	return false
}

func main() {
	var arr [4]int = [4]int{10, 20, 30, 40}
	testing.Println(findFirst(arr[:], 30))
	testing.Println(findFirst(arr[:], 99))
	testing.Println(isEven(4))
	testing.Println(isEven(7))
}
