package "main"

import "pkg/builtins/testing"

func main() {
	// Short-circuit: second operand should not matter when first decides
	x := 5
	if x > 0 && x < 10 {
		testing.Println(1)
	}
	if x > 10 || x == 5 {
		testing.Println(2)
	}
	if !(x == 3) {
		testing.Println(3)
	}

	// Complex boolean expressions
	a := true
	b := false
	if a && !b {
		testing.Println(4)
	}
	if !a || b {
		testing.Println(999)
	} else {
		testing.Println(5)
	}
}
