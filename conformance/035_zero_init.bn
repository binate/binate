package "main"

import "pkg/builtins/testing"

type Point struct {
	x int
	y int
}

func main() {
	// Zero-init struct
	p := Point{}
	testing.Println(p.x)
	testing.Println(p.y)

	// Partial init
	q := Point{x: 42}
	testing.Println(q.x)
	testing.Println(q.y)

	// Zero-init array
	var arr [3]int = [3]int{}
	testing.Println(arr[0])
	testing.Println(arr[1])
	testing.Println(arr[2])
}
