package "main"

import "pkg/builtins/testing"

func double(x int) int {
	return x * 2
}

func add(a int, b int) int {
	return a + b
}

func square(x int) int {
	return x * x
}

func main() {
	testing.Println(double(double(3)))
	testing.Println(add(double(5), double(3)))
	testing.Println(square(add(1, 2)))
	testing.Println(add(add(1, 2), add(3, 4)))
}
