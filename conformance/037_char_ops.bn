package "main"

import "pkg/builtins/testing"

func isUpper(c char) bool {
	return c >= 'A' && c <= 'Z'
}

func toLower(c char) char {
	if isUpper(c) {
		return cast(char, cast(int, c) + 32)
	}
	return c
}

func main() {
	testing.Println(isUpper('A'))
	testing.Println(isUpper('z'))
	testing.Println(cast(int, toLower('H')))
	testing.Println(cast(int, toLower('x')))

	var s *[]readonly char = "Hello"
	testing.Println(cast(int, s[0]))
	testing.Println(cast(int, toLower(s[0])))
}
