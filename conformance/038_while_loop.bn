package "main"

import "pkg/builtins/testing"

func gcd(a int, b int) int {
	for b != 0 {
		t := b
		b = a % b
		a = t
	}
	return a
}

func main() {
	testing.Println(gcd(48, 18))
	testing.Println(gcd(100, 75))
	testing.Println(gcd(17, 13))

	// Infinite loop with break
	n := 1
	for {
		n = n * 2
		if n > 1000 {
			break
		}
	}
	testing.Println(n)
}
