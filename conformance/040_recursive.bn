package "main"

import "pkg/builtins/testing"

func factorial(n int) int {
	if n <= 1 {
		return 1
	}
	return n * factorial(n - 1)
}

func power(base int, exp int) int {
	if exp == 0 {
		return 1
	}
	return base * power(base, exp - 1)
}

func main() {
	testing.Println(factorial(5))
	testing.Println(factorial(10))
	testing.Println(power(2, 10))
	testing.Println(power(3, 4))
}
