package "main"

import "pkg/builtins/testing"

func main() {
	// Nil slice has len 0
	var s *[]int
	testing.Println(len(s))

	// Managed slice with 3 elements
	var ms @[]int = make_slice(int, 3)
	ms[0] = 10
	ms[1] = 20
	ms[2] = 30
	testing.Println(len(ms))
	testing.Println(ms[0])
	testing.Println(ms[1])
	testing.Println(ms[2])

	// Nil char slice has len 0
	var c *[]char
	testing.Println(len(c))

	// Managed char slice with 2 elements
	var mc @[]char = make_slice(char, 2)
	mc[0] = 'a'
	mc[1] = 'b'
	testing.Println(len(mc))
}
