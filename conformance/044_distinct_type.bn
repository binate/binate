package "main"

import "pkg/builtins/testing"

type Celsius int

type Meters int

func toFahrenheit(c Celsius) int {
	return cast(int, c) * 9 / 5 + 32
}

func main() {
	var temp Celsius = 100
	testing.Println(toFahrenheit(temp))

	var dist Meters = 42
	testing.Println(cast(int, dist))

	// Arithmetic on distinct types
	var a Celsius = 10
	var b Celsius = 20
	var c Celsius = a + b
	testing.Println(cast(int, c))
}
