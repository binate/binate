package "main"

import "pkg/builtins/testing"

func greet(name *[]readonly char) *[]readonly char {
	return name
}

func strLen(s *[]readonly char) int {
	return len(s)
}

func main() {
	var name *[]readonly char = "world"
	testing.Println(greet(name))
	testing.Println(strLen(name))
	testing.Println(strLen("hello"))

	// Char arithmetic
	var ch char = 'A'
	var next char = ch + 1
	testing.Println(cast(int, next))

	// Char comparison
	if ch < 'Z' {
		testing.Println(true)
	}
}
