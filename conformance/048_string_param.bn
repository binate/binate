package "main"

func greet(name *[]const char) *[]const char {
	return name
}

func strLen(s *[]const char) int {
	return len(s)
}

func main() {
	var name *[]const char = "world"
	println(greet(name))
	println(strLen(name))
	println(strLen("hello"))

	// Char arithmetic
	var ch char = 'A'
	var next char = ch + 1
	println(cast(int, next))

	// Char comparison
	if ch < 'Z' {
		println(true)
	}
}
