package "main"

import "pkg/builtins/testing"

type Buffer struct {
	data *[]int
	name *[]readonly char
}

func main() {
	var b Buffer
	b.name = "test"
	// The backing must be OWNED by a managed var so the raw `data` field, which
	// only borrows it, stays valid past this statement — otherwise the make_slice
	// temp is freed here and `b.data` dangles (a later allocation reuses it).
	var backing @[]int = make_slice(int, 3)
	b.data = backing
	b.data[0] = 1
	b.data[1] = 2
	b.data[2] = 3
	testing.Println(len(b.data))
	testing.Println(b.data[0])
	testing.Println(b.data[2])
	testing.Println(b.name)
}
