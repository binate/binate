package "main"

import "pkg/builtins/testing"

type Buffer struct {
	data *[]int
	name *[]readonly char
}

func main() {
	var b Buffer
	b.name = "test"
	b.data = make_slice(int, 3)
	b.data[0] = 1
	b.data[1] = 2
	b.data[2] = 3
	testing.Println(len(b.data))
	testing.Println(b.data[0])
	testing.Println(b.data[2])
	testing.Println(b.name)
}
