package "main"

import "pkg/builtins/testing"

func classify(n int) int {
	switch n {
	case 0:
		return -1
	case 1:
		return 0
	case 2:
		return 1
	}
	return 99
}

func findFirst(target int) int {
	for i := 0; i < 10; i++ {
		switch classify(i) {
		case 1:
			return i
		}
	}
	return -1
}

func main() {
	testing.Println(classify(0))
	testing.Println(classify(1))
	testing.Println(classify(2))
	testing.Println(classify(5))
	testing.Println(findFirst(1))
}
