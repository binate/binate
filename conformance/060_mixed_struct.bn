package "main"

import "pkg/builtins/testing"

type Mixed struct {
	A int8
	B int
	C int8
}

func main() {
	var m Mixed
	m.A = cast(int8, 10)
	m.B = 42
	m.C = cast(int8, 99)
	testing.Println(cast(int, m.A))
	testing.Println(m.B)
	testing.Println(cast(int, m.C))

	// Via managed pointer
	var p @Mixed = make(Mixed)
	p.A = cast(int8, 1)
	p.B = 200
	p.C = cast(int8, 3)
	testing.Println(cast(int, p.A))
	testing.Println(p.B)
	testing.Println(cast(int, p.C))
}
