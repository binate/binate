package "main"
import "pkg/builtins/testing"

import "pkg/geom"

func main() {
	// Create point via package function
	var p @geom.Point = geom.NewPoint(10, 20)
	testing.Println(geom.Sum(p))

	// Access fields
	testing.Println(p.X)
	testing.Println(p.Y)

	// Modify fields
	p.X = 100
	testing.Println(geom.Sum(p))

	// Constants
	testing.Println(geom.ORIGIN_X)
	testing.Println(geom.ORIGIN_Y)
}
