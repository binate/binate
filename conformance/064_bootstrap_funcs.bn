package "main"

import "pkg/bootstrap"
import "pkg/buf"

func main() {
	// Concat (now in pkg/buf since the bootstrap-era helper was retired)
	var s @[]char = buf.Concat("hello", " world")
	println(s)

	// Itoa
	var n @[]char = bootstrap.Itoa(42)
	println(n)

	// Itoa negative
	var neg @[]char = bootstrap.Itoa(-7)
	println(neg)

	// Concat with Itoa
	var msg @[]char = buf.Concat("value=", bootstrap.Itoa(100))
	println(msg)
}
