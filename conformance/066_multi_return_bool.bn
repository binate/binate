package "main"

import "pkg/builtins/testing"

// Test multi-return where one value is bool and another is int.
// Exercises correct type extraction from multi-return calls.

func lookup(name *[]readonly char) (int, bool) {
	if len(name) == 3 {
		return 42, true
	}
	return 0, false
}

func main() {
	val, found := lookup("abc")
	if found {
		testing.Print(val)
		testing.Println(" found")
	} else {
		testing.Println("not found")
	}

	val2, found2 := lookup("ab")
	if found2 {
		testing.Println("should not happen")
	} else {
		testing.Print(val2)
		testing.Println(" not found")
	}

	// Multi-return assign (not short var decl)
	var v int
	var f bool
	v, f = lookup("hi")
	if f {
		testing.Print(v)
		testing.Println(" found")
	} else {
		testing.Print(v)
		testing.Println(" not found")
	}
}
