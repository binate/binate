package "main"

import "pkg/builtins/testing"

func isEmptyOr(x *[]int) bool {
	var empty bool = len(x) == 0 || len(x) == 0
	return empty
}

func isNonZeroAnd(x *[]int) bool {
	var ok bool = len(x) > 0 && len(x) > 0
	return ok
}

func checkFirst(x *[]int) int {
	var empty bool = len(x) == 0 || len(x) == 0
	if empty {
		return -1
	}
	return x[0]
}

func main() {
	var empty *[]int
	testing.Println(isEmptyOr(empty))
	var arr [3]int = [3]int{10, 20, 30}
	var a *[]int = arr[:]
	testing.Println(isEmptyOr(a))
	testing.Println(isNonZeroAnd(empty))
	testing.Println(isNonZeroAnd(a))
	testing.Println(checkFirst(empty))
	testing.Println(checkFirst(a))
	testing.Println("done")
}
