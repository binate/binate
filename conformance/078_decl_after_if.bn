package "main"

import "pkg/builtins/testing"

// Regression: uninitialized slice declaration after an if statement caused
// subsequent code to be dropped (genStmt returned stale ctx.CurBlock).

func test1() {
	var x int = 1
	if x == 0 {
		testing.Println("zero")
	}
	var s @[]int = make_slice(int, 1)
	s[0] = 42
	testing.Println(len(s))
	testing.Println("test1 done")
}

func test2() {
	var x int = 5
	if x > 10 {
		testing.Println("big")
	}
	var a @[]int = make_slice(int, 1)
	var b @[]int = make_slice(int, 2)
	var c int = 99
	a[0] = 1
	b[0] = 2
	b[1] = 3
	testing.Println(len(a))
	testing.Println(len(b))
	testing.Println(c)
}

func main() {
	test1()
	test2()
	testing.Println("all done")
}
