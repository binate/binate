package "main"

import "pkg/builtins/testing"

// Regression: assigning a string literal to an existing *[]readonly char variable
// stored the raw pointer without converting to a slice, corrupting the length.

func pick(n int) *[]readonly char {
	var s *[]readonly char
	if n == 0 {
		s = "zero"
	} else if n == 1 {
		s = "one"
	} else {
		s = "other"
	}
	return s
}

func main() {
	testing.Println(pick(0))
	testing.Println(pick(1))
	testing.Println(pick(2))
	testing.Println(len(pick(0)))
	testing.Println(len(pick(1)))
	testing.Println(len(pick(2)))
	testing.Println("done")
}
