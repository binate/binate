package "main"

import "pkg/builtins/testing"

type Node struct {
	Value int
}

func pick(n int) @Node {
	var result @Node
	if n > 0 {
		result = make(Node)
		result.Value = n
	}
	return result
}

func main() {
	var a @Node = pick(0)
	if a == nil {
		testing.Println("nil")
	} else {
		testing.Println(a.Value)
	}
	var b @Node = pick(42)
	if b == nil {
		testing.Println("nil")
	} else {
		testing.Println(b.Value)
	}
	testing.Println("done")
}
