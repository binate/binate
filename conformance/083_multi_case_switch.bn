package "main"

import "pkg/builtins/testing"

func classify(n int) *[]readonly char {
	switch n {
	case 1, 2, 3:
		return "low"
	case 4, 5:
		return "mid"
	case 10:
		return "ten"
	default:
		return "other"
	}
}

func main() {
	testing.Println(classify(1))
	testing.Println(classify(2))
	testing.Println(classify(3))
	testing.Println(classify(4))
	testing.Println(classify(5))
	testing.Println(classify(10))
	testing.Println(classify(99))
}
