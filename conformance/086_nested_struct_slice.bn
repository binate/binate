package "main"

import "pkg/builtins/testing"

type Item struct {
	Name *[]readonly char
	Val  int
}

type Container struct {
	Items @[]Item
	Tag   *[]readonly char
}

func main() {
	var c Container
	c.Tag = "box"

	c.Items = make_slice(Item, 3)
	c.Items[0] = Item{"alpha", 10}
	c.Items[1] = Item{"beta", 20}
	c.Items[2] = Item{"gamma", 30}

	testing.Println(c.Tag)
	testing.Println(len(c.Items))

	// Read nested fields
	testing.Println(c.Items[0].Name)
	testing.Println(c.Items[0].Val)
	testing.Println(c.Items[1].Name)
	testing.Println(c.Items[2].Val)

	// Modify nested field in-place
	c.Items[1].Val = 200
	testing.Println(c.Items[1].Val)

	// Sum all values
	total := 0
	for i := 0; i < len(c.Items); i++ {
		total += c.Items[i].Val
	}
	testing.Println(total)
}
