package "main"

import "pkg/builtins/testing"

func printChars(s *[]readonly char) {
	for i := 0; i < len(s); i++ {
		testing.Println(cast(int, s[i]))
	}
}

func main() {
	// String literal to *[]readonly char
	var s *[]readonly char = "Hi"
	testing.Println(len(s))
	printChars(s)

	// Reassign string to *[]readonly char variable
	s = "AB"
	testing.Println(len(s))
	printChars(s)

	// Empty string
	var e *[]readonly char = ""
	testing.Println(len(e))

	// *[]readonly char from function return used as string
	testing.Println(s)
}
