package "main"

func printChars(s *[]const char) {
	for i := 0; i < len(s); i++ {
		println(cast(int, s[i]))
	}
}

func main() {
	// String literal to *[]const char
	var s *[]const char = "Hi"
	println(len(s))
	printChars(s)

	// Reassign string to *[]const char variable
	s = "AB"
	println(len(s))
	printChars(s)

	// Empty string
	var e *[]const char = ""
	println(len(e))

	// *[]const char from function return used as string
	println(s)
}
