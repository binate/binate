package "main"

import "pkg/builtins/testing"

func main() {
	// make_slice returns @[]T (managed-slice)
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	testing.Println(len(s))
	testing.Println(s[0])
	testing.Println(s[1])
	testing.Println(s[2])

	// Zero-initialized
	var z @[]int = make_slice(int, 2)
	testing.Println(z[0])
	testing.Println(z[1])
	testing.Println(len(z))

	// Char slice
	var c @[]char = make_slice(char, 4)
	c[0] = 'H'
	c[1] = 'i'
	c[2] = '!'
	c[3] = '\n'
	testing.Println(len(c))
}
