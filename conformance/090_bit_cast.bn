package "main"

import "pkg/builtins/testing"

func main() {
	// bit_cast: round-trip pointer through int
	var x int = 42
	var p *int = &x
	var addr int = bit_cast(int, p)
	testing.Println(addr != 0)

	// bit_cast: int → pointer (0 → nil)
	var zero int = 0
	var q *int = bit_cast(*int, zero)
	testing.Println(q == nil)
}
