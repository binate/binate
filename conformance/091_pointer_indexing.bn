package "main"

import "pkg/builtins/testing"

func main() {
	// Get a pointer to an array, index through the pointer
	var arr [4]int
	arr[0] = 10
	arr[1] = 20
	arr[2] = 30
	arr[3] = 99

	var p *int = &arr[0]
	testing.Println(p[0])
	testing.Println(p[1])
	testing.Println(p[2])

	// Write through pointer
	p[3] = 42
	testing.Println(arr[3])

	// Offset pointer and index
	var q *int = &arr[2]
	testing.Println(q[0])
	testing.Println(q[1])
}
