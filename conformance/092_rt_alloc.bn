package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

func main() {
	// Allocate 32 bytes (4 ints) via rt.Alloc
	var p *uint8 = rt.Alloc(32)

	// Cast to *int and write/read
	var ip *int = bit_cast(*int, p)
	ip[0] = 100
	ip[1] = 200
	ip[2] = 300
	ip[3] = 400
	testing.Println(ip[0])
	testing.Println(ip[1])
	testing.Println(ip[2])
	testing.Println(ip[3])

	// Verify refcount via headerPtr (header sits HEADER_WORDS
	// ints before the payload — 16 bytes on LP64, 8 bytes on
	// arm32 ILP32).
	var hp *int = bit_cast(*int, p)
	var addr int = bit_cast(int, hp)
	var haddr int = addr - 2 * cast(int, sizeof(int))
	var header *int = bit_cast(*int, haddr)
	testing.Println(header[0])

	// RefInc, then check
	rt.RefInc(p)
	testing.Println(header[0])

	// RefDec back to 1
	rt.RefDec(p, nil)
	testing.Println(header[0])

	// Free
	rt.Free(p)
}
