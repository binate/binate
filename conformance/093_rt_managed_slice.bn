package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

func main() {
	// Create a managed slice of 4 ints (sizeof(int) bytes each
	// — 8 on LP64, 4 on arm32 ILP32).
	var ms rt.ManagedSlice = rt.MakeManagedSlice(cast(int, sizeof(int)), 4)

	// Verify length
	testing.Println(ms.Len)

	// Verify data pointer is non-nil
	if ms.Data != nil {
		testing.Println(1)
	} else {
		testing.Println(0)
	}

	// Verify refptr equals data (fresh allocation)
	if ms.Data == ms.Refptr {
		testing.Println(1)
	} else {
		testing.Println(0)
	}

	// Verify backing_len equals len (fresh allocation)
	testing.Println(ms.BackingLen)

	// Write values through the data pointer
	var p *int = bit_cast(*int, ms.Data)
	p[0] = 10
	p[1] = 20
	p[2] = 30
	p[3] = 40

	// Read them back
	testing.Println(p[0])
	testing.Println(p[1])
	testing.Println(p[2])
	testing.Println(p[3])

	// Verify refcount is 1 (header sits HEADER_WORDS ints before
	// the payload — 16 bytes on LP64, 8 bytes on arm32 ILP32).
	var h *int = bit_cast(*int, ms.Refptr)
	var addr int = bit_cast(int, h)
	var headerAddr int = addr - 2 * cast(int, sizeof(int))
	var header *int = bit_cast(*int, headerAddr)
	testing.Println(header[0])

	// RefInc then verify refcount is 2
	rt.RefInc(ms.Refptr)
	testing.Println(header[0])

	// RefDec back to 1
	rt.RefDec(ms.Refptr, nil)
	testing.Println(header[0])

	// Zero-length slice
	var empty rt.ManagedSlice = rt.MakeManagedSlice(8, 0)
	testing.Println(empty.Len)
	testing.Println(empty.BackingLen)
	if empty.Data == nil {
		testing.Println(1)
	} else {
		testing.Println(0)
	}

	// Clean up
	rt.Free(ms.Refptr)
}
