package "main"

import "pkg/builtins/testing"

func main() {
	// Create a managed-slice
	var a @[]int = make_slice(int, 3)
	a[0] = 10
	a[1] = 20
	a[2] = 30

	// Assignment shares the backing data
	var b @[]int = a
	testing.Println(b[0])
	testing.Println(b[1])
	testing.Println(b[2])

	// Mutation through b is visible through a
	b[1] = 99
	testing.Println(a[1])

	// Length is shared
	testing.Println(len(a))
	testing.Println(len(b))

	// Reassignment of b doesn't affect a
	b = make_slice(int, 2)
	b[0] = 77
	testing.Println(a[0])
	testing.Println(a[1])
	testing.Println(len(a))
	testing.Println(b[0])
	testing.Println(len(b))
}
