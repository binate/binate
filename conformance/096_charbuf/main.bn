package "main"

import "pkg/buf"

func main() {
	// Basic usage
	var b buf.CharBuf = buf.New()
	b = b.WriteByte('H')
	b = b.WriteByte('i')
	println(b.Len())
	println(b.Bytes())

	// WriteStr
	var b2 buf.CharBuf = buf.New()
	b2 = b2.WriteStr("hello")
	b2 = b2.WriteByte(' ')
	b2 = b2.WriteStr("world")
	println(b2.Bytes())

	// WriteInt
	var b3 buf.CharBuf = buf.New()
	b3 = b3.WriteInt(42)
	b3 = b3.WriteByte(',')
	b3 = b3.WriteInt(-7)
	b3 = b3.WriteByte(',')
	b3 = b3.WriteInt(0)
	println(b3.Bytes())

	// Growth: write more than initial capacity (64)
	var b4 buf.CharBuf = buf.New()
	for i := 0; i < 100; i++ {
		b4 = b4.WriteByte('x')
	}
	println(b4.Len())
}
