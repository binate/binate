package "main"

import "pkg/builtins/testing"

// Test for-in loop over managed slice (@[]T).
// slice_len and slice_get both convert the same managed slice, so an
// emitManagedToRaw that reuses one SSA name emits duplicate definitions.

func main() {
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30

	// for-value
	var total int = 0
	for v in s {
		total = total + v
	}
	testing.Println(total)

	// for-index-value
	for i, v in s {
		testing.Println(i, v)
	}
}
