package "main"

import "pkg/builtins/testing"

// Test @[]T → *[]T conversion when assigning make_slice result to a
// raw slice struct field. Regression: managed slice (24 bytes) was
// stored into raw slice field (16 bytes), corrupting adjacent fields.

type Container struct {
	Data *[]int
	Name *[]readonly char
}

func main() {
	var c Container
	c.Name = "hello"
	// Own the backing in a managed var so the raw `Data` field (a borrow) stays
	// valid past this statement — the make_slice temp would otherwise be freed here.
	var backing @[]int = make_slice(int, 3)
	c.Data = backing
	c.Data[0] = 10
	c.Data[1] = 20
	c.Data[2] = 30
	testing.Println(len(c.Data))
	testing.Println(c.Data[1])
	testing.Println(c.Name)
}
