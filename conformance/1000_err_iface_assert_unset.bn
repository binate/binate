package "main"
import "pkg/builtins/testing"

// An UNSET interface value (its vtable word never filled — spec
// iface.assert.absent) has no dynamic type: an assertion tests the vtable
// word first and a null vtable short-circuits to a miss, so the expression
// form aborts with `<unset>` as the dynamic name.  RTTI Slice 4.

interface Greeter {
	greet() int
}

type Thing struct {
	x int
}

func (t *Thing) greet() int {
	return t.x
}

impl *Thing : Greeter

func main() {
	var g *Greeter
	var back *Thing = g.(*Thing)
	testing.Println(back.greet())
}
