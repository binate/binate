package "main"

// A CROSS-PACKAGE concrete assertion x.(*shp.Circle): T's impl (and hence its
// __typeinfo record) lives in another package, so the assertion's
// &__typeinfo.<T> is a cross-TU reference the referencing module must declare
// `external global` (LLVM) — the emitDataSymAddrDeclares path.  RTTI Slice 4.

import "pkg/shp"

func main() {
	var c shp.Circle
	c.r = 5
	var s *shp.Shape = &c
	var back *shp.Circle = s.(*shp.Circle)
	println(back.area())
}
