package "main"

// Comma-ok concrete type assertion `v, ok := x.(*T)` / `x.(@T)` (spec §11.12,
// two-result form) — a HIT yields (recovered, true); any MISS (a wrong dynamic
// type or an unset vtable) yields (nil, false) WITHOUT aborting.  RTTI Slice 4b
// (compiled-mode only; the VM path is Slice 5 / d-i).

interface Greeter {
	greet() int
}

type Thing struct {
	x int
}

type Other struct {
	y int
}

func (t *Thing) greet() int {
	return t.x
}

func (o *Other) greet() int {
	return o.y
}

impl *Thing : Greeter
impl *Other : Greeter

func main() {
	var t Thing
	t.x = 42
	var rg *Greeter = &t

	// *T HIT via the `=` form (pre-declared targets).
	var tb *Thing
	var ok bool
	tb, ok = rg.(*Thing)
	if ok { println(tb.greet()) } else { println(-1) }

	// Wrong-type MISS via `:=` — (nil, false), no abort.
	tb2, ok2 := rg.(*Other)
	if ok2 { println(tb2.y) } else { println(0) }

	// Unset MISS (null vtable) — (nil, false), no abort.
	var ug *Greeter
	ut, uok := ug.(*Thing)
	if uok { println(ut.greet()) } else { println(1) }

	// @T HIT via `:=` from a managed @I.
	var m @Thing = make(Thing)
	m.x = 7
	var mg @Greeter = m
	mb, mok := mg.(@Thing)
	if mok { println(mb.greet()) } else { println(-2) }

	// @T unset MISS (managed operand, null vtable) — (nil, false), no abort and
	// no stray release of the nil recovered pointer.
	var umg @Greeter
	um, umok := umg.(@Thing)
	if umok { println(um.greet()) } else { println(3) }

	// Blank targets: discard the recovered value, keep ok; and keep the value,
	// discard ok.
	_, bok := rg.(*Thing)
	if bok { println(2) } else { println(-3) }
	tb3, _ := rg.(*Thing)
	println(tb3.greet())
}
