package "main"
import "pkg/builtins/testing"

import "pkg/fvslice"

// The option-B (by-address) proof for a NON-coerced in-register aggregate arg
// passed through a func-value dispatch shim.  Native `main` forms a *func value
// pointing at a CROSS-PACKAGE function (pkg/fvslice.Sum, LLVM-compiled under
// `-backend native`) that takes a raw slice (*[]int, a 2-word non-coerced in-register
// aggregate) BY VALUE, and calls it via func-value dispatch.
//
// Because `main` takes Sum's address itself (var f = fvslice.Sum), `main` (native)
// emits its OWN native func-value shim for that value; the dispatch reaches THAT
// native shim, which then tail-branches to the LLVM-compiled Sum callee.  So the path
// under test is native dispatch -> native shim -> LLVM callee: native
// `emitCallFuncValue` passes the slice BY-ADDRESS as ONE pointer word (an i8* dispatch
// slot), the native shim dereferences it and spreads the two words into Sum's AAPCS
// slice registers, and the LLVM Sum reads them.  All three agree on the by-address
// contract, so the sum comes back correct; an inline (option-A) spread would send 2
// words where the shim expects 1 pointer — a silent miscompile that yields garbage.
//
// This does NOT exercise native-dispatch -> LLVM-EMITTED-shim (main's own native shim
// absorbs the marshal); 1006 covers that boundary, where the DEP creates the func value
// and its LLVM-emitted shim is the one native main dispatches through.

func main() {
	var arr [4]int = [4]int{10, 20, 3, 9}
	var f *func(*[]int) int = fvslice.Sum
	testing.Println(f(arr[:])) // 42
}
