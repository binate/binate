package "pkg/fvslice"

// Sum takes a raw slice (*[]int) BY VALUE and returns the sum of its elements.
// Under `-backend native` this package is LLVM-compiled, so main (native) forming a
// *func(*[]int) int value = Sum and calling it exercises the cross-mode func-value
// dispatch: native `emitCallFuncValue` passes the slice by-address (one i8* dispatch
// word, option B) to main's OWN native func-value shim (main took Sum's address, so
// main emits the shim), which dereferences that pointer and spreads the slice's two
// words into Sum's AAPCS arg registers before tail-branching to the LLVM-compiled Sum.
func Sum(s *[]int) int
