package "pkg/fvslice"

// Sum runs LLVM-side (a non-main package under `-backend native`).  It reads the raw
// slice's two words (ptr + len) from wherever the func-value shim placed them, so a
// wrong native-caller marshal (e.g. an option-A inline spread feeding a by-address
// shim) yields a wrong sum.
func Sum(s *[]int) int {
	var total int = 0
	for i := 0; i < len(s); i++ {
		total = total + s[i]
	}
	return total
}
