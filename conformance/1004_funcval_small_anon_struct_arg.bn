package "main"

// Same-package native-arm32 proof for a small source-level ANONYMOUS-struct
// func-value arg.  A source-level anon struct type is NOT nameless at the ABI layer:
// IR-gen assigns it a synthetic `__anon_N` name (gen_type_resolve.bn), so
// AggInRegCoercedKind (len(Name) > 0) — and AggCoercedInReg — is TRUE, INCLUDING for
// this 4-byte one.  So the anon struct is a COERCED aggregate: isByAddressAggArm32 is
// TRUE via branch 1 (AggCoercedInReg), and it rides the by-address coerced path
// (ONE dispatch pointer word the shim re-expands) exactly like a NAMED struct — NOT
// an inline path.  This pins that dispatch <-> shim <-> callee agree on the
// by-address coerced placement of a 4-byte anon struct: the field s.x round-trips
// through the func-value shim intact.  (Binate has no anonymous-struct composite-
// literal syntax, so the value is built via a var + field store; an `int` field is
// 4 bytes on ILP32.)
func take(s struct { x int }) int {
	return s.x
}

func main() {
	var v struct { x int }
	v.x = 42
	var f *func(struct { x int }) int = take
	println(f(v)) // 42
}
