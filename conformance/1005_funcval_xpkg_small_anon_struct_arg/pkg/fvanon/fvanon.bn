package "pkg/fvanon"

// Field runs LLVM-side (a non-main package under `-backend native`).  The anon struct
// is COERCED (IR-gen names it `__anon_N`), so Field reads its coerced param from
// wherever the by-address func-value shim re-expanded it; a wrong native-caller
// marshal that disagreed with the coerced by-address contract would read garbage
// instead of 42.
func Field(s struct { x int }) int {
	return s.x
}
