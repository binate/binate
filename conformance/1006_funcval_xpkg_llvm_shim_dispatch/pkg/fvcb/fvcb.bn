package "pkg/fvcb"

// sumSlice is package-PRIVATE: main cannot name it, so main never takes its address
// and thus emits no `<mangled>__shim` native shim for it.  GetSliceCallback takes
// its address HERE (in this LLVM-compiled dep), so the `@__shim.<mangled>` LLVM
// func-value shim is emitted in THIS package's object file — the shim native main
// dispatches through.

// sumSlice reads the raw slice's two words (ptr + len) from wherever the LLVM shim
// placed them.  A wrong native-caller dispatch marshal — e.g. an option-A inline
// 2-word spread feeding a by-address (i8*) shim — hands the shim a stray pointer
// where it expects the pointer-to-the-two-words, yielding a wrong sum.
func sumSlice(s *[]int) int {
	var total int = 0
	for i := 0; i < len(s); i++ {
		total = total + s[i]
	}
	return total
}

// GetSliceCallback creates the func value over sumSlice (its address is taken HERE),
// so the slice-arg LLVM shim lands in this dep's object.
func GetSliceCallback() *func(*[]int) int {
	return sumSlice
}
