package "main"
import "pkg/builtins/testing"

// Cross-package generic container instantiated on a NAMED-DISTINCT transparent
// managed-slice wrapper element (Buf = @[]@Box).  The container's backing is
// @[]Buf; destroying it runs the __dtor_ms_ms_mp_Box element-walk, which calls
// the inner __dtor_ms_mp_Box.  ensureMsDtor must peel the named wrapper on the
// element before its recursion guard, else that inner helper is never emitted
// (compiled: undefined value; VM: extern not found).  The container is created
// but NEVER populated -- a materialized element would otherwise emit the inner
// helper incidentally and mask the gap.

import "pkg/gwrap"

type Box struct {
	v int
}

type Buf @[]@Box

func main() {
	var h @gwrap.Box1[Buf] = gwrap.New[Buf]()
	testing.Println(gwrap.Count[Buf](h))   // 0
}
