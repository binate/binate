package "pkg/gwrap"

// A minimal generic container (managed-slice backing) whose bodies live here so a
// cross-package consumer monomorphizes them.  Deliberately has NO Push: the bug
// this guards reproduces only when the container is created-but-never-populated,
// so no materialized element incidentally emits the inner element dtor.
type Box1[T any] struct {
	items @[]T
	n     int
}

func New[T any]() @Box1[T] {
	var h @Box1[T] = make(Box1[T])
	h.items = make_slice(T, 4)
	h.n = 0
	return h
}

func Count[T any](h @Box1[T]) int {
	return h.n
}
