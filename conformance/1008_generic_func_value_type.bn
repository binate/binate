package "main"

// A function-value type mentioning a generic type param — raw *func(T) AND managed
// @func(T) — must substitute T at instantiation: as a generic-struct FIELD, a
// generic-function PARAM, with a named function AND a capturing closure injected.

type Box[T any] struct {
	rawFn *func(T) uint
	mgdFn @func(T) uint
}

func rawHash(x int) uint { return cast(uint, x * 2) }

func NewBox[T any](rf *func(T) uint, mf @func(T) uint) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.rawFn = rf
	b.mgdFn = mf
	return b
}

func (b @Box[T]) ApplyRaw(x T) uint { return b.rawFn(x) }
func (b @Box[T]) ApplyMgd(x T) uint { return b.mgdFn(x) }

func ApplyFn[T any](f *func(T) uint, x T) uint {
	return f(x)
}

func main() {
	var seed uint = 100
	var closure @func(int) uint = func(x int) uint { return cast(uint, x) + seed }
	var b @Box[int] = NewBox[int](rawHash, closure)
	println(cast(int, b.ApplyRaw(5)))
	println(cast(int, b.ApplyMgd(5)))
	println(cast(int, ApplyFn[int](rawHash, 7)))
}
