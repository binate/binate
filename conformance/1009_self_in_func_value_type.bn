package "main"
import "pkg/builtins/testing"

// An interface method whose signature nests Self inside a function-VALUE type
// (apply(f *func(Self) int)). substituteSelf must substitute Self there so a
// correct impl (with the receiver's concrete type) is accepted.

interface Applier {
	apply(f *func(Self) int) int
}

type Counter struct {
	val int
}

func (c *Counter) apply(f *func(Counter) int) int {
	return f(*c)
}

impl *Counter : Applier

func double(c Counter) int {
	return c.val * 2
}

func main() {
	var c Counter
	c.val = 21
	var p *Counter = &c
	testing.Println(p.apply(double))
}
