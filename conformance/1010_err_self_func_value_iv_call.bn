package "main"

// plan-self-type.md S.3 with Self nested in a function-VALUE parameter
// (apply(f *func(Self) int)): the method is still object-unsafe, so calling it
// through an interface value must be rejected with the clean S.3 diagnostic —
// typeContainsSelf must see the Self inside the func-value type for the gate to fire.

interface Applier {
	apply(f *func(Self) int) int
}

type Counter struct {
	val int
}

func (c *Counter) apply(f *func(Counter) int) int {
	return f(*c)
}

impl *Counter : Applier

func double(c Counter) int {
	return c.val * 2
}

func main() {
	var c Counter
	var iv *Applier = &c
	var _ int = iv.apply(double)
}
