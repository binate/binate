package "main"

// Copy emission for a NAMED-distinct transparent WRAPPER element inside an ARRAY.
// genArrayCopy / ensureArrayCopy dispatch an array's element by its RAW Kind, and
// ResolveAlias does not peel TYP_NAMED — so a named wrapper element mis-classifies
// and the inner copy helper is never emitted while the outer copy body calls it:
//   - a `@[]@Box`-wrapper element (`type Buf @[]@Box`) fell to genArrayCopy's
//     generic else and called an undefined `__copy_ms_mp_Box` — the managed-slice
//     copy is a shared-backing RefInc, there is NO `__copy_ms_*` helper;
//   - a named-array element skipped ensureArrayCopy's inner array-copy recursion.
// Fixed by peelTransparent-ing the element before the kind dispatch, mirroring the
// struct field-walk peels and the dtor peel (dtor coverage: 1002 / 1007).  This is
// the COPY twin — an EMPTY/never-populated value still emits its copy helper, so it
// link-failed before the fix.

type Box struct {
	v int
}

type Buf @[]@Box    // named managed-slice wrapper
type ArrBuf [2]Buf  // array whose element is a named ms-wrapper
type NArr [3]@Box   // inner array
type ArrArr [2]NArr // array whose element is a named array

func main() {
	var ab ArrBuf
	var ab2 ArrBuf = ab   // genArrayCopy: ms-wrapper element -> inline backing RefInc
	var aa ArrArr
	var aa2 ArrArr = aa   // ensureArrayCopy: recurse the inner NArr array-copy helper
	_ = ab2
	_ = aa2
	println("copy-ok")
}
