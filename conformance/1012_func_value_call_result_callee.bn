package "main"

// A raw *func value returned from a method (or function) and then called: the call
// site's callee is a CALL RESULT of func-value type, which must dispatch the func
// value indirectly -- not fall through to a direct call on a malformed empty symbol.

type Box struct {
	f *func(int) int
}

func (b @Box) Get() *func(int) int {
	return b.f
}

func one(x int) int {
	return x + 1
}

func main() {
	var b @Box = make(Box)
	b.f = one
	println(b.Get()(10))
}
