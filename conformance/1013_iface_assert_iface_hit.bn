package "main"
import "pkg/builtins/testing"

// Interface-target type assertion `x.(*J)` / `x.(@J)` (spec §11.12): recover an
// interface value of J from an interface value of I when the dynamic type
// implements J (a runtime satisfaction lookup).  RTTI Slice 5a (compiled-mode
// only; the VM path is Slice 5b / d-i).

interface Animal {
	sound() int
}

interface Named {
	name() int
}

interface Flyer {
	fly() int
}

type Dog struct {
	x int
}

func (d *Dog) sound() int {
	return d.x
}

func (d *Dog) name() int {
	return d.x + 100
}

impl *Dog : Animal
impl *Dog : Named

func main() {
	var d Dog
	d.x = 5
	var a *Animal = &d

	// *J HIT: the Dog behind the Animal value implements Named.
	var nm *Named = a.(*Named)
	testing.Println(nm.name())

	// comma-ok *J HIT.
	nm2, ok := a.(*Named)
	if ok { testing.Println(nm2.name()) } else { testing.Println(-1) }

	// comma-ok *J MISS: Dog does not implement Flyer.
	fl, ok2 := a.(*Flyer)
	if ok2 { testing.Println(fl.fly()) } else { testing.Println(0) }

	// @J HIT from a managed @I (retains).
	var md @Dog = make(Dog)
	md.x = 9
	var ma @Animal = md
	var mn @Named = ma.(@Named)
	testing.Println(mn.name())

	// comma-ok @J HIT: the recovered value is a MANAGED interface value (a
	// 2-word managed struct field in the {recovered, ok} result).
	mn2, mok := ma.(@Named)
	if mok { testing.Println(mn2.name()) } else { testing.Println(-2) }

	// Unset scrutinee (null vtable) → comma-ok MISS, no abort and no stray
	// release of the nil interface value.
	var ua *Animal
	ub, uok := ua.(*Named)
	if uok { testing.Println(ub.name()) } else { testing.Println(2) }
}
