package "main"
import "pkg/builtins/testing"

// A failed interface-target assertion `x.(*J)` — the dynamic type does not
// implement J — aborts with the §17.5 panic.  RTTI Slice 5a.

interface Animal {
	sound() int
}

interface Flyer {
	fly() int
}

type Dog struct {
	x int
}

func (d *Dog) sound() int {
	return d.x
}

impl *Dog : Animal

func main() {
	var d Dog
	d.x = 5
	var a *Animal = &d
	var f *Flyer = a.(*Flyer)
	testing.Println(f.fly())
}
