package "main"

// An interface-target assertion HITs on a transitive ANCESTOR: `impl *T : RC`
// where `interface RC : Reader, Closer` makes T satisfy Reader and Closer too
// (the impl registry's ancestor closure emits a satentry per ancestor).  RTTI
// Slice 5a.

interface Reader {
	rd() int
}

interface Closer {
	cl() int
}

interface RC : Reader, Closer {
}

type T struct {
	x int
}

func (t *T) rd() int {
	return t.x
}

func (t *T) cl() int {
	return t.x + 1
}

impl *T : RC

func main() {
	var t T
	t.x = 10
	var rc *RC = &t

	// Transitive ancestors of RC.
	var r *Reader = rc.(*Reader)
	println(r.rd())

	c, ok := rc.(*Closer)
	if ok { println(c.cl()) } else { println(-1) }

	// The listed interface itself.
	var rc2 *RC = rc.(*RC)
	println(rc2.rd())
}
