package "main"

// Two instantiations of a generic that differ ONLY in a function-value type argument
// are DISTINCT types: assigning one to the other is a type error.  Regression — they
// were conflated because a func-value type arg rendered as a non-distinct name
// (func(...) / <unknown>) in the mangled instantiation name.

type Box[T any] struct {
	fn T
}

func main() {
	var bi @Box[@func(int) uint] = make(Box[@func(int) uint])
	var bb @Box[@func(bool) uint] = make(Box[@func(bool) uint])
	bi = bb
}
