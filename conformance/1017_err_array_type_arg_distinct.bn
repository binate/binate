package "main"

// Generic instantiations differing only in an ARRAY type argument (length or
// element) are DISTINCT types.  Regression — an array type arg rendered as a
// non-distinct "[...]" placeholder, conflating Box[[3]int] and Box[[5]int].

type Box[T any] struct {
	fn T
}

func main() {
	var b3 @Box[[3]int] = make(Box[[3]int])
	var b5 @Box[[5]int] = make(Box[[5]int])
	b3 = b5
}
