package "main"

// A 64-bit register-pair SCALAR arg (int64 on ILP32 = 2 GP words, 8-byte-aligned)
// passed through a func value.  On AAPCS32 an int64 obeys the §6.5 C.3 even-register-
// pair rule: it starts on an EVEN core register (r0:r1 or r2:r3) or an 8-aligned
// stack slot.  The func-value shim must place the incoming int64 (which the dispatch
// caller ALSO even-aligns) into the even register pair the underlying reads it from —
// on BOTH cursors.  A shim that used a plain linear cursor would misplace the pair
// (reading it one register early, or off by the incoming even-pair pad) — a silent
// miscompile this end-to-end round-trip catches.
//
// Three shapes exercise the even-pair placements:
//   sinkR2R3(a int, v int64)      -- int -> r0, int64 -> r2:r3 (outgoing even-pair pad
//                                    wastes r1); a naive cursor puts it at r1:r2.
//   sinkR0R1(v int64, a int)      -- int64 -> r0:r1 outgoing; INCOMING it is padded to
//                                    r2:r3 (after the data slot), so the shim must read
//                                    the pair from r2:r3, not r1:r2.
//   sinkTwoInt(a int, b int, v int64) -- int64 -> r2:r3 outgoing after two ints.

func sinkR2R3(a int, v int64) {
	println(a)
	println(cast(int, v))
}

func sinkR0R1(v int64, a int) {
	println(cast(int, v))
	println(a)
}

func sinkTwoInt(a int, b int, v int64) {
	println(a)
	println(b)
	println(cast(int, v))
}

func main() {
	var v int64 = cast(int64, 1234567)

	var f1 @func(int, int64) = sinkR2R3
	f1(42, v) // 42, 1234567

	var f2 @func(int64, int) = sinkR0R1
	f2(v, 99) // 1234567, 99

	var f3 @func(int, int, int64) = sinkTwoInt
	f3(7, 8, v) // 7, 8, 1234567
}
