package "main"

// A func value whose int64 arg spills past the register file, exercising the SPILL
// path of the arm32 func-value shim.  With three leading int args (r0..r2 outgoing)
// the trailing int64 even-rounds to r4 — past r3 — so it goes WHOLE onto the 8-aligned
// outgoing-args stack (a scalar int64 never SPLITs on AAPCS32).  The shim marshals it
// there, and the incoming int64 (on the dispatch caller's overflow stack) must be read
// with the correct even-pair-padded cursor.  A second call adds a fourth leading int
// so the int64 is preceded by an odd word count, pinning the incoming even-pair pad in
// the spill marshal too.

func sink3(a int, b int, c int, v int64) {
	println(a)
	println(b)
	println(c)
	println(cast(int, v))
}

func sink4(a int, b int, c int, d int, v int64) {
	println(a)
	println(b)
	println(c)
	println(d)
	println(cast(int, v))
}

func main() {
	var v int64 = cast(int64, 9999999)

	var f3 @func(int, int, int, int64) = sink3
	f3(1, 2, 3, v) // 1, 2, 3, 9999999

	var f4 @func(int, int, int, int, int64) = sink4
	f4(10, 20, 30, 40, v) // 10, 20, 30, 40, 9999999
}
