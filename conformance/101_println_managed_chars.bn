package "main"

func main() {
	// println with @[]char from a string literal (allocate+copy init).
	var s @[]char = "hello"
	println(s)

	// println with @[]char from make_slice.
	var t @[]char = make_slice(char, 3)
	t[0] = 'a'
	t[1] = 'b'
	t[2] = 'c'
	println(t)

	// print with @[]char.
	print(s)
	print(" ")
	println(t)
}
