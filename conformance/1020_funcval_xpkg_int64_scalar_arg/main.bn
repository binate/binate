package "main"

import "pkg/fvi64"

// Cross-package proof for a 64-bit register-pair SCALAR func-value arg — the arm32
// native-shim <-> LLVM-callee ABI contract for an int64.  Native `main` forms a @func
// value pointing at a CROSS-PACKAGE function (pkg/fvi64.Add, LLVM-compiled under
// `-backend native`) that takes `(int, int64)` and returns their sum, and calls it via
// func-value dispatch.
//
// An int64 on ILP32 is a 2-word, 8-aligned value obeying the AAPCS §6.5 C.3
// even-register-pair rule.  Native `main` builds the func value with its OWN native
// vtable, so the call runs native emitCallFuncValue -> native marshaling shim -> the
// LLVM-compiled underlying `Add`.  The native shim must place the int64 into the same
// even register pair the LLVM callee reads it from (r2:r3 here, after the leading
// int -> r0 and the even-pair pad wasting r1).  A native marshal that disagreed with
// the even-pair placement would feed `Add` garbage instead of the value.
func main() {
	var v int64 = cast(int64, 1000000)
	var f @func(int, int64) int = fvi64.Add
	println(f(42, v)) // 1000042
}
