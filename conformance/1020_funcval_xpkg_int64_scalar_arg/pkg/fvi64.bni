package "pkg/fvi64"

// Add takes `(int, int64)` and returns their sum as an int.  On ILP32 the int64 is a
// 2-word, 8-aligned register-pair scalar (AAPCS §6.5 C.3 even-register-pair rule).
// Under `-backend native` this package is LLVM-compiled, so native `main` forming a
// @func(int, int64) int = Add and calling it exercises the cross-mode marshaling for
// the int64 shape: native `emitCallFuncValue` even-aligns the incoming int64, main's
// own native marshaling shim re-places it into the callee's even register pair, and it
// tail-branches to this LLVM-compiled `Add`, which reads the pair from the same slot.
func Add(a int, v int64) int
