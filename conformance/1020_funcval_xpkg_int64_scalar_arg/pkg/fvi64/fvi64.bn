package "pkg/fvi64"

// Add runs LLVM-side (a non-main package under `-backend native`).  It reads the int64
// arg from wherever the by-value func-value shim placed it (the even register pair
// r2:r3, after the leading int and the even-pair pad); a wrong native-caller marshal
// that disagreed with the AAPCS §6.5 C.3 even-pair contract would read garbage instead
// of the value, and the sum would be wrong.
func Add(a int, v int64) int {
	return a + cast(int, v)
}
