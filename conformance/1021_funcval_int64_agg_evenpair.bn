package "main"

// An 8-ALIGNED INDIRECT-LARGE aggregate (a >16-byte struct with AlignOf 8) passed BY
// VALUE through a func value.  Big3i64 is struct{int64,int64,int64} = 24 bytes: SizeOf
// 24 > AggregateInRegMax 16, so AAPCS32 passes it INDIRECTLY as ONE pointer arg (the
// classifier's IndirectLargeAggregates path), yet its AlignOf 8 makes it obey the §6.5
// C.3 even-register-pair rule — so that single pointer word must start on an EVEN core
// register.  The DISPATCH caller (which keeps the real 24-byte type) and the CALLEE both
// even-pair-pad the pointer, so the func-value shim MUST apply the SAME even-pair pad on
// BOTH its cursors, or it places / reads the pointer one register off from the callee —
// a silent miscompile.  This is the pre-existing bug the paddedKeepsTypeArm32 fix
// addresses (the int64/uint64 scalar case was handled by isReg64Scalar; this generalizes
// the pad to the 8-aligned indirect-large aggregate that also keeps its type).
//
// Two shapes exercise the two cursor pads a naive linear cursor gets WRONG:
//   sinkAfterInt(a int, s Big3i64) -- int -> r0 (cursor 1, ODD), so s's pointer pads to
//                                     r2 (OUTGOING even-pair pad).  A shim without the
//                                     outgoing pad writes it to r1 (miscompile).
//   sinkFirst(s Big3i64, a int)    -- s -> r0 outgoing (cursor 0, even, no pad); but
//                                     INCOMING, after the data slot (cursor 1, ODD), the
//                                     dispatch caller pads s's pointer to r2, so the shim
//                                     must READ it from r2, not r1 (INCOMING even-pair
//                                     pad).  A shim without the incoming pad reads r1
//                                     (miscompile).

type Big3i64 struct {
	a int64
	b int64
	c int64
}

func sinkAfterInt(n int, s Big3i64) {
	println(n)
	println(cast(int, s.a))
	println(cast(int, s.b))
	println(cast(int, s.c))
}

func sinkFirst(s Big3i64, n int) {
	println(cast(int, s.a))
	println(cast(int, s.b))
	println(cast(int, s.c))
	println(n)
}

func main() {
	var s Big3i64
	s.a = cast(int64, 111)
	s.b = cast(int64, 222)
	s.c = cast(int64, 333)

	var f1 @func(int, Big3i64) = sinkAfterInt
	f1(42, s) // 42, 111, 222, 333

	var f2 @func(Big3i64, int) = sinkFirst
	f2(s, 99) // 111, 222, 333, 99
}
