package "main"
import "pkg/builtins/testing"

// An 8-ALIGNED >16-byte aggregate passed BY VALUE through a func value.  Big3i64 is
// struct{int64,int64,int64} = 24 bytes: AAPCS32 passes it by value split across the
// core registers and the stack, and its AlignOf 8 makes it start on an EVEN core
// register (§6.5 C.3), while the func-value dispatch carries its address in one flat
// word.  The shim must read that word from its flat slot and place the struct exactly
// where the callee reads it, even-register pad included — one register off is a silent
// miscompile.
//
// Two shapes exercise the two cursors:
//   sinkAfterInt(a int, s Big3i64) -- int -> r0, so s starts at r2 (OUTGOING even-
//                                     register pad, r1 unused).
//   sinkFirst(s Big3i64, a int)    -- s starts at r0 outgoing; INCOMING its address is
//                                     the word right after the data slot (flat, no
//                                     pad).

type Big3i64 struct {
	a int64
	b int64
	c int64
}

func sinkAfterInt(n int, s Big3i64) {
	testing.Println(n)
	testing.Println(cast(int, s.a))
	testing.Println(cast(int, s.b))
	testing.Println(cast(int, s.c))
}

func sinkFirst(s Big3i64, n int) {
	testing.Println(cast(int, s.a))
	testing.Println(cast(int, s.b))
	testing.Println(cast(int, s.c))
	testing.Println(n)
}

func main() {
	var s Big3i64
	s.a = cast(int64, 111)
	s.b = cast(int64, 222)
	s.c = cast(int64, 333)

	var f1 @func(int, Big3i64) = sinkAfterInt
	f1(42, s) // 42, 111, 222, 333

	var f2 @func(Big3i64, int) = sinkFirst
	f2(s, 99) // 111, 222, 333, 99
}
