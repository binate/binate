package "main"

// Regression for the native closure fast-path (register-only) arg shift when a
// SCALAR arg precedes a BY-ADDRESS aggregate arg (a slice, under option B).  The
// fast path re-expands the by-address slice's two value-words into consecutive
// outgoing registers; if it clobbered the preceding scalar's LIVE incoming
// register before that scalar's own shift read it, the scalar would be corrupted
// (it would read the slice's data pointer instead of its value).  A capturing
// closure (>= 1 capture, so it uses the closure shim, not the trivial func-value
// shim) with `func(int64, *[]int)` args, register-only (1 capture + 1 scalar + 2
// slice words = 4 <= 8), exercises exactly this.  Distinct decimal places catch a
// mis-marshal.

func main() {
	var base int = 5
	var f *func(int64, *[]int) int =
		func(n int64, s *[]int) int {
			return base * 1 + cast(int, n) * 10 + s[0] * 100
		}
	var xs [1]int
	xs[0] = 3
	println(f(7, xs[:]))  // 5 + 70 + 300 = 375
}
