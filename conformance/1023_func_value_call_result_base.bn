package "main"
import "pkg/builtins/testing"

// A func value reached through a SELECTOR or INDEX whose base is a call result
// must dispatch indirectly (getSelectorType / getIndexElemType resolve a
// call-result base via the checker's type), not fall through to a direct call on a
// malformed empty symbol.  Covers one level, a nested call chain, and the deeper
// selector-of-selector / selector-of-index forms.

type Inner struct { f *func(int) int }
type Holder struct { inner @Inner }
type Box struct { h @Holder }
type Cell struct { g *func(int) int }

func (b @Box) Get() @Holder { return b.h }

func one(x int) int { return x + 1 }

func mkbox() @Box {
	var b @Box = make(Box)
	var h @Holder = make(Holder)
	var i @Inner = make(Inner)
	i.f = one
	h.inner = i
	b.h = h
	return b
}

func getarr() @[]*func(int) int {
	var a @[]*func(int) int = make_slice(*func(int) int, 2)
	a[0] = one
	a[1] = one
	return a
}

func getcells() @[]@Cell {
	var a @[]@Cell = make_slice(@Cell, 2)
	var c0 @Cell = make(Cell)
	c0.g = one
	a[0] = c0
	a[1] = c0
	return a
}

func main() {
	var b @Box = mkbox()
	testing.Println(b.Get().inner.f(10))
	testing.Println(getarr()[1](20))
	testing.Println(mkbox().Get().inner.f(30))
	testing.Println(getcells()[0].g(40))
}
