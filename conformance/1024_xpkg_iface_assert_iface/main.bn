package "main"
import "pkg/builtins/testing"

// A CROSS-PACKAGE interface-target assertion s.(*shp.Sized): the target
// interface Sized and the (Circle, Sized) satentry both live in pkg/shp, so the
// assertion's &__ifaceid.<shp.Sized> is a cross-TU reference — this exercises
// the short-name __ifaceid symbol agreement across packages.  RTTI Slice 5a.

import "pkg/shp"

func main() {
	var c shp.Circle
	c.r = 5
	var s *shp.Shape = &c

	// The Circle behind the Shape value also implements Sized.
	var z *shp.Sized = s.(*shp.Sized)
	testing.Println(z.size())

	// comma-ok cross-package interface target.
	z2, ok := s.(*shp.Sized)
	if ok { testing.Println(z2.size()) } else { testing.Println(-1) }
}
