package "main"
import "pkg/builtins/testing"

// Refcount balance for `@J` interface recovery: recovering `@Named` retains the
// boxed data, and releasing the recovered value at scope exit must return the
// refcount to where it was (no leak, no double-free).  RTTI Slice 5a.

import "pkg/builtins/rt"

interface Animal {
	sound() int
}

interface Named {
	name() int
}

type Dog struct {
	x int
}

func (d *Dog) sound() int {
	return d.x
}

func (d *Dog) name() int {
	return d.x
}

impl *Dog : Animal
impl *Dog : Named

// Recovers @Named (retain), uses it, and releases it at function return.
func retainReleaseNamed(a @Animal) int {
	var n @Named = a.(@Named)
	return n.name()
}

func main() {
	var d @Dog = make(Dog)
	d.x = 7
	var a @Animal = d
	var before int = rt.Refcount(bit_cast(*uint8, d))
	testing.Println(retainReleaseNamed(a))
	var after int = rt.Refcount(bit_cast(*uint8, d))
	if before == after { testing.Println(0) } else { testing.Println(1) }
}
