package "main"
import "pkg/builtins/testing"

// Refcount balance when an `@J` interface-recovery result is DISCARDED (not
// moved into an owner).  The retain (+1) in the recovery must be released at
// end of statement, or the boxed object leaks a reference.  RTTI Slice 5a.

import "pkg/builtins/rt"

interface Animal {
	sound() int
}

interface Named {
	name() int
}

type Dog struct {
	x int
}

func (d *Dog) sound() int {
	return d.x
}

func (d *Dog) name() int {
	return d.x
}

impl *Dog : Animal
impl *Dog : Named

// Recovers @Named and DISCARDS it (blank assignment).
func discardNamed(a @Animal) {
	_ = a.(@Named)
}

func main() {
	var d @Dog = make(Dog)
	d.x = 7
	var a @Animal = d
	var before int = rt.Refcount(bit_cast(*uint8, d))
	discardNamed(a)
	var after int = rt.Refcount(bit_cast(*uint8, d))
	if before == after { testing.Println(0) } else { testing.Println(1) }
}
