package "main"
import "pkg/builtins/testing"

// An interface method call on the RESULT of a GENERIC-function call.  The
// receiver's IR-gen type must be resolved from the instantiated func's result;
// left unresolved, the interface-method dispatch names the method with a
// malformed receiver encoding and emits an undefined method symbol (`bn_..._num`
// referenced-but-not-defined -> link failure / VM extern-not-found).  This is the
// sibling of conformance/168 (method VALUE on a generic-call result): the
// interface-method-CALL path needs the same generic-call-result type resolution,
// and 168 does not exercise it.  The conformance/matrix/generic-managed iface
// element covers the same shape.

type Counter struct {
	n int
}

func (c *Counter) num() int {
	return c.n
}

interface Numbered {
	num() int
}

impl *Counter : Numbered

func id[T any](x T) T {
	return x
}

func main() {
	var cc @Counter = make(Counter)
	cc.n = 42
	var s @Numbered = cc
	testing.Println(id[@Numbered](s).num())   // want 42
}
