package "main"

// An interface method call on the RESULT of a GENERIC-function call emits an
// undefined method symbol (`bn_..._num` referenced-but-not-defined -> link
// failure / VM extern-not-found).  The receiver's IR-gen type must be resolved
// from the instantiated func's result; here it is not, so the interface-method
// dispatch names the method with a malformed receiver encoding.  This is the
// sibling of conformance/168 (method VALUE on a generic-call result, 2d48f348/
// fedbd0c5): 168 fixed the method-value path; the interface-method-CALL path has
// the same unresolved-generic-call-result-type root cause and was false-green.
// Surfaced by the conformance/matrix/generic-managed iface element.

type Counter struct {
	n int
}

func (c *Counter) num() int {
	return c.n
}

interface Numbered {
	num() int
}

impl *Counter : Numbered

func id[T any](x T) T {
	return x
}

func main() {
	var cc @Counter = make(Counter)
	cc.n = 42
	var s @Numbered = cc
	println(id[@Numbered](s).num())   // want 42
}
