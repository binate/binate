package "main"
import "pkg/builtins/testing"

import "pkg/oldlib"

// Pure-forwarder end-to-end for `expose`.  oldlib is a .bni-only
// forwarder that `expose`s pkg/newlib.  main imports ONLY oldlib (not newlib)
// and reaches an exposed func, var, and const through it.  Each reference
// mangles to its home, pkg/newlib.X, as the checker recorded it, and links
// against the symbol registered under that home path.
func main() {
	testing.Println(oldlib.Add(3, 4)) // 7  (exposed func)
	testing.Println(oldlib.Version)   // 9  (exposed var read)
	testing.Println(oldlib.MAX)       // 42 (exposed const)
}
