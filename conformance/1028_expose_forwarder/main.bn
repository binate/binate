package "main"

import "pkg/oldlib"

// Pure-forwarder end-to-end (expose Phases 1-4).  oldlib is a .bni-only
// forwarder that `expose`s pkg/newlib.  main imports ONLY oldlib (not newlib)
// and reaches an exposed func, var, and const through it.  Each reference
// mangles to its resolved home pkg/newlib.X (Phase 4, buildQualNameHomed) and
// links against the symbol Phase 3.5 registered under that home path.
func main() {
	println(oldlib.Add(3, 4)) // 7  (exposed func)
	println(oldlib.Version)   // 9  (exposed var read)
	println(oldlib.MAX)       // 42 (exposed const)
}
