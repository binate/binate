package "main"

// A method call on a ZERO-SIZE struct value receiver: the receiver load is a
// zero-leaf aggregate load, which must still define its SSA value (a plain load of
// a 0-byte aggregate) rather than emit nothing and leave the call referencing an
// undefined receiver.  Covers a direct call, a value passed as a type-param
// receiver (the zero-size-policy pattern), and a zero-size element in a slice.

type Empty struct {}
func (e Empty) Val() int { return 42 }

interface Doer { Do() int }
func run[T Doer](x T) int { return x.Do() }
func (e Empty) Do() int { return 7 }
impl Empty : Doer

func main() {
	var e Empty
	println(e.Val())          // direct zero-size receiver
	println(run[Empty](e))    // zero-size value as a constrained type-param receiver

	var arr @[]Empty = make_slice(Empty, 2)
	arr[0] = e
	println(arr[1].Val())     // zero-size element receiver
}
