package "main"
import "pkg/builtins/testing"

// Regression for the native closure AGGREGATE-RETURN marshal register clobber.
// When a capturing closure RETURNS a <=16 B struct (pack shape -> a single capture
// word -> the "down-shift" ascending marshal) and TWO OR MORE by-address aggregate
// params precede a later param, the pre-fix marshal expanded a by-address
// aggregate's value words UP onto a LATER param's still-live incoming register
// before it was read — corrupting it (register-only path -> silently wrong value;
// stack-spill path -> a clobbered slice pointer dereferenced -> SIGSEGV).  A
// by-address aggregate is a raw slice / iface-value (option B) OR a coerced <=16 B
// struct/array (pre-existing).  Fixed by staging the incoming dispatch words to a
// scratch frame and marshalling from memory (source-order-free).  Covers the
// register-only path (2 by-address args) and the stack-spill path (4), for both a
// raw slice and a coerced struct.  Distinct decimal places catch a mis-marshal.

type Pair struct {
	a int
	b int
}

type S16 struct {
	p int
	q int
}

type Big struct {
	x int
	y int
	z int
}

func main() {
	var base int = 3

	// Register-only: two by-address SLICES before an int64 (pack-return, 1 capture).
	var f2 *func(*[]int, *[]int, int64) Pair = func(x *[]int, y *[]int, n int64) Pair {
		var r Pair
		r.a = x[0] + y[0] * 10 + cast(int, n) * 100 + base * 1000
		r.b = 42
		return r
	}
	var x1 [1]int
	x1[0] = 1
	var y1 [1]int
	y1[0] = 2
	var r2 Pair = f2(x1[:], y1[:], 5)
	testing.Println(r2.a) // 1 + 20 + 500 + 3000 = 3521
	testing.Println(r2.b) // 42

	// Register-only: two by-address COERCED STRUCTS before an int64.
	var g2 *func(S16, S16, int64) Pair = func(x S16, y S16, n int64) Pair {
		var r Pair
		r.a = x.p + y.p * 10 + cast(int, n) * 100 + base * 1000
		r.b = 43
		return r
	}
	var sx S16
	sx.p = 4
	sx.q = 0
	var sy S16
	sy.p = 6
	sy.q = 0
	var rg Pair = g2(sx, sy, 8)
	testing.Println(rg.a) // 4 + 60 + 800 + 3000 = 3864
	testing.Println(rg.b) // 43

	// Stack-spill: four by-address SLICES before an int64 (pack-return, 1 capture).
	var f4 *func(*[]int, *[]int, *[]int, *[]int, int64) Pair = func(a *[]int, b *[]int, c *[]int,
			d *[]int, n int64) Pair {
				var r Pair
				r.a = a[0] + b[0] * 10 + c[0] * 100 + d[0] * 1000 + cast(int, n) * 10000
				r.b = 44
				return r
			}
	var a1 [1]int
	a1[0] = 1
	var b1 [1]int
	b1[0] = 2
	var c1 [1]int
	c1[0] = 3
	var d1 [1]int
	d1[0] = 4
	var r4 Pair = f4(a1[:], b1[:], c1[:], d1[:], 5)
	testing.Println(r4.a) // 1 + 20 + 300 + 4000 + 50000 = 54321
	testing.Println(r4.b) // 44

	// Sret-return (>16 B struct): two by-address SLICES before an int64, 1 capture.
	// On aa64 the retbuf rides X8 (not an arg reg), so captures start at X0 and the
	// captureWords==1 down-shift marshal STAGES (the register-clobber path — this
	// exercises the tail-branch sret frame's balanced SUB/ADD staging); on x64 the
	// sret pointer consumes RDI, so outBase >= 2 (the safe descending marshal).
	var f3 *func(*[]int, *[]int, int64) Big = func(x *[]int, y *[]int, n int64) Big {
		var r Big
		r.x = x[0] + y[0] * 10 + cast(int, n) * 100 + base * 1000
		r.y = 71
		r.z = 72
		return r
	}
	var p1 [1]int
	p1[0] = 6
	var q1 [1]int
	q1[0] = 7
	var r3 Big = f3(p1[:], q1[:], 8)
	testing.Println(r3.x) // 6 + 70 + 800 + 3000 = 3876
	testing.Println(r3.y) // 71
	testing.Println(r3.z) // 72
}
