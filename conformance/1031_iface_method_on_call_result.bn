package "main"
import "pkg/builtins/testing"

// An interface method call on the RESULT of a (non-generic) function call emits
// an undefined method symbol (`bn_..main2_0_3_num` — a receiver-type name of
// LENGTH ZERO, declared but never defined -> link failure / VM extern-not-found).
// `isInterfaceMethodCall` did not route an EXPR_CALL receiver, so the call fell
// to the concrete method path, which named the method off the interface value's
// (empty) type Name.  This is the non-generic sibling of conformance/1027: BOTH
// are an iface-method call on a call-result receiver — the bug is the whole
// EXPR_CALL-receiver class, not just the generic sub-case — and one routing fix
// covers both.

type Counter struct {
	n int
}

func (c *Counter) num() int {
	return c.n
}

interface Numbered {
	num() int
}

impl *Counter : Numbered

func mkNumbered(v int) @Numbered {
	var cc @Counter = make(Counter)
	cc.n = v
	return cc
}

func main() {
	testing.Println(mkNumbered(42).num()) // want 42
}
