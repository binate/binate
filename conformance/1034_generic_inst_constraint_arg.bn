package "main"

// A GENERIC-INSTANTIATION type passed as a type argument that must satisfy a
// GENERIC interface constraint via a BLANKET impl.  Exercises three cooperating
// pieces that were previously missing:
//   1. the checker accepts `Wrap[int]` in type-argument position
//      (typeArgFromExpr's EXPR_INSTANTIATE_OR_INDEX arm),
//   2. constraint satisfaction matches the parameterized-receiver impl
//      `impl Wrap[K] : Hasher[K]` against the concrete `Wrap[int]`
//      (typeSatisfiesConstraint's generic-blanket-impl branch), and
//   3. IR-gen monomorphizes the `Wrap[int]` type-arg to the concrete instantiated
//      type instead of void (exprToTypeExpr's EXPR_INSTANTIATE_OR_INDEX arm), so
//      the type-param-receiver method dispatch resolves `Wrap[int].Hash` rather
//      than emitting an empty receiver name / void-typed parameter.

interface Hasher[K any] { Hash(k K) uint }

func bucketOf[K any, P Hasher[K]](p P, k K, mask uint) uint {
	return p.Hash(k) & mask
}

type Wrap[K any] struct { salt uint }
func (w Wrap[K]) Hash(k K) uint { return w.salt }
impl Wrap[K] : Hasher[K]

func main() {
	var w Wrap[int]
	w.salt = 7
	println(cast(int, bucketOf[int, Wrap[int]](w, 42, 255)))
}
