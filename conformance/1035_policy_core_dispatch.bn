package "main"
import "pkg/builtins/testing"

// The container "policy-core" pattern: a single interface-constrained generic
// function dispatches over TWO shapes of policy through one code path —
//   * a ZERO-SIZE direct-call policy (IdentityPolicy, a `struct {}` whose Hash is
//     monomorphized to a direct call), and
//   * an FN-INJECTED generic policy (FnPolicy[int], holding a `*func(K) uint`
//     field it calls indirectly),
// both passed as type arguments satisfying the generic constraint `Hasher[K]`.
// Combines the zero-leaf aggregate-load fix (zero-size receiver) with generic-
// instantiation type-arg support (FnPolicy[int] satisfying Hasher[int] via a
// blanket impl).

interface Hasher[K any] { Hash(k K) uint }

func bucketOf[K any, P Hasher[K]](p P, k K, mask uint) uint {
	return p.Hash(k) & mask
}

type IdentityPolicy struct {}
func (p IdentityPolicy) Hash(k int) uint { return cast(uint, k) }
impl IdentityPolicy : Hasher[int]

type FnPolicy[K any] struct { hash *func(K) uint }
func (p FnPolicy[K]) Hash(k K) uint { return p.hash(k) }
impl FnPolicy[K] : Hasher[K]

func doubleHash(x int) uint { return cast(uint, x * 2) }

func main() {
	var direct IdentityPolicy
	testing.Println(cast(int, bucketOf[int, IdentityPolicy](direct, 42, 255)))

	var injected FnPolicy[int]
	injected.hash = doubleHash
	testing.Println(cast(int, bucketOf[int, FnPolicy[int]](injected, 42, 255)))
}
