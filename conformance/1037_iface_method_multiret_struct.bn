package "main"

// An INTERFACE METHOD returning a multi-return tuple whose FIRST component is an
// AGGREGATE (a by-value struct) — (Pair, int) — exercises the iface-op multi-
// return collect (collectMultiReturnFields on aa64 / collectMultiReturnTuple on
// x64) with an aggregate field spanning multiple tuple words.  Distinct from the
// scalar-only iface-method multi-return and from 144's direct-call (bool, @iface)
// tuple: here the callee is reached through the vtable AND a tuple field is a
// multi-word struct.  Both the struct's fields and the trailing scalar must
// survive the through-the-vtable dispatch.

type Pair struct {
	a int
	b int
}

interface Producer {
	make2() (Pair, int)
}

type Impl struct {
	base int
}

func (im *Impl) make2() (Pair, int) {
	var p Pair
	p.a = im.base + 1
	p.b = im.base + 2
	return p, im.base + 100
}

impl *Impl : Producer

func main() {
	var imv @Impl = make(Impl)
	imv.base = 10
	var pr @Producer = imv
	var p Pair
	var n int
	p, n = pr.make2()
	println(p.a)  // 11
	println(p.b)  // 12
	println(n)    // 110
}
