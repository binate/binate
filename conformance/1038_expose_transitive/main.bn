package "main"
import "pkg/builtins/testing"

import "pkg/a"

// Transitive re-export: A exposes P, P exposes Q (P and A are both pure .bni-only
// forwarders).  main imports only A and reaches Q's member as a.QFn (design §2 —
// transitive).  This is the load-bearing check for dependency-ordered injection:
// Q's surface must be injected into P before P's into A, so a wrong package-visit
// order (A or P visited before Q) would leave a.QFn unresolved.
func main() {
	testing.Println(a.QFn()) // 3
}
