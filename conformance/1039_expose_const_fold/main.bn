package "main"
import "pkg/builtins/testing"

import "pkg/fwd"

// Value-level const-fold through a forwarder: an exposed const used as an array
// dimension ([fwd.N]int) and as a shift amount (1 << fwd.SHIFT) must fold to the
// home package's const value.  Catches a silent wrong-fold in the gen_const_fold
// arms that Phase 4 rerouted through resolved-home mangling (a compile-time
// constant reference qualified through the forwarder, not the home package).
func main() {
	var arr [fwd.N]int
	testing.Println(len(arr))       // 3  (exposed const as an array dimension)
	testing.Println(1 << fwd.SHIFT) // 4  (exposed const in a value-level fold)
}
