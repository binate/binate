package "main"
import "pkg/builtins/testing"

import "pkg/fwd"
import "pkg/shapes"

// Re-exported TYPE + INTERFACE + impl, referenced through the forwarder spelling.
// fwd exposes pkg/shapes.  This exercises the exposed-type-reference path in
// IR-gen (resolved-home type resolution): fwd.Point is the exposed struct type,
// *fwd.Valuer the exposed interface — both must resolve to their HOME identity
// (pkg/shapes), not miss the registry and collapse to int.
func main() {
	var p fwd.Point = fwd.Make(2, 3) // exposed struct TYPE + exposed func
	testing.Println(p.X)                      // 2  (field read on the exposed type)
	testing.Println(p.Y)                      // 3

	var q shapes.Point = p // exposed type IS the home type (identity)
	testing.Println(q.X + q.Y)     // 5

	var v *fwd.Valuer = &p // exposed interface + exposed impl
	testing.Println(v.val())       // 5  (dispatch through shapes' impl on *Point)
}
