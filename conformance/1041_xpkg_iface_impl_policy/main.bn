package "main"
import "pkg/hp"
import "pkg/ep"
import "pkg/it"

type Tab[K any, H hp.Ha[K], E ep.Eb[K]] struct { h H; e E; val K }

type Cur[K any, H hp.Ha[K], E ep.Eb[K]] struct { t @Tab[K, H, E]; done bool }
func (c *Cur[K, H, E]) Nx() (K, bool) {
	if c.done { var z K; return z, false }
	c.done = true
	return c.t.val, true
}
impl *Cur[K, H, E] : it.Itr[K]

func (t @Tab[K, H, E]) Mk() @it.Itr[K] {
	var c @Cur[K, H, E] = make(Cur[K, H, E])
	c.t = t
	c.done = false
	return c
}
// Trigger: impl @Tab : it.Ible[K] (its method returns a nested @Itr[K]) on a type
// whose params H/E are constrained by OTHER imported generic-interface policies.
impl @Tab[K, H, E] : it.Ible[K]

func mk[K any, H hp.Ha[K], E ep.Eb[K]](h H, e E, val K) @Tab[K, H, E] {
	var t @Tab[K, H, E] = make(Tab[K, H, E])
	t.h = h
	t.e = e
	t.val = val
	return t
}

func main() {
	var h hp.DA[int]
	var e ep.DB[int]
	var t @Tab[int, hp.DA[int], ep.DB[int]] = mk[int, hp.DA[int], ep.DB[int]](h, e, 42)
	println(cast(int, t.h.H(5)))
	var bx @it.Itr[int] = t.Mk()
	var v int
	var ok bool
	v, ok = bx.Nx()
	println(v)
}
