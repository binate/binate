package "main"

import "pkg/builtins/testing"

import "pkg/fwd"
import "pkg/genlib"

// Exposed GENERIC type through the forwarder spelling: fwd.Box[int] resolves to
// its HOME generic decl (pkg/genlib.Box) and is the SAME type as genlib.Box[int]
// — identity holds and every spelling mangles to one home symbol.  Exercises the
// exposed-generic head remap in all THREE checker sites that resolve a
// package-qualified generic head:
//   (1) a type annotation / generic composite-literal head (var b fwd.Box[int]),
//   (2) an explicit type ARGUMENT to a generic call (genlib.Id[fwd.Box[int]]),
//   (3) a method-EXPRESSION head (fwd.Box[int].Get).
// Sites (2) and (3) previously resolved `undefined` — only (1) carried the remap.
func main() {
	// (1) type annotation + generic composite-literal head.
	var b fwd.Box[int] = fwd.Box[int]{v: 5}
	var h genlib.Box[int] = b // fwd.Box[int] IS genlib.Box[int] (identity)
	testing.Println(fwd.Unwrap(b)) // 5  (exposed generic through the forwarder)
	testing.Println(genlib.Unwrap(h)) // 5  (same value via the home spelling)

	// (2) exposed generic as an explicit type argument to a generic function call.
	var c genlib.Box[int] = genlib.Id[fwd.Box[int]](b)
	testing.Println(genlib.Unwrap(c)) // 5

	// (3) method expression whose head is the exposed-generic instantiation.
	testing.Println(fwd.Box[int].Get(b)) // 5
}
