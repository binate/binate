package "main"

import "pkg/fwd"
import "pkg/genlib"

// Exposed GENERIC type through the forwarder spelling: fwd.Box[int] (type
// annotation + generic composite-literal head) resolves to its HOME generic decl
// (pkg/genlib.Box) and is the SAME type as genlib.Box[int] — a fwd.Box[int] value
// is assignable to a genlib.Box[int] variable (identity), and both mangle to one
// home symbol.  Exercises the generic-struct head resolution remapped to the
// exposed home in the checker and IR-gen.
func main() {
	var b fwd.Box[int] = fwd.Box[int]{v: 5}
	var h genlib.Box[int] = b // fwd.Box[int] IS genlib.Box[int] (identity)
	println(fwd.Unwrap(b))    // 5  (exposed generic through the forwarder)
	println(genlib.Unwrap(h)) // 5  (same value via the home spelling)
}
