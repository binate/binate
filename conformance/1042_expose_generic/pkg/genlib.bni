package "pkg/genlib"

type Box[T any] struct { v T }

func Unwrap(b Box[int]) int

// Id is a generic function (body-included) exercised with an exposed generic
// (fwd.Box[int]) as an EXPLICIT type argument: genlib.Id[fwd.Box[int]](b).
func Id[T any](x T) T {
	return x
}

// Get is a generic method, exercised as a method-EXPRESSION whose head is an
// exposed-generic instantiation: fwd.Box[int].Get.
func (b Box[T]) Get() T {
	return b.v
}
