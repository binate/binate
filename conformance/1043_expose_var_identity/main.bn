package "main"
import "pkg/builtins/testing"

import "pkg/fwd"
import "pkg/store"

// Exposed var identity: fwd is a pure forwarder that exposes pkg/store.  A var
// re-exported through fwd shares pkg/store's storage (design §3.5 — vars are
// aliased, never copied).  A write via store.Set is observed through
// fwd.Counter, and a write via store.Set is observed through fwd.Counter again
// after mutation, so fwd.Counter and store.Counter name one storage cell.
func main() {
	fwd.Set(7)
	testing.Println(store.Get()) // 7  (write via forwarder surface, read at home)
	testing.Println(fwd.Counter) // 7  (exposed var read hits store's storage)
	store.Set(9)
	testing.Println(fwd.Counter) // 9  (home write observed through the forwarder)
}
