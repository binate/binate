package "main"
import "pkg/builtins/testing"

import "pkg/agg"

// Aggregator: agg exposes two internal packages (pkg/a, pkg/b) and has no impl
// of its own.  main imports ONLY agg and reaches both surfaces flat as agg.AFn
// / agg.BFn (design §2 — flat, so agg.X not agg.a.X), each resolving to its home
// package's symbol.
func main() {
	testing.Println(agg.AFn()) // 1
	testing.Println(agg.BFn()) // 2
}
