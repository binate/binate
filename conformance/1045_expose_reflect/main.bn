package "main"
import "pkg/builtins/testing"

import "pkg/agg"
import "pkg/inner"
import "pkg/builtins/reflect"

// Reflect identity of exposed members (pkg.expose.reflect): agg has its OWN func
// Own and exposes pkg/inner.  An exposed member is reflected under its HOME
// package, not copied into the forwarder's descriptor — a re-export emits no
// descriptor entry.  So reflecting over agg lists agg's own functions (Own +
// the synthesized __Package accessor) and NOT the exposed InnerFn, which appears
// only under pkg/inner's descriptor.  Meanwhile agg.InnerFn (the surface) still
// resolves to inner's symbol (identity).
func main() {
	testing.Println(agg.InnerFn()) // 200  (exposed member reachable via the surface)

	var pa @reflect.Package = agg.__Package()
	testing.Println(len(pa.Functions)) // agg's own funcs only (Own + __Package)
	for i := 0; i < len(pa.Functions); i++ {
		testing.Println(pa.Functions[i].Name)
	}

	var pi @reflect.Package = inner.__Package()
	testing.Println(len(pi.Functions))
	for i := 0; i < len(pi.Functions); i++ {
		testing.Println(pi.Functions[i].Name)
	}
}
