package "main"
import "pkg/builtins/testing"

// A pointer-receiver method mutates its receiver.  When the call's receiver expression is
// an addressable lvalue that is NOT a bare identifier — a field selector like `w.c`, a
// field through a managed pointer like `mw.c`, or a nested selector like `o.w.c` — IR-gen
// must pass the ADDRESS of that storage so the callee's writes land on the caller's
// object.  Copying the receiver into a temp instead silently drops the mutation: each
// Next() would see n unchanged, always report (n+1, true), and the loops below would spin
// forever.  A bare-identifier receiver already worked (it reused the variable's slot); the
// selector shapes are the regression this pins.

type Counter struct { n int }

// Next increments the counter and returns (newValue, true) until it reaches 3, then
// (0, false).  It mutates through a raw-pointer receiver.
func (c *Counter) Next() (int, bool) {
	if c.n >= 3 {
		return 0, false
	}
	c.n = c.n + 1
	return c.n, true
}

type Wrapper struct { c Counter }
type Outer struct { w Wrapper }

// drain sums the values a Counter at `*c` yields; a shared helper so each shape below
// exercises the same terminating loop.
func drain(c *Counter) int {
	var sum int = 0
	for {
		var v int
		var ok bool
		v, ok = c.Next()
		if !ok {
			break
		}
		sum = sum + v
	}
	return sum
}

func main() {
	// Bare-identifier receiver (already worked): baseline.
	var base Counter
	testing.Println(drain(&base)) // 1+2+3 = 6

	// Field selector on a value struct: `w.c.Next()`.
	var w Wrapper
	var s1 int = 0
	for {
		var v int
		var ok bool
		v, ok = w.c.Next()
		if !ok {
			break
		}
		s1 = s1 + v
	}
	testing.Println(s1) // 6

	// Field through a managed pointer: `mw.c.Next()`.
	var mw @Wrapper = make(Wrapper)
	var s2 int = 0
	for {
		var v int
		var ok bool
		v, ok = mw.c.Next()
		if !ok {
			break
		}
		s2 = s2 + v
	}
	testing.Println(s2) // 6

	// Nested selector: `o.w.c.Next()`.
	var o Outer
	var s3 int = 0
	for {
		var v int
		var ok bool
		v, ok = o.w.c.Next()
		if !ok {
			break
		}
		s3 = s3 + v
	}
	testing.Println(s3) // 6

	// Bare slice-element receiver: `arr[0].Next()` — the element `arr[0]` (not a
	// field of it) is the receiver, an addressable lvalue reached via the element
	// pointer rather than a field selector.
	var arr @[]Counter = make_slice(Counter, 1)
	var s4 int = 0
	for {
		var v int
		var ok bool
		v, ok = arr[0].Next()
		if !ok {
			break
		}
		s4 = s4 + v
	}
	testing.Println(s4) // 6
}
