package "main"

import "pkg/fwd"

// Exposed GENERIC INTERFACE through the forwarder spelling: *fwd.Holder[int]
// (fwd re-exports pkg/gen's generic interface Holder[T] + impl Box : Holder[int])
// must resolve to the HOME interface identity, so the upcast &bx -> *fwd.Holder[int]
// finds the exposed impl and dispatches.  Exercises instantiatedIfaceLookupPkg
// remapped to the exposed home.
func main() {
	var bx fwd.Box = fwd.MakeRaw(4)
	var r *fwd.Holder[int] = &bx
	println(r.get()) // 4
}
