package "main"
import "pkg/builtins/testing"

import "pkg/fwd"

// A BARE reference to an exposed generic type (`fwd.Box` with no type arguments)
// is rejected — the injected marker is not a usable type, exactly as a bare
// `genlib.Box` is rejected.  Guards against the marker silently resolving as a
// concrete type.
func main() {
	var x fwd.Box
	testing.Println(0)
}
