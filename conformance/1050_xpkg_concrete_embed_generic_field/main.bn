package "main"
import "pkg/builtins/testing"

// A CONCRETE (non-generic) struct embedding an imported generic Box[int] as a value field.
// Instantiating Box[int] here must resolve Box's own `slot @Inner[T]` field against gp, not
// main — otherwise the field degrades to @int and Get() miscompiles (an unresolved selector).
import "pkg/gp"

type Holder struct { bx @gp.Box[int] }

func main() {
	var h @Holder = make(Holder)
	h.bx = gp.NewBox[int](42)
	testing.Println(h.bx.Get())
}
