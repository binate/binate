// Package gp exercises a generic struct whose field is ANOTHER generic type from the
// same package (Box[T] holding an @Inner[T]), reached through a pointer-receiver method
// (Get -> b.slot.v).  When a CONCRETE struct in another package embeds Box[int] as a
// value field, IR-gen instantiates Box[int] while resolving that outer field, and must
// resolve Box's own field `slot @Inner[T]` against gp (Box's DEFINING package), not the
// consumer's.  Resolving it against the consumer misses the `Inner` generic decl, degrades
// the field type to `@int`, and Get()'s `b.slot.v` then lands in genSelector's
// unresolved-selector catch-all.
package "pkg/gp"

// Inner wraps a single T.
type Inner[T any] struct { v T }

// Box holds a managed Inner[T] — the same-package generic field whose resolution package
// this test pins.
type Box[T any] struct { slot @Inner[T] }

// NewBox returns a Box[T] wrapping x.
func NewBox[T any](x T) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.slot = make(Inner[T])
	b.slot.v = x
	return b
}

// Get reads the wrapped value through the managed Inner field, via a pointer receiver.
func (b *Box[T]) Get() T { return b.slot.v }
