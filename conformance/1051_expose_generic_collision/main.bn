package "main"
import "pkg/builtins/testing"

import "pkg/agg"

// pkg/p and pkg/q both declare a generic Box[T]; the aggregator exposing both
// must diagnose the collision on the GENERIC name, just as it does for
// non-generic names (1032/1033) — generics have no scope symbol, so the
// collision check must scan the generic-decl registries too.
func main() {
	testing.Println(0)
}
