package "main"
import "pkg/builtins/testing"

import "pkg/a"
import "pkg/q"

// Transitive exposed GENERIC type: A exposes P exposes Q, and Q declares Gen[T].
// a.Gen[int] (reached through two forwarders) must resolve to Q's generic and be
// identical to q.Gen[int] — the marker rides the Syms copy at each hop with
// HomePkg=Q preserved, so both spellings key one home symbol.
func main() {
	var g a.Gen[int] = a.Gen[int]{v: 7}
	var h q.Gen[int] = g // a.Gen[int] IS q.Gen[int] (transitive identity)
	testing.Println(a.Unwrap(g)) // 7
	testing.Println(q.Unwrap(h)) // 7
}
