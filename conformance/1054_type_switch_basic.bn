package "main"
import "pkg/builtins/testing"

// Type switch (§14.10): a first-match chain over the type-assertion primitives,
// running in every mode (RTTI Slice 6).  Covers concrete + interface targets,
// per-case narrowing of the binder, a multi-target case (binds the scrutinee),
// default, the binderless form, and `break` (which exits the switch).

interface Shape {
	area() int
}

interface Named {
	name() int
}

type Circle struct {
	r int
}

func (c *Circle) area() int {
	return c.r
}

func (c *Circle) name() int {
	return 1
}

type Square struct {
	s int
}

func (s *Square) area() int {
	return s.s
}

type Tri struct {
	t int
}

func (t *Tri) area() int {
	return t.t
}

impl *Circle : Shape
impl *Circle : Named
impl *Square : Shape
impl *Tri : Shape

// Single-target cases narrow the binder to the concrete type (field access);
// default binds the scrutinee's own interface type.
func classify(sh *Shape) int {
	switch v := sh.(type) {
	case *Circle:
		return v.r
	case *Square:
		return v.s + 1000
	default:
		return -1
	}
}

// An interface target does a runtime satisfaction lookup: Circle implements
// Named, Square/Tri do not.
func hasName(sh *Shape) int {
	switch sh.(type) {
	case *Named:
		return 1
	default:
		return 0
	}
}

// A multi-target case binds the scrutinee (so v is *Shape, dispatched via area);
// Tri falls to default.
func grouped(sh *Shape) int {
	switch v := sh.(type) {
	case *Circle, *Square:
		return v.area() + 10
	default:
		return v.area() + 20
	}
}

// `break` in a case exits the type switch, not the enclosing loop.
func firstCircle(shapes *[]*Shape) int {
	for i := 0; i < len(shapes); i++ {
		switch shapes[i].(type) {
		case *Circle:
			return i
		default:
			break
		}
	}
	return -1
}

func main() {
	var c Circle
	c.r = 5
	var sq Square
	sq.s = 4
	var t Tri
	t.t = 3
	var sc *Shape = &c
	var ss *Shape = &sq
	var st *Shape = &t

	testing.Println(classify(sc)) // 5
	testing.Println(classify(ss)) // 1004
	testing.Println(classify(st)) // -1
	testing.Println(hasName(sc))  // 1
	testing.Println(hasName(ss))  // 0
	testing.Println(grouped(sc))  // 15
	testing.Println(grouped(st))  // 23

	var arr *[]*Shape = make_slice(*Shape, 3)
	arr[0] = ss
	arr[1] = sc
	arr[2] = st
	testing.Println(firstCircle(arr)) // 1
}
