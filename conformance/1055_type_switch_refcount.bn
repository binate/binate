package "main"

// Refcount balance for a type switch's managed `@`-binder (RTTI Slice 6, the
// subtlest leak risk): recovering `@Named` in a case retains the boxed data and
// must release it at the case's own scope exit — no leak, no double-free, no
// per-iteration growth in a loop.  Also checks that a side-effecting scrutinee
// (`switch makeDog(n).(type)`) survives every case (its box is rooted for the
// switch, so a `@`-recovery is not a use-after-free) and is released exactly once
// when the switch is left.

import "pkg/builtins/rt"

interface Animal {
	sound() int
}

interface Named {
	name() int
}

interface Aged {
	age() int
}

type Dog struct {
	x int
}

func (d *Dog) sound() int {
	return d.x
}

func (d *Dog) name() int {
	return d.x
}

impl *Dog : Animal
impl *Dog : Named

// Recovers @Named (retain), uses it, releases it at the case scope exit.
func viaTypeSwitch(a @Animal) int {
	switch v := a.(type) {
	case @Named:
		return v.name()
	default:
		return -1
	}
}

// A managed scrutinee + @-binder in a loop must not leak per iteration.
func loopBalance(a @Animal) {
	for i := 0; i < 100; i++ {
		switch v := a.(type) {
		case @Named:
			_ = v.name()
		default:
		}
	}
}

func makeDog(n int) @Animal {
	var d @Dog = make(Dog)
	d.x = n
	return d
}

// A side-effecting scrutinee: the fresh temp must survive the case body (no UAF)
// and be released once when the switch exits (no leak).
func sideEffectScrut(n int) int {
	switch v := makeDog(n).(type) {
	case @Named:
		return v.name()
	default:
		return -1
	}
}

// A managed MULTI-TARGET case binds the scrutinee itself (@Animal, a fresh
// reference RefInc'd into the case slot and released at the case exit), not a
// recovered value.  Dog implements Named (not Aged), so the case is TAKEN and the
// scrutinee-as-binder acquire/release path actually runs.
func viaMultiTarget(a @Animal) int {
	switch v := a.(type) {
	case @Named, @Aged:
		return v.sound()
	default:
		return -1
	}
}

// A `continue` out of a managed `@`-binder case inside a loop must RefDec the
// binder (a case-scope local) before jumping to the loop's next iteration — else
// it leaks one reference per iteration.
func continueBalance(a @Animal) {
	for i := 0; i < 100; i++ {
		switch v := a.(type) {
		case @Named:
			_ = v.name()
			continue
		default:
		}
	}
}

func main() {
	var d @Dog = make(Dog)
	d.x = 7
	var a @Animal = d
	var before int = rt.Refcount(bit_cast(*uint8, d))

	println(viaTypeSwitch(a)) // 7
	if before == rt.Refcount(bit_cast(*uint8, d)) {
		println(0)
	} else {
		println(1)
	}

	loopBalance(a)
	if before == rt.Refcount(bit_cast(*uint8, d)) {
		println(0)
	} else {
		println(1)
	}

	println(sideEffectScrut(9)) // 9

	println(viaMultiTarget(a)) // 7 (Dog.sound)
	if before == rt.Refcount(bit_cast(*uint8, d)) {
		println(0)
	} else {
		println(1)
	}

	continueBalance(a)
	if before == rt.Refcount(bit_cast(*uint8, d)) {
		println(0)
	} else {
		println(1)
	}
}
