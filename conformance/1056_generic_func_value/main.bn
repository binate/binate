package "main"

import "pkg/glib"

// A same-package generic function, also used as a func value.
func Dup[T any](x T) T { return x }

type Holder struct {
	fn @func(int) int
}

func apply(f @func(int) int, x int) int {
	return f(x)
}

func mk() @func(int) int {
	return glib.Ident[int] // generic instance as a return value
}

// Exercises a generic FUNCTION used as a func VALUE (not directly called), in
// every func-value slot: inferred `var`, explicit `@func` / `*func` `var`, `:=`,
// call argument, return value, struct field, and plain reassignment — cross-
// package and same-package.
func main() {
	var a = glib.Ident[int] // cross-pkg inferred var
	println(a(1))
	var b @func(int) int = glib.Ident[int] // cross-pkg explicit @func
	println(b(2))
	c := glib.Ident[int] // cross-pkg :=
	println(c(3))
	var d = Dup[int] // same-pkg inferred var
	println(d(4))
	println(apply(glib.Ident[int], 5)) // call argument
	var e = mk() // return value
	println(e(6))
	var h = Holder{fn: glib.Ident[int]} // struct field
	println(h.fn(7))
	var g *func(int) int = glib.Ident[int] // cross-pkg explicit *func (raw)
	println(g(8))
	a = glib.Ident[int] // plain reassignment of an existing func-value var
	println(a(9))
}
