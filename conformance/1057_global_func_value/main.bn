package "main"

import "pkg/glib"

func add1(x int) int { return x + 1 }
func add2(x int) int { return x + 2 }

// A named func-value type and its raw counterpart.  IR-gen represents a named
// non-struct type by its underlying, so a global inferred from a variable of
// such a type must register the stripped func-value slot.
type Fn @func(int) int
type FnR *func(int) int

// A package-scope global with an inferred func-value type — a bare function
// reference (`add1`) decays to @func, just like a local `var f = add1`.  A
// package global whose initializer is a generic-function instantiation, and an
// explicit-type func-value global, exercise the same slot.
var G = add1                     // inferred @func from a bare func reference
var GI = glib.Ident[int]         // inferred @func from a generic instantiation
var GE @func(int) int = add1     // explicit func-value type

// Globals inferred from another func-value VARIABLE of a NAMED func-value type
// (`@func`-wrapped and `*func`-wrapped): the initializer expr's checker type is
// the NAMED wrapper, which must be stripped to the same slot the explicit form
// gets — else the 16-byte store overruns an 8-byte slot and the call mis-lowers
// to a direct symbol call.
var baseM Fn = add1
var GW = baseM                   // inferred from a named-@func-wrapped var
var baseR FnR = add1
var GWR = baseR                  // inferred from a named-*func-wrapped var

// use / useW read a func-value global from a DIFFERENT function than __init.
func use(x int) int {
	return G(x)
}
func useW(x int) int {
	return GW(x)
}

func main() {
	println(G(10))   // 11
	println(use(20)) // 21
	println(GI(9))   // 9
	println(GE(40))  // 41
	G = add2         // reassign a func-value global
	println(G(10))   // 12
	println(GW(5))   // 6  — named-@func-wrapped inferred global
	println(useW(30))// 31 — cross-function read of GW
	println(GWR(6))  // 7  — named-*func-wrapped inferred global
	GW = add2        // reassign a named-wrapped-inferred global
	println(GW(5))   // 7
}
