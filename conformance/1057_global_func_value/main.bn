package "main"

import "pkg/glib"

func add1(x int) int { return x + 1 }
func add2(x int) int { return x + 2 }

// A package-scope global with an inferred func-value type — a bare function
// reference (`add1`) decays to @func, just like a local `var f = add1`.  A
// package global whose initializer is a generic-function instantiation, and an
// explicit-type func-value global, exercise the same slot.
var G = add1                     // inferred @func from a bare func reference
var GI = glib.Ident[int]         // inferred @func from a generic instantiation
var GE @func(int) int = add1     // explicit func-value type

// use reads a func-value global from a DIFFERENT function than __init.
func use(x int) int {
	return G(x)
}

func main() {
	println(G(10))   // 11
	println(use(20)) // 21
	println(GI(9))   // 9
	println(GE(40))  // 41
	G = add2         // reassign a func-value global
	println(G(10))   // 12
}
