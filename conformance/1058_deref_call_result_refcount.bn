package "main"

import "pkg/builtins/rt"

// Refcount balance for a read through a deref of a MANAGED call result:
// `(*mkBox(i)).inner.v`.  The @Box the ctor returns is an anonymous temp; the
// deref arm addresses through it (no copy), so the temp must still be RefDec'd
// at end of statement — releasing the ref its `.inner = i` store took on `i`.
// A leaked temp keeps that ref (i's refcount stays 2); a double-free crashes.
// Thread `i` (rc 1) through the read in a helper that drops its locals, then
// re-read i's refcount — it must return to 1.

type Inner struct { v int }
type Box struct { inner @Inner }

func mkBox(i @Inner) @Box {
	var b @Box = make(Box)
	b.inner = i
	return b
}

func readThroughDerefCall(i @Inner) int {
	return (*mkBox(i)).inner.v
}

func main() {
	var a @Inner = make(Inner)
	a.v = 7
	var pa *uint8 = bit_cast(*uint8, a)
	var r int = readThroughDerefCall(a)
	print("r=")
	println(r)
	print("rc=")
	println(rt.Refcount(pa))
}
