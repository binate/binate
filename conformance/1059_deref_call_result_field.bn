package "main"
import "pkg/builtins/testing"

// Field access whose base is an explicit deref of a call result — `(*mkT()).f`
// / `(*mkBox()).h.inner.v` — and the mirror lvalue `(*ptr).field = v`.
//
// Two IR-gen requirements: getSelectorType's `*x` arm must peel the managed-ptr
// elem (a TYP_NAMED wrapper over the struct) — left UNPEELED, the SELECTOR
// classifier's bare TYP_STRUCT test misses it, a func-value-field callee types
// to nil and is dispatched as a direct call on an empty symbol (link error), and
// a nested read gets no inner type; and genSelectorPtr needs an arm for a
// `(*P).field` / `call().field` base — without it a nested access / assignment
// through one hits the unresolved-selector panic.  The genSelectorPtr deref arm
// addresses THROUGH the pointer (`&*P == P`), so `(*ptr).field = v` writes to
// the pointee, not a silently-discarded copy.

type Point struct { x int }
type Inner struct { v int }
type Holder struct { inner @Inner }
type Box struct { h @Holder; p Point; n int }
type T struct { f *func(int) int }

func add1(x int) int { return x + 1 }

func mkT() @T {
	var t @T = make(T)
	t.f = add1
	return t
}

func mkBox() @Box {
	var b @Box = make(Box)
	b.h = make(Holder)
	b.h.inner = make(Inner)
	b.h.inner.v = 42
	b.p.x = 7
	b.n = 3
	return b
}

func main() {
	// func-value field call reached through a deref of the call result
	testing.Println((*mkT()).f(3))            // 4
	// nested read through managed-ptr fields off a deref-of-call base
	testing.Println((*mkBox()).h.inner.v)     // 42
	// by-value struct field read off a deref-of-call base
	testing.Println((*mkBox()).p.x)           // 7
	// auto-deref call base (no explicit star)
	testing.Println(mkBox().p.x)              // 7
	// lvalue writes through an explicit deref of a pointer variable
	var bx @Box = mkBox()
	(*bx).n = 55
	testing.Println(bx.n)                     // 55
	(*bx).p.x = 99
	testing.Println(bx.p.x)                   // 99
	(*bx).h.inner.v = 100
	testing.Println(bx.h.inner.v)             // 100
}
