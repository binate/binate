package "main"

import "pkg/fwd"

// A same-package generic function, also used as a func value.
func Dup[T any](x T) T { return x }

type Holder struct {
	fn @func(int) int
}

func apply(f @func(int) int, x int) int {
	return f(x)
}

func mk() @func(int) int {
	return fwd.Ident[int] // exposed generic instance as a return value
}

// Exercises an EXPOSED generic FUNCTION (fwd exposing pkg/glib) used as a func
// VALUE (not directly called) in every func-value slot: inferred `var`, explicit
// `@func` / `*func` `var`, `:=`, call argument, return value, struct field, and
// plain reassignment.  The forwarder spelling `fwd.Ident[int]` must
// monomorphize/mangle to its HOME `pkg/glib.Ident[int]` on every path — the
// generic-func-VALUE counterpart of 1046's call form (`fwd.Ident[int](7)`).
func main() {
	var a = fwd.Ident[int] // exposed inferred var
	println(a(1))
	var b @func(int) int = fwd.Ident[int] // exposed explicit @func
	println(b(2))
	c := fwd.Ident[int] // exposed :=
	println(c(3))
	var d = Dup[int] // same-pkg inferred var (complement)
	println(d(4))
	println(apply(fwd.Ident[int], 5)) // call argument
	var e = mk() // return value
	println(e(6))
	var h = Holder{fn: fwd.Ident[int]} // struct field
	println(h.fn(7))
	var g *func(int) int = fwd.Ident[int] // exposed explicit *func (raw)
	println(g(8))
	a = fwd.Ident[int] // plain reassignment of an existing func-value var
	println(a(9))
}
