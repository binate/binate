package "main"

// Assigning to — or taking the address of — a field of a non-addressable value (a
// by-value struct returned by a call) has no backing storage: the store would
// land in a discarded copy (a silent no-op, and a managed field would leak).
// Rejected like `&getStruct()`.  A field reached THROUGH a pointer-returning call
// (`mkPtr().x`) stays legal — that is addressable through the pointer.

type W struct { x int }

func getW() W { var w W; return w }

func main() {
	getW().x = 99
	var p *int = &getW().x
	_ = p
}
