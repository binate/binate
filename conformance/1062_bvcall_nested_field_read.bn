package "main"

// Reading a field off a BY-VALUE struct returned by a call, including the nested
// read `getW().sub.y` through a by-value intermediate field — which panicked
// ("unresolved selector in IR-gen") because genSelectorPtr had no by-value-call
// arm.  It now materializes the non-addressable call temporary for the READ (the
// checker rejects WRITING to such a field — see 1061_err_assign_to_call_field —
// so this arm is read-only and cannot store into the discarded copy).  The
// managed-pointer-intermediate form `getW().mp.v` already worked (a different
// genSelector path); kept here as a control.

type Inner struct { v int }
type Sub struct { y int }
type W struct { sub Sub; mp @Inner; n int }

func getW() W {
	var w W
	w.sub.y = 42
	w.mp = make(Inner)
	w.mp.v = 7
	w.n = 3
	return w
}

func main() {
	println(getW().n)       // 3  — single-level scalar field
	println(getW().sub.y)   // 42 — nested read through a by-value intermediate
	println(getW().mp.v)    // 7  — nested read through a managed-ptr intermediate
}
