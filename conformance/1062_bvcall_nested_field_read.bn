package "main"
import "pkg/builtins/testing"

// Reading a field off a BY-VALUE struct returned by a call, including the nested
// read `getW().sub.y` through a by-value intermediate field.  genSelectorPtr's
// by-value-call arm materializes the non-addressable call temporary for the READ;
// without it IR-gen panics ("unresolved selector in IR-gen").  The checker rejects
// WRITING to such a field — see 1061_err_assign_to_call_field — so this arm is
// read-only and cannot store into the discarded copy.  The
// managed-pointer-intermediate form `getW().mp.v` takes a different genSelector
// path; kept here as a control.

type Inner struct { v int }
type Sub struct { y int }
type W struct { sub Sub; mp @Inner; n int }

func getW() W {
	var w W
	w.sub.y = 42
	w.mp = make(Inner)
	w.mp.v = 7
	w.n = 3
	return w
}

func main() {
	testing.Println(getW().n)       // 3  — single-level scalar field
	testing.Println(getW().sub.y)   // 42 — nested read through a by-value intermediate
	testing.Println(getW().mp.v)    // 7  — nested read through a managed-ptr intermediate
}
