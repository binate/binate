package "main"

import "pkg/builtins/rt"

// A managed-slice whose element is a readonly MANAGED pointer (`@[]readonly
// @Node`) must (1) BUILD — its dtor body must dispatch the element on its
// underlying managed-pointer kind, not fall through to a never-generated
// `__dtor_mp_Node` helper (a link failure) — and (2) RefDec each element exactly
// once when the slice is destroyed, so the managed elements are neither leaked
// nor double-freed.  readonly is transparent to destruction.
type Node struct { x int }

// Build a mutable @[]@Node holding n, return it as @[]readonly @Node (the
// element-readonly widening); the returned slice solely owns the backing.
func makeRO(n @Node) @[]readonly @Node {
	var m @[]@Node = make_slice(@Node, 1)
	m[0] = n
	return m
}

func main() {
	var n @Node = make(Node)
	var p *uint8 = bit_cast(*uint8, n)
	println(rt.Refcount(p)) // 1
	if true {
		var ro @[]readonly @Node = makeRO(n)
		println(rt.Refcount(p)) // 2 — n is held by the readonly slice
		println(len(ro))        // 1
		// ro drops at block exit: its dtor RefDec's the element back to 1
	}
	println(rt.Refcount(p)) // 1 — RefDec'd exactly once (leak would print 2)
}
