package "main"
import "pkg/builtins/testing"

// Indexing a BY-VALUE array returned by a call, then reading off the element:
// `getStructs()[0].x` (field), `getInts()[0]` (scalar), `getNested()[0].sub.y`
// (a two-level nested read).  genIndex materializes the array call-result temp for
// the value read; genIndexPtr materializes it for the element pointer a field /
// nested read needs — previously a clang type mismatch (`[N x T]` lowered as a
// `{ptr,len}` slice) or an "unresolved selector" panic (two-level).  The base call
// is evaluated EXACTLY ONCE (a prior nil element-pointer made genSelector re-emit
// the call).

type Sub struct { y int }
type P struct { x int }
type Nest struct { sub Sub }

var structCalls int = 0

func getStructs() [2]P {
	structCalls = structCalls + 1
	var a [2]P
	a[0].x = 5
	a[1].x = 9
	return a
}

func getInts() [3]int { var a [3]int; a[0] = 7; a[2] = 11; return a }

func getNested() [2]Nest { var a [2]Nest; a[0].sub.y = 42; return a }

func main() {
	testing.Println(getStructs()[0].x)   // 5  — field read off an array-call element
	testing.Println(getStructs()[1].x)   // 9
	var p P = getStructs()[0]    // whole-element value read
	testing.Println(p.x)                 // 5
	testing.Println(getInts()[0])        // 7  — scalar element
	testing.Println(getInts()[2])        // 11
	testing.Println(getNested()[0].sub.y) // 42 — two-level nested read
	// Each `getStructs()[...]` above evaluated its call exactly once (3 reads).
	testing.Println(structCalls)         // 3  — NOT 6 (no double-eval)
}
