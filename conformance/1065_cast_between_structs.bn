package "main"
import "pkg/builtins/testing"

// A cast between two DISTINCT struct types of the same layout reinterprets the
// bytes (spec §8.5).  Previously emitted invalid LLVM (the result was declared
// with the source struct type `%A` but used as `%B`); now a scratch-alloca
// store/load reinterpret yields a valid dst-typed value.

type A struct { x int; y int }
type B struct { x int; y int }

func main() {
	var a A
	a.x = 3
	a.y = 4
	var b B = cast(B, a)
	testing.Println(b.x)           // 3
	testing.Println(b.y)           // 4
	testing.Println(cast(B, a).x)  // 3  — inline field access off the cast result
}
