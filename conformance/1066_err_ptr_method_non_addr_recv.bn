package "main"

// A pointer-receiver (`*T`) method auto-takes the address of a VALUE receiver;
// that address must exist.  Calling it on a NON-addressable receiver — a field of
// a by-value call result — is rejected (Go's rule, the mirror of the
// getStruct().field = v reject).  Otherwise the method mutates a discarded copy:
// the mutation is silently lost and a managed store would leak.

type Inner struct { v int }
type Box struct { inner Inner }

func (p *Inner) bump() { p.v = p.v + 1 }

func getBox() Box { var b Box; return b }

func main() { getBox().inner.bump() }
