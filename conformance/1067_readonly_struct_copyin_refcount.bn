package "main"

import "pkg/builtins/rt"

// A by-value `readonly S` copy must acquire (copy-in RefIncs S's managed fields)
// so that its scope-exit dtor is BALANCED.  needsStructCopy was readonly-blind:
// it skipped the copy-in for `readonly S` but the release side still ran the
// dtor → an unbalanced RefDec → premature free / use-after-free on valid code.
type Child struct { v int }
type S struct { c @Child }

func main() {
	var child @Child = make(Child)
	var p *uint8 = bit_cast(*uint8, child)
	var base S
	base.c = child          // base.c holds a ref
	println(rt.Refcount(p)) // 2
	if true {
		var rs readonly S = base // copy-in must RefInc rs.c
		println(rt.Refcount(p))  // 3 (readonly-blind copy skip printed 2)
		// rs drops: its dtor RefDec's rs.c back to 2
	}
	println(rt.Refcount(p)) // 2 (readonly-blind bug printed 1 — a premature dec)
}
