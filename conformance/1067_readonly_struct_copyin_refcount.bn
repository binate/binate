package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A by-value `readonly S` copy must acquire (copy-in RefIncs S's managed fields)
// so that its scope-exit dtor is BALANCED.  A readonly-blind needsStructCopy
// skips the copy-in for `readonly S` while the release side still runs the
// dtor → an unbalanced RefDec → premature free / use-after-free on valid code.
type Child struct { v int }
type S struct { c @Child }

func main() {
	var child @Child = make(Child)
	var p *uint8 = bit_cast(*uint8, child)
	var base S
	base.c = child          // base.c holds a ref
	testing.Println(rt.Refcount(p)) // 2
	if true {
		var rs readonly S = base // copy-in must RefInc rs.c
		testing.Println(rt.Refcount(p))  // 3 (a readonly-blind copy that skips the RefInc prints 2)
		// rs drops: its dtor RefDec's rs.c back to 2
	}
	testing.Println(rt.Refcount(p)) // 2 (a readonly-blind copy prints 1 — a premature dec)
}
