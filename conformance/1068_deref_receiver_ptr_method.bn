package "main"
import "pkg/builtins/testing"

// A `*T`-receiver method called through an EXPLICIT deref `(*p).m()` must mutate the
// pointee, not a discarded copy of `*p`.  `&(*p) == p`, so genMethodCall evaluates the
// POINTER operand p (once) and applyReceiverConversion passes it straight through as
// the receiver address.  Covers a raw pointer, a managed pointer, and — critically — a
// deref of a SIDE-EFFECTING call `(*getPtr()).m()`: p is evaluated exactly once and the
// mutation lands on the object that call returned (evaluating `*p` then re-deriving the
// address would run the call twice and mutate the wrong object).

type Inner struct { v int }

func (p *Inner) bump() { p.v = p.v + 100 }

var a Inner
var b Inner
var calls int = 0

func getPtr() *Inner {
	calls = calls + 1
	if calls == 1 { return &a }
	return &b
}

func main() {
	var i Inner
	i.v = 1
	var p *Inner = &i
	(*p).bump()
	testing.Println(i.v)        // 101 — raw-pointer explicit deref

	var j @Inner = make(Inner)
	j.v = 2
	(*j).bump()
	testing.Println(j.v)        // 102 — managed-pointer explicit deref

	var k Inner
	k.v = 3
	k.bump()            // auto-deref (control)
	testing.Println(k.v)        // 103

	a.v = 10
	b.v = 20
	(*getPtr()).bump()  // deref of a side-effecting call
	testing.Println(a.v)        // 110 — a (what getPtr returned) is mutated
	testing.Println(b.v)        // 20  — b untouched
	testing.Println(calls)      // 1   — getPtr evaluated exactly once
}
