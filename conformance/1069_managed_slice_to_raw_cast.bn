package "main"
import "pkg/builtins/testing"

// `cast(*[]T, m)` where m is a managed-slice `@[]T` is the managed→raw slice decay
// (spec §7.6): a {data,len} field extraction from the 4-word %BnManagedSlice into a
// 2-word %BnSlice — the explicit-cast form of the implicit decay that already works
// for args / assignment / return.  A plain OP_CAST mis-declared the result's LLVM
// type (`%BnManagedSlice` used as `%BnSlice`) → clang error; now it emits the same
// OP_MANAGED_TO_RAW as the implicit decay.  The raw slice BORROWS the managed slice's
// backing (no retain); m stays live here, so the reads are valid.

func main() {
	var m @[]int = make_slice(int, 3)
	m[0] = 10
	m[1] = 20
	m[2] = 30
	var r *[]int = cast(*[]int, m)
	testing.Println(r[0])          // 10
	testing.Println(r[1])          // 20
	testing.Println(len(r))        // 3

	// readonly-element target variant
	var ro *[]readonly int = cast(*[]readonly int, m)
	testing.Println(ro[2])         // 30
	testing.Println(len(ro))       // 3
}
