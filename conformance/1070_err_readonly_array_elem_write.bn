package "main"

// Writing an element (or a field of an element) of a `readonly` ARRAY is rejected —
// including via `++`/`--`.  A readonly array is a read-only VALUE, so its elements
// inherit the const, just like a readonly struct's fields.  checkIndexExpr re-wraps
// the element in `readonly` for a readonly array (but NOT for a slice/pointer, whose
// outer readonly is handle-const): an index that peels the wrapper yields a
// plain-`int` element type that slips past the assignment-target const check.  The
// ++/-- handler applies the same const-location guard as the `=` / `+=` paths.

type P struct { x int }

func main() {
	var r readonly [3]int
	r[1] = 5           // rejected — element of a readonly array
	r[2]++             // rejected — ++ on a readonly-array element

	var q readonly [2]P
	q[0].x = 5         // rejected — field of a readonly-array element
}
