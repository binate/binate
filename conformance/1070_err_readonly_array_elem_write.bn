package "main"

// Writing an element (or a field of an element) of a `readonly` ARRAY is rejected —
// including via `++`/`--`.  A readonly array is a read-only VALUE, so its elements
// inherit the const, just like a readonly struct's fields.  Indexing used to peel
// the `readonly` wrapper, yielding a plain-`int` element type that slipped past the
// assignment-target const check; checkIndexExpr now re-wraps the element in
// `readonly` for a readonly array (but NOT for a slice/pointer, whose outer readonly
// is handle-const), and the ++/-- handler gained the same const-location guard the
// `=` / `+=` paths already have.

type P struct { x int }

func main() {
	var r readonly [3]int
	r[1] = 5           // rejected — element of a readonly array
	r[2]++             // rejected — ++ on a readonly-array element

	var q readonly [2]P
	q[0].x = 5         // rejected — field of a readonly-array element
}
