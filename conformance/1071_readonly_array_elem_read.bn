package "main"
import "pkg/builtins/testing"

// Reading an element of a `readonly` array (and passing an array as a `readonly
// [N]T` parameter, then reading its elements) stays legal — only writes are
// rejected (see 1070).  The readonly element value copies out to a mutable local.

func sum(r readonly [3]int) int { return r[0] + r[1] + r[2] }

func main() {
	var a [3]int
	a[0] = 1
	a[1] = 2
	a[2] = 3
	testing.Println(sum(a))        // 6  — pass as readonly [3]int, read elements

	var r readonly [3]int
	var x int = r[0]       // read a readonly element into a mutable local
	testing.Println(x)             // 0
}
