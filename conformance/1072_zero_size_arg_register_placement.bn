package "main"
import "pkg/builtins/testing"

// A zero-size struct (`struct{}` / `[0]T`) passed BY VALUE as a call argument
// occupies ZERO argument words — it carries no bytes.  This pins two things
// beyond conformance/1029 (which passes a zero-size value as a METHOD RECEIVER):
//
//   1. A plain by-value ARGUMENT sourced from a slice element (`f(arr[1], n)`)
//      must not materialize a spurious argument word.  When the native backends
//      counted a zero-size arg as one word (the argWords min-of-1), the caller
//      loaded that word from the element's address — which for a zero-size slice
//      element is mis-slotted (the same defect as 1029) — and dereferenced
//      garbage: SIGSEGV.  Zero words means nothing is materialized.
//   2. An argument that FOLLOWS the zero-size arg lands in the next slot as if the
//      zero-size arg were absent, matching LLVM.
//
// Sourcing the zero-size values from slice elements makes the pre-fix native path
// actually fault, so this is a real regression guard, not just a behavior lock.

type Empty struct {}

func emptyThenInt(e Empty, n int) int { return n }
func intThenEmpty(n int, e Empty) int { return n }
func aroundInt(a Empty, n int, b Empty) int { return n }

func main() {
	var e Empty
	var arr @[]Empty = make_slice(Empty, 3)
	arr[0] = e
	testing.Println(emptyThenInt(arr[1], 42))      // zero-size arg (slice elem) before an int
	testing.Println(intThenEmpty(7, arr[2]))       // int before a zero-size arg (slice elem)
	testing.Println(aroundInt(arr[0], 99, arr[1])) // zero-size args on both sides of an int
}
