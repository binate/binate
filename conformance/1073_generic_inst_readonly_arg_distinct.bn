package "main"
import "pkg/builtins/testing"

// A generic instantiated with a `readonly`-qualified type argument is a DISTINCT
// monomorphization from the non-readonly one: Box[@[]readonly char] and Box[@[]char]
// have different method signatures (get() returns @[]readonly char vs @[]char), so the
// instantiation cache must keep them distinct.  The cache once keyed on Identical,
// which peels `readonly`, so whichever variant was instantiated FIRST won the cache
// slot for BOTH: the earlier Box[@[]readonly char] here poisoned the later Box[@[]char],
// whose get() then returned @[]readonly char and failed to assign to a @[]char local
// ("cannot assign @[]readonly uint8 to @[]uint8").  The fix keys the cache on a
// readonly-significant identity (IdenticalStrict).

type Box[T any] struct { v T }

func (b @Box[T]) get() T { return b.v }

// Instantiated FIRST so the readonly variant populates the cache before the plain one.
func poison() {
	var ro @Box[@[]readonly char] = make(Box[@[]readonly char])
	_ = ro
}

func main() {
	poison()
	var b @Box[@[]char] = make(Box[@[]char])
	var x @[]char = b.get() // must stay @[]char, not the poisoned @[]readonly char
	testing.Println(len(x))         // 0 (empty box)
}
