package "main"

// Boxing a name-less type into a RAW `*any` must produce a WELL-FORMED
// interface value, so a later type-compare misses cleanly instead of
// dereferencing a garbage vtable word and crashing (the slice-box crash;
// plan-slice-type-identity.md Phase 0).  A name-less type (slice, array,
// func-value, and any pointer nesting over them) has no nominal RTTI identity,
// so it can never be a `case` target (§11.12 rejects such an assertion target)
// — every concrete compare over such a box is therefore a guaranteed MISS: a
// type switch falls to `default`, a comma-ok assertion yields `ok == false`.
// A named type (int) still HITS through the same paths (regression guard).

// classify: a type switch whose only concrete case is a named type.  A
// name-less box reaches `default`; an `*int` box hits `case *int:`.
func classify(v *any) @[]char {
	switch v.(type) {
	case *int:
		return "int"
	default:
		return "default"
	}
}

// isInt: a comma-ok assertion to a named type.  false for a name-less box.
func isInt(v *any) @[]char {
	i, ok := v.(*int)
	_ = i
	if ok {
		return "true"
	}
	return "false"
}

func helper() int {
	return 0
}

func main() {
	var n int = 7
	var s @[]char = "hi"                     // managed-slice (name-less, has backing)
	var r *[]readonly char = s[0:len(s)]     // raw-slice (name-less, no dtor)
	var p *@[]char = &s                      // pointer-to-slice (name-less through nesting)
	var a [3]int                             // array (name-less)
	var f *func() int = helper               // func-value (name-less)

	// Boxes over name-less sources of every kind: each compare is a clean
	// miss, no crash — including the nested-pointer case, which peels to a
	// slice base and so must still take the well-formed sentinel path.
	println(classify(&s)) // default
	println(classify(&r)) // default
	println(classify(&p)) // default
	println(classify(&a)) // default
	println(classify(&f)) // default
	println(isInt(&s))    // false
	println(isInt(&p))    // false

	// A named type still hits through the same switch / assertion paths.
	println(classify(&n)) // int
	println(isInt(&n))    // true
}
