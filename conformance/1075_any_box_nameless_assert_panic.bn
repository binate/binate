package "main"

// The expr-form (single-result) type assertion over a name-less `*any` box
// MISSES — a slice has no nominal identity, so it never matches a named target
// — and must PANIC cleanly via rt.AssertFail (reading the box's opaque-sentinel
// TypeInfo name for the message) instead of dereferencing a garbage vtable and
// segfaulting.  This is the one path that reads the sentinel record's interior
// (readTypeInfoName), which the no-crash test (1074) does not exercise.  The
// panic's dynamic-type name is not asserted here: every name-less type shares
// one sentinel record, so the name shown is whichever registered first — the
// stable part is the "type assertion failed" itself.

func main() {
	var s @[]char = "hi"
	var v *any = &s
	var i *int = v.(*int) // MISS → clean assertion-failure panic, not a segfault
	_ = i
	println("unreachable")
}
