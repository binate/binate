package "main"

// The expr-form (single-result) type assertion over a name-less `*any` box
// MISSES — a slice has no nominal identity, so it never matches a named target
// — and must PANIC cleanly via rt.AssertFail (reading the box's `__typeinfo`
// name for the message) instead of dereferencing a garbage vtable and
// segfaulting.  This is the one path that reads the sentinel record's interior
// (readTypeInfoName), which the no-crash test (1074) does not exercise.
//
// It also GUARDS the per-type structural identity: a `@[]char` box is created
// FIRST (registering its own `__typeinfo`), then the failing assertion is over
// a DIFFERENT `*[]int` box.  Each name-less type has its OWN record, so the
// panic names the box's actual dynamic type (`*[]int`) — NOT the first-boxed
// type.  Under a single shared-opaque record the message would instead show the
// first registrant (`@[]uint8`), so pinning `*[]int` here fails if the boxing
// site ever regresses to a shared identity.

// forceBox forces a name-less box (and thus its `__typeinfo` registration) for
// `v`.  (`box` is a reserved builtin keyword, so the helper can't be named it.)
func forceBox(v *any) {
	switch v.(type) {
	case *int:
		return
	default:
		return
	}
}

func main() {
	var s @[]char = "hi"
	forceBox(&s) // register the @[]char identity first

	var xs *[]int = make_slice(int, 2)
	var w *any = &xs
	var i *int = w.(*int) // MISS over the *[]int box → clean panic naming *[]int
	_ = i
	println("unreachable")
}
