package "main"

// A name-less box must keep element-`readonly` in its structural identity, so
// `*[]readonly char` and `*[]char` get DISTINCT identities.  Correctness, not
// cosmetics: if they shared one identity, a later `case *[]char:` would recover
// a readonly slice as MUTABLE, letting code write through readonly data.  The IR
// strips `readonly` from instruction types (layout-transparent), so the box
// recovers element-`readonly` from the source expression's checker type.
//
// This boxes a MUTABLE `*[]char` FIRST (registering its identity), then fails an
// assertion over a `*[]readonly char` box.  Each name-less type keys its OWN
// `__typeinfo`, so the panic names the readonly box's own type
// ("*[]readonly uint8") — NOT the mutable first-registrant.  A dropped-`readonly`
// identity would collapse both to one record and name the mutable "*[]uint8", so
// pinning "*[]readonly uint8" here proves the two stay DISTINCT.  (`char` is an
// alias of `uint8`, so the name shows `uint8`.)

// forceBox registers `v`'s name-less identity.
func forceBox(v *any) {
	switch v.(type) {
	case *int:
		return
	default:
		return
	}
}

func main() {
	var m @[]char = "hi"
	var mut *[]char = m[0:len(m)]
	forceBox(&mut) // register the MUTABLE `*[]char` identity first

	var ro *[]readonly char = m[0:len(m)]
	var v *any = &ro
	var i *int = v.(*int) // MISS → panic names *[]readonly uint8, not the mutable *[]uint8
	_ = i
	println("unreachable")
}
