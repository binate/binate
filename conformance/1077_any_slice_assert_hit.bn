package "main"

// A SLICE is a type-assertion / type-switch TARGET that HITS and recovers the
// slice value (§11.12 `iface.assert.slice`) — the piece that lets a formatter
// recognize a string (a raw char-slice) boxed into `*any`.  The match keys the
// slice target on the SAME structural name-less identity the box side stamped
// (namelessAnySrcName), and recovery LOADS the slice value through the box's
// `&s` data pointer.  Covers the type-switch binder recovery (`@[]char` case →
// the bytes) and the comma-ok expression form.

func classify(v *any) {
	switch x := v.(type) {
	case @[]char:
		println("string")
		println(x) // recovered @[]char — the bytes
	case *int:
		println("int")
	default:
		println("default")
	}
}

func main() {
	var s @[]char = "hello"
	classify(&s) // string / hello

	var n int = 7
	classify(&n) // int

	var xs *[]int = make_slice(int, 2)
	classify(&xs) // default (a distinct name-less slice type)

	// Comma-ok expression form recovers the same value.
	var v *any = &s
	got, ok := v.(@[]char)
	if ok {
		println(got) // hello
	} else {
		println("miss")
	}
}
