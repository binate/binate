package "main"
import "pkg/builtins/testing"

// §5.1 exact-match distinctness for a slice assertion target: element-`readonly`
// and managed-vs-raw are DISTINCT identities.  So a `case @[]char:` does NOT
// recover a `@[]readonly char` box (which would let code write through readonly
// data — the correctness hole this whole feature exists to prevent) nor a
// `*[]char` box, and each of the four spellings recovers only its own.  A
// `*[]int` box (distinct element) hits none of the char cases → default.

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case *[]char:
		return "raw-mutable"
	case *[]readonly char:
		return "raw-readonly"
	default:
		return "default"
	}
}

func main() {
	var m @[]char = "x"
	var mro @[]readonly char = "x"
	var raw *[]char = m[0:len(m)]
	var rro *[]readonly char = m[0:len(m)]
	var xs *[]int = make_slice(int, 1)

	testing.Println(classify(&m))   // mgd-mutable
	testing.Println(classify(&mro)) // mgd-readonly
	testing.Println(classify(&raw)) // raw-mutable
	testing.Println(classify(&rro)) // raw-readonly
	testing.Println(classify(&xs))  // default
}
