package "main"

import "pkg/builtins/rt"

// Refcount balance for recovering a managed `@[]char` from a `*any` box across
// all three forms — comma-ok, type-switch binder, and the expression form.  A
// recovered `@[]char` must acquire exactly ONE reference on the (still-live)
// backing per recovery and release it, so a 100-iteration loop returns the
// backing refcount to its baseline: a leak grows it, a double-free crashes.
// The subtle contract: comma-ok / type-switch recovery is a BORROW (the
// destructure / binder store copy-acquires), while the expression form owns the
// recovered value (RefInc + release at end-of-statement) — either way, balanced.

// readBackingRC reads a managed-slice's backing refcount from word 2 of its
// 4-word header (per conformance/130).
func readBackingRC(p *int) int {
	var backingPtr *uint8 = bit_cast(*uint8, p[2])
	if backingPtr == nil {
		return 0
	}
	return rt.Refcount(backingPtr)
}

func loopCommaOk(v *any) {
	for i := 0; i < 100; i++ {
		got, ok := v.(@[]char)
		if ok {
			_ = len(got)
		}
	}
}

func loopSwitch(v *any) {
	for i := 0; i < 100; i++ {
		switch x := v.(type) {
		case @[]char:
			_ = len(x)
		default:
		}
	}
}

func loopExpr(v *any) {
	for i := 0; i < 100; i++ {
		var got @[]char = v.(@[]char) // expr form — owns +1, released end-of-statement
		_ = len(got)
	}
}

func main() {
	var a @[]char = make_slice(char, 5)
	var pa *int = bit_cast(*int, &a)
	var before int = readBackingRC(pa)
	var v *any = &a

	loopCommaOk(v)
	if before == readBackingRC(pa) {
		println(0)
	} else {
		println(1)
	}

	loopSwitch(v)
	if before == readBackingRC(pa) {
		println(0)
	} else {
		println(1)
	}

	loopExpr(v)
	if before == readBackingRC(pa) {
		println(0)
	} else {
		println(1)
	}
}
