package "main"

// A slice of a NAMED element type (a struct, a managed pointer) is a type-switch
// target that HITS and recovers.  The box side keys the name-less identity on the
// same package-QUALIFIED element name the match side (resolveTypeExpr) uses, via
// the merge that reconciles the box's checker element type (readonly-preserving
// but package-dropped) with the IR type (qualified but readonly-stripped) — so
// @[]Point, @[]@Node, *[]Point are DISTINCT identities and each recovers its own.
// (Before the merge, a named element link-failed / silently missed.)

type Point struct {
	x int
	y int
}

type Node struct {
	v int
}

func classify(v *any) @[]char {
	switch x := v.(type) {
	case @[]Point:
		if len(x) >= 1 {
			return "points"
		}
		return "empty"
	case @[]@Node:
		if len(x) >= 1 {
			return "nodes"
		}
		return "empty"
	case *[]Point:
		return "raw-points"
	default:
		return "default"
	}
}

func main() {
	var pts @[]Point = make_slice(Point, 2)
	pts[0].x = 7
	println(classify(&pts)) // points  (same-pkg named struct element)

	var nodes @[]@Node = make_slice(@Node, 1)
	println(classify(&nodes)) // nodes   (managed-pointer element)

	var raw *[]Point = pts[0:2]
	println(classify(&raw)) // raw-points (raw vs managed: distinct)

	var ints @[]int = make_slice(int, 2)
	println(classify(&ints)) // default (distinct element type)
}
