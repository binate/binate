package "main"
import "pkg/builtins/testing"

import "pkg/geom"

// A name-less slice's structural identity must key on the FULLY-QUALIFIED element
// name, so a `@[]main.Point` box and a `@[]geom.Point` box (SAME leaf name, DIFFERENT
// package) get DISTINCT identities and each hits only its own case.  Before the
// qualified-name merge, the box side dropped the package (both -> "Point"), which
// would collide (a wrong HIT / type confusion) or link-fail.

type Point struct {
	mx int
}

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]Point:
		return "main-point"
	case @[]geom.Point:
		return "geom-point"
	default:
		return "default"
	}
}

func main() {
	var mp @[]Point = make_slice(Point, 1)
	var gp @[]geom.Point = geom.Make()
	testing.Println(classify(&mp)) // main-point (NOT geom-point — no collision)
	testing.Println(classify(&gp)) // geom-point (NOT main-point)
}
