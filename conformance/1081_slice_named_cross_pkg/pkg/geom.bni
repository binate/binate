package "pkg/geom"

// A struct named `Point` — deliberately the SAME leaf name as main.Point, in a
// different package, to prove a name-less slice's structural identity is keyed on
// the FULLY-QUALIFIED element name (so @[]geom.Point and @[]main.Point do NOT
// collide, and each recovers only its own).
type Point struct {
	gx int
}

// Make returns a fresh @[]Point the importer can box into *any.
func Make() @[]Point
