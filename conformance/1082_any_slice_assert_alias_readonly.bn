package "main"
import "pkg/builtins/testing"

// A transparent alias that HIDES element-`readonly` (`type ROChar = readonly char`)
// must NOT lose the readonly in a name-less box's structural identity.  The box
// side resolves the alias (via stripConstForIR) and re-inserts the readonly it
// exposes; if it dropped it, a `@[]ROChar` box would wrongly HIT `case @[]char:`
// and hand back a MUTABLE slice over readonly data — a write-through-readonly hole.
// So `@[]ROChar` (≡ `@[]readonly char`) recovers only at `case @[]readonly char:`,
// never `case @[]char:`.  A plain-alias (non-readonly) `@[]MutChar` (≡ `@[]char`)
// conversely DOES hit `case @[]char:` — a transparent alias is otherwise invisible.
//
// The reverse direction must hold too: an alias spelled in the CASE LABEL (`case
// @[]ROChar:`) resolves on the match side (resolveTypeExpr) to the same identity,
// so a LITERAL `@[]readonly char` box hits `case @[]ROChar:` and a literal
// `@[]char` box hits `case @[]MutChar:`.

type ROChar = readonly char
type MutChar = char

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	default:
		return "default"
	}
}

// classifyViaAlias spells its case labels with the ALIASES, exercising target-side
// alias resolution: a literal-spelled box must still match the aliased case.
func classifyViaAlias(v *any) @[]char {
	switch v.(type) {
	case @[]MutChar:
		return "alias-mutable"
	case @[]ROChar:
		return "alias-readonly"
	default:
		return "default"
	}
}

func main() {
	var ro @[]ROChar = "x"
	var mut @[]MutChar = make_slice(MutChar, 1)
	testing.Println(classify(&ro))  // mgd-readonly (NOT mgd-mutable — alias must not drop readonly)
	testing.Println(classify(&mut)) // mgd-mutable (a plain alias is transparent)

	var litRo @[]readonly char = "y"
	var litMut @[]char = make_slice(char, 1)
	testing.Println(classifyViaAlias(&litRo))  // alias-readonly (literal readonly hits aliased case)
	testing.Println(classifyViaAlias(&litMut)) // alias-mutable (literal char hits aliased case)
}
