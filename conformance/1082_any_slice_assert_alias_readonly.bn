package "main"

// A transparent alias that HIDES element-`readonly` (`type ROChar = readonly char`)
// must NOT lose the readonly in a name-less box's structural identity.  The box
// side resolves the alias (via stripConstForIR) and re-inserts the readonly it
// exposes; if it dropped it, a `@[]ROChar` box would wrongly HIT `case @[]char:`
// and hand back a MUTABLE slice over readonly data — a write-through-readonly hole.
// So `@[]ROChar` (≡ `@[]readonly char`) recovers only at `case @[]readonly char:`,
// never `case @[]char:`.  A plain-alias (non-readonly) `@[]MutChar` (≡ `@[]char`)
// conversely DOES hit `case @[]char:` — a transparent alias is otherwise invisible.

type ROChar = readonly char
type MutChar = char

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	default:
		return "default"
	}
}

func main() {
	var ro @[]ROChar = "x"
	var mut @[]MutChar = make_slice(MutChar, 1)
	println(classify(&ro))  // mgd-readonly (NOT mgd-mutable — alias must not drop readonly)
	println(classify(&mut)) // mgd-mutable (a plain alias is transparent)
}
