package "main"

import "pkg/qvt"

// Regression: a bare package-qualified value type (`qvt.V`) as an EXPLICIT
// generic type argument.  bnc previously rejected it ("unsupported
// type-argument form"; the type-arg resolved to void) because typeArgFromExpr
// had no EXPR_SELECTOR case — only EXPR_IDENT (unqualified) and the `@`-
// qualified EXPR_TYPE form were accepted.  Want: 7.
func main() {
	var v qvt.V = qvt.Zero[qvt.V]()
	v.X = 7
	println(v.X)
}
