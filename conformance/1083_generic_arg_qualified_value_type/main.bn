package "main"
import "pkg/builtins/testing"

import "pkg/qvt"

// A bare package-qualified value type (`qvt.V`) as an EXPLICIT generic type
// argument.  typeArgFromExpr needs an EXPR_SELECTOR case besides EXPR_IDENT
// (unqualified) and the `@`-qualified EXPR_TYPE form; without it bnc rejects the
// program ("unsupported type-argument form"; the type-arg resolves to void).
// Want: 7.
func main() {
	var v qvt.V = qvt.Zero[qvt.V]()
	v.X = 7
	testing.Println(v.X)
}
