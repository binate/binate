package "pkg/qvt"

// V is a by-value struct, used as a package-qualified generic type argument
// (`qvt.V`) at the call site in main.
type V struct {
	X int
}

// Zero returns a zero-valued T.  It takes NO argument, so T cannot be inferred
// — the call site must spell T explicitly.  `Zero[qvt.V]()` therefore forces
// the type-argument resolver to accept a bare package-qualified value type.
func Zero[T any]() T {
	var z T
	return z
}
