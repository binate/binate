package "main"

// Value-recovery type assertion (§11.12): a type switch over a `*any` recovers a
// SCALAR arg BY VALUE (`case int:` LOADs the int through the box's data pointer),
// the piece a type-erased formatter needs to render non-string args.  Covers int /
// bool / float / char, a string (slice recovery, already landed), and an unmatched
// type (→ default).  Args are `&`-boxed into the `...*any` variadic.  Each case
// verifies the RECOVERED VALUE (not just the matched case) via a comparison, so a
// wrong load would print a `-BAD` marker.

func render(args ...*any) {
	for i := 0; i < len(args); i++ {
		switch x := args[i].(type) {
		case int:
			if x == 42 { println("int-42") } else { println("int-BAD") }
		case bool:
			if x { println("bool-BAD") } else { println("bool-false") }
		case float64:
			if x == 2.5 { println("float-2.5") } else { println("float-BAD") }
		case int8:
			// A signed SUB-WORD field: exercises the VM extract's sign-extension
			// (a negative value must not come back zero-extended / positive).
			if x == -5 { println("int8-neg5") } else { println("int8-BAD") }
		case char:
			var s @[]char = make_slice(char, 1)
			s[0] = x
			println(s)
		case *[]readonly char:
			println(x)
		default:
			println("<other>")
		}
	}
}

func main() {
	var n int = 42
	var b bool = false
	var f float64 = 2.5
	var i8 int8 = -5
	var ch char = 'Z'
	var s *[]readonly char = "hi"
	var xs *[]int = make_slice(int, 1)
	render(&n, &b, &f, &i8, &ch, &s, &xs)
}
