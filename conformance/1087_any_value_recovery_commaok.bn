package "main"

// Value-recovery in the comma-ok form (`v, ok := a.(int)`) and the expr form
// (`a.(int)`): a HIT loads the scalar; a MISS yields ok=false — and the comma-ok
// miss path must materialize a valid typed ZERO for the recovered `int` field
// (EmitConstNil would emit a pointer-nil `i8*` that mistypes the scalar field).

func tryInt(a @any) {
	n, ok := a.(int)
	if ok {
		if n == 123 { println("hit-123") } else { println("hit-BAD") }
	} else {
		println("miss")
	}
}

func main() {
	var i int = 123
	var b bool = true
	tryInt(box(i)) // hit-123
	tryInt(box(b)) // miss (a bool box)

	// Expr form over a matching box recovers the value directly.
	var a @any = box(i)
	var got int = a.(int)
	if got == 123 { println("expr-123") } else { println("expr-BAD") }
}
