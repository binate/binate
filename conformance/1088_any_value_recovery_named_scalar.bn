package "main"

// Exact-identity for value-recovery of a NAMED scalar (`type Money int`): a Money
// box is recovered by `case Money:`, NOT `case int:` (Money != int, §11.12 exact
// type), and an int box hits `case int:`, not `case Money:`.  This is the property
// that lets a formatter route a `type Money` with custom formatting away from the
// plain `case int:` fast-path (claude-notes.md:252).  A named scalar recovers by a
// plain load, same as its underlying int (IsScalar / IsInteger see through it).

type Money int

func classify(a @any) {
	switch x := a.(type) {
	case Money:
		if cast(int, x) == 5 { println("money-5") } else { println("money-BAD") }
	case int:
		if x == 7 { println("int-7") } else { println("int-BAD") }
	default:
		println("other")
	}
}

func main() {
	var m Money = 5
	var n int = 7
	classify(box(m)) // money-5
	classify(box(n)) // int-7
}
