package "main"
import "pkg/builtins/testing"

// A `case T:` / `x.(T)` must LINK even when T is never boxed anywhere in the
// program.  The `&__typeinfo.<T>` identity compare needs the record to exist; it is
// emitted at the MATCH site (typeInfoSymFor → ensureAnyImplInfo), not only at box
// sites, so a switch over types the caller never boxes still links (and, with no
// box of T, correctly never matches).  Here ONLY a `*[]int` is boxed; the
// `@[]char` / `*[]readonly char` / `int` cases are never boxed program-wide, yet
// the switch links and falls through to `case *[]int:`.  Before the fix this
// link-failed with an undefined `__typeinfo.__nameless_…` (and `__typeinfo.int`).

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-char"
	case *[]readonly char:
		return "raw-ro-char"
	case int:
		return "int"
	case *[]int:
		return "int-slice"
	default:
		return "default"
	}
}

func main() {
	var xs *[]int = make_slice(int, 1)
	testing.Println(classify(&xs)) // int-slice (the only boxed type; the others still link)
}
