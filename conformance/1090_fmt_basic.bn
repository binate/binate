package "main"

import "pkg/std/fmt"

// End-to-end pkg/stdx/fmt: Print/Println to stdout + Sprint, over the type-erased
// `...*any` variadic — a string (char-slice recovery) and scalars (int / float /
// bool value recovery), with Go's spacing rules.  Operands may be `&`-boxed OR
// passed bare: an addressable value / scalar literal is implicitly value-borrowed
// into `*any`, and a bare STRING LITERAL boxes as its `*[]readonly char`
// char-slice — so `fmt.Print("hi")` prints `hi`, not `%!?(unknown)`.

func main() {
	var name *[]readonly char = "world"
	var n int = 7
	var f float64 = 1.5
	var ok bool = false

	fmt.Println(&name, &n) // world 7
	fmt.Println(&n, &n) // 7 7  (space between non-strings)
	fmt.Println(&f, &ok) // 1.5 false

	var eq *[]readonly char = "n="
	var s @[]readonly char = fmt.Sprint(&eq, &n) // n=7  (string then int: no space)
	fmt.Println(&s) // n=7

	// Bare operands (no `&`): implicit value-borrow into `*any`.
	fmt.Println(name, n) // world 7  (bare addressable variables)
	fmt.Println("hi", 42) // hi 42  (bare string literal + scalar literal)
	var t @[]readonly char = fmt.Sprint("k=", 9) // k=9  (bare literal into Sprint)
	fmt.Println(&t) // k=9
}
