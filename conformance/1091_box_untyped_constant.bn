package "main"
import "pkg/builtins/testing"

// `box(<untyped constant>)` must default the untyped literal to its concrete type
// (int / float64 / bool) before boxing — box takes ANY value, so an untyped
// literal reaches IR-gen with no type context.  Boxing it as `@untyped int` yields
// a DEGENERATE box (no concrete `__typeinfo`), so a later `case int:` MISSES.
// Regression: `box(42)` must recover at `case int:`, not fall to default.

func classify(a @any) @[]char {
	switch x := a.(type) {
	case int:
		if x == 42 { return "int-42" } else { return "int-BAD" }
	case float64:
		if x == 2.5 { return "float-2.5" } else { return "float-BAD" }
	case bool:
		if x { return "bool-true" } else { return "bool-BAD" }
	default:
		return "other"
	}
}

func main() {
	testing.Println(classify(box(42))) // int-42 (untyped int literal)
	testing.Println(classify(box(41 + 1))) // int-42 (untyped arithmetic folds to 42)
	testing.Println(classify(box(2.5))) // float-2.5 (untyped float)
	testing.Println(classify(box(true))) // bool-true (untyped bool)
}
