package "main"

// Calling a nil function value is a recoverable user-code fault (Plan 2): the VM
// unwinds to the host, which prints the message and exits non-zero
// (`runtime error: call of nil function value`), rather than crashing the host.
// Compiled backends stay fatal (nil vtable deref -> SEGV), so this is VM-only.

func main() {
	println("before")
	var f @func() int = nil
	var x int = f()
	_ = x
	println("after")
}
