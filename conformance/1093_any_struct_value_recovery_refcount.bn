package "main"

import "pkg/builtins/rt"

// Refcount balance for recovering a struct with a MANAGED field by value.  The
// recovery LOADs the struct as a BORROW (sharing the box's field references); the
// binder store / comma-ok destructure / var-decl copy-ACQUIRES the managed fields,
// balanced by the recovered value's scope-exit dtor.  A 100-iteration loop must
// return the field backing's refcount to baseline: a leak grows it, a
// double-free / missing-acquire crashes or drops it below baseline.

type Named struct {
	name @[]char
}

// readBackingRC reads a managed-slice field's backing refcount from word 2 of its
// 4-word header (per conformance/130).
func readBackingRC(hdr *int) int {
	var backingPtr *uint8 = bit_cast(*uint8, hdr[2])
	if backingPtr == nil {
		return 0
	}
	return rt.Refcount(backingPtr)
}

func loopSwitch(v *any) {
	for i := 0; i < 100; i++ {
		switch n := v.(type) {
		case Named:
			_ = len(n.name)
		default:
		}
	}
}

func loopCommaOk(v *any) {
	for i := 0; i < 100; i++ {
		n, ok := v.(Named)
		if ok {
			_ = len(n.name)
		}
	}
}

func loopExpr(v *any) {
	for i := 0; i < 100; i++ {
		var n Named = v.(Named)
		_ = len(n.name)
	}
}

func main() {
	var nm Named
	nm.name = make_slice(char, 5)
	var pn *int = bit_cast(*int, &nm.name)
	var before int = readBackingRC(pn)
	var v *any = &nm

	loopSwitch(v)
	if before == readBackingRC(pn) { println(0) } else { println(1) }
	loopCommaOk(v)
	if before == readBackingRC(pn) { println(0) } else { println(1) }
	loopExpr(v)
	if before == readBackingRC(pn) { println(0) } else { println(1) }
}
