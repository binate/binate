package "main"
import "pkg/builtins/testing"

// Struct value-recovery (§11.12): `x.(S)` / `case S:` recovers a struct VALUE from
// an interface box.  The load is a BORROW; the destination (binder / var-decl)
// copy-acquires the struct's managed fields (refcount balance is pinned by 1093).
// Covers a POD struct, a managed-field struct, exact-identity (a Point box does NOT
// hit `case Boxed:`), and the comma-ok hit + miss forms.

type Point struct {
	x int
	y int
}

type Boxed struct {
	p @int
}

func classify(a *any) @[]char {
	switch v := a.(type) {
	case Boxed:
		_ = v.p
		return "boxed"
	case Point:
		if v.x == 3 && v.y == 4 {
			return "point-34"
		}
		return "point-BAD"
	default:
		return "default"
	}
}

func main() {
	var pt Point
	pt.x = 3
	pt.y = 4
	testing.Println(classify(&pt)) // point-34 (exact identity: Point, not Boxed)

	var vp *any = &pt
	q, ok := vp.(Point)
	if ok && q.x == 3 {
		testing.Println("commaok-3")
	} else {
		testing.Println("commaok-BAD")
	}

	_, ok2 := vp.(Boxed)
	if ok2 {
		testing.Println("miss-BAD")
	} else {
		testing.Println("miss-ok")
	}

	var bx Boxed
	bx.p = box(7)
	testing.Println(classify(&bx)) // boxed (managed-field struct; Boxed, not Point)
}
