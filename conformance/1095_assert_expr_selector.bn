package "main"
import "pkg/builtins/testing"

// Selector directly on a type-assertion expression: `x.(S).field` (value
// recovery), `x.(*T).field` / `x.(@T).field` (pointer recovery).  genSelector's
// EXPR_TYPE_ASSERT base arm loads the field off the recovered value/pointer; a
// value-struct base is a borrow (alloca + store + GEP + load, unregistered), so a
// managed field read shares the box's reference without acquiring / releasing.

interface I { foo() }

type Named struct {
	tag int
	name @[]char
}

type PBox struct {
	v int
}

type Mgd struct {
	id int
}

func (m @Mgd) foo() { }
impl @Mgd : I

func main() {
	// Value-recovery selector: a scalar field and a managed field.
	var nm Named
	nm.tag = 7
	nm.name = "hi"
	var a *any = &nm
	testing.Println(a.(Named).tag)       // 7
	testing.Println(len(a.(Named).name)) // 2

	// Raw-pointer-recovery selector.
	var pb PBox
	pb.v = 42
	var b *any = &pb
	testing.Println(b.(*PBox).v) // 42

	// Managed-pointer-recovery selector (through an interface value).
	var mp @Mgd = make(Mgd)
	mp.id = 9
	var c @I = mp
	testing.Println(c.(@Mgd).id) // 9
}
