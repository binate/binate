package "main"
import "pkg/builtins/testing"

// Selector on a type-assertion base: the WRITE forms and CHAINED forms.  A
// type-assertion emits HIT/MISS control flow (the MISS aborts), so a selector
// whose base is an assert splits the block; the recovered pointer/value lives in
// the HIT continuation, and the store / nested field access must land there.
//   - `x.(*T).field = v` / `x.(@T).field = v`: pointer recovery yields a real
//     lvalue, so the store reaches the boxed pointee (regression: it was silently
//     DROPPED when genSelectorPtr lacked an assert arm and left the store in the
//     stale pre-branch block).
//   - `x.(S).a.b`, `x.(*T).a.b = v`: a chained selector on an assert base (once
//     crashed with an `unresolved selector in IR-gen` panic).

interface I { id() int }

type Mgd struct {
	v int
}

func (m @Mgd) id() int {
	return m.v
}
impl @Mgd : I

type Inner struct {
	leaf int
}

type Outer struct {
	inner Inner
}

type HasMgd struct {
	mp @Mgd
	x  int
}

type Pt struct {
	x int
	y int
}

type Grid struct {
	pts [3]Pt
}

func main() {
	// x.(*T).field = v : raw-pointer-recovery write reaches the boxed pointee.
	var o Outer
	o.inner.leaf = 1
	var a *any = &o
	a.(*Outer).inner.leaf = 42
	testing.Println(o.inner.leaf) // 42 (write landed; was silently dropped)

	// x.(S).a.b : chained read on a value-recovery base.
	testing.Println(a.(Outer).inner.leaf) // 42

	// x.(@T).field = v : managed-pointer-recovery write.
	var mp @Mgd = make(Mgd)
	mp.v = 5
	var c @I = mp
	c.(@Mgd).v = 77
	testing.Println(mp.v) // 77

	// x.(S).mp.id : value recovery, then a managed-pointer field, then a scalar.
	var hm HasMgd
	hm.mp = make(Mgd)
	hm.mp.v = 9
	var h *any = &hm
	testing.Println(h.(HasMgd).mp.v) // 9

	// x.(*T).arr[i].field : a field selector on an INDEXED array-field element of an
	// assert base — the index base reaches the assert through genIndexPtr, which
	// splits the block; the GEP/store must land in the HIT continuation.
	var g Grid
	g.pts[1].x = 2
	var gp *any = &g
	testing.Println(gp.(*Grid).pts[1].x) // 2 (read)
	gp.(*Grid).pts[1].x = 42     // write (was dropped / dominance failure)
	testing.Println(g.pts[1].x)          // 42
	testing.Println(gp.(Grid).pts[2].y)  // 0 (value recovery, index, field)

	// *(x.(*T)) = v : deref-assign of a pointer-recovery.  The assert splits the
	// block inside genExpr; the store (and every following statement) must land in
	// the HIT continuation — regression: it was stranded after the branch terminator.
	var n int = 1
	var np *any = &n
	*(np.(*int)) = 55
	testing.Println(n)          // 55
	*(np.(*int)) += 10
	testing.Println(n)          // 65
}
