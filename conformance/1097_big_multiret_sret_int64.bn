package "main"
import "pkg/builtins/testing"

// A large multi-value return whose result tuple exceeds the target's
// return-register budget (>4 GP words on arm32 AAPCS32, >8 on aa64, >3 on x64)
// is returned via a hidden sret buffer, not a first-class-aggregate register
// return.  This guards BOTH the direct call site and the func-value shim: the
// shape (a big multi-return tuple containing an int64) is exactly what LLVM's
// arm32 backend mis-lowered as a raw `ret {…i64…}` FCA, SIGSEGVing
// pkg/binate/asm/parse's TestParseMov on builder-comp_arm32_linux.  Routing it
// through sret (matching the native backends' register-count rule) round-trips
// every field, including the >int32 int64 value, through the retbuf.

type Big struct {
	a int
	b int
	c int
	d int
	e int
	f int
	g int
	h int
	val int64
}

func makeBig(base int, v int64) (Big, int) {
	var r Big
	r.a = base
	r.h = base + 7
	r.val = v
	return r, base * 10
}

func main() {
	// Direct call.
	var r Big
	var n int
	r, n = makeBig(100, 5000000000)
	testing.Println(r.a)
	testing.Println(r.h)
	if r.val == 5000000000 { testing.Println(1) } else { testing.Println(0) }
	testing.Println(n)

	// Same shape through a func-value (exercises the shim's sret convention).
	var fp *func(int, int64) (Big, int) = makeBig
	var r2 Big
	var n2 int
	r2, n2 = fp(200, 6000000000)
	testing.Println(r2.a)
	if r2.val == 6000000000 { testing.Println(1) } else { testing.Println(0) }
	testing.Println(n2)
}
