package "main"

// Block-threading where a type-assertion (or a plain field inc-dec) splits the
// current block in a STATEMENT position the lowering didn't thread:
//   - a for-loop POST statement that splits (a struct-field `++`, or an assert
//     assignment) must run genStmt through ctx.CurBlock and take its continuation,
//     else the increment / loop back-edge is stranded and the loop runs once;
//   - a method VALUE on an assert receiver (`a.(*T).Method`) captures the recovered
//     receiver into the closure — the captures must land in the assert's HIT block.

interface I { get() int }

type Concrete struct {
	v int
}

func (c *Concrete) get() int {
	return c.v
}
impl *Concrete : I

type T struct {
	n int
}

func sum3ByField() int {
	// for-post is a struct-field inc-dec — splits the block internally (no assert).
	// Regression: without threading the loop ran once and returned t.n == 0.
	var t T
	t.n = 0
	var i int = 0
	for i = 0; i < 3; t.n++ {
		i = i + 1
	}
	return t.n
}

func sum3ByAssert() int {
	// for-post is an assert assignment — splits via the MISS-abort branch.
	var t T
	t.n = 0
	var a *any = &t
	var i int = 0
	for i = 0; i < 3; a.(*T).n = a.(*T).n + 1 {
		i = i + 1
	}
	return t.n
}

func main() {
	println(sum3ByField())  // 3 (was 0 — field inc-dec in for-post dropped)
	println(sum3ByAssert()) // 3 (was nothing — assert in for-post lost the back-edge)

	// method value on an assert receiver: `a.(*Concrete).get` captures the recovered
	// *Concrete into a closure (was an invalid-LLVM dominance failure).
	var c Concrete
	c.v = 42
	var a *any = &c
	var f *func() int = a.(*Concrete).get
	println(f()) // 42
}
