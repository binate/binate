package "main"
import "pkg/builtins/testing"

// A large multi-value return dispatched THROUGH AN INTERFACE METHOD.  The result
// tuple (Big, int) exceeds the target's return-register budget (>4 GP words on
// arm32, >8 on aa64, >3 on x64) and so is returned via a hidden sret buffer.  The
// vtable slot points at the sret'd definition, so the iface dispatch must ALSO
// pass an sret pointer (matching emit_debug.bn's def convention and the native
// iface dispatch) — dispatching it register-style would read an unwritten buffer
// / mis-lower the by-value FCA on arm32.  Companion to 1097 (direct + func-value);
// this covers the interface-dispatch path, round-tripping the >int32 int64 field.

type Big struct {
	a int
	b int
	c int
	d int
	e int
	f int
	g int
	h int
	val int64
}

interface Producer {
	makeBig(base int) (Big, int)
}

type Impl struct {
	base int
}

func (im *Impl) makeBig(base int) (Big, int) {
	var r Big
	r.a = base
	r.h = base + 7
	r.val = cast(int64, base) * 100000000
	return r, base * 2
}

impl *Impl : Producer

func main() {
	var imv @Impl = make(Impl)
	imv.base = 5
	var pr @Producer = imv
	var r Big
	var n int
	r, n = pr.makeBig(50)
	testing.Println(r.a)
	testing.Println(r.h)
	if r.val == 5000000000 { testing.Println(1) } else { testing.Println(0) }
	testing.Println(n)
}
