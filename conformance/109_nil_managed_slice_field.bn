package "main"

import "pkg/builtins/testing"

type Container struct {
	Items @[]int
	Name  @[]char
}

func main() {
	var c @Container = make(Container)
	c.Items = make_slice(int, 3)
	c.Items[0] = 10
	c.Items[1] = 20
	c.Items[2] = 30
	c.Name = "hello"

	testing.Println(len(c.Items))
	testing.Println(c.Items[1])
	testing.Println(c.Name)

	// Zero the managed slice field — this must produce a proper zeroinitializer
	var zeroItems @[]int
	c.Items = zeroItems
	if len(c.Items) == 0 {
		testing.Println("empty")
	} else {
		testing.Println("FAIL: Items not empty")
	}

	// Name should still be valid
	testing.Println(c.Name)

	// Re-assign
	c.Items = make_slice(int, 2)
	c.Items[0] = 99
	testing.Println(c.Items[0])
	testing.Println(len(c.Items))
}
