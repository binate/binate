package "main"
import "pkg/builtins/testing"

// A multi-RETURN assignment whose target is an ARRAY-FIELD element on a
// non-identifier base (`ab.arr[2], y = two()`) must store the element.  The
// array-field base is addressed via genSelectorPtr, mirroring the single- and
// parallel-assign paths — and composing with the type-assert-selector
// block-threading (an assert base splits the block).  Recovering the array pointer
// only for an EXPR_IDENT base leaves it nil for a struct/pointer array-field base,
// and the element store is silently DROPPED (the element keeps its old value).

type AB struct {
	arr [4]int
}

func two() (int, int) {
	return 11, 22
}

func fourfive() (int, int) {
	return 4, 5
}

func main() {
	// struct value base
	var ab AB
	var y int
	ab.arr[2], y = two()
	testing.Println(ab.arr[2]) // 11
	testing.Println(y)         // 22

	// managed-pointer struct base
	var pab @AB = make(AB)
	pab.arr[3], y = fourfive()
	testing.Println(pab.arr[3]) // 4
	testing.Println(y)          // 5

	// type-assertion base (composes with the assert-selector threading)
	var a *any = &ab
	a.(*AB).arr[0], y = two()
	testing.Println(ab.arr[0]) // 11
	testing.Println(y)         // 22

	// deref base `(*p)[i]` — p (pointer-to-array) is the array's backing address.
	var raw [3]int
	raw[1] = 55
	var pr *([3]int) = &raw
	var q int
	(*pr)[1], q = two()
	testing.Println(raw[1]) // 11
	testing.Println(q)      // 22
}
