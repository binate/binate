package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A name-less MANAGED pointee (a managed slice `@[]char`) boxed into a managed
// `@any`.  Before the fix this produced a
// degenerate box and crashed (SIGSEGV) on drop / a type-compare.  Now the any-block
// slot-0 dtor carries the managed-slice drop (`__dtor_ms_<elem>`, RefDec the
// backing), so a managed `@any` box:
//   - drops without a leak and without a double-free (the backing RC balances),
//   - recovers the slice value (`a.(@[]char)` / `case @[]char:`),
//   - keeps exact structural identity (a `@[]int` box does NOT hit `case @[]char:`).

func takesMgdAny(a @any) {
	_ = a
}

func recoverLen(a @any) int {
	v, ok := a.(@[]char)
	if ok {
		return len(v)
	}
	return -1
}

func classify(a @any) @[]char {
	switch v := a.(type) {
	case @[]char:
		_ = v
		return "mslice"
	default:
		return "default"
	}
}

func readRC(hdr *int) int {
	var p *uint8 = bit_cast(*uint8, hdr[2])
	if p == nil {
		return 0
	}
	return rt.Refcount(p)
}

// soleBox returns a managed `@any` as the SOLE owner of the boxed slice — the
// `@(@[]int)` local drops at return, so the returned `@any`'s own drop (its
// any-block slot-0 ms-dtor) must RefDec the backing, else it leaks.
func soleBox(k @[]int) @any {
	var b @(@[]int) = box(k)
	var a @any = b
	return a
}

func main() {
	var s @[]char = "hello"
	var b @(@[]char) = box(s)
	testing.Println(recoverLen(b)) // 5
	testing.Println(classify(b)) // mslice

	// exact identity: a @[]int box must NOT hit `case @[]char:`
	var t @[]int = make_slice(int, 3)
	var bt @(@[]int) = box(t)
	testing.Println(classify(bt)) // default

	// refcount balance: box a live slice into @any 100x; the backing RC returns to
	// baseline (a leak grows it; a double-free crashes or drops it below).
	var keep @[]char = make_slice(char, 9)
	var pk *int = bit_cast(*int, &keep)
	var before int = readRC(pk)
	for i := 0; i < 100; i++ {
		var bb @(@[]char) = box(keep)
		takesMgdAny(bb)
	}
	if readRC(pk) == before {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// SOLE-OWNER @any balance: the returned @any is the only holder, so its drop
	// (slot-0 ms-dtor) must RefDec the backing.  100 iters return the backing to
	// baseline (a leak grows it; a double-free crashes).
	var keep2 @[]int = make_slice(int, 4)
	var pk2 *int = bit_cast(*int, &keep2)
	var before2 int = readRC(pk2)
	for i := 0; i < 100; i++ {
		var a @any = soleBox(keep2)
		_ = a
	}
	if readRC(pk2) == before2 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// OWNERSHIP (no UAF): a @any that OUTLIVES its source slice must keep the
	// backing alive.  makeBoxed's source drops at its return; recover the values
	// after churning the allocator.
	var out @any = makeBoxed()
	for i := 0; i < 32; i++ {
		var churn @[]int = make_slice(int, 4)
		churn[0] = -1
		_ = churn
	}
	rv, rok := out.(@[]int)
	if rok && rv[0] == 111 && rv[3] == 444 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}
}

// makeBoxed boxes a slice and returns it as a @any that outlives the source `s`.
func makeBoxed() @any {
	var s @[]int = make_slice(int, 4)
	s[0] = 111
	s[1] = 222
	s[2] = 333
	s[3] = 444
	var b @(@[]int) = box(s)
	var a @any = b
	return a
}
