package "main"

import "pkg/builtins/rt"

// Refcount balance for a managed pointer to a managed slice (`@(@[]T)`, the shape
// `box(s)` produces for a managed-slice `s`) in every position: a named-distinct
// wrapper, a struct field, a managed-slice element, an array element.  box() RefIncs
// the backing (owning copy) and each drop path RefDecs it exactly once via the
// managed-slice dtor — a leak grows the backing RC, a double-free crashes / drops it
// below baseline.  Compile-and-run also pins that the pointee ms-dtor is emitted for
// each aggregate position (else an undefined-symbol link failure).

type Buf @[]char

type W struct {
	p @(@[]int)
}

func rc(hdr *int) int {
	var b *uint8 = bit_cast(*uint8, hdr[2])
	if b == nil {
		return 0
	}
	return rt.Refcount(b)
}

func main() {
	// named-distinct managed slice: box(s) for `type Buf @[]char`
	var s Buf = make_slice(char, 9)
	var ps *int = bit_cast(*int, &s)
	var b0 int = rc(ps)
	for i := 0; i < 100; i++ {
		var b @(Buf) = box(s)
		_ = b
	}
	if rc(ps) == b0 {
		println(0)
	} else {
		println(1)
	}

	// struct field @(@[]int): assign a box, drop the struct, backing balances
	var keep @[]int = make_slice(int, 4)
	var pk *int = bit_cast(*int, &keep)
	var b1 int = rc(pk)
	for i := 0; i < 100; i++ {
		var w W
		w.p = box(keep)
		_ = w
	}
	if rc(pk) == b1 {
		println(0)
	} else {
		println(1)
	}

	// managed-slice element @[]@(@[]int): store a box, drop the slice, balances
	var b2 int = rc(pk)
	for i := 0; i < 100; i++ {
		var xs @[]@(@[]int) = make_slice(@(@[]int), 2)
		xs[0] = box(keep)
		_ = xs
	}
	if rc(pk) == b2 {
		println(0)
	} else {
		println(1)
	}
}
