package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A multi-RETURN (`a[j][i], y = f()`) or PARALLEL (`a[j][i], a[j][k] = ...`)
// assignment into a NESTED-array-index element must store the element.  Regression:
// only the single-assign path special-cased a nested-array base (isNestedArrayBase →
// genIndexPtr); genMultiAssign and resolveParallelIndexTarget loaded a COPY of the
// inner array and silently DROPPED the store.  Now both resolve the element pointer
// in-place.

func two() (int, int) {
	return 11, 22
}

func rc(hdr *int) int {
	var p *uint8 = bit_cast(*uint8, hdr[2])
	if p == nil {
		return 0
	}
	return rt.Refcount(p)
}

func main() {
	// multi-return into a nested-array element
	var a [2][3]int
	a[1][1] = 51
	var y int
	a[1][1], y = two()
	testing.Println(a[1][1]) // 11
	testing.Println(y) // 22

	// parallel-assign into nested-array elements
	var p [2][3]int
	p[1][0] = 5
	p[1][2] = 6
	p[1][0], p[1][2] = 77, 88
	testing.Println(p[1][0]) // 77
	testing.Println(p[1][2]) // 88

	// deeper nesting [2][2][2]
	var d [2][2][2]int
	d[1][0][1] = 9
	d[1][0][1], y = two()
	testing.Println(d[1][0][1]) // 11

	// managed element (parallel): the overwritten element is RefDec'd, the new value
	// acquired — backing RC balances.
	var keep @[]int = make_slice(int, 4)
	var pk *int = bit_cast(*int, &keep)
	var before int = rc(pk)
	var m [2][2]@[]int
	var z int
	for i := 0; i < 100; i++ {
		m[1][0], z = keep, 7
	}
	if rc(pk) == before + 1 {
		testing.Println(0) // m[1][0] holds keep (+1), old elements released
	} else {
		testing.Println(1)
	}
	_ = z
}
