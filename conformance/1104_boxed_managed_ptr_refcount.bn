package "main"

import "pkg/builtins/rt"

// Refcount balance for a managed pointer to a managed pointer (`@(@T)`, the shape
// `box(mp)` produces for a managed pointer `mp @Node`).  box() RefIncs the pointee
// (owning copy) and each drop path RefDecs it exactly once via the managed-pointer
// dtor `__dtor_mp_<T>` — in a bare local, a struct field, a managed-slice element,
// an array element, and nested `@(@(@T))`.  A leak grows the pointee's RC; a
// double-free crashes / drops it below baseline.  Also pins the no-UAF property: a
// `@(@Node)` that outlives its source keeps the Node alive.

type Node struct {
	v int
}

type W struct {
	p @(@Node)
}

func rcOf(n @Node) int {
	return rt.Refcount(bit_cast(*uint8, n))
}

// makeBoxed returns a @(@Node) that outlives its source `n`.
func makeBoxed() @(@Node) {
	var n @Node = make(Node)
	n.v = 42
	var b @(@Node) = box(n)
	return b
}

func main() {
	var n @Node = make(Node)

	// bare local @(@Node)
	var b0 int = rcOf(n)
	for i := 0; i < 100; i++ {
		var b @(@Node) = box(n)
		_ = b
	}
	if rcOf(n) == b0 {
		println(0)
	} else {
		println(1)
	}

	// struct field @(@Node)
	var b1 int = rcOf(n)
	for i := 0; i < 100; i++ {
		var w W
		w.p = box(n)
		_ = w
	}
	if rcOf(n) == b1 {
		println(0)
	} else {
		println(1)
	}

	// managed-slice element @[]@(@Node) + array element [2]@(@Node)
	var b2 int = rcOf(n)
	for i := 0; i < 50; i++ {
		var xs @[]@(@Node) = make_slice(@(@Node), 2)
		xs[0] = box(n)
		var a [2]@(@Node)
		a[1] = box(n)
		_ = xs
		_ = a
	}
	if rcOf(n) == b2 {
		println(0)
	} else {
		println(1)
	}

	// nested @(@(@Node))
	var b3 int = rcOf(n)
	for i := 0; i < 50; i++ {
		var bb @(@(@Node)) = box(box(n))
		_ = bb
	}
	if rcOf(n) == b3 {
		println(0)
	} else {
		println(1)
	}

	// no UAF: a @(@Node) outliving its source keeps the Node alive
	var out @(@Node) = makeBoxed()
	for i := 0; i < 32; i++ {
		var junk @Node = make(Node)
		junk.v = -1
		_ = junk
	}
	var inner @Node = *out
	if inner.v == 42 {
		println(0)
	} else {
		println(1)
	}
}
