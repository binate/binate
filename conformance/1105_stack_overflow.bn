package "main"
import "pkg/builtins/testing"

// Unbounded recursion is a recoverable user-code fault in the bytecode VM:
// pushFrame's red-zone check faults and the VM unwinds to the host, which prints the
// message and exits non-zero (`runtime error: stack overflow`), rather than crashing
// the host.  rec is non-tail (rec()+1) so it genuinely grows the stack on every
// backend.  Compiled hosted backends stay fatal (native stack overflow -> SIGSEGV, no
// message); on arm32 bare metal the stack guard's data abort reports
// `fatal: stack overflow` (runtime/baremetal_arm32/crt0.s).

func rec() int {
	return rec() + 1
}

func main() {
	testing.Println("before")
	var x int = rec()
	_ = x
	testing.Println("after")
}
