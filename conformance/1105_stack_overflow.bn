package "main"

// Unbounded recursion is a recoverable user-code fault in the bytecode VM (Plan 2):
// pushFrame's red-zone check faults and the VM unwinds to the host, which prints the
// message and exits non-zero (`runtime error: stack overflow`), rather than crashing
// the host.  rec is non-tail (rec()+1) so it genuinely grows the stack on every
// backend.  Compiled backends stay fatal (native stack overflow -> SIGSEGV, no
// message), so this is VM-only.

func rec() int {
	return rec() + 1
}

func main() {
	println("before")
	var x int = rec()
	_ = x
	println("after")
}
