package "main"
import "pkg/builtins/testing"

// Taking the address of an element of a NAMED-DISTINCT slice
// (`type RBuf *[]int` / `type MBuf @[]int`) must peel the wrapper in
// genIndexPtr's IDENT slice arm and yield the element's address, so a
// write-through is visible.  Un-peeled, isSliceType(named) is false, the
// arm falls through, and genUnary hands back the loaded element VALUE as a
// pointer — a wild pointer that SIGSEGVs on the write (rc=139, no output).
// The store form `b[i] = x` already worked (927_named_slice_index_store);
// only this address-of read path (genIndexPtr) was affected.  The named
// variant of 599_addr_of_slice_elem.

type RBuf *[]int
type MBuf @[]int

func main() {
	// Own the backing in a managed var so the raw named slice `b` (which only
	// borrows) stays valid past this statement — the make_slice temp would
	// otherwise be freed here and `b` dangle (a later allocation reuses it).
	var bBacking @[]int = make_slice(int, 3)
	var b RBuf = bBacking
	b[0] = 1
	var q *int = &b[0]
	*q = 8
	testing.Println(b[0]) // 8

	var m MBuf = make_slice(int, 3)
	m[2] = 5
	var p *int = &m[2]
	*p = 42
	testing.Println(m[2]) // 42
}
