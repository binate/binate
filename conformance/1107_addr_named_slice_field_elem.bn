package "main"

// Taking the address of a SELECTOR-based element of a NAMED-DISTINCT slice
// FIELD (`&c.Items[i]`, where Items is `type MBuf @[]int`) must peel the
// wrapper in genIndexPtr's SELECTOR slice arm.  Un-peeled, isSliceType(named)
// is false, the arm falls through, and (a SELECTOR base is excluded from the
// r-value arm below it) genIndexPtr returns nil — a wild-pointer SIGSEGV on
// the write-through.  The named variant of 600_addr_of_slice_field_elem.

type MBuf @[]int

type Box struct {
	Items MBuf
}

func main() {
	var c @Box = make(Box)
	c.Items = make_slice(int, 3)
	c.Items[0] = 5
	c.Items[1] = 6
	c.Items[2] = 7
	var p *int = &c.Items[1]
	*p = 77
	println(c.Items[1]) // 77
	println(c.Items[0]) // 5 (unchanged)
}
