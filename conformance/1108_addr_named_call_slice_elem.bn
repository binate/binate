package "main"
import "pkg/builtins/testing"

// `&<call-result>[i]` where the call returns a NAMED-DISTINCT slice
// (`type MBuf @[]int`) must peel the wrapper in genIndexPtr's r-value arm.
// Un-peeled, isSliceType(named) is false, the slice sub-arm is skipped, the
// TYP_POINTER / TYP_ARRAY sub-arms don't match a named slice either, and
// genIndexPtr returns nil — a wild-pointer SIGSEGV on the read-through.  `g`
// keeps the backing live across the statement.  The named variant of
// 623_addr_call_slice_elem.

type MBuf @[]int

var g MBuf

func get() MBuf { return g }

func main() {
	g = make_slice(int, 3)
	g[1] = 2
	var p *int = &get()[1]
	testing.Println(*p) // 2
}
