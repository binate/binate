package "main"
import "pkg/builtins/testing"

// Pointer-index READ (`p[i]`) of a NAMED-DISTINCT pointer (`type P *int`).
// genIndex classifies the base off the peeled type (so the named pointer
// reaches the pointer arm), but passes the UN-peeled operand to
// OP_GET_ELEM_PTR.  The LLVM backend's emitGetElemPtr then decided single- vs
// double-index GEP off the operand's raw `.Kind` (TYP_NAMED, not TYP_POINTER),
// wrongly taking the double-index array-alloca path — `getelementptr i64,
// i64* %p, i64 0, i64 idx`, invalid on a scalar pointer (COMPILE_ERROR).  Fixed
// by peeling the operand type in emitGetElemPtr.  Native backends were
// unaffected (they classify the base by alloca/global/value, not type kind).
// The address-of sibling (`&p[i]`, a separate genIndexPtr fix) is covered by
// 1110/1111.

type P *int

func main() {
	var arr [3]int
	arr[0] = 10
	arr[1] = 20
	arr[2] = 30
	var p P = &arr[0]
	testing.Println(p[0]) // 10
	testing.Println(p[1]) // 20
	testing.Println(p[2]) // 30
}
