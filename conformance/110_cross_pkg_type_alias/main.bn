package "main"
import "pkg/builtins/testing"

import "pkg/mylib"

func check() mylib.Result {
	return mylib.MakeResult("hello")
}

func main() {
	var r mylib.Result = check()
	testing.Println(len(r))
	testing.Println(r)
	if mylib.IsEmpty(r) {
		testing.Println("empty")
	} else {
		testing.Println("not empty")
	}

	var empty mylib.Result = mylib.MakeResult("")
	if mylib.IsEmpty(empty) {
		testing.Println("empty ok")
	}
}
