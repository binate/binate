package "main"
import "pkg/builtins/testing"

// Taking the address of an element of a NAMED-DISTINCT pointer (`type P *int`)
// must peel the wrapper in genIndexPtr's IDENT pointer arm.  Un-peeled,
// arrTyp.Kind is TYP_NAMED (not TYP_POINTER), so the arm falls through (the
// slice/array arms miss a named pointer too), genIndexPtr returns nil, and
// genLValueAddr falls through to genExpr(p[1]) — the loaded pointer VALUE used
// as an address (a wild pointer, SIGSEGV on write).  The pointer-arm sibling of
// 1106 (the slice-arm address-of fix); the pointer-index READ half is
// 1109_named_ptr_index_read.

type P *int

func main() {
	var arr [3]int
	arr[0] = 1
	arr[1] = 2
	arr[2] = 3
	var p P = &arr[0]
	var q *int = &p[1]
	*q = 9
	testing.Println(arr[1]) // 9  (the write through &p[1] landed in arr[1])
	testing.Println(p[1])   // 9  (same element, read back through the named pointer)
}
