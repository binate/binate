package "main"
import "pkg/builtins/testing"

// `&<call-result>[i]` where the call returns a NAMED-DISTINCT pointer
// (`type P *int`) must peel the wrapper in genIndexPtr's r-value pointer
// sub-arm.  Un-peeled, baseVal.Typ.Kind is TYP_NAMED and baseVal.Typ.Elem is
// nil, so the sub-arm is skipped and genIndexPtr falls through — the loaded
// pointer VALUE is used as an element address (wild pointer).  The r-value
// variant of 1110; `g` keeps the pointee live across the statement.

type P *int

var g [3]int

func get() P { return &g[0] }

func main() {
	g[0] = 1
	g[1] = 2
	g[2] = 3
	var q *int = &get()[2]
	*q = 42
	testing.Println(g[2]) // 42
}
