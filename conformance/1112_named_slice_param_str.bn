package "main"

// A string literal passed to a NAMED-DISTINCT char-slice param must be
// materialized to a {data,len} slice.  coerceArg classifies the param off its
// PEELED type; un-peeled, isSliceType(named) is false, the literal is passed as
// a bare pointer, and len(s) reads a garbage word (a silent miscompile — wrong
// value, exit 0).

type Str *[]readonly char

func flen(s Str) int { return len(s) }

func main() {
	println(flen("hello")) // 5
}
