package "main"
import "pkg/builtins/testing"

// A managed slice passed to a NAMED-DISTINCT raw-slice param must get the
// `@[]T -> *[]T` narrowing.  coerceArg classifies the param off its PEELED type;
// un-peeled, peelReadonly(named).Kind != TYP_SLICE, the narrowing is skipped,
// and the callee reads garbage (a silent miscompile).

type RS *[]int

func first(s RS) int { return s[0] }

func main() {
	var m @[]int = make_slice(int, 3)
	m[0] = 42
	m[1] = 7
	testing.Println(first(m)) // 42
}
