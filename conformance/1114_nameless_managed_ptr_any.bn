package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Refcount balance for a name-less NON-slice managed pointee boxed into a managed
// `@any` — the shapes `wrapAsIfaceValue` used to reject with invalid LLVM (a
// name-less pointee) or silently leak (a nominal-leaf `@(@Node)`, whose data-slot
// dtor was mis-selected as Node's STRUCT dtor by receiverBaseTypeName's over-peel).
// A managed `@any` OWNS its data, so it must drop the pointee through the pointee's
// OWN managed dtor — `__dtor_mp_<T>` for a managed ptr, `__dtor_ms_<elem>` for a
// managed slice — not a struct dtor and not a null slot 0.  A borrowing raw-slice
// pointee (`@(*[]int)`) owns only the cell, which the any-drop's RefDec frees.  A
// leak grows the witnessed RC; a double-free / wrong dtor crashes or underflows.

type Node struct {
	v int
}

// Named-distinct wrappers over a managed ptr / slice: structurally the same
// managed pointee, so they must take the same OWNING any-box path (peeled) rather
// than leak via receiverBaseTypeName's nominal name.
type H @Node

type S @[]int

// rc reads the backing refptr (3rd word) of a managed slice via a `*int` view of
// its header, mirroring conformance/1102.
func rc(hdr *int) int {
	var b *uint8 = bit_cast(*uint8, hdr[2])
	if b == nil {
		return 0
	}
	return rt.Refcount(b)
}

// rcOf reads a managed pointer's own refcount.
func rcOf(p *uint8) int {
	if p == nil {
		return 0
	}
	return rt.Refcount(p)
}

func main() {
	// fu2_a: name-less `@(@(@[]int))` (ptr-to-ptr-to-slice) into @any.  The
	// innermost int backing must balance — the any-drop chains
	// __dtor_mp -> __dtor_mp -> __dtor_ms -> RefDec(backing).
	var keep @[]int = make_slice(int, 3)
	keep[0] = 7
	var pk *int = bit_cast(*int, &keep)
	var b0 int = rc(pk)
	for i := 0; i < 100; i++ {
		var a @any = box(box(keep))
		_ = a
	}
	if rc(pk) == b0 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// fu2_b: name-less `@(*[]int)` (managed ptr to a RAW slice) into @any.  The
	// pointee borrows (null slot 0), but the managed-ptr CELL is owned — the any
	// RefIncs it on wrap and the any-drop RefDecs it, so `mp`'s RC balances.
	var raw *[]int = make_slice(int, 3)
	var mp @(*[]int) = box(raw)
	var b1 int = rcOf(bit_cast(*uint8, mp))
	for i := 0; i < 100; i++ {
		var a @any = mp
		_ = a
	}
	if rcOf(bit_cast(*uint8, mp)) == b1 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// fu2_c: nominal-leaf `@(@Node)` into @any — the leak that was silently wrong
	// (over-peel selected Node's struct dtor).  Node's RC must balance.
	var n @Node = make(Node)
	n.v = 42
	var b2 int = rcOf(bit_cast(*uint8, n))
	for i := 0; i < 100; i++ {
		var a @any = box(n)
		_ = a
	}
	if rcOf(bit_cast(*uint8, n)) == b2 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// deep alternation: `@(@(@Node))` into @any — mp -> mp -> struct.  Node balances.
	var b3 int = rcOf(bit_cast(*uint8, n))
	for i := 0; i < 100; i++ {
		var a @any = box(box(n))
		_ = a
	}
	if rcOf(bit_cast(*uint8, n)) == b3 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// named-distinct managed-ptr `type H @Node`: box(h) into @any must peel H to its
	// underlying `@Node` and take the OWNING path — else it leaks one per box.
	var h H = n
	var b5 int = rcOf(bit_cast(*uint8, n))
	for i := 0; i < 100; i++ {
		var a @any = box(h)
		_ = a
	}
	if rcOf(bit_cast(*uint8, n)) == b5 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// named-distinct managed-slice `type S @[]int`: box(sd) into @any peels S to
	// `@[]int` (the ms-dtor path); the backing must balance.
	var sd S = make_slice(int, 3)
	var psd *int = bit_cast(*int, &sd)
	var b6 int = rc(psd)
	for i := 0; i < 100; i++ {
		var a @any = box(sd)
		_ = a
	}
	if rc(psd) == b6 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// readonly-wrapped managed ptr `readonly @Node` into @any: peelTransparent must
	// see through the readonly wrapper (owning path) AND register the PEELED type so
	// only one dtor body is emitted (else a duplicate-symbol link failure).
	var rn readonly @Node = n
	var b7 int = rcOf(bit_cast(*uint8, n))
	for i := 0; i < 100; i++ {
		var a @any = box(rn)
		_ = a
	}
	if rcOf(bit_cast(*uint8, n)) == b7 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// readonly-wrapped managed slice `readonly @[]int` into @any: same, ms side.
	var rs readonly @[]int = keep
	var b8 int = rc(pk)
	for i := 0; i < 100; i++ {
		var a @any = box(rs)
		_ = a
	}
	if rc(pk) == b8 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// control: a plain `@Node` (single managed ptr) into @any still takes the
	// NORMAL nominal path (slot-0 = Node's struct dtor, data = pointer-to-Node) —
	// unchanged by the fix.
	var b4 int = rcOf(bit_cast(*uint8, n))
	for i := 0; i < 100; i++ {
		var a @any = n
		_ = a
	}
	if rcOf(bit_cast(*uint8, n)) == b4 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}
}
