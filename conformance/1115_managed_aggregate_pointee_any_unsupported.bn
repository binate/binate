package "main"

// A managed pointer to a name-less aggregate whose contents need destruction —
// here `@([2]@Node)`, a managed ptr to an array-of-managed — boxed into `@any`
// has no owning slot-0 dtor yet (FU4: these pointees also leak on a normal drop,
// since emitManagedPtrRefDec has no array / func-value arm).  The compiler must
// FAIL LOUD with a clear "not yet supported" message rather than bail and emit a
// leaking or invalid (extractvalue-on-i8*) interface value.  Remove this negative
// test when FU4 wires the owning treatment and the box becomes valid.

type Node struct {
	v int
}

func main() {
	var arr @([2]@Node) = make([2]@Node)
	var a @any = arr
	_ = a
	println(0)
}
