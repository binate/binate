package "main"

// A managed pointer to a name-less aggregate whose contents need destruction but
// that is NOT a managed slice / ptr / array-of-managed — here `@(@func(int) int)`,
// a managed ptr to a managed func-value — boxed into `@any` has no owning slot-0
// dtor yet (FU4 Part B: a func-value pointee also leaks on a normal drop, since
// emitManagedPtrRefDec has no func-value arm).  The compiler must FAIL LOUD with a
// clear "not yet supported" message rather than bail and emit a leaking or invalid
// (extractvalue-on-i8*) interface value.  Remove this negative test when FU4 Part B
// wires the func-value owning treatment and the box becomes valid.  (The
// array-of-managed pointee this test used to cover is now supported — see 1117.)

func adder(x int) int {
	return x + 1
}

func main() {
	var f @func(int) int = adder
	var a @any = box(f)
	_ = a
	println(0)
}
