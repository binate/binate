package "main"
import "pkg/builtins/testing"

// Taking the address of an element of a raw-POINTER FIELD (`&s.p[i]`, where the
// field is `*int` or a named-distinct `NP *int`) must load the pointer field
// value and GEP through it.  genIndexPtr's SELECTOR arm had array + slice
// sub-arms but NO pointer sub-arm, so it returned nil, and genLValueAddr used
// the loaded pointer VALUE as the element address — a wild pointer (SIGSEGV on
// write).  Not named-distinct-specific: the plain `*int` field crashes too.  The
// READ `s.p[i]` and STORE `s.p[i] = v` already worked (they don't route through
// genIndexPtr).

type NP *int

type S struct {
	p *int
	q NP
}

func main() {
	var arr [3]int
	arr[0] = 1
	arr[1] = 2
	arr[2] = 3
	var s S
	s.p = &arr[0]
	s.q = &arr[0]

	var r1 *int = &s.p[1] // plain pointer field
	*r1 = 9
	testing.Println(arr[1]) // 9

	var r2 *int = &s.q[2] // named-distinct pointer field
	*r2 = 8
	testing.Println(arr[2]) // 8
}
