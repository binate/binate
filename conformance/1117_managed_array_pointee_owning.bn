package "main"

import "pkg/builtins/rt"

// A managed pointer to an array-of-managed (`@([N]@Node)`, the shape `box(arr)`
// produces for an array with managed elements) is a first-class OWNING refcounted
// type: box() RefIncs each element (via the array copy), and every drop path
// RefDecs each element exactly once through the array dtor `__dtor_arr<N>_<elem>`
// (emitManagedPtrRefDec's array arm).  Before FU4 this leaked on EVERY drop
// (emitManagedPtrRefDec had no array arm) and could not be boxed into `@any` at all.
// Balanced in a bare local, a struct field, a managed-slice element, a nested
// `@(@([N]@Node))`, and boxed into `@any`.

type Node struct {
	v int
}

type W struct {
	p @([2]@Node)
}

type Arr2 [2]@Node

func rcOf(n @Node) int {
	return rt.Refcount(bit_cast(*uint8, n))
}

func main() {
	var n @Node = make(Node)
	n.v = 7

	// bare local @([2]@Node)
	var b0 int = rcOf(n)
	for i := 0; i < 100; i++ {
		var arr [2]@Node
		arr[0] = n
		arr[1] = n
		var mp @([2]@Node) = box(arr)
		_ = mp
	}
	if rcOf(n) == b0 {
		println(0)
	} else {
		println(1)
	}

	// struct field @([2]@Node)
	var b1 int = rcOf(n)
	for i := 0; i < 100; i++ {
		var arr [2]@Node
		arr[0] = n
		var w W
		w.p = box(arr)
		_ = w
	}
	if rcOf(n) == b1 {
		println(0)
	} else {
		println(1)
	}

	// managed-slice element @[]@([2]@Node)
	var b2 int = rcOf(n)
	for i := 0; i < 50; i++ {
		var arr [2]@Node
		arr[0] = n
		var xs @[]@([2]@Node) = make_slice(@([2]@Node), 2)
		xs[0] = box(arr)
		_ = xs
	}
	if rcOf(n) == b2 {
		println(0)
	} else {
		println(1)
	}

	// nested @(@([2]@Node)) — managed ptr to the array pointer
	var b3 int = rcOf(n)
	for i := 0; i < 50; i++ {
		var arr [2]@Node
		arr[0] = n
		var bb @(@([2]@Node)) = box(box(arr))
		_ = bb
	}
	if rcOf(n) == b3 {
		println(0)
	} else {
		println(1)
	}

	// @([2]@Node) boxed into @any (owning; slot-0 = the array dtor)
	var b4 int = rcOf(n)
	for i := 0; i < 100; i++ {
		var arr [2]@Node
		arr[0] = n
		var a @any = box(arr)
		_ = a
	}
	if rcOf(n) == b4 {
		println(0)
	} else {
		println(1)
	}

	// round-trip: box a named `@Arr2` into @any and RECOVER it via `x.(@Arr2)`.
	// The box keys the any-block on the pointee's STRUCTURAL identity, so the assert
	// side must too (typeInfoSymFor) — else the HIT never fires and this aborts.  The
	// recovered `@Arr2` RefIncs the array cell and drops at end of statement, so the
	// element refcount balances.
	var b5 int = rcOf(n)
	var hits int = 0
	for i := 0; i < 100; i++ {
		var arr Arr2
		arr[0] = n
		arr[1] = n
		var a @any = box(arr)
		var back @Arr2 = a.(@Arr2)
		var av Arr2 = *back
		if av[0].v == 7 {
			hits = hits + 1
		}
	}
	if rcOf(n) == b5 && hits == 100 {
		println(0)
	} else {
		println(1)
	}
}
