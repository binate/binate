package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A managed pointer to a managed func-value (`@(@func())`, the shape `box(f)`
// produces for a capturing `@func()`) is a first-class OWNING refcounted type:
// box() RefIncs the shared capture record, and every drop path RefDecs it exactly
// once through the single signature-independent dtor `__dtor_func`
// (emitManagedPtrRefDec's func-value arm).  Before FU4 Part B `box(f)` was
// NON-owning -- balanced when the box and its source dropped together, but a
// use-after-free (SIGSEGV) when the box outlived the source, since the capture was
// freed early.  Witnessed via the captured var's refcount and by recovering the
// func value from a box that outlives its source and calling it.

type Box struct {
	v int
}

func main() {
	var b @Box = make(Box)
	b.v = 7

	// bare local @(@func()): capture record refcount balances over the loop
	var b0 int = rt.Refcount(bit_cast(*uint8, b))
	for i := 0; i < 100; i++ {
		var f @func() int = func() int { return b.v }
		var mp @(@func() int) = box(f)
		_ = mp
	}
	if rt.Refcount(bit_cast(*uint8, b)) == b0 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// box outlives source (the UAF that was a SIGSEGV): the box keeps the capture
	// alive, so the recovered func value still returns 7.
	var mp @(@func() int) = makeBoxed()
	var i int = 0
	for i = 0; i < 64; i++ {
		var junk @Box = make(Box)
		junk.v = -1
		_ = junk
	}
	var recovered @func() int = *mp
	if recovered() == 7 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}

	// @(@func()) boxed into @any: capture balances, drops cleanly through the
	// any-block slot-0 __dtor_func.
	var b2 int = rt.Refcount(bit_cast(*uint8, b))
	for i = 0; i < 100; i++ {
		var f @func() int = func() int { return b.v }
		var a @any = box(f)
		_ = a
	}
	if rt.Refcount(bit_cast(*uint8, b)) == b2 {
		testing.Println(0)
	} else {
		testing.Println(1)
	}
}

// makeBoxed returns a @(@func()) whose captured `local` outlives the source func.
func makeBoxed() @(@func() int) {
	var local @Box = make(Box)
	local.v = 7
	var f @func() int = func() int { return local.v }
	return box(f)
}
