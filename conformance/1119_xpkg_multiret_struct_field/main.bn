package "main"
import "pkg/builtins/testing"

import "pkg/mrpkg"

func main() {
	// (St, @any): struct member + interface, cross-package.  Before the fix the
	// LLVM callee sret'd via x8 while the native caller used registers -> SIGBUS.
	var s mrpkg.St
	var e @any
	s, e = mrpkg.mkStErr(false)
	if present(e) { testing.Println(-1); return }
	testing.Println(s.a) // 7
	testing.Println(s.b) // 9

	s, e = mrpkg.mkStErr(true)
	if present(e) { testing.Println(1) } else { testing.Println(0) } // 1

	// (St, int): struct member + scalar.
	var n int
	s, n = mrpkg.mkStInt(20)
	testing.Println(s.a) // 20
	testing.Println(n)   // 200
}
