package "pkg/mrpkg"

// A struct whose layout uses byte-array padding (`bool` then `int` ->
// `<{ i1, [7 x i8], i64, ... }>`), which is the shape that tripped LLVM's
// AArch64 return legalization into sret while the native caller used registers
// (native-aa64 cross-package multi-return sret ABI mismatch — see
// claude-todo-done.md).  Exercised as a tuple member of a cross-package
// multi-return so the callee (LLVM-compiled dep) and the native caller must
// agree on the register-vs-sret decision.
type St struct {
	flag bool
	a    int
	b    int
}

// mkStErr returns (St, @any) — a struct member + an interface value.  The
// interface is nil on success.
func mkStErr(fail bool) (St, @any)

// mkStInt returns (St, int) — struct member + scalar; crashed identically before
// the fix (proving the trigger is the struct member, not the interface).
func mkStInt(x int) (St, int)
