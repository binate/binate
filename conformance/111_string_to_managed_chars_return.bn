package "main"

import "pkg/builtins/testing"

func greet() @[]char {
	return "hello"
}

func empty() @[]char {
	return ""
}

func main() {
	var s @[]char = greet()
	testing.Println(len(s))
	testing.Println(s)

	var e @[]char = empty()
	testing.Println(len(e))
	if len(e) == 0 {
		testing.Println("empty ok")
	}
}
