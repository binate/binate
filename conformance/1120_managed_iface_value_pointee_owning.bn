package "main"

import "pkg/builtins/rt"

// A managed pointer to a managed iface-value (`@(@I)`, the shape `box(iv)` produces
// for a `@Greeter`) is a first-class OWNING refcounted type: box() RefIncs the iface
// value's data slot (the receiver), and every drop path RefDecs it exactly once
// through the single interface-independent dtor `__dtor_interface`
// (emitManagedPtrRefDec's iface-value arm, which fetches the receiver dtor from the
// value's own vtable).  Before this box(iv) was NON-owning -- balanced when the box
// and its source dropped together, but a use-after-free when the box outlived the
// source (the receiver was freed early, so the recovered iface value read freed
// memory).  Witnessed via the receiver's refcount and by recovering + calling the
// iface value from a box that outlives its source.

interface Greeter {
	greet() int
}

type Thing struct {
	x int
}

func (t @Thing) greet() int {
	return t.x
}

impl @Thing : Greeter

type W struct {
	p @(@Greeter)
}

func main() {
	var m @Thing = make(Thing)
	m.x = 7

	// bare local @(@Greeter): the receiver's refcount balances over the loop
	var b0 int = rt.Refcount(bit_cast(*uint8, m))
	for i := 0; i < 100; i++ {
		var mg @Greeter = m
		var mp @(@Greeter) = box(mg)
		_ = mp
	}
	if rt.Refcount(bit_cast(*uint8, m)) == b0 {
		println(0)
	} else {
		println(1)
	}

	// struct field @(@Greeter)
	var b1 int = rt.Refcount(bit_cast(*uint8, m))
	for i := 0; i < 100; i++ {
		var mg @Greeter = m
		var w W
		w.p = box(mg)
		_ = w
	}
	if rt.Refcount(bit_cast(*uint8, m)) == b1 {
		println(0)
	} else {
		println(1)
	}

	// box outlives source (the UAF): the box keeps the receiver alive, so the
	// recovered iface value still greets 42.
	var mp @(@Greeter) = makeBoxed()
	var i int = 0
	for i = 0; i < 64; i++ {
		var junk @Thing = make(Thing)
		junk.x = -1
		_ = junk
	}
	var g @Greeter = *mp
	if g.greet() == 42 {
		println(0)
	} else {
		println(1)
	}

	// @(@Greeter) boxed into @any: receiver balances through the slot-0
	// __dtor_interface.
	var b3 int = rt.Refcount(bit_cast(*uint8, m))
	for i = 0; i < 100; i++ {
		var mg @Greeter = m
		var a @any = box(mg)
		_ = a
	}
	if rt.Refcount(bit_cast(*uint8, m)) == b3 {
		println(0)
	} else {
		println(1)
	}
}

// makeBoxed returns a @(@Greeter) whose receiver `local` outlives the source.
func makeBoxed() @(@Greeter) {
	var local @Thing = make(Thing)
	local.x = 42
	var mg @Greeter = local
	return box(mg)
}
