package "main"
import "pkg/builtins/testing"

// `cast` cannot NARROW an interface value to a concrete type (recover) -- that
// would need a runtime type check the OP_CAST lowering does not perform.  The
// safe-set gate rejects it; recover a concrete type with a type ASSERTION
// (`x.(@T)`, checked) or `unsafe_cast` (unchecked).  (Cast TO an interface value --
// WIDENING -- IS accepted now; see the checker unit tests / 1122.)

type Thing struct {
	x int
}

func main() {
	var m @Thing = make(Thing)
	m.x = 42
	var a @any = m
	var back @Thing = cast(@Thing, a)
	testing.Println(back.x)
}
