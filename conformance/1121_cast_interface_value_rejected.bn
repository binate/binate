package "main"

// `cast` cannot form a value FROM or TO an interface value (a 2-word
// {data, vtable}) -- the OP_CAST lowering would mis-declare its LLVM type
// (`%BnIfaceValue` used as a 1-word pointer, invalid IR).  The checker rejects it in
// every mode; a concrete type is recovered from an interface with a type ASSERTION
// (`x.(@T)`), not a cast.  (This test covers the FROM-interface direction; the
// TO-interface direction is pinned by the checker unit tests.)

type Thing struct {
	x int
}

func main() {
	var m @Thing = make(Thing)
	m.x = 42
	var a @any = m
	var back @Thing = cast(@Thing, a)
	println(back.x)
}
