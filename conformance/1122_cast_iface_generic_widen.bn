package "main"
import "pkg/builtins/testing"

// A `cast(T, x)` inside a GENERIC body sees an ABSTRACT type parameter at
// definition time, so the safe-set gate cannot check it there — it defers to
// instantiation.  Instantiated with `T = @any`, `cast(@any, x)` is interface
// WIDENING (a concrete value satisfies `any`): the gate (deferred) accepts it and
// IR-gen constructs the {data, vtable} pair.  The widened value round-trips back
// through a type assertion.  (A generic cast whose T instantiates to a NARROWING /
// mismatched-aggregate shape stays caught — by IR-gen's fail-loud backstops.)

type Thing struct {
	x int
}

func conv[T any](x @Thing) T {
	return cast(T, x)
}

func main() {
	var t @Thing = make(Thing)
	t.x = 42
	var a @any = conv[@any](t) // generic cast widens @Thing -> @any
	var back @Thing = a.(@Thing)
	testing.Println(back.x) // 42
}
