package "main"

// The checker rejects a direct `cast` to/from an interface value (1121), but a
// `cast(T, x)` inside a GENERIC body sees an ABSTRACT type parameter at definition
// time -- so when T is instantiated to `@any` / `@I` the interface type appears only
// at codegen.  A codegen backstop (gen_builtin.bn's OP_CAST arm) catches it there and
// FAILS LOUD rather than emit invalid LLVM (OP_CAST mis-declaring the 2-word
// %BnIfaceValue as a 1-word pointer).  Recover a concrete type with a type ASSERTION.

type Thing struct {
	x int
}

func conv[T any](x @Thing) T {
	return cast(T, x)
}

func main() {
	var a @any = conv[@any](make(Thing))
	_ = a
	println(1)
}
