package "main"
import "pkg/builtins/testing"

// The checker rejects a direct `bit_cast` to/from an aggregate (managed-slice /
// struct / array / func-value / interface value; conformance 800), but a
// `bit_cast(T, x)` inside a GENERIC body sees an ABSTRACT type parameter at
// definition time -- so when T is instantiated to such an aggregate (here `@any`, an
// interface value) the rejected type appears only at codegen.  A codegen backstop
// (gen_builtin.bn's BIT_CAST arm, mirroring the CAST arm's) catches it and FAILS LOUD
// rather than emit invalid LLVM (OP_BITCAST mis-declaring the aggregate's layout).

type Thing struct {
	x int
}

func conv[T any](x @Thing) T {
	return bit_cast(T, x)
}

func main() {
	var a @any = conv[@any](make(Thing))
	_ = a
	testing.Println(1)
}
