package "main"
import "pkg/builtins/testing"

// bit_cast requires equal size (spec §8.6).  A `bit_cast(T, x)` inside a generic
// body is checked for each instance with the instance's sizes (conv.typeparam):
// here x is `@Thing` (a one-word managed pointer) and T is `@any` (a two-word
// interface value), so the instance `conv[@any]` is a compile-time error.

type Thing struct {
	x int
}

func conv[T any](x @Thing) T {
	return bit_cast(T, x)
}

func main() {
	var a @any = conv[@any](make(Thing))
	_ = a
	testing.Println(1)
}
