package "main"
import "pkg/builtins/testing"

// bit_cast requires equal size (spec §8.6).  For CONCRETE operands the checker
// enforces that up front, but a `bit_cast(T, x)` inside a GENERIC body sees an
// ABSTRACT type parameter at definition time — so a T instantiated to a
// DIFFERENT-size type than x escapes the definition-time size check and reaches
// codegen.  Here x is `@Thing` (a one-word managed pointer) and T is `@any` (a
// two-word interface value).  An IR-gen size guard (gen_builtin.bn's BIT_CAST arm)
// catches the mismatch and FAILS LOUD rather than round-trip mismatched sizes
// (which would read past / short of the stored bytes).

type Thing struct {
	x int
}

func conv[T any](x @Thing) T {
	return bit_cast(T, x)
}

func main() {
	var a @any = conv[@any](make(Thing))
	_ = a
	testing.Println(1)
}
