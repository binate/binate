package "main"
import "pkg/builtins/testing"

// Field access THROUGH a named-distinct pointer (`type P *S`) — both direct
// (`ps.a`) and through a slice element (`arr[0].a`), read and write.  A named
// pointer auto-derefs for field access (the checker accepts it), so
// genSelectorPtr must peel the named pointer before reading `.Elem` (the
// un-peeled one's is nil, and IR-gen crashes).  No explicit `*p` here — this is
// the implicit field-access path.

type S struct { a int; b int }
type P *S

func main() {
	var s S
	s.a = 3
	s.b = 7
	var ps P = &s
	testing.Println(ps.a) // 3   direct field read
	ps.b = 42     // direct field write
	testing.Println(s.b)  // 42

	var arr @[]P = make_slice(P, 1)
	arr[0] = &s
	testing.Println(arr[0].a) // 3   element field read
	arr[0].a = 8      // element field write
	testing.Println(s.a)      // 8
}
