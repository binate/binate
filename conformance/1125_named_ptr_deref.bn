package "main"

// Dereferencing a named-distinct pointer (`type P *int`, `type PS *S`) must peel
// the wrapper in the checker's `*`-deref rule (it was rejected as "cannot
// dereference non-pointer" — PointerElem saw TYP_NAMED) AND in genUnary's deref
// codegen (which defaulted the pointee type to int for a named pointer, so `*ps`
// loaded a single int instead of the real pointee).  Named-distinct is
// transparent for pointer operations, exactly as indexing already is.

type P *int

type S struct {
	a int
	b int
}

type PS *S

func main() {
	var x int = 5
	var p P = &x
	println(*p) // 5  (read through deref)
	*p = 9
	println(x)  // 9  (write through deref)

	var s S
	s.a = 3
	s.b = 7
	var ps PS = &s
	var cp S = *ps  // deref-copy a whole struct through a named pointer
	println(cp.a)   // 3
	println(cp.b)   // 7  (garbage if the deref loaded only an int)
}
