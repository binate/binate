package "main"

// Indexing THROUGH a deref of a named-distinct pointer-to-array
// (`type PA *([3]int)`; `(*pa)[i]` and `&(*pa)[i]`) must peel the wrapper both
// in the checker's `*`-deref rule and in genIndexPtr's UNARY `(*p)[i]` arm
// (which gated on an un-peeled `ptrVal.Typ.Kind == TYP_POINTER`).

type PA *([3]int)

func main() {
	var arr [3]int
	arr[0] = 1
	arr[1] = 2
	arr[2] = 3
	var pa PA = &arr
	println((*pa)[1])      // 2  (read via deref-index)
	var q *int = &(*pa)[2] // address-of via deref-index
	*q = 8
	println(arr[2])        // 8
}
