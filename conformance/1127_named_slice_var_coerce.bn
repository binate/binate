package "main"

// Assigning a string literal / managed slice to a NAMED-DISTINCT slice VARIABLE
// must coerce (materialize / narrow), mirroring the coerceArg param fix.  The
// gen_control assignment gates classified varTyp un-peeled, so a named char/raw
// slice var stored garbage.

type Str *[]readonly char
type RS *[]int

func main() {
	var s Str
	s = "hello"
	println(len(s)) // 5   string literal -> named char-slice var

	var m @[]int = make_slice(int, 2)
	m[0] = 42
	var r RS
	r = m
	println(r[0]) // 42  managed slice -> named raw-slice var
}
