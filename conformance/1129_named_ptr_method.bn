package "main"
type S struct { v int }
func (s S) get() int { return s.v }
func (s *S) inc() { s.v = s.v + 1 }
type PS *S
func main() {
	var s S
	s.v = 42
	var ps PS = &s
	println((*ps).get()) // 42  (value receiver via deref)
	(*ps).inc()          // pointer receiver via deref
	println(s.v)         // 43
}
