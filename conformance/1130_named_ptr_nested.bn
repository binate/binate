package "main"
type PA *([2][2]int)
var calls int
func idx0() int { calls = calls + 1; return 0 }
func idx1() int { calls = calls + 1; return 1 }
func main() {
	var arr [2][2]int
	arr[0][0] = 1
	arr[1][1] = 9
	var pa PA = &arr
	println((*pa)[1][1])        // 9  (nested deref-index read)
	(*pa)[idx0()][idx1()] = 7   // side-effecting indices, each once
	println(arr[0][1])          // 7
	println(calls)              // 2  (each index evaluated exactly once)
}
