package "main"

// Assignment THROUGH a named-distinct pointer deref, across the target forms
// that each go through a distinct codegen arm: whole-struct `*p = S{...}`
// (aggregate store), multi-return `*p, y = f()` (the deref-target arm — the
// store was silently DROPPED for plain pointers too before the sweep), and
// parallel `*p1, *p2 = a, b`.

type S struct { a int; b int }
type PS *S
type P *int

func two() (S, int) { return S{a: 5, b: 6}, 9 }

func main() {
	var s S
	var ps PS = &s
	*ps = S{a: 1, b: 2}          // whole-struct write through deref
	println(s.a)                 // 1
	println(s.b)                 // 2

	var s2 S
	var n int
	var ps2 PS = &s2
	*ps2, n = two()              // multi-return into a deref target
	println(s2.a)                // 5
	println(s2.b)                // 6
	println(n)                   // 9

	var x int
	var y int
	var px P = &x
	var py P = &y
	*px, *py = 7, 8              // parallel-assign deref targets
	println(x)                   // 7
	println(y)                   // 8
}
