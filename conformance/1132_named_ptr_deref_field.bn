package "main"
import "pkg/builtins/testing"

// Field access through an explicit named-distinct pointer deref `(*ps).f`,
// read and write.

type S struct { a int; b int }
type PS *S

func main() {
	var s S
	s.a = 3
	s.b = 7
	var ps PS = &s
	testing.Println((*ps).a) // 3   deref field read
	(*ps).b = 42     // deref field write
	testing.Println(s.b)     // 42
}
