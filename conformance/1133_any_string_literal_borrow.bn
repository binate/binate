package "main"

// A bare STRING LITERAL borrowed into a raw `*any` must box as its canonical
// `*[]readonly char` char-slice — the spelling a formatter recovers — NOT as
// the `[N]readonly char` array natural type decayed to a single `char`
// (`lang.uint8`), which every char-slice `case` silently missed, so a
// `fmt.Print("hi")` rendered `%!?(unknown)` (plan-slice-type-identity.md
// Phase 5).  The literal's slice header is materialised into a frame-lived temp
// and its address boxed; a raw slice borrows the static `{data, len}`, so there
// is no refcount.  Covers the type-switch binder recovery, distinctness from a
// scalar box, an empty literal, and the comma-ok expression form.

func classify(v *any) {
	switch x := v.(type) {
	case *[]readonly char:
		println("string")
		println(x) // recovered *[]readonly char — the bytes
	case *int:
		println("int")
	default:
		println("default")
	}
}

func main() {
	classify("hi") // string / hi   — the bare-literal borrow (was mis-boxed as char)
	classify("")   // string / (empty line)

	var n int = 7
	classify(&n) // int  — a scalar box keeps its distinct identity

	// Comma-ok expression form recovers the same value from a `*any` var-init'd
	// from a bare literal.
	var v *any = "ok"
	got, matched := v.(*[]readonly char)
	if matched {
		println(got) // ok
	} else {
		println("miss")
	}
}
