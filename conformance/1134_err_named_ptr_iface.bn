package "main"

// A named-distinct pointer does NOT inherit its underlying's methods, so it must
// NOT satisfy an interface the underlying satisfies: `type PS *S; impl *S :
// Getter` does not make PS satisfy Getter.  Assigning `ps` to `*Getter` is
// rejected (it used to compile via the named-distinct->underlying assignability
// decay, then crash at runtime).  Constructing the interface from the underlying
// pointer directly (`&s`) still works; the named pointer needs an explicit
// conversion (`cast(*S, ps)`).

interface Getter { get() int }

type S struct { v int }

func (s *S) get() int { return s.v }

impl *S : Getter

type PS *S

func main() {
	var s S
	var ps PS = &s
	var g *Getter = ps
	println(g.get())
}
