package "main"

import "pkg/stdx/fmt"

// End-to-end pkg/stdx/fmt Printf/Sprintf/Fprintf: verb-directed formatting over
// the type-erased `...*any` operands.  Covers the common verbs (%s %d %v %t, the
// integer bases %x/%X/%o/%b, floats %f/%e/%g, %c, %q, %%) and Go-style error
// verbs (type mismatch, MISSING, EXTRA, NOVERB).  Operands are passed bare,
// exercising the implicit value→`*any` borrow (a string literal boxes as
// `*[]readonly char`; scalars value-borrow).

func main() {
	fmt.Printf("%s=%d ok=%t\n", "world", 7, true) // world=7 ok=true
	fmt.Printf("%d%% v=%v\n", 50, 42)             // 50% v=42
	fmt.Printf("%x %X %o %b %c\n", 255, 255, 8, 5, 72) // ff FF 10 101 H
	fmt.Printf("%f %e %g\n", 3.14, 1000.0, 1.5)   // 3.140000 1.000000e+03 1.5
	fmt.Printf("%q\n", "a\tb")                     // "a\tb"

	// Width / precision / flags.
	fmt.Printf("[%5d][%-5d][%05d][%+05d]\n", 7, 7, 7, 7)         // [    7][7    ][00007][+0007]
	fmt.Printf("[%.2f][%8.2f][%08.2f][%-8.2f]\n", 3.14159, 3.14159, -3.1, 3.1) // ...
	fmt.Printf("[%.3s][%10s][%-10s]\n", "hello", "hi", "hi")     // [hel][        hi][hi        ]

	// # alternate form, string-hex, * width/precision, %q of a char.
	fmt.Printf("[%#x][%#o][%#b]\n", 255, 8, 5)                   // [0xff][010][0b101]
	fmt.Printf("[%x][% x][%#x]\n", "hi", "hi", "hi")            // [6869][68 69][0x6869]
	fmt.Printf("[%*d][%.*f][%q]\n", 6, 42, 2, 3.14159, 65)      // [    42][3.14]['A']
	fmt.Printf("[%#o][%.2x][%q]\n", 8, "hello", 7)             // [010][6865]['\a']
	fmt.Printf("[%.*f]\n", -1, 3.5)                             // [%!(BADPREC)3.500000]

	// Error verbs render visibly, never silently.
	fmt.Printf("%d %s\n", "hi", 9)   // %!d(string=hi) %!s(int=9)
	fmt.Printf("%d %d\n", 1)         // 1 %!d(MISSING)
	fmt.Printf("%d\n", 1, 2)         // 1\n%!(EXTRA int=2)
	fmt.Printf("end=%", 5)           // end=%!(NOVERB)%!(EXTRA int=5)  (bare % still reports extra)
	fmt.Printf("\n")

	// Sprintf returns the formatted string.
	var s @[]readonly char = fmt.Sprintf("[%s:%d]", "k", 9) // [k:9]
	fmt.Println(&s)
}
