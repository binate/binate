package "main"
import "pkg/builtins/testing"

// index.deref.managed-ptr-array-store: a STORE through the deref of a MANAGED
// pointer to an array — `(*mp)[i][j] = v` (nested) and `(*mq)[i] = v` (single).
// The managed pointer's pointee IS the array backing, so the store must land on
// the pointee, not a dropped r-value copy.  Regression: genIndexPtr's deref arm
// (gen_access.bn) and indexExprType's deref case (gen_slice.bn) matched only raw
// TYP_POINTER, so isNestedArrayBase was false and the nested store was silently
// dropped (read back the OLD value).  Reads already worked (genIndex).

func main() {
	var a [2][2]int
	a[0][0] = 10
	a[1][0] = 12
	var mp @([2][2]int) = box(a)
	var i int = 1
	var j int = 0
	(*mp)[i][j] = 99        // nested store through the managed-ptr deref
	testing.Println((*mp)[i][j])    // 99  (was 12 before the fix)
	testing.Println((*mp)[0][0])    // 10  (unchanged neighbor)

	var b [3]int
	b[1] = 5
	var mq @([3]int) = box(b)
	(*mq)[i] = 77           // single-level store
	testing.Println((*mq)[1])       // 77
}
