package "main"

// index.deref.selector: reading/writing a FIELD off a deref-indexed struct
// element — `(*p)[i].x` — across ARRAY, SLICE and POINTER pointees, for both raw
// and managed pointers.  The read once panicked ("unresolved selector in IR-gen")
// and the store was silently dropped: getIndexElemType (gen_slice.bn) had no
// deref (*p) base arm, and genIndexPtr's deref arm (gen_access.bn) handled only an
// ARRAY pointee — a slice/pointer pointee returned nil and the store went nowhere.

type Pt struct {
	x int
	y int
}

func main() {
	// pointer to an ARRAY of structs
	var a [2]Pt
	a[1].x = 5
	var ap *([2]Pt) = &a
	var i int = 1
	println((*ap)[i].x) // 5 (read)
	(*ap)[0].x = 10
	println((*ap)[0].x) // 10 (store)

	// pointer to a SLICE of structs — same syntactic form
	var arr [3]Pt
	var s *[]Pt = arr[:]
	var sp *(*[]Pt) = &s
	(*sp)[2].x = 22
	println((*sp)[2].x) // 22 (store lands)
	println(arr[2].x)   // 22 (aliased backing written)

	// managed pointer to an array of structs
	var b [2]Pt
	var mp @([2]Pt) = box(b)
	(*mp)[i].x = 7
	println((*mp)[i].x) // 7
}
