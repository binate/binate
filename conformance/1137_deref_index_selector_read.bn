package "main"
import "pkg/builtins/testing"

// index.deref.selector: reading/writing a FIELD off a deref-indexed struct
// element — `(*p)[i].x` — across ARRAY, SLICE and POINTER pointees, for both raw
// and managed pointers.  getIndexElemType (gen_slice.bn) needs a deref (*p) base
// arm, or the read panics ("unresolved selector in IR-gen"); genIndexPtr's deref
// arm (gen_access.bn) must handle SLICE and POINTER pointees, not only an ARRAY —
// one that returns nil for them silently drops the store.

type Pt struct {
	x int
	y int
}

func main() {
	// pointer to an ARRAY of structs
	var a [2]Pt
	a[1].x = 5
	var ap *([2]Pt) = &a
	var i int = 1
	testing.Println((*ap)[i].x) // 5 (read)
	(*ap)[0].x = 10
	testing.Println((*ap)[0].x) // 10 (store)

	// pointer to a SLICE of structs — same syntactic form
	var arr [3]Pt
	var s *[]Pt = arr[:]
	var sp *(*[]Pt) = &s
	(*sp)[2].x = 22
	testing.Println((*sp)[2].x) // 22 (store lands)
	testing.Println(arr[2].x)   // 22 (aliased backing written)

	// managed pointer to an array of structs
	var b [2]Pt
	var mp @([2]Pt) = box(b)
	(*mp)[i].x = 7
	testing.Println((*mp)[i].x) // 7
}
