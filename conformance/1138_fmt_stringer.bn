package "main"

import "pkg/builtins/lang"
import "pkg/std/fmt"
import "pkg/std/strconv"

// End-to-end custom formatting: a user type that implements lang.Stringer formats
// via its String() for %v / %s / Print, with width applied.  A named-int type is
// recovered through Stringer (not `case int:`), and — since Binate scalars also
// implement lang.Stringer — %s of a scalar stringifies too.

type Point struct {
	x int
	y int
}

func (p *Point) String() @[]char {
	return strconv.Itoa(p.x * 10 + p.y) // e.g. (3,4) -> "34", visibly the method
}

impl *Point : lang.Stringer

type Money int

func (m *Money) String() @[]char {
	return strconv.Itoa(cast(int, *m))
}

impl *Money : lang.Stringer

func main() {
	var p Point
	p.x = 3
	p.y = 4
	fmt.Println(&p) // 34
	fmt.Printf("v=%v s=%s\n", &p, &p) // v=34 s=34
	fmt.Printf("[%6v]\n", &p) // [    34]  (width over a Stringer)

	var m Money = 99
	fmt.Printf("money=%v\n", &m) // money=99  (Money != int -> Stringer)

	fmt.Printf("n=%s\n", 42) // n=42  (scalar stringifies via %s)
}
