package "main"
import "pkg/builtins/testing"

import "pkg/cbpkg"

// A cross-package call to a LARGE multi-return (`(@[]int, @[]int)` = 8 GP words,
// over x64's 3 return registers) that ALSO takes a `@func` value param it calls.
// The callee is sret'd, so on x64/SysV the sret pointer takes an argument
// register and the trailing 2-word `@func` param straddles the register/stack
// boundary.  An imported extern's `ir.Func` must carry its MultiReturnType: with a
// nil one the caller's declare/call uses the register-FCA convention while the
// defining package sret's the callee — an ABI mismatch that delivers a corrupted
// `@func` and SIGSEGVs when Apply calls it.  (This is the shape of the call
// repl.NewKernel's registerExterns makes, which `bni --repl` runs on x86-64.)
func main() {
	var s @[]int = make_slice(int, 2)
	s[0] = 42
	s[1] = 99
	var f @func(int) = func(x int) {
		testing.Println(x)
	}
	var r1 @[]int
	var r2 @[]int
	r1, r2 = cbpkg.Apply(s, s, s, s, f)
	testing.Println(len(r1)) // 2
	testing.Println(r2[1]) // 99
}
