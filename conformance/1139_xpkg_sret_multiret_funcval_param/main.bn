package "main"

import "pkg/cbpkg"

// A cross-package call to a LARGE multi-return (`(@[]int, @[]int)` = 8 GP words,
// over x64's 3 return registers) that ALSO takes a `@func` value param it calls.
// The callee is sret'd, so on x64/SysV the sret pointer takes an argument
// register and the trailing 2-word `@func` param straddles the register/stack
// boundary.  An imported extern's `ir.Func` used to carry a nil MultiReturnType,
// so the caller's declare/call emitted the pre-sret register-FCA convention while
// the defining package sret'd the callee — an ABI mismatch that delivered a
// corrupted `@func` and SIGSEGV'd when Apply calls it.  (This is the exact shape
// that crashed `bni --repl` on x86-64 via repl.NewKernel's registerExterns.)
func main() {
	var s @[]int = make_slice(int, 2)
	s[0] = 42
	s[1] = 99
	var f @func(int) = func(x int) {
		println(x)
	}
	var r1 @[]int
	var r2 @[]int
	r1, r2 = cbpkg.Apply(s, s, s, s, f)
	println(len(r1)) // 2
	println(r2[1]) // 99
}
