package "pkg/cbpkg"

// Apply returns a large multi-return (sret'd on every target's register-count
// rule) AND calls fn, so a func value mis-passed by a caller/callee ABI
// disagreement faults at the call rather than passing silently.
func Apply(a @[]int, b @[]int, c @[]int, d @[]int, fn @func(int)) (@[]int, @[]int)
