package "main"

import "pkg/builtins/testing"

// Anonymous struct with a managed pointer field.
// Requires a destructor for correct cleanup.

type Inner struct { X int }

func main() {
	var s struct { Val int; Ptr @Inner }
	s.Val = 42
	s.Ptr = make(Inner)
	s.Ptr.X = 99
	testing.Println(s.Val)
	testing.Println(s.Ptr.X)
}
