package "main"

import "pkg/mrfpkg"

func main() {
	var a int32
	var p mrfpkg.P
	a, p = mrfpkg.mkIntP()
	println(cast(int, a))   // 99
	println(cast(int, p.x)) // 10  (garbage before the fix: aa64 P.x, x64 P.y)
	println(cast(int, p.y)) // 20

	var t mrfpkg.Tri
	var n int8
	t, n = mrfpkg.mkTriByte()
	println(cast(int, t.a)) // 11
	println(cast(int, t.b)) // 22
	println(cast(int, t.c)) // 33
	println(cast(int, n))   // 44
}
