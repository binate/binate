package "pkg/mrfpkg"

// P is an align-4 struct (8 bytes).  In `(int32, P)` P sits at raw byte offset 4 — a
// NON-8-aligned offset.  The aa64 flat-boundary coercion spelled P as `[1 x i64]`
// (8-aligned) and in a non-packed flat tuple LLVM bumped it to byte 8; the raw<->flat
// reinterpret then read P from the wrong bytes (silent miscompile: P.x garbage on aa64,
// incl. plain builder-comp).  x64 was corrupted differently — LLVM returns the field
// per-i32-LEAF (EAX,EDX,ECX) while native read it as one 8-byte word, losing P.y.  The
// field-by-field bridge (+ x64 coercion) reads/writes each field at its true FieldOffset
// in exactly ceil(size/W) word registers, so it survives on all backends.  Cross-package
// so a native caller collects it from an LLVM-compiled callee.
type P struct {
	x int32
	y int32
}

// Tri is a 3-byte SUB-WORD aggregate (align 1).  In `(Tri, int8)` Tri is coerced to
// `[1 x i32]` (word-rounded, 4 bytes) at offset 0 and the trailing int8 sits at raw
// offset 3 — the byte Tri's coerced word overlaps.  The field-by-field bridge stores the
// int8 AFTER Tri's word, so the raw layout ends up exact.
type Tri struct {
	a int8
	b int8
	c int8
}

// mkIntP returns (int32, P): a scalar then a struct field at a non-8-aligned offset.
func mkIntP() (int32, P)

// mkTriByte returns (Tri, int8): a sub-word aggregate field then a sub-4-aligned scalar.
func mkTriByte() (Tri, int8)
