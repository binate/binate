package "main"
import "pkg/builtins/testing"

import "pkg/fvpkg"

// A plain function returning (int32, P) — used as a NON-CAPTURING func-value below, so
// the call goes through the func-value shim (emit_funcvals_shim.bn), whose retbuf store
// is emitScatterFlatValue for the coerced struct-field multi-return.
func mk() (int32, fvpkg.P) {
	var p fvpkg.P
	p.x = cast(int32, 10)
	p.y = cast(int32, 20)
	return cast(int32, 99), p
}

func main() {
	// Non-capturing func-value -> func-value shim.
	var fv *func() (int32, fvpkg.P) = mk
	var a int32
	var p fvpkg.P
	a, p = fv()
	testing.Println(cast(int, a))   // 99
	testing.Println(cast(int, p.x)) // 10
	testing.Println(cast(int, p.y)) // 20

	// Capturing closure -> closure shim (emitClosureShimAggregate).
	var base int32 = 200
	var cl @func() (int32, fvpkg.P) = func() (int32, fvpkg.P) {
		var q fvpkg.P
		q.x = cast(int32, 30)
		q.y = cast(int32, 40)
		return base, q
	}
	var b int32
	var q fvpkg.P
	b, q = cl()
	testing.Println(cast(int, b))   // 200
	testing.Println(cast(int, q.x)) // 30
	testing.Println(cast(int, q.y)) // 40
}
