package "pkg/fvpkg"

// P is an align-4 struct at a NON-8-aligned offset in `(int32, P)` — the multi-return
// field-offset shape (see 1140).  Here it is returned THROUGH a func-value and a
// capturing closure, so the coerced flat multi-return is stored into the shim's retbuf
// by emitScatterFlatValue (emit_funcvals_shim.bn / emit_funcvals_closure.bn) — the shim
// counterpart of 1140's direct-call bind.  Cross-package so P crosses the boundary.
type P struct {
	x int32
	y int32
}
