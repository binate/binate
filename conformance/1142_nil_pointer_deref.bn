package "main"

type Node struct {
	val int
}

// Dereference a nil managed pointer.  Under the bytecode VM with nil-checking
// enabled — the `.check-nil` marker makes the int runners pass `--check-nil` —
// this raises a RECOVERABLE fault ("runtime error: nil pointer dereference",
// exit 1) instead of crashing, exactly like the other recoverable faults.  On a
// compiled backend (and a plain VM run without --check-nil) a nil deref is a
// bare load through address 0 -> SEGV with no message, so every compiled mode
// is xfail'd.
func main() {
	var p @Node = nil
	println(p.val)
}
