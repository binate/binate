package "main"
import "pkg/builtins/testing"

// iface.satisfaction.named-distinct-ptr: a named-distinct pointer (raw type PS *S
// OR managed type PMS @S) boxes into interface values via the SAME direct-box /
// no-thunk convention.  Universe any/@any ERASES to the underlying concrete type
// (a PS is-a *S at runtime; .(PS)/.(PMS) is not value-recoverable), so recover via
// .(*S) / .(@S).  A user interface with an OWN impl PRESERVES the named identity so
// dispatch runs the named type's method.  Inheritance is NOT granted (see 1144).

type S struct {
	v int
}

interface Getter {
	get() int
}

type PS *S
type PMS @S

func (p PS) get() int {
	return (*p).v + 100
}

func (p PMS) mget() int {
	return (*p).v + 200
}

interface MGetter {
	mget() int
}

impl PS : Getter
impl PMS : MGetter

func main() {
	var s S
	s.v = 3

	// RAW named-distinct pointer
	var ps PS = &s
	var ra *any = ps // -> *any: erased, recover via .(*S)
	var r1 *S
	var ok1 bool
	r1, ok1 = ra.(*S)
	if ok1 { testing.Println(r1.v) } else { testing.Println(-1) } // 3
	var g1 *Getter = ps // -> *Getter: own-impl dispatch
	testing.Println(g1.get())   // 103

	// MANAGED named-distinct pointer
	var pms PMS = box(s)
	var ma @any = pms // -> @any: erased, recover via .(@S)
	var r2 @S
	var ok2 bool
	r2, ok2 = ma.(@S)
	if ok2 { testing.Println(r2.v) } else { testing.Println(-2) } // 3
	var pms2 PMS = box(s)
	var g2 @MGetter = pms2 // -> @MGetter: own-impl dispatch
	testing.Println(g2.mget())     // 203
	var pms3 PMS = box(s)
	var g3 *MGetter = pms3 // -> *MGetter (managed ptr into RAW iface): own-impl dispatch
	testing.Println(g3.mget())     // 203
}
