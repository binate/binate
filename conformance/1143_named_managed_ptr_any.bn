package "main"
import "pkg/builtins/testing"

// iface.construct.named-pointer: a named pointer type (raw `type PS *S` or managed
// `type PMS @S`) is a value for interface construction.  A raw interface borrows it
// by address (the box points at the PS) and a managed one takes `box(pms)` (the box
// points at a PMS cell); either way the dynamic type is the named type, recovered by
// `.(*PS)` / `.(@PMS)` / `.(PMS)` and not by the pointee's `.(*S)`.  Dispatch runs the
// named type's own method on the PS loaded from the box.  Inheritance is NOT granted
// (see 1144).

type S struct {
	v int
}

interface Getter {
	get() int
}

type PS *S
type PMS @S

func (p PS) get() int {
	return (*p).v + 100
}

func (p PMS) mget() int {
	return (*p).v + 200
}

interface MGetter {
	mget() int
}

impl PS : Getter
impl PMS : MGetter

func main() {
	var s S
	s.v = 3

	// RAW named pointer: borrowed by address
	var ps PS = &s
	var ra *any = ps
	var r1 *PS
	var ok1 bool
	r1, ok1 = ra.(*PS)
	if ok1 { testing.Println((*r1).v) } else { testing.Println(-1) } // 3
	_, ok1 = ra.(*S)
	testing.Println(ok1) // false: the box holds a PS
	var g1 *Getter = ps
	testing.Println(g1.get()) // 103

	// MANAGED named pointer: boxed
	var pms PMS = box(s)
	var ma @any = box(pms)
	var r2 @PMS
	var ok2 bool
	r2, ok2 = ma.(@PMS)
	if ok2 { testing.Println((*r2).v) } else { testing.Println(-2) } // 3
	var r3 PMS
	r3, ok2 = ma.(PMS)
	testing.Println(r3.v, ok2) // 3 true
	_, ok2 = ma.(@S)
	testing.Println(ok2) // false: the box holds a PMS
	var g2 @MGetter = box(pms)
	testing.Println(g2.mget()) // 203
	var g3 *MGetter = pms // a raw interface borrows the PMS by address
	testing.Println(g3.mget()) // 203
}
