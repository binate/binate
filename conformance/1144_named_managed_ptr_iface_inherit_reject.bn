package "main"

// iface.satisfaction.named-distinct-no-inherit (managed): a named-distinct managed
// pointer does NOT inherit its underlying's interface impl — `impl @S : Getter`
// does not make `type PMS @S` satisfy Getter (only an `impl PMS : Getter` would).
// Mirrors the raw-pointer no-inheritance rule (96c85b86).

type S struct {
	v int
}

interface Getter {
	get() int
}

func (p @S) get() int {
	return p.v
}

impl @S : Getter

type PMS @S

func main() {
	var pms PMS = box(S{})
	var g @Getter = pms // REJECTED: PMS does not inherit @S's impl
	println(g.get())
}
