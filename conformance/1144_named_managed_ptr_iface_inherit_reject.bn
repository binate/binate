package "main"
import "pkg/builtins/testing"

// type.named.methods-not-inherited, iface.construct.named-pointer: a named managed
// pointer does NOT inherit its underlying's interface impl — `impl @S : Getter` does
// not make `type PMS @S` satisfy Getter (only an `impl PMS : Getter` would).  The
// PMS is boxed first (`box(pms)`), so the widening is rejected for the missing impl,
// not for widening a bare value.

type S struct {
	v int
}

interface Getter {
	get() int
}

func (p @S) get() int {
	return p.v
}

impl @S : Getter

type PMS @S

func main() {
	var pms PMS = box(S{})
	var g @Getter = box(pms) // REJECTED: PMS does not inherit @S's impl
	testing.Println(g.get())
}
