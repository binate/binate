package "main"
import "pkg/builtins/testing"

// iface.satisfaction.named-distinct-ptr (leak + nameless guards): three codegen
// gaps in the named-distinct-pointer -> interface support.  A named-distinct
// MANAGED pointer boxed into a user @Iface it OWN-implements owns the pointee box,
// so its vtable slot-0 dtor must run the POINTEE's destructor on drop (keying it on
// the never-emitted __dtor_<named-wrapper> leaves a null slot and leaks the
// pointee).  boxSlot0DtorName derives that dtor for every pointee shape:
//  (1) NAMED-STRUCT pointee (type MS @S): the struct's per-type dtor __dtor_S.
//  (2) NAMELESS managed-containing pointee (type AM @([2]@Leaf)): the pointee's
//      STRUCTURAL managed drop __dtor_arr2_Leaf -- there is no nominal name to key
//      on, so a name-based fallback would leak the array's @Leaf elements +1/box.
//  (3) ARRAY-of-destructible-STRUCT pointee (type AS @([2]S), S has a managed field):
//      the array dtor __dtor_arr2_S (which descends into each S's __dtor_S).  S is
//      destructible only AFTER field layout, not by kind -- so the slot-0 dtor must
//      NOT be gated on a collection-time NeedsDestruction() check (which is blind to
//      post-layout struct destructibility and would leak every element's @Leaf +1/box);
//      codegen's dtor-emission gating (post-layout) decides whether the array dtor is
//      live.  This is the shape distinct from (2): (2)'s elements are destructible by
//      KIND (managed ptr), (3)'s only by LAYOUT.
//  (4) A named-distinct pointer to a NAMELESS pointee (type NRP *([2]int)) boxes
//      into *any as a well-formed value (present() true), not a degenerate
//      null-vtable box.

import "pkg/builtins/rt"

type Leaf struct {
	y int
}

type S struct {
	leaf @Leaf
}

type MS @S

interface JN {
	m() int
}

func (q MS) m() int {
	return (*q).leaf.y
}

impl MS : JN

// AM is a named-distinct managed pointer to a NAMELESS array-of-managed pointee.
type AM @([2]@Leaf)

interface JA {
	n() int
}

func (q AM) n() int {
	return (*q)[0].y
}

impl AM : JA

// AS is a named-distinct managed pointer to an array of destructible STRUCTS (S,
// destructible only after field layout — not by kind).
type AS @([2]S)

interface JS {
	s() int
}

func (q AS) s() int {
	return (*q)[0].leaf.y
}

impl AS : JS

func rc(v @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, v))
}

func boxDrop(leaf @Leaf) {
	var ms MS = box(S{leaf: leaf})
	var j @JN = ms
	present(ms)
	present(j)
}

func boxDropArr(leaf @Leaf) {
	var arr [2]@Leaf
	arr[0] = leaf
	arr[1] = leaf
	var am AM = box(arr)
	var j @JA = am
	present(am)
	present(j)
}

func boxDropStructArr(leaf @Leaf) {
	var arr [2]S
	arr[0] = S{leaf: leaf}
	arr[1] = S{leaf: leaf}
	var as AS = box(arr)
	var j @JS = as
	present(as)
	present(j)
}

type NRP *([2]int)

func main() {
	var leaf @Leaf = make(Leaf)
	leaf.y = 1
	var before int = rc(leaf)
	for i := 0; i < 100; i = i + 1 {
		boxDrop(leaf)
	}
	var after int = rc(leaf)
	if before == after { testing.Println(1) } else { testing.Println(0) } // 1 = named-struct pointee, no leak

	var before2 int = rc(leaf)
	for i := 0; i < 100; i = i + 1 {
		boxDropArr(leaf)
	}
	var after2 int = rc(leaf)
	if before2 == after2 { testing.Println(1) } else { testing.Println(0) } // 1 = nameless managed pointee, no leak

	var before3 int = rc(leaf)
	for i := 0; i < 100; i = i + 1 {
		boxDropStructArr(leaf)
	}
	var after3 int = rc(leaf)
	if before3 == after3 { testing.Println(1) } else { testing.Println(0) } // 1 = array-of-destructible-struct pointee, no leak

	var a [2]int
	var nrp NRP = &a
	var x *any = nrp
	if present(x) { testing.Println(1) } else { testing.Println(0) } // 1 = nameless boxed
}
