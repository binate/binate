package "main"
import "pkg/builtins/testing"

// iface.construct.named-pointer: a named MANAGED pointer boxed into a user @Iface
// it implements (`var j @JN = box(ms)`) is an owning box of an MS cell, so dropping
// it must release the pointer that cell holds — the box's slot-0 destructor is the
// structural managed-pointer drop of the named type's underlying, for every pointee
// shape (a name-based `__dtor_<named>` is never emitted: a null slot 0 would leak
// the pointee and everything it holds):
//  (1) NAMED-STRUCT pointee (type MS @S).
//  (2) NAMELESS managed-containing pointee (type AM @([2]@Leaf)): the array's @Leaf
//      elements must be released, not leaked +1/box.
//  (3) ARRAY-of-destructible-STRUCT pointee (type AS @([2]S), S has a managed field):
//      S is destructible only AFTER field layout, not by kind, so the pointee's drop
//      must still descend into each S and release its @Leaf.
//  (4) A named pointer to a NAMELESS pointee (type NRP *([2]int)) borrows into *any
//      as a well-formed value (present() true), not a degenerate null-vtable box.

import "pkg/builtins/rt"

type Leaf struct {
	y int
}

type S struct {
	leaf @Leaf
}

type MS @S

interface JN {
	m() int
}

func (q MS) m() int {
	return (*q).leaf.y
}

impl MS : JN

// AM is a named managed pointer to a NAMELESS array-of-managed pointee.
type AM @([2]@Leaf)

interface JA {
	n() int
}

func (q AM) n() int {
	return (*q)[0].y
}

impl AM : JA

// AS is a named managed pointer to an array of destructible STRUCTS (S,
// destructible only after field layout — not by kind).
type AS @([2]S)

interface JS {
	s() int
}

func (q AS) s() int {
	return (*q)[0].leaf.y
}

impl AS : JS

func rc(v @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, v))
}

func boxDrop(leaf @Leaf) {
	var ms MS = box(S{leaf: leaf})
	var j @JN = box(ms)
	present(ms)
	present(j)
}

func boxDropArr(leaf @Leaf) {
	var arr [2]@Leaf
	arr[0] = leaf
	arr[1] = leaf
	var am AM = box(arr)
	var j @JA = box(am)
	present(am)
	present(j)
}

func boxDropStructArr(leaf @Leaf) {
	var arr [2]S
	arr[0] = S{leaf: leaf}
	arr[1] = S{leaf: leaf}
	var as AS = box(arr)
	var j @JS = box(as)
	present(as)
	present(j)
}

type NRP *([2]int)

func main() {
	var leaf @Leaf = make(Leaf)
	leaf.y = 1
	var before int = rc(leaf)
	for i := 0; i < 100; i = i + 1 {
		boxDrop(leaf)
	}
	var after int = rc(leaf)
	if before == after { testing.Println(1) } else { testing.Println(0) } // 1 = named-struct pointee, no leak

	var before2 int = rc(leaf)
	for i := 0; i < 100; i = i + 1 {
		boxDropArr(leaf)
	}
	var after2 int = rc(leaf)
	if before2 == after2 { testing.Println(1) } else { testing.Println(0) } // 1 = nameless managed pointee, no leak

	var before3 int = rc(leaf)
	for i := 0; i < 100; i = i + 1 {
		boxDropStructArr(leaf)
	}
	var after3 int = rc(leaf)
	if before3 == after3 { testing.Println(1) } else { testing.Println(0) } // 1 = array-of-destructible-struct pointee, no leak

	var a [2]int
	var nrp NRP = &a
	var x *any = nrp
	if present(x) { testing.Println(1) } else { testing.Println(0) } // 1 = nameless boxed
}
