package "main"

// iface.dispatch.value-receiver.managed-field-refcount: a struct value that carries
// a MANAGED field, boxed into a raw *Iface and dispatched through a VALUE-receiver
// method, must be refcount-balanced on the field -- exactly like a direct value-
// receiver call (balanced) and a pointer-receiver dispatch (balanced).
//
// It is NOT balanced today: the value-receiver deref thunk (genIvRecvThunk) loads the
// receiver struct and forwards it to the owning-copy-convention callee WITHOUT first
// RefInc'ing the struct's managed fields, while the callee RefDecs them on cleanup ->
// net -1 per dispatch.  With live keep-alive refs (as here) that is a silent leak-in-
// reverse / over-release; without them the field's box is freed early and a later read
// is a use-after-free (SIGTRAP).  This is PRE-EXISTING (reproduces on baseline main),
// not part of the named-distinct-pointer work.
//
// XFAIL until genIvRecvThunk RefIncs the loaded receiver's managed fields before
// forwarding (mirroring the caller-side RefInc a direct value-receiver call performs).
// Tracked in explorations/claude-todo.md (CRITICAL: value-receiver deref-thunk
// over-release / double-free).

import "pkg/builtins/rt"

type Leaf struct {
	y int
}

type V struct {
	leaf @Leaf
	a    int
	b    int
}

interface Sum {
	sum() int
}

func (v V) sum() int {
	return v.a + v.b + v.leaf.y
}

impl V : Sum

func rc(v @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, v))
}

func dispatch(leaf @Leaf) int {
	var v V
	v.leaf = leaf
	v.a = 10
	v.b = 20
	var s *Sum = v
	return s.sum()
}

func main() {
	var leaf @Leaf = make(Leaf)
	leaf.y = 3
	// Keep-alive refs so the over-release can't drive the count to 0 (which would
	// free leaf and turn the post-dispatch rc() read into a use-after-free crash);
	// this lets the test observe the -1 delta as a value instead of a SIGTRAP.
	var k1 @Leaf = leaf
	var k2 @Leaf = leaf
	present(k1)
	present(k2)
	var base int = rc(leaf)
	var got int = dispatch(leaf)
	var post int = rc(leaf)
	println(got)                                          // 33 (dispatch correct)
	if base == post { println(1) } else { println(0) }   // want 1 (balanced)
}
