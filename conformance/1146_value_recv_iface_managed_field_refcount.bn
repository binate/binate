package "main"
import "pkg/builtins/testing"

// iface.dispatch.value-receiver.managed-field-refcount: a struct value that carries
// a MANAGED field, boxed into a raw *Iface and dispatched through a VALUE-receiver
// method, is refcount-balanced on the field -- exactly like a direct value-receiver
// call and a pointer-receiver dispatch.
//
// The value-receiver deref thunk (genIvRecvThunk) forwards the loaded receiver to the
// owning-copy-convention callee, which RefDecs its managed fields on scope cleanup.  So
// the thunk RefIncs those fields on entry (mirroring coerceArg's by-value struct-copy
// RefInc on the regular call path); without it the callee would drop the caller's ref
// -- a net -1 per dispatch (a silent reverse-leak with live refs, a use-after-free once
// the count hits 0).

import "pkg/builtins/rt"

type Leaf struct {
	y int
}

type V struct {
	leaf @Leaf
	a    int
	b    int
}

interface Sum {
	sum() int
}

func (v V) sum() int {
	return v.a + v.b + v.leaf.y
}

impl V : Sum

func rc(v @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, v))
}

func dispatch(leaf @Leaf) int {
	var v V
	v.leaf = leaf
	v.a = 10
	v.b = 20
	var s *Sum = v
	return s.sum()
}

func main() {
	var leaf @Leaf = make(Leaf)
	leaf.y = 3
	// Keep-alive refs so the over-release can't drive the count to 0 (which would
	// free leaf and turn the post-dispatch rc() read into a use-after-free crash);
	// this lets the test observe the -1 delta as a value instead of a SIGTRAP.
	var k1 @Leaf = leaf
	var k2 @Leaf = leaf
	present(k1)
	present(k2)
	var base int = rc(leaf)
	var got int = dispatch(leaf)
	var post int = rc(leaf)
	testing.Println(got)                                          // 33 (dispatch correct)
	if base == post { testing.Println(1) } else { testing.Println(0) }   // want 1 (balanced)
}
