package "main"
import "pkg/builtins/testing"

// eval.funcvalue.deref-call: calling a func value obtained by dereferencing a pointer,
// `(*p)()`, LOADS the func value from `*p` and issues an INDIRECT call through it -- just
// like the deref-to-local desugaring `var g @func() int = *p; g()`.  genCall classifies a
// callee whose RESOLVED TYPE is a func value (here EXPR_UNARY(STAR)) as an indirect call;
// without that it fell to the direct-by-name path and emitted a direct call on a malformed
// empty symbol (`@bn_..._main0_`) that is never defined (a `use of undefined value` build
// failure).  The direct-name path only sees TYP_FUNC callees (a named function), so it is
// unaffected.

func plain() int {
	return 42
}

// Named-distinct func-value wrappers: the deref callee's type is TYP_NAMED (not the
// func-value kind), so the fallback must peelTransparent — peelReadonly would miss the
// wrapper and re-emit the empty-symbol build failure.
type Fn *func() int
type XM @func() int

func main() {
	var f @func() int = plain
	var p *(@func() int) = &f
	testing.Println((*p)()) // 42 (bare managed func value)

	var fn Fn = plain
	var pf *Fn = &fn
	testing.Println((*pf)()) // 42 (raw named-distinct wrapper)

	var xm XM = plain
	var px *XM = &xm
	testing.Println((*px)()) // 42 (managed named-distinct wrapper)
}
