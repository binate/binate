package "main"
import "pkg/builtins/testing"

// Unaligned sub-word aggregate access.  `Tri` is a 3-byte struct (align 1), so the
// layout places it at a non-word-aligned offset in these shapes.  On strict-align
// MMU-less arm32 a word LDR/STR there faults; the native backend must access such an
// aggregate byte-wise (and the LLVM lane via -mno-unaligned-access).  aa64/x64 tolerate
// unaligned access in hardware.  Regression guard for the arm32 strict-align fix.
type Tri struct {
	a int8
	b int8
	c int8
}

type S struct {
	x int8
	t Tri // at byte offset 1 — unaligned
}

// (int8, Tri): a sub-word aggregate as the TRAILING multi-return field, at odd offset 1.
func mkByteTri() (int8, Tri) {
	var t Tri
	t.a = cast(int8, 55)
	t.b = cast(int8, 66)
	t.c = cast(int8, 77)
	return cast(int8, 88), t
}

func take(t Tri) int {
	return cast(int, t.a) + cast(int, t.b) + cast(int, t.c)
}

func main() {
	// struct copy of a sub-word aggregate field at an odd offset
	var s S
	s.t.a = cast(int8, 10)
	s.t.b = cast(int8, 20)
	s.t.c = cast(int8, 30)
	var u Tri = s.t
	testing.Println(cast(int, u.a)) // 10
	testing.Println(cast(int, u.b)) // 20
	testing.Println(cast(int, u.c)) // 30

	// pass a sub-word aggregate at an odd offset
	testing.Println(take(s.t)) // 60

	// array-last multi-return: sub-word aggregate at odd offset 1
	var m int8
	var v Tri
	m, v = mkByteTri()
	testing.Println(cast(int, m))   // 88
	testing.Println(cast(int, v.a)) // 55
	testing.Println(cast(int, v.c)) // 77
}
