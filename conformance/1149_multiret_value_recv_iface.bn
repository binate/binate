package "main"
import "pkg/builtins/testing"

// iface.dispatch.value-receiver.multi-return: a VALUE-receiver method with MULTIPLE
// return values, dispatched through an interface value, returns the correct tuple --
// exactly like a direct call.  It needs a receiver thunk (like any value-receiver iface
// method): without one, iv dispatch passes the data-slot POINTER where the method
// expects the receiver VALUE, silently returning garbage.  The thunk extracts the packed
// MultiReturnType struct and re-returns it typed (a bare re-return of the packed struct
// mismatches the multi-value result signature).
//
// Covers: scalar tuple; a receiver carrying a MANAGED field (composes with the thunk's
// receiver-field RefInc -- refcount-balanced); and a MANAGED value flowing out as a
// multi-return result (ownership transfers, no leak / double-free).

import "pkg/builtins/rt"

type Leaf struct {
	y int
}

type V struct {
	leaf @Leaf
	n    int
}

interface Pair {
	pair() (int, int)
}

func (v V) pair() (int, int) {
	return v.leaf.y, v.n
}

impl V : Pair

interface Getter {
	get() (@Leaf, int)
}

func (v V) get() (@Leaf, int) {
	return v.leaf, v.n
}

impl V : Getter

func rc(v @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, v))
}

func main() {
	var lf @Leaf = make(Leaf)
	lf.y = 3
	var keep @Leaf = lf
	present(keep)

	// scalar multi-return dispatch + receiver managed-field balance over 100 dispatches
	var base int = rc(lf)
	var acc int = 0
	for i := 0; i < 100; i = i + 1 {
		var v V
		v.leaf = lf
		v.n = 5
		var s *Pair = v
		var p int
		var q int
		p, q = s.pair()
		acc = acc + p + q
	}
	testing.Println(acc / 100)                                   // 8 (3+5), dispatch correct
	if base == rc(lf) { testing.Println(1) } else { testing.Println(0) } // 1 = receiver field balanced

	// managed value flowing OUT via a multi-return result: ownership transfers,
	// the returned @Leaf is the receiver's field, so lf's count must stay balanced.
	var base2 int = rc(lf)
	var sum int = 0
	for i := 0; i < 100; i = i + 1 {
		var v V
		v.leaf = lf
		v.n = 9
		var g *Getter = v
		var got @Leaf
		var k int
		got, k = g.get()
		sum = sum + got.y + k
	}
	testing.Println(sum / 100)                                     // 12 (3+9)
	if base2 == rc(lf) { testing.Println(1) } else { testing.Println(0) }  // 1 = managed result balanced
}
