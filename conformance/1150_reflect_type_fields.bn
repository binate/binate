package "main"

import "pkg/builtins/reflect"
import "pkg/stdx/fmt"

// Struct reflection P1 (plan-struct-reflection.md): reflect.TypeOf exposes a
// struct's field table — name / offset / KIND_* / size — via the extended 8-word
// __typeinfo record + __typefields blob (spec §7.13.14).  Exercises the field
// RTTI end to end (KIND derivation, offsets, sizes, the concatenated name blob,
// the *[]FieldInfo overlay, and reflect.TypeOf/DataOf) across every backend.

type Point struct {
	x int
	y int
}

type Rec struct {
	n    int
	flag bool
	name @[]char
}

func dump(ti *reflect.TypeInfo) {
	fmt.Printf("kind=%d nfields=%d\n", ti.Kind, len(ti.Fields))
	for i := 0; i < len(ti.Fields); i++ {
		var f reflect.FieldInfo = ti.Fields[i]
		fmt.Printf("  %s off=%d kind=%d size=%d\n", f.Name, f.Offset, f.Kind, f.Size)
	}
}

func main() {
	var p Point
	dump(reflect.TypeOf(p))
	var r Rec
	dump(reflect.TypeOf(r))
	// A non-struct scalar: KIND set, no fields.
	var k int = 7
	fmt.Printf("scalar kind=%d nfields=%d\n", reflect.TypeOf(k).Kind, len(reflect.TypeOf(k).Fields))
	// DataOf + a field offset reads the boxed value's field in place.
	p.x = 3
	p.y = 4
	var base *uint8 = reflect.DataOf(p)
	var yoff int = reflect.TypeOf(p).Fields[1].Offset
	var yptr *int = bit_cast(*int, bit_cast(int, base) + yoff)
	fmt.Printf("dataof y=%d\n", yptr[0])
}
