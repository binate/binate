package "main"
import "pkg/builtins/testing"

// Inline field read off a raw-pointer-to-struct CALL result — `f().x` where
// `f() *T` returns a raw pointer to a struct.  genSelector's call/builtin-result
// arm handles managed-ptr-to-struct (`@T`) and struct-VALUE bases, but had no
// raw-ptr-to-struct (`*T`) case, so it fell through to the fallback and panicked
// ("unresolved selector in IR-gen") — even though the deref and type-assert arms
// both already handle all three shapes.  A raw `*T` result is exactly what
// `reflect.TypeOf` returns (a pointer to immortal static RTTI), so this
// reproduces the same shape with a plain function.

type T struct {
	x int
	y int
}

var g T

func mk() *T {
	return &g
}

func main() {
	g.x = 11
	g.y = 22
	// Both a zero-offset and a non-zero-offset field, read inline off the call.
	testing.Println(mk().x)
	testing.Println(mk().y)
}
