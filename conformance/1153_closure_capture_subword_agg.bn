package "main"
import "pkg/builtins/testing"

// A closure that CAPTURES a sub-word-aligned aggregate (Tri: 3 * int8, AlignOf 1)
// must not fault on strict-align (MMU-less) arm32.  The compiler-internal closure
// struct packs captures, so with two such captures one of them lands at a NON-word
// offset (the second Tri at byte 3); the shim then marshals the captures as call
// arguments, reading each capture word from [captureBase + FieldOffset].  A word LDR
// at an odd (non-word-aligned) offset faults on strict-align memory — so the shim's
// capture read must be alignment-safe.  Distinct decimal places catch a mis-marshal.

type Tri struct {
	a int8
	b int8
	c int8
}

func main() {
	var t1 Tri
	t1.a = 1
	t1.b = 2
	t1.c = 3
	var t2 Tri
	t2.a = 4
	t2.b = 5
	t2.c = 6
	var f *func() int =
		func() int {
			return cast(int, t1.a) * 1 + cast(int, t1.b) * 10 + cast(int, t1.c) * 100 +
					cast(int, t2.a) * 1000 + cast(int, t2.b) * 10000 + cast(int, t2.c) * 100000
		}
	testing.Println(f())
}
