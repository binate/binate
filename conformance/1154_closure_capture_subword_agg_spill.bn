package "main"
import "pkg/builtins/testing"

// A capturing closure whose SUB-word captures OVERFLOW the 4 GP arg regs, so at least
// one capture spills to the outgoing stack.  With a leading int8 pad + four Tri (3 *
// int8, align 1) captures (5 arg words > 4), captures 0..3 ride R0..R3 and the last
// spills — exercising the STACK-bound byte-wise capture spill
// (emitClosureCaptureSpillArm32) as well as the register-bound byte-wise reg-load, both
// of which must stay strict-align safe on native (MMU-less) arm32.  The middle captures
// are zero; distinct decimal places on `pad`, `t0`, and the spilled `t3` catch a
// mis-marshal of the first narrow capture, a reg-bound aggregate, or the spilled one.

type Tri struct {
	a int8
	b int8
	c int8
}

func main() {
	var pad int8 = 8
	var t0 Tri
	t0.a = 1
	t0.b = 2
	t0.c = 3
	var z1 Tri
	var z2 Tri
	var t3 Tri
	t3.a = 4
	t3.b = 5
	t3.c = 6
	var f *func() int =
		func() int {
			return cast(int, pad) * 1 + cast(int, t0.a) * 10 + cast(int, t0.b) * 100 +
					cast(int, t0.c) * 1000 + cast(int, z1.a) + cast(int, z2.a) +
					cast(int, t3.a) * 10000 + cast(int, t3.b) * 100000 + cast(int, t3.c) * 1000000
		}
	testing.Println(f())
}
