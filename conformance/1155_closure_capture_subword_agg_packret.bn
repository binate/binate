package "main"

// A capturing closure that RETURNS a small (<= 4-byte) aggregate BY VALUE rides the
// PACK shim (the underlying returns the aggregate in R0; the shim stores it through the
// retbuf), which is always framed and marshals captures through the byte-wise-capable
// spill helpers.  A leading int8 pad places the Tri capture at a NON-word offset, so the
// capture read must be strict-align safe on native (MMU-less) arm32.  Distinct decimal
// places on the returned fields catch a mis-marshal of either capture.

type Tri struct {
	a int8
	b int8
	c int8
}

func main() {
	var pad int8 = 5
	var t Tri
	t.a = 7
	t.b = 8
	t.c = 9
	var f *func() Tri =
		func() Tri {
			var r Tri
			r.a = t.a + pad
			r.b = t.b
			r.c = t.c
			return r
		}
	var r Tri = f()
	println(cast(int, r.a) * 1 + cast(int, r.b) * 10 + cast(int, r.c) * 100)
}
