package "main"

// A capturing closure that RETURNS a large (> 4-byte) aggregate rides the SRET shim
// (the retbuf stays in R0; the underlying writes the result through it), which is framed
// and marshals captures through the byte-wise-capable spill helpers.  A leading int8 pad
// places the Tri capture at a NON-word offset, so the capture read must be strict-align
// safe on native (MMU-less) arm32.  Distinct decimal places on the six returned fields
// catch a mis-marshal of either capture.

type Tri struct {
	a int8
	b int8
	c int8
}

type Hex struct {
	a int8
	b int8
	c int8
	d int8
	e int8
	f int8
}

func main() {
	var pad int8 = 2
	var t Tri
	t.a = 1
	t.b = 2
	t.c = 3
	var g *func() Hex =
		func() Hex {
			var h Hex
			h.a = t.a
			h.b = t.b
			h.c = t.c
			h.d = pad
			h.e = 4
			h.f = 5
			return h
		}
	var h Hex = g()
	println(cast(int, h.a) * 1 + cast(int, h.b) * 10 + cast(int, h.c) * 100 +
			cast(int, h.d) * 1000 + cast(int, h.e) * 10000 + cast(int, h.f) * 100000)
}
