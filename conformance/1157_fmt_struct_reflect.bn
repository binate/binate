package "main"

import "pkg/stdx/fmt"

// Struct/default reflection for %v (plan-struct-reflection.md P2): a by-value
// struct without a String() renders its fields as {…} via read-bytes-per-kind
// (KIND + size off the reflect field table).  Operands are bare values
// (conformance is not linted); a raw *T boxes as its pointee, so &pt would render
// identically.  Field VALUES are printed (not offsets), so the output is
// word-size independent — no ILP32 override needed (unlike 1150).  Scalars +
// char-slices render fully; a nested NAMED struct field recurses (P3), while a
// nil pointer field renders `<nil>` (P4b-2).

type Point struct {
	x int
	y int
}

type Mixed struct {
	i int
	u uint
	f float64
	b bool
	s @[]char
	c char
}

type Inner struct {
	a int
}

type Outer struct {
	n   int
	sub Inner
	p   *int
}

func main() {
	var pt Point
	pt.x = 3
	pt.y = 4
	fmt.Printf("%v\n", pt)   // {3 4}
	fmt.Println(pt)          // {3 4}
	fmt.Printf("[%s]\n", pt) // [{3 4}]  (%s of a struct funnels to %v)
	var m Mixed
	m.i = -5
	m.u = 42
	m.f = 3.14
	m.b = true
	m.s = "hi"
	m.c = 65
	fmt.Printf("%v\n", m) // {-5 42 3.14 true hi 65}
	var o Outer
	o.n = 1
	o.sub.a = 9
	fmt.Printf("%v\n", o) // {1 {9} <nil>}  (nested Inner recurses; nil *int renders <nil>)
}
