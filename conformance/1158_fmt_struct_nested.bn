package "main"

import "pkg/std/fmt"

// fmt %v RECURSES into nested
// by-value NAMED struct fields via the field table's per-field typeinfo pointer
// (force-emitted records + the VM two-phase back-patch resolve the cross-record
// reference).  Covers: a nested struct alongside scalars, a deep A→B→C chain, a
// shared field type reached twice (force-emitted once), and an anonymous struct
// field that ALSO recurses into its fields (decision 7 — an anon struct now has a
// structural, TU-invariant record).  Field VALUES are printed (not offsets), so the
// output is word-size independent — no ILP32 override needed.

type Inner struct {
	a int
}

type Outer struct {
	n   int
	sub Inner
	m   int
}

type C struct {
	z int
}

type B struct {
	y int
	c C
}

type A struct {
	x int
	b B
}

type Two struct {
	p Inner
	q Inner
}

type WithAnon struct {
	k  int
	an struct {
		a int
		b int
	}
}

func main() {
	var o Outer
	o.n = 1
	o.sub.a = 9
	o.m = 2
	fmt.Printf("%v\n", o) // {1 {9} 2}

	var a A
	a.x = 1
	a.b.y = 2
	a.b.c.z = 3
	fmt.Printf("%v\n", a) // {1 {2 {3}}}

	var t Two
	t.p.a = 5
	t.q.a = 6
	fmt.Printf("%v\n", t) // {{5} {6}}

	var wa WithAnon
	wa.k = 7
	wa.an.a = 8
	wa.an.b = 9
	fmt.Printf("%v\n", wa) // {7 {8 9}}  (anonymous field recurses — decision 7)
	fmt.Printf("%+v\n", wa) // {k:7 an:{a:8 b:9}}
}
