package "main"

import "pkg/stdx/fmt"

// `%+v` labels a struct's
// fields `{name:value ...}`, recursively for nested
// structs; plain `%v` stays values-only `{...}`; `%+v` of a non-struct falls back
// to `%v`.  Field names + values only (no offsets), so the output is word-size
// independent — no ILP32 override.

type Point struct {
	x int
	y int
}

type Inner struct {
	a int
}

type Outer struct {
	n   int
	sub Inner
}

func main() {
	var p Point
	p.x = 3
	p.y = 4
	fmt.Printf("%v\n", p)  // {3 4}
	fmt.Printf("%+v\n", p) // {x:3 y:4}
	var o Outer
	o.n = 1
	o.sub.a = 9
	fmt.Printf("%+v\n", o) // {n:1 sub:{a:9}}  (nested labeled too)
	var k int = 7
	fmt.Printf("%+v\n", k) // 7  (non-struct: %+v == %v)
}
