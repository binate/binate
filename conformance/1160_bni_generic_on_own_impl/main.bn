package "main"
import "pkg/builtins/testing"
import "pkg/ct"

func main() {
	var b @ct.Box[ct.Item] = ct.Make(42)
	testing.Println(b.V.N)         // field read: 42
	testing.Println(b.V.Size())    // method on the own-impl'd type: 142
	testing.Println(ct.Seed.V.N)   // extern var of the own-impl'd generic: 7
	testing.Println(ct.Seed.V.Size()) // 107
}
