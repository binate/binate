package "pkg/ct"

// A package that names a generic instantiated on a type it `impl`s in its OWN
// `.bni` -- `func Make() @Box[Item]` and the extern `var Seed @Box[Item]`
// alongside `impl Item : Sizer`.  Building the interface surface resolves
// `Box[Item]` before this package's impls are collected, so the constraint check
// must be deferred to the full package check (see Checker.BuildingIfaceScope)
// rather than wrongly rejecting Item here.  The extern var is the case that has
// no re-resolution in the merged decl list (the loader does not prepend `.bni`
// extern vars), so its deferred check is fired explicitly in checkPackageImpl.
interface Sizer { Size() int }
type Box[T Sizer] struct { V T }
type Item struct { N int }
func (i Item) Size() int
impl Item : Sizer
func Make(n int) @Box[Item]
var Seed @Box[Item]
