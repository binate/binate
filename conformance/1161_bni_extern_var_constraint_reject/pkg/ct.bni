package "pkg/ct"

// A `.bni` extern var whose generic type-arg does NOT satisfy the constraint
// (Bad has no `impl Bad : Sizer`) must be rejected.  `.bni` extern vars are not
// prepended into the merged decl list, so the constraint check deferred while
// building the interface surface is fired explicitly in checkPackageImpl -- a
// regression guard that deferral did not silently drop the check.
interface Sizer { Size() int }
type Box[T Sizer] struct { V T }
type Bad struct { N int }
var Reg @Box[Bad]
func Dummy() int
