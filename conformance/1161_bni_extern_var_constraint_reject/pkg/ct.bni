package "pkg/ct"

// A `.bni` extern var whose generic type-arg does NOT satisfy the constraint
// (Bad has no `impl Bad : Sizer`) must be rejected.  Resolving the `.bni` surface
// defers the `@Box[Bad]` check (impls are not yet collected); that deferred check
// is recorded and replayed by the package's own full check
// (recheckDeferredConstraints) -- a regression guard that deferral did not
// silently drop the check.
interface Sizer { Size() int }
type Box[T Sizer] struct { V T }
type Bad struct { N int }
var Reg @Box[Bad]
func Dummy() int
