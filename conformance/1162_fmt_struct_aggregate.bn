package "main"

import "pkg/stdx/fmt"

// Struct-reflection P4b-1 (plan-struct-reflection.md): an array or (non-char)
// slice FIELD renders its elements inline as `[e0 e1 ...]`.  A scalar/char-slice
// element formats in place; a struct element recurses through the element record
// (the field table's typeinfo-ptr points at the ELEMENT's `__typeinfo` for an
// array/slice field).  A nil/zero-length slice renders `[]`.  A nested-aggregate
// element (slice-of-slice) renders a `[...]` placeholder — the element record
// carries only the immediate element kind, not a deeper record.  `%+v` labels the
// field and recurses names into struct elements.  Output is values-only (no
// offsets), so it is word-size independent — no ILP32 override.

type Point struct {
	x int
	y int
}

type WithArray struct {
	a [3]int
	n int
}

type WithSlices struct {
	ints  @[]int
	bools @[]bool
}

type WithSliceOfStruct struct {
	pts @[]Point
}

type WithNestedSlice struct {
	rows @[]@[]int
}

type Cyclic struct {
	label int
	kids  @[]Cyclic
}

type Wrapped struct {
	v int
}

type Wrapper struct {
	inner Wrapped
}

func main() {
	var arr WithArray
	arr.a[0] = 1
	arr.a[1] = 2
	arr.a[2] = 3
	arr.n = 9
	fmt.Printf("%v\n", arr) // {[1 2 3] 9}

	var sl WithSlices
	sl.ints = make_slice(int, 3)
	sl.ints[0] = 4
	sl.ints[1] = 5
	sl.ints[2] = 6
	sl.bools = make_slice(bool, 3)
	sl.bools[0] = true
	sl.bools[1] = false
	sl.bools[2] = true
	fmt.Printf("%v\n", sl) // {[4 5 6] [true false true]}

	var empty WithSlices
	fmt.Printf("%v\n", empty) // {[] []}  (nil slices)

	var sos WithSliceOfStruct
	sos.pts = make_slice(Point, 2)
	sos.pts[0].x = 1
	sos.pts[0].y = 2
	sos.pts[1].x = 3
	sos.pts[1].y = 4
	fmt.Printf("%v\n", sos)  // {[{1 2} {3 4}]}  (struct elements recurse)
	fmt.Printf("%+v\n", sos) // {pts:[{x:1 y:2} {x:3 y:4}]}  (labeled)

	var ns WithNestedSlice
	ns.rows = make_slice(@[]int, 2)
	ns.rows[0] = make_slice(int, 2)
	ns.rows[1] = make_slice(int, 1)
	fmt.Printf("%v\n", ns) // {[[...] [...]]}  (nested aggregate -> placeholder)

	// A slice-backed self-cycle (user error, like a refcount cycle) is guarded: the
	// re-entered struct renders `{...}` instead of overflowing the stack.
	var cyc Cyclic
	cyc.label = 7
	cyc.kids = make_slice(Cyclic, 1)
	cyc.kids[0] = cyc
	fmt.Printf("%v\n", cyc) // {7 [{7 [{...}]}]}

	// A single-field wrapper whose inner struct shares the outer's base address is
	// NOT a cycle (the guard keys on (base, type), and the types differ).
	var wrap Wrapper
	wrap.inner.v = 5
	fmt.Printf("%v\n", wrap) // {{5}}
}
