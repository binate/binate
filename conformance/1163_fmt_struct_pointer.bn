package "main"

import "pkg/std/fmt"

// Struct-reflection: a pointer FIELD is followed
// to its pointee and `&`-prefixed — `&{3 4}` for a struct pointee, `&5` for a
// scalar; a nil pointer renders `<nil>`.  A managed `@T` field follows identically
// to a raw `*T` (both store the pointee's payload address).  A self-referential
// pointer is cycle-guarded, rendering `&{...}` at the re-entry.  `%+v` labels the
// field and the struct pointee's fields.  Output is value-only (no raw addresses),
// so it is word-size independent — no ILP32 override.  (Operands are `&`-boxed so
// DataOf points at the original struct; a bare-value box would copy it, shifting a
// self-cycle one level deeper.)

type Point struct {
	x int
	y int
}

type Holder struct {
	p    *Point
	n    *int
	nilp *Point
}

type MHolder struct {
	mp @Point
}

type Node struct {
	label int
	next  *Node
}

// Managed needs a destructor (its `@[]int` field), and is reached ONLY through a
// pointer field (never boxed) — so its record is force-emitted for reflection.  A
// force-emit record must NOT reference the pointee's dtor HANDLE (emitted only at
// box sites, which don't exist here) or this fails to compile with "use of
// undefined value @__handle.…__dtor_Managed"; it carries a null dtor instead.
type Managed struct {
	data @[]int
}

type MHost struct {
	m *Managed
}

func main() {
	var pt Point
	pt.x = 3
	pt.y = 4
	var k int = 5
	var h Holder
	h.p = &pt
	h.n = &k
	fmt.Printf("%v\n", &h) // {&{3 4} &5 <nil>}
	fmt.Printf("%+v\n", &h) // {p:&{x:3 y:4} n:&5 nilp:<nil>}

	var mh MHolder
	mh.mp = make(Point)
	mh.mp.x = 1
	mh.mp.y = 2
	fmt.Printf("%v\n", &mh) // {&{1 2}}  (managed pointer follows like a raw pointer)

	var nd Node
	nd.label = 7
	nd.next = &nd
	fmt.Printf("%v\n", &nd) // {7 &{...}}  (self-cycle guarded)

	var mgd Managed
	mgd.data = make_slice(int, 2)
	mgd.data[0] = 8
	mgd.data[1] = 9
	var mhost MHost
	mhost.m = &mgd
	fmt.Printf("%v\n", &mhost) // {&{[8 9]}}  (force-emitted dtor-needing pointee)
}
