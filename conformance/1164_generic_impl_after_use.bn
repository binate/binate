// A generic instantiated on a type is accepted whether that type's `impl` is
// declared before OR after the use site: here `func Make() @Box[Item]` and the
// `@Box[Item]` uses in main precede `impl Item : Sizer`.  The constraint check is
// deferred until every impl is collected (top-level decls are order-independent).
package "main"

interface Sizer { Size() int }
type Box[T Sizer] struct { v T }
type Item struct { n int }

func Make(x int) @Box[Item] {
	var b @Box[Item] = make(Box[Item])
	b.v = Item{n: x}
	return b
}

func (i Item) Size() int { return i.n + 100 }
impl Item : Sizer

func main() {
	var b @Box[Item] = Make(42)
	println(b.v.n)      // 42
	println(b.v.Size()) // 142
}
