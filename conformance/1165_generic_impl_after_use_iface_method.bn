// An interface method returning a generic on an own-impl'd type
// (`Holder.Get() @Box[Item]`) is accepted with the same order-independence as a
// free function: the interface (its method signature checked) is declared before
// `impl Item : Sizer`.  Impls are collected before BOTH free-function and
// interface-method signatures are constraint-checked.
package "main"
import "pkg/builtins/testing"

interface Sizer { Size() int }
type Box[T Sizer] struct { v T }
type Item struct { n int }

interface Holder { Get() @Box[Item] }
type H struct { seed int }
func (h H) Get() @Box[Item] {
	var b @Box[Item] = make(Box[Item])
	b.v = Item{n: h.seed}
	return b
}
impl H : Holder

func (i Item) Size() int { return i.n }
impl Item : Sizer

func main() {
	var h H
	h.seed = 9
	var b @Box[Item] = h.Get()
	testing.Println(b.v.n)      // 9
	testing.Println(b.v.Size()) // 9
}
