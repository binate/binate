package "pkg/glib"

// A generic instantiation nested inside a type reached only through a `.bni`-
// surface signature (`func Make() @Outer[int]`, where `Outer`'s field is
// `@Box[Bad]`) must still have its constraint checked: Bad satisfies no
// `impl : Sizer` anywhere, so this is rejected.  The `.bni` surface resolves the
// nested `@Box[Bad]` while building the package's exported scope, before impls are
// collected; the deferred check is recorded and replayed by the package's own
// full check (see recheckDeferredConstraints), rather than being silently dropped.
interface Sizer { Size() int }
type Box[T Sizer] struct { v T }
type Bad struct { n int }
type Outer[U any] struct { inner @Box[Bad] }
func Make() @Outer[int]
