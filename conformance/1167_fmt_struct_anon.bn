package "main"

import "pkg/stdx/fmt"

// Struct-reflection decision 7 (plan-struct-reflection.md): an ANONYMOUS struct now
// has a structural, TU-invariant identity (mangleTypeArg's struct arm), so it renders
// its FIELDS — both as a top-level boxed value (the box keys on the structural
// identity) and as a struct field — instead of the old `{...}` placeholder.  Covers a
// top-level boxed anon struct, an anon FIELD with mixed field kinds (int/bool/char-
// slice), and a nested anon-in-anon field.  Values only, so word-size independent.

type Host struct {
	tag @[]char
	an  struct {
		n int
		b bool
		s @[]char
	}
}

type Nested struct {
	outer struct {
		inner struct {
			v int
		}
	}
}

func main() {
	// A top-level boxed anonymous struct value renders its fields.
	var x struct {
		a int
		b int
	}
	x.a = 5
	x.b = 6
	fmt.Printf("%v\n", x) // {5 6}

	var h Host
	h.tag = "T"
	h.an.n = -3
	h.an.b = true
	h.an.s = "hi"
	fmt.Printf("%v\n", h)  // {T {-3 true hi}}
	fmt.Printf("%+v\n", h) // {tag:T an:{n:-3 b:true s:hi}}

	var nst Nested
	nst.outer.inner.v = 9
	fmt.Printf("%v\n", nst) // {{{9}}}  (anon-in-anon recurses)
}
