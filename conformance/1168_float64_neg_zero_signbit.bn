package "main"
import "pkg/builtins/testing"

// Float64 negation is an IEEE sign-bit flip, so negating a +0.0 yields -0.0
// (bit 63 set), NOT +0.0.  The VM once computed `-x` as `0.0 - x`, which under
// round-to-nearest collapses -0.0 back to +0.0 — diverging from compiled mode
// (a true bit flip) on ±0.  This runs under the `-int` modes too, where the VM
// leg is what regressed; patterns are printed as int64 (bit_cast) so the check
// is exact and ILP32-safe (int is 32 bits there — see 330).
//
// `x` comes from opaque() — a runtime +0.0 that constant folding can't reach,
// so `-x` is a genuine runtime negation, not a folded constant.

func opaque(n int) float64 {
	if n == 0 { return 1.0 }
	return 0.0
}

func main() {
	// +0.0: all bits zero — confirms the source really is a positive zero.
	var x float64 = opaque(1)
	testing.Println(bit_cast(int64, x)) // 0

	// -x of a +0.0 → -0.0 → 0x8000000000000000 = -9223372036854775808.
	testing.Println(bit_cast(int64, -x)) // -9223372036854775808

	// The `-0.0` literal takes the same negation path and must match.
	var z float64 = -0.0
	testing.Println(bit_cast(int64, z)) // -9223372036854775808

	// A nonzero runtime value still negates normally: -2.0 = 0xC000000000000000
	// = -4611686018427387904 (guards a mask that flips more than bit 63).
	var y float64 = opaque(1) + 2.0
	testing.Println(bit_cast(int64, -y)) // -4611686018427387904
}
