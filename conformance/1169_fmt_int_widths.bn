package "main"

import "pkg/std/fmt"

// End-to-end fmt over EVERY integer width — int, the sized int8/16/32, int64, uint,
// the sized uint8/16/32, uint64, and char (uint8).  fmt's operand dispatch widens
// each to int64/uint64 via a shared classifier (intOperand) ahead of the strconv
// digit emitters; before it only int/int64/uint64 matched and the rest rendered as
// an error verb (`%!d(?=…)`).  Operands are passed bare (typed locals), exercising
// the implicit value→`*any` borrow; the output is byte-identical compiled and
// interpreted, and width-independent (small values, so word-sized `uint` renders the
// same on LP64 and ILP32).

func main() {
	var i8 int8 = -8
	var i16 int16 = -16
	var i32 int32 = -32
	fmt.Printf("%d %d %d\n", i8, i16, i32) // -8 -16 -32

	var u uint = 5
	var u8 uint8 = 8
	var u16 uint16 = 16
	var u32 uint32 = 32
	fmt.Printf("%d %d %d %d\n", u, u8, u16, u32) // 5 8 16 32

	// %v of an integer of any width is its base-10 value; char (uint8) prints its
	// numeric byte value (90), matching Go's byte — %c is the character rendering.
	var c char = 90
	fmt.Printf("%v %v %v\n", i8, u32, c) // -8 32 90

	// %c / %q treat char (and any integer) as a byte-oriented character.
	var ca char = 'A'
	var cb uint8 = 66
	var cc int32 = 67
	fmt.Printf("%c%c%c %q\n", ca, cb, cc, ca) // ABC 'A'

	// The base verbs and sign-aware zero-padding reach the sized widths too.
	var ff uint8 = 255
	var five uint8 = 5
	var neg int16 = -1
	fmt.Printf("%x %X %o %b %x\n", ff, ff, u8, five, neg) // ff FF 10 101 -1
	fmt.Printf("%08d\n", i8) // -0000008
}
