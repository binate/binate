package "main"
import "pkg/builtins/testing"

// Regression: materialize a string literal into a distinct NAMED char-slice (or
// char-array) destination.  The string -> managed-slice / {ptr,len} / array
// materialization gates (isCharSliceType / isCharArrayType) must peel the named
// wrapper; otherwise the raw string data pointer is stored into the slice slot
// (garbage length word, or a 4-word managed slot RefInc'd off an i8* = invalid
// IR) or the char-array is left uninitialised.  Covers every init context that
// does NOT route through the already-peeling simple-assignment path: local
// var-init, struct-field & array-element composite literals, index-assign into a
// managed-slice element, `return`, an outer-readonly underlying, a two-level
// named chain, and a named char-array.

type Str @[]char
type RoStr @[]readonly char
type A @[]char
type B A
type Arr [5]char

type W struct { s Str }

func ret() Str { return "ret" }

func main() {
	var v Str = "vinit"
	testing.Println(v)

	var w W = W{s: "field"}
	testing.Println(w.s)

	var arr [2]Str = [2]Str{"e0", "e1"}
	testing.Println(arr[0])
	testing.Println(arr[1])

	var sl @[]Str = make_slice(Str, 1)
	sl[0] = "idx"
	testing.Println(sl[0])

	testing.Println(ret())

	var ro RoStr = "roinit"
	testing.Println(ro)

	var b B = "twolvl"
	testing.Println(b)

	var ca Arr = "arr55"
	testing.Println(cast(int, ca[0]))
	testing.Println(cast(int, ca[4]))
}
