package "main"

import "pkg/builtins/lang"
import "pkg/std/strconv"
import "pkg/stdx/fmt"

// End-to-end: a NAMED scalar type renders via its underlying kind under every
// applicable verb (fmt recovers the value by reflection — the built-in type cases
// never match a named type).  The Stringer interaction is verb-dependent, matching
// Go: %v/%s honor a custom String() (checked first), but %d and the other typed
// verbs render the NUMBER (they do not consult Stringer).  Byte-identical compiled
// and interpreted; the values are small, so word-sized underlyings render the same
// on LP64 and ILP32.

type Celsius int
type Ratio float64
type Flag bool
type Money int

// String renders `$<n>` — deliberately different from the bare number, so %v/%s
// (Stringer) is visibly distinct from %d (the reflection number path).
func (m *Money) String() @[]char {
	var s @[]char = strconv.Itoa(cast(int, *m))
	var out @[]char = make_slice(char, len(s) + 1)
	out[0] = '$'
	for i := 0; i < len(s); i++ {
		out[i + 1] = s[i]
	}
	return out
}

impl *Money : lang.Stringer

func main() {
	var c Celsius = 20
	fmt.Printf("%v %d %x\n", c, c, c) // 20 20 14
	var deg Celsius = 65
	fmt.Printf("%c\n", deg) // A

	var r Ratio = 1.5
	fmt.Printf("%v %.2f %g\n", r, r, r) // 1.5 1.50 1.5

	var f Flag = true
	fmt.Printf("%v %t\n", f, f) // true true

	// %v/%s honor String(); %d renders the number (Go: %d ignores Stringer).
	var m Money = 42
	fmt.Printf("%v %s %d\n", m, m, m) // $42 $42 42
}
