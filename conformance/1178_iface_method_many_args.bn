package "main"
import "pkg/builtins/testing"

// An interface method whose user-arg count forces a stack spill under the
// handle-shim dispatch ABI, checking that PlanFrame's outgoing-args reservation
// matches what the iface emitter actually spills.  The native iface dispatch
// (emitCallIfaceMethod) lays outgoing words as [data, receiver] (prefixSlots 2)
// then the marshaled user args — one MORE fixed prefix (the receiver) than the
// func-value path's [data].  On arm32 (4 GP arg regs) the [data, receiver]
// prefix takes r0/r1, so only r2/r3 carry user args and the rest spill to the
// outgoing-args stack region.
//
// Pre-fix the shared sizer (common_call.bn callDispatchArgTypesAnyOp) modeled
// the iface dispatch with only ONE prefix slot (the pre-handle raw-dispatch
// shape), so PlanFrame reserved one outgoing word too few and the emitter's
// spilled tail overran the frame slot immediately above the outgoing-args area —
// a silent stack corruption.  The `guard` array pins that: it is a real frame
// memory region (accessed by address arithmetic, so the register allocator
// cannot shadow it in a higher slot the way it copies scalar SSA values), and it
// lands at the first frame slot above the outgoing-args region.  With the sizer
// under-reservation, the spilled 7th user arg overwrites guard[0]; the fix makes
// every guard element survive the call.  (Seven int args past the 2-word prefix
// sit at the odd parity where the 8-byte stack-align rounding does not otherwise
// mask the one-word gap.)

type Adder struct {
	base int
}

func (a *Adder) compute(p int, q int, r int, s int, t int, u int, v int) int {
	return a.base + p + q + r + s + t + u + v
}

interface Computer {
	compute(p int, q int, r int, s int, t int, u int, v int) int
}

impl *Adder : Computer

func main() {
	var guard [6]int
	guard[0] = 11
	guard[1] = 22
	guard[2] = 33
	guard[3] = 44
	guard[4] = 55
	guard[5] = 66
	var ad @Adder = make(Adder)
	ad.base = 1000
	var c @Computer = ad
	testing.Println(c.compute(1, 2, 3, 4, 5, 6, 7)) // 1000 + 28 = 1028
	testing.Println(guard[0])                       // 11
	testing.Println(guard[1])                       // 22
	testing.Println(guard[2])                       // 33
	testing.Println(guard[3])                       // 44
	testing.Println(guard[4])                       // 55
	testing.Println(guard[5])                       // 66
}
