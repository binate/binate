package "main"

// The retbuf variant of 1178: an interface method with a MULTI-RETURN result
// AND enough user args to force a stack spill.  Under the handle-shim dispatch
// ABI a retbuf return makes the prefix [retbuf, data, receiver] (prefixSlots 3),
// so on arm32 (4 GP arg regs) r0/r1/r2 carry the prefix and only r3 carries a
// user arg — every user arg past the first spills to the outgoing-args stack.
//
// This exercises the sizer's retbuf branch.  Pre-fix the shared sizer
// (common_call.bn callDispatchArgTypesAnyOp) modeled the iface dispatch with the
// pre-handle raw-dispatch prefix — ONE slot for a small (register-returned)
// multi-return, versus the emitter's THREE ([retbuf, data, receiver]) — so
// PlanFrame under-reserved the outgoing-args region by two words and the
// emitter's spilled tail overran the frame slots above it.  The `guard` array is
// a real frame memory region the allocator cannot shadow, placed at the first
// frame slot above the outgoing-args area; pre-fix the two trailing spilled user
// args overwrite guard[0] and guard[1], and the fix makes every guard element
// survive the call.  Five int args past the 3-word prefix guarantee a multi-word
// spill on arm32.

type Combiner struct {
	base int
}

func (c *Combiner) combine(p int, q int, r int, s int, t int) (int, int) {
	return c.base + p + q + r + s + t, c.base - p - q - r - s - t
}

interface Combining {
	combine(p int, q int, r int, s int, t int) (int, int)
}

impl *Combiner : Combining

func main() {
	var guard [6]int
	guard[0] = 11
	guard[1] = 22
	guard[2] = 33
	guard[3] = 44
	guard[4] = 55
	guard[5] = 66
	var cb @Combiner = make(Combiner)
	cb.base = 1000
	var iv @Combining = cb
	var lo int
	var hi int
	lo, hi = iv.combine(1, 2, 3, 4, 5) // 1015, 985
	println(lo)                        // 1015
	println(hi)                        // 985
	println(guard[0])                  // 11
	println(guard[1])                  // 22
	println(guard[2])                  // 33
	println(guard[3])                  // 44
	println(guard[4])                  // 55
	println(guard[5])                  // 66
}
