package "main"
import "pkg/builtins/testing"

import "pkg/std/errors"

// A user-defined leaf error with NO managed fields: its cross-mode dtor slot
// is null (native ZeroRefDestroy just frees).  errors.Is over it RefDecs the
// @Error args, loading that dtor slot — the exact SIGSEGV site when the slot
// held a raw VM vtable index instead of a native handle-vtable.
type leaf struct { tag int }

func (e @leaf) Error() @[]readonly char { return "leaf" }

func (e @leaf) Unwrap() @errors.Error { var none @errors.Error; return none }

impl @leaf : errors.Error

// A user-defined error carrying a managed cause: it HAS a managed field, so
// its cross-mode dtor slot is a non-null handle re-entering the VM, and its
// Unwrap() (a bytecode method) is dispatched BY the native errors.Is while
// walking the chain.
type wrapErr struct { cause @errors.Error }

func (e @wrapErr) Error() @[]readonly char { return "wrap" }

func (e @wrapErr) Unwrap() @errors.Error { return e.cause }

impl @wrapErr : errors.Error

func main() {
	var l @leaf = make(leaf)
	var as @errors.Error = l
	// Identity: errors.Is matches on the FIRST same() compare, before Unwrap
	// is ever called — the minimal SIGSEGV repro.
	testing.Println(errors.Is(as, as))

	// Chain: wrapErr.Unwrap() (a bytecode method dispatched by native Is)
	// yields the wrapped base, which Is then matches.
	var base @errors.Error = errors.NotFound
	var w @wrapErr = make(wrapErr)
	w.cause = base
	var we @errors.Error = w
	testing.Println(errors.Is(we, base))

	// Not found: a distinct fresh target never in we's chain.
	testing.Println(errors.Is(we, errors.New("other")))
}
