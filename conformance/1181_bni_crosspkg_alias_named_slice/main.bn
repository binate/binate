package "main"
import "pkg/builtins/testing"

import "pkg/mid"

// main imports ONLY pkg/mid; inner (the alias target's home) is a transitive
// import — the case where imported-alias resolution previously dropped the layout.
func check() mid.Alias {
	var r mid.Alias = "hello"
	if len(r) != 5 { return "wrong len" }
	return r
}

func main() {
	var r mid.Alias = check()
	testing.Println(len(r))
	testing.Println(cast(int, r[0]))
	testing.Println(cast(int, r[4]))
}
