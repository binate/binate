package "pkg/mid"

import "pkg/inner"

// A `.bni`-declared type ALIAS whose target is a distinct named type in ANOTHER
// package: `inner.Str` is inner's real named type (a %BnManagedSlice), so a value
// of this type lowers as a managed-slice -- read as a scalar it would be lowered
// as i64 (`extractvalue i64` on `len`, invalid IR).
type Alias = inner.Str
