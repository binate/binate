package "pkg/mid"

import "pkg/inner"

// A `.bni`-declared type ALIAS whose target is a distinct named type in ANOTHER
// package.  IR-gen's imported-alias resolution must install THIS file's imports so
// `inner.Str` resolves to inner's real named type (a %BnManagedSlice); otherwise
// the target reads as the bare `inner.Str`, misses the type registry, and freezes
// to the scalar TypInt fallback — a value of this type then mis-lowered as i64
// (`extractvalue i64` on `len`, invalid IR).
type Alias = inner.Str
