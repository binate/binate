package "main"

import "pkg/builtins/testing"
import "pkg/builtins/lang"

// Celsius is a user-defined type (declared in THIS bytecode program, never linked
// into the interpreter binary) implementing lang.Stringer.  Its (Celsius, Stringer)
// satisfaction fact lives only in the VM's own sat registry — so an injected-native
// testing.writeArg asserting arg.(*lang.Stringer) on a bytecode-boxed Celsius only
// resolves if the native rt.SatLookup MISS re-enters the VM registry (the cross-mode
// RTTI fallback).  Guards that dual-mode path (compiled and interpreted agree).
type Celsius int

func (c Celsius) String() @[]char { return "20C" }

impl Celsius : lang.Stringer

// End-to-end pkg/builtins/testing.Print/Println over the type-erased `...*any`
// variadic: char-slice operands (raw string literal, raw variable, managed
// @[]char) are written verbatim; scalars (int / bool) render through their
// lang.Stringer String().  A single space separates adjacent operands within a
// call; Println appends a trailing newline, Print does not.  Runs in EVERY
// conformance mode INCLUDING the bytecode VM (builder-comp-int), so it also
// proves testing.Println's cross-mode lang.Stringer dispatch works interpreted,
// not only compiled.

// mkHi builds "hi" as a managed @[]char, to drive writeArg's @[]char operand arm
// (a string literal is a raw *[]readonly char; managed char-slices arrive from
// allocating helpers).
func mkHi() @[]char {
	var s @[]char = make_slice(char, 2)
	s[0] = cast(char, 104) // 'h'
	s[1] = cast(char, 105) // 'i'
	return s
}

func main() {
	// Bare string literals + inter-operand spacing.
	testing.Println("hello", "world") // hello world

	// Raw char-slice variable.
	var greeting *[]readonly char = "greetings"
	testing.Println(greeting) // greetings

	// int via lang.Stringer (bare variable), incl. negative + string+int spacing.
	var n int = 42
	testing.Println(n) // 42
	var neg int = -5
	testing.Println("neg", neg) // neg -5

	// bool via lang.Stringer.
	var t bool = true
	var f bool = false
	testing.Println(t, f) // true false

	// Managed @[]char operand.
	testing.Println(mkHi()) // hi

	// Mixed string + int + bool in one call.
	var seven int = 7
	testing.Println("x", seven, t) // x 7 true

	// A user-defined Stringer (its satisfaction fact lives only VM-side) — resolves
	// cross-mode via the native-SatLookup-miss -> VM-registry fallback.
	var temp Celsius = cast(Celsius, 20)
	testing.Println("temp", temp) // temp 20C

	// Print omits the trailing newline; a following Print concatenates, and a
	// following Println terminates the line.
	testing.Print("a", "b") // a b   (no newline)
	testing.Println("c")    // -> "a bc"

	// Empty Println is just a newline.
	testing.Println()
}
