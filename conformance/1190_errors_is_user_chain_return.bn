package "main"

import "pkg/std/errors"

// Cross-mode RETURN direction (plan-iface-crossmode.md S3): injected-native
// errors.Is walks a chain of TWO user (bytecode) impls.  wrap.Unwrap() is a
// bytecode method dispatched BY native Is, and it RETURNS ANOTHER user impl
// (leaf) whose interface value carries a VM-index vtable word.  Native Is then
// dispatches THAT returned value's Unwrap on the next loop turn — so the returned
// iface's VM-index vtable word must be substituted for the impl's native handle-
// vtable in the retbuf the trampoline hands back, or native code faults
// dereferencing it (SIGSEGV under the VM before the fix; correct under bnc).
type leaf struct { tag int }

func (e @leaf) Error() @[]readonly char { return "leaf" }

func (e @leaf) Unwrap() @errors.Error { var none @errors.Error; return none }

impl @leaf : errors.Error

type wrap struct { cause @errors.Error }

func (e @wrap) Error() @[]readonly char { return "wrap" }

func (e @wrap) Unwrap() @errors.Error { return e.cause }

impl @wrap : errors.Error

func main() {
	var l @leaf = make(leaf)
	var lv @errors.Error = l
	var w @wrap = make(wrap)
	w.cause = lv
	var wv @errors.Error = w

	// wv -> wv.Unwrap()==lv -> match: Is must classify wv AS lv (its cause).
	// The match happens on the SECOND loop turn, after Unwrap returns the
	// bytecode leaf impl — the return-direction crossing.
	println(errors.Is(wv, lv))

	// wv is not itself lv (distinct boxes), but Is finds lv one hop down.
	println(errors.Is(wv, wv))

	// A fresh, unrelated user impl is never in wv's chain.
	var other @leaf = make(leaf)
	var ov @errors.Error = other
	println(errors.Is(wv, ov))
}
