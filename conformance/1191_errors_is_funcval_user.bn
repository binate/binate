package "main"
import "pkg/builtins/testing"

import "pkg/std/errors"

// Cross-mode SIBLING dispatcher: a NATIVE function
// value (errors.Is taken as a `*func`) is called FROM bytecode with bytecode-impl
// interface arguments.  The call routes through dispatchCompiledFuncValue (not the
// direct-extern dispatchExternBinding), which — like the extern path — must
// substitute each bytecode-impl iface arg's VM-index vtable word for the impl's
// native handle-vtable, or native errors.Is faults dereferencing it (SIGSEGV under
// the VM before the fix; correct under bnc).
type leaf struct { tag int }

func (e @leaf) Error() @[]readonly char { return "leaf" }

func (e @leaf) Unwrap() @errors.Error { var none @errors.Error; return none }

impl @leaf : errors.Error

type wrap struct { cause @errors.Error }

func (e @wrap) Error() @[]readonly char { return "wrap" }

func (e @wrap) Unwrap() @errors.Error { return e.cause }

impl @wrap : errors.Error

func main() {
	var l @leaf = make(leaf)
	var lv @errors.Error = l
	var w @wrap = make(wrap)
	w.cause = lv
	var wv @errors.Error = w

	var isFn *func(@errors.Error, @errors.Error) bool = errors.Is

	// Identity match via the native func value (first same()).
	testing.Println(isFn(lv, lv))
	// Chain match via the native func value: also exercises the return direction
	// (wv.Unwrap() -> lv) through the sibling path.
	testing.Println(isFn(wv, lv))
	// No match: a distinct user impl not in wv's chain.
	var other @leaf = make(leaf)
	var ov @errors.Error = other
	testing.Println(isFn(wv, ov))
}
