package "main"

import "pkg/std/errors"

// Pins the native-vtable interface-METHOD dispatch path
// (dispatchCompiledIfaceMethod): a bytecode program calls methods on an interface
// value returned BY an injected COMPILED package (errors.New / errors.Wrap), whose
// vtable word is a native @__ivt address, so the method runs as native code
// through the shim.  This is the path whose BC_CALL_IFACE_METHOD Imm now also
// carries the cross-mode iface-arg bitmap: the
// user-arg slot count must still decode correctly (ifaceMethodImmSlots) after the
// bitmap was folded into the Imm's high bits.  No stdlib iface method takes an
// iface arg, so the bitmap is 0 here — this guards the decode, not the (embedder-
// only) substitution.
func main() {
	var e @errors.Error = errors.New("boom")
	// e.Error() — a native iface method (no user args) via the shim.
	println(e.Error())

	// A wrapped error: Wrap stores e as the cause; the wrapper's Error() renders
	// the joined message, and its Unwrap() returns the cause — both native iface
	// methods dispatched from bytecode.
	var w @errors.Error = errors.Wrap(e, "outer")
	println(w.Error())
	println(errors.Is(w, e))
}
