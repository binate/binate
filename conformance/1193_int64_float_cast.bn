package "main"

// 64-bit int <-> float casts: int64 / uint64 <-> float32 / float64.  On arm32
// these lower to the AEABI helpers (__aeabi_l2d / d2lz / ul2d / d2ulz / l2f /
// f2lz), and under hard-float (arm32-linux gnueabihf) the float value must be
// marshaled between the VFP register file and the core-register AEABI calling
// convention.  Existing cast tests (282, 732) cover only 32-bit int, so this
// pins 64-bit-width cast VALUE correctness across every backend/mode (notably
// native arm32 hard-float).  Values exceed 2^32 to distinguish the 64-bit path
// from a 32-bit truncation, and stay < 2^53 so they are exact in float64.

func main() {
	// int64 -> float64 -> int64 round-trip (needs > 32 bits).
	var a int64 = 9000000000
	println(cast(int64, cast(float64, a))) // 9000000000

	// negative int64 -> float64 -> int64.
	var b int64 = -5000000000
	println(cast(int64, cast(float64, b))) // -5000000000

	// uint64 -> float64 -> uint64.
	var c uint64 = 12000000000
	println(cast(int64, cast(uint64, cast(float64, c)))) // 12000000000

	// float64 -> int64 truncation toward zero.
	var d float64 = 7500000000.9
	println(cast(int64, d)) // 7500000000

	// int64 -> float32 -> int64 (2^20 is exact in float32).
	var e int64 = 1048576
	println(cast(int64, cast(float32, e))) // 1048576

	// float32 -> int64.
	var g float32 = 300000.0
	println(cast(int64, g)) // 300000
}
