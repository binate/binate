package "main"
import "pkg/builtins/testing"

// Regression: a SHORTER string literal fits a distinct-NAMED char-array target
// (zero-padded), the same as the un-named [N]char form.  The permissive
// zero-pad assignability rule (stringLitInitFitsArray) must peel the named
// wrapper — `type Arr [M]char` — just as AssignableTo's named-distinct
// transparency arm already does for the EXACT-length case (conformance 1170).
// Before the peel, `var a Arr6 = "ab"` was rejected ("cannot assign
// [2]readonly uint8 to Arr6") while the un-named `[6]char` and the exact-length
// named forms both worked.  Covers the var-decl and struct-literal-element
// sites (the two stringLitInitFitsArray callers) across plain / two-level /
// readonly-element named arrays.  Byte 0 reads 'a' (97); byte 5 reads 0 (the
// zero-padded tail).

type Arr6 [6]char
type Arr6b Arr6                 // two-level named chain
type RoArr [6]readonly char     // named readonly-element array

type S struct { f Arr6 }

func main() {
	// var-decl, plain named: "ab" into a [6]char, tail zero-padded.
	var a Arr6 = "ab"
	testing.Println(cast(int, a[0]))
	testing.Println(cast(int, a[5]))

	// var-decl, two-level named chain.
	var b Arr6b = "ab"
	testing.Println(cast(int, b[0]))
	testing.Println(cast(int, b[5]))

	// var-decl, named readonly-element array.
	var r RoArr = "ab"
	testing.Println(cast(int, r[0]))
	testing.Println(cast(int, r[5]))

	// struct-literal element, named char-array field.
	var s S = S{f: "ab"}
	testing.Println(cast(int, s.f[0]))
	testing.Println(cast(int, s.f[5]))
}
