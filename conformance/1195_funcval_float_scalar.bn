package "main"

// Scalar float through func-value CALLS (inc 3f(b1) of plan-native-arm32.md).  A
// float param and a float return travel in VFP registers on BOTH the shim's incoming
// ABI (data word in R0, floats in s0../d0..) and the underlying's ABI, so they pass
// through the func-value dispatch + shim untouched while the GP marshal shifts only
// the GP words down past the dropped data word.  Under native arm32 hard-float
// (arm-linux-gnueabihf) this pins that a scalar float rides VFP, not a GP register;
// on every other backend/mode it is the ordinary func-value path.  `mix` interleaves
// int and float args (GP and VFP advance independently) to exercise the GP down-shift
// coexisting with the VFP pass-through.

func dbl(x float64) float64 {
	return x + x
}

func addf(a float32, b float32) float32 {
	return a + b
}

func mix(n int, x float64, m int) float64 {
	return x + cast(float64, n + m)
}

func main() {
	var fp *func(float64) float64 = dbl
	println(cast(int, fp(21.0))) // 42

	var gp *func(float32, float32) float32 = addf
	println(cast(int, gp(1.5, 2.5))) // 4

	var hp *func(int, float64, int) float64 = mix
	println(cast(int, hp(10, 2.5, 5))) // 17
}
