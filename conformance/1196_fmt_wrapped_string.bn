package "main"

import "pkg/stdx/fmt"

// Regression: fmt renders a NAMED char-slice and a `readonly`-qualified char-slice
// (the os.Args()/os.Env() element type `readonly @[]readonly char`) as their text,
// not `%!?(unknown)`.  writeArg's fast type switch matches only the four unqualified
// spellings; the wrapped/qualified forms are recovered via reflection (their dynamic
// type peels to KIND_STRING).  Covers Print, %s, and %v.

type NamedStr @[]char

// roStr returns a value whose static (and thus boxed dynamic) type is exactly the
// os.Args() element type: `readonly @[]readonly char`.
func roStr() readonly @[]readonly char {
	var m @[]char = @[]char{'h', 'i'}
	return m
}

func main() {
	var ns NamedStr = cast(NamedStr, @[]char{'h', 'i'})
	fmt.Println(ns)                  // hi
	fmt.Printf("[%s][%v]\n", ns, ns) // [hi][hi]

	var ro readonly @[]readonly char = roStr()
	fmt.Printf("[%s][%v]\n", ro, ro) // [hi][hi]
}
