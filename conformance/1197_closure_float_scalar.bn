package "main"

// Scalar float through a CAPTURING closure (inc 3f(b1b) of plan-native-arm32.md).
// An int capture rides GP (loaded from the closure data block into a leading GP
// register) while a scalar float param/return rides VFP — the closure shim's GP
// marshal skips the float (it passes through untouched to the underlying, which reads
// it from the same VFP register because non-float captures don't consume VFP slots).
// Under native arm32 hard-float this pins the closure-shim scalar-float path; on every
// other backend/mode it is the ordinary capturing-closure path.  A float CAPTURE is
// inc 3f(b4) (still fail-loud); these closures capture ints.

func main() {
	var k int = 3
	var addk *func(float64) float64 = func(x float64) float64 {
		return x + cast(float64, k)
	}
	println(cast(int, addk(2.5))) // 5   (2.5 + 3.0 = 5.5 -> 5)

	var m int = 100
	var scale *func(float32, float32) float32 = func(a float32, b float32) float32 {
		return a + b + cast(float32, m)
	}
	println(cast(int, scale(1.5, 2.5))) // 104 (1.5 + 2.5 + 100.0 = 104.0)
}
