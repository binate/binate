package "main"

import "pkg/builtins/testing"

// Regression: boxing the dereference of a NAMED-distinct pointer (`type P *int`)
// into a variadic `...*any` (testing.Println) must box the DEREFERENCED VALUE,
// not the pointer address.  The implicit value-borrow (gen_util.bn) boxes an
// addressable value source by reference: it takes the operand's address via
// genLValueAddr (`&*p == p`) and classifies "addressable" with a pointer-kind
// test that must PEEL the named wrapper — a `type P *int` is TYP_NAMED, not
// TYP_POINTER.  Without the peel the pointer value is stored into a plain value
// slot and the box captures the ADDRESS, so `testing.Println(*p)` prints a raw
// address instead of the value.  A plain (non-named) `*int` deref is the control;
// both are checked here as an A/B, plus a non-int pointee (the pointee type must
// not default to int) and a two-level named-over-named pointer (peel both).

type P *int
type PB *bool
type PP P

func main() {
	var x int = 5
	var p P = &x
	testing.Println(*p) // 5   (named pointer deref — needs the peel)
	*p = 9
	testing.Println(*p) // 9   (write-through, then boxed read)

	var q *int = &x
	testing.Println(*q) // 9   (plain pointer deref — A/B control)

	var b bool = true
	var pb PB = &b
	testing.Println(*pb) // true  (non-int pointee; not defaulted to int)

	var pp PP = &x
	testing.Println(*pp) // 9   (two-level named-over-named pointer)
}
