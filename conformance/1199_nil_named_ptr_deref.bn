package "main"

import "pkg/builtins/testing"

type P *int

// Dereference a nil NAMED pointer through testing.Println's `...*any`
// value-borrow.  genBorrowSourceAddr's deref arm must nil-check the pointer
// (`&*p == p`, and the box dereferences it), so a nil base raises a recoverable
// VM fault under --check-nil rather than boxing a nil address that is read
// later without a check.  This is the deref sibling of 1142's field-access case.
// Compiled backends have no --check-nil, so a nil deref is a bare load -> SEGV;
// every compiled mode is xfail'd.
func main() {
	var p P = nil
	testing.Println(*p)
}
