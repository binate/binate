package "main"

import "pkg/builtins/testing"

// Anonymous struct as a struct field type.

type Wrapper struct {
	Inner struct { X int; Y int }
	Tag   int
}

func main() {
	var w @Wrapper = make(Wrapper)
	w.Inner.X = 10
	w.Inner.Y = 20
	w.Tag = 99
	testing.Println(w.Inner.X)
	testing.Println(w.Inner.Y)
	testing.Println(w.Tag)
}
