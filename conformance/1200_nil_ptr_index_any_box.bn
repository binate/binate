package "main"

import "pkg/builtins/testing"

// Index a nil RAW pointer through testing.Println's `...*any` value-borrow.
// genBorrowSourceAddr's index arm computes the element address with
// forDeref=true, so genIndexPtr nil-checks the raw-pointer base (`ptr[i]` =
// *(ptr+i)) — a nil base raises a recoverable VM fault under --check-nil rather
// than boxing a wild element address read later without a check.  The index
// sibling of 1199 (deref) / 1142 (field).  Compiled backends have no --check-nil,
// so a nil index is a bare load -> SEGV; every compiled mode is xfail'd.
func main() {
	var p *int = nil
	testing.Println(p[0])
}
