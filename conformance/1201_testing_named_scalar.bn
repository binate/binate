package "main"

import "pkg/builtins/testing"

// testing.Print/Println of a NAMED non-struct scalar (`type Celsius int`, …)
// formats it by its UNDERLYING kind.  A named type has an empty method set, so
// it satisfies neither the char-slice cases nor lang.Stringer (it does not
// inherit the underlying's String()); writeArg's reflect-kind fallback reads the
// value at its width and formats via the universe type's String().  Covers
// int/uint/bool/float across widths, including a narrow signed (int8) and a
// high-bit-set unsigned (uint64).

type Celsius int
type Small int8
type Flag bool
type Byte uint8
type Wide uint64
type Ratio float64

func main() {
	var c Celsius = 100
	var s Small = 0 - 5
	var f Flag = true
	var b Byte = 200
	var w Wide = 18446744073709551615
	var r Ratio = 2.5
	testing.Println(c)
	testing.Println(s)
	testing.Println(f)
	testing.Println(b)
	testing.Println(w)
	testing.Println(r)
}
