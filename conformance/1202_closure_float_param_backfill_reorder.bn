package "main"

import "pkg/builtins/testing"

// A capturing closure with a float32 CAPTURE and MIXED-WIDTH (float64, float32) PARAMS.  On
// native arm32 hard-float (AAPCS-VFP) the underlying places the float capture in the leading
// VFP slot, so the float params up-shift — and back-fill makes the float32 param DROP into the
// odd hole the float64 param's even-alignment left (incoming a=d0{s0,s1}, b=s2 -> outgoing
// c=s0, a=d1{s2,s3}, b=s1): the float32 b moves DOWN while the float64 a moves UP into its old
// pair — a 2-cycle the shim's VFP param up-shift must resolve as a real (memory-staged) parallel
// move, not a single-order VMOV shift.  Distinct 100/10/1 weights so a mis-marshalled param
// changes the result.  (On x64/aa64/soft-float the same closure rides the SSE/GP path normally;
// the printed value is the portable check across all conformance modes.)
func makeMix(c float32) @func(float64, float32) float64 {
	return func(a float64, b float32) float64 {
		return a * 100.0 + cast(float64, b) * 10.0 + cast(float64, c)
	}
}

func main() {
	var g @func(float64, float32) float64 = makeMix(3.0)
	var r float64 = g(2.0, 5.0)
	testing.Println(cast(int, r)) // 2*100 + 5*10 + 3 = 253
}
