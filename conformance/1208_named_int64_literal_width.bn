package "main"

import "pkg/builtins/testing"

// A named 64-bit integer initialized from a literal whose value needs more than
// `int` bits (i32 on a 32-bit target) must keep its full width.  This pins the
// arm32 (ILP32) miscompile where an untyped literal assigned to a NAMED integer
// was materialized at the default `int` width and widened only afterward (LLVM
// `add i32 <v>, 0` then `zext i32 to i64`), dropping the high word — so
// `var w Wide = <big>` read back only its low 32 bits.  A plainly-typed target
// (`uint64` / `int64`) was unaffected, so each named value is compared against
// the SAME literal given the non-named type: a truncated named value compares
// unequal.  The high word is also printed via the uint32 path (itself unaffected
// by the bug) so a regression is legible rather than just a bare `false`.  This
// exercises the defect directly, without the testing/reflect formatting path
// that 1201_testing_named_scalar routes through.

type Wide uint64
type Signed int64

func main() {
	var a Wide = 18446744073709551615
	var aRef uint64 = 18446744073709551615
	testing.Println(cast(uint64, a) == aRef)
	testing.Println(cast(uint32, cast(uint64, a) >> 32))

	var b Wide = 4294967296
	var bRef uint64 = 4294967296
	testing.Println(cast(uint64, b) == bRef)
	testing.Println(cast(uint32, cast(uint64, b) >> 32))

	var c Signed = 5000000000
	var cRef int64 = 5000000000
	testing.Println(cast(int64, c) == cRef)
	testing.Println(cast(uint32, cast(uint64, c) >> 32))
}
