package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Reclamation regression for the reclaiming Raw allocator (bare metal:
// rt_baremetal.bn's SFL segregated free-lists; hosted: libc).  Each iteration
// allocates a block, touches both ends, and frees it, so PEAK-LIVE is a single
// block while CUMULATIVE allocation is ~8 MiB per loop — far past the 4 MiB
// bare-metal arena.  A NON-reclaiming allocator (the old bump heap) can only
// carve, so it exhausts the arena and aborts partway (no "42" is printed); a
// reclaiming allocator survives because its bound is peak-live, not cumulative
// — the freed block is popped straight back off the free list next iteration,
// and the carve frontier barely moves.  On hosted / native-libc modes this is
// a trivially-fine malloc/free loop; the bare-metal mode is where it bites.
//
// Two loops cover both size regimes of the segregated bare-metal allocator:
// large (payload > SMALL_MAX -> the single first-fit list) and small (payload
// <= SMALL_MAX -> the per-class LIFO list).  Touching both the first and last
// byte catches a prefix/size-class error that handed back an under-sized or
// misaligned block (which would data-abort rather than survive).
func main() {
	// Large regime: 2000 * 4096 B = 8 MiB cumulative, peak-live one 4096 B block.
	for i := 0; i < 2000; i++ {
		var p *uint8 = rt.Alloc(4096)
		p[0] = cast(uint8, i)
		p[4095] = cast(uint8, i)
		rt.Free(p)
	}
	// Small regime: 8000 * 1024 B = 8 MiB cumulative, peak-live one 1024 B block.
	for i := 0; i < 8000; i++ {
		var p *uint8 = rt.Alloc(1024)
		p[0] = cast(uint8, i)
		p[1023] = cast(uint8, i)
		rt.Free(p)
	}
	testing.Println(42)
}
