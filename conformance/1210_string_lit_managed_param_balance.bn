package "main"

import "pkg/builtins/testing"

// A string literal coerced to a mutable @[]char parameter materializes a FRESH
// owned copy (refcount 1) at the call site — the callee only borrows it for the
// duration of the call, so after the statement the copy is a leftover temp that
// must be RefDec'd.  If the call-site coercion fails to register that copy for
// end-of-statement cleanup, every such call leaks one allocation.  (The
// @[]readonly char / *[]readonly char coercions instead alias the immortal
// static rodata and allocate nothing, so they never leak.)
//
// Without the cleanup registration LiveBlocks climbed by one per iteration; with
// it the live-block count returns to baseline.

import "pkg/builtins/rt"

func takesManaged(s @[]char) int {
	return len(s)
}

func main() {
	// One warm-up call so any first-touch bookkeeping settles before the
	// baseline is captured; the loop delta is then purely the per-call copies.
	takesManaged("hello")
	var base int = rt.LiveBlocks()

	// Consume the result so the call can never be treated as dead — the copy
	// must be allocated (and then released) on every iteration.
	var total int = 0
	for i := 0; i < 100; i++ {
		total = total + takesManaged("hello")
	}

	// Each iteration's literal -> @[]char copy is released at end of statement,
	// so the count returns to baseline rather than climbing by 100.
	testing.Println(rt.LiveBlocks() - base) // 0 iff every copy was released
	testing.Println(total)                  // 500 == len("hello") * 100
}
