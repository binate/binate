package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Binding a string literal to a MANAGED @[]char allocates a fresh owning copy
// (OP_RODATA_MSLICE_COPY).  Complements 1210 (which covers the CALL-ARGUMENT
// site) by exercising the STORE, RETURN, and PARALLEL-ASSIGN sites: a mutable
// var-decl, a composite element, a short-var, `return "..."`, and a multi-target
// assign `a, b = "...", "..."`.  Each must leave the copy owned exactly once so
// it is freed when its owner is released; otherwise it leaks one heap block per
// execution.  Asserts rt.LiveBlocks() returns to its pre-loop baseline.
//
// Regression: the store sites leaked until isFreshManagedSlice recognized
// OP_RODATA_MSLICE_COPY (so emitStoreManagedSlot MOVES the fresh copy instead of
// RefInc'ing a borrow); `return "..."` leaked until the copy was registered as a
// cleanup temp to balance the return's unconditional Axiom-3 RefInc; and
// parallel assign leaked until the copy was likewise registered to balance
// resolveParallelEntry's unconditional per-target RefInc.

func viaVarDecl() int {
	var s @[]char = "ab"
	return len(s)
}

func viaReturn() @[]char {
	return "cd"
}

func viaComposite() int {
	var a @[]@[]char = @[]@[]char{"ef", "gh"}
	return len(a)
}

func viaShortVar() int {
	s := viaReturn()
	return len(s)
}

func viaParallelAssign() int {
	var a @[]char = "aa"
	var b @[]char = "bb"
	a, b = "cc", "dd"
	return len(a) + len(b)
}

func exercise() {
	_ = viaVarDecl()
	var r @[]char = viaReturn()
	_ = len(r)
	_ = viaComposite()
	_ = viaShortVar()
	_ = viaParallelAssign()
}

func main() {
	exercise() // absorb any one-time allocations before measuring
	var before int = rt.LiveBlocks()
	for i := 0; i < 100; i = i + 1 {
		exercise()
	}
	// 0 iff every string-literal managed copy is freed by its owner's release.
	testing.Println(rt.LiveBlocks() - before)
}
