package "main"

import "pkg/builtins/testing"
import "pkg/mp"

// A method EXPRESSION off a CROSS-PACKAGE generic instantiation:
// `mp.Box[int].Get` — the selector head is a package-qualified generic type
// (EXPR_SELECTOR `mp.Box`), so it exercises the cross-package resolution path
// (declPkg / homedQualifier) that the in-package `Box[int].Get` cells do not.
// The func value must link to the same monomorphized `mp.Box[int].Get` symbol a
// bound `bx.Get` / a direct call would use.
func main() {
	var bx mp.Box[int]
	bx.val = 42
	var f *func(*mp.Box[int]) int = mp.Box[int].Get
	testing.Println(f(&bx))

	// DIRECT invocation of the cross-package method expression (the method expr
	// is the call callee) — exercises the declPkg / homedQualifier direct-call
	// path the func-value form above does not.
	var by mp.Box[int]
	by.val = 99
	testing.Println(mp.Box[int].Get(&by))
}
