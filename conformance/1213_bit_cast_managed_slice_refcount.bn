package "main"
import "pkg/builtins/testing"
import "pkg/builtins/rt"

// A managed-slice bit_cast takes NO reference itself (spec §8.6), but BINDING its
// result to an owning local is an ordinary managed copy: the copy-RefInc at the
// binding and the RefDec at scope end balance, so the backing's refcount returns
// to baseline (no leak, no double-free).  Viewing the managed-slice header as a
// raw struct reaches the backing pointer without taking a reference (the struct
// is unmanaged, so it is never RefDec'd).

type SliceView struct {
	data       *uint8
	length     int
	backing    *uint8
	backingLen int
}

func main() {
	var m @[]int = make_slice(int, 4) // backing refcount 1 (m owns it)

	// Reinterpret m's 4-word header as a raw struct to reach the backing pointer.
	var v SliceView = bit_cast(SliceView, m)
	testing.Println(rt.Refcount(v.backing)) // 1: only m

	// bit_cast m to a different managed-slice type, bound to an owning local in an
	// inner scope: the binding co-owns via a copy-RefInc.
	{
		var s @[]uint = bit_cast(@[]uint, m)
		testing.Println(rt.Refcount(v.backing)) // 2: m + s
		testing.Println(len(s))                 // 4
	}
	// s released at block end — the backing refcount is back to baseline.
	testing.Println(rt.Refcount(v.backing)) // 1: only m again
	testing.Println(len(m))                 // 4: m intact
}
