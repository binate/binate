package "main"
import "pkg/builtins/testing"

// A same-size bit_cast round-trips an INTERFACE VALUE through its explicit 2-word
// {data, vtable} form: reinterpreting an @any as a two-pointer struct and back
// preserves both words, so the reconstructed interface value still type-asserts
// correctly.  The struct form is unmanaged and bit_cast takes no reference;
// binding the reconstructed @any co-owns via the ordinary copy-RefInc, so the
// boxed value's refcount balances (no leak, no double-free — the program would
// abort or corrupt otherwise).

type IfaceWords struct {
	data   *uint8
	vtable *uint8
}

func main() {
	var x @any = box(42)                       // @any wrapping a boxed int
	var w IfaceWords = bit_cast(IfaceWords, x) // view the {data, vtable} words
	var y @any = bit_cast(@any, w)             // reconstruct the interface value
	var n int = y.(int)                        // recover the concrete int
	testing.Println(n)                         // 42
}
