package "main"
import "pkg/builtins/testing"
import "pkg/builtins/rt"

// unsafe_cast performs UNCHECKED interface narrowing: it extracts the interface
// value's data word WITHOUT a runtime type check (unlike `x.(@T)`) and takes NO
// reference of its own.  Binding the recovered @T to an owning local co-owns via
// the binding's ordinary copy-RefInc, so the boxed object's refcount rises while
// the extra owners live and returns to baseline at scope end (no leak / double
// free — the program would abort or corrupt otherwise).

type Box struct { v int }

func main() {
	var b @Box = make(Box)
	b.v = 42
	var raw *uint8 = bit_cast(*uint8, b)
	testing.Println(rt.Refcount(raw)) // 1: only b

	var iv @any = b                    // widen to @any (implicit): iv co-owns
	testing.Println(rt.Refcount(raw)) // 2: b + iv

	// UNCHECKED narrowing: recover @Box from @any with no type check.  The bound
	// local co-owns (copy-RefInc), so the count rises to 3.
	var rec @Box = unsafe_cast(@Box, iv)
	testing.Println(rt.Refcount(raw)) // 3: b + iv + rec
	testing.Println(rec.v)            // 42: the correct object was recovered
}
