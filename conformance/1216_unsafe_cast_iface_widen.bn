package "main"
import "pkg/builtins/testing"

// unsafe_cast WIDENS a concrete managed pointer to a managed interface value: it
// constructs the {data, vtable} pair (resolving the (Mgd, I) impl vtable) and
// takes a reference for the managed target — the safe conversion `cast` performs.
// The resulting interface value dispatches correctly.

interface I { id() int }

type Mgd struct { v int }

func (m @Mgd) id() int { return m.v }

impl @Mgd : I

func main() {
	var m @Mgd = make(Mgd)
	m.v = 7
	var iv @I = unsafe_cast(@I, m)
	testing.Println(iv.id()) // 7: dispatch through the constructed vtable
}
