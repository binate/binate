package "main"
import "pkg/builtins/testing"

// unsafe_cast between interface values is rejected by the checker for CONCRETE
// types, but a generic `unsafe_cast(B, x)` whose A and B both instantiate to
// interface values escapes the definition-time check (abstract type parameters)
// and reaches codegen.  An IR-gen guard (gen_builtin.bn's UNSAFE_CAST arm,
// mirroring the CAST arm's) FAILS LOUD rather than emit an OP_CAST that
// mis-declares the 2-word interface value as a 1-word pointer.  Recover a
// narrower interface with a type assertion `x.(I)` instead.

interface I { m() int }

type T struct { v int }

func (t @T) m() int { return t.v }

impl @T : I

func conv[A any, B any](x A) B {
	return unsafe_cast(B, x)
}

func main() {
	var t @T = make(T)
	var a @any = t
	var i @I = conv[@any, @I](a)
	_ = i
	testing.Println(1)
}
