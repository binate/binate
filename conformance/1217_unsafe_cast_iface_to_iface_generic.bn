package "main"
import "pkg/builtins/testing"

// unsafe_cast does not recover a narrower interface from an interface value —
// also when a generic `unsafe_cast(B, x)` has A and B instantiated to interface
// values (here `@any` to `@I`): the instance's check (gen.mono.check) rejects it,
// as for concrete types.  Recover it with a type assertion `x.(I)` instead.

interface I { m() int }

type T struct { v int }

func (t @T) m() int { return t.v }

impl @T : I

func conv[A any, B any](x A) B {
	return unsafe_cast(B, x)
}

func main() {
	var t @T = make(T)
	var a @any = t
	var i @I = conv[@any, @I](a)
	_ = i
	testing.Println(1)
}
