package "main"
import "pkg/builtins/testing"

// The gated `cast` WIDENS a concrete managed pointer to a managed interface value
// (assignability case 7 — interface satisfaction): it constructs the {data,
// vtable} pair and takes a reference, and the result dispatches correctly.  This
// is the newly-accepted direction; interface NARROWING (cast FROM an interface
// value) stays rejected -> unsafe_cast / a type assertion.

interface I { id() int }

type Mgd struct { v int }

func (m @Mgd) id() int { return m.v }

impl @Mgd : I

func main() {
	var m @Mgd = make(Mgd)
	m.v = 7
	var iv @I = cast(@I, m)
	testing.Println(iv.id()) // 7: dispatch through the constructed vtable
}
