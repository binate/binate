package "main"

import "pkg/builtins/testing"

// The gated `cast` handles interface UPCAST (an interface value -> a super-
// interface / @any): a sub-interface value widens via OP_IFACE_UPCAST (vtable
// substitution) and the result still recovers + dispatches.  This is the
// iface-SOURCE widening direction, distinct from concrete -> iface (1218).

interface Animal {
	sound() int
}

type Dog struct { n int }

func (d @Dog) sound() int { return d.n }

impl @Dog : Animal

func main() {
	var d @Dog = make(Dog)
	d.n = 5
	var a @Animal = d // concrete -> @Animal (assignment)
	var any_ @any = cast(@any, a) // interface UPCAST: @Animal -> @any via cast
	var back @Animal = any_.(@Animal)
	testing.Println(back.sound()) // 5
}
