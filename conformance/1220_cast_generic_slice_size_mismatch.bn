package "main"

import "pkg/builtins/testing"

// A generic `cast(T, x)` is checked for each instantiation (gen.mono.check).
// Instantiated so that a same-kind slice retype changes the ELEMENT SIZE
// (@[]int8 -> @[]int64), the whole-slice relabel would keep `len` (the element
// count) while each element grew, reading past the backing: the instance's
// check rejects the cast.

func conv[T any](x @[]int8) T {
	return cast(T, x)
}

func main() {
	var s @[]int64 = conv[@[]int64](make_slice(int8, 2))
	_ = s
	testing.Println(1)
}
