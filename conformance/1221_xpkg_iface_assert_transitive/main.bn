package "main"

import "pkg/base"
import "pkg/builtins/testing"
import "pkg/mid"

// A TRANSITIVE cross-package interface assertion.  main imports mid (and base for
// the interface names) but NOT leaf.  mid.Make returns a base.J whose dynamic
// type is leaf.T, and leaf owns the (leaf.T, base.K) satentry.  Asserting
// j.(@base.K) must HIT — which requires the decentralized satentry-graph walk
// (rt.BuildSatRegistry over `_pkg_satfrag`) to reach pkg/leaf via the
// main -> mid -> leaf import-edge chain, since leaf is not a direct import of
// main.  A broken transitive walk would MISS: the expression-form assertion would
// panic, and the comma-ok form would print -1.
func main() {
	var j @base.J = mid.Make(21)
	testing.Println(j.j())

	var kv @base.K = j.(@base.K)
	testing.Println(kv.k())

	kv2, ok := j.(@base.K)
	if ok {
		testing.Println(kv2.k())
	} else {
		testing.Println(-1)
	}
}
