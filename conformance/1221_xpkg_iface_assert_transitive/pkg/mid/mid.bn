package "pkg/mid"

import "pkg/base"
import "pkg/leaf"

// Make boxes a leaf.T (whose impls of base.J / base.K live in pkg/leaf) into a
// base.J.  pkg/leaf is imported HERE, not by main — so the (leaf.T, base.K)
// satentry pkg/leaf emits is reachable in the `_pkg_satfrag` graph only via the
// main -> mid -> leaf import-edge chain.
func Make(v int) @base.J {
	var t @leaf.T = make(leaf.T)
	t.v = v
	var j @base.J = t
	return j
}
