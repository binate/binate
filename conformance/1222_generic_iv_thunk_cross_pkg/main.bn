package "main"

import "pkg/a"
import "pkg/b"
import "pkg/builtins/testing"

// Regression: a value-receiver impl on a GENERIC type (here the stdlib
// hash.FnHasher[K] / cmp.FnEq[K] that mapfn.MapFn injects) is monomorphized —
// and its iv-dispatch thunk (`__bn_thunk_*`) emitted — in EVERY package that
// instantiates it for the same type args.  pkg/a and pkg/b both build a
// mapfn.MapFn[int, int], so both emit hash.FnHasher[int].__bn_thunk_Hash and
// cmp.FnEq[int].__bn_thunk_Equal.  Linking main + a + b must NOT hit a duplicate
// symbol: genIvRecvThunk marks the thunks weak_odr (IsLinkOnce), so the linker
// merges the identical monomorphizations.  Before that fix this failed to link.
func main() {
	testing.Println(a.Count() + b.Count())
}
