package "main"

import "pkg/builtins/testing"

// float64 multiply/divide must be computed at runtime by the backend's helpers
// (on soft-float targets, __aeabi_dmul / __aeabi_ddiv), not const-folded.  The
// operands are locals (not constant expressions like `1.5 * 7.0`, which the
// checker folds), so the ops are actually emitted; each result is pinned
// bit-exactly via bit_cast(int64, ...) (valid on ILP32, unlike bit_cast(int,
// ...)).  Companion to 635 (float32 arithmetic).
func main() {
	var a float64 = 1.5
	var b float64 = 7.0
	testing.Println(bit_cast(int64, a * b)) // 10.5
	testing.Println(bit_cast(int64, b / a)) // 4.666...
	var one float64 = 1.0
	var three float64 = 3.0
	testing.Println(bit_cast(int64, one / three)) // 0.333...
	var c float64 = 1000000000.0
	testing.Println(bit_cast(int64, c * c)) // 1e18
	var d float64 = 2.0
	testing.Println(bit_cast(int64, d / three)) // 0.666...
	var na float64 = -1.5
	testing.Println(bit_cast(int64, na * b)) // -10.5
}
