package "main"

import "pkg/std/fmt"

// cast(float64, <int expr>) must fold to the same value regardless of the operand's
// FORM.  A binary (or untyped-const-reference) integer expression that folds to a
// NEGATIVE value used to mis-fold: the const-fold materialized the folded untyped-int
// with Signed=false, so int->float picked uitofp and read the negative value as a
// huge unsigned float — cast(float64, -2147483647 - 1) came out ~+1.8e19 (its
// cast(int) saturates to INT64_MAX) instead of -2147483648.0.  A single negative
// literal (-2147483648) was unaffected because it lowers through OP_NEG, which forces
// a signed result type.  gen_binary / gen_const now materialize a negative untyped-int
// constant at a signed type.

const UN = 0 - 5 // untyped negative const-expression
const UNL = -5   // untyped negative literal const

const (
	GRP_A = 0 - 5             // untyped negative group member
	GRP_B = -2147483647 - 1   // same value via a group binary expr
)

func main() {
	// Observe via cast(int, ...): the round-trip is exact when correct, and a
	// mis-folded unsigned float saturates to INT64_MAX when wrong.
	fmt.Print(cast(int, cast(float64, -2147483648)), "\n")              // -2147483648 (unary literal)
	fmt.Print(cast(int, cast(float64, -2147483647 - 1)), "\n")          // -2147483648 (binary, same value)
	fmt.Print(cast(int, cast(float64, -1000000000 - 1000000000)), "\n") // -2000000000
	fmt.Print(cast(int, cast(float64, 0 - 5)), "\n")                    // -5
	fmt.Print(cast(int, cast(float64, 0 - 3 * 7)), "\n")                // -21
	fmt.Print(cast(int, cast(float64, UN)), "\n")                       // -5 (untyped const-expr ref)
	fmt.Print(cast(int, cast(float64, UNL)), "\n")                      // -5 (untyped neg-literal ref)
	fmt.Print(cast(int, cast(float64, GRP_A)), "\n")                   // -5 (untyped group member)
	fmt.Print(cast(int, cast(float64, GRP_B)), "\n")                   // -2147483648 (group binary)
	fmt.Print(cast(int, cast(float64, 100 - 40)), "\n")                 // 60 (positive binary)
	fmt.Print(cast(int, cast(float64, 1000000000 + 1000000000)), "\n")  // 2000000000 (positive > int32)
}
