package "main"

import "pkg/builtins/testing"

// float64 comparisons must be computed at runtime by the backend's helpers (on
// soft-float targets, __aeabi_dcmp{eq,lt,le,gt,ge}), not const-folded.  The
// operands are locals (and a runtime-built NaN via z/z, which also isn't
// folded), so the compares are actually emitted.  A NEGATIVE operand exposes a
// naive-bit-compare bug (its sign bit flips the signed-integer order), and NaN
// exercises the unordered path.  Companion to 639 (float32) and 281 (the
// const-folded version).
func b2i(b bool) int {
	if b {
		return 1
	}
	return 0
}

func main() {
	var neg float64 = -1.5
	var pos float64 = 2.5
	testing.Println(b2i(neg < pos)) // 1
	testing.Println(b2i(pos < neg)) // 0
	testing.Println(b2i(neg == neg)) // 1
	testing.Println(b2i(neg != pos)) // 1
	testing.Println(b2i(neg <= pos)) // 1
	testing.Println(b2i(pos >= neg)) // 1
	testing.Println(b2i(neg > pos)) // 0
	var z float64 = 0.0
	var nan float64 = z / z
	testing.Println(b2i(nan != nan)) // 1  (unordered)
	testing.Println(b2i(nan == nan)) // 0
	testing.Println(b2i(nan < pos)) // 0
	testing.Println(b2i(nan >= pos)) // 0
}
