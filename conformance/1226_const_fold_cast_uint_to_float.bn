package "main"

import "pkg/std/fmt"

// A non-negative INTEGER constant >= 2^63 cast to float64 must convert as its
// TRUE (unsigned) magnitude -- a large POSITIVE float -- NOT the negative value
// of its int64 bit pattern.  Such a value only fits uint64, so it reaches a float
// cast solely in CONSTANT form; every producer (raw literal, binary fold, named
// const, grouped member, const-to-const ref, and the ILP32 oversized-const fold)
// must stamp it UNSIGNED so int->float picks uitofp / BC_UITOF on every backend.
//
// Two root causes: (1) the checker's attachConstLitVal derived a const's sign
// from its int64 BIT PATTERN, mis-signing a >= 2^63 magnitude as negative (which
// also corrupted const arithmetic such as `UT / 2`); (2) the IR const producers
// stamped a signed type, so int->float sitofp'd the value to a huge NEGATIVE
// float.  This is the unsigned SIBLING of 1224 (the negative direction).
//
// Observed via a float comparison: cast(int, cast(float64, ...)) can't be used
// here because the correct ~1.8e19 doesn't fit int64, so the outer cast(int) is
// rejected by checkCastConstFits.

const U64  uint64 = 18446744073709551615 // typed-unsigned control (always worked)
const UT   = 18446744073709551615        // untyped 2^64-1
const UT63 = 9223372036854775808         // untyped 2^63
const BIN  = 9223372036854775807 + 1     // untyped binary -> 2^63
const REF  = UT                          // const-to-const reference

const (
	G0 = 9223372036854775808     // grouped 2^63
	G1 = 18446744073709551615    // grouped 2^64-1
	G2 = 9223372036854775807 + 1 // grouped binary -> 2^63
)

func main() {
	fmt.Print(cast(float64, U64)  > 1.0e19, "\n") // true
	fmt.Print(cast(float64, UT)   > 1.0e19, "\n") // true
	fmt.Print(cast(float64, UT63) > 0.0, "\n")    // true
	fmt.Print(cast(float64, BIN)  > 0.0, "\n")    // true
	fmt.Print(cast(float64, REF)  > 1.0e19, "\n") // true
	fmt.Print(cast(float64, G0)   > 0.0, "\n")    // true
	fmt.Print(cast(float64, G1)   > 1.0e19, "\n") // true
	fmt.Print(cast(float64, G2)   > 0.0, "\n")    // true
	fmt.Print(cast(float64, 18446744073709551615) > 1.0e19, "\n") // true (raw literal)
	fmt.Print(cast(float64, 9223372036854775807 + 1) > 0.0, "\n") // true (raw binary)
	fmt.Print(cast(float64, UT / 2) > 9.0e18, "\n")               // true (const arithmetic)
	fmt.Print(cast(int, cast(float64, 0 - 5)), "\n")              // -5 (negative-dir control)
}
