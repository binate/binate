package "main"

import "pkg/std/fmt"
import "pkg/bignums"

// Cross-package sibling of 1226: a NON-NEGATIVE integer constant >= 2^63 imported
// from another package (via its .bni) must convert to float64 UNSIGNED, and a
// NEGATIVE imported untyped const must convert SIGNED, on EVERY backend.  The
// imported-const producers (gen_import / gen_register_import / gen_import_const)
// left an untyped high-bit-set const's IR type nil -> TypUntypedInt, which LLVM
// (isUnsigned = !Signed) reads as unsigned and the VM/native predicate
// (Kind==TYP_INT && !Signed) reads as signed -- a backend divergence in BOTH
// directions.  Now stamped a concrete type (TypUint64 for >= 2^63, TypInt/TypInt64
// for negatives) like the in-package producers.  A TYPED uint64 import was always
// correct (its mc.Typ comes from the .bni type).
//
// The >= 2^63 lines use a float comparison (their correct ~1.8e19 doesn't fit
// int64, so cast(int, ...) is rejected by checkCastConstFits); the negative lines
// fit int64, so cast(int, cast(float64, ...)) round-trips exactly.

func main() {
	fmt.Print(cast(float64, bignums.UT_BIG)  > 1.0e19, "\n") // true
	fmt.Print(cast(float64, bignums.UT_2P63) > 0.0, "\n")    // true
	fmt.Print(cast(float64, bignums.UT_BIN)  > 0.0, "\n")    // true
	fmt.Print(cast(float64, bignums.U64_BIG) > 1.0e19, "\n") // true
	fmt.Print(cast(float64, bignums.GRP1)    > 1.0e19, "\n") // true
	fmt.Print(cast(int, cast(float64, bignums.UT_NEG)), "\n")     // -5
	fmt.Print(cast(int, cast(float64, bignums.UT_NEG_BIG)), "\n") // -5000000000
	fmt.Print(cast(int, cast(float64, bignums.GNEG)), "\n")       // -8000000000
}
