package "main"

import "pkg/builtins/testing"

// A method of a generic type (`add`) that is called from TWO sibling methods
// (`AddA`, `AddB`) AND itself calls another method of the same generic type
// (`bump`).  While `add`'s body is being generated, the re-entrant chain
// add -> AddA/AddB -> add reaches `add` before its body is done, and the call must
// resolve to the local definition: a monomorphizer that sees no FuncSig for `add`
// there and takes the transitive-extern call fallback declares `add` extern even
// though this module also DEFINES it — leaving the LLVM module with both a
// `declare` and a `define` for the symbol ("invalid redefinition", clang fails).

type Acc[T any] struct {
	v T
}

func (a @Acc[T]) bump(x T) {
	a.v = x
}

func (a @Acc[T]) add(x T) {
	a.bump(x)
}

func (a @Acc[T]) AddA(x T) {
	a.add(x)
}

func (a @Acc[T]) AddB(x T) {
	a.add(x)
}

func main() {
	var a @Acc[int] = make(Acc[int])
	a.AddA(10)
	a.AddB(20)
	testing.Println(a.v)
}
