package "main"

import "pkg/builtins/testing"

// Regression for a refcount double-free from NESTED generic-method emission.  A
// generic-receiver method is emitted lazily at a use site; one such emission can
// re-enter and emit a SIBLING method NESTED inside this one's in-progress genFunc.
// Here `store` (emitted first) calls sibling `grow`, whose emission re-triggers the
// method walk and emits `Put` NESTED; `Put`'s body then calls `store`, whose
// FuncSig was (before the fix) not yet registered — so IR-gen saw no params for the
// call and SKIPPED the by-value copy (RefInc) of `store`'s managed-field-bearing
// argument.  That under-retained the argument's @Res and freed it one scope too
// early.  The churn below reuses the freed block, so the bug shows as a WRONG value
// (999) rather than only a nondeterministic crash; the fix keeps it 42.

type Res struct {
	v int
}

type MV struct {
	r @Res
}

type Box[T any] struct {
	slot @[]T
}

func newBox[T any]() @Box[T] {
	var b @Box[T] = make(Box[T])
	b.slot = make_slice(T, 1)
	return b
}

func (b @Box[T]) grow() {}

func (b @Box[T]) store(x T) {
	b.grow()
	b.slot[0] = x
}

func (b @Box[T]) Put(x T) {
	b.store(x)
}

func stash(b @Box[MV], val int) {
	var m MV
	m.r = make(Res)
	m.r.v = val
	b.Put(m)
}

func main() {
	var b @Box[MV] = newBox[MV]()
	stash(b, 42)
	var junk @[]@Res = make_slice(@Res, 64)
	for i := 0; i < 64; i++ {
		junk[i] = make(Res)
		junk[i].v = 999
	}
	testing.Println(b.slot[0].r.v)
}
