package "main"
import "pkg/builtins/testing"

// A sub-word scalar argument passed on the STACK (the 9th+ GP arg on aarch64/x64;
// past r0-r3 on arm32) must be spilled with a size- and sign-correct load.  Darwin
// aarch64 packs sub-word stack args at their natural size, so a full 8-byte load reads
// the ADJACENT packed arg's bytes (bool contamination), and the native backend keeps a
// sub-word value SIGN-extended in its 64-bit home with no re-extension at a promoted
// use — so a zero-extended spill made a negative signed narrow arg read positive.  This
// only bit at -O1+ (mem2reg promotes the param); exercises native (all archs) + LLVM +
// VM.  Root cause: the callee stack-arg spill loaded a fixed 8 bytes regardless of the
// arg's packed footprint/signedness.

func sgn8(a int, b int, c int, d int, e int, f int, g int, h int, x int8) int {
	if x < cast(int8, 0) {
		return 1
	}
	return 0
}

func flag(a int, b int, c int, d int, e int, f int, g int, h int, x bool) int {
	if x {
		return 1
	}
	return 0
}

func widen16(a int, b int, c int, d int, e int, f int, g int, h int, x int16) int {
	return cast(int, x)
}

func main() {
	testing.Println(sgn8(0, 0, 0, 0, 0, 0, 0, 0, cast(int8, 0 - 5))) // 1
	testing.Println(sgn8(0, 0, 0, 0, 0, 0, 0, 0, cast(int8, 5)))     // 0
	testing.Println(flag(0, 0, 0, 0, 0, 0, 0, 0, true))              // 1
	testing.Println(flag(0, 0, 0, 0, 0, 0, 0, 0, false))            // 0
	testing.Println(widen16(0, 0, 0, 0, 0, 0, 0, 0, cast(int16, 0 - 300))) // -300
}
