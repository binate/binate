package "main"
import "pkg/builtins/testing"

// Regression: a managed pointer returned from a constructor must survive its
// own inline OP_REFINC.  The refinc computes the header address into a scratch
// register without mutating the pointer register; when the native register
// allocator keeps the pointer live in a (callee-saved) home register across
// the refinc, a pre-index-writeback refinc (LDR [ptr, #-16]!) would corrupt it
// to ptr-16 — so `make(T)` would return a pointer 16 bytes low and every field
// read would yield the header refcount (a spurious 1) instead of the field.

type Box struct {
	a int
	b int
}

func makeBox(x int, y int) @Box {
	var bx @Box = make(Box)
	bx.a = x
	bx.b = y
	return bx
}

func main() {
	var bx @Box = makeBox(42, 7)
	testing.Println(bx.a)
	testing.Println(bx.b)
	testing.Println(bx.a + bx.b)
}
