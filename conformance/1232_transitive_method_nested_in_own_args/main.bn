package "main"

import "pkg/bb"
import "pkg/builtins/testing"

// Regression: a TRANSITIVE method (tt.T lives in pkg/tt, which main does NOT
// import) called with the SAME method NESTED in its own arguments.  The outer
// Combine's arg is itself a Combine call; that inner call registers tt.T.Combine's
// transitive extern during the outer call's buildCallArgs.  When genMethodCall
// snapshotted funcFound BEFORE buildCallArgs, the outer call's stale "absent" then
// registered the extern a SECOND time — two `declare`s for one symbol → clang
// "invalid redefinition".  The result is discarded (main can't name the transitive
// tt.T; chaining another tt method to consume it hits an unrelated pre-existing
// transitive-chain qualification limitation).
func main() {
	var b1 @bb.Box = bb.MakeBox(cast(int64, 1))
	var b2 @bb.Box = bb.MakeBox(cast(int64, 2))
	var b3 @bb.Box = bb.MakeBox(cast(int64, 4))
	b1.Get().Combine(b2.Get().Combine(b3.Get()))
	testing.Println(42)
}
