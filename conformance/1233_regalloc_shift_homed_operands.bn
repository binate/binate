package "main"
import "pkg/builtins/testing"

// Regression: the x86-64 shift lowering must place the shift COUNT in CL/RCX
// even when the native register allocator homes the operands in callee-saved
// registers.  A homed operand consumes no scratch-pool slot, so the count can
// no longer be assumed to land in RCX by pool position — it must be moved there
// explicitly, or the shift reads a garbage CL and produces the wrong result.
func shiftKeepingOperands(a uint64, n uint64) uint64 {
	var s uint64 = a << n
	// Keep a and n live across the shift so they get home registers.
	return s + a + n
}

func main() {
	// 1 << 4 = 16; 16 + 1 + 4 = 21.
	testing.Println(cast(int, shiftKeepingOperands(1, 4)))
}
