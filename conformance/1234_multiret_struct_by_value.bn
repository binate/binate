package "main"
import "pkg/builtins/testing"

// Regression: a function returning a by-value struct (coerced to `[N x iW]` by the
// LLVM backend) from MORE THAN ONE `return` site emitted a return-coercion alloca named
// `%v-1.agrp` at every return — OP_RETURN carries no unique value ID, so each `ret`
// produced the same name and LLVM rejected the duplicate.  The coercion slot is now
// function-scoped (`%aggret.slot`, emitted once at entry) with a per-return-tagged load,
// so several struct returns in one function compile.  Covers the GP path (int fields)
// and the x86-64 SSE path (float64 fields).

type Pt struct {
	A int
	B int
}

type Fp struct {
	X float64
	Y float64
}

// Two returns of a by-value GP struct.
func mkPt(x int) Pt {
	var p Pt
	if x < 0 {
		p.A = -1
		p.B = -2
		return p
	}
	p.A = x
	p.B = x + 1
	return p
}

// Two returns of a by-value SSE (float) struct.
func mkFp(neg bool) Fp {
	var f Fp
	if neg {
		f.X = -1.5
		f.Y = -2.5
		return f
	}
	f.X = 1.5
	f.Y = 2.5
	return f
}

func main() {
	var a Pt = mkPt(5)
	var b Pt = mkPt(-1)
	testing.Println(a.A + a.B + b.A + b.B) // 5 + 6 + (-1) + (-2) = 8

	var p Fp = mkFp(false)
	var n Fp = mkFp(true)
	// (1.5 + 2.5) - (-1.5 + -2.5) = 4.0 - (-4.0) = 8.0
	testing.Println(cast(int, (p.X + p.Y) - (n.X + n.Y)))
}
