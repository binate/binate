package "main"

import "pkg/builtins/testing"

// __c_entry(f) yields the address of a Binate function's C entry as a raw
// *uint8, so f can be handed to C as a callback pointer.  Here a Binate
// comparator with C's `int(const void*, const void*)` ABI is passed to libc
// `qsort`, which calls back into it to sort an int32 array.  The comparator's
// arguments are both pointers (word-size), so its mangled entry is a correct C
// entry directly — the degenerate native lowering (no adaptation thunk).
// Compiled mode, works on the LLVM and native backends; xfail in VM modes
// (compiled-only) and bare-metal (no libc).

// cmpI32 reads two int32s through the void* pointers C hands it and orders them.
func cmpI32(a *uint8, b *uint8) int32 {
	var va int32 = unsafe_index(bit_cast(*int32, a), 0)
	var vb int32 = unsafe_index(bit_cast(*int32, b), 0)
	if va < vb { return cast(int32, -1) }
	if va > vb { return cast(int32, 1) }
	return cast(int32, 0)
}

func main() {
	var arr [5]int32
	arr[0] = cast(int32, 3)
	arr[1] = cast(int32, 1)
	arr[2] = cast(int32, 4)
	arr[3] = cast(int32, 1)
	arr[4] = cast(int32, 5)
	__c_call("qsort", "void", bit_cast(*uint8, &arr[0]), cast(uint, 5), cast(uint, 4),
			__c_entry(cmpI32))
	for i := 0; i < 5; i++ {
		testing.Println(cast(int, arr[i]))
	}
}
