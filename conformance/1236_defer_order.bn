package "main"

import "pkg/builtins/testing"

// Deferred calls run LIFO (reverse of scheduling) at function exit, after the
// body finishes (§14.13 stmt.defer.exit).  testing.Println is variadic
// (...*any), exercising the func.variadic.pack path at a defer site.
func f() {
	defer testing.Println(1)
	defer testing.Println(2)
	defer testing.Println(3)
	testing.Println(0)
}

func main() {
	f()
}
