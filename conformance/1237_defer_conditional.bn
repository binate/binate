package "main"

import "pkg/builtins/testing"

// A defer inside an `if` belongs to the `if`'s block: its block runs when that
// block exits — before the code after the `if` — and only if the defer
// statement executed (§14.13).
func f(c bool) {
	if c {
		defer { testing.Println(1) }
	}
	testing.Println(0)
}

// A cleanup that must wait for the function's exit is deferred at function
// level, with the condition inside the deferred block, which reads the variable
// as it is at the exit.
func h(c bool) {
	var armed bool = false
	defer {
		if armed {
			testing.Println(3)
		}
	}
	if c {
		armed = true
	}
	testing.Println(2)
}

func main() {
	f(true)
	f(false)
	h(true)
	h(false)
}
