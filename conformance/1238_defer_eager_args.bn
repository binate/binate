package "main"

import "pkg/builtins/testing"

// p takes its argument BY VALUE, so `defer p(x)` snapshots x's value when the
// defer statement executes (§14.13 stmt.defer — eager, by-value operand
// evaluation): the later `x = 2` does not affect the deferred call.
func p(n int) {
	testing.Println(n)
}

func f() {
	x := 1
	defer p(x)
	x = 2
	p(x)
}

func main() {
	f()
}
