package "main"

import "pkg/builtins/testing"

// Nothing in a deferred block is evaluated at the defer statement: `defer {
// p(x) }` reads x when the block runs, at the enclosing block's exit — after the
// later `x = 2` (§14.13 stmt.defer).
func p(n int) {
	testing.Println(n)
}

func f() {
	x := 1
	defer { p(x) }
	x = 2
	p(x)
}

func main() {
	f()
}
