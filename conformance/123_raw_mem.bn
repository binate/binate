package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

func main() {
	// Allocate 32 bytes of raw (unmanaged) memory.
	var p *uint8 = rt.RawAlloc(32)
	rt.MemZero(p, 32)

	// Write and read an int at offset 0 via pointer indexing
	var ip *int = bit_cast(*int, p)
	ip[0] = 42
	testing.Println(ip[0])

	// Write and read at offset 8
	ip[1] = 99
	testing.Println(ip[1])

	// Write and read a byte at offset 16
	p[16] = 255
	testing.Println(cast(int, p[16]))

	// Verify first int is still intact
	testing.Println(ip[0])

	// Memset first 8 bytes to zero
	rt.MemZero(p, 8)
	testing.Println(ip[0])

	// Pointer write/read via bit_cast
	var pp *int = bit_cast(*int, bit_cast(*uint8, p))
	pp[0] = 777
	testing.Println(bit_cast(*int, p)[0])

	rt.RawFree(p)
}
