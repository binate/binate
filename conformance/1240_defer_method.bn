package "main"

import "pkg/builtins/testing"

type Counter struct {
	n int
}

func (c *Counter) Show() {
	testing.Println(c.n)
}

// defer c.Show() evaluates the receiver (the address of c) eagerly, but reads
// c.n when the deferred call runs — so it observes the post-defer mutation.
func f() {
	var c Counter
	c.n = 5
	defer c.Show()
	c.n = 9
	testing.Println(0)
}

func main() {
	f()
}
