package "main"

import "pkg/builtins/testing"

interface Speaker {
	speak()
}

type Dog struct {
	n int
}

func (d *Dog) speak() {
	testing.Println(d.n)
}

impl *Dog : Speaker

// A deferred interface-method call dispatches through the vtable at exit, from
// the receiver snapshotted at the defer site.
func f() {
	var d Dog
	d.n = 7
	var s *Speaker = &d
	defer s.speak()
	testing.Println(0)
}

func main() {
	f()
}
