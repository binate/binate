package "main"

import "pkg/builtins/testing"

type Box struct {
	n int
}

func show(b @Box) {
	testing.Println(b.n)
}

// A managed @Box operand is retained (RefInc'd into the defer slot) so it is
// still live when the deferred call runs at exit, then released after.
func f() {
	var b @Box = make(Box)
	b.n = 55
	defer show(b)
	testing.Println(0)
}

func main() {
	f()
}
