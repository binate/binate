package "main"

import "pkg/builtins/testing"

// A value borrowed into a variadic *any argument in a deferred block
// (testing.Println is `...*any`) is borrowed when the block runs: the later
// `x = 2` is what the deferred call prints (§14.13 stmt.defer).
func f() {
	x := 1
	defer { testing.Println(x) }
	x = 2
	testing.Println(x)
}

func main() {
	f()
}
