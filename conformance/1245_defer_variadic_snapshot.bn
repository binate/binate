package "main"

import "pkg/builtins/testing"

// A variadic *any argument (testing.Println is `...*any`) is snapshotted by
// VALUE at the defer site: the later `x = 2` does not change what the deferred
// call prints (§14.13 stmt.defer; proposal-defer §4 "no late-binding
// surprises").
func f() {
	x := 1
	defer testing.Println(x)
	x = 2
	testing.Println(x)
}

func main() {
	f()
}
