package "main"

import "pkg/builtins/testing"

// `defer panic(msg)` schedules the panic to run at function exit — after the
// body's statements — then abort (§14.13; panic is an allowed call operand).
func f() {
	testing.Println(0)
	defer panic("deferred boom")
	testing.Println(1)
}

func main() {
	f()
}
