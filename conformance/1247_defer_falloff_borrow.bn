package "main"

import "pkg/builtins/testing"

type Box struct {
	n int
}

func readInt(p *int) {
	testing.Println(*p)
}

// b is a managed local with refcount 1.  The deferred call borrows a raw *int
// INTO b's allocation.  On the fall-off exit (no explicit return), the deferred
// call must run while b is still live — before b's end-of-function release —
// else *p reads freed memory (§14.13 stmt.defer.exit).
func f() {
	var b @Box = make(Box)
	b.n = 88
	defer readInt(&b.n)
	testing.Println(0)
}

func main() {
	f()
}
