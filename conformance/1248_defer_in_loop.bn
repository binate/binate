package "main"

import "pkg/builtins/testing"

func g(i int) {
	testing.Println("deferred", i)
}

// A defer in a loop body belongs to the body, a block per iteration: its block
// runs at the end of every iteration, reading the loop variable as it is then
// (§14.13 stmt.defer.exit).
func main() {
	for i := 0; i < 3; i = i + 1 {
		defer { g(i) }
		testing.Println("body", i)
	}
	testing.Println("after")
}
