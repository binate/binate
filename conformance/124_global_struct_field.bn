package "main"

import "pkg/builtins/testing"

type Config struct {
	Width  int
	Height int
	Debug  bool
}

var cfg Config

func initConfig() {
	cfg.Width = 800
	cfg.Height = 600
	cfg.Debug = true
}

func main() {
	initConfig()
	testing.Println(cfg.Width)
	testing.Println(cfg.Height)
	if cfg.Debug {
		testing.Println(1)
	} else {
		testing.Println(0)
	}
}
