package "main"

import "pkg/builtins/testing"

// mk returns a FRESH managed @[]char (a heap copy of the literal).
func mk() @[]char {
	var s @[]char = "hello"
	return s
}

// The fresh managed value is boxed into *any (Println is ...*any) at the defer
// site.  Does its backing survive to the deferred call at exit?
func f() {
	defer testing.Println(mk())
	testing.Println("body")
}

func main() {
	f()
}
