package "main"

import "pkg/builtins/testing"

type Box struct {
	n int
}

func mk(n int) @Box {
	var b @Box = make(Box)
	b.n = n
	return b
}

func sumBoxes(bs ...@Box) {
	var s int = 0
	for i := 0; i < len(bs); i = i + 1 {
		s = s + bs[i].n
	}
	testing.Println(s)
}

// The packed backing over a MANAGED element type (...@Box) must keep its
// elements alive until the deferred call runs at exit.
func f() {
	defer sumBoxes(mk(10), mk(20), mk(30))
}

func main() {
	f()
}
