package "main"

import "pkg/builtins/testing"

func mk() @[]char {
	var s @[]char = "hello"
	return s
}

// A managed call result boxed into a variadic *any argument, in a deferred block
// scheduled in a NESTED block: it runs at that block's exit, and the result lives
// until its statement ends.
func f() {
	if true {
		defer { testing.Println(mk()) }
	}
}

func main() {
	f()
}
