package "main"

import "pkg/builtins/testing"

func mk() @[]char {
	var s @[]char = "hello"
	return s
}

// A managed value boxed into a variadic *any argument, in a NESTED block: the
// value snapshot must survive block exit to the deferred call at function exit.
func f() {
	if true {
		defer testing.Println(mk())
	}
}

func main() {
	f()
}
