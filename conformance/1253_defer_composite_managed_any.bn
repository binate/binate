package "main"

import "pkg/builtins/testing"

type W struct {
	s @[]char
}

func mk() @[]char {
	var s @[]char = "hi"
	return s
}

// A composite literal carrying managed content, boxed into a variadic *any
// argument of a deferred call: its managed field must survive to the deferred
// call at exit (not be freed at the defer site).
func f() {
	defer testing.Println(W{s: mk()})
}

func main() {
	f()
}
