package "main"

import "pkg/builtins/testing"

type W struct {
	s @[]char
}

func mk() @[]char {
	var s @[]char = "hi"
	return s
}

// A composite literal carrying managed content, boxed into a variadic *any
// argument of a call in a deferred block: built when the block runs, its managed
// field lives until the deferred statement ends.
func f() {
	defer { testing.Println(W{s: mk()}) }
}

func main() {
	f()
}
