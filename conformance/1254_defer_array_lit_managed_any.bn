package "main"

import "pkg/builtins/testing"

func mk(c char) @[]char {
	var s @[]char = make_slice(char, 1)
	s[0] = c
	return s
}

// An array literal carrying managed elements, boxed into a variadic *any arg of
// a deferred call: its elements must survive to the deferred call at exit.
func f() {
	defer takeArr([2]@[]char{mk('a'), mk('b')})
}

func takeArr(a [2]@[]char) {
	testing.Println(a[0])
	testing.Println(a[1])
}

func main() {
	f()
}
