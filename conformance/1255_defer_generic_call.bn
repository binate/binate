package "main"

import "pkg/builtins/testing"

func g[T any](x T) {
	testing.Println(x)
}

// A generic-function instantiation deferred call: monomorphized + dispatched as
// a direct call to the specialized symbol at exit (§14.13).
func f() {
	defer g[int](42)
	testing.Println(0)
}

func main() {
	f()
}
