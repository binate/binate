package "main"

import "pkg/builtins/testing"

type Box struct {
	n int
}

func mk(n int) @Box {
	var b @Box = make(Box)
	b.n = n
	return b
}

func show[T any](x T, b @Box) {
	testing.Println(b.n)
}

// A generic-function defer with a MANAGED argument: the @Box operand is retained
// (via the operand slot) across the wait, dispatched to the monomorphized symbol.
func f() {
	defer show[int](7, mk(99))
	testing.Println(0)
}

func main() {
	f()
}
