package "main"

import "pkg/builtins/testing"

// Regression: a user package-level global whose name starts with a SINGLE
// underscore (`_pkg*`) must NOT collide with the compiler's synthesized
// per-package descriptor globals.  Those descriptors used to be emitted as
// single-underscore `_pkgname` / `_pkg_info` / `_pkg_satfrag` / … through the
// ordinary global namespace, so a user `var _pkg_info …` mangled to the IDENTICAL
// symbol — a silent duplicate-symbol miscompile (`_pkg_satfrag` is strong, a hard
// link error).  The synthesized family now lives in the reserved `__` namespace
// (`__pkgname` / `__pkg_info` / …), so these single-underscore user names are
// free.  Only `__`-prefixed identifiers are reserved (spec abi/05 §5.4).

var _pkgname int = 1

var _pkg_info int = 20

var _pkg_funcs int = 300

var _pkg_globals int = 4000

var _pkg_vtables int = 50000

var _pkg_satentries int = 600000

var _pkg_satfrag int = 7000000

func main() {
	testing.Println(
			_pkgname + _pkg_info + _pkg_funcs + _pkg_globals + _pkg_vtables + _pkg_satentries + _pkg_satfrag)
}
