package "main"
import "pkg/builtins/testing"

// An interface method call from a function whose stack frame is large enough
// that its high slots lie beyond the load/store scaled-immediate limit.  On
// aarch64 an 8-byte `ldr/str …, [SP, #imm]` encodes only imm/8 <= 4095 (byte
// offset <= 32760); a larger offset is materialized through X17 as the
// assembler's scratch.  A call emitter must therefore NOT keep the dispatch
// target in X17 across argument marshaling: an argument reloaded from above
// 32760 bytes uses that X17 scratch and would clobber the target, so the `blr`
// branches to a garbage address.
//
// The 6000-element local array is declared FIRST, so the scalar argument
// sources below it get frame slots above 32760 bytes.  Fifteen arguments
// (more than the callee-saved register budget the backend homes values in)
// force some to spill and reload from those high slots INSIDE the dispatch
// loop — which is where an early target in X17 would be clobbered.  The call
// must return pad[1] + pad[2] + … + pad[16] = 1 + (2+…+16) = 136.

interface Many {
	M(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int, a7 int,
	  a8 int, a9 int, a10 int, a11 int, a12 int, a13 int, a14 int) int
}

type Impl struct {
	base int
}

func (self *Impl) M(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int, a7 int,
		a8 int, a9 int, a10 int, a11 int, a12 int, a13 int, a14 int) int {
	return self.base + a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 +
			a10 + a11 + a12 + a13 + a14
}

impl *Impl : Many

func run() int {
	var pad [6000]int
	var i int = 0
	for i = 0; i < 6000; i = i + 1 {
		pad[i] = i
	}
	var obj Impl
	obj.base = pad[1]
	var m *Many = &obj
	var v0 int = pad[2]
	var v1 int = pad[3]
	var v2 int = pad[4]
	var v3 int = pad[5]
	var v4 int = pad[6]
	var v5 int = pad[7]
	var v6 int = pad[8]
	var v7 int = pad[9]
	var v8 int = pad[10]
	var v9 int = pad[11]
	var v10 int = pad[12]
	var v11 int = pad[13]
	var v12 int = pad[14]
	var v13 int = pad[15]
	var v14 int = pad[16]
	return m.M(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14)
}

func main() {
	testing.Println(run())
}
