package "main"

import "pkg/builtins/testing"

// __c_call returning an AGGREGATE by value: libc `div_t div(int, int)` returns a
// two-int struct {quot, rem} in the return registers (register-coerced — 8 bytes,
// below every target's sret cutoff).  div(17, 5) = {quot: 3, rem: 2}.  Exercises
// the aggregate-return path on the LLVM + native backends.
// xfail in VM modes (compiled-only FFI) and arm32-baremetal (no libc `div`).

type DivT struct { quot int32; rem int32 }

func main() {
	var r DivT = __c_call("div", DivT, cast(int32, 17), cast(int32, 5))
	testing.Println(cast(int, r.quot))
	testing.Println(cast(int, r.rem))
}
