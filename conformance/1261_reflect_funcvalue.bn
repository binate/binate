package "main"

import "pkg/builtins/testing"

import "pkg/builtins/reflect"

// reflect.TypeOf / reflect.DataOf are lowered inline for a DIRECT call, but taken
// as a func value they dispatch to reflect's real bodies (the non-inlined path).
// Boxing x once and comparing the inlined result to the func-value result checks
// those bodies read the interface value's data word (0) and vtable-slot-1
// *TypeInfo exactly as the intrinsic does.  Prints 1, 1.
func check(x *any) {
	var d1 *uint8 = reflect.DataOf(x) // inlined intrinsic
	var ti1 *reflect.TypeInfo = reflect.TypeOf(x)
	var df *func(*any) *uint8 = reflect.DataOf // func value -> reflect.bn body
	var tf *func(*any) *reflect.TypeInfo = reflect.TypeOf
	testing.Println(cast(int, bit_cast(int, d1) == bit_cast(int, df(x))))
	testing.Println(cast(int, bit_cast(int, ti1) == bit_cast(int, tf(x))))
}

func main() {
	var n int = 42
	check(n)
}
