package "main"

import "pkg/builtins/testing"

// SROA field-broadening splits a struct with a float field: the non-promotable
// float slot (mem2reg cannot promote it) gets an explicit zero-const init, so an
// UNWRITTEN float field reads 0 rather than stack garbage after the whole-struct
// backend zero-fill is dropped at -O2.  A written float round-trips.  Prints 0, 10.
type P struct {
	a int
	f float64
}

func unwritten(k int) int {
	var p P
	p.a = k
	return cast(int, p.f) // p.f never written -> 0
}

func written(k int) int {
	var p P
	p.a = k
	p.f = 2.5
	return cast(int, p.f * 4.0) // 10
}

func main() {
	testing.Println(unwritten(3))
	testing.Println(written(3))
}
