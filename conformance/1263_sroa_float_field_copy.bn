package "main"

import "pkg/builtins/testing"

// Field-broadening's OTHER path: a struct with float / oversized-int fields copied
// from a PINNED source scalar-replaces the DEST via whole-store extraction —
// `store(dest.field, OP_EXTRACT(load(src), fieldIdx))` — so the float / float32 /
// (32-bit) oversized-int extract reaches the backend, exercised on native + VM,
// not just the direct-access path (1262).  `sink(&a)` escapes a's address so a is
// L1-pinned (its whole value survives the copy).  Prints 1005.
type P struct {
	a   int
	f   float64
	g   float32
	big int64
}

func sink(p *P) {}

func copyFloats() int {
	var a P
	a.a = 1
	a.f = 2.0
	a.g = 3.0
	a.big = 1000
	sink(&a)
	var b P = a
	return cast(int, b.f) + cast(int, b.g) + cast(int, b.big)
}

func main() {
	testing.Println(copyFloats())
}
