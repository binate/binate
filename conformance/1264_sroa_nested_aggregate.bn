package "main"

import "pkg/builtins/testing"

// Nested-aggregate scalar replacement (the L1-recursion): a struct field
// accessed field-by-field through a nested struct — o.inner.x — lowers to
// GET_FIELD_PTR(Outer, innerIdx) whose result is the base of an inner
// GET_FIELD_PTR(Inner, x).  L1 recurses through that chain so the outer slot
// splits; the fixpoint then splits the inner slot on a later pass, at arbitrary
// depth (threeLevel exercises one split per pass).  An unwritten nested field
// reads its zero through the split (backend zero-fill / mem2reg zero-forward).
// Prints 66, 100, 0.

type Inner struct {
	x int
	y int
}

type Outer struct {
	a     int
	inner Inner
}

// Three levels deep: the fixpoint peels one nesting level per pass.
type Lv1 struct {
	v int
}

type Lv2 struct {
	pad int
	l1  Lv1
}

type Lv3 struct {
	pad int
	l2  Lv2
}

func twoLevel() int {
	var o Outer
	o.a = 11
	o.inner.x = 22
	o.inner.y = 33
	return o.a + o.inner.x + o.inner.y
}

func threeLevel() int {
	var d Lv3
	d.pad = 1
	d.l2.pad = 3
	d.l2.l1.v = 96
	return d.pad + d.l2.pad + d.l2.l1.v
}

func unwrittenNested() int {
	var o Outer
	o.a = 5
	o.inner.x = 7
	// o.inner.y is never written — it must read its zero.
	return o.inner.y
}

func main() {
	testing.Println(twoLevel())
	testing.Println(threeLevel())
	testing.Println(unwrittenNested())
}
