package "main"

import "pkg/builtins/testing"

// A struct with an ARRAY field: the SROA gate admits a `[N]T` field as a
// backend-zero-filled aggregate (it stays an array slot — arrays are not split
// element-wise), so a written element reads back and an unwritten element (or an
// entirely unwritten struct) reads its zero through the backend zero-fill, on
// every backend. Prints 140, 7.
type Grid struct {
	tag int
	row [3]int
}

func writtenCase() int {
	var g Grid
	g.tag = 100
	g.row[0] = 10
	g.row[2] = 30
	// g.row[1] never written — must read 0.
	return g.tag + g.row[0] + g.row[1] + g.row[2]
}

func unwrittenCase() int {
	var g Grid
	g.tag = 7
	// The whole row is unwritten — every element must read 0.
	return g.tag + g.row[0] + g.row[1] + g.row[2]
}

func main() {
	testing.Println(writtenCase())
	testing.Println(unwrittenCase())
}
