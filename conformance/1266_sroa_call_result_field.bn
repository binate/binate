package "main"

import "pkg/builtins/testing"

// SROA of a `var s S = f()` whose result S is field-accessed: the whole-store of
// the by-value aggregate call result scalar-replaces into per-field extracts of
// the call.  Loops keep mk* from inlining, so a real OP_CALL survives at the call
// site — Small returns coerced in registers, Big via sret.  Prints 15, 18.
type Small struct {
	a int
	b int
}

type Big struct {
	a int
	b int
	c int
	d int
	e int
}

func mkSmall(x int) Small {
	var acc int = 0
	for i := 0; i < x; i = i + 1 {
		acc = acc + i
	}
	var s Small
	s.a = acc
	s.b = x
	return s
}

func mkBig(x int) Big {
	var acc int = 0
	for i := 0; i < x; i = i + 1 {
		acc = acc + i
	}
	var s Big
	s.a = acc
	s.b = x
	s.c = x + 1
	s.d = x + 2
	s.e = x + 3
	return s
}

func smallCase() int {
	var s Small = mkSmall(5) // coerced-register return
	return s.a + s.b         // 10 + 5
}

func bigCase() int {
	var s Big = mkBig(4) // sret return
	return s.a + s.c + s.e // 6 + 5 + 7
}

func main() {
	testing.Println(smallCase())
	testing.Println(bigCase())
}
