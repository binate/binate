package "main"

import "pkg/builtins/testing"

// A managed-slice return `var s @[]int = f()` is scalar-replaced via the phase-2
// managed-slice SROA now that isExtractableAggregateValue admits an OP_CALL:
// {data,len,backinglen} promote, the +1-owned refptr stays a managed slot that is
// RefDec'd exactly once.  This exercises the refcount-sensitive ops — alias
// (RefInc), overwrite (RefDec old + own the new call result), and scope-exit
// RefDec — so a miscount would double-free (abort) or use-after-free (wrong t[0]).
// Prints 3, 100, 203, 100.
func mk(n int, base int) @[]int {
	var s @[]int = make_slice(int, n)
	for i := 0; i < n; i = i + 1 {
		s[i] = base + i
	}
	return s
}

func refcountCase() {
	var s @[]int = mk(3, 100) // [100,101,102], +1 from the call
	var t @[]int = s          // alias — RefInc
	testing.Println(len(s))
	testing.Println(s[0])
	s = mk(4, 200) // overwrite — RefDec old [100..], own the new call result
	testing.Println(s[3])
	testing.Println(t[0]) // old slice kept alive by t
}

func main() {
	refcountCase()
}
