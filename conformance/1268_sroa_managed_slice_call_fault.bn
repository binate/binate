package "main"

import "pkg/builtins/testing"

// A managed-slice-from-call (`var s @[]int = f()`) is scalar-replaced (phase-2)
// and LIVE when a bounds fault unwinds mid-scope: the fault pad must RefDec the
// SPLIT slice's refptr slot, not the original whole value.  A miscount would
// double-free (crash before the message) or corrupt the unwind; the clean
// "index out of bounds" panic proves the split-call-result-slice pad unwind is
// correct (exercised under the VM, which unwinds recoverable faults through pads).
func mk(n int) @[]int {
	var s @[]int = make_slice(int, n)
	for i := 0; i < n; i = i + 1 {
		s[i] = i
	}
	return s
}

func faultCase() int {
	var s @[]int = mk(3) // live +1 managed slice from the call
	var bad int = s[5]   // OUT OF BOUNDS (len 3) → fault while s is live
	return bad
}

func main() {
	testing.Println(faultCase())
}
