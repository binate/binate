package "main"

import "pkg/builtins/testing"

// SROA of `var s S = f()` where the call is a FUNC-VALUE call or an
// INTERFACE-METHOD call (not just a direct call): both lower to an OP_CALL_FUNC_VALUE
// / OP_CALL_IFACE_METHOD with a by-value aggregate (retbuf-style) result, which
// isExtractableAggregateValue now admits, so s scalar-replaces into per-field
// extracts of the call.  Loops keep mk / make_it from inlining.  Prints 15, 115.

type S struct {
	a int
	b int
}

func mk(x int) S {
	var acc int = 0
	for i := 0; i < x; i = i + 1 {
		acc = acc + i
	}
	var s S
	s.a = acc
	s.b = x
	return s
}

func fvCase() int {
	var fv *func(int) S = mk
	var s S = fv(5) // OP_CALL_FUNC_VALUE
	return s.a + s.b
}

interface Maker {
	make_it(x int) S
}

type Impl struct {
	off int
}

func (im *Impl) make_it(x int) S {
	var acc int = 0
	for i := 0; i < x; i = i + 1 {
		acc = acc + i
	}
	var s S
	s.a = acc
	s.b = x + im.off
	return s
}

impl *Impl : Maker

func ifaceCase() int {
	var obj @Impl = make(Impl)
	obj.off = 100
	var m @Maker = obj
	var s S = m.make_it(5) // OP_CALL_IFACE_METHOD
	return s.a + s.b
}

func main() {
	testing.Println(fvCase())
	testing.Println(ifaceCase())
}
