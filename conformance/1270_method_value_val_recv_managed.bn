package "main"

import "pkg/builtins/testing"

// A method value over a VALUE receiver whose struct has a managed field.  The
// wrapper must field-RefInc a copy of the receiver before forwarding (the receiver
// is CONSUMED by the value method's exit dtor); without that copy each call
// over-releases the captured field, freeing it out from under the closure — a
// use-after-free on a later call, double-free at scope exit.

type Cell struct {
	p @int
}

func (c Cell) get() int {
	return *c.p
}

func main() {
	var c Cell
	c.p = box(7)
	var mv *func() int = c.get
	var s int = 0
	s = s + mv()
	s = s + mv()
	s = s + mv()
	s = s + mv()
	testing.Println(s) // 28
	testing.Println(*c.p) // 7 — still alive (freed prematurely by the double-free bug)
}
