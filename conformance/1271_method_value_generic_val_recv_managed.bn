package "main"

import "pkg/builtins/testing"

// A method value over a GENERIC value-struct receiver with a managed field.  The
// wrapper's receiver copy must use the IR-gen-remapped instantiated type name
// (Box__bn_inst__int), not the checker's raw `Box[int]` (an invalid backend
// identifier) — the same double-free fix as 1270, exercised on the generic
// instantiation path.

type Box[T any] struct {
	p @int
	v T
}

func (b Box[T]) get() int {
	return *b.p
}

func main() {
	var bx Box[int]
	bx.p = box(9)
	bx.v = 3
	var mv *func() int = bx.get
	var s int = 0
	s = s + mv()
	s = s + mv()
	s = s + mv()
	testing.Println(s) // 27
	testing.Println(*bx.p) // 9 — still alive
}
