package "main"

import "pkg/builtins/testing"

// Exercises the native aarch64 single-unsigned-compare bounds check. Valid
// accesses must still succeed (a wrong compare direction would abort a legal
// access); the slice-range forms cover the hi-check-then-lo-check path whose
// soundness depends on the hi check running first. All integer, exact in every
// mode.
func main() {
	var s @[]int = @[]int{10, 20, 30, 40, 50}
	// Element access (single-compare path), several indices carried across the
	// per-access bounds checks in one straight-line block.
	testing.Println(s[0] + s[2] + s[4]) // 90
	testing.Println(s[1]*s[3] + s[0])   // 20*40 + 10 = 810

	// Slice-range expressions: hi check (len+1) then lo check (hi+1).
	var mid @[]int = s[1:4] // {20, 30, 40}
	testing.Println(len(mid))            // 3
	testing.Println(mid[0] + mid[2])     // 60
	var tail @[]int = s[2:] // {30, 40, 50}
	testing.Println(tail[0] + tail[len(tail)-1]) // 80
	var all @[]int = s[0:5]
	testing.Println(all[4])              // 50
	var empty @[]int = s[3:3]
	testing.Println(len(empty))          // 0
}
