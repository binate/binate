package "main"

import "pkg/builtins/testing"

// Cross-checks constant-divisor division/modulo (which the native backends lower
// to a magic-number multiply) against the hardware divide reached through a
// runtime divisor.  The runtime divisor comes from a slice element so that
// inlining / constant propagation cannot fold it back into the magic path — the
// two sides must stay distinct lowerings.  Prints "all match" when every case
// agrees.

func hwDivS(n int, divs @[]int, i int) int { return n / divs[i] }

func hwRemS(n int, divs @[]int, i int) int { return n % divs[i] }

func hwDivU(n uint64, divs @[]uint64, i int) uint64 { return n / divs[i] }

func hwRemU(n uint64, divs @[]uint64, i int) uint64 { return n % divs[i] }

func hwDivS32(n int32, divs @[]int32, i int) int32 { return n / divs[i] }

func hwRemS32(n int32, divs @[]int32, i int) int32 { return n % divs[i] }

func hwDivU32(n uint32, divs @[]uint32, i int) uint32 { return n / divs[i] }

func hwDivS8(n int8, divs @[]int8, i int) int8 { return n / divs[i] }

func hwRemS8(n int8, divs @[]int8, i int) int8 { return n % divs[i] }

func hwDivS64(n int64, divs @[]int64, i int) int64 { return n / divs[i] }

func hwRemS64(n int64, divs @[]int64, i int) int64 { return n % divs[i] }

func main() {
	// index: 0=7 1=-7 2=139968 3=-139968 4=1000 5=8 6=16 7=-4 8=1 9=-1 10=100 11=3877
	var ds @[]int = make_slice(int, 12)
	ds[0] = 7
	ds[1] = -7
	ds[2] = 139968
	ds[3] = -139968
	ds[4] = 1000
	ds[5] = 8
	ds[6] = 16
	ds[7] = -4
	ds[8] = 1
	ds[9] = -1
	ds[10] = 100
	ds[11] = 3877
	var bad int = 0

	var n int = -4000000
	for n < 4000000 {
		if n / 7 != hwDivS(n, ds, 0) { bad = bad + 1 }
		if n % 7 != hwRemS(n, ds, 0) { bad = bad + 1 }
		if n / -7 != hwDivS(n, ds, 1) { bad = bad + 1 }
		if n % -7 != hwRemS(n, ds, 1) { bad = bad + 1 }
		if n / 139968 != hwDivS(n, ds, 2) { bad = bad + 1 }
		if n % 139968 != hwRemS(n, ds, 2) { bad = bad + 1 }
		if n / -139968 != hwDivS(n, ds, 3) { bad = bad + 1 }
		if n % -139968 != hwRemS(n, ds, 3) { bad = bad + 1 }
		if n / 1000 != hwDivS(n, ds, 4) { bad = bad + 1 }
		if n % 1000 != hwRemS(n, ds, 4) { bad = bad + 1 }
		if n / 8 != hwDivS(n, ds, 5) { bad = bad + 1 }
		if n % 8 != hwRemS(n, ds, 5) { bad = bad + 1 }
		if n / 16 != hwDivS(n, ds, 6) { bad = bad + 1 }
		if n / -4 != hwDivS(n, ds, 7) { bad = bad + 1 }
		if n % -4 != hwRemS(n, ds, 7) { bad = bad + 1 }
		if n / 1 != hwDivS(n, ds, 8) { bad = bad + 1 }
		if n / -1 != hwDivS(n, ds, 9) { bad = bad + 1 }
		if n % 1 != hwRemS(n, ds, 8) { bad = bad + 1 }
		if n / 100 != hwDivS(n, ds, 10) { bad = bad + 1 }
		if n % 100 != hwRemS(n, ds, 10) { bad = bad + 1 }
		if n % 3877 != hwRemS(n, ds, 11) { bad = bad + 1 }
		n = n + 20011
	}

	// Signed 64-bit edges around the extremes.  Typed int64 (not int) so the
	// INT64 literals fit on 32-bit-int targets; this exercises the 64-bit magic
	// on 64-bit-int backends, while int64 division is a libcall on arm32 — still
	// cross-checked against the same libcall.
	var d64 @[]int64 = make_slice(int64, 3)
	d64[0] = cast(int64, 7)
	d64[1] = cast(int64, 139968)
	d64[2] = cast(int64, 8)
	var e64 @[]int64 = make_slice(int64, 6)
	e64[0] = cast(int64, -9223372036854775807) - cast(int64, 1) // INT64_MIN
	e64[1] = cast(int64, 9223372036854775807) // INT64_MAX
	e64[2] = cast(int64, 0)
	e64[3] = cast(int64, -1)
	e64[4] = cast(int64, 139967)
	e64[5] = cast(int64, -139968)
	for ei := 0; ei < 6; ei++ {
		var e int64 = e64[ei]
		if e / cast(int64, 7) != hwDivS64(e, d64, 0) { bad = bad + 1 }
		if e % cast(int64, 7) != hwRemS64(e, d64, 0) { bad = bad + 1 }
		if e / cast(int64, 139968) != hwDivS64(e, d64, 1) { bad = bad + 1 }
		if e % cast(int64, 139968) != hwRemS64(e, d64, 1) { bad = bad + 1 }
		if e / cast(int64, 8) != hwDivS64(e, d64, 2) { bad = bad + 1 }
		if e % cast(int64, 8) != hwRemS64(e, d64, 2) { bad = bad + 1 }
	}

	// index: 0=7 1=139968 2=8 3=16 4=3877 5=1000000007
	var us @[]uint64 = make_slice(uint64, 6)
	us[0] = cast(uint64, 7)
	us[1] = cast(uint64, 139968)
	us[2] = cast(uint64, 8)
	us[3] = cast(uint64, 16)
	us[4] = cast(uint64, 3877)
	us[5] = cast(uint64, 1000000007)
	var u uint64 = cast(uint64, 0)
	var k int = 0
	for k < 4000 {
		if u / cast(uint64, 7) != hwDivU(u, us, 0) { bad = bad + 1 }
		if u % cast(uint64, 7) != hwRemU(u, us, 0) { bad = bad + 1 }
		if u / cast(uint64, 139968) != hwDivU(u, us, 1) { bad = bad + 1 }
		if u % cast(uint64, 139968) != hwRemU(u, us, 1) { bad = bad + 1 }
		if u / cast(uint64, 8) != hwDivU(u, us, 2) { bad = bad + 1 }
		if u % cast(uint64, 8) != hwRemU(u, us, 2) { bad = bad + 1 }
		if u / cast(uint64, 16) != hwDivU(u, us, 3) { bad = bad + 1 }
		if u / cast(uint64, 3877) != hwDivU(u, us, 4) { bad = bad + 1 }
		if u / cast(uint64, 1000000007) != hwDivU(u, us, 5) { bad = bad + 1 }
		u = u + cast(uint64, 2305843009213693951)
		k = k + 1
	}

	// Sub-word types exercise the width-64-magic-then-narrow path on hardware.
	var d32 @[]int32 = make_slice(int32, 4)
	d32[0] = cast(int32, 7)
	d32[1] = cast(int32, -7)
	d32[2] = cast(int32, 139968)
	d32[3] = cast(int32, 100)
	var u32d @[]uint32 = make_slice(uint32, 3)
	u32d[0] = cast(uint32, 7)
	u32d[1] = cast(uint32, 139968)
	u32d[2] = cast(uint32, 100)
	var n32 int32 = cast(int32, -2100000000)
	var k32 int = 0
	for k32 < 4200 {
		if n32 / cast(int32, 7) != hwDivS32(n32, d32, 0) { bad = bad + 1 }
		if n32 % cast(int32, 7) != hwRemS32(n32, d32, 0) { bad = bad + 1 }
		if n32 / cast(int32, -7) != hwDivS32(n32, d32, 1) { bad = bad + 1 }
		if n32 / cast(int32, 139968) != hwDivS32(n32, d32, 2) { bad = bad + 1 }
		if n32 % cast(int32, 100) != hwRemS32(n32, d32, 3) { bad = bad + 1 }
		var un32 uint32 = cast(uint32, n32)
		if un32 / cast(uint32, 7) != hwDivU32(un32, u32d, 0) { bad = bad + 1 }
		if un32 / cast(uint32, 139968) != hwDivU32(un32, u32d, 1) { bad = bad + 1 }
		n32 = n32 + cast(int32, 1000003)
		k32 = k32 + 1
	}

	// int8: exhaustive over the whole range.
	var d8 @[]int8 = make_slice(int8, 3)
	d8[0] = cast(int8, 3)
	d8[1] = cast(int8, 7)
	d8[2] = cast(int8, -5)
	var b int = -128
	for b <= 127 {
		var n8 int8 = cast(int8, b)
		if n8 / cast(int8, 3) != hwDivS8(n8, d8, 0) { bad = bad + 1 }
		if n8 % cast(int8, 3) != hwRemS8(n8, d8, 0) { bad = bad + 1 }
		if n8 / cast(int8, 7) != hwDivS8(n8, d8, 1) { bad = bad + 1 }
		if n8 % cast(int8, -5) != hwRemS8(n8, d8, 2) { bad = bad + 1 }
		b = b + 1
	}

	if bad == 0 {
		testing.Println("all match")
	} else {
		testing.Println(bad)
	}
}
