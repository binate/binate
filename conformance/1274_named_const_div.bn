package "main"

import "pkg/builtins/testing"

// Cross-checks division/modulo by a NAMED constant (`var d = C; x % d`) against
// the hardware divide reached through a runtime divisor.  A named-constant
// divisor reaches the backend as an OP_CONST_INT only after the
// identity/cast-fold simplification pass (iropt/simplify.bn) folds mem2reg's
// grounding cast of the stored constant; without it the divisor stays a value
// and this test would still pass (both sides hardware) but exercise nothing.
// With the pass the `% dC` side lowers to a magic-number multiply and must agree
// with the hardware divide.  Prints "all match" when every case agrees.

func hwDivS(n int, divs @[]int, i int) int { return n / divs[i] }

func hwRemS(n int, divs @[]int, i int) int { return n % divs[i] }

func hwDivU32(n uint32, divs @[]uint32, i int) uint32 { return n / divs[i] }

func hwRemU32(n uint32, divs @[]uint32, i int) uint32 { return n % divs[i] }

func hwDivS32(n int32, divs @[]int32, i int) int32 { return n / divs[i] }

func main() {
	var ds @[]int = make_slice(int, 5)
	ds[0] = 7
	ds[1] = -7
	ds[2] = 139968
	ds[3] = 1000
	ds[4] = 8
	var u32d @[]uint32 = make_slice(uint32, 3)
	u32d[0] = cast(uint32, 7)
	u32d[1] = cast(uint32, 139968)
	u32d[2] = cast(uint32, 8)
	var s32d @[]int32 = make_slice(int32, 2)
	s32d[0] = cast(int32, 7)
	s32d[1] = cast(int32, 139968)
	var bad int = 0

	var n int = -4000000
	for n < 4000000 {
		var d7 int = 7
		var dm7 int = -7
		var dbig int = 139968
		var dk int = 1000
		var d8 int = 8
		if n / d7 != hwDivS(n, ds, 0) { bad = bad + 1 }
		if n % d7 != hwRemS(n, ds, 0) { bad = bad + 1 }
		if n / dm7 != hwDivS(n, ds, 1) { bad = bad + 1 }
		if n % dm7 != hwRemS(n, ds, 1) { bad = bad + 1 }
		if n / dbig != hwDivS(n, ds, 2) { bad = bad + 1 }
		if n % dbig != hwRemS(n, ds, 2) { bad = bad + 1 }
		if n / dk != hwDivS(n, ds, 3) { bad = bad + 1 }
		if n % dk != hwRemS(n, ds, 3) { bad = bad + 1 }
		if n / d8 != hwDivS(n, ds, 4) { bad = bad + 1 }
		if n % d8 != hwRemS(n, ds, 4) { bad = bad + 1 }
		n = n + 20011
	}

	var n32 int32 = cast(int32, -2100000000)
	var k32 int = 0
	for k32 < 4200 {
		var s7 int32 = cast(int32, 7)
		var sbig int32 = cast(int32, 139968)
		if n32 / s7 != hwDivS32(n32, s32d, 0) { bad = bad + 1 }
		if n32 / sbig != hwDivS32(n32, s32d, 1) { bad = bad + 1 }
		var un32 uint32 = cast(uint32, n32)
		var u7 uint32 = cast(uint32, 7)
		var ubig uint32 = cast(uint32, 139968)
		var u8 uint32 = cast(uint32, 8)
		if un32 / u7 != hwDivU32(un32, u32d, 0) { bad = bad + 1 }
		if un32 % u7 != hwRemU32(un32, u32d, 0) { bad = bad + 1 }
		if un32 / ubig != hwDivU32(un32, u32d, 1) { bad = bad + 1 }
		if un32 % u8 != hwRemU32(un32, u32d, 2) { bad = bad + 1 }
		n32 = n32 + cast(int32, 1000003)
		k32 = k32 + 1
	}

	if bad == 0 {
		testing.Println("all match")
	} else {
		testing.Println(bad)
	}
}
