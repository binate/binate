package "main"

import "pkg/builtins/testing"

// The signed MIN / -1 overflow must trap even when the divisor is a NEGATIVE
// LITERAL, not just a runtime value (608 uses a function-returned -1). The
// literal `-1` must adopt the dividend's int32 type — otherwise it lowers at
// host int and the divide widens to 64-bit, where INT32_MIN / -1 does not
// overflow and the guard (given the host width) misses it. The dividend comes
// from a function so const-fold can't evaluate the overflow at compile time.
func i32min() int32 { return cast(int32, -2147483648) }

func main() {
	var a int32 = i32min()
	testing.Println(a / -1)
}
