package "main"

import "pkg/builtins/testing"

// Sub-word variant of 1275: int8 MIN / -1 (literal). int8 is narrower than host
// int on every target, so this specifically exercises the negative-literal
// adopting the sub-word operand type (rather than widening the divide) so the
// INT8_MIN / -1 overflow traps.
func i8min() int8 { return cast(int8, -128) }

func main() {
	var a int8 = i8min()
	testing.Println(cast(int, a / -1))
}
