package "main"

import "pkg/builtins/testing"

// An unsigned operand divided by a NEGATIVE literal is a type error: the untyped
// -1 must adopt the uint8 peer's type (13.3 same-type operands) and is not
// representable in it (6.1 const.untyped: the fit is enforced). Previously the
// checker accepted it and silently computed at signed int.
func d(x uint8) uint8 { return x / -1 }

func main() {
	testing.Println(cast(int, d(cast(uint8, 1))))
}
