package "main"

import "pkg/builtins/testing"

// A signed operand plus an OUT-OF-RANGE literal is a type error: 200 does not
// fit int8 (max 127), so the untyped literal cannot adopt the int8 peer's type.
// Accepting it silently widens to int; the comparison operators reject the
// analogous `x < 200` the same way.
func a(x int8) int8 { return x + 200 }

func main() {
	testing.Println(cast(int, a(cast(int8, 1))))
}
