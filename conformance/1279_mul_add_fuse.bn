package "main"

import "pkg/builtins/testing"

// Cross-checks the fused multiply-add / multiply-subtract lowering (OP_MADD /
// OP_MSUB, produced by the iropt fuse-mul-add pass and lowered to aa64 madd/msub,
// arm32 mla/mls, an x64 imul+add/sub expansion, a VM BC_MADD/BC_MSUB, and an LLVM
// mul+add/sub) against precomputed expected values.  Operands are read from
// slices so the whole expression cannot be constant-folded, forcing the runtime
// madd path.  `int` values fit signed 32-bit so results are identical whether
// `int` is 32- or 64-bit; int32 exercises 32-bit wrap; uint the unsigned path
// (chosen with c >= a*b so the subtract never underflows into arch-dependent
// wrap).  Prints "all match" when every case agrees.

func maddS(a int, b int, c int) int { return a * b + c }
func msubS(a int, b int, c int) int { return c - a * b }
func maddS32(a int32, b int32, c int32) int32 { return a * b + c }
func msubS32(a int32, b int32, c int32) int32 { return c - a * b }
func maddU(a uint, b uint, c uint) uint { return a * b + c }
func msubU(a uint, b uint, c uint) uint { return c - a * b }

func main() {
	var ok bool = true

	var ia @[]int = make_slice(int, 12)
	ia[0] = 3
	ia[1] = -3
	ia[2] = 3
	ia[3] = 0
	ia[4] = 9
	ia[5] = 1
	ia[6] = -1
	ia[7] = 46340
	ia[8] = 12345
	ia[9] = 100
	ia[10] = -7
	ia[11] = 2
	var ib @[]int = make_slice(int, 12)
	ib[0] = 4
	ib[1] = 4
	ib[2] = -4
	ib[3] = 9
	ib[4] = 0
	ib[5] = 1
	ib[6] = -1
	ib[7] = 46340
	ib[8] = 6789
	ib[9] = -100
	ib[10] = -8
	ib[11] = 2
	var ic @[]int = make_slice(int, 12)
	ic[0] = 5
	ic[1] = 5
	ic[2] = -5
	ic[3] = 13
	ic[4] = -13
	ic[5] = 0
	ic[6] = 0
	ic[7] = 7
	ic[8] = 1000
	ic[9] = 50
	ic[10] = -9
	ic[11] = 2
	var iem @[]int = make_slice(int, 12)
	iem[0] = 17
	iem[1] = -7
	iem[2] = -17
	iem[3] = 13
	iem[4] = -13
	iem[5] = 1
	iem[6] = 1
	iem[7] = 2147395607
	iem[8] = 83811205
	iem[9] = -9950
	iem[10] = 47
	iem[11] = 6
	var ies @[]int = make_slice(int, 12)
	ies[0] = -7
	ies[1] = 17
	ies[2] = 7
	ies[3] = 13
	ies[4] = -13
	ies[5] = -1
	ies[6] = -1
	ies[7] = -2147395593
	ies[8] = -83809205
	ies[9] = 10050
	ies[10] = -65
	ies[11] = -2
	for i := 0; i < 12; i = i + 1 {
		if maddS(ia[i], ib[i], ic[i]) != iem[i] { ok = false }
		if msubS(ia[i], ib[i], ic[i]) != ies[i] { ok = false }
	}

	var ja @[]int32 = make_slice(int32, 4)
	ja[0] = 70000
	ja[1] = -70000
	ja[2] = 46341
	ja[3] = -46341
	var jb @[]int32 = make_slice(int32, 4)
	jb[0] = 70000
	jb[1] = 70000
	jb[2] = 46341
	jb[3] = 46341
	var jc @[]int32 = make_slice(int32, 4)
	jc[0] = 3
	jc[1] = -3
	jc[2] = 0
	jc[3] = 1
	var jem @[]int32 = make_slice(int32, 4)
	jem[0] = 605032707
	jem[1] = -605032707
	jem[2] = -2147479015
	jem[3] = 2147479016
	var jes @[]int32 = make_slice(int32, 4)
	jes[0] = -605032701
	jes[1] = 605032701
	jes[2] = 2147479015
	jes[3] = -2147479014
	for i := 0; i < 4; i = i + 1 {
		if maddS32(ja[i], jb[i], jc[i]) != jem[i] { ok = false }
		if msubS32(ja[i], jb[i], jc[i]) != jes[i] { ok = false }
	}

	var ua @[]uint = make_slice(uint, 5)
	ua[0] = 3
	ua[1] = 2
	ua[2] = 0
	ua[3] = 5
	ua[4] = 255
	var ub @[]uint = make_slice(uint, 5)
	ub[0] = 4
	ub[1] = 3
	ub[2] = 7
	ub[3] = 5
	ub[4] = 1
	var uc @[]uint = make_slice(uint, 5)
	uc[0] = 20
	uc[1] = 100
	uc[2] = 42
	uc[3] = 1000
	uc[4] = 300
	var uem @[]uint = make_slice(uint, 5)
	uem[0] = 32
	uem[1] = 106
	uem[2] = 42
	uem[3] = 1025
	uem[4] = 555
	var ues @[]uint = make_slice(uint, 5)
	ues[0] = 8
	ues[1] = 94
	ues[2] = 42
	ues[3] = 975
	ues[4] = 45
	for i := 0; i < 5; i = i + 1 {
		if maddU(ua[i], ub[i], uc[i]) != uem[i] { ok = false }
		if msubU(ua[i], ub[i], uc[i]) != ues[i] { ok = false }
	}

	if ok {
		testing.Println("all match")
	} else {
		testing.Println("MISMATCH")
	}
}
