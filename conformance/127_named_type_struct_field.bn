package "main"

import "pkg/builtins/testing"

// Named (distinct) types used as struct fields must read/write correctly.
// This exercises TYP_NAMED resolution in flat memory paths.

type TokenType int

const (
	TOK_EOF TokenType = 0
	TOK_IDENT TokenType = 1
	TOK_INT TokenType = 2
	TOK_STRING TokenType = 3
)

type Token struct {
	Typ TokenType
	Val int
}

type Container struct {
	First  Token
	Second Token
}

func main() {
	// Named type in local variable
	var t Token
	t.Typ = TOK_STRING
	t.Val = 42
	testing.Println(cast(int, t.Typ))
	testing.Println(t.Val)

	// Named type in managed struct field
	var c @Container = make(Container)
	c.First.Typ = TOK_IDENT
	c.First.Val = 10
	c.Second.Typ = TOK_INT
	c.Second.Val = 20
	testing.Println(cast(int, c.First.Typ))
	testing.Println(c.First.Val)
	testing.Println(cast(int, c.Second.Typ))
	testing.Println(c.Second.Val)

	// Comparison with named type constant
	if c.First.Typ == TOK_IDENT {
		testing.Println("ident")
	}
	if c.Second.Typ == TOK_INT {
		testing.Println("int")
	}
}
