package "main"

import "pkg/builtins/testing"

// Whole-value copies of local structs OUT to non-local destinations: slice
// elements, a global, a raw-pointer target, and a nested-struct element.  At -O1+
// SROA splits such a copy into per-field stores so the local scalar-replaces;
// this checks the copied values (and that the copy is a snapshot: mutating the
// local afterwards must not change the destination) in every mode.

type P struct {
	a int32
	b int32
	c uint32
	d int
}

type Outer struct {
	k     int
	inner P
}

type Mixed struct {
	x  float64
	ok bool
	n  int
}

var gp P

// PP is a named pointer type: a copy-out through it must store every field
// (the field-ptr base carries no struct Elem, so it must not be split naively).
type PP *P

func putNamed(pp PP, v int32) {
	var s P
	s.a = v
	s.b = v * 2
	s.c = 7
	s.d = 8
	*pp = s
}

func mix(x P, y P) P {
	var m P
	m.a = x.b + y.a
	m.b = x.c32() ^ y.b
	m.c = x.c + (y.c << 1)
	m.d = x.d + y.d*3
	return m
}

func (p P) c32() int32 { return cast(int32, p.c & 0xffff) }

// put copies a freshly built local through a raw pointer.
func put(p *P, v int32) {
	var s P
	s.a = v
	s.b = v + 1
	s.c = cast(uint32, v) * 3
	s.d = cast(int, v) - 4
	*p = s
}

func show(p P) {
	testing.Println(p.a, p.b, p.c, p.d)
}

func main() {
	// Record-churn shape: element-wise rebuild with a carried struct.
	var arr @[]P = make_slice(P, 6)
	for i := 0; i < len(arr); i++ {
		var r P
		r.a = cast(int32, i*7 + 1)
		r.b = cast(int32, i*3 - 2)
		r.c = cast(uint32, i*11 + 5)
		r.d = i*i - 3
		arr[i] = r
	}
	for pass := 0; pass < 3; pass++ {
		var out @[]P = make_slice(P, len(arr))
		var carry P
		for i := 0; i < len(arr); i++ {
			var m P = mix(arr[i], carry)
			out[i] = m
			carry = m
		}
		arr = out
	}
	for i := 0; i < len(arr); i++ {
		show(arr[i])
	}

	// Copy to a global, then mutate the local: the global keeps the snapshot.
	var s P
	s.a = 10
	s.b = 20
	s.c = 30
	s.d = 40
	gp = s
	s.a = 99
	s.d = -1
	show(gp)
	show(s)

	// Copy through a raw pointer.
	var target P
	put(&target, 5)
	show(target)

	// Copy through a named pointer type.
	var named P
	putNamed(&named, 11)
	show(named)

	// A copy chain ending in a slice element; only one field is written, the
	// rest must read back as zero.
	var c1 P
	c1.b = 77
	var c2 P = c1
	var c3 P = c2
	var chain @[]P = make_slice(P, 2)
	chain[1] = c3
	show(chain[0])
	show(chain[1])

	// Nested struct copied into a slice element.
	var o Outer
	o.k = 3
	o.inner.a = 4
	o.inner.c = 6
	var outers @[]Outer = make_slice(Outer, 2)
	outers[1] = o
	o.inner.a = 100
	testing.Println(outers[1].k)
	show(outers[1].inner)

	// Float and bool fields.
	var mx Mixed
	mx.x = 2.5
	mx.n = 9
	var mixes @[]Mixed = make_slice(Mixed, 1)
	mixes[0] = mx
	mx.ok = true
	testing.Println(mixes[0].x, mixes[0].ok, mixes[0].n)

	// Conditional copy-outs from two different locals.
	var dst @[]P = make_slice(P, 4)
	for i := 0; i < len(dst); i++ {
		var even P
		even.a = cast(int32, i)
		var odd P
		odd.b = cast(int32, i*2)
		if i%2 == 0 {
			dst[i] = even
		} else {
			dst[i] = odd
		}
	}
	for i := 0; i < len(dst); i++ {
		show(dst[i])
	}
}
