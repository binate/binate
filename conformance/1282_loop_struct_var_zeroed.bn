package "main"

import "pkg/builtins/testing"

// `var s T` with no initializer declares a zero value every time it executes, so
// a struct declared inside a loop body must read back as zero on every
// iteration, not as the value left by the previous iteration.  The scalar case
// alongside is the control.

type P struct {
	a int
	b int
}

func main() {
	for i := 0; i < 3; i++ {
		var s P
		testing.Println(s.a, s.b)
		s.a = s.a + 10
		s.b = i + 1
	}
	for i := 0; i < 3; i++ {
		var n int
		testing.Println(n)
		n = n + 5
	}
}
