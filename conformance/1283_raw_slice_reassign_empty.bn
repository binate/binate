package "main"

import "pkg/builtins/testing"

// Reassigning a raw-slice local (or a raw-slice struct field) to an empty
// literal must make it empty: after `r = *[]readonly int{}`, len(r) is 0 and the
// old view is gone.  (At -O1+ SROA scalar-replaces such locals, and the empty
// literal is an all-zero whole store it must turn into per-field zeros.  The
// conformance harness compiles at -O0, so the SROA path itself is covered by the
// iropt unit tests; this pins the observable behavior in every mode.)

var backing @[]int

func three() *[]readonly int {
	backing = make_slice(int, 3)
	backing[0] = 7
	return backing
}

type Holder struct {
	k int
	r *[]readonly int
}

func main() {
	var r *[]readonly int = three()
	testing.Println(len(r), r[0])
	r = *[]readonly int{}
	testing.Println(len(r))

	var h Holder
	h.k = 1
	h.r = three()
	testing.Println(len(h.r))
	h.r = *[]readonly int{}
	testing.Println(h.k, len(h.r))
}
