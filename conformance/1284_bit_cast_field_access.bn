package "main"

import "pkg/builtins/testing"

// Field access through a pointer produced by bit_cast: directly on the
// bit_cast expression, and through a local initialized from one.  The field
// offset must come from the pointee struct's layout.

type S struct {
	a int
	b int
}

func direct(p *uint8) int {
	return bit_cast(@S, p).b
}

func viaLocal(p *uint8) int {
	var s @S = bit_cast(@S, p)
	return s.b
}

func main() {
	var s @S = make(S)
	s.a = 7
	s.b = 42
	testing.Println(direct(bit_cast(*uint8, s)))
	testing.Println(viaLocal(bit_cast(*uint8, s)))
}
