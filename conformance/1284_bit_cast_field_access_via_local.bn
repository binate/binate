package "main"

import "pkg/builtins/testing"

// Field access through a local initialized from a bit_cast pointer.  The field
// offset must come from the pointee struct's layout.  (Under bni's pass set
// load-forwarding forwards `s`, so the field access's base is the bit_cast
// itself.)

type S struct {
	a int
	b int
}

func viaLocal(p *uint8) int {
	var s @S = bit_cast(@S, p)
	return s.b
}

func main() {
	var s @S = make(S)
	s.a = 7
	s.b = 42
	testing.Println(viaLocal(bit_cast(*uint8, s)))
}
