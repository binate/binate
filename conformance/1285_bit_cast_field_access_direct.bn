package "main"

import "pkg/builtins/testing"

// Field access directly on a bit_cast expression: the field offset must come
// from the pointee struct's layout, and the bit_cast itself must still convert
// to the managed pointer type it names.

type S struct {
	a int
	b int
}

func direct(p *uint8) int {
	return bit_cast(@S, p).b
}

func main() {
	var s @S = make(S)
	s.a = 7
	s.b = 42
	testing.Println(direct(bit_cast(*uint8, s)))
}
