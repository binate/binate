package "main"

import "pkg/builtins/testing"

// Field access through values of named pointer types (`type P *S`, `type M @S`):
// the field offset comes from S's layout, reached through the named type's
// underlying pointer type — through a parameter, and through a local that the
// optimizer may forward to the value it was initialized from.

type S struct {
	a int
	b int
	c int
}

type P *S

type M @S

func viaRawParam(p P) int {
	return p.b + p.c
}

func viaManagedParam(m M) int {
	return m.c
}

func viaLocal(q *S) int {
	var p P = q
	p.a = 5
	return p.a + p.b
}

func main() {
	var s @S = make(S)
	s.a = 1
	s.b = 20
	s.c = 300
	testing.Println(viaRawParam(bit_cast(*S, s)))
	testing.Println(viaManagedParam(s))
	testing.Println(viaLocal(bit_cast(*S, s)))
	testing.Println(s.a)
}
