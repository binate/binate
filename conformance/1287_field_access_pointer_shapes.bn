package "main"

import "pkg/builtins/testing"

// Field access and whole-struct stores through pointers of every shape the
// backends must lay a field pointer out for: bit_cast results (read and write),
// named (`type P *S`, `type M @S`, `type PT *T` with `type T S`), alias
// (`type PA = *S`) and readonly pointers, nested in a struct, and in an array.
// At -O1+ SROA splits the whole-struct stores `*p = l` into per-field stores
// through the destination pointer, so the same layout rule covers those too.

type S struct {
	a int
	b int
	c int
}

type P *S

type M @S

type PA = *S

type T S

type PT *T

type Holder struct {
	x int
	p P
	m M
}

func writeViaBitCast(u *uint8) {
	bit_cast(*S, u).b = 11
	bit_cast(@S, u).c = 12
}

func copyOutNamed(p P, q PA) {
	var l S
	l.a = 100
	l.b = 200
	l.c = 300
	*p = l
	var k S
	k.a = 7
	k.b = l.b + 1
	k.c = 9
	*q = k
}

func copyOutBitCast(u *uint8) {
	var l S
	l.a = 31
	l.b = 32
	l.c = 33
	*bit_cast(*S, u) = l
}

func nested(h @Holder) int {
	return h.p.b + h.m.c
}

func viaPT(p PT) int {
	return p.c
}

func viaRO(p *readonly S) int {
	return p.b
}

func main() {
	var s @S = make(S)
	writeViaBitCast(bit_cast(*uint8, s))
	testing.Println(s.b)
	testing.Println(s.c)
	var s2 @S = make(S)
	copyOutNamed(bit_cast(*S, s), bit_cast(*S, s2))
	testing.Println(s.a + s.b + s.c)
	testing.Println(s2.a + s2.b + s2.c)
	copyOutBitCast(bit_cast(*uint8, s))
	testing.Println(s.a + s.b + s.c)
	var h @Holder = make(Holder)
	h.p = bit_cast(*S, s)
	h.m = s2
	testing.Println(nested(h))
	testing.Println(viaPT(bit_cast(PT, s)))
	testing.Println(viaRO(bit_cast(*S, s)))
	var ps [2]P
	ps[1] = bit_cast(*S, s2)
	testing.Println(ps[1].b)
	ps[1].a = 55
	testing.Println(s2.a)
}
