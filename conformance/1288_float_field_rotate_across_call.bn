package "main"

import "pkg/builtins/testing"

// Float struct-field loads whose values stay live across a call — more of them
// than there are callee-saved FP registers, so some stay in GP spill slots —
// then stored back into float fields (float64 and float32) through a pointer
// base.  Every value must land in its field; a dropped or mis-sized store shows
// up as a misplaced value.  Values are small integers so every mode prints the
// same.  localSum does the same through a local struct (fields addressed off
// the frame rather than a pointer).

type V struct {
	a float64
	b float64
	c float64
	d float64
	e float64
	f float64
	g float64
	h float64
	i float64
	j float64
	s float32
	t float32
	u float32
}

var calls int

func tick() int {
	calls = calls + 1
	return calls
}

// rotate reads every field, calls tick with all of the values live, then
// writes each value back one field over.
func rotate(p *V) {
	var a float64 = p.a
	var b float64 = p.b
	var c float64 = p.c
	var d float64 = p.d
	var e float64 = p.e
	var f float64 = p.f
	var g float64 = p.g
	var h float64 = p.h
	var i float64 = p.i
	var j float64 = p.j
	var s float32 = p.s
	var t float32 = p.t
	var u float32 = p.u
	_ = tick()
	p.a = j
	p.b = a
	p.c = b
	p.d = c
	p.e = d
	p.f = e
	p.g = f
	p.h = g
	p.i = h
	p.j = i
	p.s = u
	p.t = s
	p.u = t
}

// localSum stores float fields of a local struct, keeps them live across a
// call, and reads them back.
func localSum(x float64) float64 {
	var l V
	l.a = x
	l.b = x + 1.0
	l.s = cast(float32, x) + 2.0
	_ = tick()
	return l.a + l.b + cast(float64, l.s)
}

func show(p *V) {
	testing.Println(cast(int, p.a), cast(int, p.b), cast(int, p.c), cast(int, p.d),
		cast(int, p.e), cast(int, p.f), cast(int, p.g), cast(int, p.h),
		cast(int, p.i), cast(int, p.j), cast(int, p.s), cast(int, p.t), cast(int, p.u))
}

func main() {
	var v @V = make(V)
	v.a = 1.0
	v.b = 2.0
	v.c = 3.0
	v.d = 4.0
	v.e = 5.0
	v.f = 6.0
	v.g = 7.0
	v.h = 8.0
	v.i = 9.0
	v.j = 10.0
	v.s = 11.0
	v.t = 12.0
	v.u = 13.0
	rotate(v)
	show(v)
	rotate(v)
	show(v)
	testing.Println(cast(int, localSum(3.0)))
	testing.Println(calls)
}
