package "main"

import "pkg/builtins/testing"

// Float struct fields (float32 and float64) read and written through a pointer
// and through locals, including locals large enough that the field offset is
// past a 32-bit target's FP load/store reach (1020) and past its 12-bit integer
// load/store reach (4095), stored constants, and many values live at once.
// Results print as bit patterns so every mode prints the same.

type P struct {
	i int
	f float32
	d float64
	g float32
}

type Big struct {
	pad [300]int
	f float32
	d float64
}

type Huge struct {
	pad [1100]int
	f float32
	d float64
}

func setP(p *P, f float32, d float64) {
	p.f = f
	p.d = d
	p.g = f * 2.0
}

func sumP(p *P) float64 {
	var x float32 = p.f
	var y float64 = p.d
	var z float32 = p.g
	return y + cast(float64, x) + cast(float64, z)
}

func constStore(p *P) {
	p.f = 1.25
	p.d = 3.5
	p.g = -7.75
}

func big() {
	var b Big
	b.f = 2.5
	b.d = 6.25
	var x float32 = b.f
	var y float64 = b.d
	testing.Println(bit_cast(int32, x))
	testing.Println(bit_cast(int64, y))
	var h Huge
	h.f = x * 3.0
	h.d = y * 3.0
	var x2 float32 = h.f
	var y2 float64 = h.d
	testing.Println(bit_cast(int32, x2))
	testing.Println(bit_cast(int64, y2))
}

func manyLive(p *P, q *P) float64 {
	var a float64 = p.d
	var b float64 = q.d
	var c float32 = p.f
	var d float32 = q.f
	var e float64 = a + b
	var f float64 = a - b
	var g float64 = a * b
	var h float64 = a / b
	var i float32 = c + d
	var j float32 = c - d
	var k float32 = c * d
	var l float32 = c / d
	p.d = e
	q.d = f
	p.f = i
	q.f = j
	p.g = k
	q.g = l
	var m float64 = p.d + q.d
	return a + b + e + f + g + h + cast(float64, c + d + i + j + k + l) + m
}

func main() {
	var p P
	setP(&p, 1.5, 2.25)
	testing.Println(bit_cast(int32, p.f))
	testing.Println(bit_cast(int64, p.d))
	testing.Println(bit_cast(int32, p.g))
	testing.Println(bit_cast(int64, sumP(&p)))
	constStore(&p)
	testing.Println(bit_cast(int64, sumP(&p)))
	big()
	var q P
	setP(&q, 0.5, 4.0)
	testing.Println(bit_cast(int64, manyLive(&p, &q)))
	testing.Println(bit_cast(int64, p.d))
	testing.Println(bit_cast(int64, q.d))
	testing.Println(bit_cast(int32, p.f))
	testing.Println(bit_cast(int32, q.g))
}
