package "main"

import "pkg/builtins/testing"

// Casts, compares, and arithmetic on `readonly` scalar and pointer values —
// readonly-over-scalar, readonly-over-named, and named-over-readonly.  At -O1+
// the optimizer forwards a readonly param straight into its uses (no load in
// between), and a named-over-readonly value carries the wrapper even at -O0, so
// each lowering sees the wrapped type directly and must pick its float/int/
// pointer form and signedness from the underlying representation.  Every
// narrow readonly argument is a TYPED value (an untyped literal passed into a
// readonly-narrow param is a separate IR-gen width issue, not covered here).

type Cel float64
type RI8 readonly int8
type RF32 readonly float32

func f32ToF64(j readonly float32) float64 { return cast(float64, j) * 3.0 }
func f64ToInt(j readonly float64) int { return cast(int, j) }
func f64ToInt8(f readonly float64) int8 { return cast(int8, f) }
func f64ToF32(j readonly float64) float32 { return cast(float32, j) }
func int8ToF64(x readonly int8) float64 { return cast(float64, x) }
func celToInt(c readonly Cel) int { return cast(int, c) }
func ri8ToInt(x RI8) int { return cast(int, x) }
func rf32ToF64(x RF32) float64 { return cast(float64, x) }

func ltF64(j readonly float64, k readonly float64) bool { return j < k }
func eqF32(j readonly float32, k readonly float32) bool { return j == k }
func geCel(c readonly Cel, d readonly Cel) bool { return c >= d }
func ltInt8(x readonly int8, y readonly int8) bool { return x < y }
func ltRI8(x RI8, y RI8) bool { return x < y }
func ltRF32(x RF32, y RF32) bool { return x < y }

func negF64(j readonly float64) float64 { return -j }
func mulAddF64(j readonly float64, k readonly float64) float64 { return j * k + j }
func shr8(x readonly int8, n int) int8 { return x >> n }
func div(x readonly int, y readonly int) int { return x / y }
func rem(x readonly int, y readonly int) int { return x % y }

func toMut(p readonly *int) *int { return cast(*int, p) }
func toRO(p readonly *int) *readonly int { return cast(*readonly int, p) }
func isNil(p readonly *int) bool { return p == nil }
func samePtr(p readonly *int, q readonly *int) bool { return p == q }

func main() {
	var a float32 = 11250.0
	var one32 float32 = 1.0
	var b float64 = -7.5
	var m3 float64 = -3.0
	var h float64 = 2.5
	var c Cel = 36.6
	var c2 Cel = 40.0
	var n5 int8 = -5
	var n1 int8 = -1
	var p1 int8 = 1
	var n64 int8 = -64
	var r3 RI8 = cast(RI8, n5)
	var rp RI8 = cast(RI8, p1)
	var f15 float32 = 1.5
	var rf RF32 = cast(RF32, f15)
	var rfn RF32 = cast(RF32, one32)
	var lo float64 = 1.0
	var mid float64 = 1.5
	var hi float64 = 2.0
	var three float64 = 3.0
	var n7 int = -7
	var two int = 2

	testing.Println(cast(int, f32ToF64(a)), f64ToInt(b), cast(int, f64ToInt8(m3)))
	testing.Println(cast(int, f64ToF32(h) * 10.0), cast(int, int8ToF64(n5)), celToInt(c))
	testing.Println(ri8ToInt(r3), cast(int, rf32ToF64(rf) * 10.0))
	testing.Println(ltF64(lo, mid), ltF64(hi, mid), eqF32(one32, one32), eqF32(a, one32))
	testing.Println(geCel(c, c), geCel(c, c2), ltInt8(n1, p1), ltInt8(p1, n1))
	testing.Println(ltRI8(r3, rp), ltRI8(rp, r3), ltRF32(rfn, rf), ltRF32(rf, rfn))
	testing.Println(cast(int, negF64(h) * 10.0), cast(int, mulAddF64(three, three)))
	testing.Println(cast(int, shr8(n64, 2)), div(n7, two), rem(n7, two))

	var x int = 42
	var px *int = &x
	var ro *readonly int = toRO(px)
	testing.Println(*toMut(px), *ro, isNil(px), isNil(nil), samePtr(px, px))
}
