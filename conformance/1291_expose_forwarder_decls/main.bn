package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/fwd"
import "pkg/fwd2"

// Declarations in THIS package that name pkg/home's members only through `expose`
// forwarders (fwd exposes pkg/home; fwd2 exposes fwd).  A forwarder has no members of
// its own, so each declaration must key on the HOME member exactly as if it had been
// spelled home.X: an impl registers its vtable under the home interface, an
// extension clause and an alias target name the home interface, an impl receiver
// names the home type, and a method value on a forwarder-spelled generic call binds
// the home generic's method.  Keying any of them on the forwarder's path instead
// leaves a vtable unregistered or a parent unfound — a build failure, a nil-vtable
// dispatch, or a type assertion that misses.

// An impl whose interface is spelled through two forwarders keys on home.I.
type R1 struct {
	n int
}

func (r *R1) Val() int {
	return r.n
}

impl *R1 : fwd2.I

// An impl of an instantiated generic interface spelled through a forwarder keys on
// home.GI[int].
type R2 struct {
	n int
}

func (r *R2) Get() int {
	return r.n
}

impl *R2 : fwd.GI[int]

// A local interface extending a forwarder-spelled interface has home.I as its
// parent, so a *Sub upcasts to the home interface.
interface Sub : fwd.I {
	Extra() int
}

type R3 struct {
	n int
}

func (r *R3) Val() int {
	return r.n
}

func (r *R3) Extra() int {
	return r.n + 100
}

impl *R3 : Sub

// Likewise for a generic parent spelled through two forwarders.
interface GSub : fwd2.GI[int] {
	More() int
}

type R4 struct {
	n int
}

func (r *R4) Get() int {
	return r.n
}

func (r *R4) More() int {
	return r.n + 200
}

impl *R4 : GSub

// An interface alias whose target is spelled through two forwarders IS home.I, so
// an impl of the alias satisfies home.I under every spelling.
interface A = fwd2.I

type R5 struct {
	n int
}

func (r *R5) Val() int {
	return r.n
}

impl *R5 : A

// An impl whose RECEIVER is spelled through a forwarder is an impl for home.S.
interface Local {
	Label() int
}

impl *fwd.S : Local

// useLocal constructs a managed home.S (which owns a managed name) as a @Local,
// dispatches through it, and recovers the concrete *fwd.S by type assertion.  When
// the last reference drops, S's destructor must release name as well.
func useLocal(width int, n int) (int, bool, int) {
	var s @fwd.S = fwd.MakeS(width, n)
	var l @Local = s
	var got int = l.Label()
	p, ok := l.(*fwd.S)
	var back int = 0
	if ok {
		back = p.Label()
	}
	return got, ok, back
}

// useMethodValue binds a method value on the result of a forwarder-spelled generic
// call; the method value captures (and later releases) the returned @Box.
func useMethodValue(n int) int {
	var f *func() int = fwd.New[int](n).Len
	var g *func() int = fwd2.New[int](n + 1).Len
	return f() * 10 + g()
}

func main() {
	var r1 R1 = R1{n: 1}
	var i1 *fwd.I = &r1
	testing.Println(i1.Val()) // 1

	var r2 R2 = R2{n: 2}
	var g2 *fwd2.GI[int] = &r2
	testing.Println(g2.Get()) // 2

	var r3 R3 = R3{n: 3}
	var s3 *Sub = &r3
	testing.Println(s3.Val())   // 3
	testing.Println(s3.Extra()) // 103
	var i3 *fwd.I = s3
	testing.Println(i3.Val()) // 3

	var r4 R4 = R4{n: 4}
	var s4 *GSub = &r4
	testing.Println(s4.Get())  // 4
	testing.Println(s4.More()) // 204
	var g4 *fwd.GI[int] = s4
	testing.Println(g4.Get()) // 4

	var r5 R5 = R5{n: 5}
	var a5 *A = &r5
	testing.Println(a5.Val()) // 5
	var i5 *fwd.I = a5
	testing.Println(i5.Val()) // 5

	// The first calls also settle any first-use bookkeeping before the live-block
	// baselines are taken.
	got, ok, back := useLocal(2, 6)
	testing.Println(got)  // 26
	testing.Println(ok)   // true
	testing.Println(back) // 26
	testing.Println(useMethodValue(3)) // 34

	var base int = rt.LiveBlocks()
	for i := 0; i < 4; i++ {
		useLocal(2, i)
	}
	testing.Println(rt.LiveBlocks() - base) // 0: every S and its name released

	base = rt.LiveBlocks()
	for i := 0; i < 4; i++ {
		useMethodValue(i)
	}
	testing.Println(rt.LiveBlocks() - base) // 0: every captured @Box released
}
