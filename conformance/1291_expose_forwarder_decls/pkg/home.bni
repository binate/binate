package "pkg/home"

// A non-generic interface.
interface I {
	Val() int
}

// A generic interface.
interface GI[T any] {
	Get() T
}

// A struct with a managed field: a managed S owns a second allocation (name) that
// its destructor must release.
type S struct {
	name @[]char
	n    int
}

func MakeS(width int, n int) @S

func (s *S) Label() int

// A generic type with a managed-receiver method, so a method value on a call
// result captures (and keeps alive) the managed pointer the call returned.
type Box[T any] struct {
	v T
	n int
}

func (b @Box[T]) Len() int {
	return b.n
}

func New[T any](n int) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.n = n
	return b
}
