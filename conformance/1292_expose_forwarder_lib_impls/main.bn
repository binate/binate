package "main"
import "pkg/builtins/testing"

import "pkg/home"
import "pkg/lib"
import "pkg/user"
import fwd "pkg/decoy"

// Impls declared in an IMPORTED library's .bni through an `expose` forwarder.
// pkg/fwd is a pure forwarder (`expose "pkg/home"`).  pkg/lib imports it and
// declares `impl *L : fwd.I, fwd.GI[int]` and `impl *fwd.S : Summer`, so each
// impl names pkg/home's interface or receiver through the forwarder spelling.
// Every such impl must key on the HOME identity (pkg/home's I, GI[int], S):
//   - in pkg/lib's own TU, which emits the vtables and builds, dispatches and
//     asserts interface values itself (AsI, AsGI, SummerOf, Total, IsI);
//   - in each consumer that collects pkg/lib's impls to name those vtables and
//     answer type assertions: main, which does not import pkg/fwd and binds the
//     alias `fwd` to the unrelated pkg/decoy (so pkg/lib's `fwd.` refs resolve
//     only against pkg/lib's own imports), and pkg/user, which imports pkg/fwd
//     and spells every pkg/home member through it.
func main() {
	testing.Println(fwd.Tag()) // 7  (pkg/decoy, not the forwarder)
	var l lib.L = lib.MkL(1)

	// Upcasts built here, dispatching through the library-declared impls.
	var i *home.I = &l
	testing.Println(i.Val()) // 101
	var g *home.GI[int] = &l
	testing.Println(g.Get()) // 201
	var s home.S = home.MkS(2, 3)
	var x *lib.Summer = &s
	testing.Println(x.Sum()) // 5

	// Interface values built inside the library, used here as home interfaces.
	var i2 *home.I = lib.AsI(&l)
	testing.Println(i2.Val()) // 101
	var g2 *home.GI[int] = lib.AsGI(&l)
	testing.Println(g2.Get()) // 201
	testing.Println(lib.Total(&s)) // 1005
	testing.Println(lib.Total(lib.SummerOf(&s))) // 1005

	// Type assertions resolved through the same impls.
	var a *any = &l
	ai, ok := a.(*home.I)
	testing.Println(ok)       // true
	testing.Println(ai.Val()) // 101
	ag, ok2 := a.(*home.GI[int])
	testing.Println(ok2)      // true
	testing.Println(ag.Get()) // 201
	lp, ok3 := i.(*lib.L)
	testing.Println(ok3)      // true
	testing.Println(lp.Get()) // 201
	var b *any = &s
	bs, ok4 := b.(*lib.Summer)
	testing.Println(ok4)      // true
	testing.Println(bs.Sum()) // 5
	testing.Println(lib.IsI(a)) // true
	testing.Println(lib.IsI(b)) // false

	// A second consumer that reaches pkg/home only through pkg/fwd.
	user.Run(&l)
}
