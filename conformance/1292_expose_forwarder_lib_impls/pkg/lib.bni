package "pkg/lib"

import "pkg/fwd"

type L struct {
	n int
}

func (l *L) Val() int
func (l *L) Get() int

// Both interfaces are pkg/home's, named through the forwarder spelling.
impl *L : fwd.I, fwd.GI[int]

interface Summer {
	Sum() int
}

// The receiver is pkg/home's S, named through the forwarder spelling.
impl *fwd.S : Summer

func MkL(n int) L

// Interface values built, dispatched and asserted inside this package.
func AsI(l *L) *fwd.I
func AsGI(l *L) *fwd.GI[int]
func SummerOf(s *fwd.S) *Summer
func Total(x *Summer) int
func IsI(a *any) bool
