package "pkg/lib"

import "pkg/fwd"

func (l *L) Val() int {
	return l.n + 100
}

func (l *L) Get() int {
	return l.n + 200
}

func MkL(n int) L {
	return L{n: n}
}

func AsI(l *L) *fwd.I {
	return l
}

func AsGI(l *L) *fwd.GI[int] {
	return l
}

func SummerOf(s *fwd.S) *Summer {
	return s
}

func Total(x *Summer) int {
	return x.Sum() + 1000
}

func IsI(a *any) bool {
	_, ok := a.(*fwd.I)
	return ok
}
