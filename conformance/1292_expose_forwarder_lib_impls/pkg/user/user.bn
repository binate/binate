package "pkg/user"

import "pkg/builtins/testing"
import "pkg/fwd"
import "pkg/lib"

func Run(l *lib.L) {
	var i *fwd.I = l
	testing.Println(i.Val()) // 101
	var g *fwd.GI[int] = l
	testing.Println(g.Get()) // 201
	var s fwd.S = fwd.MkS(4, 5)
	var x *lib.Summer = &s
	testing.Println(x.Sum()) // 9

	var a *any = l
	ai, ok := a.(*fwd.I)
	testing.Println(ok)       // true
	testing.Println(ai.Val()) // 101
	ag, ok2 := a.(*fwd.GI[int])
	testing.Println(ok2)      // true
	testing.Println(ag.Get()) // 201
	var b *any = &s
	bs, ok3 := b.(*lib.Summer)
	testing.Println(ok3)      // true
	testing.Println(bs.Sum()) // 9
}
