package "main"
import "pkg/builtins/testing"

import "pkg/glib"

// A library's GENERIC bodies reach pkg/home only through the `expose` forwarder
// pkg/fwd, and main imports neither pkg/fwd nor pkg/home: each instantiation is
// monomorphized into main's module, so main must still declare the HOME funcs
// and wire the HOME impls the bodies use, walking the forwarder's expose closure.
//
// PtSum: fwd.MakePt returns the struct fwd.Pt BY VALUE; the call must bind to the
// home func's extern declaration with its real (aggregate) signature.
// SqArea: a home-returned @Sq upcast to *fwd.Shape, dispatched both in the
// generic body and inside a home func taking *fwd.Shape.
// LitArea: no home func is called at all, so the upcast of a locally built fwd.Sq
// depends only on the home impl *Sq : Shape having its vtable in main's module.
// Two instantiations (T = int, T = bool) cover separate monomorphized copies.
func main() {
	testing.Println(glib.PtSum[int](0, 3, 4))       // 304
	testing.Println(glib.PtSum[bool](true, 12, 34)) // 1234
	testing.Println(glib.SqArea[int](0, 5))         // 25050
	testing.Println(glib.SqArea[bool](false, 3))    // 9018
	testing.Println(glib.LitArea[int](0, 6))        // 36
	testing.Println(glib.LitArea[bool](true, 7))    // 49
}
