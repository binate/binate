package "pkg/glib"

import "pkg/fwd"

func PtSum[T any](tag T, x int, y int) int {
	var p fwd.Pt = fwd.MakePt(x, y)
	return p.X*100 + p.Y
}

func SqArea[T any](tag T, side int) int {
	var sq @fwd.Sq = fwd.NewSq(side)
	var s *fwd.Shape = sq
	return s.Area()*1000 + fwd.Twice(s)
}

func LitArea[T any](tag T, side int) int {
	var sq fwd.Sq = fwd.Sq{side: side}
	var s *fwd.Shape = &sq
	return s.Area()
}
