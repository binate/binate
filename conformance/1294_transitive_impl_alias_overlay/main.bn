package "main"
import "pkg/builtins/testing"

import "pkg/genlib"
import "pkg/other/dep"

// An impl declared in a TRANSITIVELY-imported package must key on the interface
// that package's OWN imports name.  genlib's generic bodies are monomorphized in
// this TU and upcast a @mid.M / @far.F to interfaces; main imports neither mid nor
// far, so the (receiver, interface) vtable rows come from their .bni impl decls,
// and each impl's interface qualifier must resolve against the declaring file's
// import aliases, never main's:
//   - far writes `impl *F : shape.Area` / `shape.Sized[int]`; main binds no `shape`.
//   - mid writes `impl *M : dep.Namer` / `dep.Getter[int]` meaning pkg/dep, while
//     main binds `dep` to pkg/other/dep, which declares same-named interfaces.
//   - mid writes `impl *M : Holder[Loc]`: the unqualified Holder and Loc are mid's.
// Keyed on the wrong (or an unresolved) interface package, the upcast finds no
// vtable.  main's own `dep` must still name pkg/other/dep afterwards.
func main() {
	testing.Println(genlib.MidScore[int](5))   // Name 6 * 100 + Get 7
	testing.Println(genlib.FarScore[int](3, 4)) // Area 12 * 100 + Size 7
	testing.Println(genlib.LocScore[int](4))    // Hold 7
	var k @dep.K = dep.NewK(1)
	testing.Println(dep.Sum(k, k)) // Name 10 + Get 20
}
