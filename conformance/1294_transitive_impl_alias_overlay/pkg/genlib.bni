package "pkg/genlib"

import "pkg/dep"
import "pkg/far"
import "pkg/mid"
import "pkg/shape"

// MidScore upcasts a pkg/mid value to pkg/dep's Namer and Getter[int].  The
// body is monomorphized in the caller's TU, so the upcasts there need the
// vtable rows of mid's impls, which the caller does not import.
func MidScore[T any](x int) int {
	var m @mid.M = mid.NewM(x)
	var n @dep.Namer = m
	var g @dep.Getter[int] = m
	return n.Name() * 100 + g.Get()
}

// FarScore upcasts a pkg/far value to pkg/shape's Area and Sized[int].
func FarScore[T any](w int, h int) int {
	var f @far.F = far.NewF(w, h)
	var a @shape.Area = f
	var s @shape.Sized[int] = f
	return a.Area() * 100 + s.Size()
}

// LocScore upcasts a pkg/mid value to mid's own Holder[Loc], whose impl names the
// type argument unqualified in mid's .bni.
func LocScore[T any](x int) int {
	var m @mid.M = mid.NewM(x)
	var h @mid.Holder[mid.Loc] = m
	var l mid.Loc = h.Hold()
	return l.V
}
