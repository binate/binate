package "pkg/mid"

import "pkg/dep"

type M struct { n int }

func (m *M) Name() int
func (m *M) Get() int

// `dep` here is pkg/dep (this file's import), whatever an importer of an
// importer binds `dep` to.
impl *M : dep.Namer
impl *M : dep.Getter[int]

type Loc struct { V int }

// Holder is mid's own generic interface; the impl below names the type argument
// Loc unqualified, so it means pkg/mid's Loc.
interface Holder[T any] {
	Hold() T
}

func (m *M) Hold() Loc

impl *M : Holder[Loc]

func NewM(n int) @M
