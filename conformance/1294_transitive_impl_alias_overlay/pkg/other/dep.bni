package "pkg/other/dep"

// A DIFFERENT package sharing pkg/dep's last path segment, and declaring
// same-named interfaces, so an importer's alias `dep` binds here instead.

interface Namer {
	Name() int
}

interface Getter[T any] {
	Get() T
}

type K struct { n int }

func (k *K) Name() int
func (k *K) Get() int

impl *K : Namer
impl *K : Getter[int]

func NewK(n int) @K

// Sum dispatches through this package's own Namer and Getter[int].
func Sum(n @Namer, g @Getter[int]) int
