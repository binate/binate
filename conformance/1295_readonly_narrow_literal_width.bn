package "main"

import "pkg/builtins/testing"

// Untyped constants flowing into readonly-wrapped NARROW destinations — call
// args, var inits, returns, struct fields, array elements — through readonly,
// an alias of readonly, and named-over-readonly types.  Each constant must be
// narrowed to the wrapped scalar's width (a float32 slot gets a float32, an
// int8 slot an int8); read unpeeled, a wrapper has no width of its own and the
// constant would be stored at 64 bits (a double into a float slot).

type RF = readonly float32
type R readonly int8
type RF32 readonly float32

type S struct {
	f readonly float32
	i readonly int16
}

func ro(x readonly float32) float64 { return cast(float64, x) }
func ra(x RF) float64 { return cast(float64, x) }
func rn(x RF32) float64 { return cast(float64, x) }
func rou(x readonly float32) uint { return cast(uint, x) }
func ri8(x readonly int8) int { return cast(int, x) }
func ri16(x readonly int16, y readonly int16) int { return cast(int, x) + cast(int, y) }
func rr(x R) int { return cast(int, x) }
func eqF32(j readonly float32, k readonly float32) bool { return j == k }
func ltI8(x readonly int8, y readonly int8) bool { return x < y }
func shr8(x readonly int8, n int) int8 { return x >> n }
func rdiv(x R, y R) R { return x / y }
func retF() readonly float32 { return 2.5 }
func retI() readonly int8 { return -100 }

func main() {
	testing.Println(cast(int, ro(2.5) * 10.0), cast(int, ra(2.5) * 10.0), cast(int, rn(2.5) * 10.0), rou(3.9))
	testing.Println(ri8(-5), ri16(-300, 1000), rr(cast(R, -7)), eqF32(1.0, 1.0), ltI8(-1, 1), ltI8(1, -1))
	testing.Println(cast(int, shr8(-64, 2)), cast(int, rdiv(cast(R, -7), cast(R, 2))), rr(rdiv(cast(R, -128), cast(R, 2))))

	var v readonly float32 = 2.5
	var w readonly int8 = -3
	testing.Println(cast(int, cast(float64, v) * 10.0), cast(int, w))
	testing.Println(cast(int, cast(float64, retF()) * 10.0), cast(int, retI()))

	var s S = S{f: 2.5, i: -300}
	var a [2]readonly float32 = [2]readonly float32{1.5, 2.5}
	testing.Println(cast(int, cast(float64, s.f) * 10.0), cast(int, s.i), cast(int, cast(float64, a[0]) * 10.0), cast(int, cast(float64, a[1]) * 10.0))
}
