package "main"

import "pkg/builtins/testing"

// Named-over-readonly variant of 1276: `type R readonly int8`, MIN / -1.  The
// divide-overflow guard must see R's true width (8) and signedness through
// both wrappers, so INT8_MIN / -1 traps rather than wrapping to -128.

type R readonly int8

func rdiv(x R, y R) R { return x / y }

func main() {
	var m int8 = -128
	var n int8 = -1
	testing.Println(cast(int, rdiv(cast(R, m), cast(R, n))))
}
