package "main"

import "pkg/builtins/testing"

// Closures capturing managed values through a wrapper — a readonly local or
// param, a named managed type.  The capture must be
// retained (RefInc) to balance the RefDec the closure's dtor runs; an
// under-retained capture is freed while still referenced, so a later read
// sees freed (reused) memory.

type Box struct {
	v int
}

type MB @Box

func use(f *func() int) int { return f() }

func mkNamed(n int) @func() int {
	var b MB = make(Box)
	b.v = n
	return func() int { return b.v }
}

func viaReadonlyParam(b readonly @Box) int {
	var f *func() int = func() int { return b.v }
	return f()
}

func main() {
	var b @Box = make(Box)
	b.v = 42
	for i := 0; i < 3; i++ {
		var rb readonly @Box = b
		var f *func() int = func() int { return rb.v }
		testing.Println(use(f))
	}
	testing.Println(viaReadonlyParam(b), viaReadonlyParam(b))

	var s @[]int = make_slice(int, 2)
	s[1] = 9
	for i := 0; i < 2; i++ {
		var rs readonly @[]int = s
		var f *func() int = func() int { return rs[1] }
		testing.Println(use(f))
	}

	var g @func() int = mkNamed(21)
	var h @func() int = mkNamed(5)
	testing.Println(g(), h())
	for i := 0; i < 2; i++ {
		var rg readonly @func() int = g
		var f *func() int = func() int { return rg() }
		testing.Println(use(f))
	}

	var other @Box = make(Box)
	other.v = 1
	testing.Println(b.v, s[1], g())
}
