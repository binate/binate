package "main"

import "pkg/builtins/testing"

// A `var` whose type is inferred from its initializer (`var q = P{...}`) has the
// initializer's type — a struct or array VALUE, never a pointer to the
// initializer's temporary storage — exactly as `var q P = P{...}` and
// `q := P{...}` do.  Covers locals and package-level vars initialized from a
// composite literal, a call result, and a copy of another variable (the copy
// must not alias the original).

type P struct {
	X int
	Y int
}

type Q struct {
	In P
	Z  int
}

var gp P = P{X: 7, Y: 8}

// A package-level var whose type is inferred from a composite literal.
var gq = P{X: 3, Y: 4}

// A package-level var inferred from a call result and from a copy of a global.
var gr = mk(9)
var gcopy = gp

// A generic struct instantiation, as a package-level var's composite literal.
type Box[T any] struct {
	V T
}

var gbox = Box[int]{V: 3}

// Named owns a managed field, so the inferred var must adopt the literal's storage
// (released once at scope end), not alias it or release it twice.
type Named struct {
	Name @[]char
	N    int
}

func (p *P) Inc() {
	p.X = p.X + 1
}

func inc(p *P) {
	p.X = p.X + 1
}

func mk(x int) P {
	return P{X: x, Y: x}
}

func sum(p P) int {
	return p.X + p.Y
}

func main() {
	var q = P{X: 1, Y: 2}
	inc(&q)
	testing.Println(q.X) // 2
	q.Inc()
	testing.Println(q.X) // 3
	P.Inc(&q)
	testing.Println(q.X)   // 4
	testing.Println(sum(q)) // 6
	var a = [3]int{1, 2, 3}
	a[0] = 10
	testing.Println(a[0] + a[1] + a[2]) // 15
	var r = mk(5)
	r.Inc()
	testing.Println(r.X) // 6
	var c = q
	c.X = 100
	testing.Println(q.X) // 4 (c is a copy)
	var g = gp
	g.X = 99
	testing.Println(gp.X) // 7 (g is a copy)
	var w = Q{In: P{X: 1, Y: 1}, Z: 2}
	var inner = w.In
	inner.X = 50
	testing.Println(w.In.X) // 1 (inner is a copy)
	testing.Println(inner.X + w.Z) // 52
	gq.Inc()
	testing.Println(gq.X + gq.Y) // 8
	var nm = Named{Name: "abc", N: 2}
	nm.N = nm.N + len(nm.Name)
	testing.Println(nm.N) // 5
	gcopy.X = 40
	testing.Println(gp.X + gcopy.X + gr.X + gr.Y) // 65
	gbox.V = gbox.V + 4
	testing.Println(gbox.V) // 7
	addrOf()
}

// An inferred var (or :=) initialized with an ADDRESS is a pointer to the
// original, never a copy of it.
func addrOf() {
	var p P = P{X: 1, Y: 2}
	var q = &p
	q.X = 5
	var r = q
	r.X = r.X + 1
	testing.Println(p.X) // 6
	var arr [2]int = [2]int{1, 2}
	var pa = &arr
	(*pa)[0] = 10
	testing.Println(arr[0]) // 10
	var z = &P{X: 3, Y: 4}
	z.Inc()
	testing.Println(z.X) // 4
	s := &p
	s.X = 9
	testing.Println(p.X) // 9
}
