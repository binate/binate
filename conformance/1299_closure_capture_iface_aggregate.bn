package "main"

import "pkg/builtins/testing"

// Closures capturing a managed interface value, and a by-value struct / array
// with managed fields, called repeatedly.  The closure owns its captures
// (copied in at creation, destroyed with the closure), and each CALL borrows
// them: the call's cleanup must not release the closure's own references.
// An over-release frees the captured object while still referenced, so a
// later read sees freed (reused) memory.

type Box struct {
	v int
}

type S struct {
	b @Box
	k int
}

interface Getter {
	Get() int
}

type G struct {
	v int
}

func (g @G) Get() int { return g.v }

impl @G : Getter

func use(f *func() int) int { return f() }

func mkIface(n int) @func() int {
	var g @G = make(G)
	g.v = n
	var gi @Getter = g
	return func() int { return gi.Get() }
}

func mkStruct(n int) @func() int {
	var s S
	s.b = make(Box)
	s.b.v = n
	return func() int { return s.b.v }
}

func main() {
	var mg @G = make(G)
	mg.v = 7
	var gi @Getter = mg
	for i := 0; i < 3; i++ {
		var f *func() int = func() int { return gi.Get() }
		testing.Println(use(f))
	}

	var s S
	s.b = make(Box)
	s.b.v = 42
	for i := 0; i < 3; i++ {
		var f *func() int = func() int { return s.b.v }
		testing.Println(use(f))
	}

	var a [2]@Box
	a[0] = make(Box)
	a[0].v = 5
	for i := 0; i < 3; i++ {
		var f *func() int = func() int { return a[0].v }
		testing.Println(use(f))
	}

	var fi @func() int = mkIface(11)
	var fs @func() int = mkStruct(13)
	testing.Println(fi(), fi(), fs(), fs())

	var o1 @Box = make(Box)
	o1.v = 1
	var o2 @G = make(G)
	o2.v = 2
	testing.Println(gi.Get(), s.b.v, a[0].v, fi(), fs())
}
