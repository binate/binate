package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// rt.MemZero with a negative size aborts the process with its panic message (the
// rt.bni precondition size >= 0) instead of returning as a no-op — the same message
// on every target, whether the portable body or a hand-written one runs.
func main() {
	var p *uint8 = rt.RawAlloc(16)
	testing.Println(1)
	rt.MemZero(p, -1)
	testing.Println(2)
	rt.RawFree(p)
}
