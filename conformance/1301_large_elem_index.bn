package "main"

import "pkg/builtins/testing"

// Indexing an array whose element size is larger than 0xFFFF and not a power of
// two: the byte offset idx * 70001 needs the full element size, so writing
// element 1 must not land inside element 0 (70001 & 0xFFFF = 4465 is where a
// 16-bit size would put it).
type Big struct {
	a [70001]uint8
}

var g [3]Big

func set(i int, off int, v uint8) {
	g[i].a[off] = v
}

func get(i int, off int) int {
	return cast(int, g[i].a[off])
}

func main() {
	set(1, 0, 7)
	set(2, 70000, 9)
	testing.Println(get(0, 4465))
	testing.Println(get(1, 0))
	testing.Println(get(1, 70000))
	testing.Println(get(2, 70000))
	var local [2]Big
	var j int = 1
	local[j].a[3] = 5
	testing.Println(cast(int, local[0].a[4468]))
	testing.Println(cast(int, local[1].a[3]))
}
