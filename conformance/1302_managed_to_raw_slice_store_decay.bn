package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A managed slice (@[]T) stored into a raw-slice (*[]T) slot decays to the
// {data, len} it holds.  Every store position must decay — declaration,
// assignment, parallel assignment, struct field (literal and assignment),
// array / slice element, pointer target, array / slice literal element,
// multi-assign component, and cast — including through named / readonly
// wrappers on either side.  Storing the 4-word managed slice itself would
// overwrite what follows the 2-word raw slot, so each raw slot here is
// followed by something that must survive (a struct field, the next element).
// A multi-assign raw target (`*[]T` or `*T`) borrows the component, so it must
// not be retained: the managed object's refcount must not grow.

type RBuf *[]int
type MB @[]int

type S struct {
	r *[]int
	n int
}

type NS struct {
	r RBuf
	n int
}

var G @[]int

func pair() (@[]int, int) { return G, 5 }

type T struct {
	v int
}

var GT @T

func retT() (@T, int) { return GT, 1 }

func sum(r *[]int) int {
	var t int = 0
	for i := 0; i < len(r); i++ {
		t = t + r[i]
	}
	return t
}

func main() {
	G = make_slice(int, 3)
	G[0] = 1
	G[1] = 2
	G[2] = 3
	var m @[]int = G
	var mb MB = G

	var d1 RBuf = m
	var d2 readonly *[]int = m
	var d3 *[]int = mb
	testing.Println(sum(d1), sum(d2), sum(d3))

	var a1 *[]int
	var a2 RBuf
	a1 = mb
	a2 = m
	testing.Println(sum(a1), sum(a2))

	var p1 RBuf
	var p2 *[]int
	p1, p2 = m, mb
	testing.Println(sum(p1), sum(p2))

	var s S = S{r: m, n: 77}
	var ns NS = NS{r: m, n: 88}
	ns.r = m
	testing.Println(sum(s.r), s.n, sum(ns.r), ns.n)

	var arr [3]*[]int
	arr[0] = m
	var es @[]*[]int = make_slice(*[]int, 3)
	es[0] = mb
	var slot *[]int
	var ps **[]int = &slot
	*ps = m
	testing.Println(sum(arr[0]), len(arr[1]), sum(es[0]), len(es[1]), sum(slot))

	var la [2]*[]int = [2]*[]int{m, mb}
	var ls @[]*[]int = @[]*[]int{mb, m}
	testing.Println(sum(la[0]), sum(la[1]), sum(ls[0]), sum(ls[1]))

	var mr *[]int
	var k int
	mr, k = pair()
	var c RBuf = cast(RBuf, m)
	testing.Println(sum(mr), k, sum(c))

	GT = make(T)
	GT.v = 9
	var before int = rt.Refcount(bit_cast(*uint8, GT))
	var pt *T
	for i := 0; i < 5; i++ {
		pt, k = retT()
		mr, k = pair()
	}
	testing.Println(pt.v, sum(mr), rt.Refcount(bit_cast(*uint8, GT)) - before)
}
