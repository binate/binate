package "lib"

// This package's own import path is `lib`, yet within this file `lib` names
// pkg/other/lib (its import): G returns pkg/other/lib's T, while this package's
// own T and F keep this package's identity.
import "pkg/other/lib"

// T is this local package's T — a different type from pkg/other/lib's T.
type T struct { X int }

func F() int

func G(a int) lib.T
