package "main"

import "pkg/builtins/testing"
import L "lib"
import "pkg/a"
import "pkg/other/lib"

// Every file's import aliases are its own: pkg/a's `lib` (in pkg/a.bni) and this
// file's `lib` both mean pkg/other/lib, although this program also imports the
// local single-segment package "lib" (as L) — whose import path is itself `lib`.
// A reference must never bind to the other package: pkg/a.Make's result type,
// pkg/a's impl of lib.Box[int], and this file's own impl below all name
// pkg/other/lib — and package "lib" itself, whose own file imports
// pkg/other/lib, keeps its own identity for its own T and F while its G returns
// pkg/other/lib's T.

type M struct {
	n int
}

func (m *M) Get() int {
	return m.n * 2
}

impl *M : lib.Box[int]

func main() {
	var t lib.T = a.Make(1, 20, 300)
	testing.Println(t.A + t.B + t.C) // 321
	var b @lib.Box[int] = a.NewA(5)
	testing.Println(b.Get()) // 5
	var m M = M{n: 21}
	var mb *lib.Box[int] = &m
	testing.Println(mb.Get()) // 42
	var l L.T = L.T{X: L.F()}
	testing.Println(l.X) // 1000
	var g lib.T = L.G(77)
	testing.Println(g.A + g.B + g.C) // 80
}
