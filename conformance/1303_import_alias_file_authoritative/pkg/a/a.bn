package "pkg/a"

// This file names pkg/other/lib's T, so it imports it itself: the .bni's import
// is the .bni's own.
import "pkg/other/lib"

func (a *A) Get() int { return a.n }

func NewA(n int) @A {
	var x @A = make(A)
	x.n = n
	return x
}

func Make(a int, b int, c int) lib.T {
	return lib.T{A: a, B: b, C: c}
}
