package "main"

import "pkg/builtins/testing"
import "pkg/shape"

// A deferred call of a method on an IMPORTED interface value resolves the
// interface through the importer's alias for its package, like the direct call.

func measure(s *shape.Shape) int {
	defer s.Area()
	testing.Println(0)
	return s.Area() + 100
}

func main() {
	var sq @shape.Sq = shape.NewSq(3)
	var s @shape.Shape = sq
	testing.Println(measure(s))
}
