package "main"

import "pkg/builtins/testing"

// An untyped integer constant operand -- a literal, a negated literal, a
// parenthesized constant expression, or an untyped const name, on either side --
// takes its typed peer's type (spec const.untyped.coercion): the operation runs
// at the peer's width and its result wraps there.  Each result is printed through
// cast(int64, ...), so a value computed at a wider type and never narrowed to the
// function's result type would show.

const NEG16 = -30000
const MASK16 = 0 - 256
const NEG8 = -100

func negLitLeftSub16(x int16) int16 { return -30000 - x }
func negLitLeftAdd8(x int8) int8 { return -100 + x }
func negLitLeftDiv32(x int32) int32 { return -2000000000 / x }
func negLitLeftMul16(x int16) int16 { return -300 * x }
func parenLeftSub16(x int16) int16 { return (0 - 30000) - x }
func parenLeftAnd8(x int8) int8 { return (0 - 16) & x }
func parenLeftXor32(x int32) int32 { return (0 - 1) ^ x }
func parenLeftMul8(x int8) int8 { return (0 - 100) * x }
func parenRightAnd16(x int16) int16 { return x & (0 - 32768) }
func parenRightAdd16(x int16) int16 { return x + (0 - 30000) }
func parenRightOr8(x int8) int8 { return x | (0 - 128) }
func parenRightSub32(x int32) int32 { return x - (0 - 2000000000) }
func parenRightDiv16(x int16) int16 { return x / (0 - 1) }
func wideLeftOrU32(x uint32) uint32 { return (0 + 4000000000) | x }
func wideRightAddU32(x uint32) uint32 { return x + (0 + 4000000000) }
func wideLeftSubU32(x uint32) uint32 { return (0 + 3000000000) - x }
func constNameLeftSub16(x int16) int16 { return NEG16 - x }
func constNameRightAnd16(x int16) int16 { return x & MASK16 }
func constNameLeftMul8(x int8) int8 { return NEG8 * x }
func litLeftOrU8(x uint8) uint8 { return 5 | x }
func litLeftSubU16(x uint16) uint16 { return (0 + 60000) - x }
func cmpParenLeft8(x int8) bool { return (0 - 100) > x }
func cmpParenRight16(x int16) bool { return x < (0 - 30000) }
func cmpNegLitLeft32(x int32) bool { return -2000000000 == x }

func main() {
	testing.Println(cast(int64, negLitLeftSub16(10000)))
	testing.Println(cast(int64, negLitLeftAdd8(-100)))
	testing.Println(cast(int64, negLitLeftDiv32(-1)))
	testing.Println(cast(int64, negLitLeftMul16(200)))
	testing.Println(cast(int64, parenLeftSub16(10000)))
	testing.Println(cast(int64, parenLeftAnd8(-1)))
	testing.Println(cast(int64, parenLeftXor32(123456)))
	testing.Println(cast(int64, parenLeftMul8(3)))
	testing.Println(cast(int64, parenRightAnd16(-2)))
	testing.Println(cast(int64, parenRightAdd16(-10000)))
	testing.Println(cast(int64, parenRightOr8(5)))
	testing.Println(cast(int64, parenRightSub32(2000000000)))
	testing.Println(cast(int64, parenRightDiv16(-32767)))
	testing.Println(cast(int64, wideLeftOrU32(300000000)))
	testing.Println(cast(int64, wideRightAddU32(300000000)))
	testing.Println(cast(int64, wideLeftSubU32(3500000000)))
	testing.Println(cast(int64, constNameLeftSub16(10000)))
	testing.Println(cast(int64, constNameRightAnd16(4660)))
	testing.Println(cast(int64, constNameLeftMul8(2)))
	testing.Println(cast(int64, litLeftOrU8(250)))
	testing.Println(cast(int64, litLeftSubU16(65535)))
	testing.Println(cmpParenLeft8(-128))
	testing.Println(cmpParenRight16(-30001))
	testing.Println(cmpNegLitLeft32(-2000000000))
}
