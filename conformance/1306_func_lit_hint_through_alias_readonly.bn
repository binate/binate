package "main"

import "pkg/builtins/testing"

// A capturing func literal bound for a *func destination spelled through an
// alias (`type F = *func() int`) or `readonly *func() int` must resolve as a
// *func (a stack closure that lives for the frame), exactly as for a plain
// `*func() int` destination — not as a heap @func temp that the destination
// merely borrows and the statement's cleanup frees.  Likewise a literal bound
// for an alias of a named func-value type (`type AF = Fn`) resolves as that
// named type.  Other allocations after the binding would reuse a freed closure.
// The destination's hint belongs to the bound literal only: a func literal
// nested inside its body (an untyped `var g = func...`) keeps the @func default.

type F = *func() int
type Fn @func() int
type AF = Fn

func churn() int {
	var s int = 0
	for i := 0; i < 50; i++ {
		var p @[]int = make_slice(int, 4)
		p[0] = i
		s = s + p[0]
	}
	return s
}

func main() {
	var x int = 42
	var f F = func() int { return x }
	var g readonly *func() int = func() int { return x + 1 }
	var h F
	h = func() int { return x + 2 }
	var a AF = func() int { return x + 3 }
	churn()
	testing.Println(f(), g(), h(), a())

	var n1 readonly *func() int = func() int {
		var inner = func() int { return x }
		var m @func() int = inner
		return m()
	}
	var n2 F = func() int {
		var inner = func() int { return x + 1 }
		var m @func() int = inner
		return m()
	}
	var n3 *func() int = func() int {
		var inner = func() int { return x + 2 }
		var m @func() int = inner
		return m()
	}
	testing.Println(n1(), n2(), n3())
}
