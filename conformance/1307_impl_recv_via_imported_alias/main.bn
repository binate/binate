package "main"

import "pkg/builtins/testing"
import "pkg/fwd"
import "pkg/home"
import "pkg/lib"

// An impl whose receiver is spelled through a type ALIAS of another package's
// type is an impl for the alias's target: its vtable keys on the target's name
// and package, where the boxing site looks it up.  Covers a qualified alias
// receiver here (`home.SA`, and through the forwarder `fwd.SA`), and an alias
// receiver declared in an imported package's own .bni (`lib.LS`), used both in
// that package and here.

interface Local {
	Label() int
}

impl *home.SA : Local

interface Local2 {
	Label() int
}

impl *fwd.SA : Local2

func main() {
	var s home.S = home.MkS(4)
	var l *Local = &s
	testing.Println(l.Label()) // 40
	var l2 *Local2 = &s
	testing.Println(l2.Label()) // 40
	var ll *lib.Loc = &s
	testing.Println(ll.Label()) // 40
	testing.Println(lib.Probe(5)) // 50
}
