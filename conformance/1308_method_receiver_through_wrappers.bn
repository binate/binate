package "main"

import "pkg/builtins/testing"

// Method calls and method values whose receiver passes through a readonly /
// alias wrapper: a `readonly T` value-receiver method called through a *T /
// @T (the receiver must be loaded), including via `defer`; a method value on a
// `readonly *F` / `readonly @F` / alias-of-pointer handle with a value
// receiver; and a method value on an alias-typed or readonly field / element
// with a pointer receiver (the captured value must be passed by address).  A
// readonly receiver on a named pointer type (`func (p readonly PS) m()`) takes
// the pointer as-is.

type F struct {
	x int
	y int
}

type PF = *F

func (f readonly F) sumR() int { return f.x + f.y }

func (f F) get() int { return f.x + f.y }

func (f readonly F) show() { testing.Println(f.x + f.y) }

func run(pf *F) {
	defer pf.show()
	pf.x = 1
}

type C struct {
	x int
	y int
}

type CA = C

func (c *C) get() int { return c.x + c.y }

type H struct {
	inner CA
}

type PS *F
type MS @F

func (p readonly PS) viaPS() int { return (*p).x + 2000 }

func (p readonly MS) viaMS() int { return p.x + 3000 }

func main() {
	var f F
	f.x = 40
	f.y = 2
	var pf *F = &f
	var mf @F = make(F)
	mf.x = 7
	mf.y = 3
	testing.Println(pf.sumR(), mf.sumR())
	run(pf)

	var p readonly *F = &f
	var g1 *func() int = p.get
	var m readonly @F = mf
	var g2 *func() int = m.get
	var pa PF = &f
	var g3 *func() int = pa.get
	testing.Println(g1(), g2(), g3())

	var h H
	h.inner.x = 40
	h.inner.y = 2
	var g4 *func() int = h.inner.get
	var arr [2]CA
	arr[1].x = 5
	arr[1].y = 6
	var g5 *func() int = arr[1].get
	testing.Println(g4(), g5())

	var ps PS = &f
	var ms MS = mf
	testing.Println(ps.viaPS(), ms.viaMS())
}
