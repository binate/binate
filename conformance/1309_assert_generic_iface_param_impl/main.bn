package "main"

import "pkg/builtins/testing"
import "pkg/home"

// A type assertion / type switch to a generic interface instantiation finds a
// dynamic type that implements it through a PARAMETERIZED impl
// (`impl *Box[T] : GJ[T]`), even when the value was only ever boxed into `any`:
// the instantiation's rows (Box[int] : GJ[int], and its parent GI[int]) exist
// once a value of it is boxed.  Covers the impl in an imported package (value
// boxed here, and boxed inside that package), and local ones.

type Cell[T any] struct {
	v T
}

func (c *Cell[T]) Val() T {
	return c.v
}

interface HasVal[T any] {
	Val() T
}

impl *Cell[T] : HasVal[T]

// Box2's parameter is named K, like the package type K; the impl's binder is U,
// so `Tagged[K]` names the package type, not the instantiation's argument.
type K struct {
	n int
}

type Box2[K any] struct {
	v K
}

func (b *Box2[U]) Tag() int {
	return 3
}

interface Tagged[X any] {
	Tag() int
}

impl *Box2[U] : Tagged[K]

func main() {
	var b home.Box[int] = home.MkBox(7)
	var a *any = &b
	j, ok := a.(*home.GJ[int])
	testing.Println(ok) // true
	if ok { testing.Println(j.Peek()) } // 7
	i, ok2 := a.(*home.GI[int])
	testing.Println(ok2) // true
	if ok2 { testing.Println(i.Get()) } // 7
	switch x := a.(type) {
	case *home.GJ[int]:
		testing.Println(x.Get() + 100) // 107
	default:
		testing.Println(-1)
	}

	var m @any = home.AnyBox(9)
	mj, okm := m.(@home.GJ[int])
	testing.Println(okm) // true
	if okm { testing.Println(mj.Peek()) } // 9

	var c Cell[int] = Cell[int]{v: 5}
	var ca *any = &c
	h, okc := ca.(*HasVal[int])
	testing.Println(okc) // true
	if okc { testing.Println(h.Val()) } // 5

	var b2 Box2[int] = Box2[int]{v: 1}
	var b2a *any = &b2
	t, okk := b2a.(*Tagged[K])
	testing.Println(okk) // true
	if okk { testing.Println(t.Tag()) } // 3
	_, oki := b2a.(*Tagged[int])
	testing.Println(oki) // false
}
