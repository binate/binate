package "pkg/home"

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() T {
	return b.v
}

func (b *Box[T]) Peek() T {
	return b.v
}

interface GI[T any] {
	Get() T
}

interface GJ[T any] : GI[T] {
	Peek() T
}

// A parameterized impl: every instantiation Box[X] implements GJ[X] (and GI[X]).
impl *Box[T] : GJ[T]

func MkBox(n int) Box[int]

// AnyBox boxes a Box[int] into `any` in THIS package.
func AnyBox(n int) @any
