package "main"

import "pkg/builtins/testing"
import "pkg/mid"
import "pkg/other"

// This package never imports pkg/home, yet boxes a home.Box[int] (obtained from
// pkg/mid) into `any`: the rows of Box's parameterized impls — including ones
// to interfaces of a third package — still exist, both for assertions here and
// in pkg/mid.

func main() {
	var a *any = mid.Get()
	mid.Check(a)
	o, ok := a.(*other.OI[int])
	testing.Println(ok) // true
	if ok { testing.Println(o.Get()) } // 11
	n, ok2 := a.(*other.ON)
	testing.Println(ok2) // true
	if ok2 { testing.Println(n.Name()) } // 42
}
