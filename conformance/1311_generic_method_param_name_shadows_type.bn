package "main"

import "pkg/builtins/testing"

// A generic type's parameter is named K, like the package type K.  A method
// declared with a different receiver binder (`func (b *Box[U]) …`) does not see
// the parameter name K: in its signature and body, K is the package type.

type K struct {
	n int
	m int
}

type Box[K any] struct {
	v K
}

func (b *Box[U]) Get() K {
	var k K
	k.n = 3
	k.m = 4
	return k
}

interface GI[X any] {
	Get() X
}

impl *Box[U] : GI[K]

func main() {
	var b Box[int] = Box[int]{v: 9}
	var k K = b.Get()
	testing.Println(k.n) // 3
	testing.Println(k.m) // 4
	var g *GI[K] = &b
	testing.Println(g.Get().m) // 4
}
