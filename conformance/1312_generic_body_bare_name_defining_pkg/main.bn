package "main"

import "pkg/builtins/testing"
import "pkg/g"

// Inside a generic body (or a parameterized impl) of pkg/g, a bare type,
// interface, const, global or method-expression name is pkg/g's — even when
// this package declares the same name, of the same kind or not (main's Lim is a
// global, g's a const; main's Pt an interface, g's a struct).  S implements
// only g.Namer, so binding Call's parameter to main's Namer fails.  Within the
// body a parameter or local shadows g's same-named func or type, and a type
// parameter is one whatever else its name denotes.

type T struct {
	Q int
	R int
	X int
}

interface Namer {
	Aaa() int
	Name() int
}

const N int = 2

type Num = int64

var Count int = 50

var Lim int = 1

type Tag struct {
	z int
}

interface Pt {
	M() int
}

interface E {
	M() int
}

func (t *T) Get() int {
	return 999
}

func dbl(n int) int {
	return n * 2
}

type Z struct {
	X int
}

func (z *Z) Get() int {
	return z.X + 500
}

type S struct {
	k int
}

func (s *S) Name() int {
	return s.k
}

func (s *S) Aaa() int {
	return -1
}

impl *S : g.Namer

func main() {
	testing.Println(g.Field[int](0, g.T{X: 3})) // 3
	var s S = S{k: 8}
	testing.Println(g.Call[int](0, &s)) // 8
	testing.Println(g.Len[int](0)) // 5
	testing.Println(g.Size[int](0)) // 2
	var b g.Box[int] = g.Box[int]{v: 1}
	var a *any = &b
	t, ok := a.(*g.GT[g.Tag])
	testing.Println(ok) // true
	if ok { testing.Println(t.Tg().n) } // 77
	_, bad := a.(*g.GT[Tag])
	testing.Println(bad) // false
	g.SetCount(6)
	testing.Println(g.ReadCount[int](0)) // 6
	testing.Println(Count) // 50
	testing.Println(g.Mk[int](0).X) // 4
	testing.Println(g.GetLim[int](0)) // 9
	testing.Println(Lim) // 1
	var p g.Pt = g.Pt{X: 12}
	testing.Println(g.ReadPt[int](0, &p)) // 12
	var gt g.T = g.T{X: 3}
	testing.Println(g.ME[int](0, &gt)) // 3
	testing.Println(g.Apply[int](0, dbl)) // 20
	testing.Println(g.ApplyVar[int](0, dbl)) // 20
	var n int = 41
	testing.Println(g.Deref[int](&n)) // 41
	testing.Println(g.MV[int](0)) // 14
}
