package "pkg/g"

type T struct {
	X int
}

interface Namer {
	Name() int
}

const N int = 5

type Num = int16

type Tag struct {
	n int
}

type Box[E any] struct {
	v E
}

func (b *Box[E]) Tg() Tag {
	var t Tag
	t.n = 77
	return t
}

interface GT[X any] {
	Tg() X
}

impl *Box[E] : GT[Tag]

// Field reads a field of g's T.
func Field[X any](x X, t T) int {
	return t.X
}

// Call dispatches through g's Namer.
func Call[X any](x X, n *Namer) int {
	return n.Name()
}

// Len sizes an array by g's N.
func Len[X any](x X) int {
	var a [N]int
	return len(a)
}

// Size is the size of g's Num.
func Size[X any](x X) int {
	return cast(int, sizeof(Num))
}

var Count int

// SetCount sets g's Count.
func SetCount(n int)

// ReadCount reads g's Count.
func ReadCount[X any](x X) int {
	return Count
}

const Lim int = 9

// Mk builds a g T.
func Mk[X any](x X) T {
	return T{X: 4}
}

// GetLim reads g's const Lim.
func GetLim[X any](x X) int {
	return Lim
}

type Pt struct {
	X int
}

// ReadPt reads a field of g's Pt.
func ReadPt[X any](x X, p *Pt) int {
	return p.X
}

func (t *T) Get() int

// ME calls T.Get through a method expression.
func ME[X any](x X, t *T) int {
	var f *func(*T) int = T.Get
	return f(t)
}

func helper(n int) int

// Apply calls its parameter `helper`, which shadows g's func helper.
func Apply[X any](x X, helper *func(int) int) int {
	f := helper
	return f(10)
}

// ApplyVar is Apply through an explicitly typed var.
func ApplyVar[X any](x X, helper *func(int) int) int {
	var f *func(int) int = helper
	return f(10)
}

// Deref's type parameter E is a type parameter, whatever else E names.
func Deref[E any](p *E) E {
	return *p
}

type W struct {
	X int
}

func (w *W) Get() int

type V struct {
	Y int
}

func (v *V) Get() int

// MV takes method values on locals named like g's type W and like the
// consumer's type Z: each local shadows the type.
func MV[X any](x X) int {
	var v V
	v.Y = 7
	var W *V = &v
	var f *func() int = W.Get
	var Z *V = &v
	var h *func() int = Z.Get
	return f() + h()
}
