package "main"

import "pkg/builtins/testing"
import "pkg/g"

// pkg/g's generic Outer instantiates pkg/h's generic Inner; this package never
// imports pkg/h.  Inner's bare global and const names are pkg/h's — not this
// package's same-named Count and K, and not an unresolved zero (Extra).

var Count int = 100

const K int = 60

func main() {
	testing.Println(g.Outer[int](0)) // 1025
	testing.Println(Count) // 100
	testing.Println(K) // 60
}
