package "main"

import "pkg/builtins/testing"

// A local variable named like a type shadows it: `W.Get` on the local is a
// method value of its own type (V), not the method expression W.Get.

type W struct {
	X int
}

func (w *W) Get() int {
	return w.X + 100
}

type V struct {
	Y int
}

func (v *V) Get() int {
	return v.Y
}

func main() {
	var v V
	v.Y = 3
	var W *V = &v
	var f *func() int = W.Get
	testing.Println(f()) // 3
	g := W.Get
	testing.Println(g()) // 3
}
