package "main"

import "pkg/builtins/testing"

// Named-over-readonly (`type R readonly int8`) and other wrapped types through
// the bytecode VM's lowering: sub-word loads / stores (by initialization — a
// location of a named-over-readonly type is readonly) must use the value's real
// width and sign-extend a signed one; a multi-return extract keeps the sign of
// a named / named-over-readonly int8; a named-over-readonly aggregate return is
// carried by address; negation and bit_cast of a wrapped scalar use its
// underlying form; and a conversion to a named interface-value type finds the
// interface's vtable.  (Every backend must agree.)

type R8 readonly int8
type R16 readonly int16
type R32 readonly int32
type RF readonly float32
type N8 int8

type S struct {
	a R32
	b R32
	c R8
	d R8
}

type T struct {
	f RF
	g RF
	h int32
}

type P struct {
	a int
	b int
	c int
}

type RP readonly P
type RMS readonly @[]int

interface Shape {
	Area() int
}

type Sq struct {
	s int
}

func (q *Sq) Area() int { return q.s * q.s }

impl *Sq : Shape

type NShape *Shape

func tup(x int8) (N8, int) { return cast(N8, x), 2 }

func tupR(x int8) (R8, int) { return cast(R8, x), 3 }

func mk(x int) RP {
	var p P = P{a: x, b: x + 1, c: x + 2}
	return cast(RP, p)
}

func mkMS(n int) RMS {
	var m @[]int = make_slice(int, n)
	for i := 0; i < n; i++ {
		m[i] = i * 10
	}
	return cast(RMS, m)
}

func clobber(x int, y int, z int) int {
	var q P = P{a: x * 100, b: y * 100, c: z * 100}
	return q.a + q.b + q.c
}

func use(r RP, s int) int { return r.a + r.b + r.c + s }

func useMS(m RMS, k int) int { return len(m) * 1000 + m[3] + k }

func main() {
	var s S = S{b: cast(R32, 7), a: cast(R32, -5), d: cast(R8, 9), c: cast(R8, -3)}
	testing.Println(cast(int, s.a), cast(int, s.b), cast(int, s.c), cast(int, s.d))
	testing.Println(s.a < cast(R32, 0), s.c < cast(R8, 0))
	var t T = T{h: 99, g: cast(RF, 2.5), f: cast(RF, 1.5)}
	testing.Println(cast(int, cast(float64, t.f) * 10.0), cast(int, cast(float64, t.g) * 10.0), t.h)
	var sl @[]R16 = @[]R16{cast(R16, -100), cast(R16, 200), cast(R16, 300), cast(R16, 400)}
	testing.Println(cast(int, sl[0]), cast(int, sl[1]), cast(int, sl[2]), cast(int, sl[3]))

	a, b := tup(-1)
	c, d := tupR(-2)
	testing.Println(a < cast(N8, 0), b, c < cast(R8, 0), d)

	testing.Println(use(mk(10), clobber(1, 2, 3)))
	testing.Println(useMS(mkMS(4), clobber(5, 6, 7)))

	var fa RF = cast(RF, 1.5)
	var fb RF = -fa
	var u uint8 = 200
	var r R8 = bit_cast(R8, u)
	testing.Println(cast(int, cast(float64, fb) * 10.0), r < cast(R8, 0), cast(int, r))

	var q Sq = Sq{s: 5}
	var sh *Shape = &q
	var n NShape = cast(NShape, sh)
	var p *Shape = cast(*Shape, n)
	testing.Println(p.Area())
}
