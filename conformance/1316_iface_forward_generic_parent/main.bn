package "main"

import "pkg/builtins/testing"
import "pkg/home"

// An imported interface whose parent (generic, or not) is declared AFTER it in
// the .bni still has the parent's methods, and upcasts to the parent.

func main() {
	var s home.S = home.MkS(7)
	var sub *home.Sub = &s
	testing.Println(sub.Get()) // 7
	testing.Println(sub.Extra()) // 8
	var base *home.Base[int] = sub
	testing.Println(base.Get()) // 7
	var nsub *home.NSub = &s
	testing.Println(nsub.Get()) // 7
	var nbase *home.NBase = nsub
	testing.Println(nbase.Get()) // 7
}
