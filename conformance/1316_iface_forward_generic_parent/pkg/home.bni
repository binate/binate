package "pkg/home"

// Sub names its generic parent Base[int] before Base is declared.
interface Sub : Base[int] {
	Extra() int
}

interface Base[T any] {
	Get() T
}

// NSub names its (non-generic) parent NBase before NBase is declared.
interface NSub : NBase {
	Extra() int
}

interface NBase {
	Get() int
}

type S struct {
	v int
}

func (s *S) Get() int

func (s *S) Extra() int

impl *S : Sub, NSub

func MkS(n int) S
