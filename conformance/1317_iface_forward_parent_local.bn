package "main"

import "pkg/builtins/testing"

// Declarations may appear in any order within a package (decl.order.forward):
// an interface may name parents — generic or not — declared after it.

interface A : B, G[int] {
	X() int
}

interface B {
	Y() int
}

interface G[T any] {
	Z() T
}

type T struct {
	v int
}

func (t *T) X() int {
	return t.v
}

func (t *T) Y() int {
	return t.v + 1
}

func (t *T) Z() int {
	return t.v + 2
}

impl *T : A

func main() {
	var t T = T{v: 1}
	var a *A = &t
	testing.Println(a.X()) // 1
	testing.Println(a.Y()) // 2
	testing.Println(a.Z()) // 3
	var b *B = a
	testing.Println(b.Y()) // 2
	var g *G[int] = a
	testing.Println(g.Z()) // 3
}
