package "main"

import "pkg/builtins/testing"

// A binary op whose LEFT operand is a wrapped 64-bit integer (a named
// `type N int64`, or `readonly int64`) and whose right operand is a plain int
// (e.g. a folded negative constant) must compute at 64 bits — on a 32-bit
// target, widening to `int` would truncate the left operand.

type N int64

func addRO(x readonly int64) int64 { return x + -5 }

func main() {
	var x N = 6442450944
	testing.Println(cast(int64, x + (0 - 5)), x > (0 - 5), x / (0 - 2) == -3221225472)
	testing.Println(cast(int64, x * -(-2)))
	var p int64 = 6442450944
	testing.Println(p + (0 - 5), p > (0 - 5), p / (0 - 2) == -3221225472)
	testing.Println(addRO(6442450944))
}
