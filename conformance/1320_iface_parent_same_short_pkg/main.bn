package "main"

import "pkg/a/util"
import "pkg/builtins/testing"

// Interfaces of two packages sharing the short name `util` are distinct: a's Y
// extending b's X (which extends b's Y) is not an extension cycle.

func main() {
	var t util.T = util.MkT(10)
	var y *util.Y = &t
	testing.Println(y.z()) // 13
	testing.Println(y.x()) // 11
	testing.Println(y.y()) // 12
}
