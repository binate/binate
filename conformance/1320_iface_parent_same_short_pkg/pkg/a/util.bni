package "pkg/a/util"

import bu "pkg/b/util"

// A different package's Y (same short name "util") extends pkg/b/util's X,
// which extends pkg/b/util's Y: not a cycle.
interface Y : bu.X {
	z() int
}

type T struct {
	n int
}

func (t *T) x() int

func (t *T) y() int

func (t *T) z() int

impl *T : Y

func MkT(n int) T
