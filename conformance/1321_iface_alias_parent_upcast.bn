package "main"

import "pkg/builtins/testing"

// An interface alias as a parent: A extends X, an alias of Y, so a *A upcasts
// to *X (and *Y).

interface Y {
	y() int
}

interface X = Y

interface A : X {
	a() int
}

type T struct {
	v int
}

func (t *T) a() int {
	return 1
}

func (t *T) y() int {
	return t.v
}

impl *T : A

func main() {
	var t T = T{v: 5}
	var a *A = &t
	var x *X = a
	testing.Println(x.y()) // 5
}
