package "main"

import "pkg/builtins/testing"

// Declarations may appear in any order within a package (decl.order.forward):
// a signature may name an interface alias declared after it.

func f(x *X) int {
	return x.y()
}

interface X = Y

interface Y {
	y() int
}

type T struct {
	v int
}

func (t *T) y() int {
	return t.v
}

impl *T : Y

func main() {
	var t T = T{v: 4}
	testing.Println(f(&t)) // 4
}
