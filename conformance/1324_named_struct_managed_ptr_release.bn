package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A managed pointer to a named-over-struct type (`@NB` for `type NB Box`) holds
// a Box, so releasing it must run Box's dtor exactly like releasing a `@Box`:
// the struct's managed fields are released along with the cell.  Each case
// below allocates one @[]int into such a Box and then drops the last reference
// — at scope exit, through a struct field's dtor, through a managed holder's
// dtor, through a `box` of an NB value, and on reassignment.  A release that frees the cell
// without the dtor leaks the slice backing, so LiveBlocks stays one above the
// baseline instead of returning to it.

type Box struct {
	s @[]int
}

type NB Box

type Holder struct {
	p @NB
}

func scopeExit() {
	var n @NB = make(NB)
	n.s = make_slice(int, 4)
}

func fieldDtor() {
	var h Holder
	h.p = make(NB)
	h.p.s = make_slice(int, 4)
}

func managedHolder() {
	var h @Holder = make(Holder)
	h.p = make(NB)
	h.p.s = make_slice(int, 4)
}

func boxed() int {
	var n NB
	n.s = make_slice(int, 4)
	var b @NB = box(n)
	return len(b.s)
}

func reassigned() {
	var n @NB = make(NB)
	n.s = make_slice(int, 4)
	n = make(NB)
}

func main() {
	var base int = rt.LiveBlocks()
	scopeExit()
	testing.Println(rt.LiveBlocks() - base)
	base = rt.LiveBlocks()
	fieldDtor()
	testing.Println(rt.LiveBlocks() - base)
	base = rt.LiveBlocks()
	managedHolder()
	testing.Println(rt.LiveBlocks() - base)
	base = rt.LiveBlocks()
	testing.Println(boxed())
	testing.Println(rt.LiveBlocks() - base)
	base = rt.LiveBlocks()
	reassigned()
	testing.Println(rt.LiveBlocks() - base)
}
