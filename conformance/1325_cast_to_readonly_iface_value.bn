package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Widening a concrete pointer to a `readonly *I` / `readonly @I` interface value
// builds the same {data, vtable} pair as widening to the plain `*I` / `@I`:
// readonly is transparent to the conversion.  Covers the explicit `cast` and
// `unsafe_cast` forms, the implicit conversions (var init, struct-literal
// field, return, argument, array-literal element, sub-interface upcast), and
// that the managed box releases its reference (LiveBlocks back to baseline).

interface Getter {
	Get() int
}

interface Getter2 : Getter {
	Get2() int
}

type S struct {
	v int
}

func (s *S) Get() int { return s.v }

func (s *S) Get2() int { return s.v * 2 }

impl *S : Getter2

impl @S : Getter2

type H struct {
	g readonly *Getter
	m readonly @Getter
}

func ret(s *S) readonly *Getter { return s }

func take(g readonly @Getter) int { return g.Get() }

func castManaged() int {
	var m @S = make(S)
	m.v = 9
	var b readonly @Getter = cast(readonly @Getter, m)
	var u readonly @Getter = unsafe_cast(readonly @Getter, m)
	return b.Get() + u.Get()
}

func main() {
	var s S
	s.v = 7
	var m @S = make(S)
	m.v = 8
	var a readonly *Getter = cast(readonly *Getter, &s)
	var ua readonly *Getter = unsafe_cast(readonly *Getter, &s)
	testing.Println(a.Get(), ua.Get())
	var cm readonly @Getter = cast(readonly @Getter, m)
	var um readonly @Getter = unsafe_cast(readonly @Getter, m)
	testing.Println(cm.Get(), um.Get())
	var base int = rt.LiveBlocks()
	testing.Println(castManaged())
	testing.Println(rt.LiveBlocks() - base)
	var ia readonly *Getter = &s
	var ib readonly @Getter = m
	testing.Println(ia.Get(), ib.Get())
	var h H = H{g: &s, m: m}
	testing.Println(h.g.Get(), h.m.Get())
	testing.Println(ret(&s).Get(), take(m))
	var arr [2]readonly *Getter = [2]readonly *Getter{&s, &s}
	testing.Println(arr[1].Get())
	var g2 *Getter2 = &s
	var up readonly *Getter = g2
	testing.Println(up.Get())
}
