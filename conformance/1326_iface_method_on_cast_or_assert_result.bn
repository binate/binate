package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An interface method called directly on a conversion or type-assertion result
// dispatches through the interface value, exactly as on a variable holding it:
// `cast(@I, m).M()`, `cast(*I, &s).M()`, `unsafe_cast(*I, p).M()`, a cast to a
// readonly interface value, an interface-to-interface upcast, and an assertion
// to an interface (`g.(*I2).M()`).  The managed interface value built for the
// call is released afterwards (LiveBlocks back to baseline).  A cast base also
// types a func-value field call (`cast(*S, p).fn(x)`) and a chained field
// selector (`cast(*Outer, p).inner.x = v`); plain field access and a concrete
// method call on a cast result keep working alongside.

interface Getter {
	Get() int
}

interface Getter2 : Getter {
	Get2() int
}

type S struct {
	v  int
	fn *func(int) int
}

type Inner struct {
	x int
}

type Outer struct {
	inner Inner
}

func twice(n int) int { return n * 2 }

func (s *S) Get() int { return s.v }

func (s *S) Get2() int { return s.v * 2 }

impl *S : Getter2

impl @S : Getter2

func sumViaCast(m @S) int {
	var t int = 0
	for i := 0; i < 3; i++ {
		t = t + cast(@Getter, m).Get()
	}
	return t
}

func main() {
	var s S
	s.v = 7
	var m @S = make(S)
	m.v = 8
	testing.Println(cast(@Getter, m).Get(), cast(*Getter, &s).Get(), unsafe_cast(*Getter2, &s).Get2())
	testing.Println(cast(readonly @Getter, m).Get(), cast(readonly *Getter2, &s).Get2())
	var g2 *Getter2 = &s
	testing.Println(cast(*Getter, g2).Get())
	var g *Getter = &s
	testing.Println(g.(*Getter2).Get2())
	testing.Println(cast(@S, m).v, cast(@S, m).Get(), unsafe_cast(*S, &s).v)
	s.fn = twice
	testing.Println(cast(*S, &s).fn(10))
	var o Outer
	cast(*Outer, &o).inner.x = 77
	testing.Println(o.inner.x, cast(*Outer, &o).inner.x)
	testing.Println(sumViaCast(m))
	var base int = rt.LiveBlocks()
	testing.Println(sumViaCast(m))
	testing.Println(rt.LiveBlocks() - base)
}
