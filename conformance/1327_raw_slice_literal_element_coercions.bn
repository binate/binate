package "main"

import "pkg/builtins/testing"

// A raw-slice literal's elements get the same conversions as an array- or
// managed-slice-literal element: a string literal becomes a full char-slice
// header (else the element's len reads back 0), a struct or array composite
// literal is stored by value (else the element holds the literal's stack
// address), and a managed slice stored into a raw-slice element decays to its
// {data, len} view.  The same literals as managed-slice literals agree.

type P struct {
	a int
	b int
}

func sum(s *[]int) int {
	var t int = 0
	for i := 0; i < len(s); i++ {
		t = t + s[i]
	}
	return t
}

func main() {
	var r *[]readonly *[]readonly char = *[]readonly *[]readonly char{"ab", "cde"}
	testing.Println(len(r[0]), len(r[1]), cast(int, r[1][2]))
	var q *[]readonly P = *[]readonly P{P{a: 1, b: 2}, P{a: 3, b: 4}}
	testing.Println(q[0].a, q[0].b, q[1].a, q[1].b)
	var w *[]readonly [2]int = *[]readonly [2]int{[2]int{5, 6}, [2]int{7, 8}}
	testing.Println(w[0][1], w[1][0])
	var m @[]int = make_slice(int, 3)
	m[0] = 1
	m[1] = 2
	m[2] = 3
	var rs *[]readonly *[]int = *[]readonly *[]int{m, m}
	testing.Println(sum(rs[0]), sum(rs[1]), len(rs))
	var mr @[]@[]readonly char = @[]@[]readonly char{"ab", "cde"}
	var mq @[]P = @[]P{P{a: 1, b: 2}, P{a: 3, b: 4}}
	var ms @[]*[]int = @[]*[]int{m, m}
	testing.Println(len(mr[1]), mq[1].b, sum(ms[1]), len(ms))
}
