package "main"

import "pkg/builtins/testing"
import "pkg/home"

// The same shadowing across packages: main instantiates the imported
// home.Box[int], whose methods name the package type home.K while the type's
// own parameter is also named K.

func main() {
	var b home.Box[int] = home.Box[int]{v: 9}
	var k home.K = b.Get()
	testing.Println(k.n) // 3
	testing.Println(k.m) // 4
	testing.Println(b.Val()) // 9
	var g *home.GI[home.K] = &b
	testing.Println(g.Get().m) // 4
}
