package "pkg/home"

// A generic type whose parameter is named K, like the package type K.  The
// methods (bodies included, so a consumer can monomorphize them) are declared
// with a different receiver binder, U: in their signatures and bodies K is the
// package type, not the type argument.

type K struct {
	n int
	m int
}

type Box[K any] struct {
	v K
}

func (b *Box[U]) Get() K {
	var k K
	k.n = 3
	k.m = 4
	return k
}

func (b *Box[U]) Val() U {
	return b.v
}

interface GI[X any] {
	Get() X
}

impl *Box[U] : GI[K]
