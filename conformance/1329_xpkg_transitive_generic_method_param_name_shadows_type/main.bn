package "main"

import "pkg/builtins/testing"
import "pkg/mid"

// main reaches home.Box[int] only transitively (through mid) and declares its
// own, differently-shaped K: Kay's result is still home's K.

type K struct {
	z int
	y int
	w int
}

func main() {
	var q K
	q.w = 1
	b := mid.Make()
	testing.Println(b.Val()) // 9
	k := b.Kay()
	testing.Println(k.n) // 3
	testing.Println(k.m) // 4
	testing.Println(q.w) // 1
}
