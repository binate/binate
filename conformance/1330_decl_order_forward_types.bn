package "main"

import "pkg/builtins/testing"

// Declarations may appear in any order within a package (decl.order.forward):
// each name below is used before its declaration — an alias naming a later
// alias, a struct field / parameter / const typed through a later alias, a
// pointer alias to a later alias, an alias of a later generic instantiation, a
// global and an alias typed through a later interface, an interface alias
// used before its declaration, and a const / global typed through a later
// float alias.  A generic's type parameter named like a later alias (U, V) is
// the parameter inside the generic, not the alias.

type A = B

type B = C

type C int

type S struct {
	f F
	g G
}

type F = int

type G = H

type H struct {
	x int
}

func inc(x F) F {
	return x + 1
}

const K F = 7

type P = *H

type BI = Box[int]

type Box[X any] struct {
	v X
}

var gi *I

type PI = *I

func viaAlias(x *IA) int {
	return x.M()
}

interface IA = I

interface I {
	M() int
}

type T struct {
	v int
}

func (t *T) M() int {
	return t.v
}

impl *T : I

const KF FF = 2.5

var gf FF = 1.5

type FF = float64

type Cell[U any] struct {
	v U
}

type U = Cell[int]

var gcell Cell2[int]

type Cell2[V any] struct {
	v V
}

type V = bool

func main() {
	var a A = 1
	testing.Println(cast(int, a)) // 1
	var s S
	s.f = 2
	s.g.x = 3
	testing.Println(s.f) // 2
	testing.Println(s.g.x) // 3
	testing.Println(inc(3)) // 4
	testing.Println(K) // 7
	var h H = H{x: 5}
	var p P = &h
	testing.Println(p.x) // 5
	var bi BI = BI{v: 6}
	testing.Println(bi.v) // 6
	var t T = T{v: 8}
	gi = &t
	testing.Println(gi.M()) // 8
	var pi PI = &t
	testing.Println(pi.M()) // 8
	testing.Println(viaAlias(&t)) // 8
	var kf FF = KF * 2.0
	gf = gf * 3.0
	testing.Println(kf) // 5.000000
	testing.Println(gf) // 4.500000
	var u U
	u.v = 9
	testing.Println(u.v) // 9
	gcell.v = 10
	var vb V = true
	testing.Println(gcell.v) // 10
	testing.Println(vb) // true
}
