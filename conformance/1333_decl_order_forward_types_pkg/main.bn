package "main"

import "pkg/builtins/testing"
import "pkg/lp"

// See pkg/lp.bni.  This package's own Thing (declared after a use of
// lp.Box[int16], whose field is lp's Thing) stays this package's.

var g lp.Box[int16]

type Thing = int8

func main() {
	var t lp.T = lp.Mk(7)
	var p lp.P = &t
	testing.Println(p.M()) // 7
	lp.SetG(p)
	testing.Println(lp.CallG()) // 7
	testing.Println(lp.Via(&t)) // 107
	testing.Println(lp.Twice(21)) // 42
	testing.Println(lp.Half(5.0)) // 2.500000
	testing.Println(lp.RecF(lp.RecOf(9))) // 9
	g.v = 11
	g.t.b = 12
	var th Thing = 13
	testing.Println(g.v) // 11
	testing.Println(g.t.b) // 12
	testing.Println(th) // 13
}
