package "pkg/lp"

// Forward references in a .bni and across packages: an alias naming a later
// alias, a signature naming a later interface alias, and an alias / global
// typed through an interface (registered by IR-gen in a later pass than the
// aliases, whatever the declaration order).

type A = B

type B = int

// FA names a later alias whose target is float64.
type FA = FB

type FB = float64

// Rec's field is typed through a later alias.
type Rec struct {
	f FC
}

type FC = int8

// Thing / Box: a generic whose field names this package's Thing (the
// consumer declares its own Thing).
type Thing struct {
	a int64
	b int64
}

type Box[X any] struct {
	t Thing
	v X
}

func Half(a FA) FA

func RecOf(n int8) Rec

func RecF(r Rec) int8

func Via(x *X) int

interface X = I

interface I {
	M() int
}

type P = *I

var G *I

type T struct {
	x int
}

func (t *T) M() int

impl *T : I

func Mk(n int) T

func SetG(p P)

func CallG() int

func Twice(a A) A
