package "pkg/lp"

var G *I

func Via(x *X) int {
	return x.M() + 100
}

func (t *T) M() int {
	return t.x
}

func Mk(n int) T {
	return T{x: n}
}

func SetG(p P) {
	G = p
}

func CallG() int {
	return G.M()
}

func Twice(a A) A {
	return a * 2
}

func Half(a FA) FA {
	return a / 2.0
}

func RecOf(n int8) Rec {
	return Rec{f: n}
}

func RecF(r Rec) int8 {
	return r.f
}
