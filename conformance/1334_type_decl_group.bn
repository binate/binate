package "main"

import "pkg/builtins/testing"

// Type declarations in a `type ( ... )` group: a struct, a named type, and an
// alias.

type (
	S struct {
		x int
	}
	C int
	P = *C
)

func main() {
	var s S = S{x: 3}
	testing.Println(s.x) // 3
	var c C = 5
	var p P = &c
	testing.Println(cast(int, *p)) // 5
}
