package "main"

import "pkg/builtins/testing"

// Type declarations in a `type ( ... )` group: a struct, a named type, an
// alias of a pointer, an alias naming a later alias of the same group, and a
// generic struct.

type (
	S struct {
		x int
	}
	C int
	P = *C
	F = G
	G = float64
	Box[T any] struct {
		v T
	}
)

func main() {
	var s S = S{x: 3}
	testing.Println(s.x) // 3
	var c C = 5
	var p P = &c
	testing.Println(cast(int, *p)) // 5
	var f F = 1.5
	testing.Println(f * 2.0) // 3.000000
	var b Box[int] = Box[int]{v: 7}
	testing.Println(b.v) // 7
}
