package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A named function-value type over a readonly function value (`type RF readonly
// @func() int`, `type RNF readonly *func(int) int`) is called, passed, stored and
// returned exactly like the plain function value: a call through a local,
// parameter, struct field or call result dispatches through the value (not a
// direct call on a symbol named after the variable), and a capturing literal
// bound to RF heap-allocates its closure so it outlives the creating frame.
// The closures are released afterwards (LiveBlocks back to baseline).

type RF readonly @func() int

type RNF readonly *func(int) int

type H struct {
	f RF
	n RNF
}

func seven() int { return 7 }

func double(n int) int { return n * 2 }

func mk(k int) RF {
	return func() int { return k + 1 }
}

func callIt(f RF) int { return f() }

func callN(n RNF, x int) int { return n(x) }

func clobber() int {
	var a [16]int
	for i := 0; i < 16; i++ {
		a[i] = 1000 + i
	}
	return a[15]
}

func useClosures() int {
	var c RF = mk(41)
	var d RF = mk(1)
	clobber()
	return c() + d() + mk(99)()
}

func main() {
	var a RF = seven
	testing.Println(a(), callIt(a))
	var n RNF = double
	testing.Println(n(21), callN(n, 5))
	var h H = H{f: seven, n: double}
	testing.Println(h.f(), h.n(4))
	var ph *H = &h
	testing.Println(ph.f(), ph.n(6))
	var c RF = mk(41)
	clobber()
	testing.Println(c(), callIt(c), mk(9)())
	var base int = rt.LiveBlocks()
	testing.Println(useClosures())
	testing.Println(rt.LiveBlocks() - base)
}
