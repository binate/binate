package "main"

import "pkg/builtins/testing"

// Slicing an array with hi > len must abort with an index-out-of-bounds fault,
// exactly as slicing a slice does (the hi bound is checked against len+1).
// `hi` comes through a call so no pass can fold it.

func bound(x int) int { return x }

func main() {
	var a [4]int
	testing.Println("before")
	var t *[]int = a[0:bound(9)]
	testing.Println(len(t))
}
