package "main"

import "pkg/builtins/testing"

// Slicing an array with lo > hi must abort with an index-out-of-bounds fault,
// exactly as slicing a slice does (the lo bound is checked against hi+1), so
// safe code can never build a negative-length slice.  The bounds come through
// a call so no pass can fold them.

func bound(x int) int { return x }

func main() {
	var a [4]int
	testing.Println("before")
	var t *[]int = a[bound(3):bound(1)]
	testing.Println(len(t))
}
