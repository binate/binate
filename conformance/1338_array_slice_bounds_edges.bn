package "main"

import "pkg/builtins/testing"

// Array slices at the edges of the checked range 0 <= lo <= hi <= len are
// valid: empty slices at either end, the whole array, an implicit bound, a
// slice through a pointer to an array, and a named array type.  Bounds come
// through a call so the runtime checks run.

type Row [3]int

func bound(x int) int { return x }

func main() {
	var a [4]int
	for i := 0; i < 4; i++ { a[i] = i + 1 }
	var e1 *[]int = a[bound(4):bound(4)]
	var e0 *[]int = a[bound(0):bound(0)]
	var all *[]int = a[bound(0):bound(4)]
	var tail *[]int = a[bound(2):]
	var head *[]int = a[:bound(1)]
	var whole *[]int = a[:]
	testing.Println(len(e1), len(e0), len(all), len(tail), len(head), len(whole))
	testing.Println(all[3], tail[0], tail[1], head[0])

	var p *([4]int) = &a
	var mid *[]int = (*p)[bound(1):bound(3)]
	testing.Println(len(mid), mid[0], mid[1])

	var r Row
	r[2] = 9
	var rs *[]int = r[bound(1):bound(3)]
	testing.Println(len(rs), rs[1])
}
