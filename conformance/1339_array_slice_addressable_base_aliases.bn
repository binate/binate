package "main"

import "pkg/builtins/testing"

// A slice of an addressable array is a borrowing view of that array, however
// the array is reached: a variable, a struct field, a pointer dereference, or
// an element of an array of arrays.  A write through the slice must be visible
// through the array.

type S struct {
	arr [4]int
}

func main() {
	var a [4]int
	var t *[]int = a[1:3]
	t[0] = 11
	var s S
	var u *[]int = s.arr[1:3]
	u[0] = 22
	var p *([4]int) = &a
	var v *[]int = (*p)[2:4]
	v[0] = 33
	var n [2][4]int
	var w *[]int = n[1][0:3]
	w[0] = 44
	testing.Println(a[1], s.arr[1], a[2], n[1][0])
}
