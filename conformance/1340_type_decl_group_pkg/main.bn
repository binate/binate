package "main"

import "pkg/builtins/testing"
import "pkg/gg"

// A library's grouped struct, float alias, pointer alias and generic struct
// keep their types across the package boundary.

func main() {
	var s gg.S = gg.Mk(4)
	testing.Println(s.x) // 4
	testing.Println(gg.Half(5.0)) // 2.500000
	var p gg.P = &s
	testing.Println(gg.Get(p)) // 4
	var b gg.Box[int] = gg.MkBox(6)
	testing.Println(b.v) // 6
}
