package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A raw-slice literal's backing is a scope-bound stack array that OWNS its
// managed elements for that scope, like a local `[N]T` array: each element is
// retained when stored and released when the scope exits.  So a view over
// fresh managed elements stays valid for the whole scope, an element copied
// from a variable keeps its own reference after the variable is reassigned,
// and nothing leaks or is released twice when the literal sits in a loop body
// (scope re-entered), a loop condition (evaluated repeatedly in one scope), a
// short-circuit operand (sometimes not evaluated), or a scope left by break /
// continue / return.  Each case checks the values and that LiveBlocks returns
// to its baseline.

type Box struct {
	b @int
}

func mkbox(v int) Box {
	var x Box
	x.b = box(v)
	return x
}

func sum(s *[]readonly Box) int {
	var t int = 0
	for i := 0; i < len(s); i++ {
		t = t + *s[i].b
	}
	return t
}

func fresh() int {
	var rq *[]readonly Box = *[]readonly Box{mkbox(30), mkbox(40)}
	var other @[]int = make_slice(int, 8)
	var rp *[]readonly @int = *[]readonly @int{box(5), box(6)}
	var rl *[]readonly Box = *[]readonly Box{Box{b: box(7)}}
	return *rq[0].b + *rq[1].b + *rp[0] + *rp[1] + *rl[0].b + len(other)
}

func copied() int {
	var b1 Box = mkbox(1)
	var rq *[]readonly Box = *[]readonly Box{b1}
	b1.b = box(99)
	return *rq[0].b * 100 + *b1.b
}

func loopBody() int {
	var t int = 0
	for i := 0; i < 3; i++ {
		var rq *[]readonly Box = *[]readonly Box{mkbox(i), mkbox(10 * i)}
		t = t + sum(rq)
	}
	return t
}

func loopCond() int {
	var n int = 0
	for i := 0; i < 4 && sum(*[]readonly Box{mkbox(i)}) < 3; i++ {
		n = n + 1
	}
	return n
}

func shortCircuit() int {
	var n int = 0
	for i := 0; i < 4; i++ {
		var even bool = i % 2 == 0
		if even && sum(*[]readonly Box{mkbox(i), mkbox(1)}) > 0 {
			n = n + 1
		}
	}
	return n
}

func exits() int {
	var t int = 0
	for i := 0; i < 5; i++ {
		var rq *[]readonly Box = *[]readonly Box{mkbox(i)}
		if i == 1 {
			continue
		}
		if i == 3 {
			break
		}
		t = t + sum(rq)
	}
	return t
}

func early(stop bool) int {
	var rq *[]readonly Box = *[]readonly Box{mkbox(8)}
	if stop {
		return sum(rq)
	}
	return 0
}

func main() {
	// Results are collected before printing, so the LiveBlocks window covers only
	// the cases (not the boxing of the printed values).
	var base int = rt.LiveBlocks()
	var f int = fresh()
	var c int = copied()
	var lb int = loopBody()
	var lc int = loopCond()
	var sc int = shortCircuit()
	var ex int = exits()
	var e1 int = early(true)
	var e2 int = early(false)
	var delta int = rt.LiveBlocks() - base
	testing.Println(f, c, lb, lc, sc, ex, e1, e2)
	testing.Println(delta)
}
