package "main"

import "pkg/builtins/testing"

// A blank `_` receiver binder (gen.method.generic-recv, gen.impl.generic-recv)
// binds its type parameter without naming it, and any number of positions may
// be `_`.  Each blank position still binds its OWN type argument: `Pair[_, _]`
// on Pair[int8, S] is Pair[int8, S], so its fields keep their layout.

type S struct {
	a int
	b int
}

type Pair[K any, V any] struct {
	k K
	v V
}

func (p *Pair[_, V]) Second() V {
	return p.v
}

func (p *Pair[K, _]) First() K {
	return p.k
}

func (p *Pair[_, _]) Tag() int {
	return 7
}

interface Getter[X any] {
	Second() X
}

impl *Pair[_, V] : Getter[V]

func main() {
	var s S
	s.a = 11
	s.b = 22
	var p Pair[int8, S] = Pair[int8, S]{k: 5, v: s}
	testing.Println(p.First())    // 5
	testing.Println(p.Second().b) // 22
	testing.Println(p.Tag())      // 7
	var g *Getter[S] = &p
	testing.Println(g.Second().a) // 11
}
