package "main"

// Receiver binders are fresh names, one per type parameter
// (gen.method.generic-recv): binding the same name at two positions is rejected
// at the declaration.

type Pair[K any, V any] struct {
	k K
	v V
}

func (p *Pair[A, A]) First() A {
	return p.k
}

func main() {
	var p Pair[int, int]
	_ = p
}
