package "main"

import "pkg/builtins/testing"
import "pkg/bl"
import "pkg/other"

// Blank receiver binders across packages: main instantiates the imported
// bl.Pair[int8, bl.S], whose methods and impls bind `_` positions, calls the
// methods directly and through both interfaces.

func main() {
	var s bl.S
	s.a = 11
	s.b = 22
	var p bl.Pair[int8, bl.S]
	p = bl.Pair[int8, bl.S]{k: 5, v: s}
	testing.Println(p.First())    // 5
	testing.Println(p.Second().b) // 22
	testing.Println(p.Tag())      // 7
	testing.Println(p.Both().a)   // 11
	var g *bl.Getter[bl.S] = &p
	testing.Println(g.Second().a) // 11
	var f *other.OF[int8] = &p
	testing.Println(f.First())    // 5
}
