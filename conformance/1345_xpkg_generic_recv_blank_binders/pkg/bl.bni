package "pkg/bl"

// A generic type whose methods and impls use blank `_` receiver binders
// (gen.method.generic-recv, gen.impl.generic-recv); bodies are included so
// consumers monomorphize them.

import "pkg/other"

type S struct {
	a int
	b int
}

type Pair[K any, V any] struct {
	k K
	v V
}

interface Getter[X any] {
	Second() X
}

func (p *Pair[_, V]) Second() V {
	return p.v
}

func (p *Pair[K, _]) First() K {
	return p.k
}

func (p *Pair[_, _]) Tag() int {
	return 7
}

func (p *Pair[_, V]) Both() V {
	var k int = cast(int, p.First())
	var s V = p.Second()
	_ = k
	return s
}

impl *Pair[_, V] : Getter[V]

impl *Pair[K, _] : other.OF[K]
