package "main"

import "pkg/builtins/testing"
import "pkg/mid"
import "pkg/other"

// Blank receiver binders reached only transitively: main gets a
// *bl.Pair[int8, bl.S] through mid (never importing bl) and asserts it to the
// interface implemented by `impl *Pair[K, _] : other.OF[K]`.

func main() {
	var a *any = mid.Get()
	o, ok := a.(*other.OF[int8])
	testing.Println(ok) // true
	if ok {
		testing.Println(o.First()) // 5
	}
}
