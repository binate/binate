package "main"

// An impl's receiver binders are fresh names too (gen.impl.generic-recv): a
// name bound at two positions is rejected, even among blank `_` positions.

type Quad[A any, B any, C any, D any] struct {
	a A
	b B
	c C
	d D
}

interface Firster[X any] {
	First() X
}

func (q *Quad[P, _, _, _]) First() P {
	return q.a
}

impl *Quad[_, X, _, X] : Firster[X]

func main() {
	var q Quad[int, int, int, int]
	_ = q
}
