package "main"

// A blank `_` impl receiver binder names nothing (gen.impl.generic-recv):
// using `_` in the impl's interface list is an undefined type.

type Pair[K any, V any] struct {
	k K
	v V
}

interface Getter[X any] {
	Second() X
}

func (p *Pair[_, V]) Second() V {
	return p.v
}

impl *Pair[_, V] : Getter[_]

func main() {
	var p Pair[int, int]
	_ = p
}
