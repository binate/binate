package "main"

import "pkg/builtins/testing"

// A generic type's constraint may refer to another of its parameters
// (`C Cont[X]`).  A method's receiver binders may rename, reorder or blank the
// type's parameters (gen.method.generic-recv), and each binder still carries the
// constraint of the parameter at ITS position, with the constraint's reference
// resolved to the binder at the referenced position.

interface Cont[T any] {
	Get() T
}

type IntBox struct {
	v int
}

func (b IntBox) Get() int {
	return b.v
}

impl IntBox : Cont[int]

type W[X any, C Cont[X]] struct {
	c C
}

func (w *W[_, D]) Blank() int {
	return 3
}

func (w *W[A, D]) Renamed() A {
	return w.c.Get()
}

// Binders reordered against the declared names: X here binds position 1, and
// D's constraint Cont[X] (declared) refers to position 0 — the binder Y.
type W3[X any, Y any, C Cont[X]] struct {
	c C
	y Y
}

func (w *W3[Y, X, D]) Swapped() Y {
	return w.c.Get()
}

func main() {
	var w W[int, IntBox]
	w.c.v = 41
	testing.Println(w.Blank())   // 3
	testing.Println(w.Renamed()) // 41
	var w3 W3[int, int8, IntBox]
	w3.c.v = 42
	testing.Println(w3.Swapped()) // 42
}
