package "main"

import "pkg/builtins/testing"

// A raw-slice literal in a package-level initializer has the package as its
// enclosing scope, so its backing lives for the whole program: the global view
// still reads the elements in main, after the module initializer has returned
// and its stack has been reused — for plain elements, fresh managed elements,
// struct-literal elements and string elements alike.

type Box struct {
	b @int
}

func mkbox(v int) Box {
	var x Box
	x.b = box(v)
	return x
}

type P struct {
	a int
	b int
}

var gInts *[]readonly int = *[]readonly int{1, 2, 3}

var gBoxes *[]readonly Box = *[]readonly Box{mkbox(100), mkbox(200)}

var gPs *[]readonly P = *[]readonly P{P{a: 7, b: 8}}

var gStrs *[]readonly *[]readonly char = *[]readonly *[]readonly char{"ab", "cde"}

var gSum int = sum(*[]readonly int{10, 20, 30})

func sum(s *[]readonly int) int {
	var t int = 0
	for i := 0; i < len(s); i++ {
		t = t + s[i]
	}
	return t
}

func clobber() int {
	var a [64]int
	for i := 0; i < 64; i++ {
		a[i] = 1000 + i
	}
	var m @[]int = make_slice(int, 16)
	m[0] = a[63]
	return m[0]
}

func main() {
	clobber()
	testing.Println(gInts[0], gInts[1], gInts[2], len(gInts))
	testing.Println(*gBoxes[0].b, *gBoxes[1].b, len(gBoxes))
	testing.Println(gPs[0].a, gPs[0].b, len(gStrs[0]), len(gStrs[1]), cast(int, gStrs[1][2]))
	testing.Println(gSum)
}
