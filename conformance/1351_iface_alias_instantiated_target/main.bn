package "main"

import "pkg/builtins/testing"
import "pkg/home"

// An interface alias whose target is a generic interface's instantiation —
// imported, declared in the imported .bni, and local (declared before the
// generic) — is that instantiation: methods dispatch through it, and an impl
// spelled through the alias implements the instantiation.

interface X = home.Getter[int]

interface LY = L[int]

interface L[T any] {
	Val() T
}

type T struct {
	v int
}

func (t *T) Val() int {
	return t.v * 2
}

impl *T : L[int]

type U struct {
	v int
}

func (u *U) Val() int {
	return u.v + 100
}

impl *U : LY

func main() {
	var s home.S = home.Mk(7)
	var g *X = &s
	testing.Println(g.Get()) // 7
	var t T = T{v: 4}
	var ly *LY = &t
	testing.Println(ly.Val()) // 8
	var ig *home.IG = &s
	testing.Println(ig.Get()) // 7
	var u U = U{v: 5}
	var lu *L[int] = &u
	testing.Println(lu.Val()) // 105
	var tr *home.Tripper[int] = &s
	var r home.Tr = tr.Trip()
	testing.Println(r.a + r.b + r.c) // 24
}
