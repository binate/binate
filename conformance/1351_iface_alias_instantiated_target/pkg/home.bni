package "pkg/home"

interface Getter[T any] {
	Get() T
}

type S struct {
	v int
}

func (s *S) Get() int

impl *S : Getter[int]

// IG is an alias of an instantiation, declared in this .bni.
interface IG = Getter[int]

// IT is an unused alias of Tripper[int], whose method names a type alias: it
// must not change Tripper[int] for its users.
interface IT = Tripper[int]

interface Tripper[T any] {
	Get() T
	Trip() TA
}

type TA = Tr

type Tr struct {
	a int
	b int
	c int
}

func (s *S) Trip() Tr

impl *S : Tripper[int]

func Mk(n int) S
