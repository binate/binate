package "main"

import "pkg/builtins/testing"

// An interface alias of a generic interface's instantiation, declared before
// the types it depends on: its type argument may be a named type, a type
// alias, or an interface declared later; and declaring such an alias — even
// unused — must not change the instantiation for its other uses when the
// generic's methods name a type alias or a later interface.

interface X1 = GA[MyInt]

interface GA[T any] {
	Get() T
}

type MyInt int

type U1 struct {
	v int
}

func (u *U1) Get() MyInt {
	return cast(MyInt, u.v + 1)
}

impl *U1 : GA[MyInt]

interface X2 = GB[A2]

interface GB[T any] {
	Get() T
}

type A2 = Pt

type Pt struct {
	a int
	b int
	c int
}

type U2 struct {
	v int
}

func (u *U2) Get() Pt {
	return Pt{a: u.v, b: u.v + 1, c: u.v + 2}
}

impl *U2 : GB[Pt]

interface X3 = GC[*J3]

interface GC[T any] {
	Get() T
}

interface J3 {
	F() int
}

type K struct {
	n int
}

func (k *K) F() int {
	return k.n
}

impl *K : J3

type U3 struct {
	k K
}

func (u *U3) Get() *J3 {
	return &u.k
}

impl *U3 : GC[*J3]

interface X4 = GD[int]

interface GD[T any] {
	Get() T
	Peer() *J4
}

interface J4 {
	F() int
}

impl *K : J4

type U4 struct {
	v int
	k K
}

func (u *U4) Get() int {
	return u.v
}

func (u *U4) Peer() *J4 {
	return &u.k
}

impl *U4 : GD[int]

interface X5 = GE[int]

interface GE[T any] {
	Get() T
	Trip() A5
}

type A5 = Pt

type U5 struct {
	v int
}

func (u *U5) Get() int {
	return u.v
}

func (u *U5) Trip() Pt {
	return Pt{a: u.v, b: u.v + 1, c: u.v + 2}
}

impl *U5 : GE[int]

func main() {
	var u1 U1 = U1{v: 5}
	var x1 *X1 = &u1
	testing.Println(cast(int, x1.Get())) // 6
	var u2 U2 = U2{v: 5}
	var x2 *X2 = &u2
	var p Pt = x2.Get()
	testing.Println(p.c) // 7
	var u3 U3 = U3{k: K{n: 42}}
	var x3 *X3 = &u3
	var j3 *J3 = x3.Get()
	testing.Println(j3.F()) // 42
	var u4 U4 = U4{v: 3, k: K{n: 43}}
	var g4 *GD[int] = &u4
	testing.Println(g4.Get()) // 3
	var j4 *J4 = g4.Peer()
	testing.Println(j4.F()) // 43
	var u5 U5 = U5{v: 5}
	var g5 *GE[int] = &u5
	var t Pt = g5.Trip()
	testing.Println(t.a + t.b + t.c) // 18
}
