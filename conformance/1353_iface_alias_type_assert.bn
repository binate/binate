package "main"

import "pkg/builtins/testing"

// A type assertion and a type-switch case whose target is an interface alias
// (`interface PA = P`) test for the aliased interface.

interface P {
	Get() int
}

interface PA = P

type U struct {
	v int
}

func (u *U) Get() int {
	return u.v + 100
}

impl *U : P

func main() {
	var u U = U{v: 5}
	var a *any = &u
	p, ok := a.(*PA)
	testing.Println(ok) // true
	if ok { testing.Println(p.Get()) } // 105
	switch v := a.(type) {
	case *PA:
		testing.Println(v.Get()) // 105
	default:
		testing.Println(-1)
	}
}
