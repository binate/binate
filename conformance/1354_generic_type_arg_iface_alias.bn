package "main"

import "pkg/builtins/testing"

// A generic instantiated with a type argument spelled through an interface
// alias (`interface PA = P`) is the same instantiation as with P itself: for a
// generic interface (`H[*PA]` is `H[*P]` — values convert, assertions hit,
// methods dispatch), a generic struct (`Box[*PA]` is `Box[*P]`) and a generic
// function (`idm[@PA]` is `idm[@P]`).

interface P {
	Get() int
}

interface PA = P

interface H[T any] {
	Inner() T
}

type U struct {
	v int
}

func (u *U) Get() int {
	return u.v + 100
}

impl *U : P

type W struct {
	u U
}

func (w *W) Inner() *P {
	return &w.u
}

impl *W : H[*P]

type Box[T any] struct {
	v T
}

func idm[T any](x T) T {
	return x
}

func main() {
	var w W = W{u: U{v: 1}}
	var h *H[*PA] = &w
	testing.Println(h.Inner().Get()) // 101
	var a *any = &w
	var ok bool
	var h2 *H[*PA]
	h2, ok = a.(*H[*PA])
	testing.Println(ok) // true
	if ok { testing.Println(h2.Inner().Get()) } // 101
	var u U = U{v: 2}
	var b1 Box[*P]
	b1.v = &u
	var b2 Box[*PA] = b1
	testing.Println(b2.v.Get()) // 102
	var m @U = make(U)
	m.v = 3
	var mp @PA = m
	testing.Println(idm[@PA](mp).Get()) // 103
	var mq @P = m
	testing.Println(idm[@P](mq).Get()) // 103
}
