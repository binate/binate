package "main"

import "pkg/builtins/testing"

// A generic interface instantiated with a type argument spelled through an
// interface alias (`H[*PA]`, `interface PA = P`) is the same instantiation as
// `H[*P]`.

interface P {
	Get() int
}

interface PA = P

interface H[T any] {
	Inner() T
}

type U struct {
	v int
}

func (u *U) Get() int {
	return u.v + 100
}

impl *U : P

type W struct {
	u U
}

func (w *W) Inner() *P {
	return &w.u
}

impl *W : H[*P]

func main() {
	var w W = W{u: U{v: 1}}
	var h *H[*PA] = &w
	testing.Println(h.Inner().Get()) // 101
}
