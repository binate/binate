package "main"

import "pkg/builtins/testing"
import "pkg/home"

// A generic interface instantiated with a package's own named non-struct type
// (`H[MyN]`, `type MyN int`) is one interface wherever it is spelled: inside
// that package (directly or through an interface alias of the instantiation)
// and in an importer (`home.H[home.MyN]`).  A value boxed on one side
// dispatches on the other.

func main() {
	testing.Println(cast(int, home.KF(6))) // 18
	var u @home.U = home.NewU(2)
	testing.Println(cast(int, u.Sub().F())) // 6
	var k home.K = home.MkK(5)
	var h *home.H[home.MyN] = &k
	testing.Println(cast(int, h.F())) // 15
}
