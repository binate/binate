package "pkg/home"

interface H[T any] {
	F() T
}

// JA is an alias of an instantiation whose type argument is this package's own
// named non-struct type.
interface JA = H[MyN]

type MyN int

type K struct {
	n int
}

func (k *K) F() MyN

impl *K : H[MyN]

type U struct {
	k K
}

func (u *U) Sub() *H[MyN]

func KF(n int) MyN

func NewU(n int) @U

func MkK(n int) K
