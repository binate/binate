package "main"

import "pkg/builtins/testing"

// A blank `_` in a generic declaration's type-parameter list (gen.typeparams)
// binds that parameter without naming it, and any number of parameters may be
// `_` (generic functions, types and interfaces alike).  Each position still
// takes its own type argument: the sizes here differ, so a parameter bound to
// the wrong argument would misplace the fields.

type S struct {
	a int
	b int
}

func second[_ any, T any](x T) T {
	return x
}

func two[_ any, _ any]() int {
	return 2
}

type Tagged[_ any, V any] struct {
	pad int8
	v   V
}

func (t *Tagged[_, V]) Get() V {
	return t.v
}

interface Named[_ any] {
	Name() int
}

type N struct {
	n int
}

func (n *N) Name() int {
	return n.n
}

impl *N : Named[int8]

func main() {
	var s S
	s.a = 11
	s.b = 22
	testing.Println(second[int8, S](s).b) // 22
	testing.Println(two[int8, S]())       // 2
	var t Tagged[int8, S]
	t.v = s
	testing.Println(t.Get().a) // 11
	var n N
	n.n = 5
	var i *Named[int8] = &n
	testing.Println(i.Name()) // 5
}
