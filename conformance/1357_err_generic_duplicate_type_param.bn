package "main"

// A generic declaration's type parameters are fresh names, one per position
// (gen.typeparams): a name declared twice is rejected, for a function, a type
// and an interface.

func pick[T any, T any](x T) T {
	return x
}

type Dup[K any, K any] struct {
	x K
}

interface Two[X any, X any] {
	Get() X
}

func main() {
}
