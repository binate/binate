package "main"

// A blank `_` type parameter names nothing (gen.typeparams): using `_` as a
// type anywhere in the declaration is an undefined type — in a function's
// signature or body, a type's fields, an interface's method signatures, and a
// sibling parameter's constraint.

interface C[X any] {
	Get() X
}

func id[_ any](x _) int {
	return 0
}

func body[_ any]() {
	var y _
	_ = y
}

type Box[_ any] struct {
	x _
}

interface I[_ any] {
	M() _
}

type W[_ any, K C[_]] struct {
	k K
}

func main() {
	var b Box[int]
	_ = b
	var i *I[int]
	_ = i
	var w W[int, int]
	_ = w
	body[int]()
}
