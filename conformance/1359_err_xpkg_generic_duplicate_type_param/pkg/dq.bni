package "pkg/dq"

// Generic declarations in a .bni with a type-parameter name declared twice
// (gen.typeparams): each is rejected when the package is checked, as the same
// declarations in a .bn are.

interface Two[X any, X any] {
	Get() X
}

type Dup[K any, K any] struct {
	x K
}

func pick[T any, T any](x T) T {
	return x
}

type N struct {
	n int64
}

func (n *N) Get() int64

impl *N : Two[int8, int64]
