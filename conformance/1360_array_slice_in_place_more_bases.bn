package "main"

import "pkg/builtins/testing"

// More ways to reach an array whose slice must alias it: through a managed
// pointer, as an element of a slice of arrays, as a package-level variable,
// as a field reached through a pointer parameter and returned, and as a field
// of a generic instantiation's result.  The base expression (and the index in
// it) is evaluated exactly once.  A call result has no storage, so its
// slice views a copy (still readable).

type S struct {
	arr [4]int
}

type Box[T any] struct {
	m [2][4]T
}

var g [4]int

var calls int = 0

func getP(p *([4]int)) *([4]int) {
	calls = calls + 1
	return p
}

func mkBoxP[T any](p *Box[T]) *Box[T] {
	calls = calls + 1
	return p
}

func one() int {
	calls = calls + 1
	return 1
}

func view(p *S) *[]int {
	return p.arr[:]
}

func mk() [4]int {
	var r [4]int
	r[2] = 7
	return r
}

func main() {
	var mp @([4]int) = make([4]int)
	var t *[]int = (*mp)[1:3]
	t[0] = 1

	var rows @[][3]int = make_slice([3]int, 2)
	var u *[]int = rows[1][0:2]
	u[1] = 2

	var w *[]int = g[2:4]
	w[1] = 3

	var s S
	var v *[]int = view(&s)
	v[0] = 4

	var a [4]int
	var x *[]int = (*getP(&a))[0:2]
	x[0] = 5

	var c *[]int = mk()[1:3]

	var derefCalls int = calls
	calls = 0
	var bx Box[int]
	var y *[]int = mkBoxP[int](&bx).m[one()][0:2]
	y[1] = 6

	testing.Println((*mp)[1], rows[1][1], g[3], s.arr[0], a[0], derefCalls, c[1])
	testing.Println(bx.m[1][1], calls)
}
