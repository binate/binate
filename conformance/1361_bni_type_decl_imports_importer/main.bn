package "main"

import "pkg/builtins/testing"
import "pkg/xf"

// A type declared in pkg/xf's .bni resolves under the .bni's own imports —
// `dep` is pkg/p2 there, so TB is int64 — for the package and its importers
// alike, even though one of pkg/xf's .bn files binds `dep` to pkg/p1.

func main() {
	testing.Println(xf.A()) // 101
	testing.Println(xf.B()) // 300000
	var v xf.TB = 100000
	v = v * 3
	testing.Println(cast(int, v)) // 300000
}
