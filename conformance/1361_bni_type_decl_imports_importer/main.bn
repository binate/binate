package "main"

import "pkg/builtins/testing"
import "pkg/xf"

// Declarations in pkg/xf's .bni resolve under the .bni's own imports — `dep` is
// pkg/p2 there, so each is built on int64 — for the package and its importers
// alike, even though one of pkg/xf's .bn files binds `dep` to pkg/p1 (int8).
// Each line computes 100000 * 3, which int8 would truncate.

func main() {
	testing.Println(xf.A()) // 101
	testing.Println(xf.B()) // 300000
	var t xf.TB = 100000
	t = t * 3
	testing.Println(cast(int, t)) // alias
	var n xf.NB = cast(xf.NB, 100000)
	n = n * cast(xf.NB, 3)
	testing.Println(cast(int, n)) // distinct named type
	var s xf.SB
	s.w = 100000
	s.w = s.w * 3
	testing.Println(cast(int, s.w)) // struct field
	var k xf.K = xf.K{n: 100000}
	var i *xf.IB = &k
	testing.Println(cast(int, i.Get())) // interface method result
	testing.Println(cast(int, xf.F())) // function result
	var bx xf.Box[int]
	bx.w = 100000
	bx.w = bx.w * 3
	testing.Println(cast(int, bx.w)) // generic struct field
}
