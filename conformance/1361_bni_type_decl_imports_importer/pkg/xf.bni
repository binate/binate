type NB dep.W

type SB struct {
	w dep.W
}

interface IB {
	Get() dep.W
}

type K struct {
	n int
}

func (k *K) Get() dep.W

impl *K : IB

func F() dep.W

type Box[T any] struct {
	v T
	w dep.W
}

func A() int

func B() int
