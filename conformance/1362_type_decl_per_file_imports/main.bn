package "main"

import "pkg/builtins/testing"
import "pkg/xf"

// A package's type declarations resolve under their own file's imports: two
// .bn files of pkg/xf bind the same alias `dep` to different packages, so
// `type TA = dep.W` is int8 and `type TB = dep.W` is int64.

func main() {
	testing.Println(xf.A()) // 101
	testing.Println(xf.B()) // 300002
}
