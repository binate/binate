package "main"
import "pkg/builtins/testing"

// Boxing strips an OUTER `readonly` from the dynamic type (§11.12 `iface.assert`:
// the boxed value's type "with its `*`/`@`/outer-`readonly` stripped"), and a
// slice's identity is `{ managed | raw, element-readonly?, element-type }`
// (`iface.assert.slice`) — it has no outer-readonly component.  So a boxed
// `readonly @[]readonly char` (the `os.Args()` element type) matches `case
// @[]readonly char:`, and an outer-readonly raw slice matches its unqualified raw
// spelling.  Asserting recovers a by-value copy, so no readonly guarantee is lost.

func roManaged() readonly @[]readonly char {
	var m @[]char = "hi"
	return m
}

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case *[]char:
		return "raw-mutable"
	case *[]readonly char:
		return "raw-readonly"
	default:
		return "default"
	}
}

func main() {
	var a readonly @[]readonly char = roManaged()
	testing.Println(classify(&a)) // mgd-readonly
	var m @[]char = "hi"
	var b readonly @[]char = m
	testing.Println(classify(&b)) // mgd-mutable
	var c readonly *[]readonly char = "hi"
	testing.Println(classify(&c)) // raw-readonly

	var x *any = &a
	got, ok := x.(@[]readonly char)
	if ok && len(got) == 2 && got[0] == 'h' {
		testing.Println("recovered")
	} else {
		testing.Println("not recovered")
	}
}
