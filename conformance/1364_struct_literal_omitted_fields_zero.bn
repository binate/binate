package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A field omitted from a keyed struct literal is zero-initialized with its
// type's zero value (spec decl.var.zero-init) whatever the field's shape:
// false / 0.0 / 0 for scalars (also through a named or readonly wrapper) and
// the all-zero nil for pointers, slices, function values, interface values,
// structs and arrays — plain, named, or readonly.  The literal is built after
// the stack has been filled with junk, so a missing zero store shows.

interface Getter {
	Get() int
}

type Box struct {
	v int
	w int
}

type P *int

type MB @Box

type RBuf *[]int

type MS @[]int

type Fn *func() int

type MFn @func() int

type NF float32

type H struct {
	k   int
	f   float32
	d   readonly float64
	nf  NF
	ok  bool
	bx  Box
	arr [2]@Box
	s   *[]int
	rb  RBuf
	rs  readonly *[]int
	m   @[]int
	ms  MS
	p   P
	rp  readonly *int
	mb  MB
	rmb readonly @Box
	fn  *func() int
	nfn Fn
	mfn MFn
	g   *Getter
	mg  @Getter
	t   int
}

func fill() int {
	var junk [64]int
	for i := 0; i < 64; i++ {
		junk[i] = 777
	}
	return junk[63]
}

func mk() H {
	return H{k: 5, t: 9}
}

func check() int {
	fill()
	var h H = mk()
	testing.Println(h.k, h.t, h.f == 0.0, h.d == 0.0, cast(float32, h.nf) == 0.0, h.ok)
	testing.Println(h.bx.v, h.bx.w, h.arr[0] == nil, h.arr[1] == nil)
	testing.Println(len(h.s), len(h.rb), len(h.rs), len(h.m), len(h.ms))
	testing.Println(h.p == nil, h.rp == nil, h.mb == nil, h.rmb == nil)
	testing.Println(present(h.fn), present(h.nfn), present(h.mfn), present(h.g), present(h.mg))
	return h.k
}

func main() {
	check()
	var base int = rt.LiveBlocks()
	var k int = check()
	testing.Println(k, rt.LiveBlocks() - base)
}
