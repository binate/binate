package "main"

import "pkg/builtins/testing"

// An array or slice may be indexed — and sliced — by any integer type (spec
// expr.index), including one narrower than int (int8, uint8, int16, uint16, or
// a named / readonly one).  The index is converted to int by its own
// signedness: a uint8 of 200 indexes element 200 (not -56), for reads,
// writes, multi / parallel assignment, `&a[i]`, and slice bounds.  A
// make_slice length may be such an integer too.

type Idx uint8

func pair(a int, b int) (int, int) { return a, b }

func main() {
	var big [256]int
	for i := 0; i < 256; i++ {
		big[i] = i * 10
	}
	var u8 uint8 = 200
	var i8 int8 = 3
	var u16 uint16 = 255
	var i16 int16 = 7
	var n Idx = 201
	var r readonly uint8 = 202
	testing.Println(big[u8], big[i8], big[u16], big[i16], big[n], big[r])

	var s @[]int = make_slice(int, 256)
	s[u8] = 1
	s[i8] = 2
	var p *int = &s[n]
	*p = 3
	s[i16], s[u16] = pair(4, 5)
	var x int
	x, s[r] = 6, 7
	testing.Println(s[200], s[3], s[201], s[7], s[255], s[202], x)

	var lo int8 = 2
	var hi uint8 = 5
	var sub *[]int = big[lo:hi]
	var ssub *[]int = s[lo:hi]
	testing.Println(len(sub), sub[0], len(ssub), ssub[1])

	var ml @[]int = make_slice(int, u8)
	var ms @[]int = make_slice(int, i8)
	testing.Println(len(ml), len(ms))
}
