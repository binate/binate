package "main"

import "pkg/builtins/testing"

// A blank type declaration `type _ …` binds no name: any number of them may
// appear, alone or in a group, in any form (struct — including several with
// managed fields, which would otherwise need helpers under the same name —
// array, distinct, alias).  The type is still checked, so each one asserts that
// its type is valid; here several refer to a type declared after them.

type _ struct {
	a int
	b @[]char
	c Later
}

type _ struct {
	s @[]char
	t @Later
}

type _ [4]int8

type _ int

type _ = Later

type (
	_ uint16
	_ = *Later
	_ = *[]int
)

type Later struct {
	x int
}

func main() {
	var l Later
	l.x = 3
	testing.Println(l.x) // 3
}
