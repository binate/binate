package "main"

// A blank type declaration binds no name: `_` is still not a type — in a
// package-level declaration, a function body, or a signature that also has a
// blank type parameter.

type _ struct {
	a int
}

var g _

func id[_ any](x _) int {
	return 0
}

func main() {
	var y _
	_ = y
}
