package "main"

import "pkg/builtins/testing"
import "pkg/bt"

// Blank type declarations across packages: pkg/bt declares several (in its
// .bni and .bn), and main declares its own, referring to an imported type.

type _ = bt.Pub

type _ struct {
	q bt.Pub
}

func main() {
	var p bt.Pub = bt.Make(7)
	testing.Println(p.v) // 7
}
