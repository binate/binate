package "main"

import "pkg/builtins/testing"
import "pkg/sel"

// A build-gated import in one file of a package with several .bn files is
// dropped for a target it excludes, exactly as in a single-file package: the
// excluded package is neither loaded nor in that file's scope.  (The gate here
// is false on every target.)

func main() {
	testing.Println(sel.A()) // 7
	testing.Println(sel.B()) // 8
}
