package "main"

import "pkg/builtins/testing"

import "pkg/c"

// An imported untyped constant keeps its exact value (2^64-1, not the -1 its
// 64-bit pattern reads as), both where the checker records the value and where
// IR-gen evaluates it itself: the imported group's bare members Y and Z, which
// repeat BIG >> (60 + iota) at their own iota.  It stays untyped for its
// importers, as an in-package one does, so it can initialize a uint64.
func main() {
	testing.Println(c.X, c.Y, c.Z)
	var big uint64 = c.BIG
	testing.Println(big >> 63)
}
