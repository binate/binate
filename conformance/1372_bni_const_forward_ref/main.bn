package "main"

import "pkg/builtins/testing"

import "pkg/bf"

// An imported constant naming a constant declared later in its .bni has its
// value for the importer (a value, an array length, an operand) and for the
// declaring package.
func main() {
	var a [bf.X2]int
	testing.Println(bf.X, bf.X1, bf.X2, len(a), bf.Get(), bf.X2 * 10, cast(int, bf.W))
}
