package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// `cast` between function-value types of the same signature: the identity
// cast, a managed function value to its raw form (a borrow — no reference is
// taken, so the closure is released once, by its owner), and casts to named /
// readonly named function-value types.  Each yields a callable value.

type Fn *func(int) int

type RFn readonly *func(int) int

type MFn @func(int) int

func dbl(n int) int { return n * 2 }

func mkAdder(k int) @func(int) int {
	return func(n int) int { return n + k }
}

func useCasts() int {
	var f *func(int) int = dbl
	var g *func(int) int = cast(*func(int) int, f)
	var mf @func(int) int = mkAdder(100)
	var rf *func(int) int = cast(*func(int) int, mf)
	var nf Fn = cast(Fn, f)
	var rn RFn = cast(RFn, f)
	var nm MFn = cast(MFn, mf)
	return g(21) + rf(4) + nf(5) + rn(6) + nm(7)
}

func main() {
	// One warm-up call first: the bytecode VM allocates each call site's
	// function-value table on first use and keeps it, which is not a leak.
	useCasts()
	var base int = rt.LiveBlocks()
	var r int = useCasts()
	var delta int = rt.LiveBlocks() - base
	testing.Println(r)
	testing.Println(delta)
}
