package "main"

import "pkg/builtins/testing"
import "pkg/xf"

// More declarations in pkg/xf's .bni that resolve under the .bni's own imports
// (`dep` is pkg/p2 — W int64, SZ 2 — while pkg/xf/a.bn binds `dep` to pkg/p1 —
// W int8, SZ 1): a const, an extern var, a generic function's and a
// generic-receiver method's bodies, and an interface extending `dep.I`.  Each
// W value is 100000 * 3, which int8 would truncate.

func main() {
	testing.Println(xf.A()) // 1 (a.bn's dep is pkg/p1)
	testing.Println(xf.C) // 2
	xf.Init()
	testing.Println(cast(int, xf.X)) // extern var
	testing.Println(cast(int, xf.Gen[int](1))) // generic function body
	var b xf.Box[int]
	testing.Println(cast(int, b.Get())) // generic-receiver method body
	var k xf.K = xf.K{n: 100000}
	var j *xf.J = &k
	testing.Println(cast(int, j.N())) // interface method
	testing.Println(cast(int, j.M())) // method inherited from dep.I
}
