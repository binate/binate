package "main"

import "pkg/builtins/testing"
import "pkg/home"

// A type assertion or type-switch case whose target is an interface alias
// tests for the interface the alias names, in every spelling: an imported
// alias, a local alias of an imported interface, an alias of an alias, an alias
// of a generic interface's instantiation, and the managed form.  A type that
// does not implement the aliased interface still misses.

interface LA = home.P

interface LB = LA

interface GI = home.G[int]

type U struct {
	v int
}

func (u *U) Get() int {
	return u.v + 100
}

func (u *U) Val() int {
	return u.v * 2
}

impl *U : home.P, home.G[int]

type N struct {
	v int
}

func (n *N) Other() int {
	return n.v
}

func check(a *any) {
	var p *home.PA
	var ok bool
	p, ok = a.(*home.PA)
	testing.Println(ok)
	if ok { testing.Println(p.Get()) }
	switch v := a.(type) {
	case *LB:
		testing.Println(v.Get())
	default:
		testing.Println(-1)
	}
	var g *GI
	g, ok = a.(*GI)
	testing.Println(ok)
	if ok { testing.Println(g.Val()) }
}

func main() {
	var u U = U{v: 5}
	check(&u) // true 105 105 true 10
	var n N = N{v: 1}
	check(&n) // false -1 false
	var m @U = make(U)
	m.v = 7
	var am @any = m
	var mp @LA
	var ok bool
	mp, ok = am.(@LA)
	testing.Println(ok) // true
	if ok { testing.Println(mp.Get()) } // 107
}
