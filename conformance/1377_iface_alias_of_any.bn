package "main"

import "pkg/builtins/testing"

// An interface alias of the universe `any` is `any`: assertions and
// type-switch cases on it hit, and values boxed into it (raw and managed) are
// `any` values.

interface A = any

type U struct {
	v int
}

func take(x *any) bool {
	var u *U
	var ok bool
	u, ok = x.(*U)
	return ok && u.v == 3
}

func main() {
	var u U = U{v: 3}
	var a *any = &u
	var p *A
	var ok bool
	p, ok = a.(*A)
	testing.Println(ok) // true
	switch a.(type) {
	case *A:
		testing.Println(1)
	default:
		testing.Println(-1)
	}
	var b *A = &u
	testing.Println(take(b)) // true
	testing.Println(take(p)) // true
	var m @U = make(U)
	m.v = 3
	var ma @A = m
	var mx @any = ma
	var mu @U
	mu, ok = mx.(@U)
	testing.Println(ok && mu.v == 3) // true
}
