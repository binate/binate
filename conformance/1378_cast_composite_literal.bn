package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A struct or array composite literal can be the operand of `cast` /
// `unsafe_cast` / `bit_cast`, exactly like a variable holding the same value:
// to its own type, a named type over it, a readonly or named-over-readonly
// wrapper, and a same-layout struct.  A literal with a managed field is
// retained by the cast result and released once.

type H struct {
	n int
	m int
}

type H2 H

type RH readonly H

type G struct {
	a int
	b int
}

type B struct {
	p @int
	k int
}

type B2 B

func managed() int {
	var r B2 = cast(B2, B{p: box(40), k: 2})
	return *r.p + r.k
}

func main() {
	var h H = cast(H, H{n: 3, m: 4})
	var h2 H2 = cast(H2, H{n: 5, m: 6})
	var rh RH = cast(RH, H{n: 7, m: 8})
	var ro readonly H = cast(readonly H, H{n: 9, m: 10})
	var u H2 = unsafe_cast(H2, H{n: 11, m: 12})
	testing.Println(h.n, h.m, h2.n, h2.m, rh.n, rh.m, ro.n, ro.m, u.n, u.m)
	var a [2]int = cast([2]int, [2]int{13, 14})
	var g G = bit_cast(G, H{n: 15, m: 16})
	var xa [2]int = bit_cast([2]int, H{n: 17, m: 18})
	testing.Println(a[0], a[1], g.a, g.b, xa[0], xa[1])
	managed()
	var base int = rt.LiveBlocks()
	var v int = managed()
	var delta int = rt.LiveBlocks() - base
	testing.Println(v, delta)
}
