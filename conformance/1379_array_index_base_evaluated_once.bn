package "main"

import "pkg/builtins/testing"

// Indexing an array reached through a call — a field of a pointer or value
// result, a dereference of a returned pointer, a field of a generic
// instantiation's result — evaluates the call exactly once and reads the
// right element; so does slicing a field of a value result.

type S struct {
	m [3]int
}

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

type H struct {
	arr [2]*I
}

func mkHP(p *H) *H {
	n = n + 1
	return p
}

type Box[T any] struct {
	m [3]T
}

var n int = 0

func mkSP(p *S) *S {
	n = n + 1
	return p
}

func mkS() S {
	n = n + 1
	var s S
	s.m[1] = 8
	return s
}

func getP(p *([3]int)) *([3]int) {
	n = n + 1
	return p
}

func mkBoxP[T any](p *Box[T]) *Box[T] {
	n = n + 1
	return p
}

func main() {
	var s S
	s.m[1] = 5
	var a [3]int
	a[1] = 6
	var bx Box[int]
	bx.m[1] = 7
	var r1 int = mkSP(&s).m[1]
	testing.Println("ptr-call field", n, r1)
	n = 0
	var r2 int = (*getP(&a))[1]
	testing.Println("deref call", n, r2)
	n = 0
	var r3 int = mkBoxP[int](&bx).m[1]
	testing.Println("generic call field", n, r3)
	n = 0
	var r4 int = mkS().m[1]
	testing.Println("value call field", n, r4)
	n = 0
	var t *[]int = mkS().m[0:2]
	testing.Println("value call field slice", n, t[1])
	n = 0
	var t2 T
	t2.x = 4
	var h H
	h.arr[1] = &t2
	testing.Println("iface elem method", mkHP(&h).arr[1].Foo(), n)
	n = 0
	var u8i uint8 = 1
	var i8i int8 = 1
	testing.Println("narrow index", mkSP(&s).m[u8i], (*getP(&a))[i8i], n)
	var mp @([3]int) = make([3]int)
	(*mp)[2] = 9
	testing.Println((*mp)[2], s.m[1], a[1])
}
