package "main"

import "pkg/builtins/testing"

// A deferred method call whose receiver has a named-distinct type calls the
// method declared on that named type: a named scalar (`type Money int`), a
// named struct over another struct (`type NP Pt`), a named pointer
// (`type PS *S`), through a pointer to a named type (also dereferenced
// explicitly, `(*pn).Show2()`), and through an alias of one.  The deferred calls run in reverse order at function exit, with the
// receiver evaluated at the defer statement.

type Money int

func (m Money) Show() { testing.Println("money", cast(int, m)) }

type Pt struct {
	x int
}

type NP Pt

func (n NP) Show2() { testing.Println("np", n.x) }

func (n *NP) Bump() { testing.Println("bump", n.x) }

type S struct {
	v int
}

type PS *S

func (p PS) Get() { testing.Println("ps", p.v) }

type AM = Money

func run() {
	var m Money = 5
	defer m.Show()
	var n NP
	n.x = 7
	defer n.Show2()
	var pn *NP = &n
	defer pn.Bump()
	defer (*pn).Show2()
	var s S
	s.v = 9
	var ps PS = &s
	defer ps.Get()
	var am AM = 11
	defer am.Show()
	m = 6
	n.x = 8
	testing.Println("body")
}

func main() {
	run()
}
