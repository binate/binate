package "main"

import "pkg/builtins/testing"

import "pkg/q"

func takeF32(x float32) int {
	return cast(int, x * 100.0)
}

// An imported floating-point constant expression is evaluated in its own
// package: its names are that package's constants, not an importer's local of
// the same name.
func main() {
	const QA = 100.0
	var QC float64 = 9.0
	testing.Println(cast(int, q.QB * 10.0), takeF32(q.QD), cast(int, q.Get() * 10.0), cast(int, QA + QC))
}
