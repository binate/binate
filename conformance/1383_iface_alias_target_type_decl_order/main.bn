package "main"

import "pkg/builtins/testing"
import "pkg/lib"

// A type declaration naming an interface alias of a generic instantiation
// (`type Y = Box[*X]`, `interface X = G[T2]`) before the type its target's
// type argument names (`type T2 = float64`) is declared: X is still G[float64]
// — in an imported package, locally, and through an alias of an alias.

type YL = Box[*XL]

type YZ = Box[*Z]

interface Z = XL

interface XL = G[T2]

type T2 = float64

interface G[T any] {
	Get() T
}

type Box[T any] struct {
	v T
}

type U struct {
	f float64
}

func (u *U) Get() float64 {
	return u.f
}

impl *U : lib.G[float64], G[float64]

func main() {
	var u U = U{f: 2.5}
	var x *lib.X = &u
	testing.Println(cast(int, x.Get() * 10.0)) // 25
	var xl *XL = &u
	testing.Println(cast(int, xl.Get() * 10.0)) // 25
	var z *Z = &u
	testing.Println(cast(int, z.Get() * 10.0)) // 25
}
