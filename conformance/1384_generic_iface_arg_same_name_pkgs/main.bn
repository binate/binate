package "main"

import "pkg/builtins/testing"
import "pkg/a"
import "pkg/b"

// Two packages' interfaces of the same name (a.P, b.P) are different type
// arguments: H[*a.P] and H[*b.P] are different instantiations, each with its
// own methods, and a value implementing one does not implement the other.

interface H[T any] {
	Inner() T
}

type UA struct {
	v int
}

func (u *UA) Get() int {
	return u.v + 100
}

impl *UA : a.P

type UB struct {
	v int
}

func (u *UB) Name() int {
	return u.v + 200
}

func (u *UB) Extra() int {
	return u.v + 300
}

impl *UB : b.P

type WA struct {
	u UA
}

func (w *WA) Inner() *a.P {
	return &w.u
}

impl *WA : H[*a.P]

type WB struct {
	u UB
}

func (w *WB) Inner() *b.P {
	return &w.u
}

impl *WB : H[*b.P]

func main() {
	var wa WA = WA{u: UA{v: 1}}
	var wb WB = WB{u: UB{v: 2}}
	var ha *H[*a.P] = &wa
	var hb *H[*b.P] = &wb
	testing.Println(ha.Inner().Get()) // 101
	testing.Println(hb.Inner().Name()) // 202
	testing.Println(hb.Inner().Extra()) // 302
	var x *any = &wa
	var ok bool
	_, ok = x.(*H[*b.P])
	testing.Println(ok) // false
}
