package "main"

import "pkg/builtins/testing"

// A named type over another named scalar, a readonly scalar or an alias of one
// — `type N M`, `type P N`, `type R readonly int8`, `type RN readonly N`,
// `type NR R`, `type NA A` with `type A = int16`, in any declaration order —
// takes untyped constants in const and var declarations, range-checked against
// the scalar at the bottom of the chain, exactly like a named type over a
// builtin scalar.

type N M

type P N

type M int8

type R readonly int8

type RN readonly N

type NR R

type NA A

type A = int16

const cn N = 6

const cp P = -7

const cr R = 5

const crn RN = 4

const cnr NR = 3

const cna NA = 300

func main() {
	var x R = 5
	var z N = 8
	var q P = -128
	var w NR = 127
	testing.Println(cast(int, cn), cast(int, cp), cast(int, cr), cast(int, crn), cast(int, cnr),
			cast(int, cna))
	testing.Println(cast(int, x), cast(int, z), cast(int, q), cast(int, w))
}
