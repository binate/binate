package "main"

import "pkg/builtins/testing"
import _ "pkg/side"
import "pkg/bl"

// The blank identifier `_` binds nothing, wherever it appears in a binding
// position: any number of blank functions, interfaces (and interface aliases)
// and constants may be declared (each is still checked), and parameters,
// receivers, range variables and type-switch binders may be `_`.  A blank
// import still initializes its package.

func _() int {
	return 1
}

func _(x int) int {
	return x
}

interface _ {
	M() int
}

interface Shape {
	Area() int
}

interface _ = Shape

const K = 4

const _ = K + 1

const _ int = 2

const (
	_ = iota
	One
	_
	Three
)

type Sq struct {
	s int
}

func (_ *Sq) Name() int {
	return 7
}

func (q *Sq) Area() int {
	return q.s * q.s
}

impl *Sq : Shape

func pick(_ int, b int, _ int) int {
	return b
}

func sum(xs *[]int) int {
	var t int = 0
	for _, v in xs {
		t = t + v
	}
	return t
}

func count(xs *[]int) int {
	var n int = 0
	for i, _ in xs {
		n = i + 1
	}
	return n
}

func kind(s *Shape) int {
	switch _ := s.(type) {
	case *Sq:
		return 1
	}
	return 0
}

func main() {
	testing.Println(pick(1, 2, 3)) // 2
	var xs [3]int
	xs[0] = 1
	xs[1] = 2
	xs[2] = 3
	testing.Println(sum(xs[:]))   // 6
	testing.Println(count(xs[:])) // 3
	var q Sq
	q.s = 3
	testing.Println(q.Name()) // 7
	var sh *Shape = &q
	testing.Println(sh.Area()) // 9
	testing.Println(kind(sh))  // 1
	testing.Println(One)       // 1
	testing.Println(Three)     // 3
	testing.Println(bl.Value()) // 5
}
