package "main"

import "pkg/builtins/testing"

// `_` binds nothing, so it has no value: reading it is an error wherever it
// appears — after a blank variable, parameter, short-variable binder or range
// variable alike.

func f(_ int) int {
	return _
}

func main() {
	var _ int = 3
	x := _
	_, y := 1, 2
	testing.Println(_)
	for _, v in [2]int{1, 2} {
		testing.Println(v + _)
	}
	_ = x
	_ = y
}
