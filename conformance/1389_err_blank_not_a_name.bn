package "main"

// A blank declaration binds no name, so `_` never resolves: not as a function,
// an interface, a constant (in an array length or another constant), or a
// generic function.

func _() int {
	return 1
}

func _[T any](x T) T {
	return x
}

interface _ {
	M() int
}

const _ = 4

type T struct {
	a int
}

func (t *T) M() int {
	return t.a
}

impl *T : _

var arr [_]int

const K = _ + 1

func main() {
	_()
	var x *_
	_[int](3)
}
