package "main"

import "pkg/builtins/testing"
import _ "pkg/bq"
import bp "pkg/bq"

// Neither a blank import nor a package's blank declarations (a generic one
// included) bind `_`: `_.X`, `bp._` and `bp._[int]` are errors.

func main() {
	testing.Println(_.Something())
	testing.Println(bp._())
	var v int = bp._
	_ = v
	var w *bp._[int]
	_ = w
}
