package "main"

// A blank declaration binds no name but is still checked: each constant (not
// only the first), a function's signature and body, an interface's methods,
// and a variable's type (with or without an initializer).

const _ = 1

const _ int = "x"

const _ = Undefined1

func _(x Undefined2) {
}

func _() {
	undefined3()
}

interface _ {
	M(y Undefined4)
}

var _ Undefined5

func main() {
	var _ Undefined6
}
