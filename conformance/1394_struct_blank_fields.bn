package "main"

import "pkg/builtins/testing"

// A struct field named `_` is unnamed padding: it takes its place in the layout
// like any field (a managed one included), any number may appear, and a keyed
// literal leaves it zero while a positional literal fills it (the one way to
// give padding a non-zero value).  Copies and a managed blank field are handled
// like any other field.

type Hdr struct {
	tag  int8
	_    [3]uint8
	size int32
}

type Rec struct {
	_    int64
	name @[]char
	_    @[]char
	n    int
	_    [2]int16
}

// Embedded fields (bare types) carry no name; any number may appear.
type E struct {
	Hdr
	Rec
}

// Padding a positional literal fills.
type P struct {
	a uint8
	_ [3]uint8
	b uint32
}

func mk(n int) Rec {
	return Rec{name: "rec", n: n}
}

func main() {
	testing.Println(sizeof(Hdr)) // 8
	var h Hdr = Hdr{tag: 1, size: 70000}
	testing.Println(h.tag) // 1
	testing.Println(h.size) // 70000
	var r Rec = mk(5)
	var r2 Rec = r
	testing.Println(r2.n) // 5
	testing.Println(len(r2.name)) // 3
	var z Rec = Rec{}
	testing.Println(z.n) // 0
	var a struct {
		_ int
		v int
	}
	a.v = 9
	testing.Println(a.v) // 9
	var e E
	testing.Println(sizeof(E) == sizeof(Hdr) + sizeof(Rec)) // true
	_ = e
	var p P = P{1, [3]uint8{7, 8, 9}, 5}
	var raw [8]uint8 = bit_cast([8]uint8, p)
	testing.Println(raw[1]) // 7
	testing.Println(raw[3]) // 9
	testing.Println(p.b)    // 5
}
