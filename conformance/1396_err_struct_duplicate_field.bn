package "main"

// A struct's field names are distinct (blank `_` fields aside): a name declared
// twice is rejected, in a named struct, an anonymous one and a generic one.

type S struct {
	a int
	a int8
}

// A generic struct's field names are checked at its declaration, instantiated
// or not.
type G[T any] struct {
	c T
	c int
}

func main() {
	var t struct {
		b int
		b bool
	}
	_ = t
	var s S
	_ = s
}
