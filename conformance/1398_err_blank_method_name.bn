package "main"

// A method exists to be called by name, or to fill an interface's method set,
// so neither a method nor an interface method may be named `_` — on a plain
// type, a generic type, a plain interface or a generic interface.

type T struct {
	a int
}

func (t *T) _() int {
	return t.a
}

type Box[U any] struct {
	v U
}

func (b *Box[U]) _() U {
	return b.v
}

interface I {
	_() int
}

interface G[X any] {
	_() X
}

func main() {
}
