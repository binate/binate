package "main"

import "pkg/builtins/testing"

// A package-level type may shadow a predeclared type name throughout the
// package: here `int16` is an alias of int8 and `uint32` a distinct type over
// uint8, so their arithmetic wraps at 8 bits and S is three bytes.

type int16 = int8

type uint32 uint8

type S struct {
	a int16
	b uint32
	c int16
}

func main() {
	var v int16 = 100
	v = v + 100
	var u uint32 = 200
	u = u + 100
	var s S
	s.a = -1
	s.b = 255
	testing.Println(cast(int, v), cast(int, u), sizeof(int16), sizeof(uint32), sizeof(S))
	testing.Println(cast(int, s.a), cast(int, s.b), cast(int, s.c))
}
