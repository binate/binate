package "main"

import "pkg/builtins/testing"

type Node struct {
	Val int
}

func main() {
	// Store managed pointer in array, then write field through index
	var arr [2]@Node
	arr[0] = make(Node)
	arr[0].Val = 42
	arr[1] = make(Node)
	arr[1].Val = 99

	testing.Println(arr[0].Val)
	testing.Println(arr[1].Val)

	// Overwrite through index
	arr[0].Val = 77
	testing.Println(arr[0].Val)
}
