package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A parallel short variable declaration `a, b := e1, e2` evaluates every
// right-hand side, left to right, before binding any name, then binds each
// (decl.shortvar): every value lands in its own variable, a blank target's
// right-hand side still runs, rebinding names in the same scope reads their old
// values (a swap), and managed values, strings, composite literals and function
// references bind as in the single form — each owned exactly once (no leak).

type Box struct {
	v int
}

type Pair struct {
	name @[]char
	n    int
}

func bump(t int) int {
	testing.Println(t)
	return t * 10
}

func add(x int, y int) int {
	return x + y
}

func sub(x int, y int) int {
	return x - y
}

// churn binds managed values, string copies and managed-field literals in
// parallel, and rebinds them; every one must be released at scope exit.
func churn() int {
	p, q := make(Box), make(Box)
	s, t := "ab", "cde"
	u, v := Pair{name: "k", n: 1}, Pair{name: "long", n: 2}
	p, u := q, v
	return p.v + len(s) + len(t) + len(u.name) + q.v
}

func main() {
	a, b := 2, 3
	testing.Println(a) // 2
	testing.Println(b) // 3
	c, d := bump(1), bump(2) // prints 1 then 2
	testing.Println(c) // 10
	testing.Println(d) // 20
	_, w := bump(3), 4 // prints 3
	testing.Println(w) // 4
	a, b := b, a
	testing.Println(a) // 3
	testing.Println(b) // 2
	x := 7
	x, y := 1, x
	testing.Println(x) // 1
	testing.Println(y) // 7
	p, q := make(Box), make(Box)
	p.v = 5
	q.v = 6
	testing.Println(p.v + q.v) // 11
	s, t := "ab", "cde"
	testing.Println(len(s) + len(t)) // 5
	u, v := Pair{name: "k", n: 1}, Pair{name: "long", n: 2}
	testing.Println(len(u.name) + v.n) // 3
	f, g := add, sub
	testing.Println(f(5, 3) + g(5, 3)) // 10
	var base int = rt.LiveBlocks()
	for i := 0; i < 100; i++ {
		churn()
	}
	testing.Println(rt.LiveBlocks() == base) // true
}
