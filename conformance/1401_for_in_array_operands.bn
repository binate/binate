package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A range loop over an array (stmt.for.in) works for any array operand, not only
// a variable: an addressable one (a field, an element of an array of arrays,
// `*p`, a composite literal, a global) is ranged in place — the loop reads each
// element at its iteration, so a write to a later element is seen — and an
// array value (a call result) is evaluated once and ranged as a copy.  A
// temporary operand — an array or managed-slice call result, a composite
// literal — stays alive for the whole loop (nested loops included), managed
// elements are retained per iteration and released (no leak), and a loop over
// a global right after another loop is laid out correctly.  A temporary the
// header only borrows from — a raw view of a managed call result — also stays
// alive until the loop ends, however much the body allocates; and the stack
// space the header's evaluation used is reclaimed before the loop, even when
// the body runs nothing that would reclaim it (the VM's stack would otherwise
// overflow).

type Row [3]int

type S struct {
	arr [3]int
}

var global [2]int = [2]int{8, 9}

var calls int = 0

func three() [3]int {
	calls = calls + 1
	return [3]int{7, 8, 9}
}

func names() [2]@[]char {
	return [2]@[]char{"ab", "cde"}
}

func mkSlice() @[]@[]char {
	return @[]@[]char{"ab", "cde", "f"}
}

func sum(xs *[]int) int {
	var t int = 0
	for _, v in xs {
		t = t + v
	}
	return t
}

func mkInts() @[]int {
	return @[]int{1, 2, 3}
}

func mkS() @S {
	var m @S = make(S)
	m.arr[0] = 4
	m.arr[1] = 5
	m.arr[2] = 6
	return m
}

func view(xs *[]int) *[]int {
	return xs
}

// overwrite allocates blocks the size of mkInts's and mkS's, so a block either
// freed too early would be reused and its elements overwritten.
func overwrite() {
	for i := 0; i < 20; i++ {
		var x @[]int = @[]int{7777, 8888, 9999}
		var m @S = make(S)
		m.arr[1] = 5555
		_ = x
		_ = m
	}
}

func viewTemps() int {
	var t int = 0
	for x in view(mkInts()) {
		overwrite()
		t = t * 10 + x
	}
	for x in mkS().arr[:] {
		overwrite()
		t = t * 10 + x
	}
	return t
}

type Big struct {
	pad [4096]int
	two [2]int
}

func mkBig() Big {
	var b Big
	b.two[1] = 1
	return b
}

// bigHeaders ranges 400 times over a field of a 32 KiB call result, with an
// empty body: about 13 MiB of results in all.
func bigHeaders() {
	for i := 0; i < 400; i++ {
		for x in mkBig().two {
		}
	}
}

func churn() int {
	var n int = 0
	for s in names() {
		n = n + len(s)
	}
	for s in [2]@[]char{"x", "yz"} {
		n = n + len(s)
	}
	return n
}

func main() {
	for x in [2]int{1, 2} {
		testing.Println(x) // 1, 2
	}
	var t int = 0
	for x in three() {
		t = t + x
	}
	testing.Println(t)     // 24
	testing.Println(calls) // 1
	var s S
	s.arr[0] = 4
	s.arr[1] = 5
	s.arr[2] = 6
	for i, x in s.arr {
		if i == 0 {
			s.arr[2] = 60
		}
		testing.Println(x) // 4, 5, 60
	}
	var grid [2][3]int
	grid[1][0] = 1
	grid[1][2] = 3
	for x in grid[1] {
		testing.Println(x) // 1, 0, 3
	}
	var p *([3]int) = &s.arr
	var u int = 0
	for x in *p {
		u = u + x
	}
	testing.Println(u) // 69
	var r Row = Row{1, 1, 1}
	var c int = 0
	for _ in r {
		c = c + 1
	}
	testing.Println(c) // 3
	for x in global {
		testing.Println(x) // 8, 9
	}
	var arr [3]int = [3]int{2, 3, 4}
	testing.Println(sum(arr[:])) // 9
	var ms int = 0
	for s in mkSlice() {
		ms = ms + len(s)
		testing.Println(len(s)) // 2, 3, 1
	}
	testing.Println(ms) // 6
	var nn int = 0
	for a in mkSlice() {
		for b in names() {
			nn = nn + len(a) * len(b)
		}
	}
	testing.Println(nn) // 30
	var g2 int = 0
	for x in r {
		g2 = g2 + x
	}
	for x in global {
		g2 = g2 + x
	}
	testing.Println(g2)          // 20
	testing.Println(viewTemps()) // 123456
	bigHeaders()
	testing.Println("big headers") // big headers
	var base int = rt.LiveBlocks()
	var total int = 0
	for i := 0; i < 50; i++ {
		total = total + churn()
		if viewTemps() != 123456 {
			total = 0
		}
	}
	testing.Println(total)                   // 400
	testing.Println(rt.LiveBlocks() == base) // true
}
