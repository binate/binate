package "main"

import "pkg/builtins/testing"

// A generic function instantiation discarded into a blank target — an
// assignment, a `var _` declaration, a blank element of a short variable
// declaration, a lone blank `:=` — is evaluated (stmt.assign.blank,
// decl.blank) and execution continues with the next statement.

func Ident[T any](x T) T {
	return x
}

func main() {
	_ = Ident[int]
	testing.Println("assign")
	var _ = Ident[int]
	testing.Println("var")
	a, _ := 1, Ident[int]
	testing.Println(a)
	_ := Ident[@[]char]
	testing.Println("short var")
}
