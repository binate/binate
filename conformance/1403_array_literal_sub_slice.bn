package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A composite literal is addressable (it has storage — expr.addressable), so
// an array literal is sliced and indexed in place: sub-slicing it yields a raw
// slice viewing the literal's elements (type.array.index-slice), inside an
// expression and as a range loop operand; an element read, or borrowed into a
// raw interface value (as testing.Println takes its arguments), is the
// literal's element; a field of a struct literal is sliced the same way; and a
// literal of managed elements sliced for a call is released once the
// statement ends (no leak), as is one whose element is bound.

type P struct {
	arr [2]int
}

func digits(xs *[]int) int {
	var t int = 0
	for i := 0; i < len(xs); i++ {
		t = t * 10 + xs[i]
	}
	return t
}

func lens(xs *[]@[]char) int {
	var t int = 0
	for i := 0; i < len(xs); i++ {
		t = t * 10 + len(xs[i])
	}
	return t
}

func main() {
	testing.Println(digits([3]int{7, 8, 9}[:])) // 789
	testing.Println(len([3]int{1, 2, 3}[1:])) // 2
	testing.Println(digits([4]int{1, 2, 3, 4}[1:3])) // 23
	for x in ([3]int{4, 5, 6})[:] {
		testing.Println(x) // 4, 5, 6
	}
	var x int = [3]int{4, 5, 6}[2]
	testing.Println(x) // 6
	testing.Println([3]int{4, 5, 6}[1]) // 5
	testing.Println(digits(P{arr: [2]int{3, 4}}.arr[:])) // 34
	var base int = rt.LiveBlocks()
	var t int = 0
	for i := 0; i < 10; i++ {
		t = lens([2]@[]char{"ab", cast(@[]char, "cde")}[:])
		var e @[]char = [2]@[]char{"x", cast(@[]char, "yz")}[1]
		t = t * 10 + len(e)
	}
	testing.Println(t) // 232
	testing.Println(*&[3]int{4, 5, 6}[2]) // 6
	testing.Println(rt.LiveBlocks() == base) // true
}
