package "main"

import "pkg/builtins/testing"

// Sub-slicing a composite-literal array (addressable: it has storage, per the
// addressability rules of expr.unary.addr) yields a raw slice viewing the
// literal's elements (type.array.index-slice), inside an expression and as a
// range loop operand.

func digits(xs *[]int) int {
	var t int = 0
	for i := 0; i < len(xs); i++ {
		t = t * 10 + xs[i]
	}
	return t
}

func main() {
	testing.Println(digits([3]int{7, 8, 9}[:])) // 789
	testing.Println(len([3]int{1, 2, 3}[1:])) // 2
	testing.Println(digits([4]int{1, 2, 3, 4}[1:3])) // 23
	for x in ([3]int{4, 5, 6})[:] {
		testing.Println(x) // 4, 5, 6
	}
}
