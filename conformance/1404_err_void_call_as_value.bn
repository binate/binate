package "main"

// A call to a function with no result has no value, and a multi-valued call is
// not a single value: neither can initialize a variable, alone or as one
// element of a declaration's right-hand side.

func nothing() {}

func two() (int, int) {
	return 1, 2
}

func main() {
	a := nothing()
	var b = nothing()
	c, d := 1, two()
	_ = a
	_ = b
	_ = c
	_ = d
}
