package "main"

// A call with no result has no value, and a call with several results is not a
// single value (func.call.value): neither initializes a variable — alone, as
// one element of a declaration's right-hand side, or a blank one — nor is
// assigned, even to the blank identifier.

func nothing() {}

func two() (int, int) {
	return 1, 2
}

func main() {
	a := nothing()
	var b = nothing()
	c, d := 1, two()
	_ = nothing()
	var _ = nothing()
	var w = two()
	_ = a
	_ = b
	_ = c
	_ = d
	_ = w
}
