package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// cast (and unsafe_cast) of a string literal to any target the literal is
// assignable to (const.string.types) has the meaning of the implicit
// conversion (conv.cast): a raw or managed slice viewing the literal's bytes, a
// mutable `@[]char` copy of them (a fresh value, released when discarded — no
// leak), or a char array copy — of the target type itself, so a named target's
// methods apply.

type Bytes @[]char

type A2 [2]char

type RS *[]readonly char

func (b Bytes) L() int {
	return len(b)
}

func (a A2) First() char {
	return a[0]
}

func (r RS) L() int {
	return len(r)
}

func main() {
	var s *[]readonly char = cast(*[]readonly char, "hi")
	testing.Println(len(s)) // 2
	testing.Println(s[0] == 'h') // true
	testing.Println(s[1] == 'i') // true
	var m @[]readonly char = cast(@[]readonly char, "abc")
	testing.Println(len(m)) // 3
	var c @[]char = cast(@[]char, "hey")
	c[0] = 'H'
	testing.Println(c[0] == 'H' && c[2] == 'y') // true
	var a [2]char = cast([2]char, "ok")
	a[0] = 'O'
	testing.Println(a[0] == 'O' && a[1] == 'k') // true
	var r [2]readonly char = cast([2]readonly char, "ok")
	testing.Println(r[1] == 'k') // true
	var u *[]readonly char = unsafe_cast(*[]readonly char, "xyz")
	testing.Println(len(u)) // 3
	testing.Println(cast(Bytes, "klmn").L()) // 4
	testing.Println(cast(A2, "pq").First() == 'p') // true
	testing.Println(cast(RS, "rst").L()) // 3
	var base int = rt.LiveBlocks()
	var n int = 0
	for i := 0; i < 10; i++ {
		n = n + len(cast(@[]char, "four"))
		var w @[]char = cast(@[]char, "five!")
		n = n + len(w)
		n = n + cast(Bytes, "six!!!").L()
	}
	testing.Println(n) // 90
	testing.Println(rt.LiveBlocks() == base) // true
}
