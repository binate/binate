package "main"

import "pkg/builtins/testing"

// cast of a string literal to a raw slice, a target the literal is assignable
// to (const.string.types), has the meaning of the implicit conversion
// (conv.cast): a raw slice viewing the literal's bytes.

func main() {
	var s *[]readonly char = cast(*[]readonly char, "hi")
	testing.Println(len(s)) // 2
	testing.Println(s[0] == 'h') // true
	testing.Println(s[1] == 'i') // true
}
