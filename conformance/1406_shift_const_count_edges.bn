package "main"

import "pkg/builtins/testing"

// Shifts by a constant count in [0, width) — 0, 1 and width-1 — on every sized
// integer type, left and right, signed and unsigned.  The shifted values are read
// from an array inside a loop so they stay runtime values while the count is a
// literal: the shape the native backends lower to a shift-by-immediate.  Each
// result is compared against the spec'd value (`<<` is logical; `>>` is
// arithmetic for a signed value and logical for an unsigned one), and each type
// prints its number of mismatches.

// checkInt8 returns the number of wrong int8 shift results.
func checkInt8() int {
	var vals [6]int8 = [6]int8{0, 1, -1, 127, -128, 90}
	var shl0 [6]int8 = [6]int8{0, 1, -1, 127, -128, 90}
	var shl1 [6]int8 = [6]int8{0, 2, -2, -2, 0, -76}
	var shl7 [6]int8 = [6]int8{0, -128, -128, -128, 0, 0}
	var shr0 [6]int8 = [6]int8{0, 1, -1, 127, -128, 90}
	var shr1 [6]int8 = [6]int8{0, 0, -1, 63, -64, 45}
	var shr7 [6]int8 = [6]int8{0, 0, -1, 0, -1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v int8 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 7) != shl7[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 7) != shr7[i] { bad = bad + 1 }
	}
	return bad
}

// checkUint8 returns the number of wrong uint8 shift results.
func checkUint8() int {
	var vals [6]uint8 = [6]uint8{0, 1, 255, 127, 128, 90}
	var shl0 [6]uint8 = [6]uint8{0, 1, 255, 127, 128, 90}
	var shl1 [6]uint8 = [6]uint8{0, 2, 254, 254, 0, 180}
	var shl7 [6]uint8 = [6]uint8{0, 128, 128, 128, 0, 0}
	var shr0 [6]uint8 = [6]uint8{0, 1, 255, 127, 128, 90}
	var shr1 [6]uint8 = [6]uint8{0, 0, 127, 63, 64, 45}
	var shr7 [6]uint8 = [6]uint8{0, 0, 1, 0, 1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v uint8 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 7) != shl7[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 7) != shr7[i] { bad = bad + 1 }
	}
	return bad
}

// checkInt16 returns the number of wrong int16 shift results.
func checkInt16() int {
	var vals [6]int16 = [6]int16{0, 1, -1, 0x7fff, -0x8000, 0x5a5a}
	var shl0 [6]int16 = [6]int16{0, 1, -1, 0x7fff, -0x8000, 0x5a5a}
	var shl1 [6]int16 = [6]int16{0, 2, -2, -2, 0, -0x4b4c}
	var shl15 [6]int16 = [6]int16{0, -0x8000, -0x8000, -0x8000, 0, 0}
	var shr0 [6]int16 = [6]int16{0, 1, -1, 0x7fff, -0x8000, 0x5a5a}
	var shr1 [6]int16 = [6]int16{0, 0, -1, 0x3fff, -0x4000, 0x2d2d}
	var shr15 [6]int16 = [6]int16{0, 0, -1, 0, -1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v int16 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 15) != shl15[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 15) != shr15[i] { bad = bad + 1 }
	}
	return bad
}

// checkUint16 returns the number of wrong uint16 shift results.
func checkUint16() int {
	var vals [6]uint16 = [6]uint16{0, 1, 0xffff, 0x7fff, 0x8000, 0x5a5a}
	var shl0 [6]uint16 = [6]uint16{0, 1, 0xffff, 0x7fff, 0x8000, 0x5a5a}
	var shl1 [6]uint16 = [6]uint16{0, 2, 0xfffe, 0xfffe, 0, 0xb4b4}
	var shl15 [6]uint16 = [6]uint16{0, 0x8000, 0x8000, 0x8000, 0, 0}
	var shr0 [6]uint16 = [6]uint16{0, 1, 0xffff, 0x7fff, 0x8000, 0x5a5a}
	var shr1 [6]uint16 = [6]uint16{0, 0, 0x7fff, 0x3fff, 0x4000, 0x2d2d}
	var shr15 [6]uint16 = [6]uint16{0, 0, 1, 0, 1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v uint16 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 15) != shl15[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 15) != shr15[i] { bad = bad + 1 }
	}
	return bad
}

// checkInt32 returns the number of wrong int32 shift results.
func checkInt32() int {
	var vals [6]int32 = [6]int32{0, 1, -1, 0x7fffffff, -0x80000000, 0x5a5a5a5a}
	var shl0 [6]int32 = [6]int32{0, 1, -1, 0x7fffffff, -0x80000000, 0x5a5a5a5a}
	var shl1 [6]int32 = [6]int32{0, 2, -2, -2, 0, -0x4b4b4b4c}
	var shl31 [6]int32 = [6]int32{0, -0x80000000, -0x80000000, -0x80000000, 0, 0}
	var shr0 [6]int32 = [6]int32{0, 1, -1, 0x7fffffff, -0x80000000, 0x5a5a5a5a}
	var shr1 [6]int32 = [6]int32{0, 0, -1, 0x3fffffff, -0x40000000, 0x2d2d2d2d}
	var shr31 [6]int32 = [6]int32{0, 0, -1, 0, -1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v int32 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 31) != shl31[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 31) != shr31[i] { bad = bad + 1 }
	}
	return bad
}

// checkUint32 returns the number of wrong uint32 shift results.
func checkUint32() int {
	var vals [6]uint32 = [6]uint32{0, 1, 0xffffffff, 0x7fffffff, 0x80000000, 0x5a5a5a5a}
	var shl0 [6]uint32 = [6]uint32{0, 1, 0xffffffff, 0x7fffffff, 0x80000000, 0x5a5a5a5a}
	var shl1 [6]uint32 = [6]uint32{0, 2, 0xfffffffe, 0xfffffffe, 0, 0xb4b4b4b4}
	var shl31 [6]uint32 = [6]uint32{0, 0x80000000, 0x80000000, 0x80000000, 0, 0}
	var shr0 [6]uint32 = [6]uint32{0, 1, 0xffffffff, 0x7fffffff, 0x80000000, 0x5a5a5a5a}
	var shr1 [6]uint32 = [6]uint32{0, 0, 0x7fffffff, 0x3fffffff, 0x40000000, 0x2d2d2d2d}
	var shr31 [6]uint32 = [6]uint32{0, 0, 1, 0, 1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v uint32 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 31) != shl31[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 31) != shr31[i] { bad = bad + 1 }
	}
	return bad
}

// checkInt64 returns the number of wrong int64 shift results.
func checkInt64() int {
	var vals [6]int64 = [6]int64{
		0, 1, -1, 0x7fffffffffffffff, -0x8000000000000000, 0x5a5a5a5a5a5a5a5a,
	}
	var shl0 [6]int64 = [6]int64{
		0, 1, -1, 0x7fffffffffffffff, -0x8000000000000000, 0x5a5a5a5a5a5a5a5a,
	}
	var shl1 [6]int64 = [6]int64{0, 2, -2, -2, 0, -0x4b4b4b4b4b4b4b4c}
	var shl63 [6]int64 = [6]int64{
		0, -0x8000000000000000, -0x8000000000000000, -0x8000000000000000, 0, 0,
	}
	var shr0 [6]int64 = [6]int64{
		0, 1, -1, 0x7fffffffffffffff, -0x8000000000000000, 0x5a5a5a5a5a5a5a5a,
	}
	var shr1 [6]int64 = [6]int64{
		0, 0, -1, 0x3fffffffffffffff, -0x4000000000000000, 0x2d2d2d2d2d2d2d2d,
	}
	var shr63 [6]int64 = [6]int64{0, 0, -1, 0, -1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v int64 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 63) != shl63[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 63) != shr63[i] { bad = bad + 1 }
	}
	return bad
}

// checkUint64 returns the number of wrong uint64 shift results.
func checkUint64() int {
	var vals [6]uint64 = [6]uint64{
		0, 1, 0xffffffffffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0x5a5a5a5a5a5a5a5a,
	}
	var shl0 [6]uint64 = [6]uint64{
		0, 1, 0xffffffffffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0x5a5a5a5a5a5a5a5a,
	}
	var shl1 [6]uint64 = [6]uint64{
		0, 2, 0xfffffffffffffffe, 0xfffffffffffffffe, 0, 0xb4b4b4b4b4b4b4b4,
	}
	var shl63 [6]uint64 = [6]uint64{
		0, 0x8000000000000000, 0x8000000000000000, 0x8000000000000000, 0, 0,
	}
	var shr0 [6]uint64 = [6]uint64{
		0, 1, 0xffffffffffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0x5a5a5a5a5a5a5a5a,
	}
	var shr1 [6]uint64 = [6]uint64{
		0, 0, 0x7fffffffffffffff, 0x3fffffffffffffff, 0x4000000000000000, 0x2d2d2d2d2d2d2d2d,
	}
	var shr63 [6]uint64 = [6]uint64{0, 0, 1, 0, 1, 0}
	var bad int = 0
	for i := 0; i < 6; i++ {
		var v uint64 = vals[i]
		if (v << 0) != shl0[i] { bad = bad + 1 }
		if (v << 1) != shl1[i] { bad = bad + 1 }
		if (v << 63) != shl63[i] { bad = bad + 1 }
		if (v >> 0) != shr0[i] { bad = bad + 1 }
		if (v >> 1) != shr1[i] { bad = bad + 1 }
		if (v >> 63) != shr63[i] { bad = bad + 1 }
	}
	return bad
}

func main() {
	testing.Println(checkInt8())
	testing.Println(checkUint8())
	testing.Println(checkInt16())
	testing.Println(checkUint16())
	testing.Println(checkInt32())
	testing.Println(checkUint32())
	testing.Println(checkInt64())
	testing.Println(checkUint64())
}
