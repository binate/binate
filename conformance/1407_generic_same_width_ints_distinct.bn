package "main"

import "pkg/builtins/testing"

// Integer types of the same width are distinct types, so generic instances
// over them are distinct instances: int and int64 (the same width on a 64-bit
// target), int and int32 (on a 32-bit one), and their unsigned counterparts.

type Box[T any] struct {
	v T
}

func get[T any](b @Box[T]) T {
	return b.v
}

// which reports which Box instance a value behind an interface is.
func which(a *any) int {
	switch a.(type) {
	case *Box[int]:
		return 1
	case *Box[int64]:
		return 2
	case *Box[int32]:
		return 3
	default:
		return 0
	}
}

func main() {
	var a @Box[int] = make(Box[int])
	var b @Box[int64] = make(Box[int64])
	var c @Box[int32] = make(Box[int32])
	var d @Box[uint] = make(Box[uint])
	var e @Box[uint64] = make(Box[uint64])
	var f @Box[uint32] = make(Box[uint32])
	var i int = 1
	var i64 int64 = 2
	var i32 int32 = 3
	var u uint = 4
	var u64 uint64 = 5
	var u32 uint32 = 6
	a.v = i
	b.v = i64
	c.v = i32
	d.v = u
	e.v = u64
	f.v = u32
	var ri int = get[int](a)
	var ri64 int64 = get[int64](b)
	var ri32 int32 = get[int32](c)
	testing.Println(ri, cast(int, ri64), cast(int, ri32), cast(int, d.v), cast(int, e.v),
			cast(int, f.v))
	var va Box[int] = Box[int]{v: 7}
	var vb Box[int64] = Box[int64]{v: 8}
	var vc Box[int32] = Box[int32]{v: 9}
	testing.Println(which(&va), which(&vb), which(&vc))
}
