package "main"

// A pointer, a slice or a method signature over int is not one over int64,
// even on a target where the two integer types have the same width.

interface I {
	M(x int) int
}

type S struct {
	n int
}

func (s S) M(x int64) int64 {
	return x + 1
}

impl S : I

func main() {
	var a int = 1
	var p *int64 = &a
	var arr [2]int
	var sl *[]int64 = arr[:]
	var q *int = cast(*int, p)
	var n int = len(sl) + *q
	n = n + 1
}
