package "main"

import "pkg/builtins/testing"

// An untyped integer constant written with a unary operator has its true
// value and sign.  Negating the literal 2^63 gives the int64 minimum, a signed
// value: dividing it, comparing it and converting it to float treat it as
// negative, whether its context is int64, readonly int64 or an alias of int64.
// Negating that again gives +2^63 (unsigned), and `~5` is -6.

type W = int64

func main() {
	var d int64 = 3
	var q int64 = -9223372036854775808 / d
	var c bool = -9223372036854775808 < d
	var f float64 = cast(float64, -9223372036854775808 + d)
	testing.Println(q, c, f < 0.0)
	var rd readonly int64 = 3
	var rq readonly int64 = -9223372036854775808 / rd
	var wd W = 3
	var wq W = -9223372036854775808 / wd
	testing.Println(rq, wq, -9223372036854775808 < wd)
	testing.Println(cast(float64, - -9223372036854775808) > 0.0, - -9223372036854775808 > 0)
	testing.Println(cast(float64, -(0 - 9223372036854775808)) > 0.0, cast(float64, ~5) < 0.0)
}
