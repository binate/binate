package "main"

import "pkg/builtins/testing"
import L "pkg/other/lib"
import s "shapes"
import "pkg/other/shapes"

// A deferred call through an interface resolves the interface by its package's
// full path: through an explicitly aliased import (`L`), inside the interface's
// own non-main package (lib.Run), and when a single-segment import alias (`s`
// for package "shapes") shares its spelling with another imported package's
// last path segment (pkg/other/shapes, whose Shape lists B before A).

type R struct {
	v int
}

func (r *R) A() int {
	testing.Println(1)
	return 1
}

func (r *R) B() int {
	testing.Println(2)
	return 2
}

impl *R : s.Shape, shapes.Shape

func run(g *L.Greeter) {
	defer g.Greet(5)
	testing.Println(1)
}

func runShape(x *s.Shape) {
	defer x.A()
	testing.Println(0)
}

func main() {
	var x L.G = L.G{v: 10}
	run(&x) // 1 15
	L.Run(&x) // 1010
	var r R = R{v: 1}
	runShape(&r) // 0 1
}
