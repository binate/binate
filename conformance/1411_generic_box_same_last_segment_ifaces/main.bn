package "main"

import "pkg/builtins/testing"
import xa "pkg/x/a"
import ya "pkg/y/a"

// Box[*xa.P] and Box[*ya.P] — over two packages' interfaces P whose paths end in
// the same segment — are different instantiations, each with its own field
// type and methods.

type Box[T any] struct {
	v T
}

type U struct {
	v int
}

func (u *U) Get() int {
	return u.v
}

impl *U : xa.P

type W struct {
	v int
}

func (w *W) Pad() int {
	return 999
}

func (w *W) Name() int {
	return w.v + 100
}

impl *W : ya.P

func main() {
	var u U = U{v: 4}
	var w W = W{v: 5}
	var b Box[*xa.P] = Box[*xa.P]{v: &u}
	var c Box[*ya.P] = Box[*ya.P]{v: &w}
	testing.Println(b.v.Get()) // 4
	testing.Println(c.v.Name()) // 105
}
