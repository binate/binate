package "main"

import "pkg/builtins/testing"
import "pkg/a"
import "pkg/b"

// Two packages' named types of the same name (`type T int` in pkg/a and pkg/b)
// are different types, so generic instantiations over them are different types
// too: a Box[a.T] is not assignable to a Box[b.T].

type Box[T any] struct {
	v T
}

func main() {
	var x Box[a.T]
	x.v = cast(a.T, 3)
	var y Box[b.T] = x
	testing.Println(cast(int, y.v))
}
