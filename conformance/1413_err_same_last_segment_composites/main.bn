package "main"

import xa "pkg/x/a"
import ya "pkg/y/a"

// Composite types over two same-last-segment packages' interfaces P are
// different types, and the "cannot assign" names them qualified wherever they
// would otherwise read alike: function, array, anonymous-struct and managed
// slice types.

func main() {
	var f1 *func(*xa.P) int
	var f2 *func(*ya.P) int = f1
	var a1 [2]*xa.P
	var a2 [2]*ya.P = a1
	var s1 struct { p *xa.P }
	var s2 struct { p *ya.P } = s1
	var m1 @[]@xa.P
	var m2 @[]@ya.P = m1
	_ = f2
	_ = a2
	_ = s2
	_ = m2
}
