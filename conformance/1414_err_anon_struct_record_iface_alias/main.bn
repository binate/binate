package "main"

import "pkg/builtins/testing"
import "pkg/b"
import "pkg/c"

// An anonymous struct's reflection record is the same in every package that
// emits it: pkg/c emits one for its field type `struct { q *a.Q }` (with
// `interface Q = b.P`), main one for the `struct { q *b.P }` it boxes — the
// same type, so both records read `struct { q *pkg/b.P }`, and a failed
// assertion names the boxed type that way whichever record the link keeps.

func main() {
	var w0 *any = c.Box()
	_ = w0
	var x struct { q *b.P }
	var w *any = &x
	var i *int = w.(*int)
	_ = i
	testing.Println("unreachable")
}
