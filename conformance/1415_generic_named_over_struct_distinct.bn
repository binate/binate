package "main"

import "pkg/builtins/testing"

// A named type over a struct (`type N S`) is a type of its own, so generics
// instantiated with it are instances of their own: run[N] and Box[N] call N's
// method, not S's, and a value boxed through wrap[N] asserts as *N, not *S.

interface Doer {
	Do() int
}

type S struct {
	v int
}

func (s S) Do() int {
	return 1
}

impl S : Doer

type N S

func (n N) Do() int {
	return 2
}

impl N : Doer

func run[T Doer](x T) int {
	return x.Do()
}

type Box[T any] struct {
	v T
}

func wrap[T any](x *T) *any {
	return x
}

func main() {
	var s S
	var n N
	testing.Println(run[S](s)) // 1
	testing.Println(run[N](n)) // 2
	var bs Box[S]
	var bn Box[N]
	bs.v = s
	bn.v = n
	testing.Println(bs.v.Do()) // 1
	testing.Println(bn.v.Do()) // 2
	var ws *any = wrap[S](&s)
	var w *any = wrap[N](&n)
	var ok bool
	_, ok = w.(*N)
	testing.Println(ok) // true
	_, ok = w.(*S)
	testing.Println(ok) // false
	_, ok = ws.(*S)
	testing.Println(ok) // true
}
