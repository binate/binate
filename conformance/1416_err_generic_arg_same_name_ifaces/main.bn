package "main"

import "pkg/builtins/testing"
import "pkg/a"
import "pkg/b"

// Two packages' interfaces of the same name are different types, so generic
// instantiations over them are different types too: a Box[*a.P] is not
// assignable to a Box[*b.P].

type Box[T any] struct {
	v T
}

func main() {
	var x Box[*a.P]
	var y Box[*b.P] = x
	testing.Println(y.v.Name())
}
