package "main"

import "pkg/builtins/testing"
import xa "pkg/x/a"
import ya "pkg/y/a"

// pkg/x/a and pkg/y/a are different packages whose paths end in the same
// segment; their interfaces named P are different types, so a *xa.P is not
// assignable to a *ya.P.

type U struct {
	v int
}

func (u *U) Get() int {
	return u.v
}

impl *U : xa.P

func main() {
	var u U = U{v: 4}
	var p *xa.P = &u
	var q *ya.P = p
	testing.Println(q.Name())
}
