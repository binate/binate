package "main"

import "pkg/builtins/testing"
import "pkg/a"
import "pkg/b"

// A composite type with no name of its own boxed into `any` (`*[]*a.Q`, with
// `interface Q = b.P`) is the same type as spelled with the aliased interface
// (`*[]*b.P`): assertions and type-switch cases on either spelling hit.

func main() {
	var arr *[]*a.Q = make_slice(*a.Q, 1)
	var w *any = &arr
	var ok bool
	_, ok = w.(*[]*b.P)
	testing.Println(ok)
	var arr2 *[]*b.P = arr
	var w2 *any = &arr2
	_, ok = w2.(*[]*a.Q)
	testing.Println(ok)
	switch w.(type) {
	case *[]*b.P:
		testing.Println("switch hit")
	default:
		testing.Println("switch miss")
	}
	var m @[]*a.Q = make_slice(*a.Q, 2)
	var w3 *any = &m
	_, ok = w3.(@[]*b.P)
	testing.Println(ok)
	var z *[]*b.P = w.(*[]*b.P)
	testing.Println(len(z))
}
