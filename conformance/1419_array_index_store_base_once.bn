package "main"

import "pkg/builtins/testing"

// Storing to an element of an array with storage evaluates the array's base
// expression exactly once — in a plain, compound, multi-value and parallel
// assignment alike — and the store lands in that array.  Each base below is a
// call that counts itself.

type Box struct {
	a [4]int
}

var arr [4]int
var boxes [2]Box
var calls int

func getP() *([4]int) {
	calls++
	return &arr
}

func pick() *Box {
	calls++
	return &boxes[1]
}

func idx() int {
	calls++
	return 1
}

func pair() (int, int) {
	return 7, 8
}

func report(what *[]readonly char, v int) {
	testing.Println(what)
	testing.Println(calls)
	testing.Println(v)
	calls = 0
}

func main() {
	(*getP())[2] = 5
	report("deref store", arr[2])
	(*getP())[2] += 3
	report("deref compound", arr[2])
	pick().a[3] = 9
	report("field store", boxes[1].a[3])
	boxes[idx()].a[0] = 4
	report("indexed field store", boxes[1].a[0])
	boxes[idx()].a[0] += 6
	report("indexed field compound", boxes[1].a[0])
	(*getP())[0], arr[1] = pair()
	report("multi-value", arr[0] * 10 + arr[1])
	(*getP())[3], pick().a[2] = 1, 2
	report("parallel", arr[3] * 10 + boxes[1].a[2])
}
