package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// Storing a managed value into an element of an array holds exactly one
// reference to it — the element's old occupant released, the new value
// acquired once — in a multi-value, parallel or single assignment, whatever
// the array's base: a variable, a field, a dereference, an element of another
// array, a global.  Each case stores, reports the count, then clears the
// element and reports it again.

type Node struct {
	v int
}

type Holder struct {
	a [2]@Node
}

var garr [2]@Node

func pass(x @Node) (@Node, int) {
	return x, 1
}

func report(what *[]readonly char, p *uint8) {
	testing.Print(what)
	testing.Print(" ")
	testing.Println(rt.Refcount(p))
}

func main() {
	var a @Node = make(Node)
	var p *uint8 = bit_cast(*uint8, a)
	var n int
	report("start", p)

	var arr [2]@Node
	arr[0], n = pass(a)
	report("multi variable", p)
	arr[0], n = pass(a)
	report("multi overwrite", p)
	arr[0] = nil
	report("cleared", p)

	var h Holder
	h.a[1], n = pass(a)
	report("multi field", p)
	h.a[1] = nil
	report("cleared", p)

	var ap *([2]@Node) = &arr
	(*ap)[1], n = pass(a)
	report("multi deref", p)
	arr[1] = nil
	report("cleared", p)

	var nest [2][2]@Node
	nest[1][0], n = pass(a)
	report("multi nested", p)
	nest[1][0] = nil
	report("cleared", p)

	garr[0], n = pass(a)
	report("multi global", p)
	garr[0] = nil
	report("cleared", p)

	arr[1], h.a[0] = a, a
	report("parallel", p)
	arr[1] = nil
	h.a[0] = nil
	report("cleared", p)

	(*ap)[0] = a
	report("single deref", p)
	arr[0] = nil
	report("cleared", p)
	testing.Println(n)
}
