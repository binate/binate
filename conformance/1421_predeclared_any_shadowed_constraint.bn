package "main"

import "pkg/builtins/testing"

// A package's own `interface any` shadows the universe `any` as a generic
// constraint too: `[T any]` constrains T to this interface, so its method is
// callable on a T.

interface any {
	M() int
}

type K struct {
	n int
}

func (k *K) M() int { return k.n * 2 }

impl *K : any

func Twice[T any](x T) int {
	return x.M()
}

func main() {
	var k K
	k.n = 21
	testing.Println(Twice[*K](&k))
}
