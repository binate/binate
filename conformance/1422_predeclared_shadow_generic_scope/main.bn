package "main"
import "pkg/builtins/testing"

import "pkg/gen"

// A package's own `int16` shadows the predeclared type only in that package
// (lex.predeclared.are-idents, decl.scope.levels).  Here main aliases int16 to
// int8, while pkg/gen's generic bodies — monomorphized into main — still use the
// predeclared int16: main's arithmetic wraps at 8 bits, gen's does not.
type int16 = int8

func main() {
	var v int16 = 100
	v = v + 100
	testing.Println(cast(int, v), cast(int, sizeof(int16)))
	testing.Println(gen.Wrap200[int](1), gen.Size16[int](1))
}
