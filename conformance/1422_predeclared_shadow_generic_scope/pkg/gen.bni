package "pkg/gen"

// Wrap200 computes, inside a generic body that the CONSUMER instantiates, with
// the predeclared int16: 100 + 100 is 200, however the consumer spells int16.
func Wrap200[T any](x T) int {
	var v int16 = 100
	v = v + 100
	return cast(int, v)
}

// Size16 reports sizeof(int16) as seen inside a generic body: 2.
func Size16[T any](x T) int {
	return cast(int, sizeof(int16))
}

// Sentinel is a concrete function, so the package has an implementation.
func Sentinel() int
