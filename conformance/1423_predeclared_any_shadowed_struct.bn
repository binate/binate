package "main"

import "pkg/builtins/testing"

// A package's own `any` shadows the universe interface everywhere in the package,
// including under `*` and `@`: here `any` is a struct, so `*any` / `@any` are
// plain pointers to it (not interface values) and its field reads and writes
// go through them.

type any struct {
	x int
	y int
}

func main() {
	var a any
	a.x = 5
	var p *any = &a
	p.y = 7
	var m @any = make(any)
	m.x = 11
	testing.Println(a.x, a.y, p.x, m.x)
}
