package "main"

import "pkg/builtins/testing"

import "pkg/g"

// An imported generic type's field and method signature whose length depends
// on its type parameter have each instantiation's own length; a field whose
// length is the generic's package's constant N has that length, not the
// importer's N.
const N int = 7

func main() {
	var b4 g.Buf[int32]
	var b8 g.Buf[int64]
	var x4 [4]uint8
	var x8 [8]uint8
	x8[7] = 9
	testing.Println(b4.Fill(x4), b8.Fill(x8), b8.a[7])
	testing.Println(cast(int, sizeof(g.Buf[int32])), cast(int, sizeof(g.Buf[int64])))
	testing.Println(len(b4.c), len(b8.c), N)
}
