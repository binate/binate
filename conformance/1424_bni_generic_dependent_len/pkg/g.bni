package "pkg/g"

// A generic type whose field and method signature have a length that
// depends on its type parameter, and a field whose length is a constant of
// this package.
const N int = 3

type Buf[T any] struct {
	a [sizeof(T)]uint8
	c [N]uint8
}

func (b *Buf[T]) Fill(x [sizeof(T)]uint8) int {
	b.a = x
	return len(b.a)
}

func Id() int
