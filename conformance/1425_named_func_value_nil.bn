package "main"

import "pkg/builtins/testing"

// A named type over a function value is nil-assignable like the function value
// itself (and like a named pointer), raw or managed; presence is tested with
// `present`, as function values are never compared, not even with nil.

type F *func() int

type MF @func() int

type P *int

func main() {
	var p P = nil
	var f F = nil
	var m MF = nil
	testing.Println(p == nil, present(f), present(m))
	f = func() int { return 1 }
	m = func() int { return 2 }
	testing.Println(present(f), present(m), f() + m())
	f = nil
	m = nil
	testing.Println(present(f), present(m))
}
