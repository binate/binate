package "main"

import "pkg/builtins/testing"

// A field of an element of a slice expression (`sl[a:b][i].f`) or of an array
// composite literal (`[2]R{…}[i].f`) is read in place like a field of any
// indexed element, and written through a slice expression's element (or
// addressed); the element may be a struct, a managed pointer or a raw pointer.
// An element of an element (`a[:][i][j]`, `lit[i][j]`) is read and written in
// place the same way.

type R struct {
	v int
	w int
}

type Box struct {
	n int
}

func main() {
	var sl @[]R = make_slice(R, 3)
	sl[1].v = 10
	sl[2].v = 20
	testing.Println(sl[1:3][0].v) // 10
	testing.Println(sl[1:][1].v) // 20
	sl[1:3][1].w = 7
	testing.Println(sl[2].w) // 7
	var arr [3]R
	arr[2].v = 30
	testing.Println(arr[:][2].v) // 30
	arr[1:][0].v = 11
	testing.Println(arr[1].v) // 11
	testing.Println([2]R{R{v: 3}, R{v: 4}}[1].v) // 4
	var boxes @[]@Box = @[]@Box{make(Box), make(Box)}
	boxes[1].n = 5
	testing.Println(boxes[1:][0].n) // 5
	var ptrs [2]*R
	ptrs[1] = &arr[2]
	testing.Println(ptrs[1:][0].v) // 30
	var pw *int = &sl[1:3][0].w
	*pw = 9
	testing.Println(sl[1].w) // 9
	var a2 [2][2]int
	a2[:][1][0] = 7
	testing.Println(a2[1][0]) // 7
	var n2 @[][2]int = make_slice([2]int, 2)
	n2[1:][0][1] = 8
	testing.Println(n2[1][1]) // 8
	testing.Println([2][2]int{[2]int{1, 2}, [2]int{3, 4}}[1][1]) // 4
}
