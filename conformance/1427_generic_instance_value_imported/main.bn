package "main"

import "pkg/builtins/testing"
import "pkg/gen"

// A generic function of another package instantiated as a value
// (`gen.Pick[int]`) is a func value there too — bound, or discarded into a
// blank target.  A local variable that shadows the import alias
// (decl.scope.shadow) makes `gen.Pick[i]` an index of its field `Pick`, never
// an instantiation, though the field shares the generic's name.

type S struct {
	Pick [3]int
}

func main() {
	_ = gen.Pick[int]
	var f = gen.Pick[int]
	testing.Println(f(1, 2)) // 2
	{
		var gen S
		gen.Pick[1] = 42
		var y int = gen.Pick[1] + 1
		testing.Println(y) // 43
		z := gen.Pick[1]
		testing.Println(z) // 42
		_ = gen.Pick[2]
		testing.Println(gen.Pick[2]) // 0
	}
	testing.Println(gen.Pick[int](3, 4)) // 4
}
