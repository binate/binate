package "main"

import "pkg/builtins/testing"

// A method value bound to a `*T`-receiver method captures `&x`, so calling it
// mutates x (func.method-value.capture) — whether x is a variable, a struct
// field, an array element or a slice element.

type P struct {
	v int
}

type S struct {
	p P
}

func (p *P) Inc() int {
	p.v = p.v + 1
	return p.v
}

func main() {
	var p P
	var h *func() int = p.Inc
	var r int = h()
	testing.Println(r, p.v) // 1 1
	var s S
	var h2 *func() int = s.p.Inc
	r = h2()
	testing.Println(r, s.p.v) // 1 1
	var arr [2]P
	var h3 *func() int = arr[1].Inc
	r = h3()
	testing.Println(r, arr[1].v) // 1 1
	var sl @[]P = make_slice(P, 2)
	var h4 *func() int = sl[1].Inc
	r = h4()
	testing.Println(r, sl[1].v) // 1 1
}
