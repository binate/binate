package "main"

import "pkg/builtins/testing"

// A literal `nil` passed or assigned where a function value is expected — a
// raw or managed parameter, named or not, a variadic element, a deferred call's
// argument, a parallel assignment's target (a variable or a field) — is that
// function type's nil, both words zero.

type F *func() int

type MF @func() int

type S struct {
	m @func() int
}

func take(f *func() int, m @func() int) bool {
	return present(f) || present(m)
}

func takeNamed(f F, m MF) bool {
	return present(f) || present(m)
}

func count(fs ...*func() int) int {
	var n int = 0
	for i := 0; i < len(fs); i++ {
		if present(fs[i]) {
			n = n + 1
		}
	}
	return n
}

func report(m @func() int) {
	testing.Println(present(m))
}

func main() {
	testing.Println(take(nil, nil), takeNamed(nil, nil))
	testing.Println(count(nil, func() int { return 1 }, nil))
	var x int
	var f *func() int
	x, f = 7, nil
	testing.Println(x, present(f))
	var g @func() int = func() int { return 3 }
	var mg MF = func() int { return 4 }
	var s S
	s.m = func() int { return 5 }
	x, g = 8, nil
	x, mg = 9, nil
	x, s.m = 10, nil
	testing.Println(x, present(g), present(mg), present(s.m))
	defer report(nil)
	testing.Println(take(func() int { return 2 }, nil))
}
