package "main"
import "pkg/builtins/testing"

// Boxing strips an OUTER `readonly` from the dynamic type (§11.12 `iface.assert`)
// for a named pointee too: a `readonly @Box` handle (the handle is readonly, its
// pointee is not) boxes its pointee as Box and matches `case *Box:`.

type Box struct {
	n int
}

func classify(v *any) @[]char {
	switch v.(type) {
	case *Box:
		return "box"
	default:
		return "default"
	}
}

func main() {
	var b @Box = make(Box)
	b.n = 4
	var rb readonly @Box = b
	testing.Println(classify(rb)) // box
	var x *any = rb
	got, ok := x.(*Box)
	if ok && got.n == 4 {
		testing.Println("recovered")
	} else {
		testing.Println("not recovered")
	}
}
