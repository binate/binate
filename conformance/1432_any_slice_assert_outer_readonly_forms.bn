package "main"
import "pkg/builtins/testing"

// More forms of the outer-`readonly` strip (§11.12 `iface.assert`,
// `iface.assert.slice`): an alias that hides the outer readonly, a raw slice with
// an outer readonly (mutable elements), a pointer whose pointee carries an outer
// readonly and a pointer to an element-readonly slice (each reached through a named
// pointer type, converted to its underlying pointer first — a named pointer itself
// is a value, boxed under its own name, iface.construct.named-pointer), and a
// managed `@any` box.  Each boxes as its slice spelling without the outer
// readonly; element readonly is kept.

type RO = readonly @[]char

type RP *readonly @[]readonly char

type RP2 *@[]readonly char

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case *[]char:
		return "raw-mutable"
	case *[]readonly char:
		return "raw-readonly"
	default:
		return "default"
	}
}

func mclassify(v @any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	default:
		return "default"
	}
}

func roManaged() readonly @[]readonly char {
	var m @[]char = "hi"
	return m
}

func main() {
	var m @[]char = "hi"
	var a RO = m
	testing.Println(classify(&a)) // mgd-mutable
	var buf [2]char
	var r readonly *[]char = buf[0:2]
	testing.Println(classify(&r)) // raw-mutable
	var s readonly @[]readonly char = roManaged()
	var p RP = &s
	testing.Println(classify(cast(*readonly @[]readonly char, p))) // mgd-readonly
	var t @[]readonly char = "hi"
	var p2 RP2 = &t
	testing.Println(classify(cast(*@[]readonly char, p2))) // mgd-readonly
	var ma @any = box(s)
	testing.Println(mclassify(ma)) // mgd-readonly
}
