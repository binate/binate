package "main"

import "pkg/builtins/testing"

// A call that returns ONE function value is one value, even when that function
// value itself has several results: `mk()` below does not distribute across
// two targets — `a, b := mk()`, `x, y = mk()` and `return mk()` from a
// two-result function are each an assignment count mismatch.  Calling the
// returned value (`mk()()`) is what yields the two results.

func pair() (int, int) {
	return 3, 4
}

func mk() @func() (int, int) {
	return pair
}

func bad() (int, int) {
	return mk()
}

func main() {
	a, b := mk()
	var x int = 0
	var y int = 0
	x, y = mk()
	testing.Println(a, b, x, y)
	c, d := mk()()
	testing.Println(c, d)
}
