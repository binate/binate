package "main"
import "pkg/builtins/testing"

// Assigning nil to a function value that holds a capturing closure sets BOTH
// words (code and captured data) to their zero value, so the closure record is
// released exactly once — through a variable, a struct field, an array element,
// a pointer, a managed-slice element and a raw-slice element, and when another
// variable still shares the closure.

type Box struct {
	v int
}

type H struct {
	f @func() int
}

func mk(b @Box, k int) @func(int) int {
	return func(x int) int { return x * k + b.v }
}

func main() {
	var b @Box = make(Box)
	b.v = 7

	var fb @func() int = func() int { return b.v }
	testing.Println(fb())
	fb = nil
	testing.Println(present(fb))

	var h H
	h.f = func() int { return b.v + 1 }
	testing.Println(h.f())
	h.f = nil
	testing.Println(present(h.f))

	var fs [2]@func(int) int
	fs[0] = mk(b, 2)
	fs[1] = mk(b, 3)
	var g @func(int) int = fs[1]
	fs[1] = nil
	testing.Println(g(4), g(5), fs[0](1), present(fs[1]))

	var pf @func() int = func() int { return b.v * 2 }
	var p *@func() int = &pf
	*p = nil
	testing.Println(present(pf))

	var ms @[]@func(int) int = make_slice(@func(int) int, 2)
	ms[0] = mk(b, 4)
	ms[1] = mk(b, 5)
	var mg @func(int) int = ms[1]
	ms[1] = nil
	testing.Println(mg(1), ms[0](1), present(ms[1]))

	var rs *[]@func(int) int = ms[0:2]
	rs[0] = nil
	testing.Println(present(ms[0]))
}
