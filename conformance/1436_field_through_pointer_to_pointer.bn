package "main"

import "pkg/builtins/testing"

// A field reached through `(*pp)`, where `*pp` is itself a pointer to a struct
// (pp a `**H`, or a `*@H`), is the field of the struct `*pp` points at — the
// field access auto-derefs `*pp` — so a store, an address-of, a
// pointer-receiver method call and an indexed element all reach that struct,
// not a copy of it.  A method called on `(*pp)` itself likewise receives the
// struct `*pp` points at (value and pointer receivers, directly and deferred);
// a named pointer type keeps its own method set, so `(*pnp).m()` calls the
// named pointer's method.

type P struct {
	n int
}

func (p *P) bump() {
	p.n = p.n + 10
}

type H struct {
	a   int
	p   P
	arr [2]P
}

func (h *H) incA() {
	h.a = h.a + 100
}

func (h H) getA() int {
	return h.a
}

type NP *H

func (np NP) tag() int {
	return 7
}

func deferInc(pp **H) {
	defer (*pp).incA()
}

func main() {
	var h H
	var hp *H = &h
	var pp **H = &hp
	(*pp).a = 3
	(*pp).p.n = 5
	(*pp).p.bump()
	(*pp).arr[1].bump()
	var q *P = &(*pp).p
	q.n = q.n + 1
	testing.Println(h.a, h.p.n, h.arr[1].n, (*pp).p.n)

	var mh @H = make(H)
	var pm *@H = &mh
	(*pm).a = 4
	(*pm).p.n = 6
	(*pm).p.bump()
	(*pm).arr[0].bump()
	var r *P = &(*pm).p
	r.n = r.n + 1
	testing.Println(mh.a, mh.p.n, mh.arr[0].n, (*pm).p.n)

	(*pp).incA()
	testing.Println((*pp).getA(), h.a)
	deferInc(pp)
	testing.Println(h.a)
	(*pm).incA()
	testing.Println((*pm).getA(), mh.a)
	var np NP = &h
	var pnp *NP = &np
	testing.Println((*pnp).tag())
}
