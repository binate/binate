package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A target `*p` shapes its right-hand side like any other target — a concrete
// value stored through a `*@I` becomes an interface value, a function name
// stored through a `**func` becomes a function value — in a single and a
// parallel assignment.  A field of a generic instance reached through a call
// (`idG[T](p).b`) is typed concretely in single, multi-value and parallel
// assignments, so a managed value stored there holds its own reference (the
// count printed is the field's own, after the statement's temps are gone).

interface I {
	get() int
}

type S struct {
	v int
}

func (s *S) get() int {
	return s.v
}

impl *S : I

func twice(x int) int {
	return 2 * x
}

type Box struct {
	v int
}

type G[T any] struct {
	b @Box
	t T
}

func idG[T any](p @G[T]) @G[T] {
	return p
}

func mk(v int) (@Box, int) {
	var b @Box = make(Box)
	b.v = v
	return b, v
}

func setMulti[T any](p @G[T]) {
	var n int
	idG[T](p).b, n = mk(5)
	_ = n
}

func setParallel[T any](p @G[T]) {
	var n int
	idG[T](p).b, n = make(Box), 6
	_ = n
}

func setSingle[T any](p @G[T]) {
	idG[T](p).b = make(Box)
}

func boxRC(g @G[int]) int {
	return rt.Refcount(bit_cast(*uint8, g.b))
}

func main() {
	var s @S = make(S)
	s.v = 7
	var iv @I
	var pi *@I = &iv
	var n int
	*pi, n = s, 1
	testing.Println(iv.get() + n)
	var iv2 @I
	var pi2 *@I = &iv2
	*pi2 = s
	testing.Println(iv2.get())

	var fv *func(int) int
	var pf **func(int) int = &fv
	*pf, n = twice, 2
	testing.Println(fv(5) + n)
	var fv2 *func(int) int
	var pf2 **func(int) int = &fv2
	*pf2 = twice
	testing.Println(fv2(6))

	var g @G[int] = make(G[int])
	setMulti[int](g)
	testing.Println(g.b.v)
	testing.Println(boxRC(g))
	setParallel[int](g)
	testing.Println(boxRC(g))
	setSingle[int](g)
	testing.Println(boxRC(g))
}
