package "main"
import "pkg/builtins/testing"

// A generic function or method from another package that boxes a value of its
// type argument keeps that argument's element-`readonly` in the box's dynamic
// type, as a local generic does: the checker types of the imported generic body
// bind to the instantiation's arguments across the package boundary too.

import "pkg/gb"

func main() {
	var s @[]readonly char = "hi"
	var m @[]char = "hi"
	testing.Println(gb.ViaCast[@[]readonly char](s), gb.ViaCast[@[]char](m))
	testing.Println(gb.ViaImplicit[@[]readonly char](s), gb.ViaImplicit[@[]char](m))
	var p @(@[]readonly char) = box(s)
	testing.Println(gb.BoxManaged[@(@[]readonly char)](p))
	var b @gb.Box[@[]readonly char] = make(gb.Box[@[]readonly char])
	b.V = s
	testing.Println(b.Blank())
}
