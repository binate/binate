package "pkg/gb"

// Classify names the dynamic type of a raw box: managed char slice, readonly or not.
func Classify(v *any) @[]char

// ClassifyManaged names the dynamic type of a managed box.
func ClassifyManaged(v @any) @[]char

// ViaCast boxes the address of its argument with `cast`.
func ViaCast[T any](x T) @[]char {
	return Classify(cast(*any, &x))
}

// ViaImplicit boxes the address of its argument by an implicit conversion.
func ViaImplicit[T any](x T) @[]char {
	return Classify(&x)
}

// BoxManaged boxes its (managed pointer) argument into `@any` with `cast`.
func BoxManaged[T any](x T) @[]char {
	return ClassifyManaged(cast(@any, x))
}

// Box holds one value.
type Box[T any] struct {
	V T
}

// Blank boxes the address of the held value through a blank receiver binder.
func (b @Box[_]) Blank() @[]char {
	return Classify(cast(*any, &b.V))
}
