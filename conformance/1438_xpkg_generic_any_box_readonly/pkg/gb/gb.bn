package "pkg/gb"

func Classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	default:
		return "default"
	}
}

func ClassifyManaged(v @any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	default:
		return "default"
	}
}
