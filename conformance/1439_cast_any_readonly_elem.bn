package "main"
import "pkg/builtins/testing"

// Widening to an interface with `cast` / `unsafe_cast` keeps a name-less boxed
// value's element-`readonly` in its dynamic type, exactly as an implicit
// conversion does: a `@[]readonly char` boxed through `cast(*any, &s)` matches
// `case @[]readonly char:` and never `case @[]char:`, so no assertion recovers a
// mutable slice over readonly data (`cast` never drops element readonly).

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case *[]char:
		return "raw-mutable"
	case *[]readonly char:
		return "raw-readonly"
	default:
		return "default"
	}
}

type P *(@[]readonly char)

func classifyManaged(v @any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case *[]char:
		return "raw-mutable"
	case *[]readonly char:
		return "raw-readonly"
	default:
		return "default"
	}
}

func main() {
	var s @[]readonly char = "hi"
	testing.Println(classify(cast(*any, &s)))        // mgd-readonly
	testing.Println(classify(unsafe_cast(*any, &s))) // mgd-readonly
	var r *[]readonly char = "hi"
	testing.Println(classify(cast(*any, &r)))        // raw-readonly
	testing.Println(classify(unsafe_cast(*any, &r))) // raw-readonly

	var p @(@[]readonly char) = box(s)
	testing.Println(classifyManaged(cast(@any, p)))        // mgd-readonly
	testing.Println(classifyManaged(unsafe_cast(@any, p))) // mgd-readonly
	var rb @(*[]readonly char) = box(r)
	testing.Println(classifyManaged(cast(@any, rb))) // raw-readonly

	// A named pointer is a value (iface.construct.named-pointer): converted to its
	// underlying pointer first, it boxes as its pointee.
	var np P = &s
	testing.Println(classify(cast(*any, cast(*(@[]readonly char), np)))) // mgd-readonly

	var x *any = cast(*any, &s)
	_, ok := x.(@[]char)
	testing.Println(ok) // false
	got, ok2 := x.(@[]readonly char)
	testing.Println(ok2, len(got)) // true 2
}
