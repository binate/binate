package "main"
import "pkg/builtins/testing"

// In an instantiated generic body, a boxed value whose type comes from a type
// argument keeps that argument's element-`readonly` in its dynamic type — through
// `cast`, an implicit conversion and a `var` initializer alike, in generic
// functions and in methods of generic types whatever their receiver binders are
// called (swapped, blank) — so `case @[]char:` never recovers a mutable slice over
// readonly data, and a mutable one never reads as readonly.  A `cast` of an
// operand typed as a bare type parameter boxes its instantiated pointer.

func classify(v *any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case @[]int:
		return "mgd-int"
	default:
		return "default"
	}
}

func classifyManaged(v @any) @[]char {
	switch v.(type) {
	case @[]char:
		return "mgd-mutable"
	case @[]readonly char:
		return "mgd-readonly"
	case @[]int:
		return "mgd-int"
	default:
		return "default"
	}
}

type RoSlicePtr = *(@[]readonly char)

type RoView = readonly @[]readonly char

type RoHandle = readonly @[]char

func viaCast[T any](x T) @[]char {
	return classify(cast(*any, &x))
}

func viaImplicit[T any](x T) @[]char {
	return classify(&x)
}

func viaVar[T any](x T) @[]char {
	var a *any = &x
	return classify(a)
}

func boxRaw[T any](x T) @[]char {
	return classify(cast(*any, x))
}

func boxManaged[T any](x T) @[]char {
	return classifyManaged(cast(@any, x))
}

type Pair[K any, V any] struct {
	k K
	v V
}

func (p @Pair[K, V]) First() @[]char {
	return classify(cast(*any, &p.k))
}

func (p @Pair[V, K]) FirstSwapped() @[]char {
	return classify(cast(*any, &p.k))
}

type Box[T any] struct {
	v T
}

func (b @Box[_]) Blank() @[]char {
	return classify(cast(*any, &b.v))
}

func (b @Box[U]) Named() @[]char {
	return classify(&b.v)
}

type Cell[T any] struct {
	v T
}

func (c @Cell[_]) Any() @[]char {
	return classifyManaged(cast(@any, c.v))
}

func main() {
	var s @[]readonly char = "hi"
	testing.Println(viaCast[@[]readonly char](s))     // mgd-readonly
	testing.Println(viaImplicit[@[]readonly char](s)) // mgd-readonly
	testing.Println(viaVar[@[]readonly char](s))      // mgd-readonly
	testing.Println(viaImplicit[RoView](s)) // mgd-readonly
	var m @[]char = "hi"
	testing.Println(viaCast[@[]char](m))     // mgd-mutable
	testing.Println(viaImplicit[RoHandle](m)) // mgd-mutable

	testing.Println(boxRaw[RoSlicePtr](&s)) // mgd-readonly
	var p @(@[]readonly char) = box(s)
	testing.Println(boxManaged[@(@[]readonly char)](p)) // mgd-readonly
	var ints @[]int = make_slice(int, 2)
	var pi @(@[]int) = box(ints)
	testing.Println(boxManaged[@(@[]int)](pi)) // mgd-int

	var rm @Pair[@[]readonly char, @[]char] = make(Pair[@[]readonly char, @[]char])
	rm.k = s
	rm.v = m
	testing.Println(rm.First(), rm.FirstSwapped()) // mgd-readonly mgd-readonly
	var mr @Pair[@[]char, @[]readonly char] = make(Pair[@[]char, @[]readonly char])
	mr.k = m
	mr.v = s
	testing.Println(mr.First(), mr.FirstSwapped()) // mgd-mutable mgd-mutable
	var bx @Box[@[]readonly char] = make(Box[@[]readonly char])
	bx.v = s
	testing.Println(bx.Blank(), bx.Named()) // mgd-readonly mgd-readonly
	var cl @Cell[@(@[]int)] = make(Cell[@(@[]int)])
	cl.v = pi
	testing.Println(cl.Any()) // mgd-int
}
