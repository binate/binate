package "main"
import "pkg/builtins/testing"

// A generic function's parameter and result types may put `readonly` around a
// type parameter or inside a composite built from one, or use a type parameter
// as a field of an anonymous struct; each instantiation substitutes there like
// anywhere else — in a generic function's signature, a generic type's method
// receiver (`*readonly Box[T]`), and an interface type argument of a generic
// impl (`Getter[readonly T]`).

func count[T any](s *[]readonly T) int {
	return len(s)
}

func countManaged[T any](s @[]readonly T) int {
	return len(s)
}

func first[T any](s *[]readonly T) readonly T {
	return s[0]
}

func keep[T any](x readonly T) readonly T {
	return x
}

func deref[T any](p *readonly T) T {
	return *p
}

func pick[T any](s struct { a T; b readonly T }) T {
	return s.a
}

func total[T any](xs ...readonly T) int {
	return len(xs)
}

func apply[T any](f *func(readonly T) readonly T, x T) readonly T {
	return f(x)
}

func twice(x readonly int) readonly int {
	return x * 2
}

func mk[T any](v T) struct { a T; b int } {
	var r struct { a T; b int }
	r.a = v
	r.b = 1
	return r
}

interface Getter[T any] {
	Get() T
}

type Box[T any] struct {
	v T
}

func (b *readonly Box[T]) Peek() T {
	return b.v
}

func (b @Box[T]) Get() readonly T {
	return b.v
}

impl @Box[T] : Getter[readonly T]

type RoInt = readonly int

func unbox[T any](b @Box[readonly T]) T {
	return b.v
}

type Point struct {
	x int
	y int
}

func main() {
	var ints @[]int = make_slice(int, 3)
	ints[0] = 7
	var ro *[]readonly int = ints
	testing.Println(count[int](ro), first[int](ro))
	var mro @[]readonly int = ints
	testing.Println(countManaged[int](mro))
	var s @[]readonly char = "hi"
	testing.Println(len(keep[@[]readonly char](s)))
	var pt Point
	pt.x = 3
	pt.y = 4
	var kept Point = keep[Point](pt)
	testing.Println(kept.x + kept.y)
	var n readonly int = 5
	testing.Println(deref[int](&n))
	var st struct { a int; b readonly int }
	st.a = 9
	testing.Println(pick[int](st))

	testing.Println(total[int](1, 2, 3), apply[int](twice, 4))
	var r struct { a int; b int } = mk[int](5)
	testing.Println(r.a + r.b)
	var bx @Box[int] = make(Box[int])
	bx.v = 42
	var bv Box[int]
	bv.v = 43
	testing.Println(bx.Peek(), bv.Peek())
	var g @Getter[readonly int] = bx
	testing.Println(g.Get())
	var rb @Box[readonly int] = box(Box[RoInt]{v: 44})
	testing.Println(unbox[int](rb))
}
