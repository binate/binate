package "main"

import "pkg/builtins/testing"

// Whole-value copies of aggregates with many scalar leaves: each copy is
// independent of its source, a parallel swap exchanges the two values, a
// self-assignment leaves the value unchanged, and a copied managed field is
// shared (not duplicated) by the copy.

type Pair struct {
	a int
	b int
}

type Rec struct {
	tag  @[]int
	data [40]uint8
	n    int
}

var g [64]int

func main() {
	var a [64]int
	for i := 0; i < 64; i++ {
		a[i] = i
	}
	var b [64]int
	b = a
	b[0] = 100
	testing.Println(a[0])
	testing.Println(b[0])
	testing.Println(b[63])

	a, b = b, a
	testing.Println(a[0])
	testing.Println(b[0])
	testing.Println(a[63])

	a = a
	testing.Println(a[0])
	testing.Println(a[62])

	g = a
	a[1] = 7
	testing.Println(g[1])
	testing.Println(a[1])

	var ps [20]Pair
	for i := 0; i < 20; i++ {
		ps[i] = Pair{a: i, b: i * 10}
	}
	var qs [20]Pair
	qs = ps
	qs[19].b = -1
	testing.Println(ps[19].b)
	testing.Println(qs[19].b)
	testing.Println(qs[18].b)

	var r Rec
	r.tag = make_slice(int, 2)
	r.tag[0] = 5
	r.data[5] = 9
	r.n = 3
	var s Rec
	s = r
	s.data[5] = 10
	s.tag[0] = 6
	testing.Println(cast(int, r.data[5]))
	testing.Println(cast(int, s.data[5]))
	testing.Println(r.tag[0])
	testing.Println(s.n)

	var d [40]uint8
	d = r.data
	r.data[5] = 11
	testing.Println(cast(int, d[5]))
	testing.Println(cast(int, r.data[5]))
}
