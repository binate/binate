package "main"

import "pkg/builtins/testing"

// Assigning an aggregate copies exactly its own bytes into the target — the
// field, element or variable that follows the target keeps its value, whatever
// the aggregate's size.  An aggregate whose size is not a multiple of 8 (a
// [3]char, a 3-byte struct, an [11]char) is the case a word-at-a-time copy gets
// wrong: its last word reaches past the target into whatever follows it.

type P3 struct {
	a uint8
	b uint8
	c uint8
}

type F3 struct {
	v  [3]char
	s1 uint8
	s2 uint8
	s3 uint8
	s4 uint8
	s5 uint8
}

type FP struct {
	p  P3
	s1 uint8
	s2 uint8
	s3 uint8
	s4 uint8
	s5 uint8
}

type F11 struct {
	v [11]char
	s [5]uint8
}

type F5 struct {
	v [5]char
	s [3]uint8
}

type F7 struct {
	v [7]char
	s uint8
}

type Q12 struct {
	a uint32
	b uint32
	c uint32
}

type F37 struct {
	v [37]char
	s [3]uint8
}

type Big struct {
	v [4099]char
	s [5]uint8
}

var g1 [1]char

var after1 [7]char = "after-1"

var g3 [3]char

var after3 [5]char = "after"

func main() {
	var src3 [3]char = "abc"
	var f F3
	f.s1, f.s2, f.s3, f.s4, f.s5 = 1, 2, 3, 4, 5
	f.v = src3 // a field
	testing.Println(f.v[:], f.s1, f.s2, f.s3, f.s4, f.s5)

	var q P3 = P3{7, 8, 9}
	var fp FP
	fp.s1, fp.s2, fp.s3, fp.s4, fp.s5 = 1, 2, 3, 4, 5
	fp.p = q // a 3-byte struct field
	testing.Println(fp.p.a, fp.p.c, fp.s1, fp.s2, fp.s3, fp.s4, fp.s5)

	var src11 [11]char = "hello world"
	var f11 F11
	f11.s = [5]uint8{1, 2, 3, 4, 5}
	f11.v = src11 // a word, then a 3-byte tail
	testing.Println(f11.v[:], f11.s[0], f11.s[1], f11.s[2], f11.s[3], f11.s[4])

	var arr [3][3]char = [3][3]char{"aaa", "bbb", "ccc"}
	arr[0] = src3 // an array element
	testing.Println(arr[0][:], arr[1][:], arr[2][:])
	var pa *([3]char) = &arr[1]
	var src3b [3]char = "xyz"
	*pa = src3b // through a pointer
	testing.Println(arr[0][:], arr[1][:], arr[2][:])
	var ps *([3]char) = &src3
	*pa = *ps // a pointee copied to a pointee
	testing.Println(arr[0][:], arr[1][:], arr[2][:])

	var src5 [5]char = "fives"
	var f5 F5
	f5.s = [3]uint8{1, 2, 3}
	f5.v = src5 // a 5-byte aggregate
	var src7 [7]char = "sevenss"
	var f7 F7
	f7.s = 9
	f7.v = src7 // a 7-byte aggregate
	testing.Println(f5.v[:], f5.s[0], f5.s[2], f7.v[:], f7.s)

	var qs [3]Q12
	qs[0] = Q12{7, 8, 9}
	qs[2] = Q12{42, 43, 44}
	var qd *Q12 = &qs[1]
	var qsrc *Q12 = &qs[0]
	*qd = *qsrc // a 4-aligned 12-byte pointee copy, the next element intact
	testing.Println(qs[1].a, qs[1].c, qs[2].a)

	var f37 F37
	f37.s = [3]uint8{4, 5, 6}
	var src37 [37]char = "thirty-seven characters in this array"
	f37.v = src37 // past 32 bytes, with a 5-byte tail
	testing.Println(f37.v[:], f37.s[0], f37.s[2])

	var big Big
	big.s = [5]uint8{1, 2, 3, 4, 5}
	var srcBig [4099]char
	srcBig[4098] = 'z'
	big.v = srcBig // a tail past the short immediate offsets
	testing.Println(cast(int, big.v[4098]), big.s[0], big.s[4])

	var one [1]char = "x"
	g1 = one // package variables
	g3 = src3b
	testing.Println(g1[:], after1[:], g3[:], after3[:])
}
