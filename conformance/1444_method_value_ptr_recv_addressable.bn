package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// func.method-value.capture: a method value bound to a `*T`-receiver method
// captures `&x`, so a call through it mutates x — for every addressable x: a
// dereference, a composite literal, a field reached through a returned
// pointer, an element of a package variable, a field of a generic struct, a
// generic type's own `*T` method on a variable, a field or an element, a
// field of a type-assertion's recovered pointee.  Capturing the address takes
// no reference: a struct with managed fields bound this way in a loop leaves
// no live blocks behind.

type P struct {
	v    int
	name @[]char
}

func (p *P) Inc() int {
	p.v = p.v + 1
	return p.v
}

type S struct {
	p   P
	arr [2]P
}

type Box[T any] struct {
	p P
	t T
	n int
}

func (b *Box[T]) Bump() int {
	b.n = b.n + 1
	return b.n
}

type WB struct {
	b   Box[int]
	arr [2]Box[int]
}

interface Ider {
	Id() int
}

func (s *S) Id() int { return 1 }

impl *S : Ider

var g S

func mkp() *S { return &g }

func main() {
	var p P
	var pp *P = &p
	var h1 *func() int = (*pp).Inc
	h1()
	testing.Println("deref", p.v)
	var h2 *func() int = P{v: 5}.Inc
	testing.Println("literal", h2(), h2())
	var h3 *func() int = mkp().p.Inc
	h3()
	testing.Println("through a returned pointer", g.p.v)
	var h4 *func() int = g.arr[1].Inc
	h4()
	h4()
	testing.Println("package variable element", g.arr[1].v)
	var b Box[int]
	var h5 *func() int = b.p.Inc
	h5()
	testing.Println("generic field", b.p.v)
	var hb *func() int = b.Bump
	hb()
	var w WB
	var hw *func() int = w.b.Bump
	hw()
	hw()
	var hwa *func() int = w.arr[1].Bump
	hwa()
	testing.Println("generic method", b.n, w.b.n, w.arr[1].n, w.arr[0].n)
	var a *Ider = &g
	var h6 *func() int = a.(*S).p.Inc
	h6()
	testing.Println("assertion", g.p.v)

	var s S
	s.p.name = "x"
	var base int = rt.LiveBlocks()
	for i := 0; i < 50; i++ {
		var h *func() int = s.p.Inc
		h()
	}
	testing.Println("loop", s.p.v, rt.LiveBlocks() - base)
}
