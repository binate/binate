package "main"

import "pkg/builtins/testing"

// A multi-value return, a returned aggregate and a function value's result
// carry exactly the aggregate's bytes.  An aggregate whose size is not a
// multiple of 8 (at an odd offset in a tuple, or behind a function value or
// closure) copied in whole words reaches past it — into the caller's saved
// registers, the next tuple field or the caller's buffer.  `run` keeps values
// live in callee-saved registers across the call that returns (uint8,
// [15]char), whose [15]char sits at offset 1.

var sink int

func helper(x int) int {
	sink = sink + x
	return x + 1
}

func mk(x uint8) (uint8, [15]char) {
	var k int = helper(cast(int, x))
	var r [15]char = "fifteen-chars!!"
	k = k + helper(k)
	sink = sink + k
	return x, r
}

func run(n int) int {
	var a int = helper(n)
	var b int = helper(a)
	x, arr := mk(65)
	return a + b * 1000 + cast(int, x) + cast(int, arr[0])
}

func mk3(x uint8) (uint8, [3]char, uint8) { return x, "abc", x + 1 }

func mkBig(x uint8) (uint8, [30]char, uint8) {
	var r [30]char
	for i := 0; i < 30; i++ { r[i] = 'q' }
	r[29] = 'z'
	return x, r, x + 2
}

func three() [3]char { return "xyz" }

func eleven() [11]char { return "hello world" }

type Maker struct {
	s [7]char
}

func (m *Maker) make7() [7]char { return m.s }

func main() {
	testing.Println(run(4096))

	a, b, c := mk3(7)
	testing.Println(a, b[:], c)
	var d uint8
	var e [30]char
	var f uint8
	d, e, f = mkBig(9)
	testing.Println(d, cast(int, e[0]), cast(int, e[29]), f)

	var f3 *func() [3]char = three
	var f11 *func() [11]char = eleven
	var r3 [3]char = f3()
	var r11 [11]char = f11()
	testing.Println(r3[:], r11[:])
	var m Maker
	m.s = "seven!!"
	var f7 *func() [7]char = m.make7
	var r7 [7]char = f7()
	testing.Println(r7[:])
	var suffix int = 13
	var cl *func() [3]char = func() [3]char {
		if suffix == 13 { return "cl!" }
		return "no!"
	}
	var rc [3]char = cl()
	testing.Println(rc[:])
}
