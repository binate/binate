package "main"

import "pkg/builtins/testing"
import _ "pkg/qa"
import q "pkg/qa"
import r "pkg/qa"

// A package imported more than once — blank plus named, and under two aliases —
// is one package: every name reaches the same functions, types and variables,
// and its declarations are registered once (each function declared once).

func main() {
	testing.Println(q.Get(), r.Get(), q.G, r.G)
	var p q.Pair = r.Pair{a: 3, b: 4}
	testing.Println(p.Sum())
}
