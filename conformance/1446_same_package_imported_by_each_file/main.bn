package "main"

import "pkg/builtins/testing"
import "pkg/qa"
import "pkg/user"

// A package imported by every file of another package, under a different name in
// each (blank in one), and by that package's .bni and by main too, is one
// package: every name reaches the same functions, types and variables, and its
// declarations are registered once (each function declared once).  Each file
// imports it once (spec pkg.import.once).

func main() {
	var a int
	var b int
	var c int
	var d int
	a, b = user.ViaQ()
	c, d = user.ViaR()
	testing.Println(a, c, b, d)
	var p qa.Pair = user.MakePair()
	testing.Println(user.Sum(p), p.Sum(), user.Three())
}
