package "main"

import "pkg/builtins/testing"

// Aggregates with many scalar leaves passed by value — to a function, a
// function value and an interface method: the callee gets its own copy (its
// writes do not reach the caller or another argument), a value passed in a loop
// is re-read each iteration, and a managed field in a copied struct is shared.
// The twoUses* functions read one field twice; at -O1 and above the two reads
// become one value with two uses, which the LLVM backend copies into the call's
// argument slot rather than passing its private copy.

interface Summer {
	Sum(a [64]int, from int) int
}

type Acc struct {
	base int
}

func (s *Acc) Sum(a [64]int, from int) int {
	var t int = s.base
	for i := from; i < 64; i++ {
		t = t + a[i]
	}
	a[0] = -1
	return t
}

impl *Acc : Summer

type Box struct {
	arr [64]int
}

type Rec struct {
	tag  @[]int
	data [40]uint8
}

func bump(a [64]int) int {
	a[0] = a[0] + 1000
	return a[0]
}

// bumpRec is bump, kept from being inlined by a recursive call that never runs.
func bumpRec(a [64]int) int {
	if a[1] == -5 { return bumpRec(a) }
	a[0] = a[0] + 1000
	return a[0]
}

func twoUsesDirect(bx @Box) int {
	var x [64]int = bx.arr
	return bumpRec(bx.arr) + x[0]
}

func twoUsesValue(bx @Box, fv *func([64]int) int) int {
	var x [64]int = bx.arr
	return fv(bx.arr) + x[0]
}

func twoUsesIface(bx @Box, s *Summer) int {
	var x [64]int = bx.arr
	return s.Sum(bx.arr, 62) + x[0]
}

func both(a [64]int, b [64]int) int {
	a[5] = 99
	return b[5]
}

func touch(r Rec) int {
	r.data[1] = 42
	r.tag[0] = r.tag[0] + 1
	return cast(int, r.data[1])
}

func main() {
	var a [64]int
	for i := 0; i < 64; i++ {
		a[i] = i
	}
	testing.Println(bump(a))
	testing.Println(a[0])

	testing.Println(both(a, a))
	testing.Println(a[5])

	var total int = 0
	for k := 0; k < 3; k++ {
		a[63] = k
		total = total + bump(a) + a[63]
	}
	testing.Println(total)

	var fv *func([64]int) int = bump
	testing.Println(fv(a))
	testing.Println(a[0])

	var acc Acc
	acc.base = 1
	var s *Summer = &acc
	testing.Println(s.Sum(a, 60))
	testing.Println(a[0])

	var bx @Box = make(Box)
	bx.arr[0] = 3
	bx.arr[62] = 20
	bx.arr[63] = 30
	testing.Println(twoUsesDirect(bx))
	testing.Println(twoUsesValue(bx, bump))
	testing.Println(twoUsesIface(bx, s))
	testing.Println(bx.arr[0])

	var r Rec
	r.tag = make_slice(int, 1)
	r.data[1] = 7
	testing.Println(touch(r))
	testing.Println(cast(int, r.data[1]))
	testing.Println(r.tag[0])
}
