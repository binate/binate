package "main"
import "pkg/builtins/testing"

// Any type can be written as an explicit type argument in an expression — a
// pointer to a parenthesized or managed type, a `readonly` type, a
// function-value type, an anonymous struct type — not only the forms that are
// also expressions (`T`, `*T`, `pkg.T`).  A bracketed element is still an index
// or slice bound whenever it parses as an expression, including a dereference of
// a parenthesized expression.

func id[T any](x T) T {
	return x
}

func second[A any, B any](a A, b B) B {
	return b
}

func double(x int) int {
	return x * 2
}

type Box[T any] struct {
	v T
}

func main() {
	var s @[]int = make_slice(int, 3)
	s[1] = 5
	testing.Println(len(*id[*(@[]int)](&s)), (*id[*@[]int](&s))[1])
	var arr [3]int
	arr[2] = 6
	testing.Println((*id[*([3]int)](&arr))[2])
	testing.Println(id[readonly int](7))
	testing.Println(id[*func(int) int](double)(5))
	var st struct { a int }
	st.a = 11
	testing.Println(id[struct { a int }](st).a)
	testing.Println(id[(int)](12))
	testing.Println(len(*second[readonly int, *(@[]int)](1, &s)))
	var b Box[readonly int] = Box[readonly int]{v: 13}
	testing.Println(b.v)

	var i int = 1
	var pi *int = &i
	testing.Println(s[*(pi)], s[*pi], len(s[*(pi):]))
}
