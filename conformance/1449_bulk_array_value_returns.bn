package "main"

import "pkg/builtins/testing"

// Aggregates with many scalar leaves returned by value — from a global, from a
// callee's local, from a parameter, through a wrapper, from a function value
// and an interface method: each result is its own copy, a result passed straight
// to another call or returned straight from a wrapper is that callee's or
// caller's own copy, a call in a loop returns a fresh value each iteration, and
// a returned struct's managed field is shared.

interface Maker {
	Make(k int) [64]int
}

type M struct {
	base int
}

func (m *M) Make(k int) [64]int {
	var a [64]int
	a[0] = m.base + k
	a[63] = k
	return a
}

impl *M : Maker

type Rec struct {
	tag  @[]int
	data [40]uint8
}

var g [64]int

func fromGlobal() [64]int {
	return g
}

func fromLocal(k int) [64]int {
	var a [64]int
	for i := 0; i < 64; i++ {
		a[i] = i * k
	}
	return a
}

func fromParam(a [64]int) [64]int {
	a[0] = a[0] + 1
	return a
}

func wrap(k int) [64]int {
	return fromLocal(k)
}

func pick(c bool) [64]int {
	if c {
		return fromLocal(2)
	}
	return fromGlobal()
}

func viaValue(fv *func(int) [64]int, k int) [64]int {
	return fv(k)
}

func viaIface(mk *Maker, k int) [64]int {
	return mk.Make(k)
}

func bump(a [64]int) int {
	a[0] = a[0] + 1000
	return a[0]
}

func mkRec(tag @[]int) Rec {
	var r Rec
	r.tag = tag
	r.data[2] = 8
	return r
}

func main() {
	g[0] = 5
	var h [64]int = fromGlobal()
	h[0] = 6
	testing.Println(g[0])
	testing.Println(h[0])

	h = fromLocal(3)
	testing.Println(h[10])

	h = fromParam(h)
	testing.Println(h[0])
	testing.Println(h[1])

	testing.Println(bump(fromLocal(4)))
	testing.Println(wrap(5)[7])
	testing.Println(pick(true)[3])
	testing.Println(pick(false)[0])

	var total int = 0
	for k := 1; k <= 3; k++ {
		h = wrap(k)
		total = total + h[1]
	}
	testing.Println(total)

	var fv *func(int) [64]int = fromLocal
	h = fv(7)
	testing.Println(h[2])

	var m M
	m.base = 100
	var mk *Maker = &m
	h = mk.Make(9)
	testing.Println(h[0])
	testing.Println(h[63])
	testing.Println(bump(mk.Make(1)))
	testing.Println(bump(fv(2)))
	h = viaIface(mk, 4)
	testing.Println(h[0])
	h = viaValue(fv, 5)
	testing.Println(h[3])

	var tag @[]int = make_slice(int, 1)
	var r Rec = mkRec(tag)
	r.tag[0] = 77
	testing.Println(tag[0])
	testing.Println(cast(int, r.data[2]))
}
