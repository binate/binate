package "main"

// A (bool, @Iface) multi-return.  The anonymous tuple {bool, iface}
// places the interface value AFTER a sub-word `bool`, so the tuple's
// layout inserts alignment padding before the iface.  Its compiler-
// generated destructor (__dtor_anon_bool_unknown) field-accesses that
// iface to RefDec it; the field-GEP index must use the anonymous-tuple
// (non-padded) LLVM form — the Binate index IS the LLVM index — rather
// than the named-struct (padded) remapping, which would overshoot
// (here to index 2 of a 2-field struct → invalid getelementptr).
//
// This is the inverse of 141 (a struct-with-managed-field multi-return);
// here the managed component is an interface value sitting after a bool.

interface Box { get() int }
type IntBox struct { v int }
func (b *IntBox) get() int { return b.v }
impl *IntBox : Box

func yn(b bool) int {
	if b { return 1 }
	return 0
}

// fallible models a Parse-style call: a bool plus a present/empty error
// stand-in.  ok → (true, empty); else → (false, a boxed IntBox).
func fallible(ok bool) (bool, @Box) {
	if ok {
		var none @Box
		return true, none
	}
	var ib @IntBox = make(IntBox)
	ib.v = 42
	var bx @Box = ib
	return false, bx
}

func main() {
	var b bool
	var bx @Box
	// Success path: empty iface (the tuple's iface slot is empty and
	// must clean up without dereferencing a null vtable).
	b, bx = fallible(true)
	println(yn(b))           // 1
	println(yn(present(bx))) // 0
	// Failure path: present iface, reachable through the tuple and
	// usable after destructuring.
	b, bx = fallible(false)
	println(yn(b))           // 0
	println(yn(present(bx))) // 1
	println(bx.get())        // 42
}
