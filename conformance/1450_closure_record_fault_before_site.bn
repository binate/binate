package "main"

import "pkg/builtins/testing"

// A bounds fault in a function's entry block, ahead of a capturing raw *func
// closure's site: the fault's cleanup pad releases the function's frame closure
// records too, including this one, whose site never ran.  The record is
// allocated (and zeroed) in the prologue, before any faulting op, so releasing
// it is a no-op and the fault reports cleanly -- the "index out of bounds" panic
// rather than a crash on a not-yet-allocated record (exercised under the VM,
// which unwinds recoverable faults through pads).

type T struct {
	v int
}

func faultCase(x @T, s *[]int) int {
	var bad int = s[5]
	var g *func() int = func() int { return x.v }
	return bad + g()
}

func main() {
	var t @T = make(T)
	t.v = 1
	var arr [3]int
	testing.Println(faultCase(t, arr[:]))
}
