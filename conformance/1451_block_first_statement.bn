package "main"
import "pkg/builtins/testing"

// A statement that is the first of a block — a loop body, an `if` or `else`
// body, a `switch` case, a loop's post statement — is carried out there, in
// that block.  The block before it (the loop condition's, the `if`
// condition's) has already ended in a branch, so none of the statement's work
// may land after that branch: the function would return early or trap.
// Covered: a struct-field `++` / `--` (on a struct variable, through managed
// and raw pointers, on a nested field, and after an identifier `++`); binding a
// function to a new variable (`f := add`); and assigning a variable to a `*any`.

type Inner struct {
	n int
}

type State struct {
	top int
	sub Inner
}

func loopLocal() int {
	var s State
	s.top = 3
	var n int = 0
	for s.top > 0 {
		s.top--
		n++
	}
	return n*10 + s.top
}

func loopManaged() int {
	var p @State = make(State)
	p.top = 4
	var n int = 0
	for p.top > 0 {
		p.top--
		n++
	}
	return n
}

func loopRaw() int {
	var s State
	var p *State = &s
	p.top = 2
	var n int = 0
	for p.top < 5 {
		p.top++
		n++
	}
	return n*10 + s.top
}

func loopNested() int {
	var s State
	var n int = 0
	for s.sub.n < 6 {
		s.sub.n++
		n++
	}
	return n
}

func loopAfterIdent() int {
	var s State
	s.top = 3
	var n int = 0
	for s.top > 0 {
		n++
		s.top--
	}
	return n
}

func loopPost() int {
	var s State
	var n int = 0
	for s.top = 0; s.top < 4; s.top++ {
		n++
	}
	return n*10 + s.top
}

func ifBody(c bool) int {
	var s State
	s.top = 5
	if c {
		s.top++
	}
	return s.top
}

func elseBody(c bool) int {
	var s State
	s.top = 5
	if c {
		s.top = 0
	} else {
		s.top--
	}
	return s.top
}

func caseBody(k int) int {
	var s State
	s.top = 7
	switch k {
	case 1:
		s.top++
	default:
		s.top--
	}
	return s.top
}

func add(a int, b int) int {
	return a + b
}

func mul(a int, b int) int {
	return a * b
}

func funcVarLoop(k int) int {
	var r int = 0
	for i := 1; i <= k; i++ {
		f := add
		r = f(r, i)
	}
	return r
}

func funcVarIf(c bool) int {
	var r int = 2
	if c {
		f := mul
		r = f(r, 5)
	}
	return r + 1
}

func funcVarCase(k int) int {
	var r int = 3
	switch k {
	case 1:
		f := add
		r = f(r, 4)
	default:
		f := mul
		r = f(r, 4)
	}
	return r
}

func anyLoop(k int) int {
	var v int = 5
	var a *any
	var n int = 0
	for i := 0; i < k; i++ {
		a = v
		n++
	}
	return n*10 + a.(int)
}

func anyIf(c bool) int {
	var v int = 9
	var one int = 1
	var a *any
	a = one
	if c {
		a = v
	}
	return a.(int)
}

func anyCase(k int) int {
	var v int = 6
	var w int = 8
	var a *any
	switch k {
	case 1:
		a = v
	default:
		a = w
	}
	return a.(int)
}

func main() {
	testing.Println(loopLocal())      // 30
	testing.Println(loopManaged())    // 4
	testing.Println(loopRaw())        // 35
	testing.Println(loopNested())     // 6
	testing.Println(loopAfterIdent()) // 3
	testing.Println(loopPost())       // 44
	testing.Println(ifBody(true))     // 6
	testing.Println(ifBody(false))    // 5
	testing.Println(elseBody(false))  // 4
	testing.Println(caseBody(1))      // 8
	testing.Println(caseBody(2))      // 6
	testing.Println(funcVarLoop(4))   // 10
	testing.Println(funcVarIf(true))  // 11
	testing.Println(funcVarIf(false)) // 3
	testing.Println(funcVarCase(1))   // 7
	testing.Println(funcVarCase(2))   // 12
	testing.Println(anyLoop(3))       // 35
	testing.Println(anyIf(true))      // 9
	testing.Println(anyIf(false))     // 1
	testing.Println(anyCase(1))       // 6
	testing.Println(anyCase(2))       // 8
}
