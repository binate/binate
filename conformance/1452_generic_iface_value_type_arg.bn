package "main"
import "pkg/builtins/testing"

// An interface value is a valid type argument: an instance with `T` bound to
// `*Getter` passes, stores and returns the two-word interface value intact, and
// a method call on the result dispatches to the boxed value's method.

interface Getter { Get() int }

type W struct { n int }

impl *W : Getter

func (w *W) Get() int { return w.n }

type GI = *Getter

func id[T any](x T) T {
	var y T = x
	return y
}

func main() {
	var w W
	w.n = 4
	var g *Getter = &w
	var h *Getter = id[GI](g)
	testing.Println(h.Get()) // 4
}
