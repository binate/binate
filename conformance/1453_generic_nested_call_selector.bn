package "main"
import "pkg/builtins/testing"

// A selector chain off a by-value call result reaches through every level of a
// nested generic instance: `bbb.Get().v.v` on a `Box[Box[Box[int8]]]` reads the
// innermost value.

type Box[T any] struct {
	v T
	n int
}

func (b *Box[T]) Get() T { return b.v }

func main() {
	var bb Box[Box[int8]]
	bb.v.v = 2
	testing.Println(bb.Get().v) // 2
	var bbb Box[Box[Box[int8]]]
	bbb.v.v.v = 3
	testing.Println(bbb.Get().v.v) // 3
}
