package "main"
import "pkg/builtins/testing"
import "pkg/builtins/rt"

// A managed `@any` box of a NAMED managed slice or owning array (`type S @[]int`,
// `type Arr2 [2]@Node`) matches its own `case @S:` / `a.(@Arr2)`, and a type
// switch over it tells the named type from the unnamed one it is defined as.  The
// dynamic type has one identity whatever route the value took — boxed into `@any`
// directly, into a user interface, or upcast from that interface to `@any` — and
// a raw `*any` of the same value matches `*S`.  Dropping such a box releases
// exactly what it holds, also when it is the pointee's only owner.  A raw `*any`
// of `&np` for `np @Node` holds an `@Node`, not a Node: it does not match `case
// *Node:`, and boxing it first does not give Node's row the wrong destructor for
// a later `@any` of a plain `@Node`.

type S @[]int

type Node struct {
	v int
}

type SN @[]@Node

// rawBoxNode and soleNode come first so that rawBoxNode's box is the first to
// reach Node's `any` identity.
func rawBoxNode(np @Node, rp *Node) (bool, bool) {
	var r *any = &np
	var q *any = rp
	_, viaCell := r.(*Node)
	_, direct := q.(*Node)
	return viaCell, direct
}

func soleNode(v int) @any {
	var m @Node = make(Node)
	m.v = v
	return m
}

type Arr2 [2]@Node

interface Getter {
	Get() int
}

func (a Arr2) Get() int {
	return 0
}

impl Arr2 : Getter

func name(a @any) @[]char {
	switch a.(type) {
	case @S:
		return "S"
	case @[]int:
		return "slice"
	case @Arr2:
		return "Arr2"
	case @Node:
		return "node"
	default:
		return "default"
	}
}

func rawName(a *any) @[]char {
	switch a.(type) {
	case *S:
		return "S"
	case *Arr2:
		return "Arr2"
	default:
		return "default"
	}
}

func readRC(hdr *int) int {
	var p *uint8 = bit_cast(*uint8, hdr[2])
	if p == nil {
		return 0
	}
	return rt.Refcount(p)
}

func rcOf(n @Node) int {
	return rt.Refcount(bit_cast(*uint8, n))
}

func boxAndDrop(s S, arr Arr2) {
	var a @any = box(s)
	var b @any = box(arr)
	_ = a
	_ = b
}

func soleSN(n @Node) @any {
	var t SN = make_slice(@Node, 1)
	t[0] = n
	return box(t)
}

func soleArr(n @Node) @any {
	var t Arr2
	t[1] = n
	return box(t)
}

func main() {
	var s S = make_slice(int, 3)
	s[1] = 7
	var a @any = box(s)
	testing.Println(name(a))
	var got @S
	var ok bool
	got, ok = a.(@S)
	testing.Println(ok, len(*got), (*got)[1])
	var plain @[]int = make_slice(int, 2)
	testing.Println(name(box(plain)))

	var n @Node = make(Node)
	n.v = 9
	var arr Arr2
	arr[0] = n
	testing.Println(name(box(arr)), name(n))
	testing.Println(rawName(&s), rawName(&arr))

	var ok2 bool
	var ok3 bool
	var ga @Getter = box(arr)
	_, ok = ga.(@Arr2)
	var up @any = ga
	_, ok2 = up.(@Arr2)
	var direct @any = box(arr)
	_, ok3 = direct.(@Arr2)
	testing.Println(ok, ok2, ok3, name(up))

	var ps *int = bit_cast(*int, &s)
	var sBefore int = readRC(ps)
	var nBefore int = rcOf(n)
	for i := 0; i < 10; i++ {
		boxAndDrop(s, arr)
	}
	testing.Println(readRC(ps) == sBefore, rcOf(n) == nBefore)
	for i := 0; i < 10; i++ {
		var x @any = soleSN(n)
		var y @any = soleArr(n)
		_ = x
		_ = y
	}
	testing.Println(rcOf(n) == nBefore)

	viaCell, direct := rawBoxNode(n, n)
	testing.Println(viaCell, direct)
	for i := 0; i < 3; i++ {
		var sole @any = soleNode(i)
		_ = sole
	}
	testing.Println("done")
}
