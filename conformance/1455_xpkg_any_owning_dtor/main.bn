package "main"
import "pkg/builtins/testing"
import "pkg/builtins/rt"

// A (T, any) row is emitted as a weak copy by every package that boxes or asserts
// T, and the link keeps one.  Package pq only raw-boxes and asserts its named
// managed slice, its named owning array and a name-less managed slice; main boxes
// the same types into `@any`.  Whichever copy is kept, its slot-0 destructor must
// be the owning one, so dropping main's boxes releases the node they hold.

import "pkg/pq"

func rcOf(n @pq.Node) int {
	return rt.Refcount(bit_cast(*uint8, n))
}

func main() {
	var n @pq.Node = make(pq.Node)
	var sn pq.SN = make_slice(@pq.Node, 1)
	sn[0] = n
	var arr pq.Arr
	arr[0] = n
	var sl @[]@pq.Node = make_slice(@pq.Node, 1)
	sl[0] = n
	testing.Println(pq.SeeSN(&sn), pq.SeeArr(&arr), pq.SeeSlice(&sl))
	var before int = rcOf(n)
	for i := 0; i < 10; i++ {
		var t pq.SN = make_slice(@pq.Node, 1)
		t[0] = n
		var a @any = box(t)
		var u pq.Arr
		u[1] = n
		var b @any = box(u)
		var v @[]@pq.Node = make_slice(@pq.Node, 1)
		v[0] = n
		var c @any = box(v)
		_ = a
		_ = b
		_ = c
	}
	testing.Println(rcOf(n) == before)
}
