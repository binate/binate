package "pkg/pq"

// Node is a managed element.
type Node struct {
	V int
}

// SN is a named managed slice of nodes.
type SN @[]@Node

// Arr is a named owning array of nodes.
type Arr [2]@Node

// SeeSN raw-boxes p into `*any` and asserts it back; it never boxes an SN into
// `@any`.
func SeeSN(p *SN) bool

// SeeArr raw-boxes p into `*any` and asserts it back.
func SeeArr(p *Arr) bool

// SeeSlice raw-boxes a name-less managed slice of nodes and asserts it back.
func SeeSlice(p *(@[]@Node)) bool
