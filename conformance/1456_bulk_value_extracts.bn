package "main"

import "pkg/builtins/testing"

// Members read out of aggregates with many scalar leaves that are values, not
// variables — the results of a multi-return call and fields of a returned
// struct: each member read is the value's own, a member stored or passed on is
// a copy, a multi-return forwarded through a wrapper or called in a loop gives
// that call's values, and a managed field of a result is shared.

type In struct {
	data [40]uint8
	k    int
}

type Big struct {
	tag  @[]int
	inner In
	arr  [64]int
	pair [2]int
	n    int
}

var gb Big

func two(k int) ([64]int, [64]int) {
	var a [64]int
	var b [64]int
	a[0] = k
	a[63] = k * 2
	b[0] = -k
	return a, b
}

func fwd(k int) ([64]int, [64]int) {
	return two(k)
}

func mkBig() Big {
	return gb
}

func pairOf() (Big, int) {
	return gb, 7
}

func bump(a [64]int) int {
	a[0] = a[0] + 1000
	return a[0]
}

func main() {
	a, b := two(3)
	testing.Println(a[0])
	testing.Println(a[63])
	testing.Println(b[0])

	a, b = fwd(4)
	testing.Println(a[0] + b[0])

	var total int = 0
	for k := 1; k <= 3; k++ {
		a, b = two(k)
		total = total + a[63] + b[0]
	}
	testing.Println(total)

	a, _ = two(5)
	testing.Println(bump(a))
	testing.Println(a[0])

	gb.tag = make_slice(int, 1)
	gb.inner.data[7] = 9
	gb.inner.k = 11
	gb.arr[5] = 55
	gb.pair[1] = 22
	gb.n = 33
	testing.Println(mkBig().n)
	testing.Println(mkBig().pair[1])
	testing.Println(mkBig().arr[5])
	testing.Println(cast(int, mkBig().inner.data[7]))
	testing.Println(mkBig().inner.k)

	var arr [64]int = mkBig().arr
	arr[5] = 0
	testing.Println(gb.arr[5])
	testing.Println(bump(mkBig().arr))

	r, x := pairOf()
	r.tag[0] = 44
	testing.Println(gb.tag[0])
	testing.Println(r.arr[5] + x)
}
