package "main"

import "pkg/builtins/testing"
import "pkg/geom"

// A package-level variable whose type is inferred from a non-literal
// initializer gets that type, laid out and with its methods as for the
// explicitly typed form: a generic instantiation (this package's or another
// package's), a pointer to one, an interface value, another package's named
// type behind a managed pointer, a struct of a package reached only through
// another, a named non-struct type (whose methods are its own), a raw slice of
// readonly elements, a generic interface's value, and instantiations whose type
// arguments are named or imported types.

type Box[T any] struct {
	v T
	w T
}

func (b *Box[T]) Get() T { return b.v }

func mkBox[T any](v T, w T) Box[T] {
	var b Box[T]
	b.v = v
	b.w = w
	return b
}

func mkBoxP(v int) @Box[int] {
	var p @Box[int] = make(Box[int])
	p.v = v
	return p
}

interface Shape {
	Area() int
}

type Sq struct {
	s int
}

func (q *Sq) Area() int { return q.s * q.s }

impl *Sq : Shape

var sq Sq = Sq{s: 3}
var gi *Shape = &sq

type Money int

func (m Money) Twice() int { return cast(int, m) * 2 }

var m3 Money = 3
var cs *[]readonly char = "hey"

interface Holder[T any] {
	Get() T
}

type IntBox struct {
	n int
}

func (b *IntBox) Get() int { return b.n }

impl *IntBox : Holder[int]

var ib IntBox = IntBox{n: 42}

func mkH() *Holder[int] { return &ib }

var gb = mkBox[int](6, 60)
var gp = &gb
var gm = mkBoxP(11)
var gi2 = gi
var g1 = geom.NewPoint(1, 2)
var gg = geom.MkPair[int32](4, 5)
var gv = geom.MkV(20, 30)
var gn = m3
var gcs = cs
var gh = mkH()
var gmb = mkBox[Money](m3, m3)
var gpb = mkBox[geom.Point](geom.Point{x: 1, y: 2}, geom.Point{x: 3, y: 4})

func main() {
	testing.Println(gb.v, gb.w, gb.Get())
	gp.v = 7
	testing.Println(gb.v, gp.Get())
	testing.Println(gm.Get(), gm.w)
	testing.Println(gi2.Area())
	testing.Println(g1.Sum())
	testing.Println(gg.First(), gg.b)
	testing.Println(gv.a, gv.b)
	testing.Println(gn.Twice(), len(gcs), cast(int, gcs[0]))
	testing.Println(gh.Get())
	testing.Println(gmb.v.Twice(), gpb.w.y)
}
