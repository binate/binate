package "pkg/geom"

import "pkg/inner"

type Point struct {
	x int
	y int
}

func NewPoint(x int, y int) @Point

func (p *Point) Sum() int

type Pair[T any] struct {
	a T
	b T
}

func MkPair[T any](a T, b T) Pair[T] {
	var p Pair[T]
	p.a = a
	p.b = b
	return p
}

func (p *Pair[T]) First() T { return p.a }

func MkV(a int, b int) inner.V
