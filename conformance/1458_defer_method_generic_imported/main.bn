package "main"

import "pkg/builtins/testing"
import "pkg/lib"

// A deferred method call calls the method the direct call does: on a local, a
// parameter or a package variable of a generic instantiation, on one whose type
// argument is the enclosing generic function's type parameter, inside a method
// of a generic type whose receiver renames, blanks or swaps the type's
// parameters, on a receiver whose type is a type parameter, and on another
// package's type, plain and generic.

var log int = 0

type Box[T any] struct {
	v T
}

func (b *Box[T]) Mark(n int) { log = log * 10 + n }

func (b Box[T]) Val() T { return b.v }

func (b *Box[U]) RunRenamed() { defer b.Mark(7) }

func (b *Box[_]) RunBlank() { defer b.Mark(8) }

interface Marker {
	Mark(n int)
}

impl *Box[T] : Marker

func viaConstraint[M Marker](m M) { defer m.Mark(6) }

type Pair[K any, V any] struct {
	k K
	v V
}

func (p *Pair[K, V]) Show() { testing.Println(p.k, p.v) }

// The receiver binds Pair's parameters in the other order: V names the first.
func (p *Pair[V, K]) Run() {
	p.Show()
	defer p.Show()
}

func local() {
	var b @Box[int] = make(Box[int])
	defer b.Mark(1)
	var c Box[bool]
	defer c.Mark(2)
	defer c.Val()
	log = log * 10 + 9
}

func param(b *Box[int8]) {
	defer b.Mark(3)
}

var gbox Box[uint16]

func global() {
	defer gbox.Mark(4)
}

func inGeneric[T any](v T) {
	var b Box[T]
	b.v = v
	defer b.Mark(5)
	var bb Box[Box[T]]
	defer bb.Mark(6)
}

func imported() {
	var lc @lib.Counter = lib.NewCounter(40)
	defer lc.Show(7)
	var cell lib.Cell[int]
	cell.v = 50
	defer cell.Show(8)
	testing.Println(6)
}

func main() {
	local()
	testing.Println(log) // 921
	log = 0
	var p Box[int8]
	param(&p)
	global()
	inGeneric[int32](3)
	inGeneric[bool](true)
	testing.Println(log) // 346565
	log = 0
	var bb Box[int]
	bb.RunRenamed()
	bb.RunBlank()
	viaConstraint[*Box[int]](&bb)
	testing.Println(log) // 786
	var pp Pair[int8, int64]
	pp.k = 7
	pp.v = 1234567890123
	pp.Run()
	var lp lib.Pair[int8, int64]
	lp.k = 9
	lp.v = 9876543210
	lp.Run()
	imported()
}
