package "pkg/lib"

import "pkg/builtins/testing"

type Counter struct {
	n int
}

func NewCounter(n int) @Counter

func (c *Counter) Show(tag int)

type Cell[T any] struct {
	v T
}

func (c *Cell[T]) Show(tag int) { testing.Println(tag, c.v) }

type Pair[K any, V any] struct {
	k K
	v V
}

func (p *Pair[K, V]) Show() { testing.Println(p.k, p.v) }

func (p *Pair[V, K]) Run() {
	p.Show()
	defer p.Show()
}
