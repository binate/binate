package "main"
import "pkg/builtins/testing"

// An assertion or type-switch target spelled through an alias of a non-nameable
// type — a pointer, slice, array, anonymous struct, function or interface value —
// is a compile error, as that type spelled directly is (§11.12 iface.assert).

type Node struct {
	v int
}

interface I {
	M()
}

type NP = @Node
type RP = *Node
type SL = @[]int
type AR = [2]int
type ST = struct { a int }
type FV = @func() int
type IV = @I

func main() {
	var n @Node = make(Node)
	var a @any = n
	_, _ = a.(*NP)
	_, _ = a.(@RP)
	_, _ = a.(SL)
	_, _ = a.(*AR)
	_, _ = a.(*ST)
	_, _ = a.(*FV)
	_, _ = a.(*IV)
	switch a.(type) {
	case *NP:
		testing.Println("np")
	}
}
