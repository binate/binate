package "main"

// A generic instantiation forced (by a global-var type) BETWEEN two method
// decls is cached only-partially populated — just the earlier method (Get).
// The end-of-collection back-fill must add the LATER method (Set) too:
// copyPlaceholderMethods back-fills the MISSING methods, not skip-if-any-present.
// Without that, g.Set(7) below is spuriously rejected as `undefined: Set`.

type Box[T any] struct {
	val T
}

func (b *Box[T]) Get() T {
	return b.val
}

var g Box[int]

func (b *Box[T]) Set(v T) {
	b.val = v
}

func main() {
	g.Set(7)
	println(g.Get())
}
