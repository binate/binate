package "main"
import "pkg/builtins/testing"

// An alias of a NAMED type is a legal assertion target — it names that type —
// and so is a named type defined over a pointer (it has a name of its own).

type Node struct {
	v int
}

type NN = Node

type MyInt = int

type H @Node

func main() {
	var n @Node = make(Node)
	n.v = 5
	var a @any = n
	got, ok := a.(@NN)
	testing.Println(ok, got.v)
	_, isH := a.(*H)
	testing.Println(isH)
	var x int = 7
	var r *any = &x
	v, ok2 := r.(MyInt)
	testing.Println(ok2, v)
}
