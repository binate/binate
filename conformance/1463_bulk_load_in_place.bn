package "main"

import "pkg/builtins/testing"

// Reads of large aggregates that the compiler may make in place instead of
// copying the value first: a copy out of a local only ever loaded and stored
// whole, and a return of one; a swap of two such locals (whose second read's
// source is overwritten before that value is stored, so it must not be read in
// place); a value passed to calls that write their copies; and — at -O1 and
// above, through inlining — scalar fields read from a struct passed by value,
// before and after its source is written.

type S17 struct {
	f0  int
	f1  int
	f2  int
	f3  int
	f4  int
	f5  int
	f6  int
	f7  int
	f8  int
	f9  int
	f10 int
	f11 int
	f12 int
	f13 int
	f14 int
	f15 int
	f16 int
}

type Big struct {
	data [20]int
	n    int
}

var g [30]int

func sum(a [30]int) int {
	var t int = 0
	for i := 0; i < 30; i++ {
		t = t + a[i]
	}
	a[0] = -1000
	return t
}

func first(a [30]int) int {
	return a[0]
}

func copyOut() [30]int {
	var a [30]int = g
	var b [30]int = a
	return b
}

func swapFirsts() int {
	var a [30]int = g
	var b [30]int
	a, b = b, a
	return first(a) * 100 + first(b)
}

func twice() int {
	var a [30]int = g
	return sum(a) + sum(a) + first(a)
}

func fields(p *Big) int {
	var x Big = *p
	return x.data[2] + x.n
}

func sumf(s S17) int {
	return s.f0 + s.f16
}

func viaPtr17(p *S17) int {
	return sumf(*p)
}

func twoCalls(p *S17) int {
	var s S17 = *p
	var r int = sumf(s)
	p.f0 = 1000
	return r + sumf(s)
}

func main() {
	for i := 0; i < 30; i++ {
		g[i] = i + 1
	}
	var c [30]int = copyOut()
	testing.Println(c[29])
	testing.Println(swapFirsts())
	testing.Println(twice())
	var b Big
	b.data[2] = 7
	b.n = 8
	testing.Println(fields(&b))
	var s S17
	s.f0 = 3
	s.f16 = 4
	testing.Println(viaPtr17(&s))
	testing.Println(twoCalls(&s))
	testing.Println(s.f0)
}
