package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/mid"
import "pkg/shapes"

// A named type defined over ANOTHER package's struct (`type S2 shapes.S`):
// boxed into an owning interface value, its box's slot-0 destructor must be the
// struct's own, which lives in the struct's package.  Were it keyed on the
// named type, the slot would be null and dropping the box would leave the
// `@shapes.Inner` one reference higher.  A field, a local and an array element
// of type S2 are dropped through the same destructor, and a named type declared
// in a third package (`mid.M2`, over shapes.S) boxes the same way.  Each
// refcount line must print 0.

interface Sizer { Size() int }

type S2 shapes.S
func (s *S2) Size() int { return shapes.Value(s.p) }
impl *S2 : Sizer

type V2 shapes.S
func (v V2) Size() int { return shapes.Value(v.p) + 1 }
impl V2 : Sizer

type Holder struct { s S2; n int }

func boxS2(p @shapes.Inner) {
	var b @S2 = make(S2)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxS2Any(p @shapes.Inner) {
	var b @S2 = make(S2)
	b.p = p
	var a @any = b
	_ = a
}

func boxV2(p @shapes.Inner) {
	var b @V2 = make(V2)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxV2Any(p @shapes.Inner) {
	var b @V2 = make(V2)
	b.p = p
	var a @any = b
	_ = a
}

func boxMidAny(p @shapes.Inner) {
	var b @mid.M2 = mid.Make(p)
	var a @any = b
	_ = a
}

func dropField(p @shapes.Inner) {
	var h @Holder = make(Holder)
	h.s.p = p
}

func dropLocal(p @shapes.Inner) {
	var v S2
	v.p = p
}

func dropArray(p @shapes.Inner) {
	var a [2]S2
	a[0].p = p
	a[1].p = p
}

func main() {
	var inr @shapes.Inner = shapes.NewInner(7)
	var before int = rt.Refcount(bit_cast(*uint8, inr))
	boxS2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxS2Any(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxV2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxV2Any(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxMidAny(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropField(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropLocal(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropArray(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
}
