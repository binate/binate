package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An impl on a named RAW pointer type (`type PS *S`, `impl PS : Sizer`) owns
// nothing, so its interface rows carry no slot-0 destructor.  The owning box
// that reaches the row — an `@PS` boxed into `@Sizer` — holds a borrowed
// pointer in its cell; dropping it must free only the cell.  Running the
// struct's destructor there would release a reference the box never took: the
// struct would be freed under its owner (`cell` below), and its `@Inner` field
// released with it.  Each line prints the refcount changes of the struct and of
// its field across one box-and-drop, which must be 0 0.  `type PS2 *S2`, a
// named pointer to a named type over the struct, behaves the same.

interface Sizer { Size() int }

type Inner struct { v int }
type S struct { p @Inner }
type S2 S

type PS *S
func (p PS) Size() int { return p.p.v }
impl PS : Sizer

type PS2 *S2
func (p PS2) Size() int { return p.p.v + 1 }
impl PS2 : Sizer

func boxPS(cell @S) {
	var c @PS = make(PS)
	var r *S = cell
	*c = cast(PS, r)
	var s @Sizer = c
	_ = s
}

func boxPS2(cell @S2) {
	var c @PS2 = make(PS2)
	var r *S2 = cell
	*c = cast(PS2, r)
	var s @Sizer = c
	_ = s
}

func main() {
	var inr @Inner = make(Inner)
	inr.v = 3
	var ib int = rt.Refcount(bit_cast(*uint8, inr))

	var cell @S = make(S)
	cell.p = inr
	var cb int = rt.Refcount(bit_cast(*uint8, cell))
	boxPS(cell)
	testing.Println(rt.Refcount(bit_cast(*uint8, cell)) - cb, rt.Refcount(bit_cast(*uint8, inr)) - ib - 1)

	var cell2 @S2 = make(S2)
	cell2.p = inr
	var cb2 int = rt.Refcount(bit_cast(*uint8, cell2))
	boxPS2(cell2)
	testing.Println(rt.Refcount(bit_cast(*uint8, cell2)) - cb2, rt.Refcount(bit_cast(*uint8, inr)) - ib - 2)
}
