package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A named type defined over a struct (`type S2 S`) shares the struct's layout
// and managed fields, and only the struct's own destructor is emitted.  Boxed
// into an owning interface value (a user interface or `@any`), its box's slot-0
// destructor must be the struct's: were it keyed on the named type, it would
// name a destructor that does not exist, the slot would be null, and dropping
// the box would free the cell without releasing its fields — the `@Inner` below
// would stay one reference higher per box.  Each line prints the refcount
// change across one box-and-drop, which must be 0.

interface Sizer { Size() int }

type Inner struct { v int }
type S struct { p @Inner }

// Named over the struct, with a pointer-receiver impl.
type S2 S
func (s *S2) Size() int { return s.p.v }
impl *S2 : Sizer

// Named over a named type over the struct.
type S3 S2
func (s *S3) Size() int { return s.p.v + 1 }
impl *S3 : Sizer

// Named over the struct, with a value-receiver impl.
type V2 S
func (v V2) Size() int { return v.p.v + 2 }
impl V2 : Sizer

// A named managed pointer to the named type: boxed as a value (`box(m)`), the box
// points at an MS2 cell, and dropping it releases the S2 that cell holds.
type MS2 @S2
func (m MS2) Size() int { return m.p.v + 3 }
impl MS2 : Sizer

// Named over a generic struct's instance.
type G[T any] struct { t T; p @Inner }
type G2 G[int]
func (g *G2) Size() int { return g.p.v + 5 }
impl *G2 : Sizer

// Declared before the named type and its struct.
impl *W2 : Sizer
func (w *W2) Size() int { return w.p.v + 4 }
type W2 W
type W struct { p @Inner }

func boxS2(p @Inner) {
	var b @S2 = make(S2)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxS2Any(p @Inner) {
	var b @S2 = make(S2)
	b.p = p
	var a @any = b
	_ = a
}

func boxS3(p @Inner) {
	var b @S3 = make(S3)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxV2(p @Inner) {
	var b @V2 = make(V2)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxMS2(p @Inner) {
	var m MS2 = make(S2)
	m.p = p
	var s @Sizer = box(m)
	testing.Println(s.Size())
}

func boxW2(p @Inner) {
	var b @W2 = make(W2)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxG2(p @Inner) {
	var b @G2 = make(G2)
	b.p = p
	var s @Sizer = b
	testing.Println(s.Size())
}

func boxG2Any(p @Inner) {
	var b @G2 = make(G2)
	b.p = p
	var a @any = b
	_ = a
}

func main() {
	var inr @Inner = make(Inner)
	inr.v = 3
	var before int = rt.Refcount(bit_cast(*uint8, inr))
	boxS2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxS2Any(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxS3(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxV2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxMS2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxW2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxG2(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	boxG2Any(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
}
