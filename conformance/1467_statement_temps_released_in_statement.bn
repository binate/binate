package "main"

import "pkg/builtins/testing"

// A statement's temporaries are released by that statement, not by a later one:
// an increment / decrement whose operand builds one (a slice made by make_slice,
// a function value passed to an @func parameter), and a switch case expression
// that builds one — including a case whose body is empty or starts with `break`
// — run correctly on every path, in a loop and under a condition that skips them.

func add1(x int) int {
	return x + 1
}

func apply(f @func(int) int, x int) int {
	return f(x)
}

func idx(f @func(int) int, i int) int {
	return f(i) - i - 1
}

func incdecIf(c bool) int {
	var a [2]int
	if c {
		a[len(make_slice(int, 1)) - 1]++
	}
	a[1]--
	return a[0] * 10 + a[1]
}

func incdecLoop() int {
	var a [1]int
	for i := 0; i < 3; i++ {
		a[idx(add1, i)]++
	}
	return a[0]
}

func pick(x int) {
	switch {
	case x == 0:
		testing.Println("zero")
	case apply(add1, x) == 7:
	}
	testing.Println("after", x)
}

func tagged() int {
	var n int = 0
	for i := 0; i < 3; i++ {
		switch i {
		case apply(add1, 0):
			break
		default:
			n++
		}
	}
	return n
}

func main() {
	testing.Println(incdecIf(true), incdecIf(false))
	testing.Println(incdecLoop())
	pick(0)
	pick(6)
	pick(3)
	testing.Println(tagged())
}
