package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/lk"

// An owning interface box of a named managed value whose impl is declared in
// another package — a named function value, managed slice, or array of managed
// slices — releases
// the boxed value when the box is dropped: the impl's vtable, emitted by the
// declaring package, carries the value's destructor.

func run() {
	var h lk.Hook = lk.Make(5)
	var a @lk.Applier = box(h)
	testing.Println(a.Apply(1)) // 6
	var any @any = box(lk.Make(7))
	var b @lk.Applier = any.(@lk.Applier)
	testing.Println(b.Apply(1)) // 8
	var l @lk.Lener = box(lk.MkS(3))
	testing.Println(l.Len()) // 3
	var la @lk.Lener = box(lk.MkA(6))
	testing.Println(la.Len()) // 13
}

func main() {
	// One run first: the VM builds a function's shared closure record on its
	// first use and keeps it, so the balance is taken from after that.
	run()
	var base int = rt.LiveBlocks()
	for i := 0; i < 3; i++ {
		run()
	}
	testing.Println(rt.LiveBlocks() - base) // 0
}
