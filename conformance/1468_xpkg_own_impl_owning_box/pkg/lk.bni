package "pkg/lk"

type Hook @func(int) int

interface Applier {
	Apply(x int) int
}

func (h Hook) Apply(x int) int

impl Hook : Applier

func Make(n int) Hook

type S @[]int

interface Lener {
	Len() int
}

func (s S) Len() int

impl S : Lener

func MkS(n int) S

type A [2]@[]int

func (a A) Len() int

impl A : Lener

func MkA(n int) A
