package "pkg/lk"

func (h Hook) Apply(x int) int { return h(x) }

func Make(n int) Hook {
	var h Hook = func(x int) int { return x + n }
	return h
}

func (s S) Len() int { return len(s) }

func MkS(n int) S {
	var s S = make_slice(int, n)
	return s
}

func (a A) Len() int { return len(a[0]) + len(a[1]) }

func MkA(n int) A {
	var a A
	a[0] = make_slice(int, n)
	a[1] = make_slice(int, n + 1)
	return a
}
