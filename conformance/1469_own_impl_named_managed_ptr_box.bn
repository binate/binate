package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An own impl on a named managed pointer type (`type PP @(@[]int)`) or a named
// managed interface value type (`type X @J`), boxed into a user interface:
// methods dispatched through the box see the receiver, and dropping the box
// releases it.

interface J {
	Get() int
}

interface Lener {
	Len() int
}

type Cell struct {
	n int
}

func (c *Cell) Get() int { return c.n }

impl *Cell : J

type X @J

func (x X) Len() int { return cast(@J, x).Get() }

impl X : Lener

func MkX(n int) X {
	var c @Cell = make(Cell)
	c.n = n
	var j @J = c
	return cast(X, j)
}

type PP @(@[]int)

func (p PP) Len() int { return len(*p) }

impl PP : Lener

func MkPP(n int) PP {
	var p PP = box(make_slice(int, n))
	return p
}

func run() {
	var lx @Lener = box(MkX(4))
	testing.Println(lx.Len()) // 4
	var p PP = MkPP(5)
	var lp @Lener = box(MkPP(5))
	testing.Println(p.Len(), lp.Len()) // 5 5
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	for i := 0; i < 3; i++ {
		run()
	}
	testing.Println(rt.LiveBlocks() - base) // 0
}
