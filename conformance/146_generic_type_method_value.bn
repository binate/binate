package "main"

// A method VALUE on a generic instantiation (bp.Get, taken as a function value).
// The monomorphized method body is now emitted at this use site too (the
// method-value path triggers lazy emission).  Currently xfail: a separate,
// pre-existing mangling defect names the captured-receiver struct with the raw
// source spelling `Box[int]` (an invalid LLVM identifier) instead of the mangled
// instantiation name — see claude-todo "method-value on generic instantiation".

type Box[T any] struct {
	val T
}

func (b *Box[T]) Get() T {
	return b.val
}

func main() {
	var bx Box[int]
	bx.val = 4
	var bp *Box[int] = &bx
	var f *func() int = bp.Get
	println(f())
}
