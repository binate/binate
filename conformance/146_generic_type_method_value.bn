package "main"

import "pkg/builtins/testing"

// Method VALUES on a generic instantiation, taken as function values and called.
// The monomorphized method body is emitted at the method-value use site (lazy
// emission), and the captured-receiver closure struct is named by the MANGLED
// instantiation name (`Box__bn_inst__int`), not the checker's raw `Box[int]`
// (which would be an invalid LLVM identifier).  Covers a pointer receiver with no
// args (bp.Get), a managed receiver with no args (mb.Get), and a pointer receiver
// with an argument (bp.Add).

type Box[T any] struct {
	val T
}

func (b *Box[T]) Get() T {
	return b.val
}

func (b *Box[T]) Add(x T) T {
	return b.val
}

func (b @Box[T]) MGet() T {
	return b.val
}

func main() {
	var bx Box[int]
	bx.val = 4
	var bp *Box[int] = &bx
	var f *func() int = bp.Get
	testing.Println(f())

	var g *func(int) int = bp.Add
	testing.Println(g(9))

	var mb @Box[int] = make(Box[int])
	mb.val = 5
	var h *func() int = mb.MGet
	testing.Println(h())
}
