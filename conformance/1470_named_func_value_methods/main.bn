package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/fv"

// A distinct named function-value type is a named type like any other: its
// methods are called directly, as method values and deferred, through an
// interface it implements and through a generic constraint; a box of one into
// `@any` is recovered by its own `case`; and its values — capturing closures
// included — are still called, copied, stored, deferred and released as
// function values, in every container and across packages.

type Fn @func(int) int

func (f Fn) Twice(x int) int { return f(f(x)) }

func (f Fn) Show(x int) { testing.Println(f(x)) }

func (f *Fn) Set(g Fn) { *f = g }

type RF readonly @func() int

func (r RF) Plus(n int) int { return r() + n }

interface Twicer {
	Twice(x int) int
}

impl Fn : Twicer

func viaConstraint[T Twicer](v T) int { return v.Twice(10) }

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() T { return b.v }

func inc(x int) int { return x + 1 }

func dbl(x int) int { return x * 2 }

func seven() int { return 7 }

func deferred(f Fn) { defer f.Show(4) }

func ident[T any](x T) T { return x }

type RH *func(int) int

func (h RH) Call2(x int) int { return h(h(x)) }

type Holder struct {
	fn Fn
}

type Say @func(int)

type SayHolder struct {
	s Say
}

var gcap Fn

func mk(n int) Fn {
	var g Fn = func(x int) int { return x + n }
	return g
}

func mkSay(tag int) Say {
	var s Say = func(x int) { testing.Println(tag + x) }
	return s
}

func pair(n int) (Fn, int) { return mk(n), n }

func applyTwice[T any](f @func(T) T, x T) T { return f(f(x)) }

func deferCalls(s Say, sh SayHolder, ss @[]Say) {
	defer s(1)
	defer sh.s(2)
	defer ss[0](3)
	testing.Println(0)
}

func run2() {
	var c Fn = mk(10)
	var hd Holder = Holder{fn: mk(1)}
	testing.Println(hd.fn(1), hd.fn.Twice(1)) // 2 3
	var cs @[]Fn = make_slice(Fn, 2)
	cs[0] = mk(2)
	cs[1] = c
	testing.Println(cs[0](1), cs[1].Twice(1)) // 3 21
	var ca [2]Fn
	ca[0] = mk(3)
	ca[1] = mk(4)
	testing.Println(ca[0](0) + ca[1](0)) // 7
	var bx Box[Fn]
	bx.v = mk(5)
	testing.Println(bx.Get()(0)) // 5
	gcap = mk(6)
	testing.Println(gcap.Twice(0)) // 12
	var a @any = box(c)
	switch v := a.(type) {
	case @Fn:
		testing.Println((*v)(1)) // 11
	}
	var tw @Twicer = box(c)
	testing.Println(tw.Twice(0)) // 20
	var tw2 @Twicer = a.(@Twicer)
	testing.Println(tw2.Twice(1)) // 21
	var ss @[]Say = make_slice(Say, 1)
	ss[0] = mkSay(300)
	deferCalls(mkSay(100), SayHolder{s: mkSay(200)}, ss) // 0 303 202 101
	var r Fn
	var k int
	r, k = pair(7)
	testing.Println(r(k)) // 14
	testing.Println(applyTwice[int](cast(@func(int) int, c), 1)) // 21
	var cc @func(int) int = func(x int) int { return c(x) * 2 }
	testing.Println(cc(1)) // 22
	var fc fv.Cell[fv.Hook] = fv.MkCell(fv.Make(2))
	testing.Println(fc.Get()(1), fc.v.Apply(1)) // 3 5
}

func kind(a *any) int {
	switch v := a.(type) {
	case *Fn:
		return (*v)(100)
	}
	return -2
}

var gf Fn = inc
var gg = gf

func run() {
	var f Fn = inc
	testing.Println(f(1), f.Twice(1)) // 2 3
	var mv *func(int) int = f.Twice
	testing.Println(mv(5)) // 7
	f.Set(dbl)
	testing.Println(f(3), f.Twice(3)) // 6 12
	deferred(f) // 8
	var t *Twicer = &f
	testing.Println(t.Twice(2)) // 8
	testing.Println(viaConstraint[Fn](f)) // 40
	var b Box[Fn]
	b.v = f
	var raw Box[@func(int) int]
	raw.v = inc
	testing.Println(b.Get()(1), raw.Get()(1), b.v.Twice(1)) // 2 2 4
	var r RF = seven
	testing.Println(r.Plus(1)) // 8
	testing.Println(gf(0), gg.Twice(0)) // 1 2
	var xs [2]Fn
	xs[0] = f
	xs[1] = inc
	testing.Println(xs[0].Twice(1), xs[1].Twice(1)) // 4 3
	var h fv.Hook = fv.Make(3)
	testing.Println(h(1), h.Apply(1)) // 4 7
	var fi Fn = ident[int]
	testing.Println(fi(5), fi.Twice(5)) // 5 5
	testing.Println(kind(&f)) // 200
	var rh RH = inc
	testing.Println(rh.Call2(1)) // 3
	var hd Holder = Holder{fn: f}
	testing.Println(hd.fn(4), hd.fn.Twice(4)) // 8 16
	var fs @[]Fn = make_slice(Fn, 2)
	fs[0] = inc
	fs[1] = f
	testing.Println(fs[0](1) + fs[1](1), fs[1].Twice(1)) // 4 4
}

func main() {
	// One run first: the VM builds a function's shared closure record on its
	// first use and keeps it, so the balance is taken from after that.
	run()
	run2()
	var base int = rt.LiveBlocks()
	for i := 0; i < 3; i++ {
		run()
		run2()
	}
	testing.Println(rt.LiveBlocks() - base) // 0
}
