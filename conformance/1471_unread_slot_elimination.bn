package "main"

import "pkg/builtins/testing"

// Local copies of a large struct whose parts are written or read in different
// combinations — at -O1 and above the struct is split into a slot per field,
// and a field slot nothing reads is dropped with its stores: one field read,
// a field written and then read, a field written and never read, a copy
// written back through the pointer, and a value read after its source changes.
// Dropping the unread slots also lets a backend read the remaining fields
// straight from the source, so the snap* functions write the source (directly,
// through a call, an alias, a global, a whole-struct store) between the copy
// and the read: the read must still see the value at the copy.

type Big struct {
	data [100]int
	n    int
	m    int
}

type Small struct {
	a int
	b int
	c int
}

var gb Big

func nOf(p *Big) int {
	var x Big = *p
	return x.n
}

func written(p *Big) int {
	var x Big = *p
	x.m = 5
	return x.n + x.m
}

func unread(p *Big) int {
	var x Big = *p
	x.data[0] = 1000
	return x.n
}

func copyBack(p *Big) {
	var x Big = *p
	x.data[3] = 9
	x.n = x.n + 1
	*p = x
}

func snapshot(p *Big) int {
	var x Big = *p
	p.n = 77
	p.data[2] = 77
	return x.n + x.data[2]
}

func bump(p *Big) { p.n = p.n + 100 }

func snapStore(p *Big) int {
	var x Big = *p
	p.n = 77
	return x.n
}

func snapCall(p *Big) int {
	var x Big = *p
	bump(p)
	return x.n
}

func snapAlias(p *Big, q *Big) int {
	var x Big = *p
	q.n = 55
	return x.n
}

func snapGlobal() int {
	var x Big = gb
	gb.n = 66
	return x.n
}

func snapBranch(p *Big, c bool) int {
	var x Big = *p
	p.n = 88
	if c { return x.n }
	return x.m
}

func snapSmall(p *Small) int {
	var x Small = *p
	p.a = 99
	return x.a
}

func snapWhole(p *Big, q *Big) int {
	var x Big = *p
	*p = *q
	return x.n
}

func snapTwo(p *Big) int {
	var x Big = *p
	var r int = x.m
	p.n = 1
	p.m = 1
	return x.n + r
}

func main() {
	var b Big
	b.n = 4
	b.m = 6
	b.data[2] = 2
	testing.Println(nOf(&b))
	testing.Println(written(&b))
	testing.Println(b.m)
	testing.Println(unread(&b))
	testing.Println(b.data[0])
	copyBack(&b)
	testing.Println(b.data[3])
	testing.Println(b.n)
	testing.Println(snapshot(&b))
	testing.Println(b.n + b.data[2])

	b.n = 4
	b.m = 6
	testing.Println(snapStore(&b))
	b.n = 4
	testing.Println(snapCall(&b))
	b.n = 4
	testing.Println(snapAlias(&b, &b))
	gb.n = 3
	testing.Println(snapGlobal())
	b.n = 4
	testing.Println(snapBranch(&b, true))
	b.n = 4
	testing.Println(snapBranch(&b, false))
	var s Small
	s.a = 1
	testing.Println(snapSmall(&s))
	var o Big
	o.n = 21
	b.n = 4
	testing.Println(snapWhole(&b, &o))
	b.n = 4
	b.m = 6
	testing.Println(snapTwo(&b))
}
