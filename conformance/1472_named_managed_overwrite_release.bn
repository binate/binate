package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A value of a named managed slice or pointer type — over destructible
// elements, or naming itself — is released through its destructor when it is
// overwritten (a variable, a slice element), dropped as a temporary, or goes out
// of scope: its elements, and a recursive value's whole subtree, are freed.

type Names @[]@[]char

type Tree @[]Tree

type Box struct {
	s @[]char
}

type H @Box

type M @M

func mkNames() Names {
	var n Names = make_slice(@[]char, 2)
	n[0] = make_slice(char, 4)
	n[1] = make_slice(char, 8)
	return n
}

func mkTree(d int) Tree {
	var t Tree = make_slice(Tree, 2)
	if d > 0 {
		t[0] = mkTree(d - 1)
		t[1] = mkTree(d - 1)
	}
	return t
}

func mkH() H {
	var b @Box = make(Box)
	b.s = make_slice(char, 3)
	var h H = b
	return h
}

func size(t Tree) int {
	var n int = 1
	for i := 0; i < len(t); i++ {
		n = n + size(t[i])
	}
	return n
}

func run() {
	var a Names = mkNames()
	a = mkNames()
	var ns @[]Names = make_slice(Names, 1)
	ns[0] = mkNames()
	ns[0] = mkNames()
	testing.Println(len(mkNames()), len(a), len(ns[0])) // 2 2 2
	var t Tree = mkTree(3)
	t = mkTree(2)
	t[0] = mkTree(1)
	testing.Println(size(mkTree(2)), size(t)) // 15 15
	var h H = mkH()
	h = mkH()
	testing.Println(len(mkH().s), len(h.s)) // 3 3
	var m M = make(M)
	*m = make(M)
	m = make(M)
	testing.Println(present(m)) // true
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	for i := 0; i < 3; i++ {
		run()
	}
	testing.Println(rt.LiveBlocks() - base) // 0
}
