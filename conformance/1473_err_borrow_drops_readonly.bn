package "main"
import "pkg/builtins/testing"

// Borrowing a managed pointer or slice as a raw one may not drop element-level
// readonly (§8.4): `@readonly int` does not borrow as `*int`, nor `@[]readonly int`
// as `*[]int` — as a declaration, an assignment, an argument or a result — and
// `cast` cannot do it either (unsafe_cast can).

func take(q *int) {
	*q = 1
}

func takeSlice(q *[]int) {
	q[0] = 1
}

func give(p @readonly int) *int {
	return p
}

func main() {
	var p @readonly int = box(5)
	var s @[]readonly int = make_slice(int, 2)
	var q *int = p
	var t *[]int = s
	q = p
	t = s
	take(p)
	takeSlice(s)
	_ = give(p)
	_ = cast(*int, p)
	testing.Println(*q, t[0])
}
