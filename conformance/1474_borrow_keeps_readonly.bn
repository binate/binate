package "main"
import "pkg/builtins/testing"

// A managed pointer or slice borrows as a raw one that keeps (or adds) its
// element-level readonly, and unsafe_cast may drop it on the borrow.

func sum(q *[]readonly int) int {
	var t int = 0
	for i := 0; i < len(q); i++ {
		t = t + q[i]
	}
	return t
}

func main() {
	var p @readonly int = box(5)
	var q *readonly int = p
	testing.Println(*q)
	var m @[]int = make_slice(int, 3)
	m[0] = 1
	m[2] = 4
	var s @[]readonly int = m
	var r *[]readonly int = s
	testing.Println(len(r), sum(s), sum(m))
	var w *[]int = unsafe_cast(*[]int, s)
	w[1] = 2
	testing.Println(m[1])
}
