package "main"
import "pkg/builtins/testing"

// Element-level readonly inside a function signature is part of a function-value
// type (§7.9 type.func.kinds, §7.11 type.readonly.param-signature), and inside an
// anonymous struct's field part of the struct: neither assignment may change it.

var g int = 1

func ro() *readonly int {
	return &g
}

func takesRo(p *readonly int) int {
	return *p
}

interface Putter {
	Put(p *readonly int)
}

type W struct {
	n int
}

func (w *W) Put(p *int) {
	*p = 2
}

impl *W : Putter

interface A {
	M(p *readonly int)
}

interface B {
	M(p *int)
}

interface AB : A, B {
}

type Fn @func(*readonly int)

func main() {
	var f *func() *readonly int = ro
	var h *func() *int = f
	var h2 *func() *int = ro
	var m @func() *readonly int = ro
	var r *func() *int = m
	var k *func(*int) int = takesRo
	var s struct { q *readonly int }
	s.q = &g
	var t struct { q *int } = s
	var fl Fn = func(p *int) {
		*p = 4
	}
	testing.Println(*h(), *h2(), *r(), k(&g), *t.q)
	fl(&g)
}
