package "main"
import "pkg/builtins/testing"

// Function values with identical signatures assign, as do signatures differing
// only in a parameter's outermost readonly; an anonymous struct copies across a
// change in a field's own outermost readonly.

func twice(x readonly int) int {
	return x * 2
}

func ro(p *readonly int) int {
	return *p
}

func apply(f *func(readonly int) int, x int) int {
	return f(x)
}

func main() {
	var f *func(int) int = twice
	var g *func(readonly int) int = f
	var r *func(*readonly int) int = ro
	var n int = 4
	testing.Println(f(3), g(5), r(&n))
	var s struct { a readonly int; b *readonly int }
	var t struct { a int; b *readonly int } = s
	t.a = 7
	testing.Println(t.a, t.b == nil)
	var ap *func(*func(int) int, int) int = apply
	testing.Println(ap(f, 6))
}
