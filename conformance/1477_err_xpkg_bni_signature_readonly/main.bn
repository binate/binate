package "main"
import "pkg/builtins/testing"

// A `.bn` function's parameter and result types must match its `.bni`
// declaration's with element-level readonly significant: a `.bn` that writes
// through what the `.bni` promised to read only, or hands out as writable what it
// declares readonly, is rejected.

import "pkg/sr"

func main() {
	var x int = 1
	testing.Println(sr.Poke(&x), *sr.Peek())
}
