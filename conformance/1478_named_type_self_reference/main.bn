package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/sm"

// A named type whose underlying names the type itself through an indirection —
// a function value returning the next state, a managed slice of itself, a slice
// of managed pointers to itself, an array of managed pointers to itself, a raw
// pointer to itself — and named types that name one another (through a function
// value, through slices only, through an alias; declared in either order) have
// those types everywhere they are named, in this package and in another, and are
// released when dropped.

type StateFn @func(int) StateFn

type Tree @[]Tree

type L @[]@L

type Arr [2]@Arr

type P *P

// Declared before the types they name.
type SA @[]SB

type MB @func(MA) MB

type MA @[]MB

type SB @[]SA

type TA = @[]TN

type TN @[]TA

// A named type that names an alias declared after it.
type TN2 @[]TA2

type TA2 = @[]TN2

type Holder struct {
	t Tree
	n int
}

type Box[T any] struct {
	v T
}

interface Sizer {
	Size() int
}

func (t Tree) Size() int { return depth(t) }

impl Tree : Sizer

func pairOf(t Tree) (Tree, int) { return t, len(t) }

func countL(l L) int {
	var n int = 1
	for i := 0; i < len(l); i++ {
		n = n + countL(*l[i])
	}
	return n
}

func mbStop(a MA) MB {
	var none MB
	return none
}

func mbStep(a MA) MB {
	if len(a) > 2 { return mbStop }
	return mbStep
}

var count int = 0

func stop(n int) StateFn {
	count = count + 100
	var none StateFn
	return none
}

func step(n int) StateFn {
	count = count + n
	if n > 2 { return stop }
	return step
}

func depth(t Tree) int {
	var d int = 0
	for i := 0; i < len(t); i++ {
		var c int = depth(t[i])
		if c > d { d = c }
	}
	return d + 1
}

func run() {
	count = 0
	var s StateFn = step
	for i := 1; present(s) && i < 10; i++ {
		s = s(i)
	}
	testing.Println(count) // 106
	var leaf Tree = make_slice(Tree, 0)
	var mid Tree = make_slice(Tree, 2)
	mid[0] = leaf
	mid[1] = leaf
	var top Tree = make_slice(Tree, 1)
	top[0] = mid
	testing.Println(depth(top)) // 3
	testing.Println(sm.Run(4)) // 10
	var s2 sm.Stepper = sm.Start()
	for k := 3; present(s2); k-- {
		s2 = s2(k)
	}
	testing.Println(sm.Total()) // 6
	var l L = make_slice(@L, 2)
	var e0 L = make_slice(@L, 0)
	var e1 L = make_slice(@L, 1)
	var e2 L = make_slice(@L, 0)
	e1[0] = box(e2)
	l[0] = box(e0)
	l[1] = box(e1)
	testing.Println(countL(l)) // 4
	var arr Arr
	arr[0] = make(Arr)
	(*arr[0])[1] = make(Arr)
	testing.Println(present(arr[0]), present(arr[1]), present((*arr[0])[1])) // true false true
	var p P
	var pp P = cast(P, &p)
	testing.Println(present(pp), present(*pp)) // true false
	var sa SA = make_slice(SB, 2)
	sa[1] = make_slice(SA, 3)
	testing.Println(len(sa), len(sa[1])) // 2 3
	var ma MA = make_slice(MB, 3)
	ma[0] = mbStep
	var steps int = 0
	var mb MB = ma[0]
	for present(mb) {
		mb = mb(ma)
		steps = steps + 1
	}
	testing.Println(steps) // 2
	var tn TN = make_slice(TA, 1)
	tn[0] = make_slice(TN, 2)
	testing.Println(len(tn), len(tn[0])) // 1 2
	var rtree readonly Tree = top
	testing.Println(depth(rtree)) // 3
	var a @any = box(top)
	switch v := a.(type) {
	case @Tree:
		testing.Println(depth(*v)) // 3
	}
	var tn2 TN2 = make_slice(TA2, 1)
	tn2[0] = make_slice(TN2, 2)
	tn2[0][1] = make_slice(TA2, 3)
	testing.Println(len(tn2), len(tn2[0]), len(tn2[0][1])) // 1 2 3
	var hd Holder = Holder{t: top, n: 5}
	var bx Box[Tree]
	bx.v = top
	var pt Tree
	var pn int
	pt, pn = pairOf(top)
	var sz @Sizer = box(top)
	testing.Println(depth(hd.t), depth(bx.v), depth(pt), pn, sz.Size()) // 3 3 3 1 3
	var st sm.STree = sm.MkSTree(2)
	testing.Println(sm.SSize(st), len(st)) // 15 2
}

func main() {
	// One run first: the VM builds a function's shared closure record on its
	// first use and keeps it, so the balance is taken from after that.
	run()
	var base int = rt.LiveBlocks()
	run()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
