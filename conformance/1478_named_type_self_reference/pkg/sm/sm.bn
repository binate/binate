package "pkg/sm"

var total int = 0

func down(n int) Stepper {
	total = total + n
	if n == 0 {
		var none Stepper
		return none
	}
	return down
}

func Run(n int) int {
	total = 0
	var s Stepper = down
	for k := n; present(s); k-- {
		s = s(k)
	}
	return total
}

func Start() Stepper {
	total = 0
	return down
}

func Total() int { return total }

func MkSTree(d int) STree {
	var t STree = make_slice(STree, 2)
	if d > 0 {
		t[0] = MkSTree(d - 1)
		t[1] = MkSTree(d - 1)
	}
	return t
}

func SSize(t STree) int {
	var n int = 1
	for i := 0; i < len(t); i++ {
		n = n + SSize(t[i])
	}
	return n
}
