package "main"

import "pkg/builtins/testing"

// Locals written before they are read, whose zero-fill — and a store the next
// whole store overwrites — is dropped at -O1 and above, next to locals that are
// read or partly written first and so must still start zeroed: an initialized
// array, one reassigned before any read, one reused each loop iteration, a
// partly-written struct, a managed struct, a local assigned whole twice (only
// ever loaded and stored whole, so its first store is dropped), a swap of two
// such locals, and a struct with padding compared with ==, which
// compares fields (padding contents are unspecified) — after a call that fills
// the stack with non-zero values, so a byte-wise compare would see them.

type Big struct {
	data [20]int
	n    int
}

type Rec struct {
	tag  @[]int
	data [20]int
}

type Padded struct {
	a uint8
	b int64
	c uint8
	d [3]int64
}

var g [20]int

func mk(k int) [20]int {
	var a [20]int
	for i := 0; i < 20; i++ {
		a[i] = i * k
	}
	return a
}

func sum(a [20]int) int {
	var t int = 0
	for i := 0; i < 20; i++ {
		t = t + a[i]
	}
	return t
}

func overwritten() int {
	var a [20]int = g
	a = mk(3)
	return sum(a)
}

func swapped() int {
	var a [20]int = g
	var b [20]int = mk(2)
	a, b = b, a
	return sum(a) * 1000 + sum(b)
}

func scribble() int {
	var s [64]int
	for i := 0; i < 64; i++ {
		s[i] = -1 - i
	}
	var t int = 0
	for i := 0; i < 64; i++ {
		t = t + s[i]
	}
	return t
}

func initialized() int {
	var x [20]int = g
	return x[3] + x[19]
}

func reassigned() int {
	var x [20]int = g
	x = mk(2)
	return x[3]
}

func loop() int {
	var total int = 0
	for k := 1; k <= 3; k++ {
		var x [20]int = mk(k)
		total = total + x[5]
	}
	return total
}

func partly() int {
	var x Big
	x.n = 5
	return x.data[3] + x.n
}

func declaredThenSet() int {
	var x Big
	var y Big
	y.n = 7
	x = y
	return x.n + x.data[0]
}

func managed() int {
	var r Rec = Rec{tag: make_slice(int, 1)}
	r.tag[0] = 4
	var s Rec = r
	s.tag[0] = s.tag[0] + 1
	return r.tag[0] + s.data[2]
}

func padded(q Padded) int {
	var p Padded = q
	var e int = 0
	if p == q { e = 1 }
	return e * 100 + cast(int, p.c)
}

func main() {
	for i := 0; i < 20; i++ {
		g[i] = i + 1
	}
	testing.Println(initialized())
	testing.Println(reassigned())
	testing.Println(loop())
	testing.Println(partly())
	testing.Println(declaredThenSet())
	testing.Println(managed())
	testing.Println(overwritten())
	testing.Println(swapped())
	testing.Println(scribble())
	var q Padded
	q.a = 1
	q.b = 2
	q.c = 3
	q.d[1] = 4
	testing.Println(padded(q))
}
