package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/op"

// An opaque type may be defined as any type, not only a struct literal: here
// op.bni declares `type X` and op.bn defines X as a scalar, a managed slice, a
// managed pointer, an array, a managed slice of managed pointers, a managed
// pointer to a managed pointer, a named type over a struct, and a func value.
// Each works through its package's functions and methods (also through an
// interface), and an `@X` dropped here — where X's definition is not visible —
// releases what it holds (through the destructor op emits for X).  Each
// refcount line must print 0.

func dropL(p @op.Inner) int {
	var l @op.L = op.MakeL(p)
	return op.GetL(l)
}

func dropA(p @op.Inner) {
	var a @op.A = op.MakeA(p)
	_ = a
}

func dropSL(p @op.Inner) {
	var s @op.SL = op.MakeSL(p)
	_ = s
}

func dropPP(p @op.Inner) {
	var pp @op.PP = op.MakePP(p)
	_ = pp
}

func dropW(p @op.Inner) {
	var w @op.W = op.MakeW(p)
	_ = w
}

func main() {
	var n @op.N = op.MakeN(42)
	testing.Println(op.GetN(n))

	var s @[]char = "hello"
	var b @op.B = op.MakeB(s)
	testing.Println(op.LenB(b))
	var h @op.Holder = op.MakeHolder(s)
	testing.Println(h.n)
	var l @op.Lener = b
	testing.Println(l.Len())
	var anyB @any = b
	_ = anyB
	testing.Println(op.CallFV(op.MakeFV(), 4))
	testing.Println(op.RunFV(3))

	var inr @op.Inner = make(op.Inner)
	inr.v = 7
	var before int = rt.Refcount(bit_cast(*uint8, inr))
	testing.Println(dropL(inr))
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropA(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropSL(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropPP(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
	dropW(inr)
	testing.Println(rt.Refcount(bit_cast(*uint8, inr)) - before)
}
