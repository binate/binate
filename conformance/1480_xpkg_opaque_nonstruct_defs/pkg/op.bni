package "pkg/op"

// Opaque types defined in op.bn as something other than a struct literal.
type Inner struct { v int }

type N

type B

type L

type A

type SL

type PP

type W

type FV

// A transparent struct whose field is an opaque type, declared before the
// opaque type's definition is seen.
type Holder struct { b @B; n int }

func MakeN(v int) @N

func GetN(n @N) int

func MakeB(s @[]char) @B

func LenB(b @B) int

func MakeL(p @Inner) @L

func GetL(l @L) int

func MakeA(p @Inner) @A

func MakeSL(p @Inner) @SL

func MakePP(p @Inner) @PP

func MakeW(p @Inner) @W

func MakeHolder(s @[]char) @Holder

func MakeFV() @FV

func CallFV(f @FV, x int) int

func RunFV(x int) int

interface Lener {
	Len() int
}

func (b @B) Len() int

impl @B : Lener
