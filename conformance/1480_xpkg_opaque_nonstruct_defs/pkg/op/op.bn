package "pkg/op"

type N int

type B @[]char

type L @Inner

type A [2]@Inner

type SL @[]@Inner

type PP @@Inner

type W Wrapped

type Wrapped struct { n int; p @Inner }

type FV @func(int) int

type FH struct { f FV }

func MakeN(v int) @N {
	var p @N = make(N)
	*p = cast(N, v)
	return p
}

func GetN(n @N) int { return cast(int, *n) }

func MakeB(s @[]char) @B {
	var p @B = make(B)
	*p = s
	return p
}

func LenB(b @B) int { return len(*b) }

func MakeL(p @Inner) @L {
	var l @L = make(L)
	*l = p
	return l
}

func GetL(l @L) int { return (*l).v }

func MakeA(p @Inner) @A {
	var a @A = make(A)
	(*a)[0] = p
	(*a)[1] = p
	return a
}

func MakeSL(p @Inner) @SL {
	var s @SL = make(SL)
	var es @[]@Inner = make_slice(@Inner, 3)
	for i := 0; i < 3; i++ { es[i] = p }
	*s = es
	return s
}

func MakePP(p @Inner) @PP {
	var pp @PP = make(PP)
	var q @@Inner = make(@Inner)
	*q = p
	*pp = q
	return pp
}

func MakeW(p @Inner) @W {
	var w @W = make(W)
	w.n = 1
	w.p = p
	return w
}

func MakeHolder(s @[]char) @Holder {
	var h @Holder = make(Holder)
	h.b = MakeB(s)
	h.n = 2
	return h
}

func (b @B) Len() int { return len(*b) }

func inc(x int) int { return x + 1 }

func MakeFV() @FV {
	var c @FV = make(FV)
	*c = inc
	return c
}

func CallFV(f @FV, x int) int { return (*f)(x) }

func RunFV(x int) int {
	var fs @[]FV = make_slice(FV, 1)
	fs[0] = inc
	var h FH
	h.f = inc
	return fs[0](x) + h.f(x)
}
