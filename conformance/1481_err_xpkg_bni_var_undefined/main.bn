package "main"
import "pkg/builtins/testing"

// A `.bni` `var` is only a declaration, with or without an initializer: the
// package's `.bn` files must define it (decl.var.extern, §16.5).  Each one they
// leave undefined is reported at its `.bni` declaration; a defined one is not.

import "pkg/home"

func main() {
	testing.Println(home.G, home.A, home.B, home.C, home.Get())
}
