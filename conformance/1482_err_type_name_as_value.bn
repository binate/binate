package "main"
import "pkg/builtins/testing"

// A type or an interface name has no value: reading one as an expression — an
// argument, an initializer, an operand — is an error, qualified or not.

interface I {
	M()
}

type Point struct {
	x int
}

type Celsius int

type Alias = Point

type Fn *func(int) int

func pick[T any](x T) T {
	var t = T
	_ = t
	return x
}

func show(v *any) {
	_ = v
}

func main() {
	testing.Println(I)
	var p = Point
	c := Celsius
	show(Alias)
	var r = testing.TestResult
	_ = Fn(3)
	_ = p
	_ = c
	_ = r
}
