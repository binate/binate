package "main"
import "pkg/builtins/testing"

// A multi-value assignment, and a `return f()` of a multi-value call, build
// each interface-typed target's interface value from its component as a single
// assignment or return does: a `@T` into a `@Iface` (the interface value takes
// its own reference), a `@T` into `@any`, a `*T` or `@T` into a `*Iface` (a
// borrow, no reference), a pointer to a name-less type into `*any` (its element
// `readonly` kept in the dynamic type), an interface value into an ancestor
// interface (an upcast), and the recovered value of a comma-ok assertion.  Each
// target dispatches to its concrete type's method, and every reference the
// statement takes is released once (the refcounts return to their baseline).

import "pkg/builtins/rt"

interface Greeter {
	Greet() int
}

interface Loud : Greeter {
	Shout() int
}

interface Hi = Greeter

type Hello struct {
	n int
}

func (h *Hello) Greet() int { return h.n }

func (h *Hello) Shout() int { return h.n * 10 }

impl *Hello : Loud

// Holder's field is an interface-typed target reached through a selector.
type Holder struct {
	g @Greeter
}

var keep @Hello

func mkHello(n int) (@Hello, int) {
	keep = make(Hello)
	keep.n = n
	return keep, n + 1
}

func mkPtr(h *Hello) (*Hello, bool) {
	return h, true
}

func mkLoud(h @Hello) (@Loud, int) {
	return h, 3
}

var msg *[]readonly char = "hi"

func mkMsg() (*(*[]readonly char), int) {
	return &msg, 2
}

func describe(p *any) int {
	switch v := p.(type) {
	case *[]char:
		return 1
	case *[]readonly char:
		return 2 + len(v)
	}
	return 0
}

func retHello(n int) (@Greeter, int) { return mkHello(n) }

func retLoud(h @Hello) (@Greeter, int) { return mkLoud(h) }

func retPtr(h *Hello) (*Greeter, bool) { return mkPtr(h) }

func retMsg() (*any, int) { return mkMsg() }

func viaField(h @Hello) {
	var hd Holder
	var n int
	hd.g, n = mkLoud(h)
	testing.Println(hd.g.Greet(), n) // 8 3
}

func viaAssert(h @Hello) {
	var l @Loud = h
	var anyL @any = cast(@any, l)
	var g @Greeter
	var ok bool
	g, ok = anyL.(@Loud)
	testing.Println(g.Greet(), ok) // 8 true
}

func viaReturn(h @Hello) {
	var g @Greeter
	var n int
	g, n = retLoud(h)
	testing.Println(g.Greet(), n) // 8 3
	var pg *Greeter
	var ok bool
	pg, ok = retPtr(h)
	testing.Println(pg.Greet(), ok) // 8 true
}

func main() {
	var n int
	var ok bool

	var g @Greeter
	g, n = mkHello(4)
	var p4 *uint8 = bit_cast(*uint8, keep)
	testing.Println(g.Greet(), n)    // 4 5
	testing.Println(rt.Refcount(p4)) // 2: keep, g

	var hi @Hi
	hi, n = mkHello(5)
	testing.Println(hi.Greet(), n) // 5 6

	var a @any
	a, n = mkHello(6)
	var p6 *uint8 = bit_cast(*uint8, keep)
	var back @Hello = a.(@Hello)
	testing.Println(back.n, n)       // 6 7
	testing.Println(rt.Refcount(p6)) // 3: keep, a, back

	var h @Hello = make(Hello)
	h.n = 8
	var ph *uint8 = bit_cast(*uint8, h)
	var pg *Greeter
	pg, ok = mkPtr(h)
	testing.Println(pg.Greet(), ok) // 8 true
	var pl *Loud
	pl, n = mkHello(9)
	var p9 *uint8 = bit_cast(*uint8, keep)
	testing.Println(pl.Shout(), n)   // 90 10
	testing.Println(rt.Refcount(p9)) // 1: keep

	var pa *any
	pa, n = mkMsg()
	testing.Println(describe(pa), n) // 4 2

	var rg @Greeter
	rg, n = retHello(11)
	var p11 *uint8 = bit_cast(*uint8, keep)
	testing.Println(rg.Greet(), n)    // 11 12
	testing.Println(rt.Refcount(p11)) // 2: keep, rg
	pa, n = retMsg()
	testing.Println(describe(pa), n) // 4 2

	viaField(h)
	testing.Println(rt.Refcount(ph)) // 1: h
	viaAssert(h)
	testing.Println(rt.Refcount(ph)) // 1: h
	viaReturn(h)
	testing.Println(rt.Refcount(ph)) // 1: h
}
