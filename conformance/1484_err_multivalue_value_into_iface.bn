package "main"
import "pkg/builtins/testing"

// A VALUE component of a multi-value call cannot construct an interface value
// (§11.4): a `@Iface` needs a `@T` (or an explicit `box`), and the implicit
// borrow into a raw `*Iface` applies only to an argument or a `var` / `:=`
// initializer, never to an assignment or a `return` — a call-result temporary
// would dangle at the statement's end.  Each is rejected for the component.

interface Greeter {
	Greet() int
}

type Hello struct {
	n int
}

func (h *Hello) Greet() int { return h.n }

impl *Hello : Greeter

func two() (int, int) { return 1, 2 }

func mkVal() (Hello, int) {
	var h Hello
	return h, 1
}

func retVal() (*Greeter, int) { return mkVal() }

func retAny() (*any, int) { return two() }

func main() {
	var p *any
	var n int
	p, n = two()
	var g *Greeter
	g, n = mkVal()
	var mg @Greeter
	mg, n = mkVal()
	testing.Println(n)
}
