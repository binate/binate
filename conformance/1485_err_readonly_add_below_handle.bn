package "main"
import "pkg/builtins/testing"

// Adding `readonly` below the outermost shared handle, without every level in
// between also readonly, leaves the source handle reading as writable what the
// new handle may store as readonly (§8.3 conv.readonly): `b[0] = &lit[0]`
// through `b @[]*readonly char` puts a `*readonly char` into a slot `a
// @[]*char` reads as a writable `*char`.  Rejected for an assignment, a borrow,
// an argument, a return, a pointer to an array or anonymous struct, and a
// by-value array of slices — readonly ELEMENTS or FIELDS in between do not
// count, since the array or struct can still be overwritten whole.  `cast`
// names `unsafe_cast` for it, also through a named type, and for a
// struct-to-struct `cast` whose field drops readonly; a cast that changes a type
// as well gets that change's message instead.

type A struct {
	p *readonly char
}

type B struct {
	p *char
}

type C struct {
	pp **char
}

type D struct {
	pp **readonly char
}

type RS @[]*readonly char

type RW @[]*char

func take(b @[]*readonly char) int { return len(b) }

func give(a @[]*char) @[]*readonly char { return a }

func main() {
	var a @[]*char = make_slice(*char, 1)
	var b1 @[]*readonly char = a
	var b2 *[]*readonly char = a
	var pp **char
	var q **readonly char = pp
	var arr [2]*char
	var pa *([2]*char) = &arr
	var r *([2]*readonly char) = pa
	var sa *struct{ p *char }
	var s *struct{ p *readonly char } = sa
	var sl [2]@[]*char
	var t [2]@[]*readonly char = sl
	var n int = take(a)
	var c1 = cast(@[]*readonly char, a)
	var c2 = cast(*[]*readonly char, a)
	var x A
	var y B = cast(B, x)
	var c C
	var d D = cast(D, c)
	var re *([2]readonly *readonly char) = pa
	var ss @[]struct{ p *char }
	var sr @[]struct{ p readonly *readonly char } = ss
	var n1 = cast(RS, a)
	var n2 = cast(RW, b1)
	var pi **int8
	var n3 = cast(**readonly uint8, pi)
	testing.Println(len(b1), len(b2), q == nil, r == nil, s == nil, len(t[0]), n, len(c1), len(c2), y.p == nil,
			d.pp == nil, re == nil, len(sr), len(n1), len(n2), n3 == nil)
}
