package "main"
import "pkg/builtins/testing"

// Adding `readonly` below the outermost shared handle is accepted when every
// level between the handle and the added readonly is readonly too — the new
// handle cannot write the slots, so the source's writable view stays sound —
// as is readonly added one level in, or below a by-value copy (§8.3
// conv.readonly).  The readonly handle observes writes made through the
// source.  `unsafe_cast` still performs the conversions `cast` refuses (§8.7).

type A struct {
	p *readonly char
}

type B struct {
	p *char
}

func main() {
	var x char = 'a'
	var a @[]*char = make_slice(*char, 1)
	a[0] = &x
	var b @[]readonly *readonly char = a
	testing.Println(*b[0] == 'a') // true
	*a[0] = 'b'
	testing.Println(*b[0] == 'b') // true: b observes the write through a
	var rb *[]readonly *readonly char = a
	testing.Println(*rb[0] == 'b') // true

	var m @[]char = make_slice(char, 2)
	var mr @[]readonly char = m
	testing.Println(len(mr)) // 2

	var px *char = &x
	var ppx **char = &px
	var q *readonly *readonly char = ppx
	testing.Println(**q == 'b') // true

	var arr [2]*char
	arr[0] = &x
	var cp [2]*readonly char = arr
	testing.Println(*cp[0] == 'b') // true
	var pa *([2]*char) = &arr
	var ra *(readonly [2]*readonly char) = pa
	testing.Println(*(*ra)[0] == 'b') // true

	var ss @[]struct{ p *char } = make_slice(struct{ p *char }, 1)
	ss[0].p = &x
	var sr @[]readonly struct{ p *readonly char } = ss
	testing.Println(*sr[0].p == 'b') // true

	var c = cast(@[]readonly *readonly char, a)
	testing.Println(len(c)) // 1
	var u @[]*readonly char = unsafe_cast(@[]*readonly char, a)
	testing.Println(*u[0] == 'b') // true
	var ua A
	ua.p = &x
	var ub B = unsafe_cast(B, ua)
	*ub.p = 'c'
	testing.Println(x == 'c') // true
}
