package "main"
import "pkg/builtins/testing"

// Upcasting an interface value to an ancestor interface keeps an unset source
// unset (§11.6 iface.extend.upcast): the result is not `present` — managed and
// raw, by assignment, as an argument, and as the target of a comma-ok
// assertion that misses — so a call through it reaches the nil-dispatch panic
// rather than a near-null vtable.  A set source still upcasts and dispatches
// to the ancestor's methods.

interface Greeter {
	Greet() int
}

interface Loud : Greeter {
	Shout() int
}

type Hello struct {
	n int
}

func (h *Hello) Greet() int { return h.n }

func (h *Hello) Shout() int { return h.n * 10 }

impl *Hello : Loud

func isSet(g *Greeter) bool { return present(g) }

func main() {
	var l @Loud
	var g @Greeter = l
	testing.Println(present(l), present(g)) // false false
	var pl *Loud
	var pg *Greeter = pl
	testing.Println(present(pl), present(pg)) // false false
	testing.Println(isSet(pl))                // false
	var a @any
	var ok bool
	g, ok = a.(@Loud)
	testing.Println(present(g), ok) // false false
	var anyL @any = cast(@any, l)
	testing.Println(present(anyL)) // false

	var h @Hello = make(Hello)
	h.n = 4
	l = h
	g = l
	testing.Println(present(g), g.Greet()) // true 4
	pl = h
	testing.Println(isSet(pl)) // true
	a = cast(@any, l)
	g, ok = a.(@Loud)
	testing.Println(present(g), ok, g.Greet()) // true true 4
}
