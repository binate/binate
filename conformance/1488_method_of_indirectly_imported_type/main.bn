package "main"

import "pkg/a"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A method of a type from a package this one does not import — reached only
// through another package's results: a named function value, a struct behind a
// managed pointer, a named int, a struct holding a managed slice — binds its
// receiver and arguments as it declares them (a variadic packs, a value receiver
// is copied), whether it is called, deferred or taken as a method value, and
// whichever of those comes first.

func direct() {
	var c = a.GetC(4)
	c.Put(1, 2, 3) // 6
	var q int
	var m int
	q, m = c.Split()
	testing.Println(q, m) // 2 0
	var r = a.GetR(3)
	r.Print() // 3
}

func deferred() {
	var h = a.Get(2)
	defer h.Apply(1)
	var s = a.GetS(3)
	defer s.Show(10) // 13
	var c = a.GetC(4)
	defer c.Twice()
	defer c.Put(5, 6) // 11
	var r = a.GetR(2)
	defer r.Print() // 2
	testing.Println(0)
}

func values() {
	var h = a.Get(2)
	var mv *func(int) int = h.Apply
	testing.Println(mv(1)) // 5
	var s = a.GetS(3)
	var ms *func(int) = s.Show
	ms(20) // 23
	var c = a.GetC(4)
	var mc *func() int = c.Twice
	testing.Println(mc()) // 8
	var r = a.GetR(5)
	var mr *func() = r.Print
	mr() // 5
}

func run() {
	direct()
	deferred()
	values()
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
