package "pkg/a"

import "pkg/b"

func Get(n int) b.Hook {
	var h b.Hook = func(x int) int { return x + n }
	return h
}

func GetS(n int) @b.St {
	var s @b.St = make(b.St)
	s.n = n
	return s
}

func GetC(n int) b.Cnt { return cast(b.Cnt, n) }

func GetR(n int) b.Rec {
	var r b.Rec
	r.name = make_slice(char, n)
	return r
}
