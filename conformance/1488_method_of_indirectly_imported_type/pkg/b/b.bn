package "pkg/b"

import "pkg/builtins/testing"

func (h Hook) Apply(x int) int { return h(h(x)) }

func (s *St) Show(k int) { testing.Println(s.n + k) }

func (c Cnt) Twice() int { return cast(int, c) * 2 }

func (c Cnt) Put(xs ...int) {
	var n int = 0
	for i := 0; i < len(xs); i++ {
		n = n + xs[i]
	}
	testing.Println(n)
}

func (c Cnt) Split() (int, int) { return cast(int, c) / 2, cast(int, c) % 2 }

func (r Rec) Print() { testing.Println(len(r.name)) }
