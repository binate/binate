package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/op"

// An opaque export whose definition names itself (`type Tree @[]Tree`, declared
// only as `type Tree` in the package's interface) is held by an importer through
// a managed pointer, `@op.Tree` — the form an opaque type is held in — and
// released when dropped.

func run() {
	var t @op.Tree = op.Mk(2)
	testing.Println(op.Size(t), op.Size(op.Mk(1))) // 15 7
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	for i := 0; i < 3; i++ {
		run()
	}
	testing.Println(rt.LiveBlocks() - base) // 0
}
