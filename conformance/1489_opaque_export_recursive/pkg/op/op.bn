package "pkg/op"

type Tree @[]Tree

func build(d int) Tree {
	var t Tree = make_slice(Tree, 2)
	if d > 0 {
		t[0] = build(d - 1)
		t[1] = build(d - 1)
	}
	return t
}

func Mk(d int) @Tree { return box(build(d)) }

func size(t Tree) int {
	var n int = 1
	for i := 0; i < len(t); i++ {
		n = n + size(t[i])
	}
	return n
}

func Size(t @Tree) int { return size(*t) }
