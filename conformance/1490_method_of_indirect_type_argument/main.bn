package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/d"
import "pkg/g"

// A generic function from a package that does not import the type argument's
// package (c), instantiated from one that does not either (main names it through
// d's alias), calls and defers the argument's methods on its type parameter:
// a variadic method of a struct holding a managed slice, by value.

func run() {
	g.Call[d.R](d.GetR(2)) // 109
	g.Both[d.R](d.GetR(3)) // 10 13
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
