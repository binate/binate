package "pkg/c"

import "pkg/builtins/testing"

func (r Rec) Put(xs ...int) { testing.Println(sum(r, xs)) }

func (r Rec) Add(xs ...int) { testing.Println(100 + sum(r, xs)) }

func sum(r Rec, xs *[]int) int {
	var n int = len(r.name) + r.n
	for i := 0; i < len(xs); i++ {
		n = n + xs[i]
	}
	return n
}
