package "main"

import "pkg/a"
import "pkg/builtins/testing"

// A pointer to a type from a package this one does not import is boxed into an
// interface it implements there — assigned to a variable of the interface's
// alias, and passed to a method's interface parameter.

func main() {
	var z *a.Sz = a.GetP(5)
	testing.Println(z.Size()) // 5
	var c = a.GetC(4)
	testing.Println(c.Mul(a.GetP(5))) // 20
}
