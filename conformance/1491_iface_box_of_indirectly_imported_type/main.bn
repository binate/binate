package "main"

import "pkg/a"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A pointer to a type from a package this one does not import is boxed into an
// interface it implements there — the impl's own interface and an ancestor of it,
// assigned to variables of the interfaces' aliases (raw and managed), and passed
// to a method's interface parameter.

func run() {
	var z *a.Sz = a.GetP(5)
	testing.Println(z.Size()) // 5
	var c = a.GetC(4)
	testing.Println(c.Mul(a.GetP(5))) // 20
	var bo *a.Bo = a.GetP(6)
	testing.Println(bo.Size(), bo.Name()) // 6 60
	var mz @a.Sz = a.GetM(7)
	testing.Println(mz.Size()) // 7
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
