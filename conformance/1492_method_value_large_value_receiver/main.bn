package "main"

import "pkg/builtins/testing"

// A method value whose value receiver is an aggregate wider than 16 bytes (20 on a
// 32-bit target) captures a copy of it, for every result shape — none, a scalar, a
// big and a small struct, a small and a big multi-return — and with a user
// argument; a method that changes its receiver changes only its own copy.  So does a
// function literal: each call starts from the captured values, also for an 8-aligned
// aggregate captured after an int and a byte array captured after a byte.

type Big struct {
	a int
	b int
	c int
	d int
	e int
}

type Small struct {
	v int8
}

func (g Big) Sum() int { return g.a + g.b + g.c + g.d + g.e }

func (g Big) Show() { testing.Println(g.a, g.e) }

func (g Big) Bump() int {
	g.a = g.a + 100
	return g.a
}

func (g Big) Copy() Big {
	g.a = g.a + 10
	return g
}

func (g Big) Small() Small {
	var s Small
	s.v = cast(int8, g.b)
	return s
}

func (g Big) Two() (int, int) { return g.a + g.b, g.c }

func (g Big) Five() (int, int, int, int, int) { return g.a, g.b, g.c, g.d, g.e }

func (g Big) AddK(k int) int { return g.e + k }

type Wide struct {
	a int64
	b int64
	c int64
}

func (w Wide) Sum() int64 { return w.a + w.b + w.c }

func (w Wide) Twice() Wide {
	w.a = w.a * 2
	w.c = w.c * 2
	return w
}

type Bytes [20]uint8

func (b Bytes) Ends() int { return cast(int, b[0]) + cast(int, b[19]) }

func literals() {
	var g Big
	g.a = 1
	g.e = 5
	var cl *func() int = func() int {
		g.a = g.a + 1
		return g.a + g.e
	}
	testing.Println(cl()) // 7
	testing.Println(cl()) // 7
	var k int = 3
	var w Wide
	w.a = 10
	w.b = 20
	w.c = 30
	var cw *func() int64 = func() int64 { return cast(int64, k) + w.a + w.c }
	testing.Println(cw()) // 43
	var ws *func() int64 = w.Sum
	testing.Println(ws()) // 60
	var wt *func() Wide = w.Twice
	var t Wide = wt()
	testing.Println(t.a, t.c) // 20 60
	var tag uint8 = 1
	var bs Bytes
	bs[0] = 7
	bs[19] = 9
	var cb *func() int = func() int { return cast(int, tag) + cast(int, bs[0]) + cast(int, bs[19]) }
	testing.Println(cb()) // 17
	var be *func() int = bs.Ends
	testing.Println(be()) // 16
}

func main() {
	var g Big
	g.a = 1
	g.b = 2
	g.c = 3
	g.d = 4
	g.e = 5
	var sum *func() int = g.Sum
	var show *func() = g.Show
	var bump *func() int = g.Bump
	var cp *func() Big = g.Copy
	var sm *func() Small = g.Small
	var two *func() (int, int) = g.Two
	var five *func() (int, int, int, int, int) = g.Five
	var addk *func(int) int = g.AddK
	g.a = 100
	testing.Println(sum()) // 15
	show() // 1 5
	testing.Println(bump()) // 101
	testing.Println(bump()) // 101
	var c Big = cp()
	testing.Println(c.a, c.e) // 11 5
	var s Small = sm()
	testing.Println(cast(int, s.v)) // 2
	var x int
	var y int
	x, y = two()
	testing.Println(x, y) // 3 3
	var p1 int
	var p2 int
	var p3 int
	var p4 int
	var p5 int
	p1, p2, p3, p4, p5 = five()
	testing.Println(p1, p2, p3, p4, p5) // 1 2 3 4 5
	testing.Println(addk(10)) // 15
	testing.Println(g.a) // 100
	literals()
}
