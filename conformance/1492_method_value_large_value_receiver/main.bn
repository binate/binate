package "main"

import "pkg/builtins/testing"

// A method value whose value receiver is an aggregate wider than 16 bytes
// (20 on a 32-bit target) captures a copy of it.

type Big struct {
	a int
	b int
	c int
	d int
	e int
}

func (g Big) Sum() int { return g.a + g.b + g.c + g.d + g.e }

func main() {
	var g Big
	g.a = 1
	g.b = 2
	g.c = 3
	g.d = 4
	g.e = 5
	var f *func() int = g.Sum
	g.a = 100
	testing.Println(f()) // 15
}
