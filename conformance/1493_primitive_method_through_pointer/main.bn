package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// A method of a universe primitive called through a pointer to it — `p.String()`
// and `(*p).String()` with `p *int`, the method value `p.String`, and `(*p).String()`
// in a generic body instantiated with int — receives the pointee's value.

func pstr[T lang.Stringer](p *T) @[]char { return (*p).String() }

func main() {
	var x int = 5
	var p *int = &x
	testing.Println(p.String()) // 5
	testing.Println((*p).String()) // 5
	var f *func() @[]char = p.String
	x = 6
	testing.Println(f()) // 5
	var b bool = false
	var pb *bool = &b
	testing.Println(pb.String()) // false
	testing.Println(pstr[int](&x)) // 6
}
