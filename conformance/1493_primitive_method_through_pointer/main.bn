package "main"

import "pkg/builtins/testing"

// A method of a universe primitive called through a pointer to it — `p.String()`
// and `(*p).String()` with `p *int`, and the method value `p.String` — receives
// the pointee's value.

func main() {
	var x int = 5
	var p *int = &x
	testing.Println(p.String()) // 5
	testing.Println((*p).String()) // 5
	var f *func() @[]char = p.String
	x = 6
	testing.Println(f()) // 5
	var b bool = false
	var pb *bool = &b
	testing.Println(pb.String()) // false
}
