package "main"

import "pkg/builtins/testing"

// Computations whose results nothing reads — at -O1 and above they are
// removed: a loop accumulator kept only for a struct field nothing reads (the
// field's slot is dropped first, leaving the accumulator feeding only itself),
// an unused product inside a loop, and a chain feeding only a dead extract.
// The values the program does read must come out unchanged.

type Big struct {
	data [100]int
	n    int
	m    int
}

func loopPhi(p *Big, k int) int {
	var x Big = *p
	var acc int = 0
	for i := 0; i < k; i++ {
		acc = acc + i * 3
		x.m = acc
	}
	return x.n
}

func unusedProduct(k int) int {
	var live int = 0
	for i := 0; i < k; i++ {
		var dead int = i * i * 7 + 3
		_ = dead
		live = live + i
	}
	return live
}

func twoFields(p *Big) int {
	var x Big = *p
	var unused int = x.m * 2 + x.data[4]
	_ = unused
	return x.n + 1
}

func main() {
	var b Big
	b.n = 4
	b.m = 9
	b.data[4] = 2
	testing.Println(loopPhi(&b, 5))
	testing.Println(unusedProduct(10))
	testing.Println(twoFields(&b))
}
