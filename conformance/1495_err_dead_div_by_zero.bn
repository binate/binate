package "main"
import "pkg/builtins/testing"

// A division whose result nothing reads still divides by zero: at -O1 and
// above the unused quotient is removed as dead code, but its zero-divisor
// check is not, so the program must still panic.

func zero() int { return 0 }

func main() {
	var b int = zero()
	var q int = 10 / b
	_ = q
	testing.Println("not reached")
}
