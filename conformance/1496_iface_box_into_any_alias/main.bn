package "main"

import "pkg/a"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A pointer is boxed into another package's alias of universe `any`
// (`interface A = any` in a) as into `any` itself: a named struct, a raw slice
// (a name-less pointee), and a managed pointer into a managed `@a.A`.  Each box
// carries its type, so it is present and the value comes back out.

type St struct {
	n int
}

func run() {
	var s St
	s.n = 9
	var x *a.A = &s
	testing.Println(a.Present(x), x.(*St).n) // true 9
	var arr [3]int
	arr[1] = 7
	var sl *[]int = arr[:]
	var y *a.A = &sl
	testing.Println(a.Present(y)) // true
	var m @St = make(St)
	m.n = 4
	var mx @a.A = m
	testing.Println(a.Owned(mx), mx.(@St).n) // true 4
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
