package "main"
import "pkg/builtins/testing"

// A slice of an array reached through readonly views its elements as readonly
// (§13.9 expr.index): binding it to a writable `*[]int` is rejected — for a
// readonly local, through a pointer to a readonly array, and for a readonly
// struct's array field — and so is writing an element through the
// `*[]readonly int` it does bind to.

type S struct {
	a [2]int
}

func main() {
	var r readonly [3]int
	var w1 *[]int = r[:]
	var x [2]int
	var p *(readonly [2]int) = &x
	var w2 *[]int = (*p)[:]
	var s S
	var rs readonly S = s
	var w3 *[]int = rs.a[1:]
	var ro *[]readonly int = r[:]
	ro[0] = 1
	testing.Println(len(w1), len(w2), len(w3), len(ro))
}
