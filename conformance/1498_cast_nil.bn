package "main"
import "pkg/builtins/testing"

// `cast(T, nil)` / `unsafe_cast(T, nil)` for a nillable T is T's nil (§8.1 case
// 6 within cast's safe set, §8.5): a raw pointer, a named pointer, a managed
// pointer, a raw and a managed function value.  Each compares equal to nil (or
// is not present), and a managed nil releases nothing at scope end.  A named
// pointer's nil keeps its named type, so a method call on it — directly or
// through a `:=` binding — runs the named type's method.

type P *int

type S struct {
	v int
}

type PS *S

type PM @S

type FN *func() int

func (p PS) Get() int {
	if p == nil { return -1 }
	return p.v
}

func main() {
	var p *uint8 = cast(*uint8, nil)
	var q P = cast(P, nil)
	var m @int = cast(@int, nil)
	var u *int = unsafe_cast(*int, nil)
	testing.Println(p == nil, q == nil, m == nil, u == nil) // true true true true
	var f *func() = cast(*func(), nil)
	var g @func(int) int = cast(@func(int) int, nil)
	testing.Println(present(f), present(g)) // false false
	testing.Println(cast(PS, nil).Get()) // -1
	ps := cast(PS, nil)
	testing.Println(ps.Get()) // -1
	var pm PM = cast(PM, nil)
	var fn FN = cast(FN, nil)
	testing.Println(pm == nil, present(fn)) // true false
}
