package "main"
import "pkg/builtins/testing"

// A method expression through an alias of a named type (`type A = Point;
// A.Get`) is the target type's method expression (§10.11 func.method-expr; an
// alias names its target, §7.3): called directly and taken as a function value,
// through a chain of aliases, for a pointer-receiver method, for a named scalar
// type, for a generic instance (whose methods no other use emits), and for a
// universe primitive (as `int.Compare` itself, or `char.Compare` — `uint8`'s —
// names the lang carve-out's).

type Point struct {
	x int
}

func (p Point) Get() int { return p.x }

func (p *Point) Set(v int) { p.x = v }

type Alias = Point

type Alias2 = Alias

type Celsius int

func (c Celsius) Twice() int { return cast(int, c) * 2 }

type Temp = Celsius

type Box[T any] struct {
	v T
}

func (b Box[T]) Get() T { return b.v }

type IB = Box[int]

type I = int

func main() {
	var p Point
	p.x = 3
	testing.Println(Alias.Get(p)) // 3
	var f *func(Point) int = Alias.Get
	testing.Println(f(p)) // 3
	Alias.Set(&p, 5)
	testing.Println(Alias2.Get(p)) // 5
	var g *func(*Point, int) = Alias2.Set
	g(&p, 6)
	testing.Println(p.x)           // 6
	testing.Println(Temp.Twice(4)) // 8
	var bx IB = IB{v: 7}
	testing.Println(IB.Get(bx)) // 7
	testing.Println(int.Compare(1, 2) < 0, I.Compare(2, 1) > 0) // true true
	testing.Println(char.Compare('a', 'b') < 0) // true
}
