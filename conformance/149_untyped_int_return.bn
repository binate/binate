package "main"

import "pkg/builtins/testing"

// Untyped integer literals in return statements should adopt the
// function's return type.

func zero32() uint32 {
	return 0
}

func fortytwo8() int8 {
	return 42
}

func hundred16() uint16 {
	return 100
}

func main() {
	testing.Println(zero32())
	testing.Println(fortytwo8())
	testing.Println(hundred16())
}
