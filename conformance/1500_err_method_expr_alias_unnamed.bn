package "main"
import "pkg/builtins/testing"

// A method expression's T is a named type (§10.11 func.method-expr): an alias
// of an UNNAMED type (`type PA = *Point`) names no method set, so `PA.Set` is
// rejected even though `*Point` has the method.

type Point struct {
	x int
}

func (p *Point) Set(v int) { p.x = v }

type PA = *Point

func main() {
	var p Point
	PA.Set(&p, 6)
	testing.Println(p.x)
}
