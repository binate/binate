package "main"
import "pkg/builtins/testing"

// A method expression through a local alias of an IMPORTED named type (`type
// A = home.S; A.Sum`) is that type's method expression (§10.11
// func.method-expr; an alias names its target, §7.3).

import "pkg/home"

type A = home.S

func main() {
	var s home.S = home.Make(2, 3)
	testing.Println(A.Sum(s)) // 5
	var f *func(home.S) int = A.Sum
	testing.Println(f(s)) // 5
}
