package "main"
import "pkg/builtins/testing"

// A method expression through an alias whose target is a type of a package
// this one does not import directly (`type L = a.A`, a's `A = b.T`) names b's
// method, declared for this module from the checker's signature (§10.11
// func.method-expr; §7.3): called directly and taken as a function value.

import "pkg/a"

type L = a.A

func main() {
	testing.Println(L.Get(a.Make())) // 9
	var f *func(a.A) int = L.Get
	testing.Println(f(a.Make())) // 9
}
