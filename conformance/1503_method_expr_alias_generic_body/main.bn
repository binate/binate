package "main"
import "pkg/builtins/testing"

// Inside a generic body emitted for this module, a method expression through an
// alias the generic's package declares (`g.A = g.Point`) names that package's
// method — not the method of a same-named type of this module (`A`, whose Get
// returns 999), nor a package this module imports under the alias's name
// (`home`).

import "pkg/g"
import "pkg/home"

type A struct {
	y int
}

func (a A) Get() int { return 999 }

func main() {
	testing.Println(g.Call[int](g.Make(5))) // 10
	var a A
	testing.Println(a.Get(), home.Ping()) // 999 1
}
