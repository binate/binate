package "pkg/g"

// Point holds a coordinate.
type Point struct {
	x int
}

// Get returns the coordinate.
func (p Point) Get() int

// A is Point under another name.
type A = Point

// home is Point under a name a consumer may also import a package as.
type home = Point

// Make returns a Point at x.
func Make(x int) Point

// Call reads p through A's and home's method expressions.
func Call[T any](p Point) int {
	return A.Get(p) + home.Get(p)
}
