package "main"
import "pkg/builtins/testing"

// An interface alias names its target interface (§11.7 iface.alias), so a value
// of a descendant interface upcasts to the alias as to the target: into a struct
// field typed with the alias (declared before the alias itself), managed as well
// as raw, through an alias declared after the interface that names it as a
// parent, and to an alias of `any`.

type Holder struct {
	x *X
}

interface Y {
	y() int
}

interface A : X {
	a() int
}

interface X = Y

interface Any2 = any

type T struct {
	v int
}

func (t *T) a() int { return 1 }

func (t *T) y() int { return t.v }

impl *T : A

func main() {
	var t T = T{v: 5}
	var a *A = &t
	var h Holder
	h.x = a
	testing.Println(h.x.y()) // 5
	var m @T = make(T)
	m.v = 6
	var ma @A = m
	var mx @X = ma
	testing.Println(mx.y()) // 6
	var any2 *Any2 = a
	testing.Println(present(any2)) // true
}
