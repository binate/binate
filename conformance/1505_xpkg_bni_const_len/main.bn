package "main"
import "pkg/builtins/testing"

// A `.bni` constant `len(V)` of a `.bni` array variable is a constant for an
// importer (§6 constant expressions; §9.2 decl.var.extern): usable as an array
// length, whether V is declared before the constant or after it, when V's own
// length is a constant declared after V or `len` of a variable declared after
// V, when V is in a var group, and when V's length is a const-group member.

import "pkg/a"

func main() {
	var x [a.LArr]int
	var y [a.LLater]int
	var z [a.LEarly]int
	testing.Println(len(x), len(y), len(z)) // 4 3 2
	testing.Println(a.LArr, a.LLater, a.LEarly) // 4 3 2
	var g [a.LG]int
	var v [a.LVA]int
	var k [a.LVK]int
	testing.Println(len(g), len(v), len(k)) // 2 5 2
}
