package "pkg/a"

// N sizes Later.
const N = 3

// Arr is declared before LArr.
var Arr [4]int

// LArr is the length of Arr.
const LArr = len(Arr)

// LLater is the length of Later, declared after it.
const LLater = len(Later)

// Later is sized by N.
var Later [N]int

// Early is sized by M, declared after it.
var Early [M]int

// M sizes Early.
const M = 2

// LEarly is the length of Early.
const LEarly = len(Early)

var (
	// G1 is a grouped variable.
	G1 [2]int
)

// LG is the length of G1.
const LG = len(G1)

// VA is sized by the length of VB, declared after it.
var VA [len(VB)]int

// VB holds five.
var VB [5]int

// LVA is the length of VA.
const LVA = len(VA)

const (
	// K0 is 0.
	K0 = iota
	// K1 is 1.
	K1
	// K2 is 2.
	K2
)

// VK is sized by a const-group member.
var VK [K2]int

// LVK is the length of VK.
const LVK = len(VK)
