package "main"
import "pkg/builtins/testing"

// An alias of a generic interface instantiation (`interface X = G[int]`) names
// that instance (§11.7 iface.alias) wherever a type spells it — also in a type
// alias and a global declared before the interface alias itself — so a
// descendant's value upcasts to it and dispatches.

var g *X

type P = *X

interface G[T any] {
	get() T
}

interface X = G[int]

interface A : X {
	a() int
}

type T struct {
	v int
}

func (t *T) get() int { return t.v }

func (t *T) a() int { return 1 }

impl *T : A

func main() {
	var t T = T{v: 5}
	var a *A = &t
	var p P = a
	testing.Println(p.get()) // 5
	g = a
	testing.Println(g.get()) // 5
}
