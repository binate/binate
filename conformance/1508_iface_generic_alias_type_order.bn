package "main"
import "pkg/builtins/testing"

// A type alias naming an interface alias of a generic instantiation (`type P =
// *X; interface X = G[int]`) may precede a type alias G's methods name (`trip()
// TA`): instantiating G[int] for P sees TA as the struct it names, so a method
// returning it through the instance returns the whole struct.

type P = *X

interface X = G[int]

interface G[T any] {
	get() T
	trip() TA
}

type TA = Tr

type Tr struct {
	a int
	b int
	c int
}

type U struct {
	v int
}

func (u *U) get() int { return u.v }

func (u *U) trip() Tr { return Tr{a: u.v, b: u.v + 1, c: u.v + 2} }

impl *U : G[int]

func main() {
	var u U = U{v: 5}
	var p P = &u
	var r Tr = p.trip()
	testing.Println(r.a + r.b + r.c) // 18
	testing.Println(p.get())         // 5
}
