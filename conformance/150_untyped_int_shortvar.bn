package "main"

import "pkg/builtins/testing"

// Short var decl (:=) with untyped int literal should default to int.

func main() {
	x := 42
	testing.Println(x)

	// Arithmetic with short-var int should work normally
	y := x + 10
	testing.Println(y)

	// Boolean short-var
	b := true
	if b {
		testing.Println(1)
	}
}
