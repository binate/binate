package "main"
import "pkg/builtins/testing"

// `readonly` is shallow (§7.11): a read-only HANDLE — `readonly *T`, `readonly
// @T`, or a pointer field of a readonly struct — reaches a mutable T, so the
// fields and array elements of what it points to stay writable through it (and
// a slice of such an array field has writable elements); only the handle itself
// cannot be reassigned.

type Box struct {
	y int
	a [2]int
}

type Holder struct {
	p *Box
}

func viaRaw(p readonly *Box) {
	p.y = 1
	p.a[0] = 2
	var s *[]int = p.a[:]
	s[1] = 3
}

func main() {
	var b readonly @Box = make(Box)
	b.y = 4
	b.a[1] = 5
	testing.Println(b.y, b.a[1]) // 4 5

	var x Box
	viaRaw(&x)
	testing.Println(x.y, x.a[0], x.a[1]) // 1 2 3

	var h Holder
	h.p = &x
	var rh readonly Holder = h
	rh.p.y = 6
	testing.Println(x.y) // 6
}
