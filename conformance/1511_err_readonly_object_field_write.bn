package "main"
import "pkg/builtins/testing"

// A readonly OBJECT's fields and array elements are read-only through any path:
// a handle to a readonly pointee (`*readonly T`, `@(readonly T)`), a readonly
// struct value, and a readonly handle itself cannot be reassigned.

type Box struct {
	y int
	a [2]int
}

func f(p *readonly Box, q readonly *Box) {
	p.y = 1
	p.a[0] = 2
	var r @Box = make(Box)
	q = r
}

func main() {
	var v readonly Box
	v.y = 3
	var m @(readonly Box) = make(Box)
	m.y = 4
	testing.Println(v.y, m.y)
}
