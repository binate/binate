package "main"
import "pkg/builtins/testing"

// A deferred method-expression call (`defer T.M(recv, args)`, §10.11
// func.method-expr; §14 stmt.defer) calls the method at function exit with the
// receiver and arguments evaluated at the defer statement: a value receiver, an
// alias of the type, a pointer-receiver method, a named scalar, a generic
// instance, a managed receiver, a variadic method, a method with two results,
// and a managed-slice argument.  Deferred calls run last-in first-out.

type Point struct {
	x int
}

func (p Point) Show() { testing.Println(p.x) }

func (p *Point) Set(v int) { p.x = v }

type Alias = Point

type Celsius int

func (c Celsius) Show() { testing.Println(cast(int, c) * 10) }

type Box[T any] struct {
	v T
}

func (b Box[T]) Size() int { return 1 }

func (b Box[T]) Show() { testing.Println(b.Size() * 100) }

func printX(p *Point) { testing.Println(p.x) }

func (p Point) Sum(xs ...int) {
	var t int = p.x
	for i := 0; i < len(xs); i++ { t = t + xs[i] }
	testing.Println(t)
}

func (p Point) Two() (int, int) { return p.x, p.x + 1 }

func (p Point) Take(s @[]int) { testing.Println(len(s)) }

type Counter struct {
	n int
}

func (c @Counter) Add(k int) { c.n = c.n + k }

func showCounter(c @Counter) { testing.Println(c.n) }

func run2() {
	var p Point
	p.x = 2
	var c @Counter = make(Counter)
	defer showCounter(c)
	defer Counter.Add(c, 5)
	defer Point.Sum(p, 1, 2, 3)
	defer Point.Two(p)
	var s @[]int = make_slice(int, 4)
	defer Point.Take(p, s)
}

func run() {
	var p Point
	p.x = 1
	defer printX(&p)
	defer Point.Show(p)
	defer Alias.Show(p)
	defer Point.Set(&p, 9)
	var c Celsius = 4
	defer Celsius.Show(c)
	var b Box[int] = Box[int]{v: 3}
	defer Box[int].Show(b)
	testing.Println(0)
}

func main() {
	run()
	run2()
}
