package "main"
import "pkg/builtins/testing"

// A failed assertion to an imported interface names the target by its
// package-qualified name (§17 `<dyn> is not <T>`; §11.12 iface.assert).

import "pkg/b"

type Dog struct {
	n int
}

func main() {
	var d Dog
	var x *any = &d
	var f *b.Flyer = x.(*b.Flyer)
	testing.Println(present(f))
}
