package "main"
import "pkg/builtins/testing"

// A deferred method expression through a local alias of a type from a package
// this one does not import directly (`type L = a.A`, a's `A = b.Point`) calls
// b's method at function exit, the method declared for this module from the
// checker's signature (§10.11 func.method-expr; §14 stmt.defer).

import "pkg/a"

type L = a.A

func run() {
	defer L.Show(a.Make())
	testing.Println(0)
}

func main() {
	run()
}
