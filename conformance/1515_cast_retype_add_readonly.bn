package "main"
import "pkg/builtins/testing"

// A container `cast` that retypes its elements may also add element-level
// readonly (§8.5 conv.cast.aggregate-retype forbids only dropping it; §8.3):
// `@[]int8` → `@[]readonly uint8`, `*[]int8` → `*[]readonly uint8`, `[3]int8` →
// `[3]readonly uint8`.  The retyped view reads the same bytes.

func main() {
	var m @[]int8 = make_slice(int8, 3)
	m[0] = -1
	m[1] = 2
	m[2] = 3
	var mr @[]readonly uint8 = cast(@[]readonly uint8, m)
	testing.Println(cast(int, mr[0]), cast(int, mr[1]), cast(int, mr[2])) // 255 2 3

	var r *[]int8 = m
	var rr *[]readonly uint8 = cast(*[]readonly uint8, r)
	testing.Println(len(rr), cast(int, rr[0])) // 3 255

	var a [3]int8 = [3]int8{-2, 5, 6}
	var ar [3]readonly uint8 = cast([3]readonly uint8, a)
	testing.Println(cast(int, ar[0]), cast(int, ar[2])) // 254 6
}
