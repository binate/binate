package "main"
import "pkg/builtins/testing"

// A cast whose type involves a type parameter only indirectly — in a generic
// instantiation's type arguments (a struct instantiation's `@P[T]`, P using no T
// in its fields, or a generic interface's `@G[T]`), a function value's parameter
// (`*func(T) int`), an array's length (`[sizeof(T)]int8`) — is checked once the
// type parameter is instantiated, as any cast through a type parameter is, not
// rejected where the generic function is declared.  unsafe_cast's interface
// forms likewise.

type P[T any] struct { n int }

interface G[T any] { Get() int }

type V struct { n int }

func (v @V) Get() int { return v.n }

impl @V : G[int]

func g[T any](x @P[int]) @P[T] { return cast(@P[T], x) }

func g2[T any](x @P[@[]int]) @P[@[]T] { return cast(@P[@[]T], x) }

func h[T any](x @G[T]) @G[int] { return cast(@G[int], x) }

func hu[T any](x @G[T]) @G[int] { return unsafe_cast(@G[int], x) }

func w[T any](v @V) @G[T] { return unsafe_cast(@G[T], v) }

func fv[T any](f *func(int) int) *func(T) int { return cast(*func(T) int, f) }

func sz[T any](x [8]uint8) int8 {
	var y [sizeof(T)]int8 = cast([sizeof(T)]int8, x)
	return y[0]
}

func add1(n int) int { return n + 1 }

func main() {
	var p @P[int] = make(P[int])
	p.n = 5
	var q @P[int] = g[int](p)
	var ps @P[@[]int] = make(P[@[]int])
	ps.n = 6
	var qs @P[@[]int] = g2[int](ps)
	var v @V = make(V)
	v.n = 4
	var gi @G[int] = v
	testing.Println(q.n, qs.n, h[int](gi).Get())
	var raw [8]uint8
	raw[0] = 200
	testing.Println(hu[int](gi).Get(), w[int](v).Get(), fv[int](add1)(2), sz[int64](raw))
}
