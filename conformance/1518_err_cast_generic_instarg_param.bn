package "main"
import "pkg/builtins/testing"

// A cast through a generic instantiation's type argument that is invalid for
// the type it is instantiated with is rejected at that instance: @P[int] and
// @P[bool] point to two distinct types.  unsafe_cast's interface forms are
// likewise checked at each instance: @V implements G[int] but not G[bool], and
// G[int] and G[bool] are unrelated interfaces.

type P[T any] struct { n int }

interface G[T any] { Get() int }

type V struct { n int }

func (v @V) Get() int { return v.n }

impl @V : G[int]

func g[T any](x @P[int]) @P[T] { return cast(@P[T], x) }

func w[T any](v @V) @G[T] { return unsafe_cast(@G[T], v) }

func hr[T any](y @G[int]) @G[T] { return unsafe_cast(@G[T], y) }

func main() {
	var p @P[int] = make(P[int])
	var q @P[bool] = g[bool](p)
	var v @V = make(V)
	var gb @G[bool] = w[bool](v)
	var gi @G[int] = v
	var gc @G[bool] = hr[bool](gi)
	testing.Println(q.n, gb.Get(), gc.Get())
}
