package "main"
import "pkg/builtins/testing"

// A name a package's `.bni` declares twice is an error at the second
// declaration (decl.var.redeclare), also for a function the `.bn` defines and
// for an extern var — declarations the duplicate check of the package's merged
// file never sees — with the same or a different signature or type, across
// kinds, and between a var group's member and a var outside it.

import "pkg/q"

func main() {
	testing.Println(q.F(1), q.G(), q.V, q.W)
}
