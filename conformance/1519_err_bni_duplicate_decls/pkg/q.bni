package "pkg/q"

// F adds V to x.
func F(x int) int

// F is declared again with a different signature.
func F() int

// G returns 2.
func G() int

// G is declared again, identically.
func G() int

// V is the addend.
var V int

// V is declared again with another type.
var V bool

// W is a variable.
var W int

// W is declared again as a function.
func W() int

// X is a variable declared in a group.
var (
	X int
)

// X is declared again outside it.
var X bool
