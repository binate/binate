package "main"
import "pkg/builtins/testing"

// A `.bni` whose names repeat only where that is not a redeclaration compiles:
// a forward type defined in the `.bn`, a free function sharing its name with
// methods of two types, a var group, and two build-gated declarations of one
// function of which exactly one survives for any target.

import "pkg/r"

func main() {
	var t @r.T = r.NewT()
	var u @r.U = make(r.U)
	u.N = 3
	r.A = 4
	testing.Println(r.Name(), t.Name(), u.Name(), r.A + r.B, r.Plat() > 0)
}
