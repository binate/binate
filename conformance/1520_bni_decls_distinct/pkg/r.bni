package "pkg/r"

// T is defined in the `.bn`.
type T

// U has a method Name, as T does.
type U struct {
	N int
}

// Name is a free function sharing its name with methods of T and U.
func Name() int

// Name returns T's value.
func (t @T) Name() int

// Name returns U's N.
func (u @U) Name() int

// A and B are variables declared in a group.
var (
	A int
	B int
)

// Plat returns a positive number on an aarch64 target.
#[build(is(arch, "aarch64"))]
func Plat() int

// Plat returns a positive number on any other target.
#[build(!is(arch, "aarch64"))]
func Plat() int

// NewT returns a T holding 2.
func NewT() @T
