package "main"
import "pkg/builtins/testing"

// A type declaration whose definition holds an opaque type by value — an array
// element (also nested, or in an array of structs), a slice element — or points
// to a type that does, is rejected where it is declared, named, blank or alias,
// as a struct field of one is: no value of it could ever be formed.  A distinct
// type over the opaque type, and one holding it behind a pointer, stay legal.

type Op

type A [2]Op

type _ [2]Op

type _ = [3]Op

type C [2][3]Op

type D [3]struct { o Op }

type S @[]Op

type P *([2]Op)

type O2 Op

type H [2]*Op

func main() {
	testing.Println(1)
}
