package "main"
import "pkg/builtins/testing"

// Declarations over another package's opaque export that hold it only behind a
// handle, or are themselves opaque (a distinct type over it, an alias of it),
// are legal.

import "pkg/p"

type W p.H

type _ = p.H

type Hs @[]@p.H

func main() {
	var hs Hs = make_slice(@p.H, 1)
	hs[0] = p.New()
	testing.Println(p.Get(hs[0]))
}
