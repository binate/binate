package "main"

import "pkg/builtins/testing"

// A by-value aggregate parameter too large for registers arrives as a pointer
// to a copy.  The parameter's value is a snapshot taken on entry: writes the
// callee makes through another pointer to the caller's original, and writes to
// the parameter itself, must not show through the other one.  Covers the
// pointer arriving in a register and on the stack (after eight word arguments,
// past every target's argument registers).

type Big struct {
	n   int
	arr [20]int
}

func readAfterWrite(b Big, p *Big) int {
	p.n = 99
	p.arr[3] = 77
	return b.n * 100 + b.arr[3]
}

func writeParam(b Big) int {
	b.n = b.n + 1000
	b.arr[3] = -1
	return b.n
}

func onStack(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int, a7 int, b Big, p *Big) int {
	p.n = 55
	return a0 + a7 + b.n * 10 + b.arr[19]
}

func twoBig(x Big, y Big, p *Big) int {
	p.n = 0
	return x.n * 1000 + y.n
}

func main() {
	var v Big
	v.n = 4
	v.arr[3] = 6
	v.arr[19] = 8
	testing.Println(readAfterWrite(v, &v))
	testing.Println(v.n, v.arr[3])

	v.n = 4
	v.arr[3] = 6
	testing.Println(writeParam(v))
	testing.Println(v.n, v.arr[3])

	testing.Println(onStack(1, 2, 3, 4, 5, 6, 7, 8, v, &v))
	testing.Println(v.n)

	v.n = 3
	var p *Big = &v
	testing.Println(twoBig(*p, *p, p))
	testing.Println(v.n)
}
