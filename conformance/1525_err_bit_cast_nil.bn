package "main"
import "pkg/builtins/testing"

// bit_cast cannot reinterpret the untyped nil: it has no representation of its
// own (§8.6); cast(T, nil) gives a pointer or function value its nil.  A cast of
// nil to an interface value is rejected naming nil — an interface value is not
// nillable (type.nil.literal).

type Node struct { v int }

interface I { f() int }

func main() {
	var p *int = bit_cast(*int, nil)
	var n int = bit_cast(int, nil)
	var m @Node = bit_cast(@Node, nil)
	var i @I = cast(@I, nil)
	var q *int = cast(*int, nil)
	testing.Println(p == q, n, m == nil, present(i))
}
