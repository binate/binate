package "main"
import "pkg/builtins/testing"

// nil is not assignable to an interface value (type.nil.literal) — `*any` and
// `@any` included — wherever it would be: a var initializer (local or
// package-level), an assignment, an argument (also a variadic one, a method's,
// a generic function's), a return value, a composite literal's field or
// element, through an alias or a readonly destination.

type Box struct {
	item *any
}

type A = *any

type S struct {
	n int
}

func (s @S) put(x *any) bool { return present(x) }

func id[T any](x T) T { return x }

func take(x *any) bool { return present(x) }

func give() *any { return nil }

var gv *any = nil

func main() {
	var z *any = nil
	var w @any = nil
	var a *any
	a = nil
	var b Box = Box{item: nil}
	var l @[]*any = @[]*any{nil}
	var s @S = make(S)
	var x A = nil
	var r readonly *any = nil
	testing.Println(nil)
	testing.Println(present(z), present(w), present(a), take(nil), present(give()), present(b.item),
			len(l), s.put(nil), present(id[*any](nil)), present(x), present(r), present(gv))
}
