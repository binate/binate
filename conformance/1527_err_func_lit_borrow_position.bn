package "main"
import "pkg/builtins/testing"

// A function literal's body is its own function: the borrowing position of the
// argument or initializer it sits in does not extend into its returns,
// assignments and stores, where a value borrowed into a raw interface value would
// be a temporary outliving its statement (§11.4).  A var initializer inside the
// body is a borrowing position of its own, so it is accepted.

type Box struct {
	item *any
}

var g *any

interface I { f() int }

type V struct { n int }

func (v *V) f() int { return v.n }

impl *V : I

func mkV() V { return V{n: 6} }

type S struct { n int }

func (s @S) do(f *func()) { f() }

type Opts struct {
	F *func()
}

func run2(o Opts) { o.F() }

func run(f *func()) { f() }

func mk(f *func() *any) *any { return f() }

func main() {
	run(func() { g = 42 })
	var p *any = mk(func() *any { return 7 })
	h := func() *any { return 8 }
	run(func() {
		var b Box
		b.item = 9
		_ = b
	})
	run(func() {
		var ok *any = 5
		testing.Println(ok)
	})
	run(func() { run(func() { g = 1 }) })
	defer run(func() { g = 2 })
	var s @S = make(S)
	s.do(func() { g = 3 })
	x := func() *any { return 4 }()
	run(func() { var gi *I; gi = mkV(); _ = gi })
	run2(Opts{F: func() { g = 7 }})
	testing.Println(p, h(), x)
}
