package "main"
import "pkg/builtins/testing"

// A repeated `expose "P"` of one package is idempotent (pkg.expose.conflict): a
// pure forwarder that exposes pkg/newlib twice, and a package with its own `.bn`
// that does, both compile and re-export pkg/newlib's surface once.  (bnlint's
// doubled-expose rule flags the repeat.)

import "pkg/oldlib"
import "pkg/mixed"

func main() {
	testing.Println(oldlib.Add(3, 4), oldlib.MAX, mixed.Add(1, 2), mixed.Own())
}
