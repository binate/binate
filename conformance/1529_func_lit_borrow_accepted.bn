package "main"
import "pkg/builtins/testing"

// The borrowing positions that stay borrowing around a function literal: a var
// initializer inside the literal's body (typed or inferred) borrows into the
// literal's own frame; after the literal, the argument or composite it sits in
// is borrowing again, so a sibling element and the literal itself may be
// borrowed into a raw interface value; a local inferred var initializer is
// borrowing, as a `:=` one is.

type Box struct {
	item *any
}

type Opts struct {
	F   *func()
	Any *any
}

func run(f *func()) { f() }

func run2(o Opts) {
	o.F()
	testing.Println(o.Any)
}

func takeAny(x *any) bool { return present(x) }

func main() {
	run(func() {
		var ok *any = 5
		testing.Println(ok)
	})
	run(func() {
		var b = Box{item: 9}
		testing.Println(b.item)
	})
	run2(Opts{F: func() {}, Any: 43})
	testing.Println(takeAny(func() {}))
	var o = Opts{F: func() {}, Any: 44}
	testing.Println(o.Any)
}
