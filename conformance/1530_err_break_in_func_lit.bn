package "main"
import "pkg/builtins/testing"

// A loop or switch around a function literal is not around its body: a `break`
// or `continue` in the body has no target and is rejected (§14.12), in a loop, a
// switch case and a nested literal alike.  A loop inside the literal is its own.

func run(f *func()) { f() }

func main() {
	var n int = 0
	for i := 0; i < 3; i++ {
		f := func() { break }
		g := func() { continue }
		f()
		g()
		n++
	}
	switch n {
	case 3:
		run(func() { break })
	}
	for i := 0; i < 2; i++ {
		run(func() { run(func() { continue }) })
	}
	run(func() {
		for j := 0; j < 2; j++ {
			if j == 1 { break }
			continue
		}
	})
	testing.Println(n)
}
