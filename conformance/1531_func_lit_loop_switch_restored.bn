package "main"
import "pkg/builtins/testing"

// A function literal inside a loop or switch leaves the loop / switch in force
// after it: a later `break` / `continue` still has its target.  A `defer` inside
// a literal inside a loop belongs to the literal (stmt.defer.no-loop).

func run(f *func()) { f() }

func note(s *[]readonly char) { testing.Println(s) }

func main() {
	var n int = 0
	for i := 0; i < 5; i++ {
		f := func() {}
		f()
		if i == 2 { break }
		n++
	}
	var m int = 0
	for i := 0; i < 3; i++ {
		run(func() {})
		if i == 0 { continue }
		m++
	}
	switch n {
	case 2:
		run(func() {})
		if m == 2 { break }
		testing.Println("not reached")
	}
	for i := 0; i < 2; i++ {
		run(func() { defer note("deferred") })
	}
	testing.Println(n, m)
}
