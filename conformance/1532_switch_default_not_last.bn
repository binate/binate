package "main"
import "pkg/builtins/testing"

// A switch's `default` runs only when no case matches, wherever it is written
// (stmt.switch.default): first, in the middle, or last — tagged and tagless; a
// type switch alike.

func first(x int) int {
	switch x {
	default:
		return 0
	case 1:
		return 10
	case 2:
		return 20
	}
}

func middle(x int) int {
	switch x {
	case 1:
		return 10
	default:
		return 0
	case 2:
		return 20
	}
}

func last(x int) int {
	switch x {
	case 1:
		return 10
	case 2:
		return 20
	default:
		return 0
	}
}

func tagless(x int) int {
	var r int = -1
	switch {
	default:
		r = 0
	case x > 5:
		r = 50
	case x > 1:
		r = 10
	}
	return r
}

// order records, in sequence, the case expressions sideFx evaluates.
var order int = 0

func probe(v int) int {
	order = order * 10 + v
	return v
}

// sideFx's case expressions after its default are evaluated before the
// default runs.
func sideFx(x int) int {
	switch x {
	default:
		return -order
	case probe(1):
		return 100
	case probe(2):
		return 200
	}
}

type A struct { v int }

func typed(x @any) int {
	switch v := x.(type) {
	default:
		return 0
	case @A:
		return v.v
	}
}

func main() {
	testing.Println(first(1), first(2), first(3))
	testing.Println(middle(1), middle(2), middle(3))
	testing.Println(last(1), last(2), last(3))
	testing.Println(tagless(0), tagless(3), tagless(9))
	testing.Println(sideFx(3))
	var a @A = make(A)
	a.v = 7
	testing.Println(typed(a))
}
