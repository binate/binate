package "main"
import "pkg/builtins/testing"

// A switch case that may `break` out of the switch does not terminate, also when
// the break is nested in an if or a block (§14.14): a function whose last
// statement is such a switch is missing a return.  A break a nested loop
// consumes does not count.

func nestedIf(x int) int {
	switch x {
	case 1:
		if x > 0 { break }
		return 1
	default:
		return 2
	}
}

func nestedBlock(x int) int {
	switch x {
	case 1:
		{
			break
		}
	default:
		return 2
	}
}

func typed(x @any) int {
	switch x.(type) {
	case @any:
		if true { break }
		return 1
	default:
		return 2
	}
}

func loopBreak(x int) int {
	switch x {
	case 1:
		for i := 0; i < 3; i++ { break }
		return 1
	default:
		return 2
	}
}

func main() {
	testing.Println(nestedIf(1), nestedBlock(1), loopBreak(1))
}
