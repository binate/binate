package "main"
import "pkg/builtins/testing"

// A named type over a readonly type makes its locations readonly, as an alias of
// one does (§7.11): a variable, slice element, struct or array of it cannot be
// assigned, nor written through a pointer to it, and a readonly handle type
// cannot be rebound — while its pointee stays writable (readonly is shallow).

type RI readonly int8

type RS readonly struct {
	a int
}

type RA readonly [2]int

type RP readonly *int

func main() {
	var n int = 1
	var m int = 2
	var x RI = 5
	x = 6
	var sl @[]RI = make_slice(RI, 2)
	sl[0] = 3
	var s RS
	var t RS
	s = t
	var a RA
	var b RA
	a = b
	var p RP = &n
	p = &m
	*p = 7
	var q *RI = &x
	*q = 9
	testing.Println(x, sl[0], s.a, a[0], *p, *q)
}
