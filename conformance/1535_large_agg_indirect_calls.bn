package "main"

import "pkg/builtins/testing"

// By-value aggregates larger than 16 bytes — a 24-byte struct and a managed-slice
// (32 bytes on 64-bit targets) — through every indirect call shape: a function
// value, closures capturing one or taking one before and after scalar arguments,
// closures returning an aggregate or several values while capturing one, and an
// interface method taking them.  On x86-64 such an aggregate is passed on the
// stack, as C passes it, so the shims that adapt a function value's dispatch to
// the real call must place it there and keep every other argument in order.

type S24 struct {
	a int
	b int
	c int
}

type Pair struct {
	x int
	y int
}

interface Summer {
	sum(s S24, m @[]int, k int) int
}

type Adder struct {
	base int
}

func (p *Adder) sum(s S24, m @[]int, k int) int {
	return p.base + s.a + s.b + s.c + m[0] + m[1] + k
}

impl *Adder : Summer

func weigh(s S24, m @[]int, k int) int {
	return s.a * 100 + s.c * 10 + m[1] + k
}

func sumS(t S24) int {
	return t.a + t.b * 10 + t.c * 100
}

func bump(t S24, d int) S24 {
	return mkS(t.a + d, t.b + d, t.c + d)
}

func mkS(a int, b int, c int) S24 {
	var s S24
	s.a = a
	s.b = b
	s.c = c
	return s
}

func main() {
	var s S24 = mkS(1, 2, 3)
	var m @[]int = make_slice(int, 2)
	m[0] = 40
	m[1] = 50

	// A function value whose parameters include both large aggregates.
	var fv *func(S24, @[]int, int) int = weigh
	testing.Println(fv(s, m, 7))

	// A closure capturing a managed-slice, taking two scalars: the capture takes
	// no argument register on x86-64, so the scalars move down one.
	var g *func(int, int) int = func(p int, q int) int { return m[0] * 1000 + p * 10 + q }
	testing.Println(g(3, 4))

	// An int capture, then a 24-byte struct and a scalar.
	var bias int = 9
	var h *func(S24, int) int = func(t S24, x int) int { return bias * 1000 + t.b * 100 + x }
	testing.Println(h(s, 8))

	// A scalar, a 24-byte struct, a managed-slice and another scalar.
	var k *func(int, S24, @[]int, int) int = func(p int, t S24, n @[]int, q int) int {
		return p * 10000 + t.c * 1000 + n[0] * 10 + q
	}
	testing.Println(k(5, s, m, 6))

	// Aggregate-returning closures capturing a managed-slice and a struct.
	var pr *func(int) Pair = func(i int) Pair {
		var r Pair
		r.x = m[i] + s.a
		r.y = s.c
		return r
	}
	var p Pair = pr(1)
	testing.Println(p.x, p.y)
	var big *func(int) S24 = func(i int) S24 { return mkS(m[i], s.b, i) }
	var b S24 = big(0)
	testing.Println(b.a, b.b, b.c)

	// A multi-value-returning closure capturing a managed-slice, taking a struct.
	var mr *func(S24) (int, int) = func(t S24) (int, int) { return m[1] + t.a, t.c }
	x, y := mr(s)
	testing.Println(x, y)

	// Function values with few dispatch words: one taking only the 24-byte
	// struct, one also returning it.
	var onlyS *func(S24) int = sumS
	testing.Println(onlyS(s))
	var echo *func(S24, int) S24 = bump
	var e S24 = echo(s, 10)
	testing.Println(e.a, e.b, e.c)

	// A closure capturing only the struct, returning a Pair; and a Pair-returning
	// closure capturing only the managed-slice, taking three scalars.
	var ps *func(int) Pair = func(i int) Pair {
		var r Pair
		r.x = s.a + i
		r.y = s.c
		return r
	}
	var q Pair = ps(5)
	testing.Println(q.x, q.y)
	var pm *func(int, int, int) Pair = func(a int, b int, c int) Pair {
		var r Pair
		r.x = m[0] + a * 100 + b * 10 + c
		r.y = m[1]
		return r
	}
	var q2 Pair = pm(1, 2, 3)
	testing.Println(q2.x, q2.y)

	// An interface method taking both large aggregates.
	var ad Adder
	ad.base = 1000
	var sm *Summer = &ad
	testing.Println(sm.sum(s, m, 7))
}
