package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// type.named.methods-not-inherited: a named interface-value type has only its own
// methods, so `x.Len()` on `type X @J` calls X's Len — directly, through a `*X` /
// `@X` receiver, deferred — and never dispatches through J's vtable (which has no
// Len slot).  Same for a named raw interface value (`type RX *J`).  The refcount
// line must print 0.

interface J { Get() int }

type Cell struct { n int }

func (c *Cell) Get() int { return c.n }

impl *Cell : J

type X @J

func (x X) Len() int { return cast(@J, x).Get() + 100 }

type RX *J

func (r RX) Len() int { return cast(*J, r).Get() + 200 }

var cell @Cell

func rc() int { return rt.Refcount(bit_cast(*uint8, cell)) }

func show(n int) { testing.Println("deferred", n) }

func mkX() X {
	var j @J = cell
	return cast(X, j)
}

type HoldX struct { x X }

func run() {
	var j @J = cell
	var x X = cast(X, j)
	testing.Println(x.Len())
	var px *X = &x
	testing.Println(px.Len())
	var mx @X = box(x)
	testing.Println(mx.Len())
	var rj *J = cell
	var r RX = cast(RX, rj)
	testing.Println(r.Len())
	testing.Println(mkX().Len())
	var hx HoldX
	hx.x = x
	testing.Println(hx.x.Len())
	var f *func() int = x.Len
	testing.Println(f())
	defer x.Len()
	defer show(x.Len())
}

func main() {
	cell = make(Cell)
	cell.n = 4
	var base int = rc()
	run()
	testing.Println(rc() - base)
}
