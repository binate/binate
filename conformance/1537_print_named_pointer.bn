package "main"

import "pkg/builtins/reflect"
import "pkg/builtins/testing"

// type.layout.typeinfo, iface.construct.named-pointer: a value of a named pointer
// type is boxed as a value — its box points at the H — so its TypeInfo record is a
// pointer kind's, and describes the pointee as a pointer field's entry does: the
// pointee's KIND and size, and (a struct pointee) the pointee's own record.  A
// printer follows it: testing.Println renders `&` then a scalar pointee, `<nil>`
// for a nil pointer.

type Inner struct { n int }

type Node struct {
	v int
	w int
	p @Inner
}

type H @Node

type PS *Node

type MI @int

func describe(x *any) {
	var ti *reflect.TypeInfo = reflect.TypeOf(x)
	testing.Println(ti.Name, ti.Kind == reflect.KIND_PTR, ti.ElemKind == reflect.KIND_STRUCT,
			ti.ElemSize == cast(int, sizeof(Node)))
	if ti.ElemType != nil {
		var et *reflect.TypeInfo = bit_cast(*reflect.TypeInfo, ti.ElemType)
		testing.Println(et.Name, len(et.Fields), et.Fields[2].Kind == reflect.KIND_PTR)
	}
}

func main() {
	var n @Node = make(Node)
	n.v = 7
	var h H = n
	describe(h)
	var node Node
	var ps PS = &node
	describe(ps)
	var mi MI = box(cast(int, 42))
	testing.Println(mi)
	var nmi MI
	testing.Println(nmi)
	var ti *reflect.TypeInfo = reflect.TypeOf(mi)
	testing.Println(ti.ElemKind == reflect.KIND_INT, ti.ElemSize == cast(int, sizeof(int)), ti.ElemType == nil)
}
