package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.assert.kind, iface.construct.named-pointer: every named type is boxed as a
// value of its own type (the box points at it), so a bare-name value recovery
// `x.(T)` copies it out — a named managed slice, raw slice, function value or
// interface value as well as a scalar or struct — retaining what a managed one
// holds.  Expression, comma-ok and type-switch forms; the live-block count must be
// balanced across repeated runs.

interface J { Get() int }

type Cell struct { n int }

func (c *Cell) Get() int { return c.n }

impl *Cell : J

type NS @[]int

type RS *[]int

type F @func(int) int

type X @J

func run() {
	var ns NS = make_slice(int, 3)
	ns[1] = 5
	var a @any = box(ns)
	var gotNS NS = a.(NS)
	testing.Println(len(gotNS), gotNS[1])

	var backing [2]int
	backing[0] = 9
	var rs RS = backing[0:2]
	var r *any = rs
	var gotRS RS = r.(RS)
	testing.Println(len(gotRS), gotRS[0])

	var k int = 10
	var f F = func(x int) int { return x + k }
	var af @any = box(f)
	var gotF F = af.(F)
	testing.Println(gotF(1))

	var c @Cell = make(Cell)
	c.n = 4
	var j @J = c
	var x X = cast(X, j)
	var ax @any = box(x)
	var ok bool
	var gotX X
	gotX, ok = ax.(X)
	testing.Println(cast(@J, gotX).Get(), ok)
	_, ok = ax.(NS)
	testing.Println(ok)

	switch v := a.(type) {
	case X:
		testing.Println("X")
	case NS:
		testing.Println("NS", len(v))
	}
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	for i := 0; i < 3; i++ {
		run()
	}
	testing.Println(rt.LiveBlocks() - base)
}
