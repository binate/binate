package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.construct.value-borrow, mem.temporary: a non-addressable value borrowed into
// a raw interface ARGUMENT is a statement temporary — released at the end of its
// statement, exactly once, on every path — while a `var` initializer's borrow
// (including one inside a composite literal it initializes) lives as long as the
// binding.  A short-circuit that skips the borrow, a borrow in a loop condition or
// post statement, and a borrow nested inside a deferred call's argument must
// neither crash nor leak; each refcount line must print 0.

interface Getter { Get() int }

type Inner struct { v int }

type W struct { p @Inner }

func (w W) Get() int { return w.p.v + 1000 }

impl W : Getter

type Node struct { p @Inner }

type H @Node

func (h H) Get() int { return h.p.v + 2000 }

impl H : Getter

type Opts struct { g *Getter }

var inr @Inner

func rc() int { return rt.Refcount(bit_cast(*uint8, inr)) }

func mkW() W {
	var w W
	w.p = inr
	return w
}

func mkH() H {
	var n @Node = make(Node)
	n.p = inr
	return cast(H, n)
}

func takeR(g *Getter) int { return g.Get() }

// dirty fills the stack below the caller with junk, so a temporary slot that is
// released without ever being stored reads garbage rather than a lucky zero.
func dirty(k int) int {
	var a [16]int
	for i := 0; i < 16; i++ { a[i] = 0x41414141 + k }
	return a[3]
}

func shortCircuit(n int) {
	if n > 100 && takeR(mkW()) > 0 && takeR(mkH()) > 0 {
		testing.Println("taken")
	}
	if n < 100 || takeR(mkW()) > 0 {
		testing.Println("or")
	}
}

func loops() {
	var n int = 0
	for i := 0; i < 3 && takeR(mkW()) > 0; i++ { n++ }
	for i := 0; i < 3; i = i + takeR(mkH()) - 2000 { n++ }
	testing.Println("loops", n)
}

func varInit() {
	var r *Getter = mkW()
	var o Opts = Opts{g: mkH()}
	testing.Println(r.Get(), o.g.Get())
}

func cnt(g *Getter) int { return g.Get() }

func show3(n int, b *Getter) { testing.Println("d", n, b.Get()) }

func deferNested(c bool) {
	var w W = mkW()
	var w2 W = mkW()
	w2.p = make(Inner)
	w2.p.v = 2
	if c {
		defer show3(cnt(w), w2)
	}
	w2 = mkW()
}

func main() {
	inr = make(Inner)
	inr.v = 1
	var base int = rc()
	dirty(1)
	shortCircuit(1)
	testing.Println(rc() - base)
	loops()
	testing.Println(rc() - base)
	varInit()
	testing.Println(rc() - base)
	deferNested(true)
	testing.Println(rc() - base)
}
