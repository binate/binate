package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.construct.value-borrow: a non-addressable value of a generic instance type
// borrowed into a raw interface is boxed under IR-gen's instance type — its vtable,
// type info and destructor are the instance's — as an argument, a `var`
// initializer and a deferred call's operand, and through a named pointer to a
// generic struct (`type HBS @Box[@[]char]`, a value).  A type switch recovers the
// instance; the refcount line must print 0.

type Box[T any] struct {
	v T
	w int
}

type Pair[T any] struct {
	a T
	b T
}

type HBS @Box[@[]char]

type Inner struct { n int }

var inr @Inner

func rc() int { return rt.Refcount(bit_cast(*uint8, inr)) }

func mkPair(n int) Pair[int] {
	var p Pair[int]
	p.a = n
	p.b = n + 1
	return p
}

func mkBox(n int) Box[@Inner] {
	var b Box[@Inner]
	b.v = inr
	b.w = n
	return b
}

func show(x *any) {
	switch v := x.(type) {
	case Pair[int]:
		testing.Println("pair", v.a, v.b)
	case Box[@Inner]:
		testing.Println("box", v.v.n, v.w)
	case HBS:
		testing.Println("hbs", len(v.v), v.w)
	default:
		testing.Println("default")
	}
}

func run() {
	show(mkPair(1))
	show(mkBox(2))
	var bs @Box[@[]char] = make(Box[@[]char])
	bs.v = "str"
	show(cast(HBS, bs))
	var a *any = mkBox(3)
	show(a)
	defer show(mkBox(4))
}

func main() {
	inr = make(Inner)
	inr.n = 9
	var base int = rc()
	run()
	testing.Println(rc() - base)
}
