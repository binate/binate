package "main"

import "pkg/oq"

// A value-recovery assertion `x.(T)` copies a T out, so a type another package
// exports as opaque cannot be its target — whatever its hidden layout (a managed
// slice, a struct) — even where the copy is only borrowed (an argument), while
// `x.(*T)` / `x.(@T)` recover a handle to it.

func f(x *any) {
}

func use(a @any) {
	var p @oq.OS = a.(@oq.OS)
	_ = p
	f(a.(oq.OS))
	f(a.(oq.O))
}

func main() {
}
