package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/np"

// iface.construct.named-pointer across packages: a named pointer type and its impl
// declared in an imported package box as values here — the declaring package's
// vtable dispatches through the deref thunk and its slot-0 destructor releases the
// `@Node` an H cell holds, and the dynamic type is the named type.  The refcount
// line must print 0.

var inr @np.Inner

func rc() int { return rt.Refcount(bit_cast(*uint8, inr)) }

func run() {
	var h np.H = np.MkH(inr)
	var r *np.Getter = h
	var g @np.Getter = box(h)
	testing.Println(r.Get(), g.Get())
	var a @any = box(np.MkH(inr))
	var ok bool
	var v np.H
	v, ok = a.(np.H)
	testing.Println(v.Get(), ok)
	_, ok = a.(@np.Node)
	testing.Println(ok)
	var g2 @np.Getter
	g2, ok = a.(@np.Getter)
	testing.Println(g2.Get(), ok)
	var s np.S
	s.v = 4
	var ps np.PS = &s
	var rp *np.Getter = ps
	testing.Println(rp.Get())
}

func main() {
	inr = make(np.Inner)
	inr.v = 3
	var base int = rc()
	run()
	testing.Println(rc() - base)
}
