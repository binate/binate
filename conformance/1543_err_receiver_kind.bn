package "main"

import "pkg/builtins/testing"

// A method's or an impl's receiver is a value, `*T` or `@T` over a named type
// (func.method.receiver-kinds, func.method.impl-receiver).  A second pointer
// level is not a receiver kind, whether spelled directly, on a generic type,
// under a `readonly`, or (for an impl) through an alias.

type St struct {
	n int
}

type Box[T any] struct {
	v T
}

type PSt = *St

interface Peeker {
	Peek() int
}

func (s St) Peek() int { return s.n }

func (s **St) Two() int { return 2 }

func (s *@St) Mixed() int { return 3 }

func (s *readonly *St) Inner() int { return 4 }

func (b **Box[T]) Gen() int { return 6 }

impl **St : Peeker

impl *PSt : Peeker

func main() {
	var s St
	testing.Println(s.Peek())
}
