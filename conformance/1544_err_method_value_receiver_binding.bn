package "main"

// A method value binds its receiver exactly as the call would: a pointer-receiver
// method value needs an addressable receiver (a call result has no address), a
// read-only object binds only a read-only-receiver method, and a value never binds
// an `@T` method.

type P struct {
	n int
}

func (p *P) Inc() int {
	p.n = p.n + 1
	return p.n
}

func (p @P) Own() int { return p.n }

type S struct {
	p P
}

func mk() P {
	var p P
	return p
}

func main() {
	var a *func() int = mk().Inc
	var rp readonly P
	var b *func() int = rp.Inc
	var s S
	var rs *readonly S = &s
	var c *func() int = rs.p.Inc
	var arr [2]P
	var xs *[]readonly P = arr[:]
	var d *func() int = xs[0].Inc
	var v P
	var e *func() int = v.Own
	_ = a
	_ = b
	_ = c
	_ = d
	_ = e
}
