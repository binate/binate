package "main"

import "pkg/builtins/testing"

// `box` of a pointer boxes the pointer, even when the pointer is a variable's
// own address — `box(&x)` of a local, `box(&G)` of a global — or a value the
// optimizer (-O1+) resolves to one: a pointer variable holding `&x`, a call
// the inliner flattens, a field load, a multi-value result, a relabel cast, a
// generic instance's T-typed parameter.  Each boxed pointer must alias its
// variable: a write through it shows up in the variable.

type S struct {
	a int
	b int
}

type PS *S

// N is a recursive named pointer: `&x` for `x N` is `*N`, which converts to N
// implicitly, so the address of an N-typed slot can itself be an N.
type N *N

type Holder struct {
	p *S
	n int
}

var G S
var GI int

func id(p *S) *S { return p }

func two(p *S) (*S, int) { return p, 1 }

func Bx[T any](v T) @T { return box(v) }

func BxA[T any](p *T) @(*T) { return box(p) }

// BxL boxes the address of its own T-typed local and writes through the box.
func BxL[T any](v T, w T) T {
	var t T = v
	var b @(*T) = box(&t)
	**b = w
	return t
}

func main() {
	var x S
	x.a = 1
	x.b = 2

	var bx @(*S) = box(&x)
	(*bx).a = 10
	var bp @(*S)
	var p *S = &x
	bp = box(p)
	(*bp).b = 20
	testing.Println(x.a, x.b)

	G.b = 4
	var bg @(*S) = box(&G)
	(*bg).b = 40
	GI = 5
	var bgi @(*int) = box(&GI)
	**bgi = 50
	testing.Println(G.b, GI)

	var n int = 6
	var bn @(*int) = box(&n)
	**bn = 60
	var arr [3]int
	var ba @(*([3]int)) = box(&arr)
	(*(*ba))[2] = 7
	testing.Println(n, arr[2])

	var bl @(*S) = box(&S{a: 8, b: 9})
	testing.Println((*bl).a, (*bl).b)

	var nx N
	var bn1 @N = box(cast(N, &nx))
	var pn N = &nx
	var bn2 @N = box(pn)
	testing.Println(*bn1 == cast(N, &nx), *bn2 == cast(N, &nx))

	var bc1 @(*S) = box(cast(*S, &x))
	(*bc1).a = 11
	var bc2 @PS = box(cast(PS, &x))
	(*bc2).b = 21
	testing.Println(x.a, x.b)

	var bi @(*S) = box(id(&x))
	(*bi).a = 12
	var h Holder
	h.p = &x
	var bh @(*S) = box(h.p)
	(*bh).b = 22
	var r *S
	var k int
	r, k = two(&x)
	var br @(*S) = box(r)
	(*br).a = 13 + k
	testing.Println(x.a, x.b)

	var bt @(*S) = Bx[*S](&x)
	(*bt).a = 15
	var bu @(*S) = BxA[S](&x)
	(*bu).b = 25
	testing.Println(x.a, x.b)

	var y S = BxL[S](x, S{a: 16, b: 26})
	testing.Println(y.a, y.b, BxL[int](1, 27))
}
