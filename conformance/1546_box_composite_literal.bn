package "main"

import "pkg/builtins/testing"

// `box` of a struct / array composite literal boxes a COPY of the literal's
// value, as does `box` of an aggregate variable; a write through the box changes
// the copy only.

type S struct {
	a int
	b int
}

type Row [3]int

type NS S

type Pair[T any] struct {
	x T
	y T
}

func mk() S { return S{a: 5, b: 6} }

func boxPair[T any](v T) @Pair[T] { return box(Pair[T]{x: v, y: v}) }

func main() {
	var b1 @S = box(S{a: 1, b: 2})
	b1.a = 3
	testing.Println(b1.a, b1.b)

	var b2 @([2]S) = box([2]S{S{a: 1}, S{a: 2}})
	testing.Println((*b2)[0].a, (*b2)[1].a)

	var x S
	x.a = 7
	var b3 @S = box(x)
	b3.a = 70
	testing.Println(x.a, b3.a)

	var b4 @S = box(mk())
	testing.Println(b4.a, b4.b)

	var b5 @(@[]int) = box(@[]int{1, 2, 3})
	testing.Println(len(*b5), (*b5)[2])

	var b6 @Row = box(Row{4, 5, 6})
	var b7 @NS = box(NS{a: 8, b: 9})
	testing.Println((*b6)[1], b7.b)

	var b8 @Pair[int] = boxPair[int](7)
	testing.Println(b8.x, b8.y)
}
