package "main"

import "pkg/builtins/testing"

// A counter checked against the array length inside an infinite loop, where
// that comparison is not the loop's exit test: its false arm stays in the loop
// and rejoins the indexing, so `a[i]` is reached with i >= len(a) and must still
// trap.  An optimizer that read `i < 10` as a counted loop's guard (and dropped
// the bounds check on `a[i]`) would read past the array instead.

func f(n int) int {
	var a [10]int
	var s int = 0
	var i int = 0
	for {
		if i < 10 {} else {
			s = s + 1
		}
		s = s + a[i]
		i++
		if i > n { break }
	}
	return s
}

func main() {
	testing.Println(f(12))
}
