package "main"

import "pkg/builtins/testing"

// `unsafe_cast` narrowing an interface value to a pointer target with an
// outermost `readonly` — `readonly @Node`, `readonly *Node`, or an alias of
// either — recovers the boxed pointer (as the target without its readonly
// would), not a value loaded through the box's data word.

type Node struct {
	v int
}

type RM = readonly @Node

type RP = readonly *Node

func main() {
	var n @Node = make(Node)
	n.v = 7
	var a @any = n
	var q readonly @Node = unsafe_cast(readonly @Node, a)
	var p readonly *Node = unsafe_cast(readonly *Node, a)
	var qa RM = unsafe_cast(RM, a)
	var pa RP = unsafe_cast(RP, a)
	p.v = 8
	testing.Println(q.v, p.v, qa.v, pa.v)
}
