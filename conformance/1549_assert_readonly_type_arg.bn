package "main"

import "pkg/builtins/testing"

// An assertion whose target is a type parameter bound to a type argument with an
// outermost `readonly` recovers as the type under it, into a read-only handle:
// `readonly *Thing` borrows the `*Thing`, `readonly @Thing` retains the `@Thing`,
// `readonly Celsius` copies the `Celsius` out.  The pointee of a read-only handle
// stays writable.  The written `x.(readonly T)` — with a handle or a value T —
// and `x.(readonly Celsius)` recover the same way, in the expression, comma-ok
// and type-switch forms, as do interface-value and slice type arguments.

type Thing struct {
	n int
}

type Celsius int

interface Getter {
	Get() int
}

impl *Thing : Getter

func (t *Thing) Get() int { return t.n }

func as[T any](x @any) T { return x.(T) }

func asP[T any](x *any) T { return x.(T) }

func pickV[T any](x @any) T {
	var z T
	switch v := x.(type) {
	case T:
		return v
	default:
		return z
	}
}

func ro[T any](x @any) T { return x.(readonly T) }

func try[T any](x @any) bool {
	v, ok := x.(T)
	_ = v
	return ok
}

func pick[T any](x @any) int {
	switch v := x.(type) {
	case T:
		_ = v
		return 1
	default:
		return 0
	}
}

func main() {
	var t @Thing = make(Thing)
	t.n = 3
	var a @any = t

	var r1 readonly *Thing = as[readonly *Thing](a)
	r1.n = 4
	var r2 readonly @Thing = as[readonly @Thing](a)
	testing.Println(t.n, r2.n)

	var r3 readonly *Thing = ro[*Thing](a)
	r3.n = 5
	testing.Println(t.n)

	testing.Println(try[readonly *Thing](a), try[readonly @Thing](a), try[readonly *Celsius](a))
	testing.Println(pick[readonly @Thing](a), pick[readonly *Thing](a), pick[readonly @Celsius](a))

	var c Celsius = 21
	var ca @any = box(c)
	var r4 readonly Celsius = as[readonly Celsius](ca)
	testing.Println(r4, try[readonly Celsius](ca), try[readonly Celsius](a))
	var r5 readonly Celsius = ca.(readonly Celsius)
	var r6 readonly Celsius = ro[Celsius](ca)
	testing.Println(r5, r6)

	var g readonly @Getter = as[readonly @Getter](a)
	var buf [3]char
	var rs *[]char = buf[0:3]
	var sa *any = &rs
	var got readonly *[]char = asP[readonly *[]char](sa)
	var pv readonly @Thing = pickV[readonly @Thing](a)
	testing.Println(g.Get(), len(got), pv.n)
}
