package "main"

import "pkg/b"
import "pkg/builtins/testing"

// A method value whose receiver is written as a dereference `(*p).M`, an address
// `(&x).M` / `(&w.f).M`, a composite literal `T{…}.M`, a type assertion `a.(*T).M`,
// a call, a conversion or a read-only variable names the method of the receiver's
// type: a generic instantiation's (local or imported, a pointer- and a
// value-receiver method), an imported type's, inside a generic body, and the type
// of the function a call actually calls when a local function value shadows a
// function of the same name.

type Box[T any] struct {
	n int
	t T
}

func (bx *Box[T]) Inc() int {
	bx.n = bx.n + 1
	return bx.n
}

func (bx Box[T]) Get() int { return bx.n }

type W struct {
	bx Box[int]
}

type Other struct {
	v int
}

func (o *Other) Get() int { return o.v + 1000 }

var gother Other

func getOther() *Other { return &gother }

func mk() *Box[int] { return nil }

func viaGen[X any](p *Box[X]) int {
	var f *func() int = (*p).Inc
	return f()
}

var gbox Box[int]

var gget *func() int = (&gbox).Inc

func main() {
	var bx Box[int]
	bx.n = 10
	var pb *Box[int] = &bx
	var f1 *func() int = (*pb).Inc
	testing.Println(f1(), bx.n) // 11 11
	var f2 *func() int = (*pb).Get
	bx.n = 20
	testing.Println(f2()) // 11
	var f3 *func() int = (&bx).Inc
	testing.Println(f3(), bx.n) // 21 21
	var w W
	w.bx.n = 5
	var f4 *func() int = (&w.bx).Inc
	testing.Println(f4(), w.bx.n) // 6 6
	var f5 *func() int = Box[int]{n: 3}.Get
	testing.Println(f5()) // 3
	var a *any = pb
	var f6 *func() int = a.(*Box[int]).Inc
	testing.Println(f6(), bx.n) // 22 22
	var f7 *func() int = a.(*Box[int]).Get
	testing.Println(f7()) // 22
	var rp readonly *Box[int] = pb
	var f8 *func() int = rp.Get
	testing.Println(f8()) // 22
	var mb @Box[int] = make(Box[int])
	mb.n = 40
	var f9 *func() int = (*mb).Inc
	testing.Println(f9(), mb.n) // 41 41
	testing.Println(viaGen[int](pb), bx.n) // 23 23
	gother.v = 7
	var mk *func() *Other = getOther
	var f10 *func() int = mk().Get
	testing.Println(f10()) // 1007
	testing.Println(gget(), gget()) // 1 2
	var s b.St
	var p *b.St = &s
	var pp **b.St = &p
	var g1 *func(int) int = (*pp).Show
	testing.Println(g1(4), s.n) // 4 4
	var g2 *func() int = (*pp).Peek
	testing.Println(g2()) // 4
	var rs readonly *b.St = p
	var g3 *func() int = rs.Peek
	testing.Println(g3()) // 4
	var g4 *func() int = cast(b.N, 5).Dbl
	testing.Println(g4()) // 10
	var gb b.GB[int]
	var pg *b.GB[int] = &gb
	var g5 *func() int = (&gb).Inc
	testing.Println(g5(), gb.n) // 1 1
	var g6 *func() int = (*pg).Get
	testing.Println(g6()) // 1
	var g7 *func() int = b.GB[int]{n: 8}.Get
	testing.Println(g7()) // 8
}
