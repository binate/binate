package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A composite literal addressed in a `var` / `:=` initializer lives as long as
// the new binding (expr.composite.lifetime): addressed by `&`, through a field, by
// a pointer-receiver method value, by slicing an array literal, by an implicit
// value-borrow into a raw interface, or as a call argument whose result is bound.
// Its managed fields are released when the binding's scope exits, not at the end
// of the statement, so later allocations do not reuse them — and nothing leaks.

type P struct {
	n    int
	name @[]char
}

func (p *P) Name() @[]char { return p.name }

func (p *P) Len() int { return len(p.name) }

interface Namer {
	Name() @[]char
}

impl *P : Namer

// S holds a borrowed Namer.
type S struct {
	nm *Namer
}

func (s S) First() char { return s.nm.Name()[0] }

func firstOf() char { return S{nm: P{n: 30, name: mk("returned")}}.nm.Name()[0] }

func lenOf(p **[]readonly int) int { return len(*p) }

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func id(p *P) *P { return p }

// churn allocates and frees managed slices the size of the literals' fields, so
// a field released early would be reused and overwritten.
func churn() {
	for i := 0; i < 8; i++ {
		var junk @[]char = mk("################")
		_ = junk
	}
}

func run() {
	var q *P = &P{n: 1, name: mk("addr")}
	h := P{n: 2, name: mk("method-value")}.Name
	var s *[]@[]char = [2]@[]char{mk("slice-0"), mk("slice-1")}[:]
	var f *@[]char = &P{n: 3, name: mk("field")}.name
	var iv *Namer = P{n: 4, name: mk("borrow")}
	var w *P = id(&P{n: 5, name: mk("call-arg")})
	a, b := &P{n: 6, name: mk("pair-a")}, &P{n: 7, name: mk("pair-b")}
	for i := 0; i < 2; i++ {
		var lp *P = &P{n: i, name: mk("loop")}
		churn()
		testing.Println(lp.n, lp.name)
	}
	for t := &(P{n: 8, name: mk("for-init")}); t.n < 10; t.n++ {
		churn()
		testing.Println(t.n, t.name)
	}
	churn()
	testing.Println(q.n, q.name)
	testing.Println(h())
	testing.Println(s[0], s[1])
	testing.Println(*f)
	testing.Println(iv.Name())
	testing.Println(w.n, w.name)
	testing.Println(a.name, b.name)
	// Outside a var initializer a literal is a statement temporary, its address
	// used within the statement.
	var k int
	k = (&P{n: 11, name: mk("expr")}).n
	k = k + P{n: 12, name: mk("call")}.Len()
	testing.Println(k)
	// A literal borrowed into a temporary's raw-interface field, used within the
	// statement: a condition, an assignment of a result, a return.
	if (S{nm: P{n: 20, name: mk("cond")}}).nm.Name()[0] == 'c' {
		var c char = S{nm: P{n: 21, name: mk("assigned")}}.First()
		testing.Println(c == 'a', firstOf() == 'r')
	}
	// A slice literal's address is its storage, the slice value; a managed one
	// addressed in a var initializer keeps its reference as long as the binding.
	var pm *@[]int = &@[]int{5, 6}
	var pr **[]readonly int = &*[]readonly int{7, 8, 9}
	churn()
	testing.Println(len(*pm), (*pm)[1], len(*pr), (*pr)[2], lenOf(&*[]readonly int{1, 2, 3, 4}))
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
