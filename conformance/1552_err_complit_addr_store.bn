package "main"

// Storing the address of a composite literal past the end of its statement is an
// error (expr.composite.addr-store): the literal is released when its statement
// ends.  An assignment (to a variable, a field or an element) or a `return` may
// not store `&L`, the address of a field or element of L, a pointer-receiver
// method value on L, or a slice of an array literal L — directly or inside a
// composite literal or a cast — nor borrow L into a raw interface; nor any of
// these reached through a pointer into L (`(&L).f`, `*&L`, a slice of a slice of
// L), nor a `bit_cast` of one; nor any of these read back out of a field or
// element of another literal (`S{p: &P{…}}.p`, `(&S{p: &P{…}}).p`, a slice
// literal's element), nor a value-receiver method value whose receiver copy
// holds one.

type P struct {
	n int
}

func (p *P) Get() int { return p.n }

func (s S) Val() int { return s.p.n }

interface Getter {
	Get() int
}

impl *P : Getter

type S struct {
	p *P
	a [2]int
}

type Q struct {
	n int
}

type G struct {
	g *Getter
}

type W struct {
	inner S
}

type S2 struct {
	s *S
}

func ret() *P {
	return &P{n: 1}
}

func retMethod() *func() int {
	return P{n: 2}.Get
}

func retThrough() *func() int {
	return (&P{n: 2}).Get
}

func retSlice() *[]int {
	return [3]int{1, 2, 3}[:][1:]
}

func retRead() *P {
	return S{p: &P{n: 2}}.p
}

func main() {
	var q *P
	q = &P{n: 3}
	var s S
	s.p = &P{n: 4}
	var arr [2]*P
	arr[0] = &P{n: 5}
	var h *func() int
	h = P{n: 6}.Get
	var sl *[]int
	sl = [3]int{1, 2, 3}[:]
	var w S
	w = S{p: &P{n: 7}}
	var g *Getter
	g = P{n: 8}
	var ip *int
	ip = &S{a: [2]int{1, 2}}.a[1]
	q = cast(*P, &P{n: 9})
	ip = &(&P{n: 10}).n
	h = (&P{n: 11}).Get
	q = &*&P{n: 12}
	g = *&P{n: 13}
	sl = [3]int{1, 2, 3}[:][1:]
	var qq *Q
	qq = bit_cast(*Q, &P{n: 14})
	q = S{p: &P{n: 15}}.p
	q = [1]*P{&P{n: 16}}[0]
	g = G{g: P{n: 17}}.g
	s = W{inner: S{p: &P{n: 18}}}.inner
	q = (&S{p: &P{n: 19}}).p
	s = *&S{p: &P{n: 20}}
	q = @[]*P{&P{n: 21}}[0]
	q = [2]*P{&P{n: 22}, nil}[:][1]
	g = (&G{g: P{n: 23}}).g
	var hv *func() int
	hv = S{p: &P{n: 24}}.Val
	_ = hv
	q = @[]*P{&P{n: 25}, &P{n: 26}}[1:][0]
	q = [2]*P{&P{n: 27}, nil}[:][1:][0]
	q = S2{s: &S{p: &P{n: 28}}}.s.p
	q = (&S{p: &P{n: 29}})[0].p
	arr = (&[2]*P{&P{n: 30}, nil})[0]
	var bs @S
	bs = box(S{p: &P{n: 31}})
	_ = bs
	_ = qq
	_ = q
	_ = s
	_ = arr
	_ = h
	_ = sl
	_ = w
	_ = g
	_ = ip
}
