package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// The address of a composite literal is its storage, typed as a pointer to the
// literal's own type.  A slice literal's storage holds the slice value and owns
// its reference: a store through the address releases what it replaces, and the
// last value is released at the end of the statement (or, in a var initializer,
// of the binding's scope).  A named literal's address keeps the name, so a
// pointer-receiver method call, method value or interface borrow on it dispatches
// to the named type's method.

type Buf @[]int

func (b *Buf) Len() int { return len(*b) }

type Row [3]int

func (r *Row) Sum() int { return (*r)[0] + (*r)[1] + (*r)[2] }

type Base struct {
	n int
}

type Wrap Base

func (w *Wrap) Get() int { return w.n }

interface Lener {
	Len() int
}

impl *Buf : Lener

// Holder holds a pointer.
type Holder struct {
	p *int
}

// legal stores pointers read out of literals that hold no literal's address.
func legal() int {
	var v int = 5
	var q *int
	q = Holder{p: &v}.p
	q = (&Holder{p: &v}).p
	var w [1]*int
	w = [1]*int{&v}
	// A value-receiver method value copies the object a pointer receiver points
	// to, so a pointer to a literal is not stored.
	var h *func() int
	h = (&Holder{p: &v}).Deref
	return *q + *w[0] + h()
}

// Deref returns the int h points to.
func (h Holder) Deref() int { return *h.p }

func set(p *@[]int) int {
	*p = @[]int{3, 4, 5}
	return len(*p)
}

func setc(p *@[]readonly char) int {
	var r @[]char = make_slice(char, 3)
	*p = r
	return len(*p)
}

func run() {
	for i := 0; i < 3; i++ {
		testing.Println(set(&@[]int{1, 2}))
	}
	var n int = setc(&@[]readonly char{'a', 'b'})
	testing.Println(n)
	var m int = set(&@[]int{1, 2})
	testing.Println(m)
	testing.Println((&Buf{4, 5}).Len())
	var k int = Buf{1, 2}.Len()
	h := Buf{1, 2, 3}.Len
	var iw *Lener = Buf{1, 2}
	testing.Println(k, h(), iw.Len())
	testing.Println(Row{1, 2, 3}.Sum(), (&Row{4, 5, 6}).Sum())
	testing.Println(Wrap{n: 7}.Get())
	testing.Println(legal())
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
