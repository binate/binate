package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// `unsafe_index(c, i)` is exactly `c[i]` without the bounds check, so it is
// addressable as `c[i]` is — a slice or raw-pointer element always, an array
// element iff the array is: it may be assigned (also from a call, with others),
// incremented, compound-assigned, a field of it stored to, a pointer method called
// or taken as a method value on it, its address taken, an interface borrow made of
// it, an array element of it indexed (and that stored to, incremented, addressed,
// used as a field or method base) and sliced, and it nests; a managed element
// store releases the old value, and a function reference stored through it — or
// through `(&x[0])[i]` — becomes a function value.  A variable named like a generic
// function, indexed and called, is the variable.

type P struct {
	x int
	y int
}

func (p *P) Bump() { p.x = p.x + 100 }

interface Getter {
	get() int
}

type G struct {
	v int
}

func (g *G) get() int { return g.v }

impl *G : Getter

func two() (int, int) { return 21, 22 }

func one() int { return 1 }

func onePlus() int { return 2 }

func F[T any](x T) T { return x }

func run() {
	var arr [4]int
	unsafe_index(arr, 1) = 5
	unsafe_index(arr, 1)++
	unsafe_index(arr, 1) += 10
	testing.Println(arr[1]) // 16
	var s @[]int = make_slice(int, 3)
	unsafe_index(s, 2) = 7
	unsafe_index(s, 2)--
	unsafe_index(s, 2) *= 3
	testing.Println(s[2]) // 18
	var rs *[]int = s
	unsafe_index(rs, 0) = 3
	unsafe_index(rs, 0)++
	testing.Println(s[0]) // 4
	var rp *int = &arr[0]
	unsafe_index(rp, 3) = 9
	unsafe_index(rp, 3) += 1
	testing.Println(arr[3]) // 10
	var ps [2]P
	unsafe_index(ps, 1).x = 4
	unsafe_index(ps, 1).y++
	unsafe_index(ps, 1).Bump()
	testing.Println(ps[1].x, ps[1].y) // 104 1
	var q *P = &unsafe_index(ps, 0)
	q.y = 8
	testing.Println(ps[0].y) // 8
	var bump *func() = unsafe_index(ps, 0).Bump
	bump()
	testing.Println(ps[0].x) // 100
	var rq *P = &ps[0]
	unsafe_index(rq, 1).y += 3
	unsafe_index(rq, 1).Bump()
	testing.Println(ps[1].x, ps[1].y) // 204 4
	var grid [2][3]int
	unsafe_index(grid, 1)[2] = 6
	unsafe_index(grid, 1)[2]++
	var g0 *int = &unsafe_index(grid, 1)[0]
	*g0 = 9
	unsafe_index(unsafe_index(grid, 0), 1) = 4
	unsafe_index(unsafe_index(grid, 0), 1)++
	var row *[]int = unsafe_index(grid, 1)[:]
	row[1] = 1
	testing.Println(grid[1][0], grid[1][1], grid[1][2], grid[0][1]) // 9 1 7 5
	var pg [2][2]P
	unsafe_index(pg, 1)[0].x = 5
	unsafe_index(pg, 1)[1].Bump()
	testing.Println(pg[1][0].x, pg[1][1].x) // 5 100
	var sa @[][3]int = make_slice([3]int, 2)
	unsafe_index(sa, 1)[2] += 7
	unsafe_index(sa, 1)[2]++
	testing.Println(sa[1][2]) // 8
	var xs [2]int
	var iv *any = unsafe_index(xs, 0)
	xs[0] = 42
	testing.Println(iv.(int)) // 42
	var gg G
	gg.v = 77
	var m [2][2]*Getter
	m[1][1] = &gg
	testing.Println(unsafe_index(unsafe_index(m, 1), 1).get()) // 77
	unsafe_index(arr, 0), unsafe_index(s, 1) = 11, 12
	testing.Println(arr[0], s[1]) // 11 12
	unsafe_index(arr, 2), unsafe_index(s, 0) = two()
	testing.Println(arr[2], s[0]) // 21 22
	var fs [3]*func() int
	fs[0] = onePlus
	fs[1] = onePlus
	unsafe_index(&fs[0], 1) = one
	(&fs[0])[2] = one
	testing.Println(fs[0]() + fs[1]() + fs[2]()) // 4
	var F @[]*func() int = make_slice(*func() int, 1)
	F[0] = one
	testing.Println(unsafe_index(F, 0)() + F[0]()) // 2
	var mp @[]@P = make_slice(@P, 2)
	unsafe_index(mp, 0) = make(P)
	unsafe_index(mp, 0).x = 3
	unsafe_index(mp, 0) = make(P)
	testing.Println(mp[0].x) // 0
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
