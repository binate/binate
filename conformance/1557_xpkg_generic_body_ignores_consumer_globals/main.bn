package "main"

import "pkg/builtins/testing"
import "pkg/gq"

// A generic body written in another package resolves its names in that package:
// the consumer's own globals are not in scope there, so globals named like that
// package's generic functions (`Helper`, `Drop`) or like one of its imports
// (`gp`) shadow nothing in it — a call, a function value and a deferred call of
// a generic function, and a package-qualified generic call, all instantiate.

var gp int = 1
var Helper int = 2
var Drop int = 3

func main() {
	testing.Println(gq.Outer[int](10))
	testing.Println(gq.Bare[int](20))
	testing.Println(gq.Ref[int](30))
	testing.Println(gq.Def[int](40))
	testing.Println(gp, Helper, Drop)
}
