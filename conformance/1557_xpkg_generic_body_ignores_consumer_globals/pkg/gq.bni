package "pkg/gq"

import "pkg/gp"

func Helper[T any](x T) T { return x }

func Drop[T any](x T) {}

func Outer[T any](x T) T { return gp.Inner[T](x) }

func Bare[T any](x T) T { return Helper[T](x) }

func Ref[T any](x T) T {
	var f *func(T) T = Helper[T]
	return f(x)
}

func Def[T any](x T) T {
	defer Drop[T](x)
	return x
}
