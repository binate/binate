package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// The aggregate retype nests (§8.5): `cast` retypes a container of containers —
// an array of arrays, a slice of slices, an array of managed slices — when its
// innermost elements retype bit-preservingly, in place; the copy of an array of
// managed slices takes one reference per element.

func run() {
	var a [2][3]int8
	a[0][1] = -1
	a[1][2] = 5
	var u [2][3]uint8 = cast([2][3]uint8, a)
	testing.Println(cast(int, u[0][1]), cast(int, u[1][2])) // 255 5
	var b @[]@[]int8 = make_slice(@[]int8, 2)
	b[1] = make_slice(int8, 2)
	b[1][0] = -2
	var c @[]@[]uint8 = cast(@[]@[]uint8, b)
	testing.Println(cast(int, c[1][0]), len(c[0])) // 254 0
	c[1][1] = 200
	testing.Println(cast(int, b[1][1])) // -56
	var m [2]@[]int8
	m[0] = make_slice(int8, 1)
	m[0][0] = -3
	var n [2]@[]uint8 = cast([2]@[]uint8, m)
	m[0] = make_slice(int8, 1)
	testing.Println(cast(int, n[0][0]), len(n[1])) // 253 0
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base) // 0
}
