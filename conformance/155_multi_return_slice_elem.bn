package "main"

import "pkg/builtins/testing"

// Multi-return where one target is a slice element.

func compute() (int, int) {
	return 42, 99
}

func main() {
	var arr @[]int = make_slice(int, 3)
	var x int
	x, arr[0] = compute()
	testing.Println(x) // 42
	testing.Println(arr[0]) // 99

	arr[1], arr[2] = compute()
	testing.Println(arr[1]) // 42
	testing.Println(arr[2]) // 99
}
