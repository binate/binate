package "main"

import "pkg/builtins/testing"

// A method call or method value looks through ONE pointer level to the receiver's
// named type (func.method.auto-deref); it does not chase multi-level indirection,
// so through a `**T` or a `*@T` there is no method.

type St struct {
	n int
}

func (s St) Peek() int { return s.n }

func (s *St) Bump() { s.n = s.n + 1 }

func main() {
	var s St
	var p *St = &s
	var pp **St = &p
	var m @St = make(St)
	var pm *@St = &m
	testing.Println(pp.Peek())
	pm.Bump()
	var f *func() int = pp.Peek
	var g *func() = pm.Bump
	testing.Println(f())
	g()
}
