package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A generic type declaration may have any underlying type (gen.typeparams); an
// instantiation is a distinct named type over the underlying with the type
// arguments substituted (gen.instantiate.type): an array, a raw or managed
// pointer, a managed or raw slice, a function value, one that names itself
// through a slice, a struct (another generic's instantiation) — each with
// methods, an impl, boxing into `any` and its recovery, and use from a generic
// function; nothing leaks.

type Pair[T any] [2]T

func (p Pair[T]) First() T { return p[0] }

func (p *Pair[T]) Swap() {
	var t T = (*p)[0]
	(*p)[0] = (*p)[1]
	(*p)[1] = t
}

type Ptr[T any] *T

func (p Ptr[T]) Get() T { return *p }

type Owned[T any] @T

type List[T any] @[]T

func (l List[T]) Len() int { return len(l) }

interface Lener {
	Len() int
}

impl List[T] : Lener

type View[T any] *[]T

type Box[T any] struct {
	v T
}

type Wrap[T any] Box[T]

func (w Wrap[T]) Len() int { return 3 }

impl Wrap[T] : Lener

type Inner struct {
	s @[]char
}

type OwnL[T any] @T

func (o OwnL[T]) Len() int { return 7 }

impl OwnL[T] : Lener

type Less[T any] @func(T, T) bool

type Tree[T any] @[]Tree[T]

func lt(a int, b int) bool { return a < b }

func maxOf[T any](a T, b T, less Less[T]) T {
	if less(a, b) { return b }
	return a
}

func mk[T any](a T, b T) Pair[T] { return Pair[T]{a, b} }

func name(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func run() {
	var p Pair[@[]char] = mk[@[]char](name("a"), name("b"))
	p.Swap()
	testing.Println(p.First(), p[1])
	var x int = 7
	var q Ptr[int] = &x
	*q = 8
	testing.Println(x, q.Get())
	var o Owned[@[]char] = box(name("owned"))
	testing.Println(*o)
	var l List[@[]char] = make_slice(@[]char, 2)
	l[0] = name("x")
	var ln @Lener = box(l)
	testing.Println(l.Len(), ln.Len())
	var arr [3]int
	arr[1] = 4
	var v View[int] = arr[:]
	testing.Println(len(v), v[1])
	var t Tree[int] = make_slice(Tree[int], 2)
	t[1] = make_slice(Tree[int], 3)
	testing.Println(len(t), len(t[1]))
	testing.Println(maxOf[int](3, 9, lt))
	var pi Pair[int] = mk[int](5, 6)
	var a @any = box(pi)
	var back Pair[int] = a.(Pair[int])
	testing.Println(back.First(), back[1])
	var w Wrap[@[]char]
	w.v = name("wrap")
	var wl @Lener = box(w)
	var iv Inner
	iv.s = name("inner")
	var ow OwnL[Inner] = box(iv)
	var ol @Lener = box(ow)
	var none OwnL[Inner]
	ow = none
	testing.Println(wl.Len(), w.v, ol.Len())
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
