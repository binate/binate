package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/gt"

// Generic types of non-struct underlying types declared in another package's
// .bni — an array and a managed slice with methods and an impl, a function
// value, a struct (another generic's instantiation) with an impl — instantiated
// and used here (gen.instantiate.type, gen.crosspkg.body); nothing leaks.

func lt(a int, b int) bool { return a < b }

func name(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func run() {
	var p gt.Pair[int] = gt.MakePair[int](3, 8)
	testing.Println(p.First(), p[1], gt.Max[int](p, lt))
	var l gt.List[int] = make_slice(int, 4)
	l[3] = 6
	var ln @gt.Lener = box(l)
	testing.Println(l.Len(), ln.Len(), l[3])
	var w gt.Wrap[@[]char]
	w.V = name("wrap")
	var wl @gt.Lener = box(w)
	testing.Println(wl.Len(), w.V)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
