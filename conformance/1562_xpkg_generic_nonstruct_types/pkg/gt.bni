package "pkg/gt"

type Pair[T any] [2]T

func (p Pair[T]) First() T { return p[0] }

type List[T any] @[]T

func (l List[T]) Len() int { return len(l) }

interface Lener {
	Len() int
}

impl List[T] : Lener

type Less[T any] @func(T, T) bool

func MakePair[T any](a T, b T) Pair[T] { return Pair[T]{a, b} }

func Max[T any](p Pair[T], less Less[T]) T {
	if less(p[0], p[1]) { return p[1] }
	return p[0]
}

type Box[T any] struct {
	V T
}

type Wrap[T any] Box[T]

func (w Wrap[T]) Len() int { return 5 }

impl Wrap[T] : Lener
