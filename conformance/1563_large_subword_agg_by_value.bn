package "main"

import "pkg/builtins/testing"

// By-value aggregates larger than 16 bytes whose alignment is below a word — a
// byte array and a struct of bytes and an int16 — passed directly, through function
// values, an interface method and closures (as captures and as arguments), from
// storage that is not word-aligned: fields after a uint8, of a variable or of a
// returned struct (whose field the call may pass by address, at an odd offset).
// AAPCS32 passes them in r0-r3 and on the stack, and the words loaded for the
// registers must not fault on a strict-alignment target.

type B20 [20]uint8

type H struct {
	a uint8
	b int16
	c [17]uint8
}

type Holder struct {
	tag uint8
	bs  B20
	h   H
}

interface Scorer {
	score(b B20, h H) int
}

type Sc struct {
	w int
}

func (p *Sc) score(b B20, h H) int {
	return p.w + cast(int, b[1]) + cast(int, h.b)
}

impl *Sc : Scorer

func ends(b B20, k int) int {
	return cast(int, b[0]) * 100 + cast(int, b[19]) * 10 + k
}

func hsum(x int, h H) int {
	return x + cast(int, h.a) + cast(int, h.b) + cast(int, h.c[16])
}

func mkHolder() Holder {
	var r Holder
	r.tag = 1
	for i := 0; i < 20; i++ {
		r.bs[i] = cast(uint8, i + 1)
	}
	r.h.a = 3
	r.h.b = 300
	r.h.c[16] = 5
	return r
}

func main() {
	var r Holder = mkHolder()

	// Direct calls.
	testing.Println(ends(r.bs, 7))
	testing.Println(hsum(1000, r.h))

	// Function values.
	var fe *func(B20, int) int = ends
	testing.Println(fe(r.bs, 8))
	var fh *func(int, H) int = hsum
	testing.Println(fh(2000, r.h))

	// An interface method.
	var s Sc
	s.w = 50
	var sc *Scorer = &s
	testing.Println(sc.score(r.bs, r.h))

	// Closures capturing them after a uint8 capture, and taking one.
	var tag uint8 = 4
	var bs B20 = r.bs
	var cl *func(int) int = func(k int) int {
		return cast(int, tag) * 1000 + cast(int, bs[19]) * 10 + k
	}
	testing.Println(cl(6))
	var hh H = r.h
	var ch *func(B20) int = func(b B20) int {
		return cast(int, tag) + cast(int, hh.b) + cast(int, b[2])
	}
	testing.Println(ch(r.bs))

	// Fields of a returned struct, at offsets 1 and 22.
	testing.Println(ends(mkHolder().bs, 1))
	testing.Println(fe(mkHolder().bs, 9))
	testing.Println(fh(3000, mkHolder().h))
	testing.Println(sc.score(mkHolder().bs, mkHolder().h))
	testing.Println(ch(mkHolder().bs))
}
