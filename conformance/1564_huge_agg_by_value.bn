package "main"

import "pkg/builtins/testing"

// By-value aggregates larger than 4 KiB — past the 12-bit offset an arm32 load or
// store encodes — passed directly, through function values, an interface method and
// closures (as a capture and as an argument): a word array and a byte array, the
// latter less aligned than a word.  On arm32 every word past the first four travels
// on the stack (on x86-64 all of them do), so the copies address words far from
// their base.

type W [1100]int32

type B [5000]uint8

interface Summer {
	sumW(w W, k int) int
	sumB(b B) int
}

type S struct {
	base int
}

func (s *S) sumW(w W, k int) int {
	return s.base + cast(int, w[0]) + cast(int, w[1099]) + k
}

func (s *S) sumB(b B) int {
	return s.base + cast(int, b[0]) + cast(int, b[4999])
}

impl *S : Summer

func endsW(w W, k int) int {
	return cast(int, w[0]) * 1000 + cast(int, w[1099]) + k
}

func endsB(k int, b B) int {
	return k + cast(int, b[1]) * 100 + cast(int, b[4998])
}

func main() {
	var w W
	w[0] = 7
	w[1099] = 9
	var b B
	b[0] = 1
	b[1] = 2
	b[4998] = 3
	b[4999] = 4

	// Direct calls.
	testing.Println(endsW(w, 5))
	testing.Println(endsB(10, b))

	// Function values.
	var fw *func(W, int) int = endsW
	testing.Println(fw(w, 6))
	var fb *func(int, B) int = endsB
	testing.Println(fb(20, b))

	// An interface method.
	var s S
	s.base = 100
	var sm *Summer = &s
	testing.Println(sm.sumW(w, 1))
	testing.Println(sm.sumB(b))

	// Closures: one capturing the word array after a uint8, one also taking the byte
	// array.
	var tag uint8 = 3
	var cw *func(int) int = func(k int) int { return cast(int, tag) + cast(int, w[1099]) + k }
	testing.Println(cw(30))
	var cb *func(B) int = func(x B) int {
		return cast(int, tag) + cast(int, x[4999]) + cast(int, w[0])
	}
	testing.Println(cb(b))
}
