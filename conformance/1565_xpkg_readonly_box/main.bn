package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/rb"

// spec iface.assert.readonly across packages: a box of a READONLY object of a type
// declared in another package records the object's readonly whichever package
// makes the box and whichever asserts on it — the impl's package emits the
// readonly variant's vtables (only for its read-only-receiver impls) and the
// satisfaction entries the interface targets find.

func boxedHere() {
	var r readonly rb.T
	var x *any = &r
	testing.Println("here, rb.IsMut:", rb.IsMut(x), "rb.IsRo:", rb.IsRo(x), "rb.IsSetter:",
			rb.IsSetter(x))
	var ok bool
	_, ok = x.(*rb.T)
	testing.Println("here .(*rb.T):", ok)
	var g *rb.Getter
	g, ok = x.(*rb.Getter)
	testing.Println("here .(*rb.Getter):", ok, g.Get())
	var g2 *rb.Getter = &r
	testing.Println("here via Getter, rb.GetterIsMut:", rb.GetterIsMut(g2))
	_, ok = g2.(*rb.T)
	testing.Println("here via Getter .(*rb.T):", ok)

	var m rb.T
	var y *any = &m
	testing.Println("mutable, rb.IsMut:", rb.IsMut(y), "rb.IsRo:", rb.IsRo(y), "rb.IsSetter:",
			rb.IsSetter(y))
}

func boxedThere() {
	var base int = rt.LiveBlocks()
	if true {
		var a @any = rb.MakeRo(4)
		var ok bool
		_, ok = a.(@rb.T)
		testing.Println("there .(@rb.T):", ok)
		var r @readonly rb.T
		r, ok = a.(@readonly rb.T)
		testing.Println("there .(@readonly rb.T):", ok, r.Get())
		_, ok = a.(@rb.Getter)
		testing.Println("there .(@rb.Getter):", ok)
		_, ok = a.(@rb.Setter)
		testing.Println("there .(@rb.Setter):", ok)
	}
	testing.Println("there blocks released:", rt.LiveBlocks() == base)
}

func main() {
	boxedHere()
	boxedThere()
}
