package "pkg/rb"

type T struct {
	n int
}

interface Getter {
	Get() int
}

interface Setter {
	Set(v int)
}

func (t *readonly T) Get() int

func (t *T) Set(v int)

impl *readonly T : Getter

impl *T : Setter

// MakeRo returns a box of a read-only T holding n.
func MakeRo(n int) @any

// IsMut reports whether x recovers as a mutable *T.
func IsMut(x *any) bool

// IsRo reports whether x recovers as a *readonly T.
func IsRo(x *any) bool

// IsSetter reports whether x recovers as a *Setter.
func IsSetter(x *any) bool

// GetterIsMut reports whether g recovers as a mutable *T.
func GetterIsMut(g *Getter) bool
