package "pkg/rb"

func (t *readonly T) Get() int { return t.n }

func (t *T) Set(v int) { t.n = v }

func MakeRo(n int) @any {
	var m @T = make(T)
	m.n = n
	var r @readonly T = m
	return r
}

func IsMut(x *any) bool {
	var ok bool
	_, ok = x.(*T)
	return ok
}

func IsRo(x *any) bool {
	var ok bool
	_, ok = x.(*readonly T)
	return ok
}

func IsSetter(x *any) bool {
	var ok bool
	_, ok = x.(*Setter)
	return ok
}

func GetterIsMut(g *Getter) bool {
	var ok bool
	_, ok = g.(*T)
	return ok
}
