package "main"

import "pkg/builtins/testing"

// By-value arrays whose STACK part — the bytes past the core argument registers on
// arm32 — is past the sizes the native backends copy straight-line, in each shape that
// copies one: a direct call with 4, 3, 1 or 0 words in registers, a byte array (copied
// byte by byte), two in one call, the same through function values (whose shims find
// the array's address in a register or on the incoming stack) and an interface method,
// the func-value shims' result shapes (a struct returned through sret, a small one packed
// in a register, a multi-value result), closures capturing one (scalar, sret and packed
// results) or taking one after four captures, and a float64 ahead of one.

type W24 [24]int32

type B80 [80]uint8

type Big3 struct {
	a int
	b int
	c int
}

type S1 struct {
	v uint8
}

interface Taker {
	take(a int, b int, c int, d int, w W24) int
}

type T struct {
	base int
}

func (t *T) take(a int, b int, c int, d int, w W24) int {
	return t.base + a + b + c + d + sw(w) * 100
}

impl *T : Taker

func sw(w W24) int {
	var s int = 0
	for i := 0; i < 24; i++ {
		s = s + cast(int, w[i])
	}
	return s
}

func sb(b B80) int {
	var s int = 0
	for i := 0; i < 80; i++ {
		s = s + cast(int, b[i])
	}
	return s
}

func f2(a int, w W24) int { return a * 1000 + sw(w) }

func f3(a int, b int, c int, w W24) int { return a + b * 10 + c * 100 + sw(w) * 1000 }

func f4(a int, b int, c int, d int, w W24) int { return a + b + c + d + sw(w) * 100 }

func f5(a int, b B80) int { return a * 10000 + sb(b) }

func f6(w W24, b B80) int { return sw(w) * 10000 + sb(b) }

func g1(w W24) Big3 {
	var r Big3
	r.a = sw(w)
	r.b = cast(int, w[23])
	r.c = 7
	return r
}

func g2(w W24) S1 {
	var r S1
	r.v = cast(uint8, sw(w) % 256)
	return r
}

func g3(w W24) (int, int) { return sw(w), cast(int, w[0]) }

func hf(f float64, w W24) int { return cast(int, f) + sw(w) }

func main() {
	var w W24
	for i := 0; i < 24; i++ {
		w[i] = cast(int32, i * 2 + 1)
	}
	var b B80
	for i := 0; i < 80; i++ {
		b[i] = cast(uint8, i + 3)
	}

	// Direct calls.
	testing.Println(sw(w), f2(1, w), f3(1, 2, 3, w), f4(1, 2, 3, 4, w))
	testing.Println(f5(2, b), f6(w, b))

	// Function values and an interface method.
	var v1 *func(W24) int = sw
	var v2 *func(int, W24) int = f2
	var v3 *func(int, int, int, W24) int = f3
	var v4 *func(int, int, int, int, W24) int = f4
	var v5 *func(int, B80) int = f5
	var v6 *func(W24, B80) int = f6
	testing.Println(v1(w), v2(1, w), v3(1, 2, 3, w), v4(1, 2, 3, 4, w))
	testing.Println(v5(2, b), v6(w, b))
	var t T
	t.base = 5
	var tk *Taker = &t
	testing.Println(tk.take(1, 2, 3, 4, w))

	// The func-value shims' result shapes.
	var vg1 *func(W24) Big3 = g1
	var r Big3 = vg1(w)
	testing.Println(r.a, r.b, r.c)
	var vg2 *func(W24) S1 = g2
	testing.Println(cast(int, vg2(w).v))
	var vg3 *func(W24) (int, int) = g3
	x, y := vg3(w)
	testing.Println(x, y)

	// Closures capturing one (scalar, sret and packed results), and taking one after four
	// captures.
	var tag uint8 = 3
	var c1 *func() int = func() int { return cast(int, tag) + sw(w) }
	testing.Println(c1())
	var c2 *func() Big3 = func() Big3 {
		var q Big3
		q.a = sw(w) + cast(int, tag)
		return q
	}
	testing.Println(c2().a)
	var c3 *func() S1 = func() S1 {
		var q S1
		q.v = cast(uint8, sb(b) % 256 + cast(int, tag))
		return q
	}
	testing.Println(cast(int, c3().v))
	var k1 int = 10
	var k2 int = 20
	var k3 int = 30
	var c4 *func(W24) int = func(z W24) int { return cast(int, tag) + k1 + k2 + k3 + sw(z) }
	testing.Println(c4(w))

	// A float64 ahead of the array.
	var vh *func(float64, W24) int = hf
	testing.Println(hf(2.0, w), vh(2.0, w))
}
