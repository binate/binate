package "main"

import "pkg/builtins/testing"

// Arrays past the sizes the native backends copy straight-line, so their copies and
// zero-fills are loops, in each copying role: a zeroed local, an assignment (the copy is
// independent of its source), a direct call, a function value, a closure capture, a
// struct return and a multi-value return.  Word arrays of 17 and 1101 words (an odd count
// against any multi-word chunk) and byte arrays of 17 and 5001 bytes (copied byte by
// byte, as they may sit at any address).  The 17-element ones are just past the
// straight-line sizes for a whole copy or zero-fill, though not for the part of an
// argument past the registers (conformance 1566 covers those).

type W17 [17]int32

func fillW17() W17 {
	var a W17
	for i := 0; i < 17; i++ {
		a[i] = cast(int32, i * 3 + 1)
	}
	return a
}

func sumW17(a W17) int {
	var s int = 0
	for i := 0; i < 17; i++ {
		s = s + cast(int, a[i])
	}
	return s
}

func pairW17() (int, W17) {
	return 5, fillW17()
}

func checkW17() {
	var a W17 = fillW17()
	testing.Println(sumW17(a))
	var f *func(W17) int = sumW17
	testing.Println(f(a))
	var cl *func() int = func() int { return sumW17(a) + 1 }
	testing.Println(cl())
	var c W17 = a
	c[0] = 99
	testing.Println(sumW17(a), sumW17(c) - sumW17(a))
	var z W17
	testing.Println(sumW17(z))
	x, p := pairW17()
	testing.Println(x + sumW17(p))
}

type W1101 [1101]int32

func fillW1101() W1101 {
	var a W1101
	for i := 0; i < 1101; i++ {
		a[i] = cast(int32, i % 7 + 1)
	}
	return a
}

func sumW1101(a W1101) int {
	var s int = 0
	for i := 0; i < 1101; i++ {
		s = s + cast(int, a[i])
	}
	return s
}

func pairW1101() (int, W1101) {
	return 5, fillW1101()
}

func checkW1101() {
	var a W1101 = fillW1101()
	testing.Println(sumW1101(a))
	var f *func(W1101) int = sumW1101
	testing.Println(f(a))
	var cl *func() int = func() int { return sumW1101(a) + 1 }
	testing.Println(cl())
	var c W1101 = a
	c[0] = 99
	testing.Println(sumW1101(a), sumW1101(c) - sumW1101(a))
	var z W1101
	testing.Println(sumW1101(z))
	x, p := pairW1101()
	testing.Println(x + sumW1101(p))
}

type B17 [17]uint8

func fillB17() B17 {
	var a B17
	for i := 0; i < 17; i++ {
		a[i] = cast(uint8, i + 1)
	}
	return a
}

func sumB17(a B17) int {
	var s int = 0
	for i := 0; i < 17; i++ {
		s = s + cast(int, a[i])
	}
	return s
}

func pairB17() (int, B17) {
	return 5, fillB17()
}

func checkB17() {
	var a B17 = fillB17()
	testing.Println(sumB17(a))
	var f *func(B17) int = sumB17
	testing.Println(f(a))
	var cl *func() int = func() int { return sumB17(a) + 1 }
	testing.Println(cl())
	var c B17 = a
	c[0] = 99
	testing.Println(sumB17(a), sumB17(c) - sumB17(a))
	var z B17
	testing.Println(sumB17(z))
	x, p := pairB17()
	testing.Println(x + sumB17(p))
}

type B5001 [5001]uint8

func fillB5001() B5001 {
	var a B5001
	for i := 0; i < 5001; i++ {
		a[i] = cast(uint8, (i * 7) % 251)
	}
	return a
}

func sumB5001(a B5001) int {
	var s int = 0
	for i := 0; i < 5001; i++ {
		s = s + cast(int, a[i])
	}
	return s
}

func pairB5001() (int, B5001) {
	return 5, fillB5001()
}

func checkB5001() {
	var a B5001 = fillB5001()
	testing.Println(sumB5001(a))
	var f *func(B5001) int = sumB5001
	testing.Println(f(a))
	var cl *func() int = func() int { return sumB5001(a) + 1 }
	testing.Println(cl())
	var c B5001 = a
	c[0] = 99
	testing.Println(sumB5001(a), sumB5001(c) - sumB5001(a))
	var z B5001
	testing.Println(sumB5001(z))
	x, p := pairB5001()
	testing.Println(x + sumB5001(p))
}

func main() {
	checkW17()
	checkW1101()
	checkB17()
	checkB5001()
}
