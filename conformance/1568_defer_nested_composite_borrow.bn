package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A value-borrow inside a composite-literal element of a deferred call's argument
// (iface.construct.value-borrow; stmt.defer evaluates the arguments when the defer
// statement runs) must live until the deferred call runs, also when the defer
// statement is in a nested block: the temporary holding `mkW(3)` / `mkHold(4).w`
// must not be released when the `if` block ends.  Covered wherever the literal
// sits in the operand: a direct argument, `box` of it, a selector base, behind
// `&`, nested in another literal, a variadic element, and an argument boxed into
// `*any` itself.  A variadic `*Getter` pack (the elements are the operand's own
// borrows) is the control.

interface Getter {
	Get() int
}

type Inner struct { v int }

type W struct { p @Inner }

func (w W) Get() int { return w.p.v + 1000 }

impl W : Getter

type Hold struct { w W }

type Outer struct {
	o Opts
	n int
}

type Opts struct { g *Getter }

func mkW(k int) W {
	var w W
	w.p = make(Inner)
	w.p.v = k
	return w
}

func mkHold(k int) Hold {
	var h Hold
	h.w = mkW(k)
	return h
}

func churn() int {
	var a Hold = mkHold(77)
	var b Hold = mkHold(78)
	return a.w.p.v + b.w.p.v
}

func takeOpts(tag int, o Opts) {
	churn()
	testing.Println("deferred", tag, o.g.Get())
}

func topDirect() {
	defer takeOpts(1, Opts{g: mkW(1)})
	churn()
}

func topField() {
	defer takeOpts(2, Opts{g: mkHold(2).w})
	churn()
}

func nestedDirect(c bool) {
	if c {
		defer takeOpts(3, Opts{g: mkW(3)})
	}
	churn()
}

func nestedField(c bool) {
	if c {
		defer takeOpts(4, Opts{g: mkHold(4).w})
	}
	churn()
}

func takeG(tag int, g *Getter) {
	churn()
	testing.Println("g", tag, g.Get())
}

func takeBoxed(tag int, o @Opts) {
	churn()
	testing.Println("boxed", tag, o.g.Get())
}

func takeAll(tag int, gs ...*Getter) {
	churn()
	testing.Println("all", tag, gs[0].Get(), gs[1].Get())
}

func takeOptsVar(tag int, os ...Opts) {
	churn()
	testing.Println("optsvar", tag, os[0].g.Get(), os[1].g.Get())
}

func takeOuter(tag int, o Outer) {
	churn()
	testing.Println("outer", tag, o.o.g.Get())
}

func takePtr(tag int, o *Opts) {
	churn()
	testing.Println("ptr", tag, o.g.Get())
}

func takeAny(tag int, x *any) {
	churn()
	var o Opts
	var ok bool
	o, ok = x.(Opts)
	testing.Println("any", tag, ok, o.g.Get())
}

func nestedShapes(c bool) {
	if c {
		defer takeBoxed(6, box(Opts{g: mkW(6)}))
		defer takeG(7, Opts{g: mkW(7)}.g)
		defer takeAll(10, mkW(10), mkW(11))
		defer takeOptsVar(12, Opts{g: mkW(12)}, Opts{g: mkW(13)})
		defer takeOuter(14, Outer{n: 1, o: Opts{g: mkW(14)}})
		defer takePtr(15, &Opts{g: mkW(15)})
		defer takeAny(16, Opts{g: mkW(16)})
	}
	churn()
}

func run() {
	topDirect()
	topField()
	nestedDirect(true)
	nestedField(true)
	nestedShapes(true)
}

func main() {
	// The bytecode VM builds some state lazily on first use, so the release check
	// measures a second, identical run.
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println("blocks released:", rt.LiveBlocks() == base)
}
