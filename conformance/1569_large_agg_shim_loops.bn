package "main"

import "pkg/builtins/testing"

// By-value arrays past the size the native backends copy straight-line on x86-64 and
// aarch64 (128 bytes), through every function-value and closure shim shape that copies
// one: a word array and a byte array taken by function values with a scalar, an sret, a
// packed and a multi-value result, and after a float64; an interface method; closures
// that capture one and take one, returning a scalar, a struct through sret and a packed
// struct, with and without a float64 parameter.  Also a 201-byte array at an odd offset
// between other fields: a struct return into it, a store into it and a load out of it
// copy exactly its bytes, leaving the fields beside it intact.

type W40 [40]int32

type B201 [201]uint8

type Pad struct {
	h uint8
	b B201
	t uint8
	u int16
}

type B200 [200]uint8

type Big3 struct {
	a int
	b int
	c int
}

type S1 struct {
	v uint8
}

interface Taker {
	take(a int, w W40, b B200) int
}

type T struct {
	base int
}

func (t *T) take(a int, w W40, b B200) int {
	return t.base + a + sw(w) * 100 + sb(b)
}

impl *T : Taker

func sw(w W40) int {
	var s int = 0
	for i := 0; i < 40; i++ {
		s = s + cast(int, w[i])
	}
	return s
}

func sb(b B200) int {
	var s int = 0
	for i := 0; i < 200; i++ {
		s = s + cast(int, b[i])
	}
	return s
}

func f1(a int, w W40, b B200) int { return a + sw(w) * 10 + sb(b) * 100000 }

func g1(w W40, b B200) Big3 {
	var r Big3
	r.a = sw(w)
	r.b = sb(b)
	r.c = cast(int, w[39]) + cast(int, b[199])
	return r
}

func g2(b B200) S1 {
	var r S1
	r.v = cast(uint8, sb(b) % 251)
	return r
}

func g3(w W40) (int, int) { return sw(w), cast(int, w[39]) }

func mk201(k int) B201 {
	var x B201
	for i := 0; i < 201; i++ {
		x[i] = cast(uint8, i + k)
	}
	return x
}

func s201(x B201) int {
	var s int = 0
	for i := 0; i < 201; i++ {
		s = s + cast(int, x[i])
	}
	return s
}

func hf(f float64, w W40, g float64, b B200) int {
	return cast(int, f) + sw(w) + cast(int, g) * 1000 + sb(b)
}

func main() {
	var w W40
	for i := 0; i < 40; i++ {
		w[i] = cast(int32, i * 3 + 1)
	}
	var b B200
	for i := 0; i < 200; i++ {
		b[i] = cast(uint8, i + 5)
	}

	// Function values: scalar, sret, packed and multi-value results, and floats ahead of
	// and between the arrays.
	var v1 *func(int, W40, B200) int = f1
	testing.Println(f1(7, w, b), v1(7, w, b))
	var vg1 *func(W40, B200) Big3 = g1
	var r Big3 = vg1(w, b)
	testing.Println(r.a, r.b, r.c)
	var vg2 *func(B200) S1 = g2
	testing.Println(cast(int, vg2(b).v))
	var vg3 *func(W40) (int, int) = g3
	x, y := vg3(w)
	testing.Println(x, y)
	var vh *func(float64, W40, float64, B200) int = hf
	testing.Println(hf(2.0, w, 3.0, b), vh(2.0, w, 3.0, b))

	// An interface method.
	var t T
	t.base = 9
	var tk *Taker = &t
	testing.Println(tk.take(1, w, b))

	// Closures capturing the arrays and taking them, with scalar, sret and packed
	// results.
	var tag uint8 = 4
	var c1 *func(B200) int = func(z B200) int { return cast(int, tag) + sw(w) + sb(z) * 10 }
	testing.Println(c1(b))
	var c2 *func(W40) Big3 = func(z W40) Big3 {
		var q Big3
		q.a = sw(w) + cast(int, tag)
		q.b = sw(z) * 2
		q.c = sb(b)
		return q
	}
	var q Big3 = c2(w)
	testing.Println(q.a, q.b, q.c)
	var c3 *func(W40) S1 = func(z W40) S1 {
		var p S1
		p.v = cast(uint8, (sb(b) + sw(z)) % 251 + cast(int, tag))
		return p
	}
	testing.Println(cast(int, c3(w).v))

	// The same with float64 parameters.
	var c4 *func(float64, B200) int = func(f float64, z B200) int {
		return cast(int, f) + sw(w) + sb(z) * 10 + cast(int, tag)
	}
	testing.Println(c4(6.0, b))
	var c5 *func(float64, W40) Big3 = func(f float64, z W40) Big3 {
		var p Big3
		p.a = cast(int, f) + sw(w)
		p.b = sw(z) + cast(int, tag)
		p.c = sb(b)
		return p
	}
	var p Big3 = c5(8.0, w)
	testing.Println(p.a, p.b, p.c)

	// A 201-byte array between fields.
	var pd Pad
	pd.h = 11
	pd.t = 22
	pd.u = 333
	pd.b = mk201(1)
	testing.Println(cast(int, pd.h), cast(int, pd.t), cast(int, pd.u), s201(pd.b))
	var nb B201 = mk201(2)
	pd.b = nb
	var cp B201 = pd.b
	testing.Println(cast(int, pd.h), cast(int, pd.t), cast(int, pd.u), s201(pd.b), s201(cp))
}
