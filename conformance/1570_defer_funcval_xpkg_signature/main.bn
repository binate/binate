package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/qa"

// A deferred function-value call whose signature names another package's types
// — an opaque type, passed managed and returned (the discarded result is
// released after the call), and a generic interface instance passed managed for
// a raw parameter (retained until the call runs) — binds and releases them as a
// direct call does.

var seen int

func clobber() {
	for j := 0; j < 4; j++ {
		var a @[]int = make_slice(int, 8)
		a[0] = 99
		_ = a
	}
}

func run() {
	var fo @func(@qa.Opq) @qa.Opq = func(o @qa.Opq) @qa.Opq {
		seen = seen * 100 + qa.OpqN(o)
		return o
	}
	var fh @func(*qa.Holder[int]) = func(h *qa.Holder[int]) { seen = seen * 100 + h.Get() }
	defer fo(qa.MkOpq(21))
	defer fh(qa.MkThing(22))
	clobber()
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	// The leak is measured before anything is printed: the first print can
	// allocate state that lives to program exit.
	run()
	seen = 0
	var live int = rt.LiveBlocks()
	run()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(seen, leaked)
}
