package "pkg/qa"

// Opq is opaque to importers: they hold it only through pointers.
type Opq

interface Holder[T any] {
	Get() T
}

type Thing struct {
	n   int
	pad [6]int
}

impl *Thing : Holder[int]

func (t *Thing) Get() int

func MkOpq(n int) @Opq

func OpqN(o *Opq) int

func MkThing(n int) @Holder[int]
