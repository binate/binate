package "pkg/qa"

type Opq struct {
	n int
	s @[]int
}

func (t *Thing) Get() int { return t.n }

func MkOpq(n int) @Opq {
	var o @Opq = make(Opq)
	o.n = n
	o.s = make_slice(int, 1)
	return o
}

func OpqN(o *Opq) int { return o.n }

func MkThing(n int) @Holder[int] {
	var t @Thing = make(Thing)
	t.n = n
	return t
}
