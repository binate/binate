package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A value-borrow nested in a deferred call's operand (iface.construct.value-borrow;
// stmt.defer) lives until the deferred call runs, wherever the operand sits: a
// method receiver, an interface receiver, a function-value callee, an argument.
// The borrows are stored in the order the operands are evaluated — a struct
// literal's elements in field order even when keyed in another order, an array
// literal's in source order even when indexed — so slots of different types
// (`W`, `@[]char`) must line up.  An addressable source is taken when the defer
// statement runs, not after a later assignment; a defer not reached stores
// nothing.  Every block is released.

interface Getter {
	Get() int
	Show(tag int)
}

type Inner struct { v int }

type W struct { p @Inner }

func (w W) Get() int { return w.p.v }

func (w W) Show(tag int) { churn(); testing.Println("show", tag, w.p.v) }

impl W : Getter

type Opts struct { g *Getter }

func (o Opts) Run(tag int) { churn(); testing.Println("run", tag, o.g.Get()) }

type P struct {
	a *any
	b *any
}

type Holder struct {
	f *func(int, *any)
	g *Getter
}

func mkW(k int) W {
	var w W
	w.p = make(Inner)
	w.p.v = k
	return w
}

func mkS(n int) @[]char { return make_slice(char, n) }

func desc(x *any) int {
	var w W
	var ok bool
	w, ok = x.(W)
	if ok { return w.p.v }
	var s @[]char
	s, ok = x.(@[]char)
	if ok { return 500 + len(s) }
	return -1
}

func churn() int {
	var a W = mkW(77)
	var b @[]char = mkS(9)
	return a.p.v + len(b)
}

func takeP(tag int, p P) { churn(); testing.Println("p", tag, desc(p.a), desc(p.b)) }

func takeArr(tag int, a [2]*any) { churn(); testing.Println("arr", tag, desc(a[0]), desc(a[1])) }

func takeMS(tag int, a @[]*any) { churn(); testing.Println("ms", tag, desc(a[0]), desc(a[1])) }

func takeV(tag int, xs ...*any) {
	churn()
	testing.Println("v", tag, len(xs), desc(xs[0]), desc(xs[1]))
}

func takeAny(tag int, x *any) { churn(); testing.Println("any", tag, desc(x)) }

func gtake[T any](tag int, x T, p P) { churn(); testing.Println("gen", tag, desc(p.a), desc(p.b)) }

func shapes(c bool) {
	var w W = mkW(30)
	var s @[]char = mkS(3)
	if c {
		defer Opts{g: w}.Run(20)
		defer Opts{g: w}.g.Show(21)
		defer Holder{f: takeAny, g: w}.f(22, mkS(22))
		defer takeP(23, P{b: mkS(23), a: mkW(23)})
		defer takeArr(24, [2]*any{1: mkS(24), 0: mkW(24)})
		defer takeMS(25, @[]*any{mkW(25), mkS(25)})
		defer takeV(26, @[]*any{w, s}...)
		defer takeP(27, P{a: w, b: s})
		defer gtake[int](28, 5, P{b: mkS(28), a: mkW(28)})
		defer takeV(29, P{a: mkW(29), b: s}.a, mkS(29))
	}
	w = mkW(31)
	s = mkS(7)
	churn()
}

func run() {
	shapes(true)
	shapes(false)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println("blocks released:", rt.LiveBlocks() == base)
}
