package "main"

import "pkg/builtins/testing"

// A value-borrow nested in `defer panic(msg)`'s operand (`M{g: w, ...}.s`, the
// literal's interface field borrowing w) is stored with the deferred call's other
// operands: the program prints, then the deferred panic reports its message.

interface Getter {
	Get() int
}

type Inner struct { v int }

type W struct { p @Inner }

func (w W) Get() int { return w.p.v }

impl W : Getter

type M struct {
	g *Getter
	s *[]readonly char
}

func mkW(k int) W {
	var w W
	w.p = make(Inner)
	w.p.v = k
	return w
}

func f() {
	var w W = mkW(1)
	defer panic(M{g: w, s: "boom"}.s)
	testing.Println("in f")
}

func main() { f() }
