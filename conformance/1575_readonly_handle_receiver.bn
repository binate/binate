package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A method or impl receiver's handle may be read-only — `readonly *T`,
// `readonly @T`, `readonly *readonly T`, on a generic type too
// (func.method.receiver-kinds).  That is the receiver parameter's own property:
// the method cannot reassign it, and nothing else changes — the method's kind is
// still `*T` / `@T` (or `*readonly T`), so it is called, and dispatched through
// an interface, as one of those is, and writes through the handle to the object.

type Jar struct {
	n int
}

func (j readonly *Jar) Get() int { return j.n }

func (j readonly *Jar) Bump() { j.n = j.n + 1 }

func (j readonly *readonly Jar) Peek() int { return j.n * 100 }

type Box struct {
	n    int
	name @[]char
}

func (b readonly @Box) Get() int { return b.n }

func (b readonly @Box) Bump() { b.n = b.n + 10 }

type Cell[T any] struct {
	v T
}

func (c readonly *Cell[T]) Load() T { return c.v }

func (c readonly *Cell[T]) Store(v T) { c.v = v }

interface Getter {
	Get() int
}

interface Bumper {
	Bump()
}

impl readonly *Jar : Getter, Bumper

impl readonly @Box : Getter, Bumper

func run() {
	var j Jar = Jar{n: 1}
	var p *Jar = &j
	p.Bump()
	testing.Println(p.Get(), j.n, p.Peek())
	var g *Getter = p
	var u *Bumper = p
	u.Bump()
	testing.Println(g.Get(), j.n)
	var ro *readonly Jar = p
	testing.Println(ro.Peek())
	var b @Box = make(Box)
	b.n = 5
	b.name = "box"
	b.Bump()
	var bg @Getter = b
	var bu @Bumper = b
	bu.Bump()
	testing.Println(b.Get(), bg.Get(), b.name)
	var c Cell[int] = Cell[int]{v: 7}
	var cp *Cell[int] = &c
	cp.Store(cp.Load() + 1)
	testing.Println(c.v)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
