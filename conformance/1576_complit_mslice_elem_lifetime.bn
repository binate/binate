package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An element of a managed-slice literal is part of the literal
// (expr.composite.lifetime): addressed in a `var` / `:=` initializer — by `&`, by
// the implicit `&` of a pointer-receiver method value, or by an implicit
// value-borrow into a raw interface — the literal, whose one reference owns its
// backing, lives as long as the binding, and is released when the binding's scope
// exits, so later allocations do not reuse the backing — and nothing leaks.  So
// does the literal holding the reference to a managed-slice literal's backing: an
// element of an inner literal, of a field or element initialized by one, or of a
// sub-slice of one — in a generic body too, and in a defer, where the literal
// lives until the deferred call has run.

type P struct {
	n    int
	name @[]char
}

func (p *P) Name() @[]char { return p.name }

type Q struct {
	n int
	s @[]int
}

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

// churn allocates and frees managed slices the size of the literals' backings,
// so a backing released early would be reused and overwritten.
func churn() {
	for i := 0; i < 8; i++ {
		var a @[]int = @[]int{-1, -1}
		var b @[]P = @[]P{P{n: -1, name: mk("################")}}
		_ = a
		_ = b
	}
}

func showI(p *int) { testing.Println("deferred", *p) }

func second[T any](a T, b T) T {
	var p *T = &@[]T{a, b}[1:][0]
	churn()
	return *p
}

func run() {
	defer showI(&Q{n: 2, s: @[]int{30, 31}}.s[1])
	defer showI(&@[]int{32, 33}[1:][0])
	var e *int = &@[]int{1, 2}[0]
	f := &@[]int{3, 4}[1]
	var q *P = &@[]P{P{n: 5, name: mk("elem")}}[0]
	h := @[]P{P{n: 6, name: mk("method-value")}}[0].Name
	var iv *any = @[]int{7, 8}[1]
	var nm *@[]char = &@[]P{P{n: 9, name: mk("field")}}[0].name
	var inner *int = &@[]@[]int{@[]int{20, 21}}[0][1]
	var fld *int = &Q{n: 1, s: @[]int{22, 23}}.s[1]
	var sub *int = &@[]int{24, 25, 26}[1:][1]
	var arr *int = &[1]@[]int{@[]int{27}}[0][0]
	for i := 0; i < 2; i++ {
		var lp *int = &@[]int{i + 10, 0}[0]
		churn()
		testing.Println(*lp)
	}
	churn()
	testing.Println(*e, *f, q.n, q.name, h(), *nm)
	testing.Println(*inner, *fld, *sub, *arr)
	var k2 int = *&@[]int{34, 35}[1:][0]
	testing.Println(k2, second[int](36, 37), second[@[]char](mk("a"), mk("gen")))
	switch v := iv.(type) {
	case int:
		testing.Println(v)
	}
	// Outside a var initializer the literal is a statement temporary, its
	// element's address used within the statement.
	var k int
	k = *&@[]int{11, 12}[1]
	testing.Println(k)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
