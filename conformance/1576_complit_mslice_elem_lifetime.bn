package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An element of a managed-slice literal is part of the literal
// (expr.composite.lifetime): addressed in a `var` / `:=` initializer — by `&`, by
// the implicit `&` of a pointer-receiver method value, or by an implicit
// value-borrow into a raw interface — the literal, whose one reference owns its
// backing, lives as long as the binding, and is released when the binding's scope
// exits, so later allocations do not reuse the backing — and nothing leaks.

type P struct {
	n    int
	name @[]char
}

func (p *P) Name() @[]char { return p.name }

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

// churn allocates and frees managed slices the size of the literals' backings,
// so a backing released early would be reused and overwritten.
func churn() {
	for i := 0; i < 8; i++ {
		var a @[]int = @[]int{-1, -1}
		var b @[]P = @[]P{P{n: -1, name: mk("################")}}
		_ = a
		_ = b
	}
}

func run() {
	var e *int = &@[]int{1, 2}[0]
	f := &@[]int{3, 4}[1]
	var q *P = &@[]P{P{n: 5, name: mk("elem")}}[0]
	h := @[]P{P{n: 6, name: mk("method-value")}}[0].Name
	var iv *any = @[]int{7, 8}[1]
	var nm *@[]char = &@[]P{P{n: 9, name: mk("field")}}[0].name
	for i := 0; i < 2; i++ {
		var lp *int = &@[]int{i + 10, 0}[0]
		churn()
		testing.Println(*lp)
	}
	churn()
	testing.Println(*e, *f, q.n, q.name, h(), *nm)
	switch v := iv.(type) {
	case int:
		testing.Println(v)
	}
	// Outside a var initializer the literal is a statement temporary, its
	// element's address used within the statement.
	var k int
	k = *&@[]int{11, 12}[1]
	testing.Println(k)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
