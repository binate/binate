package "main"

import "pkg/builtins/testing"

// The address of an element of a managed-slice literal may not be stored past
// the end of its statement (expr.composite.addr-store): the element is part of
// the literal, released when the statement ends.  An assignment (to a variable,
// a field or an element), a `return`, or a package-level initializer may not
// store it — directly, through a field of the element, or by a value-borrow
// into a raw interface.

type P struct {
	n int
}

type S struct {
	p  *int
	iv *any
}

var g *int

var gp *int = &@[]int{1}[0]

func ret() *int { return &@[]int{2}[0] }

func main() {
	var s S
	var a [1]*int
	var pp *P
	g = &@[]int{3}[0]
	s.p = &@[]int{4}[0]
	a[0] = &@[]int{5}[0]
	pp = &@[]P{P{n: 6}}[0]
	s.p = &@[]P{P{n: 7}}[0].n
	s.iv = @[]int{8}[0]
	testing.Println(*g, *s.p, *a[0], pp.n, *gp, *ret())
}
