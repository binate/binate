package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A generic alias names its target, with the type arguments substituted; it
// does not define a type (gen.instantiate.alias).  `L[int]` is `Box[int]`: each
// is assignable to the other, a pointer to one is a pointer to the other, and
// the target's methods and impls are the alias's.  The target may be any type —
// another generic's instantiation (its arguments reordered, some fixed, or
// itself through an alias), a managed slice, a struct literal — and an alias may
// be used in a generic function's signature.  A defined generic type may refer to
// itself through an alias of it.  Nothing leaks.

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() T { return b.v }

interface Getter[T any] {
	Get() T
}

impl *Box[T] : Getter[T]

type Pair[A any, B any] struct {
	a A
	b B
}

type L[T any] = Box[T]

type LL[T any] = L[T]

type Sl[T any] = @[]T

type IntPair[B any] = Pair[int, B]

type Flip[A any, B any] = Pair[B, A]

type Anon[T any] = struct {
	x T
	y int64
}

type Node[T any] struct {
	v    T
	next @NodeRef[T]
}

type NodeRef[T any] = Node[T]

func id(b Box[int]) Box[int] { return b }

func get[T any](b *L[T]) T { return b.Get() }

func sum(s Sl[int]) int {
	var t int = 0
	for i := 0; i < len(s); i++ {
		t = t + s[i]
	}
	return t
}

func name(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func run() {
	var x L[int] = Box[int]{v: 1}
	var y Box[int] = x
	var p *L[int] = &y
	testing.Println(p.Get(), id(x).v, get[int](p))
	var z = L[int]{v: 3}
	var g *Getter[int] = &z
	testing.Println(g.Get())
	var w LL[@[]char] = Box[@[]char]{v: name("ll")}
	testing.Println(w.Get())
	var s Sl[int] = @[]int{4, 5}
	var t @[]int = s
	testing.Println(len(t), sum(t), sum(@[]int{6}))
	var ip IntPair[bool] = Pair[int, bool]{a: 7, b: true}
	testing.Println(ip.a, ip.b)
	var f Flip[int, @[]char] = Pair[@[]char, int]{a: name("flip"), b: 8}
	testing.Println(f.a, f.b)
	var an Anon[int8] = Anon[int8]{x: 9, y: 10}
	var st struct {
		x int8
		y int64
	} = an
	testing.Println(st.x, st.y)
	var n @Node[int] = make(Node[int])
	n.v = 11
	n.next = make(NodeRef[int])
	n.next.v = 12
	testing.Println(n.v, n.next.v)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
