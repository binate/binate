package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/ga"

// A generic alias declared in another package's .bni names its target there:
// `ga.L[int]` is `ga.Box[int]`, with its methods, and `ga.Sl[int]` is `@[]int`
// (gen.instantiate.alias, gen.crosspkg.body).  Nothing leaks.

func run() {
	var x ga.L[int] = ga.Box[int]{V: 1}
	var y ga.Box[int] = ga.Make[int](2)
	var p *ga.L[int] = &y
	testing.Println(x.Get(), p.Get(), ga.Make[int](3).V)
	var s ga.Sl[@[]int] = @[]@[]int{@[]int{4}, @[]int{5, 6}}
	var t @[]@[]int = s
	testing.Println(ga.Len[@[]int](s), len(t[1]))
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
