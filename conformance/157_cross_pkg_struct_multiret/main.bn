package "main"
import "pkg/builtins/testing"

import "pkg/counter"

func main() {
	// Exported struct type in a cross-package multi-return position.
	var c counter.Counter = counter.New()
	var prev1 int
	c, prev1 = counter.Bump(c, 5)
	testing.Println(prev1)  // 0

	var prev2 int
	c, prev2 = counter.Bump(c, 7)
	testing.Println(prev2)  // 5

	testing.Println(counter.Read(c))  // 12

	// Exported function whose body uses a non-exported struct type.
	var prev3 int = counter.InternalBump(100, 3)
	testing.Println(prev3)  // 100
}
