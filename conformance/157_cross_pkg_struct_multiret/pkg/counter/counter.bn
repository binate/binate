package "pkg/counter"

// Counter is the package's exported struct type. It exists to be referenced
// from another package via a multi-return signature.
type Counter struct {
	Val int
}

// internalCounter is package-internal (lowercase). It's used by an exported
// function below to exercise a public entry point whose body operates on a
// non-exported struct type.
type internalCounter struct {
	Val int
}

// New returns a fresh Counter at zero.
func New() Counter {
	var c Counter
	c.Val = 0
	return c
}

// Bump adds n to c and returns (newCounter, oldVal). Exercises a
// (struct, int) multi-return across packages.
func Bump(c Counter, n int) (Counter, int) {
	var prev int = c.Val
	c.Val = c.Val + n
	return c, prev
}

// Read returns the counter's current value.
func Read(c Counter) int {
	return c.Val
}

// internalBump operates on the non-exported internalCounter. Multi-returns
// (internalCounter, int) — exercises a non-exported struct type appearing
// in a multi-return position within the same package.
func internalBump(ic internalCounter, n int) (internalCounter, int) {
	var prev int = ic.Val
	ic.Val = ic.Val + n
	return ic, prev
}

// InternalBump is an exported entry point whose body uses the non-exported
// internalCounter type. The caller never sees internalCounter directly, but
// the package still needs to compile and link a function whose locals and
// helper calls reference an internal struct type.
func InternalBump(start int, n int) int {
	var ic internalCounter
	ic.Val = start
	var prev int
	ic, prev = internalBump(ic, n)
	return prev
}
