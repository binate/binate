package "pkg/strtab"

import "pkg/buf"

type Tab struct {
	Buf buf.CharBuf
}

// InternalTab is NOT in the .bni — it's package-internal.
type InternalTab struct {
	Buf buf.CharBuf
}

func New() Tab {
	var t Tab
	t.Buf = buf.New()
	t.Buf = buf.WriteByte(t.Buf, 0)
	return t
}

func Add(t Tab, s *[]const char) (Tab, int) {
	var offset int = t.Buf.Len()
	t.Buf = buf.WriteStr(t.Buf, s)
	t.Buf = buf.WriteByte(t.Buf, 0)
	return t, offset
}

func Len(t Tab) int {
	return t.Buf.Len()
}

// internalAdd uses InternalTab (not exported) for string building.
func internalAdd(it InternalTab, s *[]const char) (InternalTab, int) {
	var offset int = it.Buf.Len()
	it.Buf = buf.WriteStr(it.Buf, s)
	it.Buf = buf.WriteByte(it.Buf, 0)
	return it, offset
}

func InternalAdd(s *[]const char) int {
	var it InternalTab
	it.Buf = buf.New()
	it.Buf = buf.WriteByte(it.Buf, 0)
	var off int
	it, off = internalAdd(it, s)
	return off
}
