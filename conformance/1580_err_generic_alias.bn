package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// A generic alias that reaches itself with no defined type in between is an
// invalid recursive alias; one is instantiated with as many arguments as it has
// type parameters, each satisfying its constraint; and it is no method or impl
// receiver, which binds the parameters of a type it defines.  A generic type
// declaration needs its underlying type (an opaque type is non-generic).

type Box[T any] struct {
	v T
}

type R[T any] = @[]R[T]

type A[T any] = B[T]

type B[T any] = A[T]

type S[T any] = struct {
	n @S[T]
}

type O[T lang.Orderable] = Box[T]

type L[T any] = Box[T]

func (l *L[T]) Get() T { return l.v }

interface Getter[T any] {
	Get() T
}

impl *L[T] : Getter[T]

type Opq[T any]

type W struct {
	f int
}

func main() {
	var r R[int]
	var a A[int]
	var s S[int]
	var o O[W]
	var l Box[int, int]
	testing.Println(len(r), a, s, o, l)
}
