package "main"

import "pkg/builtins/testing"
import "pkg/gb"

// A generic type declared in a .bni with no underlying type is rejected: an
// importer instantiates a generic type from its definition, which it never has
// for an opaque one, so an opaque type is non-generic — the package exports
// `type H` (defined in its .bn as `type H Opq[int]`) instead.

func main() {
	var h *gb.H
	testing.Println(h == nil)
}
