package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// `box` of a composite literal of a named type boxes a value of that type
// (builtin.box): the box records the declared type as its dynamic type, so a
// type switch or assertion on the named type matches — a named array, a named
// type over a struct, a generic one, one holding managed elements — and nothing
// leaks.

type PairN [2]int

type Names [2]@[]char

type S struct {
	n int
}

type W S

type GP[T any] [2]T

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func kind(a *any) {
	switch v := a.(type) {
	case PairN:
		testing.Println("PairN", v[1])
	case Names:
		testing.Println("Names", v[0], v[1])
	case W:
		testing.Println("W", v.n)
	case S:
		testing.Println("S", v.n)
	case GP[int]:
		testing.Println("GP[int]", v[1])
	default:
		testing.Println("other")
	}
}

func run() {
	var a @any = box(PairN{1, 2})
	kind(a)
	var b @any = box([2]int{3, 4})
	kind(b)
	var c @any = box(W{n: 5})
	kind(c)
	var s @any = box(S{n: 6})
	kind(s)
	var d @any = box(GP[int]{7, 8})
	kind(d)
	var n @any = box(Names{mk("x"), mk("y")})
	kind(n)
	var p PairN = a.(PairN)
	var w W = c.(W)
	testing.Println(p[0], w.n)
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
