package "main"

import "pkg/builtins/lang"
import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A generic-receiver impl of an interface whose methods name `Self` is
// satisfied by methods that take or return the receiver's own instantiation
// (gen.impl.generic-recv): `Self` is `IdS[T]` for `impl IdS[T]`, checked once
// abstractly and per instance.  So a generic type can be a lang.Orderable or
// lang.Hashable key.  Nothing leaks.  (Copy, whose result is `Self`, comes last
// in its interface: no semicolon is inserted after the keyword at the end of a
// line, §5.13.)

type IdS[T any] struct {
	id  int
	tag T
}

func (a IdS[T]) Compare(other IdS[T]) int { return a.id - other.id }

func (a IdS[T]) Hash() uint { return cast(uint, a.id) }

impl IdS[T] : lang.Hashable, lang.Orderable

interface Twin {
	Same(other Self) bool
	Copy() Self
}

func (a IdS[T]) Copy() IdS[T] { return a }

func (a IdS[T]) Same(other IdS[T]) bool { return a.id == other.id }

impl IdS[T] : Twin

func less[K lang.Orderable](a K, b K) bool { return a.Compare(b) < 0 }

func distinct[K lang.Hashable](ks *[]K) int {
	var n int = 0
	for i := 0; i < len(ks); i++ {
		var seen bool = false
		for j := 0; j < i; j++ {
			if ks[j].Hash() == ks[i].Hash() && ks[j].Compare(ks[i]) == 0 { seen = true }
		}
		if !seen { n = n + 1 }
	}
	return n
}

func twins[K Twin](k K) bool { return k.Copy().Same(k) }

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func run() {
	var x IdS[@[]char] = IdS[@[]char]{id: 1, tag: mk("x")}
	var y IdS[@[]char] = IdS[@[]char]{id: 2, tag: mk("y")}
	testing.Println(less[IdS[@[]char]](x, y), less[IdS[@[]char]](y, x))
	var ks [3]IdS[bool] = [3]IdS[bool]{IdS[bool]{id: 1}, IdS[bool]{id: 2}, IdS[bool]{id: 1}}
	testing.Println(distinct[IdS[bool]](ks[:]), twins[IdS[@[]char]](x))
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
