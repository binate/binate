package "main"

import "pkg/builtins/testing"

// A function's name assigned to the blank identifier — by `_ = f`, in a parallel
// assignment or short variable declaration, or as a local or package-level
// `var _`; a package's function or a method expression, of a generic type's
// instance too — is evaluated for its effects, of which it has none; the other
// values of the statement are evaluated as usual.

func add1(x int) int { return x + 1 }

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() T { return b.v }

type C struct {
	n int
}

func (c C) N() int { return c.n }

var calls int

func note() int {
	calls = calls + 1
	return calls
}

var _ = add1

var _ = note()

func main() {
	_ = add1
	var _ = add1
	var x int
	_, x = add1, note()
	_, _ = note(), add1
	y, _ := note(), add1
	_ = Box[int].Get
	_ = C.N
	w, _ := 1, testing.Println
	testing.Println(x, y, w, calls, add1(4))
}
