package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/gi"

// A deferred method call through a generic interface's instance — declared in
// another package or in this one, through a managed or a raw interface value —
// runs at the function's exit, in reverse order, with its arguments evaluated
// at the defer (stmt.defer).  Nothing leaks.

interface Sink[T any] {
	Put(v T)
}

type Cell struct {
	v int
}

func (c *Cell) Get() int { return c.v }

func (c *Cell) Set(v int) {
	testing.Println("set", v)
	c.v = v
}

impl *Cell : gi.Holder[int]

type Log struct {
	last @[]char
}

func (l *Log) Put(v @[]char) {
	testing.Println("put", v)
	l.last = v
}

impl *Log : Sink[@[]char]

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func run(h @gi.Holder[int], s *Sink[@[]char]) {
	defer h.Set(h.Get() + 10)
	defer s.Put(mk("deferred"))
	h.Set(5)
	testing.Println("body", h.Get())
}

func once() {
	var c @Cell = make(Cell)
	c.v = 1
	var l Log
	run(c, &l)
	testing.Println(c.v, l.last)
}

func main() {
	once()
	var base int = rt.LiveBlocks()
	once()
	testing.Println(rt.LiveBlocks() - base)
}
