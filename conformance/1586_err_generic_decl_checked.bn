package "main"

import "pkg/builtins/testing"

// A generic interface's method signatures and parents, and a generic alias's
// target, are checked at the declaration, whether or not anything instantiates
// them (gen.mono.check): none of these is ever instantiated.

interface G[T any] {
	get() Nope
	put(v T, w Gone)
}

interface H[T any] : Absent {
	m() T
}

type L[T any] = NotThere[T]

func main() {
	testing.Println(1)
}
