package "main"

import "pkg/builtins/testing"

// A valid generic interface (with a generic parent, naming a generic type) and a
// generic alias are accepted though nothing instantiates them.

type Box[T any] struct {
	v T
}

interface G[T any] {
	get() T
	wrap() Box[T]
}

interface H[T any] : G[T] {
	put(v T)
}

type L[T any] = Box[T]

func main() {
	testing.Println(1)
}
