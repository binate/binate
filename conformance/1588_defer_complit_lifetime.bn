package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A composite literal addressed in a `defer` statement's operands lives until the
// deferred call has run (expr.composite.lifetime, stmt.defer): the address of a
// literal as an argument, a pointer-receiver call on a literal, an address a
// call returns, a slice literal's address and its element's, in a top-level or
// a conditional defer — taken or not.  Later allocations do not reuse the
// literal's managed fields before the deferred call reads them, and the
// literal is released at the function's exit — nothing leaks.

type P struct {
	n    int
	name @[]char
}

func (p *P) Show() { testing.Println("recv", p.n, p.name) }

func show(p *P) { testing.Println("arg", p.n, p.name) }

func id(p *P) *P { return p }

func showS(s *@[]int) { testing.Println("slice", len(*s), (*s)[1]) }

func showE(e *int) { testing.Println("elem", *e) }

func showAny(a *any) {
	switch v := a.(type) {
	case P:
		testing.Println("any", v.n, v.name)
	}
}

func mk(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

// churn allocates and frees managed slices the size of the literals' fields, so
// a field released early would be reused and overwritten.
func churn() {
	for i := 0; i < 8; i++ {
		var junk @[]char = mk("################")
		var nums @[]int = @[]int{-1, -1}
		_ = junk
		_ = nums
	}
}

func run(c bool) {
	defer show(&P{n: 1, name: mk("arg")})
	defer P{n: 2, name: mk("recv")}.Show()
	defer show(id(&P{n: 3, name: mk("returned")}))
	defer showS(&@[]int{4, 5})
	defer showE(&@[]int{6, 7}[1])
	defer showAny(P{n: 8, name: mk("borrow")})
	if c {
		defer show(&P{n: 9, name: mk("nested")})
	}
	churn()
	testing.Println("body", c)
}

func main() {
	run(true)
	run(false)
	var base int = rt.LiveBlocks()
	run(true)
	run(false)
	testing.Println(rt.LiveBlocks() - base)
}
