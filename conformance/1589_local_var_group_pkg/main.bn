package "main"

import "pkg/builtins/testing"
import "pkg/mf"

// A local `var ( … )` or `const ( … )` group in a function of a package other
// than main (one whose files have their own import scopes) is checked in the
// function's scope, as a single local declaration is: its initializers see the
// function's locals, its members are locals of the function, and the locals
// declared before it stay in scope after it.

func main() {
	testing.Println(mf.F())
}
