package "main"

import "pkg/builtins/testing"

// A package-level variable's initializer is a storing position (prog.init.vars):
// it runs as an assignment in the package's init function, and the temporaries
// that assignment creates end with it, while the variable lives on.  So, as for
// an assignment, a value is borrowed into a raw interface only from an
// addressable source (a string literal, a constant, a call result or a field of
// one is rejected), and the address of a composite literal is not stored
// (expr.composite.addr-store) — whether the variable's type is declared or
// inferred, and in a declaration group too.

type P struct {
	n int
}

type S struct {
	iv *any
	p  *P
}

func mk() P { return P{n: 7} }

var g1 *any = 42

var g2 *P = &P{n: 1}

var g3 = &P{n: 3}

var g4 = S{iv: 42}

var g5 S = S{p: &P{n: 5}}

var (
	g6 *any = 6
	g7      = &P{n: 7}
)

var g8 *any = mk()

var g9 *any = mk().n

var g10 *any = "hi"

var g11 = S{p: &P{n: 11}}.p

func main() {
	testing.Println(g2.n, g3.n, g5.p.n, g7.n, g11.n)
}
