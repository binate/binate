package "main"

import "pkg/builtins/testing"

// A package-level variable's initializer may borrow an addressable source into a
// raw interface and store the address of a package-level variable: both outlive
// the init function.  The borrow aliases its source, so a later change to the
// source shows through the interface.  A blank variable stores nothing, so its
// initializer may borrow a temporary, as a local one may: the value is discarded
// when the initializer has run.

type P struct {
	n int
}

type S struct {
	iv *any
	p  *P
}

interface Getter {
	Get() int
}

func (p *P) Get() int { return p.n }

impl *P : Getter

func mk() P { return P{n: 8} }

func note(n int) int {
	testing.Println("init", n)
	return n
}

var gv int = 5

var arr [2]int = [2]int{10, 20}

var gq P = P{n: 30}

var gb *any = gv

var ge *any = arr[1]

var gf *any = gq.n

var gp *P = &gq

var gs = S{iv: gv, p: &gq}

var gg *Getter = &gq

var _ *any = note(9)

var _ *any = mk()

var _ = &P{n: note(10)}

var _ *any = "hi"

func show(a *any) {
	switch v := a.(type) {
	case int:
		testing.Println(v)
	default:
		testing.Println("other")
	}
}

func main() {
	show(gb)
	show(ge)
	show(gf)
	show(gs.iv)
	testing.Println(gp.n, gs.p.n, gg.Get())
	gv = 6
	arr[1] = 21
	gq.n = 31
	show(gb)
	show(ge)
	show(gf)
	show(gs.iv)
	testing.Println(gp.n, gs.p.n, gg.Get())
}
