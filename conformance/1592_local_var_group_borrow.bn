package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A local `var ( … )` group's initializers are borrowing positions, as a single
// local var's are (§11.4): a temporary borrowed into a raw interface, and a
// composite literal whose address is taken, live as long as the binding — and are
// released when its scope exits, so nothing leaks.

type Opts struct {
	Any *any
}

type P struct {
	n int
	s @[]char
}

func clobber(n int) int {
	var buf [64]int
	for i := 0; i < 64; i++ {
		buf[i] = n + i
	}
	return buf[63]
}

func show(a *any) {
	switch v := a.(type) {
	case int:
		testing.Println(v)
	default:
		testing.Println("other")
	}
}

func run() {
	var (
		o      = Opts{Any: 44}
		q Opts = Opts{Any: 45}
		p      = &P{n: 46, s: "x"}
		r *any = 47
	)
	clobber(1)
	show(o.Any)
	show(q.Any)
	testing.Println(p.n, p.s)
	show(r)
	for i := 0; i < 3; i++ {
		var (
			a      = Opts{Any: i + 100}
			b      = &P{n: i + 200, s: "y"}
			c *any = i + 300
		)
		clobber(i)
		show(a.Any)
		testing.Println(b.n, b.s)
		show(c)
	}
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
