package "main"

import "pkg/builtins/testing"

// A float does not convert to bool (§8.5, §8.7): not by cast, and not by
// unsafe_cast, which asserts things about a representation — and a float has none
// in common with bool (`1.0` is not the byte 1).  The conversion is the
// comparison `f != 0.0`.  A generic body is checked at each instantiation: with
// an integer it converts, with a float it does not.

type Real float64

type Flag bool

const K = 1.0

func tb[T any](v T) bool { return unsafe_cast(bool, v) }

func main() {
	var f float64 = 3.0
	var g float32 = 1.0
	var r Real = 1.0
	testing.Println(unsafe_cast(bool, 2.5))
	testing.Println(unsafe_cast(bool, 1.0))
	testing.Println(unsafe_cast(bool, K))
	testing.Println(unsafe_cast(bool, f))
	testing.Println(unsafe_cast(bool, g))
	testing.Println(unsafe_cast(bool, r))
	testing.Println(unsafe_cast(Flag, f))
	testing.Println(cast(bool, f))
	testing.Println(f != 0.0)
	testing.Println(tb[int](1), tb[float64](2.5))
}
