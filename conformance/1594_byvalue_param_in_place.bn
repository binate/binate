package "main"

import "pkg/builtins/testing"

// A by-value aggregate argument over 16 bytes is, on aarch64, a pointer to a copy the
// callee owns and may use as its parameter in place.  Callees here write to their
// parameter; every caller must still see its own value unchanged — a local only ever
// read whole (whose load may read its slot directly), a local whose fields are read,
// one value passed twice to one call, a parameter passed on and read afterwards,
// calls through a function value and an interface method, a call result passed
// directly, a 200-byte byte array, a parameter modified and returned, a
// managed-slice parameter resliced, a managed field replaced, a whole-value
// assignment, a 20-byte array, a parameter written through its address, and a
// closure writing both its argument and its capture.

type Q struct {
	a int
	b int
	c int
	d int
}

type B [200]uint8

type T20 [5]int32

type R struct {
	s @[]int
	n int
}

func mk(k int) Q {
	var q Q
	q.a = k
	q.b = 2 * k
	q.c = 3 * k
	q.d = 4 * k
	return q
}

func bump(q Q) int {
	q.a = q.a + 100
	q.d = q.d + 1
	return q.a + q.d
}

func bumpTwo(p Q, q Q) int {
	p.a = p.a + 1000
	return p.a + q.a
}

func passOn(q Q) int {
	var r int = bump(q)
	return r + q.a
}

func nudge(q Q) Q {
	q.c = q.c + 1
	return q
}

func zap(b B) int {
	b[0] = 99
	b[199] = 98
	return cast(int, b[0]) + cast(int, b[199])
}

func reslice(s @[]int) int {
	s = s[1:]
	return len(s) * 10 + s[0]
}

func reset(r R) int {
	r.s = make_slice(int, 1)
	r.s[0] = 77
	r.n = r.n + 1
	return r.s[0] + r.n
}

func whole(q Q) int {
	q = mk(9)
	return q.a + q.d
}

func t20(t T20) int {
	t[4] = t[4] + 50
	return cast(int, t[0]) + cast(int, t[4])
}

func poke(p *Q) {
	p.b = p.b + 40
}

func viaPtr(q Q) int {
	var p *Q = &q
	p.a = p.a + 30
	poke(p)
	return q.a + q.b
}

interface Mut {
	mut(q Q) int
}

type M struct {
	k int
}

func (m *M) mut(q Q) int {
	q.b = q.b + m.k
	return q.b
}

impl *M : Mut

func main() {
	var y Q = mk(3)
	testing.Println(bump(y))
	var w Q = y
	testing.Println(w.a, w.d)
	var x Q = mk(1)
	testing.Println(bump(x), bump(x), x.a, x.d)
	testing.Println(bumpTwo(x, x), x.a)
	testing.Println(passOn(x), x.a)
	testing.Println(bump(mk(5)))
	var fv *func(Q) int = bump
	testing.Println(fv(x), fv(x), x.a)
	var m M
	m.k = 5
	var mi *Mut = &m
	testing.Println(mi.mut(x), mi.mut(x), x.b)
	var z Q = nudge(x)
	testing.Println(z.c, x.c)
	var bb B
	bb[0] = 1
	bb[199] = 2
	testing.Println(zap(bb), zap(bb), cast(int, bb[0]), cast(int, bb[199]))
	var sl @[]int = make_slice(int, 3)
	sl[0] = 1
	sl[1] = 2
	sl[2] = 3
	testing.Println(reslice(sl), reslice(sl), len(sl), sl[0])
	var r R
	r.s = sl
	r.n = 4
	testing.Println(reset(r), reset(r), r.s[0], r.n, len(r.s))
	testing.Println(whole(x), whole(x), x.a)
	var tt T20
	tt[0] = 2
	tt[4] = 3
	testing.Println(t20(tt), t20(tt), cast(int, tt[4]))
	testing.Println(viaPtr(x), viaPtr(x), x.a, x.b)
	var w2 Q = mk(2)
	var cl *func(Q) int = func(zz Q) int {
		zz.a = zz.a + 1
		w2.a = w2.a + 1
		return zz.a + w2.a
	}
	testing.Println(cl(x), cl(x), x.a, w2.a)
}
