package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A raw-slice view of a managed-slice literal is part of the literal
// (expr.composite.lifetime): converted to a raw slice — implicitly, by `cast`,
// held in a raw-slice field of another literal, or passed to a call whose result
// is bound — in a var / := initializer, the literal lives as long as the binding,
// so later allocations do not reuse its backing; in a defer it lives until the
// deferred call has run.  Nothing leaks.

type R struct {
	r *[]int
}

func id(s *[]int) *[]int { return s }

func sum(s *[]int) int {
	var t int = 0
	for i := 0; i < len(s); i++ {
		t = t + s[i]
	}
	return t
}

func show(s *[]int) { testing.Println("deferred", len(s), sum(s)) }

// churn allocates and frees managed slices the size of the literals' backings,
// so a backing released early would be reused and overwritten.
func churn() {
	for i := 0; i < 8; i++ {
		var a @[]int = @[]int{-1, -1}
		_ = a
	}
}

func run() {
	defer show(@[]int{30, 31})
	var r *[]int = @[]int{20, 21}
	p := &R{r: @[]int{1, 2}}.r[1]
	var c *[]int = cast(*[]int, @[]int{3, 4})
	var w *[]int = id(@[]int{5, 6})
	var v *[]int = @[]int{7, 8, 9}[1:]
	churn()
	testing.Println(r[0], r[1], *p, c[1], w[0], sum(v))
	testing.Println(sum(@[]int{10, 11}))
}

func main() {
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
}
