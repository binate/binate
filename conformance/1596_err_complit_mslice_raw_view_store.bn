package "main"

import "pkg/builtins/testing"

// A raw-slice view of a managed-slice literal may not be stored past the end of
// its statement (expr.composite.addr-store): the literal is released when the
// statement ends.  An assignment, a field store, a `return` or a package-level
// initializer may not store one — converted implicitly or by `cast`, through a
// sub-slice, held in another literal's raw-slice field, or an element's address
// reached through one.

type R struct {
	r *[]int
}

var g *[]int

var gp *int

var gr *[]int = @[]int{1}

func ret() *[]int { return @[]int{2} }

func main() {
	var s R
	g = @[]int{3}
	s.r = @[]int{4}
	g = cast(*[]int, @[]int{5})
	g = @[]int{6, 7}[1:]
	gp = &R{r: @[]int{8}}.r[0]
	s = R{r: @[]int{9}}
	testing.Println(len(g), *gp, len(s.r), len(gr), len(ret()))
}
