package "main"

import "pkg/builtins/testing"

// A constant whose initializer converts to a float type — `cast(float64, 5)`,
// with no float literal in it — has the converted value wherever it is used:
// directly, in another constant, repeated in a group with iota, negated, through
// a named float type and in float32.  A constant computed through a float value
// -- a float expression over a constant declared later, a conversion of a float
// constant to an integer type, a bit_cast of one, a bool or int constant over
// another such constant -- has its value too, including where a package
// variable's initializer, a switch case or a local constant reads it.

type Celsius float64

const F float64 = cast(float64, 5)

const G = cast(float64, 7)

const P float32 = cast(float32, 3)

const N float64 = cast(float64, G) + 1.0

const U = -cast(float64, 4)

const T Celsius = cast(Celsius, 21)

const B float64 = bit_cast(float64, cast(uint64, 4611686018427387904))

const G2 float64 = F3 + F3

const F3 = cast(float64, 1)

const FI float64 = 2.75

const I int = cast(int, FI)

const J = cast(int, cast(float64, 3) * 2.0)

const BI uint64 = bit_cast(uint64, cast(float64, 1))

const K bool = 1.5 < 2.5

const L bool = !K

const J2 int = I + 1

const NF = NI + 1

const NI int = cast(int, FI) * 2

var tbl [3]int = [3]int{I, J2, 7}

var sh int = 1 << I

const (
	K0 float64 = cast(float64, iota) * cast(float64, 3)
	K1
	K2
)

func main() {
	var f float64 = F
	testing.Println(cast(int, f * 10.0), cast(int, G * 10.0), cast(int, P * 10.0))
	testing.Println(cast(int, N * 10.0), cast(int, U * 10.0), cast(int, T * 10.0))
	testing.Println(cast(int, B * 10.0), cast(int, K1 * 10.0), cast(int, K2 * 10.0))
	testing.Println(cast(int, G2 * 10.0), I, J, BI == 0x3ff0000000000000)
	testing.Println(K, L, J2, NF)
	const LJ int = J2 * 2
	const LK bool = !K
	var two int = 2
	switch two {
	case I:
		testing.Println("case I")
	}
	testing.Println(tbl[0], tbl[1], tbl[2], sh, LJ, LK)
}
