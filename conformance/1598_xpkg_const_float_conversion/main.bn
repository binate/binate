package "main"

import "pkg/builtins/testing"
import "pkg/fc"

// A `.bni` constant whose initializer converts to a float type — its own
// package's named float type included — has the converted value in an importing
// package, alone and repeated in a group with iota; so does one computed through
// a float value (a float expression over a constant declared later, a conversion
// of a float constant to an integer type, a bool or int constant over another
// such constant).

func main() {
	var t fc.Celsius = fc.Twice(fc.T)
	testing.Println(cast(int, fc.F * 10.0), cast(int, t * 10.0), cast(int, fc.K1 * 10.0))
	testing.Println(cast(int, fc.G2 * 10.0), fc.I)
	testing.Println(fc.K, fc.L, fc.J, fc.NF)
}
