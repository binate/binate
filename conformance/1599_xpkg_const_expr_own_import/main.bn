package "main"

import "pkg/builtins/testing"
import a "pkg/b"
import "pkg/fc"

// An imported package's floating-point constant expression names that package's
// own import (`a.A`, `a.Meters`): it has the value it has there, even where the
// importer binds the same name to a different package.

func main() {
	a.Nop()
	testing.Println(cast(int, fc.X * 10.0), cast(int, fc.M * 10.0))
}
