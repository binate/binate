package "main"

import "pkg/builtins/testing"

// A value of a zero-size type has no data region in a native frame; every
// place that looks one up must expect that: a zero-length char array from a
// string literal, a zero-size struct's zero value and composite literal, a
// zero-size field a keyed literal leaves out, and zero-size results of a direct
// call, a function-value call and an interface method.

type Empty struct {}

type W struct {
	e Empty
	n int
}

interface Maker {
	Make() [0]int
}

type M struct {
	n int
}

func (m *M) Make() [0]int {
	m.n = m.n + 1
	var z [0]int
	return z
}

impl *M : Maker

var made int

func mkEmpty() Empty {
	made = made + 1
	var e Empty
	return e
}

func main() {
	var a [0]char = ""
	var e Empty = Empty{}
	var e2 Empty = mkEmpty()
	var f *func() Empty = mkEmpty
	var e3 Empty = f()
	var m M
	var mk *Maker = &m
	var z [0]int = mk.Make()
	var w W = W{n: 5}
	_ = e
	_ = e2
	_ = e3
	testing.Println(len(a), len(z), made, m.n, w.n)
}
