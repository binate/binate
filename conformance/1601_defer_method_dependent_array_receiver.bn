package "main"

import "pkg/builtins/testing"

// A deferred method call on a receiver whose type argument is an array sized by
// a type parameter (`Box[[sizeof(T)]uint8]`) runs at the function's exit with the
// receiver's state at the defer, through a pointer and a value receiver alike.

type Box[A any] struct {
	v A
	n int
}

func (b *Box[A]) Mark(k int) {
	testing.Println("mark", k, b.n, sizeof(A))
}

func (b Box[A]) Show(k int) {
	testing.Println("show", k, b.n, sizeof(A))
}

func F[T any](x T) {
	var b Box[[sizeof(T)]uint8]
	b.n = 7
	defer b.Mark(3)
	defer b.Show(4)
	b.n = 8
	testing.Println("body", len(b.v))
}

func main() {
	F[int32](5)
	F[int64](6)
}
