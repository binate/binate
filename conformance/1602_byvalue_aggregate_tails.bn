package "main"

import "pkg/builtins/testing"

// Aggregates passed by value whose size is not a multiple of the word arrive
// whole: in registers (3-, 5-, 6-, 7- and 13-byte values, two in registers
// already holding arguments), on the stack after the register arguments (a
// 21-byte one and a 141-byte one), and several on the stack behind four
// register arguments.

type S3 struct {
	a uint8
	b uint8
	c uint8
}

type H3 struct {
	a int16
	b int16
	c int16
}

type Big struct {
	x [21]uint8
}

type Trio struct {
	a int
	b int
	c int
}

type Huge struct {
	x [141]uint8
}

func f3(s S3) int { return cast(int, s.a) + cast(int, s.b) * 10 + cast(int, s.c) * 100 }

func f5(s [5]uint8) int { return cast(int, s[0]) + cast(int, s[4]) * 10 }

func f6(s H3) int { return cast(int, s.a) + cast(int, s.b) * 10 + cast(int, s.c) * 100 }

func f7(s [7]uint8) int { return cast(int, s[0]) + cast(int, s[6]) * 10 + cast(int, s[3]) * 100 }

func f13(s [13]uint8) int { return cast(int, s[0]) + cast(int, s[12]) * 10 + cast(int, s[8]) * 100 }

func fb(p int, q int, r int, s int, t int, u int, b Big) int {
	return p + u + cast(int, b.x[0]) + cast(int, b.x[20]) * 10
}

func fh(p int, q int, r int, s int, t int, u int, b Huge) int {
	return p + u + cast(int, b.x[0]) + cast(int, b.x[140]) * 10
}

func two(p int, q int, r int, s int, x Trio, y Trio) int {
	return p + q + r + s + x.a + y.c * 10
}

func g2(p int, q int, s S3, t H3) int { return p + q + f3(s) * 1000 + f6(t) }

func main() {
	var s S3
	s.a = 1
	s.b = 2
	s.c = 3
	testing.Println(f3(s))
	var a5 [5]uint8
	a5[0] = 4
	a5[4] = 5
	testing.Println(f5(a5))
	var h H3
	h.a = 6
	h.b = 7
	h.c = 8
	testing.Println(f6(h))
	var a7 [7]uint8
	a7[0] = 1
	a7[6] = 9
	a7[3] = 2
	testing.Println(f7(a7))
	var a13 [13]uint8
	a13[0] = 3
	a13[12] = 4
	a13[8] = 5
	testing.Println(f13(a13))
	var b Big
	b.x[0] = 7
	b.x[20] = 8
	testing.Println(fb(1, 2, 3, 4, 5, 6, b))
	var hu Huge
	hu.x[0] = 2
	hu.x[140] = 3
	testing.Println(fh(1, 2, 3, 4, 5, 6, hu))
	testing.Println(g2(1, 2, s, h))
	var ps @S3 = make(S3)
	ps.a = 9
	ps.b = 8
	ps.c = 7
	testing.Println(f3(*ps))
	var t Trio
	t.a = 10
	t.c = 100
	testing.Println(two(1, 2, 3, 4, t, t))
}
