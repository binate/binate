package "main"

import "pkg/builtins/testing"
import "pkg/opq"

// For an importer, `p.f` on an opaque handle whose type has a hidden field f
// names the exported method f's value, which has no storage: it can be neither
// assigned nor addressed (the hidden field is not visible here).

func mine(n int) { testing.Println("mine", n) }

func main() {
	var p @opq.Foo = opq.New()
	p.f = mine
	var a **func(int) = &p.f
	_ = a
}
