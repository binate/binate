package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/opq"

// A method value of an imported opaque type binds its receiver — an `@Foo`
// receiver retained by the value's capture, a `*Foo` one borrowed — and the
// capture is released with the opaque type's own destructor, which the owning
// package defines; a method value evaluated in a loop releases the previous
// evaluation's capture.

func run() {
	var p @opq.Foo = opq.New()
	var g *func(int) = p.g
	g(2)
	var h *func(int) = p.h
	h(3)
	for i := 0; i < 2; i++ {
		var gi *func(int) = p.g
		gi(10 + i)
	}
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	run()
	var live int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - live)
}
