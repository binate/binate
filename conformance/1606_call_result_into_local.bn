package "main"

import "pkg/builtins/testing"

// A call whose aggregate result is stored whole into a local may write the result
// straight into the local instead of a temporary.  Each case checks that nothing can
// tell: a first assignment, and reassignments in a loop of a local declared before
// it; `x = next(x)`, whose argument is read from x before the result lands there;
// results of a function value, an interface method and a method; small structs
// returned in registers, a float struct, and a struct whose size is not a multiple
// of the word size.  A struct with a managed field is reassigned too, a case left to
// copy: the old value's release falls between the call and the store.

type Big struct {
	n   int
	arr [40]int
}

type Box struct {
	s   @[]int
	n   int
	pad [8]int
}

type P2 struct {
	a int
	b int
}

type F3 struct {
	x float64
	y float64
	z float64
}

type Odd struct {
	a int32
	b int32
	c int32
}

interface Maker {
	Make(k int) Big
}

type M struct {
	base int
}

func (m *M) Make(k int) Big { return mk(k + m.base) }

impl *M : Maker

func (m *M) mkm(k int) Big { return mk(k * m.base) }

func mk(k int) Big {
	var b Big
	b.n = k
	for i := 0; i < 40; i++ { b.arr[i] = k + i }
	return b
}

func next(a Big) Big {
	var r Big
	r.n = a.n + 1
	for i := 0; i < 40; i++ { r.arr[i] = a.arr[i] * 2 + a.n }
	return r
}

func mkBox(k int) Box {
	var b Box
	b.s = make_slice(int, 3)
	b.s[0] = k
	b.s[2] = k * 2
	b.n = k + 1
	return b
}

func mkP2(k int) P2 {
	var p P2
	p.a = k
	p.b = k * 3
	return p
}

func mkF3(k int) F3 {
	var f F3
	f.x = cast(float64, k)
	f.z = cast(float64, k) * 0.5
	return f
}

func mkOdd(k int) Odd {
	var o Odd
	o.a = cast(int32, k)
	o.b = cast(int32, k + 1)
	o.c = cast(int32, k + 2)
	return o
}

func first(k int) int {
	var x Big = mk(k)
	return x.n + x.arr[39]
}

func loop() int {
	var x Big
	var sum int = 0
	for i := 0; i < 5; i++ {
		x = mk(i)
		sum = sum + x.n + x.arr[i]
	}
	return sum
}

func chain(k int) int {
	var x Big = mk(k)
	x = next(x)
	x = next(x)
	return x.n * 1000 + x.arr[7]
}

func boxes() int {
	var b Box
	var sum int = 0
	for i := 1; i <= 3; i++ {
		b = mkBox(i)
		sum = sum + b.s[0] + b.s[2] + b.n
	}
	return sum
}

func viaValues(k int) int {
	var fv *func(int) Big = mk
	var x Big = fv(k)
	var m M
	m.base = 100
	var mi *Maker = &m
	var y Big = mi.Make(k)
	var z Big = m.mkm(k)
	return x.n + y.n + z.n
}

func smalls(k int) int {
	var p P2 = mkP2(k)
	var f F3 = mkF3(k)
	var o Odd = mkOdd(k)
	return p.a + p.b + cast(int, f.x + f.z) + cast(int, o.a + o.b + o.c)
}

func main() {
	testing.Println(first(3), first(4))
	testing.Println(loop())
	testing.Println(chain(1))
	testing.Println(boxes())
	testing.Println(viaValues(5))
	testing.Println(smalls(4))
}
