package "main"

import "pkg/builtins/testing"

// A call's aggregate result written straight into the local it is stored into, where
// the local stays whole (passed to sum, so it is not split into its fields): a copy
// of x taken before x is reassigned; a local declared in a loop body and reassigned
// from a call taking it; parallel assignments mixing x and a call's result; a call
// taking x twice, and x and another call's result; a struct of two structs swapped by
// a call three times.  Each must still see the values the source says.

type Big struct {
	n   int
	arr [6]int
}

type Two struct {
	a Big
	b Big
}

func mk(k int) Big {
	var b Big
	b.n = k
	for i := 0; i < 6; i++ { b.arr[i] = k * 10 + i }
	return b
}

func next(a Big) Big {
	var r Big
	r.n = a.n + 1
	for i := 0; i < 6; i++ { r.arr[i] = a.arr[5 - i] + 1 }
	return r
}

func sum(b Big) int {
	var s int = b.n
	for i := 0; i < 6; i++ { s = s + b.arr[i] }
	return s
}

func combine(a Big, b Big) Big {
	var r Big
	r.n = a.n * 2 + b.n
	for i := 0; i < 6; i++ { r.arr[i] = a.arr[i] - b.arr[5 - i] }
	return r
}

func swapT(t Two) Two {
	var r Two
	r.a = t.b
	r.b = t.a
	return r
}

func keepOld(k int) int {
	var x Big = mk(k)
	var old Big = x
	x = mk(k + 10)
	return sum(old) * 1000 + sum(x)
}

func loopPinned() int {
	var total int = 0
	for i := 0; i < 4; i++ {
		var x Big = mk(i)
		total = total + sum(x)
		x = next(x)
		total = total + sum(x) * 100
	}
	return total
}

func par(k int) int {
	var x Big = mk(k)
	var y Big = mk(0)
	y, x = x, mk(k + 1)
	var s1 int = sum(y)
	x, y = mk(k + 2), x
	return s1 * 1000000 + sum(x) * 1000 + sum(y)
}

func argAlias(k int) int {
	var x Big = mk(k)
	x = combine(x, x)
	x = combine(x, mk(1))
	return sum(x)
}

func two(k int) int {
	var t Two
	t.a = mk(k)
	t.b = mk(k + 1)
	t = swapT(t)
	t = swapT(t)
	t = swapT(t)
	return sum(t.a) * 1000 + sum(t.b)
}

func main() {
	testing.Println(keepOld(2))
	testing.Println(loopPinned())
	testing.Println(par(3))
	testing.Println(argAlias(4))
	testing.Println(two(5))
}
