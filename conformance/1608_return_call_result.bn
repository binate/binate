package "main"

import "pkg/builtins/testing"

// A function returning a call's aggregate result, `return mk(k)`, may hand its own
// caller's result buffer to the call, which then writes the result there directly.
// Each case checks that nothing can tell: a direct forward, two levels of forwarding,
// forwarding through a function value and an interface method, a recursive builder
// whose results are passed on, a forwarded result landing in the caller's local, a
// forward on one path and a local returned on the other (forwarded at -O1 and above),
// deferred calls that run after the forwarded call and write the global the outer
// caller assigns the result to (recursive, so not inlined; forwarded at -O1 and above,
// where the defer adds no branch), and small structs returned in registers.

type Big struct {
	n   int
	arr [30]int
}

type P2 struct {
	a int
	b int
}

interface Maker {
	Make(k int) Big
}

type M struct {
	base int
}

func (m *M) Make(k int) Big { return pass(k + m.base) }

impl *M : Maker

var deferred int

var g Big

func mk(k int) Big {
	var b Big
	b.n = k
	for i := 0; i < 30; i++ { b.arr[i] = k * 2 + i }
	return b
}

func pass(k int) Big { return mk(k) }

func pass2(k int) Big { return pass(k + 1) }

func bump(b Big) Big {
	var r Big
	r.n = b.n + 1
	for i := 0; i < 30; i++ { r.arr[i] = b.arr[i] + b.n }
	return r
}

func build(n int) Big {
	if n == 0 { return mk(1) }
	return bump(build(n - 1))
}

func either(k int) Big {
	if k % 2 == 0 { return pass(k) }
	var b Big = mk(k)
	b.n = b.n * 100
	return b
}

func note() {
	deferred = deferred + 1
	g.n = g.n + 100
}

func withDefer(k int, n int) Big {
	defer note()
	if n > 0 { return withDefer(k, n - 1) }
	return mk(k)
}

func mkP2(k int) P2 {
	var p P2
	p.a = k
	p.b = k + 7
	return p
}

func passP2(k int) P2 { return mkP2(k) }

func check(b Big) int { return b.n * 1000 + b.arr[29] }

func main() {
	testing.Println(check(pass(3)), check(pass2(3)))
	var fv *func(int) Big = pass
	var m M
	m.base = 10
	var mi *Maker = &m
	testing.Println(check(fv(4)), check(mi.Make(4)))
	testing.Println(check(build(3)))
	var x Big = pass2(5)
	x.arr[0] = x.arr[0] + 1
	testing.Println(check(x), x.arr[0])
	testing.Println(check(either(6)), check(either(7)))
	g = withDefer(8, 3)
	testing.Println(check(g), deferred)
	var p P2 = passP2(9)
	testing.Println(p.a, p.b)
}
