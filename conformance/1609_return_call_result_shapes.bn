package "main"

import "pkg/builtins/testing"

// More functions returning a call's aggregate result as is, which may hand their own
// caller's result buffer to the call: `x = forward(x)`, where the caller's local is
// both the destination and the by-value argument; a generic forward; a forward whose
// call takes eight ints (some on the stack) or floats; a struct with a managed field
// and a managed-slice result (left to copy: their ownership adds uses); an interface
// value and a function value; a method forwarding to a method; and recursion.

type Big struct {
	n   int
	arr [30]int
}

type MB struct {
	s   @[]int
	n   int
	pad [4]int
}

interface Maker {
	Make(k int) Big
}

type M struct {
	base int
}

func (m *M) Make(k int) Big { return mk(k + m.base) }

impl *M : Maker

func (m *M) inner(k int) Big { return mk(k + m.base) }

func (m *M) outer(k int) Big { return m.inner(k) }

func mk(k int) Big {
	var b Big
	b.n = k
	for i := 0; i < 30; i++ { b.arr[i] = k * 2 + i }
	return b
}

func check(b Big) int { return b.n * 1000 + b.arr[29] + b.arr[0] }

func bump(b Big) Big {
	var r Big
	r.n = b.n + 1
	for i := 0; i < 30; i++ { r.arr[i] = b.arr[i] + b.n }
	return r
}

func bumpPass(b Big) Big { return bump(b) }

func Ident[T any](x T) T { return x }

func FwdG[T any](x T) T { return Ident[T](x) }

func mk8(a int, b int, c int, d int, e int, f int, g int, h int) Big {
	var r Big
	r.arr[0] = a
	r.arr[1] = b
	r.arr[2] = c
	r.arr[3] = d
	r.arr[4] = e
	r.arr[5] = f
	r.arr[6] = g
	r.arr[7] = h
	return r
}

func pass8(a int, b int, c int, d int, e int, f int, g int, h int) Big {
	return mk8(h, g, f, e, d, c, b, a)
}

func mkF(x float64, k int, y float64) Big {
	var r Big
	r.n = cast(int, x * 10.0) + k * 100 + cast(int, y * 1000.0)
	return r
}

func passF(k int, x float64, y float64) Big { return mkF(y, k, x) }

func mkMB(k int) MB {
	var r MB
	r.s = make_slice(int, 3)
	r.s[0] = k
	r.s[2] = k * 3
	r.n = k
	return r
}

var gHold @[]int

func dropHold() {
	var none @[]int
	gHold = none
}

func passMB(k int) MB {
	defer dropHold()
	return mkMB(k)
}

func mkS(k int) @[]int {
	var s @[]int = make_slice(int, k)
	for i := 0; i < k; i++ { s[i] = i * k }
	return s
}

func passS(k int) @[]int { return mkS(k) }

func mkIf(m *M) *Maker { return m }

func passIf(m *M) *Maker { return mkIf(m) }

func mkFn(k int) @func() int { return func() int { return k * 7 } }

func passFn(k int) @func() int { return mkFn(k) }

func rec(n int) Big {
	if n == 0 { return mk(5) }
	return rec(n - 1)
}

func main() {
	var x Big = mk(2)
	x = bumpPass(x)
	x = bumpPass(x)
	testing.Println(check(x))
	var y Big = FwdG[Big](mk(3))
	testing.Println(check(y))
	var p8 Big = pass8(1, 2, 3, 4, 5, 6, 7, 8)
	testing.Println(p8.arr[0], p8.arr[1], p8.arr[2], p8.arr[3], p8.arr[4], p8.arr[5], p8.arr[6],
			p8.arr[7])
	testing.Println(check(passF(4, 1.5, 2.25)))
	gHold = make_slice(int, 2)
	var mb MB = passMB(9)
	testing.Println(mb.s[0], mb.s[2], mb.n, len(gHold))
	var s @[]int = passS(5)
	testing.Println(len(s), s[4])
	var m M
	m.base = 100
	var mi *Maker = passIf(&m)
	testing.Println(check(mi.Make(1)), check(m.outer(2)))
	var fn @func() int = passFn(6)
	testing.Println(fn())
	testing.Println(check(rec(4)))
}
