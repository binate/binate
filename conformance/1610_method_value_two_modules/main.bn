package "main"

import "pkg/gl"

// One method's value taken in two modules — in the method's own package
// (gl.Local) and in an importer — links once: each module may emit the value's
// wrapper, and the copies must not collide.

func main() {
	var s gl.S
	s.k = 3
	gl.Local(s, 1)
	var g *func(int) = s.v
	g(2)
}
