package "main"

import "pkg/builtins/lang"
import "pkg/builtins/rt"
import "pkg/builtins/testing"
import "pkg/gl"
import "pkg/uu"

// One method's value taken in several modules — in the method's own package
// (gl.Local), in a second importer (uu.Use) and here — links once: each module
// may emit the value's wrapper (a value receiver, an opaque type's `@O`
// receiver, a generic instance's; float, multi-result and variadic signatures;
// a primitive's method), and the copies must not collide.  The captures are
// released.

func run() {
	var s gl.S
	s.k = 3
	var o @gl.O = gl.NewO(4)
	gl.Local(s, o, 1)
	uu.Use(s, o, 2)
	var g *func(int) = s.v
	g(3)
	g = o.om
	g(3)
	var b gl.Box[int]
	g = b.bv
	g(3)
	var fv *func(float64, float32) float64 = s.fv
	var mr *func(int) (int, @[]int) = s.mr
	var va *func(...int) int = s.va
	var a int
	var sl @[]int
	a, sl = mr(3)
	testing.Println("sig", cast(int, fv(1.5, 2.5)), a, len(sl), va(3, 3, 3))
	var x int = 3
	var ps *func() @[]char = x.String
	testing.Println("prim", ps())
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	run()
	var live int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - live)
}
