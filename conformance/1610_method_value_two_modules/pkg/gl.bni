package "pkg/gl"

import "pkg/builtins/testing"

type S struct {
	k int
}

func (s S) v(n int)

func (s S) fv(a float64, b float32) float64

func (s S) mr(n int) (int, @[]int)

func (s S) va(xs ...int) int

// O is opaque to importers: its layout is in gl.bn.
type O

func NewO(k int) @O

func (o @O) om(n int)

type Box[T any] struct {
	v T
}

func (b Box[T]) bv(n int) { testing.Println("bv", n) }

// Local takes the method values inside the package that defines the methods.
func Local(s S, o @O, n int)

// Sigs takes method values of other signatures — float, multi-result and
// variadic, and a primitive's (int.String) — and calls them.
func Sigs(s S, n int)
