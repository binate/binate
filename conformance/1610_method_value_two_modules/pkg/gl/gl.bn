package "pkg/gl"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

type O struct {
	k int
	s @[]int
}

func (s S) v(n int) { testing.Println("v", n, s.k) }

func (s S) fv(a float64, b float32) float64 { return a + cast(float64, b) + cast(float64, s.k) }

func (s S) mr(n int) (int, @[]int) {
	var r @[]int = make_slice(int, n)
	return n + s.k, r
}

func (s S) va(xs ...int) int {
	var t int = s.k
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

func Sigs(s S, n int) {
	var fv *func(float64, float32) float64 = s.fv
	var mr *func(int) (int, @[]int) = s.mr
	var va *func(...int) int = s.va
	var a int
	var sl @[]int
	a, sl = mr(n)
	testing.Println("sig", cast(int, fv(1.5, 2.5)), a, len(sl), va(n, n, n))
	var x int = n
	var ps *func() @[]char = x.String
	testing.Println("prim", ps())
}

func NewO(k int) @O {
	var o @O = make(O)
	o.k = k
	o.s = make_slice(int, 1)
	return o
}

func (o @O) om(n int) { testing.Println("om", n, o.k) }

func Local(s S, o @O, n int) {
	var g *func(int) = s.v
	g(n)
	g = o.om
	g(n)
	var b Box[int]
	g = b.bv
	g(n)
	Sigs(s, n)
}
