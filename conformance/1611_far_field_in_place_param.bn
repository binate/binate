package "main"

import "pkg/builtins/testing"

// A by-value struct parameter whose bytes the callee uses in place, with fields far
// from its start — past the 255-byte and the 4095-byte offsets arm32's loads and
// stores take as immediates — read and written in place at each access width: a
// halfword and a signed byte past 255 bytes, a word and a byte past 4095.

type Far struct {
	pad  [70]int32
	h    int16
	sb   int8
	pad2 [1100]int32
	w    int32
	b    uint8
}

func sum(p Far) int { return cast(int, p.h) + cast(int, p.sb) + cast(int, p.w) + cast(int, p.b) }

func bump(p Far) int {
	p.h = p.h + 1
	p.sb = p.sb - 1
	p.w = p.w * 2
	p.b = p.b + 3
	return sum(p) * 1000 + cast(int, p.w)
}

func main() {
	var f Far
	f.h = 3
	f.sb = -1
	f.w = 40
	f.b = 7
	testing.Println(sum(f), bump(f), sum(f))
}
