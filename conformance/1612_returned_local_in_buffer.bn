package "main"

import "pkg/builtins/testing"

// A function returning one local at every return may build that local in its caller's
// result buffer.  Each case checks that nothing can tell: a constructor that zero-fills
// and partly writes its local, with the result stored into a local, passed straight to
// a call, forwarded, and through a function value and an interface method; a local
// returned from two returns; a local whose fields are read before the return; a copy
// of the local taken before it changes; a local filled from a call and then changed;
// recursion, each level's result stored into the outer level's local; `y = next(y)`,
// whose result is built in the caller's y while it reads its own copy of y; fields far
// from the start of the local (past arm32's 255- and 4095-byte immediate offsets); a
// capturing closure; and results whose size is not a multiple of the word size, or
// that are only byte-aligned.

type Big struct {
	n   int
	arr [30]int
}

type Far struct {
	pad  [70]int32
	h    int16
	sb   int8
	pad2 [1100]int32
	w    int32
}

type W5 struct {
	a [5]int32
}

type C23 struct {
	b [23]char
}

interface Maker {
	Make(k int) Big
}

type M struct {
	base int
}

func (m *M) Make(k int) Big { return mk(k + m.base) }

impl *M : Maker

var saved Big

func mk(k int) Big {
	var b Big
	b.n = k
	b.arr[k % 30] = k * 3
	return b
}

func pass(k int) Big { return mk(k) }

func either(k int) Big {
	var b Big
	b.n = k
	if k % 2 == 0 {
		b.arr[0] = 1
		return b
	}
	b.arr[1] = 2
	return b
}

func readBack(k int) Big {
	var b Big
	b.n = k
	b.arr[2] = b.n * 10
	b.arr[3] = b.arr[2] + b.n
	return b
}

func copyFirst(k int) Big {
	var b Big = mk(k)
	saved = b
	b.n = b.n + 100
	return b
}

func fillThenChange(k int) Big {
	var b Big
	b = mk(k)
	b.arr[29] = b.arr[29] + 1
	return b
}

func rec(n int) Big {
	var b Big
	if n == 0 {
		b.n = 1
		return b
	}
	b = rec(n - 1)
	b.n = b.n * 2
	b.arr[n] = n
	return b
}

func next(a Big) Big {
	var r Big
	r.n = a.n + 1
	for i := 0; i < 30; i++ { r.arr[i] = a.arr[29 - i] + a.n }
	return r
}

func mkFar(k int) Far {
	var f Far
	f.h = cast(int16, k)
	f.sb = cast(int8, -k)
	f.w = cast(int32, k * 2)
	return f
}

func mkW5(k int) W5 {
	var w W5
	w.a[0] = cast(int32, k)
	w.a[4] = cast(int32, k * 2)
	return w
}

func mkC23(k int) C23 {
	var c C23
	c.b[0] = cast(char, k)
	c.b[22] = cast(char, k + 1)
	return c
}

func check(b Big) int {
	var s int = b.n * 1000
	for i := 0; i < 30; i++ { s = s + b.arr[i] }
	return s
}

func main() {
	var x Big = mk(4)
	testing.Println(check(x), check(mk(5)), check(pass(6)))
	var fv *func(int) Big = mk
	var m M
	m.base = 10
	var mi *Maker = &m
	testing.Println(check(fv(7)), check(mi.Make(1)))
	testing.Println(check(either(2)), check(either(3)))
	testing.Println(check(readBack(4)))
	testing.Println(check(copyFirst(5)), check(saved))
	testing.Println(check(fillThenChange(6)))
	testing.Println(check(rec(3)))
	var y Big = mk(2)
	y = next(y)
	testing.Println(check(y))
	y = next(y)
	testing.Println(check(y))
	var fr Far = mkFar(5)
	testing.Println(cast(int, fr.h), cast(int, fr.sb), cast(int, fr.w))
	var base int = 3
	var cl *func(int) Big = func(k int) Big {
		var b Big
		b.n = k + base
		return b
	}
	testing.Println(check(cl(9)))
	var w W5 = mkW5(3)
	testing.Println(w.a[0], w.a[1], w.a[4])
	var c C23 = mkC23(65)
	testing.Println(cast(int, c.b[0]), cast(int, c.b[1]), cast(int, c.b[22]))
}
