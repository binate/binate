package "main"

import "pkg/builtins/testing"
import "pkg/p"

// A package's floating-point constant expression read by its bare name in
// another of the package's files has the value its own file's imports give it:
// in a file that does not import the package it names, and in one binding that
// name to a different package.

func main() {
	testing.Println(cast(int, p.F() * 10.0), cast(int, p.H() * 10.0))
}
