package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An outermost readonly is the copy's to drop (type.readonly.drop): a
// `readonly` interface value widens to a parent interface or `any` — managed or
// raw, by assignment, cast or unsafe_cast — and a `readonly` managed pointer,
// slice or function value borrows as its raw form, also as a parameter passed on
// to a raw one, all sharing the one object, with every reference released.

interface Getter {
	Get() int
}

interface Named : Getter {
	Name() int
}

type T struct {
	v int
}

func (t @T) Get() int { return t.v }

func (t @T) Name() int { return t.v * 10 }

impl @T : Named

// got holds what run read, printed after the reference count is checked (the
// first testing.Println may keep a block of its own).
var got [12]int

// three is the function a readonly function value holds.
func three() int { return 3 }

// rawV reads through a raw pointer a readonly managed one borrows as.
func rawV(p *T) int { return p.v }

// viaParam passes its readonly parameters on to raw ones.
func viaParam(ro readonly @T, n readonly @Named, fv readonly @func() int) int {
	var g *Getter = n
	var f *func() int = fv
	return rawV(ro) * 100 + g.Get() * 10 + f()
}

func run() {
	var t @T = make(T)
	t.v = 7
	var n readonly @Named = t
	var g @Getter = n
	var c @Getter = cast(@Getter, n)
	var u @Getter = unsafe_cast(@Getter, n)
	var r readonly *Named = n
	var p *Getter = r
	var a @any = n
	var ra *any = r
	var ro readonly @T = t
	var tp *T = ro
	var s readonly @[]int = make_slice(int, 2)
	var sp *[]int = s
	// Changed after every conversion: each view sees it.
	t.v = 8
	sp[1] = 5
	var back @T = a.(@T)
	var rback *T = ra.(*T)
	var fv readonly @func() int = three
	got[8] = rback.v
	got[9] = viaParam(ro, n, fv)
	got[0] = n.Name()
	got[1] = g.Get()
	got[2] = c.Get()
	got[3] = u.Get()
	got[4] = p.Get()
	got[5] = back.v
	got[6] = tp.v
	got[7] = s[1]
}

func main() {
	// The VM keeps state for each function whose value is taken, the first time:
	// take three's before the count starts.
	var warm @func() int = three
	_ = warm
	var base int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - base)
	testing.Println(got[0], got[1], got[2], got[3], got[4], got[5], got[6], got[7])
	testing.Println(got[8], got[9])
}
