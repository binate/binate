package "main"

import "pkg/builtins/testing"
import "pkg/q"

// A package interface's method declarations must match the package's
// definitions (pkg.bni.consistency): one declared twice, or with a parameter type
// the definition does not have, is an error — an importer reads the declaration.

func main() {
	var t @q.T = make(q.T)
	testing.Println(t.Get())
}
