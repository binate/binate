package "main"

// A pointer nested in a type's structure — an array element, a slice element, a
// struct field, a generic instance's field — may not point to a type that embeds
// an opaque type by value, as a top-level pointer may not: the pointee can never
// be a value.  This program must fail to compile.
type Opaque

type PBox[T any] struct { p *T }

type X [2]*([2]Opaque)

func f(s @[]*([2]Opaque), v PBox[[2]Opaque]) {
	_ = s
	_ = v
}

func main() {}
