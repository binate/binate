package "main"

import "pkg/builtins/testing"

// A generic type instantiated with an opaque type argument is an instance of
// its own: a `@PBox[Opaque]` held in an `@any` is not a `@PBox[int]`, although
// the two instances have the same layout.
type Opaque

type PBox[T any] struct {
	p *T
	n int
}

func main() {
	var b @PBox[Opaque] = make(PBox[Opaque])
	b.n = 7
	var a @any = b
	_, isInt := a.(@PBox[int])
	q, isOpaque := a.(@PBox[Opaque])
	testing.Println(isInt, isOpaque, q.n)
}
