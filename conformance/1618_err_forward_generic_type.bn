package "main"

// A generic type has no forward declaration (gen.decl.definition): a forward
// `type Box` names a non-generic type, so a generic `type Box[T any]` in the
// same package is an error.  This program must fail to compile.
type Box

type Box[T any] struct { v T }

func main() {
	var b Box[int]
	b.v = 1
	_ = b
}
