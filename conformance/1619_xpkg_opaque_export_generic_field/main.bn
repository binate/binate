package "main"

import "pkg/builtins/testing"

import "pkg/a"

// A generic instance from another package may have a field that points to an
// aggregate of that package's own opaque export: the export is opaque only to
// other packages, and the field is the defining package's code.

func main() {
	var c a.Cell[int] = a.MakeCell(5)
	testing.Println(a.Sum(c))
}
