package "pkg/a"

// Box is exported opaquely: its definition is in the `.bn`.
type Box

// Cell holds a pointer to a pair of Boxes and a value of its own.
type Cell[T any] struct {
	pp *([2]Box)
	v  T
}

// MakeCell returns a Cell whose Boxes hold 10 and 20 and whose value is v.
func MakeCell(v int) Cell[int]

// Sum returns the Boxes' values plus c's value.
func Sum(c Cell[int]) int
