package "main"

import "pkg/builtins/testing"
import "pkg/fb"
import "pkg/fc"
import "pkg/fg"
import "pkg/fp"
import "pkg/ft"
import "pkg/gg"

// An imported package's floating-point constant expressions name that package's
// own imports (`a.A`, `a.Meters`), which the importer does not import — also
// through a constant of pkg/a naming pkg/b, read by its bare name in a generic
// body monomorphized here, naming only another package's type, and through
// another interface constant of the same package (also a bare group member,
// which repeats its predecessor's initializer): they have their values there.
// A generic type declared in a group, whose method calls a package this file
// does not import, works as one declared on its own.

func main() {
	fc.Nop()
	ft.Nop()
	testing.Println(cast(int, fc.X * 10.0), cast(int, fc.M * 10.0), cast(int, fc.Y * 100.0))
	testing.Println(cast(int, fc.Z * 10.0), cast(int, fg.G[int]() * 10.0), cast(int, ft.M2 * 10.0))
	var b @gg.Box[int] = make(gg.Box[int])
	testing.Println(cast(int, fp.P * 10.0), b.Get(), cast(int, fb.X * 10.0))
}
