package "main"

import "pkg/builtins/testing"

import "pkg/lib"

// A variable named like a generic type makes `Box[i]` an index, not an
// instantiation: a local shadowing this package's generic `Box`, and a local
// shadowing the import `lib`, whose generic `Box` shares a field's name.  A
// discarded read, a field read and method values off the element read it.
type Box[T any] struct { v T }

type P struct { n int }

func (p P) Get() int { return p.n }

type H struct { Box [2]P }

func main() {
	testing.Println(lib.Answer())
	var i int = 1
	{
		var Box [2]P
		Box[1].n = 7
		_ = Box[i].n
		f := Box[i].Get
		var g *func() int = Box[i].Get
		testing.Println(Box[i].n, f(), g())
	}
	{
		var lib H
		lib.Box[1].n = 9
		_ = lib.Box[i].n
		h := lib.Box[i].Get
		testing.Println(lib.Box[i].n, h())
	}
}
