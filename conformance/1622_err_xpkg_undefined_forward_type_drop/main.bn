package "main"

import "pkg/builtins/testing"

import "pkg/q"

// A package may declare a type it defines nowhere (`type X` in its .bn) and
// hold an `@X`, but releasing one needs X's destructor, which only X's
// definition supplies: with X defined nowhere in the program, it fails to link
// (on the VM: the function is not found when the release runs), naming
// `__dtor_X`.  This program must fail.

func main() {
	testing.Println(q.Probe())
}
