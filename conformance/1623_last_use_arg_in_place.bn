package "main"

import "pkg/builtins/testing"

// A local whose last use is a by-value argument may be passed without a copy: the
// callee gets the local itself and may write it, since nothing reads it afterwards.
// Every callee here writes its parameter, so a local shared by mistake shows: a last
// use; a local declared in a loop body, and one assigned whole each iteration; one
// changed but not reassigned in a loop (it must be copied: the next iteration reads
// it); one read after the call; one passed twice to the same call; one loaded before
// the call it is last passed to and used after it — as a later argument (`h(x,
// clobber(x))`), a multi-value return (`return x, clobber(x)`) and a parallel
// assignment (`y, r = x, clobber(x)`), where that load may alias x; one passed to a
// call returning a struct; a 21-byte byte array (its slot must be aligned for arm32's
// by-value word loads); a parameter passed on; and calls through a function value and
// an interface method.

type Big struct {
	n   int
	arr [100]int
}

interface User {
	Use(b Big) int
}

type M struct {
	base int
}

func (m *M) Use(b Big) int { return bumpSum(b) + m.base }

impl *M : User

func mk(k int) Big {
	var b Big
	b.n = k
	b.arr[k % 100] = k
	return b
}

func bumpSum(p Big) int {
	p.n = p.n + 100
	p.arr[0] = p.arr[0] + 1
	return p.n + p.arr[0] + p.arr[1]
}

func two(a Big, b Big) int {
	a.n = a.n + 1000
	return a.n + b.n
}

func clobber(p Big) int {
	p.n = p.n + 1000
	return 1
}

func h(a Big, r int) int { return a.n * 10 + r }

func early(k int) int {
	var x Big = mk(k)
	return h(x, clobber(x))
}

func earlyMulti(k int) (Big, int) {
	var x Big = mk(k)
	return x, clobber(x)
}

func earlyPar(k int) int {
	var x Big = mk(k)
	var y Big
	var r int
	y, r = x, clobber(x)
	return y.n * 10 + r
}

func transform(p Big) Big {
	var q Big = p
	q.n = q.n * 2
	q.arr[1] = q.arr[1] + 5
	return q
}

func viaTransform(k int) int {
	var x Big = mk(k)
	x.arr[1] = 1
	var y Big = transform(x)
	return y.n * 100 + y.arr[1]
}

func sumA(a [21]uint8) int {
	a[0] = a[0] + 1
	return cast(int, a[0]) + cast(int, a[20])
}

func bytes21(k int) int {
	var a [21]uint8
	a[0] = cast(uint8, k)
	a[20] = cast(uint8, k * 2)
	return sumA(a)
}

func lastUse(k int) int {
	var x Big = mk(k)
	x.n = x.n + 1
	return bumpSum(x)
}

func loopInside() int {
	var total int = 0
	for i := 0; i < 3; i++ {
		var x Big = mk(i)
		total = total + bumpSum(x)
	}
	return total
}

func loopWhole() int {
	var x Big
	var total int = 0
	for i := 0; i < 3; i++ {
		x = mk(i)
		total = total + bumpSum(x)
	}
	return total
}

func loopNoReinit() int {
	var x Big = mk(1)
	var total int = 0
	for i := 0; i < 3; i++ {
		x.n = x.n + 1
		total = total + bumpSum(x)
	}
	return total
}

func notLast(k int) int {
	var x Big = mk(k)
	var s int = bumpSum(x)
	return s + x.n
}

func twice(k int) int {
	var x Big = mk(k)
	return two(x, x)
}

func fwd(b Big) int { return bumpSum(b) }

func viaValues(k int) int {
	var fv *func(Big) int = bumpSum
	var x Big = mk(k)
	var a int = fv(x)
	var m M
	m.base = 10
	var u *User = &m
	var y Big = mk(k + 1)
	return a * 1000 + u.Use(y)
}

func main() {
	testing.Println(lastUse(3), loopInside(), loopWhole(), loopNoReinit())
	testing.Println(notLast(4), twice(5), early(3))
	m, mr := earlyMulti(3)
	testing.Println(m.n, mr, earlyPar(3), viaTransform(4), bytes21(5))
	var y Big = mk(6)
	testing.Println(fwd(y), y.n, y.arr[0])
	testing.Println(viaValues(7))
}
