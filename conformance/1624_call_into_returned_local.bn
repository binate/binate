package "main"

import "pkg/builtins/testing"

// A local returned at every return lives in the caller's result buffer, and a call
// whose result is stored into that local may write the buffer directly.  Each case
// checks that nothing can tell: a constructor filling the local from a call and then
// changing it; two levels of such constructors, so a chain of calls writes one buffer;
// `x = next(x)`, whose argument is read from x before the result lands in the buffer;
// recursion; the local stored from a call twice, a field read in between; a 20-byte
// result; and the local stored from a function value and from an interface method,
// which keep a temporary of their own.

type Big struct {
	n   int
	arr [30]int
}

type W5 struct {
	a [5]int32
}

interface Maker {
	Make(k int) Big
}

type M struct {
	base int
}

func (m *M) Make(k int) Big { return mk(k + m.base) }

impl *M : Maker

func mk(k int) Big {
	var b Big
	b.n = k
	b.arr[k % 30] = k
	return b
}

func next(a Big) Big {
	var r Big
	r.n = a.n + 1
	for i := 0; i < 30; i++ { r.arr[i] = a.arr[(i + 1) % 30] }
	return r
}

func fill(k int) Big {
	var b Big = mk(k)
	b.arr[29] = b.arr[29] + 100
	return b
}

func fill2(k int) Big {
	var x Big = fill(k)
	x.n = x.n * 10
	return x
}

func step(k int) Big {
	var x Big = mk(k)
	x = next(x)
	x = next(x)
	return x
}

func rec(n int) Big {
	var b Big
	if n == 0 {
		b = mk(1)
		return b
	}
	b = rec(n - 1)
	b.n = b.n + n
	return b
}

func twiceStored(k int) Big {
	var b Big = mk(k)
	var keep int = b.n
	b = mk(k + 1)
	b.arr[0] = keep
	return b
}

func viaFv(k int) Big {
	var f *func(int) Big = mk
	var b Big = f(k)
	b.arr[2] = b.arr[2] + 6
	return b
}

func viaIface(mi *Maker, k int) Big {
	var b Big = mi.Make(k)
	b.n = b.n + 1
	return b
}

func mkW5(k int) W5 {
	var w W5
	w.a[0] = cast(int32, k)
	w.a[4] = cast(int32, k + 1)
	return w
}

func fillW5(k int) W5 {
	var w W5 = mkW5(k)
	w.a[2] = 9
	return w
}

func check(b Big) int {
	var s int = b.n * 1000
	for i := 0; i < 30; i++ { s = s + b.arr[i] * (i + 1) }
	return s
}

func main() {
	testing.Println(check(fill(3)), check(fill2(4)))
	testing.Println(check(step(5)), check(rec(3)))
	var t Big = twiceStored(6)
	testing.Println(check(t))
	var w W5 = fillW5(7)
	testing.Println(w.a[0], w.a[2], w.a[4])
	var m M
	m.base = 10
	var mi *Maker = &m
	testing.Println(check(viaFv(4)), check(viaIface(mi, 2)))
}
