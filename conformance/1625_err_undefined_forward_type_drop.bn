package "main"

import "pkg/builtins/testing"

// The main package may declare a type it defines nowhere and hold an `@X`, but
// releasing one needs X's destructor, which only X's definition supplies: with
// X defined nowhere in the program, it fails to link (on the VM: the function
// is not found when the release runs), naming `__dtor_X`.  This program must
// fail.  The `@X` is a global, so no optimizer can prove the released value
// nil and drop the release (and with it the reference to `__dtor_X`).
type X

var g @X

func drop() int {
	g = nil
	return 1
}

func main() {
	testing.Println(drop())
}
