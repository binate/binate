package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A call's result is a temporary, and a consumer that keeps it — a return, a
// variable, a field — takes it over (spec mem.move): no reference is taken for the
// consumer and none released for the temporary.  Nothing but a reference count can
// tell: every shape here runs a hundred times, and the shared object's count comes
// back to where it was, higher only while a result holding it is live.  The shapes:
// a struct with a managed field and a managed pointer, returned through a chain of
// calls, stored into a variable, assigned, stored into a field, and produced by a
// function value and by an interface method; a struct stored into a slice element,
// a managed-slice literal, an array element, a struct literal's field and through a
// pointer, an array of them returned, a deferred call's argument, a method value's
// receiver and a range loop's operand.

type B struct {
	v int
}

type R struct {
	b   @B
	n   int
	pad [8]int
}

type H struct {
	r R
}

type Pair struct {
	r R
	k int
}

interface Maker {
	Make(k int) R
	Get() @B
}

type M struct {
	base int
}

var shared @B

func (m *M) Make(k int) R { return mk(k + m.base) }

func (m *M) Get() @B { return shared }

impl *M : Maker

func mk(k int) R {
	var r R
	r.b = shared
	r.n = k
	return r
}

func passOn(k int) R { return mk(k + 1) }

func passTwice(k int) R { return passOn(k + 1) }

func getB() @B { return shared }

func passB() @B { return getB() }

func initR(k int) int {
	var r R = passTwice(k)
	return r.n + r.b.v
}

func assignR(k int) int {
	var r R = mk(0)
	r = mk(k)
	r = passOn(k)
	return r.n
}

func fieldR(h *H, k int) int {
	h.r = passOn(k)
	return h.r.n
}

func viaFv(k int) int {
	var f *func(int) R = passOn
	var r R = f(k)
	var g *func() @B = getB
	var b @B = g()
	return r.n + b.v
}

func viaIface(mi *Maker, k int) int {
	var r R = mi.Make(k)
	var b @B = mi.Get()
	return r.n + b.v
}

func (r R) get() int { return r.n }

func sink(r R) int { return r.n }

func mkArr(k int) [2]R {
	var a [2]R
	a[0] = mk(k)
	a[1] = mk(k + 1)
	return a
}

func more(k int) int {
	var s @[]R = @[]R{mk(k), passOn(k)}
	s[0] = mk(k + 2)
	var a [2]R = mkArr(k)
	a[1] = passOn(k)
	var p Pair = Pair{r: mk(k), k: 1}
	var q *R = &p.r
	*q = passOn(k)
	defer sink(mk(k))
	var g *func() int = mk(k).get
	var t int = 0
	for e in mkArr(k) {
		t = t + e.n
	}
	return s[0].n + s[1].n + a[0].n + a[1].n + p.r.n + g() + t
}

func count() int { return rt.Refcount(bit_cast(*uint8, shared)) }

func holding() {
	var r R = passTwice(1)
	var b @B = passB()
	testing.Println(count(), r.n, b.v)
}

func main() {
	shared = make(B)
	shared.v = 100
	testing.Println(count())
	var m M
	m.base = 5
	var mi *Maker = &m
	var h H
	var sum int = 0
	for i := 0; i < 100; i++ {
		var r R = passTwice(i)
		var b @B = passB()
		sum = sum + r.n + b.v
		sum = sum + initR(i) + assignR(i) + fieldR(&h, i) + viaFv(i) + viaIface(mi, i) + more(i)
	}
	// h.r holds the shared object.
	testing.Println(count(), sum)
	holding()
	testing.Println(count())
}
