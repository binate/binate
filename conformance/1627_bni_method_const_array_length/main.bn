package "main"

import "pkg/builtins/testing"

import "pkg/q"

// A package interface's method may use the interface's own constant as an array
// length: the .bni declaration and the .bn definition agree on [N]int.

func main() {
	var t @q.T = q.Make()
	var a [q.N]int = t.First()
	testing.Println(len(a), a[0], a[2])
}
