package "main"

import "pkg/builtins/testing"

// `return *p` of an aggregate wider than 16 bytes reads *p in place, with no
// private copy first: into the caller's result buffer, which overlaps nothing the
// callee can reach, or into registers.  The checks: *p a caller's local, a heap
// object, an array element, a global, and a field; the result stored back over the
// object p points to (`x = get(&x)`, `h.b = get(&h.b)`); a 20-byte result; a
// 24-byte one read from an address 4- but not 8-aligned; four float64 fields (32
// bytes, returned in registers on aarch64); and one with a managed field, whose
// return takes a reference, so it still copies first.  The getters recurse on nil
// so that they are not inlined.

type Big struct {
	n   int
	arr [30]int
}

type W5 struct {
	a [5]int32
}

type W6 struct {
	a [6]int32
}

type O struct {
	k int32
	w W6
}

type F4 struct {
	a float64
	b float64
	c float64
	d float64
}

type M struct {
	s   @[]int
	pad [6]int
}

type H struct {
	k int
	b Big
}

var g Big

var gw W5

var gm M

var gw6 W6

var gf F4

func get(p *Big) Big {
	if p == nil { return get(&g) }
	return *p
}

func getW(p *W5) W5 {
	if p == nil { return getW(&gw) }
	return *p
}

func getW6(p *W6) W6 {
	if p == nil { return getW6(&gw6) }
	return *p
}

func getF(p *F4) F4 {
	if p == nil { return getF(&gf) }
	return *p
}

func getM(p *M) M {
	if p == nil { return getM(&gm) }
	return *p
}

func mk(k int) Big {
	var b Big
	b.n = k
	for i := 0; i < 30; i++ {
		b.arr[i] = k * 100 + i
	}
	return b
}

func check(b Big) int { return b.n + b.arr[0] + b.arr[29] }

func main() {
	var x Big = mk(1)
	var y Big = get(&x)
	testing.Println(check(y))
	var hp @Big = box(mk(2))
	testing.Println(check(get(hp)))
	var arr [3]Big
	arr[1] = mk(3)
	testing.Println(check(get(&arr[1])))
	g = mk(4)
	testing.Println(check(get(&g)))
	var h H
	h.b = mk(5)
	testing.Println(check(get(&h.b)))
	x = mk(6)
	x = get(&x)
	testing.Println(check(x))
	h.b = get(&h.b)
	testing.Println(check(h.b))
	var w W5
	w.a[0] = 7
	w.a[4] = 9
	var w2 W5 = getW(&w)
	testing.Println(w2.a[0], w2.a[4])
	var o O
	o.w.a[0] = 11
	o.w.a[5] = 16
	var w6 W6 = getW6(&o.w)
	testing.Println(w6.a[0], w6.a[5])
	var fl F4
	fl.a = 1.5
	fl.d = 4.25
	var f2 F4 = getF(&fl)
	testing.Println(cast(int, f2.a * 2.0), cast(int, f2.d * 4.0))
	var m M
	m.s = make_slice(int, 2)
	m.s[1] = 8
	var m2 M = getM(&m)
	m.s[1] = 10
	testing.Println(m2.s[1])
}
