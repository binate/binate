package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A local or parameter whose fields are only read on their own — `t := x.n`,
// `x.arr[i]` — is copied whole by reading it in place, with no private copy first:
// reading through a field changes none of its bytes.  The checks: such copies of a
// local, of a parameter, and of a struct with a managed field (its reference taken
// for the copy); and the cases that must still copy first — a field written through
// a pointer between the copy and its use, the struct reassigned whole while a copy
// of it is still in use, a field pointer escaping into a call.

type Big struct {
	n   int
	arr [20]int
}

type B struct {
	v int
}

type M struct {
	b   @B
	k   int
	pad [4]int
}

func mk(k int) Big {
	var b Big
	b.n = k
	for i := 0; i < 20; i++ {
		b.arr[i] = k * 10 + i
	}
	return b
}

func sum(b Big) int { return b.n + b.arr[0] + b.arr[19] }

func readThenCopy(k int) int {
	var x Big = mk(k)
	var t int = x.n + x.arr[3]
	var y Big = x
	return sum(y) + t
}

func paramRead(b Big) int {
	var t int = b.arr[19]
	var c Big = b
	return sum(c) + t
}

func writeThenUse(k int) int {
	var x Big = mk(k)
	var y Big = x
	var p *int = &x.n
	*p = 1000
	return y.n + x.n
}

func reassignWhileCopied(k int) int {
	var x Big = mk(k)
	var t int = x.arr[1]
	var y Big = x
	x = mk(k + 1)
	return y.arr[1] + t + x.arr[1]
}

func bump(p *int) { *p = *p + 1 }

func escapeField(k int) int {
	var x Big = mk(k)
	var y Big = x
	bump(&x.n)
	return y.n * 100 + x.n
}

func managedCopy() int {
	var m M
	m.b = make(B)
	m.b.v = 9
	m.k = 4
	var t int = m.k
	var c M = m
	var p *uint8 = bit_cast(*uint8, c.b)
	return c.b.v * 10 + t + rt.Refcount(p) * 1000
}

func main() {
	testing.Println(readThenCopy(2))
	testing.Println(paramRead(mk(3)))
	testing.Println(writeThenUse(4))
	testing.Println(reassignWhileCopied(5))
	testing.Println(escapeField(6))
	testing.Println(managedCopy())
}
