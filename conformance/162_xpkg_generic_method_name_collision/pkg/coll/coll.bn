package "pkg/coll"

// A generic-receiver method only the .bn defines (Box.Get) must not be paired
// with the .bni's same-named method of another type (Bag.Get) in the
// .bni→merged pairing, which would drop Bag.Get: sameFuncDecl must not
// false-match by an empty base name.

func (b @Box[T]) Get() T {
	return b.v
}

func BoxGet(b @Box[int]) int { return b.Get() }
