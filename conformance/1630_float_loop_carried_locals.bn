package "main"

import "pkg/builtins/testing"

// Float locals carried around loops and joined at merges.  At -O1 and above (and
// always in the VM) mem2reg turns each into SSA values joined by float phis, which
// the VM and the native backends lower to float copies, one per incoming edge (a
// float64 on a 32-bit target is a two-word copy).  Every result is pinned
// bit-exactly via bit_cast.

// escape runs the mandelbrot step z := z*z + c with four float64 values carried
// around the loop, and returns the iteration count and the final |z|*|z|.
func escape(cr float64, ci float64, limit int) (int, float64) {
	var zr float64 = 0.0
	var zi float64 = 0.0
	var tr float64 = 0.0
	var ti float64 = 0.0
	var i int = 0
	for i < limit && tr + ti <= 4.0 {
		zi = 2.0 * zr * zi + ci
		zr = tr - ti + cr
		tr = zr * zr
		ti = zi * zi
		i++
	}
	return i, tr + ti
}

// sum32 adds a float32 step n times; each add rounds to float32.
func sum32(n int) float32 {
	var s float32 = 0.0
	var step float32 = 0.1
	for i := 0; i < n; i++ {
		s = s + step
	}
	return s
}

// swapEach swaps x and y every iteration: the back edge's copies x <- y and
// y <- x form a cycle, which phi elimination breaks with a temporary.
func swapEach(x float64, y float64, n int) float64 {
	for i := 0; i < n; i++ {
		var t float64 = x
		x = y
		y = t
	}
	return x - y
}

// swapEach32 is swapEach for float32.
func swapEach32(x float32, y float32, n int) float32 {
	for i := 0; i < n; i++ {
		var t float32 = x
		x = y
		y = t
	}
	return x - y
}

func half(x float64) float64 {
	return x * 0.5
}

// acrossCalls keeps a float64 accumulator, and a float64 loop constant, live
// across a call in every iteration.  The call goes through a function value, so it
// stays a call however the optimizer inlines.
func acrossCalls(n int, step @func(float64) float64) float64 {
	var acc float64 = 1.0
	var k float64 = 3.0
	for i := 0; i < n; i++ {
		acc = step(acc) + k
	}
	return acc
}

// acrossCallsMany carries twelve float64 values across a call (through a function
// value, as in acrossCalls) in every iteration.  A value live across a call needs a
// callee-saved home, and no backend has twelve (aarch64 has eight, x64 none), so
// some of them live in slots and their back-edge copies move between slots and
// homes.
func acrossCallsMany(n int, step @func(float64) float64) float64 {
	var a0 float64 = 1.0
	var a1 float64 = 2.0
	var a2 float64 = 3.0
	var a3 float64 = 4.0
	var a4 float64 = 5.0
	var a5 float64 = 6.0
	var a6 float64 = 7.0
	var a7 float64 = 8.0
	var a8 float64 = 9.0
	var a9 float64 = 10.0
	var a10 float64 = 11.0
	var a11 float64 = 12.0
	for i := 0; i < n; i++ {
		var h float64 = step(a0)
		a0 = a1 + h
		a1 = a2 - h
		a2 = a3 + h
		a3 = a4 - h
		a4 = a5 + h
		a5 = a6 - h
		a6 = a7 + h
		a7 = a8 - h
		a8 = a9 + h
		a9 = a10 - h
		a10 = a11 + h
		a11 = a0 * 0.5
	}
	return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
}

// pressure carries twelve float64 values around one loop — more than the x64 and
// arm32 backends have float registers to home them in.
func pressure(n int) float64 {
	var a0 float64 = 1.0
	var a1 float64 = 2.0
	var a2 float64 = 3.0
	var a3 float64 = 4.0
	var a4 float64 = 5.0
	var a5 float64 = 6.0
	var a6 float64 = 7.0
	var a7 float64 = 8.0
	var a8 float64 = 9.0
	var a9 float64 = 10.0
	var a10 float64 = 11.0
	var a11 float64 = 12.0
	for i := 0; i < n; i++ {
		a0 = a0 + a1 * 0.5
		a1 = a1 - a2 * 0.25
		a2 = a2 + a3 * 0.125
		a3 = a3 - a4 * 0.5
		a4 = a4 + a5 * 0.25
		a5 = a5 - a6 * 0.125
		a6 = a6 + a7 * 0.5
		a7 = a7 - a8 * 0.25
		a8 = a8 + a9 * 0.125
		a9 = a9 - a10 * 0.5
		a10 = a10 + a11 * 0.25
		a11 = a11 - a0 * 0.125
	}
	return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11
}

// pick joins two float32 values at an if/else merge.
func pick(c bool, x float32) float32 {
	var r float32
	if c {
		r = x * 2.0
	} else {
		r = x - 1.0
	}
	return r + 0.25
}

// negZero carries a negative zero around a loop that swaps it with another; its
// sign bit must survive every copy.
func negZero(n int) float64 {
	var z float64 = 0.0
	z = -z
	var w float64 = z
	for i := 0; i < n; i++ {
		var t float64 = w
		w = z
		z = t
	}
	return w
}

// mixed carries a float32 and a float64 accumulator that read each other.
func mixed(n int) float64 {
	var s32 float32 = 0.0
	var s64 float64 = 0.0
	for i := 0; i < n; i++ {
		s32 = s32 + cast(float32, i) * 0.1
		s64 = s64 + cast(float64, s32) * 0.25
	}
	return s64
}

// lastAbove returns the last running value above the threshold, or zero when none
// is: z is declared without a value, so a read before any assignment is its zero.
func lastAbove(n int, threshold float64) float64 {
	var z float64
	var v float64 = 0.0
	for i := 0; i < n; i++ {
		v = v + 1.5
		if v > threshold {
			z = v
		}
	}
	return z
}

// nested carries one float64 across an inner loop that carries another.
func nested(n int) float64 {
	var total float64 = 0.0
	for i := 0; i < n; i++ {
		var row float64 = 0.0
		for j := 0; j < n; j++ {
			row = row + cast(float64, i * n + j) * 0.125
		}
		total = total + row * row
	}
	return total
}

func main() {
	var n int
	var m float64
	n, m = escape(-0.5, 0.5, 50)
	testing.Println(n)
	testing.Println(bit_cast(int64, m))
	n, m = escape(0.25, 0.75, 50)
	testing.Println(n)
	testing.Println(bit_cast(int64, m))
	testing.Println(bit_cast(int32, sum32(10)))
	testing.Println(bit_cast(int64, swapEach(1.25, -3.5, 7)))
	testing.Println(bit_cast(int64, swapEach(1.25, -3.5, 8)))
	testing.Println(bit_cast(int32, swapEach32(1.25, -3.5, 7)))
	var step @func(float64) float64 = half
	testing.Println(bit_cast(int64, acrossCalls(20, step)))
	testing.Println(bit_cast(int64, acrossCallsMany(9, step)))
	testing.Println(bit_cast(int64, pressure(10)))
	testing.Println(bit_cast(int32, pick(true, 1.5)))
	testing.Println(bit_cast(int32, pick(false, 1.5)))
	testing.Println(bit_cast(int64, negZero(3)))
	testing.Println(bit_cast(int64, mixed(9)))
	testing.Println(bit_cast(int64, lastAbove(5, 4.0)))
	testing.Println(bit_cast(int64, lastAbove(5, 100.0)))
	testing.Println(bit_cast(int64, nested(6)))
}
