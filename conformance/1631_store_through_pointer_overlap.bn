package "main"

import "pkg/builtins/testing"

// `*dst = *src` for an aggregate wider than 16 bytes, with nothing between the load
// and the store, may copy straight from *src to *dst with no private copy first — the
// copy loads all of *src before storing any of it, so it is right even when *dst
// overlaps *src.  The checks: such stores for 20- to 812-byte structs whose two
// pointers overlap by all but 8 bytes, in both directions (each must act as if *src
// were read whole first); an 812-byte one overlapping by all but 36, and one onto
// itself; and non-overlapping stores into a field and into a global.  Sizes that are not a multiple of the 8-, 16- or
// 32-byte chunks such a copy moves leave a part over, which must still be read before
// it is overwritten.

type S5 struct {
	a [5]int32
}

type S6 struct {
	a [6]int32
}

type S9 struct {
	a [9]int32
}

type S10 struct {
	a [10]int32
}

type S12 struct {
	a [12]int32
}

type S16 struct {
	a [16]int32
}

type S18 struct {
	a [18]int32
}

type S25 struct {
	a [25]int32
}

type S200 struct {
	a [200]int32
}

type S203 struct {
	a [203]int32
}

type H struct {
	k int32
	s S10
}

var buf [216]int32

func fill() {
	for i := 0; i < 216; i++ {
		buf[i] = cast(int32, i + 1)
	}
}

// show prints buf[0..n) as one line.
func show(n int) {
	var t int = 0
	for i := 0; i < n; i++ {
		t = t * 3 + cast(int, buf[i]) % 7
		t = t % 1000003
	}
	testing.Println(n, t)
}

func up5() {
	fill()
	var src *S5 = bit_cast(*S5, &buf[0])
	var dst *S5 = bit_cast(*S5, &buf[2])
	*dst = *src
	show(7)
}

func down5() {
	fill()
	var src *S5 = bit_cast(*S5, &buf[2])
	var dst *S5 = bit_cast(*S5, &buf[0])
	*dst = *src
	show(7)
}

