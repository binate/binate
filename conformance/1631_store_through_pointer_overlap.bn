package "main"

import "pkg/builtins/testing"

// `*dst = *src` for an aggregate wider than 16 bytes, with nothing between the load
// and the store, may copy straight from *src to *dst with no private copy first — the
// copy loads all of *src before storing any of it, so it is right even when *dst
// overlaps *src.  The checks: such stores for 20-, 24-, 36-, 40-, 48- and 64-byte
// structs whose two pointers overlap by all but 8 bytes, in both directions (each
// must act as if *src were read whole first), and a non-overlapping store into a
// field.  20 and 36 bytes are not a multiple of the 8- or 16-byte chunks such a copy
// can move, so its last chunk overlaps the one before it.

type S5 struct {
	a [5]int32
}

type S6 struct {
	a [6]int32
}

type S9 struct {
	a [9]int32
}

type S10 struct {
	a [10]int32
}

type S12 struct {
	a [12]int32
}

type S16 struct {
	a [16]int32
}

type H struct {
	k int32
	s S10
}

var buf [24]int32

func fill() {
	for i := 0; i < 24; i++ {
		buf[i] = cast(int32, i + 1)
	}
}

// show prints buf[0..n) as one line.
func show(n int) {
	var t int = 0
	for i := 0; i < n; i++ {
		t = t * 3 + cast(int, buf[i]) % 7
		t = t % 1000003
	}
	testing.Println(n, t)
}

func up5() {
	fill()
	var src *S5 = bit_cast(*S5, &buf[0])
	var dst *S5 = bit_cast(*S5, &buf[2])
	*dst = *src
	show(7)
}

func down5() {
	fill()
	var src *S5 = bit_cast(*S5, &buf[2])
	var dst *S5 = bit_cast(*S5, &buf[0])
	*dst = *src
	show(7)
}

func up6() {
	fill()
	var src *S6 = bit_cast(*S6, &buf[0])
	var dst *S6 = bit_cast(*S6, &buf[2])
	*dst = *src
	show(8)
}

func down6() {
	fill()
	var src *S6 = bit_cast(*S6, &buf[2])
	var dst *S6 = bit_cast(*S6, &buf[0])
	*dst = *src
	show(8)
}

func up9() {
	fill()
	var src *S9 = bit_cast(*S9, &buf[0])
	var dst *S9 = bit_cast(*S9, &buf[2])
	*dst = *src
	show(11)
}

func down9() {
	fill()
	var src *S9 = bit_cast(*S9, &buf[2])
	var dst *S9 = bit_cast(*S9, &buf[0])
	*dst = *src
	show(11)
}

func up10() {
	fill()
	var src *S10 = bit_cast(*S10, &buf[0])
	var dst *S10 = bit_cast(*S10, &buf[2])
	*dst = *src
	show(12)
}

func down10() {
	fill()
	var src *S10 = bit_cast(*S10, &buf[2])
	var dst *S10 = bit_cast(*S10, &buf[0])
	*dst = *src
	show(12)
}

func up12() {
	fill()
	var src *S12 = bit_cast(*S12, &buf[0])
	var dst *S12 = bit_cast(*S12, &buf[2])
	*dst = *src
	show(14)
}

func down12() {
	fill()
	var src *S12 = bit_cast(*S12, &buf[2])
	var dst *S12 = bit_cast(*S12, &buf[0])
	*dst = *src
	show(14)
}

func up16() {
	fill()
	var src *S16 = bit_cast(*S16, &buf[0])
	var dst *S16 = bit_cast(*S16, &buf[2])
	*dst = *src
	show(18)
}

func down16() {
	fill()
	var src *S16 = bit_cast(*S16, &buf[2])
	var dst *S16 = bit_cast(*S16, &buf[0])
	*dst = *src
	show(18)
}

func intoField(h *H, p *S10) {
	h.s = *p
}

func main() {
	up5()
	down5()
	up6()
	down6()
	up9()
	down9()
	up10()
	down10()
	up12()
	down12()
	up16()
	down16()
	var h H
	var s S10
	for i := 0; i < 10; i++ {
		s.a[i] = cast(int32, 50 + i)
	}
	intoField(&h, &s)
	testing.Println(h.s.a[0], h.s.a[9], h.k)
}
