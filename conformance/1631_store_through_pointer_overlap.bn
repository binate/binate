func up203far() {
	fill()
	var src *S203 = bit_cast(*S203, &buf[0])
	var dst *S203 = bit_cast(*S203, &buf[9])
	*dst = *src
	show(212)
}

func down203far() {
	fill()
	var src *S203 = bit_cast(*S203, &buf[9])
	var dst *S203 = bit_cast(*S203, &buf[0])
	*dst = *src
	show(212)
}

func same203() {
	fill()
	var src *S203 = bit_cast(*S203, &buf[3])
	var dst *S203 = bit_cast(*S203, &buf[3])
	*dst = *src
	show(210)
}

var gBig S203

func intoGlobal(p *S203) {
	gBig = *p
}

func intoField(h *H, p *S10) {
	h.s = *p
}

func main() {
	up5()
	down5()
	up6()
	down6()
	up9()
	down9()
	up10()
	down10()
	up12()
	down12()
	up16()
	down16()
	up18()
	down18()
	up25()
	down25()
	up200()
	down200()
	up203()
	down203()
	up203far()
	down203far()
	same203()
	fill()
	intoGlobal(bit_cast(*S203, &buf[5]))
	testing.Println(gBig.a[0], gBig.a[101], gBig.a[202])
	var h H
	var s S10
	for i := 0; i < 10; i++ {
		s.a[i] = cast(int32, 50 + i)
	}
	intoField(&h, &s)
	testing.Println(h.s.a[0], h.s.a[9], h.k)
}
