package "main"
import "pkg/builtins/testing"

import "pkg/f"

// An expose re-exports the exposed package's surface: a generic type only its
// .bn declares is not part of it, so it neither collides with the forwarder's
// own declaration of the name nor shadows it.

func main() {
	var h @f.Hidden = make(f.Hidden)
	h.x = 5
	testing.Println(h.x + f.V())
}
