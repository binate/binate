package "main"

import "pkg/builtins/testing"

// An int64 index is bounds-checked as its whole 64-bit value.  4294967297 is
// 2^32 + 1: its low 32-bit word alone (1) is in range, so a check of only that
// word would let the store go through to a[1].  It must trap.
func main() {
	var a [3]int
	var i int64 = 4294967297
	a[i] = 7
	testing.Println(a[1])
}
