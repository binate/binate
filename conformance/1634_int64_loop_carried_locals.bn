package "main"

import "pkg/builtins/testing"

// int64 / uint64 locals carried around loops and joined at merges.  On a 32-bit
// target each is a two-word value: at -O1 and above (and always in the VM)
// mem2reg turns them into SSA values joined by 64-bit phis, which the backends
// lower to two-word copies, one per incoming edge.

// sumAcross adds a step that carries into the high word.
func sumAcross(n int) int64 {
	var s int64 = 4294967000
	var step int64 = 100
	for i := 0; i < n; i++ {
		s = s + step
	}
	return s
}

// wrapU64 counts a uint64 down past zero, wrapping around its range.
func wrapU64(n int) uint64 {
	var u uint64 = 3
	for i := 0; i < n; i++ {
		u = u - 1
	}
	return u
}

// swap64 swaps x and y every iteration: the back edge's copies x <- y and y <- x
// form a cycle, which phi elimination breaks with a temporary.
func swap64(x int64, y int64, n int) int64 {
	for i := 0; i < n; i++ {
		var t int64 = x
		x = y
		y = t
	}
	return x - y
}

// fib64 carries two int64 values past the 32-bit range.
func fib64(n int) int64 {
	var a int64 = 0
	var b int64 = 1
	for i := 0; i < n; i++ {
		var t int64 = a + b
		a = b
		b = t
	}
	return a
}

// mulAcc keeps int64 values live across a multiply, which a 32-bit target lowers
// to a library call.
func mulAcc(n int) int64 {
	var acc int64 = 1
	var k int64 = 3
	for i := 0; i < n; i++ {
		acc = acc * k + cast(int64, i)
	}
	return acc
}

// divDown divides an int64 by 3 (a library call on a 32-bit target) until it is
// small, counting the steps.
func divDown(x int64) int {
	var steps int = 0
	for x > 7 {
		x = x / 3
		steps++
	}
	return steps
}

func addSeven(x int64) int64 {
	return x + 7
}

// acrossCalls carries six int64 values across a call through a function value (so
// it stays a call however the optimizer inlines) in every iteration.
func acrossCalls(n int, f @func(int64) int64) int64 {
	var a0 int64 = 1
	var a1 int64 = 2
	var a2 int64 = 3
	var a3 int64 = 4
	var a4 int64 = 5
	var a5 int64 = 6
	for i := 0; i < n; i++ {
		var h int64 = f(a0)
		a0 = a1 + h
		a1 = a2 - h
		a2 = a3 + h
		a3 = a4 - h
		a4 = a5 + h
		a5 = a0 * 2
	}
	return a0 + a1 + a2 + a3 + a4 + a5
}

// pick joins two int64 values at an if/else merge.
func pick(c bool, x int64) int64 {
	var r int64
	if c {
		r = x << 33
	} else {
		r = -x
	}
	return r + 1
}

// lastBig returns the last running value above the threshold, or zero when none is:
// z is declared without a value, so a read before any assignment is its zero.
func lastBig(n int, threshold int64) int64 {
	var z int64
	var v int64 = 0
	for i := 0; i < n; i++ {
		v = v + 1000000000
		if v > threshold {
			z = v
		}
	}
	return z
}

// Pair is split into its fields by SROA and each field promoted by mem2reg.
type Pair struct {
	lo int64
	hi uint64
}

// pairWalk carries a struct of two 64-bit fields around a loop.
func pairWalk(n int) int64 {
	var p Pair
	p.lo = 3000000000
	p.hi = 1
	for i := 0; i < n; i++ {
		p.lo = p.lo + cast(int64, p.hi)
		p.hi = p.hi * 2
	}
	return p.lo + cast(int64, p.hi)
}

// countAbove counts down a uint64 from just above 2^63 and counts the values
// still above 2^63 - 2 — an unsigned compare across the sign bit of the word pair.
func countAbove(n int) int {
	var u uint64 = 9223372036854775810
	var c int = 0
	for i := 0; i < n; i++ {
		if u > 9223372036854775806 {
			c++
		}
		u = u - 1
	}
	return c
}

func main() {
	testing.Println(sumAcross(10))
	testing.Println(cast(int64, wrapU64(5)))
	testing.Println(swap64(5000000000, -3, 7))
	testing.Println(swap64(5000000000, -3, 8))
	testing.Println(fib64(60))
	testing.Println(mulAcc(30))
	testing.Println(divDown(9000000000000))
	var f @func(int64) int64 = addSeven
	testing.Println(acrossCalls(9, f))
	testing.Println(pick(true, 3))
	testing.Println(pick(false, 5000000000))
	testing.Println(lastBig(6, 3500000000))
	testing.Println(lastBig(6, 9000000000))
	testing.Println(pairWalk(40))
	testing.Println(countAbove(6))
}
