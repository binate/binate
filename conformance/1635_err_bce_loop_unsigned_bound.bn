package "main"

import "pkg/builtins/testing"

// A loop over an array with a uint64 index and a bound of 2^64 - 1 keeps its
// bounds check: the guard u < 18446744073709551615 compares unsigned, so it does
// not keep u below the array's length, and the access at u == 3 must trap.  (At
// -O1 and above loop bounds-check elimination looks at this loop; read signed,
// the bound would be -1 and pass for any length.)
func main() {
	var arr [3]int
	arr[0] = 1
	arr[1] = 2
	arr[2] = 3
	var s int = 0
	for u := cast(uint64, 0); u < 18446744073709551615; u++ {
		s = s + arr[u]
		if u == 5 {
			break
		}
	}
	testing.Println(s)
}
