package "main"

import "pkg/builtins/testing"

// Indexes and slice bounds of type int64 / uint64 — wider than int on a 32-bit
// target — that are in range reach exactly the element their full value names, in
// every form: a read, a store, a compound assignment, an address, a sub-slice of
// an array and of a managed-slice, a raw-pointer index and an unsafe_index.
func main() {
	var a [5]int
	for i := cast(int64, 0); i < 5; i++ {
		a[i] = cast(int, i) * 10
	}
	var u uint64 = 3
	testing.Println(a[u])
	var s @[]int = make_slice(int, 4)
	var j int64 = 2
	s[j] = 7
	s[j] += 1
	testing.Println(s[j])
	var p *int = &a[j]
	testing.Println(*p)
	var lo int64 = 1
	var hi uint64 = 4
	var sub *[]int = a[lo:hi]
	testing.Println(len(sub))
	testing.Println(sub[cast(int64, 0)])
	var t @[]int = s[lo:]
	testing.Println(len(t))
	testing.Println(t[cast(uint64, 1)])
	var r *int = &a[0]
	testing.Println(r[j])
	testing.Println(unsafe_index(s, j))
}
