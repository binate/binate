package "main"

import "pkg/builtins/testing"

// A slice bound of type int64 is checked as its whole value.  4294967298 is
// 2^32 + 2: its low 32-bit word alone (2) is within the length, so a check of only
// that word would make s[0:2].  It must trap.
func main() {
	var s @[]int = make_slice(int, 3)
	var hi int64 = 4294967298
	var t @[]int = s[0:hi]
	testing.Println(len(t))
}
