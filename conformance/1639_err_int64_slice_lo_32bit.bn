package "main"

import "pkg/builtins/testing"

// A sub-slice's lo bound of type int64 is checked as its whole value.
// 4294967297 is 2^32 + 1: its low 32-bit word alone (1) is within the bounds, so a
// check of only that word would make s[1:].  It must trap.
func main() {
	var s @[]int = make_slice(int, 3)
	var lo int64 = 4294967297
	var t @[]int = s[lo:]
	testing.Println(len(t))
}
