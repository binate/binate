package "main"

import "pkg/builtins/testing"

// An int64 index into a managed-slice is checked as its whole value: 4294967297
// is 2^32 + 1, whose low 32-bit word alone (1) would be in range.  It must trap.
func main() {
	var s @[]int = make_slice(int, 3)
	var i int64 = 4294967297
	testing.Println(s[i])
}
