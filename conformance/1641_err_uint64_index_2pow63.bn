package "main"

import "pkg/builtins/testing"

// A uint64 index of 2^63 is out of range, whatever the target: a 32-bit target
// sees a nonzero high word, a signed 64-bit compare sees a negative value.  The
// fault reports the index's bits read as an int64, as it does for any uint64
// index of 2^63 or more.
func main() {
	var a [3]int
	var u uint64 = 9223372036854775808
	testing.Println(a[u])
}
