package "main"

import "pkg/builtins/testing"

// Homogeneous float aggregates (1-4 same-width float members, a nested struct or array
// flattened) as arguments and results, in every shape.  aarch64 and arm32 hard-float
// pass and return such an aggregate in consecutive float registers, so each shape —
// member count, member width, array or struct, nested — is its own register layout.
// Each function takes the aggregate and returns a rearranged copy; the caller prints
// every member.

type F1 struct { a float32 }

type F2 struct { a float32; b float32 }

type F3 struct { a float32; b float32; c float32 }

type F4 struct { a float32; b float32; c float32; d float32 }

type D1 struct { a float64 }

type D2 struct { a float64; b float64 }

type D3 struct { a float64; b float64; c float64 }

type D4 struct { a float64; b float64; c float64; d float64 }

// N3 is a nested struct of three float32 members.
type N3 struct { p F2; q float32 }

// ND nests an array and a struct: three float64 members.
type ND struct { p [2]float64; q D1 }

func f1(v F1) F1 { return F1{a: v.a + 1.0} }

func f2(v F2) F2 { return F2{a: v.b, b: v.a} }

func f3(v F3) F3 { return F3{a: v.c, b: v.a, c: v.b} }

func f4(v F4) F4 { return F4{a: v.d, b: v.c, c: v.b, d: v.a} }

func d1(v D1) D1 { return D1{a: v.a * 2.0} }

func d2(v D2) D2 { return D2{a: v.b, b: v.a} }

func d3(v D3) D3 { return D3{a: v.c, b: v.a, c: v.b} }

func d4(v D4) D4 { return D4{a: v.d, b: v.c, c: v.b, d: v.a} }

func a2(v [2]float32) [2]float32 { return [2]float32{v[1], v[0]} }

func a4(v [4]float64) [4]float64 { return [4]float64{v[3], v[2], v[1], v[0]} }

func n3(v N3) N3 { return N3{p: F2{a: v.q, b: v.p.a}, q: v.p.b} }

func nd(v ND) ND { return ND{p: [2]float64{v.q.a, v.p[0]}, q: D1{a: v.p[1]}} }

func main() {
	var g1 F1 = f1(F1{a: 1.5})
	testing.Println(g1.a)
	var g2 F2 = f2(F2{a: 1.5, b: 2.5})
	testing.Println(g2.a, g2.b)
	var g3 F3 = f3(F3{a: 1.5, b: 2.5, c: 3.5})
	testing.Println(g3.a, g3.b, g3.c)
	var g4 F4 = f4(F4{a: 1.5, b: 2.5, c: 3.5, d: 4.5})
	testing.Println(g4.a, g4.b, g4.c, g4.d)
	var e1 D1 = d1(D1{a: 1.25})
	testing.Println(e1.a)
	var e2 D2 = d2(D2{a: 1.25, b: 2.25})
	testing.Println(e2.a, e2.b)
	var e3 D3 = d3(D3{a: 1.25, b: 2.25, c: 3.25})
	testing.Println(e3.a, e3.b, e3.c)
	var e4 D4 = d4(D4{a: 1.25, b: 2.25, c: 3.25, d: 4.25})
	testing.Println(e4.a, e4.b, e4.c, e4.d)
	var r2 [2]float32 = a2([2]float32{5.5, 6.5})
	testing.Println(r2[0], r2[1])
	var r4 [4]float64 = a4([4]float64{5.25, 6.25, 7.25, 8.25})
	testing.Println(r4[0], r4[1], r4[2], r4[3])
	var m3 N3 = n3(N3{p: F2{a: 9.5, b: 10.5}, q: 11.5})
	testing.Println(m3.p.a, m3.p.b, m3.q)
	var md ND = nd(ND{p: [2]float64{12.5, 13.5}, q: D1{a: 14.5}})
	testing.Println(md.p[0], md.p[1], md.q.a)
}
