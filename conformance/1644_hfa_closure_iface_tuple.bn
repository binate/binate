package "main"

import "pkg/builtins/testing"

// Homogeneous float aggregates (1-4 same-width float members) through a capturing
// closure — an aggregate capture and float captures sharing the float registers with an
// aggregate parameter — an interface method taking and returning them, and multi-value
// returns with aggregate fields, which return in core registers, a float scalar field
// beside them in a float register.

type F2 struct { a float32; b float32 }

type F3 struct { a float32; b float32; c float32 }

type D2 struct { a float64; b float64 }

type D3 struct { a float64; b float64; c float64 }

type D4 struct { a float64; b float64; c float64; d float64 }

func w(x float32) float64 { return cast(float64, x) }

func mkc(k D2, c1 float64, c2 float64, c3 float64, c4 float64) @func(F3, float32) D3 {
	return func(v F3, s float32) D3 {
		return D3{a: k.a + c1 + w(v.a), b: k.b + c2 + c3 + w(v.b), c: c4 + w(v.c) + w(s)}
	}
}

// Op maps a three-float64 aggregate to a two-float32 one.
interface Op {
	Apply(v D3, s float32) F2
}

// Scale is an Op.
type Scale struct { k float32 }

impl *Scale : Op

func (p *Scale) Apply(v D3, s float32) F2 {
	return F2{a: cast(float32, v.a) * p.k + s, b: cast(float32, v.c) * p.k}
}

func t1(a float32) (F2, int32) { return F2{a: a, b: a + 1.0}, 7 }

func t2(a float32) (float32, F2) { return a, F2{a: a + 1.0, b: a + 2.0} }

func t3(a float64) (D4, float64) { return D4{a: a, b: a + 1.0, c: a + 2.0, d: a + 3.0}, a + 4.0 }

func t4(a float64) ([2]float64, int32) { return [2]float64{a, a * 2.0}, 9 }

func t5(a float32) (F2, F2, F2, F2, F2) {
	return F2{a: a, b: a + 1.0}, F2{a: a + 2.0, b: a + 3.0}, F2{a: a + 4.0, b: a + 5.0},
			F2{a: a + 6.0, b: a + 7.0}, F2{a: a + 8.0, b: a + 9.0}
}

func main() {
	var c @func(F3, float32) D3 = mkc(D2{a: 1.0, b: 2.0}, 10.0, 20.0, 30.0, 40.0)
	var r D3 = c(F3{a: 0.5, b: 1.5, c: 2.5}, 3.5)
	testing.Println(r.a, r.b, r.c)

	var s Scale
	s.k = 2.0
	var op *Op = &s
	var g F2 = op.Apply(D3{a: 1.5, b: 0.0, c: 2.5}, 0.25)
	testing.Println(g.a, g.b)

	v1, n1 := t1(1.5)
	testing.Println(v1.a, v1.b, n1)
	x2, v2 := t2(2.5)
	testing.Println(x2, v2.a, v2.b)
	v3, x3 := t3(1.25)
	testing.Println(v3.a, v3.b, v3.c, v3.d, x3)
	v4, n4 := t4(1.5)
	testing.Println(v4[0], v4[1], n4)
	p1, p2, p3, p4, p5 := t5(0.5)
	testing.Println(p1.a, p2.b, p3.a, p4.b, p5.a, p5.b)

	var ft *func(float32) (F2, int32) = t1
	fv, fn := ft(4.5)
	testing.Println(fv.a, fv.b, fn)
}
