package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// A method only a package's .bn declares is private to it, but an impl in that
// .bn may bind it, so importers reach it through the interface — here through an
// interface value the package itself makes.

func main() {
	var d @lib.D = lib.MakeD(4)
	testing.Println(d.dbl(), lib.Make(5).Get())
}
