package "main"

import "pkg/builtins/testing"

// A package float constant computed from integer constants is the same value at every
// use as the constant expression it spells — whether it narrows a negative literal to a
// typed int, or does signed untyped arithmetic (a negative difference divided or
// shifted).  The checks: `cast(float64, cast(int8, -1))`, a product of one, an iota group
// negating iota, a wider int, an int64 past 32 bits, a typed use of a named constant,
// and `cast(float64, 0 - 5)`, `(0 - 7) / 2` and `(0 - 16) >> 2`.

const F float64 = cast(float64, cast(int8, -1))
const G = cast(float64, cast(int8, -3)) * 2.0
const (
	P float64 = cast(float64, cast(int8, -iota))
	Q
	R
)
const U float64 = cast(float64, cast(int16, -300))
const W float64 = cast(float64, cast(int64, -5000000000))
const N int8 = -7
const M float64 = cast(float64, N) * 3.0
const Z1 float64 = cast(float64, 0 - 5)
const Z2 float64 = cast(float64, (0 - 7) / 2)
const Z3 float64 = cast(float64, (0 - 16) >> 2)

func main() {
	var f float64 = F
	var g float64 = G
	testing.Println(cast(int, f), cast(int, g))
	var p float64 = P
	var q float64 = Q
	var r float64 = R
	testing.Println(cast(int, p), cast(int, q), cast(int, r))
	var u float64 = U
	var w float64 = W
	testing.Println(cast(int, u), w == -5000000000.0)
	var m float64 = M
	testing.Println(cast(int, m))
	var z1 float64 = Z1
	var z2 float64 = Z2
	var z3 float64 = Z3
	testing.Println(cast(int, z1), cast(int, z2), cast(int, z3))
}
