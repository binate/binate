package "main"

import "pkg/builtins/testing"

// A float constant in an iota group computed from signed untyped arithmetic over iota
// is, for every member, the value its expression spells at that member's iota: the
// arithmetic is exact (a negative difference stays negative, `/` truncates toward
// zero, `>>` rounds toward −∞) before the conversion to float.  The checks: `iota -
// 5`, `(iota - 7) / 2`, `(iota - 16) >> 2` and a narrowing `cast(int64, iota - 1)`,
// each over a few members; a function-local group; and a local member named like a
// package constant its repeated initializer reads — which, as for the explicit
// member, is the package constant (the member's own scope starts after it).

const (
	X0 float64 = cast(float64, iota - 5)
	X1
)

const (
	D0 float64 = cast(float64, (iota - 7) / 2)
	D1
	D2
)

const (
	S0 float64 = cast(float64, (iota - 16) >> 2)
	S1
	S2
	S3
	S4
)

const (
	W0 float64 = cast(float64, cast(int64, iota - 1))
	W1
)

const K = 10

func main() {
	var x0 float64 = X0
	var x1 float64 = X1
	testing.Println(cast(int, x0), cast(int, x1))
	var d0 float64 = D0
	var d1 float64 = D1
	var d2 float64 = D2
	testing.Println(cast(int, d0), cast(int, d1), cast(int, d2))
	var s0 float64 = S0
	var s1 float64 = S1
	var s4 float64 = S4
	testing.Println(cast(int, s0), cast(int, s1), cast(int, s4))
	var w0 float64 = W0
	var w1 float64 = W1
	testing.Println(cast(int, w0), cast(int, w1))
	const (
		L0 float64 = cast(float64, (iota - 7) / 2)
		L1
		L2
	)
	var l0 float64 = L0
	var l1 float64 = L1
	var l2 float64 = L2
	testing.Println(cast(int, l0), cast(int, l1), cast(int, l2))
	const (
		A float64 = cast(float64, iota - K)
		K
	)
	var a float64 = A
	var k float64 = K
	testing.Println(cast(int, a), cast(int, k))
}
