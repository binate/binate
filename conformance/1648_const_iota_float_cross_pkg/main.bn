package "main"

import "pkg/builtins/testing"

import "pkg/fc"

// A float constant group declared in an imported package's interface, computed from
// signed untyped arithmetic over iota, has each member's own value where it is used.

func main() {
	var f0 float64 = fc.F0
	var f1 float64 = fc.F1
	var f2 float64 = fc.F2
	testing.Println(cast(int, f0), cast(int, f1), cast(int, f2))
}
