package "main"

import "pkg/builtins/testing"

// A bare member of a float constant group whose repeated initializer divides by zero
// at its iota is rejected — though the division sits behind a float operand, where
// evaluating the constant's integer value stops.

const (
	A float64 = 1.5 * cast(float64, 10 / (iota - 1))
	B0
)

func main() {
	var a float64 = A
	testing.Println(cast(int, a))
}
