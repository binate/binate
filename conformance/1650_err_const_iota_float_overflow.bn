package "main"

import "pkg/builtins/testing"

// A bare member of a float constant group whose repeated initializer, at its iota,
// gives a typed int operand an untyped constant it cannot hold is rejected — though
// the operand sits behind a float one, where evaluating the constant's integer value
// stops.

const (
	A float64 = 1.5 * cast(float64, cast(int8, 0) + iota * 100)
	B0
	C0
)

func main() {
	var a float64 = A
	testing.Println(cast(int, a))
}
