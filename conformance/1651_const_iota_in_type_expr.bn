package "main"

import "pkg/builtins/testing"

// A const-group member whose initializer mentions iota only where it shapes a type
// — an array length, a composite literal's element — takes that type at its own
// iota, a bare member included: the size of [iota + 1]int64 is 8, 16, 24 (a float
// constant and an integer one); len of an [iota + 2]int8 literal (an int constant)
// is 2, 3, and of [...]int8{iota: 1} 1, 2, 3 (one sizes an array; another is
// compared, a bool constant); the size of a nested array, a generic instance and a
// struct with an iota-sized field is each member's; and in a function-local group,
// the size of [iota + 1]int16 is 2, 4.

type Box[T any] struct {
	v T
}

const (
	A float64 = cast(float64, sizeof([iota + 1]int64))
	B
	C
)

const (
	IA = sizeof([iota + 1]int64)
	IB
	IC
)

const (
	LA int = len([iota + 2]int8{})
	LB
)

const (
	K0 int = len([...]int8{iota: 1})
	K1
	K2
)

const (
	Q0 = len([...]int8{iota: 1}) == 2
	Q1
	Q2
)

const (
	N0 = sizeof([2][iota + 1]int8)
	N1
)

const (
	G0 = sizeof(Box[[iota + 1]int32])
	G1
)

const (
	T0 = sizeof(struct {
		a [iota + 1]int16
	})
	T1
)

func main() {
	var a float64 = A
	var b float64 = B
	var c float64 = C
	testing.Println(cast(int, a), cast(int, b), cast(int, c))
	testing.Println(cast(int, IA), cast(int, IB), cast(int, IC))
	testing.Println(LA, LB)
	testing.Println(K0, K1, K2)
	var ka [K2]int8
	testing.Println(len(ka))
	testing.Println(Q0, Q1, Q2)
	testing.Println(cast(int, N0), cast(int, N1))
	testing.Println(cast(int, G0), cast(int, G1))
	testing.Println(cast(int, T0), cast(int, T1))
	const (
		H0 float64 = cast(float64, sizeof([iota + 1]int16))
		H1
	)
	var h0 float64 = H0
	var h1 float64 = H1
	testing.Println(cast(int, h0), cast(int, h1))
}
