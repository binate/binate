package "main"

import "pkg/builtins/testing"

// A const-group member whose initializer mentions iota only inside a type
// expression — an array length — takes that length at its own iota, a bare
// member included: the size of [iota + 1]int64 is 8, 16, 24, and len of an
// [iota + 2]int8 literal (an int constant) is 2, 3.

const (
	A float64 = cast(float64, sizeof([iota + 1]int64))
	B
	C
)

const (
	IA = sizeof([iota + 1]int64)
	IB
	IC
)

const (
	LA int = len([iota + 2]int8{})
	LB
)

func main() {
	var a float64 = A
	var b float64 = B
	var c float64 = C
	testing.Println(cast(int, a), cast(int, b), cast(int, c))
	testing.Println(cast(int, IA), cast(int, IB), cast(int, IC))
	testing.Println(LA, LB)
}
