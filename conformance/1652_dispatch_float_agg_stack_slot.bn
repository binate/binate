package "main"

import "pkg/builtins/testing"

// A func-value or interface call carries every argument in an integer slot, an
// aggregate as a pointer to a copy (the dispatch seam).  When the slots outnumber the
// core argument registers, a float aggregate's pointer slot goes to the stack — so the
// caller's outgoing-argument area must hold it, even though the same aggregate passed
// directly would ride float registers (an aarch64 HFA, an x86-64 SSE aggregate) — and
// a zero-size aggregate, which passed directly takes no slot at all, takes one too.
// Each caller below makes only such calls, twice, so no other call reserves the space;
// the callee pointer and the values kept live across the first call must survive it.

type D2 struct { x float64; y float64 }

// F2 is a two-float32 aggregate.
type F2 struct { a float32; b float32 }

// Empty is a zero-size aggregate.
type Empty struct {}

func wide8(a int, b int, c int, d int, e int, f int, g int, w D2) float64 {
	return w.x + w.y + cast(float64, a + g)
}

func wide6(a int, b int, c int, d int, e int, w D2) float64 {
	return w.x + w.y + cast(float64, a + e)
}

func wideF(a int, b int, c int, d int, e int, f int, g int, v F2) float32 {
	return v.a + v.b + cast(float32, b)
}

func call8(fp *func(int, int, int, int, int, int, int, D2) float64, k int) float64 {
	var g0 int = k
	var g1 int = k * 2
	var r float64 = fp(1, 2, 3, 4, 5, 6, 7, D2{x: 1.5, y: 2.5})
	r = r + fp(1, 2, 3, 4, 5, 6, 7, D2{x: 0.5, y: 0.5})
	return r + cast(float64, g0 + g1)
}

func call6(fp *func(int, int, int, int, int, D2) float64, k int) float64 {
	var g0 int = k
	var g1 int = k * 2
	var r float64 = fp(1, 2, 3, 4, 5, D2{x: 1.5, y: 2.5})
	r = r + fp(1, 2, 3, 4, 5, D2{x: 0.5, y: 0.5})
	return r + cast(float64, g0 + g1)
}

func callF(fp *func(int, int, int, int, int, int, int, F2) float32, k int) float32 {
	var g0 int = k
	var r float32 = fp(1, 2, 3, 4, 5, 6, 7, F2{a: 0.5, b: 0.25})
	r = r + fp(1, 2, 3, 4, 5, 6, 7, F2{a: 0.25, b: 0.25})
	return r + cast(float32, g0)
}

func wideZ(z Empty, a int, b int, c int, d int, e int, f int, g int) int { return a + g * 10 }

func callZ(fp *func(Empty, int, int, int, int, int, int, int) int, k int) int {
	var z Empty
	var g0 int = k
	var r int = fp(z, 1, 2, 3, 4, 5, 6, 7)
	r = r + fp(z, 7, 6, 5, 4, 3, 2, 1)
	return r + g0
}

// Wide is called through an interface: the receiver takes one more slot.
interface Wide {
	Sum(a int, b int, c int, d int, e int, f int, w D2) float64
}

// Base is a Wide.
type Base struct { k float64 }

impl *Base : Wide

func (p *Base) Sum(a int, b int, c int, d int, e int, f int, w D2) float64 {
	return w.x + w.y + p.k + cast(float64, f)
}

func callIface(w *Wide, k int) float64 {
	var g0 int = k
	var r float64 = w.Sum(1, 2, 3, 4, 5, 6, D2{x: 0.5, y: 1.5})
	r = r + w.Sum(1, 2, 3, 4, 5, 6, D2{x: 0.5, y: 0.5})
	return r + cast(float64, g0)
}

func main() {
	var f8 *func(int, int, int, int, int, int, int, D2) float64 = wide8
	var f6 *func(int, int, int, int, int, D2) float64 = wide6
	var ff *func(int, int, int, int, int, int, int, F2) float32 = wideF
	var t0 float64 = 0.0
	for i := 0; i < 3; i++ {
		t0 = t0 + call8(f8, 100) + call6(f6, 10)
	}
	testing.Println(t0)
	testing.Println(callF(ff, 3))
	var b Base
	b.k = 10.0
	testing.Println(callIface(&b, 7))
	var fz *func(Empty, int, int, int, int, int, int, int) int = wideZ
	testing.Println(callZ(fz, 5))
}
