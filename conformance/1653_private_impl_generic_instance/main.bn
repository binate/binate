package "main"
import "pkg/builtins/testing"

import "pkg/q"

// pkg/q's impl of lib.D for Q is in q's .bn only, so it is private to q; it
// still satisfies D where q instantiates lib's generics, and in their
// instances, where lib.Outer[@Q] calls lib.Inner[@Q] and lib.HH[@Q] holds an
// lib.H[@Q].
func main() {
	testing.Println(q.Run())
}
