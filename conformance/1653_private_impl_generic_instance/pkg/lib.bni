package "pkg/lib"

// D doubles.
interface D {
	dbl() int
}

// H holds an X.
type H[X D] struct {
	x X
}

// HH holds an H[X].
type HH[X D] struct {
	h H[X]
}

// Inner returns x doubled.
func Inner[X D](x X) int { return x.dbl() }

// Outer returns x doubled, through Inner.
func Outer[X D](x X) int { return Inner[X](x) }
