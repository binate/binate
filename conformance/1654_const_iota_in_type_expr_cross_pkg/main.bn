package "main"

import "pkg/builtins/testing"
import "pkg/ti"

// An imported package's const groups whose initializers mention iota only inside a
// type expression: each member takes its array length at its own iota, a bare
// member included — the size of [iota + 1]int64 is 8, 16, 24 (a float constant and
// an integer one, which sizes an array here), and len of an [iota + 2]int8 literal
// is 2, 3.

func main() {
	var f0 float64 = ti.F0
	var f1 float64 = ti.F1
	var f2 float64 = ti.F2
	testing.Println(cast(int, f0), cast(int, f1), cast(int, f2))
	testing.Println(cast(int, ti.S0), cast(int, ti.S1), cast(int, ti.S2))
	var a [ti.S2]int8
	testing.Println(len(a))
	testing.Println(ti.L0, ti.L1)
}
