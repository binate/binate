package "main"

import "pkg/builtins/testing"
import "pkg/lc"

// An imported package's constant that is `len` of an array literal is an int
// constant (spec builtin.len) to an importer too: it sizes an array.  The literal
// may spell its length, infer it from its elements (`[...]T{...}`, keyed
// elements included), or be of a named array type, and its element type may be
// declared later in the `.bni`.

func main() {
	var a [lc.P]int8
	var b [lc.Q]int8
	var r [lc.R]int8
	var l [lc.L]int8
	testing.Println(len(a), lc.P)
	testing.Println(len(b), lc.Q)
	testing.Println(len(r), lc.R)
	testing.Println(len(l), lc.L)
}
