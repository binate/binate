package "pkg/lc"

// Row is a named array type.
type Row [2]int16

const P int = len([3]int8{})

const Q int = len([...]int8{1, 2, 4: 9})

const R int = len(Row{})

// L's literal names a type declared after it: its spelled length is enough.
const L int = len([2]Late{})

// Late is declared after L.
type Late struct {
	x int
}
