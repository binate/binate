package "main"

import "pkg/builtins/testing"

// An interface method whose signature carries Self inside an anonymous struct type
// (spec iface.self: Self is valid inside composite types).  The impl's signature has
// the implementing type in the field, and a generic constraint call sees the struct
// with the type parameter in it.

interface Splitter {
	Split() struct { lo Self; hi Self }
	Join(parts struct { lo Self; hi Self }) Self
	Val() int
}

type Num struct {
	v int
}

func (n Num) Split() struct { lo Num; hi Num } {
	var r struct { lo Num; hi Num }
	r.lo.v = n.v % 10
	r.hi.v = n.v / 10
	return r
}

func (n Num) Join(parts struct { lo Num; hi Num }) Num {
	var r Num
	r.v = parts.hi.v * 10 + parts.lo.v
	return r
}

func (n Num) Val() int {
	return n.v
}

impl Num : Splitter

func swapDigits[T Splitter](t T) T {
	var p struct { lo T; hi T } = t.Split()
	var q struct { lo T; hi T }
	q.lo = p.hi
	q.hi = p.lo
	return t.Join(q)
}

func main() {
	var n Num
	n.v = 47
	var s = n.Split()
	testing.Println(s.lo.v)
	testing.Println(s.hi.v)
	testing.Println(swapDigits[Num](n).Val())
	var iv *Splitter = &n
	testing.Println(iv.Val())
}
