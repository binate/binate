package "main"

// A method whose Self sits inside an anonymous struct result is object-unsafe:
// calling it through an interface value is rejected.

interface Maker {
	Mk() struct { x Self }
}

type P struct {
	v int
}

func (p P) Mk() struct { x P } {
	var r struct { x P }
	r.x = p
	return r
}

impl P : Maker

func main() {
	var p P
	var iv *Maker = &p
	var s = iv.Mk()
	_ = s
}
