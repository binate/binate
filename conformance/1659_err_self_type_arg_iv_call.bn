package "main"

// A method whose Self is a type argument (`*Box[Self]`) is object-unsafe: calling
// it through an interface value is rejected.

type Box[T any] struct {
	v T
}

interface Putter {
	Put(b *Box[Self]) int
}

type P struct {
	v int
}

func (p P) Put(b *Box[P]) int {
	return b.v.v
}

impl P : Putter

func main() {
	var p P
	var b Box[P]
	var iv *Putter = &p
	var _ int = iv.Put(&b)
}
