package "main"

// The receiver SWAPS the type's param names: on `type Pair[K, V]`, the receiver
// `@Pair[V, K]` binds V→position 0 (the type's K = int) and K→position 1 (V =
// bool).  So the method's return type `V` is int, and `p.k` (the type's K field,
// int) is returned as it.  A substitution that lets the type's `V→bool` shadow
// the binder `V→int` would miscompile the return.
type Pair[K any, V any] struct {
	k K
	v V
}

func (p @Pair[V, K]) FirstK() V {
	return p.k
}

func main() {
	var p @Pair[int, bool] = make(Pair[int, bool])
	p.k = 4
	println(p.FirstK())
}
