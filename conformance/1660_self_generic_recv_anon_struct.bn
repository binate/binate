package "main"

import "pkg/builtins/testing"

// A generic-receiver impl (`impl W[T] : I`) of methods whose Self sits inside an
// anonymous struct: each instance W[X] implements I with Self = W[X], through a
// generic constraint and as an interface value for the Self-free method.
interface I {
	Mk() struct { x Self; n int }
	Take(s struct { x Self; n int }) int
	Tag() int
}

type W[T any] struct {
	v T
	n int
}

func (w W[T]) Mk() struct { x W[T]; n int } {
	var r struct { x W[T]; n int }
	r.x = w
	r.n = 9
	return r
}

func (w W[T]) Take(s struct { x W[T]; n int }) int { return s.n + s.x.n }

func (w W[T]) Tag() int { return w.n }

impl W[T] : I

func use[K I](k K) int {
	var s struct { x K; n int } = k.Mk()
	return k.Take(s) + s.x.Tag()
}

func main() {
	var w W[bool]
	w.n = 4
	testing.Println(use[W[bool]](w))
	var iv *I = &w
	testing.Println(iv.Tag())
}
