package "main"

import "pkg/builtins/testing"

// An interface whose methods carry Self as a type argument — of a generic struct
// (`*Box[Self]`), of a generic interface (`*G[Self]`) and of a generic alias of an
// anonymous struct (`St[Self]`) — compiles, is implemented with Self = P, and is
// used through a generic constraint; its Self-free method dispatches through an
// interface value.

type Box[T any] struct {
	v T
}

type St[T any] = struct { x T; n int }

interface G[T any] {
	Get() T
}

interface I {
	Put(b *Box[Self]) int
	Src(g *G[Self]) int
	Mk() St[Self]
	Tag() int
}

type P struct {
	v int
}

func (p P) Put(b *Box[P]) int {
	return b.v.v + p.v
}

func (p P) Src(g *G[P]) int {
	return g.Get().v * 10
}

func (p P) Mk() St[P] {
	var r St[P]
	r.x = p
	r.n = 5
	return r
}

func (p P) Tag() int {
	return p.v
}

impl P : I

type Fixed struct {
	p P
}

func (f *Fixed) Get() P {
	return f.p
}

impl *Fixed : G[P]

func use[K I](k K, b *Box[K], g *G[K]) int {
	var s St[K] = k.Mk()
	return k.Put(b) + k.Src(g) + s.n + s.x.Tag()
}

func main() {
	var p P
	p.v = 2
	var b Box[P]
	b.v.v = 3
	var f Fixed
	f.p.v = 7
	var g *G[P] = &f
	testing.Println(use[P](p, &b, g))
	var iv *I = &p
	testing.Println(iv.Tag())
}
