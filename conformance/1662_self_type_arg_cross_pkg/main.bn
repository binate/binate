package "main"

import "pkg/builtins/testing"
import "pkg/s"

// A generic interface from another package whose own methods carry Self as a type
// argument and in a func-value parameter (`Put(b *Box[Self]) T`, `Each(f *func(Self)
// int) int`), extended by `H : G[int]` with `Mk() Box[Self]`: the importing module
// registers both interfaces and instantiates G[int] without resolving those
// signatures, implements them with Self = P, calls them through a generic constraint,
// and dispatches the Self-free methods through interface values.
type P struct {
	n int
}

func (p P) Put(b *s.Box[P]) int { return b.v.n + p.n }

func (p P) Each(f *func(P) int) int { return f(p) }

func (p P) Tag() int { return p.n }

func (p P) Mk() s.Box[P] {
	var b s.Box[P]
	b.v = p
	return b
}

func (p P) Hv() int { return 77 }

impl P : s.H

func use[K s.H](k K) int {
	var b s.Box[K] = k.Mk()
	return k.Put(&b) + k.Tag()
}

func main() {
	var p P
	p.n = 4
	var h *s.H = &p
	testing.Println(h.Tag(), h.Hv())
	var g *s.G[int] = h
	testing.Println(g.Tag())
	testing.Println(use[P](p))
}
