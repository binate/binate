package "main"

import "pkg/builtins/testing"

// A same-width float conversion keeps -0.0's sign: cast to the same float type,
// to a named float type, and a float-to-float bit_cast are exact identities, as
// are negative-zero constants.  (x + 0.0 is +0.0 for x = -0.0, so an identity
// written as an addition of +0.0 would lose the sign.)

type Temp float64

type Temp32 float32

const NZ float64 = -0.0

const NZ32 float32 = -0.0

func signBit64(x float64) bool {
	return bit_cast(int64, x) < 0
}

func signBit32(x float32) bool {
	return bit_cast(int32, x) < 0
}

func main() {
	var z float64 = 0.0
	z = -z
	var w float32 = 0.0
	w = -w
	testing.Println(signBit64(z), signBit32(w))
	var t Temp = cast(Temp, z)
	testing.Println(bit_cast(int64, t) < 0)
	testing.Println(signBit64(cast(float64, z)), signBit32(cast(float32, w)))
	var t32 Temp32 = cast(Temp32, w)
	testing.Println(bit_cast(int32, t32) < 0)
	testing.Println(signBit64(bit_cast(float64, t)), signBit32(bit_cast(float32, t32)))
	var c float64 = NZ
	testing.Println(signBit64(c), signBit64(-0.0))
	var c32 float32 = -0.0
	var k32 float32 = NZ32
	testing.Println(signBit32(c32), signBit32(k32))
}
