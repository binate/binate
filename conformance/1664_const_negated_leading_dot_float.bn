package "main"

import "pkg/builtins/testing"

// A float constant negating a literal that starts with its point — `-.5`, `-.5e1`,
// `-.25`, `-.0` — compiles and has its value (and -.0 its sign) on every backend.

const A float64 = -.5

const B float64 = -.5e1

const C float32 = -.25

const Z float64 = -.0

func main() {
	var a float64 = A * 4.0
	var b float64 = B
	var c float32 = C * 8.0
	var z float64 = Z
	testing.Println(cast(int, a), cast(int, b), cast(int, c), bit_cast(int64, z) < 0)
}
