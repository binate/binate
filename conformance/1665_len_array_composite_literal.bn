package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// len of an array composite literal is its array's length — part of its type —
// whatever the literal's form: sized, inferred, empty, nested, of a named array
// type, inside an expression, and in a generic instance whose length depends on
// its type argument.  The literal is not evaluated (builtin.len): its elements'
// calls are not made, and a literal of managed elements allocates nothing.

type Row [3]int

type Node struct {
	v int
}

var calls int

func f() int {
	calls = calls + 1
	return calls
}

func count[T any]() int {
	return len([sizeof(T)]uint8{})
}

func main() {
	var a int = len([2]int{1, 2})
	var b int = len([...]int{1, 2, 3, 4})
	var c int = len([5]int8{})
	var d int = len([3][2]int{})
	var e int = len(Row{1, 2, 3})
	testing.Println(a, b, c, d, e)
	testing.Println(len([2]int{1, 2}) * 10 + len([...]uint8{7: 1}))
	testing.Println(count[int64](), count[uint16]())
	testing.Println(len([3]int{f(), f(), f()}), calls)
	var base int = rt.LiveBlocks()
	var n int = len([2]@Node{make(Node), nil})
	testing.Println(n, len([...]@[]int{make_slice(int, 3), make_slice(int, 4)}))
	testing.Println(rt.LiveBlocks() - base)
}
