package "main"

import "pkg/builtins/testing"

// make_slice with a length that does not fit the target's int traps ("make_slice
// length out of range") rather than making a slice of the length's low word: on a
// 32-bit target an int64 length of 2^32 + 2 (a 2-element slice before), on a 64-bit
// one -1 (a valid length of 2^32 + 2 there would be a huge allocation).

func length() int64 {
	if sizeof(int) == 4 {
		return (cast(int64, 1) << 32) + 2
	}
	return -1
}

func main() {
	var s @[]int = make_slice(int, length())
	testing.Println(len(s))
}
