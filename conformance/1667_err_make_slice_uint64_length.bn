package "main"

import "pkg/builtins/testing"

// make_slice with a uint64 length past the target's int traps ("make_slice length
// out of range"), on a 32-bit target and a 64-bit one alike.  0x8000000000000005 is
// negative read as a signed value and its low word is 5: a 32-bit target compares it
// unsigned (a signed compare would let it through as a 5-element slice); a 64-bit one
// gets it as a negative int.

func main() {
	var u uint64 = 0x8000000000000005
	var s @[]int = make_slice(int, u)
	testing.Println(len(s))
}
