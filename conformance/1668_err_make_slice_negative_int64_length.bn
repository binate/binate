package "main"

import "pkg/builtins/testing"

// make_slice with a negative int64 length — -2^40, whose low word is 0 — traps
// ("make_slice length out of range"), on a 32-bit target and a 64-bit one alike.

func main() {
	var m int64 = 0 - (cast(int64, 1) << 40)
	var s @[]int = make_slice(int, m)
	testing.Println(len(s))
}
