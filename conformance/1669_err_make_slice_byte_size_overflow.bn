package "main"

import "pkg/builtins/testing"

// make_slice with a length that fits the target's int but whose byte size does not —
// 2^61 + 1 int64 elements on a 64-bit target, 0x20000001 on a 32-bit one, both
// wrapping to 8 bytes — traps ("make_slice length out of range"), not a slice of
// that length over an 8-byte backing (whose elements past the first the bounds check
// would let a program write outside the allocation).

func length() int64 {
	if sizeof(int) == 4 {
		return 0x20000001
	}
	return (cast(int64, 1) << 61) + 1
}

func main() {
	var s @[]int64 = make_slice(int64, length())
	testing.Println(len(s))
}
