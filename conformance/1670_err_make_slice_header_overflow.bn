package "main"

import "pkg/builtins/testing"

// make_slice with a length whose elements' size fits the target's int but not with
// the management header added to it traps ("make_slice length out of range") rather
// than wrapping the allocation's size: 0x7FFFFFF8 uint8 elements on a 32-bit target,
// the int's maximum less 15 on a 64-bit one.

func length() int {
	if sizeof(int) == 4 {
		return 0x7FFFFFF8
	}
	return cast(int, ~cast(uint, 0) >> 1) - 15
}

func main() {
	var s @[]uint8 = make_slice(uint8, length())
	testing.Println(len(s))
}
