package "main"

import "pkg/builtins/testing"

// make_slice of a zero-size element type takes any length up to the target int's
// maximum: its elements take no space, so no size can overflow.

type E struct {
}

func main() {
	var n int = cast(int, ~cast(uint, 0) >> 1)
	var s @[]E = make_slice(E, n)
	testing.Println(len(s) == n)
}
