package "main"

import "pkg/builtins/testing"

// On bare metal, an allocation larger than the runtime's arena (4 MiB) aborts
// ("rt.RawAlloc: arena exhausted") rather than wrapping the allocator's size
// arithmetic and handing out memory past the arena: a 2^30-byte make_slice there.  A
// hosted target allocates a small slice instead, and prints it.

#[build(is(os, "baremetal"))]
func length() int {
	return 0x40000000
}

#[build(!is(os, "baremetal"))]
func length() int {
	return 16
}

func main() {
	var s @[]uint8 = make_slice(uint8, length())
	s[0] = 1
	testing.Println(len(s), cast(int, s[0]))
}
