package "main"

import "pkg/builtins/testing"

// On bare metal, an allocation that is not larger than the runtime's arena (4 MiB) but
// does not fit what is left of it aborts ("rt.RawAlloc: arena exhausted"): a
// make_slice just under the arena's size there, which with the allocation's header and
// the block's tags no longer fits.  A hosted target allocates a small slice instead,
// and prints it.

#[build(is(os, "baremetal"))]
func length() int {
	return (1 << 22) - 16
}

#[build(!is(os, "baremetal"))]
func length() int {
	return 16
}

func main() {
	var s @[]uint8 = make_slice(uint8, length())
	s[0] = 1
	testing.Println(len(s), cast(int, s[0]))
}
