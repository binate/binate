package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A pointer to an interface value — `&g` for g an `@Getter`, `&rg` for rg a `*Getter`,
// a managed `@(@Getter)` — is a source for a raw `*any` like any other pointer: it is
// boxed with the interface-value type as its dynamic type, an opaque structural type
// no assertion target names (`case *Getter` is an interface target, and misses), in
// an argument, a variable's initializer, a variadic argument and a deferred call; the
// borrow leaves the interface value's reference count alone.

interface Getter {
	Get() int
}

type B struct {
	v int
}

func (b *B) Get() int {
	return b.v
}

impl *B : Getter

func kind(x *any) @[]char {
	switch x.(type) {
	case *Getter:
		return "Getter"
	default:
		return "default"
	}
}

func count(xs ...*any) int {
	return len(xs)
}

func main() {
	var b @B = make(B)
	b.v = 5
	var g @Getter = b
	var rg *Getter = b
	var pg @(@Getter) = box(g)
	var r0 int = rt.Refcount(bit_cast(*uint8, b))
	defer {
		testing.Println(kind(pg))
	}
	testing.Println(kind(&g), kind(&rg), kind(pg))
	var a *any = pg
	testing.Println(present(a))
	testing.Println(count(pg, &g, &rg))
	for i := 0; i < 20; i++ {
		_ = kind(&g)
		_ = kind(pg)
	}
	testing.Println(rt.Refcount(bit_cast(*uint8, b)) - r0)
}
