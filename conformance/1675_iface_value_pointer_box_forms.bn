package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A box of a pointer to an interface value is recovered as `*any` (a type switch's
// `case *any`, an assertion `.(*any)`) and never as the interface (`.(*Getter)`,
// `.(@Getter)` miss: the boxed interface-value type implements nothing), whatever
// the pointee's spelling — readonly, an alias, an interface value of `any` itself, a
// generic instance's — and a typed nil of that pointer type boxes as present.  An
// owning `@any` box of the same dynamic type, in the same program as raw boxes of it,
// releases what it holds when dropped.

interface Getter {
	Get() int
}

type B struct {
	v int
}

func (b *B) Get() int {
	return b.v
}

impl *B : Getter

type GA = @Getter

func kind(x *any) @[]char {
	switch x.(type) {
	case *Getter:
		return "Getter"
	case *any:
		return "any"
	default:
		return "default"
	}
}

func wrap[T any](p *T) *any {
	return p
}

func own(x @any) int {
	_, ok := x.(@Getter)
	if ok {
		return 1
	}
	return 0
}

func main() {
	var b @B = make(B)
	b.v = 7
	var r0 int = rt.Refcount(bit_cast(*uint8, b))
	var g @Getter = b
	var rog readonly @Getter = b
	var ga GA = b
	var a *any = b
	var ma @any = b
	testing.Println(kind(&rog), kind(&ga), kind(&a), kind(&ma))
	testing.Println(kind(wrap[@Getter](&g)))
	var x *any = &g
	_, hit := x.(*Getter)
	_, anyHit := x.(*any)
	testing.Println(hit, anyHit)
	var np *(@Getter) = nil
	var y *any = np
	testing.Println(present(y), kind(y))
	var pg @(@Getter) = box(g)
	testing.Println(kind(pg))
	var owned int = 0
	for i := 0; i < 10; i++ {
		var m @any = pg
		owned = owned + own(m)
	}
	testing.Println(owned)
	pg = nil
	testing.Println(rt.Refcount(bit_cast(*uint8, b)) - r0)
}
