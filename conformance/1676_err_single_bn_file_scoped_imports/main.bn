package "main"

import "pkg/builtins/testing"
import "pkg/p"

// Imports are file-scoped: a package's `.bni` importing pkg/a does not let its
// `.bn` file name `a` without importing it itself — with one `.bn` file as with
// several.  This program must not compile.

func main() {
	testing.Println(p.F())
}
