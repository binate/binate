package "main"

import "pkg/builtins/testing"

// An instance of a generic type compiles every method with its type arguments,
// so a method whose instantiated signature holds an opaque type by value — a
// result, or a function value's parameter — is rejected where the instance is
// formed, whether or not the method is called (spec gen.mono.check,
// type.opaque.by-value, type.opaque.signature).  This program must not compile.

type Opaque

type Bx[T any] struct {
	p *T
}

func (b *Bx[T]) Mk() T {
	for {
	}
}

func (b *Bx[T]) Set(v *func(T)) {
}

func main() {
	var b Bx[Opaque]
	var pb *Bx[Opaque] = &b
	pb.Set(nil)
	testing.Println(1)
}
