package "main"

import "pkg/builtins/testing"

// A method's value receiver is a parameter: a method of a type nothing defines
// (or of a distinct type over one) would take an opaque value, so it is rejected
// (spec type.opaque.by-value).  This program must not compile.

type Opaque

type O2 Opaque

func (o Opaque) V() int { return 1 }

func (o O2) W() int { return 2 }

func main() {
	testing.Println(1)
}
