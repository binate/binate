package "main"

import "pkg/builtins/testing"

// A distinct type over a type the main package defines nowhere holds that type,
// so releasing an `@F` needs X's destructor, which only X's definition supplies,
// exactly as releasing an `@X` does: with X defined nowhere in the program, it
// fails to link (on the VM: the function is not found when the release runs),
// naming `__dtor_X`.  This program must fail.  The `@F` is a global, so no
// optimizer can prove the released value nil and drop the release.
type X

type F X

var g @F

func drop() int {
	g = nil
	return 1
}

func main() {
	testing.Println(drop())
}
