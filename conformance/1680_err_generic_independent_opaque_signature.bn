package "main"

import "pkg/builtins/testing"

// A generic function's or method's parameter or result that mentions no type
// parameter is checked at the declaration, whether or not the program
// instantiates the generic (spec gen.mono.check): a by-value opaque result is
// rejected here though nothing instantiates G or Bx.  This program must not
// compile.

type Opaque

type Bx[T any] struct {
	p *T
}

func (b *Bx[T]) Bad() Opaque {
	for {
	}
}

func G[T any](t *T) Opaque {
	for {
	}
}

func main() {
	testing.Println(1)
}
