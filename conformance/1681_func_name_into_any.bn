package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A function name used as a value for a raw `*any` — a function `add`, a package's
// function `rt.Refcount`, a generic function's instance `id[int]`, a method
// expression `B.Get` — decays to its function value (`@func(…)`, the method
// expression's `*func(…)`) and that value is boxed, in an argument, a variable's
// initializer (or a composite literal's element in one), a variadic argument, a
// deferred call and `box(add)` for an `@any`, also when the signature mentions a
// generic type's instance (`box(takeBG)`).  The dynamic type is the name-less
// function-value type, which no assertion target names (`case *Fn` misses); a named
// function-value type recovers it.  A local that shadows a function's name is the
// local's value.

type Fn @func(int, int) int

func add(a int, b int) int {
	return a + b
}

func sub(a int, b int) int {
	return a - b
}

func id[T any](x T) T {
	return x
}

type B struct {
	v int
}

type S struct {
	a *any
}

type BG[T any] struct {
	v T
}

func (b *BG[T]) Get() T {
	return b.v
}

func takeBG(b *BG[int]) int {
	return b.v
}

func (b *B) Get() int {
	return b.v
}

func kind(x *any) @[]char {
	switch x.(type) {
	case *Fn:
		return "Fn"
	case *int:
		return "int"
	default:
		return "default"
	}
}

func take(x *any) bool {
	return present(x)
}

func count(xs ...*any) int {
	return len(xs)
}

func shadowed() @[]char {
	sub := 7
	return kind(sub)
}

func main() {
	defer {
		testing.Println(kind(add))
	}
	testing.Println(take(add), take(rt.Refcount), take(id[int]), take(B.Get))
	testing.Println(kind(add), kind(rt.Refcount), kind(id[int]), kind(B.Get))
	var x *any = add
	var y *any = B.Get
	testing.Println(present(x), present(y), kind(x), kind(y))
	var m @any = box(add)
	var n @any = box(id[int])
	var o @any = box(B.Get)
	testing.Println(present(m), present(n), present(o))
	var xs [2]*any = [2]*any{add, id[int]}
	var s S = S{a: rt.Refcount}
	testing.Println(present(xs[0]), present(xs[1]), present(s.a), kind(s.a))
	var g1 @any = box(BG[int].Get)
	var g2 @any = box(id[BG[int]])
	var g3 @any = box(takeBG)
	testing.Println(present(g1), present(g2), present(g3), take(takeBG), take(BG[int].Get))
	testing.Println(count(add, rt.Refcount, id[int], B.Get))
	var f Fn = add
	testing.Println(kind(&f), f(2, 3))
	testing.Println(shadowed())
	var b B
	b.v = 4
	testing.Println(take(b.Get))
	for i := 0; i < 20; i++ {
		_ = take(add)
		_ = box(sub)
	}
}
