package "main"

import "pkg/builtins/testing"
import "pkg/myp"

// An imported package's generic body borrows and boxes the package's own constant
// `Cn` — an int, though the importing package declares a function `Cn` — and
// borrows the package's function `Twice` into a `*any`, which boxes its function
// value.

func Cn() int {
	return 1
}

func Twice(a int) int {
	return 3 * a
}

func main() {
	testing.Println(myp.BorrowConst[int](1), myp.BoxConst[int](1), myp.BorrowFunc[int](1))
	testing.Println(Cn(), Twice(2), myp.Twice(2))
}
