package "pkg/myp"

// Cn is a constant that the importing package also uses as a function's name.
const Cn int = 11

// Kind reports whether x boxes an int.
func Kind(x *any) @[]char

// Twice doubles a.
func Twice(a int) int

// BorrowConst borrows the package's constant into a `*any` from a generic body.
func BorrowConst[T any](x T) @[]char {
	return Kind(Cn)
}

// BoxConst boxes the package's constant from a generic body.
func BoxConst[T any](x T) bool {
	var m @any = box(Cn)
	return present(m)
}

// BorrowFunc borrows the package's function into a `*any` from a generic body.
func BorrowFunc[T any](x T) @[]char {
	return Kind(Twice)
}
