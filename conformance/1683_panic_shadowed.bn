package "main"

import "pkg/builtins/testing"

// `panic` is a predeclared function, not a keyword, so a parameter or a local of
// that name shadows it (builtin.predeclared): a call through the shadowing binding
// calls that binding, and the program does not abort.

func say(s *[]readonly char) {
	testing.Println("say:", s)
}

func viaParam(panic @func(*[]readonly char)) {
	panic("param")
	testing.Println("after param")
}

func viaLocal() {
	panic := say
	panic("local")
	testing.Println("after local")
}

func main() {
	viaParam(say)
	viaLocal()
	testing.Println("done")
}
