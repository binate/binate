package "main"

import "pkg/builtins/testing"

// The predeclared `panic` used as a value is an ordinary function of type
// `func(msg *[]readonly char)` (builtin.predeclared, func.ref.decay): it binds to
// a `@func` / `*func` variable, a named function-value type, a struct field, a
// generic argument, a package-level variable, a raw `*any` and `box`.  A
// parameter or local named `panic` shadows it, and a call through such a binding
// calls the binding.

type Fn @func(*[]readonly char)

type S struct {
	f @func(*[]readonly char)
}

var gp = panic

func apply[T any](x T) T {
	return x
}

func take(x *any) bool {
	return present(x)
}

func say(s *[]readonly char) {
	testing.Println("say:", s)
}

func viaParam(panic @func(*[]readonly char)) {
	panic("param")
}

func main() {
	var f = panic
	var g *func(*[]readonly char) = panic
	var h Fn = panic
	var s S = S{f: panic}
	var a @func(*[]readonly char) = apply[@func(*[]readonly char)](panic)
	testing.Println(present(f), present(g), present(h), present(s.f), present(a), present(gp))
	var m @any = box(panic)
	testing.Println(take(panic), present(m))
	viaParam(say)
	panic := say
	panic("local")
}
