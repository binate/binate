package "main"

import "pkg/builtins/testing"
import "pkg/p"

// An imported package's generic body calls the predeclared `panic`; this package
// declares its own `func panic`, which its own calls reach, but the instance's
// call is still the predeclared one and aborts.

func panic(s *[]readonly char) {
	testing.Println("main.panic:", s)
}

func main() {
	panic("own")
	testing.Println(p.Check[int](1, true))
	_ = p.Check[int](2, false)
}
