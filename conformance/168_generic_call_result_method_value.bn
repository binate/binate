package "main"

// A method value on the RESULT of a generic-function CALL: mkbox[int](55).Get.
// The callee `mkbox[int]` is an instantiation, so the receiver's IR-gen type must
// be resolved from the instantiated func's result — else the closure struct /
// method symbol fall back to the checker's raw `Box[int]` (invalid LLVM
// identifier under LLVM, `main.Box[int].Get` extern-not-found under the VM).

type Box[T any] struct {
	val T
}

func (b @Box[T]) Get() T {
	return b.val
}

func mkbox[T any](v T) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.val = v
	return b
}

func main() {
	var f *func() int = mkbox[int](55).Get
	println(f())
}
