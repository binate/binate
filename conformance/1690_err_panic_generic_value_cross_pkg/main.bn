package "main"

import "pkg/builtins/testing"
import "pkg/p"

// An imported package's generic body returns the predeclared `panic` as a value;
// this package declares its own `func panic`, but the value is the predeclared
// one, and calling it aborts.

func panic(s *[]readonly char) {
	testing.Println("main.panic:", s)
}

func main() {
	panic("own")
	var f @func(*[]readonly char) = p.PanicValue[int](1)
	f("from p")
}
