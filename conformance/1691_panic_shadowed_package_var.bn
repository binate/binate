package "main"

import "pkg/builtins/testing"

// A package-level variable named `panic` shadows the predeclared one in the whole
// package, also in the initializers of variables declared before it, which read
// it and are therefore initialized after it (prog.init.order).

var y = panic

var n = func() int {
	panic("iife")
	return 1
}()

var panic = say

func say(s *[]readonly char) {
	testing.Println("say:", s)
}

func main() {
	y("via y")
	testing.Println(n)
}
