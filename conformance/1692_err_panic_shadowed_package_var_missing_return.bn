package "main"

// A call through a package-level variable named `panic`, declared after the
// function literal that calls it, returns like any call, so the literal with a
// result still needs a return (stmt.terminating).

var n = func() int {
	panic("x")
}()

var panic = say

func say(s *[]readonly char) {
}

func main() {
	_ = n
}
