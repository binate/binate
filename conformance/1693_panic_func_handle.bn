package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// `_func_handle(panic)` takes the handle of the function the predeclared `panic`
// is as a value: the runtime's abort, rt.Panic (builtin.predeclared).

func main() {
	var h *uint8 = _func_handle(panic)
	testing.Println(present(h), h == _func_handle(rt.Panic))
}
