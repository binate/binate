package "main"

import "pkg/builtins/testing"
import "pkg/s"

// Interfaces declared in another package's .bni carry `Self` as a type argument of
// a constrained generic (`*s.OBox[Self]` for `type OBox[T lang.Orderable]`): I
// extends lang.Orderable, and J extends it through K, declared after J.  Both are
// accepted where the .bni is read, implemented with Self = P, and used through a
// generic constraint.
type P struct {
	n int
}

func (p P) Compare(other P) int { return p.n - other.n }

func (p P) Put(b *s.OBox[P]) int { return s.Val[P](b).n + p.n }

func (p P) Take(b *s.OBox[P]) int { return p.Compare(s.Val[P](b)) }

impl P : s.I, s.J

func use[T s.J](t T, b *s.OBox[T]) int {
	return t.Take(b)
}

func main() {
	var p P
	p.n = 9
	var b s.OBox[P]
	testing.Println(p.Put(&b))
	testing.Println(use[P](p, &b))
}
