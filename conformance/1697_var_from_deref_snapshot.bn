package "main"

import "pkg/builtins/testing"

// A variable initialized from a dereference — `var x Big = *p`, `x := *p` — holds a
// copy of the pointee as it was at the declaration: writes through p afterwards do
// not show in x, in straight-line code, for a managed field, and in a loop whose
// source changes each iteration.

type Big struct {
	n   int
	arr [100]int
}

type M struct {
	s   @[]char
	arr [40]int
}

func snap(p *Big) int {
	var x Big = *p
	p.n = 99
	p.arr[7] = 99
	return x.n * 1000 + x.arr[7]
}

func snapShort(p *Big) int {
	x := *p
	p.arr[99] = 5
	return x.arr[99]
}

func snapManaged(p *M) @[]char {
	var x M = *p
	p.s = "changed"
	p.arr[3] = 1
	if x.arr[3] != 0 {
		return "wrong"
	}
	return x.s
}

func loop(p *Big) int {
	var t int = 0
	for i := 0; i < 3; i++ {
		var x Big = *p
		p.n = p.n + 1
		t = t * 10 + x.n
	}
	return t
}

func main() {
	var b Big
	b.n = 3
	b.arr[7] = 4
	testing.Println(snap(&b), b.n, b.arr[7])
	testing.Println(snapShort(&b), b.arr[99])
	var m M
	m.s = "orig"
	testing.Println(snapManaged(&m), m.s)
	b.n = 1
	testing.Println(loop(&b), b.n)
}
