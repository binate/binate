package "main"

import "pkg/builtins/testing"

// `var y Big = x` makes y a copy of x: writes to either are not seen through the
// other, whether the compiler gives y storage of its own or — x being untouched
// after the copy — lets y be x.  Covered: y written (directly and through &y), x
// read or written after the copy (on a branch too), a chain, a loop declaring both,
// and loops copying an x declared outside them — each iteration's y starts from x
// as it is, whatever the iteration before wrote through its y (or through a
// by-value parameter, a copy of x too).

type Big struct {
	n   int
	arr [100]int
}

func mk(k int) Big {
	var b Big
	b.n = k
	b.arr[5] = k
	return b
}

func sum(b Big) int { return b.n + b.arr[0] + b.arr[99] }

func copyThen(k int) int {
	var x Big = mk(k)
	var y Big = x
	return sum(y)
}

func writeY(k int) int {
	var x Big = mk(k)
	var y Big = x
	y.n = 100
	y.arr[0] = 7
	return sum(y)
}

func readXAfter(k int) int {
	var x Big = mk(k)
	var y Big = x
	y.n = 100
	return x.n + y.n
}

func writeXAfter(k int) int {
	var x Big = mk(k)
	var y Big = x
	x.n = 50
	return y.n * 100 + x.n
}

func writeXOnBranch(k int, c bool) int {
	var x Big = mk(k)
	var y Big = x
	if c {
		x.n = 9
	}
	return y.n * 100 + x.n
}

func chain(k int) int {
	var x Big = mk(k)
	var y Big = x
	var z Big = y
	z.n++
	return sum(z)
}

func throughPointer(k int) int {
	var x Big = mk(k)
	var y Big = x
	var p *Big = &y
	p.n = 3
	return y.n
}

func loop(k int) int {
	var t int = 0
	for i := 0; i < 3; i++ {
		var x Big = mk(k + i)
		var y Big = x
		y.arr[1] = i
		t = t * 10 + sum(y)
	}
	return t
}

func loopOuter(k int) int {
	var x Big
	x.arr[k] = 1
	var t int = 0
	for i := 0; i < 3; i++ {
		var y Big = x
		y.n = y.n + 1
		t = t * 100 + sum(y)
	}
	return t
}

func loopOuterRead(k int) int {
	var x Big = mk(k)
	var t int = 0
	for i := 0; i < 3; i++ {
		t = t * 100 + x.arr[i]
		var y Big = x
		y.arr[i + 1] = 7
		t = t + sum(y)
	}
	return t
}

type Buf struct {
	arr [40]int
}

func bump(b Buf, j int) int {
	b.arr[j] = b.arr[j] + 1
	return b.arr[j]
}

func loopParam(k int) int {
	var x Buf
	x.arr[k] = 10
	var t int = 0
	for i := 0; i < 3; i++ {
		t = t * 100 + bump(x, k)
	}
	return t
}

func main() {
	testing.Println(copyThen(6), writeY(6), readXAfter(6), writeXAfter(6))
	testing.Println(writeXOnBranch(6, true), writeXOnBranch(6, false), chain(6), throughPointer(6))
	testing.Println(loop(1))
	testing.Println(loopOuter(5), loopOuterRead(6), loopParam(2))
}
