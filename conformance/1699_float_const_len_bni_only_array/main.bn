package "main"

import "pkg/builtins/testing"
import "pkg/solo"

// F is a constant: `len` of an array is its length (builtin.len), whatever the
// array holds, so F needs nothing of solo.A -- which nothing in the program
// defines -- and neither does a use of it.
const F float64 = cast(float64, len(solo.A))

func main() {
	testing.Println(cast(int, F))
}
