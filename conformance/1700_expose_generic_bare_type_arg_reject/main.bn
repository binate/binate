package "main"

import "pkg/builtins/testing"

import "pkg/fwd"

// A BARE exposed generic type (`fwd.Box` with no type arguments) as a type
// argument is rejected, as it is in a type expression: the injected marker is
// not a usable type.
func one[T any]() int { return 1 }

func main() {
	testing.Println(one[fwd.Box]())
}
