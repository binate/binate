package "main"

import "pkg/builtins/testing"

// A struct holding a huge array of zero-size elements is as small as its other
// fields: copying, zero-filling, passing and returning it touches only those fields,
// however many zero-size elements the array has.  Covered: a variable's copy, a
// by-value parameter and result (in a direct call and through a function value), a
// zero-filled variable, a field store of the value and an array of such structs.
// Each length fits a 32-bit int; together they make 2^60 elements.

type Z struct {
	z [1 << 30][1 << 30][0]int
	a int
	b int32
}

type Holder struct {
	n int
	v Z
}

func bump(v Z) Z {
	var w Z = v
	w.a = w.a + 1
	return w
}

func main() {
	var x Z
	testing.Println(x.a)
	x.a = 41
	x.b = 7
	var y Z = bump(x)
	testing.Println(y.a)
	testing.Println(x.a)
	var h Holder
	h.n = 3
	h.v = y
	testing.Println(h.v.a + cast(int, h.v.b) + h.n)
	var arr [2]Z
	arr[1] = h.v
	var c [2]Z = arr
	testing.Println(c[0].a)
	testing.Println(c[1].a)
	var f *func(Z) Z = bump
	var d Z = f(c[1])
	testing.Println(d.a)
}
