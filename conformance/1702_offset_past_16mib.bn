package "main"

import "pkg/builtins/testing"

// A field at an offset past 16 MiB — read, written and addressed through a pointer —
// and a local of more than 16 MiB compile and run on every backend.  (On aarch64 an
// ADD / SUB immediate reaches 16 MiB at most, so such an offset or frame size is
// materialized in a register.)  The large objects are only touched when `run` is set,
// which it never is, so no mode needs 20 MB of memory; the code for them is still
// compiled.

type Big struct {
	pad [20000000]uint8
	x   int
}

var run bool

func fieldOf(p *Big) int { return p.x }

func setField(p *Big, v int) { p.x = v }

func addrOf(p *Big) *int { return &p.x }

func bigLocal(k int) int {
	var b Big
	b.x = k
	b.pad[19999999] = 3
	return b.x + cast(int, b.pad[19999999]) + fieldOf(&b)
}

func main() {
	if run {
		var p *Big = nil
		setField(p, 1)
		testing.Println(fieldOf(p) + *addrOf(p) + bigLocal(2))
	}
	testing.Println("ok")
}
