package "main"

import "pkg/builtins/testing"

// Zero-initialized globals — a large array, a struct with a pointer and an int, a
// slice — start as all zeros and take writes like any other global, and one with an
// initializer starts with its value.  (A package global's storage is all zero in the
// object — an initializer runs at start-up — so a native backend places every one in
// a zero-fill bss section, which the object file stores as a size, not as bytes.)

type Pair struct {
	p *int
	n int
}

var big [1 << 20]uint8

var pair Pair

var s *[]int

var nonzero int = 7

func sum(lo int, hi int) int {
	var t int = 0
	for i := lo; i < hi; i++ { t = t + cast(int, big[i]) }
	return t
}

func main() {
	testing.Println(sum(0, len(big)))
	testing.Println(pair.p == nil && pair.n == 0 && len(s) == 0)
	big[0] = 1
	big[len(big) - 1] = 2
	big[len(big) / 2] = 3
	testing.Println(sum(0, len(big)))
	pair.n = nonzero
	pair.p = &pair.n
	testing.Println(*pair.p)
}
