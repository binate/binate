package "main"

import "pkg/builtins/testing"

// One object reached through two anonymous struct types that differ only in a
// field's readonly — a pointer to `struct { a int }` converts to a pointer to
// `struct { a readonly int }` — so a store through one is seen by a load
// through the other: the second `q.a` reads 5, not the 1 loaded before the
// store.

func f(p @struct { a int }, q @struct { a readonly int }) int {
	var x int = q.a
	p.a = 5
	return x + q.a
}

// g is f over a function-value field whose parameter differs only in readonly.
func g(p @struct { fn *func(int) int }, q @struct { fn *func(readonly int) int }) int {
	var x int = q.fn(1)
	p.fn = ten
	return x + q.fn(1)
}

func one(v int) int {
	return v
}

func ten(v int) int {
	return 10 * v
}

func main() {
	var s @struct { a int } = make(struct { a int })
	s.a = 1
	testing.Println(f(s, s))
	var t @struct { fn *func(int) int } = make(struct { fn *func(int) int })
	t.fn = one
	testing.Println(g(t, t))
}
