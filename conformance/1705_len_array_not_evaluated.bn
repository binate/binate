package "main"

import "pkg/builtins/testing"

// len of an array is decided by the operand's type, and the operand is not
// evaluated (builtin.len): a call in it is not made, a nil pointer in it is
// not dereferenced, and it is a constant wherever one is required.

// Row is a named array type.
type Row [3]int

// S holds an array field.
type S struct {
	a [2]int
}

// calls counts the calls of mk.
var calls int

// mk returns an array, counting the call.
func mk() [4]int {
	calls = calls + 1
	var a [4]int
	return a
}

func main() {
	testing.Println(len(mk()))
	testing.Println(calls)
	var p *([5]int)
	testing.Println(len(*p))
	var ps *S
	testing.Println(len(ps.a))
	var r Row
	testing.Println(len(r))
	var b [len(mk())]int
	testing.Println(len(b))
	testing.Println(calls)
}
