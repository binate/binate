package "main"

import "pkg/builtins/testing"
import "pkg/p"
import "pkg/q"

// p.A's length is an array length here, and q.B's, declared in q's `.bni` with
// p.A's length, is one too.  Nothing defines either variable: the length of an
// array is its type's, and len does not read the operand (builtin.len).
var b [len(p.A)]int

func main() {
	testing.Println(len(b))
	testing.Println(len(q.B))
	var c [len(q.B) + 1]int
	testing.Println(len(c))
	testing.Println(cast(int, p.PF), cast(int, q.QF))
}
