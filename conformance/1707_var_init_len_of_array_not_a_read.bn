package "main"

import "pkg/builtins/testing"

// len of an array does not read its operand (builtin.len), so it is no
// initialization edge: a's initializer may take a's own length.  Inside an
// immediately-invoked literal, where a local slice shadows the package's array
// m, the length of m[k] reads m and k: k initializes first.

// h returns an array whose first element is n.
func h(n int) [3]int {
	var a [3]int
	a[0] = n
	return a
}

var a [3]int = h(len(a))

var b int = len(c) + 1

var c [5]int

var m [2][3]int

// mk returns slices of lengths 5 and 7.
func mk() @[]@[]int {
	var r @[]@[]int = make_slice(@[]int, 2)
	r[0] = make_slice(int, 5)
	r[1] = make_slice(int, 7)
	return r
}

var t int = func() int {
	var m @[]@[]int = mk()
	return len(m[k])
}()

var k int = 1

func main() {
	testing.Println(a[0])
	testing.Println(b)
	testing.Println(t)
}
