package "main"

import "pkg/builtins/testing"

import "pkg/gx"

// Another package's struct field and type alias typed through its alias of a
// generic interface's instance are the instance here, so a value of an
// interface extending the alias converts to them.

interface A : gx.X {
	One() int
}

type T struct {
	v int
}

func (t *T) Get() int { return t.v }

func (t *T) One() int { return 1 }

impl *T : A

func main() {
	var t T = T{v: 4}
	var a *A = &t
	var h gx.H
	h.V = a
	testing.Println(h.V.Get()) // 4
	var p gx.P = a
	testing.Println(p.Get()) // 4
	testing.Println(gx.Call(a)) // 5
}
