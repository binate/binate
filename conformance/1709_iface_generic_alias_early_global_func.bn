package "main"

import "pkg/builtins/testing"

// An alias of a generic interface's instance (`interface X = G[int]`) named
// before the interfaces are collected — in the parameter type of a global
// function value declared first — is the instance, so a value of an interface
// extending it converts to it at a call through the global.

var fp *func(*X) int = call

func call(x *X) int {
	return x.get() + x.base()
}

interface Base {
	base() int
}

interface G[T any] : Base {
	get() T
}

interface X = G[int]

interface A : X {
	a() int
}

type T struct {
	v int
}

func (t *T) get() int { return t.v }

func (t *T) base() int { return 10 }

func (t *T) a() int { return 1 }

impl *T : A

func main() {
	var t T = T{v: 5}
	var a *A = &t
	testing.Println(fp(a)) // 15
	var b *Base = a
	testing.Println(b.base()) // 10
}
