package "main"

import "pkg/builtins/testing"

// A function's frame is held to the target's address space (spec §21.4): two locals
// of nearly 2 GiB fit a 64-bit target's frame — the function compiles, and is never
// called, so no mode needs the memory — but pass a 32-bit target's 4 GiB, a compile
// error on every backend (not a frame whose size wraps).  The LLVM backend on x86-64
// rejects the frame too: LLVM addresses at most 2^31 - 1 bytes of frame there.

// Each local is written through k and read through j (both always 0), indices no
// optimizer can resolve or prove equal, so none can drop a local and shrink the
// frame.  big is never called: an optimizer could inline a call, moving the frame
// into main.
var k int
var j int

func big() int {
	var x [0x7FFFFFF8]uint8
	var y [0x7FFFFFF8]uint8
	var z [64]uint8
	x[5 + k] = 1
	y[0x7FFFFFF7 - k] = 2
	z[63 - k] = 3
	return cast(int, x[5 + j]) + cast(int, y[0x7FFFFFF7 - j]) + cast(int, z[63 - j])
}

func main() {
	testing.Println("ok")
}
