package "main"

import "pkg/builtins/testing"

// f's three 1 GiB arrays are passed by value on the stack on x86-64, so its stack
// arguments end 3 GiB above its frame pointer.  The function compiles — and is never
// called, so no mode needs the memory — except with the LLVM backend on x86-64, which
// rejects it: LLVM addresses at most 2^31 - 1 bytes above the frame pointer there, and
// would silently truncate the displacement of c's bytes.  aarch64 passes the arrays by
// reference; a 32-bit target addresses its whole address space.

type Big [0x40000000]uint8

var k int

func f(a Big, b Big, c Big) int {
	return cast(int, a[5 + k]) + cast(int, b[k]) + cast(int, c[0x3FFFFFFF - k])
}

func main() {
	testing.Println("ok")
}
