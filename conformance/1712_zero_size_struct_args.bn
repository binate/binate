package "main"

import "pkg/builtins/testing"

// The zero-size arguments here (`struct {}`, `[0]int`) take no register and no stack on
// every target, so the arguments after them are placed as if they were absent.  On
// x86-64: g's P2 rides the last two argument registers after four words; in h and z the
// zero-size argument follows a full register file and the P2s after it go to the stack.

type E struct {}

type P2 struct {
	a int
	b int
}

func g(e E, a int, b int, c int, d int, s P2) int {
	return a + 10 * s.a + 100 * s.b
}

func h(a int, b int, c int, d int, e2 int, f int, e E, s P2, t P2) int {
	return f + 10 * s.b + 100 * t.a + 1000 * t.b
}

func z(a int, b int, c int, d int, e2 int, f int, x [0]int, s P2) int {
	return f + 10 * s.a + 100 * s.b
}

func main() {
	var e E
	testing.Println(g(e, 1, 2, 3, 4, P2{a: 5, b: 6}))
	testing.Println(h(1, 2, 3, 4, 5, 6, e, P2{a: 7, b: 8}, P2{a: 2, b: 3}))
	var x [0]int
	testing.Println(z(1, 2, 3, 4, 5, 6, x, P2{a: 7, b: 8}))
}
