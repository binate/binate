package "main"

import "pkg/builtins/testing"

// An array length may call a function declared later in the package, generic
// or not: the length is the result's type's (builtin.len), whichever comes
// first.
var g [len(f())]int

var h [len(gf[int8]())]int

// T is an array type whose length calls f.
type T [len(f())]int

// f returns an array of 3.
func f() [3]int {
	var a [3]int
	return a
}

// gf returns an array of 2.
func gf[E any]() [2]E {
	var a [2]E
	return a
}

func main() {
	var t T
	testing.Println(len(g), len(t), len(h))
}
