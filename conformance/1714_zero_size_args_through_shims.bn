package "main"

import "pkg/builtins/testing"

// A zero-size argument takes one dispatch word through a func value, a closure or an
// interface method (docs/abi 03 §3.3) but no word in the direct call the shim makes,
// so a shim must not count the two alike: with three of them the dispatch words run
// past the argument registers while the direct call's still fit, and a shim that
// shifts the words in place must not let a later argument overwrite an earlier one.

type Z struct {
	x [0]int64
}

type E struct {}

type P2 struct {
	a int
	b int
}

func Mix(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64 {
	return cast(int64, a) + 10 * cast(int64, b) + 100 * cast(int64, c) + 1000 * cast(int64, d) +
			10000 * cast(int64, p.a) + 100000 * cast(int64, p.b)
}

func Z8(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32, p P2) int64 {
	return cast(int64, a) + 10 * cast(int64, b) + 100 * cast(int64, c) + 1000 * cast(int64, x) +
			10000 * cast(int64, p.a) + 100000 * cast(int64, p.b)
}

func Z7(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64 {
	return cast(int64, a) + 10 * cast(int64, b) + 100 * cast(int64, c) + 1000 * cast(int64, x)
}

interface Ops {
	Mix(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64
	Z7(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64
	Z4(a int32, z Z, b int32, e E) int64
}

type Impl struct {
	k int64
}

impl *Impl : Ops

func (q *Impl) Mix(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64 {
	return q.k * 1000000 + Mix(a, z, b, e, c, w, d, p)
}

func (q *Impl) Z7(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64 {
	return q.k * 1000000 + Z7(a, z, b, e, c, w, x)
}

func (q *Impl) Z4(a int32, z Z, b int32, e E) int64 {
	return q.k * 100 + cast(int64, a) + 10 * cast(int64, b)
}

func MakeMixer(k int64) @func(int32, Z, int32, E, int32, [0]float64, float64, P2) int64 {
	return func(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64 {
		return k * 1000000 + Mix(a, z, b, e, c, w, d, p)
	}
}

func MakeZ7(k int64) @func(int32, Z, int32, E, int32, [0]float64, int32) int64 {
	return func(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64 {
		return k * 1000000 + Z7(a, z, b, e, c, w, x)
	}
}

func main() {
	var z Z
	var e E
	var w [0]float64
	var p P2 = P2{a: 5, b: 6}
	var f *func(int32, Z, int32, E, int32, [0]float64, float64, P2) int64 = Mix
	testing.Println(f(1, z, 2, e, 3, w, 4.0, p))
	var g *func(int32, Z, int32, E, int32, [0]float64, int32, P2) int64 = Z8
	testing.Println(g(1, z, 2, e, 3, w, 4, p))
	var h *func(int32, Z, int32, E, int32, [0]float64, int32) int64 = Z7
	testing.Println(h(1, z, 2, e, 3, w, 4))
	var m @func(int32, Z, int32, E, int32, [0]float64, float64, P2) int64 = MakeMixer(7)
	testing.Println(m(1, z, 2, e, 3, w, 4.0, p))
	var c @func(int32, Z, int32, E, int32, [0]float64, int32) int64 = MakeZ7(7)
	testing.Println(c(1, z, 2, e, 3, w, 4))
	var im Impl
	im.k = 8
	var ops *Ops = &im
	testing.Println(ops.Mix(1, z, 2, e, 3, w, 4.0, p))
	testing.Println(ops.Z7(1, z, 2, e, 3, w, 4))
	testing.Println(ops.Z4(1, z, 2, e))
}
