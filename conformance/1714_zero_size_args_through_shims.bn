package "main"

import "pkg/builtins/testing"

// A zero-size argument takes one dispatch word through a func value, a closure or an
// interface method (docs/abi 03 §3.3) but no word in the direct call the shim makes,
// so a shim must not count the two alike: with three of them the dispatch words run
// past the argument registers while the direct call's still fit, and a shim that
// shifts the words in place must not let a later argument overwrite an earlier one —
// whatever the result's shape, with one capture or two or none that takes a word
// (only a zero-size capture), and with few arguments as well as many (a retbuf
// result leaves fewer registers for them).

type Z struct {
	x [0]int64
}

type E struct {}

type P2 struct {
	a int
	b int
}

func Mix(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64 {
	return cast(int64, a) + 10 * cast(int64, b) + 100 * cast(int64, c) + 1000 * cast(int64, d) +
			10000 * cast(int64, p.a) + 100000 * cast(int64, p.b)
}

func Z8(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32, p P2) int64 {
	return cast(int64, a) + 10 * cast(int64, b) + 100 * cast(int64, c) + 1000 * cast(int64, x) +
			10000 * cast(int64, p.a) + 100000 * cast(int64, p.b)
}

func Z7(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64 {
	return cast(int64, a) + 10 * cast(int64, b) + 100 * cast(int64, c) + 1000 * cast(int64, x)
}

interface Ops {
	Mix(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64
	Z7(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64
	Z4(a int32, z Z, b int32, e E) int64
	Sm(a int32, z Z, p P2, e E, b int32) int64
}

type Impl struct {
	k int64
}

impl *Impl : Ops

func (q *Impl) Mix(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64 {
	return q.k * 1000000 + Mix(a, z, b, e, c, w, d, p)
}

func (q *Impl) Z7(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64 {
	return q.k * 1000000 + Z7(a, z, b, e, c, w, x)
}

func (q *Impl) Z4(a int32, z Z, b int32, e E) int64 {
	return q.k * 100 + cast(int64, a) + 10 * cast(int64, b)
}

func (q *Impl) Sm(a int32, z Z, p P2, e E, b int32) int64 {
	return q.k * 1000000 + cast(int64, Small(a, z, p, e, b).a)
}

func Small(a int32, z Z, p P2, e E, b int32) P2 {
	return P2{a: cast(int, a) + 10 * cast(int, b) + 100 * p.a + 1000 * p.b, b: 7}
}

func MakeMixer(k int64) @func(int32, Z, int32, E, int32, [0]float64, float64, P2) int64 {
	return func(a int32, z Z, b int32, e E, c int32, w [0]float64, d float64, p P2) int64 {
		return k * 1000000 + Mix(a, z, b, e, c, w, d, p)
	}
}

func MakeP2(k int, j int) @func(int32, Z, int32, E, int32, [0]float64, int32) P2 {
	return func(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) P2 {
		return P2{a: k * 1000000 + j * 10000000 + cast(int, Z7(a, z, b, e, c, w, x)), b: 7}
	}
}

func MkP2(k int, j int) @func(int32, Z, int32, int32) P2 {
	return func(a int32, z Z, b int32, c int32) P2 {
		return P2{a: k * 1000000 + j * 10000000 + cast(int, a) + 10 * cast(int, b) + 100 * cast(int, c),
				b: 7}
	}
}

func MakeZ9(k int64) @func(int32, Z, int32, E, int32, [0]float64, int32, int32, int32) int64 {
	return func(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32, y int32, v int32) int64 {
		return k * 1000000 + Z7(a, z, b, e, c, w, x) + 10000 * cast(int64, y) + 100000 * cast(int64, v)
	}
}

func MakeCapZ() @func(int64, int64, int64) int64 {
	var z Z
	return func(a int64, b int64, c int64) int64 {
		var q Z = z
		_ = q
		return a + 10 * b + 100 * c
	}
}

func MakeCapZ9() @func(int64, int64, int64, int64, int64, int64, int64, int64, int64) int64 {
	var z Z
	return func(a int64, b int64, c int64, d int64, f int64, g int64, h int64, i int64,
			j int64) int64 {
				var q Z = z
				_ = q
				return a + 10 * b + 100 * c + 1000 * d + 10000 * f + 100000 * g + 1000000 * h + 10000000 * i +
						100000000 * j
			}
}

func MakeZ7(k int64) @func(int32, Z, int32, E, int32, [0]float64, int32) int64 {
	return func(a int32, z Z, b int32, e E, c int32, w [0]float64, x int32) int64 {
		return k * 1000000 + Z7(a, z, b, e, c, w, x)
	}
}

func main() {
	var z Z
	var e E
	var w [0]float64
	var p P2 = P2{a: 5, b: 6}
	var f *func(int32, Z, int32, E, int32, [0]float64, float64, P2) int64 = Mix
	testing.Println(f(1, z, 2, e, 3, w, 4.0, p))
	var g *func(int32, Z, int32, E, int32, [0]float64, int32, P2) int64 = Z8
	testing.Println(g(1, z, 2, e, 3, w, 4, p))
	var h *func(int32, Z, int32, E, int32, [0]float64, int32) int64 = Z7
	testing.Println(h(1, z, 2, e, 3, w, 4))
	var m @func(int32, Z, int32, E, int32, [0]float64, float64, P2) int64 = MakeMixer(7)
	testing.Println(m(1, z, 2, e, 3, w, 4.0, p))
	var c @func(int32, Z, int32, E, int32, [0]float64, int32) int64 = MakeZ7(7)
	testing.Println(c(1, z, 2, e, 3, w, 4))
	var im Impl
	im.k = 8
	var ops *Ops = &im
	testing.Println(ops.Mix(1, z, 2, e, 3, w, 4.0, p))
	testing.Println(ops.Z7(1, z, 2, e, 3, w, 4))
	testing.Println(ops.Z4(1, z, 2, e))
	testing.Println(ops.Sm(1, z, P2{a: 3, b: 4}, e, 2))
	var s *func(int32, Z, P2, E, int32) P2 = Small
	var sr P2 = s(1, z, P2{a: 3, b: 4}, e, 2)
	testing.Println(sr.a, sr.b)
	var c2 @func(int32, Z, int32, E, int32, [0]float64, int32) P2 = MakeP2(7, 3)
	var cr P2 = c2(1, z, 2, e, 3, w, 4)
	testing.Println(cr.a, cr.b)
	var m2 @func(int32, Z, int32, int32) P2 = MkP2(7, 3)
	var mr P2 = m2(1, z, 2, 3)
	testing.Println(mr.a, mr.b)
	var c9 @func(int32, Z, int32, E, int32, [0]float64, int32, int32, int32) int64 = MakeZ9(7)
	testing.Println(c9(1, z, 2, e, 3, w, 4, 5, 6))
	var cz @func(int64, int64, int64) int64 = MakeCapZ()
	testing.Println(cz(1, 2, 3))
	var cz9 @func(int64, int64, int64, int64, int64, int64, int64, int64, int64) int64 = MakeCapZ9()
	testing.Println(cz9(1, 2, 3, 4, 5, 6, 7, 8, 9))
}
