package "main"

import "pkg/builtins/testing"

// A closure that captures a float (or takes or returns one) and returns a multi-value
// result too big for the return registers: its shim returns the tuple through the
// caller's retbuf like any other big multi-return.  Nine int64 fields pass the
// return registers on x86-64 (three) and aarch64 (eight); MakeFloats' eight pass
// x86-64's only.  MakeTen's ten float64 arguments pass the argument registers, so
// some arrive on, and go out on, the stack.

type Nine = @func(int64) (int64, int64, int64, int64, int64, int64, int64, int64, int64)

type FNine = @func(float64) (float64, int64, int64, int64, int64, int64, int64, int64, int64)

func MakeSplit(scale float64) Nine {
	return func(a int64) (int64, int64, int64, int64, int64, int64, int64, int64, int64) {
		var s int64 = cast(int64, scale * 10.0)
		return a, a + s, a + 2 * s, a + 3 * s, a + 4 * s, a + 5 * s, a + 6 * s, a + 7 * s, a + 8 * s
	}
}

func MakeFloats(k int64) FNine {
	return func(x float64) (float64, int64, int64, int64, int64, int64, int64, int64, int64) {
		return x * 2.0, k, k + 1, k + 2, k + 3, k + 4, k + 5, k + 6, k + 7
	}
}

type FTen = @func(float64, float64, float64, float64, float64, float64, float64, float64, float64,
		float64) (float64, int64, int64, int64, int64, int64, int64, int64, int64, int64)

func MakeTen(k int64) FTen {
	return func(p0 float64, p1 float64, p2 float64, p3 float64, p4 float64, p5 float64, p6 float64,
			p7 float64, p8 float64,
			p9 float64) (float64, int64, int64, int64, int64, int64, int64, int64, int64, int64) {
				return p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9, k, k + 1, k + 2, k + 3, k + 4, k + 5,
					k + 6, k + 7, k + 8
			}
}

func main() {
	var f Nine = MakeSplit(1.5)
	r0, r1, r2, r3, r4, r5, r6, r7, r8 := f(100)
	testing.Println(r0, r1, r2, r3, r4, r5, r6, r7, r8)
	var g FNine = MakeFloats(40)
	x, k0, k1, k2, k3, k4, k5, k6, k7 := g(1.25)
	testing.Println(cast(int64, x * 4.0), k0, k1, k2, k3, k4, k5, k6, k7)
	var t FTen = MakeTen(70)
	y, j0, j1, j2, j3, j4, j5, j6, j7, j8 := t(0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5)
	testing.Println(cast(int64, y * 2.0), j0, j1, j2, j3, j4, j5, j6, j7, j8)
}
