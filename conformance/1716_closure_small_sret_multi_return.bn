package "main"

import "pkg/builtins/testing"

// A capturing closure whose multi-value result has more fields than the return
// registers hold is returned through the caller's buffer even when the tuple is 16
// bytes or fewer: its shim passes the buffer as the callee's result pointer, as for a
// larger tuple.  Four int32 fields pass x86-64's three return registers, five uint8
// fields pass arm32's four, and nine uint8 fields pass aarch64's eight.  MakeWide's
// eight captures and its argument pass the argument registers, so its shim spills
// them to the stack.  A float field does not change that: (int16 x4, float32) is 12
// bytes and four GP words, (uint8 x9, float32) 16 bytes and nine.

type Four = @func(int32) (int32, int32, int32, int32)

type Five = @func(uint8) (uint8, uint8, uint8, uint8, uint8)

type Nine = @func(uint8) (uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8)

type FourF = @func(int16) (int16, int16, int16, int16, float32)

type NineF = @func(uint8) (uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, float32)

func MakeFour(k int32) Four {
	return func(a int32) (int32, int32, int32, int32) {
		return a, a + k, a + 2 * k, a + 3 * k
	}
}

func MakeFive(k uint8) Five {
	return func(a uint8) (uint8, uint8, uint8, uint8, uint8) {
		return a, a + k, a + 2 * k, a + 3 * k, a + 4 * k
	}
}

func MakeNine(k uint8) Nine {
	return func(a uint8) (uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8) {
		return a, a + k, a + 2 * k, a + 3 * k, a + 4 * k, a + 5 * k, a + 6 * k, a + 7 * k, a + 8 * k
	}
}

func MakeWide(k0 uint8, k1 uint8, k2 uint8, k3 uint8, k4 uint8, k5 uint8, k6 uint8, k7 uint8) Nine {
	return func(a uint8) (uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8) {
		return a, a + k0, a + k1, a + k2, a + k3, a + k4, a + k5, a + k6, a + k7
	}
}

func MakeFourF(k int16) FourF {
	return func(a int16) (int16, int16, int16, int16, float32) {
		return a, a + k, a + 2 * k, a + 3 * k, cast(float32, a) * 0.5
	}
}

func MakeNineF(k uint8) NineF {
	return func(a uint8) (uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, uint8, float32) {
		return a, a + k, a + 2 * k, a + 3 * k, a + 4 * k, a + 5 * k, a + 6 * k, a + 7 * k, a + 8 * k,
			cast(float32, a) * 0.5
	}
}

func main() {
	var f Four = MakeFour(10)
	f0, f1, f2, f3 := f(100)
	testing.Println(f0, f1, f2, f3)
	var g Five = MakeFive(3)
	g0, g1, g2, g3, g4 := g(1)
	testing.Println(g0, g1, g2, g3, g4)
	var h Nine = MakeNine(2)
	h0, h1, h2, h3, h4, h5, h6, h7, h8 := h(1)
	testing.Println(h0, h1, h2, h3, h4, h5, h6, h7, h8)
	var w Nine = MakeWide(1, 2, 3, 4, 5, 6, 7, 8)
	w0, w1, w2, w3, w4, w5, w6, w7, w8 := w(10)
	testing.Println(w0, w1, w2, w3, w4, w5, w6, w7, w8)
	var p FourF = MakeFourF(10)
	p0, p1, p2, p3, px := p(100)
	testing.Println(p0, p1, p2, p3, cast(int64, px * 4.0))
	var q NineF = MakeNineF(2)
	q0, q1, q2, q3, q4, q5, q6, q7, q8, qx := q(1)
	testing.Println(q0, q1, q2, q3, q4, q5, q6, q7, q8, cast(int64, qx * 4.0))
}
