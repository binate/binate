package "main"

import "pkg/builtins/testing"

// An array length may call a method declared later in the package, of a named
// type or of an instance of a generic type, and may read a variable whose type
// is inferred from such a call: the length is the result's type's
// (builtin.len), whichever comes first.
var s S

var g [len(s.mk())]int

var h [len(s.pk())]int

var bx Box[int]

var k [len(bx.two())]int

// B is an array type whose length reads tbl, whose type is the result of a
// method declared later.
type B [len(tbl)]uint8

var tbl = s.mk()

// S is a struct whose methods are declared after the lengths calling them.
type S struct { n int }

// Box is a generic struct whose method is declared after a length calls it.
type Box[E any] struct { v E }

// mk returns an array of 3.
func (r S) mk() [3]int {
	var a [3]int
	return a
}

// pk returns an array of 4.
func (r *S) pk() [4]int {
	var a [4]int
	return a
}

// two returns an array of 2.
func (b Box[E]) two() [2]E {
	var a [2]E
	return a
}

func main() {
	var b B
	testing.Println(len(g), len(h), len(k), len(b), len(tbl))
}
