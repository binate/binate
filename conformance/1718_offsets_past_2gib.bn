package "main"

import "pkg/builtins/testing"

// Offsets and sizes past 2 GiB compile on every 64-bit target: a field past 2^31 read,
// written and addressed through a pointer; an element larger than 2 GiB addressed and
// read through a raw slice; an aggregate larger than 2 GiB (not a multiple of 32 bytes)
// copied through pointers; and one made on the heap, alone and as a managed-slice's
// element.  (On x86-64 such a displacement or immediate passes the signed 32 bits an
// instruction holds, so it is materialized in a register.)  On a 32-bit target the
// types are rejected: an object there is at most 2^31 - 1 bytes.  The large objects are
// only touched when `run` is set, which it never is, so no mode needs the memory; the
// code for them is still compiled.

type Big struct {
	pad  [0x7FFFFFF0]uint8
	more [0x20]uint8
	x    int
	y    uint8
}

type Bytes struct {
	b [0x80000013]uint8
}

var run bool

func fieldOf(p *Big) int { return p.x }

func setField(p *Big, v int) {
	p.x = v
	p.y = 7
}

func addrOf(p *Big) *int { return &p.x }

func elemAddr(s *[]Big, i int) *Big { return &s[i] }

func elemField(s *[]Big, i int) int { return s[i].x }

func copyBytes(d *Bytes, s *Bytes) { *d = *s }

func newBig() @Big { return make(Big) }

func newBigs(n int) @[]Big { return make_slice(Big, n) }

func main() {
	if run {
		var p *Big = nil
		setField(p, 1)
		var s *[]Big
		var q *Bytes = nil
		copyBytes(q, q)
		var m @Big = newBig()
		var ms @[]Big = newBigs(2)
		testing.Println(
				fieldOf(p) + *addrOf(p) + fieldOf(elemAddr(s, 1)) + elemField(s, 0) + m.x + ms[1].x)
	}
	testing.Println("ok")
}
