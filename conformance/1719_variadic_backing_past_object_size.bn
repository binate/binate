package "main"

import "pkg/builtins/testing"

// A variadic call packs its arguments into an array of the parameter's element type,
// which is held to the target's maximum object size like any other type (spec
// type.layout.max-size): two 1 GiB arguments make a 2 GiB array, too large for a
// 32-bit target -- a compile error there, as for any type too large.  A 64-bit target
// compiles it; the call is never made, so no mode needs the memory.  The LLVM backend on
// x86-64 rejects big's frame, which holds the array: LLVM addresses at most 2^31 - 1
// bytes of frame there.

type Big [1 << 30]uint8

var k int

var p *Big

func pick(xs ...Big) uint8 {
	return xs[1][k]
}

func big() uint8 {
	return pick(*p, *p)
}

func main() {
	testing.Println("ok")
}
