package "main"

import "pkg/builtins/testing"

// Calls whose stack arguments pass 2 GiB compile: three 1 GiB arrays passed by value
// to f -- on x86-64 on the stack, the third starting at 2 GiB -- directly, through a
// function value (whose shim lays them out again) and through a capturing closure's
// shim.  The calls are never made (run is never set), so no mode needs the memory.
// aarch64 passes the arrays by reference, copying them into the caller's frame; a
// 32-bit target's stack arguments pass 2 GiB too.  The LLVM backend on x86-64 rejects f
// itself, as in 1711.

type Big [0x40000000]uint8

var k int

var run bool

var p *Big

func f(a Big, b Big, c Big) int {
	return cast(int, a[k]) + cast(int, b[k]) + cast(int, c[k])
}

func direct() int {
	return f(*p, *p, *p)
}

func viaValue() int {
	var fv @func(Big, Big, Big) int = f
	return fv(*p, *p, *p)
}

func viaClosure() int {
	var x int = k
	var fv @func(Big, Big, Big) int = func(a Big, b Big, c Big) int {
		return cast(int, c[x]) + x
	}
	return fv(*p, *p, *p)
}

func main() {
	if run { testing.Println(direct() + viaValue() + viaClosure()) }
	testing.Println("ok")
}
