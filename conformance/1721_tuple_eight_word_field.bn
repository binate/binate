package "main"

import "pkg/builtins/testing"

// A multi-value result whose struct field fills every GP return register: (S64,
// float64) returns S64's eight words in X0..X7 and the float64 in D0 on aarch64, the
// most a register-returned tuple holds there.  It is returned from a direct call,
// through a function value, whose shim stores the tuple into the caller's buffer, and
// from a capturing closure; (float64, S64) puts the float first.

type S64 struct {
	a int64
	b int64
	c int64
	d int64
	e int64
	f int64
	g int64
	h int64
}

type Pair = @func(int64) (S64, float64)

type PairF = @func(int64) (float64, S64)

func mk(k int64) S64 {
	return S64{a: k, b: k + 1, c: k + 2, d: k + 3, e: k + 4, f: k + 5, g: k + 6, h: k + 7}
}

func pair(k int64) (S64, float64) {
	return mk(k), cast(float64, k) + 0.5
}

func pairF(k int64) (float64, S64) {
	return cast(float64, k) + 0.25, mk(k)
}

func MakePair(base int64) Pair {
	return func(k int64) (S64, float64) {
		return mk(k + base), cast(float64, k + base) + 0.5
	}
}

func show(s S64, x float64) {
	testing.Println(s.a, s.b, s.c, s.d, s.e, s.f, s.g, s.h, cast(int64, x * 4.0))
}

func main() {
	s, x := pair(10)
	show(s, x)
	var fv Pair = pair
	s, x = fv(20)
	show(s, x)
	var c Pair = MakePair(100)
	s, x = c(30)
	show(s, x)
	y, t := pairF(40)
	show(t, y)
	var gv PairF = pairF
	y, t = gv(50)
	show(t, y)
}
