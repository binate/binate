package "main"

import "pkg/builtins/testing"

// An aggregate with no word alignment -- a struct of bytes -- copied whole through
// pointers is moved as memmove does, without a copy staged in the frame: 16 MiB is twice
// the usual 8 MiB stack.  The source and destination are on the heap.

type Page struct {
	b [0x1000000]uint8
}

func copyPage(d *Page, s *Page) { *d = *s }

func main() {
	var a @Page = make(Page)
	var c @Page = make(Page)
	a.b[0] = 3
	a.b[0xFFFFFF] = 7
	copyPage(c, a)
	testing.Println(cast(int, c.b[0]) * 10 + cast(int, c.b[0xFFFFFF]))
}
