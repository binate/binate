package "main"

import "pkg/builtins/testing"

// A struct of bytes copied whole through pointers that overlap is copied as memmove does:
// all of the source is read before any of the destination is written, whichever way the
// two overlap.  20 bytes, the destination one byte above the source, then one byte below
// it; 67 bytes (odd, past what a backend loads whole into registers) the same; 813 bytes
// 30 bytes up, 13 down, and onto itself.

type Twenty struct {
	b [20]uint8
}

type Odd67 struct {
	b [67]uint8
}

type Odd813 struct {
	b [813]uint8
}

func move(d *Twenty, s *Twenty) { *d = *s }

func move67(d *Odd67, s *Odd67) { *d = *s }

func move813(d *Odd813, s *Odd813) { *d = *s }

func at(buf @[]uint8, i int) *Twenty { return bit_cast(*Twenty, &buf[i]) }

func at67(buf @[]uint8, i int) *Odd67 { return bit_cast(*Odd67, &buf[i]) }

func at813(buf @[]uint8, i int) *Odd813 { return bit_cast(*Odd813, &buf[i]) }

func show(buf @[]uint8, from int, to int) {
	testing.Print(cast(int, buf[from]))
	for i := from + 1; i < to; i++ {
		testing.Print(" ")
		testing.Print(cast(int, buf[i]))
	}
	testing.Println("")
}

// sum weighs each byte by its position, so a byte moved to the wrong place changes it.
func sum(buf @[]uint8) int {
	var s int = 0
	for i := 0; i < len(buf); i++ { s = s + (i + 1) * cast(int, buf[i]) }
	return s
}

func main() {
	var buf @[]uint8 = make_slice(uint8, 64)
	for i := 0; i < 64; i++ { buf[i] = cast(uint8, i) }
	move(at(buf, 11), at(buf, 10))
	show(buf, 9, 33)
	move(at(buf, 40), at(buf, 41))
	show(buf, 38, 62)
	var big @[]uint8 = make_slice(uint8, 2100)
	for i := 0; i < len(big); i++ { big[i] = cast(uint8, i * 7) }
	move67(at67(big, 101), at67(big, 100))
	testing.Println(sum(big))
	move67(at67(big, 200), at67(big, 201))
	testing.Println(sum(big))
	move813(at813(big, 330), at813(big, 300))
	testing.Println(sum(big))
	move813(at813(big, 1200), at813(big, 1213))
	testing.Println(sum(big))
	move813(at813(big, 600), at813(big, 600))
	testing.Println(sum(big))
}
