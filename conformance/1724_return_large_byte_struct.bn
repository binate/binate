package "main"

import "pkg/builtins/testing"

// An aggregate with no word alignment -- a struct of bytes -- returned whole from behind
// a pointer is copied into the caller's result without a copy staged in the callee's
// frame, and in the VM its return reserves no second image on the stack: 4.5 MiB fits
// the usual 8 MiB stack once, as the result the caller receives, but not twice.  The
// copy reads the source at any alignment: Odd's source starts at an odd address
// (offset 5 in a 4-byte-aligned global).

type Page struct {
	b [0x480000]uint8
}

type Odd struct {
	b [40]uint8
}

type Holder struct {
	w   int32
	pad uint8
	odd Odd
}

var src Page

var holder Holder

func get(s *Page) Page { return *s }

func getOdd(s *Odd) Odd { return *s }

func main() {
	src.b[0] = 3
	src.b[0x47FFFF] = 7
	src = get(&src)
	testing.Println(cast(int, src.b[0]) * 10 + cast(int, src.b[0x47FFFF]))
	for i := 0; i < 40; i++ {
		holder.odd.b[i] = cast(uint8, i + 1)
	}
	var sum int = 0
	var o Odd = getOdd(&holder.odd)
	for i := 0; i < 40; i++ {
		sum = sum + cast(int, o.b[i]) * (i + 1)
	}
	testing.Println(sum)
}
