package "main"

import "pkg/builtins/testing"

// A function returning one aggregate reserves its frame and no second image of the
// result on the VM stack: 4.5 MiB fits the usual 8 MiB stack once, as the result the
// caller receives, but not twice.

type Page struct {
	w [0x120000]int32
}

var src Page

func get(s *Page) Page { return *s }

func main() {
	src.w[0] = 3
	src.w[0x11FFFF] = 7
	src = get(&src)
	testing.Println(src.w[0] * 10 + src.w[0x11FFFF])
}
