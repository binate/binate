package "main"

import "pkg/builtins/testing"

// A call's aggregate result stored into a local -- one declared with it, or the
// temporary a field of it is read through -- is written straight into the local, with no
// second copy staged on the stack: 4.5 MiB fits the usual 8 MiB stack once, as the
// local, but not twice.

type Page struct {
	b [0x480000]uint8
}

var src Page

func get(s *Page) Page { return *s }

func declared() int {
	var r Page = get(&src)
	return cast(int, r.b[0]) * 10 + cast(int, r.b[0x47FFFF])
}

func field() int { return cast(int, get(&src).b[0x47FFFF]) }

func main() {
	src.b[0] = 3
	src.b[0x47FFFF] = 7
	testing.Println(declared())
	testing.Println(field())
}
