package "main"

import "pkg/builtins/testing"

import "pkg/rg"

// pkg/rg declares types in full twice where one of the declarations is a
// `type ( … )` group member: across its .bni and .bn, either way round, and
// in two groups of the .bn.  Each is a duplicate type definition, so this
// program must fail to compile.
func main() {
	var t @rg.Thing = rg.Make(7)
	testing.Println(t.V)
}
