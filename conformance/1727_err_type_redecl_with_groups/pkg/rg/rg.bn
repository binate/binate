package "pkg/rg"

// Thing is declared in full again, with another layout.
type Thing struct {
	V int
	W int
}

// Plain is declared in full again, in a group.
type (
	Plain struct {
		V int
	}
	Local int
)

// Twice is declared in full in two groups.
type (
	Twice int
	A int
)

// Twice again, in another group.
type (
	B int
	Twice bool
)

func Make(v int) @Thing {
	var t @Thing = make(Thing)
	t.V = v
	return t
}
