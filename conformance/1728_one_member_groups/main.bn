package "main"

import "pkg/builtins/testing"
import "pkg/og"

// A parenthesized `var ( … )` or `type ( … )` block of one member declares what the
// bare member would: at top level (a generic type too), as a local declaration, and
// in a `.bni` (an extern variable, an exported type) and the `.bn` defining it.

type (
	Point struct {
		X int
		Y int
	}
)

type (
	Box[T any] struct {
		V T
	}
)

var (
	origin Point = Point{X: 1, Y: 2}
)

func main() {
	var (
		q og.Pair = og.Pair{A: 4, B: 5}
	)
	testing.Println(og.Sum(q)) // 9
	testing.Println(og.Bump(2)) // 6
	testing.Println(og.Bump(1)) // 9
	testing.Println(og.Count) // 9
	testing.Println(origin.X, origin.Y) // 1 2
	var (
		bx Box[int] = Box[int]{V: 7}
	)
	testing.Println(bx.V) // 7
}
