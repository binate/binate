package "pkg/og"

// Count is an extern variable declared in a one-member group.
var (
	Count int
)

// Pair is an exported type declared in a one-member group.
type (
	Pair struct {
		A int
		B int
	}
)

// Sum returns p's fields added.
func Sum(p Pair) int

// Bump adds n times the package's step to Count and returns the new Count.
func Bump(n int) int
