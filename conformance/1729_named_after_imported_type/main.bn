package "main"
import "pkg/builtins/testing"

import "pkg/nameimp"

// A type may take the name of the type it is declared over in another package
// (`type T nameimp.T`): they are different types, so the declaration is no cycle, and
// T has nameimp.T's layout and fields (type.named.transparency).  U is over T, a chain
// through both packages.

type T nameimp.T

type U T

func main() {
	var x T
	x.A = 3
	x.B = 4
	var u U
	u.A = 5
	testing.Println(x.A + x.B)
	testing.Println(u.A)
	testing.Println(nameimp.Sum(cast(nameimp.T, x)))
	if sizeof(T) == sizeof(nameimp.T) && sizeof(U) == sizeof(nameimp.T) {
		testing.Println("same size")
	}
}
