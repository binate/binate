package "main"

import "pkg/builtins/testing"
import "pkg/cyc"

// A cycle of named types declared in an imported .bni is reported, as one in a .bn
// is: two types over each other, one over itself, and one over itself through
// readonly.  main uses none of them; the package's declarations alone are invalid.

func main() {
	testing.Println(cyc.F())
}
