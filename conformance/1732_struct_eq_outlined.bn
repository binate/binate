package "main"

import "pkg/builtins/testing"

// A struct comparison with more than 16 scalar leaves is a call to its type's equality
// helper, and a nested struct over that is a call to its own (S4 .. S8 here, each twice the
// one below).  Equality is still field by field, at every depth: a difference at any leaf
// makes the structs unequal, a float field compares as a float (NaN is unequal to itself,
// -0.0 equals 0.0), and an array of such structs compares each element by the helper.

type S0 struct {
	a int
	b int
}

type S1 struct {
	a S0
	b S0
}

type S2 struct {
	a S1
	b S1
}

type S3 struct {
	a S2
	b S2
}

type S4 struct {
	a S3
	b S3
}

type S5 struct {
	a S4
	b S4
}

type S6 struct {
	a S5
	b S5
}

type S7 struct {
	a S6
	b S6
}

type S8 struct {
	a S7
	b S7
}

type F struct {
	x [12]float64
	y float64
	s S4
}

type Big struct {
	p   S5
	arr [3]S4
	q   int8
}

func main() {
	var x S8
	var y S8
	testing.Println(x == y)
	y.b.a.b.a.b.a.b.a.b = 7
	testing.Println(x == y)
	testing.Println(x != y)
	x.b.a.b.a.b.a.b.a.b = 7
	testing.Println(x == y)
	x.a.a.a.a.a.a.a.a.a = -1
	testing.Println(x == y)

	var zero float64 = 0.0
	var f F
	var g F
	f.x[11] = -zero
	testing.Println(f == g)
	f.y = zero / zero
	g.y = f.y
	testing.Println(f == g)
	f.y = 1.5
	g.y = 1.5
	testing.Println(f == g)
	g.s.b.b.b.b.b = 3
	testing.Println(f != g)

	var p Big
	var q Big
	testing.Println(p == q)
	q.arr[2].a.b.a.b.a = 9
	testing.Println(p == q)
	p.arr[2].a.b.a.b.a = 9
	testing.Println(p == q)
	p.q = 1
	testing.Println(p == q)
}
