package "main"

import "pkg/builtins/testing"

// A struct field of more than 16 scalar leaves is compared by a call to its type's
// equality helper, and each such call has a fault pad, as every call does: in the bytecode
// VM a stack overflow at one is the recoverable fault (`runtime error: stack overflow`), not
// an abort.  rec's frames are small (it compares through pointers, in place) and each
// compares two S8, whose comparison calls S7's helper, then S6's, S5's and S4's, four frames
// past rec's own, so the overflow lands in a helper call.  Compiled backends stay fatal (a
// native stack overflow has no message; see 1105), so this is VM-only.

type S0 struct {
	a int
	b int
}

type S1 struct {
	a S0
	b S0
}

type S2 struct {
	a S1
	b S1
}

type S3 struct {
	a S2
	b S2
}

type S4 struct {
	a S3
	b S3
}

type S5 struct {
	a S4
	b S4
}

type S6 struct {
	a S5
	b S5
}

type S7 struct {
	a S6
	b S6
}

type S8 struct {
	a S7
	b S7
}

type H struct {
	v S8
}

func rec(p *H, q *H, n int) int {
	if p.v != q.v { return n }
	return rec(p, q, n + 1) + 1
}

func main() {
	testing.Println("before")
	var x H
	var y H
	var r int = rec(&x, &y, 0)
	_ = r
	testing.Println("after")
}
