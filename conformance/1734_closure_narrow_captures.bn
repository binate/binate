package "main"

import "pkg/builtins/testing"

// A closure's captures reach its body with their own values: a negative int8, int16
// or int32 compares equal to itself at full width, an unsigned capture carries none of
// the bytes of the capture after it, and a struct capture of 3 or 12 bytes keeps its
// last field.  The closures cover the shims' register and stack capture paths, an
// aggregate result, a float argument, a managed closure and a method value whose
// receiver is a narrow integer.

type N int8

func (n N) isMinus3() bool {
	return n == -3
}

type Odd struct {
	a int8
	b int8
	c int8
}

type Trip struct {
	x int32
	y int32
	z int32
}

type Big struct {
	x int
	y int
	z int
}

func run(f *func() bool) bool {
	return f()
}

func runF(f *func(float64) bool, x float64) bool {
	return f(x)
}

func runB(f *func() Big) Big {
	return f()
}

func run8(f *func(int, int, int, int, int, int, int, int) bool) bool {
	return f(1, 2, 3, 4, 5, 6, 7, 8)
}

func runM(f @func() bool) bool {
	return f()
}

func main() {
	var a int32 = -5
	var b int32 = 7
	var c int8 = -3
	var d int16 = -300
	var u uint16 = 40000
	var v uint16 = 3
	var w uint32 = 4000000000
	var t bool = true
	testing.Println(run(func() bool { return a == -5 }))
	testing.Println(run(func() bool { return c == -3 && d == -300 }))
	testing.Println(run(func() bool { return u == 40000 && v == 3 }))
	testing.Println(run(func() bool { return a == -5 && b == 7 && w == 4000000000 && t }))

	// Ten captures: past the eight argument registers, so the last ones go on the stack.
	var c0 int8 = -1
	var c1 int8 = -2
	var c2 int8 = -3
	var c3 int8 = -4
	var c4 int8 = -5
	var c5 int8 = -6
	var c6 int8 = -7
	var c7 int8 = -8
	var c8 int8 = -9
	var c9 int8 = -10
	testing.Println(
			run(func() bool {
				return c0 == -1 && c1 == -2 && c2 == -3 && c3 == -4 && c4 == -5 && c5 == -6 && c6 == -7 &&
						c7 == -8 && c8 == -9 && c9 == -10
			}))
	testing.Println(
			run8(func(p1 int, p2 int, p3 int, p4 int, p5 int, p6 int, p7 int, p8 int) bool {
				return c == -3 && a == -5 && p1 == 1 && p8 == 8
			}))

	// A 12-byte struct at offset 4 of its closure struct, and a 3-byte one after it.
	var p int32 = -4
	var q Trip
	q.x = -5
	q.y = -6
	q.z = -7
	var o Odd
	o.a = -1
	o.b = -2
	o.c = -3
	testing.Println(run(func() bool { return p == -4 && q.x == -5 && q.z == -7 }))
	testing.Println(run(func() bool { return o.a == -1 && o.c == -3 && p == -4 }))

	var r Big = runB(func() Big {
		var g Big
		if c == -3 { g.x = 1 }
		if a == -5 { g.z = 2 }
		return g
	})
	testing.Println(r.x == 1 && r.z == 2)
	testing.Println(runF(func(x float64) bool { return x == 1.5 && c == -3 && a == -5 }, 1.5))

	var mf @func() bool = func() bool { return d == -300 && c == -3 }
	testing.Println(runM(mf))
	var n N = -3
	testing.Println(run(n.isMinus3))
}
