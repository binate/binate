package "main"

// A generic instance whose type argument points to an instance whose type argument
// points to one embedding an opaque type by value is ill-formed, as one level of it
// is (851): the pointee can never be a value, and forming it would lay out the
// opaque type, which has no layout.  This program must fail to compile.
type Opaque

type W[T any] struct { v T }

type L[T any] struct { n *T }

func twoLevels(a W[*W[*W[[1]Opaque]]]) {}

func threeLevels(p *L[*L[*L[[1]Opaque]]]) {}

func main() {}
