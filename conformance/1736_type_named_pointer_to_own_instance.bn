package "main"

import "pkg/builtins/testing"

// A named pointer type to an instance of a generic over itself is a legal recursive
// type: the recursion goes through a pointer.  It must compile.
type W[T any] struct { v T }

type NP *W[NP]

func main() {
	var p NP
	if p == nil { testing.Println(1) }
}
