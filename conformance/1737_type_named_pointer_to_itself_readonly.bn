package "main"

import "pkg/builtins/testing"

// Named pointer types to themselves through readonly are legal recursive types: the
// recursion goes through a pointer -- directly, through an alias, or through a
// generic's instance.  This program must compile.
type N1 *readonly N1

type N2 *readonly A2

type A2 = N2

type G[T any] *readonly G[T]

func f(p G[int]) {}

func main() {
	var p N1
	if p == nil { testing.Println(1) }
}
