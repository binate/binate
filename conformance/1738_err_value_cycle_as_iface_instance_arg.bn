package "main"

// Types that hold themselves by value have no layout, and are reported as recursive
// types -- also where they are reached before their own declarations are checked:
// as an interface instance's argument, whose methods are sized as collection ends,
// a parent interface's, an array length's sizeof in a method there, a generic
// instance's method's, and through an alias declared before them.  This program must
// fail to compile.
interface L[B any] {
	LN(f *B)
}

type N1 [1]N1

func f1(b @L[N1]) {}

type N2 struct { a [1]N2 }

func f2(b @L[N2]) {}

interface Q3 : L[N3] {
	M()
}

type N3 [1]N3

interface P[B any] {
	LN(f [sizeof(B)]int)
}

interface Q4 : P[N4] {
	M()
}

type N4 [1]N4

type G[T any] struct { p *T }

func f5(g *G[N5]) {}

func (g *G[T]) M(a [sizeof(T)]int) {}

type N5 [1]N5

interface K[B any] {
	LN(f int)
}

interface Q6 : K[A6] {
	M()
}

type A6 = W[N6]

type N6 [1]A6

type W[T any] struct { v T }

func main() {}
