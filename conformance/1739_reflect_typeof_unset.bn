package "main"

import "pkg/builtins/reflect"
import "pkg/builtins/testing"

// reflect.TypeOf of an unset interface value (no vtable, so no dynamic type) is
// nil -- through the inline lowering of a direct call and through reflect's own
// body, reached by a func value -- and a boxed value's record is never nil; the two
// paths agree on it.  Prints 1 for each check.

interface G {
	get() int
}

type T struct {
	X int
}

func (t *T) get() int {
	return t.X
}

impl *T : G

func isNil(ti *reflect.TypeInfo) int {
	if ti == nil { return 1 }
	return 0
}

func main() {
	var tf *func(*any) *reflect.TypeInfo = reflect.TypeOf
	var u *any
	testing.Println(isNil(reflect.TypeOf(u)))
	testing.Println(isNil(tf(u)))
	var g *G
	var a *any = g
	testing.Println(isNil(reflect.TypeOf(a)))
	testing.Println(isNil(tf(a)))
	var t T
	var b *any = &t
	testing.Println(1 - isNil(reflect.TypeOf(b)))
	testing.Println(cast(int, bit_cast(int, reflect.TypeOf(b)) == bit_cast(int, tf(b))))
}
