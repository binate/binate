package "main"

import "pkg/builtins/testing"

import "pkg/rowlib"

// A value-receiver method called directly on a composite literal of a named array or
// managed-slice type (`Row{4, 5, 6}.Mid()`).  The literal's value has the type's
// underlying layout (storage of a `[3]int`, an `@[]int`), but the call names the
// named type's method: here, an imported type's, inside a deferred call and a generic
// body, and a generic named array's.

type Row [3]int

func (r Row) Mid() int { return r[1] }

func (r Row) Show() { testing.Println(r[2]) }

type Ints @[]int

func (s Ints) First() int { return s[0] }

type Pair[T any] [2]T

func (p Pair[T]) Second() T { return p[1] }

func viaGeneric[T any](x T) int { return Row{40, 41, 42}.Mid() }

func deferred() {
	defer { Row{1, 2, 3}.Show() }
	testing.Println(0)
}

func main() {
	testing.Println(Row{4, 5, 6}.Mid())
	testing.Println(Ints{7, 8}.First())
	testing.Println(rowlib.Row{10, 11, 12}.Mid())
	testing.Println(rowlib.Ints{13, 14}.First())
	deferred()
	testing.Println(viaGeneric[int](1))
	testing.Println(Pair[int]{30, 31}.Second())
}
