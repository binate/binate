package "main"

import "pkg/builtins/testing"

import "pkg/slib"

// box of a composite literal of a named managed-slice type (`box(Ints{7, 8})`).
// The literal's value has the type's underlying layout (an `@[]int`), but the box
// holds an `Ints`: it converts to an interface Ints implements and asserts from
// `@any` to `@Ints`, while a box of an `@[]int` does not.  Also an imported type's
// literal, an alias's, a generic named slice's, and one boxed inside a generic body
// or method.  A box holds its argument's type: a sub-slice of an `Ints` is an
// `@[]int` (type.slice.subslice), a cast to a named raw slice its named type.

type Ints @[]int

func (s Ints) First() int { return s[0] }

interface Firster {
	First() int
}

impl Ints : Firster

type AI = Ints

type RawInts *[]int

type List[T any] @[]T

func (l List[T]) Last() T { return l[len(l) - 1] }

func (l List[U]) Rebox() @any { return box(List[U]{l[0]}) }

func viaGeneric[T any](x T) @any { return box(List[T]{x}) }

func main() {
	var f @Firster = box(Ints{7, 8})
	testing.Println(f.First())

	var a @any = box(Ints{11, 12})
	var bi @Ints
	var ok bool
	bi, ok = a.(@Ints)
	testing.Println(ok)
	if ok { testing.Println(bi.First()) }
	switch v := a.(type) {
	case @Ints:
		testing.Println(v.First() + 100)
	default:
		testing.Println(-1)
	}
	var plain @[]int = make_slice(int, 2)
	var a2 @any = box(plain)
	_, ok = a2.(@Ints)
	testing.Println(ok)
	var al @Firster = box(AI{6})
	testing.Println(al.First())

	var ni Ints = Ints{1, 2, 3}
	var sub @any = box(ni[0:2])
	_, ok = sub.(@[]int)
	testing.Println(ok)
	_, ok = sub.(@Ints)
	testing.Println(ok)
	var rs @any = box(cast(RawInts, plain[0:1]))
	_, ok = rs.(@RawInts)
	testing.Println(ok)

	var sf @slib.Firster = box(slib.Ints{21, 22})
	testing.Println(sf.First())
	var sa @any = box(slib.Ints{23, 24})
	var si @slib.Ints
	si, ok = sa.(@slib.Ints)
	testing.Println(ok)
	if ok { testing.Println(si.First()) }

	var g @any = box(List[int]{30, 31})
	var li @List[int]
	li, ok = g.(@List[int])
	testing.Println(ok)
	if ok { testing.Println(li.Last()) }
	li, ok = viaGeneric[int](40).(@List[int])
	testing.Println(ok)
	if ok { testing.Println(li.Last()) }
	var l16 List[int16] = List[int16]{3}
	_, ok = l16.Rebox().(@List[int16])
	testing.Println(ok)
}
