package "main"

import "pkg/builtins/testing"
import "pkg/dcons"

// gen.mono.check: generics of another package whose constraint depends on a
// type parameter's length -- fwd's call and W's field, whose type argument *N
// satisfies Eq[[sizeof(U)]uint8] for U = int64 only -- are left by their
// package's check to each instantiation, and judged where the importer forms
// them: fwd[int64] and W[int64] are valid.

func main() {
	var n dcons.N
	testing.Println(dcons.fwd[int64](&n))
	var w dcons.W[int64]
	_ = w
	testing.Println(1)
}
