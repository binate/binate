package "main"

import "pkg/anyimpl"
import "pkg/builtins/testing"

// An impl's rows are keyed on the types the checker resolved its receiver and
// interfaces to.  `impl *T : any` (pkg/anyimpl) lists the universe interface, which
// every type satisfies: a T boxed into any, in its own package or here, asserts
// back.  An impl here on another package's type (`impl *anyimpl.T : Namer`) is
// keyed on the type's package, so a box made here dispatches to its method.  An
// impl on an alias of a generic instance (`impl *R8 : Getter`) is keyed on the
// instance, so a box of an R[int] dispatches.  `interface anyimpl.Named : any`
// adds nothing to Named, so a box of T into it, made here, dispatches.

interface Namer {
	Name() int
}

impl *anyimpl.T : Namer

interface Getter {
	Get() int
}

type R[A any] struct {
	a A
}

func (r *R[A]) Get() int {
	return 7
}

type R8 = R[int]

impl *R8 : Getter

func main() {
	var t @anyimpl.T = anyimpl.Make(4)
	var a @any = t
	var back @anyimpl.T
	var ok bool
	back, ok = a.(@anyimpl.T)
	testing.Println(ok)
	if ok { testing.Println(back.Name()) }
	var h @any = anyimpl.BoxHere(anyimpl.Make(5))
	back, ok = h.(@anyimpl.T)
	testing.Println(ok)
	if ok { testing.Println(back.Name()) }
	var nm @Namer = t
	testing.Println(nm.Name())
	var nd @anyimpl.Named = t
	testing.Println(nd.Name())
	var r R[int]
	var g *Getter = &r
	testing.Println(g.Get())
}
