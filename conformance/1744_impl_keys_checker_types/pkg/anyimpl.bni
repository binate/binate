package "pkg/anyimpl"

// T's impl lists the universe interface any, which every type satisfies anyway.
type T struct {
	n int
}

impl *T : any

// Named extends any, which adds nothing; an importer boxes into it and dispatches.
interface Named : any {
	Name() int
}

impl *T : Named

func Make(n int) @T

func (t *T) Name() int

func BoxHere(t @T) @any
