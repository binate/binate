package "main"

import "pkg/builtins/testing"
import "pkg/tib"
import "pkg/tiplib"

// gen.mono.check: Wrap[int16]'s impl does not cover Sized[int16] (Put takes a
// [8]uint8, Sized[int16] asks for a [2]uint8), formed both here and in pkg/tib:
// the error names the instance and where it is instantiated, as with one
// importer (spec/12-generics/095_err_generic_impl_instance_imported).

func main() {
	var w tiplib.Wrap[int16]
	_ = w
	testing.Println(tib.B())
}
