package "main"

import "pkg/builtins/testing"

// An interface's parents are the interfaces the checker resolved them to.
// `interface Named : any` lists the universe interface, which every interface
// already extends, so it adds nothing: a box of T into a descendant dispatches its
// own and an inherited method, upcasts to Named and then to any, and asserts back.  A parent named through an
// alias (`interface Labeled : NamedAlias`) is the alias's target, so a Labeled box
// upcasts to Named.

interface Named : any {
	Name() int
}

interface NamedAlias = Named

interface Labeled : NamedAlias {
	Label() int
}

type T struct {
	n int
}

func (t *T) Name() int {
	return t.n
}

func (t *T) Label() int {
	return t.n + 1
}

impl *T : Labeled

func main() {
	var t T
	t.n = 4
	var l *Labeled = &t
	testing.Println(l.Label())
	testing.Println(l.Name())
	var nm *Named = l
	testing.Println(nm.Name())
	var a *any = nm
	var back *T
	var ok bool
	back, ok = a.(*T)
	testing.Println(ok)
	if ok { testing.Println(back.n) }
}
