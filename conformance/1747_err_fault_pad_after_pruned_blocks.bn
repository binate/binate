package "main"

import "pkg/builtins/testing"

// f's fault at t[k] lands in a cleanup pad that releases t.  Its other faults lie in
// code that never runs -- the `if dbg` arm, whose branch is on a constant false once
// dbg is promoted to a register, and the code after the if / else, both arms of which
// return -- and land in pads that also release w or u, locals of that code.  Only the
// VM runs fault pads; there mem2reg, one of its default passes, drops the block of the
// code after the if / else, which no path reaches, and branch folding, when enabled,
// drops the `if dbg` arm as well, each dropping with those blocks the pads only they
// reached.  f must still run, and f(5) must fault at t[k] (under the VM, through the
// pad kept for it).
func f(k int) int {
	var t @[]int = make_slice(int, 2)
	t[0] = 10
	t[1] = 20
	var dbg bool = false
	var total int = t[k]
	if dbg {
		var w @[]int = make_slice(int, 3)
		total = total + w[k] + t[k]
	}
	if k > 100 {
		return total
	} else {
		return total + 1
	}
	var u @[]int = make_slice(int, 4)
	return u[k] + t[k]
}

func main() {
	testing.Println(f(0))
	testing.Println(f(1))
	testing.Println(f(5))
}
