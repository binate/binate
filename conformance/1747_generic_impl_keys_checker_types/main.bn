package "main"

import "pkg/builtins/testing"
import "pkg/gbox"

// A parameterized impl may list the universe `any`, which adds nothing: a box of an
// instance into `any` asserts to the other interface the impls list, whether the
// generic type and its impls are another package's or this one's.

type Pair[T any] struct {
	a T
	b T
}

interface Sizer {
	Size() int
}

func (p *Pair[T]) Size() int { return 2 }

impl *Pair[U] : any

impl *Pair[U] : Sizer

func main() {
	var b @gbox.Box[int] = make(gbox.Box[int])
	var x @any = b
	var g @gbox.Getter = x.(@gbox.Getter)
	testing.Println(g.Get())
	var p @Pair[int] = make(Pair[int])
	var y @any = p
	var s @Sizer = y.(@Sizer)
	testing.Println(s.Size())
}
