package "pkg/gbox"

// Getter reads a value.
interface Getter {
	Get() int
}

// Box holds one value.
type Box[T any] struct {
	V T
}

// Get returns 40.
func (b *Box[T]) Get() int {
	return 40
}

// Listing the universe `any` adds nothing: an importer boxes a Box[int] into `any`
// and asserts it to Getter.
impl *Box[U] : any

impl *Box[U] : Getter
