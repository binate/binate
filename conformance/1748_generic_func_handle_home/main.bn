package "main"

import "pkg/builtins/testing"
import "pkg/glib"
import "pkg/rlib"

// main declares a helper of its own, which glib's and rlib's generic bodies must
// not take.
func helper() int { return 2 }

func main() {
	testing.Println(glib.H[int]() == glib.HelperHandle(), glib.H[int]() == _func_handle(helper))
	var b glib.Box[int]
	testing.Println(b.H() == glib.HelperHandle(), b.H() == _func_handle(helper))
	testing.Println(glib.N[int]() == rlib.RHandle(), glib.N[int]() == _func_handle(helper))
}
