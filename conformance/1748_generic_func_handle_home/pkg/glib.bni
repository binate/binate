package "pkg/glib"

import "pkg/rlib"

func helper() int

// HelperHandle returns the handle of this package's helper.
func HelperHandle() *uint8

// H returns, in each instance, the handle of this package's helper: a generic
// body's names mean what they mean where it is declared.
func H[T any]() *uint8 {
	return _func_handle(helper)
}

// Box's method H returns, in each instance, the handle of this package's helper,
// as H does.
type Box[T any] struct {
	v T
}

func (b *Box[T]) H() *uint8 {
	return _func_handle(helper)
}

// N returns, in each instance, the handle of rlib's helper, through rlib's
// generic R: a generic body instantiated from another generic body names what
// it names where it is declared too.
func N[T any]() *uint8 {
	return rlib.R[T]()
}
