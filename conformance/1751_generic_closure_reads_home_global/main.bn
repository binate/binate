package "main"

import "pkg/builtins/testing"
import "pkg/glib"

// A closure in a generic body reads and writes its own package's variable live,
// as a closure in one of that package's functions does: the variable is no
// capture, though the body is checked and emitted for this package.
func main() {
	var read *func() int = glib.Reader[int]()
	testing.Println(read())
	glib.Count = 20
	testing.Println(read())
	var bump *func() int = glib.Bump[int]()
	testing.Println(bump())
	testing.Println(glib.Count)
	testing.Println(glib.SetAndRead[int](7))
	testing.Println(glib.SetAndAdd[int](30, 5))
}
