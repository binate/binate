package "pkg/glib"

// Count is the variable the generic bodies' closures read and write.
var Count int

// Reader returns a closure that reads Count when it is called.
func Reader[T any]() *func() int {
	return func() int { return Count }
}

// Bump returns a closure that adds one to Count and returns it.
func Bump[T any]() *func() int {
	return func() int {
		Count = Count + 1
		return Count
	}
}

// SetAndRead sets Count to v, then returns what a closure made before the
// assignment reads.
func SetAndRead[T any](v int) int {
	var f *func() int = func() int { return Count }
	Count = v
	return f()
}

// SetAndAdd sets Count to v, then returns what a closure made before the
// assignment, which captures d, reads: Count + d.
func SetAndAdd[T any](v int, d int) int {
	var f *func() int = func() int { return Count + d }
	Count = v
	return f()
}
