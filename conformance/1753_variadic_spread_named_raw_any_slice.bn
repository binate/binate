package "main"

import "pkg/builtins/testing"

// A raw slice of `*any` spread into a variadic `...*any` call whose callee is native
// code under the VM (pkg/builtins/testing): each element's interface value is passed through,
// whether the slice's type is an alias of `*[]*any` or a named type over it, or over
// a named type over it, at any depth (each named type's underlying is the next).

type Alias = *[]*any

type N1 *[]*any

type N2 N1

type N3 N2

func main() {
	var x int = 7
	var y int = 8
	var parts [2]*any = [2]*any{x, y}
	var a Alias = parts[:]
	testing.Println(a...)
	var n1 N1 = parts[:]
	testing.Println(n1...)
	var n2 N2 = parts[:]
	testing.Println(n2...)
	var n3 N3 = parts[:]
	testing.Println(n3...)
}
