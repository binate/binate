package "main"

import "pkg/builtins/testing"

// A native variadic `...*any` function (pkg/builtins/testing's Println, native code
// under the VM) called through a function value gets its arguments' interface values,
// packed from separate arguments or spread from a slice.

func main() {
	var x int = 7
	var y int = 8
	var p *func(...*any) = testing.Println
	p(x, y)
	var parts [2]*any = [2]*any{x, y}
	var s *[]*any = parts[:]
	p(s...)
}
