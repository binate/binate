package "main"

import "pkg/builtins/testing"
import "pkg/lalias"
import "pkg/lfwd"

type P struct {
	x int
}

func (p P) Add(a int, b int) int { return p.x + a + b }

func (p P) Mul(a int, b int) int { return p.x * 100 + a * b }

func (p P) Sub(a int, b int) int { return p.x - a - b }

// locv is P here: pkg/lfwd exposes the package locv but binds it no name in
// this file.
type locv = P

// G takes P's Add through locv in a generic body of this package.
func G[T any](t T) int {
	var g *func(P, int, int) int = locv.Add
	return g(P{x: 5}, 1, 1)
}

// A method expression on a type alias names the method of the alias's target,
// as a value or called, also where the alias is named like a package whose path
// is a single segment -- one exposed through a forwarder (here), one a package
// imports under another name (pkg/lalias) -- and that package declares a
// variable of the method's name (Mul; Sub, nil); and in generic bodies.
func main() {
	var g *func(P, int, int) int = locv.Add
	testing.Println(g(P{x: 1}, 2, 3))
	testing.Println(locv.Add(P{x: 4}, 5, 6))
	testing.Println(locv.Mul(P{x: 1}, 2, 3))
	testing.Println(present(locv.Sub))
	testing.Println(G[int](0))
	testing.Println(lfwd.Add(1, 2))
	testing.Println(lalias.Run())
	testing.Println(lalias.Gen[int](0))
	testing.Println(lalias.RunGen())
}
