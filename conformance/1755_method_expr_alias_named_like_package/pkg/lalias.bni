package "pkg/lalias"

import v "locv"

type P struct {
	x int
}

func (p P) Add(a int, b int) int

func (p P) Mul(a int, b int) int

// locv is P here: this package names its import of locv v.
type locv = P

func Run() int

func RunGen() int

// Gen takes P's Add through locv in a generic body, which is emitted in each
// package that instantiates it: here (RunGen) and in main.
func Gen[T any](t T) int {
	var g *func(P, int, int) int = locv.Add
	return g(P{x: 20}, 3, 4) + v.Add(0, 0)
}
