package "main"

import "pkg/builtins/testing"

type P struct {
	x int
}

func (p P) Get() int { return p.x }

func (p *P) Inc() { p.x = p.x + 1 }

type C int

func (c C) Twice() int { return cast(int, c) * 2 }

type Box[T any] struct {
	v T
}

func (b Box[T]) Get() T { return b.v }

type BI = Box[int]

// A method expression is a function value (spec func.method-expr), also where
// no function-value slot gives it a type to be lowered against: present takes
// any function value.
func main() {
	testing.Println(present(P.Get))
	testing.Println(present(P.Inc))
	testing.Println(present(C.Twice))
	testing.Println(present(Box[int].Get))
	testing.Println(present(BI.Get))
}
