package "main"

import "pkg/a"
import "pkg/builtins/reflect"
import "pkg/builtins/testing"
import "pkg/fwd"
import "pkg/m"

// Every package has a `__Package` accessor, also one this package reaches only
// through a generic body -- pkg/b, through pkg/a's generics -- and one with no
// declarations: pkg/fwd only exposes pkg/c.  A bare `__Package` in pkg/b's
// generic function, in a closure in one and in its generic impl method names
// pkg/b's, as `b.__Package` in pkg/a's generic does; and in a method of pkg/d's
// generic type, which this package reaches only through pkg/m's non-generic
// Make, pkg/d's, whose function another method calls.
func main() {
	testing.Println(a.A[int](1)) // pkg/b
	testing.Println(a.AC[int](2)) // pkg/b
	testing.Println(a.AN[int](3)) // pkg/b
	testing.Println(a.AQ[int](4)) // pkg/b
	testing.Println(fwd.__Package().Name) // pkg/fwd
	testing.Println(_func_handle(fwd.__Package) != nil) // true
	var f *func() @reflect.Package = fwd.__Package
	testing.Println(f().Name) // pkg/fwd
	testing.Println(fwd.C()) // 7
	testing.Println(m.Make().Nm()) // pkg/d
	testing.Println(m.Make().H()) // 42
}
