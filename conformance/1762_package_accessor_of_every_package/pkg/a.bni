package "pkg/a"

import "pkg/b"

// A returns what pkg/b's B does.
func A[T any](x T) *[]readonly char { return b.B[T](x) }

// AC returns what pkg/b's BC does.
func AC[T any](x T) *[]readonly char { return b.BC[T](x) }

// AN returns what pkg/b's Gb[T] does as a Namer.
func AN[T any](x T) *[]readonly char {
	var g @b.Gb[T] = make(b.Gb[T])
	var n @b.Namer = g
	return n.Nm()
}

// AQ returns pkg/b's name, from its accessor.
func AQ[T any](x T) *[]readonly char { return b.__Package().Name }
