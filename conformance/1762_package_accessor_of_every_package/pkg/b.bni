package "pkg/b"

// B returns the name of the package its body is written in.
func B[T any](x T) *[]readonly char { return __Package().Name }

// BC returns it through a closure.
func BC[T any](x T) *[]readonly char {
	var f @func() *[]readonly char = func() *[]readonly char { return __Package().Name }
	return f()
}

// Namer names something.
interface Namer {
	Nm() *[]readonly char
}

type Gb[T any] struct { v T }

// Nm returns the name of the package its body is written in.
func (g *Gb[T]) Nm() *[]readonly char { return __Package().Name }

impl *Gb[T] : Namer
