package "main"

import "pkg/builtins/testing"
import "pkg/lib"

// A bare `__Package` names the accessor of the package whose code it is in: in
// pkg/lib's generic function and generic method, instantiated here, pkg/lib's,
// not this package's.
func main() {
	testing.Println(lib.Name[int](1)) // pkg/lib
	var b lib.Box[int]
	testing.Println(b.Pkg()) // pkg/lib
	testing.Println(__Package().Name) // main
}
