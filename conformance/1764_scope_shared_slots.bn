package "main"

import "pkg/builtins/testing"

// A block's local starts as its declaration says each time the declaration runs,
// whatever was in its bytes: the backends may give locals whose blocks are never
// live at once the same bytes.  Each case writes a local, leaves its block, and checks
// that the next local -- in a sibling block, on the next iteration, after a loop left
// by `continue` and `break`, written by a call returning in memory -- starts as
// declared, and that a deferred block reads its block's local before the block ends.

type Quad struct {
	a int
	b int
	c int
	d int
}

type Big struct {
	n   int
	arr [32]int
}

func mk(k int) Big {
	var b Big
	b.n = k
	b.arr[31] = k * 2
	return b
}

func sumQuad(q *Quad) int { return q.a + q.b + q.c + q.d }

// The second block's local starts zeroed after the first wrote its bytes.
func siblings() int {
	var t int
	{
		var x Quad
		x.a = 1
		x.b = 2
		x.c = 3
		x.d = 4
		t = sumQuad(&x)
	}
	{
		var y Quad
		t = t * 100 + sumQuad(&y)
	}
	return t
}

// A loop body's local starts zeroed on every iteration; a local after the loop too.
func loop() int {
	var t int
	for i := 0; i < 3; i++ {
		var x Quad
		t = t + sumQuad(&x)
		x.a = i + 1
		x.d = 10
		t = t + sumQuad(&x)
	}
	var y [4]int
	return t * 10 + y[0] + y[3]
}

// A local after a loop left by continue and break starts zeroed.
func breakContinue() int {
	var t int
	for i := 0; i < 5; i++ {
		var x Quad
		x.b = i + 7
		if i == 1 { continue }
		if i == 3 { break }
		t = t + x.b
	}
	var y Quad
	return t * 10 + sumQuad(&y)
}

// A struct a call writes straight into a block's local, between sibling locals.
func placed(k int) int {
	var t int
	{
		var q Quad
		q.a = 5
		t = sumQuad(&q)
	}
	{
		var b Big = mk(k)
		t = t + b.n + b.arr[31] + b.arr[0]
	}
	{
		var z Big
		t = t + z.n + z.arr[31]
	}
	return t
}

// The deferred block reads x as the function leaves, before x's storage ends.
func deferredInto(out *int) {
	var x Quad
	x.c = 9
	defer { *out = *out + x.c }
	x.c = 11
}

func deferred() int {
	var t int
	deferredInto(&t)
	{
		var y Quad
		t = t * 100 + sumQuad(&y)
	}
	return t
}

func main() {
	testing.Println(siblings())
	testing.Println(loop())
	testing.Println(breakContinue())
	testing.Println(placed(3))
	testing.Println(deferred())
}
