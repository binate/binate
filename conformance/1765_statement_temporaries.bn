package "main"

import "pkg/builtins/testing"

// A statement's temporaries -- a struct call result whose field is read, an array
// value whose element is read, a by-value argument's copy, an assignment's acquired and
// replaced values, a composite literal passed by value -- end with their statement, so
// the backends may give the next statement's the same bytes.  Each case checks that a
// temporary keeps its value for its whole statement -- in a declaration, an assignment,
// an `if`, `for` and `switch` header (a loop left by `break` and `continue` too), a
// short-circuit operand, a `return` of a scalar or a struct, with and without a deferred
// block, a function literal's body, a deferred block in a loop -- and that a literal a
// `var` keeps the address of lives as long as the `var`.

type P struct {
	a int
	b int
	c int
	d int
}

type M struct {
	name @[]char
	n    int
}

type Inner struct {
	x int
	y int
}

type Outer struct {
	inner Inner
	tag   int
}

type Rec struct {
	m M
}

func mkOuter(k int) Outer {
	var o Outer
	o.inner.x = k
	o.inner.y = k + 1
	o.tag = k * 10
	return o
}

func mkArr(k int) [4]int {
	var a [4]int
	for i := 0; i < 4; i++ { a[i] = k + i }
	return a
}

func mk(k int) P {
	var p P
	p.a = k
	p.b = k * 2
	p.c = k * 3
	p.d = k * 4
	return p
}

func mkM(n int) M {
	var m M
	m.name = make_slice(char, n)
	m.n = n
	return m
}

func sumP(p P) int { return p.a + p.b + p.c + p.d }

func sumPtr(p *P) int { return p.a + p.b + p.c + p.d }

func lenM(m M) int { return len(m.name) + m.n }

// Field reads of call results in sibling statements and in each kind of header.
func fields() int {
	var t int = mk(1).b
	t = t * 10 + mk(2).d
	if mk(3).c == 9 { t = t + 100 }
	for i := 0; mk(i).a < 3; i++ { t = t + mk(i).b }
	switch mk(2).b {
	case 4:
		t = t + 1000
	default:
		t = t + 1
	}
	if mk(1).a == 1 && mk(2).b == 4 { t = t + 10000 }
	return t
}

// By-value arguments with references, copied for the call.
func args() int {
	var t int
	for i := 1; i <= 3; i++ {
		t = t + lenM(mkM(i))
	}
	var m M = mkM(4)
	t = t * 10 + lenM(m) + lenM(m)
	return t
}

// Assignments that replace values with references.
func assigns() int {
	var m M = mkM(1)
	m = mkM(2)
	m = mkM(m.n + 1)
	var arr @[]M = make_slice(M, 2)
	arr[0] = m
	arr[1] = mkM(5)
	arr[0] = arr[1]
	return m.n * 100 + arr[0].n * 10 + arr[1].n
}

// Literals passed by value end with their statement; one a `var` keeps the address
// of lives as long as the `var`.
func literals() int {
	var t int = sumP(P{a: 1, b: 2})
	t = t + sumP(P{c: 3, d: 4})
	var p *P = &P{a: 5, b: 6}
	t = t * 100 + sumPtr(p)
	var q P = P{d: 7}
	t = t + sumP(P{a: 1}) + sumPtr(p) + q.d
	return t
}

// Element reads of array values, a field read through a dereference, and a struct
// switch tag read from a call result.
func values() int {
	var t int = mkArr(1)[2]
	t = t * 10 + mkArr(5)[3]
	var p *P = &P{a: 1, b: 2}
	t = t * 10 + (*p).b
	var want Inner = Inner{x: 2, y: 3}
	switch mkOuter(2).inner {
	case want:
		t = t * 10 + 1
	default:
		t = t * 10 + 9
	}
	return t
}

// A loop whose condition has temporaries, left by `continue` and `break`.
func loopExits() int {
	var t int
	for i := 0; mkArr(i)[0] < 10; i++ {
		if i == 2 { continue }
		if mkOuter(i).tag == 50 { break }
		t = t + mkArr(i)[1]
	}
	return t
}

// Stores replacing a struct with references in a field, in a loop.
func fieldStores() int {
	var r @Rec = make(Rec)
	for i := 1; i <= 3; i++ { r.m = mkM(i) }
	return r.m.n * 10 + len(r.m.name)
}

// Temporaries in a function literal's body and in a deferred block run on each
// iteration of a loop.
func nested(out *int) int {
	f := func(k int) int { return mkOuter(k).inner.y + mk(k).b }
	var t int
	for i := 0; i < 3; i++ {
		defer { *out = *out * 10 + mkOuter(i).inner.x + mkArr(i)[0] }
		t = t + f(i)
	}
	return t
}

// A struct returned from a temporary, with and without a deferred block.
func innerOf(k int) Inner { return mkOuter(k).inner }

func innerDeferred(k int, out *int) Inner {
	defer { *out = mkOuter(k).tag + mkArr(k)[1] }
	return mkOuter(k + 1).inner
}

// A return's temporaries, read as the function returns through a deferred block
// with temporaries of its own.
func retDeferred(out *int) int {
	defer {
		var y P = mk(5)
		*out = y.a + mk(1).b
	}
	return mk(2).c + mk(3).d
}

func main() {
	testing.Println(fields())
	testing.Println(args())
	testing.Println(assigns())
	testing.Println(literals())
	var o int
	var r int = retDeferred(&o)
	testing.Println(r * 100 + o)
	testing.Println(values())
	testing.Println(loopExits())
	testing.Println(fieldStores())
	var n int
	testing.Println(nested(&n) * 1000 + n)
	var ia Inner = innerOf(4)
	var d int
	var ib Inner = innerDeferred(6, &d)
	testing.Println(ia.x * 1000 + ia.y * 100 + ib.x * 10 + ib.y)
	testing.Println(d)
}
