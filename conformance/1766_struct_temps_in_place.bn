package "main"

import "pkg/builtins/testing"

// A struct temporary with references is destroyed in the slot that holds it -- a
// discarded result, a result whose field or element is read, a result passed by value
// -- and a call can write its result straight into that slot.  Each case checks the
// values the callee and the caller see, and that the references are still there to
// read after the releases: in a declaration, an assignment, a short-circuit operand, a
// loop's condition, a switch's tag, and a `return` that runs a deferred block.  A local
// built from a call takes the result in its slot too, in a loop as well, and a callee
// that replaces its by-value copy's references leaves the caller's intact.

type M struct {
	name @[]char
	n    int
}

type Rec struct {
	m M
}

type Outer struct {
	rec Rec
	k   int
}

func mkM(n int) M {
	var m M
	m.name = make_slice(char, n)
	for i := 0; i < n; i++ { m.name[i] = cast(char, 97 + i) }
	m.n = n
	return m
}

func mkMs(n int) [2]M {
	var a [2]M
	a[0] = mkM(n)
	a[1] = mkM(n + 1)
	return a
}

func pass(m M) M { return m }

func mkOuter(n int) Outer {
	var o Outer
	o.rec.m = mkM(n)
	o.k = n * 10
	return o
}

// change replaces its by-value copy's references and count.
func change(m M) int {
	m.name = mkM(1).name
	m.n = 99
	return lenM(m)
}

func lenM(m M) int { return len(m.name) * 10 + m.n }

// bump changes the count of the M it is given.
func bump(p *M) int {
	p.n = p.n + 100
	return 1
}

func both(m M, k int) int { return lenM(m) * 10 + k }

// clearThen releases the caller's references to r.m, then reads its own copy.
func clearThen(m M, r @Rec) int {
	r.m = mkM(1)
	return lenM(m) * 1000 + cast(int, m.name[0])
}

// headers reads temporaries' fields in a short-circuit operand, a loop's condition and
// a switch's tag.
func headers(ok bool) int {
	var t int
	if ok && mkM(3).n == 3 { t = t + 1 }
	for i := 0; mkM(i).n < 3; i++ { t = t + 10 }
	switch mkMs(4)[1].n {
	case 5:
		t = t + 100
	default:
		t = t + 900
	}
	return t
}

// retHome returns temporaries' fields through a deferred block with temporaries of its
// own.
func retHome(out *int) int {
	defer { *out = mkM(2).n + mkMs(6)[0].n }
	return mkM(5).n + pass(mkM(1)).n
}

func main() {
	var v M = mkM(3)
	testing.Println(lenM(v))
	testing.Println(both(v, bump(&v)))
	testing.Println(v.n)
	var r @Rec = make(Rec)
	r.m = mkM(5)
	testing.Println(clearThen(r.m, r))
	testing.Println(lenM(r.m))
	var t int
	for i := 1; i <= 4; i++ {
		pass(mkM(i))
		_ = pass(mkM(i + 1))
		t = t + mkM(i).n + pass(mkM(i)).n + mkMs(i)[1].n
	}
	testing.Println(t)
	testing.Println(cast(int, pass(mkM(4)).name[3]))
	testing.Println(headers(true))
	var o int
	var rv int = retHome(&o)
	testing.Println(rv * 100 + o)
	var w M = mkM(4)
	testing.Println(change(w) * 1000 + lenM(w))
	var u int
	for i := 1; i <= 3; i++ {
		var x M = mkM(i)
		y := mkM(i + 1)
		u = u + lenM(x) + len(y.name) + mkOuter(i).rec.m.n
	}
	testing.Println(u)
}
