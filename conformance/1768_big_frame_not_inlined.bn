package "main"

import "pkg/builtins/testing"

// A call never made of a function with a 1 GiB local does not cost its caller the
// frame: the function is not inlined into the caller (whose frame would then hold the
// local, paid on every entry), so main, which never makes the call, runs.  The local is
// read at a variable index, so no optimizer folds it away.

var run bool

var k int

func use(p *([0x40000000]uint8)) int { return cast(int, (*p)[k]) }

func big() int {
	var a [0x40000000]uint8
	return use(&a)
}

func main() {
	if run { testing.Println(big()) }
	testing.Println("ok")
}
