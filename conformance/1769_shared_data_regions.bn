package "main"

import "pkg/builtins/testing"

// Aggregate call results in use at once keep their own stack bytes, and ones whose uses
// do not meet may share.  Every result is read after the others are made: the arguments
// of one call (each made while the earlier ones wait), a result made before a loop of
// others (in a call the optimizer may inline) and read after it, results made and read
// one after another, a result passed on while the call writes its own, results with
// references (released after the others are made), and arrays.

type Quad struct {
	a int
	b int
	c int
	d int
}

type M struct {
	name @[]char
	n    int
}

func mk(i int) Quad { return Quad{a: i, b: i * 2, c: i * 3, d: i * 4} }

func add(x Quad, y Quad) Quad {
	return Quad{a: x.a + y.a, b: x.b + y.b, c: x.c + y.c, d: x.d + y.d}
}

func sum(q Quad) int { return q.a + q.b + q.c + q.d }

func show(w Quad, x Quad, y Quad, z Quad) {
	testing.Println(sum(w))
	testing.Println(sum(x))
	testing.Println(sum(y))
	testing.Println(sum(z))
}

func loopSum(n int) int {
	var t int = 0
	for i := 0; i < n; i++ { t = t + sum(add(mk(i), mk(i + 1))) }
	return t
}

func held(q Quad, n int) int { return sum(q) * 1000 + n }

func twice(q Quad) Quad { return add(q, q) }

func mkM(n int) M {
	var m M
	m.name = make_slice(char, n)
	for i := 0; i < n; i++ { m.name[i] = cast(char, 97 + i) }
	m.n = n
	return m
}

func code(m M) int { return m.n * 10 + cast(int, m.name[len(m.name) - 1]) - 97 }

func pairM(x M, y M) int { return code(x) * 100 + code(y) }

func row(k int) [8]int {
	var r [8]int
	for i := 0; i < 8; i++ { r[i] = k + i }
	return r
}

func dot(x [8]int, y [8]int) int {
	var t int = 0
	for i := 0; i < 8; i++ { t = t + x[i] * y[i] }
	return t
}

func main() {
	show(mk(1), add(mk(2), mk(3)), mk(4), add(add(mk(5), mk(6)), mk(7)))
	testing.Println(held(mk(9), loopSum(5)))
	var t int = 0
	for i := 1; i <= 4; i++ { t = t + sum(mk(i)) }
	t = t + sum(mk(10)) + sum(mk(20))
	testing.Println(t)
	testing.Println(sum(twice(twice(mk(3)))))
	testing.Println(pairM(mkM(2), mkM(4)))
	testing.Println(code(mkM(3)) * 100 + code(mkM(5)))
	testing.Println(dot(row(1), row(2)))
	testing.Println(dot(row(0), row(1)) + dot(row(2), row(3)))
}
