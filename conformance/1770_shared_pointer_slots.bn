package "main"

import "pkg/builtins/testing"

// Aggregate values whose slots hold the address of bytes elsewhere -- a member of a call
// result, an element read through a managed-slice, a raw view of a managed-slice, a
// string literal, a zero-size value, a result written into a local's slot -- made and
// used one after another, so that their slots can share bytes, with scalars between
// them.  Each value is read after the next one is made where the order allows.

type Quad struct {
	a int
	b int
	c int
	d int
}

type Outer struct {
	q Quad
	r Quad
	n int
}

type Empty struct {}

func mkOuter(i int) Outer {
	var o Outer
	o.q = Quad{a: i, b: i + 1, c: i + 2, d: i + 3}
	o.r = Quad{a: 10 * i, b: 0, c: 0, d: 1}
	o.n = i
	return o
}

func sumQ(q Quad) int { return q.a + q.b + q.c + q.d }

func sumRaw(s *[]int) int {
	var t int = 0
	for i := 0; i < len(s); i++ { t = t + s[i] }
	return t
}

func lenStr(s *[]readonly char) int { return len(s) }

func empty() Empty {
	var e Empty
	return e
}

func takeEmpty(e Empty) int { return 7 }

func twoQ(x Quad, y Quad) int { return sumQ(x) * 100 + sumQ(y) }

func main() {
	var t int = 0
	t = t + sumQ(mkOuter(1).q)
	t = t + sumQ(mkOuter(2).r)
	testing.Println(t)
	testing.Println(twoQ(mkOuter(3).q, mkOuter(4).r))
	var ms @[]int = make_slice(int, 4)
	for i := 0; i < 4; i++ { ms[i] = i + 1 }
	testing.Println(sumRaw(ms) + sumRaw(ms[1:3]))
	testing.Println(lenStr("abc") + lenStr("de"))
	var arr @[]Quad = make_slice(Quad, 3)
	for i := 0; i < 3; i++ { arr[i] = Quad{a: i, b: 0, c: 0, d: 2 * i} }
	var u int = 0
	for i := 0; i < 3; i++ { u = u + arr[i].a + arr[i].d }
	testing.Println(u)
	testing.Println(takeEmpty(empty()) + takeEmpty(empty()))
	var o Outer = mkOuter(5)
	testing.Println(o.n + mkOuter(6).n)
}
