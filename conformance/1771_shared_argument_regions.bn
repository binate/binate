package "main"

import "pkg/builtins/testing"

// By-value structs over 16 bytes passed to calls -- on AAPCS64 as a pointer to a copy
// the callee may write -- after call results made and dropped, so that the copies can
// share bytes with them.  Each callee writes its copy before it reads it, and a value
// passed twice, to one call or to two, must stay as it was.

type Big struct {
	a int
	b int
	c int
	d int
	e int
}

func mk(i int) Big { return Big{a: i, b: i + 1, c: i + 2, d: i + 3, e: i + 4} }

func sumB(x Big) int { return x.a + x.b + x.c + x.d + x.e }

// scribble writes its copy, then reads it.
func scribble(x Big) int {
	x.a = x.a * 100
	x.e = 0
	return sumB(x)
}

// both writes its first copy and reads both.
func both(x Big, y Big) int {
	x.a = 1000
	return sumB(x) * 1000 + sumB(y)
}

func main() {
	testing.Println(sumB(mk(1)) + sumB(mk(2)))
	var v Big = mk(3)
	testing.Println(scribble(v))
	testing.Println(scribble(v))
	testing.Println(both(v, v))
	testing.Println(sumB(v))
	var t int = 0
	for i := 0; i < 3; i++ {
		var w Big = mk(10 * i)
		t = t + both(w, mk(i)) + scribble(w)
	}
	testing.Println(t)
}
