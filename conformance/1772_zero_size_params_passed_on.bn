package "main"

import "pkg/builtins/testing"

// A zero-size parameter (`struct {}`, `[0]int`) is a value with no bytes: a function can
// pass it on to another call -- directly, through a function value or from a closure
// that captures it -- keep it in a local and return it, and take one after a full
// register file on every target, and the arguments around it keep their values.

type E struct {}

func last(e E, n int) int {
	return n
}

// forward passes its zero-size parameter on to another call.
func forward(e E, n int) int {
	return last(e, n + 1)
}

// keep stores its zero-size parameter into a local and returns it.
func keep(e E, n int) E {
	var l E = e
	return l
}

// late takes its zero-size parameters after eight ints, past every target's argument
// registers.
func late(a int, b int, c int, d int, e int, f int, g int, h int, z E, y int, w [0]int, x int) int {
	var l E = keep(z, y)
	return forward(l, y) + x + h
}

func lastArr(w [0]int, n int) int {
	return n
}

// through passes its zero-size parameters on through a function value, from a closure
// that captures one, and directly.
func through(e E, w [0]int, n int) int {
	var fv *func(E, int) int = last
	var c @func(int) int = func(k int) int { return last(e, k) }
	return fv(e, n) + 10 * c(n + 1) + 100 * lastArr(w, n + 2)
}

func main() {
	var e E
	testing.Println(forward(e, 1))
	var k E = keep(e, 2)
	testing.Println(last(k, 3))
	var w [0]int
	testing.Println(late(1, 2, 3, 4, 5, 6, 7, 8, e, 40, w, 100))
	testing.Println(through(e, w, 1))
}
