package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Test: returning make(T) — fresh allocation returned directly.
// make creates rc=1. Return transfers that ref to caller. rc=1.

type Node struct {
	Val int
}

func fresh() @Node {
	return make(Node)
}

func main() {
	var n @Node = fresh()
	n.Val = 77
	var ptr *uint8 = bit_cast(*uint8, n)
	testing.Println(n.Val)
	testing.Print("rc=")
	testing.Println(rt.Refcount(ptr))
}
