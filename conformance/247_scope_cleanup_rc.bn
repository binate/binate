package "main"

import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Test: @T locals declared in for-body sub-scopes must be cleaned up
// when the scope exits. Without cleanup, the inner @Node's refcount
// leaks (grows by 1 per iteration instead of staying stable).

type Node struct {
	Val  int
	Next @Node
}

func makeNode(val int, next @Node) @Node {
	var n @Node = make(Node)
	n.Val = val
	n.Next = next
	return n
}

func useNode(n @Node) int {
	return n.Val
}

func main() {
	var base @Node = makeNode(1, nil)
	var ptr *uint8 = bit_cast(*uint8, base)
	testing.Print("initial rc=")
	testing.Println(rt.Refcount(ptr))

	for i := 0; i < 5; i++ {
		var tmp @Node = makeNode(i + 10, base)
		useNode(tmp)
	}

	testing.Print("after loop rc=")
	testing.Println(rt.Refcount(ptr))
	testing.Println(base.Val)
}
