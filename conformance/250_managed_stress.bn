package "main"

// Managed stress test: all allocations hang off a single root.
// Clearing the root should free everything (no cycles).
// Build up gradually to find which pattern triggers the crash.

// --- Level 0: leaf types ---

type Leaf struct {
	Val int
}

// --- Level 1: struct with managed fields ---

type Branch struct {
	Left  @Leaf
	Right @Leaf
	Tag   @[]char
}

// --- Level 2: struct with managed-slice of structs ---

type Tree struct {
	Branches @[]Branch
	Name     @[]char
}

// --- Root: single managed pointer that owns everything ---

type Root struct {
	Trees @[]Tree
	Count int
}

func makeLeaf(v int) @Leaf {
	var l @Leaf = make(Leaf)
	l.Val = v
	return l
}

func makeBranch(a int, b int, tag *[]char) Branch {
	var br Branch
	br.Left = makeLeaf(a)
	br.Right = makeLeaf(b)
	br.Tag = make_slice(char, len(tag))
	for i := 0; i < len(tag); i++ {
		br.Tag[i] = tag[i]
	}
	return br
}

func makeTree(name *[]char, n int) Tree {
	var t Tree
	t.Name = make_slice(char, len(name))
	for i := 0; i < len(name); i++ {
		t.Name[i] = name[i]
	}
	t.Branches = make_slice(Branch, n)
	for i := 0; i < n; i++ {
		t.Branches[i] = makeBranch(i * 10, i * 10 + 1, name)
	}
	return t
}

func makeRoot(ntrees int, nbranches int) @Root {
	var r @Root = make(Root)
	r.Trees = make_slice(Tree, ntrees)
	r.Count = ntrees
	for i := 0; i < ntrees; i++ {
		var name @[]char = make_slice(char, 5)
		name[0] = 't'
		name[1] = 'r'
		name[2] = 'e'
		name[3] = 'e'
		name[4] = cast(char, cast(int, '0') + i)
		r.Trees[i] = makeTree(name, nbranches)
	}
	return r
}

func verify(r @Root) {
	for i := 0; i < r.Count; i++ {
		var t Tree = r.Trees[i]
		for j := 0; j < len(t.Branches); j++ {
			var br Branch = t.Branches[j]
			if br.Left.Val != j * 10 {
				println("FAIL: wrong Left.Val")
				return
			}
			if br.Right.Val != j * 10 + 1 {
				println("FAIL: wrong Right.Val")
				return
			}
		}
	}
}

func main() {
	// Phase 1: build, verify, tear down
	var root @Root = makeRoot(3, 4)
	verify(root)

	// Phase 2: overwrite root (should free old tree)
	root = makeRoot(2, 3)
	verify(root)

	// Phase 3: clear root (should free everything)
	root = nil

	println("PASS")
}
