package "main"

import "pkg/builtins/testing"

// Managed stress test level 2: value-type structs with managed fields
// stored in a managed object, repeatedly overwritten.
// Mimics the Parser.tok / Parser.prev pattern from the lexer.

type Token struct {
	Typ int
	Lit @[]char
}

type Holder struct {
	Prev    Token
	Current Token
	Count   int
}

func copyStr(s *[]readonly char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func makeToken(typ int, lit *[]readonly char) Token {
	var t Token
	t.Typ = typ
	t.Lit = copyStr(lit)
	return t
}

func advance(h @Holder, typ int, lit *[]readonly char) {
	h.Prev = h.Current
	h.Current = makeToken(typ, lit)
	h.Count = h.Count + 1
}

func main() {
	var h @Holder = make(Holder)
	h.Current = makeToken(0, "start")

	advance(h, 1, "package")
	advance(h, 2, "\"test\"")
	advance(h, 3, "var")
	advance(h, 4, "x")
	advance(h, 5, "int")
	advance(h, 6, "=")
	advance(h, 7, "5")

	// Verify current and prev
	if h.Count != 7 {
		testing.Print("FAIL: count=")
		testing.Println(h.Count)
		return
	}
	if h.Current.Typ != 7 {
		testing.Print("FAIL: current typ=")
		testing.Println(h.Current.Typ)
		return
	}
	if h.Prev.Typ != 6 {
		testing.Print("FAIL: prev typ=")
		testing.Println(h.Prev.Typ)
		return
	}

	// Verify Lit contents
	if len(h.Current.Lit) != 1 {
		testing.Print("FAIL: current lit len=")
		testing.Println(len(h.Current.Lit))
		return
	}
	if h.Current.Lit[0] != '5' {
		testing.Println("FAIL: current lit content")
		return
	}
	if len(h.Prev.Lit) != 1 {
		testing.Print("FAIL: prev lit len=")
		testing.Println(len(h.Prev.Lit))
		return
	}
	if h.Prev.Lit[0] != '=' {
		testing.Println("FAIL: prev lit content")
		return
	}

	// Tear down
	h = nil

	testing.Println("PASS")
}
