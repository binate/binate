package "main"

// Managed stress test level 3: deep nesting with cross-function returns.
// Structs returned from functions, stored in locals, then written to
// managed object fields. Multiple levels of managed-slice-of-struct
// with managed fields.

type Pos struct {
	File int
	Line int
	Col  int
}

type Token struct {
	Typ int
	Lit @[]char
	Pos Pos
}

type Node struct {
	Kind     int
	Name     @[]char
	Children @[]Node
	Tok      Token
}

type State struct {
	Nodes   @[]Node
	Current Token
	Prev    Token
	Depth   int
}

func copyStr(s *[]const char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func makeToken(typ int, lit *[]const char, line int) Token {
	var t Token
	t.Typ = typ
	t.Lit = copyStr(lit)
	t.Pos.File = 1
	t.Pos.Line = line
	t.Pos.Col = 0
	return t
}

func makeNode(kind int, name *[]const char, tok Token) Node {
	var n Node
	n.Kind = kind
	n.Name = copyStr(name)
	n.Tok = tok
	return n
}

func addChild(parent Node, child Node) Node {
	var old @[]Node = parent.Children
	var n int = len(old)
	var newKids @[]Node = make_slice(Node, n + 1)
	for i := 0; i < n; i++ {
		newKids[i] = old[i]
	}
	newKids[n] = child
	parent.Children = newKids
	return parent
}

func buildTree(depth int) Node {
	var tok Token = makeToken(depth, "node", depth)
	var n Node = makeNode(depth, "n", tok)
	if depth > 0 {
		var left Node = buildTree(depth - 1)
		var right Node = buildTree(depth - 1)
		n = addChild(n, left)
		n = addChild(n, right)
	}
	return n
}

func countNodes(n Node) int {
	var c int = 1
	for i := 0; i < len(n.Children); i++ {
		c = c + countNodes(n.Children[i])
	}
	return c
}

func advance(s @State, typ int, lit *[]const char) {
	s.Prev = s.Current
	s.Current = makeToken(typ, lit, s.Depth)
	s.Depth = s.Depth + 1
}

func appendNode(s @State, n Node) {
	var old @[]Node = s.Nodes
	var count int = len(old)
	var newNodes @[]Node = make_slice(Node, count + 1)
	for i := 0; i < count; i++ {
		newNodes[i] = old[i]
	}
	newNodes[count] = n
	s.Nodes = newNodes
}

func main() {
	var s @State = make(State)
	s.Nodes = make_slice(Node, 0)
	s.Current = makeToken(0, "init", 0)

	// Simulate parsing: advance tokens and build nodes
	for i := 0; i < 10; i++ {
		advance(s, i + 1, "tok")
		var tree Node = buildTree(3)
		appendNode(s, tree)
	}

	// Verify
	if len(s.Nodes) != 10 {
		print("FAIL: node count=")
		println(len(s.Nodes))
		return
	}

	// Each tree of depth 3 has 1+2+4+8=15 nodes
	for i := 0; i < len(s.Nodes); i++ {
		var c int = countNodes(s.Nodes[i])
		if c != 15 {
			print("FAIL: tree ")
			print(i)
			print(" node count=")
			println(c)
			return
		}
	}

	if s.Current.Typ != 10 {
		print("FAIL: current typ=")
		println(s.Current.Typ)
		return
	}
	if s.Prev.Typ != 9 {
		print("FAIL: prev typ=")
		println(s.Prev.Typ)
		return
	}

	// Overwrite state (frees old trees)
	s.Nodes = make_slice(Node, 0)
	for i := 0; i < 5; i++ {
		advance(s, i + 20, "new")
		var tree Node = buildTree(2)
		appendNode(s, tree)
	}

	if len(s.Nodes) != 5 {
		print("FAIL: second node count=")
		println(len(s.Nodes))
		return
	}

	// Tear down
	s = nil

	println("PASS")
}
