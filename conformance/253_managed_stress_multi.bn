package "main"

// Managed stress test level 4: simulated lexer/parser pattern.
// A Lexer scans bytes into Tokens, a Parser holds prev/current Token
// and builds an AST of Nodes — all with managed fields.
// Many more iterations than previous tests.

type Token struct {
	Typ int
	Lit @[]char
	Pos int
}

type Node struct {
	Kind     int
	Name     @[]char
	Children @[]Node
	Tok      Token
}

type Lexer struct {
	Src @[]uint8
	Pos int
}

type Parser struct {
	Lex     @Lexer
	Tok     Token
	Prev    Token
	Nodes   @[]Node
	Count   int
}

func copyStr(s *[]const char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func makeToken(typ int, lit *[]const char, pos int) Token {
	var t Token
	t.Typ = typ
	t.Lit = copyStr(lit)
	t.Pos = pos
	return t
}

func newLexer(src *[]const char) @Lexer {
	var l @Lexer = make(Lexer)
	l.Src = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		l.Src[i] = cast(uint8, src[i])
	}
	l.Pos = 0
	return l
}

// Simplified lexer: each "token" is a single byte, type = byte value.
// EOF when pos >= len.
func lexNext(l @Lexer) Token {
	if l.Pos >= len(l.Src) {
		return makeToken(0, "EOF", l.Pos)
	}
	var ch uint8 = l.Src[l.Pos]
	var lit @[]char = make_slice(char, 1)
	lit[0] = cast(char, ch)
	var t Token = makeToken(cast(int, ch), lit, l.Pos)
	l.Pos = l.Pos + 1
	return t
}

func newParser(src *[]const char) @Parser {
	var p @Parser = make(Parser)
	p.Lex = newLexer(src)
	p.Nodes = make_slice(Node, 0)
	p.Count = 0
	// Initial advance
	p.Tok = lexNext(p.Lex)
	return p
}

func advance(p @Parser) {
	p.Prev = p.Tok
	p.Tok = lexNext(p.Lex)
	p.Count = p.Count + 1
}

func addNode(p @Parser, n Node) {
	var old @[]Node = p.Nodes
	var count int = len(old)
	var newNodes @[]Node = make_slice(Node, count + 1)
	for i := 0; i < count; i++ {
		newNodes[i] = old[i]
	}
	newNodes[count] = n
	p.Nodes = newNodes
}

func makeNodeFromToken(tok Token) Node {
	var n Node
	n.Kind = tok.Typ
	n.Name = copyStr(tok.Lit)
	n.Tok = tok
	return n
}

func parse(src *[]const char) @Parser {
	var p @Parser = newParser(src)
	for p.Tok.Typ != 0 {
		var n Node = makeNodeFromToken(p.Tok)
		addNode(p, n)
		advance(p)
	}
	return p
}

func main() {
	// Parse several strings of increasing length
	var p1 @Parser = parse("hello")
	if len(p1.Nodes) != 5 {
		print("FAIL: p1 nodes=")
		println(len(p1.Nodes))
		return
	}
	if p1.Nodes[0].Tok.Lit[0] != 'h' {
		println("FAIL: p1 first node lit")
		return
	}

	var p2 @Parser = parse("the quick brown fox jumps over the lazy dog")
	if len(p2.Nodes) != 43 {
		print("FAIL: p2 nodes=")
		println(len(p2.Nodes))
		return
	}

	// Repeated parsing to stress allocator
	for round := 0; round < 20; round++ {
		var p @Parser = parse("stress test round with many tokens and allocations!!")
		if len(p.Nodes) != 52 {
			print("FAIL: round ")
			print(round)
			print(" nodes=")
			println(len(p.Nodes))
			return
		}
	}

	// Build nodes with children (deeper nesting)
	var p3 @Parser = parse("abc")
	if len(p3.Nodes) != 3 {
		print("FAIL: p3 nodes=")
		println(len(p3.Nodes))
		return
	}
	// Manually nest: give node 0 children
	var child1 Node = makeNodeFromToken(makeToken(99, "child1", 0))
	var child2 Node = makeNodeFromToken(makeToken(98, "child2", 0))
	var parent Node = p3.Nodes[0]
	parent.Children = make_slice(Node, 2)
	parent.Children[0] = child1
	parent.Children[1] = child2
	p3.Nodes[0] = parent

	if len(p3.Nodes[0].Children) != 2 {
		println("FAIL: p3 children count")
		return
	}

	// Tear down all parsers
	p1 = nil
	p2 = nil
	p3 = nil

	println("PASS")
}
