package "main"

// Managed stress test level 5: symbol table with scopes.
// Mimics the interpreter's Env pattern: managed-slices of entries
// with managed fields, nested scopes, push/pop.

type Symbol struct {
	Name  @[]char
	Value int
	Typ   @[]char
}

type Scope struct {
	Parent  @Scope
	Symbols @[]Symbol
}

type Env struct {
	Current @Scope
	Depth   int
}

func copyStr(s *[]const char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func newScope(parent @Scope) @Scope {
	var s @Scope = make(Scope)
	s.Parent = parent
	s.Symbols = make_slice(Symbol, 0)
	return s
}

func newEnv() @Env {
	var e @Env = make(Env)
	e.Current = newScope(nil)
	e.Depth = 0
	return e
}

func pushScope(e @Env) {
	e.Current = newScope(e.Current)
	e.Depth = e.Depth + 1
}

func popScope(e @Env) {
	if e.Current.Parent != nil {
		e.Current = e.Current.Parent
		e.Depth = e.Depth - 1
	}
}

func define(scope @Scope, name *[]const char, value int, typ *[]const char) {
	var sym Symbol
	sym.Name = copyStr(name)
	sym.Value = value
	sym.Typ = copyStr(typ)

	// Append to symbols (grow slice)
	var old @[]Symbol = scope.Symbols
	var n int = len(old)
	var news @[]Symbol = make_slice(Symbol, n + 1)
	for i := 0; i < n; i++ {
		news[i] = old[i]
	}
	news[n] = sym
	scope.Symbols = news
}

func streq(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func lookup(scope @Scope, name *[]const char) int {
	if scope == nil { return -1 }
	for i := 0; i < len(scope.Symbols); i++ {
		if streq(scope.Symbols[i].Name, name) {
			return scope.Symbols[i].Value
		}
	}
	return lookup(scope.Parent, name)
}

func main() {
	var e @Env = newEnv()

	// Define some globals
	define(e.Current, "x", 10, "int")
	define(e.Current, "y", 20, "int")
	define(e.Current, "name", 42, "string")

	// Push scope, shadow x
	pushScope(e)
	define(e.Current, "x", 99, "int")
	define(e.Current, "z", 30, "int")

	if lookup(e.Current, "x") != 99 {
		println("FAIL: shadowed x")
		return
	}
	if lookup(e.Current, "y") != 20 {
		println("FAIL: inherited y")
		return
	}
	if lookup(e.Current, "z") != 30 {
		println("FAIL: local z")
		return
	}

	// Push another scope
	pushScope(e)
	define(e.Current, "a", 1, "int")
	define(e.Current, "b", 2, "int")
	define(e.Current, "c", 3, "int")

	if lookup(e.Current, "a") != 1 {
		println("FAIL: nested a")
		return
	}
	if lookup(e.Current, "x") != 99 {
		println("FAIL: nested x through two scopes")
		return
	}

	// Pop back
	popScope(e)
	if lookup(e.Current, "a") != -1 {
		println("FAIL: a should be gone after pop")
		return
	}
	if lookup(e.Current, "x") != 99 {
		println("FAIL: x after pop")
		return
	}

	popScope(e)
	if lookup(e.Current, "x") != 10 {
		println("FAIL: x after second pop should be original")
		return
	}

	// Stress: many push/pop cycles with many symbols
	for round := 0; round < 50; round++ {
		pushScope(e)
		for i := 0; i < 20; i++ {
			var nm @[]char = make_slice(char, 3)
			nm[0] = 'v'
			nm[1] = cast(char, cast(int, '0') + round / 10)
			nm[2] = cast(char, cast(int, '0') + i)
			define(e.Current, nm, round * 100 + i, "int")
		}
		// Verify last symbol
		var check @[]char = make_slice(char, 3)
		check[0] = 'v'
		check[1] = cast(char, cast(int, '0') + round / 10)
		check[2] = cast(char, cast(int, '0') + 19)
		var val int = lookup(e.Current, check)
		if val != round * 100 + 19 {
			print("FAIL: round ")
			print(round)
			print(" expected ")
			print(round * 100 + 19)
			print(" got ")
			println(val)
			return
		}
		popScope(e)
	}

	// Verify globals still intact
	if lookup(e.Current, "x") != 10 {
		println("FAIL: x after stress")
		return
	}
	if lookup(e.Current, "name") != 42 {
		println("FAIL: name after stress")
		return
	}

	// Tear down
	e = nil

	println("PASS")
}
