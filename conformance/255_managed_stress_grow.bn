package "main"

// Managed stress test level 6: growing @[]@T slices.
// The critical pattern from the parser: a managed-slice of
// managed-pointers, grown by repeated append operations.
// When the slice backing is reallocated, all @T elements
// must be correctly RefInc'd in the new backing and RefDec'd
// in the old.

type Item struct {
	Name @[]char
	Data @[]int
	ID   int
}

type Collection struct {
	Items @[]@Item
	Count int
}

func copyStr(s *[]const char) @[]char {
	var r @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		r[i] = s[i]
	}
	return r
}

func makeItem(id int, name *[]const char, size int) @Item {
	var it @Item = make(Item)
	it.ID = id
	it.Name = copyStr(name)
	it.Data = make_slice(int, size)
	for i := 0; i < size; i++ {
		it.Data[i] = id * 1000 + i
	}
	return it
}

func appendItem(c @Collection, it @Item) {
	var old @[]@Item = c.Items
	var n int = len(old)
	var newItems @[]@Item = make_slice(@Item, n + 1)
	for i := 0; i < n; i++ {
		newItems[i] = old[i]
	}
	newItems[n] = it
	c.Items = newItems
	c.Count = c.Count + 1
}

func verify(c @Collection) bool {
	if len(c.Items) != c.Count {
		print("FAIL: items len=")
		print(len(c.Items))
		print(" count=")
		println(c.Count)
		return false
	}
	for i := 0; i < c.Count; i++ {
		var it @Item = c.Items[i]
		if it.ID != i {
			print("FAIL: item ")
			print(i)
			print(" ID=")
			println(it.ID)
			return false
		}
		if len(it.Name) < 1 {
			print("FAIL: item ")
			print(i)
			println(" empty name")
			return false
		}
		if len(it.Data) != i + 1 {
			print("FAIL: item ")
			print(i)
			print(" data len=")
			println(len(it.Data))
			return false
		}
		if it.Data[0] != i * 1000 {
			print("FAIL: item ")
			print(i)
			print(" data[0]=")
			println(it.Data[0])
			return false
		}
	}
	return true
}

func main() {
	var c @Collection = make(Collection)
	c.Items = make_slice(@Item, 0)
	c.Count = 0

	// Add 100 items (100 reallocations of the @[]@Item backing)
	for i := 0; i < 100; i++ {
		var it @Item = makeItem(i, "item", i + 1)
		appendItem(c, it)
	}

	if !verify(c) { return }

	// Hold references to some items, then overwrite collection
	var saved0 @Item = c.Items[0]
	var saved50 @Item = c.Items[50]
	var saved99 @Item = c.Items[99]

	// Overwrite collection — old backing freed, but saved refs should survive
	c.Items = make_slice(@Item, 0)
	c.Count = 0

	// Verify saved references still work
	if saved0.ID != 0 {
		print("FAIL: saved0 ID=")
		println(saved0.ID)
		return
	}
	if saved50.ID != 50 {
		print("FAIL: saved50 ID=")
		println(saved50.ID)
		return
	}
	if saved99.Data[0] != 99000 {
		print("FAIL: saved99 data=")
		println(saved99.Data[0])
		return
	}

	// Second round of growing
	for i := 0; i < 50; i++ {
		var it @Item = makeItem(i, "round2", i + 1)
		appendItem(c, it)
	}

	if !verify(c) { return }

	// Clear everything
	saved0 = nil
	saved50 = nil
	saved99 = nil
	c = nil

	println("PASS")
}
