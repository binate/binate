package "main"

import "pkg/lexer"
import "pkg/token"
import "pkg/parser"
import "pkg/ast"

// Stress test: use the real lexer and parser to parse source strings.
// This is the exact pattern that crashes in boot-comp-int unit tests.

func toBytes(src []char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		r[i] = cast(uint8, src[i])
	}
	return r
}

func parseSrc(src []char) @ast.File {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	return parser.ParseFile(p)
}

func main() {
	var f @ast.File = parseSrc("package \"test\"\nvar x int = 5\n")
	if f == nil {
		println("FAIL: nil file")
		return
	}
	if len(f.Decls) != 1 {
		print("FAIL: expected 1 decl, got ")
		println(len(f.Decls))
		return
	}
	if f.Decls[0].Kind != ast.DECL_VAR {
		println("FAIL: expected DECL_VAR")
		return
	}

	// Parse a more complex file
	var f2 @ast.File = parseSrc("package \"test\"\nfunc add(a int, b int) int { return a + b }\nvar y int = 42\n")
	if len(f2.Decls) != 2 {
		print("FAIL: expected 2 decls, got ")
		println(len(f2.Decls))
		return
	}

	// Repeated parsing to stress allocator
	for round := 0; round < 10; round++ {
		var fr @ast.File = parseSrc("package \"test\"\nvar a int = 1\nvar b int = 2\nvar c int = 3\n")
		if len(fr.Decls) != 3 {
			print("FAIL: round ")
			print(round)
			print(" expected 3 decls, got ")
			println(len(fr.Decls))
			return
		}
	}

	println("PASS")
}
