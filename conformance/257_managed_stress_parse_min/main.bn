package "main"

import "pkg/lexer"
import "pkg/token"

// Minimal repro attempt: just tokenize, no parsing.

func toBytes(src []char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		r[i] = cast(uint8, src[i])
	}
	return r
}

func main() {
	var srcBytes @[]uint8 = toBytes("package \"test\"\nvar x int = 5\n")
	var l @lexer.Lexer = lexer.New(srcBytes, "test.bn")
	var count int = 0
	for {
		var tok token.Token = lexer.Next(l)
		count = count + 1
		if tok.Typ == token.EOF {
			println(count)
			return
		}
		if count > 100 {
			println("FAIL: too many tokens")
			return
		}
	}
}
