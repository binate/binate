package "main"

import "pkg/lexer"
import "pkg/token"

// Just one lexer.Next call — does this crash?

func toBytes(src []char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		r[i] = cast(uint8, src[i])
	}
	return r
}

func main() {
	var srcBytes @[]uint8 = toBytes("hello")
	var l @lexer.Lexer = lexer.New(srcBytes, "test.bn")
	var tok token.Token = lexer.Next(l)
	println(tok.Typ)
	println("PASS")
}
