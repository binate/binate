package "main"

// Self-contained repro attempt: use a growing buffer (like CharBuf)
// to build token literals, mimicking buf.CopyStr/buf.Bytes.

type Token struct {
	Typ int
	Lit @[]char
}

type Buf struct {
	Data @[]char
	Len  int
}

func newBuf() @Buf {
	var b @Buf = make(Buf)
	b.Data = make_slice(char, 16)
	b.Len = 0
	return b
}

func bufWrite(b @Buf, ch char) {
	if b.Len >= len(b.Data) {
		// Grow
		var newCap int = len(b.Data) * 2
		var newData @[]char = make_slice(char, newCap)
		for i := 0; i < b.Len; i++ {
			newData[i] = b.Data[i]
		}
		b.Data = newData
	}
	b.Data[b.Len] = ch
	b.Len = b.Len + 1
}

func bufBytes(b @Buf) @[]char {
	var r @[]char = make_slice(char, b.Len)
	for i := 0; i < b.Len; i++ {
		r[i] = b.Data[i]
	}
	return r
}

func bufCopyStr(s []char) @[]char {
	var b @Buf = newBuf()
	for i := 0; i < len(s); i++ {
		bufWrite(b, s[i])
	}
	return bufBytes(b)
}

type Lexer struct {
	Src  @[]uint8
	File @[]char
	Pos  int
	Ch   int
}

func newLexer(src []char, file []char) @Lexer {
	var l @Lexer = make(Lexer)
	var msrc @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		msrc[i] = cast(uint8, src[i])
	}
	l.Src = msrc
	l.File = bufCopyStr(file)
	l.Pos = 0
	if len(src) > 0 {
		l.Ch = cast(int, src[0])
	} else {
		l.Ch = -1
	}
	return l
}

func advance(l @Lexer) {
	l.Pos = l.Pos + 1
	if l.Pos < len(l.Src) {
		l.Ch = cast(int, l.Src[l.Pos])
	} else {
		l.Ch = -1
	}
}

func isLetter(ch int) bool {
	return (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90)
}

func isDigit(ch int) bool {
	return ch >= 48 && ch <= 57
}

func isSpace(ch int) bool {
	return ch == 32 || ch == 9 || ch == 10 || ch == 13
}

func scanIdent(l @Lexer) @[]char {
	var b @Buf = newBuf()
	for isLetter(l.Ch) || isDigit(l.Ch) {
		bufWrite(b, cast(char, l.Ch))
		advance(l)
	}
	return bufBytes(b)
}

func scanNumber(l @Lexer) @[]char {
	var b @Buf = newBuf()
	for isDigit(l.Ch) {
		bufWrite(b, cast(char, l.Ch))
		advance(l)
	}
	return bufBytes(b)
}

func lexNext(l @Lexer) Token {
	for isSpace(l.Ch) {
		advance(l)
	}

	var t Token
	if l.Ch == -1 {
		t.Typ = 0
		t.Lit = bufCopyStr("EOF")
		return t
	}

	if isLetter(l.Ch) {
		t.Lit = scanIdent(l)
		t.Typ = 1
		return t
	}

	if isDigit(l.Ch) {
		t.Lit = scanNumber(l)
		t.Typ = 2
		return t
	}

	// Single char
	var b @Buf = newBuf()
	bufWrite(b, cast(char, l.Ch))
	t.Lit = bufBytes(b)
	t.Typ = cast(int, l.Ch)
	advance(l)
	return t
}

func main() {
	var l @Lexer = newLexer("var x = 42 + y", "test.bn")
	for i := 0; i < 8; i++ {
		var tok Token = lexNext(l)
		print(tok.Typ)
		print(" ")
		println(len(tok.Lit))
	}
	println("DONE")
}
