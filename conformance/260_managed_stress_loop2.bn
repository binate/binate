package "main"

// Minimal builder-comp-int crash repro:
// Assigning a @[]char subslice to a value-struct field segfaults.
// Without the struct (bare subslice variable), it works fine.

type S struct {
	Lit @[]char
}

func main() {
	var data @[]char = make_slice(char, 64)
	data[0] = 'h'
	var s S
	s.Lit = data[0:1]
	println(len(s.Lit))
}
