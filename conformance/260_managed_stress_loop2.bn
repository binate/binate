package "main"

// Self-contained copy of pkg/token + pkg/buf + pkg/lexer inlined
// into one file. No external deps. Used to reproduce the
// boot-comp-int crash in a conformance test.

// ============================================================
// token types (from pkg/token.bni)
// ============================================================

const (
	TOK_ILLEGAL int = iota
	TOK_EOF
	TOK_SEMICOLON
	TOK_IDENT
	TOK_INT
	TOK_STRING
	TOK_CHAR
	TOK_keyword_start
	TOK_BREAK
	TOK_CASE
	TOK_CONST
	TOK_CONTINUE
	TOK_DEFAULT
	TOK_ELSE
	TOK_FALSE
	TOK_FOR
	TOK_FUNC
	TOK_IF
	TOK_IMPL
	TOK_IMPORT
	TOK_IN
	TOK_INTERFACE
	TOK_NIL
	TOK_PACKAGE
	TOK_RETURN
	TOK_STRUCT
	TOK_SWITCH
	TOK_TRUE
	TOK_TYPE
	TOK_VAR
	TOK_keyword_end
	TOK_builtin_start
	TOK_MAKE
	TOK_MAKE_SLICE
	TOK_BOX
	TOK_CAST
	TOK_BIT_CAST
	TOK_LEN
	TOK_UNSAFE_INDEX
	TOK_builtin_end
	TOK_PLUS
	TOK_MINUS
	TOK_STAR
	TOK_SLASH
	TOK_PERCENT
	TOK_AMP
	TOK_PIPE
	TOK_CARET
	TOK_TILDE
	TOK_SHL
	TOK_SHR
	TOK_EQ
	TOK_NEQ
	TOK_LT
	TOK_GT
	TOK_LEQ
	TOK_GEQ
	TOK_LAND
	TOK_LOR
	TOK_NOT
	TOK_ASSIGN
	TOK_DEFINE
	TOK_ADD_ASSIGN
	TOK_SUB_ASSIGN
	TOK_MUL_ASSIGN
	TOK_QUO_ASSIGN
	TOK_REM_ASSIGN
	TOK_AND_ASSIGN
	TOK_OR_ASSIGN
	TOK_XOR_ASSIGN
	TOK_SHL_ASSIGN
	TOK_SHR_ASSIGN
	TOK_INC
	TOK_DEC
	TOK_DOT
	TOK_COMMA
	TOK_COLON
	TOK_AT
	TOK_HASH
	TOK_LPAREN
	TOK_RPAREN
	TOK_LBRACKET
	TOK_RBRACKET
	TOK_LBRACE
	TOK_RBRACE
	TOK_ELLIPSIS
)

// ============================================================
// Pos and Token (from pkg/token.bni)
// ============================================================

type Pos struct {
	File @[]char
	Line int
	Col  int
}

type Token struct {
	Typ int
	Lit @[]char
	Pos Pos
}

// ============================================================
// token helpers (from pkg/token/token.bn)
// ============================================================

func streq(a []char, b []char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func triggersASI(t int) bool {
	if t == TOK_IDENT { return true }
	if t == TOK_INT { return true }
	if t == TOK_STRING { return true }
	if t == TOK_CHAR { return true }
	if t == TOK_TRUE { return true }
	if t == TOK_FALSE { return true }
	if t == TOK_NIL { return true }
	if t == TOK_BREAK { return true }
	if t == TOK_CONTINUE { return true }
	if t == TOK_RETURN { return true }
	if t == TOK_INC { return true }
	if t == TOK_DEC { return true }
	if t == TOK_RPAREN { return true }
	if t == TOK_RBRACKET { return true }
	if t == TOK_RBRACE { return true }
	return false
}

func tokTypeName(t int) []char {
	if t == TOK_BREAK { return "break" }
	if t == TOK_CASE { return "case" }
	if t == TOK_CONST { return "const" }
	if t == TOK_CONTINUE { return "continue" }
	if t == TOK_DEFAULT { return "default" }
	if t == TOK_ELSE { return "else" }
	if t == TOK_FALSE { return "false" }
	if t == TOK_FOR { return "for" }
	if t == TOK_FUNC { return "func" }
	if t == TOK_IF { return "if" }
	if t == TOK_IMPL { return "impl" }
	if t == TOK_IMPORT { return "import" }
	if t == TOK_IN { return "in" }
	if t == TOK_INTERFACE { return "interface" }
	if t == TOK_NIL { return "nil" }
	if t == TOK_PACKAGE { return "package" }
	if t == TOK_RETURN { return "return" }
	if t == TOK_STRUCT { return "struct" }
	if t == TOK_SWITCH { return "switch" }
	if t == TOK_TRUE { return "true" }
	if t == TOK_TYPE { return "type" }
	if t == TOK_VAR { return "var" }
	if t == TOK_MAKE { return "make" }
	if t == TOK_MAKE_SLICE { return "make_slice" }
	if t == TOK_BOX { return "box" }
	if t == TOK_CAST { return "cast" }
	if t == TOK_BIT_CAST { return "bit_cast" }
	if t == TOK_LEN { return "len" }
	if t == TOK_UNSAFE_INDEX { return "unsafe_index" }
	return ""
}

func tokLookup(name []char) int {
	var t int = TOK_keyword_start + 1
	for t < TOK_keyword_end {
		var tn []char = tokTypeName(t)
		if len(tn) > 0 && streq(name, tn) { return t }
		t = t + 1
	}
	t = TOK_builtin_start + 1
	for t < TOK_builtin_end {
		var tn []char = tokTypeName(t)
		if len(tn) > 0 && streq(name, tn) { return t }
		t = t + 1
	}
	return TOK_IDENT
}

// ============================================================
// CharBuf (from pkg/buf)
// ============================================================

type CharBuf struct {
	Data @[]char
	Len  int
}

func bufNew() CharBuf {
	var b CharBuf
	b.Data = make_slice(char, 64)
	b.Len = 0
	return b
}

func bufGrow(b CharBuf, needed int) CharBuf {
	var cap int = len(b.Data)
	if b.Len + needed <= cap { return b }
	var newCap int = cap
	if newCap == 0 { newCap = 64 }
	for newCap < b.Len + needed { newCap = newCap * 2 }
	var newData @[]char = make_slice(char, newCap)
	for i := 0; i < b.Len; i++ { newData[i] = b.Data[i] }
	b.Data = newData
	return b
}

func bufWriteByte(b CharBuf, c char) CharBuf {
	b = bufGrow(b, 1)
	b.Data[b.Len] = c
	b.Len = b.Len + 1
	return b
}

func bufBytes(b CharBuf) @[]char {
	if b.Len < len(b.Data) { return b.Data[0:b.Len] }
	return b.Data
}

func copyStr(s []char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ { result[i] = s[i] }
	return result
}

// ============================================================
// Lexer (from pkg/lexer)
// ============================================================

type Lexer struct {
	src     @[]uint8
	file    @[]char
	pos     int
	readPos int
	ch      uint8
	line    int
	lineAt  int
	lastTok int
	hasPending bool
	pendingTok Token
	pendingSawNewline bool
}

func lexNew(src []uint8, file []char) @Lexer {
	var l @Lexer = make(Lexer)
	var msrc @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ { msrc[i] = src[i] }
	l.src = msrc
	l.file = copyStr(file)
	l.line = 1
	l.lineAt = 0
	l.hasPending = false
	lexAdvance(l)
	return l
}

func lexAdvance(l @Lexer) {
	if l.readPos >= len(l.src) { l.ch = 0 } else { l.ch = l.src[l.readPos] }
	l.pos = l.readPos
	l.readPos = l.readPos + 1
}

func lexPeek(l @Lexer) uint8 {
	if l.readPos >= len(l.src) { return 0 }
	return l.src[l.readPos]
}

func lexCol(l @Lexer) int { return l.pos - l.lineAt + 1 }

func lexCurPos(l @Lexer) Pos {
	var p Pos
	p.File = l.file
	p.Line = l.line
	p.Col = lexCol(l)
	return p
}

func lexNewline(l @Lexer) {
	l.line = l.line + 1
	l.lineAt = l.readPos
}

func sliceToChars(src []uint8, start int, end int) @[]char {
	var cb CharBuf = bufNew()
	for i := start; i < end; i++ { cb = bufWriteByte(cb, cast(char, src[i])) }
	return bufBytes(cb)
}

func isLetter(ch uint8) bool {
	if ch >= 'a' && ch <= 'z' { return true }
	if ch >= 'A' && ch <= 'Z' { return true }
	if ch == '_' { return true }
	return false
}

func isDigit(ch uint8) bool { return ch >= '0' && ch <= '9' }

func skipWhitespace(l @Lexer) bool {
	var sawNL bool = false
	for {
		if l.ch == ' ' || l.ch == '\t' || l.ch == '\r' {
			lexAdvance(l)
		} else if l.ch == '\n' {
			lexNewline(l)
			lexAdvance(l)
			sawNL = true
		} else {
			return sawNL
		}
	}
	return sawNL
}

func scanIdent(l @Lexer) @[]char {
	var start int = l.pos
	for isLetter(l.ch) || isDigit(l.ch) { lexAdvance(l) }
	return sliceToChars(l.src, start, l.pos)
}

func scanNumber(l @Lexer, typ *int) @[]char {
	var start int = l.pos
	for isDigit(l.ch) { lexAdvance(l) }
	*typ = TOK_INT
	return sliceToChars(l.src, start, l.pos)
}

func scanString(l @Lexer) @[]char {
	var start int = l.pos
	lexAdvance(l)
	for l.ch != 0 && l.ch != '"' {
		if l.ch == '\\' { lexAdvance(l) }
		lexAdvance(l)
	}
	if l.ch == '"' { lexAdvance(l) }
	return sliceToChars(l.src, start, l.pos)
}

func lexScan(l @Lexer, sawNewline *bool) Token {
	*sawNewline = skipWhitespace(l)
	var pos Pos = lexCurPos(l)
	var tok Token
	tok.Pos = pos
	var ch uint8 = l.ch

	if ch == 0 { tok.Typ = TOK_EOF; tok.Lit = copyStr(""); return tok }

	if isLetter(ch) {
		var lit @[]char = scanIdent(l)
		tok.Typ = tokLookup(lit)
		tok.Lit = lit
		return tok
	}
	if isDigit(ch) {
		var typ int
		var lit @[]char = scanNumber(l, &typ)
		tok.Typ = typ
		tok.Lit = lit
		return tok
	}
	if ch == '"' { tok.Typ = TOK_STRING; tok.Lit = scanString(l); return tok }

	lexAdvance(l)
	if ch == '+' { tok.Typ = TOK_PLUS; tok.Lit = copyStr("+"); return tok }
	if ch == '-' { tok.Typ = TOK_MINUS; tok.Lit = copyStr("-"); return tok }
	if ch == '*' { tok.Typ = TOK_STAR; tok.Lit = copyStr("*"); return tok }
	if ch == '=' { tok.Typ = TOK_ASSIGN; tok.Lit = copyStr("="); return tok }
	if ch == '(' { tok.Typ = TOK_LPAREN; tok.Lit = copyStr("("); return tok }
	if ch == ')' { tok.Typ = TOK_RPAREN; tok.Lit = copyStr(")"); return tok }
	if ch == '{' { tok.Typ = TOK_LBRACE; tok.Lit = copyStr("{"); return tok }
	if ch == '}' { tok.Typ = TOK_RBRACE; tok.Lit = copyStr("}"); return tok }
	if ch == ',' { tok.Typ = TOK_COMMA; tok.Lit = copyStr(","); return tok }

	tok.Typ = TOK_ILLEGAL
	var cb CharBuf = bufNew()
	cb = bufWriteByte(cb, cast(char, ch))
	tok.Lit = bufBytes(cb)
	return tok
}

func lexNext(l @Lexer) Token {
	if l.hasPending {
		var tok Token
		tok = l.pendingTok
		l.hasPending = false
		l.lastTok = tok.Typ
		return tok
	}
	var sawNL bool
	var tok Token
	sawNL = false
	tok = lexScan(l, &sawNL)
	if tok.Typ != TOK_EOF && triggersASI(l.lastTok) && sawNL {
		l.hasPending = true
		l.pendingTok = tok
		l.pendingSawNewline = sawNL
		var semi Token
		semi.Typ = TOK_SEMICOLON
		semi.Lit = copyStr("\n")
		semi.Pos = tok.Pos
		return semi
	}
	if tok.Typ == TOK_EOF && triggersASI(l.lastTok) {
		l.lastTok = TOK_SEMICOLON
		var semi Token
		semi.Typ = TOK_SEMICOLON
		semi.Lit = copyStr("\n")
		semi.Pos = tok.Pos
		return semi
	}
	if tok.Typ != TOK_SEMICOLON { l.lastTok = tok.Typ }
	return tok
}

// ============================================================
// Test
// ============================================================

func toBytes(src []char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ { r[i] = cast(uint8, src[i]) }
	return r
}

func main() {
	var srcBytes @[]uint8 = toBytes("var x = 42")
	var l @Lexer = lexNew(srcBytes, "test.bn")
	for i := 0; i < 6; i++ {
		var tok Token = lexNext(l)
		print(tok.Typ)
		print(" ")
		println(len(tok.Lit))
	}
	println("DONE")
}
