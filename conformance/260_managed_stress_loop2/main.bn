package "main"

import "pkg/lexer"
import "pkg/token"

// Minimal crash repro: loop of 2 lexer.Next calls.
// Loop of 1 passes. Loop of 2 crashes on cleanup.
// 2 separate var declarations (no loop) also passes.
// The loop body scope cleanup of Token (with @[]char Lit)
// is what triggers the refcount corruption.

func toBytes(src []char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		r[i] = cast(uint8, src[i])
	}
	return r
}

func main() {
	var srcBytes @[]uint8 = toBytes("a b c")
	var l @lexer.Lexer = lexer.New(srcBytes, "test.bn")
	for i := 0; i < 2; i++ {
		var tok token.Token = lexer.Next(l)
		println(tok.Typ)
	}
	println("DONE")
}
