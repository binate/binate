package "main"

import "pkg/types"
import "pkg/parser"
import "pkg/ast"

// Bug: predeclared type singletons (TypInt, TypBool, etc.) are freed
// when a Checker goes out of scope, because the Checker's universe
// scope holds references to them. When the scope is cascade-freed,
// the singletons' refcount drops to 0. The next NewChecker() then
// uses dangling pointers.

func toBytes(src []char) @[]uint8 {
	var r @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		r[i] = cast(uint8, src[i])
	}
	return r
}

func doCheck(src []char) int {
	var srcBytes @[]uint8 = toBytes(src)
	var p @parser.Parser = parser.New(srcBytes, "test.bn")
	var file @ast.File = parser.ParseFile(p)
	var c @types.Checker = types.NewChecker()
	types.Check(c, file)
	var errs @[]types.CheckError = types.CheckerErrors(c)
	return len(errs)
}

func main() {
	var n1 int = doCheck("package \"test\"\nvar x int = 5\n")
	print("check1: ")
	println(n1)

	var n2 int = doCheck("package \"test\"\nvar y bool = 42\n")
	print("check2: ")
	println(n2)

	println("PASS")
}
