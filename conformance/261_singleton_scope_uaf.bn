package "main"

import "pkg/builtins/testing"

// Self-contained repro for singleton UAF: managed-pointer singletons
// stored in a scope, scope freed when container goes out of scope,
// singletons used again after.

type Typ struct {
	Kind int
	Name @[]char
}

type Symbol struct {
	Name @[]char
	Type @Typ
}

type Scope struct {
	Syms @[]@Symbol
}

type Checker struct {
	Scope @Scope
}

// Singletons — package-level vars
var singletonInt @Typ

var singletonBool @Typ

var initialized bool

func ensureInit() {
	if initialized { return }
	initialized = true
	singletonInt = make(Typ)
	singletonInt.Kind = 1
	singletonInt.Name = make_slice(char, 3)
	singletonInt.Name[0] = 'i'
	singletonInt.Name[1] = 'n'
	singletonInt.Name[2] = 't'
	singletonBool = make(Typ)
	singletonBool.Kind = 2
	singletonBool.Name = make_slice(char, 4)
	singletonBool.Name[0] = 'b'
	singletonBool.Name[1] = 'o'
	singletonBool.Name[2] = 'o'
	singletonBool.Name[3] = 'l'
}

func typInt() @Typ { ensureInit(); return singletonInt }

func typBool() @Typ { ensureInit(); return singletonBool }

func makeScope() @Scope {
	var s @Scope = make(Scope)
	s.Syms = make_slice(@Symbol, 2)
	var s0 @Symbol = make(Symbol)
	s0.Name = make_slice(char, 1)
	s0.Name[0] = 'x'
	s0.Type = typInt()
	s.Syms[0] = s0
	var s1 @Symbol = make(Symbol)
	s1.Name = make_slice(char, 1)
	s1.Name[0] = 'y'
	s1.Type = typBool()
	s.Syms[1] = s1
	return s
}

func doCheck() int {
	var c @Checker = make(Checker)
	c.Scope = makeScope()
	// Use the types
	var t @Typ = c.Scope.Syms[0].Type
	return t.Kind
	// c goes out of scope — Checker freed, scope freed,
	// symbols freed, singleton Types RefDec'd
}

func main() {
	var k1 int = doCheck()
	testing.Print("check1: ")
	testing.Println(k1)

	// Second check — singletons must still be alive
	var k2 int = doCheck()
	testing.Print("check2: ")
	testing.Println(k2)

	// Verify singletons directly
	testing.Print("int kind: ")
	testing.Println(typInt().Kind)
	testing.Print("bool kind: ")
	testing.Println(typBool().Kind)

	testing.Println("PASS")
}
