package "main"

// Repro: accessing a @T field through a *Struct parameter.
// This works in standalone programs but the compiler generates
// wrong LLVM IR (i64 instead of i8* for @T field load) when
// compiling pkg/interp with *Value parameters.

type Inner struct {
	Val int
}

type Wrapper struct {
	Kind  int
	Ref   @Inner
	Addr  *uint8
	Flag  bool
	Flag2 bool
}

func hasRef(w *Wrapper) bool {
	if w.Ref != nil {
		return true
	}
	return false
}

func getRef(w *Wrapper) @Inner {
	return w.Ref
}

func main() {
	var w Wrapper
	w.Kind = 1

	// Should be false — Ref is nil
	if hasRef(&w) {
		println("FAIL: nil ref detected as non-nil")
		return
	}

	// Set ref
	w.Ref = make(Inner)
	w.Ref.Val = 42

	// Should be true
	if !hasRef(&w) {
		println("FAIL: non-nil ref not detected")
		return
	}

	// Read through *Wrapper
	var r @Inner = getRef(&w)
	println(r.Val)

	println("PASS")
}
