package "main"
import "pkg/builtins/testing"

import "pkg/mypkg"

func main() {
	var o mypkg.Outer
	o.Kind = 1

	if mypkg.HasTyp(&o) {
		testing.Println("FAIL: nil typ detected as non-nil")
		return
	}

	o.Typ = make(mypkg.Inner)
	o.Typ.Val = 42

	if !mypkg.HasTyp(&o) {
		testing.Println("FAIL: non-nil typ not detected")
		return
	}

	var r @mypkg.Inner = mypkg.GetTyp(&o)
	testing.Println(r.Val)

	testing.Println(mypkg.GetTypVal(&o))

	if mypkg.CheckTyp(&o) {
		testing.Println("check: true")
	} else {
		testing.Println("check: false")
	}

	testing.Println("PASS")
}
