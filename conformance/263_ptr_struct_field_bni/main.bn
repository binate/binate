package "main"

import "pkg/mypkg"

func main() {
	var o mypkg.Outer
	o.Kind = 1

	if mypkg.HasTyp(&o) {
		println("FAIL: nil typ detected as non-nil")
		return
	}

	o.Typ = make(mypkg.Inner)
	o.Typ.Val = 42

	if !mypkg.HasTyp(&o) {
		println("FAIL: non-nil typ not detected")
		return
	}

	var r @mypkg.Inner = mypkg.GetTyp(&o)
	println(r.Val)

	println(mypkg.GetTypVal(&o))

	if mypkg.CheckTyp(&o) {
		println("check: true")
	} else {
		println("check: false")
	}

	println("PASS")
}
