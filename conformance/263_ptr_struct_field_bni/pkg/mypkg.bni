package "pkg/mypkg"

type Inner struct {
	Val int
}

// Many fields, matching Value struct shape more closely
type Outer struct {
	Kind      int
	Typ       @Inner
	Addr      *uint8
	IsFresh   bool
	IsClean   bool
	FuncName  @[]char
	Extra1    @Inner
	Extra2    @[]@Inner
	Extra3    @[]@[]char
}

func HasTyp(o *Outer) bool
func GetTyp(o *Outer) @Inner
func GetTypVal(o *Outer) int
func CheckTyp(o *Outer) bool
