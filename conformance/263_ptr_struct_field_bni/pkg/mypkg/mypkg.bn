package "pkg/mypkg"

func HasTyp(o *Outer) bool {
	if o.Typ != nil {
		return true
	}
	return false
}

func GetTyp(o *Outer) @Inner {
	return o.Typ
}

func GetTypVal(o *Outer) int {
	if o.Typ == nil { return -1 }
	return o.Typ.Val
}

// IsString-like: check Typ != nil then Typ.Elem-like
func CheckTyp(o *Outer) bool {
	if o.Typ != nil && o.Typ.Val > 0 {
		return true
	}
	return false
}
