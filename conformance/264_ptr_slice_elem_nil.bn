package "main"

import "pkg/builtins/testing"

type S struct {
	Val int
}

func checkFirst(items *[]*S) bool {
	if len(items) > 0 && items[0] != nil {
		return true
	}
	return false
}

func main() {
	var items *[]*S
	items = make_slice(*S, 2)
	if checkFirst(items) {
		testing.Println("FAIL: nil should not be detected")
		return
	}

	var s S
	s.Val = 42
	items[0] = &s
	if !checkFirst(items) {
		testing.Println("FAIL: non-nil not detected")
		return
	}

	testing.Println("PASS")
}
