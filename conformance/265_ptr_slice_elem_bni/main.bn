package "main"

import "pkg/mypkg"

func main() {
	var items []*mypkg.Item
	items = make_slice(*mypkg.Item, 2)

	if mypkg.CheckFirst(items) {
		println("FAIL: nil detected as non-nil")
		return
	}

	var it mypkg.Item
	it.Val = 42
	items[0] = &it

	if !mypkg.CheckFirst(items) {
		println("FAIL: non-nil not detected")
		return
	}

	println(mypkg.GetFirstVal(items))
	println("PASS")
}
