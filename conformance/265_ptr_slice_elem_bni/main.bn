package "main"
import "pkg/builtins/testing"

import "pkg/mypkg"

func main() {
	var items *[]*mypkg.Item
	items = make_slice(*mypkg.Item, 2)

	if mypkg.CheckFirst(items) {
		testing.Println("FAIL: nil detected as non-nil")
		return
	}

	var it mypkg.Item
	it.Val = 42
	items[0] = &it

	if !mypkg.CheckFirst(items) {
		testing.Println("FAIL: non-nil not detected")
		return
	}

	testing.Println(mypkg.GetFirstVal(items))
	testing.Println("PASS")
}
