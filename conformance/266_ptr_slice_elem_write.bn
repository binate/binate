package "main"

// Verifies that `items[i] = &localStruct` on a []*T slice stores the
// pointer (the alloca), not the struct's first word. Reads the result
// through an intermediate local variable (var p *Item = items[0];
// p.Val) which uses a different codegen path than items[i].Field, so
// this test isolates the write-side behavior.

type Item struct {
	Val int
}

func main() {
	var items []*Item = make_slice(*Item, 2)
	var it Item
	it.Val = 42
	items[0] = &it

	var p *Item = items[0]
	if p == nil {
		println("FAIL: items[0] is nil")
		return
	}
	println(p.Val)
}
