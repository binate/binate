package "main"

// Verifies that `items[i].Field` on a *[]*T slice reads through the
// raw pointer correctly. Populates items[0] via `&arr[0]` (which
// emits a GEP, not a struct-alloca) so the write bug that causes
// `items[0] = &localStruct` to store the wrong value does not fire
// here. This test isolates the read-side behavior.

type Item struct {
	Val int
}

func main() {
	var items *[]*Item = make_slice(*Item, 2)
	var arr [1]Item
	arr[0].Val = 42
	items[0] = &arr[0]

	if items[0] == nil {
		println("FAIL: items[0] is nil")
		return
	}
	println(items[0].Val)
}
