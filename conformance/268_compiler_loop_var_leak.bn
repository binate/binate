package "main"

// Repro for: var declarations in loop bodies leak native stack
// per iteration, causing stack overflow at ~1M iterations on macOS
// with the default 8MB main thread stack.
//
// See explorations/bugs/compiler-loop-var-stack-leak.md.
//
// The expected behavior: the var local int slot should be reused
// across iterations (allocated once, like LLVM convention of
// hoisting allocas to the entry block).
//
// The same loop without `var local int` (inlining `i * 2`) runs
// to 2M+ iterations without issue.

func main() {
	var sum int = 0
	for i := 0; i < 1000000; i++ {
		var local int = i * 2
		sum = sum + local
	}
	println(sum)
}
