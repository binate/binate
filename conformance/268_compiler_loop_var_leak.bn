package "main"

import "pkg/builtins/testing"

// A var declared in a loop body must not leak native stack per
// iteration: its slot is reused across iterations (allocated once,
// like the LLVM convention of hoisting allocas to the entry block).
// A per-iteration leak overflows the default 8MB macOS main-thread
// stack at ~1M iterations; the same loop without `var local int`
// (inlining `i * 2`) needs no slot at all.

func main() {
	// int64 sum so the expected value (999_999_000_000) is the
	// same on LP64 + ILP32 — the test's purpose is to verify the
	// compiler reuses the loop-body var's stack slot across
	// iterations (otherwise the 1M-iteration count overflows the
	// stack), not to exercise int-width arithmetic.
	var sum int64 = 0
	for i := 0; i < 1000000; i++ {
		var local int64 = cast(int64, i) * 2
		sum = sum + local
	}
	testing.Println(sum)
}
