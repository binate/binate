package "main"

// A local variable declared as `*T` and initialized to `&localStruct`
// must store the pointer (address of the struct), not alias with the
// struct itself. Previously, genDecl unconditionally reused any
// struct-alloca RHS as the new variable's storage, collapsing
// p and it into the same slot — reading `p` then loaded the first
// word of it (Val), not the pointer.

type Item struct {
	Val int
}

func main() {
	var it Item
	it.Val = 42
	var p *Item = &it
	if p == nil {
		println("FAIL: p is nil")
		return
	}
	println(p.Val)
}
