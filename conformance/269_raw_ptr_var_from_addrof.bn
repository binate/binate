package "main"

import "pkg/builtins/testing"

// A local variable declared as `*T` and initialized to `&localStruct`
// must store the pointer (address of the struct), not alias with the
// struct itself. A genDecl that reuses any struct-alloca RHS as the
// new variable's storage collapses p and it into the same slot —
// reading `p` then loads the first word of it (Val), not the pointer.

type Item struct {
	Val int
}

func main() {
	var it Item
	it.Val = 42
	var p *Item = &it
	if p == nil {
		testing.Println("FAIL: p is nil")
		return
	}
	testing.Println(p.Val)
}
