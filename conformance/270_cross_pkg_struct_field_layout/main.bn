package "main"

// Regression test: a struct field whose type is defined in *another*
// package, followed by managed-pointer fields. Before the fix to
// cmd/bni's cross-package struct type resolution, bni resolved
// such field types to a TypInt fallback when registering struct
// names unqualified, so the struct's ALLOC size and dtor field
// offsets disagreed. Assigning the managed-pointer fields and
// then letting cleanup run crashed the VM with a bogus RefDec.

import "pkg/hi"

func main() {
	var root @hi.Node = hi.Make()
	root.Kind = 1
	var child @hi.Node = hi.Make()
	child.Kind = 2
	root.X = child
	root.Y = child
	println(root.X.Kind)
	println(root.Y.Kind)
}
