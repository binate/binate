package "main"
import "pkg/builtins/testing"

// Regression test: a struct field whose type is defined in *another*
// package, followed by managed-pointer fields. If bni's cross-package
// struct type resolution falls back to TypInt for such field types
// (registering struct names unqualified), the struct's ALLOC size and
// dtor field offsets disagree: assigning the managed-pointer fields and
// then letting cleanup run crashes the VM with a bogus RefDec.

import "pkg/hi"

func main() {
	var root @hi.Node = hi.Make()
	root.Kind = 1
	var child @hi.Node = hi.Make()
	child.Kind = 2
	root.X = child
	root.Y = child
	testing.Println(root.X.Kind)
	testing.Println(root.Y.Kind)
}
