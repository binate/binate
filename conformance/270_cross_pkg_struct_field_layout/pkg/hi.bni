package "pkg/hi"

import "pkg/lo"

// Node has a cross-package struct field (Pos) followed by
// managed-pointer fields (X, Y). The cross-package field's size
// must be resolved correctly for X, Y offsets to be consistent
// across all lowering passes.
type Node struct {
	Kind int
	Pos  lo.Pos
	X    @Node
	Y    @Node
}

func Make() @Node
