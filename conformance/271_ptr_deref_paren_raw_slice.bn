package "main"

// Regression test: *(T) should be semantically identical to *T.
// Specifically *(*[]T) (paren-wrapped raw-slice as pointer base) should
// work the same as *[]T (currently pointer-to-slice under old grammar,
// but becoming raw-slice sugar under plan-raw-slice-syntax.md, which is
// why pointer-to-slice has to be written *(*[]T) going forward).

func main() {
	var x *[]const char = "hi"
	var p *(*[]const char) = &x
	println(*p)
}
