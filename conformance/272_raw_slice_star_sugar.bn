package "main"

// *[]T is raw-slice sugar (Stage 1 of plan-raw-slice-syntax.md).
// Same semantics as []T; they produce the same AST / resolved type.

func sum(s *[]int) int {
	var total int = 0
	for i := 0; i < len(s); i++ {
		total = total + s[i]
	}
	return total
}

func main() {
	var arr [3]int
	arr[0] = 10
	arr[1] = 20
	arr[2] = 30
	var s *[]int = arr[:]
	println(sum(s))
}
