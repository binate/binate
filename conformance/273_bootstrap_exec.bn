package "main"

// Tests that bootstrap.Exec can launch a child process and return
// its exit code. Uses /usr/bin/true and /usr/bin/false, which
// exist on macOS and Linux. This is a regression guard for the
// VM's bootstrap.Exec extern (see commit e6b0d00) — without it,
// bni2 fails with `vm: extern not found: bootstrap.Exec`.

import "pkg/bootstrap"

func main() {
	var noArgs @[]@[]char
	var rc int = bootstrap.Exec("/usr/bin/true", noArgs)
	print("true="); println(rc)

	var rc2 int = bootstrap.Exec("/usr/bin/false", noArgs)
	print("false="); println(rc2)
}
