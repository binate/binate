package "main"

// Regression guard: pkg/binate/vm's LowerModule used to overwrite a
// shared vm.Strings slice each time it was called, so BC_LOAD_STR
// instructions in functions from earlier-lowered packages ended
// up indexing into LATER packages' string tables. The symptom was
// `otherpkg.Msg()` returning a string literal from main, not from
// otherpkg. The fix stores a per-VMFunc Strings reference.
//
// Main must have enough string literals that main's string table
// is at least as long as otherpkg's, so an out-of-bounds index
// wouldn't accidentally short-circuit.

import "pkg/otherpkg"

func main() {
	println("main1")
	println("main2")
	println("main3")
	println(otherpkg.Msg())
	println(otherpkg.Greeting())
	println("main4")
}
