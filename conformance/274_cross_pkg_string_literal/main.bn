package "main"
import "pkg/builtins/testing"

// Regression guard: each VMFunc keeps its own Strings reference.  A
// pkg/binate/vm LowerModule that overwrites one shared vm.Strings
// slice on each call makes BC_LOAD_STR instructions in functions from
// earlier-lowered packages index into LATER packages' string tables:
// `otherpkg.Msg()` then returns a string literal from main, not from
// otherpkg.
//
// Main must have enough string literals that main's string table
// is at least as long as otherpkg's, so an out-of-bounds index
// wouldn't accidentally short-circuit.

import "pkg/otherpkg"

func main() {
	testing.Println("main1")
	testing.Println("main2")
	testing.Println("main3")
	testing.Println(otherpkg.Msg())
	testing.Println(otherpkg.Greeting())
	testing.Println("main4")
}
