package "main"

import "pkg/builtins/testing"

// Demonstrates a bni VM bug: assigning to a module-level
// managed-slice global, followed by a for-loop in the same
// function, segfaults. Neither piece alone crashes. The issue is
// suspected to be in how the VM handles per-iteration setup after
// a global managed-slice store.
//
// xfail'd for builder-comp-int. Likely the root cause of the
// remaining pkg/binate/parser, pkg/binate/ir, pkg/binate/codegen, pkg/binate/vm, cmd/bnlint
// SIGSEGVs (those packages all combine a global @[]T with helpers
// that loop).

var gBuf @[]uint8

func setup() {
	gBuf = make_slice(uint8, 5)
	for i := 0; i < 3; i++ {
		gBuf[i] = cast(uint8, 65 + i)
	}
}

func main() {
	setup()
	testing.Print("gBuf[0]=")
	testing.Println(gBuf[0])
	testing.Print("gBuf[1]=")
	testing.Println(gBuf[1])
	testing.Print("gBuf[2]=")
	testing.Println(gBuf[2])
}
