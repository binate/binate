package "main"

import "pkg/builtins/testing"

// Assigning to a module-level managed-slice global, followed by a
// for-loop in the same function that writes through it: the
// combination (each piece alone is simple) must run correctly in
// every mode, including the bytecode VM's per-iteration setup after
// a global managed-slice store.  It is a common shape — packages
// that combine a global @[]T with helpers that loop.

var gBuf @[]uint8

func setup() {
	gBuf = make_slice(uint8, 5)
	for i := 0; i < 3; i++ {
		gBuf[i] = cast(uint8, 65 + i)
	}
}

func main() {
	setup()
	testing.Print("gBuf[0]=")
	testing.Println(gBuf[0])
	testing.Print("gBuf[1]=")
	testing.Println(gBuf[1])
	testing.Print("gBuf[2]=")
	testing.Println(gBuf[2])
}
