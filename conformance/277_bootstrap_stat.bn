package "main"

// Tests that bootstrap.Stat returns 1 for an existing path and 0
// for a missing one. Regression guard for the VM's bootstrap.Stat
// extern (bni2) — it was previously stubbed to always return 0,
// which silently broke tests like pkg/asm/macho TestWriteSimpleObj.

import "pkg/bootstrap"

func main() {
	var existing int = bootstrap.Stat("/usr/bin/true")
	print("exists="); println(existing)

	var missing int = bootstrap.Stat("/nonexistent/path/xyzzy")
	print("missing="); println(missing)
}
