package "main"

import "pkg/builtins/testing"

// Float literal with integer cast for output. Exercises:
//   - lexer scanning `3.14`
//   - parser producing EXPR_FLOAT_LIT
//   - type checker: float64 variable accepts untyped-float literal
//   - IR: OP_CONST_FLOAT
//   - backends: LLVM `fadd 0.0, 3.14` / VM BC_LOAD_IMM with parsed bits
//   - float → int cast

func main() {
	var x float64 = 3.75
	testing.Println(cast(int, x))
}
