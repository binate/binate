package "main"

// Float arithmetic: +, -, *, /. Each result cast to int for output.

func main() {
	var a float64 = 1.5 + 2.5   // 4.0
	var b float64 = 10.0 - 3.5  // 6.5
	var c float64 = 2.5 * 4.0   // 10.0
	var d float64 = 10.0 / 4.0  // 2.5
	println(cast(int, a))
	println(cast(int, b))
	println(cast(int, c))
	println(cast(int, d))
}
