package "main"

// Float comparison: each operator produces a bool; print 1 or 0.

func boolToInt(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	println(boolToInt(1.0 < 2.0))    // 1
	println(boolToInt(2.0 < 1.0))    // 0
	println(boolToInt(1.5 == 1.5))   // 1
	println(boolToInt(1.5 != 1.5))   // 0
	println(boolToInt(3.0 <= 3.0))   // 1
	println(boolToInt(3.0 >= 2.999)) // 1
	println(boolToInt(-1.0 > 0.0))   // 0
}
