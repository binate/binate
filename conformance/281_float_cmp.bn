package "main"

import "pkg/builtins/testing"

// Float comparison: each operator produces a bool; print 1 or 0.

func boolToInt(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	testing.Println(boolToInt(1.0 < 2.0)) // 1
	testing.Println(boolToInt(2.0 < 1.0)) // 0
	testing.Println(boolToInt(1.5 == 1.5)) // 1
	testing.Println(boolToInt(1.5 != 1.5)) // 0
	testing.Println(boolToInt(3.0 <= 3.0)) // 1
	testing.Println(boolToInt(3.0 >= 2.999)) // 1
	testing.Println(boolToInt(-1.0 > 0.0)) // 0
}
