package "main"

import "pkg/builtins/testing"

// Explicit casts between int and float.

func main() {
	var i int = 7
	var f float64 = cast(float64, i)
	var g float64 = f / 2.0 // 3.5
	testing.Println(cast(int, g)) // 3 (truncate toward zero)

	var neg float64 = -4.75
	testing.Println(cast(int, neg)) // -4 (truncate toward zero)

	// Chained round-trip: int → float → int of a whole value.
	var k int = cast(int, cast(float64, 42))
	testing.Println(k) // 42
}
