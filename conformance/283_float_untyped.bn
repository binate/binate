package "main"

// Untyped float literals coerce to float32 and float64 alike.

func main() {
	var a float32 = 3.25
	var b float64 = 3.25

	// Cast both to int and print — they should be equal.
	var ia int = cast(int, a)
	var ib int = cast(int, b)
	println(ia)
	println(ib)

	// An exponent literal fits in either width.
	var big float64 = 1e3
	println(cast(int, big))
}
