package "main"

// println of a float value goes through bootstrap.formatFloat
// (bootstrap-grade fixed-point: integer.6digits, no trailing-zero
// trimming, no scientific notation). For bit-exact verification
// of float arithmetic, use bit_cast (see 330).

func main() {
	println(3.14)        // 3.140000
	println(1.5 + 2.5)   // 4.000000
	println(-7.0)        // -7.000000
	println(0.25)        // 0.250000
	println(1e3)         // 1000.000000
	var x float64 = 0.1 + 0.2
	println(x)           // 0.300000 (truncated; underlying value is ~0.30000000000000004)
	println(1.0 / 3.0)   // 0.333333
}
