package "main"

// println of a float value uses bn_print_float, which formats with
// %g (up to 6 significant digits, trailing zeros dropped).

func main() {
	println(3.14)
	println(1.5 + 2.5)
	println(-7.0)
	println(0.25)
	println(1e3)
	var x float64 = 0.1 + 0.2
	println(x)        // 0.3 (within 6-digit precision)
	println(1.0 / 3.0) // 0.333333
}
