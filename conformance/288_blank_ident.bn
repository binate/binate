package "main"

// Blank identifier `_`: the value is evaluated for side effects but
// discarded. Valid on the LHS of an assignment, as a var-decl name,
// or as a position in a short-var-decl or multi-assign.

func sideEffect() int {
	println("call")
	return 42
}

func pair() (int, int) {
	return 100, 200
}

func main() {
	// 1. Assign to blank — RHS runs for side effects.
	_ = sideEffect()

	// 2. var _ T = expr.
	var _ int = sideEffect()

	// 3. var _ = expr (inferred type).
	var _ = sideEffect()

	// 4. Short var decl: discard first result, keep second.
	_, y := pair()
	println(y)

	// 5. Multi-assign: discard first, update second.
	var z int = 0
	_, z = pair()
	println(z)
}
