package "main"

import "pkg/builtins/testing"

// `panic(...)` is a terminator: a non-void function may end in a
// panic call without an explicit trailing return.

func mustPositive(x int) int {
	if x > 0 { return x }
	panic("mustPositive: non-positive value")
}

func main() {
	testing.Println(mustPositive(5))
	testing.Println(mustPositive(17))
}
