package "main"

import "pkg/builtins/testing"

// sizeof(T) and alignof(T): compile-time type-size and alignment
// queries. Both return `uint`.

type Point struct {
	X int
	Y int
}

func main() {
	// Integers: Width / 8.
	testing.Println(cast(int, sizeof(int))) // 8
	testing.Println(cast(int, sizeof(int8))) // 1
	testing.Println(cast(int, sizeof(int16))) // 2
	testing.Println(cast(int, sizeof(int32))) // 4
	testing.Println(cast(int, sizeof(int64))) // 8

	// Float.
	testing.Println(cast(int, sizeof(float32))) // 4
	testing.Println(cast(int, sizeof(float64))) // 8

	// Bool.
	testing.Println(cast(int, sizeof(bool))) // 1

	// Struct: size of the representation (sum of aligned field sizes).
	testing.Println(cast(int, sizeof(Point))) // 16 (two int64 fields)

	// Slice headers: 2 words raw, 4 words managed (on a 64-bit target).
	testing.Println(cast(int, sizeof(*[]int))) // 16
	testing.Println(cast(int, sizeof(@[]int))) // 32

	// Array: element count times element size.
	testing.Println(cast(int, sizeof([4]int32))) // 16

	// Alignment.
	testing.Println(cast(int, alignof(int8))) // 1
	testing.Println(cast(int, alignof(int32))) // 4
	testing.Println(cast(int, alignof(int64))) // 8
	testing.Println(cast(int, alignof(bool))) // 1
	testing.Println(cast(int, alignof(float64))) // 8
	testing.Println(cast(int, alignof(Point))) // 8 (widest field alignment)
}
