package "main"

// sizeof(T) and alignof(T): compile-time type-size and alignment
// queries. Both return `uint`.

type Point struct {
	X int
	Y int
}

func main() {
	// Integers: Width / 8.
	println(cast(int, sizeof(int)))      // 8
	println(cast(int, sizeof(int8)))     // 1
	println(cast(int, sizeof(int16)))    // 2
	println(cast(int, sizeof(int32)))    // 4
	println(cast(int, sizeof(int64)))    // 8

	// Float.
	println(cast(int, sizeof(float32)))  // 4
	println(cast(int, sizeof(float64)))  // 8

	// Bool.
	println(cast(int, sizeof(bool)))     // 1

	// Struct: size of the representation (sum of aligned field sizes).
	println(cast(int, sizeof(Point)))    // 16 (two int64 fields)

	// Slice headers: 2 words raw, 4 words managed (on a 64-bit target).
	println(cast(int, sizeof(*[]int)))   // 16
	println(cast(int, sizeof(@[]int)))   // 32

	// Array: element count times element size.
	println(cast(int, sizeof([4]int32))) // 16

	// Alignment.
	println(cast(int, alignof(int8)))    // 1
	println(cast(int, alignof(int32)))   // 4
	println(cast(int, alignof(int64)))   // 8
	println(cast(int, alignof(bool)))    // 1
	println(cast(int, alignof(float64))) // 8
	println(cast(int, alignof(Point)))   // 8 (widest field alignment)
}
