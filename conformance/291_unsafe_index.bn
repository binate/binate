package "main"

// unsafe_index(coll, idx) — same as `coll[idx]` but documents that
// the caller is bypassing bounds checking. (Bounds checks aren't yet
// emitted in the normal index path either, so the two produce
// identical code today; that'll change when bounds-check wiring
// lands. See claude-todo.md.)

func main() {
	// Array.
	var a [4]int
	a[0] = 10
	a[1] = 20
	a[2] = 30
	a[3] = 40
	println(unsafe_index(a, 0))
	println(unsafe_index(a, 3))

	// Raw slice (from array view).
	var s *[]int = a[:]
	println(unsafe_index(s, 2))

	// Managed slice.
	var m @[]int = make_slice(int, 3)
	m[0] = 100
	m[1] = 200
	m[2] = 300
	println(unsafe_index(m, 1))

	// Pointer to element.
	var p *int = &a[0]
	println(unsafe_index(p, 2))  // same as a[2] = 30
}
