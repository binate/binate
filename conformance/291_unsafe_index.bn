package "main"

import "pkg/builtins/testing"

// unsafe_index(coll, idx) — same as `coll[idx]` but skips the bounds
// check that `coll[idx]` emits. With valid indices the two produce
// the same observable behavior; with out-of-range indices, only
// `coll[idx]` traps.

func main() {
	// Array.
	var a [4]int
	a[0] = 10
	a[1] = 20
	a[2] = 30
	a[3] = 40
	testing.Println(unsafe_index(a, 0))
	testing.Println(unsafe_index(a, 3))

	// Raw slice (from array view).
	var s *[]int = a[:]
	testing.Println(unsafe_index(s, 2))

	// Managed slice.
	var m @[]int = make_slice(int, 3)
	m[0] = 100
	m[1] = 200
	m[2] = 300
	testing.Println(unsafe_index(m, 1))

	// Pointer to element.
	var p *int = &a[0]
	testing.Println(unsafe_index(p, 2)) // same as a[2] = 30
}
