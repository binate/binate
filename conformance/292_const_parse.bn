package "main"

import "pkg/builtins/testing"

// The readonly type modifier's surface forms: `readonly Type` parses,
// resolves, type-checks, and runs on a primitive, a pointer to readonly,
// a readonly pointer, raw and managed slices of readonly, and a readonly
// struct.  The assignability rules are covered by 293.

func readInt(p *readonly int) int {
	return *p
}

type Point struct {
	X int
	Y int
}

func main() {
	// readonly on a primitive.
	var x readonly int = 42

	// *readonly int: pointer to readonly int.
	var p *readonly int = &x
	testing.Println(readInt(p))

	// readonly *int: readonly pointer (pointer itself is readonly, pointee
	// is mutable). Initialize from a mutable int so we aren't
	// dropping element-level readonly.
	var mx int = 200
	var q readonly *int = &mx
	testing.Println(*q)

	// *[]readonly int: raw slice of readonly int.
	var a [3]int
	a[0] = 100
	a[1] = 200
	a[2] = 300
	var s *[]readonly int = a[:]
	testing.Println(s[1])

	// @[]readonly int: managed slice of readonly int.
	var m @[]readonly int = make_slice(int, 2)
	testing.Println(len(m))

	// readonly struct — field access still works.
	var pt readonly Point
	testing.Println(pt.X)

	// Return value with readonly type (parse check).
	var y int = cast(int, x)
	testing.Println(y)
}
