package "main"

// Stage 0 of the const type modifier: `const Type` parses, resolves,
// and is permissive (no enforcement yet — `const T` and `T` are
// treated as interchangeable). Stage 1 will add the enforcement
// rules. For now, just verify that every surface form parses,
// type-checks, and runs.

func readInt(p *const int) int {
	return *p
}

type Point struct {
	X int
	Y int
}

func main() {
	// const on a primitive.
	var x const int = 42

	// *const int: pointer to const int.
	var p *const int = &x
	println(readInt(p))

	// const *int: const pointer (pointer itself is const, but
	// Stage 0 doesn't enforce). Parse + resolve should work.
	var q const *int = &x
	println(*q)

	// *[]const int: raw slice of const int.
	var a [3]int
	a[0] = 100
	a[1] = 200
	a[2] = 300
	var s *[]const int = a[:]
	println(s[1])

	// @[]const int: managed slice of const int.
	var m @[]const int = make_slice(int, 2)
	println(len(m))

	// const struct — field access still works.
	var pt const Point
	println(pt.X)

	// Return value with const type (parse check).
	var y int = cast(int, x)
	println(y)
}
