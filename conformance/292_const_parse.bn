package "main"

// Stage 0 of the const type modifier: `const Type` parses, resolves,
// and is permissive (no enforcement yet — `const T` and `T` are
// treated as interchangeable). Stage 1 will add the enforcement
// rules. For now, just verify that every surface form parses,
// type-checks, and runs.

func readInt(p *readonly int) int {
	return *p
}

type Point struct {
	X int
	Y int
}

func main() {
	// const on a primitive.
	var x const int = 42

	// *readonly int: pointer to const int.
	var p *readonly int = &x
	println(readInt(p))

	// readonly *int: const pointer (pointer itself is const, pointee
	// is mutable). Initialize from a mutable int so we aren't
	// dropping element-level const.
	var mx int = 200
	var q readonly *int = &mx
	println(*q)

	// *[]readonly int: raw slice of const int.
	var a [3]int
	a[0] = 100
	a[1] = 200
	a[2] = 300
	var s *[]readonly int = a[:]
	println(s[1])

	// @[]readonly int: managed slice of const int.
	var m @[]readonly int = make_slice(int, 2)
	println(len(m))

	// const struct — field access still works.
	var pt const Point
	println(pt.X)

	// Return value with const type (parse check).
	var y int = cast(int, x)
	println(y)
}
