package "main"

// Stage 1 of the const rollout: assignability enforces widening-only
// (T → const T allowed; const T → T requires an explicit cast when
// it would drop const behind a reference). Value-type copy-out
// (const T → T for plain int, float, etc.) stays allowed.

func readViaConstPtr(p *readonly int) int {
	// Dereference a pointer-to-const — gives a (const int) rvalue,
	// which is copy-out-ok into an int slot.
	var v int = *p
	return v
}

func sum(p *readonly int, q *readonly int) int {
	return *p + *q
}

func main() {
	var x int = 10
	var y int = 20

	// *int → *readonly int (widening).
	var pc *readonly int = &x
	var qc *readonly int = &y

	// Read through const pointers; value-copy-out is fine.
	println(readViaConstPtr(pc))
	println(sum(pc, qc))

	// Cast explicitly drops const — this is the escape hatch.
	var p2 *int = cast(*int, pc)
	*p2 = 100
	println(x) // 100 — we mutated x via the cast.

	// const variable, value-copy-out into a mutable int.
	var k const int = 7
	var kk int = k
	println(kk)
}
