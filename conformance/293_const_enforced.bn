package "main"

import "pkg/builtins/testing"

// Stage 1 of the readonly rollout: assignability enforces widening-only
// (T → readonly T allowed; readonly T → T requires an explicit unsafe_cast when
// it would drop readonly behind a reference — §8.7). Value-type copy-out
// (readonly T → T for plain int, float, etc.) stays allowed.

func readViaReadonlyPtr(p *readonly int) int {
	// Dereference a pointer-to-readonly — gives a (readonly int) rvalue,
	// which is copy-out-ok into an int slot.
	var v int = *p
	return v
}

func sum(p *readonly int, q *readonly int) int {
	return *p + *q
}

func main() {
	var x int = 10
	var y int = 20

	// *int → *readonly int (widening).
	var pc *readonly int = &x
	var qc *readonly int = &y

	// Read through readonly pointers; value-copy-out is fine.
	testing.Println(readViaReadonlyPtr(pc))
	testing.Println(sum(pc, qc))

	// unsafe_cast explicitly drops readonly — this is the escape hatch.
	var p2 *int = unsafe_cast(*int, pc)
	*p2 = 100
	testing.Println(x) // 100 — we mutated x via the unsafe_cast.

	// readonly variable, value-copy-out into a mutable int.
	var k readonly int = 7
	var kk int = k
	testing.Println(kk)
}
