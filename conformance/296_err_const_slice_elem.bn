package "main"

// Writing through a slice of const elements must be rejected.
// s[i] has type `const int`, which is a const-typed location.

func main() {
	var arr [3]int
	arr[0] = 1
	arr[1] = 2
	arr[2] = 3
	var s *[]const int = arr[:]
	s[0] = 10         // ← assigning to a const-typed location; should error.
}
