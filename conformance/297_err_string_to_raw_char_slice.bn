package "main"

// Stage 2a ratchet: `*[]char = "..."` is a type error. A raw slice
// borrowing rodata with a mutable view is unsound — the literal lives
// in read-only memory but `*[]char` promises write capability.
// Use `*[]readonly char` for read-only borrows or `@[]char` for an
// owned copy.

func main() {
	var s *[]char = "hello"   // ← rejected by Stage 2a.
	_ = s
}
