package "main"

// Out-of-bounds indexing on a slice must trap at runtime, not silently
// read past the end. The check is added by genIndex via OP_BOUNDS_CHECK.

func main() {
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	// len(s) == 3, valid indices are 0..2. s[3] is out of range.
	println(s[3])
}
