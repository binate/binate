package "main"

import "pkg/builtins/testing"

// Stage 2b: `var s @[]char = "..."` implicitly allocates a fresh
// managed-slice and memcpys the bytes in, so `s` is owned+mutable
// and independent of the literal's rodata. A write to an element
// must not fault and must not affect another `@[]char` initialized
// from the same literal.

func main() {
	var a @[]char = "hello"
	var b @[]char = "hello"

	// Mutate a[0] — must not crash (a aliases rodata would segfault).
	a[0] = 'H'

	// a was mutated; b must still be "hello" (independent copy).
	testing.Println(cast(int, a[0])) // 72 ('H')
	testing.Println(cast(int, b[0])) // 104 ('h')
	testing.Println(len(a)) // 5
	testing.Println(len(b)) // 5
}
