package "main"

import "pkg/builtins/testing"

// Stage 2c Phase 1: string-literal initializing a fixed-size char
// array. `var s [N]readonly char = "..."` copies the rodata bytes into
// the array. Value semantics — the array is independent of the
// literal.

func main() {
	var s [5]readonly char = "abcde"
	testing.Println(cast(int, s[0])) // 'a' = 97
	testing.Println(cast(int, s[1])) // 'b' = 98
	testing.Println(cast(int, s[4])) // 'e' = 101
}
