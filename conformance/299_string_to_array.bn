package "main"

// Stage 2c Phase 1: string-literal initializing a fixed-size char
// array. `var s [N]const char = "..."` copies the rodata bytes into
// the array. Value semantics — the array is independent of the
// literal.

func main() {
	var s [5]const char = "abcde"
	println(cast(int, s[0]))  // 'a' = 97
	println(cast(int, s[1]))  // 'b' = 98
	println(cast(int, s[4]))  // 'e' = 101
}
