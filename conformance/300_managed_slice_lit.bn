package "main"

import "pkg/builtins/testing"

// Phase 2: managed-slice composite literal `@[]T{...}`. Allocates
// a fresh backing and stores each element. The result is owned and
// independent of any other allocation.

func main() {
	var s @[]int = @[]int{10, 20, 30}
	testing.Println(s[0])
	testing.Println(s[1])
	testing.Println(s[2])
	testing.Println(len(s))

	// Mutation works — the backing is owned + mutable.
	s[1] = 99
	testing.Println(s[1])
}
