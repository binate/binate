package "main"

import "pkg/builtins/testing"

// Phase 2: managed-slice composite literal with a mix of compile-
// time and runtime values. Each evaluation allocates a fresh
// backing.

func main() {
	var y int = 42
	var s @[]int = @[]int{1, 2, y}
	testing.Println(s[0])
	testing.Println(s[1])
	testing.Println(s[2])

	// Per-encounter allocation: each visit allocates fresh.
	for i := 0; i < 3; i++ {
		var t @[]int = @[]int{i, i + 1, i + 2}
		testing.Println(t[1])
	}
}
