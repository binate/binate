package "main"

import "pkg/builtins/testing"

// Phase 2: managed-slice composite literal with const elements.
// `@[]readonly T{...}` allocates a fresh backing whose elements are
// sealed as const through the returned handle. (Implementation
// detail: today this allocates per-encounter; future optimization
// may share a static %BnManagedSlice global for all-compile-time
// elements — observable through pointer-identity and declared UB.)

func main() {
	var s @[]readonly int = @[]readonly int{100, 200, 300}
	testing.Println(s[0])
	testing.Println(s[1])
	testing.Println(s[2])
	testing.Println(len(s))
}
