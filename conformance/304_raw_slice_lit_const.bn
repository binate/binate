package "main"

// Phase 2b: raw-slice composite literal with const elements.
// `*[]const T{...}` is allowed — the elements live on the
// enclosing-scope stack (or rodata, eventually) and the raw slice
// borrows them.

func main() {
	var s *[]const int = *[]const int{10, 20, 30}
	println(s[0])
	println(s[1])
	println(s[2])
	println(len(s))

	// Mixed (runtime element) — backing is stack-allocated.
	var y int = 99
	var t *[]const int = *[]const int{1, 2, y}
	println(t[2])
}
