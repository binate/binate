package "main"

import "pkg/builtins/testing"

// Phase 2b: raw-slice composite literal with const elements.
// `*[]readonly T{...}` is allowed — the elements live on the
// enclosing-scope stack (or rodata, eventually) and the raw slice
// borrows them.

func main() {
	var s *[]readonly int = *[]readonly int{10, 20, 30}
	testing.Println(s[0])
	testing.Println(s[1])
	testing.Println(s[2])
	testing.Println(len(s))

	// Mixed (runtime element) — backing is stack-allocated.
	var y int = 99
	var t *[]readonly int = *[]readonly int{1, 2, y}
	testing.Println(t[2])
}
