package "main"

// `*[]T{...}` (non-const element) is rejected: a raw slice with
// mutable elements has no sound backing — rodata is read-only and
// stack is scope-bound. Use *[]const T{...} or @[]T{...} instead.

func main() {
	var s *[]int = *[]int{1, 2, 3}   // ← element is non-const; rejected.
	_ = s
}
