package "main"

// Regression: struct field of array type `[N]T` was indexed via
// the slice-data-extract codegen path (extractvalue field 0 of
// the loaded array, then bitcast as a pointer), producing
// malformed LLVM IR. Fixed by routing array-typed selectors
// through `genSelectorPtr` to get a pointer to the field, then
// GEP-ing into it.

type Box struct {
	values [4]int
	count  int
}

func main() {
	var b Box
	b.values[0] = 10
	b.values[1] = 20
	b.values[2] = 30
	b.values[3] = 40
	b.count = 4

	for i := 0; i < b.count; i++ {
		println(b.values[i])
	}

	// Mutate then re-read.
	b.values[2] = 99
	println(b.values[2])
}
