package "main"

import "pkg/builtins/testing"

// Combines string-literal initialization of a [N]char array (299)
// with indexing a struct field of array type (306). Real-world
// shape: a struct with a fixed-size string buffer initialized from
// a literal, then indexed.

type Name struct {
	bytes [8]readonly char
	size  int
}

func main() {
	var n Name = Name{"alpha", 5}
	testing.Println(cast(int, n.bytes[0])) // 'a' = 97
	testing.Println(cast(int, n.bytes[4])) // 'a' = 97
	testing.Println(n.size) // 5
	// Bytes past the literal sizegth are zero-padded.
	testing.Println(cast(int, n.bytes[5])) // 0
	testing.Println(cast(int, n.bytes[7])) // 0
}
