package "main"

// Stage 2c default-flip: `x := "..."` (or `var x = "..."` with no
// explicit type) infers the default type of a string literal —
// @[]readonly char. Verifies that the inferred default behaves like a
// managed-slice (len works, indexing works, length matches the
// unescaped byte count).

func main() {
	var s = "hello"
	println(len(s))          // 5
	println(cast(int, s[0])) // 104 ('h')
	println(cast(int, s[4])) // 111 ('o')

	// Short-var-decl form.
	t := "ab\ncd"
	println(len(t))          // 5 (\n is one byte)
	println(cast(int, t[2])) // 10 ('\n')
}
