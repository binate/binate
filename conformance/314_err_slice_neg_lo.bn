package "main"

import "pkg/builtins/testing"

// Negative lo also caught by the bounds check (the rt primitive treats
// it as out of [0, length) since the unsigned comparison fails).

func main() {
	var s @[]int = make_slice(int, 4)
	var lo int = -1
	var t *[]int = s[lo:2]
	testing.Println(len(t))
}
