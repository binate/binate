package "main"

import "pkg/builtins/testing"

// Positive regression test for the missing-return / termination
// analysis in pkg/binate/types. Every function below has at least one result
// and terminates on every path through some non-trivial form — the
// checker should accept all of them.

// Plain trailing return.
func trailing(x int) int {
	return x + 1
}

// if/else — both branches return.
func ifElse(x int) int {
	if x > 0 {
		return 1
	} else {
		return -1
	}
}

// Chained if/else-if/else — only terminates because every leaf returns.
func chained(x int) int {
	if x > 0 {
		return 1
	} else if x < 0 {
		return -1
	} else {
		return 0
	}
}

// Unconditional for-loop with no break — terminates (infinite loop).
func forever() int {
	for {
		dummy()
	}
}

// Switch with default where every case returns.
func sw(x int) int {
	switch x {
	case 1:
		return 10
	case 2, 3:
		return 20
	default:
		return 0
	}
}

// Nested: if whose branches each contain a terminating switch.
func nested(x int, y int) int {
	if x > 0 {
		switch y {
		case 0:
			return 1
		default:
			return 2
		}
	} else {
		return 3
	}
}

func dummy() {}

func main() {
	testing.Println(trailing(5))
	testing.Println(ifElse(3))
	testing.Println(chained(-2))
	testing.Println(sw(2))
	testing.Println(nested(1, 0))
}
