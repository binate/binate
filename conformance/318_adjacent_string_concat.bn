package "main"

// C-style adjacent string-literal concatenation: two or more string
// literals separated only by whitespace (or comments) merge into one
// at parse time. Works on the same line and across newlines.

func main() {
	// Same-line, two literals.
	var a *[]const char = "Hello, " "world"
	println(a)

	// Cross-line, two literals.
	var b *[]const char = "expected 'func', 'type', 'var', "
	                      "or identifier"
	println(b)

	// Three or more.
	var c *[]const char = "one" " " "two" " " "three"
	println(c)

	// Comments in the gap don't break the merge.
	var d *[]const char = "left" /* gap */ "right"
	println(d)

	// Escapes in each part are preserved verbatim.
	var e *[]const char = "tab\there\n" "next"
	println(e)

	// A non-string token between two literals does NOT merge.
	// (Compile error if it tried.)
	var pair @[]@[]char = make_slice(@[]char, 2)
	pair[0] = "alpha"
	pair[1] = "beta"
	println(pair[0])
	println(pair[1])
}
