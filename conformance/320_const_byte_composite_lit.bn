package "main"

import "pkg/builtins/testing"

// Phase 3.1 of composite-literal generalization: managed-slice and
// raw-slice composite literals with `const uint8` element type and
// all-compile-time-byte elements lower to `OP_RODATA_MSLICE` /
// `OP_RODATA_SLICE` — backends alias a static rodata global instead
// of running MakeSlice + N stores at runtime.

func main() {
	// Managed-slice case.
	var s @[]readonly char = @[]readonly char{'a', 'b', 'c'}
	testing.Println(len(s))
	testing.Println(cast(int, s[0])) // 97 'a'
	testing.Println(cast(int, s[2])) // 99 'c'

	// Raw-slice case.
	var r *[]readonly char = *[]readonly char{'X', 'Y', 'Z'}
	testing.Println(len(r))
	testing.Println(cast(int, r[0])) // 88 'X'
	testing.Println(cast(int, r[2])) // 90 'Z'

	// Mixed char + int literals (int values that fit in a byte).
	var t @[]readonly char = @[]readonly char{72, 'i', 33}
	testing.Println(cast(int, t[0])) // 72 'H'
	testing.Println(cast(int, t[1])) // 105 'i'
	testing.Println(cast(int, t[2])) // 33 '!'
}
