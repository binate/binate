package "main"

// Phase 3.1 of composite-literal generalization: managed-slice and
// raw-slice composite literals with `const uint8` element type and
// all-compile-time-byte elements lower to `OP_RODATA_MSLICE` /
// `OP_RODATA_SLICE` — backends alias a static rodata global instead
// of running MakeSlice + N stores at runtime.

func main() {
	// Managed-slice case.
	var s @[]const char = @[]const char{'a', 'b', 'c'}
	println(len(s))
	println(cast(int, s[0]))   // 97 'a'
	println(cast(int, s[2]))   // 99 'c'

	// Raw-slice case.
	var r *[]const char = *[]const char{'X', 'Y', 'Z'}
	println(len(r))
	println(cast(int, r[0]))   // 88 'X'
	println(cast(int, r[2]))   // 90 'Z'

	// Mixed char + int literals (int values that fit in a byte).
	var t @[]const char = @[]const char{72, 'i', 33}
	println(cast(int, t[0]))   // 72 'H'
	println(cast(int, t[1]))   // 105 'i'
	println(cast(int, t[2]))   // 33 '!'
}
