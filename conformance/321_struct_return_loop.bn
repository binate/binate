package "main"

import "pkg/builtins/lang"

// Repro for BC_RETURN frame leak in pkg/binate/vm: when a callee returns a
// struct by value via a pointer to its own stack alloca, BC_RETURN
// (pkg/binate/vm/vm.bn:432-443) bumps callerSP to vm.SP — the callee frame
// stays on the stack and never gets popped. In a tight loop, vm.SP
// grows linearly until "vm: stack overflow".
//
// The function below has a [512]int local (~4 KB allocas), so each
// leaked frame is ~4.5 KB. 2000 iterations × 4.5 KB ≈ 9 MB, which
// blows past the default 8 MiB VM stack. Compiled native modes are
// unaffected because LLVM uses proper struct-return ABI.

type S struct {
	a int
	b int
	c int
	d int
	e int
	f int
}

func makeS(seed int) S {
	var buf [512]int
	buf[0] = seed
	var s S
	s.a = buf[0]
	s.b = seed * 2
	s.c = seed * 3
	s.d = seed * 4
	s.e = seed * 5
	s.f = seed * 6
	return s
}

func main() {
	var total int = 0
	for i := 0; i < 2000; i++ {
		var s S = makeS(i)
		total = total + s.a
	}
	// Sum of i from 0 to 1999 = 1999000
	print(total.String())
	println("")
}
