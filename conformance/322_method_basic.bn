package "main"

import "pkg/builtins/testing"

type Point struct {
	x int
	y int
}

// Pointer receiver
func (p *Point) X() int {
	return p.x
}

// Value receiver — same body, different calling convention.
func (p Point) Y() int {
	return p.y
}

// Pointer receiver with extra args.
func (p *Point) Sum(scale int) int {
	return (p.x + p.y) * scale
}

func main() {
	var p Point
	p.x = 7
	p.y = 11
	var pp *Point = &p

	testing.Println(pp.X()) // 7  — *Point on *Point method
	testing.Println(p.Y()) // 11 — value on value method
	testing.Println(pp.Sum(2)) // 36 — args after receiver
}
