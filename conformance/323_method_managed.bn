package "main"

import "pkg/builtins/testing"

type Node struct {
	val  int
	next @Node
}

// Managed receiver — refcount of the receiver is bumped while the
// method runs. The body may call further methods (also managed) and
// access fields freely.
func (n @Node) Sum() int {
	if n.next == nil {
		return n.val
	}
	return n.val + n.next.Sum()
}

// Construct a 1→2→3 linked list and sum it.
func main() {
	var c @Node = make(Node)
	c.val = 3

	var b @Node = make(Node)
	b.val = 2
	b.next = c

	var a @Node = make(Node)
	a.val = 1
	a.next = b

	testing.Println(a.Sum()) // 6
	testing.Println(a.next.Sum()) // 5  — chained call on @T field
	testing.Println(c.Sum()) // 3  — leaf node
}
