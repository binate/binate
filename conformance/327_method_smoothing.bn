package "main"

// Receiver smoothing: when the receiver expression's type doesn't
// exactly match the method's declared receiver type, the type checker
// applies the receiver conversions, and IR-gen emits the
// corresponding ops.
type Point struct { x int; y int }

// *T receiver, called from a *T expr — exact match.
func (p *Point) X() int { return p.x }

// Value (T) receiver, called from a *T expr — auto-deref.
func (p Point) Y() int { return p.y }

// *T receiver again, called from a value T expr — auto-take-address.
func (p *Point) Sum() int { return p.x + p.y }

func main() {
	var p Point
	p.x = 7
	p.y = 11
	var pp *Point = &p

	println(pp.X()) // 7  — exact (*T on *T)
	println(pp.Y()) // 11 — *T expr on value method (auto-deref)
	println(p.Y())  // 11 — value on value method (exact)
	println(p.Sum()) // 18 — value on *T method (auto-take-address)
}
