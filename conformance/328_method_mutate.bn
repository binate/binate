package "main"

type Counter struct { n int }

// Pointer-receiver method that mutates through the receiver. Calling
// it via a *T expression updates the underlying value.
func (c *Counter) Add(delta int) {
	c.n = c.n + delta
}

// Read-only via the same receiver kind.
func (c *Counter) Get() int {
	return c.n
}

func main() {
	var c Counter
	c.n = 10
	var pc *Counter = &c

	pc.Add(5)
	pc.Add(2)
	println(pc.Get()) // 17
	println(c.n)      // 17 — same backing
}
