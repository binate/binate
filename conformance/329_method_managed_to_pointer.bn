package "main"

import "pkg/builtins/testing"

// @T receiver expression on a *T receiver method — managed→raw
// smoothing. This conversion is implicit
// (the @T's data pointer is passed; refcount is held by the caller).
type Node struct {
	val int
}

// Method takes a *T receiver — caller's @T is converted at the call.
func (n *Node) Get() int {
	return n.val
}

func main() {
	var n @Node = make(Node)
	n.val = 42

	testing.Println(n.Get()) // 42 — @T expr on *T method
}
