package "main"

import "pkg/builtins/testing"

// Bit-exact verification of float arithmetic: print the raw IEEE
// 754 bit patterns as int64 rather than relying on the bootstrap's
// human-readable float formatter (see 287). This pins down the
// codegen's float ops independent of any format-side decisions.
//
// All values below are well-defined under IEEE 754 round-to-nearest-
// even, so the bit patterns are the same on every conforming impl
// (which includes LLVM and the VM's float ops).
//
// Uses `bit_cast(int64, ...)` instead of `bit_cast(int, ...)` so
// the test stays valid on ILP32 targets where `int` is 32 bits and
// the bit_cast would be a size mismatch.

func main() {
	// 1.5 + 2.5 = 4.0 exactly. IEEE 754 float64 4.0 = 0x4010000000000000
	// = 4616189618054758400.
	var a float64 = 1.5 + 2.5
	testing.Println(bit_cast(int64, a))

	// 10.0 / 4.0 = 2.5 exactly. float64 2.5 = 0x4004000000000000
	// = 4612811918334230528.
	var b float64 = 10.0 / 4.0
	testing.Println(bit_cast(int64, b))

	// 0.1 + 0.2 famously is NOT 0.3 in IEEE — the operation produces
	// the float closest to 0.30000000000000004... bit pattern
	// 0x3FD3333333333334 = 4599075939470750516.
	var c float64 = 0.1 + 0.2
	testing.Println(bit_cast(int64, c))

	// +0.0 has all bits zero.
	var d float64 = 0.0
	testing.Println(bit_cast(int64, d))

	// 3.14 literal → 0x40091EB851EB851F = 4614253070214989087
	// (IEEE 754 closest representation to 3.14).
	var e float64 = 3.14
	testing.Println(bit_cast(int64, e))
}
