package "main"

import "pkg/buf"

// Cross-package method calls: main directly calls methods on buf.CharBuf
// using dotted syntax. Exercises three IR-gen things that don't show up
// in single-package tests:
//
//   - qualified method name resolution when the receiver type is
//     imported (Type.Name is already "buf.CharBuf", not just "CharBuf");
//   - extern method declarations registered for imported types;
//   - struct-copy of the receiver at the call site (CharBuf has a @[]char
//     field — without RefInc the backing was freed prematurely).
func main() {
	var b buf.CharBuf = buf.New()

	// Direct method call on the imported type.
	b = b.WriteByte('H')
	b = b.WriteByte('i')

	// Chained cross-package method calls — exercises applyReceiverConversion
	// on the result of a previous method call too.
	b = b.WriteStr(", ").WriteInt(42)

	println(b.Len())   // 8
	println(b.Bytes()) // Hi, 42
}
