package "main"
import "pkg/builtins/testing"

import "pkg/holder"

// Cross-package method calls: main directly calls methods on holder.Holder
// using dotted syntax. Exercises three IR-gen things that don't show up in
// single-package tests:
//
//   - qualified method name resolution when the receiver type is imported
//     (Type.Name is already "holder.Holder", not just "Holder");
//   - extern method declarations registered for imported types;
//   - struct-copy of the receiver at the call site (Holder has a @[]char
//     field — without RefInc the backing was freed prematurely).
func main() {
	var h holder.Holder = holder.New()

	// Direct method call on the imported type.
	h = h.Add(3)
	h = h.Add(5)

	// Chained cross-package method calls — exercises receiver conversion
	// on the result of a previous method call too.
	h = h.Add(10).Add(24)

	testing.Println(h.Read())  // 42
	testing.Println(h.Show())  // Hi
}
