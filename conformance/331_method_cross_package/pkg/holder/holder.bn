package "pkg/holder"

// Holder is the receiver type for the methods exercised by this test. The
// Tag field is intentionally @[]char: cross-package method calls must
// RefInc the receiver-copy at the call site, otherwise Tag's backing is
// freed prematurely once the original goes out of scope.
type Holder struct {
	Tag @[]char
	Count int
}

// New returns a fresh Holder with a fixed tag and Count set to zero. The
// tag is set from a string literal to exercise the literal-init
// allocate+copy path for the receiver's @[]char field.
func New() Holder {
	var h Holder
	h.Tag = "Hi"
	h.Count = 0
	return h
}

// Add increments the count by n. Returns the updated Holder (chainable).
func (h Holder) Add(n int) Holder {
	h.Count = h.Count + n
	return h
}

// Read returns the current count.
func (h Holder) Read() int {
	return h.Count
}

// Show returns the tag. The returned managed slice shares backing with the
// receiver's Tag field; the call site relies on the receiver-copy holding
// a refcount on Tag for the duration of the call.
func (h Holder) Show() @[]char {
	return h.Tag
}
