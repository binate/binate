package "main"

import "pkg/bootstrap"

// Native AArch64 backend bug: forwarding a >16-byte value-struct
// argument to another call that inserts extra args before the struct
// crashes the test binary. The codegen for "copy bytes from local
// struct slot to outgoing-arg stack area" emits
//
//   ldr x15, [x15]            ; field 0
//   str x15, [sp]
//   ldr x15, [x15, #0x8]      ; field 1 — but uses x15 as base, which now
//                             ;   holds the field-0 value, NOT the source ptr
//   ldr x15, [x15, #0x10]     ; chases through, eventually hits NULL
//
// instead of the correct
//
//   ldr x9, [x15]
//   str x9, [sp]
//   ldr x9, [x15, #0x8]
//   ...
//
// — same temp register used for source pointer and load destination.
//
// Trigger: function takes a >16-byte struct by value and forwards it
// to another function whose argument list inserts extra args between
// the received args and the struct (so the outgoing-arg stack layout
// differs from the incoming one — codegen must copy bytes).
//
// Mirrors pkg/binate/asm/aarch64.Add → emitDPOp shape, where Add inserts
// constant opcode args:
//
//   func Add(a, sf, rd, rn, op) {
//     emitDPOp(a, sf, ADD_REG_OPC, ADD_IMM_OPC, rd, rn, op)
//   }
//
// Same-shape forwarding (no inserted args) does NOT reproduce —
// presumably because the codegen reuses the incoming slot.
//
// Same struct layout but ≤16 bytes also does NOT reproduce — those
// fit in registers per AAPCS, no stack copy needed.

type Op struct {
	A int
	B int
	C int
}

func emitDPOp(a int, b bool, regOpc int, immOpc int, rd int, rn int, op Op) int {
	return rd + rn + op.A + op.B + regOpc + immOpc
}

func add(a int, b bool, rd int, rn int, op Op) int {
	return emitDPOp(a, b, 100, 200, rd, rn, op)
}

func main() {
	var op Op
	op.A = 1
	op.B = 7
	var r int = add(0, false, 5, 10, op)
	if r != 323 {
		print("FAIL r=")
		println(r)
		bootstrap.Exit(1)
	}
	println("PASS")
}
