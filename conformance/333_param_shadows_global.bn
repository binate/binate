// Regression: a parameter (or local var) whose name collides with a
// package-level global must NOT be routed to the global's storage by
// the bytecode-VM lowering. Detecting globals via
// `Op==OP_ALLOC && len(StrVal)>0` (with a lookup-by-name tiebreaker)
// mis-matches local allocas tagged with the var name for debug info:
// a `target` parameter beside a package global `var target TargetInfo`
// then writes into the global and clobbers its `PointerSize`.

package "main"

import "pkg/builtins/testing"

type Cfg struct {
	X int
	Y int
}

var target Cfg

var sentinel int

func setTarget(target Cfg) {
	// `target` here is the parameter, not the global. Writes/reads
	// must go to the parameter's stack slot. If lowering routes
	// them to the global, we'd clobber the global below.
	sentinel = target.X + target.Y
}

func main() {
	target.X = 100
	target.Y = 200

	var p Cfg
	p.X = 7
	p.Y = 8
	setTarget(p)

	// sentinel should be 7 + 8 = 15
	testing.Println(sentinel)

	// The global must still be 100 / 200 — setTarget's parameter
	// writes/reads must NOT have touched the global.
	testing.Println(target.X)
	testing.Println(target.Y)
}
