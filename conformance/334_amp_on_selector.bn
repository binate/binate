// Regression: `&` applied to a selector expression must return the
// field's address (a pointer suitable for deref / write-through),
// not the loaded field VALUE. Pre-fix, genUnary's `&` arm only
// handled EXPR_IDENT and EXPR_INDEX; for an EXPR_SELECTOR it fell
// through to evaluating the selector as a value, so `&s.f` came
// back as the LOAD result and any subsequent dereference touched
// the wrong memory.

package "main"

type Point struct {
	X int
	Y int
}

var g Point

func main() {
	g.X = 11
	g.Y = 22

	// & on global selector
	var pgx *int = &g.X
	pgx[0] = 99
	println(g.X)  // 99

	// & on local selector
	var p Point
	p.X = 7
	p.Y = 8
	var ppy *int = &p.Y
	ppy[0] = 88
	println(p.Y)  // 88

	// & on managed-ptr-to-struct selector
	var mp @Point = make(Point)
	mp.X = 3
	var pmx *int = &mp.X
	pmx[0] = 33
	println(mp.X)  // 33

	// & on raw-ptr-to-struct selector
	var rp *Point = &p
	var prx *int = &rp.X
	prx[0] = 77
	println(p.X)  // 77 (rp aliases p)
}
