package "main"

import "pkg/bootstrap"

// Reduction targeting cluster A pkg/asm/parse TestParseMov failure.
// Multi-return tuples larger than 64 bytes silently drop data past
// the 8th 8-byte word: the native AArch64 backend packs multi-return
// values into X0..X7 unconditionally, with no fallback to the
// AAPCS-style sret indirect-result path used for single >64-byte
// aggregate returns.
//
// pkg/asm/parse triggers this through `l, tok = LexNext(l)` where
// LexNext returns (Lexer, Token) — Lexer is 40 bytes, Token is 64
// bytes, total 104 bytes. The 9th word and beyond come back as
// garbage in the caller, corrupting Token's later fields.
//
// Reduction: two scalar structs whose combined size exceeds 64
// bytes. The 9th word is S2.B4 (tuple offset 64). Earlier fields
// of S2 read correctly (they fit in X4..X7); B4 onward fails.

type S1 struct {
	A1 int
	A2 int
	A3 int
	A4 int
	A5 int
}

type S2 struct {
	B1 int
	B2 int
	B3 int
	B4 int
	B5 int
	B6 int
	B7 int
	B8 int
}

func make2() (S1, S2) {
	var s1 S1
	s1.A1 = 1
	s1.A5 = 5
	var s2 S2
	s2.B1 = 11
	s2.B4 = 14
	s2.B8 = 18
	return s1, s2
}

func main() {
	var s1 S1
	var s2 S2
	s1, s2 = make2()
	if s1.A1 != 1 { println("FAIL s1.A1"); bootstrap.Exit(1) }
	if s1.A5 != 5 { println("FAIL s1.A5"); bootstrap.Exit(2) }
	if s2.B1 != 11 { println("FAIL s2.B1"); bootstrap.Exit(3) }
	if s2.B4 != 14 { println("FAIL s2.B4"); bootstrap.Exit(4) }
	if s2.B8 != 18 { println("FAIL s2.B8"); bootstrap.Exit(5) }
	println("PASS")
}
