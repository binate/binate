package "main"

import "pkg/builtins/testing"

// Multi-return tuples larger than 64 bytes must return every word:
// packing multi-return values into X0..X7 unconditionally on native
// AArch64, with no fallback to the AAPCS-style sret indirect-result
// path used for single >64-byte aggregate returns, would silently drop
// data past the 8th 8-byte word.
//
// pkg/binate/asm/parse has this shape in `l, tok = LexNext(l)`, where
// LexNext returns (Lexer, Token) — Lexer is 40 bytes, Token is 64
// bytes, total 104 bytes; a dropped 9th word and beyond would corrupt
// Token's later fields in the caller.
//
// Reduction: two scalar structs whose combined size exceeds 64
// bytes. The 9th word is S2.B4 (tuple offset 64); the earlier fields
// of S2 fit in X4..X7.

type S1 struct {
	A1 int
	A2 int
	A3 int
	A4 int
	A5 int
}

type S2 struct {
	B1 int
	B2 int
	B3 int
	B4 int
	B5 int
	B6 int
	B7 int
	B8 int
}

func make2() (S1, S2) {
	var s1 S1
	s1.A1 = 1
	s1.A5 = 5
	var s2 S2
	s2.B1 = 11
	s2.B4 = 14
	s2.B8 = 18
	return s1, s2
}

func main() {
	var s1 S1
	var s2 S2
	s1, s2 = make2()
	if s1.A1 != 1 { testing.Println("FAIL s1.A1"); return }
	if s1.A5 != 5 { testing.Println("FAIL s1.A5"); return }
	if s2.B1 != 11 { testing.Println("FAIL s2.B1"); return }
	if s2.B4 != 14 { testing.Println("FAIL s2.B4"); return }
	if s2.B8 != 18 { testing.Println("FAIL s2.B8"); return }
	testing.Println("PASS")
}
