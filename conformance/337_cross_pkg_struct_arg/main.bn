package "main"
import "pkg/builtins/testing"

import "pkg/op"

// Cross-package by-value pass of a managed-aware struct that doesn't
// fully fit in the remaining arg registers: the native AArch64 caller
// must split it between registers and stack exactly as the callee
// expects.
//
// Shape:
//   - 56-byte (3 ints + @[]char) Operand-style struct in pkg/op
//   - Encode(cond int, rt int, op Operand): leading 2 ints leave only
//     6 reg slots (X2..X7) but op needs 7 words
//   - Conformance compiles main.bn with -backend native, and pkg/op
//     with the LLVM backend (per cmd/bnc/main.bn:194 — deps still go
//     through LLVM until the native backend self-hosts the runtime).
//   - LLVM's pkg/op.Encode prologue reads op as 6 regs + 1 stack arg
//     (the per-element split convention LLVM emits for byval structs).
//     A native caller that puts the WHOLE 7-word op on the stack (a
//     CallArgRegStart that returns -1 once ngrn+w > 8) never fills
//     X2..X7.
//   - Encode then receives op[0]..op[5] from whatever leftover values
//     are in X2..X7 at the call (i.e., garbage), and reads op.Kind
//     (= X2's leftover value) from a stale spill rather than the value
//     main set.
//
// The same shape with the struct entirely fitting in the remaining
// regs (e.g. 2 ints + @[]char = 5 words after 2 leading ints = 7 regs
// ≤ 8) does not exercise the split — both backends agree on the
// all-in-regs case. Pure-int structs of the same total size do not
// exercise it either — it needs the managed-slice field, presumably
// because LLVM's ABI emission differs once the struct contains a
// managed pointer.
//
// The native CallArgRegStart / CallArgStackOff and emitCall + prologue
// support split passing (fill the remaining regs, put the overflow on
// the stack) to match LLVM's behavior.

func main() {
	var o op.Operand
	o.Kind = op.OP_MEM_IMM
	o.A = 1
	o.B = 2
	var r int = op.Encode(14, 0, o)
	if r != 1 {
		testing.Print("FAIL Encode saw wrong Kind, returned ")
		testing.Println(r)
		return
	}
	testing.Println("PASS")
}
