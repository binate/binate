package "pkg/op"

const OP_MEM_IMM int = 4

// 56-byte Operand: 3 ints + a managed-slice field. Picked to mirror
// pkg/binate/asm/arm32's Operand shape. The @[]char (managed-slice =
// 4 words) is needed to exercise the register/stack split (see
// main.bn) — pure-int structs of the same total size do not.
type Operand struct {
	Kind  int
	A     int
	B     int
	Label @[]char
}

// Encode takes the Operand by value through a package boundary,
// after 2 leading int args. With native backend on main and LLVM
// on this package, the call-site ABI for op disagrees:
//   - LLVM Encode prologue: reads op[0..5] from X2..X7, op[6] from
//     stack[0] — split fill.
//   - Native main's emitCall: writes op[0..6] entirely to stack[0..48]
//     (no-split). X2..X7 left holding garbage.
func Encode(cond int, rt int, op Operand) int
