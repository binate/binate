package "main"

import "pkg/builtins/testing"

// Nil-initialization of function-value typed variables: declaring
// *func(...) and @func(...) variables and assigning nil to them.
// Only declaration and zero-init are exercised here; construction
// and calls are covered by 339 / 340.

func main() {
	// Bare declaration — zero-init via the bare-decl IR-gen path.
	var f *func(int) int
	var g @func()
	// Explicit nil initialization — exercises IsNillable + the
	// OP_CONST_NIL retyping path.
	var h *func(*int) = nil
	var k @func(int, int) int = nil
	// Multi-return type — exercises the result-list branch.
	var m *func(int) (int, int) = nil
	_ = f
	_ = g
	_ = h
	_ = k
	_ = m
	testing.Println("ok")
}
