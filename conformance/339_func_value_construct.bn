package "main"

import "pkg/builtins/testing"

// Function reference assigned to a function-value type. The value
// is constructed (vtable pointer + nil data); calls through a
// function value are covered by 340.

func add(a int, b int) int {
	return a + b
}

func helper() {}

func main() {
	// Raw function value.
	var f *func(int, int) int = add
	// Managed function value.
	var g @func() = helper
	// Multi-return signature.
	var noOp *func() = helper
	_ = f
	_ = g
	_ = noOp
	testing.Println("ok")
}
