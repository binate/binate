package "main"

// Slice A.3 of plan-function-values: function reference assigned
// to a function-value type. The value is constructed (vtable
// pointer + nil data) but not yet usable for calls — that's a
// later slice.

func add(a int, b int) int {
	return a + b
}

func helper() {
}

func main() {
	// Raw function value.
	var f *func(int, int) int = add
	// Managed function value.
	var g @func() = helper
	// Multi-return signature.
	var noOp *func() = helper
	_ = f
	_ = g
	_ = noOp
	println("ok")
}
