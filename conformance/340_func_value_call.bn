package "main"

// Slice A.4 of plan-function-values: calling through a function value.
// `f := add; f(2, 3)` dispatches via vtable.call (compiled mode) or
// the closure record's vm_func_idx (VM mode).

func add(a int, b int) int {
	return a + b
}

func double(x int) int {
	return x * 2
}

func sayHi() {
	println("hi")
}

func main() {
	var f *func(int, int) int = add
	var sum int = f(2, 3)
	println(sum)  // 5

	var g *func(int) int = double
	println(g(7))  // 14

	// Managed function value, void return.
	var h @func() = sayHi
	h()  // hi
}
