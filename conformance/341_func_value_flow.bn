package "main"

import "pkg/builtins/testing"

// Function values flowing through call args, returns, struct
// fields, composite literals, and pass-through. Each pattern
// exercises a different coercion site in IR-gen: a bare function
// reference (Ident) is coerced to a function value when assigned/
// passed/returned into a slot of function-value type. (Slice A.5
// of plan-function-values.)

func add(a int, b int) int { return a + b }

func double(x int) int { return x * 2 }

// Function value as parameter.
func apply(f *func(int) int, x int) int {
	return f(x)
}

// Pass-through: take a function-value local and pass it on as
// another function-value argument (no fresh OP_FUNC_VALUE emit).
func indirect(f *func(int) int, x int) int {
	return apply(f, x)
}

// Function value as return type.
func pickDouble() *func(int) int {
	return double
}

// Function value in struct field.
type Op struct {
	Name @[]char
	Fn   *func(int, int) int
}

func main() {
	// Arg coercion: `double` (function reference) → *func(int) int.
	testing.Println(apply(double, 5))

	// Pass-through: `f` is already a function value; passing it as
	// another function-value arg shouldn't re-coerce.
	testing.Println(indirect(double, 6))

	// Field-assign coercion: `add` (function reference) → struct field.
	// Calling through the field exercises the SELECTOR-shaped callee
	// path in genCall.
	var op Op
	op.Fn = add
	testing.Println(op.Fn(3, 4))

	// Composite-literal coercion: `add` in a keyed struct literal.
	var op2 Op = Op{Fn: add}
	testing.Println(op2.Fn(10, 20))

	// Return coercion: `return double` from a function-value-returning
	// function. The result is then bound to a function-value local.
	var f *func(int) int = pickDouble()
	testing.Println(f(7))
}
