package "main"

// Slice A.6 of plan-function-values: method expressions T.M.
// `T.M` (T a named type, M a method on T) is a function value whose
// signature includes the method's declared receiver as the first
// parameter. Equivalent to a non-capturing function reference; uses
// the same OP_FUNC_VALUE machinery, with funcRefName recognizing the
// type-name selector form and emitting the qualified method name.

type Counter struct {
	N int
}

func (c Counter) Add(x int) int {
	return c.N + x
}

func (c *Counter) Bump(by int) int {
	return c.N + by
}

func apply(f *func(Counter, int) int, c Counter, x int) int {
	return f(c, x)
}

func main() {
	var c Counter = Counter{N: 10}

	// Method expression bound to a function-value local.
	var f *func(Counter, int) int = Counter.Add
	println(f(c, 5))   // 15

	// Method expression passed as a function-value argument.
	println(apply(Counter.Add, c, 7))   // 17

	// Pointer-receiver method expression.
	var g *func(*Counter, int) int = Counter.Bump
	println(g(&c, 3))  // 13

	// Direct invocation of a method expression: T.M(receiver, args).
	println(Counter.Add(c, 100))  // 110
}
