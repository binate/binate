package "main"

import "pkg/bootstrap"

// Regression test for `pkg/binate/vm: fix host-stack leak in execLoop's
// BC_CALL extern branch` (commit 900a44e). Pre-fix, every BC_CALL
// extern leaked 32 bytes of host stack (the @[]int callArgs alloca
// declared inside the BC_CALL branch). After ~262K extern calls
// the host process SIGSEGV'd from stack overflow.
//
// Uses bootstrap.Close(-1) — a cheap, scalar-arg extern that
// doesn't allocate or push anything onto the VM stack per call,
// so this test isolates the BC_CALL extern path. 1,000,000
// iterations >> 262K, so the buggy version fails fast; the
// fixed version completes in well under a second.
func main() {
	var i int = 0
	for i < 1000000 {
		bootstrap.Close(-1)
		i = i + 1
	}
	println("ok")
}
