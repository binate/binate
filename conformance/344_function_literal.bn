package "main"

// Slice A.7 of plan-function-values: non-capturing function
// literals in expression position. The compiler lifts each literal
// to a synthetic top-level function (`__funclit_<n>`) and emits an
// OP_FUNC_VALUE at the literal's site. Phase 1 disallows captures
// — the type-checker rejects references to enclosing-scope locals.

func apply(f *func(int) int, x int) int {
	return f(x)
}

func main() {
	// Bind to a function-value local.
	var add *func(int, int) int = func(a int, b int) int {
		return a + b
	}
	println(add(3, 4))

	// Pass directly as an argument (coerced through param type).
	println(apply(func(x int) int { return x * 3 }, 5))

	// Multiple literals in the same function — distinct synthetic names.
	var sub *func(int, int) int = func(a int, b int) int { return a - b }
	println(sub(10, 4))

	// Nested literal: inner literal as arg to apply, used inside an outer literal.
	var doubled *func(int) int = func(x int) int {
		return apply(func(y int) int { return y + y }, x)
	}
	println(doubled(11))
}
