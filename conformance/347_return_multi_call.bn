package "main"

import "pkg/bootstrap"

// `return f()` where f is a multi-return function and the outer
// function returns the matching tuple. Exercises the type-checker
// acceptance of the shape and the IR-gen lowering (one OP_CALL +
// one OP_EXTRACT per result + one OP_RETURN), end-to-end.

func divmod(a int, b int) (int, int) {
	return a / b, a % b
}

// Outer with all-scalar tuple: just forward the inner call.
func passScalar(a int, b int) (int, int) {
	return divmod(a, b)
}

// Mixed-arity with a managed-slice result. The inner allocates;
// the outer just forwards. Verifies @[]T flows correctly across
// `return f()` (no extra RefInc/RefDec, no UAF).
func makeNamed(name *[]const char, n int) (int, @[]char) {
	var copy @[]char = make_slice(char, len(name))
	for i := 0; i < len(copy); i++ {
		copy[i] = name[i]
	}
	return n, copy
}

func passManaged(name *[]const char, n int) (int, @[]char) {
	return makeNamed(name, n)
}

func main() {
	var q int
	var r int
	q, r = passScalar(17, 5)
	if q != 3 { println("FAIL passScalar q"); bootstrap.Exit(1) }
	if r != 2 { println("FAIL passScalar r"); bootstrap.Exit(2) }

	var n int
	var s @[]char
	n, s = passManaged("hello", 42)
	if n != 42 { println("FAIL passManaged n"); bootstrap.Exit(3) }
	if len(s) != 5 { println("FAIL passManaged len"); bootstrap.Exit(4) }
	if s[0] != 'h' { println("FAIL passManaged s[0]"); bootstrap.Exit(5) }
	if s[4] != 'o' { println("FAIL passManaged s[4]"); bootstrap.Exit(6) }

	println("PASS")
}
