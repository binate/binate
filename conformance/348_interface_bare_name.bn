package "main"

// Phase 2 / Slice 2.0 of plan-interface-syntax-revision.md: bare
// interface names are not type expressions. The usable forms are
// `*Stringer` (raw interface value) and `@Stringer` (managed
// interface value); writing the bare name as a type must error.

interface Stringer {
	toString() *[]readonly char
}

func main() {
	var s Stringer
	println("ignored")
}
