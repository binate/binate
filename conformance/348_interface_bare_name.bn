package "main"

import "pkg/builtins/testing"

// Bare interface names are not type expressions. The usable forms are
// `*Stringer` (raw interface value) and `@Stringer` (managed
// interface value); writing the bare name as a type must error.

interface Stringer {
	toString() *[]readonly char
}

func main() {
	var s Stringer
	testing.Println("ignored")
}
