package "main"

// Phase 2 / Slice 2.1+2.2 of plan-interface-syntax-revision.md: impl
// declarations parse, type-check, AND satisfy their interfaces. Each
// `impl R : Iface` is paired with a method on R that meets the
// interface's signature requirements; receiver-kind smoothing is
// exercised in the *const V impl (the method is declared on *const V
// but a similar smoothing covers other directions).

interface Stringer {
	toString() *[]const char
}

interface Reader {
	read() int
}

interface Writer {
	write()
}

type T struct {
	x int
}
func (t T) toString() *[]const char { return "" }

type Buf struct {
	n int
}
func (b *Buf) write() { }

type Pipe struct {
	x int
}
func (p *Pipe) read() int { return 0 }
func (p *Pipe) write() { }

type Obj struct {
	v int
}
func (o @Obj) toString() *[]const char { return "" }

type V struct {
	x int
}
func (v *const V) toString() *[]const char { return "" }

impl T : Stringer
impl *Buf : Writer
impl *Pipe : Reader, Writer
impl @Obj : Stringer
impl *const V : Stringer

func main() {
	println("hello")
}
