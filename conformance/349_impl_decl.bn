package "main"

// Phase 2 / Slice 2.1 of plan-interface-syntax-revision.md: impl
// declarations parse and type-check (i.e., the receiver type and
// interface refs resolve). Satisfaction checks (does T actually
// implement the interface methods?) are deferred to a follow-up
// slice — this test only exercises the declaration form.

interface Stringer {
	toString() *[]const char
}

interface Reader {
	read() int
}

interface Writer {
	write()
}

type T struct {
	x int
}

type Buf struct {
	n int
}

type Pipe struct {
	x int
}

type Obj struct {
	v int
}

type V struct {
	x int
}

impl T : Stringer
impl *Buf : Writer
impl *Pipe : Reader, Writer
impl @Obj : Stringer
impl *const V : Stringer

func main() {
	println("hello")
}
