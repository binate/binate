package "main"

import "pkg/builtins/testing"

// Slice 2.1 negative test: the right-hand side of an impl ":" must
// name a declared interface, not a type. Per plan-interface-syntax-
// revision.md, "impl T : U" with U being a struct must error.

type T struct {
	x int
}

type U struct {
	y int
}

impl T : U

func main() {
	testing.Println("ignored")
}
