package "main"

import "pkg/builtins/testing"

// Negative test: the right-hand side of an impl ":" must name a
// declared interface, not a type (spec §11.3 `iface.impl.form`):
// "impl T : U" with U being a struct must error.

type T struct {
	x int
}

type U struct {
	y int
}

impl T : U

func main() {
	testing.Println("ignored")
}
