package "main"

// Slice 2.2 negative test: declaring `impl T : I` requires T to have
// every method I declares. Missing method must error.

interface Stringer {
	toString() *[]readonly char
}

type T struct {
	x int
}

// No `toString` method declared on T — impl must error.

impl T : Stringer

func main() {
	println("ignored")
}
