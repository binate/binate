package "main"

import "pkg/builtins/testing"

// Untyped top-level var declarations: type is inferred from
// the literal initializer.
//   var i = 42        → int
//   var b = true      → bool
//   var s = "hello"   → @[]readonly char
//   var c = 'A'       → char (printed as its byte value)

var i = 42

var b = true

var s = "hello"

var c = 'A'

func main() {
	testing.Println(i)
	testing.Println(b)
	testing.Println(s)
	testing.Println(c)
}
