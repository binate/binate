package "main"

// Untyped top-level var declarations: type is inferred from
// the literal initializer.
//   var i = 42        → int
//   var b = true      → bool
//   var s = "hello"   → @[]const char
//   var c = 'A'       → char (printed as its byte value)

var i = 42
var b = true
var s = "hello"
var c = 'A'

func main() {
	println(i)
	println(b)
	println(s)
	println(c)
}
