package "main"

import "pkg/builtins/testing"

// Top-level var initializers must run before main:
//   - integer literal
//   - bool literal
//   - char-slice (string) literal
//   - inter-global expression (b references a)
//   - reads in main see initialized values

var a int = 5

var b int = a * 10 + 1

var greet @[]readonly char = "hi"

var done bool = true

func main() {
	testing.Println(a)
	testing.Println(b)
	testing.Println(greet)
	testing.Println(done)
}
