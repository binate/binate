package "main"

// Top-level var initializers must run before main:
//   - integer literal
//   - bool literal
//   - char-slice (string) literal
//   - inter-global expression (b references a)
//   - reads in main see initialized values

var a int = 5
var b int = a * 10 + 1
var greet @[]const char = "hi"
var done bool = true

func main() {
	println(a)
	println(b)
	println(greet)
	println(done)
}
