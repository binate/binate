package "main"

import "pkg/builtins/testing"

// End-to-end `*T → *Iface` interface-value construction. The test
// compiles and runs successfully, demonstrating that:
//   - the type-checker accepts `var iv *I = &t`
//   - IR-gen emits OP_IFACE_VALUE with the matching impl's vtable
//   - codegen produces a 2-word `{data, vtable}` value
// This test stops at construction; method dispatch through the
// interface value is exercised separately.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {}

impl *T : I

func main() {
	var t T
	var iv *I = &t
	_ = iv
	testing.Println("ok")
}
