package "main"

// Slice 2.3a-2 of plan-interface-syntax-revision.md: end-to-end
// `*T → *Iface` interface-value construction. The test compiles
// and runs successfully, demonstrating that:
//   - the type-checker accepts `var iv *I = &t`
//   - IR-gen emits OP_IFACE_VALUE with the matching impl's vtable
//   - codegen produces a 2-word `{data, vtable}` value
// Method dispatch through the interface value is Slice 2.3a-3 —
// this test stops at construction.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var iv *I = &t
	_ = iv
	println("ok")
}
