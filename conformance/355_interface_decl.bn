package "main"

// Phase 1 of plan-interface-syntax-revision.md: interface declarations
// parse and type-check. Bare interface names are NOT yet usable as
// type expressions — that lands in a follow-up slice. This test only
// exercises the declaration form.

interface Stringer {
	toString() *[]readonly char
}

interface Comparator {
	compare(a int, b int) int
	equal(a int, b int) bool
}

interface Empty {
}

interface MultiReturn {
	pair() (int, int)
}

func main() {
	println("hello")
}
