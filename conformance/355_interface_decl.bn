package "main"

import "pkg/builtins/testing"

// Interface declarations parse and type-check. This test only exercises the
// declaration form (a bare interface name is not a value type; interface
// values are `*Iface` / `@Iface` — spec §11.2 `iface.value.spelling`).

interface Stringer {
	toString() *[]readonly char
}

interface Comparator {
	compare(a int, b int) int
	equal(a int, b int) bool
}

interface Empty {}

interface MultiReturn {
	pair() (int, int)
}

func main() {
	testing.Println("hello")
}
