package "main"

// Slice 2.3a-2 of plan-interface-syntax-revision.md: managed-as-raw
// — `@T → *Iface` works at the data slot (managed pointers can be
// used wherever a raw pointer fits). The interface value's data ptr
// borrows the @T's payload without bumping its refcount; the @T
// stays alive for the duration of the surrounding scope, so the
// interface value sees a valid pointer. Refcount-aware @Iface
// construction is Slice 2.3b.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t @T = make(T)
	var iv *I = t
	_ = iv
	println("ok")
}
