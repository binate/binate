package "main"

// Managed-as-raw: `@T → *Iface` works at the data slot (managed
// pointers can be used wherever a raw pointer fits). The interface
// value's data ptr borrows the @T's payload without bumping its
// refcount; the @T stays alive for the duration of the surrounding
// scope, so the interface value sees a valid pointer. Refcount-aware
// @Iface construction is handled separately.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t @T = make(T)
	var iv *I = t
	_ = iv
	println("ok")
}
