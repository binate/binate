package "main"

import "pkg/builtins/testing"

// End-to-end method dispatch through `*Iface`. The test constructs an interface
// value from `&t`, calls a method on it, and observes the printed
// side effect. The dispatch goes through the vtable: extract
// data + vtable from the interface value, GEP into the vtable,
// load the function pointer, bitcast, indirect-call with the data
// as receiver.

interface Greeter {
	greet()
}

type Hello struct {
	x int
}

func (h *Hello) greet() {
	testing.Println("hello from impl")
}

impl *Hello : Greeter

func main() {
	var h Hello
	var iv *Greeter = &h
	iv.greet()
}
