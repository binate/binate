package "main"

import "pkg/builtins/testing"

// Slice 2.3a-3 follow-on: dispatch with arguments + return value.
// Confirms the codegen correctly types the i8* receiver alongside
// regular args and threads the result back to the caller.

interface Adder {
	add(x int, y int) int
}

type IntAdder struct {
	bias int
}

func (a *IntAdder) add(x int, y int) int {
	return a.bias + x + y
}

impl *IntAdder : Adder

func main() {
	var a IntAdder = IntAdder{bias: 100}
	var iv *Adder = &a
	var r int = iv.add(3, 4)
	if r == 107 {
		testing.Println("ok")
	} else {
		testing.Println("fail")
	}
}
