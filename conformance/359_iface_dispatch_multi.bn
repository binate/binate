package "main"

import "pkg/builtins/testing"

// Slice 2.3a-3 follow-on: multi-method interface dispatch verifies
// each call indexes into the correct vtable slot. Without correct
// slot ordering, calling iv.b() would actually call a().

interface AB {
	a() int
	b() int
}

type T struct {
	x int
}

func (t *T) a() int { return 1 }

func (t *T) b() int { return 2 }

impl *T : AB

func main() {
	var t T
	var iv *AB = &t
	if iv.a() == 1 && iv.b() == 2 {
		testing.Println("ok")
	} else {
		testing.Println("slot mismatch")
	}
}
