package "main"

// `*Iface` flows through function-call args. The construction wrap fires
// at the call site so the argument arrives as a 2-word interface
// value, not a bare pointer.

interface Greeter {
	greet()
}

type Hello struct {
	x int
}

func (h *Hello) greet() {
	println("hi")
}

impl *Hello : Greeter

func use(g *Greeter) {
	g.greet()
}

func main() {
	var h Hello
	use(&h)
}
