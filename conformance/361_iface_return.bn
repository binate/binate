package "main"

import "pkg/builtins/testing"

// Slice 2.3a-4: `*Iface` flows through return values. The wrap
// fires at the return statement so the caller receives a properly
// formed interface value.

interface Greeter {
	greet()
}

type Hello struct {
	x int
}

func (h *Hello) greet() {
	testing.Println("hi")
}

impl *Hello : Greeter

func makeIface(h *Hello) *Greeter {
	return h
}

func main() {
	var h Hello
	var iv *Greeter = makeIface(&h)
	iv.greet()
}
