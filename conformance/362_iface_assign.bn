package "main"

// Slice 2.3a-4: assigning a `*T` / `@T` to an existing `*Iface`
// variable wraps it in the interface value. Distinct from
// var-decl-with-init, this exercises the plain-assignment path.

interface Greeter {
	greet()
}

type Hello struct {
	x int
}

func (h *Hello) greet() {
	println("hi")
}

impl *Hello : Greeter

func main() {
	var h Hello
	var iv *Greeter
	iv = &h
	iv.greet()
}
