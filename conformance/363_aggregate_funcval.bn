package "main"

import "pkg/builtins/testing"

// Aggregate-return function value: compiled call should ABI-correctly
// receive the 32-byte struct via the function-value vtable.call shim.
// Phase 3's emitCallFuncValue bitcasts the call slot to the typed
// signature `<ret>(i8*, args...)*` — for an aggregate <ret>, LLVM's
// ABI lowering of the typed call should handle the struct return.

type Point struct {
	X int
	Y int
	Z int
	W int
}

func makePoint(a int, b int) Point {
	var p Point
	p.X = a
	p.Y = b
	p.Z = a + b
	p.W = a * b
	return p
}

func main() {
	var f *func(int, int) Point = makePoint
	var p Point = f(7, 5)
	testing.Println(p.X)
	testing.Println(p.Y)
	testing.Println(p.Z)
	testing.Println(p.W)
}
