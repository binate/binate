package "main"

import "pkg/builtins/testing"

// Aggregate-return function value: compiled call should ABI-correctly
// receive the 32-byte struct via the function-value vtable.call shim.
// For an aggregate return the shim takes a retbuf —
// `void(i8* retbuf, i8* data, args...)` — which the caller allocates
// on its stack and loads the result back from.

type Point struct {
	X int
	Y int
	Z int
	W int
}

func makePoint(a int, b int) Point {
	var p Point
	p.X = a
	p.Y = b
	p.Z = a + b
	p.W = a * b
	return p
}

func main() {
	var f *func(int, int) Point = makePoint
	var p Point = f(7, 5)
	testing.Println(p.X)
	testing.Println(p.Y)
	testing.Println(p.Z)
	testing.Println(p.W)
}
