package "main"

// Function value with a slice-typed argument.  Probes whether
// emitCallFuncValue's call-site convention matches the shim's
// signature when the function takes a 16-byte slice value.

func count(s *[]readonly char) int {
	var n int = 0
	for i := 0; i < len(s); i++ { n = n + 1 }
	return n
}

func main() {
	var f *func(*[]readonly char) int = count
	var s *[]readonly char = "hello"
	println(f(s))
}
