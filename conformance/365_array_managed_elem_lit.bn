package "main"

import "pkg/builtins/testing"

// Array literal with managed-slice elements (`[N]@[]char{...}`)
// where each element is a string literal.  Each string becomes a
// fresh @[]char stored in the array, and every element reads back
// with its contents and length (not as an empty managed-slice
// header, data=nil, len=0).

func main() {
	var arr [3]@[]char = [3]@[]char{"alpha", "beta", "gamma"}
	testing.Println(arr[0])
	testing.Println(arr[1])
	testing.Println(arr[2])
	testing.Println(len(arr[0]))
	testing.Println(len(arr[1]))
	testing.Println(len(arr[2]))
}
