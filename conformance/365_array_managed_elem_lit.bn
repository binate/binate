package "main"

import "pkg/builtins/testing"

// Array literal with managed-slice elements (`[N]@[]char{...}`)
// where each element is a string literal.  Bootstrap converts each
// string to a fresh @[]char and stores it in the array.  bnc
// currently does NOT — the array's elements are read back as
// empty managed-slice headers (data=nil, len=0).  Tracked in
// claude-todo.md "Array of managed-slice elements: store / read
// broken in bnc".  xfailed in builder-comp / builder-comp-int / etc.
// until the codegen path is fixed.

func main() {
	var arr [3]@[]char = [3]@[]char{"alpha", "beta", "gamma"}
	testing.Println(arr[0])
	testing.Println(arr[1])
	testing.Println(arr[2])
	testing.Println(len(arr[0]))
	testing.Println(len(arr[1]))
	testing.Println(len(arr[2]))
}
