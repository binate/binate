package "main"

// Slice 2.3b of plan-interface-syntax-revision.md: `@Iface` (managed
// interface value). The data slot is a managed pointer; the iv
// owns its own ref so it can outlive the source @T. This first
// cut exercises construction + dispatch; refcount-aware cleanup
// (RefDec on the data field at scope exit) is a follow-up.

interface Greeter {
	greet()
}

type Hello struct {
	x int
}

func (h *Hello) greet() {
	println("hi from managed")
}

impl *Hello : Greeter

func main() {
	var h @Hello = make(Hello)
	var iv @Greeter = h
	iv.greet()
}
