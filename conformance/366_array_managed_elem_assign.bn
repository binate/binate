package "main"

// Indexed assignment to an array of managed-slice elements
// (`var arr [N]@[]char; arr[i] = "x"`).  Bootstrap stores each
// string literal as a fresh @[]char in the array slot.  bnc
// currently segfaults when reading the slot back (likely an
// uninitialized array slot interpreted as a refcounted backing,
// or a refcount-handling miscompile on the indexed store).
// Tracked in claude-todo.md.  xfailed in boot-comp /
// boot-comp-int / etc. until fixed.

func main() {
	var arr [3]@[]char
	arr[0] = "alpha"
	arr[1] = "beta"
	arr[2] = "gamma"
	println(arr[0])
	println(arr[1])
	println(arr[2])
}
