package "main"

import "pkg/builtins/testing"

// Indexed assignment to an array of managed-slice elements
// (`var arr [N]@[]char; arr[i] = "x"`).  Each string literal is
// stored as a fresh @[]char in the array slot and reads back
// intact.

func main() {
	var arr [3]@[]char
	arr[0] = "alpha"
	arr[1] = "beta"
	arr[2] = "gamma"
	testing.Println(arr[0])
	testing.Println(arr[1])
	testing.Println(arr[2])
}
