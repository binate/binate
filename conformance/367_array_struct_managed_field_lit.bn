package "main"

// Array literal of struct-with-managed-field (`[N]S{...}` where
// `S` has a managed field).  Bootstrap initializes each managed
// field properly; bnc currently does not — the managed field
// reads back as zero.  Tracked in claude-todo.md "Array of
// struct-with-managed-field: store / read broken in bnc".
// xfailed in builder-comp / builder-comp-int / etc. until the codegen
// path is fixed.

type Pair struct {
	Name @[]char
	Val  int
}

func main() {
	var arr [3]Pair = [3]Pair{Pair{"alpha", 1}, Pair{"beta", 2}, Pair{"gamma", 3}}
	println(arr[0].Name)
	println(arr[0].Val)
	println(arr[1].Name)
	println(arr[2].Val)
}
