package "main"

import "pkg/builtins/testing"

// Array literal of struct-with-managed-field (`[N]S{...}` where
// `S` has a managed field).  Each element's managed field is
// initialized and reads back intact (not as zero).

type Pair struct {
	Name @[]char
	Val  int
}

func main() {
	var arr [3]Pair = [3]Pair{Pair{"alpha", 1}, Pair{"beta", 2}, Pair{"gamma", 3}}
	testing.Println(arr[0].Name)
	testing.Println(arr[0].Val)
	testing.Println(arr[1].Name)
	testing.Println(arr[2].Val)
}
