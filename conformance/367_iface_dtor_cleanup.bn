package "main"

import "pkg/rt"

// Slice 2.5b of plan-interface-syntax-revision.md: when an @Iface
// goes out of scope and is the last holder of its underlying data,
// the receiver type's struct destructor must run so any managed
// fields inside the receiver get RefDec'd. Without the dtor wiring,
// rt.Free runs on the receiver but the Inner @Inner field leaks.

interface Tagged {
	tag() int
}

type Inner struct {
	Val int
}

type Holder struct {
	Tag   int
	Inner @Inner
}

func (h *Holder) tag() int {
	return h.Tag
}

impl *Holder : Tagged

func makeHolder(inner @Inner) @Holder {
	var h @Holder = make(Holder)
	h.Inner = inner
	h.Tag = 42
	return h
}

func consume(t @Tagged) {
	print("tag=")
	println(t.tag())
}

func main() {
	var inner @Inner = make(Inner)
	inner.Val = 7
	var ptr *uint8 = bit_cast(*uint8, inner)

	print("rc before: ")
	println(rt.Refcount(ptr))

	consume(makeHolder(inner))

	print("rc after: ")
	println(rt.Refcount(ptr))
}
