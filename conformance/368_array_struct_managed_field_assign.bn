package "main"

// Indexed assignment to an array of struct-with-managed-field
// (`var arr [N]S; arr[i] = S{...}` where `S` has a managed field).
// Bootstrap initializes each managed field properly; bnc currently
// does not — the managed field reads back as zero.  Tracked in
// claude-todo.md.  xfailed in boot-comp / boot-comp-int / etc.

type Pair struct {
	Name @[]char
	Val  int
}

func main() {
	var arr [2]Pair
	arr[0] = Pair{"hello", 10}
	arr[1] = Pair{"world", 20}
	println(arr[0].Name)
	println(arr[0].Val)
	println(arr[1].Name)
	println(arr[1].Val)
}
