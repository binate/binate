package "main"

import "pkg/builtins/testing"

// `@Iface` (managed interface value). The data slot is a managed
// pointer; the iv owns its own ref so it can outlive the source @T.
// This test exercises construction + dispatch (scope-exit cleanup of
// an @Iface's data is covered by 383).

interface Greeter {
	greet()
}

type Hello struct {
	x int
}

func (h *Hello) greet() {
	testing.Println("hi from managed")
}

impl *Hello : Greeter

func main() {
	var h @Hello = make(Hello)
	var iv @Greeter = h
	iv.greet()
}
