package "main"

import "pkg/builtins/testing"

// Interface aliases.
// `interface MyStringer = Stringer` creates a nominal-equivalent
// alias — usable wherever the target interface is. `impl T :
// MyStringer` is indistinguishable from `impl T : Stringer`, and
// methods can be dispatched through either name.

interface Greeter {
	greet()
}

interface Hi = Greeter

type Hello struct {
	x int
}

func (h *Hello) greet() {
	testing.Println("hi via alias")
}

impl *Hello : Hi

func main() {
	var h Hello
	var iv *Hi = &h
	iv.greet()
}
