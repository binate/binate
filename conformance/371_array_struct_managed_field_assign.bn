package "main"

import "pkg/builtins/testing"

// Indexed assignment to an array of struct-with-managed-field
// (`var arr [N]S; arr[i] = S{...}` where `S` has a managed field).
// Each element's managed field is stored and reads back intact
// (not as zero).

type Pair struct {
	Name @[]char
	Val  int
}

func main() {
	var arr [2]Pair
	arr[0] = Pair{"hello", 10}
	arr[1] = Pair{"world", 20}
	testing.Println(arr[0].Name)
	testing.Println(arr[0].Val)
	testing.Println(arr[1].Name)
	testing.Println(arr[1].Val)
}
