package "main"

import "pkg/greeter"

// Slice 2.7 of plan-cross-package-interfaces.md: a `*pkg.Iface`
// reference type-checks and dispatches correctly when the impl
// lives in the importing package. The Greeter interface is
// declared in pkg/greeter; the impl + receiver type live here in
// main; the iv is constructed and used from main as well.

type Hello struct {
	x int
}

func (h *Hello) greet() {
	println("hi from cross-pkg")
}

impl *Hello : greeter.Greeter

func main() {
	var h Hello
	var iv *greeter.Greeter = &h
	iv.greet()
}
