package "main"

import "pkg/builtins/testing"

// Managed-slice composite literal `@[]@[]char{"a","b","c"}` —
// each element is a string literal that should convert to a
// fresh @[]char.  genManagedSliceLit must run EmitStringToChars
// on string-literal elements when the element type is a
// char-slice; otherwise the per-element store writes only the
// bare data pointer (8 bytes) into the 32-byte managed-slice
// element slot — len reads back as 0, printing empty lines.

func main() {
	var args @[]@[]char = @[]@[]char{"alpha", "beta", "gamma"}
	testing.Println(len(args))
	testing.Println(args[0])
	testing.Println(args[1])
	testing.Println(args[2])
}
