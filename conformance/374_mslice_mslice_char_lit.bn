package "main"

import "pkg/builtins/testing"

// Managed-slice composite literal `@[]@[]char{"a","b","c"}` —
// each element is a string literal that should convert to a
// fresh @[]char.  Pre-fix: bnc's genManagedSliceLit didn't run
// EmitStringToChars on string-literal elements when the element
// type was a char-slice, so the per-element store wrote only the
// bare data pointer (8 bytes) into the 32-byte managed-slice
// element slot — len read back as 0, println printed empty lines.
// xfailed in boot (bootstrap doesn't recognize @[]@[]char{...}
// literal, same as 300_managed_slice_lit / 304_raw_slice_lit_const).

func main() {
	var args @[]@[]char = @[]@[]char{"alpha", "beta", "gamma"}
	testing.Println(len(args))
	testing.Println(args[0])
	testing.Println(args[1])
	testing.Println(args[2])
}
