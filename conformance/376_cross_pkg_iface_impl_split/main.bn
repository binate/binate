package "main"

import "pkg/greeter"
import "pkg/hello"

// Cross-package interface impl split: the iface lives in
// pkg/greeter, the receiver type and impl declaration live in
// pkg/hello, and the use site here in main constructs the iv and
// dispatches through it. The risk is that IR-gen here can't find the
// vtable name because m.Impls only sees this TU's impls.

func main() {
	var h hello.Hello
	var iv *greeter.Greeter = &h
	iv.greet()
}
