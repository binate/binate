package "main"

import "pkg/greeter"
import "pkg/hello"

// Slice 2.8 of plan-cross-package-interfaces.md: the iface lives in
// pkg/greeter, the receiver type and impl declaration live in
// pkg/hello, and the use site here in main constructs the iv and
// dispatches through it. Pre-2.8, IR-gen here can't find the
// vtable name because m.Impls only sees this TU's impls.

func main() {
	var h hello.Hello
	var iv *greeter.Greeter = &h
	iv.greet()
}
