package "main"

import "pkg/greeter"
import "pkg/hello"

// Slice 2.9: the impl declaration lives in main (the use site),
// neither in the iface's package (greeter) nor in the receiver's
// package (hello). Duplicate-OK: the receiver and its method are
// authoritatively declared in pkg/hello, the iface in pkg/greeter,
// and main asserts the satisfaction.

impl *hello.Hello : greeter.Greeter

func main() {
	var h hello.Hello
	var iv *greeter.Greeter = &h
	iv.greet()
}
