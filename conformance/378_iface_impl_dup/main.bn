package "main"

import "pkg/greeter"
import "pkg/hello"
import "pkg/dup"

// Both pkg/hello and pkg/dup declare `impl *hello.Hello :
// greeter.Greeter`. With weak_odr linkage on the vtable, the
// linker keeps one.

func main() {
	dup.Touch()
	var h hello.Hello
	var iv *greeter.Greeter = &h
	iv.greet()
}
