package "pkg/dup"

import "pkg/greeter"
import "pkg/hello"

// Slice 2.9: this package independently declares the same impl
// that pkg/hello declares. Both TUs emit a `weak_odr` vtable for
// `(*hello.Hello, greeter.Greeter)` with identical contents; the
// linker keeps one. No "duplicate impl" error from the type-
// checker.
impl *hello.Hello : greeter.Greeter

func Touch() { }
