package "main"

// iface.construct.value-borrow: constructing a raw `*Iface` from an ADDRESSABLE
// value source is admitted via an implicit `&` -- `var iv *I = t` is exactly
// `var iv *I = &t`, the same borrow.  Both spellings share the source's storage.

interface I {
	foo() int
}

type T struct {
	x int
}

func (t *T) foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 7
	var iv *I = t   // implicit borrow
	var iv2 *I = &t // explicit -- identical
	println(iv.foo())  // 7
	println(iv2.foo()) // 7
}
