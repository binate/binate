package "main"

// Plan-interface-syntax-revision.md construction-site rule:
// `T → *Iface` requires explicit `&t`. The interface value can
// outlive the source's storage, so the address-of is the user's
// explicit decision rather than an implicit conversion.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var iv *I = t
	_ = iv
}
