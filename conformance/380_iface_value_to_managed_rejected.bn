package "main"

// Plan-interface-syntax-revision.md construction-site rule:
// `T → @Iface` is rejected — there's no implicit boxing. The
// user must write `box(t)` to lift T to @T first.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var iv @I = t
	_ = iv
}
