package "main"

// Plan-interface-syntax-revision.md construction-site rule:
// `*T → @Iface` is rejected — *T has no refcount header, so it
// can't promote to a managed iface value (which owns its data
// ref via RefInc on the underlying pointer).

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var p *T = &t
	var iv @I = p
	_ = iv
}
