package "main"

import "pkg/greeter"
import "pkg/hello"

// Cross-package @Iface (managed): the iface lives in pkg/greeter,
// the receiver type and impl in pkg/hello, and main constructs an
// @greeter.Greeter via @T → @Iface and dispatches through it.
// Exercises the construction-site RefInc + scope-exit RefDec
// across package boundaries.

func main() {
	var h @hello.Hello = make(hello.Hello)
	var iv @greeter.Greeter = h
	iv.greet()
}
