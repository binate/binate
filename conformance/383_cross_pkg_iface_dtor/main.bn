package "main"

import "pkg/builtins/rt"
import "pkg/greeter"
import "pkg/hello"

// Cross-package + Slice 2.5b dtor wiring: when an @Iface goes out
// of scope as the last holder of its data, the receiver type's
// destructor must run (RefDec'ing managed fields). Tests that the
// vtable's slot-0 dtor is correctly populated AND extracted at
// scope-exit even when the receiver type and impl live in a
// different package than the use site.

func consume(t @greeter.Tagged) {
	print("tag=")
	println(t.tag())
}

func main() {
	var inner @hello.Inner = make(hello.Inner)
	inner.v = 7
	var ptr *uint8 = bit_cast(*uint8, inner)

	print("rc before: ")
	println(rt.Refcount(ptr))

	consume(hello.MakeHolder(inner))

	print("rc after: ")
	println(rt.Refcount(ptr))
}
