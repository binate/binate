package "main"

import "pkg/greeter"
import "pkg/hello"

// Cross-package interface alias: pkg/aliases declares
// `interface Hello = greeter.Greeter`. pkg/hello's impl is
// declared on aliases.Hello. main constructs an iv via the
// CANONICAL form (*greeter.Greeter) — alias resolution must
// converge so the vtable symbol matches what hello emitted.

func main() {
	var h hello.Hello
	var iv *greeter.Greeter = &h
	iv.greet()
}
