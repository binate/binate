package "pkg/hello"

import "pkg/aliases"

type Hello struct {
	x int
}

func (h *Hello) greet()

// The impl is declared on the alias name (aliases.Hello), but
// canonical mangling resolves through the alias chain to
// greeter.Greeter — so the vtable symbol matches what main would
// produce if it constructed an *greeter.Greeter directly.
impl *Hello : aliases.Hello
