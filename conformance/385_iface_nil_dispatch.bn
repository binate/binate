package "main"

// `var iv *I` (no init) zero-inits the iv (both halves null) per
// the language design rule for nillable types — same precedent as
// `var p *T`, `var f *func()`, etc. Dispatching through the nil
// iv loads slot 1 (vtable) as null, GEPs through it, and SEGVs.
// The test pins this: the program prints "before", then SEGVs on
// the dispatch — output stops there. If the no-init zero
// guarantee regresses (alloca becomes undef and the optimizer
// "succeeds" the dispatch via UB), the program would print
// "after" too and the .expected mismatch would catch it.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {
	println("foo")
}

impl *T : I

func main() {
	println("before")
	var iv *I
	iv.foo()
	println("after")
}
