package "main"

// VM-mode counterpart to 385: iv[1] is now 1-based, so a zero-
// initialized iv (iv[1] == 0) is detected at BC_CALL_IFACE_METHOD
// dispatch and the VM panics with a clear message rather than
// dispatching through vtable 0 silently. The compiled side gets
// the same protection via the deterministic null-vtable SEGV
// (test 385); this test pins the VM-side message specifically.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {
	println("foo")
}

impl *T : I

func main() {
	println("before")
	var iv *I
	iv.foo()
	println("after")
}
