package "main"

import "pkg/builtins/testing"

// VM-mode counterpart to 385: iv[1] is 1-based, so a zero-initialized iv
// (iv[1] == 0) is detected at the interface-method dispatch and raises a
// RECOVERABLE user-code fault (Plan 2) rather than dispatching through vtable 0
// silently: the VM unwinds to the host, which prints the message and exits
// non-zero (`runtime error: call of nil interface value`). The compiled side
// gets the same protection via the deterministic null-vtable SEGV (test 385,
// still fatal); this test pins the VM-side message specifically.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {
	testing.Println("foo")
}

impl *T : I

func main() {
	testing.Println("before")
	var iv *I
	iv.foo()
	testing.Println("after")
}
