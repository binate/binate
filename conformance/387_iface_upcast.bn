package "main"

// Explicit `*Child → *Parent` upcast preserves the data ptr and
// swaps the vtable to the parent's, so a method declared on the
// parent dispatches correctly through the parent-typed view.
// Combined with the inherited-method dispatch, this confirms the
// end-to-end concat-vtable layout works at every dispatch site.

interface Closer {
	Close()
}

interface RC : Closer {
	Read() int
}

type T struct {
	x int
}

func (t *T) Close() {
	println("close")
}

func (t *T) Read() int {
	return 42
}

impl *T : RC

func main() {
	var t T
	var rc *RC = &t
	// Inherited dispatch through *RC (Close is from Closer).
	rc.Close()
	var n int = rc.Read()
	println(n)
	// Explicit upcast to *Closer — vtable swap, same data ptr.
	var c *Closer = rc
	// Direct dispatch through *Closer hits the (R, Closer) vtable.
	c.Close()
	println("done")
}
