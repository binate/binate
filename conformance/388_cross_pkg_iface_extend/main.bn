package "main"

import "pkg/closer"

// plan-interface-embedding.md Slice E.5: an interface declared
// here can extend an interface declared in another package.
// The (R, Closer) vtable is emitted transitively (Slice E.3)
// when `impl *T : RC` is processed, and inherited dispatch /
// upcast (Slice E.4) work the same as for same-package extension.

interface RC : closer.Closer {
	Read() int
}

type T struct {
	x int
}

func (t *T) Close() {
	println("close")
}

func (t *T) Read() int {
	return 42
}

impl *T : RC

func main() {
	var t T
	var rc *RC = &t
	// Inherited dispatch through *RC — Close lives in pkg/closer.
	rc.Close()
	var n int = rc.Read()
	println(n)
	// Explicit upcast across the package boundary: *RC → *closer.Closer.
	var c *closer.Closer = rc
	c.Close()
}
