package "main"

// End-to-end exercise of `Self` in
// interface declarations.  Covers the parser+AST (Self
// parses as a type expression), the type-checker substrate
// (Self accepted in interface method args/results, impl
// validation substitutes Self with the implementing type),
// and the codegen path (no special handling — by IR-gen
// time, every Self has been substituted by the impl
// receiver type, so the IR sees ordinary func types).
//
// The Self-using method (Equals) is dispatched directly via
// the named-type method-call path, where T is statically
// known.  Calling it through a *Eq interface value is
// rejected at type-check time — see
// 390_err_self_iv_call.
//
// The non-Self method (Name) on the same interface IS
// callable through the iv, confirming the per-method (not
// per-interface) rejection.

interface Mixed {
	Name() int
	Equals(other Self) bool
}

type T struct {
	x int
}

func (a *T) Name() int {
	return a.x
}

// Self in the interface substitutes to T at impl-collection
// time, so the impl writes `b T` directly.
func (a *T) Equals(b T) bool {
	return a.x == b.x
}

impl *T : Mixed

func main() {
	var a T
	a.x = 7
	var b T
	b.x = 7
	var c T
	c.x = 99

	// Direct call via the named-type method path: Self
	// resolves to the concrete T at the impl site.
	if a.Equals(b) {
		println("eq")
	}
	if !a.Equals(c) {
		println("neq")
	}

	// Non-Self sibling method on the same interface is
	// callable through the iv (per-method rejection).
	var iv *Mixed = &a
	println(iv.Name())
}
