package "main"

// plan-interface-embedding.md Slice E.5: 3-level interface
// extension (C : B, B : A). Dispatching `c.fA()` through *C
// reaches A's method via two nested concat-vtable layers — A's
// full vtable inside B's full vtable inside (T, C)'s vtable.

interface A {
	fA() int
}

interface B : A {
	fB() int
}

interface C : B {
	fC() int
}

type T struct {
	x int
}

func (t *T) fA() int {
	return 1
}

func (t *T) fB() int {
	return 2
}

func (t *T) fC() int {
	return 3
}

impl *T : C

func main() {
	var t T
	var c *C = &t
	println(c.fA())
	println(c.fB())
	println(c.fC())
}
