package "main"

// plan-self-type.md S.3: a method whose interface-side
// signature uses `Self` is object-unsafe — callable only
// through a generic constraint where T is statically known,
// not through an interface value where the receiver's
// concrete type has been erased.  The type checker rejects
// the call.

interface Eq {
	Equals(other Self) bool
}

type T struct {
	x int
}

func (a *T) Equals(b T) bool {
	return a.x == b.x
}

impl *T : Eq

func main() {
	var t T
	var u T
	var iv *Eq = &t
	var _ bool = iv.Equals(u)
}
