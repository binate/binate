package "main"
import "pkg/builtins/testing"

import "pkg/alpha/widget"
import "pkg/mid"

// Regression: two packages that share a last path segment
// (pkg/alpha/widget and pkg/beta/widget, both last-segment "widget")
// must mangle to distinct linker symbols.  Under the old
// last-segment mangling both Code() functions became bn_widget__Code
// and collided; full-path mangling gives them distinct symbols.
// alpha/widget is imported here directly; beta/widget is reached
// through pkg/mid — so both symbols land in the final binary, which
// is what triggers the collision.

func main() {
	testing.Println(widget.Code())
	testing.Println(mid.BetaCode())
}
