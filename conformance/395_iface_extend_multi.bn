package "main"

import "pkg/builtins/testing"

// An interface extends
// multiple parents. The (R, RC) vtable lays Reader's full vtable
// first, then Closer's, then RC's own methods (none here) — so
// dispatch through *RC for Read or Close finds the right slot in
// either nested sub-vtable.

interface Reader {
	Read() int
}

interface Closer {
	Close()
}

interface RC : Reader, Closer {}

type T struct {
	x int
}

func (t *T) Read() int {
	return 7
}

func (t *T) Close() {
	testing.Println("close")
}

impl *T : RC

func main() {
	var t T
	var rc *RC = &t
	testing.Println(rc.Read())
	rc.Close()
}
