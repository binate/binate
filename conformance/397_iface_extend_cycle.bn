package "main"

// Interface extension cycles are statically impossible because parents are
// resolved at decl time. `interface A : B` here surfaces as an
// "undefined" error at the point A is checked — B isn't declared
// yet. The subsequent `interface B : A` would resolve A fine
// (forward-only reference), so the failure is asymmetric.

interface A : B {
}

interface B : A {
}

func main() {
	println("ignored")
}
