package "main"

import "pkg/builtins/testing"

// An interface extension cycle (`A : B` + `B : A`) is rejected.  A parent may
// be declared after its child, so A's parent B resolves; the edge B → A would
// close the cycle and is reported.

interface A : B {}

interface B : A {}

func main() {
	testing.Println("ignored")
}
