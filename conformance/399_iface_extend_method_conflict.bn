package "main"

// plan-interface-embedding.md Slice E.5 negative: two parents
// declare a same-named method with different signatures. The
// extending interface can't carry both, so the type checker
// rejects at decl time. Same-name same-signature across parents
// (diamond inheritance) is fine and is exercised by the pkg/binate/types
// unit tests.

interface P {
	foo()
}

interface Q {
	foo() int
}

interface X : P, Q {
}

func main() {
	println("ignored")
}
