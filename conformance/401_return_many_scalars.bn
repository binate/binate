package "main"

// Multi-return functions returning enough scalar values to exercise
// both OP_RETURN pack-into-X0..X7 path (≤64 bytes total) and the
// sret-via-X8 path (>64 bytes).  Each return value comes from a
// distinct local so the IR uses getOperand-from-spill per arg —
// the shape that saturated the X9..X15 scratch pool in the native
// AArch64 backend before the per-arg `rm.ResetRegs()` fix and the
// X9..X17 pool extension (binate `d0e8a41`, `e7f6b1d`).
//
// Both LLVM and native backends must produce the same observable
// values; this catches silent miscompiles (e.g. a pool slot
// accidentally aliased to another scratch).

// eightReturns hits the pack-into-X0..X7 path: 8 * 8 = 64 bytes
// fits exactly, so emitReturn loads each value via getOperand and
// movs into argReg(0..7).  Pre-fix, the 8th getOperand panicked at
// pool slot 7.
func eightReturns(seed int) (int, int, int, int, int, int, int, int) {
	var a int = seed + 1
	var b int = seed + 2
	var c int = seed + 3
	var d int = seed + 4
	var e int = seed + 5
	var f int = seed + 6
	var g int = seed + 7
	var h int = seed + 8
	return a, b, c, d, e, f, g, h
}

// nineReturns hits the sret-via-X8 path: 9 * 8 = 72 bytes > 64, so
// the caller stashes a result-buffer pointer in X8 and emitReturn
// writes each value through it at the multi-return-tuple field
// offset.  Pre-fix, the sret-path loop also saturated the pool.
func nineReturns(seed int) (int, int, int, int, int, int, int, int, int) {
	var a int = seed * 2 + 1
	var b int = seed * 2 + 2
	var c int = seed * 2 + 3
	var d int = seed * 2 + 4
	var e int = seed * 2 + 5
	var f int = seed * 2 + 6
	var g int = seed * 2 + 7
	var h int = seed * 2 + 8
	var i int = seed * 2 + 9
	return a, b, c, d, e, f, g, h, i
}

func main() {
	var a int
	var b int
	var c int
	var d int
	var e int
	var f int
	var g int
	var h int
	a, b, c, d, e, f, g, h = eightReturns(10)
	if a != 11 { println("FAIL eight a"); return }
	if b != 12 { println("FAIL eight b"); return }
	if c != 13 { println("FAIL eight c"); return }
	if d != 14 { println("FAIL eight d"); return }
	if e != 15 { println("FAIL eight e"); return }
	if f != 16 { println("FAIL eight f"); return }
	if g != 17 { println("FAIL eight g"); return }
	if h != 18 { println("FAIL eight h"); return }

	var a9 int
	var b9 int
	var c9 int
	var d9 int
	var e9 int
	var f9 int
	var g9 int
	var h9 int
	var i9 int
	a9, b9, c9, d9, e9, f9, g9, h9, i9 = nineReturns(100)
	if a9 != 201 { println("FAIL nine a"); return }
	if b9 != 202 { println("FAIL nine b"); return }
	if c9 != 203 { println("FAIL nine c"); return }
	if d9 != 204 { println("FAIL nine d"); return }
	if e9 != 205 { println("FAIL nine e"); return }
	if f9 != 206 { println("FAIL nine f"); return }
	if g9 != 207 { println("FAIL nine g"); return }
	if h9 != 208 { println("FAIL nine h"); return }
	if i9 != 209 { println("FAIL nine i"); return }

	println("PASS")
}
