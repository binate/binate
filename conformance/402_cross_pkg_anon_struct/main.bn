package "main"

import "pkg/point"

// Cross-package anonymous-struct equivalence: pkg/point returns
// an anonymous `struct { X int; Y int }`, and `main` consumes it
// via a locally-declared variable of the same anonymous shape.
// The structural identity check has to look through the package
// boundary — name is empty on both sides, so equivalence is by
// (field-name, field-type) pairs in order.

func main() {
	var p struct { X int; Y int } = point.MakePoint(5, 11)
	println(p.X)
	println(p.Y)
}
