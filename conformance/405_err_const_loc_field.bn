package "main"

import "pkg/builtins/testing"

// Writing to a struct field through a pointer-to-const-struct
// must be rejected. The const-ness wraps the whole struct, so
// every field becomes an immutable view through `*readonly Pt`.

type Pt struct {
	X int
	Y int
}

func main() {
	var p Pt
	var q *readonly Pt = &p
	q.X = 1
	testing.Println(p.X)
}
