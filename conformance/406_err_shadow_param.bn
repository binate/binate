package "main"

// A `var` declaration in the function body that names a parameter
// is a same-scope redeclaration — params are introduced into the
// function body's scope, so `var x` inside collides with the
// parameter `x`. Nested-block shadowing (a `var x` inside a `{ }`
// inside the function body) is a different scope and is allowed.

func f(x int) {
	var x int = 5
	println(x)
}

func main() {
	f(1)
}
