package "main"

import "pkg/builtins/testing"

// Compound-assignment through a pointer-to-const is a separate
// code path from plain `=` (compound-assign uses `+=`/`*=`/etc.),
// and emits its own error message.

func main() {
	var x int = 5
	var p *readonly int = &x
	*p += 1
	testing.Println(x)
}
