package "main"

import "pkg/builtins/testing"

// Method dispatch through a deref'd pointer-to-iface-value:
// `(*p).Foo()` where `p` is `**I`. getSelectorType handles the
// deref form, so the iv-dispatch path takes over and the call
// goes through the vtable.  An isInterfaceMethodCall that
// inspects only EXPR_IDENT / EXPR_SELECTOR / EXPR_INDEX receivers
// sends a deref (EXPR_UNARY with `*`) to the direct-method-call
// path, which builds an empty method qualname (`@bn_F...`) since
// baseNamedTypeName of an iface-value type is empty.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p **I = &iv
	testing.Println((*p).Foo())
}
