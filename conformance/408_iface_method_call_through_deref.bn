package "main"

// Method dispatch through a deref'd pointer-to-iface-value:
// `(*p).Foo()` where `p` is `**I`. Before the fix, IR-gen's
// isInterfaceMethodCall only inspected EXPR_IDENT / EXPR_SELECTOR
// / EXPR_INDEX receivers — a deref (EXPR_UNARY with `*`) fell
// through to the direct-method-call path, which built an empty
// method qualname (`@bn_main____Foo`) since baseNamedTypeName of
// an iface-value type is empty.  Now getSelectorType handles the
// deref form, so the iv-dispatch path takes over and the call
// goes through the vtable.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p **I = &iv
	println((*p).Foo())
}
