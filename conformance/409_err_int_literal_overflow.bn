package "main"

// Integer literal whose magnitude exceeds 2^64-1.  Per
// claude-notes.md § "Integer literal value range and constant-
// expression arithmetic — DECIDED 2026-05-15", parseable literals
// must fit in the int64 ∪ uint64 union range.  This one — 2^64
// expressed in hex — is one bit beyond uint64-max.

func main() {
	var x uint64 = 0x10000000000000000
	println(cast(int, x))
}
