package "main"

// Interface-value dispatch and value receivers: value-receiver impls
// dispatched through `*Iface` go through a per-(R, I, method)
// thunk that loads the receiver value from the iv data
// pointer.  Without the thunk, the impl method would receive
// the iv data pointer where it expects the value (and reads
// the pointer's address as the value).
//
// Pre-existing iface tests all use pointer receivers, so this
// test pins the thunk path explicitly.  Both the LLVM codegen
// and the bytecode VM go through MethodFuncs entries that point
// at the synthesized __bn_thunk_<method> functions.

interface Doubler {
	Double() int
}

type Wrapper struct {
	v int
}

// VALUE receiver — the line that exercises the thunk path.
// A pointer receiver would dispatch directly without a thunk.
func (w Wrapper) Double() int {
	return w.v * 2
}

impl Wrapper : Doubler

func main() {
	var w Wrapper = Wrapper{v: 21}
	var iv *Doubler = &w
	println(iv.Double())
}
