package "main"

// End-to-end:
// `import "pkg/builtins/lang"` brings in the Stringer interface plus
// the canonical impls for every universe primitive.  Callers
// can dispatch through `*Stringer` for any primitive without
// per-type wrappers.  Both the direct method-call path
// (x.String()) and the iv path (printIt(&x)) are exercised.

import "pkg/builtins/lang"

// printIt accepts any type implementing Stringer — the
// motivating shape that today's println builtin is meant to
// replace eventually (feedback_println_hack.md).
func printIt(s *lang.Stringer) {
	println(s.String())
}

func main() {
	// Direct call — value-receiver method via the named-type
	// path; receiver passed by value.
	var x int = 42
	println(x.String())
	var b bool = true
	println(b.String())

	// Through *lang.Stringer — exercises the (int, Stringer)
	// vtable's value-receiver thunk: iv data slot stores
	// &x (a *int); the thunk loads int from it and calls
	// lang.int.String.
	printIt(&x)
	printIt(&b)
}
