package "main"

import "pkg/builtins/testing"

import "pkg/builtins/lang"

// pkg/builtins/lang ships Comparable / Orderable / Hashable plus impls
// for every universe primitive.  Direct method-call paths
// (a.Compare(b), x.Hash()) work for primitives.  iv-dispatch
// to Self-using methods is rejected at type-check time —
// exercised separately by the negative test 413.

func main() {
	// Compare on int: Compare(a, b) returns -1 / 0 / 1.
	var a int = 3
	var b int = 5
	testing.Println(a.Compare(b)) // -1
	testing.Println(b.Compare(a)) // 1
	testing.Println(a.Compare(a)) // 0

	// Compare on bool (false < true convention).
	var t bool = true
	var f bool = false
	testing.Println(f.Compare(t)) // -1
	testing.Println(t.Compare(f)) // 1
	testing.Println(t.Compare(t)) // 0

	// Hash on primitives (consistency with Compare equality:
	// equal values hash the same).  Rather than print the
	// raw uint (which formatInt would render as a possibly-
	// negative int-64), we just verify that two equal values
	// hash the same.
	var x int = 42
	var y int = 42
	if x.Hash() == y.Hash() {
		testing.Println("hash-consistent")
	}
}
