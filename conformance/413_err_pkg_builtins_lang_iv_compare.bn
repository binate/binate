package "main"

// Comparable.Compare uses Self in its
// `other` parameter.  Dispatching through `*lang.Comparable`
// would lose the Self-ness at the type-erased boundary, so
// the type checker rejects the call.

import "pkg/builtins/lang"

func main() {
	var a int = 3
	var iv *lang.Comparable = &a
	println(iv.Compare(5))
}
