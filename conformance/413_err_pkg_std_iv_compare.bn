package "main"

// plan-self-type.md S.3 + plan-primitives-impl-interfaces.md
// Slice 2b interaction: Comparable.Compare uses Self in its
// `other` parameter.  Dispatching through `*std.Comparable`
// would lose the Self-ness at the type-erased boundary, so
// the type checker rejects the call.

import "pkg/std"

func main() {
	var a int = 3
	var iv *std.Comparable = &a
	println(iv.Compare(5))
}
