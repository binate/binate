package "main"

import "pkg/builtins/testing"

import "pkg/builtins/lang"

// Hash() on Hashable does NOT use Self in its signature, so
// iv-dispatch through *lang.Hashable IS allowed (per-method,
// not per-interface, rejection of Self-using methods — see
// check_self_test.bn TestNonSelfMethodCallThroughIvAccepted
// for the type-checker rule).
//
// This test pins the runtime end-to-end of that path: a
// primitive (`int`) satisfies *lang.Hashable, and the
// dispatched Hash call must reach the carve-out's value-
// receiver impl via the per-(R, M) thunk (Slice A).
//
// Compare cannot be tested here because *Hashable's Compare
// is Self-using and rejected at the iv call site; that path
// is covered by 413_err_pkg_std_iv_compare.

func getHash(h *lang.Hashable) uint {
	return h.Hash()
}

func main() {
	var x int = 42
	var y int = 42
	var z int = 43

	// Two equal ints hash the same through iv dispatch.  We
	// don't print the raw uint (formatInt would render it as
	// a signed int — the value is unspecified by the API
	// beyond "consistent with Compare-equality").
	if getHash(&x) == getHash(&y) {
		testing.Println("equal")
	}
	if getHash(&x) != getHash(&z) {
		testing.Println("distinct")
	}
}
