package "main"

// plan-primitives-impl-interfaces.md Slice 2a / 2b: char and
// byte are aliases of uint8 (TypChar / TypByte return the
// same singleton as TypUint8 per pkg/types/types.bn).  Methods
// on uint8 must therefore be reachable when the receiver is
// spelled `char` or `byte`.  pkg/builtins/lang provides String / Compare
// / Hash for uint8 only; this test confirms char and byte
// inherit them.

import "pkg/builtins/lang"

func main() {
	var c char = 65   // 'A'
	var b byte = 100
	var u uint8 = 65

	// String() on each — same value (65) on char and uint8
	// should produce the same digit string.
	println(c.String())   // "65"
	println(b.String())   // "100"
	println(u.String())   // "65"

	// Compare across char / byte / uint8 — the alias means
	// the underlying singleton is the same, so the impl is
	// applicable regardless of the source name.
	println(c.Compare(u))   // 0 (both 65)
	println(c.Compare(b))   // -1 (65 < 100)
	println(b.Compare(c))   // 1
}
