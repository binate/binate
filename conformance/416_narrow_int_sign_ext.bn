package "main"

import "pkg/builtins/testing"

// Narrow signed integer sign-extension regression.
// Pre-existing bytecode-VM bug: BC_LOAD8 with Imm > 1 (or single-byte
// loads of signed types) zero-extends the loaded bytes instead of
// sign-extending. For signed int8 / int16 / int32 values with the
// high bit set, loads through alloca'd locals come back as the wrong
// (positive) value, so comparisons and casts go wrong.
//
// See `explorations/claude-todo.md` ("Bytecode VM: BC_LOAD8 doesn't
// sign-extend signed sub-word loads").  Passes in `builder-comp`;
// xfail under any `*-int*` mode.

func loadInt8(p *readonly int8) int8 {
	return *p
}

func loadInt16(p *readonly int16) int16 {
	return *p
}

func loadInt32(p *readonly int32) int32 {
	return *p
}

func main() {
	var i8 int8 = -5
	var i16 int16 = -5
	var i32 int32 = -5

	if i8 < 0 { testing.Println("i8_lt_0_ok") } else { testing.Println("i8_lt_0_FAIL") }
	if i16 < 0 { testing.Println("i16_lt_0_ok") } else { testing.Println("i16_lt_0_FAIL") }
	if i32 < 0 { testing.Println("i32_lt_0_ok") } else { testing.Println("i32_lt_0_FAIL") }

	// Through *readonly T (matches the iv-dispatch thunk path).
	if loadInt8(&i8) < 0 { testing.Println("ld_i8_lt_0_ok") } else {
		testing.Println("ld_i8_lt_0_FAIL")
	}
	if loadInt16(&i16) < 0 { testing.Println("ld_i16_lt_0_ok") } else {
		testing.Println("ld_i16_lt_0_FAIL")
	}
	if loadInt32(&i32) < 0 { testing.Println("ld_i32_lt_0_ok") } else {
		testing.Println("ld_i32_lt_0_FAIL")
	}

	// INT_MIN survives widening cast (cast is BC_MOV; preserves
	// register value, so the question is whether the register
	// holds a sign-extended representation after the LOAD).
	var imin int32 = -2147483648
	var widened int = cast(int, imin)
	if widened < 0 { testing.Println("imin_neg_ok") } else { testing.Println("imin_neg_FAIL") }

	// INT8_MIN / INT16_MIN edge cases — narrowest widths with the
	// sign bit set.  Widening cast to int should preserve the
	// negative value.
	var i8min int8 = -128
	var i16min int16 = -32768
	if cast(int, i8min) == -128 { testing.Println("i8min_ok") } else { testing.Println("i8min_FAIL") }
	if cast(int, i16min) == -32768 { testing.Println("i16min_ok") } else {
		testing.Println("i16min_FAIL")
	}
}
