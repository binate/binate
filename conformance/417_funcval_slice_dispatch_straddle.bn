package "main"

// Func value with five raw-slice args.  Through the func-value dispatch the
// leading `data` pointer shifts the five two-word slices so the THIRD lands on
// the GP-reg/stack boundary (its first word in the last GP arg reg, its second
// on the stack).  The func-value dispatch ABI is all-int WORD-POSITIONAL — the
// shim reads word g from arg-reg g else the stack — but the dispatch used to
// place args by the REAL SysV ABI, which is all-or-nothing on x64: it pushed the
// straddling slice WHOLLY to the stack, leaving its first word's register
// unwritten.  The shim then consumed that stale register as the slice's first
// word (its data pointer) and dereferenced garbage -> SIGSEGV on native.  Reading
// one field of each slice at distinct decimal places surfaces any mis-placed arg.

func ssum(a *[]int, b *[]int, c *[]int, d *[]int, e *[]int) int {
	return a[0]*1 + b[0]*20 + c[0]*300 + d[0]*4000 + e[0]*50000
}

func main() {
	var fn *func(*[]int, *[]int, *[]int, *[]int, *[]int) int = ssum
	var x1 [1]int
	x1[0] = 1
	var x2 [1]int
	x2[0] = 2
	var x3 [1]int
	x3[0] = 3
	var x4 [1]int
	x4[0] = 4
	var x5 [1]int
	x5[0] = 5
	println(fn(x1[:], x2[:], x3[:], x4[:], x5[:]))  // 1+40+900+16000+250000 = 266941
}
