package "main"

// Capturing closure with five raw-slice args.  Same word-positional func-value
// dispatch straddle as 994, but through the CLOSURE path: the closure captures
// `base`, and the closure shim (emitClosureShim / spill) reads its incoming args
// word-positionally after loading captures.  Before the dispatch fix the third
// slice was placed all-or-nothing (SysV MEMORY) while the shim expected it
// word-positional, stranding a GP reg the shim then dereferenced as a slice data
// pointer -> SIGSEGV.  Exercises the closure shim's incoming arg read.

func main() {
	var base int = 7
	var f *func(*[]int, *[]int, *[]int, *[]int, *[]int) int =
		func(a *[]int, b *[]int, c *[]int, d *[]int, e *[]int) int {
			return base + a[0]*1 + b[0]*20 + c[0]*300 + d[0]*4000 + e[0]*50000
		}
	var x1 [1]int
	x1[0] = 1
	var x2 [1]int
	x2[0] = 2
	var x3 [1]int
	x3[0] = 3
	var x4 [1]int
	x4[0] = 4
	var x5 [1]int
	x5[0] = 5
	println(f(x1[:], x2[:], x3[:], x4[:], x5[:]))  // 7 + 1+40+900+16000+250000 = 266948
}
