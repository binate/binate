package "main"

// Constant folding for + - * on untyped-int literals.  `1000 -
// 1000 = 0` fits uint8 even though the individual operand `1000`
// doesn't — the fit-check at the assignment site sees the folded
// final value.

func main() {
	var a uint8 = 1000 - 1000
	var b uint8 = 100 + 100
	var c uint8 = 5 * 50
	var d int8 = 64 + 64 - 1
	var e int8 = 64 + 64 - 128
	println(cast(int, a))
	println(cast(int, b))
	println(cast(int, c))
	println(cast(int, d))
	println(cast(int, e))
}
