package "main"

// Constant folding handles operands across the int63 corner the
// older 31-bit-window approach couldn't.  pkg/binate/bignum's overflow
// detection now works correctly under bootstrap interp too
// (bootstrap-Go's uint64 ordering / division got dispatched on
// operand signedness in evalIntBinaryOp), so the fold path
// reaches the full int64 boundary.

func main() {
	// int32-max + 1 = 2^31 — fits int64 (would have overflowed int32).
	var a int64 = 2147483647 + 1
	// int32-max * 2 = 2^32 - 2 — fits int64 + uint32.
	var b uint64 = 2147483647 * 2
	// (int32-max + 1) * 2 — fits int64.
	var c int64 = 2147483648 * 2
	println(a)
	println(b)
	println(c)
}
