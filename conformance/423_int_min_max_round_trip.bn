package "main"

// Int boundary literals round-trip through codegen + runtime
// formatting.  Previously the codegen path for OP_CONST_INT and
// the runtime's bootstrap.formatInt both did `0 - n` on negative
// magnitudes, which overflows when `n` is int-min: the loop body
// never executed, so the formatter emitted just "-" (no digits).
// The fix computes the magnitude via two's-complement uint64,
// which round-trips cleanly across the boundary.

func main() {
	var lo int64 = -9223372036854775808
	var hi int64 = 9223372036854775807
	println(lo)
	println(hi)
}
