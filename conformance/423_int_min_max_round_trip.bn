package "main"

import "pkg/builtins/testing"

// Int boundary literals round-trip through codegen + integer
// formatting.  Both the codegen path for OP_CONST_INT and the
// runtime integer-formatting helper must compute a negative value's
// magnitude via two's-complement uint64: a naive `0 - n` overflows
// when `n` is int-min, so the digit loop never executes and the
// formatter would emit just "-" (no digits).  This pins the
// boundary round-trip so that regression can't return.

func main() {
	var lo int64 = -9223372036854775808
	var hi int64 = 9223372036854775807
	testing.Println(lo)
	testing.Println(hi)
}
