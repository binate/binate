package "main"

// Unsigned-integer ops on uint values with the high bit set.
// Regression test for the bytecode-VM bug where lowerBinOp /
// lowerCmpOp ignored operand signedness:
//   - `>>` lowered to BC_SHR (arithmetic), shifting in sign bits.
//   - `<` / `>` / `<=` / `>=` lowered to BC_S* (signed), so
//     uint64Max compared negative-ish.
//   - `/` / `%` lowered to BC_DIV / BC_REM (signed), so
//     uint64Max / 7 was 0.
//
// All three classes need their unsigned counterparts to be
// dispatched and executed correctly for the assertions below to
// hold under any `*-int*` mode.

func main() {
	var hi uint64 = cast(uint64, 1) << 63   // 0x8000000000000000

	// Logical right-shift should zero-fill, giving 2^62.
	var shifted uint64 = hi >> 1
	var expected uint64 = cast(uint64, 1) << 62
	if shifted == expected {
		println("lshr_ok")
	} else {
		println("lshr_FAIL")
	}

	// Shifting all the way down: hi >> 63 == 1.
	if (hi >> 63) == cast(uint64, 1) {
		println("lshr_to_one_ok")
	} else {
		println("lshr_to_one_FAIL")
	}

	// Unsigned ordering: hi > 1000 (signed compare would put hi
	// in the negative half and flip this).
	if hi > cast(uint64, 1000) {
		println("ucmp_gt_ok")
	} else {
		println("ucmp_gt_FAIL")
	}

	// Unsigned division: hi / 2 == 2^62, not 0 (or some negative
	// nonsense from signed division).
	if (hi / cast(uint64, 2)) == expected {
		println("udiv_ok")
	} else {
		println("udiv_FAIL")
	}

	// Unsigned remainder of an odd-high value: hi has only bit
	// 63 set, so hi % 2 == 0.
	if (hi % cast(uint64, 2)) == cast(uint64, 0) {
		println("urem_ok")
	} else {
		println("urem_FAIL")
	}
}
