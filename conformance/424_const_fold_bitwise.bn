package "main"

import "pkg/builtins/testing"

// Constant folding for `& | ^ << >>` on untyped-int literals.
// Folded values feed the AssignableTo fit-check the same way
// arithmetic folds do (see 417).  Pin a handful of bit patterns
// so the fold's value semantics are exercised end-to-end.

func main() {
	var a uint8 = 0xF0 & 0x0F // 0
	var b uint8 = 0xF0 | 0x0F // 255
	var c uint8 = 0xAA ^ 0xFF // 0x55 = 85
	var d uint8 = 1 << 7 // 128
	var e uint8 = 0x80 >> 3 // 16
	var f uint32 = 1 << 31 // 2147483648
	testing.Println(cast(int, a))
	testing.Println(cast(int, b))
	testing.Println(cast(int, c))
	testing.Println(cast(int, d))
	testing.Println(cast(int, e))
	testing.Println(cast(int, f))
}
