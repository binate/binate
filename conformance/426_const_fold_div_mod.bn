package "main"

// Constant folding for `/` and `%` on untyped-int literals.  The
// folded value feeds the AssignableTo fit-check, same as the +
// - * fold.  Division-by-zero is a separate type-check error
// (pinned by 427_err_const_fold_div_by_zero); / truncates toward
// zero and % takes the sign of the dividend, matching Go.

func main() {
	var a uint8 = 200 / 4              // 50
	var b uint8 = 256 % 100            // 56
	var c int8 = -20 / 3               // -6 (truncated toward zero)
	var d int8 = -20 % 3               // -2 (sign of dividend)
	var e int = 1000000 / 7            // 142857
	println(cast(int, a))
	println(cast(int, b))
	println(cast(int, c))
	println(cast(int, d))
	println(e)
}
