package "main"

import "pkg/builtins/testing"

// Division by zero in a constant expression is a type-check error
// (not a runtime panic): const-folding must produce a usable value
// at check time, and there's no value to produce here.  Both `/`
// and `%` reject — pinning `/` is enough to exercise the path.

func main() {
	var x int = 10 / 0
	testing.Println(x)
}
