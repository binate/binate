package "main"

// `println(uintN)` prints unsigned: a high-bit-set value formats
// as its unsigned interpretation, not the signed two's-complement
// reinterpretation.  IR-gen for println now dispatches to
// `bootstrap.formatUint` for unsigned operand types; the
// bootstrap interpreter's IntVal.String() respects Signed too.

func main() {
	var a uint64 = cast(uint64, 1) << 63
	var b uint64 = (cast(uint64, 1) << 63) | ((cast(uint64, 1) << 63) - 1)
	println(a)
	println(b)
}
