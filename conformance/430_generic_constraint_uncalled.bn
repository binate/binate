package "main"

// plan-generics.md Slice 3 end-to-end smoke: a generic function
// constrained by a local interface, declared but never called.
// Type-checking validates that the body's constraint-method call
// resolves against the constraint interface's method set; the
// generic decl itself produces no IR (Slice 4's monomorphization
// is what would emit code at the call site).

type Foo struct {
	X int
}

interface Greeter {
	Hello() int
}

impl Foo : Greeter

func (f Foo) Hello() int {
	return f.X
}

// Constrained generic: body legally calls t.Hello() because
// T : Greeter.  Not called, so no instantiation pressure.
func greet[T Greeter](t T) int {
	return t.Hello()
}

func main() {
	println("ok")
}
