package "main"

// End-to-end monomorphization for an
// unconstrained generic function called with concrete type args.
// The IR-gen layer emits one specialized IR func per unique
// `id[T]` instantiation (here just `id[int]`); the call site
// dispatches to the mangled name directly.

func id[T any](x T) T {
	return x
}

func main() {
	var y int = id[int](7)
	println(y)
}
