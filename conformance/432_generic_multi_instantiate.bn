package "main"

import "pkg/builtins/testing"

// Multiple distinct instantiations and dedup of repeated ones.
// `id[int]` is called twice — IR-gen
// emits one specialized func — and `id[bool]` is also exercised,
// producing a second specialized func independent of `id[int]`.

func id[T any](x T) T {
	return x
}

func main() {
	var a int = id[int](3)
	var b int = id[int](4)
	var c bool = id[bool](true)
	testing.Println(a)
	testing.Println(b)
	if c { testing.Println("true") } else { testing.Println("false") }
}
