package "main"

// Exercise two paths the initial generics tests (431, 432) didn't cover.
//
//   * Local-variable declaration with type T inside a generic
//     body — `var y T = x` — to verify resolveTypeExpr's
//     substitution branch fires from body checking, not just
//     param / result resolution.
//   * Two type parameters actually instantiated and called —
//     pair[int, bool] (the existing tests are all single-param
//     instantiations).

func passT[T any](x T) T {
	var y T = x
	return y
}

func pickFirst[T any, U any](x T, y U) T {
	return x
}

func main() {
	var a int = passT[int](5)
	println(a)
	var b int = pickFirst[int, bool](42, true)
	println(b)
}
