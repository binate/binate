package "main"

import "pkg/std"

// plan-generics.md Slice 4b end-to-end: generic-function body
// calls a method declared on the constraint interface, and the
// instantiated specialization dispatches it correctly.
//
//   cmp[int] specialization → int.Compare(int) int
//
// `impl int : Orderable` in pkg/std supplies Compare; Orderable
// extends Comparable, so the int → Comparable satisfaction check
// goes through interface-inheritance in typeSatisfiesConstraint.
//
// `addOne[T any]` exercises the same mechanism on the operand
// side: `var s @[]char = t.String()` requires t.String() to
// resolve via int's Stringer impl at IR-gen time.

func cmp[T std.Comparable](a T, b T) int {
	return a.Compare(b)
}

func hashOf[T std.Hashable](x T) uint {
	return x.Hash()
}

func main() {
	var lt int = cmp[int](3, 5)
	println(lt)
	var eq int = cmp[int](4, 4)
	println(eq)
	var gt int = cmp[int](8, 1)
	println(gt)

	// uint Hash on a small concrete value should round-trip
	// through the same constant.
	var h uint = hashOf[uint](cast(uint, 42))
	if h == cast(uint, 42) {
		println("hash_ok")
	} else {
		println("hash_FAIL")
	}
}
