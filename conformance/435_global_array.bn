package "main"

import "pkg/builtins/testing"

// Module-level array global with runtime-indexed read/write.  Pins
// the codegen path that emits the GEP base operand as the
// @-mangled global name (not `%v-1`) when IsGlobalRef is set on
// the lookup-produced pseudo-Instr.  The bare-metal pkg/builtins/rt's
// bump-allocator heap is the first real user of this shape; this
// conformance test gives it host-side coverage too.

var grid [16]int

func set(idx int, val int) {
	grid[idx] = val
}

func get(idx int) int {
	return grid[idx]
}

func main() {
	for i := 0; i < 16; i++ {
		set(i, i * 3 + 1)
	}
	for i := 0; i < 16; i++ {
		testing.Println(get(i))
	}
}
