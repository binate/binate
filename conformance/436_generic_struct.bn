package "main"

// plan-generics.md Slice 5c end-to-end: a generic struct decl
// instantiated as `Box[int]` is registered in IR-gen with
// substituted field types; field reads and writes work via the
// standard struct-access machinery.

type Box[T any] struct {
	val T
}

func main() {
	var b Box[int]
	b.val = 42
	println(b.val)
}
