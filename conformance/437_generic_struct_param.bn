package "main"

import "pkg/builtins/testing"

// A generic-struct instantiation
// (Pair[int, int]) flows through a parameter type, gets fields
// assigned on the caller side, then read on the callee side.
// Exercises both the param-position TEXPR_INSTANTIATE resolution
// and field-read after the struct passes by value.

type Pair[T any, U any] struct {
	fst T
	snd U
}

func sumFst(p Pair[int, int]) int {
	return p.fst + p.snd
}

func main() {
	var p Pair[int, int]
	p.fst = 10
	p.snd = 32
	testing.Println(sumFst(p))
}
