package "main"

// Pointer-to-iface-value shape: `@(@I)` — managed pointer to
// managed interface value.  Dispatch via explicit deref
// `(*p).Foo()` must reach the underlying impl method.  Per plan-
// pointers-to-iface-values.md Slice P.1.
//
// Currently broken on the self-hosted compiler — same root cause
// as 436: dispatch through the boxed managed-iv returns 0.
// Slice P.2 is the fix; this test pins the gap until then.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t @T = make(T)
	t.x = 42
	var iv @I = t
	var p @(@I) = box(iv)
	println((*p).Foo())
}
