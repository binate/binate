package "main"

// Smoothing a pointer-to-iface-value receiver — `p.Foo()` where p
// is `**I` — currently rejected at type check.  Method-call
// receiver smoothing handles `*T → T` and `@T → T`, but not the
// iv-pointer cases.
//
// Per plan-pointers-to-iface-values.md Slice P.3, this rejection
// is the gap that smoothing fills in; once P.3 lands this test
// flips from .error to .expected.  Pinning the current state
// makes the regression visible if the rejection accidentally
// goes away before the smoothing impl lands.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p **I = &iv
	println(p.Foo())
}
