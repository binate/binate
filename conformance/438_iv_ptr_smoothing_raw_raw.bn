package "main"

// Smoothing pointer-to-iface-value receivers: `p.Foo()` where `p`
// is `**I` (raw ptr → raw iv) auto-derefs to the iv and dispatches
// via the iface method set.  Equivalent to `(*p).Foo()`.  Per
// plan-pointers-to-iface-values.md Slice P.3.
//
// Pre-Slice-P.3 this rejected at type check with "cannot access
// field on this type".  The smoothing rule lives in
// `pkg/binate/types/check_method.bn`'s `tryMethodCall` (peel one pointer
// layer and look up on the iv); the IR-gen mirror is in
// `pkg/ir/gen_iface.bn` (emit the load before dispatch).

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p **I = &iv
	println(p.Foo())
}
