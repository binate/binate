package "main"

import "pkg/builtins/testing"

// A raw slice of 2-word raw interface values (`*[]*I`): each element is an iv
// `{data, vtable}`, written via `s[i] = &t` and dispatched via `s[i].Foo()`.
//
// The backing is OWNED by a managed var (`backing`) and the raw slice `s` only
// borrows it — a raw borrow of a `make_slice(..)` TEMPORARY must not outlive its
// statement (spec §9.7 `mem.temporary`), so `var s *[]*I = make_slice(*I,2)[:]`
// would dangle: the temporary is released at end of statement and the later
// `s[i]`/`s[i].Foo()` uses are a use-after-free.  That UAF is benign only where
// the freed block is not immediately reused; on a no-free-until-teardown arena it
// is reused (an allocator tag lands in the freed backing) and dispatch reads
// garbage.  Owning the backing keeps `s` valid for the whole function.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t1 T
	t1.x = 1
	var t2 T
	t2.x = 2
	var backing @[]*I = make_slice(*I, 2)
	var s *[]*I = backing[:]
	s[0] = &t1
	s[1] = &t2
	testing.Println(s[0].Foo())
	testing.Println(s[1].Foo())
}
