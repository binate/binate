package "main"

import "pkg/builtins/testing"

// Composition gap: raw slice of raw interface values (`*[]*I`).
// Compiles, but writes into the iv slot don't lay down both
// data + vtable words, so dispatch through `s[i].Foo()` reads
// uninitialized memory and segfaults.  Per plan-pointers-to-
// iface-values.md Slice P.4.  This test pins the gap until the
// slice-element-write path handles 2-word iv slots correctly.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t1 T
	t1.x = 1
	var t2 T
	t2.x = 2
	var s *[]*I = make_slice(*I, 2)[:]
	s[0] = &t1
	s[1] = &t2
	testing.Println(s[0].Foo())
	testing.Println(s[1].Foo())
}
