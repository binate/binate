package "main"

// Composition gap: managed slice of managed interface values
// (`@[]@I`).  Compiles, but writes into the iv slot segfault at
// dispatch — see 439 for the same shape on raw slices.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t1 @T = make(T)
	t1.x = 1
	var t2 @T = make(T)
	t2.x = 2
	var s @[]@I = make_slice(@I, 2)
	s[0] = t1
	s[1] = t2
	println(s[0].Foo())
	println(s[1].Foo())
}
