package "main"

import "pkg/builtins/testing"

// Composition: array of interface values (`[N]*I`) — writes into
// the iv slots, then dispatch through each slot (the array
// counterpart of 439 / 440).

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t1 T
	t1.x = 1
	var t2 T
	t2.x = 2
	var arr [2]*I
	arr[0] = &t1
	arr[1] = &t2
	testing.Println(arr[0].Foo())
	testing.Println(arr[1].Foo())
}
