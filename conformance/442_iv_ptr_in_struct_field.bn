package "main"

// Composition: struct field of pointer-to-iface-value works.
// `struct { pp **I }` stores and recovers the iv-pointer
// through the struct.  Per plan-pointers-to-iface-values.md
// Slice P.4 — this is the positive case that pins the working
// path; failures in 439–441 are the gaps.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

type Holder struct {
	pp **I
}

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var h Holder
	h.pp = &iv
	println((*h.pp).Foo())
}
