package "main"

// Pointer-to-iface-value shape: `*@I` — raw pointer to managed
// interface value.  Dispatch via explicit deref `(*p).Foo()` must
// reach the underlying impl method.
//
// 408 pins the `**I` (raw → raw) case; this pins the raw → managed
// composition.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t @T = make(T)
	t.x = 42
	var iv @I = t
	var p *@I = &iv
	println((*p).Foo())
}
