package "main"

import "pkg/builtins/testing"

// Pointer-to-iface-value shape: `@(*I)` — managed pointer to raw
// interface value.  Dispatch via explicit deref `(*p).Foo()` must
// reach the underlying impl method — box() of the iv-value must keep
// its 2-word shape and the deref-then-dispatch path must handle the
// @(...) form (dispatch through a mishandled boxed raw-iv returns 0
// instead of the underlying T.x).

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p @(*I) = box(iv)
	testing.Println((*p).Foo())
}
