package "main"

import "pkg/builtins/testing"

// Pointer-to-iface-value shape: `@(*I)` — managed pointer to raw
// interface value.  Dispatch via explicit deref `(*p).Foo()` must
// reach the underlying impl method.  Per plan-pointers-to-iface-
// values.md Slice P.1.
//
// Currently broken on the self-hosted compiler — dispatch through
// the boxed raw-iv returns 0 instead of the underlying T.x.
// Probable cause: box() of an iv-value loses the 2-word shape, or
// the deref-then-dispatch path miscomputes for the @(...) form.
// Slice P.2 is the fix; this test pins the gap until then.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p @(*I) = box(iv)
	testing.Println((*p).Foo())
}
