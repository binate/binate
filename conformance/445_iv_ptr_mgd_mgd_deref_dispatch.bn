package "main"

import "pkg/builtins/testing"

// Pointer-to-iface-value shape: `@(@I)` — managed pointer to
// managed interface value.  Dispatch via explicit deref
// `(*p).Foo()` must reach the underlying impl method (dispatch
// through a mishandled boxed managed-iv returns 0 instead).

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t @T = make(T)
	t.x = 42
	var iv @I = t
	var p @(@I) = box(iv)
	testing.Println((*p).Foo())
}
