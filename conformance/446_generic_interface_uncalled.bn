package "main"

import "pkg/builtins/testing"

// Declares a generic interface but doesn't instantiate or impl
// against it.  IR-gen skips the
// generic decl (per-instantiation vtable layout is later work);
// the program compiles and runs cleanly via the non-generic
// main body.

interface Container[T any] {
	get(i int) T
}

func main() {
	testing.Println("ok")
}
