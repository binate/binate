package "main"

import "pkg/builtins/testing"

// Methods on generic types via an interface value (gen.impl.generic-recv):
// a parameterized impl `@Box[T] : Getter[T]` lets a concrete @Box[int] box
// into a @Getter[int] managed interface value; the call dispatches through
// the per-instantiation vtable.  Single-return to isolate vtable dispatch
// from the multi-return ABI path.

interface Getter[T any] {
	Get() T
}

type Box[T any] struct {
	val T
}

func (b @Box[T]) Get() T {
	return b.val
}

impl @Box[T] : Getter[T]

func main() {
	var b @Box[int] = make(Box[int])
	b.val = 42
	var g @Getter[int] = b
	testing.Println(g.Get())
}
