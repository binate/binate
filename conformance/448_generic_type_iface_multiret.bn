package "main"

// Methods on generic types through a managed interface value with a
// MULTI-RETURN method (gen.method.generic-recv, gen.impl.generic-recv):
// Next() (T, bool) dispatched via the per-instantiation vtable.  This is a
// managed-iface multi-return — the ABI-stressed shape most likely to expose a
// backend/target divergence — so it is exercised across all modes/backends.

interface Iter[T any] {
	Next() (T, bool)
}

type Counter[T any] struct {
	cur int
	max int
	val T
}

func (c @Counter[T]) Next() (T, bool) {
	if c.cur >= c.max {
		var z T
		return z, false
	}
	c.cur = c.cur + 1
	return c.val, true
}

impl @Counter[T] : Iter[T]

func main() {
	var c @Counter[int] = make(Counter[int])
	c.max = 2
	c.val = 7
	var it @Iter[int] = c
	var v int
	var ok bool
	v, ok = it.Next()
	if ok {
		println(v)
	}
	v, ok = it.Next()
	if ok {
		println(v)
	}
	v, ok = it.Next()
	if ok {
		println(v)
	} else {
		println(0)
	}
}
