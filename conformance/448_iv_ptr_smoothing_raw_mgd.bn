package "main"

// Smoothing pointer-to-iface-value receivers: `p.Foo()` where `p`
// is `*@I` (raw ptr → managed iv) auto-derefs to the iv.  Per
// plan-pointers-to-iface-values.md Slice P.3.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t @T = make(T)
	t.x = 42
	var iv @I = t
	var p *@I = &iv
	println(p.Foo())
}
