package "main"

// plan-generics.md Slice 6c-full: two impls of distinct
// instantiations of one generic interface coexist in the same
// module — `Container[int]` and `Container[bool]` register as
// separate ModuleInterfaces under distinct mangled names, and
// dispatch on each routes to the right method.

interface Container[T any] {
	get() T
}

type IntBox struct {
	v int
}

type BoolBox struct {
	b bool
}

impl IntBox : Container[int]
impl BoolBox : Container[bool]

func (b IntBox) get() int {
	return b.v
}

func (b BoolBox) get() bool {
	return b.b
}

func main() {
	var ib IntBox
	ib.v = 11
	var bb BoolBox
	bb.b = true
	var ci *Container[int] = &ib
	var cb *Container[bool] = &bb
	println(ci.get())
	if cb.get() {
		println("yes")
	} else {
		println("no")
	}
}
