package "main"

import "pkg/builtins/testing"

// Smoothing pointer-to-iface-value receivers: `p.Foo()` where `p`
// is `@(@I)` (managed ptr → managed iv) auto-derefs to the iv.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func main() {
	var t @T = make(T)
	t.x = 42
	var iv @I = t
	var p @(@I) = box(iv)
	testing.Println(p.Foo())
}
