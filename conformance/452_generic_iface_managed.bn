package "main"

// Dispatch through a managed interface value `@Container[int]`.
// Mirrors 447 but with the managed form so the iv data slot owns
// the receiver pointer.

interface Container[T any] {
	get() T
}

type IntBox struct {
	v int
}

impl @IntBox : Container[int]

func (b @IntBox) get() int {
	return b.v
}

func main() {
	var b @IntBox = make(IntBox)
	b.v = 7
	var c @Container[int] = b
	println(c.get())
}
