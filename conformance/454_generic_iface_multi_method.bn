package "main"

// plan-generics.md Slice 6c-full: a generic interface with more
// than one method.  Pins that the instantiated ModuleInterface's
// method-name list comes out in declaration order, so vtable
// slot indices match what dispatch resolves.

interface Pair[T any] {
	first() T
	second() T
}

type IntPair struct {
	a int
	b int
}

impl IntPair : Pair[int]

func (p IntPair) first() int {
	return p.a
}

func (p IntPair) second() int {
	return p.b
}

func main() {
	var p IntPair
	p.a = 3
	p.b = 5
	var ip *Pair[int] = &p
	println(ip.first())
	println(ip.second())
}
