package "main"

// A non-generic interface extends an instantiation of
// a generic interface (`interface IntCarrier : Container[int]`).
// Dispatch through `*IntCarrier` for an inherited generic-iface
// method must reach the right vtable slot via the concat layout;
// an explicit upcast `*IntCarrier → *Container[int]` then
// dispatches through the parent-typed view.

interface Container[T any] {
	get() T
}

interface IntCarrier : Container[int] {
	size() int
}

type Box struct {
	v int
}

impl Box : IntCarrier

func (b Box) get() int {
	return b.v
}

func (b Box) size() int {
	return 1
}

func main() {
	var b Box
	b.v = 9
	var ic *IntCarrier = &b
	// Inherited dispatch through *IntCarrier — get() comes from
	// Container[int]'s sub-vtable.
	println(ic.get())
	println(ic.size())
	// Explicit upcast to *Container[int] — vtable swap to the
	// parent's, same data ptr.
	var c *Container[int] = ic
	println(c.get())
}
