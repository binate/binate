package "main"

import "pkg/builtins/testing"

// A generic type's method body may call a SIBLING method on its receiver
// (gen.method.generic-recv): the abstract self-shell built during method-body
// checking must expose the type's own method set, or b.Get() below is
// spuriously rejected as undefined.

type Box[T any] struct {
	val T
}

func (b *Box[T]) Get() T {
	return b.val
}

func (b *Box[T]) GetViaSibling() T {
	return b.Get()
}

func main() {
	var b Box[int]
	b.val = 42
	testing.Println(b.GetViaSibling())
}
