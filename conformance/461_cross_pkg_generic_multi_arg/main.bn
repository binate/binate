package "main"

// Cross-package generic function with multiple type
// parameters.  Pins that the consumer's
// monomorphization picks the right arg for each T_i and
// produces a mangled name that includes both.

import "pkg/multilib"

func main() {
	println(multilib.First[int, bool](7, true))
	if multilib.Second[int, bool](7, true) {
		println("yes")
	} else {
		println("no")
	}
}
