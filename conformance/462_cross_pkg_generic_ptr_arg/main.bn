package "main"

// Cross-package generic function with a pointer type
// argument.  Pins that mangleTypeArg
// produces a `ptr_int` suffix for the consumer's local
// instantiation symbol.

import "pkg/ptrlib"

func main() {
	var x int = 17
	var px *int = &x
	var py *int = ptrlib.Id[*int](px)
	println(*py)
}
