package "main"

// Cross-package generic interface
// declaration consumed from another pkg.  The consumer declares
// a struct, impls the cross-pkg generic iface instantiation,
// and dispatches.

import "pkg/iflib"

type IntBox struct {
	v int
}

impl IntBox : iflib.Container[int]

func (b IntBox) get() int {
	return b.v
}

func main() {
	var b IntBox
	b.v = 99
	var c *iflib.Container[int] = &b
	println(c.get())
}
