package "main"

import "pkg/builtins/testing"

// Composition: pointer-to-iface-value as a function parameter.
// `func dispatch(p **I) int { return p.Foo() }` exercises the
// AAPCS arg passing for the iv-pointer + the one-level
// auto-dereference at the dispatch site (spec §10.6
// `func.method.auto-deref`).

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func dispatch(p **I) int {
	return p.Foo()
}

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	testing.Println(dispatch(&iv))
}
