package "main"

import "pkg/builtins/testing"

// Composition: pointer-to-iface-value as a function parameter.
// `func dispatch(p **I) int { return p.Foo() }` exercises the
// AAPCS arg passing for the iv-pointer + the smoothing
// (Slice P.3) at the dispatch site.  Per plan-pointers-to-
// iface-values.md Slice P.4.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func dispatch(p **I) int {
	return p.Foo()
}

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	testing.Println(dispatch(&iv))
}
