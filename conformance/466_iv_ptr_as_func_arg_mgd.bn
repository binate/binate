package "main"

// Composition: managed-pointer-to-iface-value as a function
// parameter.  `func dispatch(p @(*I)) int { return p.Foo() }`
// exercises both AAPCS arg passing of a managed pointer + the
// aa64 emitBox aggregate-load path needed to construct the @(*I)
// at the call site.  Per plan-pointers-to-iface-values.md
// Slice P.4.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func dispatch(p @(*I)) int {
	return p.Foo()
}

func main() {
	var t T
	t.x = 42
	var iv *I = &t
	var p @(*I) = box(iv)
	println(dispatch(p))
}
