package "main"

// Composition: pointer-to-iface-value as a function return type.
// `func box_iv(t *T) @(*I)` returns a managed-pointer-to-raw-iv.
// Exercises the AAPCS return path for a managed pointer + the
// caller's iv-method dispatch through the returned p.

interface I {
	Foo() int
}

type T struct {
	x int
}

func (t *T) Foo() int {
	return t.x
}

impl *T : I

func box_iv(t *T) @(*I) {
	var iv *I = t
	return box(iv)
}

func main() {
	var t T
	t.x = 42
	var p @(*I) = box_iv(&t)
	println(p.Foo())
}
