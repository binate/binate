package "main"

// A generic type used as a GLOBAL-VAR type is instantiated during pass-1
// collection (checker) and IR-gen pass 1 — before its method decl (below) is
// reached.  The checker method back-fill and lazy IR-gen method emission must
// still make g.Get() resolve and link.

type Box[T any] struct {
	val T
}

var g Box[int]

func (b *Box[T]) Get() T {
	return b.val
}

func main() {
	g.val = 5
	println(g.Get())
}
