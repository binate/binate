package "main"

import "pkg/builtins/testing"

// A non-generic struct field of type Box[int] forces the instantiation in an
// early IR-gen pass, before the method decl is stashed.  Without lazy method
// emission the method is declared-but-never-defined and the link fails; with it,
// h.b.Get() links and runs.

type Box[T any] struct {
	val T
}

func (b *Box[T]) Get() T {
	return b.val
}

type Holder struct {
	b Box[int]
}

func main() {
	var h Holder
	h.b.val = 8
	testing.Println(h.b.Get())
}
