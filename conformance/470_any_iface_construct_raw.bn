package "main"

// §6 of plan-interface-syntax-revision.md: `any` is the implicit
// universal interface (empty method set).  `*any` is its raw
// interface value form, satisfied trivially by any pointer-shaped
// source.  This test only constructs the value and observes that it
// type-checks and compiles — no dispatch (the empty method set has
// nothing to call).

type Box struct {
	x int
}

func takesAny(v *any) {
	println("got an any")
}

func main() {
	var b Box
	b.x = 42
	var v *any = &b
	takesAny(v)
}
