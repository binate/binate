package "main"

import "pkg/builtins/testing"

// Managed-`any` form: `@any` is satisfied by any managed-pointer source.
// As with managed iface values generally, raw `*T` cannot promote to
// `@any` — that would invent a refcount header.

type Box struct {
	x int
}

func takesMgdAny(v @any) {
	testing.Println("got a managed any")
}

func main() {
	var b @Box = make(Box)
	b.x = 42
	var v @any = b
	takesMgdAny(v)
}
