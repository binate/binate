package "main"

// §6 of plan-interface-syntax-revision.md: managed-`any` form.
// `@any` is satisfied by any managed-pointer source.  As with §5
// (managed iface values generally), raw `*T` cannot promote to
// `@any` — that would invent a refcount header.

type Box struct {
	x int
}

func takesMgdAny(v @any) {
	println("got a managed any")
}

func main() {
	var b @Box = make(Box)
	b.x = 42
	var v @any = b
	takesMgdAny(v)
}
