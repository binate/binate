package "main"

import "pkg/builtins/testing"

// Managed side of `@any` interface handling.  If `@any` lowers to
// `@void` in IR-gen, scope-exit RefDec runs with a nil dtor and the
// pointee's managed fields leak.  With the synthesized (T, any) impl
// from ensureAnyImplInfo (gen_iface_anybox.bn)
// the vtable's slot-0 dtor is the receiver's __dtor_T, so
// EmitIfaceDtor picks it up and the pointee's managed fields get
// RefDec'd at scope exit as if `@Outer` had been used directly.

type Inner struct {
	v int
}

type Outer struct {
	child @Inner
}

func main() {
	var o @Outer = make(Outer)
	o.child = make(Inner)
	o.child.v = 7
	{
		var v @any = o
		_ = v
	}
	testing.Println(o.child.v)
}
