package "main"

// §6 of plan-interface-syntax-revision.md, managed side.  Pre-fix,
// `@any` lowered to `@void` in IR-gen, so scope-exit RefDec ran
// with a nil dtor and the pointee's managed fields leaked.  With
// the synthesized (T, any) impl from gen_iface.bn:ensureAnyImplInfo
// the vtable's slot-0 dtor is the receiver's __dtor_T, so
// EmitIfaceDtor picks it up and the pointee's managed fields get
// RefDec'd at scope exit as if `@Outer` had been used directly.

type Inner struct {
	v int
}

type Outer struct {
	child @Inner
}

func main() {
	var o @Outer = make(Outer)
	o.child = make(Inner)
	o.child.v = 7
	{
		var v @any = o
		_ = v
	}
	println(o.child.v)
}
