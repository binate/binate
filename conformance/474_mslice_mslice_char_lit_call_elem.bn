package "main"

// Variant of 374_mslice_mslice_char_lit: instead of bare string
// literals, the elements come from a function call that returns
// @[]char.  Pre-fix: bnc miscompiles this — the slot at index i
// does not contain f()'s return value, so println(args[0]) prints
// garbage (and downstream `streq(args[i], "...")` checks miss).
// Discovered while migrating cmd/bnc/compile_test.bn:
// TestAppendLibcImportNoDuplicate to the literal form.

func copyStr(s *[]const char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		result[i] = s[i]
	}
	return result
}

func main() {
	var args @[]@[]char = @[]@[]char{copyStr("alpha"), copyStr("beta")}
	println(len(args))
	println(args[0])
	println(args[1])
}
