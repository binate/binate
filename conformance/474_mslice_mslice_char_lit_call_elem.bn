package "main"

import "pkg/builtins/testing"

// Variant of 374_mslice_mslice_char_lit: instead of bare string
// literals, the elements come from a function call that returns
// @[]char.  A miscompile leaves the slot at index i without f()'s
// return value, so testing.Println(args[0]) prints garbage (and
// downstream `streq(args[i], "...")` checks miss).

func copyStr(s *[]readonly char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		result[i] = s[i]
	}
	return result
}

func main() {
	var args @[]@[]char = @[]@[]char{copyStr("alpha"), copyStr("beta")}
	testing.Println(len(args))
	testing.Println(args[0])
	testing.Println(args[1])
}
