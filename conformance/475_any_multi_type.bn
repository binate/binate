package "main"

import "pkg/builtins/testing"

// Multiple distinct T's flowing into `*any` in the same module —
// each (T, any) pair needs its own `__ivt.<...>__any` global, and
// ensureAnyImplInfo's dedup keeps a single pair from being
// registered twice when reached from multiple construction sites.

type A struct { x int }

type B struct { y int }

func takesAny(v *any) {
	testing.Println("any")
}

func main() {
	var a A
	var b B
	a.x = 1
	b.y = 2

	var va *any = &a
	var vb *any = &b
	// Second `*any` from A reaches the same (A, any) pair —
	// ensureAnyImplInfo must skip the duplicate impl registration.
	var va2 *any = &a

	takesAny(va)
	takesAny(vb)
	takesAny(va2)
}
