package "main"

// Plan §6 iv→any upcast: a `*Greeter` interface value can be
// assigned to `*any`.  Since `any` has no methods, the resulting
// iv reuses the source iv's data + vtable pointers wholesale —
// IfaceParentSlotOffset returns 0 for universe `any`, so the
// OP_IFACE_UPCAST lowering is a bit-identical type relabel.

interface Greeter {
	greet()
}

type Hello struct { x int }

func (h *Hello) greet() {
	println("hello from impl")
}

impl *Hello : Greeter

func takesAny(v *any) {
	println("got any")
}

func main() {
	var h Hello
	var iv *Greeter = &h
	var av *any = iv
	takesAny(av)
	// Source iv is still usable post-upcast.
	iv.greet()
}
