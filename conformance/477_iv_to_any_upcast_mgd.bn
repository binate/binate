package "main"

import "pkg/builtins/testing"

// Plan §6 iv→any upcast, managed side.  `@Greeter` upcasts to
// `@any` with offset 0; the source iv's vtable carries Hello's
// dtor in slot 0, which the @any's scope-exit RefDecDtor picks
// up — same path as direct `@T → @any` (test 471/473), just
// reached through an iv intermediate.

interface Greeter {
	greet()
}

type Hello struct { x int }

func (h *Hello) greet() {
	testing.Println("hello from mgd impl")
}

impl @Hello : Greeter

func takesMgdAny(v @any) {
	testing.Println("got mgd any")
}

func main() {
	var h @Hello = make(Hello)
	var iv @Greeter = h
	var av @any = iv
	takesMgdAny(av)
	iv.greet()
}
