package "main"

// Plan §6 iv→any upcast in argument position: passing `*Greeter`
// directly to a parameter of type `*any` should coerce at the call
// site without needing an intermediate `var av *any = iv`.  Same
// machinery as test 476 but exercising the genArgs / genExprOrFuncRef
// coercion path rather than var-decl initialization.

interface Greeter {
	greet()
}

type Hello struct { x int }

func (h *Hello) greet() {
	println("hello")
}

impl *Hello : Greeter

func takesAny(v *any) {
	println("got any")
}

func main() {
	var h Hello
	var iv *Greeter = &h
	takesAny(iv)
}
