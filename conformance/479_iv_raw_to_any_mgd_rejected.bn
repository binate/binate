package "main"

// Plan §6 + lifetime rule: a raw iv (`*Greeter`) must NOT
// auto-promote to `@any` — that would invent a refcount header on
// a borrowed pointer, the same lifetime trap that motivates the
// raw/managed split for plain slices and interface values.  The
// type-checker rejects at the iv-to-iv branch of
// canAssignToManagedInterfaceValue (raw source isn't admitted).

interface Greeter {
	greet()
}

type Hello struct { x int }
func (h *Hello) greet() {}
impl *Hello : Greeter

func main() {
	var h Hello
	var iv *Greeter = &h
	var av @any = iv   // ERROR: cannot assign raw iv to managed iv
	_ = av
}
