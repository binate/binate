package "main"

import "pkg/builtins/testing"

// Non-fresh element path for genManagedSliceLit: the element comes
// from a local variable load, not a fresh call.  The slot must
// RefInc its own reference (rather than consuming the temp, which
// the local's RefDec at scope exit would clobber).  Pre-fix: same
// dangling-data shape as 474, just sourced from a local instead
// of a call expression.

func copyStr(s *[]readonly char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		result[i] = s[i]
	}
	return result
}

func main() {
	var s @[]char = copyStr("hello")
	var args @[]@[]char = @[]@[]char{s, s}
	testing.Println(len(args))
	testing.Println(args[0])
	testing.Println(args[1])
	// `s` should still be readable after the literal builds;
	// the slot bumped the refcount, didn't consume `s`'s ref.
	testing.Println(s)
}
