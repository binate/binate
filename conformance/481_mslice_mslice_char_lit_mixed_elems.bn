package "main"

// Three-path exercise for genManagedSliceLit on @[]@[]char:
//   element 0: string literal           → EmitStringToChars (rodata
//                                          mslice copy for @[]char)
//   element 1: fresh call               → consumeTemp (slot inherits
//                                          the call result's refcount)
//   element 2: local var (non-fresh)    → emitManagedSliceRefInc
//                                          (slot bumps shared ref)
// All three should end up with a live element whose len/data
// survive the end-of-statement temp cleanup.

func copyStr(s *[]readonly char) @[]char {
	var n int = len(s)
	var result @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		result[i] = s[i]
	}
	return result
}

func main() {
	var local @[]char = copyStr("gamma")
	var args @[]@[]char = @[]@[]char{"alpha", copyStr("beta"), local}
	println(len(args))
	println(args[0])
	println(args[1])
	println(args[2])
	// local still alive — slot bumped refcount.
	println(local)
}
