package "main"

import "pkg/builtins/testing"

// Variant of 474 for managed-pointer (not managed-slice) element
// type — exercises the `isManagedPtrType` branch of the refcount
// handoff in genManagedSliceLit.  The failure guarded against is
// the same dangling-pointer shape as the managed-slice case — if the
// end-of-statement temp cleanup RefDec's the fresh @Node from
// makeNode, the node is freed before s[0].Val can read it.

type Node struct {
	Val int
}

func makeNode(v int) @Node {
	var n @Node = make(Node)
	n.Val = v
	return n
}

func main() {
	var s @[]@Node = @[]@Node{makeNode(10), makeNode(20), makeNode(30)}
	testing.Println(len(s))
	testing.Println(s[0].Val)
	testing.Println(s[1].Val)
	testing.Println(s[2].Val)
}
