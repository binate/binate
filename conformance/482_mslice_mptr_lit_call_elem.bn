package "main"

import "pkg/builtins/testing"

// Variant of 474 for managed-pointer (not managed-slice) element
// type — exercises the `isManagedPtrType` branch of the refcount
// handoff in genManagedSliceLit.  Pre-fix: same dangling-pointer
// shape as the managed-slice case — the fresh @Node from makeNode
// got RefDec'd by the end-of-statement temp cleanup, freeing the
// node before s[0].Val could read it.

type Node struct {
	Val int
}

func makeNode(v int) @Node {
	var n @Node = make(Node)
	n.Val = v
	return n
}

func main() {
	var s @[]@Node = @[]@Node{makeNode(10), makeNode(20), makeNode(30)}
	testing.Println(len(s))
	testing.Println(s[0].Val)
	testing.Println(s[1].Val)
	testing.Println(s[2].Val)
}
