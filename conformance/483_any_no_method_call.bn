package "main"

// Plan §6: `any` has no methods.  A method call through `*any` /
// `@any` must be rejected.  The error path goes through the
// regular method-lookup machinery (which fails to find the
// method on the empty interface) and surfaces as a clean
// "cannot access" / "cannot call" diagnostic — not a silent
// no-op or a vtable misdispatch.

func main() {
	var b int = 0
	var av *any = &b
	av.something()
	_ = av
}
