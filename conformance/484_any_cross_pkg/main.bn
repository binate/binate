package "main"

import "pkg/anyutil"

// Plan §6: universe `any` is registered in every module's
// moduleInterfaces (via InitModule → registerUniverseAny), so
// `*any` resolves to TYP_INTERFACE_VALUE in both the importing
// (main) and exporting (anyutil) packages with the same canonical
// identity (Pkg="", Name="any").  This test pins that a cross-
// package call passing `*any` works end-to-end: anyutil.Take's
// signature uses `*any`, main constructs `*any` from a local Box,
// and the iv flows across the package boundary without identity
// or layout mismatches.

type Box struct { x int }

func main() {
	var b Box
	b.x = 42
	anyutil.Take(&b)
}
