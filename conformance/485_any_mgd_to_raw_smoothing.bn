package "main"

import "pkg/builtins/testing"

// Plan §1 raw/managed iv table + §6: `@any` can be borrowed as
// `*any` at use sites (managed iv as raw iv source — same
// "managed acts as raw data ptr" rule that lets `@T` flow into
// `*Iface` directly).  The reverse (`*any → @any`) is rejected
// by 479 (no refcount invention).

type Box struct { x int }

func takesRaw(v *any) {
	testing.Println("raw any from mgd source")
}

func main() {
	var b @Box = make(Box)
	var mv @any = b
	takesRaw(mv)
}
