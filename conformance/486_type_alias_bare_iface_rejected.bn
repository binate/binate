package "main"

// Plan §4 of plan-interface-syntax-revision.md: bare interface
// names are not type expressions, so they can't appear on the RHS
// of a regular type alias (`type X = Y` expects Y to be a type
// expression).  The dedicated `interface X = Y` form covers
// interface-name aliasing; `type X = Y` does not.  Today this
// rejection happens via resolveTypeExpr's bare-interface error
// path (the same `errInterfaceNotAType` arm that rejects
// `var x Iface`); this test pins that behavior so a future
// refactor doesn't silently start accepting the form.

interface Greeter {
	greet()
}

type MyGreeter = Greeter

func main() {
	println("unreachable")
}
