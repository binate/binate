package "main"

import "pkg/bootstrap"

// Smoke test for bootstrap.Args() so the unit-test test-runner
// shape (which always calls Args at startup to parse --run) has
// an isolated conformance reproducer.  On a healthy build the
// program just prints "0" (no extra args passed by the runner).
// On arm32-linux unit-test builds the synthetic test runner was
// SEGV'ing at startup, and this test isolates whether Args() is
// the cause.

func main() {
	var args @[]@[]char = bootstrap.Args()
	println(len(args))
}
