package "main"

import "pkg/builtins/testing"

// Casting an integer literal whose value needs more than 32 bits
// to a 64-bit type must preserve the full value, even on 32-bit
// targets where the untyped-int default width is i32.  Without the
// cast-operand hint, the literal would be lowered at i32 first and
// truncated to its low word (0x0102030405060708 → 0x05060708) before
// the widening cast ran, losing the high bytes on arm32.  Pull each byte out via a
// uint64 shift and print it; the high byte (>> 56) is the
// canary — it reads 0 if the literal was truncated.

func main() {
	var v uint64 = cast(uint64, 0x0102030405060708)
	testing.Println(cast(int, (v >> 56) & cast(uint64, 255)))
	testing.Println(cast(int, (v >> 32) & cast(uint64, 255)))
	testing.Println(cast(int, v & cast(uint64, 255)))
}
