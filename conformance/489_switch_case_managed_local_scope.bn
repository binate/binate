package "main"

import "pkg/builtins/testing"

// Regression: a managed local declared inside a `switch case` body
// must be RefDec'd at the case's own scope exit, NOT at the enclosing
// function's exit.  Before the fix, genSwitch generated case bodies
// without a scope boundary, so `s` lingered in the function's
// variable list and got RefDec'd on EVERY return path — including the
// `return false` fall-through taken when op != 1.  On those paths the
// slot still held the slice from an earlier call that DID run case 1,
// so the spurious RefDec freed a still-live backing.

func handle(op int, src @[]char) bool {
	switch op {
	case 1:
		var s @[]char = src
		// Touch s so it isn't optimized away.
		if len(s) < 0 { return true }
		return true
	}
	return false
}

func main() {
	var x @[]char = make_slice(char, 4)
	x[0] = 'a'
	x[1] = 'b'
	x[2] = 'c'
	x[3] = 'd'
	// Run case 1 once (initializes the case-local slot with x's slice).
	handle(1, x)
	// Then many fall-through calls (op != 1 -> `return false`).  A
	// mis-scoped RefDec would free x's backing here.
	for i := 0; i < 64; i++ {
		handle(2, x)
	}
	// x must still be intact.
	testing.Println(len(x))
	testing.Println(cast(int, x[0]))
	testing.Println(cast(int, x[3]))
}
