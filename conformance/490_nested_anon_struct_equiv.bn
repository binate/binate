package "main"

// Nested anonymous structs: a parameter typed
// `struct { Inner struct { V int } }` accepts a value of the
// textually-identical nested shape.  The structural-identity check
// (types_query.bn `Identical`) must recurse through the inner
// anonymous struct — name empty on both sides at every level.
func readInner(p struct { Inner struct { V int } }) int {
	return p.Inner.V
}

func main() {
	var p struct { Inner struct { V int } }
	p.Inner.V = 42
	println(readInner(p))
}
