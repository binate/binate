package "main"

// Anonymous struct with a managed field passed across a function
// boundary: structural equivalence must match the `@Box` field, and
// the by-value copy into the parameter must RefInc the managed
// field (and RefDec it at both scopes' exit) so the value survives
// the call and is freed exactly once.
type Box struct {
	V int
}

func consume(b struct { P @Box }) int {
	return b.P.V
}

func main() {
	var b struct { P @Box }
	b.P = make(Box)
	b.P.V = 99
	println(consume(b))
	println(b.P.V)
}
