package "main"

// Generic-call type arguments in the type-only forms `@T`, `@[]T`,
// and `*[]T` — the shapes that have no expression spelling and so
// failed to parse before the EXPR_TYPE fix (CRITICAL "generic call
// type args reject @T / @[]T / *[]T").  Exercises a generic over a
// managed-pointer element (`@Node`), a managed-slice element
// (`@[]int`), and a raw-slice element (`*[]int`), all called with
// explicit type args (no inference, per claude-notes.md).

type Node struct {
	v int
}

func id[T any](x T) T {
	return x
}

func first[T any](s @[]T) T {
	return s[0]
}

func main() {
	// @T type arg: id over a managed pointer.
	var n @Node = make(Node)
	n.v = 42
	var n2 @Node = id[@Node](n)
	println(n2.v)

	// @[]T type arg: id over a managed-slice value.
	var row @[]int
	var got @[]int = id[@[]int](row)
	println(len(got))

	// *[]T type arg: id over a raw-slice value (a subslice of an
	// array borrows as `*[]int`).
	var arr [3]int
	arr[0] = 7
	arr[1] = 8
	arr[2] = 9
	var raw *[]int = id[*[]int](arr[:])
	println(raw[0])
}
