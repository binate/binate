package "main"

// A type-only form (`@T`) parses in bracket position (it's wrapped in
// EXPR_TYPE — see the generic-call type-arg fix), but it's only valid
// as a generic-instantiation type argument.  Used in value-index
// position on a non-generic head, the type checker rejects it via the
// EXPR_TYPE arm of checkExpr ("type not valid in expression
// position") rather than crashing or mis-parsing.

func main() {
	var arr @[]int
	var x int = arr[@int]
	_ = x
}
