package "main"

import "pkg/builtins/testing"

// Constructing an interface value from the address of a package-level
// global (`&g` where `g` is a global struct) must work the same as
// from a local.  The global's address has no SSA instr id, so an
// IR-gen that treats it like a local's emits an invalid data-pointer
// operand (codegen prints `%v-1`) and clang rejects the module.  The
// local-source shape is 357.

interface Greeter {
	greet() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int {
	return h.x
}

impl *Hello : Greeter

var g Hello

func main() {
	g.x = 42
	var iv *Greeter = &g
	testing.Println(iv.greet())
}
