package "main"

// Constructing an interface value from the address of a package-level
// global (`&g` where `g` is a global struct) must work the same as
// from a local.  Pre-fix: IR-gen emits an invalid data-pointer operand
// (the global's address has no SSA instr id, so codegen prints `%v-1`)
// and clang rejects the module.  Locals already work (357).

interface Greeter {
	greet() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int {
	return h.x
}

impl *Hello : Greeter

var g Hello

func main() {
	g.x = 42
	var iv *Greeter = &g
	println(iv.greet())
}
