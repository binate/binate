package "main"

import "pkg/builtins/testing"

// `*any` constructed from the address of a package global (`&g`).
// Same `&global` data-ptr path as 495, but via the universal-`any`
// synthesis (wrapAsIfaceValue) rather than a named interface — both
// the LLVM backend (pkg/binate/codegen) and the native aa64 backend
// (pkg/binate/native/aarch64) must materialize the global's address for the
// iface-value data slot.  Pre-fix this emitted `%v-1` (LLVM) /
// dropped the construction (native), same as 495.  `any` has an
// empty method set, so there's nothing to dispatch — observing that
// it compiles, runs, and the value flows into takesAny is the test
// (mirrors 470's local-source shape).

type Box struct {
	x int
}

func takesAny(v *any) {
	testing.Println("got an any")
}

var g Box

func main() {
	g.x = 42
	var v *any = &g
	takesAny(v)
}
