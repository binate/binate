package "main"
import "pkg/builtins/testing"

// Generic instantiation whose TYPE ARGUMENT is a struct from a
// THIRD package: genlib.Append[@things.Thing].  The generic
// (Append) lives in pkg/genlib; the type arg (@things.Thing) names
// a struct in pkg/things; the call is in main.  Regression for a
// mangling bug where a cross-package type arg made the instantiated
// function's definition and its call site mangle to different
// symbols — the dotted `things.Thing` token routed mangle.FuncName
// through its package-prefix-dropping (writeBnDotted) path, so the
// definition lost the consumer-package qualifier while the call
// kept it.  mangleTypeArg now emits a dot-free token
// (`things__Thing`), so the two sides agree.

import "pkg/genlib"
import "pkg/things"

func main() {
	var xs @[]@things.Thing
	var t0 @things.Thing = make(things.Thing)
	xs = genlib.Append[@things.Thing](xs, t0)
	var t1 @things.Thing = make(things.Thing)
	xs = genlib.Append[@things.Thing](xs, t1)
	testing.Println(len(xs))
}
