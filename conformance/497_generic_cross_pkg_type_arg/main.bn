package "main"
import "pkg/builtins/testing"

// Generic instantiation whose TYPE ARGUMENT is a struct from a
// THIRD package: genlib.Append[@things.Thing].  The generic
// (Append) lives in pkg/genlib; the type arg (@things.Thing) names
// a struct in pkg/things; the call is in main.  The instantiated
// function's definition and its call site must mangle to the same
// symbol: mangleTypeArg emits a dot-free token (`things__Thing`) for
// the cross-package type arg.  A dotted `things.Thing` token routes
// mangle.FuncName through its package-prefix-dropping
// (writeBnDotted) path, so the definition loses the consumer-package
// qualifier while the call keeps it.

import "pkg/genlib"
import "pkg/things"

func main() {
	var xs @[]@things.Thing
	var t0 @things.Thing = make(things.Thing)
	xs = genlib.Append[@things.Thing](xs, t0)
	var t1 @things.Thing = make(things.Thing)
	xs = genlib.Append[@things.Thing](xs, t1)
	testing.Println(len(xs))
}
