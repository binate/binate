package "main"

// __c_call invokes a verbatim C symbol with the C ABI (no Binate name
// mangling).  Calls libc's `int abs(int)`; C `int` is 32-bit on all
// our targets so the type is spelled `int32` (Binate `int` is
// target-word-width, ≠ C `int` on a 64-bit target).  Stage 1 of
// explorations/plan-c-call.md: fixed-arg, compiled mode, LLVM backend.
// xfail in VM modes (compiled-only for v1) and native-backend modes
// (Stage 2 implements OP_C_CALL in the native backends).

func main() {
	var r int32 = __c_call("abs", int32, cast(int32, -42))
	println(cast(int, r))
}
