package "main"

import "pkg/builtins/testing"

// End-to-end int64 arithmetic: an intermediate value > INT32_MAX
// requires real 64-bit arithmetic, and the final result fits a 32-bit
// int so cast(int, …) is lossless on every default target (incl.
// arm32-linux).  Exercises OP_CONST_INT (int64), OP_MUL (int64),
// OP_DIV (int64), and OP_CAST (int64 → int) — landing on BC_LOAD_IMM64
// / BC_MUL64 / BC_DIV64 / BC_NARROW64 when REG_SLOT < 8.
func main() {
	var x int64 = cast(int64, 1000000) * cast(int64, 1000) // 1e9
	var y int64 = x * cast(int64, 5) // 5e9 > INT32_MAX
	var z int64 = y / cast(int64, 7) // 714285714
	testing.Println(cast(int, z))
}
