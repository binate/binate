package "main"

// Variadic __c_call via the LLVM backend.  Calls libc's
// `int printf(const char *fmt, ...)`
// with one variadic int arg, expecting stdout `answer: 42\n`.
//
// The format string is a local [12]char that we take the address of,
// because Binate string literals default to a 2-word raw slice — the
// wrong shape for C's `const char *`.  Initialised byte-by-byte so
// the test doesn't depend on composite-literal syntax for arrays.
//
// xfail in VM modes (compiled-only for v1) and native arm32 (no
// native arm32 backend).  Passes on the LLVM modes and the
// native aa64/x64 lanes (darwin-arm64 in particular passes
// all varargs on the stack, not in registers).

func main() {
	var fmt [12]char
	fmt[0] = 'a'
	fmt[1] = 'n'
	fmt[2] = 's'
	fmt[3] = 'w'
	fmt[4] = 'e'
	fmt[5] = 'r'
	fmt[6] = ':'
	fmt[7] = ' '
	fmt[8] = '%'
	fmt[9] = 'd'
	fmt[10] = '\n'
	fmt[11] = '\0'
	var fmtPtr *uint8 = bit_cast(*uint8, &fmt[0])
	var n int32 = __c_call("printf", int32, fmtPtr, ..., cast(int32, 42))
	if n < 0 {
		println("printf reported error")
	}
}
