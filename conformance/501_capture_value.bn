package "main"

// Capturing function literals where the captures are non-managed (CAP_VAL +
// CAP_RAW_PTR).  The compiler synthesizes a closure struct, stores
// each capture into a field at the literal's evaluation site, and
// emits an OP_FUNC_VALUE with the struct pointer as the data slot.
// The per-shape `__shim` reads the captures back out of the data
// pointer and tail-calls the lifted body.
//
// Captures are by value: writes to the captured name OUTSIDE the
// closure, after construction, are not visible to the closure.

func apply(f *func(int) int, x int) int {
	return f(x)
}

func main() {
	// Single capture, used in the body.
	var base int = 10
	var addBase *func(int) int = func(x int) int { return base + x }
	println(addBase(5))   // 15

	// By-value: writes to `base` after construction do NOT propagate.
	base = 100
	println(addBase(5))   // still 15 (closure holds the snapshot of base=10)

	// Two captures with different types.
	var k int = 3
	var sign int = 1
	var combine *func(int) int =
		func(x int) int { return sign * (k + x) }
	println(combine(4))   // 7

	// Capture flowing into apply as a *func arg.
	var bias int = 100
	println(apply(func(y int) int { return bias + y }, 7))   // 107

	// Multiple capturing literals in the same function — distinct
	// closure structs, both alloca'd in main's frame.
	var a int = 2
	var b int = 5
	var fA *func(int) int = func(x int) int { return a * x }
	var fB *func(int) int = func(x int) int { return b + x }
	println(fA(4))   // 8
	println(fB(4))   // 9
}
