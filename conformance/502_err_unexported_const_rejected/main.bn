package "main"
import "pkg/builtins/testing"

import "pkg/hidden"

// `hidden.UNEXPORTED_CONST` is declared in pkg/hidden/hidden.bn but
// NOT in pkg/hidden.bni — so the import surface doesn't expose it.
// Any cross-package reference must consult the .bni only; this one
// must be rejected at the boundary.
//
// Accepting an unexported `pkg.NAME` reference would be a
// hard-to-spot miscompile: a NAME the type checker finds through an
// implementation-scope leak silently resolves to 0 at the use site.
func main() {
	testing.Println(hidden.UNEXPORTED_CONST)
}
