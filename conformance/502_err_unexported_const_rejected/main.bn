package "main"

import "pkg/hidden"

// `hidden.UNEXPORTED_CONST` is declared in pkg/hidden/hidden.bn but
// NOT in pkg/hidden.bni — so the import surface doesn't expose it.
// Any cross-package reference must consult the .bni only; this one
// must be rejected at the boundary.
//
// Without this pin, an unexported `pkg.NAME` reference compiled
// historically (silently resolving to 0 at the use site if the type
// checker found NAME through some implementation-scope leak) — a
// hard-to-spot miscompile.  See claude-todo's "bnc: cross-package
// references to non-.bni-exported decls" entry.
func main() {
	println(hidden.UNEXPORTED_CONST)
}
