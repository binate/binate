package "main"

// Method values: `x.M` bind a specific receiver instance to a method, producing
// a function value whose signature is the method's signature
// MINUS the receiver — calling the function value invokes the
// method with the bound receiver and the supplied user args.
//
// First cut: same-shape POINTER receiver only.  Value-T
// receivers work on LLVM but fail in VM/native lowering of the
// wrapper Func's struct-by-value calling convention; that case
// is covered by conformance/505_method_value_val (xfailed for
// VM/native pending follow-up).

type Counter struct {
	N int
}

func (c *Counter) Add(x int) int {
	return c.N + x
}

func (c *Counter) Bump(by int) {
	c.N = c.N + by
}

func apply(f *func(int) int, x int) int {
	return f(x)
}

func main() {
	var c Counter = Counter{N: 10}
	var cp *Counter = &c

	// Method value with pointer receiver, same-shape.
	var addCp *func(int) int = cp.Add
	println(addCp(5))   // 15

	// The captured *Counter still points at c, so c.N mutations
	// are visible through addCp.
	c.N = 100
	println(addCp(7))   // 107

	// Method value passed as a *func arg.
	var d Counter = Counter{N: 200}
	var dp *Counter = &d
	println(apply(dp.Add, 23))  // 223

	// Pointer-receiver void method value: mutate via the bound
	// receiver.
	var bumpCp *func(int) = cp.Bump
	bumpCp(1)
	println(c.N)  // 101 (was 100, +1)
}
