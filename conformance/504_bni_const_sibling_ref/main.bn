package "main"

import "pkg/x"

// Regression for a cross-package const-eval bug: a `.bni`-declared
// const whose initializer expression REFERENCES another const in
// the same package used to evaluate to 0 at consuming-package use
// sites.  The unqualified sibling reference (`WORDS`) wasn't
// retried as the import-qualified form (`pkg/x.WORDS`) when the
// simple lookup missed, so evalConstExpr's EXPR_IDENT arm returned
// (0, false) — and the binary expression `WORDS * <anything>`
// silently became 0.
//
// Discovered while refactoring pkg/builtins/rt's managed-allocation header
// (binate `9ac3a0e7`); `rt.HEADER_SIZE` (declared as
// `HEADER_WORDS * cast(int, sizeof(int))`) resolved to 0 in pkg/binate/vm
// and silently corrupted memory via `ptr - 0` offset arithmetic.
// Fixed in gen_const.bn by retrying with currentImportAlias when
// the unqualified lookup misses during import processing.
func main() {
	println(x.WORDS)        // 2
	println(x.TRIVIAL)      // 16 (WORDS * 8)
	println(x.WITH_SIZEOF)  // 16 on LP64; 8 on 32-bit target
}
