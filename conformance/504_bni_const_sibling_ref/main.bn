package "main"
import "pkg/builtins/testing"

import "pkg/x"

// Cross-package const evaluation: a `.bni`-declared const whose
// initializer expression REFERENCES another const in the same
// package must keep its value at consuming-package use sites.  When
// the simple lookup of the unqualified sibling reference (`WORDS`)
// misses during import processing, it must be retried as the
// import-qualified form (`pkg/x.WORDS`); without the retry the
// EXPR_IDENT lookup yields (0, false) and the binary expression
// `WORDS * <anything>` silently becomes 0 — for a header-size const
// such as `HEADER_WORDS * cast(int, sizeof(int))`, that corrupts
// memory via `ptr - 0` offset arithmetic.
func main() {
	testing.Println(x.WORDS)        // 2
	testing.Println(x.TRIVIAL)      // 16 (WORDS * 8)
	testing.Println(x.WITH_SIZEOF)  // 16 on LP64; 8 on 32-bit target
}
