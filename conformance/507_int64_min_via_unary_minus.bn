package "main"

import "pkg/builtins/testing"

// Constructs int64-min via `cast(int64, -9223372036854775807) -
// cast(int64, 1)` — the standard workaround for the fact that
// `-9223372036854775808` doesn't parse as a single literal (the
// minus is a unary operator applied to 9223372036854775808, which
// overflows int64-max as a positive magnitude).
//
// The unary-minus arg of the cast must go through the
// EXPR_UNARY-fold-aware path (genIntLitWithHint).  Lowered at
// TypUntypedInt instead, the inner literal gets intLL() = i32
// under the 32-bit target: 9223372036854775807 wraps to -1 in
// i32, `sub i32 0, -1` produces 1, and the outer cast widens that
// back to i64 — so the expression evaluates to 0 instead of
// int64-min on arm32.  Unit tests (TestBignumToIntInt64Min,
// TestFormatInt64Boundaries, TestWriteInt) use the same idiom;
// this conformance test pins the end-to-end shape for every
// backend.
//
// Verifies via the int64-min identity `int64-min == -int64-max - 1`:
// adds 1 back and prints `-int64-max` as a host-int-sized value
// (just the bottom decimal digit, since the print emits int and
// we want the test to survive both 32-bit and 64-bit `int`
// widths).  -9223372036854775807 ends in 7, so the bottom decimal
// digit of `(int64-min + 1)` is 7 → `(int64-min + 1) mod 10 ==
// -7` (signed two's-complement modulo).  We print the unsigned
// magnitude to avoid an asymmetric int-vs-int64 sign.
func main() {
	var lo int64 = cast(int64, -9223372036854775807) - cast(int64, 1)
	var back int64 = lo + cast(int64, 9223372036854775807)
	// back should be -1 — if the cast-int64-unary-minus path
	// truncated to host int, lo would have been 0 and back would
	// be int64-max, not -1.
	testing.Println(cast(int, back))
}
