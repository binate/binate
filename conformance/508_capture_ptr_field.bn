package "main"

// Regression for the B.2 latent bug where a closure that captures
// a raw pointer to a struct and reads `p.N` from its body returned
// 0 instead of the real field.  Root cause: the type-checker's
// view of `*Box` is `TYP_POINTER → TYP_NAMED(Box)`, but IR-gen's
// resolveTypeExpr strips the TYP_NAMED wrapper down to TYP_STRUCT
// — so the body's `genSelector` lookup, fed the checker's form
// through `resolveCaptureTypes`, missed the `isRawPtrToStruct`
// branch and fell through to the `EmitConstInt(0, …)` fallback.
// The fix: `resolveCaptureTypes` looks up the captured local's
// type via the IR-gen scope (`lookupVarType`) so prepended-
// capture params are shape-identical to non-captured params.

type Box struct { N int }
type Pair struct {
	A int
	B int
}

func main() {
	var b Box
	b.N = 7
	var p *Box = &b
	var f *func() int = func() int { return p.N }
	println(f())   // 7

	// By-value capture of the pointer: mutating *p AFTER the
	// closure construction IS visible to the body (the body
	// dereferences through the captured pointer, not through
	// a captured snapshot of b).
	b.N = 42
	println(f())   // 42

	// Multi-field read through the captured pointer.
	var pp Pair
	pp.A = 11
	pp.B = 22
	var ppRef *Pair = &pp
	var sum *func() int = func() int { return ppRef.A + ppRef.B }
	println(sum())   // 33

	// By-VALUE struct capture (CAP_VAL on a named struct).  Exercises
	// the same checker-vs-IR-gen divergence (TYP_STRUCT body of a
	// TYP_NAMED-wrapped type at the type-check side) — the captured
	// param's type must agree with the IR-gen form so the body's
	// EXPR_SELECTOR takes the TYP_STRUCT branch rather than the
	// EmitConstInt(0, …) fallback.  Captures are by value, so a
	// post-construction mutation of the outer struct is NOT visible.
	var s Box
	s.N = 55
	var sumS *func() int = func() int { return s.N + 1 }
	println(sumS())   // 56
	s.N = 999
	println(sumS())   // still 56 (snapshot)
}
