package "main"

// Capturing function literals with single-word CAP_MANAGED captures
// (`@T`).  For each
// managed capture:
//
//   * The closure construction site RefInc's the value before
//     storing it into the closure struct field — the closure owns
//     its own reference.
//   * The closure struct is registered in moduleStructs so the
//     standard dtor synthesis emits `__dtor_<closure_struct>`,
//     which RefDec's each managed field.
//   * The alloca'd closure-local is registered in ctx.Vars under a
//     synthetic name so the function's frame-end
//     emitDecForManagedLocals pass invokes the struct dtor — the
//     RefDec balances the RefInc above.
//
// Function values are still `*func(...)` (stack-allocated closure
// struct); `@func(...)` heap allocation is handled separately.
//
// Multi-word CAP_MANAGED captures (`@[]T`, etc.) — which the SysV-
// x64 ABI passes by MEMORY (stack) for aggregates > 16 bytes — are
// covered by 510_capture_managed_slice (xfailed on native_x64 until
// the closure-shim grows stack-spill support).

type Box struct { N int }

func main() {
	// Single @Box capture, field read through it.
	var b @Box = make(Box)
	b.N = 7
	var f *func() int = func() int { return b.N }
	println(f())   // 7

	// Mutating the captured @Box from outside IS visible — the
	// closure dereferences through the captured pointer.
	b.N = 99
	println(f())   // 99

	// Mixed captures: int (CAP_VAL) + @Box (CAP_MANAGED) +
	// *Box (CAP_RAW_PTR) — exercise the closure struct dtor's
	// "skip non-managed fields" branch.
	var k int = 100
	var rb @Box = make(Box)
	rb.N = 5
	var raw Box
	raw.N = 1
	var rp *Box = &raw
	var h *func() int = func() int { return k + rb.N + rp.N }
	println(h())   // 106
}
