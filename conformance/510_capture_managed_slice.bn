package "main"

// Slice B.3a extension: multi-word CAP_MANAGED captures (`@[]T`).
//
// On LLVM and the aa64 native backend this works through the same
// path as single-word managed captures — both ABIs pass the 32-byte
// @[]T value in 4 consecutive arg registers when register budget
// allows.  Under SysV-AMD64 the @[]T crosses the
// AggregateInRegMax=16 threshold and is passed entirely on the
// stack, which the current closure shim doesn't yet emit; that case
// is xfailed on native_x64 until the shim grows stack-spill support.

func main() {
	// @[]int capture, read and indexed inside the body.
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	var g *func(int) int = func(i int) int { return s[i] }
	println(g(0))   // 10
	println(g(2))   // 30
}
