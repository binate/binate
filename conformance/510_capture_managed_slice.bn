package "main"

// Slice B.3a extension: multi-word CAP_MANAGED captures (`@[]T`).
//
// Two scenarios:
//
//   1. Single `@[]T` capture with one user arg.  On LLVM and the
//      aa64 native backend this works through the same path as
//      single-word managed captures — both ABIs pass the 32-byte
//      `@[]T` value in 4 consecutive arg registers when register
//      budget allows.  Under SysV-AMD64 the `@[]T` crosses the
//      AggregateInRegMax=16 threshold and is passed entirely on
//      the outgoing-args stack area; the x64 shim's stack-spill
//      path reserves that area, shuttle-writes the 4 capture
//      words via RAX, then moves the user arg from RSI to RDI
//      and CALLs (rather than tail-JMPs) so the stack rewind
//      happens before RET.
//
//   2. A mix of a scalar capture and a `@[]T` capture with a
//      user arg — exercises the user-arg shift logic when one
//      capture is register-passed and the other is stack-passed.
//      Under SysV the int capture takes RDI, the @[]T capture
//      spills 4 words to the stack, and the user int lands in
//      RSI (NGRN advances past the int but the MEMORY @[]T
//      leaves NGRN at 1).

func main() {
	// @[]int capture, read and indexed inside the body.
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	var g *func(int) int = func(i int) int { return s[i] }
	println(g(0))   // 10
	println(g(2))   // 30

	// Mixed: int + @[]int.  The body uses both.
	var k int = 1000
	var t @[]int = make_slice(int, 2)
	t[0] = 7
	t[1] = 8
	var h *func(int) int = func(i int) int { return k + t[i] }
	println(h(0))   // 1007
	println(h(1))   // 1008

	// Two @[]int captures — both spill to the outgoing-args
	// stack area under SysV (each 4 words at non-overlapping
	// stack offsets).  Exercises the per-capture stkOff
	// iteration in the stack-spill path.
	var u @[]int = make_slice(int, 2)
	u[0] = 50
	u[1] = 60
	var v @[]int = make_slice(int, 2)
	v[0] = 500
	v[1] = 600
	var w *func(int) int =
		func(i int) int { return u[i] + v[i] }
	println(w(0))   // 550
	println(w(1))   // 660
}
