package "main"

import "pkg/builtins/testing"

// Method values with a managed-pointer receiver `cp @T`.  The
// closure struct stores the @T receiver, the construction site
// RefInc's it (so the closure owns its own reference), and the
// frame-end dtor RefDec's the stored receiver.  Once the gate in
// gen_method_value.bn is lifted, the existing closure-struct
// cleanup infrastructure (registerClosureStructForCleanup +
// defineVar of `__mv_local_<n>`) drives the dtor synthesis and
// invocation.
//
// 503 / 505 / 506 already pin the *T-receiver / T-receiver /
// void-method-value shapes; this test pins the @T-receiver one.
//
// Naming subtlety the implementation has to get right: the
// methodValueWrapperName carries dots (`main.Counter.Sum…`),
// but `generateDtors`' Pass 2 treats any dot-bearing struct
// Name as cross-package — so `buildMethodValueClosureStruct`
// folds the dots to underscores before forming the closure
// struct's Name, keeping it in Pass 1's local-dtor regime
// where definition and call agree on the symbol.

type Counter struct { N int }

func (c @Counter) Sum(x int) int { return c.N + x }

func main() {
	var c @Counter = make(Counter)
	c.N = 10
	var f *func(int) int = c.Sum
	testing.Println(f(5)) // 15

	// The captured @Counter still points at c, so subsequent
	// field mutations ARE visible — managed-ptr receivers
	// behave the same as raw-ptr receivers from the body's
	// perspective.
	c.N = 100
	testing.Println(f(7)) // 107

	// Re-take the method value to confirm RefInc bookkeeping
	// across multiple closure constructions.  Both g and f
	// share the same heap @Counter; the closure struct's dtor
	// must RefDec independently for each.
	var g *func(int) int = c.Sum
	testing.Println(g(1)) // 101
}
