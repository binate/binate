package "main"
import "pkg/builtins/testing"

// Opaque cross-package handle: pkg/handle.bni declares
//   type Handle              // forward decl — opaque to callers
//   func New(v int) @Handle
//   func Get(h @Handle) int
// and pkg/handle/handle.bn provides the full struct body.  Callers
// (this main) see Handle as opaque: they can hold @Handle but
// cannot access fields directly — they must go through New/Get.
//
// Round-trip property: New(42) → Get → 42 (printed).
//
// The opaque-type-cross-package property tested here is independent
// of where the underlying Handle lives.  An earlier version used
// `*Handle` + stack-local + `return &h`, which is UB (raw pointers
// don't extend lifetime; the local dies at function return — see
// the allocation-transparency note).  Use `@Handle` + `make` so the
// program is well-defined on every target.

import "pkg/handle"

func main() {
	testing.Println(handle.Get(handle.New(42)))
}
