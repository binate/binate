package "main"

// Opaque cross-package handle: pkg/handle.bni declares
//   type Handle              // forward decl — opaque to callers
//   func New(v int) *Handle
//   func Get(h *Handle) int
// and pkg/handle/handle.bn provides the full struct body.  Callers
// (this main) see Handle as opaque: they can hold *Handle but
// cannot access fields directly — they must go through New/Get.
//
// Round-trip property: New(42) → Get → 42 (printed).
// Pre-Phase-3b, this pattern broke at LLVM emit time because the
// bni-side signature resolved *Handle as opaque ptr while the
// bn-side body's `return &h` emitted the struct value (not its
// pointer), producing `ret %Handle` against a `define ptr`
// signature.  See explorations/plan-type-decls.md Phase 3b.

import "pkg/handle"

func main() {
	println(handle.Get(handle.New(42)))
}
