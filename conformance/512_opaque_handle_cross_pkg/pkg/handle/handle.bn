package "pkg/handle"

type Handle struct {
	value int
}

// New heap-allocates a Handle and returns it as the opaque
// @Handle type.  Callers (different package) see @Handle as
// opaque and can only manipulate it via New / Get.
//
// Heap-allocation (via `make`) — not stack — is deliberate.  A
// `var h Handle; return &h` would be UB by Binate's lifetime
// rules (raw pointers are unmanaged; `&local` ends with the
// function).  The opaque-type-cross-package property this test
// exercises is independent of stack-vs-heap; using `make` makes
// the lifetime well-defined.
func New(v int) @Handle {
	var h @Handle = make(Handle)
	h.value = v
	return h
}

func Get(h @Handle) int { return h.value }
