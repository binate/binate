package "main"

import "pkg/builtins/testing"

// Function literals can flow into `@func(...)` slots, not just
// `*func(...)`.  For
// NON-capturing literals (this test) the data slot is nil — `*func`
// and `@func` are operationally identical, but the type-checker
// previously rejected `var f @func() = func() {...}` because the
// literal always resolved as `*func` and there's no
// `*func → @func` assignability rule.
//
// Mechanism: a transient `ExpectedFVType` hint on the Checker, set
// by VarDecl with a function-value type, lets `checkFuncLit`
// resolve the literal as @func when the signature matches.  IR-gen
// reads `Expr.ResolvedTypeID` — for non-capturing literals the
// emit shape is unchanged (a {vtable, null} value).
//
// Capturing @func literals (heap-allocated closure struct) are
// covered separately.

func apply(f *func(int) int, x int) int {
	return f(x)
}

func main() {
	// Bare @func variable initialised from a non-capturing
	// literal — the previously-rejected shape.
	var f @func() int = func() int { return 42 }
	testing.Println(f()) // 42

	// @func taking an int arg.  The literal's data slot is nil
	// since there are no captures; the @func value is
	// {vtable, null} just like a *func.
	var g @func(int) int = func(x int) int { return x * 2 }
	testing.Println(g(7)) // 14

	// @func is callable directly via OP_CALL_FUNC_VALUE, same
	// dispatch path as *func.
	testing.Println(g(10)) // 20

	// Decay: a non-capturing @func should not lose its callability
	// when passed across the *func boundary.  We don't yet allow
	// arbitrary @func → *func assignment, but `apply` takes a *func
	// and the literal it captures inside has the @ contextual hint
	// inherited from no surrounding declaration — falls back to the
	// raw form by default.  Exercises the hint-absent path.
	testing.Println(apply(func(y int) int { return y + 100 }, 5)) // 105
}
