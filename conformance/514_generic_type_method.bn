package "main"

// Methods on generic types (gen.method.generic-recv): a method whose
// receiver is a generic-type instantiation resolves to the per-
// instantiation monomorphized body via direct (non-interface) dispatch.

type Box[T any] struct {
	val T
}

func (b *Box[T]) Get() T {
	return b.val
}

func main() {
	var b Box[int]
	b.val = 42
	println(b.Get())
}
