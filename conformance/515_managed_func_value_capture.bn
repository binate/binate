package "main"

import "pkg/builtins/testing"

// Capturing function literals that flow into @func(...) slots — the closure
// struct is heap-allocated (EmitMake) instead of stack-alloc'd, the
// vtable's dtor slot points at the closure-struct dtor, and the
// @func variable's scope-end RefDec on its data slot runs that dtor
// before freeing the struct.  This is what makes @func capturing
// literals safe across scope boundaries — a *func capturing literal
// would dangle.

type Box struct { N int }

func main() {
	// @func variable initialised from a capturing literal.  The
	// captured @Box's refcount increments at construction; the
	// closure struct's dtor RefDec's it at end of scope when the
	// @func value goes away.
	var b @Box = make(Box)
	b.N = 7
	var f @func() int = func() int { return b.N }
	testing.Println(f()) // 7

	// Mutating the captured @Box from outside IS visible — the
	// closure dereferences through the captured managed pointer.
	b.N = 99
	testing.Println(f()) // 99

	// Multiple captures of different shapes co-exist in a single
	// @func — int (CAP_VAL), @Box (CAP_MANAGED), and *Box
	// (CAP_RAW_PTR) — and the closure-struct dtor walks only the
	// managed fields, skipping the others.
	var k int = 100
	var rb @Box = make(Box)
	rb.N = 5
	var raw Box
	raw.N = 1
	var rp *Box = &raw
	var h @func() int = func() int { return k + rb.N + rp.N }
	testing.Println(h()) // 106
}
