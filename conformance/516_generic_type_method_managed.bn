package "main"

// Methods on generic types (gen.method.generic-recv): a managed receiver
// (@Box[T]) with a parameter method that mutates a field, then a second
// method reads it back — both monomorphized for Box[int].

type Box[T any] struct {
	val T
}

func (b @Box[T]) Set(v T) {
	b.val = v
}

func (b @Box[T]) Get() T {
	return b.val
}

func main() {
	var b @Box[int] = make(Box[int])
	b.Set(7)
	println(b.Get())
}
