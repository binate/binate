package "main"

import "pkg/builtins/testing"

// Pins the AAPCS64 SPLIT-aggregate case in the closure shim:
// a capture whose word count straddles the GP-arg-reg budget
// (with `SplitAggregates = true`) lands part in registers, part
// in the outgoing-args stack area.  The `emitClosureShim`'s
// stack-spill path must handle BOTH halves — the reg portion at
// argReg(regStart..NumGpArgRegs-1) and the stack portion at
// [SP + stkOff + (k - firstStackWord)*8] for k starting at the
// regWords boundary.
//
// Shape: five `int` captures take X0..X4 (NGRN=5), then a single
// `@[]int` capture (4 words) needs X5..X7 plus one stack word —
// classic SPLIT.  Under SysV-AMD64 (where SplitAggregates=false)
// the @[]int instead goes entirely on the stack, exercising the
// pure-MEMORY path; either way the shim's stack-spill prologue
// fires.
//
// The body returns the slice element plus the sum of the int
// captures, so the closure can only produce the right answer if
// every capture word lands in the right place.

func main() {
	var a int = 1
	var b int = 2
	var c int = 4
	var d int = 8
	var e int = 16
	var s @[]int = make_slice(int, 2)
	s[0] = 100
	s[1] = 200
	// Total captures: 5 ints (5 words) + @[]int (4 words) = 9
	// outgoing arg words.  Plus the user-arg `i` (1 word) = 10.
	// AAPCS64: 5 ints in X0..X4, @[]int SPLITs at NGRN=5 into
	// X5..X7 (3 words) + [SP+0] (1 word), user-arg `i` at
	// [SP+8].  SysV-AMD64: 5 ints in RDI..R8, @[]int entirely
	// on [RSP+0..24], user-arg `i` at R9 (NGRN stayed at 5
	// after the MEMORY @[]int).
	var f *func(int) int = func(i int) int {
		return s[i] + a + b + c + d + e
	}
	testing.Println(f(0)) // 131  (100 + 1+2+4+8+16)
	testing.Println(f(1)) // 231  (200 + 1+2+4+8+16)
}
