package "main"

import "pkg/builtins/testing"

// Coverage for the closure-shim per-word load path when a capture
// is a small aggregate (≤ AggregateInRegMax = 16 bytes) — does NOT
// qualify for the IndirectLargeAggregates pointer-pass.  Both
// native ABIs spread such aggregates across ≤ 2 GP arg regs at
// the body's calling boundary, and the shim must per-word load
// them from the closure struct into those regs.
//
// The other 5xx capture tests cover:
//   * single-word scalar / pointer (509 / 511)
//   * indirect-large in-reg pointer-pass (510 single @[]T)
//   * indirect-large stack-spill + SPLIT (517 5 ints + @[]T)
//
// This test pins the gap: a 16-byte struct capture, exercised
// across both backends, in both fast-path (no stack frame) and
// no-overflow shapes.

type Pair struct {
	A int
	B int
}

func main() {
	// Single 16-byte struct capture.  Per-word load: two Ldr/Mov
	// instructions from [closure_ptr + 0] and [closure_ptr + 8]
	// into X0/X1 (aa64) or RDI/RSI (x64), then B/JMP underlying.
	var p Pair
	p.A = 100
	p.B = 200
	var f *func() int = func() int { return p.A + p.B }
	testing.Println(f()) // 300

	// Two 16-byte struct captures — exercises the right-to-left
	// per-word load ordering when multiple per-word captures
	// coexist.  Total 4 reg-words; user-arg int makes 5; well
	// within the 6/8 budgets.
	var q Pair
	q.A = 1
	q.B = 2
	var g *func(int) int = func(z int) int { return p.A + q.B + z }
	testing.Println(g(7)) // 109
}
