package "main"

import "pkg/builtins/testing"

// B.4 cross-shape smoothing for method values, per plan-function-
// values-phase-2.md §"Method values x.M":
//
//   | Method takes | x's type | Captured form           |
//   |--------------|----------|-------------------------|
//   | T            | T        | T copy                  |
//   | T            | *T / @T  | T copy via deref        |
//   | *T           | T        | *T = &x  (smoothing)    |
//   | *T           | *T       | *T snapshot             |
//   | *T           | @T       | *T from @T (smoothing)  |
//   | @T           | @T       | @T (RefInc'd)           |
//
// The closure struct holds the captured form (the method's
// declared receiver shape), NOT x's type — so two call sites
// whose smoothings settle on the same captured form share one
// wrapper.  At the construction site `genCapturedRecv` emits
// the address-of / deref / bitcast that bridges x → captured
// form.

type Counter struct { N int }

func (c *Counter) Add(x int) int { return c.N + x }

// Sum is a VALUE-receiver method, exercised by the deref smoothing
// paths below (*T → T and @T → T).
func (c Counter) Sum(x int) int { return c.N + x }

func main() {
	// c:T, method takes *T → captured *T = &c.  Pre-fix the
	// wrapper stored c as a value and called Add with the wrong
	// receiver shape; the body read garbage.
	var c Counter
	c.N = 10
	var f *func(int) int = c.Add
	testing.Println(f(5)) // 15

	// Mutating c after the value is constructed IS visible —
	// the closure holds &c, the body deref's through it.
	c.N = 100
	testing.Println(f(7)) // 107

	// cp:*T, method takes *T → captured *T (no smoothing, same
	// shape).  Should still work.
	var d Counter
	d.N = 20
	var dp *Counter = &d
	var g *func(int) int = dp.Add
	testing.Println(g(3)) // 23

	// b:@T, method takes *T → captured *T (smoothing: bitcast
	// managed to raw).  The captured raw pointer's lifetime
	// piggy-backs on b; the closure does NOT RefInc b.
	var bx @Counter = make(Counter)
	bx.N = 1000
	var h *func(int) int = bx.Add
	testing.Println(h(11)) // 1011

	// rp:*T, method takes T → captured T copy via deref.
	// The closure holds a snapshot of *rp; mutations to *rp
	// after construction are NOT visible (value-receiver
	// semantics).
	var rv Counter
	rv.N = 30
	var rp *Counter = &rv
	var k *func(int) int = rp.Sum
	testing.Println(k(2)) // 32
	rv.N = 999 // mutation post-construction
	testing.Println(k(2)) // still 32 (snapshot)

	// mb:@T, method takes T → captured T copy via deref.
	// Same snapshot semantics; the @T's refcount is unaffected
	// by the closure's T-by-value copy.
	var mb @Counter = make(Counter)
	mb.N = 40
	var mfn *func(int) int = mb.Sum
	testing.Println(mfn(1)) // 41
	mb.N = 999
	testing.Println(mfn(1)) // still 41 (snapshot)
}
