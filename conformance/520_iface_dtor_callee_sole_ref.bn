package "main"

import "pkg/builtins/rt"

// Pins the @Iface scope-end cleanup path that emit_impls.bn's
// `emitImplVtableDtorSlot` backs.  Distinct from 370: there, the
// holder enters consume with refcount 2 (caller-side RefInc), so
// consume's iface-arg RefDec goes 2 → 1 and ZeroRefDestroy is
// skipped — the broken pre-fix shape (raw dtor fn ptr in @__ivt
// slot 0) was never exercised in 370 because of that masking.
//
// Here, consume gets the SOLE reference to the holder via a make-
// and-pass pattern.  When consume returns, the iface-arg refcount
// goes 1 → 0 and the iface cleanup path runs Holder's dtor — which
// itself RefDec's the captured @Inner.  Before the fix, that
// dispatch would byte-pun-read Holder dtor's machine code as a
// {vtable, data} struct.

interface Foo {
	foo() int
}

type Inner struct {
	V int
}

type Holder struct {
	Inner @Inner
}

func (h *Holder) foo() int {
	return h.Inner.V
}

impl *Holder : Foo

// Constructs Holder and hands its sole reference to the caller as
// an @Foo.  Once consume is called with this value, the only path
// to the holder is via consume's iface arg — its scope-end
// cleanup drives refcount to 0 and runs the dtor.
func makeFoo(inner @Inner) @Foo {
	var h @Holder = make(Holder)
	h.Inner = inner
	return h
}

func consume(t @Foo) {
	print("foo=")
	println(t.foo())
}

func main() {
	var inner @Inner = make(Inner)
	inner.V = 42
	var ptr *uint8 = bit_cast(*uint8, inner)

	print("inner-rc-before: ")
	println(rt.Refcount(ptr))

	consume(makeFoo(inner))

	print("inner-rc-after: ")
	println(rt.Refcount(ptr))
}
