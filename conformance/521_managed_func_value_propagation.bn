package "main"

import "pkg/builtins/testing"

// The @func context propagates through the type-checker to return
// statements and call args, not only to `var x @func(...) = <lit>`:
// `return <capturing lit>` from a function declaring `@func(...)`
// returns, and `f(<capturing lit>)` for `f g @func(...)`, both
// resolve the literal as @func and heap-alloc the closure struct, so
// it correctly outlives the constructing frame.  Without the hint
// these shapes would either error (raw `*func` not assignable to
// `@func`) or — if AssignableTo were permissive — silently
// stack-alloc the closure despite the @func declared lifetime.

type Box struct { N int }

// Returns a capturing @func literal — the closure outlives
// makeAdder's frame via the @func's heap allocation + dtor.
func makeAdder(base int) @func(int) int {
	return func(x int) int { return base + x }
}

// Returns a capturing @func over an @T capture.  Exercises both
// the return-position propagation AND the closure dtor's
// @T-capture cleanup that 67952cf1 fixed.
func makeBoxAdder(b @Box) @func(int) int {
	return func(x int) int { return b.N + x }
}

// Takes an @func arg — call-arg position must propagate the
// declared @func hint so the caller's capturing literal resolves
// as @func and heap-allocs.
func runWith(f @func(int) int, x int) int {
	return f(x)
}

func main() {
	// Return-position propagation: makeAdder returns @func.
	var f @func(int) int = makeAdder(10)
	testing.Println(f(5)) // 15
	testing.Println(f(7)) // 17

	// Return-position with @T capture (exercises both the
	// propagation and the closure dtor cleanup path).
	var b @Box = make(Box)
	b.N = 100
	var g @func(int) int = makeBoxAdder(b)
	testing.Println(g(1)) // 101
	testing.Println(g(2)) // 102

	// Call-arg propagation: runWith receives a capturing literal
	// directly.  Without propagation the literal would resolve as
	// *func and fail assignability (or silently stack-alloc).
	var k int = 1000
	testing.Println(runWith(func(x int) int { return k + x }, 23)) // 1023
}
