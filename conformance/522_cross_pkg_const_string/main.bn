package "main"

// Regression guard for binate 7b0f77a3: top-level consts of type
// `*[]readonly char` (string consts) used to silently emit
// EmitConstInt(0, TypInt()) at every read site — in-package reads
// produced malformed LLVM IR (extractvalue on a scalar) and
// cross-package qualified reads through EXPR_SELECTOR produced
// zero-length empty strings.  The fix routes string-typed
// ModuleConst entries through EmitConstString + EmitStringToChars
// at both EXPR_IDENT and qualified EXPR_SELECTOR read sites.
//
// This conformance test pins the cross-package case end-to-end:
// `strlib.Greeting`'s value must round-trip from the imported
// .bni's `const = "hello"` declaration to main's println output.

import "pkg/strlib"

func main() {
	println(strlib.Greeting)
	println(len(strlib.Greeting))
	// In-package read inside the imported package: strlib.Echo
	// returns Greeting via a same-package read, so its output
	// pins the EXPR_IDENT-in-package branch too.
	println(strlib.Echo())
}
