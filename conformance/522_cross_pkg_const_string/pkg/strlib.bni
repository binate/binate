package "pkg/strlib"

// Public string-typed const declared with value in the .bni so
// importers see the literal at compile time.  This is the shape
// pkg/binate/version's Version uses.
const Greeting *[]const char = "hello"

// Echo returns Greeting via an in-package read — exercises the
// EXPR_IDENT in-package-read path inside the declaring package,
// separately from main's EXPR_SELECTOR cross-package read.
func Echo() *[]const char
