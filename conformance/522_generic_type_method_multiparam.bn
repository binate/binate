package "main"

import "pkg/builtins/testing"

// Methods on generic types (gen.method.generic-recv): a multi-parameter
// generic type binds all its receiver params positionally, and each method
// is monomorphized for the concrete Pair[int, int].

type Pair[K any, V any] struct {
	k K
	v V
}

func (p *Pair[K, V]) First() K {
	return p.k
}

func (p *Pair[K, V]) Second() V {
	return p.v
}

func main() {
	var p Pair[int, int]
	p.k = 5
	p.v = 9
	testing.Println(p.First())
	testing.Println(p.Second())
}
