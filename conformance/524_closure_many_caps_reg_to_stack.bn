package "main"

import "pkg/builtins/testing"

// Exercises the native closure-shim's stack-spill path on the
// reg-source → stack-dest transfer shape: an incoming-register
// user-arg pushed onto the outgoing-stack because captures
// consume the low register slots.
//
// AAPCS64 layout: 3 captures + 8 user-args = 11 reg words but
// only 8 GP arg slots available, so 3 user-arg words spill to
// outgoing stack.  Incoming: data=X0, args 0..6 in X1..X7 (7 reg
// args), arg 7 on the caller's stack.  Outgoing: caps 0..2 in
// X0..X2, args 0..4 in X3..X7 (5 reg args), args 5..7 on stack.
// Shape mix exercised by the post-67952cf1 stack-spill path:
//   * arg 0 (X1 → X3): reg→reg forward shift.
//   * arg 5 (X6 → stack outStkOff=0): reg→stack.
//   * arg 6 (X7 → stack outStkOff=8): reg→stack.
//   * arg 7 (stack → stack outStkOff=16): stack→stack via X16
//     shuttle — the path my new code added.
//
// SysV-AMD64 layout: 3 caps + 8 user-args = 11 reg words >
// 6 GP arg slots, so 5 spill.  Incoming: data=RDI, args 0..4
// in RSI..R9 (5 reg), args 5..7 on stack.  Outgoing: caps
// 0..2 in RDI..RDX, args 0..2 in RCX..R9, args 3..7 on stack.
// Same shape mix.  Hits the pre-existing main-frame-alloc
// CRITICAL bug on x64 (see claude-todo.md "x64 native: closure
// struct allocated in outgoing-args area"); xfail'd accordingly.

func main() {
	var p int = 1000
	var q int = 2000
	var r int = 3000
	var f *func(int, int, int, int, int, int, int, int) int = func(a int, b int, c int, d int, e int,
			g int, h int, i int) int {
				return p + q + r + a + b + c + d + e + g + h + i
			}
	// Expected: 1000+2000+3000 + 1+2+3+4+5+6+7+8 = 6036.
	testing.Println(f(1, 2, 3, 4, 5, 6, 7, 8))
}
