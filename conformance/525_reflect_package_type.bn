package "main"

import "pkg/builtins/reflect"

// Foundation check for Phase B (package descriptors): the tier-0
// pkg/builtins/reflect package and its Package type load and are usable as
// an ordinary value.  Later slices add the compiler-generated immortal
// static-managed Package node + the __Package() accessor.
func main() {
	var p reflect.Package
	p.Name = "pkg/main"
	println(p.Name)
}
