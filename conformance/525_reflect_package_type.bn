package "main"

import "pkg/builtins/testing"

import "pkg/builtins/reflect"

// Foundation check for package descriptors: the tier-0
// pkg/builtins/reflect package and its Package type load and are usable as
// an ordinary value.  The compiler-generated immortal static-managed
// Package node and the __Package() accessor are covered by 532.
func main() {
	var p reflect.Package
	p.Name = "pkg/main"
	testing.Println(p.Name)
}
