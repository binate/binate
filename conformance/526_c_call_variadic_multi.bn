package "main"

// Stage 4 of plan-c-call.md, multi-vararg case: __c_call printf with
// THREE variadic int args.  Companion to 500_c_call_variadic (single
// vararg) — exercises the darwin-arm64 rule that forces EVERY
// variadic arg onto the stack (so multiple varargs land in
// consecutive stack slots past the format pointer), and amd64-SysV's
// register-then-stack vararg packing with AL=0.  Expects stdout
// `11 22 33\n`.
//
// xfail in VM modes (compiled-only for v1) and native arm32 (no
// native arm32 backend); passes on the LLVM modes + native aa64/x64.
func main() {
	var fmt [13]char
	fmt[0] = '%'; fmt[1] = 'd'; fmt[2] = ' '
	fmt[3] = '%'; fmt[4] = 'd'; fmt[5] = ' '
	fmt[6] = '%'; fmt[7] = 'd'; fmt[8] = '\n'; fmt[9] = '\0'
	var fmtPtr *uint8 = bit_cast(*uint8, &fmt[0])
	var n int32 = __c_call("printf", int32, fmtPtr, ...,
		cast(int32, 11), cast(int32, 22), cast(int32, 33))
	if n < 0 { println("printf error") }
}
