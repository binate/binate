package "main"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

// End-to-end Phase B (package descriptors): call the compiler-generated
// _Package() accessor on an imported package, read the descriptor's Name,
// and let the returned @reflect.Package drop at scope exit.  This drives a
// real immortal static-managed reflect.Package node through the compiled
// (and, in -int modes, the VM) RefInc/RefDec sentinel path — RefDec on the
// negative-refcount node is a no-op rather than a free.
//
// _Package() is not declared in any .bni; the type checker synthesizes its
// `() @reflect.Package` signature and codegen emits the node + body.
func main() {
	var p @reflect.Package = rt._Package()
	println(p.Name)
}
