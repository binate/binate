package "main"

// Stage 4 of plan-c-call.md, variadic + stack-overflow case:
// __c_call printf with SEVEN variadic int args (1 fixed format
// pointer + 7 varargs = 8 GP args).  This pushes varargs past the
// register budget on BOTH backends:
//   - amd64-SysV: RDI holds the format pointer; the first 5 varargs
//     fill RSI/RDX/RCX/R8/R9 and the last 2 spill to the outgoing-
//     args stack area (the combination 500/527 — <=3 varargs, all in
//     registers on x64 — never reach).
//   - darwin-arm64: Apple's rule forces every vararg onto the stack,
//     so all 7 land in consecutive stack slots past X0.
// Expects stdout `1234567\n`.
//
// xfail in VM modes (compiled-only for v1) and native arm32 (no
// native arm32 backend); passes on the LLVM modes + native aa64/x64.
func main() {
	var fmt [16]char
	fmt[0] = '%'; fmt[1] = 'd'; fmt[2] = '%'; fmt[3] = 'd'
	fmt[4] = '%'; fmt[5] = 'd'; fmt[6] = '%'; fmt[7] = 'd'
	fmt[8] = '%'; fmt[9] = 'd'; fmt[10] = '%'; fmt[11] = 'd'
	fmt[12] = '%'; fmt[13] = 'd'; fmt[14] = '\n'; fmt[15] = '\0'
	var fmtPtr *uint8 = bit_cast(*uint8, &fmt[0])
	var n int32 = __c_call("printf", int32, fmtPtr, ...,
		cast(int32, 1), cast(int32, 2), cast(int32, 3), cast(int32, 4),
		cast(int32, 5), cast(int32, 6), cast(int32, 7))
	if n < 0 { println("printf error") }
}
