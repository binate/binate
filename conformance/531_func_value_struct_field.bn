package "main"

// Mirrors the REPL's ReplIO sink + setupReplState: a non-capturing
// @func lives in a struct field of a MANAGED struct that is RETURNED
// from a function (build), then invoked via the returned struct's
// field.  The compiled backends handle this; the bni VM crashes with
// "vm: unsupported function-value data kind: 0" — returning/copying the
// managed aggregate gives the @func a non-nil data slot whose kind word
// is 0, which BC_CALL_FUNC_VALUE rejects.  Root cause: the VM's
// non-capturing @func borrows the shared per-callee ClosureRec without
// RefInc, but @func locals RefDec their data at scope end — so the
// returned-out copy's shared rec is freed by build()'s scope-end RefDec.
// Fixed by RefInc'ing the ClosureRec at non-capturing construction
// (BC_FUNC_VALUE), balancing the scope-end RefDec.  Regression test
// across all modes (compiled + int).

type Sink struct {
	W @func(*[]readonly char) int
}

type Sess struct {
	Io Sink
}

func build() @Sess {
	var w @func(*[]readonly char) int = func(s *[]readonly char) int {
		return len(s)
	}
	var io Sink
	io.W = w
	var s @Sess = make(Sess)
	s.Io = io
	return s
}

func main() {
	// Two independent @Sess values, each holding a @func that shares the
	// SAME per-callee ClosureRec.  Both must survive their build()
	// frame's scope-end RefDec and call cleanly — a refcount that
	// over/under-counts the shared rec across instances would free it
	// (crash) or leak it.
	var a @Sess = build()
	var b @Sess = build()
	println(a.Io.W("hello"))
	println(b.Io.W("hi"))
}
