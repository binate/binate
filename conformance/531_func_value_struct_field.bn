package "main"

import "pkg/builtins/testing"

// Mirrors the REPL's ReplIO sink + setupReplState: a non-capturing
// @func lives in a struct field of a MANAGED struct that is RETURNED
// from a function (build), then invoked via the returned struct's
// field.  @func locals RefDec their data at scope end, so the VM's
// non-capturing construction (BC_FUNC_VALUE) RefIncs the shared
// per-callee ClosureRec to balance it.  A VM that borrows the rec
// without RefInc frees the returned-out copy's shared rec at build()'s
// scope-end RefDec: returning/copying the managed aggregate then gives
// the @func a non-nil data slot whose kind word is 0, which
// BC_CALL_FUNC_VALUE rejects ("vm: unsupported function-value data
// kind: 0").  Runs in all modes (compiled + int).

type Sink struct {
	W @func(*[]readonly char) int
}

type Sess struct {
	Io Sink
}

func build() @Sess {
	var w @func(*[]readonly char) int = func(s *[]readonly char) int {
		return len(s)
	}
	var io Sink
	io.W = w
	var s @Sess = make(Sess)
	s.Io = io
	return s
}

func main() {
	// Two independent @Sess values, each holding a @func that shares the
	// SAME per-callee ClosureRec.  Both must survive their build()
	// frame's scope-end RefDec and call cleanly — a refcount that
	// over/under-counts the shared rec across instances would free it
	// (crash) or leak it.
	var a @Sess = build()
	var b @Sess = build()
	testing.Println(a.Io.W("hello"))
	testing.Println(b.Io.W("hi"))
}
