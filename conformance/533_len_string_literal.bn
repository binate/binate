package "main"

// len() on a bare string literal.  A string literal's default type is a
// slice (@[]readonly char), so len("true") is 4 (see claude-notes,
// "No string type": default type @[]readonly char with len() = N).
//
// Currently xfails on compiled backends: a bare string-literal operand
// to len is lowered as a bare data pointer instead of a {ptr,len} slice
// aggregate, so len's length-field extract produces invalid IR.
func main() {
	var n int = len("true")
	if n == 4 {
		println("ok")
	} else {
		println("bad")
	}
}
