package "main"

// len() applied directly to a bare string literal.  A string literal's
// default type is a slice (@[]readonly char with len() = N), so len of a
// literal is its unescaped byte length, known at compile time.
//
// Regression guard: a bare string-literal len operand was lowered to a
// bare *readonly uint8 data pointer rather than a {ptr,len} slice, so the
// length-field extract was invalid IR on compiled backends and a silent
// garbage read on the VM.  The multiple lengths (and the arithmetic and
// escaped cases) ensure a wrong adjacent-word read can't coincidentally
// match.
func main() {
	var ok bool = true
	if len("true") != 4 { ok = false }
	if len("") != 0 { ok = false }
	if len("a") != 1 { ok = false }
	if len("abcdefghij") != 10 { ok = false }
	if len("a\nb") != 3 { ok = false }
	if len("true") + len("false") != 9 { ok = false }
	if ok {
		println("ok")
	} else {
		println("bad")
	}
}
