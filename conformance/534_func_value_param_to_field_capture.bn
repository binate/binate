package "main"

import "pkg/builtins/testing"

// Refcounting of a CAPTURING @func received as a function PARAMETER, then
// stored into a struct field (`h.F = f`): the field must keep the closure's
// capture record alive.  If the parameter's end-of-call RefDec freed the
// capture record while the field still points at it, invoking the field
// would read freed memory (a use-after-free; compiled, a segfault).
//
// The shape is specifically PARAMETER → field assignment of a CAPTURING closure:
//   - direct local assignment (`h.F = localVar`) takes the ordinary RefInc;
//   - a NON-capturing @func param's data is a shared/immortal per-callee
//     rec, not a per-instance capture record.
//
// c.N reaches 100 across 100 invocations of the stored capturing closure.

type Counter struct {
	N int
}

type Holder struct {
	F @func(int) int
}

// install stores a @func PARAMETER into a struct field — the path under test.
func install(h @Holder, f @func(int) int) {
	h.F = f
}

func main() {
	var c @Counter = make(Counter)
	var f @func(int) int = func(x int) int {
		c.N = c.N + x
		return c.N
	}
	var h @Holder = make(Holder)
	install(h, f)
	for i := 0; i < 100; i++ {
		h.F(1)
	}
	testing.Println(c.N)
}
