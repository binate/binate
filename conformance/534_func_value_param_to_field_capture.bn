package "main"

import "pkg/builtins/testing"

// MAJOR refcount bug (use-after-free): a CAPTURING @func received as a
// function PARAMETER, then stored into a struct field (`h.F = f`), is not
// kept alive correctly — the field ends up holding a dangling reference
// to the closure's capture record.  Once the parameter goes out of scope
// (its end-of-call RefDec), the capture record is freed while the field
// still points at it; invoking the field then reads freed memory and
// (compiled) segfaults.
//
// The trigger is specifically PARAMETER → field assignment of a
// CAPTURING closure:
//   - direct local assignment (`h.F = localVar`) is fine (correct RefInc);
//   - a NON-capturing @func param is immune (its data is a shared/immortal
//     per-callee rec, not a per-instance capture record).
//
// Proper fix: the param → struct-field store of an @func value must
// RefInc the function value's data (the capture record) like any other
// managed-field assignment — or the parameter's cleanup must not
// over-decrement a value that was moved into a field.  See claude-todo.md.
//
// Expected output below assumes the fix (c.N reaches 100 across 100
// invocations of the stored capturing closure).

type Counter struct {
	N int
}

type Holder struct {
	F @func(int) int
}

// install stores a @func PARAMETER into a struct field — the buggy path.
func install(h @Holder, f @func(int) int) {
	h.F = f
}

func main() {
	var c @Counter = make(Counter)
	var f @func(int) int = func(x int) int {
		c.N = c.N + x
		return c.N
	}
	var h @Holder = make(Holder)
	install(h, f)
	for i := 0; i < 100; i++ {
		h.F(1)
	}
	testing.Println(c.N)
}
