package "main"

// Cross-package consumer of pkg/std/strconv's float formatting: a separate
// `main` translation unit imports the package and exercises both the
// allocating FormatFloat and the in-place AppendFloat (which pull in
// pkg/math/big transitively).  Proves the consumer import + cross-TU link
// for the dtoa end-to-end, beyond strconv's in-package unit tests.
import "pkg/std/strconv"

func main() {
	println(strconv.FormatFloat(3.141592653589793, 'g', cast(int, 0) - 1, 64))   // 3.141592653589793
	println(strconv.FormatFloat(0.1, 'g', cast(int, 0) - 1, 64))                 // 0.1
	println(strconv.FormatFloat(100.0, 'e', cast(int, 0) - 1, 64))               // 1e+02
	println(strconv.FormatFloat(cast(float64, 0) - 0.5, 'f', cast(int, 0) - 1, 64))   // -0.5
	// Fixed precision (prec >= 0): 'f', 'e', 'g'.
	println(strconv.FormatFloat(3.14159, 'f', 2, 64))                            // 3.14
	println(strconv.FormatFloat(123456.0, 'e', 2, 64))                           // 1.23e+05
	println(strconv.FormatFloat(123456.0, 'g', 3, 64))                           // 1.23e+05
	var buf @[]char = make_slice(char, 32)
	var n int = strconv.AppendFloat(buf[0:32], 0, 2.5, 'g', cast(int, 0) - 1, 64)
	println(buf[0:n])                                                            // 2.5
	n = strconv.AppendFloat(buf[0:32], 0, 9.96, 'f', 1, 64)
	println(buf[0:n])                                                            // 10.0
}
