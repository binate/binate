package "main"

// A float64 literal with a large exponent (1e100) must convert to its exact
// nearest-double bit pattern, 6103021453049119613 (confirmed via Go's
// math.Float64bits), on EVERY backend and the VM.  The literal value rides the
// IR as text; the VM and native backends convert it via the shared
// integer-only common.ParseFloatLitToBits, LLVM via its own strtod — a large
// exponent must not lose precision in any of them.
func main() {
	println(bit_cast(int64, 1e100))
}
