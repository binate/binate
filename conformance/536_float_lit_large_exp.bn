package "main"

// A float64 literal with a large exponent (1e100) must convert to its exact
// nearest-double bit pattern, 6103021453049119613 (confirmed via Go's
// math.Float64bits).  The LLVM and native (arm32/aarch64) backends get this
// right; only the bytecode VM produces a slightly-wrong value
// (6103021453049119616, a few ULP off) — a VM-specific float64-constant bug
// for large exponents (1e20 and smaller are fine).  Tracked as MAJOR in
// claude-todo; xfailed on the VM modes.
func main() {
	println(bit_cast(int64, 1e100))
}
