package "main"

import "pkg/builtins/testing"

// Regression guard: a float64 literal with more than ~19 significant digits
// (and a value >= 2^64 written out in full) must convert to the correct bits.
// The literal->bits converter accumulates the significand in a 128-bit window;
// a uint64 accumulator would overflow — silently miscompiling these literals
// on the native backends and, before this guard, the VM.  Checked via
// bit_cast to int64 so the expected output is byte-stable across backends.
func main() {
	// pi to 31 significant digits.
	testing.Println(bit_cast(int64, 3.141592653589793238462643383279)) // 4614256656552045848
	// 2^64 written out: a uint64 accumulator would wrap to exactly 0 and
	// collapse this to +0.0.
	testing.Println(bit_cast(int64, 18446744073709551616.0)) // 4895412794951729152
	// 21-digit mantissa with a fractional part.
	testing.Println(bit_cast(int64, 12345678901234567890.5)) // 4892433759222981601
}
