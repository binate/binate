package "main"

import "pkg/builtins/testing"

// A float64 literal with many significant digits that sits JUST ABOVE a binary
// rounding tie must round to nearest-even (UP).  This is the table-maker's-
// dilemma tail: a fixed-width-window converter that collapses everything below
// the kept bits into one sticky flag loses the exact round bit for ~38+
// significant digits and rounds DOWN — one ULP low.  common.ParseFloatLitToBits
// delegates to pkg/std/strconv.ParseFloat (exact big.Nat rounding), so the VM
// and native backends match LLVM's own strtod here.
//
// 1.0000000000000001110223024625156540424 -> nearest double is 1.0 + 1 ULP =
// 0x3FF0000000000001 = 4607182418800017409 (not ...408, which is 1 ULP low).
func main() {
	testing.Println(bit_cast(int64, 1.0000000000000001110223024625156540424))
}
