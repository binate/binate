package "main"

// A float32-typed constant must carry its NARROWED 32-bit value.  The LLVM
// backend used to reject a decimal `float` constant outright ("floating point
// constant invalid for type") — now FIXED (it materializes the value as a
// double and fptruncs to float).  bit_cast to int32 makes the bit pattern
// observable, so this PASSES on the C/LLVM modes.
//
// XFAIL (VM + native), tracked in claude-todo.md: those backends load the low
// 32 bits of the float64 pattern instead of narrowing to float32.  The fix
// (common.F64BitsToF32Bits, already written + unit-tested) is blocked: the
// VM/native can't call a NEW native/common symbol until a new BUILDER release
// bundles it (its interface is frozen at the BUILDER snapshot).
const C1 float32 = 0.1
const C2 float32 = 3.14
const Neg float32 = -0.1
func main() {
	println(bit_cast(int32, C1))    // float32(0.1)  = 1036831949
	println(bit_cast(int32, C2))    // float32(3.14) = 1078523331
	println(bit_cast(int32, Neg))   // float32(-0.1) = -1110651699
	var x float32 = 0.5
	println(bit_cast(int32, x))     // float32(0.5)  = 1056964608
	var y float32 = C1
	println(bit_cast(int32, y))     // 1036831949
}
