package "main"
import "pkg/builtins/testing"

// A float32-typed constant must carry its NARROWED 32-bit value.  The LLVM
// backend used to reject a decimal `float` constant outright ("floating point
// constant invalid for type") — now FIXED (it materializes the value as a
// double and fptruncs to float).  bit_cast to int32 makes the bit pattern
// observable, so this PASSES on the C/LLVM modes.
//
// The VM and both native backends route a float32-typed const through
// common.F64BitsToF32Bits, so they materialize the same narrowed 32-bit
// pattern the C/LLVM modes do.  The negative const additionally exercises the
// widening cast int32 → int (done for printing): bit_cast yields a non-canonical
// (zero-extended) register, and the cast re-establishes the value from the
// source width, so the high-bit pattern sign-extends.  Passes on every mode.
const C1 float32 = 0.1
const C2 float32 = 3.14
const Neg float32 = -0.1
func main() {
	testing.Println(bit_cast(int32, C1))    // float32(0.1)  = 1036831949
	testing.Println(bit_cast(int32, C2))    // float32(3.14) = 1078523331
	testing.Println(bit_cast(int32, Neg))   // float32(-0.1) = -1110651699
	var x float32 = 0.5
	testing.Println(bit_cast(int32, x))     // float32(0.5)  = 1056964608
	var y float32 = C1
	testing.Println(bit_cast(int32, y))     // 1036831949
}
