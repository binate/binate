package "main"
import "pkg/builtins/testing"

// Regression guard: a top-level const
// of type bool used to silently emit EmitConstInt(0, TypInt()) at every
// read site — the wrong value (always false) and, at a branch site, an
// i64 value used as an i1 (malformed LLVM IR).  The fix routes bool-typed
// ModuleConst entries through EmitConstBool at both the EXPR_IDENT
// (in-package) and qualified EXPR_SELECTOR (cross-package) read sites.

import "pkg/flags"

// A cross-package bool const folded inside `&&` with an unsigned compare of a
// >= 2^63 operand: the checker's foldConstBoolValue must resolve the imported
// `flags.Enabled` (defineBniConst stores its value on the symbol), else the &&
// bails to IR-gen's host-int const fold — which truncates U on a 32-bit host
// (the arm32 VM's embedded compiler) so `U > 5` folds false and FOLDED becomes
// wrongly false.
const U uint64 = 0x8000000000000000
const FOLDED bool = flags.Enabled && (U > 5)

func main() {
	// Cross-package qualified reads (EXPR_SELECTOR), printed directly.
	// Both values are exercised so a hardcoded-true fix would fail.
	testing.Println(flags.Enabled)
	testing.Println(flags.Disabled)
	// Cross-package read used as a branch condition (the i1 context
	// whose malformed IR was the loud symptom).
	if flags.Enabled {
		testing.Println(1)
	} else {
		testing.Println(0)
	}
	// In-package read inside the declaring package (EXPR_IDENT):
	// flags.Reflect() returns Enabled via a same-package read.
	testing.Println(flags.Reflect())
	// Cross-package bool const inside a fold (Finding 1 / defineBniConst).
	testing.Println(FOLDED)
}
