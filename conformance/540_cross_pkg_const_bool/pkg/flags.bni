package "pkg/flags"

// Public bool-typed consts declared with their values in the .bni so
// importers see the literal at compile time (the shape a real feature-
// flag / build-config package would use).
const Enabled bool = true
const Disabled bool = false

// Reflect returns Enabled via an in-package read — exercises the
// EXPR_IDENT in-package-read path inside the declaring package,
// separately from main's EXPR_SELECTOR cross-package read.
func Reflect() bool
