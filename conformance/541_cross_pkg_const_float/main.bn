package "main"

// Regression guard for plan-const-nonint.md Phase A: a top-level const
// of type float used to silently emit EmitConstInt(0, TypInt()) at every
// read site — read back as 0.0 (and an i64 zero spelled where a double
// is required).  The fix routes float-typed ModuleConst entries through
// EmitConstFloat at both the EXPR_IDENT (in-package) and qualified
// EXPR_SELECTOR (cross-package) read sites.  A negative float literal
// (NegHalf = -1.5) parses as unary-minus over the float literal, a
// distinct producer path that must fold the sign into the stored text.
//
// cast-to-int keeps the expected output stable across backends (float
// text formatting is not byte-identical between LLVM and the VM) while
// still distinguishing the correct value from the broken zero: with
// Ratio = 3.5, cast(int, Ratio * 2.0) = 7, NegHalf * 2.0 = -3, but a
// 0.0 placeholder gives 0.

import "pkg/cfg"

func main() {
	// Cross-package qualified reads (EXPR_SELECTOR), positive + negative.
	println(cast(int, cfg.Ratio * 2.0))
	println(cast(int, cfg.NegHalf * 2.0))
	// In-package reads (EXPR_IDENT) inside the declaring package.
	println(cast(int, cfg.Scale() * 2.0))
	println(cast(int, cfg.NegScaled() * 2.0))
}
