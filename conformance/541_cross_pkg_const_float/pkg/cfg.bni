package "pkg/cfg"

// Public float-typed consts declared with their values in the .bni so
// importers see the literal at compile time.  NegHalf is a negative
// float literal — it parses as unary-minus over a float literal, a
// distinct producer path from the bare-positive Ratio.
const Ratio float64 = 3.5
const NegHalf float64 = -1.5

// Scale / NegScaled return the consts via in-package reads — exercise
// the EXPR_IDENT in-package-read path inside the declaring package,
// separately from main's EXPR_SELECTOR cross-package reads.
func Scale() float64
func NegScaled() float64
