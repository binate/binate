package "pkg/cfg"

// Public float-typed const declared with its value in the .bni so
// importers see the literal at compile time.
const Ratio float64 = 3.5

// Scale returns Ratio via an in-package read — exercises the
// EXPR_IDENT in-package-read path inside the declaring package,
// separately from main's EXPR_SELECTOR cross-package read.
func Scale() float64
