package "main"

// A string literal initializing a slice variable whose type carries an
// OUTER `readonly` modifier must still materialize a proper {ptr, len}
// slice — not a bare data pointer with a garbage length word.  Pins both
// the raw (`readonly *[]readonly char`) and managed (`readonly @[]readonly
// char`) char-slice init paths, plus len() over them.  Before the
// isCharSliceType / isManagedSliceType outer-readonly peel, the
// string→slice conversion was skipped and len read garbage.
func main() {
	var s readonly *[]readonly char = "hello"
	println(s)
	println(len(s))

	var m readonly @[]readonly char = "world!"
	println(m)
	println(len(m))
}
