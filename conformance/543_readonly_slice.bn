package "main"

// Slicing a value whose type carries an OUTER `readonly` modifier
// (`readonly *[]readonly char`) reads through the modifier: the result
// is a fresh `*[]readonly char` subslice.  Mirrors 021_string_slice but
// with the outer-readonly shape that plan-const-readonly's read-only
// globals use.  Indexing already read through outer readonly; this pins
// the slice path too.
func main() {
	var s readonly *[]readonly char = "hello"
	println(s[1:4])
	println(s[3:])
	println(len(s[1:4]))
}
