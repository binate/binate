package "main"

// Slicing a value whose type carries an OUTER `readonly` modifier reads
// through the modifier: the result is a fresh subslice of the underlying
// slice type.  Mirrors 021_string_slice but with the outer-readonly shape
// that plan-const-readonly's read-only globals use.  Indexing already read
// through outer readonly; this pins the slice path too — for both the raw
// (`readonly *[]readonly char`) and managed (`readonly @[]readonly char`)
// shapes, the latter exercising the managed-subslice RefInc path.
func main() {
	var s readonly *[]readonly char = "hello"
	println(s[1:4])
	println(s[3:])
	println(len(s[1:4]))

	var m readonly @[]readonly char = "hello"
	println(m[1:4])
	println(m[:2])
	println(len(m[1:4]))
}
