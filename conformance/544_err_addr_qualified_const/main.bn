package "main"

import "pkg/x"

// `&pkg.C` for an imported const C has no storage to address — it must be
// rejected, exactly like the unqualified `&C`.  The token.AMP check used
// to handle only the EXPR_IDENT form, so the package-qualified
// EXPR_SELECTOR form was silently accepted, yielding a pointer to a
// storage-less compile-time value.
func main() {
	var p *int = &x.MAX
	_ = p
}
