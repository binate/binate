package "main"

import "pkg/x"

// `&pkg.C` for an imported const C has no storage to address — it must be
// rejected, exactly like the unqualified `&C`.  The token.AMP check must
// cover the package-qualified EXPR_SELECTOR form as well as EXPR_IDENT;
// accepting it yields a pointer to a storage-less compile-time value.
func main() {
	var p *int = &x.MAX
	_ = p
}
