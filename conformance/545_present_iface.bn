package "main"

// Spec + regression for the `present` builtin and empty/present
// interface values (plan-std-errors.md Part 0).  Interface values are
// NOT nillable (claude-notes.md:1141, like slices); `present(iv)` is the
// honest "is the slot filled?" test — it inspects the vtable word, so a
// boxed nil pointer is still present (a real impl whose data is null),
// while the zero-value interface is empty.  Also pins that an empty
// interface value cleans up safely (its vtable is null, so the dtor must
// not be fetched).

interface Shape { area() int }
type Sq struct { s int }
func (x *Sq) area() int { return x.s * x.s }
impl *Sq : Shape

func main() {
	// Present: a boxed concrete value.
	var q @Sq = make(Sq)
	q.s = 3
	var a @Shape = q
	if present(a) { println(1) } else { println(0) }
	println(a.area())
	// Empty: the zero-value interface, never assigned an impl.  Must
	// clean up at scope exit without crashing.
	var b @Shape
	if present(b) { println(1) } else { println(0) }
	// Boxed nil pointer: the slot IS filled (a Sq-impl), so present is
	// true even though the inner value is nil — the honest answer.
	var np @Sq = nil
	var c @Shape = np
	if present(c) { println(1) } else { println(0) }
}
