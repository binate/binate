package "main"

// Exercises the @func acquire arm on RETURN (gen_return.bn): makeAdder
// builds a CAPTURING closure over its managed @Counter parameter and
// RETURNS it.  The returned closure's capture record must survive the
// builder frame's scope-end RefDec — the return-side acquire (consumeTemp
// for the fresh literal) hands the caller the live ref, and the caller's
// var-init (call result is fresh → consumeTemp) takes ownership.  The
// caller then invokes the stored closure repeatedly; the captured
// @Counter must stay alive until the closure is destroyed at main's
// scope end.

type Counter struct {
	N int
}

func makeAdder(c @Counter) @func(int) int {
	return func(x int) int {
		c.N = c.N + x
		return c.N
	}
}

func main() {
	var c @Counter = make(Counter)
	var add @func(int) int = makeAdder(c)
	var i int = 0
	for i = 0; i < 5; i = i + 1 {
		add(10)
	}
	println(c.N)
}
