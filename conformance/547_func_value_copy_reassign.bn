package "main"

// Exercises the @func acquire arms not covered by 531/534/546: a non-fresh
// copy of an existing @func into a new var (RefInc, not a fresh literal),
// and reassignment of a plain @func variable (Axiom-5 RefInc-new +
// RefDec-old).  g and h are copies of the SAME capturing closure, so they
// share the capture record over @Counter c; a miscounted acquire/release
// frees the record mid-run (crash) or leaks it.

type Counter struct {
	N int
}

func main() {
	var c @Counter = make(Counter)
	var g @func(int) int = func(x int) int {
		c.N = c.N + x
		return c.N
	}
	// Non-fresh var-init copy: h copies an existing @func (RefInc the rec).
	var h @func(int) int = g
	g(1)
	h(2)
	// Variable reassignment: g = h (RefInc h's rec, RefDec g's old rec).
	g = h
	g(4)
	println(c.N)
}
