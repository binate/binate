package "main"
import "pkg/builtins/testing"

import "pkg/cfg"

// Reading exported `var`s across packages: cfg declares them in its
// .bni (extern decls, no initializer) and defines + initializes them in
// its .bn.  main reads cfg.Count (scalar int) and cfg.Name (raw
// readonly-slice / string).  Exercises the .bni-extern-var read path:
// bni_scope SYM_VAR, gen_import registration, the gen_selector qualified
// global-load, and codegen's `external global` decl.
func main() {
	testing.Println(cfg.Count)   // 42
	testing.Println(cfg.Name)    // binate
}
