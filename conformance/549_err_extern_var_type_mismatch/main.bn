package "main"

import "pkg/bad"

// pkg/bad's .bni declares `var X int` but its .bn defines `var X
// *[]readonly char` — an importer would read X's type from the .bni and
// misread the .bn-defined storage, so checkBniVarMatch must reject the
// mismatch when pkg/bad is compiled.
func main() {
	println(bad.X)
}
