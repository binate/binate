package "main"

// Verifies the bytecode VM releases a capturing @func's captured managed
// values when the closure dies (plan-vm-compiled-closure-dtor.md).  The
// closure over @Counter c holds a reference to c via its heap closure
// struct; while it lives c's refcount is elevated, and when it is dropped
// the closure-struct dtor must release that reference.  Pre-fix the VM
// leaked the closure struct, so c's captured ref was never freed and the
// refcount stayed at 2 here.  (Compiled was already leak-clean via the
// func-value vtable's dtor slot.)

import "pkg/builtins/rt"

type Counter struct {
	N int
}

// makeAndDrop builds a capturing closure over its @Counter parameter,
// invokes it, and returns — the closure dies at scope end.
func makeAndDrop(c @Counter) int {
	var f @func(int) int = func(d int) int {
		c.N = c.N + d
		return c.N
	}
	return f(5)
}

func main() {
	var c @Counter = make(Counter)
	var p *uint8 = bit_cast(*uint8, c)
	println(rt.Refcount(p))   // 1: only main's c
	makeAndDrop(c)
	println(rt.Refcount(p))   // 1 iff the dead closure released its ref
	println(c.N)              // 5
}
