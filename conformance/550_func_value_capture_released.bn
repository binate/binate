package "main"
import "pkg/builtins/testing"

// Verifies the bytecode VM releases a capturing @func's captured managed
// values when the closure dies.  The
// closure over @Counter c holds a reference to c via its heap closure
// struct; while it lives c's refcount is elevated, and when it is dropped
// the closure-struct dtor must release that reference.  A VM that leaks
// the closure struct never frees c's captured ref, and the refcount stays
// at 2 here.  (Compiled code releases it via the func-value vtable's dtor
// slot.)

import "pkg/builtins/rt"

type Counter struct {
	N int
}

// makeAndDrop builds a capturing closure over its @Counter parameter,
// invokes it, and returns — the closure dies at scope end.
func makeAndDrop(c @Counter) int {
	var f @func(int) int = func(d int) int {
		c.N = c.N + d
		return c.N
	}
	return f(5)
}

func main() {
	var c @Counter = make(Counter)
	var p *uint8 = bit_cast(*uint8, c)
	testing.Println(rt.Refcount(p))   // 1: only main's c
	makeAndDrop(c)
	testing.Println(rt.Refcount(p))   // 1 iff the dead closure released its ref
	testing.Println(c.N)              // 5
}
