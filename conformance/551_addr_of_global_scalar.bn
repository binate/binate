package "main"

// Regression for a pre-existing compiled-backend bug: taking the address
// of a top-level global SCALAR as a value (`&G`) and writing through it.
// Works in the bytecode VM; the compiled (LLVM) backend renders the
// IsGlobalRef pseudo (ID -1) as `%v-1` (undefined) when it is used as an
// rvalue rather than a load/store address operand.  Xfailed in the
// compiled modes pending the codegen fix (see claude-todo); not
// extern-var-specific — it also blocks `&pkg.Var` in compiled mode.
var G int = 10

func main() {
	var p *int = &G
	p[0] = 42
	println(G)
}
