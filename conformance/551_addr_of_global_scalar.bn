package "main"
import "pkg/builtins/testing"

// Regression: taking the address of a top-level global SCALAR as a
// VALUE (`&G`) must work in every value-operand position in the compiled
// (LLVM) backend — not just as a load/store address.  The backend used
// to render the IsGlobalRef pseudo (ID -1) as `%v-1` (undefined) when
// `&G` was used as an rvalue (store value, call argument, return value,
// …); only address-operand positions (load/store target, GEP base)
// rendered the symbol `@<mangled>`.  This test exercises one global per
// instruction across the value positions — var-init + assignment store,
// direct call arg, func-value call arg, single return, slice-element
// store, composite + assigned struct field, and a bit_cast source — so
// it is green on all backends.  (The two-globals-in-one-instruction
// case is a distinct VM bug; see 573.)

var G int = 10
var H int = 20

type Box struct { p *int }

func bump(p *int) { p[0] = p[0] + 1 }
func getG() *int { return &G }

func main() {
	var p *int = &G        // store (var-init)
	p[0] = 1               // G = 1
	bump(&G)               // direct call arg; G = 2
	var q *int = getG()    // single return
	q[0] = q[0] + 1        // G = 3
	var fp *func(*int) = bump
	fp(&G)                 // func-value call arg; G = 4
	var s @[]*int = make_slice(*int, 1)
	s[0] = &H              // slice-element store
	s[0][0] = s[0][0] + 1  // H = 21
	var bx Box = Box{&G}   // composite struct field
	bx.p[0] = bx.p[0] + 1  // G = 5
	bx.p = &H              // struct-field assignment store
	bx.p[0] = bx.p[0] + 1  // H = 22
	var addr int = bit_cast(int, &G)   // bit_cast source (ptrtoint of &G)
	var r *int = bit_cast(*int, addr)  // round-trip int -> ptr
	r[0] = r[0] + 1        // G = 6
	testing.Println(G)             // 6
	testing.Println(H)             // 22
}
