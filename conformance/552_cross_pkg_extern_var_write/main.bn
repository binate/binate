package "main"

import "pkg/counter"

// Writing to an imported extern var by direct assignment, including
// read-modify-write, with the write visible to the defining package
// (same storage).  Exercises genSelectorPtr's package-qualified branch
// as the assignment lvalue.  Taking the address (`&counter.N`) is a
// separate value-operand path — addr-of a global as an rvalue is
// exercised by 551.
func main() {
	println(counter.N)          // 10 (initial)
	counter.N = 20              // direct assignment to an imported var
	println(counter.N)          // 20
	println(counter.Get())      // 20 (owner sees the write — same storage)
	counter.N = counter.N + 5   // read-modify-write through the import
	println(counter.N)          // 25
	println(counter.Get())      // 25
}
