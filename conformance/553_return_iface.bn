package "main"

// Regression for the returning-@Iface use-after-free: a function that
// boxes a local managed value into an interface value and returns it
// must RETAIN the data for the caller (Axiom-3 RefInc on the returned
// interface value in gen_return), or the source local's scope-exit
// RefDec frees it and the caller reads garbage (e.g. area() == 0).
// Untested before this: conformance only ever returned managed
// POINTERS (@Counter / @Item / …), never a managed interface value.

interface Shape { area() int }
type Sq struct { s int }
func (x *Sq) area() int { return x.s * x.s }
impl *Sq : Shape

// Box a local @Sq into @Shape and return it (the core case).
func makeSq(n int) @Shape { var q @Sq = make(Sq); q.s = n; var s @Shape = q; return s }
// Return an interface value received as a parameter.
func passthrough(s @Shape) @Shape { return s }
// Return an empty interface value (must stay a no-op: null data).
func none() @Shape { var e @Shape; return e }

func main() {
	var a @Shape = makeSq(4)
	println(a.area())
	var b @Shape = passthrough(makeSq(5))
	println(b.area())
	// Two returned interface values coexisting — no cross-contamination.
	var c @Shape = makeSq(6)
	var d @Shape = makeSq(7)
	println(c.area())
	println(d.area())
	// An empty interface value returned + cleaned up: still present()==false.
	var z @Shape = none()
	if present(z) { println(1) } else { println(0) }
}
