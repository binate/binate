package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Refcount-BALANCE regression for the managed-interface-value lifecycle.
// 546 checks method values (catches a use-after-free: a freed receiver
// reads garbage), but a LEAK produces correct values and only shows up
// as a refcount that never returns to its start.  This pins the dual:
// each block threads `inner` (rc starts 1) through a distinct @Iface
// lifecycle op and re-reads inner's rc after the holder drops.  rc must
// return to 1 — rc>1 is an over-retain leak (the receiver's dtor never
// ran, so its @Inner field is never released); a wrong method value or
// rc<1 is a use-after-free.  Mirrors 520's rt.Refcount pattern across
// the ops the lifecycle wiring touches.

interface Foo {
	foo() int
}

type Inner struct {
	V int
}

type Holder struct {
	Inner @Inner
}

func (h *Holder) foo() int {
	return h.Inner.V
}

impl *Holder : Foo

func makeFoo(inner @Inner) @Foo {
	var h @Holder = make(Holder)
	h.Inner = inner
	return h
}

func consume(t @Foo) {
	testing.Println(t.foo())
}

// Return a named-local interface value (the original UAF shape: a
// borrowed load that must be RefInc'd for the caller).
func viaLocal(i @Inner) @Foo {
	var f @Foo = makeFoo(i)
	return f
}

// Return a call result (the over-retain leak shape: already owned, must
// be moved out, not re-retained).
func viaCall(i @Inner) @Foo {
	return makeFoo(i)
}

// Hold an interface value and pass it to two consumers (a borrowed arg,
// which the call site RefInc's so the callee's release doesn't drop the
// caller's reference).
func twice(i @Inner) {
	var f @Foo = makeFoo(i)
	consume(f)
	consume(f)
}

// Reassign an interface-value local (the overwrite-leak shape: the old
// value must be RefDec'd before the new one is stored).
func reassign(i @Inner) {
	var f @Foo = makeFoo(i)
	f = makeFoo(i)
	consume(f)
}

func main() {
	// Measurements are inline (not through a helper): passing `inner` to
	// a helper would entry-RefInc it and inflate the reading by one.
	var a @Inner = make(Inner)
	a.V = 11
	var pa *uint8 = bit_cast(*uint8, a)
	consume(viaLocal(a))
	testing.Print("a=")
	testing.Println(rt.Refcount(pa))

	var b @Inner = make(Inner)
	b.V = 22
	var pb *uint8 = bit_cast(*uint8, b)
	consume(viaCall(b))
	testing.Print("b=")
	testing.Println(rt.Refcount(pb))

	var c @Inner = make(Inner)
	c.V = 33
	var pc *uint8 = bit_cast(*uint8, c)
	makeFoo(c)
	testing.Print("c=")
	testing.Println(rt.Refcount(pc))

	var d @Inner = make(Inner)
	d.V = 44
	var pd *uint8 = bit_cast(*uint8, d)
	twice(d)
	testing.Print("d=")
	testing.Println(rt.Refcount(pd))

	var e @Inner = make(Inner)
	e.V = 55
	var pe *uint8 = bit_cast(*uint8, e)
	reassign(e)
	testing.Print("e=")
	testing.Println(rt.Refcount(pe))
}
