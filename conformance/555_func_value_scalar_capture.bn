package "main"

// Covers the BC_REFDEC COMPILED_CLOSURE arm's no-managed-captures branch:
// a capturing @func whose closure
// struct holds only SCALAR fields has no destructor, so on rec free the
// VM frees the closure struct directly (ClosureStructDtorName is empty)
// rather than pushing a dtor frame.  Exercises that path end-to-end — no
// crash, correct result — in every mode including -int-int (where 550's
// managed-capture path also runs).  Two independent closures over the
// same callee confirm each owns its own scalar capture record.

func adder(n int) @func(int) int {
	return func(d int) int {
		return n + d
	}
}

func main() {
	var add5 @func(int) int = adder(5)
	var add10 @func(int) int = adder(10)
	println(add5(1))
	println(add10(1))
	println(add5(2))
}
