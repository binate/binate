package "main"

import "pkg/builtins/rt"

// Refcount-balance for a managed interface value held in a struct FIELD,
// exercising the field-store (move the @Foo into the field — gen_control)
// and struct-dtor (RefDec the @Foo field when the struct is dropped —
// gen_dtor_emit_bodies) wiring that 554 (locals / params / returns) does
// not reach.  A Holder boxed as @Foo is stored into a struct's field and
// the struct is then dropped; the boxed receiver's managed @Inner field
// must return to its starting refcount (a leak leaves it >1; a missing
// store-move or a double dtor drops it / crashes).

interface Foo {
	foo() int
}

type Inner struct {
	V int
}

type Holder struct {
	Inner @Inner
}

func (h *Holder) foo() int {
	return h.Inner.V
}

impl *Holder : Foo

type Wrap struct {
	F @Foo
}

func makeFoo(inner @Inner) @Foo {
	var h @Holder = make(Holder)
	h.Inner = inner
	return h
}

// Stores a freshly-boxed @Foo into a struct field, dispatches through
// it, then lets the struct drop (running its dtor over the @Foo field).
func useStructField(inner @Inner) {
	var w @Wrap = make(Wrap)
	w.F = makeFoo(inner)
	print("r=")
	println(w.F.foo())
}

func main() {
	var i @Inner = make(Inner)
	i.V = 42
	var p *uint8 = bit_cast(*uint8, i)
	print("before=")
	println(rt.Refcount(p))
	useStructField(i)
	print("after=")
	println(rt.Refcount(p))
}
