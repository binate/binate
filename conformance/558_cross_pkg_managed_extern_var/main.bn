package "main"

import "pkg/store"

// Managed (`@T` / `@[]T`) extern vars: a managed-slice extern var
// supports read, len, element write, and value-copy (shared backing +
// refcount); a managed-ptr extern var supports field read.  These flow
// through the same type-agnostic read/write paths as scalar/raw extern
// vars.  (Copying a managed-PTR var's whole value is a separate tracked
// crash — see 559.)
func main() {
	println(len(store.S))    // 3
	store.S[0] = 9
	println(store.S[0])      // 9
	var t @[]int = store.S   // managed-slice value-copy (shares backing)
	println(t[0])            // 9
	println(store.G.V)       // 0 (managed-ptr field read)
}
