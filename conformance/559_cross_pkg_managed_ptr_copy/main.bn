package "main"

import "pkg/store"
import "pkg/builtins/rt"

// Copying an extern managed-PTR var's whole value (`var n @T = pkg.G`)
// must (a) alias the same object — a write through n shows through
// pkg.G — and (b) balance the refcount: the copy RefIncs (rc 1->2) and
// n's scope-end RefDec brings it back (2->1).  That scope-end RefDec
// needs the imported type's dtor; historically the importer lacked it
// and this crashed (was xfailed in every mode).  `rc after: 1` confirms
// no leak (would stay 2) and no over-free (would free pkg.G's object,
// reading 0 / faulting on the next access).
func mutate() {
	var n @store.Node = store.G   // value-copy: rc 1->2
	n.V = 5
}                                  // n out of scope: rc 2->1

func main() {
	var ptr *uint8 = bit_cast(*uint8, store.G)
	print("rc before: ")
	println(rt.Refcount(ptr))    // 1
	mutate()
	print("rc after: ")
	println(rt.Refcount(ptr))    // 1 — balanced
	println(store.G.V)           // 5 — n aliased pkg.G
}
