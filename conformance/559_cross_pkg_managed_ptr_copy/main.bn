package "main"

import "pkg/store"

// Copying an extern managed-PTR var's whole value (`var n @T = pkg.G`)
// must alias the same object: a write through n shows through pkg.G.
// This historically crashed at n's scope-end RefDec (the importer
// lacked the imported type's dtor); now fixed and green in every mode.
// Refcount balance for the same copy is verified in 586 (which needs
// an `rt` import — `rt.Refcount` — that trips the pre-existing int-int
// loader bug, so it can't run in builder-comp-int-int).
func main() {
	var n @store.Node = store.G
	n.V = 5
	println(store.G.V)   // 5 (n aliases store.G)
}
