package "main"

import "pkg/store"

// Copying an extern managed-PTR var's WHOLE value (`var n @T = pkg.G`)
// crashes at runtime — isolated to extern + managed-ptr + value-copy
// (same-package managed-ptr copy works; the qualified type works from a
// func return; managed-slice value-copy works; managed-ptr field read
// works).  The cross-package RefDec at n's scope end needs the imported
// type's dtor, which the importer does not have.  xfailed in all modes
// pending the cross-package-managed-dtor fix (see claude-todo).
func main() {
	var n @store.Node = store.G
	n.V = 5
	println(store.G.V)   // 5 (n aliases store.G)
}
