package "main"
import "pkg/builtins/testing"

import "pkg/store"

// Copying an extern managed-PTR var's whole value (`var n @T = pkg.G`)
// must alias the same object: a write through n shows through pkg.G.
// The importer needs the imported type's dtor: without it the copy
// crashes at n's scope-end RefDec.  Refcount balance for the same copy
// is verified in 586.
func main() {
	var n @store.Node = store.G
	n.V = 5
	testing.Println(store.G.V)   // 5 (n aliases store.G)
}
