package "main"

// A managed interface value returned from a function and passed DIRECTLY
// as another call's argument must reach the callee intact in every mode.
// In the bytecode VM, interface values are 16-byte address-based slots;
// a single-iv return that isn't copied back to caller space dangles in
// the reclaimed callee frame and the next call clobbers it, so the iv
// reads as nil at the consumer's dispatch ("call through nil interface
// value").  This pins lowerReturn's iface copy-back (the receiver here
// has no managed field, so it does NOT depend on the iface receiver-dtor
// VM path — it is green in all modes).

interface Foo {
	foo() int
}

type Holder struct {
	Tag int
}

func (h *Holder) foo() int {
	return h.Tag
}

impl *Holder : Foo

func makeFoo(t int) @Foo {
	var h @Holder = make(Holder)
	h.Tag = t
	return h
}

func consume(t @Foo) {
	println(t.foo())
}

func main() {
	// Pass the call result directly as an arg (no intervening bind).
	consume(makeFoo(42))
	// And again nested through a passthrough.
	consume(makeFoo(7))
}
