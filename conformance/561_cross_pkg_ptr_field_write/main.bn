package "main"

import "pkg/store"

// Writing a FIELD through an imported managed-ptr var (`store.G.V = v`)
// stores through the field pointer: genSelectorPtr's package-qualified
// branch recognizes the nested selector lvalue (`store.G` is itself a
// selector, not a bare EXPR_IDENT) instead of dropping the store on a nil
// base.  Element writes through an imported managed-SLICE var
// (`pkg.S[i] = v`) work too.
func main() {
	store.G.V = 7
	println(store.G.V)   // 7
}
