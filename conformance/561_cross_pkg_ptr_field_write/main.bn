package "main"

import "pkg/store"

// Writing a FIELD through an imported managed-ptr (or raw-ptr / value-
// struct) var — `pkg.G.V = v` — silently no-ops: genSelectorPtr's
// package-qualified branch only handles e.X == EXPR_IDENT, so the nested
// selector lvalue (`pkg.G` is itself a selector) isn't recognized and the
// store lands on a nil pointer (dropped).  Reading the field works; only
// the write-through is lost.  xfailed in all modes pending a
// genSelectorPtr qualified-var-base case (see claude-todo).  Element
// writes through an imported managed-SLICE var (`pkg.S[i] = v`) work.
func main() {
	store.G.V = 7
	println(store.G.V)   // want 7; currently reads 0 (write dropped)
}
