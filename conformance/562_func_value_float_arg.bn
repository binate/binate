package "main"

// A function value taking a float64 arg, called through the value's
// per-function shim (compiled mode).  Under the uniform all-int shim
// ABI the float arg travels as an i64 slot and the shim bitcasts it
// back (see plan-float-arg-shim.md); this pins that the reshape stays
// correct in compiled mode.  Returning the arg's bit pattern verifies
// the transfer bit-exactly, independent of float->int rounding.  (The
// VM native-extern dispatch path the fix actually targets is covered
// by pkg/binate/vm TestExternFloatArgViaRegistry — a user float func-
// value in -int is bytecode->bytecode and never hits a native shim.)

func floatBits(x float64) int64 {
	return bit_cast(int64, x)
}

func main() {
	var f *func(float64) int64 = floatBits
	// 4.0  -> 0x4010000000000000
	println(f(4.0))   // 4616189618054758400
	// 2.5  -> 0x4004000000000000
	println(f(2.5))   // 4612811918334230528
}
