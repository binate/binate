package "main"

// A function value RETURNING a float64, called through the value's
// shim (compiled mode).  Under the uniform all-int shim ABI the shim
// bitcasts the natural float result into an i64 slot before returning
// and the compiled call site bitcasts it back; verified
// bit-exactly via bit_cast.  (The
// VM native-extern path is covered by pkg/binate/vm
// TestExternFloatReturnViaRegistry.)

func makeHalf(x int) float64 {
	return cast(float64, x) / 2.0
}

func main() {
	var f *func(int) float64 = makeHalf
	// 5 / 2.0 = 2.5  -> 0x4004000000000000
	println(bit_cast(int64, f(5)))   // 4612811918334230528
	// 8 / 2.0 = 4.0  -> 0x4010000000000000
	println(bit_cast(int64, f(8)))   // 4616189618054758400
}
