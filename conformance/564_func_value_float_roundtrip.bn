package "main"
import "pkg/builtins/testing"

// Bit-exact round-trip of a float64 through a function value that
// takes AND returns a float — exercises both the float-arg and the
// float-return halves of the uniform all-int shim ABI in one call.
// 0.1+0.2 has nonzero low mantissa bits, so any int-slot/width
// asymmetry between the call site and the shim (the one way Design A
// could silently miscompile) corrupts the result here.

func identF(x float64) float64 {
	return x
}

func main() {
	var f *func(float64) float64 = identF
	var a float64 = 0.1 + 0.2   // 0x3FD3333333333334
	testing.Println(bit_cast(int64, f(a)))   // 4599075939470750516
	testing.Println(bit_cast(int64, f(3.14)))   // 4614253070214989087
	var z float64 = 0.0
	testing.Println(bit_cast(int64, f(z)))   // 0
}
