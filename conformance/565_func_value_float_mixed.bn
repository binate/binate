package "main"

// Mixed int + float + int args through a function value — the float
// is in arg position 1, between two integer args.  Verifies the int
// args land in GP slots and the float in its own slot independently
// (arbitrary float position), not just "float in slot 0".

func combine(a int, x float64, b int) int64 {
	return bit_cast(int64, x) + cast(int64, a + b)
}

func main() {
	var f *func(int, float64, int) int64 = combine
	// 2.5 bits = 4612811918334230528; a+b = 0
	println(f(0, 2.5, 0))   // 4612811918334230528
	// a+b = 7
	println(f(3, 2.5, 4))   // 4612811918334230535
}
