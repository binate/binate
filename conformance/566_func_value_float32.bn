package "main"
import "pkg/builtins/testing"

// float32 variant: confirms the int slot is exact-width (i32, not a
// widened i64) on both the call site and the shim.  A float32 round-
// trips through a function value bit-exactly.

func identF32(x float32) float32 {
	return x
}

func main() {
	var f *func(float32) float32 = identF32
	var a float32 = 1.5   // 0x3FC00000
	testing.Println(cast(int, bit_cast(int32, f(a))))   // 1069547520
	var b float32 = 0.5   // 0x3F000000
	testing.Println(cast(int, bit_cast(int32, f(b))))   // 1056964608
}
