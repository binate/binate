package "main"

import "pkg/builtins/rt"

// Refcount-balance for additional managed-interface-value copy-sites the
// lifecycle wiring touches that 553 / 554 / 556 / 560 do not reach: a
// var-init direct box, a composite-literal field, an array-of-interface
// element, a by-value struct copy of an interface field, and a deref
// assignment.  Each threads `inner` (rc starts 1) through the op in a
// helper that drops its locals, then re-reads inner's rc — which must
// return to 1 (a leak leaves it >1; a missing move / double dtor drops
// it / crashes).  Green in compiled, VM (-int), and native.

interface Foo {
	foo() int
}

type Inner struct {
	V int
}

type Holder struct {
	Inner @Inner
}

func (h *Holder) foo() int {
	return h.Inner.V
}

impl *Holder : Foo

type Wrap struct {
	F @Foo
}

func makeFoo(inner @Inner) @Foo {
	var h @Holder = make(Holder)
	h.Inner = inner
	return h
}

func consume(t @Foo) {
	println(t.foo())
}

// var-init: box a local @Holder directly into a named @Foo local.
func viaVarInit(i @Inner) {
	var h @Holder = make(Holder)
	h.Inner = i
	var f @Foo = h
	consume(f)
}

// Composite literal with a managed-interface field.
func viaComposite(i @Inner) {
	var w Wrap = Wrap{F: makeFoo(i)}
	consume(w.F)
}

// Array-of-interface element store + per-element dtor.
func viaArray(i @Inner) {
	var arr [2]@Foo
	arr[0] = makeFoo(i)
	consume(arr[0])
}

// By-value struct copy of an interface field (struct-copy retains it,
// the copy's dtor releases it).
func byVal(w Wrap) int {
	return w.F.foo()
}

func viaStructCopy(i @Inner) {
	var w Wrap
	w.F = makeFoo(i)
	println(byVal(w))
}

// Deref assignment overwriting an interface value through a raw pointer.
func viaDeref(i @Inner) {
	var f @Foo = makeFoo(i)
	var p *@Foo = &f
	*p = makeFoo(i)
	consume(f)
}

func main() {
	var a @Inner = make(Inner)
	a.V = 11
	var pa *uint8 = bit_cast(*uint8, a)
	viaVarInit(a)
	print("a=")
	println(rt.Refcount(pa))

	var b @Inner = make(Inner)
	b.V = 22
	var pb *uint8 = bit_cast(*uint8, b)
	viaComposite(b)
	print("b=")
	println(rt.Refcount(pb))

	var c @Inner = make(Inner)
	c.V = 33
	var pc *uint8 = bit_cast(*uint8, c)
	viaArray(c)
	print("c=")
	println(rt.Refcount(pc))

	var d @Inner = make(Inner)
	d.V = 44
	var pd *uint8 = bit_cast(*uint8, d)
	viaStructCopy(d)
	print("d=")
	println(rt.Refcount(pd))

	var e @Inner = make(Inner)
	e.V = 55
	var pe *uint8 = bit_cast(*uint8, e)
	viaDeref(e)
	print("e=")
	println(rt.Refcount(pe))
}
