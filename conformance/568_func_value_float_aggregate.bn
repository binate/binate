package "main"

// A function value with a float64 arg AND an aggregate (struct) return
// exercises emitFuncValueShimAggregate's float-arg path: the retbuf
// return stays natural-typed while the float arg is int-ified like any
// scalar (composing the two shim transforms).

type Vec struct {
	X int
	Y int
	Z int
}

func scaleVec(s float64) Vec {
	var v Vec
	v.X = cast(int, s * 1.0)
	v.Y = cast(int, s * 2.0)
	v.Z = cast(int, s * 3.0)
	return v
}

func main() {
	var f *func(float64) Vec = scaleVec
	var v Vec = f(4.0)
	println(v.X)   // 4
	println(v.Y)   // 8
	println(v.Z)   // 12
}
