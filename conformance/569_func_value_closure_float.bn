package "main"
import "pkg/builtins/testing"

// A capturing closure with a float64 param AND return, over a captured
// float64.  Exercises emitClosureShim's float handling (the closure-
// specific shim path: int-ified signature, i64->double arg
// materialization, and the double->i64 return bitcast) plus a float
// capture (loaded naturally from the closure struct).  Compiled mode
// dispatches through the closure shim directly.

func makeScaler(factor float64) @func(float64) float64 {
	return func(x float64) float64 {
		return x * factor
	}
}

func main() {
	var scale @func(float64) float64 = makeScaler(2.0)
	testing.Println(cast(int, scale(3.0)))   // 3.0 * 2.0 = 6.0 -> 6
}
