package "main"
import "pkg/builtins/testing"

// Verifies that a blank-identifier target in a multi-value assignment —
// both the mixed `_, n = f()` and the all-blank `_, _ = f()` (the shape a
// caller uses to run something purely for effect, e.g. `_, _ =
// process.Run(...)`) — releases the discarded managed component instead of
// leaking it.  idPair returns its @Box argument (a fresh owning ref for
// the caller) alongside an int; assigning the @Box to `_` discards it, so
// that returned ref must be RefDec'd at end of statement.  The multi-
// assign path runs an Axiom-3 copy-RefInc per managed component; for the
// `_` target nothing owns the copy, so that RefInc must be skipped (the
// call-result temp's dtor releases the owned ref).  Otherwise each
// execution leaks one ref — over the loops below b's refcount would climb
// to 101 rather than returning to its baseline of 1.

import "pkg/builtins/rt"

type Box struct {
	V int
}

// idPair returns its argument (a new owning ref for the caller) and an
// int — the multi-return shape that exercises the discard path.
func idPair(b @Box) (@Box, int) {
	return b, 7
}

func main() {
	var b @Box = make(Box)
	b.V = 5
	var p *uint8 = bit_cast(*uint8, b)
	testing.Println(rt.Refcount(p))        // 1: only main's b

	var n int = 0
	for i := 0; i < 100; i++ {
		_, n = idPair(b)
	}
	// Each discarded @Box return is released, so b's refcount returns to
	// baseline rather than climbing by 100.
	testing.Println(rt.Refcount(p))        // 1 iff every discard was released

	// The all-blank form `_, _ = f()` must ALSO release every discarded
	// managed component: each `_` target skips its copy-RefInc, so the call-
	// result temp's dtor is the sole owner and releases the ref at end of
	// statement.  b's refcount stays at baseline across the loop.
	for i := 0; i < 100; i++ {
		_, _ = idPair(b)
	}
	testing.Println(rt.Refcount(p))        // 1 iff every all-blank discard was released
	testing.Println(n)                     // 7
	testing.Println(b.V)                   // 5: b not corrupted
}
