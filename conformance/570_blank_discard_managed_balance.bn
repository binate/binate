package "main"

// Verifies that a blank-identifier target in a multi-value assignment
// (`_, n = f()`) releases the discarded managed component instead of
// leaking it.  idPair returns its @Box argument (a fresh owning ref for
// the caller) alongside an int; assigning the @Box to `_` discards it, so
// that returned ref must be RefDec'd at end of statement.  The multi-
// assign path runs an Axiom-3 copy-RefInc per managed component; for the
// `_` target nothing owns the copy, so that RefInc must be skipped (the
// call-result temp's dtor releases the owned ref).  Otherwise each
// execution leaks one ref — over the loop below b's refcount would climb
// to 101 rather than returning to its baseline of 1.

import "pkg/builtins/rt"

type Box struct {
	V int
}

// idPair returns its argument (a new owning ref for the caller) and an
// int — the multi-return shape that exercises the discard path.
func idPair(b @Box) (@Box, int) {
	return b, 7
}

func main() {
	var b @Box = make(Box)
	b.V = 5
	var p *uint8 = bit_cast(*uint8, b)
	println(rt.Refcount(p))        // 1: only main's b

	var n int = 0
	for i := 0; i < 100; i++ {
		_, n = idPair(b)
	}
	// Each discarded @Box return is released, so b's refcount returns to
	// baseline rather than climbing by 100.
	println(rt.Refcount(p))        // 1 iff every discard was released
	println(n)                     // 7
	println(b.V)                   // 5: b not corrupted
}
