package "main"

// Verifies a multi-value assignment RefDec's the target's OLD managed
// value (Axiom 5: copy-then-destroy).  `a, n = f()` overwrites a's
// previous value, which must be released rather than leaked.  keep aliases
// the object into a; after a is reassigned away from it, keep's refcount
// returns to its baseline of 1 instead of staying elevated.  Pre-fix the
// multi-assign store was a plain overwrite with no RefDec of the old value.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func freshPair() (@Box, int) {
	return make(Box), 9
}

func main() {
	var keep @Box = make(Box)        // keep.rc = 1
	keep.V = 5
	var p *uint8 = bit_cast(*uint8, keep)
	var a @Box = keep                // a aliases keep; keep.rc = 2
	println(rt.Refcount(p))          // 2

	var n int = 0
	a, n = freshPair()               // overwrites a (=keep); old a released
	println(rt.Refcount(p))          // 1 iff the old value was RefDec'd
	println(n)                       // 9
	println(keep.V)                  // 5: keep alive and uncorrupted
}
