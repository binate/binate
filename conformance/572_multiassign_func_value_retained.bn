package "main"
import "pkg/builtins/testing"

// Verifies a @func component in a multi-value assignment is retained
// (copy-RefInc'd), not under-retained.  makePair returns a CAPTURING
// @func over its @Counter argument plus an int; `g, n = makePair(c)` must
// keep the closure record alive so invoking g afterward is sound.  g also
// starts holding a different closure, so the assignment additionally
// exercises RefDec of the overwritten @func.  Without a @func copy-RefInc
// in the multi-assign, the call-result temp's dtor frees the closure
// record and g(5) is a use-after-free (a crash).

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func makePair(c @Counter) (@func(int) int, int) {
	var f @func(int) int = func(d int) int {
		c.N = c.N + d
		return c.N
	}
	return f, 3
}

func main() {
	var c @Counter = make(Counter)
	var g @func(int) int = func(d int) int { return d }
	var n int = 0
	g, n = makePair(c)
	testing.Println(g(5))    // 5: closure intact (c.N 0+5), no use-after-free
	testing.Println(n)       // 3
	testing.Println(c.N)     // 5
}
