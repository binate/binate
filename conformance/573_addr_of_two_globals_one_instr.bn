package "main"

// Two distinct global addresses as args to a SINGLE instruction:
// `return &G, &H` (multi-return) and `&G == &H` (comparison).  The
// compiled (LLVM) backend renders each `@<mangled>` as an independent
// operand and is correct.  The bytecode VM materializes every
// IsGlobalRef arg into one shared `globalReg` via consecutive
// LOAD_IMMs (pkg/binate/vm/lower_func.bn), so the second clobbers the
// first before the instruction consumes either: `return &G, &H` yields
// (&H, &H) and `&G == &H` compares `&H == &H`.  Xfailed in the VM
// (`-int`) modes pending the lower_func fix (see claude-todo).

var G int = 100
var H int = 200

func getBoth() (*int, *int) { return &G, &H }

func main() {
	var a *int
	var b *int
	a, b = getBoth()       // multi-return: two distinct globals, one instr
	a[0] = a[0] + 1        // G = 101
	b[0] = b[0] + 2        // H = 202
	if &G == &H {          // comparison: two distinct globals, one instr
		println(0)
	} else {
		println(1)         // distinct globals → 1
	}
	println(G)             // 101
	println(H)             // 202
}
