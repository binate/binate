package "main"

// Two distinct global addresses as args to a SINGLE instruction:
// `return &G, &H` (multi-return) and `&G == &H` (comparison).  Each
// `@<mangled>` / IsGlobalRef arg must materialize into its OWN register;
// a backend that funnels every IsGlobalRef into one shared register
// clobbers the first before the instruction consumes either — `return
// &G, &H` would then yield (&H, &H) and `&G == &H` would compare
// `&H == &H`.  (The bytecode VM's lower_func.bn once did exactly that
// via consecutive LOAD_IMMs into one `globalReg`; now fixed.)  Pins that
// every backend keeps the two addresses distinct.

var G int = 100
var H int = 200

func getBoth() (*int, *int) { return &G, &H }

func main() {
	var a *int
	var b *int
	a, b = getBoth()       // multi-return: two distinct globals, one instr
	a[0] = a[0] + 1        // G = 101
	b[0] = b[0] + 2        // H = 202
	if &G == &H {          // comparison: two distinct globals, one instr
		println(0)
	} else {
		println(1)         // distinct globals → 1
	}
	println(G)             // 101
	println(H)             // 202
}
