package "main"

// Multi-value assignment into a managed-STRUCT aggregate target — a struct
// FIELD (`h.W, n = f()`) and a managed-slice ELEMENT (`s[0], n = f()`) —
// must save-copy-destroy the aggregate (the copy RefIncs the new value's
// managed fields; the dtor releases the old element's), not store it raw.
// A raw store left the new aggregate's captured @Counter under-retained
// (refcount stayed 1 instead of 2) — a double-free at scope end.

import "pkg/builtins/rt"

type Counter struct { N int }
type Wrap struct { C @Counter }
type Holder struct { W Wrap }

func wrapOf(c @Counter, v int) (Wrap, int) {
	var w Wrap
	w.C = c
	c.N = v
	return w, 9
}

func main() {
	// SELECTOR target: the managed struct field h.W.
	var c @Counter = make(Counter)
	var pc *uint8 = bit_cast(*uint8, c)
	var h @Holder = make(Holder)
	var n int = 0
	h.W, n = wrapOf(c, 5)
	println(h.W.C.N)            // 5: c reachable through h.W.C
	println(n)                  // 9
	println(rt.Refcount(pc))   // 2: main's c + h.W.C

	// INDEX target: a managed-slice element s[0] (also a managed struct).
	var d @Counter = make(Counter)
	var pd *uint8 = bit_cast(*uint8, d)
	var s @[]Wrap = make_slice(Wrap, 1)
	var m int = 0
	s[0], m = wrapOf(d, 6)
	println(s[0].C.N)          // 6: d reachable through s[0].C
	println(m)                 // 9
	println(rt.Refcount(pd))   // 2: main's d + s[0].C
}
