package "main"

// Regression for the self-referential interface method bug: an
// interface whose method's return type is its own interface
// (`next() @Node`) mis-resolved that return type to a managed pointer,
// because the interface was not yet registered in the module interface
// table while its OWN method signatures were being resolved.  The
// dispatch shim then carried an `i8*` return while the method body
// returned a 16-byte `%BnIfaceValue` — an in-module ABI mismatch
// (caught by the LLVM verifier as `extractvalue` on an `i8*`, silent on
// store-only dispatch paths).  Compiling at all proves the shim and the
// body agree; the walk proves runtime correctness.

interface Node {
	val()  int
	next() @Node
}

type Leaf struct {
	v int
}

func (n *Leaf) val()  int   { return n.v }
func (n *Leaf) next() @Node { var none @Node; return none }
impl *Leaf : Node

type Link struct {
	v    int
	rest @Node
}

func (n *Link) val()  int   { return n.v }
func (n *Link) next() @Node { return n.rest }
impl *Link : Node

func leaf(v int) @Node {
	var l @Leaf = make(Leaf)
	l.v = v
	var n @Node = l
	return n
}

func link(v int, rest @Node) @Node {
	var l @Link = make(Link)
	l.v = v
	l.rest = rest
	var n @Node = l
	return n
}

func main() {
	// Chain 3 -> 2 -> 1.  Walk via the self-returning next(), summing
	// values and counting links until the empty leaf-cause.
	var head @Node = link(3, link(2, leaf(1)))
	var sum int = 0
	var count int = 0
	var cur @Node = head
	for present(cur) {
		sum = sum + cur.val()
		count = count + 1
		cur = cur.next()
	}
	println(sum)
	println(count)
}
