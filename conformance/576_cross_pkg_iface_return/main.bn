package "main"

import "pkg/shape"

// Regression for the cross-package interface-value return bug: a
// consumer calling an imported function declared to return a managed
// interface value (`shape.Make(n) @Shape`) lowered the call as returning
// a single pointer (`i8*`) instead of the 2-word `%BnIfaceValue`,
// because the imported `.bni`'s bare interface name resolved only under
// the consumer's own package, never the imported package — an ABI
// mismatch with the callee.  (Distinct from the self-referential bug
// 575; Shape here is NOT self-referential.)
func main() {
	var s @shape.Shape = shape.Make(4)
	println(s.area())
	// A returned interface value passed straight into another import.
	println(shape.Area(shape.Make(5)))
}
