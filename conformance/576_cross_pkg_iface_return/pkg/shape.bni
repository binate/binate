package "pkg/shape"

// Shape is a minimal non-self-referential interface used to exercise a
// cross-package function whose return type is a managed interface value.
interface Shape {
	area() int
}

// Make boxes a square of side n into a Shape and returns it.
func Make(n int) @Shape

// Area is a returns-int helper that consumes a Shape by value.
func Area(s @Shape) int
