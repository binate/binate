package "main"

import "pkg/std/errors"

// End-to-end test for pkg/std/errors as a cross-package consumer: it
// exercises New/Wrap, Error()/Unwrap(), present(), a chain-walk, and the
// (T, @Error) error-return convention — so it covers both the
// self-referential Unwrap() @Error dispatch (575) and the cross-package
// @Error return (576) in the real API.  (Interface-value refcount
// balance is pinned separately by 553/554/556/560/567.)

func eq(got @[]char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

func yn(b bool) int {
	if b { return 1 }
	return 0
}

// parse models a fallible call: empty @Error on success, a leaf on failure.
func parse(ok bool) (int, @errors.Error) {
	if ok {
		var none @errors.Error
		return 42, none
	}
	return 0, errors.New("parse failed")
}

func main() {
	// Leaf: message preserved, Unwrap() empty.
	var e1 @errors.Error = errors.New("boom")
	println(yn(eq(e1.Error(), "boom")))
	println(yn(present(e1.Unwrap())))

	// Wrap: "ctx: cause"; Unwrap() returns the cause intact.
	var e2 @errors.Error = errors.Wrap(errors.New("disk full"), "save")
	println(yn(eq(e2.Error(), "save: disk full")))
	var c @errors.Error = e2.Unwrap()
	println(yn(eq(c.Error(), "disk full")))

	// Three-layer chain renders fully and walks to exactly 3 links.
	var chain @errors.Error = errors.Wrap(
		errors.Wrap(errors.New("root"), "mid"), "top")
	println(yn(eq(chain.Error(), "top: mid: root")))
	var cur @errors.Error = chain
	var n int = 0
	for present(cur) {
		n = n + 1
		cur = cur.Unwrap()
	}
	println(n)

	// (T, @Error) convention: success → no error, value through;
	// failure → present error with its message.
	var v int
	var err @errors.Error
	v, err = parse(true)
	println(yn(present(err)))
	println(v)
	v, err = parse(false)
	println(yn(present(err)))
	println(yn(eq(err.Error(), "parse failed")))
}
