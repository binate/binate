package "main"

// Regression for a bytecode-VM multi-return bug: a function returning
// a tuple with an interface-value component (`(int, @Foo)`) packed that
// component as a single scalar word instead of memcpying its 16 bytes,
// so the caller received a dangling address into the reclaimed callee
// frame — the scope-exit iface dtor then read an out-of-range vtable
// index and crashed (`vm: iface_dtor: vtable index out of range`).
// Compiled/native were already correct; this only reproduced under
// `-int` / `-int-int`.  (The single-return @Foo case is pinned by 560;
// this adds the multi-return component.)

interface Foo {
	foo() int
}

type Box struct {
	v int
}

func (b *Box) foo() int { return b.v }
impl *Box : Foo

// two returns a value plus an interface: an empty @Foo on the `ok`
// branch, a boxed Box otherwise — exercising both an empty and a
// present interface component through the multi-return path.
func two(ok bool) (int, @Foo) {
	if ok {
		var none @Foo
		return 1, none
	}
	var b @Box = make(Box)
	b.v = 9
	var f @Foo = b
	return 0, f
}

func main() {
	var v int
	var e @Foo
	v, e = two(true)
	println(v)
	if present(e) { println(100) } else { println(200) }
	// Reassign the interface component (drops the empty one, moves in a
	// present one) — the reassignment's dtor of the old value is what
	// crashed pre-fix.
	v, e = two(false)
	println(v)
	if present(e) { println(e.foo()) } else { println(300) }
}
