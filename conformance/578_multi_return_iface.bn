package "main"
import "pkg/builtins/testing"

// Multi-return of a tuple with an interface-value component
// (`(int, @Foo)`): the bytecode VM must memcpy the component's 16 bytes.
// A VM that packs it as a single scalar word hands the caller a dangling
// address into the reclaimed callee frame — the scope-exit iface dtor
// then reads an out-of-range vtable index and crashes (`vm: iface_dtor:
// vtable index out of range`).  The packing is VM-specific, so `-int` /
// `-int-int` are the modes that exercise it.  (The single-return @Foo
// case is pinned by 560; this adds the multi-return component.)

interface Foo {
	foo() int
}

type Box struct {
	v int
}

func (b *Box) foo() int { return b.v }
impl *Box : Foo

// two returns a value plus an interface: an empty @Foo on the `ok`
// branch, a boxed Box otherwise — exercising both an empty and a
// present interface component through the multi-return path.
func two(ok bool) (int, @Foo) {
	if ok {
		var none @Foo
		return 1, none
	}
	var b @Box = make(Box)
	b.v = 9
	var f @Foo = b
	return 0, f
}

func main() {
	var v int
	var e @Foo
	v, e = two(true)
	testing.Println(v)
	if present(e) { testing.Println(100) } else { testing.Println(200) }
	// Reassign the interface component (drops the empty one, moves in a
	// present one) — the reassignment's dtor of the old value is what
	// crashes when the component is mis-packed.
	v, e = two(false)
	testing.Println(v)
	if present(e) { testing.Println(e.foo()) } else { testing.Println(300) }
}
