package "main"
import "pkg/builtins/testing"

// Multi-return of a function-value component.  A function returning a
// tuple with a `@func` slot — `(int, @func(int) int)` — returns a 16-byte
// address-based value; a bytecode VM that packs it as a single scalar word
// (only the slot address, into the reclaimed callee frame) makes the
// caller read an invalid closure record and crash.  (The LLVM/IR side —
// preserving the closure capture through the multi-value path — is
// covered by the multi-assign refcount test 572; this adds the VM packing
// of the component, the analogue of 578's interface case.)  Exercises an
// empty @func component, a capturing one, the reassignment that drops the
// empty and moves in the capturing value, and invocation (the capture must
// survive).

func adder(n int) @func(int) int {
	return func(x int) int { return x + n }
}

func two(ok bool) (int, @func(int) int) {
	if ok {
		var none @func(int) int
		return 1, none
	}
	return 0, adder(10)
}

func main() {
	var v int
	var f @func(int) int
	v, f = two(true)
	testing.Println(v)
	v, f = two(false)
	testing.Println(v)
	testing.Println(f(5))
	testing.Println(f(20))
}
