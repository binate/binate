package "main"

// Coverage for two address-based aggregate components in one
// multi-return tuple, one of them at offset 0: `(@func(int) int, @Foo)`.
// 578 / 579 each cover a SINGLE aggregate component in second position
// (after an int); this pins the packMultiReturn offsets + EXTRACT
// pointer-mode when an interface/function value is the FIRST component
// and when two such values share a tuple (func at offset 0, iface at
// offset 16) — and that both survive to invocation.

interface Foo {
	foo() int
}

type Box struct {
	v int
}

func (b *Box) foo() int { return b.v }
impl *Box : Foo

func adder(n int) @func(int) int {
	return func(x int) int { return x + n }
}

func pair() (@func(int) int, @Foo) {
	var b @Box = make(Box)
	b.v = 7
	var fo @Foo = b
	return adder(100), fo
}

func main() {
	var f @func(int) int
	var fo @Foo
	f, fo = pair()
	println(f(5))
	println(fo.foo())
}
