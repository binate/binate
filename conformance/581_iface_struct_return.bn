package "main"

// Returning a plain by-value struct through an interface method.
// conformance/553 covers returning a scalar (int) and a managed-slice
// (@[]char) through interface dispatch, but a plain by-value struct
// return was untested.
//
// The bug this pins: an interface method's result type was resolved
// during interface collection, which ran BEFORE the module's struct
// names were registered — so a struct result declared later in the file
// fell back to `int` (resolveTypeExpr's unresolved-name fallback).  The
// OP_CALL_IFACE_METHOD return type then degraded to a single word, and
// the vtable-dispatched aggregate return came back with only its first
// field correct (later fields garbage).  Interfaces are deliberately
// declared BEFORE the structs they return here to exercise that order.

interface Box { get() Pair }
interface Box3 { get3() Triple }

type Pair struct {
	A int
	B int
}

type Triple struct {
	A int
	B int
	C int
}

type Impl struct {
	x int
}

// Managed receiver.
func (i @Impl) get() Pair {
	var p Pair
	p.A = 7
	p.B = 9
	return p
}

// Raw receiver returning a 3-field struct.
func (i *Impl) get3() Triple {
	var t Triple
	t.A = 11
	t.B = 22
	t.C = 33
	return t
}

impl @Impl : Box
impl *Impl : Box3

func main() {
	var im @Impl = make(Impl)

	// 2-field via the interface (vtable dispatch).
	var b @Box = im
	var p Pair = b.get()
	println(p.A)
	println(p.B)

	// 3-field via the interface.
	var b3 @Box3 = im
	var t Triple = b3.get3()
	println(t.A)
	println(t.B)
	println(t.C)
}
