package "main"

// A single-value assignment into a managed-aggregate ARRAY element
// (`arr[i] = w` where the element is a struct BY VALUE holding a managed
// field) must save-copy-destroy: RefDec the old element's managed field
// and RefInc the new one's.  The single-assign array-element path handled
// the four managed SCALAR element kinds but had no needsStructCopy arm, so
// a managed-aggregate element was plain-stored — leaking the old element's
// managed field and under-retaining the new.  (Single-assign SELECTOR and
// slice-element already handled it; this pins the array sibling.)

import "pkg/builtins/rt"

type Box struct {
	V int
}

type Wrap struct {
	b @Box
}

func main() {
	var keep @Box = make(Box)                       // keep.rc = 1
	keep.V = 5
	var arr [2]Wrap
	arr[0].b = keep                                 // keep.rc = 2
	println(rt.Refcount(bit_cast(*uint8, keep)))    // 2

	var fresh Wrap
	fresh.b = make(Box)
	fresh.b.V = 9
	arr[0] = fresh                                  // old (keep) released, new retained
	println(rt.Refcount(bit_cast(*uint8, keep)))    // 1
	println(arr[0].b.V)                             // 9: new field live, not UAF
	println(keep.V)                                 // 5: keep alive & uncorrupted
}
