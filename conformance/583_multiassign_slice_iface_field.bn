package "main"

// A multi-value assignment into a managed-slice element whose struct holds
// an @Iface field must save-copy-destroy COMPLETELY: release the old
// element's @Iface field and retain the new one's.  The slice-aggregate
// case routes through emitStructCopy/emitStructDtor (the type's generated
// __copy_/__dtor_ helpers), which cover @Iface fields and nested
// aggregates.  An earlier field-by-field reimplementation
// (emitStructElemRefcount) omitted @Iface fields, so the old element's
// iface receiver leaked — its refcount never returned to baseline.  c is
// aliased into s[0]'s @Speaker field; after s[0] is reassigned, c's
// refcount must return to 1.

import "pkg/builtins/rt"

interface Speaker {
	speak() int
}

type Counter struct {
	N int
}

func (c *Counter) speak() int {
	return c.N
}

impl *Counter : Speaker

type Wrap struct {
	s @Speaker
}

func wrapOf(sp @Speaker, v int) (Wrap, int) {
	var w Wrap
	w.s = sp
	return w, v
}

func main() {
	var c @Counter = make(Counter)               // c.rc = 1
	var pc *uint8 = bit_cast(*uint8, c)
	var s @[]Wrap = make_slice(Wrap, 1)
	s[0].s = c                                   // s[0].s wraps c; c.rc = 2
	println(rt.Refcount(pc))                     // 2

	var n int = 0
	var c2 @Counter = make(Counter)
	s[0], n = wrapOf(c2, 7)                      // overwrite s[0]; old iface(c) released
	println(rt.Refcount(pc))                     // 1: old @Iface field RefDec'd
	println(n)                                   // 7
}
