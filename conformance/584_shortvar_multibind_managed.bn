package "main"
import "pkg/builtins/testing"

// A short-var multi-bind `q, n := f()` binding a managed component must
// acquire it (Axiom-3 copy-RefInc) just like the `=` form (genMultiAssign).
// The extracted component is a BORROW from the call-result temp, whose dtor
// RefDec's it at end of statement; without the acquire the new var's
// scope-exit dtor RefDec's the same allocation a second time — a double-
// free.  Here q := a fresh @Box: the acquire balances the temp's dtor so q
// owns one live ref (rc 1); aliasing it into keep then reads rc 2.  Pre-fix
// q was freed at the end of the `:=` statement and `var keep = q` was a
// use-after-free.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func freshPair() (@Box, int) {
	var b @Box = make(Box)
	b.V = 5
	return b, 7
}

func main() {
	q, n := freshPair()                        // short-var multi-bind: q := @Box
	var keep @Box = q                          // alias q; q.rc → 2
	testing.Println(rt.Refcount(bit_cast(*uint8, q)))  // 2: q owns a live ref + keep
	testing.Println(q.V)                               // 5: live, not use-after-free
	testing.Println(n)                                 // 7
	testing.Println(keep.V)                            // 5
}
