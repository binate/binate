package "main"

import "pkg/shape"

// A by-value struct returned through a CROSS-PACKAGE interface dispatch:
// shape.Boxer.mk() returns shape.Pair, and main holds only the
// interface value.  Both fields must survive (the single-package case is
// conformance/581).

func main() {
	var b @shape.Boxer = shape.New()
	var p shape.Pair = b.mk()
	println(p.A)
	println(p.B)
}
