package "pkg/shape"

// Boxer's method returns Pair (a by-value struct in this same package).
// The cross-package angle: when the importing TU compiles, shape's
// interfaces are collected by RegisterAllInterfaces and its struct names
// by RegisterStructTypes — the latter runs first, so Boxer.mk's Pair
// result resolves to the real struct rather than the int fallback.
interface Boxer {
	mk() Pair
}

type Pair struct {
	A int
	B int
}

type Impl struct {
	x int
}

func New() @Impl
