package "main"
import "pkg/builtins/testing"

import "pkg/store"
import "pkg/builtins/rt"

// Refcount balance for copying an extern managed-PTR var
// (`var n @T = pkg.G`): the copy RefIncs (rc 1->2) and n's scope-end
// RefDec brings it back (2->1).  `rc after: 1` confirms no leak (would
// stay 2) and no over-free (would free pkg.G's object, reading 0 /
// faulting on the next access).  Companion to 559, which covers the
// aliasing in every mode; this one needs an `rt` import (rt.Refcount),
// which trips the pre-existing int-int loader bug, so it is xfailed in
// builder-comp-int-int only.
func mutate() {
	var n @store.Node = store.G   // value-copy: rc 1->2
	n.V = 5
}                                  // n out of scope: rc 2->1

func main() {
	var ptr *uint8 = bit_cast(*uint8, store.G)
	testing.Print("rc before: ")
	testing.Println(rt.Refcount(ptr))    // 1
	mutate()
	testing.Print("rc after: ")
	testing.Println(rt.Refcount(ptr))    // 1 — balanced
	testing.Println(store.G.V)           // 5 — n aliased pkg.G
}
