package "main"

// A closure that CAPTURES another @func value must RefInc the captured
// @func's record (gen_func_lit.bn emitCaptureRefInc), balancing the
// RefDec the closure struct's dtor runs (@func is NeedsDestruction).
// Without the capture-side RefInc the captured @func is under-retained:
// its record frees when the source @func's scope ends, and the wrapper
// then calls / dtor's freed memory (use-after-free; surfaced as a SIGSEGV
// in __dtor_closure_* under guard-malloc).
//
// This pins it deterministically via refcounts (no sanitizer needed):
// `inner` captures @Counter c, and `w` captures the @func `inner`.  When
// makeWrapper returns, inner's local scope ends — so w must own a ref to
// inner, keeping inner (and thus c) alive.  With the bug inner frees at
// return and releases c, dropping c's count back to 1.  Dropping w then
// returns c to baseline — confirming the new capture RefInc is balanced
// by the closure dtor's RefDec (no leak in the over-retain direction).

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func makeWrapper(c @Counter) @func() int {
	var inner @func() int = func() int { return c.N }
	var w @func() int = func() int { return inner() }
	return w
}

func main() {
	var c @Counter = make(Counter)
	c.N = 7
	var p *uint8 = bit_cast(*uint8, c)
	println(rt.Refcount(p))   // 1: only main's c
	var w @func() int = makeWrapper(c)
	println(rt.Refcount(p))   // 2: main's c + the live inner's capture
	println(w())              // 7: through w -> inner -> c.N
	// Drop w (assign a fresh @func over it): the old wrapper's dtor
	// releases inner, whose dtor releases c.  The new capture RefInc is
	// balanced, so c returns to baseline (no leak).  The typed var gives
	// the replacement literal its flavour hint.
	var drop @func() int = func() int { return 0 }
	w = drop
	println(rt.Refcount(p))   // 1: back to baseline
}
