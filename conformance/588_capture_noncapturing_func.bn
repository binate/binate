package "main"
import "pkg/builtins/testing"

// Capturing a NON-capturing @func (its data slot is nil) must be safe:
// the capture-site RefInc (gen_func_lit.bn emitCaptureRefInc) has to
// tolerate a nil @func data slot.  Pins against a future nil-RefInc
// regression in the @func capture path (sibling of conformance/587,
// which covers the capturing-@func flavour).

func main() {
	var f @func() int = func() int { return 9 }
	var w @func() int = func() int { return f() }
	testing.Println(w())
}
