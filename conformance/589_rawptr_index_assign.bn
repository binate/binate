package "main"
import "pkg/builtins/testing"

// A single-value assignment through a raw-pointer element (`p[i] = v` where
// p is a raw pointer `*T` to a managed slot) must obey Axiom 5: RefDec the
// overwritten managed value and acquire the new one.  The single-assign
// INSTANTIATE_OR_INDEX TYP_POINTER arm was a bare GEP+store with no element
// refcounting — leaking the old element and under-retaining the new (a
// double-free at scope exit) — while the adjacent array arm and the
// multi-assign pointer arm both refcount.  The raw pointer only excuses
// tracking the *block*'s lifetime, not balancing the managed values inside.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func main() {
	var a @Box = make(Box)                       // a.rc = 1
	a.V = 5
	var b @Box = make(Box)                       // b.rc = 1
	b.V = 9
	var arr [2]@Box
	arr[0] = a                                   // a.rc = 2
	arr[1] = a                                   // a.rc = 3
	var p *@Box = &arr[0]                         // raw pointer to arr[0]
	testing.Println(rt.Refcount(bit_cast(*uint8, a)))    // 3
	testing.Println(rt.Refcount(bit_cast(*uint8, b)))    // 1
	p[0] = b                                      // old (a) released 3->2, b acquired 1->2
	testing.Println(rt.Refcount(bit_cast(*uint8, a)))    // 2
	testing.Println(rt.Refcount(bit_cast(*uint8, b)))    // 2
	testing.Println(arr[0].V)                            // 9: new element live, not UAF
	testing.Println(a.V)                                 // 5: a alive & uncorrupted
}
