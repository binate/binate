package "main"
import "pkg/builtins/testing"

// An array literal whose element is a managed AGGREGATE (a struct BY VALUE
// holding a managed field) must acquire each element's managed fields: the
// array co-owns them, and its scope-exit dtor RefDec's them, so without the
// per-element acquire the source is under-retained (a double-free when both
// the source and the array are destroyed).  genArrayLit stored each element
// bare (no acquire) — this pins the `[N]Wrap{...}` acquire via the generated
// __copy_ helper.

import "pkg/builtins/rt"

type Box struct {
	V int
}

type Wrap struct {
	b @Box
}

func main() {
	var keep @Box = make(Box)                    // keep.rc = 1
	keep.V = 7
	var w Wrap
	w.b = keep                                   // field assign acquires: keep.rc = 2
	testing.Println(rt.Refcount(bit_cast(*uint8, keep))) // 2
	var arr [2]Wrap = [2]Wrap{w, w}              // each element copies w: keep.rc = 4
	testing.Println(rt.Refcount(bit_cast(*uint8, keep))) // 4
	testing.Println(arr[0].b.V)                          // 7
	testing.Println(arr[1].b.V)                          // 7
}
