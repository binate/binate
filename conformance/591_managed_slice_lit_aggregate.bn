package "main"
import "pkg/builtins/testing"

// A managed-slice literal whose element is a managed AGGREGATE must acquire
// each element's managed fields, same as the array-literal case (590).
// genManagedSliceLit handled managed-scalar elements but had no
// needsStructCopy arm, so `@[]Wrap{...}` stored the struct bytes without
// RefInc'ing the managed field — under-retain → double-free at scope exit.

import "pkg/builtins/rt"

type Box struct {
	V int
}

type Wrap struct {
	b @Box
}

func main() {
	var keep @Box = make(Box)                    // keep.rc = 1
	keep.V = 7
	var w Wrap
	w.b = keep                                   // field assign acquires: keep.rc = 2
	testing.Println(rt.Refcount(bit_cast(*uint8, keep))) // 2
	var s @[]Wrap = @[]Wrap{w, w}                // each element copies w: keep.rc = 4
	testing.Println(rt.Refcount(bit_cast(*uint8, keep))) // 4
	testing.Println(s[0].b.V)                            // 7
	testing.Println(s[1].b.V)                            // 7
}
