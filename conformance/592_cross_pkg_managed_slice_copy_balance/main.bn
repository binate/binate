package "main"
import "pkg/builtins/testing"

import "pkg/store"
import "pkg/builtins/rt"

// Refcount balance for copying an extern managed-SLICE var
// (`var t @[]int = pkg.S`): the copy shares pkg.S's backing and RefIncs
// it; the copy's scope-end RefDec brings it back.  Companion to 586
// (managed-ptr); 558 covers the slice's functional behavior in all
// modes but not refcount balance.  `rc after` == `rc before` confirms
// no leak (would be higher) and no over-free (would free the backing).
// Needs rt.Refcount, so xfailed in builder-comp-int-int (the
// pre-existing rt-loader bug, 136/383 family).

// readBackingRC reads a managed-slice's backing refcount from word 2 of
// its header (see 130_managed_slice_backing_rc).
func readBackingRC(p *int) int {
	var backingPtr *uint8 = bit_cast(*uint8, p[2])
	if backingPtr == nil { return 0 }
	return rt.Refcount(backingPtr)
}

func copyOnce() {
	var t @[]int = store.S   // cross-pkg value-copy: backing rc +1
	t[0] = 9                 // write through the shared backing
}                              // t out of scope: backing rc -1

func main() {
	var a @[]int = store.S   // copy so we can observe the backing rc
	var pa *int = bit_cast(*int, &a)
	testing.Print("rc before: ")
	testing.Println(readBackingRC(pa))   // 2 (store.S + a)
	copyOnce()
	testing.Print("rc after: ")
	testing.Println(readBackingRC(pa))   // 2 — balanced
	testing.Println(store.S[0])          // 9 — copyOnce wrote through the shared backing
}
