package "main"

// Interface method dispatch must apply the same argument coercions the
// regular call path does.  genInterfaceMethodCall used bare genExpr and
// skipped them, so:
//   - a managed-slice arg (`@[]uint8`, 4 words) passed to a raw-slice param
//     (`*[]readonly uint8`, 2 words) was passed at the wrong width, shifting
//     the following scalar arg (the `eof bool` here) — it read as garbage;
//   - a bare function name passed to a `@func` param wasn't func-value-lifted.
// This pins both, for an OWN method, an INHERITED (embedded-interface) method
// — whose param types come from the parent interface — and a func-value arg.

import "pkg/bootstrap"

type Res struct {
	a int
	b int
	c int
}

interface Stepper {
	Step(line *[]readonly uint8, eof bool) Res
}

// Stepper2 embeds Stepper; Step is inherited (its param types live on the
// parent interface, exercising the inheritance-walk param lookup).
interface Stepper2 : Stepper {
	Extra() int
}

type ownImpl struct {
	tag int
}

impl @ownImpl : Stepper

func (s @ownImpl) Step(line *[]readonly uint8, eof bool) Res {
	var r Res
	if eof {
		r.a = 700
	} else {
		r.a = len(line)
	}
	return r
}

type extImpl struct {
	tag int
}

impl @extImpl : Stepper2

func (s @extImpl) Step(line *[]readonly uint8, eof bool) Res {
	var r Res
	if eof {
		r.a = 700
	} else {
		r.a = len(line)
	}
	return r
}

func (s @extImpl) Extra() int {
	return 9
}

interface Applier {
	Apply(f @func(int) int, x int) int
}

type appImpl struct {
	tag int
}

impl @appImpl : Applier

func (s @appImpl) Apply(f @func(int) int, x int) int {
	return f(x)
}

func dbl(x int) int {
	return x * 2
}

func main() {
	var line @[]uint8 = make_slice(uint8, 3)
	// Own method: eof must survive the managed-slice arg.
	var s @Stepper = make(ownImpl)
	var r1 Res = s.Step(line, true)
	var r2 Res = s.Step(line, false)
	println(r1.a)        // 700 (eof=true)
	println(r2.a)        // 3   (eof=false -> len)
	// Inherited method via the embedding interface.
	var s2 @Stepper2 = make(extImpl)
	var r3 Res = s2.Step(line, true)
	println(r3.a)        // 700
	println(s2.Extra())  // 9
	// Func-value arg: a bare function name must be lifted to a @func value.
	var ap @Applier = make(appImpl)
	println(ap.Apply(dbl, 21))  // 42
	bootstrap.Exit(0)
}
