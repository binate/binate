package "main"
import "pkg/builtins/testing"

// Regular method calls must marshal args like every other call site.
// genMethodCall used bare genExpr, so a bare function-name arg to a func-value
// method param was not lifted -> it became the zero placeholder and the call
// dispatched on null (SIGSEGV).  Pins func-ref lifting, plus the managed-field
// struct-copy and managed->raw coercions on a METHOD arg (which route through
// the shared coerceArg).

type Box struct {
	v int
}

type W struct {
	b @Box
}

type Calc struct {
	base int
}

func (c *Calc) apply(f *func(int) int, x int) int {
	return c.base + f(x)
}

func (c *Calc) take(w W, tag int) int {
	return w.b.v + tag
}

func (c *Calc) sum(xs *[]readonly int, n int) int {
	var s int = 0
	for i := 0; i < len(xs); i++ {
		s = s + xs[i]
	}
	return s + n
}

func dbl(x int) int {
	return x * 2
}

func main() {
	var c Calc
	c.base = 100
	testing.Println(c.apply(dbl, 21))  // 142: bare func name lifted to a func value
	var w W
	w.b = make(Box)
	w.b.v = 5
	testing.Println(c.take(w, 3))      // 8: struct-by-value (managed field) method arg
	var xs @[]int = make_slice(int, 3)
	xs[0] = 1
	xs[1] = 2
	xs[2] = 3
	testing.Println(c.sum(xs, 10))     // 16: @[]int -> *[]readonly int method arg
}
