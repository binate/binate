package "main"

// A by-value struct arg with a managed field, passed through a FUNCTION VALUE,
// must get the same caller-side struct-copy RefInc the other call sites apply.
// genFuncValueCallWithFn omitted it, so the callee's scope dtor RefDec'd the
// field once too often -> the caller's reference was freed under it (UAF).

import "pkg/builtins/rt"

type Box struct {
	v int
}

type W struct {
	b @Box
}

func useW(w W) int {
	return w.b.v
}

func main() {
	var w W
	w.b = make(Box)
	w.b.v = 42
	println(rt.Refcount(bit_cast(*uint8, w.b)))  // 1
	var f *func(W) int = useW
	println(f(w))                                 // 42
	println(rt.Refcount(bit_cast(*uint8, w.b)))  // 1: balanced (was 0 / freed)
}
