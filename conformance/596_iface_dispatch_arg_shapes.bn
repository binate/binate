package "main"

// Interface dispatch must apply the regular path's arg coercions.  593 pins
// managed->raw + bool + func-value; this pins string-literal->chars and
// integer-literal narrowing through a vtable (both <=2 words, which the
// dispatch ABI passes correctly).  Multi-word by-value args are a separate,
// tracked dispatch-ABI bug — see conformance/598.

interface Sink {
	Log(msg *[]readonly char, n int) int
	Pack(hi uint8, lo uint8) int
}

type sinkImpl struct {
	tag int
}

impl @sinkImpl : Sink

func (s @sinkImpl) Log(msg *[]readonly char, n int) int {
	return len(msg) + n
}
func (s @sinkImpl) Pack(hi uint8, lo uint8) int {
	return cast(int, hi) * 256 + cast(int, lo)
}

func main() {
	var s @Sink = make(sinkImpl)
	println(s.Log("abc", 5))   // string-lit: 3+5 = 8
	println(s.Pack(1, 255))    // int-narrow: 256+255 = 511
}
