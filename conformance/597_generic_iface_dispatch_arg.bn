package "main"

// Generic-interface method dispatch must coerce args too: the generic
// instantiation site (ensureInstantiatedInterface) populates the param-type
// store separately from the non-generic decl site, so this pins the generic
// copy of the arg-coercion path (managed-slice->raw + a trailing bool).

import "pkg/bootstrap"

interface Producer[T any] {
	Make(line *[]readonly uint8, flag bool) T
}

type intProd struct {
	tag int
}

impl @intProd : Producer[int]

func (s @intProd) Make(line *[]readonly uint8, flag bool) int {
	if flag {
		return 700
	}
	return len(line)
}

func main() {
	var p @Producer[int] = make(intProd)
	var line @[]uint8 = make_slice(uint8, 3)
	println(p.Make(line, true))   // 700: flag survives the managed-slice arg
	println(p.Make(line, false))  // 3
	bootstrap.Exit(0)
}
