package "main"
import "pkg/builtins/testing"

// A multi-word (>16-byte) by-value arg through interface dispatch must not
// shift and drop the FOLLOWING scalar arg.  A struct-with-managed-field and a
// @[]T managed-slice param are both 4 words; the vtable thunk passes them by
// pointer (writeByvalArgPreamble) so the trailing `tag`/`n` lands in the right
// register rather than reading 0.  Distinct from 593, where coerceArg narrows a
// managed slice to a 2-word raw slice.

type Box struct {
	data @[]int
}

interface Sink {
	Take(b Box, tag int) int
	Hold(xs @[]int, n int) int
}

type sinkImpl struct {
	tag int
}

impl @sinkImpl : Sink

func (s @sinkImpl) Take(b Box, tag int) int {
	return len(b.data) + tag
}
func (s @sinkImpl) Hold(xs @[]int, n int) int {
	return len(xs) + n
}

func main() {
	var s @Sink = make(sinkImpl)
	var b Box
	b.data = make_slice(int, 4)
	testing.Println(s.Take(b, 5))   // want 9 (4+5); bug drops tag -> 4
	var v @[]int = make_slice(int, 4)
	testing.Println(s.Hold(v, 1))   // want 5 (4+1); bug drops n -> 4
}
