package "main"

// KNOWN BUG (xfail): a multi-word by-value arg through interface dispatch
// shifts and drops the FOLLOWING scalar arg.  A struct-with-managed-field and
// a @[]T managed-slice param are both 4 words; the vtable thunk's arg ABI
// (pkg/binate/codegen emit_iface_call) mis-passes them, so `tag`/`n` read as
// 0.  Distinct from 593 (which works because coerceArg NARROWS a managed slice
// to a 2-word raw slice).  See claude-todo.md.

import "pkg/bootstrap"

type Box struct {
	data @[]int
}

interface Sink {
	Take(b Box, tag int) int
	Hold(xs @[]int, n int) int
}

type sinkImpl struct {
	tag int
}

impl @sinkImpl : Sink

func (s @sinkImpl) Take(b Box, tag int) int {
	return len(b.data) + tag
}
func (s @sinkImpl) Hold(xs @[]int, n int) int {
	return len(xs) + n
}

func main() {
	var s @Sink = make(sinkImpl)
	var b Box
	b.data = make_slice(int, 4)
	println(s.Take(b, 5))   // want 9 (4+5); bug drops tag -> 4
	var v @[]int = make_slice(int, 4)
	println(s.Hold(v, 1))   // want 5 (4+1); bug drops n -> 4
	bootstrap.Exit(0)
}
