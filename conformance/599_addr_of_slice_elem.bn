package "main"

// Taking the address of a slice-indexed element must yield the element's
// address, so a store through it is visible in the slice. Regression for the
// address-of miscompile that lowered &s[i] to load+inttoptr of the element
// VALUE, producing a wild pointer (SIGSEGV on the write-through). Fixed arrays
// were unaffected; both @[]T and *[]T slices crashed, in both backends (the
// defect is in the shared IR address-of lowering).

func main() {
	var m @[]uint8 = make_slice(uint8, 3)
	m[0] = 10
	m[1] = 20
	m[2] = 30
	var pm *uint8 = &m[1]
	*pm = 99
	println(cast(int, m[1])) // 99

	var r *[]uint8 = make_slice(uint8, 3)
	r[0] = 1
	r[1] = 2
	r[2] = 3
	var pr *uint8 = &r[2]
	*pr = 88
	println(cast(int, r[2])) // 88
}
