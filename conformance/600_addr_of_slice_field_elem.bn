package "main"
import "pkg/builtins/testing"

// Taking the address of a SELECTOR-based slice element (&c.Items[i],
// where Items is a scalar-element slice FIELD) must yield the element's
// address, so a write-through is visible in the slice. Exercises the
// SELECTOR arm of genIndexPtr, distinct from the IDENT-based coverage in
// 599: both arms were gated on a struct element type, so a scalar-slice
// field's &c.Items[i] fell through to genUnary's r-value lowering — a
// wild pointer (SIGSEGV on the write-through).

type Box struct {
	Items @[]uint8
}

func main() {
	var c @Box = make(Box)
	c.Items = make_slice(uint8, 3)
	c.Items[0] = 5
	c.Items[1] = 6
	c.Items[2] = 7
	var p *uint8 = &c.Items[1]
	*p = 77
	testing.Println(cast(int, c.Items[1])) // 77
	testing.Println(cast(int, c.Items[0])) // 5 (unchanged)
}
