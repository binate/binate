package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// An interface-method dispatch whose result is a managed @func value, with
// the result discarded.  get_fn retains the returned closure for the caller
// (Axiom 3 RefInc on return); discarding the dispatch result must release
// that ref at end of statement.  Two fixes converge here: genInterfaceMethodCall
// must register the dispatch result as a cleanup temp (it previously registered
// NOTHING for any managed result kind), and the end-of-statement temp-cleanup
// loop must have an @func arm (it RefDec'd only @T/@[]T/@Iface/struct temps).
// Without either, the closure data slot's refcount stays elevated — a leak —
// which this balance test catches as `2` instead of the expected return to `2`.

type Maker struct {
	fn @func() int
}

func (m *Maker) get_fn() @func() int {
	return m.fn
}

interface FnMaker {
	get_fn() @func() int
}

impl *Maker : FnMaker

func main() {
	var n int = 5
	var src @func() int = func() int { return n }
	var src_hp *int = bit_cast(*int, &src)
	var src_po *uint8 = bit_cast(*uint8, src_hp[1])
	var maker @Maker = make(Maker)
	maker.fn = src                  // src + maker.fn share the closure record
	var fm @FnMaker = maker
	testing.Println(rt.Refcount(src_po))    // 2
	fm.get_fn()                     // dispatch result (a @func) discarded
	testing.Println(rt.Refcount(src_po))    // 2 — balanced (leak would read 3)
	testing.Println(src())                  // 5 — closure still live (no premature free)
}
