package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// `for _ in coll` over a managed-element collection must NOT bind the blank
// value as a managed scope var.  Binding it registers a phantom managed local
// whose scope-exit RefDec releases an element the (acquire-less) bind never
// acquired — an over-release of one ref per iteration.  loopBlank ranges and
// returns; src's refcount must be unchanged across the loop (a pre-fix run
// reads 1 here, having over-released twice from 3).

type Counter struct {
	N int
}

func loopBlank(s @[]@Counter) int {
	var total int = 0
	for _ in s {
		total = total + 1
	}
	return total
}

func main() {
	var src @Counter = make(Counter)
	src.N = 7
	var ps *uint8 = bit_cast(*uint8, src)
	var s @[]@Counter = make_slice(@Counter, 2)
	s[0] = src
	s[1] = src
	testing.Println(rt.Refcount(ps))   // src + s[0] + s[1] = 3
	testing.Println(loopBlank(s))      // 2 iterations
	testing.Println(rt.Refcount(ps))   // 3 — unchanged (blank bind acquires/releases nothing)
}
