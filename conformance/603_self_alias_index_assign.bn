package "main"

import "pkg/builtins/rt"

// Self-aliasing element assignment `a[i] = a[i]` of a managed @T must not
// use-after-free.  The element-store arms used to RefDec the old occupant
// BEFORE acquiring the new value; for a self-alias they are the SAME object,
// so at refcount 1 the RefDec frees it before the RefInc reads freed memory.
// Acquire-before-release nets to no change: the object survives (refcount
// stays 1, .N still readable) for array elements, raw-pointer elements, and
// managed-slice elements alike.

type Counter struct {
	N int
}

func main() {
	// Array element self-alias.
	var arr [1]@Counter
	arr[0] = make(Counter)
	arr[0].N = 7
	var ap *uint8 = bit_cast(*uint8, arr[0])
	arr[0] = arr[0]
	println(rt.Refcount(ap))    // 1 — unchanged
	println(arr[0].N)           // 7 — alive

	// Raw-pointer element self-alias.
	var parr [1]@Counter
	parr[0] = make(Counter)
	parr[0].N = 8
	var p *@Counter = &parr[0]
	var pp *uint8 = bit_cast(*uint8, parr[0])
	p[0] = p[0]
	println(rt.Refcount(pp))    // 1
	println(parr[0].N)          // 8

	// Managed-slice element self-alias.
	var s @[]@Counter = make_slice(@Counter, 1)
	s[0] = make(Counter)
	s[0].N = 9
	var sp *uint8 = bit_cast(*uint8, s[0])
	s[0] = s[0]
	println(rt.Refcount(sp))    // 1
	println(s[0].N)             // 9
}
