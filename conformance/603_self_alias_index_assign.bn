package "main"
import "pkg/builtins/testing"

// Self-aliasing element assignment `a[i] = a[i]` of a managed @T must not
// use-after-free.  The element-store arms used to RefDec the old occupant
// BEFORE acquiring the new value; for a self-alias they are the SAME object, so
// at refcount 1 the RefDec frees it before the RefInc reads/writes it.  A naive
// test reads the freed-but-pristine block and sees the right value; so after
// each self-alias this allocates a fresh same-size object that RECLAIMS the
// just-freed block — under the bug the element now aliases that fresh object
// and reads its value (91/92/93) instead of the original (7/8/9).  (The IR-level
// ordering is also pinned, allocator-independently: array/raw-pointer arms by
// TestEmitStoreManagedSlotAcquireBeforeRelease, the slice arm by
// TestSliceElemSelfAssignAcquiresBeforeReleases.)

type Counter struct {
	N int
}

func main() {
	// Array element self-alias.
	var arr [1]@Counter
	arr[0] = make(Counter)
	arr[0].N = 7
	arr[0] = arr[0]
	var sa @Counter = make(Counter)   // reclaims arr[0]'s block if it was freed
	sa.N = 91
	testing.Println(arr[0].N)                 // 7 (alive); 91 if freed+reused (the UAF)
	testing.Println(sa.N)                     // 91 — keep sa live across the read

	// Raw-pointer element self-alias.
	var parr [1]@Counter
	parr[0] = make(Counter)
	parr[0].N = 8
	var p *@Counter = &parr[0]
	p[0] = p[0]
	var sb @Counter = make(Counter)
	sb.N = 92
	testing.Println(parr[0].N)                // 8; 92 if freed+reused
	testing.Println(sb.N)                     // 92

	// Managed-slice element self-alias.
	var s @[]@Counter = make_slice(@Counter, 1)
	s[0] = make(Counter)
	s[0].N = 9
	s[0] = s[0]
	var sc @Counter = make(Counter)
	sc.N = 93
	testing.Println(s[0].N)                   // 9; 93 if freed+reused
	testing.Println(sc.N)                     // 93
}
