package "main"

import "pkg/builtins/rt"

// A captured @func value chained through MANY managed copy-sites in one
// statement-chain: param entry -> struct-field store -> by-value struct param
// -> return -> var-decl bind -> invoke, then all the chain's locals drop.
// Each hop now flows through emitStoreManagedSlot; this exercises their
// composition (the single-form matrix tests each site in isolation).  The
// closure's data refcount must return to baseline after the chain — an
// accumulated over/under-RefInc across the consolidated sites shows up as the
// final reading drifting from 1.

type Box struct {
	fn @func() int
}

func relay(bx Box) @func() int {
	return bx.fn
}

func chain(src @func() int) int {
	var bx Box
	bx.fn = src
	var got @func() int = relay(bx)
	return got()
}

func main() {
	var n int = 5
	var src @func() int = func() int { return n }
	var src_hp *int = bit_cast(*int, &src)
	var src_po *uint8 = bit_cast(*uint8, src_hp[1])
	println(rt.Refcount(src_po))    // 1 — src is the only persistent holder
	println(chain(src))             // 5 — the invoke result
	println(rt.Refcount(src_po))    // 1 — chain net-zeroed src (no leak / no over-free)
}
