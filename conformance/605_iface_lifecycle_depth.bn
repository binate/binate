package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A managed @Iface value chained through many copy-sites: cast-from-impl
// (boxing a *Counter) -> struct-field store -> by-value struct param ->
// return -> var-decl bind -> method dispatch, then the chain's locals drop.
// Exercises the composition of the consolidated emitStoreManagedSlot sites
// for @Iface, plus the MOVE-model param entry (an @Iface arg is borrowed, not
// entry-RefInc'd).  The wrapped Counter's refcount must return to baseline
// after the chain.

type Counter struct {
	N int
}

func (c *Counter) num() int { return c.N }

interface Numbered {
	num() int
}

impl *Counter : Numbered

type Box struct {
	it @Numbered
}

func relay(bx Box) @Numbered {
	return bx.it
}

func chain(src @Numbered) int {
	var bx Box
	bx.it = src
	var got @Numbered = relay(bx)
	return got.num()
}

func main() {
	var c @Counter = make(Counter)
	c.N = 5
	var co *uint8 = bit_cast(*uint8, c)
	var src @Numbered = c           // cast-from-impl; c and src both hold it
	testing.Println(rt.Refcount(co))        // 2
	testing.Println(chain(src))             // 5
	testing.Println(rt.Refcount(co))        // 2 — chain net-zeroed (no leak / no over-free)
}
