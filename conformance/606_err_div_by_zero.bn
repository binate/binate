package "main"

// A runtime (non-constant) zero divisor must trap with a defined panic,
// not silent UB / a hardware SIGFPE. The guard is OP_DIV_CHECK, emitted
// before OP_DIV (the divisor analogue of the bounds check). A *constant*
// 0 divisor is instead a compile-time error (see 427), so the divisor
// comes from a function the checker can't fold.

func zero() int { return 0 }

func main() {
	var b int = zero()
	println(10 / b)
}
