package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A single module containing BOTH @[]@I and @[]@func.  Before the dtorTypeSuffix
// iv/fv arms, both managed-slice dtors mangled to __dtor_ms_unknown, so
// ensureMsDtor's name-keyed dedup generated only ONE body — the other slice got
// the wrong element-walk (iface cleanup applied to @func elements or vice
// versa), reading the wrong slot / a bogus vtable: a crash or refcount
// corruption.  With distinct __dtor_ms_iv / __dtor_ms_fv, each element refcount
// returns to baseline when its slice is dropped.

type Counter struct {
	N int
}

func (c *Counter) num() int { return c.N }

interface Numbered {
	num() int
}

impl *Counter : Numbered

func dropIfaceSlice(it @Numbered) {
	var s @[]@Numbered = @[]@Numbered{it}
	_ = s
}

func dropFuncSlice(fn @func() int) {
	var s @[]@func() int = @[]@func() int{fn}
	_ = s
}

func main() {
	var c @Counter = make(Counter)
	c.N = 5
	var co *uint8 = bit_cast(*uint8, c)
	var it @Numbered = c
	testing.Println(rt.Refcount(co))        // 2 (c + it)
	dropIfaceSlice(it)
	testing.Println(rt.Refcount(co))        // 2 — iface-slice dtor walked iface elements

	var n int = 7
	var fn @func() int = func() int { return n }
	var fn_hp *int = bit_cast(*int, &fn)
	var fo *uint8 = bit_cast(*uint8, fn_hp[1])
	testing.Println(rt.Refcount(fo))        // 1
	dropFuncSlice(fn)
	testing.Println(rt.Refcount(fo))        // 1 — func-slice dtor walked func elements
}
