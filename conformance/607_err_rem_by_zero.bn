package "main"

// Remainder by a runtime zero divisor traps the same way as divide by
// zero (Go reports both as "integer divide by zero"). Same OP_DIV_CHECK
// guard, emitted before OP_REM; the divisor is non-constant so the
// const-fold path (427) doesn't intercept at compile time.

func zero() int { return 0 }

func main() {
	var b int = zero()
	println(10 % b)
}
