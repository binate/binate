package "main"
import "pkg/builtins/testing"

import "pkg/store"

// A struct field of type @[]@[]@store.Node — a cross-package nested
// managed-slice-of-managed-slice-of-managed-ptr.  Dropping the Holder runs its
// generated dtor (and copy, on any by-value copy): the outer walk cleans each
// @[]@store.Node element, which cleans each @store.Node.
//
// Before elemDtorName / elemCopyName, the outer walk named the inner
// @[]@store.Node element function by its QUALIFIED form
// (store.__dtor_ms_mp_store.Node) — because the innermost struct is
// cross-package — while ensureMsDtor defined that inner walk LOCALLY under the
// unqualified name (__dtor_ms_mp_store.Node).  The two never matched: the
// qualified reference was emitted by no package, so clang reported "use of
// undefined value" and the program failed to compile.  Now both the definition
// and the call use the local weak_odr name, so it compiles and the full nested
// dtor chain runs cleanly when `h` leaves scope.

type Holder struct {
	grid @[]@[]@store.Node
}

func build() int {
	var h Holder
	h.grid = make_slice(@[]@store.Node, 2)
	h.grid[0] = make_slice(@store.Node, 1)
	h.grid[0][0] = store.MakeNode(3)
	h.grid[1] = make_slice(@store.Node, 1)
	h.grid[1][0] = store.MakeNode(5)
	return store.NodeSize(h.grid[0][0]) + store.NodeSize(h.grid[1][0])
}

func main() {
	testing.Println(build())   // 3 + 5 = 8 (and h's nested dtor chain runs at scope exit)
}
