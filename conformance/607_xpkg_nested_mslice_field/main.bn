package "main"
import "pkg/builtins/testing"

import "pkg/store"

// A struct field of type @[]@[]@store.Node — a cross-package nested
// managed-slice-of-managed-slice-of-managed-ptr.  Dropping the Holder runs its
// generated dtor (and copy, on any by-value copy): the outer walk cleans each
// @[]@store.Node element, which cleans each @store.Node.
//
// The definition and the call of the inner @[]@store.Node element walk both
// use the local weak_odr name (elemDtorName / elemCopyName), so it compiles and
// the full nested dtor chain runs cleanly when `h` leaves scope.  An outer walk
// that names the inner function by its QUALIFIED form
// (store.__dtor_ms_mp_store.Node) — because the innermost struct is
// cross-package — while ensureMsDtor defines it LOCALLY under the unqualified
// name (__dtor_ms_mp_store.Node) references a symbol no package emits: clang
// reports "use of undefined value" and the program fails to compile.

type Holder struct {
	grid @[]@[]@store.Node
}

func build() int {
	var h Holder
	h.grid = make_slice(@[]@store.Node, 2)
	h.grid[0] = make_slice(@store.Node, 1)
	h.grid[0][0] = store.MakeNode(3)
	h.grid[1] = make_slice(@store.Node, 1)
	h.grid[1][0] = store.MakeNode(5)
	return store.NodeSize(h.grid[0][0]) + store.NodeSize(h.grid[1][0])
}

func main() {
	testing.Println(build())   // 3 + 5 = 8 (and h's nested dtor chain runs at scope exit)
}
