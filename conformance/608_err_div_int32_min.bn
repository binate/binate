package "main"

// The signed MIN / -1 overflow is the one signed integer-divide overflow
// that the divide-fault guard turns into a defined panic (the true
// quotient 2147483648 doesn't fit in int32). Operands come from
// functions so const-fold can't evaluate the overflow at compile time;
// int32 keeps the MIN literal portable across 32- and 64-bit targets and
// exercises the width-dependent signed minimum (-2^31).

func i32min() int32 { return cast(int32, -2147483648) }
func negOne() int32 { return cast(int32, -1) }

func main() {
	var a int32 = i32min()
	var b int32 = negOne()
	println(a / b)
}
