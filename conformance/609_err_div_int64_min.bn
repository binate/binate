package "main"

// The int64 MIN / -1 overflow at the widest signed width — the divide-
// fault guard recovers the 64-bit signed minimum (INT64_MIN) and panics
// rather than wrapping. int64 is 64-bit on every target (a register pair
// on 32-bit ones), and INT64_MIN written as `-9223372036854775807 - 1`
// stays a valid int64 literal everywhere. Operands come from functions
// so the overflow isn't folded at compile time.

func i64min() int64 { return cast(int64, -9223372036854775807) - cast(int64, 1) }
func negOne() int64 { return cast(int64, -1) }

func main() {
	var a int64 = i64min()
	var b int64 = negOne()
	println(a / b)
}
