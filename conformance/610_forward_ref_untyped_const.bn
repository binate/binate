package "main"

// A FORWARD reference to an UNTYPED single const (`const N = 5`, declared
// after main, no explicit type) must resolve AND read the right value
// end-to-end. collectDecls forward-registers an untyped single const with
// a placeholder type inferred from its initializer literal (mirroring the
// bare iota group members in 529); without it the reference to N before
// its declaration was "undefined".

func main() {
	println(N)
	println(N + 1)
}

const N = 5
