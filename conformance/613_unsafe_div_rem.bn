package "main"

// unsafe_div(a, b) / unsafe_rem(a, b) — the same integer divide /
// remainder as `/` / `%`, but skipping the divide-fault guard. With
// valid operands they are observably identical to the guarded forms
// (only `/` / `%` trap on a zero divisor or signed MIN/-1). Division
// truncates toward zero; remainder's sign follows the dividend.

func divIt(a int, b int) int { return unsafe_div(a, b) }
func remIt(a int, b int) int { return unsafe_rem(a, b) }

func main() {
	println(unsafe_div(17, 5))   // 3
	println(unsafe_rem(17, 5))   // 2
	println(divIt(-17, 5))       // -3 (truncated toward zero)
	println(remIt(-17, 5))       // -2 (sign follows the dividend)
	var a int = 100
	var b int = 7
	println(unsafe_div(a, b))    // 14
	println(unsafe_rem(a, b))    // 2
	var u uint32 = 4000000000
	println(unsafe_div(u, cast(uint32, 3)))  // 1333333333 (unsigned)
}
