package "main"

// Compound divide-assignment `a /= b` must hit the same divide-fault
// guard as `a = a / b` — a runtime zero divisor traps. (This pinned a
// gap where the compound-assign lowering emitted the divide without the
// OP_DIV_CHECK guard.) The divisor is non-constant so const-fold doesn't
// intercept.

func zero() int { return 0 }

func main() {
	var a int = 42
	var b int = zero()
	a /= b
	println(a)
}
