package "main"
import "pkg/builtins/testing"

// The ratified spec traps the signed MIN/-1 overflow on `%` as well as
// `/` (the hardware computes both quotient and remainder with one
// instruction, so `%` faults on the same overflow even though the
// mathematical remainder is 0). The OP_DIV_CHECK guard fires for OP_REM
// too. Operands come from functions so const-fold can't intercept.

func i32min() int32 { return cast(int32, -2147483648) }
func negOne() int32 { return cast(int32, -1) }

func main() {
	var a int32 = i32min()
	var b int32 = negOne()
	testing.Println(a % b)
}
