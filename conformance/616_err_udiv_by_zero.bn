package "main"

// An UNSIGNED zero divisor traps just like a signed one — the guard's
// divisor==0 check is width- and sign-independent (isSigned only gates
// the MIN/-1 overflow test, not the zero test). The divisor is
// non-constant so const-fold doesn't intercept at compile time.

func zero() uint32 { return cast(uint32, 0) }

func main() {
	var a uint32 = 100
	var b uint32 = zero()
	println(a / b)
}
