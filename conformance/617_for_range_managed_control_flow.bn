package "main"

import "pkg/builtins/rt"

// for-range copy-owns its loop value (RefInc on bind, RefDec at the END of
// each iteration).  This pins the per-iteration release across the control-flow
// exits the matrix forms don't cover — `continue`, `break` — and over an ARRAY
// collection (a distinct genForIn branch from the slice cells).  A bind that
// acquires per iteration but releases only once would leak on the multi-element
// and continue paths; a break that skips the release would leak the current
// iteration's value.  Every post-loop refcount must return to its pre-loop value.

type Counter struct {
	N int
}

func loopCont(s @[]@Counter) {
	for i, v in s {
		if i == 1 { continue }
		println(v.N)
	}
}

func loopBreak(s @[]@Counter) {
	for v in s {
		println(v.N)
		break
	}
}

func loopArr(a [3]@Counter) {
	for v in a {
		println(v.N)
	}
}

func main() {
	var src @Counter = make(Counter)
	src.N = 7
	var ps *uint8 = bit_cast(*uint8, src)
	var s @[]@Counter = make_slice(@Counter, 3)
	s[0] = src
	s[1] = src
	s[2] = src
	println(rt.Refcount(ps))   // 4 = src + s[0..2]
	loopCont(s)                // prints 7, 7 (skips i==1)
	println(rt.Refcount(ps))   // 4 — balanced through continue
	loopBreak(s)               // prints 7 then breaks
	println(rt.Refcount(ps))   // 4 — balanced through break

	var a [3]@Counter
	a[0] = src
	a[1] = src
	a[2] = src
	println(rt.Refcount(ps))   // 7 = src + s[0..2] + a[0..2]
	loopArr(a)                 // array-collection range; prints 7, 7, 7
	println(rt.Refcount(ps))   // 7 — balanced (array path; the by-value arg copy nets 0)
}
