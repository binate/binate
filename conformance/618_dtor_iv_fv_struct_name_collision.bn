package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A managed-slice element's dtor/copy is named by its element-type suffix.  An
// @Iface element and an @func element used to encode as the bare tokens `iv` /
// `fv` — but those are legal user struct names, which the struct arm emits
// verbatim.  So a struct literally named `iv` used as `@[]iv` collided with
// `@[]@Iface` on __dtor_ms_iv (and `fv` with `@[]@func`); the name-keyed dtor
// dedup emitted ONE body for the two structurally-different slices, applying the
// wrong element-walk to the other — a refcount leak (iv) or a SIGSEGV (fv,
// walking a 16-byte @func value as an 8-byte struct).  Encoding @Iface/@func as
// the reserved keywords `interface`/`func` (which can never be struct names)
// makes the collision impossible: this module has both `iv`/`fv` structs and
// @[]@Iface/@[]@func, and the Counter's refcount stays balanced with no crash.

type Counter struct {
	N int
}

func (c *Counter) num() int { return c.N }

interface Numbered {
	num() int
}

impl *Counter : Numbered

type iv struct {
	c @Counter
}

type fv struct {
	c @Counter
}

func dropIvSlice(seed @Counter) {
	var s @[]iv = make_slice(iv, 1)
	var e iv
	e.c = seed
	s[0] = e
	_ = s
}

func dropFvSlice(seed @Counter) {
	var s @[]fv = make_slice(fv, 1)
	var e fv
	e.c = seed
	s[0] = e
	_ = s
}

func dropIfaceSlice(it @Numbered) {
	var s @[]@Numbered = @[]@Numbered{it}
	_ = s
}

func dropFuncSlice(fn @func() int) {
	var s @[]@func() int = @[]@func() int{fn}
	_ = s
}

func main() {
	var c @Counter = make(Counter)
	c.N = 7
	var co *uint8 = bit_cast(*uint8, c)
	var it @Numbered = c
	var fn @func() int = func() int { return 9 }
	testing.Println(rt.Refcount(co))   // 2 = c + it
	dropIvSlice(c)             // @[]iv  (struct token "iv")
	dropFvSlice(c)             // @[]fv  (struct token "fv")
	dropIfaceSlice(it)         // @[]@Numbered (token "interface" — distinct)
	dropFuncSlice(fn)          // @[]@func     (token "func"      — distinct)
	testing.Println(rt.Refcount(co))   // 2 — balanced (no collision: no leak, no crash)
	testing.Println(c.N)               // 7 — c still alive
}
