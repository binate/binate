package "main"
import "pkg/builtins/testing"

import "pkg/store"

// A by-value copy of a top-level fixed array whose elements are a cross-package
// managed pointer: `var b [N]@pkg.T = a`.  The copy RefIncs each element via
// emitStructCopy, which names the array's copy function.  emitStructCopy used
// qualifiedCopyNameForType, which QUALIFIES a cross-package array to
// `pkg.__copy_arrN_...` — but ensureArrayCopy emits that body LOCALLY (weak_odr),
// unqualified, so the qualified call referenced a never-defined symbol (clang
// "use of undefined value", a compile failure).  Routing emitStructCopy through
// elemCopyName makes a top-level array use its local name (a struct stays
// package-qualified), so this compiles and both arrays own their elements.

func main() {
	var a [2]@store.Node
	a[0] = store.MakeNode(3)
	a[1] = store.MakeNode(5)
	var b [2]@store.Node = a   // top-level array-by-value copy of cross-pkg elems
	testing.Println(store.NodeSize(a[0]) + store.NodeSize(b[1]))   // 3 + 5 = 8
}
