package "main"

// Float comparisons follow IEEE 754 / Go: `==` and the four relationals
// are ORDERED (false when an operand is NaN), but `!=` is UNORDERED
// (true vs NaN) so it stays the exact complement of `==`. NaN is built
// at runtime (z/z with a variable) so the compiler can't fold the
// compares. Pins the float-`!=` semantics across every backend.

func boolToInt(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var z float64 = 0.0
	var nan float64 = z / z   // runtime NaN (float / is IEEE, no guard)
	var one float64 = 1.0
	println(boolToInt(nan == nan))                    // 0 (ordered)
	println(boolToInt(nan != nan))                    // 1 (unordered)
	println(boolToInt((nan != nan) == !(nan == nan))) // 1 (complementary)
	println(boolToInt(nan < one))                     // 0
	println(boolToInt(nan <= one))                    // 0
	println(boolToInt(nan > one))                     // 0
	println(boolToInt(nan >= one))                    // 0
	println(boolToInt(one != 2.0))                    // 1 (non-NaN sanity)
	println(boolToInt(one != one))                    // 0
}
