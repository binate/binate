package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A managed slice whose element is an ARRAY of destructible elements:
// @[]([N]@T).  genManagedSliceDtor walks the array elements by their LOCAL
// dtor name (__dtor_arrN_...), but ensureMsDtor only recursed into managed-slice
// elements — never ARRAY elements — so for `@[]([N]@T)` that local array dtor
// was never emitted: clang "use of undefined value", a compile failure.
// ensureMsDtor now mirrors ensureArrayDtor's array-element recursion, so this
// compiles and the slice's nested dtor chain runs cleanly.

type Counter struct {
	N int
}

func dropMsOfArr(seed @Counter) {
	var s @[][2]@Counter = make_slice([2]@Counter, 1)
	var arr [2]@Counter
	arr[0] = seed
	arr[1] = seed
	s[0] = arr
	_ = s
}

func main() {
	var c @Counter = make(Counter)
	c.N = 7
	var co *uint8 = bit_cast(*uint8, c)
	testing.Println(rt.Refcount(co))   // 1
	dropMsOfArr(c)             // builds @[]([2]@Counter), drops it
	testing.Println(rt.Refcount(co))   // 1 — balanced (a compile failure pre-fix)
	testing.Println(c.N)               // 7 — c still alive
}
