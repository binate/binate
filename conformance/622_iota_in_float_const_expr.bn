package "main"
import "pkg/builtins/testing"

// iota inside a float const expression: each implicitly repeated member
// re-evaluates `1.5 * cast(float64, iota)` with its own iota value (without
// the iota binding it would fold to 0). Expected F2 = 1.5 * 2 = 3.

const (
	F0 float64 = 1.5 * cast(float64, iota)
	F1
	F2
)

func main() {
	testing.Println(cast(int, F2))
}
