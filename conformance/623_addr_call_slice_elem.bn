package "main"
import "pkg/builtins/testing"

// `&<call-result>[i]`: taking the address of an element of a slice
// returned by a call.  genIndexPtr evaluates the r-value base (the slice
// value carries its backing pointer) and GEPs into the backing; `g` keeps
// that backing live across the statement.  Expected 2.

var g @[]uint8

func get() @[]uint8 { return g }

func main() {
	g = make_slice(uint8, 3)
	g[1] = 2
	var p *uint8 = &get()[1]
	testing.Println(cast(int, *p))
}
