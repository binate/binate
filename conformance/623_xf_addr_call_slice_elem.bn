package "main"

// XFAIL (claude-todo M7, adversarial review 2026-06-06): &<call-result>[i]
// (and &a[i][j]) produce a wild pointer — genIndexPtr only handles IDENT /
// SELECTOR bases; other bases return nil and genUnary falls through to the
// r-value lowering, handing the loaded element back as a pointer (SIGSEGV).
// Expected 2.

var g @[]uint8

func get() @[]uint8 { return g }

func main() {
	g = make_slice(uint8, 3)
	g[1] = 2
	var p *uint8 = &get()[1]
	println(cast(int, *p))
}
