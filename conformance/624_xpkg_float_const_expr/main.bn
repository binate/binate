package "main"
import "pkg/builtins/testing"

// A cross-package float const-EXPRESSION (`cfg.SUM = 1.5 + 2.5`) reads as
// its float value through a qualified reference, as the in-package
// equivalent does (not as int 0). Expected cast(int, 1.5 + 2.5) = 4.

import "pkg/cfg"

func main() {
	testing.Println(cast(int, cfg.SUM))
}
