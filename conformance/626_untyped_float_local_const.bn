package "main"
import "pkg/builtins/testing"

// An UNTYPED local const with a float initializer stays a float constant
// in IR-gen (not an int lowered through sitofp), so assigning it to a
// float32 (which the checker accepts: an untyped const stays assignable
// to float32) yields float32(0.5). Expected: float32(0.5) bit pattern
// = 0x3F000000 -> low lane 0, high lane 16128.

func main() {
	const C = 0.5
	var y float32 = C
	testing.Println(cast(int, bit_cast(uint32, y) & 0xFFFF))
	testing.Println(cast(int, (bit_cast(uint32, y) >> 16) & 0xFFFF))
}
