package "main"
import "pkg/builtins/testing"

// XFAIL (claude-todo C2, adversarial review 2026-06-06): an UNTYPED local
// const with a float initializer is mistyped as int by genDecl (no-TypeRef
// inference defaults to TypInt, only special-casing strings), so it lowers
// through sitofp and reads back garbage. The checker accepts it (untyped
// const stays assignable to float32). Expected: float32(0.5) bit pattern
// = 0x3F000000 -> low lane 0, high lane 16128.

func main() {
	const C = 0.5
	var y float32 = C
	testing.Println(cast(int, bit_cast(uint32, y) & 0xFFFF))
	testing.Println(cast(int, (bit_cast(uint32, y) >> 16) & 0xFFFF))
}
