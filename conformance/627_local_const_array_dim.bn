package "main"
import "pkg/builtins/testing"

// A LOCAL const used as an array dimension sizes the array in IR-gen as
// well as in the checker (IR-gen resolves the local const, not just
// module-level ones). Expected len 3.

func main() {
	const N int = 3
	var a [N]int
	testing.Println(cast(int, len(a)))
}
