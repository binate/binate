package "main"
import "pkg/builtins/testing"

// Regression for C4 (binate f4769aac): `&s[i]` on a readonly-wrapped slice
// (`readonly @[]uint8`) must GEP with the uint8 ELEMENT stride, not the
// inner-slice stride — genIndexPtr peels TYP_READONLY (peelReadonly) before
// EmitSliceElemPtr.  `&s[1]` of "AB" reads 'B' (66).

func main() {
	var s readonly @[]uint8 = "AB"
	var p *uint8 = &s[1]
	testing.Println(cast(int, *p))
}
