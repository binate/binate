package "main"
import "pkg/builtins/testing"

// An untyped-float literal stored into a float32 ARRAY-LITERAL element is
// narrowed to float32, as it is for a call arg / field / return, so the
// element store is 4 bytes into the 4-byte slot (not an 8-byte double).
// Expected each element = float32(0.5) high lane 16128.

func main() {
	var a [2]float32 = [2]float32{0.5, 0.5}
	testing.Println(cast(int, (bit_cast(uint32, a[0]) >> 16) & 0xFFFF))
	testing.Println(cast(int, (bit_cast(uint32, a[1]) >> 16) & 0xFFFF))
}
