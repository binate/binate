package "main"

// XFAIL (claude-todo M2, adversarial review 2026-06-06): an untyped-float
// literal stored into a float32 ARRAY-LITERAL element is not narrowed
// (coerceScalarWidth was wired into call-arg/field/return but not the
// composite-literal element loops), so codegen emits an 8-byte store
// through a 4-byte slot. Expected each element = float32(0.5) high lane
// 16128.

func main() {
	var a [2]float32 = [2]float32{0.5, 0.5}
	println(cast(int, (bit_cast(uint32, a[0]) >> 16) & 0xFFFF))
	println(cast(int, (bit_cast(uint32, a[1]) >> 16) & 0xFFFF))
}
