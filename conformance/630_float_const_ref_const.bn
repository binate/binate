package "main"
import "pkg/builtins/testing"

// A float const whose initializer references only other float consts, with
// no float literal (A + B), is folded as a float const (not as an integer
// const expression, which would give 0). Expected 4 (1.5 + 2.5).

const A float64 = 1.5
const B float64 = 2.5
const C float64 = A + B

func main() {
	testing.Println(cast(int, C))
}
