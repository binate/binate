package "main"
import "pkg/builtins/testing"

// XFAIL (claude-todo M4, adversarial review 2026-06-06): a float const whose
// initializer references only other float consts with no float literal
// (A + B) is misclassified as int 0 — isFloatExpr is literal-only, so it
// falls to the integer evalConstExpr (lookupConst returns Val=0 for a
// CONST_FLT). Expected 4 (1.5 + 2.5).

const A float64 = 1.5
const B float64 = 2.5
const C float64 = A + B

func main() {
	testing.Println(cast(int, C))
}
