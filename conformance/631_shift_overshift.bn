package "main"
import "pkg/builtins/testing"

// A shift by a count >= the operand bit width is defined (claude-notes /
// Go): 0 for a logical `<<` or `>>`, sign-fill for an arithmetic `>>` —
// NOT the hardware-masked (count mod width) result. Counts are passed as
// runtime args so they aren't const-folded; the shift sees them as
// variables.

func shrU(x uint64, n uint64) uint64 { return x >> n }
func shlU(x uint64, n uint64) uint64 { return x << n }
func sarI(x int64, n int64) int64 { return x >> n }

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var full uint64 = 0xFFFFFFFFFFFFFFFF
	var zero64 uint64 = 0
	var one uint64 = 1
	// logical >> overshift → 0 (not full or full>>6)
	testing.Println(bi(shrU(full, cast(uint64, 64)) == zero64))                   // 1
	testing.Println(bi(shrU(full, cast(uint64, 70)) == zero64))                   // 1
	// << overshift → 0
	testing.Println(bi(shlU(one, cast(uint64, 64)) == zero64))                    // 1
	testing.Println(bi(shlU(one, cast(uint64, 200)) == zero64))                   // 1
	// in-range still correct
	testing.Println(bi(shrU(full, cast(uint64, 4)) == cast(uint64, 0x0FFFFFFFFFFFFFFF))) // 1
	testing.Println(bi(shlU(one, cast(uint64, 4)) == cast(uint64, 16)))           // 1
	// boundary: >> 63 keeps just the top bit
	testing.Println(bi(shrU(full, cast(uint64, 63)) == one))                      // 1
	// arithmetic >> overshift: negative sign-fills to -1, non-negative → 0
	var neg int64 = cast(int64, 0) - cast(int64, 1)
	testing.Println(bi(sarI(neg, cast(int64, 64)) == neg))                        // 1
	testing.Println(bi(sarI(cast(int64, 0) - cast(int64, 1000), cast(int64, 100)) == neg)) // 1
	testing.Println(bi(sarI(cast(int64, 5), cast(int64, 64)) == cast(int64, 0)))  // 1
	// arithmetic in-range still correct
	testing.Println(bi(sarI(cast(int64, 0) - cast(int64, 8), cast(int64, 1)) == (cast(int64, 0) - cast(int64, 4)))) // 1
}
