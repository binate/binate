package "main"
import "pkg/builtins/testing"

// Disambiguation probe + regression guard for the native float-return
// defect (plan-cr-p2 defect 4.3).  Test 541 conflates two independent
// paths in its cfg.Scale() line — an in-package float-const IDENT read
// AND a float scalar return — so a 0 there cannot say which is broken.
// This probe exercises each path in isolation, and additionally pins
// BOTH sides of the float-return ABI:
//
//   line 1  fr.RetLit()        float-return ABI, LLVM callee → native
//                              caller (returns a LITERAL — no const read)
//   line 2  fr.RetParam(3.5)   float param-in + float return-out across
//                              the same boundary (no const read)
//   line 3  fr.ReadConstAsInt  in-package float-const IDENT read returned
//                              as an INT over the working int-return ABI
//                              (control: isolates the read from the
//                              float-return ABI)
//   line 4  fr.RetConstIdent   the combined path 541's Scale() walks
//                              (in-package IDENT read THEN float return)
//   line 5  localRet()         a SAME-MODULE float return (native callee
//                              → native caller): guards against a
//                              one-sided fix — both sides must agree on
//                              the float-return register (D0), so this
//                              breaks if only one side is corrected
//   line 6  fp()               an INDIRECT (function-value) float return:
//                              the indirect-call result collection shares
//                              the same float-return register convention
//
// pkg/fr is a dependency, so it is compiled via LLVM (AAPCS64: floats
// return in D0); main is the native-compiled module.  Lines 1/2/4 thus
// cross the native↔LLVM boundary, line 5 stays native↔native.  A 0 on
// line 1/2/4 names the float-return ABI; a 0 on line 3 would name the
// in-package float-const IDENT read.  cast-to-int keeps the output
// byte-identical across LLVM and the VM (float text formatting differs).

import "pkg/fr"

func localRet() float64 {
	return 1.5
}

func main() {
	testing.Println(cast(int, fr.RetLit() * 2.0))
	testing.Println(cast(int, fr.RetParam(3.5) * 2.0))
	testing.Println(fr.ReadConstAsInt())
	testing.Println(cast(int, fr.RetConstIdent() * 2.0))
	testing.Println(cast(int, localRet() * 2.0))
	var fp *func() float64 = localRet
	testing.Println(cast(int, fp() * 2.0))
}
