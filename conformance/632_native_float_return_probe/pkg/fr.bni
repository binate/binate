package "pkg/fr"

// K is read in-package by ReadConstAsInt / RetConstIdent (EXPR_IDENT),
// separately from main's cross-package EXPR_SELECTOR reads.
const K float64 = 3.5

// RetLit returns a float LITERAL — exercises ONLY the float scalar
// return ABI, with no const read in the body.
func RetLit() float64

// RetParam echoes its float argument — float param-in + float
// return-out, isolating the return side from any const read.
func RetParam(x float64) float64

// ReadConstAsInt reads K via in-package EXPR_IDENT and returns it as an
// INT over the (working) int-return ABI — isolates the in-package
// float-const IDENT read from the float-return ABI.
func ReadConstAsInt() int

// RetConstIdent reads K via in-package EXPR_IDENT THEN returns it as a
// float — the combined path 541's Scale() walks.
func RetConstIdent() float64
