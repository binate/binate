package "main"

// Regression guard for the native float-return ABI fix (plan-cr-p2 4.3): a
// float scalar returned through an INTERFACE method call must arrive in the
// ABI float-return register (D0 on aa64 / XMM0 on x64), not a GP register.
// The native vtable-dispatch caller collects the result through the shared
// collectScalarReturn path — 632_native_float_return_probe covers the direct
// and indirect/function-value call paths, and this pins the interface-dispatch
// path.  cast-to-int keeps the output byte-identical across LLVM and the VM
// (float text formatting differs).

interface Scaler {
	scale() float64
}

type Box struct {
	v float64
}

func (b *Box) scale() float64 {
	return b.v
}

impl *Box : Scaler

func main() {
	var b Box
	b.v = 3.5
	var s *Scaler = &b
	println(cast(int, s.scale() * 2.0))
}
