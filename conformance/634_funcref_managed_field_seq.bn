package "main"

// Assigning function REFERENCES to managed @func fields in sequence must
// not corrupt the basic-block CFG during IR-gen.  An @func field has a
// managed destructor, so an assignment to it emits an old-value RefDec
// whose null-guard SPLITS the current block.  genExprOrFuncRef's
// function-reference path must sync ctx.CurBlock to the block it emitted
// into; otherwise the NEXT func-ref assignment reads a stale ctx.CurBlock
// (the already-terminated block the prior split left behind) and emits
// into it — two terminators in one block plus an orphaned continuation,
// i.e. malformed IR that traps at runtime (compiled: SIGTRAP; interpreted:
// `func_value_dtor on nil fv address`).  A variable/param RHS routes
// through genExpr (which syncs), so only function references in sequence
// trip it; spelling the fields raw *func also dodges it (no managed dtor,
// no split).  Modeled on minbasic's basicSession: an inline @func-bearing
// struct field followed by a sibling @func.

type IO struct {
	W @func(*[]readonly char) int
	E @func(*[]readonly char) int
}

type Session struct {
	a    @[]char
	io   IO
	b    int
	poll @func() int
}

func sinkW(s *[]readonly char) int { return 1 }
func sinkE(s *[]readonly char) int { return 2 }
func pollFn() int                  { return 7 }

// Two consecutive function-reference assignments into @func fields — the
// minimal trigger.  The io.W assignment splits the block; io.E must emit
// into the live continuation.
func newIO() IO {
	var io IO
	io.W = sinkW
	io.E = sinkE
	return io
}

// The basicSession shape: an inline IO field (itself two @func) plus a
// trailing @func `poll` assigned from a function reference.
func newSession() @Session {
	var s @Session = make(Session)
	s.a = make_slice(char, 0)
	s.io = newIO()
	s.b = 42
	s.poll = pollFn
	return s
}

func main() {
	var io IO = newIO()
	println(io.W("a"))
	println(io.E("b"))

	var s @Session = newSession()
	println(s.io.W("c"))
	println(s.io.E("d"))
	println(s.poll())
	println(s.b)
}
