package "main"
import "pkg/builtins/testing"

// float32 arithmetic must compute at single precision (as LLVM and Go do),
// not in double on the raw f32 bit pattern.  Covers all four binary ops, the
// unary negate (a sign-bit flip — a double FNEG would flip the wrong bit),
// and a bit-exact division check (1.0f/3.0f = 0x3EAAAAAB) that pins
// single-precision rounding.  cast-to-int keeps the value lines backend-stable.
func main() {
	var a float32 = 1.5
	var b float32 = 5.5
	var c float32 = 2.5
	var d float32 = 7.0
	testing.Println(cast(int, a + a))   // 3.0  -> 3
	testing.Println(cast(int, b - a))   // 4.0  -> 4
	testing.Println(cast(int, c * a))   // 3.75 -> 3
	testing.Println(cast(int, d / a))   // 4.666... -> 4
	testing.Println(cast(int, -a))      // -1.5 -> -1
	var one float32 = 1.0
	var three float32 = 3.0
	testing.Println(cast(int, bit_cast(uint32, one / three)))   // 0x3EAAAAAB
}
