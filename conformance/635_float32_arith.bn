package "main"

// float32 arithmetic must compute in single precision (as LLVM and Go do):
// 1.5f + 1.5f = 3.0f, and 2.5f * 1.5f = 3.75f.  cast-to-int keeps the output
// backend-stable.
func main() {
	var a float32 = 1.5
	var b float32 = a + a
	println(cast(int, b))
	var c float32 = 2.5
	var d float32 = c * a
	println(cast(int, d))
}
