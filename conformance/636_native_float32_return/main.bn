package "main"

// float32 return-ABI coverage — companion to 632 (which covers float64).
// A float32 scalar returned through a call must deliver its exact 32-bit
// pattern.  This checks the RETURN ABI in isolation via bit_cast (NOT
// arithmetic): native float32 *arithmetic* is separately broken (emitFloatBinop
// runs double-precision ops on float32 operands — tracked elsewhere), so an
// arithmetic-based check would conflate the two.  1.5f32 = 0x3FC00000 =
// 1069547520.  pkg/f32 is a dependency (LLVM-compiled in the native modes),
// so line 2 crosses the native↔LLVM boundary and line 1 stays native↔native.

import "pkg/f32"

func localF32() float32 {
	return 1.5
}

func main() {
	println(cast(int, bit_cast(uint32, localF32())))
	println(cast(int, bit_cast(uint32, f32.RetF32())))
}
