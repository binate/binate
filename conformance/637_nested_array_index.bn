package "main"
import "pkg/builtins/testing"

// Nested ARRAY indexing `a[i][j]` for plain read and write.  The inner
// index yields an array stored in place (no backing pointer), so it is
// addressed through an in-place element pointer rather than the
// slice-value fallback (which would emit invalid IR / drop the store).
// Exercises 2-D, 3-D, and a managed (refcounted) element type.
// Expected:
//   12   2-D read+write (a[1][2]=7, a[0][0]=5)
//   8    3-D (b[1][0][1]=8)
//   7    managed element (c[1][1]=make_slice; c[1][1][2]=7)

func main() {
	var a [2][3]int
	a[1][2] = 7
	a[0][0] = 5
	testing.Println(a[1][2] + a[0][0])

	var b [2][2][2]int
	b[1][0][1] = 8
	testing.Println(b[1][0][1])

	var c [2][2]@[]int
	c[1][1] = make_slice(int, 3)
	c[1][1][2] = 7
	testing.Println(c[1][1][2])
}
