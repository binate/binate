package "main"
import "pkg/builtins/testing"

// `&a[i][j]` for a nested ARRAY base and a slice-of-slices base: the
// address must point at the real element storage, so a write through it
// mutates the original.  Expected:
//   9    2-D array (&a[1][2], *p = 9)
//   9    slice-of-slices (&s[1][2], *q = 9)

func main() {
	var a [2][3]int
	var p *int = &a[1][2]
	*p = 9
	testing.Println(a[1][2])

	var s @[]@[]int = make_slice(@[]int, 2)
	s[1] = make_slice(int, 3)
	var q *int = &s[1][2]
	*q = 9
	testing.Println(s[1][2])
}
