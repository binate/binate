package "main"
import "pkg/builtins/testing"

// float32 comparisons must compute at single precision, not in double on the
// raw f32 bit pattern.  A NEGATIVE float32 exposes the bug: its sign bit sits
// at bit 31 of the value, so reinterpreting the low-4-byte pattern as a double
// makes it a LARGE POSITIVE double (bit 31 isn't the double's sign), flipping
// the order against a positive operand.  So neg < pos, which a double-on-the-
// bits compare gets backwards.

func b2i(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var neg float32 = -1.5
	var pos float32 = 2.5
	testing.Println(b2i(neg < pos))    // 1  (double-on-bits: 0)
	testing.Println(b2i(pos < neg))    // 0  (double-on-bits: 1)
	testing.Println(b2i(neg == neg))   // 1
	testing.Println(b2i(neg != pos))   // 1
	testing.Println(b2i(neg <= pos))   // 1  (double-on-bits: 0)
	testing.Println(b2i(pos >= neg))   // 1  (double-on-bits: 0)
	// NaN (built at runtime so it isn't folded): != is UNORDERED (true),
	// == and the relationals are ORDERED (false) — same IEEE/Go semantics
	// as float64, which the shared single-precision compare must preserve.
	var z float32 = 0.0
	var nan float32 = z / z
	testing.Println(b2i(nan != nan))   // 1
	testing.Println(b2i(nan == nan))   // 0
	testing.Println(b2i(nan < pos))    // 0
}
