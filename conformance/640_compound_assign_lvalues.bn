package "main"

// Compound assignment (`+=`, `-=`, `*=`, `/=`, …) must apply the operator
// to the CURRENT value of the lvalue, for every lvalue form — not just a
// plain variable.  Previously only the IDENT arm did so; array/slice
// elements, struct fields, deref, and nested-array targets silently
// stored the bare RHS.  Expected:
//   15   plain variable        v += 5
//   13   array element         a[1] += 5 then -= 2
//   60   slice element         s[1] *= 3
//   15   nested array element  m[1][2] += 5
//   25   struct field          p.x /= 4
//   15   deref                 *q += 7

type P struct { x int }

func main() {
	var v int = 10
	v += 5
	println(v)

	var a [3]int
	a[1] = 10
	a[1] += 5
	a[1] -= 2
	println(a[1])

	var s @[]int = make_slice(int, 3)
	s[1] = 20
	s[1] *= 3
	println(s[1])

	var m [2][3]int
	m[1][2] = 10
	m[1][2] += 5
	println(m[1][2])

	var p P
	p.x = 100
	p.x /= 4
	println(p.x)

	var w int = 8
	var q *int = &w
	*q += 7
	println(w)
}
