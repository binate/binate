package "main"

// A multi-assign from a multi-return call where an earlier target is a
// managed @func IDENT and a later target is a SELECTOR must not drop the
// selector store.  Assigning the @func target emits its old-value RefDec,
// whose null-guard SPLITS the block and rebinds only the local `b` — not
// ctx.CurBlock.  genMultiAssign must re-sync ctx.CurBlock per target;
// otherwise the SELECTOR arm's `b = ctx.CurBlock` (read after
// genSelectorPtr, which — unlike genExpr — does not sync it) reverts to
// the already-terminated pre-split block, so the field store emits into a
// dead block and is silently dropped (the value keeps its old contents).
// Same ctx.CurBlock-desync class as the genExprOrFuncRef fix.

type Holder struct {
	n int
}

func fa() int { return 11 }
func fb() int { return 22 }

// Returns a @func then an int — feeding an @func IDENT target and an int
// SELECTOR target respectively.
func twoFI() (@func() int, int) {
	return fa, 5
}

func main() {
	var f @func() int = fb // non-nil so the old-value RefDec actually runs
	var h Holder
	h.n = 99
	f, h.n = twoFI() // f <- fa (IDENT, splits); h.n <- 5 (SELECTOR, dropped under the bug)
	println(f())     // 11 (f is now fa)
	println(h.n)     // 5  (99 if the selector store was dropped)
}
