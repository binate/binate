package "main"
import "pkg/builtins/testing"

// Bool-logic (&&, ||, !) constant folding for top-level consts.  The
// comparison-only cases (`<`, `>`) are covered elsewhere; this exercises
// the logical operators (evalConstBool's NOT / LAND / LOR arms), their
// composition with comparisons, and a logical expression that REFERENCES
// another boolean const (`!A`, `A || ...`).  Expected:
//   false   A = true && false
//   true    B = true || false
//   false   C = !true
//   true    D = (1 < 2) && !(3 < 2)
//   true    E = (5 > 2) || (1 > 9)
//   true    F = !A           (A is a const → false → !false)
//   false   G = A && B       (false && true)

const A bool = true && false
const B bool = true || false
const C bool = !true
const D bool = (1 < 2) && !(3 < 2)
const E bool = (5 > 2) || (1 > 9)
const F bool = !A
const G bool = A && B

func main() {
	testing.Println(A)
	testing.Println(B)
	testing.Println(C)
	testing.Println(D)
	testing.Println(E)
	testing.Println(F)
	testing.Println(G)
}
