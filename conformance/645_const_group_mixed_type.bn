package "main"
import "pkg/builtins/testing"

// In a mixed-type const group a bare member inherits the PRECEDING
// member's type (and repeats its initializer expression with its own
// iota), not the first member's type.  D must be uint16 so 4096 fits
// (a uint8 would truncate it to 0).

const (
	A uint8 = 1
	B
	C uint16 = 1 << 12
	D
	E int = iota
	F
)

func main() {
	testing.Println(cast(int, A))
	testing.Println(cast(int, B))
	testing.Println(cast(int, C))
	testing.Println(cast(int, D))
	testing.Println(cast(int, E))
	testing.Println(cast(int, F))
}
