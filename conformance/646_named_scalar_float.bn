package "main"

// Named distinct FLOAT types (`type Temp float32`, `type Dist float64`)
// must lower with their underlying float layout and float instruction
// selection.  Before they resolved to TYP_NAMED in IR-gen they fell back
// to `int`, so `var t Temp = 1.5; cast(int, t)` bit-reinterpreted the
// double instead of fptosi'ing it (printed a huge bit pattern, not 1).
// cast-to-int keeps the value lines backend-stable (see 635).

type Temp float32
type Dist float64

func main() {
	var a Temp = 1.5
	var b Temp = 5.5
	var c Temp = 2.5
	var d Temp = 7.0
	println(cast(int, a))        // 1.5  -> 1 (precision-loss cast)
	println(cast(int, a + a))    // 3.0  -> 3
	println(cast(int, b - a))    // 4.0  -> 4
	println(cast(int, c * a))    // 3.75 -> 3
	println(cast(int, d / a))    // 4.66 -> 4
	println(cast(int, -a))       // -1.5 -> -1

	var x Dist = 2.75
	var y Dist = 1.25
	println(cast(int, x))        // 2.75 -> 2
	println(cast(int, x + y))    // 4.0  -> 4
	println(cast(int, x - y))    // 1.5  -> 1

	// Comparison at float precision yields bool.
	println(a < b)               // true
	println(b > a)               // true
	println(a == a)              // true
}
