package "main"

// Named distinct FLOAT types (`type Temp float32`, `type Dist float64`)
// must lower with their underlying float layout and float instruction
// selection.  Before they resolved to TYP_NAMED in IR-gen they fell back
// to `int`, so `var t Temp = 1.5; cast(int, t)` bit-reinterpreted the
// double instead of fptosi'ing it (printed a huge bit pattern, not 1).
// cast-to-int keeps the value lines backend-stable (see 635).

type Temp float32
type Dist float64

func main() {
	var a Temp = 1.5
	var b Temp = 5.5
	var c Temp = 2.5
	var d Temp = 7.0
	println(cast(int, a))        // 1.5  -> 1 (precision-loss cast)
	println(cast(int, a + a))    // 3.0  -> 3
	println(cast(int, b - a))    // 4.0  -> 4
	println(cast(int, c * a))    // 3.75 -> 3
	println(cast(int, d / a))    // 4.66 -> 4
	println(cast(int, -a))       // -1.5 -> -1

	var x Dist = 2.75
	var y Dist = 1.25
	println(cast(int, x))        // 2.75 -> 2
	println(cast(int, x + y))    // 4.0  -> 4
	println(cast(int, x - y))    // 1.5  -> 1

	// Comparison at float precision yields bool.
	println(a < b)               // true
	println(b > a)               // true
	println(a == a)              // true

	// Conversions INTO and OUT OF a named float32 must peel the named
	// type (vmUnwrapNamed) before selecting the float32 conversion op.
	// int -> named-float32 must pick the fused BC_SITOF32 (a float64
	// BC_SITOF would read back as ~0); named-float32 -> unsigned must
	// pick BC_F32TOUI (the signed BC_F32TOSI would saturate 2^63).
	var t2 Temp = cast(Temp, 5)
	println(cast(int, t2))                     // 5 (int -> named-float32)
	var u uint64 = 9223372036854775808
	var t3 Temp = cast(Temp, u)
	println(cast(int, cast(uint64, t3) == u))  // 1 (named-float32 2^63 round-trip)
}
