package "main"
import "pkg/builtins/testing"

// Method dispatch on named distinct scalar types.  The call must resolve
// to the user method keyed on the source type name (Celsius / Scale),
// not the universe primitive of the underlying kind: before the fix the
// receiver value's type collapsed to `int`/`float64`, so the lookup
// searched pkg/builtins/lang for `int.Doubled` and failed to link.
// Covers value- and pointer-receiver methods on a named-int and a
// named-float type.

type Celsius int
type Scale float64

func (c Celsius) Doubled() int {
	return cast(int, c) * 2
}

func (c *Celsius) Bump() {
	*c = *c + 1
}

func (s Scale) Halved() int {
	return cast(int, s / 2.0)
}

func main() {
	var t Celsius = 21
	testing.Println(t.Doubled())     // 42

	var u Celsius = 10
	u.Bump()
	u.Bump()
	testing.Println(cast(int, u))    // 12

	var s Scale = 9.0
	testing.Println(s.Halved())      // 4.5 -> 4
}
