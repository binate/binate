package "main"

// Named distinct scalars as aggregate members: a struct field, an array
// element, and a managed-slice element (read AND write each).  Layout
// (SizeOf / AlignOf / element llvmType) and the managed-slice dtor name
// must peel TYP_NAMED — otherwise a named-float field mis-sizes the
// struct and `@[]Meters` collides on the `ms_unknown` dtor suffix.

type Meters int
type Ratio float64

type Box struct {
	w Meters
	r Ratio
}

func main() {
	// struct field read/write (mixed named-int + named-float fields)
	var b Box
	b.w = 5
	b.r = 1.5
	println(cast(int, b.w))           // 5
	println(cast(int, b.r * 4.0))     // 6.0 -> 6
	b.w = b.w + 3
	println(cast(int, b.w))           // 8

	// array element read/write
	var arr [3]Meters
	arr[0] = 10
	arr[1] = 20
	arr[2] = arr[0] + arr[1]
	println(cast(int, arr[2]))        // 30

	// managed-slice element read/write
	var ms @[]Meters = make_slice(Meters, 2)
	ms[0] = 7
	ms[1] = ms[0] * 2
	println(cast(int, ms[1]))         // 14
}
