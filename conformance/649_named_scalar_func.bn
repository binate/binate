package "main"
import "pkg/builtins/testing"

// Named distinct scalars as function parameters and results, including a
// mixed-type multi-return.  Param/result layout and the float-vs-int ABI
// classification (a named-float must ride a float register) peel
// TYP_NAMED; the multi-return struct {Id, Weight} mixes a named int and
// a named float, so its field layout must peel too.

type Id int
type Weight float64

func makeId(n int) Id {
	return cast(Id, n)
}

func addId(a Id, b Id) Id {
	return a + b
}

func split(w Weight) (Id, Weight) {
	return cast(Id, cast(int, w)), w / 2.0
}

func main() {
	var x Id = makeId(40)
	var y Id = addId(x, makeId(2))
	testing.Println(cast(int, y))             // 42

	var w Weight = 9.0
	var id Id
	var half Weight
	id, half = split(w)
	testing.Println(cast(int, id))            // 9
	testing.Println(cast(int, half * 2.0))    // 4.5*2 = 9.0 -> 9
}
