package "main"

// Named distinct types over SIZED integers keep the underlying width and
// signedness, not the host `int` — exercised through casts (trunc on the
// way down; sext for a signed underlying, zext for an unsigned one on the
// way back up).  The `Small` (int8) line is the discriminator: with the
// signedness peel its high-bit-set value sign-extends to -56; without it
// a bare TYP_NAMED reads as unsigned and zero-extends to 200.

type Byte uint8
type Small int8

func main() {
	// uint8 truncation: 300 & 0xff = 44.  The out-of-range constant is
	// laundered through `cast(int, ...)`: a direct `cast(Byte, 300)` is a
	// fit-check error (§8 — out-of-range constant cast to an integer
	// type), but the inner cast yields a non-constant int, so the Byte
	// cast truncates.
	var bb Byte = cast(Byte, cast(int, 300))
	println(cast(int, bb))            // 44

	// unsigned widen back to int: a high-bit-set uint8 zero-extends.
	var hi Byte = cast(Byte, 200)
	println(cast(int, hi))            // 200

	// int8 reinterpret: 200 as int8 is -56 (high bit = sign), and the
	// widen back to int sign-extends.  (Out-of-range constant laundered
	// through `cast(int, ...)`, as in the Byte case above.)
	var s Small = cast(Small, cast(int, 200))
	println(cast(int, s))             // -56

	// a small in-range signed value round-trips.
	var n Small = cast(Small, -5)
	println(cast(int, n))             // -5
}
