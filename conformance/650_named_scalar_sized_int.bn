package "main"
import "pkg/builtins/testing"

// Named distinct types over SIZED integers keep the underlying width and
// signedness, not the host `int` — exercised through truncation (mask) and a
// same-size reinterpret (bit_cast): trunc on the way down, sext for a signed
// underlying / zext for an unsigned one on the way back up.  The `Small`
// (int8) line is the discriminator: with the signedness peel its high-bit-set
// value sign-extends to -56; without it a bare TYP_NAMED reads as unsigned and
// zero-extends to 200.

type Byte uint8
type Small int8

func main() {
	// uint8 truncation, made explicit by masking: a `cast` is value-
	// preserving and does NOT launder an out-of-range constant (§8 — a
	// direct OR cast-wrapped out-of-range constant cast is a fit-check error),
	// so the low byte is taken with `& 0xff`: 300 & 0xff == 44.
	var bb Byte = cast(Byte, 300 & 0xff)
	testing.Println(cast(int, bb))            // 44

	// unsigned widen back to int: a high-bit-set uint8 zero-extends.
	var hi Byte = cast(Byte, 200)
	testing.Println(cast(int, hi))            // 200

	// int8 reinterpret: 200 as int8 is -56 (high bit = sign), produced by a
	// same-size `bit_cast` (uint8 -> int8); the widen back to int sign-extends.
	var s Small = bit_cast(Small, cast(uint8, 200))
	testing.Println(cast(int, s))             // -56

	// a small in-range signed value round-trips.
	var n Small = cast(Small, -5)
	testing.Println(cast(int, n))             // -5
}
