package "main"

// A `const` of a named distinct float type carries the named type, whose
// constant value must lower as a float (CONST_FLT) — not collapse to an
// int — and read back correctly in expressions.

type Rate float64

const Half Rate = 0.5
const Two Rate = 2.0

func main() {
	println(cast(int, Half * 8.0))    // 0.5*8 = 4.0 -> 4
	var r Rate = Half + Two           // 2.5
	println(cast(int, r * 2.0))       // 2.5*2 = 5.0 -> 5
	println(cast(int, Two))           // 2
}
