package "main"

import "pkg/temp"

// Cross-package named distinct scalar: a value of the imported named
// float type, used directly (constructor return, arithmetic, cast) and
// through a method.  The imported type registers as a TYP_NAMED carrying
// its QUALIFIED name, so cross-package method dispatch keys
// (`pkg/temp.Temp.Tenths`) match the definition side.

func main() {
	var t temp.Temp = temp.FromWhole(4)
	println(cast(int, t))           // 4
	var u temp.Temp = t + 1.5       // 5.5
	println(cast(int, u))           // 5
	println(u.Tenths())             // 5.5*10 = 55.0 -> 55
}
