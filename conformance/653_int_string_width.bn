package "main"

// Pins lang's primitive String() impls at full 64-bit width.  These
// are the cases the old cast-through-signed-`int` path got wrong:
// an int64 above 2^32 (truncated on 32-bit targets, where `int` is
// 32 bits) and unsigned values >= 2^63 (rendered as a negative
// number by the signed cast).  The outputs are width-independent,
// so one .expected covers both LP64 and ILP32.

import "pkg/builtins/lang"

func main() {
	var a int64 = 4294967296
	println(a.String())
	var b int64 = 9223372036854775807
	println(b.String())
	var c int64 = -9223372036854775808
	println(c.String())
	var d uint32 = 4294967295
	println(d.String())
	var e uint64 = 9223372036854775808
	println(e.String())
	var f uint64 = 18446744073709551615
	println(f.String())
}
