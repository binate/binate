package "main"

// `int.String()` resolves and links without importing pkg/builtins/lang
// (the compiler force-loads lang).  One type per test on purpose: linking
// is per-type, so a single combined test could let one type's String()
// pull in lang and mask another type's missing impl.

func main() {
	var x int = 42
	println(x.String())
}
