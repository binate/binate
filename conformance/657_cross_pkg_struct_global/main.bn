package "main"

import "pkg/cfg"

// Reading a struct-typed exported global across packages.  cfg declares
// `type Point` and `var G Point` in its .bni and defines G (zero-init) in
// its .bn.  Emitting the `@…__G = global %bn_pkg_cfg__Point` slot requires
// the `%bn_pkg_cfg__Point = type {…}` def to be emitted first — and in the
// cfg module no *function* references Point, so collectStructTypes must
// discover the struct through the module's GLOBALS, not only its funcs.
// Without that scan clang rejects the module with `use of undefined type`.
func main() {
	println(cfg.G.x)
	println(cfg.G.y)
}
