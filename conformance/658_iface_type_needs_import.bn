package "main"
import "pkg/builtins/testing"

// Referencing the lang.Stringer interface TYPE still requires importing
// pkg/builtins/lang.  Only the primitive String() *method* is available
// unqualified (see 654-656); naming the interface needs the import, so
// the `lang` qualifier here is unresolved and this must fail to compile.

func printIt(s *lang.Stringer) {
	testing.Println(s.String())
}

func main() {
	var x int = 42
	printIt(&x)
}
