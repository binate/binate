package "main"
import "pkg/builtins/testing"

// A compound shift-assign (`<<=` / `>>=`) must honor the overshift spec —
// 0 for a logical `<<=` / `>>=`, sign-fill for an arithmetic `>>=` — for
// EVERY lvalue form, exactly as the expression form (`x = x << n`) does.
// The compound path emitted a raw shift, so the hardware masked the count:
// `var y uint32 = 1; y <<= 40` gave `1 << (40 & 31)` = 256 instead of 0.
// Counts cross the width boundary (some runtime, some out-of-range
// constant — both route through the overshift guard) and each result is
// checked via `== expected`, so only a target-stable 0/1 is printed
// (no sub-word value hits the native sub-word print path).

type Box struct { u uint32 }

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var z0 uint32 = 0
	var big uint32 = 40         // runtime count >= 32

	// --- logical `<<=` overshift → 0, every lvalue form ---
	var v uint32 = 1
	v <<= big
	testing.Println(bi(v == z0))                                   // 1  variable

	var a [2]uint32
	a[0] = 1
	a[0] <<= 40
	testing.Println(bi(a[0] == z0))                                // 1  array element

	var s @[]uint32 = make_slice(uint32, 2)
	s[0] = 1
	s[0] <<= big
	testing.Println(bi(s[0] == z0))                                // 1  slice element

	var m [2][2]uint32
	m[1][1] = 1
	m[1][1] <<= 40
	testing.Println(bi(m[1][1] == z0))                             // 1  nested-array element

	var bx Box
	bx.u = 1
	bx.u <<= big
	testing.Println(bi(bx.u == z0))                                // 1  struct field

	var d uint32 = 1
	var p *uint32 = &d
	*p <<= 40
	testing.Println(bi(d == z0))                                   // 1  deref

	// --- logical `>>=` overshift (unsigned) → 0 ---
	var u uint32 = cast(uint32, 0x80000000)
	u >>= big
	testing.Println(bi(u == z0))                                   // 1

	// --- arithmetic `>>=` overshift (signed): sign-fill ---
	var neg int32 = cast(int32, 0) - cast(int32, 8)
	neg >>= 40
	testing.Println(bi(neg == (cast(int32, 0) - cast(int32, 1)))) // 1  -8 >>= 40 → -1

	var bigI int32 = 40
	var pos int32 = 100
	pos >>= bigI
	testing.Println(bi(pos == cast(int32, 0)))                    // 1  100 >>= 40 → 0

	// --- in-range compound shift still correct (fast path intact) ---
	var w uint32 = 1
	w <<= 4
	testing.Println(bi(w == cast(uint32, 16)))                    // 1
	var ai int32 = cast(int32, 0) - cast(int32, 8)
	ai >>= 1
	testing.Println(bi(ai == (cast(int32, 0) - cast(int32, 4)))) // 1  -8 >>= 1 → -4
}
