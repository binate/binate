package "main"
import "pkg/builtins/testing"

// Companion to the readonly field-read matrix cells: an alias
// (`type A = @Box`) wrapper over a pointer-to-struct / struct value is
// IR-transparent, so a field read must peel it just like `readonly` —
// otherwise IR-gen's Kind-dispatch misses every arm and returns a literal 0
// (CR-2 Plan-1 Defect 1).  (Named-DISTINCT field access — `type H @Box` —
// is a separate, checker-level question and is intentionally not covered
// here.)

type Box struct {
	v int
}

type AliasMP = @Box   // alias over a managed pointer-to-struct
type AliasRP = *Box   // alias over a raw pointer-to-struct
type AliasS = Box     // alias over a struct value

func main() {
	var p @Box = make(Box)
	p.v = 7

	var a AliasMP = p
	testing.Println(a.v)               // 7  alias @struct field read

	var raw *Box = p
	var ar AliasRP = raw
	testing.Println(ar.v)              // 7  alias *struct field read

	var s AliasS
	s.v = 5
	testing.Println(s.v)               // 5  alias struct-value field read + write
}
