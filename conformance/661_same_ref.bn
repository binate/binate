package "main"

// Spec + regression for the `same` builtin — reference identity for
// pointers, interface values, and slices.  Two
// operands are `same` iff they denote the same underlying thing: same
// address (pointers), the same boxed object — both {data, vtable} words
// (interface values), or the same view — {data, len} (slices).

interface Shape { area() int }
type Sq struct { s int }
func (x *Sq) area() int { return x.s * x.s }
impl *Sq : Shape
type Tri struct { t int }
func (x *Tri) area() int { return x.t }
impl *Tri : Shape

func main() {
	// Pointers: an alias is the same; a distinct allocation is not.
	var p1 @int = make(int)
	var p2 @int = p1
	var p3 @int = make(int)
	if same(p1, p2) { println(1) } else { println(0) }
	if same(p1, p3) { println(1) } else { println(0) }

	// Interface values: same boxed object vs a distinct object.
	var q1 @Sq = make(Sq)
	q1.s = 3
	var a @Shape = q1
	var b @Shape = a
	if same(a, b) { println(1) } else { println(0) }
	var q2 @Sq = make(Sq)
	q2.s = 4
	var cc @Shape = q2
	if same(a, cc) { println(1) } else { println(0) }

	// Typed-nil interface values: both have null data, so identity turns
	// on the vtable word — same concrete type is same, a different
	// concrete type is NOT (this is why BOTH {data, vtable} words matter,
	// not just data).
	var n1 @Sq = nil
	var n2 @Sq = nil
	var na @Shape = n1
	var nb @Shape = n2
	if same(na, nb) { println(1) } else { println(0) }
	var n3 @Tri = nil
	var nc @Shape = n3
	if same(na, nc) { println(1) } else { println(0) }

	// Slices: same view vs a distinct backing.
	var s1 @[]int = make_slice(int, 5)
	var s2 @[]int = s1
	var s3 @[]int = make_slice(int, 5)
	if same(s1, s2) { println(1) } else { println(0) }
	if same(s1, s3) { println(1) } else { println(0) }
}
