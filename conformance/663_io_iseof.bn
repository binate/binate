package "main"

// Spec + regression for io.IsEOF — `errors.Is(err, io.EOF)` built on
// `same` (plan-same-builtin.md / plan-std-errors.md).  IsEOF is true for
// the EOF sentinel, true even when EOF has been wrapped with context, and
// false for any other error or the empty error.

import "pkg/std/io"
import "pkg/std/errors"

func main() {
	// The EOF sentinel is EOF.
	if io.IsEOF(io.EOF) { println(1) } else { println(0) }
	// A distinct error is not EOF (identity, not message).
	var other @errors.Error = errors.New("nope")
	if io.IsEOF(other) { println(1) } else { println(0) }
	// EOF wrapped with context is still detected as EOF (chain walk).
	var wrapped @errors.Error = errors.Wrap(io.EOF, "reading header")
	if io.IsEOF(wrapped) { println(1) } else { println(0) }
	// The empty error (no error) is not EOF.
	var none @errors.Error
	if io.IsEOF(none) { println(1) } else { println(0) }
}
