package "main"

// `float64.String()` resolves and links without importing
// pkg/builtins/lang.  Separate per-type test (see 654); float goes
// through a distinct formatting path from the integers.  Covers both
// the fixed-point path (normal magnitudes) and the mantissa*2^exponent
// fallback (|v| >= 2^53 and |v| < ~1e-6).

func main() {
	var x float64 = 3.0
	println(x.String())
	var n float64 = -2.5
	println(n.String())
	var big float64 = 1.0e16
	println(big.String())
	var tiny float64 = 1.0e-7
	println(tiny.String())
}
