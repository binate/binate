package "main"

// `float64.String()` resolves and links without importing
// pkg/builtins/lang.  Separate per-type test (see 654); float goes
// through a distinct formatting path from the integers.  Covers both
// the fixed-point path (normal magnitudes) and the scientific
// e-notation fallback (|v| >= 2^53 and |v| < ~1e-6), including a
// non-trivial mantissa, a negative magnitude, and a tiny value.

func main() {
	var a float64 = 3.0
	println(a.String())
	var b float64 = -2.5
	println(b.String())
	var c float64 = 1.0e16
	println(c.String())
	var d float64 = 1.5e20
	println(d.String())
	var e float64 = -3.25e18
	println(e.String())
	var h float64 = 1.234567e25
	println(h.String())
	var f float64 = 1.0e-7
	println(f.String())
	var g float64 = 6.022e-8
	println(g.String())
}
