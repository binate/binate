package "main"

// `float64.String()` resolves and links without importing
// pkg/builtins/lang.  Separate per-type test (see 654); float goes
// through a distinct path (bootstrap.formatFloat) from the integers.

func main() {
	var x float64 = 3.0
	println(x.String())
	var n float64 = -2.5
	println(n.String())
}
