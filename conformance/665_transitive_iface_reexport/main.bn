package "main"
import "pkg/builtins/testing"

import "pkg/middle"

// `middle` re-exports `inner.Greeter` as `interface Greeter =
// inner.Greeter`; main imports ONLY middle, holds the value as
// `@middle.Greeter`, and dispatches `g.greet()`.  middle.Get returns
// `inner.Make()` — an iface value typed `@inner.Greeter` — coerced to
// the declared return type `@middle.Greeter`.  Because an alias and
// its target are spelled with different (Pkg, Name), a raw-name
// comparison treats them as distinct interfaces and emits an
// OP_IFACE_UPCAST (vtable base swap) where none is wanted: an alias IS
// the same interface, with the same vtable layout.  The upcast's slot
// offset is IfaceParentSlotOffset(inner.Greeter, middle.Greeter),
// which is -1 (the alias is not a PARENT of its target); used as a GEP
// index that walks the vtable pointer one slot BEFORE its base, so the
// `greet` slot loads the dtor word (null) and the dispatch jumps
// through null -> SIGSEGV.  The fix canonicalizes both interface refs
// through the alias chain before deciding whether an upcast is needed,
// so the alias and its target agree and no upcast is emitted.

func main() {
	var g @middle.Greeter = middle.Get()
	testing.Println(g.greet())
}
