package "main"

import "pkg/middle"

// Defect 8 (CR-2 Plan-1, UNCONFIRMED): `middle` re-exports `inner.Greeter`
// as `interface Greeter = inner.Greeter`; main imports ONLY middle and uses
// the managed interface value `@middle.Greeter`.  If the bare-name resolver
// honors only a single import-alias hop, `@middle.Greeter` degrades to a
// managed pointer (i8*) instead of a 2-word interface value, and the
// dispatch `g.greet()` mismatches the ABI.

func main() {
	var g @middle.Greeter = middle.Get()
	println(g.greet())
}
