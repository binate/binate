package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Spec + regression for "length-0 ⟹ no backing": every length-0 slice is the
// nil-equivalent {null, 0[, null, 0]}, so empty and "nil" slices are
// indistinguishable.  The 4 header words are read via &s (no copy, no
// RefInc), mirroring conformance/130.

func main() {
	var s @[]int = make_slice(int, 5)
	var ps *int = bit_cast(*int, &s)
	var backing *uint8 = bit_cast(*uint8, ps[2])

	// (1) Length-0 subslice → {null, 0, null, 0}.
	var empty @[]int = s[2:2]
	var pe *int = bit_cast(*int, &empty)
	testing.Println(pe[0])   // data   → 0 (null)
	testing.Println(pe[1])   // len    → 0
	testing.Println(pe[2])   // refptr → 0 (null)
	testing.Println(pe[3])   // backingLen → 0

	// (2) It did NOT bump s's backing refcount (it holds no backing ref).
	testing.Println(rt.Refcount(backing))   // 1

	// (3) All empty slices are `same` (the canonical {null,0}).
	var empty2 @[]int = s[5:5]
	if same(empty, empty2) { testing.Println(1) } else { testing.Println(0) }   // 1

	// (4) Empty string literal → null data.
	var es *[]readonly char = ""
	var pes *int = bit_cast(*int, &es)
	testing.Println(pes[0])   // data → 0 (null)
	testing.Println(len(es))  // 0

	// (5) Empty raw composite literal → null data.
	var er *[]readonly int = *[]readonly int{}
	var per *int = bit_cast(*int, &er)
	testing.Println(per[0])   // data → 0 (null)
	testing.Println(len(er))  // 0

	// (6) A destructible-element managed slice subsliced to empty drops
	//     cleanly (its dtor sees a null backing → no-op, no fault).
	var ds @[]@[]int = make_slice(@[]int, 2)
	ds[0] = make_slice(int, 1)
	ds[1] = make_slice(int, 1)
	var de @[]@[]int = ds[1:1]
	testing.Println(len(de))  // 0
}
