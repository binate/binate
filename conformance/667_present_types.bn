package "main"
import "pkg/builtins/testing"

// present() for the sensible types beyond interface values (which 545
// covers): function values, pointers, and slices.  present(x) = "does x hold
// something / is it set".

func fortyTwo() int { return 42 }

func main() {
	// Function value: set vs unset (nil).  Func values have no `== nil`,
	// so present is the sanctioned "is it set" test (vtable word, field 0).
	var fset @func() int = fortyTwo
	if present(fset) { testing.Println(1) } else { testing.Println(0) }    // 1
	var funset @func() int = nil
	if present(funset) { testing.Println(1) } else { testing.Println(0) }  // 0

	// Pointer: set vs nil.
	var x int = 7
	var pset *int = &x
	if present(pset) { testing.Println(1) } else { testing.Println(0) }    // 1
	var pnil *int = nil
	if present(pnil) { testing.Println(1) } else { testing.Println(0) }    // 0

	// Slice: non-empty vs empty (a length-0 slice has no backing).
	var sfull @[]int = make_slice(int, 3)
	if present(sfull) { testing.Println(1) } else { testing.Println(0) }   // 1
	var sempty @[]int = make_slice(int, 0)
	if present(sempty) { testing.Println(1) } else { testing.Println(0) }  // 0
}
