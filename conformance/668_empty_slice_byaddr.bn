package "main"

// Regression for the bytecode-VM representation of a length-0 /
// nil-equivalent slice.  An
// aggregate `OP_CONST_NIL` — an empty string literal, an empty raw
// composite literal, make_slice(_, 0) — is carried by the ADDRESS of a
// zeroed image, like every aggregate value in the VM, NOT as a scalar 0.
// Emitting the scalar 0 handed a null address to any by-address consumer
// (a call argument, an OP_EXTRACT such as len() / present()), so len() of
// an empty literal used WITHOUT first storing it into a variable read
// through null and returned garbage on the bytecode VM (the var-decl form,
// conformance/666, masked it because the store zeroes the slot directly).
// conformance/110 exercises the cross-package call-argument shape; this
// isolates the mechanism mode-agnostically, including the direct-extract
// and composite-literal paths 110 does not reach.

func lenOf(s *[]readonly char) int {
	return len(s)
}

func mlenOf(s @[]char) int {
	return len(s)
}

func main() {
	// (1) len of an empty string literal evaluated directly — the
	//     by-address OP_EXTRACT with no intervening variable store.
	println(len(""))                       // 0

	// (2) Empty string literal passed as a call argument (110's shape,
	//     minimal and single-package).
	println(lenOf(""))                     // 0

	// (3) An empty raw composite literal passed as a call argument.
	println(lenOf(*[]readonly char{}))     // 0

	// (4) make_slice(_, 0) by-address — already compliant; pin that it
	//     stays 0 when carried as a call argument.
	println(mlenOf(make_slice(char, 0)))   // 0
}
