package "main"
import "pkg/builtins/testing"

// A global's address taken as an rvalue and reinterpreted to an integer via
// `bit_cast(int, &G)` (-> ptrtoint) must render the IsGlobalRef pseudo as
// `@<mangled>`, not a nonexistent `%v-1`; then round-trip int -> ptr back to a
// writable *int.  A pointer <-> integer conversion is a same-size reinterpret, so
// it is `bit_cast` (§8.6), not `cast`.

var G int = 10

func main() {
	var addr int = bit_cast(int, &G)     // ptrtoint of &G
	var r *int = bit_cast(*int, addr)    // round-trip int -> ptr
	r[0] = r[0] + 1                  // G = 11
	testing.Println(G)                       // 11
}
