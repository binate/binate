package "main"
import "pkg/builtins/testing"

// Regression: a global's address used as an rvalue through the `cast`
// builtin (`cast(int, &G)` -> ptrtoint) must render the IsGlobalRef
// pseudo as `@<mangled>`, not the nonexistent `%v-1`.  The emitValRef
// migration fixed bit_cast (551) but missed emitCast's per-arm source
// reads, so clang rejected `ptrtoint i8* %v-1 to i64`.  The VM was
// already correct (it materializes IsGlobalRef op-agnostically).  The
// native x64/aa64 OP_CAST drop of `&G` is a separate backend gap (Plan
// 3), so this cell xfails the native modes until that lands.

var G int = 10

func main() {
	var addr int = cast(int, &G)     // ptrtoint of &G
	var r *int = cast(*int, addr)    // round-trip int -> ptr
	r[0] = r[0] + 1                  // G = 11
	testing.Println(G)                       // 11
}
