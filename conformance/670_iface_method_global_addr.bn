package "main"
import "pkg/builtins/testing"

// Regression: a global's address passed to an INTERFACE method
// (`b.bump(&G)`) must render the IsGlobalRef pseudo as `@<mangled>`, not
// `%v-1`.  emit_iface_call.bn's non-byval scalar-arg branch used emitRef
// (ID -1 -> `%v-1`) instead of emitValRef, so clang rejected `i8* %v-1`.
// The VM was already correct.  The native aa64 iface-arg drop of `&G` is
// a separate backend gap (Plan 3; the x64 sibling was fixed in
// 0c707e1f), so this cell xfails native aa64 until that lands.

var G int = 10

interface Bumper { bump(p *int) }
type Impl struct { n int }
func (im *Impl) bump(p *int) { p[0] = p[0] + im.n }
impl *Impl : Bumper

func main() {
	var im @Impl = make(Impl)
	im.n = 5
	var b @Bumper = im
	b.bump(&G)       // iface-method arg; G = 15
	testing.Println(G)       // 15
}
