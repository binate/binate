package "main"
import "pkg/builtins/testing"

// A global's address passed to an INTERFACE method (`b.bump(&G)`) must
// reach the method: the LLVM call renders the IsGlobalRef pseudo as
// `@<mangled>`, not as an SSA reference to ID -1 (`%v-1`, which clang
// rejects as `i8* %v-1`), and the native backends pass `&G` as the iface
// arg rather than dropping it.  The VM handles it too.

var G int = 10

interface Bumper { bump(p *int) }
type Impl struct { n int }
func (im *Impl) bump(p *int) { p[0] = p[0] + im.n }
impl *Impl : Bumper

func main() {
	var im @Impl = make(Impl)
	im.n = 5
	var b @Bumper = im
	b.bump(&G)       // iface-method arg; G = 15
	testing.Println(G)       // 15
}
