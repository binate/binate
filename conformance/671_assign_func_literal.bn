package "main"
import "pkg/builtins/testing"

// Regression: a bare func literal assigned via plain `=` (not `:=`, not a
// var initializer) to a managed-func-value var must resolve to the LHS's
// @func flavour and be heap-allocated, so the capturing closure works.
// Before the fix the simple-assign loop checked the RHS without the LHS
// function-value hint, so the literal resolved as raw *func() and the
// assignment was rejected ("cannot assign").  The var-init, call-arg, and
// return positions already applied the hint; plain `=` was the straggler.

func main() {
	var base int = 10
	var f @func(int) int
	f = func(x int) int { return base + x }
	testing.Println(f(5))      // 15
}
