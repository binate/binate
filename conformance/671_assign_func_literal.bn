package "main"
import "pkg/builtins/testing"

// Regression: a bare func literal assigned via plain `=` (not `:=`, not a
// var initializer) to a managed-func-value var must resolve to the LHS's
// @func flavour and be heap-allocated, so the capturing closure works.
// The simple-assign loop must check the RHS with the LHS function-value
// hint, as the var-init, call-arg, and return positions do; without the
// hint the literal resolves as raw *func() and the assignment is rejected
// ("cannot assign").

func main() {
	var base int = 10
	var f @func(int) int
	f = func(x int) int { return base + x }
	testing.Println(f(5))      // 15
}
