package "main"
import "pkg/builtins/testing"

// Regression (compile-time error): a bit-flag const's COMPILE-TIME value
// must be the folded `1 << iota`, not the plain iota index — including the
// BARE members that repeat the explicit B0 initializer.  With an UNTYPED
// base the members stay untyped and are range-checked when narrowed: B8
// folds to 1<<8 = 256, so `var x uint8 = B8` is REJECTED (256 > 255).
// A checker that leaves iota unfolded stores the plain iota index for a
// bare member (B8 = 8, which fits) and wrongly accepts this.
// (A TYPED bit-flag group rejects the overflow at the declaration instead
// — see 690_err_const_group_bare_overflow.)  Type-check error, so
// identical on every backend.

const (
	B0 = 1 << iota
	B1
	B2
	B3
	B4
	B5
	B6
	B7
	B8
)

func main() {
	var x uint8 = B8
	testing.Println(cast(int, x))
}
