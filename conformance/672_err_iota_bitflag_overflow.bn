package "main"

// Regression (compile-time error): a bit-flag const's COMPILE-TIME value
// must be the folded `1 << iota`, not the plain iota index — including for
// the BARE members that repeat the explicit B0 initializer.  B8 folds to
// 1<<8 = 256, so `var x uint8 = B8` must be REJECTED (256 > 255).  Before
// the fix the checker left iota unfolded and a bare member stored the
// plain iota index (B8 = 8, which fits), so this was wrongly accepted.
// Type-check error, so identical on every backend.

const (
	B0 int = 1 << iota
	B1
	B2
	B3
	B4
	B5
	B6
	B7
	B8
)

func main() {
	var x uint8 = B8
	println(cast(int, x))
}
