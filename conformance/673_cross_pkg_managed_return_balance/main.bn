package "main"

import "pkg/store"
import "pkg/builtins/rt"

// A managed value RETURNED from an imported constructor must arrive owned with
// rc exactly 1 (no double-retain leak on the return move).
func main() {
	var a @store.Node = store.New()
	var po *uint8 = bit_cast(*uint8, a)
	println(rt.Refcount(po))
	println(a.V)
	var b @store.Node = a
	println(rt.Refcount(po))
	println(b.V)
}
