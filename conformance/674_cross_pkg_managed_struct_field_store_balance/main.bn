package "main"
import "pkg/builtins/testing"

import "pkg/store"
import "pkg/builtins/rt"

// Storing a managed value into a STRUCT FIELD whose type is a cross-package
// @Node must balance: the store RefIncs, overwriting the field RefDecs the old.
type Root struct {
	Child @store.Node
}

func main() {
	var c @store.Node = make(store.Node)
	c.V = 42
	var po *uint8 = bit_cast(*uint8, c)
	var before int = rt.Refcount(po)
	var r Root
	r.Child = c
	testing.Println(cast(int, rt.Refcount(po) == before + 1))
	testing.Println(r.Child.V)
	var c2 @store.Node = make(store.Node)
	r.Child = c2
	testing.Println(cast(int, rt.Refcount(po) == before))
}
