package "main"

import "pkg/shape"
import "pkg/builtins/rt"

// Constructing a managed interface value from an IMPORTED impl must RefInc the
// receiver into the box and RefDec it when the box drops.
func main() {
	var c @shape.Circle = shape.NewCircle(42)
	var po *uint8 = bit_cast(*uint8, c)
	var before int = rt.Refcount(po)
	var iv @shape.Shape = c
	println(cast(int, rt.Refcount(po) == before + 1))
	println(iv.area())
	var c2 @shape.Circle = shape.NewCircle(0)
	var iv2 @shape.Shape = c2
	iv = iv2
	println(cast(int, rt.Refcount(po) == before))
}
