package "main"

import "pkg/shape"
import "pkg/builtins/rt"

// A managed INTERFACE value RETURNED across a package boundary (an imported
// function boxes a Circle into a Shape and returns it) must balance: the box
// holds the receiver while live and RefDecs it when the box drops.
func main() {
	var c @shape.Circle = shape.NewCircle(42)
	var po *uint8 = bit_cast(*uint8, c)
	var before int = rt.Refcount(po)
	var iv @shape.Shape = shape.Box(c)
	println(cast(int, rt.Refcount(po) == before + 1))
	println(iv.area())
	var c2 @shape.Circle = shape.NewCircle(0)
	var iv2 @shape.Shape = shape.Box(c2)
	iv = iv2
	println(cast(int, rt.Refcount(po) == before))
}
