package "main"
import "pkg/builtins/testing"

import "pkg/store"
import "pkg/builtins/rt"

// Storing a managed value into a managed-slice ELEMENT held in an imported
// package must balance the element's refcount AND RefDec the overwritten element.
func main() {
	var a @store.Node = make(store.Node)
	a.V = 42
	var po *uint8 = bit_cast(*uint8, a)
	var before int = rt.Refcount(po)
	store.S[0] = a
	testing.Println(cast(int, rt.Refcount(po) == before + 1))
	testing.Println(store.S[0].V)
	var b @store.Node = make(store.Node)
	store.S[0] = b
	testing.Println(cast(int, rt.Refcount(po) == before))
}
