package "main"
import "pkg/builtins/testing"

import "pkg/store"
import "pkg/builtins/rt"

// Passing a managed value as an ARGUMENT to an imported function must balance:
// the caller-side arg RefInc and the callee-scope RefDec net to zero.
func main() {
	var a @store.Node = make(store.Node)
	a.V = 42
	var po *uint8 = bit_cast(*uint8, a)
	var before int = rt.Refcount(po)
	var r int = store.Consume(a)
	testing.Println(cast(int, rt.Refcount(po) == before))
	testing.Println(r)
	testing.Println(a.V)
}
