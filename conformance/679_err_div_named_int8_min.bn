package "main"

// Named-distinct sub-word signed MIN / -1 divide overflow — the regression
// for binate b43a0057 (widenType preserves a named type's width + sign;
// the divide-fault guard reads them via typeWidth / typeIsSigned, which
// peel TYP_NAMED).  `type I8 int8`, then -128 / -1 = 128 overflows int8 ->
// a defined "integer overflow" panic.  Operands come from functions so
// const-fold can't evaluate the overflow at compile time.  Before
// b43a0057 the guard read width 64 / unsigned off the bare TYP_NAMED and
// let the overflow escape (the quotient computed at 64-bit, no trap).

type I8 int8

func i8min() I8 { return cast(I8, -128) }
func negOne() I8 { return cast(I8, -1) }

func main() {
	var a I8 = i8min()
	var b I8 = negOne()
	println(cast(int, a / b))
}
