package "main"
import "pkg/builtins/testing"

// Named-distinct sub-word signed MIN / -1 divide overflow (int16 variant
// of 679; binate b43a0057).  `type I16 int16`, -32768 / -1 = 32768
// overflows int16 -> "integer overflow" panic.  Operands from functions
// so const-fold can't evaluate it at compile time.

type I16 int16

func i16min() I16 { return cast(I16, -32768) }
func negOne() I16 { return cast(I16, -1) }

func main() {
	var a I16 = i16min()
	var b I16 = negOne()
	testing.Println(cast(int, a / b))
}
