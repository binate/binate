package "main"

// Named-distinct sub-word signed MIN / -1 divide overflow (int32 variant
// of 679; binate b43a0057).  `type I32 int32`, -2147483648 / -1 =
// 2147483648 overflows int32 -> "integer overflow" panic.  The MIN
// literal is portable across 32- and 64-bit targets.  Operands from
// functions so const-fold can't evaluate it at compile time.

type I32 int32

func i32min() I32 { return cast(I32, -2147483648) }
func negOne() I32 { return cast(I32, -1) }

func main() {
	var a I32 = i32min()
	var b I32 = negOne()
	println(cast(int, a / b))
}
