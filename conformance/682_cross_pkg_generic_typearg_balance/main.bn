package "main"

import "pkg/genlib"
import "pkg/things"
import "pkg/builtins/rt"

// A managed value passed as the type-argument value to a cross-package generic
// (Append[@Thing]) must have its refcount balanced: the generic's element store
// (ns[n] = v) RefIncs it into the slice, and the slice drop RefDecs it.
func main() {
	var t @things.Thing = make(things.Thing)
	t.V = 42
	var po *uint8 = bit_cast(*uint8, t)
	var before int = rt.Refcount(po)
	var xs @[]@things.Thing
	xs = genlib.Append[@things.Thing](xs, t)
	println(cast(int, rt.Refcount(po) == before + 1))
	println(xs[0].V)
	var empty @[]@things.Thing
	xs = empty
	println(cast(int, rt.Refcount(po) == before))
}
