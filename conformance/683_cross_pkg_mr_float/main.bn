package "main"

// A float-component multi-return crossing the native<->LLVM boundary:
// pkg/mrf is compiled by LLVM (imported, non-main) while main is native,
// so the native caller's multi-return COLLECT must read the float field
// from D0/XMM0 (AAPCS64/SysV), not a GP register.  (int, float64) is a mixed
// INTEGER+SSE pair; (float64, float64) is an HFA / XMM0+XMM1.
import "pkg/mrf"

func main() {
	var n int
	var f float64
	n, f = mrf.IntF64()
	println(n)                   // 7
	println(cast(int, f * 2.0))  // 7  (3.5 * 2)

	var a float64
	var b float64
	a, b = mrf.F64F64()
	println(cast(int, a * 2.0))  // 3  (1.5 * 2)
	println(cast(int, b * 2.0))  // 9  (4.5 * 2)
}
