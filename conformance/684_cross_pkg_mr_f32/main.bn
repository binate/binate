package "main"

// Cross-package float32 multi-return: native main collects a (float32,float32)
// and a (float32,int32) tuple from the LLVM-compiled pkg/mrf32.  LLVM lowers a
// first-class struct return FIELD-PER-REGISTER (no SysV eightbyte coalescing):
// (float32,float32) → XMM0,XMM1 and (float32,int32) → XMM0,EAX — each component
// its own class register.  Pins that the native x64 pack/collect match that
// (the per-eightbyte-coalescing predecessor packed both floats into one XMM0 /
// coalesced float+int into RAX, reading garbage cross-package).  aa64 returns
// each float in its own D register.  See claude-todo.md "x64 float32
// multi-return".
import "pkg/mrf32"

func main() {
	var c float32
	var d float32
	c, d = mrf32.F32F32()
	println(cast(int, c))   // 3
	println(cast(int, d))   // 5

	var e float32
	var g int32
	e, g = mrf32.F32I32()
	println(cast(int, e))   // 7
	println(cast(int, g))   // 9
}
