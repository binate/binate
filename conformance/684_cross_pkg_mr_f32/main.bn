package "main"

// XFAIL on native x64 (tracked): a sub-8-byte float (float32) multi-return
// component SHARES an eightbyte on SysV-AMD64 — (float32,float32) coalesces
// into one SSE eightbyte (XMM0), (float32,int32) into one INTEGER eightbyte
// (RAX).  The native x64 pack/collect (multiReturnEightbyteIsSSE) are
// self-consistent but DISAGREE with LLVM's actual x64 float32 multi-return
// ABI, so this cross-package case (native main collects from LLVM-compiled
// pkg/mrf32) reads garbage / faults on x64.  aa64 is correct (each float
// gets its own D register, matching AAPCS64).  float64 multi-return is fully
// correct (conformance/683).  See claude-todo.md "x64 float32 multi-return
// cross-package native↔LLVM ABI mismatch".
import "pkg/mrf32"

func main() {
	var c float32
	var d float32
	c, d = mrf32.F32F32()
	println(cast(int, c))   // 3
	println(cast(int, d))   // 5

	var e float32
	var g int32
	e, g = mrf32.F32I32()
	println(cast(int, e))   // 7
	println(cast(int, g))   // 9
}
