package "main"

// A managed->raw decay of the SAME zero-method interface (`@E -> *E`)
// routes through the OP_IFACE_UPCAST path (managed vs raw differ on Kind),
// and previously computed a -1 vtable slot offset (E is not its own
// parent) emitted as `getelementptr ... i64 -1` — harmless for a
// zero-method iface (which never derefs the vtable) but a silent footgun.
// IfaceParentSlotOffset now resolves same-interface to 0, and the upcast
// lowerings (LLVM + native) hard-assert offset >= 0 — so a regression to
// -1 here would be a loud COMPILE error, not silent corruption.

interface E {}

type T struct { v int }

impl *T : E

func main() {
	var t @T = make(T)
	t.v = 7
	var em @E = t        // managed iface value
	var er *E = em       // @E -> *E decay: the same-interface upcast
	_ = er
	println(t.v)         // 7
}
