package "main"

// Managed->raw decay of the SAME interface (`@Iface -> *Iface`) is a
// supported conversion for EVERY interface (mirroring `@T -> *T`): it
// routes through OP_IFACE_UPCAST (managed vs raw differ on Kind) with a
// vtable slot offset of 0 (the source vtable IS the target's).  Covers
// both a zero-method interface (E) and a non-empty one (Speaker); the
// latter exercises method dispatch through the decayed raw view.
//
// IfaceParentSlotOffset resolves same-interface to 0, and the upcast
// lowerings (LLVM + native) hard-assert offset >= 0 — so a regression
// to a -1 slot offset here would be a loud COMPILE error, not silent
// vtable corruption.  (Empty same-interface decay used to compute -1.)

interface E {}

interface Speaker {
	speak() int
}

type T struct {
	v int
}

func (t *T) speak() int {
	return t.v
}

impl *T : E

impl *T : Speaker

func main() {
	var t @T = make(T)
	t.v = 7
	var em @E = t        // managed iface value (zero-method)
	var er *E = em       // @E -> *E decay (same interface, offset 0)
	_ = er
	println(t.v)         // 7

	t.v = 9
	var sm @Speaker = t  // managed iface value (non-empty)
	var sr *Speaker = sm // @Speaker -> *Speaker decay (same interface)
	println(sr.speak())  // 9 -- dispatch through the decayed raw view
}
