package "main"

import "pkg/store"

// Writing a FIELD through an imported VALUE-STRUCT var (`store.VS.V = v`)
// and an imported RAW-PTR var (`store.RP.V = v`) — the value-struct and
// raw-ptr facets of the nested-selector lvalue path that 561 covers for a
// managed-ptr (`@Node`) var.  genSelectorPtr's package-qualified branch
// must recognize `store.VS` / `store.RP` (themselves selectors) as the
// store base.  RP aliases VS in the defining package (`var RP *Node = &VS`),
// so a write through RP is observable as store.VS.V — confirming the raw-ptr
// write reaches the real external storage.
func main() {
	store.VS.V = 7
	println(store.VS.V)   // 7 (value-struct field write-through)
	store.RP.V = 9        // write a field through the imported raw-ptr var
	println(store.RP.V)   // 9
	println(store.VS.V)   // 9 (RP aliases VS — the write landed in VS)
}
