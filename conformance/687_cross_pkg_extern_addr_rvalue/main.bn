package "main"
import "pkg/builtins/testing"

import "pkg/gvar"

// Taking the address of an imported (external) global scalar as a VALUE
// (`&gvar.X`) must render the external symbol in every value-operand
// position — the cross-package analogue of 551 (which covers a same-package
// global).  551's fix made the IsGlobalRef rvalue render the mangled symbol
// (not an undefined `%v-1`); this checks it also fires for an externally-
// declared global reached through a package-qualified selector: store value,
// direct + func-value call arg, single return, slice-element store, composite
// struct field, and bit_cast source.  The final gvar.Get() confirms every
// write landed in the real external storage.
type Box struct {
	p *int
}

func bump(p *int) {
	p[0] = p[0] + 1
}

func getX() *int {
	return &gvar.X
}

func main() {
	var p *int = &gvar.X       // store (var-init)
	p[0] = 1                   // X = 1
	bump(&gvar.X)              // direct call arg; X = 2
	var q *int = getX()        // single return
	q[0] = q[0] + 1            // X = 3
	var fp *func(*int) = bump
	fp(&gvar.X)                // func-value call arg; X = 4
	var s @[]*int = make_slice(*int, 1)
	s[0] = &gvar.Y             // slice-element store
	s[0][0] = s[0][0] + 1      // Y = 21
	var bx Box = Box{&gvar.X}  // composite struct field
	bx.p[0] = bx.p[0] + 1      // X = 5
	var addr int = bit_cast(int, &gvar.X)   // bit_cast source (ptrtoint)
	var r *int = bit_cast(*int, addr)       // round-trip int -> ptr
	r[0] = r[0] + 1            // X = 6
	testing.Println(gvar.X)            // 6
	testing.Println(gvar.Y)            // 21
	testing.Println(gvar.Get())        // 6 (owner sees the writes — same storage)
}
