package "main"
import "pkg/builtins/testing"

// Regression: a string literal coerced to a `readonly`-wrapped slice
// parameter, and a `readonly`-wrapped managed-slice carried by value.
//
// `readonly` is an IR-transparent capability marker — it does not change a
// value's representation — so every aggregate-vs-scalar / slice-vs-not
// decision must peel it.  Several coercion / classification points instead
// gated on the bare `.Kind`, mis-treating a `readonly @[]char` (etc.) as a
// non-slice scalar:
//
//   - coerceArg (gen_call.bn) skipped the string->chars conversion, so the
//     bare string-literal pointer was passed where the callee reads a 4-word
//     managed-slice by address -> SIGSEGV (native/LLVM) / garbage (VM).
//   - the bytecode VM's aggregate-load and store classifiers treated the
//     readonly managed-slice as a single scalar word (param copied into a
//     local stored one word; len() then read garbage).
//   - the LLVM aggregate-nil type selector emitted a scalar `inttoptr 0`
//     for an empty `readonly @[]readonly char` literal, mismatching the
//     %BnManagedSlice the consumer loads.
//
// All four backends (LLVM, native aarch64/x86-64, bytecode VM) must now agree.

// readonly @[]char takes the implicit-copy (mutable element) path.
func lenMchar(s readonly @[]char) int { return len(s) }
// readonly @[]readonly char takes the rodata-managed-slice path (alias the
// static global; empty literal -> aggregate const-nil).
func lenMro(s readonly @[]readonly char) int { return len(s) }
// readonly *[]readonly char takes the rodata-raw-slice path.
func lenR(s readonly *[]readonly char) int { return len(s) }

func main() {
	// Empty string literal directly as a readonly-slice argument: the
	// length-0 / nil-equivalent aggregate, by address.
	testing.Println(lenMchar(""))   // 0
	testing.Println(lenMro(""))     // 0
	testing.Println(lenR(""))       // 0
	// Non-empty string literal as a readonly-slice argument.
	testing.Println(lenMchar("ab")) // 2
	testing.Println(lenMro("cde"))  // 3
	testing.Println(lenR("fghi"))   // 4
	// Via a readonly-typed local (var-decl uses isCharSliceType, which
	// already peels; the load + by-value pass through coerceArg/VM must too).
	var a readonly @[]char = ""
	var b readonly @[]readonly char = "xy"
	var c readonly *[]readonly char = ""
	testing.Println(lenMchar(a))    // 0
	testing.Println(lenMro(b))      // 2
	testing.Println(lenR(c))        // 0
}
