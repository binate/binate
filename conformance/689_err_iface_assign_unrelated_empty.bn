package "main"

// A user-declared empty interface is a NOMINAL marker, NOT a structural
// universal like the built-in `any` — Binate interfaces are nominal (no
// duck typing).  Assigning to `*Empty` requires an explicit `impl`:
// neither a concrete `*T` with no impl nor an unrelated interface value
// `*Speaker` satisfies `*Empty`.  Only `any` is universally satisfiable.
// Regression guard: the checker used to accept any zero-method target
// (`len(iface.Methods)==0 { return true }`), which also fed a -1 vtable
// slot offset into the upcast lowerings.  See types_assignable.bn
// (isUniverseAny).

interface Speaker {
	speak() int
}

interface Empty {}

type T struct {
	v int
}

func (t *T) speak() int {
	return t.v
}

impl *T : Speaker

func main() {
	var t T
	t.v = 1
	var e1 *Empty = &t       // concrete *T -> *Empty, no `impl *T : Empty`
	var s *Speaker = &t
	var e2 *Empty = s        // interface value *Speaker -> *Empty (unrelated)
	_ = e1
	_ = e2
}
