package "main"
import "pkg/builtins/testing"

// A bare const-group member inherits the preceding member's TYPE (and
// its `1 << iota` initializer, re-evaluated at this iota).  In a uint8
// bit-flag group B8 folds to 1<<8 = 256, which overflows its inherited
// uint8 type — REJECTED at the declaration, exactly like the explicit
// `const B8 uint8 = 256`.  Regression guard: a checker that stores a bare
// member as untyped with no range check compiles this group, and IR-gen
// truncates B8 to 0 — a silent wrong-value miscompile.

const (
	B0 uint8 = 1 << iota
	B1
	B2
	B3
	B4
	B5
	B6
	B7
	B8
)

func main() {
	testing.Println(cast(int, B8))
}
