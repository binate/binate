package "main"

// A bare const-group member inherits the preceding member's TYPE and its
// `1 << iota` initializer (re-evaluated at this iota).  An in-range uint8
// bit-flag group is valid: the members are typed uint8 carrying the
// folded bit values (1,2,4,…,128) — not the plain iota index, and not
// truncated — and combine directly as uint8 flags.

const (
	F0 uint8 = 1 << iota
	F1
	F2
	F3
	F4
	F5
	F6
	F7
)

func main() {
	println(cast(int, F0))         // 1   (1<<0, not iota 0)
	println(cast(int, F3))         // 8   (1<<3)
	println(cast(int, F7))         // 128 (1<<7, fits uint8)
	var flags uint8 = F0 | F2 | F7 // typed-uint8 flags combine
	println(cast(int, flags))      // 133 = 1 | 4 | 128
}
