package "main"
import "pkg/builtins/testing"

import "pkg/builtins/build"

// pkg/builtins/build exposes the active compile target's metadata as
// compile-time constants.  This checks:
//   (1) the layout constants (PtrSize/IntSize) agree with the compiler's
//       own sizeof — so binate-paths selected a build.bni of the matching
//       width class.  This catches the real wiring bug: a host 8/8 tree
//       used for a 4/4 arm32 cross compile.
//   (2) the OS/Arch enums are distinct + type-safe, and OS/Arch each hold
//       a valid member.
// Output is target-independent on purpose (no OS/arch named), so one
// .expected holds across every host and cross target.  The tradeoff: a
// same-width wrong tree (e.g. an arm64 tree for an x86_64 build) isn't
// distinguishable here — explicit-key selection makes that unreachable in
// practice, and pinning it would need per-mode .expected files.
func main() {
	if build.IntSize == cast(int, sizeof(int)) {
		testing.Println("int-size ok")
	} else {
		testing.Println("int-size MISMATCH")
	}
	if build.PtrSize == cast(int, sizeof(*int)) {
		testing.Println("ptr-size ok")
	} else {
		testing.Println("ptr-size MISMATCH")
	}
	if build.OS_LINUX != build.OS_DARWIN &&
			build.OS_DARWIN != build.OS_BAREMETAL {
		testing.Println("os-enum ok")
	} else {
		testing.Println("os-enum BAD")
	}
	if build.ARCH_X64 != build.ARCH_AARCH64 &&
			build.ARCH_AARCH64 != build.ARCH_ARM32 {
		testing.Println("arch-enum ok")
	} else {
		testing.Println("arch-enum BAD")
	}
	if build.OS == build.OS_LINUX || build.OS == build.OS_DARWIN ||
			build.OS == build.OS_BAREMETAL {
		testing.Println("os ok")
	} else {
		testing.Println("os BAD")
	}
	if build.Arch == build.ARCH_X64 || build.Arch == build.ARCH_AARCH64 ||
			build.Arch == build.ARCH_ARM32 {
		testing.Println("arch ok")
	} else {
		testing.Println("arch BAD")
	}
}
