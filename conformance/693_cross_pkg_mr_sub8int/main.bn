package "main"

// Cross-package sub-8-byte INTEGER multi-return: native main collects from the
// LLVM-compiled pkg/mrsub8.  LLVM lowers a first-class struct return
// FIELD-PER-REGISTER with NO SysV/AAPCS eightbyte coalescing — confirmed on
// both targets: x64 `(i32,i32)`→EAX,EDX, `(u16,u16,u16)`→AX,DX,CX,
// `(i32,i32,i32)`→EAX,EDX,ECX; aa64 the same in X0,X1,X2.  Companion to 684
// (float32): the predecessor x64 scheme COALESCED these into one/two registers
// (eightbyte rule) and read fields 1+ from the wrong place at the native↔LLVM
// boundary.  See claude-todo #112.
import "pkg/mrsub8"

func main() {
	var a int32
	var b int32
	a, b = mrsub8.I32I32()
	println(cast(int, a))   // 3
	println(cast(int, b))   // 5

	var c uint16
	var d uint16
	var e uint16
	c, d, e = mrsub8.U16x3()
	println(cast(int, c))   // 7
	println(cast(int, d))   // 9
	println(cast(int, e))   // 11

	var f int32
	var g int32
	var h int32
	f, g, h = mrsub8.I32x3()
	println(cast(int, f))   // 13
	println(cast(int, g))   // 15
	println(cast(int, h))   // 17
}
