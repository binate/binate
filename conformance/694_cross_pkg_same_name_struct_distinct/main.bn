package "main"

import "pkg/dep"

// Regression guard for the cross-package struct-name mangler-collision class
// (Option B struct-name qualification): "main" defines its OWN `type Box`
// while importing pkg/dep's same-short-named `type Box` of a DIFFERENT shape.
// Struct Type.Name is now path-qualified ("main.Box" vs "pkg/dep.Box"), so
// Identical distinguishes them and the cross-type assignment below is
// REJECTED.  Before qualification both were the bare name "Box", so Identical
// false-matched and the assignment was wrongly accepted (then used the wrong
// layout — an out-of-range field access).

type Box struct {
	x int
}

func main() {
	var d @dep.Box = dep.Make()
	var m @Box = d
	_ = m
}
