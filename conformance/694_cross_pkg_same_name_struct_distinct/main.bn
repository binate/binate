package "main"

import "pkg/dep"

// Regression guard for the cross-package struct-name mangler-collision class
// (struct names are path-qualified): "main" defines its OWN `type Box`
// while importing pkg/dep's same-short-named `type Box` of a DIFFERENT shape.
// Struct Type.Name is path-qualified ("main.Box" vs "pkg/dep.Box"), so
// Identical distinguishes them and the cross-type assignment below is
// REJECTED.  With both named by the bare "Box", Identical would false-match
// and the assignment would be wrongly accepted (then use the wrong layout —
// an out-of-range field access).

type Box struct {
	x int
}

func main() {
	var d @dep.Box = dep.Make()
	var m @Box = d
	_ = m
}
