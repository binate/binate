package "main"
import "pkg/builtins/testing"

// A multi-return destructure must reject a `readonly @T` (const) LHS the same
// way a direct `x = ...` does — assigning to a const-typed LOCATION.  A
// destructure path that skipped this check would compile an illegal
// assignment that then RefDecs an uninitialized slot at runtime (SIGBUS on
// LLVM).  (`readonly @[]int` is a const managed-slice binding — distinct from
// `@(readonly ...)`, whose pointer is rebindable.)

func makeSlice() (readonly @[]int, int) {
	return make_slice(int, 3), 5
}

func main() {
	var x readonly @[]int
	var n int
	x, n = makeSlice()
	testing.Println(len(x))
	testing.Println(n)
}
