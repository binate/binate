package "main"

// A multi-return destructure must reject a `readonly @T` (const) LHS the same
// way a direct `x = ...` does — assigning to a const-typed LOCATION.  The
// destructure path formerly skipped this check, compiling an illegal
// assignment that then RefDec'd an uninitialized slot at runtime (SIGBUS on
// LLVM).  (`readonly @[]int` is a const managed-slice binding — distinct from
// `@(readonly ...)`, whose pointer is rebindable.)  See claude-todo #114.

func makeSlice() (readonly @[]int, int) {
	return make_slice(int, 3), 5
}

func main() {
	var x readonly @[]int
	var n int
	x, n = makeSlice()
	println(len(x))
	println(n)
}
