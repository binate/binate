package "main"
import "pkg/builtins/testing"

// Plain-scalar multi-returns of 3 and 4 GP words crossing the native<->LLVM
// boundary (pkg/mrw is LLVM-compiled, main native).  (int,int,int) is 3 GP
// words: aa64 returns it in X0,X1,X2 and x64 in RAX,RDX,RCX — in-register on
// both even though 24 bytes exceeds the 16-byte single-aggregate rule, because
// a first-class IR aggregate return is lowered field-per-register.
// (int,int,int,int) is 4 GP words: still in-register on aa64 (<= 8 GP return
// regs) but sret on x64 (> 3 GP return regs) — the native threshold must match
// the LLVM-compiled callee per arch.  Complements 526 (the iface aggregate
// field shape) and 683 (the float shapes).
import "pkg/mrw"

func main() {
	var a int
	var b int
	var c int
	a, b, c = mrw.Three()
	testing.Println(a) // 1
	testing.Println(b) // 2
	testing.Println(c) // 3

	var w int
	var x int
	var y int
	var z int
	w, x, y, z = mrw.Four()
	testing.Println(w) // 10
	testing.Println(x) // 20
	testing.Println(y) // 30
	testing.Println(z) // 40
}
