package "main"

// Closure with MIXED GP/FP captures AND params plus a float return — exercises
// the float-aware closure shim's independent NGRN/NSRN interleaving that the
// all-float 569 doesn't: an int capture (base -> X0/RDI) alongside a float
// capture (scale -> D0/XMM0), and an int param (n -> X1/RSI) alongside a float
// param (x -> D1/XMM1), with the float64 result fmov'd back to x0/rax.  See
// claude-todo #121.

func makeAdder(base int, scale float64) @func(int, float64) float64 {
	return func(n int, x float64) float64 {
		return cast(float64, base + n) * scale + x
	}
}

func main() {
	var f @func(int, float64) float64 = makeAdder(10, 2.0)
	// (10 + 5) * 2.0 + 3.0 = 33.0
	println(cast(int, f(5, 3.0)))   // 33
}
