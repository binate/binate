package "main"

// Genuine-overflow func-value stack-spill — the cases whose user-arg
// words exceed a native backend's register budget but stay within the
// VM dispatch cap (7 user words), so they run on EVERY mode.
//
// Budgets: x64 scalar 5 / pack+sret 4; aa64 scalar 7 / pack+sret 6.  A
// 7-int-arg funcval therefore spills the x64 scalar shim AND both
// backends' pack/sret shims, while the aa64 scalar shim stays in-budget
// (covered by 698, which needs > 7 args and so xfails the VM).  Each
// callee lives in the main module, so cmd/bnc emits its shim NATIVELY —
// the spill path under test.

type P5 struct {
	a int
	b int
	c int
	d int
	e int
}

type P2 struct {
	x int
	y int
}

// Scalar return, 7 int args: x64 scalar spill (budget 5); aa64 in-budget.
func sum7(a int, b int, c int, d int, e int, f int, g int) int {
	return a + b + c + d + e + f + g
}

// Sret return (P5 = 40 B > 16): x64 + aa64 sret spill (budgets 4 / 6).
func sret7(a int, b int, c int, d int, e int, f int, g int) P5 {
	return P5{a: a, b: b, c: c, d: d, e: e + f + g}
}

// Pack return (P2 = 16 B, two words): x64 + aa64 pack spill (budgets 4 / 6).
func pack7(a int, b int, c int, d int, e int, f int, g int) P2 {
	return P2{x: a + b + c + d, y: e + f + g}
}

// Indirect-large arg in the spill: a managed-slice is 1 EFFECTIVE word
// (pointer), so this is 6 effective words — past the x64 sret budget (4)
// — exercising an indirect-large arg marshalled through the spill.
func sretSlice(s @[]int, a int, b int, c int, d int, e int) P5 {
	return P5{a: len(s), b: a, c: b, d: c, e: d + e}
}

func main() {
	var fs *func(int, int, int, int, int, int, int) int = sum7
	println(fs(1, 2, 3, 4, 5, 6, 7))                  // 28

	var fr *func(int, int, int, int, int, int, int) P5 = sret7
	var r P5 = fr(1, 2, 3, 4, 5, 6, 7)
	println(r.a)                                      // 1
	println(r.e)                                      // 18

	var fp *func(int, int, int, int, int, int, int) P2 = pack7
	var p P2 = fp(10, 20, 30, 40, 5, 6, 7)
	println(p.x)                                      // 100
	println(p.y)                                      // 18

	var fss *func(@[]int, int, int, int, int, int) P5 = sretSlice
	var s P5 = fss(@[]int{9, 9, 9}, 1, 2, 3, 4, 5)
	println(s.a)                                      // 3
	println(s.e)                                      // 9
}
