package "main"

// Float-component multi-returns of 3 and 4 FP fields crossing the
// native<->LLVM boundary (pkg/mrf3 is LLVM-compiled, main native).  On aa64
// these are HFAs returned in D0,D1,D2(,D3) — in-register even though 24/32
// bytes exceeds the 16-byte single-aggregate rule, per the register-count
// rule (up to 8 FP return regs).  xfailed on native x64: a 3rd/4th float
// spills to x87 (ST0/ST1) on the LLVM-compiled callee, which the native x64
// backend can't emit, so it srets — the open x87 cross-package residual gap.
// Complements 683 (2-field float) and 696 (GP words).
import "pkg/mrf3"

func main() {
	var a float64
	var b float64
	var c float64
	a, b, c = mrf3.F3()
	println(cast(int, a * 2.0)) // 3
	println(cast(int, b * 2.0)) // 5
	println(cast(int, c * 2.0)) // 7

	var w float64
	var x float64
	var y float64
	var z float64
	w, x, y, z = mrf3.F4()
	println(cast(int, w * 2.0)) // 9
	println(cast(int, x * 2.0)) // 11
	println(cast(int, y * 2.0)) // 13
	println(cast(int, z * 2.0)) // 15
}
