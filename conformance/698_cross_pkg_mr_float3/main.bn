package "main"
import "pkg/builtins/testing"

// Float-component multi-returns of 3 and 4 FP fields crossing the
// native<->LLVM boundary (pkg/mrf3 is LLVM-compiled, main native).  On aa64
// these are HFAs returned in D0,D1,D2(,D3) — in-register even though 24/32
// bytes exceeds the 16-byte single-aggregate rule, per the register-count
// rule (up to 8 FP return regs).  On native x64 the 1st/2nd float come back
// in XMM0/XMM1 and the 3rd/4th in x87 ST0/ST1 (the SysV first-class-aggregate
// return lowering); the native x64 pack/collect emits FLD/FSTP for those
// slots so it agrees with the LLVM-compiled callee.  Complements 683 (2-field
// float, no x87) and 696 (GP words).
import "pkg/mrf3"

func main() {
	var a float64
	var b float64
	var c float64
	a, b, c = mrf3.F3()
	testing.Println(cast(int, a * 2.0)) // 3
	testing.Println(cast(int, b * 2.0)) // 5
	testing.Println(cast(int, c * 2.0)) // 7

	var w float64
	var x float64
	var y float64
	var z float64
	w, x, y, z = mrf3.F4()
	testing.Println(cast(int, w * 2.0)) // 9
	testing.Println(cast(int, x * 2.0)) // 11
	testing.Println(cast(int, y * 2.0)) // 13
	testing.Println(cast(int, z * 2.0)) // 15
}
