package "main"

// Closure-float native shim, float32 path (claude-todo #121): a float32 capture,
// a float32 param, and a float32 return all take the FloatScalarIsI32 branch
// (32-bit load + Fmov_w_to_s / Movd_gp_to_xmm), distinct from the float64 path
// that 569/697 cover.

func mkScale32(factor float32) @func(float32) float32 {
	return func(x float32) float32 { return x * factor }
}

func main() {
	var s @func(float32) float32 = mkScale32(2.5)
	println(cast(int, s(4.0)))
}
