package "main"

// Closure-float native shim, VOID return (claude-todo #121): a closure with a
// float64 param but no result.  The shim marshals the FP param but emits no
// float-return move (shimReturnIsFloatScalar is false).  Captures @Box so it is
// a genuine closure that mutates captured state across calls.

type Box struct {
	v int
}

func mkAdder(b @Box) @func(float64) {
	return func(x float64) { b.v = b.v + cast(int, x) }
}

func main() {
	var b @Box = make(Box)
	var f @func(float64) = mkAdder(b)
	f(3.0)
	f(4.0)
	println(b.v)
}
