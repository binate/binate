package "main"
import "pkg/builtins/testing"

// Closure-float native shim, indirect-large capture interleaved with a float
// param (claude-todo #121): a managed-slice capture (>16B → passed by pointer,
// one GP/NGRN slot) sits ahead of a float64 param (one FP/NSRN slot), so the
// shim must advance NGRN and NSRN independently in a single closure.

func mkScaler(xs @[]int) @func(float64) float64 {
	return func(scale float64) float64 {
		var sum int = 0
		for i := 0; i < len(xs); i++ {
			sum = sum + xs[i]
		}
		return cast(float64, sum) * scale
	}
}

func main() {
	var xs @[]int = make_slice(int, 3)
	xs[0] = 1
	xs[1] = 2
	xs[2] = 3
	var f @func(float64) float64 = mkScaler(xs)
	testing.Println(cast(int, f(2.0)))
}
