package "main"

// Closure-float native shim, multiple GP captures before a float param
// (claude-todo #121): three scalar int captures advance NGRN past 1 before the
// float64 param claims an NSRN slot — the ngrn>=2-with-nsrn ordering that the
// single-capture 569/697 don't reach.

func mk(a int, b int, c int) @func(float64) float64 {
	return func(x float64) float64 { return cast(float64, a + b + c) * x }
}

func main() {
	var f @func(float64) float64 = mk(1, 2, 3)
	println(cast(int, f(10.0)))
}
