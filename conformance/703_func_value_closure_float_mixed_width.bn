package "main"
import "pkg/builtins/testing"

// Closure-float native shim, mixed float widths (claude-todo #121): a float32
// capture, a float64 param, and a float32 return each claim one NSRN slot but
// select their own width's load + Fmov, so the per-width branch is exercised
// within a single shim.

func mk(bias float32) @func(float64) float32 {
	return func(x float64) float32 { return cast(float32, x) + bias }
}

func main() {
	var f @func(float64) float32 = mk(1.5)
	testing.Println(cast(int, f(8.0)))
}
