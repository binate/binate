package "main"
import "pkg/builtins/testing"

// Closure-float native shim, transparent-wrapper peeling (claude-todo #121): a
// readonly float64 capture.  closureHasFloatParts / IsFloatScalarTyp must peel
// the readonly wrapper to detect the underlying float and load it into an FP
// register rather than treating it as a GP word.

func mk(factor readonly float64) @func(float64) float64 {
	return func(x float64) float64 { return x * factor }
}

func main() {
	var f @func(float64) float64 = mk(3.0)
	testing.Println(cast(int, f(4.0)))
}
