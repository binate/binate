package "main"

// A capturing float closure with a SMALL (in-register) MULTI-RETURN result.
// The lifted body packs the tuple field-per-class — the float field in XMM0/D0,
// the int field in RAX/X0 — and the native float closure shim leaves that
// packing untouched (the single-scalar fixup is gated out for len != 1), so the
// dispatch caller's collectMultiReturnTuple / collectMultiReturnFields reads
// each field from its class register.  Check BOTH fields so the FP result
// placement is exercised, not just the GP one.  (A BIG/sret float multi-return
// is still SetError'd; LLVM and the VM handle every shape.)

func makePair(f float64) @func(float64) (float64, int) {
	return func(x float64) (float64, int) {
		return x * f, 42
	}
}

func main() {
	var f @func(float64) (float64, int) = makePair(2.0)
	var r float64
	var i int
	r, i = f(3.0)
	println(cast(int, r)) // 6  (the FLOAT field, returned in XMM0 / D0)
	println(i)            // 42 (the INT field, returned in RAX / X0)
}
