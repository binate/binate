package "main"

// A capturing float closure with a SMALL (in-register) MULTI-RETURN result.
// Under retbuf-for-any-multi-return, the caller passes a retbuf and does NOT
// collect from return registers.  Because the closure has float captures, its
// vtable.call shim routes this small (float64, int) multi-return to the float
// aggregate shim, which reads the float field from XMM0/D0 and the int field from
// RAX/X0 and stores BOTH field-per-class THROUGH the retbuf; the caller then reads
// the tuple from its spill slot.  Check BOTH fields so the FP result placement is
// exercised, not just the GP one.  (A BIG/sret float multi-return is still
// SetError'd; LLVM and the VM handle every shape.)

func makePair(f float64) @func(float64) (float64, int) {
	return func(x float64) (float64, int) {
		return x * f, 42
	}
}

func main() {
	var f @func(float64) (float64, int) = makePair(2.0)
	var r float64
	var i int
	r, i = f(3.0)
	println(cast(int, r)) // 6  (the FLOAT field, returned in XMM0 / D0)
	println(i)            // 42 (the INT field, returned in RAX / X0)
}
