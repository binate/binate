package "main"

// Closure-float native-shim BOUNDED GAP (claude-todo #121): a float closure with
// a MULTI-RETURN result.  The native aa64/x64 shims SetError here (field-per-
// register multi-return packing combined with FP-arg marshalling isn't
// implemented yet), so this is a positive test that is xfailed on the native
// modes; LLVM and the VM handle it and produce the expected output.

func makePair(f float64) @func(float64) (float64, int) {
	return func(x float64) (float64, int) {
		return x * f, 42
	}
}

func main() {
	var f @func(float64) (float64, int) = makePair(2.0)
	var r float64
	var i int
	r, i = f(3.0)
	println(i)
}
