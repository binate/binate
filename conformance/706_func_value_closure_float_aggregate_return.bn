package "main"
import "pkg/builtins/testing"

// A float closure that returns an AGGREGATE (a struct of floats) — the pack
// shape (≤ 16 bytes) of the native float-aware aggregate closure shim
// (claude-todo #121's 706).  The float capture + float param are marshalled
// into the FP registers, while the single-aggregate result is packed all-GP
// (RAX:RDX / X0:X1, regardless of field class) and copied through the retbuf.
// Pairs with 883 (the > 16-byte sret shape) and 884 (mixed GP/float captures +
// params, float32); LLVM and the VM handle it too.

type Pair struct {
	x float64
	y float64
}

func makePairStruct(f float64) @func(float64) Pair {
	return func(x float64) Pair {
		return Pair{x * f, x + f}
	}
}

func main() {
	var fn @func(float64) Pair = makePairStruct(2.0)
	var p Pair = fn(3.0)
	testing.Println(cast(int, p.x))
}
