package "main"

// Closure-float native-shim BOUNDED GAP (claude-todo #121): a float closure that
// returns an AGGREGATE (a struct of floats).  The native aa64/x64 shims SetError
// here (aggregate-return packing combined with FP-arg marshalling isn't
// implemented yet), so this is a positive test that is xfailed on the native
// modes; LLVM and the VM handle it.

type Pair struct {
	x float64
	y float64
}

func makePairStruct(f float64) @func(float64) Pair {
	return func(x float64) Pair {
		return Pair{x * f, x + f}
	}
}

func main() {
	var fn @func(float64) Pair = makePairStruct(2.0)
	var p Pair = fn(3.0)
	println(cast(int, p.x))
}
