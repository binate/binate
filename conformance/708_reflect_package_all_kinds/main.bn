package "main"

import "pkg/userpkg"
import "pkg/builtins/rt"
import "pkg/builtins/reflect"
import "pkg/builtins/lang"
import "pkg/bootstrap"

// Every compiled package gets a compiler-synthesized __Package() accessor
// returning its immortal static-managed reflect.Package descriptor;
// __Package() is never declared in any .bni.
// 532 pins this for one builtin (rt); this pins that the synthesis fires for
// EVERY package kind -- a user-defined package and all four tier-0 builtins --
// and that each descriptor's Name is the package's import path.  (A stdlib
// package would exercise the same non-builtin path as userpkg, but conformance
// tests may not import stdlib.)  The returned @reflect.Package drops at
// end-of-statement, exercising the negative-refcount (STATIC_REFCOUNT) sentinel
// RefDec-is-a-no-op path per package.
func main() {
	println(userpkg.__Package().Name)
	println(rt.__Package().Name)
	println(reflect.__Package().Name)
	println(lang.__Package().Name)
	println(bootstrap.__Package().Name)
}
