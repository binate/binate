package "main"

import "pkg/builtins/reflect"

// _Package() must be callable UNQUALIFIED (the current package's own accessor),
// like a normal exported function in each package.  Compiled-mode support;
// the bytecode VM still only reaches the builtins' _Package (deferred VM-backend
// project), so this is xfailed on the VM modes, same as 708.
//
// reflect is imported explicitly so the type checker can synthesize the
// `() @reflect.Package` accessor signature under cmd/bni too (the VM's driver
// does not force-load reflect the way cmd/bnc does); without it the VM would
// fail at the checker rather than reaching the runtime extern-not-found gap
// the xfails document.  cmd/bnc force-loads reflect, so the import is harmless
// (already-loaded) for the compiled modes.
func main() {
	println(_Package().Name)
}
