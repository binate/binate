package "main"

// __Package() must be callable UNQUALIFIED (the current package's own accessor),
// like a normal exported function in each package.  Works in compiled mode (the
// LLVM/native accessor) and under the bytecode VM, which emits a per-package
// bytecode __Package() + immortal reflect.Package descriptor
// (pkg/binate/vm/lower_pkg_descriptor.bn).
//
// No `import "pkg/builtins/reflect"` is needed even though __Package() returns
// @reflect.Package: every driver (cmd/bnc, cmd/bni, the REPL) force-loads
// reflect, so the compiler-synthesized `() @reflect.Package` accessor signature
// resolves regardless of user imports.
func main() {
	println(__Package().Name)
}
