package "main"

// A function-value local with an INFERRED type (`var f = <func value>`, no
// @func/*func annotation) must lower its call indirectly, exactly like an
// explicitly-typed one.  IR-gen used to leave the inferred slot at the int
// default, so `f(...)` mis-lowered to a DIRECT call to a symbol named after the
// variable (`main.f`) — an undefined symbol on every backend.  Covers an
// inferred func value returned from a factory, an inferred closure literal, and
// an inferred float closure (ties back to the closure-float work, #121).

func adder(base int) @func(int) int {
	return func(x int) int { return base + x }
}

func scaler(factor float64) @func(float64) float64 {
	return func(x float64) float64 { return x * factor }
}

func main() {
	var f = adder(10)
	println(f(5))

	var cap int = 100
	var g = func(x int) int { return cap + x }
	println(g(5))

	var h = scaler(2.0)
	println(cast(int, h(3.0)))
}
