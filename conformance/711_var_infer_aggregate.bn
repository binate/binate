package "main"

// A composite-typed local with an INFERRED type (`var s = <expr>`) must take the
// initializer's own type as its storage slot, not the int default — otherwise a
// multi-word struct/slice value is stored into (and read back from) a too-small
// int slot (observed as an `extractvalue`/codegen error or wrong values).

type Point struct {
	x int
	y int
}

func makePoint(a int, b int) Point { return Point{a, b} }

func makeNums() @[]int {
	var s @[]int = make_slice(int, 3)
	s[0] = 7
	s[1] = 8
	s[2] = 9
	return s
}

func main() {
	var p = makePoint(3, 4)
	var s = makeNums()
	println(p.x + p.y)
	println(s[0] + s[1] + s[2])
}
