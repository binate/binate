package "main"
import "pkg/builtins/testing"

// An @func borrows to a *func parameter (managed -> raw, like @[]T -> *[]T):
// the two share an identical 2-word {vtable,data} layout, so the borrow is
// refcount-neutral — the *func borrows the @func owner's record (kept alive by
// the owner) and owns nothing.  Covers a named var, a fresh temp, and a 1000x
// loop (a refcount imbalance would diverge the count or crash the VM).

func mk(k int) @func(int) int { return func(x int) int { return x + k } }

func use(g *func(int) int) int { return g(100) }

func main() {
	var f @func(int) int = mk(7)
	testing.Println(use(f))
	testing.Println(use(mk(9)))
	var acc int = 0
	var i int = 0
	for i = 0; i < 1000; i = i + 1 {
		acc = acc + use(f)
	}
	testing.Println(acc)
}
