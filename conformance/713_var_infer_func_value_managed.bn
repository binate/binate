package "main"

// With @func as the inferred default, a func value bound to a local with no
// type annotation is managed and borrows down to *func — so `var/:= x =
// <funcval>; g(x)` works whether g takes *func OR @func (a *func default would
// fit only *func).  Covers an inferred closure literal, an inferred bare func
// reference (both `var` and `:=`), and an inferred method value; all resolve
// to @func.

type Counter struct {
	n int
}

func (c @Counter) bump(d int) int { c.n = c.n + d; return c.n }

func add(a int, b int) int { return a + b }

func takesRaw(g *func(int) int) int { return g(10) }

func takesManaged(g @func(int) int) int { return g(20) }

func main() {
	var k int = 3
	var clo = func(x int) int { return x + k }
	println(takesRaw(clo))
	println(takesManaged(clo))

	var fn = add
	println(fn(4, 5))
	gn := add
	println(gn(6, 7))

	var c @Counter = make(Counter)
	var m = c.bump
	println(m(40))
	println(m(2))
}
