package "main"

// A local var that shadows a top-level function name must be loaded as the var
// in an inferred decl (`var x = add` / `y := add`), NOT mis-synthesized as an
// @func reference to the shadowed function — the inferred bare-func-ref decay
// only applies when no same-named var is in scope.

func add(a int, b int) int { return a + b }

func main() {
	var add int = 5
	var x = add
	y := add
	println(x + y)
}
