package "main"

// Comprehensive native-x64 x87 multi-return coverage (companion to 698, which
// only does single float64 calls).  A multi-return with >2 float fields returns
// its 3rd/4th component in x87 ST0/ST1 on SysV; the native pack/collect emits
// FLD/FSTP for those slots.  This pins the paths 698 leaves untested:
//   - FLDS/FSTPS — float32 components in x87 (F32x3: 1 slot; F32x4: 2 slots);
//   - mixed GP + x87 with independent counters (IF3: int in RAX, 3 float64 in
//     XMM0,XMM1 + x87 ST0);
//   - x87-stack balance under repetition — the 8-deep x87 stack overflows /
//     underflows within a few calls if any FLD lacks its matching FSTP, which a
//     single call cannot surface.
// On aa64 these are HFAs in D0..D3 / S0..S3 (no x87); on LLVM/VM, ordinary
// returns — every lane must print the same values.
import "pkg/mrx87"

func main() {
	// float32 x3: XMM0, XMM1, x87 ST0 (FLDS).
	var a float32
	var b float32
	var c float32
	a, b, c = mrx87.F32x3()
	println(cast(int, a)) // 3
	println(cast(int, b)) // 5
	println(cast(int, c)) // 7

	// float32 x4: XMM0, XMM1, x87 ST0, ST1 (FLDS x2 / FSTPS x2).
	var p float32
	var q float32
	var r float32
	var t float32
	p, q, r, t = mrx87.F32x4()
	println(cast(int, p)) // 9
	println(cast(int, q)) // 11
	println(cast(int, r)) // 13
	println(cast(int, t)) // 15

	// Mixed: int in RAX, three float64 in XMM0, XMM1, x87 ST0 — the GP and
	// FP/x87 counters advance independently.
	var n int
	var x float64
	var y float64
	var z float64
	n, x, y, z = mrx87.IF3()
	println(n)            // 100
	println(cast(int, x)) // 2
	println(cast(int, y)) // 4
	println(cast(int, z)) // 6

	// Stack-balance stress: F4 (2 x87 slots) + F3 (1 x87 slot) per iteration.
	// 40 * ((4.5+5.5+6.5+7.5) + (1.5+2.5+3.5)) = 40 * (24 + 7.5) = 1260.
	var sum float64 = 0.0
	for i := 0; i < 40; i++ {
		var f0 float64
		var f1 float64
		var f2 float64
		var f3 float64
		f0, f1, f2, f3 = mrx87.F4()
		var g0 float64
		var g1 float64
		var g2 float64
		g0, g1, g2 = mrx87.F3()
		sum = sum + f0 + f1 + f2 + f3 + g0 + g1 + g2
	}
	println(cast(int, sum)) // 1260
}
