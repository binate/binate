package "pkg/mrx87"

// Multi-returns whose float components overflow the 2 XMM return registers
// into x87 ST0/ST1 on native x64 (the SysV first-class-aggregate lowering).
// F3/F4: float64 (FLDL/FSTPL).  F32x3/F32x4: float32 (FLDS/FSTPS).  IF3: an
// int leaf (RAX) ahead of three float64 — the GP and FP/x87 counters advance
// independently.  Exercised cross-package (LLVM-compiled) from a native main.
func F3() (float64, float64, float64)
func F4() (float64, float64, float64, float64)
func F32x3() (float32, float32, float32)
func F32x4() (float32, float32, float32, float32)
func IF3() (int, float64, float64, float64)
