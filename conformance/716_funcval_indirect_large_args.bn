package "main"

// Function-value args whose raw-ArgWords expansion exceeds the native shim's
// register budget but whose EFFECTIVE words fit (an indirect-large aggregate
// — managed-slice / >16-byte struct — is passed as a SINGLE pointer, 1 word,
// matching the dispatch caller and the underlying ABI).  Pins: (a) effective-
// words counting (the native x64 shim SetError'd `twoSlices` / `packRet`
// before); (b) correct marshalling of an indirect-large arg NOT in last
// position (`sliceThenScalar`, `structThenScalar`); (c) the sret shape with
// indirect-large args (`packRet`).

type P3 struct {
	a int
	b int
	c int
}

func twoSlices(a @[]int, b @[]int) int {
	return len(a) * 100 + len(b)
}

func sliceThenScalar(s @[]int, n int) int {
	return len(s) * 10 + n
}

func structThenScalar(p P3, n int) int {
	return p.a + p.c + n
}

func packRet(p P3, s @[]int) P3 {
	return P3{a: p.a, b: len(s), c: p.c}
}

func main() {
	var f1 *func(@[]int, @[]int) int = twoSlices
	println(f1(@[]int{1, 2, 3}, @[]int{4, 5}))        // 302

	var f2 *func(@[]int, int) int = sliceThenScalar
	println(f2(@[]int{1, 2, 3, 4}, 7))                // 47

	var f3 *func(P3, int) int = structThenScalar
	println(f3(P3{a: 1, b: 2, c: 3}, 100))            // 104

	var f4 *func(P3, @[]int) P3 = packRet
	var r P3 = f4(P3{a: 5, b: 0, c: 9}, @[]int{1, 2, 3})
	println(r.a)                                      // 5
	println(r.b)                                      // 3
	println(r.c)                                      // 9
}
