package "main"
import "pkg/builtins/testing"

// Genuine-overflow func-value stack-spill — the cases needing MORE than 7
// user-arg words, which exceed the bytecode-VM dispatch cap
// (rt._call_shim_scalar takes data + a0..a6 = 7 user words) and so xfail
// the three VM modes.  On the native lanes they exercise:
//   * the aa64 SCALAR spill (budget 7 — needs > 7 args; the confirmed
//     9-int repro that previously returned 43 instead of 45),
//   * the float-scalar RETURN spill (BL + fmov d0 -> x0 after the frame),
//   * the float-scalar ARG spill (a float arg marshalled GP -> FP from a
//     spilled / high dispatch slot).
// Each callee is in the main module, so cmd/bnc emits its shim natively.

func sum9(a int, b int, c int, d int, e int, f int, g int, h int,
		i int) int {
	return a + b + c + d + e + f + g + h + i
}

// Float-scalar return with 8 int args (> aa64 scalar budget 7): the shim
// builds a frame, marshals 8 words (one spilled), BLs, and fmov's d0 -> x0.
func fret8(a int, b int, c int, d int, e int, f int, g int,
		h int) float64 {
	return cast(float64, a + b + c + d + e + f + g + h)
}

// Float-scalar ARGS (the last two of 8 user words) returning int: the two
// floats marshal GP -> d0/d1 from their spilled dispatch slots.
func mix8(a int, b int, c int, d int, e int, f int, x float64,
		y float64) int {
	return a + b + c + d + e + f + cast(int, x) + cast(int, y)
}

type S16 struct {
	a int
	b int
}

// A 16-byte struct ARG after 7 int args: 9 user words.  On aa64 the
// struct SPLITs (word 0 in X7, word 1 on the stack — AAPCS64
// SplitAggregates); on x64 the whole 2-word aggregate goes to the
// outgoing-args stack (SysV MEMORY).  Exercises the spill's struct-arg
// marshalling (incoming words arrive on the dispatch caller's stack).
func splitArg(a int, b int, c int, d int, e int, f int, g int,
		p S16) int {
	return a + b + c + d + e + f + g + p.a + p.b
}

func main() {
	var f9 *func(int, int, int, int, int, int, int, int, int) int = sum9
	testing.Println(f9(1, 2, 3, 4, 5, 6, 7, 8, 9))            // 45

	var fr *func(int, int, int, int, int, int, int, int) float64 = fret8
	testing.Println(cast(int, fr(1, 2, 3, 4, 5, 6, 7, 8)))    // 36

	var fm *func(int, int, int, int, int, int, float64, float64) int = mix8
	testing.Println(fm(1, 2, 3, 4, 5, 6, 7.0, 8.0))           // 36

	var fsa *func(int, int, int, int, int, int, int, S16) int = splitArg
	testing.Println(fsa(1, 2, 3, 4, 5, 6, 7, S16{a: 8, b: 9}))  // 45
}
