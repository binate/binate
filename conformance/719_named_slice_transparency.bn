package "main"

// Named-distinct type transparency (Increment 1): a named-distinct type
// (`type Buf @[]int`) is transparent to its underlying for slice OPERATIONS
// (index, slice, `len`) and follows Go's assignability rule — an unnamed
// composite value crosses the named boundary without a cast (and vice-versa).
// Field-access transparency is a separate increment and not exercised here.

type Buf @[]int

// takesBuf accepts a `Buf`; calling it with an unnamed `@[]int` argument
// exercises unnamed→named assignability at a call site.
func takesBuf(b Buf) int {
	return len(b)
}

func main() {
	// assign unnamed→named: make_slice yields @[]int, stored into a Buf slot.
	var b Buf = make_slice(int, 4)

	// index write+read through the named type.
	b[0] = 10
	b[1] = 20
	b[2] = 30
	b[3] = 40
	println(b[0])              // 10
	println(b[2])              // 30

	// len() on the named slice.
	println(len(b))            // 4

	// subslice of the named slice.
	var sub @[]int = b[1:3]
	println(len(sub))          // 2
	println(sub[0])            // 20
	println(sub[1])            // 30

	// assign named→unnamed: a Buf flows into an @[]int variable.
	var s @[]int = b
	println(s[3])              // 40

	// pass unnamed @[]int to a Buf parameter.
	var raw @[]int = make_slice(int, 6)
	println(takesBuf(raw))     // 6
}
