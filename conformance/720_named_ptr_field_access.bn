package "main"

// A named-distinct type over a POINTER to a struct is transparent to its
// underlying for FIELD ACCESS (INCREMENT 2 of named-distinct transparency
// — claude-notes.md "Type declarations").  `type H @Box; h.field`
// reads/writes Box's field with the same auto-deref a bare `@Box` gets;
// `type P *Box; p.field` likewise.  Methods are NOT inherited (not
// exercised here — this is the field-access facet).  Companion to
// 660_alias_field_read (alias wrappers) and 127_named_type_struct_field
// (named struct VALUE fields); this pins the named-over-pointer case the
// 660 test explicitly leaves out.

type Box struct {
	x int
	y int
}

type H @Box   // named-distinct over a managed pointer-to-struct
type P *Box   // named-distinct over a raw pointer-to-struct

func main() {
	// Named-over-managed-pointer: read a field, write another, read back.
	var h H = make(Box)
	h.x = 11
	h.y = 22
	println(h.x)          // 11  field read through named @Box
	println(h.y)          // 22
	h.y = h.x + 100       // write through named @Box
	println(h.y)          // 111

	// Named-over-raw-pointer: borrow the same Box backing through a raw
	// *Box (h keeps it alive across the statements below), then wrap it in
	// the named-distinct P.  Writes through P are visible through h and
	// vice versa, since both refer to the one Box.
	var raw *Box = h
	var p P = raw
	println(p.x)          // 11  field read through named *Box
	p.x = 7               // write through named *Box
	println(h.x)          // 7   visible through the managed handle
	println(p.y)          // 111
}
