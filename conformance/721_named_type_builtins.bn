package "main"
import "pkg/builtins/testing"

// Named-distinct type transparency — the built-ins present/same and the
// operators/comparison on named SCALAR types see through the named wrapper
// (present/same via comparabilityKind; +/</== via IsInteger/comparabilityKind).
// Companion to 719 (slice index/slice/len + assignability) and 720 (field
// access): this pins present/same on a named slice + a named pointer, and
// arithmetic / relational / equality on a named int.

type Box struct { v int }
type Buf @[]int     // named over a managed slice
type HP @Box        // named over a managed pointer
type ID int         // named over a scalar

func main() {
	var b Buf = make_slice(int, 3)
	if present(b) { testing.Println(1) } else { testing.Println(0) }     // 1
	var empty Buf = make_slice(int, 0)
	if present(empty) { testing.Println(1) } else { testing.Println(0) } // 0
	var hp HP = make(Box)
	if present(hp) { testing.Println(1) } else { testing.Println(0) }    // 1
	var b2 Buf = b
	if same(b, b2) { testing.Println(1) } else { testing.Println(0) }    // 1
	var x ID = 5
	var y ID = 3
	testing.Println(cast(int, x + y))                            // 8
	if x < y { testing.Println(1) } else { testing.Println(0) }          // 0
	if x == 5 { testing.Println(1) } else { testing.Println(0) }         // 1
	var z ID = 5
	if x == z { testing.Println(1) } else { testing.Println(0) }         // 1
}
