package "main"

// A named-distinct SLICE type is NOT comparable — slices are never
// comparable in Binate (not even to nil); comparabilityKind peels the named
// wrapper to the slice kind, which the ==/!= rule rejects.  Pins the
// rejection so the transparency work can't accidentally make named slices
// comparable.

type Buf @[]int

func main() {
	var a Buf = make_slice(int, 1)
	var b Buf = make_slice(int, 1)
	if a == b { println(1) }
}
