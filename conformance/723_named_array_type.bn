package "main"

// Named fixed-array type — `type Row [3]int` must parse (grammar D11
// disambiguates the `[` after the name as an array size, not a generic
// type-param list) and behave as a distinct type over [3]int.  The
// named-array transparency (TYP_NAMED peels to TYP_ARRAY) lets index
// and len see through the wrapper.  Also pins a named-array function
// parameter (passed by copy, like a bare [N]int).  Companion to the
// parser unit test TestParseNamedArrayType.

type Row [3]int
type Mat [4]int

// sumMat reads a named-array parameter (by-copy) and mutates its own
// copy — the caller's array must be unaffected.
func sumMat(m Mat) int {
	var s int = 0
	for i := 0; i < len(m); i++ {
		s = s + m[i]
	}
	m[0] = 999 // local copy only
	return s
}

func main() {
	var r Row
	r[0] = 10
	r[1] = 20
	r[2] = 30
	println(r[0])    // 10
	println(r[1])    // 20
	println(r[2])    // 30
	println(len(r))  // 3

	var m Mat
	m[0] = 1
	m[1] = 2
	m[2] = 3
	m[3] = 4
	println(len(m))     // 4
	println(sumMat(m))  // 10
	println(m[0])       // 1 — caller's copy unchanged by sumMat

	// Slice a named array — genSliceExpr must peel the named wrapper too,
	// else it builds a zero-length / wrong-stride slice into r's backing.
	var sub *[]int = r[0:2]
	println(len(sub))   // 2
	println(sub[1])     // 20
}
