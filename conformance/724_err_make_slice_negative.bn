package "main"

// make_slice with a negative length is a programmer error (e.g. an
// integer-overflowed capacity); the runtime traps rather than silently
// producing a nil-backed, negative-length slice that corrupts on the next
// write.  The length is non-constant so const-fold can't intercept it.

func neg() int {
	return -1
}

func main() {
	var n int = neg()
	var s @[]int = make_slice(int, n)
	println(len(s))
}
