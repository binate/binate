package "main"

import "pkg/fns"
import "pkg/builtins/reflect"

// reflect.Package.Functions — the exported-function table (B0 step 3b of
// notes-package-introspection.md).  fns exports Add + Neg via its .bni; the
// compiler emits one FunctionInfo per export carrying the fully-qualified
// Name, the VM-dispatch ResultSize / ParamSlots, and the opaque Sig string.
// Iterating the dep's table exercises the POPULATED descriptor end-to-end —
// the LLVM emitter on the host modes (main native, dep via LLVM) and the
// native emitter on the native cross modes (whole program native).  ResultSize
// is the VM's cross-mode dispatch discriminator = types.AggregateReturnSize:
// 0 for a scalar/void return, else the retbuf byte size rounded to N*8.  It is
// therefore TARGET-DEPENDENT: an int64 result is a scalar on LP64 (0) but an
// aggregate on ILP32, where 8 > the 4-byte pointer (8) — hence the per-mode
// arm32 expected variants.  ParamSlots is the param COUNT (target-independent).
// xfailed on the bytecode-VM modes: the VM's _Package only reaches the four
// builtins (Gap 2, plan-package-introspection).
func main() {
	var p @reflect.Package = fns._Package()
	println(len(p.Functions))
	for i := 0; i < len(p.Functions); i++ {
		var fi @reflect.FunctionInfo = p.Functions[i]
		println(fi.Name)
		println(fi.ResultSize)
		println(fi.ParamSlots)
		println(fi.Sig)
	}
}
