package "main"

import "pkg/fns"
import "pkg/builtins/reflect"

// reflect.Package.Functions — the exported-function table.  fns exports Add + Neg via its
// .bni; the
// compiler emits one FunctionInfo per export carrying the fully-qualified
// Name, the VM-dispatch RetbufSize / ParamSlots, and the opaque Sig string.
// Iterating the dep's table exercises the POPULATED descriptor end-to-end —
// the LLVM emitter on the host modes (main native, dep via LLVM) and the
// native emitter on the native cross modes (whole program native).  RetbufSize
// is the VM's cross-mode dispatch discriminator = types.AggregateReturnSize:
// 0 for a scalar/void return, else the retbuf byte size rounded to N*8.  A single
// int64 result is a register-PAIR return, NOT a retbuf aggregate — the aggregate-
// KIND gate in IsAggregateReturn keeps a 64-bit scalar off the sret path — so its
// RetbufSize is 0 on BOTH LP64 and ILP32 (target-independent; no per-mode expected
// variants).  ParamSlots is the param COUNT (target-independent).
// xfailed on the bytecode-VM modes: the VM's __Package only reaches the four
// builtins.
func main() {
	var p @reflect.Package = fns.__Package()
	println(len(p.Functions))
	for i := 0; i < len(p.Functions); i++ {
		var fi @reflect.FunctionInfo = p.Functions[i]
		println(fi.Name)
		println(fi.RetbufSize)
		println(fi.ParamSlots)
		println(fi.Sig)
	}
}
