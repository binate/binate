package "main"

// Cross-package use of an interface impl declared in a .bni.  strings.Builder
// declares `impl *Builder : io.Writer, io.ByteWriter` in strings.bni; here a
// DIFFERENT package (main) assigns an @strings.Builder to an @io.Writer and an
// @io.ByteWriter and writes through the interfaces.  This needs the impl to be
// visible to main's type checker (assignability) AND its IR-gen (the dispatch
// vtable) — both read the imported package's merged file, into which the loader
// now folds .bni impl decls.  Before that, a .bni-only impl was invisible
// across packages: the explicit-interface feature was non-functional
// cross-package (no public type usable as the interface it implements).
import "pkg/std/strings"
import "pkg/std/io"
import "pkg/std/errors"

func main() {
	var b @strings.Builder = strings.NewBuilder()

	// Use the Builder THROUGH io.Writer (impl lives in strings, used here).
	var w @io.Writer = b
	var n int
	var werr @errors.Error
	n, werr = w.Write("hello")
	println(n)                               // 5
	if present(werr) { println(1) } else { println(0) } // 0

	// Use the SAME Builder THROUGH io.ByteWriter.
	var bw @io.ByteWriter = b
	var berr @errors.Error
	berr = bw.WriteByte(cast(uint8, 33))     // '!'
	if present(berr) { println(1) } else { println(0) } // 0

	// Both writes landed in the one Builder.
	println(b.Len())                         // 6
}
