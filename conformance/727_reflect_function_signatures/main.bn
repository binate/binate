package "main"

import "pkg/sigs"
import "pkg/builtins/reflect"

// reflect.Package.Functions across DIVERSE signatures (725 covers only single-
// int64-return funcs).  Validates the load-bearing ResultSize -- the VM's
// scalar(<=8) vs aggregate-retbuf(>8) discriminator -- for a MULTI-RETURN tuple
// (16), and ParamSlots for a WIDE (spill-shaped, 7-param) signature, plus a
// float param/return.  All int64/float64 so the sizes are target-independent.
// Function order = sigs.bn declaration order.  xfailed on the VM modes
// (Gap 2: the bytecode VM's _Package only reaches the four builtins).
func main() {
	var p @reflect.Package = sigs._Package()
	println(len(p.Functions))
	for i := 0; i < len(p.Functions); i++ {
		var fi @reflect.FunctionInfo = p.Functions[i]
		println(fi.ResultSize)
		println(fi.ParamSlots)
	}
}
