package "main"

import "pkg/sigs"
import "pkg/builtins/reflect"

// reflect.Package.Functions across DIVERSE signatures (725 covers only single-
// int64-return funcs).  Validates the load-bearing RetbufSize -- the VM's
// cross-mode dispatch discriminator = types.AggregateReturnSize (0 for a
// scalar/void return, else the retbuf byte size rounded to N*8) -- for a
// MULTI-RETURN tuple (always aggregate -> 16) and ParamSlots for a WIDE
// (spill-shaped, 7-param) signature, plus a float param/return.  RetbufSize is
// TARGET-DEPENDENT: a single int64/float64 return is scalar on LP64 (0) but
// aggregate on ILP32 (8 > the 4-byte pointer -> 8); the multi-return is 16 on
// both -- hence the per-mode arm32 expected variants.  Function order = sigs.bn
// declaration order.  xfailed on the VM modes (Gap 2: the bytecode VM's
// _Package only reaches the four builtins).
func main() {
	var p @reflect.Package = sigs._Package()
	println(len(p.Functions))
	for i := 0; i < len(p.Functions); i++ {
		var fi @reflect.FunctionInfo = p.Functions[i]
		println(fi.RetbufSize)
		println(fi.ParamSlots)
	}
}
