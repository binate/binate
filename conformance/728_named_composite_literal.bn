package "main"
import "pkg/builtins/testing"

// A composite literal written with a NAMED-DISTINCT type name must keep its
// initializers — it lowers through the SAME path as its unnamed underlying
// form, peeling the named wrapper to dispatch on the real kind (array /
// struct / managed-slice).  Before the peel, IR-gen dispatched on the
// syntactic TypeRef kind: a named wrapper's TypeRef is TEXPR_NAMED, so it
// fell to the struct branch, lookupStructIdx missed the non-struct wrapper,
// and the literal silently collapsed to a constant 0 (every element dropped).
//
// The literal must also work in RETURN position and as a CALL ARGUMENT, not
// only var-decl / global init.  genReturnStmt tested the DECLARED result
// type's kind directly to decide whether to load the by-value aggregate out
// of its alloca; a named array/struct result has Kind TYP_NAMED, so the load
// was skipped and the alloca POINTER was returned where the array/struct
// value belonged (silent garbage).  Peeling the result type fixes it.

type Row [3]int

type S struct {
	a int
	b int
}

// A named-distinct type whose underlying is itself a (named) struct — the
// peel must reach S's field layout, not the NS wrapper's (which has none).
type NS S

type Buf @[]int

type Node struct {
	v int
}

// A named managed-slice whose ELEMENTS are themselves managed — exercises the
// element-dtor branch of the slice cleanup on the named-wrapper path (the slot
// must peel to @[]@Node so its `.Elem` drives per-element RefDec; a missed peel
// would leak every element).
type PBuf @[]@Node

// Package-level global initialized from a named-array literal — the case
// that read back 0 for every element before the fix.
var G Row = Row{10, 20, 30}

func sumBuf(b Buf) int {
	var total int = 0
	for i := 0; i < len(b); i++ {
		total = total + b[i]
	}
	return total
}

func sumRow(r Row) int {
	return r[0] + r[1] + r[2]
}

func sumNS(s NS) int {
	return s.a + s.b
}

// Named composite literals materialized in RETURN position — the by-value
// array/struct cases are what mis-returned the alloca pointer before the
// genReturnStmt result-type peel; the managed-slice case returns a fresh
// owned slice.
func retRow() Row {
	return Row{100, 200, 300}
}

func retNS() NS {
	return NS{5, 8}
}

func retBuf() Buf {
	return Buf{10, 20, 30}
}

func main() {
	// Named array literal, local.
	var r Row = Row{1, 2, 3}
	testing.Println(r[0] + r[1] + r[2])

	// Named array literal read from a package-level global.
	testing.Println(G[0] + G[1] + G[2])

	// Named struct literal (positional), local.
	var ns NS = NS{7, 9}
	testing.Println(ns.a + ns.b)

	// Named struct literal (keyed), local.
	var ns2 NS = NS{b: 40, a: 2}
	testing.Println(ns2.a + ns2.b)

	// Named managed-slice literal, local.
	var buf Buf = Buf{4, 5, 6, 7}
	testing.Println(len(buf))
	testing.Println(sumBuf(buf))

	// Named managed-slice with managed (refcounted) elements, local.
	var n @Node = make(Node)
	n.v = 11
	var pb PBuf = PBuf{n, n}
	testing.Println(pb[0].v + pb[1].v)

	// Named array literal returned BY VALUE.  Without peeling the named
	// result type in genReturnStmt, the alloca pointer was returned instead
	// of the array value, so these reads printed garbage.
	var rr Row = retRow()
	testing.Println(rr[0] + rr[1] + rr[2])

	// Named struct literal returned by value.
	var rns NS = retNS()
	testing.Println(rns.a + rns.b)

	// Named managed-slice literal returned by value (fresh owned slice).
	var rbuf Buf = retBuf()
	testing.Println(len(rbuf))
	testing.Println(sumBuf(rbuf))

	// Named composite literals passed DIRECTLY as call arguments.
	testing.Println(sumRow(Row{1, 2, 3}))
	testing.Println(sumNS(NS{3, 4}))
	testing.Println(sumBuf(Buf{1, 2, 3, 4}))
}
