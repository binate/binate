package "main"

// A shift by a CONSTANT count >= the value's bit width is defined (claude-notes
// / Go): 0 for a logical `<<` / unsigned `>>`, sign-fill for a signed `>>` —
// NOT the hardware-masked (count & (W-1)) result.  Distinct from 631/659, which
// pass the count as a runtime VARIABLE: a CONSTANT count was truncated into
// range by ensureWidth before the overshift guard could see it, so e.g.
// `uint8 v << 256` shifted by 256 & 7 = 0 and wrongly left v unchanged (1, not
// 0).  Both the expression and compound (<<= / >>=) forms are exercised.

func main() {
	// logical <<: overshift -> 0
	var a uint8 = 1
	println(cast(int, a << 8))    // 0 (count == width)
	println(cast(int, a << 256))  // 0
	println(cast(int, a << 3))    // 8 (in-range control)
	var u uint16 = 1
	println(cast(int, u << 16))   // 0
	println(cast(int, u << 9999)) // 0

	// unsigned >>: overshift -> 0
	var b uint8 = 200
	println(cast(int, b >> 8))    // 0
	println(cast(int, b >> 2))    // 50 (in-range control)

	// signed >>: overshift -> sign-fill
	var s int8 = -64
	println(cast(int, s >> 8))    // -1 (sign-fill, negative)
	println(cast(int, s >> 256))  // -1
	var p int8 = 64
	println(cast(int, p >> 8))    // 0 (sign-fill of non-negative)
	println(cast(int, s >> 3))    // -8 (in-range control)

	// word-width (32-bit): a distinct backend path from the sub-word cases
	// above — the signed-overshift result `lhs >> (W-1)` is a word arithmetic
	// shift, not the (historically fragile) sub-word one.
	var w32 uint32 = 1
	println(cast(int, w32 << 32))   // 0
	var i32 int32 = -1000000
	println(cast(int, i32 >> 32))   // -1 (sign-fill, negative)
	var q32 int32 = 1000000
	println(cast(int, q32 >> 32))   // 0 (sign-fill of non-negative)

	// compound forms
	var c uint8 = 1
	c <<= 8
	println(cast(int, c))         // 0
	var d int8 = -64
	d >>= 8
	println(cast(int, d))         // -1
	var e uint16 = 7
	e <<= 16
	println(cast(int, e))         // 0
}
