package "main"
import "pkg/builtins/testing"

// Returning a managed-slice value where the declared result is a NAMED
// raw-slice type (`type RS *[]int`) must apply the @[]T -> *[]T conversion,
// peeling the named result wrapper before the kind test.  Without the peel,
// genReturnStmt left the value as a @[]T and emitted an invalid
// `ret %BnManagedSlice` against the %BnSlice result type (LLVM verifier
// error on otherwise-valid, checker-accepted code).  Covers BOTH the
// single-value return path and the `return f(...)` multi-return arm.
//
// `main`'s managed slice owns the backing for the whole program, so the raw
// views these functions return are valid borrows (no use-after-free).

type RS *[]int

// Single-value return: a borrowed @[]int param returned as a raw view.
func view(s @[]int) RS {
	return s
}

// Inner multi-return producing a managed slice; the outer relays it as a
// named raw-slice result, exercising the multi-return extract+convert arm.
func pair(s @[]int) (@[]int, int) {
	return s, 5
}

func relay(s @[]int) (RS, int) {
	return pair(s)
}

func main() {
	var m @[]int = make_slice(int, 3)
	m[0] = 10
	m[1] = 20
	m[2] = 30

	var rs RS = view(m)
	testing.Println(len(rs)) // 3
	testing.Println(rs[0])   // 10
	testing.Println(rs[2])   // 30

	var rs2 RS
	var n int
	rs2, n = relay(m)
	testing.Println(len(rs2)) // 3
	testing.Println(rs2[1])   // 20
	testing.Println(n)        // 5
}
