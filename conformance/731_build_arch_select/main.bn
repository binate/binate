package "main"
import "pkg/builtins/testing"

import "pkg/archsel"

// Verifies per-file build-constraint selection: pkg/archsel ships one GetArch
// per architecture, each file gated by a `#[build(is(arch, ...))]` on its
// package clause.  Exactly one survives for the active target, so the printed
// arch tracks the build's arch (aarch64 on the host; arm32 under the
// arm32-linux mode).  If gating were inactive, all three GetArch definitions
// would collide and the build would fail — so a clean run also proves the
// gate is active in this mode.
func main() {
	testing.Println(archsel.GetArch())
}
