package "main"
import "pkg/builtins/testing"

// float -> int saturation: an out-of-range,
// +/-Inf, or NaN float converted to an integer must SATURATE to the target
// type's [MIN, MAX] (NaN -> 0), not yield the per-ISA hardware result
// (arm64 saturates, x86-64 -> INT_MIN, an LLVM `fptosi` is poison).  Lowered
// ONCE in shared IR-gen (emitGuardedFloatToInt), so the LLVM backend, the
// native backends, and the bytecode VM all agree.
//
// Float PARAMETERS keep the casts out of the integer-only const evaluator, so
// the runtime lowering is exercised.  Targets are FIXED-width, so the expected
// values are identical on every target (a bare `int` would be 32- or 64-bit).

func i8v(f float64) int { return cast(int, cast(int8, f)) }
func u8v(f float64) int { return cast(int, cast(uint8, f)) }
func i16v(f float64) int { return cast(int, cast(int16, f)) }
func u16v(f float64) int { return cast(int, cast(uint16, f)) }
func i32v(f float64) int { return cast(int, cast(int32, f)) }
func u32v(f float64) int64 { return cast(int64, cast(uint32, f)) }
func i64v(f float64) int64 { return cast(int64, f) }
func u64v(f float64) uint64 { return cast(uint64, f) }

func i8f32(f float32) int { return cast(int, cast(int8, f)) }

func main() {
	// in-range truncation toward zero (unchanged)
	testing.Println(i8v(100.0))            // 100
	testing.Println(i8v(0.0 - 100.0))      // -100
	testing.Println(i8v(127.9))            // 127 (truncates into range)
	testing.Println(u8v(254.9))            // 254

	// signed saturation
	testing.Println(i8v(1000.0))           // 127
	testing.Println(i8v(0.0 - 1000.0))     // -128
	testing.Println(i16v(40000.0))         // 32767
	testing.Println(i16v(0.0 - 40000.0))   // -32768
	testing.Println(i32v(3000000000.0))    // 2147483647
	testing.Println(i32v(0.0 - 3000000000.0)) // -2147483648

	// unsigned saturation (negatives clamp to 0)
	testing.Println(u8v(300.0))            // 255
	testing.Println(u8v(0.0 - 5.0))        // 0
	testing.Println(u16v(70000.0))         // 65535
	testing.Println(u32v(5000000000.0))    // 4294967295
	testing.Println(u32v(0.0 - 1.0))       // 0

	// 64-bit extremes
	testing.Println(i64v(1.0e19))          // 9223372036854775807
	testing.Println(i64v(0.0 - 1.0e19))    // -9223372036854775808
	testing.Println(u64v(2.0e19))          // 18446744073709551615
	testing.Println(u64v(0.0 - 1.0))       // 0

	// +Inf / -Inf
	var big float64 = 1.0e308
	var inf float64 = big * 10.0
	testing.Println(i8v(inf))              // 127
	testing.Println(i8v(0.0 - inf))        // -128
	testing.Println(u8v(inf))              // 255
	testing.Println(i64v(inf))             // 9223372036854775807
	testing.Println(u64v(inf))             // 18446744073709551615

	// NaN -> 0
	var nan float64 = inf - inf
	testing.Println(i8v(nan))              // 0
	testing.Println(u8v(nan))              // 0
	testing.Println(i64v(nan))             // 0
	testing.Println(u64v(nan))             // 0

	// float32 source
	var big32 float32 = 1.0e38
	var inf32 float32 = big32 * big32
	var nan32 float32 = inf32 - inf32
	testing.Println(i8f32(1000.0))         // 127
	testing.Println(i8f32(inf32))          // 127
	testing.Println(i8f32(nan32))          // 0
}
