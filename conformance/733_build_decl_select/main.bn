package "main"

import "pkg/declsel"

// Verifies declaration-level build-constraint selection: pkg/declsel defines
// three same-named `Which` functions in ONE file, each gated by a per-decl
// `#[build(is(arch, ...))]`.  The loader's declaration gate keeps exactly the
// one matching the active arch; if it were inactive, the three definitions
// would collide and the build would fail — so a clean run also proves the
// per-declaration gate is active.
func main() {
	println(declsel.Which())
}
