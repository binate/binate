package "pkg/declsel"

// Three same-named definitions in one file, gated to disjoint archs by
// per-declaration build constraints.  Exactly one survives the loader's
// declaration gate for the active target.

#[build(is(arch, "aarch64"))]
func Which() *[]readonly char {
	return "decl-aarch64"
}

#[build(is(arch, "x64"))]
func Which() *[]readonly char {
	return "decl-x64"
}

#[build(is(arch, "arm32"))]
func Which() *[]readonly char {
	return "decl-arm32"
}
