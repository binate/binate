package "main"

// A managed value decays to a `readonly`-wrapped raw target the same way it
// decays to the bare raw target: `@[]T -> readonly *[]T` and `@T -> readonly
// *T`.  The checker's AssignableTo peels the readonly/alias wrapper off the
// destination before the managed->raw kind test (readonly is strictly more
// restrictive on capability and layout-transparent, so adding it is sound) —
// previously the unpeeled `dst.Kind` (TYP_READONLY) missed the decay arm and
// the assignment was rejected.  This also pins that the decay LOWERS correctly
// end to end (the raw value borrows the managed backing; reads see the data).

func main() {
	var ms @[]int = make_slice(int, 3)
	ms[0] = 10
	ms[1] = 20
	ms[2] = 30
	// @[]int -> readonly *[]int (borrow; reads go through the same backing).
	var rs readonly *[]int = ms
	println(rs[0] + rs[1] + rs[2])   // 60
	println(len(rs))                 // 3

	var mp @int = make(int)
	*mp = 42
	// @int -> readonly *int (borrow; deref reads the pointee).
	var rp readonly *int = mp
	println(*rp)                     // 42
}
