package "main"

import "pkg/kinds"

// Verifies the declaration-level build gate applies to declaration kinds
// beyond func: pkg/kinds selects between per-arch `const` and `var`
// definitions (using `is` and its negation).  If gating did not apply to
// const/var, the duplicate same-named definitions would collide.
func main() {
	println(kinds.Width())
	println(kinds.Label())
}
