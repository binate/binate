package "pkg/kinds"

// Per-arch const variants, gated at the declaration level.
#[build(is(arch, "arm32"))]
const W int = 32
#[build(!is(arch, "arm32"))]
const W int = 64

// Per-arch package-level var variants, likewise gated.
#[build(is(arch, "arm32"))]
var lbl *[]readonly char = "narrow"
#[build(!is(arch, "arm32"))]
var lbl *[]readonly char = "wide"

func Width() int {
	return W
}

func Label() *[]readonly char {
	return lbl
}
