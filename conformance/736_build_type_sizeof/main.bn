package "main"

import "pkg/wk"

// Verifies the declaration gate selects per-arch `type` and `func`
// definitions: pkg/wk's Word is uint8 on x64, uint16 on aarch64, uint32 on
// arm32 (so sizeof(Word) is 1 / 2 / 4), and Tag() returns the arch name.
// Both are chosen by declaration-level #[build(...)] constraints.
func main() {
	println(wk.WordSize())
	println(wk.Tag())
}
