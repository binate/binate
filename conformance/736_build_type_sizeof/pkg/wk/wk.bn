package "pkg/wk"

// Per-arch `type` variants, selected by the declaration-level build gate.
#[build(is(arch, "x64"))]
type Word uint8
#[build(is(arch, "aarch64"))]
type Word uint16
#[build(is(arch, "arm32"))]
type Word uint32

// Per-arch `func` variants of the same name.
#[build(is(arch, "x64"))]
func Tag() *[]readonly char {
	return "x64"
}
#[build(is(arch, "aarch64"))]
func Tag() *[]readonly char {
	return "aarch64"
}
#[build(is(arch, "arm32"))]
func Tag() *[]readonly char {
	return "arm32"
}

func WordSize() int {
	return cast(int, sizeof(Word))
}
