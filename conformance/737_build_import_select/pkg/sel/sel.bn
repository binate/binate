package "pkg/sel"

// Conditional imports: only the matching helper is followed.
#[build(is(arch, "aarch64"))]
import "pkg/sel_aa"
#[build(!is(arch, "aarch64"))]
import "pkg/sel_other"

#[build(is(arch, "aarch64"))]
func Pick() *[]readonly char {
	return sel_aa.Tag()
}
#[build(!is(arch, "aarch64"))]
func Pick() *[]readonly char {
	return sel_other.Tag()
}
