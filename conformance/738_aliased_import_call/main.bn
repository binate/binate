package "main"
import "pkg/builtins/testing"

import a "pkg/aliastgt"

// Minimal repro of a pre-existing bug: an aliased import's cross-package call
// mangles the callee with the ALIAS (@bn_F...) instead of the package
// path, yielding an undefined symbol.  No in-repo code uses aliased imports,
// so this was latent.  Expected output once fixed: 7.
func main() {
	testing.Println(a.Code())
}
