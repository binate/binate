package "main"
import "pkg/builtins/testing"

// `++` / `--` on a NON-identifier lvalue — an array/slice element, a struct
// field, or a dereference — must read-modify-write the storage, not silently
// do nothing (genIncDec used to lower only the EXPR_IDENT case).

type Node struct {
	count int
}

type Row [3]int

func main() {
	// Array element.
	var a [3]int
	a[0] = 10
	a[1] = 20
	a[0]++
	a[1]--
	testing.Println(a[0]) // 11
	testing.Println(a[1]) // 19

	// Named-array element (peels the named wrapper to the element type).
	var r Row
	r[2] = 7
	r[2]++
	testing.Println(r[2]) // 8

	// Slice element.
	var s @[]int = make_slice(int, 2)
	s[0] = 5
	s[0]++
	s[0]++
	testing.Println(s[0]) // 7

	// Struct field through a managed pointer.
	var n @Node = make(Node)
	n.count = 100
	n.count++
	n.count++
	n.count--
	testing.Println(n.count) // 101

	// Dereference.
	var x int = 42
	var p *int = &x
	(*p)++
	testing.Println(x)  // 43
	testing.Println(*p) // 43

	// VALUE struct field (not via a managed pointer — genSelectorPtr into
	// the local's own alloca, a different path from the @Node field above).
	var sv Node
	sv.count = 5
	sv.count++
	sv.count--
	sv.count--
	testing.Println(sv.count) // 4

	// Nested-array element (the index base is itself an index expression).
	var m [2][2]int
	m[1][1] = 10
	m[1][1]++
	testing.Println(m[1][1]) // 11

	// Sub-word element wraps (two's-complement), like ident inc/dec.
	var u [2]uint8
	u[0] = 0
	u[0]--
	testing.Println(cast(int, u[0])) // 255
}
