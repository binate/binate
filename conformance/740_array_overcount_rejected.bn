package "main"

// An array composite literal with more elements than the array's length must
// be rejected at the checker: IR-gen stores element i at index i, so an
// over-count would emit out-of-bounds stores past the fixed-size alloca
// (memory-unsafety) rather than a diagnostic.
func main() {
	var a [3]int = [3]int{1, 2, 3, 4, 5}
	println(a[0])
}
