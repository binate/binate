package "main"
import "pkg/builtins/testing"

// A user function with an empty parameter list called with arguments is "too
// many arguments".  Only the variadic builtin `panic` accepts extra args with
// an empty param list; a plain `func f()` must not.
func f() {
	testing.Println("hi")
}

func main() {
	f(1, 2)
}
