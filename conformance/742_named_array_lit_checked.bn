package "main"

// Named array composite literals must be element-validated like the unnamed
// form: checkCompositeLit peels the named underlying to the composite shape
// and routes it to checkArrayLit.  Over-count must be rejected (else IR-gen
// emits out-of-bounds stores past the alloca), and a wrong element type must
// be rejected.  Without the named-underlying routing both were silently
// accepted (the checker only routed named STRUCT underlyings to a checker).
type Row [3]int

func main() {
	var a Row = Row{1, 2, 3, 4, 5}
	var b Row = Row{1, true, 3}
	println(a[0])
	println(b[0])
}
