package "main"

// A positional struct literal with more values than the struct has fields
// must be rejected at the checker — the extra values are otherwise silently
// dropped by IR-gen.  (The array analogue is 740; keyed literals bind by name
// and are not count-checked.)

type S struct {
	a int
	b int
}

func main() {
	var s S = S{1, 2, 3}
	println(s.a)
}
