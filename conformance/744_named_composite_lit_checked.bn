package "main"
import "pkg/builtins/testing"

// Companion to 742 (named ARRAY): a NAMED struct / managed-slice / raw-slice
// composite literal must be element-validated like its unnamed form —
// checkCompositeLit peels the named wrapper to the composite shape and routes
// it to the matching checker.  A wrong element type is rejected in every
// case, and a named-struct over-count is rejected (the array OOB analogue).

type S struct {
	a int
	b int
}
type NS S            // named struct
type Buf @[]int      // named managed-slice
type RS *[]readonly int  // named raw-slice

func main() {
	var w NS = NS{1, true}    // wrong element type (named struct)
	var x NS = NS{1, 2, 3}    // over-count (named struct)
	var y Buf = Buf{1, false} // wrong element type (named managed-slice)
	var z RS = RS{1, true}    // wrong element type (named raw-slice)
	testing.Println(w.a)
	testing.Println(x.a)
	testing.Println(y[0])
	testing.Println(z[0])
}
