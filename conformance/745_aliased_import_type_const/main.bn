package "main"

import a "pkg/at"

// Self-review completeness check for the aliased-import fix: exercise an
// aliased TYPE reference (a.Thing), an aliased CONST reference (a.TAG), and
// an aliased FUNC call (a.Get) — all must resolve via the explicit alias.
func main() {
	var x a.Thing = cast(a.Thing, 5)
	println(cast(int, x))
	println(a.TAG)
	println(a.Get())
}
