package "main"
import "pkg/builtins/testing"

import "pkg/bcfg"

// Verifies conditional declarations in a .bni interface file: pkg/bcfg
// (interface-only) declares a per-arch exported `const Bits`, gated by
// #[build(...)].  The .bni gate keeps exactly the one for the active arch;
// if it were inactive the three definitions would collide.
func main() {
	testing.Println(bcfg.Bits)
}
