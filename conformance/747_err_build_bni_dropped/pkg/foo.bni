// The package-clause constraint is unsatisfiable on every target (an arch
// cannot be both x64 and arm32), so the .bni's whole-interface build gate
// drops it everywhere.  With no impl directory, the package is then "not
// found" — exercising gateBni's package-clause-drop branch and its placement
// before the empty-package check.
#[build(is(arch, "x64") && is(arch, "arm32"))]
package "pkg/foo"

const Tag int = 1
