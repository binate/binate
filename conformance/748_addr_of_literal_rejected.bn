package "main"

// Taking the address of a literal constant has no meaning — a literal has no
// storage — and must be rejected, like `&` of a named constant.

func main() {
	var a *int = &5
	var b *bool = &true
	var c *float64 = &2.5
	var d *char = &'x'
	var e = &"hi"
	var f = &nil
	_ = a
	_ = b
	_ = c
	_ = d
	_ = e
	_ = f
}
