package "main"

// Taking the address of a literal has no meaning — a literal has no storage —
// and must be rejected, like `&` of a named constant.  Covers every literal
// kind, including a FUNC literal (`&func(){}`, rejected like Go) and a
// PARENTHESIZED literal (`&(7)` — the parens are transparent, so the inner
// literal still reaches the check).  A composite literal (`&Point{...}`) is
// addressable and is deliberately NOT in this set; the full suite's existing
// `&`-of-aggregate uses guard against over-rejection.

func main() {
	var a *int = &5
	var b *bool = &true
	var c *float64 = &2.5
	var d *char = &'x'
	var e = &"hi"
	var f = &nil
	var g = &func(n int) int { return n } // func literal — no storage
	var h = &(7)                          // parenthesized literal
	_ = a
	_ = b
	_ = c
	_ = d
	_ = e
	_ = f
	_ = g
	_ = h
}
