package "main"
import "pkg/builtins/testing"

// A generic function whose parameter or result type names a generic
// STRUCT instantiated with the function's OWN type parameter — `Vec[T]`
// / `@Vec[T]` — must substitute the type arg at the instantiation site,
// so `newVal[int]()` has result type `Vec[int]` (not the unsubstituted
// `Vec[T]`).  Before substituteTypeParams recursed into the nested
// instantiation's type-args, every line below was rejected with
// `cannot assign Vec[T] to Vec[int]` (and the reverse for arguments).
//
// Covers result position (value `Vec[T]` and managed `@Vec[T]`),
// parameter position (value and the `Push`-style managed `@Vec[T]`),
// a `T`-typed field (so field-type substitution is exercised too),
// and a second distinct instantiation (`Vec[bool]`).

type Vec[T any] struct {
	first T
	n     int
}

func newVal[T any](x T, k int) Vec[T] {
	var v Vec[T]
	v.first = x
	v.n = k
	return v
}

func newBox[T any](x T, k int) @Vec[T] {
	var v @Vec[T] = make(Vec[T])
	v.first = x
	v.n = k
	return v
}

func getN[T any](v Vec[T]) int {
	return v.n
}

func bump[T any](v @Vec[T], by int) {
	v.n = v.n + by
}

func main() {
	var a Vec[int] = newVal[int](99, 7)
	testing.Println(a.n)             // 7
	testing.Println(a.first)         // 99
	testing.Println(getN[int](a))    // 7

	var b @Vec[int] = newBox[int](88, 10)
	testing.Println(b.n)             // 10
	bump[int](b, 5)
	testing.Println(b.n)             // 15

	var c Vec[bool] = newVal[bool](true, 3)
	testing.Println(getN[bool](c))   // 3
}
