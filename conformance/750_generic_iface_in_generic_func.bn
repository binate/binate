package "main"

// Sibling of 749 for the INTERFACE form: a generic function whose
// signature uses a generic interface instantiated with the function's
// own type parameter — `@Container[T]` (interface-value) — must
// substitute the type arg, so `useIt[int]` takes `@Container[int]`.
// Before substituteTypeParams recursed into the interface-value
// wrapper to reach the instantiation inside, `@Container[T]` was left
// unsubstituted: a matching argument was rejected (`cannot assign
// @IntBox to @Container[T]`) and a mismatched one wrongly accepted.
// Exercises two distinct instantiations and dispatch through the
// substituted interface value.

interface Container[T any] {
	get() T
}

type IntBox struct { v int }
impl @IntBox : Container[int]
func (b @IntBox) get() int { return b.v }

type BoolBox struct { v bool }
impl @BoolBox : Container[bool]
func (b @BoolBox) get() bool { return b.v }

func useIt[T any](c @Container[T]) T {
	return c.get()
}

func main() {
	var ib @IntBox = make(IntBox)
	ib.v = 7
	println(useIt[int](ib))    // 7

	var bb @BoolBox = make(BoolBox)
	bb.v = true
	println(useIt[bool](bb))   // true
}
