package "main"

import "pkg/x"

// A named function is not an addressable lvalue — `&g` (same-package) and
// `&pkg.f` (imported) are rejected; name the function directly to get its
// value (`var fp *func(int) int = g`).  `&g` otherwise yielded a malformed
// `*func(...)` type that every use rejected with a confusing "<unknown>".
// The token.AMP check handled only SYM_CONST, so SYM_FUNC slipped through.
func g(n int) int { return n }

func main() {
	var p = &g
	var q = &x.G
	_ = p
	_ = q
}
