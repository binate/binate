package "main"

import "pkg/x"

// Function-like values with no storage are not addressable lvalues, so `&`
// of them is rejected:
//   - a named function, same-package `&g` or imported `&pkg.f` (name it
//     directly to get its value, `var fp *func(int) int = g`);
//   - a bound method value `&t.m` (a computed func value — a struct FIELD of
//     the same name would instead be addressable).
// `&g` otherwise yielded a malformed `*func(...)` type that every use rejected
// with a confusing "<unknown>"; the token.AMP check handled only SYM_CONST.

type T struct {
	v int
}

func (t *T) m() int { return t.v }

func g(n int) int { return n }

func main() {
	var p = &g
	var q = &x.G
	var t @T = make(T)
	var r = &t.m
	_ = p
	_ = q
	_ = r
}
