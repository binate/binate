package "main"
import "pkg/builtins/testing"

// A constrained generic function that forwards its own type parameter
// as the type ARGUMENT to another constrained generic must type-check:
// T's declared bound satisfies the callee's same (or weaker)
// constraint.  Before typeSatisfiesConstraint consulted a type-param's
// TpConstraint, the forwarded `mid[T]` / `cmp[T]` calls were rejected
// with `type argument T does not satisfy constraint Orderable`,
// forcing every constrained generic into one monolithic function.
//
// Covers: same-constraint forwarding (a 3-level chain top→mid→leaf,
// all Orderable) and a stronger-bound-to-weaker-callee forward (top
// is Orderable, calls cmp[T] whose callee bound is Comparable —
// satisfied via the Orderable : Comparable interface inheritance).

import "pkg/builtins/lang"

func leaf[T lang.Orderable](a T, b T) int {
	return a.Compare(b)
}

func cmp[T lang.Comparable](a T, b T) int {
	return a.Compare(b)
}

func mid[T lang.Orderable](a T, b T) int {
	return leaf[T](a, b)
}

func top[T lang.Orderable](a T, b T) int {
	return mid[T](a, b) + cmp[T](a, b)
}

func main() {
	testing.Println(top[int](3, 5))   // -1 + -1 = -2
	testing.Println(top[int](5, 3))   //  1 +  1 =  2
	testing.Println(top[int](4, 4))   //  0 +  0 =  0
}
