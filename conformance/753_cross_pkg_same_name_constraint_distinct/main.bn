package "main"

import "pkg/dep"

// Regression guard for the constrained-type-param-forwarding check
// (typeSatisfiesConstraint's TYP_TYPE_PARAM branch): a forwarded type
// param satisfies a callee's constraint only when its bound matches by
// (Pkg, Name) — NOT by bare name.  "main" defines its OWN `interface
// Foo` while `callee` requires the same-short-named `pkg/dep.Foo`.
// Forwarding `T` (bound by main.Foo) into `callee[T]` (needs dep.Foo)
// must be REJECTED at top's body check: they are distinct interfaces.
// If the branch ever regressed to a name-only match (dropping the Pkg
// half), unrelated same-named interfaces in different packages would
// falsely satisfy each other — an unsound accept.

interface Foo { f() int }

func callee[T dep.Foo](a T) int {
	return 0
}

func top[T Foo](a T) int {
	return callee[T](a)
}

func main() {}
