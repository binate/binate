package "main"
import "pkg/builtins/testing"

// An instantiated generic interface that EXTENDS another instantiated
// generic interface (`WideBox[int] : Box[int]`) must record its
// parents, so its inheritance is visible to isDescendantInterface.
// Before buildInstantiatedInterface populated `.Parents`, an
// instantiated generic interface looked like it extended nothing, so
// both satisfaction paths below were wrongly rejected with `type
// argument ... does not satisfy constraint Box[int]`:
//   1. concrete: `@IntImpl` (impl of WideBox[int]) satisfying Box[int]
//      via its descendant impl (the c.Impls path), and
//   2. forwarding: a type param bounded by WideBox[int] forwarded to a
//      Box[int]-constrained callee (the TYP_TYPE_PARAM path).
// Constraint-method dispatch through the forwarded instantiation then
// resolves get() to the concrete type's method.

interface Box[T any] { get() T }
interface WideBox[T any] : Box[T] { extra() int }

type IntImpl struct { v int }
impl @IntImpl : WideBox[int]
func (i @IntImpl) get() int { return i.v }
func (i @IntImpl) extra() int { return 100 }

func inner[T Box[int]](a T) int { return a.get() }
func outer[T WideBox[int]](a T) int { return inner[T](a) }

func main() {
	var im @IntImpl = make(IntImpl)
	im.v = 42
	testing.Println(outer[@IntImpl](im))   // 42
}
