package "main"
import "pkg/builtins/testing"

// Every addressable lvalue stays addressable under the general `&` check, and
// the resulting pointers actually write through: a variable, a struct field,
// an array element, and a composite literal.  (`&*p` is also checker-
// addressable, but a separate IR-gen defect mis-lowers its write-through — see
// claude-todo — so it is not exercised here.)

type P struct {
	x int
}

func main() {
	var v int = 10
	var pv *int = &v
	*pv = 11
	testing.Println(v) // 11

	var s P
	s.x = 20
	var pf *int = &s.x
	*pf = 21
	testing.Println(s.x) // 21

	var a [3]int
	a[0] = 30
	var pe *int = &a[0]
	*pe = 31
	testing.Println(a[0]) // 31

	var pc *P = &P{x: 99}
	testing.Println(pc.x) // 99
}
