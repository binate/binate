package "main"

// `&` of a computed VALUE with no storage is rejected by the general
// addressability check — beyond the named const/function/literal/method-value
// special cases, this covers a call result, a method EXPRESSION, an arithmetic
// expression, and a slice expression.

type T struct {
	v int
}

func (t *T) m() int { return t.v }

func f() int { return 5 }

func main() {
	var a = &f()                  // call result
	var b = &T.m                  // method expression
	var x int = 3
	var c = &(x * 2)              // arithmetic expression
	var s @[]int = make_slice(int, 4)
	var d = &s[1:3]               // slice expression
	var e = &make_slice(int, 2)  // builtin (make) result
	var g = &cast(int, 3.5)      // cast result
	_ = a
	_ = b
	_ = c
	_ = d
	_ = e
	_ = g
}
