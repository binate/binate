package "main"

import "pkg/combo"

// combo has a .bni (a per-arch gated `const Bits` + an extern `Double` decl)
// AND a .bn impl (Double's body).  Exercises the gated .bni const flowing into
// the merged package alongside a real .bn impl — the combined-package case
// 746_build_bni_const (interface-only) did not cover.
func main() {
	println(combo.Double(combo.Bits))
}
