package "pkg/combo"

// A per-arch gated const declared in the .bni (exactly one survives the
// build gate), alongside a function whose body lives in the .bn impl.  Both
// must flow into the merged package: the gated const via gateBni + the .bni
// overlay, the extern func via the normal .bni-decl overlay.
#[build(is(arch, "aarch64"))]
const Bits int = 64
#[build(is(arch, "arm32"))]
const Bits int = 32
#[build(is(arch, "x64"))]
const Bits int = 64

func Double(x int) int
