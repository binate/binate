package "main"
import "pkg/builtins/testing"

// `&(*p)` is the pointer itself (`&*p == p`), so a write-through reaches the
// original storage.  IR-gen used to return the LOADED VALUE of `*p` as a
// pointer, so `*pd = …` stored to a garbage address (SIGSEGV).

type Node struct {
	w int
}

func main() {
	var v int = 5
	var p *int = &v
	var pd *int = &(*p)
	*pd = 9
	testing.Println(v) // 9
	*pd = *pd + 1
	testing.Println(v) // 10
	// &(*p) aliases p: a write via p is seen through pd.
	*p = 42
	testing.Println(*pd) // 42

	// &(*mp) on a MANAGED pointer: the raw view aliases the managed object.
	var mp @Node = make(Node)
	mp.w = 7
	var rp *Node = &(*mp)
	rp.w = 8
	testing.Println(mp.w) // 8

	// Nested deref: &**pp == *pp == p, so a write reaches v.  The
	// deref-operand lowering recurses (`&(*(*pp))` -> genExpr(`*pp`)).
	var pp **int = &p
	var qn *int = &**pp
	*qn = 50
	testing.Println(v) // 50
}
