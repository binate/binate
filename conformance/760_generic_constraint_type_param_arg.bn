package "main"
import "pkg/builtins/testing"

// A generic function whose type-parameter constraint is itself a generic
// interface instantiated with ANOTHER of the function's type parameters
// (`func use[X any, T Container[X]]`) must substitute that type param
// before the satisfaction check, so `use[int, @IntBox]` checks @IntBox
// against the concrete `Container[int]` (which it impls) rather than the
// unsubstituted `Container[X]`.  Before instantiateGenericFunc
// substituted the constraint, this was wrongly rejected with `type
// argument @IntBox does not satisfy constraint Container[X]`.

interface Container[T any] { get() T }

type IntBox struct { v int }
impl @IntBox : Container[int]
func (b @IntBox) get() int { return b.v }

// X is forwarded into the constraint of T; the result type also names X.
func use[X any, T Container[X]](a T) X {
	return a.get()
}

func main() {
	var b @IntBox = make(IntBox)
	b.v = 77
	testing.Println(use[int, @IntBox](b))   // 77
}
