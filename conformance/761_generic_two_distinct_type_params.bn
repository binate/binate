package "main"

// Two type parameters each used as the type ARGUMENT to a generic
// instantiation must stay DISTINCT.  Before Identical compared type
// params by (TpOwner, TpIndex), every pair of type params compared
// Identical (catchall `return true`), so the instantiation cache
// aliased `Box[A]` and `Box[B]` to one type carrying A's index.  Then
// `combine[int, bool]`'s second parameter was wrongly typed `Box[int]`
// (it should be `Box[bool]`), so passing a real `Box[bool]` was
// rejected (`cannot assign Box[bool] to Box[int]`) — and the unsound
// converse (a `Box[int]` accepted into the `Box[bool]` slot) reached
// IR-gen with the wrong type.

type Box[T any] struct { v T }

func mk[T any](x T) Box[T] {
	var b Box[T]
	b.v = x
	return b
}

// A and B are distinct; x is Box[A], y is Box[B].  Returns the A-typed
// field, so the result type is A (int here) and x.v reads correctly.
func combine[A any, B any](x Box[A], y Box[B]) A {
	return x.v
}

func main() {
	var bi Box[int] = mk[int](10)
	var bb Box[bool] = mk[bool](true)
	println(combine[int, bool](bi, bb))   // 10
}
