package "main"
import "pkg/builtins/testing"

// A recursive generic struct (a linked list — the recursive field is
// behind a managed pointer, so it is size-stable) must instantiate and
// run.  Before the instantiation cache pre-registered an in-progress
// placeholder, resolving `Node[int]`'s field `next @Node[int]` re-entered
// instantiation for `Node[int]` and overflowed the stack (SIGSEGV at
// type-check) — pre-existing, independent of generics-substitution work.

type Node[T any] struct { val T; next @Node[T] }

func main() {
	var a @Node[int] = make(Node[int])
	a.val = 1
	var b @Node[int] = make(Node[int])
	b.val = 2
	a.next = b
	testing.Println(a.val + a.next.val)   // 3
}
