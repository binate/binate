package "main"

// Two generic interfaces that transitively extend each other through
// their instantiations must be rejected with a clean diagnostic, not
// loop forever in the ancestor-closure walk (SIGSEGV).

interface P[T any] : Q[T] { p() T }
interface Q[T any] : P[T] { q() T }

func main() { var x *P[int]; _ = x }
