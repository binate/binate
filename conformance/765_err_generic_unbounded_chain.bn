package "main"

// An instantiation chain whose type argument grows without bound
// (`Box[T]` → `Box[Wrap[T]]` → `Box[Wrap[Wrap[T]]]` → ...) never repeats
// a (decl, args) key, so the placeholder cache cannot break it; the
// instantiation-depth bound rejects it cleanly instead of overflowing.

type Wrap[T any] struct { x T }
type Box[T any] struct { inner @Box[Wrap[T]] }

func main() { var b Box[int]; _ = b }
