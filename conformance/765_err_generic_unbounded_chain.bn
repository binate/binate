package "main"

// gen.mono.instances: a generic whose fields name instances with an
// ever-growing type argument (`Box[T]` → `Box[Wrap[T]]` →
// `Box[Wrap[Wrap[T]]]` → ...) is rejected at its declaration, and naming an
// instance of it is an error, without building the chain.

type Wrap[T any] struct { x T }
type Box[T any] struct { inner @Box[Wrap[T]] }

func main() { var b Box[int]; _ = b }
