package "main"

import "pkg/builtins/build"

// Pins that the active build config gates pkg/builtins/build to the CORRECT os
// for the target — not just a valid member.  692_build_target_consts checks
// build.OS is one of the OSType members and that PtrSize/IntSize match the
// compiler's sizeof (the width class), but its output is target-independent, so
// it would not catch the config selecting a wrong-but-same-width os (e.g. linux
// on a darwin host).  pkg/std/os/sys/errno.bn branches on `build.OS == OS_DARWIN`
// to pick per-os errno values, so a wrong host os is a real miscompile — hence a
// per-mode assertion of the actual os name here.
func main() {
	if build.OS == build.OS_LINUX {
		println("os=linux")
	} else if build.OS == build.OS_DARWIN {
		println("os=darwin")
	} else if build.OS == build.OS_BAREMETAL {
		println("os=baremetal")
	} else {
		println("os=UNKNOWN")
	}
}
