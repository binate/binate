package "main"
import "pkg/builtins/testing"

// `panic(msg)` prints "panic: <msg>" (matching the runtime-abort
// convention of rt.BoundsFail / rt.DivFail) and aborts.  Lowered in
// IR-gen to a call to rt.Panic + unreachable, so it works on
// every backend (LLVM, the VM, native) without a backend-specific
// panic op.  The pre-panic line must print; the post-panic line must
// not be reached (the abort is verified by run scripts — the .error
// harness only asserts the substrings present).

func mustPos(x int) int {
	if x > 0 { return x }
	panic("mustPos: non-positive value")
}

func main() {
	testing.Println(mustPos(5))
	testing.Println(mustPos(0))
	testing.Println(999)
}
