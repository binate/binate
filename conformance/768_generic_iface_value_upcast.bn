package "main"

// plan-generics.md Slice 6c-full + plan-interface-embedding.md
// Slice E.4: a parent-interface upcast between two INSTANTIATED
// generic interface values (`@WideBox[int]` -> `@Box[int]`).  The
// source is itself a generic instantiation, so its extension clause
// (`WideBox[T] : Box[T]`) must be recorded at instantiation time —
// otherwise collectImplsFromDecl never emits the inherited
// (Impl, Box[int]) vtable and the upcast offset / VM name-swap fail
// to resolve, a silent codegen failure on otherwise-valid code.
// Both inherited dispatch (w.get()) and dispatch through the upcast
// view (b.get()) must reach Impl.get().

interface Box[T any] {
	get() T
}

interface WideBox[T any] : Box[T] {
	extra() int
}

type Impl struct {
	v int
}

impl @Impl : WideBox[int]

func (i @Impl) get() int {
	return i.v
}

func (i @Impl) extra() int {
	return 100
}

func main() {
	var im @Impl = make(Impl)
	im.v = 42
	var w @WideBox[int] = im
	// Inherited dispatch through WideBox[int] — get() comes from
	// Box[int]'s sub-vtable.
	println(w.get())
	println(w.extra())
	// Parent-interface upcast to @Box[int] — vtable adjusted to the
	// parent's sub-vtable, same data ptr.
	var b @Box[int] = w
	println(b.get())
}
