package "main"

// Parent-interface upcasts between
// instantiated generic interface values, beyond the managed 2-level case
// (conformance 768) — companion coverage for two variations that exercise
// the shared upcast machinery (IfaceParentSlotOffset recursion + the
// managed/raw upcast lowering):
//   (1) a RAW-pointer iface-value upcast (*WideBox[int] -> *Box[int]);
//   (2) a TRANSITIVE 3-level upcast (@A[int] -> @C[int], skipping B), so
//       the recorded-parent ancestor walk must descend two levels.

// --- (1) raw-pointer 2-level ---
interface Box[T any] { get() T }
interface WideBox[T any] : Box[T] { extra() int }
type RImpl struct { v int }
impl *RImpl : WideBox[int]
func (i *RImpl) get() int { return i.v }
func (i *RImpl) extra() int { return 7 }

// --- (2) transitive 3-level ---
interface C[T any] { c() T }
interface B[T any] : C[T] { b() int }
interface A[T any] : B[T] { a() int }
type TImpl struct { v int }
impl @TImpl : A[int]
func (i @TImpl) c() int { return i.v }
func (i @TImpl) b() int { return 1 }
func (i @TImpl) a() int { return 2 }

func main() {
	// (1) raw upcast: *WideBox[int] -> *Box[int].
	var ri RImpl
	ri.v = 42
	var w *WideBox[int] = &ri
	var rb *Box[int] = w
	println(rb.get())

	// (2) transitive upcast: @A[int] -> @C[int] (skips B[int]).
	var ti @TImpl = make(TImpl)
	ti.v = 55
	var x @A[int] = ti
	var z @C[int] = x
	println(z.c())
}
