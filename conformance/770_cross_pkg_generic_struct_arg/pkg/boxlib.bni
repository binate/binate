package "pkg/boxlib"

// A generic container plus a generic function that takes it by managed
// pointer and reads a field.  Exercises two cross-package generic bugs
// together: (1) the .bni signature `@Box[T]` must resolve `Box` in its
// own interface file (else the param records `void`); (2) the consumer-
// side monomorphization must compile the body with `Box[int]`'s real
// layout (else the struct argument is silently received as zero).
type Box[T any] struct {
	v T
}

// GetMan returns the boxed value through a managed-pointer parameter.
func GetMan[T any](b @Box[T]) T {
	return b.v
}
