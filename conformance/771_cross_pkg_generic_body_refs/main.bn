package "main"
import "pkg/builtins/testing"

import "pkg/genlib"

func main() {
	var p @genlib.Pair = make(genlib.Pair)
	p.a = 3
	p.b = 4
	testing.Println(genlib.SumPair[int](p))   // 7   (non-generic struct param)
	testing.Println(genlib.Scaled[int](5))    // 50  (bare module const)
	testing.Println(genlib.ViaHelper[int](6)) // 106 (sibling free function)
	testing.Println(genlib.Outer[int](20))    // 41  (nested generic)
}
