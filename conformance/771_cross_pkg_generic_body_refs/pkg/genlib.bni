package "pkg/genlib"

// Coverage for the consumer-side monomorphization resolving a generic
// body's UNQUALIFIED references against the package the generic was
// declared in (genlib here), not the consumer module.  Each generic
// body below references genlib's own namespace in a different way:
// a non-generic struct type, a module const, a sibling free function,
// and a sibling generic (nested instantiation).

// SCALE is a module-level const referenced bare from a generic body.
const SCALE int = 10

// Pair is a non-generic struct used as a generic-function parameter.
type Pair struct {
	a int
	b int
}

// SumPair reads both fields of a non-generic struct parameter (the
// `@Pair` head resolves via the defining package, not the consumer).
func SumPair[T any](p @Pair) int {
	return p.a + p.b
}

// Scaled multiplies by the bare module const SCALE.
func Scaled[T any](x int) int {
	return x * SCALE
}

// ViaHelper calls a bare sibling free function whose body is in the .bn.
func ViaHelper[T any](x int) int {
	return helper(x)
}

// Outer calls a sibling generic (Inner) — a nested instantiation that
// must itself resolve against the defining package.
func Outer[T any](x int) int {
	return Inner[T](x) + 1
}

// Inner is the nested generic target.
func Inner[T any](x int) int {
	return x * 2
}

// helper's body lives in the .bn impl file.
func helper(x int) int
