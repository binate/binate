package "main"

// A generic `==` over a managed-slice type argument. `eq[@[]int]` should
// be a clean checker rejection (slices aren't comparable), exactly like
// the non-generic `a == b` path. But operand comparability is checked
// only on the generic DEFINITION (where T is opaque, so the check is
// skipped), not re-checked at instantiation — so the body's `a == b`
// reaches codegen and emits an invalid `icmp` on a %BnManagedSlice (a
// deterministic clang failure / VM mis-execution).
//
// XFAIL: tracked in claude-todo.md (Ch.12 "constraint satisfaction
// unchecked" sibling — generic instantiation should re-run operand
// checks).  When fixed, this becomes a clean rejection matching the
// .error below and the xfail markers go stale (XPASS).
func eq[T any](a T, b T) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	println(eq[@[]int](x, x))
}
