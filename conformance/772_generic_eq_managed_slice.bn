package "main"

// expr.compare.typeparam: `==` is not defined on a type parameter, so the generic
// body `a == b` on a bare `T` is rejected at the DEFINITION — a clean checker
// rejection independent of the concrete type argument (a managed slice here has no
// `==`, but so does any non-comparable arg; the rejection does not depend on it).
// Generic code compares via a constrained method (`[T lang.Comparable]`,
// `a.Compare(b) == 0`).

func eq[T any](a T, b T) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	println(eq[@[]int](x, x))
}
