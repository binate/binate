package "main"
import "pkg/builtins/testing"

// Managed-slice composite literal whose element type is a (value) struct.
// Both inline struct-literal elements and pre-built variable elements must
// store the struct VALUE into each slot (not the temp's alloca pointer), and
// reads must return the stored fields.  Regression: genManagedSliceLit stored
// the inline temp's address (the element read back as a garbage pointer).
type Pt struct {
	x int
	y int
}

func main() {
	// Inline struct-literal elements.
	var a @[]Pt = @[]Pt{ Pt{ x: 1, y: 2 }, Pt{ x: 3, y: 4 } }
	testing.Println(a[0].x)
	testing.Println(a[0].y)
	testing.Println(a[1].x)
	testing.Println(a[1].y)

	// Pre-built variable elements.
	var p0 Pt = Pt{ x: 5, y: 6 }
	var p1 Pt = Pt{ x: 7, y: 8 }
	var b @[]Pt = @[]Pt{ p0, p1 }
	testing.Println(b[0].x)
	testing.Println(b[1].y)
}
