package "main"

// Managed-slice composite literal of a struct that has a MANAGED field
// (@[]char).  Inline struct-literal elements must load the aggregate value
// AND run the per-element struct-copy (RefInc the managed field), so the
// slice co-owns each name and reads return the stored fields.  A missing load
// stored the temp pointer (garbage / crash); a missing/duplicated RefInc would
// leak or double-free the name on slice teardown.
type Box struct {
	name @[]char
	n    int
}

func main() {
	var a @[]Box = @[]Box{ Box{ name: "alpha", n: 1 }, Box{ name: "beta", n: 2 } }
	println(len(a[0].name))   // 5
	println(a[0].n)           // 1
	println(a[0].name[0])     // 97 ('a')
	println(len(a[1].name))   // 4
	println(a[1].n)           // 2
	println(a[1].name[0])     // 98 ('b')
}
