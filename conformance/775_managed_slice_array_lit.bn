package "main"

// Managed-slice composite literal whose element type is a fixed ARRAY, with
// inline array-literal elements.  Exercises the TYP_ARRAY branch of the
// isAggregateAllocToLoad guard in genManagedSliceLit (773/774 cover the struct
// branch): the inline [N]T temp's value must be loaded into each slot, not its
// alloca pointer.
func main() {
	var a @[][2]int = @[][2]int{ [2]int{ 1, 2 }, [2]int{ 3, 4 } }
	println(a[0][0])
	println(a[0][1])
	println(a[1][0])
	println(a[1][1])
}
