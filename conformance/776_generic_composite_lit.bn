package "main"
import "pkg/builtins/testing"

// Generic-instantiated composite-literal head `Pair[int]{...}` (§13.10):
// constructs an instantiated generic struct in expression position. The
// parser used to mis-parse the `[int]` as indexing and leave the `{...}`
// orphaned (a parse error); it now reinterprets `Pair[int]` as a
// TEXPR_INSTANTIATE composite head.
type Pair[T any] struct {
	a T
	b T
}

// Box exercises a nested generic composite head: Box[Pair[int]]{...}.
type Box[T any] struct {
	v T
}

func main() {
	var p Pair[int] = Pair[int]{a: 3, b: 4}
	testing.Println(p.a + p.b)
	var bx Box[Pair[int]] = Box[Pair[int]]{v: Pair[int]{a: 5, b: 6}}
	testing.Println(bx.v.a + bx.v.b)
}
