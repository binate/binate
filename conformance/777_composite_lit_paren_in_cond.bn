package "main"
import "pkg/builtins/testing"

// D4 (§13.13): a composite literal in an `if`/`for`/`switch` condition
// must be parenthesized — `(Counter{n: 5})` here.  The parser must clear
// noCompositeLit inside the parens; keeping it set suppresses the
// documented escape, and the `{` is mis-read.  (A method call on the
// composite rvalue reads it; direct field access on a composite rvalue
// is covered by 795.)
type Counter struct {
	n int
}

func (c Counter) get() int {
	return c.n
}

func main() {
	if (Counter{n: 5}).get() > 0 {
		testing.Println("pos")
	} else {
		testing.Println("nonpos")
	}
}
