package "main"

// D4 (§13.13): a composite literal in an `if`/`for`/`switch` condition
// must be parenthesized — `(Counter{n: 5})` here.  The parser used to
// keep noCompositeLit set inside the parens, suppressing the documented
// escape so the `{` was mis-read.  (A method call on the composite
// rvalue is used to read it; direct field access on a composite rvalue
// is a separate, tracked bug.)
type Counter struct {
	n int
}

func (c Counter) get() int {
	return c.n
}

func main() {
	if (Counter{n: 5}).get() > 0 {
		println("pos")
	} else {
		println("nonpos")
	}
}
