package "main"
import "pkg/builtins/testing"

// Verifies parallel assignment of MANAGED pointers swaps correctly and keeps
// refcounts balanced.  The swap `a, b = b, a` of two solely-owned @T must
// acquire both new values BEFORE releasing either old one — otherwise storing
// b's value into a would RefDec a's old value to zero (freeing it) before the
// second store reads it, a use-after-free.  keepA/keepB alias the objects so
// their refcounts stay observable across the swap.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func main() {
	var a @Box = make(Box)           // objA.rc = 1
	a.V = 100
	var b @Box = make(Box)           // objB.rc = 1
	b.V = 200
	var keepA @Box = a               // objA.rc = 2
	var keepB @Box = b               // objB.rc = 2
	var pa *uint8 = bit_cast(*uint8, a)
	var pb *uint8 = bit_cast(*uint8, b)

	a, b = b, a                      // swap: a holds objB, b holds objA

	testing.Println(a.V)                     // 200
	testing.Println(b.V)                     // 100
	// Each object still has exactly two owners (one var + one keep), so no
	// leak and no premature free occurred during the swap.
	testing.Println(rt.Refcount(pa))         // 2  (keepA + b)
	testing.Println(rt.Refcount(pb))         // 2  (keepB + a)
	testing.Println(keepA.V)                 // 100: original object intact
	testing.Println(keepB.V)                 // 200
}
