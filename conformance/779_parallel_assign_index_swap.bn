package "main"
import "pkg/builtins/testing"

// Verifies parallel assignment into INDEX targets (array and slice elements),
// for both plain and managed element types.  The element swap idiom
// `s[i], s[j] = s[j], s[i]` — the heart of in-place sorting — must read both
// old elements before writing either.  Managed elements additionally must
// stay refcount-balanced across the swap.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func main() {
	// Array of plain ints: swap two elements.
	var arr [3]int
	arr[0] = 1
	arr[1] = 2
	arr[2] = 3
	arr[0], arr[2] = arr[2], arr[0]
	testing.Println(arr[0])                  // 3
	testing.Println(arr[1])                  // 2
	testing.Println(arr[2])                  // 1

	// Slice of plain ints: swap two elements.
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	s[0], s[1] = s[1], s[0]
	testing.Println(s[0])                    // 20
	testing.Println(s[1])                    // 10
	testing.Println(s[2])                    // 30

	// Slice of managed pointers: swap two elements, refcounts balanced.
	var ms @[]@Box = make_slice(@Box, 2)
	ms[0] = make(Box)
	ms[0].V = 7
	ms[1] = make(Box)
	ms[1].V = 9
	var p0 *uint8 = bit_cast(*uint8, ms[0])
	var p1 *uint8 = bit_cast(*uint8, ms[1])
	ms[0], ms[1] = ms[1], ms[0]
	testing.Println(ms[0].V)                 // 9
	testing.Println(ms[1].V)                 // 7
	testing.Println(rt.Refcount(p0))         // 1: still exactly one owner (now ms[1])
	testing.Println(rt.Refcount(p1))         // 1: still exactly one owner (now ms[0])
}
