package "main"

// Verifies parallel assignment applies the same per-target value coercions as
// single assignment: string literal → char slice and sub-word integer width
// adjustment.  Swapping the char slices also exercises the managed-slice
// acquire/release path within a parallel assignment.

func plen(s @[]char) int { return len(s) }

func main() {
	// String literals into @[]char targets.
	var x @[]char = "initial"
	var y @[]char = "second"
	x, y = "hello", "worldly"
	println(plen(x))                 // 5
	println(plen(y))                 // 7

	// Swap of the char slices (managed-slice swap).
	x, y = y, x
	println(plen(x))                 // 7
	println(plen(y))                 // 5

	// Sub-word integer targets: untyped-int literals narrowed to uint8.
	var lo uint8 = 0
	var hi uint8 = 0
	lo, hi = 17, 250
	println(cast(int, lo))           // 17
	println(cast(int, hi))           // 250
	lo, hi = hi, lo                  // swap
	println(cast(int, lo))           // 250
	println(cast(int, hi))           // 17
}
