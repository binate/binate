package "main"

// Verifies parallel assignment into struct-field targets and of managed
// struct VALUES (structs carrying a managed field).  A managed-struct swap
// `a, b = b, a` must snapshot and acquire both structs' managed fields before
// overwriting either slot, then release each old occupant — so the inner
// objects stay refcount-balanced and no field is freed mid-swap.

import "pkg/builtins/rt"

type Inner struct {
	V int
}

type Pair struct {
	X int
	Y int
}

type Holder struct {
	Obj @Inner
}

func main() {
	// Plain struct fields as parallel-assignment targets, incl. swap.
	var p Pair
	p.X, p.Y = 3, 4
	println(p.X)                     // 3
	println(p.Y)                     // 4
	p.X, p.Y = p.Y, p.X
	println(p.X)                     // 4
	println(p.Y)                     // 3

	// Managed struct VALUES: swap two Holders, each owning an Inner.
	var a Holder
	a.Obj = make(Inner)
	a.Obj.V = 11
	var b Holder
	b.Obj = make(Inner)
	b.Obj.V = 22
	var pa *uint8 = bit_cast(*uint8, a.Obj)
	var pb *uint8 = bit_cast(*uint8, b.Obj)

	a, b = b, a                      // swap whole structs by value
	println(a.Obj.V)                 // 22
	println(b.Obj.V)                 // 11
	println(rt.Refcount(pa))         // 1: Inner(11) still solely owned (now b)
	println(rt.Refcount(pb))         // 1: Inner(22) still solely owned (now a)
}
