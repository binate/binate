package "main"
import "pkg/builtins/testing"

// Verifies parallel assignment through pointer-dereference targets
// (`*p, *q = ...`), including the swap idiom, for both plain and managed
// pointees.  The deref LHS arm must resolve each pointer in phase 1 and store
// in phase 2, releasing the managed pointee's old value with the same
// acquire-before-release discipline as the other target forms.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func main() {
	// Plain int through raw pointers: assign then swap the pointees.
	var m int = 1
	var n int = 2
	var pm *int = &m
	var pn *int = &n
	*pm, *pn = 100, 200
	testing.Println(m)                       // 100
	testing.Println(n)                       // 200
	*pm, *pn = *pn, *pm
	testing.Println(m)                       // 200
	testing.Println(n)                       // 100

	// Managed pointees: swap two @Box through pointers to the variables.
	var a @Box = make(Box)
	a.V = 5
	var b @Box = make(Box)
	b.V = 6
	var pa *uint8 = bit_cast(*uint8, a)
	var pb *uint8 = bit_cast(*uint8, b)
	var qa *@Box = &a
	var qb *@Box = &b
	*qa, *qb = *qb, *qa              // swap a and b through the pointers
	testing.Println(a.V)                     // 6
	testing.Println(b.V)                     // 5
	testing.Println(rt.Refcount(pa))         // 1: each object still solely owned
	testing.Println(rt.Refcount(pb))         // 1
}
