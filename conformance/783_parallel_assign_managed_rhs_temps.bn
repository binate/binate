package "main"

// Verifies parallel assignment where the right-hand values are freshly-OWNED
// temporaries (a make() result and a function return) rather than borrowed
// variables.  Each acquired value must end up solely owned by its target with
// refcount 1 — the up-front copy-RefInc (+1 over the temp's owned ref) is
// balanced by the temp's end-of-statement release, leaving exactly the slot's
// ownership.

import "pkg/builtins/rt"

type Box struct {
	V int
}

func freshBox(v int) @Box {
	var x @Box = make(Box)
	x.V = v
	return x
}

func main() {
	var a @Box = make(Box)           // initial values, replaced below
	var b @Box = make(Box)
	a, b = make(Box), freshBox(42)   // both RHS are owned temporaries
	a.V = 7
	println(a.V)                     // 7
	println(b.V)                     // 42
	var pa *uint8 = bit_cast(*uint8, a)
	var pb *uint8 = bit_cast(*uint8, b)
	println(rt.Refcount(pa))         // 1: a solely owns its object
	println(rt.Refcount(pb))         // 1: b solely owns its object

	// Mixed: one owned-temp RHS, one borrowed-variable RHS.
	var c @Box = make(Box)
	c, b = freshBox(9), a            // c gets a fresh temp; b aliases a
	println(c.V)                     // 9
	println(b.V)                     // 7  (b now aliases a)
	println(rt.Refcount(pa))         // 2: a + b both own a's object
}
