package "main"
import "pkg/builtins/testing"

// Verifies Go-style parallel assignment `a, b = e1, e2`: all right-hand
// expressions are evaluated before any left-hand slot is written, so the swap
// idiom `a, b = b, a` exchanges the two values (rather than the pre-fix
// behavior, where matched-arity multi-expression assignment type-checked
// clean but generated NO code — both stores silently dropped).

func main() {
	var a int = 1
	var b int = 2
	a, b = 10, 20
	testing.Println(a)            // 10
	testing.Println(b)            // 20

	a, b = b, a           // swap: a=20, b=10
	testing.Println(a)            // 20
	testing.Println(b)            // 10

	// Three-way rotation: x, y, z = y, z, x
	var x int = 1
	var y int = 2
	var z int = 3
	x, y, z = y, z, x
	testing.Println(x)            // 2
	testing.Println(y)            // 3
	testing.Println(z)            // 1

	// RHS reads the OLD values, not values updated mid-assignment.
	var p int = 5
	var q int = 7
	p, q = q + 1, p + 1   // p = 8, q = 6 (both use old p,q)
	testing.Println(p)            // 8
	testing.Println(q)            // 6
}
