package "main"

// Two imported packages share a final path segment ("thing"): pkg/aa/thing and
// pkg/bb/thing.  Every cross-package symbol of BOTH must mangle to its own full
// package path.  Regression: the IR-gen import registration qualified imported
// symbols (and resolved unqualified same-package field/return types via
// currentImportAlias) through the SHORT-NAME alias = last path segment, which
// first-wins-dedups, so the second same-segment package collapsed onto the
// first's path.  It surfaced as a hard clang "invalid redefinition of
// bn_pkg__aa__thing___Package" (the synthesized __Package extern is registered
// per import under the same name).  Exercises free funcs, extern vars, struct
// refs with unqualified local-type fields, methods, and a same-named interface
// + impl from both same-segment packages.
import aa "pkg/aa/thing"
import bb "pkg/bb/thing"

func main() {
	println(aa.AVal())
	println(bb.BVal())
	println(aa.Tag)
	println(bb.Mark)
	var ab aa.Box = aa.MakeBox(5)
	println(ab.Double())
	var bw bb.Widget = bb.MakeWidget(7)
	println(bw.Triple())
	var sa @aa.Speaker = aa.Voice(33)
	println(sa.Say())
	var sb @bb.Speaker = bb.Voice(44)
	println(sb.Say())
}
