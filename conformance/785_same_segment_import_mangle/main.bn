package "main"

// Two imported packages share a final path segment ("thing"): pkg/aa/thing and
// pkg/bb/thing.  Each must mangle to its OWN full package path.  Regression: the
// IR-gen import-alias map was keyed by the LAST path segment (shortName), so the
// second same-segment import collapsed onto the first — every pkg/bb/thing symbol
// resolved to pkg/aa/thing.  It surfaced as a hard clang error first, because the
// compiler-synthesized `_Package` extern is registered for EVERY import under the
// same name, so both emitted bn_pkg__aa__thing___Package ("invalid redefinition").
import aa "pkg/aa/thing"
import bb "pkg/bb/thing"

func main() {
	println(aa.AVal())
	println(bb.BVal())
}
