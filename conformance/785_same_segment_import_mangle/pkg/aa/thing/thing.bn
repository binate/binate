package "pkg/aa/thing"

var Tag int = 111

func AVal() int { return 11 }
func MakeBox(x int) Box {
	var b Box
	b.v = x
	b.nest.z = x * 100
	return b
}
func (b Box) Double() int { return b.v * 2 + b.nest.z }
func (c *Cat) Say() int { return c.n }
func Voice(x int) @Speaker {
	var c @Cat = make(Cat)
	c.n = x
	return c
}
