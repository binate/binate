package "pkg/bb/thing"

var Mark int = 222

func BVal() int { return 22 }
func MakeWidget(x int) Widget {
	var g Widget
	g.w = x
	g.pt.z = x * 100
	return g
}
func (g Widget) Triple() int { return g.w * 3 + g.pt.z }
func (d *Dog) Say() int { return d.n }
func Voice(x int) @Speaker {
	var d @Dog = make(Dog)
	d.n = x
	return d
}
