package "main"
import "pkg/builtins/testing"

// Verifies parallel assignment of a managed struct VALUE returned from a CALL
// (`a, x = makeHolder(55), 9`).  Unlike a swap of struct variables, the RHS
// here is an owned aggregate temporary; phase 1 must snapshot+acquire its
// managed field and phase 2 release the overwritten occupant, leaving the new
// object solely owned with refcount 1 (no leak, no double-free).

import "pkg/builtins/rt"

type Inner struct { V int }
type Holder struct { Obj @Inner }

func makeHolder(v int) Holder {
	var h Holder
	h.Obj = make(Inner)
	h.Obj.V = v
	return h
}

func main() {
	var a Holder
	a.Obj = make(Inner)
	a.Obj.V = 1
	var x int = 0
	// Managed struct VALUE from a call on the RHS of a parallel assignment.
	a, x = makeHolder(55), 9
	testing.Println(a.Obj.V)                 // 55
	testing.Println(x)                       // 9
	var pa *uint8 = bit_cast(*uint8, a.Obj)
	testing.Println(rt.Refcount(pa))         // 1: a solely owns the new Inner
}
