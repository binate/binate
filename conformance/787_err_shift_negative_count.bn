package "main"
import "pkg/builtins/testing"

// A negative shift count traps at runtime: a shift count must be
// non-negative.  The count is a SIGNED runtime value read through a
// non-inlined function so it isn't constant-folded — a constant negative
// count is a compile error instead (rejected by checkShiftCountNonNegative).
// The guard is OP_SHIFT_CHECK, emitted before the shift; it calls
// rt.ShiftCheck, which aborts via rt.ShiftFail.

func negCount() int { return cast(int, 0) - cast(int, 1) }  // -1

func main() {
	var x int = 1
	var n int = negCount()
	testing.Println(x << n)
}
