package "main"

// unsafe_shl(v, n) / unsafe_shr(v, n) are the guard-free counterparts of
// `<<` / `>>` — no overshift guard, no negative-count check.  For an
// IN-RANGE count (which the contract requires) they behave exactly like the
// checked operators; that target-stable behavior is what this test pins.
// (The overshift case is target-defined and intentionally not asserted.)
// Counts are read through an opaque fn so they are genuine runtime values —
// proving the guard is skipped even for a runtime count.

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func opaqueI(x int) int { return x }

func main() {
	var x int = 5
	var n int = opaqueI(3)
	println(bi(unsafe_shl(x, n) == 40))                 // 5 << 3 = 40
	println(bi(unsafe_shr(cast(int, 40), n) == 5))      // 40 >> 3 = 5
	// The result type is the LEFT (value) operand's; the count may be a
	// different/wider type (here int shifting an int8).  Arithmetic >> for a
	// signed value.
	var neg int8 = cast(int8, 0) - cast(int8, 8)        // -8
	println(bi(unsafe_shr(neg, opaqueI(2)) == (cast(int8, 0) - cast(int8, 2)))) // -8 >> 2 = -2
	var u uint8 = cast(uint8, 0x80)
	println(bi(unsafe_shl(u, opaqueI(1)) == cast(uint8, 0)))  // 0x80 << 1 = 0 (u8 wrap)
}
