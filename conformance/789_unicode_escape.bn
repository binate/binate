package "main"
import "pkg/builtins/testing"

// A \uHHHH escape expands at compile time to the UTF-8 encoding of code
// point U+HHHH (1-3 bytes).  Strings remain byte sequences — there is no
// runtime Unicode machinery — so the bytes are observable directly.  In a
// char literal only U+0000..U+007F (one byte) is allowed, and its value is
// the code point itself.

func main() {
	// "a" + U+00E9 (e-acute, C3 A9) + U+20AC (euro, E2 82 AC) = 1+2+3 bytes.
	var s @[]readonly char = "a\u00e9\u20ac"
	testing.Println(len(s))          // 6
	testing.Println(cast(int, s[0])) // 97  ('a')
	testing.Println(cast(int, s[1])) // 195 (0xC3)
	testing.Println(cast(int, s[2])) // 169 (0xA9)
	testing.Println(cast(int, s[3])) // 226 (0xE2)
	testing.Println(cast(int, s[4])) // 130 (0x82)
	testing.Println(cast(int, s[5])) // 172 (0xAC)

	// ASCII \u in a char literal equals the code point.
	var c char = '\u0041'
	testing.Println(cast(int, c))    // 65
}
