package "main"
import "pkg/builtins/testing"

// Malformed \u escapes are compile errors: too few hex digits, a
// UTF-16 surrogate code point, or a multi-byte code point in a char
// literal (which holds a single byte).

func main() {
	testing.Println(len("\u12"))   // too few hex digits (needs four)
	testing.Println(len("\ud800")) // a UTF-16 surrogate, not a scalar value
	var c char = '\u00e9'  // multi-byte: cannot fit a single-byte char
	testing.Println(cast(int, c))
}
