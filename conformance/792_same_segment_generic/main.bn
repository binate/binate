package "main"

// Same-final-segment imports of GENERIC decls (pkg/aa/gen, pkg/bb/gen, both end
// in "gen").  aa.Pick returns its FIRST arg, bb.Pick its SECOND, so distinct
// resolution must yield 100 then 200.  This pins that a generic-func
// instantiation is keyed by its DEFINING package, not the consumer: otherwise
// aa.Pick[int] and bb.Pick[int] mangle to the same per-(decl,args) symbol and
// the second body is dropped, so bb.Pick resolves to aa.Pick (-> 100, 100).
import aa "pkg/aa/gen"
import bb "pkg/bb/gen"

func main() {
	println(aa.Pick[int](100, 200))
	println(bb.Pick[int](100, 200))
}
