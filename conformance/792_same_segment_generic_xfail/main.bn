package "main"

// Same-final-segment imports of GENERIC decls (pkg/aa/gen, pkg/bb/gen, both end
// in "gen").  aa.Pick returns its FIRST arg, bb.Pick its SECOND, so distinct
// resolution yields 100 then 200.
//
// DEFERRED regression: the generic monomorphization keys collide for same-final-
// segment packages (the per-(decl,args) instantiation isn't qualified by the full
// package path), so bb.Pick resolves to aa.Pick (returns x) -> 100, 100.  The
// NON-generic same-segment cases are fixed (conformance/785); fixing this needs
// the monomorphized symbol + the generic-decl stash key to carry the full path.
import aa "pkg/aa/gen"
import bb "pkg/bb/gen"

func main() {
	println(aa.Pick[int](100, 200))
	println(bb.Pick[int](100, 200))
}
