package "main"

// The runtime negative-shift-count panic must fire for the COMPOUND-ASSIGN
// form too: the IDENT lvalue arm must not pre-truncate the count (which would
// hide a wide negative count's sign).  A signed runtime negative count drives
// `x <<= n` and must abort with "runtime error: negative shift count".

func negCount() int { return cast(int, 0) - cast(int, 1) }  // -1

func main() {
	var x int = 1
	x <<= negCount()
	println(x)
}
