package "main"
import "pkg/builtins/testing"

// The runtime negative-shift-count panic must fire for the COMPOUND-ASSIGN
// form even when the count is of a type WIDER than the lvalue — the IDENT
// lvalue arm must NOT pre-truncate the count (which would narrow a wide
// negative count's sign away).  Here int16 -256 = 0xFF00; truncated to the
// int8 lvalue it would be 0x00 (non-negative) and slip the guard.  The count
// is read through an opaque fn so it is a genuine runtime value (a constant
// negative count is a compile error instead).  Must abort with
// "runtime error: negative shift count".

func negWide() int16 { return cast(int16, 0) - cast(int16, 256) }  // -256

func main() {
	var x int8 = 1
	x <<= negWide()
	testing.Println(cast(int, x))
}
