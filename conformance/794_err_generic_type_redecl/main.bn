package "main"

import "pkg/genbox"

// pkg/genbox declares the generic type Box[T] FULL in both its .bni and its
// .bn.  The no-full-redeclaration rule rejects this for generic types just
// as for non-generic ones (conformance/801) — so this must fail to compile.
func main() {
	var b genbox.Box[int]
	b.v = 7
	println(b.v)
}
