package "pkg/genbox"

// Box[T] is declared FULL here AND in genbox.bni — the generic analog of
// the full-in-both redeclaration that conformance/801 rejects.  A layout
// disagreement between the two would silently miscompile, so the rule
// rejects it: a type may be declared in full at most once per package,
// generic or not.
type Box[T any] struct {
	v T
}

func Sentinel() int { return 1 }
