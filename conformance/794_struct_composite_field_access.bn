package "main"

// Verifies reading a field directly off a struct composite-literal rvalue:
// `Foo{...}.field` (and the paren form `(Foo{...}).field`).  Pre-fix, IR-gen's
// genSelector had no EXPR_COMPOSITE base case, so the base fell through to the
// EmitConstInt(0) fallback and EVERY such read silently produced 0.  A field
// read off a variable or a method call on the composite already worked; only
// the immediate field read off the composite rvalue was wrong.

type P struct {
	a int
	b int
}

type Box struct {
	V int
}

type Holder struct {
	Obj @Box
}

func main() {
	// No-paren form.
	println(P{a: 3, b: 4}.a)         // 3
	println(P{a: 3, b: 4}.b)         // 4
	// Paren form (value-expression parens are transparent).
	println((P{a: 5, b: 6}).a)       // 5
	println((P{a: 5, b: 6}).b)       // 6
	// Positional composite.
	println(P{7, 8}.a)               // 7
	println(P{7, 8}.b)               // 8
	// Field read off a composite with a managed field: the @Box materialized
	// inside the literal is reachable, and reading its scalar sub-field works.
	println(Holder{Obj: make(Box)}.Obj.V)   // 0 (fresh Box, V defaults to 0)
}
