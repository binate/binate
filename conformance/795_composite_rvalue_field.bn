package "main"

// Reading a field directly off a struct composite-literal rvalue
// (`Point{...}.field`) must yield the field value, not 0.  Previously the
// selector codegen had no case for a composite base and fell through to a
// constant-0 fallback (and never even evaluated the composite, dropping
// its side effects).  Covers scalar fields, in-expression use, a
// struct-typed field, a nested read (`Line{...}.p.x`), and a composite
// with managed fields (whose temp must be cleaned up, not leaked).

type Point struct { x int; y int }
type Line struct { p Point; q Point }
type Box struct { data @[]int; tag int }

func fill() @[]int {
	var s @[]int = make_slice(int, 2)
	s[0] = 10
	s[1] = 20
	return s
}

func main() {
	// scalar field reads off a composite rvalue
	println(Point{x: 3, y: 4}.x) // 3
	println(Point{x: 3, y: 4}.y) // 4
	// in a larger expression
	println(Point{x: 3, y: 4}.x + Point{x: 5, y: 6}.y) // 9
	// struct-typed field read off a composite rvalue
	var pt Point = Line{p: Point{x: 7, y: 8}, q: Point{x: 9, y: 1}}.p
	println(pt.x) // 7
	// nested field read off a composite rvalue (via the field-pointer path)
	println(Line{p: Point{x: 11, y: 12}, q: Point{x: 0, y: 0}}.p.x) // 11

	// a composite with a managed field: reading the non-managed field must
	// not leak the managed one (the temp is registered for cleanup).
	println(Box{data: fill(), tag: 13}.tag) // 13
	// reading the managed field itself, then using it
	var d @[]int = Box{data: fill(), tag: 0}.data
	println(len(d)) // 2
	println(d[1])   // 20
	// refcount churn: read a field off a managed composite in a loop
	var sum int = 0
	for i := 0; i < 100; i++ {
		sum = sum + Box{data: fill(), tag: 1}.tag
	}
	println(sum) // 100
}
