package "main"
import "pkg/builtins/testing"

import "pkg/store"

// Writing a slice ELEMENT through an imported RAW-slice var (`store.RS[i] = v`).
// RS is a `*[]int` extern var viewing the package's own backing array, so the
// write must reach that real storage — confirmed two ways: reading the element
// back through the same extern var, and through the owner's store.Get(i) (and
// the backing store.Arr directly).  This is the raw-`*[]T`-element-write facet
// of the cross-package extern-var lvalue path (558 covers the managed-slice
// `@[]T` element write; 686 covers field writes through value-struct/raw-ptr
// vars).
func main() {
	testing.Println(store.RS[0])     // 10 (initial backing value, via the extern var)
	store.RS[0] = 42         // element write through the imported *[]int var
	store.RS[2] = 99
	testing.Println(store.RS[0])     // 42 (read back through the extern var)
	testing.Println(store.RS[2])     // 99
	testing.Println(store.Get(0))    // 42 (owner-visible: the write reached real storage)
	testing.Println(store.Get(2))    // 99
	testing.Println(store.Arr[0])    // 42 (the backing array itself)
}
