package "pkg/store"

// Backing storage owned by the package, plus a raw slice (`*[]int`) viewing
// it.  The raw slice is the extern var whose ELEMENT writes main exercises.
var Arr [3]int = [3]int{10, 20, 30}
var RS *[]int = Arr[:]

// Get reads an element back through the package's own view of RS, so main can
// confirm a cross-package `store.RS[i] = v` write reached the real storage.
func Get(i int) int {
	return RS[i]
}
