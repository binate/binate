package "main"
import "pkg/builtins/testing"

// Sibling of 793 for the `>>=` (SHR) compound form: the runtime
// negative-shift-count panic must fire there too.  The count is of a type
// WIDER than the lvalue (int16 -256 = 0xFF00, which truncated to the int8
// lvalue is 0x00 = non-negative) and read through an opaque fn so it is a
// genuine runtime value.  Must abort with "runtime error: negative shift count".

func negWide() int16 { return cast(int16, 0) - cast(int16, 256) }  // -256

func main() {
	var x int8 = cast(int8, 0xF)
	x >>= negWide()
	testing.Println(cast(int, x))
}
