package "main"

// A huge POSITIVE constant shift count >= 2^63 (a defined overshift) must
// compile and overshift to 0 — not be rejected as negative, and not run as the
// hardware-masked `x << 0`.  Stored as a signed-negative IntVal, so both the
// checker gate (LitSign from the folder) and emitConstOvershiftOrNil (unsigned
// magnitude compare) must treat it as a positive overshift.  Each line is a
// target-stable 0/1 self-check.

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var a int = 1
	println(bi((a << 0x8000000000000000) == 0))   // bare 2^63 literal -> 0
	println(bi((a << (1 << 63)) == 0))             // computed 2^63 -> 0
	var u uint8 = cast(uint8, 0xFF)
	println(bi((u << 0xFFFFFFFFFFFFFFFF) == cast(uint8, 0)))  // huge -> 0 (u8)
	var s int8 = cast(int8, 0) - cast(int8, 4)     // -4
	println(bi((s >> 0x8000000000000000) == (cast(int8, 0) - cast(int8, 1)))) // arith >> overshift -> -1
}
