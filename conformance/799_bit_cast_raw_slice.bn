package "main"
import "pkg/builtins/testing"

// bit_cast of a raw slice to another same-size raw slice is a {ptr,len}-identical
// header reinterpret (a runtime no-op): the backing bytes are reinterpreted under
// the new element type.  A raw slice stays a direct OP_BIT_CAST (its %BnSlice
// header is element-agnostic), unlike the by-address/by-value aggregates that
// route through a scratch round-trip.  Element sizes need not match (see 800 /
// the checker tests); this test keeps them equal so the reinterpreted values are
// meaningful.

func main() {
	// readonly char slice viewed as readonly uint8 (char == uint8 alias)
	var cs *[]readonly char = "hi"
	var us *[]readonly uint8 = bit_cast(*[]readonly uint8, cs)
	testing.Println(len(us)) // 2

	// signed/unsigned element retype of a mutable byte buffer
	var buf [2]uint8 = [2]uint8{200, 5}
	var u *[]uint8 = buf[:]
	var s *[]int8 = bit_cast(*[]int8, u)
	testing.Println(len(s)) // 2
	testing.Println(cast(int, s[0])) // -56 (200 reinterpreted as int8)
	testing.Println(cast(int, s[1])) // 5
	testing.Println(cast(int, u[0])) // 200 (original unsigned view)
}
