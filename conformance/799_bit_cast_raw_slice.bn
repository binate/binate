package "main"
import "pkg/builtins/testing"

// bit_cast of a raw slice to another raw slice with same-size, non-managed
// element types is a {ptr,len}-identical element retype (a runtime no-op):
// the backing bytes are reinterpreted under the new element type.  This is
// the one aggregate shape bit_cast supports; native used to emit invalid
// `add %BnSlice, 0` for it (the VM accepted it — a mode divergence).

func main() {
	// readonly char slice viewed as readonly uint8 (char == uint8 alias)
	var cs *[]readonly char = "hi"
	var us *[]readonly uint8 = bit_cast(*[]readonly uint8, cs)
	testing.Println(len(us)) // 2

	// signed/unsigned element retype of a mutable byte buffer
	var buf [2]uint8 = [2]uint8{200, 5}
	var u *[]uint8 = buf[:]
	var s *[]int8 = bit_cast(*[]int8, u)
	testing.Println(len(s)) // 2
	testing.Println(cast(int, s[0])) // -56 (200 reinterpreted as int8)
	testing.Println(cast(int, s[1])) // 5
	testing.Println(cast(int, u[0])) // 200 (original unsigned view)
}
