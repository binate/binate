package "main"
import "pkg/builtins/testing"
import "pkg/builtins/rt"

// bit_cast reinterprets same-size aggregates with NO value conversion and NO
// reference taken.  How an aggregate is stored (by address vs by value) is a
// backend/ABI matter IR-gen reconciles via a scratch round-trip, not a language
// restriction — so struct<->struct, an array element retype, an aggregate<->
// scalar reinterpret, and a managed pointer viewed as its raw bits all work, and
// a managed operand keeps its refcount (bit_cast takes no reference, spec §8.6).

type P struct { a int; b int }
type Q struct { x int; y int }
type Box struct { v int }
// One-word struct, to exercise the aggregate<->scalar reinterpret.
type W struct { n int }

func main() {
	// struct <-> struct (same 2-word layout), a by-value aggregate reinterpret.
	var p P = P{a: 7, b: 9}
	var q Q = bit_cast(Q, p)
	testing.Println(q.x)              // 7
	testing.Println(q.y)              // 9

	// array element retype ([2]int -> [2]uint), same size.
	var arr [2]int = [2]int{11, 22}
	var u [2]uint = bit_cast([2]uint, arr)
	testing.Println(cast(int, u[0])) // 11
	testing.Println(cast(int, u[1])) // 22

	// aggregate <-> scalar reinterpret across the storage boundary (a one-word
	// struct and `int` are both one word).
	var w W = W{n: 42}
	var i int = bit_cast(int, w)
	testing.Println(i)               // 42
	var nn int = 99
	var w2 W = bit_cast(W, nn)
	testing.Println(w2.n)            // 99

	// A managed pointer reinterpreted through an aggregate takes NO reference:
	// the box's refcount is unchanged by the bit_cast (a raw scratch round-trip,
	// no RefInc), and the box is released exactly once at scope end.
	var b @Box = make(Box)
	b.v = 5
	var raw *uint8 = bit_cast(*uint8, b)
	testing.Println(rt.Refcount(raw)) // 1
	var wp W = bit_cast(W, b)          // struct{n int} viewing the pointer bits
	testing.Println(rt.Refcount(raw)) // 1: bit_cast took no reference
	_ = wp
	testing.Println(b.v)               // 5: b intact
}
