package "main"
import "pkg/builtins/testing"

// bit_cast rejects aggregate operands/targets other than the supported
// raw-slice element retype: a managed slice (would need refcount-ownership
// semantics), a struct value (field-layout / managed-field footgun), and an
// array value.  Each fails at type-check, in every mode.

type Q struct { x int; y int }
type P struct { a int; b int }

func main() {
	var m @[]uint8 = make_slice(uint8, 2)
	var x @[]int8 = bit_cast(@[]int8, m) // managed slice — rejected
	var p P = P{a: 1, b: 2}
	var q Q = bit_cast(Q, p) // struct value — rejected
	var a [2]int = [2]int{1, 2}
	var bb [2]int = bit_cast([2]int, a) // array value — rejected
	testing.Println(len(x))
	testing.Println(q.x)
	testing.Println(bb[0])
}
