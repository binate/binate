package "main"

import "pkg/redecl"

// pkg/redecl declares type Thing FULL in both its .bni and its .bn — the
// banned full-in-both redeclaration.  The checker must reject it, so this
// program must fail to compile.  See plan-type-redecl.md.
func main() {
	var t @redecl.Thing = redecl.Make(7)
	println(t.V)
}
