package "pkg/redecl"

// Redeclaring Thing FULL here — it is already declared full in redecl.bni —
// is the banned full-in-both pattern.  The transparent form would omit this
// decl and use Thing from the .bni; the opaque form would make the .bni a
// `type Thing` forward decl.  Either way a full decl may appear once.
type Thing struct {
	V int
}

func Make(v int) @Thing {
	var t @Thing = make(Thing)
	t.V = v
	return t
}
