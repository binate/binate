package "main"

// A negative shift count hidden behind a cast must be rejected at COMPILE
// time, exactly like a bare `x << -3`.  `cast(int8, 0) - cast(int8, 3)`
// folds to -3; evalConstIntValue now sees through the casts (mirroring
// IR-gen's evalConstExpr) so checkShiftCountNonNegative rejects it —
// instead of the count reaching IR-gen's emitConstOvershiftOrNil, whose
// unsigned overshift compare would silently treat -3 as a huge overshift
// and yield 0.

const N int8 = cast(int8, 0) - cast(int8, 3)  // -3

func main() {
	var x int = 1
	println(x << N)
}
