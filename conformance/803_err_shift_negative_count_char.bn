package "main"
import "pkg/builtins/testing"

// A negative shift count hidden behind char-literal arithmetic must be
// rejected at compile time, like the cast case (802).  `cast(int, 'A') -
// cast(int, 'Z')` == 65 - 90 == -25; evalConstIntValue folds char literals
// (mirroring IR-gen's evalConstExpr) so checkShiftCountNonNegative sees the
// -25 instead of the count slipping to IR-gen and yielding 0.

const N int = cast(int, 'A') - cast(int, 'Z')  // -25

func main() {
	var x int = 1
	testing.Println(x << N)
}
