package "main"

import "pkg/negc"

// A negative shift count reached through a PACKAGE-QUALIFIED const (`x <<
// negc.NEG`) must be rejected at compile time, like the in-package and cast
// cases (802/803).  evalConstIntValue resolves the qualified const's folded
// value (mirroring IR-gen's evalConstExpr selector arm) so
// checkShiftCountNonNegative sees the -3 instead of the count slipping to
// IR-gen and being silently treated as a huge overshift (→ 0).
func main() {
	var x int = 1
	println(x << negc.NEG)
}
