package "main"
import "pkg/builtins/testing"

import "pkg/pc"

// A POSITIVE package-qualified const folds for an importer: as an array
// dimension (`[pc.SZ]int`) and as a shift count (`x << pc.SZ`).  The checker
// now folds imported const values (defineBniConst), matching IR-gen — so a
// cross-package const is usable where a constant integer is required, not
// rejected as "not a constant integer".  Covers a single const (SZ) and a
// grouped member (pc.G1).  Guards the no-over-rejection direction for the
// selector fold (804 covers the negative-reject direction).
func main() {
	var a [pc.SZ]int        // [5]int
	a[pc.SZ - 1] = 7
	testing.Println(len(a))         // 5
	testing.Println(a[4])           // 7
	var x int = 1
	testing.Println(x << pc.SZ)     // 1 << 5 == 32
	testing.Println(x << pc.G1)     // 1 << 8 == 256 (grouped const)
}
