package "main"
import "pkg/builtins/testing"

import "pkg/b"

// A TRANSITIVE .bni const (b.SZ == a.VAL == 7, where pkg/b imports pkg/a and
// main imports ONLY pkg/b) must fold CONSISTENTLY in the checker and IR-gen —
// across BOTH use sites that the regression bug hit:
//   * array dimension `[b.SZ]int`  (the memory-unsafe facet — a wrong N is a
//     wrong-size allocation), and
//   * shift count `<< b.SZ`        (the silently-wrong facet — a dropped const
//     read as 0 shifts by the wrong amount).
// The checker folds b.SZ via the loaded pkg/a scope and stamps the value on the
// initializer; IR-gen reads that stamp (importConstStampVal) instead of trying
// to resolve pkg/a through pkg/b's local import alias (which main never
// imports).  Before the fix the conservative guard left b.SZ value-less, so the
// ARRAY DIM was a clean reject ("array length must be a constant integer"); a
// POSITIVE shift count already resolved correctly in IR-gen.  The genuinely
// silent-miscompiled facet was a NEGATIVE transitive const as a shift count
// (the value-less const slipped past the negative-shift gate) — now cleanly
// rejected (conformance 869).  This test pins the positive facets; 869 pins the
// negative-reject one.

func main() {
	var arr [b.SZ]int          // dim folds to 7
	arr[b.SZ - 1] = 6          // index with the same const (slot 6)
	testing.Println(len(arr))          // 7
	testing.Println(arr[6])            // 6
	testing.Println(1 << b.SZ)         // 1 << 7 = 128
}
