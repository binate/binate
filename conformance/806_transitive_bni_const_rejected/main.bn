package "main"

import "pkg/b"

// A TRANSITIVE .bni const (b.SZ == a.VAL, where pkg/b imports pkg/a) used as
// an array dimension must be cleanly REJECTED, not silently miscompiled to a
// garbage size.  The checker leaves a selector-referencing .bni const value-
// less (defineBniConst's selector guard), because IR-gen's RegisterImport
// folds such a transitive const via pkg/b's local alias and drops it to
// garbage when this importer (main) does not also import pkg/a.  Keeping the
// two consistent makes this a compile error instead of an [N]int with a wrong
// N.  (main deliberately imports ONLY pkg/b.)
func main() {
	var a [b.SZ]int
	println(len(a))
}
