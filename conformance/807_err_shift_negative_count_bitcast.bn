package "main"
import "pkg/builtins/testing"

// A bit_cast that reinterprets a positive source into a NEGATIVE value, used
// as a shift count, must be rejected at compile time.  `bit_cast(int8,
// cast(uint8, 253))` is bit pattern 0xFD == -3 as int8; evalConstIntValue and
// IR-gen's evalConstExpr both fold it to -3 (shared ReinterpretBitCast), so
// checkShiftCountNonNegative rejects it instead of letting it overshift to 0.

func main() {
	var x int = 1
	testing.Println(x << bit_cast(int8, cast(uint8, 253)))
}
