package "main"
import "pkg/builtins/testing"

// A negated constant sizeof used as a shift count must be rejected at compile
// time.  `0 - cast(int, sizeof(int))` is negative; evalConstIntValue now folds
// sizeof (mirroring IR-gen's evalConstExpr) so checkShiftCountNonNegative sees
// the negative value instead of it slipping to IR-gen and overshifting to 0.

const N int = 0 - cast(int, sizeof(int))

func main() {
	var x int = 1
	testing.Println(x << N)
}
