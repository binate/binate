package "main"

// Opaque is a pure opaque type — a forward declaration with no full
// definition (its layout would be supplied externally, e.g. in C or
// assembly).  Pointers/handles to it are fine, but make / make_slice /
// sizeof / alignof all need the layout, which is not available, so each
// must be rejected.  This program must fail to compile.
type Opaque

// Handle is a distinct type OVER the opaque Opaque — just as layout-less, so
// the gate must peel to the bottom and reject make/sizeof on it too.
type Handle Opaque

func main() {
	var p @Opaque = make(Opaque)
	var sl @[]Opaque = make_slice(Opaque, 3)
	var s uint = sizeof(Opaque)
	var a uint = alignof(Opaque)
	var hp @Handle = make(Handle)
	var hs uint = sizeof(Handle)
	_ = p
	_ = sl
	_ = s
	_ = a
	_ = hp
	_ = hs
}
