package "main"

// Positive end-to-end guard for the const-fold shift/array-dim path: a cast,
// bit_cast, and char-arithmetic const all work as shift counts; compound
// <<= / >>= work; a cast-based const folds as an array dimension and indexes.

const A int = cast(int, 3)
const B int8 = bit_cast(int8, cast(uint8, 3))      // 3
const Ch int = cast(int, 'D') - cast(int, 'A')     // 68 - 65 == 3

func main() {
	var x int = 1
	println(x << A)      // 1 << 3 == 8
	println(x << B)      // 8
	println(x << Ch)     // 8
	x <<= A              // x == 8
	println(x)
	x >>= cast(int, 2)   // 8 >> 2 == 2
	println(x)
	var a [cast(int, 5)]int
	a[Ch + 1] = 9        // a[4] = 9
	println(len(a))      // 5
	println(a[4])        // 9
}
