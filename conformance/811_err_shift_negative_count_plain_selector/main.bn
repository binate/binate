package "main"
import "pkg/builtins/testing"

import "pkg/np"

// A PLAIN (non-cast) negative imported const used as a shift count is rejected
// — covers the plain-fold + cross-package selector read-back path that 804
// (cast-hidden) does not exercise.
func main() {
	var x int = 1
	testing.Println(x << np.NEG)
}
