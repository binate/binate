package "main"

// A malformed escape in a char literal used as an array dimension must be
// diagnosed, just as in value position.  Array dims fold via evalConstInt ->
// parseCharLiteral, which never runs checkExpr; validateDimCharLitEscapes
// restores the escape check so `['\q']int` is rejected rather than silently
// folded to [113]int.

func main() {
	var a ['\q']int
	println(len(a))
}
