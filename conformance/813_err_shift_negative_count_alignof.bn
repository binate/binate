package "main"
import "pkg/builtins/testing"

// A negated constant alignof used as a shift count must be rejected at compile
// time, like the sizeof case (808).  evalConstIntValue folds alignof, so the
// gate sees the negative value.

const N int = 0 - cast(int, alignof(int))

func main() {
	var x int = 1
	testing.Println(x << N)
}
