package "main"

// Positive end-to-end: sizeof / alignof / bit_cast / cast all fold as array
// dimensions.  Indexed with a plain int (an int8 index trips an unrelated
// bounds-check codegen path).

func main() {
	var a [sizeof(int)]int          // [8]int on a 64-bit target
	var b [alignof(int8)]int        // [1]int
	var c [bit_cast(int8, cast(uint8, 3))]int  // [3]int
	var d [cast(int, 4)]int         // [4]int
	a[7] = 70
	c[2] = 30
	d[3] = 40
	println(len(a))   // 8
	println(len(b))   // 1
	println(len(c))   // 3
	println(len(d))   // 4
	println(a[7])     // 70
}
