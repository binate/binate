package "main"

// Positive end-to-end: sizeof / alignof / bit_cast / cast all fold as array
// dimensions.  Uses sizeof(int32) (4 on every target) rather than sizeof(int)
// (pointer-width — 8 on a 64-bit target, 4 on a 32-bit one) so the dimensions,
// indices, and len() outputs are target-independent.  Indexed with a plain int
// (an int8 index trips an unrelated bounds-check codegen path).

func main() {
	var a [sizeof(int32)]int        // [4]int on every target
	var b [alignof(int8)]int        // [1]int
	var c [bit_cast(int8, cast(uint8, 3))]int  // [3]int
	var d [cast(int, 4)]int         // [4]int
	a[3] = 70
	c[2] = 30
	d[3] = 40
	println(len(a))   // 4
	println(len(b))   // 1
	println(len(c))   // 3
	println(len(d))   // 4
	println(a[3])     // 70
}
