package "main"
import "pkg/builtins/testing"

import "pkg/nbc"

// A bit_cast-reinterpreted negative imported const used as a shift count is
// rejected — exercises defineBniConst's bit_cast fold + cross-package read-back
// (804 covers cast-hidden; this covers bit_cast).
func main() {
	var x int = 1
	testing.Println(x << nbc.NEG)
}
