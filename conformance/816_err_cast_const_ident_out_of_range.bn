package "main"
import "pkg/builtins/testing"

// Casting an out-of-range CONSTANT to an integer type is an error even when the
// constant is a named const-ident, not a direct literal — a cast does not
// launder a constant.  Use bit_cast (same size) or masking to reinterpret.

const M int = 257

func main() {
	var v uint8 = cast(uint8, M)
	testing.Println(cast(int, v))
}
