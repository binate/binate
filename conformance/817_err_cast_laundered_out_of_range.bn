package "main"

// `cast(int8, cast(int, 200))` folds to the constant 200, which does not fit
// int8 — laundering an out-of-range constant through an inner cast no longer
// escapes the fit-check (DECIDED 2026-06-17: a cast of a constant is constant).

func main() {
	println(cast(int, cast(int8, cast(int, 200))))
}
