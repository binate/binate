package "main"
import "pkg/builtins/testing"

// An out-of-range constant cast in array-dimension position is rejected too —
// array dims fold via evalConstInt (bypassing checkExpr), so validateDimCasts
// runs the same fit-check there.  cast(int8, 200) does not fit int8.

func main() {
	var a [cast(int8, 200)]int
	testing.Println(len(a))
}
