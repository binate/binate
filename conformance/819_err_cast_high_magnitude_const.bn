package "main"

// A const whose magnitude is >= 2^63 is fit-checked EXACTLY (reconstructed
// from the symbol's bit pattern + declared signedness), not through the lossy
// host-int fold: 0x8000000000000000 == 2^63 does not fit int64 [-2^63, 2^63-1].
// To reinterpret the bits, use bit_cast (same size).

const M uint64 = 0x8000000000000000

func main() {
	var v int64 = cast(int64, M)
	println(cast(int, v))
}
