package "main"
import "pkg/builtins/testing"

import "pkg/qc"

// A package-qualified const operand is fit-checked too (castConstExactFits's
// EXPR_SELECTOR arm): qc.Big == 2^63 does not fit int64 even though it is
// stored as a negative host int.
func main() {
	var v int64 = cast(int64, qc.Big)
	testing.Println(cast(int, v))
}
