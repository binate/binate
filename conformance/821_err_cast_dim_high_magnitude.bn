package "main"

// An out-of-range cast in array-dimension position is rejected for a const-
// ident (exact via castConstExactFits) and a direct literal >= 2^63 (exact via
// the literal's bignum, since validateDimCasts checks literal operands).

const M uint64 = 0x8000000000000000

func main() {
	var a [cast(int64, M)]int
	println(len(a))
}
