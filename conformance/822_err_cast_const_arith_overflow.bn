package "main"

// KNOWN LIMITATION (claude-todo.md gap h-arith): a cast whose operand is CONST
// ARITHMETIC folding to a magnitude >= 2^63 is mis-judged by checkCastConstFits's
// host-int fold, so it is WRONGLY ACCEPTED instead of rejected.  A*B == 2^63 does
// not fit int64.  Expected to fail until const arithmetic is folded in bignum.

const A uint64 = 0x4000000000000000
const B uint64 = 2

func main() {
	var v int64 = cast(int64, A * B)
	println(cast(int, v))
}
