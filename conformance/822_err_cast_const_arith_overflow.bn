package "main"
import "pkg/builtins/testing"

// Const ARITHMETIC is fit-checked in bignum (foldConstNum), not the lossy host-
// int fold: A * B == 2^63 does not fit int64, so this is rejected (it was
// silently accepted before the bignum fold).  An overflow past 2^64-1 (e.g.
// A * A) is rejected too — it fits no integer type.

const A uint64 = 0x4000000000000000
const B uint64 = 2

func main() {
	var v int64 = cast(int64, A * B)
	testing.Println(cast(int, v))
}
