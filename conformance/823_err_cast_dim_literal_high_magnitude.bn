package "main"

// A direct LITERAL >= 2^63 cast in array-dimension position reports the cast
// fit-check diagnostic, not a wrong "array length must be non-negative":
// validateDimCasts checks a literal operand so it gets the exact bignum
// (without it, 0x8000000000000000 would host-wrap to -2^63 and trip the
// negative-length check instead).

func main() {
	var a [cast(int64, 0x8000000000000000)]int
	println(len(a))
}
