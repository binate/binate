package "main"

// An opaque type's layout is unavailable, so it cannot be embedded BY VALUE —
// not as a variable, a struct value field, an array element, or a by-value
// function parameter or return.  Each must be rejected (hold it via *Opaque /
// @Opaque instead).  This program must fail to compile.
type Opaque

type S struct {
	o Opaque
}

func byval(o Opaque) Opaque {
	return o
}

func main() {
	var x Opaque
	var a [3]Opaque
	_ = x
	_ = a
}
