package "main"

// 2^63+1 fits uint64 (it does not fit int64).  The bignum fold judges it
// exactly, so this is ACCEPTED (the host-int fold wrongly REJECTED it).

const A uint64 = 0x4000000000000000

func main() {
	var v uint64 = cast(uint64, A * 2 + 1)
	println(cast(int, bit_cast(int64, v)))   // 2^63+1 as int64 == -2^63+1
}
