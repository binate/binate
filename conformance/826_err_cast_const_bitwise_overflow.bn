package "main"

// KNOWN LIMITATION: bignum.Num models no bitwise ops, so a cast whose operand
// is a const BITWISE/shift expression folding to a magnitude >= 2^63 routes
// through the lossy host-int fold and is wrongly accepted.  A << 1 == 2^63 does
// not fit int64.  Expected to fail until bignum gains bitwise ops.

const A uint64 = 0x4000000000000000

func main() {
	var v int64 = cast(int64, A << 1)
	println(cast(int, v))
}
