package "main"
import "pkg/builtins/testing"

// Const BITWISE/shift over NON-NEGATIVE operands is folded exactly in bignum
// (foldConstNum -> Shl), not the lossy host-int fold: A << 1 == 2^63 does not
// fit int64, so this is rejected (it was silently accepted before bignum gained
// bitwise ops).  A shift past 2^64-1 (e.g. A << 3 == 2^65) is rejected too.

const A uint64 = 0x4000000000000000

func main() {
	var v int64 = cast(int64, A << 1)
	testing.Println(cast(int, v))
}
