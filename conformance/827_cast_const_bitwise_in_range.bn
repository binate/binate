package "main"
import "pkg/builtins/testing"

// A non-negative bitwise result may set bit 63 (value in [2^63, 2^64-1]); bignum
// judges it by its true magnitude.  M | 1 == 2^63+1 fits uint64 (not int64), so
// this is ACCEPTED (the host-int fold would have mis-folded it through a wrapped
// negative).
//
// The result is verified against the expected 64-bit value INSIDE Binate and a
// 32-bit-clean boolean is printed, so the test is target-independent (printing
// the value via `cast(int, ...)` would truncate to the low word where `int` is
// 32-bit).

const M uint64 = 0x8000000000000000
const EXPECT uint64 = (cast(uint64, 1) << 63) + 1   // 2^63+1

func main() {
	var v uint64 = cast(uint64, M | 1)
	var ok int = 0
	if v == EXPECT {
		ok = 1
	}
	testing.Println(ok)   // 1
}
