package "main"

// sizeof/alignof and bit_cast over an opaque type can reach the layout
// machinery (SizeOf) through contexts OTHER than a bare builtin call: a
// sizeof folded inside a cast, a sizeof used as an array dimension, and
// bit_cast's element-size equality check.  Each such context must reject the
// opaque type with a clean diagnostic — not crash the compiler.  This program
// must fail to compile.
type Opaque

func f(src *[]int8) {
	var n int = cast(int, sizeof(Opaque))
	var a [sizeof(Opaque)]int
	_ = bit_cast(*[]Opaque, src)
	_ = n
	_ = a
}

func main() {}
