package "main"

// sizeof/alignof and bit_cast over an opaque type can reach the layout
// machinery (SizeOf) through contexts OTHER than a bare builtin call: a
// sizeof folded inside a cast, a sizeof used as an array dimension, and
// bit_cast's operand-size comparison.  Each such context must reject the
// opaque type with a clean diagnostic — not crash the compiler.  bit_cast reuses
// the shared opaque guard (embedsOpaqueByValue), which treats a slice-of-opaque
// as needing the unavailable element layout, so `*[]Opaque` is rejected as an
// opaque-typed operand.  This program must fail to compile.
type Opaque

func f(src *[]int8) {
	var n int = cast(int, sizeof(Opaque))
	var a [sizeof(Opaque)]int
	_ = bit_cast(*[]Opaque, src)
	_ = n
	_ = a
}

func main() {}
