package "main"

// Const-folding of the signedness-DEPENDENT ops (/, %, >>) over an UNSIGNED
// operand >= 2^63 must use the unsigned / logical operation, not a signed
// host-int fold.  The checker (constIntFor) and IR-gen (genConst) both fold via
// the signedness-aware bignum value, in lockstep: `const Q uint64 = (2^63)/(2^61)`
// is 4, not the wrapped -4 that a signed host-int division would give.  Signed
// operands stay arithmetic.  Results are small, so the prints are 32-bit-clean.

const U uint64 = 0x8000000000000000   // 2^63
const D uint64 = 0x2000000000000000   // 2^61

const Q uint64 = U / D                // 4   (signed host-int fold gave -4)
const S uint64 = U >> 60              // 8   (signed/arithmetic >> gave -8)
const M uint64 = U % cast(uint64, 3)  // 2   (signed % gave -2)
const L uint64 = 0x8000000000000000 / 0x2000000000000000   // 4, untyped literals

// Signed operands must stay signed/arithmetic.
const NA int = (0 - 8) >> 1           // -4 (arithmetic right shift)
const NB int = (0 - 7) / 2            // -3
const NR int = (0 - 7) % 2            // -1

func main() {
	println(cast(int, Q))
	println(cast(int, S))
	println(cast(int, M))
	println(cast(int, L))
	println(NA)
	println(NB)
	println(NR)
}
