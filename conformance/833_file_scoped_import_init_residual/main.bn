package "main"

import "pkg/xf"

// KNOWN RESIDUAL of file-scoped imports: package-init combines every
// file's initializers into one synthetic body lowered under the merged
// import overlay, so a same-alias-different-package collision in a
// package-level var initializer across files mis-resolves (prints 1,1).
// Correct output is 1,2.  Marked .xfail.all until the residual is fixed.
func main() {
	println(xf.A)
	println(xf.B)
}
