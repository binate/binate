package "main"
import "pkg/builtins/testing"

// A generic instantiation used as a free-function PARAMETER type is instantiated
// during pass-1 collection, before the method decl below.  The method must still
// resolve on it (population-ordering back-fill).

type Box[T any] struct {
	val T
}

func consume(b Box[int]) int {
	return b.Get()
}

func (b *Box[T]) Get() T {
	return b.val
}

func main() {
	var b Box[int]
	b.val = 3
	testing.Println(consume(b))
}
