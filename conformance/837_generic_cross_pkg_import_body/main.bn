package "main"
import "pkg/builtins/testing"

import "pkg/genlib"

// Instantiating genlib.Id[int] monomorphizes its body HERE.  The body's
// `dep.V()` names genlib's import, which main does not import: it calls
// pkg/dep's V (an unresolved one would be an LLVM `undefined value @bn_F...`).
// Correct output: 42.
func main() { testing.Println(genlib.Id[int](42)) }
