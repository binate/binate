package "main"

import "pkg/genlib"

// Instantiating genlib.Id[int] monomorphizes its body HERE.  The body's
// `dep.V()` must resolve against genlib's imports, but generic instantiation
// resolves the body under the USE-SITE (main) scope/alias-map instead, so
// `dep` (not imported by main) mis-resolves -> LLVM `undefined value @bn_dep__V`
// (checker does not catch it).  Correct output: 42.  Tracked CRITICAL bug.
func main() { println(genlib.Id[int](42)) }
