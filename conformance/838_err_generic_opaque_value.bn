package "main"

// Instantiating a generic struct that uses its type-param BY VALUE with an
// opaque type (`Box[Opaque]`, field `v T`) forms an opaque value, which the
// checker rejects (embedsOpaqueByValue recurses the instantiated struct, at the
// var and make sites).  Without that, IR-gen would lay Box[Opaque] out as a
// fabricated i64 AND mangle it to the same symbol as a real Box[int] in the
// same program — a wrong-layout symbol collision.  A pointer-held type-param
// (Box[int], Box[*Opaque]) stays legal.  This program must fail to compile.
type Opaque

type Box[T any] struct { v T }

func f() {
	var bad Box[Opaque]
	var alsoBad @Box[Opaque] = make(Box[Opaque])
	var okInt Box[int]
	var okPtr Box[*Opaque]
	_ = bad
	_ = alsoBad
	_ = okInt
	_ = okPtr
}

func main() {}
