package "main"

// Instantiating a generic FUNCTION or INTERFACE whose (substituted) param or
// result embeds an opaque value by value forms an opaque value: `mk[Opaque]()`
// returns one (and would otherwise silently monomorphize to an i64-returning
// function colliding with `mk[int]`), and `Getter[Opaque]`'s method `get() T`
// returns one.  The checker rejects both at instantiation.  A type-param used
// only behind a pointer (mk[int], Getter[int], ptr[Opaque] with *T) stays
// legal.  This program must fail to compile.
type Opaque

func mk[T any]() T { var z T; return z }

func ptr[T any](x *T) *T { return x }

interface Getter[T any] { get() T }

func f(o *Opaque, gi @Getter[int]) {
	_ = mk[Opaque]()
	_ = ptr[Opaque](o)
	var n int = mk[int]()
	_ = n
	_ = gi
}

func badIface(g @Getter[Opaque]) { _ = g }

func main() {}
