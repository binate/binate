package "main"

// KNOWN BUG (h-cmp): a constant relational comparison of UNSIGNED operands >= 2^63
// is folded with a SIGNED host-int compare in both the checker (evalConstBool)
// and IR-gen (evalConstExpr LT/GT), so `const C bool = U > D` (2^63 > 2^61) folds
// to FALSE instead of true — a silent miscompile.  Separate fold path from the
// /,%,>> fix (829); needs the same signedness-aware treatment for comparisons.

const U uint64 = 0x8000000000000000   // 2^63
const D uint64 = 0x2000000000000000   // 2^61
const C bool = U > D                   // unsigned: true

func main() {
	if C {
		println(1)
	} else {
		println(0)
	}
}
