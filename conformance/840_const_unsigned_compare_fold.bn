package "main"
import "pkg/builtins/testing"

// A constant relational comparison (<,>,<=,>=,==,!=) of UNSIGNED operands >= 2^63
// must fold UNSIGNED, not with a signed host-int compare.  The checker folds the
// comparison via the exact bignum value (foldConstNum) ordered with Num.Cmp and
// stamps the boolean on the initializer (attachConstBoolVal); IR-gen's genConst
// reads that stamp instead of re-folding via the host-int evalConstBool, which
// would compare `U > D` (2^63 > 2^61) as two NEGATIVE host ints and fold to false
// — a silent miscompile.  Signed comparisons are unaffected (host-int evalConstBool
// is already correct for them); the (-8) cases pin that.  The AND/OR cases pin the
// FALLBACK: when an unsigned comparison is nested in &&/|| with an unfoldable bool
// const ident, the checker stamp bails and IR-gen's evalConstBool folds the whole
// expression — its relational arm must also compare the unsigned operand UNSIGNED.

const U uint64 = 0x8000000000000000   // 2^63
const D uint64 = 0x2000000000000000   // 2^61
const BT bool = true
const BF bool = false

const GT bool = U > D                  // unsigned: true
const LT bool = U < D                  // false
const GE bool = U >= U                 // true
const LE bool = D <= U                 // true
const EQ bool = U == D                 // false
const NE bool = U != D                 // true
const LIT bool = 0x8000000000000000 > 0x4000000000000000   // untyped literals: true
const NSGT bool = (0 - 8) > (0 - 4)    // signed: -8 > -4 = false
const NSLT bool = (0 - 8) < (0 - 4)    // signed: -8 < -4 = true

const AND2 bool = BT && (U > 5)        // true  (bool ident + unsigned compare, &&)
const REV bool = (U > 5) && BT         // true  (other operand order)
const OR2 bool = BF || (U < 5)         // false (bool ident + unsigned compare, ||)

func p(b bool) {
	if b {
		testing.Println(1)
	} else {
		testing.Println(0)
	}
}

func main() {
	p(GT)    // 1
	p(LT)    // 0
	p(GE)    // 1
	p(LE)    // 1
	p(EQ)    // 0
	p(NE)    // 1
	p(LIT)   // 1
	p(NSGT)  // 0
	p(NSLT)  // 1
	p(AND2)  // 1
	p(REV)   // 1
	p(OR2)   // 0
}
