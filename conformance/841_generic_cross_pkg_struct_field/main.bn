package "main"

import "pkg/genlib"

// genlib.Box[int] embeds a by-value field of type dep.Pair, where dep is
// imported only by genlib, NOT by main.  Instantiating Box[int] monomorphizes
// the field HERE; the qualified field type dep.Pair must resolve against
// genlib's imports, not main's alias map (where dep is absent) — otherwise the
// field's layout is wrong and b.p.x / b.p.y read garbage.  Want: 17.
func main() {
	var b @genlib.Box[int] = genlib.Make[int](7, 8)
	println(genlib.Total[int](b))
}
