package "pkg/genlib"

import "pkg/dep"

// Generic struct with a by-value field whose type is genlib's OWN import
// dep.Pair.  Instantiating Box[T] at a consumer monomorphizes these fields
// there; the qualified field type dep.Pair must resolve against genlib's
// imports (not the consumer's alias map), or the field's layout is wrong.
type Box[T any] struct { tag T; p dep.Pair }

// Bodies live in the .bni (generic).  Make populates the by-value Pair field
// with make + field stores — builtins, no dep function call — so this isolates
// the struct-field-layout facet from the transitive-extern func-call facet
// (conformance 837).
func Make[T any](t T, base int) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.tag = t
	b.p.x = base
	b.p.y = base + 1
	return b
}

func Total[T any](b @Box[T]) int { return b.p.x + b.p.y }
