package "main"

// A composite literal or an inferred var that FORMS an opaque (or
// opaque-embedding) value is rejected: `Opaque{}`, `Box[Opaque]{}`, and an
// inferred `var c = *opaquePtr` (deref load).  A concrete composite literal or
// inferred var stays legal.  This program must fail to compile.
type Opaque

type Box[T any] struct { v T }

func g() *Opaque { return nil }

type Point struct { x int }

func f() {
	var a = Opaque{}
	var b = Box[Opaque]{}
	var c = *g()
	var ok = Point{1}
	var okn = 5
	_ = a
	_ = b
	_ = c
	_ = ok
	_ = okn
}

func main() {}
