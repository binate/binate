package "main"
import "pkg/builtins/testing"

// The signedness-aware const-fold (/, %, >> over an unsigned operand >= 2^63)
// must reach IMPORTED .bni consts.  The checker's defineBniConst folds the
// imported initializer via the signedness-aware bignum value (foldConstIntValue)
// and stamps it on the initializer's ExprType; IR-gen's import-registration path
// reads that stamp (via gc.Mod.Checker.ExprType) instead of re-folding via the
// host-int evalConstExpr.  So an imported `const Q uint64 = U / D` (2^63 / 2^61)
// is 4, not the signed -4, in BOTH the checker (here used as an array dimension)
// and at the runtime read site.  Signed imported consts are unaffected.

import "pkg/uc"

func main() {
	testing.Println(cast(int, uc.Q))   // 4
	testing.Println(cast(int, uc.R))   // 2
	testing.Println(cast(int, uc.S))   // 8
	testing.Println(uc.NEG)            // -4

	// The CHECKER's imported-const value (defineBniConst) used as an array
	// dimension: the signed -4 would be rejected ("array length must be
	// non-negative"); the unsigned 4 lays out a [4]int.
	var arr [uc.Q]int
	arr[0] = 1
	testing.Println(cast(int, len(arr)))   // 4
}
