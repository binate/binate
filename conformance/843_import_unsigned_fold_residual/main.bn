package "main"

// KNOWN BUG (h-bni): the signedness-aware const-fold (05d08117) doesn't reach
// IMPORTED .bni consts.  defineBniConst (checker) folds via the host-int
// evalConstIntValue and gen_import via evalConstExpr, so an imported
// `const Q uint64 = U / D` (U=2^63, D=2^61) is read as -4, not 4.

import "pkg/uc"

func main() {
	if uc.Q == cast(uint64, 4) {
		println(1)
	} else {
		println(0)
	}
}
