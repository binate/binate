package "pkg/uc"

const U uint64 = 0x8000000000000000   // 2^63
const D uint64 = 0x2000000000000000   // 2^61
const Q uint64 = U / D                // 4   (signed host-int fold gave -4)
const R uint64 = U % cast(uint64, 3)  // 2   (signed % gave -2)
const S uint64 = U >> 60              // 8   (arithmetic >> gave -8)
const NEG int = (0 - 8) / 2           // -4  (signed, unaffected)
