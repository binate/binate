package "main"

// The signedness-aware const-fold (/, %, >> over an unsigned operand >= 2^63)
// must apply to EXPLICIT grouped const members, not only single consts.  The
// checker stamps each explicit member's value on its own ExprType node
// (IsConstStamp); genConstGroup reads that stamp instead of re-folding via the
// host int, so `Q uint64 = U / D` (2^63 / 2^61) folds to 4, not the signed
// host-int -4.  A BARE-repeat iota member re-uses the preceding member's shared
// node, so it keeps the host-int fold (the IsConstStamp marker keeps IR-gen from
// misreading checkExpr's incidental HasLitVal on that shared node) — the iota
// subgroup below pins that bare members still fold correctly.

const (
	U uint64 = 0x8000000000000000   // 2^63
	D uint64 = 0x2000000000000000   // 2^61
	Q uint64 = U / D                // 4   (signed host-int fold gave -4)
	R uint64 = U % cast(uint64, 3)  // 2   (signed % gave -2)
	S uint64 = U >> 60              // 8   (arithmetic >> gave -8)
)

// A bit-flag iota group: F0 is explicit, F1..F3 are bare repeats of `1 << iota`
// at successive iotas — the shared-node case.
const (
	F0 int = 1 << iota   // 1
	F1                   // 2
	F2                   // 4
	F3                   // 8
)

func main() {
	println(cast(int, Q))   // 4
	println(cast(int, R))   // 2
	println(cast(int, S))   // 8
	println(F0)             // 1
	println(F1)             // 2
	println(F2)             // 4
	println(F3)             // 8
}
