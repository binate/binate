package "main"

// KNOWN BUG (h-group): the signedness-aware const-fold (05d08117) is gated to
// SINGLE consts.  A GROUPED member `Q uint64 = U / D` (U=2^63, D=2^61) still
// folds with a SIGNED host int on both the checker and IR-gen, so Q is -4, not
// 4 — a silent miscompile.  Excluded deliberately (InConstGroup) to avoid a
// checker/IR desync; the proper fix wires genConstGroup to the ExprType stamp.

const (
	U uint64 = 0x8000000000000000
	D uint64 = 0x2000000000000000
	Q uint64 = U / D
)

func main() {
	if Q == cast(uint64, 4) {
		println(1)
	} else {
		println(0)
	}
}
