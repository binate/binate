package "main"

// KNOWN BUG (h-inline-shift): a CONST-FOLDED inline shift of a negative literal
// in value position is emitted as a LOGICAL shift of the two's-complement bit
// pattern instead of an ARITHMETIC shift.  `(0 - 16) >> 2` is -4 (arithmetic),
// but genBinary's const-fold emits (2^N-16)>>2.  Distinct fold path from the
// const-decl fix (05d08117).  Silent — the cast-fit check sees the negative
// operand and routes to the host-int fold, so no diagnostic fires.

func main() {
	var y int = (0 - 16) >> 2
	if y == (0 - 4) {
		println(1)
	} else {
		println(0)
	}
}
