package "main"
import "pkg/builtins/testing"

// A const-folded inline `>>` of a NEGATIVE operand in value position must be an
// ARITHMETIC (sign-extending) shift, not a logical shift of the two's-complement
// bit pattern.  `(0 - 16) >> 2` is -4 (floor(-16 / 4)).  The checker's
// foldIntBitwise bailed on a negative operand, so the binop got a value-less
// untyped-int result type and IR-gen emitted a RUNTIME shift whose untyped-int
// (unsigned) operand lowered to `lshr` — a silent miscompile ((2^64-16) >> 2).
// foldIntBitwise now folds the negative `>>` arithmetically (matching IR-gen's
// evalConstExpr host-int fold), so genBinary materializes the exact constant.
// A positive `>>` (logical == arithmetic) and `<<` of a negative (sign-agnostic)
// are controls.

func eq(a int, b int) {
	if a == b {
		testing.Println(1)
	} else {
		testing.Println(0)
	}
}

func main() {
	var a int = (0 - 16) >> 2     // -4   (exact)
	var b int = (0 - 17) >> 2     // -5   (floor(-17/4), not -4)
	var c int = (0 - 1) >> 5      // -1   (sign-fill)
	var d int = (0 - 16) >> 0     // -16  (no shift)
	var e int = 48 >> 2           // 12   (positive: logical == arithmetic)
	var f int = (0 - 16) << 2     // -64  (<< is sign-agnostic)
	eq(a, 0 - 4)    // 1
	eq(b, 0 - 5)    // 1
	eq(c, 0 - 1)    // 1
	eq(d, 0 - 16)   // 1
	eq(e, 12)       // 1
	eq(f, 0 - 64)   // 1
}
