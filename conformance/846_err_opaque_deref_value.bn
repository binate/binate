package "main"

// A deref-as-rvalue forms an opaque VALUE (an 8-byte ptrSize fabrication) even
// when no typed var binds it: discarding a deref-load (`_ = *p`), copying one
// opaque slot to another (`*dst = *src`), and a `:=` short var decl (`x := *p`)
// are all rejected at the value-formation site.  Holding / passing the *Opaque
// pointer itself stays legal.  This program must fail to compile.
type Opaque

func g() *Opaque { return nil }

func f(dst *Opaque, src *Opaque) {
	_ = *g()
	*dst = *src
	x := *g()
	_ = x
	_ = dst
	_ = src
}

func main() {}
