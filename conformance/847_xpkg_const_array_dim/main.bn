package "main"

import "pkg/dep"

// A const used as an array DIMENSION inside an imported package's `.bni` — a
// struct field (`a [N]int`) or a type alias (`type Arr [N]int`) — must lay out
// IDENTICALLY in the importer and in the defining package.  IR-gen reads the
// length the type checker stamped on the dimension (TypeExpr.LenVal), not a
// re-fold against its own const table: in the import-registration passes that
// table is populated AFTER the imported field / alias dims are resolved, so a
// re-fold reads a not-yet-registered const and falls back to parseIntLit on the
// dim's ident text — a garbage size, and a silent cross-package struct-layout /
// ABI divergence (the importer would allocate and index a 30-word object that
// the owner treats as 8 words).  The importer's `len()` (computed in main) and
// the defining package's `dep.BoxLen` / `dep.ArrLen` (computed in dep) must
// agree on 8.
func main() {
	var b dep.Box
	println(cast(int, len(b.a)))   // 8 (importer's view of dep.Box's field)
	println(dep.BoxLen(b))         // 8 (defining package's view)

	var a dep.Arr
	println(cast(int, len(a)))     // 8 (importer's view of dep.Arr)
	println(dep.ArrLen(a))         // 8 (defining package's view)
}
