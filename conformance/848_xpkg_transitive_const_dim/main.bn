package "main"

import "pkg/b"

// A struct field / type-alias array dim in package b references a const in
// package a via a PACKAGE-QUALIFIED selector (`[a.N]int`); main imports only b
// (a is a transitive, dep-of-a-dep).  IR-gen reads the length the checker
// stamped on the dim (TypeExpr.LenVal), so the importer's view of b.Box / b.Arr
// matches the defining package's — even though the dim folds through the
// EXPR_SELECTOR / resolveQualifiedSym arm and a two-hop import-registration
// order.  Without the stamp, main's IR-gen re-folds `[a.N]` before the imported
// const is registered and falls back to parseIntLit on the dim text (size 30),
// silently diverging from b's layout (8).  The importer's `len()` (in main) and
// the defining package's `b.BoxLen` / `b.ArrLen` (in b) must agree on 8.
func main() {
	var bx b.Box
	println(cast(int, len(bx.arr)))   // 8 (importer's view)
	println(b.BoxLen(bx))             // 8 (defining package's view)

	var a b.Arr
	println(cast(int, len(a)))         // 8 (importer's view)
	println(b.ArrLen(a))               // 8 (defining package's view)
}
