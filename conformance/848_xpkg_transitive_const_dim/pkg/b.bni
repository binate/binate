package "pkg/b"

import "pkg/a"

// Array dims that reference a PACKAGE-QUALIFIED const from a transitively
// imported package (`a.N`) — the EXPR_SELECTOR fold arm, distinct from 847's
// bare in-package ident.
type Box struct {
	arr [a.N]int
}

type Arr [a.N]int

func BoxLen(b Box) int
func ArrLen(a Arr) int
