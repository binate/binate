package "main"

// A const used as an ARRAY DIMENSION that is forward-referenced — declared
// after its use site, or itself referencing a later const — must resolve to the
// const's value, not a garbage size.  IR-gen reads the length the type checker
// stamped on the dimension (TypeExpr.LenVal) instead of re-folding it against
// its own const table: a global-var or type-alias dim is resolved in a pass
// that can run BEFORE the const is registered there, so a re-fold reads a
// not-yet-registered const and falls back to parseIntLit on the ident text (or
// 0 for a non-ident expression), yielding a garbage stack/global array size — a
// silent, memory-unsafe miscompile.  len() reads the array's true length, so a
// wrong dim prints a wrong number.  Covers: a GLOBAL var whose dim is a forward
// const-EXPRESSION ident (`[USE]int`, USE = BASE + 1), a TYPE ALIAS with the
// same forward dim, a GLOBAL declared ABOVE a simple const (`[N]int`), a GLOBAL
// with a forward const-EXPRESSION dim (`[USE * 2]int`, the non-ident path), a
// GLOBAL whose dim is a forward const-GROUP member (`[SZ]int`), NESTED dims
// (`[ROWS][COLS]int` — each level is a separate AST node that must be stamped
// via the recursion), and a sizeof-of-struct dim (`[sizeof(Pair)]int8` — a
// distinct fold arm).  The LOCAL var is a consistency check (local dims resolve
// after consts are registered, so they were already correct — it guards against
// a future regression that would move body resolution earlier).  Values are
// small (32-bit clean; sizeof(Pair) is 8 on every target — two int32 fields).

// Pair is declared before `s` below: a forward sizeof of a struct is rejected
// as opaque, so the sizeof case is the legal struct-before-dim order.  The
// pre-fix miscompile still fires — IR-gen resolves the global `s` in a pass
// that precedes struct-field population, so its sizeof folds to 0 ([0 x i8]).
type Pair struct {
	a int32
	b int32
}

var g [USE]int
type Arr [USE]int
var h [N]int
var e [USE * 2]int
var k [SZ]int
// NESTED dim: both levels are forward consts.  The dim CONSTS use single-char
// names on purpose: if this guard ever regresses to the old re-fold, the
// garbage size is parseIntLit on the ident text — single chars keep that
// bounded (34 x 19 ≈ 5 KB) so a regression FAILS cleanly instead of folding a
// multi-char name (`ROWS` x `COLS` ≈ 37525 x 19585 ≈ 6 TB) into an
// out-of-memory zero-initializer.
var m [R][C]int
type Grid [R][C]int
var s [sizeof(Pair)]int8     // sizeof-of-a-struct dim (distinct fold arm)

func main() {
	g[0] = 3
	g[7] = 4
	println(cast(int, len(g)))   // 8
	println(g[0] + g[7])         // 7

	var a Arr
	a[0] = 5
	a[7] = 6
	println(cast(int, len(a)))   // 8
	println(a[0] + a[7])         // 11

	h[0] = 9
	println(cast(int, len(h)))   // 8
	println(h[0])                // 9

	println(cast(int, len(e)))   // 16
	println(cast(int, len(k)))   // 8

	// Nested array dims must be stamped at every level (the checker and
	// IR-gen recurse through the element type, each a separate AST node).
	println(cast(int, len(m)))      // 2  (outer dim)
	println(cast(int, len(m[0])))   // 3  (inner dim — the recursive node)
	var grid Grid
	println(cast(int, len(grid)))     // 2
	println(cast(int, len(grid[0])))  // 3

	// sizeof(Pair) folds to 8 (two int32 fields, target-independent), so the
	// dim exercises the sizeof fold arm rather than a const ident.
	println(cast(int, len(s)))   // 8

	var local [USE]int
	local[0] = 1
	println(cast(int, len(local)))  // 8
}

const USE int = BASE + 1
const BASE int = 7
const N int = 8
const R int = 2
const C int = 3
const (
	SZ int = 8
	UNUSED int = 99
)
