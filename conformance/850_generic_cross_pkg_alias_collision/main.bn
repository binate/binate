package "main"
import "pkg/builtins/testing"

import "pkg/genlib"
import dep "pkg/other"

// main imports pkg/other UNDER THE ALIAS `dep` — the SAME short alias genlib
// uses for its own (different) import pkg/dep.  We materialize genlib.Box[int]'s
// layout HERE via sizeof, WITHOUT first calling any genlib generic func (so the
// struct-instantiation cache is first populated from main's body, where main's
// `dep` overlay is active).  If IR-gen's defining-file overlay loses to main's
// pre-existing `dep` (RecordImportPath first-wins), Box[int]'s `p dep.Pair`
// field binds to pkg/other.Pair (3 ints) instead of pkg/dep.Pair (2 ints):
//   correct:  tag(int=8) + pkg/dep.Pair(2*8=16)   = 24
//   buggy:    tag(int=8) + pkg/other.Pair(3*8=24) = 32
func main() {
	var _sink int = dep.Sentinel()
	testing.Println(cast(int, sizeof(genlib.Box[int])))
}
