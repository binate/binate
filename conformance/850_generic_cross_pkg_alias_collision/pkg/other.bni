package "pkg/other"

// DIFFERENT layout from pkg/dep.Pair: a leading pad field shifts x/y to
// higher offsets, and the struct is one int larger.  If IR-gen resolves
// genlib.Box[T]'s `p dep.Pair` field against MAIN's `dep` (this package)
// instead of genlib's `dep` (pkg/dep), the monomorphized Box layout uses
// THIS Pair — wrong size and wrong x/y offsets vs. what the checker typed
// and what genlib.Make/Total were lowered against.
type Pair struct { pad int; x int; y int }

func Sentinel() int
