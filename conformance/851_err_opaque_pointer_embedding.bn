package "main"

// A pointer / handle to a type that EMBEDS an opaque type by value (but isn't
// bare opaque) is ill-formed: `*Box[Opaque]` / `@Box[Opaque]` / a pointer to an
// anonymous struct embedding opaque.  The pointee can never be a value and
// merely forming it would lay out a struct IR-gen fabricates (a colliding i64
// Box).  Bare `*Opaque` / `@Opaque` (the escape hatch) and `*Box[int]`
// (concrete) stay legal.  This program must fail to compile.
type Opaque

type Box[T any] struct { v T }

func f(bad *Box[Opaque], alsoBad @Box[Opaque], anon *struct { o Opaque },
		okBare *Opaque, okHandle @Opaque, okConc *Box[int]) {
	_ = bad
	_ = alsoBad
	_ = anon
	_ = okBare
	_ = okHandle
	_ = okConc
}

func main() {}
