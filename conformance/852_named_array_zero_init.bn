package "main"

// A local of a named distinct array type (`type Arr [N]T`) must be default
// zero-initialized like its anonymous counterpart — reading an UNSET element
// must yield 0, not stack garbage.  emitAlloc (codegen) gated its fieldwise
// zero-fill on the UNPEELED type kind, so a named array — whose Kind is
// TYP_NAMED, not TYP_ARRAY — was left uninitialized (memory-unsafe).  The
// anonymous `[N]T` was always zero-filled; this pins the named form, including
// a named-over-named chain (`type Buf Arr`).  Existing test 723 sets every
// element before reading, so it never exercised default zero-init.
type Arr [4]int
type Buf Arr

func main() {
	var a Arr
	a[1] = 5
	println(a[0])   // 0 (unset)
	println(a[1])   // 5
	println(a[3])   // 0 (unset)

	var b Buf
	b[2] = 7
	println(b[0])   // 0 (unset, through a named-over-named chain)
	println(b[2])   // 7
}
