package "main"
import "pkg/builtins/testing"

import "pkg/genlib"

// genlib.Box[int] has a MANAGED field @dep.Pair (dep imported only by genlib).
// Instantiating Box[int] monomorphizes the field HERE; the qualified field type
// must resolve against genlib's imports, and the instantiated struct's dtor must
// RefDec @dep.Pair correctly.  Want: 17.
func main() {
	var b @genlib.Box[int] = genlib.Make[int](7, 8)
	testing.Println(genlib.Total[int](b))
}
