package "pkg/genlib"

import "pkg/dep"

// Generic struct with a MANAGED qualified field @dep.Pair (genlib's own import).
// Beyond 841 (by-value), this exercises the managed-field path of an
// instantiated generic struct: the qualified field type must resolve against
// genlib's imports, and Box[int]'s dtor must RefDec the @dep.Pair field at the
// correct offset.
type Box[T any] struct { tag T; p @dep.Pair }

func Make[T any](t T, base int) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.tag = t
	b.p = make(dep.Pair)
	b.p.x = base
	b.p.y = base + 1
	return b
}

func Total[T any](b @Box[T]) int { return b.p.x + b.p.y }
