package "main"
import "pkg/builtins/testing"

import "pkg/iflib"

// main instantiates *iflib.Box[int] (it does NOT import pkg/dep).  The
// instantiated interface's method `wrap(v int) dep.Tag` must resolve dep.Tag
// against iflib's imports, not main's scope.  Want: 15.
func main() {
	var m iflib.IntImpl
	m.base = 10
	var bx *iflib.Box[int] = &m
	testing.Println(iflib.SumViaBox(bx, 5))
}
