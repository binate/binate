package "pkg/iflib"

import "pkg/dep"

// Generic interface whose method RESULT is a qualified type dep.Tag (iflib's
// own import).  Instantiating Box[int] must resolve dep.Tag against iflib's
// imports.  Raw-pointer interface form (mirrors 464) to avoid the unrelated
// cross-pkg MANAGED generic-iface upcast gap.
interface Box[T any] { wrap(v T) dep.Tag }

type IntImpl struct { base int }

// wrap is IntImpl's Box[int] method; the impl below binds it, so the .bni declares it.
func (m IntImpl) wrap(v int) dep.Tag

impl IntImpl : Box[int]

func SumViaBox(bx *Box[int], v int) int
