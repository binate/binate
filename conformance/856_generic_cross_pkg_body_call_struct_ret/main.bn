package "main"
import "pkg/builtins/testing"

import "pkg/genlib"

// main does NOT import pkg/dep.  genlib.Sum[int]'s body calls dep.Make()
// (struct-returning) — the consumer must declare the extern with dep.Make's
// real (aggregate) signature.  Want: 42.
func main() {
	testing.Println(genlib.Sum[int](0))
}
