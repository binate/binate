package "pkg/genlib"

import "pkg/dep"

// The generic body CALLS dep.Make() — a function from genlib's OWN import that
// the consumer need not import — and the callee returns a STRUCT.  Monomorphized
// at the consumer, this needs (a) an extern declare for dep.Make and (b) its
// REAL signature (returning dep.Pair), not a scalar guess.
func Sum[T any](x T) int {
	var p dep.Pair = dep.Make()
	return p.a + p.b
}
