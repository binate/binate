package "pkg/genlib"

import "pkg/dep"

// The generic body calls dep.Two() — a MULTI-RETURN function from genlib's own
// import — and the consumer must declare the extern with its real multi-return
// signature (not a guessed single scalar).
func Sum[T any](x T) int {
	var a int
	var b int
	a, b = dep.Two()
	return a + b
}
