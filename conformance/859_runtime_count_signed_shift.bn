package "main"
import "pkg/builtins/testing"

// Regression witness (signedness-aware shift, runtime count): a genuinely
// NEGATIVE untyped-int const value operand of a RUNTIME-count `>>` must shift
// as SIGNED (ashr).  `(0 - 16) >> n` is -4; the const's untyped-int type reads
// unsigned, so without recovering its genuine value sign (the checker's
// LitSign — not the two's-complement bit pattern, which can't tell a negative
// const from a positive >= 2^63 one) the shift lowered to lshr of (2^64-16).
// The const-COUNT case is folded in the checker (845); this RUNTIME-count case
// retags the shift's result type to signed int in IR-gen.

func main() {
	var n int = 2
	var y int = (0 - 16) >> n
	if y == (0 - 4) {
		testing.Println(1)
	} else {
		testing.Println(0)
	}
}
