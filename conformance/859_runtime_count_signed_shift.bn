package "main"

// KNOWN BUG (h-inline-shift runtime-count residual): a NEGATIVE untyped-int
// CONST left operand shifted right by a RUNTIME count lowers to a LOGICAL shift
// (`lshr`) instead of an arithmetic one.  `(0 - 16) >> n` (n a runtime variable)
// is -4, but the const `(0 - 16)` is typed untyped-int (unsigned for the shift),
// so codegen emits `lshr` of the two's-complement bit pattern — (2^64-16) >> 2.
// The const-count case is fixed (845, foldIntBitwise folds it); this RUNTIME
// case is distinct — the untyped-int const reaches the shift lowering, which
// picks ashr/lshr from the operand type's Signed flag, not the operand's value
// sign (and an untyped 2^63 operand legitimately wants lshr, so the fix needs a
// value-based decision).  Silent miscompile.

func main() {
	var n int = 2
	var y int = (0 - 16) >> n
	if y == (0 - 4) {
		println(1)
	} else {
		println(0)
	}
}
