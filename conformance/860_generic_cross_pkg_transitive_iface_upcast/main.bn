package "main"
import "pkg/builtins/testing"

import "pkg/genlib"

// main imports ONLY genlib.  genlib.Run[int]'s body upcasts mid.IntImpl to
// *mid.Box[int] (mid is transitive) and dispatches — the consumer must wire the
// transitive impl's vtable, else a nil vtable -> SIGSEGV.  Want: 15.
func main() {
	testing.Println(genlib.Run[int](0))
}
