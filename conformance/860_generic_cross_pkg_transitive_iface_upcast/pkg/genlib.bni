package "pkg/genlib"

import "pkg/mid"

// A generic body that UPCASTS a value to an interface defined in genlib's own
// import (mid) and dispatches.  Monomorphized at a consumer that imports only
// genlib, the upcast must wire mid's (IntImpl, Box[int]) vtable — which the
// consumer reaches only transitively.
func Run[T any](x T) int {
	var m mid.IntImpl = mid.Make(15)
	var b *mid.Box[int] = &m
	return b.val()
}
