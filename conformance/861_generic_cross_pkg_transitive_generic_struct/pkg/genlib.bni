package "pkg/genlib"

import "pkg/mid"

// A generic body that INSTANTIATES a generic STRUCT from genlib's own import
// (mid.Box[int]) — the consumer reaches mid.Box's generic decl only
// transitively, and must register it to monomorphize this body.
func Wrap[T any](x T) int {
	var b mid.Box[int]
	b.v = 42
	return b.v
}
