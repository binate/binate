package "pkg/genlib"

import "pkg/mid"

// A generic body that upcasts to a PLAIN (non-generic) interface defined in a
// transitively-imported package (mid).  The monomorphized body must wire mid's
// (IntImpl, Box) vtable — the same transitive-impl path the generic-iface case
// (860) needs, exercised for a non-generic interface.
func Run[T any](x T) int {
	var m mid.IntImpl = mid.Make(7)
	var b *mid.Box = &m
	return b.val()
}
