package "main"
import "pkg/builtins/testing"

// A SCALAR local declared without an initializer must be zero-initialized
// (spec decl.var.zero-init: numeric → 0, bool → false).  The LLVM backend's
// emitAlloc only zero-fills struct/array OP_ALLOCs, so a default-init scalar
// slot read as stack garbage — a silent, memory-unsafe wrong-code (the VM
// zeroes scalars, so the backends disagreed).  IR-gen now emits the zero store
// in the var-decl default-init path.  `dirty()` writes non-zero values to the
// frame first, so a fresh-frame-happens-to-be-zero coincidence can't mask the
// bug.

func dirty() int {
	var x int = 12345
	var y int = 67890
	return x + y
}

func main() {
	var d int = dirty()
	testing.Println(d)              // 80235 (dirties the stack)

	var s int
	testing.Println(s)             // 0
	var b bool
	if b { testing.Println(1) } else { testing.Println(0) }   // 0 (false)
	var c char
	testing.Println(cast(int, c))  // 0
	var n int8
	testing.Println(cast(int, n))  // 0
}
