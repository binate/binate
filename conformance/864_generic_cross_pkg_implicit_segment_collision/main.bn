package "main"

import "pkg/genlib"
import "pkg/app/dep"

// main imports pkg/app/dep under the IMPLICIT alias `dep` (last path segment) —
// the same implicit alias genlib uses for its own import pkg/lib/dep.  No
// explicit alias anywhere (cf. 850 which uses an explicit `import dep "..."`).
// genlib.Box[int]'s `p dep.Pair` must resolve to pkg/lib/dep.Pair (2 ints):
//   correct: tag(8) + pkg/lib/dep.Pair(16) = 24
//   buggy:   tag(8) + pkg/app/dep.Pair(24) = 32
func main() {
	var _sink int = dep.Sentinel()
	println(cast(int, sizeof(genlib.Box[int])))
}
