package "pkg/genlib"

import "pkg/lib/dep"

// genlib's `dep` is pkg/lib/dep (implicit alias = last path segment "dep").
// The consumer also imports a DIFFERENT pkg/.../dep under the same implicit
// alias; the field type must bind to genlib's dep (pkg/lib/dep.Pair, 2 ints),
// not the consumer's (pkg/app/dep.Pair, 3 ints).
type Box[T any] struct { tag T; p dep.Pair }
