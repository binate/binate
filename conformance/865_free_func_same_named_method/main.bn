package "main"
import "pkg/builtins/testing"

import "pkg/stat"

// pkg/stat declares BOTH a free `Stat(name int) int` and a method
// `(f @Info) Stat() int`.  Before the .bni-loader Recv guard, the method's
// receiver-less signature overwrote the free func's package-scope binding, so
// pkg/stat failed to compile ("Stat: .bn has 1 parameters but .bni declares
// 0").  Both must resolve independently: the free function by its 1-param
// signature, the method on its receiver — and an importer's `stat.Stat(...)`
// must reach the free function, not the method.
func main() {
	testing.Println(stat.Stat(41))      // free func: 41 + 1 = 42
	var info @stat.Info = stat.New(5)
	testing.Println(info.Stat())        // method: fd = 5
}
