package "pkg/stat"

type Info struct { fd int }

// A free function and a method of the SAME name (`Stat`) — the standard
// `os.Stat` (free) + `File.Stat` (method) pattern.  The .bni loader must
// register only the free function in the package value namespace; the
// method lives in Info's method set.
func Stat(name int) int

func New(fd int) @Info
func (f @Info) Stat() int
