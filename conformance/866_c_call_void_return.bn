package "main"

// __c_call with the "void" return spelling: `__c_call("free", "void", p)` —
// a void C call used as a bare statement, carrying no misleading dummy return
// type.  Previously void C functions had to declare a throwaway scalar return
// (`__c_call("free", int, ptr)`) and discard it; "void" lowers to a result-less
// call (LLVM `call void @free(...)`, no SSA value).
//
// malloc + free live in helper funcs so those are the native-only
// (__c_call-bearing) functions; main stays interpretable in the VM modes,
// which call them as registered externs (a __c_call function is native-only
// in the VM).  free(NULL) is a defined no-op, so the call is safe regardless.

func alloc(n int) *uint8 {
	return __c_call("malloc", *uint8, n)
}

func release(p *uint8) {
	__c_call("free", "void", p)
}

func main() {
	var p *uint8 = alloc(16)
	release(p)
	println(1)
}
