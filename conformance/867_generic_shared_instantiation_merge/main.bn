package "main"
import "pkg/builtins/testing"

// Two sibling consumer packages (c1, c2) each instantiate the SAME library
// generic genlib.Pick[int].  Because an instantiation symbol is keyed by its
// DEFINING package (genlib), both TUs emit the SAME symbol
// bn_I... — which is why instantiations are emitted
// IsLinkOnce (weak_odr): the linker / VM must MERGE the two copies into one
// rather than reject duplicate strong definitions.  This pins that the
// defining-package re-key and IsLinkOnce stay coupled.  Want 10 then 30.
import "pkg/c1"
import "pkg/c2"

func main() {
	testing.Println(c1.UseC1())
	testing.Println(c2.UseC2())
}
