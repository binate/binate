package "main"

import "pkg/b"

// A negative shift count reached through a TRANSITIVE .bni const (`x >> b.N`
// where b.N == a.NEG == -5, pkg/b imports pkg/a, and main imports ONLY pkg/b)
// must be rejected at compile time — the same guarantee as the direct
// 2-package selector (804/811), now across one more package hop.  This is the
// facet the transitive-.bni-const fix (binate 505d7069) closed: before it, the
// conservative guard left b.N value-less, so checkShiftCountNonNegative never
// saw the -5 — the count slipped to IR-gen and was silently treated as a huge
// overshift (→ 0).  The checker now folds b.N via the loaded pkg/a scope and
// stamps it, so the negative count is caught here.
func main() {
	var x int = 256
	println(x >> b.N)
}
