package "main"
import "pkg/builtins/testing"

import "pkg/b"

// A negative shift count reached through a TRANSITIVE .bni const (`x >> b.N`
// where b.N == a.NEG == -5, pkg/b imports pkg/a, and main imports ONLY pkg/b)
// must be rejected at compile time — the same guarantee as the direct
// 2-package selector (804/811), across one more package hop.  The checker folds
// b.N via the loaded pkg/a scope and stamps it, so checkShiftCountNonNegative
// sees the -5 and the negative count is caught here.  Left value-less, b.N lets
// the count slip to IR-gen, where it is silently treated as a huge overshift
// (→ 0).
func main() {
	var x int = 256
	testing.Println(x >> b.N)
}
