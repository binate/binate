package "main"
import "pkg/builtins/testing"

func dbl(x int) int { return x + x }

// A generic instantiated over a MANAGED-FUNC-VALUE type arg (@func(int) int).
// The per-(decl, args) instantiation symbol must render the func-value type as
// an identifier-safe token (mfv_p1_int_r1_int), not QualifiedTypeName's
// `<unknown>` placeholder — which is non-injective AND hard-errors on LLVM
// (so before the mangleTypeArg fix this program failed to compile).  Id returns
// its argument; calling the returned func value yields dbl(21) = 42.
func Id[T any](v T) T { return v }

func main() {
	var f @func(int) int = dbl
	var g @func(int) int = Id[@func(int) int](f)
	testing.Println(g(21))
}
