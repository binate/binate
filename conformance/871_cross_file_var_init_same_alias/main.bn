package "main"
import "pkg/builtins/testing"

import "pkg/xf"

// A package-level `var x = dep.Foo()` whose `dep` aliases DIFFERENT packages in
// DIFFERENT files of one package resolves per file.  pkg/xf has two files:
// a.bn does `import dep "pkg/p1"; var A int = dep.V()` (p1.V == 11) and b.bn
// does `import dep "pkg/p2"; var B int = dep.V()` (p2.V == 22).  The synthetic
// package `__init` combines both initializers into one body, and each still
// calls its own file's `dep`: A == 11 and B == 22.
//
// Read each var two ways: directly cross-package (`xf.A`) and through an
// in-package getter (`xf.GetA()`), so both the imported-package-var read path
// and the in-package read path observe the per-file-resolved initializer.
func main() {
	testing.Println(xf.A)        // 11 (dep = pkg/p1 in a.bn, direct cross-package read)
	testing.Println(xf.B)        // 22 (dep = pkg/p2 in b.bn, direct cross-package read)
	testing.Println(xf.GetA())   // 11 (same var, via in-package getter)
	testing.Println(xf.GetB())   // 22
}
