package "main"

import "pkg/xf"

// A package-level `var x = dep.Foo()` whose `dep` aliases DIFFERENT packages in
// DIFFERENT files of one package must resolve per-file.  pkg/xf has two files:
// a.bn does `import dep "pkg/p1"; var A int = dep.V()` (p1.V == 11) and b.bn
// does `import dep "pkg/p2"; var B int = dep.V()` (p2.V == 22).  The synthetic
// package `__init` COMBINES both initializers into one body; a single merged
// import overlay would resolve both `dep` to whichever package wins the merge
// (the KNOWN RESIDUAL of file-scoped imports — B silently got 11).  IR-gen now
// switches the import overlay to each init statement's own file before lowering
// it, so A == 11 and B == 22.
//
// Read each var two ways: directly cross-package (`xf.A`) and through an
// in-package getter (`xf.GetA()`), so both the imported-package-var read path
// and the in-package read path observe the per-file-resolved initializer.
func main() {
	println(xf.A)        // 11 (dep = pkg/p1 in a.bn, direct cross-package read)
	println(xf.B)        // 22 (dep = pkg/p2 in b.bn, direct cross-package read)
	println(xf.GetA())   // 11 (same var, via in-package getter)
	println(xf.GetB())   // 22
}
