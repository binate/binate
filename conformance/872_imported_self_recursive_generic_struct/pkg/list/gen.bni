package "pkg/list/gen"

// Self-recursive generic struct: the `next @Node[T]` field is an UNQUALIFIED
// same-package generic head, resolved (during instantiation in a CONSUMER) via
// the generic's DEFINING package — not the consumer's.  Guards the regression
// where populateInstantiatedStruct resolved such a field against the consumer
// package and reported `undefined: Node`.  (762 covers the same-package case;
// this is the IMPORTED case the package-main test masked.)
type Node[T any] struct { val T; next @Node[T] }

func Cons[T any](v T, rest @Node[T]) @Node[T] {
	var n @Node[T] = make(Node[T])
	n.val = v
	n.next = rest
	return n
}
func Val[T any](n @Node[T]) T { return n.val }

func Sentinel() int
