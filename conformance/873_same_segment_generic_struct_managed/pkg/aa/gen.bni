package "pkg/aa/gen"
import "pkg/dep"
// ONE T field + a managed @dep.Tag field (-> the instantiation has a dtor).
type Box[T any] struct { item T; tag @dep.Tag }
func Make[T any](item T) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.item = item
	b.tag = dep.MkTag(0)
	return b
}
func GetItem[T any](b @Box[T]) T { return b.item }
func Sentinel() int
