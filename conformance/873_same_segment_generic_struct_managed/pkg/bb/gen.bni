package "pkg/bb/gen"
import "pkg/dep"
// DIFFERENT layout (leading field) + a managed @dep.Tag field.  Same final
// segment + decl name as pkg/aa/gen.Box, so without defining-package keying
// the two instantiations collide (and their @dep.Tag-field dtors would clash /
// be undefined — the dtor-cascade x collision intersection).
type Box[T any] struct { lead T; item T; tag @dep.Tag }
func Make[T any](lead T, item T) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.lead = lead
	b.item = item
	b.tag = dep.MkTag(0)
	return b
}
func GetItem[T any](b @Box[T]) T { return b.item }
func Sentinel() int
