package "main"
import "pkg/builtins/testing"

// Same-final-segment imports of GENERIC STRUCTS (pkg/aa/gen, pkg/bb/gen, both
// short-named "gen", both declaring Box[T] with DIFFERENT layouts).  The struct
// analog of conformance/792: the instantiated struct (and its dtor/copy helpers)
// must be keyed by the DEFINING package, or bb.Box[int] collides with
// aa.Box[int].  The explicit `@aa.Box[int]` / `@bb.Box[int]` type heads also
// exercise aliased generic-struct resolution.  Want 42 then 30.
import aa "pkg/aa/gen"
import bb "pkg/bb/gen"

func main() {
	var x @aa.Box[int] = aa.Wrap[int](42)
	testing.Println(aa.Get[int](x))
	var y @bb.Box[int] = bb.Wrap2[int](10, 30)
	testing.Println(bb.GetHi[int](y))
}
