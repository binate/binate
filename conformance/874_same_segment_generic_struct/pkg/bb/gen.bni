package "pkg/bb/gen"

// Same final segment ("gen") and same decl name (Box) as pkg/aa/gen, but a
// DIFFERENT layout: TWO fields.  The instantiated struct must be keyed by its
// DEFINING package (checker decl-keying + IR registry + dtor/copy), or bb.Box[T]
// collides with aa.Box[T] and inherits its one-field layout — then GetHi's
// `b.hi` reference fails to resolve (the collision is fail-safe: a checker
// error, not a silent miscompile).
type Box[T any] struct { lo T; hi T }

func Wrap2[T any](lo T, hi T) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.lo = lo
	b.hi = hi
	return b
}
func GetHi[T any](b @Box[T]) T { return b.hi }

func Sentinel() int
