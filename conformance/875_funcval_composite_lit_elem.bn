package "main"

// A function reference (method expression `T.M`) used as a composite-literal
// ELEMENT must lower to a real function value (OP_FUNC_VALUE), exactly as it
// does in a struct-field composite literal.  Before genArrayLit /
// genRawSliceLit / genManagedSliceLit routed element values through
// genExprOrFuncRef, such an element fell through plain genExpr to genSelector's
// catch-all fallback: a silent const-0 (a function value over a null code
// pointer) — SIGSEGV when later called.  This exercises array, managed-slice,
// and raw-slice literals, then CALLS each element so a null code pointer would
// crash.  Package-qualified `pkg.Func` selector elements are covered by 876.

type Counter struct {
	N int
}

func (c Counter) Add(x int) int {
	return c.N + x
}

func main() {
	var c Counter = Counter{N: 10}

	// Array literal with method-expression elements.
	var arr [2]*func(Counter, int) int =
		[2]*func(Counter, int) int{Counter.Add, Counter.Add}
	println(arr[0](c, 5)) // 15
	println(arr[1](c, 7)) // 17

	// Managed-slice literal with a method-expression element.
	var ms @[]*func(Counter, int) int =
		@[]*func(Counter, int) int{Counter.Add}
	println(ms[0](c, 1)) // 11

	// Raw-slice literal: the element type is `readonly *func(...)` (the
	// only spelling raw-slice literals accept), so genExprOrFuncRef must
	// peel the readonly wrapper before recognizing the func reference.
	var rs *[]readonly *func(Counter, int) int =
		*[]readonly *func(Counter, int) int{Counter.Add}
	println(rs[0](c, 3)) // 13
}
