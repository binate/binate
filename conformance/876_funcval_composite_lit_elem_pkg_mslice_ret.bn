package "main"
import "pkg/builtins/testing"

// A PACKAGE-qualified function reference (`pkg.Func` selector) used as a
// composite-literal ELEMENT lowers to a function value via genExprOrFuncRef,
// just like the method-expression elements in 875 — funcRefName resolves the
// `pkg.Name` selector form.  Here the element function (strconv.Itoa) returns a
// managed slice (@[]char).
//
// The element lowering itself is mode-independent and correct in every backend
// (cf. 875).  This test xfails ONLY the bytecode-VM modes (those ending in
// `int`): the VM mis-handles a func-value CALL whose function returns a managed
// slice, yielding empty output — a pre-existing VM limitation, NOT a composite-
// literal issue.  See explorations/claude-todo.md.
import "pkg/std/strconv"

func main() {
	var fs @[]*func(int) @[]char = @[]*func(int) @[]char{strconv.Itoa}
	testing.Println(fs[0](42)) // 42
}
