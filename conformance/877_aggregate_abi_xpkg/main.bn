package "main"

import "pkg/tt"

// Multi-line to avoid the single-line-func parse gotcha
// (`if b { return 1 } return 0` needs a statement separator).
func yn(b bool) int {
	if b {
		return 1
	}
	return 0
}

func main() {
	// {i64,i32} 16-byte struct (trailing pad leaf).
	var p tt.S = tt.Mk(cast(int64, 3), cast(int32, 0))
	var q tt.S = tt.Mk(cast(int64, 10), cast(int32, 0))
	println(yn(p.Less(q)))                                       // 1
	println(yn(q.SubNanos(p) == cast(int64, 7000000000)))        // 1
	println(q.SubNanos(p))                                       // 7000000000
	println(p.Sec())                                             // 62135596803

	// {i32,i32} 8-byte struct (sub-word fields).
	var a tt.T2 = tt.MkT2(cast(int32, 3), cast(int32, 4))
	var b tt.T2 = tt.MkT2(cast(int32, 5), cast(int32, 6))
	// (3+4)*1000000 + (5+6) = 7000011
	println(a.Sum(b))                                            // 7000011

	// {i8,i64} 16-byte struct (leading pad).
	var m tt.LP = tt.MkLP(cast(int8, 2), cast(int64, 100))
	var n tt.LP = tt.MkLP(cast(int8, 3), cast(int64, 200))
	// 100 + 200 + (2+3)*1000000000000 = 5000000000300
	println(m.Combine(n))                                        // 5000000000300
}
