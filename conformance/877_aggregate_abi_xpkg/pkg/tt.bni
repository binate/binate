package "pkg/tt"

// S {i64,i32}: 16 bytes WITH a trailing padding leaf — exercises the
// `<{ i64, i32, [4 x i8] }>` field-expansion (6 regs) failure shape.
type S struct {
	sec  int64
	nsec int32
}

// T2 {i32,i32}: 8 bytes, sub-word fields that the native side coalesces
// into one word but LLVM's first-class form expands to two regs.
type T2 struct {
	x int32
	y int32
}

// LP {i8,i64}: a leading sub-word field forces 8 bytes of leading
// alignment padding -> 16 bytes with the i8 in the low byte of word 0.
type LP struct {
	tag  int8
	val  int64
}

func Mk(sec int64, nsec int32) S
func (p S) Sec() int64
func (p S) Less(q S) bool
func (p S) SubNanos(q S) int64

func MkT2(x int32, y int32) T2
func (p T2) Sum(q T2) int64

func MkLP(tag int8, val int64) LP
func (p LP) Combine(q LP) int64
