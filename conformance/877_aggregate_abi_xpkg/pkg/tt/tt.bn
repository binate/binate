package "pkg/tt"

const BIG int64 = 62135596800
const NPS int64 = 1000000000

func Mk(sec int64, nsec int32) S {
	return S{sec: sec + BIG, nsec: nsec}
}

func (p S) Sec() int64 {
	return p.sec
}

func (p S) Less(q S) bool {
	return p.sec < q.sec || (p.sec == q.sec && p.nsec < q.nsec)
}

func (p S) SubNanos(q S) int64 {
	var dsec int64 = p.sec - q.sec
	var dnsec int64 = cast(int64, p.nsec) - cast(int64, q.nsec)
	return dsec * NPS + dnsec
}

func MkT2(x int32, y int32) T2 {
	return T2{x: x, y: y}
}

// Sum reads BOTH sub-word fields of the receiver AND the by-value arg,
// so a misaligned register assignment corrupts the result.
func (p T2) Sum(q T2) int64 {
	var a int64 = cast(int64, p.x) + cast(int64, p.y)
	var b int64 = cast(int64, q.x) + cast(int64, q.y)
	return a * cast(int64, 1000000) + b
}

func MkLP(tag int8, val int64) LP {
	return LP{tag: tag, val: val}
}

// Combine mixes the leading-pad i8 tag and the i64 val of both the
// receiver and the by-value arg.
func (p LP) Combine(q LP) int64 {
	var t int64 = cast(int64, p.tag) + cast(int64, q.tag)
	return p.val + q.val + t * cast(int64, 1000000000000)
}
