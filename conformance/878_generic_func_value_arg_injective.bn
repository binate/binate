package "main"

// Two DISTINCT func-value instantiations of the same generic must coexist with
// distinct symbols (end-to-end across all modes — conformance/870 exercises a
// single @func instantiation; this pins INJECTIVITY: @func(int) int vs
// @func(int, int) int differ in arity, so mangleFuncSig must give them distinct
// instantiation symbols — if they collided, one Id call would dispatch the
// wrong body or the link would see a duplicate).
func dbl(x int) int { return x + x }
func add(x int, y int) int { return x + y }

func Id[T any](v T) T { return v }

func main() {
	var f @func(int) int = dbl
	var g @func(int) int = Id[@func(int) int](f)
	println(g(21))                 // 42

	var h @func(int, int) int = add
	var k @func(int, int) int = Id[@func(int, int) int](h)
	println(k(10, 20))             // 30
}
