package "main"
import "pkg/builtins/testing"

// A function VALUE of a native-injected (cross-package stdlib) function that
// returns an AGGREGATE (managed slice @[]char) must deliver its result in the
// bytecode VM.  Such a callee is reached cross-mode in the VM
// (dispatchCompiledFuncValue): a data-less {vtable, 0} func value dispatches
// through the marshaling shim.  The scalar shim carries only one word back, so
// an aggregate return must use the retbuf-style _call_shim_aggregate, keyed on
// the result byte size the call site encodes.  Without that, f(n) returned
// empty / corrupt output in the VM (native backends were always correct).
import "pkg/std/strconv"

func main() {
	var f *func(int) @[]char = strconv.Itoa
	testing.Println(f(42))      // 42
	testing.Println(len(f(7)))  // 1
	var s @[]char = f(100)
	testing.Println(s)          // 100
	testing.Println(len(s))     // 3
}
