package "main"

// A function reference used as a MANAGED-func-value (`@func`) composite-literal
// element exercises the refcount-ACQUIRE path that the raw `*func` elements in
// 875/876 sidestep: genArrayLit's emitStoreManagedSlot managed-scalar arm, and
// genManagedSliceLit's isManagedScalarType -> emitAcquireManagedScalar branch.
// A non-capturing func reference lowers to a fresh OP_FUNC_VALUE with null
// data, so the acquire (consumeTemp) and the scope-exit RefDec are safe no-ops
// (the dtor null-guards data).  This pins that an `@func` element built from a
// func reference compiles, calls correctly, and balances.  (A bare free-
// function reference coerces to `@func`; a method expression `T.M` does not —
// it stays raw `*func` — so this uses the free-function form.)

func inc(x int) int {
	return x + 1
}

func dbl(x int) int {
	return x + x
}

func main() {
	// Array of @func: bare-Ident free-function elements (acquire via the
	// emitStoreManagedSlot managed-scalar arm).
	var arr [2]@func(int) int = [2]@func(int) int{inc, inc}
	println(arr[0](5)) // 6
	println(arr[1](9)) // 10

	// Managed-slice of @func: acquire via emitAcquireManagedScalar.
	var ms @[]@func(int) int = @[]@func(int) int{dbl}
	println(ms[0](7)) // 14
}
