package "main"
import "pkg/builtins/testing"

// A cross-mode func value (of a native-injected stdlib function) returning a
// multi-word STRUCT — time.Point is 16 bytes — exercises the same > word
// retbuf dispatch as the managed-slice case (879), but with a by-value struct,
// so the retbuf is 16B not 32B.  Confirms the cross-mode aggregate path is
// correct for a struct return, not only a managed slice.  Read p.nsec directly
// (FromUnix stores nsec verbatim) and a sec DIFFERENCE of two results (origin-
// independent, so predictable without knowing FromUnix's year-1 epoch offset).
import "pkg/std/time"

func main() {
	var f *func(int64, int32) time.Point = time.FromUnix
	var p1 time.Point = f(cast(int64, 100), cast(int32, 7))
	var p2 time.Point = f(cast(int64, 250), cast(int32, 0))
	testing.Println(p1.nsec)         // 7  (nsec delivered verbatim through the retbuf)
	testing.Println(p2.sec - p1.sec) // 150 (sec delivered correctly: 250 - 100)
}
