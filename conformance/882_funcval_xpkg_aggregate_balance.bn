package "main"

// The cross-mode func-value aggregate return (879) must deliver a FRESH managed
// slice owned SOLELY by the caller (backing refcount 1) — not over-acquired.
// 879/876 assert only printed output, so a stray RefInc (or a missing RefDec)
// on the retbuf result would pass them silently.  Probe the backing refcount of
// the returned @[]char via its 4-word header (word 2 = refptr), the
// 130_managed_slice_backing_rc idiom.
import "pkg/builtins/rt"
import "pkg/std/strconv"

// backingRC reads the backing refcount from a managed-slice's 4-word header
// (word 2 is the refptr).  Takes the slice's address so there is no copy / RefInc.
func backingRC(p *int) int {
	var backingPtr *uint8 = bit_cast(*uint8, p[2])
	if backingPtr == nil { return 0 }
	return rt.Refcount(backingPtr)
}

func main() {
	var f *func(int) @[]char = strconv.Itoa
	var s @[]char = f(12345)
	var p *int = bit_cast(*int, &s)
	println(backingRC(p)) // 1: the cross-mode result is solely owned by s
	println(s)            // 12345
}
