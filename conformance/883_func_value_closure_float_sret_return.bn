package "main"

// A float closure whose function value returns a float aggregate LARGER than 16
// bytes — the sret shape of the native float-aware aggregate closure shim
// (claude-todo #121's 706).  The 24-byte result is returned through the hidden
// sret pointer (RDI on x64 / X8 on aarch64), while the float capture + float
// param are marshalled into the FP registers.  The single-aggregate return is
// packed all-GP regardless of field class, so the lifted body writes the three
// f64 fields through the sret buffer and the shim leaves the buffer untouched.
// Pairs with 706 (the ≤ 16-byte pack shape); LLVM and the VM handle both.

type Triple struct {
	x float64
	y float64
	z float64
}

func makeTriple(f float64) @func(float64) Triple {
	return func(a float64) Triple {
		return Triple{a * f, a + f, a - f}
	}
}

func main() {
	var fn @func(float64) Triple = makeTriple(2.0)
	var t Triple = fn(3.0)
	println(cast(int, t.x)) // 6  (3 * 2)
	println(cast(int, t.y)) // 5  (3 + 2)
	println(cast(int, t.z)) // 1  (3 - 2)
}
