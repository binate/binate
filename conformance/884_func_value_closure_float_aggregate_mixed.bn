package "main"

// A float closure with an aggregate return whose captures AND params MIX the GP
// and FP register classes, including float32 (the i32-float marshalling path)
// — the pack shape of the native float-aware aggregate closure shim (claude-todo
// #121's 706).  The GP capture/param land in the GP arg registers and the
// float32 capture/param in the FP registers (independent NGRN/NSRN counters,
// exactly where the lifted body's prologue reads them); the 8-byte mixed result
// is packed all-GP through the retbuf.  Exercises the GP+FP interleave and the
// 32-bit float load that 706's all-float64 case does not.

type Mix struct {
	i int32
	f float32
}

func makeMix(base int32, scale float32) @func(int32, float32) Mix {
	return func(n int32, x float32) Mix {
		return Mix{base + n, scale * x}
	}
}

func main() {
	var fn @func(int32, float32) Mix = makeMix(10, 3.0)
	var m Mix = fn(5, 4.0)
	println(cast(int, m.i)) // 15  (10 + 5)
	println(cast(int, m.f)) // 12  (3 * 4)
}
