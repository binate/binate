package "main"
import "pkg/builtins/testing"

// Mixed GP + FP argument overflow, interleaved in declaration order: 9 ints AND
// 9 float64s, so BOTH the GP arg registers and the FP arg registers overflow to
// the stack (on x64: ints overflow past 6, floats past 8; on aarch64: both past
// 8).  The stack args interleave by argument order, so this checks that the
// convention layer accumulates GP-overflow and FP-overflow stack words into a
// single arg-ordered offset (not two separate tallies).  (plan-fp-arg-stack-
// overflow / claude-todo #121.)

func mix(a int, x float64, b int, y float64, c int, z float64,
		d int, p float64, e int, q float64, f int, r float64,
		g int, s float64, h int, t float64, i int, u float64) int {
	return a + b + c + d + e + f + g + h + i +
		cast(int, x + y + z + p + q + r + s + t + u)
}

func main() {
	// ints 1..9 (sum 45); floats 10,20,..,90 (sum 450) → 495.
	testing.Println(mix(1, 10.0, 2, 20.0, 3, 30.0, 4, 40.0, 5, 50.0,
		6, 60.0, 7, 70.0, 8, 80.0, 9, 90.0))
}
