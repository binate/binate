package "main"
import "pkg/builtins/testing"

import "pkg/fv"

func yn(b bool) int {
	if b {
		return 1
	}
	return 0
}

func main() {
	var s2 fv.S2 = fv.S2{a: cast(int32, 7), b: cast(int32, 11)}
	var s3 fv.S3 = fv.S3{a: cast(int32, 1), b: cast(int32, 2), c: cast(int32, 3)}

	// Func-value over a dep function (LLVM-side shim), 8B + 12B struct by value.
	var f2 *func(fv.S2) int32 = fv.Get2()
	testing.Println(yn(cast(int, f2(s2)) == 18))                              // 1
	var f3 *func(fv.S3) int32 = fv.Get3()
	testing.Println(yn(cast(int, f3(s3)) == 6))                              // 1

	// Capturing closure built in the dep (LLVM-side closure shim), 8B + 12B.
	var g2 @func(fv.S2) int32 = fv.GetAdder2(cast(int32, 100))
	testing.Println(yn(cast(int, g2(s2)) == 118))                            // 1
	var g3 @func(fv.S3) int32 = fv.GetAdder3(cast(int32, 100))
	testing.Println(yn(cast(int, g3(s3)) == 106))                            // 1

	// Func-value over a 12B ARRAY ([3]int32) by value.
	var fa *func([3]int32) int32 = fv.GetArr()
	var arr [3]int32
	arr[0] = cast(int32, 4)
	arr[1] = cast(int32, 5)
	arr[2] = cast(int32, 6)
	testing.Println(yn(cast(int, fa(arr)) == 15))                            // 1
}
