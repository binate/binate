package "pkg/fv"

func Sum2(s S2) int32 {
	return s.a + s.b
}

func Sum3(s S3) int32 {
	return s.a + s.b + s.c
}

func Get2() *func(S2) int32 {
	return Sum2
}

func Get3() *func(S3) int32 {
	return Sum3
}

func GetAdder2(k int32) @func(S2) int32 {
	return func(s S2) int32 {
		return s.a + s.b + k
	}
}

func GetAdder3(k int32) @func(S3) int32 {
	return func(s S3) int32 {
		return s.a + s.b + s.c + k
	}
}

func SumArr(a [3]int32) int32 {
	return a[0] + a[1] + a[2]
}

func GetArr() *func([3]int32) int32 {
	return SumArr
}
