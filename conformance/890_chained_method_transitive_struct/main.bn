package "main"
import "pkg/builtins/testing"

// Chaining a method onto the by-value struct RESULT of a cross-package method,
// where the result struct's type lives in a THIRD package reached only
// TRANSITIVELY (main imports bb, not tt).  IR-gen's lookupFuncResults searches
// only DIRECT-import FuncSigs, so genMethodCall falls back to the checker's
// resolved type and registers the transitive method as an extern.  Without that,
// the chained tt.T.Split's result type defaults to int (i64), emitting
// `call i64 @...Split` + an invalid `extractvalue i64`, and tt.T.Split has no
// `declare` (undefined symbol).  (The os.FileInfo.ModTime().ToUnix() case in
// stdlib/os/004 is the same shape; this is the minimal, dependency-free one.)
import "pkg/bb"

func main() {
	var bx @bb.Box = bb.MakeBox(cast(int64, 10))
	var s int64
	var n int32
	// bb.Box.Get() returns tt.T (a THIRD-package struct); chain tt.T.Split().
	s, n = bx.Get().Split()
	testing.Println(cast(int, s))   // 10
	testing.Println(cast(int, n))   // 7
}
