package "main"

// Chaining a method onto the by-value struct RESULT of a cross-package method,
// where the result struct's type lives in a THIRD package reached only
// TRANSITIVELY (main imports bb, not tt).  IR-gen's lookupFuncResults searches
// only DIRECT-import FuncSigs, so the chained tt.T.Split's result type defaulted
// to int (i64), emitting `call i64 @...Split` + an invalid `extractvalue i64`;
// and tt.T.Split had no `declare` (undefined symbol).  genMethodCall now falls
// back to the checker's resolved type and registers the transitive method as an
// extern.  (The os.FileInfo.ModTime().ToUnix() case in stdlib/os/004 is the same
// bug; this is the minimal, dependency-free repro.)
import "pkg/bb"

func main() {
	var bx @bb.Box = bb.MakeBox(cast(int64, 10))
	var s int64
	var n int32
	// bb.Box.Get() returns tt.T (a THIRD-package struct); chain tt.T.Split().
	s, n = bx.Get().Split()
	println(cast(int, s))   // 10
	println(cast(int, n))   // 7
}
