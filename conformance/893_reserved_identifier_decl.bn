package "main"

// A user identifier carrying the compiler's `__bn_inst__` instantiation
// marker (here as an infix) must be rejected at compile time: otherwise the
// mangler reads it as a monomorphized generic symbol, and a crafted name
// can alias a real instantiation's linker symbol -- a silent duplicate-
// symbol miscompilation.  The whole `__`-prefix namespace is reserved for
// the same collision reason.  See mangle.IsReservedIdentifier and the
// front-end check in pkg/binate/types/check_decl.bn (checkReservedDeclNames).

func foo__bn_inst__bar() { }

func main() {
	println("unreachable -- this program must not compile")
}
