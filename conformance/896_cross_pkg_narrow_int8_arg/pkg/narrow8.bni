package "pkg/narrow8"

// 11 int8 args: the 9th..11th overflow to the stack.  Apple-AArch64 packs a
// narrow int8 stack arg at its natural 1-byte stride, but the native caller's
// StackArgNarrow4 only handles 4-byte scalars (int32/float32), so int8/int16
// keep the rounded 8-byte slot — a cross-boundary offset mismatch (the same
// wrong-code class 897 fixed for int32, at a narrower width).  This is xfailed
// on native aa64 pending int8/int16 natural-size handling.

func Sum11I8(a int8, b int8, c int8, d int8, e int8, f int8, g int8, h int8,
	i int8, j int8, k int8) int8
