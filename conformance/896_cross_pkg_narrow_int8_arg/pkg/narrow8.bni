package "pkg/narrow8"

// 11 int8 args: the 9th..11th overflow to the stack.  Apple-AArch64 packs a
// narrow int8 stack arg at its natural 1-byte stride, so the native caller must
// store each at that width (StackArgStoreSize) — a rounded 8-byte slot would be
// a cross-boundary offset mismatch (the int32 case of the same shape is 897).

func Sum11I8(a int8, b int8, c int8, d int8, e int8, f int8, g int8, h int8,
	i int8, j int8, k int8) int8
