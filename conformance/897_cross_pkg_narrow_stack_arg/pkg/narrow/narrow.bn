package "pkg/narrow"

func Sum11F32(a float32, b float32, c float32, d float32, e float32, f float32,
		g float32, h float32, i float32, j float32, k float32) float32 {
	return a + b + c + d + e + f + g + h + i + j + k
}

func Sum11I32(a int32, b int32, c int32, d int32, e int32, f int32, g int32,
		h int32, i int32, j int32, k int32) int32 {
	return a + b + c + d + e + f + g + h + i + j + k
}

func Sum11F64(a float64, b float64, c float64, d float64, e float64, f float64,
		g float64, h float64, i float64, j float64, k float64) float64 {
	return a + b + c + d + e + f + g + h + i + j + k
}
