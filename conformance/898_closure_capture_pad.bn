package "main"
import "pkg/builtins/testing"

// A closure capturing int32/int64 variables interleaved: each int64's 8-byte
// alignment inserts a [4 x i8] pad field after the preceding int32 in the
// packed capture struct (on EVERY target — int32 is 4 bytes everywhere, int64
// is 8-aligned).  The closure thunk must read each capture at its PADDED LLVM
// field index, not the raw capture index, or it reads a pad field as a capture
// and shifts every later one (dropping the last).  This is the closure-capture
// -pad bug arm32's float64 8-alignment first exposed (891/697); here it is
// pinned cross-target.  Without the fix the thunk yields 5+0+100+7 = 112; the
// correct sum is 5+100+7+1000 = 1112.

func makeAdder() @func() int64 {
	var a int32 = 5
	var b int64 = 100
	var c int32 = 7
	var d int64 = 1000
	return func() int64 {
		return cast(int64, a) + b + cast(int64, c) + d
	}
}

func main() {
	var fn @func() int64 = makeAdder()
	testing.Println(cast(int, fn()))
}
