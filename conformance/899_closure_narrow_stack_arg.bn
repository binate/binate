package "main"

// Pins the native GP capturing-closure stack-spill shim's handling of
// NARROW (int32) args/captures that overflow to the outgoing-args
// stack.  On Apple-AArch64 a fixed int32 stack arg packs at natural-4
// stride/width, and the lifted closure body (a normal native callee)
// reads it there — but the shim re-marshalled overflow words in fixed
// 8-byte slots, so the 2nd+ narrow overflow item landed at the wrong
// offset (and was stored 8-byte over a 4-byte slot).  Pure-native
// miscompile: the shim and the callee prologue disagreed on the
// stack-arg convention.  LLVM / VM lower closures without this shim;
// x64 SysV pads narrow stack args to 8 (shim and body agree).
//
// Closure 1 — narrow USER-ARG overflow (Step-2 path): 6 int captures
// fill X0..X5, the first two int32 args fill X6/X7, and c, d overflow
// to the outgoing stack at natural-4 offsets 0, 4.  Pre-fix the shim
// wrote d at offset 8, so the body (reading natural-4) loaded d from
// the high half of c's slot (= 0): 81 instead of 121.
//
// Closure 2 — narrow CAPTURE overflow (Step-1 path): 8 int captures
// fill X0..X7, THREE int32 captures overflow to offsets 0, 4, 8.  The
// body reads them at natural-4; pre-fix the shim wrote each 8-byte at
// 8-byte offsets.  Two adjacent narrow captures happen to come out
// right (an 8-byte load of the packed struct carries the next field
// into the +4 slot), but the THIRD breaks the accident: ca/cb read
// correct, cc reads cb's value — 536 instead of 736.

func main() {
	var p0 int = 1
	var p1 int = 2
	var p2 int = 3
	var p3 int = 4
	var p4 int = 5
	var p5 int = 6
	var f1 *func(int32, int32, int32, int32) int =
		func(a int32, b int32, c int32, d int32) int {
			return p0 + p1 + p2 + p3 + p4 + p5 +
				cast(int, a) + cast(int, b) +
				cast(int, c) + cast(int, d)
		}
	// 21 + (10 + 20 + 30 + 40) = 121.
	println(f1(10, 20, 30, 40))

	var q0 int = 1
	var q1 int = 2
	var q2 int = 3
	var q3 int = 4
	var q4 int = 5
	var q5 int = 6
	var q6 int = 7
	var q7 int = 8
	var ca int32 = 100
	var cb int32 = 200
	var cc int32 = 400
	var f2 *func() int =
		func() int {
			return q0 + q1 + q2 + q3 + q4 + q5 + q6 + q7 +
				cast(int, ca) + cast(int, cb) + cast(int, cc)
		}
	// 36 + (100 + 200 + 400) = 736.
	println(f2())
}
