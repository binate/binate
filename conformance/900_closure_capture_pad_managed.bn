package "main"
import "pkg/builtins/testing"

// Companion to 898_closure_capture_pad, for a NON-scalar capture after an
// alignment pad.  898 only exercises scalar (int32/int64) captures past a pad;
// here an int32 capture forces a [N x i8] pad before a MANAGED (@Box) capture
// (an 8-byte managed pointer, 8-aligned on LP64), so the closure must (a) LOAD
// the managed field at its PADDED LLVM field index in the thunk, AND (b) RefDec
// it at that same padded index in the closure dtor when fn goes out of scope.
// A wrong index would read the pad as the managed pointer (garbage → crash /
// wrong value / leak), exercising a path 898's scalars (never RefDec'd) cannot.
// On LP64 the int32→@Box pair pads (managed ptr is 8 bytes); on arm32 the
// managed ptr is 4 bytes so there is no pad — the LP64 host is where this bites.

type Box struct {
	v int
}

func makeBoxed() @func() int {
	var tag int32 = 7
	var b @Box = make(Box)
	b.v = 100
	return func() int {
		return cast(int, tag) + b.v
	}
}

func main() {
	var fn @func() int = makeBoxed()
	testing.Println(fn())
}
