package "main"

import "pkg/narrowmix"

// Mixed-width narrow stack args across the native↔LLVM boundary on darwin: the
// native caller compiles main, the dep (narrowmix) goes through LLVM.  After 8
// int fillers consume X0..X7, six narrow args overflow to the outgoing stack at
// their NATURAL Apple-AArch64 offsets (with inter-arg alignment padding):
//   a int8  @ 0   b int16 @ 2   c int32 @ 4
//   d int8  @ 8   e int16 @ 10  f int32 @ 12
// The native caller must store each at that offset and width (STRB/STRH/STR) to
// agree with the LLVM-compiled callee's reads.  An 8-byte-rounded store would
// place them at 0/8/16/.. — a cross-boundary offset miscompile.  This test is
// self-validating: it passes only if the native convention matches LLVM's.

func main() {
	println(narrowmix.Mix(1, 2, 3, 4, 5, 6, 7, 8,
		10, 20, 30, 40, 50, 60)) // 36 + 210 = 246
}
