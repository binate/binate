package "pkg/narrowmix"

// 8 int fillers (X0..X7) + 6 narrow args (int8/int16/int32) that overflow to
// the stack at natural offsets with alignment padding — see main.bn.
func Mix(p0 int, p1 int, p2 int, p3 int, p4 int, p5 int, p6 int, p7 int,
	a int8, b int16, c int32, d int8, e int16, f int32) int
