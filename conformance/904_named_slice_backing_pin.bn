package "main"
import "pkg/builtins/testing"

// A subslice of a NAMED managed-slice (`type Buf @[]int`) must pin its
// backing exactly like a plain `@[]T` subslice: the result header's
// backing_refptr / backingLen words must be initialized from the original.
// If they are left uninitialized — which happens when the subslice lowering
// keys its header-field init off the un-peeled named Kind (TYP_NAMED, not
// TYP_MANAGED_SLICE) — the subslice does not pin the backing. The original's
// backing is then freed when it goes out of scope, and the returned subslice
// dangles (use-after-free): reads come back as reused-allocation garbage (or
// crash). makeSub returns a subslice of a named managed-slice; main then
// allocates over the would-be-freed backing and reads through the subslice.

type Buf @[]int

func makeSub() @[]int {
	var buf Buf = make_slice(int, 3)
	buf[0] = 5
	buf[1] = 6
	buf[2] = 7
	return buf[0:2]
}

func main() {
	var sub @[]int = makeSub()
	// If the backing was wrongly freed, this reuses it with sentinels.
	var filler @[]int = make_slice(int, 3)
	filler[0] = 999
	filler[1] = 999
	filler[2] = 999
	testing.Println(sub[0]) // 5
	testing.Println(sub[1]) // 6
}
