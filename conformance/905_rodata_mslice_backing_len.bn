package "main"

// A readonly string-literal managed-slice (OP_RODATA_MSLICE) must set its
// backing_len — word 3 of the { data, len, backing_refptr, backing_len }
// header — to len (the backing IS the rodata blob), matching rt.MakeManagedSlice
// and the LLVM backend.  A 0 backing_len (the old native bug) makes a reslice
// read a wrong backing length.
func main() {
	var s @[]readonly char = "hello"
	var base *int = bit_cast(*int, &s)
	println(base[1])      // len = 5
	println(base[3])      // backing_len = 5 (was 0 on native)

	// Subslicing preserves backing_len (cf. 129_subslice_backing_len).
	var sub @[]readonly char = s[1:3]
	println(len(sub))     // 2
	var subBase *int = bit_cast(*int, &sub)
	println(subBase[3])   // backing_len preserved = 5
}
