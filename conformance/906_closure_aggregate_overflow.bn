package "main"
import "pkg/builtins/testing"

// Stack-spill path of the native aa64 aggregate-RETURN capturing-closure shim:
// a closure whose function-value returns a struct, with enough captures + user
// args that they no longer fit the GP arg registers (or the incoming user words
// exceed X2..X7).  Before this path existed the shim raised a.SetError; now it
// frames a prologue, spills the overflow captures/args, BLs the lifted body, and
// routes the aggregate result through the retbuf.  Exercises both return shapes
// and both user-arg shift directions.

type Pair struct {
	A int
	B int
}

type Triple struct {
	A int
	B int
	C int
}

func main() {
	// PACK return (16 bytes, packed in X0:X1).  5 int captures + 5 int user
	// args = 10 outgoing words: captures fill X0..X4, args fill X5..X7, the
	// last two args overflow to the stack.  captureWords 5 >= 2 → the user-arg
	// moves shift toward higher regs (right-to-left).
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var c3 int = 4
	var c4 int = 5
	var f *func(int, int, int, int, int) Pair =
		func(a0 int, a1 int, a2 int, a3 int, a4 int) Pair {
			var r Pair
			r.A = c0 + c1 + c2 + c3 + c4
			r.B = a0 + a1 + a2 + a3 + a4
			return r
		}
	var p Pair = f(10, 20, 30, 40, 50)
	testing.Println(p.A + p.B) // 15 + 150 = 165

	// SRET return (24 bytes, written through X8).  1 int capture + 8 int user
	// args: the 8 user words exceed X2..X7, so the 7th/8th arrive on the
	// caller stack; outgoing, the capture fills X0, args fill X1..X7, the last
	// overflows.  captureWords 1 < 2 → the user-arg moves shift toward lower
	// regs (left-to-right).  The result mixes every arg (incl. the stack ones)
	// so a wrong offset shows.
	var b0 int = 1000
	var g *func(int, int, int, int, int, int, int, int) Triple =
		func(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int,
				a7 int) Triple {
			var r Triple
			r.A = a0 + a1 + a2
			r.B = a3 + a4 + a5
			r.C = a6 + a7 + b0
			return r
		}
	var t Triple = g(1, 2, 3, 4, 5, 6, 7, 8)
	testing.Println(t.A + t.B + t.C) // 6 + 15 + 1015 = 1036
}
