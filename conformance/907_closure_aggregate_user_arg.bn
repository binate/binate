package "main"

// Aggregate USER-ARGS through the native aa64 aggregate-return capturing-closure
// stack-spill shim — the two shapes the scalar/register paths never exercised:
//   * a SPLIT small aggregate (straddles the last GP arg reg and the stack), and
//   * an indirect-large aggregate (>16 bytes, passed as one pointer word).
// Both reach emitUserArgWordMoveAA64 / emitAggUserArgAA64.  A SPLIT arg must
// place its reg word(s) AND its stack word(s); an indirect-large arg is a single
// pointer word (EffectiveArgWords, not ArgWords) — counting its full ArgWords
// would over-read incoming regs and clobber a neighbor.

type Pair struct {
	A int
	B int
}

type Triple struct {
	A int
	B int
	C int
}

func main() {
	// SPLIT: 5 int captures (X0..X4) + a0 (X5) + a1 (X6) + a Pair pp.  pp's
	// word 0 rides X7, word 1 overflows to the stack — a SPLIT outgoing arg.
	// Returns Triple (24 B = sret).
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var c3 int = 4
	var c4 int = 5
	var f *func(int, int, Pair) Triple =
		func(a0 int, a1 int, pp Pair) Triple {
			var r Triple
			r.A = c0 + c1 + c2 + c3 + c4
			r.B = a0 + a1
			r.C = pp.A + pp.B
			return r
		}
	var arg Pair
	arg.A = 100
	arg.B = 200
	var t Triple = f(10, 20, arg)
	println(t.A + t.B + t.C) // 15 + 30 + 300 = 345

	// INDIRECT-LARGE: 8 int captures fill X0..X7; a Triple user arg (>16 B) is
	// passed as one pointer word that overflows to the stack.  Returns Pair
	// (16 B = pack).
	var d0 int = 1
	var d1 int = 2
	var d2 int = 3
	var d3 int = 4
	var d4 int = 5
	var d5 int = 6
	var d6 int = 7
	var d7 int = 8
	var g *func(Triple) Pair =
		func(tt Triple) Pair {
			var r Pair
			r.A = d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7
			r.B = tt.A + tt.B + tt.C
			return r
		}
	var u Triple
	u.A = 1000
	u.B = 2000
	u.C = 3000
	var p Pair = g(u)
	println(p.A + p.B) // 36 + 6000 = 6036
}
