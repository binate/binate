package "main"
import "pkg/builtins/testing"

// A SCALAR-return capturing closure with an indirect-large (>16-byte) aggregate
// USER ARG that overflows to the stack — the shape that crashed the scalar
// closure stack-spill shim.  8 int captures fill X0..X7; the Triple user arg is
// passed as one pointer word that spills to the stack.  The lifted body
// dereferences that pointer through X16 (IP0).  The shim used to be a leaf shim
// that stashed the caller's LR in X16 across the BL, so the body's deref
// clobbered the saved LR and the shim's RET jumped to garbage (SIGSEGV).  With
// a framed STP/LDP prologue the LR lives on the stack and survives.

type Triple struct {
	A int
	B int
	C int
}

func main() {
	var d0 int = 1
	var d1 int = 2
	var d2 int = 3
	var d3 int = 4
	var d4 int = 5
	var d5 int = 6
	var d6 int = 7
	var d7 int = 8
	var g *func(Triple) int =
		func(tt Triple) int {
			return d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7 +
				tt.A + tt.B + tt.C
		}
	var u Triple
	u.A = 1000
	u.B = 2000
	u.C = 3000
	testing.Println(g(u)) // 36 + 6000 = 6036
}
