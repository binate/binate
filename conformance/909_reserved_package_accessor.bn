package "main"

// The compiler synthesizes a per-package `__Package()` reflection accessor
// (mangled through the same public mangler a user function uses).  A user
// declaration named `__Package` would mangle to the identical linker symbol
// — a silent duplicate-symbol miscompilation — so it must be rejected.  This
// is the `__`-prefix reservation (lex.ident.reserved) applied to the
// accessor name specifically; see mangle.IsReservedIdentifier and
// pkg/binate/types/check_decl.bn (checkReservedDeclNames).

func __Package() int { return 0 }

func main() {
	println("unreachable -- this program must not compile")
}
