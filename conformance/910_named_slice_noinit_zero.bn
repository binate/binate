package "main"

// A no-initializer local of a NAMED managed-slice type (`type Buf @[]int`)
// must default to the nil slice {null, 0, null, 0}, exactly like a plain
// `var s @[]int`. The no-init nil-store dispatch must peel the named wrapper;
// otherwise the local is left uninitialized and — on a backend that does not
// zero-fill the alloca (LLVM) — reads stack garbage. dirty() leaves non-zero
// values on the stack so an unzeroed slot is observably wrong.

type Buf @[]int

func dirty() int {
	var a @[]int = make_slice(int, 4)
	a[0] = 111
	a[1] = 222
	a[2] = 333
	a[3] = 444
	return len(a)
}

func main() {
	var d int = dirty()
	var b Buf // no initializer — must be the nil slice
	println(len(b))     // 0
	println(present(b)) // false
	println(d)          // 4 (keep dirty() live so the stack is actually dirtied)
}
