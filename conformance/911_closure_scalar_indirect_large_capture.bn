package "main"

// Companion to 908: the X16-LR framed-prologue fix must also protect a scalar-
// return closure that CAPTURES an indirect-large (>16-byte) aggregate which
// overflows to the outgoing-args stack.  8 int captures fill X0..X7; the Triple
// capture is indirect-large (one pointer word) and spills (Step-1 capture spill,
// ADD X16 + STR).  The lifted body dereferences that capture pointer through X16
// — the same IP0 the old leaf shim used to hold the saved LR, so this crashed on
// return pre-fix.  Exercises emitClosureCaptureSpillAA64's indirect-large branch,
// which 908 (an indirect-large USER ARG) does not.

type Triple struct {
	A int
	B int
	C int
}

func main() {
	var d0 int = 1
	var d1 int = 2
	var d2 int = 3
	var d3 int = 4
	var d4 int = 5
	var d5 int = 6
	var d6 int = 7
	var d7 int = 8
	var tt Triple
	tt.A = 100
	tt.B = 200
	tt.C = 300
	var f *func() int =
		func() int {
			return d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7 +
				tt.A + tt.B + tt.C
		}
	println(f()) // 36 + 600 = 636
}
