package "main"

// Stack-spill path of the native aa64 float-aware SCALAR-return closure shim:
// a float-containing closure whose GP captures + args exceed X0..X7, so GP words
// overflow to the outgoing-args stack while the floats ride D0/D1.  Before the
// stack-spill path existed the shim raised a.SetError.  8 int captures fill
// X0..X7; the float capture rides D0; the 3 int user args overflow to the stack;
// the float user arg rides D1.

func main() {
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var c3 int = 4
	var c4 int = 5
	var c5 int = 6
	var c6 int = 7
	var c7 int = 8
	var fcap float64 = 100.0
	var f *func(int, int, int, float64) int =
		func(a0 int, a1 int, a2 int, af float64) int {
			return c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 +
				a0 + a1 + a2 + cast(int, fcap) + cast(int, af)
		}
	// 36 + 60 + 100 + 40 = 236.
	println(f(10, 20, 30, 40.0))
}
