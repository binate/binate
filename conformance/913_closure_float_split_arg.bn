package "main"
import "pkg/builtins/testing"

// SPLIT aggregate arg through the float-aware closure shim: 7 int captures fill
// X0..X6, the float capture rides D0, and a 16-byte Pair user arg straddles the
// last GP reg (word 0 -> X7, word 1 -> the outgoing stack).

type Pair struct {
	A int
	B int
}

func main() {
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var c3 int = 4
	var c4 int = 5
	var c5 int = 6
	var c6 int = 7
	var fcap float64 = 1000.0
	var f *func(Pair) int =
		func(p Pair) int {
			return c0 + c1 + c2 + c3 + c4 + c5 + c6 +
				p.A + p.B + cast(int, fcap)
		}
	var arg Pair
	arg.A = 100
	arg.B = 200
	// 28 + 300 + 1000 = 1328.
	testing.Println(f(arg))
}
