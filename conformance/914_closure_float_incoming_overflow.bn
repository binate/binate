package "main"

// Incoming-stack-arg overflow + outgoing GP overflow through the float-aware
// closure shim: a float capture + 9 int user args.  The 8th/9th incoming user
// words arrive on the caller's stack (the shim spills them); outgoing, the 9th
// int overflows past X7.

func main() {
	var fcap float64 = 100.0
	var f *func(int, int, int, int, int, int, int, int, int) int =
		func(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int, a7 int,
				a8 int) int {
			return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 +
				cast(int, fcap)
		}
	// 45 + 100 = 145.
	println(f(1, 2, 3, 4, 5, 6, 7, 8, 9))
}
