package "main"

// Indirect-large (>16-byte) aggregate USER ARGS through the float-aware closure
// shim: a float capture + 3 Triple args, each passed as one pointer word.
// EffectiveArgWords counts each as 1 (register-only); the old ArgWords counted
// 3 each (9 > 7) and spuriously SetError'd.

type Triple struct {
	A int
	B int
	C int
}

func main() {
	var fcap float64 = 1000.0
	var f *func(Triple, Triple, Triple) int =
		func(t1 Triple, t2 Triple, t3 Triple) int {
			return t1.A + t1.B + t1.C + t2.A + t2.B + t2.C +
				t3.A + t3.B + t3.C + cast(int, fcap)
		}
	var t1 Triple
	t1.A = 1
	t1.B = 2
	t1.C = 3
	var t2 Triple
	t2.A = 4
	t2.B = 5
	t2.C = 6
	var t3 Triple
	t3.A = 7
	t3.B = 8
	t3.C = 9
	// 45 + 1000 = 1045.
	println(f(t1, t2, t3))
}
