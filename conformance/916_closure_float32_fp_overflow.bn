package "main"
import "pkg/builtins/testing"

// float32 FP-overflow through the float-aware closure shim: 8 float32 captures
// fill D0..D7, and the float32 user arg is the 9th float — it overflows to the
// outgoing-args stack at its NATURAL 4-byte width (Apple-AArch64).

func main() {
	var f0 float32 = 1.0
	var f1 float32 = 2.0
	var f2 float32 = 3.0
	var f3 float32 = 4.0
	var f4 float32 = 5.0
	var f5 float32 = 6.0
	var f6 float32 = 7.0
	var f7 float32 = 8.0
	var f *func(float32) int =
		func(fa float32) int {
			return cast(int, f0 + f1 + f2 + f3 + f4 + f5 + f6 + f7 + fa)
		}
	// 1+2+...+8+9 = 45.
	testing.Println(f(9.0))
}
