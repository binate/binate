package "main"

// No-initializer locals of NAMED non-managed-slice multi-word types must also
// default to nil, like the named managed-slice in 910: a named raw slice, a
// named managed func-value, a named managed pointer, and a named managed
// interface-value. The no-init nil-init dispatch peels the named wrapper for
// all of these (gen_stmt.bn); without the peel a named wrapper skips its
// nil-store and reads stack garbage on the LLVM backend (native + the VM
// zero-fill the alloca). dirty() leaves non-zero values on the stack first.

interface Greeter {
	Hi() int
}

type RawBuf *[]int    // named raw slice
type Fn @func() int   // named managed func-value
type Pi @int          // named managed pointer
type G @Greeter       // named managed interface-value

func dirty() int {
	var a @[]int = make_slice(int, 4)
	a[0] = 11
	a[1] = 22
	a[2] = 33
	a[3] = 44
	return len(a)
}

func main() {
	var d int = dirty()
	var b RawBuf // no-init named raw slice
	var f Fn     // no-init named managed func-value
	var p Pi     // no-init named managed pointer
	var g G      // no-init named managed interface-value
	println(len(b))       // 0
	println(present(f))   // false
	println(present(p))   // false
	println(present(g))   // false
	println(d)            // 4
}
