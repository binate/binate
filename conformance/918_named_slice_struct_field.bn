package "main"

// Regression: a NAMED managed-slice (`type Buf @[]int`) used as a struct FIELD.
// Such a field must be classified by its underlying managed-slice kind via
// peelTransparent, NOT ResolveAlias — ResolveAlias peels only TYP_ALIAS and
// leaves the TYP_NAMED wrapper intact, so the field misses the managed-slice arm
// in the copy/dtor generators (pkg/binate/ir/gen_copy_emit.bn, gen_dtor_emit*.bn)
// and mis-routes to a per-element copy helper that is never defined (managed-slice
// copy is shared-backing RefInc, so no such helper exists or is needed).  Correct
// handling: RefInc the backing on copy, RefDec it on the scope-exit dtor.
//
// This also exercises a named-slice indexed STORE (`b[0] = 7`); see
// 926_named_slice_index_store for the isolated reducer of that path.

type Buf @[]int
type Row struct {
	data Buf
}

func main() {
	var b Buf = make_slice(int, 2)
	b[0] = 7
	var r Row = Row{data: b}
	println(r.data[0]) // 7
}
