package "main"

// MAJOR (tracked) codegen bug: a NAMED managed-slice used as a struct FIELD
// emits a call to an undefined per-element copy helper (__copy_ms_int) that is
// never declared/defined, so the compiled backends (LLVM + native) fail to
// link.  A plain unnamed @[]int field works.  The bytecode VM is unaffected.
// xfail'd on every compiled mode; the VM modes run it and pass (witnessing that
// the defect is in the compiled copy-helper emission, not the language/IR).

type Buf @[]int
type Row struct {
	data Buf
}

func main() {
	var b Buf = make_slice(int, 2)
	b[0] = 7
	var r Row = Row{data: b}
	println(r.data[0]) // 7
}
