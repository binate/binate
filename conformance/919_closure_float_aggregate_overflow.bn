package "main"

// Stack-spill path of the native aa64 float-aware AGGREGATE-return closure shim:
// a float-containing closure that returns a struct, with GP captures + args
// exceeding X0..X7 so GP words overflow to the outgoing-args stack while the
// floats ride D0/D1.  Before this path existed the shim raised a.SetError.
// Covers both the pack (<=16-byte) and sret (>16-byte) return shapes.

type Pair struct {
	A int
	B int
}

type Triple struct {
	A int
	B int
	C int
}

func main() {
	// PACK return (16-byte Pair).  8 int captures fill X0..X7; the float
	// capture rides D0; the 3 int user args overflow to the stack; the float
	// user arg rides D1.
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var c3 int = 4
	var c4 int = 5
	var c5 int = 6
	var c6 int = 7
	var c7 int = 8
	var fc float64 = 1000.0
	var f1 *func(int, int, int, float64) Pair =
		func(a0 int, a1 int, a2 int, af float64) Pair {
			var r Pair
			r.A = c0 + c1 + c2 + c3 + c4 + c5 + c6 + c7 + a0 + a1 + a2
			r.B = cast(int, fc) + cast(int, af)
			return r
		}
	var p Pair = f1(10, 20, 30, 2000.0)
	println(p.A + p.B) // 96 + 3000 = 3096

	// SRET return (24-byte Triple).  Same overflow shape, written through X8.
	var d0 int = 1
	var d1 int = 2
	var d2 int = 3
	var d3 int = 4
	var d4 int = 5
	var d5 int = 6
	var d6 int = 7
	var d7 int = 8
	var gc float64 = 100.0
	var g1 *func(int, int, int, float64) Triple =
		func(b0 int, b1 int, b2 int, bf float64) Triple {
			var r Triple
			r.A = d0 + d1 + d2 + d3 + d4 + d5 + d6 + d7
			r.B = b0 + b1 + b2
			r.C = cast(int, gc) + cast(int, bf)
			return r
		}
	var t Triple = g1(40, 50, 60, 200.0)
	println(t.A + t.B + t.C) // 36 + 150 + 300 = 486
}
