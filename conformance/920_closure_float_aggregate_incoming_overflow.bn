package "main"
import "pkg/builtins/testing"

// Incoming-stack-arg overflow through the float-aware AGGREGATE-return closure
// shim: a float capture + 8 int user args returning a Pair.  The aggregate
// dispatch holds user args in X2..X7 (6 regs); the 7th/8th arrive on the
// caller's stack and the shim spills them.  No outgoing GP overflow (8 ints fit
// X0..X7) — this isolates the aggregate frame's incoming-spill path.

type Pair struct {
	A int
	B int
}

func main() {
	var fcap float64 = 1000.0
	var f *func(int, int, int, int, int, int, int, int) Pair =
		func(a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int,
				a7 int) Pair {
			var r Pair
			r.A = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7
			r.B = cast(int, fcap)
			return r
		}
	var p Pair = f(1, 2, 3, 4, 5, 6, 7, 8)
	testing.Println(p.A + p.B) // 36 + 1000 = 1036
}
