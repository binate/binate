package "main"
import "pkg/builtins/testing"

// Aggregate-return capturing-closure stack-spill: an indirect-large (>16 B,
// one-pointer-word) user arg FOLLOWED by scalar args, with enough captures to
// overflow the GP arg registers.  907 only passes an indirect-large arg as the
// SOLE user arg; here a trailing run of scalars must land in the right outgoing
// slots AFTER it.  If the shim counted the indirect-large arg's full ArgWords
// (3 for a Triple) instead of its EffectiveArgWords (1 pointer word), every
// following scalar would be read from the wrong incoming register / overflow
// slot and the result would be wrong.  Exercised in both return shapes:
//   * pack (Pair, 16 B) — captures occupy argReg(0..), one trailing scalar
//     overflows to the outgoing stack, and
//   * sret (Quad, 32 B) — the retbuf consumes RDI, shifting captures/args up
//     one register so two trailing scalars overflow to the outgoing stack.

type Pair struct {
	A int
	B int
}

type Triple struct {
	A int
	B int
	C int
}

type Quad struct {
	A int
	B int
	C int
	D int
}

func main() {
	// Pack return.  3 int captures (c0..c2) + Triple tt (indirect-large) +
	// i0..i2.  Outgoing: c0(RDI) c1(RSI) c2(RDX) tt-ptr(RCX) i0(R8) i1(R9)
	// i2(stack).  Incoming user args ride RDX(tt-ptr) RCX(i0) R8(i1) R9(i2).
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var f *func(Triple, int, int, int) Pair =
		func(tt Triple, i0 int, i1 int, i2 int) Pair {
			var r Pair
			r.A = c0 + c1 + c2
			r.B = tt.A + tt.B + tt.C + i0 + i1 + i2
			return r
		}
	var t0 Triple
	t0.A = 10
	t0.B = 20
	t0.C = 30
	var p Pair = f(t0, 4, 5, 6)
	testing.Println(p.A + p.B) // 6 + (60 + 15) = 81

	// Sret return.  3 int captures + Triple uu (indirect-large) + j0..j2.
	// retbuf rides RDI, so outgoing captures/args shift up: c0(RSI) c1(RDX)
	// c2(RCX) uu-ptr(R8) j0(R9) j1(stack) j2(stack).
	var d0 int = 1
	var d1 int = 2
	var d2 int = 3
	var g *func(Triple, int, int, int) Quad =
		func(uu Triple, j0 int, j1 int, j2 int) Quad {
			var r Quad
			r.A = d0 + d1 + d2
			r.B = uu.A + uu.B + uu.C
			r.C = j0 + j1
			r.D = j2
			return r
		}
	var u0 Triple
	u0.A = 100
	u0.B = 200
	u0.C = 300
	var q Quad = g(u0, 7, 8, 9)
	testing.Println(q.A + q.B + q.C + q.D) // 6 + 600 + 15 + 9 = 630
}
