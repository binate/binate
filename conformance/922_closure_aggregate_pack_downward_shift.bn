package "main"

// Aggregate-return capturing-closure stack-spill, PACK shape with a single
// capture word: the outgoing user args sit one register BELOW their incoming
// slots (capture at RDI, args at RSI.. vs incoming RDX..), a DOWNWARD shift.
// The user-arg moves must run low-word-first / left-to-right; running them
// high-first (correct only for an upward shift) makes each move overwrite the
// next move's source register, cascading one incoming value over all the
// others.  Reached via nUserWords > 4 (the 5th incoming arg rides the caller
// stack), which forces the stack-spill path even though all outgoing args fit
// registers.  Returns Pair (16 B = pack).

type Pair struct {
	A int
	B int
}

func main() {
	var cap0 int = 1000
	var f *func(int, int, int, int, int) Pair =
		func(a0 int, a1 int, a2 int, a3 int, a4 int) Pair {
			var r Pair
			r.A = cap0
			r.B = a0 + a1 + a2 + a3 + a4
			return r
		}
	var p Pair = f(10, 20, 30, 40, 50)
	println(p.A) // 1000
	println(p.B) // 150 (not 250 from a clobbering high-first shift)
}
