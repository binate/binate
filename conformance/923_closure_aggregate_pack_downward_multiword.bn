package "main"
import "pkg/builtins/testing"

// Aggregate-return capturing-closure stack-spill, PACK shape with a single
// capture word AND a multi-word (2-eightbyte) user argument in the DOWNWARD
// shift.  Beyond the cross-argument cascade (922), a downward shift of -1 makes
// a multi-word arg's own word k's outgoing slot coincide with word (k-1)'s
// incoming slot, so the words must move low-first WITHIN the arg too; high-first
// would read word 0 from a register word 1 already overwrote, swapping the
// aggregate's fields.  Returns Pair (pack); the same shape exercises the
// equivalent native-aarch64 path.

type Pair struct {
	A int
	B int
}

func main() {
	var cap0 int = 1000
	var f *func(Pair, int, int, int) Pair =
		func(pp Pair, i0 int, i1 int, i2 int) Pair {
			var r Pair
			r.A = cap0 + pp.A
			r.B = pp.B + i0 + i1 + i2
			return r
		}
	var arg Pair
	arg.A = 11
	arg.B = 22
	var p Pair = f(arg, 3, 4, 5)
	testing.Println(p.A) // 1011 (not 1022 from a swapped pp.A/pp.B)
	testing.Println(p.B) // 34
}
