package "main"
import "pkg/builtins/testing"

// Aggregate-return capturing-closure stack-spill, Step 1 coverage: a multi-word
// (2-eightbyte) struct CAPTURE that overflows to the outgoing stack.  Five int
// captures fill RDI..R8; the Pair capture's two eightbytes don't both fit the
// remaining arg register, so SysV passes it wholly in memory — the shim must
// spill its words from the closure struct to the outgoing-args area (the
// per-word RAX shuttle in Step 1).  The reg-bound int captures (Step 3) and an
// overflowing scalar user arg (reg-source -> stack-dest) round out the path.
// Returns Pair (pack).

type Pair struct {
	A int
	B int
}

func main() {
	var c0 int = 1
	var c1 int = 2
	var c2 int = 3
	var c3 int = 4
	var c4 int = 5
	var pcap Pair
	pcap.A = 100
	pcap.B = 200
	var f *func(int) Pair =
		func(a0 int) Pair {
			var r Pair
			r.A = c0 + c1 + c2 + c3 + c4 + pcap.A + pcap.B
			r.B = a0
			return r
		}
	var p Pair = f(7)
	testing.Println(p.A) // 315
	testing.Println(p.B) // 7
}
