package "main"
import "pkg/builtins/testing"

// Like 923 (PACK shape, single capture word, multi-word user arg in the DOWNWARD
// shift) but with enough trailing scalar args that the incoming user args spill
// past the GP arg registers on BOTH native backends — so the multi-word downward
// case reaches the stack-spill path on aarch64 (8 arg regs) as well as x64 (6).
// The leading Pair's two words must move low-first within the arg; a high-first
// within-arg order swaps its fields.

type Pair struct {
	A int
	B int
}

func main() {
	var cap0 int = 1000
	var f *func(Pair, int, int, int, int, int, int) Pair =
		func(pp Pair, i0 int, i1 int, i2 int, i3 int, i4 int, i5 int) Pair {
			var r Pair
			r.A = cap0 + pp.A
			r.B = pp.B + i0 + i1 + i2 + i3 + i4 + i5
			return r
		}
	var arg Pair
	arg.A = 11
	arg.B = 22
	var p Pair = f(arg, 1, 2, 3, 4, 5, 6)
	testing.Println(p.A) // 1011 (not 1022 from a swapped pp.A/pp.B)
	testing.Println(p.B) // 43
}
