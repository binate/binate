package "main"
import "pkg/builtins/testing"

// Regression for the un-peel sweep: a NAMED non-int slice (`type B @[]int8`)
// must derive its element type from the PEELED slice type (collSt), not the raw
// TYP_NAMED wrapper (whose `.Elem` is nil).  The un-peeled read defaulted to
// TypInt and mis-strode the 1-byte int8 elements (silent corruption; SIGSEGV on
// the slice-set path).  Exercises indexed store (gen_control), indexed read +
// bounds (gen_access), multi-assign (gen_assign_multi), and parallel swap
// (gen_assign_parallel) over a named subword slice.

type B @[]int8

func main() {
	var b B = make_slice(int8, 4)
	var i int = 0
	for i = 0; i < 4; i = i + 1 { b[i] = cast(int8, i + 1) } // 1,2,3,4
	b[0], b[1] = b[1], b[0]                                  // parallel swap -> 2,1,3,4
	var x int = 0
	b[2], x = 9, 5                                           // multi-assign -> 2,1,9,4 ; x=5
	var sum int = 0
	for i = 0; i < 4; i = i + 1 { sum = sum + cast(int, b[i]) }
	testing.Println(sum + x) // (2+1+9+4) + 5 = 21
}
