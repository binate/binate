package "main"
import "pkg/builtins/testing"

// The bounds check for indexing a NAMED slice must not be skipped.
// emitIndexBoundsCheck classifies off the PEELED type, so a named slice
// (`type B @[]int`) is bounds-checked like a plain slice — it used to slip past
// the un-peeled `isSliceType(collection.Typ)` guard and index UNCHECKED
// (memory-unsafe).

type B @[]int

func main() {
	var b B = make_slice(int, 2)
	// len(b) == 2, valid indices are 0..1. b[5] is out of range.
	testing.Println(b[5])
}
