package "main"
import "pkg/builtins/testing"

// Regression: for-in over a NAMED slice / NAMED array.  The type checker
// (forInElemType) and IR-gen (genForIn) must peel the named wrapper: a named
// slice/array is TYP_NAMED, which ResolveAlias / the raw-Kind check leave intact,
// so for-in was rejected as "cannot range over non-iterable type" — and, once
// allowed, IR-gen would mis-route a named array to the slice path (EmitSliceLen
// on an array) and default a non-int named slice element to TypInt (mis-stride).

type B @[]int8
type Row [3]int

func main() {
	var b B = make_slice(int8, 4)
	var i int = 0
	for i = 0; i < 4; i = i + 1 { b[i] = cast(int8, i + 1) }
	var ssum int = 0
	for x in b { ssum = ssum + cast(int, x) } // 1+2+3+4 = 10
	var r Row
	r[0] = 10; r[1] = 20; r[2] = 30
	var asum int = 0
	for y in r { asum = asum + y }            // 10+20+30 = 60
	testing.Println(ssum + asum)                       // 70
}
