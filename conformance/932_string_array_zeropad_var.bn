package "main"

// A string literal SHORTER than a fixed char-array target: the bytes are
// copied and the tail is zero-padded (var-decl form). Companion to 299
// (exact-length) and 307 (positional struct field). Valid because AssignableTo
// allows a string literal [N] into [M]char when M >= N.
func main() {
	var b [8]readonly char = "alpha"
	println(cast(int, b[0]))  // 'a' = 97
	println(cast(int, b[4]))  // 'a' = 97
	println(cast(int, b[5]))  // 0 (padded)
	println(cast(int, b[7]))  // 0 (padded)
}
