package "main"

// The zero-padded string -> larger char-array init also works for a KEYED
// struct-literal field (not just the positional form 307 covers).
type Name struct {
	bytes [8]readonly char
	size  int
}

func main() {
	var n Name = Name{bytes: "alpha", size: 5}
	println(cast(int, n.bytes[0]))  // 'a' = 97
	println(cast(int, n.bytes[4]))  // 'a' = 97
	println(cast(int, n.bytes[5]))  // 0 (padded)
	println(n.size)                 // 5
}
