package "main"
import "pkg/cfg"

// An iota-grouped const declared in an imported `.bni` folds to its per-member
// value (bni_scope binds `iota` per member and defineBniConst folds the
// initializer), so an importer sees the real values — not the value-less 0 a
// missing fold would give.  Covers a plain `iota` group and a `0 - iota` group
// whose members are NEGATIVE.
func main() {
	println(cfg.A + cfg.B + cfg.C)   // 0 + 1 + 2 = 3
	println(cfg.N)                   // 0
	println(cfg.M)                   // -1
}
