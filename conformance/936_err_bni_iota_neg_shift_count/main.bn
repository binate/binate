package "main"
import "pkg/builtins/testing"
import "pkg/cfg"

// A NEGATIVE member of an iota-grouped `.bni` const (cfg.M = -1, from `0 - iota`
// at iota=1) used as a shift count must be rejected at compile time: defineBniConst
// folds the imported iota member to its value, so the negative-shift-count gate
// sees -1 and rejects it (rather than the const being value-less and slipping the
// gate, which would silently miscompile the shift to 0).
func main() {
	var x int = 8 << cfg.M
	testing.Println(x)
}
