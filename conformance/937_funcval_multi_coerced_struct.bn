package "main"
import "pkg/builtins/testing"

// Multiple adjacent coerced (in-register, <=16B) struct args through function
// values and closures.  Exercises cross-mode shim marshaling when the outgoing
// real-ABI register cursor (ArgWords per coerced struct) advances faster than
// the incoming by-address dispatch cursor (one pointer per struct): a naive
// constant-shift shuffle would write a struct's expanded word into a not-yet-read
// incoming register of an adjacent arg (a silent clobber).  Covered shapes:
// trailing scalar, leading scalar, all-struct, and a capturing closure.

type S3 struct {
	a int32
	b int32
	c int32
}

func combineTrail(x S3, y S3, n int32) int32 {
	return x.a + x.b + x.c + y.a + y.b + y.c + n
}

func combineLead(n int32, x S3, y S3) int32 {
	return n + x.a + x.b + x.c + y.a + y.b + y.c
}

func combineThree(x S3, y S3, z S3) int32 {
	return x.a + x.b + x.c + y.a + y.b + y.c + z.a + z.b + z.c
}

func makeAdder(base int32) @func(S3, S3, int32) int32 {
	return func(x S3, y S3, n int32) int32 {
		return base + x.a + x.b + x.c + y.a + y.b + y.c + n
	}
}

func main() {
	var x S3 = S3{a: cast(int32, 1), b: cast(int32, 2), c: cast(int32, 3)}
	var y S3 = S3{a: cast(int32, 10), b: cast(int32, 20), c: cast(int32, 30)}
	var z S3 = S3{a: cast(int32, 100), b: cast(int32, 200), c: cast(int32, 300)}

	var ft *func(S3, S3, int32) int32 = combineTrail
	testing.Println(cast(int, ft(x, y, cast(int32, 7)))) // 1+2+3+10+20+30+7 = 73

	var fl *func(int32, S3, S3) int32 = combineLead
	testing.Println(cast(int, fl(cast(int32, 7), x, y))) // 7+6+60 = 73

	var f3 *func(S3, S3, S3) int32 = combineThree
	testing.Println(cast(int, f3(x, y, z))) // 6+60+600 = 666

	var g @func(S3, S3, int32) int32 = makeAdder(cast(int32, 1000))
	testing.Println(cast(int, g(x, y, cast(int32, 7)))) // 1000+6+60+7 = 1073
}
