package "main"
import "pkg/builtins/testing"

// Coerced (in-register, <=16B) struct args through a function value, wide enough
// to overflow the shim's register budget into the STACK-SPILL marshaler.  Four
// 12B (N=2) structs + a trailing scalar = 9 outgoing real-ABI words (8 GP regs +
// stack on aarch64; 6 + stack on x64), so the spill path must (a) place the
// coerced value-words from each by-address pointer into the right reg/stack
// slots and (b) stay clobber-safe despite the incoming(1)/outgoing(ArgWords)
// cursor divergence (stage incoming before any outgoing write).

type S3 struct {
	a int32
	b int32
	c int32
}

func wide(p S3, q S3, r S3, s S3, n int32) int32 {
	return p.a + p.b + p.c + q.a + q.b + q.c +
		r.a + r.b + r.c + s.a + s.b + s.c + n
}

func main() {
	var p S3 = S3{a: cast(int32, 1), b: cast(int32, 2), c: cast(int32, 3)}
	var q S3 = S3{a: cast(int32, 10), b: cast(int32, 20), c: cast(int32, 30)}
	var r S3 = S3{a: cast(int32, 100), b: cast(int32, 200), c: cast(int32, 300)}
	var s S3 = S3{a: cast(int32, 1000), b: cast(int32, 2000), c: cast(int32, 3000)}
	var f *func(S3, S3, S3, S3, int32) int32 = wide
	// 6 + 60 + 600 + 6000 + 9 = 6675
	testing.Println(cast(int, f(p, q, r, s, cast(int32, 9))))
}
