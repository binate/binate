package "main"

// A method VALUE taken through an alias-typed receiver (`type AB = @Box; var
// mv = ab.getV`) must resolve and dispatch to the target's method, just like a
// method value taken through the target type directly.  An alias is transparent
// to its target, so the receiver's method set is the target's -- but the
// method-value path used to run ReceiverBaseNamed on the un-peeled alias type
// and see no methods ("undefined: getV").  Peeling TYP_ALIAS in ReceiverBaseNamed
// fixes resolution; the captured-receiver closure already keys off the value's
// (peeled) type, so the call dispatches correctly (bug 754, facet 1).
//
// Covers the alias-wrapper shapes: managed-ptr, raw-ptr, value, and
// readonly-over-managed-ptr receiver.

type Box struct {
	v int
}

func (b @Box) getMP() int { return b.v }   // managed-ptr receiver
func (b *Box) getRP() int { return b.v }   // raw-ptr receiver
func (b Box) getV() int { return b.v }     // value receiver

type AliasMP = @Box
type AliasRP = *Box
type AliasS = Box
type AliasRO = readonly @Box

func main() {
	var p @Box = make(Box)
	p.v = 7
	var amp AliasMP = p
	var mvMP *func() int = amp.getMP
	println(mvMP())            // 7  method value via alias @Box

	var raw *Box = p
	var arp AliasRP = raw
	var mvRP *func() int = arp.getRP
	println(mvRP())            // 7  method value via alias *Box

	var s AliasS
	s.v = 5
	var mvS *func() int = s.getV
	println(mvS())             // 5  method value via alias Box (value)

	var aro AliasRO = p
	var mvRO *func() int = aro.getMP
	println(mvRO())            // 7  method value via alias readonly @Box
}
