package "main"

// An `impl` whose receiver is a type ALIAS (`type AB = *Box; impl AB : Getter`)
// must register and dispatch the interface vtable under the TARGET's name, not
// the alias's.  An alias is transparent to its target, so `impl AB : Getter` is
// `impl *Box : Getter`; the method decls mangle their receiver to "Box", so the
// (receiver, interface) vtable must key on "Box" too.  IR-gen used to key the
// vtable on the alias name ("AB"), leaving its method slot null -- an interface
// call through it dispatched to a null pointer and crashed.  recvBaseTypeName
// resolves the alias to the target's short name so the vtable slot is filled
// and dispatch lands on the real method (bug 754, facet 2).
//
// Each alias-wrapper shape (raw-ptr, managed-ptr, readonly-over-managed) uses a
// distinct receiver type so every impl is genuinely distinct -- the shapes are
// exercised independently, not collapsed onto one base.

interface Getter {
	get() int
}

type Box struct { v int }
func (b *Box) get() int { return b.v }
type AliasRP = *Box
impl AliasRP : Getter

type Cup struct { v int }
func (c @Cup) get() int { return c.v }
type AliasMP = @Cup
impl AliasMP : Getter

type Jar struct { v int }
func (j @Jar) get() int { return j.v }
type AliasRO = readonly @Jar
impl AliasRO : Getter

func main() {
	var b Box = Box{v: 99}
	var g1 *Getter = &b
	println(g1.get())          // 99  dispatch via alias *Box impl

	var c @Cup = make(Cup)
	c.v = 42
	var g2 @Getter = c
	println(g2.get())          // 42  dispatch via alias @Cup impl

	var j @Jar = make(Jar)
	j.v = 13
	var g3 @Getter = j
	var g3ro readonly @Getter = g3
	println(g3ro.get())        // 13  dispatch via alias readonly @Jar impl
}
