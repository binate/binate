package "main"
import "pkg/builtins/testing"

// An impl whose receiver is a LOCAL ALIAS to an IMPORTED type
// (`type AB = *boxlib.Box`) must key its interface vtable on the TARGET's
// package AND short name (pkg/boxlib + "Box"), not the alias's spelling nor
// the impl's own package.  IR-gen resolves the alias to the imported base and
// reads BOTH from the resolved base's qualified name, so the (receiver,
// interface) vtable slot is filled and cross-package dispatch lands on the
// real method rather than a null pointer (bug 754, cross-package facet).

import "pkg/boxlib"

type AB = *boxlib.Box
impl AB : boxlib.Getter

func main() {
	var b boxlib.Box = boxlib.Box{v: 77}
	var g *boxlib.Getter = &b
	testing.Println(g.get())
}
