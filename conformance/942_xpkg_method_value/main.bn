package "main"
import "pkg/builtins/testing"

// A method VALUE taken on a cross-package receiver (`p.get` where `p` is
// `*boxlib.Box`) must reference the method symbol in the RECEIVER's defining
// package (pkg/boxlib), but genMethodValue mangles it with the importing
// module's package (buildMethodQualName(ctx.Gc.PkgPath, ...)), emitting a
// reference to a `main.Box.get` symbol that does not exist -> the module fails
// to link.  This is a PRE-EXISTING IR-gen bug independent of aliases (a direct,
// non-alias cross-package method value triggers it); it is xfailed pending the
// gen_method_value.bn package-derivation fix.  See claude-todo.md.

import "pkg/boxlib"

func main() {
	var b boxlib.Box = boxlib.Box{v: 88}
	var p *boxlib.Box = &b
	var mv *func() int = p.get
	testing.Println(mv())
}
