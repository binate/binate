package "main"
import "pkg/builtins/testing"

// A method VALUE taken on a cross-package receiver (`p.get` where `p` is
// `*boxlib.Box`) must reference the method symbol in the RECEIVER's defining
// package (pkg/boxlib), not the importing module's: a reference to a
// `main.Box.get` symbol, which does not exist, fails to link.  The shape is
// independent of aliases (a direct, non-alias cross-package method value).

import "pkg/boxlib"

func main() {
	var b boxlib.Box = boxlib.Box{v: 88}
	var p *boxlib.Box = &b
	var mv *func() int = p.get
	testing.Println(mv())
}
