package "main"

// A method VALUE taken on a cross-package receiver reached through a SELECTOR
// (`h.p.get` where `h.p` is `*boxlib.Box`) resolves the method symbol in the
// receiver's DEFINING package (pkg/boxlib) — exercising the getSelectorType
// branch of genMethodValue's receiver-type resolution (942 covers the ident
// receiver; both must qualify the symbol, not mangle it to the importer).

import "pkg/boxlib"

type Holder struct {
	p *boxlib.Box
}

func main() {
	var b boxlib.Box = boxlib.Box{v: 42}
	var h Holder = Holder{p: &b}
	var mv *func() int = h.p.get
	println(mv())
}
