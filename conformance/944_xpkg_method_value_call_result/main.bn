package "main"
import "pkg/builtins/testing"

// A method VALUE on a cross-package receiver reached through a CALL result
// (`GetBox().get` where GetBox() returns a `*boxlib.Box` to a persistent
// package global) resolves the method symbol in the receiver's DEFINING
// package — exercising the EXPR_CALL branch of genMethodValue's receiver-type
// resolution (funcRefName + lookupFuncResults on the callee's return type).
// The pointer is to a persistent global, so the captured receiver stays valid.

import "pkg/boxlib"

func main() {
	var mv *func() int = boxlib.GetBox().get
	testing.Println(mv())
}
