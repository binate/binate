package "main"

// KNOWN GAP (xfail): a method VALUE on a cross-package receiver reached through
// a CALL result (`NewBox(77).get`) is not yet qualified — methodValueRecvIRType
// has no EXPR_CALL case, so it falls back to the checker's unqualified name and
// mis-mangles the symbol to the importer (`main.Box.get`) → link failure. Fixing
// it needs the callee's qualified return type (funcRefName + lookupFuncResults);
// a value-returning callee with a pointer-receiver method additionally needs
// address-of-temp capture. Tracked in claude-todo.md.

import "pkg/boxlib"

func main() {
	var mv *func() int = boxlib.NewBox(77).get
	println(mv())
}
