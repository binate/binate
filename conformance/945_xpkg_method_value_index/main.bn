package "main"

// A method VALUE on a cross-package receiver reached through an INDEX
// (`arr[1].get` where `arr` is `[2]*boxlib.Box`) resolves the method symbol in
// the receiver's DEFINING package — exercising the EXPR_INSTANTIATE_OR_INDEX
// branch of genMethodValue's receiver-type resolution (getIndexElemType).

import "pkg/boxlib"

func main() {
	var b0 boxlib.Box = boxlib.Box{v: 10}
	var b1 boxlib.Box = boxlib.Box{v: 20}
	var arr [2]*boxlib.Box
	arr[0] = &b0
	arr[1] = &b1
	var mv *func() int = arr[1].get
	println(mv())
}
