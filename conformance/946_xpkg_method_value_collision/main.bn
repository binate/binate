package "main"

// Two cross-package method values whose closure-struct names COLLIDE under the
// old '/'+'.'→'_' char fold: `pkg/a/b.C.m` and `pkg/a.b_C.m` both fold to
// `__closure_pkg_a_b_C_m__methodval_v`, but with DIFFERENT-layout value
// receivers (C = 2 ints, b_C = 1 int) → a differently-shaped-struct codegen
// collision.  The mangle-based closure name keeps them distinct.

import "pkg/a/b"
import "pkg/a"

func main() {
	var c1 b.C = b.C{x: 3, y: 4}
	var c2 a.b_C = a.b_C{z: 9}
	var mv1 *func() int = c1.m
	var mv2 *func() int = c2.m
	println(mv1() + mv2())
}
