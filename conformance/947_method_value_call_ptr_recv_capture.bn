package "main"
import "pkg/builtins/testing"

// A method VALUE with a POINTER receiver taken on an addressable VALUE receiver
// that is not a plain variable — a field (`h.b.get`) — captures the field's
// address, as the call `h.b.get()` would take it: a later change to the field is
// seen through the method value.

type Box struct { v int }

func (b *Box) get() int { return b.v }

type Holder struct { b Box }

func main() {
	var h Holder = Holder{b: Box{v: 9}}
	var mv *func() int = h.b.get // field value receiver: captures &h.b
	testing.Println(mv())        // 9
	h.b.v = 14
	testing.Println(mv()) // 14
}
