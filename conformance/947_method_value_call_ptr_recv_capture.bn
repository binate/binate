package "main"
import "pkg/builtins/testing"

// A method VALUE with a POINTER receiver taken on a non-ident VALUE receiver —
// a call result (`mk().get`) or a field (`h.b.get`) — captures a COPY of the
// value in the closure and addresses it in the wrapper for the (synchronous)
// method call.  Matches the method-CALL semantics (`mk().get()` already
// materializes a copy via applyReceiverConversion).  Previously genCapturedRecv's
// T->*T smoothing handled only an EXPR_IDENT receiver and stored the value into
// the closure's *Box slot as a wild pointer -> SIGSEGV; now the value is captured
// by value (genMethodValue) and the wrapper alloca+addresses it.

type Box struct { v int }

func (b *Box) get() int { return b.v }

type Holder struct { b Box }

func mk() Box { return Box{v: 5} }

func main() {
	var mv1 *func() int = mk().get           // call-result value receiver
	var h Holder = Holder{b: Box{v: 9}}
	var mv2 *func() int = h.b.get            // field value receiver
	testing.Println(mv1() + mv2())                    // 5 + 9 = 14
}
