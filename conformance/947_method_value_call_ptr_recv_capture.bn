package "main"

// KNOWN BUG (xfail): a method VALUE with a POINTER receiver taken on a
// VALUE-returning call / temporary (`mk().get` where mk() returns Box by value
// and get takes *Box) should materialize the temporary and address it (Go
// semantics: mv() == 5).  But genCapturedRecv's T->*T smoothing only handles an
// EXPR_IDENT receiver (it uses the local's alloca-slot address); for a
// call-result it falls through and stores the Box VALUE into the closure's *Box
// slot as a WILD POINTER -> SIGSEGV at mv().  PRE-EXISTING (affects local AND
// cross-package method values) — a genCapturedRecv CAPTURE gap, distinct from
// the cross-package method-value NAMING fix (which landed and made cross-package
// call-result method values reach this same shared capture path).  Tracked in
// claude-todo.md.

type Box struct { v int }

func (b *Box) get() int { return b.v }

func mk() Box { return Box{v: 5} }

func main() {
	var mv *func() int = mk().get
	println(mv())
}
