package "main"

// A method value with a POINTER receiver taken on an SRET-returned (> 16-byte,
// by-address) value receiver from a call/temp (`mkBig().sum`).  Captured BY VALUE
// into the closure field: the aggregate store copies the sret call result's bytes
// in (LLVM loads it and stores field-wise; native memcpys), and the synthesized
// wrapper receives the > 16-byte receiver as a BYVAL param — so its param prologue
// memcpys from the `ptr byval(Big)` rather than mistyping a value store (`store
// %Big %ptr`).  That byval omission in the wrapper prologue formerly crashed this
// (a `*Big` addressing a dangling sret temp).  Sibling of 947 (register value
// receivers) and 952 (the sret x managed-field variant).

type Big struct { a int; b int; c int; d int }

func (x *Big) sum() int { return x.a + x.b + x.c + x.d }

func mkBig() Big { return Big{a: 1, b: 2, c: 3, d: 4} }

func main() {
	var mv *func() int = mkBig().sum
	println(mv())
}
