package "main"
import "pkg/builtins/testing"

// A method value with a VALUE receiver taken on an SRET-returned (> 16-byte,
// by-address) call result (`mkBig().sum`) captures a copy of it: the aggregate
// store copies the sret call result's bytes into the closure field (LLVM loads it
// and stores field-wise; native memcpys), and the synthesized wrapper receives the
// > 16-byte receiver as a BYVAL param, its prologue copying from the `ptr
// byval(Big)` rather than storing the pointer as the struct.  Sibling of 949 (a
// managed field) and 952 (both).

type Big struct { a int; b int; c int; d int }

func (x Big) sum() int { return x.a + x.b + x.c + x.d }

func mkBig() Big { return Big{a: 1, b: 2, c: 3, d: 4} }

func main() {
	var mv *func() int = mkBig().sum
	testing.Println(mv())
}
