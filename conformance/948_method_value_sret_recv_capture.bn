package "main"

// KNOWN GAP (xfail): a method value with a POINTER receiver taken on an SRET-
// returned (> 16-byte, by-address) value receiver from a call/temp (`mkBig().sum`).
// The register-returned by-value capture (947/949) is gated to !NeedsSret: an sret
// call result is backend-represented as a POINTER to the sret buffer — an OP_CALL,
// not an OP_ALLOC — so it can be neither load-then-stored (isAggregateAllocToLoad
// needs an OP_ALLOC) nor stored directly (EmitStore of the pointer into the by-
// value closure field mistypes it: `'%v0' defined with type 'ptr' but expected
// %Big`).  genMethodValue leaves it the old behavior (a *Big to a dangling sret
// temp -> SIGSEGV).  Fix: sret destination-forwarding (write the call result
// straight into the closure field) or a backend-aware struct-copy.  Tracked in
// claude-todo.md.

type Big struct { a int; b int; c int; d int }

func (x *Big) sum() int { return x.a + x.b + x.c + x.d }

func mkBig() Big { return Big{a: 1, b: 2, c: 3, d: 4} }

func main() {
	var mv *func() int = mkBig().sum
	println(mv())
}
