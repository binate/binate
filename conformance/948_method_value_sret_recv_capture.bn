package "main"

// KNOWN GAP (xfail): a method value with a POINTER receiver on an SRET-returned
// (by-address: large or managed) value receiver from a call/temp still crashes.
// The by-value materialize fix (947) is gated to register-returned structs
// (types.NeedsSret): an sret struct call-result comes back as a POINTER, so
// storing it into the by-value closure field would need a struct COPY, not a
// scalar store (`store %S %ptr` is invalid IR).  genMethodValue leaves it the old
// behavior (a *T to a dangling sret temp -> SIGSEGV).  Fix: sret-aware
// struct-copy of the receiver into the closure field.  Tracked in claude-todo.md.

type Big struct { a int; b int; c int; d int }

func (x *Big) sum() int { return x.a + x.b + x.c + x.d }

func mkBig() Big { return Big{a: 1, b: 2, c: 3, d: 4} }

func main() {
	var mv *func() int = mkBig().sum
	println(mv())
}
