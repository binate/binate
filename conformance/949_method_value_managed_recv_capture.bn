package "main"

// KNOWN GAP (xfail): the by-value materialize fix (947) is gated to a
// register-returned NON-managed struct.  A register-sized struct WITH a managed
// field (`MP{ n int; p @int }`, 16 bytes → NeedsSret false, but NeedsDestruction
// true) on a pointer-receiver method value from a call/temp is gated OUT — its
// by-value copy would need the managed field RefInc'd (and RefDec'd at the
// closure dtor), which the plain scalar-store capture doesn't do — so it stays
// the old behavior (a *MP to a dangling temp; reading `m.n` -> SIGSEGV).  Sibling
// of 948 (the sret branch).  Fix: an sret-/refcount-aware struct-copy into the
// closure field.  Tracked in claude-todo.md.

type MP struct { n int; p @int }

func (m *MP) num() int { return m.n }

func mkMP() MP { return MP{n: 7, p: box(0)} }

func main() {
	var mv *func() int = mkMP().num
	println(mv())
}
