package "main"
import "pkg/builtins/testing"

// A register-sized struct WITH a managed field (`MP{ n int; p @int }`, 16 bytes →
// NeedsSret false but NeedsDestruction true) taken as a pointer-receiver method
// value from a call/temp (`mkMP().num`).  genMethodValue captures it BY VALUE into
// the closure field: EmitStore copies the bytes, then emitStructCopy RefInc's the
// managed field `p` so the closure owns its own reference (the mkMP() temp's own
// end-of-statement RefDec balances it, and the closure dtor RefDec's `p` at frame
// end).  Sibling of 948 (the sret branch) — the managed-field arm of the by-value
// capture; pins that reading `m.n` through the wrapper works (no dangling `*MP`).

type MP struct { n int; p @int }

func (m *MP) num() int { return m.n }

func mkMP() MP { return MP{n: 7, p: box(0)} }

func main() {
	var mv *func() int = mkMP().num
	testing.Println(mv())
}
