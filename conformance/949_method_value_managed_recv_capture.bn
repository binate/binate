package "main"
import "pkg/builtins/testing"

// A register-sized struct WITH a managed field (`MP{ n int; p @int }`, 16 bytes ->
// NeedsSret false but NeedsDestruction true) taken as a value-receiver method value
// from a call result (`mkMP().num`) is captured by value into the closure field:
// EmitStore copies the bytes, then emitStructCopy RefIncs the managed field `p` so
// the closure owns its own reference (the mkMP() temp's own end-of-statement
// RefDec balances it, and the closure dtor RefDecs `p` at frame end).  Sibling of
// 948 (the sret branch); pins that reading `m.n` through the wrapper works.

type MP struct { n int; p @int }

func (m MP) num() int { return m.n }

func mkMP() MP { return MP{n: 7, p: box(0)} }

func main() {
	var mv *func() int = mkMP().num
	testing.Println(mv())
}
