package "main"

// A method VALUE whose method returns MULTIPLE values (`c.split` where split
// returns (int, int)), called through the value.  Works on LLVM + VM; CRASHES on
// native aarch64 — a PRE-EXISTING method-value-wrapper multi-return bug in the
// native backend's closure shim (independent of the receiver-capture work: it
// reproduces via the old ident-receiver path too).  synthMethodValueWrapper's
// multi-return result-shape / MultiReturnType setup diverges from what genFuncLit
// produces, so the native closure-shim mishandles the packed return.  Tracked in
// claude-todo.md; xfailed on native only.

type Box struct { v int }

func (b *Box) split() (int, int) { return b.v, b.v + 1 }

func main() {
	var c Box = Box{v: 5}
	var mv *func() (int, int) = c.split
	var a int
	var d int
	a, d = mv()
	println(a)
	println(d)
}
