package "main"
import "pkg/builtins/testing"

// A method VALUE whose method returns MULTIPLE values (`c.split` where split
// returns (int, int)), called through the value.  Regression pin for the native
// backends: synthMethodValueWrapper must forward a multi-return call by
// EXTRACTING each result field and re-returning the N values (EmitReturnTyped),
// the same shape genReturnStmt's `return f(...)` produces — NOT by returning the
// packed tuple as one aggregate value.  A single packed arg routes the native
// OP_RETURN to its single-aggregate handler, which treats the operand as a
// POINTER; but a small multi-return result holds its bytes DIRECTLY in the spill
// slot (common.SpillHoldsAggregatePointer), so that handler dereferenced the
// first tuple word as an address -> SIGSEGV (LLVM/VM were unaffected — there the
// result is a first-class struct SSA value).

type Box struct { v int }

func (b *Box) split() (int, int) { return b.v, b.v + 1 }

func main() {
	var c Box = Box{v: 5}
	var mv *func() (int, int) = c.split
	var a int
	var d int
	a, d = mv()
	testing.Println(a)
	testing.Println(d)
}
