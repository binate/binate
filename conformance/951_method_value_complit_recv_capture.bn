package "main"

// A method VALUE with a POINTER receiver taken on a COMPOSITE-LITERAL value
// receiver (`Pt{x: 3, y: 4}.sumsq`).  A composite literal evaluates to an
// aggregate ALLOCA (its own storage), not a register value, so the by-value
// capture must LOAD the struct off that alloca before storing it into the
// closure field — EmitStore of the alloca POINTER would mistype the field
// (`store %S %ptr`) / write the pointer bits as struct bytes.  genMethodValue
// routes it through isAggregateAllocToLoad (mirroring gen_call's by-value struct
// arg).  Sibling of 947 (call-result / field value receivers, which arrive as
// register values).

type Pt struct { x int; y int }

func (p *Pt) sumsq() int { return p.x*p.x + p.y*p.y }

func main() {
	var mv *func() int = Pt{x: 3, y: 4}.sumsq
	println(mv())
}
