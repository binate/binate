package "main"
import "pkg/builtins/testing"

// The sret x managed cross-product of 948 and 949: a pointer-receiver method
// value taken on a value receiver that is BOTH sret (> 16-byte, by-address) AND
// has a managed field (`BigM` is 32 bytes -> NeedsSret, and holds `p @int` ->
// NeedsDestruction).  Captured by value into the closure: the aggregate store
// copies the sret call result's bytes into the field and emitStructCopy RefIncs
// the managed field `p` (balanced by the mkBigM() temp's end-of-statement RefDec
// and the closure dtor's RefDec at frame end), while the synthesized wrapper
// receives the > 16-byte receiver as a byval param (so its param prologue memcpys
// from the byval pointer rather than mistyping a value store).  Reads through `p`
// to confirm the managed field is live (not freed early).

type BigM struct { a int; b int; p @int; d int }

func (x *BigM) get() int { return x.a + x.b + *x.p + x.d }

func mkBigM() BigM { return BigM{a: 1, b: 2, p: box(3), d: 4} }

func main() {
	var mv *func() int = mkBigM().get
	testing.Println(mv())
}
