package "main"
import "pkg/builtins/testing"

// A direct-use (unstored) sub-word integer expression must hold its type's
// canonical register form — sign-extended for a signed type, zero-extended for
// an unsigned one — the SAME form a load produces (a signed sub-word load
// sign-extends).  Two producers that yield the same int32 value must therefore
// compare equal, and a negative signed value must order below 0.
//
// VM bug (this test's target): a runtime `cast` narrows via BC_TRUNC32, which
// zero-fills the upper bits (non-canonical for a signed type), while a
// `bit_cast` and a literal sign-extend — so `bit_cast(int32,u) == cast(int32,y)`
// read NE though both are int32 -1, and `cast(int32,y) < 0` reads false.
// LLVM/native are correct.  All operands here are runtime `var`s so the casts
// are not const-folded (which would hide the register-form divergence).
func main() {
	var u uint32 = 4294967295
	var y int = -1

	if bit_cast(int32, u) == cast(int32, y) {
		testing.Println("eq")
	} else {
		testing.Println("ne")
	}

	if cast(int32, y) < 0 {
		testing.Println("neg")
	} else {
		testing.Println("pos")
	}

	// Two different narrowing producers of the same uint16 value must also
	// agree (unsigned canonical form is zero-extended).
	var w int = 65535
	if cast(uint16, w) == cast(uint16, u) {
		testing.Println("u16eq")
	} else {
		testing.Println("u16ne")
	}

	// int16 signed narrow: a negative value must order below 0 (BC_TRUNC-style
	// zero-fill would read it as a large positive).
	if cast(int16, y) < 0 {
		testing.Println("i16neg")
	} else {
		testing.Println("i16pos")
	}

	// Same-width signedness reinterpret (int32 -1 → uint32): the canonical
	// uint32 form is zero-extended, so it equals the unsigned maximum.
	if cast(uint32, y) == u {
		testing.Println("u32eq")
	} else {
		testing.Println("u32ne")
	}
}
