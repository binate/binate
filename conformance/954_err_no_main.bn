package "main"

// A `main` package with no `func main` has no program entry point.  This is
// caught at PROGRAM ASSEMBLY (link/program-emit), not per-package at compile
// time — any package compiles independently, so only the assembled program
// knows whether an entry exists (§17.3.1).  Both the compiler (cmd/bnc) and the
// bytecode VM driver (cmd/bni) reject it with the same message.
func notMain() {
}
