package "myapp"
import "pkg/builtins/testing"

// A program's entry package must be named "main" (§17.3 `prog.main.package`).
// This file defines `func main` but in package "myapp", so its entry is
// `myapp.main` while the program's `__entry` wrapper calls the literal
// `main.main` — program assembly must reject the mis-named entry package with a
// message naming the real cause (not the less-precise "no main function").
func main() {
	testing.Println("unreachable")
}
