package "main"

import "pkg/refl"
import "pkg/builtins/reflect"

// A bytecode-compiled package's reflect.Package descriptor now populates the
// Globals table: one reflect.GlobalInfo per `.bni`-exported package-level
// global, with Addr back-patched to the global's runtime storage cell.  Read
// refl's own __Package().Globals through the VM.  (The compiled backends emit
// the same table natively; this pins the VM parity.)
func main() {
	var p @reflect.Package = refl.__Package()
	println(len(p.Globals))
	var gi @reflect.GlobalInfo = p.Globals[0]
	println(gi.Name)
	if gi.Addr != nil {
		println("addr-ok")
	} else {
		println("addr-null")
	}
}
