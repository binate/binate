package "main"
import "pkg/builtins/testing"

// Bug 451: two same-final-segment packages (pkg/aa/coll, pkg/bb/coll, both end
// in "coll") each declare a generic interface `C[T]`.  Their instantiations
// `C[int]` are DISTINCT interfaces (identity is by defining package's FULL
// path, not the shared short segment), so aa.Box implements aa.coll.C[int] and
// bb.Box implements bb.coll.C[int] without the two colliding — dispatch lands on
// each package's own impl.  Before the full-path keying, the instantiated iface
// identity used the short name and the two collided (an impl of one wrongly
// matched the other).  Also exercises CUSTOM import aliases, which only resolve
// to a generic interface once the head's alias is mapped to its package path.

import acoll "pkg/aa/coll"
import bcoll "pkg/bb/coll"

func main() {
	var ba acoll.Box = acoll.Make(1)
	var bb bcoll.Box = bcoll.Make(2)
	var ca *acoll.C[int] = &ba
	var cb *bcoll.C[int] = &bb
	testing.Println(ca.val())    // 1
	testing.Println(cb.val())    // 2
}
