package "main"
import "pkg/builtins/testing"

// A generic interface VALUE crossing a package boundary — `@gen.Holder[int]`
// declared in pkg/gen and used in main.  The imported `.bni`'s bare
// instantiated head (`@Holder[int]` in `func Make() @Holder[int]`, written in
// gen's own file) must resolve against the enclosing import, not the
// CONSUMER's package — otherwise the generic-iface-decl lookup misses and
// `@Holder[int]` lowers to a 1-word managed pointer rather than the 2-word
// interface value, crashing at dispatch.  isInterfaceTypeExpr /
// ifaceTypeForName consult CurrentImportPkg for a bare instantiated head (as
// the generic-struct resolver does).
//
// Exercises both the raw (`*I`) and managed (`@I` via a factory) forms and a
// two-method interface.

import "pkg/gen"

func main() {
	var bx gen.Box = gen.MakeRaw(4)
	var r *gen.Holder[int] = &bx
	testing.Println(r.get())              // 4
	testing.Println(r.twice())            // 8

	var h @gen.Holder[int] = gen.MakeMgd(5)
	testing.Println(h.get())              // 5
	testing.Println(h.twice())            // 10
}
