package "main"

// A generic interface VALUE crossing a package boundary — `@gen.Holder[int]`
// declared in pkg/gen and used in main.  Slice 6c-full handled the
// single-package case; the imported-package case degraded because IR-gen
// resolved the imported `.bni`'s bare instantiated head (`@Holder[int]` in
// `func Make() @Holder[int]`, written in gen's own file) against the CONSUMER's
// package instead of the enclosing import alias, so the generic-iface-decl
// lookup missed and `@Holder[int]` lowered to a 1-word managed pointer rather
// than the 2-word interface value — then extractvalue-crashed at dispatch.
// isInterfaceTypeExpr / ifaceTypeForName now consult CurrentImportAlias for a
// bare instantiated head (as the generic-struct resolver already does).
//
// Exercises both the raw (`*I`) and managed (`@I` via a factory) forms and a
// two-method interface.

import "pkg/gen"

func main() {
	var bx gen.Box = gen.MakeRaw(4)
	var r *gen.Holder[int] = &bx
	println(r.get())              // 4
	println(r.twice())            // 8

	var h @gen.Holder[int] = gen.MakeMgd(5)
	println(h.get())              // 5
	println(h.twice())            // 10
}
