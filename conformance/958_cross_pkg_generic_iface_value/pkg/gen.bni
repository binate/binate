package "pkg/gen"

interface Holder[T any] {
	get() T
	twice() T
}

type Box struct { v int }
type Cup struct { v int }

impl Box : Holder[int]
impl @Cup : Holder[int]

func (b Box) get() int
func (b Box) twice() int
func (c @Cup) get() int
func (c @Cup) twice() int

func MakeRaw(x int) Box
func MakeMgd(x int) @Holder[int]
