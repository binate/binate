package "pkg/gen"

func (b Box) get() int { return b.v }
func (b Box) twice() int { return b.v * 2 }
func (c @Cup) get() int { return c.v }
func (c @Cup) twice() int { return c.v * 2 }

func MakeRaw(x int) Box { return Box{v: x} }
func MakeMgd(x int) @Holder[int] {
	var c @Cup = make(Cup)
	c.v = x
	return c
}
