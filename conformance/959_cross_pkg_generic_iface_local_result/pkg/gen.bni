package "pkg/gen"

// A generic interface whose method returns a package-LOCAL named type (Thing),
// alongside a type-param result.  When Holder[int] is instantiated by a
// CONSUMER, the generic's method signatures must resolve `Thing` against the
// generic's DEFINING package (pkg/gen.Thing), not the consumer's — otherwise
// `boxed()`'s result degrades to int and the aggregate return is silently
// miscompiled (t.b reads 0).  Regression for ensureInstantiatedInterface's
// substitution-context package.

type Thing struct { a int; b int }

interface Holder[T any] {
	get() T
	boxed() Thing
}

type Cup struct { v int }
impl @Cup : Holder[int]

func (c @Cup) get() int
func (c @Cup) boxed() Thing
func MakeMgd(x int) @Holder[int]
