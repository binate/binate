package "main"
import "pkg/builtins/testing"

// A method value whose method takes a large (sret / byval, > 16-byte) struct as a
// USER argument, passed through the value: `f(mkBig())` where f = c.addbig and
// addbig takes `v Big` by value.  The synthesized wrapper's param prologue applies
// the byval-param handling to EVERY param, not just the receiver — so a > 16-byte
// argument arrives as a `ptr byval(Big)` and its slot store memcpys from that
// pointer rather than mistyping a value store.  Companion to 948 (the same byval
// fix on the receiver param); this pins the argument position.

type Big struct { a int; b int; c int; d int }

type Ctr struct { base int }

func (c *Ctr) addbig(v Big) int { return c.base + v.a + v.b + v.c + v.d }

func mkBig() Big { return Big{a: 1, b: 2, c: 3, d: 4} }

func main() {
	var c Ctr = Ctr{base: 100}
	var f *func(Big) int = c.addbig
	testing.Println(f(mkBig()))
}
