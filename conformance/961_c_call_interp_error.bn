package "main"
import "pkg/builtins/testing"

// A bytecode program cannot use __c_call: the VM does no FFI (a permanent
// non-goal).  Compiled, this calls libc's `abs` and prints 42; interpreted, the
// type-checker rejects the __c_call at the frontend (Checker.Interpreted), like
// a syntax error, before any lowering.  So this NEGATIVE test asserts that
// type-check error in the VM modes, and is xfail'd in the compiled/native modes
// (where it prints 42).  Positive coverage — __c_call works when compiled — is 498.

func cabs(x int32) int32 {
	return __c_call("abs", int32, x)
}

func main() {
	testing.Println(cast(int, cabs(cast(int32, -42))))
}
