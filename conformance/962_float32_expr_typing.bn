package "main"

// float32 arithmetic must stay float32 end-to-end.  An untyped float constant
// coerces to a float32 operand (so `a * 1000.0` is a float32 multiply, not a
// double one), and a chain that mixes such products with a bare float32 addend
// (`… + d`) stays a float32 ADD.  The subtlety is that IR-gen derives a binop's
// result type by widening its operand types: that widener must resolve any
// float pair to the float type — if it falls through to an integer default, a
// `float + float` add is lowered as an INTEGER add (the float addend converted
// via fptosi), silently producing garbage (native) or malformed IR the LLVM
// backend's clang step rejects.  These cases pin the float result across the
// mul-then-bare-add chain, struct-field operands, and mixed +/-/* ops.

type F4 struct { p float32; q float32; r float32; s float32 }
type Temp float32

func chain(a float32, b float32, c float32, d float32) float32 {
	return a * 1000.0 + b * 100.0 + c * 10.0 + d
}

func fields(v F4) float32 {
	return v.p * 1000.0 + v.q * 100.0 + v.r * 10.0 + v.s
}

func main() {
	println(cast(int, chain(1.0, 2.0, 3.0, 4.0)))   // 1234

	var c F4
	c.p = 1.0
	c.q = 2.0
	c.r = 3.0
	c.s = 4.0
	println(cast(int, fields(c)))                    // 1234

	// mixed +/-/* on float32 locals, ending on a bare-float32 addend.
	var x float32 = 10.0
	var y float32 = 3.0
	println(cast(int, x * 5.0 - y * 2.0 + x))        // 10*5 - 3*2 + 10 = 54

	// A NAMED float32 (`type Temp float32`) with an untyped-float peer must also
	// stay float32, not promote to double: 1/3 rounded to float32, times 3,
	// equals 1.0 exactly in float32 but NOT in double.  Prints 1 iff the named
	// op stayed float32 (the widener must peel the named type, not just match
	// bare TYP_FLOAT).
	var t Temp = 1.0
	var q Temp = t / 3.0
	if q * 3.0 == 1.0 { println(1) } else { println(0) }  // 1
}
