package "main"
import "pkg/builtins/testing"

// A Homogeneous Floating-point Aggregate (struct folding to 1-4 same-type
// float members) is passed in SIMD argument registers under AAPCS64 (and by
// eightbyte-SSE classification under x64 SysV).  This exercises HFA passing
// across 2/3/4-member float64 aggregates plus a mixed GP+scalar-float+HFA
// call, so the native backend's HFA classifier/emitter stays in lockstep with
// the LLVM backend and the VM (all three must agree on the computed result).
// Uses only float64 arithmetic (the float32 multi-term expression path has a
// separate, tracked IR-gen defect — see 962).

type D2 struct { x float64; y float64 }
type D3 struct { a float64; b float64; c float64 }
type D4 struct { p float64; q float64; r float64; s float64 }

func hfa2(v D2) float64 { return v.x * 10.0 + v.y }
func hfa3(v D3) float64 { return v.a * 100.0 + v.b * 10.0 + v.c }
func hfa4(v D4) float64 { return v.p * 1000.0 + v.q * 100.0 + v.r * 10.0 + v.s }

// A leading GP arg and a scalar-float arg before the HFA: NGRN and NSRN are
// counted separately, so `n` must take a GP reg while `f` and the HFA members
// ride the FP file (f in v0, the HFA in v1..v2).
func mixed(n int, f float64, v D2) float64 {
	return cast(float64, n) * 1000.0 + f * 100.0 + v.x * 10.0 + v.y
}

func main() {
	var a D2
	a.x = 3.0
	a.y = 7.0
	testing.Println(cast(int, hfa2(a)))          // 37

	var b D3
	b.a = 1.0
	b.b = 2.0
	b.c = 3.0
	testing.Println(cast(int, hfa3(b)))          // 123

	var d D4
	d.p = 1.0
	d.q = 2.0
	d.r = 3.0
	d.s = 4.0
	testing.Println(cast(int, hfa4(d)))          // 1234

	testing.Println(cast(int, mixed(5, 8.0, a))) // 5837
}
