package "main"
import "pkg/builtins/testing"

// A float32 Homogeneous Floating-point Aggregate rides the SIMD arg registers
// as float32 (Sn) members — the hfaW=4 member-width path, distinct from the
// float64 (hfaW=8) path exercised by 963.  Return individual fields rather than
// a multi-term arithmetic expression, so this stays clear of the separate
// float32 expression-typing defect (962) and isolates HFA passing/placement:
// each member must land in and be read from the right SIMD register / data-
// region slot.  All backends (native/LLVM/VM) must agree.

type F2 struct { a float32; b float32 }
type F3 struct { x float32; y float32; z float32 }
type F4 struct { p float32; q float32; r float32; s float32 }

func f2b(v F2) float32 { return v.b }
func f3z(v F3) float32 { return v.z }
func f4p(v F4) float32 { return v.p }
func f4s(v F4) float32 { return v.s }

func main() {
	var d F2
	d.a = 5.0
	d.b = 6.0
	testing.Println(cast(int, f2b(d)))   // 6

	var e F3
	e.x = 7.0
	e.y = 8.0
	e.z = 9.0
	testing.Println(cast(int, f3z(e)))   // 9

	var c F4
	c.p = 11.0
	c.q = 22.0
	c.r = 33.0
	c.s = 44.0
	testing.Println(cast(int, f4p(c)))   // 11
	testing.Println(cast(int, f4s(c)))   // 44 (4th float32 member — v3)
}
