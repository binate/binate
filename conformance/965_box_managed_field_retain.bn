package "main"
import "pkg/builtins/testing"

// Regression: box() of a struct with a managed field must RefInc that field so
// the boxed copy owns its own reference.  Without the retain, the source
// local/temp's scope-exit RefDec frees the shared backing while the box still
// points at it (a use-after-free), so reads after allocation churn return
// garbage or crash.

type Cell struct {
	s @[]char
}

// makeStr builds a fresh managed char slice: byte c repeated n times.
func makeStr(c uint8, n int) @[]char {
	var s @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		s[i] = cast(char, c)
	}
	return s
}

// churn reallocates garbage so any prematurely-freed backing gets reused --
// turning a latent use-after-free into an observable one.
func churn() {
	var junk @[]char = make_slice(char, 1)
	for i := 0; i < 200; i++ {
		junk = makeStr(cast(uint8, 90), 7)
	}
}

func main() {
	// Single box of a local struct, read back after churn.
	var t Cell
	t.s = makeStr(cast(uint8, 65), 5)
	var bc @Cell = box(t)
	churn()
	testing.Println(bc.s)

	// Many boxes held in a slice, each keeping its own retained field.
	var cells @[]@Cell = make_slice(@Cell, 3)
	for i := 0; i < 3; i++ {
		var c Cell
		c.s = makeStr(cast(uint8, 88 + i), 4)
		cells[i] = box(c)
	}
	churn()
	for i := 0; i < 3; i++ {
		testing.Println(cells[i].s)
	}
}
