package "main"

// A struct of size <= 4 bytes (a single int32 field) is returned BY VALUE in a
// register, NOT via sret: on ILP32 the AAPCS32 sret threshold is 4, so this
// small struct comes back in R0.  Every backend that implements in-register
// aggregate returns — host, x64/aarch64 native, the LLVM arm32 path, and the
// native arm32 backend (P4-b: emitReturn's one-word R0 pack + emitCallReturn's
// R0-into-data-region collect) — prints 42.
type Small struct {
	x int32
}

func makeSmall(v int32) Small {
	return Small{x: v}
}

func main() {
	var s Small = makeSmall(cast(int32, 42))
	println(cast(int, s.x))
}
