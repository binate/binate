package "main"

// A struct of size <= 4 bytes (a single int32 field) is returned BY VALUE in a
// register, NOT via sret: on ILP32 the AAPCS32 sret threshold is 4, so this
// small struct comes back in R0.  Every backend that implements in-register
// aggregate returns (host, x64/aarch64 native, and the LLVM arm32 path) prints
// 42; the native arm32 backend doesn't yet implement that in-register
// return/collection (single-aggregate sret / P3.3 covers only > 4-byte returns),
// so it fails LOUDLY there — tracked as an xfail for that mode and in
// explorations/claude-todo.md (P4).
type Small struct {
	x int32
}

func makeSmall(v int32) Small {
	return Small{x: v}
}

func main() {
	var s Small = makeSmall(cast(int32, 42))
	println(cast(int, s.x))
}
