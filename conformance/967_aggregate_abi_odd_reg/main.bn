package "main"

import "pkg/oo"

// The native main calls oo.Odd / oo.OddB5, which are LLVM-compiled deps.
// A leading i32 scalar takes r0, so the by-value struct arg starts on the
// ODD register r1.  The native caller packs the 4-aligned struct at r1:r2
// (matching clang's `[2 x i32]`); the LLVM callee must read the same
// registers.  With the fixed target-aware coercion (`[N x i32]` on
// ILP32), it does; with the old hardcoded `[N x i64]` (8-aligned), LLVM
// even-bumps the aggregate to r2:r3 and reads garbage.

func main() {
	// P2{a:7, b:9}, scalar 3 -> 3*100000 + 7*1000 + 9 = 307009
	var s oo.P2 = oo.MkP2(cast(int32, 7), cast(int32, 9))
	println(oo.Odd(cast(int32, 3), s))                    // 307009

	// P2{a:11, b:22}, scalar 5 -> 5*100000 + 11*1000 + 22 = 511022
	var t oo.P2 = oo.MkP2(cast(int32, 11), cast(int32, 22))
	println(oo.Odd(cast(int32, 5), t))                    // 511022

	// B5 bytes {40,41,42,43,44}, scalar 6 -> 6*100000 + 40*1000 + 44 = 640044
	var b oo.B5 = oo.MkB5(cast(int32, 40), cast(int32, 41),
		cast(int32, 42), cast(int32, 43), cast(int32, 44))
	println(oo.OddB5(cast(int32, 6), b))                  // 640044
}
