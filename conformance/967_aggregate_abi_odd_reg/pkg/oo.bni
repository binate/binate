package "pkg/oo"

// P2 {i32,i32}: 8 bytes, align 4.  Naturally 4-aligned — after a leading
// i32/char scalar (r0), it starts on the ODD register r1 under AAPCS32.
// clang coerces it to `[2 x i32]` (4-aligned, r1:r2); a hardcoded `[1 x
// i64]` coercion is 8-aligned and LLVM even-bumps it to r2:r3, so a native
// caller (which packs 4-aligned words at r1:r2) and the LLVM callee
// disagree by one register — silent argument corruption.
type P2 struct {
	a int32
	b int32
}

// B5 {[5]uint8}: 5 bytes, align 1 — the other naturally-<8-aligned shape
// clang coerces to `[2 x i32]`.  Same odd-register divergence after a
// leading scalar.
type B5 struct {
	b [5]uint8
}

func MkP2(x int32, y int32) P2
func MkB5(p int32, q int32, r int32, s int32, t int32) B5

// Odd starts a scalar in r0, so the struct arg lands on the ODD register
// r1.  Reads BOTH struct fields, so a wrong-register read (r2:r3 instead
// of r1:r2) corrupts the result.  int32 return (see oo.bn on why not int64).
func Odd(scalar int32, s P2) int32

// OddB5 is the [5]uint8 variant: scalar in r0, B5 starts on r1.  Reads the
// first and last bytes so an off-by-one-register read is observable.
func OddB5(scalar int32, s B5) int32
