package "pkg/oo"

func MkP2(x int32, y int32) P2 {
	return P2{a: x, b: y}
}

func MkB5(p int32, q int32, r int32, s int32, t int32) B5 {
	var v B5
	v.b[0] = cast(uint8, p)
	v.b[1] = cast(uint8, q)
	v.b[2] = cast(uint8, r)
	v.b[3] = cast(uint8, s)
	v.b[4] = cast(uint8, t)
	return v
}

// Odd is LLVM-compiled (a dependency package): `scalar` occupies r0, so
// the by-value struct `s` starts on the odd register r1.  It MUST see s.a
// in r1 and s.b in r2 (clang's `[2 x i32]` coercion), matching the native
// caller in main.  The int32 return mixes the scalar and BOTH fields at
// distinct magnitudes (100000 / 1000 / 1), so any register-off-by-one
// corruption changes the result.  (int32-only: a cross-package int64
// return independently wedges native-arm32, an unrelated defect — see the
// todo — so the observability stays within int32.)
func Odd(scalar int32, s P2) int32 {
	return scalar * cast(int32, 100000) + s.a * cast(int32, 1000) + s.b
}

// OddB5 is the [5]uint8 variant.  scalar in r0, B5 on r1:r2.  Reads the
// first and last bytes so an off-by-one-register read is observable.
func OddB5(scalar int32, s B5) int32 {
	var first int32 = cast(int32, s.b[0])
	var last int32 = cast(int32, s.b[4])
	return scalar * cast(int32, 100000) + first * cast(int32, 1000) + last
}
