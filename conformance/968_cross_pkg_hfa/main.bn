package "main"

import "pkg/hfaops"

// See pkg/hfaops.bni.  Args cross native-main -> LLVM-dep; results cross
// LLVM-dep -> native-main.  Values chosen so each print is a distinct integer.

func main() {
	// HFA ARGS (native main marshals into v0..v3, LLVM callee reads).
	var a hfaops.D2
	a.x = 3.0
	a.y = 7.0
	println(cast(int, hfaops.Sum2(a)))                    // 10  (16B)

	var b hfaops.D3
	b.a = 1.0
	b.b = 2.0
	b.c = 3.0
	println(cast(int, hfaops.Sum3(b)))                    // 6   (24B)

	var d hfaops.D4
	d.p = 1000.0
	d.q = 200.0
	d.r = 30.0
	d.s = 4.0
	println(cast(int, hfaops.Sum4(d)))                    // 1234 (32B)

	// HFA RESULTS (LLVM callee returns in v0..v3, native main collects).
	var m hfaops.D2 = hfaops.Mk2(12.0, 34.0)
	println(cast(int, m.x + m.y))                         // 46  (16B)

	var n hfaops.D3 = hfaops.Mk3(1.0, 20.0, 300.0)
	println(cast(int, n.a + n.b + n.c))                   // 321 (24B)

	var q hfaops.D4 = hfaops.Mk4(1.0, 20.0, 300.0, 4000.0)
	println(cast(int, q.p + q.q + q.r + q.s))             // 4321 (32B)
}
