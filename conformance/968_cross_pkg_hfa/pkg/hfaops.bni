package "pkg/hfaops"

// Homogeneous Floating-point Aggregates crossing a PACKAGE boundary.  Under
// `-backend native` only main is native; this package is LLVM-compiled, so
// every call here exercises the native<->LLVM ABI boundary for HFA passing —
// the coverage the single-package 963/964 cannot provide (they are
// self-consistent by construction).  Covers 2/3/4-member float64 HFAs
// (16/24/32 bytes) as both ARGS (native main marshals -> LLVM callee reads) and
// RESULTS (LLVM callee returns -> native main collects).

type D2 struct { x float64; y float64 }
type D3 struct { a float64; b float64; c float64 }
type D4 struct { p float64; q float64; r float64; s float64 }

func Sum2(v D2) float64
func Sum3(v D3) float64
func Sum4(v D4) float64
func Mk2(a float64, b float64) D2
func Mk3(a float64, b float64, c float64) D3
func Mk4(a float64, b float64, c float64, d float64) D4
