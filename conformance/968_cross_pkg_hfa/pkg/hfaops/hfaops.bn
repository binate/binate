package "pkg/hfaops"

func Sum2(v D2) float64 { return v.x + v.y }
func Sum3(v D3) float64 { return v.a + v.b + v.c }
func Sum4(v D4) float64 { return v.p + v.q + v.r + v.s }
func Mk2(a float64, b float64) D2 { var r D2; r.x = a; r.y = b; return r }
func Mk3(a float64, b float64, c float64) D3 { var r D3; r.a = a; r.b = b; r.c = c; return r }
func Mk4(a float64, b float64, c float64, d float64) D4 {
	var r D4
	r.p = a
	r.q = b
	r.r = c
	r.s = d
	return r
}
