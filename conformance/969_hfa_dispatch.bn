package "main"
import "pkg/builtins/testing"

// HFAs passed/returned through the three DISPATCH kinds — func-value, closure,
// and interface method — each of which routes through a per-function shim (or,
// under the VM, the cross-mode _call_shim path).  963/964 cover only direct
// calls; this covers the shim marshalling.  Uses float64 arithmetic (the
// float32 multi-term expression path is a separate concern — see 962/964).

type D2 struct { x float64; y float64 }
type D3 struct { a float64; b float64; c float64 }

func sum2(v D2) float64 { return v.x + v.y }
func mk3(a float64, b float64, c float64) D3 {
	var r D3
	r.a = a
	r.b = b
	r.c = c
	return r
}

// A capturing closure with an HFA param, and one returning an HFA.
func makeAdder(base float64) @func(D2) float64 {
	return func(v D2) float64 { return v.x + v.y + base }
}
func makeMk3(scale float64) @func(float64) D3 {
	return func(z float64) D3 {
		var r D3
		r.a = z
		r.b = z * 2.0
		r.c = scale
		return r
	}
}

// An interface method taking and returning an HFA.
interface Shape {
	blend(v D2) float64
	build(z float64) D3
}
type Impl struct { base float64 }
func (s *Impl) blend(v D2) float64 { return v.x + v.y + s.base }
func (s *Impl) build(z float64) D3 {
	var r D3
	r.a = z
	r.b = z * 2.0
	r.c = s.base
	return r
}
impl *Impl : Shape

func main() {
	// Func value: HFA arg and HFA (24B) return.
	var f *func(D2) float64 = sum2
	var a D2
	a.x = 4.0
	a.y = 6.0
	testing.Println(cast(int, f(a)))                               // 10
	var g *func(float64, float64, float64) D3 = mk3
	var t1 D3 = g(1.0, 20.0, 300.0)
	testing.Println(cast(int, t1.a + t1.b + t1.c))                 // 321

	// Closure (capturing): HFA arg and HFA return.
	var adder @func(D2) float64 = makeAdder(100.0)
	testing.Println(cast(int, adder(a)))                           // 110
	var maker @func(float64) D3 = makeMk3(1000.0)
	var t2 D3 = maker(3.0)
	testing.Println(cast(int, t2.a + t2.b + t2.c))                 // 1009

	// Interface method: HFA arg and HFA return.
	var im Impl = Impl{base: 100.0}
	var iv *Shape = &im
	testing.Println(cast(int, iv.blend(a)))                        // 110
	var t3 D3 = iv.build(3.0)
	testing.Println(cast(int, t3.a + t3.b + t3.c))                 // 109
}
