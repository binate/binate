package "main"
import "pkg/builtins/testing"

// HFAs through the func-value STACK-SPILL shim — the over-budget path taken
// when a func-value's args exceed the register budget or overflow the FP file.
// 969 covers the register-path dispatch; this covers the spill path (arg
// FP-file overflow -> stack, a GP-wide call with an HFA arg, and an HFA return
// from a wide call).  All exercise emitFuncvalSpillShimAA64 on native aa64.

type F4 struct { a float32; b float32; c float32; d float32 }
type D2 struct { u float64; v float64 }
type D3 struct { p float64; q float64; r float64 }

// 3x 4-member f32 HFA = 12 FP registers > 8: the 3rd HFA overflows to the stack.
func sum3f4(x F4, y F4, z F4) float32 { return x.a + y.a + z.a }

// 7 ints + a 16-byte HFA: GP-wide (8 dispatch words), HFA arg still in the FP file.
func wide(a int, b int, c int, d int, e int, f int, g int, w D2) float64 {
	return cast(float64, a + b + c + d + e + f + g) + w.u + w.v
}

// 7 ints returning a 24-byte HFA: wide args + an HFA return through the spill shim.
func wideRet(a int, b int, c int, d int, e int, f int, g int) D3 {
	var r D3
	r.p = cast(float64, a + b)
	r.q = cast(float64, c + d)
	r.r = cast(float64, e + f + g)
	return r
}

func main() {
	var fn1 *func(F4, F4, F4) float32 = sum3f4
	var x F4
	x.a = 1.0
	var y F4
	y.a = 10.0
	var z F4
	z.a = 100.0
	testing.Println(cast(int, fn1(x, y, z)))                          // 111

	var fn2 *func(int, int, int, int, int, int, int, D2) float64 = wide
	var w D2
	w.u = 1000.0
	w.v = 2000.0
	testing.Println(cast(int, fn2(1, 2, 3, 4, 5, 6, 7, w)))           // 3028

	var fn3 *func(int, int, int, int, int, int, int) D3 = wideRet
	var t D3 = fn3(1, 2, 3, 4, 5, 6, 7)
	testing.Println(cast(int, t.p + t.q + t.r))                       // 28
}
