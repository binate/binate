package "main"

// x64 SysV SSE aggregates crossing the native<->LLVM package boundary — the
// x64 analogue of 968_cross_pkg_hfa.  main is native-compiled; pkg/sseops is a
// dependency (LLVM-compiled in the native modes), so RESULTS cross LLVM-dep ->
// native-main (dep packs the SSE eightbytes, native collects) and ARGS cross
// native-main -> LLVM-dep (native marshals, dep reads).  Dormant/GP-packed on
// x64 until the SysVSseInRegs flip, then the SSE gate.  f64/int fields are read
// as small integers (cast); f32 fields as their exact 32-bit patterns
// (bit_cast) — both target-width independent so one `expected` fits every mode.

import "pkg/sseops"

func main() {
	// RESULTS: LLVM packs -> native main collects.
	var d1 sseops.D1 = sseops.MkD1()
	println(cast(int, d1.x))                       // 3

	var f2 sseops.F2 = sseops.MkF2()
	println(cast(int, bit_cast(uint32, f2.a)))     // 1069547520
	println(cast(int, bit_cast(uint32, f2.b)))     // 1075838976

	var d2 sseops.D2 = sseops.MkD2()
	println(cast(int, d2.x))                       // 5
	println(cast(int, d2.y))                       // 9

	var f4 sseops.F4 = sseops.MkF4()
	println(cast(int, bit_cast(uint32, f4.a)))     // 1069547520
	println(cast(int, bit_cast(uint32, f4.b)))     // 1075838976
	println(cast(int, bit_cast(uint32, f4.c)))     // 1080033280
	println(cast(int, bit_cast(uint32, f4.d)))     // 1083179008

	var fd sseops.FD = sseops.MkFD()
	println(cast(int, bit_cast(uint32, fd.a)))     // 1069547520
	println(cast(int, bit_cast(uint32, fd.b)))     // 1075838976
	println(cast(int, fd.c))                       // 3

	var di sseops.DI = sseops.MkDI()
	println(cast(int, di.x))                       // 6
	println(cast(int, di.n))                       // 42

	var id sseops.ID = sseops.MkID()
	println(cast(int, id.n))                       // 99
	println(cast(int, id.x))                       // 8

	var fi sseops.FI = sseops.MkFI()
	println(cast(int, bit_cast(uint32, fi.a)))     // 1069547520
	println(cast(int, bit_cast(uint32, fi.b)))     // 1075838976
	println(cast(int, fi.n))                       // 77

	var dii sseops.DII = sseops.MkDII()
	println(cast(int, dii.x))                      // 4
	println(cast(int, dii.m))                      // 555
	println(cast(int, dii.n))                      // 666

	// ARGS: native main marshals -> LLVM dep reads.
	var a2 sseops.D2
	a2.x = 5.0
	a2.y = 9.0
	println(cast(int, sseops.SumD2(a2)))           // 14

	var af sseops.F2
	af.a = 1.5
	af.b = 2.5
	println(cast(int, sseops.SumF2(af)))           // 4

	var adi sseops.DI
	adi.x = 6.0
	adi.n = 42
	println(cast(int, sseops.CombineDI(adi)))      // 48
}
