package "pkg/sseops"

// SysV-AMD64 <=16-byte SSE aggregates crossing a PACKAGE boundary — the x64
// analogue of 968_cross_pkg_hfa.  Under `-backend native` only main is native;
// this package is LLVM-compiled, so every call exercises the native<->LLVM SSE
// ABI (each 8-byte eightbyte rides an XMM or a GP register by SysV class).  On
// x64 this is dormant (GP-packed) until the Stage-4 SysVSseInRegs flip, at which
// point it becomes the cross-module SSE gate; on aa64 the pure-float types are
// HFAs (D0..D3) and the mixed types GP-packed; on every other mode it is a
// plain GP-packed aggregate — all self-consistent, same printed values.
//
// Mk* cover RESULTS (LLVM packs the result eightbytes -> native main collects):
// 1x f64, 1x 2xf32, and the 2-eightbyte doubles/floats plus the crucial mixed
// SSE+INTEGER dual-file cases (double+i64, i64+double, 2xf32+i64, double+2xi32)
// where one eightbyte lands in an XMM and the other in a GP register.  Sum*/
// combine cover ARGS in the reverse role (native main marshals -> LLVM reads).

type D1  struct { x float64 }
type F2  struct { a float32; b float32 }
type D2  struct { x float64; y float64 }
type F4  struct { a float32; b float32; c float32; d float32 }
type FD  struct { a float32; b float32; c float64 }
type DI  struct { x float64; n int64 }
type ID  struct { n int64; x float64 }
type FI  struct { a float32; b float32; n int64 }
type DII struct { x float64; m int32; n int32 }

// RESULTS: LLVM packs the SSE aggregate return; native main collects it.
func MkD1() D1
func MkF2() F2
func MkD2() D2
func MkF4() F4
func MkFD() FD
func MkDI() DI
func MkID() ID
func MkFI() FI
func MkDII() DII

// ARGS: native main marshals the SSE aggregate into registers; LLVM reads it.
// Each returns a scalar derived from the fields (arithmetic runs LLVM-side,
// where it is correct) so a mis-marshalled eightbyte yields a wrong number.
func SumD2(v D2) float64
func SumF2(v F2) float32
func CombineDI(v DI) int64
