package "pkg/sseops"

// RESULTS — each Mk* builds its aggregate from fixed constants and returns it
// (LLVM packs the SSE eightbytes; native main collects).  f32 fields use
// positive values so their bit patterns stay below 2^31 (target-width
// independent when read back via bit_cast on both LP64 and ILP32).

func MkD1() D1 {
	var v D1
	v.x = 3.0
	return v
}

func MkF2() F2 {
	var v F2
	v.a = 1.5
	v.b = 2.5
	return v
}

func MkD2() D2 {
	var v D2
	v.x = 5.0
	v.y = 9.0
	return v
}

func MkF4() F4 {
	var v F4
	v.a = 1.5
	v.b = 2.5
	v.c = 3.5
	v.d = 4.5
	return v
}

func MkFD() FD {
	var v FD
	v.a = 1.5
	v.b = 2.5
	v.c = 3.0
	return v
}

func MkDI() DI {
	var v DI
	v.x = 6.0
	v.n = 42
	return v
}

func MkID() ID {
	var v ID
	v.n = 99
	v.x = 8.0
	return v
}

func MkFI() FI {
	var v FI
	v.a = 1.5
	v.b = 2.5
	v.n = 77
	return v
}

func MkDII() DII {
	var v DII
	v.x = 4.0
	v.m = 555
	v.n = 666
	return v
}

// ARGS — the aggregate arrives from native main; arithmetic here runs LLVM-side
// (correct), so a wrong result means main mis-marshalled an eightbyte.

func SumD2(v D2) float64 {
	return v.x + v.y
}

func SumF2(v F2) float32 {
	return v.a + v.b
}

func CombineDI(v DI) int64 {
	return cast(int64, v.x) + v.n
}
