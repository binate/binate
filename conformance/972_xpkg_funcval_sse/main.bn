package "main"

// x64 SSE aggregates returned through a FUNC-VALUE shim across native<->LLVM.
// main is native; myD2/myDI/myF2 are native funcs returning <=16-byte SSE
// aggregates (native packs XMM0/XMM1 + RAX/RDX).  They are passed as plain *func
// values to the LLVM-compiled pkg/fvsse, which calls each via the func-value
// dispatch shim (retbuf convention) and reads a field.  The native shim's collect
// of the underlying's SSE return into the retbuf is the path under test — GP-
// packed/dormant on x64 today, SSE at the SysVSseInRegs flip.  f64/int fields are
// read as small ints, f32 as its exact 32-bit pattern — target-width independent.

import "pkg/fvsse"

func myD2() fvsse.D2 {
	var v fvsse.D2
	v.x = 5.0
	v.y = 9.0
	return v
}

func myDI() fvsse.DI {
	var v fvsse.DI
	v.x = 6.0
	v.n = 42
	return v
}

func myF2() fvsse.F2 {
	var v fvsse.F2
	v.a = 1.5
	v.b = 2.5
	return v
}

func main() {
	println(fvsse.GrabD2(myD2))    // 59  (5*10 + 9)
	println(fvsse.GrabDI(myDI))    // 642 (6*100 + 42)
	println(fvsse.GrabF2(myF2))    // 1069547520 (bits of 1.5f)
}
