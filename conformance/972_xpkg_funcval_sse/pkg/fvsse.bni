package "pkg/fvsse"

// SysV-AMD64 SSE aggregates returned THROUGH A FUNC-VALUE dispatch shim, crossing
// a package boundary.  Under `-backend native` only main is native; this package
// is LLVM-compiled, so main passes a native func (returning an SSE aggregate) as a
// plain *func value to these Grab* helpers, which call it and read a field.  The
// SSE ABI lives between the native shim and the native underlying (the shim
// collects the underlying's XMM0/XMM1 + RAX/RDX return into the retbuf the LLVM
// caller reads); a wrong shim collect yields a wrong number.  Dormant/GP on x64
// until the SysVSseInRegs flip.

type D2 struct { x float64; y float64 }
type DI struct { x float64; n int64 }
type F2 struct { a float32; b float32 }

func GrabD2(f *func() D2) int
func GrabDI(f *func() DI) int
func GrabF2(f *func() F2) int
