package "pkg/fvsse"

// Each Grab* calls the passed native func (whose SSE-aggregate return the native
// shim collects into a retbuf) and derives a value from a field.  Arithmetic /
// field reads run LLVM-side (correct), so a wrong number means the native shim
// mis-collected the underlying's SSE return.

func GrabD2(f *func() D2) int {
	var d D2 = f()
	return cast(int, d.x) * 10 + cast(int, d.y)
}

func GrabDI(f *func() DI) int {
	var d DI = f()
	return cast(int, d.x) * 100 + cast(int, d.n)
}

func GrabF2(f *func() F2) int {
	var d F2 = f()
	return cast(int, bit_cast(uint32, d.a))
}
