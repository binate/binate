package "main"

import "pkg/mr3"

// A cross-module (LLVM-dep) func value returning a SMALL multi-return tuple —
// (int x3), which every target's native call would pack into return registers
// (NOT an sret buffer) — called from a NATIVE main.  Like 972 but a 3-field
// tuple, the largest small (register-packable) multi-return on x64 (budget 3).
// The LLVM-emitted shim uses the retbuf-as-first-arg convention for ANY
// multi-return, so the native consumer must read the result from the retbuf
// spill slot rather than collecting it from return registers.  Must pass on
// host and all three native backends.
func main() {
	var f *func(int, int, int) (int, int, int) = mr3.Get3()
	var r1 int
	var r2 int
	var r3 int
	r1, r2, r3 = f(10, 20, 30)
	println(r1)   // 30  (a + b)
	println(r2)   // 50  (b + c)
	println(r3)   // 40  (a + c)
}
