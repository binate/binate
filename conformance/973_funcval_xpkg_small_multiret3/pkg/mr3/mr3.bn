package "pkg/mr3"

// F3 returns a SMALL multi-return tuple ((int x3)).  It is <= NumGpRetRegs on
// x64 (3), arm32 (4), and aa64 (8), so a native call would pack it into return
// registers rather than an sret buffer.  Its components are distinct functions
// of the args, so a mismarshaled arg or field shows up as a wrong component.
func F3(a int, b int, c int) (int, int, int) {
	return a + b, b + c, a + c
}

// Get3 hands F3 back as a raw func value; the caller reaches F3's LLVM-emitted
// shim through it.
func Get3() *func(int, int, int) (int, int, int) {
	return F3
}
