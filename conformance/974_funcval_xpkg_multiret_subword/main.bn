package "main"

import "pkg/mrsw"

// A cross-module (LLVM-dep) func value returning a SMALL SUB-WORD multi-return
// tuple (uint16 x3), called from a NATIVE main.  Exercises the native shim's
// store-through-retbuf SIZED-store path: each u16 field must land at its own
// tuple offset without clobbering a neighbor.  Must pass on host and all three
// native backends.
func main() {
	var f *func(uint16, uint16, uint16) (uint16, uint16, uint16) = mrsw.Get3()
	var r1 uint16
	var r2 uint16
	var r3 uint16
	r1, r2, r3 = f(10, 20, 30)
	println(cast(int, r1)) // 30  (a + b)
	println(cast(int, r2)) // 50  (b + c)
	println(cast(int, r3)) // 40  (a + c)
}
