package "main"

import "pkg/mrsw"

// A cross-module func value returning a SMALL SUB-WORD multi-return tuple
// (uint16 x3), called through the func-value shim.  Exercises the native shim's
// store-through-retbuf SIZED-store path: each u16 field must land at its own
// tuple offset without clobbering a neighbor.  Must pass on host and all three
// native backends.  (In a single-backend native mode both main and the dep are
// compiled by that one backend, so this exercises that backend's shim/caller/
// sizer AGREEMENT under retbuf-for-any-multi-return; the native<->LLVM boundary
// holds by construction because both sides use the same convention.  Same note
// applies to 975-978.)
func main() {
	var f *func(uint16, uint16, uint16) (uint16, uint16, uint16) = mrsw.Get3()
	var r1 uint16
	var r2 uint16
	var r3 uint16
	r1, r2, r3 = f(10, 20, 30)
	println(cast(int, r1)) // 30  (a + b)
	println(cast(int, r2)) // 50  (b + c)
	println(cast(int, r3)) // 40  (a + c)
}
