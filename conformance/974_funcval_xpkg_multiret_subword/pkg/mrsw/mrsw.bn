package "pkg/mrsw"

// F returns a SMALL SUB-WORD multi-return tuple: (uint16 x3).  On x64 the whole
// 6-byte tuple coalesces into one eightbyte (RAX), but LLVM's first-class-struct
// return still writes each u16 field at its own tuple offset; the native shim's
// store-through-retbuf must use SIZED stores so a u16 field does not clobber its
// 8-byte-cell neighbor.  Distinct functions of the args expose a mismarshaled
// field.
func f(a uint16, b uint16, c uint16) (uint16, uint16, uint16) {
	return a + b, b + c, a + c
}

// Get3 hands f back as a raw func value; the native caller reaches f's LLVM-
// emitted shim through it (retbuf-for-any-multi-return convention).
func Get3() *func(uint16, uint16, uint16) (uint16, uint16, uint16) {
	return f
}
