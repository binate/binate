package "main"

import "pkg/mrf3"

// A cross-module (LLVM-dep) func value returning a SMALL FLOAT-SCALAR multi-
// return tuple (float64 x3), called from a NATIVE main.  Exercises the native
// shim's store-through-retbuf FLOAT-class path: the 3rd float comes back via x87
// ST0 (x64) / D2 (aa64).  On arm32 the LLVM-compiled dep returns the tuple via
// the AAPCS32 soft-float sret path, so main's caller reads it from the retbuf
// like any other multi-return.  Must pass on host and all three native backends.
func main() {
	var f *func(float64, float64, float64) (float64, float64, float64) = mrf3.Get3()
	var r1 float64
	var r2 float64
	var r3 float64
	r1, r2, r3 = f(10.0, 20.0, 30.0)
	println(cast(int, r1)) // 30  (a + b)
	println(cast(int, r2)) // 50  (b + c)
	println(cast(int, r3)) // 40  (a + c)
}
