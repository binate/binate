package "pkg/mrf3"

// F returns a SMALL FLOAT-SCALAR multi-return tuple: (float64 x3).  LLVM returns
// the three float fields in XMM0, XMM1, then x87 ST0 (SysV has 2 XMM return
// regs).  The native shim's store-through-retbuf must read the float fields from
// the FP return regs (XMM0/XMM1 via movq, the 3rd via x87 FSTP on x64; D0/D1/D2
// on aa64), NOT from GP regs the callee never wrote.  Distinct functions of the
// args expose a mismarshaled field / wrong-register read.
func f(a float64, b float64, c float64) (float64, float64, float64) {
	return a + b, b + c, a + c
}

// Get3 hands f back as a raw func value; the native caller reaches f's LLVM-
// emitted shim through it (retbuf-for-any-multi-return convention).
func Get3() *func(float64, float64, float64) (float64, float64, float64) {
	return f
}
