package "main"

import "pkg/mrmx"

// A cross-module (LLVM-dep) func value returning a SMALL MIXED multi-return tuple
// (float32, int32), called from a NATIVE main.  Exercises the native shim's
// independent GP/FP class counters in the store-through-retbuf path: the float
// field from XMM0/D0, the int field from the GP return reg.  (On arm32 the soft-
// float dep returns the tuple in r0..r3, folded into GP.)  Must pass on host and
// all three native backends.
func main() {
	var f *func(float32, int32) (float32, int32) = mrmx.Get()
	var r1 float32
	var r2 int32
	r1, r2 = f(3.0, 7)
	println(cast(int, r1)) // 6   (a * 2.0, the FLOAT field in XMM0/D0)
	println(cast(int, r2)) // 107 (b + 100, the INT field in a GP reg)
}
