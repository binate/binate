package "pkg/mrmx"

// F returns a SMALL MIXED int/float multi-return tuple: (float32, int32).  LLVM
// returns the float field in XMM0 and the int field in RAX — DIFFERENT register
// classes with INDEPENDENT class counters.  The native shim's store-through-
// retbuf must read the float field from XMM0/D0 (via movd, a 32-bit float) and
// the int field from the GP return reg, each at its own tuple offset.  A store
// that read both from GP (or both from FP) would garble one field.
func f(a float32, b int32) (float32, int32) {
	return a * 2.0, b + 100
}

// Get hands f back as a raw func value; the native caller reaches f's LLVM-
// emitted shim through it (retbuf-for-any-multi-return convention).
func Get() *func(float32, int32) (float32, int32) {
	return f
}
