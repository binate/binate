package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"
import "pkg/mrmg"

// A cross-module (LLVM-dep) func value returning a SMALL multi-return tuple with
// a MANAGED field (@Node, int), called from a NATIVE main.  Exercises the native
// shim's plain-pointer-word store for a managed field (ownership transfers from
// the return reg into retbuf; no RefInc/RefDec).  The refcount prints below make
// this a leak/double-free canary: the returned @Node must have refcount 1 after
// assignment (the caller owns it, the shim did not add a ref), and 0 stray refs.
// Must pass on host and all three native backends.
func main() {
	var f *func(int, int) (@mrmg.Node, int) = mrmg.Get()
	var n @mrmg.Node
	var tag int
	n, tag = f(42, 10)
	var ptr *uint8 = bit_cast(*uint8, n)
	testing.Println(n.Val)               // 42
	testing.Println(tag)                 // 10
	testing.Println(rt.Refcount(ptr))    // 1  (caller owns it; the shim added no ref)
}
