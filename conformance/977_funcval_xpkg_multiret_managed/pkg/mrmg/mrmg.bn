package "pkg/mrmg"

// F returns a SMALL multi-return tuple with a MANAGED field: (@Node, int).  The
// callee returns the managed field as an already-owned (+1) raw pointer word in a
// GP return register; the native shim's store-through-retbuf must move it with a
// PLAIN pointer-word store (no RefInc/RefDec) — ownership transfers from the reg
// into the retbuf slot, exactly as the direct-call collect does.  A store that
// RefInc'd would leak; dropping the word would double-free.
func f(val int, tag int) (@Node, int) {
	var n @Node = make(Node)
	n.Val = val
	return n, tag
}

// Get hands f back as a raw func value; the native caller reaches f's LLVM-
// emitted shim through it (retbuf-for-any-multi-return convention).
func Get() *func(int, int) (@Node, int) {
	return f
}
