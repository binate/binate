package "main"

import "pkg/mrgp"

// A cross-module (LLVM-dep) func value returning an (int x8) multi-return tuple,
// called from a NATIVE main.  GP-MAX: on aa64 (8 GP ret regs) this is a SMALL
// field-per-register multi-return at the budget boundary — the native shim's
// store-through-retbuf writes all 8 fields from X0..X7; on x64 / arm32 it is a
// BIG sret tuple.  Must pass on host and all three native backends.
func main() {
	var f *func(int, int) (int, int, int, int, int, int, int, int) = mrgp.Get()
	var r1 int
	var r2 int
	var r3 int
	var r4 int
	var r5 int
	var r6 int
	var r7 int
	var r8 int
	r1, r2, r3, r4, r5, r6, r7, r8 = f(10, 3)
	println(r1) // 10  (a)
	println(r2) // 3   (b)
	println(r3) // 13  (a + b)
	println(r4) // 7   (a - b)
	println(r5) // 30  (a * b)
	println(r6) // 11  (a + 1)
	println(r7) // 4   (b + 1)
	println(r8) // 14  (a + b + 1)
}
