package "pkg/mrgp"

// F returns an (int x8) multi-return tuple — the GP-MAX case: 8 GP words is the
// full AAPCS64 return-register file (X0..X7), so on aa64 it is a SMALL (field-
// per-register) multi-return exercised at the register budget boundary; on x64
// (3 GP ret regs) and arm32 (4) it overflows to an sret buffer — the BIG path.
// Every native backend must agree with the LLVM shim's retbuf-for-any-multi-
// return convention.  Distinct functions of the args expose a mismarshaled field.
func f(a int, b int) (int, int, int, int, int, int, int, int) {
	return a, b, a + b, a - b, a * b, a + 1, b + 1, a + b + 1
}

// Get hands f back as a raw func value; the native caller reaches f's LLVM-
// emitted shim through it (retbuf-for-any-multi-return convention).
func Get() *func(int, int) (int, int, int, int, int, int, int, int) {
	return f
}
