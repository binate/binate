package "main"

import "pkg/mr5"

// A cross-module (LLVM-dep) func value returning a BIG multi-return tuple —
// (int x5), returned via a hidden sret buffer pointer — called from a NATIVE
// main.  Exercises the func-value big-multi-return retbuf convention at the
// native<->LLVM boundary.  Passes on host / native arm32 / native x64; the aa64
// native fix makes it pass there too.
func main() {
	var f *func(int, int, int) (int, int, int, int, int) = mr5.Get5()
	var r1 int
	var r2 int
	var r3 int
	var r4 int
	var r5 int
	r1, r2, r3, r4, r5 = f(10, 20, 30)
	println(r1)   // 10
	println(r2)   // 20
	println(r3)   // 30
	println(r4)   // 30  (a + b)
	println(r5)   // 50  (b + c)
}
