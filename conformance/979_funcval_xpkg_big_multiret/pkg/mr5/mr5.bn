package "pkg/mr5"

// F5 returns a big multi-return tuple ((int x5) > NumGpRetRegs → sret) whose
// components are distinct functions of the args, so a mismarshaled arg or field
// shows up as a wrong component.
func F5(a int, b int, c int) (int, int, int, int, int) {
	return a, b, c, a + b, b + c
}

// Get5 hands F5 back as a raw func value; the caller reaches F5's LLVM-emitted
// shim through it.
func Get5() *func(int, int, int) (int, int, int, int, int) {
	return F5
}
