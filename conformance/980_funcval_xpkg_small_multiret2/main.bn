package "main"
import "pkg/builtins/testing"

import "pkg/mr2"

// A cross-module (LLVM-dep) func value returning a SMALL multi-return tuple —
// (int x2), which every target's native call would pack into return registers
// (NOT an sret buffer) — called from a NATIVE main.  The LLVM-emitted shim,
// however, uses the retbuf-as-first-arg convention for ANY multi-return (gated
// on isAggregateReturn = len(results)>1), storing the whole tuple THROUGH
// retbuf.  Exercises the previously-latent small-multi-return func-value path:
// the native consumer must pass retbuf and read the result from the retbuf
// spill slot rather than collecting it from return registers the shim never
// wrote.  Must pass on host and all three native backends.
func main() {
	var f *func(int, int) (int, int) = mr2.Get2()
	var r1 int
	var r2 int
	r1, r2 = f(10, 3)
	testing.Println(r1)   // 13  (a + b)
	testing.Println(r2)   // 7   (a - b)
}
