package "pkg/mr2"

// F2 returns a SMALL multi-return tuple ((int x2) <= NumGpRetRegs on every
// target, so a native call would pack it into return registers rather than an
// sret buffer).  Its components are distinct functions of the args, so a
// mismarshaled arg or field shows up as a wrong component.
func F2(a int, b int) (int, int) {
	return a + b, a - b
}

// Get2 hands F2 back as a raw func value; the caller reaches F2's LLVM-emitted
// shim through it.
func Get2() *func(int, int) (int, int) {
	return F2
}
