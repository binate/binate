package "main"

// x64 SSE aggregates passed as ARGS through a FUNC-VALUE shim across native<->LLVM.
// main is native; useD2/useDI/useF2 are native funcs that RECEIVE <=16-byte SSE
// aggregates.  They are passed as plain *func values to the LLVM-compiled
// pkg/fvssea, which constructs an aggregate and calls each via the func-value
// dispatch shim (by-address convention).  The native shim's expansion of the
// by-address aggregate into the underlying's XMM/GP arg registers is the path
// under test — GP-packed/dormant on x64 today, SSE at the SysVSseInRegs flip; the
// underlying then spills those regs to its param image.  f64/int fields read as
// small ints, f32 as its exact 32-bit pattern — target-width independent.

import "pkg/fvssea"

func useD2(v fvssea.D2) int {
	return cast(int, v.x) * 10 + cast(int, v.y)
}

func useDI(v fvssea.DI) int {
	return cast(int, v.x) * 100 + cast(int, v.n)
}

// ID = {n int64; x float64} — INTEGER eightbyte FIRST (i64 in a GP arg reg,
// double in XMM); pins the shim marshals the classes in the right eightbyte order.
func useID(v fvssea.ID) int {
	return cast(int, v.x) * 1000 + cast(int, v.n)
}

func useF2(v fvssea.F2) int {
	return cast(int, bit_cast(uint32, v.a))
}

func main() {
	println(fvssea.CallD2(useD2))    // 59   (5*10 + 9)
	println(fvssea.CallDI(useDI))    // 642  (6*100 + 42)
	println(fvssea.CallID(useID))    // 7042 (7*1000 + 42)
	println(fvssea.CallF2(useF2))    // 1069547520 (bits of 1.5f)
}
