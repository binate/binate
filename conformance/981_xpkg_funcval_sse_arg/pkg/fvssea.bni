package "pkg/fvssea"

// SysV-AMD64 SSE aggregates passed AS ARGS through a FUNC-VALUE dispatch shim,
// crossing a package boundary.  Under `-backend native` only main is native; this
// package is LLVM-compiled, so main passes a native func TAKING an SSE aggregate
// as a plain *func value to these Call* helpers, which construct the aggregate and
// call it.  The SSE ABI lives between the native shim and the native underlying:
// the shim expands the by-address aggregate into the underlying's XMM/GP arg regs
// (register-only shim shape here — one param, so it never spills), and the
// underlying spills them back to its param image.  A wrong shim marshal yields a
// wrong number.  Dormant/GP on x64 until the SysVSseInRegs flip.

type D2 struct { x float64; y float64 }
type DI struct { x float64; n int64 }
type ID struct { n int64; x float64 }
type F2 struct { a float32; b float32 }

func CallD2(f *func(D2) int) int
func CallDI(f *func(DI) int) int
func CallID(f *func(ID) int) int
func CallF2(f *func(F2) int) int
