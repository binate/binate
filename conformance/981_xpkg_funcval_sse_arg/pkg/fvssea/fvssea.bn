package "pkg/fvssea"

// Each Call* builds an SSE aggregate and calls the passed native func with it.
// Construction runs LLVM-side; the func-value dispatch passes the aggregate
// by-address to the native shim, which expands it into the underlying's SSE arg
// registers.  A wrong number means the native shim mis-marshalled an eightbyte.

func CallD2(f *func(D2) int) int {
	var d D2
	d.x = 5.0
	d.y = 9.0
	return f(d)
}

func CallDI(f *func(DI) int) int {
	var d DI
	d.x = 6.0
	d.n = 42
	return f(d)
}

func CallID(f *func(ID) int) int {
	var d ID
	d.n = 42
	d.x = 7.0
	return f(d)
}

func CallF2(f *func(F2) int) int {
	var d F2
	d.a = 1.5
	d.b = 2.5
	return f(d)
}
