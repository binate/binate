package "main"

// A bytecode program cannot use __c_global: the VM does no FFI (a permanent
// non-goal).  Compiled, this reads the environ pointer; interpreted, the
// type-checker rejects the __c_global at the frontend (Checker.Interpreted),
// like a syntax error, before any lowering.  So this NEGATIVE test asserts that
// type-check error in the VM modes, and is xfail'd in the compiled/native modes
// (where it prints ok).  Positive coverage — __c_global works when compiled —
// is 982.

func main() {
	var pp ***char = __c_global("environ", **char)
	if present(*pp) { println("ok") } else { println("FAIL") }
}
