package "main"
import "pkg/builtins/testing"

// x64 SSE aggregates passed as args through a func-value SPILL shim, native<->LLVM.
// main is native; useWide* are native funcs taking an SSE aggregate + four int64
// (6 arg words — over the register-only shim budget, so the func-value dispatch
// routes through the spill shim).  They are passed as *func values to the
// LLVM-compiled pkg/wsse, which constructs the args and calls them.  The native
// spill shim's expansion of the by-address SSE aggregate into the underlying's
// XMM/GP arg registers is the path under test — GP-packed/dormant on x64 today,
// SSE at the SysVSseInRegs flip.  Each field/arg lands in a distinct decimal place
// so a mis-marshal shows plainly; all values are small ints (target-width safe).

import "pkg/wsse"

func useWideD2(v wsse.D2, a int64, b int64, c int64, d int64) int {
	return cast(int, v.x) + cast(int, v.y) * 10 + cast(int, a) * 100 +
		cast(int, b) * 1000 + cast(int, c) * 10000 + cast(int, d) * 100000
}

func useWideDI(v wsse.DI, a int64, b int64, c int64, d int64) int {
	return cast(int, v.x) + cast(int, v.n) * 10 + cast(int, a) * 100 +
		cast(int, b) * 1000 + cast(int, c) * 10000 + cast(int, d) * 100000
}

func main() {
	testing.Println(wsse.CallWideD2(useWideD2))    // 432195 (5 + 90 + 100 + 2000 + 30000 + 400000)
	testing.Println(wsse.CallWideDI(useWideDI))    // 432176 (6 + 70 + 100 + 2000 + 30000 + 400000)
}
