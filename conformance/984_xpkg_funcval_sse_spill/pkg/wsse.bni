package "pkg/wsse"

// SysV-AMD64 SSE aggregates passed as args through a func-value SPILL shim.  Each
// func value has enough user-arg words (an SSE aggregate = 2 + four int64 = 6) to
// OVERFLOW the register-only shim budget, so the dispatch routes through the
// over-budget spill shim.  Under `-backend native` main is native and this package
// is LLVM-compiled, so the spill shim (native) must expand the by-address SSE
// aggregate into the underlying's XMM/GP arg registers by eightbyte class — a pure
// D2 (2 SSE eightbytes -> XMM0/XMM1) and a mixed DI (1 SSE -> XMM0, 1 INTEGER -> a
// GP reg alongside the four int64s).  Dormant/GP on x64 until the SysVSseInRegs flip.

type D2 struct { x float64; y float64 }
type DI struct { x float64; n int64 }

func CallWideD2(f *func(D2, int64, int64, int64, int64) int) int
func CallWideDI(f *func(DI, int64, int64, int64, int64) int) int
