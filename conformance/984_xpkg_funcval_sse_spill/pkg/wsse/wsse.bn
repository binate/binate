package "pkg/wsse"

// Each CallWide* builds an SSE aggregate + four int64 args and calls the passed
// native func with them — enough words to force the spill-shim path.  The shim
// must place the SSE aggregate's eightbytes in XMM/GP by class and the int64s in
// the remaining GP regs; a wrong number means a mis-marshalled eightbyte or arg.

func CallWideD2(f *func(D2, int64, int64, int64, int64) int) int {
	var d D2
	d.x = 5.0
	d.y = 9.0
	return f(d, 1, 2, 3, 4)
}

func CallWideDI(f *func(DI, int64, int64, int64, int64) int) int {
	var d DI
	d.x = 6.0
	d.n = 7
	return f(d, 1, 2, 3, 4)
}
