package "main"

// x64 SSE aggregates returned through a CLOSURE dispatch shim.  makeD2/makeDI
// return a capturing closure (@func) whose body returns a <=16-byte SSE
// aggregate; calling it through the func value routes via the closure shim,
// which collects the underlying's XMM0/XMM1 + RAX/RDX return into the retbuf by
// eightbyte class.  Native-compiled here; the SSE collect (shim <-> underlying,
// native<->native) is dormant/GP-packed on x64 until the SysVSseInRegs flip, and
// its correctness is pinned by the flip-vs-all-LLVM diff harness.  f64/int fields
// read as small ints (target-width independent).

type D2 struct { x float64; y float64 }
type DI struct { x float64; n int64 }

func makeD2(x float64, y float64) @func() D2 {
	return func() D2 {
		var v D2
		v.x = x
		v.y = y
		return v
	}
}

func makeDI(x float64, n int64) @func() DI {
	return func() DI {
		var v DI
		v.x = x
		v.n = n
		return v
	}
}

// Integer-only capture (no float scalar parts) — routes to the non-float
// closure aggregate shim, exercising the other SSE return-collect site; the
// double field is a body constant, not a capture.
func makeDIconst(n int64) @func() DI {
	return func() DI {
		var v DI
		v.x = 3.0
		v.n = n
		return v
	}
}

// Seven int64 captures overflow the register-only closure budget, forcing the
// STACK-SPILL closure aggregate shim — exercising the spill SSE return-collect
// site.  No float scalar parts (double field is a body constant, n is the int64
// capture sum), so it routes through the no-float spill path.
func makeSpillDI(a int64, b int64, c int64, d int64, e int64, f int64, g int64) @func() DI {
	return func() DI {
		var v DI
		v.x = 3.0
		v.n = a + b + c + d + e + f + g
		return v
	}
}

func main() {
	var f @func() D2 = makeD2(5.0, 9.0)
	var d D2 = f()
	println(cast(int, d.x) * 10 + cast(int, d.y))    // 59

	var g @func() DI = makeDI(6.0, 42)
	var e DI = g()
	println(cast(int, e.x) * 100 + cast(int, e.n))   // 642

	var h @func() DI = makeDIconst(77)
	var w DI = h()
	println(cast(int, w.x) * 100 + cast(int, w.n))   // 377 (3*100 + 77)

	var s @func() DI = makeSpillDI(1, 2, 3, 4, 5, 6, 7)
	var q DI = s()
	println(cast(int, q.x) * 1000 + cast(int, q.n))  // 3028 (3*1000 + 28)
}
