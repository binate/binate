package "main"

// x64 SSE aggregates passed as PARAMS / CAPTURES through a closure dispatch shim.
// makeSumD2 (int64 capture, SSE-agg D2 param — no float scalar) routes to the
// GP-only fast shim while dormant and, once the SSE gate flips, to the float-aware
// shim (an SSE aggregate param needs XMM marshalling); makeCapD2 CAPTURES an SSE
// aggregate; makeMixed combines a float-scalar param with an SSE-agg param (float
// shim in both modes).  The native shim's expansion of the by-address / captured
// SSE aggregate into the underlying's XMM/GP arg registers is the path under test
// — GP-packed/dormant on x64 until the flip, its correctness pinned by the
// flip-vs-all-LLVM diff harness.  f64/int read as small ints (target-width safe).

type D2 struct { x float64; y float64 }
type P struct { m int64; n int64 }

func makeSumD2(base int64) @func(D2) int {
	return func(v D2) int {
		return cast(int, v.x) * 10 + cast(int, v.y) + cast(int, base)
	}
}

func makeCapD2(c D2) @func() int {
	return func() int {
		return cast(int, c.x) * 10 + cast(int, c.y)
	}
}

func makeMixed(base int64) @func(float64, D2) int {
	return func(s float64, v D2) int {
		return cast(int, s) + cast(int, v.x) * 10 + cast(int, v.y) * 100 + cast(int, base)
	}
}

// SSE-agg param alongside four trailing int64 params: the SSE aggregate fits in
// registers (2 XMM) while the int64s fill several GP arg regs — exercising the
// float shim's in-register SSE marshal interleaved with plain GP args (no spill).
func makeWide(base int64) @func(D2, int64, int64, int64, int64) int {
	return func(v D2, p int64, q int64, r int64, t int64) int {
		return cast(int, v.x) + cast(int, v.y) * 10 + cast(int, p) * 100 +
			cast(int, q) * 1000 + cast(int, r) * 10000 + cast(int, t) * 100000 +
			cast(int, base) * 1000000
	}
}

// SSE-aggregate CAPTURE at a non-zero struct offset (after `a`) followed by
// another capture (`b`), in an AGGREGATE-returning closure — this routes to the
// aggregate-return float shim, whose closure-struct base is R11.  The regression
// this pins: the SSE capture marshal must NOT clobber R11, else `b` (read at the
// next struct offset off the corrupted base) is garbage.
func makeCapAgg(a int64, v D2, b int64) @func() P {
	return func() P {
		var r P
		r.m = a + cast(int64, v.x)
		r.n = b + cast(int64, v.y)
		return r
	}
}

func main() {
	var d D2
	d.x = 5.0
	d.y = 9.0
	var f @func(D2) int = makeSumD2(1000)
	println(f(d))                                  // 1059 (50 + 9 + 1000)

	var c D2
	c.x = 6.0
	c.y = 7.0
	var h @func() int = makeCapD2(c)
	println(h())                                   // 67 (60 + 7)

	var g @func(float64, D2) int = makeMixed(1)
	println(g(2.0, d))                             // 953 (2 + 50 + 900 + 1)

	var w @func(D2, int64, int64, int64, int64) int = makeWide(1)
	println(w(d, 1, 2, 3, 4))                      // 1432195

	var ca @func() P = makeCapAgg(10, d, 20)
	var pr P = ca()
	println(cast(int, pr.m) * 100 + cast(int, pr.n))  // 1529 (m=10+5=15, n=20+9=29)
}
