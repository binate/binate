package "main"

// x64 SSE aggregates passed as ARGS and returned through an interface-method
// dispatch (OP_CALL_IFACE_METHOD).  swap takes and returns a 2xf64 SSE
// aggregate (both eightbytes SSE); fold takes {f64,i64} and returns {i64,f64}
// (the SSE and INTEGER eightbytes swap FILES between arg and return —
// exercising both dual-file orderings); tag takes an SSE aggregate and returns
// a scalar int (the non-SSE return path).  The native call-site's SSE marshal
// (emitCallIfaceMethod: emitSseAggregateArg for the arg, collectSseAggregateReturn
// for the return) is GP-packed/dormant on x64 until the SSE gate flips, its
// correctness pinned cross-module by the flip-vs-all-LLVM diff harness and here
// across every conformance mode (on aarch64 the same aggregates ride the HFA
// path).  f64 fields read as small ints (target-width safe); no native float32
// arithmetic.

type D2 struct { x float64; y float64 }
type DI struct { x float64; n int64 }
type ID struct { n int64; x float64 }

interface Shape {
	swap(v D2) D2
	fold(v DI) ID
	tag(v D2) int
}

type Box struct { base int }

func (b *Box) swap(v D2) D2 {
	var r D2
	r.x = v.y
	r.y = v.x
	return r
}

func (b *Box) fold(v DI) ID {
	var r ID
	r.n = v.n + cast(int64, b.base)
	r.x = v.x
	return r
}

func (b *Box) tag(v D2) int {
	return cast(int, v.x) * 10 + cast(int, v.y) + b.base
}

impl *Box : Shape

func main() {
	var bx Box
	bx.base = 100
	var s *Shape = &bx

	var d D2
	d.x = 5.0
	d.y = 9.0

	var sw D2 = s.swap(d)
	println(cast(int, sw.x) * 10 + cast(int, sw.y))   // 9*10 + 5 = 95

	var di DI
	di.x = 6.0
	di.n = 20
	var fo ID = s.fold(di)
	println(cast(int, fo.n) * 10 + cast(int, fo.x))   // (20+100)*10 + 6 = 1206

	println(s.tag(d))                                  // 5*10 + 9 + 100 = 159
}
