package "main"
import "pkg/builtins/testing"

// Cross-package variant of 987_iface_sse: the interface, the receiver Box, its
// impl, and the methods live in pkg/shapes; main forms the `*Shape` iface value
// and dispatches.  Exercises the same native SSE iface arg/return marshal with
// an EXTERNAL vtable global (the cross-TU OP_IFACE_VALUE relocation).  Values
// read as small ints (target-width safe); no native float32 arithmetic.

import "pkg/shapes"

func main() {
	var bx shapes.Box = shapes.NewBox(100)
	var s *shapes.Shape = &bx

	var d shapes.D2
	d.x = 5.0
	d.y = 9.0

	var sw shapes.D2 = s.swap(d)
	testing.Println(cast(int, sw.x) * 10 + cast(int, sw.y))   // 9*10 + 5 = 95

	var di shapes.DI
	di.x = 6.0
	di.n = 20
	var fo shapes.ID = s.fold(di)
	testing.Println(cast(int, fo.n) * 10 + cast(int, fo.x))   // (20+100)*10 + 6 = 1206

	testing.Println(s.tag(d))                                  // 5*10 + 9 + 100 = 159

	testing.Println(s.mix(2.0, d))                             // 2 + 50 + 900 + 100 = 1052
}
