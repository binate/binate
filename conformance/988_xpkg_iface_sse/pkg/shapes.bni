package "pkg/shapes"

// Cross-package interface + impl: the Shape interface, the Box receiver, its
// `impl *Box : Shape`, and the methods all live here; main imports them, forms
// a `*Shape` iface value over a Box, and dispatches.  The vtable `__ivt` is an
// external global to main, so the OP_IFACE_VALUE site resolves it cross-TU.
// The methods take/return SysV-SSE aggregates (2xf64, and the dual-file
// {f64,i64}/{i64,f64}) so the native iface call-site's SSE arg marshal and
// return collect are exercised — dormant/GP on x64 until the SSE gate flips.

type D2 struct { x float64; y float64 }
type DI struct { x float64; n int64 }
type ID struct { n int64; x float64 }

interface Shape {
	swap(v D2) D2
	fold(v DI) ID
	tag(v D2) int
}

type Box struct { base int }

impl *Box : Shape

func NewBox(b int) Box
