package "pkg/shapes"

func NewBox(b int) Box {
	var v Box
	v.base = b
	return v
}

func (b *Box) swap(v D2) D2 {
	var r D2
	r.x = v.y
	r.y = v.x
	return r
}

func (b *Box) fold(v DI) ID {
	var r ID
	r.n = v.n + cast(int64, b.base)
	r.x = v.x
	return r
}

func (b *Box) tag(v D2) int {
	return cast(int, v.x) * 10 + cast(int, v.y) + b.base
}

// A float SCALAR (consumes XMM0) followed by an SSE aggregate (must land in
// XMM1/XMM2) — pins the iface call-site's nsrn advancing past the scalar before
// marshalling the aggregate.  Distinct place values expose any XMM misplacement.
func (b *Box) mix(s float64, v D2) int {
	return cast(int, s) + cast(int, v.x) * 10 + cast(int, v.y) * 100 + b.base
}
