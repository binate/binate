package "main"

// MEMORY-class SSE aggregate arg: 5 pure-SSE D2 aggregates = 10 SSE eightbytes,
// but the SysV/x64 XMM arg file (and the AAPCS64 SIMD file) hold only 8.  a..d
// fill the register file; e can't fit (all-or-nothing) so the WHOLE e passes in
// MEMORY (the outgoing-args stack).  This exercises the class-agnostic byte-copy
// of an SSE aggregate that OVERFLOWS the register file — the untested tail of the
// x64 SSE work (stackOff >= 0 -> emitAggregateArg, NOT emitSseAggregateArg) —
// across the direct, interface, and closure arg-loops (each routes MEMORY-class
// aggregates to the same byte-copy path).  On aarch64 the same call rides the
// HFA-to-MEMORY overflow.  Each of a.x/b.x/c.x/d.x (register args) plus BOTH
// fields of e (the MEMORY arg) is read at a distinct decimal place, so a
// mis-placed eightbyte prints a different number.  Integer-valued f64 read via
// cast(int, ...) — target-width safe, no float32 arithmetic.

type D2 struct { x float64; y float64 }

func directSum5(a D2, b D2, c D2, d D2, e D2) int {
	return cast(int, a.x) + cast(int, b.x) * 10 + cast(int, c.x) * 100 +
		cast(int, d.x) * 1000 + cast(int, e.x) * 10000 + cast(int, e.y) * 100000
}

type Box struct { base int }

interface Summer {
	sum5(a D2, b D2, c D2, d D2, e D2) int
}

func (bx *Box) sum5(a D2, b D2, c D2, d D2, e D2) int {
	return cast(int, a.x) + cast(int, b.x) * 10 + cast(int, c.x) * 100 +
		cast(int, d.x) * 1000 + cast(int, e.x) * 10000 + cast(int, e.y) * 100000 +
		bx.base
}

impl *Box : Summer

// makeSum5 captures base, so the returned value is a CLOSURE (its dispatch shim
// marshals the MEMORY-class e through the byte-copy tail).
func makeSum5(base int) @func(D2, D2, D2, D2, D2) int {
	return func(a D2, b D2, c D2, d D2, e D2) int {
		return cast(int, a.x) + cast(int, b.x) * 10 + cast(int, c.x) * 100 +
			cast(int, d.x) * 1000 + cast(int, e.x) * 10000 + cast(int, e.y) * 100000 +
			base
	}
}

func main() {
	var a D2
	a.x = 1.0
	var b D2
	b.x = 2.0
	var c D2
	c.x = 3.0
	var d D2
	d.x = 4.0
	var e D2
	e.x = 5.0
	e.y = 6.0

	println(directSum5(a, b, c, d, e))               // 1+20+300+4000+50000+600000 = 654321

	var bx Box
	bx.base = 1000000
	var s *Summer = &bx
	println(s.sum5(a, b, c, d, e))                    // 654321 + 1000000 = 1654321

	var f @func(D2, D2, D2, D2, D2) int = makeSum5(2000000)
	println(f(a, b, c, d, e))                         // 654321 + 2000000 = 2654321
}
