package "main"
import "pkg/builtins/testing"

// Interface method dispatch inside a frame larger than the ARM 12-bit
// (4095-byte) immediate range, on the native arm32 backend.  In a large frame
// the frame accesses (emitFrameStore / emitFrameAddr) materialize addresses in
// IP, so emitCallIfaceMethod keeps the method handle pointer in a POOL register
// across the prefix loads and loads the call target into IP only as the last
// step before the BLX — a call target placed in IP any earlier would be
// overwritten with a frame offset and the call would branch through garbage.
// (Large frames in general are covered by 991.)  The receiver is a raw
// `*Counter` (no managed field → no dtor), keeping this about the dispatch,
// not refcount cleanup.  `[2000]int` (8000 bytes) forces the >4095-byte frame,
// so the iface value's spill slot sits past the immediate range; the
// dispatched method reads the big array so the result depends on the
// large-frame accesses being correct.

interface Summer {
	sum() int
}

type Counter struct {
	base int
}

func (c *Counter) sum() int {
	return c.base + 40
}

impl *Counter : Summer

func main() {
	var buf [2000]int
	buf[0] = 1
	buf[1999] = 1
	var c Counter
	c.base = buf[0] + buf[1999]
	var s *Summer = &c
	testing.Println(s.sum())
}
