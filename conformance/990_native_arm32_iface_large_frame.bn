package "main"
import "pkg/builtins/testing"

// Interface method dispatch inside a frame larger than the ARM 12-bit
// (4095-byte) immediate range, on the native arm32 backend.  This unshadows
// the P4-c.3 iface-dispatch fix: emitCallIfaceMethod spills the loaded method
// pointer through a POOL register (not IP) precisely because, in a large frame,
// emitFrameStore materializes the spill-slot address in IP — storing IP
// directly would overwrite the method pointer with the offset and branch
// through garbage.  That wrong-code was previously UNREACHABLE, because a large
// frame COMPILE_ERRORed first (the bug 989 covers); with large frames fixed it
// is now exercised end-to-end here.  The receiver is a raw `*Counter` (no
// managed field → no dtor), keeping this about the method-pointer spill, not
// refcount cleanup.  `[2000]int` (8000 bytes) forces the >4095-byte frame, so
// the iface value's spill slot / method-pointer stash sit past the immediate
// range; the dispatched method reads the big array so the result depends on
// the large-frame accesses being correct.

interface Summer {
	sum() int
}

type Counter struct {
	base int
}

func (c *Counter) sum() int {
	return c.base + 40
}

impl *Counter : Summer

func main() {
	var buf [2000]int
	buf[0] = 1
	buf[1999] = 1
	var c Counter
	c.base = buf[0] + buf[1999]
	var s *Summer = &c
	testing.Println(s.sum())
}
