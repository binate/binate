package "main"
import "pkg/builtins/testing"

// A function frame larger than the ARM 12-bit (4095-byte) LDR/STR
// immediate-offset range must still compile and run on the native arm32
// backend.  `[2000]int` is 8000 bytes, so the array's zero-init + element
// accesses reach frame/aggregate offsets past 4095, so the aggregate word-copy /
// large-frame access paths must materialize the address in a scratch (as
// emitFrame*/emitBase* do); a bare MemImm(base, off) there fails with
// `native backend failed to emit object (arch=arm32)`.
// Non-iface, so this is a general large-frame regression, not tied to dispatch.

func main() {
	var buf [2000]int
	buf[0] = 1
	buf[1999] = 2
	testing.Println(buf[0] + buf[1999])
}
