package "main"

// Interface method call whose aggregate args OVERFLOW the integer arg registers
// and spill to the stack.  I2 is a 16-byte all-integer aggregate (always the GP
// path — no SSE/HFA), 5 of them: with the iface `data` pointer taking one GP arg
// reg, p4/p5 spill to the outgoing-args stack.  Reading one field of each
// register arg plus BOTH fields of the spilled p5 at distinct decimal places
// exposes a mis-placed stack arg.  Pins the native iface call-site's byte-copy of
// a MEMORY-class aggregate arg.

type I2 struct { a int64; b int64 }

interface Summer {
	isum5(p1 I2, p2 I2, p3 I2, p4 I2, p5 I2) int
}

type Box struct { base int }

func (bx *Box) isum5(p1 I2, p2 I2, p3 I2, p4 I2, p5 I2) int {
	return cast(int, p1.a) + cast(int, p2.a) * 10 + cast(int, p3.a) * 100 +
		cast(int, p4.a) * 1000 + cast(int, p5.a) * 10000 + cast(int, p5.b) * 100000 +
		bx.base
}

impl *Box : Summer

func main() {
	var bx Box
	bx.base = 0
	var s *Summer = &bx
	var p1 I2
	p1.a = 1
	var p2 I2
	p2.a = 2
	var p3 I2
	p3.a = 3
	var p4 I2
	p4.a = 4
	var p5 I2
	p5.a = 5
	p5.b = 6
	println(s.isum5(p1, p2, p3, p4, p5))  // 1+20+300+4000+50000+600000 = 654321
}
