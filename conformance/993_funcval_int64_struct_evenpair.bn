package "main"
import "pkg/builtins/testing"

// A coerced in-register aggregate carrying an int64 field is 8-byte-aligned, so
// AAPCS §6.5 stage C.3 places it on an EVEN outgoing core register.  Passed
// through a function value after a leading `int` arg, the func-value shim's
// outgoing GP cursor is at an ODD register when it reaches the struct, so the
// shim must skip a register (an even-pair pad) and expand the struct into the
// same even register pair the callee reads it from.  A shim that advanced its
// cursor linearly would place the struct one register early, and the callee
// (which DOES apply the even-pair rule) would read the fields from the wrong
// registers — a silent miscompile that this end-to-end round-trip catches.

type S struct {
	v int64
}

func sink(a int, s S) {
	testing.Println(a)
	testing.Println(cast(int, s.v))
}

func main() {
	var s S
	s.v = cast(int64, 1234567)
	var f @func(int, S) = sink
	f(42, s)
}
