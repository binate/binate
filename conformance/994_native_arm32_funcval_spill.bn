package "main"

// End-to-end func-value stack-spill on the arm32 NATIVE backend, WITHOUT float
// (PIECE 1).  arm32's register budget (R0..R3 = 4 words under AAPCS32) is smaller
// than the VM dispatch cap (data + a0..a6 = 7 words) and the aa64 / x64 budgets, so
// these shapes spill on arm32 while staying register-only (no spill) on every
// default mode — the test round-trips correctly everywhere and specifically greens
// the arm32 native framed-BL spill shim (emitFuncvalSpillShimArm32).
//
//   * SCALAR spill: a 5-int func value.  arm32's shim incoming budget is R1..R3 (3
//     user words after the dropped data word), so args 4 and 5 arrive on the
//     dispatch caller's stack; the shim reserves an outgoing-args area, shifts the
//     register words down, loads the spilled words from the caller's stack, and BLs
//     the underlying (which reads a4/a5 from ITS reserved stack area).  5 user words
//     <= 7, so the VM trampoline and the wider aa64/x64 budgets pass register-only.
//
//   * COERCED-AGGREGATE SPLIT spill: an 8-byte {int,int} struct arg after 3 ints.
//     The struct arrives BY-ADDRESS as one dispatch word (4 incoming words total <=
//     every mode's budget), but the arm32 shim re-expands it to 2 value-words which,
//     after the 3 leading ints fill R0..R2, STRADDLE the last GP reg (R3) and the
//     outgoing-args stack — the spill marshal's coerced-agg SPLIT tail
//     (emitSpillCoercedAggArm32's stackOff >= 0 branch, which the register-only
//     marshal lacks).  Word 0 -> R3, word 1 -> [SP + outgoing-args].
//
//   * EVEN-PAIR + full-stack spill: a 16-byte {int64,int64} 8-aligned struct after 3
//     ints.  AAPCS §6.5 C.3 pushes its even-register start past R3, so all 4 value-
//     words go to the outgoing-args stack (the coerced-agg tail with regWords 0).
//     int64 fields are read via cast(int, ...) (arm32 has no 64-bit scalar print).
//
//   * SRET-RETURN even-pair spill: a func value that RETURNS a big aggregate (a
//     12-byte Triple, via the R0 sret retbuf) AND takes an 8-aligned {int64,int64}
//     after a leading int.  This is the case the scalar-return cells above never
//     exercised: the sret shim's R0 = retbuf holds the GP-file's first slot, so the
//     {int64,int64} classifies at an EVEN absolute register and splits across R2:R3 +
//     two outgoing-args stack words.  The shim must classify over the SAME prefixed
//     sret-pointer + full-cc type list the callee reads (not a reduced GP-reg file,
//     which drops the even-pair parity and misplaces every value word), so the
//     returned Triple round-trips.  4 dispatch words <= 7, register-only elsewhere.
//
// The float cases (718's fret8 / mix8) stay P5 fail-loud on arm32-native, so 718 is
// left untouched and this is a separate no-float test.

func sum5(a int, b int, c int, d int, e int) int {
	return a + b + c + d + e
}

type IPair struct {
	x int
	y int
}

// An 8-byte 4-aligned struct arg AFTER 3 ints: on arm32 the shim STRADDLES the
// struct's 2 value-words across R3 and the outgoing-args stack.
func splitStraddle(a int, b int, c int, p IPair) int {
	return a + b + c + p.x + p.y
}

type LPair struct {
	x int64
	y int64
}

// A 16-byte 8-aligned struct arg AFTER 3 ints: the even-register-pair pad pushes it
// entirely to the outgoing-args stack (all 4 value-words spilled).
func splitEvenPair(a int, b int, c int, p LPair) int {
	return a + b + c + cast(int, p.x) + cast(int, p.y)
}

type Triple struct {
	x int
	y int
	z int
}

// SRET-RETURN even-pair spill: returns a BIG aggregate (12-byte Triple > the arm32
// InternalSretBytes threshold of 4, so the hidden retbuf pointer rides R0) AND takes
// an 8-aligned coerced aggregate ({int64,int64}) after a leading int.  On arm32's
// sret shim, R0 = retbuf STAYS while the user args are placed over the SAME prefixed
// sret-pointer + full-cc classification the callee uses: the leading sret pointer
// occupies R0, so the running NGRN reaches the {int64,int64} at an EVEN absolute
// register — splitting it across R2:R3 + two outgoing-args stack words, exactly
// where the callee reads it.  A reduce-the-GP-file model would drop that even-pair
// parity and place the value words one slot off (word 0 -> R3, remainder over three
// stack words), so the callee would read garbage — a silent miscompile this case is
// the runtime oracle for.  4 dispatch words (data + int + by-address {int64,int64})
// <= 7, so it round-trips register-only on the VM / aa64 / x64 modes.
func sretEvenPair(a int, p LPair) Triple {
	var t Triple
	t.x = a
	t.y = cast(int, p.x)
	t.z = cast(int, p.y)
	return t
}

func main() {
	var f5 @func(int, int, int, int, int) int = sum5
	println(f5(1, 2, 3, 4, 5)) // 15

	var ip IPair
	ip.x = 10
	ip.y = 20
	var fst @func(int, int, int, IPair) int = splitStraddle
	println(fst(1, 2, 3, ip)) // 1+2+3 + 10 + 20 = 36

	var lp LPair
	lp.x = cast(int64, 100)
	lp.y = cast(int64, 200)
	var fep @func(int, int, int, LPair) int = splitEvenPair
	println(fep(1, 2, 3, lp)) // 1+2+3 + 100 + 200 = 306

	var sp LPair
	sp.x = cast(int64, 40)
	sp.y = cast(int64, 500)
	var fsr @func(int, LPair) Triple = sretEvenPair
	var tr Triple = fsr(7, sp) // {7, 40, 500}
	println(tr.x + tr.y + tr.z) // 7 + 40 + 500 = 547
}
