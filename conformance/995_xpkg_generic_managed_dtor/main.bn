package "main"
import "pkg/builtins/testing"

// A generic container (pkg/gholder.Holder) instantiated CROSS-PACKAGE on a
// MANAGED element type (@Box).  Destroying the Holder must destroy its @[]@Box
// backing, whose synthetic destructor is emitted under main's mangled prefix but
// CALLED from pkg/gholder's monomorphized code under gholder's prefix -- the two
// names disagree, so compiled modes fail to link (undefined symbol) and the VM
// panics (extern not found).  An in-package instantiation would NOT reproduce it:
// there the call-prefix and definition-prefix coincide.  See the claude-todo
// MAJOR entry "cross-package generic container on a managed element type".

import "pkg/gholder"

type Box struct {
	v int
}

func main() {
	// Managed-POINTER element (@Box): the container backing is @[]@Box, whose
	// element dtor is the module-local __dtor_ms_mp_Box.
	var h @gholder.Holder[@Box] = gholder.New[@Box]()
	var i int = 0
	for i = 0; i < 3; i = i + 1 {
		var b @Box = make(Box)
		b.v = i * 10
		gholder.Put[@Box](h, b)
	}
	testing.Println(gholder.Count[@Box](h))       // 3
	var got @Box = gholder.At[@Box](h, 1)
	testing.Println(got.v)                         // 10

	// Managed-SLICE element (@[]char): the backing is @[]@[]char, whose element
	// dtor is the module-local __dtor_ms_ms_uint8 (the nested case, and exactly
	// the string-list shape the formatter/interp adoptions need).
	var hs @gholder.Holder[@[]char] = gholder.New[@[]char]()
	var s @[]char = make_slice(char, 2)
	s[0] = 'h'
	s[1] = 'i'
	gholder.Put[@[]char](hs, s)
	testing.Println(gholder.Count[@[]char](hs))   // 1
	var got2 @[]char = gholder.At[@[]char](hs, 0)
	testing.Println(len(got2))                     // 2
}
