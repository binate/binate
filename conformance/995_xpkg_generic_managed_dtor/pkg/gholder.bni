package "pkg/gholder"

// Holder[T] is a minimal generic container: a managed-slice backing @[]T plus a
// live count.  Its generic bodies live here (body-included) so a cross-package
// consumer monomorphizes them at its own use sites -- the shape that exposes the
// managed-element destructor mangling.
type Holder[T any] struct {
	items @[]T
	n     int
}

func New[T any]() @Holder[T] {
	var h @Holder[T] = make(Holder[T])
	h.items = make_slice(T, 4)
	h.n = 0
	return h
}

func Put[T any](h @Holder[T], x T) {
	h.items[h.n] = x
	h.n = h.n + 1
}

func Count[T any](h @Holder[T]) int {
	return h.n
}

func At[T any](h @Holder[T], i int) T {
	return h.items[i]
}
