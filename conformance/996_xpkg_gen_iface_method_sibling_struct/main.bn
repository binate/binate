package "main"

// A DIFFERENT package implements the imported generic interface Wrap[int].  This
// forces the checker to instantiate gbox.Wrap[int] and resolve its method
// signature `Make() @Box[T]` with T:=int during impl-satisfaction.  That
// resolution must run under gbox's DEFINING package (where the unqualified `Box`
// lives), not main's — otherwise `Box` is reported undefined.  Regression for the
// populateInstantiatedInterface curPkgPath fix.

import "pkg/gbox"

type Factory struct { base int }

func (f @Factory) Make() @gbox.Box[int] {
	var b @gbox.Box[int] = make(gbox.Box[int])
	b.v = 42
	return b
}

impl @Factory : gbox.Wrap[int]

func main() {
	var f @Factory = make(Factory)
	var w @gbox.Wrap[int] = f
	var b @gbox.Box[int] = w.Make()
	println(b.v)
}
