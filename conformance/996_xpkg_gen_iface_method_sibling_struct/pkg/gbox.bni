package "pkg/gbox"

// A generic interface (Wrap[T]) whose method signature references a SIBLING
// generic type (Box[T]) instantiated with the interface's own type parameter.
// The sibling name is UNQUALIFIED here (Box, resolved in gbox's own scope).

type Box[T any] struct { v T }

interface Wrap[T any] {
	Make() @Box[T]
}
