package "main"

// A DIFFERENT package implements gseq.Iterable[int].  Instantiating
// gseq.Iterable[int] to check satisfaction re-resolves `AsIterator() @Iterator[T]`
// with T:=int; the sibling `Iterator` must resolve in gseq's package, not main's.
// Regression for the populateInstantiatedInterface curPkgPath fix (interface
// sibling — the boxed-Iterable design for the stdx containers).

import "pkg/gseq"

type Count struct { cur int; max int }

func (c *Count) Next() (int, bool) {
	if c.cur >= c.max { return 0, false }
	var v int = c.cur
	c.cur = c.cur + 1
	return v, true
}

impl *Count : gseq.Iterator[int]

type UpTo struct { n int }

func (u @UpTo) AsIterator() @gseq.Iterator[int] {
	var c @Count = make(Count)
	c.cur = 0
	c.max = u.n
	return c
}

impl @UpTo : gseq.Iterable[int]

func main() {
	var u @UpTo = make(UpTo)
	u.n = 4
	var seq @gseq.Iterable[int] = u
	var it @gseq.Iterator[int] = seq.AsIterator()
	var sum int = 0
	for {
		x, ok := it.Next()
		if !ok { break }
		sum = sum + x
	}
	println(sum)
}
