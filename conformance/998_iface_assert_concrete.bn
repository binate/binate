package "main"

// Expression-form concrete type assertion x.(*T) / x.(@T) (spec §11.12
// `iface.assert`) — a HIT recovers the boxed pointer.  RTTI Slice 4
// (compiled-mode only; the VM path is Slice 5 / d-i).

interface Greeter {
	greet() int
}

type Thing struct {
	x int
}

func (t *Thing) greet() int {
	return t.x
}

impl *Thing : Greeter

func main() {
	// *T borrow from a raw *I.
	var t Thing
	t.x = 42
	var rg *Greeter = &t
	var rb *Thing = rg.(*Thing)
	println(rb.greet())

	// @T retain from a managed @I.
	var m @Thing = make(Thing)
	m.x = 7
	var mg @Greeter = m
	var mb @Thing = mg.(@Thing)
	println(mb.greet())
}
