package "main"

// A failed concrete type assertion (expression form) aborts with the spec
// §17.5 panic `type assertion failed: <dyn> is not <T>`.  RTTI Slice 4.

interface Greeter {
	greet() int
}

type Thing struct {
	x int
}

type Other struct {
	y int
}

func (t *Thing) greet() int {
	return t.x
}

func (o *Other) greet() int {
	return o.y
}

impl *Thing : Greeter
impl *Other : Greeter

func main() {
	var t Thing
	t.x = 42
	var g *Greeter = &t
	var back *Other = g.(*Other)
	println(back.y)
}
