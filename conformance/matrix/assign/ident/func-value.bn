package "main"

// Matrix cell — form=assign (single `=`), shape=ident, type=func-value (@func).
// Single-assignment of a managed @func must RefInc its closure record and
// RefDec the prior occupant's. Observed without poking the value layout:
// a CAPTURES counter c, so c stays alive exactly while some live @func
// references the capturing record. After `b = a` copies the record, dropping
// the original `a` must NOT free it (b still holds a ref) — proven by b()
// still seeing c; the final drop of b returns c to baseline.
//
// `none` is a typed non-capturing @func used as the drop target: a bare
// func literal in assignment position (`a = func(){...}`) doesn't resolve its
// managed/raw flavour from the LHS, so it needs a typed var (as in 587).
// See conformance/matrix/README.md.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func main() {
	var c @Counter = make(Counter)
	c.N = 5
	var pc *uint8 = bit_cast(*uint8, c)
	var a @func() int = func() int { return c.N }   // capturing: record RefIncs c
	var none @func() int = func() int { return 0 }  // non-capturing drop target
	println(rt.Refcount(pc))   // 2: main's c + the capture
	var b @func() int = none
	b = a                       // single-assign ident: RefInc a's record, RefDec old b's
	println(b())                // 5: b's copy dispatches through the record to c
	a = none                    // drop the ORIGINAL; balanced copy keeps the record alive
	println(b())                // 5: still valid — the copy RefInc'd the record
	println(rt.Refcount(pc))   // 2: c still held (record b references still captures it)
	b = none                    // drop b: record hits 0, frees, releases c
	println(rt.Refcount(pc))   // 1: balanced
}
