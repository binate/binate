package "main"

// Matrix cell — form=assign (single `=`), shape=ident, type=iface (@Iface).
// Single-assignment of a managed interface value must RefInc the new value's
// data ref and RefDec the prior occupant's. A managed @Iface holds a ref to
// its wrapped object, so the wrapped @Counter's refcount tracks the iface
// directly. See conformance/matrix/README.md.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func (c *Counter) num() int { return c.N }

interface Numbered {
	num() int
}

impl *Counter : Numbered

func main() {
	var c @Counter = make(Counter)
	c.N = 5
	var d @Counter = make(Counter)
	d.N = 9
	var pc *uint8 = bit_cast(*uint8, c)
	println(rt.Refcount(pc))   // 1: only main's c
	var a @Numbered = c        // wrap c: managed iface RefIncs c
	var b @Numbered = d        // b wraps a different object
	println(rt.Refcount(pc))   // 2: main's c + a
	b = a                      // single-assign ident: RefInc a's data (c), RefDec old b's (d)
	println(rt.Refcount(pc))   // 3: c held by main, a, b
	println(b.num())           // 5: b dispatches to c
	b = d                      // drop b's alias to c, back to d
	println(rt.Refcount(pc))   // 2: balanced
}
