package "main"

// Matrix cell — form=assign (single `=`), shape=ident, type=managed-ptr (@T).
// A single-assignment to a plain identifier must RefInc the new value and
// RefDec the prior occupant (Axiom 5). With a MORTAL source (make, not an
// immortal literal) the refcount is observable: assigning `a` into `b`
// raises a's object to 2; dropping the alias returns it to baseline 1.
// See conformance/matrix/README.md.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func main() {
	var a @Counter = make(Counter)
	a.N = 7
	var pa *uint8 = bit_cast(*uint8, a)
	println(rt.Refcount(pa))   // 1: only a
	var b @Counter = make(Counter)
	b = a                      // single-assign ident: RefInc a, RefDec old b
	println(rt.Refcount(pa))   // 2: a + b
	println(b.N)               // 7: b aliases a's data
	b = make(Counter)          // drop the alias
	println(rt.Refcount(pa))   // 1: balanced
}
