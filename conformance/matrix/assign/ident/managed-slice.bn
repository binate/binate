package "main"

// Matrix cell — form=assign (single `=`), shape=ident, type=managed-slice (@[]T).
// Single-assignment to an identifier must RefInc the new managed-slice's
// backing and RefDec the prior occupant's. Observed via the backing refptr
// (word 2 of the 3-word slice header). See conformance/matrix/README.md.

import "pkg/builtins/rt"

func main() {
	var a @[]int = make_slice(int, 3)
	a[0] = 9
	var pa *int = bit_cast(*int, &a)
	var backing *uint8 = bit_cast(*uint8, pa[2])   // word 2 = backing refptr
	println(rt.Refcount(backing))   // 1: only a
	var b @[]int = make_slice(int, 1)
	b = a                            // single-assign ident: RefInc a's backing, RefDec old b's
	println(rt.Refcount(backing))   // 2: a + b
	println(b[0])                    // 9: b aliases a's backing
	b = make_slice(int, 1)           // drop the alias
	println(rt.Refcount(backing))   // 1: balanced
}
