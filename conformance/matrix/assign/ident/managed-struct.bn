package "main"

// Matrix cell — form=assign (single `=`), shape=ident, type=managed-struct
// (a by-value struct with a managed field). Copying the struct value into an
// identifier must save-copy-destroy: __copy_ RefIncs the new value's managed
// field and __dtor_ RefDecs the prior occupant's. Observed via the inner
// @Counter's refcount. See conformance/matrix/README.md.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

type Box struct {
	c @Counter
}

func main() {
	var inner @Counter = make(Counter)
	inner.N = 7
	var pi *uint8 = bit_cast(*uint8, inner)
	println(rt.Refcount(pi))   // 1: only inner
	var a Box
	a.c = inner                // selector store: a.c aliases inner
	println(rt.Refcount(pi))   // 2: inner + a.c
	var b Box
	b = a                      // single-assign ident, by-value copy: __copy_ RefIncs a.c
	println(rt.Refcount(pi))   // 3: inner + a.c + b.c
	println(b.c.N)             // 7: b's copy sees inner
	var z Box
	b = z                      // drop b's copy: __dtor_ RefDecs old b.c
	println(rt.Refcount(pi))   // 2: balanced (b's copy released)
}
