package "main"

// Matrix cell — form=assign (single `=`), shape=index-slice (s[i]),
// type=managed-ptr. Storing a managed value into a managed-slice element must
// RefInc the new value and RefDec the element's prior occupant (Axiom 5).
// See ../../README.md.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func main() {
	var src @Counter = make(Counter)
	src.N = 7
	var ps *uint8 = bit_cast(*uint8, src)
	println(rt.Refcount(ps))   // 1: only src
	var s @[]@Counter = make_slice(@Counter, 2)
	s[0] = src                 // index-slice store: RefInc src, RefDec old s[0] (nil)
	println(rt.Refcount(ps))   // 2: src + s[0]
	println(s[0].N)            // 7
	s[0] = make(Counter)       // overwrite: RefDec src
	println(rt.Refcount(ps))   // 1: balanced
}
