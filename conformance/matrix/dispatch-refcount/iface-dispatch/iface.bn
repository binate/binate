import "pkg/builtins/rt"

type Counter struct {
	n int
}

func (c *Counter) num() int {
	return c.n
}

interface Numbered {
	num() int
}

impl *Counter : Numbered

interface Maker {
	mk() (int, @Numbered)
}

type Impl struct {
	iv @Numbered
}

func (im *Impl) mk() (int, @Numbered) {
	return 0, im.iv
}

impl *Impl : Maker

func main() {
	var c @Counter = make(Counter)
	c.n = 42
	var po *uint8 = bit_cast(*uint8, c)
	var src @Numbered = c
	var im @Impl = make(Impl)
	im.iv = src
	var m @Maker = im
	var before int = rt.Refcount(po)
	var x int
