package "main"

import "pkg/builtins/testing"

// GENERATED by conformance/gen-generic-managed-matrix.py — do not edit by hand.
// generic-managed matrix cell — inpkg/iface/balance.
// A managed element held in a generic container gains exactly one ref and is released when the container drops (== before+1, then == before) — no leak, no UAF.
// See ../../README.md.

import "pkg/builtins/rt"

type Counter struct {
	n int
}

func (c *Counter) num() int {
	return c.n
}

interface Numbered {
	num() int
}

impl *Counter : Numbered

type Holder[T any] struct {
	items @[]T
	n     int
}

func New[T any]() @Holder[T] {
	var h @Holder[T] = make(Holder[T])
	h.items = make_slice(T, 4)
	h.n = 0
	return h
}

func Put[T any](h @Holder[T], x T) {
	h.items[h.n] = x
	h.n = h.n + 1
}

func At[T any](h @Holder[T], i int) T {
	return h.items[i]
}

func Count[T any](h @Holder[T]) int {
	return h.n
}

func main() {
	var cc @Counter = make(Counter)
	cc.n = 42
	var po *uint8 = bit_cast(*uint8, cc)
	var src @Numbered = cc
	var h @Holder[@Numbered] = New[@Numbered]()
	var before int = rt.Refcount(po)
	Put[@Numbered](h, src)
	testing.Println(cast(int, rt.Refcount(po) == before + 1))
	testing.Println(At[@Numbered](h, 0).num())
	var drp @Holder[@Numbered] = New[@Numbered]()
	h = drp
	testing.Println(cast(int, rt.Refcount(po) == before))
}
