package "main"

import "pkg/builtins/testing"

// GENERATED by conformance/gen-generic-managed-matrix.py — do not edit by hand.
// generic-managed matrix cell — inpkg/managed-ptr/destroy-populated.
// A POPULATED generic container dropped at a helper's SCOPE EXIT releases its managed element (the Holder dtor RefDec's it) — a distinct cleanup trigger from the balance op's reassignment-destroy; after the helper returns the element refcount is back to baseline (no scope-exit-destroy leak), on every backend and both sites.
// See ../../README.md.

import "pkg/builtins/rt"

type Counter struct {
	n int
}

func fillAndDrop(src @Counter) {
	var h @Holder[@Counter] = New[@Counter]()
	Put[@Counter](h, src)
}

type Holder[T any] struct {
	items @[]T
	n     int
}

func New[T any]() @Holder[T] {
	var h @Holder[T] = make(Holder[T])
	h.items = make_slice(T, 4)
	h.n = 0
	return h
}

func Put[T any](h @Holder[T], x T) {
	h.items[h.n] = x
	h.n = h.n + 1
}

func At[T any](h @Holder[T], i int) T {
	return h.items[i]
}

func Count[T any](h @Holder[T]) int {
	return h.n
}

func main() {
	var src @Counter = make(Counter)
	src.n = 42
	var po *uint8 = bit_cast(*uint8, src)
	var before int = rt.Refcount(po)
	fillAndDrop(src)
	testing.Println(cast(int, rt.Refcount(po) == before))
}
