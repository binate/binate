package "main"

import "pkg/builtins/testing"

// GENERATED by conformance/gen-generic-managed-matrix.py — do not edit by hand.
// generic-managed matrix cell — xpkg/array-of-managed/balance.
// A managed element held in a generic container gains exactly one ref and is released when the container drops (== before+1, then == before) — no leak, no UAF.
// See ../../README.md.

import "pkg/builtins/rt"

import "pkg/gh"

type Counter struct {
	n int
}

func main() {
	var c0 @Counter = make(Counter)
	c0.n = 42
	var c1 @Counter = make(Counter)
	c1.n = 7
	var src [2]@Counter
	src[0] = c0
	src[1] = c1
	var po *uint8 = bit_cast(*uint8, c0)
	var h @gh.Holder[[2]@Counter] = gh.New[[2]@Counter]()
	var before int = rt.Refcount(po)
	gh.Put[[2]@Counter](h, src)
	testing.Println(cast(int, rt.Refcount(po) == before + 1))
	testing.Println(gh.At[[2]@Counter](h, 0)[0].n)
	var drp @gh.Holder[[2]@Counter] = gh.New[[2]@Counter]()
	h = drp
	testing.Println(cast(int, rt.Refcount(po) == before))
}
