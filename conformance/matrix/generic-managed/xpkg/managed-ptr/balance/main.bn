package "main"

// GENERATED by conformance/gen-generic-managed-matrix.py — do not edit by hand.
// generic-managed matrix cell — xpkg/managed-ptr/balance.
// A managed element held in a generic container gains exactly one ref and is released when the container drops (== before+1, then == before) — no leak, no UAF.
// See ../../README.md and plan-matrix-tests-generics-rtti.md.

import "pkg/builtins/rt"

import "pkg/gh"

type Counter struct {
	n int
}

func main() {
	var src @Counter = make(Counter)
	src.n = 42
	var po *uint8 = bit_cast(*uint8, src)
	var h @gh.Holder[@Counter] = gh.New[@Counter]()
	var before int = rt.Refcount(po)
	gh.Put[@Counter](h, src)
	println(cast(int, rt.Refcount(po) == before + 1))
	println(gh.At[@Counter](h, 0).n)
	var drp @gh.Holder[@Counter] = gh.New[@Counter]()
	h = drp
	println(cast(int, rt.Refcount(po) == before))
}
