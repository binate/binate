package "main"

import "pkg/builtins/testing"

// GENERATED by conformance/gen-generic-managed-matrix.py — do not edit by hand.
// generic-managed matrix cell — xpkg/managed-struct/balance.
// A managed element held in a generic container gains exactly one ref and is released when the container drops (== before+1, then == before) — no leak, no UAF.
// See ../../README.md.

import "pkg/builtins/rt"

import "pkg/gh"

type Counter struct {
	n int
}

type Box struct {
	c @Counter
}

func main() {
	var src Box
	src.c = make(Counter)
	src.c.n = 42
	var po *uint8 = bit_cast(*uint8, src.c)
	var h @gh.Holder[Box] = gh.New[Box]()
	var before int = rt.Refcount(po)
	gh.Put[Box](h, src)
	testing.Println(cast(int, rt.Refcount(po) == before + 1))
	testing.Println(gh.At[Box](h, 0).c.n)
	var drp @gh.Holder[Box] = gh.New[Box]()
	h = drp
	testing.Println(cast(int, rt.Refcount(po) == before))
}
