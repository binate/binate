package "main"

// Matrix cell — form=multi-assign (a, n = f()), shape=ident, type=managed-ptr.
// A managed component destructured from a multi-return into an identifier must
// be copy-RefInc'd into the target and the prior occupant RefDec'd (Axiom 5),
// with the call-result tuple temp released at end of statement. Observed via
// the shared object `src` that the callee returns. See ../../README.md.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func idPair(c @Counter) (@Counter, int) {
	return c, 5
}

func main() {
	var src @Counter = make(Counter)
	src.N = 7
	var ps *uint8 = bit_cast(*uint8, src)
	println(rt.Refcount(ps))   // 1: only src
	var a @Counter = make(Counter)
	var n int
	a, n = idPair(src)         // multi-assign ident: a aliases src, old a released
	println(rt.Refcount(ps))   // 2: src + a
	println(n)                 // 5
	println(a.N)               // 7
	a = make(Counter)          // drop a's alias
	println(rt.Refcount(ps))   // 1: balanced
}
