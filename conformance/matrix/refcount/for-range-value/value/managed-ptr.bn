package "main"

// Matrix cell — form=for-range-value, shape=value, type=managed-ptr.
// `for v in coll` loads each element as a BORROW (no RefInc), but `v` is a
// managed scope var (defineVar registers it), so scope cleanup RefDecs it — an
// unbalanced release if the bind didn't acquire. The over-release lands at v's
// SCOPE END, so it must be observed AFTER that scope closes: loopOnce() ranges
// over s and returns; an unbalanced bind over-releases src by one per
// iteration. EXPECTED is the BALANCED result (src unchanged across the loop);
// .xfail.<mode> records where the bug bites. See ../../README.md and
// plan-code-red.md §3.2/§3.4.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func loopOnce(s @[]@Counter) {
	for v in s {
		println(v.N)
	}
}

func main() {
	var src @Counter = make(Counter)
	src.N = 7
	var ps *uint8 = bit_cast(*uint8, src)
	var s @[]@Counter = make_slice(@Counter, 1)
	s[0] = src                 // src held by src + s[0]
	println(rt.Refcount(ps))   // 2
	loopOnce(s)                // ranges + returns; an unbalanced bind over-releases src
	println(rt.Refcount(ps))   // 2 if balanced; 1 if the for-range bind over-released
}
