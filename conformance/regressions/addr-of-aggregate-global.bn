package "main"

// Storing the ADDRESS of an aggregate-typed global — `&structGlobal` /
// `&arrayGlobal`, whose result is a pointer-TO-aggregate — into a pointer
// writes NULL on every backend, across the global-initializer form
// (`var RP *T = &VS`, which `__init` lowers as the assignment `RP = &VS`), the
// plain assignment form (`AP = &AR`), and the short-var form (`q := &VS`).  A
// scalar global address (`&scalarGlobal`, `&arr[i]`) and an aggregate-global
// address bound to a LOCAL via decl-init are all correct — so it is specifically
// the aggregate-pointee addr-of materialized as a stored/bound value.
//
// Cause: `&VS` lowers (gen_expr.bn `genUnary` -> `lookupVar`) to an IsGlobalRef
// pseudo carrying Op=OP_ALLOC and TypeArg=Node (the struct pointee), which
// presents like a composite-literal alloca.  Two sites mishandled it: the
// ident/deref/selector assignment arms (gen_control.bn) gated their
// load-before-store on the dest-type-blind `isStructOrArrayAlloc(rhs)`, so
// `RP = &VS` EmitLoaded the struct VALUE (0) out of the address and stored that;
// and `genShortVar` bound the alloca directly, so `q := &VS` aliased the global
// at the pointee (struct/array) type instead of inferring `*T`.  The load is
// correct when the destination is itself an aggregate (`x = VS` whole-struct
// copy), so the assignment fix is the dest-type-aware `isAggregateAllocToLoad`;
// the short-var fix excludes the IsGlobalRef (an address, not fresh storage).
//
// Sibling of regressions/whole-aggregate-assign + global-aggregate-init, and of
// conformance 551 (scalar &G as rvalue) / 573 (two globals in one instruction).

type Node struct { V int }

var VS Node = Node{}
var RP *Node = &VS         // global-initializer form (via __init's `RP = &VS`)
var AR [2]int = [2]int{}
var AP *([2]int)

func main() {
	// initializer form: RP was set to &VS at package init.
	println(cast(int, bit_cast(int, RP) == bit_cast(int, &VS)))   // 1

	// assignment form: take the address of an array global.
	AP = &AR
	println(cast(int, bit_cast(int, AP) == bit_cast(int, &AR)))   // 1

	// short-var form: `:=` must infer `*Node` and bind the address.
	q := &VS
	println(cast(int, bit_cast(int, q) == bit_cast(int, &VS)))    // 1

	// the real-world consequence: a field write through the pointer reaches VS.
	RP.V = 9
	println(VS.V)                                                 // 9
}
