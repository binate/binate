package "main"

import "pkg/builtins/testing"

// `b = a` for a managed slice copies the 4-word header from a's stack alloca; the
// elision aliases that alloca instead of materializing a private copy.  Both a and b
// must remain valid (correct values, refcounts balanced — no leak / UAF).
func main() {
	var a @[]int = @[]int{4, 5, 6}
	var b @[]int = a
	testing.Println(a[0] + a[1] + a[2]) // 15
	testing.Println(b[0] + b[1] + b[2]) // 15
	testing.Println(b[1]) // 5
}
