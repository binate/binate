package "main"

import "pkg/builtins/testing"

// Raw-pointer aggregate copy `*dst = *src` (the S-adjacent shape the elision aliases)
// and the raw-pointer swap `*p, *q = *q, *p` (which must NOT alias across the store,
// or the swap loses a value).  See plan-native-aggcopy-fusion.md.
type P struct { x int; y int }

func copyp(dst *P, src *P) { *dst = *src }

func swapp(p *P, q *P) { *p, *q = *q, *p }

func main() {
	var a P = P{x: 1, y: 2}
	var b P = P{x: 0, y: 0}
	copyp(&b, &a)
	testing.Println(b.x) // 1
	testing.Println(b.y) // 2

	var c P = P{x: 10, y: 20}
	var d P = P{x: 30, y: 40}
	swapp(&c, &d)
	testing.Println(c.x) // 30
	testing.Println(d.y) // 20
}
