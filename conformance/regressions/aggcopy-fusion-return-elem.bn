package "main"

import "pkg/builtins/testing"

// `return c[i]` loads the element from the managed slice's heap backing, which the
// function-end cleanup RefDecs before the sret copy.  The elision must MATERIALIZE
// that load (its source is heap, not a stack alloca), not alias the freed backing.
func elem(c @[]int, i int) int {
	return c[i]
}

func main() {
	var a @[]int = @[]int{10, 20, 30}
	testing.Println(elem(a, 0)) // 10
	testing.Println(elem(a, 2)) // 30
}
