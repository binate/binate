package "main"

import "pkg/builtins/testing"

// The struct-swap idiom `p, q = q, p` lowers to all-loads-then-all-stores; the
// native aggregate-load-materialization elision (plan-native-aggcopy-fusion.md) must
// NOT alias the load of the source across the store that overwrites it, or the swap
// silently loses a value.  Assert both halves swap.
type P struct { x int; y int }

func main() {
	var p P = P{x: 1, y: 2}
	var q P = P{x: 7, y: 9}
	p, q = q, p
	testing.Println(p.x) // 7
	testing.Println(p.y) // 9
	testing.Println(q.x) // 1
	testing.Println(q.y) // 2
}
