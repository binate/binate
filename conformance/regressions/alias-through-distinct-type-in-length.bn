package "main"

import "pkg/builtins/testing"

// A's length reads a composite of U, which holds A behind a pointer: A reaches itself
// through the distinct type U, not through aliases, so it is no recursive alias
// (type.alias.acyclic) -- in this declaration order as in the other.
type A = [len([2]U{})]uint8

type U struct {
	p *A
}

func main() {
	var a A
	testing.Println(len(a))
}
