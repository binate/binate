package "main"

import "pkg/builtins/testing"

// A compare reads an operand where it is stored, with no copy on the stack, when nothing
// evaluated after it can change it: two 4 MiB globals compare (equal, then unequal at the
// last element) with no stack copy of either.  A left operand followed by a call is compared
// as it was before the call: `ga == bump()` is equal though bump changes ga (to return zeros),
// while `bump2() == ga` sees bump2's change.  Instances of a generic struct compare too (their
// IR type is IR-gen's own), alone, in an array, and as a switch tag with a variable case.

var g1 [1 << 19]int

var g2 [1 << 19]int

var ga [40]int

type Box[T any] struct {
	v [20]int
	p *T
}

type Outer[T any] struct {
	b Box[T]
	n int
}

func bump() [40]int {
	ga[0] = 1
	var r [40]int
	return r
}

func bump2() [40]int {
	ga[0] = 2
	var r [40]int
	return r
}

func b2i(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	testing.Println(b2i(g1 == g2))
	g2[(1 << 19) - 1] = 5
	testing.Println(b2i(g1 == g2))
	testing.Println(b2i(ga == bump()))
	testing.Println(b2i(bump2() == ga))
	var bx Box[int]
	var by Box[int]
	testing.Println(b2i(bx == by))
	by.v[19] = 3
	testing.Println(b2i(bx != by))
	var oa [3]Outer[int]
	var ob [3]Outer[int]
	ob[2].b.v[0] = 1
	testing.Println(b2i(oa == ob))
	switch bx {
	case by:
		testing.Println(9)
	default:
		testing.Println(8)
	}
}
