package "main"

import "pkg/builtins/testing"

// An array comparison past a few leaves is a loop over the elements, leaving at the first
// unequal one: equal arrays compare equal, and arrays differing in the first, a middle or the
// last element compare unequal, at every nesting — a long array in a struct, an array of
// arrays — with `!=` the negation; a float element compares as a float (NaN unequal to itself,
// -0 equal to +0); a char array compares element-wise with a string literal, a switch case
// included; and a comparison repeated in a loop starts over each time.  An array of empty
// structs compares equal whatever its length.

type E struct {}

type P struct {
	x   int
	big [40]int
	f   float64
}

var g1 [1 << 14]int

var g2 [1 << 14]int

var e1 [1 << 16]E

var e2 [1 << 16]E

func b2i(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	testing.Println(b2i(g1 == g2))
	g2[(1 << 14) - 1] = 7
	testing.Println(b2i(g1 == g2))
	testing.Println(b2i(g1 != g2))
	g2[(1 << 14) - 1] = 0
	g2[0] = 1
	testing.Println(b2i(g1 == g2))
	g2[0] = 0
	g2[5000] = -1
	testing.Println(b2i(g1 == g2))
	g2[5000] = 0
	testing.Println(b2i(g1 == g2))

	var n1 [20][20]int
	var n2 [20][20]int
	n2[19][19] = 3
	testing.Println(b2i(n1 == n2))
	n1[19][19] = 3
	testing.Println(b2i(n1 == n2))

	var p1 P
	var p2 P
	testing.Println(b2i(p1 == p2))
	p2.big[39] = 1
	testing.Println(b2i(p1 == p2))
	p2.big[39] = 0
	p2.f = 0.5
	testing.Println(b2i(p1 == p2))

	testing.Println(b2i(e1 == e2))
	testing.Println(b2i(e1 != e2))

	var f1 [20]float64
	var f2 [20]float64
	var nz float64 = 0.0
	nz = -nz
	f2[10] = nz
	testing.Println(b2i(f1 == f2))
	var zero float64 = 0.0
	f1[10] = zero / zero
	testing.Println(b2i(f1 == f1))

	var c [20]char
	for i := 0; i < 20; i++ {
		c[i] = 'a' + cast(char, i)
	}
	testing.Println(b2i(c == "abcdefghijklmnopqrst"))
	testing.Println(b2i("abcdefghijklmnopqrsu" == c))
	var matched int = 0
	switch c {
	case "abcdefghijklmnopqrsu":
		matched = 1
	case "abcdefghijklmnopqrst":
		matched = 2
	}
	testing.Println(matched)

	var equal int = 0
	var a [30]int
	var b [30]int
	for k := 0; k < 3; k++ {
		if k == 2 { b[29] = 1 }
		if a == b { equal = equal + 1 }
	}
	testing.Println(equal)
}
