package "main"

// A blank-var initializer that reads a named package global runs AFTER the
// named var is initialized (blank inits are a source-order tail after the
// dependency-ordered named vars).
var base int = 10
var seen int = 0

func note(v int) int {
	seen = v
	return v
}

var _ = note(base + 5)

func main() {
	println(seen)   // 15
}
