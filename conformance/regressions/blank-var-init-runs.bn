package "main"
import "pkg/builtins/testing"

// Package-level blank-var initializers (`var _ = f()`) run for their side
// effects. Two of them are allowed (blank is never a redeclaration) and neither
// gets a global storage slot (they must not collide).
var log int = 0

func bump() int {
	log = log + 1
	return log
}

var _ = bump()
var _ = bump()

func main() {
	testing.Println(log)   // 2 — both blank initializers ran
}
