package "main"

import "pkg/builtins/testing"
import "pkg/q"

// q's constants take the size, alignment and length of types q's .bni declares
// after them — one whose array length names a later constant, a generic type's
// instance whose definition names a later type — and a later declared type; an
// importer sees their values, not lengths of 0.
var a [q.Z]int8

var b [q.R]int8

func main() {
	testing.Println(len(a), q.A, q.Z2, len(b), q.V, q.G, cast(int, q.K))
}
