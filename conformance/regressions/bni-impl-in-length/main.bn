package "main"

import "pkg/builtins/testing"
import "pkg/q"

// M's length calls H with a *R, which the impl declared after it makes a *J.
type M struct {
	a [len(H(&W))]uint8
}

func H(j *J) [4]int {
	var r [4]int
	return r
}

var W R

impl *R : J

interface J {
	L() int
}

type R struct {
	y int
}

func (r *R) L() int {
	return r.y
}

// q's .bni passes values to functions of interfaces in a constant and in array
// lengths, through its impl and interfaces declared after them; M does in a .bn.
func main() {
	var s [q.S]int
	var n q.N
	var p q.P
	var u q.U
	var m M
	testing.Println(len(s), len(n.a), len(p.a), len(u.a), len(m.a))
}
