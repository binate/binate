package "pkg/q"

// N's length and S call F with a *T, which the impl declared after them makes a
// *I; P's length calls G with a *T as a *B, I's parent; U's widens X, a *I, to a
// *B, a parent declared after it.
type N struct {
	a [len(F(&V))]uint8
}

const S = len(F(&V))

type P struct {
	a [len(G(&V))]uint8
}

type U struct {
	a [len(G(X))]uint8
}

func F(i *I) [3]int

func G(b *B) [2]int

var V T

var X *I

impl *T : I

interface I : B {
	K() int
}

interface B {
	M() int
}

type T struct {
	x int
}

func (t *T) M() int

func (t *T) K() int
