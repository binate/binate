package "main"

import "pkg/builtins/testing"
import "pkg/q"

// q's .bni selects methods of its generic types' instances in constants: one
// whose signature selects a method copied after it, and one on an instance
// whose layout reads the constant.
func main() {
	var sa [q.SA]int
	var sg [q.SG]int
	testing.Println(len(sa), len(sg), len(q.G.a))
}
