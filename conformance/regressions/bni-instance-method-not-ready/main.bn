package "main"

import "pkg/builtins/testing"
import "pkg/q"

// q's .bni, and main below, select methods of their generic types' instances
// in constants: one whose signature selects a method copied after it, beside
// one whose signature reads the constant, and one on an instance whose layout
// reads the constant, declared after the selection here and before it in q.
type Box[X any] struct {
	a [2]X
}

func (b Box[X]) A() [len(B.C())]X {
	var r [len(B.C())]X
	return r
}

func (b Box[X]) C() [3]X {
	var r [3]X
	return r
}

func (b Box[X]) Sz() [SA]X {
	var r [SA]X
	return r
}

var B Box[int]

const SA = len(B.A())

const SG = len(F())

func F() [len(G.Get())]int {
	var r [len(G.Get())]int
	return r
}

type Gen[X any] struct {
	a [SG - 1]X
}

var G Gen[int]

func (g Gen[X]) Get() [3]X {
	var r [3]X
	return r
}

func main() {
	var sa [q.SA]int
	var sg [q.SG]int
	testing.Println(len(sa), len(sg), len(q.G.a), len(q.B.Sz()))
	var ma [SA]int
	var mg [SG]int
	testing.Println(len(ma), len(mg), len(G.a), len(B.Sz()))
}
