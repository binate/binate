package "pkg/q"

// SA selects A on B, whose signature selects C, copied after it; SG's length
// selects Get on G, whose layout reads SG.
type Box[X any] struct {
	a [2]X
}

func (b Box[X]) A() [len(B.C())]X {
	var r [len(B.C())]X
	return r
}

func (b Box[X]) C() [3]X {
	var r [3]X
	return r
}

var B Box[int]

const SA = len(B.A())

const SG = len(F())

type Gen[X any] struct {
	a [SG - 1]X
}

func (g Gen[X]) Get() [3]X {
	var r [3]X
	return r
}

func F() [len(G.Get())]int

var G Gen[int]
