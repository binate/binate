package "main"

import "pkg/builtins/testing"
import "pkg/q"

// Instances built while q's .bni is resolved read types and constants its order
// has not reached: N's, through a pointer while N is resolved, M's, declared
// after N, S, which builds Bx[int64] through a pointer while it is resolved, R,
// declared after V, and N2's through a slice while N2 is resolved.  So do the
// constants SV and SA, whose variable VV and alias A read NV's and NA's layouts
// while they are resolved, and the alias AP.  Each has its layout, not a length
// of 0.
func main() {
	var bn q.Box[q.N]
	var bm q.Box[q.M]
	var bx q.Bx[int64]
	var by q.By[int64]
	testing.Println(len(bn.a) == cast(int, sizeof(q.N)), len(bm.a), cast(int, q.Z) == len(bn.a),
			len(bx.a) == cast(int, sizeof(q.W[int64])), cast(int, q.S) == len(bx.a), len(by.a))
	var bs q.Box[*[]q.N2]
	var bv q.Bv[int64]
	var ba q.Ba[int64]
	var bp q.Bp[int64]
	var a q.A
	var ap q.AP
	testing.Println(len(bs.a) == cast(int, sizeof(*[]q.N2)), len(bv.a) == cast(int, sizeof(q.NV)),
			len(q.VV) == len(bv.a), len(ba.a) == cast(int, sizeof(q.NA)), len(a) == len(ba.a),
			len(bp.a) == cast(int, sizeof(q.NP)), len(ap) == len(bp.a))
}
