package "main"

import "pkg/builtins/testing"
import "pkg/q"

// q's .bni reads members of declarations made after the reads; each length and
// constant has its value, and q's methods are its .bn's.
func main() {
	var nm q.NM
	var sp [q.SP]int
	var nf q.NF
	var sf [q.SF]int
	var ni q.NI
	var si [q.SI]int
	var nl q.NL
	var sl [q.SL]int
	testing.Println(len(nm.a), len(sp), len(nf.a), len(sf), len(ni.a), len(si), len(nl.a), len(sl))
	testing.Println(len(q.VT.M()), len(q.VT.MP()))
}
