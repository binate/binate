package "main"

import "pkg/builtins/testing"
import "pkg/q"

// q's .bni names declarations before they are declared: NV's length a
// variable's, NF's a function's result's, SF a generic function's result's,
// whose length is a later constant, and ST the size of a type holding an
// instance that holds M3, whose length is ST, through a pointer.  Each has its
// value.
func main() {
	var nv q.NV
	var nf q.NF
	var sf [q.SF]int
	var m3 q.M3
	testing.Println(len(nv.a), len(nf.a), len(sf), len(m3.a) == cast(int, q.ST), len(q.F()))
}
