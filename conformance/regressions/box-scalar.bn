package "main"
import "pkg/builtins/testing"

// box() of a bare SCALAR register (not an OP_ALLOC, not an aggregate) must
// heap-copy the value and return a valid managed pointer.  The native aa64/x64
// emitBox fell to a no-emit `else` arm for the scalar case, leaving the OP_BOX
// result undefined → a garbage managed pointer (LLVM + VM already handled it).
// CR-2 follow-up Plan A.

func main() {
	var i int = 42
	var b @int = box(i)
	testing.Println(*b)                  // 42

	var x uint8 = 200
	var bx @uint8 = box(x)
	testing.Println(cast(int, *bx))      // 200
}
