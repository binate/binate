package "main"

import "pkg/builtins/testing"

// A by-value aggregate argument read from its source -- through a pointer, a global, a
// heap element, a field at an odd offset -- is a copy: a callee writing its parameter
// leaves the source as it was, and one writing the source through a pointer leaves its
// parameter as it was, through a direct call, a raw function pointer, a function value,
// a capturing closure and an interface method.  A struct past 16 bytes, and a byte
// array at an odd offset; three arrays read from one source, a float struct passed in
// floating-point registers (an HFA), a value receiver's boxed copy and a managed-slice.
// An argument holds its source's bytes from before a later argument's call changes
// them.  Each line is the callee's view of its parameter's first and last elements,
// then the source's after the call.

type Big struct {
	a [12]int
}

type Bytes [40]uint8

type Odd struct {
	pad uint8
	b   Bytes
}

type Arr [20]int

type H4 struct {
	a float64
	b float64
	c float64
	d float64
}

interface Getter {
	Get(q *Big) int
}

impl Big : Getter

// Get is a value receiver: an interface call passes the boxed Big whole.
func (b Big) Get(q *Big) int { return writeBig(b, q) }

interface Writer {
	WriteBig(x Big, q *Big) int
	WriteBytes(x Bytes, q *Bytes) int
}

type W struct {
	n int
}

impl *W : Writer

func (w *W) WriteBig(x Big, q *Big) int { return writeBig(x, q) + w.n }

func (w *W) WriteBytes(x Bytes, q *Bytes) int { return writeBytes(x, q) + w.n }

var gbig Big

var k0 int

// writeBig writes the source through q, then its parameter, and returns the
// parameter's first and last elements as it found them.
func writeBig(x Big, q *Big) int {
	q.a[0] = 77
	q.a[11] = 77
	var r int = x.a[0] * 100 + x.a[11]
	x.a[0] = 99
	x.a[11] = 99
	return r
}

// writeBytes is writeBig for Bytes.
func writeBytes(x Bytes, q *Bytes) int {
	(*q)[0] = 77
	(*q)[39] = 77
	var r int = cast(int, x[0]) * 100 + cast(int, x[39])
	x[0] = 99
	x[39] = 99
	return r
}

// bump changes the source, as a later argument's call.
func bump(p *Big) int {
	p.a[0] = 55
	return 0
}

func withLater(x Big, n int) int { return x.a[0] * 100 + x.a[11] + n }

// three writes the source through q, then its first two parameters, and returns the
// first elements of all three as it found them.
func three(x Arr, y Arr, z Arr, q *Arr) int {
	(*q)[0] = 5
	x[0] = 9
	y[0] = 8
	return x[0] * 100 + y[0] * 10 + z[0]
}

// writeH is writeBig for H4.
func writeH(x H4, q *H4) int {
	q.a = 77.0
	q.d = 77.0
	var r int = cast(int, x.a) * 100 + cast(int, x.d)
	x.a = 99.0
	return r
}

// msLen replaces the source managed-slice through q and returns its parameter's length.
func msLen(s @[]int, q *@[]int) int {
	*q = make_slice(int, 1)
	return len(s)
}

func reset(b *Big) {
	for i := 0; i < 12; i++ { b.a[i] = i + 1 }
}

func resetBytes(b *Bytes) {
	for i := 0; i < 40; i++ { (*b)[i] = cast(uint8, i + 1) }
}

func show(r int, b *Big) {
	testing.Println(r)
	testing.Println(b.a[0] * 100 + b.a[11])
}

func showBytes(r int, b *Bytes) {
	testing.Println(r)
	testing.Println(cast(int, (*b)[0]) * 100 + cast(int, (*b)[39]))
}

// viaPointer passes *p by every call shape.
func viaPointer(p *Big, wr *Writer) {
	var rp *func(Big, *Big) int = writeBig
	var fv @func(Big, *Big) int = writeBig
	var fc @func(Big, *Big) int = func(x Big, q *Big) int { return writeBig(x, q) + k0 }
	reset(p)
	show(writeBig(*p, p), p)
	reset(p)
	show(rp(*p, p), p)
	reset(p)
	show(fv(*p, p), p)
	reset(p)
	show(fc(*p, p), p)
	reset(p)
	show(wr.WriteBig(*p, p), p)
	reset(p)
	show(withLater(*p, bump(p)), p)
}

// viaGlobal passes the global gbig by every call shape.
func viaGlobal(wr *Writer) {
	var fv @func(Big, *Big) int = writeBig
	reset(&gbig)
	show(writeBig(gbig, &gbig), &gbig)
	reset(&gbig)
	show(fv(gbig, &gbig), &gbig)
	reset(&gbig)
	show(wr.WriteBig(gbig, &gbig), &gbig)
}

// viaHeap passes a heap element.
func viaHeap(hs @[]Big, wr *Writer) {
	var fv @func(Big, *Big) int = writeBig
	var q *Big = &hs[1]
	reset(q)
	show(writeBig(hs[1], q), q)
	reset(q)
	show(fv(hs[1], q), q)
	reset(q)
	show(wr.WriteBig(hs[1], q), q)
}

// viaOddField passes a byte array at offset 1 of a struct reached through a pointer.
func viaOddField(po *Odd, wr *Writer) {
	var rp *func(Bytes, *Bytes) int = writeBytes
	var fv @func(Bytes, *Bytes) int = writeBytes
	var fc @func(Bytes, *Bytes) int = func(x Bytes, q *Bytes) int { return writeBytes(x, q) + k0 }
	var q *Bytes = &po.b
	resetBytes(q)
	showBytes(writeBytes(po.b, q), q)
	resetBytes(q)
	showBytes(rp(po.b, q), q)
	resetBytes(q)
	showBytes(fv(po.b, q), q)
	resetBytes(q)
	showBytes(fc(po.b, q), q)
	resetBytes(q)
	showBytes(wr.WriteBytes(po.b, q), q)
}

func main() {
	var w W
	var wr *Writer = &w
	var hs @[]Big = make_slice(Big, 2)
	viaPointer(&hs[0], wr)
	viaGlobal(wr)
	viaHeap(hs, wr)
	var o @Odd = make(Odd)
	viaOddField(o, wr)
	viaMore()
}

// viaMore passes three arrays read from one source (directly and through a function
// value), an HFA from a heap element (directly, through a function value and a
// closure), a value receiver's boxed copy and a managed-slice.
func viaMore() {
	var as @[]Arr = make_slice(Arr, 1)
	var ap *Arr = &as[0]
	(*ap)[0] = 1
	testing.Println(three(*ap, *ap, *ap, ap))
	testing.Println((*ap)[0])
	(*ap)[0] = 1
	var tv @func(Arr, Arr, Arr, *Arr) int = three
	testing.Println(tv(*ap, *ap, *ap, ap))
	testing.Println((*ap)[0])
	var hs @[]H4 = make_slice(H4, 2)
	var hp *H4 = &hs[1]
	var hv @func(H4, *H4) int = writeH
	var hc @func(H4, *H4) int = func(x H4, q *H4) int { return writeH(x, q) + k0 }
	hp.a = 1.0
	hp.d = 4.0
	testing.Println(writeH(*hp, hp))
	hp.a = 1.0
	hp.d = 4.0
	testing.Println(hv(*hp, hp))
	hp.a = 1.0
	hp.d = 4.0
	testing.Println(hc(*hp, hp))
	testing.Println(cast(int, hp.a) * 100 + cast(int, hp.d))
	var big Big
	reset(&big)
	var g *Getter = &big
	show(g.Get(&big), &big)
	var ms @[]int = make_slice(int, 3)
	var mp *@[]int = &ms
	testing.Println(msLen(*mp, mp))
	testing.Println(len(ms))
}
