package "main"

// __c_call to libc `int abs(int)` with a negative scalar arg. C `int`
// is 32-bit on all our targets, so spelled int32. Self-contained:
// libc is already linked, no extra link object needed.

func main() {
	var r int32 = __c_call("abs", int32, cast(int32, -42))
	println(cast(int, r))
}
