package "main"
import "pkg/builtins/testing"

// abs() on already-non-negative and zero inputs: the C function must
// be a real call (not folded), so a positive value and zero come back
// unchanged. Two __c_call sites to the same symbol exercise the
// per-module declare-dedup (emit_ccall.bn:139 cCallSymbolSeen).

func main() {
	var a int32 = __c_call("abs", int32, cast(int32, 7))
	var b int32 = __c_call("abs", int32, cast(int32, 0))
	testing.Println(cast(int, a))
	testing.Println(cast(int, b))
}
