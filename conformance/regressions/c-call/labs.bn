package "main"
import "pkg/builtins/testing"

// __c_call to libc `long labs(long)`. C `long` is the target word
// width (64-bit on a 64-bit host), which is Binate's `int` — so both
// the arg and return are spelled `int`, NOT int32. This pins the
// word-width arg/return shape (distinct from abs's int32 shape) and
// catches any place that hardcodes 32-bit for C-call scalars.

func main() {
	var r int = __c_call("labs", int, cast(int, -1000000))
	testing.Println(cast(int, r))
}
