package "main"

// §3.9 variadic-FLOAT case: printf("%.0f", (double)2.0). A variadic
// float arg is the ABI edge where backends diverge: x64-SysV must set
// AL = number-of-vector-args (so the vararg double goes in XMM0 with
// AL>=1), while darwin-arm64 forces every vararg onto the stack as an
// 8-byte slot. float64 IS a C-ABI-passable __c_call arg
// (check_builtin.bn:238 isCCompatibleArgType accepts IsFloat).
// printf promotes float->double, so float64 is the right Binate type.
// Self-contained: libc printf, no link object. Prints `2` to stdout.

func main() {
	var fmt [6]char
	fmt[0] = '%'
	fmt[1] = '.'
	fmt[2] = '0'
	fmt[3] = 'f'
	fmt[4] = '\n'
	fmt[5] = '\0'
	var fmtPtr *uint8 = bit_cast(*uint8, &fmt[0])
	var n int32 = __c_call("printf", int32, fmtPtr, ..., cast(float64, 2.0))
	if n < 0 { println("printf error") }
}
