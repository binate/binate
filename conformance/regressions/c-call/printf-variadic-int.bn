package "main"
import "pkg/builtins/testing"

// Variadic __c_call: libc `int printf(const char *, ...)` with ONE
// variadic int arg. The `...` token marks the fixed/variadic boundary
// (fmtPtr is fixed; the int is variadic). Exercises the varargs
// LLVM signature `(i8*, ...)` (emit_ccall.bn:52-64). On x64-SysV this
// is the AL=0 (no vector args) vararg path; on darwin-arm64 the
// vararg goes on the stack. Asserts stdout via the printed digits.

func main() {
	var fmt [4]char
	fmt[0] = '%'
	fmt[1] = 'd'
	fmt[2] = '\n'
	fmt[3] = '\0'
	var fmtPtr *uint8 = bit_cast(*uint8, &fmt[0])
	var n int32 = __c_call("printf", int32, fmtPtr, ..., cast(int32, 99))
	if n < 0 { testing.Println("printf error") }
}
