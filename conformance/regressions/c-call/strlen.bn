package "main"

// __c_call to libc `size_t strlen(const char *)`. Exercises the
// POINTER argument path (the other half of the v1 contract): a local
// [N]char filled byte-by-byte, address-of element 0 bit_cast to
// *uint8 for C's `const char *`. Return is the word-width count, so
// `int`. Self-contained — no link object, libc provides strlen.

func main() {
	var s [6]char
	s[0] = 'h'
	s[1] = 'e'
	s[2] = 'l'
	s[3] = 'l'
	s[4] = 'o'
	s[5] = '\0'
	var p *uint8 = bit_cast(*uint8, &s[0])
	var n int = __c_call("strlen", int, p)
	println(cast(int, n))
}
