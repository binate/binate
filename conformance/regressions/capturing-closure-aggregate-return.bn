package "main"
import "pkg/builtins/testing"

// A CAPTURING closure (`@func` carrying an environment) returning a SINGLE
// aggregate result must materialize that result through the caller's
// retbuf on every backend.  The closure shim rides the same retbuf-in-X0
// (LLVM: `void(retbuf, data, ...)`) caller convention the non-capturing
// shim uses, for both aggregate shapes:
//   * pack-return (1..16 bytes): result comes back packed, copied through
//     the retbuf;
//   * sret-return (>16 bytes): result written through the indirect-result
//     pointer (aa64 X8).
//
// Before the fix the LLVM closure shim had no aggregate branch (returned
// the aggregate by value against a retbuf-typed vtable slot → garbage /
// crash), and the native aa64 closure shim was scalar-only (read retbuf as
// the data pointer; the sret shape left X8 null → SIGSEGV).  Distinct from
// `capturing-closure-multi-return`, which covers the multi-return tuple
// shapes (a different caller convention).  Green on LLVM, VM, and native.

type P1 struct {
	a int
}

type P2 struct {
	a int
	b int
}

type P3 struct {
	a int
	b int
	c int
}

type P4 struct {
	a int
	b int
	c int
	d int
}

func main() {
	var n int = 5

	// pack-return, 8 bytes (one word).
	var f1 @func() P1 = func() P1 { return P1{a: n * 8} }
	var p1 P1 = f1()
	testing.Println(p1.a)        // 40

	// pack-return, 16 bytes (two words).
	var f2 @func() P2 = func() P2 { return P2{a: n, b: n * 2} }
	var p2 P2 = f2()
	testing.Println(p2.a)        // 5
	testing.Println(p2.b)        // 10

	// sret-return, 24 bytes.
	var f3 @func() P3 = func() P3 { return P3{a: n + 15, b: n + 16, c: n + 17} }
	var p3 P3 = f3()
	testing.Println(p3.a)        // 20
	testing.Println(p3.b)        // 21
	testing.Println(p3.c)        // 22

	// sret-return with a user arg (captures prepend, arg follows).
	var f3a @func(int) P3 = func(m int) P3 { return P3{a: n, b: m, c: n + m} }
	var p3a P3 = f3a(7)
	testing.Println(p3a.a)       // 5
	testing.Println(p3a.b)       // 7
	testing.Println(p3a.c)       // 12

	// sret-return, 32 bytes.
	var f4 @func() P4 = func() P4 {
		return P4{a: n, b: n + 1, c: n + 2, d: n + 3}
	}
	var p4 P4 = f4()
	testing.Println(p4.a)        // 5
	testing.Println(p4.b)        // 6
	testing.Println(p4.c)        // 7
	testing.Println(p4.d)        // 8

	// managed-slice return (sret, managed result).
	var f5 @func() @[]int = func() @[]int { return make_slice(int, n) }
	var s @[]int = f5()
	testing.Println(len(s))      // 5
}
