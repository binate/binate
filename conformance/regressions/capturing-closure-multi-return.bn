package "main"

// A CAPTURING closure (`@func` carrying an environment) that returns a
// MULTI-RETURN tuple reads the result components from the wrong location on
// the LLVM backend → garbage (a managed component → crash). Non-capturing
// func-value multi-return works (the named-func form), and a capturing closure
// with a SINGLE return works; only {capturing closure} × {multi-return} breaks.
// VM + native are correct — LLVM-codegen-only.
func main() {
	var n int = 42
	var f @func() (int, int) = func() (int, int) { return n, n + 1 }
	var a int
	var b int
	a, b = f()
	println(a)
	println(b)
}
