package "main"

// A CAPTURING closure (`@func` carrying an environment) returning a
// MULTI-RETURN tuple must read its result through the retbuf shim ABI on
// the LLVM backend.  Before the fix, emit_funcvals_closure.bn's shim had
// no aggregate-return branch: it returned the tuple BY VALUE while the
// vtable advertised the `void(i8*, i8*)` retbuf shape (funcSignatureLLVM
// → isAggregateReturn), so the call site read a buffer the shim never
// wrote → garbage (a managed component → crash).  Each case below is a
// distinct sub-shape of that multi-return bug.  A non-capturing
// func-value multi-return, and a capturing closure with a SINGLE scalar
// return, both already worked.  VM + native were correct — this pinned
// the LLVM-codegen-only defect.

func main() {
	var n int = 42

	// (a) plain multi-return tuple {int, int} (register path).
	var f @func() (int, int) = func() (int, int) { return n, n + 1 }
	var a int
	var b int
	a, b = f()
	println(a)         // 42
	println(b)         // 43

	// (b) multi-return with a MANAGED component {int, @[]int} — the
	//     pre-fix garbage managed pointer crashed on cleanup.
	var g @func() (int, @[]int) = func() (int, @[]int) {
		return n, make_slice(int, n)
	}
	var c int
	var s @[]int
	c, s = g()
	println(c)         // 42
	println(len(s))    // 42

	// (c) aggregate user-arg combined with multi-return.
	var k @func(@[]int) (int, int) = func(arg @[]int) (int, int) {
		return n + len(arg), n - len(arg)
	}
	var arg @[]int = make_slice(int, 3)
	var d int
	var e int
	d, e = k(arg)
	println(d)         // 45
	println(e)         // 39
}
