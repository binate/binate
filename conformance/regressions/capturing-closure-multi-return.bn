package "main"
import "pkg/builtins/testing"

// A CAPTURING closure (`@func` carrying an environment) returning a
// MULTI-RETURN tuple must read its result through the retbuf shim ABI on
// the LLVM backend.  The vtable advertises the `void(i8*, i8*)` retbuf
// shape (funcSignatureLLVM → isAggregateReturn), so a shim with no
// aggregate-return branch, returning the tuple BY VALUE, leaves the call
// site reading a buffer the shim never wrote → garbage (a managed
// component → crash).  Each case below is a distinct multi-return
// sub-shape.  A non-capturing func-value multi-return and a capturing
// closure with a SINGLE scalar return take other paths.  The native
// backends' closure shims use the same retbuf convention (the caller passes
// a retbuf for every multi-return), so the native modes exercise it too.

func main() {
	var n int = 42

	// (a) plain multi-return tuple {int, int} (register path).
	var f @func() (int, int) = func() (int, int) { return n, n + 1 }
	var a int
	var b int
	a, b = f()
	testing.Println(a)         // 42
	testing.Println(b)         // 43

	// (b) multi-return with a MANAGED component {int, @[]int} — a
	//     garbage managed pointer here crashes on cleanup.
	var g @func() (int, @[]int) = func() (int, @[]int) {
		return n, make_slice(int, n)
	}
	var c int
	var s @[]int
	c, s = g()
	testing.Println(c)         // 42
	testing.Println(len(s))    // 42

	// (c) aggregate user-arg combined with multi-return.
	var k @func(@[]int) (int, int) = func(arg @[]int) (int, int) {
		return n + len(arg), n - len(arg)
	}
	var arg @[]int = make_slice(int, 3)
	var d int
	var e int
	d, e = k(arg)
	testing.Println(d)         // 45
	testing.Println(e)         // 39
}
