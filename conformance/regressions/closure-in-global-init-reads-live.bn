package "main"
import "pkg/builtins/testing"

// A closure stored in a package-var initializer must read other globals LIVE,
// not snapshot them: `reader` is created during __init, but calling it later
// reads `seed`'s initialized value (7), not the pre-init zero.
var reader *func() int = func() int { return seed }
var seed int = 7

func main() {
	testing.Println(reader())   // 7
	seed = 42
	testing.Println(reader())   // 42 — live
}
