package "main"

// A globals-only closure returned as an @func (managed/heap flavour) must read
// the global live after its creating frame is gone — the reclassified path the
// "don't capture globals" fix creates (empty Captures => nil-data managed func
// value rather than a heap-captured closure struct).
var counter int = 10

func makeReader() @func() int {
	return func() int { return counter }
}

func main() {
	var read @func() int = makeReader()
	println(read())   // 10
	counter = 20
	println(read())   // 20 — live, after makeReader's frame is gone
	counter = 33
	println(read())   // 33
}
