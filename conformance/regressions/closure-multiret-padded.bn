package "main"
import "pkg/builtins/testing"

// A CAPTURING closure returning a register-returned PADDED multi-return tuple must
// spell the flat coerced FCA boundary in its shim (matching the coerced callee
// `define`), or LLVM gives the `[N x i8]` padding member its own return register
// and the wide field is read from the wrong slot.  Regression for the closure-shim
// gap d72f7154 left: it coerced the callee define + the FUNC-VALUE shim, but not
// emitClosureShimAggregate — so a capturing closure returning (int32, int64)
// silently returned garbage for the int64 (a wrong-slot read gave 32, not
// 7000000000).  Covers BOTH pad positions — interior pad before the int64 in
// (int32, int64), and trailing pad after the int32 in (int64, int32) — via a direct
// call, a non-capturing func-value, and a capturing closure.  The int64 (7000000000
// > 2^32, so a wrong-slot / truncated read misses it) is checked via `yn(... ==
// cast(int64, ...))` rather than printed through `cast(int, ...)`, so the test is
// ILP32-portable (arm32 `int` is 32-bit); the int32 (42) prints directly.

var g32 int32 = cast(int32, 42)
var gBig int64 = cast(int64, 7000000000)

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func directA() (int32, int64) {
	return g32, gBig
}

func directB() (int64, int32) {
	return gBig, g32
}

func main() {
	var n32 int32 = cast(int32, 42)
	var big int64 = cast(int64, 7000000000)

	// --- (int32, int64): interior pad before the int64 ---
	var d1 int32
	var d2 int64
	d1, d2 = directA() // direct call (control)
	testing.Println(cast(int, d1))                     // 42
	testing.Println(yn(d2 == cast(int64, 7000000000))) // 1

	var fvA *func() (int32, int64) = directA
	var f1 int32
	var f2 int64
	f1, f2 = fvA() // non-capturing func-value (control)
	testing.Println(cast(int, f1))                     // 42
	testing.Println(yn(f2 == cast(int64, 7000000000))) // 1

	var clA @func() (int32, int64) = func() (int32, int64) { return n32, big }
	var c1 int32
	var c2 int64
	c1, c2 = clA() // CAPTURING closure (the regression)
	testing.Println(cast(int, c1))                     // 42
	testing.Println(yn(c2 == cast(int64, 7000000000))) // 1

	// --- (int64, int32): trailing pad after the int32 ---
	var e1 int64
	var e2 int32
	e1, e2 = directB() // direct call (control)
	testing.Println(yn(e1 == cast(int64, 7000000000))) // 1
	testing.Println(cast(int, e2))                     // 42

	var clB @func() (int64, int32) = func() (int64, int32) { return big, n32 }
	var b1 int64
	var b2 int32
	b1, b2 = clB() // CAPTURING closure, trailing pad
	testing.Println(yn(b1 == cast(int64, 7000000000))) // 1
	testing.Println(cast(int, b2))                     // 42
}
