package "main"

// A CAPTURING closure with a MULTI-RETURN result, called INDIRECTLY through a
// func-value parameter (callSmall / callBig receive the value and call it, so
// the call site cannot devirtualize to a direct call to the underlying) — this
// forces the native-arm32 capturing-closure multi-return SHIM (P4-d Phase C.3)
// to run at RUNTIME, not merely be emitted.  Covers BOTH shapes: a small
// tuple (2 GP words -> pack, field-per-register store) and a big tuple (int +
// @[]int = 5 GP words -> sret, retbuf).  A capture (n) is read through the
// shim's capture-load path.

func callSmall(fn @func() (int, int)) (int, int) {
	return fn()
}

func callBig(fn @func() (int, @[]int)) (int, @[]int) {
	return fn()
}

func main() {
	var n int = 10

	// Small multi-return: (int, int) -> 2 GP words -> pack (field-per-register
	// store through the retbuf); the closure captures n.
	var f @func() (int, int) = func() (int, int) { return n, n * 2 }
	var a int
	var b int
	a, b = callSmall(f)
	println(a) // 10
	println(b) // 20

	// Big multi-return: (int, @[]int) -> 1 + 4 = 5 GP words -> sret (the
	// underlying writes the whole tuple through the R0 retbuf).
	var g @func() (int, @[]int) = func() (int, @[]int) { return n + 1, make_slice(int, n) }
	var c int
	var s @[]int
	c, s = callBig(g)
	println(c) // 11
	println(len(s)) // 10
}
