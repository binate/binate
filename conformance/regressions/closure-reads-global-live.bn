package "main"

// A closure that references a package-level global must READ IT LIVE (from the
// global's storage), not capture a snapshot at closure-creation.  An ordinary
// function reads globals live; a closure must agree.
var counter int = 10

func makeReader() *func() int {
	return func() int { return counter }
}

func main() {
	var read *func() int = makeReader()
	println(read())   // 10
	counter = 20
	println(read())   // 20 — live read, not a snapshot of 10
	counter = 33
	println(read())   // 33
}
