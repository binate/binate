package "main"
import "pkg/builtins/testing"

// A closure reading a MANAGED global borrows it live from static storage; it
// must not capture (copy) it, and reading it must stay refcount-balanced.
var data @[]int = make_slice(int, 3)

func sumFirstTwo() *func() int {
	return func() int { return data[0] + data[1] }
}

func main() {
	data[0] = 4
	data[1] = 5
	data[2] = 6
	var f *func() int = sumFirstTwo()
	testing.Println(f())        // 9
	data[0] = 40
	testing.Println(f())        // 45 — live read of the managed global
}
