package "main"

// A relational op (`<` `<=` `>` `>=`) with an untyped int literal on the LEFT
// against a SIGNED int used to lower to an UNSIGNED compare — so `5 < s` with
// s == -1 wrongly returned true (the signed -1 read as a huge unsigned).  The
// literal kept its TYP_UNTYPED_INT type (Signed=false) into codegen because
// ensureWidth skips the retype at equal width; IR-gen now stamps the resolved
// concrete (signed) type onto the untyped operand, so the compare is signed
// regardless of operand order.  The unsigned cells confirm genuine unsigned
// comparisons stay unsigned.

func main() {
	// int, literal on the LEFT, against a negative value.
	var s int = -1
	println(cast(int, 5 < s))  // 0
	println(cast(int, 5 <= s)) // 0
	println(cast(int, 5 > s))  // 1
	println(cast(int, 5 >= s)) // 1
	// int, var on the LEFT (always was correct) — guard against regressions.
	println(cast(int, s < 5)) // 1
	println(cast(int, s > 5)) // 0

	// Sub-word signed widths, literal on the LEFT, negative value.
	var s32 int32 = cast(int32, -1)
	println(cast(int, 5 < s32)) // 0
	var s8 int8 = cast(int8, -1)
	println(cast(int, 5 < s8)) // 0

	// Unsigned must STAY unsigned: max uint > any small literal.
	var u uint = cast(uint, 0) - cast(uint, 1) // all ones
	println(cast(int, 5 < u))                  // 1
	println(cast(int, u > cast(uint, 5)))      // 1
	// And a small unsigned: 10 < 5 is false (unsigned, no wraparound).
	var v uint = cast(uint, 5)
	println(cast(int, 10 < v)) // 0
}
