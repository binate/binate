package "main"
import "pkg/builtins/testing"

// Passing a plain (no-managed-field) struct/array COMPOSITE LITERAL by value to a
// function must pass the VALUE — `dist(Pt{a:3,b:4})` is 7, `asum([2]int{5,6})` is
// 11.  A compiled backend must load the aggregate value out of the composite's
// alloca before the call, as the assignment arms do; passing the alloca POINTER
// instead makes the callee read pointer bits as the field/element values → silent
// garbage on idiomatic code.  (The VM carries aggregates by address.)
type Pt struct {
	a int
	b int
}

func dist(p Pt) int {
	return p.a + p.b
}

func asum(a [2]int) int {
	return a[0] + a[1]
}

func main() {
	testing.Println(dist(Pt{a: 3, b: 4}))   // 7
	testing.Println(asum([2]int{5, 6}))     // 11
}
