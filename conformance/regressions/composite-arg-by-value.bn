package "main"
import "pkg/builtins/testing"

// Passing a plain (no-managed-field) struct/array COMPOSITE LITERAL by value to a
// function must pass the VALUE — `dist(Pt{a:3,b:4})` is 7, `asum([2]int{5,6})` is
// 11.  On LLVM and the native backends the caller instead passes the composite's
// alloca POINTER, so the callee reads pointer bits as the field/element values →
// silent garbage on idiomatic code.  The VM is correct (it carries aggregates by
// address).  xfailed on the LLVM-exec + native modes pending the by-value-arg fix
// (load the aggregate value out of the composite alloca before the call, like the
// assignment arms do).  See claude-todo.md.
type Pt struct {
	a int
	b int
}

func dist(p Pt) int {
	return p.a + p.b
}

func asum(a [2]int) int {
	return a[0] + a[1]
}

func main() {
	testing.Println(dist(Pt{a: 3, b: 4}))   // 7
	testing.Println(asum([2]int{5, 6}))     // 11
}
