package "main"
import "pkg/builtins/testing"

// Known bug (claude-todo const-expr non-int dropped): a const used as an array dimension. Checker
// evalConstInt (checker_util.bn:79) returns 0 for a SYM_CONST ident
// (lines 86-90) instead of the const's value; IR resolveTypeExpr
// array branch (gen_util.bn:354-359) uses parseIntLit(te.Len.Name)
// which on the ident text "N" yields 0/garbage, not 3. So `[N]int`
// resolves to a zero-length (or wrong-length) array.
//
// If correct: len(a) for `[N]int` with N=3 is 3.

const N int = 3

func main() {
	var a [N]int
	testing.Println(cast(int, len(a)))
}
