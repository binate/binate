package "main"
import "pkg/builtins/testing"

// A const used as an array dimension: the checker and IR-gen must both evaluate
// the SYM_CONST ident `N` to the const's value (not 0, nor the ident text parsed
// as an integer literal), so `[N]int` with N=3 has length 3 rather than being a
// zero-length (or wrong-length) array.

const N int = 3

func main() {
	var a [N]int
	testing.Println(cast(int, len(a)))
}
