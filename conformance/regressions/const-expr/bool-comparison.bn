package "main"
import "pkg/builtins/testing"

// Known bug (claude-todo const-expr non-int dropped): a const whose initializer is a COMPARISON. The
// checker accepts it (checkBinaryOp returns TYP_UNTYPED_BOOL,
// check_expr.bn:262-268), but IR-gen: classifyConstLit sees
// EXPR_BINARY (not a bool LITERAL) -> false; evalConstExpr has no
// comparison op in its table (gen_const.bn:114-139 only +,-,*,/,%,
// &,|,^,<<,>>) -> (0,false); genConst drops the const. Read site for
// the bool ident then emits EmitConstInt(0, int) (gen_expr.bn:86) --
// an int 0, not a bool. cast(int, <bool>) of a true value should be 1.
//
// If folding were correct: 1 < 2 is true -> cast(int, T) = 1, and
// 5 > 9 is false -> cast(int, F) = 0.

const T bool = 1 < 2
const F bool = 5 > 9

func main() {
	testing.Println(cast(int, T))
	testing.Println(cast(int, F))
}
