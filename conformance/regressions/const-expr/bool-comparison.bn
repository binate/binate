package "main"
import "pkg/builtins/testing"

// A const whose initializer is a COMPARISON (an untyped-bool expression): IR-gen
// must fold it to a bool constant — a const it fails to fold is dropped, and the
// read site then emits an int 0, not a bool.
// 1 < 2 is true -> cast(int, T) = 1, and 5 > 9 is false -> cast(int, F) = 0.

const T bool = 1 < 2
const F bool = 5 > 9

func main() {
	testing.Println(cast(int, T))
	testing.Println(cast(int, F))
}
