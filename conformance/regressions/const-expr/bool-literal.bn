package "main"
import "pkg/builtins/testing"

// Baseline: a bare bool-literal const registers as CONST_BOOL
// (classifyConstLit, gen_const.bn:209-212) and reads back via
// EmitConstBool. Contrast with bool-const-comparison-BROKEN to prove
// only the computed (binary) bool form is broken.

const YES bool = true
const NO bool = false

func main() {
	testing.Println(cast(int, YES))
	testing.Println(cast(int, NO))
}
