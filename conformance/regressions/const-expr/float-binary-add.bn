package "main"
import "pkg/builtins/testing"

// Known bug (claude-todo const-expr non-int dropped): a top-level const whose initializer is a BINARY
// float expression. classifyConstLit (gen_const.bn:207) only matches
// a bare/negated float LITERAL, so `1.5 + 2.5` (EXPR_BINARY) falls to
// the integer-only evalConstExpr (gen_const.bn:66), whose float-lit
// operand returns (0,false); genConst then drops the const
// (gen_const.bn:245 `return` without append). The read site finds no
// moduleConsts entry and emits EmitConstInt(0, int) (gen_expr.bn:86)
// -- an integer 0 where a float64 is required: invalid IR.
//
// If folding were correct: 1.5+2.5 = 4.0 -> cast(int,...) = 4.
// Contrast conformance/280_float_arith.bn, where the SAME expression
// in a LOCAL var initializer compiles fine (genBinary, not the const
// path).

const SUM float64 = 1.5 + 2.5

func main() {
	testing.Println(cast(int, SUM))
}
