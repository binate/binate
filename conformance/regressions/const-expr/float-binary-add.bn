package "main"
import "pkg/builtins/testing"

// A top-level const whose initializer is a BINARY float expression must fold to
// a float constant.  Folded as an integer instead, the const is dropped and the
// read site emits an integer 0 where a float64 is required: invalid IR.
// 1.5+2.5 = 4.0 -> cast(int,...) = 4.
// Contrast conformance/280_float_arith.bn, the SAME expression in a LOCAL var
// initializer (genBinary, not the const path).

const SUM float64 = 1.5 + 2.5

func main() {
	testing.Println(cast(int, SUM))
}
