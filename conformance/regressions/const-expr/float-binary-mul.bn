package "main"
import "pkg/builtins/testing"

// Bit-exact form of a binary float const (the float-binary-add path), exposed via
// bit_cast so the exact pattern is observable rather than relying on
// truncation. 0.5 * 0.5 = 0.25; float64(0.25) bit pattern =
// 0x3FD0000000000000, so the four 16-bit lanes below print 0/0/0/16336 (0x3FD0).

const Q float64 = 0.5 * 0.5

func main() {
	testing.Println(cast(int, (bit_cast(uint64, Q)) & 0xFFFF))
	testing.Println(cast(int, ((bit_cast(uint64, Q)) >> 16) & 0xFFFF))
	testing.Println(cast(int, ((bit_cast(uint64, Q)) >> 32) & 0xFFFF))
	testing.Println(cast(int, ((bit_cast(uint64, Q)) >> 48) & 0xFFFF))
}
