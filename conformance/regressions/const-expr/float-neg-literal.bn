package "main"
import "pkg/builtins/testing"

// Regression baseline for the WORKING float const forms: a bare float
// literal and a unary-minus float literal are matched by
// classifyConstLit/floatConstText (gen_const.bn:185-197) and register
// as CONST_FLT. These must keep working (they are the contrast case
// that proves only the BINARY float form is broken).
//
// cast(int, 3.75) = 3 ; cast(int, -3.75) = -3 (truncate toward zero).

const P float64 = 3.75
const N float64 = -3.75

func main() {
	testing.Println(cast(int, P))
	testing.Println(cast(int, N))
}
