package "main"
import "pkg/builtins/testing"

// Regression baseline: integer const-EXPRESSION folding through the
// evalConstExpr path (gen_const.bn:66) for + - * / % and unary minus.
// All fold correctly today.

const A int = 7 + 5
const B int = 20 - 6
const C int = 6 * 4
const D int = 100 / 7
const E int = 100 % 7
const F int = -9 + 50

func main() {
	testing.Println(cast(int, A))
	testing.Println(cast(int, B))
	testing.Println(cast(int, C))
	testing.Println(cast(int, D))
	testing.Println(cast(int, E))
	testing.Println(cast(int, F))
}
