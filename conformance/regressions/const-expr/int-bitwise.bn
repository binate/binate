package "main"

// Integer const bitwise + shift folding: & | ^ << >> via
// evalConstExpr (gen_const.bn:134-138). Checker folds the same
// via foldIntBitwise (check_expr_constfold.bn:84).

const A int = 0xF0 & 0x3C
const B int = 0x30 | 0x0C
const C int = 0xFF ^ 0x0F
const D int = 1 << 5
const E int = 1024 >> 3

func main() {
	println(cast(int, A))
	println(cast(int, B))
	println(cast(int, C))
	println(cast(int, D))
	println(cast(int, E))
}
