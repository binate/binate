package "main"

// const-of-const: a later const references an earlier one in an
// expression. Works because consts register in source order
// (gen_module.bn:244-251) and evalConstExpr resolves the ref via
// lookupConst (gen.bn:369).

const BASE int = 10
const NEXT int = BASE + 1
const DOUBLE int = BASE * 2
const CHAIN int = NEXT + DOUBLE

func main() {
	println(cast(int, BASE))
	println(cast(int, NEXT))
	println(cast(int, DOUBLE))
	println(cast(int, CHAIN))
}
