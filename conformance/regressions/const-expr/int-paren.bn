package "main"
import "pkg/builtins/testing"

// Parenthesized integer const-exprs. Parens are transparent
// (parse_primary.bn:172-177 returns the inner expr; no EXPR_PAREN
// node), so grouping comes purely from precedence and the result
// folds through evalConstExpr unchanged.

const A int = (1 + 2) * 3
const B int = 1 + 2 * 3
const C int = (10 - 4) / 2
const D int = ((4 + 1) << 2) - 3

func main() {
	testing.Println(cast(int, A))
	testing.Println(cast(int, B))
	testing.Println(cast(int, C))
	testing.Println(cast(int, D))
}
