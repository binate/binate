package "main"

// Asserts Go-style iota-repeat: a bare const-group member repeats the previous
// initializer EXPRESSION with its own iota — so `1 << iota` is the bit-flag
// idiom yielding 1,2,4,8. Currently a bare member takes PLAIN iota (1,1,2,3) —
// claude-todo / plan-cr-p2-1 (iota-repeat), Plan 1 defect.

const (
	B0 int = 1 << iota
	B1
	B2
	B3
)

func main() {
	println(cast(int, B0))
	println(cast(int, B1))
	println(cast(int, B2))
	println(cast(int, B3))
}
