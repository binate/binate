package "main"
import "pkg/builtins/testing"

// Asserts Go-style iota-repeat: a bare const-group member repeats the previous
// initializer EXPRESSION with its own iota — so `1 << iota` is the bit-flag
// idiom yielding 1, 2, 4, 8 at runtime.

const (
	B0 int = 1 << iota
	B1
	B2
	B3
)

func main() {
	testing.Println(cast(int, B0))
	testing.Println(cast(int, B1))
	testing.Println(cast(int, B2))
	testing.Println(cast(int, B3))
}
