package "main"
import "pkg/builtins/testing"

// A bare const-group member that INHERITS a narrow type must be range-checked at
// that inherited width, exactly like the explicit form.  Here B8 = 1<<8 = 256
// inherits `uint8` from B0, which overflows — `const B8 uint8 = 256` is rejected
// ("cannot assign untyped int to uint8"), so this group must be rejected too.
// It is currently ACCEPTED (checker doesn't thread the inherited type into the
// synthesized repeat decl), and IR-gen then truncates B8 to 0 — a silent
// wrong-value miscompile on compiler-accepted source.  xfailed pending the
// checker fix (thread the inherited type in checkGroupDecl/checkGroupDeclTentative).
// See claude-todo.md.
const (
	B0 uint8 = 1 << iota
	B1
	B2
	B3
	B4
	B5
	B6
	B7
	B8
)

func main() {
	testing.Println(cast(int, B8))
}
