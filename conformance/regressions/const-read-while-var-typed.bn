package "main"

import "pkg/builtins/testing"

func f(x int) [3]int {
	var a [3]int
	return a
}

type S struct {
	a [3]int
	k int
}

// Each constant below is read while the type of a variable it reads is found,
// where that type needs no value of it, so it is resolved again once the
// variable has its type.

// V's array length needs only W's type, which W's initializer spells without
// K's value: V is a [3]int, K is 3, and W, whose initializer reads K, holds 3s.
var V [len(W)]int

var W = S{a: [3]int{K, K, K}, k: K}.a

const K = len(V)

// U's array length reads I only as f's argument; I repeats J's initializer.
var U [len(f(I))]int

const (
	J = len(U)
	I
)

const L = J + I

func main() {
	testing.Println(K)
	testing.Println(W[0] + W[2])
	testing.Println(I)
	testing.Println(L)
}
