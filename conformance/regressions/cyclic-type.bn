package "main"
import "pkg/builtins/testing"

// A cyclic named-type definition (`type A B; type B A`, or self `type A A`)
// has no well-defined underlying.  The ==/< comparability operand checks walk a
// named type's Underlying chain, which on such a cycle would hang (==) /
// stack-overflow (<).  The checker rejects the definition with a clear
// diagnostic, and the operand predicates carry a bounded peel as
// defense-in-depth.

type A B
type B A

func f(a A, b A) bool {
	return a == b
}

func main() {
	testing.Println(0)
}
