package "main"
import "pkg/builtins/testing"

// A cyclic named-type definition (`type A B; type B A`, or self `type A A`)
// has no well-defined underlying.  The new ==/< comparability operand checks
// (CR-2 Plan-1 Defect 5) walk a named type's Underlying chain, which used to
// hang (==) / stack-overflow (<) on such a cycle.  collectTypeDecl now rejects
// the definition with a clear diagnostic, and the operand predicates carry a
// bounded peel as defense-in-depth.  CR-2 Plan-1 Round-2.

type A B
type B A

func f(a A, b A) bool {
	return a == b
}

func main() {
	testing.Println(0)
}
