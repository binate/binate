package "main"

// Indexing a DEREFERENCED pointer-to-array — `(*p)[i]` where p is `*([N]T)` —
// must work for read and write, at one and multiple dimensions.  p IS the
// array's backing address, so the lowering recovers the element pointer through
// p (the deref arms in genIndex / genIndexPtr / the index-assign arm, plus the
// indexExprType deref case so `(*pm)[i][j]` classifies as a nested-array base).
// It previously loaded a COPY of the array (silently dropping `(*p)[i] = v`) or
// fed the array value to SliceGet (invalid IR on a read).  The whole-array store
// `*p = [N]T{...}` and address-of were always fine — only element indexing
// through the deref was broken.
func main() {
	var arr [3]int = [3]int{10, 20, 30}
	var p *([3]int) = &arr
	(*p)[0] = 99           // write an element through the pointer-to-array
	println(arr[0])        // 99
	println((*p)[1])       // 20  (read through the pointer)

	var m [2][3]int
	var pm *([2][3]int) = &m
	(*pm)[1][2] = 77       // multi-dim write through the pointer
	println(m[1][2])       // 77
	println((*pm)[1][2])   // 77  (multi-dim read through the pointer)
}
