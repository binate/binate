package "main"

// Indexing a DEREFERENCED pointer-to-array — `(*p)[i]` where p is `*([N]T)` —
// is miscompiled.  `(*p)[i] = v` mutates a loaded COPY of the array, so the
// store is silently dropped and the array keeps its old value (this test:
// arr[0] stays 10 instead of becoming 99).  The READ form `(*p)[i]` separately
// emits invalid IR (the deref'd array value is fed where a pointer is expected),
// and the multi-dim write `(*pm)[i][j] = v` likewise.  The whole-array store
// `*p = [N]T{...}` and address-of (`p = &arr`) work — only element indexing
// THROUGH the deref is broken.  Pre-existing on every backend (silent
// wrong-code).  See claude-todo.
func main() {
	var arr [3]int = [3]int{10, 20, 30}
	var p *([3]int) = &arr
	(*p)[0] = 99            // write an element through the pointer-to-array
	println(arr[0])        // want 99; currently 10 (write dropped)
}
