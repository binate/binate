package "main"

// Escalation of 830 (same-alias file-scoped imports): the two `dep`-aliased
// packages export a member `V` with INCOMPATIBLE result types — `*uint8` vs
// `int`.  So a broken (package-scoped) import wouldn't just swap values: file
// b.bn's `return dep.V()` would resolve to pa.V() (`*uint8`) and fail the
// `int` return with a result-type/ABI mismatch.  File-scoped imports keep each
// file's `dep` distinct, so A() reads pa's byte (42) and B() returns pb's int (7).
import "pkg/xf"

func main() {
	println(xf.A())   // 42
	println(xf.B())   // 7
}
