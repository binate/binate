package "main"

// Runtime float negation (OP_NEG) is an inline sign-bit flip: bit 31 of a
// float32's single word, bit 31 of a float64's HIGH word (bit 63 overall).  A
// literal `-7.0` folds to a const at parse time, so negation is driven off a
// VARIABLE here to exercise emitFloatNeg.  Values print via bit_cast so the
// exact IEEE pattern is checked: -x must flip ONLY the sign bit, leaving the
// mantissa/exponent intact (a wrong mask corrupts them), and negating a NEGATIVE
// value must CLEAR the sign bit — both directions are covered.

func main() {
	var a float64 = 3.14
	var na float64 = -a
	println(bit_cast(int64, na)) // -4609118966639786721 (sign bit set)

	var d float64 = -2.5
	var pd float64 = -d
	println(bit_cast(int64, pd)) // 4612811918334230528 (sign bit cleared)

	var c float32 = 1.5
	var nc float32 = -c
	println(bit_cast(int32, nc)) // -1077936128 (float32 sign bit set)
}
