package "main"

// A big MULTI-RETURN (> 16 B, returned via an sret pointer) function value
// must thread the result buffer and the data/captures through distinct
// registers.  On x86-64 (SysV) the sret pointer and the closure data
// pointer both want RDI; the funcval call site routes a big multi-return
// through the retbuf-in-RDI / data-in-RSI convention (the same one single
// aggregates use), so neither is lost, and the shims take the sret shape.
// The cases below carry USER ARGS — the part the old scalar multi-return
// shim mis-shuffled (its left-shift dropped a user arg into RDI, clobbering
// the sret pointer).  aa64 / LLVM / VM were already correct (aa64 returns
// big aggregates via a SEPARATE register, X8); this pins x64.

type P3 struct {
	a int
	b int
	c int
}

func mkMS(m int) (int, @[]int) {
	return m * 2, make_slice(int, m)
}

func mkP3(m int) (int, P3) {
	return m, P3{a: m, b: m + 1, c: m + 2}
}

func main() {
	// non-capturing, managed-component big multi-return ({int, @[]int}) +
	// one user arg.
	var f1 @func(int) (int, @[]int) = mkMS
	var a1 int
	var s1 @[]int
	a1, s1 = f1(4)
	println(a1)          // 8
	println(len(s1))     // 4

	// non-capturing, struct-component big multi-return ({int, P3} = 32 B).
	var f2 @func(int) (int, P3) = mkP3
	var a2 int
	var p2 P3
	a2, p2 = f2(10)
	println(a2)          // 10
	println(p2.a)        // 10
	println(p2.c)        // 12

	// capturing closure, big multi-return + two user args.
	var n int = 1000
	var f3 @func(int, int) (int, @[]int) =
		func(x int, y int) (int, @[]int) { return n + x + y, make_slice(int, x) }
	var a3 int
	var s3 @[]int
	a3, s3 = f3(3, 7)
	println(a3)          // 1010
	println(len(s3))     // 3
}
