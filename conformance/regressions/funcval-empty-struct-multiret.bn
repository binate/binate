package "main"

// A func value whose result is a MULTI-return containing a 0-BYTE aggregate field
// (`func() (int, struct{}, int)`) called INDIRECTLY through a func-value parameter
// (so the call cannot be devirtualized) must return the non-empty fields correctly:
// the empty field occupies NO return register, so the surrounding int fields land in
// the SAME registers as `(int, int)` would.
//
// The native per-field multi-return store used a min-of-1 word count (argWordsArm32
// / ArgWords) even for the 0-byte field, so it stored a junk word for it AND consumed
// a return register — shifting every later field's register by one (corruption +
// desync from the callee return lowering and the LLVM shim, whose first-class `{...}`
// return places nothing for the empty field).  The fix skips the 0-byte field (no
// store, no register), matching x64 / LLVM / the VM.  Green on LLVM, VM, and native.

// pair returns (int, struct{}, int): the empty middle field must not perturb the
// two ints.
func pair(x int) (int, struct{}, int) {
	var e struct{}
	return x + 1, e, x + 2
}

// callThroughValue calls the func value INDIRECTLY.
func callThroughValue(fn @func(int) (int, struct{}, int), x int) (int, struct{}, int) {
	return fn(x)
}

func main() {
	var f @func(int) (int, struct{}, int) = pair

	var a int
	var e struct{}
	var b int
	a, e, b = callThroughValue(f, 10)
	_ = e
	println(a)  // 11
	println(b)  // 12

	a, e, b = callThroughValue(f, 40)
	println(a)  // 41
	println(b)  // 42
}
