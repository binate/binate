package "main"
import "pkg/builtins/testing"

// A func value whose result is a 0-BYTE aggregate (`struct{}`, SizeOf 0) called
// INDIRECTLY through a func-value PARAMETER (so the call cannot be devirtualized to
// a direct call to the underlying) must STILL execute the underlying — its side
// effects must not vanish.
//
// The native call site classified the result with the kind-only IsAggregateTyp (no
// size gate), so a 0-byte result was wrongly treated as needing a retbuf.  But
// PlanFrame reserves no data region for a 0-byte result (its `dataSz > 0` gate), so
// the retbuf lookup returned -1 and the call site bailed BEFORE emitting the call —
// silently dropping the call and its side effects (a critical miscompile).  The fix
// classifies the result with types.IsAggregateReturnTyp (false for 0-byte), routing
// it to the scalar/void shim — the call is emitted, matching the LLVM shim.
//
// Observability: `bump` mutates a package global; if the indirect call is dropped,
// the global stays 0 and the printed value is wrong.  Green on LLVM, VM, and native.

var counter int = 0

// bump returns a 0-byte aggregate (`struct{}`) and has an OBSERVABLE side effect.
func bump() struct{} {
	counter = counter + 1
	var e struct{}
	return e
}

// callThroughValue calls the func value INDIRECTLY — the compiler cannot see the
// underlying, so it must go through the func-value shim / call site under test.
func callThroughValue(fn @func() struct{}) struct{} {
	return fn()
}

func main() {
	var f @func() struct{} = bump

	var e struct{}
	e = callThroughValue(f)  // side effect: counter -> 1
	e = callThroughValue(f)  // side effect: counter -> 2
	e = callThroughValue(f)  // side effect: counter -> 3
	_ = e

	testing.Println(counter)  // 3 — before the fix this printed 0 (the calls were dropped)
}
