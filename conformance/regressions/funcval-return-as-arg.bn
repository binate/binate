package "main"
import "pkg/builtins/testing"

// A function value RETURNED from a call and PASSED DIRECTLY as an
// argument lost its vtable in the bytecode VM (a `runtime error: call of
// nil function value` fault); the compiled backends were correct.  The returned func
// value's 16-byte {vtable, data} record was built in mk's frame and the
// result register held the ADDRESS of that slot; without copying it back
// to stable caller space the address dangled into the reclaimed mk frame
// and the vtable word read 0.  Returning-then-calling, or passing a
// local/param func value, both worked — only the un-materialized
// return-value-as-arg combination failed.

func mk() @func(int) int {
	return func(x int) int { return x + 1 }
}

func use(w @func(int) int) int {
	return w(41)
}

func main() {
	testing.Println(use(mk())) // 42
}
