package "main"
import "pkg/builtins/testing"

// A function value RETURNED from a call and PASSED DIRECTLY as an argument loses
// its vtable in the bytecode VM (a recoverable "runtime error: call of nil function
// value" fault); compiled
// is correct. Returning-then-calling, or passing a local/param function value,
// both work — only the un-materialized return-value-as-arg combination fails,
// because the VM's single-return copy-back has no arm for a func-value 16-byte
// aggregate (it stays in the reclaimed callee frame). Binding to a local first
// (`var w = mk(); use(w)`) materializes a stable slot and works. VM-only.
// See claude-todo.md (VM func-value return-as-arg nil vtable) / plan-cr-p2-3 3.8.

func mk() @func(int) int {
	return func(x int) int { return x + 1 }
}

func use(w @func(int) int) int {
	return w(41)
}

func main() {
	testing.Println(use(mk())) // expect 42
}
