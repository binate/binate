package "main"
import "pkg/builtins/testing"

// A function value RETURNED from a call and PASSED DIRECTLY as an argument must
// keep its vtable.  Unlike returning-then-calling, or passing a local/param
// function value, this un-materialized return-value-as-arg combination relies on
// the bytecode VM's single-return copy-back handling a func-value 16-byte
// aggregate; left in the reclaimed callee frame, the value faults with a
// recoverable "runtime error: call of nil function value".  (Binding to a local
// first, `var w = mk(); use(w)`, materializes a stable slot.)

func mk() @func(int) int {
	return func(x int) int { return x + 1 }
}

func use(w @func(int) int) int {
	return w(41)
}

func main() {
	testing.Println(use(mk())) // expect 42
}
