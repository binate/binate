package "main"

import "pkg/builtins/testing"

// outer's constraint on T takes its length from U: for U int64 it is
// Eq[[8]uint8], which *N implements, and so is inner's, to which outer forwards.
interface Eq[T any] {
	eq(o T) bool
}

func inner[V Eq[[sizeof(W)]uint8], W any](v V) int {
	var o [sizeof(W)]uint8
	if v.eq(o) {
		return 1
	}
	return 2
}

func outer[T Eq[[sizeof(U)]uint8], U any](t T) int {
	return inner[T, U](t) * 10
}

type N struct {
	x int
}

func (n *N) eq(o [8]uint8) bool {
	return n.x == len(o)
}

impl *N : Eq[[8]uint8]

func main() {
	var n N
	n.x = 8
	testing.Println(outer[*N, int64](&n))
}
