package "main"

import "pkg/builtins/testing"

// m's signature builds W[T], which names J[T], whose method k selects hv.m():
// collection defines m once, and k's length is m's result's, sizeof(W[int64])
// (the size of an int64 and of an interface value).
type H[T any] struct {
	z T
}

var hv H[int64]

func (h *H[T]) m() [sizeof(W[T])]uint8 {
	var r [sizeof(W[T])]uint8
	r[0] = 3
	return r
}

interface J[T any] {
	k() [len(hv.m())]uint8
}

type W[T any] struct {
	v T
	j *J[T]
}

type Impl struct {
	n int
}

func (i *Impl) k() [sizeof(W[int64])]uint8 {
	var r [sizeof(W[int64])]uint8
	r[1] = 4
	return r
}

impl *Impl : J[int64]

func main() {
	var im Impl
	var j *J[int64] = &im
	var lens int = 0
	if len(hv.m()) == cast(int, sizeof(W[int64])) && len(j.k()) == len(hv.m()) {
		lens = 1
	}
	testing.Println(lens, hv.m()[0], j.k()[1])
}
