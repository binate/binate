package "main"

// Coverage (found by the generic-impl vtable review, `edafa86d`): a GENERIC-
// instantiation receiver impl of an EMBEDDING interface, dispatched through the
// RECURSIVE PARENT sub-vtables of the per-instantiation vtable.  `RG[T]` embeds
// two generic parents, so the (Box[int], RG[int]) __ivt lays Reader[int]'s full
// sub-vtable, then Getter[int]'s, then RG's own method — a call through
// @RG[int] must find Read in the Reader sub-block, Get in the Getter sub-block,
// and Both in the own-method tail.  The three methods return DISTINCT fields, so
// a wrong recursive-sub-vtable slot prints the wrong value.  Not previously
// exercised on native arm32 (the generic-impl vtable emission there is new).

interface Reader[T any] {
	Read() T
}

interface Getter[T any] {
	Get() T
}

interface RG[T any] : Reader[T], Getter[T] {
	Both() T
}

type Box[T any] struct {
	a T
	b T
	c T
}

func (x @Box[T]) Read() T {
	return x.a
}

func (x @Box[T]) Get() T {
	return x.b
}

func (x @Box[T]) Both() T {
	return x.c
}

impl @Box[T] : RG[T]

func main() {
	var x @Box[int] = make(Box[int])
	x.a = 10
	x.b = 20
	x.c = 30
	var rg @RG[int] = x
	println(rg.Read()) // 10 — through the Reader[int] parent sub-vtable
	println(rg.Get())  // 20 — through the Getter[int] parent sub-vtable
	println(rg.Both()) // 30 — RG[int]'s own method
}
