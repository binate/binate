package "main"

import "pkg/builtins/testing"

// g, declared first, builds W[int64] before collection reaches H's method m, whose result
// takes W[T]'s size; B[int64]'s length selects hv.m(): H[int64]'s m returns, and B[int64]'s a
// is, a [sizeof(W[int64])]uint8, not the zero length a read made while W[int64] is built
// would leave.
var g [sizeof(W[int64])]uint8

type H[T any] struct {
	z T
}

var hv H[int64]

func (h *H[T]) m() [sizeof(W[T])]uint8 {
	var r [sizeof(W[T])]uint8
	return r
}

type W[T any] struct {
	v T
	j *B[T]
}

type B[T any] struct {
	a [len(hv.m())]uint8
}

func main() {
	var b B[int64]
	var n int = cast(int, sizeof(W[int64]))
	var ok int = 0
	if len(hv.m()) == n && len(g) == n && len(b.a) == n {
		ok = 1
	}
	testing.Println(ok)
}
