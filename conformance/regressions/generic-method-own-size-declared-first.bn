package "main"

import "pkg/builtins/testing"

// Other, declared before Box, takes the size of the Box[N] it is copied onto.
// N selects Get on B, a Box[N] whose layout reads N's size, and holds a Box[N]
// only through a pointer, so there is no cycle.
func (b Box[X]) Other() [sizeof(Box[X])]uint8 {
	var r [sizeof(Box[X])]uint8
	return r
}

type Box[X any] struct {
	t [sizeof(X)]uint8
}

func (b Box[X]) Get() [3]X {
	var r [3]X
	return r
}

var B Box[N]

type N struct {
	v   int64
	arr [len(B.Get())]int
	p   *Box[N]
}

func main() {
	var n N
	testing.Println(len(B.Other()) == len(B.t), len(n.arr))
}
