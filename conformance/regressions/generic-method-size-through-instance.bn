package "main"

import "pkg/builtins/testing"

// Sz, collected before B, is copied onto Box[int] while Box[int] is built: its
// signature takes the size of W[int], which holds a Box[int] by value, while
// Box[int] holds W[int] only through a pointer, so there is no cycle.
type W[X any] struct {
	b [sizeof(Box[X])]uint8
}

func (b Box[X]) Sz() [sizeof(W[X])]X {
	var r [sizeof(W[X])]X
	return r
}

type Box[X any] struct {
	a [2]X
	w *W[X]
}

var B Box[int]

func main() {
	var w W[int]
	testing.Println(len(B.a), len(B.Sz()) == len(w.b))
}
