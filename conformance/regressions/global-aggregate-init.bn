package "main"

// Package-level aggregate and float-scalar var initializers.  The
// per-package __init function applies each `var x T = expr` as the
// assignment `x = expr`; whole-array assignment used to be dropped, so a
// global array table read back as all-zero, and a global float var emitted
// invalid LLVM (`@x = global double 0` — an integer 0 for a double type).
// Both are fixed: array/struct assignment copies the value, and the global
// float static zero is emitted as `0.0`.

var gIntTab [4]int = [4]int{10, 20, 30, 40}
var gFloatTab [4]float64 = [4]float64{1.0, 10.0, 100.0, 1000.0}
var gScalar float64 = 7.5

func main() {
	println(gIntTab[0])                       // 10
	println(gIntTab[3])                       // 40
	println(cast(int, gFloatTab[0] == 1.0))   // 1
	println(cast(int, gFloatTab[2] == 100.0)) // 1
	println(cast(int, gScalar == 7.5))        // 1
}
