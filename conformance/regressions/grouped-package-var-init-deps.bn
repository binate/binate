package "main"
import "pkg/builtins/testing"

// A grouped var member participates in dependency-order init exactly like a
// top-level var: `derived` (a group member) reads `base` (top-level, declared
// later), so `base` initializes first.  Pins that grouped vars get storage,
// run their initializers, and join the dependency graph.
var (
	derived int = base + 10
	other   int = 3
)
var base int = 5

func main() {
	testing.Println(derived)   // 15
	testing.Println(other)     // 3
	testing.Println(base)      // 5
}
