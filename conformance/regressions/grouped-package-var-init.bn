package "main"
import "pkg/builtins/testing"

// A multi-member grouped package var (`var ( ... )`) runs each member's
// initializer at package init and gives each member storage — grouped members
// initialize exactly like top-level vars.  Init machinery that iterates
// top-level DECL_VAR only, never recursing into DECL_GROUP, silently zero-inits
// them (prints 0,0).
var (
	x int = 5
	y int = 6
)

func main() {
	testing.Println(x)
	testing.Println(y)
}
