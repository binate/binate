package "main"

// A multi-member grouped package var (`var ( ... )`) runs each member's
// initializer at package init and gives each member storage — grouped members
// initialize exactly like top-level vars.  Regression: they used to silently
// zero-init (print 0,0) because the init machinery iterated top-level DECL_VAR
// only and never recursed DECL_GROUP.
var (
	x int = 5
	y int = 6
)

func main() {
	println(x)
	println(y)
}
