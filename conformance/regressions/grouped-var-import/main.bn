package "main"
import "pkg/builtins/testing"

// Grouped vars EXPORTED via a `.bni` (`var ( X int; Y int )`) resolve and link
// cross-package, exactly like top-level exported vars: the .bni-load
// (bni_scope.bn), extern-registration (gen_import.bn), and Exported-flag
// (markBniExportedVars) paths all recurse the group's members.  The loader
// excludes a .bni var group from the defining package's merged decls (its
// members are externs, storage in the .bn) — mirroring top-level .bni vars;
// prepending it there double-registers its globals.
import "pkg/gv"

func main() {
	testing.Println(gv.X)   // 11
	testing.Println(gv.Y)   // 22
}
