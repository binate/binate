package "main"

// Grouped vars EXPORTED via a `.bni` (`var ( X int; Y int )`) consumed
// cross-package.  xfail: the .bni-load + extern-registration + Exported-flag
// paths (bni_scope.bn, gen_import.bn, markBniExportedVars) still iterate
// top-level DECL_VAR only, so `gv.X` is "undefined" to importers.  The
// DEFINING side (a grouped var used within its own package) works.  See
// claude-todo.md.
import "pkg/gv"

func main() {
	println(gv.X)   // 11
	println(gv.Y)   // 22
}
