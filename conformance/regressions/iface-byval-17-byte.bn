package "main"

// Pins the LLVM byval threshold at 17 bytes — just above the >16
// boundary (FIX 3892e7d1).  A 17-byte struct passed by value through
// interface dispatch must travel via the byval `ptr` convention, or the
// extra register slots shift the trailing scalar so `tag` reads wrong.
// 598 covers 32-byte aggregates and iface-param/three-int covers 24;
// this pins the (16,24] boundary.  On native it also exercises the
// AAPCS64 indirect-large path (17 > AggregateInRegMax = 16).

type Big17 struct {
	data [17]uint8
}

interface Sink {
	take(b Big17, tag int) int
}

type T struct {
	x int
}

impl @T : Sink

func (t @T) take(b Big17, tag int) int {
	return cast(int, b.data[16]) + tag
}

func main() {
	var t @T = make(T)
	var s @Sink = t
	var b Big17
	b.data[16] = 7
	println(s.take(b, 5)) // 12 (7 + 5)
}
