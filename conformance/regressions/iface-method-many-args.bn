package "main"
import "pkg/builtins/testing"

// Exercises an interface-method dispatch whose scalar args spill past
// the argument registers — the path that needs PlanFrame to size the
// outgoing-args area for OP_CALL_IFACE_METHOD (it was omitted from
// isCallOp, §3.10; cf. 523_closure_many_user_args for func values).
// The frame-sizing fix itself is pinned at the unit level
// (TestIsCallOpIncludesAllDispatchOps); whether an unreserved spill
// observably corrupts a caller local is register-pressure- and
// layout-dependent, so this cell is an end-to-end guard for the
// spilling iface-dispatch path, not a deterministic repro of §3.10.

interface Adder {
	add(a int, b int, c int, d int, e int, g int, h int, i int, j int) int
}

type T struct {
	base int
}

impl @T : Adder

func (t @T) add(a int, b int, c int, d int, e int,
		g int, h int, i int, j int) int {
	return t.base + a + b + c + d + e + g + h + i + j
}

func main() {
	var t @T = make(T)
	t.base = 100
	var s @Adder = t
	testing.Println(s.add(1, 2, 3, 4, 5, 6, 7, 8, 9)) // 145 (100 + 45)
}
