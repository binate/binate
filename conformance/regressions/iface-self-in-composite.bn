package "main"
import "pkg/builtins/testing"

// An interface method whose parameter nests `Self` inside a composite type
// (`*[]Self`) IS satisfiable: `Self` denotes the impl's receiver type (`*Bag` for
// `impl *Bag`, spec iface.self), so `*[]Self` resolves to `*[]*Bag` and the impl
// `grab(rest *[]*Bag)` matches.  The method is callable directly on a concrete
// receiver.

interface Holder {
	grab(rest *[]Self) int
}

type Bag struct {
	n int
}

func (b *Bag) grab(rest *[]*Bag) int {
	return b.n + len(rest)
}

impl *Bag : Holder

func main() {
	var b Bag
	b.n = 5
	var arr [2]*Bag
	testing.Println(b.grab(arr[:]))  // 7 (impl satisfies Holder; direct call)
}
