package "main"
import "pkg/builtins/testing"

// An interface method whose parameter nests `Self` inside a composite type
// (`*[]Self`) IS satisfiable: `Self` denotes the impl's base named type (a value,
// per §11 — like `eq(other Self)` matched by `eq(other Square)`), so `*[]Self`
// resolves to `*[]Bag` and the impl `grab(rest *[]Bag)` matches.  The method is
// callable directly on a concrete receiver.  (Calling a `Self`-parameter method
// THROUGH a generic constraint is a separate, pre-existing Self-semantics gap —
// the constraint binds Self to the type param, not its base — tracked in
// explorations/claude-todo.md; not exercised here.)

interface Holder {
	grab(rest *[]Self) int
}

type Bag struct {
	n int
}

func (b *Bag) grab(rest *[]Bag) int {
	return b.n + len(rest)
}

impl *Bag : Holder

func main() {
	var b Bag
	b.n = 5
	var arr [2]Bag
	testing.Println(b.grab(arr[:]))  // 7 (impl satisfies Holder; direct call)
}
