package "main"

// An interface method whose parameter nests `Self` inside a COMPOSITE type
// (`*[]Self`, and hence `...Self` whose body is `*[]Self`) is not satisfied by a
// correct impl: methodSigSatisfies substitutes Self via substituteSelf, which
// DOES recurse into a slice element, so `*[]Self` with Self=*Bag should match the
// impl's `*[]*Bag` — but the impl is rejected ("type Bag does not implement
// Holder (method `grab` has wrong signature)").  The gap is in how the interface
// method's `Self`-nested-in-composite param is resolved / compared, NOT in the
// variadic work: a plain (non-variadic) `*[]Self` param reproduces it.  This
// blocks a variadic `...Self` interface/constraint method (the `merge(others
// ...Self)` case).  xfail'd in every mode until Self-in-composite satisfaction is
// fixed.  Tracked in explorations/claude-todo.md.

interface Holder {
	grab(rest *[]Self) int
}

type Bag struct {
	n int
}

func (b *Bag) grab(rest *[]*Bag) int {
	return b.n + len(rest)
}

impl *Bag : Holder

func main() {
	var b Bag
	b.n = 5
	println(b.n)  // 5 (once the impl is accepted)
}
