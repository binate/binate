package "main"

// A CAPTURING immediately-invoked function literal heap-allocates a closure
// record (RefInc'ing each managed capture).  As a callee it is a fresh
// temporary owned by no var, so it must be RefDec'd at end of statement —
// otherwise the closure record (and its captures) leak.  The captured value's
// refcount must return to baseline after the IIFE call.
import "pkg/builtins/rt"

type Counter struct { N int }

func main() {
	var src @Counter = make(Counter)
	src.N = 7
	var src_po *uint8 = bit_cast(*uint8, src)
	println(rt.Refcount(src_po))                   // 1
	var r int = (func() int { return src.N })()    // capturing IIFE
	println(r)                                      // 7
	println(rt.Refcount(src_po))                   // 1 — closure released, no leak
}
