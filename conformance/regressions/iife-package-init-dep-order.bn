package "main"

// A package-var initializer that is an IIFE reading a LATER global: dependency-
// order init runs `seed` first, and the IIFE codegen actually emits+calls the
// lifted body.  (Both the var-init IIFE-body dependency walk and the IIFE
// codegen must work for this to print 42 rather than 1 or fail to link.)
var derived int = (func() int { return seed + 1 })()
var seed int = 41

func main() {
	println(derived)
}
