package "main"

import "pkg/builtins/testing"

// A name an immediately-invoked function literal binds is its own variable, not
// the package variable of that name: no initializer below reads itself, so none
// is an initialization cycle.  later still reads base, declared after it, so it
// is initialized after base.

type Config struct {
	n int
}

var arr [3]int = [3]int{1, 2, 3}

var cfg = func() Config {
	var cfg Config
	cfg.n = 3
	return cfg
}()

var u = func(u int) int {
	return u * 2
}(4)

var w = func() int {
	var s = 0
	for w in arr {
		s = s + w
	}
	return s
}()

var later = func() int {
	var later = 5
	return later + base
}()

var base = 100

func main() {
	testing.Println(cfg.n)
	testing.Println(u)
	testing.Println(w)
	testing.Println(later)
}
