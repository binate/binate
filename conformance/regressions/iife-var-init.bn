package "main"

// An immediately-invoked function literal (IIFE) as an initializer: the literal
// is lifted, emitted, and called.  Covers the no-arg and with-arg forms.
func main() {
	var a int = (func() int { return 41 + 1 })()
	var b int = (func(x int) int { return x * 2 })(21)
	println(a)
	println(b)
}
