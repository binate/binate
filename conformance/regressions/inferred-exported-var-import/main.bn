package "main"

// A .bni-exported var whose .bn DEFINITION uses an inferred type
// (`var X = 11`, no explicit type) must still link cross-package.  The
// importer reads the dep's merged file (the .bn definition, no TypeRef), so
// the extern's type is recovered from the checker's .bni-built package scope.
// Covers a top-level var and a grouped one; regression was an IR-gen abort
// ("unresolved selector") because the extern was dropped.
import "pkg/inf"

func main() {
	println(inf.T)   // 5
	println(inf.X)   // 11
	println(inf.Y)   // 22
}
