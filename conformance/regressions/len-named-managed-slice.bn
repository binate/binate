package "main"
import "pkg/builtins/testing"

// `len()` on a value whose type is a NAMED managed-slice (`type Buf @[]int`)
// works because the checker peels the named-distinct wrapper and sees the
// underlying `@[]int` (named-distinct transparency for slice/pointer/array
// operations).  Also exercises passing an unnamed `@[]int` to a `Buf`
// parameter — the assignability side of the same rule.
type Buf @[]int

func report(b Buf) int {
	return len(b)
}

func main() {
	var s @[]int = make_slice(int, 5)
	testing.Println(report(s))   // 5
}
