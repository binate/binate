package "main"

// `len()` on a value whose type is a NAMED managed-slice (`type Buf @[]int`) must
// work — the checker should peel the named wrapper and see the underlying `@[]int`.
// It is currently REJECTED ("len argument must be slice or array") because the
// len() argument check doesn't peel TYP_NAMED.  xfailed pending the peel fix.
// See claude-todo.md.
type Buf @[]int

func report(b Buf) int {
	return len(b)
}

func main() {
	var s @[]int = make_slice(int, 5)
	println(report(s))   // 5
}
