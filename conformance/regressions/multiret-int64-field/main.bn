package "main"

// Collecting a multi-return tuple that carries an int64 / uint64 field, where the
// callee lives in a SEPARATE package.  On native arm32 (ILP32) only this `main`
// module goes through the native backend; the callee package is LLVM-compiled, so
// this exercises the caller-collect side (storeMultiReturnTupleFieldsArm32) reading
// the LLVM callee's returned int64 register pair — and the OP_EXTRACT that
// destructures each int64 field out of the tuple slot (emitExtract64).  Covers
// both an int64-FIRST tuple ({int64, int32}) and an int64 at a NON-first,
// 8-aligned offset ({int32, int64}), where the pair lands in a consecutive
// (non-even-bumped) register pair.  On LP64 backends the same collect runs with a
// single 64-bit register.

import "pkg/mm"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var a int64
	var b int32
	a, b = mm.LeadInt64()
	println(yn(a == cast(int64, 12345678901)))   // 1 (int64 first, r0:r1)
	println(cast(int, b))                         // 7

	var c int32
	var d int64
	c, d = mm.TrailInt64()
	println(cast(int, c))                         // 9
	println(yn(d == cast(int64, 98765432109)))    // 1 (int64 non-first, consecutive pair)

	var e uint64
	var f int32
	e, f = mm.LeadUint64()
	println(yn(e == cast(uint64, 18000000000)))   // 1 (uint64 > 2^32, hi word live)
	println(cast(int, f))                         // 3
}
