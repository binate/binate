package "pkg/mm"

// Multi-return tuples carrying a 64-bit field in each position, so the caller's
// tuple-collect exercises both an int64-first pair and an int64 at a non-first
// 8-aligned offset.

func LeadInt64() (int64, int32) {
	return cast(int64, 12345678901), cast(int32, 7)
}

func TrailInt64() (int32, int64) {
	return cast(int32, 9), cast(int64, 98765432109)
}

func LeadUint64() (uint64, int32) {
	return cast(uint64, 18000000000), cast(int32, 3)
}
