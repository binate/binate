package "main"
import "pkg/builtins/testing"

// Exercises the x64 multi-return eightbyte-coalescing path (FIX b5616b32)
// with a MULTI-WORD aggregate component: the (Triple, int32) tuple is 16
// bytes, so it returns in RAX/RDX, and emitMultiReturnPack memcpies the
// 12-byte Triple field across TWO 8-byte words (the `for w; w*8 < fldSz`
// loop runs w=0 and w=1) into the byte image before storing the trailing
// int32.  The managed-struct multi-assign cells only have a 1-word
// (8-byte) aggregate component, so the loop's >1-iteration path was
// otherwise untested.  Self-consistent caller/callee on every backend.

type Triple struct {
	a int32
	b int32
	c int32
}

func pair() (Triple, int32) {
	var t Triple
	t.a = 11
	t.b = 22
	t.c = 33
	return t, 44
}

func main() {
	var t Triple
	var n int32
	t, n = pair()
	testing.Println(cast(int, t.a)) // 11
	testing.Println(cast(int, t.b)) // 22
	testing.Println(cast(int, t.c)) // 33
	testing.Println(cast(int, n))   // 44
}
