package "main"
import "pkg/builtins/testing"

// The CAPTURING half of named func-value literal construction: a func literal
// that CAPTURES, assigned/returned into a named MANAGED-func-value type, must
// heap-allocate the closure record and refcount it (not stack-alloc as a raw
// *func). isManagedFuncValueLit peels the named wrapper to keep the managed
// (heap) flavour.
type Adder @func(int) int

func makeAdder(base int) Adder {
	return func(x int) int { return base + x }  // captures base
}

func main() {
	var a Adder = makeAdder(100)
	testing.Println(a(14))   // 114
	var b Adder = makeAdder(1000)
	testing.Println(b(14))   // 1014
	testing.Println(a(1))    // 101 -- a still valid (independent capture)
}
