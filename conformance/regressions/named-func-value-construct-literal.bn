package "main"
import "pkg/builtins/testing"

// The func-LITERAL half of named func-value construction:
//   type Fn @func(int) int; var f Fn = func(x int) int { ... }
// checkFuncLit returns the named type when hinted by one (and
// isManagedFuncValueLit peels TYP_NAMED), so the literal is assignable to the
// nominal Fn; a bare @func would not be.
type Fn @func(int) int

func main() {
	var f Fn = func(x int) int { return x * 3 }
	testing.Println(f(14))
}
