package "main"

// The func-LITERAL half of named func-value construction:
//   type Fn @func(int) int; var f Fn = func(x int) int { ... }
// Currently rejected because checkFuncLit produces a bare @func that is not
// assignable to the nominal Fn.  The fix (literal-half follow-up) makes
// checkFuncLit return the named type when hinted by one (and peels TYP_NAMED
// at isManagedFuncValueLit).  xfailed pending that work.  See claude-todo.md B2.
type Fn @func(int) int

func main() {
	var f Fn = func(x int) int { return x * 3 }
	println(f(14))
}
