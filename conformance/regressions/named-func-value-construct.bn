package "main"
import "pkg/builtins/testing"

// A NAMED func-value type (`type Fn @func(...)`) must be constructible — assigning
// a matching top-level func to it should work, exactly as the anonymous spelling
// `var f @func(int) int = dbl` does.  The func-value flavour hint
// (checkExprWithFVHint) and AssignableTo's func arm peel TYP_NAMED for this;
// without the peel the assignment is rejected ("cannot assign func(...) to Fn")
// and the declared type is unusable.
type Fn @func(int) int

func dbl(x int) int {
	return x * 2
}

func main() {
	var f Fn = dbl
	testing.Println(f(21))   // 42
}
