package "main"
import "pkg/builtins/testing"

// A NAMED func-value type (`type Fn @func(...)`) must be constructible — assigning
// a matching top-level func to it should work, exactly as the anonymous spelling
// `var f @func(int) int = dbl` does.  It is currently REJECTED ("cannot assign
// func(...) to Fn") because the func-value flavour hint (checkExprWithFVHint) and
// AssignableTo's func arm don't peel TYP_NAMED, so a whole declared-and-tested
// type is unusable.  xfailed pending the peel fix.  See claude-todo.md.
type Fn @func(int) int

func dbl(x int) int {
	return x * 2
}

func main() {
	var f Fn = dbl
	testing.Println(f(21))   // 42
}
