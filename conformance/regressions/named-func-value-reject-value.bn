package "main"
import "pkg/builtins/testing"

// Option A: a named func-value type is NOMINAL for func VALUES.  A value of
// the underlying @func type is NOT implicitly assignable to the named type —
// it is only constructible from a func REFERENCE / literal, mirroring how a
// named scalar accepts an untyped literal but not a typed value of the
// underlying.  This pins the value-rejection half of the B2 design so a future
// change can't silently make named func-value types fully transparent.
type Fn @func(int) int

func dbl(x int) int { return x * 2 }

func main() {
	var g @func(int) int = dbl
	var f Fn = g
	testing.Println(f(21))
}
