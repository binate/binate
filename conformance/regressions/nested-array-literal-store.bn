package "main"

// A nested-array composite literal `[N][M]T{...}` and a whole-inner-array
// assignment `a[i] = [M]T{...}` must store the inner array's VALUE, not the
// inner alloca POINTER.  The store guard fired only for TYP_STRUCT elements,
// so an inner ARRAY element stored the 8-byte alloca pointer into the
// array-sized slot → garbage (CR-2 Plan-1 Defect 6).
// Expected: 1 2 3 4 / 100 7 8 9 / 11 22

func main() {
	// (1) nested-array literal read-back
	var m [2][2]int = [2][2]int{ [2]int{1, 2}, [2]int{3, 4} }
	println(m[0][0])    // 1
	println(m[0][1])    // 2
	println(m[1][0])    // 3
	println(m[1][1])    // 4

	// (2) whole-inner-array assignment (a[i] = [M]T{...})
	var a [2][3]int
	a[0][0] = 100
	a[1] = [3]int{7, 8, 9}
	println(a[0][0])    // 100 (untouched)
	println(a[1][0])    // 7
	println(a[1][1])    // 8
	println(a[1][2])    // 9

	// (3) managed inner-element: the loaded inner-array value carries its
	// managed slices, exercising the refcount store path; read an element
	// back through each to confirm they survived the inner-array value-copy
	// (a missed RefInc would double-free at scope exit and crash/garbage).
	var s0 @[]int = make_slice(int, 2)
	s0[0] = 11
	var s1 @[]int = make_slice(int, 2)
	s1[0] = 22
	var g [1][2]@[]int = [1][2]@[]int{ [2]@[]int{s0, s1} }
	println(g[0][0][0]) // 11
	println(g[0][1][0]) // 22
}
