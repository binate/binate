package "main"

// Field read through a nested-array managed-POINTER element returns literal 0
// (MAJOR — see claude-todo).  `a[i][j].field` where `a` is `[N][M]@Struct`
// reads 0 instead of the field value, on every backend.  Separate from the
// Defect-6 inner-array store fix (which is correct); this is the field-access
// path.  Xfailed until the gen_selector nested-array-element selector is fixed.

type Box struct { v int }

func main() {
	var p @Box = make(Box)
	p.v = 42
	var a [1][2]@Box
	a[0][0] = p
	println(a[0][0].v)   // 42 (currently reads 0)
}
