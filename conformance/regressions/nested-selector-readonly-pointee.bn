package "main"

// getSelectorType (the selector TYPE-resolver, distinct from genSelector's
// IR-gen) read the un-peeled `.Elem.Name` of a managed/raw pointer-to-struct
// base, so a NESTED selector whose inner base is `@readonly Box` (or an
// alias to it) resolved the inner type to nil → the outer field read folded
// to const-0.  CR-2 Plan-1 Round-2 closing review: the getSelectorType sibling
// of Defect 1 (which peeled genSelector/genSelectorPtr but not this resolver).

type Inner struct { x int }
type Box struct { inr Inner }
type RBox = @readonly Box

func mk() @readonly Box {
	var b @Box = make(Box)
	b.inr.x = 42
	return b
}
func mkAlias() RBox {
	var b @Box = make(Box)
	b.inr.x = 7
	return b
}
func main() {
	var rp @readonly Box = mk()
	println(rp.inr.x)        // 42  (readonly-pointee base)
	var ra RBox = mkAlias()
	println(ra.inr.x)        // 7   (alias-over-readonly base)
}
