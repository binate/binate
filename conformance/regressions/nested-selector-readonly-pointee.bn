package "main"
import "pkg/builtins/testing"

// getSelectorType (the selector TYPE-resolver, distinct from genSelector's
// IR-gen) must peel the `.Elem` of a managed/raw pointer-to-struct base before
// reading its name: otherwise a NESTED selector whose inner base is
// `@readonly Box` (or an alias to it) resolves the inner type to nil → the outer
// field read folds to const-0.  This is the type-resolver counterpart of the
// genSelector/genSelectorPtr peel.

type Inner struct { x int }
type Box struct { inr Inner }
type RBox = @readonly Box

func mk() @readonly Box {
	var b @Box = make(Box)
	b.inr.x = 42
	return b
}
func mkAlias() RBox {
	var b @Box = make(Box)
	b.inr.x = 7
	return b
}
func main() {
	var rp @readonly Box = mk()
	testing.Println(rp.inr.x)        // 42  (readonly-pointee base)
	var ra RBox = mkAlias()
	testing.Println(ra.inr.x)        // 7   (alias-over-readonly base)
}
