package "main"

// Reading a field through a pointer whose POINTEE is transparently
// wrapped — `@readonly Box` / `*readonly Box` — must peel the wrapper off
// the pointee before the struct-index lookup.  Otherwise IR-gen's
// Kind-dispatch reads the un-peeled `.Elem` (whose `.Name` is ""), misses
// every struct arm, and folds the read to a literal 0 (genSelector) / a
// const-0 pointer that SIGSEGVs when dereferenced (genSelectorPtr).
//
// CR-2 Plan-1 Round-2: the inner-pointee sibling of Defect 1 (which
// covered the OUTER `readonly @Box` wrapper, where peelTransparent of the
// variable type already removed the wrapper; here the outer kind is a
// plain pointer, so the pointee must be peeled at each extraction site).
// Mutation through the const object is correctly rejected, so only reads
// and readonly-address forms appear below.

type Box struct {
	v int
}

func mk() @readonly Box {
	var b @Box = make(Box)
	b.v = 55
	return b
}

func main() {
	// Managed inner-pointee: `@readonly Box` field read (genSelector).
	var rp @readonly Box = mk()
	println(rp.v)                 // 55

	// `&field` through the readonly pointee (genSelectorPtr), read back.
	var pv *readonly int = &rp.v
	println(*pv)                  // 55

	// Raw inner-pointee: `*readonly Box` field read (genSelector).
	var b2 @Box = make(Box)
	b2.v = 33
	var raw *Box = b2
	var rrp *readonly Box = raw
	println(rrp.v)                // 33
}
