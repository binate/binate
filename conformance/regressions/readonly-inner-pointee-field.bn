package "main"

// The `matrix/readonly/wrapper-order` cells cover the inner-pointee READ
// (`@readonly Box` / `*readonly Box` → `p.v`).  This pins the LVALUE facet
// the read-only matrix does not: `&p.v` through a readonly pointee must
// yield a real field pointer (genSelectorPtr peels the pointee), not a
// dropped nil lvalue that lowers to a const-0 pointer and SIGSEGVs on
// deref.  CR-2 Plan-1 Round-2, inner-pointee sibling of Defect 1.

type Box struct {
	v int
}

func mk() @readonly Box {
	var b @Box = make(Box)
	b.v = 55
	return b
}

func main() {
	var rp @readonly Box = mk()
	// &field through the readonly pointee (genSelectorPtr), read back.
	var pv *readonly int = &rp.v
	println(*pv)                 // 55; baseline -> const-0 ptr -> SIGSEGV
}
