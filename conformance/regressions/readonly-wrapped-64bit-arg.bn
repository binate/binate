package "main"
import "pkg/builtins/testing"

// A `readonly float64` / `readonly int64` value FORWARDED as a call argument
// must marshal as a register PAIR (2 words), not a single word.  The 64-bit
// value-shape predicates on native arm32 (isReg64Scalar / isFloatTyp /
// floatBitWidth) must peel ALL transparent wrappers (alias / readonly / named):
// a peel of named types alone classifies a readonly-wrapped 64-bit arg as NOT a
// pair and places it in a single word, dropping the high word — a silent
// miscompile, and the same mismatch would let a readonly float64 slip the
// function-value shim guard.  Both values have nonzero high words, so a dropped
// high word prints a different number; bit_cast keeps the output byte-identical
// across LLVM / VM / native.

func consume(f readonly float64, i readonly int64) int64 {
	return bit_cast(int64, f) + i
}

// forward passes its readonly 64-bit params straight through as call args — this
// is the call whose arg types are `readonly float64` / `readonly int64`.
func forward(rf readonly float64, ri readonly int64) int64 {
	return consume(rf, ri)
}

func main() {
	var f float64 = 3.14
	var i int64 = 0x1122334455667788
	testing.Println(forward(f, i)) // 4614253070214989087 + 1234605616436508552
}
