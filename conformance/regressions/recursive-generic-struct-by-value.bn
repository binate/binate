package "main"
import "pkg/builtins/testing"

// A generic struct that contains its own instantiation by value
// (`type Bad[T any] struct { x Bad[T] }`) has no finite layout, like the
// non-generic `type C struct { self C }` (recursive-struct-by-value): the
// instantiation is rejected.

type Bad[T any] struct {
	x Bad[T]
	y T
}

func main() {
	var b Bad[int32]
	testing.Println(b.y)
}
