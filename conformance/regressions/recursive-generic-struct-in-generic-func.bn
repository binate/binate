package "main"
import "pkg/builtins/testing"

// A generic struct that contains its own instantiation by value is rejected
// when it is instantiated only inside a generic function, with that function's
// type parameter (`Bad[T]` in `f[T]`, reached through `f[int32]`).

type Bad[T any] struct {
	x Bad[T]
	y T
}

func f[T any]() int {
	var b Bad[T]
	return 0
}

func main() {
	testing.Println(f[int32]())
}
