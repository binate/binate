package "main"
import "pkg/builtins/testing"

// Two generic structs that hold each other's instantiation by value
// (`A[T]` holds `B[T]`, which holds `A[T]`) have no finite layout, like the
// non-generic mutual cycle `A{b B}; B{a A}`: the instantiation is rejected.

type A[T any] struct {
	b B[T]
	y T
}

type B[T any] struct {
	a A[T]
}

func main() {
	var a A[int32]
	testing.Println(a.y)
}
