package "main"
import "pkg/builtins/testing"

// A named type declared as a generic instantiation with itself as the type
// argument (`type Wrap Box[Wrap]`), where the generic holds its argument by
// value, has no finite layout: it is rejected.

type Box[T any] struct {
	v T
	n int32
}

type Wrap Box[Wrap]

func main() {
	var w Wrap
	testing.Println(w.n, sizeof(Wrap))
}
