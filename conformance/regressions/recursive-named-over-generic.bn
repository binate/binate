package "main"
import "pkg/builtins/testing"

// A named type declared over a generic instantiation that holds the named type
// by value (`type Wrap Bad[int32]`, with `w Wrap` in `Bad[T]`) has no finite
// layout: it is rejected, whichever of the two is declared first.

type Bad[T any] struct {
	w Wrap
	y T
}

type Wrap Bad[int32]

func main() {
	var b Bad[int32]
	testing.Println(b.y)
}
