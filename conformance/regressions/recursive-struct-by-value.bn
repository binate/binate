package "main"
import "pkg/builtins/testing"

// A struct that contains ITSELF by value (`type C struct { self C }`, or through
// an array field `{ items [2]C }`, or a mutual cycle `A{b B}; B{a A}`) has no
// finite layout.  The checker rejects the definition and breaks the cycle
// (poisoning the offending field), so the walks terminate; a cyclic Underlying
// left in place makes the size / destruction / ABI walks that recurse through
// by-value fields stack-overflow the compiler (SIGSEGV at compile time).  A
// cycle through a POINTER (`@C` / `*C`) is a valid recursive type (linked-list
// node) and stays legal.

type C struct {
	self C
}

func main() {
	testing.Println(0)
}
