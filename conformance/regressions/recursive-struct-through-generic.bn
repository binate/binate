package "main"
import "pkg/builtins/testing"

// A non-generic struct that holds, by value, a generic instantiation holding
// the struct (`N` holds `Box[N]`, whose field is an `N`) has no finite layout:
// the struct is rejected.

type N struct {
	b Box[N]
}

type Box[T any] struct {
	v T
}

func main() {
	var n N
	testing.Println(0)
}
