package "main"
import "pkg/builtins/testing"

// A struct by-value cycle can close through a NAMED-DISTINCT wrapper
// (`type C struct { d D }; type D C`).  The first fix for the direct cases only
// ran in the struct branch of collectTypeDecl and was decl-order dependent, so it
// missed this shape — the compiler SIGSEGV'd (struct declared first) or silently
// miscompiled a wrong finite layout (multi-hop wrapper).  The check now runs
// post-collection (checkValueEmbedding), once every underlying is filled, so a
// wrapper cycle is caught regardless of decl order.  A wrapper that does NOT close
// a cycle stays legal.

type C struct {
	d D
	x int
}

type D C

func main() {
	testing.Println(0)
}
