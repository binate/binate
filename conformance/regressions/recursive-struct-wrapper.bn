package "main"
import "pkg/builtins/testing"

// A struct by-value cycle can close through a NAMED-DISTINCT wrapper
// (`type C struct { d D }; type D C`).  The check runs post-collection
// (checkValueEmbedding), once every underlying is filled, so a wrapper cycle is
// caught regardless of decl order.  A check that runs only in the struct branch
// of collectTypeDecl is decl-order dependent and misses this shape — the
// compiler SIGSEGVs (struct declared first) or silently miscompiles a wrong
// finite layout (multi-hop wrapper).  A wrapper that does NOT close
// a cycle stays legal.

type C struct {
	d D
	x int
}

type D C

func main() {
	testing.Println(0)
}
