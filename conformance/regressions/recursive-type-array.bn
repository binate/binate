package "main"

// A by-value cycle can also close through a named ARRAY type
// (`type C [2]C`, or mutual `type A [1]B; type B [1]A`), not just a struct field —
// C is an array of itself, which has no finite layout.  The struct-only version of
// the check missed this (SIGSEGV / bogus finite sizeof); the check now also runs on
// a named type whose underlying is an array.

type C [2]C

func main() {
	println(cast(int, sizeof(C)))
}
