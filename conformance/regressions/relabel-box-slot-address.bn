package "main"

import "pkg/builtins/testing"

// Boxing a relabeled local's address boxes the pointer, not the local.  At -O1+
// mem2reg resolves `rp` to the address of `x` itself, leaving
// `box(unsafe_cast(*S, &x))`; the box must hold that pointer (so writing through
// it changes `x`), not a copy of `x`'s bytes read back as a pointer.
type S struct {
	a int
	b int
}

func main() {
	var x S
	x.a = 7
	x.b = 9
	var rp *readonly S = &x
	var b @(*S) = box(unsafe_cast(*S, rp))
	var q *S = *b
	q.a = 8
	testing.Println(x.a, q.b)
}
