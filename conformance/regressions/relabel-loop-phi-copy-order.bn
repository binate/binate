package "main"

import "pkg/builtins/testing"

// A pointer relabel of one loop variable assigned to another.  At -O1+ mem2reg
// makes `cur` and `last` loop phis, and `unsafe_cast(*Node, cur)` (an identity
// once `readonly` is stripped from IR types) a relabel of the `cur` phi feeding
// the `last` phi on the back edge.  The back edge's copies must give `last` the
// value `cur` holds in THIS iteration, not the `cur.next` it is about to take —
// otherwise lastNode returns nil.
type Node struct {
	next *Node
	v    int
}

func lastNode(head *readonly Node) *Node {
	var cur *readonly Node = head
	var last *Node = nil
	for cur != nil {
		last = unsafe_cast(*Node, cur)
		cur = cur.next
	}
	return last
}

func main() {
	var c Node
	c.v = 3
	var b Node
	b.v = 2
	b.next = &c
	var a Node
	a.v = 1
	a.next = &b
	var l *Node = lastNode(&a)
	if l == nil {
		testing.Println("nil")
	} else {
		testing.Println(l.v)
	}
}
