package "main"

// Returning an aggregate loaded DIRECTLY from a local container must
// materialize the loaded value before the local's cleanup frees its
// backing.  The native backends used to represent an aggregate OP_LOAD
// as a bare pointer into the source object and copy it into the sret
// buffer only AFTER the function's cleanup RefDec'd the local — reading
// freed (zeroed) memory.  So `msElem` returned an EMPTY slice and
// `structElem`'s fields read as garbage.  This is why self-hosted
// BNC_NATIVE's findRuntime (`return suffixes[i]`) computed an empty
// runtimePath and every aa64-native program dropped binate_runtime.c.
// The compiled (LLVM) and VM backends were always correct.

type Triple struct {
	a int
	b int
	c int
}

// Managed-slice element of a local @[]@[]char, returned directly.
func msElem() @[]char {
	var s @[]@[]char = @[]@[]char{"hello", "world"}
	return s[0]
}

// Struct element of a local array, returned directly.
func structElem() Triple {
	var arr [2]Triple
	arr[0].a = 1
	arr[0].b = 2
	arr[0].c = 3
	return arr[0]
}

func main() {
	println(msElem()) // hello
	var t Triple = structElem()
	println(t.a) // 1
	println(t.b) // 2
	println(t.c) // 3
}
