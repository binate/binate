package "main"
import "pkg/builtins/testing"

// Returning an aggregate loaded DIRECTLY from a local container must
// materialize the loaded value before the local's cleanup frees its
// backing.  A backend that represents an aggregate OP_LOAD as a bare
// pointer into the source object, and copies it into the sret buffer
// only AFTER the function's cleanup RefDec's the local, reads freed
// (zeroed) memory: `msElem` returns an EMPTY slice and `structElem`'s
// fields read as garbage.  The LLVM backend loads the aggregate into an
// SSA value at the load site; the native backends and the bytecode VM
// materialize aggregate loads into their own region, so this guards all
// three backends.

type Triple struct {
	a int
	b int
	c int
}

// Managed-slice element of a local @[]@[]char, returned directly.
func msElem() @[]char {
	var s @[]@[]char = @[]@[]char{"hello", "world"}
	return s[0]
}

// Struct element of a local array, returned directly.
func structElem() Triple {
	var arr [2]Triple
	arr[0].a = 1
	arr[0].b = 2
	arr[0].c = 3
	return arr[0]
}

func main() {
	testing.Println(msElem()) // hello
	var t Triple = structElem()
	testing.Println(t.a) // 1
	testing.Println(t.b) // 2
	testing.Println(t.c) // 3
}
