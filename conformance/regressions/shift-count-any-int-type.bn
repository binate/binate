package "main"

// A shift `x << y` / `x >> y` takes its result type from the LEFT
// (value) operand; the count `y` may be ANY integer type, independent of
// the value (Go semantics — a shift is not a symmetric binop).  This
// previously failed to type-check whenever the operand types differed by
// a width that doesn't collapse on the target: `int64 << int` was
// rejected in 32-bit-int modes ("mismatched types int64 and int") even
// though it compiled in 64-bit-int modes.  The count may also be WIDER
// than the value (`byteVal << intCount`), which must still detect
// overshift (count >= width → 0 for a logical shift, sign-fill for an
// arithmetic >>).  Each line is a target-stable 0/1 self-check.

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// --- count of a DIFFERENT type than the value (the regression) ---
	var v int64 = 1
	var n32 int32 = 40
	println(bi((v << n32) == cast(int64, 1099511627776)))   // 1: 1<<40, count int32
	var u uint64 = 0xFF00
	var s16 int16 = 8
	println(bi((u >> s16) == cast(uint64, 255)))            // 1: 0xFF00>>8, count int16
	// `int64 << int` — the exact 32-bit-int regression shape.
	var vi int64 = 1
	var ni int = 20
	println(bi((vi << ni) == cast(int64, 1048576)))         // 1: 1<<20, count plain int

	// --- count WIDER than the value; in range ---
	var b8 uint8 = 3
	var w int = 5
	println(bi((b8 << w) == cast(uint8, 96)))               // 1: 3<<5 = 96 (u8)
	var sb int8 = 1
	var w2 int64 = 6
	println(bi((sb << w2) == cast(int8, 64)))               // 1: 1<<6 = 64 (i8)

	// --- count WIDER than the value; OVERSHIFT (count >= width) ---
	var b8o uint8 = 0xFF
	var big int = 40
	println(bi((b8o << big) == cast(uint8, 0)))             // 1: u8 << 40 -> 0
	var u16o uint16 = 0xFFFF
	var big2 int64 = 100
	println(bi((u16o >> big2) == cast(uint16, 0)))          // 1: u16 >> 100 -> 0

	// --- arithmetic >> sign-fill, wide count, overshift ---
	var neg int8 = cast(int8, 0) - cast(int8, 1)            // -1
	var big3 int = 50
	println(bi((neg >> big3) == (cast(int8, 0) - cast(int8, 1)))) // 1: -1 >> -> -1

	// --- compound shift-assign with a count of a different/wider type ---
	var c int64 = 1
	var cn int32 = 33
	c <<= cn
	println(bi(c == cast(int64, 8589934592)))               // 1: 1<<33
	var d uint8 = 0xFF
	var dn int = 12
	d <<= dn                                                // overshift -> 0
	println(bi(d == cast(uint8, 0)))                        // 1
}
