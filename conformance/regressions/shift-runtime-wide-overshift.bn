package "main"

// A shift whose COUNT is a genuine RUNTIME value of a TYPE wider than the
// value, with count >= 2^valueWidth but count mod 2^valueWidth < valueWidth,
// must still detect the overshift: count >= width yields 0 for a logical
// shift and sign-fill for an arithmetic >>.  The count is read through an
// opaque (non-inlined) function so it is not constant-folded — a constant
// count is handled by a separate compile-time path; this exercises the
// runtime path, where the count is reconciled to the value width before the
// overshift guard runs.  Each line is a target-stable 0/1 self-check.

func bi(b bool) int {
	if b { return 1 }
	return 0
}

// opaque8 / opaque16 / opaqueI defeat constant-folding: the returned value
// is a runtime call result, not a compile-time constant.
func opaque8(x uint8) uint8 { return x }
func opaque16(x uint16) uint16 { return x }
func opaqueI(x int) int { return x }

func main() {
	// uint8 << runtime uint16 261: 261 >= 256, residue 261 mod 256 = 5 < 8.
	// Spec overshift -> 0 (a truncate-then-guard bug yields 1 << 5 = 32).
	var v uint8 = 1
	var c uint16 = opaque16(cast(uint16, 261))
	println(bi((v << c) == cast(uint8, 0)))     // 1

	// uint8 << runtime int 256: residue 0 < 8.  Spec 0 (bug yields 0xFF << 0).
	var v2 uint8 = 0xFF
	var c2 int = opaqueI(256)
	println(bi((v2 << c2) == cast(uint8, 0)))   // 1

	// uint8 >> runtime uint16 263: residue 7 < 8.  Spec 0 (bug yields 0xFF >> 7 = 1).
	var v3 uint8 = 0xFF
	var c3 uint16 = opaque16(cast(uint16, 263))
	println(bi((v3 >> c3) == cast(uint8, 0)))   // 1

	// signed int8 -4 >> runtime int 256: residue 0.  Spec sign-fill -> -1
	// (bug yields -4 >> 0 = -4).
	var v4 int8 = cast(int8, 0) - cast(int8, 4)
	var c4 int = opaqueI(256)
	println(bi((v4 >> c4) == (cast(int8, 0) - cast(int8, 1)))) // 1

	// SAME-width count of the OTHER signedness: int8 value << uint8 200.
	// 200 is non-negative as a uint8 (its true type) and >= 8 -> overshift -> 0.
	// Reading the count in the VALUE's (signed) type would see -56 < 8 and
	// wrongly shift in range.
	var v5 int8 = cast(int8, 15)
	var c5 uint8 = opaque8(cast(uint8, 200))
	println(bi((v5 << c5) == cast(int8, 0)))    // 1

	// COMPOUND-ASSIGN forms must guard identically to the expression forms —
	// the IDENT lvalue arm must NOT pre-truncate the count before the overshift
	// guard runs.  uint8 <<= runtime uint16 261 (residue 5): spec 0.
	var cv uint8 = 1
	var cc uint16 = opaque16(cast(uint16, 261))
	cv <<= cc
	println(bi(cv == cast(uint8, 0)))           // 1

	// uint8 >>= runtime uint16 263 (residue 7): spec 0.
	var cv2 uint8 = 0xFF
	var cc2 uint16 = opaque16(cast(uint16, 263))
	cv2 >>= cc2
	println(bi(cv2 == cast(uint8, 0)))          // 1

	// signed arithmetic >>= wide overshift: int8 -4 >>= runtime int 256: spec -1.
	var cv3 int8 = cast(int8, 0) - cast(int8, 4)
	cv3 >>= opaqueI(256)
	println(bi(cv3 == (cast(int8, 0) - cast(int8, 1))))  // 1
}
