package "main"

import "pkg/builtins/testing"

// A layout read during collection does not collect a slice's element, so a type
// reached only through one is collected in its turn, when what its own layout
// depends on is: E's array, the size of D, which holds N, whose array reads M's size,
// is that size whichever is declared first, and so through a generic's instance.

type N1 struct { v int64; a [sizeof(M1)]uint8 }

type M1 struct { s *[]D1 }

type D1 struct { n N1; e *[]E1 }

type E1 struct { a [sizeof(D1)]uint8 }

type E2 struct { a [sizeof(D2)]uint8 }

type N2 struct { v int64; a [sizeof(M2)]uint8 }

type M2 struct { s *[]D2 }

type D2 struct { n N2; e *[]E2 }

type Box[T any] struct { a [sizeof(T)]uint8 }

type N3 struct { v int64; p *Box[M3] }

type M3 struct { s *[]D3 }

type D3 struct { n N3; e *[]E3 }

type E3 struct { a [sizeof(D3)]uint8 }

// agree prints whether an array's length is the size it reads.
func agree(n int, size uint) {
	if n == cast(int, size) {
		testing.Println("ok")
	} else {
		testing.Println("mismatch")
	}
}

func main() {
	var e1 E1
	var e2 E2
	var e3 E3
	agree(len(e1.a), sizeof(D1))
	agree(len(e2.a), sizeof(D2))
	agree(len(e3.a), sizeof(D3))
}
