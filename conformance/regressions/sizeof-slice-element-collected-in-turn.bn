package "main"

import "pkg/builtins/testing"

// X's read of D's size does not collect E, which D holds through a slice, so E's
// read of D's size, in E's turn, finds D's field c collected: no type here is opaque.

type X struct { a [sizeof(D)]uint8 }

type D struct { s @[]E; c C0 }

type E struct { a [sizeof(D)]uint8 }

type C0 struct { c C1 }

type C1 struct { c C2 }

type C2 struct { c C3 }

type C3 struct { v int64 }

func main() {
	var x X
	var e E
	if len(x.a) == cast(int, sizeof(D)) && len(e.a) == len(x.a) {
		testing.Println("ok")
	} else {
		testing.Println("mismatch")
	}
}
