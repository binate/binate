package "main"
import "pkg/builtins/testing"

// Slicing a STRING LITERAL (`"abc"[:]`) must materialize it into a {data, len}
// slice before the slice logic runs.  A string literal's genExpr yields a bare
// `*readonly char` pointer (OP_CONST_STRING), not a slice, so genSliceExpr must
// convert it (EmitStringToChars) — otherwise the array-to-slice arm (keyed on
// TYP_ARRAY) misses it and EmitSliceLen `extractvalue`s field 1 off the pointer,
// which fails the LLVM verifier.  Covers the full slice, explicit bounds, an
// index of the result, and binding to a var.

func cc(cs *[]readonly char) int {
	return len(cs)
}

func main() {
	testing.Println(cc("hello"[:]))    // 5  (full slice)
	testing.Println(cc("hello"[1:4]))  // 3  (explicit bounds: "ell")
	testing.Println(cc(""[:]))         // 0  (empty string literal: {null, 0})
	var s *[]readonly char = "world"[:]
	testing.Println(len(s))            // 5
	testing.Println(s[0])              // 119 ('w')
	testing.Println("hello"[1:4][1])   // 108 ('l')
}
