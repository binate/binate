package "main"

// Slicing a STRING LITERAL (`"abc"[:]`) emits invalid LLVM and fails the
// verifier: `extractvalue` is applied to the `i8*` string-constant pointer
// instead of a `%BnSlice` aggregate.  genSliceExpr (pkg/binate/ir/gen_access.bn)
// only array-to-slice-converts a collection whose type is TYP_ARRAY; a string
// literal's genExpr yields a bare `i8*` CONST_STRING that misses that arm, so
// the subsequent EmitSliceLen (`extractvalue ..., 1`) runs against the pointer.
//
// The bare call `cc("abc"[:])` is a plain non-variadic call with a plain
// argument — no variadics, no spread — so this is independent of the variadic
// work; it is xfail'd in EVERY mode until genSliceExpr materializes a string
// literal into a {data, len} slice (or char array) before slicing.  Tracked in
// explorations/claude-todo.md.

func cc(cs *[]readonly char) int {
	return len(cs)
}

func main() {
	println(cc("abc"[:]))  // 3 (once string-literal slicing is fixed)
}
