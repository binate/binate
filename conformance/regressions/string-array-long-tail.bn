package "main"

import "pkg/builtins/testing"

// A string literal stored into a long char array fills its first bytes and zeroes the rest:
// in a loop that dirties the array each time (each iteration starts from the literal again),
// in a function called twice, passed on to a by-value array parameter, as a struct literal's
// field, and in a package variable.

type T struct {
	name [64]char
}

var g [20000]char = "hi"

func fill() int {
	var s [20000]char = "hello"
	var sum int = 0
	for i := 0; i < 20000; i++ {
		sum = sum + cast(int, s[i])
	}
	s[19999] = 'x'
	return sum
}

func countNonZero(s [20000]char) int {
	var n int = 0
	for i := 0; i < 20000; i++ {
		if s[i] != 0 { n = n + 1 }
	}
	return n
}

func main() {
	var total int = 0
	for k := 0; k < 3; k++ {
		var s [20000]char = "hi"
		total = total + cast(int, s[0]) + cast(int, s[1]) + cast(int, s[2]) + cast(int, s[19999])
		s[19999] = 'z'
		s[2] = 'q'
	}
	testing.Println(total)
	testing.Println(fill())
	testing.Println(fill())
	var a [20000]char = "abc"
	testing.Println(countNonZero(a))
	var t T = T{name: "abc"}
	testing.Println(
			cast(int, t.name[0]) + cast(int, t.name[1]) + cast(int, t.name[2]) + cast(int, t.name[3]) +
					cast(int, t.name[63]))
	testing.Println(cast(int, g[0]) + cast(int, g[1]) + cast(int, g[19999]))
}
