package "main"
import "pkg/builtins/testing"

// Regression: testing.Println must correctly format 64-bit scalar values
// (uint64 / int64 / float64) on a 32-bit VM host.  Each operand is boxed into an
// *any and read back via reflect for formatting; a 64-bit scalar must survive
// that round-trip whole -- both 32-bit halves preserved -- rather than losing
// its high word.  Small ints / chars never exercise the high 32 bits, so this
// uses values whose high word is significant.
func main() {
	var a uint64 = 5000000000
	testing.Println(a)
	var b int64 = -5000000000
	testing.Println(b)
	var c uint64 = 18446744073709551615
	testing.Println(c)
	var d int64 = 9223372036854775807
	testing.Println(d)
	var e uint32 = 4000000000
	testing.Println(e)
	var f float64 = 3.5
	testing.Println(f)
}
