package "main"

import "pkg/builtins/testing"

func f(x T) [3]int {
	var a [3]int
	return a
}

// V's array length needs only f's result type, so V is a [3]int and K is 3,
// though f's parameter type, resolved while V's type is found, reads K.
var V [len(f(T{}))]int

type T [K]int

const K = len(V)

func main() {
	testing.Println(K)
	testing.Println(len(T{}))
}
