package "main"

// Unary minus `-x` on a NAMED integer type must type OP_NEG at the operand's
// underlying width.  A `TYP_NAMED` operand (e.g. `type U8 uint8`) misses the
// plain `TYP_INT` guard in genUnary's MINUS arm, so the result was typed host
// i64 — `sub i64 0, %i8` invalid IR on LLVM (a hard build break), and on the
// 32-bit primary target a named int64 would emit `sub i32 0, %i64` (silent
// truncation).  genUnary now peels the named wrapper before the width
// decision, exactly as the `~` arm does.  CR-2 Plan-1 Round-2: the NAMED
// variant of Defect 9 (whose fix gated on `Kind == TYP_INT`).
//
// `(-x) >> k` forces the upper bits to matter (a host-width negation leaves
// dirty high bits).  Each line is a target-stable 0/1 self-check.

type U8 uint8
type U16 uint16
type U32 uint32
type I8 int8
type I16 int16
type I32 int32
type I64 int64

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// unsigned: -x = 2^N - x; logical >> sign-fills with 0
	var u8 U8 = 1
	println(bi(((-u8) >> 4) == cast(U8, 15)))            // 1  (255>>4)
	var u16v U16 = 1
	println(bi(((-u16v) >> 8) == cast(U16, 255)))        // 1  (65535>>8)
	var u32v U32 = 1
	println(bi(((-u32v) >> 16) == cast(U32, 65535)))     // 1
	var u8b U8 = 200
	println(bi(((-u8b) >> 2) == cast(U8, 14)))           // 1  (56>>2)

	// signed: -x then arithmetic >> sign-fills with the sign bit
	var i8v I8 = 1
	println(bi(((-i8v) >> 4) == (cast(I8, 0) - cast(I8, 1))))      // 1  (-1>>4=-1)
	var i16v I16 = 1
	println(bi(((-i16v) >> 8) == (cast(I16, 0) - cast(I16, 1))))   // 1
	var i32v I32 = 1
	println(bi(((-i32v) >> 16) == (cast(I32, 0) - cast(I32, 1))))  // 1
	// named int64: host-stable here, the truncation guard for 32-bit targets
	var i64v I64 = 1
	println(bi(((-i64v) >> 32) == (cast(I64, 0) - cast(I64, 1))))  // 1
}
