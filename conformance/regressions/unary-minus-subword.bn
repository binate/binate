package "main"

// Unary minus `-x` on a SUB-WORD int must yield a result typed at the
// operand's width, not host int.  Consuming it through `>> k` forces the
// upper bits to matter: a host-width negation leaves dirty high bits (or
// emits invalid `sub i64 %i8` IR), so `(-x) >> k` reads wrong.  CR-2
// Plan-1 Defect 9 — the analog of the fixed `~` bitnot-result-type bug.
// Each line is a target-stable 0/1 self-check (only the bool is printed).

func bi(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// unsigned: -x = 2^N - x; logical >> sign-fills with 0
	var u8 uint8 = 1
	println(bi(((-u8) >> 4) == cast(uint8, 15)))          // 1  (255>>4)
	var u16v uint16 = 1
	println(bi(((-u16v) >> 8) == cast(uint16, 255)))      // 1  (65535>>8)
	var u32v uint32 = 1
	println(bi(((-u32v) >> 16) == cast(uint32, 65535)))   // 1  (2^32-1>>16)
	var u8b uint8 = 200
	println(bi(((-u8b) >> 2) == cast(uint8, 14)))         // 1  (56>>2)

	// signed: -x then arithmetic >> sign-fills with the sign bit
	var i8v int8 = 1
	println(bi(((-i8v) >> 4) == (cast(int8, 0) - cast(int8, 1))))    // 1  (-1>>4=-1)
	var i16v int16 = 1
	println(bi(((-i16v) >> 8) == (cast(int16, 0) - cast(int16, 1)))) // 1
	var i32v int32 = 1
	println(bi(((-i32v) >> 16) == (cast(int32, 0) - cast(int32, 1)))) // 1
}
