package "main"

// R holds P by value and P holds R: a recursive type.  Box[P] is built while N is
// collected, and its read of P's layout walks P, then Q, whose `sizeof(N)` makes the
// build wait; the cycle met in that walk is reported when the build is done again,
// not dropped with what the waiting build reports.

type Box[T any] struct { a [sizeof(T)]uint8 }

type P struct { q Q; r R }

type R struct { p P }

type N struct { p *Box[P]; v int64 }

type Q struct { x [sizeof(N)]uint8 }

func main() {}
