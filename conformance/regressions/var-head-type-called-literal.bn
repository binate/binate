package "main"

import "pkg/builtins/testing"

// A function literal called where it is written spells its type at its head, its
// signature's one result, known before its body is checked: b's array length
// reads a's type, `[3]int`, without waiting for a's body, which reads b.  b is
// initialized first.
var b = [len(a)]int{}

var a = func() [3]int {
	var r [3]int
	r[0] = len(b)
	return r
}()

func main() {
	testing.Println(len(b))
	testing.Println(a[0])
}
