package "main"

import "pkg/builtins/testing"

// w's type is the one its initializer spells at its head, so a's check, which
// needs it, does not check w's elements; checked later, w's element x is read
// with its type, from a's.  a is initialized first, then x, then w.
var a = len([len(w)]int{})

var w = [2]int{x, 0}

var x = a + 1

func main() {
	testing.Println(a)
	testing.Println(x)
	testing.Println(w[0])
}
