package "main"

import "pkg/builtins/testing"

// t's type is mk's result, [3]int, though mk's parameter's array length reads t
// while mk's signature is being resolved: the result type alone gives t's type.
// The same for u and the method m.
var t = mk(nil)

func mk(p *([len(t)]int)) [3]int {
	var r [3]int
	r[0] = 7
	if p != nil {
		r[0] = len(*p)
	}
	return r
}

type R struct {
	n int
}

var v R

var u = v.m(nil)

func (r R) m(p *([len(u)]int)) [3]int {
	var a [3]int
	a[1] = 5
	return a
}

func main() {
	var a [3]int
	testing.Println(len(t), t[0], mk(&a)[0], len(u), u[1])
}
