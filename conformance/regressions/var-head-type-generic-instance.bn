package "main"

import "pkg/builtins/testing"

// t's type is mk[int64]'s result, [8]int, its length taken from T, though mk's
// parameter's array length reads t while mk's signature is not resolved yet; A,
// declared before mk, has t's length.  The same for u, the result of the method
// m of B's instance B[int32], and C.
type A [len(t)]int

var t = mk[int64](nil)

func mk[T any](p *([len(t)]int)) [sizeof(T)]int {
	var r [sizeof(T)]int
	r[0] = 7
	if p != nil {
		r[0] = len(*p)
	}
	return r
}

type B[T any] struct {
	n T
}

var v B[int32]

type C [len(u)]int

var u = v.m(nil)

func (r B[T]) m(p *([len(u)]int)) [sizeof(T)]int {
	var a [sizeof(T)]int
	a[1] = 5
	return a
}

func main() {
	var x A
	var a [8]int
	var y C
	testing.Println(len(x), len(t), t[0], mk[int64](&a)[0], len(y), len(u), u[1])
}
