package "main"

import "pkg/builtins/testing"

// b's type is the one its initializer spells at its head, so a's check, which
// needs it, does not check b's elements; when b's are checked, a has its type,
// int, which a bool element rejects.
var a = len([len(b)]int{})

var b = [3]bool{a, true, false}

func main() {
	testing.Println(a)
	testing.Println(b[0])
}
