package "main"

import "pkg/builtins/testing"

// p's type is w's, which w's initializer spells at its head, so it does not wait
// for w's elements, which read a, whose array length reads p: declared in this
// order the three check as in any other.
var p = w

var w = [3]bool{a == 3, true, false}

var a = len([len(p)]int{})

func main() {
	testing.Println(a)
	testing.Println(len(p))
	testing.Println(w[0])
}
