package "main"

import "pkg/builtins/testing"

// u's initializer spells its type at its head, `[len(w)]int`, which needs w's
// type; w's initializer spells none, so its type depends on what it names,
// u: u's type depends on itself, a variable type cycle.  (Read before its turn,
// u has no type while its head is found, so w's check must not take u, here
// passed where a @S is wanted, for an error already reported.)
type S struct {
	arr [3]int
}

func mk(p @S) S {
	return *p
}

func main() {
	testing.Println(len(u))
	testing.Println(w[0])
}

var u = [len(w)]int{5, 6, 7}

var w = mk(u).arr
