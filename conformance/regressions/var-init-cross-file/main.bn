package "main"

import "pkg/foo"

// foo.Derived reads foo.Base, but lives in an alphabetically-EARLIER file
// (a_derived.bn < b_base.bn).  Under filename/source order Derived would
// initialize first and read Base's zero value (giving 1); dependency order
// initializes Base first, so Derived is 42.
func main() {
	println(foo.Derived)
}
