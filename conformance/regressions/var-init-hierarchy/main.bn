package "main"
import "pkg/builtins/testing"

import "pkg/hier"

// Diamond dependency Root <- {A, B} <- Leaf, spread across files whose
// alphabetical order (a_leaf < b_a < c_b < d_root) is the REVERSE of the
// initialization order.  Dependency order yields Leaf=32, A=11, B=21, Root=1;
// filename/source order would read zeros (Leaf=0, A=10, B=20).
func main() {
	testing.Println(hier.Leaf)
	testing.Println(hier.A)
	testing.Println(hier.B)
	testing.Println(hier.Root)
}
