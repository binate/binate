package "main"

import "pkg/builtins/testing"

// len of an array does not evaluate its operand (builtin.len), so a's
// initializer, taking the length of an array that a type assertion on sh
// recovers, does not read sh: sh's initializer reading a is no cycle.  a is
// initialized first, while sh is still nil.

interface Shape {
	Area() int
}

type Bx struct {
	arr [3]int
}

func (q *Bx) Area() int { return 0 }

impl *Bx : Shape

var q0 Bx

func mk(n int) *Shape {
	q0.arr[0] = n
	return &q0
}

var a int = len(sh.(*Bx).arr)

var sh *Shape = mk(a)

func main() {
	testing.Println(a)
	testing.Println(sh.(*Bx).arr[0])
}
