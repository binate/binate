package "main"

import "pkg/builtins/testing"

// len of an array does not evaluate its operand (builtin.len), also when a type
// assertion recovers the array's struct as a type of an imported package: a's
// initializer, taking the length of an array field of what sh recovers as a
// *bx.Bx, does not read sh, so sh's initializer reading a is no cycle.  a is
// initialized first, while sh is still nil.
import "pkg/bx"

var q0 bx.Bx

func mk(n int) *bx.Shape {
	q0.arr[0] = n
	return &q0
}

var a int = len(sh.(*bx.Bx).arr)

var sh *bx.Shape = mk(a)

func main() {
	testing.Println(a)
	testing.Println(sh.area())
}
