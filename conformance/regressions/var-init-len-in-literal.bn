package "main"

import "pkg/builtins/testing"

// len of an array does not evaluate its operand (builtin.len), also in the body
// of an immediately-invoked literal: n's initializer, taking the length of the
// package's array ar, does not read ar, so ar's initializer reading n is no
// cycle.  n is initialized first.
var n = func() int { return len(ar) }()

var ar [3]int = [3]int{n, 0, 0}

func main() {
	testing.Println(n)
	testing.Println(ar[0])
}
