package "main"

import "pkg/builtins/testing"

// len of an array does not read it, whether the array's type is declared or
// inferred: a's initializer takes the length of b, whose own initializer reads
// a, so a is initialized first; so is c, from the length of a field of e.
type S struct {
	arr [3]int
	n   int
}

func mk(n int) S {
	var s S
	s.n = n
	return s
}

var a = len(b)

var b = [3]int{a, 0, 0}

var c = len(e.arr)

var e = mk(c)

func main() {
	testing.Println(a, b[0], c, e.n)
}
