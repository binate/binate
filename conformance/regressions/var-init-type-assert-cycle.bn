package "main"

import "pkg/builtins/testing"

// a reads sh through a type assertion, and sh's initializer reads a: no valid
// initialization order.

interface Shape {
	Area() int
}

type Sq struct {
	s int
}

func (q *Sq) Area() int { return q.s }

impl *Sq : Shape

var q0 Sq

func mk(n int) *Shape {
	q0.s = n
	return &q0
}

var a = sh.(*Sq).s

var sh *Shape = mk(a)

func main() {
	testing.Println(a)
}
