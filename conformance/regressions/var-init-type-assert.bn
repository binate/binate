package "main"

import "pkg/builtins/testing"

// Each initializer below reads sh through a type assertion, declared before sh:
// sh (and the q it points at) is initialized first, so each recovers q.s.

interface Shape {
	Area() int
}

type Sq struct {
	s int
}

func (q *Sq) Area() int { return q.s }

impl *Sq : Shape

var a = sh.(*Sq).s

var b = func() int {
	v, ok := sh.(*Sq)
	if ok {
		return v.s
	}
	return -1
}()

var c = func() int {
	var v *Sq
	var ok bool
	v, ok = sh.(*Sq)
	if ok {
		return v.s
	}
	return -1
}()

var d = func() int {
	switch v := sh.(type) {
	case *Sq:
		return v.s
	}
	return -1
}()

var q Sq = Sq{s: 7}

var sh *Shape = &q

func main() {
	testing.Println(a)
	testing.Println(b)
	testing.Println(c)
	testing.Println(d)
}
