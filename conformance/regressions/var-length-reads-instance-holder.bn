package "main"

import "pkg/builtins/testing"

// v's length reads R's size, which is P's: P holds Box[R] only through a pointer, so
// there is no cycle, though Box[R]'s field reads R's size -- with v declared before
// the types as after them.
var v [sizeof(R)]int

type R struct {
	p P
}

type P struct {
	b *Box[R]
}

type Box[X any] struct {
	pad [sizeof(X)]uint8
}

func main() {
	testing.Println(cast(uint, len(v)) == sizeof(P))
}
