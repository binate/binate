package "main"

import "pkg/builtins/testing"

// v's declared type has an array length that needs w's type; w's initializer
// spells none at its head, so w's type depends on what it names, v, which w's
// call reads while v's type is resolved.  v's type depends on itself, a variable
// type cycle.  (w's check must not take v, here passed where a bool is wanted,
// for an error already reported.)
type S struct {
	arr [3]int
}

func h(n bool) S {
	var s S
	return s
}

func main() {
	testing.Println(len(v))
	testing.Println(w[0])
}

var v [len(w)]int

var w = h(v).arr
