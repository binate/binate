package "main"

import "pkg/builtins/testing"

// Neither initializer spells its type at its head, so each one's type depends
// on what it names: a's on b's, through an array length, and b's on a's, which
// b's call reads while a's type is found.  a's type depends on itself, a
// variable type cycle.  (b's check must not take a, here passed where a bool is
// wanted, for an error already reported.)
type S struct {
	arr [3]int
}

func h(n bool) S {
	var s S
	return s
}

func main() {
	testing.Println(a)
	testing.Println(b[0])
}

var a = len([len(b)]int{})

var b = h(a).arr
