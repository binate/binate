package "main"

import "pkg/builtins/testing"

// a's initializer spells no type at its head (a field of a call's result), so
// its type depends on what it names, a itself, read in the function literal's
// body while a's type is found: a variable type cycle.  (The body's check must
// not take a's element, here assigned to a bool, for an error already
// reported.)
type S struct {
	arr [3]int
}

func g(f @func() int) S {
	var s S
	return s
}

func main() {
	testing.Println(a[0])
}

var a = g(func() int {
	var t bool = a[0]
	_ = t
	return 0
}).arr
