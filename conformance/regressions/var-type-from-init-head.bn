package "main"

import "pkg/builtins/testing"

// A variable named while its own type is found takes the type its initializer
// spells at its head, before the initializer's operands are checked: here a
// function literal's signature, and a method call's result.

var b = [3]int{a(), 0, 0}

var a = func() int { var x [len(b)]int; return len(x) }

type S struct {
	arr [3]int
	f   @func() int
}

type M struct {
	k int
}

func (m M) mk(f @func() int) S {
	var s S
	s.f = f
	return s
}

var m M

var h = m.mk(func() int { var x [len(h.arr)]int; return len(x) })

func main() {
	testing.Println(b[0])
	testing.Println(h.f())
}
