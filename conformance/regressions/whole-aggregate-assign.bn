package "main"
import "pkg/builtins/testing"

// Whole-array and whole-struct `=` assignment used to silently store the
// RHS composite literal's alloca POINTER instead of copying the aggregate
// value, so the destination kept its old contents (a no-op assignment).
// The ident and deref assignment arms in IR-gen (gen_control.bn) now load
// the aggregate out of its OP_ALLOC before the store, matching the
// selector arm.  Covers `arr = {...}`, `arr = other`, `s = {...}`,
// `s = other`, and `*p = {...}`.

type Pt struct {
	X int
	Y int
}

func main() {
	var a [3]int = [3]int{1, 2, 3}
	a = [3]int{10, 20, 30} // whole-array = composite literal
	testing.Println(a[0])          // 10
	testing.Println(a[2])          // 30
	var c [3]int = [3]int{7, 8, 9}
	a = c         // whole-array = variable
	testing.Println(a[1]) // 8
	var p Pt = Pt{X: 1, Y: 2}
	p = Pt{X: 40, Y: 50} // whole-struct = composite literal
	testing.Println(p.X)         // 40
	testing.Println(p.Y)         // 50
	var q Pt = Pt{X: 33, Y: 44}
	p = q         // whole-struct = variable
	testing.Println(p.Y)  // 44
	var d [3]int = [3]int{0, 0, 0}
	var pd *([3]int) = &d
	*pd = [3]int{5, 6, 7} // deref whole-array assignment
	testing.Println(d[2])         // 7
}
