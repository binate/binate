package "main"

// Storing a whole-inner-array composite literal `[M]T{...}` through a
// SLICE/POINTER element or a STRUCT field-init must store the array VALUE,
// not the inner alloca POINTER.  Three store arms still used the struct-only
// guard (`OP_ALLOC && TypeArg.Kind == TYP_STRUCT`) instead of the shared
// isAggregateAllocToLoad predicate, so an inner ARRAY literal (TypeArg ==
// TYP_ARRAY) stored its 8-byte alloca pointer raw → garbage; the managed-inner
// variant additionally double-frees the misplaced value at scope exit.
//
// CR-2 Plan-1 Round-2: the slice-element + struct-field-init siblings of
// Defect 6 (which migrated only the array-index-assign and array-literal arms).
// Expected: 11 / 15 / 19 / 43

type S struct {
	arr [2]int
}

func main() {
	// (a) raw-slice element: `*[][2]T` index store (gen_control pointer arm).
	var backing [3][2]int
	var rs *[][2]int = backing[:]
	rs[0] = [2]int{5, 6}
	println(rs[0][0] + rs[0][1])         // 11

	// (b) managed-slice element: `@[][2]T` set (gen_control slice-set arm).
	var ms @[][2]int = make_slice([2]int, 2)
	ms[0] = [2]int{7, 8}
	println(ms[0][0] + ms[0][1])         // 15

	// (d) struct field-init: `S{ [2]int{...} }` (gen_composite field arm).
	var x S = S{ arr: [2]int{9, 10} }
	println(x.arr[0] + x.arr[1])         // 19

	// (c) managed-inner element: the stored inner array holds managed slices,
	// so the value-copy must RefInc them.  Drop the originals (reassign s0/s1)
	// BEFORE reading back through mi — if the copy missed its RefInc the
	// backings are now freed (UAF / wrong value); a correct copy keeps mi's
	// elements alive at rc>=1.
	var s0 @[]int = make_slice(int, 1)
	s0[0] = 21
	var s1 @[]int = make_slice(int, 1)
	s1[0] = 22
	var mi @[][2]@[]int = make_slice([2]@[]int, 1)
	mi[0] = [2]@[]int{ s0, s1 }
	s0 = make_slice(int, 1)              // release the original s0 backing
	s1 = make_slice(int, 1)              // release the original s1 backing
	println(mi[0][0][0] + mi[0][1][0])   // 43 (mi still owns the originals)
}
