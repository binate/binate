package "main"

// Edge case for the generic-impl cross-mode "gap": `main` receives a Box[int]
// instantiation from pkg/gp (Make) and BOXES it into a @gp.Iter[int] here, then
// dispatches Next().  The box happens in the CONSUMER, so if the consumer failed
// to re-instantiate Box[int].Next, the vtable would be incomplete / not-found.
// It works because monomorphization emits Box[int]'s methods at this use-site.

import "pkg/gp"

func main() {
	var b @gp.Box[int] = gp.Make(42)
	var it @gp.Iter[int] = b
	println(it.Next()) // 42
}
