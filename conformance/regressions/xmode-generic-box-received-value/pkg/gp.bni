package "pkg/gp"

interface Iter[T any] {
	Next() T
}

type Box[T any] struct {
	v T
}

// Box's method and impl are in the interface, so that the consumer, which boxes a
// Box[int] it receives, sees them (pkg.export); a generic method's body travels
// in the interface (pkg.bni.generic).
func (b @Box[T]) Next() T {
	return b.v
}

impl @Box[T] : Iter[T]

func Make(x int) @Box[int]
