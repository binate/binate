package "pkg/gp"

func (b @Box[T]) Next() T {
	return b.v
}

impl @Box[T] : Iter[T]

// Make returns a Box[int] INSTANTIATION built here in gp — the consumer receives
// the value and boxes it there, so the consumer's BC_IFACE_VALUE / OP_IFACE_VALUE
// site must re-instantiate Box[int]'s methods locally (ensureInstantiatedMethods)
// rather than depend on gp's copy.
func Make(x int) @Box[int] {
	var b @Box[int] = make(Box[int])
	b.v = x
	return b
}
