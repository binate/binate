package "main"
import "pkg/builtins/testing"

// lex.literal.int.bases: hexadecimal digits may be upper- or lower-case;
// 0xAb and 0xaB denote the same value (case folds within the digits too).
func main() {
	if 0xAb == 0xaB && 0xAB == 171 && 0xab == 171 { testing.Println("ok") } else { testing.Println("FAIL") }
}
