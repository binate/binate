package "main"

// lex.literal.int.bases / lex.error.illegal: octal admits digits 0-7 only, so
// 0o8 is not a valid octal literal -- the whole numeral is one illegal token.
// (The parser's only diagnostic is generic; rejection is attributable to the
// bad digit because the rule-satisfying neighbor 0o7 compiles.)
func main() {
	var x int = 0o8
	_ = x
}
