package "main"

// lex.literal.int.bases / lex.error.illegal: binary admits digits 0-1 only, so
// 0b2 is not a valid binary literal -- the whole numeral is one illegal token.
// (The parser's only diagnostic is generic; rejection is attributable to the
// bad digit because the rule-satisfying neighbor 0b1 compiles.)
func main() {
	var x int = 0b2
	_ = x
}
