package "main"

// lex.literal.int.zero: the prefixed forms 0x/0o/0b are the only way to write
// hex/octal/binary -- there is NO C-style leading-zero octal, so 0o10 is octal
// (==8) while a bare decimal 10 is ten.
func main() {
	if 0o10 == 8 && 10 == 10 && 0x10 == 16 && 0b10 == 2 { println("ok") } else { println("FAIL") }
}
