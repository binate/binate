package "main"

// lex.literal.int.leading-zero: 09 has no base prefix, so it is never octal --
// a multi-digit numeral beginning with 0 is a lexical error and the whole
// numeral is one illegal token. (The parser's diagnostic is generic and does
// not itself separate this from a base-digit error; the point is that 09 is
// rejected, not silently read as octal or decimal.)
func main() {
	var x int = 09
	_ = x
}
