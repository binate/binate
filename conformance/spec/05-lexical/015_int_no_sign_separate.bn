package "main"
import "pkg/builtins/testing"

// lex.literal.int.no-sign: an integer literal contains no sign -- a leading - is
// a separate binary/unary operator, never part of the literal. Whether spaced
// or not (5-3, 5 - 3, 5- 3) the subtraction yields 2, proving the sign is not
// glued to the digits.
func main() {
	if 5 - 3 == 2 && 5-3 == 2 && 5- 3 == 2 { testing.Println("ok") } else { testing.Println("FAIL") }
}
