package "main"
import "pkg/builtins/testing"

// lex.literal.int.no-sign: -5 is the unary-minus operator applied to the literal
// 5, not a signed literal -- so var x int = -5 equals 0 - 5, and negating a
// variable (-x) behaves identically. The literal token is plain 5.
func main() {
	var x int = -5
	var y int = 5
	if x == 0 - 5 && -y == 0 - 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
