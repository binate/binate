package "main"

// lex.literal.int.no-separators: digit separators are not supported. A _
// immediately following digits ends the number and begins an identifier, so
// 1_000 lexes as the literal 1 followed by the identifier _000; the adjacency
// 1 _000 is then a syntax error (a ; is inserted between them).
func main() {
	var x int = 1_000
	_ = x
}
