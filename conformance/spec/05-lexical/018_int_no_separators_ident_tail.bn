package "main"

// lex.literal.int.no-separators: the tail produced by splitting 1_000 -- the
// underscore-led _000 -- is itself a perfectly valid identifier (a letter/_
// followed by digits), confirming that _ after digits begins an identifier
// rather than continuing the number.
func main() {
	var _000 int = 7
	if _000 == 7 { println("ok") } else { println("FAIL") }
}
