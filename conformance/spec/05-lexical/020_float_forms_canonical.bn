package "main"
import "pkg/builtins/testing"

// lex.literal.float.forms: the canonical float forms decode to the expected
// IEEE-754 values -- an integer part with a `.` and a fraction, and the
// leading-`.` form -- both denote the same value as the dotted spelling.
func main() {
    var ok bool = true
    if !(1.5 + 2.5 == 4.0) { ok = false }
    if !(0.25 == .25) { ok = false }
    if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
