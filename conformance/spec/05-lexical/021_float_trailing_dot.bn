package "main"

// lex.literal.float.forms: a trailing dot (`1.`) is a permitted float form --
// `digit { digit } "." { digit }` admits an empty fraction -- and equals the
// dotted-zero spelling.
func main() {
    var ok bool = true
    if !(1. == 1.0) { ok = false }
    if !(0. == 0.0) { ok = false }
    if !(42. == 42.0) { ok = false }
    if ok { println("ok") } else { println("FAIL") }
}
