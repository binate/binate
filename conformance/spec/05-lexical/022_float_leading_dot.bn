package "main"
import "pkg/builtins/testing"

// lex.literal.float.forms: the leading-`.` form (`. digit { digit }`) is a
// permitted float with no integer part, equal to `0.<frac>`.
func main() {
    var ok bool = true
    if !(.5 == 0.5) { ok = false }
    if !(.25 == 0.25) { ok = false }
    if !(.125 == 0.125) { ok = false }
    if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
