package "main"

// lex.literal.float.forms: the exponent `( "e" | "E" ) [ "+" | "-" ] digit...`
// is accepted with either case of `e`/`E`, with and without an explicit sign,
// on both dotted and exponent-only floats.
func main() {
    var ok bool = true
    if !(1e3 == 1000.0) { ok = false }
    if !(2E2 == 200.0) { ok = false }
    if !(1.5e2 == 150.0) { ok = false }
    if !(1.5E2 == 150.0) { ok = false }
    if !(1.5e-1 == 0.15) { ok = false }
    if !(1.5e+1 == 15.0) { ok = false }
    if !(1E+2 == 100.0) { ok = false }
    if !(1E-2 == 0.01) { ok = false }
    if ok { println("ok") } else { println("FAIL") }
}
