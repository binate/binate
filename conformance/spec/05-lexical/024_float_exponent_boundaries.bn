package "main"
import "pkg/builtins/testing"

// lex.literal.float.forms: the three grammar alternatives all admit an
// exponent -- integer-with-exponent (`5e0`), trailing-dot-with-exponent
// (`1.e2`), and leading-dot-with-exponent (`.5e1`) -- and decode correctly.
func main() {
    var ok bool = true
    if !(5e0 == 5.0) { ok = false }
    if !(1.e2 == 100.0) { ok = false }
    if !(.5e1 == 5.0) { ok = false }
    if !(.5e-1 == 0.05) { ok = false }
    if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
