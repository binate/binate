package "main"

// lex.literal.float.no-hexfloat: there is no literal syntax for NaN or
// infinity -- written bare, `NaN`/`Inf` are ordinary identifiers, so they can
// be declared and shadowed as user variables (proving they are not reserved).
func main() {
    var NaN int = 3
    var Inf int = 4
    if NaN == 3 && Inf == 4 { println("ok") } else { println("FAIL") }
}
