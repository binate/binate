package "main"
import "pkg/builtins/testing"

// lex.literal.float.range-carveout: a `.` between a value and a name is the
// selector operator (punctuation), not a float fraction -- field access `p.a`
// and `p.b` lex the `.` as the selector token and resolve to the fields.
type Pair struct {
    a int
    b int
}
func main() {
    var p Pair = Pair{ a: 10, b: 20 }
    if p.a + p.b == 30 { testing.Println("ok") } else { testing.Println("FAIL") }
}
