package "main"
import "pkg/builtins/testing"

// lex.literal.string.token: a string literal's value is the bytes between the
// quotes; len counts the decoded bytes, the empty literal "" has length 0, and
// an escape sequence decodes to ONE byte (so len("\n") == 1).
func main() {
	if len("abc") == 3 && len("") == 0 && len("\n") == 1 && len("a\tb") == 3 { testing.Println("ok") } else { testing.Println("FAIL") }
}
