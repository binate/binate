package "main"
import "pkg/builtins/testing"

// lex.literal.string.token: a non-ASCII byte inside a string literal is carried
// through verbatim, not Unicode-decoded. UTF-8 "é" is the two bytes 0xC3 0xA9,
// so its length is 2 and the bytes are exactly 195 and 169.
func main() {
	var s @[]readonly char = "é"
	if len(s) == 2 && cast(int, s[0]) == 195 && cast(int, s[1]) == 169 { testing.Println("ok") } else { testing.Println("FAIL") }
}
