package "main"
import "pkg/builtins/testing"

// lex.literal.string.no-concat: adjacent string literals are SEPARATE lexical
// tokens -- they are not joined by the lexer. Whatever whitespace (or none)
// sits between them is irrelevant, and an empty "" run is its own token; the
// joining seen here is the syntactic concatenation of Ch.13, not lexical.
func main() {
	if len("ab" "cd") == 4 && len("ab""cd") == 4 && len("a"  "b"  "c") == 3 && len("" "x" "") == 1 { testing.Println("ok") } else { testing.Println("FAIL") }
}
