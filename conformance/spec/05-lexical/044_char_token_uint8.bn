package "main"

// lex.literal.char.token: a character literal denotes a single byte value of
// type char, and char == uint8 (Ch.7), so 'A' is 65 and the value round-trips
// losslessly through a uint8.
func main() {
	var c char = 'A'
	var u uint8 = c
	if cast(int, c) == 65 && cast(int, u) == 65 { println("ok") } else { println("FAIL") }
}
