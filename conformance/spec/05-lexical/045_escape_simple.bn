package "main"

// lex.escape.set: the simple recognized escapes decode to their defined byte
// values inside a character literal.
func main() {
	if cast(int, '\n') == 10 && cast(int, '\r') == 13 && cast(int, '\t') == 9 && cast(int, '\\') == 92 && cast(int, '\'') == 39 && cast(int, '\"') == 34 && cast(int, '\0') == 0 { println("ok") } else { println("FAIL") }
}
