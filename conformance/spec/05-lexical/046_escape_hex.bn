package "main"
import "pkg/builtins/testing"

// lex.escape.set: \xHH decodes the byte named by two hexadecimal digits; the
// digits are case-insensitive and the escape spans the full 0x00..0xff byte
// range (boundary values 0x00 and 0xff included), e.g. \x41==65, \x7f==127.
func main() {
	if cast(int, '\x00') == 0 && cast(int, '\xff') == 255 && cast(int, '\x41') == 65 && cast(int, '\x7f') == 127 && cast(int, '\x1B') == 27 && cast(int, '\x0a') == 10 { testing.Println("ok") } else { testing.Println("FAIL") }
}
