package "main"

// lex.escape.unsupported: per §5.11 there is NO \uHHHH escape, so a \u escape
// should be diagnosed as an *unknown* escape sequence. XFAIL: the implementation
// HAS a \u handler -- this \u41 produces "\u escape requires four hex digits"
// (not "unknown escape sequence"), proving \u is recognized. The full divergence
// is that a 4-hex \uHHHH is accepted and UTF-8-encodes the codepoint. Decide
// spec vs impl: explorations/spec-todo.md (\u escape divergence, §5.11).
func main() {
	var c char = '\u41'
	_ = c
}
