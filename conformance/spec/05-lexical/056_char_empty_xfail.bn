package "main"

// lex.literal.char.one (Constraint): an empty character literal '' denotes zero
// bytes and is ill-formed, so it must be rejected at compile time. XFAIL: the
// implementation does NOT enforce this -- '' is silently decoded to the byte
// 0x00 with no diagnostic (open item; §5.10 note, §5.14).
func main() {
	var c char = ''
	_ = c
}
