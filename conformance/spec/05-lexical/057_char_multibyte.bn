package "main"

// lex.literal.char.one (Constraint): a character literal denoting more than one
// byte — like 'ab', or a multi-byte UTF-8 character such as 'é' (0xC3 0xA9) — is
// ill-formed and is rejected at compile time ("character literal must be one
// byte"; §5.10 note, §5.14).  Without the rule such a literal would silently
// truncate to its first byte ('a' == 97 / 'é' → 0xC3 == 195).
func main() {
	var c char = 'ab'
	_ = c
}
