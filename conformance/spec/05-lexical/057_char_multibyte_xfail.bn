package "main"

// lex.literal.char.one (Constraint): a character literal denoting more than one
// byte, like 'ab', is ill-formed and must be rejected. XFAIL: the implementation
// does NOT enforce this -- 'ab' is silently truncated to its first byte ('a' ==
// 97) with no diagnostic (open item; §5.10 note, §5.14, claude-todo).
func main() {
	var c char = 'ab'
	_ = c
}
