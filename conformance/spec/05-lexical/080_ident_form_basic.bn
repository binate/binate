package "main"

// lex.ident.form: an identifier begins with an ASCII letter or underscore and
// continues with letters/underscores/digits. `_` is lexically a valid identifier
// (used here as a declaration target); its discard semantics are defined later.
func main() {
    var _x123 int = 1
    var _000 int = 3
    var abc int = 4
    var _ int = _x123  // `_` is a valid identifier token here (a discard target)
    if _x123 == 1 && _000 == 3 && abc == 4 { println("ok") } else { println("FAIL") }
}
