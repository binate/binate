package "main"
import "pkg/builtins/testing"

// lex.ident.form: letters, digits, and underscores may appear (after the first
// char) in any order; a trailing underscore and interior digits are valid.
func main() {
    var a1_b2_c3 int = 1
    var _9 int = 2
    var Z_z_9_ int = 3
    var x123y456 int = 4
    if a1_b2_c3 == 1 && _9 == 2 && Z_z_9_ == 3 && x123y456 == 4 { testing.Println("ok") } else { testing.Println("FAIL") }
}
