package "main"
import "pkg/builtins/testing"

// lex.keywords.reserved: keyword matching is exact and case-sensitive, so the
// capitalized spellings `Func`, `Var`, `True`, `False`, `Nil` are ordinary
// identifiers (only the exact lowercase/`Self` spellings are reserved keywords).
func main() {
    var Func int = 1
    var Var int = 2
    var True int = 3
    var False int = 4
    var Nil int = 5
    if Func == 1 && Var == 2 && True == 3 && False == 4 && Nil == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
