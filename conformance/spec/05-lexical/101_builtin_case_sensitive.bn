package "main"
import "pkg/builtins/testing"

// lex.builtins.set: builtin-operation keywords are matched exactly, so the
// capitalized spellings `Len` and `Make` are ordinary identifiers, not builtins.
func main() {
    var Len int = 4
    var Make int = 5
    if Len == 4 && Make == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
