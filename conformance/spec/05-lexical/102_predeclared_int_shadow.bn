package "main"
import "pkg/builtins/testing"

// lex.predeclared.are-idents: `int` is a predeclared name, not a keyword, so it
// is lexically an ordinary identifier and may be shadowed by a user declaration.
func main() {
    var int int = 7
    if int == 7 { testing.Println("ok") } else { testing.Println("FAIL") }
}
