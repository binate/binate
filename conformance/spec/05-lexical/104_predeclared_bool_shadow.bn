package "main"
import "pkg/builtins/testing"

// lex.predeclared.are-idents: `bool` is predeclared, not a keyword; it may be
// shadowed by a user variable (distinct from the reserved keywords true/false/nil).
func main() {
    var bool int = 9
    if bool == 9 { testing.Println("ok") } else { testing.Println("FAIL") }
}
