package "main"
import "pkg/builtins/testing"

// lex.predeclared.are-idents: `float64`, `char`, and `any` are predeclared names,
// not keywords; each may be shadowed by a user variable.
func main() {
    var float64 int = 10
    var char int = 11
    var any int = 12
    if float64 == 10 && char == 11 && any == 12 { testing.Println("ok") } else { testing.Println("FAIL") }
}
