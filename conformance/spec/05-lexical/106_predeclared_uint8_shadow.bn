package "main"
import "pkg/builtins/testing"

// lex.predeclared.are-idents: the sized integer name `uint8` is predeclared, not
// a keyword, so it is an ordinary identifier and may be shadowed.
func main() {
    var uint8 int = 5
    if uint8 == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
