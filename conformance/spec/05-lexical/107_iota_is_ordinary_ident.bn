package "main"
import "pkg/builtins/testing"

// lex.predeclared.are-idents: `iota` is lexically an ordinary identifier (it has
// special meaning only inside a grouped `const` block, and is not a universe
// binding), so outside such a block it may name a user variable.
func main() {
    var iota int = 42
    if iota == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}
