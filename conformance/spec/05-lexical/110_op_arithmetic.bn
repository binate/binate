package "main"
import "pkg/builtins/testing"

// lex.operators.set: arithmetic operators + - * / % each produce checkable
// integer results, proving they are recognized as distinct operator tokens.
func main() {
	var ok bool = true
	if !(2 + 3 == 5) { ok = false }
	if !(7 - 4 == 3) { ok = false }
	if !(6 * 7 == 42) { ok = false }
	if !(20 / 4 == 5) { ok = false }
	if !(17 % 5 == 2) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
