package "main"
import "pkg/builtins/testing"

// lex.operators.set: bitwise operators & | ^ and unary ~ produce checkable
// results. Sub-expressions are parenthesized so the assertion does not depend
// on operator precedence.
func main() {
	var ok bool = true
	if !((0xF0 & 0x3C) == 0x30) { ok = false }
	if !((0xF0 | 0x0F) == 0xFF) { ok = false }
	if !((0xFF ^ 0x0F) == 0xF0) { ok = false }
	var a uint8 = 0x0F
	var b uint8 = ~a
	if !(cast(int, b) == 0xF0) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
