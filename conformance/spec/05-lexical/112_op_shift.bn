package "main"

// lex.operators.set: shift operators << and >> produce checkable results.
func main() {
	var ok bool = true
	if !((1 << 4) == 16) { ok = false }
	if !((3 << 0) == 3) { ok = false }
	if !((256 >> 3) == 32) { ok = false }
	if !((1 >> 1) == 0) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
