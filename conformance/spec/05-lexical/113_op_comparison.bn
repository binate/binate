package "main"
import "pkg/builtins/testing"

// lex.operators.set: comparison operators < > <= >= == != each evaluate as a
// distinct operator token. The <= >= == != two-byte forms also exercise
// maximal munch (each is one token).
func main() {
	var ok bool = true
	if !(3 < 5) { ok = false }
	if !(5 > 3) { ok = false }
	if !(3 <= 3) { ok = false }
	if !(5 >= 5) { ok = false }
	if !(4 == 4) { ok = false }
	if !(4 != 5) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
