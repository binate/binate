package "main"
import "pkg/builtins/testing"

// lex.operators.set: logical operators && || and unary ! evaluate as distinct
// operator tokens.
func main() {
	var ok bool = true
	if !(true && true) { ok = false }
	if (false && true) { ok = false }
	if !(false || true) { ok = false }
	if (false || false) { ok = false }
	if !(!false) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
