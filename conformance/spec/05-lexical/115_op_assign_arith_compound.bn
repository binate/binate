package "main"
import "pkg/builtins/testing"

// lex.operators.set: plain assignment =, short declaration :=, and the
// arithmetic compound-assignments += -= *= /= %= each update a variable.
func main() {
	var ok bool = true
	var a int = 10
	a = 20
	if !(a == 20) { ok = false }
	b := 7
	if !(b == 7) { ok = false }
	var c int = 10
	c += 5
	if !(c == 15) { ok = false }
	c -= 3
	if !(c == 12) { ok = false }
	c *= 2
	if !(c == 24) { ok = false }
	c /= 4
	if !(c == 6) { ok = false }
	c %= 4
	if !(c == 2) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
