package "main"
import "pkg/builtins/testing"

// lex.operators.set: bitwise and shift compound-assignments &= |= ^= <<= >>=
// each update a variable. The <<= >>= three-byte forms also exercise maximal
// munch (each is one token, not << then =).
func main() {
	var ok bool = true
	var c int = 0xF0
	c &= 0x3C
	if !(c == 0x30) { ok = false }
	c |= 0x0F
	if !(c == 0x3F) { ok = false }
	c ^= 0x0F
	if !(c == 0x30) { ok = false }
	var s int = 1
	s <<= 5
	if !(s == 32) { ok = false }
	s >>= 2
	if !(s == 8) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
