package "main"

// lex.operators.set: increment ++ and decrement -- statements each adjust a
// variable by one. Each is one token (maximal munch), not two unary signs.
func main() {
	var ok bool = true
	var i int = 5
	i++
	if !(i == 6) { ok = false }
	i++
	if !(i == 7) { ok = false }
	i--
	if !(i == 6) { ok = false }
	i--
	if !(i == 5) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
