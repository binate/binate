package "main"
import "pkg/builtins/testing"

// lex.punctuation.set: the structural punctuation ( ) { } , . ; in real
// constructs: a struct type and literal ({ } , and the : element separator),
// a field selector (.), a function call (( )), and ; as an explicit terminator.
type Pair struct {
	a int
	b int
}

func sum(p Pair) int { return p.a + p.b }

func main() {
	var ok bool = true
	var p Pair = Pair{a: 3, b: 4}
	if !(p.a == 3) { ok = false }
	if !(sum(p) == 7) { ok = false }
	var x int = 1; var y int = 2
	if !(x + y == 3) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
