package "main"
import "pkg/builtins/testing"

// lex.punctuation.set: the bracket tokens [ ] (array type, array literal, and
// indexing) and the colon : as the slice-expression separator inside [ ].
func main() {
	var ok bool = true
	var arr [4]int = [4]int{10, 20, 30, 40}
	if !(arr[2] == 30) { ok = false }
	var s *[]int = arr[1:3]
	if !(len(s) == 2 && s[0] == 20 && s[1] == 30) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
