package "main"

// lex.punctuation.set: '@' is the managed-pointer / managed-slice sigil, a
// single punctuation token. Here it forms a managed-pointer type @Cell; field
// access auto-dereferences through it.
type Cell struct {
	v int
}

func main() {
	var ok bool = true
	var c @Cell = make(Cell)
	c.v = 99
	if !(c.v == 99) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
