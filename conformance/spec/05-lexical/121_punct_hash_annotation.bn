package "main"

// lex.punctuation.set: '#' introduces an annotation block #[ ... ]. The
// annotation carries no runtime semantics here; this confirms '#' is a single
// punctuation token (alongside the [ ] ( ) . , of the annotation syntax).
#[tool.note(), tool.lint("x")]
func twice(n int) int { return n * 2 }

func main() {
	if twice(21) == 42 { println("ok") } else { println("FAIL") }
}
