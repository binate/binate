package "main"

// lex.punctuation.set: '...' is a single punctuation token (longest match, not
// '.' '.' '.'), used here as the inferred-length head of an array literal. This
// pins the '...' use site; it does not by itself isolate maximal munch (the
// parse is the same whether '...' is one token or three), so it cites only
// lex.punctuation.set. The inferred-length semantics are covered by
// spec/13-expressions/041.
func main() {
	a := [...]int{10, 20, 30}
	if len(a) == 3 && a[2] == 30 {
		println("ok")
	} else {
		println("FAIL")
	}
}
