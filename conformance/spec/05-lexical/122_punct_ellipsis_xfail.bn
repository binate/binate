package "main"

// lex.punctuation.set: '...' is a single punctuation token (longest match, not
// '.' '.' '.'), used here as an inferred array length. xfail: inferred-length
// array literals [...]T{} are not yet implemented (rejected at parse with
// "expected expression"). This pins the '...' use site; it does not by itself
// isolate maximal munch (the rejection is the same whether '...' is one token
// or three), so it cites only lex.punctuation.set. claude-todo (Ch.5).
func main() {
	var a [...]int = [...]int{10, 20, 30}
	if len(a) == 3 && a[2] == 30 { println("ok") } else { println("FAIL") }
}
