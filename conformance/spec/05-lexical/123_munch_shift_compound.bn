package "main"
import "pkg/builtins/testing"

// lex.operators.maximal-munch: <<= and >>= are each ONE token (longest match).
// If <<= were lexed as << then =, `x <<= 3` would parse as `x << (= 3)`, a
// syntax error; that it computes a result proves the greedy single-token match.
func main() {
	var ok bool = true
	var x int = 1
	x <<= 3
	if !(x == 8) { ok = false }
	x >>= 2
	if !(x == 2) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
