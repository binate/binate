package "main"

// lex.operators.maximal-munch: `>>=` is ONE token (longest match). Forcing a
// split by writing `>> =` makes `>>` a binary operator whose right operand
// begins with `=`, which cannot start an expression -> the program is rejected.
// This is the contrast case that makes the greedy `x>>=2` in 123 work.
func main() {
	var x int = 32
	x >> = 2
	_ = x
}
