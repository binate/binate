package "main"
import "pkg/builtins/testing"

// lex.whitespace: space (0x20) and horizontal tab (0x09) are whitespace; they
// separate tokens and collapse, so this tab/space-interleaved decl compiles.
func main() {
	var	x	int	=	5
	var   y  	  int   =    6
	if x + y == 11 { testing.Println("ok") } else { testing.Println("FAIL") }
}
