package "main"
import "pkg/builtins/testing"

// lex.comment.line: a // comment runs to end of line and is ignored; both a
// full-line comment and a trailing comment carry no tokens.
// a full-line comment with )))  }}}  === garbage that is ignored
func main() {
	var x int = 5 // trailing comment: }}} ))) var BAD === ignored to EOL
	if x == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
