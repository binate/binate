package "main"

// lex.comment.line: the newline terminating a // comment still counts for
// semicolon insertion, so these comment-ended lines are separate statements
// with no explicit ; anywhere.
func main() {
	x := 5 // ASI must fire after this comment-terminated line
	x = x + 1 // and after this one
	if x == 6 { println("ok") } else { println("FAIL") }
}
