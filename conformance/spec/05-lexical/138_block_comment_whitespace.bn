package "main"

// lex.comment.block: a /* ... */ block comment is treated as whitespace -- it
// may span lines, sit mid-expression, and even separate two tokens (var/x).
func main() {
	/* a multi-line
	   block comment
	   spanning lines */
	var/* separates */x int = 2 /* mid */ + /* expr */ 3
	if x == 5 { println("ok") } else { println("FAIL") }
}
