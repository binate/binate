package "main"
import "pkg/builtins/testing"

// lex.comment.block: empty /**/ and /***/ are valid comments, and // or /*
// markers appearing inside a comment have no special meaning (are inert).
func main() {
	/**/ /***/ var x int = 5 // trailing /* inert block marker */ still a line comment
	/* a block with // an inert line marker inside */
	if x == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
