package "main"
import "pkg/builtins/testing"

// lex.comment.block: block comments do not nest -- the inner /* has no meaning
// and the FIRST */ closes the comment, so "x := 5" after it is live code.
func main() {
	/* outer /* inner */ x := 5
	if x == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
