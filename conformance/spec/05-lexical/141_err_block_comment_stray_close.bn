package "main"

// lex.comment.block: since /* */ does not nest, in "/* a */ */" the first */
// closes the comment and the trailing */ is left in the token stream as two
// ordinary operator tokens '*' '/' (NOT a lexically illegal token) -- a '*'
// deref whose operand cannot start, so the program is a parse error.
func main() {
	/* a */ */ var x int = 5
}
