package "main"
import "pkg/builtins/testing"

// lex.comment.block: a newline inside a block comment counts for semicolon
// insertion (the comment is whitespace and carries its newline through), so
// "y := 6" begins a new statement even though no bare newline precedes it.
func main() {
	x := 5 /* the only newline before y
	is inside this comment */ y := 6
	if x + y == 11 { testing.Println("ok") } else { testing.Println("FAIL") }
}
