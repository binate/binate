package "main"
import "pkg/builtins/testing"

// lex.source.bytes: multi-byte UTF-8 runs inside string literals are stored as
// their literal bytes with no interpretation. "café" is 5 bytes (c,a,f then the
// 2-byte 0xC3 0xA9), and "中" is the 3-byte run 0xE4 0xB8 0xAD -- asserted
// byte-for-byte to prove verbatim storage, not merely the byte count.
func main() {
	var s @[]readonly char = "中"
	if len("café") == 5 && len(s) == 3 &&
	   cast(int, s[0]) == 228 && cast(int, s[1]) == 184 && cast(int, s[2]) == 173 {
		testing.Println("ok")
	} else { testing.Println("FAIL") }
}
