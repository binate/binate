package "main"

// lex.semicolon.insertion: statements terminated only by newlines (no explicit
// ';') parse correctly -- a semicolon is inserted after each value-like token
// (the rvalue of each var decl) at the newline.
func main() {
	var a int = 1
	var b int = 2
	var c int = a + b
	if c == 3 { println("ok") } else { println("FAIL") }
}
