package "main"
import "pkg/builtins/testing"

// lex.semicolon.insertion: a newline after a value-like token (an integer
// literal ending a short var decl) inserts a ';', so two `:=` statements on
// consecutive lines are two separate declarations rather than one run-on.
func main() {
	x := 5
	y := 7
	if x + y == 12 { testing.Println("ok") } else { testing.Println("FAIL") }
}
