package "main"
import "pkg/builtins/testing"

// lex.semicolon.insertion: '}' is a value-like / statement-ending token, so a
// newline after the closing '}' of a block inserts a ';' -- the statement on
// the next line is a separate statement, not a continuation.
func main() {
	var n int = 0
	if true {
		n = 5
	}
	n = n + 1
	if n == 6 { testing.Println("ok") } else { testing.Println("FAIL") }
}
