package "main"
import "pkg/builtins/testing"

// lex.semicolon.insertion: NO semicolon is inserted at a newline that follows a
// binary operator, so an expression continues across lines -- here `1 +`/`2 +`/`3`
// on three lines is the single sum 6.
func main() {
	var x int = 1 +
		2 +
		3
	if x == 6 { testing.Println("ok") } else { testing.Println("FAIL") }
}
