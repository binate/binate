package "main"
import "pkg/builtins/testing"

// lex.semicolon.insertion: NO semicolon is inserted at a newline following an
// opening delimiter '(' or after a comma, so a call argument list spans lines.
func add(a int, b int) int { return a + b }

func main() {
	var x int = add(
		10,
		20,
	)
	if x == 30 { testing.Println("ok") } else { testing.Println("FAIL") }
}
