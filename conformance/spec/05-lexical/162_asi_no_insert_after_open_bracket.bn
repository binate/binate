package "main"
import "pkg/builtins/testing"

// lex.semicolon.insertion: NO semicolon is inserted at a newline following the
// opening delimiter '[', so an index expression may span lines -- here `a[`
// then `0]` on the next line indexes element 0.
func main() {
	var a [2]int = [2]int{
		10,
		20,
	}
	if a[
		0] + a[1] == 30 { testing.Println("ok") } else { testing.Println("FAIL") }
}
