package "main"

// lex.semicolon.trailing-comma: a multi-line call argument list whose closing
// ')' is on a later line REQUIRES a trailing comma after the last element.
// Without it, ASI inserts a ';' after `20` (a value-like token), which breaks
// the list -- the parser then sees ';' where it expects ')'.
func add(a int, b int) int { return a + b }

func main() {
	var x int = add(
		10,
		20
	)
	_ = x
}
