package "main"

// lex.semicolon.trailing-comma: WITH a trailing comma after the last element of
// a multi-line argument list, no ';' is inserted before the closing ')' (a
// comma does not trigger ASI), so the list parses correctly.
func add(a int, b int) int { return a + b }

func main() {
	var x int = add(
		10,
		20,
	)
	if x == 30 { println("ok") } else { println("FAIL") }
}
