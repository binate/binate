package "main"

// lex.semicolon.trailing-comma: the rule applies to any multi-line comma list,
// not just calls. Here an array composite literal's closing '}' is on a later
// line; without a trailing comma after `3`, ASI inserts a ';' after the value-
// like token, so the parser sees ';' where it expects '}'.
func main() {
	var a [3]int = [3]int{
		1,
		2,
		3
	}
	_ = a
}
