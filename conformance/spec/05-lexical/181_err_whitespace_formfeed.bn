package "main"

// lex.whitespace: whitespace is ONLY space/tab/CR/newline. A form-feed
// byte (0x0C) is NOT whitespace, so it does not separate tokens -- it is an
// illegal token. Were 0x0C whitespace, this would read as `var int = 5`
// (declaring a variable named int) and compile; instead the byte where a
// name is expected is rejected.
func main() { var  int = 5; _ = 0 }
