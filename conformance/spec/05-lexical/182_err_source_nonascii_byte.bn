package "main"

// lex.source.bytes: the source character set is ASCII. A byte outside the
// ASCII range (here 0xC3 0xA9, UTF-8 for U+00E9) appearing where a token is
// expected -- not inside a string/comment/char -- is an illegal character.
// Were such bytes legal identifier characters, this would name a variable;
// instead the byte where a name is expected is rejected.
func main() { var é int = 5; _ = 0 }
