package "main"

// lex.keywords.reserved: `nil` is a reserved keyword denoting a predeclared
// value (§5.4), NOT an ordinary identifier -- unlike the predeclared type names
// (int, byte, ...) which ARE identifiers and may be shadowed (see 102-107).
// Using it as a variable name is rejected where an identifier is expected.
func main() {
	var nil int = 5
	_ = 0
}
