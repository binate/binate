package "main"

// lex.whitespace: carriage return (0x0D) is whitespace (the "exactly"
// set is space/tab/CR/newline). Here a bare CR (no LF) sits between "+" and
// "2"; since "+" does not trigger ASI and CR is mere whitespace, the line
// continues as 1 + 2 == 3. (CR is whitespace, not a statement terminator.)
func main() {
	var x int = 1 +2
	if x == 3 { println("ok") } else { println("FAIL") }
}
