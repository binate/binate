package "main"
import "pkg/builtins/testing"

// lex.semicolon.insertion: `return` is one of the tokens after which a
// newline inserts a semicolon. `return` on its own line therefore becomes a
// value-less `return;` (the `5` is a separate, unreachable statement), which is
// rejected in an int-returning function. Were `return` NOT an ASI trigger this
// would read as `return 5` and compile -- so the error proves insertion fired.
func f() int {
	return
	5
}
func main() { testing.Println(f()) }
