package "main"
import "pkg/builtins/testing"

// lex.escape.unicode: a \uHHHH escape (exactly four hex digits) expands at
// COMPILE TIME to the UTF-8 encoding of the Unicode scalar value U+HHHH --
// 1-3 bytes -- contributing that many bytes to a string literal's length (and
// to its natural array type, §5.9). Strings are byte sequences (no runtime
// Unicode machinery), so the bytes are observable directly. In a CHARACTER
// literal the code point must encode to a single byte (<= U+007F), and its
// value is the code point itself.
func main() {
	// "a" + U+00E9 (e-acute -> C3 A9) + U+20AC (euro -> E2 82 AC) = 1+2+3 = 6 bytes.
	var s @[]readonly char = "a\u00e9\u20ac"
	testing.Println(len(s))          // 6
	testing.Println(cast(int, s[0])) // 97  ('a')
	testing.Println(cast(int, s[1])) // 195 (0xC3)
	testing.Println(cast(int, s[2])) // 169 (0xA9)
	testing.Println(cast(int, s[3])) // 226 (0xE2)
	testing.Println(cast(int, s[4])) // 130 (0x82)
	testing.Println(cast(int, s[5])) // 172 (0xAC)
	// An ASCII \u in a CHAR literal equals the code point (one byte).
	var c char = '\u0041'
	testing.Println(cast(int, c))    // 65
}
