package "main"
import "pkg/builtins/testing"

// lex.escape.unicode (Constraint side): malformed \u escapes are COMPILE errors.
// Three distinct rejections -- fewer than four hex digits ("escape requires four
// hex digits"); a UTF-16 surrogate U+D800-U+DFFF, which is not a scalar value
// ("is a UTF-16 surrogate"); and a multi-byte code point in a CHAR literal,
// which holds a single byte ("char literal must be a single byte").
func main() {
	testing.Println(len("\u12"))    // too few hex digits (needs four)
	testing.Println(len("\ud800"))  // a UTF-16 surrogate, not a scalar value
	var c char = '\u00e9'   // multi-byte: cannot fit a single-byte char
	testing.Println(cast(int, c))
}
