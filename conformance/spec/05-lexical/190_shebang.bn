#!/usr/bin/env -S bni -x
package "main"
import "pkg/builtins/testing"

// lex.shebang: a source file may begin with a `#!` shebang line, which the lexer
// skips whole (offset-0 only) so a chmod +x'd `.bn` can run under
// `#!/usr/bin/env -S bni -x`.  This file's FIRST line is a shebang; that it
// compiles and runs to the sentinel proves the skip works in both the compiler
// (bnc) and the VM (bni) lexer paths, which share one lexer.  The `package`
// clause on line 2 is not masked or mis-positioned by the skip.
func main() {
	testing.Println("ok")
}
