package "main";

// lex.semicolon.insertion: a written `;` ending a line is that line's only
// semicolon (none is inserted after it), so lines ending in `;` mean the same
// as without it — imports (single and grouped), top-level declarations, a var,
// const or type group's specs, a struct's fields, an interface's methods,
// statements in a block or a case (a function ending in `return x;` returns),
// and a `for` header written one clause per line.

import (
	"pkg/builtins/testing";
)

var a int = 1;

var (
	b int = 2;
	c int = 3;
)

const (
	D = 4;
	E = 5;
)

type (
	Small int;
	Large int;
)

type T struct {
	x int;
	y int;
}

interface Sum {
	Total() int;
}

impl T : Sum;

func (t T) Total() int {
	return t.x + t.y;
}

func sign(n int) int {
	switch {
	case n < 0:
		return -1;
	case n > 0:
		return 1;
	default:
		return 0;
	}
}

func main() {
	var t T = T{x: a + b, y: c};
	testing.Println(t.Total(), D + E);
	var s Small = 2;
	var l Large = 3;
	testing.Println(cast(int, s) + cast(int, l), sign(-7), sign(0), sign(7));
	for i := 0;
		i < 2;
		i++ {
		testing.Println(i);
	}
}
