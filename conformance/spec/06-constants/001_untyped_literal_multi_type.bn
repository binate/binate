package "main"
import "pkg/builtins/testing"

// const.untyped: an integer/float/bool literal is UNTYPED -- it has no inherent
// type and takes one from context. The same literal 123 is usable as int, uint,
// int32, and uint8; 1.5 as float32 and float64; true as bool. (A char literal,
// by contrast, is typed -- see 002.)
func main() {
	var ok bool = true
	var a int = 123; var b uint = 123; var c int32 = 123; var d uint8 = 123
	if !(a == 123 && cast(int, b) == 123 && cast(int, c) == 123 && cast(int, d) == 123) { ok = false }
	var e float32 = 1.5; var f float64 = 1.5
	if !(cast(float64, e) == 1.5 && f == 1.5) { ok = false }
	var g bool = true
	if !g { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
