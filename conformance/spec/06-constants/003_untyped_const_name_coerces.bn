package "main"
import "pkg/builtins/testing"

// const.untyped.coercion: a `const` declared with NO explicit type carries an
// untyped type and narrows at each use, like a literal. const K = 100 is usable
// as both int32 and uint8, and the constant expression K + 5 narrows too.
const K = 100

func main() {
	var ok bool = true
	var a int32 = K; var b uint8 = K; var c uint8 = K + 5
	if !(cast(int, a) == 100 && cast(int, b) == 100 && cast(int, c) == 105) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
