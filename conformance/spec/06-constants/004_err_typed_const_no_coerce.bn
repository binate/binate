package "main"

// const.untyped.coercion: a `const` declared WITH an explicit type has that
// definite type and does NOT coerce. const K int = 100 is an int, so assigning
// it to uint8 is rejected even though the value 100 fits uint8 (value 100 is
// used, not an overflowing one, so the failure is purely the type rule).
const K int = 100

func main() {
	var b uint8 = K
	_ = b
}
