package "main"
import "pkg/builtins/testing"

// const.default: an untyped constant used where no type is supplied takes its
// DEFAULT type -- integer -> int, float -> float64, bool -> bool, string ->
// @[]readonly char. := uses the default type for each.
func useInt(n int) int { return n }
func useF64(x float64) float64 { return x }

func main() {
	var ok bool = true
	x := 123                  // default int
	if useInt(x) != 123 { ok = false }
	f := 1.5                  // default float64
	if useF64(f) != 1.5 { ok = false }   // pins float64 (a float32 would not assign)
	b := true                 // default bool
	if !b { ok = false }
	s := "abc"                // default @[]readonly char
	if len(s) != 3 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
