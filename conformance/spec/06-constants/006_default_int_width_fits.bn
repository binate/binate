package "main"
import "pkg/builtins/testing"

// const.default.int-width: the default int is target-width; a literal that fits
// the target int uses the default (x := 100 is int, x+1 == 101), and a wider
// explicit type also accepts it. (The out-of-range half is 007.)
func main() {
	var ok bool = true
	x := 100
	if x + 1 != 101 { ok = false }
	var w int64 = 100
	if w != 100 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
