package "main"

// const.default.int-width: a literal that exceeds the target int cannot use the
// default int and must be given an explicit type. `x := 0xFFFFFFFFFFFFFFFF`
// (2^64-1, a valid union-range literal but not in int64) SHOULD be rejected.
//
// XFAIL: the := default-type path does NOT fit-check, so this silently WRAPS to
// int -1 (compiles, no diagnostic) -- a silent integer-wrap miscompile -- while
// the explicit-type path `var x int = 0xFFFFFFFFFFFFFFFF` correctly rejects
// (claude-todo MAJOR, := default-type missing fit-check).
func main() {
	x := 0xFFFFFFFFFFFFFFFF
	_ = x
}
