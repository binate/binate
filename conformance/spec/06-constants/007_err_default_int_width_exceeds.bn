package "main"

// const.default.int-width: a literal that exceeds the target int cannot use the
// default int and must be given an explicit type. `x := 0xFFFFFFFFFFFFFFFF`
// (2^64-1, a valid union-range literal but not in int64) is rejected -- the
// `:=` default-type path fit-checks the literal against its chosen default,
// like the explicit `var x int = 0xFFFFFFFFFFFFFFFF` path. (Without the check
// it silently WRAPPED to int -1.)  115 covers the `var x = e` form; 116 the
// `box(e)` form.
func main() {
	x := 0xFFFFFFFFFFFFFFFF
	_ = x
}
