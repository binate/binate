package "main"

// const.default: := yields a DEFINITE default type (int), not a still-untyped
// value -- so the declared name does not coerce. x := 123 is int, so assigning
// x to uint8 is rejected (whereas the untyped literal 123 would be accepted:
// `var b uint8 = 123` compiles).
func main() {
	x := 123
	var b uint8 = x
	_ = b
}
