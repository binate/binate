package "main"

// A BARE-repeat grouped const member (`R` with no initializer) inherits the
// preceding explicit member's type AND folds its repeated expression with that
// type's signedness.  Regression: re-checking the shared initializer node for
// the bare member re-registered it, pointing the explicit member at the bare
// member's signed re-fold, so `const ( Q uint64 = U/D; R )` made BOTH fold
// SIGNED — (2^64-1)/2 became 0 instead of 2^63-1.  The iota bit-flag idiom (a
// bare member repeating an iota-using expression) must still re-evaluate at its
// own iota, and is checked here as a guard.
const (
	U uint64 = 18446744073709551615   // 2^64-1
	D uint64 = 2
	Q uint64 = U / D                  // 2^63-1 unsigned (would be 0 if signed)
	R                                 // bare repeat: same value as Q
)

// iota bit-flag idiom: bare members re-evaluate `1 << iota` at their own iota.
const (
	B0 int = 1 << iota   // 1
	B1                   // 2
	B2                   // 4
)

func main() {
	println(cast(int64, Q))   // 9223372036854775807
	println(cast(int64, R))   // 9223372036854775807
	println(B0 + B1 + B2)     // 7
}
