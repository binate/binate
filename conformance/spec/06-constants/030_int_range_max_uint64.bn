package "main"
import "pkg/builtins/testing"

// const.int.range: an integer literal must lie in [-2^63, 2^64-1] (the union of
// int64 and uint64). 0xFFFFFFFFFFFFFFFF == 2^64-1 is the largest valid literal;
// it denotes the same value written in decimal.
func main() {
	var ok bool = true
	var hex uint64 = 0xFFFFFFFFFFFFFFFF
	if hex != 18446744073709551615 { ok = false }   // 2^64-1, decimal == hex
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
