package "main"

// const.int.range (Constraint): the union-range bound is base-independent --
// 18446744073709551616 == 2^64 in decimal is rejected exactly like its
// hexadecimal spelling. All bases denote values in the one [-2^63, 2^64-1] space.
func main() {
	var x uint64 = 18446744073709551616
	_ = x
}
