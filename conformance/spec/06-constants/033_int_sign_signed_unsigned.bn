package "main"
import "pkg/builtins/testing"

// const.int.sign: a value fitting int64 is a signed value (possibly negative); a
// value greater than the int64 maximum requires uint64 and is non-negative.
func main() {
	var ok bool = true
	var n int64 = -42
	if n >= 0 { ok = false }                       // a negative signed value
	if n != -42 { ok = false }
	var smax int64 = 9223372036854775807           // int64 max, a signed value
	if smax != 9223372036854775806 + 1 { ok = false }
	var big uint64 = 18446744073709551615          // 2^64-1: non-negative, needs uint64
	if big <= 9223372036854775807 { ok = false }   // strictly above int64 max
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
