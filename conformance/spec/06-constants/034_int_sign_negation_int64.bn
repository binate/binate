package "main"
import "pkg/builtins/testing"

// const.int.sign (§6.3): a literal carries no intrinsic sign -- a leading '-'
// is unary negation, so for an int64 value `-42 == 0 - 42`.
//
// Regression witness (arm32 / any 32-bit-int target): comparing an int64 to an
// INLINE untyped negative const-expression (`n == 0 - 42`).  IR-gen gives an
// untyped const operand its reconciled concrete type before the widening,
// emitting the full value directly; widening it to int64 via a cast that
// zero-extends its 32-bit (target-int-width) materialization drops the high word
// of the negative value, and the equality is wrongly false.  The literal form
// (`n == -42`), the via-a-var form, the pure untyped-const form, and the
// symmetric (const-on-the-left) form take other paths; all are checked here.
func main() {
	var n int64 = -42
	var ok bool = true

	if !(n == 0 - 42) { ok = false }        // inline negative const-expr (the bug)
	if !(0 - 42 == n) { ok = false }        // symmetric: const-expr on the left
	if !(n == -42) { ok = false }           // negative literal
	var m int64 = 0 - 42
	if !(n == m) { ok = false }             // via an int64 var
	if !((0 - 42) == -42) { ok = false }    // pure untyped const

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
