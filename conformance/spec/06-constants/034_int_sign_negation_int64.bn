package "main"
import "pkg/builtins/testing"

// const.int.sign (§6.3): a literal carries no intrinsic sign -- a leading '-'
// is unary negation, so for an int64 value `-42 == 0 - 42`.
//
// Regression witness (arm32 / any 32-bit-int target): comparing an int64 to an
// INLINE untyped negative const-expression (`n == 0 - 42`) was miscompiled --
// the const-expr was widened to int64 via a cast that zero-extended its 32-bit
// (target-int-width) materialization, dropping the high word of the negative
// value, so the equality was wrongly false.  IR-gen now gives an untyped const
// operand its reconciled concrete type before the widening, emitting the full
// value directly.  The literal form (`n == -42`), the via-a-var form, the pure
// untyped-const form, and the symmetric (const-on-the-left) form were always
// fine; all are checked here.
func main() {
	var n int64 = -42
	var ok bool = true

	if !(n == 0 - 42) { ok = false }        // inline negative const-expr (the bug)
	if !(0 - 42 == n) { ok = false }        // symmetric: const-expr on the left
	if !(n == -42) { ok = false }           // negative literal
	var m int64 = 0 - 42
	if !(n == m) { ok = false }             // via an int64 var
	if !((0 - 42) == -42) { ok = false }    // pure untyped const

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
