package "main"

// const.int.sign: a literal carries no intrinsic sign -- a leading '-' is unary
// negation, so for an int64 value `-42 == 0 - 42`.
//
// This SHOULD print "ok". XFAIL on arm32: comparing an int64 to an INLINE untyped
// negative const-expression (`n == 0 - 42`) is miscompiled on the 32-bit ARM
// backend (the const-expr is not widened to 64 bits before the compare, so the
// high word mismatches and the equality is wrongly false). `n == -42` (a literal)
// and `m == 0-42` via an int64 var both work on arm32 -- only the inline
// int64-vs-negative-const-expr form fails. claude-todo MAJOR (arm32).
func main() {
	var n int64 = -42
	if n == 0 - 42 { println("ok") } else { println("FAIL") }
}
