package "main"
import "pkg/builtins/testing"

// const.expr.precision: a constant expression evaluates on abstract integers at
// union-range precision, exactly -- no wraparound, no bignum. 1000 - 1000 == 0,
// and 2^64-1 - 1 == 2^64-2 fits uint64 with no loss.
func main() {
	var ok bool = true
	var z int = 1000 - 1000
	if z != 0 { ok = false }
	var w uint64 = 0xFFFFFFFFFFFFFFFF - 1          // 2^64-2, exact, fits uint64
	if w != 0xFFFFFFFFFFFFFFFE { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
