package "main"

// const.expr.precision (Constraint): if any intermediate result leaves the union
// range [-2^63, 2^64-1], the whole constant expression is rejected -- there is no
// wraparound. 0xFFFFFFFFFFFFFFFF + 1 == 2^64 exceeds the range.
func main() {
	var x uint64 = 0xFFFFFFFFFFFFFFFF + 1
	_ = x
}
