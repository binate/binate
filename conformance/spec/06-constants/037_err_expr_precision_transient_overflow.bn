package "main"

// const.expr.precision (Constraint): even when the FINAL value would fit, an
// overflowing intermediate rejects the expression -- Binate does not use bignum.
// 0xFFFFFFFFFFFFFFFF + 1 - 1 has final value 2^64-1 (fits) but the (+1) step
// reaches 2^64, which overflows the union range.
func main() {
	var x uint64 = 0xFFFFFFFFFFFFFFFF + 1 - 1
	_ = x
}
