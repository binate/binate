package "main"

// const.expr.signedness: constant arithmetic operates at abstract precision
// across signedness. 0xFFFFFFFFFFFFFFFF + (-1) evaluates to 2^64-2, a
// non-negative value usable in a uint64 context.
func main() {
	var ok bool = true
	var x uint64 = 0xFFFFFFFFFFFFFFFF + (-1)        // big unsigned + signed -> 2^64-2
	if x != 0xFFFFFFFFFFFFFFFE { ok = false }
	var y uint64 = 5 - 5 + 0xFFFFFFFFFFFFFFFF       // small signed terms then big unsigned
	if y != 0xFFFFFFFFFFFFFFFF { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
