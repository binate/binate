package "main"
import "pkg/builtins/testing"

// const.expr.fit (§6.4): a constant must fit the unsigned target's range
// [0, 2^n-1]. The maxima 2^n-1 (uint8 255, uint16 65535, uint64 2^64-1)
// fit exactly; assigning them is accepted and the values round-trip.

func main() {
	var ok bool = true
	var a uint8 = 255
	var b uint16 = 65535
	var c uint64 = 0xFFFFFFFFFFFFFFFF
	if a != 255 { ok = false }
	if b != 65535 { ok = false }
	if c != 0xFFFFFFFFFFFFFFFF { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
