package "main"

// const.expr.fit (§6.4): a constant must fit the signed target's range
// [-2^(n-1), 2^(n-1)-1]. The boundary values int8 127 / -128 and int16
// -32768 fit exactly; assigning them is accepted and they round-trip.

func main() {
	var ok bool = true
	var hi int8 = 127
	var lo int8 = -128
	var smin int16 = -32768
	if hi != 127 { ok = false }
	if lo != -128 { ok = false }
	if smin != -32768 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
