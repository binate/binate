package "main"

import "pkg/builtins/testing"

// const.expr.fit (§6.4): the value of a constant EXPRESSION (not just a
// literal) must fit the context type. `100 + 27` evaluates to 127, which
// fits int8; a signedness-crossing expression that lands back in range
// (0x8000000000000000 + (-0x7FFFFFFFFFFFFF01) == 255, every intermediate within
// the union range) fits uint8.

func main() {
	var ok bool = true
	var x int8 = 100 + 27
	var y uint8 = 0x8000000000000000 + -0x7FFFFFFFFFFFFF01
	if x != 127 { ok = false }
	if y != 255 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
