package "main"

// const.overflow (§6.7): assigning a literal that exceeds the target type's
// range is a compile-time error. 256 is one past the unsigned-8-bit maximum
// (255), so it does not fit and is rejected. The in-range neighbor 255
// compiles (see 060_fit_unsigned_boundaries).

func main() {
	var x uint8 = 256
	_ = x
}
