package "main"

// const.overflow (§6.7): 0xFFFFFFFFFFFFFFFF (= 2^64-1) is a valid literal
// and fits an unsigned 64-bit target, but it exceeds the signed 64-bit
// maximum (2^63-1), so assigning it to a signed 64-bit target is rejected.
// The same literal into the unsigned target compiles (see 060).

func main() {
	var x int64 = 0xFFFFFFFFFFFFFFFF
	_ = x
}
