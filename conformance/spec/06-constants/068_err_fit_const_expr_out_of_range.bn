package "main"

// const.expr.fit (§6.4): the fit check applies to the value of a constant
// EXPRESSION, not just a literal. 200 + 100 evaluates to 300, which exceeds
// the unsigned-8-bit maximum (255), so the assignment is rejected even though
// each operand individually fits. The in-range neighbor 200 + 55 == 255
// compiles (see 062 for an analogous in-range constant expression).

func main() {
	var x uint8 = 200 + 100
	_ = x
}
