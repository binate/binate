package "main"

// const.float.untyped (§6.5): a floating-point literal is untyped and
// assignable to BOTH float32 and float64. The single literal 1.5 takes
// float32 in one context and float64 in another; an untyped float-only
// constant expression (1.5 + 2.5) evaluates and compares equal to 4.0.

func main() {
	var ok bool = true
	var a float32 = 1.5
	var b float64 = 1.5
	if !(a == 1.5) { ok = false }
	if !(b == 1.5) { ok = false }
	if !(1.5 + 2.5 == 4.0) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
