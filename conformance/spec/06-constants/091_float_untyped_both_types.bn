package "main"

// const.float.untyped (§6.5): the same untyped literal 0.0 is assignable to
// float32 and float64; float-only arithmetic stays untyped until it meets a
// context type. A float32 result (a + 2.5) and a float64 division both fold
// to their expected float values.

func main() {
	var ok bool = true
	var a float32 = 0.0
	var b float64 = 0.0
	if !(a == 0.0) { ok = false }
	if !(b == 0.0) { ok = false }
	var c float32 = a + 2.5
	if !(c == 2.5) { ok = false }
	if !(3.0 / 2.0 == 1.5) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
