package "main"

// const.float.untyped (§6.5): a floating-point literal is untyped -- it is
// assignable to BOTH float32 and float64 (its default), taking the type from
// context, with no conversion. The same literal 1.5 is used as each.
func main() {
	var ok bool = true
	var a float32 = 1.5
	var b float64 = 1.5
	if !(cast(float64, a) == 1.5 && b == 1.5) { ok = false }
	if !(1.5 + 2.5 == 4.0) { ok = false }   // untyped float arithmetic
	if ok { println("ok") } else { println("FAIL") }
}
