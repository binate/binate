package "main"

// const.float.no-int-mix (§6.5): the rule-satisfying neighbors of the
// no-mix errors compile. An explicit cast(float64, 5) makes the int a float
// destination value, and 1.5 + cast(float64, 2) makes both operands float.

func main() {
	var ok bool = true
	var f float64 = cast(float64, 5)
	if !(f == 5.0) { ok = false }
	var g float64 = 1.5 + cast(float64, 2)
	if !(g == 3.5) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
