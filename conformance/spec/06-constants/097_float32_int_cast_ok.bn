package "main"
import "pkg/builtins/testing"

// const.float.no-int-mix (§6.5): the float32 rule-satisfying neighbor
// compiles -- cast(float32, 5) explicitly converts the int constant, so the
// float32 destination is assigned a float value.

func main() {
	var ok bool = true
	var f float32 = cast(float32, 5)
	if !(f == 5.0) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
