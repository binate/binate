package "main"

// const.float.no-int-mix (§6.5): mixing a typed floating-point operand (a
// float64 variable) with an integer literal operand (2) is the same type
// error -- the no-int-mix rule is not limited to two literal operands.

func main() {
	var x float64 = 3.0
	var f float64 = x + 2
	_ = f
}
