package "main"

// const.float.no-int-mix (§6.5): the strict no-implicit-int/float rule applies
// in BOTH directions -- an untyped FLOAT constant is not implicitly converted to
// an integer type either. var x int = 1.5 is rejected; cast(int, 1.5) is the way.
func main() {
	var x int = 1.5
	_ = x
}
