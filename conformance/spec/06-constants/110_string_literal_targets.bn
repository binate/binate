package "main"

// const.string.types: a string literal is an untyped constant whose natural
// type is [N]readonly char and default type @[]readonly char (§6.6). It
// assigns to: @[]readonly char (managed-slice borrow, the default),
// *[]readonly char (raw-slice borrow), @[]char (allocate + copy), and
// [N]readonly char / [N]char (array copy; length must match). char == uint8,
// so the bytes of "abc" are 97, 98, 99.

func main() {
	var ok bool = true
	var a @[]readonly char = "abc"   // managed-slice borrow (the default)
	if len(a) != 3 { ok = false }
	if a[0] != 97 { ok = false }
	var b *[]readonly char = "abc"   // raw-slice borrow
	if len(b) != 3 { ok = false }
	if b[2] != 99 { ok = false }
	var c @[]char = "abc"            // allocate + copy (mutable owned)
	if len(c) != 3 { ok = false }
	if c[1] != 98 { ok = false }
	var d [3]readonly char = "abc"   // array copy, length matches
	if d[0] != 97 { ok = false }
	if d[2] != 99 { ok = false }
	var e [3]char = "abc"            // mutable array copy
	if e[1] != 98 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
