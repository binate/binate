package "main"

// const.string.types (Constraint): a string literal may NOT be assigned to a
// mutable raw slice (*[]char) — a raw slice cannot own a mutable copy, and a
// mutable borrow of read-only static data is unsound (§6.6). The read-only
// raw-slice target *[]readonly char IS permitted (see 110); the mutable one
// is rejected. char renders as uint8 in the diagnostic.

func main() {
	var bad *[]char = "abc"
	_ = bad
}
