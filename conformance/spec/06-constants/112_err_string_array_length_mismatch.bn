package "main"

// const.string.types (Constraint): assigning a string literal to an array
// target [N]readonly char / [N]char requires the array length N to match the
// literal's byte count (§6.6). "abc" is 3 bytes, so [4]readonly char is a
// length mismatch and is rejected. The matching [3]readonly char target
// compiles (see 110).

func main() {
	var bad [4]readonly char = "abc"
	_ = bad
}
