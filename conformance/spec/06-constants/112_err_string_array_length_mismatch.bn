package "main"

// const.string.types (Constraint, §6.6): a string literal initializes a fixed
// char array of length M >= N (the literal's N bytes are copied, the tail is
// zero-padded). An OVER-LONG literal (N > M) does not fit and is rejected:
// "abc" is 3 bytes, so [2]readonly char is too small. (A shorter-or-equal
// literal is accepted -- see 110 (exact) and 117 (zero-padded).)

func main() {
	var bad [2]readonly char = "abc"
	_ = bad
}
