package "main"

// const.char.type: a character literal has type char, which IS uint8 (not a
// distinct named type) — §6.6. It is a typed constant, freely usable where
// uint8 / byte is expected, and a uint8 context also accepts a char literal
// directly. Other integer types require an explicit cast. 'A' == 65.

func main() {
	var ok bool = true
	var c char = 'A'             // char literal, typed char == uint8
	var u uint8 = c              // usable directly where uint8 is expected
	if u != 65 { ok = false }
	var b byte = c              // byte is uint8 too
	if b != 65 { ok = false }
	var i int = cast(int, c)    // other int types need an explicit cast
	if i != 65 { ok = false }
	var v uint8 = 'A'           // char-literal value assigns to uint8 directly
	if v != 65 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
