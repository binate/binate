package "main"

// const.char.type (Constraint): a character literal is a TYPED constant of
// type char (== uint8), not an untyped integer — so it does NOT implicitly
// convert to another integer type. Assigning a char value to int without an
// explicit cast is rejected (§6.6); cast(int, c) is the way (see 113).

func main() {
	var i int = 'A'   // a char LITERAL is typed char==uint8; no implicit widen to int
	_ = i
}
