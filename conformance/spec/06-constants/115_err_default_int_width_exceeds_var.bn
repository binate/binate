package "main"

// const.default.int-width: the same fit-check the `:=` form gets (007) must also
// apply to the inferred `var x = e` form (no explicit type). A literal that
// exceeds the default int (0xFFFFFFFFFFFFFFFF = 2^64-1, a valid union-range
// literal but not in int64) "cannot use the default and shall be given an
// explicit type" (§6.2) -- it must be rejected, not silently wrapped to int -1.
func main() {
	var x = 0xFFFFFFFFFFFFFFFF
	_ = x
}
