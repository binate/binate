package "main"

// const.default.int-width: `box(e)` default-types its untyped-int argument
// exactly like `:=` / `var x = e`, so the same fit-check applies.
// `box(0xFFFFFFFFFFFFFFFF)` (2^64-1, not in int64) must be rejected, not
// silently wrapped into @int (-1). The third default-type inference site
// (007 = `:=`, 115 = `var x = e`, 116 = `box`).
func main() {
	var p @int = box(0xFFFFFFFFFFFFFFFF)
	_ = p
}
