package "main"
import "pkg/builtins/testing"

// const.string.types (§6.6, amended): a string literal initializes a fixed char
// array of length M >= N -- the N bytes are copied and the tail is zero-padded.
// "abc" (3 bytes) into [4]readonly char copies a,b,c and zero-fills index 3.
// (Exact length is 110; the over-long rejection is 112.)
func main() {
	var b [4]readonly char = "abc"
	testing.Println(cast(int, b[0]))  // 'a' = 97
	testing.Println(cast(int, b[2]))  // 'c' = 99
	testing.Println(cast(int, b[3]))  // 0 (padded)
}
