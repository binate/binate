package "main"

import "pkg/builtins/testing"

// const.expr.bitwise / const.expr.shift: the bitwise operators and constant
// shifts on untyped constants act on the infinitely sign-extended
// two's-complement value, so every result is exact and width-independent:
// ~x is -x-1, a negative operand's bits extend as 1s, >> rounds toward -inf.

const C = -2 | 1

func main() {
	var a int64 = ~1
	var b int64 = ~-1
	var c int64 = -2 | 1
	var d int64 = -2 & 0xFF
	var e int64 = -2 ^ 3
	var f uint64 = 0xFFFFFFFFFFFFFFFF & ~1
	var g int64 = -1 << 3
	var h int64 = -1 << 63
	var i int64 = -16 >> 2
	var j int64 = -3 >> 1
	var k int64 = -1 >> 1000
	var l uint8 = -2 & 0xFF
	var m int64 = -16 & -4
	var n int64 = -16 ^ -4
	testing.Println(a, b, c, d, e)
	testing.Println(f)
	testing.Println(g, h, i, j, k)
	testing.Println(cast(int64, l), m, n, cast(int64, C))
}
