package "main"

import "pkg/builtins/testing"

// const.expr.shift: a constant shift of an untyped value is exact for any
// count, including a typed constant count >= 2^63 (a huge count, not a
// negative one): -1 >> K is -1, 1 >> K is 0.

const K uint64 = 0xFFFFFFFFFFFFFFFF

func main() {
	var a int64 = (-1 >> K) + 3
	var b int64 = (-64 >> cast(uint64, 0x8000000000000001)) | 4
	var c int64 = (1 >> K) + 5
	testing.Println(a, b, c)
}
