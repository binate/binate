package "main"

import "pkg/builtins/testing"

// const.expr.typed: an operator on typed constants is evaluated as for
// operands of its type that are not constants — it wraps, ~ is taken at the
// type's width, a shift overshifts — and the result is a constant of that
// type, usable where a constant is required (a const, an array length).

const F uint8 = 0x0F
const X uint8 = cast(uint8, 200) + cast(uint8, 100)
const M int8 = -cast(int8, -128)
const C char = 'a' - 'b'

func main() {
	var flags uint8 = 0xFF
	var arr [cast(uint8, 200) + cast(uint8, 100)]int
	var a uint8 = ~cast(uint8, 1)
	var b uint8 = cast(uint8, 1) << 8
	var d uint8 = flags & ~F
	var e int8 = ~cast(int8, 1)
	var x uint8 = 200
	var y uint8 = 100
	testing.Println(cast(int, a), cast(int, b), cast(int, X), cast(int, d), cast(int, e))
	testing.Println(cast(int, M), cast(int, C), len(arr), cast(int, cast(int8, X)))
	testing.Println(cast(int, x + y), cast(int, X) == cast(int, x + y))
}
