package "main"

import "pkg/builtins/testing"

// expr.shift.untyped-value.unsafe / const.expr.shift: with constant operands
// unsafe_shl / unsafe_shr are constant expressions folded like << / >> — an
// untyped value exactly — so they are usable in a const group, where a bare
// member repeats the shift at its own iota, and as an array length.

const (
	A = unsafe_shl(1, iota + 4)
	B
	C
)

func main() {
	var arr [unsafe_shl(1, 3)]int
	testing.Println(unsafe_shl(-1, 3), unsafe_shr(-16, 2), unsafe_shl(1, 8))
	testing.Println(A, B, C, len(arr))
}
