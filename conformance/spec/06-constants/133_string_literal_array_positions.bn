package "main"
import "pkg/builtins/testing"

// const.string.types: a string literal delivered to a [N]char / [N]readonly
// char target is an array copy of its bytes, in EVERY position that takes a
// value — not only a variable-declaration initializer.  Each line below prints
// the array that received the literal; a position that stored the literal's
// data pointer instead of copying its bytes prints garbage.

type S struct {
	name [3]char
	n    int
}

type Name [3]char

var G [3]char

interface Taker {
	Take(a [3]char) *[]readonly char
}

type T struct {
	buf [3]char
}

func (t *T) Take(a [3]char) *[]readonly char {
	t.buf = a
	return t.buf[:]
}

impl *T : Taker

func ret() [3]char { return "ret" }

func two() ([3]char, int) { return "two", 2 }

func named() Name { return "nam" }

func show(a [3]char) { testing.Println(a[:]) }

func last(xs ...[3]char) [3]char { return xs[len(xs) - 1] }

func main() {
	var a [3]char
	a = "asg" // plain assignment
	testing.Println(a[:])

	var s S
	s.name = "fld" // field
	testing.Println(s.name[:])
	var ps *S = &s
	ps.name = "ptr" // field through a pointer
	testing.Println(s.name[:])

	var p *([3]char) = &a
	*p = "drf" // through a dereference
	testing.Println(a[:])

	var arr [2][3]char
	arr[1] = "ael" // array element
	testing.Println(arr[1][:])
	var pa *([2][3]char) = &arr
	(*pa)[0] = "pel" // element of an array through a pointer
	testing.Println(arr[0][:])
	var sl @[][3]char = make_slice([3]char, 2)
	sl[1] = "sel" // slice element
	testing.Println(sl[1][:])
	var ss @[]S = make_slice(S, 2)
	ss[1].name = "sef" // field of a slice element
	testing.Println(ss[1].name[:])

	G = "glb" // package variable assigned in a function
	testing.Println(G[:])

	var b [3]char
	var n int
	b, n = "par", 1 // parallel assignment
	testing.Println(b[:], n)
	b, n = two() // multi-value return
	testing.Println(b[:], n)

	var r [3]char = ret() // return
	testing.Println(r[:])
	var nm Name = named() // return of a named char-array type
	testing.Println(nm[:])
	nm = "nas" // assignment to a named char-array type
	testing.Println(nm[:])

	show("arg") // call argument
	var t T
	testing.Println(t.Take("mth")) // method argument
	var tk *Taker = &t
	testing.Println(tk.Take("ifc")) // interface-method argument
	var fv *func([3]char) = show
	fv("fnv") // function-value argument
	var l [3]char = last("va1", "va2") // variadic arguments
	testing.Println(l[:])
	defer show("dfr") // deferred-call argument

	var ca [2][3]char = [2][3]char{"cl0", "cl1"} // array literal elements
	testing.Println(ca[0][:], ca[1][:])
	var ka [3][3]char = [3][3]char{1: "key"} // keyed array literal element
	testing.Println(ka[1][:], cast(int, ka[0][0]))
	var sa @[]S = @[]S{S{"sl0", 0}, S{name: "sl1", n: 1}} // struct literals
	testing.Println(sa[0].name[:], sa[1].name[:])
}
