package "main"

import "pkg/builtins/testing"

// const.string.types: a package-level [N]char / [N]readonly char variable
// initialized from a string literal holds a copy of the literal's bytes — an
// exact fit, or (a shorter literal at a variable-declaration initializer) the
// bytes followed by zero padding.  The neighbouring variables must be intact:
// storing the literal's data pointer into the array instead writes a
// pointer-sized value over a shorter array and into the next variable, and
// copying the literal in wider units than the array's size writes past it.

var exact [5]char = "hello"

var next1 [3]char

var padded [8]readonly char = "abc"

var tiny [1]char = "z"

var next2 [3]char

var odd [3]char = "odd"

var next3 [5]char

func main() {
	testing.Println(exact[:])
	testing.Println(cast(int, padded[0]), cast(int, padded[2]), cast(int, padded[3]),
			cast(int, padded[7]))
	testing.Println(tiny[:], odd[:])
	testing.Println(cast(int, next1[0]), cast(int, next1[2]), cast(int, next2[0]), cast(int, next2[2]),
			cast(int, next3[0]), cast(int, next3[4]))
}
