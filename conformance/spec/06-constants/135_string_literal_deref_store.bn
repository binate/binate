package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// const.string.types: a string literal stored through a pointer (`*p = "…"`,
// or an element `p[i] = "…"` of a raw pointer) takes the target's
// representation exactly as a direct assignment does — a
// char-slice header (a borrow of the static data, or a fresh copy for a
// mutable @[]char) or a char-array copy.  Storing the literal's bare data
// pointer instead leaves a slice with a garbage length (or reads as empty) and
// an array holding pointer bytes.

func main() {
	var m @[]char
	var pm *(@[]char) = &m
	*pm = "mutable" // a fresh copy the slot owns
	m[0] = 'M'
	testing.Println(m)

	var r *[]readonly char
	var pr *(*[]readonly char) = &r
	*pr = "raw borrow"
	testing.Println(r)

	var mr @[]readonly char
	var pmr *(@[]readonly char) = &mr
	*pmr = "managed borrow"
	testing.Println(mr)

	var a [5]char
	var pa *([5]char) = &a
	*pa = "array"
	testing.Println(a[:])

	var arr [2][3]char
	var pe *([3]char) = &arr[0]
	pe[1] = "pix" // an element of a raw pointer
	testing.Println(arr[1][:])
	var rs [2]*[]readonly char
	var prs *(*[]readonly char) = &rs[0]
	prs[1] = "raw element"
	testing.Println(rs[1])
	var ms [2]@[]char
	var pms *(@[]char) = &ms[0]
	pms[1] = "managed element"
	testing.Println(ms[1])

	// Each store's copy replaces (and releases) the previous one: the live
	// block count does not climb with the number of stores.
	var base int = rt.LiveBlocks()
	for i := 0; i < 100; i++ {
		*pm = "again"
		pms[1] = "again"
	}
	testing.Println(rt.LiveBlocks() - base, m, ms[1])
}
