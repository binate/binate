package "main"
import "pkg/builtins/testing"

// type.value.categories: every Binate type is a value (copy) type living
// inline. Declare a local variable of each listed category -- bool, an
// integer scalar, a float scalar, a raw pointer *T, a managed pointer @T,
// a struct, an array [N]T, a raw slice *[]T, a managed-slice @[]T, and a
// function value @func -- and exercise each so none is optimized away.
// Copying @T is a value copy that adjusts the pointee's refcount; the copy
// `q = mp` keeps the pointee alive even though it is read through q.

type Pt struct {
	x int
	y int
}

func fortyTwo() int { return 42 }

func main() {
	var b bool = true
	var i int = 7
	var f float64 = 1.5
	var s Pt = Pt{x: 3, y: 4}
	var rp *Pt = &s            // raw pointer to a struct
	var mp @Pt = make(Pt)      // managed pointer
	mp.x = 5
	var arr [3]int = [3]int{1, 2, 3}
	var ms @[]int = make_slice(int, 2)
	ms[0] = 10
	ms[1] = 20
	var raw *[]int = ms        // raw slice (borrows the managed backing)
	var fn @func() int = fortyTwo

	var q @Pt = mp             // value copy of @T: refcounts the pointee

	var total int = 0
	if b {
		total = i + cast(int, f * 2.0) + s.x + rp.y + q.x + arr[1] + raw[0] + raw[1] + len(ms) + fn()
	}
	// 7 + 3 + 3 + 4 + 5 + 2 + 10 + 20 + 2 + 42 = 98
	if total == 98 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
