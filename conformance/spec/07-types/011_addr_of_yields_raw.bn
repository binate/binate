package "main"
import "pkg/builtins/testing"

// type.value.managed-arise / type.ptr.address-of: &x ALWAYS yields a RAW
// pointer *T, even when x is itself a managed value. Here x is a plain
// scalar lvalue and m is a managed-pointer lvalue; &x and &m both yield raw
// pointers, assignable to *int and *(@Box) respectively. Mutating through
// the raw pointer is observed at the original storage.

type Box struct {
	v int
}

func main() {
	var x int = 41
	var p *int = &x            // &lvalue -> raw *int
	*p = 42

	var m @Box = make(Box)    // m is a managed-pointer lvalue
	m.v = 100
	var pm *(@Box) = &m       // &m -> raw pointer to the @Box slot, NOT @(@Box)

	if x == 42 && (*pm).v == 100 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
