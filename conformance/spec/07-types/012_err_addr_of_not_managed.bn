package "main"

// type.value.managed-arise (Constraint): &x is NEVER a managed pointer.
// The address operator yields a raw *T; a managed pointer @T arises only
// from make/box/make_slice. Assigning &x to a @T destination must be
// REJECTED -- *int is not implicitly convertible to @int (that direction,
// raw -> managed, would invent a reference count).

func main() {
	var x int = 5
	var mp @int = &x
	_ = mp
}
