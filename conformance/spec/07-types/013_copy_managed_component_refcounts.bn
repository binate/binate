package "main"
import "pkg/builtins/testing"

// type.value.copy-semantics: copying a value that contains a managed
// component increments that component's refcount. Observe via a refcount
// BALANCE: copy the @Inner field into a second Holder, then overwrite the
// original Holder's field. If the copy bumped the count, the inner value
// is still alive through the copy and reads back correctly (no
// use-after-free); if it were a non-refcounting bit copy, overwriting the
// original would free the backing and the read would be invalid.

type Inner struct {
	val int
}

type Holder struct {
	p @Inner
}

func makeInner(v int) @Inner {
	var i @Inner = make(Inner)
	i.val = v
	return i
}

func main() {
	var a @Inner = makeInner(7)

	var h1 Holder        // value struct with a managed field
	h1.p = a             // refcounts a
	var h2 Holder = h1   // VALUE COPY of the struct: refcounts h1.p too

	h1.p = makeInner(99) // overwrites/decrefs the old h1.p; h2.p kept alive by its own ref

	if h2.p.val == 7 && h1.p.val == 99 && a.val == 7 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
