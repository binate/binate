package "main"

// type.value.copy-semantics: a value containing only scalars and raw
// pointers copies as a plain bit copy -- the copy is independent storage.
// Mutating the copy does not affect the original (and vice versa). The
// struct here holds a scalar and a raw pointer (no managed component), so
// no refcount is involved.

type Pair struct {
	n int
	r *int
}

func main() {
	var t int = 100
	var u int = 200

	var a Pair = Pair{n: 1, r: &t}
	var b Pair = a        // bit copy: independent storage, raw ptr copied as-is

	b.n = 9               // mutating the copy's scalar must not touch a.n
	b.r = &u              // repointing the copy's raw ptr must not touch a.r

	if a.n == 1 && b.n == 9 && (*a.r) == 100 && (*b.r) == 200 {
		println("ok")
	} else {
		println("FAIL")
	}
}
