package "main"

// type.scalar.int-width: int/uint are target word-sized; the sized
// integers have the named width. Assert TARGET-INVARIANT relationships
// (no hardcoded word size, so this passes on arm32 ILP32 and the 64-bit
// host alike):
//   - sized widths are fixed everywhere: 1/2/4/8 for int8/16/32/64
//   - signed and unsigned of the same name have equal size
//   - int and uint are the same size (the word), and equal a pointer's size
//   - the word size is one of the sized widths (>= int32's 4 bytes)

func main() {
	var ok bool = true

	// Fixed sized-integer widths (target-invariant).
	if sizeof(int8) != 1 { ok = false }
	if sizeof(int16) != 2 { ok = false }
	if sizeof(int32) != 4 { ok = false }
	if sizeof(int64) != 8 { ok = false }

	// Signed/unsigned of the same name have equal width.
	if sizeof(int8) != sizeof(uint8) { ok = false }
	if sizeof(int16) != sizeof(uint16) { ok = false }
	if sizeof(int32) != sizeof(uint32) { ok = false }
	if sizeof(int64) != sizeof(uint64) { ok = false }

	// int and uint are the same (word) width, equal to a pointer's width.
	if sizeof(int) != sizeof(uint) { ok = false }
	if sizeof(int) != sizeof(*int) { ok = false }

	// The word is at least 4 bytes and is a power-of-two boundary we can
	// bracket between int32 and int64 inclusively (4 on arm32, 8 on host).
	if sizeof(int) < sizeof(int32) { ok = false }
	if sizeof(int) > sizeof(int64) { ok = false }

	if ok {
		println("ok")
	} else {
		println("FAIL")
	}
}
