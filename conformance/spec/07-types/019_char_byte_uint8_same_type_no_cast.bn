package "main"

// type.scalar.char-byte-uint8: char, byte, and uint8 are THE SAME type --
// an 8-bit unsigned integer under three spellings; no conversion is needed
// between them. Cross-assign with NO cast, and (since arithmetic requires
// same-typed operands -- type.scalar.no-implicit-mix) add a char and a
// uint8 directly: this only type-checks if they are literally the same
// type. sizeof must also agree and equal 1.

func main() {
	var c char = 65
	var by byte = c          // char -> byte, no cast
	var u uint8 = by         // byte -> uint8, no cast
	var c2 char = u          // uint8 -> char, no cast

	// Same-type arithmetic with NO cast across the three spellings.
	var sum uint8 = c + u + by    // char + uint8 + byte, all one type

	if sizeof(char) == sizeof(uint8) && sizeof(byte) == 1 &&
		cast(int, c2) == 65 && cast(int, sum) == 195 {
		println("ok")
	} else {
		println("FAIL")
	}
}
