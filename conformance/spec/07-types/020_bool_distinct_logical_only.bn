package "main"
import "pkg/builtins/testing"

// type.scalar.bool: bool is a distinct non-numeric type with values true
// and false; it is the required operand type of && and ||, and of unary !.
// (Negatives 021/022 prove arithmetic/relational use is rejected.) Here
// bool behaves correctly under the logical operators and short-circuits.

func boom() bool {
	testing.Println("SHOULD-NOT-EVAL")
	return true
}

func main() {
	var t bool = true
	var f bool = false

	// && / || / ! with bool operands; the false-&&-... short-circuits boom().
	if (t && !f) && (f || t) && !(t && f) && !(f && boom()) {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
