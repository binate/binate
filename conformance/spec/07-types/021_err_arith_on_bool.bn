package "main"

// type.scalar.bool (Constraint): bool is NOT an integer -- arithmetic on
// bool is rejected. `+` requires same numeric-typed operands (§13.3); two
// bools have no numeric type, so `t + f` must be REJECTED at compile time.

func main() {
	var t bool = true
	var f bool = false
	var r bool = t + f
	_ = r
}
