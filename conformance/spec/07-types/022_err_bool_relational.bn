package "main"

// type.scalar.bool (Constraint): bool is not a relational operand -- the
// relational operators <, >, <=, >= require NUMERIC operands (§13.6). A
// relational comparison of two bools (`t < f`) must be REJECTED. (==/!=
// on bool ARE allowed -- that is equality, not relational -- so this test
// uses `<` specifically.)

func main() {
	var t bool = true
	var f bool = false
	var r bool = t < f
	_ = r
}
