package "main"

// type.scalar.no-implicit-mix (Constraint): there is no implicit widening
// between integer types. `int32 + int64` mixes two distinct integer types of
// different width and must be REJECTED -- the user must cast. (int32 and
// int64 differ in width on every target, so the rejection is target-
// invariant. `int + int64` would be mode-dependent: int and int64 share a
// width on a 64-bit host, so a known checker bug accepts that pair there.)

func main() {
	var a int32 = 1
	var b int64 = 2
	var c int32 = a + b
	_ = c
}
