package "main"

// type.scalar.no-implicit-mix (Constraint): there is no implicit int<->float
// mixing. `int + float64` must be REJECTED -- the user must cast one side
// explicitly. This is the int/float half of the no-implicit-mix rule.

func main() {
	var a int = 3
	var b float64 = 2.0
	var c float64 = a + b
	_ = c
}
