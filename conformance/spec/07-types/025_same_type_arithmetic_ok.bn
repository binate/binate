package "main"

// type.scalar.no-implicit-mix (positive half): operators on two operands of
// the SAME scalar type are accepted and produce that type. Exercise +/-/*
// within int, within int64 (cast literals to int64), and within float64,
// confirming same-type arithmetic is the supported path (the rejected
// mixed-type paths are 023/024).

func main() {
	var ai int = 10
	var bi int = 4
	var ri int = ai + bi - 2          // int op int -> int : 12

	var al int64 = cast(int64, 10)
	var bl int64 = cast(int64, 3)
	var rl int64 = al * bl            // int64 op int64 -> int64 : 30

	var af float64 = 2.5
	var bf float64 = 1.5
	var rf float64 = af + bf          // float64 op float64 -> float64 : 4.0

	if ri == 12 && cast(int, rl) == 30 && rf == 4.0 {
		println("ok")
	} else {
		println("FAIL")
	}
}
