package "main"

// type.scalar.no-implicit-mix (Constraint): `int` and `int64` are DISTINCT
// types even though they share a width on a 64-bit target (and `int` / `int32`
// on a 32-bit one). They do not implicitly mix in arithmetic, do not compare,
// and do not inter-assign without an explicit cast -- exactly like the
// different-width `int32` / `int64` pair (023), and matching Go. Each line below
// is independently rejected.
func main() {
	var a int = 1
	var b int64 = 2
	var sum = a + b      // arithmetic: mismatched types int and int64
	var eq = a == b      // comparison: mismatched types int and int64
	var c int64 = a      // assignment: cannot assign int to int64
	_ = sum
	_ = eq
	_ = c
}
