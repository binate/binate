package "main"

// type.scalar.no-implicit-mix: the correct way to combine `int` and `int64` is
// an explicit cast at the boundary. Once both operands share a type, arithmetic
// and assignment work; an untyped constant still coerces to either type without
// a cast.
func main() {
	var a int = 3
	var b int64 = 4

	// Cast `int` up to `int64`, then operate in int64.
	var sum int64 = cast(int64, a) + b
	// Cast `int64` down to `int`, then operate in int.
	var diff int = cast(int, b) - a
	// Untyped constants coerce to either type with no cast.
	var u64 int64 = 10
	var u int = 10

	if sum == 7 && diff == 1 && u64 == 10 && u == 10 {
		println("ok")
	} else {
		println("FAIL")
	}
}
