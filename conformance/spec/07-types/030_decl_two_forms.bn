package "main"

// type.decl.two-forms (positive): `type X U` (no `=`) declares a DISTINCT
// named type over underlying U; `type X = U` declares an ALIAS (the same
// type as U).  The distinct form needs a `cast` to cross to its underlying
// scalar; the alias is interchangeable with its target with no cast.  This
// pins both forms parsing and behaving as specified.

type Distinct int    // distinct named type over int
type Alias = int     // alias of int

func main() {
	var d Distinct = 5
	var a Alias = 7      // alias: bare int assigns with no cast
	var i int = a        // alias -> int with no cast
	println(cast(int, d) + i)   // 12
	if cast(int, d) + i == 12 {
		println("ok")
	} else {
		println("FAIL")
	}
}
