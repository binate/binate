package "main"
import "pkg/builtins/testing"

// type.decl.two-forms (Constraint): `type` declarations are PACKAGE-LEVEL
// only.  A function-local `type` declaration is a parse error -- after the
// statement keyword the parser does not accept a `type` decl inside a body.
// (Mirrors func.decl.form: nested function DECLARATIONS are likewise a
// parse error -- conformance/spec/10-functions/011_err_nested_func.bn.)

func main() {
	type Local int
	var x Local = 3
	testing.Println(cast(int, x))
}
