package "main"
import "pkg/builtins/testing"

// type.alias.transparency (positive): an alias is the SAME type as its
// target in every respect -- identity, assignability, comparison see
// through it.  An aliased int and a bare int inter-assign with no cast and
// compare equal; an alias of a struct-pointer is field-transparent.
// (Companion to 660_alias_field_read.bn, which pins the field-access facet.)

type Box struct {
	v int
}

type IntA = int        // alias of a scalar
type BoxA = @Box       // alias of a managed pointer-to-struct

func takesInt(x int) int {
	return x + 1
}

func main() {
	var a IntA = 41
	var b int = a              // alias -> int, no cast
	var c IntA = b             // int -> alias, no cast
	testing.Println(takesInt(c))       // 42  alias arg flows into int param
	if a == 41 && a == b {     // alias compares like int (no cast)
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}

	var p @Box = make(Box)
	p.v = 9
	var ab BoxA = p            // alias of @Box, no cast
	testing.Println(ab.v)              // 9  field-transparent through alias
}
