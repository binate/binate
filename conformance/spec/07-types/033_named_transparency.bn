package "main"
import "pkg/builtins/testing"

// type.named.transparency (positive): a distinct named type is TRANSPARENT
// to its underlying for operators (arithmetic, relational, equality), the
// kind built-ins (`len`), indexing, slicing, and field access -- the
// checker peels the named wrapper before applying the operation.
// (Mirrors 044_distinct_type.bn for arithmetic and 719/720 for
// slice/field transparency; consolidated here as the §7.3 transparency
// witness.)

type Celsius int       // distinct over a scalar: operators transparent
type Buf @[]int        // distinct over a managed-slice: index/slice/len transparent

type Box struct {
	x int
}
type H @Box            // distinct over @struct: field access transparent

func main() {
	// arithmetic + relational + equality on a named scalar (peels to int).
	var a Celsius = 10
	var b Celsius = 20
	var c Celsius = a + b
	testing.Println(cast(int, c))      // 30
	if a < b && c == 30 {
		testing.Println("cmp ok")
	} else {
		testing.Println("FAIL")
	}

	// index / slice / len on a named managed-slice (peels to @[]int).
	var buf Buf = make_slice(int, 3)
	buf[0] = 5
	buf[2] = 7
	testing.Println(buf[0] + buf[2])   // 12
	testing.Println(len(buf))          // 3
	var sub @[]int = buf[0:2]
	testing.Println(len(sub))          // 2

	// field access on a named @struct (peels + auto-derefs).
	var h H = make(Box)
	h.x = 99
	testing.Println(h.x)               // 99
}
