package "main"
import "pkg/builtins/testing"

// type.named.methods-not-inherited (Constraint): a distinct named type does
// NOT inherit its underlying type's methods.  `Base` has a method `tag`;
// `Derived` is distinct over `Base` and has its OWN (empty) method set, so
// calling `.tag()` on a `Derived` is rejected.  Reaching the underlying
// method requires an explicit `cast(Base, d)`.  (Fields are transparent;
// methods are not -- Go's defined-type model.)

type Base struct {
	v int
}

func (b Base) tag() int {
	return b.v + 1
}

type Derived Base   // distinct over Base; does NOT inherit tag()

func main() {
	var d Derived
	testing.Println(d.tag())     // rejected: tag is not in Derived's method set
}
