package "main"

// type.named.methods-not-inherited (positive complement): a distinct named
// type carries its OWN method set, and the underlying type's method is
// reached only through an explicit `cast` to the underlying.  `Base` has
// `tag`; `Derived` defines its own `tag` with different behavior; the
// underlying `Base.tag` is reachable via cast(Base, d).  This shows method
// lookup uses the distinct type's own set, not the underlying's.

type Base struct {
	v int
}

func (b Base) tag() int {
	return b.v + 1
}

type Derived Base

func (d Derived) tag() int {
	return cast(Base, d).v + 100   // its own method; reaches Base via cast
}

func main() {
	var d Derived
	d.v = 5                        // write the (transparent) field directly
	println(d.tag())               // 105  Derived's own method
	println(cast(Base, d).tag())   // 6    underlying Base.tag via cast
}
