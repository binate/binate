package "main"

// type.named.assignability (positive): a value crosses a distinct-type
// boundary WITHOUT a cast iff exactly one side is the named type and its
// underlying is an UNNAMED COMPOSITE (here a managed-slice).  `type Buf
// @[]int`: an `@[]int` assigns into a `Buf` and a `Buf` assigns into an
// `@[]int`, both with no cast.  (Mirrors 719_named_slice_transparency.bn,
// scoped to the assignability facet.)

type Buf @[]int   // underlying @[]int is an unnamed composite

func main() {
	var raw @[]int = make_slice(int, 3)
	var b Buf = raw            // unnamed @[]int -> named Buf, no cast
	b[0] = 4
	var back @[]int = b        // named Buf -> unnamed @[]int, no cast
	println(back[0] + len(back))   // 4 + 3 = 7
	if back[0] == 4 && len(back) == 3 {
		println("ok")
	} else {
		println("FAIL")
	}
}
