package "main"
import "pkg/builtins/testing"

// type.named.assignability (Constraint): two named types NEVER inter-assign
// implicitly, even with IDENTICAL underlying types.  `type A @[]int; type B
// @[]int` both have the same unnamed-composite underlying, but a `B` is not
// assignable to an `A` without a `cast` -- the one-named-side carve-out does
// not apply when BOTH sides are named.  (Spec §7.3 example: "type A @[]int;
// type B @[]int are not inter-assignable without a cast".)

type A @[]int
type B @[]int

func main() {
	var b B = make_slice(int, 2)
	var a A = b      // B -> A without cast: rejected (both named)
	testing.Println(len(a))
}
