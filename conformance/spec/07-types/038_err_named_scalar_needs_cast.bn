package "main"
import "pkg/builtins/testing"

// type.named.assignability (Constraint): a SCALAR underlying always requires
// a `cast`.  `type Celsius float64`: a bare `float64` value is NOT
// implicitly assignable to `Celsius` (and vice versa) -- the underlying
// float64 is a scalar, not an unnamed composite, so the one-named-side
// carve-out does not apply.  (Spec §7.3: "Celsius<->float64 needs a cast".)

type Celsius float64

func main() {
	var f float64 = 1.5
	var c Celsius = f      // float64 -> Celsius without cast: rejected (scalar)
	testing.Println(cast(int, c))
}
