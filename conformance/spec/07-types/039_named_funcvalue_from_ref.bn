package "main"

// type.named.func-value-nominal (positive): a named function-value type is
// NOMINAL and is CONSTRUCTIBLE from a function REFERENCE (a named
// function).  `type Fn @func(int) int; var f Fn = dbl` builds the value and
// it is callable.  (Mirrors conformance/spec/10-functions/093, scoped to
// the §7.3 type-level rule.)

type Fn @func(int) int

func dbl(x int) int {
	return x * 2
}

func main() {
	var f Fn = dbl        // construct named func-value from a function reference
	if f(21) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
