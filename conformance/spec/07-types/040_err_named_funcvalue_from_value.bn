package "main"

// type.named.func-value-nominal (Constraint): as an EXCEPTION to the
// unnamed-composite rule, a named function-value type is NOMINAL -- a bare,
// already-bound `@func(int) int` value is NOT implicitly assignable to `Fn`.
// (Contrast 039, which constructs Fn from a function REFERENCE.)  This is
// the type-level half of spec/10-functions/094.

type Fn @func(int) int

func dbl(x int) int {
	return x * 2
}

func main() {
	var g @func(int) int = dbl
	var f Fn = g          // bound @func value -> named Fn: rejected (nominal)
	println(f(21))
}
