package "main"
import "pkg/builtins/testing"

// type.named.func-value-nominal: a named func-value type `Fn` is constructible
// from a function reference AND from a function LITERAL
// (`var f Fn = func(...){...}`). The literal is hinted to the named type and
// lowers through the same @func machinery as the reference form; this pins that
// it constructs, calls, and returns the expected value.  (Mirrors
// spec/10-functions/102.)

type Fn @func(int) int

func main() {
	var f Fn = func(x int) int { return x * 3 }
	if f(14) == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
