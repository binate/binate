package "main"

// type.named.func-value-nominal (KNOWN GAP): the spec says `Fn` is
// constructible from a function reference; construction from a function
// LITERAL (`var f Fn = func(...){...}`) is a known gap -- intended but NOT
// yet implemented, and currently REJECTED in all modes.  This is the test
// the spec INTENDS to eventually pass; predicted xfail pending the
// literal-half fix (claude-todo; mirrors spec/10-functions/102).

type Fn @func(int) int

func main() {
	var f Fn = func(x int) int { return x * 3 }
	if f(14) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
