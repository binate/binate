package "main"

// type.named.comparison (positive): comparability follows the underlying
// type -- `type ID int` is comparable, so `==`/`!=` and the relational
// operators work on named-int values (peeled to int).

type ID int

func main() {
	var a ID = 5
	var b ID = 5
	var c ID = 9
	if a == b && a != c && a < c {
		println("ok")
	} else {
		println("FAIL")
	}
}
