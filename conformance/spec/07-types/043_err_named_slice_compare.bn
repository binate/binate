package "main"

// type.named.comparison (Constraint): slices are NEVER comparable (§7.6), so
// a named SLICE type is not comparable at all -- `==` on two `Buf` values is
// rejected, exactly as it is on bare `@[]int`.  The named wrapper does not
// add comparability the underlying lacks.

type Buf @[]int

func main() {
	var a Buf = make_slice(int, 2)
	var b Buf = make_slice(int, 2)
	if a == b {        // named slice equality: rejected (slices not comparable)
		println("unreachable")
	}
}
