package "main"

// type.named.comparison (Constraint): equality on ARRAY types is not
// currently available (rejected), and a named array type does not add it.
// `type Row [3]int`; `==` on two `Row` values is rejected.

type Row [3]int

func main() {
	var a Row
	var b Row
	if a == b {        // named array equality: rejected (array equality unavailable)
		println("unreachable")
	}
}
