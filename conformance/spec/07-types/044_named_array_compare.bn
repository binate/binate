package "main"
import "pkg/builtins/testing"

// type.named.comparison (positive): array types are comparable element-wise
// (expr.compare.aggregate), and a named array type's comparability follows its
// underlying — `type Row [3]int` compares like [3]int (paralleling the named
// scalar case in 042).

type Row [3]int

func main() {
	var a Row
	var b Row
	var c Row
	c[1] = 9
	// a and b are both {0,0,0}; c is {0,9,0}.
	if a == b && a != c {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
