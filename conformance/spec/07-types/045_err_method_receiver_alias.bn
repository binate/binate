package "main"
import "pkg/builtins/testing"

// type.named.methods-same-package (Constraint): a method receiver, after
// stripping */@/readonly, must be a NAMED type declared in this package.
// An ALIAS is not a distinct named type, so it may not be a receiver base
// -- rejected at type check.  (Mirrors conformance/324_err_method_alias.bn
// and spec/10-functions/042; scoped here to the §7.3 rule-ID.)

type MyInt = int   // alias, not a named distinct type

func (m MyInt) get() int {
	return cast(int, m)
}

func main() {
	testing.Println("ignored")
}
