package "main"
import "pkg/builtins/testing"

// type.named.methods-same-package (Constraint): a method receiver must be a
// same-package named type; a predeclared/builtin type cannot be a receiver
// in an ordinary package.  The single-file `main` package is NOT the
// pkg/builtins/lang carve-out, so a method on the universe primitive `int`
// is REJECTED.  (Mirrors 325_err_method_builtin.bn and
// spec/10-functions/044; scoped to §7.3.)

func (i int) foo() int {
	return i + 1
}

func main() {
	var a int = 1
	testing.Println(a.foo())
}
