package "main"
import "pkg/builtins/testing"

import "pkg/widget"

// type.named.methods-same-package (Constraint): a method may be declared
// ONLY in the package that defines its receiver's named type.  `Widget` is
// defined in pkg/widget, so declaring a method on `*widget.Widget` here in
// main -- an IMPORTED type -- is rejected.  (Mirrors
// spec/11-interfaces/058_err_method_foreign_type; scoped to the §7.3
// receiver-locality rule.)

func (w *widget.Widget) extra() int {
	return w.side + 1
}

func main() {
	var w widget.Widget
	w.side = 1
	testing.Println(w.extra())
}
