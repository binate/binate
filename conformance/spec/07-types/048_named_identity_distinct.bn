package "main"
import "pkg/builtins/testing"

// type.named.identity (Constraint, same-package facet): two distinct named
// non-struct types are identical iff they have the same identity (the
// wrapper's own name).  `A` and `B` are different names over the same
// underlying `int`, so they are NOT the same type and do not inter-assign
// without a cast -- a same-package witness that identity is by NAME, not by
// underlying shape.  (The cross-package same-short-name facet is 049.)

type A int
type B int

func main() {
	var a A = 5
	var b B = a      // A -> B without cast: rejected (distinct identities)
	testing.Println(cast(int, b))
}
