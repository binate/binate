package "main"
import "pkg/builtins/testing"

import "pkg/red"
import "pkg/blue"

// type.named.identity (Constraint, cross-package facet): two cross-package
// types with the same SHORT name are DISTINCT.  pkg/red and pkg/blue each
// declare `type T int`; a `red.T` value is NOT assignable to a `blue.T`
// without a cast -- identity is by package-qualified name, not short name.

func main() {
	var r red.T = red.Make()
	var b blue.T = r      // red.T -> blue.T without cast: rejected (distinct)
	testing.Println(cast(int, b))
}
