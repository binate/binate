package "main"
import "pkg/builtins/testing"

// type.struct.decl (§7.4): a named struct type is declared `type Name
// struct { ... }`, with an ordered list of (name, type) fields whose names
// and order are significant.  A field may be of any type.  This positive
// test declares such a struct, populates each field by name, reads them
// back, and confirms field-by-name access works.

type Rec struct {
	a int
	b int
	c int
}

func main() {
	var r Rec
	r.a = 1
	r.b = 2
	r.c = 3
	if r.a == 1 && r.b == 2 && r.c == 3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
