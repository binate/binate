package "main"
import "pkg/builtins/testing"

// type.struct.decl (constraint side, §7.4): there is NO `struct Name { ... }`
// shorthand.  `struct{ ... }` is ONLY a type expression; a named struct must
// be introduced through a `type` declaration (`type Name struct { ... }`).
// A bare top-level `struct Name { ... }` is not a declaration form the parser
// accepts, so it is rejected.

struct Foo {
	x int
}

func main() {
	testing.Println(0)
}
