package "main"
import "pkg/builtins/testing"

// type.struct.value (§7.4): a struct is a VALUE type -- copied on assignment
// and parameter passing, living inline.  Mutating a copy does not affect the
// original.  The only pointer to a struct is a RAW pointer: `&s` yields *T,
// and writing through that raw pointer DOES mutate the aliased original
// (proving &s is a *Point view of s, not a copy).

type Point struct {
	x int
	y int
}

func mutateCopy(p Point) {
	p.x = 999
}

func main() {
	var ok bool = true

	// Copy-on-assignment: b is a copy of a; mutating b leaves a unchanged.
	var a Point
	a.x = 1
	a.y = 2
	var b Point = a
	b.x = 10
	if a.x != 1 { ok = false }
	if b.x != 10 { ok = false }

	// Copy-on-parameter-pass: callee mutates its own copy only.
	mutateCopy(a)
	if a.x != 1 { ok = false }

	// &s yields *Point; writing through it mutates the original s.
	var p *Point = &a
	p.x = 42
	if a.x != 42 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
