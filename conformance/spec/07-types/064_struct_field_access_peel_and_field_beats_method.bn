package "main"

// type.struct.field-access (§7.4 / §7.3): field access `x.f` looks up `f` on
// the wrapper-peeled struct base -- a named-distinct wrapper AND a single
// pointer indirection are transparent.  Also: a field takes precedence over a
// same-named method.  Here `Box` has both a field `m` (an int) and a method
// `m` (returning a different value); reading `x.m` yields the FIELD's value.
// Field access is exercised through a named-distinct wrapper (`Handle`) and
// through auto-deref of a raw pointer.

type Box struct {
	n int
	m int
}

// A method named `m` on Box -- the same-named field must take precedence.
func (b *Box) m() int {
	return 999
}

// Named-distinct over Box: field access peels the named wrapper (§7.3).
type Handle Box

func main() {
	var ok bool = true

	var b Box
	b.n = 7
	b.m = 5
	// Field `m` beats method `m`: reading b.m gives the field value 5.
	if b.m != 5 { ok = false }
	if b.n != 7 { ok = false }

	// Field access through a single pointer indirection (auto-deref).
	var p *Box = &b
	if p.n != 7 { ok = false }
	if p.m != 5 { ok = false }

	// Field access through a named-distinct wrapper (peeled to Box).
	var h Handle
	h.n = 3
	h.m = 4
	if h.n != 3 { ok = false }
	if h.m != 4 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
