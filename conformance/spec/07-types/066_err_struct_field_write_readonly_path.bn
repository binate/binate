package "main"

// type.struct.field-access (constraint side, §7.4 / §7.11): a `readonly`
// access path propagates onto the reached field type (object-const), so a
// WRITE through a read-only path is rejected.  `rs` is a `readonly S` value;
// field access `rs.a` is a const-typed location, and assigning to it must be
// rejected (reading it is fine -- §7.11 readonly is permissive for reads).

type S struct {
	a int
	b int
}

func main() {
	var s S
	s.a = 1
	s.b = 2
	var rs readonly S = s
	rs.a = 9
	println(rs.b)
}
