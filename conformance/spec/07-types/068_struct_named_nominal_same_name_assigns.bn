package "main"
import "pkg/builtins/testing"

// type.struct.named-nominal (§7.4): two struct types are identical iff their
// package-qualified names match.  A struct inter-assigns with itself, and an
// ALIAS of a named struct (`type PointAlias = Point`) is the SAME type (§7.3
// type.alias.transparency) -- a Point value assigns to a PointAlias var and
// vice versa with no cast, because they share one identity `main.Point`.

type Point struct {
	x int
	y int
}

type PointAlias = Point

func main() {
	var ok bool = true

	var p Point
	p.x = 3
	p.y = 4

	// Alias is the same type: assigns both directions without a cast.
	var pa PointAlias = p
	if pa.x != 3 || pa.y != 4 { ok = false }

	pa.x = 30
	var p2 Point = pa
	if p2.x != 30 || p2.y != 4 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
