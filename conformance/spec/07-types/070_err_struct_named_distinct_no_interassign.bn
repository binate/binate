package "main"
import "pkg/builtins/testing"

// type.struct.named-nominal (constraint side, §7.4): two DISTINCT named
// structs with identical fields are NOT identical and do NOT inter-assign
// implicitly -- field shape is irrelevant once a struct is named.  A and B
// have the same fields but distinct names; `var b B = a` is rejected.

type A struct {
	x int
	y int
}

type B struct {
	x int
	y int
}

func main() {
	var a A
	a.x = 1
	a.y = 2
	var b B = a
	testing.Println(b.x)
}
