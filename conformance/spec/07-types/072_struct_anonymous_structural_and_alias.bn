package "main"

// type.struct.anonymous-structural (§7.4): anonymous struct types use
// STRUCTURAL equivalence -- two `struct{...}` types are identical iff same
// field count and, position by position, equal field NAMES and identical
// field TYPES.  `type Pair = struct{ x int; y int }` is an ALIAS for that
// anonymous type (§7.3), so a value of the textually-identical anonymous
// shape assigns to a Pair var and is accepted as an argument of that anon
// type at a call boundary.

type Pair = struct {
	x int
	y int
}

// Parameter typed as the bare anonymous struct: structural identity must
// accept a Pair value (Pair IS that anonymous type) and a directly-built
// anonymous value alike.
func sum(p struct { x int; y int }) int {
	return p.x + p.y
}

func main() {
	var ok bool = true

	// Build a value of the bare anonymous shape.
	var a struct { x int; y int }
	a.x = 3
	a.y = 4

	// Anonymous value assigns to the alias-typed var (same type).
	var pr Pair = a
	if pr.x != 3 || pr.y != 4 { ok = false }

	// Alias value assigns back to a bare-anonymous-typed var.
	var a2 struct { x int; y int } = pr
	if a2.x != 3 || a2.y != 4 { ok = false }

	// Structural identity at a call boundary: both anon and alias accepted.
	if sum(a) != 7 { ok = false }
	if sum(pr) != 7 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
