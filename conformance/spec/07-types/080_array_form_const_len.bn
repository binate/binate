package "main"

// type.array.form (positive): an array type is `[N]T` with a compile-time
// constant non-negative length. A literal length and a `const`-named length
// both work; indexing and len() see the fixed size. Pinned target-invariantly
// (no sizes hardcoded -- only the element COUNT, which is fixed by the type).

const N int = 4

func main() {
	var ok bool = true
	var a [3]int = [3]int{10, 20, 30}
	if len(a) != 3 || a[0] != 10 || a[2] != 30 { ok = false }

	var b [N]int = [N]int{1, 2, 3, 4}
	if len(b) != 4 || b[3] != 4 { ok = false }

	// A zero-length array is a valid form (non-negative const).
	var z [0]int
	if len(z) != 0 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
