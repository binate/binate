package "main"

// type.array.form (constraint): a NON-CONSTANT array length is rejected. The
// length must be a compile-time constant; a runtime variable cannot size a
// fixed array (use make_slice for a runtime-sized collection).

func dim() int { return 3 }

func main() {
	var n int = dim()
	var a [n]int
	println(len(a))
}
