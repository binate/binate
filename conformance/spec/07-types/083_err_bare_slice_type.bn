package "main"

// type.array.form (constraint) / type.slice.kinds: bare `[]T` is NOT a valid
// type. It is neither an array (no length) nor a slice (raw slices are `*[]T`,
// managed-slices `@[]T`). The bare form must be rejected, directing the user
// to the sigil-prefixed slice spellings.

func main() {
	var s []int
	_ = s
}
