package "main"
import "pkg/builtins/testing"

// type.array.value (positive): arrays are VALUE types -- assignment and
// parameter passing COPY the whole array inline. Mutating a copy (a local or
// a by-value parameter) must not affect the original.

func bump(a [3]int) int {
	a[0] = 999 // mutates the callee's copy only
	return a[0]
}

func main() {
	var ok bool = true
	var orig [3]int = [3]int{1, 2, 3}

	// Copy via assignment.
	var dup [3]int = orig
	dup[0] = 100
	if orig[0] != 1 || dup[0] != 100 { ok = false }

	// Copy via parameter passing.
	if bump(orig) != 999 || orig[0] != 1 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
