package "main"

// type.array.value (identity): two array types are identical iff they have
// equal length AND identical element type. `[3]int` and `[4]int` are DISTINCT
// types, so assigning one to the other is rejected (no implicit length change).

func main() {
	var a [3]int = [3]int{1, 2, 3}
	var b [4]int = a
	_ = b
}
