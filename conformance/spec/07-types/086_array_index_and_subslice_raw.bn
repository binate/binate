package "main"
import "pkg/builtins/testing"

// type.array.index-slice (positive): `arr[i]` yields the element type, and
// `arr[lo:hi]` yields a RAW slice `*[]T` (an array has no refcounted backing,
// so its sub-slice is a borrowing view). We prove the result is a `*[]T` by
// assigning it into an explicitly-typed raw-slice variable and by passing it
// to a `*[]int` parameter; mutating through the raw slice writes BACK into the
// array's storage (a borrow, not a copy).

func sum(s *[]int) int {
	var t int = 0
	for i := 0; i < len(s); i++ { t = t + s[i] }
	return t
}

func main() {
	var ok bool = true
	var arr [5]int = [5]int{10, 20, 30, 40, 50}

	// Indexing yields the element type (int).
	if arr[0] != 10 || arr[4] != 50 { ok = false }

	// Sub-slice yields *[]T -- assignable to a raw-slice variable.
	var view *[]int = arr[1:4]
	if len(view) != 3 || view[0] != 20 || view[2] != 40 { ok = false }
	if sum(view) != 90 { ok = false }

	// The raw slice BORROWS the array's storage: a write is observable
	// through the array (not a copy).
	view[0] = 99
	if arr[1] != 99 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
