package "main"
import "pkg/builtins/testing"

// type.slice.kinds (positive): there are exactly two slice kinds, `*[]T` (raw)
// and `@[]T` (managed), and they are DISTINCT types. They are not unified: a
// managed-slice flows into a raw-slice slot (the one-way decay; see 091), and
// each kind is usable in its own typed slot. This test pins that both kinds
// exist and carry the same element type independently.

func rawLen(s *[]int) int { return len(s) }
func manLen(s @[]int) int { return len(s) }

func main() {
	var ok bool = true
	var m @[]int = make_slice(int, 3)
	m[0] = 7

	// Managed slot keeps it managed.
	if manLen(m) != 3 { ok = false }

	// Raw slot accepts the managed value by decay (distinct kinds, one-way).
	var r *[]int = m
	if rawLen(r) != 3 || r[0] != 7 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
