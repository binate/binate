package "main"

// type.slice.ownership (positive): a managed-slice `@[]T` OWNS its backing by
// reference counting -- it keeps the allocation alive. A sub-slice of a
// managed-slice shares and RefInc's the same backing, so dropping the original
// owner does NOT free the backing while the sub-slice still holds a ref. A
// raw slice `*[]T` borrows (holds no count) -- observed by reading through it
// while the managed owner is alive.

func main() {
	var items @[]int = make_slice(int, 4)
	items[0] = 10
	items[1] = 20
	items[2] = 30
	items[3] = 40

	// Managed sub-slice RefInc's the backing.
	var sub @[]int = items[1:3]

	// Raw borrow of the live managed backing (no refcount change).
	var borrow *[]int = items

	// Drop the original owner; the backing must survive via `sub`'s ref.
	var zero @[]int
	items = zero

	// These would crash if the backing had been freed.
	var ok bool = true
	if len(sub) != 2 || sub[0] != 20 || sub[1] != 30 { ok = false }
	_ = borrow
	if ok { println("ok") } else { println("FAIL") }
}
