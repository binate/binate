package "main"
import "pkg/builtins/testing"

// type.slice.make (positive): `make_slice(T, n)` returns a managed-slice
// `@[]T` of exactly `n` ZERO-initialized elements. We prove: the kind is
// managed (assignable to an @[]T slot, and decays to *[]T), the length is n,
// and every element reads as the zero value before any write. Also covers a
// runtime (non-constant) `n` -- make_slice is the only runtime-sized maker.

func count() int { return 5 }

func main() {
	var ok bool = true
	var s @[]int = make_slice(int, count())
	if len(s) != 5 { ok = false }
	for i := 0; i < len(s); i++ {
		if s[i] != 0 { ok = false } // zero-initialized
	}

	// make_slice(T, 0) is the no-backing empty (len 0).
	var e @[]int = make_slice(int, 0)
	if len(e) != 0 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
