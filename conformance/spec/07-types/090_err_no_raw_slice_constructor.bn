package "main"

// type.slice.make (constraint): there is NO raw-slice constructor. A
// runtime-sized raw slice would have no owner and thus no defined lifetime.
// `make_slice` only makes `@[]T`; and a mutable raw-slice composite literal
// `*[]T{...}` is rejected (a writable raw view of rodata/stack is unsound --
// use `*[]readonly T{...}` or `@[]T{...}`).

func main() {
	var s *[]int = *[]int{1, 2, 3}
	_ = s
}
