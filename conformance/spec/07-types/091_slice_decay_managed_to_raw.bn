package "main"

// type.slice.decay (positive): a managed-slice is IMPLICITLY assignable to a
// raw slice of the same element type (`@[]T` -> `*[]T`) -- a borrow (a copy of
// the first two words, no refcount change). Exercised at a variable
// initializer and at a call site.

func rawSum(s *[]int) int {
	var t int = 0
	for i := 0; i < len(s); i++ { t = t + s[i] }
	return t
}

func main() {
	var ok bool = true
	var m @[]int = make_slice(int, 3)
	m[0] = 10
	m[1] = 20
	m[2] = 30

	// Implicit @[]int -> *[]int at a var initializer.
	var r *[]int = m
	if len(r) != 3 || r[0] != 10 || r[2] != 30 { ok = false }

	// Implicit @[]int -> *[]int at a call site.
	if rawSum(m) != 60 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
