package "main"

// type.slice.decay (constraint): the reverse `*[]T` -> `@[]T` is NEVER
// implicit -- a raw slice has no backing to promote, so it cannot become a
// managed-slice without inventing a reference. The assignment must be
// rejected.

func main() {
	var m @[]int = make_slice(int, 3)
	var r *[]int = m       // ok: managed decays to raw
	var back @[]int = r    // rejected: raw cannot promote to managed
	_ = back
}
