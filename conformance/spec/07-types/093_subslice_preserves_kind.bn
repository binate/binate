package "main"

// type.slice.subslice (positive): sub-slicing preserves the slice KIND.
//   @[]T[lo:hi] -> @[]T   (managed sub-slice; assignable to an @[]T slot)
//   *[]T[lo:hi] -> *[]T   (raw sub-slice; assignable to a *[]T slot)
//   arr[lo:hi]  -> *[]T   (array sub-slice is raw; see also 086 / §7.5)
// We prove each result kind by assigning into an explicitly-kinded slot.

func main() {
	var ok bool = true

	// Managed sub-slice stays managed.
	var m @[]int = make_slice(int, 4)
	m[0] = 1
	m[1] = 2
	m[2] = 3
	m[3] = 4
	var ms @[]int = m[1:3]
	if len(ms) != 2 || ms[0] != 2 || ms[1] != 3 { ok = false }

	// Raw sub-slice stays raw.
	var r *[]int = m
	var rs *[]int = r[2:4]
	if len(rs) != 2 || rs[0] != 3 || rs[1] != 4 { ok = false }

	// Array sub-slice is raw.
	var arr [4]int = [4]int{10, 20, 30, 40}
	var as *[]int = arr[0:2]
	if len(as) != 2 || as[0] != 10 || as[1] != 20 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
