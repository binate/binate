package "main"
import "pkg/builtins/testing"

// type.slice.readonly-element (positive): a slice may carry a `readonly`
// element type, and ADDING element-level readonly is allowed implicitly
// (`@[]T` -> `@[]readonly T`, `*[]T` -> `*[]readonly T`). The readonly element
// view still reads the same backing; readonly is layout-transparent.

func roLen(s @[]readonly int) int { return len(s) }

func main() {
	var ok bool = true
	var m @[]int = make_slice(int, 3)
	m[0] = 10
	m[1] = 20
	m[2] = 30

	// Add element-level readonly to a managed-slice (implicit widening).
	var ro @[]readonly int = m
	if len(ro) != 3 || ro[0] != 10 || ro[2] != 30 { ok = false }

	// Add readonly to a raw slice too.
	var r *[]int = m
	var rro *[]readonly int = r
	if len(rro) != 3 || rro[1] != 20 { ok = false }

	// Pass-as-argument adds readonly at the call boundary.
	if roLen(m) != 3 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
