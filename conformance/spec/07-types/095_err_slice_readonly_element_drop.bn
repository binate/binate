package "main"

// type.slice.readonly-element (constraint): DROPPING element-level readonly is
// NOT implicit -- `@[]readonly char` -> `@[]char` requires a `cast`. (The
// string-literal-to-@[]char allocate+copy path is a separate special case; here
// the source is a NON-literal readonly-element value, so the drop is rejected.)

func main() {
	var m @[]char = make_slice(char, 2)
	var ro @[]readonly char = m   // add readonly: allowed
	var drop @[]char = ro         // drop readonly: rejected (needs cast)
	_ = drop
}
