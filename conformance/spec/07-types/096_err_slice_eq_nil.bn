package "main"
import "pkg/builtins/testing"

// type.slice.no-nil-no-compare (constraint): a slice is NOT comparable and not
// nillable, so `s == nil` is rejected -- nil is not a slice value, so the
// comparison is a type mismatch ("mismatched types @[]int and nil"), unlike a
// pointer where `p == nil` is allowed. (The slice-vs-slice == rejection is 098;
// nil-not-assignable is 097.) Test emptiness with `len(s) == 0` or `present(s)`.

func main() {
	var s @[]int = make_slice(int, 2)
	if s == nil {
		testing.Println("bad")
	}
}
