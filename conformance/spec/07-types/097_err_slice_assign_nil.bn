package "main"

// type.slice.no-nil-no-compare (constraint): a slice is NOT nillable -- it
// cannot be ASSIGNED from `nil`. Both the managed and raw kinds reject
// `s = nil`. (`nil` is for pointers and function values, not slices; §7.7.)

func main() {
	var r *[]int = make_slice(int, 1)
	r = nil
	var m @[]int = make_slice(int, 1)
	m = nil
}
