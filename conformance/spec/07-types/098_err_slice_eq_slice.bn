package "main"

// type.slice.no-nil-no-compare (constraint): slices are not comparable to
// EACH OTHER either -- `s == t` on two slices of identical type is rejected
// (slices are never comparable in Binate). Use len()/present() or an explicit
// element-wise loop.

func main() {
	var a @[]int = make_slice(int, 1)
	var b @[]int = make_slice(int, 1)
	if a == b {
		println("bad")
	}
}
