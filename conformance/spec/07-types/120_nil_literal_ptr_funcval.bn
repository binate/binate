package "main"

// type.nil.literal / type.ptr.nullability: `nil` is assignable to the
// nillable types -- raw pointers, managed pointers, and function values --
// and is the zero/not-present state of each. A nil pointer/func value reads
// as not-present (present() is the sanctioned test; func values have no
// `== nil`). This pins that nil targets exactly the nillable kinds.

func fortyTwo() int { return 42 }

func main() {
	var rp *int = nil       // nil -> raw pointer
	var mp @int = nil       // nil -> managed pointer
	var rf *func() int = nil // nil -> raw function value
	var mf @func() int = nil // nil -> managed function value
	if !present(rp) && !present(mp) && !present(rf) && !present(mf) {
		println("ok")
	} else {
		println("FAIL")
	}
}
