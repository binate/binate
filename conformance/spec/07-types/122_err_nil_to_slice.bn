package "main"

// type.nil.literal (negative) / type.slice.no-nil-no-compare: `nil` is NOT
// assignable to a slice (slices are not nillable -- emptiness is len()==0 /
// present()). Both the raw and managed slice kinds must reject `= nil`.
// (Bare `var s *[]int` is the zeroed no-backing empty and is allowed; only
// an explicit nil assignment is rejected.)

func main() {
	var s *[]int
	s = nil
	var ms @[]int
	ms = nil
}
