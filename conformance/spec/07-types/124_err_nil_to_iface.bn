package "main"

// type.nil.literal (negative): `nil` is not assignable to an interface
// value (an iface value is two words {data, vtable}, not a nillable
// pointer). Test emptiness with present(), not nil. Both raw and managed
// iface-value kinds must reject `= nil`.

interface Greeter {
	greet() int
}

func main() {
	var iv *Greeter = nil
	var mv @Greeter = nil
	_ = iv
	_ = mv
}
