package "main"

// type.ptr.nullability / type.nil.literal: in v1 ALL pointer types are
// nullable -- nil is assignable to any raw or managed pointer, of any
// pointee type (scalar, struct, pointer-to-pointer). A nil pointer is
// not-present; assigning a real address makes it present. Reassigning a
// present pointer back to nil makes it not-present again.

type Box struct { v int }

func main() {
	var pi *int = nil
	var pb *Box = nil
	var pp *(*int) = nil   // raw pointer to a raw pointer
	var mb @Box = nil      // managed pointer
	if present(pi) || present(pb) || present(pp) || present(mb) {
		println("FAIL")
		return
	}
	var x int = 7
	pi = &x
	if !present(pi) {
		println("FAIL")
		return
	}
	pi = nil
	if present(pi) {
		println("FAIL")
		return
	}
	println("ok")
}
