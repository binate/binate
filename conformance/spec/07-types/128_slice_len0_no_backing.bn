package "main"

// type.slice.len0-no-backing: every length-0 slice is the no-backing empty
// (the nil-equivalent {null,0[,null,0]}). make_slice(T,0), an empty
// sub-slice (lo==hi), and an empty composite/string literal all yield it:
// len()==0 and present()==false (present reads the data word, which is
// null for an empty slice). All empty slices of a type are `same` (the one
// canonical empty). Target-invariant -- a single "ok" on every mode.

func main() {
	var z @[]int = make_slice(int, 0)        // make_slice(T,0)
	var s @[]int = make_slice(int, 5)
	var sub @[]int = s[2:2]                   // empty sub-slice
	var lit *[]readonly int = *[]readonly int{} // empty raw composite literal
	if len(z) != 0 || len(sub) != 0 || len(lit) != 0 {
		println("FAIL")
		return
	}
	if present(z) || present(sub) {
		println("FAIL")
		return
	}
	if !same(z, sub) {            // all empties are the canonical {null,0,...}
		println("FAIL")
		return
	}
	println("ok")
}
