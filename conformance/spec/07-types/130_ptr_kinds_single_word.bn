package "main"

// type.ptr.kinds: both pointer constructors -- managed `@T` and raw `*T` --
// are single-word value types (one word = sizeof(int) on every target).
// Asserted as a target-invariant RELATIONSHIP (sizeof(ptr)==sizeof(int)),
// so it is a single "ok" on host (W=8) and arm32 (W=4) alike. Also pins
// that *T and @T are the same width.

type Box struct { v int }

func main() {
	var w uint = sizeof(int)
	if sizeof(*int) == w && sizeof(@int) == w &&
		sizeof(*Box) == w && sizeof(@Box) == w &&
		sizeof(*int) == sizeof(@int) {
		println("ok")
	} else {
		println("FAIL")
	}
}
