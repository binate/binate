package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// type.ptr.kinds / type.ptr.semantics: copying a `@T` is a value copy that
// ADDITIONALLY increments the pointee's reference count; copying a `*T` is
// a plain bit copy with NO refcount effect (and a *T borrowed from a @T
// owns no reference). rt.Refcount reads the count through the payload
// pointer (bit_cast to *uint8), as in conformance/137.

type Box struct { v int }

func main() {
	var a @Box = make(Box)
	a.v = 1
	var p *uint8 = bit_cast(*uint8, a)
	var rc0 int = rt.Refcount(p)        // baseline (1)

	var b @Box = a                      // managed copy: RefInc -> rc0+1
	var rc1 int = rt.Refcount(p)

	var r *Box = a                      // raw borrow/decay: NO refcount change
	var rc2 int = rt.Refcount(p)

	if rc1 == rc0 + 1 && rc2 == rc1 && b.v == 1 && r.v == 1 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
