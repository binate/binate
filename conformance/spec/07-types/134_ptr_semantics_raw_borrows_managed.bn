package "main"
import "pkg/builtins/testing"

// type.ptr.semantics: `*T` is the non-owning escape hatch -- a raw pointer
// to a managed value BORROWS (holds no count; the @T keeps the pointee
// alive). Writing through the raw borrow mutates the same object the @T
// owns, and `.` auto-dereferences a raw pointer (no ->). The @Box stays
// in scope, so the borrow sees a valid pointee.

type Box struct { v int }

func main() {
	var m @Box = make(Box)
	m.v = 10
	var r *Box = m        // raw borrow of the managed value (decay)
	r.v = 42              // write through the borrow (auto-deref)
	if m.v == 42 {        // observed through the owning @Box
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
