package "main"

// type.ptr.address-of: `&x` always yields a RAW `*T`, even when x is a
// managed value. There is no operator that takes a managed address;
// managed pointers arise only from make/box/make_slice. Here &m (m a @Box
// lvalue) yields `*(@Box)` -- a raw pointer to the managed-pointer slot --
// which is assignable to a `*(@Box)` variable (a *T), confirming the
// result kind is raw, and reading through it recovers the pointee.

type Box struct { v int }

func main() {
	var m @Box = make(Box)
	m.v = 7
	var pm *(@Box) = &m   // address of a managed lvalue is a RAW pointer
	if pm[0].v == 7 {     // deref the raw pointer -> the @Box -> field
		println("ok")
	} else {
		println("FAIL")
	}
}
