package "main"

// type.ptr.address-of (negative) / type.readonly.vs-const: `&` of a `const`
// is an error -- a const has no storage and no address (it is a
// compile-time value, not a variable). Contrast with `var x readonly T`,
// which HAS storage and whose address (&x -> *readonly T) is fine.

const C int = 5

func main() {
	var p *int = &C
	_ = p
}
