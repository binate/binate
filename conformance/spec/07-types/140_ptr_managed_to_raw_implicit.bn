package "main"

// type.ptr.managed-to-raw: `@T` -> `*T` is an IMPLICIT conversion (a borrow
// that owns no reference) -- no cast needed. Exercised across an
// assignment, a parameter pass, and a return. The raw pointer aliases the
// same pointee the @T owns.

type Box struct { v int }

func readV(p *Box) int { return p.v }

func borrow(m @Box) *Box { return m }   // @Box -> *Box on return (implicit)

func main() {
	var m @Box = make(Box)
	m.v = 9
	var r *Box = m            // implicit @T -> *T on assignment
	var viaParam int = readV(m) // implicit @T -> *T on parameter pass
	var viaRet *Box = borrow(m)
	if r.v == 9 && viaParam == 9 && viaRet.v == 9 {
		println("ok")
	} else {
		println("FAIL")
	}
}
