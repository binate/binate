package "main"

// type.ptr.managed-to-raw (negative): the reverse `*T` -> `@T` is NEVER
// implicit -- promoting a raw pointer to a managed one would invent a
// reference count (a *T has no refcount header to own). Must be rejected.

type Box struct { v int }

func main() {
	var b Box
	var p *Box = &b
	var m @Box = p   // *T -> @T must be rejected (no implicit promotion)
	_ = m
}
