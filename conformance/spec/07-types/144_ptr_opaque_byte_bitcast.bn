package "main"

// type.ptr.opaque-byte: `*uint8` is the opaque byte pointer (the analog of
// C's void*; there is no separate void/opaque pointer type). bit_cast
// reinterprets between a typed pointer and `*uint8` and back. A round-trip
// `*int -> *uint8 -> *int` recovers the same pointee (writes through the
// recovered typed pointer are visible through the original).

func main() {
	var x int = 41
	var pi *int = &x
	var pb *uint8 = bit_cast(*uint8, pi)   // typed ptr -> opaque byte ptr
	var pi2 *int = bit_cast(*int, pb)      // opaque byte ptr -> typed ptr
	pi2[0] = 41 + 1                        // write through the round-tripped ptr
	if x == 42 {                           // observed through the original
		println("ok")
	} else {
		println("FAIL")
	}
}
