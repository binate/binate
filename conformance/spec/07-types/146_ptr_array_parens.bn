package "main"

// type.ptr.array-parens: a pointer to an array is written with PARENTHESES
// -- `*([N]T)` (raw) and `@([N]T)` (managed) -- because the bare `*[`/`@[`
// forms are reserved for the slice sugar `*[]T`/`@[]T` (the bare array-pointer
// forms `*[N]T`/`@[N]T` are rejected; 148/150). Both parenthesized forms
// type-check; the raw form points at an array lvalue and is read through an
// explicit deref `(*p)[i]`.

func main() {
	var arr [3]int = [3]int{10, 20, 30}
	var p *([3]int) = &arr           // raw pointer to array (parenthesized)
	var m @([3]int) = make([3]int)   // managed pointer to array (parenthesized) -- type-checks
	_ = m
	if (*p)[1] == 20 && (*p)[2] == 30 {
		println("ok")
	} else {
		println("FAIL")
	}
}
