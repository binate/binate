package "main"

// type.value.managed-arise / type.ptr.array-parens: a managed pointer to an
// array `@([N]T)` supports indexing through an explicit dereference --
// `(*m)[i]` reads and writes element i in place, exactly like the raw
// `*([N]T)` form (146).  Regression witness: `(*m)[i]` emitted invalid
// getelementptr indices because OP_GET_ELEM_PTR's LLVM lowering took the
// array-alloca DOUBLE-index path for a managed-pointer base instead of the
// single-index pointer path (a managed pointer is an i8* that points at the
// element buffer, just like a raw one).
func main() {
	var m @([3]int) = make([3]int)
	(*m)[0] = 5
	(*m)[1] = 9
	(*m)[2] = 7
	println((*m)[0] + (*m)[2])   // 12
	println((*m)[1])             // 9
	println(len(*m))             // 3
}
