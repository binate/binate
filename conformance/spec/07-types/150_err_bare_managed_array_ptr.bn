package "main"

// type.ptr.array-parens (negative): bare `@[N]T` is a syntax error -- `@[`
// is managed-slice sugar (`@[]T`), so a managed pointer to an array must be
// parenthesized `@([N]T)`. The spec (§7.8) historically flagged a parser
// LENIENCY where bare `@[N]T` was silently ACCEPTED as `@([N]T)` (the
// `type.ptr.array-parens.at-leniency` open-defect note); the parser in
// this tree now REJECTS it symmetrically with `*[N]T`, so this is a real
// (non-xfail) negative test that pins the fixed behavior.

func main() {
	var p @[3]int
	_ = p
}
