package "main"

// type.ptr.array-parens (negative): bare `@[N]T` is a syntax error -- `@[`
// is managed-slice sugar (`@[]T`), so a managed pointer to an array must be
// parenthesized `@([N]T)`. The parser REJECTS it symmetrically with
// `*[N]T`; a lenient parser that silently ACCEPTS bare `@[N]T` as
// `@([N]T)` fails this test.

func main() {
	var p @[3]int
	_ = p
}
