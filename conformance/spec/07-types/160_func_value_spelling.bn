package "main"
import "pkg/builtins/testing"

// type.func.value-spelling: a function type used as a VALUE is written
// `*func(params) results` (raw) or `@func(params) results` (managed);
// parameter names are not part of the type (params are types only). All
// four shapes exercised: raw single bare result, managed void, raw
// parenthesized multi-result, managed no-param. A reference to a named
// top-level function constructs each (the type-level fact under test is
// the spelling, not call mechanics).

func add(a int, b int) int { return a + b }
func swap(a int, b int) (int, int) { return b, a }
func noOp() {}
func fortyTwo() int { return 42 }

func main() {
	var f *func(int, int) int = add
	var g @func() = noOp
	var h *func(int, int) (int, int) = swap
	var k @func() int = fortyTwo
	var lo int
	var hi int
	lo, hi = h(3, 9)
	g()
	if f(2, 3) == 5 && k() == 42 && lo == 9 && hi == 3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
