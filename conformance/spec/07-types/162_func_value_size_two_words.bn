package "main"
import "pkg/builtins/testing"

// type.func.kinds / type.layout.func-value: a function value (raw *func
// or managed @func) is ALWAYS 2 words. Target-invariant relationship
// (no hardcoded byte size): sizeof of both kinds equals 2*sizeof(int)
// (W == IntSize), and a raw and managed func value are the same size.

func main() {
	var word uint = sizeof(int)
	var raw uint = sizeof(*func(int) int)
	var mgd uint = sizeof(@func(int) int)
	if raw == 2 * word && mgd == 2 * word && raw == mgd {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
