package "main"
import "pkg/builtins/testing"

// type.func.kinds (identity, positive): function-value type identity is
// STRUCTURAL on the signature -- same kind, identical parameter types in
// order, identical result types in order (parameter NAMES ignored). So
// `add` (params a,b) and `mul` (params p,q) share the type
// `*func(int, int) int` and flow through a same-typed variable, while a
// `*func(int) int` is a DIFFERENT type (different arity).

func add(a int, b int) int { return a + b }
func mul(p int, q int) int { return p * q }
func inc(x int) int { return x + 1 }

func apply2(f *func(int, int) int, a int, b int) int { return f(a, b) }
func apply1(f *func(int) int, a int) int { return f(a) }

func main() {
	var f *func(int, int) int = add
	f = mul
	var g *func(int) int = inc
	if apply2(f, 3, 4) == 12 && apply2(add, 2, 5) == 7 && apply1(g, 9) == 10 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
