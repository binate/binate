package "main"
import "pkg/builtins/testing"

// type.func.kinds: the two kinds differ only in whether the data pointer
// is refcounted; the kind is part of identity, but a managed `@func(S)`
// implicitly decays (borrows) to a raw `*func(S)` of identical signature
// -- the same managed->raw decay as §7.8 (no refcount change, the @func
// stays usable). Three borrow sites: assignment, passing into a *func
// parameter, and the @func still callable afterward.

func add(a int, b int) int { return a + b }

func useRaw(f *func(int, int) int, a int, b int) int { return f(a, b) }

func main() {
	var mg @func(int, int) int = add
	var rw *func(int, int) int = mg
	var viaParam int = useRaw(mg, 6, 7)
	if rw(2, 3) == 5 && viaParam == 13 && mg(10, 1) == 11 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
