package "main"

// type.func.kinds (constraint): `*func(int) int` and `@func(int) int` are
// NOT identical even with the same signature -- the kind (raw vs managed)
// is part of identity. The reverse decay `*func -> @func` is never
// implicit (it would invent a record reference the raw value does not
// own); rejected.

func add(a int, b int) int { return a + b }

func main() {
	var r *func(int, int) int = add
	var m @func(int, int) int = r
	_ = m
}
