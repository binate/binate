package "main"
import "pkg/builtins/testing"

// type.func.nillable: function-value types are nillable (a nil func value
// is both words zero, a meaningful default state). A bare-declared func
// var defaults to not-present; explicit `= nil` is not-present; assigning
// a reference to a named top-level function makes it present. Both raw and
// managed kinds. Presence is read with `present` (== nil is not allowed on
// func values).

func fortyTwo() int { return 42 }

func main() {
	var bare @func() int
	var nilraw *func() int = nil
	var setm @func() int = fortyTwo
	var setr *func() int = fortyTwo
	setr = nil
	if !present(bare) && !present(nilraw) && present(setm) && !present(setr) {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
