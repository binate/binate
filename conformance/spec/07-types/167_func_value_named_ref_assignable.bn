package "main"

// type.func.nillable (companion fact): a reference to a named top-level
// function or method is assignable to a matching *func / @func type. Here
// `dbl` (a named function) flows into both a raw and a managed func-value
// type of matching signature, and a method reference flows into a matching
// *func; all are callable.

type Counter struct { v int }

func (c *Counter) bumped() int { return c.v + 1 }

func dbl(x int) int { return x * 2 }

func main() {
	var raw *func(int) int = dbl
	var mgd @func(int) int = dbl
	var c Counter
	c.v = 9
	var meth *func(*Counter) int = Counter.bumped
	if raw(21) == 42 && mgd(4) == 8 && meth(&c) == 10 {
		println("ok")
	} else {
		println("FAIL")
	}
}
