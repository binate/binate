package "main"

// type.iface.value-spelling: an interface used as a VALUE is written
// `*Iface` (raw) or `@Iface` (managed) -- a two-word value, NOT a pointer
// to an interface. A concrete value flows into both kinds and dispatches.

interface Speaker {
	speak() int
}

type T struct { v int }

func (t *T) speak() int { return t.v }

impl *T : Speaker

func main() {
	var t T
	t.v = 4
	var raw *Speaker = &t
	var mt @T = make(T)
	mt.v = 7
	var mgd @Speaker = mt
	if raw.speak() == 4 && mgd.speak() == 7 {
		println("ok")
	} else {
		println("FAIL")
	}
}
