package "main"

// type.iface.value-spelling / type.layout.iface-value: an interface value
// (raw *Iface or managed @Iface) is ALWAYS 2 words -- a two-word value,
// not a pointer to an interface. Target-invariant relationship (no
// hardcoded byte size): sizeof of both kinds equals 2*sizeof(int), and
// both kinds are the same size.

interface Speaker {
	speak() int
}

func main() {
	var word uint = sizeof(int)
	var raw uint = sizeof(*Speaker)
	var mgd uint = sizeof(@Speaker)
	if raw == 2 * word && mgd == 2 * word && raw == mgd {
		println("ok")
	} else {
		println("FAIL")
	}
}
