package "main"

// type.iface.identity (positive): interface-value type identity is
// NOMINAL -- determined by the interface (package + name), NOT by the
// backing concrete type. Two DIFFERENT concrete types that both impl
// Speaker each construct the SAME interface-value type `*Speaker`; one
// function typed `*Speaker` accepts both, dispatch follows each value's
// own backing.

interface Speaker {
	speak() int
}

type T1 struct { v int }
type T2 struct { v int }

func (t *T1) speak() int { return t.v }
func (t *T2) speak() int { return t.v * 10 }

impl *T1 : Speaker
impl *T2 : Speaker

func dispatch(s *Speaker) int { return s.speak() }

func main() {
	var a T1
	a.v = 4
	var b T2
	b.v = 5
	var s1 *Speaker = &a
	var s2 *Speaker = &b
	if dispatch(s1) == 4 && dispatch(s2) == 50 {
		println("ok")
	} else {
		println("FAIL")
	}
}
