package "main"

// type.iface.identity (constraint): identity is nominal, not structural.
// Reader and Writer are DISTINCT interfaces with identical method sets
// (`run() int`); a value of one is not assignable to the other. Having
// the right methods is never enough -- the same nominal interface is
// required.

interface Reader {
	run() int
}

interface Writer {
	run() int
}

type T struct { v int }

func (t *T) run() int { return t.v }

impl *T : Reader

func main() {
	var t T
	t.v = 1
	var r *Reader = &t
	var w *Writer = r
	_ = w
}
