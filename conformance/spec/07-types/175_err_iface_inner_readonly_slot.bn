package "main"

// type.iface.no-readonly-slot (constraint): there is no inner `readonly`
// slot on an interface value -- `*readonly Greeter` is not a valid type.
// `readonly Greeter` is the bare interface name under a readonly modifier,
// which is not a usable type expression (a bare interface name is only
// usable as `*Greeter` / `@Greeter`). The OUTER `readonly *Greeter` handle
// form is a different, valid concept (175b covers it).

interface Greeter {
	greet()
}

func main() {
	var g *readonly Greeter
	_ = g
}
