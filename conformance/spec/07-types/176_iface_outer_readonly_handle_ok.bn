package "main"
import "pkg/builtins/testing"

// type.iface.no-readonly-slot (positive complement): an OUTER
// `readonly @Getter` is just the ordinary whole-type `readonly` modifier
// wrapping the interface value -- a read-only HANDLE view. It is
// layout-transparent and peeled before dispatch, so a method still
// dispatches through the handle. (Contrast the inner `*readonly Getter`
// slot, which is rejected -- 175.)

interface Getter {
	get() int
}

type Impl struct { v int }

func (im *Impl) get() int { return im.v }

impl *Impl : Getter

func main() {
	var im @Impl = make(Impl)
	im.v = 42
	var g @Getter = im
	var rg readonly @Getter = g
	if rg.get() == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
