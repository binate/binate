package "main"
import "pkg/builtins/testing"

// type.iface.any (positive): `any` is the single built-in universal
// (empty) interface, usable as `*any` (raw) or `@any` (managed), and
// satisfied by EVERY type with NO `impl` required. A plain struct, an
// unrelated struct, and a user interface value all flow into `*any`; a
// managed struct flows into `@any`. Because `any` has no methods, this
// pins compile-acceptance of the universal `any`, not data round-tripping
// (the managed source is read back directly after binding as @any).

interface Greeter {
	greet() int
}

type A struct { x int }
type B struct { y int }

func (a *A) greet() int { return a.x }

impl *A : Greeter

func takesRawAny(v *any) { testing.Println("raw") }
func takesMgdAny(v @any) { testing.Println("mgd") }

func main() {
	var a A
	a.x = 1
	var ra *any = &a
	takesRawAny(ra)

	var b B
	b.y = 2
	var rb *any = &b
	takesRawAny(rb)

	var g *Greeter = &a
	var rg *any = g
	takesRawAny(rg)

	var mb @B = make(B)
	mb.y = 7
	var ma @any = mb
	takesMgdAny(ma)
	if mb.y == 7 { testing.Println("ok") } else { testing.Println("FAIL") }
}
