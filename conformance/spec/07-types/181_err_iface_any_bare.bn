package "main"

// type.iface.any (constraint): bare `any` is rejected as a value type --
// only `*any` (raw) or `@any` (managed) are usable, the same rule as for
// any user interface name. (Bare `any` is allowed only in generic-
// constraint position, where it means 'no constraint'; that is not a
// value-type use.)

func main() {
	var x any
	_ = x
}
