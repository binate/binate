package "main"

// type.iface.any (constraint): `*any` is a TWO-WORD interface value
// {data,vtable}, NOT a `void*`. The opaque byte pointer is the distinct
// one-word `*uint8` (§7.8). A `*any` is not assignable to a `*uint8`
// (different shape and meaning).

type Box struct { x int }

func main() {
	var b Box
	b.x = 1
	var a *any = &b
	var p *uint8 = a
	_ = p
}
