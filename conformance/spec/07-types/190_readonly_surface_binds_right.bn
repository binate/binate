package "main"
import "pkg/builtins/testing"

// type.readonly.surface: `readonly` is a prefix modifier binding to the type
// immediately on its right. `readonly *int` (read-only HANDLE, mutable pointee)
// and `*readonly int` (mutable handle, read-only pointee) are DIFFERENT types:
// you can write through the pointee of the first but not the second. This pins
// that the modifier qualifies its own level only and that the two surfaces are
// genuinely distinct (a write through the pointee is allowed for one, the other
// would be a write to a read-only location -- exercised negatively in 191).
func main() {
	var ok bool = true
	var x int = 7
	// readonly *int: the HANDLE is read-only, the pointee int is mutable.
	var rh readonly *int = &x
	*rh = 9                 // writing THROUGH the mutable pointee is allowed
	if *rh != 9 { ok = false }
	// *readonly int: the handle is mutable (rebindable), pointee is read-only.
	var y int = 5
	var pe *readonly int = &y
	var z int = 3
	pe = &z                 // rebinding the mutable handle is allowed
	if *pe != 3 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
