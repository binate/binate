package "main"

// type.readonly.surface: the dual of 190 -- writing through the read-only
// POINTEE of a `*readonly int` (the pointee level is read-only) is rejected.
// `*p` denotes a read-only (const) location, so the assignment is a write to a
// const-typed location. Mirrors conformance/295_err_write_const_ptr.
func main() {
	var x int = 5
	var p *readonly int = &x
	*p = 10           // write through the read-only pointee -- rejected.
}
