package "main"

// type.readonly.shallow: `readonly` is layout-transparent -- sizeof(readonly T)
// == sizeof(T) and alignof(readonly T) == alignof(T) for every type. Asserted
// as RELATIONSHIPS (target-invariant) so the test is a single `ok` on every
// mode. Covers a scalar, a pointer, a struct, an array, a raw slice, and a
// managed-slice. `readonly` peels in SizeOf/AlignOf (§7.13 type.layout.transparent).
type Point struct { X int; Y int }

func main() {
	var ok bool = true
	if sizeof(readonly int) != sizeof(int) { ok = false }
	if alignof(readonly int) != alignof(int) { ok = false }
	if sizeof(readonly bool) != sizeof(bool) { ok = false }
	if sizeof(readonly *int) != sizeof(*int) { ok = false }
	if sizeof(*readonly int) != sizeof(*int) { ok = false }
	if sizeof(readonly Point) != sizeof(Point) { ok = false }
	if alignof(readonly Point) != alignof(Point) { ok = false }
	if sizeof(readonly [4]int32) != sizeof([4]int32) { ok = false }
	if sizeof(readonly *[]int) != sizeof(*[]int) { ok = false }
	if sizeof(readonly @[]int) != sizeof(@[]int) { ok = false }
	// element-level readonly is also layout-transparent.
	if sizeof(*[]readonly char) != sizeof(*[]char) { ok = false }
	if sizeof(@[]readonly int) != sizeof(@[]int) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
