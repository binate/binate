package "main"
import "pkg/builtins/testing"

// type.readonly.lattice-outer: outermost (top-level) `readonly` is permissive in
// BOTH directions -- T -> readonly T (widening) and readonly T -> T (a value
// copy; the read-only handle is unaffected). Types differing only in outermost
// `readonly` are assignable both ways. Covers a scalar and a struct value, plus
// outer-readonly on a pointer handle (readonly *int <-> *int, the HANDLE level).
type Point struct { X int; Y int }

func main() {
	var ok bool = true
	var x int = 7
	var rx readonly int = x        // int -> readonly int
	var y int = rx                 // readonly int -> int
	if y != 7 { ok = false }

	var pt Point
	pt.X = 1; pt.Y = 2
	var rpt readonly Point = pt    // Point -> readonly Point
	var pt2 Point = rpt            // readonly Point -> Point
	if pt2.X != 1 || pt2.Y != 2 { ok = false }

	var p *int = &x
	var rp readonly *int = p       // *int -> readonly *int (outer/handle level)
	var p2 *int = rp               // readonly *int -> *int (outer drop ok)
	if *p2 != 7 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
