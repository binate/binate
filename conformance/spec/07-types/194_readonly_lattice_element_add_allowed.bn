package "main"

// type.readonly.lattice-element: ADDING element-level `readonly` (behind a
// pointer / slice / array handle) is an implicit widening capability. Covers
// the pointer arm (*int -> *readonly int) and the managed-slice arm
// (@[]int -> @[]readonly int). The managed->raw decay paths carry the same
// add-readonly allowance (@[]int -> *[]readonly int).
func main() {
	var ok bool = true
	var x int = 7
	var p *int = &x
	var rp *readonly int = p              // *int -> *readonly int (add element readonly)
	if *rp != 7 { ok = false }

	var ms @[]int = make_slice(int, 2)
	ms[0] = 4; ms[1] = 5
	var rms @[]readonly int = ms          // @[]int -> @[]readonly int (add)
	if rms[0] + rms[1] != 9 { ok = false }

	var rrs *[]readonly int = ms          // @[]int -> *[]readonly int (decay + add)
	if rrs[1] != 5 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
