package "main"

// type.readonly.lattice-element: DROPPING element-level `readonly` is NOT
// implicit -- `*readonly int -> *int` is rejected (use a cast; see 197).
// This is the capability-leak direction. Mirrors conformance/294 and
// conformance/spec/08-conversions/013_err_readonly_drop.
func main() {
	var x int = 5
	var rp *readonly int = &x
	var p *int = rp           // drop of element readonly -- rejected.
	_ = p
}
