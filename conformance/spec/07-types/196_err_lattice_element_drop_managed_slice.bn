package "main"

// type.readonly.lattice-element: dropping element readonly on the MANAGED-SLICE
// arm is rejected too -- `@[]readonly int -> @[]int` requires a cast. Pins that
// the element-readonly capability check applies on the slice kind, not just
// pointers (complements 195's pointer arm).
func main() {
	var rms @[]readonly int = make_slice(int, 2)
	var ms @[]int = rms       // drop element readonly on a managed-slice -- rejected.
	_ = ms
}
