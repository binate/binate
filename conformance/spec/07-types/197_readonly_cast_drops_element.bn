package "main"

// type.readonly.cast-drops: `cast(T, x)` yields T regardless of the source's
// readonly-ness -- the sanctioned way to drop element-level readonly that
// implicit assignment rejects. Covers the pointer arm (*readonly int -> *int)
// and the raw-slice arm (*[]readonly char -> ... read back), confirming the
// cast both type-checks AND preserves the data through the drop.
func main() {
	var ok bool = true
	var x int = 7
	var rp *readonly int = &x
	var p *int = cast(*int, rp)        // cast drops element readonly
	if *p != 7 { ok = false }

	var s *[]readonly char = "AB"
	var m *[]char = cast(*[]char, s)   // cast drops element readonly on a slice
	if cast(int, m[0]) != 65 { ok = false }   // 'A'
	if cast(int, m[1]) != 66 { ok = false }   // 'B'

	if ok { println("ok") } else { println("FAIL") }
}
