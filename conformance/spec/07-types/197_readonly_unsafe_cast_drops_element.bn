package "main"
import "pkg/builtins/testing"

// type.readonly.drop: dropping element-level readonly is the unverifiable
// const_cast-like operation, so it requires `unsafe_cast` (§8.7), NOT a plain
// cast, and yields T regardless of the source's readonly-ness. Covers the pointer
// arm (*readonly int -> *int) and the raw-slice arm (*[]readonly char -> ... read
// back), confirming the unsafe_cast both type-checks AND preserves the data.
func main() {
	var ok bool = true
	var x int = 7
	var rp *readonly int = &x
	var p *int = unsafe_cast(*int, rp)        // unsafe_cast drops element readonly
	if *p != 7 { ok = false }

	var s *[]readonly char = "AB"
	var m *[]char = unsafe_cast(*[]char, s)   // unsafe_cast drops element readonly on a slice
	if cast(int, m[0]) != 65 { ok = false }   // 'A'
	if cast(int, m[1]) != 66 { ok = false }   // 'B'

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
