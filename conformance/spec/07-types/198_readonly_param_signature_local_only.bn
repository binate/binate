package "main"

// type.readonly.param-signature: the OUTERMOST `readonly` on a function
// PARAMETER is local discipline only (the parameter can't be reassigned in the
// body); it is NOT part of the function's type signature and is ignored for
// signature matching and function-value assignability. So a function whose
// parameter is declared `readonly int` is assignable to a `*func(int) int`
// value, and vice versa -- the outer-readonly-on-param is erased from identity.
func takesRO(x readonly int) int { return x + 1 }
func takesPlain(x int) int { return x * 2 }

func main() {
	var ok bool = true
	// A func with a `readonly int` param is assignable to `*func(int) int`
	// (outer-readonly-on-param ignored for signature identity).
	var f *func(int) int = takesRO
	if f(4) != 5 { ok = false }
	// And a plain-param func is assignable to a `*func(readonly int) int` value.
	var g *func(readonly int) int = takesPlain
	if g(4) != 8 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
