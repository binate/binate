package "main"

// type.readonly.vs-const: `const` (a compile-time constant, Ch.9) has NO storage
// and NO address -- `&` of it is an error. This is distinct from `readonly`
// storage (`var x readonly T`), which DOES have an address (see 200). Pins the
// const half of the readonly-vs-const distinction.
const C int = 42

func main() {
	var p *int = &C       // address of a const -- rejected (no storage).
	_ = p
}
