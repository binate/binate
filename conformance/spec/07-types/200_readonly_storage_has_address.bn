package "main"

// type.readonly.vs-const: immutable STORAGE is `var x readonly T = ...`, which
// (unlike `const`) DOES have storage and an address -- `&x` yields `*readonly T`
// (a pointer to the read-only location). Pins the storage half of the
// readonly-vs-const distinction: the address exists, the pointee is read-only,
// and reads through it work. (Contrast 199 where `&const` is rejected.)
func takesRO(p *readonly int) int { return *p }

func main() {
	var ok bool = true
	var x readonly int = 7        // immutable storage (has an address)
	var p *readonly int = &x      // &x -> *readonly int
	if *p != 7 { ok = false }
	if takesRO(p) != 7 { ok = false }
	if takesRO(&x) != 7 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
