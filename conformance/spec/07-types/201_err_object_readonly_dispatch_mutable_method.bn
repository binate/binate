package "main"

// type.readonly.object-dispatch: method dispatch keys off OBJECT-readonly. A
// read-only OBJECT (`*readonly Box`) may call ONLY methods whose receiver
// pointee is itself read-only. `bump` is declared on the MUTABLE receiver
// `*Box`; calling it through a `*readonly Box` would DROP object-readonly (the
// rejected direction) and must be rejected at type check. Mirrors
// conformance/spec/10-functions/054_err_object_const_drops_readonly.
type Box struct { x int }

func (b *Box) bump() int { b.x = b.x + 1; return b.x }   // wants a MUTABLE object

func main() {
	var v Box
	v.x = 1
	var rp *readonly Box = &v
	println(rp.bump())     // read-only object calling a mutable-receiver method.
}
