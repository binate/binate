package "main"
import "pkg/builtins/testing"

// type.readonly.object-dispatch: a read-only HANDLE to a MUTABLE object
// (`readonly @Box`) may call ANY method -- the handle being read-only does NOT
// make the OBJECT read-only, so a mutable-receiver method is callable. Contrast
// with 201 (read-only OBJECT). Also shows a read-only OBJECT (`*readonly Box`)
// calling a read-only-receiver method is fine (the keeping-object-readonly arm).
type Box struct { x int }

func (b *readonly Box) peek() int { return b.x }          // read-only-receiver method
func (b @Box) bumpMgd() int { b.x = b.x + 1; return b.x }  // mutable managed receiver

func main() {
	var v Box
	v.x = 5
	var rp *readonly Box = &v         // read-only OBJECT

	var m @Box = make(Box)
	m.x = 9
	var rh readonly @Box = m          // read-only HANDLE, mutable object

	if rp.peek() == 5 && rh.bumpMgd() == 10 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
