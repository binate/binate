package "main"

import "pkg/bx"

// type.opaque.forward (§7.12): `type Box` with no body in pkg/bx.bni is a
// FORWARD declaration — it exports Box as a named type whose layout is NOT
// visible here.  The full body `type Box struct { v int }` lives in
// pkg/bx/bx.bn.  Callers in main see Box opaquely: they hold @Box (a
// first-class handle over an opaque type) and operate on it only through the
// exported New / Get functions, never touching its fields directly.  The
// round-trip New(42) → Get → 42 proves the forward-declared type and its @Box
// handle are usable across the package boundary.
func main() {
	var b @bx.Box = bx.New(42)
	if bx.Get(b) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
