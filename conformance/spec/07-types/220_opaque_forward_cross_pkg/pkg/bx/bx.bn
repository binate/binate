package "pkg/bx"

// The full body of the forward-declared Box.  A full definition may appear
// once: here in the .bn (the .bni has only the `type Box` forward decl), which
// is the opaque-export form.
type Box struct {
	v int
}

func New(v int) @Box {
	var b @Box = make(Box)
	b.v = v
	return b
}

func Get(b @Box) int { return b.v }
