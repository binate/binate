package "main"
import "pkg/builtins/testing"

import "pkg/counter"

// type.opaque.handles (§7.12): handles over an opaque type are first-class —
// declared, passed, returned, AND DISPATCHED on.  A .bni may declare methods
// on a forward-declared type (with a managed-handle receiver).  Here
// pkg/counter.bni forward-declares Counter and declares the method
// `func (c @Counter) Value() int`; the body lives in the .bn.  main holds the
// opaque @Counter and calls Value() through method dispatch — the only way to
// reach the opaque value's data.
func main() {
	var c @counter.Counter = counter.New(40)
	if c.Value() == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
