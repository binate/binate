package "main"
import "pkg/builtins/testing"

import "pkg/bx"

// type.opaque.field-rejection (§7.12): direct field access on a value of
// opaque type is REJECTED, even though the field `v` exists in the defining
// package — the cross-package encapsulation guarantee.  main holds an opaque
// @bx.Box and tries to read `b.v` directly (auto-deref through @Box).  Box's
// layout is not visible here, so the field access must be rejected.  This
// program must fail to compile.
func main() {
	var b @bx.Box = bx.New(42)
	testing.Println(b.v)
}
