package "main"
import "pkg/builtins/testing"

import "pkg/thing"

// type.opaque.single-source (§7.12, Constraint): a type is declared FULL at
// most once per package.  pkg/thing declares `type Thing struct {...}` FULL in
// BOTH its .bni (a transparent export) and its .bn — the banned full-in-both
// pattern.  The valid alternatives are: full in the .bni only (transparent),
// OR a `type Thing` forward decl in the .bni plus the full body in the .bn
// (opaque export).  Full in both must be rejected.  This program must fail to
// compile.
func main() {
	var t @thing.Thing = thing.New(7)
	testing.Println(t.V)
}
