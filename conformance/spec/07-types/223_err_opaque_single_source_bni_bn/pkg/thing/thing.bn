package "pkg/thing"

// ... and ALSO declared FULL here — the banned full-in-both redeclaration.
// The opaque form would make the .bni a `type Thing` forward decl; the
// transparent form would omit this decl entirely.  Either way a full decl may
// appear at most once.
type Thing struct {
	V int
}

func New(v int) @Thing {
	var t @Thing = make(Thing)
	t.V = v
	return t
}
