package "main"
import "pkg/builtins/testing"

import "pkg/dup"

// type.opaque.single-source (§7.12, Constraint): a type is declared FULL at
// most once per package.  pkg/dup defines `type Pair struct {...}` FULL in TWO
// different .bn files of the same package — also banned (a full definition may
// appear once per package).  The .bni forward-declares Pair (the opaque-export
// shape), and the full body `type Pair struct {...}` is then wrongly duplicated
// across two .bn files in the package.  This program must fail to compile.
func main() {
	var p @dup.Pair = dup.New(3, 4)
	testing.Println(dup.Sum(p))
}
