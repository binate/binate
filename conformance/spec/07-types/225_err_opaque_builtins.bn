package "main"

// type.opaque.builtin-rejection (§7.12, Constraint): make / make_slice /
// sizeof / alignof on an opaque type are rejected — its layout is unknown.
// The gate peels named-distinct, alias, and readonly wrappers, so a distinct
// type OVER an opaque type (Handle), and a readonly/alias wrapper, are
// rejected too.  Pointers/handles to the opaque type stay legal (that escape
// hatch is covered by the positive tests).  This program must fail to compile.
//
// Opaque is a pure opaque type — a bare forward declaration with no full body
// (its layout would be supplied externally, e.g. in C or assembly), so the
// layout machinery has nothing to compute.
type Opaque

// Handle is a DISTINCT type over the opaque Opaque — just as layout-less; the
// gate must peel to the bottom and reject make/sizeof on it too.
type Handle Opaque

// Alias is an ALIAS of the opaque type — the gate peels aliases as well.
type Alias = Opaque

func main() {
	var p @Opaque = make(Opaque)
	var sl @[]Opaque = make_slice(Opaque, 3)
	var s uint = sizeof(Opaque)
	var a uint = alignof(Opaque)
	var hp @Handle = make(Handle)
	var hs uint = sizeof(Handle)
	var as uint = sizeof(Alias)
	_ = p
	_ = sl
	_ = s
	_ = a
	_ = hp
	_ = hs
	_ = as
}
