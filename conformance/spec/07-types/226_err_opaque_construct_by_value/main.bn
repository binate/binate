package "main"

import "pkg/bx"

// type.opaque.handles (§7.12): a value of an opaque type can never be FORMED
// across the package boundary -- its layout is not visible, so a composite
// literal naming its private field (and the by-value construction itself) is
// rejected, just like direct field access (222). This holds even when the
// defining package's .bn is co-compiled in the same build (which fills the
// shared type's layout for the PROVIDER's own codegen) -- the importer still
// sees only the opaque .bni surface. This program must fail to compile.
func main() {
	var b bx.Box = bx.Box{v: 42}
	_ = b
}
