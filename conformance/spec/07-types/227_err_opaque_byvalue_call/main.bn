package "main"

import "pkg/ob"

// type.opaque.handles: a CALL whose result is a by-value opaque type forms an
// opaque value in the importer, which cannot see its layout -- rejected at the
// call site (the result materialization), even though the provider could write
// the by-value-returning signature. The importer must hold @Box / *Box, never a
// Box value. This holds for `var x = f()`, `x := f()`, and a bare `f()`. This
// program must fail to compile.
func main() {
	x := ob.MakeVal()
	_ = x
}
