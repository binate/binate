package "main"

// type.opaque.handles: a `:=` short var decl binding a deref-load of an opaque
// pointer (`x := *g()`) forms an opaque VALUE at the bind site and is rejected
// -- pinned in ISOLATION here, because conformance/846 bundles this with the
// sibling forms `_ = *g()` and `*dst = *src`, where a regression of the `:=`
// form alone would be masked by the other lines' errors. Holding the *Opaque
// pointer itself stays legal; only materializing the value is rejected. This
// program must fail to compile.
type Opaque

func g() *Opaque {
	return nil
}

func main() {
	x := *g()
	_ = x
}
