package "main"
import "pkg/builtins/testing"

import "pkg/ob"

// type.opaque.handles: a MULTI-RETURN call that yields a by-value opaque type
// materializes that value at the destructure, which the importer cannot do --
// rejected even when the opaque result is discarded to `_` (the call still
// forms it). The sibling of the single-result call rejection (227). Must fail.
func main() {
	_, n := ob.MakePair()
	testing.Println(n)
}
