package "main"
import "pkg/builtins/testing"

// type.layout.target-info: layout is parameterized by a TargetInfo where
// IntSize == PointerSize. Observable, target-invariant consequence: a target
// `int`/`uint` is the same width as a pointer (the word size W), and `int`
// and `uint` are the same width as each other. Assert via relationships so the
// test passes on every target (W = 4 on arm32, 8 on the 64-bit host).

func main() {
	var intIsWord bool = sizeof(int) == sizeof(*int)
	var uintIsWord bool = sizeof(uint) == sizeof(*int)
	var intEqUint bool = sizeof(int) == sizeof(uint)
	// A raw slice is exactly 2 words, so 2*sizeof(int) must equal sizeof(*[]int):
	// another way IntSize == word size is observable.
	var twoWords bool = sizeof(*[]int) == 2 * sizeof(int)
	if intIsWord && uintIsWord && intEqUint && twoWords {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
