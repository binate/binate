package "main"
import "pkg/builtins/testing"

// type.layout.scalar: the FIXED (target-invariant) scalar sizes.
// bool=1; int8/uint8/char/byte=1; int16/uint16=2; int32/uint32=4;
// int64/uint64=8; float32=4; float64=8. char and byte are 1-byte aliases
// of uint8. These are identical on every target, so assert them directly.

func main() {
	if sizeof(bool) == cast(uint, 1) &&
		sizeof(int8) == cast(uint, 1) && sizeof(uint8) == cast(uint, 1) &&
		sizeof(char) == cast(uint, 1) && sizeof(byte) == cast(uint, 1) &&
		sizeof(int16) == cast(uint, 2) && sizeof(uint16) == cast(uint, 2) &&
		sizeof(int32) == cast(uint, 4) && sizeof(uint32) == cast(uint, 4) &&
		sizeof(int64) == cast(uint, 8) && sizeof(uint64) == cast(uint, 8) &&
		sizeof(float32) == cast(uint, 4) && sizeof(float64) == cast(uint, 8) {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
