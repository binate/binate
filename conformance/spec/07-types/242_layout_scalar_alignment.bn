package "main"

// type.layout.scalar (alignment half): a scalar's natural alignment equals its
// size, clamped to MaxAlign. For the small scalars (<= W on every target),
// alignment == size exactly: bool/int8/uint8/char/byte align to 1, int16 to 2,
// int32 to 4. These hold on every target because the sizes are <= 4 <= W.
// (int64/float64 align to min(8, MaxAlign) = 8 on every current target -- LP64
// AND arm32, whose MaxAlign is 8 per AAPCS32 -- but they are kept out of the
// assertion here so the test stays invariant should a future sub-8-MaxAlign
// 32-bit target ever be added.)

func main() {
	if alignof(bool) == sizeof(bool) &&
		alignof(int8) == sizeof(int8) && alignof(uint8) == sizeof(uint8) &&
		alignof(char) == sizeof(char) && alignof(byte) == sizeof(byte) &&
		alignof(int16) == sizeof(int16) &&
		alignof(int32) == sizeof(int32) {
		println("ok")
	} else {
		println("FAIL")
	}
}
