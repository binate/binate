package "main"
import "pkg/builtins/testing"

// type.layout.struct: fields in declaration order; each field placed at the
// lowest offset >= running offset meeting its alignment (padding inserted);
// struct alignment = max field alignment; size rounded up to that alignment.
//
// Use only fixed-size scalars so the facts are target-invariant. A struct of
// {int8; int32} must pad the int8 so the int32 lands at offset 4 (its 4-byte
// alignment), giving size 8 and alignment 4 -- on EVERY target (int32 align is
// 4 <= MaxAlign always). Compare against the same fields in the OTHER order
// {int32; int8}: int8 fits at offset 4, then trailing pad to alignment 4 ->
// also size 8 here, but the offsets differ. To make order observable we use
// {int8; int32; int8}: int8@0, pad to 4, int32@4, int8@8, round up to 12.

type Pair struct {
	a int8
	b int32
}

type Tri struct {
	a int8
	b int32
	c int8
}

func main() {
	// Pair: int8 padded so int32 is aligned -> size 8, not 5; alignment 4.
	var pairSized bool = sizeof(Pair) == cast(uint, 8)
	var pairAligned bool = alignof(Pair) == cast(uint, 4)
	// Tri: a@0, pad, b@4, c@8, round 9 up to 12.
	var triSized bool = sizeof(Tri) == cast(uint, 12)
	var triAligned bool = alignof(Tri) == cast(uint, 4)
	if pairSized && pairAligned && triSized && triAligned {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
