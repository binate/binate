package "main"

// type.layout.struct: a struct's alignment is the maximum field alignment.
// Assert via a relationship that holds on EVERY target: a struct containing an
// int field has the same alignment as int itself (int has the widest alignment
// among {int8, int}), and a struct of only int8 fields aligns to 1.

type HasInt struct {
	flag int8
	n int
}

type AllBytes struct {
	a int8
	b int8
	c int8
}

func main() {
	var widest bool = alignof(HasInt) == alignof(int)
	var bytesAlign1 bool = alignof(AllBytes) == cast(uint, 1)
	// AllBytes has three 1-byte fields, no padding needed: size 3.
	var bytesSize bool = sizeof(AllBytes) == cast(uint, 3)
	if widest && bytesAlign1 && bytesSize {
		println("ok")
	} else {
		println("FAIL")
	}
}
