package "main"

// type.layout.struct: an empty struct (no fields) has size 0. Its alignment is
// the minimum, 1. Both are target-invariant. (Separated from the main struct
// test so that an unimplemented empty-struct case does not mask the core
// field-order/padding facts.)

type Empty struct {
}

func main() {
	var zeroSize bool = sizeof(Empty) == cast(uint, 0)
	var align1 bool = alignof(Empty) == cast(uint, 1)
	if zeroSize && align1 {
		println("ok")
	} else {
		println("FAIL")
	}
}
