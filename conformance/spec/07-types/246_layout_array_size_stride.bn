package "main"
import "pkg/builtins/testing"

// type.layout.array: [N]T occupies exactly N*sizeof(T) contiguous bytes at
// stride sizeof(T) with no inter-element padding; alignment is T's alignment.
// Assert as relationships so it holds on every target (sizeof(int) is W).

func main() {
	// N * sizeof(T) for fixed-size and word-size element types.
	var a32 bool = sizeof([4]int32) == 4 * sizeof(int32)
	var a8 bool = sizeof([7]int8) == 7 * sizeof(int8)
	var aInt bool = sizeof([3]int) == 3 * sizeof(int)
	// No inter-element padding: a [2]T of a 3-byte struct is exactly 2*3 = 6
	// only if T already has no trailing pad; use int8 elems to keep it clean:
	// [5]int8 must be exactly 5 bytes (stride 1, contiguous).
	var contig bool = sizeof([5]int8) == cast(uint, 5)
	// Array alignment equals the element's alignment.
	var elemAlign bool = alignof([4]int32) == alignof(int32)
	if a32 && a8 && aInt && contig && elemAlign {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
