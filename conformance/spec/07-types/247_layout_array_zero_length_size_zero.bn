package "main"
import "pkg/builtins/testing"

// type.layout.array: a zero-length array has size 0. Its alignment is still the
// element's alignment. Both are target-invariant for an int8 element (align 1).
// Separated from the main array test so an unimplemented zero-length case does
// not mask the core stride/size facts.

func main() {
	var zeroSize bool = sizeof([0]int8) == cast(uint, 0)
	var align1 bool = alignof([0]int8) == alignof(int8)
	if zeroSize && align1 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
