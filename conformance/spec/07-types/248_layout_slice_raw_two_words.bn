package "main"

// type.layout.slice-raw: a raw slice *[]T is ALWAYS 2 words, regardless of the
// element type. Size 2W, alignment W. Assert via relationships so it holds on
// every target: sizeof(*[]T) == 2*sizeof(int) for several element types, and
// the raw-slice size is independent of T (a *[]int8 slice is the same size as
// a *[]int64 slice -- both 2 words).

func main() {
	var twoWordsInt bool = sizeof(*[]int) == 2 * sizeof(int)
	var twoWordsI8 bool = sizeof(*[]int8) == 2 * sizeof(int)
	var twoWordsI64 bool = sizeof(*[]int64) == 2 * sizeof(int)
	// Element-type independence: all raw slices are the same size.
	var sameAcrossElem bool = sizeof(*[]int8) == sizeof(*[]int64)
	// Alignment is W (== alignof(int)).
	var alignW bool = alignof(*[]int) == alignof(int)
	if twoWordsInt && twoWordsI8 && twoWordsI64 && sameAcrossElem && alignW {
		println("ok")
	} else {
		println("FAIL")
	}
}
