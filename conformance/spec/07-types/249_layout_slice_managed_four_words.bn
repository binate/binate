package "main"
import "pkg/builtins/testing"

// type.layout.slice-managed: a managed-slice @[]T is ALWAYS 4 words.
// Size 4W == 4*sizeof(int) == 2*sizeof(*[]int). Its first two words are the
// same {data,len} as a raw slice, so a managed-slice is exactly twice the
// size of the corresponding raw slice. Alignment is W. Assert via
// relationships so it holds on every target (W=4 arm32, 8 host).

func main() {
	var fourWords bool = sizeof(@[]int) == 4 * sizeof(int)
	var twiceRaw bool = sizeof(@[]int) == 2 * sizeof(*[]int)
	// Element-type independence: every managed-slice is 4 words.
	var sameAcrossElem bool = sizeof(@[]int8) == sizeof(@[]int64)
	var i8FourWords bool = sizeof(@[]int8) == 4 * sizeof(int)
	// Alignment is W.
	var alignW bool = alignof(@[]int) == alignof(int)
	if fourWords && twiceRaw && sameAcrossElem && i8FourWords && alignW {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
