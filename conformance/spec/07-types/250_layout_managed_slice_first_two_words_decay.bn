package "main"

// type.layout.slice-managed: the first two words of a managed-slice @[]T are
// byte-identical to a raw slice *[]T -- which is what makes the @[]T -> *[]T
// decay a field extraction (the data and len words carry through unchanged).
// Observable behavior: build a managed-slice, let it decay to a raw slice, and
// confirm the {data,len} view is preserved (same length and same elements via
// the data pointer). This exercises the word-0/word-1 identity that the size
// relationships in 249 cannot directly observe.

func main() {
	var m @[]int = make_slice(int, 3)
	m[0] = 10
	m[1] = 20
	m[2] = 30
	// Decay to a raw slice: takes the first two words {data, len}.
	var r *[]int = m
	// len carried through word 1.
	var lenOk bool = len(r) == 3
	// data carried through word 0: same elements visible via the raw view.
	var dataOk bool = r[0] == 10 && r[1] == 20 && r[2] == 30
	// Mutating through the raw view is visible in the managed-slice (same data).
	r[1] = 99
	var aliasOk bool = m[1] == 99
	if lenOk && dataOk && aliasOk {
		println("ok")
	} else {
		println("FAIL")
	}
}
