package "main"

// type.layout.header: every managed allocation is prefixed by a 2-word header
// {refcount, free_fn} at a NEGATIVE offset from the payload pointer (header
// size 2W). The header sits below the payload and is not part of the value's
// own sizeof, so it is INFORMATIVE / not directly observable through sizeof or
// a portable language construct. What IS observable here: the payload itself is
// laid out per the normal rules (sizeof(@T) of a managed pointer is one word --
// the pointer -- not the payload+header), and refcounting works (the header's
// refcount word governs lifetime). This test asserts the observable surface:
// a managed pointer is one word (W), independent of the pointee's size, so the
// header is genuinely out-of-band (stored at the negative offset, not inline).

type Big struct {
	a int64
	b int64
	c int64
}

func main() {
	// A managed pointer is a single word regardless of pointee size -- the
	// payload (and its 2-word header) live behind the pointer, not inline.
	var ptrIsWord bool = sizeof(@int) == sizeof(int)
	var ptrIsWordBig bool = sizeof(@Big) == sizeof(int)
	var ptrSizeIndep bool = sizeof(@int) == sizeof(@Big)
	// Refcounting (driven by the header's refcount word) keeps the value alive
	// across an aliasing copy and frees correctly at scope end.
	var p @Big = make(Big)
	p.a = 7
	var q @Big = p
	var aliveOk bool = q.a == 7
	if ptrIsWord && ptrIsWordBig && ptrSizeIndep && aliveOk {
		println("ok")
	} else {
		println("FAIL")
	}
}
