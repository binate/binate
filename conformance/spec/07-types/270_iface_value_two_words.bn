package "main"
import "pkg/builtins/testing"

// type.layout.iface-value: an interface value -- raw `*Iface` or managed
// `@Iface` -- is always 2 words {data, vtable}.  Asserted target-invariantly:
// sizeof and alignof of both forms equal a 2-word value (== 2 * sizeof(int),
// == sizeof(*[]int) the canonical 2-word raw slice).  No absolute byte sizes
// are hardcoded, so this passes identically on 64-bit hosts and arm32.

interface Speaker {
	speak() int
}

func main() {
	var word uint = sizeof(int)
	var twoWords uint = 2 * word

	// Both the raw and managed interface-value forms are exactly 2 words.
	var rawOk bool = sizeof(*Speaker) == twoWords
	var mgdOk bool = sizeof(@Speaker) == twoWords

	// Raw and managed interface values are the SAME size (both 2 words).
	var sameOk bool = sizeof(*Speaker) == sizeof(@Speaker)

	// A 2-word interface value matches the canonical 2-word raw slice size.
	var sliceOk bool = sizeof(*Speaker) == sizeof(*[]int)

	// Alignment of an interface value is the word alignment.
	var alignOk bool = alignof(*Speaker) == alignof(int) && alignof(@Speaker) == alignof(int)

	if rawOk && mgdOk && sameOk && sliceOk && alignOk {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
