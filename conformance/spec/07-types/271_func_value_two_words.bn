package "main"
import "pkg/builtins/testing"

// type.layout.func-value: a function value (raw `*func` or managed `@func`)
// is always 2 words {vtable, data}.  Asserted target-invariantly: sizeof of a
// function-value type equals a 2-word value (== 2 * sizeof(int) == sizeof of
// the canonical 2-word raw slice).  The internal field ORDER (reverse of an
// interface value) is an ABI fact not observable via sizeof; only the 2-word
// total is asserted here.  No absolute byte sizes are hardcoded.

func main() {
	var twoWords uint = 2 * sizeof(int)

	// A raw function-value type is exactly 2 words.
	var rawOk bool = sizeof(*func(int) int) == twoWords

	// A no-arg / no-result function value is also 2 words (size is independent
	// of the signature -- it is always {vtable, data}).
	var voidOk bool = sizeof(*func()) == twoWords

	// A 2-word function value matches the canonical 2-word raw slice size.
	var sliceOk bool = sizeof(*func(int) int) == sizeof(*[]int)

	// Alignment is the word alignment.
	var alignOk bool = alignof(*func(int) int) == alignof(int)

	if rawOk && voidOk && sliceOk && alignOk {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
