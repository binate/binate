package "main"

// type.layout.transparent: `readonly T`, an alias of T, and a named-distinct
// type over T are all LAYOUT-IDENTICAL to T -- same size and alignment.  sizeof
// and alignof peel all three wrappers.  Asserted via equalities only (no
// absolute byte sizes), so it is target-invariant.

type S struct {
	a int64
	b int32
}

type AliasS = S          // alias over the struct
type DistinctS S         // named-distinct over the struct
type AliasInt = int64    // alias over a scalar
type DistinctInt int64   // named-distinct over a scalar

func main() {
	// readonly peels: readonly int64 is layout-identical to int64.
	var roScalarSz bool = sizeof(readonly int64) == sizeof(int64)
	var roScalarAl bool = alignof(readonly int64) == alignof(int64)

	// readonly over a struct peels too.
	var roStructSz bool = sizeof(readonly S) == sizeof(S)
	var roStructAl bool = alignof(readonly S) == alignof(S)

	// alias peels (scalar + struct).
	var aliScalar bool = sizeof(AliasInt) == sizeof(int64) && alignof(AliasInt) == alignof(int64)
	var aliStruct bool = sizeof(AliasS) == sizeof(S) && alignof(AliasS) == alignof(S)

	// named-distinct peels (scalar + struct).
	var disScalar bool = sizeof(DistinctInt) == sizeof(int64) && alignof(DistinctInt) == alignof(int64)
	var disStruct bool = sizeof(DistinctS) == sizeof(S) && alignof(DistinctS) == alignof(S)

	if roScalarSz && roScalarAl && roStructSz && roStructAl && aliScalar && aliStruct && disScalar && disStruct {
		println("ok")
	} else {
		println("FAIL")
	}
}
