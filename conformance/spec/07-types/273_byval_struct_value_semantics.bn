package "main"
import "pkg/builtins/testing"

// type.struct.value (with type.layout.byval-cutoff): a struct parameter is a
// COPY (a struct is a value type), so mutating it in the callee must NOT affect
// the caller's value -- and this holds REGARDLESS of the ABI passing convention.
// type.layout.byval-cutoff says an aggregate >16 bytes is passed by indirect
// reference (<=16 by value); this test confirms the by-value LANGUAGE semantics
// hold on BOTH sides of that cutoff: a >16-byte struct (five int64 fields == 40
// bytes, indirect-ref) and a <=16-byte struct (two fields, by value) are each
// copied. The cutoff itself is an ABI fact and is not directly observable.

type Big struct {
	a int64
	b int64
	c int64
	d int64
	e int64
}

type Small struct {
	x int64
	y int64
}

// Mutates its parameter; because the parameter is a by-value copy, the
// caller's Big is unaffected even though Big > 16 bytes (passed by indirect
// reference per the ABI).
func mutateBig(b Big) {
	b.a = 999
	b.e = 999
}

func mutateSmall(s Small) {
	s.x = 999
}

func main() {
	// Sanity: Big is genuinely larger than the 16-byte cutoff.
	var bigOverCutoff bool = sizeof(Big) > cast(uint, 16)
	var smallUnderCutoff bool = sizeof(Small) <= cast(uint, 16)

	var big Big
	big.a = 1
	big.e = 5
	mutateBig(big)
	// Caller's copy is unchanged.
	var bigUnchanged bool = big.a == cast(int64, 1) && big.e == cast(int64, 5)

	var small Small
	small.x = 7
	mutateSmall(small)
	var smallUnchanged bool = small.x == cast(int64, 7)

	if bigOverCutoff && smallUnderCutoff && bigUnchanged && smallUnchanged {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
