package "main"
import "pkg/builtins/testing"

// type.layout.byte-order: multi-byte scalars are little-endian on every
// target -- the low-order byte is stored FIRST (lowest address).  Observed by
// bit_cast'ing the address of a known multi-byte int32 to a raw byte slice and
// reading the individual bytes.  0x04030201 little-endian lays out as
// {0x01, 0x02, 0x03, 0x04} from byte 0 upward.

func main() {
	var v int32 = 0x04030201

	// Reinterpret the 4-byte int32 storage as raw bytes via its address
	// (a raw pointer to int32 -> raw pointer to uint8), then read each byte
	// with unsafe_index.
	var pv *int32 = &v
	var pb *uint8 = bit_cast(*uint8, pv)

	// Little-endian: byte 0 is the least-significant byte.
	var b0 bool = cast(int, unsafe_index(pb, 0)) == 0x01
	var b1 bool = cast(int, unsafe_index(pb, 1)) == 0x02
	var b2 bool = cast(int, unsafe_index(pb, 2)) == 0x03
	var b3 bool = cast(int, unsafe_index(pb, 3)) == 0x04

	if b0 && b1 && b2 && b3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
