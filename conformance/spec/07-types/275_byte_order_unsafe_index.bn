package "main"
import "pkg/builtins/testing"

// type.layout.byte-order (wider scalar): little-endian byte order observed on
// an 8-byte int64 (274 covers the 4-byte int32 case). Reading the raw bytes of
// 0x0807060504030201 through a bit_cast'd byte pointer with unsafe_index, a
// little-endian layout gives byte 0 == 0x01 (least-significant first) up to
// byte 7 == 0x08. Exercising the full 8-byte width confirms the order holds
// beyond a single word boundary.

func main() {
	var v int64 = 0x0807060504030201
	var pb *uint8 = bit_cast(*uint8, &v)

	var ok bool = true
	var i int = 0
	for i < 8 {
		// byte i must equal (i+1): 0x01, 0x02, ... 0x08 from low to high.
		if cast(int, unsafe_index(pb, i)) != i + 1 {
			ok = false
		}
		i = i + 1
	}

	if ok {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
