package "main"
import "pkg/builtins/testing"

// type.layout.immortal: static (immortal) managed data carries a reserved
// sentinel refcount (a deeply-negative value); RefInc/RefDec short-circuit on
// a negative count, so immortal data is NEVER freed. A string literal lowers to
// static immortal managed data. The sentinel count itself is an internal
// mechanism (not directly readable through the surface language), so this test
// pins the OBSERVABLE consequence: a package-level static string can be copied
// freely and the copies dropped, yet the original static data stays intact and
// readable -- an immortal allocation is never destroyed out from under a
// reference.

// Package-level static string -- immortal managed data.
var greeting @[]readonly char = "hello"

func main() {
	// Make and drop copies of the immortal string; the static backing must
	// survive (each copy's drop must not free static data).
	var ok bool = true
	var i int = 0
	for i < 100 {
		var copyN @[]readonly char = greeting
		if len(copyN) != 5 {
			ok = false
		}
		i = i + 1
		// copyN goes out of scope each iteration (its ref is dropped); the
		// static backing must not be freed.
	}

	// Original is still intact and readable after all those drops.
	if ok && len(greeting) == 5 && greeting[0] == 'h' && greeting[4] == 'o' {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
