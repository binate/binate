package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// type.layout.slice-managed.backing: a @[]readonly char string literal lives at
// least as long as its ENVIRONMENT, and its `backing` word (word 2) realizes that
// lifetime -- which differs by execution mode (an accepted mode-specific
// realization, not a layout divergence: the 4-word layout and the refcount
// mechanism are identical in both modes, and the value is self-describing). Read
// word-by-word via bit_cast (target-invariant -- each word is one int):
//   - mode-invariant: `data` (word 0) non-null, `len` (word 1), `backingLen`
//     (word 3) == `len`;
//   - COMPILED: the environment is the program image, so the literal is immortal:
//     `backing` NULL ({data, len, null, len}, a view of static rodata);
//   - INTERPRETED: the environment is the VM, which interns the literal and holds
//     a reference, so `backing` is a normal OWNED allocation (non-null, refcount
//     >= 2: the VM's ref plus this variable's).
// The per-mode .expected files pin the intended difference as conformance.
func main() {
	var lit @[]readonly char = "abc"
	var w *int = bit_cast(*int, &lit)
	testing.Print("data!=0 ")
	testing.Println(w[0] != 0)
	testing.Print("len ")
	testing.Println(w[1])
	testing.Print("backingLen==len ")
	testing.Println(w[3] == w[1])
	testing.Print("backing==null ")
	testing.Println(w[2] == 0)
	if w[2] != 0 {
		testing.Print("rc>=2 ")
		testing.Println(rt.Refcount(bit_cast(*uint8, w[2])) >= 2)
	}
}
