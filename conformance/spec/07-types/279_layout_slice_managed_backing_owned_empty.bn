package "main"

import "pkg/builtins/rt"

// type.layout.slice-managed.backing: the two non-literal forms of the managed-
// slice `backing` word (word 2; word 3 is `backingLen`), which agree across all
// modes (the literal form is 278):
//   - an EMPTY slice is {null, 0, null, 0};
//   - an OWNED make_slice has a NON-null backing whose refcount is a normal
//     POSITIVE value -- its RefDec frees it when the count reaches 0.
// Read word-by-word via bit_cast (target-invariant -- each word is one int).
func words(s *@[]readonly char) *int {
	return bit_cast(*int, s)
}

func main() {
	// Empty slice: {null, 0, null, 0}.
	var emp @[]readonly char = make_slice(char, 0)
	var we *int = words(&emp)
	if we[0] != 0 || we[1] != 0 || we[2] != 0 || we[3] != 0 {
		println("FAIL empty not {null,0,null,0}")
		return
	}

	// Owned make_slice: non-null backing, positive refcount.
	var own @[]readonly char = make_slice(char, 5)
	var wo *int = words(&own)
	if wo[2] == 0 {
		println("FAIL owned backing null")
		return
	}
	if rt.Refcount(bit_cast(*uint8, wo[2])) <= 0 {
		println("FAIL owned refcount not positive")
		return
	}
	println("ok")
}
