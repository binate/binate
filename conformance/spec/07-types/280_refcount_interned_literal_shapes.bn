package "main"

import "pkg/builtins/rt"

// type.layout.slice-managed.backing (regression): reading rt.Refcount of an
// interned @[]readonly char literal's backing is SAFE and STABLE across the
// statement shapes once suspected of an "intermittent VM halt": (a) a scope that
// holds the literal, exits, then re-evaluates the SAME literal; and (b) a
// println-separated read of a DIFFERENT literal.  The reported halt was a probe
// ARTIFACT (a read of an unmapped pointer, which SIGSEGVs on every backend), not
// a VM bug -- a genuine interned backing is always a valid managed allocation
// (materializeModuleStrings uses make_slice), so reading its header is safe.
// Each read is guarded `if w[2] != 0` (the COMPILED backing is null
// immortal-rodata; the VM interns an owned backing) -- reaching "done" proves the
// header is readable in every shape.  Per-mode .expected pins the two
// realizations, as in 278.

func readRC(s @[]readonly char) {
	var w *int = bit_cast(*int, &s)
	if w[2] != 0 {
		print("rc ")
		println(rt.Refcount(bit_cast(*uint8, w[2])) >= 2)
	} else {
		println("rc null-backing")
	}
}

func main() {
	if true {
		var s @[]readonly char = "abc"
		readRC(s)
	}
	var s2 @[]readonly char = "abc"
	readRC(s2)
	println("sep")
	var s3 @[]readonly char = "xyz"
	readRC(s3)
	println("done")
}
