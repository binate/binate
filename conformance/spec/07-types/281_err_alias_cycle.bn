package "main"

// type.alias.acyclic (Constraint): an alias's target may not refer to the
// alias itself, directly or through other aliases, even behind a pointer —
// an alias has no identity of its own, so it would denote an infinite
// structural type.  Both declarations below must be REJECTED; the distinct
// type Node is the legal way to write the self-referential struct.

import "pkg/builtins/testing"

type N = struct {
	v    int
	next *N
}

type A = B

type B = *A

type Node struct {
	v    int
	next *Node
}

func main() {
	var n Node
	testing.Println(n.v)
}
