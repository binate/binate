package "main"

import "pkg/builtins/testing"

// A generic struct holding, by value, an instantiation of itself with an
// ever-growing type argument names infinitely many instantiations: it is
// rejected at its declaration, although the program never instantiates it.

type E[T any] struct {
	x T
	e E[[1]T]
}

func main() {
	testing.Println(0)
}
