package "main"

import "pkg/builtins/testing"

// A generic struct holding, by value, another instantiation of itself that
// holds itself (`Bad2[int]` in every `Bad2[T]`) is rejected at its
// declaration: the walk comes back to `Bad2[int]`.

type Bad2[T any] struct {
	x Bad2[int]
	y T
}

func main() {
	testing.Println(0)
}
