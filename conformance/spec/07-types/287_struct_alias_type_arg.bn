package "main"

import "pkg/builtins/testing"

// type.alias.transparency, gen.instantiate: an alias of a struct literal is that anonymous
// struct, so it instantiates a generic as the struct does: as a type argument
// directly, as a generic struct's argument, and under a pointer.

type Anon = struct {
	a int8
	b int8
	c int8
}

type Box[T any] struct {
	v   T
	pad [sizeof(T)]uint8
}

func size[T any](x T) int {
	var a [sizeof(T)]uint8
	return len(a)
}

func first[T any](p *T) int8 { return 1 }

func main() {
	var an Anon
	an.b = 2
	var lit struct {
		a int8
		b int8
		c int8
	}
	var bx Box[Anon]
	bx.v = an
	testing.Println(size[Anon](an), size[struct {
		a int8
		b int8
		c int8
	}](
			lit), len(bx.pad), bx.v.b, first[Anon](&an))
}
