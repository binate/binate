package "main"

// A type larger than the target int's maximum is a compile-time error (spec
// type.layout.max-size) — here 2^90 bytes, larger than every target's — as a named
// type, a pointee, a struct whose fields fit only one by one, and a sizeof operand.

type Huge [1 << 30][1 << 30][1 << 30]uint8

type Pair struct {
	a [1 << 30][1 << 30][1 << 2]uint8
	b [1 << 30][1 << 30][1 << 2]uint8
}

func main() {
	var p *([1 << 30][1 << 30][1 << 30]uint8)
	_ = p
	var n uint = sizeof([1 << 30][1 << 30][1 << 30]uint8)
	_ = n
}
