package "main"

// type.opaque.signature, type.opaque.pointer-to-embedding: a function value type
// is held to the rules a function declaration's parameters and results are,
// wherever it is written -- a type, a field, a parameter, a local, another
// signature -- since no such function value could ever be called.  Behind a
// pointer or handle, an opaque type is fine.

type Opaque

type Handler *func(Opaque) int

type Maker struct {
	mk @func() [2]Opaque
}

func run(f *func(*Opaque) @Opaque, g *func(*([2]Opaque))) { }

type Nested *func(*func(Opaque))

func main() {
	var cb @func(int) Opaque
}
