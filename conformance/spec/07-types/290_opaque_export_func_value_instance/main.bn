package "main"

import "pkg/builtins/testing"

import "pkg/q"

// type.opaque.signature: a package may instantiate another package's generic,
// whose body holds a function value over its type parameter, with its own opaque
// export: a type in the instance's body counts as opaque only if it is opaque
// both where the generic is written and where the instance is instantiated, and
// q's .bn, where it is instantiated, sees Op's definition.
func main() {
	testing.Println(q.Use())
}
