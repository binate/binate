package "main"

import "pkg/builtins/testing"

import "pkg/q"

// type.opaque.signature: a package may instantiate another package's generic,
// whose body holds a function value over its type parameter, with its own opaque
// export: the instance's body is checked in the generic's package, away from the
// one that may form values of the export, so the signature there is judged in
// the instance's view, where only a type with no definition anywhere is opaque.
func main() {
	testing.Println(q.Use())
}
