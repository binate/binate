package "main"

// type.opaque.signature: an interface method's parameters and results are held
// to the rules a function declaration's are -- each one that breaks them is
// rejected at the interface, which no implementation could satisfy.  Behind a
// pointer or handle, an opaque type is fine.

type Opaque

interface ByValue {
	Take(o Opaque)
}

interface FuncValue {
	Call(f *func(Opaque) int)
}

interface Embedding {
	Pair() [2]Opaque
	Point(p *([2]Opaque))
}

interface Fine {
	Handle(o *Opaque, f *func(*Opaque)) @Opaque
}

func main() {
}
