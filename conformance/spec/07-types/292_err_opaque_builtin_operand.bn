package "main"

// type.opaque.pointer-to-embedding, type.opaque.signature: a type written as a
// builtin's operand is held to the rules on forming a type, as a declared one
// is, not only to the builtin's own by-value check.

type Opaque

func main() {
	var n uint = sizeof(*func(Opaque))
	var a uint = alignof(@func() [2]Opaque)
	var s @[]*([2]Opaque) = make_slice(*([2]Opaque), 2)
	var m @(*func(Opaque)) = make(*func(Opaque))
	var p *uint8
	var f *func(Opaque) = bit_cast(*func(Opaque), p)
	var ok uint = sizeof(*func(*Opaque))
}
