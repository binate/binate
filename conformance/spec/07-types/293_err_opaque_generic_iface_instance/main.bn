package "main"

import "pkg/q"

// type.opaque.signature: an instantiated generic interface's methods are judged
// as code written where the generic is -- here main, where q's opaque export Op
// is opaque -- however the instance is first written: a method taking a
// *func(q.Op) makes GI[int] ill-formed even where it is only a local's type.

interface GI[T any] {
	Do(f *func(q.Op), x *T)
}

func main() {
	var a *GI[int]
	_ = a
}
