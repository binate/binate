package "main"

import "pkg/q"

// type.opaque.signature, gen.mono.check: a generic interface's own method
// signatures are judged at its declaration, where they are written -- here
// main, where q's opaque export Op is opaque: a method taking a *func(q.Op)
// makes GI ill-formed, however it is instantiated.

interface GI[T any] {
	Do(f *func(q.Op), x *T)
}

func main() {
	var a *GI[int]
	_ = a
}
