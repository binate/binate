package "main"

import "pkg/a"

// type.opaque.pointer-to-embedding, type.opaque.signature: an instance's parts
// that come from its type arguments are judged where the arguments are written:
// a pointer to [2]a.Box, or a function value over a.Box, is ill-formed in main
// whether written directly or through a generic's type parameter.  A generic's
// own parts are judged where it is written: a's Cell[int], whose field points to
// a type embedding a.Box, stays fine here, as does a pointer to a.Box itself.

type PBox[T any] struct {
	p *T
}

type MH[T any] struct {
	f *func(T)
}

type V PBox[[2]a.Box]

type U MH[a.Box]

type W a.Cell[int]

type X PBox[a.Box]

func main() {}
