package "main"

// type.opaque.by-value, type.opaque.pointer-to-embedding, type.opaque.signature,
// gen.mono.check: a generic declaration's own parts are held to the opaque rules
// where it is written, whether or not it is instantiated — a by-value field, an
// interface method's parameter and a generic function's parameter over the
// opaque Fwd.  A type parameter is not opaque, so the parts over T are fine.

type Fwd

type S[T any] struct {
	v Fwd
	t T
}

interface I[T any] {
	m(o Fwd) T
}

func F[T any](p *([2]Fwd)) int { return 0 }

type OK[T any] struct {
	a [2]T
	p *([2]T)
	f *func(T) T
}

func main() {}
