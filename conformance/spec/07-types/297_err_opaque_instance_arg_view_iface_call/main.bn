package "main"

import "pkg/a"

// type.opaque.signature, type.opaque.pointer-to-embedding: an interface
// instance's methods and a generic function's call judge the parts that come
// from their type arguments where they are written: a.Get[a.Box], whose get
// returns a.Box by value, is ill-formed in main — written directly, and as the
// interface of a field of S[a.Box] — and so is the call a.Id[a.Box], whose
// parameter points to two a.Box; a's own Get[Box] and Id[Box] (a.Mine) are fine.

type V *a.Get[a.Box]

type S[T any] struct {
	g @a.Get[T]
}

type U S[a.Box]

func main() {
	_ = a.Id[a.Box](nil)
	_ = a.Mine()
}
