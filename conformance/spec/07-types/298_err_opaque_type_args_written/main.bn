package "main"

import "pkg/a"

// type.opaque.signature, type.opaque.pointer-to-embedding: a type argument is a
// type written where it is.  A generic alias's use is judged there, its target
// as if written there: a.GA[a.Box] is @a.Get[a.Box], whose get returns a.Box by
// value, ill-formed in main.  An argument is held to the rules on forming a type
// whether or not the instance uses it: Ph[PBox[[2]a.Box]] in a type, at a call,
// and in a type-switch case.

type PBox[T any] struct {
	p *T
}

type Ph[T any] struct {
	n int
}

func Z[T any]() int { return 0 }

func f(g a.GA[a.Box]) {}

type W Ph[PBox[[2]a.Box]]

func g(v *any) int {
	switch v.(type) {
	case *PBox[[2]a.Box]:
		return 1
	}
	return Z[PBox[[2]a.Box]]()
}

func main() {}
