package "main"

import "pkg/builtins/testing"

import "pkg/q"

// type.opaque.by-value, type.opaque.pointer-to-embedding, type.opaque.signature:
// a type in a generic instance's body counts as opaque only if it is opaque both
// where its generic is written and where the instance is instantiated.  q's .bn
// sees its own export Op's definition, so it may instantiate lib's generics with
// Op, though their bodies and method signatures hold a T by value — directly,
// from another instance's body, through an alias and through a field.
func main() {
	testing.Println(q.Use())
}
