package "pkg/lib"

// G copies *p into a local, and declares a pointer to two Ts.
func G[T any](p *T) int {
	var x T = *p
	var y *([2]T)
	_ = x
	_ = y
	return 1
}

// F calls G.
func F[T any](p *T) int { return G[T](p) + 1 }

// S holds a pointer to a T.
type S[T any] struct {
	p *T
}

// M takes a T by value.
func (s *S[T]) M(x T) int {
	var y T = x
	_ = y
	return 3
}

// L is a pointer to an S.
type L[T any] = *S[T]

// Inner holds a pointer to a T.
type Inner[T any] struct {
	p *T
}

// M takes a T by value.
func (s *Inner[T]) M(x T) int { return 4 }

// Outer holds an Inner.
type Outer[T any] struct {
	Val Inner[T]
}
