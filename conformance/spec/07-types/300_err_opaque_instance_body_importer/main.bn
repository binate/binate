package "main"

import "pkg/q"

// type.opaque.by-value, type.opaque.signature: a type in a generic instance's
// body counts as opaque where it is opaque both where its generic is written and
// where the instance is instantiated.  main sees q.Op as opaque, so q's G[q.Op]
// instantiated here is rejected in G's body (q's own G[Op] is fine), and so is
// gt[q.Op], whose body's function value takes one, and q.Box[q.Op].M, which
// takes one and which q.Get[q.Op]'s method names — though q named Get[Op]
// first, where Op is not opaque.  An instance method's
// signature judges the parts that come from its type arguments, an interface
// instance's included: S[Fwd].m takes a *Get[Fwd], whose method returns an
// opaque value.

type Fwd

interface Get[T any] {
	get() T
}

type S[T any] struct {
	v *T
}

func (s *S[T]) m(g *Get[T]) {}

func gt[T any]() int {
	var f *func(T)
	_ = f
	return 2
}

func main() {
	var p *q.Op
	_ = q.G[q.Op](p)
	_ = q.Use()
	_ = gt[q.Op]()
	var s S[Fwd]
	_ = s
	var g @q.Get[q.Op]
	_ = g
}
