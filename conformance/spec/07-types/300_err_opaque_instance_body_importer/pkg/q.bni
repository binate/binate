package "pkg/q"

type Op

// G copies *p into a local, and declares a pointer to two Ts.
func G[T any](p *T) int {
	var x T = *p
	var y *([2]T)
	_ = x
	_ = y
	return 1
}

// Box holds a pointer to a T.
type Box[T any] struct {
	p *T
}

// M takes a T by value.
func (b *Box[T]) M(x T) int { return 2 }

// Get gets a *Box[T].
interface Get[T any] {
	get() *Box[T]
}

// Use instantiates G and Get with Op, where Op is not opaque.
func Use() int
