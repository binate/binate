package "main"

import "pkg/q"

// pkg.bni.self-contained, type.opaque.by-value, type.opaque.signature,
// type.opaque.pointer-to-embedding: q's .bni declarations are judged as q's
// importers see them, where q's export Op is opaque — Get, DefaultCB, Run, Take
// and V are rejected at q.bni, though q's .bn, which defines them, sees Op's
// layout.

func main() {
	_ = q.Run(nil)
}
