package "main"
import "pkg/builtins/testing"

// type.layout.transparent: the wrappers nest in any order and to any depth, and field
// offsets see through them as size and alignment do.  Each wrapped struct's field
// offsets, measured as address differences, equal the plain struct's, as do a
// containing struct's and an array's layout.  Asserted via equalities only, so it is
// target-invariant.

type S struct {
	a int8
	b int64
	c int32
	d int8
}

type NamedS S               // named over the struct
type NamedNamed NamedS      // named over a named
type AliasNamed = NamedNamed // alias over that
type Deep AliasNamed        // named over the alias

type Outer struct {
	x int8
	y readonly Deep
	z int8
}

type OuterPlain struct {
	x int8
	y S
	z int8
}

func main() {
	var s S
	var sb int = bit_cast(int, &s.b) - bit_cast(int, &s)
	var sc int = bit_cast(int, &s.c) - bit_cast(int, &s)
	var sd int = bit_cast(int, &s.d) - bit_cast(int, &s)

	// A named over an alias over a named over a named struct.
	var w Deep
	var deepOff bool = bit_cast(int, &w.b) - bit_cast(int, &w) == sb &&
			bit_cast(int, &w.c) - bit_cast(int, &w) == sc &&
			bit_cast(int, &w.d) - bit_cast(int, &w) == sd
	var deepSz bool = sizeof(Deep) == sizeof(S) && alignof(Deep) == alignof(S)

	// readonly over that, read through a pointer.
	var r *readonly Deep = &w
	var roOff bool = bit_cast(int, &r.b) - bit_cast(int, r) == sb &&
			bit_cast(int, &r.c) - bit_cast(int, r) == sc &&
			bit_cast(int, &r.d) - bit_cast(int, r) == sd
	var roSz bool = sizeof(readonly Deep) == sizeof(S) && alignof(readonly Deep) == alignof(S)

	// A field of the wrapped type lays its struct out as a field of S does.
	var o Outer
	var op OuterPlain
	var outerOff bool = bit_cast(int, &o.y) - bit_cast(int, &o) ==
					bit_cast(int, &op.y) - bit_cast(int, &op) &&
			bit_cast(int, &o.z) - bit_cast(int, &o) == bit_cast(int, &op.z) - bit_cast(int, &op)
	var outerSz bool = sizeof(Outer) == sizeof(OuterPlain) && alignof(Outer) == alignof(OuterPlain)

	// An array of the wrapped type has S's stride.
	var arr [3]Deep
	var arrOff bool = bit_cast(int, &arr[2].c) - bit_cast(int, &arr) == 2 * cast(int, sizeof(S)) + sc
	var arrSz bool = sizeof([3]Deep) == sizeof([3]S)

	if deepOff && deepSz && roOff && roSz && outerOff && outerSz && arrOff && arrSz {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
