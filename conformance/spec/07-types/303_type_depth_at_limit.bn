package "main"

import "pkg/builtins/testing"

// Types nesting as deeply as a declared type may: 1024 levels in this implementation
// (spec type.named.depth, at least 256).  A type's nesting depth counts the types in its
// longest chain of parts, a named type as its underlying type.  T0 -- whose layout X's
// array length reads while the types are collected -- nests 1024 levels: a struct for
// each of T0 .. T1021, then T1022's struct and int64; T1022's pointer back to T0 ends a
// chain there.  P0 nests 1024: a pointer for each of P0 .. P1022, then P1023's int.  I0
// nests 1023: an interface, a method's signature and an interface value for each of
// I0 .. I339, then I340's interface, signature and int.  Each type of the ring R0 ..
// R1024, each holding a pointer to the next, nests two levels: its struct and the
// pointer, which ends a chain in the ring.

type X struct { a [sizeof(T0)]uint8 }

type T0 struct { n T1 }
type T1 struct { n T2 }
type T2 struct { n T3 }
type T3 struct { n T4 }
type T4 struct { n T5 }
