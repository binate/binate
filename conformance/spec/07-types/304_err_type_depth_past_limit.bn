package "main"

import "pkg/builtins/testing"

// Types nesting one level deeper than a declared type may (spec type.named.depth: 1024
// levels in this implementation), each reported at the type where its chain passes the
// limit.  Z0 -- whose layout X's array length reads while the types are collected --
// nests 1025 levels (a struct for each of Z0 .. Z1022, then Z1023's struct and int64;
// Z1023's pointer back to Z0 ends a chain there).  W nests 1026 -- its struct and three
// arrays over WC0, which nests 1022 -- passing the limit within its own declaration.  P0
// nests 1025 (a pointer for each of P0 .. P1023, then P1024's int); I0 nests 1026 (an
// interface, a method's signature and an interface value for each of I0 .. I340, then
// I341's interface, signature and int).

type X struct { a [sizeof(Z0)]uint8 }

