package "main"
import "pkg/builtins/testing"

// conv.assignable: the closed set of implicit conversions. Cases exercised:
// 1 identical, 2 untyped-const-fit, 3 named-over-unnamed-composite, 6 nil,
// 9 func-reference -> function value. (Case 4 -> 002, 5 -> 003, 7 -> Ch.11,
// 8 -> 012.)
type Row [3]int

func g() int { return 7 }

func main() {
	var ok bool = true
	var a int = 5
	var b int = a                       // 1: identical
	if b != 5 { ok = false }
	var u uint8 = 200                    // 2: untyped constant the type can represent
	if u != 200 { ok = false }
	var r Row = [3]int{1, 2, 3}          // 3: unnamed [3]int -> named Row
	if r[2] != 3 { ok = false }
	var p *int = nil                     // 6: nil -> nillable
	if p != nil { ok = false }
	var fp *func() int = g               // 9: function reference -> function value
	if fp() != 7 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
