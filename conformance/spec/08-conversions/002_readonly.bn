package "main"

// conv.readonly: outermost readonly is permissive in both directions; adding
// element-level readonly (behind a handle) is an implicit widening; DROPPING
// element-level readonly is not implicit and requires a cast (see also 013).
func main() {
	var ok bool = true
	var x int = 7
	var rx readonly int = x              // int -> readonly int
	var y int = rx                       // readonly int -> int (both permissive)
	if y != 7 { ok = false }
	var p *int = &x
	var rp *readonly int = p             // *int -> *readonly int (add element readonly)
	if *rp != 7 { ok = false }
	var p2 *int = cast(*int, rp)         // cast drops element readonly
	if *p2 != 7 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
