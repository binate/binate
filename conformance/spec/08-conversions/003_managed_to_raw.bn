package "main"
import "pkg/builtins/testing"

// conv.managed-to-raw: @T -> *T, @[]T -> *[]T, and @func(...) -> *func(...)
// implicitly, as a borrow (copies the pointer words, takes no reference count).
// (Refcount transparency is not observable from pure Binate, so the "no
// reference count" half is exercised only as far as value-readability.)
func dbl(n int) int { return n * 2 }

func main() {
	var ok bool = true
	var m @int = box(5)
	var rp *int = m                      // @int -> *int (borrow)
	if *rp != 5 { ok = false }
	var ms @[]int = @[]int{1, 2, 3}
	var rs *[]int = ms                   // @[]int -> *[]int (borrow)
	if len(rs) != 3 || rs[1] != 2 { ok = false }
	var mf @func(int) int = dbl
	var rf *func(int) int = mf           // @func -> *func (borrow)
	if rf(21) != 42 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
