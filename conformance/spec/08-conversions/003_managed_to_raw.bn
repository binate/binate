package "main"

// conv.managed-to-raw: @T -> *T and @[]T -> *[]T implicitly, as a borrow (copies
// the pointer words, takes no reference count).
func main() {
	var ok bool = true
	var m @int = box(5)
	var rp *int = m                      // @int -> *int (borrow)
	if *rp != 5 { ok = false }
	var ms @[]int = @[]int{1, 2, 3}
	var rs *[]int = ms                   // @[]int -> *[]int (borrow)
	if len(rs) != 3 || rs[1] != 2 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
