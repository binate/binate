package "main"
import "pkg/builtins/testing"

// conv.cast: value conversion — int<->int (narrowing truncates; widening
// sign-extends a signed source, zero-extends an unsigned source), int<->float,
// and float->int truncation toward zero. Operands are runtime (a constant cast
// is fit-checked instead; see 008).
func u300() int { return 300 }
func neg() int { return -5 }
func big() int64 { return 5000000000 }
func n8() int8 { return -1 }
func u8() uint8 { return 200 }

func main() {
	var ok bool = true
	if cast(uint8, u300()) != cast(uint8, 44) { ok = false }       // 300 mod 256 (narrow)
	if cast(int32, big()) != cast(int32, 705032704) { ok = false } // narrow truncates
	if cast(int64, n8()) != cast(int64, -1) { ok = false }         // signed widen: sign-extend
	if cast(uint32, u8()) != cast(uint32, 200) { ok = false }      // unsigned widen: zero-extend
	var f float64 = 3.9
	if cast(int, f) != 3 { ok = false }                            // truncate toward zero
	if cast(float64, neg()) != -5.0 { ok = false }                 // int -> float
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
