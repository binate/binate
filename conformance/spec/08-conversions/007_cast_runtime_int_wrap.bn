package "main"
import "pkg/builtins/testing"

// conv.cast: a runtime integer cast takes the value modulo the destination
// width (two's-complement) with NO fit-check — cast(uint, <runtime negative int>)
// wraps to its two's-complement value — whereas the same cast of a CONSTANT (-1)
// is a compile error (conv.cast.const-not-laundered; see 008).
func neg() int { return -1 }

func main() {
	var n int = neg()
	var u uint = cast(uint, n)            // runtime: wraps, no error
	if cast(int, u) == -1 { testing.Println("ok") } else { testing.Println("FAIL") }
}
