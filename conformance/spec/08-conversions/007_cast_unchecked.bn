package "main"
import "pkg/builtins/testing"

// conv.cast.unchecked: a cast of a typed, non-constant operand is not fit-checked
// — cast(uint, <runtime negative int>) wraps to its two's-complement value,
// whereas the same cast of a CONSTANT (-1) is a compile error (see 008).
func neg() int { return -1 }

func main() {
	var n int = neg()
	var u uint = cast(uint, n)            // runtime: wraps, no error
	if cast(int, u) == -1 { testing.Println("ok") } else { testing.Println("FAIL") }
}
