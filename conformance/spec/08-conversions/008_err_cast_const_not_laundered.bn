package "main"
import "pkg/builtins/testing"

// conv.cast.const-not-laundered: a cast does not launder a constant — an
// out-of-range constant cast is a compile-time error, even nested through an
// inner cast (no constant -> runtime escape).
func main() {
	var x int8 = cast(int8, cast(int, 200))
	testing.Println(cast(int, x))
}
