package "main"

// conv.cast.float-int-saturation: float->int at the out-of-range / non-finite
// edge saturates — above range (incl +Inf) -> MAX, below (incl -Inf) -> MIN (0
// unsigned), NaN -> 0; in-range truncates.
func big() float64 { return 1.0e30 }
func nbig() float64 { return -1.0e30 }
func zf() float64 { return 0.0 }

func main() {
	var ok bool = true
	if cast(int8, big()) != 127 { ok = false }                 // above -> MAX
	if cast(int8, nbig()) != -128 { ok = false }               // below -> MIN
	if cast(uint8, nbig()) != cast(uint8, 0) { ok = false }    // below unsigned -> 0
	var nan float64 = zf() / zf()
	if cast(int, nan) != 0 { ok = false }                      // NaN -> 0
	if cast(int8, 3.9) != 3 { ok = false }                     // in-range truncates
	if ok { println("ok") } else { println("FAIL") }
}
