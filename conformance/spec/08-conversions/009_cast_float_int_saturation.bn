package "main"

// conv.cast.float-int-saturation: float->int at the out-of-range / non-finite
// edge saturates — above range (incl +Inf) -> MAX, below (incl -Inf) -> MIN (0
// unsigned), NaN -> 0; in-range truncates. All operands runtime.
func big() float64 { return 1.0e30 }
func nbig() float64 { return -1.0e30 }
func inrange() float64 { return 3.9 }
func zf() float64 { return 0.0 }

func main() {
	var ok bool = true
	if cast(int8, big()) != 127 { ok = false }                 // finite above -> MAX
	if cast(int8, nbig()) != -128 { ok = false }               // finite below -> MIN
	var huge float64 = 1.0e308
	var inf float64 = huge * 10.0                              // +Inf
	if cast(int8, inf) != 127 { ok = false }                   // +Inf -> MAX
	if cast(int8, zf()-inf) != -128 { ok = false }             // -Inf -> MIN
	if cast(uint8, zf()-inf) != cast(uint8, 0) { ok = false }  // -Inf unsigned -> 0
	if cast(int, zf()/zf()) != 0 { ok = false }                // NaN -> 0
	if cast(int8, inrange()) != 3 { ok = false }               // in-range truncates
	if ok { println("ok") } else { println("FAIL") }
}
