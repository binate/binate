package "main"

// conv.bit-cast: reinterpret the bits with no value conversion — an int8 -1
// (0xFF) reinterpreted as uint8 255, and same-width round-trips through a stored
// typed value.
func nv() int8 { return -1 }

func main() {
	var ok bool = true
	var r uint8 = bit_cast(uint8, nv())
	if r != cast(uint8, 255) { ok = false }
	var i32 int32 = 1000
	var u uint32 = bit_cast(uint32, i32)
	if bit_cast(int32, u) != 1000 { ok = false }
	var f float32 = 1.5
	var fb uint32 = bit_cast(uint32, f)
	if bit_cast(float32, fb) != 1.5 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
