package "main"

// conv.bit-cast: reinterpret the bits with no value conversion. The float32 case
// pins the exact bit pattern (1.5f = 0x3FC00000 = 1069547520), which a value
// conversion (cast(uint32, 1.5) = 1) would not produce.
func nv() int8 { return -1 }

func main() {
	var ok bool = true
	var r uint8 = bit_cast(uint8, nv())
	if r != cast(uint8, 255) { ok = false }
	var f float32 = 1.5
	var fb uint32 = bit_cast(uint32, f)
	if fb != cast(uint32, 1069547520) { ok = false }   // exact bits, not the value 1
	if bit_cast(float32, fb) != 1.5 { ok = false }      // round-trips
	if ok { println("ok") } else { println("FAIL") }
}
