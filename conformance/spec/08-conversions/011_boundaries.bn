package "main"

// conv.boundaries: the assignability relation applies at every boundary — var
// init, assignment, argument, return, and field/element stores. Exercised here
// with the managed-to-raw borrow at each.
type Holder struct {
	p *int
}

func takeRaw(r *int) int { return *r }

func giveRaw(m @int) *int { return m }   // return boundary: @int -> *int

func main() {
	var ok bool = true
	var m @int = box(9)
	var r *int = m                        // var-init boundary
	var r2 *int = nil
	r2 = m                                // plain assignment boundary
	if *r2 != 9 { ok = false }
	if takeRaw(m) != 9 { ok = false }     // argument boundary: @int -> *int
	if *giveRaw(m) != 9 { ok = false }    // return boundary
	var h Holder
	h.p = m                               // field-store boundary
	if *h.p != 9 { ok = false }
	var arr [1]*int
	arr[0] = m                            // element-store boundary
	if *arr[0] != 9 { ok = false }
	if r == nil { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
