package "main"

// conv.assignable case 8: a string literal's natural type [N]readonly char is
// implicitly assignable to its permitted char-slice targets and to a
// matching-length char array (the [N]char form drops element-readonly via the
// value-copy of §8.3).
func main() {
	var ok bool = true
	var a @[]readonly char = "hi"
	if len(a) != 2 || a[0] != 'h' { ok = false }
	var b *[]readonly char = "hi"
	if b[1] != 'i' { ok = false }
	var c @[]char = "hi"
	if c[0] != 'h' { ok = false }
	var d [2]readonly char = "hi"
	if d[1] != 'i' { ok = false }
	var e [2]char = "hi"                  // [N]char drops element readonly (value copy)
	if e[0] != 'h' { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
