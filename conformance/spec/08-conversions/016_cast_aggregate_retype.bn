package "main"
import "pkg/builtins/testing"

// conv.cast.aggregate-retype: a container — an array [N]T, a raw slice *[]T, or a
// managed-slice @[]T — casts to the same shape over a same-size element type whose
// conversion is total and bit-preserving; the elements are reinterpreted in place.
// Every operand is built from runtime values so no cast is folded away.

type Bytes [4]uint8

func i8s(a int8, b int8, c int8, d int8) [4]int8 { return [4]int8{a, b, c, d} }

func i32s(a int32, b int32) [2]int32 { return [2]int32{a, b} }

func main() {
	var ok bool = true

	// [4]int8 -> [4]uint8: the two's-complement bytes, reinterpreted.
	var s [4]int8 = i8s(-1, 2, -128, 127)
	var u [4]uint8 = cast([4]uint8, s)
	if u[0] != 255 || u[1] != 2 || u[2] != 128 || u[3] != 127 { ok = false }

	// ... and back again.
	var s2 [4]int8 = cast([4]int8, u)
	if s2[0] != -1 || s2[1] != 2 || s2[2] != -128 || s2[3] != 127 { ok = false }

	// A named array type and its underlying convert both ways.
	var b Bytes = cast(Bytes, u)
	if b[0] != 255 || b[3] != 127 { ok = false }
	var u2 [4]uint8 = cast([4]uint8, b)
	if u2[2] != 128 { ok = false }

	// [2]int32 -> [2]uint32.
	var w [2]uint32 = cast([2]uint32, i32s(-2, 7))
	if w[0] != 4294967294 || w[1] != 7 { ok = false }

	// @[]int8 -> @[]uint8 (a new owning handle to the same backing) and
	// *[]int8 -> *[]uint8 (a borrow); both see the same bytes.
	var ms @[]int8 = make_slice(int8, 2)
	ms[0] = -2
	ms[1] = 5
	var mu @[]uint8 = cast(@[]uint8, ms)
	if len(mu) != 2 || mu[0] != 254 || mu[1] != 5 { ok = false }
	var rs *[]int8 = ms
	var ru *[]uint8 = cast(*[]uint8, rs)
	if len(ru) != 2 || ru[0] != 254 || ru[1] != 5 { ok = false }
	ms[1] = -1
	if mu[1] != 255 || ru[1] != 255 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
