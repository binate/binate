package "main"
import "pkg/builtins/testing"

// conv.cast.aggregate-retype, leaf rule: an element conversion qualifies for a
// container retype iff it is total and bit-preserving (cast equals bit_cast on every
// element) — not only same-size integers.  bool -> int8/uint8 (false/true are the
// valid bytes 0/1), a named type <-> its underlying, and two named structs sharing
// one layout all qualify, for arrays and managed-slices alike.

type P struct {
	x int32
	y int32
}

type Q struct {
	x int32
	y int32
}

type Celsius float64

func bools(a bool, b bool, c bool) [3]bool { return [3]bool{a, b, c} }

func temps(a float64, b float64) [2]Celsius {
	return [2]Celsius{cast(Celsius, a), cast(Celsius, b)}
}

func main() {
	var ok bool = true

	// [3]bool -> [3]uint8 and [3]bool -> [3]int8.
	var bu [3]uint8 = cast([3]uint8, bools(true, false, true))
	if bu[0] != 1 || bu[1] != 0 || bu[2] != 1 { ok = false }
	var bi [3]int8 = cast([3]int8, bools(false, true, true))
	if bi[0] != 0 || bi[1] != 1 || bi[2] != 1 { ok = false }

	// [2]Celsius -> [2]float64: a named float and its underlying.
	var f [2]float64 = cast([2]float64, temps(-40.5, 100.25))
	if f[0] != -40.5 || f[1] != 100.25 { ok = false }

	// [2]P -> [2]Q: two named structs sharing one layout.
	var ps [2]P
	ps[0].x = -3
	ps[0].y = 4
	ps[1].x = 5
	ps[1].y = -6
	var qs [2]Q = cast([2]Q, ps)
	if qs[0].x != -3 || qs[0].y != 4 || qs[1].x != 5 || qs[1].y != -6 { ok = false }

	// @[]bool -> @[]uint8: the managed-slice form over the same backing.
	var mb @[]bool = make_slice(bool, 2)
	mb[1] = true
	var mu @[]uint8 = cast(@[]uint8, mb)
	if len(mu) != 2 || mu[0] != 0 || mu[1] != 1 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
