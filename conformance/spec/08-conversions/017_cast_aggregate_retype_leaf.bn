package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// conv.cast.aggregate-retype, leaf rule: an element conversion qualifies for a
// container retype iff it is total and bit-preserving (cast equals bit_cast on every
// element) — not only same-size integers.  bool -> int8/uint8 (false/true are the
// valid bytes 0/1), a named type <-> its underlying (or another named type over
// it), and two structs sharing one layout all qualify — managed elements and
// fields included — for arrays, managed-slices and raw slices alike, adding
// element-level readonly where an assignment could.

type P struct {
	x int32
	y int32
}

type Q struct {
	x int32
	y int32
}

type Celsius float64

type Fahrenheit float64

type RP *readonly int32

type PP struct {
	p *int32
}

type QP struct {
	p *readonly int32
}

type MyBool bool

type MyByte uint8

type Node struct {
	v int
}

type H @Node

type PN struct {
	n @Node
	k int
}

type QN struct {
	n @Node
	k int
}

// retypeManaged retypes holders of node — an array of a named managed pointer to
// one of its underlying, a managed-slice of structs holding one to another
// struct of that layout — and reads node through each.
func retypeManaged(node @Node) int {
	var hs [2]H
	hs[0] = node
	hs[1] = node
	var ns [2]@Node = cast([2]@Node, hs)
	var pn @[]PN = make_slice(PN, 1)
	pn[0].n = node
	var qn @[]QN = cast(@[]QN, pn)
	return ns[0].v + ns[1].v + qn[0].n.v
}

func bools(a bool, b bool, c bool) [3]bool { return [3]bool{a, b, c} }

func temps(a float64, b float64) [2]Celsius {
	return [2]Celsius{cast(Celsius, a), cast(Celsius, b)}
}

func main() {
	var ok bool = true

	// [3]bool -> [3]uint8 and [3]bool -> [3]int8.
	var bu [3]uint8 = cast([3]uint8, bools(true, false, true))
	if bu[0] != 1 || bu[1] != 0 || bu[2] != 1 { ok = false }
	var bi [3]int8 = cast([3]int8, bools(false, true, true))
	if bi[0] != 0 || bi[1] != 1 || bi[2] != 1 { ok = false }

	// [2]Celsius -> [2]float64: a named float and its underlying.
	var f [2]float64 = cast([2]float64, temps(-40.5, 100.25))
	if f[0] != -40.5 || f[1] != 100.25 { ok = false }
	var c [2]Celsius = cast([2]Celsius, f)
	var fa [2]Fahrenheit = cast([2]Fahrenheit, c)
	if cast(float64, fa[0]) != -40.5 || cast(float64, fa[1]) != 100.25 { ok = false }

	// [2]P -> [2]Q: two named structs sharing one layout.
	var ps [2]P
	ps[0].x = -3
	ps[0].y = 4
	ps[1].x = 5
	ps[1].y = -6
	var qs [2]Q = cast([2]Q, ps)
	if qs[0].x != -3 || qs[0].y != 4 || qs[1].x != 5 || qs[1].y != -6 { ok = false }
	// [2]P -> [2]struct{...}: a named struct and its anonymous underlying.
	var as [2]struct {
		x int32
		y int32
	} = cast([2]struct {
		x int32
		y int32
	}, ps)
	if as[0].x != -3 || as[1].y != -6 { ok = false }

	// A copied array may add readonly one level in — to a field's pointee, or
	// through a named pointer type.
	var n int32 = 7
	var pp [2]PP
	pp[0].p = &n
	pp[1].p = &n
	var qp [2]QP = cast([2]QP, pp)
	if *qp[0].p != 7 || *qp[1].p != 7 { ok = false }
	var rp [2]RP
	rp[0] = cast(RP, qp[0].p)
	rp[1] = cast(RP, &n)
	var rr [2]*readonly int32 = cast([2]*readonly int32, rp)
	if *rr[0] != 7 || *rr[1] != 7 { ok = false }

	// @[]bool -> @[]uint8: the managed-slice form over the same backing.
	var mb @[]bool = make_slice(bool, 2)
	mb[1] = true
	var mu @[]uint8 = cast(@[]uint8, mb)
	if len(mu) != 2 || mu[0] != 0 || mu[1] != 1 { ok = false }
	// ... adding element readonly, and the raw-slice form.
	var mr @[]readonly int8 = cast(@[]readonly int8, mb)
	var rb *[]bool = mb
	var rs *[]uint8 = cast(*[]uint8, rb)
	if mr[1] != 1 || rs[0] != 0 || rs[1] != 1 { ok = false }

	// Named bool and byte types; two same-layout structs through a managed- and a
	// raw slice, sharing the backing.
	var nb [2]MyBool
	nb[1] = true
	var nu [2]MyByte = cast([2]MyByte, nb)
	if nu[0] != 0 || nu[1] != 1 { ok = false }
	var mps @[]P = make_slice(P, 2)
	mps[1].y = 9
	var mqs @[]Q = cast(@[]Q, mps)
	var rps *[]P = mps
	var rqs *[]Q = cast(*[]Q, rps)
	mqs[0].x = 8
	if mps[0].x != 8 || mqs[1].y != 9 || rqs[0].x != 8 || rqs[1].y != 9 { ok = false }

	// Managed elements: the retyped values manage the same references, so once
	// they are gone the node's refcount is back to 1.
	var node @Node = make(Node)
	node.v = 11
	var pnode *uint8 = bit_cast(*uint8, node)
	if retypeManaged(node) != 33 || rt.Refcount(pnode) != 1 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
