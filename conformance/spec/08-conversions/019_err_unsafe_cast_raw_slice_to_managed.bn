package "main"

import "pkg/builtins/testing"

// conv.unsafe-cast: unsafe_cast has no raw slice -> managed-slice conversion.
// A managed-slice carries words the raw slice lacks (§8.4) — it is an
// under-determined construction, not a reinterpretation — so the conversion is a
// compile error, not left for code generation.

func main() {
	var arr [3]int
	var s *[]int = arr[:]
	var m @[]int = unsafe_cast(@[]int, s)
	testing.Println(len(m))
}
