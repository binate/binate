package "main"

import "pkg/builtins/testing"

// conv.unsafe-cast: unsafe_cast has no raw function value -> managed function
// value conversion (§8.4) — the managed value owns what the raw one only
// borrows — so the conversion is a compile error, not left for code generation.

func dbl(x int) int { return x * 2 }

func main() {
	var f *func(int) int = dbl
	var g @func(int) int = unsafe_cast(@func(int) int, f)
	testing.Println(g(3))
}
