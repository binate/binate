package "main"

import "pkg/builtins/testing"

// conv.cast: a cast whose type reaches itself through a pointer, managed-pointer
// or slice field — a list node, a doubly linked ring, a tree — is an ordinary
// conversion; checking it must not walk the recursive type forever.

type Node struct {
	v    int
	next @Node
	kids @[]@Node
}

type Ring struct {
	prev *Ring
	next *Ring
	id   int
}

func main() {
	var n @Node = make(Node)
	n.v = 3
	n.next = make(Node)
	n.next.v = 4
	var m @Node = cast(@Node, n)
	testing.Println(m.v, m.next.v)
	var r Ring
	r.id = 9
	r.prev = &r
	r.next = &r
	var q *Ring = cast(*Ring, &r)
	testing.Println(q.next.prev.id)
	var u @Node = unsafe_cast(@Node, n)
	testing.Println(u.next.v)
}
