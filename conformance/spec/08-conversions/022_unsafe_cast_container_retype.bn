package "main"

import "pkg/builtins/testing"

// conv.unsafe-cast / conv.cast.aggregate-retype: a container retyped over an
// element conversion that cast refuses only for being unverifiable — the
// partial `int8 -> bool` direction, or an element-level readonly drop — at an
// unchanged element size is unsafe_cast's.  The retype reinterprets the same
// elements in place: a managed-slice retype shares the backing.

func main() {
	var s @[]int8 = make_slice(int8, 3)
	s[0] = 1
	s[2] = 1
	var bs @[]bool = unsafe_cast(@[]bool, s)
	testing.Println(bs[0], bs[1], bs[2])

	var a [4]int8
	a[3] = 1
	var ab [4]bool = unsafe_cast([4]bool, a)
	testing.Println(ab[0], ab[3])

	var r @[]readonly int8 = s
	var u @[]uint8 = unsafe_cast(@[]uint8, r)
	u[1] = 200
	testing.Println(s[1])

	var lit *[]char = unsafe_cast(*[]char, "abc")
	testing.Println(len(lit), cast(int, lit[1]))
}
