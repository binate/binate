package "main"

import "pkg/builtins/testing"

// conv.unsafe-cast: a string literal adopts a char slice or array type (with
// element readonly), but not a slice of a distinct NAMED char type — `cast` and
// assignment reject `*[]readonly MyC` from "abc", so unsafe_cast has no readonly
// to drop and rejects `*[]MyC` from it too.

type MyC char

func main() {
	var c *[]MyC = unsafe_cast(*[]MyC, "abc")
	testing.Println(len(c))
}
