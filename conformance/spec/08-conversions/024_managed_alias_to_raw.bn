package "main"

import "pkg/builtins/testing"

// conv.managed-to-raw, conv.cast: an alias is the same type as its target, so
// a value typed by an alias of a managed pointer, managed-slice or managed
// function value borrows as the raw form, implicitly or through `cast`, as a
// value of the managed type does.

type MP = @int
type MS = @[]int
type MF = @func(int) int

func main() {
	var p MP = make(int)
	*p = 3
	var rp *int = p
	var s MS = make_slice(int, 2)
	s[1] = 4
	var rs *[]int = s
	var k int = 5
	var f MF = func(x int) int { return x + k }
	var rf *func(int) int = f
	var cf *func(int) int = cast(*func(int) int, f)
	testing.Println(*rp, rs[1], rf(1), cf(2))
}
