package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// conv.unsafe-cast: unsafe_cast accepts everything cast does, including between
// interface values — the identity, a sub-interface widened to a parent, a
// grandparent or `any`, and the managed -> raw borrow — lowered as cast lowers
// them (a widening substitutes the parent's vtable slice, so a wrong offset
// would dispatch the wrong method).  Also through generic code: a type
// parameter as the source, as the target, or as a generic interface's argument.

interface Getter { Get() int }

interface Namer { Name() int }

interface Named : Getter, Namer { Both() int }

interface Box[T any] { Val() T }

interface SubBox[T any] : Box[T] { Twice() T }

type T struct { v int }

func (t @T) Get() int { return t.v }

func (t @T) Name() int { return t.v * 10 }

func (t @T) Both() int { return t.v * 100 }

func (t @T) Val() int { return t.v + 1 }

func (t @T) Twice() int { return t.v * 2 }

impl @T : Named, SubBox[int]

func toAny[B any](x @Named) B { return unsafe_cast(B, x) }

func toGetter[A any](x A) @Getter { return unsafe_cast(@Getter, x) }

// viaTemp widens a fresh managed value and drops it; the object's refcount
// must come back to what it was.
func viaTemp(t @T) int {
	var g @Getter = unsafe_cast(@Getter, mkNamed(t))
	return g.Get()
}

func mkNamed(t @T) @Named { return t }

func main() {
	var t @T = make(T)
	t.v = 7
	var n @Named = t
	var id @Named = unsafe_cast(@Named, n)
	var g @Getter = unsafe_cast(@Getter, n)
	var nm @Namer = unsafe_cast(@Namer, n)
	var a @any = unsafe_cast(@any, n)
	var back @T = a.(@T)
	testing.Println(id.Both(), g.Get(), nm.Name(), back.v)

	// The managed -> raw borrow, and raw -> raw widenings.
	var rn *Named = unsafe_cast(*Named, n)
	var rg *Getter = unsafe_cast(*Getter, rn)
	var rm *Namer = unsafe_cast(*Namer, rn)
	var ra *any = unsafe_cast(*any, rn)
	var rb *T = ra.(*T)
	testing.Println(rn.Both(), rg.Get(), rm.Name(), rb.v)

	// Generic: the target, then the source, a type parameter.
	var tg @Getter = toAny[@Getter](n)
	var tn @Namer = toAny[@Namer](n)
	var sg @Getter = toGetter[@Named](n)
	testing.Println(tg.Get(), tn.Name(), sg.Get())

	// A generic interface's instantiations.
	var sb @SubBox[int] = t
	var bb @Box[int] = unsafe_cast(@Box[int], sb)
	testing.Println(sb.Twice(), bb.Val())

	// A widened temporary is released once.
	var pt *uint8 = bit_cast(*uint8, t)
	var before int = rt.Refcount(pt)
	testing.Println(viaTemp(t), rt.Refcount(pt) - before)
}
