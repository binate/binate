package "main"

import "pkg/builtins/testing"

// conv.typeparam: the validity of a conversion whose source or target type is
// one in which a type parameter occurs is checked for each instance, with the
// instance's types, so a `bit_cast` is valid where the instance's sizes agree
// and an `unsafe_cast` to an interface value where the instance's operand is a
// satisfying pointer.

interface Getter {
	Get() int
}

type Thing struct {
	n int
}

impl *Thing : Getter

func (t *Thing) Get() int { return t.n }

func bits[T any](x uint32) T { return bit_cast(T, x) }

func asGetter[T any](x T) *Getter { return unsafe_cast(*Getter, x) }

func widen[T any](x @Thing) T { return cast(T, x) }

func main() {
	var f float32 = bits[float32](1065353216)
	var b [4]uint8 = bits[[4]uint8](0x01020304)
	testing.Println(f == 1.0, cast(int, b[0]) + cast(int, b[3]))
	var t Thing
	t.n = 6
	testing.Println(asGetter[*Thing](&t).Get())
	var m @Thing = make(Thing)
	m.n = 8
	var a @any = widen[@any](m)
	var back @Thing = a.(@Thing)
	testing.Println(back.n)
}
