package "main"

// conv.typeparam: a `bit_cast` through a type parameter is checked for each
// instance with the instance's sizes; an instance whose sizes differ is a
// compile-time error, reported at the instantiation.

func bits[T any](x uint32) T {
	return bit_cast(T, x)
}

func main() {
	var ok float32 = bits[float32](0)
	var bad int64 = bits[int64](0)
	_ = ok
	_ = bad
}
