package "main"

import "pkg/builtins/testing"

// unsafe_cast's unchecked interface narrowing recovers what the checked type
// assertion would, without the check: from a managed `@any`, a `@T`, a `*T` and a
// value `T`; from a raw `*any`, a `*T` and a value `T`, and also a `@T` — the
// narrowing composed with `*T -> @T`'s management-header assertion, which holds
// here because the boxed `@Box` is managed.

type Box struct {
	v int
}

func main() {
	var b @Box = make(Box)
	b.v = 7
	var m @any = b
	var r *any = m
	var mb @Box = unsafe_cast(@Box, m)
	var pb *Box = unsafe_cast(*Box, m)
	var vb Box = unsafe_cast(Box, m)
	var rpb *Box = unsafe_cast(*Box, r)
	var rvb Box = unsafe_cast(Box, r)
	var rmb @Box = unsafe_cast(@Box, r)
	testing.Println(mb.v, pb.v, vb.v, rpb.v, rvb.v, rmb.v)
}
