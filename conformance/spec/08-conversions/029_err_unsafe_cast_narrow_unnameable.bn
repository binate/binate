package "main"

// unsafe_cast recovers from an interface value only what a type assertion could
// name: an array, a function value, an anonymous struct, or a pointer to an
// array is a compile-time error.

type Box struct {
	v int
}

func main() {
	var a @any = make(Box)
	var arr [2]int = unsafe_cast([2]int, a)
	var fv @func() int = unsafe_cast(@func() int, a)
	var st struct { v int } = unsafe_cast(struct { v int }, a)
	var pa *([2]int) = unsafe_cast(*([2]int), a)
	_ = arr
	_ = fv
	_ = st
	_ = pa
}
