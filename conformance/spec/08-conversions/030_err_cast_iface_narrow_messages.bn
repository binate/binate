package "main"

// A `cast` that narrows an interface value names the alternative that works: a
// narrower interface only through a type assertion `x.(J)` (unsafe_cast cannot
// recover one either), and an array not at all, since no conversion recovers
// what an assertion cannot name.

interface A {
	f() int
}

interface B : A {
	g() int
}

func main() {
	var a @A
	var b @B = cast(@B, a)
	var arr [2]int = cast([2]int, a)
	_ = b
	_ = arr
}
