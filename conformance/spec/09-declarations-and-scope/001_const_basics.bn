package "main"

// decl.const: a `const` binds a name to a compile-time value with no storage.
// Scalar consts of every scalar kind, an inferred-type const, a named-distinct
// const over a scalar, and a const used as a compile-time array size (which is
// only possible because the value is known at compile time).
const Limit int = 100
const Pi float64 = 3.5
const Yes bool = true
const Letter char = 65 // 'A'
const N = 42           // type inferred from the expression

type Cel int
const Freeze Cel = 0 // a named-distinct type over a scalar is allowed

func main() {
	var ok bool = true
	if Limit != 100 {
		ok = false
	}
	if !(Pi == 3.5) {
		ok = false
	}
	if !Yes {
		ok = false
	}
	if Letter != 65 {
		ok = false
	}
	var c Cel = Freeze
	if cast(int, c) != 0 {
		ok = false
	}
	// N is a compile-time value, so it may size an array.
	var a [N]int
	if len(a) != 42 {
		ok = false
	}
	if ok {
		println("ok")
	} else {
		println("FAIL")
	}
}
