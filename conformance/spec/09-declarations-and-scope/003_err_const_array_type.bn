package "main"

// decl.const.scalar-only (Constraint): a const's type must be scalar (bool,
// char, an integer or float type, or a named-distinct over one). An array type
// is not scalar, so this const is rejected; immutable storage of a non-scalar
// value uses `var ... readonly` instead (§9.4).
const C [3]int = [3]int{1, 2, 3}

func main() {
	_ = C
}
