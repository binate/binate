package "main"

// decl.const.iota: within a grouped `const ( ... )` block, `iota` is the
// zero-based index of the current spec; bare members repeat the previous spec's
// type and expression with iota incremented. The plain counter form yields
// 0,1,2,...; the `1 << iota` form yields successive bit flags.
const (
	Red int = iota
	Green
	Blue
)

const (
	FlagA int = 1 << iota
	FlagB
	FlagC
	FlagD
)

func main() {
	var ok bool = true
	if Red != 0 {
		ok = false
	}
	if Green != 1 {
		ok = false
	}
	if Blue != 2 {
		ok = false
	}
	if FlagA != 1 {
		ok = false
	}
	if FlagB != 2 {
		ok = false
	}
	if FlagC != 4 {
		ok = false
	}
	if FlagD != 8 {
		ok = false
	}
	if ok {
		println("ok")
	} else {
		println("FAIL")
	}
}
