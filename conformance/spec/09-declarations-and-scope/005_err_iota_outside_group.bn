package "main"

// decl.const.iota: `iota` is recognized only inside a grouped const block.
// Referencing it in a non-grouped const declaration is `undefined: iota`. The
// rule-satisfying neighbor -- iota inside a grouped block with MULTIPLE
// members -- is 004_const_iota_group, which compiles. (The impl resolves iota
// only in a grouped block of 2+ members; see the spec-vs-impl note in claude-todo.)
const X int = iota

func main() {
	_ = X
}
