package "main"

// decl.const.iota: `iota` is recognized only inside a grouped const block.
// Referencing it in a non-grouped const declaration is `undefined: iota`. The
// rule-satisfying neighbors are 004_const_iota_group (a multi-member group) and
// 006_const_iota_single_member_group (a single-member group) -- iota binds in
// ANY grouped block, regardless of member count, but not in this non-grouped form.
const X int = iota

func main() {
	_ = X
}
