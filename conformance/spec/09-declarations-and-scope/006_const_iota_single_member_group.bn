package "main"
import "pkg/builtins/testing"

// decl.const.iota: `iota` is recognized inside a grouped `const ( ... )` block
// regardless of member count -- the grouped form is what binds iota, not a
// minimum number of members. A SINGLE-member group binds iota = 0 (the plain
// counter form) and re-folds it in expression position (the `1 << iota` form).
// This is distinct from the non-grouped `const X = iota`, which is
// `undefined: iota` (005_err_iota_outside_group).
const (
	Solo int = iota
)

const (
	Flag uint = 1 << iota
)

const (
	Pi int = 3
)

func main() {
	var ok bool = true
	if Solo != 0 {
		ok = false
	}
	if Flag != 1 {
		ok = false
	}
	if Pi != 3 {
		ok = false
	}
	if ok {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
