package "main"

// decl.const: a grouped `const ( ... )` block is permitted inside a function
// body, not only at package scope (mirroring Go; §9.1 does not restrict const
// groups to top level). Each member is defined into the function scope, and
// iota binds within the group.
//
// XFAIL: func-local grouped const is currently unsupported -- the statement-
// level decl handling (check_stmt + IR-gen gen_stmt) routes only DECL_CONST /
// DECL_VAR, not DECL_GROUP, so the group's members are never defined
// ("undefined: <name>"). See claude-todo.md (func-local grouped const).
func main() {
	const (
		A int = iota
		B
		C
	)
	const (
		Two int = 2
	)
	var ok bool = true
	if A != 0 {
		ok = false
	}
	if B != 1 {
		ok = false
	}
	if C != 2 {
		ok = false
	}
	if Two != 2 {
		ok = false
	}
	if ok {
		println("ok")
	} else {
		println("FAIL")
	}
}
