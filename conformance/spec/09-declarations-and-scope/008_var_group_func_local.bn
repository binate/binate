package "main"
import "pkg/builtins/testing"

// decl.var: a grouped `var ( ... )` block is permitted inside a function body,
// not only at package scope (mirroring Go). Each member is defined into the
// function scope and materialized as a local, including a member whose
// initializer references an earlier member of the same group.
func main() {
	var (
		a int = 1
		b int = 2
		c int = a + b
	)
	if a == 1 && b == 2 && c == 3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
