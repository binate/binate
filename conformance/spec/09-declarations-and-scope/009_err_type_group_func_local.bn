package "main"

// decl.type: type declarations must be at package level, not inside a function
// body (Binate disallows func-local type decls entirely). A grouped
// `type ( ... )` inside a function is rejected the same as a single
// non-grouped `type A int` would be -- routing the statement-level DECL_GROUP
// through the group checker preserves that rejection rather than silently
// accepting it.
func main() {
	type (
		A int
		B int
	)
	var x A = 5
	_ = x
}
