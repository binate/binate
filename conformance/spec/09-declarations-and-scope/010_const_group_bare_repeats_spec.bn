package "main"

import "pkg/builtins/testing"

// decl.const.iota: a bare member repeats the previous explicit member's type
// and initializer.  An explicit member without a type is untyped, and so are
// the bare members repeating it (D is the untyped 150, not a wrapped uint8);
// the value is the same wherever it is used, a const or an array length.

const (
	A uint8 = 1
	B = 200
	C = (B + 100) / 2
	D
)

const (
	E uint8 = 1
	F = 1000
	G = F - 1000 + iota
	H
)

func main() {
	var arr [D]int
	testing.Println(C, D, len(arr), G, H)
	testing.Println(cast(int, A), cast(int, E))
}
