package "main"

import "pkg/builtins/testing"

// decl.scope.shadow: a constant expression names the innermost declaration —
// a local variable (not a constant) or a local constant shadowing a package
// constant, in a switch case and in a const group's repeated initializer.

const K = 5
const N = 3

func pick(x int) int {
	var N int = x * 2
	switch x + x {
	case N:
		return 1
	default:
		return 0
	}
}

func local() int {
	const K = 7
	const (
		X = K * iota
		Y
	)
	switch 7 {
	case K:
		return X + Y
	}
	return -1
}

func grouped() int {
	const (
		N = 7
	)
	var x int = N
	return x
}

func main() {
	testing.Println(pick(5), local(), K, N, grouped())
}
