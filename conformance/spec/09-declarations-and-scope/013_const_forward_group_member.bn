package "main"

import "pkg/builtins/testing"

// decl.const.iota: a constant may name a const-group member declared later in
// the package — its value is the member's, including a bare member's value at
// its own iota — in a const, another group, and an array length.

const X uint8 = G1 + 100

const (
	G0 = 100 + iota
	G1
)

const (
	A = B1 * iota
	A1
	A2
)

const (
	B0 = 5 + iota
	B1
)

func main() {
	var arr [A2]int
	testing.Println(cast(int, X), A, A1, A2, len(arr))
}
