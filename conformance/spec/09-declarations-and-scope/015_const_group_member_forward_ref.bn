package "main"

import "pkg/builtins/testing"

// decl.order.forward: a const-group member may name a member declared later
// in its group, whatever that member's initializer; a bare member repeating
// such an initializer gets the later member's value too.

const (
	A = B + 1
	B = C * 2
	C = 3
)

const (
	P uint8 = S + iota
	Q
	R
	S = 10
)

func main() {
	testing.Println(A, B, C, cast(int, P), cast(int, Q), cast(int, R))
}
