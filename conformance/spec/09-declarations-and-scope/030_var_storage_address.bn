package "main"
import "pkg/builtins/testing"

// decl.var: a var binds a name to storage that has an address. `&x` yields
// `*int`, and writing through that pointer mutates the variable's storage --
// proving x is a real memory location, not a value-only binding. Reading
// through the address sees the current value.
func main() {
	var ok bool = true

	var x int = 5
	var p *int = &x        // address-of a var -> *int
	*p = 99                // write through the address mutates x's storage
	if x != 99 { ok = false }

	var y int = 7
	var q *int = &y
	if *q != 7 { ok = false }   // read through the address sees the value
	*q = *q + 1
	if y != 8 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
