package "main"

// decl.var.zero-init: a var declared without an initializer is zeroed --
// numeric to 0, bool to false. We first dirty the stack via a helper that
// writes nonzero locals and returns, so the later no-init slots genuinely
// require a zero-store rather than happening to find a clean stack.
func dirty() int {
	var a int = 111
	var b int = 222
	var c int = 333
	return a + b + c
}

func main() {
	var ok bool = true

	var sink int = dirty()
	if sink == 0 { ok = false }   // ensure dirty() actually ran

	var i int                     // numeric -> 0
	if i != 0 { ok = false }
	var b bool                    // bool -> false
	if b { ok = false }
	var fl float64                // float -> 0.0
	if fl != 0.0 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
