package "main"
import "pkg/builtins/testing"

// decl.var.zero-init: a no-init managed pointer `@T` is zeroed to nil, so
// present() is false. We dirty the slot first by returning a live @Node from
// a helper, then a fresh no-init `var m @Node` must read as not-present.
type Node struct { v int }

func dirty() @Node {
	var n @Node = make(Node)
	n.v = 42
	return n
}

func main() {
	var ok bool = true

	var keep @Node = dirty()
	if !present(keep) { ok = false }
	if keep.v != 42 { ok = false }

	var m @Node            // managed @T -> nil
	if present(m) { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
