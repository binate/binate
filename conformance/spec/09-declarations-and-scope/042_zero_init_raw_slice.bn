package "main"

// decl.var.zero-init: a no-init raw slice `*[]T` is zeroed to the empty
// (no-backing) value, whose len is 0. The stack is dirtied first so the slot
// is not incidentally clean.
func dirty() int {
	var a int = 7
	var b int = 9
	return a + b
}

func main() {
	var ok bool = true

	var sink int = dirty()
	if sink == 0 { ok = false }

	var s *[]int          // raw slice -> empty, len 0
	if len(s) != 0 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
