package "main"
import "pkg/builtins/testing"

// decl.var.zero-init: a no-init struct is zeroed field-wise -- each field gets
// its own zero value (int 0, bool false, and a `*T` field zeroed). The stack
// is dirtied via a helper that returns a populated struct first.
type S struct { a int; b bool; c *int }

func dirty() S {
	var z S
	z.a = 5
	z.b = true
	return z
}

func main() {
	var ok bool = true

	var d S = dirty()
	if d.a != 5 { ok = false }
	if !d.b { ok = false }

	var z S               // struct -> a:0, b:false (field-wise zero)
	if z.a != 0 { ok = false }
	if z.b { ok = false }
	if present(z.c) { ok = false }   // the *T field is zeroed to nil too

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
