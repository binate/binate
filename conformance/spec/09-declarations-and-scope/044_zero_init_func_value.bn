package "main"
import "pkg/builtins/testing"

// decl.var.zero-init: a no-init function value `*func()` is zeroed to nil, so
// present() is false. The slot is dirtied first by returning a live function
// value from a helper.
func helper() { }

func dirtyfn() *func() {
	var g *func() = helper
	return g
}

func main() {
	var ok bool = true

	var k *func() = dirtyfn()
	if !present(k) { ok = false }

	var fn *func()        // function value -> nil
	if present(fn) { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
