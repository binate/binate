package "main"
import "pkg/builtins/testing"

// decl.var.zero-init: a bare no-init raw pointer `var p *T` must be zeroed to
// nil, so present(p) is false. We dirty the stack with a helper that leaves
// pointers in the slots so a genuine zero-store is required.
func dirty() int {
	var a int = 123
	var pa *int = &a
	var b int = 456
	var pb *int = &b
	return *pa + *pb
}

func main() {
	var ok bool = true

	var sink int = dirty()
	if sink == 0 { ok = false }

	var p *int            // raw pointer -> nil (must NOT be present)
	if present(p) { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
