package "main"

// decl.var.zero-init: a bare no-init raw pointer `var p *T` must be zeroed to
// nil, so present(p) is false. We dirty the stack with a helper that leaves
// pointers in the slots so a genuine zero-store is required.
//
// This SHOULD print "ok". It currently prints "FAIL": the bare raw-pointer
// zero-init is omitted when the stack slot is dirty, so present(p) reads the
// stale (non-nil) garbage (claude-todo MAJOR, raw-pointer zero-init bug;
// likely LLVM-only -- the VM zeroes -- hence a per-mode xfail).
func dirty() int {
	var a int = 123
	var pa *int = &a
	var b int = 456
	var pb *int = &b
	return *pa + *pb
}

func main() {
	var ok bool = true

	var sink int = dirty()
	if sink == 0 { ok = false }

	var p *int            // raw pointer -> nil (must NOT be present)
	if present(p) { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
