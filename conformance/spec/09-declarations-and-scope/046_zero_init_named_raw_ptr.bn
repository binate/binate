package "main"

// decl.var.zero-init: a bare no-init local of a NAMED distinct raw-pointer type
// (`type P *int`) must be zeroed to nil, so present(p) is false. The named form
// takes a different LLVM lowering path than a plain `*int` (EmitConstNil with the
// un-peeled named type routes through the aggregate-zero path), so it is pinned
// separately. dirty() leaves several stale pointers on the stack so a genuine
// zero-store is required.
type P *int

func dirty() int {
	var a int = 11
	var pa *int = &a
	var b int = 22
	var pb *int = &b
	var c int = 33
	var pc *int = &c
	return *pa + *pb + *pc
}

func main() {
	var ok bool = true
	var sink int = dirty()
	if sink == 0 { ok = false }
	var p P            // named raw pointer -> nil
	if present(p) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
