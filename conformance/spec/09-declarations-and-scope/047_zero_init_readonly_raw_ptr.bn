package "main"
import "pkg/builtins/testing"

// decl.var.zero-init: a bare no-init readonly raw pointer (`var p *readonly int`)
// must be zeroed to nil, so present(p) is false. dirty() leaves several stale
// pointers on the stack so a genuine zero-store is required.
func dirty() int {
	var a int = 11
	var pa *int = &a
	var b int = 22
	var pb *int = &b
	var c int = 33
	var pc *int = &c
	return *pa + *pb + *pc
}

func main() {
	var ok bool = true
	var sink int = dirty()
	if sink == 0 { ok = false }
	var p *readonly int   // readonly raw pointer -> nil
	if present(p) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
