package "main"

// decl.var.redeclare (Constraint, negative): declaring with `var` a name
// already declared in the SAME block is an error. The rule-satisfying neighbor
// (a single `var x` followed by an assignment `x = 2`) compiles; the second
// `var x` here does not.

func main() {
	var x int = 1
	var x int = 2
	_ = x
}
