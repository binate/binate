package "main"

import "pkg/builtins/testing"

// decl.scope.shadow: a member of a const group in an inner block shadows an
// outer name — a variable or a constant — within that block only, whatever
// the constant's kind.

func vars() {
	var F float64 = 9.5
	var B bool = false
	var N int = 55
	{
		const (
			F = 1.5
			B = true
			N = 1
		)
		testing.Println(cast(int, F * 2.0), B, N)
	}
	testing.Println(cast(int, F * 2.0), B, N)
}

func consts() int {
	const (
		N = 1
		F = 0.25
	)
	var r int = N
	{
		const (
			N = 20
			F = 4.0
		)
		r = r + N + cast(int, F)
	}
	return r + N + cast(int, F * 4.0)
}

func main() {
	vars()
	testing.Println(consts())
}
