package "main"

import "pkg/builtins/testing"

// decl.scope.shadow: a local constant, single or in a group, is read as its
// own untyped value wherever it is used — a float32 parameter, result or
// field narrows it — and its name is in scope in a function literal of its
// block.  A constant's initializer names the constants in scope at its
// declaration, not a later local of the same name (nor the constant itself).

const PA = 1.5
const PB = PA * 2.0

type P struct {
	f float32
}

func f32(x float32) float32 {
	return x * 2.0
}

func ret32() float32 {
	const (
		X = 0.25
	)
	return X
}

func narrowing() {
	const Third = 1.0 / 3.0
	const (
		Half = 0.5
		Q    = 0.75
	)
	var p P = P{f: Q}
	testing.Println(f32(Third), f32(Half), ret32(), p.f)
}

func selfRef() {
	const F = 1.5
	{
		const (
			F = F * 2.0
			M = F / 4.0
		)
		testing.Println(F, M)
	}
	testing.Println(F)
}

func packageExprInScope() {
	const PA = 100.0
	testing.Println(PB, PA)
}

func closure() @func() int {
	const QQ = 0.5
	{
		const (
			QQ = 0.25
		)
		return func() int { return cast(int, QQ * 100.0) }
	}
}

func main() {
	narrowing()
	selfRef()
	packageExprInScope()
	testing.Println(closure()())
}
