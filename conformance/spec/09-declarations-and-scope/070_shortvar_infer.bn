package "main"

// decl.shortvar (§9.3): `:=` declares variables with types inferred from the
// right-hand side's default type. Each inferred name is then usable exactly as
// its inferred type -- `x` infers int (so `x + 5` is int arithmetic), `f`
// infers float64 (so `f * 2.0` is float arithmetic), `c` infers char (char arithmetic), `b`
// infers bool from a comparison.
func main() {
	var ok bool = true

	x := 10           // infers int
	if x+5 != 15 { ok = false }

	f := 1.5          // infers float64
	if f*2.0 != 3.0 { ok = false }

	c := 'a'          // infers char
	if c + 1 != 'b' { ok = false }   // char arithmetic: 'a'+1 == 'b'

	b := true         // infers bool
	if !b { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
