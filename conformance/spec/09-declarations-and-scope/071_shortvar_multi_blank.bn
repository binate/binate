package "main"

// decl.shortvar (§9.3): a multi-valued right-hand side (a single call returning
// several values) distributes positionally to the left-hand names. A blank `_`
// on the left is skipped -- no name is bound -- but the corresponding right-hand
// value is still EVALUATED. `bump` increments a package counter as its side
// effect, so a discarded `_ := bump()` still advances the counter.

var counter int = 0

func bump() int { counter = counter + 1; return counter }

func three() (int, int, int) { return 1, 2, 3 }

func main() {
	var ok bool = true

	a, b, c := three()        // positional distribution
	if !(a == 1 && b == 2 && c == 3) { ok = false }

	p, _, r := three()        // blank in the middle is skipped
	if !(p == 1 && r == 3) { ok = false }

	_ := bump()               // RHS still evaluated despite the blank
	if counter != 1 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
