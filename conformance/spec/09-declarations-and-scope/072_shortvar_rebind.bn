package "main"

// decl.shortvar.no-new-name-rule (§9.3): unlike Go, `:=` does NOT require that
// at least one name on the left be new. Re-using a name already bound in the
// same scope REBINDS it rather than being a "no new variables on left side of
// :=" error -- every name here already exists at the second `:=`, yet it
// compiles and the rebind takes effect. (The `var`-form redeclaration error of
// decl.var.redeclare does not apply to `:=`.)
func main() {
	x := 1
	y := 10
	x := 2        // pure rebind: x already exists, no new name -- Go would reject
	y := 20       // likewise y
	if x == 2 && y == 20 { println("ok") } else { println("FAIL") }
}
