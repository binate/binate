package "main"

// decl.shortvar.no-new-name-rule (§9.3) -- boundary: because a re-used `:=`
// name is genuinely REDECLARED (not assigned-to), the rebind may give the name
// a DIFFERENT inferred type than its prior binding. Here `v` is first inferred
// int, then rebound to bool; the second binding wins and `v` is usable as a
// bool. A plain assignment `v = true` would instead be a type error, so this
// distinguishes :=-rebind from assignment.
func main() {
	v := 1        // v : int
	v := true     // rebind v : bool (new declaration, new type)
	if v { println("ok") } else { println("FAIL") }
}
