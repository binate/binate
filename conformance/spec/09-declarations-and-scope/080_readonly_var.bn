package "main"

// decl.readonly.var (§9.4): `var x readonly T = ...` has storage and an address
// (`&x` -> `*readonly T`) and is readable, but is not writable through x. Unlike
// `const` it can hold a NON-scalar value -- here a struct -- which is the whole
// point of readonly storage. This test exercises only the readable / addressable
// side; the not-writable side is the negative 081.
type Pt struct { x int; y int }

func main() {
	var ok bool = true

	var a readonly int = 5
	if a != 5 { ok = false }            // readable
	pa := &a                            // has an address (-> *readonly int)
	if *pa != 5 { ok = false }          // readable through the address

	var p readonly Pt = Pt{1, 2}        // non-scalar: const could not express this
	if !(p.x == 1 && p.y == 2) { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
