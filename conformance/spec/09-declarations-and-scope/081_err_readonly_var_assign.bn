package "main"

// decl.readonly.var (§9.4) -- the not-writable side: a `readonly` variable has
// storage but the value at its location is not writable through that variable.
// Reassigning it is rejected with `cannot assign to const-typed location`. The
// rule-satisfying neighbor -- dropping `readonly` so it is `var a int = 5` --
// compiles and allows `a = 6` (see 080 for the readable/addressable side).
func main() {
	var a readonly int = 5
	a = 6
	_ = a
}
