package "main"

// decl.readonly.param (§9.4): the OUTERMOST `readonly` on a parameter type is
// local discipline only -- it is NOT part of the function's signature and is
// ignored for function-value assignability. So a `func(x readonly int) int` is
// assignable to a plain `*func(int) int` value and callable through it; and,
// symmetrically, a plain-param function is assignable to a
// `*func(readonly int) int` value. Both directions match because the outermost
// readonly is erased from the signature.
func dbl(x readonly int) int { return x + x }

func plain(x int) int { return x + 1 }

func main() {
	var ok bool = true

	var fp *func(int) int = dbl          // readonly param -> plain signature value
	if fp(21) != 42 { ok = false }

	var gp *func(readonly int) int = plain   // plain param -> readonly-param value
	if gp(41) != 42 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
