package "main"

// decl.readonly.param (§9.4) -- the local-discipline side: although the
// outermost `readonly` on a parameter is erased from the signature, inside the
// body it still forbids reassigning the parameter. `x = 9` on a `readonly`
// parameter is rejected with `cannot assign to const-typed location`. The
// rule-satisfying neighbor -- dropping `readonly` so it is `func f(x int) int`
// -- compiles and allows `x = 9` in the body.
func f(x readonly int) int {
	x = 9
	return x
}

func main() { _ = f(1) }
