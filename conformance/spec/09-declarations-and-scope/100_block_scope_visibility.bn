package "main"
import "pkg/builtins/testing"

// decl.scope.block: the scope of a name declared in a block extends from its
// declaration to the end of the innermost enclosing block. Here a name declared
// in an inner block is visible within it; after the block closes, the same
// identifier is a fresh, independent declaration in the outer block (no clash).
func main() {
	var ok bool = true

	{
		var inner int = 5         // visible from here to the inner block's `}`
		if inner != 5 { ok = false }
	}

	// The inner `inner` is gone; this is a NEW outer-block declaration, so no
	// "redeclared" error -- the two never coexist.
	var inner int = 9
	if inner != 9 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
