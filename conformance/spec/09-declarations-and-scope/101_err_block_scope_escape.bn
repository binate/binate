package "main"

// decl.scope.block (boundary): a name declared in an inner block is NOT in
// scope after that block ends. Referencing it past the closing `}` is an
// `undefined` error -- the rule-satisfying neighbor references it WITHIN the
// block (see 100) and compiles.
func main() {
	{
		var inner int = 5
		_ = inner
	}
	_ = inner            // out of scope here: undefined
}
