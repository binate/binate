package "main"

// decl.scope.shadow: an inner declaration shadows an outer name (the inner one
// is in scope within the inner block; the outer is unchanged), and shadowing a
// predeclared universe TYPE name (`int`) with a variable is permitted and NOT
// diagnosed.
func main() {
	var ok bool = true

	var x int = 1
	{
		var x int = 2            // shadows the outer x within this block
		x = 99                   // mutate the INNER x; the outer must be unaffected
		if x != 99 { ok = false }
	}
	if x != 1 { ok = false }     // outer x is untouched by the inner shadow

	// Shadow the universe type name `int` with a local variable named `int`.
	var int int = 7
	if int != 7 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
