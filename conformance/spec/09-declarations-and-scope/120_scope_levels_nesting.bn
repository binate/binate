package "main"

// decl.scope.levels: the scope levels are universe (predeclared names) /
// package (top-level names visible throughout the package) / block (names in a
// function body or nested block). A package-scope name resolves anywhere in the
// package; a block decl shadows an outer block decl of the same name; and a
// predeclared universe type name (`bool`) is itself shadowable by a value.
var pkgValue int = 100

func readPkg() int { return pkgValue }

func main() {
	var ok bool = true

	var local int = readPkg()    // the package-scope name resolves in the body
	if local != 100 { ok = false }
	{
		var local int = 7        // block level shadows the outer block `local`
		if local != 7 { ok = false }
	}
	if local != 100 { ok = false }

	var bool int = 42            // shadow the universe scalar type name `bool`
	if bool != 42 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
