package "main"
import "pkg/builtins/testing"

// decl.scope.package-decls: at package scope the permitted declarations include
// type, const, var, function, and method declarations. This file exercises one
// of each kind together and confirms they cooperate.
type Point struct { x int; y int }

const Bias int = 1

var counter int = 41

func (p *Point) sum() int { return p.x + p.y }

func makePoint(a int, b int) Point { return Point{a, b} }

func main() {
	var ok bool = true
	var p Point = makePoint(Bias + 2, 4)   // const + func + type
	if p.sum() != 7 { ok = false }         // method
	if counter != 41 { ok = false }        // package var
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
