package "main"

// decl.scope.statement: each statement scopes the managed temporaries produced
// while evaluating it; such a temporary lives until the end of that statement
// and is then released (Ch.18). Here a managed `@Box` temporary is created,
// has a method called on it, and is fully consumed -- all within ONE statement
// -- and the value round-trips correctly (cited incidentally: the lifetime is
// not directly observable without leak instrumentation).
type Box struct { v int }

func (b *Box) get() int { return b.v }

func makeBox(n int) @Box {
	var b @Box = make(Box)
	b.v = n
	return b
}

func main() {
	var ok bool = true

	// The makeBox(...) result is a managed temporary scoped to this statement.
	if makeBox(7).get() != 7 { ok = false }

	// Same pattern bound first, to show the value itself is sound.
	var keep @Box = makeBox(5)
	if keep.get() != 5 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
