package "main"
import "pkg/builtins/testing"

// decl.order.forward (§9.8): declarations may appear in any order -- a function
// used before its declaration resolves through deferred validation, no prototype
// needed. `main` calls `later`, which is declared further down the file.

func main() {
	var v int = later()
	if v == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}

func later() int { return 42 }
