package "main"
import "pkg/builtins/testing"

// decl.order.forward (§9.8): forward references resolve for any kind of
// package-level name, not just functions -- `main` names a type `Pt` and a
// const `LIMIT` that are both declared after it.

func main() {
	var p Pt = Pt{LIMIT, LIMIT + 1}
	if p.x == 7 && p.y == 8 { testing.Println("ok") } else { testing.Println("FAIL") }
}

type Pt struct { x int; y int }

const LIMIT int = 7
