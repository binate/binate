package "main"

// decl.order.forward (§9.8): forward references chain transitively -- `a` is
// itself a forward reference from `main`, and `a` in turn forward-references `b`
// and `c`, all declared after the point of use.

func main() {
	var v int = a()
	if v == 30 { println("ok") } else { println("FAIL") }
}

func a() int { return b() + c() }
func b() int { return 10 }
func c() int { return 20 }
