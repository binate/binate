package "main"

// decl.order.forward (§9.8) -- boundary: a forward reference resolves only to a
// name that is actually declared SOMEWHERE in the package. `missing_callee` is
// never declared (no later decl), so deferred validation reports it as
// `undefined`. The rule-satisfying neighbor -- adding
// `func missing_callee() int { return 5 }` below the use -- compiles (150-152).

func main() {
	var v int = missing_callee()
	_ = v
}
