package "main"

// decl.order.init (§9.8): `init` is an ORDINARY function -- proven both ways in
// one program. It is NOT auto-called (so `log` is still 0 on entry to `main`),
// yet it is an ordinary callable name: calling `init()` explicitly runs its body
// and sets `log` to 99.

var log int = 0

func init() { log = 99 }

func main() {
	if log != 0 { println("FAIL"); return }   // not auto-called by startup
	init()                                      // ordinary call: runs the body
	if log == 99 { println("ok") } else { println("FAIL") }
}
