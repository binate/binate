package "main"
import "pkg/builtins/testing"

import "pkg/ext"

// decl.var.extern (§9.2): a `.bni` `var X T` with NO initializer declares an
// EXPORTED variable whose storage and initial value are provided by the
// package's `.bn` implementation -- a declaration, not a definition. main reads
// the exported ext.Counter across the package boundary; its value (42) comes
// from pkg/ext's .bn.
func main() {
	if ext.Counter == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}
