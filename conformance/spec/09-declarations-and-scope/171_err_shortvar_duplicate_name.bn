package "main"

import "pkg/builtins/testing"

// decl.shortvar.duplicate (§9.3): a non-blank name may appear at most once on
// the left of one short variable declaration — in the parallel form and in the
// multi-return form.  Each repeat is REJECTED.  The rule-satisfying neighbor
// (`_` repeated) compiles.

func two() (int, int) {
	return 1, 2
}

func main() {
	_, _ := two()
	a, a := 1, 2
	q, q := two()
	testing.Println(a + q)
}
