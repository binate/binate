package "main"

import "pkg/builtins/testing"

// A package-level variable whose type is inferred from its initializer may be
// named before its declaration — by another variable's initializer or by a
// function body — like any other package-level declaration.

func sum() int {
	var n int = 0
	for i := 0; i < len(nums); i++ {
		n = n + cast(int, nums[i])
	}
	return n + twice(base)
}

var nums = [3]int32{1, 2, 3}
var base = start + 1
var start = 4
var twice = func(x int) int {
	return x * 2
}

func main() {
	testing.Println(sum(), base, len(nums))
}
