package "main"

import "pkg/builtins/testing"

// A variable's type may not depend on itself.  a's initializer spells no type
// at its head, so its type depends on b's, which its array length needs; b's
// spells none either, so b's type depends on a's, which it names: a variable
// type cycle, whatever h takes.
type S struct {
	arr [3]int
}

func h(n int) S {
	var s S
	return s
}

var a = len([len(b)]int{})

var b = h(a).arr

func main() {
	testing.Println(a, len(b))
}
