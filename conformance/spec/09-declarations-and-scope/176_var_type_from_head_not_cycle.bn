package "main"

import "pkg/builtins/testing"

// a's initializer is a call, whose type is its function's result, known before
// its argument is checked: a's type does not depend on b's, so b's array length
// needs no type that depends on b, and neither type depends on itself.
func h(x [3]int) [3]int {
	var r [3]int
	r[0] = len(x)
	return r
}

var b = [len(a)]int{1, 2, 3}

var a = h(b)

func main() {
	testing.Println(len(b), a[0])
}
