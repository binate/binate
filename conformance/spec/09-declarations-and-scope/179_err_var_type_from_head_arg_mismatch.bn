package "main"

import "pkg/builtins/testing"

// Not a cycle: a's initializer is a call, whose type is h's result, [3]int,
// known before its argument is checked.  So b is a [3]int, which h's parameter
// then rejects.
func h(x [4]int) [3]int {
	var r [3]int
	return r
}

var b = [len(a)]int{1, 2, 3}

var a = h(b)

func main() {
	testing.Println(len(b), a[0])
}
