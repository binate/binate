package "main"

import "pkg/builtins/testing"

// v's array length needs only the type of pick's result, [3]int, known from
// pick's signature: the function literal reading v is an operand of the call,
// whose value the length does not need, so v's type does not depend on itself.
func pick(f @func() int) [3]int {
	var r [3]int
	r[0] = f()
	return r
}

var v [len(pick(func() int { return len(v) }))]int

func main() {
	testing.Println(len(v), pick(func() int { return len(v) + 1 })[0])
}
