package "main"

import "pkg/builtins/testing"

// decl.shortvar (§9.3): each name takes the right-hand value's default type, so a
// name bound to an untyped floating-point constant is a float64 -- also where its
// value is boxed into an interface value (testing.Println's arguments): a single
// binding, a parallel one, and a copy of such a name.
func main() {
	u := 2.5
	testing.Println(u)
	t, w := 1, 3.5
	testing.Println(t, w)
	v := w
	testing.Println(v)
	h := u / 2.0
	testing.Println(h)
}
