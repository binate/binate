package "main"

import "pkg/builtins/testing"

import "pkg/ext"
import "pkg/only"

// decl.var.extern.no-init: a `.bni` `var` only declares the variable, so one
// written with an initializer is rejected at its declaration: with a type (`var Y
// int = 5`), without one (`var Z = 6`), in a group (`W int = 1`), and in a package
// with no `.bn` files, whose `.bni` is all there is (`pkg/only`).  The
// rule-satisfying neighbor, a `.bni` `var X int` the `.bn` defines, is
// 170_var_extern.

func main() {
	testing.Println(ext.Y, ext.Z, ext.W, only.Q)
}
