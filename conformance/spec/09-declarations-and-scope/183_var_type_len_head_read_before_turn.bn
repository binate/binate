package "main"

import "pkg/builtins/testing"

// u's array length needs only the type of pick's result, [3]int: the function
// literal reading u is an operand of the call, checked once u has its type.  So u
// is a [3]int though z reads it before its turn, and w, whose length reads u, is a
// [3]int whichever is declared first.
func pick(f @func() int) [3]int {
	var r [3]int
	r[0] = f()
	return r
}

var z = u

var u = [len(pick(func() int { return len(u) }))]int{}

var w = [len(pick(func() int { return len(x) }))]int{}

var x = [len(w)]int{}

func main() {
	testing.Println(len(z), len(u), len(w), len(x))
}
