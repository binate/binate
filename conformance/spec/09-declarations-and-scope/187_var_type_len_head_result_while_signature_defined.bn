package "main"

import "pkg/builtins/testing"

// V's array length needs only f's result type, [3]int, though f's signature is
// being defined when V's length reads it: f's parameter is then a [3]int too.
func f(y [len(V)]int) [3]int {
	var r [3]int
	r[0] = len(y)
	return r
}

var V [len(f([3]int{}))]int

func main() {
	testing.Println(len(V), f(V)[0])
}
