package "main"

// An operand of `len` with no head at its start (a field of a call's result) needs
// the type of each variable it names, a function literal's body included: u's
// type depends on itself.
type S struct {
	arr [3]int
}

func h(f @func() int) S {
	var s S
	return s
}

var u [len(h(func() int { return len(u) }).arr)]int

func main() {}
