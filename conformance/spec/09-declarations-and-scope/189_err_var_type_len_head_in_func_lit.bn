package "main"

// An array length in a function literal's body, in a package variable's
// initializer, needs only pick's result's type: its operand is checked once x has
// its type, an int, and its error is reported.
type S struct {
	f int
}

func pick(f @func() int) [3]int {
	var r [3]int
	return r
}

func hs(f @func() int) S {
	var s S
	return s
}

var x = hs(func() int {
	var a [len(pick(func() int { var t bool = x; _ = t; return 0 }))]int
	return len(a)
}).f

func main() {}
