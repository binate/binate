package "main"

import "pkg/builtins/testing"

// An array length's operand in a function literal's body is checked later, in its
// block as it was there: w, declared before it, is the literal's local; y, declared
// after it, is not seen, so the operand reads the package's y.
type S struct {
	f int
}

func pick(f @func() int) [3]int {
	var r [3]int
	r[0] = f()
	return r
}

func hs(f @func() int) S {
	var s S
	s.f = f()
	return s
}

var y int = 7

var x = hs(func() int {
	w := 2
	var a [len(pick(func() int { return w + y }))]int
	y := true
	_ = y
	return len(a) + w
}).f

func main() {
	testing.Println(x, pick(func() int { return y })[0])
}
