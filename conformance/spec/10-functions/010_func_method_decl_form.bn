package "main"
import "pkg/builtins/testing"

// func.decl.form (§10.1): a function declaration is `func` name
// `(`params`)` results block; a method inserts a parenthesized
// receiver before the name (MethodDecl).  Both forms are declared
// here at PACKAGE SCOPE (the only place declarations may appear --
// there are no nested/local function declarations).  A free function
// `add`, a value-receiver method `(c Counter) Get`, and a pointer-
// receiver method `(c *Counter) Bumped` are each declared and then
// invoked from main to confirm the declared forms produce usable
// callables.

type Counter struct {
	n int
}

func (c Counter) Get() int {
	return c.n
}

func (c *Counter) Bumped(by int) int {
	return c.n + by
}

func add(a int, b int) int {
	return a + b
}

func main() {
	var c Counter = Counter{n: 10}
	if add(2, 3) == 5 && c.Get() == 10 && c.Bumped(5) == 15 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
