package "main"
import "pkg/builtins/testing"

// func.decl.form (constraint): functions are declared at PACKAGE SCOPE
// only -- there are no nested/local function DECLARATIONS.  A `func`
// appearing in expression/statement position inside a body is a
// function LITERAL (§10.10), which has no name; writing a *named*
// `func g()` inside main is therefore a syntax error (the parser, after
// `func`, expects `(` for a literal but finds the name `g`).  This
// program must fail to compile.

func main() {
	func g() int {
		return 1
	}
	testing.Println("unreached")
}
