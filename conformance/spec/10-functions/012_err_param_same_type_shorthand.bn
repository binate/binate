package "main"
import "pkg/builtins/testing"

// func.decl.params (constraint): each parameter is written name-before-
// type and is INDIVIDUALLY typed (`name Type`).  There is no same-type
// shorthand: `a, b int` is rejected -- after parameter `a` the parser
// expects a type but finds `,`.  This program must fail to compile.

func add(a, b int) int {
	return a + b
}

func main() {
	testing.Println(add(1, 2))
}
