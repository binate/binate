package "main"
import "pkg/builtins/testing"

// func.decl.params (constraint): duplicate parameter names in one
// signature are an error.  `f` declares two parameters both named `x`.
// This program must fail to compile.

func f(x int, x int) int {
	return x
}

func main() {
	testing.Println(f(1, 2))
}
