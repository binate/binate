package "main"

// func.sig.identity (§10.1): a signature's TYPE identity is determined
// solely by its ordered parameter types and ordered result types --
// parameter NAMES are not part of the type.  `sub` and `mul` have
// differently-named parameters (`a,b` vs `x,y`) but the SAME signature
// type `(int, int) int`.  This identity is shared by named function
// types and function-VALUE types: both functions are assignable to the
// named func-value type `Binop` AND to the bare `*func(int,int) int`,
// and calls through either spelling produce the function's result.

type Binop *func(int, int) int

func sub(a int, b int) int {
	return a - b
}

func mul(x int, y int) int {
	return x * y
}

func main() {
	// Differently-named params, same signature type: both fit Binop.
	var f Binop = sub
	var g Binop = mul
	// And both fit the bare (anonymous-param) func-value type.
	var h *func(int, int) int = sub
	if f(7, 4) == 3 && g(6, 7) == 42 && h(9, 2) == 7 {
		println("ok")
	} else {
		println("FAIL")
	}
}
