package "main"

import "pkg/lib"

// func.decl.bni-match (constraint, §10.1 / Ch.16): a free function
// declared in BOTH a package's .bni and its .bn must agree in parameter
// and result COUNTS and types.  pkg/lib's .bni declares `func calc(a
// int) int` (one parameter) but its .bn defines `func calc(a int, b
// int) int` (two parameters) -- a parameter-count mismatch.  An importer
// reads calc's signature from the .bni, so a divergent .bn would be
// miscalled; the compiler rejects the mismatch.  This program must fail
// to compile.
func main() {
	println(lib.calc(3))
}
