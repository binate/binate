package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// func.decl.bni-match (constraint, §10.1 / Ch.16): the .bn definition
// must match its .bni declaration in parameter TYPES, not just counts.
// pkg/lib's .bni declares `func calc(a int) int` but its .bn defines
// `func calc(a bool) int` -- a parameter-type mismatch at position 0.
// This program must fail to compile.
func main() {
	testing.Println(lib.calc(3))
}
