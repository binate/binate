package "main"

import "pkg/lib"

// func.decl.bni-match (positive) / func.sig.identity: a free function's
// .bni declaration and .bn definition must agree in parameter and
// result COUNTS and TYPES -- but parameter NAMES are not part of the
// signature type, so the .bni may name them `a, b` while the .bn names
// them `x, y`.  This agreement is accepted; the importer calls lib.calc
// and observes the expected result.
func main() {
	if lib.calc(20, 22) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
