package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// func.decl.bni-match (constraint, §10.1 / Ch.16): a free function in both
// a package's .bni and .bn must agree in parameter and RESULT counts and
// types. pkg/lib's .bni declares an int result but its .bn returns bool -- a result-type mismatch. An importer reads calc's RESULT shape from the .bni, so a
// divergent .bn would be mis-consumed; the compiler rejects the mismatch.
// This program must fail to compile.
func main() {
	testing.Println(lib.calc(3))
}
