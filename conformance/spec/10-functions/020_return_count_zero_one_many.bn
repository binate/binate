package "main"

// func.return.count: a signature has zero, one, or many results. Zero
// results omit the result clause; one result is written bare (`int`); a
// parenthesized SINGLE type `(int)` is EQUIVALENT to the bare form; many
// results are parenthesized `(int, int)`. Named return values are not a
// thing -- result positions name TYPES only. This positive test exercises
// all four shapes and confirms the parenthesized-single form behaves
// identically to the bare-single form.

// Zero results: no result clause.
func noResult(out *int) {
	*out = 7
}

// One result, bare form.
func oneBare(x int) int {
	return x + 1
}

// One result, parenthesized form -- equivalent to the bare form.
func oneParen(x int) (int) {
	return x + 1
}

// Many results, parenthesized.
func twoResults(x int) (int, int) {
	return x, x * 2
}

func main() {
	var sink int
	noResult(&sink)

	var a int = oneBare(10)
	var b int = oneParen(10)
	var p int
	var q int
	p, q = twoResults(5)

	if sink == 7 && a == 11 && b == 11 && a == b && p == 5 && q == 10 {
		println("ok")
	} else {
		println("FAIL")
	}
}
