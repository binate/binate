package "main"
import "pkg/builtins/testing"

// func.return.tail: for a function with MORE THAN ONE result, a single
// return expression that is itself a multi-result call whose result tuple
// matches in count and per-position type is a permitted tail form
// (`return f(...)`). Here `passThrough` forwards `divmod`'s (int, int)
// tuple directly, with no destructuring at the return site.

func divmod(a int, b int) (int, int) {
	return a / b, a % b
}

func passThrough(a int, b int) (int, int) {
	return divmod(a, b)
}

func main() {
	var q int
	var r int
	q, r = passThrough(17, 5)
	if q == 3 && r == 2 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
