package "main"

// func.destructure: a single multi-result call may be destructured into
// several targets, via short declaration (`a, b := f()`) or assignment to
// existing targets (`a, b = f()`). The result count must equal the number
// of targets. A blank `_` target DISCARDS its result, but the call is
// still evaluated (here the side-effecting `tick` bumps a counter through
// a captured pointer regardless of which slot is blanked).

func divmod(a int, b int) (int, int) {
	return a / b, a % b
}

func tick(counter *int, a int, b int) (int, int) {
	*counter = *counter + 1
	return a, b
}

func main() {
	// Short-declaration destructure.
	q, r := divmod(17, 5)

	// Assignment destructure into existing targets.
	var x int
	var y int
	x, y = divmod(20, 6)

	// Blank discards -- the call is still evaluated for its side effect.
	var n int = 0
	_, b := tick(&n, 100, 200)
	var c int
	_, c = tick(&n, 300, 400)

	if q == 3 && r == 2 && x == 3 && y == 2 && b == 200 && c == 400 && n == 2 {
		println("ok")
	} else {
		println("FAIL")
	}
}
