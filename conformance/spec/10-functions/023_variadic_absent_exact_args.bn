package "main"

// func.variadic.absent: Binate has NO variadic parameters and NO spread.
// Every parameter is exactly `name Type`; a call to a function with one or
// more parameters supplies an EXACT argument count -- no `...T` last
// parameter, no `...`-spread of a slice. This positive test confirms the
// ordinary fixed-arity call shape works for one-, two-, and three-param
// functions called with exactly that many arguments.

func one(a int) int {
	return a
}

func two(a int, b int) int {
	return a + b
}

func three(a int, b int, c int) int {
	return a + b + c
}

func main() {
	if one(5) == 5 && two(3, 4) == 7 && three(1, 2, 3) == 6 {
		println("ok")
	} else {
		println("FAIL")
	}
}
