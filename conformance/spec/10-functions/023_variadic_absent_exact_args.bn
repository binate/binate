package "main"

// func.call.apply: for a NON-variadic callee the argument count must EXACTLY
// equal the parameter count, and each argument must be assignable to its
// parameter. This positive test confirms the ordinary fixed-arity call shape
// works for one-, two-, and three-param functions called with exactly that
// many arguments. (Variadic `...T` binding is exercised separately.)

func one(a int) int {
	return a
}

func two(a int, b int) int {
	return a + b
}

func three(a int, b int, c int) int {
	return a + b + c
}

func main() {
	if one(5) == 5 && two(3, 4) == 7 && three(1, 2, 3) == 6 {
		println("ok")
	} else {
		println("FAIL")
	}
}
