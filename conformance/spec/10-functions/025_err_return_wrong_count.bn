package "main"

// func.return.stmt (constraint): for a function with N >= 1 results the
// return expression list must supply EXACTLY N expressions. `oneResult`
// has a single result but its `return 1, 2` supplies two -- a wrong-count
// error.

func oneResult(x int) int {
	return 1, 2
}

func main() {
	println(oneResult(0))
}
