package "main"
import "pkg/builtins/testing"

// func.return.stmt (constraint): a BARE `return` (no expression) is valid
// ONLY for a function with no results. `needsValue` has one result but its
// `return` carries no expression -- an error (it supplies zero of the one
// required result). This is the count==0 vs N>=1 boundary of the same rule.

func needsValue(x int) int {
	if x > 0 {
		return
	}
	return x
}

func main() {
	testing.Println(needsValue(1))
}
