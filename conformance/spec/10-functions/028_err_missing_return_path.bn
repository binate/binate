package "main"

// func.return.missing (constraint): a function with at least one result
// must terminate on EVERY control-flow path. Here the `if x > 0` branch
// returns, but the implicit else (fall-through past the `if`) reaches the
// end of the body with no return -- a path that does not terminate, so
// "missing return".

func maybe(x int) int {
	if x > 0 {
		return x
	}
	// Falls off the end on the x <= 0 path: missing return.
}

func main() {
	println(maybe(5))
}
