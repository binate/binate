package "main"

// func.variadic.absent (constraint side): a call to a function with one or
// more parameters requires an EXACT argument count -- there is no variadic
// last parameter to soak up extras. `take` declares two parameters; calling
// it with three arguments is a wrong-argument-count error. (The empty-param
// case is a separate, currently-defective rule -- see 032.)

func take(a int, b int) int {
	return a + b
}

func main() {
	println(take(1, 2, 3))
}
