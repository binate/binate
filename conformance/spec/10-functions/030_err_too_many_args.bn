package "main"
import "pkg/builtins/testing"

// func.call.apply: for a NON-variadic callee a wrong argument count is a
// "wrong number of arguments" error. `take` declares two parameters; calling
// it with three arguments is rejected -- there is no variadic last parameter
// here to soak up the extra. (The empty-param arity case is 032.)

func take(a int, b int) int {
	return a + b
}

func main() {
	testing.Println(take(1, 2, 3))
}
