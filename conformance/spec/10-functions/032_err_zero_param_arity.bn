package "main"

// func.variadic.absent: a call to a function requires an EXACT argument
// count -- there are no variadic parameters. A user function `f` with an
// EMPTY parameter list called WITH arguments (`f(1, 2)`) is a "too many
// arguments" error. The loose arity check is restricted to the variadic
// builtins print/println/panic (§15), which alone accept extra args; every
// other zero-param call with arguments is rejected.

func f() {
	println("hi")
}

func main() {
	f(1, 2)
}
