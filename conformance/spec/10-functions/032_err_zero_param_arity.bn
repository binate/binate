package "main"
import "pkg/builtins/testing"

// func.call.apply: an EMPTY parameter list requires exactly zero arguments,
// so a user function `f()` called WITH arguments (`f(1, 2)`) is a "too many
// arguments" error. The loose argument count is restricted to the predeclared
// heterogeneous forms print/testing.Println (§15.7), which alone accept extra args;
// every other zero-param call with arguments is rejected.

func f() {
	testing.Println("hi")
}

func main() {
	f(1, 2)
}
