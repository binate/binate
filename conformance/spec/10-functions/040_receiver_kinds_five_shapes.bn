package "main"

// func.method.receiver-kinds: a method receiver takes exactly one of FIVE
// kinds -- value `T`, raw `*T`, raw read-only `*readonly T`, managed `@T`,
// and managed read-only `@readonly T`. The value form may also be spelled
// `readonly T` (accepted, redundant with `T`). This declares one method per
// shape on distinct base types and dispatches each DIRECTLY (static dispatch,
// no interface) so every receiver shape is shown to parse AND be callable.

type A struct { x int }
func (a A) get() int { return a.x }                 // value receiver

type B struct { x int }
func (b *B) get() int { return b.x }                // raw receiver

type C struct { x int }
func (c *readonly C) get() int { return c.x }       // raw read-only receiver

type D struct { x int }
func (d @D) get() int { return d.x }                // managed receiver

type E struct { x int }
func (e @readonly E) get() int { return e.x }       // managed read-only receiver

type F struct { x int }
func (f readonly F) get() int { return f.x }        // `readonly T` value form

func main() {
	var a A
	a.x = 1
	var b B
	b.x = 2
	var pb *B = &b
	var c C
	c.x = 3
	var pc *readonly C = &c
	var d @D = make(D)
	d.x = 4
	var e @E = make(E)
	e.x = 5
	var f F
	f.x = 6

	if a.get() == 1 && pb.get() == 2 && pc.get() == 3 &&
			d.get() == 4 && e.get() == 5 && f.get() == 6 {
		println("ok")
	} else {
		println("FAIL")
	}
}
