package "main"

// func.method.receiver-base (Constraint): a method's receiver base must be a
// NAMED type declared in this package. A type ALIAS is not a distinct named
// type, so it may not be a receiver base -- rejected at type check.
// (Mirrors conformance/324_err_method_alias.bn.)

type MyInt = int

func (m MyInt) get() int {
	return cast(m, int)
}

func main() {
	println("ignored")
}
