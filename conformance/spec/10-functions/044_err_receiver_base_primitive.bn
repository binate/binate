package "main"

// func.method.receiver-base (Constraint): predeclared / builtin types cannot be
// method receivers in an ordinary (non-`pkg/builtins/lang`) package. The single-
// file `main` package is NOT the lang carve-out, so declaring a method on the
// universe primitive `int` here must be REJECTED.
// (Mirrors conformance/325_err_method_builtin.bn and 11-interfaces/057.)

func (i int) foo() int {
	return i + 1
}

func main() {
	var a int = 1
	println(a.foo())
}
