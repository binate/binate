package "main"

import "pkg/widget"

// func.method.receiver-base (Constraint, §7.3/§10.4): a method's receiver base
// must be a named type declared in the SAME package as the method. `Widget` is
// defined in pkg/widget, so declaring a method on `*widget.Widget` here in main
// is rejected -- you cannot define methods on types imported from another
// package. (Mirrors 11-interfaces/058_err_method_foreign_type.)

func (w *widget.Widget) extra() int {
	return w.side + 1
}

func main() {
	var w widget.Widget
	w.side = 1
	println(w.extra())
}
