package "main"
import "pkg/builtins/testing"

// func.method.smoothing: at `x.M()` the receiver is smoothed ONE level in the
// safe (permissive -> restrictive) direction. This exercises every accepted
// direction:
//   - managed `@T` reaching a `*T` method  (managed -> raw; data ptr passed)
//   - value `T` reaching a `*T` method     (auto-take-address)
//   - raw `*T` reaching a value `T` method  (auto-deref)
//   - managed `@T` reaching a value `T` method (managed -> value)
//   - managed `@T` reaching a `@T` method   (exact)
// Each call's result is checked so smoothing is shown to lower correctly.

type P struct { x int; y int }

func (p *P) sumRaw() int { return p.x + p.y }      // raw receiver
func (p P) sumVal() int { return p.x + p.y }       // value receiver
func (p @P) sumMgd() int { return p.x + p.y }      // managed receiver

func main() {
	var v P
	v.x = 7
	v.y = 11

	var m @P = make(P)
	m.x = 7
	m.y = 11

	// value -> *T (auto-take-address); raw -> value (auto-deref):
	var pv *P = &v
	if v.sumRaw() == 18 && pv.sumVal() == 18 &&
			// managed -> raw, managed -> value, managed -> managed:
			m.sumRaw() == 18 && m.sumVal() == 18 && m.sumMgd() == 18 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
