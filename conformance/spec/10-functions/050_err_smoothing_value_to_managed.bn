package "main"
import "pkg/builtins/testing"

// func.method.smoothing (rejected direction): reaching a MANAGED `@T` receiver
// from a non-managed source is the one rejected indirection -- it would
// fabricate a reference count. Here `val` is declared on `@Node`, but the call
// site `v.val()` has a VALUE `Node`. value -> @T must be REJECTED at type check.

type Node struct { n int }

func (p @Node) val() int { return p.n }

func main() {
	var v Node
	v.n = 3
	testing.Println(v.val())
}
