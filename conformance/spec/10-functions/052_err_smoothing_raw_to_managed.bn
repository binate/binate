package "main"
import "pkg/builtins/testing"

// func.method.smoothing (rejected direction): a RAW `*T` cannot reach a managed
// `@T` receiver -- a raw pointer has no refcount header, so dispatching to a
// `@T` method would invent a reference count. Here `val` is declared on `@Node`,
// the call site `pp.val()` is a raw `*Node`. *T -> @T must be REJECTED.
// (Mirrors the unit test TestCheckMethodCallPointerOnManagedRejected.)

type Node struct { n int }

func (p @Node) val() int { return p.n }

func main() {
	var v Node
	v.n = 3
	var pp *Node = &v
	testing.Println(pp.val())
}
