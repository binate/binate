package "main"
import "pkg/builtins/testing"

// func.method.object-const (Constraint): dispatch keys off OBJECT read-only-ness.
// A read-only OBJECT (`*readonly Box`) may call ONLY read-only-receiver methods.
// `bump` is declared on the MUTABLE receiver `*Box`; calling it through a
// `*readonly Box` would DROP object-readonly (the rejected direction). Must be
// rejected at type check.

type Box struct { x int }

// `bump` wants a MUTABLE object.
func (b *Box) bump() int { b.x = b.x + 1; return b.x }

func main() {
	var v Box
	v.x = 1
	var rp *readonly Box = &v
	testing.Println(rp.bump())
}
