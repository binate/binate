package "main"
import "pkg/builtins/testing"

// func.method.object-const: dispatch keys off OBJECT read-only-ness, not HANDLE
// read-only-ness. Two accepted cases:
//   (1) a read-only OBJECT (`*readonly Box`) calling a read-only-receiver
//       method (`*readonly Box` receiver) -- an EXACT match that KEEPS
//       object-readonly (the mutable->readonly "adding" direction is a
//       separate safe case, not exercised here);
//   (2) a read-only HANDLE to a MUTABLE object (`readonly @Box`) calling a
//       MUTABLE-receiver method (`@Box` receiver) -- the handle being read-only
//       does NOT make the object const, so any method is callable.

type Box struct { x int }

func (b *readonly Box) peek() int { return b.x }     // read-only-receiver method
func (b @Box) bumpMgd() int { b.x = b.x + 1; return b.x }  // mutable managed recv

func main() {
	var v Box
	v.x = 5
	var rp *readonly Box = &v

	var m @Box = make(Box)
	m.x = 9
	var rh readonly @Box = m            // read-only HANDLE, mutable object

	if rp.peek() == 5 && rh.bumpMgd() == 10 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
