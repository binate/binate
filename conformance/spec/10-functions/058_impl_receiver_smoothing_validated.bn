package "main"
import "pkg/builtins/testing"

// func.method.impl-receiver (overlaps Ch.11): an `impl R : Iface` validates the
// impl's receiver kind against each method's declared receiver kind by the same
// safe-direction smoothing as a call. Here the interface method's required
// shape is reached from the impl receiver R by smoothing: R is `@Obj` and the
// `m` method is declared on the mutable raw `*Obj` receiver -- managed -> raw is
// the safe direction, so `impl @Obj : I` is accepted and dispatch works.

interface I {
	m() int
}

type Obj struct { k int }

// `m` is declared on the RAW receiver; the impl receiver below is MANAGED.
func (o *Obj) m() int { return o.k }

impl @Obj : I                        // @Obj smooths to the *Obj-receiver method

func main() {
	var o @Obj = make(Obj)
	o.k = 13
	var iv @I = o
	if iv.m() == 13 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
