package "main"

// func.method.one-per-name (Constraint): at most ONE method per (receiver base
// type, name) pair -- there is NO overloading on receiver kind. Declaring `m`
// twice on `Box` (once on value `Box`, once on raw `*Box`) is a duplicate and
// must be rejected, even though the receiver KINDS differ.
// (Mirrors conformance/326_err_method_duplicate.bn, sharpened to show that
// differing receiver kinds do NOT disambiguate.)

type Box struct { x int }

func (b Box) m() int { return b.x }

func (b *Box) m() int { return b.x + 1 }

func main() {
	println("ignored")
}
