package "main"
import "pkg/builtins/testing"

// func.method.auto-deref: the `.` operator auto-dereferences ONE pointer level
// (there is no `->`). `x.M()` resolves the receiver base by looking one level
// through a pointer/managed wrapper. Here a `*Point` calls a VALUE-receiver
// method (auto-deref) and a value `Point` calls a `*Point` method (auto-take-
// address) -- both via a single `.`.

type Point struct { x int; y int }

func (p Point) y_() int { return p.y }       // value receiver
func (p *Point) sum() int { return p.x + p.y }  // raw receiver

func main() {
	var p Point
	p.x = 7
	p.y = 11
	var pp *Point = &p

	// *Point . value-method  (auto-deref one level)
	// value . *Point-method  (auto-take-address one level)
	if pp.y_() == 11 && p.sum() == 18 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
