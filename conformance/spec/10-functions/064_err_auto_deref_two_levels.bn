package "main"

// func.method.auto-deref (one level only): `.` auto-dereferences exactly ONE
// pointer level and does NOT chase multi-level indirection. A `**Point`
// receiver expression calling a method declared on `*Point` (or value `Point`)
// reaches the base name `Point` (so the method is FOUND), but smoothing a
// two-level `**Point` to a one-level `*Point` receiver is not a safe single
// step -- it must be REJECTED. (receiverShape of `**Point` yields no named base
// because its inner is itself a pointer; receiverAssignable returns false.)

type Point struct { x int; y int }

func (p *Point) sum() int { return p.x + p.y }

func main() {
	var p Point
	p.x = 7
	p.y = 11
	var pp *Point = &p
	var ppp **Point = &pp
	println(ppp.sum())
}
