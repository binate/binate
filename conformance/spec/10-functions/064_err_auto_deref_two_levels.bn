package "main"
import "pkg/builtins/testing"

// func.method.auto-deref (one level only): `.` auto-dereferences exactly ONE
// pointer level and does NOT chase multi-level indirection. A `**Point`
// receiver expression has no methods: the lookup does not reach `Point` through
// two pointer levels, so calling the `*Point` method `sum` on it is REJECTED.

type Point struct { x int; y int }

func (p *Point) sum() int { return p.x + p.y }

func main() {
	var p Point
	p.x = 7
	p.y = 11
	var pp *Point = &p
	var ppp **Point = &pp
	testing.Println(ppp.sum())
}
