package "main"
import "pkg/builtins/testing"

// func.method.value-recv: a value receiver `(r T)` receives a COPY of the
// object; the method operates on the copy and cannot affect the caller's
// value. `bumpCopy` mutates its receiver-local copy and returns the bumped
// value, but the caller's `c.n` is unchanged afterward -- proving the copy is
// isolated. (This pins the SEMANTIC guarantee, which holds regardless of the
// known read-only-enforcement gap, see 068.)

type Counter struct { n int }

// Value receiver: mutates the COPY, returns it. Caller is unaffected.
func (c Counter) bumpCopy() int {
	c.n = c.n + 100
	return c.n
}

func main() {
	var c Counter
	c.n = 5
	var inside int = c.bumpCopy()   // 105 -- the copy was bumped
	// Caller's c.n is still 5: the receiver copy did not affect it.
	if inside == 105 && c.n == 5 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
