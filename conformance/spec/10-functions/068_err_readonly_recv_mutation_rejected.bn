package "main"

// func.method.value-recv (§10.6): a value receiver `(r T)` is a mutable copy, but
// read-only enforcement is OPT-IN via `(r readonly T)` -- under which any write
// through `r` is a compile error. `mutate` writes `c.n` through a `readonly` value
// receiver, so it must be rejected ("cannot assign to const-typed location"). The
// plain value-receiver form is a mutable, caller-isolated copy -- see 066.

type Counter struct { n int }

func (c readonly Counter) mutate() {
	c.n = c.n + 1
}

func main() {
	var c Counter
	c.mutate()
}
