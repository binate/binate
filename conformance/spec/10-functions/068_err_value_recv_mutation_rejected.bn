package "main"

// func.method.value-recv-readonly (§10.6 KNOWN GAP): the design intent is that a
// value receiver `(r T)` is READ-ONLY -- mutating a discarded copy is pointless,
// so `r.field = ...` in a value-receiver body SHOULD be rejected. The checker
// does NOT currently enforce this. This is the test the spec INTENDS; it is a
// predicted xfail until the gap closes. The body writes `c.n` through a value
// receiver, which should diagnose a write to a read-only object.

type Counter struct { n int }

func (c Counter) mutate() {
	c.n = c.n + 1
}

func main() {
	var c Counter
	c.n = 5
	c.mutate()
	println(c.n)
}
