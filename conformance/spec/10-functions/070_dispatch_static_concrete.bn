package "main"

// 10.7 func.dispatch.static: when the receiver's type is a statically-known
// concrete named type, a method call dispatches DIRECTLY to that type's method
// (no vtable, no interface value involved), with the smoothed receiver as the
// first argument. Here two unrelated concrete types each define `area()`; the
// calls go through concrete `Square`/`Box` variables (never an interface), so
// each call statically resolves to its own type's method. A pointer-receiver
// mutation is observed through the smoothed `&` to confirm the direct call
// reaches the real object.

type Square struct {
	s int
}

func (q *Square) area() int {
	return q.s * q.s
}

func (q *Square) grow(by int) {
	q.s = q.s + by
}

type Box struct {
	w int
	h int
}

func (b *Box) area() int {
	return b.w * b.h
}

func main() {
	var q Square
	q.s = 4
	var b Box
	b.w = 3
	b.h = 5

	// Static dispatch on concrete values: each resolves to its own type's area().
	var a1 int = q.area()    // Square.area -> 16
	var a2 int = b.area()    // Box.area    -> 15

	// Pointer-receiver mutation via value->&value smoothing reaches the object.
	q.grow(1)                // q.s now 5
	var a3 int = q.area()    // 25

	if a1 == 16 && a2 == 15 && a3 == 25 {
		println("ok")
	} else {
		println("FAIL")
	}
}
