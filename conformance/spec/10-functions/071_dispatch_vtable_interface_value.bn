package "main"

// 10.7 func.dispatch.vtable: when the receiver is an INTERFACE VALUE (*Iface),
// dispatch is dynamic -- the slot is resolved at compile time but the impl is
// loaded from the value's vtable at run time. ONE *Shape variable, reassigned
// from &sq to &bx, runs DIFFERENT area() impls at the SAME static call site:
// proof that the vtable (not a static call target) selects the impl. There is
// no receiver smoothing on this path (validated when the impl was declared).

interface Shape {
	area() int
}

type Square struct {
	s int
}

func (q *Square) area() int {
	return q.s * q.s
}

impl *Square : Shape

type Box struct {
	w int
	h int
}

func (b *Box) area() int {
	return b.w * b.h
}

impl *Box : Shape

func main() {
	var sq Square
	sq.s = 4
	var bx Box
	bx.w = 3
	bx.h = 5

	// One *Shape, two concrete impls, one call site -- vtable selects.
	var iv *Shape = &sq
	var r1 int = iv.area()    // Square.area -> 16
	iv = &bx
	var r2 int = iv.area()    // Box.area    -> 15

	if r1 == 16 && r2 == 15 {
		println("ok")
	} else {
		println("FAIL")
	}
}
