package "main"
import "pkg/builtins/testing"

// 10.7 func.dispatch.routing (precedence rule 1): a call `x.M(args)` whose
// selector resolves to a FUNCTION-VALUE-TYPED FIELD is an INDIRECT call -- a
// function-value field is never mistaken for a method. Here struct S has BOTH
// a method `op` (returns 1) AND a func-value field `op` (a closure returning
// 2). A field takes precedence over a same-named method (§7.3 / §13), so
// `s.op(...)` calls the FIELD (the closure), not the method. The method body
// returns a distinct value so that observing 2 (not 1) proves field routing.

type S struct {
	op *func(int) int
}

// A real method named `op` on S -- must NOT win against the same-named field.
func (s *S) op(x int) int {
	return 1
}

func main() {
	var s S
	s.op = func(x int) int {
		return 2
	}

	// s.op resolves to the FIELD (indirect call), returning 2, not the
	// method's 1.
	var r int = s.op(99)

	if r == 2 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
