package "main"

// 10.7 func.dispatch.routing: precedence rule (1) [func-value field = indirect
// call] and rule (3) [in-scope value head = static method call] side by side on
// the SAME struct with DISTINCT names. `apply` is a func-value FIELD: `s.apply(x)`
// is an INDIRECT call through the stored function value. `scale` is a METHOD:
// `s.scale(x)` is a STATIC method call. Distinct names (no collision) so the
// routing is unambiguous; the test confirms BOTH paths fire correctly from one
// struct, demonstrating that a func-value-typed field does not shadow or get
// confused with the type's real methods.

type S struct {
	k int
	apply *func(int) int
}

func (s *S) scale(x int) int {
	return s.k * x
}

func main() {
	var s S
	s.k = 3
	s.apply = func(x int) int {
		return x + 100
	}

	// Rule (1): func-value field -> indirect call.
	var a int = s.apply(5)    // 105
	// Rule (3): in-scope value head -> static method call.
	var b int = s.scale(5)    // 15

	if a == 105 && b == 15 {
		println("ok")
	} else {
		println("FAIL")
	}
}
