package "main"
import "pkg/builtins/testing"

// func.value.spelling (positive): a function-value type is written
// `*func(P...) R` (raw) or `@func(P...) R` (managed) -- parameters are
// types only (no names), a single result bare, multiple results
// parenthesized. This declares and exercises all four shapes: raw
// single-result, managed void, raw multi-result, and a no-param form.

func add(a int, b int) int { return a + b }
func swap(a int, b int) (int, int) { return b, a }
func noOp() {}
func fortyTwo() int { return 42 }

func main() {
	var f *func(int, int) int = add        // raw, single bare result
	var g @func() = noOp                    // managed, void
	var h *func(int, int) (int, int) = swap // raw, parenthesized multi-result
	var k @func() int = fortyTwo            // managed, no params
	var lo int
	var hi int
	lo, hi = h(3, 9)
	g()
	if f(2, 3) == 5 && k() == 42 && lo == 9 && hi == 3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
