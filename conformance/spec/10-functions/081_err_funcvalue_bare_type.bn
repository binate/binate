package "main"

// func.value.spelling (constraint): a bare `func(...)` is NOT a usable
// type -- the `*`/`@` prefix is mandatory, paralleling `*[]T`/`@[]T` and
// `*Iface`/`@Iface`. `var f func(int) int` must be rejected, directing
// the user to the pointer-shaped forms.

func add(a int, b int) int { return a + b }

func main() {
	var f func(int, int) int = add
	_ = f
}
