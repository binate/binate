package "main"

// func.value.repr: a function value is a two-word {vtable, data} value.
// Layout is informative; the OBSERVABLE here is that the value carries its
// target (the vtable/call shim) across copies/flow and dispatches correctly
// when called. The values are non-capturing references, so the data word is
// null throughout; this test exercises the vtable/target half (the value is
// copied into a second variable, passed through a function-value parameter,
// and stored in a struct field, and each call routes to the original target).
// Non-null-data (capturing) propagation is covered by the closure tests.

func triple(x int) int { return x * 3 }

func callIt(f *func(int) int, x int) int { return f(x) }

type Holder struct { Fn *func(int) int }

func main() {
	var a *func(int) int = triple
	var b *func(int) int = a       // copy the two-word value
	var viaParam int = callIt(b, 4)  // 12 -- value carried through a param slot
	var hld Holder
	hld.Fn = a                       // value stored in a field
	var viaField int = hld.Fn(5)     // 15
	if a(2) == 6 && b(2) == 6 && viaParam == 12 && viaField == 15 {
		println("ok")
	} else {
		println("FAIL")
	}
}
