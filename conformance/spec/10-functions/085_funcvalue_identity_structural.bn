package "main"

// func.value.identity (positive): two function-value types are identical
// iff same kind and structurally identical signature (equal param/result
// counts, pairwise-identical types; parameter NAMES are ignored). So a
// `*func(int, int) int` value flows freely among variables, parameters,
// and a same-signature field -- and `add` (declared with param names
// a,b) and `mul` both satisfy the unnamed-param func type. A second
// channel typed `*func(int) int` is a DIFFERENT type (different arity),
// proving identity is signature-driven, not just 'is a func value'.

func add(a int, b int) int { return a + b }
func mul(p int, q int) int { return p * q }
func inc(x int) int { return x + 1 }

func apply2(f *func(int, int) int, a int, b int) int { return f(a, b) }
func apply1(f *func(int) int, a int) int { return f(a) }

func main() {
	// Same kind + same signature (names differ) -> identical type.
	var f *func(int, int) int = add
	f = mul                          // reassign same-type channel
	var g *func(int) int = inc       // a structurally DIFFERENT func type
	if apply2(f, 3, 4) == 12 && apply2(add, 2, 5) == 7 && apply1(g, 9) == 10 {
		println("ok")
	} else {
		println("FAIL")
	}
}
