package "main"

// func.value.identity (constraint): `*func(...)` and `@func(...)` are
// NEVER identical even with the same signature -- they differ in KIND
// (raw vs managed). The reverse-direction assignment `*func -> @func`
// is rejected (it is also the func.value.smoothing constraint: only
// `@func -> *func` is the implicit borrow; never `*func -> @func`).

func add(a int, b int) int { return a + b }

func main() {
	var r *func(int, int) int = add
	var m @func(int, int) int = r   // *func -> @func: distinct kinds, rejected
	_ = m
}
