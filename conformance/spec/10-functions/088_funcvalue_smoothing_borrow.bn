package "main"

// func.value.smoothing (positive): a managed `@func(S)` is implicitly
// convertible to a raw `*func(S)` of identical signature -- a refcount-
// neutral borrow (the *func borrows the @func's record, owning nothing).
// Three borrow sites: assignment into a *func variable, passing an @func
// where a *func parameter is expected, and the @func still callable
// afterward (the borrow does not consume it).

func add(a int, b int) int { return a + b }

func useRaw(f *func(int, int) int, a int, b int) int { return f(a, b) }

func main() {
	var mg @func(int, int) int = add
	var rw *func(int, int) int = mg       // @func -> *func implicit borrow
	var viaParam int = useRaw(mg, 6, 7)   // @func arg into *func param (borrow)
	if rw(2, 3) == 5 && viaParam == 13 && mg(10, 1) == 11 {
		println("ok")            // mg still usable after being borrowed
	} else {
		println("FAIL")
	}
}
