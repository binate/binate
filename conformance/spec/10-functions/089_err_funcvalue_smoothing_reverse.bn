package "main"

// func.value.smoothing (constraint, reverse direction): the
// `*func -> @func` direction is NEVER implicit. A raw `*func` borrows;
// promoting it to a managed `@func` (which owns a record ref) would
// invent ownership over a record the raw value does not own. Rejected
// at compile time -- mirroring `*T -> @Iface` rejection.

func add(a int, b int) int { return a + b }

func useMgd(f @func(int, int) int, a int, b int) int { return f(a, b) }

func main() {
	var rw *func(int, int) int = add
	var viaParam int = useMgd(rw, 1, 2)   // *func arg into @func param: rejected
	_ = viaParam
}
