package "main"

// func.value.nillable: both func-value kinds are nillable for assignment;
// a nil func value is both words zero and is the DEFAULT for a func-value
// variable. Nil-ness is not testable with ==/!= (func.value.equality);
// use `present` (which reads the vtable word). A bare-declared func var
// is not-present (zero default); explicit `= nil` is likewise not-present;
// after assigning a function reference it becomes present. Both raw and
// managed kinds are covered.

func fortyTwo() int { return 42 }

func main() {
	// Bare-declared (default zero) -- not present.
	var bare @func() int
	// Explicit nil -- not present.
	var nilraw *func() int = nil
	// Assigned a function reference -- present.
	var setm @func() int = fortyTwo
	// Reassign a present var back to nil -- not present.
	var setr *func() int = fortyTwo
	setr = nil
	if !present(bare) && !present(nilraw) && present(setm) && !present(setr) {
		println("ok")
	} else {
		println("FAIL")
	}
}
