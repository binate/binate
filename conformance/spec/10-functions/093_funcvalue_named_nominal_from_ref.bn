package "main"
import "pkg/builtins/testing"

// func.value.named-nominal (positive): a named func-value type is a real,
// usable nominal type, CONSTRUCTED from a function REFERENCE (not a bound
// value, not a method expression). `type Fn @func(int) int; var f Fn = dbl`
// builds the value and it is callable. (The complementary nominal-
// DISTINCTNESS direction -- a bound @func value is NOT assignable into Fn
// -- is the negative 094.)

type Fn @func(int) int

func dbl(x int) int { return x * 2 }

func main() {
	var f Fn = dbl                 // construct named func-value type from a func reference
	if f(21) == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
