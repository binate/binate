package "main"

// func.value.named-nominal (constraint): a named func-value type is
// nominal -- an already-bound `@func` VALUE of the underlying type is NOT
// implicitly assignable into the distinct named type. It is constructible
// only from a function reference/literal, mirroring how a named scalar
// accepts an untyped literal but not a typed value of the underlying.

type Fn @func(int) int

func dbl(x int) int { return x * 2 }

func main() {
	var g @func(int) int = dbl
	var f Fn = g                  // bound @func value -> named Fn: rejected (nominal)
	println(f(21))
}
