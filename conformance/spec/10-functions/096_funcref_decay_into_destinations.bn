package "main"
import "pkg/builtins/testing"

// func.ref.decay: a reference to a named top-level function decays to a
// function value of matching signature, assignable to a *func or @func
// destination -- INCLUDING a named func-value type (`var f Fn = add`).
// The destination's alias/named wrappers are peeled for the match;
// parameter names are ignored. Here `add` decays into: a raw *func, a
// managed @func, and a named func-value type Fn -- all callable.

type Fn @func(int, int) int

func add(a int, b int) int { return a + b }

func main() {
	var raw *func(int, int) int = add    // decay into raw destination
	var mgd @func(int, int) int = add    // decay into managed destination
	var nm  Fn = add                     // decay into NAMED func-value type
	if raw(1, 2) == 3 && mgd(3, 4) == 7 && nm(5, 6) == 11 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
