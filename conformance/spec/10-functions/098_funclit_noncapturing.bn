package "main"

// func.lit.noncapturing: a function literal `func(P...) R { ... }` in
// expression position evaluates to a function value; a NON-capturing
// literal (referencing no enclosing local) carries a null data word and
// works in all execution modes. Here literals are bound to a *func var,
// a @func var, and passed inline as a *func argument -- none capture, so
// all are {vtable, null} values callable in every mode.

func apply(f *func(int) int, x int) int { return f(x) }

func main() {
	// Non-capturing literal into a raw var.
	var r *func(int) int = func(x int) int { return x + 1 }
	// Non-capturing literal into a managed var.
	var m @func(int) int = func(x int) int { return x * 2 }
	// Non-capturing literal passed inline as a *func arg.
	var viaArg int = apply(func(y int) int { return y + 100 }, 5)
	if r(7) == 8 && m(9) == 18 && viaArg == 105 {
		println("ok")
	} else {
		println("FAIL")
	}
}
