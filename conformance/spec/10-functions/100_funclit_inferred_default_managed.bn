package "main"

// func.lit.inferred-default: where no destination type is supplied, a
// function literal's (and a bare function reference's) default type is
// the MANAGED @func, mirroring the @[]T default. The DISCRIMINATING test
// is to assign the `:=`-inferred value into an @func destination: that
// succeeds only because the inferred kind IS @func (a @func source into a
// @func dest). If the default were the raw *func, this would be a
// *func -> @func assignment, which is rejected (func.value.smoothing
// reverse; 089). A bare function reference under := defaults the same way.

func dbl(x int) int { return x * 2 }

func main() {
	// Literal under := -- no destination -> default @func.
	lit := func(x int) int { return x + 3 }
	// Bare function reference under := -- default @func.
	ref := dbl
	// Assigning into an @func dest type-checks ONLY if the default is @func.
	var keepLit @func(int) int = lit
	var keepRef @func(int) int = ref
	if keepLit(1) == 4 && keepRef(6) == 12 {
		println("ok")
	} else {
		println("FAIL")
	}
}
