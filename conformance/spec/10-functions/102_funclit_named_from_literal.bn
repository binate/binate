package "main"
import "pkg/builtins/testing"

// func.lit.inferred-default / func.value.named-nominal: a NAMED func-value type
// is constructible from a function LITERAL (`var f Fn = func(...){...}`), not
// only from the function-REFERENCE form (`var f Fn = add`, test 093). The
// literal is hinted to the named type and lowers through the @func machinery;
// this pins that it constructs, calls, and returns the expected value.

type Fn @func(int) int

func main() {
	var f Fn = func(x int) int { return x * 3 }
	if f(14) == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
