package "main"

// func.lit.inferred-default / func.value.named-nominal (KNOWN GAP):
// constructing a NAMED func-value type from a function LITERAL
// (`var f Fn = func(...){...}`) is intended but NOT yet implemented --
// it is rejected in all modes. Only the function-REFERENCE form
// (`var f Fn = add`, test 093) works. This is the test the spec
// INTENDS to eventually pass; predicted xfail pending the literal-half
// fix (claude-todo.md B2).

type Fn @func(int) int

func main() {
	var f Fn = func(x int) int { return x * 3 }
	if f(14) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
