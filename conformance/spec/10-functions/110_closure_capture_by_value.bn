package "main"

// func.closure.capture: capture is ALWAYS by value -- a snapshot taken
// when the literal is evaluated. Writes to the captured name from OUTSIDE
// the closure, after construction, are NOT visible to the closure (it
// holds its own copy). Grounded in conformance/501_capture_value.bn.

func main() {
	var base int = 10
	var addBase *func(int) int = func(x int) int { return base + x }

	// Snapshot: addBase captured base=10.
	var before int = addBase(5)   // 15

	// Mutate the ORIGINAL after construction -- not visible to the closure.
	base = 100
	var after int = addBase(5)    // still 15 (snapshot of base=10)

	if before == 15 && after == 15 {
		println("ok")
	} else {
		println("FAIL")
	}
}
