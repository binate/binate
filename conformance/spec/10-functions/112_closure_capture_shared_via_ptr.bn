package "main"
import "pkg/builtins/testing"

// func.closure.capture (shared-state clause): "Shared mutable state is
// expressed by capturing a pointer" -- the POINTER is snapshotted, but the
// POINTEE is shared. So a write to *p after construction IS visible to the
// closure, because the body dereferences through the captured pointer.
// Grounded in conformance/508_capture_ptr_field.bn.

type Box struct { N int }

func main() {
	var b Box
	b.N = 7
	var p *Box = &b
	var read *func() int = func() int { return p.N }

	var first int = read()   // 7

	// Mutate the POINTEE after construction: visible through captured ptr.
	b.N = 42
	var second int = read()  // 42 (shared via pointer)

	if first == 7 && second == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
