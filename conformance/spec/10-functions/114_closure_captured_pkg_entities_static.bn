package "main"

// func.closure.captured: only ordinary LOCAL variables are captured.
// References to package-level functions, constants, and types are NOT
// captured (they are static entities) -- a closure that references a
// package func / const / type, plus one real local, captures only the
// local; the static references resolve statically (at compile time), not
// by capture. (This pins compile-acceptance + the local-capture result;
// the non-capture of the static entities is not separately observable.)

const K int = 100

type Box struct { N int }

func helper(x int) int { return x + 1 }

func main() {
	// `local` is captured (by value); helper (pkg func), K (pkg const),
	// and Box (pkg type) are referenced but NOT captured -- they resolve
	// statically. The closure is still a closure (it captures `local`).
	var local int = 5
	var f *func() int = func() int {
		var tmp Box        // pkg type, not captured
		tmp.N = local      // captured local
		return helper(tmp.N) + K   // pkg func + pkg const, not captured
	}
	// helper(5) = 6; +K(100) = 106.
	if f() == 106 {
		println("ok")
	} else {
		println("FAIL")
	}
}
