package "main"
import "pkg/builtins/testing"

// func.closure.captured (managed clause): a captured managed value (@T)
// acquires its OWN reference, released when the closure is destroyed.
// Pinned deterministically via refcounts: while the capturing @func is
// live, the captured @Counter's refcount is elevated; replacing the @func
// (dropping the old closure) releases that ref back to baseline.
// Grounded in conformance/550_func_value_capture_released.bn and 587.

import "pkg/builtins/rt"

type Counter struct {
	N int
}

func main() {
	var c @Counter = make(Counter)
	c.N = 7
	var p *uint8 = bit_cast(*uint8, c)

	var base int = rt.Refcount(p)            // 1: only main's c

	// Capturing @func over c: the closure acquires its own ref.
	var f @func() int = func() int { return c.N }
	var held int = rt.Refcount(p)            // 2: main's c + closure's ref

	var v int = f()                          // 7

	// Drop the closure (replace with a non-capturing @func): its dtor
	// releases the captured ref, back to baseline.
	var drop @func() int = func() int { return 0 }
	f = drop
	var after int = rt.Refcount(p)           // 1: baseline

	if base == 1 && held == 2 && v == 7 && after == 1 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
