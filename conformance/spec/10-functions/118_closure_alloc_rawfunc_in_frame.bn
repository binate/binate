package "main"
import "pkg/builtins/testing"

// func.closure.allocation (*func clause): a capturing *func literal
// stack-allocates its closure record in the enclosing frame; its lifetime
// is tied to that frame, and it is fully usable WITHIN the frame (called
// directly and passed as a *func argument). Grounded in 501/524.

func apply(f *func(int) int, x int) int {
	return f(x)
}

func main() {
	// Capturing *func, stack-alloc'd in main's frame, used in-frame.
	var base int = 100
	var f *func(int) int = func(x int) int { return base + x }
	var direct int = f(5)            // 105: direct in-frame call
	var viaArg int = apply(f, 7)     // 107: borrowed by *func param

	// A second distinct capturing *func in the same frame: independent
	// stack-alloc'd record.
	var mul int = 3
	var g *func(int) int = func(x int) int { return mul * x }
	var gv int = g(4)                // 12

	if direct == 105 && viaArg == 107 && gv == 12 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
