package "main"
import "pkg/builtins/testing"

// func.closure.allocation (@func clause): a capturing @func literal
// HEAP-allocates its closure record (reference-counted), so a @func
// returned from a function OUTLIVES the frame that built it and remains
// callable by the caller. (A capturing *func returned here would dangle --
// see func.closure.escape-lint, which warns on exactly this for *func.)
// Grounded in conformance/546_func_value_return_capturing.bn.

type Counter struct {
	N int
}

func makeAdder(c @Counter) @func(int) int {
	// Capturing @func over the managed @Counter; heap-allocated record
	// survives makeAdder's frame and is returned to the caller.
	return func(x int) int {
		c.N = c.N + x
		return c.N
	}
}

func main() {
	var c @Counter = make(Counter)
	var add @func(int) int = makeAdder(c)   // record outlives makeAdder
	var i int = 0
	for i = 0; i < 5; i = i + 1 {
		add(10)
	}
	// 5 increments of 10 through the captured @Counter.
	if c.N == 50 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
