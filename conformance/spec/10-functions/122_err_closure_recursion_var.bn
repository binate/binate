package "main"

// func.closure.recursion: a recursive ANONYMOUS closure via the
// single-binding `var` form is a HARD COMPILE ERROR -- `g` is not in scope
// within its own initializer, so the reference to `g` inside the literal is
// undefined. (Capture is by value, so even if it parsed it would snapshot a
// pre-binding value; the language rejects it outright. The idiom for
// recursion is a named top-level function.)

func main() {
	var g *func(int) int = func(n int) int {
		if n <= 0 {
			return 0
		}
		return n + g(n - 1)   // `g` not in scope inside its own initializer
	}
	_ = g
}
