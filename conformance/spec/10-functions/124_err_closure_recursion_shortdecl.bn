package "main"

// func.closure.recursion (`:=` short-declaration form): the short-decl
// single-binding form `g := func(){...g...}` is also a HARD COMPILE ERROR
// for the same reason -- `g` is not in scope within its own initializer.
// (Sibling of 122_err_closure_recursion_var, which uses the `var` form.)

func main() {
	g := func(n int) int {
		if n <= 0 {
			return 0
		}
		return n + g(n - 1)   // `g` not in scope inside its own initializer
	}
	_ = g
}
