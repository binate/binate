package "main"

// func.method-expr (§10.11): a method expression `T.M` is a function value
// whose signature is M's FULL signature INCLUDING the receiver as the first
// parameter (in M's declared receiver kind).  For a value-receiver method
// `func (c Counter) Add(x int) int`, `Counter.Add` has type
// `*func(Counter, int) int` -- the full receiver-first signature, bound here
// to a *func variable and applied with explicit receivers. (Method
// expressions are non-capturing; the struct-type form routed through a *func
// parameter is 131.)

type Counter struct {
	N int
}

func (c Counter) Add(x int) int {
	return c.N + x
}

func main() {
	var ok bool = true
	var c Counter = Counter{N: 10}

	// Method expression bound to a function-value local of the FULL
	// receiver-first signature.
	var f *func(Counter, int) int = Counter.Add
	if f(c, 5) != 15 { ok = false }

	// Direct invocation of the method expression: T.M(receiver, args).
	if Counter.Add(c, 100) != 110 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
