package "main"
import "pkg/builtins/testing"

// func.method-expr (§10.11): for a POINTER-receiver method
// `func (c *Counter) Bump(by int) int`, the method expression
// `Counter.Bump` carries the receiver in M's declared kind, so its type is
// `*func(*Counter, int) int` (receiver `*Counter` first).  Confirms the
// receiver appears in the function-value signature in its declared form.

type Counter struct {
	N int
}

func (c *Counter) Bump(by int) int {
	return c.N + by
}

func main() {
	var ok bool = true
	var c Counter = Counter{N: 10}

	var g *func(*Counter, int) int = Counter.Bump
	if g(&c, 3) != 13 { ok = false }

	// Direct invocation form with an explicit address-of receiver.
	if Counter.Bump(&c, 90) != 100 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
