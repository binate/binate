package "main"

// func.method-expr (§10.11): `T` may be a named-distinct SCALAR type (e.g.
// `type Celsius int`), and the method expression is a NON-CAPTURING function
// reference -- it carries no per-instance state, so it can be passed straight
// through a *func parameter and applied to different receivers.  `Celsius.Plus`
// has type `*func(Celsius, Celsius) Celsius` (full signature incl. receiver).

type Celsius int

func (t Celsius) Plus(d Celsius) Celsius {
	return cast(Celsius, cast(int, t) + cast(int, d))
}

// apply takes the method expression as a *func value -- if it captured
// anything this would not type as a bare reference.
func apply(f *func(Celsius, Celsius) Celsius, a Celsius, b Celsius) Celsius {
	return f(a, b)
}

func main() {
	var ok bool = true

	var r1 Celsius = apply(Celsius.Plus, cast(Celsius, 20), cast(Celsius, 5))
	if cast(int, r1) != 25 { ok = false }

	// Same non-capturing reference, different receivers -- no shared state.
	var r2 Celsius = apply(Celsius.Plus, cast(Celsius, 100), cast(Celsius, 1))
	if cast(int, r2) != 101 { ok = false }

	// Direct method-expression call: Celsius.Plus(a, b) applies the method
	// with the receiver passed as the first explicit argument.
	var r3 Celsius = Celsius.Plus(cast(Celsius, 7), cast(Celsius, 8))
	if cast(int, r3) != 15 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
