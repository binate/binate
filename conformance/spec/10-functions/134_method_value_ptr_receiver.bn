package "main"

// func.method-value (§10.11): a method value `x.M` is a function value whose
// signature is M's signature MINUS the receiver (captured at the selector
// site).  Its type is a raw `*func(args...) results`.  For
// `func (c *Counter) Add(x int) int`, `cp.Add` has type `*func(int) int`.
// func.method-value.capture: a `*T` receiver captures `&x`, so mutations to
// the pointee after the selector are visible through the method value.

type Counter struct {
	N int
}

func (c *Counter) Add(x int) int {
	return c.N + x
}

func main() {
	var ok bool = true
	var c Counter = Counter{N: 10}
	var cp *Counter = &c

	// Receiver-minus signature: *func(int) int, not *func(*Counter, int) int.
	var addCp *func(int) int = cp.Add
	if addCp(5) != 15 { ok = false }

	// *T receiver captured &c: a mutation to c after the selector IS visible.
	c.N = 100
	if addCp(7) != 107 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
