package "main"

// func.method-value (§10.11): the method value's type is a raw
// `*func(args...) results` EVEN WHEN the captured receiver is managed.
// func.method-value.capture: a `@T` receiver is captured as the managed
// pointer (reference-counted); the same heap object is shared, so field
// mutations remain visible and re-taking the value RefIncs independently.

type Counter struct { N int }

func (c @Counter) Sum(x int) int { return c.N + x }

func main() {
	var ok bool = true
	var c @Counter = make(Counter)
	c.N = 10

	// Receiver is managed (@Counter), but the method-value type is raw *func.
	var f *func(int) int = c.Sum
	if f(5) != 15 { ok = false }

	// Captured @Counter shares the heap object: later mutations are visible.
	c.N = 100
	if f(7) != 107 { ok = false }

	// Re-take to confirm independent RefInc bookkeeping across constructions.
	var g *func(int) int = c.Sum
	if g(1) != 101 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
