package "main"
import "pkg/builtins/testing"

// func.method-value (§10.11): a method value `x.M` requires that `x`'s base
// type has NO same-named field -- a field takes precedence over a same-named
// method (§7.3 type.struct.field-access, §13.8 expr.member).  Here `Box` has
// BOTH a field `M` (a function value) AND a method `M`; the selector `b.M`
// resolves to the FIELD, so calling `b.M(...)` invokes the stored function
// value, NOT the method.  The method would return 999; the field returns its
// argument doubled, so observing the doubling proves field precedence.

type Box struct {
	N int
	M *func(int) int
}

func (b Box) M(x int) int {
	return 999
}

func dbl(x int) int { return x + x }

func main() {
	var ok bool = true
	var b Box
	b.N = 0
	b.M = dbl

	// b.M resolves to the FIELD (a func value), not the method: 4+4 = 8.
	if b.M(4) != 8 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
