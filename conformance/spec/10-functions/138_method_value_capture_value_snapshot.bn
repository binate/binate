package "main"

// func.method-value.capture (§10.11): a VALUE receiver captures a COPY -- a
// snapshot taken at the selector site.  For `func (c Counter) Get() int`,
// `c.Get` snapshots c's value; mutating c afterward is NOT visible through
// the method value.  Contrast 134 (*T receiver, mutation visible).

type Counter struct {
	N int
}

func (c Counter) Get() int {
	return c.N
}

func main() {
	var ok bool = true
	var c Counter = Counter{N: 42}

	// Value receiver: c.Get snapshots c (N == 42).
	var f *func() int = c.Get
	if f() != 42 { ok = false }

	// Mutating c after the selector is NOT visible -- value-receiver snapshot.
	c.N = 999
	if f() != 42 { ok = false }

	if ok { println("ok") } else { println("FAIL") }
}
