package "main"
import "pkg/builtins/testing"

// func.method-value.capture (§10.11): a `*T` receiver captures `&x`, so
// mutations performed THROUGH the bound receiver are visible on x, and
// mutations to x are visible through the bound method value.  Uses a void
// mutating method to isolate the pointer-aliasing semantics: the method
// value writes back into the original object.

type Counter struct {
	N int
}

func (c *Counter) Bump(by int) {
	c.N = c.N + by
}

func main() {
	var ok bool = true
	var c Counter = Counter{N: 100}
	var cp *Counter = &c

	// *T receiver captured &c: a void mutating method value writes back
	// through the captured pointer, so c.N changes are observable directly.
	var bumpCp *func(int) = cp.Bump
	bumpCp(1)
	if c.N != 101 { ok = false }
	bumpCp(4)
	if c.N != 105 { ok = false }

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
