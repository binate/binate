package "main"
import "pkg/builtins/testing"

// func.value.equality: a function value CANNOT be compared with == against
// anything, INCLUDING nil. This differs from pointers (where `p == nil` is
// allowed). The sanctioned presence test is `present(fv)` (see 153). Here we
// expect a compile error on `f == nil`.

func add(a int, b int) int { return a + b }

func main() {
	var f *func(int, int) int = add
	if f == nil {
		testing.Println("bad")
	}
}
