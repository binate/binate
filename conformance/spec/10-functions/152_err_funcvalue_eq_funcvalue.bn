package "main"
import "pkg/builtins/testing"

// func.value.equality: function values cannot be compared with == against
// ANYTHING -- not just nil. Two function-value variables of identical type
// still cannot be compared to each other.

func add(a int, b int) int { return a + b }
func mul(a int, b int) int { return a * b }

func main() {
	var f *func(int, int) int = add
	var g *func(int, int) int = mul
	if f == g {
		testing.Println("bad")
	}
}
