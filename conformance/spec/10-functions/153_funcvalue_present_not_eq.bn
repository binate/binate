package "main"

// func.value.equality (positive companion to 150-152): the SANCTIONED way to
// test a function value's presence is `present(fv)`, NOT `== nil`. A nil func
// value is not present; an assigned one is. We assert both outcomes and print
// "ok" iff present() behaves as specified.

func fortyTwo() int { return 42 }

func main() {
	var unset @func() int = nil
	var set @func() int = fortyTwo
	if !present(unset) && present(set) {
		println("ok")
	} else {
		println("FAIL")
	}
}
