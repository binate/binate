package "main"

// func.value.indirect-call: calling THROUGH a function-value-typed variable
// invokes the function it holds; the callee signature comes from the
// function-value TYPE (not from a name). Here the same call site `f(...)` is
// reused after `f` is reassigned to a different held function, proving the
// dispatch follows the VALUE, not a statically-bound name.

func add(a int, b int) int { return a + b }
func sub(a int, b int) int { return a - b }

func main() {
	var f *func(int, int) int = add
	var r1 int = f(10, 3)   // 13, via add
	f = sub
	var r2 int = f(10, 3)   // 7, via sub
	if r1 == 13 && r2 == 7 {
		println("ok")
	} else {
		println("FAIL")
	}
}
