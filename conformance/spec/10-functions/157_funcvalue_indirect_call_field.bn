package "main"

// func.value.indirect-call: the callee may be a function-value-typed FIELD.
// Calling `op.Fn(...)` routes through the field's held function (ahead of any
// method dispatch -- there is no method named Fn). Mirrors the struct-field
// path in conformance/341_func_value_flow.bn and 531_func_value_struct_field.

type Op struct {
	Fn *func(int, int) int
}

func add(a int, b int) int { return a + b }

func main() {
	var op Op
	op.Fn = add
	var r int = op.Fn(3, 4)   // 7, through the field
	if r == 7 {
		println("ok")
	} else {
		println("FAIL")
	}
}
