package "main"

// func.value.indirect-call: the callee may be a function-value-typed ELEMENT
// of a slice. `fns[i](...)` routes through the element's held function. This
// covers the third callee shape the rule enumerates (variable, field,
// element).

func add(a int, b int) int { return a + b }
func sub(a int, b int) int { return a - b }

func main() {
	var fns @[]*func(int, int) int = make_slice(*func(int, int) int, 2)
	fns[0] = add
	fns[1] = sub
	var r0 int = fns[0](8, 5)   // 13
	var r1 int = fns[1](8, 5)   // 3
	if r0 == 13 && r1 == 3 {
		println("ok")
	} else {
		println("FAIL")
	}
}
