package "main"
import "pkg/builtins/testing"

// func.value.indirect-call: an indirect call works identically through a
// MANAGED function value (@func), including void and multi-arg shapes. The
// callee signature comes from the @func type. Mirrors the @func path in
// conformance/340_func_value_call.bn and 513_managed_func_value_noncapture.

func add3(a int, b int, c int) int { return a + b + c }

func main() {
	var f @func(int, int, int) int = add3
	var r int = f(1, 2, 3)   // 6
	if r == 6 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
