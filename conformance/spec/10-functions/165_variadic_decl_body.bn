package "main"
import "pkg/builtins/testing"

// func.variadic.decl: a variadic parameter `name ...T` has in-body type raw
// slice *[]T, so `len()` and indexing apply to it.  This declare-only test (`f`
// is never called) confirms that a variadic declaration type-checks and its body
// compiles end-to-end (checker resolves the param to *[]int; IR-gen derives the
// same).  The call-site pack is exercised separately, once implemented.

func f(xs ...int) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func main() {
	testing.Println("ok")
}
