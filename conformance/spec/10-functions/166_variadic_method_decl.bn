package "main"
import "pkg/builtins/testing"

// func.variadic.decl: a variadic parameter on a METHOD has in-body type raw
// slice *[]T, exactly as for a free function.  This exercises the method path
// (methodSig's *[]T derivation + IsVariadic, and the receiver-prepend preserving
// the last-param variadic flag).  Declare-only: `sum` is never called.

type Acc struct {
	base int
}

func (a *Acc) sum(xs ...int) int {
	var total int = a.base
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func main() {
	testing.Println("ok")
}
