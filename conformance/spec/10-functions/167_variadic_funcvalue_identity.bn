package "main"
import "pkg/builtins/testing"

// func.variadic.identity: a variadic func literal is assignable to a matching
// variadic func-value type `*func(...int) int`.  Exercises resolveFuncValueType
// (the `*func(...T)` type resolves its last param to *[]T + IsVariadic), the
// func-literal's own variadic type, and the assignability gate
// (funcSignaturesMatch compares variadic-ness).  Declare-only: the value is
// materialized but never called.

func main() {
	var _ *func(...int) int = func(xs ...int) int { return len(xs) }
	testing.Println("ok")
}
