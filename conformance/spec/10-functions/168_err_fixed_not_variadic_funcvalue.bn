package "main"
import "pkg/builtins/testing"

// func.variadic.identity: a FIXED func (raw-slice param `*[]int`) is NOT
// assignable to a variadic func-value type `*func(...int) int`.  Variadic-ness is
// part of a signature's type identity, so a `*func(*[]int) int` and a
// `*func(...int) int` are distinct types and the assignment is rejected.

func main() {
	var _ *func(...int) int = func(xs *[]int) int { return len(xs) }
	testing.Println("ok")
}
