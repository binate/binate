package "main"

// func.variadic.decl: a variadic element type may be `readonly T` — the
// element-readonly is part of the element type, so the in-body type is the raw
// slice *[]readonly char.  Declare-only: `f` is never called.

func f(xs ...readonly char) int {
	return len(xs)
}

func main() {
	println("ok")
}
