package "main"
import "pkg/builtins/testing"

// func.variadic.decl: a variadic element type may be a MANAGED pointer (`@T`).
// The in-body type is *[]@Foo — a raw slice of managed pointers, i.e. a borrow —
// so the callee neither acquires nor releases it.  Declare-only: `f` is never
// called (the managed-element caller-acquire discipline is a call-side concern).

type Foo struct {
	n int
}

func f(xs ...@Foo) int {
	return len(xs)
}

func main() {
	testing.Println("ok")
}
