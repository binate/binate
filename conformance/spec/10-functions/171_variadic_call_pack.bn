package "main"
import "pkg/builtins/testing"

// func.variadic.pack: a variadic call with INDIVIDUAL trailing arguments packs
// them into the *[]T the callee sees — a caller-side stack array, no heap
// allocation.  Covers the individual-arg pack, the empty case (len 0), mixed
// fixed+variadic, and an empty variadic tail after a fixed argument.

func sum(xs ...int) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func sumFrom(base int, xs ...int) int {
	var total int = base
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func main() {
	testing.Println(sum(1, 2, 3))       // 6
	testing.Println(sum())              // 0  (empty variadic -> len 0)
	testing.Println(sumFrom(10, 4, 5))  // 19
	testing.Println(sumFrom(100))       // 100 (empty variadic tail after a fixed arg)
}
