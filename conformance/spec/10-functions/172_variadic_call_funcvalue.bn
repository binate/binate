package "main"

// func.variadic.pack through a FUNCTION VALUE: a variadic call packs the same way
// at the indirect boundary — the caller packs the trailing args into the single
// *[]T BEFORE the indirection, so the shim/slot receives an ordinary raw slice
// (variadic-ness is erased to *[]T at the ABI; func.variadic.identity).

func sum(xs ...int) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func main() {
	var f *func(...int) int = sum
	println(f(2, 3, 4))  // 9
	println(f())         // 0
}
