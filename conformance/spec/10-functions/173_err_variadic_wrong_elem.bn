package "main"
import "pkg/builtins/testing"

// func.call.apply: each trailing argument of a variadic call must be assignable
// to the variadic parameter's element type T.  Passing a string where an int
// element is expected is a "cannot assign" error.

func sum(xs ...int) int {
	return len(xs)
}

func main() {
	testing.Println(sum(1, "two", 3))
}
