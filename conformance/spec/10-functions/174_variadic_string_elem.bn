package "main"

// func.variadic.pack with a char-slice element type (...*[]readonly char): a
// string-literal argument must be packed with its FULL slice header (data + len),
// not the bare OP_CONST_STRING data pointer.  With the bare pointer, len(xs[i])
// reads back 0 — silent wrong output.  So this must sum the actual lengths.

func totalLen(xs ...*[]readonly char) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + len(xs[i])
	}
	return total
}

func main() {
	println(totalLen("ab", "cde"))  // 2 + 3 = 5
}
