package "main"

// func.variadic.pack with a by-value STRUCT element type (...Point): a
// composite-literal argument returns its alloca POINTER, so the pack must LOAD
// the value before storing it into the aggregate-sized slot — otherwise the
// pointer bytes are stored and the callee reads garbage struct fields.

type Point struct {
	x int
	y int
}

func sumX(xs ...Point) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i].x
	}
	return total
}

func main() {
	println(sumX(Point{x: 10, y: 1}, Point{x: 20, y: 2}))  // 10 + 20 = 30
}
