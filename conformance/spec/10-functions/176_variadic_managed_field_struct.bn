package "main"

// func.variadic.pack with a by-value struct element that has a MANAGED field
// (...Wrapper where Wrapper has an @Node): the composite-literal element must be
// LOADED before storing (aggregate-alloc-to-load) AND its managed field acquired
// via the struct-copy path — storing the alloca pointer would corrupt both the
// value and the managed acquire.

type Node struct {
	v int
}

type Wrapper struct {
	h   @Node
	tag int
}

func sumTags(xs ...Wrapper) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i].tag + xs[i].h.v
	}
	return total
}

func main() {
	var a @Node = make(Node)
	a.v = 5
	var b @Node = make(Node)
	b.v = 6
	println(sumTags(Wrapper{h: a, tag: 100}, Wrapper{h: b, tag: 11}))  // 105 + 17 = 122
}
