package "main"

import "pkg/builtins/rt"

// func.variadic.pack + func.variadic.borrow with a MANAGED-POINTER element type
// (...@Node): the caller ACQUIRES each trailing element into the backing array
// (whose per-element destructor RefDec's at statement end) and the callee BORROWS
// the raw *[]@Node — no entry-acquire / exit-release.  So the element's refcount
// must be back to baseline after the call: no leak (missing array RefDec) and no
// double-free (RefDec in the callee).

type Node struct {
	v int
}

func count(xs ...@Node) int {
	return len(xs)
}

func main() {
	var a @Node = make(Node)
	a.v = 7
	var p *uint8 = bit_cast(*uint8, a)
	println(rt.Refcount(p))    // 1: solely owned by main
	println(count(a, a))       // 2: packed twice, callee borrows
	println(rt.Refcount(p))    // 1: acquired copies released at statement end
}
