package "main"
import "pkg/builtins/testing"

// func.variadic.spread: a spread argument `s...` forwards an existing slice's
// {data, len} as the whole *[]T variadic argument — no per-element pack, no
// copy.  Covers spreading a managed-slice @[]T, a raw slice *[]T, an array
// sub-slice `arr[:]...`, a `readonly`-element slice, a string-literal sub-slice
// `lit[:]...`, an empty (len 0) slice, and a spread after a fixed argument.

func sum(xs ...int) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func sumFrom(base int, xs ...int) int {
	var total int = base
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func countChars(cs ...readonly char) int {
	return len(cs)
}

func main() {
	var m @[]int = @[]int{1, 2, 3}
	testing.Println(sum(m...))             // 6   (spread a managed-slice)

	var a [3]int
	a[0] = 4
	a[1] = 5
	a[2] = 6
	var r *[]int = a[:]
	testing.Println(sum(r...))            // 15  (spread a raw slice)
	testing.Println(sum(a[:]...))         // 15  (spread an array sub-slice directly)

	testing.Println(sumFrom(100, m...))   // 106 (spread after a fixed argument)

	var e @[]int = make_slice(int, 0)
	testing.Println(sum(e...))            // 0   (spread an empty slice, len 0)

	var cs [3]char
	cs[0] = 'x'
	cs[1] = 'y'
	cs[2] = 'z'
	testing.Println(countChars(cs[:]...))       // 3 (spread a readonly-element slice)
	testing.Println(countChars("hello"[:]...))  // 5 (spread a string-literal sub-slice)
}
