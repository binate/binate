package "main"

import "pkg/builtins/rt"

// func.variadic.spread + func.variadic.borrow: spreading a FRESH managed operand
// (`f(mk()...)`) borrows its {data, len} for the call and RefDec's the operand at
// STATEMENT END — after the call.  So the operand's elements are neither leaked
// (the fresh slice is released) nor double-freed / UAF'd (the callee borrows the
// raw *[]@Node, it does not release).  An element's refcount must return to
// baseline once the statement completes.

type Node struct {
	v int
}

func count(xs ...@Node) int {
	return len(xs)
}

// mk builds a FRESH managed slice holding two acquired copies of n.
func mk(n @Node) @[]@Node {
	return @[]@Node{n, n}
}

func main() {
	var a @Node = make(Node)
	a.v = 7
	var p *uint8 = bit_cast(*uint8, a)
	println(rt.Refcount(p))    // 1: solely owned by main
	println(count(mk(a)...))   // 2: fresh slice holds two packed refs, callee borrows
	println(rt.Refcount(p))    // 1: fresh operand released at statement end

	// A NAMED-VAR managed slice spread borrows too — but the operand is NOT a
	// cleanup temp, so the spread must NOT RefDec it (that would be a UAF of the
	// still-live var).  s stays at its own count across the call.
	var s @[]@Node = mk(a)
	println(rt.Refcount(p))    // 3: main's 1 + s's two element refs
	println(count(s...))       // 2: s spread as a borrow, no acquire/release
	println(rt.Refcount(p))    // 3: s untouched by the spread, still alive
}
