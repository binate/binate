package "main"
import "pkg/builtins/testing"

// func.variadic.spread: a spread `expr...` is valid only into a variadic callee.
// Spreading into a fixed-arity function is rejected.

func add(a int, b int) int {
	return a + b
}

func main() {
	var m @[]int = @[]int{1, 2}
	testing.Println(add(m...))
}
