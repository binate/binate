package "main"

// func.variadic.spread: the heterogeneous builtins (print / println / panic) have
// empty parameter lists — they are not user-variadic, so a spread has no element
// type to forward into and is rejected by name.  Demonstrated on `panic` (the
// compiler-internal abort): print/println are being retired from test programs in
// favor of pkg/builtins/testing, but panic — the durable member of this builtin
// family — exercises the same by-name spread rejection.

func main() {
	var m @[]int = @[]int{1, 2}
	panic(m...)
}
