package "main"

// func.variadic.spread: `panic` is a heterogeneous builtin with an empty
// parameter list — it is not user-variadic, so a spread has no element type to
// forward into and is rejected by name.  panic is the sole remaining member of
// this builtin family (print/println shared the shape but have been retired in
// favor of pkg/builtins/testing); it exercises the by-name spread rejection.

func main() {
	var m @[]int = @[]int{1, 2}
	panic(m...)
}
