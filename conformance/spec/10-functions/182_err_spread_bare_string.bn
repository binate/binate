package "main"
import "pkg/builtins/testing"

// func.variadic.spread: the spread operand must be a SLICE by kind.  A bare
// string literal has array type ([N]readonly char), so it must be sub-sliced
// (`"abc"[:]...`); spreading it directly is rejected (the kind gate runs before
// AssignableTo, which would otherwise decay the string literal to a char slice).

func countChars(cs ...readonly char) int {
	return len(cs)
}

func main() {
	testing.Println(countChars("abc"...))
}
