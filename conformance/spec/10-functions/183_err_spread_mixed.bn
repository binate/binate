package "main"
import "pkg/builtins/testing"

// func.variadic.spread: a spread supplies exactly ONE operand for the variadic
// parameter, so a valid spread call has exactly k+1 args.  Mixing a spread with
// an individual variadic argument gives > k+1 args and surfaces as "wrong number
// of arguments" (the spread-with-individual case, D-F ‡).

func sumFrom(base int, xs ...int) int {
	return base + len(xs)
}

func main() {
	var m @[]int = @[]int{1, 2}
	testing.Println(sumFrom(1, 9, m...))  // 3 args, k+1 == 2: individual arg + spread
}
