package "main"

// func.variadic.spread: a spread call must still fill the k fixed parameters, so
// it has exactly k+1 args.  Spreading with a fixed parameter left unfilled gives
// < k+1 args and surfaces as "wrong number of arguments".

func sumFrom(base int, xs ...int) int {
	return base + len(xs)
}

func main() {
	var m @[]int = @[]int{1, 2}
	println(sumFrom(m...))  // 1 arg, k+1 == 2: the base parameter has no argument
}
