package "main"

// func.variadic.spread: a spread operand of a NAMED-DISTINCT slice type
// (`type S @[]int`) is a slice by kind once the named wrapper is peeled, and its
// underlying @[]int is assignable to the variadic body type *[]int.  The kind
// gate peels named+alias+readonly (peelNamedBounded), so the named slice is
// accepted — not rejected as a non-slice.

type IntSlice @[]int

func sum(xs ...int) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func main() {
	var s IntSlice = @[]int{4, 5, 6}
	println(sum(s...))  // 15
}
