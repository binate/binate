package "main"
import "pkg/builtins/testing"

// func.variadic.spread: a spread into a NON-variadic method is rejected — the
// method has no `...T` element to forward.  The method-call path is dispatched
// before the plain func-call spread guard, so checkResolvedMethodCall's own
// non-variadic branch carries the rejection.  take's param accepts the @[]int
// operand (managed->raw decay), so ONLY the spread error surfaces, not an
// argument-type mismatch.  (A spread into a VARIADIC method is accepted — 191.)

type Box struct {
	n int
}

func (b Box) take(xs *[]int) int {
	return len(xs)
}

func main() {
	var b Box
	var m @[]int = @[]int{1, 2}
	testing.Println(b.take(m...))
}
