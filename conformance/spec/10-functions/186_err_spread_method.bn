package "main"

// func.variadic.spread: a spread into a METHOD is rejected — variadic method
// calls are not yet supported (Phase 6), so no method is variadic and a spread
// has no `...T` element to forward.  The method-call path is dispatched before
// the plain func-call spread guard, so this needs its own rejection.  take's
// param accepts the @[]int operand (managed->raw decay), so ONLY the spread
// error surfaces, not an argument-type mismatch.

type Box struct {
	n int
}

func (b Box) take(xs *[]int) int {
	return len(xs)
}

func main() {
	var b Box
	var m @[]int = @[]int{1, 2}
	println(b.take(m...))
}
