package "main"

// func.variadic.spread + func.variadic.identity: a spread through a func-VALUE
// (*func(...int) int) erases variadic-ness to a plain *[]int at the indirect
// boundary — buildCallArgs forwards the operand's {data,len} before
// EmitCallFuncValue, exactly as the direct-call path does.

func sum(xs ...int) int {
	var total int = 0
	for i := 0; i < len(xs); i++ {
		total = total + xs[i]
	}
	return total
}

func main() {
	var f *func(...int) int = sum
	var m @[]int = @[]int{7, 8, 9}
	println(f(m...))  // 24 (spread through a func value)
}
