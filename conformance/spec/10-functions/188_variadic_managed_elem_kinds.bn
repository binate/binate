package "main"

// func.variadic.pack + func.variadic.borrow: the individual-arg pack acquires
// each MANAGED element (emitStoreManagedSlot — move a fresh producer, RefInc a
// borrow) into the stack backing, and the callee borrows the raw *[]@T (no
// entry-acquire / exit-release).  The same mechanism serves every managed
// element kind; covered here for a managed-slice element (`...@[]int`) and a
// managed func-value element (`...@func(int) int`), each with fresh-literal
// elements (moved), variable elements (copied), and the empty case (len 0).

func total(xss ...@[]int) int {
	var t int = 0
	for i := 0; i < len(xss); i++ {
		for j := 0; j < len(xss[i]); j++ {
			t = t + xss[i][j]
		}
	}
	return t
}

func inc(x int) int { return x + 1 }
func dbl(x int) int { return x * 2 }

func applyAll(fs ...@func(int) int) int {
	var t int = 0
	for i := 0; i < len(fs); i++ {
		t = t + fs[i](10)
	}
	return t
}

func main() {
	// Managed-slice elements: fresh literals (moved) and vars (copied).
	println(total(@[]int{1, 2}, @[]int{3, 4}))  // 10 (fresh literal elements)
	var a @[]int = @[]int{5, 6}
	var b @[]int = @[]int{7}
	println(total(a, b))                         // 18 (variable elements)
	println(total())                             // 0  (empty)

	// Managed func-value elements.
	var f @func(int) int = inc
	var g @func(int) int = dbl
	println(applyAll(f, g))                       // 11 + 20 = 31
	println(applyAll())                           // 0
}
