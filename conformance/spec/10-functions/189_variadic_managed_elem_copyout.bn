package "main"

import "pkg/builtins/rt"

// func.variadic.borrow: the callee borrows the raw *[]@Node — no entry-acquire,
// no exit-release — so a shared element's refcount returns to baseline after the
// call (the caller-side pack acquired it and releases it at statement end).  When
// the callee COPIES an element out (into a fresh managed slice it returns), that
// copy is acquired and OUTLIVES the pack: the referent is retained by the
// returned slice, not double-freed by the callee's borrow.

type Node struct {
	v int
}

// firstOf copies element 0 out into a fresh slice it returns (an acquiring copy).
func firstOf(xs ...@Node) @[]@Node {
	var out @[]@Node = make_slice(@Node, 1)
	out[0] = xs[0]
	return out
}

func main() {
	var a @Node = make(Node)
	a.v = 5
	var p *uint8 = bit_cast(*uint8, a)
	println(rt.Refcount(p))         // 1: solely owned by main
	var kept @[]@Node = firstOf(a)  // pack acquires a, callee copies into out, pack released
	println(rt.Refcount(p))         // 2: main's a + kept[0]'s acquired copy
	println(kept[0].v)              // 5: the copy is live (not freed by the borrow)
	kept = make_slice(@Node, 0)     // drop kept
	println(rt.Refcount(p))         // 1: copy released, back to baseline
}
