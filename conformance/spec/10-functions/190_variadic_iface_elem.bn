package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// func.variadic.pack + func.variadic.borrow, MANAGED-INTERFACE element (`...@Shape`):
// packing a managed interface value routes through the SAME emitStoreManagedSlot
// as every other managed kind (not a bespoke coerce arm), so the box is acquired
// into the backing and the callee borrows the raw *[]@Shape, dispatching per
// element's vtable.  Refcount observed via the underlying @Square box (a managed
// pointer): the pack returns it to baseline, and a copied-out element retains.

interface Shape {
	area() int
}

type Square struct {
	s int
}

func (q *Square) area() int {
	return q.s * q.s
}

impl *Square : Shape

func totalArea(shapes ...@Shape) int {
	var t int = 0
	for i := 0; i < len(shapes); i++ {
		t = t + shapes[i].area()
	}
	return t
}

// copy element 0 out (acquire) and dispatch through it after the pack is released.
func firstArea(shapes ...@Shape) int {
	var out @[]@Shape = make_slice(@Shape, 1)
	out[0] = shapes[0]
	return out[0].area()
}

func main() {
	var q @Square = make(Square)
	q.s = 4
	var p *uint8 = bit_cast(*uint8, q)
	testing.Println(rt.Refcount(p))     // 1: q alone
	var s @Shape = q            // box q into @Shape (acquires the box)
	testing.Println(rt.Refcount(p))     // 2: q + s
	testing.Println(totalArea(s, s))    // 32: pack s twice, dispatch (16 + 16)
	testing.Println(rt.Refcount(p))     // 2: pack released, back to baseline (no leak/double-free)
	testing.Println(totalArea())        // 0: empty
	testing.Println(firstArea(s))       // 16: copy-out + dispatch (retained past the borrow)
	testing.Println(rt.Refcount(p))     // 2: still balanced
}
