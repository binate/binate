package "main"

// func.variadic.pack / func.variadic.spread through a METHOD call (obj.M(...)):
// the receiver binds first (Params[0]), then the trailing user args pack into the
// single *[]T — or a spread operand forwards its {data,len} — for both pointer
// and value receivers, alongside fixed leading params and the empty case.

type Acc struct {
	base int
}

func (a *Acc) sum(xs ...int) int {
	var t int = a.base
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

func (a *Acc) sumFrom(label int, xs ...int) int {
	var t int = a.base + label
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

type V struct {
	n int
}

func (v V) tot(xs ...int) int {
	var t int = v.n
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

func main() {
	var a Acc
	a.base = 100
	println(a.sum(1, 2, 3))       // 106 (pointer receiver, pack)
	println(a.sum())              // 100 (empty variadic)
	println(a.sumFrom(5, 1, 2))   // 108 (fixed + pack)
	var m @[]int = @[]int{3, 4}
	println(a.sumFrom(5, m...))   // 112 (fixed + spread)

	var v V
	v.n = 10
	println(v.tot(7, 8))          // 25 (value receiver, pack)
	println(v.tot(m...))          // 17 (value receiver, spread)
}
