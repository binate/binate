package "main"

import "pkg/builtins/rt"

// A variadic method value (`a.sum`, receiver bound → *func(...int) int) packs
// through the func-value path; and a MANAGED-element variadic method (`...@Node`)
// borrows the raw *[]@Node just like a free function — a packed element returns
// to baseline after the call.

type Acc struct {
	base int
}

func (a *Acc) sum(xs ...int) int {
	var t int = a.base
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

type Node struct {
	v int
}

type Coll struct {
	tag int
}

func (c *Coll) count(xs ...@Node) int {
	return len(xs)
}

func main() {
	// Variadic method value.
	var a Acc
	a.base = 100
	var f *func(...int) int = a.sum
	println(f(1, 2, 3))          // 106

	// Managed-element variadic method: pack borrows, element returns to baseline.
	var c Coll
	c.tag = 0
	var n @Node = make(Node)
	n.v = 7
	var p *uint8 = bit_cast(*uint8, n)
	println(rt.Refcount(p))      // 1
	println(c.count(n, n))       // 2 (packed twice, method borrows)
	println(rt.Refcount(p))      // 1 (acquired copies released at statement end)
}
