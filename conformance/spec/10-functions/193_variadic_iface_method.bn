package "main"
import "pkg/builtins/testing"

// func.variadic.pack / func.variadic.spread through an INTERFACE method (vtable
// dispatch): variadic-ness is erased to a plain *[]T before the indirection
// (func.variadic.identity) — the caller packs/spreads, then EmitCallIfaceMethod
// dispatches per the receiver's vtable.  Covered polymorphically (two impls) with
// a fixed leading param, the empty case, individual pack, and a spread, plus a
// managed-element interface method (borrow discipline holds through dispatch).

import "pkg/builtins/rt"

interface Summer {
	sum(base int, xs ...int) int
}

type Adder struct {
	k int
}

func (a *Adder) sum(base int, xs ...int) int {
	var t int = base + a.k
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

impl *Adder : Summer

type Muler struct {
	k int
}

func (m *Muler) sum(base int, xs ...int) int {
	var t int = base * m.k
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

impl *Muler : Summer

func viaIface(s @Summer) int {
	var m @[]int = @[]int{10, 20}
	return s.sum(1, 2, 3) + s.sum(100) + s.sum(0, m...)
}

type Node struct {
	v int
}

interface Counter {
	count(xs ...@Node) int
}

type C struct {
	tag int
}

func (c *C) count(xs ...@Node) int {
	return len(xs)
}

impl *C : Counter

func main() {
	var a @Adder = make(Adder)
	a.k = 5
	var b @Muler = make(Muler)
	b.k = 3
	testing.Println(viaIface(a))   // (1+5+2+3) + (100+5) + (0+5+30) = 11 + 105 + 35 = 151
	testing.Println(viaIface(b))   // (3+5) + 300 + (0+30) = 8 + 300 + 30 = 338

	// Managed-element variadic interface method: pack borrows, element balanced.
	var cc @C = make(C)
	var n @Node = make(Node)
	n.v = 7
	var p *uint8 = bit_cast(*uint8, n)
	var ctr @Counter = cc
	testing.Println(rt.Refcount(p))    // 1
	testing.Println(ctr.count(n, n))   // 2 (packed twice, dispatch borrows)
	testing.Println(rt.Refcount(p))    // 1 (released at statement end)
}
