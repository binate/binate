package "main"

// func.variadic.pack / func.variadic.spread through a GENERIC function call
// (f[T](...)): monomorphization carries variadic-ness onto each instantiation
// (instantiateGenericFunc copies the per-Param IsVariadic; the instantiation
// FuncSig sets it too), so f[int](1,2,3) packs and f[int](s...) spreads, exactly
// like a non-generic variadic call.  Covered across two instantiations, with a
// fixed leading param, the empty case, and a managed element type.

import "pkg/builtins/rt"

func count[T any](xs ...T) int {
	return len(xs)
}

func firstOr[T any](dflt T, xs ...T) T {
	if len(xs) > 0 {
		return xs[0]
	}
	return dflt
}

type Node struct {
	v int
}

func main() {
	println(count[int](1, 2, 3))      // 3 (pack)
	println(count[int]())             // 0 (empty)
	var m @[]int = @[]int{7, 8, 9, 10}
	println(count[int](m...))         // 4 (spread)
	println(firstOr[int](99, 5, 6))   // 5 (fixed + pack)
	println(firstOr[int](99))         // 99 (empty)

	// Managed element type through a generic instantiation: pack borrows.
	var a @Node = make(Node)
	a.v = 7
	var p *uint8 = bit_cast(*uint8, a)
	println(rt.Refcount(p))           // 1
	println(count[@Node](a, a))       // 2 (managed-element pack, borrow)
	println(rt.Refcount(p))           // 1 (released at statement end)
}
