package "main"

// func.variadic.pack / func.variadic.spread through a variadic method reached via
// a GENERIC CONSTRAINT (`func f[T C](x T) { x.M(...) }`): the constraint-method
// call binds pack/spread against the Self-substituted params, and a monomorphized
// call lowers via the concrete method's dispatch (which already packs).

interface Summer {
	sum(base int, xs ...int) int
}

type Adder struct {
	k int
}

func (a *Adder) sum(base int, xs ...int) int {
	var t int = base + a.k
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

impl *Adder : Summer

func total[T Summer](s T) int {
	var m @[]int = @[]int{10, 20}
	return s.sum(1, 2, 3) + s.sum(100) + s.sum(0, m...)
}

func main() {
	var a Adder
	a.k = 5
	println(total[*Adder](&a))   // (1+5+2+3)=11 + (100+5)=105 + (0+5+30)=35 = 151
}
