package "main"
import "pkg/builtins/testing"

// A METHOD EXPRESSION (T.M) of a variadic method yields a func value whose first
// param is the receiver and whose last param stays variadic (*func(*Acc, ...int)
// int) — the per-Param IsVariadic survives the method-expression build (no
// receiver-drop here; the receiver is prepended).  Calling it packs the trailing
// individual args, exactly as a direct variadic call does.

type Acc struct {
	base int
}

func (a *Acc) sum(xs ...int) int {
	var t int = a.base
	for i := 0; i < len(xs); i++ {
		t = t + xs[i]
	}
	return t
}

func main() {
	var a Acc
	a.base = 100
	var f *func(*Acc, ...int) int = Acc.sum
	testing.Println(f(&a, 1, 2, 3))   // 106 (pack through the method expression)
	testing.Println(f(&a))            // 100 (empty)
}
