package "main"

// func.variadic.identity: variadic-ness is part of a func-value type's identity.
// A fixed-arity function `func(*[]int) int` has the SAME body param type (*[]int)
// as `*func(...int) int` but is NOT variadic, so it is not assignable to a
// variadic func-value type — the identity comparators (Identical /
// funcSignaturesMatch) compare the last param's IsVariadic.

func fixed(xs *[]int) int {
	return len(xs)
}

func main() {
	var f *func(...int) int = fixed
	println(f(1, 2))
}
