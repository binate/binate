package "main"
import "pkg/builtins/testing"

// func.variadic.pack / func.variadic.spread through an INHERITED interface method:
// the dispatch takes the method's signature, variadic parameter included, from the
// parent interface that declares it, so a variadic method declared on a parent and
// reached through a child interface value still packs/spreads.

interface Base {
	sum(xs ...int) int
}

interface Ext : Base {
	tag() int
}

type Impl struct {
	k int
}

func (i *Impl) sum(xs ...int) int {
	var t int = i.k
	for j := 0; j < len(xs); j++ {
		t = t + xs[j]
	}
	return t
}

func (i *Impl) tag() int {
	return 9
}

impl *Impl : Ext

func main() {
	var x @Impl = make(Impl)
	x.k = 100
	var e @Ext = x
	testing.Println(e.sum(1, 2, 3))   // 106 (inherited variadic method, pack)
	testing.Println(e.sum())          // 100 (empty)
	var m @[]int = @[]int{4, 5}
	testing.Println(e.sum(m...))      // 109 (inherited, spread)
}
