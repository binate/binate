package "main"

// func.variadic.spread: a spread into a NON-variadic interface method is rejected
// by tryInterfaceMethodCall's own non-variadic branch (the method-call path is
// dispatched before the func-call spread guard).  take's param accepts the @[]int
// operand, so ONLY the spread error surfaces.

interface Taker {
	take(xs *[]int) int
}

type T struct {
	tag int
}

func (t *T) take(xs *[]int) int {
	return len(xs)
}

impl *T : Taker

func main() {
	var t @T = make(T)
	var s @Taker = t
	var m @[]int = @[]int{1, 2}
	println(s.take(m...))
}
