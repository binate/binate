package "main"

// func.variadic.spread: a spread into a NON-variadic generic-constraint method is
// rejected by tryTypeParamMethodCall's own non-variadic branch.  take's param
// accepts the @[]int operand, so ONLY the spread error surfaces.

interface Taker {
	take(xs *[]int) int
}

type T struct {
	tag int
}

func (t *T) take(xs *[]int) int {
	return len(xs)
}

impl *T : Taker

func useIt[X Taker](x X) int {
	var m @[]int = @[]int{1, 2}
	return x.take(m...)
}

func main() {
	var t T
	println(useIt[*T](&t))
}
