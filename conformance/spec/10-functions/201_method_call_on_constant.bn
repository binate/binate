package "main"

import "pkg/builtins/testing"

// func.method.value-recv: a method with a value receiver called on a
// constant of the receiver's type — a package constant, a local constant,
// and const-group members — receives a copy of the constant's value.

type MyInt int

func (m MyInt) Double() int {
	return cast(int, m) * 2
}

const PC MyInt = 21

func main() {
	const C MyInt = 5
	const (
		G MyInt = 7
		H
	)
	testing.Println(PC.Double(), C.Double(), G.Double(), H.Double())
}
