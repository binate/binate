package "main"

// func.call.value (§10.2): a call with several results is not a single value —
// not as a typed initializer, an argument, a struct field, an assignment, a
// callee, a receiver or an operand — and a call with no result has no value —
// not as an operand or a blank assignment's right-hand side.  Each is
// REJECTED.  The
// rule-satisfying neighbors (the destructure, the expression statement)
// compile.

type S struct {
	f *func() (int, int)
}

func nothing() {}

func two() (int, int) {
	return 1, 2
}

func take(f *func() (int, int)) {}

func main() {
	a, b := two()
	two()
	var p *func() (int, int) = two()
	take(two())
	var s S = S{f: two()}
	p = two()
	a, b = two()()
	var n int = nothing() + a
	_ = nothing()
	var g = twoS().f
	_ = g
	_ = s
	_ = b
	_ = n
}

func twoS() (S, int) {
	return S{}, 0
}
