package "main"

import "pkg/builtins/testing"

// func.call.value (§10.2), func.destructure, func.return.tail: a call with
// several results is distributed by a destructuring `:=` or `=` and a tail
// `return`, and discarded by an expression statement or `defer` — whatever the
// callee (a function, a function value, a method, an interface method, a
// type-parameter method whose results mention Self, or a call that returns a
// function value, then called).

interface Pairer {
	Pair() (int, int)
}

interface Halver {
	Halves() (Self, Self)
	Val() int
}

type T struct {
	n int
}

type Num struct {
	v int
}

func (t *T) Pair() (int, int) {
	return t.n, t.n + 1
}

impl *T : Pairer

func (n Num) Halves() (Num, Num) {
	return Num{v: n.v / 2}, Num{v: n.v - n.v / 2}
}

func (n Num) Val() int {
	return n.v
}

impl Num : Halver

func two() (int, int) {
	return 1, 2
}

func fwd() (int, int) {
	return two()
}

func mk() @func() (int, int) {
	return two
}

func quarter[T Halver](x T) int {
	a, _ := x.Halves()
	b, _ := a.Halves()
	return b.Val()
}

func log(x int) {
	testing.Println(x)
}

func main() {
	two()
	defer log(9)
	defer two()
	a, b := two()
	var x int = 0
	var y int = 0
	x, y = fwd()
	var fv @func() (int, int) = mk()
	c, d := fv()
	e, f := mk()()
	var t @T = make(T)
	t.n = 5
	g, h := t.Pair()
	var pi *Pairer = t
	i, j := pi.Pair()
	k, l := two()
	testing.Println(a + b + x + y + c + d + e + f + g + h + i + j + k + l) // 37
	testing.Println(quarter[Num](Num{v: 20})) // 5
	_, _ = two()
}
