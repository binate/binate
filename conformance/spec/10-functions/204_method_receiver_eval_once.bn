package "main"

import "pkg/builtins/testing"

// A pointer-receiver method called on an addressable VALUE receives the
// receiver's address, and the receiver expression is evaluated exactly once —
// its base and index calls run once, and the method mutates the element or
// field they designate — for an array element, a slice element, a field reached
// through a returned pointer, a field of a managed struct, a deferred call, and a
// local variable.  Each index call below advances, so a second evaluation would
// pick another element.

type T struct {
	n int
}

func (t *T) pm() int {
	t.n = t.n + 10
	return t.n
}

type H struct {
	inr T
}

var arr [4]T
var sl @[]T
var h H
var mh @H
var k int
var calls int

func idx() int {
	k = k + 1
	return k
}

func mo() @H {
	calls = calls + 1
	return mh
}

func po() *H {
	calls = calls + 1
	return &h
}

func deferred() {
	defer arr[idx()].pm()
}

func main() {
	sl = make_slice(T, 4)
	var r int = arr[idx()].pm()
	testing.Println(r, k, arr[1].n, arr[2].n)
	k = 0
	r = sl[idx()].pm()
	testing.Println(r, k, sl[1].n, sl[2].n)
	r = po().inr.pm()
	testing.Println(r, calls, h.inr.n)
	mh = make(H)
	calls = 0
	r = mo().inr.pm()
	testing.Println(r, calls, mh.inr.n)
	k = 0
	deferred()
	testing.Println(k, arr[1].n, arr[2].n)
	var v T
	r = v.pm()
	testing.Println(r, v.n)
}
