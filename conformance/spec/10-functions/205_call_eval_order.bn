package "main"

import "pkg/builtins/testing"

// A call evaluates its callee — the receiver of a method call, the function
// value of a call through one — and then its arguments, left to right, each
// once: for a plain call, a method call, a variadic call (the packed elements),
// a call through a function value, and an interface method call.  Each callee
// and argument below is a call that logs itself; each line ends with the form
// it exercised.

type T struct {
	n int
}

func (t *T) m(x int, y int) int {
	return t.n + x + y
}

interface I {
	get(x int, y int) int
}

impl *T : I

func (t *T) get(x int, y int) int {
	return x + y
}

var obj T

func lg(tag *[]readonly char, v int) int {
	testing.Print(tag)
	testing.Print(" ")
	return v
}

func three(a int, b int, c int) int {
	return a + b + c
}

func vsum(xs ...int) int {
	var s int = 0
	for i := 0; i < len(xs); i++ {
		s = s + xs[i]
	}
	return s
}

func pobj() *T {
	testing.Print("recv ")
	return &obj
}

func fval() *func(int, int, int) int {
	testing.Print("callee ")
	return three
}

func iobj() *I {
	testing.Print("recv ")
	return &obj
}

func main() {
	var r int = three(lg("a", 1), lg("b", 2), lg("c", 3))
	testing.Println("<- f(a, b, c)")
	r = r + pobj().m(lg("a", 1), lg("b", 2))
	testing.Println("<- x.m(a, b)")
	r = r + vsum(lg("a", 1), lg("b", 2), lg("c", 3))
	testing.Println("<- variadic f(a, b, c)")
	r = r + fval()(lg("a", 1), lg("b", 2), lg("c", 3))
	testing.Println("<- fv()(a, b, c)")
	r = r + iobj().get(lg("a", 1), lg("b", 2))
	testing.Println("<- iface.m(a, b)")
	testing.Println(r)
}
