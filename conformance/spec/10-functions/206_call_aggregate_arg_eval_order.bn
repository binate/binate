package "main"

import "pkg/builtins/testing"

// A call's arguments are evaluated left to right, so a by-value aggregate
// argument is copied when it is evaluated: a LATER argument's side effect on
// the aggregate's storage is not seen by the callee — for a global struct, a
// global array, and a local struct changed through a pointer.

type T struct {
	v int
	w int
}

var gt T
var ga [2]int

func bumpT() int {
	gt.v = 99
	return 1
}

func bumpA() int {
	ga[0] = 99
	return 1
}

func setLocal(p *T) int {
	p.v = 99
	return 1
}

func showT(t T, n int) int {
	return t.v + n
}

func showA(a [2]int, n int) int {
	return a[0] + n
}

func main() {
	testing.Println(showT(gt, bumpT()))
	testing.Println(showA(ga, bumpA()))
	var lt T
	testing.Println(showT(lt, setLocal(&lt)))
}
