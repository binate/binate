package "main"

import "pkg/builtins/testing"

// A function literal written as a composite-literal field or element whose
// type is a raw *func takes that type (func.lit.inferred-default): it is a
// stack closure owned by the enclosing frame, so it stays callable for the
// rest of the function.  clobber reuses freed heap memory, so a closure left
// on the heap and freed at the end of its statement (or of its block) would
// read garbage.

type RF = *func(int) int

type H struct {
	g *func(int) int
}

type Leaf struct {
	y int
}

func clobber() {
	var a @[]int = make_slice(int, 4)
	var b @[]int = make_slice(int, 8)
	var c @[]int = make_slice(int, 16)
	for i := 0; i < 4; i++ {
		a[i] = 1000000 + i
	}
	for i := 0; i < 8; i++ {
		b[i] = 2000000 + i
	}
	for i := 0; i < 16; i++ {
		c[i] = 3000000 + i
	}
}

func main() {
	var k int = 7

	var keyed H = H{g: func(x int) int { return x + k }}
	clobber()
	testing.Println(keyed.g(1))

	var positional H = H{func(x int) int { return x + 2 * k }}
	clobber()
	testing.Println(positional.g(1))

	var arr [2]RF = [2]RF{func(x int) int { return x + 3 * k }, func(x int) int { return x + 4 * k }}
	clobber()
	testing.Println(arr[0](1), arr[1](1))

	var s @[]RF = @[]RF{func(x int) int { return x + 5 * k }}
	clobber()
	testing.Println(s[0](1))

	var nested [1]H = [1]H{H{g: func(x int) int { return x * k }}}
	clobber()
	testing.Println(nested[0].g(2))

	// Built inside a block, with a managed capture, and called after the block:
	// the closure record lives as long as the frame (func.closure.allocation).
	var blocked H
	if k > 0 {
		var m @Leaf = make(Leaf)
		m.y = 6 * k
		blocked = H{g: func(x int) int { return x + m.y }}
	}
	clobber()
	testing.Println(blocked.g(1))
}
