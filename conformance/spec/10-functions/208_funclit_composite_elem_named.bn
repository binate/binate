package "main"

import "pkg/builtins/testing"

// A function literal written as a composite-literal field or element of a
// named function-value type takes that type (func.value.named-nominal,
// func.lit.inferred-default), exactly as it does in a var initializer.

type Fn *func(int) int
type MFn @func(int) int

type Holder struct {
	f MFn
	g Fn
}

func main() {
	var k int = 7
	var h Holder = Holder{f: func(x int) int { return x + k }, g: func(x int) int { return x + 2 * k }}
	testing.Println(h.f(1), h.g(1))

	var arr [2]MFn = [2]MFn{func(x int) int { return x * k }, func(x int) int { return x - k }}
	testing.Println(arr[0](2), arr[1](10))

	var s @[]Fn = @[]Fn{func(x int) int { return x + 100 }}
	testing.Println(s[0](1))
}
