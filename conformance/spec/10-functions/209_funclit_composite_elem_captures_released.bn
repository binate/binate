package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A function literal in a composite-literal field / element captures a managed
// value by acquiring its own reference (func.closure.captured), released when
// the closure is destroyed: whether the closure is a named managed function
// value (MFn), an unnamed @func, or a frame-owned raw *func (Fn), the captured
// Leaf's refcount is back to its starting value once the literal's enclosing
// function returns.  rc discounts the reference its own parameter holds.

type Fn *func(int) int
type MFn @func(int) int

type Leaf struct {
	y int
}

type Holder struct {
	f MFn
	g Fn
	m @func(int) int
}

func rc(l @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, l)) - 1
}

func useStruct(l @Leaf) int {
	var h Holder = Holder{f: func(x int) int { return x + l.y }, g: func(x int) int { return x * l.y },
			m: func(x int) int { return x - l.y }}
	testing.Println("in struct", rc(l))
	return h.f(1) + h.g(2) + h.m(3)
}

func useArray(l @Leaf) int {
	var arr [2]MFn = [2]MFn{func(x int) int { return x + l.y }, func(x int) int { return x * l.y }}
	var raw [1]Fn = [1]Fn{func(x int) int { return x - l.y }}
	testing.Println("in array", rc(l))
	return arr[0](1) + arr[1](2) + raw[0](3)
}

func useSlice(l @Leaf) int {
	var s @[]MFn = @[]MFn{func(x int) int { return x + l.y }}
	testing.Println("in slice", rc(l))
	return s[0](1)
}

type Outer struct {
	h Holder
	a [2]MFn
}

// useMore covers a raw-slice literal, a keyed array element, an inferred-length
// array and a nested literal: eight closures, each holding one reference.
func useMore(l @Leaf) int {
	var rs *[]readonly MFn = *[]readonly MFn{func(x int) int { return x + l.y }}
	var keyed [3]MFn = [3]MFn{2: func(x int) int { return x * l.y }}
	var inferred [1]Fn = [...]Fn{func(x int) int { return x - l.y }}
	var o Outer = Outer{h: Holder{f: func(x int) int { return x + l.y }, g: func(x int) int { return x * l.y },
			m: func(x int) int { return x - l.y }},
			a: [2]MFn{func(x int) int { return x + 2 * l.y }, func(x int) int { return x * x + l.y }}}
	testing.Println("in more", rc(l))
	return rs[0](1) + keyed[2](2) + inferred[0](3) + o.h.f(1) + o.h.g(2) + o.h.m(3) + o.a[0](0) + o.a[1](2)
}

func main() {
	var l @Leaf = make(Leaf)
	l.y = 5
	testing.Println("start", rc(l))
	testing.Println(useStruct(l), "after struct", rc(l))
	testing.Println(useArray(l), "after array", rc(l))
	testing.Println(useSlice(l), "after slice", rc(l))
	testing.Println(useMore(l), "after more", rc(l))
}
