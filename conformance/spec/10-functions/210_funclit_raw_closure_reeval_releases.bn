package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A capturing raw *func literal evaluated repeatedly in one scope -- in a `for`
// condition or post statement, directly as an argument or as a composite-literal
// field -- acquires a reference to each captured managed value on every
// evaluation (func.closure.captured), and every one of those references is
// released: the captured Leaf's refcount is back to its starting value once the
// loop's function returns.  rc discounts the reference its own parameter holds.

type Leaf struct {
	y int
}

type H struct {
	g *func(int) int
}

func rc(l @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, l)) - 1
}

func lim(f *func(int) int) int {
	return f(0)
}

func limH(h H) int {
	return h.g(0)
}

func cond(l @Leaf) int {
	var n int = 0
	for i := 0; i < lim(func(x int) int { return x + l.y }); i++ {
		n++
	}
	return n
}

func condComposite(l @Leaf) int {
	var n int = 0
	for i := 0; i < limH(H{g: func(x int) int { return x + l.y }}); i++ {
		n++
	}
	return n
}

func post(l @Leaf) int {
	var n int = 0
	for i := 0; i < 3; i = i + lim(func(x int) int { return x + l.y - 2 }) {
		n++
	}
	return n
}

func main() {
	var l @Leaf = make(Leaf)
	l.y = 3
	testing.Println("start", rc(l))
	testing.Println(cond(l), rc(l))
	testing.Println(condComposite(l), rc(l))
	testing.Println(post(l), rc(l))
}
