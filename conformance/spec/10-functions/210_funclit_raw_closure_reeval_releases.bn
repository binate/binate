package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A capturing raw *func literal (or method value) evaluated repeatedly in one
// scope -- in a `for` condition or post statement, directly as an argument or as
// a composite-literal field, or in a loop body that can `return` before reaching
// it -- acquires a reference to each captured managed value on every evaluation
// (func.closure.captured), and every one of those references is released on
// every exit, including a `return` that comes before the closure's site: the
// captured Leaf's refcount is back to its starting value once the loop's
// function returns.  rc discounts the reference its own parameter holds.

type Leaf struct {
	y int
}

func (l @Leaf) Add(x int) int {
	return x + l.y
}

type H struct {
	g *func(int) int
}

func rc(l @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, l)) - 1
}

func lim(f *func(int) int) int {
	return f(0)
}

func limH(h H) int {
	return h.g(0)
}

func cond(l @Leaf) int {
	var n int = 0
	for i := 0; i < lim(func(x int) int { return x + l.y }); i++ {
		n++
	}
	return n
}

func condComposite(l @Leaf) int {
	var n int = 0
	for i := 0; i < limH(H{g: func(x int) int { return x + l.y }}); i++ {
		n++
	}
	return n
}

func post(l @Leaf) int {
	var n int = 0
	for i := 0; i < 3; i = i + lim(func(x int) int { return x + l.y - 2 }) {
		n++
	}
	return n
}

func earlyReturn(l @Leaf) int {
	var s int = 0
	for i := 0; i < 3; i++ {
		if i == 2 {
			return s
		}
		var f *func(int) int = func(x int) int { return x + l.y }
		s = s + f(i)
	}
	return s
}

func earlyReturnMethodValue(l @Leaf) int {
	var s int = 0
	for i := 0; i < 3; i++ {
		if i == 2 {
			return s
		}
		var f *func(int) int = l.Add
		s = s + f(i)
	}
	return s
}

func step(i int, f *func(int) int) int {
	return f(i) - 2
}

func postWithReturn(l @Leaf) int {
	var i int
	for i = 0; i < 5; i = step(i, func(x int) int { return x + l.y }) {
		if i == 2 {
			return i
		}
	}
	return i
}

func rangeBody(l @Leaf) int {
	var s int = 0
	var xs [3]int
	for x in xs {
		var f *func(int) int = func(v int) int { return v + x + l.y }
		s = s + f(1)
	}
	return s
}

func methodValueCondPost(l @Leaf) int {
	var n int = 0
	for i := 0; i < limit(l.Add); i = i + step(0, l.Add) {
		n++
	}
	return n
}

func limit(f *func(int) int) int {
	return f(0)
}

func main() {
	var l @Leaf = make(Leaf)
	l.y = 3
	testing.Println("start", rc(l))
	testing.Println(cond(l), rc(l))
	testing.Println(condComposite(l), rc(l))
	testing.Println(post(l), rc(l))
	testing.Println(earlyReturn(l), rc(l))
	testing.Println(earlyReturnMethodValue(l), rc(l))
	testing.Println(postWithReturn(l), rc(l))
	testing.Println(rangeBody(l), rc(l))
	testing.Println(methodValueCondPost(l), rc(l))
}
