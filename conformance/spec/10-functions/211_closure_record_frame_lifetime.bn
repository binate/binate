package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A capturing raw *func closure -- a function literal or a method value --
// keeps its closure record, and the references that record holds to its
// captures, for as long as the frame that created it (func.closure.allocation),
// not only until the end of the block it is written in: a closure made inside an
// `if` block stays callable after the block, including from a deferred call that
// runs at function exit.  Evaluating the same literal (or method value) again in
// that frame re-fills its one record, releasing the previous captures, so every
// closure value it produced sees the latest captures.  The captured Leaf's
// refcount is back to its starting value once each function returns; rc
// discounts the reference its own parameter holds.  clobber reuses freed heap
// memory, so a record released too early would read garbage.

type Leaf struct {
	y int
}

func (l @Leaf) Add(x int) int {
	return x + l.y
}

type H struct {
	g *func(int) int
}

func rc(l @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, l)) - 1
}

func clobber() {
	var a @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ {
		a[i] = 1000000 + i
	}
}

func use(f *func(int) int) {
	testing.Println("deferred", f(1))
}

func limit(f *func(int) int) int {
	return f(0)
}

func afterBlock(c bool) {
	var h H
	var f *func(int) int
	var mv *func(int) int
	if c {
		var m @Leaf = make(Leaf)
		m.y = 5
		h.g = func(x int) int { return x + m.y }
		f = func(x int) int { return x * m.y }
		mv = m.Add
	}
	clobber()
	testing.Println("after block", h.g(1), f(2), mv(3))
}

func deferFromBlock(c bool) {
	if c {
		var m @Leaf = make(Leaf)
		m.y = 7
		defer use(func(x int) int { return x * m.y })
		defer use(m.Add)
	}
	clobber()
	testing.Println("body")
}

func reevaluate(l @Leaf) {
	var fs [3]*func(int) int
	for i := 0; i < 3; i++ {
		fs[i] = func(x int) int { return x + i * 10 + l.y }
	}
	testing.Println("loop", fs[0](0), fs[1](0), fs[2](0), rc(l))
}

func methodValueInCond(l @Leaf) int {
	var n int = 0
	for n < limit(l.Add) {
		n++
	}
	return n
}

func main() {
	afterBlock(true)
	deferFromBlock(true)
	var l @Leaf = make(Leaf)
	l.y = 100
	testing.Println("start", rc(l))
	reevaluate(l)
	testing.Println("after loop", rc(l))
	l.y = 3
	testing.Println(methodValueInCond(l), rc(l))
}
