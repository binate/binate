package "main"

// A function literal in a composite-literal field / element takes the field /
// element type only when its signature matches (func.lit.inferred-default); a
// literal whose signature differs keeps its default @func type and is rejected,
// and so is an already-bound @func value for a named function-value element
// (func.value.named-nominal).

type MFn @func(int) int

type H struct {
	f MFn
	g *func(int) int
}

func main() {
	var h H = H{f: func(x int) bool { return x > 0 }, g: func(x int, y int) int { return x + y }}
	var bound @func(int) int = func(x int) int { return x }
	var a [1]MFn = [1]MFn{bound}
	_ = h
	_ = a
}
