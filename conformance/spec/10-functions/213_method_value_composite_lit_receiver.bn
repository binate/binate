package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A method value on a composite-literal receiver (`S{…}.Get`, a value receiver)
// captures a copy of the literal's value (func.method-value.capture): the copy's
// managed field holds its own reference, released with the closure record, so
// the method value reads the literal's fields and the Leaf's refcount is back to
// its starting value once the function returns.  rc discounts the reference its
// own parameter holds.

type Leaf struct {
	y int
}

type S struct {
	m @Leaf
	k int
}

func (s S) Get(x int) int {
	return x + s.m.y + s.k
}

type P struct {
	a int
	b int
}

func (p P) Sum(x int) int {
	return x + p.a + p.b
}

func rc(l @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, l)) - 1
}

func use(l @Leaf) int {
	var f *func(int) int = S{m: l, k: 10}.Get
	return f(1)
}

func main() {
	var l @Leaf = make(Leaf)
	l.y = 5
	testing.Println(use(l), rc(l))
	var g *func(int) int = P{a: 2, b: 3}.Sum
	testing.Println(g(1))
}
