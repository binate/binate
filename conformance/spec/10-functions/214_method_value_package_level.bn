package "main"

import "pkg/builtins/testing"

// A package-level method value (`var mv *func(int) int = g.Add`) captures its
// receiver when the package is initialized (func.method-value.capture); the
// closure record holding it must outlive the package initializer, so `mv` stays
// callable for the whole program.  clobberStack and clobberHeap reuse stack and
// heap memory, so a record left in the initializer's frame would read garbage.

type Leaf struct {
	y int
}

func (l @Leaf) Add(x int) int {
	return x + l.y
}

func mk() @Leaf {
	var l @Leaf = make(Leaf)
	l.y = 40
	return l
}

var g @Leaf = mk()
var mv *func(int) int = g.Add

func clobberStack(n int) int {
	var a [32]int
	for i := 0; i < 32; i++ {
		a[i] = 1000000 + i + n
	}
	if n > 0 {
		return clobberStack(n - 1) + a[n % 32] - a[n % 32]
	}
	return 0
}

func clobberHeap() {
	var a @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ {
		a[i] = 2000000 + i
	}
}

func main() {
	testing.Println(clobberStack(8))
	clobberHeap()
	testing.Println(mv(2))
}
