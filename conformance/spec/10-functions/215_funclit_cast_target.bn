package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A function literal operand of `cast` / `unsafe_cast` takes the target type as
// its destination (func.lit.inferred-default, conv.cast): cast to a raw *func,
// the literal is a closure kept in the enclosing frame, so the result stays
// callable after the statement; cast to a named function-value type, the
// literal constructs a value of that type.  clobber reuses freed heap memory, so
// a closure left on the heap and freed at the end of its statement would read
// garbage.  A managed capture's reference is released with its closure, so the
// captured Leaf's refcount is back to its starting value once castManaged
// returns; rc discounts the reference its own parameter holds.

type Fn *func(int) int
type MFn @func(int) int

type Leaf struct {
	y int
}

func rc(l @Leaf) int {
	return rt.Refcount(bit_cast(*uint8, l)) - 1
}

func castManaged(l @Leaf) int {
	var m = cast(MFn, func(x int) int { return x + l.y })
	var u = unsafe_cast(Fn, func(x int) int { return x * l.y })
	var a = cast(@func(int) int, func(x int) int { return x - l.y })
	clobber()
	testing.Println("in castManaged", rc(l))
	return m(1) + u(2) + a(3)
}

func clobber() {
	var a @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ {
		a[i] = 1000000 + i
	}
}

func main() {
	var k int = 7

	var g = cast(*func(int) int, func(x int) int { return x + k })
	clobber()
	testing.Println(g(1))

	var u = unsafe_cast(*func(int) int, func(x int) int { return x * k })
	clobber()
	testing.Println(u(2))

	var f Fn = cast(Fn, func(x int) int { return x - k })
	clobber()
	testing.Println(f(10))

	var m = cast(MFn, func(x int) int { return x + 2 * k })
	testing.Println(m(1))

	var l @Leaf = make(Leaf)
	l.y = 5
	testing.Println(castManaged(l), rc(l))
}
