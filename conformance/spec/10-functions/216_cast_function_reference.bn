package "main"

import "pkg/builtins/testing"

// A cast of a function REFERENCE to a function-value type means the same as the
// implicit conversion (conv.cast part 1, func.ref.decay): `cast(*func(int) int,
// add1)` is the function value `add1` decays to, raw or managed, named or not.

type Fn *func(int) int
type MFn @func(int) int

func add1(x int) int {
	return x + 1
}

type S struct {
	k int
}

func (s @S) Println(v int) int {
	return v + s.k
}

// A local variable that shadows an import (`testing`) makes `testing.Println` a
// method value on the variable, not the package's function.
func shadowedImport() int {
	var testing @S = make(S)
	testing.k = 1000
	var i = cast(*func(int) int, testing.Println)
	var j *func(int) int = testing.Println
	return i(42) + j(1)
}

func main() {
	var r = cast(*func(int) int, add1)
	var f = cast(Fn, add1)
	var m = cast(MFn, add1)
	var a = cast(@func(int) int, add1)
	testing.Println(r(1), f(2), m(3), a(4))
	testing.Println(shadowedImport())
}
