package "main"

import "pkg/builtins/testing"

// In a generic body, a function literal cast to a type parameter T takes T as
// its destination in each instantiation (func.lit.inferred-default, conv.cast):
// instantiated with a raw *func type, the literal is a closure kept in the
// frame, so the cast's result stays callable after its statement.  clobber
// reuses freed heap memory, so a closure left on the heap and freed at the end
// of its statement would read garbage.

type RF = *func(int) int
type MF = @func(int) int

func clobber() {
	var a @[]int = make_slice(int, 8)
	for i := 0; i < 8; i++ {
		a[i] = 1000000 + i
	}
}

func viaCast[T any](k int) int {
	var g = cast(T, func(x int) int { return x + k })
	clobber()
	var h *func(int) int = cast(*func(int) int, g)
	return h(1)
}

func viaUnsafeCast[T any](k int) int {
	var g = unsafe_cast(T, func(x int) int { return x * k })
	clobber()
	var h *func(int) int = cast(*func(int) int, g)
	return h(2)
}

func main() {
	testing.Println(viaCast[RF](7), viaUnsafeCast[RF](7))
	testing.Println(viaCast[MF](7), viaUnsafeCast[MF](7))
}
