package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A managed function value built from a function reference, a generic-function
// instance or a non-capturing literal owns a reference to its closure record,
// and every such value is released: one discarded (`_ = ident[int]`), passed to
// an @func parameter or a variadic one, relabeled by a cast, returned, stored
// into a struct / array / managed-slice literal, boxed, parallel-assigned, or
// passed to a deferred call leaves the record's refcount where it was
// (func.closure.captured; mem.no-leak).  dataRc reads the refcount of a
// function value's data word — the closure record, where the implementation
// keeps one (the bytecode interpreter's shared per-function record), and 0 where
// a non-capturing value's data word is null (compiled code) — so every delta
// printed is 0 in every mode.

type MFn @func(int) int

type AF = @func(int) int

type Box struct {
	f AF
}

func add1(x int) int {
	return x + 1
}

func ident[T any](x T) T {
	return x
}

func apply(f @func(int) int, x int) int {
	return f(x)
}

func give() AF {
	return add1
}

func vsum(fs ...AF) int {
	var s int = 0
	for f in fs {
		s = s + f(1)
	}
	return s
}

func deferred(i int) int {
	defer apply(add1, i)
	return i
}

func dataRc(f @func(int) int) int {
	var w [2]*uint8 = bit_cast([2]*uint8, f)
	if w[1] == nil {
		return 0
	}
	return rt.Refcount(w[1])
}

func main() {
	var pa @func(int) int = add1
	var pi @func(int) int = ident[int]
	var a0 int = dataRc(pa)
	var i0 int = dataRc(pi)
	var s int = 0
	for i := 0; i < 10; i++ {
		_ = ident[int]
		s = s + apply(add1, i) + apply(ident[int], i)
		var m MFn = add1
		var c = cast(@func(int) int, add1)
		var r *func(int) int = add1
		s = s + m(i) + c(i) + r(i)
		s = s + apply(func(x int) int { return x * 2 }, i)
		var g AF = give()
		var bx Box = Box{f: add1}
		var arr [2]AF = [2]AF{add1, ident[int]}
		var sl @[]AF = @[]AF{add1, ident[int]}
		var u AF
		var w AF
		u, w = add1, ident[int]
		var bp @AF = box(ident[int])
		s = s + g(i) + bx.f(i) + arr[0](i) + arr[1](i) + sl[0](i) + sl[1](i)
		s = s + vsum(add1, ident[int]) + u(i) + w(i) + deferred(i)
		_ = bp
	}
	testing.Println(s)
	testing.Println("add1 delta", dataRc(pa) - a0)
	testing.Println("ident delta", dataRc(pi) - i0)
}
