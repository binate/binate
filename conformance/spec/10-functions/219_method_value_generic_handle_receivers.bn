package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A method value binds its receiver as the call would (func.method-value.capture),
// whatever the receiver's form: a read-only handle (`readonly @Box[T]`,
// `readonly *Box[T]`) on a generic instance captures the handle — the method
// reads the same object — and a distinct named type over a generic instance
// (`type W Box[int]`, with its own methods) captures a W.  The captures are
// released after use.

type Box[T any] struct {
	v T
	s @[]int
}

func (b readonly @Box[T]) hman(n int) { testing.Println("hman", n, len(b.s)) }

func (b readonly *Box[T]) hptr(n int) { testing.Println("hptr", n, len(b.s)) }

type W Box[int]

func (w W) wv(n int) { testing.Println("wv", n, w.v, len(w.s)) }

func mk(k int) @Box[int] {
	var b @Box[int] = make(Box[int])
	b.v = k
	b.s = make_slice(int, k)
	return b
}

func run() {
	var b @Box[int] = mk(3)
	var f *func(int) = b.hman
	f(4)
	f = b.hptr
	f(5)
	var w W
	w.v = 6
	w.s = make_slice(int, 2)
	f = w.wv
	f(7)
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	run()
	var live int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - live)
}
