package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A method value binds its receiver as the call would (func.method-value.capture,
// func.method.smoothing), read-only receivers included: a `readonly *T` handle
// method or a `*readonly T` method taken from an addressable T value captures
// the value's address, a `readonly T` method taken through a pointer captures a
// copy, and a `readonly *T` handle method taken from an `@T` captures the same
// address, raw.  An addressable value reached as a field, an element, or of a
// generic instance is captured by its address too.

type T struct {
	k int
	s @[]int
}

func (r readonly *T) hpro(n int) { testing.Println("hpro", n, r.k, len(r.s)) }

func (r *readonly T) pro(n int) { testing.Println("pro", n, r.k, len(r.s)) }

func (r readonly T) vro(n int) { testing.Println("vro", n, r.k, len(r.s)) }

type S struct {
	t T
}

type Box[U any] struct {
	v U
	k int
}

func (b readonly *Box[U]) bh(n int) { testing.Println("bh", n, b.k) }

func run() {
	var t T
	t.k = 5
	t.s = make_slice(int, 3)
	t.hpro(0)
	var f *func(int) = t.hpro
	f(1)
	f = t.pro
	f(2)
	var pt *T = &t
	f = pt.vro
	f(3)
	var mt @T = make(T)
	mt.k = 9
	mt.s = make_slice(int, 1)
	f = mt.hpro
	f(4)
	var s S
	s.t.k = 6
	f = s.t.hpro
	s.t.k = 7
	f(5)
	var arr [2]T
	arr[1].k = 8
	f = arr[1].hpro
	f(6)
	var bx Box[int]
	bx.k = 10
	f = bx.bh
	bx.k = 11
	f(7)
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	run()
	var live int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - live)
}
