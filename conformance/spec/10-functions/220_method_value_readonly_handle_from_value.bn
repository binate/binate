package "main"

import "pkg/builtins/testing"

// A method value of a `readonly *T` handle-receiver method taken from an
// addressable value captures the value's address, as the call `t.hpro(1)` takes
// it (func.method-value.capture, func.method.smoothing).

type T struct {
	k int
	s @[]int
}

func (r readonly *T) hpro(n int) { testing.Println(n, r.k, len(r.s)) }

func main() {
	var t T
	t.k = 5
	t.s = make_slice(int, 3)
	t.hpro(0)
	var f *func(int) = t.hpro
	f(1)
}
