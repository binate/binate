package "main"

import "pkg/builtins/testing"

// A method value of a generic instance whose method's own signature names the
// instance — as a parameter, a result, a pointer, a variadic element, one of
// several results — binds its receiver and takes the instance's arguments and
// results as a call would (func.method-value.capture), also when its type is
// inferred, when taken inside a generic body or a method of the same generic
// type, and for a non-generic receiver whose method names an instance.

type Box[T any] struct {
	x T
	a int
}

func (b Box[T]) gx(y Box[T]) Box[T] {
	var r Box[T]
	r.a = b.a + y.a
	return r
}

func (b Box[T]) gp(y *Box[T]) int { return b.a + y.a }

func (b Box[T]) gm(ys ...Box[T]) (Box[T], int) {
	var r Box[T]
	r.a = b.a
	for i := 0; i < len(ys); i++ {
		r.a = r.a + ys[i].a
	}
	return r, len(ys)
}

func inGeneric[U any](b Box[U], y Box[U]) int {
	var g *func(Box[U]) Box[U] = b.gx
	return g(y).a
}

func (b Box[T]) viaOwn(y Box[T]) int {
	var g *func(Box[T]) Box[T] = b.gx
	return g(y).a
}

type P struct {
	k int
}

func (p P) f(b Box[int]) Box[int] {
	var r Box[int]
	r.a = p.k + b.a
	return r
}

func main() {
	var b Box[int]
	b.a = 2
	var y Box[int]
	y.a = 20
	var g *func(Box[int]) Box[int] = b.gx
	testing.Println(g(y).a)
	var p *func(*Box[int]) int = b.gp
	testing.Println(p(&y))
	var m *func(...Box[int]) (Box[int], int) = b.gm
	var r Box[int]
	var n int
	r, n = m(y, y)
	testing.Println(r.a, n)
	testing.Println(inGeneric[int](b, y))
	g2 := b.gx
	testing.Println(g2(y).a)
	testing.Println(b.viaOwn(y))
	var pp P
	pp.k = 5
	var pf *func(Box[int]) Box[int] = pp.f
	testing.Println(pf(y).a)
}
