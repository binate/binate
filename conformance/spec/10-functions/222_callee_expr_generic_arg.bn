package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A call whose callee is an expression — a call result, an immediately invoked
// function literal, a dereference — binds a generic instance with a managed
// field as any by-value argument (copied in, released after the call).

type Node[T any] struct {
	v T
	s @[]int
}

func cnt(n Node[int]) int { return n.v * 10 + len(n.s) }

func getf() *func(Node[int]) int { return cnt }

func run() {
	var a Node[int]
	a.v = 3
	a.s = make_slice(int, 2)
	testing.Println(getf()(a))
	testing.Println(func(n Node[int]) int { return n.v + len(n.s) }(a))
	var pf *func(Node[int]) int = cnt
	var ppf **func(Node[int]) int = &pf
	testing.Println((*ppf)(a))
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	run()
	var live int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - live)
}
