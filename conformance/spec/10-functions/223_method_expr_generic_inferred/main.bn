package "main"

import "pkg/builtins/testing"
import "pkg/home"

// func.method-expr (§10.11): a method expression off a generic type instance
// (`Box[int].Get`) is a function value, also where the variable it initializes
// takes its type from it -- `var f = …`, `f := …`, a parallel `:=` -- for a
// pointer and a value receiver, inside a generic function (`Box[T].Get`), off an
// instance of a generic type that is not a struct (`Sl[int].Count`), and off an
// instance of another package's generic type (`home.Box[int].Get`).

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() T { return b.v }

func (b Box[T]) Peek() T { return b.v }

type Sl[T any] @[]T

func (s Sl[T]) Count() int { return len(s) }

func viaGeneric[T any](b *Box[T]) T {
	g := Box[T].Get
	return g(b)
}

func main() {
	var b Box[int]
	b.v = 5
	var f = Box[int].Get
	testing.Println(f(&b))
	g := Box[int].Get
	testing.Println(g(&b))
	p := Box[int].Peek
	testing.Println(p(b))
	q, r := Box[int].Get, Box[int].Peek
	testing.Println(q(&b) + r(b))
	testing.Println(viaGeneric[int](&b))
	var s Sl[int] = cast(Sl[int], make_slice(int, 3))
	c := Sl[int].Count
	testing.Println(c(s))

	var h home.Box[int]
	h.V = 7
	var hf = home.Box[int].Get
	testing.Println(hf(&h))
	hg := home.Box[int].Get
	testing.Println(hg(&h))
	hp := home.Box[int].Peek
	testing.Println(hp(h))
}
