package "main"

// iface.decl: an interface is declared at package scope with method
// signatures (name + Signature, no receiver, no body); method names
// must be unique; an empty body is allowed; a signature may reference
// the interface being declared (here `peer() *Shape`, an interface-
// value result) and may use `Self` (here `eq(other Self) bool`).
// Empty and MultiReturn exercise the empty-body and multi-result
// signature forms. A concrete impl satisfies Shape, and a non-Self
// method is dispatched through a `*Shape` value to confirm the
// declaration produced a usable interface. The Self-using method `eq`
// is declared and impl-covered (exercising Self substitution at impl
// time) but is not called here; it is object-unsafe through an iface
// value (the dispatch-rejection is covered separately by 067).

interface Empty {
}

interface Shape {
	area() int
	peer() *Shape
	eq(other Self) bool
}

interface MultiReturn {
	pair() (int, int)
}

type Square struct {
	side int
}

func (s *Square) area() int {
	return s.side * s.side
}

func (s *Square) peer() *Shape {
	return s
}

func (s *Square) eq(other Square) bool {
	return s.side == other.side
}

impl *Square : Shape

func main() {
	var sq Square
	sq.side = 6
	var iv *Shape = &sq
	if iv.area() == 36 {
		println("ok")
	} else {
		println("FAIL")
	}
}
