package "main"

// iface.value.spelling: a bare interface name is NOT a usable value
// type. An interface used as a value must be spelled `*Greeter`
// (raw) or `@Greeter` (managed); `var g Greeter` is an error that
// directs the user to the pointer-shaped forms.

interface Greeter {
	greet()
}

func main() {
	var g Greeter
	_ = g
}
