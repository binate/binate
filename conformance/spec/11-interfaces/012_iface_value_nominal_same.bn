package "main"

// iface.value.repr (positive side): interface-value type identity is NOMINAL
// -- it is determined by the INTERFACE (package + name) and the kind, NOT by
// the backing concrete type. So `*T1` and `*T2`, two DIFFERENT concrete types
// that both impl Speaker, each construct the SAME interface-value type
// `*Speaker`; a single function typed `*Speaker` accepts both, and dispatch
// follows each value's own backing. (The complementary nominal-DISTINCTNESS
// direction -- two different interfaces do not agree -- is the negative 013.)

interface Speaker {
	speak() int
}

type T1 struct {
	v int
}

type T2 struct {
	v int
}

func (t *T1) speak() int {
	return t.v
}

func (t *T2) speak() int {
	return t.v * 10
}

impl *T1 : Speaker
impl *T2 : Speaker

// One signature, one nominal interface-value type *Speaker -- it accepts a
// value backed by either concrete type because the type is the interface.
func dispatch(s *Speaker) int {
	return s.speak()
}

func main() {
	var a T1
	a.v = 4
	var b T2
	b.v = 5
	var s1 *Speaker = &a       // *T1 -> *Speaker
	var s2 *Speaker = &b       // *T2 -> *Speaker (same nominal type, different backing)
	if dispatch(s1) == 4 && dispatch(s2) == 50 {
		println("ok")
	} else {
		println("FAIL")
	}
}
