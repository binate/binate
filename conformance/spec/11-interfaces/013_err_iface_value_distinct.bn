package "main"

// iface.value.repr (constraint side): interface-value identity is
// nominal, not structural. Reader and Writer are DISTINCT interfaces
// that happen to have identical method sets (`run() int`); a value of
// one is not assignable to the other. Having the right methods is
// never enough -- only a matching `impl` plus the same nominal
// interface makes two interface-value types agree.

interface Reader {
	run() int
}

interface Writer {
	run() int
}

type T struct {
	v int
}

func (t *T) run() int {
	return t.v
}

impl *T : Reader

func main() {
	var t T
	t.v = 1
	var r *Reader = &t
	var w *Writer = r        // *Reader -> *Writer: distinct interfaces, rejected
	_ = w
}
