package "main"

// iface.value.no-readonly-slot: there is no inner `readonly` slot on an
// interface value. An OUTER `readonly @Getter` is just the ordinary
// `readonly` modifier wrapping the whole interface value -- a read-only
// HANDLE view. The `readonly` wrapper is peeled before dispatch, so a
// method still dispatches through the handle. (Read-only DISPATCH is a
// separate concern, expressed via readonly receivers in the impl.)

interface Getter {
	get() int
}

type Impl struct {
	v int
}

func (im *Impl) get() int {
	return im.v
}

impl *Impl : Getter

func main() {
	var im @Impl = make(Impl)
	im.v = 42
	var g @Getter = im              // managed interface value
	var rg readonly @Getter = g     // read-only handle view of the whole value
	if rg.get() == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
