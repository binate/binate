package "main"

// iface.value.no-readonly-slot (constraint side): there is no inner
// `readonly` slot on an interface value -- `*readonly Greeter` is not
// a valid type. `readonly Greeter` is the bare interface name under a
// `readonly` modifier, which is not a usable type expression (a bare
// interface name is only usable as `*Greeter` / `@Greeter`); an outer
// `readonly *Greeter` would be the read-only handle form (see
// 014_iface_readonly_handle). This pins that the inner form errors.

interface Greeter {
	greet()
}

func main() {
	var g *readonly Greeter
	_ = g
}
