package "main"

// iface.decl (constraint): within one interface, method NAMES must be
// unique. `foo` is declared twice (with different signatures, to make
// clear it is the NAME that collides, not the signature) -- rejected at
// interface-decl time. (A same-name conflict across EXTENDED ancestors
// is a different rule, iface.extend, covered by 044.)

interface I {
	foo() int
	foo() bool
}

func main() {
	println("ignored")
}
