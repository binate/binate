package "main"
import "pkg/builtins/testing"

// iface.decl (constraint): there is NO `type X interface { ... }` form
// and no anonymous interface type. Interfaces are declared with the
// dedicated `interface Name { ... }` syntax (this file uses the wrong
// `type ... interface` shape). The `interface` keyword in a type-
// expression position is not a valid type, so the declaration is
// rejected at parse time.

type X interface {
	foo() int
}

func main() {
	testing.Println("ignored")
}
