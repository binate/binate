package "main"

// iface.decl (constraint): a MethodSig is a name + Signature with NO
// receiver and NO body. Giving an interface method a body (`foo() { }`)
// is rejected. (A receiver-looking first parameter like `foo(self *T)`
// is just an ordinary parameter, not a receiver, so it would parse; the
// body is the unambiguous violation of the no-body rule.)

interface I {
	foo() {
	}
}

func main() {
	println("ignored")
}
