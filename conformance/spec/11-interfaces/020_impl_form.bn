package "main"
import "pkg/builtins/testing"

// iface.impl.form: an `impl R : I, J` is the keyword, a single receiver R, a
// colon, and a non-empty comma-separated interface list, with NO body. R may
// be any of the five receiver shapes and must reduce to a named type. This
// exercises four shapes -- value `T`, raw `*Pipe` (with a two-interface list),
// `*readonly V`, and managed `@Obj` -- AND actually dispatches a method through
// an interface value constructed over EACH, so every impl is shown to satisfy
// (not merely parse). (The fifth shape `@readonly` is exercised in the cluster
// gaps follow-up.)

interface Reader {
	read() int
}

interface Writer {
	write() int
}

// Value-receiver impl: R is the bare named type T.
type T struct {
	x int
}
func (t T) read() int { return t.x }
impl T : Reader

// Raw-pointer receiver with a two-interface list: R is *Pipe.
type Pipe struct {
	n int
}
func (p *Pipe) read() int { return p.n }
func (p *Pipe) write() int { return p.n + 1 }
impl *Pipe : Reader, Writer

// *readonly receiver.
type V struct {
	v int
}
func (w *readonly V) read() int { return w.v }
impl *readonly V : Reader

// Managed receiver: R is @Obj.
type Obj struct {
	k int
}
func (o @Obj) read() int { return o.k }
impl @Obj : Reader

func main() {
	// Dispatch through an interface value constructed over each receiver shape.
	var t T
	t.x = 7
	var rt *Reader = &t                  // value-receiver impl, smoothed to *Reader

	var p Pipe
	p.n = 41
	var rp *Reader = &p                  // raw-pointer impl
	var wp *Writer = &p                  // two-interface list: also a Writer

	var v V
	v.v = 9
	var rv *Reader = &v                  // *readonly-receiver impl

	var o @Obj = make(Obj)
	o.k = 3
	var ro @Reader = o                   // managed-receiver impl

	if rt.read() == 7 && rp.read() == 41 && wp.write() == 42 &&
			rv.read() == 9 && ro.read() == 3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
