package "main"
import "pkg/builtins/testing"

// iface.impl.form (comma-separated interface list): a single
// `impl *T : I, J` asserts satisfaction of TWO interfaces at once.
// Both must then be usable as the value type and dispatch correctly.
// This sharpens 020 on the non-empty comma-list clause of the form
// rule -- one impl, two interface values, two dispatched methods.

interface Greeter {
	greet() int
}

interface Counter {
	count() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int { return h.x }
func (h *Hello) count() int { return h.x * 2 }

impl *Hello : Greeter, Counter

func main() {
	var h Hello
	h.x = 5
	var g *Greeter = &h
	var c *Counter = &h
	if g.greet() == 5 && c.count() == 10 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
