package "main"

// iface.impl.nominal (Constraint): Binate interfaces are NOMINAL --
// there is NO duck typing. T below has a `speak()` method matching
// Speaker's signature exactly, but there is NO `impl T : Speaker`,
// so a concrete `*T` does NOT satisfy `*Speaker`. The interface-value
// construction must be rejected at compile time. Having the right
// methods is never sufficient on its own.

interface Speaker {
	speak() int
}

type T struct {
	v int
}

// Matching method present, but NO `impl T : Speaker` is declared.
func (t *T) speak() int { return t.v }

func main() {
	var t T
	t.v = 1
	var s *Speaker = &t
	_ = s
}
