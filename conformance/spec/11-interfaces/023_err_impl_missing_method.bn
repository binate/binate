package "main"
import "pkg/builtins/testing"

// iface.impl.coverage (Constraint): `impl R : I` requires R's named
// type to provide a method for EVERY method in I. Here Stringer needs
// `toString`, but T declares no such method, so the impl must error.

interface Stringer {
	toString() *[]readonly char
}

type T struct {
	x int
}

// No `toString` method declared on T -- impl must error.

impl T : Stringer

func main() {
	testing.Println("ignored")
}
