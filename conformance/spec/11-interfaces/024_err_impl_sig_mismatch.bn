package "main"

// iface.impl.coverage (Constraint): a method matches only if, after
// dropping the receiver, the non-receiver parameter and result types
// are identical to the interface method's. Here T declares a method
// named `read` (same name as Reader.read) but with the WRONG result
// type (it returns nothing instead of int), so the impl must error:
// a same-name-but-wrong-signature method does NOT satisfy coverage.

interface Reader {
	read() int
}

type T struct {
	x int
}

// Same name `read`, but no result -- signature does not match.
func (t *T) read() { }

impl *T : Reader

func main() {
	println("ignored")
}
