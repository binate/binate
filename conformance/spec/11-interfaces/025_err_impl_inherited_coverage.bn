package "main"
import "pkg/builtins/testing"

// iface.impl.coverage (Constraint): coverage is over the FULL method
// set of the listed interface -- its own methods PLUS all inherited
// from extended parents (Section 11.6). Child extends Parent; T
// provides Child's own method `b` but NOT the inherited `a`, so
// `impl *T : Child` must error on the missing inherited method.

interface Parent {
	a() int
}

interface Child : Parent {
	b() int
}

type T struct {
	x int
}

// Provides only Child's own method, not the inherited Parent.a.
func (t *T) b() int { return t.x }

impl *T : Child

func main() {
	testing.Println("ignored")
}
