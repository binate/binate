package "main"

// iface.impl.form documents that the impl receiver R must reduce to a
// NAMED type. A receiver spelled via a TYPE ALIAS is currently
// REJECTED -- the spec Section 11.3 MAJOR open gap: peeling the alias so
// the impl type-checks would produce a runtime SIGSEGV at dispatch
// (the vtable/closure lowering does not peel the alias), so rejecting
// is the deliberate safe behavior. This test pins that rejecting
// behavior. NOTE: this is a `> _Open / known gap_` prose note with no
// declared rule-ID of its own; it is cited under iface.impl.form.
// XFAIL-INVERT-WHEN-FIXED: once alias peeling lands (the §11.3 hold is
// resolved), this impl SHOULD be accepted -- flip this test to a positive
// (or delete it) rather than leaving the rejection in place.

interface Getter {
	get() int
}

type Box struct {
	v int
}

func (b *Box) get() int { return b.v }

// Alias of a pointer-to-named-type, used as the impl receiver.
type BoxAlias = *Box

impl BoxAlias : Getter

func main() {
	println("ignored")
}
