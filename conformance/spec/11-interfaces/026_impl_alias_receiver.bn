package "main"
import "pkg/builtins/testing"

// iface.impl.form: the impl receiver R must reduce to a NAMED type.  A receiver
// spelled via a TYPE ALIAS reduces to its target's named type -- an alias is
// transparent to its target -- so `impl BoxAlias : Getter` (where
// `type BoxAlias = *Box`) is `impl *Box : Getter` and is accepted.  Dispatch
// through the resulting interface value lands on the target's method: the
// checker peels the alias for impl-satisfaction (Type.ReceiverBaseNamed) and
// IR-gen keys the vtable on the TARGET's short name (recvBaseNameAndPkg), so
// the method slot is filled rather than left null.

interface Getter {
	get() int
}

type Box struct {
	v int
}

func (b *Box) get() int { return b.v }

// Alias of a pointer-to-named-type, used as the impl receiver.
type BoxAlias = *Box

impl BoxAlias : Getter

func main() {
	var b Box = Box{v: 41}
	var g *Getter = &b
	testing.Println(g.get())
}
