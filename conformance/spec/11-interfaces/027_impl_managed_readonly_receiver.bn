package "main"
import "pkg/builtins/testing"

// iface.impl.form: the five receiver shapes are `T`, `*T`, `*readonly T`,
// `@T`, `@readonly T`. The landed 020 exercises four; this adds the fifth --
// a managed read-only receiver `@readonly Obj`. The impl `impl @readonly Obj :
// I` is constructed as a `@I` over a `@Obj` source (smoothing `@T` -> `@readonly
// T` adds object-readonly, which is the safe direction; sec 10.5) and a method
// is actually dispatched through the interface value, so the impl is shown to
// satisfy and dispatch -- not merely to parse.

interface I {
	m() int
}

type Obj struct {
	k int
}

// Managed read-only receiver: the fifth shape.
func (x @readonly Obj) m() int { return x.k }
impl @readonly Obj : I

func main() {
	var o @Obj = make(Obj)
	o.k = 11
	var iv @I = o                        // @Obj smooths to @readonly-receiver impl
	if iv.m() == 11 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
