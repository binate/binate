package "main"
import "pkg/builtins/testing"

// iface.impl.coverage (Constraint): the impl method's declared receiver kind
// must be reachable from R's declared receiver kind by the same safe-direction
// smoothing as a method call (sec 10.5). Here R is `*readonly Box` (a read-only
// OBJECT) but Box's only `m` method is declared on the mutable receiver `*Box`.
// Smoothing from a read-only object to a mutable one DROPS object-readonly,
// which is the rejected direction (func.method.object-const) -- so the impl
// does not cover I and must be rejected.

interface I {
	m() int
}

type Box struct {
	x int
}

// The sole `m` on Box wants a MUTABLE object (`*Box`).
func (b *Box) m() int { return b.x }

// R is `*readonly Box`: a read-only object. Reaching the mutable `*Box`
// receiver would drop object-readonly -- not a safe smoothing direction.
impl *readonly Box : I

func main() {
	testing.Println("ignored")
}
