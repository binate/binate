package "main"

// iface.construct.box / iface.construct.no-implicit: a value-typed
// source (`var h Hello`) is made pointer-shaped with an EXPLICIT
// `&h` (a *T borrow) to construct a raw `*Greeter`. No implicit
// address-of is performed by the language; the `&` is the user's
// explicit decision. Dispatch through the constructed iv confirms
// the {data, vtable} value is well-formed.

interface Greeter {
	greet() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int {
	return h.x
}

impl *Hello : Greeter

func main() {
	var h Hello
	h.x = 7
	var iv *Greeter = &h
	if iv.greet() == 7 {
		println("ok")
	} else {
		println("FAIL")
	}
}
