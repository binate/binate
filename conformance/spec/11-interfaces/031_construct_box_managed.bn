package "main"
import "pkg/builtins/testing"

// iface.construct.box (managed side) / iface.construct.no-implicit:
// a value-typed source is made pointer-shaped first with `box(h)`,
// which heap-allocates a managed copy (@Hello), and that @T then
// constructs a `@Greeter`. No implicit box is performed by the
// language; the `box(...)` is written explicitly. The constructed
// managed iv owns its own reference and dispatch works.

interface Greeter {
	greet() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int {
	return h.x
}

impl *Hello : Greeter

func main() {
	var h Hello
	h.x = 9
	var iv @Greeter = box(h)
	if iv.greet() == 9 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
