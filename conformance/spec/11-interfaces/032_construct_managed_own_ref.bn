package "main"

// iface.construct.managed: a @T constructing a @Iface takes its
// OWN reference (the managed iv's data slot is reference-counted).
// Here a @Hello (from make) constructs a @Greeter directly; dispatch
// through it observes the payload. This pins compile-acceptance and
// dispatch of the @T -> @Iface construction; it does not drop the
// source @T before dispatching, so it does not behaviorally observe
// the lifetime extension (refcount balance is covered by
// 567_iface_lifecycle_balance).

interface Greeter {
	greet() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int {
	return h.x
}

impl *Hello : Greeter

func main() {
	var h @Hello = make(Hello)
	h.x = 5
	var iv @Greeter = h
	if iv.greet() == 5 {
		println("ok")
	} else {
		println("FAIL")
	}
}
