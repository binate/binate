package "main"

// iface.construct.managed: a @T may instead construct a RAW
// `*Iface` (a borrow -- no reference is taken). The managed @Hello
// stays alive for the surrounding scope, so the raw iv sees a valid
// data pointer. This pins compile-acceptance and dispatch of the
// @T -> *Iface borrow; the "no reference taken" property itself is
// not observable through stdout (a wrongly-taken ref would leak, not
// change the output).

interface Greeter {
	greet() int
}

type Hello struct {
	x int
}

func (h *Hello) greet() int {
	return h.x
}

impl *Hello : Greeter

func main() {
	var h @Hello = make(Hello)
	h.x = 3
	var iv *Greeter = h
	if iv.greet() == 3 {
		println("ok")
	} else {
		println("FAIL")
	}
}
