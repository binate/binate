package "main"

// iface.construct.value-borrow (restriction): a NON-addressable value source
// -- here the call result `mkT()` -- constructing a raw `*Iface` must be
// materialized into a statement temporary, which is released at the end of its
// statement.  So the implicit borrow is admitted only where it cannot outlive
// that temporary (an argument, or a var/`:=` initializer); an ASSIGNMENT into a
// pre-existing location that outlives the statement would leave the interface
// value dangling, so it is a compile error.  (An ADDRESSABLE source would
// instead borrow by an implicit `&`; a call result is not addressable.)  This
// must be rejected at compile time.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func mkT() T {
	var t T
	return t
}

func main() {
	var iv *I
	iv = mkT()
	_ = iv
}
