package "main"

// iface.construct.no-implicit (Constraint): constructing a raw
// `*Iface` from a VALUE-typed source `T` admits no implicit
// address-of. The interface value can outlive the source's
// storage, so the language refuses to silently capture a
// reference -- the user must write `&t` explicitly. This must be
// rejected at compile time.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var iv *I = t
	_ = iv
}
