package "main"

// iface.construct.no-implicit (Constraint) / iface.construct.box:
// constructing a managed `@Iface` from a VALUE-typed source `T`
// admits no implicit box. The user must lift `t` to a @T first
// (e.g. `box(t)`); the language performs no silent heap copy.
// This must be rejected at compile time.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var iv @I = t
	_ = iv
}
