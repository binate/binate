package "main"

// iface.construct.managed (Constraint side): a RAW `*T` cannot
// construct a `@Iface` -- *T has no refcount header, so promoting
// it to a managed iface value (which owns its data ref via RefInc)
// would invent a reference count. This must be rejected at compile
// time.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() { }

impl *T : I

func main() {
	var t T
	var p *T = &t
	var iv @I = p
	_ = iv
}
