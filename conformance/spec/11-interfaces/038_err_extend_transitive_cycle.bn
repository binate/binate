package "main"
import "pkg/builtins/testing"

// iface.extend (constraint): the ancestor graph must be acyclic. Unlike
// 043 (DIRECT self-extension `interface A : A`), this is a transitive
// cycle across two DISTINCT interfaces: A extends B and B extends A.  A
// parent may be declared after its child, so A's parent B resolves; the
// edge B -> A would close the cycle and is REJECTED as an extension cycle.

interface A : B {
	foo() int
}

interface B : A {
	bar() int
}

func main() {
	testing.Println("ignored")
}
