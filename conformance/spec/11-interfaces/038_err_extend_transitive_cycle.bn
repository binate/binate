package "main"
import "pkg/builtins/testing"

// iface.extend (constraint): the ancestor graph must be acyclic. Unlike
// 043 (DIRECT self-extension `interface A : A`), this is a transitive
// cycle across two DISTINCT interfaces: A extends B and B extends A. The
// cycle is statically impossible because parents resolve at decl time --
// when A is checked, B is not yet declared -- so the failure surfaces
// asymmetrically (likely as `undefined` on B rather than a cycle
// message). Either way the program must be REJECTED.

interface A : B {
	foo() int
}

interface B : A {
	bar() int
}

func main() {
	testing.Println("ignored")
}
