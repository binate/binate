package "main"
import "pkg/builtins/testing"

// iface.extend.transitive (managed direct-construction clause): the rule
// states `@R` (as well as `*R`) may be used DIRECTLY wherever an ANCESTOR
// interface value is expected. With `impl @T : C` (C : B : A), `var a @A = t`
// (t a @T) constructs the ancestor `@A` directly -- assignability walks the
// implemented interface's ancestor chain. The managed twin of the raw case 048.

interface A {
	fA() int
}

interface B : A {
	fB() int
}

interface C : B {
	fC() int
}

type T struct { x int }

func (t *T) fA() int { return 1 }
func (t *T) fB() int { return 2 }
func (t *T) fC() int { return 3 }

impl @T : C

func main() {
	var t @T = make(T)
	var a @A = t
	if a.fA() == 1 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
