package "main"

// iface.extend.transitive (managed direct-construction clause): the rule
// states `@R` (as well as `*R`) may be used DIRECTLY wherever an ANCESTOR
// interface value is expected. With `impl @T : C` (C : B : A), `var a @A = t`
// (t a @T) should construct the ancestor `@A` directly.
//
// CURRENTLY REJECTED by the SAME ancestor-walk checker gap as the raw case
// (048): "cannot assign @T to @A". Pinned here as .xfail.all so the eventual
// checker fix is validated for BOTH the raw (048) and managed (039) shapes,
// which should XPASS together. The upcast route works and is covered by 046.

interface A {
	fA() int
}

interface B : A {
	fB() int
}

interface C : B {
	fC() int
}

type T struct { x int }

func (t *T) fA() int { return 1 }
func (t *T) fB() int { return 2 }
func (t *T) fC() int { return 3 }

impl @T : C

func main() {
	var t @T = make(T)
	var a @A = t
	if a.fA() == 1 {
		println("ok")
	} else {
		println("FAIL")
	}
}
