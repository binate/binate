package "main"
import "pkg/builtins/testing"

// iface.any / iface.any.universal: `any` is the predeclared universal
// interface, satisfied by EVERY type with NO `impl` required, used only
// as the two-word interface value `*any` (raw) or `@any` (managed) -- not
// as a bare value type and not as `void*`. Here a plain struct, a managed
// struct, and an interface value all flow into `*any`/`@any` without any
// `impl` declaration. Because `any` has no methods, data cannot be read
// back THROUGH a `@any`; the final assertion reads the managed source
// after it has also been bound as a `@any`, so this pins compile-
// acceptance of the universal `any` (every type, no impl), not data-
// pointer round-tripping.

interface Greeter {
	greet() int
}

type A struct { x int }
type B struct { y int }

func (a *A) greet() int {
	return a.x
}

impl *A : Greeter

func takesRawAny(v *any) {
	testing.Println("raw")
}

func takesMgdAny(v @any) {
	testing.Println("mgd")
}

func main() {
	// Plain struct -> *any, no impl required.
	var a A
	a.x = 1
	var ra *any = &a
	takesRawAny(ra)

	// A different unrelated type -> *any, also no impl.
	var b B
	b.y = 2
	var rb *any = &b
	takesRawAny(rb)

	// An interface value -> *any (upcast to the universal interface).
	var g *Greeter = &a
	var rg *any = g
	takesRawAny(rg)

	// Managed struct -> @any; data preserved (field readable afterward).
	var mb @B = make(B)
	mb.y = 7
	var ma @any = mb
	takesMgdAny(ma)
	if mb.y == 7 { testing.Println("ok") } else { testing.Println("FAIL") }
}
