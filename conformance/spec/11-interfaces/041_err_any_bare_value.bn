package "main"

// iface.any (constraint): bare `any` is rejected as a value type --
// only `*any` (raw) or `@any` (managed) are usable interface values
// (a two-word {data,vtable}, NOT a `void*`). `var x any` must fail to
// compile, the same rule as for any user-declared interface name.

func main() {
	var x any
	_ = x
}
