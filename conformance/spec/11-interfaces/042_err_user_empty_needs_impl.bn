package "main"

// iface.any.universal (contrast / constraint): a user-declared empty
// interface (`interface Empty {}`) is a DISTINCT nominal interface --
// zero methods does NOT make it universal. Unlike `any`, it still
// requires an explicit `impl`. A concrete `*T` with no `impl *T : Empty`
// cannot construct `*Empty`. (Binate interfaces are nominal, not
// structural -- iface.impl.nominal.)

interface Empty {}

type T struct { v int }

func main() {
	var t T
	t.v = 1
	var e *Empty = &t   // ERROR: no `impl *T : Empty`, Empty is not `any`
	_ = e
}
