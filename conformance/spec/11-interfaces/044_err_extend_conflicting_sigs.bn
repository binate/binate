package "main"

// iface.extend (constraint): a method appearing in two ancestors with
// CONFLICTING signatures is an error. P.foo() and Q.foo() int have the
// same name but different signatures, so the extending interface X can
// carry neither -- rejected at interface-decl time. (Same-name
// same-signature through a common ancestor -- a harmless diamond -- is
// allowed and is NOT what this tests.)

interface P {
	foo()
}

interface Q {
	foo() int
}

interface X : P, Q {
}

func main() {
	println("ignored")
}
