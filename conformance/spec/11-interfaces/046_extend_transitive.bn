package "main"
import "pkg/builtins/testing"

// iface.extend.transitive: a single `impl *T : C` over a 3-level chain
// (C : B : A) makes ancestor methods dispatch with no per-ancestor impl.
// The supported route (387_iface_upcast) is: construct the child
// interface value `*C` from the concrete `*T`, then dispatch ancestor
// methods through it AND upcast it to each ancestor interface value
// (iface.extend.upcast); inherited methods resolve via the concatenated
// vtable.  (Direct construction of an ancestor value straight from the
// concrete pointer -- `var a *A = &t` -- is a separate transitive clause
// currently held back by a checker gap; pinned by 048.)

interface A {
	fA() int
}

interface B : A {
	fB() int
}

interface C : B {
	fC() int
}

type T struct { x int }

func (t *T) fA() int { return 1 }
func (t *T) fB() int { return 2 }
func (t *T) fC() int { return 3 }

impl *T : C

func main() {
	var t T
	var c *C = &t
	// One impl on C: ancestor methods fA (from A) and fB (from B) dispatch
	// through the child interface value.
	var dispatch bool = c.fA() == 1 && c.fB() == 2 && c.fC() == 3
	// The child value upcasts to each ancestor; ancestor methods dispatch
	// through the upcast views.
	var a *A = c
	var b *B = c
	var upcast bool = a.fA() == 1 && b.fA() == 1 && b.fB() == 2
	if dispatch && upcast {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
