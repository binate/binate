package "main"

// iface.extend.upcast: a descendant interface value upcasts to an
// ancestor interface value -- raw (`*Child` -> `*Parent`) and managed
// (`@Child` -> `@Parent`). The upcast preserves the data pointer and
// adjusts only the vtable to the ancestor's sub-vtable: a method
// declared on the parent dispatches correctly through the parent view,
// and a value-derived field read after the upcast confirms data is
// preserved.

interface Parent {
	base() int
}

interface Child : Parent {
	extra() int
}

type T struct { v int }

func (t *T) base() int { return t.v }
func (t *T) extra() int { return t.v + 1 }

impl *T : Child
impl @T : Child

func main() {
	// Raw upcast: *Child -> *Parent. Same data ptr, vtable swapped.
	var t T
	t.v = 10
	var rc *Child = &t
	var rp *Parent = rc
	// Managed upcast: @Child -> @Parent.
	var mt @T = make(T)
	mt.v = 20
	var mc @Child = mt
	var mp @Parent = mc
	// Parent-view dispatch returns the preserved data; child view still
	// usable post-upcast.
	if rp.base() == 10 && rc.extra() == 11 &&
			mp.base() == 20 && mc.extra() == 21 {
		println("ok")
	} else {
		println("FAIL")
	}
}
