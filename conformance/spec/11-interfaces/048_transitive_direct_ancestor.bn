package "main"

// iface.extend.transitive (direct-construction clause): a single
// `impl *T : C` (C : B : A) lets `*T` be used DIRECTLY wherever an ANCESTOR
// interface value is expected -- `var a *A = &t` -- not only where the exact
// impl'd interface `*C` is expected.  Assignability walks the implemented
// interface's ancestor chain (here two levels, C -> B -> A).  The upcast route
// (construct *C, then upcast) is the alternative covered by 046; the managed
// twin of this direct construction is 039.

interface A {
	fA() int
}

interface B : A {
	fB() int
}

interface C : B {
	fC() int
}

type T struct { x int }

func (t *T) fA() int { return 1 }
func (t *T) fB() int { return 2 }
func (t *T) fC() int { return 3 }

impl *T : C

func main() {
	var t T
	var a *A = &t
	if a.fA() == 1 {
		println("ok")
	} else {
		println("FAIL")
	}
}
