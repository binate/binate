package "main"

// iface.extend.transitive (direct-construction clause): a single
// `impl *T : C` (C : B : A) should let `*T` be used DIRECTLY wherever an
// ANCESTOR interface value is expected -- `var a *A = &t` -- not only
// where the exact impl'd interface `*C` is expected.
//
// CURRENTLY REJECTED: the type-checker's assignability check does not
// walk the implemented interface's ancestors, so `var a *A = &t` fails
// with "cannot assign *T to *A".  Tracked in claude-todo.md ("impl of a
// SUB-interface is not assignable to its SUPER-interface", 2026-06-19);
// pinned here as .xfail.all so it XPASSes (flags) once the checker walks
// the ancestor chain.  The upcast route (construct *C, then upcast) works
// and is covered green by 046.

interface A {
	fA() int
}

interface B : A {
	fB() int
}

interface C : B {
	fC() int
}

type T struct { x int }

func (t *T) fA() int { return 1 }
func (t *T) fB() int { return 2 }
func (t *T) fC() int { return 3 }

impl *T : C

func main() {
	var t T
	var a *A = &t
	if a.fA() == 1 {
		println("ok")
	} else {
		println("FAIL")
	}
}
