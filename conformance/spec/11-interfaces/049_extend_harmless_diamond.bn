package "main"
import "pkg/builtins/testing"

// iface.extend: a method reaching a descendant through TWO ancestors via
// a COMMON ancestor is NOT a conflict -- it is the same method, so it is
// deduplicated by name (a harmless diamond). A.foo reaches D through both
// B and C, yet D is well-formed: impl a type on D and dispatch foo plus
// each branch method. (The negative -- same name, DIFFERENT signatures
// from unrelated parents -- is 044; this is the allowed positive case.)

interface A {
	foo() int
}

interface B : A {
	fromB() int
}

interface C : A {
	fromC() int
}

interface D : B, C {
}

type T struct {
	x int
}

func (t *T) foo() int { return t.x }
func (t *T) fromB() int { return t.x + 1 }
func (t *T) fromC() int { return t.x + 2 }

impl *T : D

func main() {
	var t T
	t.x = 10
	var d *D = &t
	// A.foo reaches D through both B and C but is one method -- one slot.
	if d.foo() == 10 && d.fromB() == 11 && d.fromC() == 12 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
