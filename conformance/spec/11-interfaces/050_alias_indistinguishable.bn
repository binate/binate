package "main"
import "pkg/builtins/testing"

// iface.alias (§11.7): `interface Counting = Counter` declares Counting as
// an ALIAS — the SAME interface as Counter (same method set, same identity).
// `impl *Box : Counting` is indistinguishable from `impl *Box : Counter`,
// and the method dispatches through EITHER name.  We declare the impl on the
// alias name, then dispatch through both `*Counting` and `*Counter`. If
// Counting were an EXTENSION rather than an alias, `var viaTarget *Counter
// = &b` would be a direct ancestor-from-concrete construction, currently
// rejected by the checker (see 048); it type-checks here only because
// Counting IS Counter (an alias), so the impl on the alias name literally
// covers Counter.

interface Counter {
	bump()
	get() int
}

interface Counting = Counter

type Box struct {
	n int
}

func (b *Box) bump() {
	b.n = b.n + 1
}

func (b *Box) get() int {
	return b.n
}

// impl declared on the ALIAS name.
impl *Box : Counting

func main() {
	var b Box
	b.n = 0

	// Dispatch through the alias name.
	var viaAlias *Counting = &b
	viaAlias.bump()

	// Dispatch through the target name — same impl, same vtable.
	var viaTarget *Counter = &b
	viaTarget.bump()

	if b.get() == 2 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
