package "main"
import "pkg/builtins/testing"

// iface.alias (§11.7): an alias is the SAME interface object as its target, so
// the interface-value types `*Speaking` and `*Speaker` are the SAME type. The
// discriminating direction is target -> alias: construct a `*Speaker`, then
// assign it to a `*Speaking`. If Speaking were an EXTENSION
// (`interface Speaking : Speaker {}`) instead of an alias, `*Speaker ->
// *Speaking` would be a parent -> child conversion, which is ILLEGAL (no
// downcast). It type-checks ONLY because the alias makes the two names one
// interface. (The other direction, *Speaking -> *Speaker, would also hold under
// an extension as a child -> parent upcast, so it would NOT distinguish.)

interface Speaker {
	say() int
}

interface Speaking = Speaker

type Dog struct {
	v int
}

func (d *Dog) say() int {
	return d.v
}

impl *Dog : Speaker

func main() {
	var d Dog
	d.v = 5
	var t *Speaker = &d          // construct through the TARGET name
	var a *Speaking = t          // target -> alias: legal ONLY because same interface
	if a.say() == 5 && t.say() == 5 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
