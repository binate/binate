package "main"

// iface.any (§11.5, Constraint side): `*any` is a TWO-WORD interface
// value {data,vtable}, NOT a `void*` -- the opaque byte pointer is the
// distinct one-word `*uint8` (§7.8). The two types are distinct and not
// interassignable: a `*any` cannot be assigned to a `*uint8`. (The
// reverse direction is also rejected; this pins the forward one.)

type Box struct { x int }

func main() {
	var b Box
	b.x = 1
	var a *any = &b          // ok: plain struct -> *any, no impl required
	var p *uint8 = a         // ERROR: *any is not *uint8 (two-word iv vs byte ptr)
	_ = p
}
