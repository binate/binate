package "main"

// iface.any (§11.5): bare `any` IS allowed in a generic CONSTRAINT
// position, where it means NO constraint (§12) -- distinct from its
// rejection as a bare value type (§11.2/041). A generic func and a
// generic type each take an `any`-constrained type param and accept
// arbitrary, unrelated concrete type args (here `int` and a struct)
// with no impl required, then compile and run.

type Pair struct {
	a int
	b int
}

// `any`-constrained type param on a generic type.
type Box[T any] struct { val T }

// `any`-constrained type param on a generic func; returns its arg
// unchanged (no operations beyond what an unconstrained param allows).
func id[T any](x T) T {
	return x
}

func main() {
	// `any` constraint accepts a scalar...
	var i int = id[int](7)

	// ...and an unrelated struct type, through the generic struct.
	var bp Box[Pair]
	bp.val.a = 3
	bp.val.b = 4

	if i == 7 && bp.val.a == 3 && bp.val.b == 4 {
		println("ok")
	} else {
		println("FAIL")
	}
}
