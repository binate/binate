package "main"

import "pkg/shape"
import "pkg/widget"

// iface.crosspkg.no-orphan (§11.8): there is NO orphan rule.  The interface
// `Area` is declared in pkg/shape; the receiver type `Widget` and its method
// `area` are declared in pkg/widget; and the `impl *Widget : Area` assertion
// lives HERE in main — a THIRD package that imports both.  An impl may be
// declared in any package that has both R and I in scope.  Dispatch through
// the `*shape.Area` interface value must work.

impl *widget.Widget : shape.Area

func main() {
	var w widget.Widget
	w.side = 6
	var iv *shape.Area = &w
	println(iv.area())
}
