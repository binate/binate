package "main"
import "pkg/builtins/testing"

// iface.alias (§11.7): a REGULAR `type X = Y` alias may NOT name an
// interface on its right-hand side -- only the dedicated `interface
// X = Y` form aliases an interface. A bare interface name is not a
// type expression (§11.2), so `type MyGreeter = Greeter` is rejected,
// the same bare-interface error path that rejects `var g Greeter`.

interface Greeter {
	greet()
}

type MyGreeter = Greeter

func main() {
	testing.Println("unreachable")
}
