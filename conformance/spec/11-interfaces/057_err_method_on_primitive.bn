package "main"
import "pkg/builtins/testing"

// iface.canonical.carveout (§11.10, Constraint): ONLY pkg/builtins/lang may
// declare methods (and impls) on the universe primitives.  The single-file
// `main` package is a non-lang package, so declaring a method on the
// primitive `int` here must be REJECTED -- the carve-out gate
// (AllowUniverseRecv) is set only for pkg/builtins/lang.  (Mirrors the
// type-checker unit test TestNonCarveOutRejectsMethodOnInt in
// pkg/binate/types/check_carveout_test.bn.)

func (x int) foo() int {
	return x + 1
}

func main() {
	var a int = 1
	testing.Println(a.foo())
}
