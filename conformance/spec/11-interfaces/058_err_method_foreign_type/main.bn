package "main"

import "pkg/widget"

// iface.crosspkg.method-package (§11.8, Constraint): a METHOD may be declared
// ONLY in the package that defines its receiver's named type.  `Widget` is
// defined in pkg/widget, so declaring a method on `*widget.Widget` here in
// main is rejected: "cannot define methods on types from other packages".
// (This is independent of where an `impl` may live — only the methods are
// pinned to the receiver's defining package.)

func (w *widget.Widget) extra() int {
	return w.side + 1
}

func main() {
	var w widget.Widget
	w.side = 1
	println(w.extra())
}
