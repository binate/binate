package "main"
import "pkg/builtins/testing"

import "pkg/shape"
import "pkg/widget"

// iface.construct.visible-impl (§11.8, Constraint): at a construction site
// the checker requires a VISIBLE matching impl (current package or
// transitively imported). The `impl *Widget : Talker` EXISTS -- in the
// third package pkg/glue -- but main does NOT import pkg/glue, so the impl
// is not visible here and `&w -> *shape.Talker` is rejected. (This is the
// visibility scenario, distinct from "no impl anywhere": importing pkg/glue
// would make it visible. The diagnostic is the generic assignability error
// because, from main's view, no impl for the pair is in scope.)
func main() {
	var w widget.Widget
	w.v = 3
	var iv *shape.Talker = &w
	testing.Println(iv.speak())
}
