package "main"

import "pkg/shape"
import "pkg/widget"
import "pkg/glue"

// iface.crosspkg.no-orphan (§11.8): an `impl R : I` may live in ANY package
// that has both R and I in scope -- including a THIRD package (pkg/glue here,
// neither Widget's nor Talker's home). main imports pkg/glue (so the impl is
// visible) and forces it to link via glue.Touch(); the construction
// `&w -> *shape.Talker` then dispatches speak() -> 7.
//
// Regression witness: collectImportedImplsFromDecl must key the imported
// impl's RecvPkg on the RECEIVER's defining package (pkg/widget), not the
// package the `impl` is written in (pkg/glue); otherwise the (Widget, Talker)
// vtable the construction site looks up (keyed by pkg/widget) is never found
// and dispatch hits a null vtable (compiled: SIGSEGV; VM: null-vtable abort).
// The companion 055 covers the impl-in-root case.
func main() {
	glue.Touch()
	var w widget.Widget
	w.v = 7
	var iv *shape.Talker = &w
	println(iv.speak())
}
