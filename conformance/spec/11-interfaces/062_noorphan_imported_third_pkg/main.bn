package "main"

import "pkg/shape"
import "pkg/widget"
import "pkg/glue"

// iface.crosspkg.no-orphan (§11.8): an `impl R : I` may live in ANY package
// that has both R and I in scope -- including a THIRD package (pkg/glue here,
// neither Widget's nor Talker's home). main imports pkg/glue (so the impl is
// visible) and forces it to link via glue.Touch(); the construction
// `&w -> *shape.Talker` then dispatches speak() -> 7.
//
// KNOWN BUG (xfail): when the sole impl for the (R, I) pair lives in an
// IMPORTED third package (not R's package, not the compilation root), the
// type-checker accepts the construction but IR-gen does not wire the (Widget,
// Talker) vtable at the construction site -- the interface value's vtable word
// is null and dispatch crashes (compiled: SIGSEGV; VM: null-vtable abort).
// An impl in R's own package, or in main (the root, cf. 055), works. Tracked
// in claude-todo.md (cross-pkg imported third-package impl vtable not wired).
func main() {
	glue.Touch()
	var w widget.Widget
	w.v = 7
	var iv *shape.Talker = &w
	println(iv.speak())
}
