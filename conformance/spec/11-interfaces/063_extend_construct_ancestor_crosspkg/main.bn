package "main"
import "pkg/builtins/testing"

import "pkg/shape"
import "pkg/widget"

// iface.extend.upcast (cross-package construction): widget.Widget implements
// shape.Sub (declared in widget's own package), and `interface Sub : Base`, so
// `&w` constructs directly into *shape.Base -- an ANCESTOR of the impl'd
// interface -- across the package boundary. The (Widget, Base) vtable must be
// referenced by the consumer (imported-impl ancestor closure) or dispatch
// nil-vtables. Companion to the same-package 048.

func main() {
	var w widget.Widget
	w.v = 7
	var b *shape.Base = &w          // raw cross-package upcast to the ancestor
	testing.Println(b.fb())
	var mw @widget.Widget = make(widget.Widget)
	mw.v = 9
	var mb @shape.Base = mw         // managed cross-package upcast to the ancestor
	testing.Println(mb.fb())
}
