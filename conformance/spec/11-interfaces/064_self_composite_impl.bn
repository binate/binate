package "main"
import "pkg/builtins/testing"

// iface.self (§11.9): within an interface method signature, `Self` denotes the
// implementing type and is valid in parameter and result positions INCLUDING
// inside composite types -- here the multi-result `(Self, Self)`. At impl time
// every `Self` is substituted by the implementing named type, so `(Self, Self)`
// becomes `(T, T)` for the `*T` impl. A Self-using method is object-unsafe
// (cannot dispatch through an interface value -- 067) but is reachable on the
// direct named-type method path, where the concrete type is statically known.

interface Splitter {
	val() int
	split() (Self, Self)
}

type T struct {
	x int
}

func (a *T) val() int {
	return a.x
}

// (Self, Self) substitutes to (T, T): the impl returns two concrete T values.
func (a *T) split() (T, T) {
	var lo T
	var hi T
	lo.x = a.x
	hi.x = a.x + 1
	return lo, hi
}

impl *T : Splitter

func main() {
	var a T
	a.x = 4
	// Direct named-type call: the composite Self result (Self, Self) is (T, T).
	var lo T
	var hi T
	lo, hi = a.split()
	if lo.val() == 4 && hi.val() == 5 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
