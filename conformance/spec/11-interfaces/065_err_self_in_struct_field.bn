package "main"

// iface.self (§11.9): `Self` is valid ONLY inside an interface method
// signature -- and "nowhere outside an interface declaration". A struct
// field type at package scope is one such forbidden position. The
// grounding negative 390_err_self_outside_interface covers a top-level
// FUNC PARAMETER; this covers a distinct outside-an-interface position
// (a struct field), confirming the rejection is not specific to one
// syntactic slot.

type T struct {
	x Self
}

func main() {
	var t T
	_ = t
}
