package "main"
import "pkg/builtins/testing"

// iface.self (§11.9): `Self` is valid ONLY in an interface method
// signature -- the spec names the extension parent list as a
// specifically FORBIDDEN position ("not in an extension parent list").
// `Self` is not an interface name, so `interface X : Self { ... }` must
// be rejected. This is distinct from the forbidden positions exercised
// elsewhere (390 = top-level func param; 065 = struct field): the parent
// list resolves INTERFACE names, so this also probes whether the
// rejection is the Self-specific message or an 'extends a non-interface'
// diagnostic.

interface X : Self {
	foo()
}

func main() {
	testing.Println("ignored")
}
