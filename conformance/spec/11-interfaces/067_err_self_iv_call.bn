package "main"

// iface.self.object-safety (§11.9, Constraint): a method whose interface
// signature mentions `Self` in a non-receiver position is object-unsafe — it
// CANNOT be called through an interface value (the concrete type has been
// erased, so `Self` can't be substituted).  The interface value may still be
// held and passed; only the Self-using method (`eq`) cannot be dispatched
// through it.  The non-Self sibling (`name`) would be callable through the iv
// — confirming the rejection is per-method, not per-interface.

interface Mixed {
	name() int
	eq(other Self) bool
}

type T struct {
	x int
}

func (a *T) name() int {
	return a.x
}

func (a *T) eq(b T) bool {
	return a.x == b.x
}

impl *T : Mixed

func main() {
	var t T
	t.x = 1
	var u T
	u.x = 1

	// Holding the iface value is fine; the non-Self `name` would dispatch.
	var iv *Mixed = &t
	_ = iv.name()

	// Dispatching the Self-using method through the iv is the error.
	var _ bool = iv.eq(u)
}
