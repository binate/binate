package "main"

// iface.extend.upcast (negative): the ancestor walk must not OVER-accept. R
// implements `Other` (a descendant of Base), but `Sub` is a SIBLING descendant
// of Base that R does NOT implement -- so `*Sub = &r` is rejected. Satisfaction
// walks only the impl'd interface's own ancestors, never sideways to siblings.

interface Base { fb() int }
interface Sub : Base { fs() int }
interface Other : Base { fo() int }

type R struct { v int }

func (r *R) fb() int { return r.v }
func (r *R) fo() int { return r.v + 1 }

impl *R : Other

func main() {
	var r R
	var b *Sub = &r
	_ = b
}
