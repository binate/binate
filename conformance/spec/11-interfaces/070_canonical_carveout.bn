package "main"
import "pkg/builtins/testing"

// 11.10 iface.canonical.carveout: pkg/builtins/lang ships the canonical
// interfaces Stringer (String() @[]char), Comparable (Compare(other Self)
// int), Orderable : Comparable, and Hashable : Comparable (Hash() uint),
// implemented by every universe primitive.  This exercises all four on
// primitives, both via direct method call and via interface-value
// dispatch (the non-Self methods String/Hash; Compare is Self-using and
// dispatched only through a generic constraint -- 11.9 -- so it is
// exercised by direct call and a Comparable-constrained generic here).

import "pkg/builtins/lang"

// Generic over Orderable: proves int satisfies Orderable (which extends
// Comparable), and Compare dispatches through the constraint.
func less[T lang.Orderable](a T, b T) bool {
	return a.Compare(b) < 0
}

// Dispatch Stringer through an interface value (String() has no Self).
func viaStringer(s *lang.Stringer) @[]char {
	return s.String()
}

// Dispatch Hashable through an interface value (Hash() has no Self).
func viaHashable(h *lang.Hashable) uint {
	return h.Hash()
}

func main() {
	var a int = 3
	var b int = 5

	// Stringer: String() returns @[]char; println prints it directly.
	testing.Println(a.String())              // 3
	testing.Println(viaStringer(&a))         // 3 (through *lang.Stringer)

	// Comparable (direct) and Orderable (through constraint).
	if a.Compare(b) < 0 && less[int](a, b) && !less[int](b, a) {
		testing.Println("cmp-ok")
	} else {
		testing.Println("FAIL")
	}

	// Hashable: equal values hash equal, through iv dispatch.
	var x int = 42
	var y int = 42
	if viaHashable(&x) == viaHashable(&y) {
		testing.Println("hash-ok")
	} else {
		testing.Println("FAIL")
	}

	// bool is also a primitive scalar: Stringer + Compare apply.
	var t bool = true
	testing.Println(t.String())              // true
	if t.Compare(false) > 0 {
		testing.Println("bool-ok")
	} else {
		testing.Println("FAIL")
	}
}
