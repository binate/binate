package "main"
import "pkg/builtins/testing"

// 11.10 iface.canonical.auto-available: calling a canonical METHOD on a
// primitive (x.String(), x.Compare(y), x.Hash()) requires NO import --
// the compiler force-loads pkg/builtins/lang so the impls attach to the
// primitive types.  This file deliberately does NOT import
// "pkg/builtins/lang" yet still resolves and links all three methods.
// (Naming the interface TYPE *lang.Stringer would require the import --
// that is the negative, 074.)

func main() {
	var x int = 42
	// Stringer.String() unqualified, no import.
	testing.Println(x.String())              // 42

	// Comparable.Compare() unqualified, no import.
	var a int = 3
	var b int = 5
	if a.Compare(b) < 0 && b.Compare(a) > 0 && a.Compare(a) == 0 {
		testing.Println("cmp-ok")
	} else {
		testing.Println("FAIL")
	}

	// Hashable.Hash() unqualified, no import; equal values hash equal.
	var p int = 7
	var q int = 7
	if p.Hash() == q.Hash() {
		testing.Println("hash-ok")
	} else {
		testing.Println("FAIL")
	}
}
