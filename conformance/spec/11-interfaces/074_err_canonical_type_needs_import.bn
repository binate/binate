package "main"
import "pkg/builtins/testing"

// 11.10 iface.canonical.auto-available (negative half): the canonical
// METHOD is auto-available unqualified, but naming the interface TYPE
// `*lang.Stringer` still requires `import "pkg/builtins/lang"`.  This
// file omits the import and references the type, so the `lang` qualifier
// is unresolved and the program must fail to compile.

func printIt(s *lang.Stringer) {
	testing.Println(s.String())
}

func main() {
	var x int = 42
	printIt(&x)
}
