package "main"

// 11.11 iface.dispatch: a method called through an interface value is
// dispatched dynamically -- the slot is resolved at compile time, the
// impl is loaded from the value's vtable at run time, and called with
// the value's data pointer.  The SAME interface-value type (*Shape)
// dispatches to DIFFERENT concrete impls depending on the value it
// currently holds: reassigning iv from &sq to &ci changes which area()
// runs, proving the vtable (not a static call target) selects the impl.

interface Shape {
	area() int
}

type Square struct {
	s int
}

func (q *Square) area() int {
	return q.s * q.s
}

impl *Square : Shape

type Box struct {
	w int
	h int
}

func (b *Box) area() int {
	return b.w * b.h
}

impl *Box : Shape

func main() {
	var sq Square
	sq.s = 4
	var bx Box
	bx.w = 3
	bx.h = 5

	// One *Shape variable, two concrete impls, dispatched in turn.
	var iv *Shape = &sq
	var r1 int = iv.area()    // Square.area -> 16
	iv = &bx
	var r2 int = iv.area()    // Box.area -> 15

	if r1 == 16 && r2 == 15 {
		println("ok")
	} else {
		println("FAIL")
	}
}
