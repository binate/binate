package "main"
import "pkg/builtins/testing"

// 11.11 iface.dispatch (managed): a @Iface value dispatches dynamically
// to the impl in its vtable.  Two different concrete types are boxed
// into the same @Shape interface-value type and dispatched through a
// shared helper -- the helper has one static call site but reaches two
// distinct impls, selected by each value's vtable at run time.

interface Shape {
	area() int
}

type Square struct {
	s int
}

func (q *Square) area() int {
	return q.s * q.s
}

impl *Square : Shape

type Box struct {
	w int
	h int
}

func (b *Box) area() int {
	return b.w * b.h
}

impl *Box : Shape

func makeSquare(n int) @Shape {
	var q @Square = make(Square)
	q.s = n
	return q
}

func makeBox(w int, h int) @Shape {
	var b @Box = make(Box)
	b.w = w
	b.h = h
	return b
}

// Single static call site; dispatch picks the right impl per value.
func areaOf(s @Shape) int {
	return s.area()
}

func main() {
	var a @Shape = makeSquare(4)
	var b @Shape = makeBox(3, 5)
	if areaOf(a) == 16 && areaOf(b) == 15 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
