package "main"

// 11.11 iface.dispatch.nil: dispatching through a NIL interface value is
// a defined non-recoverable abort whose OBSERVABLE FORM is target-
// dependent (VM prints a diagnostic; a compiled backend faults on the
// null-vtable deref, which strip_signal_msgs erases -> empty output).
// So the abort itself is NOT portably observable; the spec directs to
// use `present` (15.5) to test an interface value before dispatching.
// This is the PORTABLE positive coverage: present(iv) is false for the
// zero-value (nil) interface and true after construction, and we only
// dispatch when present -- so no abort occurs in any mode.
//
// The actual abort behavior is pinned per-mode by the existing tests
// 385 (compiled-mode null-vtable SEGV) and 386 (VM-mode panic message).

interface Shape {
	area() int
}

type Square struct {
	s int
}

func (q *Square) area() int {
	return q.s * q.s
}

impl *Square : Shape

func main() {
	// Zero-value interface value: never given a concrete value.
	var iv @Shape
	if present(iv) {
		println("FAIL")
	} else {
		println("empty")          // present() false -> do not dispatch
	}

	// Construct it; now present() is true and dispatch is safe.
	var q @Square = make(Square)
	q.s = 6
	iv = q
	if present(iv) {
		// Guarded dispatch -- only when present.
		println(iv.area())        // 36
	} else {
		println("FAIL")
	}
}
