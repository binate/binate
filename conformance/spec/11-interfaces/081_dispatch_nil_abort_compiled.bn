package "main"

// iface.dispatch.nil (§11.11): dispatching through a NIL interface value is a
// defined non-recoverable abort. On a COMPILED backend the form is a fault on
// the null-vtable dereference: the program prints "before", then the nil
// dispatch crashes and output stops (never reaches "after"). The VM-mode form
// (a diagnostic message) is pinned by 082. `var iv *I` with no initializer
// zero-inits both halves of the interface value (nillable-type zero rule), so
// the vtable word is null.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {
	println("foo")
}

impl *T : I

func main() {
	println("before")
	var iv *I
	iv.foo()
	println("after")
}
