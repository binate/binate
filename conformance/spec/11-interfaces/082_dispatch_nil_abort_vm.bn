package "main"

// iface.dispatch.nil (§11.11): dispatching through a NIL interface value is a
// defined non-recoverable abort. The bytecode VM DETECTS the null vtable at
// dispatch and aborts with a clear message ("vm: call through nil interface
// value") rather than dispatching through vtable 0 silently. The compiled-mode
// form (a silent null-vtable fault) is pinned by 081.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {
	println("foo")
}

impl *T : I

func main() {
	println("before")
	var iv *I
	iv.foo()
	println("after")
}
