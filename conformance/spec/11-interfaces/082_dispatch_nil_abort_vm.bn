package "main"
import "pkg/builtins/testing"

// iface.dispatch.nil (§11.11): dispatching through a NIL interface value is a
// defined non-recoverable abort — the PROGRAM cannot continue past it. The
// bytecode VM DETECTS the null vtable at dispatch and raises a recoverable
// user-code fault (Plan 2): the VM unwinds to the host, which prints the message
// ("runtime error: call of nil interface value") and exits non-zero, rather than
// dispatching through vtable 0 silently. The abort stays non-recoverable for the
// program; only the host survives (the embedder's choice — a standalone `bni` run
// exits 1). The compiled-mode form (a silent null-vtable fault) is pinned by 081.

interface I {
	foo()
}

type T struct {
	x int
}

func (t *T) foo() {
	testing.Println("foo")
}

impl *T : I

func main() {
	testing.Println("before")
	var iv *I
	iv.foo()
	testing.Println("after")
}
