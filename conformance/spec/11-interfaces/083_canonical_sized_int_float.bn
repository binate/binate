package "main"

// iface.canonical.carveout (§11.10): EACH of the 13 primitive scalar types --
// not just int/bool (which 070/072 cover) -- implements Stringer, Orderable,
// and Hashable via pkg/builtins/lang.  This broadens coverage to a SIZED
// integer (int32) and a FLOAT (float64).  All three canonical methods
// (String / Compare / Hash) are exercised by direct call; per
// iface.canonical.auto-available no import is needed.  Only ordinary
// (non-NaN) float values are used, so float Compare is well-defined (the
// §11.10 open note about NaN/total-order does not apply here).

func main() {
	// Sized integer: String (decimal via formatInt64), Compare, Hash.
	var a int32 = 1000
	println(a.String())              // 1000

	var b int32 = 2000
	if a.Compare(b) < 0 && b.Compare(a) > 0 && a.Compare(a) == 0 {
		println("i32-cmp-ok")
	} else {
		println("FAIL")
	}

	var p int32 = 7
	var q int32 = 7
	if p.Hash() == q.Hash() {
		println("i32-hash-ok")
	} else {
		println("FAIL")
	}

	// Float: String (fixed-point form) and Compare on ordinary values.
	var f float64 = 2.5
	println(f.String())              // 2.500000

	var g float64 = 4.0
	if f.Compare(g) < 0 && g.Compare(f) > 0 && f.Compare(f) == 0 {
		println("f64-cmp-ok")
	} else {
		println("FAIL")
	}
}
