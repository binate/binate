package "main"

import "pkg/describer"
import "pkg/point"
import "pkg/dup"

// iface.crosspkg.no-orphan (§11.8): duplicate `impl R : I` declarations across
// packages are PERMITTED.  pkg/point declares `impl *Point :
// describer.Describer` (in R's own package) and pkg/dup INDEPENDENTLY declares
// the SAME `impl *point.Point : describer.Describer`.  Both translation units
// emit a vtable for the (*point.Point, describer.Describer) pair under the same
// canonical name with weak_odr linkage; the linker keeps ONE.  No "duplicate
// impl" error, and dispatch through the *describer.Describer interface value
// works.  (Mirrors conformance/378_iface_impl_dup; impl stays in R's package +
// a duplicate -- NOT a third-package-only impl, which hits the known MAJOR bug
// exercised by 062.)

func main() {
	dup.Touch()
	var p point.Point
	p.v = 36
	var iv *describer.Describer = &p
	println(iv.describe())
}
