package "pkg/dup"

import "pkg/describer"
import "pkg/point"

// This package independently declares the SAME impl that pkg/point declares.
// Both TUs emit a `weak_odr` vtable for (*point.Point, describer.Describer)
// with identical contents; the linker keeps one.  No "duplicate impl" error
// from the type-checker.
impl *point.Point : describer.Describer

func Touch() { }
