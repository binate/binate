package "main"
import "pkg/builtins/testing"

// iface.canonical.carveout (§11.10, Constraint): EXACTLY ONE package,
// pkg/builtins/lang, may declare methods AND IMPLS on the universe
// primitives; "no other package may". Here the non-lang package `main`
// declares `impl int : Empty` on the primitive `int`. Per the carve-out
// this must be REJECTED.
//
// The interface is EMPTY on purpose: an impl on a primitive whose
// interface has methods is also blocked by the METHOD-declaration pass
// (which rejects the `func (x int) m()` needed to satisfy it), but an
// empty interface reaches no method-declaration check, so only the IMPL
// pass's own carve-out gate rejects it.
interface Empty {
}

impl int : Empty

func main() {
	var x int = 5
	var iv *Empty = &x
	testing.Println("compiled")
}
