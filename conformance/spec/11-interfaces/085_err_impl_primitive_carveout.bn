package "main"
import "pkg/builtins/testing"

// iface.canonical.carveout (§11.10, Constraint): EXACTLY ONE package,
// pkg/builtins/lang, may declare methods AND IMPLS on the universe
// primitives; "no other package may". Here the non-lang package `main`
// declares `impl int : Empty` on the primitive `int`. Per the carve-out
// this must be REJECTED.
//
// KNOWN GAP (xfail): the carve-out gate (AllowUniverseRecv) is enforced
// only in the METHOD-declaration pass, so a `func (x int) m()` is caught
// -- but an impl on a primitive whose interface needs NO methods (an
// empty interface) reaches no method-declaration check and the IMPL pass
// has no equivalent gate, so it is wrongly ACCEPTED. Tracked in
// claude-todo.md (carve-out not enforced in the impl pass).
interface Empty {
}

impl int : Empty

func main() {
	var x int = 5
	var iv *Empty = &x
	testing.Println("compiled")
}
