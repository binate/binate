package "main"
import "pkg/builtins/testing"

// iface.construct.value-borrow: an ADDRESSABLE value source constructing a raw
// `*Iface` (incl. `*any`) is admitted via an implicit `&` -- `Opts{item: x}` is
// `Opts{item: &x}` -- in every position an explicit `&x` is permitted: var/`:=`
// init, argument, composite element, and return.  It borrows (no copy): the
// interface value shares the source's storage.

interface I {
	foo() int
}

type T struct {
	x int
}

func (t *T) foo() int {
	return t.x
}

impl *T : I

type Opts struct {
	item *I
}

var g T // global outlives the return borrow

func takeI(iv *I) int {
	return iv.foo()
}

func retG() *I {
	return g
}

func sum(xs ...*I) int {
	var s int = 0
	for i := 0; i < len(xs); i++ {
		s = s + xs[i].foo()
	}
	return s
}

func main() {
	var a T
	a.x = 1
	var b T
	b.x = 2
	g.x = 9

	// var-init, ident lvalue
	var iv *I = a
	testing.Println(iv.foo()) // 1

	// var-init, array-element lvalue
	var arr [2]T
	arr[1].x = 5
	var iv2 *I = arr[1]
	testing.Println(iv2.foo()) // 5

	// argument position
	testing.Println(takeI(b)) // 2

	// composite element (struct field)
	var o Opts = Opts{item: a}
	testing.Println(o.item.foo()) // 1

	// return position (global source, safe)
	testing.Println(retG().foo()) // 9

	// variadic ...*I
	testing.Println(sum(a, b)) // 3

	// borrow a value into *any
	var p *any = a
	_ = p
	testing.Println(0) // 0
}
