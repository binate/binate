package "main"
import "pkg/builtins/testing"

// iface.construct.value-borrow: a NAME-LESS value source (a func value, a
// managed-slice, a raw-slice) borrowed into `*any` must box to a well-formed
// 2-word iface value -- the implicit `&` produces exactly what an explicit `&x`
// does.  Regression guard: the box source must carry the POINTER type, not the
// bare value type, or wrapAsIfaceValue's name-less path mis-keys or crashes.

func hello() int {
	return 1
}

func sink(args ...*any) int {
	return len(args)
}

func main() {
	var f *func() int = hello
	var pf *any = f     // func value into *any (var-init)
	_ = pf
	testing.Println(sink(f, f)) // func values into variadic ...*any -> 2

	var ms @[]int = make_slice(int, 3)
	ms[1] = 5
	var pm *any = ms // managed-slice into *any
	_ = pm
	testing.Println(len(ms)) // 3

	var rs *[]int = ms
	var pr *any = rs // raw-slice into *any
	_ = pr
	testing.Println(rs[1]) // 5
}
