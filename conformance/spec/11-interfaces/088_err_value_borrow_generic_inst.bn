package "main"

// iface.construct.value-borrow (restriction): a generic-function INSTANTIATION
// `f[T]` is a non-addressable func value.  Like any non-addressable rvalue it
// may be MATERIALIZED into a temporary and borrowed at a BORROWING position
// (`var p *any = f[T]`), but in a STORING position (assignment / field-element
// store / return) the temporary would dangle, so it is a compile error.  (It is
// distinct from the explicit `&f[T]`, which "cannot take the address of a
// non-addressable value" in every position.)  This must be rejected.

func idz[T any](x T) T {
	return x
}

func main() {
	var p *any
	p = idz[int]
	_ = p
}
