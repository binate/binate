package "main"

// iface.construct.value-borrow (restriction): a generic-function INSTANTIATION
// `f[T]` is a function value, not an addressable lvalue -- it has no storage to
// borrow.  An implicit value-borrow of it into `*any` (like an explicit
// `&f[T]`, which is likewise "cannot take the address of a non-addressable
// value") must be REJECTED, not silently boxed as a func value in the interface
// slot.  This must be rejected at compile time.

func idz[T any](x T) T {
	return x
}

func main() {
	var p *any = idz[int]
	_ = p
}
