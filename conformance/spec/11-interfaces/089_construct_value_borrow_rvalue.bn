package "main"
import "pkg/builtins/testing"

// iface.construct.value-borrow (2b): a NON-addressable value source (a literal,
// an expression, a call result) constructing a raw *Iface (incl. *any) at a
// BORROWING position -- a call argument or a var/`:=` initializer -- is
// materialized into a statement temporary and borrowed.  The box is well-formed:
// the value recovers.  This is the `fmt.Print(42)` half of the ergonomic fmt.

func rec(p *any) int {
	var v int = 0
	var ok bool = false
	v, ok = p.(int)
	if ok {
		return v
	}
	return -1
}

func sink(args ...*any) int {
	var s int = 0
	for i := 0; i < len(args); i++ {
		s = s + rec(args[i])
	}
	return s
}

func arg1(p *any) int {
	return rec(p)
}

type Box struct {
	item *any
}

func main() {
	testing.Println(sink(42, 8)) // 50  variadic untyped-int rvalues (fmt.Print shape)
	var iv *any = 100
	testing.Println(rec(iv)) // 100  var-init rvalue
	var a int = 3
	var b int = 4
	testing.Println(arg1(a + b)) // 7  fixed-arg expression rvalue
	bx := Box{item: 9} // := composite element rvalue (borrowing)
	testing.Println(rec(bx.item)) // 9
}
