package "main"

// iface.construct.value-borrow (2b restriction): a NON-addressable value source
// materialized into a statement temporary is released at the end of its
// statement, so borrowing it into a raw *Iface at a STORING position that
// outlives the statement -- a return, a field/element store, or a composite
// literal in such a position -- is a compile error (the temporary would dangle).

type Box struct {
	item *any
}

func retRv() *any {
	return 42 // return position -> reject
}

func main() {
	var arr [1]*any
	arr[0] = 8 // element store -> reject
	var bx Box
	bx = Box{item: 7} // composite literal in a storing position -> reject
	_ = arr
	_ = bx
}
