package "main"

import "pkg/builtins/rt"

// iface.construct.value-borrow (2b, managed): a NON-addressable MANAGED-carrying
// rvalue (a call result @[]int) borrowed into *any is materialised into a
// temporary that OWNS the copied reference and is enrolled for SCOPE-end cleanup
// -- refcount-balanced (no leak), co-scoped with a var-init binding (stays alive
// to recover across intervening statements), and safe in a loop.

func mk() @[]int {
	var s @[]int = make_slice(int, 3)
	s[0] = 10
	s[1] = 20
	s[2] = 30
	return s
}

func rec(p *any) int {
	var got @[]int
	var ok bool
	got, ok = p.(@[]int)
	if ok {
		return got[0] + got[1] + got[2]
	}
	return -1
}

func identity(x @[]int) @[]int {
	return x
}

func take(p *any) int {
	return 0
}

func main() {
	// var-init managed rvalue: co-scoped with the binding, alive across statements
	var iv *any = mk()
	var a int = 1
	var b int = 2
	println(a + b) // 3
	println(rec(iv)) // 60

	// argument managed rvalue: refcount returns to baseline (no leak)
	var s @[]int = make_slice(int, 2)
	var hp *int = bit_cast(*int, &s)
	var backing *uint8 = bit_cast(*uint8, hp[2])
	var base int = rt.Refcount(backing)
	{
		var junk int = take(identity(s))
		_ = junk
	}
	println(rt.Refcount(backing) - base) // 0
}
