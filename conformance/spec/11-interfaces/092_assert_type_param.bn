package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.assert.typeparam, gen.mono.check: an assertion or type-switch case whose
// target names a type parameter is the assertion its instance spells.  A bare
// target T recovers a value of type T: with T a managed or raw pointer or
// interface value, that is the recovery kind (`x.(T)` is `x.(@Thing)` for
// T = @Thing); with T a slice, a slice target; otherwise a value recovery.  A
// written kind applies to the type argument as written.

type Thing struct {
	n int
}

type Celsius int

type Holder struct {
	s @[]int
}

interface Getter {
	Get() int
}

impl *Thing : Getter

func (t *Thing) Get() int { return t.n }

func as[T any](x @any) T { return x.(T) }

func asRaw[T any](x *any) T { return x.(T) }

func asPtr[T any](x *any) *T { return x.(*T) }

func is[T any](x *any) bool {
	_, ok := x.(T)
	return ok
}

func whichPtr[T any](x *any) int {
	switch x.(type) {
	case *T:
		return 1
	}
	return 0
}

func whichBare[T any](x *any) int {
	switch v := x.(type) {
	case T:
		_ = v
		return 2
	}
	return 0
}

func main() {
	var t @Thing = make(Thing)
	t.n = 5
	var a @any = t
	testing.Println(as[@Thing](a).n, as[*Thing](a).n, as[@Getter](a).Get())

	// Each `@` recovery retains and releases a reference: the count is unchanged.
	var pt *uint8 = bit_cast(*uint8, t)
	var before int = rt.Refcount(pt)
	for i := 0; i < 10; i++ {
		_ = as[@Thing](a).n
	}
	testing.Println(rt.Refcount(pt) == before)

	var h Holder
	h.s = make_slice(int, 2)
	h.s[1] = 9
	var ah @any = box(h)
	testing.Println(as[Holder](ah).s[1])

	var c Celsius = 7
	var ac @any = box(c)
	testing.Println(cast(int, as[Celsius](ac)))

	var w Thing
	w.n = 3
	var pw *any = &w
	testing.Println(asPtr[Thing](pw).n, asRaw[*Getter](pw).Get())

	var s *[]readonly char = "hi"
	var ps *any = &s
	testing.Println(len(asRaw[*[]readonly char](ps)))

	testing.Println(is[*Thing](pw), is[*Celsius](pw), whichPtr[Thing](pw), whichPtr[Celsius](pw),
			whichBare[*Thing](pw), whichBare[int](pw))
}
