package "main"

// iface.assert.typeparam: a bare assertion target T recovers a value of type
// T, so an instance whose type argument is not an assertion target (an array)
// is a compile-time error, reported at the instantiation.

func as[T any](x @any) T {
	return x.(T)
}

func main() {
	var b @int = box(1)
	var a @any = b
	var r [2]int = as[[2]int](a)
	_ = r
}
