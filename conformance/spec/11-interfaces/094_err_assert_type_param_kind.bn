package "main"

// iface.assert.typeparam, iface.assert.kind: `x.(@T)` is the assertion
// `x.(@U)` for each instance T = U, so recovering it from a raw `*any` is a
// compile-time error for each instance, as `x.(@U)` is.

type Thing struct {
	n int
}

func asM[T any](x *any) @T {
	return x.(@T)
}

func main() {
	var t Thing
	var p *any = &t
	var r @Thing = asM[Thing](p)
	_ = r
}
