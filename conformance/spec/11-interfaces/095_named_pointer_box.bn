package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.construct.named-pointer, iface.assert, iface.assert.kind: a named type over
// a pointer is a value for interface construction.  A raw interface borrows it by
// address, a managed one takes `box(h)`; either way the box points at an H, its
// dynamic type is H, and H's value-receiver methods run on the H loaded from it.
// Each refcount line must print 0 (the boxes, borrows and recoveries balance).

interface Getter { Get() int }

type Inner struct { v int }

type Node struct { p @Inner }

// A named managed pointer with its own impl.
type H @Node

func (h H) Get() int { return h.p.v + 1000 }

impl H : Getter

type S struct { v int }

// A named raw pointer with its own impl.
type PS *S

func (p PS) Get() int { return p.v + 2000 }

impl PS : Getter

var inr @Inner

func rc() int { return rt.Refcount(bit_cast(*uint8, inr)) }

func mkH() H {
	var n @Node = make(Node)
	n.p = inr
	return cast(H, n)
}

func takeR(g *Getter) int { return g.Get() }

func takeAny(a *any) int {
	var h H
	var ok bool
	h, ok = a.(H)
	if !ok { return -1 }
	return h.Get()
}

// Into a raw interface: borrowed by address, explicitly or implicitly.
func raw(h H) {
	var r1 *Getter = &h
	var r2 *Getter = h
	testing.Println(r1.Get(), r2.Get(), takeR(h), takeR(mkH()))
}

// Into a managed interface: box(h).
func managed(h H) {
	var g @Getter = box(h)
	testing.Println(g.Get())
}

// Every recovery form on a box of an H.
func recover(h H) {
	var a @any = box(h)
	var p1 @H = a.(@H)
	var p2 *H = a.(*H)
	var v H = a.(H)
	testing.Println((*p1).Get(), (*p2).Get(), v.Get())
	var w H
	var ok bool
	w, ok = a.(H)
	testing.Println(w.Get(), ok)
	_, ok = a.(@Node)
	testing.Println(ok)
	switch x := a.(type) {
	case @Node:
		testing.Println("Node")
	case H:
		testing.Println("H", x.Get())
	}
	var g @Getter
	g, ok = a.(@Getter)
	testing.Println(ok, g.Get())
	testing.Println(takeAny(h), takeAny(mkH()))
}

// cast(@Node, h) boxes the Node itself, whose dynamic type is Node.
func pointee(h H) {
	var a @any = cast(@Node, h)
	var ok1 bool
	var ok2 bool
	_, ok1 = a.(@Node)
	_, ok2 = a.(@H)
	testing.Println(ok1, ok2)
}

func show(g *Getter) { testing.Println("deferred", g.Get()) }

// A deferred call borrows a snapshot of the H taken when the defer statement runs.
func deferred(h H) {
	defer show(h)
	var n @Node = make(Node)
	n.p = make(Inner)
	n.p.v = 9
	h = cast(H, n)
	testing.Println("body", h.Get())
}

func rawPtr() {
	var s S
	s.v = 5
	var ps PS = &s
	var r *Getter = ps
	var c @PS = make(PS)
	*c = ps
	var g @Getter = c
	var a *any = ps
	var ok bool
	_, ok = a.(*PS)
	testing.Println(r.Get(), g.Get(), ok)
}

// A dereference through a named pointer is the pointee: boxing `*ps` / `&*ps` / `*h`
// keys on S / Node, not on the named pointer.
func derefs(h H) {
	var s S
	s.v = 6
	var ps PS = &s
	var a1 *any = *ps
	var a2 *any = &*ps
	var a3 *any = *h
	var ok1 bool
	var ok2 bool
	var ok3 bool
	_, ok1 = a1.(*S)
	_, ok2 = a2.(*S)
	_, ok3 = a3.(*Node)
	testing.Println(ok1, ok2, ok3)
}

// A named interface-value type is a value too: copying one is a copy, not a box.
type NG *Getter

func passNG(n NG) NG {
	var m NG = n
	return m
}

func namedIface(h H) {
	var r *Getter = &h
	var n NG = cast(NG, r)
	var m NG = passNG(n)
	testing.Println(cast(*Getter, m).Get())
}

func main() {
	inr = make(Inner)
	inr.v = 1
	var h H = mkH()
	var base int = rc()
	raw(h)
	testing.Println(rc() - base)
	managed(h)
	testing.Println(rc() - base)
	recover(h)
	testing.Println(rc() - base)
	pointee(h)
	testing.Println(rc() - base)
	deferred(h)
	testing.Println(rc() - base)
	derefs(h)
	namedIface(h)
	testing.Println(rc() - base)
	rawPtr()
}
