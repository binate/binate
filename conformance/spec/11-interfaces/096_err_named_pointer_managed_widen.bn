package "main"

// iface.construct.named-pointer, iface.construct.box: a named pointer type is a
// value, so widening a bare one into a managed interface value is a compile error
// (box it first: `box(h)`), as for any value.  A raw interface borrows it instead.

interface Getter { Get() int }

type Node struct { v int }

type H @Node

func (h H) Get() int { return h.v }

impl H : Getter

type S struct { v int }

type PS *S

func (p PS) Get() int { return p.v }

impl PS : Getter

func main() {
	var n @Node = make(Node)
	var h H = n
	var g @Getter = h
	var a @any = h
	var ps PS
	var g2 @Getter = ps
	var g3 @Getter = cast(@Getter, h)
	_ = g
	_ = a
	_ = g2
	_ = g3
}
