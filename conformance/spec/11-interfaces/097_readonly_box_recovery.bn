package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.assert.readonly, iface.assert, iface.typeswitch: a box of a READONLY object
// records the object's readonly, so a recovery may add readonly but never drop it.
// A mutable `.(*T)` / `.(@T)` misses (ok = false in comma-ok, no match in a type
// switch); `.(*readonly T)`, `.(@readonly T)` and the value copy `.(T)` match.  A
// box of a mutable object is recovered by both.  Covered: `&c` of a readonly
// variable, the implicit borrow of one, `box` of one, an `@readonly T` into
// `@any`, a readonly variable of a named pointer type, a struct, and a predeclared
// type.

type Celsius float64

type S struct { a [2]int }

type Node struct { v int }

type H @Node

func celsius() {
	var c readonly Celsius = 21.0
	var x *any = &c
	var ok bool
	_, ok = x.(*Celsius)
	testing.Println("&c .(*Celsius):", ok)
	var p *readonly Celsius
	p, ok = x.(*readonly Celsius)
	testing.Println("&c .(*readonly Celsius):", ok, cast(int, *p))
	var v Celsius
	v, ok = x.(Celsius)
	testing.Println("&c .(Celsius):", ok, cast(int, v))

	var y *any = c
	_, ok = y.(*Celsius)
	testing.Println("borrow .(*Celsius):", ok)
	_, ok = y.(*readonly Celsius)
	testing.Println("borrow .(*readonly Celsius):", ok)

	var bx @any = box(c)
	_, ok = bx.(@Celsius)
	testing.Println("box .(@Celsius):", ok)
	_, ok = bx.(@readonly Celsius)
	testing.Println("box .(@readonly Celsius):", ok)

	var m Celsius = 5.0
	var z *any = &m
	_, ok = z.(*Celsius)
	testing.Println("mutable .(*Celsius):", ok)
	_, ok = z.(*readonly Celsius)
	testing.Println("mutable .(*readonly Celsius):", ok)
}

func structs() {
	var rs readonly S
	var x *any = &rs
	var ok bool
	_, ok = x.(*S)
	testing.Println("&rs .(*S):", ok)
	var p *readonly S
	p, ok = x.(*readonly S)
	testing.Println("&rs .(*readonly S):", ok, p.a[1])
	var v S
	v, ok = x.(S)
	testing.Println("&rs .(S):", ok, v.a[0])
	switch t := x.(type) {
	case *S:
		testing.Println("switch: *S")
	case *readonly S:
		testing.Println("switch: *readonly S", t.a[0])
	}
	var ms S
	ms.a[0] = 4
	var y *any = &ms
	switch t := y.(type) {
	case *S:
		testing.Println("mutable switch: *S", t.a[0])
	case *readonly S:
		testing.Println("mutable switch: *readonly S")
	}
}

func managed() {
	var base int = rt.LiveBlocks()
	if true {
		var n @Node = make(Node)
		n.v = 9
		var rn @readonly Node = n
		var a @any = rn
		var ok bool
		_, ok = a.(@Node)
		testing.Println("@readonly Node .(@Node):", ok)
		var r @readonly Node
		r, ok = a.(@readonly Node)
		testing.Println("@readonly Node .(@readonly Node):", ok, r.v)
		var nv Node
		nv, ok = a.(Node)
		testing.Println("@readonly Node .(Node):", ok, nv.v)
		var mn @any = n
		_, ok = mn.(@Node)
		testing.Println("@Node .(@Node):", ok)
	}
	testing.Println("managed blocks released:", rt.LiveBlocks() == base)
}

func namedPointer() {
	var rh readonly H = cast(H, make(Node))
	var x *any = &rh
	var ok bool
	_, ok = x.(*H)
	testing.Println("&rh .(*H):", ok)
	_, ok = x.(*readonly H)
	testing.Println("&rh .(*readonly H):", ok)
	var hv H
	hv, ok = x.(H)
	testing.Println("&rh .(H):", ok, hv.v)
}

func predeclared() {
	var ri readonly int = 3
	var x *any = &ri
	var ok bool
	_, ok = x.(*int)
	testing.Println("&ri .(*int):", ok)
	_, ok = x.(*readonly int)
	testing.Println("&ri .(*readonly int):", ok)
	var v int
	v, ok = x.(int)
	testing.Println("&ri .(int):", ok, v)
}

func main() {
	celsius()
	structs()
	managed()
	namedPointer()
	predeclared()
}
