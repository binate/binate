package "main"

import "pkg/builtins/testing"

// iface.assert.readonly, iface.typeswitch, iface.extend.upcast: an interface
// target on a box of a READONLY object matches only an interface the readonly
// object could be widened to statically — one whose impl binds a read-only
// receiver (`*readonly T`, `readonly T`).  An impl over a mutable receiver (`*T`)
// misses, even for a method that only reads.  The record survives an interface
// upcast, and a box of a mutable object still reaches every impl.  Also covered:
// a read-only-receiver impl of an interface an earlier mutable impl already
// reached as an ancestor, and a generic type boxed only into `*any`.

interface Getter {
	Get() int
}

interface GetSub : Getter {
	Get2() int
}

interface Setter {
	Set(v int)
}

interface RW {
	Get() int
	Set(v int)
}

type S struct { a [2]int }

func (s *readonly S) Get() int { return s.a[0] }

func (s *readonly S) Get2() int { return s.a[1] }

func (s *S) Set(v int) { s.a[0] = v }

impl *readonly S : GetSub

impl *S : Setter

impl *S : RW

type Box[T any] struct { v T }

func (b *readonly Box[T]) Get() int { return 7 }

func (b *Box[T]) Set(v int) {}

impl *readonly Box[T] : Getter

impl *Box[T] : Setter

type U struct { n int }

func (u *readonly U) Get() int { return u.n }

func (u *U) Get2() int { return 2 }

impl *U : GetSub

impl *readonly U : Getter

type Cell[T any] struct { v T }

func (c *readonly Cell[T]) Get() int { return 9 }

impl *readonly Cell[T] : Getter

type Two[A any, B any] struct { a A; b B }

func (t *readonly Two[_, B]) Get() int { return 5 }

impl *readonly Two[_, B] : Getter

func readonlyStruct() {
	var rs readonly S
	var x *any = &rs
	var ok bool
	var g *Getter
	g, ok = x.(*Getter)
	testing.Println("ro .(*Getter):", ok, g.Get())
	var gs *GetSub
	gs, ok = x.(*GetSub)
	testing.Println("ro .(*GetSub):", ok, gs.Get2())
	_, ok = x.(*Setter)
	testing.Println("ro .(*Setter):", ok)
	_, ok = x.(*RW)
	testing.Println("ro .(*RW):", ok)
	switch t := x.(type) {
	case *Setter:
		testing.Println("ro switch: Setter")
	case *Getter:
		testing.Println("ro switch: Getter", t.Get())
	}
}

func mutableStruct() {
	var ms S
	ms.a[0] = 3
	var x *any = &ms
	var ok bool
	_, ok = x.(*Getter)
	testing.Println("mut .(*Getter):", ok)
	var s *Setter
	s, ok = x.(*Setter)
	s.Set(8)
	testing.Println("mut .(*Setter):", ok, ms.a[0])
	_, ok = x.(*RW)
	testing.Println("mut .(*RW):", ok)
}

func upcast() {
	var rs readonly S
	var gs *GetSub = &rs
	var g *Getter = gs
	var ok bool
	_, ok = g.(*S)
	testing.Println("upcast .(*S):", ok)
	_, ok = g.(*readonly S)
	testing.Println("upcast .(*readonly S):", ok)
	var a *any = g
	_, ok = a.(*S)
	testing.Println("upcast any .(*S):", ok)
	_, ok = a.(*GetSub)
	testing.Println("upcast any .(*GetSub):", ok)
	_, ok = a.(*Setter)
	testing.Println("upcast any .(*Setter):", ok)
}

func managed() {
	var m @S = make(S)
	m.a[0] = 6
	var r @readonly S = m
	var x @any = r
	var ok bool
	var g @Getter
	g, ok = x.(@Getter)
	testing.Println("@ro .(@Getter):", ok, g.Get())
	_, ok = x.(@Setter)
	testing.Println("@ro .(@Setter):", ok)
}

func generic() {
	var rb readonly Box[int]
	var x *any = &rb
	var ok bool
	_, ok = x.(*Box[int])
	testing.Println("generic .(*Box[int]):", ok)
	_, ok = x.(*readonly Box[int])
	testing.Println("generic .(*readonly Box[int]):", ok)
	var g *Getter
	g, ok = x.(*Getter)
	testing.Println("generic .(*Getter):", ok, g.Get())
	_, ok = x.(*Setter)
	testing.Println("generic .(*Setter):", ok)
	var gb *Getter = &rb
	_, ok = gb.(*Box[int])
	testing.Println("generic via Getter .(*Box[int]):", ok)
}

// laterReadonlyImpl: `impl *readonly U : Getter` follows `impl *U : GetSub`, which
// already reached Getter as an ancestor.
func laterReadonlyImpl() {
	var ru readonly U
	var g *Getter = &ru
	var x *any = &ru
	var ok bool
	_, ok = x.(*Getter)
	testing.Println("later ro impl .(*Getter):", ok, g.Get())
	_, ok = x.(*GetSub)
	testing.Println("later ro impl .(*GetSub):", ok)
}

// genericAnyOnly: nothing here boxes a Cell into Getter directly.
func genericAnyOnly() {
	var rc readonly Cell[int]
	var x *any = &rc
	var ok bool
	var g *Getter
	g, ok = x.(*Getter)
	testing.Println("generic any-only .(*Getter):", ok, g.Get())
}

// blankBinder: a read-only-receiver impl over a generic receiver with a blank
// binder, boxed only into `*any`.
func blankBinder() {
	var rt readonly Two[int8, int]
	var x *any = &rt
	var ok bool
	_, ok = x.(*Getter)
	testing.Println("blank binder .(*Getter):", ok)
	_, ok = x.(*Two[int8, int])
	testing.Println("blank binder .(*Two[int8, int]):", ok)
}

func main() {
	readonlyStruct()
	mutableStruct()
	upcast()
	managed()
	generic()
	laterReadonlyImpl()
	genericAnyOnly()
	blankBinder()
}
