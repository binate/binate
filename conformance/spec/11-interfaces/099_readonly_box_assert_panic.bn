package "main"

import "pkg/builtins/testing"

// iface.assert.readonly, iface.assert: the expression form of a mutable recovery on
// a box of a READONLY object aborts — the recovery would drop the object's readonly.

type Celsius float64

func main() {
	var c readonly Celsius = 21.0
	var x *any = &c
	var p *Celsius = x.(*Celsius)
	*p = 5.0
	testing.Println(cast(int, c))
}
