package "main"

import "pkg/builtins/testing"

// iface.impl.form, iface.dispatch: a named function-value type implements an
// interface through its pointer — `impl *FV : Sizer` — and a `*FV` boxed into a
// `*Sizer` dispatches to the pointer methods, which read and update the
// variable the pointer names.

interface Sizer {
	Size() int
	Swap(g FV)
}

type FV @func() int

func (f *FV) Size() int {
	return (*f)() + 100
}

func (f *FV) Swap(g FV) {
	*f = g
}

impl *FV : Sizer

func three() int {
	return 3
}

func four() int {
	return 4
}

func main() {
	var f FV = three
	var s *Sizer = &f
	testing.Println(s.Size())
	s.Swap(four)
	testing.Println(s.Size(), f())
}
