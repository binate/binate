package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.construct.value-borrow: a field or element of a value with no storage — a
// struct or array call result — is not addressable, so borrowing it into a raw
// interface materialises a temporary holding its value.  In a `var` initializer,
// or a composite-literal element of one, the temporary lives as long as the
// binding; in an argument it lives for the call.  Each box is used after later
// statements reuse the call results' storage, and every block is released.  A
// managed field (`H @Node`, `@[]char`) is retained by the temporary, and a method
// value of such a field boxes as a function value.

interface Getter {
	Get() int
}

type Inner struct { n int }

type V struct { p @Inner }

func (v V) Get() int { return v.p.n }

impl V : Getter

type P struct { n int }

func (p P) Get() int { return p.n }

impl P : Getter

type Hold struct {
	h   V
	q   P
	pad [8]int
}

type Node struct { n int }

type H @Node

func (h H) Get() int { return h.n }

impl H : Getter

type Box struct {
	h    H
	name @[]char
}

type Outer struct { hold Hold }

type Opts struct { g *Getter }

func mkV(n int) V {
	var v V
	v.p = make(Inner)
	v.p.n = n
	return v
}

func mkHold(n int) Hold {
	var h Hold
	h.h = mkV(n)
	h.q.n = n + 100
	return h
}

func mkOuter(n int) Outer {
	var o Outer
	o.hold = mkHold(n)
	return o
}

func mkArr(n int) [2]V {
	var a [2]V
	a[0] = mkV(n)
	a[1] = mkV(n + 1)
	return a
}

func mkBox(n int) Box {
	var b Box
	var nd @Node = make(Node)
	nd.n = n
	b.h = cast(H, nd)
	b.name = make_slice(char, 2)
	b.name[0] = 'o'
	b.name[1] = 'k'
	return b
}

func churn() int {
	var u Hold = mkHold(98)
	var w [2]V = mkArr(96)
	return u.h.p.n + w[1].p.n
}

func use(g *Getter) int {
	churn()
	return g.Get()
}

func run() {
	var f *Getter = mkHold(1).h
	var pf *Getter = mkHold(2).q
	var nested *Getter = mkOuter(3).hold.h
	var el *Getter = mkArr(4)[1]
	var o Opts = Opts{g: mkHold(7).h}
	var mh *Getter = mkBox(10).h
	var nm *any = mkBox(11).name
	var mv *any = mkHold(12).h.Get
	testing.Println(churn())
	testing.Println(f.Get(), pf.Get(), nested.Get(), el.Get(), o.g.Get(), mh.Get())
	var s @[]char
	var ok bool
	s, ok = nm.(@[]char)
	testing.Println(ok, s)
	switch v := mv.(type) {
	case int:
		testing.Println("method value boxed as int", v)
	default:
		testing.Println("method value boxed as a function value")
	}
	testing.Println(use(mkHold(8).h), use(mkArr(9)[0]))
}

func main() {
	// The bytecode VM builds some state lazily on first use, so the release check
	// measures a second, identical run.
	run()
	var base int = rt.LiveBlocks()
	run()
	testing.Println("blocks released:", rt.LiveBlocks() == base)
}
