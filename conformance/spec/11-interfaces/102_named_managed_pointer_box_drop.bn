package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// iface.construct.named-pointer, iface.dispatch: a managed pointer to a named
// managed pointer type with its own impl (`type MS @S`, `impl MS : Sizer`),
// boxed into a managed interface, dispatches on the MS it points at, and
// dropping the box releases the MS cell — not the S it points to, which other
// references keep.  Each refcount line must print 1: only `inner` holds it.

type Inner struct {
	v int
}

type S struct {
	n int
	m int
	p @Inner
}

type MS @S

interface Sizer {
	Size() int
}

func (m MS) Size() int {
	return m.n + m.p.v
}

impl MS : Sizer

var inner @Inner

func boxed() int {
	var node @S = make(S)
	node.n = 7
	node.p = inner
	var c @MS = make(MS)
	*c = node
	var s @Sizer = c
	return s.Size()
}

func kept() int {
	var node @S = make(S)
	node.n = 8
	node.p = inner
	var c @MS = make(MS)
	*c = node
	var s @Sizer = c
	c = nil
	node = nil
	return s.Size()
}

func main() {
	inner = make(Inner)
	inner.v = 100
	testing.Println(boxed())
	testing.Println(rt.Refcount(bit_cast(*uint8, inner)))
	testing.Println(kept())
	testing.Println(rt.Refcount(bit_cast(*uint8, inner)))
}
