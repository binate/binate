package "main"
import "pkg/builtins/testing"

import "pkg/geo"

// iface.construct.visible-impl, pkg.export: geo's impl of Shape for Rect is in
// geo's .bn only, so it is private to geo, and main cannot construct a Shape
// from a Rect through it.
func main() {
	var r geo.Rect
	r.W = 2
	r.H = 5
	var s *geo.Shape = &r
	testing.Println(s.Area())
}
