package "main"

import "pkg/builtins/testing"

import "pkg/geo"

// iface.assert, iface.rtti, pkg.export: an interface-target assertion consults
// every impl in the program at run time.  geo's impls are private to geo's .bn,
// so main cannot construct a Shape through them, but its assertions still find
// them: on a geo.Rect, and on a value of a type only geo's .bn declares, boxed
// in geo, through an impl of a descendant of Shape.
func main() {
	var a @any = geo.NewRect(2, 5)
	var s @geo.Shape = a.(@geo.Shape)
	testing.Println(s.Area())

	var c @any = geo.NewCube(3)
	var t @geo.Shape
	var ok bool
	t, ok = c.(@geo.Shape)
	testing.Println(ok, t.Area())
	switch v := c.(type) {
	case *geo.Solid:
		testing.Println("Solid", v.Volume())
	}
}
