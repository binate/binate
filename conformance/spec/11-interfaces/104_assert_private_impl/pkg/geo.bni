package "pkg/geo"

interface Shape {
	Area() int
}

// A Solid is a Shape with a volume.
interface Solid : Shape {
	Volume() int
}

type Rect struct {
	W int
	H int
}

func (r *Rect) Area() int

// NewRect returns a w-by-h Rect.
func NewRect(w int, h int) @Rect

// NewCube returns a cube of side s, of a type only geo's .bn declares, boxed as
// an any.
func NewCube(s int) @any
