package "pkg/geo"

func (r *Rect) Area() int { return r.W * r.H }

func NewRect(w int, h int) @Rect {
	var r @Rect = make(Rect)
	r.W = w
	r.H = h
	return r
}

// cube is declared only here, so it has no impl outside geo's .bn.
type cube struct {
	s int
}

func (c *cube) Area() int { return 6 * c.s * c.s }

func (c *cube) Volume() int { return c.s * c.s * c.s }

// Private to geo: only geo's .bn files may construct a Shape or a Solid through
// these.
impl *Rect : Shape
impl *cube : Solid

func NewCube(s int) @any {
	var c @cube = make(cube)
	c.s = s
	return c
}
