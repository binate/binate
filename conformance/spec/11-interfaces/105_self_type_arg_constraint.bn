package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// iface.self.constraint (§11.9): in a method signature of an interface I, `Self`
// as a type argument satisfies a constraint C iff I is C or extends it, directly
// or transitively.  Here `*OBox[Self]`, for `type OBox[T lang.Orderable]`, is
// accepted in I (which extends lang.Orderable), in J (which extends it through K,
// declared after J), in I2 through the method it inherits from I, and in the
// generic interface GI[U], which extends lang.Orderable whatever U is; `*G[Self]`,
// for a generic interface `G[U lang.Orderable]`, in I3.  A type built from `Self`
// is judged like any other: `W[Self]` satisfies lang.Orderable through the
// parameterized `impl W[K] : lang.Orderable`, in I4, which extends nothing.  The
// implementing methods spell each instantiation with P, which satisfies
// lang.Orderable through its impls, and a generic `use[T I2]` calls the inherited
// method.

type OBox[T lang.Orderable] struct {
	v T
}

interface G[U lang.Orderable] {
	Get() U
}

interface I : lang.Orderable {
	Put(b *OBox[Self]) int
}

interface I2 : I {
	Tag() int
}

interface J : K {
	Take(b *OBox[Self]) int
}

interface K : lang.Orderable {}

interface I3 : lang.Orderable {
	Src(g *G[Self]) int
}

type W[K any] struct {
	n int
}

func (w W[K]) Compare(o W[K]) int { return w.n - o.n }

impl W[K] : lang.Orderable

interface I4 {
	Wrap(b *OBox[W[Self]]) int
}

interface GI[U any] : lang.Orderable {
	Keep(b *OBox[Self], u U) U
}

type P struct {
	v int
}

func (p P) Compare(other P) int { return p.v - other.v }

func (p P) Put(b *OBox[P]) int { return b.v.v + p.v }

func (p P) Tag() int { return p.v * 100 }

func (p P) Take(b *OBox[P]) int { return b.v.Compare(p) }

func (p P) Src(g *G[P]) int { return g.Get().v }

func (p P) Wrap(b *OBox[W[P]]) int { return b.v.n + p.v }

func (p P) Keep(b *OBox[P], u int) int { return b.v.v * u }

impl P : I2, J, I3, I4, GI[int]

type Fixed struct {
	p P
}

func (f *Fixed) Get() P { return f.p }

impl *Fixed : G[P]

func use[T I2](t T, b *OBox[T]) int {
	return t.Put(b) + t.Tag()
}

func main() {
	var p P
	p.v = 2
	var b OBox[P]
	b.v.v = 3
	testing.Println(use[P](p, &b))
	testing.Println(p.Take(&b))
	var f Fixed
	f.p.v = 7
	var g *G[P] = &f
	testing.Println(p.Src(g))
	var wb OBox[W[P]]
	wb.v.n = 4
	testing.Println(p.Wrap(&wb))
	testing.Println(p.Keep(&b, 10))
}
