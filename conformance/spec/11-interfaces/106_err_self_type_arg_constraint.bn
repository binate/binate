package "main"

import "pkg/builtins/lang"

// iface.self.constraint (§11.9): `Self` as a type argument satisfies a constraint
// only if the interface declaring the method is that constraint or extends it.
// J extends K, declared after J, and K does not extend lang.Orderable, so
// `*OBox[Self]` in J's method is rejected, for `type OBox[T lang.Orderable]` --
// although Good, which extends lang.Orderable, writes the same `*OBox[Self]`
// first and is accepted: each is judged by its own interface.

type OBox[T lang.Orderable] struct {
	v T
}

interface Good : lang.Orderable {
	Take(b *OBox[Self]) int
}

interface J : K {
	Take(b *OBox[Self]) int
}

interface K {}

func main() {}
