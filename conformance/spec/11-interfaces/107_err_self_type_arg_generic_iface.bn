package "main"

// iface.self.constraint (§11.9): in a generic interface, whether `Self` satisfies
// a constraint is decided with the interface's own type parameters abstract.  G[U]
// extends Eq[U], not Eq[int], so `*B[Self]` for `type B[T Eq[int]]` is rejected
// in G's method, although G[int] would extend Eq[int].

interface Eq[T any] {
	Equal(o T) bool
}

type B[T Eq[int]] struct {
	v T
}

interface G[U any] : Eq[U] {
	Put(b *B[Self]) int
}

func main() {}
