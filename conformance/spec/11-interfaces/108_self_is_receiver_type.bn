package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// iface.self (§11.9): in an `impl R : I`, `Self` stands for the receiver type R
// with only an outer `readonly` dropped -- `*P` for `impl *P : I`, `@M` for `impl
// @M : I`, `*Q` for `impl readonly *Q : I`, `*readonly R` for `impl *readonly R :
// I`, `V` for `impl readonly V : I` -- so each method below takes its
// receiver's type, and a call through the constraint passes its operands as the
// method takes them (gen.satisfy: the type argument is R itself).

type P struct {
	v int
}

impl *P : lang.Comparable

func (s *P) Compare(o *P) int { return s.v - o.v }

type M struct {
	v int
}

impl @M : lang.Comparable

func (s @M) Compare(o @M) int { return s.v - o.v }

type Q struct {
	v int
}

impl readonly *Q : lang.Comparable

func (s *Q) Compare(o *Q) int { return s.v - o.v }

type R struct {
	v int
}

impl *readonly R : lang.Comparable

func (s *readonly R) Compare(o *readonly R) int { return s.v - o.v }

type V struct {
	v int
}

impl readonly V : lang.Comparable

func (s readonly V) Compare(o V) int { return s.v - o.v }

func eq[T lang.Comparable](a T, b T) bool { return a.Compare(b) == 0 }

func main() {
	var p1 P
	var p2 P
	p1.v = 3
	p2.v = 3
	testing.Println(eq[*P](&p1, &p2))
	p2.v = 4
	testing.Println(eq[*P](&p1, &p2))
	var m1 @M = make(M)
	var m2 @M = make(M)
	m1.v = 1
	m2.v = 2
	testing.Println(eq[@M](m1, m2))
	var q1 Q
	var q2 Q
	testing.Println(eq[*Q](&q1, &q2))
	var r1 R
	var r2 R
	r2.v = 1
	testing.Println(eq[*readonly R](&r1, &r2))
	var v1 V
	var v2 V
	testing.Println(eq[V](v1, v2))
}
