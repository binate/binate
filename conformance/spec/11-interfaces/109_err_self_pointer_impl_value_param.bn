package "main"

import "pkg/builtins/lang"

// iface.self (§11.9): `Self` is the impl's receiver type, so under `impl *P :
// lang.Comparable` it is `*P`, and a `Compare` taking a `P` does not match the
// interface's `Compare(o Self) int` (iface.impl.coverage).

type P struct {
	v int
}

impl *P : lang.Comparable

func (s *P) Compare(o P) int { return s.v - o.v }

func main() {}
