package "main"

import "pkg/builtins/lang"

// iface.impl.coverage (§11.3): an impl on a value receiver cannot use a method
// with a raw-pointer receiver -- the impl has no value whose address a call
// could take -- for an interface whose methods use `Self` or not, and for a
// parameterized impl.

type P struct {
	v int
}

impl P : lang.Comparable

func (s *P) Compare(o P) int { return s.v - o.v }

type R struct {
	v int
}

impl readonly R : lang.Stringer

func (r *readonly R) String() @[]char { return "r" }

type W[K any] struct {
	k int
}

impl W[K] : lang.Stringer

func (w *W[K]) String() @[]char { return "w" }

func main() {}
