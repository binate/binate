package "main"

import "pkg/builtins/testing"

// iface.assert: a box made from a raw pointer does not satisfy an interface
// whose impl takes a managed receiver -- the impl's method would run on an
// object with no reference count -- so asserting it misses, for a plain type
// and for a generic one; a box made from a managed pointer still matches.

interface Sz {
	sz() int
}

type T struct { u int16 }

func (w @T) sz() int { return 30 }

impl @T : Sz

type W[U any] struct { u U }

func (w @W[U]) sz() int { return 40 }

impl @W[U] : Sz

func probe(a *any) int {
	s, ok := a.(*Sz)
	if ok { return s.sz() }
	return -1
}

func main() {
	var v T
	testing.Println(probe(&v))
	var g W[int16]
	testing.Println(probe(&g))
	var m @T = make(T)
	var b @any = m
	testing.Println(probe(b))
}
