package "main"

import "pkg/builtins/reflect"
import "pkg/builtins/testing"

import "pkg/po"

// iface.assert.origin, iface.assert: a box made from a raw pointer asserts only to
// the interfaces an impl a raw pointer can supply implements -- G (`*T`) and R
// (`*readonly T`), not M (`@T`) -- and keeps that record when recovered as an
// interface value and converted to `any`; a box made from a managed pointer
// asserts to every one, also through a borrowed `*any`.  The record is no part of
// the box's dynamic type, which reflection sees alike either way
// (type.layout.typeinfo).  po declares the types and their impls; main makes the
// boxes and asserts.

// probe prints what a gives through G, M and R, -1 for each it misses.
func probe(a *any) {
	var g int = -1
	var m int = -1
	var r int = -1
	sg, okg := a.(*po.G)
	if okg { g = sg.get() }
	sm, okm := a.(*po.M)
	if okm { m = sm.put() }
	sr, okr := a.(*po.R)
	if okr { r = sr.look() }
	testing.Println(g)
	testing.Println(m)
	testing.Println(r)
}

// sameType gives 1 when reflection gives x and y one dynamic type, else 0.
func sameType(x *any, y *any) int {
	if reflect.TypeOf(x) == reflect.TypeOf(y) { return 1 }
	return 0
}

func main() {
	var v po.T
	v.X = 1
	probe(&v)
	var w @po.T = make(po.T)
	w.X = 2
	var b @any = w
	probe(b)
	// Recovered as an interface value and converted to any: the record is kept.
	var a *any = &v
	g, ok := a.(*po.G)
	if ok {
		var a2 *any = g
		probe(a2)
	}
	gm, okm := b.(@po.G)
	if okm {
		var b2 @any = gm
		probe(b2)
	}
	// A box main makes into po.G, then converts to any.
	var sg *po.G = &v
	var a3 *any = sg
	probe(a3)
	// A readonly object boxed from a raw pointer: R only.
	var p *readonly po.T = &v
	var a4 *any = p
	probe(a4)
	// A concrete target matches a box made either way.
	t1, ok1 := a.(*po.T)
	if ok1 { testing.Println(t1.X) }
	var bb *any = b
	t2, ok2 := bb.(*po.T)
	if ok2 { testing.Println(t2.X) }
	// A type switch takes the first case the box matches.
	switch a.(type) {
	case *po.M:
		testing.Println(100)
	case *po.G:
		testing.Println(200)
	default:
		testing.Println(300)
	}
	// A generic instance boxed from a raw pointer, and from a managed one.
	var bi po.B[int16]
	probe(&bi)
	var bm @po.B[int16] = make(po.B[int16])
	var bmb @any = bm
	probe(bmb)
	// Reflection: one dynamic type whichever way the box was made; a readonly
	// object's box has T's readonly variant, a type of its own.
	var wr @readonly po.T = w
	var br @any = wr
	testing.Println(sameType(&v, b))
	testing.Println(sameType(a4, br))
	testing.Println(sameType(&v, a4))
	testing.Println(sameType(&bi, bmb))
}
