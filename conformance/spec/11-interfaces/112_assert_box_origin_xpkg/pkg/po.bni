package "pkg/po"

// G is implemented through a raw-pointer receiver, M through a managed one and R
// through a readonly raw-pointer one, by T and by each instance of B.
interface G {
	get() int
}

interface M {
	put() int
}

interface R {
	look() int
}

type T struct {
	X int
}

func (t *T) get() int

func (t @T) put() int

func (t *readonly T) look() int

impl *T : G

impl @T : M

impl *readonly T : R

type B[U any] struct {
	X U
}

func (b *B[U]) get() int {
	return 50
}

func (b @B[U]) put() int {
	return 60
}

impl *B[U] : G

impl @B[U] : M
