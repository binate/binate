package "main"

import "pkg/builtins/testing"

// iface.assert: `any` is satisfied by every present value, so `.(*any)` /
// `.(@any)` and a `case *any:` hit on any box -- here of a type no code boxes
// into `any` directly, also through an alias of `any` and from a box upcast to a
// parent interface -- and miss only on an unset one.  The value recovered as
// `any` asserts back to G.

interface P {
	base() int
}

interface G : P {
	get() int
}

interface A = any

type T struct {
	X int
}

func (t *T) get() int {
	return t.X
}

func (t *T) base() int {
	return t.X + 100
}

impl *T : G

func flag(b bool) int {
	if b { return 1 }
	return 0
}

func viaAny(g *G) int {
	a, ok := g.(*any)
	if !ok { return -1 }
	h, ok2 := a.(*G)
	if !ok2 { return -2 }
	return h.get()
}

func kind(g *G) int {
	switch g.(type) {
	case *any:
		return 1
	default:
		return 0
	}
}

func main() {
	var t T
	t.X = 7
	var g *G = &t
	testing.Println(viaAny(g))
	var m @T = make(T)
	m.X = 8
	var mg @G = m
	testing.Println(viaAny(mg))
	var ma @any = mg.(@any)
	_, okm := ma.(@G)
	testing.Println(flag(okm))
	testing.Println(kind(g))
	var unset *G
	_, oku := unset.(*any)
	testing.Println(flag(oku))
	testing.Println(kind(unset))
	var al *A = g.(*A)
	h, okh := al.(*G)
	if okh { testing.Println(h.get()) }
	var p *P = g
	pa, okp := p.(*any)
	if okp {
		q, okq := pa.(*P)
		if okq { testing.Println(q.base()) }
	}
}
