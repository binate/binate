package "main"

import "pkg/builtins/testing"

// iface.impl.unique: an interface may appear only once in an impl's list -- also
// when an alias names it.

interface Tag[T any] {
	tag() int
}

type C struct {
	v int
}

func (c *C) tag() int {
	return c.v
}

impl *C : Tag[int], Tag[int]

interface Named {
	name() int
}

interface NA = Named

type D struct {
	v int
}

func (d *D) name() int {
	return d.v
}

impl *D : Named, NA

func main() {
	testing.Println(0)
}
