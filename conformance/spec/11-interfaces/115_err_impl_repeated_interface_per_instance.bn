package "main"

import "pkg/builtins/testing"

// iface.impl.unique / gen.mono.check: a parameterized impl's list is checked as
// each instance of it has it: Box[int]'s impl lists Tag[int] twice, Box2[int64]'s
// Tag[[8]uint8] twice -- each an error in that instance's impl, naming it.

interface Tag[T any] {
	tag() int
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) tag() int {
	return 1
}

impl *Box[K] : Tag[K], Tag[int]

type Box2[K any] struct {
	k K
}

func (b *Box2[K]) tag() int {
	return 2
}

impl *Box2[K] : Tag[[sizeof(K)]uint8], Tag[[8]uint8]

func main() {
	var b Box[int]
	_ = b
	var b2 Box2[int64]
	_ = b2
}
