package "main"

import "pkg/builtins/testing"

// iface.impl.unique / gen.mono.check: as 115, the instances whose impl lists no
// interface twice are valid: Box[int64] (Tag[int64], Tag[int]) and Box2[int32]
// (Tag[[4]uint8], Tag[[8]uint8]).

interface Tag[T any] {
	tag() int
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) tag() int {
	return 1
}

impl *Box[K] : Tag[K], Tag[int]

type Box2[K any] struct {
	k K
}

func (b *Box2[K]) tag() int {
	return 2
}

impl *Box2[K] : Tag[[sizeof(K)]uint8], Tag[[8]uint8]

func main() {
	var b Box[int64]
	var t *Tag[int] = &b
	var u *Tag[int64] = &b
	testing.Println(t.tag() + u.tag())
	var b2 Box2[int32]
	var t2 *Tag[[8]uint8] = &b2
	var u2 *Tag[[4]uint8] = &b2
	testing.Println(t2.tag() + u2.tag())
}
