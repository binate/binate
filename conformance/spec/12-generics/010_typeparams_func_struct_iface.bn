package "main"

import "pkg/builtins/lang"

// gen.typeparams: a bracketed type-parameter list, each param with a
// constraint, may appear on a free FUNCTION, a STRUCT, and an
// INTERFACE. Here `cmp` (function), `Box` (struct), and `Holder`
// (interface) each carry a constrained type param. `cmp` is instantiated
// and called (int satisfies lang.Orderable via the auto-available
// primitive impl) and `Box[int]` is instantiated and its T-typed field
// round-tripped, so the type-param substitution is exercised on both the
// function and struct forms. `Holder` is declared but uninstantiated
// (interface dispatch over a generic interface is exercised by 035).

func cmp[T lang.Orderable](a T, b T) int {
	return a.Compare(b)
}

type Box[T lang.Orderable] struct {
	val T
}

interface Holder[T lang.Orderable] {
	get() T
}

func main() {
	var b Box[int]                 // instantiate the generic struct
	b.val = 5
	if cmp[int](2, 9) < 0 && cmp[int](9, 2) > 0 && b.val == 5 {
		println("ok")
	} else {
		println("FAIL")
	}
}
