package "main"

// gen.constraint: `[T any]` is unconstrained — a T value may be stored
// and moved, but no method may be called on it (there are none). Here
// `T` is stored into a local (`var y T = x`), into a generic-struct
// field (`b.val`), passed as an argument, and returned — all without
// any method call on T.

type Cell[T any] struct {
	val T
}

func store[T any](x T) Cell[T] {
	var c Cell[T]
	c.val = x
	return c
}

func roundtrip[T any](x T) T {
	var y T = x
	var c Cell[T] = store[T](y)
	return c.val
}

func main() {
	var r int = roundtrip[int](42)
	if r == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
