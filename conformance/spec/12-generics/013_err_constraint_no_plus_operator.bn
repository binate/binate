package "main"

// gen.constraint (Constraint): there is NO `+` operator to combine
// constraints. To require several interfaces, declare a combined
// interface that extends them (§11.6) and name THAT. Writing `[T A + B]`
// is rejected at PARSE time -- the type-param grammar closes the
// constraint at `A` and has no `+` production, so it chokes on the `+`
// (distinct from 012's checker-level non-interface rejection).

interface A {
	foo() int
}

interface B {
	bar() int
}

func bad[T A + B](x T) int {
	return x.foo()
}

func main() {
	println("unreached")
}
