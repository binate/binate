package "main"

// gen.no-generic-methods (Constraint): type parameters may be declared
// on free functions, NOT on methods. A method written with a type-
// parameter list is rejected at its declaration (use a generic free
// function instead).

type Box struct {
	v int
}

func (b *Box) get[U any]() int {
	return b.v
}

func main() {
	println("unreached")
}
