package "main"

// gen.instantiate: a generic is instantiated by writing its name
// followed by EXPLICIT type arguments — there is no inference. Both
// spelled-out forms appear here: the generic-function call
// `id[int](7)` and the generic-type instantiation `var b Box[int]`.

func id[T any](x T) T {
	return x
}

type Box[T any] struct {
	val T
}

func main() {
	var n int = id[int](7)
	var b Box[int]
	b.val = id[int](35)
	if n + b.val == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
