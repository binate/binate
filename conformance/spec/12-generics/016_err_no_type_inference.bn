package "main"

// gen.instantiate: there is no type inference. Calling a generic
// function without explicit type arguments (`id(5)` instead of
// `id[int](5)`) is rejected — the type arguments must be written at
// the instantiation site.

func id[T any](x T) T {
	return x
}

func main() {
	var n int = id(5)
	_ = n
}
