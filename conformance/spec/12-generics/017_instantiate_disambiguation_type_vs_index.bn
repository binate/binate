package "main"

// gen.instantiate.disambiguation: the form `name[...]` is resolved by
// what `name` is.
//   * In TYPE syntax, `var b Box[int]` is unconditionally a
//     type-argument list (there is no value indexing in type syntax).
//   * In EXPRESSION position, the parser emits a combined node and the
//     checker resolves it: `id[int]` — `id` is a generic decl, so
//     `[int]` is a type-argument list; `xs[0]` — `xs` is an indexable
//     value (array), so `[0]` is an index.

type Box[T any] struct {
	val T
}

func id[T any](x T) T {
	return x
}

func main() {
	var b Box[int]            // type syntax: type-arg list
	b.val = id[int](40)       // expr position, generic head: type-arg list
	var xs [3]int
	xs[0] = 2
	var v int = xs[0]         // expr position, indexable head: index
	if b.val + v == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
