package "main"

// gen.mono (§12.3): each (generic decl, type-arg tuple) is monomorphized
// into its own DISTINCT type.  Vec[int] and Vec[bool] are different types;
// Vec[int] is the SAME type as Vec[int] (a second instantiation with the
// same args).  We show same-args interoperate (a Vec[int] value assigns to
// another Vec[int] variable) while the body is specialized per instantiation
// (the int and bool fields read back the values written).  The mutual
// non-assignability of Vec[int] vs Vec[bool] is pinned by the negative 031.

type Vec[T any] struct {
	v T
}

func main() {
	var a Vec[int]
	a.v = 7
	// Same (decl, args) => same type: a Vec[int] flows into another Vec[int].
	var a2 Vec[int] = a
	var b Vec[bool]
	b.v = true
	if a2.v == 7 && b.v {
		println("ok")
	} else {
		println("FAIL")
	}
}
