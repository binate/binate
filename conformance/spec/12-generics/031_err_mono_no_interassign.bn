package "main"
import "pkg/builtins/testing"

// gen.mono (§12.3) Constraint facet: distinct instantiations of one generic
// are DISTINCT, non-inter-assignable types.  Vec[bool] is not assignable to
// a Vec[int] variable (and there is no implicit conversion) -- mirrors the
// two-named-types non-interassign rule (§7.3) applied to monomorphized
// instantiations.

type Vec[T any] struct {
	v T
}

func main() {
	var b Vec[bool]
	b.v = true
	var a Vec[int] = b   // Vec[bool] -> Vec[int]: rejected (distinct types)
	testing.Println(a.v)
}
