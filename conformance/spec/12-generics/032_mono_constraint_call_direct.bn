package "main"

import "pkg/builtins/lang"

// gen.mono.constraint-call (§12.3): a call THROUGH a constraint in a generic
// body (`a.Compare(b)` where a,b : T and T's constraint Orderable declares
// Compare) is checked against the constraint's abstract signature at body
// time, then lowered at instantiation to a DIRECT call to the concrete
// method -- here int.Compare from pkg/builtins/lang's `impl int : Orderable`
// (Orderable extends Comparable, §11.6).  No vtable/indirection: the
// instantiated body behaves like hand-written int code.  We assert the three
// orderings (lt<0, eq==0, gt>0) round-trip through int.Compare.

func cmp[T lang.Orderable](a T, b T) int {
	return a.Compare(b)
}

func main() {
	if cmp[int](3, 5) < 0 && cmp[int](4, 4) == 0 && cmp[int](8, 1) > 0 {
		println("ok")
	} else {
		println("FAIL")
	}
}
