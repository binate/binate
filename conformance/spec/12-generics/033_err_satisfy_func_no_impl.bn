package "main"
import "pkg/builtins/testing"

// gen.satisfy (§12.4) Constraint: a generic FUNCTION instantiated with a type
// arg that has NO visible `impl T : I` is an instantiation error naming the
// missing satisfaction.  `NoSpeak` has no `impl NoSpeak : I`, so `use[NoSpeak]`
// must be rejected.  (034 is the generic-STRUCT instantiation counterpart.)

interface I { M() int }

type NoSpeak struct { x int }

func use[T I](t T) int { return t.M() }

func main() {
	var n NoSpeak
	n.x = 1
	testing.Println(use[NoSpeak](n))
}
