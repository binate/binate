package "main"
import "pkg/builtins/testing"

import "pkg/builtins/lang"

// gen.satisfy (§12.4) Constraint: a generic STRUCT instantiated with a type
// arg that does NOT satisfy the parameter's constraint is rejected, just as a
// generic-FUNCTION instantiation is (033) -- `Box[NoOrder]` for
// `type Box[T lang.Orderable]` is an error (NoOrder has no
// `impl NoOrder : Orderable`).

type NoOrder struct { x int }

type Box[T lang.Orderable] struct { v T }

func main() {
	var b Box[NoOrder]
	b.v.x = 5
	testing.Println(b.v.x)
}
