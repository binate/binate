package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4) Constraint -- KNOWN GAP gen.satisfy.struct-iface-unchecked
// (§12.4 "Open / known gap"): a generic STRUCT instantiated with a type arg
// that does NOT satisfy the parameter's constraint SHOULD be rejected, but the
// checker currently enforces constraint satisfaction only at generic-FUNCTION
// instantiation -- so `Box[NoOrder]` for `type Box[T lang.Orderable]` is
// wrongly ACCEPTED (NoOrder has no `impl NoOrder : Orderable`).  This is a
// NEGATIVE test that currently PASSES compilation (the bug): predicted_xfail.
// When the gap is fixed the constraint miss will be diagnosed here.

type NoOrder struct { x int }

type Box[T lang.Orderable] struct { v T }

func main() {
	var b Box[NoOrder]
	b.v.x = 5
	println(b.v.x)
}
