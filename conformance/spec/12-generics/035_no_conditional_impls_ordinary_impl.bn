package "main"
import "pkg/builtins/testing"

// gen.no-conditional-impls (§12.4) forbids conditional and specific-instantiation
// impls — impls whose RECEIVER is a generic instantiation — but a PLAIN type
// implementing an instantiation of a generic INTERFACE is unrelated and allowed:
// here the non-generic IntPair carries `impl IntPair : Pair[int]`.  Dispatch
// through the Pair[int] interface value resolves to IntPair's methods.

interface Pair[T any] {
	first() T
	second() T
}

type IntPair struct {
	a int
	b int
}

impl IntPair : Pair[int]

func (p IntPair) first() int { return p.a }
func (p IntPair) second() int { return p.b }

func main() {
	var p IntPair
	p.a = 3
	p.b = 5
	var ip *Pair[int] = &p
	if ip.first() == 3 && ip.second() == 5 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
