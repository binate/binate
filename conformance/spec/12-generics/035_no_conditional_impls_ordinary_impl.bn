package "main"

// gen.no-conditional-impls (§12.4): there are NO conditional impls (an impl
// that applies only for certain type args).  A specific instantiation may,
// however, carry its OWN ordinary impl declaration.  Here the generic
// interface Pair[T] is instantiated as Pair[int], and a concrete (non-generic)
// type IntPair carries an ORDINARY `impl IntPair : Pair[int]` -- a plain,
// unconditional impl tied to one specific instantiation.  Dispatch through the
// Pair[int] interface value resolves to IntPair's methods.

interface Pair[T any] {
	first() T
	second() T
}

type IntPair struct {
	a int
	b int
}

impl IntPair : Pair[int]

func (p IntPair) first() int { return p.a }
func (p IntPair) second() int { return p.b }

func main() {
	var p IntPair
	p.a = 3
	p.b = 5
	var ip *Pair[int] = &p
	if ip.first() == 3 && ip.second() == 5 {
		println("ok")
	} else {
		println("FAIL")
	}
}
