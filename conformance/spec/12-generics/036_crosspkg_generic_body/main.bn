package "main"
import "pkg/builtins/testing"

import "pkg/cont"

// gen.crosspkg.body (§12.5): a consumer package monomorphizes a generic by
// specializing its BODY, so a generic decl must carry its full source-text
// body in the package's .bni (the C++ "template in the header" model).  Here
// cont.Cell (generic struct), cont.Make and cont.Get (generic funcs) are
// defined ENTIRELY in cont.bni, with bodies; this consumer instantiates
// Cell[int]/Make[int]/Get[int] by monomorphizing those .bni bodies at the use
// site.  Self-contained: the generic bodies reference only their own type
// param + builtins (no qualified cross-package call), isolating this rule from
// transitive-instantiation facets.
func main() {
	var c @cont.Cell[int] = cont.Make[int](42)
	if cont.Get[int](c) == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
