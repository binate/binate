package "pkg/cont"

// Generic struct: the type's full definition lives in the .bni.
type Cell[T any] struct { v T }

// Generic functions carry their full source-text BODY here in the .bni (the
// one parse-time difference from a non-generic func, whose body stays in the
// .bn).  A consumer instantiates Cell[int]/Make[int]/Get[int] by monomorphizing
// these bodies at the use site -- the package can otherwise ship as interface +
// compiled library, but a generic must ship its body in the .bni.
func Make[T any](x T) @Cell[T] {
	var c @Cell[T] = make(Cell[T])
	c.v = x
	return c
}

func Get[T any](c @Cell[T]) T { return c.v }
