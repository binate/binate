package "main"
import "pkg/builtins/testing"

// gen.no-conditional-impls (§12.4): there are no conditional impls in v1 — no
// impl carrying constraints of its own, beyond its type's, so that it applies
// only for certain type arguments.  The grammar has no `impl[...]` production for
// such an impl's own type-parameter list, so `impl[T any] Box[T] : Show` is
// rejected at parse time.  (An impl on a generic type uses the parameterized form
// `impl Box[T] : Show`, gen.impl.generic-recv; a plain type implementing an
// interface instantiation is allowed — 035.)

interface Show {
	show() int
}

type Box[T any] struct {
	val T
}

impl[T any] Box[T] : Show

func main() {
	testing.Println("unreached")
}
