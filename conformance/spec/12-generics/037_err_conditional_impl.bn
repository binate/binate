package "main"

// gen.no-conditional-impls: there are NO conditional impls in v1 -- an impl
// PARAMETERIZED over a type argument (one that applies only for certain type
// arguments). The grammar has no `impl[T] ...` production, so attempting a
// conditional impl `impl[T any] Box[T] : Show` is rejected at parse time. (The
// permitted form is an ORDINARY impl on a specific instantiation -- 035.)

interface Show {
	show() int
}

type Box[T any] struct {
	val T
}

impl[T any] Box[T] : Show

func main() {
	println("unreached")
}
