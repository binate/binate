package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): each type-argument is checked against ITS OWN
// type-parameter's constraint. Here A=int satisfies Orderable but B=NoOrder
// does not (no `impl NoOrder : Orderable`), so the SECOND argument's miss must
// be diagnosed -- exercising the multi-type-parameter path of the
// instantiation-time constraint check.
type NoOrder struct { x int }

type Pair[A lang.Orderable, B lang.Orderable] struct { a A; b B }

func main() {
	var p Pair[int, NoOrder]
	p.a = 1
	println(p.a)
}
