package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): constraint satisfaction is enforced for generic
// INTERFACE instantiation too, not just structs -- the check lives in the
// shared instantiateGenericDeclWithArgs. Instantiating `Holder[NoOrder]`
// (NoOrder has no `impl NoOrder : Orderable`) must be rejected.
type NoOrder struct { x int }

interface Holder[T lang.Orderable] {
	get() T
}

func main() {
	var h *Holder[NoOrder] = nil
	_ = h
}
