package "main"

// gen.enum.no-first-class: an enumeration is a NAMED INTEGER TYPE plus a
// grouped const block using `iota` (§12.6) — Binate has no first-class
// enum type.  The members OpAdd/OpSub/OpMul are TYPED constants of the
// named type Opcode carrying 0/1/2 (iota).  Because Opcode is a distinct
// type (§7.3), reading a member as an integer requires an explicit
// `cast` — exercised here via cast(int, ...).  A bare member (OpMul)
// inherits the preceding member's type and re-evaluates `iota`.

type Opcode uint8

const (
	OpAdd Opcode = iota // 0
	OpSub               // 1
	OpMul               // 2
)

func main() {
	// Members fold to the iota index, typed as Opcode; cast to int to read.
	if cast(int, OpAdd) != 0 {
		println("FAIL")
		return
	}
	if cast(int, OpSub) != 1 {
		println("FAIL")
		return
	}
	if cast(int, OpMul) != 2 {
		println("FAIL")
		return
	}
	// A value typed as the named type round-trips through the underlying
	// integer only via an explicit cast (the legal conversion path).
	var op Opcode = OpSub
	var n int = cast(int, op)
	if n != 1 {
		println("FAIL")
		return
	}
	// Casting an integer back to the named type is likewise explicit.
	var op2 Opcode = cast(Opcode, 2)
	if op2 != OpMul {
		println("FAIL")
		return
	}
	println("ok")
}
