package "main"

// gen.enum.bitflags: a bit-flag SET is a named integer type whose grouped
// const block uses `1 << iota` (§12.6) — FlagRead/FlagWrite/FlagExec fold
// to 1/2/4 (NOT the plain iota index), typed as the named type Flags.
// Bare members inherit the `1 << iota` initializer re-evaluated at their
// own iota.  Flags combine with bitwise OR and membership is tested with
// bitwise AND, all in the named type.

type Flags uint32

const (
	FlagRead  Flags = 1 << iota // 1
	FlagWrite                   // 2
	FlagExec                    // 4
)

func main() {
	// Each flag is a distinct power of two (1<<iota, not iota).
	if cast(int, FlagRead) != 1 {
		println("FAIL")
		return
	}
	if cast(int, FlagWrite) != 2 {
		println("FAIL")
		return
	}
	if cast(int, FlagExec) != 4 {
		println("FAIL")
		return
	}
	// Combine with bitwise OR (stays typed as Flags).
	var set Flags = FlagRead | FlagExec // 1 | 4 = 5
	if cast(int, set) != 5 {
		println("FAIL")
		return
	}
	// Membership test with bitwise AND: present flags are non-zero, an
	// absent flag ANDs to zero.
	if (set & FlagRead) == cast(Flags, 0) {
		println("FAIL")
		return
	}
	if (set & FlagExec) == cast(Flags, 0) {
		println("FAIL")
		return
	}
	if (set & FlagWrite) != cast(Flags, 0) {
		println("FAIL")
		return
	}
	println("ok")
}
