package "main"

// gen.enum.no-first-class (Constraint): an enum member / value is typed as
// the NAMED integer type (Opcode), which is a DISTINCT type from its
// underlying integer (§7.3, §12.6).  Reading it as a plain `int` requires
// an explicit `cast` — an IMPLICIT Opcode -> int conversion is REJECTED.
// (The legal form `var n int = cast(int, op)` is exercised in 060.)

type Opcode uint8

const (
	OpAdd Opcode = iota
	OpSub
	OpMul
)

func main() {
	var op Opcode = OpSub
	var n int = op // ERROR: no implicit Opcode -> int; needs cast(int, op)
	println(n)
}
