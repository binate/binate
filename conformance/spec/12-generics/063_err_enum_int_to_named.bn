package "main"
import "pkg/builtins/testing"

// gen.enum.no-first-class (Constraint): the reverse implicit conversion is
// also rejected — a plain `int` VALUE (here a variable `i`, not an untyped
// literal) assigned to a named-enum-typed var without a `cast` is an error.
// The named type Opcode is distinct from int (§7.3, §12.6); the legal form
// is `var op Opcode = cast(Opcode, i)` (exercised in 060).  Note: an
// untyped integer LITERAL initializer (`var op Opcode = 2`) WOULD be
// accepted by untyped-literal coercion — this test deliberately uses an
// `int`-typed variable to isolate the implicit-conversion rejection.

type Opcode uint8

const (
	OpAdd Opcode = iota
	OpSub
	OpMul
)

func main() {
	var i int = 2
	var op Opcode = i // ERROR: no implicit int -> Opcode; needs cast(Opcode, i)
	testing.Println(cast(int, op))
}
