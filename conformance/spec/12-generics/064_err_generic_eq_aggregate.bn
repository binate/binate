package "main"
import "pkg/builtins/testing"

// expr.compare.typeparam: `==`/`!=` is not defined on a type parameter — a
// generic body comparing a bare `T` (`a == b`) is rejected at the DEFINITION,
// regardless of the concrete type argument (there is no operator form for a type
// parameter).  Constrain T and compare via a method instead: `[T lang.Comparable]`,
// `a.Compare(b) == 0`.

func eq[T any](a T, b T) bool {
	return a == b
}

func main() {
	var x *[]readonly char = "hi"
	testing.Println(eq[*[]readonly char](x, x))
}
