package "main"

// gen.instantiate: a generic `==`/`!=` on a type parameter is deferred at
// definition (T is opaque), then re-validated when the type-argument is
// concrete.  Instantiating with a raw slice — which has no `==` — is rejected
// at the instantiation, not left to reach IR-gen as an `icmp` on a multi-word
// value.

func eq[T any](a T, b T) bool {
	return a == b
}

func main() {
	var x *[]readonly char = "hi"
	println(eq[*[]readonly char](x, x))
}
