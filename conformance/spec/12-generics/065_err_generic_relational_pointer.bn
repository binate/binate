package "main"

// expr.compare.typeparam: a relational `<` is not defined on a type parameter —
// `a < b` on a bare `T` is rejected at the generic DEFINITION.  Order via a
// constrained method instead: `[T lang.Orderable]`, `a.Compare(b) < 0`.

func less[T any](a T, b T) bool {
	return a < b
}

func main() {
	var p *int = nil
	println(less[*int](p, p))
}
