package "main"

// gen.instantiate: a generic relational `<` on a type parameter requires the
// concrete type-argument to be numeric (ordering is undefined for pointers and
// aggregates).  Instantiating with a pointer is rejected at the instantiation,
// not left to reach IR-gen.

func less[T any](a T, b T) bool {
	return a < b
}

func main() {
	var p *int = nil
	println(less[*int](p, p))
}
