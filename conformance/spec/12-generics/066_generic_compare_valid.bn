package "main"

// gen.instantiate: a generic comparison instantiated with a valid type-argument
// (int) is NOT over-rejected by the inferred-comparable check — the flag only
// constrains the type-argument, it never rejects a comparable one.

func eq[T any](a T, b T) bool {
	return a == b
}

func less[T any](a T, b T) bool {
	return a < b
}

func main() {
	println(eq[int](3, 3))
	println(less[int](2, 5))
}
