package "main"

// gen.instantiate: a generic == instantiated with a comparable STRUCT type
// argument is accepted (the struct is transitively comparable) and lowered
// field-wise — the inferred-comparable re-check (recordTypeParamComparison)
// and the aggregate-equality lowering (gen_eq_aggregate.bn) compose.

type Point struct {
	x int
	y int
}

func eq[T any](a T, b T) bool {
	return a == b
}

func main() {
	var p Point = Point{1, 2}
	var q Point = Point{1, 2}
	var r Point = Point{1, 3}
	if eq[Point](p, q) && !eq[Point](p, r) {
		println("ok")
	} else {
		println("FAIL")
	}
}
