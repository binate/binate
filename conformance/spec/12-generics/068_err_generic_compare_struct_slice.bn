package "main"

// gen.instantiate: a generic == instantiated with a struct that transitively
// contains a slice is rejected AT THE INSTANTIATION — the inferred-comparable
// re-check runs the recursive aggregate-comparability check on the concrete
// type argument, not just a top-level kind test.

type S struct {
	v @[]int
}

func eq[T any](a T, b T) bool {
	return a == b
}

func main() {
	var a S
	var b S
	println(eq[S](a, b))
}
