package "main"
import "pkg/builtins/testing"

// expr.compare.typeparam: comparing an aggregate whose comparability depends on a
// type parameter reached BY VALUE (`Box[T]{ v T }`, `a == b`) is rejected at the
// generic DEFINITION — the struct is comparable only if its `T` field is, and a
// type parameter has no defined comparison.  (A `T` behind a pointer is fine — 071.)

type Box[T any] struct {
	v T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	var a Box[@[]int]
	a.v = x
	var b Box[@[]int]
	b.v = x
	testing.Println(cmp[@[]int](a, b))
}
