package "main"

// gen.instantiate: a generic struct `Box[T]` whose field is the type parameter
// `T`, compared with `==` inside a generic function, IS re-checked for
// comparability at instantiation — `recordTypeParamComparison` propagates the
// inferred-comparable flag through an aggregate operand's by-value fields /
// elements to the inner type parameter, so `cmp[@[]int]` (whose `Box[@[]int]`
// has a slice field) is rejected at the instantiation, naming the offending
// type argument, rather than reaching IR-gen as an invalid aggregate compare.

type Box[T any] struct {
	v T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	var a Box[@[]int]
	a.v = x
	var b Box[@[]int]
	b.v = x
	println(cmp[@[]int](a, b))
}
