package "main"

// gen.instantiate (KNOWN GAP — xfail): a generic struct `Box[T]` whose field
// is the type parameter `T`, compared with `==` inside a generic function, is
// NOT re-checked for comparability when instantiated with a non-comparable
// type argument.  `Box[@[]int]` has a slice field, so `cmp[@[]int]` SHOULD be
// rejected ("this struct is not comparable") — exactly as the concrete case is
// (spec/13-expressions/050).  But the instantiation-time re-check (920b) only
// re-validates a DIRECT type-parameter operand, not a type parameter buried in
// a generic aggregate, so the comparison reaches IR-gen: an invalid aggregate
// `icmp` on the LLVM backends (a loud clang failure) and a first-word-only
// managed-slice compare on the bytecode VM (a silent wrong result).  Newly
// reachable since struct/array `==` is implemented (920a) — before that, the
// generic body's `a == b` was rejected outright.  Tracked in claude-todo.md.

type Box[T any] struct {
	v T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	var a Box[@[]int]
	a.v = x
	var b Box[@[]int]
	b.v = x
	println(cmp[@[]int](a, b))
}
