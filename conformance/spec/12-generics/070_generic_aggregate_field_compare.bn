package "main"

// gen.instantiate: a generic struct Box[T] instantiated with a COMPARABLE type
// argument is accepted and lowered field-wise — the inferred-comparable
// re-check (recordTypeParamComparison recursing through the by-value `v T`
// field) does NOT false-reject a comparable instantiation, and the generic +
// aggregate-equality paths compose end-to-end.

type Box[T any] struct {
	v T
	n int
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	var a Box[int]
	a.v = 5
	a.n = 1
	var b Box[int]
	b.v = 5
	b.n = 1
	var c Box[int]
	c.v = 9
	c.n = 1
	if cmp[int](a, b) && !cmp[int](a, c) {
		println("ok")
	} else {
		println("FAIL")
	}
}
