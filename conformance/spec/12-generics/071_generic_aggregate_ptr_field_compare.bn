package "main"
import "pkg/builtins/testing"

// expr.compare.typeparam / expr.compare.equality: a type parameter reached only
// BEHIND a managed pointer (`Box[T]{ p @T }`) does NOT make the comparison depend on
// `T`'s comparability — the `@T` field compares by pointer identity regardless of
// `T` — so `cmp[T]` over such a struct is ACCEPTED even for a non-comparable `T`
// like `@[]int` (containsByValueTypeParam stops at the pointer).

type Box[T any] struct {
	p @T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	// Both p fields zero-init to nil; comparing the @T fields by identity is
	// nil == nil (no allocation, no refcount traffic).
	var a Box[@[]int]
	var b Box[@[]int]
	if cmp[@[]int](a, b) {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
