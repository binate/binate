package "main"

// gen.instantiate: a type parameter reached only BEHIND a managed pointer (@T)
// in a generic struct does NOT constrain the instantiation's comparability —
// the field compares by pointer identity regardless of T's comparability, so
// `cmp[@[]int]` over Box[T]{ p @T } is ACCEPTED (the by-value-only propagation
// in recordTypeParamComparison stops at the pointer and never flags T, so a
// non-comparable type argument like @[]int is not false-rejected here).

type Box[T any] struct {
	p @T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	// Both p fields zero-init to nil; comparing the @T fields by identity is
	// nil == nil (no allocation, no refcount traffic).
	var a Box[@[]int]
	var b Box[@[]int]
	if cmp[@[]int](a, b) {
		println("ok")
	} else {
		println("FAIL")
	}
}
