package "main"

// expr.compare.typeparam: the by-value type-parameter check reaches through an
// ARRAY-of-`T` field too (`Box[T]{ items [2]T }`), so comparing such a struct in a
// generic body is rejected at the DEFINITION — same as the struct-field case (069),
// exercising the array arm of the by-value recursion.

type Box[T any] struct {
	items [2]T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	var a Box[@[]int]
	a.items[0] = x
	var b Box[@[]int]
	b.items[0] = x
	println(cmp[@[]int](a, b))
}
