package "main"

// gen.instantiate: the inferred-comparable re-check propagates through an
// ARRAY-of-type-parameter field, not just a struct field — `Box[T]{ items [2]T }`
// instantiated with `@[]int` has an array-of-slice field, so `cmp[@[]int]` is
// rejected at the instantiation (exercises the TYP_ARRAY arm of
// recordTypeParamComparison's by-value recursion).

type Box[T any] struct {
	items [2]T
}

func cmp[T any](a Box[T], b Box[T]) bool {
	return a == b
}

func main() {
	var x @[]int = make_slice(int, 0)
	var a Box[@[]int]
	a.items[0] = x
	var b Box[@[]int]
	b.items[0] = x
	println(cmp[@[]int](a, b))
}
