package "main"
import "pkg/builtins/testing"

// expr.compare.typeparam: a generic-TYPE METHOD comparing a type-param field
// (`b.v == o.v`) is rejected at the method DEFINITION — `==` is not defined on a
// type parameter.  Constrain it and compare via a method instead.

type Box[T any] struct {
	v T
}

func (b Box[T]) eq(o Box[T]) bool {
	return b.v == o.v
}

func main() {
	var s *[]int
	var x Box[*[]int] = Box[*[]int]{v: s}
	testing.Println(cast(int, x.eq(x)))
}
