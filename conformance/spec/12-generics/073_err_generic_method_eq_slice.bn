package "main"

// gen.instantiate: a generic-TYPE METHOD that compares a type-param field
// (`b.v == o.v`) is re-checked when CALLED on a concrete receiver.  Calling it
// on a `Box[*[]int]` — whose element has no `==` — is rejected at the call, not
// left to reach IR-gen as an `icmp` on a raw slice (invalid LLVM / a silent
// garbage compare on the VM).  Merely FORMING `Box[*[]int]` is fine (the method
// is monomorphized lazily); the rejection is triggered by the call below.

type Box[T any] struct {
	v T
}

func (b Box[T]) eq(o Box[T]) bool {
	return b.v == o.v
}

func main() {
	var s *[]int
	var x Box[*[]int] = Box[*[]int]{v: s}
	println(cast(int, x.eq(x)))
}
