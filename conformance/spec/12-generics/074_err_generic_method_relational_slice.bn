package "main"

// gen.instantiate: a generic-TYPE METHOD's relational `<` on a type-param field
// requires the concrete type-argument to be numeric (ordering is undefined for
// pointers and aggregates).  Calling `lt` on a `Box[*[]int]` is rejected at the
// call site, not left to reach IR-gen.

type Box[T any] struct {
	v T
}

func (b Box[T]) lt(o Box[T]) bool {
	return b.v < o.v
}

func main() {
	var s *[]int
	var x Box[*[]int] = Box[*[]int]{v: s}
	println(cast(int, x.lt(x)))
}
