package "main"

// expr.compare.typeparam: a generic-TYPE METHOD's relational `<` on a type-param
// field (`b.v < o.v`) is rejected at the method DEFINITION — ordering is not defined
// on a type parameter.

type Box[T any] struct {
	v T
}

func (b Box[T]) lt(o Box[T]) bool {
	return b.v < o.v
}

func main() {
	var s *[]int
	var x Box[*[]int] = Box[*[]int]{v: s}
	println(cast(int, x.lt(x)))
}
