package "main"

// gen.instantiate: a generic-TYPE METHOD comparing a type-param field is NOT
// over-rejected when instantiated with a comparable type-argument, and the
// comparison lowers correctly across backends.  Also exercises FORMING a
// `Box[*[]int]` without calling `eq` — the lazy-monomorphization path that must
// stay valid (a program that never compares is fine).

type Box[T any] struct {
	v T
}

func (b Box[T]) eq(o Box[T]) bool {
	return b.v == o.v
}

func main() {
	var a Box[int] = Box[int]{v: 5}
	var b Box[int] = Box[int]{v: 5}
	var c Box[int] = Box[int]{v: 6}
	println(cast(int, a.eq(b)))
	println(cast(int, a.eq(c)))
	var s *[]int
	var unused Box[*[]int] = Box[*[]int]{v: s}
	println(len(unused.v))
}
