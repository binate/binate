package "main"

// gen.instantiate: calling ANY method on a generic-type instantiation
// monomorphizes ALL of its methods, so a bad type-param comparison in an
// UNcalled sibling is still rejected.  Here `size` is called (it does not
// compare), but `eq` — which compares a `*[]int` field — would be monomorphized
// alongside it, so instantiating `Box[*[]int]` and calling any method is
// rejected, not left to reach IR-gen as an `icmp` on a raw slice.

type Box[T any] struct {
	v T
}

func (b Box[T]) eq(o Box[T]) bool {
	return b.v == o.v
}

func (b Box[T]) size() int {
	return 1
}

func main() {
	var s *[]int
	var x Box[*[]int] = Box[*[]int]{v: s}
	println(x.size())
}
