package "main"
import "pkg/builtins/testing"

// expr.compare.typeparam: a tagged `switch` matches each case with an implicit
// `==` against the tag, so switching on a value whose type is a type parameter is
// rejected at the DEFINITION — comparison is not defined on a type parameter, and a
// switch is no exception.  (Without this the case match reaches IR-gen as a raw
// compare on a non-comparable value: an invalid `icmp` on LLVM, a silent garbage
// compare on the VM.)  Constrain the parameter and branch on `a.Compare(b)` instead.

func pick[T any](x T, a T, b T) int {
	switch x {
	case a:
		return 1
	case b:
		return 2
	}
	return 0
}

func main() {
	var s *[]int
	testing.Println(pick[*[]int](s, s, s))
}
