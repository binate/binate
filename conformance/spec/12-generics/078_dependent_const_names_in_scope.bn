package "main"

import "pkg/builtins/testing"

// gen.mono / decl.scope.block: a constant in a generic body whose value
// depends on a type parameter names the constants in scope at its
// declaration, in each instantiation: here the package K, not a local K
// whose block has ended.

const K = 10

func size[T any]() int {
	{
		const K = 1
		_ = K
	}
	const S = K * sizeof(T)
	return cast(int, S)
}

func main() {
	testing.Println(size[int8](), size[int32]())
}
