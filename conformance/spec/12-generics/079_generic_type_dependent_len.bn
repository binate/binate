package "main"

import "pkg/builtins/testing"

// gen.mono / builtin.sizeof: each instantiation of a generic type has its own
// layout.  A field or method-signature array whose length depends on the type
// parameter has that instantiation's length — in every instantiation the
// program names, not only the last one — as does an instantiated generic
// interface's method signature.  A length that does not depend on the type
// parameter (`len` of an array, of a string literal), alone or combined with
// one that does, is the same in every instantiation.

type Box[T any] struct {
	a [sizeof(T)]uint8
}

interface Filler[T any] {
	Fill(x [sizeof(T)]uint8) int
}

func (b *Box[T]) Fill(x [sizeof(T)]uint8) int {
	b.a = x
	return len(b.a)
}

impl *Box[T] : Filler[T]

var gArr [3]int32

type Mix[T any] struct {
	a [len(gArr) + sizeof(T)]uint8
	b [len("abcd")]uint8
	c T
}

interface Putter[T any] {
	Put(x [len(gArr)]uint8, t T) int
}

type S struct {
	v int
}

func (s *S) Put(x [3]uint8, t int32) int {
	return len(x) + cast(int, t)
}

impl *S : Putter[int32]

func main() {
	var b4 Box[int32]
	var b8 Box[int64]
	var b1 Box[int8]
	testing.Println(len(b4.a), len(b8.a), len(b1.a))
	testing.Println(cast(int, sizeof(Box[int32])), cast(int, sizeof(Box[int64])), cast(int, sizeof(Box[int8])))
	var f4 *Filler[int32] = &b4
	var f8 *Filler[int64] = &b8
	var x4 [4]uint8
	var x8 [8]uint8
	testing.Println(f4.Fill(x4), f8.Fill(x8))
	var m4 Mix[int32]
	var m8 Mix[int64]
	testing.Println(len(m4.a), len(m8.a), len(m4.b), len(m8.b))
	var s S
	var p *Putter[int32] = &s
	var x3 [3]uint8
	testing.Println(p.Put(x3, 10))
}
