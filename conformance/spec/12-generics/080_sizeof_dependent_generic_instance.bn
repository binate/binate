package "main"

import "pkg/builtins/testing"

// gen.mono / builtin.sizeof: in a generic body, sizeof / alignof of a generic
// type instantiated with the type parameter whose layout depends on it — here
// through a field whose length depends on it, directly or in a nested struct —
// has each instantiation's value, used as a constant or as an array length.

type Box[T any] struct {
	a [sizeof(T)]uint8
}

type Outer[T any] struct {
	b Box[T]
	n int32
}

func sz[T any]() int {
	const S = sizeof(Box[T])
	return cast(int, S)
}

func arrLen[T any]() int {
	var a [sizeof(Box[T])]uint8
	return len(a)
}

func align[T any]() int {
	const A = alignof(Outer[T])
	return cast(int, A)
}

func outerLen[T any]() int {
	const O = sizeof(Outer[T])
	var a [O]uint8
	return len(a)
}

func main() {
	testing.Println(sz[int32](), arrLen[int32](), align[int32](), outerLen[int32]())
	testing.Println(sz[int64](), arrLen[int64](), align[int64](), outerLen[int64]())
}
