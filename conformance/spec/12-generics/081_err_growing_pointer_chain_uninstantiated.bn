package "main"

import "pkg/builtins/testing"

// A generic struct whose fields reach instantiations with ever-growing type
// arguments — here behind a pointer — is rejected at its declaration, although
// the program never instantiates it: none of its instantiations could be named.

type L[T any] struct {
	v    T
	next *L[[1]T]
}

func main() {
	testing.Println(0)
}
