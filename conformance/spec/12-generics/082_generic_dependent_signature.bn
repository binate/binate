package "main"

import "pkg/builtins/testing"

// gen.mono.check: a generic function's (or a generic type's method's)
// signature is checked for each instantiation, a length that depends on a type
// parameter taking that instantiation's value: F[int64] takes an [8]uint8,
// F[int32] a [4]uint8, and Box[int32].Get a [5]uint8.

func F[T any](x [sizeof(T)]uint8) int {
	return len(x)
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get(x [sizeof(T) + 1]uint8) int {
	return len(x)
}

func main() {
	var a8 [8]uint8
	var a4 [4]uint8
	var a5 [5]uint8
	var b Box[int32]
	testing.Println(F[int64](a8), F[int32](a4), b.Get(a5))
}
