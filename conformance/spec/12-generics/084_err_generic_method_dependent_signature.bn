package "main"
import "pkg/builtins/testing"

// gen.mono.check: Box[int32].Get takes a [5]uint8 (sizeof(int32) + 1); an
// [8]uint8 is rejected.

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get(x [sizeof(T) + 1]uint8) int {
	return len(x)
}

func main() {
	var a8 [8]uint8
	var b Box[int32]
	testing.Println(b.Get(a8))
}
