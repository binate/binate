package "main"

import "pkg/builtins/testing"

// gen.mono.check: a generic body is checked for each instantiation; what
// depends on a type parameter is decided with its argument — here an [4]uint8
// assigned to a [sizeof(T)]uint8 is valid for the 4-byte T each instance has.

func g[T any]() int {
	var a [4]uint8
	var b [sizeof(T)]uint8 = a
	return len(b)
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) Size() int {
	var x [sizeof(T)]uint8
	var y [4]uint8 = x
	return len(y)
}

func main() {
	var bx Box[uint32]
	testing.Println(g[int32](), g[uint32](), bx.Size())
}
