package "main"

import "pkg/builtins/testing"

// gen.mono.check: g's body is valid for g[int32] but not for g[int64] or
// g[uint16]; each failing instance is reported, named.

func g[T any]() int {
	var a [4]uint8
	var b [sizeof(T)]uint8 = a
	return len(b)
}

func main() {
	testing.Println(g[int32](), g[int64](), g[uint16]())
}
