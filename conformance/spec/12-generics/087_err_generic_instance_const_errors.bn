package "main"

import "pkg/builtins/testing"

// gen.mono.check: a constant that depends on a type parameter is evaluated for
// each instance — h[int32] divides by zero and overflows uint8; h[int8] does
// neither.

func h[T any]() int {
	const Z = 10 / (sizeof(T) - 4)
	return cast(int, cast(uint8, sizeof(T) * 100)) + cast(int, Z)
}

func main() {
	testing.Println(h[int8](), h[int32](), h[int64]())
}
