package "main"

import "pkg/builtins/testing"

// gen.mono.instances: depth[int] names depth[@int], which names depth[@@int], …
// — infinitely many instantiations, rejected (not a compiler crash).

func depth[T any](n int) int {
	if n == 0 {
		return 0
	}
	return 1 + depth[@T](n - 1)
}

func main() {
	testing.Println(depth[int](3))
}
