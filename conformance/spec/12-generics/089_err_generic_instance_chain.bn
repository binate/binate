package "main"

import "pkg/builtins/testing"

// gen.mono.check: an instance named in another instance's body is checked too
// (inner[int32] via outer[int32]), and so are the methods of a named struct
// instance (Box[int16].Bad).

func inner[T any]() int {
	var a [2]uint8
	var b [sizeof(T)]uint8 = a
	return len(b)
}

func outer[T any]() int {
	return inner[T]()
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) Bad() int {
	var x [sizeof(T)]uint8
	var y [1]uint8 = x
	return len(y)
}

func main() {
	var bx Box[int16]
	testing.Println(outer[int32](), outer[int64](), bx.Bad())
}
