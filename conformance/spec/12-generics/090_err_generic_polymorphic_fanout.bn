package "main"

import "pkg/builtins/testing"

// gen.mono.instances: f[int] names both f[@int] and f[*int], and each of those
// names two more — infinitely many instantiations, fanning out.  The chain that
// first grows too deep is rejected, before exponentially many instances are
// checked.

func f[T any](n int) int {
	if n == 0 {
		return 0
	}
	return f[@T](n - 1) + f[*T](n - 1)
}

func main() {
	testing.Println(f[int](0))
}
