package "main"

import "pkg/builtins/testing"

// gen.mono.instances: f[int] names both f[@int] and f[*int], and each of those
// names two more — infinitely many instantiations, fanning out.  The first
// instantiation found past the chain bound is rejected: no shorter chain reaches
// it, and the search for one stops before exponentially many instantiations are
// checked.

func f[T any](n int) int {
	if n == 0 {
		return 0
	}
	return f[@T](n - 1) + f[*T](n - 1)
}

func main() {
	testing.Println(f[int](0))
}
