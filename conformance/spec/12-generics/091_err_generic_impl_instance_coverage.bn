package "main"

import "pkg/builtins/testing"

// gen.mono.check, iface.impl.coverage: a parameterized impl is checked for each
// instance of its receiver type, with the type arguments bound.  Wrap[int16]'s
// Put takes a [8]uint8 (sizeof(int16) + 6) where Sized[int16]'s takes a
// [2]uint8, so Wrap[int16]'s methods do not cover Sized[int16].

interface Sized[T any] {
	Put(x [sizeof(T)]uint8) int
}

type Wrap[K any] struct {
	k K
}

impl *Wrap[K] : Sized[K]

func (w *Wrap[K]) Put(x [sizeof(K) + 6]uint8) int {
	return len(x)
}

func main() {
	var w Wrap[int16]
	var s *Sized[int16] = &w
	var a [2]uint8
	testing.Println(s.Put(a))
}
