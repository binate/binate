package "main"

import "pkg/builtins/testing"

// gen.mono.check, iface.impl.coverage: a parameterized impl whose method's
// dependent array length equals the interface's for each instance covers it —
// Wrap[int16] and Wrap[int64] each implement Sized at their own length, and a
// call through the interface passes the whole array.

interface Sized[T any] {
	Put(x [sizeof(T)]uint8) int
}

type Wrap[K any] struct {
	k K
}

impl *Wrap[K] : Sized[K]

func (w *Wrap[K]) Put(x [sizeof(K)]uint8) int {
	return len(x)*10 + cast(int, x[len(x) - 1])
}

func main() {
	var a Wrap[int16]
	var sa *Sized[int16] = &a
	var x [2]uint8
	x[1] = 3
	testing.Println(sa.Put(x)) // 23
	var b Wrap[int64]
	var sb *Sized[int64] = &b
	var y [8]uint8
	y[7] = 5
	testing.Println(sb.Put(y)) // 85
}
