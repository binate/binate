package "main"

import "pkg/builtins/testing"

// gen.mono.instances: the parameterized impl of W names Marker[W[@K]], so W[int]
// names W[@int] through it, which names W[@@int], and so on — infinitely many
// instantiations through an impl's interface list, rejected like a chain
// through a body.

interface Marker[X any] {
	Id() int
}

type W[K any] struct {
	k K
}

impl *W[K] : Marker[W[@K]]

func (w *W[K]) Id() int {
	return 1
}

func main() {
	var w W[int]
	testing.Println(w.Id())
}
