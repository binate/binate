package "main"

import "pkg/builtins/testing"

// gen.mono.check, iface.impl.coverage: an impl's receiver binders name the
// type's parameters by position, whatever their names — in `impl *Pair[Y, X]`,
// Y is Pair's first parameter.  For Pair[int8, int64], Put takes a
// [sizeof(int8)]uint8 where Sized[int64]'s takes an [8]uint8, so the instance
// does not cover the interface.

interface Sized[T any] {
	Put(x [sizeof(T)]uint8) int
}

type Pair[A any, B any] struct {
	a A
	b B
}

impl *Pair[Y, X] : Sized[X]

func (p *Pair[Y, X]) Put(x [sizeof(Y)]uint8) int {
	return len(x)
}

func main() {
	var p Pair[int8, int64]
	var s *Sized[int64] = &p
	var a [8]uint8
	testing.Println(s.Put(a))
}
