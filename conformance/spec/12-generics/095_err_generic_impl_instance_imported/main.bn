package "main"

import "pkg/builtins/testing"
import "pkg/plib"

// gen.mono.check, iface.impl.coverage: a parameterized impl declared in an
// imported package is checked for the instance this package names —
// plib.Wrap[int16]'s Put takes an [8]uint8 where plib.Sized[int16]'s takes a
// [2]uint8.

func main() {
	var w plib.Wrap[int16]
	var s *plib.Sized[int16] = &w
	var a [2]uint8
	testing.Println(s.Put(a))
}
