package "main"

import "pkg/builtins/testing"

// gen.mono.check: Pair[int64] is first created while mk[int64]'s signature is
// resolved, and Box[int64] while Pair[int64]'s fields are; neither is named
// again, but PGet's call through the field emits Box[int64].Get, so both are
// checked — and Box[int64].Get assigns a [2]uint8 to a [sizeof(int64)]uint8.

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() int {
	var a [2]uint8
	var z [sizeof(T)]uint8 = a
	return len(z)
}

type Pair[T any] struct {
	b *Box[T]
}

func (p *Pair[T]) PGet() int {
	return p.b.Get()
}

func mk[T any]() *Pair[T] {
	return nil
}

func main() {
	testing.Println(mk[int64]().PGet())
}
