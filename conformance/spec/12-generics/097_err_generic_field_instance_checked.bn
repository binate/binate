package "main"

import "pkg/builtins/testing"

// gen.mono.check: bx's Box[int64] is cached before Box's methods are
// declared, and copying Get into it derives Pair[int64] and Pair's field
// Inner[int64], which nothing names again; PGet's call through the field
// emits Inner[int64].Bad, so it is checked — and it assigns a [2]uint8 to a
// [sizeof(int64)]uint8.

var bx Box[int64]

type Inner[T any] struct {
	v T
}

func (i *Inner[T]) Bad() int {
	var a [2]uint8
	var z [sizeof(T)]uint8 = a
	return len(z)
}

type Pair[T any] struct {
	inr *Inner[T]
}

func (p *Pair[T]) PGet() int {
	return p.inr.Bad()
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() *Pair[T] {
	return nil
}

func main() {
	testing.Println(bx.Get().PGet())
}
