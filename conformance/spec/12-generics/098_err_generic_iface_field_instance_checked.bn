package "main"

import "pkg/builtins/testing"

// gen.mono.check: Pair[int64]'s field is a *Mk[int64], whose Make returns an
// *Inner[int64]; PGet's p.m.Make().Bad() emits Inner[int64].Bad without
// naming Inner[int64], so it is checked — and it assigns a [2]uint8 to a
// [sizeof(int64)]uint8.

var bx Box[int64]

type Inner[T any] struct {
	v T
}

func (i *Inner[T]) Bad() int {
	var a [2]uint8
	var z [sizeof(T)]uint8 = a
	return len(z)
}

interface Mk[T any] {
	Make() *Inner[T]
}

type Pair[T any] struct {
	m *Mk[T]
}

func (p *Pair[T]) PGet() int {
	return p.m.Make().Bad()
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() *Pair[T] {
	return nil
}

func main() {
	testing.Println(bx.Get().PGet())
}
