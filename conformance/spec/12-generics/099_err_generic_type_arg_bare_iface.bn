package "main"

// iface.value.spelling, gen.instantiate: a bare interface name is not a type,
// so it is not a type argument either.  `id[Getter]` is rejected at the
// argument, as `var g Getter` is at the declaration; the interface value is
// spelled `*Getter` or `@Getter`.

interface Getter {
	Get() int
}

func id[T any](x T) T {
	return x
}

func main() {
	var g *Getter
	var h *Getter = id[Getter](g)
	_ = h
}
