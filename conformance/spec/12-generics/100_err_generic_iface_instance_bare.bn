package "main"

// iface.value.spelling: a generic interface's instance is an interface, and a
// bare interface is not a type.  `var x G[int]` is rejected as `var g Getter`
// is; the interface value is spelled `*G[int]` or `@G[int]`.

interface G[T any] {
	Get() T
}

func main() {
	var x G[int]
	_ = x
}
