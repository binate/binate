package "main"

import "pkg/builtins/testing"

// iface.construct.value-borrow, gen.mono: a value of a type parameter flowing
// into a raw interface slot is boxed as the instance's type says.  Bound to a
// pointer, the pointer itself is boxed (as `var a *any = &w` boxes `*W`), not
// the address of the variable holding it; bound to a value type, the value is
// borrowed by its address.

type W struct {
	n int
}

func pointerInAny[T any](x T) int {
	var a *any = x
	p, ok := a.(*W)
	if ok {
		return p.n
	}
	return -1
}

func valueInAny[T any](x T) int {
	var a *any = x
	v, ok := a.(*int)
	if ok {
		return *v
	}
	return -1
}

func main() {
	var w W
	w.n = 4
	testing.Println(pointerInAny[*W](&w))
	testing.Println(valueInAny[int](9))
}
