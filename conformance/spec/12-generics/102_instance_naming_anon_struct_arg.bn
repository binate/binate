package "main"

import "pkg/builtins/testing"

// gen.mono: an instance whose type argument is an anonymous struct over a named
// struct (`g[struct { n Node; k T }]`, instantiated inside a method of a generic
// type) leaves the anonymous struct of the same shape the program declares
// directly intact: its layout, field offsets and size are the struct's own.

type Node struct {
	a int64
	b int64
}

func g[T any](x T) int { return cast(int, sizeof(T)) }

type Box[T any] struct {
	v T
}

func (b *Box[T]) M() int {
	var s struct {
		n Node
		k T
	}
	return g[struct {
		n Node
		k T
	}](s)
}

func main() {
	var b Box[int64]
	testing.Println(g[int64](1))
	var s struct {
		n Node
		k int64
	}
	s.n.b = 7
	s.k = 9
	testing.Println(s.n.b, s.k, b.M())
}
