package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// gen.mono, mem.param: a call from an instance of a generic function to an
// instance emitted while its body is — itself, or one calling it back — passes
// a by-value struct argument as a copy, as any call does: each frame holds its
// own reference to the struct's managed field, so a callee overwriting the
// field releases only its own reference.

type Box struct {
	V int
}

type P struct {
	b @Box
}

func depth[T any](p P, x T, n int) int {
	if n == 0 {
		return rt.Refcount(bit_cast(*uint8, p.b))
	}
	return depth[T](p, x, n - 1)
}

func overwrite[T any](p P, x T, n int) int {
	if n == 0 {
		p.b = make(Box)
		return 0
	}
	return overwrite[T](p, x, n - 1)
}

func ping[T any](p P, x T, n int) int {
	if n == 0 {
		p.b = make(Box)
		return 0
	}
	return pong[T](p, x, n - 1)
}

func pong[T any](p P, x T, n int) int {
	return ping[T](p, x, n) + 1
}

func main() {
	var p P
	p.b = make(Box)
	p.b.V = 42
	var keep @Box = p.b
	// main's p and keep, then one copy per frame: four frames.
	testing.Println(depth[int](p, 0, 3))
	testing.Println(overwrite[int](p, 0, 2))
	testing.Println(rt.Refcount(bit_cast(*uint8, keep)), keep.V)
	testing.Println(ping[int](p, 0, 3))
	testing.Println(rt.Refcount(bit_cast(*uint8, keep)), keep.V)
}
