package "main"

import "pkg/builtins/testing"

// gen.mono, func.variadic: a call from an instance of a variadic generic
// function to itself binds its trailing arguments as the variadic pack, as any
// call to the instance does.

func cnt[T any](n int, xs ...int) int {
	if n == 0 {
		return len(xs) * 100 + xs[len(xs) - 1]
	}
	return cnt[T](n - 1, xs[0], 5, 6)
}

func main() {
	testing.Println(cnt[int](2, 1))
	testing.Println(cnt[bool](0, 7, 8))
}
