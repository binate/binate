package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// gen.mono, stmt.defer, mem.param: an instance of a generic function may defer
// a call to itself; the deferred call takes its by-value struct argument as a
// copy, as a direct call does, so a callee overwriting the struct's managed
// field — or the deferring frame overwriting its own parameter afterwards —
// releases only its own reference.

type Box struct {
	V int
}

type P struct {
	b @Box
}

func df[T any](p P, x T, n int) int {
	if n == 0 {
		p.b = make(Box)
		return 0
	}
	defer df[T](p, x, n - 1)
	return n
}

func df2[T any](p P, x T, n int) int {
	if n == 0 {
		p.b = make(Box)
		return 0
	}
	defer df2[T](p, x, n - 1)
	p.b = make(Box)
	return n
}

func main() {
	var p P
	p.b = make(Box)
	p.b.V = 42
	var keep @Box = p.b
	testing.Println(df[int](p, 0, 3))
	testing.Println(rt.Refcount(bit_cast(*uint8, keep)), keep.V)
	testing.Println(df2[int](p, 0, 3))
	testing.Println(rt.Refcount(bit_cast(*uint8, keep)), keep.V)
}
