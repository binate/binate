package "main"

import "pkg/builtins/testing"

// gen.mono: a value named like a generic function — a local variable that
// shadows it — is indexed and called as a value, not instantiated: in a call, a
// deferred call, and a method value taken on a call's result.

type Box struct {
	v int
}

func (b Box) Get() int {
	return b.v
}

func f[T any](x T) T {
	return x
}

func mk[T any](x T) Box {
	var b Box
	return b
}

func dbl(x int) int {
	return x * 2
}

func show(x int) {
	testing.Println(x)
}

func boxed(x int) Box {
	var b Box
	b.v = x
	return b
}

func useCall() int {
	var f @[]*func(int) int = make_slice(*func(int) int, 1)
	f[0] = dbl
	return f[0](5)
}

func useDefer() {
	var f @[]*func(int) = make_slice(*func(int), 1)
	f[0] = show
	defer f[0](7)
	testing.Println("deferred")
}

func useMethodValue() int {
	var mk @[]*func(int) Box = make_slice(*func(int) Box, 1)
	mk[0] = boxed
	return (mk[0](9).Get)()
}

func main() {
	testing.Println(f[int](1))
	testing.Println(useCall())
	useDefer()
	testing.Println(useMethodValue())
	testing.Println(mk[int](0).v)
}
