package "main"

import "pkg/builtins/testing"

// gen.mono.constraint-call: a call `t.f(...)` through a type parameter's
// constraint is, in each instance, a call of the type argument's method f —
// also when the type argument's struct has a field named f, which a selector on
// the concrete type would read instead (expr.member).  Directly, deferred, and
// from a method of a generic type; an interface call is the control.

interface Fer {
	f(n int)
}

// S's field f is not a function.
type S struct {
	f int
	k int
}

func (s @S) f(n int) { testing.Println("S.f", n, s.k) }

impl @S : Fer

// F's field f is a function value with another signature.
type F struct {
	f @func(int, int)
}

func (s @F) f(n int) { testing.Println("F.f", n) }

impl @F : Fer

func G[T Fer](t T, n int) { t.f(n) }

func GD[T Fer](t T, n int) {
	defer t.f(n)
	testing.Println("GD body")
}

type Box[T Fer] struct {
	v T
}

func (b @Box[T]) call(n int) { b.v.f(n) }

func both(a int, b int) { testing.Println("field", a + b) }

func main() {
	var s @S = make(S)
	s.k = 42
	var fv @F = make(F)
	fv.f = both
	G[@S](s, 1)
	G[@F](fv, 2)
	GD[@F](fv, 3)
	var bx @Box[@F] = make(Box[@F])
	bx.v = fv
	bx.call(4)
	var fe @Fer = fv
	fe.f(5)
	fv.f(6, 7)
}
