package "main"
import "pkg/builtins/testing"

import "pkg/geo"

// gen.satisfy, pkg.export: geo's impl of Shape for Rect is in geo's .bn only,
// so it is private to geo and not visible at main's instantiation site: *Rect
// does not satisfy Twice's constraint here.
func main() {
	var r geo.Rect
	r.W = 2
	r.H = 5
	testing.Println(geo.Twice[*geo.Rect](&r))
}
