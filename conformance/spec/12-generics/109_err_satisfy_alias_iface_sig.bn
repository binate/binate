package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): a generic ALIAS's own constraint is checked at every
// instantiation, including one written in an interface method signature.  O
// constrains T to Orderable although its target Box does not, so `O[W]` (W has
// no `impl W : Orderable`) must be rejected here as it is in a function body.
type Box[T any] struct { v T }

type O[T lang.Orderable] = Box[T]

type W struct { f int }

interface I {
	m(o O[W])
}

func main() {}
