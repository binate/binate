package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): a generic alias's own constraint is checked where it is
// instantiated in an interface's parent list.  O constrains T to Orderable
// although its target Box does not, so `G[O[W]]` (W has no
// `impl W : Orderable`) must be rejected.
type Box[T any] struct { v T }

type O[T lang.Orderable] = Box[T]

type W struct { f int }

interface G[T any] {
	get() T
}

interface J : G[O[W]] {
}

func main() {}
