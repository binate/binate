package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): a generic alias's own constraint is checked where it is
// instantiated in an impl's interface list.  O constrains T to Orderable
// although its target Box does not, so `impl *X : G[O[W]]` (W has no
// `impl W : Orderable`) must be rejected, though X's method is written with the
// identical, unconstrained Box[W].
type Box[T any] struct { v T }

type O[T lang.Orderable] = Box[T]

type W struct { f int }

interface G[T any] {
	get() T
}

type X struct { f int }

func (x *X) get() Box[W] {
	var b Box[W]
	return b
}

impl *X : G[O[W]]

func main() {}
