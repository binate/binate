package "main"

import "pkg/q"

// gen.satisfy (§12.4): a generic alias's own constraint is checked in a
// package's .bni too.  pkg/q's interface I names O[W] in a method signature,
// and O constrains T to Orderable although its target Box does not; W has no
// `impl W : Orderable`, so pkg/q is rejected.
var x *q.I

func main() { _ = x }
