package "main"

// gen.method.generic-recv (§12.1): a method's receiver binds the generic type's
// parameters with fresh names.  A bracket entry that names a type — here the
// predeclared `int` — would make it a method on the specific instantiation
// Box[int], which gen.no-conditional-impls (§12.4) rejects.
type Box[T any] struct { v T }

func (b *Box[int]) get() int { return 0 }

func main() {}
