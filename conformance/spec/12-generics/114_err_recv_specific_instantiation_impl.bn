package "main"

// gen.no-conditional-impls (§12.4): an impl whose receiver names concrete type
// arguments (`impl *Box[int] : Getter`) is a specific-instantiation impl, which
// is rejected; an impl on a generic type uses the parameterized form
// (`impl *Box[T] : Getter`, gen.impl.generic-recv).
interface Getter {
	get() int
}

type Box[T any] struct { v T }

func (b *Box[T]) get() int { return 1 }

impl *Box[int] : Getter

func main() {}
