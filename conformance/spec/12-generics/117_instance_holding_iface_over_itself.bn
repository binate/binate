package "main"

import "pkg/builtins/testing"

// gen.instantiate.type, type.opaque.by-value: a generic struct may hold an
// interface over itself.  N[T]'s field instantiates Get[N[T]] while N[T] is
// being built; Get's `get() N[T]` returns an N[T] by value, which is fine once
// N[T] is complete.

interface Get[T any] {
	get() T
}

type N[T any] struct {
	v    T
	next *Get[N[T]]
}

func main() {
	var n N[int]
	n.v = 7
	var g *Get[N[bool]]
	_ = g
	testing.Println(n.v)
}
