package "main"

import "pkg/builtins/testing"

// gen.instantiate.type, gen.typeparams: an instance is its generic with its
// type arguments, and each declaration's type parameters are its own: N[T]
// written in S[T any] or G[T any] is not N's own N[T], though the names agree,
// so `x.get().v` is G's T.

interface Get[T any] {
	get() T
}

type N[T any] struct {
	v    T
	next *Get[N[T]]
}

type S[T any] struct {
	g *Get[N[T]]
}

type Src struct {
	n N[int]
}

impl Src : Get[N[int]]

func (s Src) get() N[int] { return s.n }

func G[T any](x *Get[N[T]]) T { return x.get().v }

func H[T any](s *S[T]) T { return s.g.get().v }

func main() {
	var src Src
	src.n.v = 7
	testing.Println(G[int](&src))
	var s S[int]
	s.g = &src
	testing.Println(H[int](&s) + 1)
}
