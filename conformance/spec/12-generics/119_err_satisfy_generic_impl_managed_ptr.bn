package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// gen.satisfy (§12.4): a type argument satisfies its constraint through an impl
// that matches it.  The parameterized `impl W[K] : lang.Orderable` makes each
// W[A] satisfy lang.Orderable, but not `@W[A]`, just as the plain
// `impl P : lang.Orderable` does not make `@P` satisfy it, so `g[@W[int]]` is
// rejected.

type W[K any] struct {
	n int
}

func (w W[K]) Compare(o W[K]) int { return w.n - o.n }

impl W[K] : lang.Orderable

func g[U lang.Orderable](u U) int { return 7 }

func main() {
	var w @W[int] = make(W[int])
	testing.Println(g[@W[int]](w))
}
