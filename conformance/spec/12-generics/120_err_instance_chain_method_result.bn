package "main"

import "pkg/builtins/testing"

// gen.mono.instances: an instance of a generic struct names the instances in the
// signature and body of every method declared on it, whether or not the program
// calls it.  Box[int]'s Wrap names Box[Opt[int]], whose Wrap names
// Box[Opt[Opt[int]]], and so on: the set of instantiations the program names is
// infinite, a compile-time error.

type Opt[T any] struct {
	v T
}

type Box[T any] struct {
	x T
}

func (b *Box[V]) Wrap() Box[Opt[V]] {
	var r Box[Opt[V]]
	r.x.v = b.x
	return r
}

func main() {
	var b Box[int]
	b.x = 1
	testing.Println(b.x)
}
