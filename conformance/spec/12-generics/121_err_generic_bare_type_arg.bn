package "main"

import "pkg/builtins/testing"

// gen.instantiate: a generic type is named by its name and its type arguments;
// its bare name is no type, also as a type argument, which is written as an
// expression.

type Box[T any] struct {
	v T
}

func one[T any]() int {
	return 1
}

func main() {
	testing.Println(one[Box]())
}
