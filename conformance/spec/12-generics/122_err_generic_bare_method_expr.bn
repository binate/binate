package "main"

import "pkg/builtins/testing"

// gen.instantiate, func.method-expr: a method expression's T is a named type,
// and a generic type's bare name names none; its methods are an instance's
// (`Box[int].Get`).

type Box[T any] struct {
	v T
}

func (b *Box[T]) Get() T {
	return b.v
}

func main() {
	var g = Box.Get
	_ = g
	testing.Println(0)
}
