package "main"

import "pkg/builtins/testing"

// gen.mono.instances: Box's Raw names Box[[sizeof(T)]uint8], whose Raw names
// itself — the type argument's length reaches a fixed point, so the set of
// instantiations the program names is finite.

type Box[T any] struct {
	x    T
	next *Box[[sizeof(T)]uint8]
}

func (b *Box[T]) Raw() *Box[[sizeof(T)]uint8] {
	return b.next
}

func main() {
	var b Box[int]
	b.x = 3
	var r *Box[[sizeof(int)]uint8] = b.Raw()
	if r == nil {
		testing.Println(b.x)
	}
}
