package "main"

import "pkg/builtins/testing"

// gen.mono.instances: N's fields name instances whose type arguments grow through
// array-length arithmetic, two ways, which no check of the declaration decides;
// building N[int] goes past the implementation's limit on the instances one
// instantiation builds (§21.4), a compile-time error, not a hang.

type N[T any] struct {
	x T
	a *N[[sizeof(T) + 1]uint8]
	b *N[[sizeof(T) + 1]uint16]
}

func main() {
	var n N[int]
	_ = n
	testing.Println(0)
}
