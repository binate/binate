package "main"

import "pkg/builtins/testing"

// gen.mono.instances: Box's methods name instances with ever-growing type
// arguments, two ways (Wrap, Pair), but the program names no instance of Box,
// so the set of instantiations it names is finite: the program is valid, and
// Box's own methods are checked with their type parameters abstract — Twice
// calls Wrap on an abstract instance of the family.

type Opt[T any] struct {
	v T
}

type Res[T any] struct {
	r T
}

type Box[T any] struct {
	x T
}

func (b *Box[V]) Wrap() Box[Opt[V]] {
	var r Box[Opt[V]]
	r.x.v = b.x
	return r
}

func (b *Box[V]) Pair() Box[Res[V]] {
	var r Box[Res[V]]
	r.x.r = b.x
	return r
}

func (b *Box[V]) Twice() Box[Opt[Opt[V]]] {
	var r Box[Opt[V]] = b.Wrap()
	return r.Wrap()
}

func main() {
	var o Opt[int]
	o.v = 7
	testing.Println(o.v)
}
