package "main"

import "pkg/builtins/testing"

// gen.mono.instances: naming an instance of a generic whose methods name
// instances with ever-growing type arguments (Box, two ways; the interface I)
// names infinitely many instantiations, an error where it is named; a generic
// struct whose fields alone do (T2) is rejected at its declaration.

type Opt[T any] struct {
	v T
}

type Res[T any] struct {
	r T
}

type Box[T any] struct {
	x T
}

func (b *Box[V]) Wrap() Box[Opt[V]] {
	var r Box[Opt[V]]
	r.x.v = b.x
	return r
}

func (b *Box[V]) Pair() Box[Res[V]] {
	var r Box[Res[V]]
	r.x.r = b.x
	return r
}

interface I[T any] {
	a() @I[Opt[T]]
	b() @I[Res[T]]
}

type T2[X any] struct {
	a *T2[Opt[X]]
	b *T2[Res[X]]
}

func main() {
	var b Box[int]
	var i @I[bool]
	_ = b
	_ = i
	testing.Println(0)
}
