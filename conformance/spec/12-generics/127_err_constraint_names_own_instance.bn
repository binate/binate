package "main"

import "pkg/builtins/testing"

// gen.satisfy: Box's parameter U is constrained by an interface over an instance
// of Box itself, which the instance must satisfy — and int does not implement
// C[Box[int, int]].

interface C[T any] {
	M() T
}

type Box[T any, U C[Box[int, int]]] struct {
	x T
}

func main() {
	testing.Println(0)
}
