package "main"

// gen.instantiate.alias: an alias's instance is its target as if written at the
// use, so the instances the target names are attributed to the use: an error in
// one's method is reported as instantiated at the use (the outermost one, through
// an alias naming another), and an instance in an infinite family is reported there.

type Box[T any] struct { v T }

func (b *Box[T]) S() int {
	var a [sizeof(T) - 2]uint8
	return len(a)
}

type A[T any] = Box[T]

type A2[T any] = *A[T]

type L[T any] struct { v T }

func (l *L[T]) Wrap() L[[1]T] {
	var r L[[1]T]
	return r
}

type AL[T any] = L[T]

func main() {
	var b A2[int8]
	var l AL[int]
	_ = b
	_ = l
}
