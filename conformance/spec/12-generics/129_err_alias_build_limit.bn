package "main"

// gen.mono.instances: an instance built through a generic alias counts against
// the limit on the instances one instantiation builds (§21.4) as if written at
// the use: building AN[int] — N[int] — goes past it, and is reported there, not
// against an instantiation built before it.

type N[T any] struct {
	x T
	a *N[[sizeof(T) + 1]uint8]
	b *N[[sizeof(T) + 1]uint16]
}

type Other[T any] struct { v T }

type AN[T any] = N[T]

func main() {
	var o Other[int]
	var n AN[int]
	_ = o
	_ = n
}
