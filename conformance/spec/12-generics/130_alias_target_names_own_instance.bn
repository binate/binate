package "main"

import "pkg/builtins/testing"

// gen.instantiate.alias: an alias that reaches itself through a defined generic
// type is no recursive alias.  L[int]'s target names N[int], and N's declaration
// names L[int] again — through N, a defined type.  gl names L[int] before
// anything names N, so N is first instantiated while L[int]'s target is resolved.

interface Get[T any] { get() T }

type L[T any] = *Get[N[T]]

type N[T any] struct {
	v T
	l L[int]
}

var gl L[int]

func main() {
	var n N[bool]
	n.v = true
	var m N[int]
	m.v = 4
	_ = gl
	if n.v {
		testing.Println(m.v)
	}
}
