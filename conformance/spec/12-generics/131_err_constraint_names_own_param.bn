package "main"

// gen.constraint.self: a type parameter's constraint may not name that type
// parameter — in a generic function, type or interface — even where the package
// declares a type of that name (gen.typeparams.scope).  An interface whose
// methods take the type satisfying it writes `Self` instead.

interface Eq[T any] { Same(o T) bool }

type T struct { v int }

func f[T Eq[T]](x T) T { return x }

type Box[T Eq[T]] struct { v T }

interface G[T Eq[T]] { get() T }

func main() {
}
