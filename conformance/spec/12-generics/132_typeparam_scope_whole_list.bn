package "main"

import "pkg/builtins/testing"

// gen.typeparams.scope: a type parameter is in scope in every constraint of its
// list, a later parameter's too, and shadows a package type of its name.  W's
// `Eq[U]` is Eq of W's U — at W's declaration, in its method's receiver binders
// and at an instantiation alike — not the package's U.

interface Eq[X any] { Same(o X) bool }

type U struct { v int }

type P struct { v int }

func (p P) Same(o int) bool { return p.v == o }

impl P : Eq[int]

type W[T Eq[U], U any] struct {
	t T
	u U
}

func (w *W[A, B]) Check(o B) bool { return w.t.Same(o) }

func both[T Eq[U], U any](x T, y U) bool { return x.Same(y) }

func main() {
	var w W[P, int]
	w.t.v = 3
	var p P
	p.v = 4
	testing.Println(w.Check(3))
	testing.Println(both[P, int](p, 5))
}
