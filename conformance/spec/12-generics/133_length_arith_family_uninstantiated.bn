package "main"

import "pkg/builtins/testing"

// gen.mono.instances: a generic whose fields, methods or interface methods name
// instances whose type arguments grow only through array-length arithmetic
// (`[sizeof(T) + 1]uint8`) names no instance when the program never instantiates
// it: its declaration and its methods, checked with their type parameters
// abstract, are valid.

type N[T any] struct {
	x T
	a *N[[sizeof(T) + 1]uint8]
	b *N[[sizeof(T) + 1]uint16]
}

type M[T any] struct { v T }

func (m *M[T]) A() *M[[sizeof(T) + 1]uint8] { return nil }

func (m *M[T]) B() *M[[sizeof(T) + 2]uint16] { return nil }

func (m M[T]) C(x M[[alignof(T) + sizeof(T)]int32]) int { return 0 }

func (m *M[T]) Twice() *M[[sizeof([sizeof(T) + 1]uint8) + 1]uint8] { return m.A().A() }

interface I[T any] {
	A() *I[[sizeof(T) + 1]uint8]
	B() *I[[sizeof(T) + 2]uint16]
}

func use[T any](m *M[T]) int {
	var a *M[[sizeof(T) + 1]uint8] = m.A()
	_ = a.B()
	return 0
}

func main() {
	testing.Println(1)
}
