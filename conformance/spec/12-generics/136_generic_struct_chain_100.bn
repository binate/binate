type S99[T any] struct { v T; next *S100[T] }

type S100[T any] struct { v T }

func main() {
	var a S1[int]
	a.v = 7
	var b S2[int]
	b.v = 5
	a.next = &b
	testing.Println(a.v + a.next.v)
}
