package "main"

import "pkg/builtins/testing"

// gen.mono.instances: S1[T] … S100[T] each hold a pointer to the next.  S1[int]
// names S2[int] … S100[int], a chain of 100, within the bound, and 99
// instances, within the limit on what one instantiation names.  Each generic's
// own declaration, with its type parameter abstract, names the rest of the
// chain over that parameter; those instances are named by that declaration,
// not by S1[int], so they do not count against S1[int]'s limit.

type S1[T any] struct { v T; next *S2[T] }

type S2[T any] struct { v T; next *S3[T] }

type S3[T any] struct { v T; next *S4[T] }

type S4[T any] struct { v T; next *S5[T] }

