type S200[T any] struct { v T }

func (s *S1[T]) Third() T { return s.next.next.v }

func main() {
	var a S199[int]
	a.v = 7
	var b S200[int]
	b.v = 5
	a.next = &b
	testing.Println(a.v + a.next.v)
}
