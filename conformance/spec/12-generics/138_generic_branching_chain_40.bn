package "main"

import "pkg/builtins/testing"

// gen.mono.instances: A1[T] … A40[T] each hold two pointers to the next, over
// *T and over @T, so the instances A1's declaration names are exponentially
// many in the depth.  Their arguments are type parameters and pointers to
// them, which no bound on what a program names covers.  The program names
// A39[int], A40[*int] and A40[@int].

type A1[T any] struct { v T; a *A2[*T]; b *A2[@T] }

type A2[T any] struct { v T; a *A3[*T]; b *A3[@T] }

type A3[T any] struct { v T; a *A4[*T]; b *A4[@T] }

type A4[T any] struct { v T; a *A5[*T]; b *A5[@T] }

type A5[T any] struct { v T; a *A6[*T]; b *A6[@T] }

type A6[T any] struct { v T; a *A7[*T]; b *A7[@T] }

type A7[T any] struct { v T; a *A8[*T]; b *A8[@T] }

type A8[T any] struct { v T; a *A9[*T]; b *A9[@T] }

type A9[T any] struct { v T; a *A10[*T]; b *A10[@T] }

type A10[T any] struct { v T; a *A11[*T]; b *A11[@T] }

type A11[T any] struct { v T; a *A12[*T]; b *A12[@T] }

type A12[T any] struct { v T; a *A13[*T]; b *A13[@T] }

type A13[T any] struct { v T; a *A14[*T]; b *A14[@T] }

type A14[T any] struct { v T; a *A15[*T]; b *A15[@T] }

type A15[T any] struct { v T; a *A16[*T]; b *A16[@T] }

type A16[T any] struct { v T; a *A17[*T]; b *A17[@T] }

type A17[T any] struct { v T; a *A18[*T]; b *A18[@T] }

type A18[T any] struct { v T; a *A19[*T]; b *A19[@T] }

type A19[T any] struct { v T; a *A20[*T]; b *A20[@T] }

type A20[T any] struct { v T; a *A21[*T]; b *A21[@T] }

type A21[T any] struct { v T; a *A22[*T]; b *A22[@T] }

type A22[T any] struct { v T; a *A23[*T]; b *A23[@T] }

type A23[T any] struct { v T; a *A24[*T]; b *A24[@T] }

type A24[T any] struct { v T; a *A25[*T]; b *A25[@T] }

type A25[T any] struct { v T; a *A26[*T]; b *A26[@T] }

type A26[T any] struct { v T; a *A27[*T]; b *A27[@T] }

type A27[T any] struct { v T; a *A28[*T]; b *A28[@T] }

type A28[T any] struct { v T; a *A29[*T]; b *A29[@T] }

type A29[T any] struct { v T; a *A30[*T]; b *A30[@T] }

type A30[T any] struct { v T; a *A31[*T]; b *A31[@T] }

type A31[T any] struct { v T; a *A32[*T]; b *A32[@T] }

type A32[T any] struct { v T; a *A33[*T]; b *A33[@T] }

type A33[T any] struct { v T; a *A34[*T]; b *A34[@T] }

type A34[T any] struct { v T; a *A35[*T]; b *A35[@T] }

type A35[T any] struct { v T; a *A36[*T]; b *A36[@T] }

type A36[T any] struct { v T; a *A37[*T]; b *A37[@T] }

type A37[T any] struct { v T; a *A38[*T]; b *A38[@T] }

type A38[T any] struct { v T; a *A39[*T]; b *A39[@T] }

type A39[T any] struct { v T; a *A40[*T]; b *A40[@T] }

type A40[T any] struct { v T }

func main() {
	var x A39[int]
	x.v = 7
	var y A40[*int]
	y.v = &x.v
	x.a = &y
	testing.Println(*x.a.v + 5)
}
