package "main"

import "pkg/builtins/testing"
import "pkg/oplib"

// gen.mono.instances, type.opaque.pointer-to-embedding: A1[T, U] … A30[T, U]
// each hold two pointers to the next, over *T and over @T, and g writes
// A1[oplib.Box, U], whose argument oplib.Box is opaque here.  Every part of
// the structure that comes from it holds it behind a pointer, which is no
// embedding, so g is well formed; the opaque rules decide it without walking
// the instances A1's structure names, which are exponentially many.  Nothing
// instantiates g: A1[oplib.Box, int] would name 2^29 instances.

type A1[T any, U any] struct { u U; a *A2[*T, U]; b *A2[@T, U] }

type A2[T any, U any] struct { u U; a *A3[*T, U]; b *A3[@T, U] }

type A3[T any, U any] struct { u U; a *A4[*T, U]; b *A4[@T, U] }

type A4[T any, U any] struct { u U; a *A5[*T, U]; b *A5[@T, U] }

type A5[T any, U any] struct { u U; a *A6[*T, U]; b *A6[@T, U] }

type A6[T any, U any] struct { u U; a *A7[*T, U]; b *A7[@T, U] }

type A7[T any, U any] struct { u U; a *A8[*T, U]; b *A8[@T, U] }

type A8[T any, U any] struct { u U; a *A9[*T, U]; b *A9[@T, U] }

type A9[T any, U any] struct { u U; a *A10[*T, U]; b *A10[@T, U] }

type A10[T any, U any] struct { u U; a *A11[*T, U]; b *A11[@T, U] }

type A11[T any, U any] struct { u U; a *A12[*T, U]; b *A12[@T, U] }

type A12[T any, U any] struct { u U; a *A13[*T, U]; b *A13[@T, U] }

type A13[T any, U any] struct { u U; a *A14[*T, U]; b *A14[@T, U] }

type A14[T any, U any] struct { u U; a *A15[*T, U]; b *A15[@T, U] }

type A15[T any, U any] struct { u U; a *A16[*T, U]; b *A16[@T, U] }

type A16[T any, U any] struct { u U; a *A17[*T, U]; b *A17[@T, U] }

type A17[T any, U any] struct { u U; a *A18[*T, U]; b *A18[@T, U] }

type A18[T any, U any] struct { u U; a *A19[*T, U]; b *A19[@T, U] }

type A19[T any, U any] struct { u U; a *A20[*T, U]; b *A20[@T, U] }

type A20[T any, U any] struct { u U; a *A21[*T, U]; b *A21[@T, U] }

type A21[T any, U any] struct { u U; a *A22[*T, U]; b *A22[@T, U] }

type A22[T any, U any] struct { u U; a *A23[*T, U]; b *A23[@T, U] }

type A23[T any, U any] struct { u U; a *A24[*T, U]; b *A24[@T, U] }

type A24[T any, U any] struct { u U; a *A25[*T, U]; b *A25[@T, U] }

type A25[T any, U any] struct { u U; a *A26[*T, U]; b *A26[@T, U] }

type A26[T any, U any] struct { u U; a *A27[*T, U]; b *A27[@T, U] }

type A27[T any, U any] struct { u U; a *A28[*T, U]; b *A28[@T, U] }

type A28[T any, U any] struct { u U; a *A29[*T, U]; b *A29[@T, U] }

type A29[T any, U any] struct { u U; a *A30[*T, U]; b *A30[@T, U] }

type A30[T any, U any] struct { u U }

func g[U any](x *A1[oplib.Box, U]) int { return 0 }

func main() {
	var z A30[oplib.Box, int]
	z.u = 12
	testing.Println(z.u)
}
