package "main"

import "pkg/builtins/testing"
import "pkg/glib"

// gen.instantiate: a generic function names a value only as an instance, its
// type arguments written (`idLocal[int]`).  Its bare name read as a value is
// rejected — into a variable whose type is inferred, at package level or
// local, or declared, into the blank identifier, and qualified, for a generic
// function of another package.

func idPkg[T any](x T) T {
	return x
}

func idLocal[T any](x T) T {
	return x
}

func idTyped[T any](x T) T {
	return x
}

func idBlank[T any](x T) T {
	return x
}

var pkgLevel = idPkg

func main() {
	var local = idLocal
	var typed @func(int) int = idTyped
	_ = idBlank
	var other = glib.Id
	testing.Println(idLocal[int](1))
}
