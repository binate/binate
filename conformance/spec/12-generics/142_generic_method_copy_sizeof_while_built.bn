package "main"

import "pkg/builtins/testing"

// gen.mono: an instance's method has its signature with the type arguments
// substituted, also when the instance's methods are copied while a layout the
// signature reads is still built: Q's length reads a field of W[int64], whose
// build names Bx[int64], whose build selects hv.m(), whose signature takes the
// size of W[int64].  So does a struct field's length.

type Bx[T any] struct {
	a [len(hv.m())]uint8
	t T
}

type H[T any] struct {
	z T
}

var hv H[int64]

func (h *H[T]) m() [sizeof(W[T])]uint8 {
	var r [sizeof(W[T])]uint8
	return r
}

type W[T any] struct {
	v T
	p *Bx[T]
}

var Q [len(W[int64]{}.p.a)]uint8

type Z struct {
	q [len(W[int64]{}.p.a)]uint8
}

func main() {
	testing.Println(len(hv.m()) == cast(int, sizeof(W[int64])))
	testing.Println(len(Q) == len(hv.m()))
	var z Z
	testing.Println(len(z.q) == len(Q))
	var b Bx[int64]
	b.a[len(b.a) - 1] = 3
	testing.Println(len(b.a) == len(Q), cast(int, b.a[len(b.a) - 1]))
}
