package "main"

import "pkg/builtins/testing"

// gen.mono: an instance's method has its signature with the type arguments
// substituted, also when it is copied while a layout the signature reads is
// still built and the build selects another method (m2): m, called through an
// interface its impl satisfies and as a method value, has the length.

interface I[T any] {
	m() [sizeof(W[T])]uint8
}

type Bx[T any] struct {
	a [len(hv.m2())]uint8
	t T
}

type H[T any] struct {
	z T
}

var hv H[int64]

func (h *H[T]) m2() [3]uint8 {
	var r [3]uint8
	return r
}

func (h *H[T]) m() [sizeof(W[T])]uint8 {
	var r [sizeof(W[T])]uint8
	r[0] = 7
	return r
}

impl *H[T] : I[T]

type W[T any] struct {
	v T
	p *Bx[T]
}

var Q [len(W[int64]{}.p.a)]uint8

func main() {
	var i *I[int64] = &hv
	var r [sizeof(W[int64])]uint8 = i.m()
	var f *func() [sizeof(W[int64])]uint8 = hv.m
	testing.Println(cast(int, r[0]), len(Q), cast(int, f()[0]), len(r) == len(hv.m()))
}
