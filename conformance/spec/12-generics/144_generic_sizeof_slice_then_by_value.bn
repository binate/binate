package "main"

import "pkg/builtins/testing"

// Collecting N builds Box[M] and Box[M2], whose lengths are M's and M2's sizes.
// M reaches N through a slice before it holds N by value, M2 after: either way
// the length is read once N is collected, the whole size, not one taken with
// N incomplete.
type Box[T any] struct {
	a [sizeof(T)]uint8
}

type N struct {
	v  int64
	p  *Box[M]
	p2 *Box[M2]
}

type M struct {
	s *[]N
	n N
}

type M2 struct {
	n N
	s *[]N
}

func main() {
	var b Box[M]
	var b2 Box[M2]
	testing.Println(len(b.a) == cast(int, sizeof(M)), len(b2.a) == cast(int, sizeof(M2)))
}
