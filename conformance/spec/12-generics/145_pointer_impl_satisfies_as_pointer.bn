package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// gen.satisfy (§12.4): an impl's receiver is the type argument it lets satisfy
// the constraint, with no receiver smoothing -- `impl *W[K]` makes `*W[int]`
// satisfy lang.Comparable (gen.impl.generic-recv), and `impl *P` makes `*P`.

type W[K any] struct {
	k int
}

impl *W[K] : lang.Comparable

func (w *W[K]) Compare(o *W[K]) int { return w.k - o.k }

type P struct {
	v int
}

impl *P : lang.Comparable

func (s *P) Compare(o *P) int { return s.v - o.v }

func cmp3[U lang.Comparable](u U, v U) int { return u.Compare(v) }

func main() {
	var a W[int]
	var b W[int]
	a.k = 5
	b.k = 2
	testing.Println(cmp3[*W[int]](&a, &b))
	var p P
	var q P
	p.v = 1
	q.v = 4
	testing.Println(cmp3[*P](&p, &q))
}
