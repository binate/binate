package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): `impl *W[K] : lang.Comparable` makes `*W[int]` satisfy
// the constraint, not `W[int]`: the receiver is matched with no receiver
// smoothing (gen.impl.generic-recv).

type W[K any] struct {
	k int
}

impl *W[K] : lang.Comparable

func (w *W[K]) Compare(o *W[K]) int { return w.k - o.k }

func keep[U lang.Comparable](u U) U { return u }

func main() {
	var a W[int]
	_ = keep[W[int]](a)
}
