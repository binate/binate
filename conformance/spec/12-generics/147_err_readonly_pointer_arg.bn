package "main"

import "pkg/builtins/lang"

// gen.satisfy (§12.4): `readonly` below the outermost level is significant when
// an impl's receiver is matched against a type argument, so `impl *Q :
// lang.Hashable` does not make `*readonly Q` satisfy lang.Hashable (a call of
// its `*Q` methods could not take a `*readonly Q`).

type Q struct {
	v int
}

impl *Q : lang.Hashable

func (q *Q) Hash() uint { return cast(uint, q.v) }

func (q *Q) Compare(o *Q) int { return q.v - o.v }

func keep[T lang.Hashable](t T) T { return t }

func main() {
	var q Q
	var r *readonly Q = &q
	_ = keep[*readonly Q](r)
}
