package "main"

import "pkg/builtins/lang"
import "pkg/builtins/testing"
import "pkg/xb"
import "pkg/xc"
import "pkg/xt"

// gen.satisfy, pkg.export: xb privately declares `impl xt.T : lang.Stringer` and
// xc privately declares `impl *xt.T : lang.Stringer`, so neither is visible
// here.  The note on the miss names the package of the impl whose receiver is
// the type argument `*xt.T` -- xc's -- not xb's, whose `xt.T` receiver would
// serve a `*xt.T` only by receiver smoothing.
func g[U lang.Stringer](u U) @[]char { return u.String() }

func main() {
	var t xt.T
	testing.Println(xb.B() + xc.C())
	testing.Println(g[*xt.T](&t))
}
