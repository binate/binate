package "main"

import "pkg/builtins/testing"

// gen.typeparams.scope: a constraint may name a parameter declared after it in
// the list, and that parameter's own constraint holds there.  T's `Hk[G2[V]]`
// needs V to satisfy G2's constraint, which V's bound `Eq[[8]uint8]` gives: in a
// type (with methods or without), an interface, an alias, a method's receiver
// binders, a parameterized impl and a function alike.

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type G2[A Eq[[8]uint8]] struct {
	a A
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o) + n.v
}

type H struct {
	k int
}

impl *H : Hk[G2[*N]]

impl *H : Hk[[3]uint8]

func (h *H) hk() int {
	return h.k
}

type K4[T Hk[G2[V]], V Eq[[8]uint8]] struct {
	t T
	v V
}

func (k *K4[T, V]) sum() int {
	return k.t.hk() + k.v.eq([8]uint8{})
}

interface K6[T Hk[G2[V]], V Eq[[8]uint8]] {
	pair() int
}

impl *K4[T, V] : K6[T, V]

func (k *K4[T, V]) pair() int {
	return k.sum() * 10
}

type K7[T Hk[G2[V]], V Eq[[8]uint8]] = K4[T, V]

type K9[T Hk[G2[V]], V Eq[[8]uint8]] struct {
	v V
}

func f3[A Eq[[8]uint8]]() [3]uint8 {
	var a [3]uint8
	return a
}

// A generic call in a constraint's length waits for V's bound too.
type K10[T Hk[[len(f3[V]())]uint8], V Eq[[8]uint8]] struct {
	v V
}

func k4f[T Hk[G2[V]], V Eq[[8]uint8]](t T, v V) int {
	return t.hk() + v.eq([8]uint8{})
}

func main() {
	var h H = H{k: 1}
	var n N = N{v: 2}
	var k K7[*H, *N] = K4[*H, *N]{t: &h, v: &n}
	testing.Println(k.sum())
	var p *K6[*H, *N] = &k
	testing.Println(p.pair())
	testing.Println(k4f[*H, *N](&h, &n))
	var k9 K9[*H, *N] = K9[*H, *N]{v: &n}
	testing.Println(k9.v.eq([8]uint8{}))
	var k10 K10[*H, *N] = K10[*H, *N]{v: &n}
	testing.Println(k10.v.eq([8]uint8{}) + 1)
}
