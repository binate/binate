package "main"

import "pkg/builtins/testing"

// gen.typeparams.scope, gen.satisfy: a constraint that names a later parameter
// is judged with that parameter's own constraint, which here does not give what
// G2 needs -- V is bounded by `any`, and G2's parameter by `Eq[[8]uint8]` -- in a
// type, an interface and an alias alike.

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type G2[A Eq[[8]uint8]] struct {
	a A
}

type K8[T Hk[G2[V]], V any] struct {
	t T
}

interface K8i[T Hk[G2[V]], V any] {
	m() int
}

type Box2[T any] struct {
	t T
}

type K8a[T Hk[G2[V]], V any] = Box2[V]

func main() {
	testing.Println(1)
}
