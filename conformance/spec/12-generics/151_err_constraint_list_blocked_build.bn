package "main"

import "pkg/builtins/testing"

// gen.typeparams.scope, gen.satisfy: K's constraint B names V, bounded only by
// `any`, which does not give G2's Eq.  K's list is resolved while X[int8] is
// built, and K's own layout waits on X[int8]'s (A's `sizeof`): the miss is still
// reported -- and so it is for KL, whose constraint names V declared after it.

interface Eq {
	eq() int
}

interface Hk[T any] {
	hk() int
}

interface Sz[T any] {
	sz() int
}

type G2[A Eq] struct {
	a A
}

type N struct {
	v int
}

impl *N : Eq

func (n *N) eq() int {
	return n.v
}

type Y[T any] struct {
	x X[int8]
	t T
}

type X[T any] struct {
	k K[T, *N, T]
	t T
}

type K[A Sz[[sizeof(X[int8])]uint8], V any, B Hk[G2[V]]] struct {
	a A
}

type YL[T any] struct {
	x XL[int8]
	t T
}

type XL[T any] struct {
	k KL[T, T, int8]
	t T
}

type KL[A Sz[[sizeof(XL[int8])]uint8], B Hk[G2[V]], V any] struct {
	a A
}

func main() {
	testing.Println(1)
}
