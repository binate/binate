package "main"

import "pkg/builtins/testing"

// gen.impl.generic-recv, gen.mono.check: an impl on a generic type whose
// interface list holds a length that depends on the type's parameter is, for
// each instance, that impl with the length's value: *Box[int64] is an
// Eq[[8]uint8], *Box[int16] an Eq[[2]uint8] and *Pair[int64] an Eq[[16]uint8].

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type Pair[K any] struct {
	a K
	b K
}

impl *Pair[K] : Eq[[2 * sizeof(K)]uint8]

func (p *Pair[K]) eq(o [2 * sizeof(K)]uint8) int {
	return len(o) + 1
}

func inner[T Eq[[sizeof(U)]uint8], U any](t T) int {
	var z [sizeof(U)]uint8
	return t.eq(z)
}

func g4[U any](b *Box[U]) int {
	return inner[*Box[U], int64](b)
}

func main() {
	var b Box[int64]
	var e *Eq[[8]uint8] = &b
	testing.Println(e.eq([8]uint8{}))
	var p Pair[int64]
	var f *Eq[[16]uint8] = &p
	testing.Println(f.eq([16]uint8{}))
	testing.Println(g4[int64](&b))
	var b2 Box[int16]
	var e2 *Eq[[2]uint8] = &b2
	testing.Println(e2.eq([2]uint8{}))
}
