package "main"

import "pkg/builtins/testing"

// gen.mono.check: an impl's interface list, resolved for an instance of its
// type, is checked for that instance: at Box[int64] the length's element
// `cast(uint8, sizeof(K) * 40)` is 320, which does not fit uint8.

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[len([...]uint8{cast(uint8, sizeof(K) * 40)})]uint8]

func (b *Box[K]) eq(o [1]uint8) int {
	return 1
}

func main() {
	var b Box[int64]
	var e *Eq[[1]uint8] = &b
	testing.Println(e.eq([1]uint8{}))
}
