package "main"

import "pkg/builtins/testing"
import "pkg/q"

// gen.mono.check, type.opaque.by-value: package q builds a *lib.Marker from a
// lib.Box[Op], Op being q's opaque export, and calls Box[Op].M, which takes an Op
// by value.  Matching Box[Op] against its impl names the instances in q's lender
// class, where Op's layout is lent, not in lib's, where it is not.

func main() {
	testing.Println(q.Use())
}
