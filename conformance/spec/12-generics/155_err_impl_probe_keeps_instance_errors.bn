package "main"

import "pkg/builtins/testing"

// gen.mono.check: building *Box[int64] into an *Other matches Box's impl, whose
// list names Wrap[int64]; Wrap[int64]'s length divides by zero, and the error
// is reported though the match builds the instance.

interface Marker[T any] {
	mark() int
}

interface Other {
	other() int
}

type Wrap[K any] struct {
	a [16 / (sizeof(K) - 8)]uint8
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) mark() int {
	return 1
}

func (b *Box[K]) other() int {
	return 2
}

impl *Box[K] : Marker[Wrap[K]], Other

func main() {
	var b Box[int64]
	var o *Other = &b
	testing.Println(o.other())
}
