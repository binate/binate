package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: a generic function's signature, derived for an
// instance, forms the instantiations it names with the instance's type
// arguments, each judged there.  sigb[*N, int64, int32]'s parameter is
// *G[*N, int32], whose *N does not satisfy Eq[[4]uint8]; the declaration's
// check, with sizeof(U) and sizeof(X) not known, cannot tell.

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

func sigb[V Eq[[sizeof(U)]uint8], U any, X any](g *G[V, X]) int {
	return 3
}

func main() {
	testing.Println(sigb[*N, int64, int64](nil))
	testing.Println(sigb[*N, int64, int32](nil))
}
