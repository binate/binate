package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: a method's signature, copied onto an instance of
// its type, forms the instantiations it names with the instance's type
// arguments, each judged there: B2[*N, int64, int32]'s m takes *G[*N, int32].

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type B2[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	v V
}

func (b *B2[V, U, X]) m(g *G[V, X]) int {
	return 2
}

func main() {
	var ok B2[*N, int64, int64]
	testing.Println(ok.m(nil))
	var b B2[*N, int64, int32]
	_ = b
}
