package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: an impl's interface list, resolved for an
// instance of its type, forms the instantiations it names with the instance's
// type arguments, each judged there: the impl for B3[*N, int64, int32] names
// Hk[*G[*N, int32]].

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type B3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	v V
}

func (b *B3[V, U, X]) hk() int {
	return 3
}

impl *B3[V, U, X] : Hk[*G[V, X]]

func main() {
	var ok B3[*N, int64, int64]
	testing.Println(ok.hk())
	var b B3[*N, int64, int32]
	_ = b
}
