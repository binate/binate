package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: an instance first formed in another instance's
// signature is judged there, as where the program names it.  W3[*N, int64,
// int32], first formed in sw4[*N, int64, int32]'s parameter, has a field
// *G[*N, int32]; the program names it again after the call.

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type W3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	g *G[V, X]
}

func sw4[V Eq[[sizeof(U)]uint8], U any, X any](w *W3[V, U, X]) int {
	return 4
}

func main() {
	testing.Println(sw4[*N, int64, int64](nil))
	testing.Println(sw4[*N, int64, int32](nil))
	var w W3[*N, int64, int32]
	_ = w
}
