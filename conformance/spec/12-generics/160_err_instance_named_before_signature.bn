package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: the instance of 159 named by the program before
// the signature that forms it is judged where it is named.

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type W3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	g *G[V, X]
}

func sw4[V Eq[[sizeof(U)]uint8], U any, X any](w *W3[V, U, X]) int {
	return 4
}

func main() {
	var w W3[*N, int64, int32]
	_ = w
	testing.Println(sw4[*N, int64, int32](nil))
}
