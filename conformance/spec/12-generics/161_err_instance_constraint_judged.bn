package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: a type parameter's constraint, resolved for a
// call's type arguments, forms the instantiations it names with them, each
// judged there: cc[*N, int64, int32, *Q]'s H is bounded by Hk[*G[*N, int32]].

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type Q struct {
	q int
}

func (q *Q) hk() int {
	return 7
}

impl *Q : Hk[*G[*N, int64]]

func cc[V Eq[[sizeof(U)]uint8], U any, X any, H Hk[*G[V, X]]](h H) int {
	return h.hk()
}

func main() {
	var q Q
	testing.Println(cc[*N, int64, int64, *Q](&q))
	testing.Println(cc[*N, int64, int32, *Q](&q))
}
