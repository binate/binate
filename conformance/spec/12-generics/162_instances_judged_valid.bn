package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: the instances 156-161 judge, at type arguments
// whose instantiations satisfy their constraints, compile and run.

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

func sigb[V Eq[[sizeof(U)]uint8], U any, X any](g *G[V, X]) int {
	return 3
}

type B2[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	v V
}

func (b *B2[V, U, X]) m(g *G[V, X]) int {
	return 2
}

type B3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	v V
}

func (b *B3[V, U, X]) hk() int {
	return 3
}

impl *B3[V, U, X] : Hk[*G[V, X]]

type W3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	g *G[V, X]
}

func sw4[V Eq[[sizeof(U)]uint8], U any, X any](w *W3[V, U, X]) int {
	return 4
}

type Q struct {
	q int
}

func (q *Q) hk() int {
	return 7
}

impl *Q : Hk[*G[*N, uint64]]

func cc[V Eq[[sizeof(U)]uint8], U any, X any, H Hk[*G[V, X]]](h H) int {
	return h.hk()
}

func main() {
	testing.Println(sigb[*N, int64, uint64](nil))
	var b2 B2[*N, int64, uint64]
	testing.Println(b2.m(nil))
	var b3 B3[*N, int64, float64]
	var h *Hk[*G[*N, float64]] = &b3
	testing.Println(h.hk())
	var w W3[*N, uint64, int64]
	testing.Println(sw4[*N, uint64, int64](&w))
	var q Q
	testing.Println(cc[*N, int64, uint64, *Q](&q))
}
