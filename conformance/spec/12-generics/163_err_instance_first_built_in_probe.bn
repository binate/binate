package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: an instance first built while a conversion checks
// whether another instance satisfies an interface through its impls is judged
// there, as where the program names it.  Converting &b to *Marker resolves
// Box[*N, int64, int32]'s impls, whose Hk[*W3[*N, int64, int32]] first forms
// W3[*N, int64, int32]; its field is *G[*N, int32], whose *N does not satisfy
// Eq[[4]uint8].

interface Eq[T any] {
	eq(o T) int
}

interface Hk[T any] {
	hk() int
}

interface Marker {
	mark() int
}

type N struct {
	v int
}

impl *N : Eq[[8]uint8]

func (n *N) eq(o [8]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type W3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	g *G[V, X]
}

type Box[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	v V
}

func (b *Box[V, U, X]) hk() int {
	return 1
}

func (b *Box[V, U, X]) mark() int {
	return 2
}

impl *Box[V, U, X] : Hk[*W3[V, U, X]]

impl *Box[V, U, X] : Marker

func main() {
	var b Box[*N, int64, int32]
	var m *Marker = &b
	testing.Println(m.mark())
}
