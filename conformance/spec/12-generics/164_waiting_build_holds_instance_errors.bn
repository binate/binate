package "main"

import "pkg/builtins/testing"

// gen.mono.check: Box[N]'s build reads sizeof(N) while N is collected, waits,
// and goes on with the length as 0, naming Other[[0]uint8]: what that instance's
// build and check find (q divides by 0) is held, and never given out -- the
// build done again names Other[[sizeof(N)]uint8].

type Other[T any] struct {
	x T
}

func (o *Other[T]) q() int {
	return 32 / cast(int, sizeof(T))
}

type Box[T any] struct {
	a *Other[[sizeof(T)]uint8]
	t int
}

type N struct {
	v int64
	p *Box[N]
}

func main() {
	var n N
	testing.Println(n.p == nil)
	var o Other[[sizeof(N)]uint8]
	testing.Println(o.q() > 0)
}
