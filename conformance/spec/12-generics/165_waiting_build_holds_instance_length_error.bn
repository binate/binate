package "main"

import "pkg/builtins/testing"

// gen.mono.check: as 164, with Other's field `y [sizeof(T) - 1]uint8`, which
// Other[[0]uint8] would make too large.

type Other[T any] struct {
	x T
	y [sizeof(T) - 1]uint8
}

type Box[T any] struct {
	a *Other[[sizeof(T)]uint8]
	t int
}

type N struct {
	v int64
	p *Box[N]
}

func main() {
	var n N
	testing.Println(n.p == nil)
	var o Other[[sizeof(N)]uint8]
	testing.Println(len(o.y) > 0)
}
