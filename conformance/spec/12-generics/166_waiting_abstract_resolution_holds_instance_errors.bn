package "main"

import "pkg/builtins/testing"

// gen.mono.check: Box's declaration, resolved with T abstract, reads sizeof(N)
// while N is collected, waits, and goes on with the length as 0: what
// Other[[0]uint8]'s build and check find is held, and never given out.

type Other[T any] struct {
	x T
}

func (o *Other[T]) q() int {
	return 32 / cast(int, sizeof(T))
}

type Box[T any] struct {
	a *Other[[sizeof(N)]uint8]
	t T
}

type N struct {
	v int64
	p *Box[int]
}

func main() {
	var n N
	testing.Println(n.p == nil)
	var o Other[[sizeof(N)]uint8]
	testing.Println(o.q() > 0)
}
