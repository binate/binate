package "main"

import "pkg/builtins/testing"

// gen.mono.check: Box[N]'s build, waiting for N's layout, names
// gf[[0]uint8](), whose body divides by 0: its body check is held, and never
// made; the build done again names gf[[sizeof(N)]uint8].

func gf[T any]() [2]int {
	var a [2]int
	a[0] = 32 / cast(int, sizeof(T))
	return a
}

type Box[T any] struct {
	a *([len(gf[[sizeof(T)]uint8]())]uint8)
	t int
}

type N struct {
	v int64
	p *Box[N]
}

func main() {
	var n N
	testing.Println(n.p == nil)
	testing.Println(gf[[sizeof(N)]uint8]()[0] > 0)
}
