package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: an instance with real type arguments named in a
// build that waits gives out what its build held when the build done again names
// it: X[int64, int32] waits for Q[int64]'s layout and names I[int64, int32],
// whose field J[*Box[int64], int32] misses Eq[[4]uint8].

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type J[A Eq[[sizeof(B)]uint8], B any] struct {
	a A
}

type I[T any, U any] struct {
	j J[*Box[T], U]
	t T
}

type Q[T any] struct {
	v T
	p *X[T, int32]
}

type X[T any, U any] struct {
	a [sizeof(Q[T])]uint8
	i I[T, U]
}

func main() {
	var q Q[int64]
	testing.Println(q.p == nil)
}
