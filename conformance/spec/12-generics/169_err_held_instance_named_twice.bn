package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: J[*Box[int64], int32], named twice in
// X[int64, int32]'s build that waits, holds its miss from the first naming, and
// gives it out when the build done again names it.

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type J[A Eq[[sizeof(B)]uint8], B any] struct {
	a A
}

type Q[T any] struct {
	v T
	p *X[T, int32]
}

type X[T any, U any] struct {
	a  [sizeof(Q[T])]uint8
	j1 J[*Box[T], U]
	j2 J[*Box[T], U]
}

func main() {
	var q Q[int64]
	testing.Println(q.p == nil)
}
