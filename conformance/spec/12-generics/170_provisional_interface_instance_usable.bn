package "main"

import "pkg/builtins/testing"

// gen.satisfy: Sub[[8]uint8], first built by a satisfaction probe in X[int64]'s
// build, which waits for Q[int64]'s layout, is built as any instance is:
// Box[int64] converts to *Base through it.

interface Base {
	b() int
}

interface Sub[T any] : Base {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Sub[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

func (b *Box[K]) b() int {
	return 7
}

type J[A Base] struct {
	a A
}

type Q[T any] struct {
	v T
	p *X[T]
}

type X[T any] struct {
	a  [sizeof(Q[T])]uint8
	j1 J[*Box[T]]
	j2 J[*Box[T]]
}

func main() {
	var q Q[int64]
	testing.Println(q.p == nil)
	var bx Box[int64]
	var e *Base = &bx
	testing.Println(e.b())
}
