package "main"

import "pkg/builtins/testing"

// gen.mono.check: Box's declaration, resolved abstractly, waits for N's layout,
// and names G[T], whose own resolution, kept, resolves S on demand: R[int64],
// named there, is no instance formed from the length not read, and what its build
// finds is reported.

type R[T any] struct {
	y [sizeof(T) - 9]uint8
}

type G[T any] struct {
	a [S]uint8
	t T
}

type Pair[A any, B any] struct {
	a A
	b *B
}

type Box[T any] struct {
	o *Pair[[sizeof(N)]uint8, G[T]]
	t T
}

type N struct {
	v int64
	p *Box[int]
}

const S = sizeof(*R[int64])

func main() {
	var n N
	testing.Println(n.p == nil)
	testing.Println(S)
}
