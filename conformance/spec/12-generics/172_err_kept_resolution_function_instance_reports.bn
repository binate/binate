package "main"

import "pkg/builtins/testing"

// gen.mono.check: as 171, with S the length of gf[int64](), whose body divides by
// sizeof(T) - 8: the check of gf[int64]'s body is made.

func gf[T any]() [2]int {
	var a [2]int
	a[0] = 32 / cast(int, sizeof(T) - 8)
	return a
}

type G[T any] struct {
	a [S]uint8
	t T
}

type Pair[A any, B any] struct {
	a A
	b *B
}

type Box[T any] struct {
	o *Pair[[sizeof(N)]uint8, G[T]]
	t T
}

type N struct {
	v int64
	p *Box[int]
}

const S = len(gf[int64]())

func main() {
	var n N
	testing.Println(n.p == nil)
	testing.Println(S)
}
