package "main"

import "pkg/builtins/testing"

// gen.mono.check: gv's check, made on demand while N is collected, names R[int64],
// first named in Box[N, int64]'s build that waited: what R[int64]'s build found,
// its array length error, is given out then, and is not gv's own -- gv's check
// reported nothing, and gv is not checked again.

type R[T any] struct {
	arr [3]uint8
	y   [sizeof(T) - 9]uint8
}

type Pair[A any, B any] struct {
	a A
	b *B
}

type Box[T any, V any] struct {
	o *Pair[[sizeof(T)]uint8, R[V]]
	t int
}

type N struct {
	v int64
	p *Box[N, int64]
	w [len(gv)]uint8
}

var gv = R[int64]{}.arr

func main() {
	var n N
	testing.Println(len(n.w))
}
