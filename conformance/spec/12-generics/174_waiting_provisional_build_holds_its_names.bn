package "main"

import "pkg/builtins/testing"

// gen.mono.check: W[N], first named after Box[N]'s build read N's size, is
// provisional, and its own build waits: Other[[0]uint8], which it names then, is
// not given out with it -- only what its build done again names.

type Other[T any] struct {
	x T
}

func (o *Other[T]) q() int {
	return 32 / cast(int, sizeof(T))
}

type W[T any] struct {
	a *Other[[sizeof(T)]uint8]
	t int
}

type Pair[A any, B any] struct {
	a A
	b *B
}

type Box[T any] struct {
	o *Pair[[sizeof(T)]uint8, W[T]]
	t int
}

type N struct {
	v int64
	p *Box[N]
}

func main() {
	var n N
	testing.Println(n.p == nil)
	var o Other[[sizeof(N)]uint8]
	testing.Println(o.q() > 0)
}
