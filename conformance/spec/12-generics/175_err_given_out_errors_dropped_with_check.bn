package "main"

import "pkg/builtins/testing"

// gen.mono.check: gv's check, made on demand while N is collected, names R[int64],
// first named in Box[N, int64]'s build that waited, giving out its array length
// error, and R2[int64], whose own error makes the check set aside with what it
// reported: R[int64]'s error is given out again when gv is checked again.

type R[T any] struct {
	arr [3]uint8
	y   [sizeof(T) - 9]uint8
}

type Pair[A any, B any] struct {
	a A
	b *B
}

type Box[T any, V any] struct {
	o *Pair[[sizeof(T)]uint8, R[V]]
	t int
}

type N struct {
	v int64
	p *Box[N, int64]
	w [len(gv)]uint8
}

type R2[T any] struct {
	z [sizeof(T) - 10]uint8
}

type Pick[A any, B any] struct {
	a   *A
	b   *B
	arr [3]uint8
}

var gv = Pick[R[int64], R2[int64]]{}.arr

func main() {
	var n N
	testing.Println(len(n.w))
}
