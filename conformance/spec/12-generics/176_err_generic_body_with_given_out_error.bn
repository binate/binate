package "main"

import "pkg/builtins/testing"

// gen.mono.check: gf's body names Other[[0]uint8], first named in Box[N]'s build
// that waited, giving out its array length error; that error is not the body's,
// and gf[int64]'s body is checked, dividing by 0.

type Other[T any] struct {
	x T
	y [sizeof(T) - 1]uint8
}

type Box[T any] struct {
	a *Other[[sizeof(T)]uint8]
	t int
}

type N struct {
	v int64
	p *Box[N]
}

func gf[T any]() int {
	var o *Other[[0]uint8]
	_ = o
	return 32 / cast(int, sizeof(T) - 8)
}

func main() {
	var n N
	testing.Println(n.p == nil)
	testing.Println(gf[int64]())
}
