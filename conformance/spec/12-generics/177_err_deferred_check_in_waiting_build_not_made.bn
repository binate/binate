package "main"

import "pkg/builtins/testing"

// gen.satisfy: Box[N]'s build reads sizeof(N) while N is collected, waits, and
// names J's instantiation from the length it could not read, whose constraint
// check waits for the collection: that check is never made; the build done again
// makes its own, and *EqBox[[sizeof(N)]uint8] misses Eq[[8]uint8] for real.

interface Eq[T any] {
	eq(o T) int
}

type EqBox[K any] struct {
	k K
}

impl *EqBox[K] : Eq[[sizeof(K) + 1]uint8]

func (b *EqBox[K]) eq(o [sizeof(K) + 1]uint8) int {
	return len(o)
}

type J[A Eq[[sizeof(B)]uint8], B any] struct {
	a A
}

type Box[T any] struct {
	a *J[*EqBox[[sizeof(T)]uint8], [sizeof(T) + 8 - sizeof(T)]uint8]
	t int
}

type N struct {
	v int64
	p *Box[N]
}

func main() {
	var n N
	testing.Println(n.p == nil)
	testing.Println(sizeof(N))
}
