package "main"

import "pkg/builtins/testing"

// gen.satisfy: Box[N, int16]'s build reads sizeof(N) while N is collected,
// waits, and names J[*EqBox[*N], int16], whose arguments it read in full: the
// check its build deferred is not made, and the build done again defers the same
// check, which reports *EqBox[*N] missing Eq[[2]uint8].

interface Eq[T any] {
	eq(o T) int
}

type EqBox[K any] struct {
	k K
}

impl *EqBox[K] : Eq[[sizeof(K)]uint8]

func (b *EqBox[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type J[A Eq[[sizeof(B)]uint8], B any] struct {
	a A
}

type Pair[A any, B any] struct {
	a A
	b *B
}

type Box[T any, V any] struct {
	o *Pair[[sizeof(T)]uint8, J[*EqBox[*T], V]]
	t int
}

type N struct {
	v int64
	p *Box[N, int16]
}

func main() {
	var n N
	testing.Println(n.p == nil)
}
