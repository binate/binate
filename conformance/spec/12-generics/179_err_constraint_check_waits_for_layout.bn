package "main"

import "pkg/builtins/testing"

// gen.satisfy: a type argument's constraint check that reads the layout of an
// instance still being built waits for it, then is made.  X[int8], built for Y's
// field, forms K[int8, *N, int8], whose constraint Sz[[sizeof(X[int8])]uint8]
// reads X[int8]'s size; X's own check finds T satisfying neither Sz[[2]uint8]
// nor Hk[G2[*N]].

interface Eq {
	eq() int
}

interface Hk[T any] {
	hk() int
}

interface Sz[T any] {
	sz() int
}

type G2[A Eq] struct {
	a A
}

type N struct {
	v int
}

func (n *N) eq() int {
	return 1
}

impl *N : Eq

type Y[T any] struct {
	x X[int8]
	t T
}

type X[T any] struct {
	k K[T, *N, T]
	t T
}

type K[A Sz[[sizeof(X[int8])]uint8], V Eq, B Hk[G2[V]]] struct {
	a A
}

func main() {
	var y Y[int]
	_ = y
	testing.Println(1)
}
