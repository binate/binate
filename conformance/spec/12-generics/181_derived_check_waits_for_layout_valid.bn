package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: the valid counterpart of 180: with R[T] for Y,
// *Box[R[int64]] satisfies Eq[[sizeof(R[int64])]uint8] on every target.

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type Holder[X any, Y any] struct {
	h int
}

func (h *Holder[X, Y]) m(g *G[*Box[X], Y]) int {
	return 5
}

type R[T any] struct {
	v    T
	w    int64
	next *Holder[R[T], R[T]]
}

func main() {
	var r R[int64]
	testing.Println(r.next == nil)
	var h Holder[R[int64], R[int64]]
	testing.Println(h.m(nil))
}
