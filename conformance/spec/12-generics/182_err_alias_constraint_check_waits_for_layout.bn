package "main"

import "pkg/builtins/testing"

// gen.satisfy: a generic alias's constraint check that reads the layout of an
// instance still being built is made once it is built.  X[M], built for Y's
// field, names KA[M], whose constraint Sz[[sizeof(X[M])]uint8] reads X[M]'s
// size, 8; X's own check finds its T, bounded by Sz[[4]uint8], not satisfying it.

interface Sz[T any] {
	sz() int
}

type M struct { b [6]uint8 }

func (m M) sz() int { return 7 }

impl M : Sz[[4]uint8]

type Y[T any] struct { x X[M]; t T }

type X[T Sz[[4]uint8]] struct { k KA[T]; c [2]uint8 }

type KA[A Sz[[sizeof(X[M])]uint8]] = [1]A

func main() {
	var y Y[int]
	testing.Println(y.x.k[0].sz())
	testing.Println(sizeof(X[M]))
}
