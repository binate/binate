package "main"

import "pkg/builtins/testing"

// gen.satisfy: the valid counterpart of 182: with T bounded by Sz[[8]uint8], X[M]
// and KA[M] satisfy their constraints.

interface Sz[T any] {
	sz() int
}

type M struct { b [6]uint8 }

func (m M) sz() int { return 7 }

impl M : Sz[[8]uint8]

type Y[T any] struct { x X[M]; t T }

type X[T Sz[[8]uint8]] struct { k KA[T]; c [2]uint8 }

type KA[A Sz[[sizeof(X[M])]uint8]] = [1]A

func main() {
	var y Y[int]
	testing.Println(y.x.k[0].sz())
	testing.Println(sizeof(X[M]))
}
