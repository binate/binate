package "main"

import "pkg/builtins/testing"

// gen.satisfy: the valid counterpart of 179: X[M], built for Y's field, forms
// K[M], whose constraint Sz[[sizeof(X[M])]uint8] reads X[M]'s size, 2, while
// X[M] is built; M satisfies it.

interface Sz[T any] {
	sz() int
}

type M struct { b int8 }

func (m M) sz() int { return 7 }

impl M : Sz[[2]uint8]

type Y[T any] struct { x X[M]; t T }

type X[T Sz[[2]uint8]] struct { k K[T]; t T }

type K[A Sz[[sizeof(X[M])]uint8]] struct { a A }

func main() {
	var y Y[int]
	testing.Println(y.x.k.a.sz())
	testing.Println(sizeof(X[M]))
}
