package "main"

import "pkg/builtins/testing"

// gen.satisfy: X[int64]'s field names KA[*Box[X[int64]], X[int64]], whose
// constraint reads X[int64]'s own size while X[int64] waits for Q[int64]'s
// layout; the check is no part of X[int64]'s layout, which is built, and
// *Box[X[int64]] satisfies Eq[[sizeof(X[int64])]uint8].

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct { k K }

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int { return len(o) }

type Q[T any] struct { v T; p *X[T] }

type X[T any] struct { a [sizeof(Q[T])]uint8; k KA[*Box[X[T]], X[T]]; t T }

type KA[A Eq[[sizeof(B)]uint8], B any] = *A

func main() {
	var q Q[int64]
	testing.Println(q.p == nil)
	testing.Println(sizeof(X[int64]) > 0)
}
