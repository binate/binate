package "main"

import "pkg/builtins/testing"

// gen.satisfy: X[int64]'s first build reads Q[int64]'s size while Q[int64] is
// built, waits, and names KA's instantiation with B as [0]uint8; its constraint
// check is not made then, but when the build is done again, for
// KA[*Box[Q[int64]], [sizeof(Q[int64])]uint8], which is valid on every target.

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type Q[T any] struct {
	v T
	p *X[T]
}

type X[T any] struct {
	k KA[*Box[Q[T]], [sizeof(Q[T])]uint8]
	t T
}

type KA[A Eq[B], B any] = *A

func main() {
	var q Q[int64]
	testing.Println(q.p == nil)
	testing.Println(sizeof(X[int64]) > 0)
}
