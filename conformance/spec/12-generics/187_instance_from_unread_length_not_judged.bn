package "main"

import "pkg/builtins/testing"

// gen.satisfy: as 186, with KS a generic struct type: KS[*Box[Q[int64]],
// [0]uint8], built inside X[int64]'s first build, which waits, is not judged; the
// build done again forms and judges KS[*Box[Q[int64]], [sizeof(Q[int64])]uint8].

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func (b *Box[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type Q[T any] struct {
	v T
	p *X[T]
}

type X[T any] struct {
	k *KS[*Box[Q[T]], [sizeof(Q[T])]uint8]
	t T
}

type KS[A Eq[B], B any] struct {
	a A
}

func main() {
	var q Q[int64]
	testing.Println(q.p == nil)
	testing.Println(sizeof(X[int64]) > 0)
}
