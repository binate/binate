package "main"
import "pkg/builtins/testing"

import "pkg/pm"

// gen.mono.check, pkg.export: a method or impl of a generic type that only its
// package's .bn declares is package-private, so an instance named in a chain
// rooted elsewhere -- here directly, and through F's body -- does not have it,
// and it is not checked for that instance: each of pm's is invalid for int64,
// and the program is valid.
func main() {
	var a pm.W1[int64]
	var b pm.W2[int64]
	var c pm.W3[int64]
	testing.Println(a.Pub() + b.Pub() + c.Pub() + pm.F[int64]())
}
