package "pkg/pm"

// Members only this .bn declares, each invalid for an int64 argument.  Only
// another package names those instances, so none of these is theirs.

func (w *W1[U]) priv() int {
	var a [sizeof(U) - 9]uint8
	return len(a)
}

func (w *W2[U]) privSig(a [sizeof(U) - 9]uint8) int {
	return len(a)
}

func (w *W3[U]) sz() int {
	return 3
}

impl *W3[U] : Sz[[sizeof(U) - 9]uint8]

func (w *W4[U]) priv() int {
	var a [sizeof(U) - 9]uint8
	return len(a)
}
