package "main"
import "pkg/builtins/testing"

import "pkg/pm"

// gen.mono.check, pkg.export: a method or impl of a generic type that only its
// package's .bn declares is checked for each instance a chain rooted in that
// package names -- its .bn directly or through F's body, or its .bni.  Each of
// pm's is invalid for int64.  This program must fail to compile.
func main() {
	testing.Println(pm.Use())
}
