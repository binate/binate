package "pkg/pm"

// Sz is implemented by W3's instances through an impl only pm's .bn declares.
interface Sz[A any] {
	sz() int
}

// W1's .bn adds a method whose body is invalid when U is larger than 8 bytes.
type W1[U any] struct {
	u U
}

func (w *W1[U]) Pub() int {
	return 1
}

// W2's .bn adds a method whose signature is.
type W2[U any] struct {
	u U
}

func (w *W2[U]) Pub() int {
	return 2
}

// W3's .bn adds an impl whose interface is.
type W3[U any] struct {
	u U
}

func (w *W3[U]) Pub() int {
	return 3
}

// W4's .bn adds a method like W1's; W4 is named only in F's body.
type W4[U any] struct {
	u U
}

func (w *W4[U]) Pub() int {
	return 4
}

// F returns the sum of a W4[U]'s Pub.
func F[U any]() int {
	var w W4[U]
	return w.Pub()
}

// W5's .bn adds a method like W1's; W5 is named only in H5, here.
type W5[U any] struct {
	u U
}

func (w *W5[U]) Pub() int {
	return 5
}

// H5 holds a W5[int64].
type H5 struct {
	w W5[int64]
}

// Use names pm's instances from its own .bn.
func Use() int
