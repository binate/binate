package "pkg/pm"

// Members only this .bn declares, each invalid for an int64 argument: the
// instances this package names have them, so each is an error.

func (w *W1[U]) priv() int {
	var a [sizeof(U) - 9]uint8
	return len(a)
}

func (w *W2[U]) privSig(a [sizeof(U) - 9]uint8) int {
	return len(a)
}

func (w *W3[U]) sz() int {
	return 3
}

impl *W3[U] : Sz[[sizeof(U) - 9]uint8]

func (w *W4[U]) priv() int {
	var a [sizeof(U) - 9]uint8
	return len(a)
}

func (w *W5[U]) priv() int {
	var a [sizeof(U) - 9]uint8
	return len(a)
}

func Use() int {
	var a W1[int64]
	var b W2[int64]
	var c W3[int64]
	return a.Pub() + b.Pub() + c.Pub() + F[int64]()
}
