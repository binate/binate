package "main"
import "pkg/builtins/testing"

import "pkg/pa"

// iface.assert, gen.mono.check: an impl only pa's .bn declares counts at run
// time for the instances pa's own code names -- W[int64], which Keep names
// without boxing it -- and not for one only another package names, W[int32].
// main's boxes of both are asserted in pa.
func main() {
	var a pa.W[int64]
	var b pa.W[int32]
	testing.Println(pa.Keep())
	testing.Println(pa.Has64(&a))
	testing.Println(pa.Has32(&b))
}
