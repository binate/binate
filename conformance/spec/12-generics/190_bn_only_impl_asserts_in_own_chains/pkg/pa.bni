package "pkg/pa"

// Sz is implemented by W's instances through an impl only pa's .bn declares.
interface Sz[A any] {
	sz() int
}

// W's .bn adds a method sz and that impl.
type W[U any] struct {
	u U
}

func (w *W[U]) Pub() int {
	return 1
}

// Keep names W[int64] in pa's own code, without boxing it.
func Keep() int

// Has64 and Has32 return sz through Sz[int64] or Sz[int32], or -1.
func Has64(a *any) int

func Has32(a *any) int
