package "pkg/pa"

func (w *W[U]) sz() int {
	return 30
}

impl *W[U] : Sz[U]

func Keep() int {
	var w W[int64]
	return w.Pub()
}

func Has64(a *any) int {
	s, ok := a.(*Sz[int64])
	if ok { return s.sz() }
	return -1
}

func Has32(a *any) int {
	s, ok := a.(*Sz[int32])
	if ok { return s.sz() }
	return -1
}
