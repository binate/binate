package "main"
import "pkg/builtins/testing"

import "pkg/pg"

// gen.mono.check, pkg.export: W's method only pg's .bn declares is not an
// instance main names, though pg's .bni declares W only inside a type group;
// boxing the instance does not bring it in.
func main() {
	var w pg.W[int64]
	w.u = 5
	var a *any = &w
	_, ok := a.(*pg.W[int64])
	if ok { testing.Println(cast(int, w.u) + pg.Use()) }
}
