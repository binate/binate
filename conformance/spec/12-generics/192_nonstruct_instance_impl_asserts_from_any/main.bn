package "main"

import "pkg/builtins/testing"

import "pkg/pn"

// iface.assert, gen.mono.check: an instance of a generic type that is not a
// struct satisfies its generic's impls at run time, when it is boxed into `any`
// alone (no direct conversion to the interface anywhere): N[int16] through N's
// public impl, P[int16] through an impl only pn's .bn declares, which counts
// because pn's own code (Use) names P[int16].
func main() {
	var w pn.N[int16]
	var a *any = &w
	t, ok := a.(*pn.Sz)
	if ok { testing.Println(t.sz()) } else { testing.Println(-1) }
	var p pn.P[int16]
	testing.Println(pn.Probe(&p))
	testing.Println(pn.Use())
}
