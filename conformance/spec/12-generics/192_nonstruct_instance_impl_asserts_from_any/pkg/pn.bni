package "pkg/pn"

// Sz is implemented by N's and P's instances.
interface Sz {
	sz() int
}

// N implements Sz through a public impl.
type N[U any] [4]U

func (w *N[U]) sz() int {
	return 30
}

impl *N[U] : Sz

// P implements Sz through an impl only pn's .bn declares.
type P[U any] [2]U

// Probe returns sz through Sz, or -1.
func Probe(a *any) int

// Use probes a P[int16] of its own.
func Use() int
