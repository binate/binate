package "main"

import "pkg/builtins/testing"

// gen.mono.check / iface.self.constraint: a generic interface's instance judges
// `Self` bounded by the instance, with the lengths its type arguments give:
// I3[int64, int32] extends Eq[[8]uint8], and its G[Self, int32] needs
// Eq[[4]uint8].  I3[int64, int64] is valid.

interface Eq[T any] {
	eq(o T) int
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

interface I3[U any, X any] : Eq[[sizeof(U)]uint8] {
	m(x *G[Self, X]) int
}

func main() {
	var ok *I3[int64, int64]
	_ = ok
	var bad *I3[int64, int32]
	_ = bad
	testing.Println(1)
}
