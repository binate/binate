package "main"

import "pkg/builtins/testing"

// gen.mono.check / iface.self.constraint: each instance of a generic interface
// judges `Self` bounded by itself.  I3[int64, int64] is valid, and P implements
// it.  In I4[int64], Outer[Self, int64, int64] is judged where I4 names it, with
// I4[int64]'s `Self`, and not again by the Outer instance, which extends no Eq.

interface Eq[T any] {
	eq(o T) int
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

interface I3[U any, X any] : Eq[[sizeof(U)]uint8] {
	m(x *G[Self, X]) int
}

interface Outer[V Eq[[sizeof(U)]uint8], U any, X any] {
	k(g *G[V, X]) int
}

interface I4[U any] : Eq[[sizeof(U)]uint8] {
	n(o *Outer[Self, U, U]) int
}

type P struct {
	v int
}

func (p *P) eq(o [8]uint8) int {
	return p.v
}

func (p *P) m(x *G[*P, int64]) int {
	return x.t.v + 1
}

func (p *P) n(o *Outer[*P, int64, int64]) int {
	var g G[*P, int64]
	g.t = p
	return o.k(&g)
}

impl *P : I3[int64, int64]

impl *P : I4[int64]

type Q struct {
	w int
}

func (q *Q) k(g *G[*P, int64]) int {
	return g.t.v * 10 + q.w
}

impl *Q : Outer[*P, int64, int64]

func useI3[T I3[int64, int64]](t T, g *G[T, int64]) int {
	return t.m(g)
}

func main() {
	var p P
	p.v = 4
	var g G[*P, int64]
	g.t = &p
	testing.Println(p.m(&g))
	testing.Println(useI3[*P](&p, &g))
	var q Q
	q.w = 2
	testing.Println(p.n(&q))
	var i *I3[int64, int64] = &p
	testing.Println(i.eq([8]uint8{}))
	var j *I4[int64] = &p
	testing.Println(j.eq([8]uint8{}))
}
