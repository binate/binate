package "main"

import "pkg/builtins/testing"

// gen.mono.check / iface.self.constraint: an interface instance first built
// while a generic function instance's signature is derived judges its `Self`
// there, bounded by the instance: h[int64] takes **I3[int64, int32], whose
// G[Self, int32] needs Eq[[4]uint8] of a `Self` extending Eq[[8]uint8].  The
// later use finds the instance built.

interface Eq[T any] {
	eq(o T) int
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

interface I3[U any, X any] : Eq[[sizeof(U)]uint8] {
	m(x *G[Self, X]) int
}

func h[T any](x **I3[T, int32]) int {
	return 1
}

func main() {
	testing.Println(h[int64](nil))
	var later *I3[int64, int32]
	_ = later
}
