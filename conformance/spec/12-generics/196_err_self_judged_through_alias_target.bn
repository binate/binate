package "main"

import "pkg/builtins/testing"

// gen.mono.check / iface.self.constraint / type.alias.transparency: a generic
// alias's target is as if written where the alias is used, so a `Self` argument
// of an instantiation in it is judged with the interface using the alias: in
// I3[int64, int32], GA[Self, int64, int32] is G[Self, int32], which needs
// Eq[[4]uint8] of a `Self` extending Eq[[8]uint8].  I3[int64, int64] is valid.

interface Eq[T any] {
	eq(o T) int
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type GA[T Eq[[sizeof(U)]uint8], U any, X any] = G[T, X]

interface I3[U any, X any] : Eq[[sizeof(U)]uint8] {
	m(x *GA[Self, U, X]) int
}

func main() {
	var ok *I3[int64, int64]
	_ = ok
	var bad *I3[int64, int32]
	_ = bad
	testing.Println(1)
}
