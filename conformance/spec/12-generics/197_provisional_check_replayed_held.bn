package "main"

import "pkg/builtins/testing"

// gen.mono.check: Box[T]'s field names Other[[sizeof(N)]uint8, T] while N is
// collected, so Other[[0]uint8, T] is built provisionally from the length not
// read yet, and what it finds is held.  The constraint check of its field's J,
// recorded there while the declarations are collected, is made at the end of
// the collection as where it was recorded: held, though that build names no
// instance -- its miss, *EqBox[[0]uint8] against Eq[[16]uint8], is never given
// out.  sizeof(N) is 16 on every target, and J[*EqBox[[16]uint8], [16]uint8] is
// valid.

interface Eq[T any] {
	eq(o T) int
}

type EqBox[K any] struct {
	k K
}

impl *EqBox[K] : Eq[[sizeof(K)]uint8]

func (b *EqBox[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type J[A Eq[[sizeof(B)]uint8], B any] struct {
	a A
}

type Other[A any, T any] struct {
	j *J[*EqBox[A], [sizeof(A) + 16 - sizeof(A)]uint8]
	t T
}

type Box[T any] struct {
	a Other[[sizeof(N)]uint8, T]
	t T
}

type N struct {
	v int64
	p *Box[int]
}

func main() {
	var n N
	_ = n
	testing.Println(1)
}
