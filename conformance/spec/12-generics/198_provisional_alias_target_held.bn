package "main"

import "pkg/builtins/testing"

// gen.mono.check / type.alias.transparency: a generic alias's target is as if
// written at its use, and held as there.  Box[T]'s field names
// I3[[sizeof(N)]uint8, [16]uint8] while N is collected, so I3[[0]uint8,
// [16]uint8] is built provisionally; its method names GA2[Self, U, X], whose
// target names R[[0]uint8], with a length that divides by 0 -- never given
// out.  sizeof(N) is 16 on every target, and I3[[16]uint8, [16]uint8] is valid.

interface Eq[T any] {
	eq(o T) int
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type R[T any] struct {
	y [32 / sizeof(T)]uint8
}

type P2[A any, B any] struct {
	a *A
	b *B
}

type GA2[T Eq[[sizeof(U)]uint8], U any, X any] = P2[G[T, X], R[U]]

interface I3[U any, X any] : Eq[[sizeof(U)]uint8] {
	m(x *GA2[Self, U, X]) int
}

type Box[T any] struct {
	a *I3[[sizeof(N)]uint8, [16]uint8]
	t T
}

type N struct {
	v int64
	p *Box[int]
}

func main() {
	var n N
	_ = n
	testing.Println(1)
}
