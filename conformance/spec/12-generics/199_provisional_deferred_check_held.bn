package "main"

import "pkg/builtins/testing"

// gen.mono.check / type.alias.transparency: Q[int64]'s field names X[int64,
// int32], whose build reads sizeof(Q[int64]) before that layout is built, so
// I3[[0]uint8, Q[int64]] is built provisionally from the length not read.  Its
// method names GA3[Self, U, X], whose target's constraint check reads
// sizeof(Q[int64]) too, waits for it and is made once it is built: held as
// where it was recorded -- its miss, *EqBox[[0]uint8] against Eq[[16]uint8], is
// never given out.  sizeof(Q[int64]) is 16 on every target, and I3[[16]uint8,
// Q[int64]] is valid.

interface Eq[T any] {
	eq(o T) int
}

type EqBox[K any] struct {
	k K
}

impl *EqBox[K] : Eq[[sizeof(K)]uint8]

func (b *EqBox[K]) eq(o [sizeof(K)]uint8) int {
	return len(o)
}

type KK[A Eq[[sizeof(B)]uint8], B any] struct {
	a A
}

type GA3[T Eq[[sizeof(U)]uint8], U any, X any] = KK[*EqBox[U], X]

interface I3[U any, X any] : Eq[[sizeof(U)]uint8] {
	m(x *GA3[Self, U, X]) int
}

type Q[T any] struct {
	v T
	p *X[T, int32]
}

type X[T any, U any] struct {
	a [sizeof(Q[T])]uint8
	i *I3[[sizeof(Q[T])]uint8, Q[T]]
}

func main() {
	var q Q[int64]
	_ = q
	testing.Println(1)
}
