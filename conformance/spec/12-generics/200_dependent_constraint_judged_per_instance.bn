package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: whether a type argument satisfies its
// constraint depends on a length that depends on a type parameter when the
// constraint's or the matching interface's type argument holds one: *N, with
// `impl *N : Eq[[8]uint8]`, satisfies `Eq[[sizeof(U)]uint8]` for U = int64 only.
// A generic's own check leaves such a judgment to each instantiation -- it
// rejects only what fails with every such length matching any length -- and
// each concrete instantiation is judged where it is formed.  So each generic
// here is valid, as are its instances at int64: a call (fwd, f6, fwd2, gb, gj,
// gr), a field (W), a signature (fA, s3), a generic interface's method (Hh), an
// alias's target (GA) and a call in a field's length (W9); through an impl, a
// type parameter's bound (fwd2, f6), a parameterized impl (gb), an ancestor (gj)
// and an impl on an alias of an instance (gr).  So is an assignment between
// arrays of instances whose lengths and type arguments depend on U (asg).

interface Eq[T any] {
	eq(o T) int
}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : Eq[[8]uint8]

func inner[T Eq[[sizeof(U)]uint8], U any](t T) int {
	var o [sizeof(U)]uint8
	return t.eq(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type K2[B any, A Eq[B]] struct {
	a A
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) eq(o [8]uint8) int {
	return len(o) + 1
}

impl *Box[K] : Eq[[8]uint8]

interface J8 : Eq[[8]uint8] {}

type N8 struct {
	v int
}

func (n *N8) eq(o [8]uint8) int {
	return len(o) + 2
}

impl *N8 : J8

func fwd[U any](n *N) int {
	return inner[*N, U](n)
}

type W[U any] struct {
	g *G[*N, U]
}

func fA[U any](k *K2[[sizeof(U)]uint8, *N]) int {
	return 1
}

interface Hh[U any] {
	take(k *G[*N, U]) int
}

type GA[U any] = G[*N, U]

func mk2[T Eq[[sizeof(U)]uint8], U any]() [3]int {
	var r [3]int
	return r
}

type W9[U any] struct {
	a [len(mk2[*N, U]())]uint8
}

func fwd2[V Eq[[8]uint8]](v V) int {
	return inner[V, int64](v)
}

func f6[V Eq[[8]uint8], U any](v V) int {
	return inner[V, U](v)
}

type W3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	g *G[V, X]
}

func s3[X any](w *W3[*N, int64, X]) int {
	return 2
}

func gb[U any](b *Box[U]) int {
	return inner[*Box[U], U](b)
}

func gj[U any](n *N8) int {
	return inner[*N8, U](n)
}

type G1[A any] struct {
	a A
}

type R[A any] struct {
	a A
}

func (r *R[A]) eq(o [8]uint8) int {
	return len(o) + 3
}

type R8 = R[[8]uint8]

impl *R8 : Eq[[8]uint8]

func gr[U any](r *R[[sizeof(U)]uint8]) int {
	return inner[*R[[sizeof(U)]uint8], int64](r)
}

func asg[U any]() int {
	var a [sizeof(U)]*G1[[sizeof(U)]uint8]
	var b [8]*G1[[8]uint8] = a
	return len(b)
}

func main() {
	var n N
	testing.Println(fwd[int64](&n))
	var w W[int64]
	_ = w
	testing.Println(fA[int64](nil))
	var h *Hh[int64]
	_ = h
	var ga *GA[int64]
	_ = ga
	var w9 W9[int64]
	testing.Println(len(w9.a))
	testing.Println(fwd2[*N](&n))
	testing.Println(f6[*N, int64](&n))
	testing.Println(s3[int64](nil))
	var b Box[int64]
	testing.Println(gb[int64](&b))
	var n8 N8
	testing.Println(gj[int64](&n8))
	var r R[[8]uint8]
	testing.Println(gr[int64](&r))
	testing.Println(asg[int64]())
}
