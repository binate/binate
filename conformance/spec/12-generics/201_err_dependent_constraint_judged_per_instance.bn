package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: as 200, the generics' instances at types that
// are not 8 bytes, where the constraint is Eq[[4]uint8], Eq[[2]uint8] or
// Eq[[1]uint8]: each is rejected where it is formed, naming the instance -- an
// alias's target as written at its use.  Each forms its own instantiation: a
// miss is reported once per instantiation.  asg[int32]'s assignment, between
// arrays of different lengths, is rejected in the instance too.

interface Eq[T any] {
	eq(o T) int
}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : Eq[[8]uint8]

func inner[T Eq[[sizeof(U)]uint8], U any](t T) int {
	var o [sizeof(U)]uint8
	return t.eq(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type K2[B any, A Eq[B]] struct {
	a A
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) eq(o [8]uint8) int {
	return len(o) + 1
}

impl *Box[K] : Eq[[8]uint8]

interface J8 : Eq[[8]uint8] {}

type N8 struct {
	v int
}

func (n *N8) eq(o [8]uint8) int {
	return len(o) + 2
}

impl *N8 : J8

func fwd[U any](n *N) int {
	return inner[*N, U](n)
}

type W[U any] struct {
	g *G[*N, U]
}

func fA[U any](k *K2[[sizeof(U)]uint8, *N]) int {
	return 1
}

interface Hh[U any] {
	take(k *G[*N, U]) int
}

type GA[U any] = G[*N, U]

func mk2[T Eq[[sizeof(U)]uint8], U any]() [3]int {
	var r [3]int
	return r
}

type W9[U any] struct {
	a [len(mk2[*N, U]())]uint8
}

func fwd2[V Eq[[8]uint8]](v V) int {
	return inner[V, int64](v)
}

func f6[V Eq[[8]uint8], U any](v V) int {
	return inner[V, U](v)
}

type W3[V Eq[[sizeof(U)]uint8], U any, X any] struct {
	g *G[V, X]
}

func s3[X any](w *W3[*N, int64, X]) int {
	return 2
}

func gb[U any](b *Box[U]) int {
	return inner[*Box[U], U](b)
}

func gj[U any](n *N8) int {
	return inner[*N8, U](n)
}

type G1[A any] struct {
	a A
}

type R[A any] struct {
	a A
}

func (r *R[A]) eq(o [8]uint8) int {
	return len(o) + 3
}

type R8 = R[[8]uint8]

impl *R8 : Eq[[8]uint8]

func gr[U any](r *R[[sizeof(U)]uint8]) int {
	return inner[*R[[sizeof(U)]uint8], int64](r)
}

func asg[U any]() int {
	var a [sizeof(U)]*G1[[sizeof(U)]uint8]
	var b [8]*G1[[8]uint8] = a
	return len(b)
}

func main() {
	var n N
	testing.Println(fwd[int32](&n))
	var w W[int32]
	_ = w
	testing.Println(fA[int32](nil))
	var h *Hh[int16]
	_ = h
	var ga *GA[uint16]
	_ = ga
	testing.Println(f6[*N, uint32](&n))
	testing.Println(s3[uint8](nil))
	var b Box[int32]
	testing.Println(gb[int32](&b))
	var n8 N8
	testing.Println(gj[int32](&n8))
	var w9 W9[int16]
	testing.Println(len(w9.a))
	var r R[[4]uint8]
	testing.Println(gr[int32](&r))
	testing.Println(asg[int32]())
}
