package "main"

import "pkg/builtins/testing"

// gen.mono.check / gen.satisfy: a generic's own check still rejects a type
// argument that fails its constraint whatever lengths its type parameters give:
// an element type that differs (Eq[[sizeof(U)]uint16] against *N's
// Eq[[8]uint8]), and a type parameter with no bound.

interface Eq[T any] {
	eq(o T) int
}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : Eq[[8]uint8]

func inner[T Eq[[sizeof(U)]uint8], U any](t T) int {
	var o [sizeof(U)]uint8
	return t.eq(o)
}

type G[T Eq[[sizeof(U)]uint8], U any] struct {
	t T
}

type K2[B any, A Eq[B]] struct {
	a A
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) eq(o [8]uint8) int {
	return len(o) + 1
}

impl *Box[K] : Eq[[8]uint8]

interface J8 : Eq[[8]uint8] {}

type N8 struct {
	v int
}

func (n *N8) eq(o [8]uint8) int {
	return len(o) + 2
}

impl *N8 : J8

func inner16[T Eq[[sizeof(U)]uint16], U any](t T) int {
	return 1
}

func e16[U any](n *N) int {
	return inner16[*N, U](n)
}

func e7[V any, U any](v V) int {
	return inner[V, U](v)
}

func main() {
	testing.Println(0)
}
