package "main"

import "pkg/builtins/testing"

// gen.mono.check: identity and assignability compare an instance by its type
// arguments, so they depend on a length that depends on a type parameter when
// an instance's argument holds one: *G1[[sizeof(U)]uint8] is *G1[[8]uint8] for
// U = int64 only.  A generic's own check leaves them to each instantiation --
// an assignment (f1, through a managed pointer mg, an interface value of an
// instance ie), `==` (f2) and `same` (f3) -- and each instance judges them with
// the lengths known: at int64 all are valid.

interface Eq[T any] {
	eq(o T) int
}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : Eq[[8]uint8]

type G1[A any] struct {
	a A
}

func f1[U any](q *G1[[8]uint8]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func f2[U any](q *G1[[8]uint8], p *G1[[sizeof(U)]uint8]) bool {
	return p == q
}

func f3[U any](q *([8]uint8), p *([sizeof(U)]uint8)) bool {
	return same(p, q)
}

func ie[U any](f *Eq[[sizeof(U)]uint8]) int {
	var e *Eq[[8]uint8] = f
	return e.eq([8]uint8{})
}

func mg[U any](q @G1[[8]uint8]) int {
	var p @G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func main() {
	var g G1[[8]uint8]
	testing.Println(f1[int64](&g))
	testing.Println(f2[int64](&g, &g))
	testing.Println(f3[int64](&g.a, &g.a))
	var n N
	var f *Eq[[8]uint8] = &n
	testing.Println(ie[int64](f))
	var m @G1[[8]uint8] = make(G1[[8]uint8])
	testing.Println(mg[int64](m))
}
