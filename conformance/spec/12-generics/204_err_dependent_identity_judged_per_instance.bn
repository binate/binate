package "main"

import "pkg/builtins/testing"

// gen.mono.check: as 203, the generics' instances at int32, where the lengths
// differ: each is rejected in the instance, naming it -- ie's an assignment of a
// *Eq[[4]uint8] to a *Eq[[8]uint8].

interface Eq[T any] {
	eq(o T) int
}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : Eq[[8]uint8]

type G1[A any] struct {
	a A
}

func f1[U any](q *G1[[8]uint8]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func f2[U any](q *G1[[8]uint8], p *G1[[sizeof(U)]uint8]) bool {
	return p == q
}

func f3[U any](q *([8]uint8), p *([sizeof(U)]uint8)) bool {
	return same(p, q)
}

func ie[U any](f *Eq[[sizeof(U)]uint8]) int {
	var e *Eq[[8]uint8] = f
	return e.eq([8]uint8{})
}

func mg[U any](q @G1[[8]uint8]) int {
	var p @G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

type N4 struct {
	v int
}

func (n *N4) eq(o [4]uint8) int {
	return n.v + len(o)
}

impl *N4 : Eq[[4]uint8]

func main() {
	var g G1[[8]uint8]
	var h G1[[4]uint8]
	testing.Println(f1[int32](&g))
	testing.Println(f2[int32](&g, &h))
	testing.Println(f3[int32](&g.a, &h.a))
	var n4 N4
	var f4 *Eq[[4]uint8] = &n4
	testing.Println(ie[int32](f4))
	var m @G1[[8]uint8] = make(G1[[8]uint8])
	testing.Println(mg[int32](m))
}
