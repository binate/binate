package "main"

import "pkg/builtins/testing"

// gen.mono.check: a generic's own check still rejects what differs whatever
// lengths its type parameters give: an element type (G1[[8]uint16] against
// G1[[sizeof(U)]uint8]) and another generic (G2 against G1).

interface Eq[T any] {
	eq(o T) int
}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : Eq[[8]uint8]

type G1[A any] struct {
	a A
}

type G2[A any] struct {
	a A
}

func f4[U any](q *G1[[8]uint16]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func f5[U any](q *G2[[8]uint8]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func main() {
	testing.Println(0)
}
