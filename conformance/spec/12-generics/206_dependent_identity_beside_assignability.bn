package "main"

import "pkg/builtins/testing"

// gen.mono.check: a generic's own check leaves to each instantiation an
// identity that depends on a length depending on a type parameter where it is
// compared beside plain assignability too: adding `readonly` (r1, r2, r3, and
// `same` across it, s1), a function value's signature (v1 from a function, v3,
// v4, v5 between function values) and a managed -> raw borrow (d1, d2, d3).
// Each instance judges it with the lengths known: at int64 all are valid.

type G1[A any] struct {
	a A
}

func take8(q *G1[[8]uint8]) int {
	return len(q.a)
}

func r1[U any](q *G1[[8]uint8]) int {
	var p *readonly G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func r2[U any](q *([8]uint8)) int {
	var p *(readonly [sizeof(U)]uint8) = q
	return len(*p)
}

func r3[U any](q *G1[[8]uint8]) int {
	var p readonly *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func s1[U any](q *G1[[8]uint8], p *readonly G1[[sizeof(U)]uint8]) bool {
	return same(q, p)
}

func v1[U any](q *G1[[8]uint8]) int {
	var fv *func(*G1[[sizeof(U)]uint8]) int = take8
	return 1
}

func v3[U any](a *func(*([8]uint8)) int) int {
	var fv *func(*([sizeof(U)]uint8)) int = a
	return 3
}

func v4[U any](a *func(G1[[8]uint8]) int) int {
	var fv *func(G1[[sizeof(U)]uint8]) int = a
	return 4
}

func v5[U any](a *func() *G1[[8]uint8]) int {
	var fv *func() *G1[[sizeof(U)]uint8] = a
	return 5
}

func d1[U any](q @G1[[8]uint8]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func d2[U any](q @([8]uint8)) int {
	var p *([sizeof(U)]uint8) = q
	return len(*p)
}

func d3[U any](q @[]G1[[8]uint8]) int {
	var p *[]G1[[sizeof(U)]uint8] = q
	return len(p)
}

func ga(g G1[[8]uint8]) int {
	return len(g.a)
}

func arr(a *([8]uint8)) int {
	return len(*a)
}

func mk() *G1[[8]uint8] {
	return nil
}

func main() {
	var g G1[[8]uint8]
	testing.Println(r1[int64](&g))
	testing.Println(r2[int64](&g.a))
	testing.Println(r3[int64](&g))
	testing.Println(s1[int64](&g, &g))
	testing.Println(v1[int64](&g))
	testing.Println(v3[int64](arr))
	testing.Println(v4[int64](ga))
	testing.Println(v5[int64](mk))
	var m @G1[[8]uint8] = make(G1[[8]uint8])
	testing.Println(d1[int64](m))
	var a @([8]uint8) = make([8]uint8)
	testing.Println(d2[int64](a))
	var sl @[]G1[[8]uint8] = make_slice(G1[[8]uint8], 3)
	testing.Println(d3[int64](sl))
}
