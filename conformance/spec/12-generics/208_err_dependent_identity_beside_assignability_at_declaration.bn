package "main"

import "pkg/builtins/testing"

// gen.mono.check: a generic's own check still rejects what differs whatever
// lengths its type parameters give: `readonly` in an instance's type argument
// (part of the instance's identity), a `readonly` dropped, and an element type
// that differs, through a function value's signature and a borrow.

type G1[A any] struct {
	a A
}

func k1[U any](q *G1[readonly [8]uint8]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func k2[U any](q *readonly G1[[8]uint8]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func k3[U any](a *func(*G1[[8]uint16]) int) int {
	var fv *func(*G1[[sizeof(U)]uint8]) int = a
	return 0
}

func k4[U any](q @G1[[8]uint16]) int {
	var p *G1[[sizeof(U)]uint8] = q
	return len(p.a)
}

func main() {
	testing.Println(0)
}
