package "main"

import "pkg/builtins/testing"

// gen.mono.check: whether a parameterized impl's methods cover its interface
// depends on a length that depends on a type parameter when the interface's type
// argument holds one: Box[K]'s `eq(o [8]uint8)` covers Eq[[sizeof(K)]uint8] for
// K = int64 only.  The impl's own check leaves it to each instance of it, which
// judges it with the length known: Box[int64]'s impl is valid -- as an
// interface value, in a generic's body (h) and through a constraint (h2).

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) eq(o [8]uint8) int {
	return len(o) + 1
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func h[V any](b *Box[V]) int {
	var e *Eq[[sizeof(V)]uint8] = b
	var o [sizeof(V)]uint8
	return e.eq(o)
}

func need[T Eq[[sizeof(V)]uint8], V any](t T) int {
	return 9
}

func h2[V any](b *Box[V]) int {
	return need[*Box[V], V](b)
}

func main() {
	var b Box[int64]
	var e *Eq[[8]uint8] = &b
	testing.Println(e.eq([8]uint8{}))
	testing.Println(h[int64](&b))
	testing.Println(h2[int64](&b))
}
