package "main"

import "pkg/builtins/testing"

// gen.mono.check: as 209, Box[int32]'s impl -- whose `eq(o [8]uint8)` does not
// cover Eq[[4]uint8] -- is rejected where the instance is formed, naming the
// impl's instance, however it is reached.

interface Eq[T any] {
	eq(o T) int
}

type Box[K any] struct {
	k K
}

func (b *Box[K]) eq(o [8]uint8) int {
	return len(o) + 1
}

impl *Box[K] : Eq[[sizeof(K)]uint8]

func h[V any](b *Box[V]) int {
	var e *Eq[[sizeof(V)]uint8] = b
	var o [sizeof(V)]uint8
	return e.eq(o)
}

func need[T Eq[[sizeof(V)]uint8], V any](t T) int {
	return 9
}

func h2[V any](b *Box[V]) int {
	return need[*Box[V], V](b)
}

func main() {
	var b Box[int32]
	testing.Println(h[int32](&b))
	testing.Println(h2[int32](&b))
}
