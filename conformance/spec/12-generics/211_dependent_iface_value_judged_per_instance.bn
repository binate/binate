package "main"

import "pkg/builtins/testing"

// gen.mono.check: whether a type implements an interface, or an interface
// extends another, compares interface instances by their type arguments, so it
// depends on a length that depends on a type parameter when an argument holds
// one: *N implements Eq[[sizeof(U)]uint8] (through J[int64]) for U = int64 only.
// A generic's own check leaves it to each instantiation -- a pointer to an
// interface value (iv), an upcast (up), the managed -> raw decay (dc) -- as it
// does two parents that are one placeholder instance there (KP2's
// Tag[[sizeof(U)]uint8] and Tag[[sizeof(X)]uint8]) and two inherited methods
// whose signatures differ only there (KU's m from A1[[sizeof(U)]uint8] and
// B1[[8]uint8]); each instance judges it with the lengths known: at int64 all
// are valid, as are KP2[int64, int32] and KU[int64] -- and an interface value
// built by a value borrow (vb), through a parameterized impl (gb), a managed
// one (mg) and a managed upcast (jup, at int32).

interface Eq[T any] {
	eq(o T) int
}

interface J[U any] : Eq[[sizeof(U)]uint8] {}

interface Tag[T any] {
	tag() int
}

interface KP2[U any, X any] : Tag[[sizeof(U)]uint8], Tag[[sizeof(X)]uint8] {}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : J[int64]

type N4 struct {
	v int
}

func (n *N4) eq(o [4]uint8) int {
	return n.v + len(o)
}

impl *N4 : J[int32]

func iv[U any](n *N) int {
	var e *Eq[[sizeof(U)]uint8] = n
	var o [sizeof(U)]uint8
	return e.eq(o)
}

func up[U any](j *J[U]) int {
	var e *Eq[[8]uint8] = j
	return e.eq([8]uint8{})
}

func dc[U any](m @Eq[[sizeof(U)]uint8]) int {
	var e *Eq[[8]uint8] = m
	return e.eq([8]uint8{})
}

type Box[T any] struct {
	v int
}

func (b *Box[T]) eq(o [sizeof(T)]uint8) int {
	return b.v + len(o)
}

impl *Box[T] : Eq[[sizeof(T)]uint8]

func vb[U any](n N) int {
	var e *Eq[[sizeof(U)]uint8] = n
	var o [sizeof(U)]uint8
	return e.eq(o)
}

func gb[U any](b *Box[U]) int {
	var e *Eq[[8]uint8] = b
	return e.eq([8]uint8{})
}

func mg[U any](b @Box[U]) int {
	var e @Eq[[8]uint8] = b
	var r *Eq[[8]uint8] = e
	return r.eq([8]uint8{}) + e.eq([8]uint8{})
}

func jup[U any](j @J[U]) int {
	var r *J[U] = j
	var e *Eq[[4]uint8] = r
	var m @Eq[[4]uint8] = j
	return e.eq([4]uint8{}) + m.eq([4]uint8{})
}

interface A1[T any] {
	m(x T) int
}

interface B1[T any] {
	m(x T) int
}

interface KU[U any] : A1[[sizeof(U)]uint8], B1[[8]uint8] {}

type P struct {
	v int
}

func (p *P) m(x [8]uint8) int {
	return p.v + len(x)
}

impl *P : KU[int64]

func main() {
	var n N
	testing.Println(iv[int64](&n))
	var j *J[int64] = &n
	testing.Println(up[int64](j))
	var mn @N = make(N)
	var m @Eq[[8]uint8] = mn
	testing.Println(dc[int64](m))
	var k *KP2[int64, int32]
	_ = k
	testing.Println(1)
	n.v = 100
	testing.Println(vb[int64](n))
	var b Box[int64]
	b.v = 200
	testing.Println(gb[int64](&b))
	var mb @Box[int64] = make(Box[int64])
	mb.v = 300
	testing.Println(mg[int64](mb))
	var n4 @N4 = make(N4)
	n4.v = 400
	testing.Println(jup[int32](n4))
	var p P
	p.v = 10
	var ku *KU[int64] = &p
	testing.Println(ku.m([8]uint8{}))
}
