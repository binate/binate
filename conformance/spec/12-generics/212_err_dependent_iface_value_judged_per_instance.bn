package "main"

import "pkg/builtins/testing"

// gen.mono.check: as 211, the instances at int32, KP2[int64, int64], whose two
// parents are one instance, and KU[int32], whose inherited m's differ: each is
// rejected where the instance is formed, naming it.

interface Eq[T any] {
	eq(o T) int
}

interface J[U any] : Eq[[sizeof(U)]uint8] {}

interface Tag[T any] {
	tag() int
}

interface KP2[U any, X any] : Tag[[sizeof(U)]uint8], Tag[[sizeof(X)]uint8] {}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : J[int64]

type N4 struct {
	v int
}

func (n *N4) eq(o [4]uint8) int {
	return n.v + len(o)
}

impl *N4 : J[int32]

func iv[U any](n *N) int {
	var e *Eq[[sizeof(U)]uint8] = n
	var o [sizeof(U)]uint8
	return e.eq(o)
}

func up[U any](j *J[U]) int {
	var e *Eq[[8]uint8] = j
	return e.eq([8]uint8{})
}

func dc[U any](m @Eq[[sizeof(U)]uint8]) int {
	var e *Eq[[8]uint8] = m
	return e.eq([8]uint8{})
}

type Box[T any] struct {
	v int
}

func (b *Box[T]) eq(o [sizeof(T)]uint8) int {
	return b.v + len(o)
}

impl *Box[T] : Eq[[sizeof(T)]uint8]

func vb[U any](n N) int {
	var e *Eq[[sizeof(U)]uint8] = n
	var o [sizeof(U)]uint8
	return e.eq(o)
}

func gb[U any](b *Box[U]) int {
	var e *Eq[[8]uint8] = b
	return e.eq([8]uint8{})
}

func mg[U any](b @Box[U]) int {
	var e @Eq[[8]uint8] = b
	var r *Eq[[8]uint8] = e
	return r.eq([8]uint8{}) + e.eq([8]uint8{})
}

func jup[U any](j @J[U]) int {
	var r *J[U] = j
	var e *Eq[[4]uint8] = r
	var m @Eq[[4]uint8] = j
	return e.eq([4]uint8{}) + m.eq([4]uint8{})
}

interface A1[T any] {
	m(x T) int
}

interface B1[T any] {
	m(x T) int
}

interface KU[U any] : A1[[sizeof(U)]uint8], B1[[8]uint8] {}

type P struct {
	v int
}

func (p *P) m(x [8]uint8) int {
	return p.v + len(x)
}

impl *P : KU[int64]

func main() {
	var n N
	testing.Println(iv[int32](&n))
	var n4 N4
	var j *J[int32] = &n4
	testing.Println(up[int32](j))
	var mn @N4 = make(N4)
	var m @Eq[[4]uint8] = mn
	testing.Println(dc[int32](m))
	var k *KP2[int64, int64]
	_ = k
	testing.Println(vb[int32](n))
	var b Box[int32]
	testing.Println(gb[int32](&b))
	testing.Println(mg[int32](make(Box[int32])))
	var ku *KU[int32]
	_ = ku
}
