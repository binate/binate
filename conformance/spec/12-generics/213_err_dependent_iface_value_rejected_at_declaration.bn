package "main"

import "pkg/builtins/testing"

// gen.mono.check: a generic's own check still rejects an interface value that
// fails whatever lengths its type parameters give -- another generic interface
// (Eq2), a `readonly` receiver (ro), a raw interface value to a managed one (rm)
// -- and non-generic code judges as ever (*N does not implement Eq[[4]uint8]).

interface Eq[T any] {
	eq(o T) int
}

interface J[U any] : Eq[[sizeof(U)]uint8] {}

interface Tag[T any] {
	tag() int
}

interface KP2[U any, X any] : Tag[[sizeof(U)]uint8], Tag[[sizeof(X)]uint8] {}

type N struct {
	v int
}

func (n *N) eq(o [8]uint8) int {
	return n.v + len(o)
}

impl *N : J[int64]

type N4 struct {
	v int
}

func (n *N4) eq(o [4]uint8) int {
	return n.v + len(o)
}

impl *N4 : J[int32]

func iv[U any](n *N) int {
	var e *Eq[[sizeof(U)]uint8] = n
	var o [sizeof(U)]uint8
	return e.eq(o)
}

func up[U any](j *J[U]) int {
	var e *Eq[[8]uint8] = j
	return e.eq([8]uint8{})
}

func dc[U any](m @Eq[[sizeof(U)]uint8]) int {
	var e *Eq[[8]uint8] = m
	return e.eq([8]uint8{})
}

interface Eq2[T any] {
	eq(o T) int
}

func o1[U any](n *N) int {
	var e *Eq2[[sizeof(U)]uint8] = n
	_ = e
	return 1
}

func o2() int {
	var n N
	var e *Eq[[4]uint8] = &n
	_ = e
	return 2
}

func ro[U any](r *readonly N) int {
	var e *Eq[[sizeof(U)]uint8] = r
	_ = e
	return 3
}

func rm[U any](e *Eq[[sizeof(U)]uint8]) int {
	var m @Eq[[8]uint8] = e
	_ = m
	return 4
}

func main() {
	testing.Println(0)
}
