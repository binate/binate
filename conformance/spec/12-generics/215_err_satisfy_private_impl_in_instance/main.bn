package "main"

import "pkg/builtins/testing"
import "pkg/r3dep"
import "pkg/r3lib"

// gen.mono.check, gen.satisfy, pkg.export: r3dep's .bn names these instances
// first, and *T satisfies the constraints they form there through r3dep's
// private impl; main names them too, where the impl is not visible: in each
// instance, *T does not satisfy Tag[[4]uint8].
func main() {
	var t r3dep.T
	var h r3lib.H[*r3dep.T, int64]
	testing.Println(r3dep.run())
	testing.Println(r3lib.outer[*r3dep.T, int64, int32](&t))
	testing.Println(h.zero())
	testing.Println(r3lib.sig[*r3dep.T, int64](nil))
}
