package "main"

import "pkg/builtins/testing"
import "pkg/r3dep"
import "pkg/r3lib"

// gen.mono.check, gen.satisfy, pkg.export: main names deep's instance, whose
// body names outer's, whose body names inner's: *T does not satisfy inner's
// constraint Tag[[4]uint8] in main's chain, though it does in r3dep's, where the
// impl is visible.
func main() {
	var t r3dep.T
	testing.Println(r3dep.run())
	testing.Println(r3lib.deep[*r3dep.T, int64, int32](&t))
}
