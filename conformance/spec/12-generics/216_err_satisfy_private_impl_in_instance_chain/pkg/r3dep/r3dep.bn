package "pkg/r3dep"

import "pkg/r3lib"

// Private to r3dep's .bn: *T is a Tag[[4]uint8] only here.
impl *T : r3lib.Tag[[4]uint8]

func (t *T) tag() int {
	return 5
}

// g is private to r3dep's .bn: the instances its instance names are r3dep's
// chains too.
func g[Z any]() int {
	var t T
	return r3lib.outer[*T, int64, int32](&t)
}

func run() int {
	var t T
	var h r3lib.H[*T, int64]
	var w *r3lib.W[*T, int32]
	return r3lib.outer[*T, int64, int32](&t) + g[int]() + r3lib.deep[*T, int64, int32](&t) + h.zero() +
			r3lib.sig[*T, int64](w)
}
