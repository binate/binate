package "pkg/r3lib"

interface Tag[T any] {
	tag() int
}

// inner needs Tag[[sizeof(X)]uint8]: for X int32, Tag[[4]uint8].
func inner[T Tag[[sizeof(X)]uint8], X any](t T) int {
	return t.tag()
}

// outer is checked with its own lengths as placeholders, so whether inner's
// constraint holds is judged in each instance.
func outer[V Tag[[sizeof(U)]uint8], U any, X any](v V) int {
	return inner[V, X](v)
}

// deep names outer, which names inner: a chain of instances.
func deep[V Tag[[sizeof(U)]uint8], U any, X any](v V) int {
	return outer[V, U, X](v) + 1
}

type W[T Tag[[sizeof(X)]uint8], X any] struct {
	t T
}

// H's field forms W[V, int32]: whether V satisfies W's constraint is judged in
// each instance of H.
type H[V Tag[[sizeof(U)]uint8], U any] struct {
	w *W[V, int32]
}

func (h *H[V, U]) zero() int {
	return 0
}

// sig's signature forms W[V, int32].
func sig[V Tag[[sizeof(U)]uint8], U any](p *W[V, int32]) int {
	return 0
}
