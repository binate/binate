package "pkg/lib"

interface Tag[X any] {
	tag() int
}

type W[V Tag[[sizeof(X)]uint8], X any] struct {
	v V
}

type HW[V Tag[[sizeof(U)]uint8], U any] struct {
	w *W[V, int32]
}

type T struct {
	n int
}

func (t @T) tag() int

impl @T : Tag[[8]uint8]

interface HolderOf[Q any] {
	hold() *Q
}

func run() int
