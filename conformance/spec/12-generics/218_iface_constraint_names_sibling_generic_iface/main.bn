package "main"

import "pkg/builtins/testing"
import "pkg/glib"

// gen.constraint, gen.crosspkg.body: the constraint of glib's Getter names Tag,
// the generic interface glib declares beside it, so instantiated here it still
// means glib's Tag, which *X satisfies.

type X struct {
	a int
}

impl *X : glib.Tag[[8]uint8]

func (x *X) tag() int {
	return x.a
}

type Y struct {
	x X
}

impl *Y : glib.Getter[*X]

func (y *Y) get() *X {
	return &y.x
}

func main() {
	var y Y
	y.x.a = 5
	var g *glib.Getter[*X] = &y
	testing.Println(g.get().tag())
	testing.Println(glib.tagOf[*X](g))
}
