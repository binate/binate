package "main"

import "pkg/glib"

// gen.constraint, gen.satisfy: the constraint of glib's Getter names Tag, the
// generic interface glib declares beside it; *Z implements no Tag[[8]uint8], so
// it is no type argument of Getter.

type Z struct {
	a int
}

func main() {
	var g *glib.Getter[*Z]
	_ = g
}
