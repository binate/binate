package "main"

import "pkg/app"
import "pkg/builtins/testing"

// gen.constraint, gen.satisfy: the constraint of glib's Getter names Tag, the
// generic interface glib declares beside it, so instantiated in pkg/app, whose
// .bni declares a Tag of its own, it means glib's Tag, which *X does not
// implement: an impl of app's Tag does not satisfy it.
func main() {
	testing.Println(app.run())
}
