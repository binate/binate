package "main"

import "pkg/builtins/testing"
import "pkg/r3dep"
import "pkg/r3lib"

// gen.mono.check, gen.satisfy, iface.self.constraint: r3dep's .bn names
// instances of r3lib's generic interfaces in which *T must satisfy
// Tag[[4]uint8], through r3dep's private impl: in a method signature, a parent
// and a function instance's signature; each is rooted in r3dep's .bn, where the
// impl is visible.  main names S[*T, int64] too: its method's G[Self, int64] is
// judged again in main, Self bounded by the instance and its parent.
func main() {
	var s *r3lib.S[*r3dep.T, int64]
	_ = s
	testing.Println(r3dep.run())
}
