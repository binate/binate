package "pkg/r3dep"

import "pkg/r3lib"

// Private to r3dep's .bn: *T is a Tag[[4]uint8] only here.
impl *T : r3lib.Tag[[4]uint8]

func (t *T) tag() int {
	return 5
}

func run() int {
	var i *r3lib.I[*T, int64]
	var p *r3lib.P[*T, int64]
	var s *r3lib.S[*T, int64]
	_ = i
	_ = p
	_ = s
	return r3lib.useI[*T, int64]() + 7
}
