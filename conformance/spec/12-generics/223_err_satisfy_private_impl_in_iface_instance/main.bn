package "main"

import "pkg/builtins/testing"
import "pkg/r3dep"
import "pkg/r3lib"

// gen.mono.check, gen.satisfy, pkg.export: r3dep's .bn names these interface
// instances first, and *T satisfies the constraints their method signature and
// parent form there through r3dep's private impl; main names them too, where
// the impl is not visible: in each instance, *T does not satisfy Tag[[4]uint8].
func main() {
	var i *r3lib.I[*r3dep.T, int64]
	var p *r3lib.P[*r3dep.T, int64]
	_ = i
	_ = p
	testing.Println(r3dep.run())
}
