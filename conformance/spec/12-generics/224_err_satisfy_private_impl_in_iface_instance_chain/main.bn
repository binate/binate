package "main"

import "pkg/builtins/testing"
import "pkg/r3dep"
import "pkg/r3lib"

// gen.mono.check, gen.satisfy, pkg.export: useI[*T, int64]'s body names I[*T,
// int64], in a chain rooted in main, where r3dep's private impl is not visible,
// though r3dep's .bn named the same instances first.
func main() {
	testing.Println(r3lib.useI[*r3dep.T, int64]())
	testing.Println(r3dep.run())
}
