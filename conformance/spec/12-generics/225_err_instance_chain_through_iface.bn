package "main"

import "pkg/builtins/testing"

// gen.mono.instances: Box[int]'s next names I[@int], whose method names
// Box[@int], whose next names I[@@int], and so on: a chain through bodies and
// an interface instance's method signature, each instance a link of it.

interface I[T any] {
	get() *Box[T]
}

type Box[T any] struct {
	v T
}

func (b *Box[T]) next() int {
	var i *I[@T]
	_ = i
	return 0
}

func main() {
	var b Box[int]
	testing.Println(b.next())
}
