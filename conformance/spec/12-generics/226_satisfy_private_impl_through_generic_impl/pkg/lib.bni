package "pkg/lib"

import "pkg/builtins/lang"

// A policy interface and a parameterized impl of it, as std/hash's Default.
interface Hasher[K any] {
	Hash(k K) uint
}

type Default[K lang.Hashable] struct {}

func (h Default[K]) Hash(k K) uint { return k.Hash() }

impl Default[K] : Hasher[K]

// A container whose policy parameter is satisfied through that impl.
type Table[K lang.Hashable, H Hasher[K]] struct {
	h H
	k K
}

func (t @Table[K, H]) Sum() uint { return t.h.Hash(t.k) }
