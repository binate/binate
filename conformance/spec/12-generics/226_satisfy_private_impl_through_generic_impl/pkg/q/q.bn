package "pkg/q"

import "pkg/builtins/lang"
import "pkg/lib"

// key satisfies lang.Hashable only in q's .bn: the impl is private to it.
type key struct {
	n int
}

func (a key) Hash() uint { return cast(uint, a.n) }

func (a key) Compare(b key) int { return a.n - b.n }

impl key : lang.Hashable

// Default[key] satisfies Hasher[key] through the parameterized impl, resolved
// for key in q's view: at a package-level variable's type, checked once the
// package's declarations are collected, ...
var tab @lib.Table[key, lib.Default[key]]

func Count() int {
	if tab == nil { tab = make(lib.Table[key, lib.Default[key]]) }
	tab.k.n = 7
	return cast(int, tab.Sum())
}

// ... and at a use outside any instance.
func Local() int {
	var t @lib.Table[key, lib.Default[key]] = make(lib.Table[key, lib.Default[key]])
	t.k.n = 5
	return cast(int, t.Sum())
}
