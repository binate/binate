package "pkg/lib"

interface Tag[X any] {
	tag() int
}

// K's constraint depends on its second argument: K[@T, int32] needs a
// Tag[[4]uint8], K[@T, int64] a Tag[[8]uint8].
type K[V Tag[[sizeof(U)]uint8], U any] struct {
	v V
}

// KT's target is as if written where KT is used.
type KT[U any] = K[@T, U]

type T struct {
	n int
}

func (t @T) tag() int

impl @T : Tag[[8]uint8]

func Own() int
