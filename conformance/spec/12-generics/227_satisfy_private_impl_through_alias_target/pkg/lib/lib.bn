package "pkg/lib"

func (t @T) tag() int { return t.n }

// T is a Tag[[4]uint8] only in lib's .bn.
impl @T : Tag[[4]uint8]

// Used here, KT[int32] is K[@T, int32] written here, which T satisfies through
// the private impl.
func Own() int {
	var k KT[int32]
	k.v = make(T)
	k.v.n = 4
	return k.v.tag()
}
