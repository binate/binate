package "pkg/q"

import "pkg/lib"

// O is opaque to q's importers; its layout is q's .bn's.
type O struct {
	n int
}

type QH struct {
	n int
}

func (p *QH) hk() int { return 3 }

impl *QH : lib.Hk[*lib.Box[O]]

// The Box[O] that CF's constraint forms for this call is named here, where O's
// layout is known: q lends it, as it does to `lib.Box[O]` written here.
func Run() int {
	var h QH
	return lib.CF[O, *QH](&h)
}
