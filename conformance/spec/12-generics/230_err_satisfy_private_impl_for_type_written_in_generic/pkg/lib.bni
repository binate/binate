package "pkg/lib"

interface Tag[X any] {
	tag() int
}

// In's constraint depends on its second argument: In[V, int32] needs a
// Tag[[4]uint8].
func In[V Tag[[sizeof(X)]uint8], X any](v V) int {
	return v.tag()
}

type T struct {
	n int
}

func (t @T) tag() int

impl @T : Tag[[8]uint8]

// Out writes @T itself, so In's constraint on it is judged here, in lib's .bni,
// where T is a Tag[[8]uint8] only.
func Out[V any, X any](v V) int {
	return In[@T, X](make(T))
}

func Run() int
