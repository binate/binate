package "pkg/lib"

func (t @T) tag() int { return t.n }

// T is a Tag[[4]uint8] only in lib's .bn.
impl @T : Tag[[4]uint8]

// Out[@T, int32] needs the @T that Out writes to be a Tag[[4]uint8]; the private
// impl does not serve it, though the type arguments named here mention T.
func Run() int { return Out[@T, int32](make(T)) }
