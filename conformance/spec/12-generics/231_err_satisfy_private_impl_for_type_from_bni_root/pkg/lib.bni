package "pkg/lib"

interface Tag[X any] {
	tag() int
}

// In's constraint depends on its second argument: In[V, int32] needs a
// Tag[[4]uint8].
func In[V Tag[[sizeof(X)]uint8], X any](v V) int {
	return v.tag()
}

type T struct {
	n int
}

func (t @T) tag() int

impl @T : Tag[[8]uint8]

type W[Q Tag[[8]uint8], Y any] struct {
	q Q
}

// W[@T, int32] is named here, so the @T it supplies is judged here, in lib's
// .bni, where T is a Tag[[8]uint8] only.
type Holder struct {
	w @W[@T, int32]
}

func Run() int
