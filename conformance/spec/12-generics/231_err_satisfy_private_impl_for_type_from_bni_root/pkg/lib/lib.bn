package "pkg/lib"

func (t @T) tag() int { return t.n }

// T is a Tag[[4]uint8] only in lib's .bn.
impl @T : Tag[[4]uint8]

// m is checked for W[@T, int32], whose root is in lib's .bni: In[Q, Y] needs the
// @T that root supplies to be a Tag[[4]uint8], and the private impl does not
// serve it, though m is written here.
func (w @W[Q, Y]) m() int { return In[Q, Y](w.q) }

func Run() int { return 1 }
