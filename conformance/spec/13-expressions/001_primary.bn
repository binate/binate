package "main"

// expr.primary: operands are literals, identifiers/selectors, parenthesized
// expressions, builtin calls, and composite literals; postfix .  []  ()  apply.
func id(x int) int { return x }

func main() {
	var ok bool = true
	if !((1 + 2) == 3) { ok = false }          // parenthesized expression
	if !(id(40) + 2 == 42) { ok = false }       // call result, then binary +
	if !(len("ab") == 2) { ok = false }         // builtin call on a string literal
	if ok { println("ok") } else { println("FAIL") }
}
