package "main"
import "pkg/builtins/testing"

// expr.precedence: the Go model — *,/ tighter than +,- ; bitwise and shift
// tighter than comparison (so `a & b == c` is `(a & b) == c`, unlike C);
// && tighter than ||. (Unary precedence is exercised by 020/033.)
func main() {
	var ok bool = true
	if !(1 + 2 * 3 == 7) { ok = false }          // * over +
	if !((1 + 2) * 3 == 9) { ok = false }        // parentheses override
	if !(6 & 3 == 2) { ok = false }              // & over == : (6&3)==2
	if !(1 << 2 == 4) { ok = false }             // << over == : (1<<2)==4
	if !(true || false && false) { ok = false }  // && over || : true||(F&&F)
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
