package "main"

// expr.arith.defined: integer / truncates toward zero, % takes the sign of
// the dividend, and signed +/-/* overflow is defined two's-complement wrap.
// Checked with BOTH constant operands (the folder) and runtime operands
// routed through functions (the division codegen path).
func neg7() int { return -7 }
func two() int { return 2 }
func seven() int { return 7 }
func negtwo() int { return -2 }

func main() {
	var ok bool = true
	if -7 / 2 != -3 { ok = false }                  // const fold: truncate toward zero
	if -7 % 2 != -1 { ok = false }                  // const fold: sign of dividend
	if neg7() / two() != -3 { ok = false }          // runtime: truncate toward zero
	if neg7() % two() != -1 { ok = false }          // runtime: sign of dividend
	if seven() % negtwo() != 1 { ok = false }
	var x int8 = 127
	x = x + 1                                        // defined wraparound, no trap
	if x != -128 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
