package "main"

// expr.arith.defined: integer / truncates toward zero, % takes the sign of
// the dividend, and signed +/-/* overflow is defined two's-complement wrap.
func main() {
	var ok bool = true
	if -7 / 2 != -3 { ok = false }      // truncate toward zero (not -4)
	if -7 % 2 != -1 { ok = false }      // remainder takes the dividend's sign
	if 7 % -2 != 1 { ok = false }
	var x int8 = 127
	x = x + 1                            // defined wraparound, no trap
	if x != -128 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
