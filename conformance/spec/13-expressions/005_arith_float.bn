package "main"
import "pkg/builtins/testing"

// expr.arith.float: IEEE-754 +,-,*,/ — no panic; division by zero yields ±∞.
// The divisor is a runtime value so the result is not constant-folded.
func zerof() float64 { return 0.0 }

func main() {
	var ok bool = true
	var inf float64 = 1.0 / zerof()
	var ninf float64 = -1.0 / zerof()
	if !(inf > 0.0 && inf * 2.0 == inf) { ok = false }     // +∞: doubling is a no-op
	if !(ninf < 0.0 && ninf * 2.0 == ninf) { ok = false }  // -∞
	if !(1.5 + 2.5 == 4.0) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
