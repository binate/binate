package "main"
import "pkg/builtins/testing"

// expr.arith.divzero: integer / by a runtime zero divisor is a defined,
// non-recoverable panic — not silent UB. The divisor comes from a function
// so the checker cannot fold it to a compile-time error (§6).
func zero() int { return 0 }

func main() {
	var b int = zero()
	testing.Println(10 / b)
}
