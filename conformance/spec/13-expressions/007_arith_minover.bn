package "main"
import "pkg/builtins/testing"

// expr.arith.minover: signed MIN / -1 (the two's-complement overflow case) is
// a defined non-recoverable panic. The divisor is runtime, not constant-folded.
func neg1() int64 { return -1 }

func main() {
	var a int64 = -9223372036854775807 - 1   // int64 MIN
	var b int64 = neg1()
	testing.Println(a / b)
}
