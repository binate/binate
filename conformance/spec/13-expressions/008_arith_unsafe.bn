package "main"
import "pkg/builtins/testing"

// expr.arith.unsafe: unsafe_div / unsafe_rem do the same integer division and
// truncated remainder, but WITHOUT the divide-by-zero and MIN/-1 fault checks.
func main() {
	var ok bool = true
	if unsafe_div(17, 5) != 3 { ok = false }
	if unsafe_rem(17, 5) != 2 { ok = false }
	if unsafe_div(-7, 2) != -3 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
