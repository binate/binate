package "main"
import "pkg/builtins/testing"

// expr.bitwise: &, |, ^ (binary) and ~ (unary complement) on integers; ~ is
// sub-word-correct (the complement of a uint8 is an 8-bit result).
func main() {
	var ok bool = true
	if 6 & 3 != 2 { ok = false }
	if 6 | 1 != 7 { ok = false }
	if 6 ^ 3 != 5 { ok = false }
	if ~0 != -1 { ok = false }                        // int complement
	var u uint8 = 0
	if ~u != cast(uint8, 255) { ok = false }          // 8-bit complement
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
