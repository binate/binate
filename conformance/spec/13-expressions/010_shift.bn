package "main"

// expr.shift: << and >> ; >> is arithmetic (sign-filling) for a signed value
// and logical (zero-filling) for an unsigned value; the result type is the
// value's (left operand) type.
func main() {
	var ok bool = true
	if 1 << 4 != 16 { ok = false }
	if 256 >> 2 != 64 { ok = false }
	var s int = -8
	if s >> 1 != -4 { ok = false }                    // arithmetic (signed)
	var u uint8 = 128
	if u >> 1 != cast(uint8, 64) { ok = false }       // logical (unsigned)
	if ok { println("ok") } else { println("FAIL") }
}
