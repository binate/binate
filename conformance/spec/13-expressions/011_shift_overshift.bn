package "main"

// expr.shift.overshift: a non-negative count >= the value's bit width yields a
// DEFINED result (0 for a logical shift, full sign-fill for arithmetic >>),
// not a hardware-masked one. The count is runtime so the untruncated value is
// what the guard reads.
func width() int { return 64 }

func main() {
	var ok bool = true
	var n int = width()
	var u uint64 = 18446744073709551615   // all ones
	if u >> n != 0 { ok = false }                      // logical overshift -> 0
	var s int64 = -1
	if s >> n != -1 { ok = false }                     // arithmetic overshift -> sign
	var v uint64 = 1
	if v << n != 0 { ok = false }                      // left overshift -> 0
	if ok { println("ok") } else { println("FAIL") }
}
