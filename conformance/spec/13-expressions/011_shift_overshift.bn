package "main"
import "pkg/builtins/testing"

// expr.shift.overshift: a non-negative count >= the value's bit width yields a
// DEFINED result (0 for a logical shift, full sign-fill for arithmetic >>).
// The check reads the UNTRUNCATED count, so a count wider than the value is
// detected — a hardware mask (count & (width-1)) would give the wrong answer.
func width() int { return 64 }

func main() {
	var ok bool = true
	var n int = width()
	var u uint64 = 18446744073709551615   // all ones
	if u >> n != 0 { ok = false }                      // logical overshift -> 0
	var s int64 = -1
	if s >> n != -1 { ok = false }                     // arithmetic overshift -> sign
	var v uint64 = 1
	if v << n != 0 { ok = false }                      // left overshift -> 0
	var b uint8 = 255
	if b >> n != cast(uint8, 0) { ok = false }         // narrow value, count(64) > width(8)
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
