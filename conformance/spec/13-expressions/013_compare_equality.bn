package "main"

// expr.compare.equality: == and != on integers, bool, and pointers (address
// equality); a pointer may be compared against nil.
func main() {
	var ok bool = true
	if !(42 == 42 && 42 != 43) { ok = false }
	if !(true == true && true != false) { ok = false }
	var x int = 5
	var p *int = &x
	if !(p == p) { ok = false }                        // address equality
	if !(p != nil) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
