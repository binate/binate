package "main"

// expr.compare.equality: == and != on integers, bool, floating-point, raw and
// managed pointers (address equality), and named types over a comparable
// underlying; a pointer may be compared against nil.
type Count int

func main() {
	var ok bool = true
	if !(42 == 42 && 42 != 43) { ok = false }
	if !(true == true && true != false) { ok = false }
	if !(1.5 == 1.5 && 1.5 != 2.5) { ok = false }      // floating-point
	var x int = 5
	var p *int = &x
	if !(p == p && p != nil) { ok = false }             // raw pointer / nil
	var m @int = box(7)
	if !(m == m) { ok = false }                         // managed pointer (header address)
	var c Count = 3
	if !(c == 3 && c != 4) { ok = false }               // named type over int
	if ok { println("ok") } else { println("FAIL") }
}
