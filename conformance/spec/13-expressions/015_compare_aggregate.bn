package "main"
import "pkg/builtins/testing"

// expr.compare.aggregate: struct and array types are comparable in principle
// (element-wise, comparable iff every field is). The intended result is shown
// below; the lowering is not yet implemented, so this is xfail.
type Point struct {
	x int
	y int
}

func main() {
	var a Point = Point{1, 2}
	var b Point = Point{1, 2}
	var c Point = Point{1, 3}
	if a == b && a != c {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
