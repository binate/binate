package "main"

// expr.compare.relational: <, >, <=, >= on numeric operands (integer or float),
// yielding a bool.
func main() {
	var ok bool = true
	if !(1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3) { ok = false }
	var a float64 = 1.5
	var b float64 = 2.5
	if !(a < b && b > a) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
