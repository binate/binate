package "main"
import "pkg/builtins/testing"

// expr.compare.relational: <, >, <=, >= on numeric operands (integer or float),
// yielding a bool. Both directions are checked so a stuck-true operator fails.
func main() {
	var ok bool = true
	if !(1 < 2 && 2 <= 2 && 3 > 2 && 3 >= 3) { ok = false }   // true cases
	if 2 < 1 { ok = false }
	if 3 <= 2 { ok = false }
	if 2 > 3 { ok = false }
	if 2 >= 3 { ok = false }                                   // false cases
	var a float64 = 1.5
	var b float64 = 2.5
	if !(a < b && b > a) { ok = false }
	if b < a { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
