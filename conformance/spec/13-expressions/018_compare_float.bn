package "main"

// expr.compare.float: NaN compares false under ==, <, <=, >, >= and true under
// != — in particular x == x is false and x != x is true when x is NaN.
func zerof() float64 { return 0.0 }

func main() {
	var ok bool = true
	var nan float64 = zerof() / zerof()
	if nan == nan { ok = false }
	if !(nan != nan) { ok = false }
	if nan < nan { ok = false }
	if nan > nan { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
