package "main"

// expr.logical: && and || take bool operands and short-circuit — the right
// operand is evaluated only when the left does not already decide the result.
var calls int = 0

func bumpTrue() bool {
	calls = calls + 1
	return true
}

func main() {
	var ok bool = true
	if !(true || bumpTrue()) { ok = false }    // RHS skipped
	if calls != 0 { ok = false }
	if false && bumpTrue() { ok = false }       // RHS skipped
	if calls != 0 { ok = false }
	if !(true && bumpTrue()) { ok = false }     // RHS evaluated
	if calls != 1 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
