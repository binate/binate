package "main"

// expr.unary: -, !, ~, *, & ; there is no unary +. & yields a raw pointer.
func main() {
	var ok bool = true
	var x int = 5
	if -x != -5 { ok = false }
	var b bool = false
	if !(!b) { ok = false }                       // logical NOT
	var u uint8 = 15
	if ~u != cast(uint8, 240) { ok = false }      // complement
	var p *int = &x                                // address-of -> raw pointer
	if *p != 5 { ok = false }                     // dereference
	if ok { println("ok") } else { println("FAIL") }
}
