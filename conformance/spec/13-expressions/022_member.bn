package "main"

// expr.member: selector `.` reaches a field; a selector on a pointer
// auto-dereferences one level (raw or managed).
type Box struct {
	v int
}

func main() {
	var ok bool = true
	var b Box = Box{v: 10}
	if b.v != 10 { ok = false }
	var p *Box = &b
	if p.v != 10 { ok = false }       // auto-deref one pointer level
	p.v = 20
	if b.v != 20 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
