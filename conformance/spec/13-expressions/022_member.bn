package "main"
import "pkg/builtins/testing"

// expr.member: selector `.` reaches a field; a selector on a pointer
// auto-dereferences one level, raw OR managed.
type Box struct {
	v int
}

func main() {
	var ok bool = true
	var b Box = Box{v: 10}
	if b.v != 10 { ok = false }
	var p *Box = &b
	if p.v != 10 { ok = false }       // auto-deref a raw pointer
	p.v = 20
	if b.v != 20 { ok = false }
	var mp @Box = box(Box{v: 30})
	if mp.v != 30 { ok = false }       // auto-deref a managed pointer
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
