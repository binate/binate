package "main"
import "pkg/builtins/testing"

// expr.index: x[i] indexes a slice/array by an integer; x[lo:hi] sub-slices,
// and sub-slicing an array yields a raw slice *[]T.
func main() {
	var ok bool = true
	var arr [3]int = [3]int{10, 20, 30}
	if arr[0] != 10 || arr[2] != 30 { ok = false }
	var sub *[]int = arr[1:3]
	if len(sub) != 2 || sub[0] != 20 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
