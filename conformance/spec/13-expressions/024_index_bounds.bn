package "main"
import "pkg/builtins/testing"

// expr.index.bounds: indexing a slice/array outside [0, len) is a defined
// non-recoverable panic. The index is runtime so it is not folded.
func idx() int { return 5 }

func main() {
	var s @[]int = @[]int{1, 2, 3}
	var i int = idx()
	testing.Println(s[i])
}
