package "main"
import "pkg/builtins/testing"

// expr.composite: each evaluation of a composite literal constructs a fresh,
// independent value — copying one does not alias the other.
type Pt struct {
	x int
	y int
}

func main() {
	var ok bool = true
	var a Pt = Pt{1, 2}
	var b Pt = a
	b.x = 99
	if a.x != 1 { ok = false }                 // a is independent of b
	var arr [2]int = [2]int{5, 6}
	var arr2 [2]int = arr
	arr2[0] = 99
	if arr[0] != 5 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
