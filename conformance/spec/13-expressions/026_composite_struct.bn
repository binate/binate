package "main"
import "pkg/builtins/testing"

// expr.composite.struct: keyed (order-free) or positional (declaration order);
// omitted fields are zero-initialized.
type T struct {
	a int
	b int
	c int
}

func main() {
	var ok bool = true
	var k T = T{a: 1, b: 2, c: 3}        // keyed
	if k.a != 1 || k.b != 2 || k.c != 3 { ok = false }
	var p T = T{4, 5, 6}                  // positional
	if p.a != 4 || p.c != 6 { ok = false }
	var z T = T{}                          // all zero
	if z.a != 0 || z.b != 0 || z.c != 0 { ok = false }
	var partial T = T{a: 7}               // omitted b,c -> zero
	if partial.a != 7 || partial.b != 0 || partial.c != 0 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
