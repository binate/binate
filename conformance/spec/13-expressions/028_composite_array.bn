package "main"
import "pkg/builtins/testing"

// expr.composite.array: [N]T{...} fills positions in order; omitted trailing
// positions are zero.
func main() {
	var ok bool = true
	var a [3]int = [3]int{7}              // {7, 0, 0}
	if a[0] != 7 || a[1] != 0 || a[2] != 0 { ok = false }
	var b [3]int = [3]int{1, 2, 3}
	if b[0] != 1 || b[2] != 3 { ok = false }
	var z [2]int = [2]int{}               // all zero
	if z[0] != 0 || z[1] != 0 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
