package "main"

// expr.composite.array (indexed form): keys place values at positions and gaps
// are zero — [5]int{1: 10, 3: 30} is intended to be {0,10,0,30,0}.
func main() {
	var a [5]int = [5]int{1: 10, 3: 30}
	if a[0] == 0 && a[1] == 10 && a[2] == 0 && a[3] == 30 && a[4] == 0 {
		println("ok")
	} else {
		println("FAIL")
	}
}
