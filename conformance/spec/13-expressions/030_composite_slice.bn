package "main"

// expr.composite.slice: @[]T{...} builds a fresh managed-slice; a raw-slice
// literal is permitted only with const elements as *[]readonly T{...}.
func main() {
	var ok bool = true
	var m @[]int = @[]int{1, 2, 3}
	if len(m) != 3 || m[1] != 2 { ok = false }
	var r *[]readonly int = *[]readonly int{4, 5}
	if len(r) != 2 || r[0] != 4 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
