package "main"
import "pkg/builtins/testing"

// expr.composite.generic: a composite-literal head may be a generic
// instantiation, Box[int]{...} — built and instantiated with the type
// argument substituted, the same as the underlying struct literal.
type Box[T any] struct {
	v T
}

func main() {
	var b Box[int] = Box[int]{v: 5}
	if b.v == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
