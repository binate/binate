package "main"

// expr.composite.generic: a composite-literal head may be a generic
// instantiation, Box[int]{...}. The parser does not yet build this head, so
// this is xfail.
type Box[T any] struct {
	v T
}

func main() {
	var b Box[int] = Box[int]{v: 5}
	if b.v == 5 { println("ok") } else { println("FAIL") }
}
