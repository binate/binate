package "main"
import "pkg/builtins/testing"

// expr.disambiguation: D8 — `-`/`*`/`&` are unary at the start of an operand and
// binary after a complete operand; D5 — a postfix [..] is an index without `:`
// and a slice with `:`.
func main() {
	var ok bool = true
	var x int = 2
	var y int = 3
	if x * -y != -6 { ok = false }      // D8: '*' binary, then unary '-y'
	if x - -y != 5 { ok = false }        // D8: binary '-', then unary '-y'
	var a [3]int = [3]int{10, 20, 30}
	if a[1] != 20 { ok = false }         // D5: [1] is an index
	var sl *[]int = a[0:2]               // D5: [0:2] is a slice
	if len(sl) != 2 || sl[1] != 20 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
