package "main"

// expr.disambiguation: D8 — `-`/`*`/`&` are unary at the start of an operand and
// binary after a complete operand; D5 — a postfix [..] without `:` is an index.
func main() {
	var ok bool = true
	var x int = 2
	var y int = 3
	if x * -y != -6 { ok = false }     // '*' binary, then unary '-y'
	if x - -y != 5 { ok = false }       // binary '-', then unary '-y'
	var a [3]int = [3]int{10, 20, 30}
	if a[1] != 20 { ok = false }        // [1] is an index, not a slice
	if ok { println("ok") } else { println("FAIL") }
}
