package "main"
import "pkg/builtins/testing"

// expr.unary: unary + is a numeric identity — it requires a numeric operand
// (int or float) and yields it unchanged.  `+5` == `5`; it composes with unary
// - (`+ -5` == -5) and carries an untyped literal's value through the fit-check
// (`var s int8 = +5` accepts; `+200` would not fit int8).
func main() {
	var ok bool = true
	var x int = +5
	if x != 5 { ok = false }
	var y int = 7
	if +y != 7 { ok = false }                 // + on a variable
	var f float64 = +2.5
	if f != 2.5 { ok = false }                // + on a float
	if + -5 != -5 { ok = false }              // composes with unary -
	var s int8 = +5                            // literal value carries through
	if cast(int, s) != 5 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
