package "main"
import "pkg/builtins/testing"

// expr.index.bounds: a SUB-SLICE violating 0 <= lo <= hi <= len is a defined
// non-recoverable panic (a distinct check from the index-OOB case in 024). The
// endpoint is runtime so it is not constant-folded.
func hi() int { return 9 }

func main() {
	var s @[]int = @[]int{1, 2, 3}
	var h int = hi()
	testing.Println(s[1:h][0])
}
