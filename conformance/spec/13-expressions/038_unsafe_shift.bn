package "main"

// expr.shift.negative: the guard-free intrinsics unsafe_shl / unsafe_shr perform
// the shift WITHOUT the negative-count/overshift handling; for an in-range count
// they equal the checked << / >>. (The out-of-range case is genuine UB.)
func main() {
	var ok bool = true
	if unsafe_shl(1, 4) != 16 { ok = false }
	if unsafe_shr(256, 2) != 64 { ok = false }
	if unsafe_shl(3, 0) != 3 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
