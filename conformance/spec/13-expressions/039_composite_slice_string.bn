package "main"

// expr.composite.slice (string-literal clause): a string literal has default
// type @[]readonly char and is also assignable to @[]char, *[]readonly char,
// [N]char, and [N]readonly char.
func main() {
	var ok bool = true
	d := "hi"                                  // default type @[]readonly char
	if len(d) != 2 || d[0] != 'h' { ok = false }
	var mc @[]char = "ab"
	if len(mc) != 2 || mc[1] != 'b' { ok = false }
	var rr *[]readonly char = "cd"
	if rr[0] != 'c' { ok = false }
	var arr [3]char = "xyz"
	if arr[0] != 'x' || arr[2] != 'z' { ok = false }
	var ra [2]readonly char = "pq"
	if ra[1] != 'q' { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
