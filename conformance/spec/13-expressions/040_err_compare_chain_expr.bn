package "main"
import "pkg/builtins/testing"

// expr.compare.relational: comparisons do not chain in ORDINARY expression
// context either (017 covers the for-clause path) — the non-associative grammar
// rejects `a < b < c`.
func main() {
	var a int = 1
	var b int = 2
	var c int = 3
	if a < b < c {
		testing.Println("bad")
	}
}
