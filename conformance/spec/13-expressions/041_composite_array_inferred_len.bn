package "main"
import "pkg/builtins/testing"

// expr.composite.array.inferred-len: [...]T{...} as a composite-literal head
// infers the array length from the element count -- [...]int{10, 20, 30} has
// type [3]int. (`[...]` is valid ONLY as a literal head; the rejection of
// `[...]T` in other type positions is pinned by 050_err_inferred_len_non_literal.)
func main() {
	a := [...]int{10, 20, 30}
	if len(a) == 3 && a[2] == 30 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
