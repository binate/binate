package "main"

// expr.disambiguation.d4-paren: a composite literal may be used in a control-flow
// condition by parenthesizing it — the parens clear the D4 suppression of the
// composite literal's `{`.
type Point struct {
	x int
}

func main() {
	if (Point{x: 9}).x == 9 { println("ok") } else { println("FAIL") }
}
