package "main"
import "pkg/builtins/testing"

// expr.composite.struct: a POSITIONAL struct-literal element must be
// assignable to the field at that position, exactly as a keyed element must.
// `P{1, true}` puts `true` (bool) in field `b int` -- a type mismatch that
// must be rejected (a checker that checks only keyed elements accepts it).
type P struct {
	a int
	b int
}

func main() {
	var p P = P{1, true}
	testing.Println(p.a)
}
