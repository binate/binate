package "main"
import "pkg/builtins/testing"

// expr.composite.array.indexed: an array-literal element may be INDEXED
// (`k: v`), placing the value at constant index k; an unkeyed element follows
// the previous index + 1 (Go semantics).  Unset elements are zero-filled.
func main() {
	var a [5]int = [5]int{1: 10, 3: 30}   // {0, 10, 0, 30, 0}
	var s int = 0
	for i := 0; i < 5; i++ { s = s + a[i] }
	testing.Println(s)                             // 40
	testing.Println(a[0] + a[2] + a[4])            // 0  (gaps zero-filled)

	var b [5]int = [5]int{2: 7, 8}         // {0, 0, 7, 8, 0} (positional follows k+1)
	testing.Println(b[2])                          // 7
	testing.Println(b[3])                          // 8

	var c [3]int = [3]int{1, 2}            // {1, 2, 0} (partial positional)
	testing.Println(c[0] + c[1] + c[2])            // 3
}
