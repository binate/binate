package "main"
import "pkg/builtins/testing"

// expr.composite.array.inferred-len: the inferred length follows the same
// positional / keyed index walk as a fixed-length array literal -- the length
// is the highest index reached plus one. An empty literal infers length 0; a
// keyed element places its value at the constant index; a trailing keyed index
// extends the length past the positional run.
func main() {
	var ok bool = true

	// Empty: [...]int{} has length 0.
	empty := [...]int{}
	if len(empty) != 0 {
		ok = false
	}

	// Keyed only: max index 2 -> length 3, gaps zero-filled.
	keyed := [...]int{0: 10, 2: 30}
	if len(keyed) != 3 || keyed[0] != 10 || keyed[1] != 0 || keyed[2] != 30 {
		ok = false
	}

	// Mixed positional + a later keyed index: 1, 2 at 0/1, then 99 at index 5
	// -> length 6.
	mixed := [...]int{1, 2, 5: 99}
	if len(mixed) != 6 || mixed[0] != 1 || mixed[1] != 2 || mixed[5] != 99 {
		ok = false
	}

	if ok {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
