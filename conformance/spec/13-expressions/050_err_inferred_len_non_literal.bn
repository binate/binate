package "main"

// expr.composite.array.inferred-len: `[...]T` is valid ONLY as a
// composite-literal head, where the length is folded from the elements. In any
// other type position there is no element list to infer from, so `[...]T` is
// rejected: "[...] array length is only valid in a composite literal". Here it
// appears as an explicit var TYPE (with an inferred-length-literal initializer);
// the correct spelling drops the var type -- `a := [...]int{1, 2, 3}` (041).
func main() {
	var a [...]int = [...]int{1, 2, 3}
	_ = a
}
