package "main"
import "pkg/builtins/testing"

// expr.compare.aggregate (Constraint): an array is comparable only if its
// element type is comparable.  An array whose element type is a slice is
// rejected — slices are never comparable.

func main() {
	var a [2]@[]int
	var b [2]@[]int
	if a == b {
		testing.Println("unreachable")
	}
}
