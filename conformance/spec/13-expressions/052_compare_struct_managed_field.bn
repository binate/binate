package "main"
import "pkg/builtins/testing"

// expr.compare.aggregate: a struct with a managed-pointer (@T) field is
// comparable — the @T fields compare by IDENTITY (pointer value), not by
// pointee.  The comparison itself neither retains nor releases (it only reads
// the words), so refcounting around it stays balanced.

type Box struct {
	id int
	p @int
}

func main() {
	var x @int = box(7)
	var y @int = box(7) // distinct allocation, same pointee value (7)

	var a Box
	a.id = 1
	a.p = x

	var b Box
	b.id = 1
	b.p = x // same managed pointer as a.p

	var c Box
	c.id = 1
	c.p = y // different pointer; *y == *x but the identities differ

	if a == b && a != c {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
