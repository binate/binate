package "main"
import "pkg/builtins/testing"

// expr.compare.aggregate: == / != recurse through nested structs, arrays of
// structs, and struct fields that are arrays — two values are equal iff every
// transitive leaf field/element is, and a difference at any depth makes them
// unequal.

type Inner struct {
	a int
	b int
}

type Outer struct {
	tag int
	mid Inner
	xs [2]Inner
}

func main() {
	var p Outer
	p.tag = 1
	p.mid.a = 2
	p.mid.b = 3
	p.xs[0].a = 4
	p.xs[1].b = 5

	var q Outer
	q.tag = 1
	q.mid.a = 2
	q.mid.b = 3
	q.xs[0].a = 4
	q.xs[1].b = 5

	// A by-value copy that then differs only at one deep array-of-struct leaf.
	var r Outer = q
	r.xs[1].b = 99

	if p == q && p != r {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
