package "main"
import "pkg/builtins/testing"

// expr.compare.aggregate (Constraint): a struct is comparable only if every
// field is comparable.  A struct with a slice field (interface / function
// would be the same) is rejected — slices are never comparable.

type S struct {
	n int
	v @[]int
}

func main() {
	var a S
	var b S
	if a == b {
		testing.Println("unreachable")
	}
}
