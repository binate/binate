package "main"
import "pkg/builtins/testing"

// expr.compare.incomparable: a string literal is untyped and defaults to
// @[]readonly char (a slice), which is never comparable with == / != — so a
// two-literal comparison is rejected (it is NOT a content comparison; compare
// contents element-wise instead).
func main() {
	if "a" == "a" {
		testing.Println("bad")
	}
}
