package "main"
import "pkg/builtins/testing"

// expr.compare.aggregate: a char-array variable and a string literal compare
// ELEMENT-WISE (the untyped literal adopts the array's type), in BOTH operand
// orders and as a switch case.  This is content comparison, not a rodata-pointer
// compare — so equal content is `true` and differing content is `false`.
func main() {
	var a [3]char
	a[0] = 'a'
	a[1] = 'b'
	a[2] = 'c'
	var ok bool = true
	if !(a == "abc") { ok = false }   // equal content -> true
	if a == "abd" { ok = false }      // differing content -> false
	if !("abc" == a) { ok = false }   // literal on the left
	if "abd" == a { ok = false }
	if !(a != "abd") { ok = false }   // != negation
	if a != "abc" { ok = false }
	var matched bool = false
	switch a {
	case "abc":
		matched = true
	}
	if !matched { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
