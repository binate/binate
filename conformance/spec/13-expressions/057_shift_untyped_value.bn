package "main"

import "pkg/builtins/testing"

// expr.shift.untyped-value.typing: an untyped constant shift value with a
// non-constant count takes the type the shift's context gives it — however the
// value is spelled (literal, constant expression, untyped const name) — never
// the count's type.  Every value below differs from what the count's type
// (uint8) would give; the 2^40 results need a 64-bit shift on 32-bit targets.

const One = 1

type Mask uint16

func ret64(n uint8) int64 { return 1 << n }
func retMask(n uint8) Mask { return (0 + 1) << n }
func arg64(v int64) int64 { return v }

func main() {
	var n uint8 = 9
	var big uint8 = 40
	var a uint8 = 1 << n                        // 0: overshift at 8 bits
	var b int64 = 1 << big                      // literal value
	var c int64 = (0 + 1) << big                // constant-expression value
	var d int64 = One << big                    // untyped const name
	e := 1 << n                                 // default int: 512
	var m uint8 = 0xF0
	var f uint8 = m & ~(1 << (n - 5))           // through ~, from the & peer: 0xE0
	var g uint16 = (1 << n) | (1 << (n - 1))    // both shifts uint16: 768
	var h int64 = cast(int64, 1 << big)         // cast target
	var i int32 = (0 - 16) >> (n - 7)           // arithmetic >> at int32: -4
	var j uint8 = (1 << n) << 2                 // nested value: 0
	testing.Println(cast(int64, a), b, c, d, cast(int64, e), cast(int64, f), cast(int64, g), h,
			cast(int64, i), cast(int64, j))
	testing.Println(ret64(big), cast(int64, retMask(n)), arg64(1 << big))
	var s int64 = unsafe_shl(1, big)            // unsafe_shl typed from context
	var r bool = (1 << n) == 512                // comparison of two untyped: int
	testing.Println(s, r)
	switch 1 << n {                             // switch tag: int
	case 512:
		testing.Println("tag 512")
	default:
		testing.Println("tag other")
	}
	testing.Println(1 << n)                     // interface argument: int
}
