package "main"

import "pkg/builtins/testing"

// expr.shift.untyped-value.integer: an untyped constant shift value takes its
// type from its context, and the value of a shift must be an integer — so a
// float64 cast target is an error (write cast(float64, cast(int64, 1) << n)).
func main() {
	var n uint8 = 9
	var p float64 = cast(float64, 1 << n)
	testing.Println(p)
}
