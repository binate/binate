package "main"

import "pkg/builtins/testing"

// expr.shift.untyped-value.typing: every maximal untyped constant inside an
// untyped non-constant integer expression must fit the type the expression
// takes — 300 does not fit uint8, even though the shift is not a constant.
func main() {
	var n uint8 = 9
	var h uint8 = (1 << n) + 300
	testing.Println(cast(int, h))
}
