package "main"
import "pkg/builtins/testing"

// expr.associativity: comparisons do not chain, but a PARENTHESIZED comparison is
// an ordinary bool operand — `(b < c) == d` compares two bools and is valid.  This
// holds in a for-clause (whose identifier-leading condition takes its own parse
// path) and in ordinary expression context alike.
func main() {
	var a bool = true
	var b int = 1
	var c int = 2
	var d bool = true
	var n int = 0
	for a && (b < c) == d {
		n = n + 1
		a = false
	}
	var e bool = (b < c) == d
	var f bool = (b == c) == (c == b)
	var g bool = false
	if (b < c) == d {
		g = true
	}
	if n == 1 && e && f && g { testing.Println("ok") } else { testing.Println("FAIL") }
}
