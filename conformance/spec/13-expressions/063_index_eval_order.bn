package "main"

import "pkg/builtins/testing"

// The operands of an index expression evaluate left to right, each once — the
// base, then the index (a sub-slice: the base, then lo, then hi) — wherever the
// expression appears: read, assigned to, incremented, address-taken, as the
// operand of a selector or of a further index.  Each base and index below is a
// call that logs itself; each line ends with the form it exercised.

type P struct {
	f int
}

var arr [3]int
var parr [3]P
var nest [3][3]int
var sl @[]int

func base() *([3]int) {
	testing.Print("base ")
	return &arr
}

func pbase() *([3]P) {
	testing.Print("base ")
	return &parr
}

func nbase() *([3][3]int) {
	testing.Print("base ")
	return &nest
}

func sbase() @[]int {
	testing.Print("base ")
	return sl
}

func pt() *int {
	testing.Print("base ")
	return &arr[0]
}

func idx(tag *[]readonly char) int {
	testing.Print(tag)
	testing.Print(" ")
	return 1
}

func end(what *[]readonly char) {
	testing.Print("<- ")
	testing.Println(what)
}

func main() {
	sl = make_slice(int, 3)
	var r int = (*base())[idx("i")]
	end("read x[i]")
	(*base())[idx("i")] = 5
	end("x[i] = v")
	(*base())[idx("i")]++
	end("x[i]++")
	var q *int = &(*base())[idx("i")]
	end("&x[i]")
	r = r + (*pbase())[idx("i")].f
	end("read x[i].f")
	(*pbase())[idx("i")].f = 5
	end("x[i].f = v")
	(*pbase())[idx("i")].f++
	end("x[i].f++")
	r = r + (*nbase())[idx("i")][idx("j")]
	end("read x[i][j]")
	(*nbase())[idx("i")][idx("j")] = 5
	end("x[i][j] = v")
	(*nbase())[idx("i")][idx("j")]++
	end("x[i][j]++")
	r = r + sbase()[idx("i")]
	end("read slice s[i]")
	sbase()[idx("i")] = 5
	end("slice s[i] = v")
	sbase()[idx("i")]++
	end("slice s[i]++")
	pt()[idx("i")] = 5
	end("pointer p[i] = v")
	pt()[idx("i")]++
	end("pointer p[i]++")
	var a *[]int = (*base())[idx("lo"):idx("hi") + 1]
	end("array x[lo:hi]")
	var s @[]int = sbase()[idx("lo"):idx("hi") + 1]
	end("slice x[lo:hi]")
	testing.Println(r + *q + len(a) + len(s))
}
