package "main"

import "pkg/builtins/testing"

// expr.member / expr.addressable: in `(&x).f` the selector auto-dereferences
// the pointer `&x`, so `(&x).f` denotes x.f itself — x's own storage.  Every
// use must reach it: a read, a store, an increment, a compound assignment, an
// element of an array field, a nested field, a field reached through a pointer
// or managed-pointer field, the field's address, a pointer-receiver method on
// the field, and a sub-slice of an array field.  A lowering that copied x (or
// found no address) drops the store or reads a stale value.

type In struct {
	v int
}

type S struct {
	x   int
	m   [3]int
	sub In
	p   *In
	h   @In
}

func (i *In) inc() { i.v = i.v + 100 }

interface Shower {
	Show() int
	Say()
}

type Sh struct {
	n int
}

func (s *Sh) Show() int { return s.n }

func (s *Sh) Say() { testing.Println("say", s.n) }

impl *Sh : Shower

type W struct {
	iv *Shower
	mv @Shower
}

func show(s *Shower) { testing.Println((&s).Show()) }

func main() {
	var other In
	var s S
	s.x = 5
	s.m[1] = 7
	s.p = &other
	s.h = make(In)

	testing.Println((&s).x, (&s).m[1], (&s).sub.v) // reads
	(&s).x = 9 // store
	(&s).m[2] = 11 // element of an array field
	(&s).sub.v = 13 // nested field
	testing.Println(s.x, s.m[2], s.sub.v)
	(&s).x++
	(&s).m[0] += 4
	testing.Println(s.x, s.m[0])
	(&s).p.v = 17 // through a pointer field
	(&s).h.v = 19 // through a managed-pointer field
	testing.Println(other.v, s.h.v)
	var q *int = &(&s).x // the field's address
	*q = 21
	testing.Println(s.x)
	(&s).sub.inc() // pointer-receiver method on the field
	testing.Println(s.sub.v)
	var sl *[]int = (&s).m[:] // sub-slice of an array field aliases it
	sl[1] = 23
	testing.Println(s.m[1])

	var arr [2]S
	(&arr[1]).x = 25 // an element's address as the base
	(&(&arr[1]).sub).v = 27
	testing.Println(arr[1].x, (&arr[1]).x, arr[1].sub.v)

	// Interface-method calls through an address-of base.
	var sh Sh = Sh{n: 29}
	var iv *Shower = &sh
	testing.Println((&iv).Show())
	var w W
	w.iv = &sh
	var ms @Sh = make(Sh)
	ms.n = 31
	w.mv = ms
	testing.Println((&w).iv.Show(), (&w).mv.Show())
	show(&sh)
	defer (&w).mv.Say()
}
