package "main"

import "pkg/builtins/testing"

// expr.member: a selector auto-dereferences one pointer level whatever the
// pointee's type is spelled as — a struct type, or a distinct named type
// declared over one (`type T2 S`).  Through `&t`, `*p`, `*h` and a call
// returning a pointer, a read, a store, an increment, a compound assignment,
// an element of an array field and a pointer-receiver method on a field all
// reach the pointee's storage — also when the pointer is a generic call's or a
// generic method call's result.

type In struct {
	v int
}

type S struct {
	x   int
	arr [4]int
	sub In
}

type T2 S

func (i *In) inc() { i.v = i.v + 100 }

type Box[T any] struct {
	t   T
	n   int
	sub In
	arr [2]In
}

func (b *Box[T]) Me() *Box[T] { return b }

func mk[T any](b *Box[T]) *Box[T] { return b }

var g T2

func getT2() *T2 { return &g }

func main() {
	var t T2
	t.x = 5
	testing.Println((&t).x) // read
	(&t).x = 8 // store
	testing.Println(t.x)
	(&t).x++
	(&t).x += 3
	testing.Println(t.x)
	(&t).arr[3] = 2
	testing.Println((&t).arr[3], t.arr[3])
	(&t).sub.inc()
	testing.Println((&t).sub.v)

	var p *T2 = &t
	(*p).x = 9
	(*p).arr[1] = 7
	testing.Println(t.x, (*p).x, (*p).arr[1])

	var h @T2 = make(T2)
	(*h).x = 10
	(*h).x++
	testing.Println(h.x, (*h).x)

	getT2().x = 11
	getT2().x++
	getT2().sub.inc()
	testing.Println(g.x, getT2().x, g.sub.v)

	// Bases that are a generic call's or a generic method call's result.
	var bx Box[int]
	mk[int](&bx).n++
	bx.Me().n++
	(*bx.Me()).n++
	bx.Me().sub.v = 5
	mk[int](&bx).sub.v += 2
	mk[int](&bx).arr[1].v = 9
	bx.Me().sub.v++
	testing.Println(bx.n, bx.sub.v, bx.arr[1].v, bx.Me().sub.v, mk[int](&bx).arr[1].v)
}
