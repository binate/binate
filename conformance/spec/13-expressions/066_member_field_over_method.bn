package "main"

import "pkg/builtins/testing"

// expr.member: a field takes precedence over a same-named method, so `t.f(...)`
// calls the function-value field f — with the field's parameters — directly and
// deferred, through the struct or a pointer to it (func.dispatch.routing (1)).

type T struct {
	f @func(int, int)
}

func (t *T) f(n int) { testing.Println("method", n) }

func add(a int, b int) { testing.Println("field", a + b) }

func run() {
	var t @T = make(T)
	t.f = add
	var p *T = t
	t.f(1, 2)
	p.f(3, 4)
	defer t.f(5, 6)
}

func main() {
	run()
}
