package "main"

import "pkg/builtins/testing"

// expr.member: a field takes precedence over a same-named method, so with a
// field n of type int, `t.n()` names the field — which is not a function —
// even though T also has a method n.

type T struct {
	n int
}

func (t *T) n() int { return 1 }

func main() {
	var t @T = make(T)
	testing.Println(t.n())
}
