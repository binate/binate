package "main"

import "pkg/builtins/testing"

// expr.member: a selector reaches a field of any struct value, a call result
// included — also a generic instance returned by a call — and calling through
// that field (an interface value's method, a function value) is a call of the
// field's value.

interface Shower {
	Show() int
}

type S struct {
	q int
}

func (s *S) Show() int { return s.q }

impl *S : Shower

type Box[T any] struct {
	x T
	a int
}

func idb(y Box[*Shower]) Box[*Shower] { return y }

func idf(y Box[@func(int) int]) Box[@func(int) int] { return y }

func main() {
	var s S
	s.q = 7
	var ys Box[*Shower]
	ys.x = &s
	testing.Println(idb(ys).x.Show())
	var yf Box[@func(int) int]
	yf.x = func(z int) int { return z + 1 }
	testing.Println(idf(yf).x(41))
}
