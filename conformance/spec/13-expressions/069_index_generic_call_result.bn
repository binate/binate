package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// An index expression's base may be a call result (expr.index): an element of
// a managed-slice or array call result — a generic instance, or an anonymous
// struct — is read, written, and called through like any element, its fields
// reached by selectors; the temporaries are released after the statement.

type Box[T any] struct {
	x T
	y int
	s @[]int
	f @func(T) T
}

func mkSl() @[]Box[int] {
	var r @[]Box[int] = make_slice(Box[int], 2)
	r[1].x = 14
	r[1].s = make_slice(int, 3)
	r[1].f = func(v int) int { return v + 1 }
	return r
}

func mkArr() [2]Box[int] {
	var r [2]Box[int]
	r[1].x = 15
	r[1].s = make_slice(int, 2)
	return r
}

func idx() @[]@[]Box[int] {
	var r @[]@[]Box[int] = make_slice(@[]Box[int], 2)
	r[1] = make_slice(Box[int], 2)
	r[1][1].x = 16
	return r
}

func mkArrA() [2]struct {
	a int
	s @[]int
} {
	var r [2]struct {
		a int
		s @[]int
	}
	r[1].a = 9
	r[1].s = make_slice(int, 1)
	return r
}

func run() {
	testing.Println(mkSl()[1].x)
	testing.Println(mkArr()[1].x)
	testing.Println(len(mkSl()[1].s))
	mkSl()[1].y = 9
	testing.Println(mkSl()[1].f(2))
	testing.Println(idx()[1][1].x)
	testing.Println(mkArrA()[1].a)
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	run()
	var live int = rt.LiveBlocks()
	run()
	testing.Println(rt.LiveBlocks() - live)
}
