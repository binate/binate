package "main"

import "pkg/builtins/testing"

// expr.member: a selector in an array length, while the package's types are
// collected, reads a field or a method of a type not built yet — an instance
// that waits for a type being collected, an interface being collected or
// declared later, or a type declared later and reached through a pointer.  The
// type is built first, and the lengths the program reads are the ones its
// layout has.  Each Nk is collected first and holds *Box[Xk], so Box[Xk] is
// built while Nk is collected, and collects Xk.

type Box[T any] struct { a [sizeof(T)]uint8 }

// A field of an instance that waits: W1[Q1] reads N1 while N1 is collected.

type W1[T any] struct { a [sizeof(T)]uint8 }

type N1 struct {
	v int64
	p *Box[X1]
}

type X1 struct { b [len(w1.a)]uint8 }

var w1 W1[Q1]

type Q1 struct { c [sizeof(N1)]uint8 }

// A method of an instance that waits.

type W2[T any] struct { a [sizeof(T)]uint8 }

func (w W2[T]) mk() [sizeof(T)]uint8 {
	var r [sizeof(T)]uint8
	return r
}

type N2 struct {
	v int64
	p *Box[X2]
}

type X2 struct { b [len(w2.mk())]uint8 }

var w2 W2[Q2]

type Q2 struct { c [sizeof(N2)]uint8 }

// A method of an interface being collected.

interface I3 {
	m() [sizeof(N3)]uint8
}

type N3 struct {
	v int64
	p *Box[X3]
}

type X3 struct { b [len(i3.m())]uint8 }

var i3 *I3

// A method of an interface declared later.

type N4 struct {
	v int64
	p *Box[X4]
}

type X4 struct { b [len(i4.m())]uint8 }

var i4 *I4

interface I4 {
	m() [sizeof(N4)]uint8
}

// A field of a type declared later, reached through a pointer, and a field
// that takes precedence over the method of the same name.

type X5 struct {
	b [len(p5.c)]uint8
	d [len(p5.f)]uint8
}

var p5 *Z5

type Z5 struct {
	c [12]uint8
	f [20]uint8
}

func (z *Z5) f() [4]uint8 {
	var r [4]uint8
	return r
}

func agree(xb int, ba int, nsz int, xsz int) bool {
	return xb == nsz && ba == xb && xsz == xb
}

func main() {
	var b1 Box[X1]
	var x1 X1
	testing.Println(agree(len(x1.b), len(b1.a), cast(int, sizeof(N1)), cast(int, sizeof(X1))))
	testing.Println(len(w1.a) == cast(int, sizeof(N1)))
	var b2 Box[X2]
	var x2 X2
	testing.Println(agree(len(x2.b), len(b2.a), cast(int, sizeof(N2)), cast(int, sizeof(X2))))
	testing.Println(len(w2.mk()) == cast(int, sizeof(N2)))
	var b3 Box[X3]
	var x3 X3
	testing.Println(agree(len(x3.b), len(b3.a), cast(int, sizeof(N3)), cast(int, sizeof(X3))))
	var b4 Box[X4]
	var x4 X4
	testing.Println(agree(len(x4.b), len(b4.a), cast(int, sizeof(N4)), cast(int, sizeof(X4))))
	var x5 X5
	testing.Println(len(x5.b))
	testing.Println(len(x5.d))
	testing.Println(cast(int, sizeof(X5)))
}
