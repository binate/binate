package "main"

import "pkg/builtins/testing"

// expr.unary: unary + is a numeric identity, so its operand must be numeric (an
// integer or a floating-point value); `+` on a bool or a string is rejected.

func main() {
	var ok bool = +true
	var s *[]readonly char = +"s"
	if ok { testing.Println(len(s)) }
}
