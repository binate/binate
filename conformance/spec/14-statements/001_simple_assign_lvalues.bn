package "main"

// stmt.assign.simple: a simple `L = R` stores into each of the four assignable
// location kinds -- a variable, a slice/array element `s[i]`, a struct field
// `s.f`, and a pointer dereference `*p` -- with R assignable to the target.
type Pt struct { x int; y int }

func main() {
	var ok bool = true
	var v int = 10
	v = 20
	if v != 20 { ok = false }
	var arr [3]int
	arr[1] = 7
	if arr[1] != 7 { ok = false }
	var p Pt
	p.x = 3
	if p.x != 3 { ok = false }
	var n int = 0
	var ptr *int = &n
	*ptr = 99
	if n != 99 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
