package "main"

// stmt.assign.simple: a constant target (an unqualified `const` name) is not an
// assignable location -- a const has no storage to mutate -- so `C = 6` must be
// rejected ("cannot assign to const C"). The neighbor `var C` compiles.
func main() {
	const C int = 5
	C = 6
	println("unreachable")
}
