package "main"
import "pkg/builtins/testing"

// stmt.assign.simple: the right-hand value must be assignable (Ch.8) to the
// target. A `bool` is not assignable to an `int` location, so `x = b` is
// rejected. The neighbor `x = 7` (an int) compiles.
func main() {
	var x int = 0
	var b bool = true
	x = b
	testing.Println("unreachable")
}
