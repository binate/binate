package "main"
import "pkg/builtins/testing"

// stmt.assign.compound: `L op= R` is defined as `L = L op R` with op's typing.
// Exercises every compound_assign_op form on an integer target: arithmetic
// (+= -= *= /= %=), bitwise (&= |= ^=), and shifts (<<= >>=).
func main() {
	var ok bool = true
	var x int = 10
	x += 5
	if x != 15 { ok = false }
	x -= 3
	if x != 12 { ok = false }
	x *= 2
	if x != 24 { ok = false }
	x /= 5
	if x != 4 { ok = false }
	x %= 3
	if x != 1 { ok = false }
	var b int = 0xF0
	b &= 0x3C
	if b != 0x30 { ok = false }
	b |= 0x0F
	if b != 0x3F { ok = false }
	b ^= 0xFF
	if b != 0xC0 { ok = false }
	var s int = 3
	s <<= 4
	if s != 48 { ok = false }
	s >>= 2
	if s != 12 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
