package "main"
import "pkg/builtins/testing"

// stmt.assign.compound: a compound assignment carries the same const-target
// rejection as a simple one -- `C += 1` writes to a const, which has no
// storage, so it is rejected ("cannot assign to const C"). Neighbor `var C`
// compiles.
func main() {
	const C int = 5
	C += 1
	testing.Println("unreachable")
}
