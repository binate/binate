package "main"

// stmt.assign.compound: `L <<= R` has exactly the typing of the binary shift
// (§13.5), which requires integer operands. A float target therefore makes
// `f <<= 2` ill-typed ("shift requires integer operands"). Neighbor with an
// int target compiles.
func main() {
	var f float64 = 3.5
	f <<= 2
	println("unreachable")
}
