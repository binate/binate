package "main"
import "pkg/builtins/testing"

// stmt.assign.multi: a single multi-valued call on the RHS distributes its N
// results across N targets -- `a, b = two()` assigns result 0 to a and result
// 1 to b.
func two() (int, int) { return 3, 4 }

func main() {
	var ok bool = true
	var a int
	var b int
	a, b = two()
	if a != 3 { ok = false }
	if b != 4 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
