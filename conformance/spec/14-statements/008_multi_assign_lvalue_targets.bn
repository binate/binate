package "main"

// stmt.assign.multi: each distribution target may be an arbitrary assignable
// location, not just a variable -- here the two results of `g()` are stored
// into an array element and a struct field.
type H struct { field int }

func g() (int, int) { return 11, 22 }

func main() {
	var ok bool = true
	var arr [2]int
	var h H
	arr[0], h.field = g()
	if arr[0] != 11 { ok = false }
	if h.field != 22 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
