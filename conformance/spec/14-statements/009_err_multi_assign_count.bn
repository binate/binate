package "main"
import "pkg/builtins/testing"

// stmt.assign.multi: the result count of the distributed call must equal the
// target count. Three targets against a two-result call is a mismatch
// ("assignment count mismatch"). The neighbor with two targets compiles.
func two() (int, int) { return 3, 4 }

func main() {
	var a int
	var b int
	var c int
	a, b, c = two()
	testing.Println("unreachable")
}
