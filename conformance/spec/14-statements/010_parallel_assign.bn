package "main"

// stmt.assign.parallel: a matched-arity expression list on each side stores
// each RHS expression into the corresponding target -- `a, b = e1, e2`.
func main() {
	var ok bool = true
	var a int = 1
	var b int = 2
	a, b = 10, 20
	if a != 10 { ok = false }
	if b != 20 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
