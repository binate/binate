package "main"
import "pkg/builtins/testing"

// stmt.assign.parallel: a parallel assignment evaluates ALL right-hand
// expressions before any store, so the swap idiom `a, b = b, a` exchanges the
// two values rather than clobbering a with the new b.
func main() {
	var ok bool = true
	var a int = 1
	var b int = 2
	a, b = b, a
	if a != 2 { ok = false }
	if b != 1 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
