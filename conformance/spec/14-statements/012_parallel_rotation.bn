package "main"

// stmt.assign.parallel: RHS-first evaluation generalizes beyond a two-element
// swap -- a three-way rotation `a, b, c = c, a, b` reads all old values before
// storing, so each target gets its predecessor's value.
func main() {
	var ok bool = true
	var a int = 1
	var b int = 2
	var c int = 3
	a, b, c = c, a, b
	if a != 3 { ok = false }
	if b != 1 { ok = false }
	if c != 2 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
