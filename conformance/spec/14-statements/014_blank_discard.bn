package "main"

// stmt.assign.blank: a blank target `_` binds nothing but still evaluates the
// RHS for its side effects -- the side-effecting call runs (incrementing the
// counter) even though its result is discarded.
var counter int = 0

func sideEffect() int { counter = counter + 1; return 42 }

func main() {
	var ok bool = true
	_ = sideEffect()
	if counter != 1 { ok = false }
	_ = 5 + 3
	if ok { println("ok") } else { println("FAIL") }
}
