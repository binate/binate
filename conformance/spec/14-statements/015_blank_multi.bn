package "main"
import "pkg/builtins/testing"

// stmt.assign.blank: in a distributed multi-valued call, a blank target still
// forces all results to be produced -- `_, b = two()` discards result 0 but
// binds result 1 to b.
func two() (int, int) { return 7, 8 }

func main() {
	var ok bool = true
	var b int
	_, b = two()
	if b != 8 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
