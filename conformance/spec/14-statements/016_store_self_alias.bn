package "main"
import "pkg/builtins/testing"

// stmt.assign.store: a store retains the new value before releasing the prior
// occupant (acquire-before-release), making self-aliasing stores `x = x` and
// `arr[i] = arr[i]` safe no-ops that leave the value unchanged.
func main() {
	var ok bool = true
	var x int = 42
	x = x
	if x != 42 { ok = false }
	var arr [3]int
	arr[0] = 5
	arr[1] = 9
	arr[1] = arr[1]
	if arr[1] != 9 { ok = false }
	if arr[0] != 5 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
