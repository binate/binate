package "main"
import "pkg/builtins/testing"

// stmt.assign.store: acquire-before-release matters for a MANAGED target -- a
// naive release-then-retain would free the backing before re-acquiring it. The
// self-alias `s = s` on a managed-slice retains first, so the slice and its
// contents survive the store intact.
func main() {
	var ok bool = true
	var s @[]int = make_slice(int, 3)
	s[0] = 5
	s[1] = 9
	s = s
	if len(s) != 3 { ok = false }
	if s[0] != 5 { ok = false }
	if s[1] != 9 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
