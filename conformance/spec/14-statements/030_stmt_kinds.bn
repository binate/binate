package "main"
import "pkg/builtins/testing"

// stmt.kinds (§14.1): the statement taxonomy -- a function body may mix every
// statement form. This body exercises BlockDecl (var/const), the SimpleStmt
// forms (ShortVarDecl, IncDecStmt, Assignment, ExpressionStmt), a Block, an
// IfStmt, and a ForStmt, accumulating a value that pins the combined effect.

func helper() int { return 1 }

func main() {
	var total int = 0          // BlockDecl (var)
	const STEP int = 2         // BlockDecl (const)
	s := 5                     // ShortVarDecl (simple)
	s++                        // IncDecStmt (simple)
	total = s                  // Assignment (simple)
	helper()                   // ExpressionStmt (simple)
	{                          // Block
		total = total + STEP
	}
	if total > 0 {             // IfStmt
		total = total + 1
	}
	for i := 0; i < 2; i++ {   // ForStmt
		total = total + i
	}
	if total == 10 { testing.Println("ok") } else { testing.Println("FAIL") }
}
