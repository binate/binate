package "main"

// stmt.simple (§14.1, §14.9): a simple statement is exactly the form permitted
// in a for clause's init and post slots. Here the init is a ShortVarDecl, the
// post is an IncDecStmt, and the loop body uses an Assignment -- all SimpleStmt
// forms -- so the loop runs and the sum proves the slots executed.

func main() {
	var sum int = 0
	for i := 0; i < 5; i++ {
		sum = sum + i
	}
	if sum == 10 { println("ok") } else { println("FAIL") }
}
