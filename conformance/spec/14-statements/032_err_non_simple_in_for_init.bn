package "main"

// stmt.simple (§14.1, §14.9): only a SimpleStmt may occupy a for-clause init
// slot. A `return` is a non-simple statement; the parser parses the init slot
// as an expression-led simple statement, so the keyword fails to parse as an
// expression and the program is REJECTED. The rule-satisfying neighbor (a
// ShortVarDecl/Assignment init) compiles.

func main() {
	for return; true; {
	}
}
