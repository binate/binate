package "main"

// stmt.block (§14.1): a block `{ ... }` introduces a new lexical scope. An inner
// declaration of `x` shadows the outer `x` for the extent of the block; after
// the block exits, the outer `x` is unchanged. We capture the inner value to
// prove the shadow took effect and check the outer value survived.

func main() {
	var x int = 1
	var inner int = 0
	{
		var x int = 99
		inner = x
	}
	if x == 1 && inner == 99 { println("ok") } else { println("FAIL") }
}
