package "main"
import "pkg/builtins/testing"

// stmt.empty (§14.2): an empty statement does nothing and arises chiefly from an
// omitted for-clause slot. Here both the init and post slots are empty
// (`for ; cond ; { ... }`); the loop still iterates correctly, proving the empty
// slots parse and contribute no effect.

func main() {
	var i int = 0
	var sum int = 0
	for ; i < 4 ; {
		sum = sum + i
		i++
	}
	if sum == 6 { testing.Println("ok") } else { testing.Println("FAIL") }
}
