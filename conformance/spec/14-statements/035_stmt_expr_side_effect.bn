package "main"
import "pkg/builtins/testing"

// stmt.expr (§14.3): an expression used as a statement is evaluated for its side
// effects and its value is discarded. Each `bump(&n)` call mutates `n` through a
// pointer and returns a value that is dropped; after two such expression
// statements `n` reflects the side effects.

func bump(p *int) int {
	*p = *p + 1
	return *p
}

func main() {
	var n int = 0
	bump(&n)
	bump(&n)
	if n == 2 { testing.Println("ok") } else { testing.Println("FAIL") }
}
