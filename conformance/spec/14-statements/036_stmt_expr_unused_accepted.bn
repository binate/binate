package "main"
import "pkg/builtins/testing"

// stmt.expr / stmt.expr.unused (§14.3, OPEN): any expression is permitted as a
// statement, including a pure, effect-free one. A bare `x + 1` is silently
// ACCEPTED -- the checker has no "evaluated but not used" diagnostic. This test
// documents the current behavior (it compiles and runs); it does NOT assert a
// rejection.

func main() {
	var x int = 5
	x + 1
	if x == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
