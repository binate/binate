package "main"
import "pkg/builtins/testing"

// stmt.decl (§14.7): a `var` or `const` declaration may appear as a statement
// (BlockDecl) inside a function body, following the rules of §9.1-§9.2. Both a
// local `var` and a local `const` are declared and their values read back.

func main() {
	var v int = 7
	const C int = 8
	if v == 7 && C == 8 { testing.Println("ok") } else { testing.Println("FAIL") }
}
