package "main"

// stmt.shortvar (§14.6): `:=` declares variables with types inferred from the
// right-hand side. A single `x := 10` infers int; a multi-valued call `q, r :=
// two()` distributes positionally; a blank `_ := 99` evaluates its value but
// binds nothing. We assert each binding holds its inferred value.

func two() (int, int) { return 3, 4 }

func main() {
	x := 10
	q, r := two()
	_ := 99
	if x == 10 && q == 3 && r == 4 { println("ok") } else { println("FAIL") }
}
