package "main"
import "pkg/builtins/testing"

// stmt.shortvar.rebind (§14.6): unlike Go, `:=` does NOT require a new name on
// the left. Re-using a name already bound in the same scope REBINDS it -- no "no
// new variables on left side" error. After `x := 1; x := 2`, x holds 2.

func main() {
	x := 1
	x := 2
	if x == 2 { testing.Println("ok") } else { testing.Println("FAIL") }
}
