package "main"
import "pkg/builtins/testing"

// stmt.incdec (§14.5): `x++` and `x--` add or subtract one in place on an
// integer-typed location. They are postfix, statement-only. Two increments and
// one decrement of `x` (starting at 5) leave it at 6.

func main() {
	var x int = 5
	x++
	x++
	x--
	if x == 6 { testing.Println("ok") } else { testing.Println("FAIL") }
}
