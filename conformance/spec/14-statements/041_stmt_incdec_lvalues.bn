package "main"

// stmt.incdec (§14.5 Note): the operand may be any integer-typed assignable
// location, not just a bare identifier -- an index `a[i]++`, a struct field
// `b.v++`, and a dereference `(*p)++` each increment in place (the lvalue forms
// lower like the corresponding assignment). We mutate all three and read back.

type Box struct { v int }

func main() {
	var a [3]int = [3]int{10, 20, 30}
	a[1]++
	var b Box = Box{5}
	b.v++
	var p *int = &a[0]
	(*p)++
	if a[1] == 21 && b.v == 6 && a[0] == 11 { println("ok") } else { println("FAIL") }
}
