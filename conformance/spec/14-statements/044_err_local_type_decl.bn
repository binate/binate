package "main"

// stmt.no-local-type (§14.1 Constraint): a `type` declaration is package-level
// only; writing one inside a function body is a parse error. Hence BlockDecl
// admits only `var` and `const`. The rule-satisfying neighbor (the same `type X
// int` at package level) compiles.

func main() {
	type X int
	var v X = 5
	_ = v
}
