package "main"

// stmt.decl.redeclare (§14.7 Constraint): declaring with `var` a name already
// declared in the SAME block scope is an error ("redeclared in this scope").
// Re-declaring `x` with `var` in the one function body scope must be rejected.
// The rule-satisfying neighbor (one `var x`, or a `var x` shadowing in an INNER
// block) compiles.

func main() {
	var x int = 1
	var x int = 2
	_ = x
}
