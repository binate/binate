package "main"

// stmt.shortvar: a `:=` binds each variable with the right-hand value's DEFAULT
// type; a string literal's default type is @[]readonly char (§6.6), so `s` is a
// managed-slice of bytes -- len 5 and s[0]=='h'==104.
func main() {
	s := "hello"
	if len(s) == 5 && cast(int, s[0]) == 104 { println("ok") } else { println("FAIL") }
}
