package "main"

// stmt.incdec: `++`/`--` apply to any integer lvalue, including a MANAGED-SLICE
// element `s[i]` (the spec Note lists s[i]++ alongside a[i]++). s[0] goes 5 -> 6.
func main() {
	var s @[]int = make_slice(int, 2)
	s[0] = 5
	s[0]++
	if s[0] == 6 && s[1] == 0 { println("ok") } else { println("FAIL") }
}
