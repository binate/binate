package "main"
import "pkg/builtins/testing"

// stmt.if: a bool condition selects the then-block when true and the
// else-block when false; only the selected branch runs (each is its own scope).
func main() {
	var x int = 5
	var a int = 0
	var b int = 0
	if x > 3 { a = 1 } else { b = 1 }
	if x < 3 { b = 2 } else { a = 2 }
	// then taken for first if (a=1), else taken for second if (a=2): a==2, b==0.
	if a == 2 && b == 0 { testing.Println("ok") } else { testing.Println("FAIL") }
}
