package "main"

// stmt.if: an else-if chain runs exactly ONE branch (the first whose
// condition is true); a hit-counter incremented in every branch must end at 1.
func main() {
	var x int = 3
	var hits int = 0
	if x == 1 { hits = hits + 1 } else if x == 2 { hits = hits + 1 } else if x == 3 { hits = hits + 1 } else { hits = hits + 1 }
	if hits == 1 { println("ok") } else { println("FAIL") }
}
