package "main"
import "pkg/builtins/testing"

// stmt.for: `for { }` with an empty clause is the infinite loop -- it runs
// until a `break`; the only loop construct (no while/do-while keyword).
func main() {
	var i int = 0
	for {
		i = i + 1
		if i == 5 { break }
	}
	if i == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
