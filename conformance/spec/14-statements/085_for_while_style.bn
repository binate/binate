package "main"

// stmt.for: the condition-only form `for cond { }` is the while-style loop
// (there is no `while` keyword); it runs while the bool condition holds.
func main() {
	var sum int = 0
	var i int = 0
	for i < 4 {
		sum = sum + i
		i = i + 1
	}
	// 0+1+2+3 == 6.
	if sum == 6 { println("ok") } else { println("FAIL") }
}
