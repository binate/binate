package "main"

// stmt.for.clause: the C-style form `for init; cond; post { }` -- a first
// simple statement followed by `;` selects this form (disambiguation D2).
func main() {
	var sum int = 0
	for i := 0; i < 4; i++ {
		sum = sum + i
	}
	// 0+1+2+3 == 6.
	if sum == 6 { println("ok") } else { println("FAIL") }
}
