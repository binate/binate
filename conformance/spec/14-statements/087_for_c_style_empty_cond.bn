package "main"
import "pkg/builtins/testing"

// stmt.for.clause: in the C-style form the cond slot may be EMPTY
// (`for init; ; post { }`) -- an absent condition means loop until break.
func main() {
	var sum int = 0
	for i := 0; ; i++ {
		if i == 4 { break }
		sum = sum + i
	}
	// 0+1+2+3 == 6.
	if sum == 6 { testing.Println("ok") } else { testing.Println("FAIL") }
}
