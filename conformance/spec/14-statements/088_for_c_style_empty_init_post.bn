package "main"

// stmt.for.clause: in the C-style form the init and post slots may be EMPTY
// (`for ; cond ; { }`) -- only the surrounding semicolons mark the form.
func main() {
	var sum int = 0
	var i int = 0
	for ; i < 4 ; {
		sum = sum + i
		i = i + 1
	}
	// 0+1+2+3 == 6.
	if sum == 6 { println("ok") } else { println("FAIL") }
}
