package "main"

// stmt.for.clause: D2 distinguishes the while-style form from C-style -- a
// first expression with NO trailing `;` is a while condition, not an init slot.
func main() {
	var i int = 0
	var n int = 0
	for i < 3 {       // while-style: comparison is the condition, not an init stmt
		i++
		n = n + 1
	}
	if n == 3 { println("ok") } else { println("FAIL") }
}
