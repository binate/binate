package "main"
import "pkg/builtins/testing"

// stmt.for.in: a SINGLE range variable binds the ELEMENT VALUE, not the index
// (the key difference from Go). Element values 10,20,30 sum to 60; the index
// sum would be 0+1+2 == 3, so a 60 result proves value-binding.
func main() {
	var a @[]int = make_slice(int, 3)
	a[0] = 10; a[1] = 20; a[2] = 30
	var sum int = 0
	for v in a {
		sum = sum + v
	}
	if sum == 60 { testing.Println("ok") } else { testing.Println("FAIL") }
}
