package "main"

// stmt.for.in: `for i, v in coll` binds i to the index (type int) and v to the
// value. Index sum 0+1+2 == 3 and value sum 100+200+300 == 600, distinct so
// both bindings are exercised independently.
func use(x int) int { return x }
func main() {
	var a @[]int = make_slice(int, 3)
	a[0] = 100; a[1] = 200; a[2] = 300
	var idxsum int = 0
	var valsum int = 0
	for i, v in a {
		idxsum = idxsum + use(i)   // use(int) confirms i has type int
		valsum = valsum + v
	}
	if idxsum == 3 && valsum == 600 { println("ok") } else { println("FAIL") }
}
