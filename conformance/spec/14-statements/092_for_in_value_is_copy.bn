package "main"
import "pkg/builtins/testing"

// stmt.for.in: the range value variable is a COPY of the element -- mutating
// `v` inside the loop does not write back into the collection. The iteration
// counter (asserted == 3) proves the body actually ran, so the unchanged-
// collection check is not vacuously satisfied by a zero-iteration loop.
func main() {
	var a @[]int = make_slice(int, 3)
	a[0] = 1; a[1] = 2; a[2] = 3
	var iters int = 0
	for v in a {
		v = v + 100        // mutate the loop copy only
		iters = iters + 1
		var _ int = v
	}
	if iters == 3 && a[0] == 1 && a[1] == 2 && a[2] == 3 { testing.Println("ok") } else { testing.Println("FAIL") }
}
