package "main"

// stmt.for.in: an array is an iterable; `for v in arr` ranges its elements
// (slice, managed-slice, and array are the iterable kinds).
func main() {
	var a [3]int
	a[0] = 5; a[1] = 6; a[2] = 7
	var sum int = 0
	for v in a {
		sum = sum + v
	}
	if sum == 18 { println("ok") } else { println("FAIL") }
}
