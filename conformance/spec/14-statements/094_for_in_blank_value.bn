package "main"

// stmt.for.in: a blank value `for _ in coll` binds nothing but still iterates
// once per element -- useful to count without using the value.
func main() {
	var a @[]int = make_slice(int, 4)
	var count int = 0
	for _ in a {
		count = count + 1
	}
	if count == 4 { println("ok") } else { println("FAIL") }
}
