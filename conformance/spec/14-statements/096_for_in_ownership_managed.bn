package "main"

// stmt.for.in.ownership: when the element type is managed, the value variable
// copy-owns its binding (retain on bind, release each iteration). Round-trip a
// managed element through the loop -- bind it, copy into an outer holder, read
// its field -- across all iterations to exercise the per-iteration ownership.
type Box struct { v int }
func main() {
	var a @[]@Box = make_slice(@Box, 3)
	a[0] = make(Box); a[0].v = 7
	a[1] = make(Box); a[1].v = 8
	a[2] = make(Box); a[2].v = 9
	var held @Box = a[0]
	var sum int = 0
	for b in a {
		held = b              // assign managed binding to an outer holder
		sum = sum + held.v
	}
	// 7+8+9 == 24; held ends at the last element (v==9).
	if sum == 24 && held.v == 9 { println("ok") } else { println("FAIL") }
}
