package "main"

// stmt.for.clause: in the while-style and C-style forms the condition, when
// present, must be bool -- there is no truthy coercion. `for 3 { }` has an int
// condition and is rejected ("non-bool condition"). The neighbor `for true { }`
// (with a break) compiles.
func main() {
	for 3 {
		println("x")
	}
}
