package "main"
import "pkg/builtins/testing"

// stmt.for.in: the range form iterates a slice, managed-slice, OR array. Here
// the iterable is a RAW slice (*[]int) taken over a managed-slice's backing;
// ranging it binds each element value.
func main() {
	var m @[]int = make_slice(int, 3)
	m[0] = 10; m[1] = 20; m[2] = 30
	var r *[]int = m[0:3]
	var sum int = 0
	for v in r { sum = sum + v }
	if sum == 60 { testing.Println("ok") } else { testing.Println("FAIL") }
}
