package "main"
import "pkg/builtins/testing"

// stmt.switch: a tagged switch dispatches on the tag value through case /
// multi-value-case / default clauses; classify() returns a distinct code for
// each clause, proving the switch routed control to exactly the right body.
func classify(n int) int {
	var r int = -1
	switch n {
	case 1:
		r = 10
	case 2, 3:
		r = 20
	default:
		r = 99
	}
	return r
}

func main() {
	if classify(1) == 10 && classify(2) == 20 && classify(3) == 20 && classify(7) == 99 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
