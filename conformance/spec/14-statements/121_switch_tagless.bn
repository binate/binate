package "main"
import "pkg/builtins/testing"

// stmt.switch: a TAGLESS switch is the condition-less form (Go's `switch true`)
// whose cases are boolean conditions, replacing a long if/else-if chain. It
// selects the first true case (here by sign of n).
func sign(n int) int {
	var r int = 0
	switch {
	case n > 0:
		r = 1
	case n < 0:
		r = -1
	default:
		r = 0
	}
	return r
}

func main() {
	if sign(5) == 1 && sign(-5) == -1 && sign(0) == 0 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
