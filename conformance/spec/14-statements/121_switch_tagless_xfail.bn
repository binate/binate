package "main"

// stmt.switch: a TAGLESS switch is the condition-less form (Go's `switch true`)
// whose cases are boolean conditions, replacing a long if/else-if chain. This
// SHOULD select the first true case and print ok, but the compiler currently
// crashes (SIGSEGV in IR-gen) on any tagless switch -- see xfail sidecar.
func sign(n int) int {
	var r int = 0
	switch {
	case n > 0:
		r = 1
	case n < 0:
		r = -1
	default:
		r = 0
	}
	return r
}

func main() {
	if sign(5) == 1 && sign(-5) == -1 && sign(0) == 0 {
		println("ok")
	} else {
		println("FAIL")
	}
}
