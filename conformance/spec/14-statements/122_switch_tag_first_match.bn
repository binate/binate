package "main"
import "pkg/builtins/testing"

// stmt.switch.tag: with a tag, the FIRST case whose value equals the tag is
// selected. case 1 appears twice -- duplicate cases are ACCEPTED (no
// duplicate-case check, unlike Go); sel(1) takes the earlier one (200, not
// 999), and an unmatched tag (5) falls to default.
func sel(n int) int {
	switch n {
	case 0:
		return 100
	case 1:
		return 200
	case 1:
		return 999
	default:
		return -1
	}
}

func main() {
	if sel(0) == 100 && sel(1) == 200 && sel(5) == -1 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
