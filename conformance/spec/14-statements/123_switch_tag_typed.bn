package "main"

// stmt.switch.tag: each case value must be ASSIGNABLE to the tag's type. Here
// the tag is a `char` (== uint8) and the case values are char-typed, so they
// are assignable and the matching case is chosen.
func main() {
	var c char = cast(char, 65)
	var r int = 0
	switch c {
	case cast(char, 64):
		r = 1
	case cast(char, 65):
		r = 2
	default:
		r = 9
	}
	if r == 2 { println("ok") } else { println("FAIL") }
}
