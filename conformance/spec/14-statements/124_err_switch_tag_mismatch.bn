package "main"

// stmt.switch.tag (constraint): each case value must be assignable to the tag's
// type. The tag `b` is `bool` and the case value `x` is `int`, which is not
// assignable to bool, so the case must be REJECTED. (The rule-satisfying
// neighbor -- a bool case value -- compiles; see 123 for an assignable tag.)
func main() {
	var b bool = true
	var x int = 5
	switch b {
	case x:
		println("yes")
	default:
		println("other")
	}
}
