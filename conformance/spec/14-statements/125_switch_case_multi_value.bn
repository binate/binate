package "main"

// stmt.switch.case: a case may list several values (`case 1, 2, 3:`) and
// matches ANY of them. hit() returns 1 for each listed value independently and
// 0 for values outside the list.
func hit(n int) int {
	switch n {
	case 1, 2, 3:
		return 1
	default:
		return 0
	}
}

func main() {
	if hit(1) == 1 && hit(2) == 1 && hit(3) == 1 && hit(0) == 0 && hit(4) == 0 {
		println("ok")
	} else {
		println("FAIL")
	}
}
