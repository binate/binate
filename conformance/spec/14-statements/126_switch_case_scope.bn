package "main"
import "pkg/builtins/testing"

// stmt.switch.case: each case body is its own lexical scope. Both case 1 and
// case 2 declare a local `x`; this is NOT a redeclaration error because the two
// `x`es live in separate scopes, and the selected case sees only its own.
func main() {
	var n int = 2
	var out int = 0
	switch n {
	case 1:
		var x int = 100
		out = x
	case 2:
		var x int = 200
		out = x
	}
	if out == 200 { testing.Println("ok") } else { testing.Println("FAIL") }
}
