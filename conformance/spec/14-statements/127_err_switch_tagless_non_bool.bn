package "main"

// stmt.switch.tagless-bool (constraint): a TAGLESS switch's case expressions
// are themselves the conditions (the `switch true` form), so each must be
// boolean.  `case 3:` is a non-bool case in a tagless switch and must be
// REJECTED.  (The rule-satisfying neighbor -- a bool case like `case n > 2:`
// -- compiles; see 121_switch_tagless.)
func main() {
	var n int = 5
	switch {
	case 3:
		println("three")
	default:
		println("other")
	}
	_ = n
}
