package "main"
import "pkg/builtins/testing"

// stmt.switch.default: the default clause (no `case` keyword) runs exactly when
// no case matches the tag. n==9 matches neither case, so the default body runs
// and sets hit to 99.
func main() {
	var n int = 9
	var hit int = 0
	switch n {
	case 1:
		hit = 1
	case 2:
		hit = 2
	default:
		hit = 99
	}
	if hit == 99 { testing.Println("ok") } else { testing.Println("FAIL") }
}
