package "main"

// stmt.switch.default: a default is NOT required, and exhaustiveness is not
// checked. This switch has no default; when no case matches (n==9) the switch
// simply does nothing and hit stays 0 -- the absent default is not an error.
func main() {
	var n int = 9
	var hit int = 0
	switch n {
	case 1:
		hit = 1
	case 2:
		hit = 2
	}
	if hit == 0 { println("ok") } else { println("FAIL") }
}
