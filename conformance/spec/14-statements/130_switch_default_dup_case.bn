package "main"

// stmt.switch.default: a `default` clause runs when no `case` matches. With
// n==5 neither case 1 nor case 2 matches, so the default body runs (r==99).
func main() {
	var r int = 0
	var n int = 5
	switch n {
	case 1:
		r = 11
	case 2:
		r = 22
	default:
		r = 99
	}
	if r == 99 { println("ok") } else { println("FAIL") }
}
