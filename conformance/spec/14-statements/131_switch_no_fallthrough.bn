package "main"
import "pkg/builtins/testing"

// stmt.switch.no-fallthrough: a case body runs to its end and control leaves
// the switch -- it never flows into the next case. n==1 selects case 1 only;
// case 2 must not run, so hits == 1 (a fall-through would give 101).
func main() {
	var hits int = 0
	var n int = 1
	switch n {
	case 1:
		hits = hits + 1
	case 2:
		hits = hits + 100
	}
	if hits == 1 { testing.Println("ok") } else { testing.Println("FAIL") }
}
