package "main"

// stmt.switch (OPEN stmt.switch.break, §14.10): a `break` inside a switch that
// is itself inside a loop currently breaks the ENCLOSING LOOP, not the switch
// (the reverse of Go). This pins current behavior: when i reaches 2 the break
// exits the for loop, so only i==0 and i==1 are summed -> sum == 1. (If break
// targeted only the switch, the loop would continue and sum would be 8.)
func main() {
	var sum int = 0
	var i int = 0
	for i < 5 {
		switch i {
		case 2:
			break
		default:
			sum = sum + i
		}
		i = i + 1
	}
	if sum == 1 { println("ok") } else { println("FAIL") }
}
