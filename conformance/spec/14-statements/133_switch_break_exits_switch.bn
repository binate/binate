package "main"

// stmt.switch.break (§14.10): a `break` inside a switch exits the SWITCH, not an
// enclosing loop (Go-like). When i==2 the break leaves the switch and the loop
// CONTINUES, so every i except 2 is summed: 0+1+3+4 == 8. (If break targeted the
// loop instead, only i==0 and i==1 would run and sum would be 1.)
func main() {
	var sum int = 0
	var i int = 0
	for i < 5 {
		switch i {
		case 2:
			break
		default:
			sum = sum + i
		}
		i = i + 1
	}
	if sum == 8 { println("ok") } else { println("FAIL") }
}
