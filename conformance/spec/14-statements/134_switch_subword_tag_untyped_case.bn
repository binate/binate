package "main"
import "pkg/builtins/testing"

// stmt.switch.tag: an untyped integer-literal case value is assignable to a
// sub-64-bit integer tag by coercion, so the matching case is selected.  This
// regresses the codegen bug where the untyped literal was emitted at the host
// int width (i64) and then compared (`icmp eq iN`) against the narrower tag,
// producing invalid IR ("i64 but expected i8/i16/i32") that clang rejected.
// Covers every sub-word tag width (char/uint8, int8, int16, int32) with both
// positive and negative case literals; int/int64 tags and a cast case value
// (cast(char,65)) were always fine.
// claude-todo MAJOR: switch subword-tag untyped-case codegen.

func pickChar(c char) int {
	switch c {
	case 64: return 1
	case 65: return 2
	default: return 0
	}
}

func pickI8(v int8) int {
	switch v {
	case 7: return 1
	case -8: return 2
	default: return 0
	}
}

func pickI16(v int16) int {
	switch v {
	case 300: return 1
	case -300: return 2
	default: return 0
	}
}

func pickI32(v int32) int {
	switch v {
	case 70000: return 1
	case -70000: return 2
	default: return 0
	}
}

func main() {
	if pickChar(cast(char, 65)) == 2 && pickChar(cast(char, 64)) == 1 &&
			pickChar(cast(char, 9)) == 0 &&
			pickI8(cast(int8, 7)) == 1 && pickI8(cast(int8, -8)) == 2 &&
			pickI8(cast(int8, 0)) == 0 &&
			pickI16(cast(int16, 300)) == 1 && pickI16(cast(int16, -300)) == 2 &&
			pickI16(cast(int16, 0)) == 0 &&
			pickI32(cast(int32, 70000)) == 1 && pickI32(cast(int32, -70000)) == 2 &&
			pickI32(cast(int32, 0)) == 0 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
