package "main"

// stmt.switch.tag: an untyped integer literal case value is assignable to a
// sub-64-bit integer tag (here char == uint8) by coercion, so the matching case
// should be selected. XFAIL: codegen emits the untyped literal as i64 and then
// compares it (`icmp eq i8`) against the i8 tag, producing invalid IR ("i64 but
// expected i8") -- clang fails. Hits any sub-64-bit tag (int8/int16/int32/uint8/
// char); int/int64 tags and a cast case value (cast(char,65)) are fine.
// claude-todo MAJOR: switch subword-tag untyped-case codegen.
func pick(c char) int {
	switch c {
	case 64:
		return 1
	case 65:
		return 2
	default:
		return 0
	}
}

func main() {
	if pick(cast(char, 65)) == 2 && pick(cast(char, 64)) == 1 && pick(cast(char, 9)) == 0 {
		println("ok")
	} else {
		println("FAIL")
	}
}
