package "main"
import "pkg/builtins/testing"

// stmt.switch.tagless-bool / stmt.switch.case: a tagless switch case may list
// several boolean conditions (`case c1, c2:`), matching if ANY is true. Pins
// the multi-expr OR-chain lowering, distinct from the single-condition path.
func classify(n int) int {
	var r int = 0
	switch {
	case n == 1, n == 2:
		r = 12
	case n == 3, n == 4, n == 5:
		r = 345
	default:
		r = -1
	}
	return r
}

func main() {
	if classify(1) == 12 && classify(2) == 12 && classify(4) == 345 &&
			classify(9) == -1 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
