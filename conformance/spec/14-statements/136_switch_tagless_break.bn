package "main"
import "pkg/builtins/testing"

// stmt.switch.break: `break` inside a switch case exits the switch, so a
// statement after the `break` does not run (a case never falls through, so
// break is only for early exit). Here `break` skips `r = 999`, leaving r = 1.
func withBreak(n int) int {
	var r int = 0
	switch {
	case n > 0:
		r = 1
		break
		r = 999
	default:
		r = -1
	}
	return r
}

func main() {
	if withBreak(5) == 1 { testing.Println("ok") } else { testing.Println("FAIL") }
}
