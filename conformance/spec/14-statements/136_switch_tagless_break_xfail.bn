package "main"

// stmt.switch.break (OPEN / known defect): `break` inside a switch case should
// terminate the case, so the statement after `break` must NOT run. It currently
// DOES (genSwitch sets no ctx.BreakTo, so break is a no-op with no enclosing
// loop), so this prints "FAIL". Pre-existing (tagged switches too); newly
// reachable for tagless after the crash fix. See claude-todo MAJOR (2026-06-27).
func withBreak(n int) int {
	var r int = 0
	switch {
	case n > 0:
		r = 1
		break
		r = 999
	default:
		r = -1
	}
	return r
}

func main() {
	if withBreak(5) == 1 { println("ok") } else { println("FAIL") }
}
