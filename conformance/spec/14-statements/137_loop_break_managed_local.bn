package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// stmt.break: a managed local declared in a loop body BEFORE a `break` must be
// released on the break path. `held` aliases the shared `s` (a RefInc), then the
// loop breaks; `s`'s refcount must return to baseline (1). Pre-fix the break path
// emitted no scope dec, so `held` leaked and the refcount stayed 2 (and a
// double-release would instead corrupt/crash the refcount read).
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	for i := 0; i < 10; i = i + 1 {
		var held @Box = s
		held.v = i
		break
	}
	testing.Println(rt.Refcount(p))
}
