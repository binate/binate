package "main"

import "pkg/builtins/rt"

// stmt.break (for-in): a managed body local declared before a `break` is released
// on the break path, DISJOINT from the loop's per-iteration value-var release —
// so the aliased shared object returns to baseline (no leak) and is not
// double-released (that would corrupt the refcount read).
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	var a @[]@Box = make_slice(@Box, 3)
	a[0] = make(Box)
	a[1] = make(Box)
	a[2] = make(Box)
	for e in a {
		var held @Box = s
		held.v = e.v
		break
	}
	println(rt.Refcount(p))
}
