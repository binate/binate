package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// stmt.continue: a managed local declared before a `continue` must be released on
// the continue path. Each of the 50 iterations aliases `s` into `held` (a RefInc)
// then continues; `s`'s refcount must return to baseline (1). Pre-fix each
// continue leaked one ref, so the refcount would climb to 51.
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	for i := 0; i < 50; i = i + 1 {
		var held @Box = s
		held.v = i
		continue
	}
	testing.Println(rt.Refcount(p))
}
