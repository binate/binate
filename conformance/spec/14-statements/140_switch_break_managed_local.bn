package "main"

import "pkg/builtins/rt"

// stmt.switch.break: a managed local declared in a switch case BEFORE a `break`
// must be released on the break path. `held` aliases the shared `s` (a RefInc),
// then breaks out of the switch; `s` returns to baseline (1). With no enclosing
// loop, BreakVarLen is the var count at switch entry — if it were left at its
// default (0) the break would RefDec every function local (incl. `s`), a
// double-release that corrupts the refcount read.
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	switch {
	case true:
		var held @Box = s
		held.v = 1
		break
	}
	println(rt.Refcount(p))
}
