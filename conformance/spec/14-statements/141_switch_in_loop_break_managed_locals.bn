package "main"

import "pkg/builtins/rt"

// stmt.switch.break: a `break` inside a switch-in-a-loop exits ONLY the switch —
// it must RefDec the switch case's own local (caseLocal) but NOT the enclosing
// loop body's local (loopLocal), which stays live for the rest of the iteration
// and is released at iteration end. So `s`'s refcount returns to baseline (1)
// with no leak and no double-release, and loopLocal is still valid after the
// break (its field read into sum). caseLocal aliases s and sets s.v=i, so
// loopLocal.v reads i each iteration: sum == 0+1+2+3+4 == 10.
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	var sum int = 0
	for i := 0; i < 5; i = i + 1 {
		var loopLocal @Box = s
		switch {
		case true:
			var caseLocal @Box = s
			caseLocal.v = i
			break
		}
		sum = sum + loopLocal.v
	}
	println(rt.Refcount(p))
	println(sum)
}
