package "main"

import "pkg/builtins/rt"

// stmt.switch.break: genSwitch must RESTORE ctx.BreakTo/BreakVarLen (saved at switch
// entry) on its DEFAULT-case early-return path, so a `break` AFTER the switch targets
// the enclosing LOOP, not the just-exited switch. Without the restore the post-switch
// break jumps back into switch.exit (an infinite self-loop → the program HANGS) and
// skips loopLocal's RefDec (a leak). loopLocal aliases s; the loop breaks on the first
// iteration, so s returns to baseline (1) and the program must terminate.
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	for i := 0; i < 5; i = i + 1 {
		var loopLocal @Box = s
		loopLocal.v = i
		switch i {
		default:
			var dflt @Box = s
			dflt.v = 99
			break
		}
		break
	}
	println(rt.Refcount(p))
}
