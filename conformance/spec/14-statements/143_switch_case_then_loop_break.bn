package "main"

import "pkg/builtins/rt"

// stmt.switch.break: genSwitch must RESTORE ctx.BreakTo/BreakVarLen on its FINAL
// return path (a switch with expression cases and NO default), so a `break` AFTER the
// switch targets the enclosing LOOP. Without the restore the post-switch break
// self-loops on switch.exit (the program HANGS) and leaks loopLocal. The loop breaks
// on the first iteration, so s returns to baseline (1).
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	for i := 0; i < 5; i = i + 1 {
		var loopLocal @Box = s
		loopLocal.v = i
		switch i {
		case 0:
			var c0 @Box = s
			c0.v = 7
			break
		}
		break
	}
	println(rt.Refcount(p))
}
