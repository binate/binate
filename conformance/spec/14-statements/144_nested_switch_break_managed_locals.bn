package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// stmt.switch.break: nested switches — the inner switch must save/restore
// ctx.BreakVarLen so the inner `break` RefDecs only the inner case's local, and the
// outer `break` still RefDecs the OUTER case's local. Without the restore the outer
// break dec's from the inner's (higher) BreakVarLen and leaks `outer`. s returns to
// baseline (1).
type Box struct { v int }

func main() {
	var s @Box = make(Box)
	var p *uint8 = bit_cast(*uint8, s)
	switch 1 {
	case 1:
		var outer @Box = s
		outer.v = 1
		switch 2 {
		case 2:
			var inner @Box = s
			inner.v = 2
			break
		}
		break
	}
	testing.Println(rt.Refcount(p))
}
