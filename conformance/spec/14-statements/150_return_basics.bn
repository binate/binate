package "main"

// stmt.return: the number of returned expressions equals the result count;
// a bare `return` is used by a no-result function; and a tail-call
// `return f()` forwards a function whose results match the declared tuple.
func two() (int, int) { return 3, 4 }

func sum() int {
	var a int = 0
	a = 5
	return a
}

func nores() {
	if true { return }
	println("FAIL")
}

func forward() (int, int) { return two() }

func main() {
	var ok bool = true
	if sum() != 5 { ok = false }
	var x int = 0
	var y int = 0
	x, y = forward()
	if x != 3 || y != 4 { ok = false }
	nores()
	if ok { println("ok") } else { println("FAIL") }
}
