package "main"

// stmt.return.ownership: a returned managed value transfers an owning
// reference to the caller; the caller reads it and lets it drop. Repeating
// the allocation many times would crash or leak if the owning ref were not
// transferred correctly.
type Box struct { v int }

func makeBox(n int) @Box {
	var b @Box = make(Box)
	b.v = n
	return b
}

func main() {
	var ok bool = true
	var b @Box = makeBox(42)
	if b.v != 42 { ok = false }
	var i int = 0
	for i < 100 {
		var t @Box = makeBox(i)
		if t.v != i { ok = false }
		i = i + 1
	}
	if ok { println("ok") } else { println("FAIL") }
}
