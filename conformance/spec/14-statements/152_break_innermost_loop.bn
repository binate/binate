package "main"

// stmt.break: break exits the innermost enclosing loop only; the outer loop
// keeps iterating. The inner loop is entered three times and breaks at j==2
// each time, so it runs its body exactly twice per outer pass (6 total).
func main() {
	var ok bool = true
	var outerCount int = 0
	var innerCount int = 0
	var i int = 0
	for i < 3 {
		outerCount = outerCount + 1
		var j int = 0
		for j < 10 {
			if j == 2 { break }
			innerCount = innerCount + 1
			j = j + 1
		}
		i = i + 1
	}
	if outerCount != 3 { ok = false }
	if innerCount != 6 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
