package "main"

// stmt.break (this rule-ID covers both break and continue, §14.12): `continue`
// proceeds to the next loop iteration, skipping the rest of the body. Summing
// only even values in [0,10) gives 0+2+4+6+8 == 20.
func main() {
	var ok bool = true
	var sum int = 0
	var i int = 0
	for i < 10 {
		i = i + 1
		if (i - 1) % 2 != 0 { continue }
		sum = sum + (i - 1)
	}
	if sum != 20 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
