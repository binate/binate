package "main"

// stmt.terminating: each of these result-returning functions terminates on
// every path by a different terminator form: a final return; an if/else where
// both branches terminate; an unconditional for{} that returns from inside;
// and a tagged switch with default where every case terminates. They compile
// (the syntactic analysis passes) and yield the expected values.
func a() int { return 1 }

func b(x int) int {
	if x > 0 {
		return 10
	} else {
		return 20
	}
}

func c() int {
	var i int = 0
	for {
		i = i + 1
		if i == 5 { return i }
	}
}

func d(n int) int {
	switch n {
	case 1:
		return 100
	case 2:
		return 200
	default:
		return 300
	}
}

func main() {
	var ok bool = true
	if a() != 1 { ok = false }
	if b(5) != 10 { ok = false }
	if b(-1) != 20 { ok = false }
	if c() != 5 { ok = false }
	if d(1) != 100 { ok = false }
	if d(2) != 200 { ok = false }
	if d(9) != 300 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
