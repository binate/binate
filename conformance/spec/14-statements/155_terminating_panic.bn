package "main"
import "pkg/builtins/testing"

// stmt.terminating: panic(...) as an expression statement is a terminating
// statement, so a result-returning function whose final statement is panic()
// passes the terminating analysis without a trailing return. The panicking
// path is not exercised at runtime.
func mustPos(x int) int {
	if x > 0 {
		return x
	}
	panic("non-positive")
}

func main() {
	var ok bool = true
	if mustPos(7) != 7 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
