package "main"
import "pkg/builtins/testing"

// stmt.return.arity: returning one value from a two-result function is
// rejected -- the returned-expression count must equal the result count.
func two() (int, int) {
	return 1
}

func main() {
	var a int = 0
	var b int = 0
	a, b = two()
	testing.Println(a)
	testing.Println(b)
}
