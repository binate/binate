package "main"
import "pkg/builtins/testing"

// stmt.terminating: a switch with no `default` does not terminate even when
// every case returns -- the analysis is syntactic, so this is rejected with
// "missing return".
func g(n int) int {
	switch n {
	case 1:
		return 10
	case 2:
		return 20
	}
}

func main() {
	testing.Println(g(1))
}
