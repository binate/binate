package "main"
import "pkg/builtins/testing"

// stmt.terminating: a block whose LAST statement terminates is itself a
// terminating statement, so a function body that is just a nested block ending
// in `return` satisfies the every-path-terminates requirement (no missing return).
func f() int {
	{
		return 5
	}
}

func main() {
	if f() == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
