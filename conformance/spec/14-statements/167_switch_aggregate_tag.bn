package "main"
import "pkg/builtins/testing"

// stmt.switch.tag: a comparable AGGREGATE switch tag (struct / non-char array)
// matches its case ELEMENT-WISE (via genAggregateEq), not by a raw scalar compare
// of the aggregate bytes.  Matching is by content, so an equal-content case value
// matches and a differing one does not.
type Point struct {
	x int
	y int
}

func main() {
	var ok bool = true

	var p Point
	p.x = 1
	p.y = 2
	var q Point
	q.x = 1
	q.y = 2
	var r Point
	r.x = 9
	r.y = 2
	var mp int = 0
	switch p {
	case r:
		mp = 1
	case q:
		mp = 2
	}
	if mp != 2 { ok = false } // p equals q by content, not r

	var a [3]int
	a[0] = 10
	a[1] = 20
	a[2] = 30
	var b [3]int
	b[0] = 10
	b[1] = 20
	b[2] = 30
	var d [3]int
	d[0] = 99
	d[1] = 0
	d[2] = 0
	var ma int = 0
	switch a {
	case d:
		ma = 1
	case b:
		ma = 2
	}
	if ma != 2 { ok = false } // a equals b by content, not d

	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
