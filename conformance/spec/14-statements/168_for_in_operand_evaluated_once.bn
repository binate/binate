package "main"

import "pkg/builtins/testing"

// stmt.for.in.operand (§14.9): the operand is evaluated once into a hidden
// variable that lives until the loop exits, as if by `tmp := coll`.  An array
// operand is copied, so the write to a[2] during the loop is not seen; a
// slice's elements are read through its data pointer, so the write to s[2] is
// seen; a managed-slice variable reassigned during the loop leaves the loop
// ranging what it started with; a call operand is evaluated once.

var calls int = 0

func mk() @[]int {
	calls = calls + 1
	var s @[]int = make_slice(int, 3)
	s[0] = 1
	s[1] = 2
	s[2] = 3
	return s
}

func main() {
	var a [3]int = [3]int{1, 2, 3}
	var t int = 0
	for i, x in a {
		if i == 0 {
			a[2] = 30
		}
		t = t * 10 + x
	}
	testing.Println(t) // 123
	var s @[]int = mk()
	t = 0
	for i, x in s {
		if i == 0 {
			s[2] = 30
		}
		t = t * 100 + x
	}
	testing.Println(t) // 10230
	t = 0
	for x in s {
		s = make_slice(int, 1)
		t = t * 100 + x
	}
	testing.Println(t) // 10230
	t = 0
	for x in mk() {
		t = t + x
	}
	testing.Println(t) // 6
	testing.Println(calls) // 2
}
