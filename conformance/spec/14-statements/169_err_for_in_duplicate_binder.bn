package "main"

import "pkg/builtins/testing"

// stmt.for.in.duplicate (§14.9): a range loop's index and value variables must
// have different names, so `for i, i in xs` is REJECTED.  The rule-satisfying
// neighbor (`for _, _ in xs`) compiles.

func main() {
	var xs [2]int = [2]int{5, 6}
	var n int = 0
	for _, _ in xs {
		n = n + 1
	}
	for i, i in xs {
		n = n + i
	}
	testing.Println(n)
}
