package "main"

import "pkg/builtins/testing"

// stmt.for.in (§14.9): a string literal operand is ranged with its natural type
// `[N]readonly char`, over its N bytes after escape decoding — one iteration
// per byte, the index counting from 0; an empty literal iterates zero times.

func main() {
	for c in "hi" {
		testing.Println(c) // 104, 105
	}
	var n int = 0
	for i, c in "a\nb" {
		n = n * 1000 + i * 100 + cast(int, c)
	}
	testing.Println(n) // 97110298
	var k int = 0
	for _ in "" {
		k = k + 1
	}
	testing.Println(k) // 0
}
