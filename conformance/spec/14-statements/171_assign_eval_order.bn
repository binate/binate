package "main"

import "pkg/builtins/testing"

// Every assignment evaluates its right-hand side (every expression of a
// parallel assignment, left to right), then every target's designator operands
// (left to right), then the stores (left to right); `x++` evaluates as
// `x += 1`.  So a multiple or parallel assignment `k, a[k] = ...` stores into
// the element at the OLD k, and `p, p.v = ...` into the OLD *p, which is only
// released after the last store.  Each base, index and right-hand value below
// is a call that logs itself; each line ends with the form it exercised.

type Node struct {
	v int
}

var arr [3]int
var nest [3][3]int
var np @Node

func base() *([3]int) {
	testing.Print("base ")
	return &arr
}

func nbase() *([3][3]int) {
	testing.Print("base ")
	return &nest
}

func ptr() *int {
	testing.Print("ptr ")
	return &arr[2]
}

func idx(tag *[]readonly char) int {
	testing.Print(tag)
	testing.Print(" ")
	return 1
}

func val(tag *[]readonly char) int {
	testing.Print(tag)
	testing.Print(" ")
	return 5
}

func pair() (int, int) {
	testing.Print("rhs ")
	return 6, 7
}

func two() (int, int) {
	return 2, 9
}

func end(what *[]readonly char) {
	testing.Print("<- ")
	testing.Println(what)
}

func main() {
	(*base())[idx("i")] = val("rhs")
	end("x[i] = v")
	(*base())[idx("i")] += val("rhs")
	end("x[i] += v")
	(*base())[idx("i")] += 1
	end("x[i] += 1")
	(*base())[idx("i")]++
	end("x[i]++")
	*ptr() = val("rhs")
	end("*p = v")
	(*base())[idx("i")], *ptr() = pair()
	end("x[i], *p = f()")
	(*base())[idx("i")], (*nbase())[idx("j")][idx("k")] = val("rhs1"), val("rhs2")
	end("x[i], y[j][k] = v1, v2")

	var fresh [3]int
	var k int = 0
	k, fresh[k] = two()
	testing.Print("k, a[k] = f(): a[0]=")
	testing.Print(fresh[0])
	testing.Print(" a[2]=")
	testing.Println(fresh[2])
	var m int = 0
	m, fresh[m] = 2, 8
	testing.Print("m, a[m] = 2, 8: a[0]=")
	testing.Print(fresh[0])
	testing.Print(" a[2]=")
	testing.Println(fresh[2])
	fresh[1], fresh[1] = 3, 4
	testing.Print("a[1], a[1] = 3, 4: a[1]=")
	testing.Println(fresh[1])
	np = make(Node)
	var keep @Node = np
	np, np.v = make(Node), 1
	testing.Print("p, p.v = q, 1: old v=")
	testing.Print(keep.v)
	testing.Print(" new v=")
	testing.Println(np.v)
	np, np.v = make(Node), 2
	testing.Print("p, p.v = q, 2 (p the only reference): new v=")
	testing.Println(np.v)
	testing.Println(k + m)
}
