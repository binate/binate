package "main"

import "pkg/builtins/testing"

// An assignment evaluates its right-hand expressions left to right, so a
// by-value aggregate value is copied when it is evaluated: a LATER right-hand
// expression's side effect on the aggregate's storage is not seen by the
// target — for a global struct, a global array, and a local struct changed
// through a pointer.

type T struct {
	v int
	w int
}

var gt T
var ga [2]int

func bumpT() int {
	gt.v = 99
	return 1
}

func bumpA() int {
	ga[0] = 99
	return 1
}

func setLocal(p *T) int {
	p.v = 99
	return 1
}

func main() {
	var x T
	var a [2]int
	var n int
	x, n = gt, bumpT()
	testing.Println(x.v + n)
	a, n = ga, bumpA()
	testing.Println(a[0] + n)
	var lt T
	x, n = lt, setLocal(&lt)
	testing.Println(x.v + n)
}
