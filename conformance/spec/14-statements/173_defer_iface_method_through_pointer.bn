package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred interface-method call through a pointer to an
// interface value — `(&iv).M()`, `piv.M()` with piv a `*(*I)`, and their
// managed forms — auto-dereferences the pointer like the plain call, and the
// receiver (the interface value) is evaluated when the defer statement
// executes: reassigning the interface variable afterwards does not change
// which object the deferred call reaches.  The retained receivers are released
// at function exit (the live-block count does not climb).

interface Shower {
	Show(tag int)
}

type Sh struct {
	n int
}

func (s *Sh) Show(tag int) {
	if tag > 0 { testing.Println("show", tag, s.n) }
}

impl *Sh : Shower

func run(iv *Shower, mv @Shower, tag int) {
	defer (&iv).Show(tag)
	defer (&mv).Show(tag * 2)
	var piv *(*Shower) = &iv
	defer piv.Show(tag * 3)
	var pmv @(@Shower) = box(mv)
	defer pmv.Show(tag * 4)
	var other Sh = Sh{n: 99}
	iv = &other
	if tag > 0 { testing.Println("body") }
}

func main() {
	var s Sh = Sh{n: 7}
	var ms @Sh = make(Sh)
	ms.n = 8
	run(&s, ms, 1)
	var base int = rt.LiveBlocks()
	for i := 0; i < 20; i++ {
		run(&s, ms, 0)
	}
	testing.Println("live", rt.LiveBlocks() - base)
}
