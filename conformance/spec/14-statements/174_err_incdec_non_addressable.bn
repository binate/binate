package "main"

import "pkg/builtins/testing"

// stmt.incdec / expr.addressable: `x++` is `x += 1`, so its operand must be
// addressable, like a compound assignment's target.  A field of a by-value call
// result is a throwaway copy — incrementing it would change nothing — and is
// rejected.

type S struct {
	x int
}

func getS() S {
	var s S
	return s
}

func main() {
	getS().x++
	testing.Println(1)
}
