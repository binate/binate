package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred block's calls evaluate their receivers and arguments
// when the block runs.  A managed `@T` bound there to a raw `*T` receiver or
// parameter is borrowed for the call like any call's: a call result lives until
// the deferred statement ends (clobber, run before the deferred block, would
// show a value freed early), and is released then.

type Thing struct {
	n   int
	pad [6]int
}

var seenRecv int

var seenArg int

var seenDeref int

var seenLocal int

func (t *Thing) Get() int {
	seenRecv = t.n
	return t.n
}

func (t *Thing) GetDeref() int {
	seenDeref = seenDeref * 100 + t.n
	return t.n
}

func (t *Thing) GetLocal() int {
	seenLocal = t.n
	return t.n
}

func use(t *Thing) int {
	seenArg = t.n
	return t.n
}

func mk(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 999
		_ = a
	}
}

func run() {
	defer { mk(41).Get() }
	defer { use(mk(42)) }
	clobber()
}

// An explicit dereference `(*X).m()` passes X itself, or the pointer X points
// at — read when the deferred block runs, after `*pp = mk(45)`.
func runDeref(pp *@Thing) {
	defer { (*mk(43)).GetDeref() }
	defer { (*pp).GetDeref() }
	*pp = mk(45)
	clobber()
}

// A managed local is read when the deferred block runs: the call receives its
// value then, after the reassignment.
func runLocal() {
	var a @Thing = mk(46)
	defer { a.GetLocal() }
	a = mk(47)
	clobber()
}

func main() {
	var live int = rt.LiveBlocks()
	run()
	var p @Thing = mk(44)
	runDeref(&p)
	runLocal()
	var none @Thing
	p = none
	var leaked int = rt.LiveBlocks() - live
	testing.Println(seenRecv, seenArg, seenDeref, seenLocal, leaked)
}
