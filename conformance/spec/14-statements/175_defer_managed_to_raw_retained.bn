package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred call's receiver and arguments are evaluated at the
// defer statement and retained until the call runs; where one undergoes a
// managed-to-raw conversion (a managed `@T` bound to a raw `*T` receiver or
// parameter), the managed value is what is retained, and the borrow is
// delivered at call time.  So a call result used there stays alive (clobber
// reuses freed memory, which a freed one would show), and it is released after
// the deferred call runs.

type Thing struct {
	n   int
	pad [6]int
}

var seenRecv int

var seenArg int

var seenDeref int

var seenLocal int

func (t *Thing) Get() int {
	seenRecv = t.n
	return t.n
}

func (t *Thing) GetDeref() int {
	seenDeref = seenDeref * 100 + t.n
	return t.n
}

func (t *Thing) GetLocal() int {
	seenLocal = t.n
	return t.n
}

func use(t *Thing) int {
	seenArg = t.n
	return t.n
}

func mk(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 999
		_ = a
	}
}

func run() {
	defer mk(41).Get()
	defer use(mk(42))
	clobber()
}

// An explicit dereference `(*X).m()` passes X itself, or the pointer X points
// at: a managed receiver either way, retained like any other.
func runDeref(pp *@Thing) {
	defer (*mk(43)).GetDeref()
	defer (*pp).GetDeref()
	*pp = mk(45)
	clobber()
}

// A managed local's value at the defer statement is what the call receives,
// though the local is reassigned before the call runs.
func runLocal() {
	var a @Thing = mk(46)
	defer a.GetLocal()
	a = mk(47)
	clobber()
}

func main() {
	var live int = rt.LiveBlocks()
	run()
	var p @Thing = mk(44)
	runDeref(&p)
	runLocal()
	var none @Thing
	p = none
	var leaked int = rt.LiveBlocks() - live
	testing.Println(seenRecv, seenArg, seenDeref, seenLocal, leaked)
}
