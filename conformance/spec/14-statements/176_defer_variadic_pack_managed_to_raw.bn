package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer, func.variadic.pack: a deferred call's trailing variadic arguments
// are evaluated at the defer statement and retained until the call runs; an
// `@T` packed into a `...*T` parameter is a managed-to-raw conversion, so the
// managed value is what is retained.  A call result packed there stays alive
// (clobber reuses freed memory, which a freed one would show) through the other
// deferred calls that run first, as does a local's value though the local is
// reassigned before the call; each is released after the calls.  The same holds
// for an `@[]T` packed into a `...*[]T`, for a pack that mixes managed and raw
// elements, after a fixed argument, for a method, and for a generic instance's
// element type (packed or as a fixed argument).

type Thing struct {
	n   int
	pad [6]int
}

type Box[T any] struct {
	v T
	s @[]int
}

type Acc struct {
	sum int
}

var seen int

func usev(ts ...*Thing) {
	for i := 0; i < len(ts); i++ {
		seen = seen * 100 + ts[i].n
	}
}

func usefv(k int, ts ...*Thing) {
	seen = k
	usev(ts...)
}

func (a *Acc) addv(ts ...*Thing) {
	usev(ts...)
}

func uses(xs ...*[]int) {
	for i := 0; i < len(xs); i++ {
		seen = seen * 100 + xs[i][0]
	}
}

func useBoxes(bs ...*Box[int]) {
	for i := 0; i < len(bs); i++ {
		seen = seen * 100 + bs[i].v + bs[i].s[0]
	}
}

func useBox(b *Box[int]) { seen = seen * 100 + b.v + b.s[0] }

func mk(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func mkS(n int) @[]int {
	var s @[]int = make_slice(int, 8)
	s[0] = n
	return s
}

func mkBox(n int) @Box[int] {
	var b @Box[int] = make(Box[int])
	b.v = n
	b.s = make_slice(int, 1)
	return b
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		var s @[]int = make_slice(int, 8)
		s[0] = 99
		var b @Box[int] = make(Box[int])
		b.v = 99
		_ = a
		_ = s
		_ = b
	}
}

func runTemp() {
	defer usev(mk(11), mk(12))
	defer clobber()
	clobber()
}

func runLocal() {
	var a @Thing = mk(13)
	defer usev(a)
	a = mk(14)
	clobber()
}

func runSlice() {
	defer uses(mkS(15), mkS(16))
	clobber()
}

func runMixed() {
	var keep @Thing = mk(17)
	var rp *Thing = keep
	defer usev(mk(18), rp, mk(19))
	clobber()
}

func runFixed() {
	defer usefv(7, mk(20), mk(21))
	clobber()
}

func runMethod() {
	var acc Acc
	defer acc.addv(mk(22), mk(23))
	clobber()
}

func runGeneric() {
	defer useBoxes(mkBox(24), mkBox(25))
	defer useBox(mkBox(26))
	clobber()
}

func main() {
	// The leak is measured before anything is printed: the first print can
	// allocate state that lives to program exit.
	var live int = rt.LiveBlocks()
	var got [7]int
	runTemp()
	got[0] = seen
	seen = 0
	runLocal()
	got[1] = seen
	seen = 0
	runSlice()
	got[2] = seen
	seen = 0
	runMixed()
	got[3] = seen
	seen = 0
	runFixed()
	got[4] = seen
	seen = 0
	runMethod()
	got[5] = seen
	seen = 0
	runGeneric()
	got[6] = seen
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < 6; i++ {
		testing.Println(got[i])
	}
	testing.Println(got[6], leaked)
}
