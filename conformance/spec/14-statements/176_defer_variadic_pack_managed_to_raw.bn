package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer, func.variadic.pack: a deferred call's trailing variadic arguments
// are evaluated at the defer statement and retained until the call runs; an
// `@T` packed into a `...*T` parameter is a managed-to-raw conversion, so the
// managed value is what is retained.  A call result packed there stays alive
// (clobber reuses freed memory, which a freed one would show), as does a local's
// value though the local is reassigned before the call, and both are released
// after the call.

type Thing struct {
	n   int
	pad [6]int
}

var seen int

func usev(ts ...*Thing) int {
	for i := 0; i < len(ts); i++ {
		seen = seen * 100 + ts[i].n
	}
	return seen
}

func mk(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		_ = a
	}
}

func runTemp() {
	defer usev(mk(11), mk(12))
	clobber()
}

func runLocal() {
	var a @Thing = mk(13)
	defer usev(a)
	a = mk(14)
	clobber()
}

func main() {
	var live int = rt.LiveBlocks()
	runTemp()
	runLocal()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(seen, leaked)
}
