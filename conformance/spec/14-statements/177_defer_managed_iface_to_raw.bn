package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred call's operands are evaluated at the defer statement and
// retained until the call runs; a managed interface value `@Getter` bound to a raw
// `*Getter` parameter (or packed into a `...*Getter`) is a managed-to-raw
// borrow, so the managed value is what is retained.  A call result passed there
// stays alive until the call (clobber reuses freed memory, which a freed one
// would show) and is released after it.

interface Getter {
	Get() int
}

type Thing struct {
	n   int
	pad [6]int
}

impl *Thing : Getter

func (t *Thing) Get() int { return t.n }

var seen int

func mkG(n int) @Getter {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func use1(g *Getter) { seen = seen * 100 + g.Get() }

func usev(gs ...*Getter) {
	for i := 0; i < len(gs); i++ {
		seen = seen * 100 + gs[i].Get()
	}
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		_ = a
	}
}

func runFixed() {
	defer use1(mkG(21))
	clobber()
}

func runPack() {
	defer usev(mkG(22), mkG(23))
	clobber()
}

func main() {
	var live int = rt.LiveBlocks()
	runFixed()
	runPack()
	testing.Println(seen, rt.LiveBlocks() - live)
}
