package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred call's operands are evaluated at the defer statement and
// retained until the call runs; a managed interface value `@Getter` bound to a raw
// `*Getter` parameter (or packed into a `...*Getter`) is a managed-to-raw
// borrow, so the managed value is what is retained.  A call result or a local
// passed there stays alive until the call (clobber reuses freed memory, which a
// freed one would show) and is released after it.

interface Getter {
	Get() int
}

// A `@Named` passed for a `*Getter` also takes the ancestor's sub-vtable
// (iface.extend.upcast).
interface Named : Getter {
	Name() int
}

type Thing struct {
	n   int
	pad [6]int
}

impl *Thing : Named

func (t *Thing) Get() int { return t.n }

func (t *Thing) Name() int { return 0 }

// A named type over an interface value is a value source: boxed into a raw
// interface it dispatches to its own method, and a deferred call retains the
// boxed snapshot (iface.construct.named-pointer).
type G @Getter

impl G : Getter

func (g G) Get() int {
	var u @Getter = cast(@Getter, g)
	return 50 + u.Get()
}

interface Sink {
	Put(g *Getter)
}

type Acc struct {
	k int
}

impl *Acc : Sink

func (a *Acc) Put(g *Getter) { seen = seen * 100 + g.Get() }

var seen int

func mkG(n int) @Getter {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func mkN(n int) @Named {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func use1(g *Getter) { seen = seen * 100 + g.Get() }

func usev(gs ...*Getter) {
	for i := 0; i < len(gs); i++ {
		seen = seen * 100 + gs[i].Get()
	}
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		_ = a
	}
}

func runFixed() {
	defer use1(mkG(21))
	clobber()
}

func runPack() {
	defer usev(mkG(22), mkG(23))
	clobber()
}

func runLocal() {
	var g @Getter = mkG(24)
	defer use1(g)
	g = mkG(25)
	clobber()
}

// Deferred calls run last-in first-out: usev, then use1.
func runUpcast() {
	defer use1(mkN(26))
	defer usev(mkN(27), mkG(28))
	clobber()
}

func runMixed() {
	var keep @Getter = mkG(29)
	var rp *Getter = keep
	defer usev(mkG(30), rp, mkG(31))
	clobber()
}

func runNamedValue() {
	var g G = cast(G, mkG(35))
	defer use1(g)
	g = cast(G, mkG(36))
	clobber()
}

// An interface-method call, a function-value call and a method call, each
// deferred with an `@Getter` argument for its `*Getter` parameter.
func runShapes() {
	var acc @Acc = make(Acc)
	var s @Sink = acc
	var fv *func(*Getter) = use1
	defer s.Put(mkG(32))
	defer fv(mkG(33))
	defer acc.Put(mkG(34))
	clobber()
}

func main() {
	// runShapes runs once first as a warm-up: the bytecode VM allocates each
	// call site's function-value table on first use and keeps it, which is not a
	// leak.  The leak is measured before anything is printed: the first print can
	// allocate state that lives to program exit.
	runShapes()
	seen = 0
	var live int = rt.LiveBlocks()
	var got [7]int
	runFixed()
	got[0] = seen
	seen = 0
	runPack()
	got[1] = seen
	seen = 0
	runLocal()
	got[2] = seen
	seen = 0
	runUpcast()
	got[3] = seen
	seen = 0
	runMixed()
	got[4] = seen
	seen = 0
	runNamedValue()
	got[5] = seen
	seen = 0
	runShapes()
	got[6] = seen
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < 6; i++ {
		testing.Println(got[i])
	}
	testing.Println(got[6], leaked)
}
