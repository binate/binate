package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred call's operands are evaluated at the defer statement and
// retained until the call runs; a managed function value `@func() int` bound to a
// raw `*func() int` parameter (or packed into a `...*func() int`) is a
// managed-to-raw conversion, so the managed value — its capture record — is
// what is retained.  A call result passed there stays alive until the call
// (clobber reuses freed memory, which a freed one would show) and is released
// after it.

var seen int

func mkF(n int) @func() int {
	var big [6]int
	big[0] = n
	return func() int { return big[0] }
}

func clobber() {
	for j := 0; j < 4; j++ {
		var g @func() int = mkF(99)
		_ = g
		var a @[]int = make_slice(int, 8)
		a[0] = 77
		_ = a
	}
}

func run1(f *func() int) {
	seen = seen * 100 + f()
}

func runv(fs ...*func() int) {
	for i := 0; i < len(fs); i++ {
		seen = seen * 100 + fs[i]()
	}
}

func fixedF() {
	defer run1(mkF(11))
	clobber()
}

func packF() {
	defer runv(mkF(12), mkF(13))
	clobber()
}

func main() {
	// The leak is measured before anything is printed: the first print can
	// allocate state that lives to program exit.
	var live int = rt.LiveBlocks()
	run1(mkF(21))
	runv(mkF(22), mkF(23))
	var direct int = seen
	seen = 0
	fixedF()
	var fixed int = seen
	seen = 0
	packF()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(direct)
	testing.Println(fixed)
	testing.Println(seen, leaked)
}
