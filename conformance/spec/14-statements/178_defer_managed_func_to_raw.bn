package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred block's calls evaluate their operands when the block
// runs.  A managed function value `@func() int` bound there to a raw
// `*func() int` parameter (or packed into a `...*func() int`) is borrowed for the
// call: a call result — and its capture record — lives until the deferred
// statement ends (clobber, run before, would show a value freed early) and is
// released then; a local is read as it is when the block runs, after its
// reassignment.

var seen int

func mkF(n int) @func() int {
	var big [6]int
	big[0] = n
	return func() int { return big[0] }
}

func clobber() {
	for j := 0; j < 4; j++ {
		var g @func() int = mkF(99)
		_ = g
		var a @[]int = make_slice(int, 8)
		a[0] = 77
		_ = a
	}
}

func run1(f *func() int) {
	seen = seen * 100 + f()
}

func runv(fs ...*func() int) {
	for i := 0; i < len(fs); i++ {
		seen = seen * 100 + fs[i]()
	}
}

func fixedF() {
	defer { run1(mkF(11)) }
	clobber()
}

func packF() {
	defer { runv(mkF(12), mkF(13)) }
	clobber()
}

func localF() {
	var f @func() int = mkF(14)
	defer { run1(f) }
	f = mkF(15)
	clobber()
}

func main() {
	// The direct calls come first and double as a warm-up: the bytecode VM
	// allocates each call site's function-value table on first use and keeps it,
	// which is not a leak.  The leak is measured before anything is printed: the
	// first print can allocate state that lives to program exit.
	run1(mkF(21))
	runv(mkF(22), mkF(23))
	var direct int = seen
	seen = 0
	var live int = rt.LiveBlocks()
	fixedF()
	var fixed int = seen
	seen = 0
	packF()
	var pack int = seen
	seen = 0
	localF()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(direct)
	testing.Println(fixed)
	testing.Println(pack)
	testing.Println(seen, leaked)
}
