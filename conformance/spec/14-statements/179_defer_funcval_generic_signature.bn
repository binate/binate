package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred function-value call binds its arguments to the function
// value's parameters as a direct call does, and discards and releases its result
// after the call — here with generic instances in the signature: a managed
// `@Holder[int]` to a raw `*Holder[int]` parameter (retained until the call
// runs), fixed and packed, and to a managed `@Holder[int]` parameter; an
// `@Holder[int]` result; a generic struct passed by value, with a managed field
// and with float fields; and a managed generic struct result.

interface Holder[T any] {
	Get() T
}

type Thing struct {
	n   int
	pad [6]int
}

impl *Thing : Holder[int]

func (t *Thing) Get() int { return t.n }

type Box[T any] struct {
	v T
	m @[]int
}

type Pt[T any] struct {
	x T
	y T
}

type Node[T any] struct {
	v T
}

// Each deferred call records the value it saw, in the order the calls run.
var got [8]int

var ngot int

func note(n int) {
	got[ngot] = n
	ngot = ngot + 1
}

func mkH(n int) @Holder[int] {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		_ = a
	}
}

func r1() {
	var fi @func(*Holder[int]) = func(h *Holder[int]) { note(h.Get()) }
	var fm @func(@Holder[int]) = func(h @Holder[int]) { note(h.Get()) }
	var fv @func(...*Holder[int]) = func(hs ...*Holder[int]) {
		for i := 0; i < len(hs); i++ {
			note(hs[i].Get())
		}
	}
	var fr @func(int) @Holder[int] = mkH
	var fb @func(Box[int]) Box[int] = func(b Box[int]) Box[int] {
		note(b.v + b.m[0])
		return b
	}
	var fp @func(Pt[float64]) Pt[float64] = func(p Pt[float64]) Pt[float64] {
		note(cast(int, p.x + p.y))
		return p
	}
	var fn @func(int) @Node[int] = func(n int) @Node[int] {
		var r @Node[int] = make(Node[int])
		r.v = n
		note(n)
		return r
	}
	var b Box[int]
	b.v = 15
	b.m = make_slice(int, 1)
	b.m[0] = 1
	var p Pt[float64]
	p.x = 17.5
	p.y = 0.5
	defer fi(mkH(11))
	defer fm(mkH(12))
	defer fv(mkH(13), mkH(14))
	defer fr(15)
	defer fb(b)
	defer fp(p)
	defer fn(19)
	clobber()
}

func main() {
	// r1 runs once first as a warm-up: the bytecode VM allocates each call site's
	// function-value table on first use and keeps it, which is not a leak.  The
	// leak is measured before anything is printed: the first print can allocate
	// state that lives to program exit.
	r1()
	ngot = 0
	var live int = rt.LiveBlocks()
	r1()
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < ngot; i++ {
		testing.Println(got[i])
	}
	testing.Println(leaked)
}
