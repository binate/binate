package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: the callee of a deferred call may be a function-value field
// reached through a managed or raw pointer to the struct (`.` auto-dereferences
// a pointer of either kind), as in a direct call; the function value is
// evaluated at the defer statement, so a later reassignment of the field does
// not change which function the deferred call runs, and its managed argument
// passed for a raw parameter is retained until the call.

type T struct {
	f @func(int)
	g @func(*[]int)
}

var seen int

func add(n int) { seen = seen * 100 + n }

func twice(n int) { seen = seen * 100 + 2 * n }

func first(xs *[]int) { seen = seen * 100 + xs[0] }

func mkS(n int) @[]int {
	var s @[]int = make_slice(int, 8)
	s[0] = n
	return s
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @[]int = make_slice(int, 8)
		a[0] = 77
		_ = a
	}
}

func run() {
	var t @T = make(T)
	t.f = add
	t.g = first
	var p *T = t
	var s T
	s.f = add
	defer s.f(1)
	defer t.f(2)
	defer p.f(3)
	defer p.g(mkS(4))
	t.f = twice
	clobber()
}

func main() {
	// run runs once first as a warm-up: the bytecode VM allocates each call
	// site's function-value table on first use and keeps it, which is not a leak.
	// The leak is measured before anything is printed: the first print can
	// allocate state that lives to program exit.
	run()
	seen = 0
	var live int = rt.LiveBlocks()
	run()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(seen, leaked)
}
