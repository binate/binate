package "main"
import "pkg/builtins/testing"

// stmt.terminating, stmt.empty: an empty statement is a statement like any
// other, so a block whose last statement is empty — a `return` followed by a
// stray `;` before the `}` — does not terminate, and a result-returning
// function or case body ending that way is rejected with "missing return".
func f() int {
	return 1;;
}

func g(x int) int {
	switch x {
	case 0:
		return 0
	default:
		return 1;;
	}
}

func main() {
	testing.Println(f(), g(2))
}
