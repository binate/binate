package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a deferred block's calls evaluate their operands when the block
// runs.  A managed pointer `@T` bound there to a raw interface parameter
// (`*Getter`, `*any`, or packed into a `...*any`) is boxed for the call, the box
// borrowing the object it points at: a call result lives until the deferred
// statement ends (clobber, run before, would show a value freed early) and is
// released then; a local is read as it is when the block runs, after its
// reassignment.  This holds in a generic instance, whose argument type is a type
// parameter, and for a generic struct's pointer.

interface Getter {
	Get() int
}

type Thing struct {
	n   int
	pad [6]int
}

impl *readonly Thing : Getter

func (t *readonly Thing) Get() int { return t.n }

interface Sink {
	Put(g *Getter)
}

type Acc struct {
	k int
}

impl *Acc : Sink

func (a *Acc) Put(g *Getter) { seen = seen * 100 + g.Get() }

type Box[T any] struct {
	v   T
	pad [6]int
}

var seen int

func mkT(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func mkRO(n int) @readonly Thing { return mkT(n) }

func mkBox(n int) @Box[int] {
	var b @Box[int] = make(Box[int])
	b.v = n
	return b
}

func mkS(n int) @[]int {
	var s @[]int = make_slice(int, 7)
	s[0] = n
	return s
}

// mkCell boxes a managed-slice: a managed pointer to a type with no name.
func mkCell(n int) @(@[]int) { return box(mkS(n)) }

func use1(g *Getter) { seen = seen * 100 + g.Get() }

func usev(gs ...*Getter) {
	for i := 0; i < len(gs); i++ {
		seen = seen * 100 + gs[i].Get()
	}
}

func useAny(a *any) {
	var t *Thing = a.(*Thing)
	seen = seen * 100 + t.n
}

func anyv(as ...*any) {
	for i := 0; i < len(as); i++ {
		useAny(as[i])
	}
}

// A box of a readonly object recovers only as a readonly pointer.
func useRO(a *any) {
	var p *readonly Thing
	var ok bool
	var mut bool
	p, ok = a.(*readonly Thing)
	_, mut = a.(*Thing)
	if ok && !mut {
		seen = seen * 100 + p.n
	}
}

func useCell(a *any) {
	var s @[]int
	var ok bool
	s, ok = a.(@[]int)
	if ok {
		seen = seen * 100 + s[0]
	}
}

func useBox(a *any) {
	var b *Box[int] = a.(*Box[int])
	seen = seen * 100 + b.v
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		var c @(@[]int) = box(mkS(99))
		_ = a
		_ = c
	}
}

func runFixed() {
	defer { useAny(mkT(21)) }
	clobber()
}

func runPack() {
	defer { anyv(mkT(22), mkT(23)) }
	clobber()
}

func runIface() {
	defer { use1(mkT(24)) }
	clobber()
}

func runLocal() {
	var t @Thing = mkT(25)
	defer { useAny(t) }
	t = mkT(26)
	clobber()
}

// A raw pointer packed beside two call results is borrowed as it is.
func runMixed() {
	var keep @Thing = mkT(28)
	var rp *Thing = keep
	defer { anyv(mkT(27), rp, mkT(29)) }
	clobber()
}

func runReadonly() {
	defer { useRO(mkRO(30)) }
	clobber()
}

func runCell() {
	defer { useCell(mkCell(31)) }
	clobber()
}

func runGetterPack() {
	defer { usev(mkT(37), mkT(38)) }
	clobber()
}

func runBox() {
	defer { useBox(mkBox(39)) }
	clobber()
}

func genFixed[T any](f *func(int) @T, n int) {
	defer { useAny(f(n)) }
	clobber()
}

func genPack[T any](f *func(int) @T, n int) {
	defer { anyv(f(n), f(n + 1)) }
	clobber()
}

func genBare[T any](f *func(int) T, n int) {
	defer { useAny(f(n)) }
	clobber()
}

// An interface-method call, a raw and a managed function-value call and a
// method call, each deferred with an `@Thing` argument for its `*Getter`
// parameter.
func runShapes() {
	var acc @Acc = make(Acc)
	var s @Sink = acc
	var fv *func(*Getter) = use1
	var mf @func(*Getter) = use1
	defer { s.Put(mkT(32)) }
	defer { fv(mkT(33)) }
	defer { acc.Put(mkT(34)) }
	defer { mf(mkT(35)) }
	clobber()
}

func main() {
	// runShapes and the generic instances run once first as a warm-up: the
	// bytecode VM allocates each call site's function-value table on first use and
	// keeps it, which is not a leak.  The leak is measured before anything is
	// printed: the first print can allocate state that lives to program exit.
	runShapes()
	genFixed[Thing](mkT, 40)
	genPack[Thing](mkT, 41)
	genBare[@Thing](mkT, 43)
	seen = 0
	var live int = rt.LiveBlocks()
	var got [13]int
	runFixed()
	got[0] = seen
	seen = 0
	runPack()
	got[1] = seen
	seen = 0
	runIface()
	got[2] = seen
	seen = 0
	runLocal()
	got[3] = seen
	seen = 0
	runMixed()
	got[4] = seen
	seen = 0
	runReadonly()
	got[5] = seen
	seen = 0
	runCell()
	got[6] = seen
	seen = 0
	runGetterPack()
	got[7] = seen
	seen = 0
	runBox()
	got[8] = seen
	seen = 0
	genFixed[Thing](mkT, 40)
	got[9] = seen
	seen = 0
	genPack[Thing](mkT, 41)
	got[10] = seen
	seen = 0
	genBare[@Thing](mkT, 43)
	got[11] = seen
	seen = 0
	runShapes()
	got[12] = seen
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < 12; i++ {
		testing.Println(got[i])
	}
	testing.Println(got[12], leaked)
}
