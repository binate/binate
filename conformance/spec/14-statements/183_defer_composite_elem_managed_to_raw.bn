package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer: a managed value borrowed as a raw one is retained until the
// deferred call runs, also where the borrow is an element of a composite
// literal in an operand — a struct field, an array element, a slice-literal
// element — however deeply the literal is nested in the operand: an `@T` for
// a `*T`, `*Getter` or `*any` element, an `@Getter` for a `*Getter`, an `@[]int`
// for a `*[]int`, an `@func` for a `*func` — and wherever the literal sits: an
// argument, a variadic element or spread, a method's receiver, the struct a
// function-value callee is read from, an interface receiver, a generic struct.
// A call result or a local stays alive until the call (clobber reuses freed
// memory, which a freed one would show) and is released after it.  A literal in
// a nested call's arguments is consumed by that call at the defer statement.

interface Getter {
	Get() int
}

type Thing struct {
	n   int
	pad [6]int
}

interface Noter {
	Note()
}

impl *Thing : Getter, Noter

func (t *Thing) Get() int { return t.n }

func (t *Thing) Note() { note(t.n) }

type Val struct {
	s @[]int
}

type Opts struct {
	a *any
}

func (o Opts) Show() { note(anyN(o.a)) }

func (o *Opts) ShowP() { note(anyN(o.a)) }

type Holder struct {
	f *func()
}

type GP[T any] struct {
	p *T
}

type Ptrs struct {
	p *Thing
	g *Getter
	s *[]int
	f *func() int
}

type Inner struct {
	p *Thing
}

type Outer struct {
	inr Inner
	q   *Thing
}

// Mix holds a value boxed by a snapshot (v) between two managed values
// borrowed as raw ones.
type Mix struct {
	a *any
	v *any
	b *any
}

var seen int

func mkT(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func mkG(n int) @Getter { return mkT(n) }

func mkS(n int) @[]int {
	var s @[]int = make_slice(int, 7)
	s[0] = n
	return s
}

func mkF(n int) @func() int {
	return func() int { return n }
}

func mkN(n int) @func() {
	return func() { note(n) }
}

func mkV(n int) Val {
	var v Val
	v.s = mkS(n)
	return v
}

func note(n int) { seen = seen * 100 + n }

func anyN(a *any) int {
	var t *Thing
	var ok bool
	t, ok = a.(*Thing)
	if ok { return t.n }
	var v *Val
	v, ok = a.(*Val)
	if ok { return v.s[0] }
	return 1
}

func showOpts(o Opts) { note(anyN(o.a)) }

func showPtrs(p Ptrs) {
	note(p.p.n)
	note(p.g.Get())
	note(p.s[0])
	note(p.f())
}

func showOuter(o Outer) {
	note(o.inr.p.n)
	note(o.q.n)
}

func showMix(m Mix) {
	note(anyN(m.a))
	note(anyN(m.v))
	note(anyN(m.b))
}

func showArr(a [2]*Getter) {
	note(a[0].Get())
	note(a[1].Get())
}

func showSlice(s *[]readonly *Thing) {
	for i := 0; i < len(s); i++ {
		note(s[i].n)
	}
}

func showMS(s @[]*any) {
	for i := 0; i < len(s); i++ {
		note(anyN(s[i]))
	}
}

func firstN(o Opts) int { return anyN(o.a) }

func showTwo(n int, o Opts) {
	note(n)
	note(anyN(o.a))
}

func showGP(g GP[Thing]) { note(g.p.n) }

func optsRO(os ...readonly Opts) {
	for i := 0; i < len(os); i++ {
		note(anyN(os[i].a))
	}
}

func optsv(os ...Opts) {
	for i := 0; i < len(os); i++ {
		note(anyN(os[i].a))
	}
}

func clobber() {
	for j := 0; j < 4; j++ {
		var a @Thing = make(Thing)
		a.n = 99
		var s @[]int = make_slice(int, 7)
		s[0] = 99
		var f @func() int = mkF(99)
		_ = a
		_ = s
		_ = f
	}
}

func runOpts() {
	defer showOpts(Opts{a: mkT(11)})
	clobber()
}

func runPtrs() {
	defer showPtrs(Ptrs{p: mkT(12), g: mkG(13), s: mkS(14), f: mkF(15)})
	clobber()
}

func runPositional() {
	defer showPtrs(Ptrs{mkT(16), mkT(17), mkS(18), mkF(19)})
	clobber()
}

func runOuter() {
	defer showOuter(Outer{inr: Inner{p: mkT(20)}, q: mkT(21)})
	clobber()
}

func runLocal() {
	var x @Thing = mkT(22)
	defer showOuter(Outer{inr: Inner{p: x}, q: x})
	x = mkT(23)
	clobber()
}

func runMix() {
	defer showMix(Mix{a: mkT(24), v: mkV(25), b: mkT(26)})
	clobber()
}

func runArr() {
	defer showArr([2]*Getter{mkT(27), mkG(28)})
	clobber()
}

func runSlice() {
	defer showSlice(*[]readonly *Thing{mkT(29), mkT(30)})
	clobber()
}

func runManagedSlice() {
	defer showMS(@[]*any{mkT(31), mkT(32)})
	clobber()
}

func runPack() {
	defer optsv(Opts{a: mkT(33)}, Opts{a: mkT(34)})
	clobber()
}

func runRecv() {
	defer Opts{a: mkT(35)}.Show()
	clobber()
}

func runRecvP() {
	defer Opts{a: mkT(36)}.ShowP()
	clobber()
}

func runCallee() {
	defer Holder{f: mkN(37)}.f()
	clobber()
}

func runIfaceRecv() {
	defer [1]*Noter{mkT(38)}[0].Note()
	clobber()
}

func runSpread() {
	defer optsRO(*[]readonly Opts{Opts{a: mkT(39)}}...)
	clobber()
}

func runCond(flag bool) {
	if flag {
		defer showOpts(Opts{a: mkT(40)})
	}
	clobber()
}

func runNestedCall() {
	defer showTwo(firstN(Opts{a: mkT(41)}), Opts{a: mkT(42)})
	clobber()
}

func runGeneric() {
	defer showGP(GP[Thing]{p: mkT(43)})
	clobber()
}

var got [18]int

func record(i int) {
	got[i] = seen
	seen = 0
}

func runAll() {
	seen = 0
	runOpts()
	record(0)
	runPtrs()
	record(1)
	runPositional()
	record(2)
	runOuter()
	record(3)
	runLocal()
	record(4)
	runMix()
	record(5)
	runArr()
	record(6)
	runSlice()
	record(7)
	runManagedSlice()
	record(8)
	runPack()
	record(9)
	runRecv()
	record(10)
	runRecvP()
	record(11)
	runCallee()
	record(12)
	runIfaceRecv()
	record(13)
	runSpread()
	record(14)
	runCond(false)
	runCond(true)
	record(15)
	runNestedCall()
	record(16)
	runGeneric()
	record(17)
}

func main() {
	// runAll runs once first as a warm-up: the bytecode VM allocates a call
	// site's function-value table on first use and keeps it, which is not a
	// leak.  The leak is measured before anything is printed: the first print can
	// allocate state that lives to program exit.
	runAll()
	var live int = rt.LiveBlocks()
	runAll()
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < 17; i++ {
		testing.Println(got[i])
	}
	testing.Println(got[17], leaked)
}
