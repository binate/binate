package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.for.scope, decl.scope.block: a variable the init statement of a C-style
// `for` declares belongs to the `for` statement — one variable for the whole
// loop, visible in the condition, the post statement and the body, and out of
// scope after the loop, where a same-named outer variable is visible again.  A
// managed one — a pointer, a managed-slice, a struct with a managed field — is
// released when the loop exits, by a false condition, a `break` or a `return`,
// and lives across a `continue`.

type Thing struct {
	n int
}

type Pair struct {
	t @Thing
	k int
}

func mkT(n int) @Thing {
	var t @Thing = make(Thing)
	t.n = n
	return t
}

func shadowInt() int {
	var i int = 10
	for i := 0; i < 3; i++ {}
	return i
}

func shadowNested() int {
	var i int = 20
	var sum int = 0
	for i := 0; i < 2; i++ {
		for i := 5; i < 7; i++ {
			sum = sum + i
		}
		sum = sum + i
	}
	return sum * 100 + i
}

func shadowManaged() int {
	var p @Thing = mkT(7)
	for p := mkT(8); p.n < 10; p.n++ {}
	return p.n
}

// The init variable is released at the loop's exit, so only the outer
// variable is live after the loop.
func releasedAtExit() int {
	var live int = rt.LiveBlocks()
	for p := mkT(1); p.n < 3; p.n++ {}
	return rt.LiveBlocks() - live
}

func releasedAtBreak() int {
	var live int = rt.LiveBlocks()
	for p := mkT(1); ; p.n++ {
		if p.n == 4 {
			break
		}
	}
	return rt.LiveBlocks() - live
}

func mkPair(n int) Pair {
	var q Pair
	q.t = mkT(n)
	return q
}

func releasedAtReturn() int {
	for p := mkT(1); p.n < 10; p.n++ {
		if p.n == 3 {
			return p.n
		}
	}
	return 0
}

func liveAcrossContinue() int {
	var sum int = 0
	for p := mkT(1); p.n < 5; p.n++ {
		if p.n % 2 == 0 {
			continue
		}
		sum = sum + p.n
	}
	return sum
}

func sliceAndStruct() int {
	var live int = rt.LiveBlocks()
	var sum int = 0
	for s, q := make_slice(int, 3), mkPair(5); q.k < 3; q.k++ {
		s[q.k] = q.t.n + q.k
		sum = sum + s[q.k]
	}
	return sum * 10 + (rt.LiveBlocks() - live)
}

func main() {
	var live int = rt.LiveBlocks()
	var a int = shadowInt()
	var b int = shadowNested()
	var c int = shadowManaged()
	var d int = releasedAtExit()
	var e int = releasedAtBreak()
	var f int = releasedAtReturn()
	var g int = liveAcrossContinue()
	var h int = sliceAndStruct()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(a)
	testing.Println(b)
	testing.Println(c)
	testing.Println(f, g, h)
	testing.Println(d, e, leaked)
}
