package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// expr.composite.slice, stmt.switch.break, mem.scope-exit: a raw-slice literal
// with managed elements in a switch's case expression keeps its backing — which
// holds its own references — until the enclosing block exits.  A `break` out of
// a case and a `continue` out of the loop around the switch each release it
// exactly once, as falling through does, along with the case body's locals.

type Node struct {
	n int
}

func mkNode(n int) @Node {
	var p @Node = make(Node)
	p.n = n
	return p
}

func mkS(n int) @[]char {
	var s @[]char = make_slice(char, n + 1)
	return s
}

func run() int {
	var total int = 0
	for i := 0; i < 4; i++ {
		switch {
		case len(*[]readonly @[]char{mkS(i), mkS(1)}) == 2 && i == 1:
			var a @Node = mkNode(1)
			total = total + a.n
			break
		case len(*[]readonly @Node{mkNode(i)}) == 1 && i == 2:
			var b @Node = mkNode(2)
			if b.n == 2 {
				continue
			}
		}
		total = total + 1
	}
	return total
}

func main() {
	var live int = rt.LiveBlocks()
	var total int = run()
	var leaked int = rt.LiveBlocks() - live
	testing.Println(total, leaked)
}
