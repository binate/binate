package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer, stmt.defer.exit: a deferred block runs when the block its defer
// statement is in exits — falling off its end, or a `break`, `continue` or
// `return` leaving it, a switch or type-switch case body and a range loop's body
// included — last scheduled first, innermost block first, each block's deferred
// blocks before its own locals are released.  A defer statement that has not
// executed schedules nothing.

type Node struct {
	n int
}

func mk(n int) @Node {
	var p @Node = make(Node)
	p.n = n
	return p
}

var events [16]int
var nev int

func note(n int) {
	events[nev] = n
	nev = nev + 1
}

func fallThrough() {
	defer { note(1) }
	{
		defer { note(2) }
		note(3)
	}
	note(4)
}

func sameBlock() {
	defer { note(1) }
	defer { note(2) }
	note(3)
}

func breakOut() {
	for i := 0; i < 3; i++ {
		defer { note(10 + i) }
		if i == 1 {
			break
		}
		note(20 + i)
	}
	note(30)
}

func continueOut() {
	for i := 0; i < 3; i++ {
		defer { note(40 + i) }
		if i == 1 {
			continue
		}
		note(50 + i)
	}
}

func returnNested() int {
	defer { note(60) }
	{
		defer { note(61) }
		if true {
			defer { note(62) }
			return 7
		}
	}
	return 0
}

func switchCase(k int) {
	switch k {
	case 1:
		defer { note(70) }
		note(71)
	case 2:
		defer { note(72) }
		break
	}
	note(73)
}

func rangeBody() {
	var xs @[]int = make_slice(int, 3)
	xs[0] = 1
	xs[1] = 2
	xs[2] = 3
	for v in xs {
		defer { note(v * 10) }
		if v == 2 {
			continue
		}
		note(v)
	}
}

func typeSwitch(a *any) {
	switch t := a.(type) {
	case *Node:
		defer { note(t.n) }
		note(80)
	}
	note(81)
}

func notExecuted(c bool) {
	if c {
		return
	}
	defer { note(90) }
	if false {
		defer { note(91) }
	}
	note(92)
}

// The inner block's local is released before the outer block's deferred block
// runs, after the inner block's own.
func releaseOrder() {
	var base int = rt.LiveBlocks()
	defer { note(rt.LiveBlocks() - base) }
	{
		var t @Node = mk(1)
		defer { note(rt.LiveBlocks() - base) }
		_ = t
	}
}

var got [12][16]int
var gotN [12]int

func record(i int) {
	got[i] = events
	gotN[i] = nev
	nev = 0
}

func runAll() {
	nev = 0
	fallThrough()
	record(0)
	sameBlock()
	record(1)
	breakOut()
	record(2)
	continueOut()
	record(3)
	note(returnNested())
	record(4)
	switchCase(1)
	switchCase(2)
	record(5)
	rangeBody()
	record(6)
	var nd Node
	nd.n = 85
	typeSwitch(&nd)
	record(7)
	notExecuted(true)
	notExecuted(false)
	record(8)
	releaseOrder()
	record(9)
}

func main() {
	// runAll runs once first as a warm-up; the leak is measured before anything
	// is printed: the first print can allocate state that lives to program exit.
	runAll()
	var live int = rt.LiveBlocks()
	runAll()
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < 10; i++ {
		for j := 0; j < gotN[i]; j++ {
			if j > 0 { testing.Print(" ") }
			testing.Print(got[i][j])
		}
		testing.Println()
	}
	testing.Println(leaked)
}
