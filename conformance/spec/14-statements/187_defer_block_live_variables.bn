package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// stmt.defer, stmt.defer.return: a deferred block is ordinary code at its defer
// statement, run at its block's exit: it reads and writes the variables in scope
// there as they are then — not ones declared after the defer statement — and a
// write is seen by the code after the block.  A `return`'s results are taken
// before the deferred blocks run, so a deferred block cannot change them, though
// it can change an object a result points to.  A defer inside a deferred block
// runs at the end of that block.  A function literal in a deferred block that
// runs at more than one exit is still one closure site (func.closure.allocation):
// a closure saved by one run sees the captures the next run refills.  A package
// variable's initializer runs its deferred code before the variable is
// initialized, so the variables that code reads come first (prog.init.vars).
// A result stays intact while deferred code runs, a struct one too.

type Node struct {
	n int
}

func mk(n int) @Node {
	var p @Node = make(Node)
	p.n = n
	return p
}

type Pair struct {
	a int
	b int
	s @[]int
}

func mkPair(n int) Pair {
	var p Pair
	p.a = n
	p.b = n + 1
	p.s = make_slice(int, 1)
	p.s[0] = n + 2
	return p
}

func seven() int { return 7 }

var initSeen int

var early int = func() int {
	defer { initSeen = late }
	return 1
}()

var late int = seven()

func writeSeen() int {
	var n int = 1
	{
		defer { n = n * 10 }
		n = 2
	}
	return n
}

func resultKept() int {
	var x int = 3
	defer { x = 9 }
	return x
}

func managedResult() @Node {
	var t @Node = mk(5)
	defer {
		t.n = 6
		t = nil
	}
	return t
}

func laterShadow() int {
	var x int = 1
	var seen int = 0
	{
		defer { seen = x }
		var x int = 2
		_ = x
	}
	return seen
}

// The deferred block reads the loop variable at each iteration's end, and its
// write is seen by the post statement.
func loopCounter() int {
	var sum int = 0
	for i := 0; i < 5; i++ {
		defer { i = i + 1 }
		sum = sum * 10 + i
	}
	return sum
}

func nestedDefer() int {
	var log int = 0
	{
		defer {
			defer { log = log * 10 + 1 }
			log = log * 10 + 2
		}
		log = 3
	}
	return log
}

// The first iteration leaves its body by `continue`, the second by falling
// through: two copies of the deferred block, one closure site.  The closure
// saved by the first sees the capture the second refills.
func closureSite() int {
	var saved *func() int
	for i := 0; i < 2; i++ {
		defer {
			var f *func() int = func() int { return i }
			if i == 0 {
				saved = f
			}
		}
		if i == 0 {
			continue
		}
	}
	return saved()
}

// A struct result with a managed field survives deferred code that makes, and
// drops, structs of its own.
func aggregateResult() Pair {
	defer {
		var q Pair = mkPair(50)
		var r Pair = mkPair(60)
		_ = q
		_ = r
	}
	return mkPair(7)
}

var shortSeen int

func sumNodes(ps *[]readonly @Node) {
	var t int = 0
	for i := 0; i < len(ps); i++ {
		t = t + ps[i].n
	}
	shortSeen = t
}

// The shorthand `defer <call>` is a block holding that call: a raw-slice literal
// with managed elements in it lives until the call's statement ends and is
// released with the block.
func shorthand() {
	defer sumNodes(*[]readonly @Node{mk(4), mk(5)})
}

var got [10]int

func runAll() {
	got[0] = writeSeen()
	got[1] = resultKept()
	var m @Node = managedResult()
	got[2] = m.n
	got[3] = laterShadow()
	got[4] = loopCounter()
	got[5] = nestedDefer()
	got[6] = closureSite()
	got[7] = initSeen + early * 10
	var p Pair = aggregateResult()
	got[8] = p.a * 100 + p.b * 10 + p.s[0]
	shorthand()
	got[9] = shortSeen
}

func main() {
	// runAll runs once first as a warm-up; the leak is measured before anything
	// is printed: the first print can allocate state that lives to program exit.
	runAll()
	var live int = rt.LiveBlocks()
	runAll()
	var leaked int = rt.LiveBlocks() - live
	for i := 0; i < 10; i++ {
		testing.Println(got[i])
	}
	testing.Println(leaked)
}
