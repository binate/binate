package "main"

// stmt.defer.block: a `break` or `continue` may not leave a deferred block,
// though the defer statement is in a loop; one targeting a loop inside the
// deferred block is fine.
func main() {
	for i := 0; i < 3; i++ {
		defer {
			for j := 0; j < 2; j++ {
				break
			}
			break
		}
	}
	for i := 0; i < 3; i++ {
		defer { continue }
	}
}
