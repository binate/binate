package "main"

import "pkg/builtins/testing"

// stmt.defer.no-abort: a deferred block that panics — here at a `break` out of
// a loop body — ends the program at once, after the output before it.
func f() {
	defer { testing.Println("outer") }
	for i := 0; i < 3; i++ {
		defer { testing.Println("deferred", i) }
		defer {
			if i == 1 {
				panic("stop")
			}
		}
		testing.Println(i)
		if i == 1 {
			break
		}
	}
}

func main() {
	f()
}
