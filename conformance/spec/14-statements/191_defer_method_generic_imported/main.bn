package "main"

import "pkg/builtins/testing"
import "pkg/home"

// stmt.defer.call: the shorthand `defer <call>` of a method call names the method
// as an ordinary call does and reads its receiver at the exit, as `defer { <call> }`
// does — for a method of a generic struct instance (pointer and value receivers),
// of an imported generic type's instance, and of an imported type reached through
// a pointer to an imported package variable.

type Box[T any] struct {
	v T
}

func (b *Box[T]) Show() { testing.Println("box", cast(int, b.v)) }

func (b Box[T]) ShowV() { testing.Println("boxv", cast(int, b.v)) }

func generic() {
	var x Box[int]
	x.v = 3
	defer x.Show()
	defer x.ShowV()
	defer { x.Show() }
	x.v = 4
}

func importedGeneric() {
	var q home.Pair[int]
	q.A = 5
	defer q.Show()
	q.A = 6
}

func imported() {
	var p = &home.V
	defer p.Inc()
	defer { p.Inc() }
	p.N = 10
}

func main() {
	generic()
	importedGeneric()
	imported()
	testing.Println("n", home.V.N)
}
