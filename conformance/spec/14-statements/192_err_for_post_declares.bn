package "main"

import "pkg/builtins/testing"

// A for loop's post statement cannot be a short variable declaration: a variable it
// declared would exist only from the second iteration on, after the body that uses
// it had run once (spec stmt.for.post).

func main() {
	for i := 0; i < 3; q := i {
		testing.Println(q)
	}
}
