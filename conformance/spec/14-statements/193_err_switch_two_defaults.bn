package "main"

import "pkg/builtins/testing"

// stmt.switch.default.single: a switch has at most one default clause; a second
// is rejected.  This program must not compile.

func main() {
	var x int = 3
	switch x {
	case 1:
		testing.Println("one")
	default:
		testing.Println("first default")
	default:
		testing.Println("second default")
	}
}
