package "main"

import "pkg/builtins/testing"

// stmt.switch.default.single, iface.typeswitch: a type switch, too, has at most
// one default clause; a second is rejected.  This program must not compile.

interface Namer {
	Name() int
}

type T struct {
	n int
}

func (t *T) Name() int { return t.n }

impl *T : Namer

func main() {
	var t T
	var x *any = &t
	switch v := x.(type) {
	default:
		testing.Println("first default")
	case *Namer:
		testing.Println("namer", v.Name())
	default:
		testing.Println("second default")
	}
}
