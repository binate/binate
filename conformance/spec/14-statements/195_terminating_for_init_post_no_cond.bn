package "main"

import "pkg/builtins/testing"

// stmt.terminating: a for with no condition and no break targeting it is a
// terminating statement, with or without init and post statements — so a
// function may end in a C-style `for init; ; post { … }` with no return after it.

type P struct {
	n int
}

func mk() @P {
	return make(P)
}

func count() int {
	for p := mk(); ; p.n++ {
		if p.n == 3 {
			return p.n
		}
	}
}

func spin(limit int) int {
	for i := 0; ; i++ {
		if i * i > limit {
			return i
		}
	}
}

func main() {
	testing.Println(count())
	testing.Println(spin(50))
}
