package "main"

import "pkg/builtins/testing"

// An untyped constant switch tag takes its default type (§6.2 `const.default`),
// as the initializer of `x := tag` does, and the cases match it: an int case of
// a literal and of a constant name, a bool case, a float64 case.
const K = 7

func main() {
	var x int = 5
	switch 5 {
	case x:
		testing.Println("int")
	}
	switch K {
	case 6:
		testing.Println("six")
	case x + 2:
		testing.Println("K")
	}
	var b bool = false
	switch true {
	case b:
		testing.Println("b")
	default:
		testing.Println("not b")
	}
	var g float64 = 1.5
	switch 1.5 {
	case g:
		testing.Println("float64")
	}
}
