package "main"

import "pkg/builtins/testing"

// An untyped constant switch tag takes its default type, `int`, which its value
// must fit (§6.2 `const.default.int-width`), as the initializer of `x := tag`
// must: 2^64-1 fits no target's `int`, so the tag is rejected rather than
// matching the case its value would wrap to.
func main() {
	switch 0xFFFFFFFFFFFFFFFF {
	case -1:
		testing.Println("-1")
	}
}
