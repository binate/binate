package "main"
import "pkg/builtins/testing"

// stmt.incdec: `++` and `--` take one expression, so a list before one is rejected
// ("expected = or := after a list of expressions") -- `a, b++` is not `a++` with the
// `b` dropped.  Neighbor `a++` compiles.
func main() {
	var a int = 1
	var b int = 10
	a, b++
	testing.Println("unreachable")
}
