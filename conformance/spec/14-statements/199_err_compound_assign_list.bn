package "main"
import "pkg/builtins/testing"

// stmt.assign.compound: a compound assignment takes one expression on each side, so a
// list before `+=` is rejected ("expected = or := after a list of expressions").
// Neighbor `a += 1` compiles.
func main() {
	var a int = 1
	var b int = 10
	a, b += 1
	testing.Println("unreachable")
}
