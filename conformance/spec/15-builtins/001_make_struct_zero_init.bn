package "main"
import "pkg/builtins/testing"

// builtin.make: make(T) allocates a fresh managed T (@T), zero-initialized.
// A struct's every field is its zero value (no constructors).
type Pt struct {
	x int
	y int
}

func main() {
	var p @Pt = make(Pt)
	var ok bool = true
	if p.x != 0 { ok = false }   // @Pt field access auto-derefs
	if p.y != 0 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
