package "main"
import "pkg/builtins/testing"

// builtin.make: make([100]int) -> @([100]int), a managed pointer to a
// fixed-size array; every element is zero. (*a is copied into a local before
// indexing, keeping this about the zero-init; indexing through a managed
// pointer to an array is covered by spec/07-types/147_managed_ptr_array_index.)
func main() {
	var a @([100]int) = make([100]int)
	var arr [100]int = *a
	var ok bool = true
	for i := 0; i < 100; i++ {
		if arr[i] != 0 { ok = false }
	}
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
