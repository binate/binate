package "main"

// builtin.make: make([100]int) -> @([100]int), a managed pointer to a
// fixed-size array; every element is zero. (*a is copied into a local before
// indexing because indexing an array through a managed pointer is a separate
// known codegen defect, claude-todo "managed pointer-to-array indexing".)
func main() {
	var a @([100]int) = make([100]int)
	var arr [100]int = *a
	var ok bool = true
	for i := 0; i < 100; i++ {
		if arr[i] != 0 { ok = false }
	}
	if ok { println("ok") } else { println("FAIL") }
}
