package "main"

// builtin.make: make(*[]int) -> @(*[]int), a managed pointer to a zero-value
// RAW slice (NOT a managed-slice). The pointed-to raw slice is the empty
// {nil,0}: len 0 and not present.
func main() {
	var rs @(*[]int) = make(*[]int)
	var ok bool = true
	if len(*rs) != 0 { ok = false }
	if present(*rs) { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
