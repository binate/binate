package "main"
import "pkg/builtins/testing"

// builtin.make-slice: make_slice(T, n) -> @[]T with len==n, elements
// zero-initialized; present is true for a non-empty slice.
func main() {
	var s @[]int = make_slice(int, 5)
	var ok bool = true
	if len(s) != 5 { ok = false }
	for i := 0; i < 5; i++ {
		if s[i] != 0 { ok = false }
	}
	if present(s) != true { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
