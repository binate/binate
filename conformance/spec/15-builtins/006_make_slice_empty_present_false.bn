package "main"

// builtin.make-slice: make_slice(T, 0) is the canonical no-backing empty slice
// {nil,0,nil,0}: len 0 and present is false (length-0 => no-backing invariant).
func main() {
	var s @[]int = make_slice(int, 0)
	var ok bool = true
	if len(s) != 0 { ok = false }
	if present(s) != false { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
