package "main"

// builtin.make-slice: make_slice(Pt, n) with a runtime n -> @[]Pt of len n,
// every element's fields zero-initialized.
type Pt struct {
	x int
	y int
}

func sz() int { return 3 }

func main() {
	var n int = sz()
	var s @[]Pt = make_slice(Pt, n)
	var ok bool = true
	if len(s) != 3 { ok = false }
	for i := 0; i < 3; i++ {
		if s[i].x != 0 { ok = false }
		if s[i].y != 0 { ok = false }
	}
	if ok { println("ok") } else { println("FAIL") }
}
