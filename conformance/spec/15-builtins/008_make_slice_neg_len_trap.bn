package "main"

// builtin.make-slice: a negative n is a defined runtime trap, not a silently
// nil-backed negative slice. n comes from a function so it is not folded to a
// compile error.
func neg() int { return -1 }

func main() {
	var n int = neg()
	var s @[]int = make_slice(int, n)
	println(len(s))
}
