package "main"
import "pkg/builtins/testing"

// builtin.box: box(42) materializes the untyped literal as its default type int,
// then allocates a fresh managed copy -> @int; deref with *b (a @int does not
// auto-deref in ==).
func main() {
	var b @int = box(42)
	var ok bool = true
	if *b != 42 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
