package "main"

// builtin.box: box(Pt{...}) -> @Pt holding a byte copy of the value; managed
// struct field access auto-derefs.
type Pt struct {
	x int
	y int
}

func main() {
	var b @Pt = box(Pt{x: 7, y: 9})
	var ok bool = true
	if b.x != 7 { ok = false }
	if b.y != 9 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
