package "main"

// builtin.box: box copies the value onto the managed heap; later mutating the
// source variable does not change the boxed copy.
func main() {
	var v int = 100
	var b @int = box(v)
	var ok bool = true
	if *b != 100 { ok = false }
	v = 5
	if *b != 100 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
