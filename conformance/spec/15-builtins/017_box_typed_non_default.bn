package "main"

// builtin.box: box(v) uses the type of v -- for an already-TYPED operand (not an
// untyped literal) that is v's own type, not a default. box of an int32 value
// yields @int32 (009 boxes an untyped literal -> @int; this pins the typed path).
func main() {
	var v int32 = 7
	var b @int32 = box(v)
	if *b == 7 { println("ok") } else { println("FAIL") }
}
