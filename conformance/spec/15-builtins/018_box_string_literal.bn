package "main"
import "pkg/builtins/testing"

// builtin.box: a string literal is untyped and defaults to @[]readonly char, so
// box("hi") -> @(@[]readonly char).  The boxed managed-slice payload must be the
// materialised 4-word view of rodata (NOT the bare rodata pointer), so *p reads a
// real slice whose length and bytes are recoverable.
func main() {
	var p @(@[]readonly char) = box("hi")
	var s @[]readonly char = *p
	var ok bool = len(s) == 2 && s[0] == 'h' && s[1] == 'i'
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
