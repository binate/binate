package "main"
import "pkg/builtins/testing"

// builtin.cast: cast(T, e) of a NON-constant integer performs the Ch.8
// wrap/truncate and sign/zero extension and yields T. Runtime operands so
// nothing is constant-folded (a constant out-of-range operand is fit-checked).
func wide() int { return 0x1234 }    // 4660
func neg32() int32 { return -1 }
func ff() int { return 255 }

func main() {
	var ok bool = true
	// truncate: low byte of 4660 is 0x34 == 52
	var w int = wide()
	if cast(uint8, w) != 52 { ok = false }
	// sign-extend: int32 -1 widened to int64 stays -1
	var s int32 = neg32()
	if cast(int64, s) != -1 { ok = false }
	// zero-extend: uint8 255 widened keeps 255 (not sign-extended)
	var u uint8 = cast(uint8, ff())
	if cast(uint32, u) != 255 { ok = false }
	if cast(int32, u) != 255 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
