package "main"
import "pkg/builtins/testing"

// builtin.cast: float->int conversion truncates toward zero, and the Ch.8
// saturating contract clamps out-of-range magnitudes to the integer extremes.
// Runtime float operands so the conversion happens at run time.
func p() float64 { return 3.9 }
func n() float64 { return -3.9 }
func big() float64 { return 1.0e30 }
func sml() float64 { return -1.0e30 }

func main() {
	var ok bool = true
	if cast(int, p()) != 3 { ok = false }     // truncates toward zero
	if cast(int, n()) != -3 { ok = false }    // toward zero (negative)
	if cast(int32, big()) != 2147483647 { ok = false }    // saturates to int32 max
	if cast(int32, sml()) != -2147483648 { ok = false }   // saturates to int32 min
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
