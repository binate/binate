package "main"

// builtin.cast: cast drops the readonly qualifier (Ch.8 readonly drop).
// A string literal is *[]readonly char; casting to *[]char yields a writable
// view over the same bytes.
func main() {
	var ok bool = true
	var s *[]readonly char = "hi"
	var m *[]char = cast(*[]char, s)
	if len(m) != 2 { ok = false }
	if m[0] != 104 { ok = false }    // 'h'
	if m[1] != 105 { ok = false }    // 'i'
	if ok { println("ok") } else { println("FAIL") }
}
