package "main"
import "pkg/builtins/testing"

// builtin.unsafe-cast: unsafe_cast drops element-level readonly (§8.7; §8.3 makes
// this the unverifiable escape hatch, not a plain cast).  A string literal is
// *[]readonly char; unsafe_cast to *[]char yields a writable view over the bytes.
func main() {
	var ok bool = true
	var s *[]readonly char = "hi"
	var m *[]char = unsafe_cast(*[]char, s)
	if len(m) != 2 { ok = false }
	if m[0] != 104 { ok = false }    // 'h'
	if m[1] != 105 { ok = false }    // 'i'
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
