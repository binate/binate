package "main"

// builtin.cast: a CONSTANT operand is fit-checked against T (and not
// laundered, §8.5). A constant that FITS the target is accepted and folds to
// its value.
func main() {
	var ok bool = true
	if cast(uint8, 200) != 200 { ok = false }    // 200 fits uint8
	if cast(uint8, 255) != 255 { ok = false }    // boundary: max uint8
	if cast(int8, -128) != -128 { ok = false }   // boundary: min int8
	if cast(int8, 127) != 127 { ok = false }     // boundary: max int8
	if ok { println("ok") } else { println("FAIL") }
}
