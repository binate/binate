package "main"
import "pkg/builtins/testing"

// builtin.cast: cast to a SUB-WORD integer type narrows the value to the
// destination width. A runtime word with high bits set, narrowed to uint8 /
// int8, keeps only the low byte (re-widening confirms the upper bits are gone).
func wide() int { return 0x1234 }    // 4660; low byte 0x34 == 52
func twohundred() int { return 200 }

func main() {
	var ok bool = true
	var b uint8 = cast(uint8, wide())
	if cast(int, b) != 52 { ok = false }      // narrowed to the low byte
	var sb int8 = cast(int8, twohundred())    // 200 -> 0xC8 -> -56 as int8
	if cast(int, sb) != -56 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
