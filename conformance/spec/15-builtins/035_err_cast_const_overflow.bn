package "main"

// builtin.cast: a CONSTANT operand that does NOT fit the cast target type is
// REJECTED at compile time (constants are fit-checked, not silently
// truncated). 256 is out of range for uint8. The neighbor cast(uint8, 255)
// compiles, so the diagnostic is specific to the overflow.
func main() {
	var x uint8 = cast(uint8, 256)
	_ = x
}
