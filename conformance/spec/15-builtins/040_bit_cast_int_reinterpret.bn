package "main"

// builtin.bit-cast: bit_cast(T, e) reinterprets the bits of e as T with no
// value conversion. Reinterpreting int32 -1 (all bits set) as uint32 yields
// 4294967295; round-tripping back recovers the original.
func neg1() int32 { return -1 }

func main() {
	var ok bool = true
	var v int32 = neg1()
	if bit_cast(uint32, v) != 4294967295 { ok = false }   // all bits set
	var u uint32 = bit_cast(uint32, v)
	if bit_cast(int32, u) != -1 { ok = false }            // round-trip
	if ok { println("ok") } else { println("FAIL") }
}
