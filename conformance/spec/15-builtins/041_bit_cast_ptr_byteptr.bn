package "main"

// builtin.bit-cast: bit_cast is the sanctioned tool for moving between a typed
// pointer and the opaque byte pointer *uint8 (and back). The address is
// preserved, so the dereferenced value is intact and same() reports identity.
func main() {
	var ok bool = true
	var x int = 12345
	var p *int = &x
	var bp *uint8 = bit_cast(*uint8, p)      // typed ptr -> byte ptr
	var p2 *int = bit_cast(*int, bp)         // byte ptr -> typed ptr
	if *p2 != 12345 { ok = false }           // same address, value intact
	if !same(p, p2) { ok = false }           // same referent
	if ok { println("ok") } else { println("FAIL") }
}
