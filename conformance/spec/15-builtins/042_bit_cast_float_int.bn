package "main"

// builtin.bit-cast: reinterpret between scalar bit patterns of the SAME width.
// The IEEE-754 double 1.0 is the bit pattern 0x3FF0000000000000; bit_cast to
// int64 exposes it, and round-tripping recovers 1.0.
func one() float64 { return 1.0 }

func main() {
	var ok bool = true
	var f float64 = one()
	var bits int64 = bit_cast(int64, f)
	if bits != 4607182418800017408 { ok = false }    // 0x3FF0000000000000
	if bit_cast(float64, bits) != 1.0 { ok = false } // round-trip
	if ok { println("ok") } else { println("FAIL") }
}
