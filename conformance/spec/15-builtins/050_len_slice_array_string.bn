package "main"

// builtin.len: len(e) yields the element count of a slice, managed-slice,
// array, or string literal (decoded byte length). len("hello")==5, len(arr5)==5.

func main() {
	var ok bool = true
	var arr [5]int
	var ms @[]int = make_slice(int, 7)
	if len("hello") != 5 { ok = false }   // string literal: decoded byte length
	if len(arr) != 5 { ok = false }       // array
	if len(ms) != 7 { ok = false }        // managed-slice
	if ok { println("ok") } else { println("FAIL") }
}
