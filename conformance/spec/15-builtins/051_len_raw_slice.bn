package "main"
import "pkg/builtins/testing"

// builtin.len: len accepts a raw slice (*[]T); its value is the run-time
// read of the length word, and reflects the sub-slice view length.

func n() int { return 9 }

func main() {
	var ok bool = true
	var ms @[]int = make_slice(int, n())
	if len(ms) != 9 { ok = false }
	var rs *[]int = ms[2:5]   // raw-slice view, runtime length 3
	if len(rs) != 3 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
