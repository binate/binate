package "main"
import "pkg/builtins/testing"

// builtin.len: a named type whose underlying is a slice, managed-slice, or
// array is accepted -- the named wrapper is peeled.

type MySlice @[]int
type MyArr [4]int

func main() {
	var ok bool = true
	var ms MySlice = make_slice(int, 6)
	if len(ms) != 6 { ok = false }   // peels named wrapper over managed-slice
	var ma MyArr
	if len(ma) != 4 { ok = false }   // peels named wrapper over array
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
