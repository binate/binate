package "main"

// builtin.len: the result of len is a SIGNED int -- it can be bound to an int
// and participate in signed arithmetic yielding a negative result. len(s)==0
// is the sanctioned emptiness test for slices.

func main() {
	var ok bool = true
	var n int = len("abc")          // result type is signed int
	if n != 3 { ok = false }
	if n - 5 != -2 { ok = false }   // signed subtraction -> negative
	var empty @[]int = make_slice(int, 0)
	if len(empty) != 0 { ok = false }   // empty-slice test
	if ok { println("ok") } else { println("FAIL") }
}
