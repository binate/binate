package "main"
import "pkg/builtins/testing"

// builtin.len: for an array the length is a compile-time constant. A local
// const initialized from len(string-literal) folds, and len of an array
// variable folds in if-conditions.

func main() {
	const SLEN int = len("hello")   // string-literal len folds to a constant
	var ok bool = true
	if SLEN != 5 { ok = false }
	var arr [7]int
	if len(arr) != 7 { ok = false }   // array len folds
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
