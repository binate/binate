package "main"

// builtin.len (Constraint): len is defined only on a slice, managed-slice, or
// array (and a named type peeling to one). A raw pointer is NOT a collection --
// unlike unsafe_index, len does not accept a pointer -- so len(p) is rejected.
// The rule-satisfying neighbor len(slice) compiles (see 051).

func main() {
	var x int = 5
	var p *int = &x
	println(len(p))
}
