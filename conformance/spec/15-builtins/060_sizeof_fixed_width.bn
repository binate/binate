package "main"

// builtin.sizeof: sizeof(T)/alignof(T) of the fixed-width scalar types are
// target-INVARIANT compile-time constants (the same on every target). char is
// an alias for uint8, so sizeof(char)==1.

func main() {
	var ok bool = true
	if sizeof(int64) != 8 { ok = false }
	if sizeof(int32) != 4 { ok = false }
	if sizeof(int16) != 2 { ok = false }
	if sizeof(uint8) != 1 { ok = false }
	if sizeof(uint64) != 8 { ok = false }
	if sizeof(char) != 1 { ok = false }   // char == uint8
	if sizeof(bool) != 1 { ok = false }
	if alignof(int32) != 4 { ok = false }
	if alignof(uint8) != 1 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
