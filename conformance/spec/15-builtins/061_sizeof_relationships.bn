package "main"
import "pkg/builtins/testing"

// builtin.sizeof: sizeof/alignof are TARGET-PARAMETERIZED -- pointer/word width
// depends on the target -- so these target-invariant RELATIONSHIPS hold on both
// 32- and 64-bit targets. sizeof measures the value itself, not the pointee:
// a raw-slice header *[]int is two words; a managed-slice @[]int is four words.

func main() {
	var ok bool = true
	if sizeof(*[]int) != 2 * sizeof(*int) { ok = false }   // raw-slice header: 2 words
	if sizeof(@[]int) != 4 * sizeof(*int) { ok = false }   // managed-slice: 4 words
	if sizeof(*int) != sizeof(*int64) { ok = false }       // all raw pointers same size
	if alignof(*int) != sizeof(*int) { ok = false }        // pointer align == pointer size
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
