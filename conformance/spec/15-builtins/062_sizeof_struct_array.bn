package "main"

// builtin.sizeof: sizeof/alignof of aggregates. An array's size is n times the
// element size; its alignment equals the element alignment. A struct of two
// int32 fields is 8 bytes, aligned to 4.

type Pair struct {
	a int32
	b int32
}

func main() {
	var ok bool = true
	if sizeof([5]int32) != 5 * sizeof(int32) { ok = false }
	if sizeof([5]int32) != 20 { ok = false }
	if alignof([5]int32) != alignof(int32) { ok = false }
	if sizeof(Pair) != 8 { ok = false }
	if alignof(Pair) != 4 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
