package "main"
import "pkg/builtins/testing"

// builtin.sizeof: the result is an unsigned uint and a compile-time constant --
// usable as a package-level const initializer AND as an array dimension.

const SZ_I64 uint = sizeof(int64)
const AL_I32 uint = alignof(int32)

func main() {
	var ok bool = true
	if SZ_I64 != 8 { ok = false }
	if AL_I32 != 4 { ok = false }
	var buf [sizeof(int32)]uint8   // folds: 4-element array
	if len(buf) != 4 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
