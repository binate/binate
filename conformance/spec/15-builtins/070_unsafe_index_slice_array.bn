package "main"
import "pkg/builtins/testing"

// builtin.unsafe-index: unsafe_index(c, i) is c[i] without the bounds check,
// yielding the element type, for a slice, managed-slice, array, or raw slice.

func main() {
	var ok bool = true
	var arr [3]int
	arr[0] = 10
	arr[1] = 20
	arr[2] = 30
	if unsafe_index(arr, 2) != 30 { ok = false }    // array
	var rs *[]int = arr[:]
	if unsafe_index(rs, 1) != 20 { ok = false }     // raw slice
	var ms @[]int = make_slice(int, 3)
	ms[0] = 7
	if unsafe_index(ms, 0) != 7 { ok = false }      // managed-slice
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
