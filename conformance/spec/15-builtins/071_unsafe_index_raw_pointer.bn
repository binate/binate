package "main"
import "pkg/builtins/testing"

// builtin.unsafe-index: unlike len, unsafe_index accepts a RAW POINTER -- it
// treats the pointer as the base of an array and computes the element address
// for index i. The element type is the pointee type.

func main() {
	var ok bool = true
	var arr [3]int
	arr[0] = 100
	arr[1] = 200
	arr[2] = 300
	var p *int = &arr[0]
	if unsafe_index(p, 0) != 100 { ok = false }
	if unsafe_index(p, 1) != 200 { ok = false }
	if unsafe_index(p, 2) != 300 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
