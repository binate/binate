package "main"

// builtin.unsafe-index: the yielded value has the element type of c -- a struct
// element yields the struct, a char (uint8) element yields a char.

type Pt struct {
	x int
	y int
}

func main() {
	var ok bool = true
	var ms @[]Pt = make_slice(Pt, 2)
	ms[1].x = 42
	ms[1].y = 7
	var got Pt = unsafe_index(ms, 1)   // element type is the struct Pt
	if got.x != 42 { ok = false }
	if got.y != 7 { ok = false }
	var buf [2]char
	buf[0] = 65
	buf[1] = 66
	var c char = unsafe_index(buf, 0)  // element type is char
	if c != 65 { ok = false }
	if unsafe_index(buf, 1) != 66 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
