package "main"

// builtin.unsafe-index: unsafe_index peels an ALIAS (a `type X = Y` that names
// the same type), unlike a named-distinct type (see 075). An alias of an array
// is therefore accepted.

type IntArr = [3]int

func main() {
	var ok bool = true
	var a IntArr
	a[0] = 9
	a[2] = 11
	if unsafe_index(a, 0) != 9 { ok = false }
	if unsafe_index(a, 2) != 11 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
