package "main"

// builtin.unsafe-index (Constraint): unlike len, unsafe_index does NOT peel a
// named-distinct collection type -- only an alias. A `type MyArr [3]int` is a
// named-distinct type, so unsafe_index(ma, 0) is rejected. (len(ma) of the same
// type is accepted -- see 052 -- which is exactly the boundary distinction.)
// The neighbor unsafe_index(array)/unsafe_index(alias) compiles (see 070/073).

type MyArr [3]int

func main() {
	var ma MyArr
	println(unsafe_index(ma, 0))
}
