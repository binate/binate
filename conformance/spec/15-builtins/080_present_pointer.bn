package "main"
import "pkg/builtins/testing"

// builtin.present: present(x) is true iff x is set. For a POINTER, "set"
// means non-null: a non-null *int is present; a null *int (nil) is not.
// The result is bool (§15.5).

func main() {
	var x int = 42
	var p *int = &x
	var np *int = nil
	var ok bool = true
	if !present(p) { ok = false }              // non-null *int -> true
	if present(np) { ok = false }              // null pointer -> false
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
