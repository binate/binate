package "main"
import "pkg/builtins/testing"

// builtin.present: present(x) is true iff x is set. For a POINTER, "set"
// means non-null: a non-null *int is present; a null *int (cast(*int, 0))
// is not. The result is bool (§15.5).

func main() {
	var x int = 42
	var p *int = &x
	var ok bool = true
	if !present(p) { ok = false }              // non-null *int -> true
	if present(cast(*int, 0)) { ok = false }   // null pointer -> false
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
