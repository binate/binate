package "main"
import "pkg/builtins/testing"

// builtin.present: for a SLICE (managed-slice @[]T or raw slice *[]T),
// present is true iff length > 0. make_slice(T, 0) is the canonical
// no-backing empty slice {nil,0,...}, whose present is false; a non-empty
// slice (and a raw-slice view over it) is present (§15.5).
// Runtime sizes (function results) keep make_slice off the const-fold path.
func n0() int { return 0 }
func n3() int { return 3 }

func main() {
	var ok bool = true
	var empty @[]int = make_slice(int, n0())
	var full @[]int = make_slice(int, n3())
	if present(empty) { ok = false }   // length-0 managed-slice -> false
	if !present(full) { ok = false }   // length>0 managed-slice -> true
	var rs *[]int = full               // raw-slice view over the backing
	if !present(rs) { ok = false }     // length>0 raw slice -> true
	var rse *[]int = empty
	if present(rse) { ok = false }     // length-0 raw slice -> false
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
