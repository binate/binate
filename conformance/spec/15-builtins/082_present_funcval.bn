package "main"
import "pkg/builtins/testing"

// builtin.present: present accepts a FUNCTION VALUE; it is true iff the
// value's vtable word is set. A func value bound to a function is set, so
// present is true (managed @func() and raw *func() both accepted, §15.5).

func g() { }

func main() {
	var ok bool = true
	var mfp @func() = g    // managed func value
	var rfp *func() = g    // raw func value
	if !present(mfp) { ok = false }
	if !present(rfp) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
