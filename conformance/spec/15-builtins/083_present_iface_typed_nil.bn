package "main"
import "pkg/builtins/testing"

// builtin.present: present accepts an INTERFACE VALUE and is honest about
// typed-nil (§15.5 Note): boxing a nil pointer into an interface value still
// fills the vtable word, so present(iv) is TRUE even though the boxed pointer
// is nil. The only emptiness an interface value has is "never filled".

interface Speaker {
	speak() int
}

type T1 struct { v int }
func (t *T1) speak() int { return t.v }
impl *T1 : Speaker

func main() {
	var ok bool = true
	var a T1
	a.v = 4
	var s *Speaker = &a            // filled interface value
	if !present(s) { ok = false }  // set -> true
	var np *T1 = cast(*T1, 0)      // null concrete pointer
	if present(np) { ok = false }  // the pointer itself is not present
	var iv *Speaker = np           // box the nil pointer into an iface value
	if !present(iv) { ok = false } // vtable word set -> present TRUE (typed-nil)
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
