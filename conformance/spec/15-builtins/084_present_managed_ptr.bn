package "main"

// builtin.present: a managed pointer @T is a pointer, so present accepts it;
// a fresh make(int) is non-null and therefore present (§15.5).

func main() {
	var ok bool = true
	var b @int = make(int)         // managed pointer, non-null, rc 1
	if !present(b) { ok = false }  // @int is a pointer -> present true
	if ok { println("ok") } else { println("FAIL") }
}
