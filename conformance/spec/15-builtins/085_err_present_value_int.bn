package "main"

// builtin.present (Constraint): present is defined on nullable reference/view
// types only. A scalar VALUE type (int) is never unset, so present(int) is
// REJECTED at compile time (§15.5). The neighbor present(&x) on a pointer
// compiles, so the diagnostic is rule-specific, not a parse artifact.

func main() {
	var x int = 5
	var r bool = present(x)   // value type -> rejected
	_ = r
}
