package "main"

// builtin.present: present(x) is FALSE for an UNSET nullable reference -- the
// companion to the present==true cases (082/083/084). An unset func value, a
// null/zero managed pointer, and a never-filled interface value are all "not
// set", so present returns false.
interface Sh { area() int }

func main() {
	var f @func()        // unset func value
	var p @int           // null managed pointer (zero value)
	var iv @Sh           // never-filled interface value
	if !present(f) && !present(p) && !present(iv) { println("ok") } else { println("FAIL") }
}
