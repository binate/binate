package "main"
import "pkg/builtins/testing"

// builtin.same: same(a, b) is true iff a and b denote the same referent.
// For pointers, identity is the same address: two *int aliasing one variable
// are same; pointers to different variables are not. Result is bool (§15.5).

func main() {
	var ok bool = true
	var x int = 1
	var y int = 1
	var p *int = &x
	var q *int = &x   // same address as p
	var r *int = &y   // different address
	if !same(p, q) { ok = false }   // same address -> true
	if same(p, r) { ok = false }    // distinct addresses -> false
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
