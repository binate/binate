package "main"
import "pkg/builtins/testing"

// builtin.same: for a slice, identity is the same {data, len} view (NOT the
// backing) (§15.5 + Note). A copy of a managed-slice shares its view and is
// same; a separately-allocated slice has a distinct data pointer and is not.
// All empty slices are the canonical {nil,0} and are therefore mutually same.
// Runtime sizes keep make_slice off the const-fold path.
func n0() int { return 0 }
func n3() int { return 3 }

func main() {
	var ok bool = true
	var s @[]int = make_slice(int, n3())
	var t @[]int = s                       // shares {data,len} view
	var u @[]int = make_slice(int, n3())   // distinct backing/data
	if !same(s, t) { ok = false }          // same view -> true
	if same(s, u) { ok = false }           // distinct data ptr -> false
	var e1 @[]int = make_slice(int, n0())  // canonical {nil,0}
	var e2 @[]int = make_slice(int, n0())  // canonical {nil,0}
	if !same(e1, e2) { ok = false }        // all empty slices mutually same
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
