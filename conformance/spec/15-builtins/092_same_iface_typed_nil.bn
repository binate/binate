package "main"
import "pkg/builtins/testing"

// builtin.same: for interface values, identity is the same {data, vtable}
// pair (BOTH words). Two iface values built from the same backing are same;
// from different backings, not. And two typed-nil values of DIFFERENT concrete
// types are correctly NOT same -- their data words are both nil but their
// vtable words differ (§15.5).

interface Speaker { speak() int }

type T1 struct { v int }
func (t *T1) speak() int { return t.v }
impl *T1 : Speaker

type T2 struct { v int }
func (t *T2) speak() int { return t.v }
impl *T2 : Speaker

func main() {
	var ok bool = true
	var a T1
	a.v = 4
	var s1 *Speaker = &a
	var s2 *Speaker = &a   // same {data,vtable}
	var b T1
	b.v = 4
	var s3 *Speaker = &b   // distinct data
	if !same(s1, s2) { ok = false }
	if same(s1, s3) { ok = false }
	var n1 *T1 = cast(*T1, 0)
	var n2 *T2 = cast(*T2, 0)
	var iv1 *Speaker = n1   // typed-nil iface, vtable = T1's
	var iv2 *Speaker = n2   // typed-nil iface, vtable = T2's
	if same(iv1, iv2) { ok = false }   // different vtable -> NOT same
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
