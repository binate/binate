package "main"
import "pkg/builtins/testing"

// builtin.same: a managed pointer @T is a pointer, so same accepts it; two
// bindings to one allocation are same, two distinct make(int) allocations are
// not (§15.5).

func main() {
	var ok bool = true
	var b @int = make(int)
	var c @int = b          // same allocation
	var d @int = make(int)  // distinct allocation
	if !same(b, c) { ok = false }
	if same(b, d) { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
