package "main"

// builtin.same (Constraint): function values have no canonical identity and
// are EXCLUDED from same (unlike present, which accepts them). same of two
// func values is REJECTED at compile time (§15.5). The neighbor same(p,p) on
// pointers compiles, so the diagnostic is rule-specific.

func g() { }

func main() {
	var f1 @func() = g
	var f2 @func() = g
	var r bool = same(f1, f2)   // func values rejected
	_ = r
}
