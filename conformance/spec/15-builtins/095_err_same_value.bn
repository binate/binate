package "main"

// builtin.same (Constraint): value types (scalars, structs, arrays) are
// EXCLUDED from same -- they have no referent identity. same of two int
// values is REJECTED at compile time (§15.5).

func main() {
	var x int = 1
	var y int = 1
	var r bool = same(x, y)   // value types rejected
	_ = r
}
