package "main"

// builtin.same (Constraint): both operands must have the SAME static type.
// Two pointers of DIFFERENT pointee types (*int vs *char) -- each individually
// an allowed operand kind -- are still REJECTED because the static types
// differ; the diagnostic is the same-type requirement, distinct from the
// must-be-pointer/iface/slice one (§15.5).

func main() {
	var x int = 1
	var c char = 'a'
	var p *int = &x
	var q *char = &c
	var r bool = same(p, q)   // *int vs *char: mismatched static types
	_ = r
}
