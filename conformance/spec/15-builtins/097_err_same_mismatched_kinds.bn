package "main"

// builtin.same (Constraint): the same-static-type requirement also rejects
// operands of two DIFFERENT allowed kinds -- a pointer and a slice. Each is an
// allowed operand on its own, but their static types differ, so same is
// REJECTED (§15.5). Runtime size keeps make_slice off the const-fold path.
func n3() int { return 3 }

func main() {
	var x int = 1
	var p *int = &x
	var s @[]int = make_slice(int, n3())
	var r bool = same(p, s)   // pointer vs slice: mismatched static types
	_ = r
}
