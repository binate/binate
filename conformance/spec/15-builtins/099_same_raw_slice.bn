package "main"
import "pkg/builtins/testing"

// builtin.same: same(a, b) accepts RAW slices (*[]T) -- an allowed operand kind
// alongside managed-slices (091) -- comparing the {data, len} view. Two raw
// slices over the same data with the same length are same; a shorter view is not.
func main() {
	var m @[]int = make_slice(int, 3)
	m[0] = 1; m[1] = 2; m[2] = 3
	var a *[]int = m[0:3]
	var b *[]int = m[0:3]
	var c *[]int = m[0:2]
	if same(a, b) && !same(a, c) { testing.Println("ok") } else { testing.Println("FAIL") }
}
