package "main"
import "pkg/builtins/testing"

// builtin.keywords (§15.1): each of the eleven keyword-builtins lexes as a
// built-in (no import) and is invoked with call syntax. Exercise all eleven in
// one program: make/make_slice/box/cast/bit_cast/len/unsafe_index/sizeof/
// alignof/present/same.
func r300() int { return 300 }

func main() {
	var ok bool = true
	var p @int = make(int)            // make -> @int
	var s @[]int = make_slice(int, 3) // make_slice -> @[]int
	var b @int = box(7)               // box -> @int
	var c uint8 = cast(uint8, r300()) // cast truncates 300 -> 44
	var bc uint32 = bit_cast(uint32, cast(int32, -1))
	var arr [3]int
	var l int = len(arr)              // len -> int
	var ui int = unsafe_index(arr, 0)
	var sz uint = sizeof(int32)       // sizeof -> uint
	var al uint = alignof(int32)      // alignof -> uint
	var pr bool = present(p)          // present -> bool
	var sm bool = same(p, p)          // same -> bool
	if *p != 0 { ok = false }
	if len(s) != 3 { ok = false }
	if *b != 7 { ok = false }
	if c != 44 { ok = false }
	if bc != 4294967295 { ok = false }
	if l != 3 { ok = false }
	if ui != 0 { ok = false }
	if sz != 4 { ok = false }
	if al != 4 { ok = false }
	if !pr { ok = false }
	if !sm { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
