package "main"

// builtin.keywords (§15.1): a built-in that takes a TYPE argument parses that
// position as a type, not an expression -- which is why these cannot be ordinary
// functions. make_slice (element-type + integer-size) rejects a value `x` in the
// element-type slot with "x is not a type", even though the second argument IS an
// expression. Neighbor: make_slice(int, 3) compiles.
func main() {
	var x int = 5
	var s @[]int = make_slice(x, 3)
	_ = s
}
