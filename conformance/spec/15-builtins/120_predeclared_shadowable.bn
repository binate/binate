package "main"

// builtin.predeclared (§15.7): print, println, and panic are ordinary
// universe-scope identifiers, not keyword-builtins -- so they CAN be shadowed.
// Inside the block they are plain int variables; outside, println is the
// predeclared function again. Contrast builtin.reserved, where the eleven
// keyword-builtins cannot be shadowed at all.
func main() {
	var ok bool = true
	{
		var println int = 5
		var print int = 6
		var panic int = 7
		if println + print + panic != 18 { ok = false }
	}
	if ok { println("ok") } else { println("FAIL") }
}
