package "main"
import "pkg/builtins/testing"

// builtin.predeclared (§15.7): panic is an ordinary universe-scope identifier,
// not a keyword-builtin -- so it CAN be shadowed by a local declaration. Inside
// the block `panic` is a plain int variable; outside, panic is the predeclared
// function again. Contrast builtin.reserved, where the keyword-builtins cannot
// be shadowed at all.
func main() {
	var ok bool = true
	{
		var panic int = 7
		if panic != 7 { ok = false }
	}
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
