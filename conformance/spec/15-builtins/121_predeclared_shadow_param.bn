package "main"
import "pkg/builtins/testing"

// builtin.predeclared (§15.7): a predeclared function name may be shadowed by a
// function parameter -- `panic` here is an ordinary int parameter, not the
// predeclared function. (A keyword-builtin name in this position would be a
// parse error; see builtin.reserved.)
func use(panic int) int {
	return panic + 1
}

func main() {
	if use(4) == 5 { testing.Println("ok") } else { testing.Println("FAIL") }
}
