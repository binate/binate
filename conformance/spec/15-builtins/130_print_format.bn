package "main"

// builtin.print (§15.7): print/println write arguments to stdout; println adds a
// trailing newline, print does not. Multiple arguments are separated by a single
// space. Per-type formatting (stable cases only): integers in decimal (incl.
// negatives), bool as true/false, a char slice as its bytes. (Float formatting
// is provisional and not asserted.)
func main() {
	println(42)
	println(-7)
	println(true)
	println(false)
	println("hi")
	println(1, 2, 3)
	println("x", 5, true)
	print("a")
	print("b")
	println()
	var s *[]readonly char = "world"
	println(s)
}
