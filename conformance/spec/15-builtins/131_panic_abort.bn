package "main"
import "pkg/builtins/testing"

// builtin.panic (§15.7): panic(msg) aborts the program unrecoverably, printing
// "panic: <msg>". The program prints "before", then the panic aborts and
// "after" is never reached.
func main() {
	testing.Println("before")
	panic("boom")
	testing.Println("after")
}
