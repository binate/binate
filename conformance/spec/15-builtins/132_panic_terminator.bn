package "main"

// builtin.panic (§14.13/§15.7): a panic(...) expression statement is a
// control-flow terminator for missing-return analysis. The else branch ends in
// panic with no return, yet pick still satisfies "every path returns or
// terminates". (Drop the panic -> "missing return at end of function".)
func pick(b bool) int {
	if b {
		return 1
	} else {
		panic("never")
	}
}

func main() {
	if pick(true) == 1 { println("ok") } else { println("FAIL") }
}
