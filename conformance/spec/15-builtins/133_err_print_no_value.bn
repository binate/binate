package "main"
import "pkg/builtins/testing"

// builtin.print (§15.7): print/println yield NO value -- their result cannot be
// used in an expression. Assigning testing.Println(...) to a variable is rejected
// ("cannot assign void to int"). Neighbor: calling testing.Println(...) as a statement
// compiles.
func main() {
	var x int = testing.Println("hi")
	_ = x
}
