package "main"

// builtin.result-types (§15.1): the result types of the built-ins, observed
// where they matter: make -> @int, box -> @int (deref with *), make_slice ->
// @[]int (len is int), len -> signed int (so len-10 can go negative), sizeof ->
// uint, present/same -> bool.
type Point struct {
	x int
	y int
}

func main() {
	var ok bool = true
	var p @int = make(int)
	if *p != 0 { ok = false }
	var b @int = box(99)
	if *b != 99 { ok = false }
	var s @[]int = make_slice(int, 2)
	if len(s) != 2 { ok = false }
	var l int = len("hello")
	if l - 10 != -5 { ok = false }   // len is SIGNED int
	var sz uint = sizeof(int32)
	if sz != 4 { ok = false }
	var pr bool = present(p)
	var sm bool = same(p, p)
	if !pr || !sm { ok = false }
	_ = sizeof(Point)
	if ok { println("ok") } else { println("FAIL") }
}
