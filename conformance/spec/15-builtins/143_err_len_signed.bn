package "main"

// builtin.result-types (§15.1): len(e) yields a SIGNED int, not uint. Assigning
// it to a uint without a cast is therefore rejected ("cannot assign int to
// uint") -- a diagnostic that fires IFF len's result type is int (were it uint,
// the assignment would be allowed). The neighbor `var i int = len("abc")`
// compiles.
func main() {
	var u uint = len("abc")
	_ = u
}
