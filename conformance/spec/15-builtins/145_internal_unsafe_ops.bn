package "main"

// builtin.internal (§15.8): unsafe_div / unsafe_rem are the guard-free
// counterparts of / and %, and unsafe_shl / unsafe_shr the guard-free
// counterparts of << and >>. With valid operands they are observably identical
// to the guarded forms. (They additionally skip the §13 divide / shift guards;
// that skip is hardware-dependent UB on a zero divisor / overshift and so is not
// asserted here.)
func main() {
	var ok bool = true
	if unsafe_div(7, 2) != 3 { ok = false }
	if unsafe_rem(7, 2) != 1 { ok = false }
	if unsafe_div(-7, 2) != -3 { ok = false }   // truncates toward zero
	if unsafe_shl(1, 4) != 16 { ok = false }
	if unsafe_shr(256, 2) != 64 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
