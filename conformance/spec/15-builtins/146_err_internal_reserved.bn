package "main"

// builtin.internal (§15.8): the internal built-ins follow the same reservation
// rules as the eleven surface keyword-builtins -- `var unsafe_div int` is a
// parse error ("expected IDENT, got unsafe_div"). Neighbor: a non-reserved name
// compiles.
func main() {
	var unsafe_div int = 3
	_ = unsafe_div
}
