package "main"

// builtin.proposed (§15.8): move(x) (explicit ownership transfer) is PROPOSED,
// not implemented -- it is not a built-in and not a universe identifier, so
// `move(x)` is "undefined: move". Neighbor: a plain copy `var y int = x`
// compiles.
func main() {
	var x int = 5
	var y int = move(x)
	_ = y
}
