package "main"

import "pkg/op"

// builtin.opaque-gate (§15.2): make(T) on an OPAQUE type (its layout not
// available -- here a pure forward declaration in pkg/op.bni with no body) is
// rejected, since the allocation needs the layout. make(op.Opaque) must fail.
func main() {
	var x @op.Opaque = make(op.Opaque)
	_ = x
}
