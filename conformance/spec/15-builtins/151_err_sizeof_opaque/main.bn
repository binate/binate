package "main"

import "pkg/op"

// builtin.opaque-gate (§15.2): sizeof(T)/alignof(T) on an OPAQUE type are
// rejected -- the size/alignment needs the layout, unavailable for a pure
// forward declaration (pkg/op.bni, no body). sizeof(op.Opaque) must fail.
func main() {
	var n uint = sizeof(op.Opaque)
	_ = n
}
