package "main"
import "pkg/builtins/testing"

// Regression: println of 64-bit values on a 32-bit VM host.  The cross-mode
// shim must carry a 64-bit scalar arg (uint64 / int64 / float64) as two i32
// slots rather than one AAPCS32-even-aligned i64 (else the following buf arg is
// read from the wrong register and println segfaults), and a same-width 64-bit
// cast (println widens unsigned to uint64) must copy BOTH slots rather than
// dropping the high half.  Small ints / chars never exercise the high 32 bits,
// so this uses values whose high word is significant.
func main() {
	var a uint64 = 5000000000
	testing.Println(a)
	var b int64 = -5000000000
	testing.Println(b)
	var c uint64 = 18446744073709551615
	testing.Println(c)
	var d int64 = 9223372036854775807
	testing.Println(d)
	var e uint32 = 4000000000
	testing.Println(e)
	var f float64 = 3.5
	testing.Println(f)
}
