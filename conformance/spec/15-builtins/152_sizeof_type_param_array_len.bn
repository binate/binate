package "main"

import "pkg/builtins/testing"

// builtin.sizeof: sizeof(T) of a type parameter is a constant of each
// instantiation, so an array length built from it is too.

func size[T any]() int {
	var a [sizeof(T)]uint8
	return len(a)
}

func main() {
	testing.Println(size[uint16](), size[uint64](), size[uint8]())
}
