package "main"

import "pkg/builtins/testing"

// builtin.len: len of an array is a compile-time constant, including an array
// whose length depends on a type parameter — a constant of each
// instantiation, usable as another array's length.

func g[T any]() int {
	var a [sizeof(T)]uint8
	var b [len(a) * 2]uint8
	return len(b)
}

func main() {
	testing.Println(g[uint16](), g[uint64]())
}
