package "main"

import "pkg/builtins/testing"

// sizeof / alignof of a struct or array type is a constant at package level, as
// in a function, whether the type is declared before or after the constant, and
// when the type's own layout depends on another package-level constant, holds
// another type by value, or is a generic instantiation over the package's
// types.

type Point struct {
	x int32
	y int32
}

type Pair [2]int32

const PS = sizeof(Point)
const PA = alignof(Point)
const AS = sizeof(Pair)
const LS = sizeof(Later)
const LA = alignof(Later)
const BS = sizeof(Buf)

// A constant computed from them sizes an array.
var buf [PS + LS]uint8

type Later struct {
	a uint8
	b int32
	c uint8
}

type Buf struct {
	n int32
	d [N]uint8
}

const N = 5

// The array length N is declared after the constant that reads it.
const AN = sizeof([N]int32)

// Box[Pt] holds Pt by value; Outer holds Inner by value, both declared after.
type Box[T any] struct {
	v T
	n int32
}

const XB = sizeof(Box[Pt])
const XO = sizeof(Outer)

type Outer struct {
	i Inner
	k uint8
}

type Inner struct {
	p Pt
	q int32
}

type Pt struct {
	x int32
	y int32
}

// A type whose array length reads the size of a type declared after it.
type Sized [sizeof(Later) + 1]uint8

func main() {
	testing.Println(cast(int, PS), cast(int, PA), cast(int, AS))
	testing.Println(cast(int, LS), cast(int, LA), len(buf))
	testing.Println(cast(int, BS), cast(int, AN), cast(int, XB), cast(int, XO))
	var s Sized
	testing.Println(len(s))
}
