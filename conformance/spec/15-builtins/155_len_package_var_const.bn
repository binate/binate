package "main"

import "pkg/builtins/testing"

// len of a package-level array variable is a constant at package level, as in
// a function, whatever the order of the declarations, whether the variable's
// type is written as an array or names one, or is inferred from its
// initializer.

const L = len(g)
var g [3]int32

type Arr [4]int32
var h Arr
const M = len(h)

const K = len(k)
var k Later
type Later [L + M]uint8

// Inferred from a composite literal and from a function declared later.
const I = len(inf)
var inf = [5]int32{1, 2, 3, 4, 5}
const F = len(fromCall)
var fromCall = mk()

func mk() [6]uint8 {
	var a [6]uint8
	return a
}

func main() {
	testing.Println(L, M, K, I, F)
}
