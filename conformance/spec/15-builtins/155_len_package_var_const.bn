package "main"

import "pkg/builtins/testing"

// len of a package-level array variable is a constant at package level, as in
// a function, whatever the order of the declarations and whether the
// variable's type is written as an array or names one.

const L = len(g)
var g [3]int32

type Arr [4]int32
var h Arr
const M = len(h)

const K = len(k)
var k Later
type Later [L + M]uint8

func main() {
	testing.Println(L, M, K)
}
