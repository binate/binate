package "main"

import "pkg/builtins/testing"

// builtin.sizeof, decl.order.forward: an instance's `sizeof` of its type argument
// reads the layout of a type declared after the type that names the instance,
// whether that type holds the instance by value or through a pointer.

type Box[T any] struct { a [sizeof(T)]uint8 }

type M struct { b Box[N] }

type P struct { b *Box[Q] }

type N struct { v int64 }

type Q struct {
	x int32
	y int32
	z int32
}

func main() {
	var m M
	var b Box[Q]
	testing.Println(len(m.b.a))
	testing.Println(len(b.a))
}
