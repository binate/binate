package "main"

import "pkg/builtins/testing"

// builtin.sizeof: an instance's `sizeof` of a type argument that holds the
// instance by value reads the argument's own size, which has no layout: the
// cycle is rejected as one.

type Box[T any] struct { a [sizeof(T)]uint8 }

type N struct {
	v int64
	b Box[N]
}

func main() {
	testing.Println(0)
}
