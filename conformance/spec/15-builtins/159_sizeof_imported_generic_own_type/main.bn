package "main"

import "pkg/builtins/testing"
import "pkg/q"

// builtin.sizeof, gen.crosspkg.body: a name in an imported generic's declaration
// is the generic's package's: QBox's `sizeof(Inner)` is q.Inner's size, though
// this package declares its own Inner, holding a QBox by value, while QBox[int64]
// is built.

type Inner struct { b q.QBox[int64] }

func main() {
	var i Inner
	testing.Println(len(i.b.a))
	testing.Println(q.G())
}
