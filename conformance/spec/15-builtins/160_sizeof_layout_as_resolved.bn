package "main"

import "pkg/builtins/testing"

// builtin.sizeof, decl.order.forward: the layout a `sizeof` reads during
// collection is that of the type as resolved.  Box's `sizeof(T)` is its type
// parameter's, though the package declares a type T; N's P[X] only points to X,
// so N's size, read while X is collected, is no cycle; and a slice of a type
// declared later has a slice's size.

type Box[T any] struct { a [sizeof(T)]uint8 }

type T struct { b Box[int32] }

type P[T any] struct { p *T }

type X struct { b Box[N] }

type N struct { q P[X] }

type M struct { a [sizeof(@[]L)]uint8 }

type L struct { v int64 }

func main() {
	var t T
	var x X
	var m M
	testing.Println(len(t.b.a))
	testing.Println(len(x.b.a) == cast(int, sizeof(*int)))
	testing.Println(len(m.a) == cast(int, sizeof(@[]int)))
}
