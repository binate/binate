package "main"

import "pkg/builtins/testing"

// builtin.sizeof: an instance's `sizeof` of a type argument that is still being
// built — a type declaration being collected, or an instance being built —
// which names the instance only through a pointer, a slice or a function value,
// reads that argument's layout once it is built: the argument's layout does not
// depend on the instance.  So also for an interface instance whose method takes
// such a size, and for the size of a slice of a type that holds, by value, the
// type being collected.

type Box[T any] struct { a [sizeof(T)]uint8 }

type NP struct {
	v int64
	next *Box[NP]
}

type NS struct {
	v int64
	s @[]Box[NS]
}

type NF struct {
	f *func(Box[NF]) int
	v int64
}

type G[T any] struct {
	v T
	next *Box[G[T]]
}

interface Sz[T any] { m(x [sizeof(T)]uint8) int }

type H struct {
	v int64
	s *Sz[H]
}

type M struct { a [sizeof(@[]L)]uint8 }

type L struct { m M }

func main() {
	var p Box[NP]
	var s Box[NS]
	var f Box[NF]
	var g Box[G[int64]]
	var m M
	testing.Println(len(p.a) == cast(int, sizeof(NP)))
	testing.Println(len(s.a) == cast(int, sizeof(NS)))
	testing.Println(len(f.a) == cast(int, sizeof(NF)))
	testing.Println(len(g.a) == cast(int, sizeof(G[int64])))
	testing.Println(len(m.a) == cast(int, sizeof(@[]int)))
	var h H
	h.v = 1
	testing.Println(h.v)
}
