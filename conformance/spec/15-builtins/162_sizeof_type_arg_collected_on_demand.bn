package "main"

import "pkg/builtins/testing"

// builtin.sizeof: an instance's `sizeof` of a type argument that the package
// has not collected yet collects it then, and when that type's own declaration
// reads the size of a type still being collected — directly, or through a
// type, an alias, a constant, a variable, a function or a method declared
// later — it is collected again once that type is built: the lengths the
// program reads are the ones its layout has.  Each Nk is collected first and
// holds *Box[Xk], so Box[Xk] is built while Nk is collected, and collects Xk.

type Box[T any] struct { a [sizeof(T)]uint8 }

type Y8 struct { k int }

var y8 Y8

type N1 struct {
	v int64
	p *Box[X1]
}

type X1 struct { b [sizeof(N1)]uint8 }

type N2 struct {
	v int64
	p *Box[X2]
}

type X2 struct { b [T2]uint8 }

const T2 = S2 + 0

const S2 = sizeof(N2)

type N3 struct {
	v int64
	p *Box[X3]
}

type X3 struct { b [B3]uint8 }

const (
	A3 = sizeof(N3) + iota * 0
	B3
)

type N4 struct {
	v int64
	p *Box[X4]
}

type X4 struct { b [len(v4)]uint8 }

var v4 [sizeof(N4)]uint8

type N5 struct {
	v int64
	p *Box[X5]
}

type X5 struct { b [len(v5)]uint8 }

var v5 = w5

var w5 [sizeof(N5)]uint8

type N6 struct {
	v int64
	p *Box[X6]
}

type X6 struct { b [len(mk6())]uint8 }

// mk6 returns an array of N6's size.
func mk6() [sizeof(N6)]uint8 {
	var r [sizeof(N6)]uint8
	return r
}

type N7 struct {
	v int64
	p *Box[X7]
}

type X7 struct { b [len(mk7[int]())]uint8 }

// mk7 returns an array of N7's size.
func mk7[E any]() [sizeof(N7)]uint8 {
	var r [sizeof(N7)]uint8
	return r
}

type N8 struct {
	v int64
	p *Box[X8]
}

type X8 struct { b [len(y8.mk())]uint8 }

// mk returns an array of N8's size.
func (s Y8) mk() [sizeof(N8)]uint8 {
	var r [sizeof(N8)]uint8
	return r
}

type N9 struct {
	v int64
	p *Box[X9]
}

var bx9 Bx9[uint8]

type Bx9[E any] struct { e E }

type X9 struct { b [len(bx9.mk())]uint8 }

// mk returns an array of N9's size.
func (q Bx9[E]) mk() [sizeof(N9)]E {
	var r [sizeof(N9)]E
	return r
}

type N10 struct {
	v int64
	p *Box[X10]
}

type X10 struct { b A10 }

type A10 = [sizeof(N10)]uint8

type N11 struct {
	v int64
	p *Box[X11]
}

type X11 struct { b [sizeof(Z11)]uint8 }

type Z11 struct { c [sizeof(N11)]uint8 }

// agree reports whether a type's array length xb, its Box instance's length ba,
// the size nsz of the type the length reads and the type's own size xsz agree.
func agree(xb int, ba int, nsz int, xsz int) bool {
	return xb == nsz && ba == xb && xsz == xb
}

func main() {
	var b1 Box[X1]
	var x1 X1
	testing.Println(agree(len(x1.b), len(b1.a), cast(int, sizeof(N1)), cast(int, sizeof(X1))))
	var b2 Box[X2]
	var x2 X2
	testing.Println(agree(len(x2.b), len(b2.a), cast(int, sizeof(N2)), cast(int, sizeof(X2))))
	var b3 Box[X3]
	var x3 X3
	testing.Println(agree(len(x3.b), len(b3.a), cast(int, sizeof(N3)), cast(int, sizeof(X3))))
	var b4 Box[X4]
	var x4 X4
	testing.Println(agree(len(x4.b), len(b4.a), cast(int, sizeof(N4)), cast(int, sizeof(X4))))
	var b5 Box[X5]
	var x5 X5
	testing.Println(agree(len(x5.b), len(b5.a), cast(int, sizeof(N5)), cast(int, sizeof(X5))))
	var b6 Box[X6]
	var x6 X6
	testing.Println(agree(len(x6.b), len(b6.a), cast(int, sizeof(N6)), cast(int, sizeof(X6))))
	var b7 Box[X7]
	var x7 X7
	testing.Println(agree(len(x7.b), len(b7.a), cast(int, sizeof(N7)), cast(int, sizeof(X7))))
	var b8 Box[X8]
	var x8 X8
	testing.Println(agree(len(x8.b), len(b8.a), cast(int, sizeof(N8)), cast(int, sizeof(X8))))
	var b9 Box[X9]
	var x9 X9
	testing.Println(agree(len(x9.b), len(b9.a), cast(int, sizeof(N9)), cast(int, sizeof(X9))))
	var b10 Box[X10]
	var x10 X10
	testing.Println(agree(len(x10.b), len(b10.a), cast(int, sizeof(N10)), cast(int, sizeof(X10))))
	var b11 Box[X11]
	var x11 X11
	testing.Println(agree(len(x11.b), len(b11.a), cast(int, sizeof(N11)), cast(int, sizeof(X11))))
	var n int = len(v5) + len(mk6()) + len(mk7[int]()) + len(y8.mk()) + len(bx9.mk())
	testing.Println(n == 5 * cast(int, sizeof(N1)))
}
