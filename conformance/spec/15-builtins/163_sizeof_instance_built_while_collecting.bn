package "main"

import "pkg/builtins/testing"

// builtin.sizeof: an instance that waits only for another instance being built
// is built again once no instance is being built, while a type or an interface
// declaration is still collected — so a `sizeof` of it later in that
// declaration reads its layout, the one the program has.  Box[N[int64]] is
// built while N[int64] is, from N's field, and waits for it.

type Box[T any] struct { a [sizeof(T)]uint8 }

type N[T any] struct {
	v    T
	next *Box[N[T]]
}

type S struct {
	m N[int64]
	k [sizeof(Box[N[int64]])]uint8
}

interface I {
	m() N[int64]
	k() [sizeof(Box[N[int64]])]uint8
}

type T struct { j int }

func (t *T) m() N[int64] {
	var n N[int64]
	return n
}

func (t *T) k() [sizeof(Box[N[int64]])]uint8 {
	var r [sizeof(Box[N[int64]])]uint8
	return r
}

impl *T : I

func main() {
	var b Box[N[int64]]
	var s S
	var t T
	var i *I = &t
	testing.Println(len(b.a) == cast(int, sizeof(N[int64])))
	testing.Println(len(s.k) == len(b.a))
	testing.Println(len(i.k()) == len(b.a))
}
