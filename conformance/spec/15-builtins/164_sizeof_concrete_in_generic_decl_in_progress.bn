package "main"

import "pkg/builtins/testing"

// builtin.sizeof: a generic's own declaration that takes the size of a concrete
// type still being built — a type declaration being collected, or an instance
// being built — which names an instance of the generic only through a pointer,
// reads that type's layout once it is built: the type's layout does not depend
// on the instance.  So does a declaration that reads such a size through a type
// declared later, and one that reads a method of an interface being collected.

type Box[T any] struct {
	a [sizeof(N)]uint8
	t T
}

type N struct {
	v int64
	p *Box[int]
}

type Bx[T any] struct {
	a [sizeof(W[int64])]uint8
	t T
}

type W[T any] struct {
	v T
	p *Bx[T]
}

type Bd[T any] struct {
	a [sizeof(X)]uint8
	t T
}

type M struct {
	v int64
	p *Bd[int]
}

type X struct {
	b [sizeof(M)]uint8
}

type Bi[T any] struct {
	a [len(i.n())]uint8
	t *T
}

interface I {
	m() *Bi[int]
	n() [4]uint8
}

var i *I

func main() {
	var w W[int64]
	var b Box[int]
	var x Bx[int64]
	testing.Println(len(b.a) == cast(int, sizeof(N)))
	testing.Println(len(x.a) == cast(int, sizeof(W[int64])))
	b.a[len(b.a) - 1] = 7
	w.v = 5
	testing.Println(cast(int, b.a[len(b.a) - 1]) + cast(int, w.v))
	var d Bd[int]
	testing.Println(len(d.a) == cast(int, sizeof(X)) && len(d.a) == cast(int, sizeof(M)))
	var e Bi[int]
	testing.Println(len(e.a))
}
