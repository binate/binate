package "main"

import "pkg/builtins/testing"

// builtin.sizeof: a constant that takes the size of an instance whose fields
// name an instance of a generic only through a pointer has that size, also when
// the generic's declaration reads the constant: the size does not depend on the
// generic's layout.  So does a constant the generic reads through another
// constant.

type Bx[T any] struct {
	a [S]uint8
	t T
}

const S = sizeof(W[int64])

type W[T any] struct {
	v T
	p *Bx[T]
}

type Cx[T any] struct {
	a [U]uint8
	t T
}

const U = R + 1

const R = sizeof(V[int32])

type V[T any] struct {
	v T
	p *Cx[T]
}

func main() {
	var b Bx[int]
	var x Bx[int64]
	testing.Println(len(b.a) == cast(int, sizeof(W[int64])))
	testing.Println(len(x.a) == len(b.a))
	var c Cx[int]
	testing.Println(len(c.a) == cast(int, sizeof(V[int32])) + 1)
	b.a[len(b.a) - 1] = 3
	c.a[len(c.a) - 1] = 4
	testing.Println(cast(int, b.a[len(b.a) - 1]) + cast(int, c.a[len(c.a) - 1]))
}
