package "main"

import "pkg/builtins/testing"

// builtin.sizeof: N's length is M's size, and M holds N by value after reaching
// it through a slice's element: N's layout depends on itself, a cycle rejected
// as one, as it is with M's fields the other way round.

type N struct {
	v int64
	a [sizeof(M)]uint8
}

type M struct {
	s *[]N
	n N
}

func main() {
	testing.Println(0)
}
