package "main"

import "pkg/alpha/beta"

// pkg.clause: a package's clause names its import path as a STRING LITERAL,
// not an identifier — here the imported package declares
// `package "pkg/alpha/beta"`. The call-site qualifier is the import path's
// LAST SEGMENT (`beta`), not a separate short package name and not the whole
// path. So a multi-segment package is referenced as `beta.Code()`.
func main() {
	if beta.Code() == 7 { println("ok") } else { println("FAIL") }
}
