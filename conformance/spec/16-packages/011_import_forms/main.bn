package "main"
import "pkg/builtins/testing"

import "pkg/one"

import (
	"pkg/two"
	tre "pkg/three"
)

// pkg.import: imports appear after the package clause and before top-level
// decls. This exercises all three spec forms in one file:
//   - a single ungrouped import         (`import "pkg/one"`)
//   - a parenthesized GROUP             (two specs inside `import ( ... )`)
//   - an optional ALIAS identifier      (`tre "pkg/three"`)
// An imported member is referenced qualified as `name.Member`, where `name`
// is the import path's last segment (`one`, `two`) or the alias (`tre`, NOT
// `three`).
func main() {
	if one.V() == 1 && two.V() == 2 && tre.V() == 3 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
