package "main"
import "pkg/builtins/testing"

import "pkg/svc"

// pkg.resolve: an import path is resolved to files on disk by searching a
// list of roots; the INTERFACE (.bni) and the IMPLEMENTATION DIRECTORY are
// resolved on two INDEPENDENT search paths. Here `pkg/svc` resolves to BOTH
// surfaces under the same root: the .bni (pkg/svc.bni, declaring the export)
// and the impl dir (pkg/svc/, supplying the body). The call links only if
// both halves were found and merged into one logical package.
func main() {
	if svc.Mul(6, 7) == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}
