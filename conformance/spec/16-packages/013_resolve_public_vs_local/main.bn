package "main"
import "pkg/builtins/testing"

import "pkg/pub"
import "locallib"

// pkg.resolve.public: by convention an import path beginning with `pkg/`
// names a SEARCHABLE ("public") package, while a NON-`pkg/` path
// (`locallib`) names a package LOCAL to the project. The spec is explicit
// that this is a LAYOUT CONVENTION realized by where the search roots point,
// NOT a rule the loader hard-codes — so both forms resolve the same way
// (`<root>/<path>.bni` + `<root>/<path>/`). This test exercises both an
// import whose path starts with `pkg/` and one that does not, confirming the
// loader resolves a bare (non-`pkg/`) path identically to a `pkg/` one.
func main() {
	if pub.V() == 10 && locallib.V() == 20 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
