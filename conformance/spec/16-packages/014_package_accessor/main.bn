package "main"
import "pkg/builtins/testing"

import "pkg/acc"
import "pkg/builtins/reflect"

// pkg.package-accessor: every package additionally has a compiler-synthesized
// `__Package()` accessor — present in every package WITHOUT any `.bni`
// declaration — that returns the package's reflection descriptor (Ch.20).
// Here `acc` declares no `__Package` in its `.bni`, yet `acc.__Package()` is
// callable and its descriptor's `.Name` is the package's import path.
//
// Implementation note (§16.6): `__Package()` is synthesized for every package
// and reachable in every mode -- the bytecode VM emits each user package's
// `__Package()` as bytecode, not only the built-in packages'.
func main() {
	var p @reflect.Package = acc.__Package()
	testing.Println(p.Name)
}
