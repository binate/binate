package "main"

import "pkg/acc"
import "pkg/builtins/reflect"

// pkg.package-accessor: every package additionally has a compiler-synthesized
// `_Package()` accessor — present in every package WITHOUT any `.bni`
// declaration — that returns the package's reflection descriptor (Ch.20).
// Here `acc` declares no `_Package` in its `.bni`, yet `acc._Package()` is
// callable and its descriptor's `.Name` is the package's import path.
//
// Implementation note (§16.6): `_Package()` is currently emitted only as a
// native function, so the bytecode VM cannot reach it for user packages
// (it works for the built-in packages) — hence the VM-mode xfails.
func main() {
	var p @reflect.Package = acc._Package()
	println(p.Name)
}
