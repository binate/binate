package "main"

import a "pkg/alpha/widget"
import b "pkg/beta/widget"

// pkg.resolve: an import path is resolved to files on disk via the FULL path,
// not the path's last segment. `pkg/alpha/widget` and `pkg/beta/widget` share
// a last segment (`widget`) but resolve to DISTINCT files under
// `<root>/pkg/alpha/widget` and `<root>/pkg/beta/widget` respectively — so
// they are distinct packages. Aliases `a`/`b` disambiguate the two at the
// call site (both would otherwise want the `widget` qualifier).
func main() {
	if a.Code() == 100 && b.Code() == 200 {
		println("ok")
	} else {
		println("FAIL")
	}
}
