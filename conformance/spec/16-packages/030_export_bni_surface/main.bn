package "main"

import "pkg/lib"

// pkg.export: a package's exported surface is its .bni — a symbol is visible
// to importers iff it is declared in the .bni.  Capitalization carries NO
// visibility meaning (unlike Go): lib exports a *lowercase* `answer` because
// it appears in lib.bni, while it keeps a *Capitalized* `Secret` private
// (declared only in the .bn).  The importer reaches only the .bni surface
// here; that lib internally uses its own private helper proves a .bn-only
// symbol is usable within its own package (just not across the boundary).
func main() {
	if lib.answer() == 42 && lib.Visible() == 7 {
		println("ok")
	} else {
		println("FAIL")
	}
}
