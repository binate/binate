package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.export: a symbol declared ONLY in a .bn is package-private — a
// cross-package reference to it is a compile error ("undefined").  lib.Secret
// is defined in pkg/lib/lib.bn but is NOT in pkg/lib.bni, so it is not part of
// lib's exported surface.  Reaching it from another package must be rejected
// (its capitalization does not make it visible).  This program must fail to
// compile.
func main() {
	testing.Println(lib.Secret())
}
