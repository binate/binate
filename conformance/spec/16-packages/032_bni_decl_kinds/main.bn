package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.bni: the .bni declares the package's public API, and each declaration
// kind has a defined boundary meaning.  This exercises:
//   - type:  Point is fully defined in the .bni (the authoritative
//            transparent definition, NOT redefined in the .bn) — the importer
//            may read its fields and take its size.
//   - const: Scale carries its full initializer in the .bni (exported; a
//            const lives in exactly one of .bni/.bn, never both).
//   - func:  Make is signature-only in the .bni; its body lives in the .bn.
// (Extern func/var forms are covered by 090/091.)
func main() {
	var p @lib.Point = lib.Make(3, 4)
	if p.X == 3 && p.Y == 4 && lib.Scale == 10 && cast(int, sizeof(lib.Point)) > 0 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
