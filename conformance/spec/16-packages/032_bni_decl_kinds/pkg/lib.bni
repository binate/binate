package "pkg/lib"

// type fully defined here: the authoritative (transparent) definition.  It is
// NOT redefined in the .bn; importers may access its fields and take sizeof.
type Point struct {
	X int
	Y int
}

// const declared here (with its full initializer) → exported.  A const lives
// in exactly one of .bni/.bn, never both (there is no extern const).
const Scale int = 10

// func: signature-only here; the body lives in pkg/lib/lib.bn.
func Make(x int, y int) @Point
