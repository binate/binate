package "main"

import "pkg/lib"

// pkg.bni.consistency (Constraint): the .bn definition must MATCH its .bni
// declaration.  pkg/lib's .bni declares `func Get() int`, but its .bn defines
// `func Get() bool` — a return-type mismatch.  An importer reads Get's type
// from the .bni, so a divergent .bn would be misread; the compiler rejects
// the mismatch.  This program must fail to compile.
func main() {
	println(lib.Get())
}
