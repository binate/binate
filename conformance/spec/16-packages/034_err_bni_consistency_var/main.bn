package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.bni.consistency (Constraint): an extern var's .bn definition must match
// its .bni declaration's type.  pkg/lib's .bni declares `var Answer int`
// (extern), but its .bn defines `var Answer bool` — an extern-var-type
// mismatch.  An importer reads Answer's type from the .bni, so a divergent
// .bn would misread the storage; the compiler rejects it.  This program must
// fail to compile.
func main() {
	testing.Println(lib.Answer)
}
