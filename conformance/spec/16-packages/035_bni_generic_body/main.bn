package "main"

import "pkg/lib"

// pkg.bni.generic: a generic declaration carries its full source-text BODY in
// the .bni (the one parse-time difference from a non-generic func, whose body
// stays in the .bn).  The consumer MONOMORPHIZES the imported generic from
// that .bni body — the "template in the header" model — so lib.Wrap[int] and
// lib.First[int] are instantiated HERE from bodies that live in lib.bni.
// (Self-contained: the generic body references only its own type-param and
// builtins — no qualified call into another package — to isolate this rule
// from the cross-package transitive-instantiation facets, 837/841.)
func main() {
	var b @lib.Box[int] = lib.Wrap[int](42)
	if lib.First[int](b) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
