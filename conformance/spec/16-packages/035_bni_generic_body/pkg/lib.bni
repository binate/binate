package "pkg/lib"

// Generic struct: the type's full definition lives in the .bni.
type Box[T any] struct { v T }

// Generic functions carry their full source-text BODY here in the .bni (the
// one parse-time difference from a non-generic func).  A consumer instantiates
// Box[int]/Wrap[int]/First[int] by monomorphizing these bodies at the use
// site — the package can otherwise ship as interface + compiled library, but a
// generic must ship its body in the .bni.
func Wrap[T any](x T) @Box[T] {
	var b @Box[T] = make(Box[T])
	b.v = x
	return b
}

func First[T any](b @Box[T]) T { return b.v }
