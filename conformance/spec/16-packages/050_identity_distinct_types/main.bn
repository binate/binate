package "main"
import "pkg/builtins/testing"

import "pkg/alpha"
import "pkg/beta"

// pkg.identity: a package's identity is its FULL import path, so the
// type `Box` declared in pkg/alpha and the type `Box` declared in
// pkg/beta are DISTINCT types (alpha.Box != beta.Box), with distinct
// linked symbols.  Each is constructed and read through its own
// package's funcs; the two never alias or collapse.  alpha.Box wraps
// the value verbatim (Get -> v); beta.Box stores v+100 (Get -> v).
// Disagreement (collapsed symbols / shared layout) would print FAIL.
func main() {
	var a @alpha.Box = alpha.Make(7)
	var b @beta.Box = beta.Make(7)
	if alpha.Get(a) == 7 && beta.Get(b) == 107 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
