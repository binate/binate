package "pkg/beta"

// beta.Make stores n+100 so beta.Box's stored value differs from
// alpha.Box's for the same argument — making a collapse of the two
// distinct same-named types observable in the output.
func Make(n int) @Box {
	var b @Box = make(Box)
	b.v = n + 100
	return b
}

func Get(b @Box) int { return b.v }
