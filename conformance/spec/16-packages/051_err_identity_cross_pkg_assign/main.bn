package "main"
import "pkg/builtins/testing"

import "pkg/dep"

// pkg.identity: main.Box and dep.Box are SAME-named but DISTINCT types
// (a package's identity is its full import path, so main.Box != dep.Box).
// A cross-package assignment between them is rejected even though the two
// structs are structurally identical — identity is nominal, not structural
// (§16.6, §7).  Both display names strip to the leaf `Box`, so the diagnostic
// falls back to the package-qualified identity ("cannot assign pkg/dep.Box to
// main.Box") rather than the baffling "cannot assign Box to Box".
type Box struct { v int }

func main() {
	var m Box
	m = dep.Make()        // dep.Box -> main.Box: rejected
	testing.Println(m.v)
}
