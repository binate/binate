package "main"
import "pkg/builtins/testing"

import "pkg/ra"

// pkg.acyclic (Constraint): the package import graph must be acyclic.
// Here pkg/ra imports pkg/rb, pkg/rb imports pkg/rc, and pkg/rc imports
// pkg/ra — a 3-package cycle.  The loader must reject it with a clear
// "import cycle" diagnostic (§16.6), not a cascade of "unknown
// package" / "undefined" errors.
func main() { testing.Println(ra.A()) }
