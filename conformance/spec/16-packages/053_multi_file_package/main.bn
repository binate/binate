package "main"
import "pkg/builtins/testing"

import "pkg/util"

// pkg.files: a package is a DIRECTORY of .bn files, all merged into one
// logical package (§16.1).  pkg/util's implementation lives in two files
// (a.bn, b.bn), both declaring `package "pkg/util"`.  a.bn's Twice() calls
// `helper()`, a package-private func defined in b.bn — cross-file
// visibility within one package — and b.bn's Plus() likewise uses a.bn's
// `base()`.  If the two files were not merged, these references would be
// "undefined".  Twice(10) -> 2*helper()=2*10=20; Plus(5) -> base()+5=100+5.
func main() {
	if util.Twice(10) == 20 && util.Plus(5) == 105 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
