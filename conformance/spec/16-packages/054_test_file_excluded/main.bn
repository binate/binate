package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.files.test: a `_test.bn` file is EXCLUDED from the normal build, so
// it contributes nothing to the package surface (§16.1).  pkg/lib has
// lib.bn (defining Real() -> 42) and lib_test.bn (which redefines Real()
// -> 999 AND defines an extra func).  If lib_test.bn were included in a
// normal build, the duplicate Real() would be a duplicate-definition
// error; because it is excluded, the build succeeds and Real() is the
// real one.  Want: 42.
func main() {
	if lib.Real() == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}
