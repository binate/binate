package "pkg/lib"

// This file ends in _test.bn, so it is excluded from the normal build
// (pkg.files.test).  If it were NOT excluded, this redefinition of Real()
// would collide with lib.bn's Real() — a duplicate-definition error — and
// would change the answer to 999.  Its exclusion is what makes the normal
// build succeed with Real() == 42.
func Real() int { return 999 }

func OnlyInTest() int { return 7 }
