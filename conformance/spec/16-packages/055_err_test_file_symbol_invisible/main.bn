package "main"

import "pkg/lib"

// pkg.files.test: a symbol declared ONLY in a `_test.bn` file is not part
// of the normal package surface (§16.1).  pkg/lib's normal file lib.bn
// references Hidden(), which is defined only in lib_test.bn.  Under a
// normal (non-test) build lib_test.bn is excluded, so Hidden is undefined
// and the build must fail with "undefined: Hidden" — proving the test-only
// symbol does not contribute to the normal build.
func main() { println(lib.Real()) }
