package "main"

// pkg.annotation.namespace: a namespaced annotation name (one containing a
// dot — here `tool.lint` and `compiler.inline`) is metadata for another tool
// and is ignored by the compiler.  pkg.annotation: an annotation block holds
// comma-separated entries, each a (possibly dotted) name with an optional
// parenthesized argument list.  The block attaches to the declaration it
// immediately precedes and is otherwise inert, so the program compiles and
// runs unchanged.
#[tool.lint("no-unused"), compiler.inline]
func answer() int { return 42 }

func main() {
	if answer() == 42 { println("ok") } else { println("FAIL") }
}
