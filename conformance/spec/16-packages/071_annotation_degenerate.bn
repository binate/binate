package "main"

// pkg.annotation: the parser tolerates the degenerate empty forms — an empty
// block `#[]`, and an entry with an empty argument list `name()`.  They carry
// no meaning, so the annotated declarations compile and behave exactly as if
// unannotated.  `tool.note()` is also namespaced (dotted), reinforcing that a
// namespaced name with empty args is silently ignored.
#[]
func a() int { return 1 }

#[tool.note()]
func b() int { return 2 }

func main() {
	if a() + b() == 3 { println("ok") } else { println("FAIL") }
}
