package "main"
import "pkg/builtins/testing"

// pkg.annotation.no-stack: at most one annotation block precedes each element;
// blocks do not stack.  Two adjacent blocks before one declaration is an
// error — the parser consumes a single leading block, then the second `#[`
// appears where a declaration keyword is required, so the declaration parse
// fails.  (To carry multiple annotations, use comma-separated entries within
// one block.)
#[tool.a]
#[tool.b]
func f() int { return 0 }

func main() {
	testing.Println(f())
}
