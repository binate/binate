package "main"
import "pkg/builtins/testing"

// pkg.annotation: where a block's entries or an entry's arguments span lines, a
// trailing comma may follow the last one, as in any list
// (lex.semicolon.trailing-comma) -- and must when the `]` or `)` starts the next
// line.  Each block below takes one, and its gate still decides which of the two
// `which` declarations survives: without a working gate they would collide.
#[build(is(os, "linux"),
)]
func which() int { return 1 }

#[
	tool.note("not linux",
	),
	build(!is(os, "linux")),
]
func which() int { return 1 }

func main() {
	if which() == 1 { testing.Println("ok") } else { testing.Println("FAIL") }
}
