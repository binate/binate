package "main"

import "pkg/fkind"

// pkg.build.gate (file-level): pkg/fkind ships two impl files, each gated on
// its PACKAGE CLAUSE by complementary `#[build(...)]` constraints
// (`is(arch, "x64")` vs its negation).  The file-level gate drops the whole
// non-matching file from the package, so exactly one `Kind` definition
// contributes for any target — no duplicate-definition error.  Both bodies
// return a non-empty string, so `Kind()` is always callable and the assertion
// is target-independent.  A clean run also proves the file gate is active: if
// it were not, the two `Kind` definitions across the two files would collide.
func main() {
	if len(fkind.Kind()) > 0 { println("ok") } else { println("FAIL") }
}
