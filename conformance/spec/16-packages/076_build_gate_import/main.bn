package "main"
import "pkg/builtins/testing"

import "pkg/ipick"

// pkg.build.gate (import-level) + pkg.annotation (annotation in the import
// position): pkg/ipick conditionally imports ONE of two per-target helpers,
// each import gated by a complementary `#[build(...)]` on the import
// declaration itself, and selects the matching `Pick` body by the same
// condition.  Only the matching import is followed (the other dependency is
// not even resolved), so exactly one helper contributes.  Both helpers' tags
// are non-empty, so the assertion is target-independent while still proving an
// import was gated.
func main() {
	if len(ipick.Pick()) > 0 { testing.Println("ok") } else { testing.Println("FAIL") }
}
