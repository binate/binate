package "pkg/ipick"

// Conditional imports: only the matching helper is followed.  The annotation
// block leads the import declaration (an annotation in the import position),
// and gates that import per target.
#[build(is(arch, "x64"))]
import "pkg/ip_x64"
#[build(!is(arch, "x64"))]
import "pkg/ip_other"

#[build(is(arch, "x64"))]
func Pick() *[]readonly char {
	return ip_x64.Tag()
}
#[build(!is(arch, "x64"))]
func Pick() *[]readonly char {
	return ip_other.Tag()
}
