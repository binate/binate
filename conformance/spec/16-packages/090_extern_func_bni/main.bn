package "main"

import "pkg/svc"

// pkg.extern: pkg/svc's .bni declares a body-less `func Add(int, int)
// int` — an extern function whose implementation lives in the .bn.
// There is no `extern` keyword or `#[extern]` annotation; externness
// is conferred solely by the body-less .bni form (§16.9). The importer
// links against the .bn-supplied body.
func main() {
	if svc.Add(40, 2) == 42 { println("ok") } else { println("FAIL") }
}
