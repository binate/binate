package "main"
import "pkg/builtins/testing"

import "pkg/store"

// pkg.extern: pkg/store's .bni declares `var Answer int` with NO
// initializer — an extern var. The storage lives in the package's
// .bn, which defines Answer with an identical type (§16.5 var, §16.9).
// So `var` CAN be extern (unlike const). The importer reads Answer's
// type from the .bni and links the .bn-supplied storage — ONE variable,
// not a copy: a write from either side is observed from the other.
func main() {
	var ok bool = store.Answer == 42 && store.Get() == 42
	store.Answer = 7 // the importer writes; the defining package sees it
	if store.Get() != 7 { ok = false }
	store.Set(9) // the defining package writes; the importer sees it
	if store.Answer != 9 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
