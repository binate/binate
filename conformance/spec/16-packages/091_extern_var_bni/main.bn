package "main"
import "pkg/builtins/testing"

import "pkg/store"

// pkg.extern: pkg/store's .bni declares `var Answer int` with NO
// initializer — an extern var. The storage lives in the package's
// .bn, which defines Answer with an identical type (§16.5 var, §16.9).
// So `var` CAN be extern (unlike const). The importer reads Answer's
// type from the .bni and links the .bn-supplied storage.
func main() {
	if store.Answer == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}
