package "main"

// pkg.ccall: __c_call invokes a C function with the C ABI. Calls
// libc's `int abs(int)`; C `int` is 32-bit on all our targets so the
// type is spelled int32 (Binate `int` is target-word-width, ≠ C `int`
// on a 64-bit target). The argument and return type are C-ABI-passable
// scalars, as the v1 contract requires (§16.9).
//
// Assert-internally "ok" pattern: compute abs(-42) and check it is 42.
//
// xfail in VM-interpreted modes (the bytecode VM does not do FFI, by
// design) and arm32-baremetal (no libc to link/run against).
func main() {
	var r int32 = __c_call("abs", int32, cast(int32, -42))
	if cast(int, r) == 42 { println("ok") } else { println("FAIL") }
}
