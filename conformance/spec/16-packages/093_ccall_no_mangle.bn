package "main"

// pkg.ccall: __c_call emits the C symbol VERBATIM with no Binate name
// mangling — the only such path; every other symbol is mangled from
// its package path (§16.9). The verbatim "strlen" must therefore link
// directly to libc's `size_t strlen(const char *)`. This also exercises
// the POINTER argument path: a local [N]char filled byte-by-byte, with
// the address of element 0 bit_cast to *uint8 for C's `const char *`
// (Binate string literals default to a 2-word raw slice — the wrong
// shape for `const char *`). The return is the word-width count, so int.
//
// Assert-internally "ok" pattern: strlen("hello") must be 5.
//
// xfail in VM-interpreted modes (the bytecode VM does not do FFI, by
// design) and arm32-baremetal (no libc to link/run against).
func main() {
	var s [6]char
	s[0] = 'h'
	s[1] = 'e'
	s[2] = 'l'
	s[3] = 'l'
	s[4] = 'o'
	s[5] = '\0'
	var p *uint8 = bit_cast(*uint8, &s[0])
	var n int = __c_call("strlen", int, p)
	if cast(int, n) == 5 { println("ok") } else { println("FAIL") }
}
