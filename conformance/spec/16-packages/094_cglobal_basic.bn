package "main"

// pkg.cglobal: __c_global("sym", T) yields the ADDRESS of a C global variable
// as a raw *T, emitted verbatim (no name mangling).  POSIX `environ` has C type
// char** (Binate **char), so __c_global("environ", **char) is a ***char and *it
// is the current **char — a null-terminated array of *char C strings (§16.9).
//
// Assert-internally "ok": a non-empty environment confirms the recovered
// address reads the real environ.
//
// Runs LIVE on the LLVM modes and (since §5b) all native GOT modes (aarch64
// Mach-O; x64 ELF + Mach-O).  xfail only in VM-interpreted modes (the bytecode
// VM does no FFI) and arm32-baremetal (no libc `environ`).
func main() {
	var pp ***char = __c_global("environ", **char)
	var env **char = *pp
	if present(unsafe_index(env, 0)) { println("ok") } else { println("FAIL") }
}
