package "main"
import "pkg/builtins/testing"

import "pkg/bad_annot"
import "pkg/bad_pred"
import "pkg/bad_tag"
import "pkg/bad_func"
import "pkg/bad_ordered"
import "pkg/bad_version"
import "pkg/bad_verconcat"
import "pkg/bad_compare"
import "pkg/bad_unary"
import "pkg/bad_bare"
import "pkg/bad_expr"

// pkg.build.errors: a `#[build(...)]` constraint that FAILS TO EVALUATE under a
// resolved target is a hard error that aborts the build — never a silent skip.
// Each imported package carries one declaration whose constraint fails in a
// different way (the rule's full list: an unknown unqualified annotation, an
// unknown predicate or tag, an unknown predicate function, an ordered matcher on a
// non-version key, a malformed or adjacent-concatenated version literal, a
// comparison or other disallowed operator, a malformed expression); the gate stops
// at a package's first failure, so one package per case lets a single build
// report every diagnostic.  The build must fail before `main` can run.
func main() {
	var s int = bad_annot.F() + bad_pred.F() + bad_tag.F() + bad_func.F()
	s = s + bad_ordered.F() + bad_version.F() + bad_verconcat.F() + bad_compare.F()
	s = s + bad_unary.F() + bad_bare.F() + bad_expr.F()
	if s > 0 { testing.Println("unreachable: the build should have failed") }
}
