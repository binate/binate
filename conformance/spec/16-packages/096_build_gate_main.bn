package "main"
import "pkg/builtins/testing"

// pkg.build.gate in the MAIN program's own file: the declaration-level gate applies
// here exactly as in an imported package.  The complementary `pick` pair
// contributes one definition for any target (no redeclaration), and the
// always-false gate drops `neverBuilt` entirely — its body names something that
// does not exist, so the program compiles only if the element really is dropped.
#[build(is(arch, "aarch64"))]
func pick() int { return 1 }

#[build(!is(arch, "aarch64"))]
func pick() int { return 2 }

#[build(is(arch, "x64") && !is(arch, "x64"))]
func neverBuilt() int { return doesNotExist() }

func main() {
	if pick() > 0 { testing.Println("ok") } else { testing.Println("FAIL") }
}
