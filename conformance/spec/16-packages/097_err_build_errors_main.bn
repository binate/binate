package "main"
import "pkg/builtins/testing"

// pkg.build.errors in the MAIN program's own file: a constraint that fails to
// evaluate (here an unknown predicate function) aborts the build, exactly as in an
// imported package — it is never silently skipped.
#[build(gt(version, "1.0.0"))]
func f() int { return 1 }

func main() {
	if f() > 0 { testing.Println("unreachable: the build should have failed") }
}
