package "main"
import "pkg/builtins/testing"

import "pkg/ptype"
import "pkg/pcount"
import "pkg/rcount"

// pkg.bni.consistency (Constraint): the .bn definition must MATCH its .bni
// declaration in every part of the signature, not only the return type (033) or
// a var's type (034).  Each package's .bni declares `func Put(x int) int`; its .bn
// diverges in one way — a parameter's type, the parameter count, or the result
// count.  An importer reads Put's signature from the .bni, so each divergence is
// rejected, and one build reports all three.  This program must fail to compile.
func main() {
	testing.Println(ptype.Put(1) + pcount.Put(1) + rcount.Put(1))
}
