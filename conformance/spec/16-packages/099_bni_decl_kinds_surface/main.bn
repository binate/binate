package "main"
import "pkg/builtins/testing"

import "pkg/geo"

// pkg.bni: the .bni declaration kinds 032 does not cover.
//   - interface: Shape is declared in the .bni, part of the surface.
//   - impl:      Sq's impl is declared in the .bni, so Sq satisfies Shape for
//                an importer; Rect's is supplied by the .bn alone, private to
//                the package (pkg.export), which uses it in RectArea.
//   - opaque:    the body-less `type Tok` is a forward declaration; the full
//                definition is private to the .bn, and the importer holds a
//                @Tok only through the package's functions.
func main() {
	var q geo.Sq
	q.S = 3
	var r geo.Rect
	r.W = 2
	r.H = 5
	var a *geo.Shape = &q
	var t @geo.Tok = geo.NewTok(42)
	if a.Area() == 9 && geo.RectArea(&r) == 10 && geo.TokVal(t) == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
