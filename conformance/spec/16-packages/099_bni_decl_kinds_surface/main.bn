package "main"
import "pkg/builtins/testing"

import "pkg/geo"

// pkg.bni: the .bni declaration kinds 032 does not cover.
//   - interface: Shape is declared in the .bni, part of the surface.
//   - impl:      Sq's impl is declared in the .bni; Rect's is supplied by the
//                .bn alone — either placement makes the type satisfy Shape for
//                an importer.
//   - opaque:    the body-less `type Tok` is a forward declaration; the full
//                definition is private to the .bn, and the importer holds a
//                @Tok only through the package's functions.
func main() {
	var q geo.Sq
	q.S = 3
	var r geo.Rect
	r.W = 2
	r.H = 5
	var a *geo.Shape = &q
	var b *geo.Shape = &r
	var t @geo.Tok = geo.NewTok(42)
	if a.Area() == 9 && b.Area() == 10 && geo.TokVal(t) == 42 {
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
