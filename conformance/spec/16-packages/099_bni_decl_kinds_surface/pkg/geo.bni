package "pkg/geo"

// interface: declared in the .bni as part of the package's surface.
interface Shape {
	Area() int
}

// A type whose impl is declared here in the .bni ...
type Sq struct {
	S int
}

impl *Sq : Shape

func (q *Sq) Area() int

// ... and one whose impl is supplied by the .bn alone.
type Rect struct {
	W int
	H int
}

func (r *Rect) Area() int

// A body-less type: a forward / opaque declaration.  Its layout is private to
// the .bn; importers hold a @Tok but cannot reach its fields.
type Tok

func NewTok(v int) @Tok
func TokVal(t @Tok) int
