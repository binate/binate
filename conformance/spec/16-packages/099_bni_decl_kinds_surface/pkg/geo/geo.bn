package "pkg/geo"

impl *Rect : Shape

func (q *Sq) Area() int { return q.S * q.S }

func (r *Rect) Area() int { return r.W * r.H }

func RectArea(r *Rect) int {
	var s *Shape = r
	return s.Area()
}

type Tok struct {
	v int
}

func NewTok(v int) @Tok {
	var t @Tok = make(Tok)
	t.v = v
	return t
}

func TokVal(t @Tok) int { return t.v }
