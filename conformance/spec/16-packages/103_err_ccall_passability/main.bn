package "main"
import "pkg/builtins/testing"

import "pkg/bx"

// pkg.ccall: what crosses the C boundary through `__c_call` is checked at compile
// time.  No default argument promotion happens there, so a VARIADIC-tail argument
// must already have its C-promoted type — a sub-int integer, a bool, a char, or a
// float32 there is rejected (one per line below, so each is load-bearing).  And
// the return type must have a defined C-ABI layout, which an opaque-by-value type
// does not.  This program must fail to compile.
func main() {
	var f *[]readonly char = "%d\n"
	__c_call("printf", int32, &f[0], ..., cast(int8, 5))
	__c_call("printf", int32, &f[0], ..., true)
	__c_call("printf", int32, &f[0], ..., 'c')
	__c_call("printf", int32, &f[0], ..., cast(float32, 1.5))
	__c_call("make_box", bx.Box)
	testing.Println("unreachable: the __c_call arguments must be rejected")
}
