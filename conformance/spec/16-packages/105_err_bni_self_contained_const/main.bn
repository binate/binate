package "main"

import "pkg/builtins/testing"

import "pkg/q"

// pkg.bni.self-contained (Constraint): a .bni declaration resolves against
// the .bni alone.  A .bni constant may name the .bni's other constants (and
// other packages'), not one only the .bn declares.  This program must fail to
// compile.

func main() {
	testing.Println(cast(int, q.X * 10.0))
}
