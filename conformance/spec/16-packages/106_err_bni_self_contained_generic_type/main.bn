package "main"

import "pkg/builtins/testing"

import "pkg/q"

// pkg.bni.self-contained (Constraint): a .bni declaration resolves against
// the .bni alone.  A .bni generic type's body naming a generic type only the
// .bn declares is an error.  This program must fail to compile.

func main() {
	var b @q.Box[int] = make(q.Box[int])
	testing.Println(b == nil)
}
