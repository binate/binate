package "main"

import "pkg/builtins/testing"

import "pkg/q"

// pkg.bni.self-contained (Constraint): a .bni declaration resolves against
// the .bni alone.  A .bni generic function's body is monomorphized from the
// .bni, so calling a function only the .bn declares is an error.  This program
// must fail to compile.

func main() {
	testing.Println(q.Twice[int](1))
}
