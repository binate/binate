package "main"

import "pkg/builtins/testing"

import "pkg/q"

// pkg.bni.self-contained (Constraint): a .bni declaration resolves against
// the .bni alone.  A .bni impl of a type only the .bn declares is an error.
// This program must fail to compile.

func main() {
	testing.Println(q.Get(q.Make()))
}
