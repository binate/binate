package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.export: a generic type declared only in a .bn is package-private, like
// any other name: lib.Box is defined in pkg/lib/lib.bn but not in pkg/lib.bni,
// so instantiating it from another package must be rejected.  This program must
// fail to compile.
func main() {
	var b @lib.Box[int] = make(lib.Box[int])
	b.v = 3
	testing.Println(b.v + lib.Visible())
}
