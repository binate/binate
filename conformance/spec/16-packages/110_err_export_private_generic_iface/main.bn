package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.export: a generic interface declared only in a .bn is package-private,
// like any other name: lib.Getter is defined in pkg/lib/lib.bn but not in
// pkg/lib.bni, so instantiating it from another package must be rejected.  This
// program must fail to compile.
func use(g @lib.Getter[int]) int {
	return lib.Visible()
}

func main() {
	var g @lib.Getter[int]
	testing.Println(use(g))
}
