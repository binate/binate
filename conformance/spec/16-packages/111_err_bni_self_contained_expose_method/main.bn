package "main"
import "pkg/builtins/testing"

import "pkg/a"

// pkg.bni.self-contained (Constraint), pkg.expose.surface: an expose extends only
// pkg/a's exported surface, not the names its .bni resolves, so a .bni method
// naming the exposed X bare is an error.  This program must fail to compile.
func main() {
	var t @a.T = make(a.T)
	testing.Println(t.Get() != nil)
}
