package "main"
import "pkg/builtins/testing"

import "pkg/a"

// pkg.bni.self-contained (Constraint), pkg.expose.surface: an expose extends only
// pkg/a's exported surface, not the names its .bni resolves, so a .bni constant
// naming the exposed N bare is an error.  This program must fail to compile.
func main() {
	testing.Println(a.M)
}
