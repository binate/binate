package "main"
import "pkg/builtins/testing"

import "pkg/q"

// pkg.bni.generic.once (Constraint): a generic function, or a method of a
// generic type, that the .bni defines is not defined again in the .bn.  pkg/q's
// .bn defines both Twice and Box.Get a second time.  This program must fail to
// compile.
func main() {
	var b @q.Box[int] = make(q.Box[int])
	b.v = 4
	testing.Println(q.Twice[int](3), b.Get())
}
