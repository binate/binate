package "main"
import "pkg/builtins/testing"

import "pkg/f"

// pkg.export, pkg.expose.surface: an expose re-exports pkg/p's exported surface,
// and a generic type only pkg/p's .bn declares is not part of it, so naming it
// through the forwarder is an error.  This program must fail to compile.
func main() {
	var h @f.Hidden[int] = make(f.Hidden[int])
	testing.Println(h == nil)
}
