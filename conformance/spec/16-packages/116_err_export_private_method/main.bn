package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.export: a method only a .bn declares is package-private, even on a type the
// .bni exports, so calling lib.T's dbl from another package is an error.  This
// program must fail to compile.
func main() {
	testing.Println(lib.Make(4).dbl())
}
