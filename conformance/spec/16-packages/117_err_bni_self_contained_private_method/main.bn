package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.bni.self-contained (Constraint): a .bni generic body is monomorphized in
// importers, so it sees lib.T as they do — calling dbl, which only the .bn
// declares, is an error.  This program must fail to compile.
func main() {
	testing.Println(lib.Twice[int](lib.Make(4)))
}
