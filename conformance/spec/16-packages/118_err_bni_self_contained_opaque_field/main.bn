package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.bni.self-contained (Constraint), type.opaque.field-rejection: lib's .bni
// declares O opaque, so a .bni generic body cannot read its field.  This program
// must fail to compile.
func main() {
	testing.Println(lib.W[int](lib.MkO()))
}
