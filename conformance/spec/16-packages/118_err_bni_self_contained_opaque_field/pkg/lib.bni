package "pkg/lib"

// T holds a value.
type T struct {
	v int
}

// Make returns a T holding v.
func Make(v int) @T

// Get returns twice the value.
func (t @T) Get() int

// O is opaque.
type O

// MkO returns an O.
func MkO() @O

// W reads O's field, which only the .bn declares.
func W[E any](o @O) int { return o.w }
