package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.bni.self-contained (Constraint), type.opaque.builtin-rejection: lib's .bni
// declares O opaque, so it cannot hold an O by value or take its size.  This
// program must fail to compile.
func main() {
	testing.Println(lib.Make(4).Get())
}
