package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg.bni.self-contained (Constraint): a .bni declaration sees a type's members
// as an importer does, so an impl in lib's .bni cannot bind dbl, which only lib's
// .bn declares.  This program must fail to compile.
func main() {
	testing.Println(lib.Make(4).Get())
}
