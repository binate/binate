package "main"
import "pkg/builtins/testing"

import "pkg/geo"

// pkg.bni.self-contained, pkg.export: geo's .bni sees geo as an importer does,
// so its generic AsShape cannot construct a Shape from a Rect through the impl
// only geo's .bn declares.
func main() {
	var r geo.Rect
	r.W = 2
	r.H = 5
	testing.Println(geo.AsShape[int](&r).Area())
}
