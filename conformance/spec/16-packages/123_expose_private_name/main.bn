package "main"

import "pkg/builtins/testing"

import "pkg/agg"

// pkg.expose.surface, pkg.expose.conflict: agg exposes pkg/p, whose MakePoint
// main reaches as agg.MakePoint.  agg's .bn declares a private MakePoint of its
// own, with another signature, which neither collides with the exposed one nor
// is checked against it, and reaches pkg/p's through an ordinary import.
func main() {
	testing.Println(agg.MakePoint(1, 2))
	testing.Println(agg.Twice())
}
