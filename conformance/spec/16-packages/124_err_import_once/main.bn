package "main"

import "pkg/builtins/testing"
import "pkg/qa"
import "pkg/qa"
import q "pkg/qa"
import _ "pkg/qa"
import (
	t "pkg/builtins/testing"
)
import "pkg/qb"

// pkg.import.once: a file imports a package at most once, under any names.
// Each import of a package after the file's first is an error: the same import
// again, the package under another name, the blank identifier, in a group.
// pkg/qb's .bni and one of its .bn files repeat an import too; its other .bn
// file imports pkg/qa again, which another file may.

func main() {
	testing.Println(qa.Get(), qb.Get())
}
