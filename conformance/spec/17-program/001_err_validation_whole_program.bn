package "main"
import "pkg/builtins/testing"

// prog.validation: a non-interactive program is FULLY validated before any
// execution begins -- the whole program is type-checked first, and any error
// stops it from running. A type error in `bad`, which `main` never calls, still
// fails the build; "would-run" is never printed because validation precedes
// execution.
func bad() {
	var x int = true
	_ = x
}

func main() {
	testing.Println("would-run")
}
