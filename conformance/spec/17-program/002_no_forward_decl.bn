package "main"
import "pkg/builtins/testing"

// prog.no-forward-decl: because validation sees the whole program, no forward
// declarations are required -- main refers to `later`, declared after it, and it
// resolves through the deferred-validation model.
func main() {
	if later() == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}

func later() int {
	return 42
}
