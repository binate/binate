package "main"

// prog.modes: the SAME type system and rules apply in compiled and interpreted
// execution -- only the timing of validation differs. This ordinary program runs
// identically in every mode; the suite running it in both compiled and
// interpreted modes is itself the cross-mode agreement check (§2.4, §19).
func main() {
	var sum int = 0
	for i := 0; i < 5; i = i + 1 { sum = sum + i }
	if sum == 10 { println("ok") } else { println("FAIL") }
}
