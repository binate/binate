package "main"

// prog.init.order: within a package, package-level var initializers run in
// SOURCE-DECLARATION order, so a later global reads an earlier one's already-
// initialized value. Second is declared after First and reads it.
var First int = 10
var Second int = First + 5

func main() {
	if First == 10 && Second == 15 { println("ok") } else { println("FAIL") }
}
