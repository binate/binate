package "main"

// prog.init.vars / prog.entry.sequence: initialization runs each package-level
// `var x T = e` as the assignment x = e, before main. The entry point runs all
// package init in dependency order, THEN calls main -- so a global initialized
// by a function call has its value ready when main observes it.
var G int = compute()

func compute() int {
	return 42
}

func main() {
	if G == 42 { println("ok") } else { println("FAIL") }
}
