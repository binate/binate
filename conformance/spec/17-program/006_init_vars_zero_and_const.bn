package "main"
import "pkg/builtins/testing"

// prog.init.vars: a `var` declared without an initializer is zero-initialized
// and does no init-time work; a `const` is NOT part of initialization (it has no
// storage -- each use is replaced by its value at compile time).
var Z int
const C int = 99

func main() {
	if Z == 0 && C == 99 { testing.Println("ok") } else { testing.Println("FAIL") }
}
