package "main"
import "pkg/builtins/testing"

// prog.no-init-func: there is NO init() function -- a package has no implicit
// initializer hook. `func init` is an ordinary function, not auto-called before
// main, so the global it would set stays at its declared value.
var log int = 0

func init() {
	log = 99
}

func main() {
	if log == 0 { testing.Println("ok") } else { testing.Println("FAIL") }
}
