package "main"

// prog.main.signature: the entry function is `func main()` with NO parameters
// and no results. A `func main` in package main that takes a parameter is
// wrong-shaped and rejected -- the SIGNATURE is checked at compile time when the
// main package is compiled (§17.3.1; whether a main package EXISTS at all is the
// complementary link-time check). The value-returning half is 017.
func main(x int) {
	println("ran-with-param")
}
