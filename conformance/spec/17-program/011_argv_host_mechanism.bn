package "main"

import "pkg/builtins/startup"

// prog.argv: command-line arguments, where the host provides them, are reached
// through a tier-0/runtime mechanism (here startup.Args(), the entry/startup glue
// the hosted entry populates), NOT through a main parameter -- the core language
// defines no main(argv), and no stdlib is required (startup is a builtins
// package; os.Args merely re-exports this).  startup.Args() returns a valid
// managed-slice; its contents are host-dependent (element 0 the program name,
// 1.. the arguments), so this asserts only that the mechanism is reachable and
// well-formed.
func main() {
	var args @[]readonly @[]readonly char = startup.Args()
	if len(args) >= 0 { println("ok") } else { println("FAIL") }
}
