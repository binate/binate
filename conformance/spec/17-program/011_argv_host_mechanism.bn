package "main"

import "pkg/bootstrap"

// prog.argv: command-line arguments, where the host provides them, are reached
// through a tier-0/runtime mechanism (here bootstrap.Args), NOT through a main
// parameter -- the core language defines no os.Args. The call returns a valid
// managed-slice; its contents are host-dependent (a freestanding target may have
// none), so this asserts only that the mechanism is reachable and well-formed.
func main() {
	var args @[]@[]char = bootstrap.Args()
	if len(args) >= 0 { println("ok") } else { println("FAIL") }
}
