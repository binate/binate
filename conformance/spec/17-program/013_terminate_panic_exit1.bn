package "main"
import "pkg/builtins/testing"

// prog.panic / prog.terminate / prog.panic.defined: a defined non-recoverable
// runtime panic terminates the program (exit 1, diagnostic to stdout). An index
// out of bounds (the index is a runtime value so it is not a compile-time error)
// is one of the closed set; the program aborts and "after" is never reached.
func idx() int { return 5 }

func main() {
	var a [3]int
	testing.Println(a[idx()])
	testing.Println("after")
}
