package "main"
import "pkg/builtins/testing"

// prog.panic.defined: integer divide-by-zero on a RUNTIME (non-constant)
// divisor is a defined non-recoverable panic from the closed set (§13.4), not
// undefined behavior -- it deterministically aborts with the defined diagnostic.
func zero() int { return 0 }

func main() {
	var b int = zero()
	testing.Println(10 / b)
}
