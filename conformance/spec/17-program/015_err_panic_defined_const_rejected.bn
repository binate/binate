package "main"

// prog.panic.defined: a panic-triggering value that is a COMPILE-TIME CONSTANT
// is rejected at compile time instead of being a runtime panic -- a constant
// zero divisor is a compile error (§13.4), so the runtime panic applies only to
// non-constant operands (contrast 014, a runtime divisor).
func main() {
	var x int = 1 / 0
	_ = x
}
