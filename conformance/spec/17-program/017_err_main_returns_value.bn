package "main"

// prog.main.signature (§17.3): the entry function is `func main()` with no
// parameters and no results. A value-returning `func main() int` is ill-formed
// (the result would be discarded) and must be rejected -- the result half of
// the wrong-signature rule (009 covers the extra-parameter half).
func main() int {
	return 0
}
