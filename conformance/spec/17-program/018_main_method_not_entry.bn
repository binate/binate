package "main"

// prog.main.signature: only the TOP-LEVEL `main` of package main is the entry.
// A METHOD named `main` (with a receiver) is an ordinary method, NOT the entry,
// and may have any signature -- the signature gate must not fire on it.
type T struct { v int }

func (t T) main(x int) int { return t.v + x }

func main() {
	var t T = T{v: 40}
	println(t.main(2))  // 42
}
