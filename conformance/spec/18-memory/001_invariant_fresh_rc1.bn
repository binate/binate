package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.invariant: every live reference is reflected in rc(o), and a FRESH
// allocation begins with rc = 1. `make`, `box`, and `make_slice` all produce a
// managed allocation whose sole live reference (the binding) gives rc 1.

type T struct {
	v int
}

func main() {
	var ok bool = true
	var a @T = make(T)
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 { ok = false }
	var b @int = box(7)
	var pb *uint8 = bit_cast(*uint8, b)
	if rt.Refcount(pb) != 1 { ok = false }
	var s @[]@T = make_slice(@T, 1)
	var e @T = make(T)
	var pe *uint8 = bit_cast(*uint8, e)
	if rt.Refcount(pe) != 1 { ok = false }
	s[0] = e
	if rt.Refcount(pe) != 2 { ok = false }   // element store acquires (mem.refinc)
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
