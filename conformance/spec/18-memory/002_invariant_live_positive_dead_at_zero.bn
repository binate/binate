package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.invariant: live ref -> rc>0; rc reaching 0 destroys the allocation.
// Observed via Outer holding Inner: Outer at rc 0 (block exit) runs its
// destructor releasing Inner, dropping Inner's count back.

type Inner struct { v int }
type Outer struct { inner @Inner }

func main() {
	var ok bool = true
	var inner @Inner = make(Inner)
	var pi *uint8 = bit_cast(*uint8, inner)
	if rt.Refcount(pi) != 1 { ok = false }
	{
		var o @Outer = make(Outer)
		o.inner = inner
		if rt.Refcount(pi) != 2 { ok = false }
	}
	if rt.Refcount(pi) != 1 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
