package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.axioms: axioms observed over one count -- make->1 (ax1), field-store
// copy->2 (ax3), reassign acquire-then-release-old->1 (ax5). The block exit then
// drops `o` and releases `fresh` (ax2 zero->destroy, on those allocations); the
// final read re-confirms inner is unchanged across the block exit. (ax2/ax4 on
// a live-counted allocation are observed by the cascade in 002/007.)

type Inner struct { v int }
type Outer struct { inner @Inner }

func main() {
	var ok bool = true
	var inner @Inner = make(Inner)
	var pi *uint8 = bit_cast(*uint8, inner)
	if rt.Refcount(pi) != 1 { ok = false }
	{
		var o @Outer = make(Outer)
		o.inner = inner
		if rt.Refcount(pi) != 2 { ok = false }
		var fresh @Inner = make(Inner)
		o.inner = fresh
		if rt.Refcount(pi) != 1 { ok = false }
	}
	if rt.Refcount(pi) != 1 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
