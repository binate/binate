package "main"

import "pkg/builtins/rt"

// mem.refinc: acquiring increments. Walks copy contexts over one allocation,
// each +1: var-decl (1->2), field store (2->3), element store (3->4).

type Inner struct { v int }
type Holder struct { f @Inner }

func main() {
	var ok bool = true
	var a @Inner = make(Inner)
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 { ok = false }
	var b @Inner = a
	if rt.Refcount(pa) != 2 { ok = false }
	var h @Holder = make(Holder)
	h.f = a
	if rt.Refcount(pa) != 3 { ok = false }
	var s @[]@Inner = make_slice(@Inner, 1)
	s[0] = a
	if rt.Refcount(pa) != 4 { ok = false }
	if b.v != 0 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
