package "main"

import "pkg/builtins/rt"

// mem.refinc boundary: acquiring a nil reference is a no-op. A nil copy stays
// nil (no fault), and a nil-assign acquires nil (no-op) then releases the old
// occupant, leaving a sibling allocation's count unchanged by the acquire half.

type T struct { v int }

func main() {
	var ok bool = true
	var z @T = nil
	var z2 @T = z
	if present(z2) { ok = false }
	var a @T = make(T)
	var keep @T = a
	var pa *uint8 = bit_cast(*uint8, keep)
	if rt.Refcount(pa) != 2 { ok = false }
	a = nil
	if present(a) { ok = false }
	if rt.Refcount(pa) != 1 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
