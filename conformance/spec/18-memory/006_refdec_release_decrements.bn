package "main"

import "pkg/builtins/rt"

// mem.refdec: releasing decrements. Reassigning an occupied slot releases its
// prior occupant; a scoped copy is released at block exit. Each -1.

type T struct { v int }

func main() {
	var ok bool = true
	var a @T = make(T)
	var pa *uint8 = bit_cast(*uint8, a)
	var b @T = a
	var c @T = a
	if rt.Refcount(pa) != 3 { ok = false }
	b = make(T)
	if rt.Refcount(pa) != 2 { ok = false }
	c = nil
	if rt.Refcount(pa) != 1 { ok = false }
	{
		var d @T = a
		if rt.Refcount(pa) != 2 { ok = false }
		if d.v != 0 { ok = false }
	}
	if rt.Refcount(pa) != 1 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
