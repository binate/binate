package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.refdec operational boundary: a release driving rc to 0 destroys the
// allocation -- its destructor runs, recursively releasing managed contents.
// Two Outers hold one Inner; releasing each Outer's last ref cascades a release
// of Inner. We keep an independent `inner` binding so the count is always live.

type Inner struct { v int }
type Outer struct { inner @Inner }

func main() {
	var ok bool = true
	var inner @Inner = make(Inner)
	var pi *uint8 = bit_cast(*uint8, inner)
	var o1 @Outer = make(Outer)
	o1.inner = inner
	var o2 @Outer = make(Outer)
	o2.inner = inner
	if rt.Refcount(pi) != 3 { ok = false }
	o1 = nil
	if rt.Refcount(pi) != 2 { ok = false }
	o2 = nil
	if rt.Refcount(pi) != 1 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
