package "main"

import "pkg/builtins/rt"

// mem.header: a 2-word {refcount, free_fn} header precedes the payload at a
// negative offset (the layout is §7.13). Observable here: rt.Refcount reads the
// header's Refcount field through the payload pointer, and a copy adjusts exactly
// that count (1 -> 2).

type T struct { v int }

func main() {
	var ok bool = true
	var a @T = make(T)
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 { ok = false }
	var b @T = a
	if rt.Refcount(pa) != 2 { ok = false }
	if b.v != 0 { ok = false }
	if ok { println("ok") } else { println("FAIL") }
}
