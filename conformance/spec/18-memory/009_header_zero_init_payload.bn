package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.header boundary: the payload of a fresh allocation is zero-initialized.
// Struct fields read zero, a fresh managed-slice element is a nil managed ptr,
// and the header still tracks the fresh allocation at rc 1.

type T struct { a int; b bool; c int }
type Inner struct { v int }

func main() {
	var ok bool = true
	var x @T = make(T)
	if x.a != 0 || x.b != false || x.c != 0 { ok = false }
	var n @int = box(0)
	if (*n) != 0 { ok = false }
	var s @[]@Inner = make_slice(@Inner, 2)
	if present(s[0]) || present(s[1]) { ok = false }
	var px *uint8 = bit_cast(*uint8, x)
	if rt.Refcount(px) != 1 { ok = false }
	if ok { testing.Println("ok") } else { testing.Println("FAIL") }
}
