package "main"

import "pkg/builtins/rt"

// mem.destructor: reassigning an owner's managed field releases the field's
// prior occupant. With a shared inner (its own count tracks both owners), the
// boundary is: make inner (1) -> store it into a field (2) -> reassign the
// field with a fresh value, which releases the old occupant (1). Observed
// inline via rt.Refcount on the inner's bit_cast'd managed-pointer header.
type Inner struct {
	v int
}

type Outer struct {
	inner @Inner
}

func main() {
	var inner @Inner = make(Inner)
	inner.v = 7
	var pi *uint8 = bit_cast(*uint8, inner)
	if rt.Refcount(pi) != 1 {
		println("FAIL: fresh inner should be rc 1")
		return
	}

	// Store inner into Outer.inner -> field store acquires -> rc 2.
	var o @Outer = make(Outer)
	o.inner = inner
	if rt.Refcount(pi) != 2 {
		println("FAIL: field store should acquire (rc 2)")
		return
	}

	// Reassign the field with a fresh inner -> the destructor of the prior
	// occupant runs, releasing the old inner back to rc 1.
	var inner2 @Inner = make(Inner)
	o.inner = inner2
	if rt.Refcount(pi) != 1 {
		print("FAIL: field reassign should release prior occupant, rc=")
		println(rt.Refcount(pi))
		return
	}
	if o.inner.v != 0 {
		println("FAIL: reassigned field not the fresh value")
		return
	}
	println("ok")
}
