package "main"

import "pkg/builtins/rt"

// mem.destructor: when an owner's last reference is released its destructor runs
// and RECURSIVELY releases its managed contents, which may cascade further. A
// two-level nest (Top -> Mid -> Leaf) is built inside a block; on block exit the
// Top local is released, its destructor releases its Mid field, and when that
// Mid's last reference goes its destructor releases the Leaf. A separate Leaf
// binding observes the cascade: the leaf rises to rc 2 inside, and returns to
// rc 1 after the block as the cascade releases the slice/struct chain.
type Leaf struct {
	v int
}

type Mid struct {
	leaf @Leaf
}

type Top struct {
	mid @Mid
}

func main() {
	var leaf @Leaf = make(Leaf)
	leaf.v = 3
	var pl *uint8 = bit_cast(*uint8, leaf)
	if rt.Refcount(pl) != 1 {
		println("FAIL: fresh leaf should be rc 1")
		return
	}

	{
		var top @Top = make(Top)
		var mid @Mid = make(Mid)
		mid.leaf = leaf
		top.mid = mid
		if rt.Refcount(pl) != 2 {
			print("FAIL: leaf inside nest should be rc 2, got ")
			println(rt.Refcount(pl))
			return
		}
	}

	// Block exit cascades: top released -> mid released -> leaf released.
	if rt.Refcount(pl) != 1 {
		print("FAIL: destructor cascade should restore leaf to rc 1, got ")
		println(rt.Refcount(pl))
		return
	}
	println("ok")
}
