package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.destructor: a managed-slice's element destruction is tied to the BACKING's
// last reference (§7.6, §7.13). Sub-slices share one backing and one count, so
// the elements are released exactly ONCE -- when that shared backing's count
// reaches 0 -- not once per alias. Here one inner element is stored into two
// slots of a 3-element backing (rc 3 = the inner binding + two backing slots);
// aliasing the slice shares the same backing and does NOT re-acquire the
// elements (rc stays 3). On block exit the backing's sole release frees both
// element slots once, restoring the inner to rc 1.
type Inner struct {
	v int
}

func main() {
	var e @Inner = make(Inner)
	e.v = 9
	var pe *uint8 = bit_cast(*uint8, e)
	if rt.Refcount(pe) != 1 {
		testing.Println("FAIL: fresh element should be rc 1")
		return
	}

	{
		var s @[]@Inner = make_slice(@Inner, 3)
		s[0] = e
		s[1] = e
		if rt.Refcount(pe) != 3 {
			testing.Print("FAIL: two element stores should give rc 3, got ")
			testing.Println(rt.Refcount(pe))
			return
		}
		// Aliasing the slice shares the one backing+count: elements not re-acquired.
		var t @[]@Inner = s
		if rt.Refcount(pe) != 3 {
			testing.Print("FAIL: slice alias must not re-acquire elements, rc=")
			testing.Println(rt.Refcount(pe))
			return
		}
		if t[0].v != 9 {
			testing.Println("FAIL: aliased slice lost element value")
			return
		}
	}

	// Backing's last reference released once -> both element slots released once.
	if rt.Refcount(pe) != 1 {
		testing.Print("FAIL: backing destructor should restore element to rc 1, got ")
		testing.Println(rt.Refcount(pe))
		return
	}
	testing.Println("ok")
}
