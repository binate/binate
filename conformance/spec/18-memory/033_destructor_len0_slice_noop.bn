package "main"

// mem.destructor: a length-0 managed-slice has NO backing (§7.7) and therefore
// no reference and a no-op destructor. Creating and dropping one repeatedly must
// never double-free or crash -- the destructor is a defined no-op each time.
// Observed behaviorally: a tight loop creates+drops a length-0 managed-slice
// each iteration and never faults, and len stays 0.
func main() {
	var ok bool = true
	var i int = 0
	for ; i < 1000; i = i + 1 {
		var s @[]int = make_slice(int, 0)
		if len(s) != 0 {
			ok = false
		}
	}
	if ok {
		println("ok")
	} else {
		println("FAIL")
	}
}
