package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.copy: per Axiom 3, every place a managed value crosses into a new location
// ACQUIRES it. This exercises five copy sites against one shared referent and
// asserts the count rises by one at each: (1) `var` declaration, (2) `:=` short
// declaration, (3) assignment into an occupied local, (4) struct-field store,
// (5) slice-element store. Each new live reference is reflected in rc, so the
// count climbs 1 -> 6. Observed inline via rt.Refcount.
type T struct {
	v int
}

type Box struct {
	t @T
}

func main() {
	var a @T = make(T)
	a.v = 5
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 {
		testing.Println("FAIL: base should be rc 1")
		return
	}

	// 1. var-declaration copy.
	var b @T = a
	if rt.Refcount(pa) != 2 {
		testing.Println("FAIL: var copy did not acquire")
		return
	}

	// 2. := short-declaration copy.
	c := a
	if rt.Refcount(pa) != 3 {
		testing.Println("FAIL: := copy did not acquire")
		return
	}

	// 3. assignment into an occupied local (copy half of copy-then-destroy).
	var d @T = make(T)
	d = a
	if rt.Refcount(pa) != 4 {
		testing.Println("FAIL: assign copy did not acquire")
		return
	}

	// 4. struct-field store.
	var bx @Box = make(Box)
	bx.t = a
	if rt.Refcount(pa) != 5 {
		testing.Println("FAIL: field store did not acquire")
		return
	}

	// 5. slice-element store.
	var s @[]@T = make_slice(@T, 1)
	s[0] = a
	if rt.Refcount(pa) != 6 {
		testing.Print("FAIL: element store did not acquire, rc=")
		testing.Println(rt.Refcount(pa))
		return
	}

	// All copies remain usable (kept live across the assertions).
	if b.v+c.v+d.v != 15 {
		testing.Println("FAIL: copies not usable")
		return
	}
	testing.Println("ok")
}
