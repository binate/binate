package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.copy: argument passing and `return` are copy sites too (Axiom 3). For the
// ARGUMENT case, the callee owns a reference to its managed parameter for the
// duration of the body, so the referent's count is base+1 INSIDE the call --
// observed inline within the callee, which is exactly the acquire this rule
// names (a helper read is legitimate here because the inflation IS the copy
// under test). For the RETURN case, returning a value that outlives the call (a
// package global) delivers a NEW reference: the global keeps its own and the
// caller gets another, so the global's count rises by one across the round trip.
type T struct {
	v int
}

// observeArg reads its parameter's count inline; while the body runs the callee
// owns a reference, so the caller's rc 1 plus the parameter's gives rc 2.
func observeArg(p @T) bool {
	var pp *uint8 = bit_cast(*uint8, p)
	return rt.Refcount(pp) == 2
}

var g @T

func getG() @T {
	return g
}

func main() {
	var a @T = make(T)
	if !observeArg(a) {
		testing.Println("FAIL: argument copy did not acquire inside callee")
		return
	}
	// Caller's own reference is balanced after the call returns.
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 {
		testing.Print("FAIL: caller rc should be 1 after arg call, got ")
		testing.Println(rt.Refcount(pa))
		return
	}

	g = make(T)
	g.v = 4
	var pg *uint8 = bit_cast(*uint8, g)
	if rt.Refcount(pg) != 1 {
		testing.Println("FAIL: global should start at rc 1")
		return
	}
	// Returning the global delivers a new reference: count rises to 2.
	var x @T = getG()
	if rt.Refcount(pg) != 2 {
		testing.Print("FAIL: returning a global should raise its count, rc=")
		testing.Println(rt.Refcount(pg))
		return
	}
	if x.v != 4 {
		testing.Println("FAIL: returned global value wrong")
		return
	}
	testing.Println("ok")
}
