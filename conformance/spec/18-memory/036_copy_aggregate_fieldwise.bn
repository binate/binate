package "main"

import "pkg/builtins/rt"

// mem.copy: copying an AGGREGATE with managed fields is a field-wise copy that
// acquires EACH managed field. A value struct `Pair` (not a managed pointer)
// holds two managed `@Inner` fields; copying the whole value with `var q Pair =
// p` duplicates both fields into a new location, so each referent's count rises
// by one (here 2 -> 3 for both a and b). (Contrast a managed-pointer copy `@Pair`,
// which acquires the single Pair allocation, not its fields -- that is the
// pointer being copied, not the aggregate.)
type Inner struct {
	v int
}

type Pair struct {
	a @Inner
	b @Inner
}

func main() {
	var ia @Inner = make(Inner)
	ia.v = 1
	var ib @Inner = make(Inner)
	ib.v = 2
	var pa *uint8 = bit_cast(*uint8, ia)
	var pb *uint8 = bit_cast(*uint8, ib)

	var p Pair
	p.a = ia
	p.b = ib
	if rt.Refcount(pa) != 2 || rt.Refcount(pb) != 2 {
		println("FAIL: field stores should each acquire (rc 2)")
		return
	}

	// Copy the whole value struct -> field-wise acquire of each managed field.
	var q Pair = p
	if rt.Refcount(pa) != 3 {
		print("FAIL: aggregate copy did not acquire field a, rc=")
		println(rt.Refcount(pa))
		return
	}
	if rt.Refcount(pb) != 3 {
		print("FAIL: aggregate copy did not acquire field b, rc=")
		println(rt.Refcount(pb))
		return
	}
	if q.a.v+q.b.v != 3 {
		println("FAIL: copied aggregate fields not usable")
		return
	}
	println("ok")
}
