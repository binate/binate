package "main"

import "pkg/builtins/rt"

// mem.assign.copy-then-destroy: a store into an already-occupied managed slot
// follows acquire-before-release -- it acquires the new value, THEN releases the
// prior occupant. The observable net effect on the two distinct referents: the
// new value's count rises by one and the old value's count falls by one. Here
// `slot` holds `old` (old rc 2); `slot = new` makes new go 1 -> 2 and old go
// 2 -> 1. Observed inline via rt.Refcount on each referent.
type T struct {
	v int
}

func main() {
	var old @T = make(T)
	old.v = 1
	var po *uint8 = bit_cast(*uint8, old)
	var new @T = make(T)
	new.v = 2
	var pn *uint8 = bit_cast(*uint8, new)

	var slot @T = old
	if rt.Refcount(po) != 2 {
		println("FAIL: slot should hold a second ref to old (rc 2)")
		return
	}
	if rt.Refcount(pn) != 1 {
		println("FAIL: new should still be rc 1 before the store")
		return
	}

	// Reassign: acquire new (-> 2), then release old (-> 1).
	slot = new
	if rt.Refcount(pn) != 2 {
		print("FAIL: store should acquire the new value, rc=")
		println(rt.Refcount(pn))
		return
	}
	if rt.Refcount(po) != 1 {
		print("FAIL: store should release the prior occupant, rc=")
		println(rt.Refcount(po))
		return
	}
	if slot.v != 2 {
		println("FAIL: slot does not hold the new value")
		return
	}
	println("ok")
}
