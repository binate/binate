package "main"

import "pkg/builtins/rt"

// mem.assign.copy-then-destroy: acquiring BEFORE releasing makes a self-aliasing
// store safe. In `x = x` (and `s[i] = s[i]`) the new value is the old value;
// retaining it first prevents it being freed mid-store, so the counts net to
// zero and the value is preserved. Asserted on both a managed-pointer variable
// (`x = x`) and a managed-slice element (`s[i] = s[i]`): rc is UNCHANGED across
// each self-store and the value survives intact.
type T struct {
	v int
}

func main() {
	// Self-alias on a managed-pointer variable: rc unchanged, value preserved.
	var x @T = make(T)
	x.v = 99
	var px *uint8 = bit_cast(*uint8, x)
	if rt.Refcount(px) != 1 {
		println("FAIL: x should start at rc 1")
		return
	}
	x = x
	if rt.Refcount(px) != 1 {
		print("FAIL: self-alias x = x changed rc, got ")
		println(rt.Refcount(px))
		return
	}
	if x.v != 99 {
		println("FAIL: self-alias x = x lost the value")
		return
	}

	// Self-alias on a managed-slice element: rc unchanged, value preserved.
	var s @[]@T = make_slice(@T, 2)
	var e @T = make(T)
	e.v = 7
	var pe *uint8 = bit_cast(*uint8, e)
	s[0] = e
	if rt.Refcount(pe) != 2 {
		println("FAIL: element store should give rc 2")
		return
	}
	s[0] = s[0]
	if rt.Refcount(pe) != 2 {
		print("FAIL: self-alias s[i] = s[i] changed rc, got ")
		println(rt.Refcount(pe))
		return
	}
	if s[0].v != 7 {
		println("FAIL: self-alias s[i] = s[i] lost the value")
		return
	}
	println("ok")
}
