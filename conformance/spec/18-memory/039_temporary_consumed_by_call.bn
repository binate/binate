package "main"

import "pkg/builtins/rt"

// mem.temporary: a managed value copied into a call's parameter is acquired for
// the call and RELEASED at the end of the statement. Observed two ways: sink
// reads its parameter's count MID-CALL (the caller's referent + the param copy
// == 2, the acquire half), and the caller reads the referent's count AFTER the
// statement (back to 1, the release half) -- the temporary parameter copy is an
// unnamed local of the statement's implicit scope.
type T struct {
	v int
}

// sink consumes a managed parameter and returns its OWN mid-call refcount.
func sink(p @T) int {
	return rt.Refcount(bit_cast(*uint8, p))
}

func main() {
	var a @T = make(T)
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 {
		println("FAIL: base should be rc 1")
		return
	}
	var mid int = sink(a)         // copies a into the param (acquire) -> rc 2 inside
	if mid != 2 {
		print("FAIL: mid-call param acquire should give rc 2, got ")
		println(mid)
		return
	}
	if rt.Refcount(pa) != 1 {     // param copy released at end of the statement
		print("FAIL: temporary not released at end of statement, rc=")
		println(rt.Refcount(pa))
		return
	}
	println("ok")
}
