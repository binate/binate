package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.temporary: a freshly-allocated managed value produced mid-statement and
// not bound to a name is released at the END of the statement -- and its
// destructor cascades to its managed contents. `makeBox(inner)` returns a fresh
// @Box temporary that holds a COPY of inner (inner's count rises during the
// statement); `use(...)` consumes that temporary. At statement end the unnamed
// Box temporary is released, its destructor releases its inner field, and the
// shared inner returns to its original count. Asserted: inner's count is the
// same before and after the statement (rc 1) -- the temporary leaked nothing.
type Inner struct {
	v int
}

type Box struct {
	inner @Inner
}

// makeBox copies inner into a fresh Box and returns it (a statement temporary
// at the call site below).
func makeBox(inner @Inner) @Box {
	var b @Box = make(Box)
	b.inner = inner
	return b
}

// use reads the boxed value, consuming the temporary Box.
func use(b @Box) int {
	return b.inner.v
}

func main() {
	var inner @Inner = make(Inner)
	inner.v = 42
	var pi *uint8 = bit_cast(*uint8, inner)
	if rt.Refcount(pi) != 1 {
		testing.Println("FAIL: base should be rc 1")
		return
	}

	// The fresh @Box from makeBox(inner) is an unnamed statement temporary.
	var r int = use(makeBox(inner))
	if r != 42 {
		testing.Println("FAIL: nested-call result wrong")
		return
	}
	if rt.Refcount(pi) != 1 {
		testing.Print("FAIL: temporary Box not released (its inner field leaked), rc=")
		testing.Println(rt.Refcount(pi))
		return
	}
	testing.Println("ok")
}
