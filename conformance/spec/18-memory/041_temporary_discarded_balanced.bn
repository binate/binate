package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// mem.temporary: a DISCARDED managed call result is released at end of
// statement, not leaked. A fresh allocation produced and immediately dropped
// each loop iteration must balance: the loop never grows live references, and a
// shared referent threaded through the discarded temporary returns to its
// original count after the statement. Asserted two ways: (1) a discarded fresh
// make in a tight loop never faults; (2) a shared inner copied into a discarded
// temporary struct each iteration stays at its base count.
type Inner struct {
	v int
}

type Box struct {
	inner @Inner
}

// boxOf copies inner into a fresh Box; the call result is discarded below.
func boxOf(inner @Inner) @Box {
	var b @Box = make(Box)
	b.inner = inner
	return b
}

func main() {
	var inner @Inner = make(Inner)
	inner.v = 5
	var pi *uint8 = bit_cast(*uint8, inner)
	if rt.Refcount(pi) != 1 {
		testing.Println("FAIL: base should be rc 1")
		return
	}

	var i int = 0
	for ; i < 500; i = i + 1 {
		// A discarded fresh allocation: released at end of statement, not leaked.
		_ = make(Box)
		// A discarded temporary that copied the shared inner: at statement end the
		// temporary is released and its inner field released, so inner stays at 1.
		_ = boxOf(inner)
		if rt.Refcount(pi) != 1 {
			testing.Print("FAIL: discarded temporary leaked a ref to inner, rc=")
			testing.Println(rt.Refcount(pi))
			return
		}
	}

	// After 500 balanced iterations the shared inner is still at its base count.
	if rt.Refcount(pi) != 1 {
		testing.Print("FAIL: inner count drifted across the loop, rc=")
		testing.Println(rt.Refcount(pi))
		return
	}
	testing.Println("ok")
}
