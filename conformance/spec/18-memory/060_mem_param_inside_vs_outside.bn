package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct { v int }

// callee owns a reference to its managed param during the body:
// inside, rc reads one MORE than the caller's standalone reference.
func observeInside(p @T) int {
	var pp *uint8 = bit_cast(*uint8, p)
	return rt.Refcount(pp)
}

func main() {
	var a @T = make(T)
	a.v = 1
	var pa *uint8 = bit_cast(*uint8, a)
	var outside int = rt.Refcount(pa)        // caller's own single ref: 1
	if outside != 1 {
		testing.Print("FAIL outside="); testing.Println(outside)
		return
	}
	var inside int = observeInside(a)        // callee owns +1: 2
	if inside != outside + 1 {
		testing.Print("FAIL inside="); testing.Println(inside)
		return
	}
	// caller's own reference is unaffected by the call (it passed a borrow).
	var after int = rt.Refcount(pa)
	if after != outside {
		testing.Print("FAIL after="); testing.Println(after)
		return
	}
	testing.Println("ok")
}
