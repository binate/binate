package "main"

import "pkg/builtins/rt"

type T struct { v int }

// raw param: @T -> *T is a BORROW; no count taken.
// rc read INSIDE through the raw param equals the caller's own ref (no +1).
func observeRaw(p *T) int {
	var pp *uint8 = bit_cast(*uint8, p)
	return rt.Refcount(pp)
}

func main() {
	var a @T = make(T)
	a.v = 7
	var pa *uint8 = bit_cast(*uint8, a)
	var outside int = rt.Refcount(pa)        // 1
	if outside != 1 {
		print("FAIL outside="); println(outside)
		return
	}
	var inside int = observeRaw(a)           // borrow: no acquire -> still 1
	if inside != outside {
		print("FAIL inside="); println(inside)
		return
	}
	var after int = rt.Refcount(pa)          // unchanged across the call: 1
	if after != outside {
		print("FAIL after="); println(after)
		return
	}
	println("ok")
}
