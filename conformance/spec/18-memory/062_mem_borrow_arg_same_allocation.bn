package "main"

import "pkg/builtins/rt"

type T struct { v int }

// The borrowed value must stay alive for the duration of the call (the
// caller's own reference guarantees it). The raw param aliases the SAME
// allocation -- a write through it is visible to the managed owner -- and
// no count is taken for the borrow.
func bumpThroughBorrow(p *T) {
	p.v = p.v + 1
}

func main() {
	var a @T = make(T)
	a.v = 41
	var pa *uint8 = bit_cast(*uint8, a)
	var before int = rt.Refcount(pa)         // 1
	bumpThroughBorrow(a)                      // @T -> *T borrow
	var after int = rt.Refcount(pa)          // still 1: no acquire
	if after != before {
		print("FAIL rc after="); println(after)
		return
	}
	if a.v != 42 {                            // write through borrow is visible
		print("FAIL v="); println(a.v)
		return
	}
	println("ok")
}
