package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct { v int }

var g @T

func getGlobal() @T {
	return g
}

func main() {
	g = make(T)
	g.v = 5
	var pg *uint8 = bit_cast(*uint8, g)
	var before int = rt.Refcount(pg)         // global holds its own ref: 1
	if before != 1 {
		testing.Print("FAIL before="); testing.Println(before)
		return
	}
	// Returning a GLOBAL delivers a NEW reference: count rises by 1.
	var x @T = getGlobal()
	var after int = rt.Refcount(pg)          // 2 (global + caller's new ref)
	if after != before + 1 {
		testing.Print("FAIL after="); testing.Println(after)
		return
	}
	testing.Println(x.v)
	testing.Println("ok")
}
