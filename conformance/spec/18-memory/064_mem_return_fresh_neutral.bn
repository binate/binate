package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct { v int }

// Returning a FRESHLY-allocated value delivers its sole reference;
// the round trip is count-neutral (caller's new ref replaces the
// expiring temporary's). For @T the conforming slow path balances to rc 1.
func makeFresh() @T {
	var local @T = make(T)
	local.v = 99
	return local
}

func main() {
	var x @T = makeFresh()
	var px *uint8 = bit_cast(*uint8, x)
	var rc int = rt.Refcount(px)             // sole owner: 1
	if rc != 1 {
		testing.Print("FAIL rc="); testing.Println(rc)
		return
	}
	testing.Println(x.v)
	testing.Println("ok")
}
