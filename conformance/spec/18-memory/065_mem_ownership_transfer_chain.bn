package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct { v int }

// Hand ownership along a chain: receive an owning managed-param copy, RETURN it
// (delivering one reference to the caller). Each transfer (arg, return) moves
// exactly one reference; the invariant holds on both sides.
func passThrough(p @T) @T {
	return p
}

func main() {
	// Owner A holds one reference to the allocation.
	var a @T = make(T)
	a.v = 3
	var pa *uint8 = bit_cast(*uint8, a)
	var start int = rt.Refcount(pa)          // 1
	if start != 1 {
		testing.Print("FAIL start="); testing.Println(start)
		return
	}

	// ASSIGNMENT transfer: a second owner acquires one reference.
	var b @T = a
	var afterAssign int = rt.Refcount(pa)    // 2
	if afterAssign != 2 {
		testing.Print("FAIL afterAssign="); testing.Println(afterAssign)
		return
	}

	// RETURN+ARG transfer: pass b as a borrow-arg, receive a returned ref
	// into a third owner c. Net: exactly one new owning reference.
	var c @T = passThrough(b)
	var afterReturn int = rt.Refcount(pa)    // 3 (a, b, c)
	if afterReturn != 3 {
		testing.Print("FAIL afterReturn="); testing.Println(afterReturn)
		return
	}

	testing.Println(a.v)
	testing.Println(b.v)
	testing.Println(c.v)
	testing.Println("ok")
}
