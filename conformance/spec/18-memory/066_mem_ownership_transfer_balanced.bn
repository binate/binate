package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct { v int }

func passThrough(p @T) @T {
	return p
}

func main() {
	var a @T = make(T)
	a.v = 8
	var pa *uint8 = bit_cast(*uint8, a)
	// invariant intact across a balanced transfer: a new owner takes one
	// reference, then releases it at scope exit -> count returns.
	{
		var c @T = passThrough(a)
		var during int = rt.Refcount(pa)     // 2 (a + c)
		if during != 2 {
			testing.Print("FAIL during="); testing.Println(during)
			return
		}
		testing.Println(c.v)
	}
	// c's scope exited: its one transferred reference is released.
	var after int = rt.Refcount(pa)          // back to 1
	if after != 1 {
		testing.Print("FAIL after="); testing.Println(after)
		return
	}
	testing.Println("ok")
}
