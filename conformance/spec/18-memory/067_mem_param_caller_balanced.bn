package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct { v int }

func consume(p @T) int {
	return p.v
}

func main() {
	var a @T = make(T)
	a.v = 6
	var pa *uint8 = bit_cast(*uint8, a)
	// The caller passes a borrow; its own reference is unaffected by the
	// call, and the callee's acquire/release is balanced each call.
	var n int = 0
	var i int = 0
	for i < 100 {
		n = n + consume(a)
		var live int = rt.Refcount(pa)       // always 1 between calls
		if live != 1 {
			testing.Print("FAIL live="); testing.Println(live)
			return
		}
		i = i + 1
	}
	if n != 600 {
		testing.Print("FAIL n="); testing.Println(n)
		return
	}
	testing.Println("ok")
}
