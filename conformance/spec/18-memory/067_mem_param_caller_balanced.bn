package "main"

import "pkg/builtins/rt"

type T struct { v int }

func consume(p @T) int {
	return p.v
}

func main() {
	var a @T = make(T)
	a.v = 6
	var pa *uint8 = bit_cast(*uint8, a)
	// The caller passes a borrow; its own reference is unaffected by the
	// call, and the callee's acquire/release is balanced each call.
	var n int = 0
	var i int = 0
	for i < 100 {
		n = n + consume(a)
		var live int = rt.Refcount(pa)       // always 1 between calls
		if live != 1 {
			print("FAIL live="); println(live)
			return
		}
		i = i + 1
	}
	if n != 600 {
		print("FAIL n="); println(n)
		return
	}
	println("ok")
}
