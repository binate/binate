package "main"

type T struct { v int }

// A managed parameter requires an owning @T argument. A RAW *T does not
// own a reference and must NOT be accepted where @T is expected
// (that would fabricate ownership the caller cannot supply).
func takesManaged(p @T) int {
	return p.v
}

func main() {
	var a @T = make(T)
	a.v = 4
	var r *T = a               // raw borrow (no count)
	println(takesManaged(r))   // ERROR: *T passed where @T expected
}
