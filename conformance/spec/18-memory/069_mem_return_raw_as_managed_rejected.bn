package "main"

type T struct { v int }

// A function returning @T must deliver an OWNING reference. A raw *T holds
// no count, so returning it where @T is required must be rejected
// (it cannot supply the owning reference mem.return promises the caller).
func badReturn(p *T) @T {
	return p
}

func main() {
	var a @T = make(T)
	println(badReturn(a).v)
}
