package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct {
	V int
}

func main() {
	// mem.managed-vs-raw: a managed copy holds a reference (rc++); a raw copy is
	// a borrow that holds NO count (rc unchanged).
	var a @T = make(T)
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 {
		testing.Print("FAIL fresh: expected 1, got ")
		testing.Println(rt.Refcount(pa))
		return
	}

	// Managed copy -> acquire -> rc 1 -> 2.
	var b @T = a
	if rt.Refcount(pa) != 2 {
		testing.Print("FAIL managed copy: expected 2, got ")
		testing.Println(rt.Refcount(pa))
		return
	}

	// Raw copy -> borrow, holds no count -> rc stays 2.
	var r *T = a
	if rt.Refcount(pa) != 2 {
		testing.Print("FAIL raw copy: expected 2, got ")
		testing.Println(rt.Refcount(pa))
		return
	}

	// Keep b and r live across the observation.
	b.V = 7
	r.V = 9
	testing.Println("ok")
}
