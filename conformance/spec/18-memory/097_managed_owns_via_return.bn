package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct {
	V int
}

// makeManaged returns a freshly-allocated MANAGED pointer. The caller's managed
// value OWNS its referent, so the allocation stays alive after the func returns.
func makeManaged() @T {
	var x @T = make(T)
	x.V = 55
	return x
}

func main() {
	// mem.managed-vs-raw: a managed value owns one reference for as long as it is
	// live. A returned managed @T keeps its referent alive (rc 1).
	var owned @T = makeManaged()
	var po *uint8 = bit_cast(*uint8, owned)
	if rt.Refcount(po) != 1 {
		testing.Print("FAIL owned: expected 1, got ")
		testing.Println(rt.Refcount(po))
		return
	}
	if owned.V != 55 {
		testing.Println("FAIL owned value")
		return
	}

	// A raw view of the same allocation is a borrow holding NO count.
	var raw *T = owned
	if rt.Refcount(po) != 1 {
		testing.Print("FAIL raw view changed count: expected 1, got ")
		testing.Println(rt.Refcount(po))
		return
	}
	if raw.V != 55 {
		testing.Println("FAIL raw value")
		return
	}
	testing.Println("ok")
}
