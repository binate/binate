package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type T struct {
	V int
}

// ownSlice returns a freshly-allocated MANAGED slice. A managed @[]T owns its
// backing, so the caller's copy keeps the backing (and its elements) alive.
func ownSlice() @[]@T {
	var s @[]@T = make_slice(@T, 1)
	var e @T = make(T)
	e.V = 77
	s[0] = e
	return s
}

func main() {
	// mem.managed-vs-raw: a managed-slice (@[]T) OWNS its backing — contrast the
	// "almost always wrong" raw slice that merely borrows. After the func
	// returns, the element is still alive (slice holds one ref, the local @T
	// holds another -> rc >= 2).
	var s @[]@T = ownSlice()
	var e @T = s[0]
	var pe *uint8 = bit_cast(*uint8, e)
	var rc int = rt.Refcount(pe)
	if rc < 2 {
		testing.Print("FAIL: managed slice did not keep element alive, rc=")
		testing.Println(rc)
		return
	}
	if s[0].V != 77 {
		testing.Println("FAIL value through managed slice")
		return
	}
	testing.Println("ok")
}
