package "main"

import "pkg/builtins/rt"

type Node struct {
	Next @Node
	V    int
}

func main() {
	// mem.cycles: a reference cycle keeps its OWN counts positive and LEAKS.
	// This is user error (Binate is not garbage-collected) and the only
	// acceptable "leak" a program may exhibit.
	var a @Node = make(Node)
	a.V = 1
	var b @Node = make(Node)
	b.V = 2

	var pa *uint8 = bit_cast(*uint8, a)
	var pb *uint8 = bit_cast(*uint8, b)
	if rt.Refcount(pa) != 1 {
		println("FAIL: fresh a not rc 1")
		return
	}

	// Form the cycle: a.Next = b; b.Next = a.
	a.Next = b
	b.Next = a

	// Each node is now referenced twice: once by the local (a / b) and once by
	// the other node's Next field. The cycle self-sustains the counts at 2.
	if rt.Refcount(pa) != 2 {
		print("FAIL a count: expected 2, got ")
		println(rt.Refcount(pa))
		return
	}
	if rt.Refcount(pb) != 2 {
		print("FAIL b count: expected 2, got ")
		println(rt.Refcount(pb))
		return
	}

	// Traverse the cycle: a -> Next(b) -> Next(a) -> V.
	if a.Next.Next.V != 1 {
		println("FAIL cycle traversal")
		return
	}

	// When the locals leave scope, the field references keep each count at 1
	// forever — the two allocations leak. There is no crash and no double-free.
	println("ok")
}
