package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type Inner struct {
	V int
}

type Owner struct {
	In @Inner
}

func main() {
	// mem.raw-uaf: an implementation MUST NOT suppress a release just because a
	// raw borrow of the released value still exists (that would trade a
	// detectable fault for a silent leak). We OBSERVE the release happening — a
	// shared inner's count drops when its owner is released — and we NEVER
	// dereference the dangling raw afterward.
	var inner @Inner = make(Inner)
	inner.V = 42
	var pin *uint8 = bit_cast(*uint8, inner)
	if rt.Refcount(pin) != 1 {
		testing.Println("FAIL: fresh inner not rc 1")
		return
	}

	{
		var owner @Owner = make(Owner)
		owner.In = inner
		// inner is now referenced by the local `inner` and by owner.In -> rc 2.
		if rt.Refcount(pin) != 2 {
			testing.Print("FAIL: owner did not acquire inner, rc=")
			testing.Println(rt.Refcount(pin))
			return
		}

		// A raw borrow of owner holds no count and will dangle once owner is
		// released at scope exit. It is used ONLY here, before owner dies; it is
		// never dereferenced afterward (that would be UB).
		var rawOwner *Owner = owner
		rawOwner.In.V = 99
	}

	// owner has left scope and been released. The release was NOT suppressed by
	// the prior existence of the raw borrow: owner.In was released, so inner
	// drops back to rc 1.
	if rt.Refcount(pin) != 1 {
		testing.Print("FAIL: release suppressed, inner rc=")
		testing.Println(rt.Refcount(pin))
		return
	}
	// inner is still owned by us and remains valid and usable.
	if inner.V != 99 {
		testing.Print("FAIL inner value: ")
		testing.Println(inner.V)
		return
	}
	testing.Println("ok")
}
