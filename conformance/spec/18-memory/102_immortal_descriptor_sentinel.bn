package "main"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

func main() {
	// mem.immortal: a static-managed allocation (emitted into the program image,
	// not heap-allocated) carries the immortal STATIC_REFCOUNT sentinel; acquire
	// and release both short-circuit (no increment, no decrement, no free). This
	// package's own reflect.Package descriptor is exactly such a value. We
	// observe its header count directly.
	var p @reflect.Package = reflect._Package()
	var pp *uint8 = bit_cast(*uint8, p)
	var rc int = rt.Refcount(pp)
	if rc != rt.STATIC_REFCOUNT {
		print("FAIL: descriptor not immortal, rc=")
		println(rc)
		return
	}
	println("ok")
}
