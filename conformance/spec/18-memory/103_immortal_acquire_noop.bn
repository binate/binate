package "main"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

func main() {
	// mem.immortal: acquire on an immortal count is a no-op (no increment). We
	// observe the sentinel, copy the value (an acquire), and confirm the count
	// is STILL the sentinel — the acquire did not increment it.
	var p @reflect.Package = reflect.__Package()
	var pp *uint8 = bit_cast(*uint8, p)
	if rt.Refcount(pp) != rt.STATIC_REFCOUNT {
		print("FAIL initial: ")
		println(rt.Refcount(pp))
		return
	}

	// Copy it: acquire. On an immortal count this is a no-op.
	var q @reflect.Package = p
	if rt.Refcount(pp) != rt.STATIC_REFCOUNT {
		print("FAIL after acquire (incremented): ")
		println(rt.Refcount(pp))
		return
	}
	// q aliases the same immortal allocation; its count reads the sentinel too.
	if rt.Refcount(bit_cast(*uint8, q)) != rt.STATIC_REFCOUNT {
		println("FAIL q not immortal")
		return
	}
	// q drops at scope exit: release on an immortal count is likewise a no-op.
	println("ok")
}
