package "main"
import "pkg/builtins/testing"

func use(s @[]readonly char) int {
	return len(s)
}

func main() {
	// mem.immortal: string-literal backing carries the immortal STATIC sentinel,
	// so release is a no-op (no free). Reassigning and dropping immortal literals
	// many times must never double-free or crash. Reassignment is copy-then-
	// destroy: acquire the new immortal (no-op), then release the old immortal
	// (no-op).
	var s @[]readonly char = "alpha"
	var total int = 0
	var i int = 0
	for ; i < 5000; i = i + 1 {
		if i / 2 * 2 == i {
			s = "beta-literal"
		} else {
			s = "gamma"
		}
		total = total + use(s)
	}

	// 2500 even iterations use "beta-literal" (len 12); 2500 odd use "gamma"
	// (len 5). A correct no-op-release run reaches here with no crash.
	if total != 2500 * 12 + 2500 * 5 {
		testing.Print("FAIL total: ")
		testing.Println(total)
		return
	}
	testing.Println("ok")
}
