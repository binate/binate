package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// Rule mem.no-leak (§18.7): every managed allocation is eventually released,
// and reference-count operations are never elided across a function boundary.
// Observed via rt.Refcount on a managed-pointer header (read inline, never
// through a helper that would acquire the param and inflate the count).

type Inner struct {
	Val int
}

// inspect reads its parameter's count INLINE inside the callee. Because the
// boundary acquire of a @Inner parameter is emitted (mem.param) and not elided,
// the count observed inside is caller-ref + callee-acquired-ref.
func inspect(p @Inner) int {
	var pp *uint8 = bit_cast(*uint8, p)
	return rt.Refcount(pp)
}

func main() {
	var shared @Inner = make(Inner)
	shared.Val = 7
	var ps *uint8 = bit_cast(*uint8, shared)
	if rt.Refcount(ps) != 1 {
		testing.Println("FAIL base")
		return
	}

	// (1) Loop balance: a managed local created and dropped each iteration is
	// balanced — the shared referent neither grows nor double-frees, and its
	// count returns to its expected value (1) after the loop.
	var i int = 0
	for i < 1000 {
		var local @Inner = shared
		_ = local.Val
		i = i + 1
	}
	if rt.Refcount(ps) != 1 {
		testing.Print("FAIL after loop=")
		testing.Println(rt.Refcount(ps))
		return
	}

	// (2) The boundary acquire is emitted (not elided across the function
	// boundary): inside the callee the count is caller-ref (1) + param-ref (1).
	var inside int = inspect(shared)
	if inside != 2 {
		testing.Print("FAIL inside=")
		testing.Println(inside)
		return
	}
	// After the call the callee released its parameter: back to the base count.
	if rt.Refcount(ps) != 1 {
		testing.Print("FAIL after call=")
		testing.Println(rt.Refcount(ps))
		return
	}

	testing.Println("ok")
}
