package "main"

import "pkg/builtins/rt"

// Rule mem.determinism (§18.7): reference counting is transparent and
// deterministic — cleanup happens at well-defined points (statement end, scope
// exit, last reference), with no deferral to a later collection point. Each
// boundary is shown by reading the count immediately after it.

type Inner struct {
	Val int
}

// sink consumes a temporary copy of its argument within the calling statement.
func sink(p @Inner) int {
	return p.Val
}

func main() {
	var a @Inner = make(Inner)
	a.Val = 5
	var pa *uint8 = bit_cast(*uint8, a)

	// (1) Statement end: sink(a) acquires a temporary copy of a, released at
	// the end of the statement. Immediately after, a is back to its base count.
	_ = sink(a)
	if rt.Refcount(pa) != 1 {
		print("FAIL afterStmt=")
		println(rt.Refcount(pa))
		return
	}

	// (2) Scope exit: an inner block holds a copy (count 2 inside), released at
	// block exit — count is back to 1 immediately after the block.
	{
		var b @Inner = a
		if rt.Refcount(pa) != 2 {
			print("FAIL inBlock=")
			println(rt.Refcount(pa))
			return
		}
		_ = b.Val
	}
	if rt.Refcount(pa) != 1 {
		print("FAIL afterBlock=")
		println(rt.Refcount(pa))
		return
	}

	// (3) Last reference: a second owner brings the count to 2; dropping it via
	// reassignment to a fresh allocation releases the extra reference at the
	// assignment (back to 1), deterministically — not deferred.
	var c @Inner = a
	if rt.Refcount(pa) != 2 {
		print("FAIL twoRefs=")
		println(rt.Refcount(pa))
		return
	}
	c = make(Inner)
	if rt.Refcount(pa) != 1 {
		print("FAIL afterReassign=")
		println(rt.Refcount(pa))
		return
	}

	println("ok")
}
