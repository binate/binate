package "main"

import "pkg/builtins/rt"

// Rule mem.move (§18.6): a move transfers an existing reference from an expiring
// source without an acquire/release pair. It is an OPTIMIZATION — its observable
// behavior (when an allocation is freed) is identical to the slow path; only
// intermediate counts may differ, so a test must assert the observable outcome,
// not a move-sensitive intermediate count. We assert a fresh return is correct
// and leaks nothing. (@func fresh returns are the kind currently moved.)

type Inner struct {
	Val int
}

// makeInner returns a freshly-allocated managed value: its sole reference is
// delivered to the caller. mem.move may realize this as a transfer with no
// acquire; the observable round-trip outcome is a single (sole) reference.
func makeInner(v int) @Inner {
	var x @Inner = make(Inner)
	x.Val = v
	return x
}

func adder(n int) int {
	return n + 1
}

// makeFn returns a fresh @func value — the @func fresh-return is currently
// realized as a move. The observable behavior must match the slow path.
func makeFn() @func(int) int {
	var f @func(int) int = adder
	return f
}

func main() {
	// Fresh @Inner return: value is correct, and the round trip leaves exactly
	// one (sole) reference — no leak, no double-free. This count is identical
	// whether realized as a move or the balanced slow path (not move-sensitive).
	var r @Inner = makeInner(42)
	if r.Val != 42 {
		print("FAIL val=")
		println(r.Val)
		return
	}
	var pr *uint8 = bit_cast(*uint8, r)
	if rt.Refcount(pr) != 1 {
		print("FAIL rc=")
		println(rt.Refcount(pr))
		return
	}
	// Dropping the sole reference (reassign) destroys the prior referent
	// cleanly — observable proof the fresh return did not leak or over-retain.
	r = make(Inner)
	r.Val = 1
	if r.Val != 1 {
		println("FAIL reassign")
		return
	}

	// Fresh @func return (the moved kind): the observable outcome is a correct,
	// callable function value, with a clean drop on reassignment.
	var g @func(int) int = makeFn()
	if g(10) != 11 {
		print("FAIL g=")
		println(g(10))
		return
	}
	g = adder
	if g(20) != 21 {
		println("FAIL g2")
		return
	}

	println("ok")
}
