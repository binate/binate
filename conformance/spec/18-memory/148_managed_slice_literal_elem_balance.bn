package "main"

import "pkg/builtins/rt"

// mem.temporary: a fresh managed-slice composite literal `@[]@T{...}` is a
// statement temporary — its heap backing (and each acquired managed element) is
// released at end of statement, exactly like a make_slice result or a struct/array
// literal.  Before the literal was registered as a cleanup temp, the return path
// RefInc'd its backing (and each element was acquired) with nothing to balance
// it: the caller's dtor then saw the backing at refcount > 1 and skipped the
// element walk, leaking every element (the "@[]@I literal element leak").  Assert
// a shared referent returns to baseline across the three consumers that take the
// literal's ownership: discard, return-of-fresh, and borrow-as-argument.

type Node struct {
	v int
}

// countN borrows the raw *[]@Node — no entry-acquire / exit-release.
func countN(xs *[]@Node) int {
	return len(xs)
}

// mkPair returns a FRESH managed-slice literal holding two acquired copies of n.
func mkPair(n @Node) @[]@Node {
	return @[]@Node{n, n}
}

func main() {
	var a @Node = make(Node)
	a.v = 7
	var p *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(p) != 1 {
		print("FAIL base rc=")
		println(rt.Refcount(p))
		return
	}

	// (1) A discarded literal temp: the two acquired element refs are released
	// at statement end.
	_ = @[]@Node{a, a}
	if rt.Refcount(p) != 1 {
		print("FAIL discarded literal leaked, rc=")
		println(rt.Refcount(p))
		return
	}

	// (2) A returned literal (mkPair), discarded by the caller: the fresh return
	// is balanced (backing at refcount 1 → caller's dtor runs the element walk).
	mkPair(a)
	if rt.Refcount(p) != 1 {
		print("FAIL returned literal leaked, rc=")
		println(rt.Refcount(p))
		return
	}

	// (3) A literal borrowed as an argument, then released at statement end.
	if countN(mkPair(a)) != 2 {
		println("FAIL len")
		return
	}
	if rt.Refcount(p) != 1 {
		print("FAIL borrowed literal leaked, rc=")
		println(rt.Refcount(p))
		return
	}

	// (4) The MOVE path: a var init MOVES the literal into s (consumeTemp), so the
	// literal is NOT also cleaned at statement end.  If registration wrongly left
	// it registered too, the end-of-statement temp dtor would free the backing s
	// still points at and RefDec a's two refs early — a would read 1 here, not 3.
	var s @[]@Node = @[]@Node{a, a}
	if rt.Refcount(p) != 3 {
		print("FAIL moved literal double-cleaned, rc=")
		println(rt.Refcount(p))
		return
	}
	// Dropping s (reassign) releases its two element refs cleanly — proof the move
	// transferred exactly one owner, no leak and no double-free.
	s = make_slice(@Node, 0)
	if rt.Refcount(p) != 1 {
		print("FAIL moved literal leaked/over-released on drop, rc=")
		println(rt.Refcount(p))
		return
	}

	println("ok")
}
