package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// mem.temporary, mem.borrow-arg: a call that returns a managed value produces a
// temporary that owns one reference, released at the end of its statement.  A
// method with a raw `*T` receiver called directly on that temporary borrows it;
// the borrow takes no reference, so the temporary's reference is still released
// and the count is unchanged — as when the result is bound to a variable first,
// or the method has a managed `@T` receiver; likewise for the temporary a managed
// recovery `x.(@T)` produces.

type Thing struct {
	n int
}

func (t *Thing) Get() int { return t.n }

func (t @Thing) MGet() int { return t.n }

func id(t @Thing) @Thing { return t }

func main() {
	var t @Thing = make(Thing)
	t.n = 6
	var pt *uint8 = bit_cast(*uint8, t)
	var before int = rt.Refcount(pt)
	for i := 0; i < 10; i++ {
		_ = id(t).Get()
	}
	var direct int = rt.Refcount(pt) - before
	for i := 0; i < 10; i++ {
		var u @Thing = id(t)
		_ = u.Get()
	}
	var bound int = rt.Refcount(pt) - before - direct
	for i := 0; i < 10; i++ {
		_ = id(t).MGet()
	}
	var managed int = rt.Refcount(pt) - before - direct - bound
	// A managed recovery `x.(@T)` is a temporary too.
	var a @any = t
	var boxed int = rt.Refcount(pt)
	for i := 0; i < 10; i++ {
		_ = a.(@Thing).Get()
	}
	testing.Println(direct, bound, managed, rt.Refcount(pt) - boxed)
}
