package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A function whose result is a raw `*T` returns a borrow (conv.managed-to-raw):
// returning a managed `@T` there — a parameter, a field, a local, a global, a
// component of a multi-value return or of a returned call's results, from a
// generic function or a method called through an interface — takes no
// reference, so nothing is left to release (mem.return delivers an owning
// reference only for a managed result); likewise an `@func` returned as
// `*func`.  Each call must leave no live block.

type T struct {
	n int
}

type H struct {
	p @T
}

var gt @T

var gf @func() int

func fromParam(t @T) *T { return t }

func fromField(h @H) *T { return h.p }

func fromLocal() *T {
	var l @T = gt
	return l
}

func fromGlobal() *T { return gt }

func pair(t @T) (*T, int) { return t, 1 }

func two(t @T) (@T, int) { return t, 1 }

func viaCall(t @T) (*T, int) { return two(t) }

func borrow[U any](x @U) *U { return x }

interface Getter {
	Raw() *T
}

impl *H : Getter

func (h *H) Raw() *T { return h.p }

func fnFromGlobal() *func() int { return gf }

func mkF(n int) @func() int {
	var big [4]int
	big[0] = n
	return func() int { return big[0] }
}

func run(k int) int {
	gt = make(T)
	gt.n = k
	var h @H = make(H)
	h.p = gt
	var r *T
	if k == 1 { r = fromParam(gt) }
	if k == 2 { r = fromField(h) }
	if k == 3 { r = fromLocal() }
	if k == 4 { r = fromGlobal() }
	if k == 5 { r, _ = pair(gt) }
	if k == 7 { r, _ = viaCall(gt) }
	if k == 8 { r = borrow[T](gt) }
	if k == 9 {
		var g @Getter = h
		r = g.Raw()
	}
	var n int
	if k == 6 {
		gf = mkF(k)
		var f *func() int = fnFromGlobal()
		n = f()
		gf = nil
	} else {
		n = r.n
	}
	h = nil
	gt = nil
	return n
}

func main() {
	// One warm-up pass first: the bytecode VM allocates state on a call site's
	// first use and keeps it, which is not a leak.
	for k := 1; k < 10; k++ {
		_ = run(k)
	}
	var got [10]int
	var leaked [10]int
	for k := 1; k < 10; k++ {
		var live int = rt.LiveBlocks()
		got[k] = run(k)
		leaked[k] = rt.LiveBlocks() - live
	}
	for k := 1; k < 10; k++ {
		testing.Println(got[k], leaked[k])
	}
}
