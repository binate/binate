package "main"

import "pkg/builtins/rt"
import "pkg/builtins/testing"

// A function whose result is a raw `*T` returns a borrow (conv.managed-to-raw):
// returning a managed `@T` there — a parameter, a field, a local — takes no
// reference, so nothing is left to release (mem.return delivers an owning
// reference only for a managed result).  Each call must leave no live block.

type T struct {
	n int
}

type H struct {
	p @T
}

var gt @T

func fromParam(t @T) *T { return t }

func fromField(h @H) *T { return h.p }

func fromLocal() *T {
	var l @T = gt
	return l
}

func fromGlobal() *T { return gt }

func run(k int) int {
	gt = make(T)
	gt.n = k
	var h @H = make(H)
	h.p = gt
	var r *T
	if k == 1 { r = fromParam(gt) }
	if k == 2 { r = fromField(h) }
	if k == 3 { r = fromLocal() }
	if k == 4 { r = fromGlobal() }
	var n int = r.n
	h = nil
	gt = nil
	return n
}

func main() {
	// One warm-up pass first: the bytecode VM allocates state on a call site's
	// first use and keeps it, which is not a leak.
	for k := 1; k < 5; k++ {
		_ = run(k)
	}
	var got [5]int
	var leaked [5]int
	for k := 1; k < 5; k++ {
		var live int = rt.LiveBlocks()
		got[k] = run(k)
		leaked[k] = rt.LiveBlocks() - live
	}
	for k := 1; k < 5; k++ {
		testing.Println(got[k], leaked[k])
	}
}
