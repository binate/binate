package "main"

import "pkg/builtins/rt"

// exec.machine: a program's behavior is defined over an abstract machine with a
// SINGLE SHARED HEAP of managed allocations carrying reference-count metadata,
// plus a call primitive both modes implement identically. The heap and its
// refcount metadata are directly observable: a freshly-made @T has rc 1, a copy
// raises it, and dropping the copy lowers it -- the SAME heap discipline in
// every mode (the two modes are two realizations of one machine, not two
// languages), so this program's output is identical compiled or interpreted.
type T struct {
	v int
}

func main() {
	var a @T = make(T)
	a.v = 7
	var pa *uint8 = bit_cast(*uint8, a)
	if rt.Refcount(pa) != 1 {
		print("FAIL fresh ")
		println(rt.Refcount(pa))
		return
	}
	{
		var b @T = a            // copy into the shared heap raises the count
		if rt.Refcount(pa) != 2 {
			print("FAIL copy ")
			println(rt.Refcount(pa))
			return
		}
		if b.v != 7 {
			println("FAIL shared value")
			return
		}
	}
	// b released -> back to 1: same metadata, same machine.
	if rt.Refcount(pa) != 1 {
		print("FAIL after ")
		println(rt.Refcount(pa))
		return
	}
	println("ok")
}
