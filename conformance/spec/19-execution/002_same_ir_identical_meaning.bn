package "main"
import "pkg/builtins/testing"

// exec.same-ir: both modes share a single front end -- one parse + type-check
// into ONE typed IR, then either lowered to native code or to bytecode. The
// modes differ ONLY in how an IR operation is REALIZED, never in what the
// program MEANS. A computation that spreads across many IR op kinds -- a loop,
// a conditional, function calls, integer arithmetic -- must therefore produce
// the IDENTICAL result in either realization.
func sq(x int) int {
	return x * x
}

func main() {
	var sum int = 0
	var i int = 0
	for i < 5 {
		if i % 2 == 0 {
			sum = sum + sq(i)     // += 0, 4, 16
		} else {
			sum = sum - i         // -= 1, 3
		}
		i = i + 1
	}
	// 0 - 1 + 4 - 3 + 16 = 16
	if sum == 16 {
		testing.Println("ok")
	} else {
		testing.Print("FAIL ")
		testing.Println(sum)
	}
}
