package "main"

// exec.modes: a conforming implementation provides compiled and/or interpreted
// execution; BOTH validate the whole program before a non-interactive run, and
// BOTH run the same initialization-then-main entry sequence (Ch.17). A
// package-level var initialized by a call observes that init ran before main:
// `seed` is computed at package-init time, and main reads the initialized
// value -- identical in either mode.
func compute() int {
	return 6 * 7
}

var seed int = compute()

func main() {
	if seed == 42 {
		println("ok")
	} else {
		print("FAIL ")
		println(seed)
	}
}
