package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// exec.vm.runtime-floor: even under the interpreter, the RUNTIME floor is
// NATIVE -- the runtime package (pkg/builtins/rt: reference counting,
// allocation, ...) executes as native code, reached from the bytecode through
// the same function-value mechanism as any other call; the interpreter
// interprets everything ABOVE that floor. Observable consequence: a program
// that allocates with `make` and reads its refcount via rt.Refcount works under
// the bytecode VM exactly as compiled -- the native runtime services the
// interpreted code beneath it.
type Node struct {
	v int
}

func main() {
	var n @Node = make(Node)          // native allocator, beneath the interpreter
	n.v = 99
	var pn *uint8 = bit_cast(*uint8, n)
	if rt.Refcount(pn) == 1 && n.v == 99 {   // native refcount service
		testing.Println("ok")
	} else {
		testing.Println("FAIL")
	}
}
