package "main"

// exec.contract: where a target supports both modes they AGREE EXACTLY on the
// observable layout and behavior of every program -- the cross-mode-agreement
// invariant; the two engines are co-equal. This program exercises layout (a
// struct's fields), an array, a raw-slice read, and arithmetic, and asserts a
// single combined result: passing UNCHANGED in compiled and interpreted modes
// IS the agreement -- which is exactly what exec.embedding.contract-vs-goal
// means by "each mode passes the suite individually, the same programs
// producing the same output whether compiled or interpreted". (That is the only
// per-program-observable half of exec.embedding.contract-vs-goal; its other half
// -- full in-process embedding is a GOAL, not yet realized -- has no observable
// a single-mode test can assert.)
type Point struct {
	x int
	y int
}

func main() {
	var p Point
	p.x = 3
	p.y = 4
	var arr [3]int
	arr[0] = p.x
	arr[1] = p.y
	arr[2] = p.x + p.y                  // 7
	var s *[]int = arr[:]               // raw slice over the array
	var total int = s[0] + s[1] + s[2]  // 3 + 4 + 7 = 14
	if total == 14 && len(s) == 3 {
		println("ok")
	} else {
		print("FAIL ")
		println(total)
	}
}
