package "main"

// exec.contract.types: both modes use the SAME type system and the same static
// rules; a program is accepted or rejected IDENTICALLY in both modes -- only the
// TIMING of validation differs (the compiler checks up front). The rejection
// happens in the shared front end, so this type error is reported in every mode
// the harness runs the test in (the .error must appear for compiled AND
// interpreted alike, which is the "rejected identically" check).
func main() {
	var x int = true     // type error: untyped bool is not assignable to int
	_ = x
}
