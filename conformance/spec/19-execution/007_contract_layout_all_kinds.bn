package "main"

// exec.contract.layout: both modes use the same memory layout for EVERY type --
// structs, arrays, raw slices and managed-slices, managed pointers, interface
// values, and function values -- with no marshalling at the boundary; any layout
// divergence would be silent data corruption. This measures the VALUE size of
// each kind; the managed-pointer allocation HEADER ({refcount, free_fn}, §18.2)
// is itself a cross-mode layout contract exercised by the Ch.18 refcount tests,
// not here. Asserted as target-invariant RELATIONSHIPS to the word size
// W = sizeof(int) (W is 4 on arm32, 8 on a 64-bit target), so the SAME .expected
// holds on every target and in every mode:
//   raw ptr / managed ptr                = 1 word
//   raw slice / func value / iface value = 2 words
//   managed-slice                        = 4 words
//   array[N] of int / struct of N ints   = N words
interface I {
	m()
}

type S struct {
	a int
	b int
}

func main() {
	var w uint = sizeof(int)
	if sizeof(*int) == w &&
		sizeof(@int) == w &&
		sizeof(*[]int) == 2 * w &&
		sizeof(*func(int) int) == 2 * w &&
		sizeof(*I) == 2 * w &&
		sizeof(@[]int) == 4 * w &&
		sizeof([3]int) == 3 * w &&
		sizeof(S) == 2 * w {
		println("ok")
	} else {
		println("FAIL")
	}
}
