package "main"

// exec.contract.errors: errors are VALUES, not exceptions -- there is no stack
// unwinding to bridge across the mode boundary, so a call (even one that would
// cross modes) is an ordinary call returning ordinary values. A function reports
// failure by RETURNING a status alongside its result (Go-style multiple
// returns); the caller inspects the value and branches. No exception mechanism
// is involved, and the behavior is identical in either mode.
func safeDiv(a int, b int) (int, bool) {
	if b == 0 {
		return 0, false      // failure reported as a value, not thrown
	}
	return a / b, true
}

func main() {
	var q int
	var ok bool
	q, ok = safeDiv(10, 2)
	if !ok || q != 5 {
		println("FAIL ok-case")
		return
	}
	q, ok = safeDiv(10, 0)
	if ok || q != 0 {
		println("FAIL err-case")
		return
	}
	println("ok")
}
