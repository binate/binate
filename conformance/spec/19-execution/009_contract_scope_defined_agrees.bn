package "main"
import "pkg/builtins/testing"

// exec.contract.scope: the cross-mode agreement binds the RESULT of every
// DEFINED operation (an UNDEFINED operation and the observable FORM of a
// mode-dependent abort are the two things OUTSIDE it -- the latter shown by
// 010). Integer overflow is DEFINED to wrap (Ch.13), not undefined -- so its
// result is part of the contract and must agree in both modes. The wrap is
// pinned DIRECTLY and target-invariantly: 0 - 1 (uint) yields the all-ones
// maximum -- a NONZERO value (it did not stay 0 or saturate) whose +1 closes
// back to 0 (wrap-around) -- and a uint8 wraps 255 -> 0.
func main() {
	var m uint = 0
	m = m - cast(uint, 1)            // defined wrap: 0 - 1 -> all-ones maximum
	if m == cast(uint, 0) {          // a real wrap went HIGH, it did not stay 0
		testing.Println("FAIL stayed-0")
		return
	}
	if m + cast(uint, 1) != cast(uint, 0) {   // and the maximum + 1 closes to 0
		testing.Println("FAIL no-closure")
		return
	}
	var b uint8 = 255
	b = b + cast(uint8, 1)           // defined wrap: 255 -> 0
	if b == cast(uint8, 0) {
		testing.Println("ok")
	} else {
		testing.Println("FAIL u8")
	}
}
