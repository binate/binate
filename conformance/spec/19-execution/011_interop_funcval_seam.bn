package "main"

// exec.interop.funcval: a function VALUE is the seam between modes -- the caller
// is OBLIVIOUS to whether the callee is compiled or interpreted; it calls
// THROUGH the value (one indirection), and the bridge translates calling
// conventions, never types or layout (which already agree). This exercises the
// seam itself -- a function value copied, passed through a parameter, and stored
// in a struct field, each call routing through the indirection to the target. (A
// genuine SINGLE-RUN mix of compiled and interpreted callees is not expressible
// in this harness, which runs a whole program in one mode; the indirection
// MECHANISM the seam relies on is what is exercised here, and the cross-mode
// agreement of every other test covers the oblivious-caller property at the
// program level.)
func dbl(x int) int {
	return x + x
}

func apply(f *func(int) int, x int) int {
	return f(x)                  // call THROUGH the function value
}

type Box struct {
	fn *func(int) int
}

func main() {
	var fv *func(int) int = dbl
	var dup *func(int) int = fv           // copy the two-word value
	var viaParam int = apply(dup, 8)      // 16, routed through a param slot
	var bx Box
	bx.fn = fv                            // stored in a field
	var viaField int = bx.fn(9)           // 18
	if fv(3) == 6 && viaParam == 16 && viaField == 18 {
		println("ok")
	} else {
		println("FAIL")
	}
}
