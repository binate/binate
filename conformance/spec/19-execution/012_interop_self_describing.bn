package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// exec.interop.self-describing: every managed object carries its own management
// information -- the allocation header {refcount, free_fn} deallocates it, and
// its destructor is reached mode-independently (through the embedded dispatch
// table's destructor slot for an interface or function value). So NEITHER mode
// needs special knowledge of the other's objects: an object frees itself,
// dispatches its methods, and reports its presence the same way regardless of
// which mode created or holds it. All three facets are observed here in one
// mode (the cross-mode agreement of the suite shows they hold in the other too):
//   - reports its presence:   present(g) on the interface value
//   - dispatches its methods:  g.greet() routes to the backing method
//   - frees itself:            on scope exit the Outer's destructor cascades and
//                              releases its reference to the shared Inner
//
// The free is observed SAFELY via a separately-held Inner (kept alive by `keep`,
// so its refcount never drops to 0 and is never read after free): the Inner
// rises to rc 2 while the Outer also references it, then falls back to rc 1 when
// the Outer's destructor runs at scope exit -- evidence the Outer freed itself.
//
// This also realizes exec.interop.call's destructor clause: the Outer's
// destructor is reached through a type-independent handle, and the cross-function
// reference-count release is never elided (the Inner's rc falls 2 -> 1), which is
// what keeps the shared heap consistent when an object is created in one mode and
// released in the other.
interface Greeter {
	greet() int
}

type Inner struct {
	v int
}

type Outer struct {
	kid @Inner
}

func (o *Outer) greet() int {
	return o.kid.v
}

impl *Outer : Greeter

func main() {
	var keep @Inner = make(Inner)         // external owner, holds rc 1
	keep.v = 42
	var pin *uint8 = bit_cast(*uint8, keep)
	if rt.Refcount(pin) != 1 {
		testing.Print("FAIL rc-fresh ")
		testing.Println(rt.Refcount(pin))
		return
	}
	{
		var o @Outer = make(Outer)
		o.kid = keep                       // Outer also references Inner -> rc 2
		var g @Greeter = o                  // managed interface value (smoothing)
		if !present(g) {
			testing.Println("FAIL present")
			return
		}
		if g.greet() != 42 {
			testing.Println("FAIL dispatch")
			return
		}
		if rt.Refcount(pin) != 2 {
			testing.Print("FAIL rc-linked ")
			testing.Println(rt.Refcount(pin))
			return
		}
		testing.Println("linked-ok")
	}
	// The Outer's last reference (o and g) is released at scope exit -> its
	// destructor runs and releases its kid: the shared Inner falls back to rc 1.
	if rt.Refcount(pin) == 1 {
		testing.Println("released-ok")
	} else {
		testing.Print("FAIL rc-released ")
		testing.Println(rt.Refcount(pin))
	}
}
