package "main"

// exec.divergence (the "permanent carve-out" kind): the bytecode VM performs NO
// foreign-function calls -- __c_call (§16.9) is a COMPILED-mode-only facility and
// will not be interpreted; interpreted code that needs C-obtained functionality
// is given a Binate implementation instead. This is a deliberate, PERMANENT
// boundary, not a pending feature. So a program whose only mode-specific element
// is a __c_call is well-defined and identical across the compiled backends, and
// is xfail'd on the interpreted modes by design (and on arm32-baremetal, which
// has no libc to link against). Calls libc's `int abs(int)`; C `int` is 32-bit
// on every target, so the argument/return are spelled int32 (Binate `int` is the
// target word width, which differs from C `int` on a 64-bit target).
func main() {
	var r int32 = __c_call("abs", int32, cast(int32, -42))
	if cast(int, r) == 42 {
		println("ok")
	} else {
		println("FAIL")
	}
}
