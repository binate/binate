package "main"
import "pkg/builtins/testing"

// exec.divergence (the "tracked defect" kind -- now RESOLVED): §19.5 records
// panic(msg) as a cross-mode disagreement (the bytecode VM treated it as a
// no-op, the compiled backend discarded the message). That defect is FIXED:
// panic now aborts WITH its message in BOTH modes. This pins the agreement from
// the divergence lens -- it runs UNCHANGED (no per-mode xfail) in every mode, so
// "before" then "panic: boom" must appear whether compiled or interpreted, and a
// regression to the old VM no-op would turn the VM modes red. (builtin.panic
// itself is owned by 15-builtins/131; the rule pinned here is the cross-mode
// agreement that the once-divergent abort now holds in both modes.)
func main() {
	testing.Println("before")
	panic("boom")
	testing.Println("after")
}
