package "main"
import "pkg/builtins/testing"

// exec.divergence: panic(msg) aborts WITH its message in BOTH modes (§19.5) --
// a bytecode VM that treats it as a no-op, or a compiled backend that discards
// the message, is a cross-mode disagreement. This pins the agreement from the
// divergence lens -- it runs UNCHANGED (no per-mode xfail) in every mode, so
// "before" then "panic: boom" must appear whether compiled or interpreted, and a
// VM no-op would turn the VM modes red. (builtin.panic itself is owned by
// 15-builtins/131; the rule pinned here is the cross-mode agreement on that
// abort.)
func main() {
	testing.Println("before")
	panic("boom")
	testing.Println("after")
}
