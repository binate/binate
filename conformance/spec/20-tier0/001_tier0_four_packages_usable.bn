package "main"

// All four tier-0 intrinsic packages import and are usable in one program.
import "pkg/builtins/lang"
import "pkg/builtins/rt"
import "pkg/builtins/reflect"
import "pkg/builtins/testing"

func describe(s *lang.Stringer) @[]char {
	return s.String()
}

func main() {
	var x int = 7
	println(describe(&x))             // lang: Stringer dispatch
	var p *uint8 = rt.Alloc(8)
	println(rt.Refcount(p))           // rt: alloc + refcount
	rt.Free(p)
	var pkg @reflect.Package = rt.__Package()
	println(pkg.Name)                 // reflect: descriptor of a built-in pkg
	var r testing.TestResult = make_slice(char, 0)
	println(len(r))                   // testing: TestResult = @[]char
}
