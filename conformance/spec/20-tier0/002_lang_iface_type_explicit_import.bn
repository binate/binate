package "main"
import "pkg/builtins/testing"

import "pkg/builtins/lang"

// A user struct opts into Stringer the ordinary way: an explicit bodyless
// impl plus a separately-declared method (no auto-derivation). With the
// explicit import, the interface TYPE *lang.Stringer is nameable and
// dispatches polymorphically over both the struct and a universe primitive.
type Tag struct {
	N int
}

impl Tag : lang.Stringer

func (t *Tag) String() @[]char {
	return t.N.String()
}

func show(s *lang.Stringer) @[]char {
	return s.String()
}

func main() {
	var t Tag = Tag{N: 99}
	testing.Println(show(&t))
	var x int = 5
	testing.Println(show(&x))
}
