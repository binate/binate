package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

// A String() result is a FRESHLY-ALLOCATED @[]char the caller OWNS:
// its backing managed node has refcount 1 (not a static sentinel), two
// calls on the same value yield DISTINCT backings, and the chars are
// correct. Managed-slice layout is {Data, Len, Refptr, BackingLen}, so
// word[2] (indexed in int units, target-invariant) is the backing node.
func backingOf(s *@[]char) *uint8 {
	var pw *int = bit_cast(*int, s)
	return bit_cast(*uint8, pw[2])
}

func main() {
	var x int = 1234
	var s1 @[]char = x.String()
	var s2 @[]char = x.String()
	var b1 *uint8 = backingOf(&s1)
	var b2 *uint8 = backingOf(&s2)

	// Owned, refcount exactly 1.
	testing.Println(rt.Refcount(b1))           // 1
	// Distinct fresh allocations.
	if b1 == b2 { testing.Println("SHARED") } else { testing.Println("distinct") }
	// RefInc/RefDec round-trips like a normal owned node.
	rt.RefInc(b1)
	testing.Println(rt.Refcount(b1))           // 2
	rt.RefDec(b1, nil)
	testing.Println(rt.Refcount(b1))           // 1
	// Contents correct.
	testing.Println(len(s1))                   // 4
	testing.Println(s1)                        // 1234
	// s1, s2 drop at scope exit -> freed (no use-after-free).
}
