package "main"

// Comparable.Compare(other) returns 0 IFF equal, nonzero otherwise; at this
// level the sign/magnitude of a nonzero result carry NO meaning. This test
// checks the equality predicate only (not sign), across several primitives.
func eq(c int) int {
	if c == 0 { return 1 }
	return 0
}

func main() {
	var a int = 3
	var b int = 5
	println(eq(a.Compare(a)))   // 1: equal
	println(eq(a.Compare(b)))   // 0: unequal
	println(eq(b.Compare(a)))   // 0: unequal (order-independent equality)

	var t bool = true
	var f bool = false
	println(eq(t.Compare(t)))   // 1
	println(eq(t.Compare(f)))   // 0

	var u uint64 = 100
	var v uint64 = 100
	var w uint64 = 200
	println(eq(u.Compare(v)))   // 1: equal values in distinct vars
	println(eq(u.Compare(w)))   // 0
}
