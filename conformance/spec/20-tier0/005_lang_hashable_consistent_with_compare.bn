package "main"

// Hashable.Hash() is consistent with Compare's equality: a.Compare(b)==0
// implies a.Hash()==b.Hash(). Hash is also stable across calls.
func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var a int = 42
	var b int = 42
	var c int = 99
	println(yn(a.Compare(b) == 0))      // 1: equal
	println(yn(a.Hash() == b.Hash()))   // 1: consistent
	println(yn(a.Hash() == a.Hash()))   // 1: stable
	println(yn(a.Compare(c) == 0))      // 0: unequal
	println(yn(a.Hash() == c.Hash()))   // 0: distinct under the bit-pattern impl (primitives), not a Hashable guarantee

	var t1 bool = true
	var t2 bool = true
	println(yn(t1.Compare(t2) == 0))    // 1
	println(yn(t1.Hash() == t2.Hash())) // 1
}
