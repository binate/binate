package "main"
import "pkg/builtins/testing"

import "pkg/builtins/lang"

// Hash() does not mention Self, so it IS callable through a *lang.Hashable
// interface value (object-safety is per-method). Consistency holds through
// the interface dispatch too.
func yn(b bool) int {
	if b { return 1 }
	return 0
}

func hashOf(h *lang.Hashable) uint {
	return h.Hash()
}

func main() {
	var a int = 42
	var b int = 42
	testing.Println(yn(hashOf(&a) == hashOf(&b)))   // 1: equal values, equal hashes
	testing.Println(yn(hashOf(&a) == a.Hash()))     // 1: matches direct call
}
