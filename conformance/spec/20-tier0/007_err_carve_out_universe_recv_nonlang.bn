package "main"

// pkg/builtins/lang is the ONLY package permitted to declare a method whose
// receiver is a universe primitive. This `main` package is not the carve-out,
// so a method on the universe primitive `int` must be rejected -- by the same
// "receiver is not a type defined in this package" rule that governs every
// foreign receiver (the carve-out is the broader principle; the diagnostic is
// the receiver-base rule, also cited).
func (x int) Foo() int {
	return x
}

func main() {
	var a int = 5
	println(a.Foo())
}
