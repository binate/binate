package "main"

import "pkg/builtins/lang"

// A user struct opts into a canonical interface the ordinary way: an explicit
// bodyless `impl *Point : lang.Comparable`, with the method declared separately.
// There is no auto-derivation; the struct must spell out Compare itself.
type Point struct {
	x int
	y int
}

func (a *Point) Compare(b Point) int {
	if a.x == b.x {
		if a.y == b.y {
			return 0
		}
	}
	return 1
}

impl *Point : lang.Comparable

func main() {
	var a Point
	a.x = 1
	a.y = 2
	var b Point
	b.x = 1
	b.y = 2
	var c Point
	c.x = 9
	c.y = 9
	// Direct named-type method-call path.
	if a.Compare(b) == 0 {
		println("eq")
	}
	if a.Compare(c) != 0 {
		println("neq")
	}
}
