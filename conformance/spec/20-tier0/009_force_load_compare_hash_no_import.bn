package "main"

// pkg0.lang.force-load: a primitive's canonical method resolves WITHOUT
// importing pkg/builtins/lang. The compiler force-loads lang so the carve-out
// impls attach to the primitive types. Here Compare (and Hash) on int resolve
// unqualified -- naming the interface TYPE would still need the import.
func main() {
	var a int = 3
	var b int = 5
	println(a.Compare(b))
	println(b.Compare(a))
	println(a.Compare(a))
	var h uint = a.Hash()
	if h == a.Hash() {
		println("hash_stable")
	}
}
