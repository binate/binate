package "main"

// pkg0.lang.force-load: the compiler force-loads pkg/builtins/lang so a
// PRIMITIVE's canonical method resolves unqualified, but naming the interface
// TYPE itself in an `impl T : lang.Comparable` clause still REQUIRES the explicit
// `import "pkg/builtins/lang"`. Without the import the `lang` qualifier here is
// unresolved and this must fail to compile. (658 pins the *lang.Stringer
// parameter flavor; this pins the impl-clause flavor.)
type T struct {
	v int
}

func (a T) Compare(b T) int {
	return a.v - b.v
}

impl T : lang.Comparable

func main() {
	var a T
	a.v = 1
	println(a.v)
}
