package "main"

import "pkg/builtins/lang"

// pkg0.lang.self-safety: Comparable.Compare(other Self) mentions Self in a
// PARAMETER position, so it is object-UNSAFE -- callable only through a generic
// constraint (where T is statically known), NOT through a *lang.Comparable
// interface value (which would require type-erased dispatch). The type checker
// rejects the call. A user struct is used so the iv assignment itself is clean
// and the failure isolates the Self-method-through-iv rule.
type T struct {
	v int
}

func (a *T) Compare(b T) int {
	return a.v - b.v
}

impl *T : lang.Comparable

func main() {
	var t T
	t.v = 1
	var u T
	u.v = 2
	var iv *lang.Comparable = &t
	var _ int = iv.Compare(u)
}
