package "main"

import "pkg/builtins/lang"

// pkg0.lang.self-safety (per-method): object-safety is decided per METHOD.
// Hashable.Hash() does NOT mention Self, so Hash IS callable through a
// *lang.Hashable interface value, even though the sibling Compare (which uses
// Self) is not.
type Key struct {
	v int
}

func (a *Key) Compare(b Key) int {
	return a.v - b.v
}

func (a *Key) Hash() uint {
	return cast(uint, a.v)
}

impl *Key : lang.Hashable

func hashThrough(h *lang.Hashable) uint {
	return h.Hash()
}

func main() {
	var k Key
	k.v = 42
	var iv *lang.Hashable = &k
	var got uint = iv.Hash()
	if got == cast(uint, 42) {
		println("hash_iv_ok")
	}
	if hashThrough(&k) == cast(uint, 42) {
		println("hash_param_ok")
	}
}
