package "main"

import "pkg/builtins/lang"

// pkg0.lang.self-safety: although Compare(other Self) is NOT callable through a
// *lang.Comparable interface value (Self in a parameter position is object-
// unsafe), it IS callable through a generic constraint `[T lang.Comparable]`,
// where T is statically known so dispatch is direct, not type-erased. Exercised
// on both a user struct (opting in via a bodyless impl) and a universe primitive.
type Pair struct {
	v int
}

func (a Pair) Compare(b Pair) int {
	return a.v - b.v
}

impl Pair : lang.Comparable

func eq[T lang.Comparable](a T, b T) bool {
	return a.Compare(b) == 0
}

func main() {
	var p Pair
	p.v = 7
	var q Pair
	q.v = 7
	var r Pair
	r.v = 9
	if eq[Pair](p, q) {
		println("struct_eq")
	}
	if !eq[Pair](p, r) {
		println("struct_neq")
	}
	if eq[int](4, 4) {
		println("int_eq")
	}
	if !eq[int](4, 5) {
		println("int_neq")
	}
}
