package "main"

// pkg0.lang.orderable: a primitive's Compare sign gives total order --
// a.Compare(b) < 0 for a < b, > 0 for a > b, == 0 for equal -- across a
// spread of universe primitives.  No import needed (force-load supplies
// the primitive impls).
func main() {
	// signed int
	var a int = 3
	var b int = 5
	if a.Compare(b) >= 0 { println("FAIL int <"); return }
	if b.Compare(a) <= 0 { println("FAIL int >"); return }
	if a.Compare(a) != 0 { println("FAIL int =="); return }
	// unsigned (uint32)
	var u uint32 = 10
	var v uint32 = 20
	if u.Compare(v) >= 0 { println("FAIL u32 <"); return }
	if v.Compare(u) <= 0 { println("FAIL u32 >"); return }
	// sized signed (int16, negatives)
	var m int16 = -300
	var n int16 = 7
	if m.Compare(n) >= 0 { println("FAIL i16 <"); return }
	if n.Compare(m) <= 0 { println("FAIL i16 >"); return }
	// bool: false < true
	var f bool = false
	var t bool = true
	if f.Compare(t) >= 0 { println("FAIL bool <"); return }
	if t.Compare(f) <= 0 { println("FAIL bool >"); return }
	if t.Compare(t) != 0 { println("FAIL bool =="); return }
	// float64 finite ordering (NaN corner is a separate test)
	var x float64 = 1.5
	var y float64 = 2.5
	if x.Compare(y) >= 0 { println("FAIL f64 <"); return }
	if y.Compare(x) <= 0 { println("FAIL f64 >"); return }
	println("ok")
}
