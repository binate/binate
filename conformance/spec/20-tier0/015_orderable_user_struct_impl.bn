package "main"
import "pkg/builtins/testing"

// pkg0.lang.orderable: a user struct opts into Orderable the ordinary way
// -- an explicit bodyless `impl Point : lang.Orderable` plus a separately
// declared Compare (no auto-derivation).  Naming the interface TYPE in the
// impl clause requires importing pkg/builtins/lang.  A consumer wanting `<`
// writes a.Compare(b) < 0.
import "pkg/builtins/lang"

type Point struct {
	x int
	y int
}

// Self for a value receiver is Point, so Compare(other Point) int.
// Lexicographic order on (x, y).
func (a Point) Compare(b Point) int {
	if a.x < b.x { return -1 }
	if a.x > b.x { return 1 }
	if a.y < b.y { return -1 }
	if a.y > b.y { return 1 }
	return 0
}

impl Point : lang.Orderable

func main() {
	var p Point
	p.x = 1
	p.y = 2
	var q Point
	q.x = 1
	q.y = 5
	if p.Compare(q) >= 0 { testing.Println("FAIL p<q"); return }
	if q.Compare(p) <= 0 { testing.Println("FAIL q>p"); return }
	if p.Compare(p) != 0 { testing.Println("FAIL p==p"); return }
	testing.Println("ok")
}
