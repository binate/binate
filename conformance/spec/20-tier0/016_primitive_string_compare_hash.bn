package "main"

// pkg0.lang.primitives: String / Compare / Hash ship for the universe
// primitive scalar types and (for integers + bool) are Stable -- Compare
// yields -1/0/1 by natural ordering and Hash is the zero-extended bit
// pattern.  This pins concrete values across a representative spread of the
// thirteen types.  Hash assertions use only non-negative values < 2^32 so
// they are width-invariant (uint is 32-bit on arm32, 64-bit on 64-bit
// targets; signed-negative and uint64 hashes are width-dependent and so
// avoided here).  No import needed -- force-load supplies the impls.
import "pkg/builtins/lang"

func main() {
	// --- String ---
	var i8 int8 = -128
	println(i8.String())            // -128
	var u16 uint16 = 65535
	println(u16.String())           // 65535
	var i64 int64 = 9223372036854775807
	println(i64.String())           // 9223372036854775807
	var bt bool = true
	println(bt.String())            // true
	var bf bool = false
	println(bf.String())            // false

	// --- Compare (natural -1/0/1) ---
	var a uint8 = 10
	var b uint8 = 200
	if a.Compare(b) != -1 { println("FAIL u8 cmp<"); return }
	if b.Compare(a) != 1 { println("FAIL u8 cmp>"); return }
	if a.Compare(a) != 0 { println("FAIL u8 cmp=="); return }
	var s int32 = -5
	var t int32 = 5
	if s.Compare(t) != -1 { println("FAIL i32 cmp<"); return }
	if t.Compare(s) != 1 { println("FAIL i32 cmp>"); return }

	// --- Hash (bit pattern; width-invariant cases only) ---
	var h8 uint8 = 200
	if h8.Hash() != cast(uint, 200) { println("FAIL u8 hash"); return }
	var h16 uint16 = 50000
	if h16.Hash() != cast(uint, 50000) { println("FAIL u16 hash"); return }
	var h32 uint32 = 4000000000
	if h32.Hash() != cast(uint, 4000000000) { println("FAIL u32 hash"); return }
	var ht bool = true
	if ht.Hash() != cast(uint, 1) { println("FAIL bool hash true"); return }
	var hf bool = false
	if hf.Hash() != cast(uint, 0) { println("FAIL bool hash false"); return }
	// Hash consistent with Compare-equality on integers.
	var p int = 42
	var q int = 42
	if p.Hash() != q.Hash() { println("FAIL hash consistency"); return }

	println("ok")
}
