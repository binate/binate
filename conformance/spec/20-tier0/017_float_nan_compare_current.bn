package "main"

// pkg0.lang.float-nan (Provisional): pins the CURRENT shipped behavior,
// a tracked NON-CONFORMANCE against the ratified IEEE-total-order intent.
// Today float Compare is `a < b ? -1 : a > b ? 1 : 0`, and IEEE-754 makes
// both `<` and `>` false for any NaN, so Compare returns 0 -- NaN compares
// "equal" to every value (finites, +Inf, and other NaNs).  Finite ordering
// is unaffected.  The companion ratified-intent test is xfail.all.
// (No import: force-load supplies the primitive impls.)
func main() {
	var nan float64 = 0.0
	nan = nan / 0.0
	var one float64 = 1.0
	var inf float64 = 1.0
	inf = inf / 0.0

	// NaN compares "equal" (0) to everything under current behavior.
	if nan.Compare(one) != 0 { println("FAIL nan.Compare(one)"); return }
	if one.Compare(nan) != 0 { println("FAIL one.Compare(nan)"); return }
	if nan.Compare(nan) != 0 { println("FAIL nan.Compare(nan)"); return }
	if nan.Compare(inf) != 0 { println("FAIL nan.Compare(inf)"); return }
	if inf.Compare(nan) != 0 { println("FAIL inf.Compare(nan)"); return }

	// Finite ordering still works (and +Inf is the largest finite-ish).
	if one.Compare(inf) != -1 { println("FAIL one<inf"); return }
	if inf.Compare(one) != 1 { println("FAIL inf>one"); return }
	var two float64 = 2.0
	if one.Compare(two) != -1 { println("FAIL one<two"); return }
	if two.Compare(one) != 1 { println("FAIL two>one"); return }
	if one.Compare(one) != 0 { println("FAIL one==one"); return }

	// Same story for float32.
	var n32 float32 = 0.0
	n32 = n32 / 0.0
	var o32 float32 = 1.0
	if n32.Compare(o32) != 0 { println("FAIL f32 nan.Compare(one)"); return }
	if o32.Compare(n32) != 0 { println("FAIL f32 one.Compare(nan)"); return }

	// Float Hash is the bit pattern (float32 case is width-invariant:
	// 1.0f -> 0x3F800000 -> 1065353216, fits in 32-bit uint).
	var f float32 = 1.0
	if f.Hash() != cast(uint, 1065353216) { println("FAIL f32 hash"); return }

	println("ok")
}
