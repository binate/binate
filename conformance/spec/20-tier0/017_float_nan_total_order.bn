package "main"
import "pkg/builtins/testing"

// pkg0.lang.float-nan -- the RATIFIED float total order (spec §20.1).
// Every NaN (any sign, any payload) sorts ABOVE +Inf and compares EQUAL to
// every other NaN, so `-Inf, …finites…, -0, +0, …finites…, +Inf, {all NaN}`
// is monotonic.  Among non-NaN values the order is the IEEE-754 totalOrder on
// the bit pattern, which orders -0 < +0.  Compare folds all NaN into one
// equivalence class, so Hash canonicalizes every NaN to one value
// (Hashable consistency: Compare(a,b)==0 ⟹ Hash(a)==Hash(b)).
// (No import: force-load supplies the primitive impls.)
func main() {
	var nan float64 = 0.0
	nan = nan / 0.0 // +qNaN
	var one float64 = 1.0
	var two float64 = 2.0
	var inf float64 = 1.0
	inf = inf / 0.0 // +Inf

	// NaN is the greatest value: above every finite and above +Inf.
	if one.Compare(nan) != -1 { testing.Println("FAIL one<nan"); return }
	if nan.Compare(one) != 1 { testing.Println("FAIL nan>one"); return }
	if inf.Compare(nan) != -1 { testing.Println("FAIL inf<nan"); return }
	if nan.Compare(inf) != 1 { testing.Println("FAIL nan>inf"); return }
	if nan.Compare(nan) != 0 { testing.Println("FAIL nan==nan"); return }

	// NaN placement is sign-independent: a negative NaN is also at the top
	// and compares equal to the positive NaN.
	var negnan float64 = bit_cast(float64, bit_cast(uint64, nan) | (cast(uint64, 1) << cast(uint64, 63)))
	if inf.Compare(negnan) != -1 { testing.Println("FAIL inf<negnan"); return }
	if negnan.Compare(inf) != 1 { testing.Println("FAIL negnan>inf"); return }
	if nan.Compare(negnan) != 0 { testing.Println("FAIL nan==negnan"); return }

	// Distinct NaN payloads compare equal (one equivalence class).
	var nan2 float64 = bit_cast(float64, bit_cast(uint64, nan) | cast(uint64, 1))
	if nan.Compare(nan2) != 0 { testing.Println("FAIL nan==nan2"); return }

	// IEEE totalOrder on non-NaN distinguishes signed zeros: -0 < +0.
	var poszero float64 = 0.0
	var negzero float64 = bit_cast(float64, cast(uint64, 1) << cast(uint64, 63))
	if negzero.Compare(poszero) != -1 { testing.Println("FAIL -0<+0"); return }
	if poszero.Compare(negzero) != 1 { testing.Println("FAIL +0>-0"); return }

	// Finite ordering is unchanged.
	if one.Compare(two) != -1 { testing.Println("FAIL one<two"); return }
	if two.Compare(one) != 1 { testing.Println("FAIL two>one"); return }
	if one.Compare(one) != 0 { testing.Println("FAIL one==one"); return }

	// Hashable consistency: all NaN hash identically (Compare folds them equal).
	if nan.Hash() != nan2.Hash() { testing.Println("FAIL nan/nan2 hash"); return }
	if nan.Hash() != negnan.Hash() { testing.Println("FAIL nan/negnan hash"); return }

	// Same story for float32.
	var n32 float32 = 0.0
	n32 = n32 / 0.0
	var o32 float32 = 1.0
	if o32.Compare(n32) != -1 { testing.Println("FAIL f32 one<nan"); return }
	if n32.Compare(o32) != 1 { testing.Println("FAIL f32 nan>one"); return }
	if n32.Compare(n32) != 0 { testing.Println("FAIL f32 nan==nan"); return }
	var n32b float32 = bit_cast(float32, bit_cast(uint32, n32) | cast(uint32, 1))
	if n32.Compare(n32b) != 0 { testing.Println("FAIL f32 nan==nan2"); return }
	if n32.Hash() != n32b.Hash() { testing.Println("FAIL f32 nan hash"); return }

	// Float Hash is still the bit pattern for non-NaN (1.0f -> 0x3F800000).
	var f float32 = 1.0
	if f.Hash() != cast(uint, 1065353216) { testing.Println("FAIL f32 hash value"); return }

	testing.Println("ok")
}
