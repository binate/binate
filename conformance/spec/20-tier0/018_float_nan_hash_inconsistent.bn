package "main"

// pkg0.lang.float-nan (Provisional) -- the Hash-inconsistency corner, CURRENT
// behavior. The shipped float Hash reinterprets the bit pattern, so two NaNs
// with DISTINCT bit patterns hash DIFFERENTLY -- yet float Compare returns 0 for
// any NaN pair ("NaN equals NaN"). That is formally inconsistent with the
// Hashable consistency requirement (a.Compare(b)==0 should imply
// a.Hash()==b.Hash()), and is a TRACKED non-conformance against the ratified
// IEEE-total-order intent. This pins the CURRENT behavior (no xfail): a quiet
// NaN (0.0/0.0) and a distinct payload NaN compare "equal" (0) but hash
// differently. float32 + uint32 bit patterns are width-invariant.
func main() {
	var nan1 float32 = 0.0
	nan1 = nan1 / 0.0                                              // a NaN
	var nan2 float32 = bit_cast(float32, cast(uint32, 2143289345)) // 0x7FC00001, a distinct payload NaN
	if nan1.Compare(nan2) != 0 {                                  // Compare says "equal"...
		println("FAIL compare")
		return
	}
	if nan1.Hash() == nan2.Hash() {                              // ...but Hash says distinct
		println("FAIL hash-consistent")
		return
	}
	println("ok")
}
