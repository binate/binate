package "main"

// pkg0.lang.float-nan -- RATIFIED INTENT (xfail.all until realized).
// The ratified Compare total order is IEEE total ordering: NaN sorts AFTER
// every finite value AND after +Inf, so `-Inf, ...finites..., +Inf, NaN` is
// monotonic.  Concretely: finite.Compare(NaN) < 0, NaN.Compare(finite) > 0,
// +Inf.Compare(NaN) < 0, NaN.Compare(+Inf) > 0, NaN.Compare(NaN) == 0; and
// finite ordering is unchanged.  The CURRENT impl returns 0 for any NaN
// comparison (see the companion current-behavior test), so this prints a
// FAIL line today and is marked xfail.all -- it flips green when the intent
// is realized.  (No import: force-load supplies the primitive impls.)
func main() {
	var nan float64 = 0.0
	nan = nan / 0.0
	var one float64 = 1.0
	var inf float64 = 1.0
	inf = inf / 0.0

	if one.Compare(nan) >= 0 { println("FAIL: one.Compare(nan) not < 0"); return }
	if nan.Compare(one) <= 0 { println("FAIL: nan.Compare(one) not > 0"); return }
	if inf.Compare(nan) >= 0 { println("FAIL: inf.Compare(nan) not < 0"); return }
	if nan.Compare(inf) <= 0 { println("FAIL: nan.Compare(inf) not > 0"); return }
	if nan.Compare(nan) != 0 { println("FAIL: nan.Compare(nan) not == 0"); return }
	if one.Compare(inf) >= 0 { println("FAIL: finite order one<inf"); return }
	if inf.Compare(one) <= 0 { println("FAIL: finite order inf>one"); return }
	println("ok")
}
