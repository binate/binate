package "main"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

// pkg0.reflect.surface: pkg/builtins/reflect is interface-only and exposes a
// compiled package's reflective metadata through three types -- Package,
// FunctionInfo, GlobalInfo. Using them requires importing reflect. The BUILT-IN
// rt package's descriptor is read here (a built-in __Package() is reached on
// every mode, so no VM xfail is needed -- unlike a user package, see the vm-gap
// test): Package.Name is the full import path (printed, matched by .expected --
// Name is a *[]readonly char, which cannot be compared with ==), and the
// Functions table yields usable FunctionInfo values carrying scalar metadata.
func main() {
	var p @reflect.Package = rt.__Package()
	println(p.Name)                                    // pkg/builtins/rt
	var fns *[]@reflect.FunctionInfo = p.Functions
	if len(fns) < 1 {
		println("FAIL no functions")
		return
	}
	var acc @reflect.FunctionInfo = fns[len(fns) - 1]  // the __Package accessor (last)
	if acc.RetbufSize != 0 {                           // scalar/pointer return -> 0 (the
		print("FAIL retbuf ")                          // load-bearing scalar-vs-aggregate
		println(acc.RetbufSize)                        // discriminator; aggregate side in
		return                                         // the scope test)
	}
	if !present(acc.Value) {                           // Value points at the func-value handle
		println("FAIL no value handle")
		return
	}
	println("ok")
}
