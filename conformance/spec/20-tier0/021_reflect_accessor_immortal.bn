package "main"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

// pkg0.reflect.accessor: the compiler synthesizes, for EVERY package, a
// func _Package() @reflect.Package returning that package's IMMORTAL
// static-managed descriptor. It is not declared in any .bni, and reflect is
// force-loaded so the accessor exists; it is callable UNQUALIFIED as the
// current package's own accessor. The descriptor is immortal -- its refcount is
// the STATIC_REFCOUNT sentinel, so acquire/release is a no-op and it is never
// freed. Name is the package's full import path ("main" here). A user package's
// _Package() is unavailable under the bytecode VM (pkg0.reflect.vm-gap), so this
// is xfail'd on the VM modes.
func main() {
	var p @reflect.Package = _Package()       // unqualified: main's own accessor
	println(p.Name)                            // main
	var rc int = rt.Refcount(bit_cast(*uint8, p))
	if rc != rt.STATIC_REFCOUNT {
		print("FAIL not-immortal ")
		println(rc)
		return
	}
	println("ok")
}
