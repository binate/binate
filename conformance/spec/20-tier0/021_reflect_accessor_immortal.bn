package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

// pkg0.reflect.accessor: the compiler synthesizes, for EVERY package, a
// func __Package() @reflect.Package returning that package's IMMORTAL
// static-managed descriptor. It is not declared in any .bni, and reflect is
// force-loaded so the accessor exists; it is callable UNQUALIFIED as the
// current package's own accessor. The descriptor is immortal -- its refcount is
// the STATIC_REFCOUNT sentinel, so acquire/release is a no-op and it is never
// freed. Name is the package's full import path ("main" here). The bytecode VM
// emits each package's __Package() as bytecode, so the accessor is reachable in
// every mode -- user packages included, not only the built-ins.
func main() {
	var p @reflect.Package = __Package()       // unqualified: main's own accessor
	testing.Println(p.Name)                            // main
	var rc int = rt.Refcount(bit_cast(*uint8, p))
	if rc != rt.STATIC_REFCOUNT {
		testing.Print("FAIL not-immortal ")
		testing.Println(rc)
		return
	}
	testing.Println("ok")
}
