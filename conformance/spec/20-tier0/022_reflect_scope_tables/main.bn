package "main"
import "pkg/builtins/testing"

import "pkg/up"
import "pkg/builtins/reflect"

// pkg0.reflect.scope (Draft): what is introspectable TODAY is exactly the
// FUNCTION and GLOBAL binding tables. Functions lists one FunctionInfo per
// .bni-EXPORTED non-extern function in declaration order, FOLLOWED BY the
// package's own synthesized __Package accessor as the LAST entry; the UNEXPORTED
// `helper` is excluded. Globals lists one GlobalInfo per EXPORTED package-level
// var (Counter), excluding the unexported `hidden`; GlobalInfo.Addr is the var's
// raw storage cell. Names are fully qualified. RetbufSize is the scalar-vs-
// aggregate return discriminator: 0 for Scalar()'s int return, nonzero for
// Aggregate()'s struct return. (Types, fields, methods, impls, consts, imports
// are NOT yet introspectable -- a later phase.) A user package's __Package() is
// xfail'd on the VM modes (pkg0.reflect.vm-gap).
func main() {
	var p @reflect.Package = up.__Package()
	var fns *[]@reflect.FunctionInfo = p.Functions
	testing.Println(len(fns))                    // 3: Scalar, Aggregate, __Package (helper excluded)
	testing.Println(fns[0].Name)                 // pkg/up.Scalar (first, decl order)
	testing.Println(fns[len(fns) - 1].Name)      // pkg/up.__Package (the accessor, last)
	// RetbufSize discriminator: Scalar() int -> 0; Aggregate() Triple -> nonzero.
	if fns[0].RetbufSize != 0 {
		testing.Print("FAIL scalar-rb ")
		testing.Println(fns[0].RetbufSize)
		return
	}
	if fns[1].RetbufSize <= 0 {
		testing.Print("FAIL aggregate-rb ")
		testing.Println(fns[1].RetbufSize)
		return
	}
	var globals *[]@reflect.GlobalInfo = p.Globals
	testing.Println(len(globals))                // 1: Counter (hidden excluded)
	testing.Println(globals[0].Name)             // pkg/up.Counter
	// GlobalInfo.Addr is the live storage cell of the exported var.
	if bit_cast(*int, globals[0].Addr)[0] != 7 {
		testing.Println("FAIL addr")
		return
	}
	testing.Println("ok")
}
