package "main"
import "pkg/builtins/testing"

import "pkg/up2"
import "pkg/builtins/reflect"

// pkg0.reflect: __Package() returns a package's reflection descriptor in every
// mode. The bytecode VM emits each package's __Package() + descriptor as bytecode
// (not only the small fixed set of BUILT-IN packages bound through hardcoded
// externs), so a USER (or stdlib) package's __Package() is reachable under the
// interpreter too. The test pins __Package().Name == the import path for the user
// package pkg/up2 across all modes.
func main() {
	testing.Println(up2.__Package().Name)               // pkg/up2 (matched by .expected)
}
