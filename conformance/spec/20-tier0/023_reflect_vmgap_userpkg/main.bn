package "main"

import "pkg/up2"
import "pkg/builtins/reflect"

// pkg0.reflect.vm-gap: under the bytecode VM, _Package() is reached only for a
// small fixed set of BUILT-IN packages (bound through hardcoded externs); a USER
// (or stdlib) package compiled to bytecode has no native _Package symbol, so its
// _Package() is unavailable under the interpreter. This is a tracked, deferred
// interpreter-backend defect: the test pins _Package().Name == the import path,
// which PASSES on the compiled modes and is XFAIL'd on the VM modes. The proper
// fix emits each package's _Package() + descriptor as bytecode.
func main() {
	println(up2._Package().Name)               // pkg/up2 (matched by .expected)
}
