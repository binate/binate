package "main"
import "pkg/builtins/testing"

import "pkg/builtins/rt"

type Node struct {
	Val int
}

// pkg0.rt: the runtime contract is reachable as a tier-0 package.  A
// user-created managed allocation (`make(Node)`) carries the rt-managed
// header (§18.2); rt.Refcount — part of rt's observable surface, read via
// bit_cast(*uint8, @Node) — observes the live reference count the runtime
// maintains for it.  (pkg0.rt is a Draft placeholder with no authored member
// list; this only pins that the observable runtime surface is reachable as a
// tier-0 package, distinct from the raw rt.Alloc path of conformance/104.)
func main() {
	var n @Node = make(Node)
	if rt.Refcount(bit_cast(*uint8, n)) == 1 { testing.Println("rc1=ok") } else { testing.Println("rc1=BAD") }
	var m @Node = n
	if rt.Refcount(bit_cast(*uint8, n)) == 2 { testing.Println("rc2=ok") } else { testing.Println("rc2=BAD") }
	testing.Println("done")
}
