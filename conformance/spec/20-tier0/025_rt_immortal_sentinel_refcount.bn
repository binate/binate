package "main"

import "pkg/builtins/rt"
import "pkg/builtins/reflect"

// pkg0.rt observable surface + the immortal sentinel (§18.2): the package
// descriptor the compiler emits for every package is immortal static-managed —
// its header Refcount is the STATIC_REFCOUNT sentinel (deeply negative), so
// RefInc/RefDec short-circuit and it is never freed.  rt.Refcount reads that
// sentinel back, distinguishing an immortal node from a live heap node
// (count >= 1).  This pins two rt members (Refcount, the STATIC_REFCOUNT const)
// as reachable tier-0 surface; pkg0.rt itself is a Draft placeholder.
func main() {
	var p @reflect.Package = rt.__Package()
	var rc int = rt.Refcount(bit_cast(*uint8, p))
	if rc < 0 { println("immortal=ok") } else { println("immortal=BAD") }
	if rc == rt.STATIC_REFCOUNT { println("sentinel=ok") } else { println("sentinel=BAD") }
	println("done")
}
