package "main"

import "pkg/builtins/testing"

// pkg0.testing.testresult: TestResult is a TYPE ALIAS for @[]char.  Because it
// is an alias (not a distinct nominal type), the two spellings interchange
// freely with no conversion: a func declared to return testing.TestResult may
// return a @[]char, and a testing.TestResult value flows into a @[]char.  The
// pass/fail convention lives in the RESULT: len(result)==0 => pass, >0 => the
// failure message.  (No --test runner exists in the harness; this pins the
// TYPE-level contract, not the runner's discovery/execution semantics.)

// A passing test returns the empty managed-slice.
func passing() testing.TestResult {
	return make_slice(char, 0)
}

// A failing test returns a non-empty managed-slice (the failure message).
func failing() testing.TestResult {
	return "boom"
}

// A plain @[]char parameter accepts a testing.TestResult unchanged (same type).
func msgLen(msg @[]char) int {
	return len(msg)
}

func main() {
	var r1 @[]char = passing()
	if len(r1) == 0 { println("pass=ok") } else { println("pass=BAD") }

	var r2 testing.TestResult = failing()
	if len(r2) > 0 { println("fail=ok") } else { println("fail=BAD") }
	if msgLen(r2) == 4 { println("alias=ok") } else { println("alias=BAD") }
	println(r2)
	println("done")
}
