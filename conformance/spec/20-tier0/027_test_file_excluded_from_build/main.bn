package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg0.testing.files: a `*_test.bn` file is EXCLUDED from a normal build, so it
// contributes nothing to the package surface.  pkg/lib has lib.bn (Answer() ->
// 42) and lib_test.bn (which holds a Test-prefixed testing.TestResult function
// AND a colliding redefinition Answer() -> 999).  If lib_test.bn were included,
// the duplicate Answer() would be a duplicate-definition error; because it is
// excluded, the build succeeds and Answer() is the real one.  Want: 42.
func main() {
	if lib.Answer() == 42 { testing.Println("ok") } else { testing.Println("FAIL") }
}
