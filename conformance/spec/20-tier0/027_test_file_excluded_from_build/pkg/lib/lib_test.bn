package "pkg/lib"

import "pkg/builtins/testing"

// This file ends in _test.bn, so it is excluded from the normal build
// (pkg0.testing.files).  If it were NOT excluded, this redefinition of
// Answer() would collide with lib.bn's Answer() — a duplicate-definition
// error — and would change the answer to 999.  Its exclusion is what makes
// the normal build succeed with Answer() == 42.  It also holds a real test
// function (Test prefix, zero params, returns testing.TestResult).
func Answer() int { return 999 }

func TestAnswer() testing.TestResult {
	if Answer() == 999 { return make_slice(char, 0) }
	return "wrong"
}
