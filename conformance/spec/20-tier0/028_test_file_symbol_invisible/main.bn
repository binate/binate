package "main"
import "pkg/builtins/testing"

import "pkg/lib"

// pkg0.testing.files: a symbol declared ONLY in a `_test.bn` file is not part
// of the normal package surface.  pkg/lib's normal file lib.bn references
// TestHelper(), which is defined only in lib_test.bn.  Under a normal (non
// --test) build lib_test.bn is excluded, so TestHelper is undefined and the
// build must fail — proving the test-only symbol does not contribute to the
// normal build.
func main() { testing.Println(lib.Greeting()) }
