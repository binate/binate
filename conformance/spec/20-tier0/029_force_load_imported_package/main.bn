package "main"

import "pkg/probe"

import "pkg/builtins/testing"

// pkg0.lang.force-load: any package, not only main, may call a primitive's
// canonical methods without importing pkg/builtins/lang.  pkg/probe is imported
// first, in its own group so the import order stays: before testing, whose .bn
// imports lang, so only the force-load puts lang ahead of pkg/probe.
func main() {
	testing.Println(probe.Name(42))
	testing.Println(probe.Less(3, 5))
	testing.Println(probe.SameHash(7, 7))
}
