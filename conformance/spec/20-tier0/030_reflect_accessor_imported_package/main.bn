package "main"

import "pkg/probe"

import "pkg/builtins/testing"

// pkg0.reflect.accessor: every package, not only main, has a `__Package()`
// accessor without importing pkg/builtins/reflect.  pkg/probe is imported
// first, in its own group so the import order stays: before testing, whose .bn
// imports reflect, so only the force-load puts reflect ahead of pkg/probe.
func main() {
	testing.Println(probe.Name())
}
