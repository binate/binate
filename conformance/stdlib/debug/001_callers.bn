package "main"

import "pkg/builtins/testing"
import "pkg/std/debug"

// End-to-end check that pkg/std/debug.Callers captures a stack in EVERY execution
// mode — LLVM, the bytecode VM, and each native backend (x64/aarch64/arm32) — at
// every optimization level.  debug.Callers promises no particular frames: an
// optimizer may remove a frame (c1 -> c2 -> c3 are all tail calls, which LLVM makes
// sibling calls at -O1 and above; the native inliner may fold them into main), and
// how many frames sit above main depends on the target's startup code.  So this
// asserts only that the capture point itself is recorded, and prints a fixed token,
// keeping the .expected output deterministic across modes.

func c3(into *[]debug.Frame) int { return debug.Callers(0, into) }
func c2(into *[]debug.Frame) int { return c3(into) }
func c1(into *[]debug.Frame) int { return c2(into) }

func main() {
	var buf [16]debug.Frame
	var n int = c1(buf[:])
	if n >= 1 {
		testing.Println("ok")
	} else {
		testing.Println("short")
	}
}
