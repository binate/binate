package "main"

import "pkg/builtins/testing"
import "pkg/std/debug"

// End-to-end check that pkg/std/debug.Callers captures a plausible multi-frame
// stack in EVERY execution mode — LLVM, the bytecode VM, and each native backend
// (x64/aarch64/arm32).  The exact depth varies by mode (native frames record a
// return address, VM frames a function index) plus synthetic wrapper frames, so
// this asserts a conservative MINIMUM depth and prints a fixed token, keeping the
// .expected output deterministic across modes.

func c3(into *[]debug.Frame) int { return debug.Callers(0, into) }
func c2(into *[]debug.Frame) int { return c3(into) }
func c1(into *[]debug.Frame) int { return c2(into) }

func main() {
	var buf [16]debug.Frame
	var n int = c1(buf[:])
	// The live chain c3 -> c2 -> c1 -> main gives at least three recordable
	// frames above the capture point in every mode; require a conservative floor
	// rather than pinning an exact (mode-dependent) count.
	if n >= 3 {
		testing.Println("ok")
	} else {
		testing.Println("short")
	}
}
