package "main"

// Cross-mode interface UPCAST of a native-source iface value.  Under the int
// modes os is the injected COMPILED package, so the @errors.Error it returns
// carries a native @__ivt vtable; upcasting it (to `any`, and the managed->raw
// decay) exercises the VM's BC_IFACE_UPCAST native-source branch.  Under
// builder-comp it runs all-native (emit_iface_upcast).  Same output in both.
// This is the cross-mode home for the iface-upcast-for-compiled-vtables
// coverage (the os UNIT test cannot exercise it once stdlib unit tests stop
// running under interpreter modes).
import "pkg/std/os"
import "pkg/std/errors"

func main() {
	var f @os.File
	var err @errors.Error
	f, err = os.Open("/tmp/binate_conf_stdlib_does_not_exist_zzz")
	if !present(err) { println(-1); return }

	// @errors.Error -> @any (zero-offset upcast): value must survive.
	var a @any = err
	if present(a) { println(1) } else { println(0) }            // 1

	// Managed->raw decay (@errors.Error -> *errors.Error); dispatch Error()
	// through the decayed value (post-upcast native method dispatch).
	var re *errors.Error = err
	if len(re.Error()) > 0 { println(1) } else { println(0) }   // 1
}
