package "main"
import "pkg/builtins/testing"

// errors.Is across the injected errors package: reference-identity matching and
// Unwrap()-chain walking.  (577_std_errors covers New/Wrap/Error/Unwrap/chain;
// this covers Is, which 577 does not.)  Stdlib conformance suite.
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// Is by reference identity: an error is itself; a distinct error with the
	// same message is not.
	var sentinel @errors.Error = errors.New("EOF")
	testing.Println(yn(errors.Is(sentinel, sentinel)))        // 1
	var other @errors.Error = errors.New("EOF")
	testing.Println(yn(errors.Is(sentinel, other)))           // 0

	// Is walks the Unwrap() chain to find a wrapped sentinel; false for a
	// target absent from the chain.
	var wrapped @errors.Error = errors.Wrap(errors.Wrap(sentinel, "mid"), "top")
	testing.Println(yn(errors.Is(wrapped, sentinel)))         // 1
	var stranger @errors.Error = errors.New("stranger")
	testing.Println(yn(errors.Is(wrapped, stranger)))         // 0

	// Is involving an empty @Error is false either way.
	var none @errors.Error
	testing.Println(yn(errors.Is(none, sentinel)))            // 0
	testing.Println(yn(errors.Is(sentinel, none)))            // 0
}
