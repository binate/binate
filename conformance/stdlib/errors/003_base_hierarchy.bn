package "main"
import "pkg/builtins/testing"

// The errors base-failure lineage through the injected errors package: each
// child roots in its parent base via errors.Is, the axes are disjoint, Rooted
// renders its own message, and a Wrap of a base classifies as the base (and its
// ancestors).  Stdlib conformance suite.
import "pkg/std/errors"

func eq(got @[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}
func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// Lineage: each child roots in its parent base; a base is itself.
	testing.Println(yn(errors.Is(errors.Unimplemented, errors.Unsupported)))      // 1
	testing.Println(yn(errors.Is(errors.NotFound, errors.ConditionsUnmet)))       // 1
	testing.Println(yn(errors.Is(errors.AlreadyExists, errors.ConditionsUnmet)))  // 1
	testing.Println(yn(errors.Is(errors.OutOfRange, errors.ConditionsUnmet)))     // 1
	testing.Println(yn(errors.Is(errors.BadData, errors.ConditionsUnmet)))        // 1
	testing.Println(yn(errors.Is(errors.ResourceExhausted, errors.Retryable)))    // 1
	testing.Println(yn(errors.Is(errors.RateLimited, errors.Retryable)))          // 1
	testing.Println(yn(errors.Is(errors.Unavailable, errors.Retryable)))          // 1
	testing.Println(yn(errors.Is(errors.NotFound, errors.NotFound)))              // 1

	// Disjoint axes / one-directional ancestry.
	testing.Println(yn(errors.Is(errors.ConditionsUnmet, errors.NotFound)))       // 0
	testing.Println(yn(errors.Is(errors.NotFound, errors.Retryable)))             // 0
	testing.Println(yn(errors.Is(errors.InvalidArgument, errors.ConditionsUnmet)))// 0
	testing.Println(yn(errors.Is(errors.Unimplemented, errors.ConditionsUnmet)))  // 0

	// Rooted renders its own message (no parent leak).
	testing.Println(yn(eq(errors.NotFound.Error(), "not found")))                 // 1
	testing.Println(yn(eq(errors.ConditionsUnmet.Error(), "conditions unmet")))   // 1

	// Wrap of a base: classifies as the base + ancestors, renders "ctx: base".
	var e @errors.Error = errors.Wrap(errors.NotFound, "open /etc/foo")
	testing.Println(yn(errors.Is(e, errors.NotFound)))                            // 1
	testing.Println(yn(errors.Is(e, errors.ConditionsUnmet)))                     // 1
	testing.Println(yn(errors.Is(e, errors.AlreadyExists)))                       // 0
	testing.Println(yn(eq(e.Error(), "open /etc/foo: not found")))                // 1
}
