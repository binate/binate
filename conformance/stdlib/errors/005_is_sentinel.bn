package "main"
import "pkg/builtins/testing"

// Spec + regression for errors.Is — the sentinel test built on `same`
// (reference identity) walking the mandatory Unwrap() chain.  Is finds a
// sentinel even when it has been wrapped with context, and compares identity
// (not the message), so two distinct errors with the same text are not Is.

import "pkg/std/errors"

func main() {
	var sentinel @errors.Error = errors.New("sentinel")
	var wrapped @errors.Error = errors.Wrap(sentinel, "while reading")
	var deep @errors.Error = errors.Wrap(wrapped, "in handler")
	var other @errors.Error = errors.New("other")

	// An error is itself.
	if errors.Is(sentinel, sentinel) { testing.Println(1) } else { testing.Println(0) }
	// Found through one wrap, and through two.
	if errors.Is(wrapped, sentinel) { testing.Println(1) } else { testing.Println(0) }
	if errors.Is(deep, sentinel) { testing.Println(1) } else { testing.Println(0) }
	// A distinct error is not the sentinel...
	if errors.Is(other, sentinel) { testing.Println(1) } else { testing.Println(0) }
	// ...and a target absent from the chain is not found.
	if errors.Is(wrapped, other) { testing.Println(1) } else { testing.Println(0) }
}
