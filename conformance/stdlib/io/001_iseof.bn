package "main"
import "pkg/builtins/testing"

// Spec + regression for io.IsEOF — `errors.Is(err, io.EOF)` built on
// `same`.  IsEOF is true for the EOF sentinel, true even when EOF has been
// wrapped with context, and false for any other error or the empty error.

import "pkg/std/io"
import "pkg/std/errors"

func main() {
	// The EOF sentinel is EOF.
	if io.IsEOF(io.EOF) { testing.Println(1) } else { testing.Println(0) }
	// A distinct error is not EOF (identity, not message).
	var other @errors.Error = errors.New("nope")
	if io.IsEOF(other) { testing.Println(1) } else { testing.Println(0) }
	// EOF wrapped with context is still detected as EOF (chain walk).
	var wrapped @errors.Error = errors.Wrap(io.EOF, "reading header")
	if io.IsEOF(wrapped) { testing.Println(1) } else { testing.Println(0) }
	// The empty error (no error) is not EOF.
	var none @errors.Error
	if io.IsEOF(none) { testing.Println(1) } else { testing.Println(0) }
}
