package "main"

// math classification + rounding through the injected math package (floats
// across the marshaling boundary): Float64bits round-trip, Abs/Signbit/Copysign,
// NaN/Inf predicates, Floor/Ceil/Trunc/Round.  Each line is a true predicate.
// Stdlib conformance suite.
import "pkg/std/math"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	println(yn(math.Float64frombits(math.Float64bits(3.5)) == 3.5))
	println(yn(math.Abs(cast(float64, 0) - 3.5) == 3.5))
	println(yn(math.Signbit(cast(float64, 0) - 1.0)))
	println(yn(!math.Signbit(1.0)))
	println(yn(math.Copysign(3.0, cast(float64, 0) - 1.0) == cast(float64, 0) - 3.0))
	println(yn(math.IsNaN(math.NaN())))
	println(yn(!math.IsNaN(1.0)))
	println(yn(math.IsInf(math.Inf(1), 1)))
	println(yn(math.IsInf(math.Inf(cast(int, 0) - 1), cast(int, 0) - 1)))
	println(yn(math.Floor(3.7) == 3.0))
	println(yn(math.Floor(cast(float64, 0) - 3.2) == cast(float64, 0) - 4.0))
	println(yn(math.Ceil(3.2) == 4.0))
	println(yn(math.Trunc(cast(float64, 0) - 3.7) == cast(float64, 0) - 3.0))
	println(yn(math.Round(2.5) == 3.0))
	println(yn(math.Round(cast(float64, 0) - 2.5) == cast(float64, 0) - 3.0))
}
