package "main"
import "pkg/builtins/testing"

// math roots/powers/trig + constants through the injected math package: exact
// results (perfect squares, integer powers, Hypot 3-4-5, trig at 0) and the
// Pi/E/Sqrt2 constants crossing the boundary intact.  Stdlib conformance suite.
import "pkg/std/math"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	testing.Println(yn(math.Sqrt(4.0) == 2.0))
	testing.Println(yn(math.Sqrt(9.0) == 3.0))
	testing.Println(yn(math.Sqrt(2.0) == math.Sqrt2))
	testing.Println(yn(math.Cbrt(27.0) == 3.0))
	testing.Println(yn(math.Pow(2.0, 10.0) == 1024.0))
	testing.Println(yn(math.Pow(2.0, cast(float64, 0) - 1.0) == 0.5))
	testing.Println(yn(math.Pow(5.0, 0.0) == 1.0))
	testing.Println(yn(math.Hypot(3.0, 4.0) == 5.0))
	testing.Println(yn(math.Sin(0.0) == 0.0))
	testing.Println(yn(math.Cos(0.0) == 1.0))
	testing.Println(yn(math.Tanh(0.0) == 0.0))
	testing.Println(yn(math.Pi == 3.141592653589793))
	testing.Println(yn(math.E == 2.718281828459045))
}
