package "main"

// Cross-mode 64-bit SCALAR returns on a 32-bit VM host.  A native-injected math
// function returning a bare uint64 / float64 must carry the FULL 64-bit value
// back across the shim boundary (r0:r1), not just the low word: on ILP32 the
// return rides the wide _call_shim_scalar64 primitive, split into the caller's
// register pair.  A low-word-only truncation (the pre-fix bug) would misprint
// every value whose high 32 bits are significant.  Values are chosen with a
// NONZERO low word (Float64bits(3.7)) as well as a zero low word
// (Float64bits(1.0)), and a sign-bit-set value, so the test catches truncation
// in either half.  Stdlib conformance suite.
import "pkg/std/math"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// uint64 return (Float64bits): exact bit patterns, high and low words both
	// significant across the three cases.
	println(math.Float64bits(1.0))                    // low word 0
	println(math.Float64bits(3.7))                    // nonzero low word
	println(math.Float64bits(cast(float64, 0) - 2.0)) // sign bit set (high word)
	// float64 return (Floor / Trunc): printed to 6 decimals.
	println(math.Floor(3.7))
	println(math.Trunc(cast(float64, 0) - 3.9))
	// Round-trips through both directions (uint64 out of Float64bits, uint64
	// into Float64frombits): the full 64 bits must survive.
	println(yn(math.Float64frombits(math.Float64bits(3.7)) == 3.7))
	println(yn(math.Float64frombits(math.Float64bits(cast(float64, 0) - 2.0)) ==
		cast(float64, 0) - 2.0))
}
