package "main"

// math/big Nat arithmetic through the injected package — managed @Nat values
// (refcounted) crossing the boundary, multi-limb Add/Sub/Mul that cross the
// 32-bit limb seam, verified via ToUint64/BitLen/Cmp.  Stdlib conformance suite.
import "pkg/std/math/big"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// Add across the limb boundary: 0xFFFFFFFF + 1 = 0x100000000.
	var add @big.Nat = big.New().Add(
		big.FromUint64(cast(uint64, 4294967295)), big.FromUint64(cast(uint64, 1)))
	println(yn(add.ToUint64() == (cast(uint64, 1) << 32)))            // 1
	println(yn(add.BitLen() == 33))                                  // 1
	// Sub borrow across the boundary: 0x100000000 - 1 = 0xFFFFFFFF.
	var sub @big.Nat = big.New().Sub(
		big.FromUint64(cast(uint64, 1) << 32), big.FromUint64(cast(uint64, 1)))
	println(yn(sub.ToUint64() == cast(uint64, 4294967295)))          // 1
	// Mul: 0x100000000 * 2 = 0x200000000.
	var mul @big.Nat = big.New().Mul(
		big.FromUint64(cast(uint64, 1) << 32), big.FromUint64(cast(uint64, 2)))
	println(yn(mul.ToUint64() == (cast(uint64, 1) << 33)))           // 1
	// Cmp.
	println(yn(big.FromUint64(cast(uint64, 5)).Cmp(big.FromUint64(cast(uint64, 7))) < 0))   // 1
	println(yn(big.FromUint64(cast(uint64, 7)).Cmp(big.FromUint64(cast(uint64, 7))) == 0))  // 1
}
