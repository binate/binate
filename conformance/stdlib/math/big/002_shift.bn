package "main"

// math/big Nat shifts through the injected package: Shl/Shr across the 32-bit
// word boundary, BitLen, shift-to-zero.  Stdlib conformance suite.
import "pkg/std/math/big"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	println(yn(big.New().Shl(big.FromUint64(cast(uint64, 1)), 5).ToUint64() == cast(uint64, 32)))
	println(yn(big.New().Shl(big.FromUint64(cast(uint64, 1)), 32).ToUint64() == (cast(uint64, 1) << 32)))
	println(yn(big.New().Shl(big.FromUint64(cast(uint64, 1)), 32).BitLen() == 33))
	println(yn(big.New().Shr(big.FromUint64(cast(uint64, 32)), 5).ToUint64() == cast(uint64, 1)))
	println(yn(big.New().Shr(big.FromUint64(cast(uint64, 1) << 32), 32).ToUint64() == cast(uint64, 1)))
	println(yn(big.New().Shr(big.FromUint64(cast(uint64, 5)), 64).IsZero()))
}
