package "main"
import "pkg/builtins/testing"

// math/big Nat division through the injected package — the multi-return
// DivModUint32 / DivMod (@Nat quotient + remainder crossing the boundary).
// 1000 / 7 = 142 remainder 6.  Stdlib conformance suite.
import "pkg/std/math/big"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var q @big.Nat = big.New()
	var r uint32
	q, r = q.DivModUint32(big.FromUint64(cast(uint64, 1000)), cast(uint32, 7))
	testing.Println(yn(q.ToUint64() == cast(uint64, 142)))                   // 1
	testing.Println(yn(r == cast(uint32, 6)))                                // 1

	var z @big.Nat = big.New()
	var rr @big.Nat = big.New()
	z, rr = z.DivMod(big.FromUint64(cast(uint64, 1000)),
		big.FromUint64(cast(uint64, 7)), rr)
	testing.Println(yn(z.ToUint64() == cast(uint64, 142)))                   // 1
	testing.Println(yn(rr.ToUint64() == cast(uint64, 6)))                    // 1
}
