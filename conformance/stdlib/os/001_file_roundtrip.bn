package "main"

// End-to-end os file I/O through the INJECTED compiled os package (native-only
// injected under the int modes; all-native under builder-comp).  Create/Write/
// Open/Read/Close all __c_call directly, so they are skipped from VM lowering
// and dispatch to the injected native impl — exercising the cross-mode boundary
// from a real `main` (not a stdlib unit test).  Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

func main() {
	var f @os.File
	var err @errors.Error
	f, err = os.Create("/tmp/binate_conf_stdlib_os_roundtrip")
	if present(err) { println(-1); return }
	var n int
	n, err = f.Write("hello world")
	if present(err) { println(-2); return }
	println(n)                          // 11
	if present(f.Close()) { println(-3); return }

	var g @os.File
	g, err = os.Open("/tmp/binate_conf_stdlib_os_roundtrip")
	if present(err) { println(-4); return }
	var buf @[]uint8 = make_slice(uint8, 16)
	var m int
	m, err = g.Read(buf[0:16])
	if present(err) { println(-5); return }
	println(m)                          // 11
	println(cast(int, buf[0]))          // 'h' = 104
	if present(g.Close()) { println(-6); return }
}
