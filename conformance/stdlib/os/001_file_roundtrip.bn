package "main"
import "pkg/builtins/testing"

// End-to-end os file I/O through the INJECTED compiled os package (native-only
// injected under the int modes; all-native under builder-comp).  Create/Write/
// Open/Read/Close all __c_call directly, so they are skipped from VM lowering
// and dispatch to the injected native impl — exercising the cross-mode boundary
// from a real `main` (not a stdlib unit test).  Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	// A private directory, so concurrent runs never share a path; removed on exit.
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_conf_os_")
	if present(derr) { testing.Println(-100); return }
	defer os.RemoveAll(dir)
	var f @os.File
	var err @errors.Error
	f, err = os.Create(join(dir, "roundtrip"))
	if present(err) { testing.Println(-1); return }
	var n int
	n, err = f.Write("hello world")
	if present(err) { testing.Println(-2); return }
	testing.Println(n)                          // 11
	if present(f.Close()) { testing.Println(-3); return }

	var g @os.File
	g, err = os.Open(join(dir, "roundtrip"))
	if present(err) { testing.Println(-4); return }
	var buf @[]uint8 = make_slice(uint8, 16)
	var m int
	m, err = g.Read(buf[0:16])
	if present(err) { testing.Println(-5); return }
	testing.Println(m)                          // 11
	testing.Println(cast(int, buf[0]))          // 'h' = 104
	if present(g.Close()) { testing.Println(-6); return }
}
