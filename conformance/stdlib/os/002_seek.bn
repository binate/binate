package "main"

// os.Seek through the injected os package.  os is injected wholesale — under the
// INT modes it loads interface-only (its `.bn` is not lowered), so os.Seek and
// its unexported off64_t wrapper cLseek (a native-only __c_call helper) are both
// served by the native injected instance, exactly as under builder-comp.  A raw
// __c_call in USER code stays a permanent VM-FFI non-goal (rejected at the
// frontend under interpretation — see spec/16-packages/092_ccall_basic), but a
// stdlib package that SUPPLIES injection has its whole surface served natively.
import "pkg/std/os"
import "pkg/std/errors"

func main() {
	var f @os.File
	var err @errors.Error
	f, err = os.Create("/tmp/binate_conf_stdlib_os_seek")
	if present(err) { println(-1); return }
	var nw int
	nw, err = f.Write("hello world")
	if present(err) { println(-2); return }
	if present(f.Close()) { println(-3); return }

	var g @os.File
	g, err = os.Open("/tmp/binate_conf_stdlib_os_seek")
	if present(err) { println(-4); return }
	var pos int64
	pos, err = g.Seek(cast(int64, 6), os.SeekStart)
	if present(err) { println(-5); return }
	println(cast(int, pos))             // 6
	var buf @[]uint8 = make_slice(uint8, 8)
	var m int
	m, err = g.Read(buf[0:8])
	if present(err) { println(-6); return }
	println(m)                          // 5
	println(cast(int, buf[0]))          // 'w' = 119
	if present(g.Close()) { println(-7); return }
}
