package "main"
import "pkg/builtins/testing"

// os.Seek through the injected os package.  os is injected wholesale — under the
// INT modes it loads interface-only (its `.bn` is not lowered), so os.Seek and
// its unexported off64_t wrapper cLseek (a native-only __c_call helper) are both
// served by the native injected instance, exactly as under builder-comp.  A raw
// __c_call in USER code stays a permanent VM-FFI non-goal (rejected at the
// frontend under interpretation — see spec/16-packages/092_ccall_basic), but a
// stdlib package that SUPPLIES injection has its whole surface served natively.
import "pkg/std/os"
import "pkg/std/errors"

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	// A private directory, so concurrent runs never share a path; removed on exit.
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_conf_os_")
	if present(derr) { testing.Println(-100); return }
	defer os.RemoveAll(dir)
	var f @os.File
	var err @errors.Error
	f, err = os.Create(join(dir, "seek"))
	if present(err) { testing.Println(-1); return }
	var nw int
	nw, err = f.Write("hello world")
	if present(err) { testing.Println(-2); return }
	if present(f.Close()) { testing.Println(-3); return }

	var g @os.File
	g, err = os.Open(join(dir, "seek"))
	if present(err) { testing.Println(-4); return }
	var pos int64
	pos, err = g.Seek(cast(int64, 6), os.SeekStart)
	if present(err) { testing.Println(-5); return }
	testing.Println(cast(int, pos))             // 6
	var buf @[]uint8 = make_slice(uint8, 8)
	var m int
	m, err = g.Read(buf[0:8])
	if present(err) { testing.Println(-6); return }
	testing.Println(m)                          // 5
	testing.Println(cast(int, buf[0]))          // 'w' = 119
	if present(g.Close()) { testing.Println(-7); return }
}
