package "main"

// os.Seek through the injected os package.  Under builder-comp (all-native) this
// passes.  Under the INT modes it currently ABORTS — `vm: extern not found:
// pkg/std/os.cLseek` — because os.Seek has no DIRECT __c_call (it routes through
// the unexported wrapper cLseek for the arm32 off64_t variant), so funcHasCCall
// misses it and os.Seek is LOWERED to bytecode, shadowing the injected native
// Seek; the lowered bytecode then can't reach the native-only cLseek.  Unlike a
// raw __c_call in user code (a permanent VM-FFI non-goal — see spec/16-packages/
// 092_ccall_basic), os SUPPLIES injection, so Seek SHOULD be served by it.  The
// fix is to make the lowering-skip transitive so Seek/ReadAt/WriteAt are
// injected, not lowered.  Tracked in claude-todo.md.  xfail'd on the int modes.
import "pkg/std/os"
import "pkg/std/errors"

func main() {
	var f @os.File
	var err @errors.Error
	f, err = os.Create("/tmp/binate_conf_stdlib_os_seek")
	if present(err) { println(-1); return }
	var nw int
	nw, err = f.Write("hello world")
	if present(err) { println(-2); return }
	if present(f.Close()) { println(-3); return }

	var g @os.File
	g, err = os.Open("/tmp/binate_conf_stdlib_os_seek")
	if present(err) { println(-4); return }
	var pos int64
	pos, err = g.Seek(cast(int64, 6), os.SeekStart)
	if present(err) { println(-5); return }
	println(cast(int, pos))             // 6
	var buf @[]uint8 = make_slice(uint8, 8)
	var m int
	m, err = g.Read(buf[0:8])
	if present(err) { println(-6); return }
	println(m)                          // 5
	println(cast(int, buf[0]))          // 'w' = 119
	if present(g.Close()) { println(-7); return }
}
