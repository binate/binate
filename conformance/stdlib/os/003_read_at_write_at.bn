package "main"

// os.WriteAt / os.ReadAt through the injected os package — the offset-bearing
// calls route through the unexported cPwrite/cPread wrappers (the same family as
// cLseek, which used to break under int before os was injected wholesale).
// Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

func main() {
	var f @os.File
	var err @errors.Error
	f, err = os.Create("/tmp/binate_conf_stdlib_os_readat")
	if present(err) { println(-1); return }
	var n int
	n, err = f.WriteAt("hello ", cast(int64, 0))
	if present(err) { println(-2); return }
	n, err = f.WriteAt("world", cast(int64, 6))
	if present(err) { println(-3); return }
	if present(f.Close()) { println(-4); return }

	var g @os.File
	g, err = os.Open("/tmp/binate_conf_stdlib_os_readat")
	if present(err) { println(-5); return }
	var buf @[]uint8 = make_slice(uint8, 5)
	var m int
	m, err = g.ReadAt(buf[0:5], cast(int64, 6))
	if present(err) { println(-6); return }
	println(m)                          // 5
	println(cast(int, buf[0]))          // 'w' = 119
	println(cast(int, buf[4]))          // 'd' = 100
	if present(g.Close()) { println(-7); return }
}
