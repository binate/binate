package "main"
import "pkg/builtins/testing"

// os.WriteAt / os.ReadAt through the injected os package — the offset-bearing
// calls route through the unexported cPwrite/cPread wrappers (the same family as
// cLseek, which used to break under int before os was injected wholesale).
// Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	// A private directory, so concurrent runs never share a path; removed on exit.
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_conf_os_")
	if present(derr) { testing.Println(-100); return }
	defer os.RemoveAll(dir)
	var f @os.File
	var err @errors.Error
	f, err = os.Create(join(dir, "readat"))
	if present(err) { testing.Println(-1); return }
	var n int
	n, err = f.WriteAt("hello ", cast(int64, 0))
	if present(err) { testing.Println(-2); return }
	n, err = f.WriteAt("world", cast(int64, 6))
	if present(err) { testing.Println(-3); return }
	if present(f.Close()) { testing.Println(-4); return }

	var g @os.File
	g, err = os.Open(join(dir, "readat"))
	if present(err) { testing.Println(-5); return }
	var buf @[]uint8 = make_slice(uint8, 5)
	var m int
	m, err = g.ReadAt(buf[0:5], cast(int64, 6))
	if present(err) { testing.Println(-6); return }
	testing.Println(m)                          // 5
	testing.Println(cast(int, buf[0]))          // 'w' = 119
	testing.Println(cast(int, buf[4]))          // 'd' = 100
	if present(g.Close()) { testing.Println(-7); return }
}
