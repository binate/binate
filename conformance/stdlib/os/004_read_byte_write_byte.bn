package "main"
import "pkg/builtins/testing"

// os File.WriteByte / File.ReadByte (io.ByteWriter / io.ByteReader) through the
// injected os package, with io.EOF at end of input.  Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"
import "pkg/std/io"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	// A private directory, so concurrent runs never share a path; removed on exit.
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_conf_os_")
	if present(derr) { testing.Println(-100); return }
	defer os.RemoveAll(dir)
	var f @os.File
	var err @errors.Error
	f, err = os.Create(join(dir, "bytes"))
	if present(err) { testing.Println(-1); return }
	if present(f.WriteByte(cast(uint8, cast(int, 'A')))) { testing.Println(-2); return }
	if present(f.WriteByte(cast(uint8, cast(int, 'B')))) { testing.Println(-3); return }
	if present(f.Close()) { testing.Println(-4); return }

	var g @os.File
	g, err = os.Open(join(dir, "bytes"))
	if present(err) { testing.Println(-5); return }
	var c uint8
	c, err = g.ReadByte()
	if present(err) { testing.Println(-6); return }
	testing.Println(cast(int, c))               // 'A' = 65
	c, err = g.ReadByte()
	if present(err) { testing.Println(-7); return }
	testing.Println(cast(int, c))               // 'B' = 66
	c, err = g.ReadByte()
	testing.Println(yn(io.IsEOF(err)))          // 1 (EOF at end of input)
	if present(g.Close()) { testing.Println(-8); return }
}
