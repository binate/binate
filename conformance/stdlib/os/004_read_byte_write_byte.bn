package "main"

// os File.WriteByte / File.ReadByte (io.ByteWriter / io.ByteReader) through the
// injected os package, with io.EOF at end of input.  Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"
import "pkg/std/io"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var f @os.File
	var err @errors.Error
	f, err = os.Create("/tmp/binate_conf_stdlib_os_bytes")
	if present(err) { println(-1); return }
	if present(f.WriteByte(cast(uint8, cast(int, 'A')))) { println(-2); return }
	if present(f.WriteByte(cast(uint8, cast(int, 'B')))) { println(-3); return }
	if present(f.Close()) { println(-4); return }

	var g @os.File
	g, err = os.Open("/tmp/binate_conf_stdlib_os_bytes")
	if present(err) { println(-5); return }
	var c uint8
	c, err = g.ReadByte()
	if present(err) { println(-6); return }
	println(cast(int, c))               // 'A' = 65
	c, err = g.ReadByte()
	if present(err) { println(-7); return }
	println(cast(int, c))               // 'B' = 66
	c, err = g.ReadByte()
	println(yn(io.IsEOF(err)))          // 1 (EOF at end of input)
	if present(g.Close()) { println(-8); return }
}
