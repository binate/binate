package "main"
import "pkg/builtins/testing"

// os.Exit terminates the program immediately: the print after it must not
// run, so the output is just "1".  Exit(0) is a clean exit.  With os injected,
// Exit reaches C exit via __c_call under the int modes too, terminating the VM
// process.  Stdlib conformance suite.
import "pkg/std/os"

func main() {
	testing.Println(1)
	os.Exit(0)
	testing.Println(2)
}
