package "main"
import "pkg/builtins/testing"

// End-to-end os.ReadDir through the INJECTED compiled os package, across all
// modes.  ReadDir has no direct __c_call in its signature — it reads the
// native struct dirent via direntType / direntName over opendir/readdir/
// closedir — so with os injected wholesale it dispatches to the native impl
// under the int modes and runs all-native under builder-comp.  The checks use
// only a fresh temporary directory holding a marker file the test creates, so
// they are deterministic regardless of what else is on the host (the DT_DIR / DT_LNK mapping is
// covered hermetically by the os unit tests and the readdir e2e).  Stdlib
// conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

// nameEq compares a DirEntry name against a literal.
func nameEq(a @[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	// A private directory, so concurrent runs never share a path; removed on exit.
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_conf_os_")
	if present(derr) { testing.Println(-100); return }
	defer os.RemoveAll(dir)
	// Create a marker regular file to look for in the listing.
	var f @os.File
	var err @errors.Error
	f, err = os.Create(join(dir, "readdir_marker"))
	if present(err) { testing.Println(-1); return }
	if present(f.Close()) { testing.Println(-2); return }

	// List the directory; find the marker and confirm "." / ".." are excluded.
	var ents @[]@os.DirEntry
	ents, err = os.ReadDir(dir)
	if present(err) { testing.Println(-3); return }
	var foundMarker int = 0
	var markerRegular int = 0
	var sawDot int = 0
	for i := 0; i < len(ents); i++ {
		var nm @[]readonly char = ents[i].Name()
		if nameEq(nm, "readdir_marker") {
			foundMarker = 1
			// Type() == 0 means exactly DT_REG was read (no type bit set).
			// This pins the per-platform d_type offset: a wrong offset would
			// read an adjacent byte that is not 8, yielding a nonzero type.
			markerRegular = yn(ents[i].Type() == cast(os.FileMode, 0))
		}
		if nameEq(nm, ".") { sawDot = 1 }
		if nameEq(nm, "..") { sawDot = 1 }
	}
	testing.Println(foundMarker)    // 1: the marker is listed (d_name read correctly)
	testing.Println(markerRegular)  // 1: its d_type read as exactly DT_REG
	testing.Println(sawDot)         // 0: "." and ".." are excluded

	// A nonexistent directory is an error, not an empty listing.
	var none @[]@os.DirEntry
	none, err = os.ReadDir(join(dir, "no_such_dir"))
	testing.Println(yn(present(err)))  // 1
	_ = none
}
