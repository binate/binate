package "main"
import "pkg/builtins/testing"

// Exported implicit-repeat iota consts (Go's `1 << iota` idiom) must keep their
// full value across the package boundary, not collapse to the bare iota
// ordinal: a member omitting its initializer (ModeAppend, ModeSymlink, ...) must
// export the repeated expression (1<<30, 1<<27, ...), not its iota index
// (1, 4, ...).  The .bni const-group export goes through
// check/bni_scope_const.bn (defineBniConst) and irgen/gen_import_const.bn
// (registerImportConstGroup).  Consts only — no syscall — so it runs on every
// target including bare metal.  Stdlib conformance suite.
import "pkg/std/os"

func eq(a int, b int) int {
	if a == b { return 1 }
	return 0
}

func main() {
	// Implicit-repeat members (the bug cases); values fit a 32-bit int.
	testing.Println(eq(cast(int, os.ModeAppend), 1073741824))    // 1<<30, iota=1
	testing.Println(eq(cast(int, os.ModeSymlink), 134217728))    // 1<<27, iota=4
	testing.Println(eq(cast(int, os.ModeCharDevice), 2097152))   // 1<<21, iota=10
	testing.Println(eq(cast(int, os.ModeIrregular), 524288))     // 1<<19, iota=12
	// An explicit-expression const (control — was always correct).
	testing.Println(eq(cast(int, os.ModePerm), 511))             // 0o777
}
