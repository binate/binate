package "main"

// Exported implicit-repeat iota consts (Go's `1 << iota` idiom) must keep their
// full value across the package boundary, not collapse to the bare iota
// ordinal.  Regression for the .bni const-group export bug: a member omitting
// its initializer (ModeAppend, ModeSymlink, ...) exported as its iota index
// (1, 4, ...) instead of the repeated expression (1<<30, 1<<27, ...).  Fixed in
// bni_scope.bn (defineBniConst / the DECL_GROUP loop) and gen_import.bn
// (registerImportConstGroup).  Consts only — no syscall — so it runs on every
// target including bare metal.  Stdlib conformance suite.
import "pkg/std/os"

func eq(a int, b int) int {
	if a == b { return 1 }
	return 0
}

func main() {
	// Implicit-repeat members (the bug cases); values fit a 32-bit int.
	println(eq(cast(int, os.ModeAppend), 1073741824))    // 1<<30, iota=1
	println(eq(cast(int, os.ModeSymlink), 134217728))    // 1<<27, iota=4
	println(eq(cast(int, os.ModeCharDevice), 2097152))   // 1<<21, iota=10
	println(eq(cast(int, os.ModeIrregular), 524288))     // 1<<19, iota=12
	// An explicit-expression const (control — was always correct).
	println(eq(cast(int, os.ModePerm), 511))             // 0o777
}
