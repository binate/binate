package "main"
import "pkg/builtins/testing"

// os.Stat / os.Lstat of a non-existent path must report an error (ENOENT), not
// silently succeed.  Regression for the c-call return-width bug: stat/lstat
// return a 32-bit C `int`, and reading -1 as the 64-bit binate `int` turned the
// failure into a large positive value on x86-64 (the upper return-register bits
// are unspecified for a sub-word C return), so `present(err)` was false and any
// caller — e.g. findStubsFile — wrongly treated a missing file as present.
// 003_stat covers only the success paths; this pins the error path.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var err @errors.Error

	// Stat of a path that does not exist -> error.
	_, err = os.Stat("/no/such/binate/conformance/path")
	testing.Println(yn(present(err))) // 1

	// Lstat of a non-existent path -> error.
	_, err = os.Lstat("/no/such/binate/conformance/path")
	testing.Println(yn(present(err))) // 1

	// Stat under a non-existent parent directory -> error.
	_, err = os.Stat("/no/such/binate/dir/then/a/file")
	testing.Println(yn(present(err))) // 1

	// Control: Stat of an existing directory -> no error.
	_, err = os.Stat("/tmp")
	testing.Println(yn(present(err))) // 0
}
