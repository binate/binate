package "main"
import "pkg/builtins/testing"

// End-to-end os.Stat / Lstat / File.Stat through the INJECTED compiled os
// package, across all modes.  Stat/Lstat/File.Stat have no direct __c_call —
// they read the native struct stat via statFd/statPath/lstatPath — so with os
// injected wholesale they dispatch to the native impl under the int modes and
// run all-native under builder-comp.  Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	// A private directory, so concurrent runs never share a path; removed on exit.
	var dir @[]char
	var derr @errors.Error
	dir, derr = os.MkdirTemp("/tmp", "binate_conf_os_")
	if present(derr) { testing.Println(-100); return }
	defer os.RemoveAll(dir)
	var f @os.File
	var err @errors.Error
	f, err = os.Create(join(dir, "binate_conf_stdlib_os_stat"))
	if present(err) { testing.Println(-1); return }
	var n int
	n, err = f.Write("hello world")
	if present(err) { testing.Println(-2); return }
	if present(f.Close()) { testing.Println(-3); return }

	// os.Stat on the regular file just written.
	var fi @os.FileInfo
	fi, err = os.Stat(join(dir, "binate_conf_stdlib_os_stat"))
	if present(err) { testing.Println(-4); return }
	testing.Println(cast(int, fi.Size()))                            // 11
	testing.Println(yn(fi.Mode().IsRegular()))                       // 1
	testing.Println(yn(fi.IsDir()))                                  // 0
	testing.Println(yn((cast(int, fi.Mode().Perm()) & 0o400) != 0))  // 1 (owner-readable)
	testing.Println(len(fi.Name()))                                  // 26 (base name length)

	// os.Stat on a directory.
	var di @os.FileInfo
	di, err = os.Stat("/tmp")
	if present(err) { testing.Println(-5); return }
	testing.Println(yn(di.IsDir()))                                  // 1

	// File.Stat via an open descriptor.
	var g @os.File
	g, err = os.Open(join(dir, "binate_conf_stdlib_os_stat"))
	if present(err) { testing.Println(-6); return }
	var gs @os.FileInfo
	gs, err = g.Stat()
	if present(err) { testing.Println(-7); return }
	testing.Println(cast(int, gs.Size()))                            // 11
	if present(g.Close()) { testing.Println(-8); return }

	// Lstat on a regular file equals Stat.
	var ls @os.FileInfo
	ls, err = os.Lstat(join(dir, "binate_conf_stdlib_os_stat"))
	if present(err) { testing.Println(-9); return }
	testing.Println(yn(ls.Mode().IsRegular()))                       // 1
	testing.Println(cast(int, ls.Size()))                            // 11
}
