package "main"
import "pkg/builtins/testing"

// os.FileInfo.ModTime() returns a time.Point (a cross-package by-value struct);
// chaining .ToUnix() on it yields the file's Unix seconds, which for /tmp must be
// > 0.  End-to-end exercise of the injected (native) time.Point {int64,int32}
// crossing the VM<->native boundary: the bytecode VM expands a cross-mode
// coerced-aggregate argument into its value words; passing the Point's ADDRESS
// where the shim expects its coerced [2 x i64] value makes the int64 seconds come
// back as a stack address.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var fi @os.FileInfo
	var err @errors.Error
	fi, err = os.Stat("/tmp")
	if present(err) {
		testing.Println(0 - 1)
		return
	}
	var sec int64
	var nsec int32
	sec, nsec = fi.ModTime().ToUnix()
	testing.Println(yn(sec > cast(int64, 0)))
}
