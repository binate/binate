package "main"
import "pkg/builtins/testing"

// os.FileInfo.ModTime() returns a time.Point (a cross-package by-value struct);
// chaining .ToUnix() on it yields the file's Unix seconds, which for /tmp must be
// > 0.  End-to-end exercise of the injected (native) time.Point {int64,int32}
// crossing the VM<->native boundary: previously the bytecode VM passed the Point's
// ADDRESS where the shim expected its coerced [2 x i64] value, so the int64
// seconds came back as a stack address (was xfail.builder-comp-int) — fixed by
// expanding a cross-mode coerced-aggregate argument into its value words.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var fi @os.FileInfo
	var err @errors.Error
	fi, err = os.Stat("/tmp")
	if present(err) {
		testing.Println(0 - 1)
		return
	}
	var sec int64
	var nsec int32
	sec, nsec = fi.ModTime().ToUnix()
	testing.Println(yn(sec > cast(int64, 0)))
}
