package "main"

// CODEGEN-BUG REPRO (xfail.all — does not compile yet).  Chaining a method onto
// the by-value struct result of a CROSS-PACKAGE method miscompiles:
// os.FileInfo.ModTime() returns time.Point (a cross-package struct), and calling
// .ToUnix() directly on that temporary emits invalid LLVM IR (`extractvalue` on
// a scalar i64), which the C backend rejects.  The idiomatic intermediate-var
// form (var mt = fi.ModTime(); mt.ToUnix()) compiles, as do same-package and
// free-function struct results — so os.FileInfo.ModTime is just the handy
// trigger; the bug is general.  Remove this xfail when the codegen is fixed.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var fi @os.FileInfo
	var err @errors.Error
	fi, err = os.Stat("/tmp")
	if present(err) {
		println(0 - 1)
		return
	}
	var sec int64
	var nsec int32
	sec, nsec = fi.ModTime().ToUnix()
	println(yn(sec > cast(int64, 0)))
}
