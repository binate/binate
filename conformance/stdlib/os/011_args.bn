package "main"

import "pkg/std/os"

// os.Args() with no program arguments: the result is a single element — the
// program-name slot at index 0 — so len is 1, with no argument elements
// following.  (This directly pins that no stray arguments leak in: under the
// interpreter os.Args() once wrongly returned the host bni's own argv.)
//
// What the slot HOLDS differs by mode: the real program name on a compiled hosted
// binary (the Binate entry captures argv[0]), an empty placeholder on baremetal
// (no command line), the program path under the interpreter (bni installs it via
// os.SetArgs) — so this checks only the mode-consistent length.  The
// with-arguments path, which the conformance runner cannot drive (it passes a
// program no arguments), is covered by e2e/os-args.sh.
func main() {
	var a @[]readonly @[]readonly char = os.Args()
	println(len(a))
}
