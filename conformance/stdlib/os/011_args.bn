package "main"

import "pkg/std/os"

// os.Args() with no program arguments: element 0 is the empty program-name
// placeholder (no mechanism captures argv[0] yet), so the length is 1 and that
// lone element is empty.  Exercises the fully-readonly cached-slice accessor
// cross-mode; the conformance runner passes no program arguments (and on a
// bare-metal target, which has no command line, the result is likewise the
// single placeholder).
func main() {
	var a @[]readonly @[]readonly char = os.Args()
	println(len(a))
	println(len(a[0]))
}
