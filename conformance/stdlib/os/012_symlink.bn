package "main"
import "pkg/builtins/testing"

// End-to-end os.Symlink with Lstat / Stat on a REAL symbolic link, through the
// injected compiled os package, across all modes: Lstat reports the link itself
// (ModeSymlink), Stat follows it to the file.  Runs in its own MkdirTemp
// directory.  Stdlib conformance suite.
import "pkg/std/os"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

func main() {
	var dir @[]char
	var err @errors.Error
	dir, err = os.MkdirTemp("/tmp", "binate_conf_symlink_")
	if present(err) { testing.Println(-1); return }
	var target @[]char = join(dir, "target")
	var link @[]char = join(dir, "link")
	var f @os.File
	f, err = os.Create(target)
	if present(err) { testing.Println(-2); return }
	_, err = f.Write("hello world")
	if present(err) { testing.Println(-3); return }
	if present(f.Close()) { testing.Println(-4); return }

	if present(os.Symlink(target, link)) { testing.Println(-5); return }
	var li @os.FileInfo
	li, err = os.Lstat(link)
	if present(err) { testing.Println(-6); return }
	testing.Println(yn((li.Mode() & os.ModeSymlink) != cast(os.FileMode, 0))) // 1: the link itself
	testing.Println(yn(li.Mode().IsRegular()))                                 // 0
	var si @os.FileInfo
	si, err = os.Stat(link)
	if present(err) { testing.Println(-7); return }
	testing.Println(yn(si.Mode().IsRegular())) // 1: Stat follows the link
	testing.Println(cast(int, si.Size()))      // 11

	err = os.Symlink(target, link)
	testing.Println(yn(present(err) && errors.Is(err, errors.AlreadyExists))) // 1

	if present(os.Remove(link)) || present(os.Remove(target)) || present(os.Remove(dir)) {
		testing.Println(-8)
		return
	}
	testing.Println("ok")
}
