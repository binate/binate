package "main"

import "pkg/builtins/testing"

import "pkg/std/errors"
import "pkg/std/os"

// End-to-end os.RemoveAll through the injected compiled os package, across all
// modes: a tree of files, nested and empty directories and a symbolic link to a
// directory outside it is removed without following the link (the outside
// directory and its file survive); a missing path is not an error.  The walk goes
// by directory fd (openat / unlinkat / fdopendir), whose flag values and symbols
// differ per OS and architecture.  Runs in its own MkdirTemp directory.  Stdlib
// conformance suite.

func yn(b bool) int {
	if b { return 1 }
	return 0
}

// join returns dir + "/" + name.
func join(dir *[]readonly char, name *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(dir) + 1 + len(name))
	for i := 0; i < len(dir); i++ { out[i] = dir[i] }
	out[len(dir)] = '/'
	for i := 0; i < len(name); i++ { out[len(dir) + 1 + i] = name[i] }
	return out
}

// writeFile creates path holding one byte, reporting success.
func writeFile(path *[]readonly char) bool {
	var f @os.File
	var err @errors.Error
	f, err = os.Create(path)
	if present(err) { return false }
	_, err = f.Write("x")
	if present(err) { return false }
	return !present(f.Close())
}

// gone reports whether path no longer exists.
func gone(path *[]readonly char) bool {
	var err @errors.Error
	_, err = os.Lstat(path)
	return present(err) && errors.Is(err, errors.NotFound)
}

func main() {
	var base @[]char
	var err @errors.Error
	base, err = os.MkdirTemp("/tmp", "binate_conf_removeall_")
	if present(err) { testing.Println(-1); return }
	var tree @[]char = join(base, "tree")
	var sub @[]char = join(tree, "sub")
	var outside @[]char = join(base, "outside")
	var ok bool = !present(os.MkdirAll(join(sub, "empty"), cast(os.FileMode, 0o755)))
	ok = ok && !present(os.Mkdir(outside, cast(os.FileMode, 0o755)))
	ok = ok && writeFile(join(tree, "a")) && writeFile(join(sub, "b")) &&
			writeFile(join(outside, "keep"))
	ok = ok && !present(os.Symlink(outside, join(tree, "link")))
	testing.Println(yn(ok))
	testing.Println(yn(!present(os.RemoveAll(tree))), yn(gone(tree)), yn(!gone(join(outside, "keep"))))
	testing.Println(yn(!present(os.RemoveAll(join(base, "missing")))))
	testing.Println(yn(!present(os.RemoveAll(base))), yn(gone(base)))
}
