package "main"

import "pkg/std/errors"
import "pkg/std/os/process"

// End-to-end pkg/std/os/process through the INJECTED compiled package: run
// /usr/bin/true and /usr/bin/false to completion, a PATH-searched run, and a
// not-found start error.  process fork/execve/waitpid via __c_call are skipped
// from VM lowering and dispatch to the injected native impl under the int modes,
// all-native under builder-comp — exercising the cross-mode boundary and the
// wait-status decoder on both Linux and macOS.  Stdlib conformance suite.

func main() {
	var st process.ExitStatus
	var err @errors.Error

	// A clean exit: /usr/bin/true succeeds.
	st, err = process.Run("/usr/bin/true", &process.Options{})
	if present(err) { println(-1); return }
	if st.Success() { println(1) } else { println(0) } // 1

	// A non-zero exit is NOT an error; /usr/bin/false exits 1.
	st, err = process.Run("/usr/bin/false", &process.Options{})
	if present(err) { println(-2); return }
	println(st.Code()) // 1

	// A PATH-searched run resolves `true` along PATH.
	st, err = process.RunArgsPath("true")
	if present(err) { println(-3); return }
	if st.Success() { println(1) } else { println(0) } // 1

	// A missing program is a could-not-start error, classified NotFound.
	st, err = process.Run("/nonexistent/binate/prog", &process.Options{})
	if !present(err) { println(-4); return }
	if errors.Is(err, errors.NotFound) { println(1) } else { println(0) } // 1
}
