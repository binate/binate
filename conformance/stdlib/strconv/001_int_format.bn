package "main"
import "pkg/builtins/testing"

// strconv integer formatting through the injected strconv: Itoa / FormatInt /
// FormatUint (bases, INT64_MIN, UINT64_MAX) / FormatBool.  Stdlib conformance.
import "pkg/std/strconv"

func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}
func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var minI64 int64 = (cast(int64, 0) - 9223372036854775807) - 1
	var maxU64 uint64 = cast(uint64, 0) - cast(uint64, 1)
	testing.Println(yn(streq(strconv.Itoa(cast(int, 0) - 42), "-42")))                 // 1
	testing.Println(yn(streq(strconv.Itoa(1000000), "1000000")))                       // 1
	testing.Println(yn(streq(strconv.FormatInt(minI64, 10), "-9223372036854775808")))  // 1
	testing.Println(yn(streq(strconv.FormatInt(cast(int64, 0) - 255, 16), "-ff")))      // 1
	testing.Println(yn(streq(strconv.FormatUint(cast(uint64, 42), 10), "42")))          // 1
	testing.Println(yn(streq(strconv.FormatUint(cast(uint64, 255), 16), "ff")))         // 1
	testing.Println(yn(streq(strconv.FormatUint(cast(uint64, 5), 2), "101")))           // 1
	testing.Println(yn(streq(strconv.FormatUint(cast(uint64, 35), 36), "z")))           // 1
	testing.Println(yn(streq(strconv.FormatUint(maxU64, 10), "18446744073709551615")))  // 1
	testing.Println(yn(streq(strconv.FormatBool(true), "true")))                        // 1
	testing.Println(yn(streq(strconv.FormatBool(false), "false")))                      // 1
}
