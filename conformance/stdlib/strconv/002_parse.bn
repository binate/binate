package "main"
import "pkg/builtins/testing"

// strconv parsing through the injected strconv: ParseUint / ParseInt (bases,
// 0x/0o/0b prefixes, underscores, sign, range saturation), Atoi, ParseBool.
// Prints parsed values + a 0/1 error flag.  Stdlib conformance.
import "pkg/std/strconv"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var u uint64
	var i int64
	var n int
	var b bool
	var err @errors.Error

	u, err = strconv.ParseUint("42", 10, 64);    testing.Println(cast(int, u))    // 42
	u, err = strconv.ParseUint("ff", 16, 64);    testing.Println(cast(int, u))    // 255
	u, err = strconv.ParseUint("0x10", 0, 64);   testing.Println(cast(int, u))    // 16
	u, err = strconv.ParseUint("0o17", 0, 64);   testing.Println(cast(int, u))    // 15
	u, err = strconv.ParseUint("0b101", 0, 64);  testing.Println(cast(int, u))    // 5
	u, err = strconv.ParseUint("0x_ff", 0, 64);  testing.Println(cast(int, u))    // 255
	u, err = strconv.ParseUint("-5", 10, 64);    testing.Println(yn(present(err)))// 1 (syntax)
	u, err = strconv.ParseUint("300", 10, 8);    testing.Println(cast(int, u))    // 255 (range saturate)
	testing.Println(yn(present(err)))                                             // 1 (range)

	i, err = strconv.ParseInt("-42", 10, 64);    testing.Println(cast(int, i))    // -42
	i, err = strconv.ParseInt("-0x10", 0, 64);   testing.Println(cast(int, i))    // -16
	i, err = strconv.ParseInt("+0x10", 0, 64);   testing.Println(cast(int, i))    // 16

	n, err = strconv.Atoi("42");                 testing.Println(n)               // 42
	n, err = strconv.Atoi("-7");                 testing.Println(n)               // -7
	n, err = strconv.Atoi("x");                  testing.Println(yn(present(err)))// 1

	b, err = strconv.ParseBool("TRUE");          testing.Println(yn(b))           // 1
	b, err = strconv.ParseBool("f");             testing.Println(yn(b))           // 0
	b, err = strconv.ParseBool("x");             testing.Println(yn(present(err)))// 1
}
