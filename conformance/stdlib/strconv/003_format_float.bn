package "main"

// strconv.FormatFloat through the injected strconv — the float-across-the-shim
// cross-mode stressor: shortest 'g', 'e'/'f', NaN/±Inf/-0 specials, and f32.
// Stdlib conformance suite.
import "pkg/std/strconv"

func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}
func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	// shortest 'g'
	println(yn(streq(strconv.FormatFloat(1.0, 'g', -1, 64), "1")))
	println(yn(streq(strconv.FormatFloat(0.5, 'g', -1, 64), "0.5")))
	println(yn(streq(strconv.FormatFloat(0.1, 'g', -1, 64), "0.1")))
	println(yn(streq(strconv.FormatFloat(100.0, 'g', -1, 64), "100")))
	println(yn(streq(strconv.FormatFloat(3.141592653589793, 'g', -1, 64), "3.141592653589793")))
	println(yn(streq(strconv.FormatFloat(cast(float64, 0) - 2.5, 'g', -1, 64), "-2.5")))
	println(yn(streq(strconv.FormatFloat(1e21, 'g', -1, 64), "1e+21")))
	println(yn(streq(strconv.FormatFloat(1e-5, 'g', -1, 64), "1e-05")))
	println(yn(streq(strconv.FormatFloat(1e-4, 'g', -1, 64), "0.0001")))
	// 'e' and 'f'
	println(yn(streq(strconv.FormatFloat(1.0, 'e', -1, 64), "1e+00")))
	println(yn(streq(strconv.FormatFloat(0.5, 'e', -1, 64), "5e-01")))
	println(yn(streq(strconv.FormatFloat(1234.5, 'f', -1, 64), "1234.5")))
	// NaN / +Inf / -Inf / -0 specials
	println(yn(streq(strconv.FormatFloat(bit_cast(float64, cast(uint64, 0x7FF8000000000000)), 'g', -1, 64), "NaN")))
	println(yn(streq(strconv.FormatFloat(bit_cast(float64, cast(uint64, 0x7FF0000000000000)), 'g', -1, 64), "+Inf")))
	println(yn(streq(strconv.FormatFloat(bit_cast(float64, cast(uint64, 0xFFF0000000000000)), 'g', -1, 64), "-Inf")))
	println(yn(streq(strconv.FormatFloat(bit_cast(float64, cast(uint64, 1) << 63), 'g', -1, 64), "-0")))
	// f32 shortest
	println(yn(streq(strconv.FormatFloat(0.1, 'g', -1, 32), "0.1")))
}
