package "main"
import "pkg/builtins/testing"

// Cross-package consumer for the strconv Parse* family (the inverse of
// 528's Format* coverage): exercises ParseInt/ParseUint/ParseBool/Atoi and
// both error paths (range saturation + syntax) through the real
// import-and-call surface, with the @errors.Error returned as the failure
// channel (tested via present()).

import "pkg/std/strconv"
import "pkg/std/errors"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var i int64
	var u uint64
	var b bool
	var n int
	var err @errors.Error

	i, err = strconv.ParseInt("-42", 10, 64)
	testing.Println(yn(present(err))) // 0
	testing.Println(cast(int, i))     // -42

	u, err = strconv.ParseUint("ff", 16, 64)
	testing.Println(yn(present(err))) // 0
	testing.Println(cast(int, u))     // 255

	b, err = strconv.ParseBool("true")
	testing.Println(yn(present(err))) // 0
	testing.Println(yn(b))            // 1

	n, err = strconv.Atoi("100")
	testing.Println(yn(present(err))) // 0
	testing.Println(n)                // 100

	// Out of range for int8: value saturates to 127, error present.
	i, err = strconv.ParseInt("256", 10, 8)
	testing.Println(yn(present(err))) // 1
	testing.Println(cast(int, i))     // 127

	// Syntax error: Atoi of non-numeric input → present error, 0 value.
	n, err = strconv.Atoi("xyz")
	testing.Println(yn(present(err))) // 1
	testing.Println(n)                // 0

	// ParseFloat: an exactly-representable value, then the overflow path.
	var f float64
	f, err = strconv.ParseFloat("0.5", 64)
	testing.Println(yn(present(err))) // 0
	testing.Println(yn(f == 0.5))     // 1
	f, err = strconv.ParseFloat("1e400", 64)
	testing.Println(yn(present(err))) // 1  (overflow is a range error)
	testing.Println(yn(f > 1e308))    // 1  (+Inf)

	// Hex float: 0x1.8p3 = 1.5 * 2^3 = 12.
	f, err = strconv.ParseFloat("0x1.8p3", 64)
	testing.Println(yn(present(err))) // 0
	testing.Println(yn(f == 12.0))    // 1
}
