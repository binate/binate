package "main"
import "pkg/builtins/testing"

// Cross-package consumer of the first stdlib package: a separate
// `main` translation unit imports pkg/std/strconv and exercises both
// families — the allocating Format* and the in-place Append*.  Proves
// the consumer import path + cross-TU link for ifaces/stdlib +
// impls/stdlib end-to-end, beyond strconv's own in-package
// unit tests (which call it from the same package).
import "pkg/std/strconv"

func main() {
	testing.Println(strconv.FormatInt(cast(int64, 0) - cast(int64, 42), 10))
	testing.Println(strconv.FormatUint(cast(uint64, 255), 16))
	testing.Println(strconv.FormatBool(true))
	var buf @[]char = make_slice(char, 16)
	var n int = strconv.AppendInt(buf[0:16], 0, cast(int64, 12345), 10)
	testing.Println(buf[0:n])
}
