package "main"

// strings.Builder direct API through the injected strings package: WriteByte,
// Write, Len, String content, Reset.  (726_cross_pkg_iface_impl covers *Builder
// via io.Writer/io.ByteWriter.)  Stdlib conformance suite.
import "pkg/std/strings"
import "pkg/std/errors"

func sEq(got *[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ { if got[i] != want[i] { return false } }
	return true
}
func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var b @strings.Builder = strings.NewBuilder()
	println(b.Len())                                       // 0
	println(yn(sEq(b.String(), "")))                       // 1
	b.WriteByte(cast(uint8, cast(int, 'h')))
	b.WriteByte(cast(uint8, cast(int, 'i')))
	println(b.Len())                                       // 2
	println(yn(sEq(b.String(), "hi")))                     // 1
	var n int
	var err @errors.Error
	n, err = b.Write("!!")
	println(n)                                             // 2
	println(b.Len())                                       // 4
	println(yn(sEq(b.String(), "hi!!")))                   // 1
	b.Reset()
	println(b.Len())                                       // 0
	println(yn(sEq(b.String(), "")))                       // 1
}
