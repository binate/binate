package "main"
import "pkg/builtins/testing"

// All 256 byte values round-trip through strings.Builder.WriteByte (across the
// reallocations that growth triggers), via the injected strings package.
// Stdlib conformance suite.
import "pkg/std/strings"

func main() {
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < 256; i++ {
		b.WriteByte(cast(uint8, i))
	}
	testing.Println(b.Len())                                       // 256
	var s @[]readonly char = b.String()
	var ok int = 1
	for i := 0; i < 256; i++ {
		if cast(int, s[i]) != i { ok = 0 }
	}
	testing.Println(ok)                                            // 1
}
