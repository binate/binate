package "main"

// Cross-mode RTTI type assertions on a native-injected package's interface value.
// Under the -int modes
// `strings` is the injected COMPILED package, so the `@io.Writer` built here over
// its `@strings.Builder` carries a NATIVE `@__ivt` vtable — asserting on it
// exercises the cross-mode path: BC_IFACE_TYPEINFO reads the native
// `&TypeInfo(Builder)` from the vtable's slot 1, and the assertions resolve it
// against the data-symbol + satentry registrations RegisterPackageSatEntries
// installed from the package's reflect descriptor (X.1 laid the descriptor's
// symbol-name blobs those registrations read).  In the compiled modes the same
// assertions run natively.  A concrete `w.(*Builder)` and an interface
// `w.(*io.ByteWriter)` both HIT and dispatch into the one Builder; an interface
// Builder does not implement (io.Reader) MISSes.
import "pkg/std/strings"
import "pkg/std/io"
import "pkg/std/errors"

func main() {
	var b @strings.Builder = strings.NewBuilder()
	var w @io.Writer = b

	// (a) Concrete assert to the native exported type: recover the *Builder and
	// write through it — the bytes land in the same Builder.
	var rb *strings.Builder = w.(*strings.Builder)
	var werr @errors.Error
	_, werr = rb.Write("abc")
	if present(werr) { println(1) } else { println(0) } // 0

	// (b) Interface assert to a SECOND interface Builder impls; dispatch the
	// recovered value's WriteByte (native method dispatch, cross-mode).
	var bw *io.ByteWriter = w.(*io.ByteWriter)
	var berr @errors.Error
	berr = bw.WriteByte(cast(uint8, 33)) // '!'
	if present(berr) { println(1) } else { println(0) } // 0

	// (c) comma-ok interface MISS: Builder does not implement io.Reader.
	_, ok := w.(*io.Reader)
	if ok { println(-1) } else { println(9) } // 9

	// All writes landed in the one Builder (3 + 1 = 4).
	println(b.Len()) // 4
}
