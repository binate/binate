package "main"

// time with NEGATIVE (pre-epoch) Unix times through the injected time package —
// negative int64 across the marshaling boundary, the case 855_std_time (positive
// only) doesn't reach: FromUnix/ToUnix round-trip, epoch-crossing ordering, and a
// negative Delta.  Stdlib conformance suite.
import "pkg/std/time"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var sec int64
	var ns int32
	sec, ns = time.FromUnix(cast(int64, 0) - 100, cast(int32, 500)).ToUnix()
	println(yn(sec == cast(int64, 0) - 100))                          // 1
	println(yn(ns == cast(int32, 500)))                              // 1

	// Ordering across the epoch: -1s is before +1s.
	var before time.Point = time.FromUnix(cast(int64, 0) - 1, cast(int32, 0))
	var after time.Point = time.FromUnix(cast(int64, 1), cast(int32, 0))
	println(yn(before.Before(after)))                                // 1
	println(yn(after.After(before)))                                 // 1

	// Negative Delta: 3s - 10s = -7s.
	var d time.Delta = time.FromUnix(cast(int64, 3), cast(int32, 0)).Sub(
		time.FromUnix(cast(int64, 10), cast(int32, 0)))
	println(yn(d.Nanoseconds() == cast(int64, 0) - 7000000000))      // 1
}
