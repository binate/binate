package "main"
import "pkg/builtins/testing"

// time.Point is a 16-byte by-value struct {sec int64, nsec int32}.  In the
// bytecode VM the time package is injected (native), so FromUnix's result and
// ToUnix's receiver cross the VM<->native boundary as a COERCED [2 x i64]
// aggregate.  The VM expands a cross-mode coerced-aggregate argument into its
// value words; passing the Point's ADDRESS where the shim expects its coerced
// value words makes the int64 seconds come back as a stack address.  Round-trips
// a value > 2^32 (where that corruption is visible).
import "pkg/std/time"

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var p time.Point = time.FromUnix(cast(int64, 1500000000), cast(int32, 0))
	var sec int64
	var nsec int32
	sec, nsec = p.ToUnix()
	testing.Println(yn(sec == cast(int64, 1500000000)))
	testing.Println(yn(nsec == cast(int32, 0)))
	testing.Println(yn(p.SecondsSinceEpoch() > cast(int64, 0)))
}
