package "main"
import "pkg/builtins/testing"

import "pkg/std/time"

// Cross-package consumer test for pkg/std/time: drives FromUnix, Sub,
// Before/After/Equal, Nanoseconds, ToUnix, SecondsSinceEpoch, and Nanosecond
// from a main package, so the bytecode-VM injection (single native instance,
// cross-mode value marshaling) is exercised across all conformance modes.
// Each line prints 1 on success.

func yn(b bool) int {
	if b { return 1 }
	return 0
}

func main() {
	var a time.Point = time.FromUnix(cast(int64, 10), cast(int32, 0))
	var b time.Point = time.FromUnix(cast(int64, 3), cast(int32, 0))
	testing.Println(yn(a.Sub(b).Nanoseconds() == cast(int64, 7000000000)))
	testing.Println(yn(b.Before(a)))
	testing.Println(yn(a.After(b)))
	testing.Println(yn(a.Equal(a)))

	// sec dominates nsec.
	var c time.Point = time.FromUnix(cast(int64, 1), cast(int32, 999999999))
	var d time.Point = time.FromUnix(cast(int64, 2), cast(int32, 0))
	testing.Println(yn(c.Before(d)))

	// Sub across a second boundary.
	testing.Println(yn(time.FromUnix(cast(int64, 11), cast(int32, 0)).Sub(
		time.FromUnix(cast(int64, 10), cast(int32, 999999999))).Nanoseconds() == cast(int64, 1)))

	// Accessors.
	var sec int64
	var ns int32
	sec, ns = time.FromUnix(cast(int64, 5), cast(int32, 7)).ToUnix()
	testing.Println(yn(sec == cast(int64, 5) && ns == cast(int32, 7)))
	testing.Println(yn(time.FromUnix(cast(int64, 0), cast(int32, 0)).SecondsSinceEpoch() == cast(int64, 62135596800)))
	testing.Println(yn(time.FromUnix(cast(int64, 5), cast(int32, 7)).Nanosecond() == cast(int32, 7)))
}
