package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// A bnld driver that lays out an arm32 (ELF32) bare-metal image with the scripted
// LayoutBuilder, for booting directly under `qemu-system-arm -M virt` (no OS, no
// libc).  It places .text/.rodata (R+X) then .data/.bss (R+W) starting at the RAM
// base and enters at `_start` — the arm32 analogue of drivers/staticelf.bn, but
// emitting ELF32 for EM_ARM.  INTERPRETED at link time (`bnld -driver
// drivers/baremetal-arm.bn <objs> -o out -target arm32-baremetal`); its link.*
// calls run compiled.  Drive returns "" on success or an error message.

// ramBase is the RAM origin of qemu-system-arm's `virt` machine.
const ramBase uint64 = 0x40000000

// hdrPage is one page.  The ELF writer maps the ELF header + program headers in the
// page below the first segment's VMA (so a runtime reading them finds them mapped),
// which backs the loadable segment's load address down by one page.  Laying the
// image out at ramBase + hdrPage therefore lands the segment's load address exactly
// at ramBase — where `qemu-system-arm -M virt -kernel` places (and, via e_entry,
// enters) a bare ELF image.
const hdrPage uint64 = 0x1000

// pageSz is the load-segment page size the writable group is aligned onto.
const pageSz int = 0x1000

// streq reports whether a mutable char slice equals a readonly one.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// readAll reads each object path into an InputObject (the pool Place globs over).
func readAll(paths @[]@[]char) (@[]@link.InputObject, @[]readonly char) {
	var objs @[]@link.InputObject = make_slice(@link.InputObject, len(paths))
	for i := 0; i < len(paths); i++ {
		obj, err := link.ReadObject(paths[i])
		if len(err) != 0 { return objs, err }
		objs[i] = obj
	}
	return objs, ""
}

// Drive lays out objs as an arm32 bare-metal ELF32 image at out.  Returns "" on
// success or an error message.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	if !streq(target, "arm32-baremetal") {
		return buf.Concat("baremetal-arm driver: unsupported target (arm32-baremetal only): ", target)
	}

	inputs, rerr := readAll(objs)
	if len(rerr) != 0 { return buf.Concat("baremetal-arm driver: read: ", rerr) }

	var b @link.LayoutBuilder = link.NewLayout(link.EM_ARM)
	b.SetInputs(inputs)
	b.SetDot(ramBase + hdrPage)
	// Read-only group: .text then .rodata, contiguous from the RAM base.
	_ = b.BeginSection(".text", link.SF_READ | link.SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	_ = b.BeginSection(".rodata", link.SF_READ)
	b.Place("*(.rodata*)", false)
	b.EndSection()
	// Writable group on a fresh page (W^X) — .data then .bss.
	b.AlignDot(pageSz)
	_ = b.BeginSection(".data", link.SF_READ | link.SF_WRITE)
	b.Place("*(.data*)", false)
	b.EndSection()
	_ = b.BeginSection(".bss", link.SF_READ | link.SF_WRITE)
	b.Place("*(.bss*)", false)
	b.EndSection()
	b.SetEntry("_start")

	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return buf.Concat("baremetal-arm driver: finish: ", ferr) }
	var eerr @[]readonly char = b.EmitElf(out)
	if len(eerr) != 0 { return buf.Concat("baremetal-arm driver: emit: ", eerr) }
	return buf.CopyStr("")
}
