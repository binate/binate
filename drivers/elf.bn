package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// Reference bnld driver: a static ELF link, written in Binate and INTERPRETED at link
// time (the Step 7 dual-mode showcase).  `bnld -driver drivers/elf.bn <objs> -o out
// -target <t>` embeds the bytecode VM, injects the COMPILED pkg/binate/link library as
// externs, and calls Drive below; Drive's calls to link.* run compiled (the O(bytes) hot
// path), while this policy code is interpreted (cheap — it runs once per link).
//
// This mirrors bnld's built-in static-ELF path.  A custom driver is a copy of this that
// changes policy — load base, entry symbol, target selection, output shape — without
// recompiling bnld.
//
// The entry contract (ratified in explorations/plan-step7-driver.md): bnld parses the CLI
// and calls `Drive(objs, out, target)`, returning "" on success or an error message.  The
// argument/result types are the ones interp.RunFuncTyped marshals across the
// compiled<->interpreted boundary (@[]@[]char / @[]char).

// streq reports whether a mutable char slice equals a readonly one.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// Drive performs a static ELF link of objs into out for target.  Returns "" on success or
// a non-empty error message.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	var machine int = 0
	if streq(target, "linux-x64") {
		machine = link.EM_X86_64
	} else if streq(target, "linux-aarch64") {
		machine = link.EM_AARCH64
	} else {
		return buf.Concat("driver: unsupported target: ", target)
	}
	// A static ELF executable at the conventional load base, entering at _start.
	var err @[]readonly char = link.Link(objs, "_start", machine, cast(uint64, 0x400000), out)
	if len(err) != 0 { return buf.Concat("driver: link failed: ", err) }
	return buf.CopyStr("")
}
