package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// A bnld driver for a Cortex-M-style arm32 firmware image with a ROM→RAM data copy,
// scripting the full linker-script feature set the LayoutBuilder exposes: two MEMORY
// regions (FLASH r-x, RAM r-w), `.text`/`.rodata` in FLASH, `.data` with its VMA in
// RAM but its LMA in FLASH (`AT> FLASH` — the image ships in flash and startup copies
// it to RAM), `.bss` in RAM, and the boundary / region symbols a startup routine reads
// (`_sidata = LOADADDR(.data)`, `_sdata`/`_edata`, `__bss_start`/`__bss_end`,
// `_stack_top`).  It is the arm32 case-A reference for regions + LMA≠VMA + symbols.
//
// The emitted ELF is STRUCTURE-checked, not booted: a real Cortex-M firmware runs in
// Thumb (which bnas does not emit) and would need the startup to consume these symbols
// (which a hand-asm program cannot reference — bnas has no symbol-load form), so this
// proves the LAYOUT (the ROM-copy p_vaddr≠p_paddr segment), the observable capability.
// The symbols' values are covered by the builder unit tests.  INTERPRETED at link time
// (`bnld -driver drivers/firmware-arm.bn <objs> -o out -target arm32-firmware`).  Drive
// returns "" on success or an error message.

// FLASH is the code/read-only + data-image region; RAM is the run-time data region.  The
// FLASH origin leaves one page below the first section for the ELF header prefix (which
// the writer maps just below the lowest segment's VMA).
const flashOrigin uint64 = 0x08001000

const flashLength uint64 = 0x00100000 // 1 MiB

const ramOrigin uint64 = 0x20000000

const ramLength uint64 = 0x00020000 // 128 KiB

// streq reports whether a mutable char slice equals a readonly one.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// readAll reads each object path into an InputObject (the pool Place globs over).
func readAll(paths @[]@[]char) (@[]@link.InputObject, @[]readonly char) {
	var objs @[]@link.InputObject = make_slice(@link.InputObject, len(paths))
	for i := 0; i < len(paths); i++ {
		obj, err := link.ReadObject(paths[i])
		if len(err) != 0 { return objs, err }
		objs[i] = obj
	}
	return objs, ""
}

// Drive lays out objs as an arm32 firmware ELF32 image with a ROM→RAM .data copy.
// Returns "" on success or an error message.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	if !streq(target, "arm32-firmware") {
		return buf.Concat("firmware-arm driver: unsupported target (arm32-firmware only): ", target)
	}

	inputs, rerr := readAll(objs)
	if len(rerr) != 0 { return buf.Concat("firmware-arm driver: read: ", rerr) }

	var b @link.LayoutBuilder = link.NewLayout(link.EM_ARM)
	b.SetInputs(inputs)
	b.DefineRegion("FLASH", flashOrigin, flashLength, link.SF_READ | link.SF_EXEC)
	b.DefineRegion("RAM", ramOrigin, ramLength, link.SF_READ | link.SF_WRITE)

	// Code + read-only data live (and run) in FLASH.
	b.SetDotToRegion("FLASH")
	_ = b.BeginSection(".text", link.SF_READ | link.SF_EXEC)
	b.SectionAtRegion("FLASH")
	b.Place("*(.text*)", false)
	b.EndSection()
	_ = b.BeginSection(".rodata", link.SF_READ)
	b.SectionAtRegion("FLASH")
	b.Place("*(.rodata*)", false)
	b.EndSection()

	// .data runs in RAM but ships in FLASH (AT> FLASH); startup copies [_sidata,+size)
	// -> [_sdata,_edata).
	var sData link.Section = b.BeginSection(".data", link.SF_READ | link.SF_WRITE)
	b.SectionAtRegion("RAM")
	b.SectionLoadRegion("FLASH")
	b.SymbolAtDot("_sdata")
	b.Place("*(.data*)", false)
	b.SymbolAtDot("_edata")
	b.EndSection()
	b.DefineSymbol("_sidata", b.LoadAddrOf(sData)) // LOADADDR(.data): where to copy from

	// .bss runs in RAM (zero-initialized by startup between the boundary symbols).
	_ = b.BeginSection(".bss", link.SF_READ | link.SF_WRITE)
	b.SectionAtRegion("RAM")
	b.SymbolAtDot("__bss_start")
	b.Place("*(.bss*)", false)
	b.Place("*(COMMON)", false)
	b.SymbolAtDot("__bss_end")
	b.EndSection()

	b.DefineSymbol("_stack_top", ramOrigin + ramLength) // full-descending stack top
	b.SetEntry("_start")

	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return buf.Concat("firmware-arm driver: finish: ", ferr) }
	var eerr @[]readonly char = b.EmitElf(out)
	if len(eerr) != 0 { return buf.Concat("firmware-arm driver: emit: ", eerr) }
	return buf.CopyStr("")
}
