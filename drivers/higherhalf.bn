package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// A bnld driver for a higher-half kernel image: sections RUN in the high half
// (KVMA + physical) but LOAD at their physical address (`AT(vaddr - KVMA)`), under an
// explicit program-header table — a read-only/exec text segment and a read-write data
// segment declared with DefineSegment / AssignSection.  This exercises the scripted
// LayoutBuilder's explicit-PHDRS + LMA≠VMA path (EmitElfExecPhdrs): the emitted ELF
// carries p_vaddr in the high half and p_paddr at the physical load address, which a
// multiboot loader places low and the kernel runs high once paging is on.  INTERPRETED at
// link time (`bnld -driver drivers/higherhalf.bn <objs> -o out -target linux-x64`); its
// link.* calls run compiled.  Drive returns "" on success or an error message.

// kvma is the higher-half virtual base (the top 2 GiB, the -2GiB kernel model).
const kvma uint64 = 0xffffffff80000000

// physBase is where a multiboot loader places the image (1 MiB).
const physBase uint64 = 0x100000

// pageSz is the load-segment page size the writable group is aligned onto.
const pageSz int = 0x1000

// streq reports whether a mutable char slice equals a readonly one.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// readAll reads each object path into an InputObject.
func readAll(paths @[]@[]char) (@[]@link.InputObject, @[]readonly char) {
	var objs @[]@link.InputObject = make_slice(@link.InputObject, len(paths))
	for i := 0; i < len(paths); i++ {
		obj, err := link.ReadObject(paths[i])
		if len(err) != 0 { return objs, err }
		objs[i] = obj
	}
	return objs, ""
}

// Drive lays out objs as a higher-half kernel ELF at out.  Returns "" on success or an
// error message.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	if !streq(target, "linux-x64") {
		return buf.Concat("higherhalf driver: unsupported target (x86-64 only): ", target)
	}
	inputs, rerr := readAll(objs)
	if len(rerr) != 0 { return buf.Concat("higherhalf driver: read: ", rerr) }

	var b @link.LayoutBuilder = link.NewLayout(link.EM_X86_64)
	b.SetInputs(inputs)
	// Two explicit segments: text (R+X) and data (R+W).
	var segText link.Segment = b.DefineSegment("text", link.PT_LOAD, link.PF_R | link.PF_X)
	var segData link.Segment = b.DefineSegment("data", link.PT_LOAD, link.PF_R | link.PF_W)

	b.SetDot(kvma + physBase) // run in the high half; each section loads at Dot()-kvma
	var sText link.Section = b.BeginSection(".text", link.SF_READ | link.SF_EXEC)
	b.SectionLoadAddr(b.Dot() - kvma)
	b.Place("*(.text*)", false)
	b.AssignSection(sText, segText)
	b.EndSection()
	var sRodata link.Section = b.BeginSection(".rodata", link.SF_READ)
	b.SectionLoadAddr(b.Dot() - kvma)
	b.Place("*(.rodata*)", false)
	b.AssignSection(sRodata, segText)
	b.EndSection()

	b.AlignDot(pageSz) // writable group on a fresh page
	var sData link.Section = b.BeginSection(".data", link.SF_READ | link.SF_WRITE)
	b.SectionLoadAddr(b.Dot() - kvma)
	b.Place("*(.data*)", false)
	b.AssignSection(sData, segData)
	b.EndSection()
	var sBss link.Section = b.BeginSection(".bss", link.SF_READ | link.SF_WRITE)
	b.SectionLoadAddr(b.Dot() - kvma)
	b.Place("*(.bss*)", false)
	b.AssignSection(sBss, segData)
	b.EndSection()

	b.SetEntry("_start")
	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return buf.Concat("higherhalf driver: finish: ", ferr) }
	var eerr @[]readonly char = b.EmitElf(out)
	if len(eerr) != 0 { return buf.Concat("higherhalf driver: emit: ", eerr) }
	return buf.CopyStr("")
}
