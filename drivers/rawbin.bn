package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// A bnld driver that lays out an MBR-style boot-sector image: a flat 512-byte binary
// with the input objects' code at the BIOS boot address 0x7C00, padded to offset 510,
// followed by the 0x55AA boot signature — no ELF/Mach-O container.  It is INTERPRETED at
// link time (`bnld -driver drivers/rawbin.bn <objs> -o out.bin`), its link.* calls
// running against the COMPILED linker; the same dual-mode path as drivers/elf.bn, but
// exercising the scripted LayoutBuilder + raw-binary emit instead of the built-in
// whole-link ELF path.  Drive's argument/result types (@[]@[]char / @[]char) are what
// bnld marshals across the compiled<->interpreted boundary; it returns "" on success or
// an error message.

// bootBase is the address a PC BIOS loads and enters a boot sector at.
const bootBase uint64 = 0x7C00

// readAll reads each object path into an InputObject (the pool Place globs over).
func readAll(paths @[]@[]char) (@[]@link.InputObject, @[]readonly char) {
	var objs @[]@link.InputObject = make_slice(@link.InputObject, len(paths))
	for i := 0; i < len(paths); i++ {
		obj, err := link.ReadObject(paths[i])
		if len(err) != 0 { return objs, err }
		objs[i] = obj
	}
	return objs, ""
}

// Drive lays out objs as a 512-byte boot-sector image at out.  target is ignored — a
// boot sector is x86 by construction.  Returns "" on success or an error message.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	inputs, rerr := readAll(objs)
	if len(rerr) != 0 { return buf.Concat("rawbin driver: read: ", rerr) }

	var b @link.LayoutBuilder = link.NewLayout(link.EM_X86_64)
	b.SetInputs(inputs)
	b.SetDot(bootBase)
	_ = b.BeginSection(".boot", link.SF_READ | link.SF_EXEC)
	b.Place("*(.text*)", false)
	b.PadTo(bootBase + cast(uint64, 0x1FE), cast(uint8, 0)) // pad to offset 510
	var sig @[]uint8 = make_slice(uint8, 2)
	sig[0] = cast(uint8, 0x55)
	sig[1] = cast(uint8, 0xAA)
	b.EmitData(sig)
	b.EndSection()

	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return buf.Concat("rawbin driver: finish: ", ferr) }
	var eerr @[]readonly char = b.EmitRawBinary(out)
	if len(eerr) != 0 { return buf.Concat("rawbin driver: emit: ", eerr) }
	return buf.CopyStr("")
}
