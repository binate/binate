package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// A bnld driver that lays out an arm32 (ELF32) bare-metal image DECLARATIVELY, via the
// Layer-2 spec (link.LayoutScript + link.LinkWithScript) rather than imperative builder
// calls — the arm32 analogue of drivers/baremetal-arm.bn written in the sugar layer.  It
// builds a LayoutScript (a start dot at the RAM base, ordered .text/.rodata/.data/.bss
// sections with `*(GLOB)` placements and section-boundary symbols, an entry) and hands it
// to LinkWithScript, which compiles it to the builder, resolves + relocates, and emits.
// INTERPRETED at link time (`bnld -driver drivers/script-arm.bn <objs> -o out -target
// arm32-script`); its link.* calls run compiled.  Drive returns "" on success or an error.

// ramBase + hdrPage: lay out one page above the qemu-system-arm `virt` RAM base so the ELF
// writer's header prefix maps just below the first segment, landing it at the RAM base.
const ramBase uint64 = 0x40000000

const hdrPage uint64 = 0x1000

// streq reports whether a mutable char slice equals a readonly one.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// oneGlob returns a one-item body placing every input section matching pattern.
func oneGlob(pattern *[]readonly char) @[]link.ScriptItem {
	var items @[]link.ScriptItem = make_slice(link.ScriptItem, 1)
	items[0] = link.Place(pattern, false)
	return items
}

// sect builds a SectionSpec with name, flags, and body items.
func sect(name *[]readonly char, flags int, items @[]link.ScriptItem) link.SectionSpec {
	var s link.SectionSpec
	s.Name = buf.CopyStr(name)
	s.Flags = flags
	s.Items = items
	return s
}

// Drive lays out objs as an arm32 bare-metal ELF32 image, described declaratively.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	if !streq(target, "arm32-script") {
		return buf.Concat("script-arm driver: unsupported target (arm32-script only): ", target)
	}

	// .data brackets its content with boundary symbols and page-aligns onto a fresh page
	// (W^X); .bss also draws in *(COMMON).
	var dataItems @[]link.ScriptItem = make_slice(link.ScriptItem, 3)
	dataItems[0] = link.SymAt("__data_start")
	dataItems[1] = link.Place("*(.data*)", false)
	dataItems[2] = link.SymAt("__data_end")
	var bssItems @[]link.ScriptItem = make_slice(link.ScriptItem, 4)
	bssItems[0] = link.SymAt("__bss_start")
	bssItems[1] = link.Place("*(.bss*)", false)
	bssItems[2] = link.Place("*(COMMON)", false)
	bssItems[3] = link.SymAt("__bss_end")

	// .data page-aligns onto a fresh page (W^X): build it, then set Align.
	var dataSec link.SectionSpec = sect(".data", link.SF_READ | link.SF_WRITE, dataItems)
	dataSec.Align = 0x1000

	var secs @[]link.SectionSpec = make_slice(link.SectionSpec, 4)
	secs[0] = sect(".text", link.SF_READ | link.SF_EXEC, oneGlob("*(.text*)"))
	secs[1] = sect(".rodata", link.SF_READ, oneGlob("*(.rodata*)"))
	secs[2] = dataSec
	secs[3] = sect(".bss", link.SF_READ | link.SF_WRITE, bssItems)

	var stackSym link.AbsSymSpec
	stackSym.Name = buf.CopyStr("_stack_top")
	stackSym.Value = ramBase + cast(uint64, 0x01000000) // top of a 16 MiB RAM
	var syms @[]link.AbsSymSpec = make_slice(link.AbsSymSpec, 1)
	syms[0] = stackSym

	var script link.LayoutScript
	script.HasStartDot = true
	script.StartDot = ramBase + hdrPage
	script.Sections = secs
	script.AbsSyms = syms
	script.Entry = buf.CopyStr("_start")

	return buf.CopyStr(link.LinkWithScript(objs, script, link.EM_ARM, out))
}
