package "driver"

import "pkg/binate/buf"
import "pkg/binate/link"

// A bnld driver that lays out a static ELF64 executable with the scripted LayoutBuilder:
// the read-only group (.text then .rodata) at the load base, then the writable group
// (.data then .bss) page-aligned onto a fresh page so the two map as W^X-disjoint
// PT_LOADs, entering at `_start`.  It reproduces bnld's built-in static-ELF policy
// (drivers/elf.bn, which calls the whole-link link.Link) but drives the primitive layout
// engine + EmitElf instead — the scripted path a custom driver would fork to change load
// base, section order, or symbols.  INTERPRETED at link time (`bnld -driver
// drivers/staticelf.bn <objs> -o out -target <t>`); its link.* calls run compiled.  Drive
// returns "" on success or an error message.

// loadBase is the conventional static-executable load address.
const loadBase uint64 = 0x400000

// pageSz is the load-segment page size the writable group is aligned onto.
const pageSz int = 0x1000

// streq reports whether a mutable char slice equals a readonly one.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// readAll reads each object path into an InputObject (the pool Place globs over).
func readAll(paths @[]@[]char) (@[]@link.InputObject, @[]readonly char) {
	var objs @[]@link.InputObject = make_slice(@link.InputObject, len(paths))
	for i := 0; i < len(paths); i++ {
		obj, err := link.ReadObject(paths[i])
		if len(err) != 0 { return objs, err }
		objs[i] = obj
	}
	return objs, ""
}

// Drive lays out objs as a static ELF64 executable at out for target.  Returns "" on
// success or an error message.
func Drive(objs @[]@[]char, out @[]char, target @[]char) @[]char {
	var machine int = 0
	if streq(target, "linux-x64") {
		machine = link.EM_X86_64
	} else if streq(target, "linux-aarch64") {
		machine = link.EM_AARCH64
	} else {
		return buf.Concat("staticelf driver: unsupported target: ", target)
	}

	inputs, rerr := readAll(objs)
	if len(rerr) != 0 { return buf.Concat("staticelf driver: read: ", rerr) }

	var b @link.LayoutBuilder = link.NewLayout(machine)
	b.SetInputs(inputs)
	b.SetDot(loadBase)
	// Read-only group: .text then .rodata, contiguous.
	_ = b.BeginSection(".text", link.SF_READ | link.SF_EXEC)
	b.Place("*(.text*)", false)
	b.EndSection()
	_ = b.BeginSection(".rodata", link.SF_READ)
	b.Place("*(.rodata*)", false)
	b.EndSection()
	// Writable group on a fresh page (W^X) — .data then .bss.
	b.AlignDot(pageSz)
	_ = b.BeginSection(".data", link.SF_READ | link.SF_WRITE)
	b.Place("*(.data*)", false)
	b.EndSection()
	_ = b.BeginSection(".bss", link.SF_READ | link.SF_WRITE)
	b.Place("*(.bss*)", false)
	b.EndSection()
	b.SetEntry("_start")

	var ferr @[]readonly char = b.Finish()
	if len(ferr) != 0 { return buf.Concat("staticelf driver: finish: ", ferr) }
	var eerr @[]readonly char = b.EmitElf(out)
	if len(eerr) != 0 { return buf.Concat("staticelf driver: emit: ", eerr) }
	return buf.CopyStr("")
}
