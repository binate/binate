// Package bootstrap provides the few platform primitives the toolchain still
// reaches directly: process control (Args / Exec) plus the print/
// println lowering's I/O sink (Write) and its integer/float/bool formatting
// helpers.  General file I/O lives in pkg/std/os; the historical
// Open / Read / Close / Stat / ReadDir surface has been retired.
package "pkg/bootstrap"

// Write writes len(buf) bytes from buf to fd (1 = stdout, 2 = stderr),
// returning bytes written or -1 on error.  Retained as the print/println
// lowering's single I/O sink — IR-gen emits direct calls to it.
func Write(fd int, buf *[]readonly uint8) int

// Args returns the command-line arguments as managed slices.
func Args() @[]@[]char

// Exec runs program with args and returns the exit code.
func Exec(program *[]readonly char, args *[]@[]char) int

// formatInt writes the decimal representation of v into buf and
// returns the number of bytes written. Caller MUST pass a buffer
// of at least 20 bytes (int64 is at most 19 digits + sign).
// Lowercase, exported via .bni for cross-compilation-unit linkage:
// IR-gen for the print/println builtin emits direct calls into
// this helper. Whitelisted in scripts/hygiene/naming.whitelist.
func formatInt(v int, buf *[]uint8) int

// formatInt64 is the int64 counterpart of formatInt, used by
// formatFloat (which has to work on a 64-bit IEEE-754 mantissa
// even when the Binate `int` type is 32 bits — i.e., under
// --target arm32-linux).
func formatInt64(v int64, buf *[]uint8) int

// formatUint is the unsigned counterpart of formatInt: no sign
// byte, digit extraction in uint64.  Used by IR-gen's print/
// println lowering for `uint*` values (a high-bit-set uint64
// must print as e.g. `9223372036854775808`, not the signed
// `-9223372036854775808`).
func formatUint(v uint64, buf *[]uint8) int

// formatBool writes "true" or "false" into buf and returns the
// number of bytes written (4 or 5). Caller MUST pass a buffer of
// at least 5 bytes. Same naming/linkage rationale as formatInt.
func formatBool(v bool, buf *[]uint8) int

// formatFloat writes a human-readable representation of v into buf
// and returns the number of bytes written. Caller MUST pass a
// buffer of at least 32 bytes. Same naming/linkage rationale as
// formatInt.
//
// Bootstrap-grade: not %g-compatible. NaN → "NaN", ±Inf → "+Inf"
// / "-Inf", finite within range → fixed-point integer.6digits
// (truncated, no trailing-zero trimming, no rounding). For floats
// outside the "fits in fixed-point" envelope (|v| ≥ 2^53 or
// 0 < |v| < 1e-6), falls back to exact mantissa*2^exponent form
// (e.g. "7070651414971679*2^-51"). The exact form is unambiguous
// and lossless; tests that need bit-exact float verification
// should use bit_cast directly.
func formatFloat(v float64, buf *[]uint8) int
