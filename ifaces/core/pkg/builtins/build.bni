// Package build exposes the compile-time target metadata — operating system,
// CPU architecture, and pointer/int widths — as constants, so code can
// specialize for the target it is being compiled for.  The values are
// compile-time constants (foldable), not runtime variables.
//
// One file for all targets: the OS / Arch / PtrSize / IntSize constants carry
// `#[build(...)]` constraints, so the compiler keeps exactly the set matching
// the target it is compiling for.  (Previously there was a per-target copy
// under ifaces/targets/<key>/; build constraints replaced that tree.)  The
// compiler does NOT read this file to learn its own config — it provides the
// values from the target it already knows (see pkg/binate/buildcfg); this file
// is what a program that `import "pkg/builtins/build"` sees.
package "pkg/builtins/build"

// OSType enumerates the supported target operating systems.
type OSType int

const (
	OS_LINUX OSType = iota
	OS_DARWIN
	OS_BAREMETAL
)

// ArchType enumerates the supported target CPU architectures.
type ArchType int

const (
	ARCH_X64 ArchType = iota
	ARCH_AARCH64
	ARCH_ARM32
)

// OS is the operating system this target runs on (one of the OSType members,
// selected for the build target).

#[build(is(os, "linux"))]
const OS OSType = OS_LINUX

// OS on a Darwin target.

#[build(is(os, "darwin"))]
const OS OSType = OS_DARWIN

// OS on a bare-metal target.

#[build(is(os, "baremetal"))]
const OS OSType = OS_BAREMETAL

// Arch is the CPU architecture this target runs on (one of the ArchType
// members, selected for the build target).

#[build(is(arch, "x64"))]
const Arch ArchType = ARCH_X64

// Arch on an aarch64 target.

#[build(is(arch, "aarch64"))]
const Arch ArchType = ARCH_AARCH64

// Arch on an arm32 target.

#[build(is(arch, "arm32"))]
const Arch ArchType = ARCH_ARM32

// PtrSize is the size in bytes of a pointer on this target (8 on 64-bit archs).

#[build(is(arch, "x64"))]
const PtrSize int = 8

// PtrSize on aarch64 (LP64, 8-byte pointers).

#[build(is(arch, "aarch64"))]
const PtrSize int = 8

// PtrSize on arm32 (ILP32, 4-byte pointers).

#[build(is(arch, "arm32"))]
const PtrSize int = 4

// IntSize is the size in bytes of `int` on this target (8 on 64-bit archs).

#[build(is(arch, "x64"))]
const IntSize int = 8

// IntSize on aarch64 (LP64, 8-byte int).

#[build(is(arch, "aarch64"))]
const IntSize int = 8

// IntSize on arm32 (ILP32, 4-byte int).

#[build(is(arch, "arm32"))]
const IntSize int = 4
