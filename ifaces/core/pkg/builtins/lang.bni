// Package std is the canonical-impl carve-out: it ships
// language-level interfaces (`Stringer`, ...) and the
// implementations for every universe primitive (`int`,
// `bool`, etc.).  No other package may declare methods on
// universe primitives — see `plan-primitives-impl-
// interfaces.md` for the design and the type-checker
// AllowUniverseRecv flag that gates this.
//
// Importing pkg/builtins/lang brings in both the interface
// declarations AND the primitive impls (the latter via the
// cross-package vtable machinery — `plan-cross-package-
// interfaces.md` Slices 2.6–2.9).  No auto-import: callers
// who want `*Stringer`-style code write `import "pkg/builtins/lang"`
// explicitly.
//
// Slice 2a (this slice): Stringer + universe impls.
// Slice 2b (follow-up): Comparable / Orderable / Hashable
// (depend on the now-ratified `Self` type).
package "pkg/builtins/lang"

// Stringer is the canonical "get a printable representation"
// interface.  Every type implementing Stringer answers
// `String()` with a freshly-allocated managed-slice — the
// caller owns the result.  Used by stdlib formatting paths
// and by user code that wants polymorphic printing.
interface Stringer {
	String() @[]char
}

// Comparable is the canonical equality interface.  `Compare`
// returns 0 iff the two values are considered equal (whatever
// the impl's notion of equality is), and nonzero otherwise —
// the sign and magnitude of nonzero results carry no meaning
// at this level.  Use Orderable for the total-order contract.
//
// Self appears in the `other` parameter — these methods are
// callable through generic constraints (`[T Comparable]`)
// where T is statically known, NOT through `*Comparable`
// interface values (that would require type-erased dispatch
// — see plan-self-type.md S.3).
interface Comparable {
	Compare(other Self) int
}

// Orderable is a zero-method extension of Comparable that
// additionally promises the implementing type's `Compare`
// method satisfies total order: transitivity, antisymmetry,
// and sign-consistency.  Users opt in by declaring
// `impl T : Orderable` (which transitively also satisfies
// Comparable).  The compiler can't verify the contract; the
// declaration IS the assertion.
//
// Consumers that want `<` write `t.Compare(other) < 0`;
// equivalent to "<= 0" / "> 0" for the other comparisons.
interface Orderable : Comparable {}

// Hashable extends Comparable with `Hash`.  The hash MUST be
// consistent with Compare's equality semantic: if
// `a.Compare(b) == 0`, then `a.Hash() == b.Hash()`.  Used by
// stdlib associative containers (Map, Set) once those land.
interface Hashable : Comparable {
	Hash() uint
}
