// Package std is the canonical-impl carve-out: it ships
// language-level interfaces (`Stringer`, ...) and the
// implementations for every universe primitive (`int`,
// `bool`, etc.).  No other package may declare methods on
// universe primitives — the type-checker AllowUniverseRecv
// flag gates this.
//
// Importing pkg/builtins/lang brings in both the interface
// declarations AND the primitive impls (the latter via the
// cross-package vtable machinery).  No auto-import: callers
// who want `*Stringer`-style code write `import "pkg/builtins/lang"`
// explicitly.
//
// Slice 2a (this slice): Stringer + universe impls.
// Slice 2b (follow-up): Comparable / Orderable / Hashable
// (depend on the now-ratified `Self` type).
package "pkg/builtins/lang"

// Stringer is the canonical "get a printable representation"
// interface.  Every type implementing Stringer answers
// `String()` with a freshly-allocated managed-slice — the
// caller owns the result.  Used by stdlib formatting paths
// and by user code that wants polymorphic printing.
interface Stringer {
	String() @[]char
}

// Comparable is the canonical equality interface.  `Compare`
// returns 0 iff the two values are considered equal (whatever
// the impl's notion of equality is), and nonzero otherwise —
// the sign and magnitude of nonzero results carry no meaning
// at this level.  Use Orderable for the total-order contract.
//
// Self appears in the `other` parameter — these methods are
// callable through generic constraints (`[T Comparable]`)
// where T is statically known, NOT through `*Comparable`
// interface values (that would require type-erased dispatch).
interface Comparable {
	Compare(other Self) int
}

// Orderable is a zero-method extension of Comparable that
// additionally promises the implementing type's `Compare`
// method satisfies total order: transitivity, antisymmetry,
// and sign-consistency.  Users opt in by declaring
// `impl T : Orderable` (which transitively also satisfies
// Comparable).  The compiler can't verify the contract; the
// declaration IS the assertion.
//
// Consumers that want `<` write `t.Compare(other) < 0`;
// equivalent to "<= 0" / "> 0" for the other comparisons.
interface Orderable : Comparable {}

// Hashable extends Comparable with `Hash`.  The hash MUST be
// consistent with Compare's equality semantic: if
// `a.Compare(b) == 0`, then `a.Hash() == b.Hash()`.  Used by
// stdlib associative containers (Map, Set) once those land.
interface Hashable : Comparable {
	Hash() uint
}

// String formats an int in decimal.
func (x int) String() @[]char

// Compare returns -1 / 0 / 1 for <, ==, > on int.
func (a int) Compare(b int) int

// Hash for int.
func (x int) Hash() uint

// String formats an int8 in decimal.
func (x int8) String() @[]char

// Compare for int8.
func (a int8) Compare(b int8) int

// Hash for int8.
func (x int8) Hash() uint

// String formats an int16 in decimal.
func (x int16) String() @[]char

// Compare for int16.
func (a int16) Compare(b int16) int

// Hash for int16.
func (x int16) Hash() uint

// String formats an int32 in decimal.
func (x int32) String() @[]char

// Compare for int32.
func (a int32) Compare(b int32) int

// Hash for int32.
func (x int32) Hash() uint

// String formats an int64 in decimal.
func (x int64) String() @[]char

// Compare for int64.
func (a int64) Compare(b int64) int

// Hash for int64.
func (x int64) Hash() uint

// String formats a uint in decimal.
func (x uint) String() @[]char

// Compare for uint.
func (a uint) Compare(b uint) int

// Hash for uint.
func (x uint) Hash() uint

// String formats a uint8 (also char / byte) in decimal.
func (x uint8) String() @[]char

// Compare for uint8 (also char / byte).
func (a uint8) Compare(b uint8) int

// Hash for uint8 (also char / byte).
func (x uint8) Hash() uint

// String formats a uint16 in decimal.
func (x uint16) String() @[]char

// Compare for uint16.
func (a uint16) Compare(b uint16) int

// Hash for uint16.
func (x uint16) Hash() uint

// String formats a uint32 in decimal.
func (x uint32) String() @[]char

// Compare for uint32.
func (a uint32) Compare(b uint32) int

// Hash for uint32.
func (x uint32) Hash() uint

// String formats a uint64 in decimal.
func (x uint64) String() @[]char

// Compare for uint64.
func (a uint64) Compare(b uint64) int

// Hash for uint64.
func (x uint64) Hash() uint

// String returns "true" or "false".
func (b bool) String() @[]char

// Compare returns 0 for equal bools; if a (true) > b (false)
// returns 1; otherwise -1.  Total-ordering convention:
// false < true.
func (a bool) Compare(b bool) int

// Hash for bool: 1 if true, 0 if false.
func (b bool) Hash() uint

// String formats a float32 in decimal.
func (x float32) String() @[]char

// Compare for float32.  NaN sorts above every non-NaN value and
// all NaN compare equal (see file-header note); non-NaN values
// order by IEEE-754 totalOrder.
func (a float32) Compare(b float32) int

// Hash for float32: bit_cast to int32, widen to int, then to uint.
// Any NaN is canonicalized first (see canonicalQNaN32) so all NaN
// hash alike, matching Compare's "all NaN equal".
func (x float32) Hash() uint

// String formats a float64 in decimal.
func (x float64) String() @[]char

// Compare for float64.  See float32 Compare and the file-header
// note about NaN.
func (a float64) Compare(b float64) int

// Hash for float64: bit_cast to int64 (the natural width-
// matching integer for a 64-bit float), then truncate-cast to
// uint.  `int64` (not `int`) because `bit_cast(int, x)` is an
// invalid LLVM cast on 32-bit targets where `int` is i32; the
// explicit int64 preserves the well-defined-bit-pattern semantics
// on every target.  Quality of the hash degrades slightly on
// ILP32 (high 32 bits lost in the cast-to-uint), but the result
// is still a deterministic function of x.  Any NaN is canonicalized
// first (see canonicalQNaN64) so all NaN hash alike.
func (x float64) Hash() uint

// Each primitive implements Stringer, and opts into Orderable (total-order
// contract) and Hashable (Hash + consistency with Compare).  Both transitively
// satisfy Comparable per the interface-extension machinery, so there are no
// separate `impl T : Comparable` lines.  The impls are in the interface so that
// importers' conversions and constraints can use them (pkg.export).  The
// cross-package vtable machinery emits the per-(R, I) vtable globals; the
// iv-dispatch thunks sit in the slot to adapt the iv pointer-shape ABI to the
// value-receiver methods above.
impl int : Stringer, Orderable, Hashable

impl int8 : Stringer, Orderable, Hashable

impl int16 : Stringer, Orderable, Hashable

impl int32 : Stringer, Orderable, Hashable

impl int64 : Stringer, Orderable, Hashable

impl uint : Stringer, Orderable, Hashable

impl uint8 : Stringer, Orderable, Hashable

impl uint16 : Stringer, Orderable, Hashable

impl uint32 : Stringer, Orderable, Hashable

impl uint64 : Stringer, Orderable, Hashable

impl bool : Stringer, Orderable, Hashable

impl float32 : Stringer, Orderable, Hashable

impl float64 : Stringer, Orderable, Hashable
