// Package reflect exposes a compiled package's reflective metadata — the
// per-package `Package` node the compiler emits and its `__Package()` accessor.
package "pkg/builtins/reflect"

// Package describes a compiled package's reflective metadata.  The compiler
// emits one immortal static-managed `Package` per compiled package and a
// generated `__Package()` accessor that returns it.
//
// The node is static, never-freed data: its managed header carries the
// negative `rt.STATIC_REFCOUNT` sentinel, so handling it as an `@Package`
// (RefInc/RefDec) is a no-op rather than a heap free.
//
// `Functions` is the exported-function table: one `FunctionInfo` per
// `.bni`-exported function, in declaration order, FOLLOWED BY the package's
// own compiler-synthesized `__Package` accessor as the last entry (so a
// package is reflectable through its own table — `__Package` is otherwise not
// `.bni`-exported).  The compiler emits the table as immortal static data
// alongside the node; richer type metadata (`TypeInfo`) lands in a later
// phase.  Because every package self-lists `__Package`, the table is never
// empty for a package compiled with reflect loaded (which the compiler
// force-loads for every package); it is `{nil, 0}` only in the degenerate
// case of a build without the reflect type available.
// `Globals` is the exported-global table: one `GlobalInfo` per `.bni`-exported
// package-level `var`, in declaration order.  Empty (`{nil, 0}`) for a package
// with no exported globals.  Appended AFTER `Functions` so the `Name` and
// `Functions` field offsets — and every existing descriptor reader — stay put.
// The VM's `RegisterPackageGlobals` reads it to bind a native-only package's
// sentinel globals (e.g. `errors.NotFound`) so a bytecode cross-package read
// resolves to the single native storage cell (cross-mode `errors.Is` identity).
// `Vtables` is the interface-impl vtable table: one `VtableInfo` per NON-generic
// `impl` the package compiles, mapping the mangled `__ivt.bn_…` vtable name to
// the address of its native `@__ivt` global.  Empty (`{nil, 0}`) for a package
// with no impls.  Appended AFTER `Globals` so the earlier field offsets stay put.
// The VM's `RegisterPackageVtables` reads it so a bytecode-built interface value
// over a native-only package's struct (e.g. `var w @io.Writer = strings.Builder`)
// resolves the impl vtable to its single native instance instead of fatally
// missing the VM's (un-lowered) `IfaceVtables`.  Generic-impl instantiations are
// excluded: they monomorphize at the importer's use site, so a bytecode user
// re-lowers its own copy (the by-name path is non-generic-only).
// `SatEntries` is the interface-satisfaction table: one `SatEntryInfo` per
// `(T, J)` the package's impls satisfy (each explicit `impl` AND every transitive
// ancestor, plus `(T, any)` box rows), mapping a concrete type + interface to the
// sub-vtable an assertion installs on a hit (spec §11.12 `iface.rtti`,
// `type.layout.satisfaction`).  Empty (`{nil, 0}`) for a package with no impls.
// Appended AFTER `Vtables` so the earlier field offsets stay put.  Because `impl`
// may live in any package (no orphan rule), satisfaction is a DISTRIBUTED registry
// — each package lists only its own `(T, J)` entries, and the runtime aggregates
// them across every package's descriptor, exactly as it does vtables.  A Phase-5
// interface assertion `x.(*J)` looks up `(dynamic-type's TypeInfo, &IfaceId(J))` in
// the aggregate and forms `{data, sub-vtable}` on a match.
type Package struct {
	Name       *[]readonly char
	Functions  *[]@FunctionInfo
	Globals    *[]@GlobalInfo
	Vtables    *[]@VtableInfo
	SatEntries *[]@SatEntryInfo
}

// GlobalInfo is a compiled package's metadata for one exported package-level
// global: its fully-qualified name (the VM `globalNames` key) and the address
// of its single native storage cell.  Unlike `FunctionInfo.Value` (which points
// at a static-managed function-value handle), `Addr` is the raw `var` cell
// itself — no managed header, so the descriptor emits `&<global>` with addend 0.
type GlobalInfo struct {
	// Name is the FULLY-QUALIFIED name, e.g. "pkg/std/errors.NotFound" — the
	// form `lookupGlobalAddr` keys on.
	Name *[]readonly char
	// Addr is `&<global>`, the address of the global's native storage cell.
	Addr *uint8
}

// VtableInfo is a compiled package's metadata for one interface-impl vtable:
// its mangled name (the VM's `findIfaceVtable` / `BC_IFACE_VALUE` lookup key)
// and the address of its native `@__ivt` global (the array of method function
// pointers, slot 0 the dtor handle).  Structurally identical to `GlobalInfo`:
// `Addr` is the raw vtable global, no managed header, so the descriptor emits
// `&<__ivt>` with addend 0.  The VM stores `Addr` in a bytecode-built interface
// value's vtable word, where `ifaceVtIsNative` routes it to
// `dispatchCompiledIfaceMethod`.
type VtableInfo struct {
	// Name is the mangled vtable identifier, e.g.
	// "__ivt.bn_V..." — the form
	// `lookupVtableAddr` keys on (matches `implVtableName` across IR-gen,
	// codegen, and VM lowering).
	Name *[]readonly char
	// Addr is `&<__ivt.bn_…>`, the address of the native vtable global (raw
	// method fn pointers; slot 0 the dtor handle).  The VM stores this in a
	// bytecode-built interface value's vtable word (ifaceVtIsNative).
	Addr *uint8
	// ShimAddr is `&<__ivtshim.bn_…>`, the address of the PARALLEL shim vtable:
	// the same slot layout as Addr, but each method slot holds the method's
	// function-value HANDLE.  dispatchCompiledIfaceMethod resolves this from
	// Addr and dispatches through the handle's marshaling shim, so the VM never
	// replicates the native arg/return ABI.
	ShimAddr *uint8
	// SlotCount is the number of slots in the @__ivt / @__ivtshim vtables (the
	// dtor slot + the interface's full concat method set — the compiler's
	// vtableSlotCountForInfo).  The VM registers each vtable's extent
	// [Addr, Addr + SlotCount*ptr); an interface UPCAST to a parent advances the
	// iface value's vtable word to the parent sub-block (interior to Addr), so the
	// VM range-resolves that interior word to the matching shim slot.  Without the
	// extent an exact-match lookup would miss the adjusted word and abort.
	SlotCount int
}

// SatEntryInfo is a compiled package's metadata for one interface-satisfaction
// fact `(T, J)`: the concrete type's RTTI record, the interface's identity marker,
// the sub-vtable to install when `x.(*J)` recovers a `T`, and the two symbol
// NAMES a bytecode-VM host needs to map that RTTI across modes.  This is exactly
// the `__satentry.<T,J>` global's payload — the node IS that weak, ODR-coalesced
// record (a 2-word static-managed header then these fields), so the descriptor's
// `SatEntries` table points straight at it with no copy.  Type/Iface/Vtable are
// raw global addresses (no managed header), emitted with addend 0.
type SatEntryInfo struct {
	// Type is `&TypeInfo(T)` — the concrete type's per-type RTTI record; a
	// scrutinee's dynamic-type token an interface assertion matches on.
	Type *uint8
	// Iface is `&IfaceId(J)` — the interface's address-only identity marker; the
	// assertion site references the same symbol, so pointer-equality decides.
	Iface *uint8
	// Vtable is `&__ivt.<T>__<J>` — the sub-vtable (J's any-block at offset 0) a
	// recovered `@J`/`*J` value of T carries.
	Vtable *uint8
	// TypeSym is T's canonical NEUTRAL `__typeinfo.<T>` symbol NAME (a rodata
	// string).  Native RTTI is address-only, so a bytecode-VM host importing this
	// package keys its data-symbol table on this name to bind the native Type
	// address to a VM-resolvable identity (cross-mode type assertions).  The
	// native reader ignores it — it reads only Type/Iface/Vtable.
	TypeSym *[]readonly char
	// IfaceSym is J's canonical NEUTRAL `__ifaceid.<J>` symbol NAME — the parallel
	// for the interface identity (the `__ifaceid` marker is a 1-byte address-only
	// blob carrying no name-string of its own, so J's symbol name can only travel
	// here), letting the VM resolve J to its VM-canonical IfaceId marker.
	IfaceSym *[]readonly char
}

// FunctionInfo is a compiled package's metadata for one exported function:
// the precomputed VM-dispatch metadata (`RetbufSize`, `ParamSlots`) plus a
// callable function value and an opaque signature string.  It carries NO
// structured type info — the binding path (`vmInst.RegisterExtern`) needs
// only these scalars and the qualified name.  Each node is immortal static-
// managed, like its `Package`.
type FunctionInfo struct {
	// Pkg back-points at the owning package node (the VM binder ignores it).
	Pkg @Package
	// Name is the FULLY-QUALIFIED name, e.g. "pkg/builtins/rt.Alloc" — the
	// form `LookupExtern` / `RegisterExtern` key on.
	Name *[]readonly char
	// Value is `&@__handle.<mangled>`, the 16-byte {vtable,data} function-
	// value block (NOT a raw fn pointer); both the funcvalue address and the
	// raw fn address the binder needs derive from it.
	Value *uint8
	// RetbufSize is the VM's cross-mode scalar-vs-aggregate dispatch
	// discriminator (load-bearing): the aggregate RETBUF byte size (rounded
	// to N*8) when the function returns via a retbuf, or 0 for a scalar /
	// void return.  Computed by types.AggregateReturnSize so it agrees with
	// codegen's isAggregateReturn shim-shape decision; `> 0` means the
	// aggregate-retbuf path, and the value is the retbuf size to reserve.
	RetbufSize int
	// ParamSlots is the packed int-slot count of the params (the 7-int
	// arg-packing fast path); future-proofing for the dispatch loop.
	ParamSlots int
	// Sig is the opaque mangled signature string (see types.Type.SigString);
	// the VM never parses it — signature-equality / debug / Phase-C hook.
	Sig *[]readonly char
}

// KIND_* are the reflect type-kind discriminators — the coarse tag stored in a
// TypeInfo's Kind (and each FieldInfo's Kind) telling a reader how to interpret a
// value's bytes.  This is a cross-artifact contract: the compiler emits these
// values into the `__typeinfo` record (irdata's KIND_*), and readers here match
// them, so the numeric values are PINNED in spec §7.13.14 and MUST equal irdata's
// — do not renumber.  KIND_UINT covers bare `char`/`uint8` (a number, like Go
// `byte`); a char-slice is KIND_STRING (text).
const (
	KIND_OTHER int = 0  // fallback / not classified
	KIND_INT int = 1    // signed integer (any width)
	KIND_UINT int = 2   // unsigned integer (any width; incl. char/uint8)
	KIND_FLOAT int = 3  // float32 / float64
	KIND_BOOL int = 4
	KIND_STRING int = 5 // char-slice (*[]char / @[]char, readonly variants)
	KIND_STRUCT int = 6
	KIND_ARRAY int = 7
	KIND_SLICE int = 8  // non-char slice
	KIND_PTR int = 9    // raw or managed pointer
	KIND_IFACE int = 10
	KIND_FUNC int = 11  // raw or managed function value
)

// FieldInfo describes one struct field.  It is OVERLAID directly on an 8-word
// FieldEntry of the compiler-emitted `__typefields.<T>` blob (spec §7.13.14), so
// its field offsets must match that byte layout exactly:
//   Name (words 0-1, a {ptr,len} raw slice), Offset (word 2), Kind (word 3),
//   Size (word 4), Type (word 5), ElemKind (word 6), ElemSize (word 7).
type FieldInfo struct {
	// Name is the field's source name (into the type's field-name blob).
	Name *[]readonly char
	// Offset is the field's byte offset within the struct.
	Offset int
	// Kind is the field type's KIND_* discriminator.
	Kind int
	// Size is the field type's byte size (so a reader loads a scalar of the
	// right width without dereferencing Type).
	Size int
	// Type is the `__typeinfo` record (`*reflect.TypeInfo`, bit_cast from `*uint8`)
	// to RECURSE into for this field's value: for a KIND_STRUCT field its own
	// record; for a KIND_ARRAY / KIND_SLICE field whose ELEMENT is a struct, the
	// element type's record; for a KIND_PTR field whose POINTEE is a struct, the
	// pointee type's record; else null.
	Type *uint8
	// ElemKind / ElemSize describe the "inner" type a reader steps into: an array/
	// slice field's ELEMENT, or a KIND_PTR field's POINTEE — its KIND_* and byte
	// size (an array of N holds Size/ElemSize elements inline; a slice reads its
	// {data,len} header; a pointer is followed to one pointee).  Both 0 for a
	// field that is neither an array/slice nor a pointer.
	ElemKind int
	ElemSize int
}

// TypeInfo describes a concrete type — the static per-type RTTI record a boxed
// value carries (via its vtable any-block slot 1).  It is OVERLAID directly on
// the 8-word `__typeinfo.<T>` record (spec §7.13.14), so its field offsets must
// match that byte layout exactly:
//   Dtor (word 0), Size (word 1), Align (word 2), Name (words 3-4, a {ptr,len}
//   raw slice), Kind (word 5), Fields (words 6-7, a {ptr,len} raw slice over the
//   `__typefields.<T>` blob).
type TypeInfo struct {
	// Dtor is the type's destructor handle (null if it needs none).
	Dtor *uint8
	// Size / Align are the type's byte size and alignment.
	Size  int
	Align int
	// Name is the type's canonical, path-qualified name.
	Name *[]readonly char
	// Kind is the type's KIND_* discriminator.
	Kind int
	// Fields is the struct's field table (declaration order); empty for a
	// non-struct.  Overlaid on record words 6-7 ({fields-ptr, field-count}).
	Fields *[]FieldInfo
}

// TypeOf returns the dynamic type's static RTTI record for the value boxed in x.
// A compiler intrinsic (spec §7.13.14): it reads the interface value's vtable
// any-block slot-1 `*TypeInfo` (OP_IFACE_TYPEINFO) and bit-casts it to
// `*TypeInfo`.  The record is immortal static data — safe to read but never
// freed.  Never returns nil for a non-nil boxed value.
func TypeOf(x *any) *TypeInfo

// DataOf returns the raw address of the value boxed in x — the interface value's
// data word.  A compiler intrinsic: the byte pointer a reader uses (with a
// TypeInfo's field offsets) to read the boxed value's fields.  For a value boxed
// by pointer (`&s`) this is that pointer; for a value boxed by value it points at
// the boxed storage.  The bytes it references live as long as the boxed value.
func DataOf(x *any) *uint8
