// Package rt is the Binate runtime, providing reference-counted
// memory management (alloc, free, refcount inc/dec), managed-slice
// creation, boxing, and bounds checking.
//
// The libc-target implementation (impls/core/libc) reaches the C
// allocator + exit directly via `__c_call("malloc"/"calloc"/"free"/
// "exit", ...)`. A libc-free target (e.g. ARM32 bare-metal) ships an
// entirely different pkg/builtins/rt — for example, a Binate-implemented
// bump allocator + asm/semihosting Exit. rt is native-only in the
// bytecode VM (its `__c_call`s cannot be interpreted; it is resolved
// through registered native externs). The .bni surface documented here
// is the language-level contract that any pkg/builtins/rt impl must
// honor.
package "pkg/builtins/rt"

// ManagedHeader is the rt-managed allocation prefix at a negative
// offset from the payload pointer.  Always 2 words; size is host-
// dependent (16 on LP64, 8 on a 32-bit target).
//
// Layout:
//   Refcount — current reference count.
//   FreeFn   — pointer to the allocator-chosen free function
//              (stored as an int; bit-cast at the use site).
//
// Consumers that need to reach the header from a payload pointer
// should use `sizeof(ManagedHeader)` for the byte distance — see
// pkg/binate/vm's MANAGED_HDR (a same-package const-fold mirror, needed
// because current bnc doesn't const-fold cross-package
// `sizeof(rt.ManagedHeader)` at the use site) and the
// BC_REFINC_INLINE / BC_REFDEC_INLINE_FAST handlers as the
// canonical examples.
type ManagedHeader struct {
	Refcount int
	FreeFn   int
}

// STATIC_REFCOUNT is the sentinel Refcount value stored in the header of
// immortal static-managed data — pre-initialized managed objects emitted
// into the binary (e.g. the package-descriptor nodes) that are never heap-
// allocated and must never be freed.  RefInc/RefDec treat any header whose
// Refcount is negative as immortal and short-circuit (no increment, no
// decrement, no free), so a static node's count is never mutated.  The
// canonical emitted value is deeply negative (far from both 0 and the
// underflow boundary) so a missing guard still can't drive it to zero.
const STATIC_REFCOUNT int = -1073741824

// Function-value `data`-record kind tags. When the data slot of a
// function value is non-null, it points at a record whose first
// word is one of these constants. See `plan-function-values.md`
// (Phase 3) for the dispatch design.
const (
	DATA_KIND_VM_CLOSURE_REC int = 1
	DATA_KIND_COMPILED_CLOSURE int = 2
)

// _call_shim_scalar is a compiler-internal indirect-call helper
// for the per-function shim convention `<ret>(*uint8 data, <args>)`
// (Slice 3.1 of plan-function-values-phase-3.md). Used by the VM's
// BC_CALL_FUNC_VALUE handler to dispatch compiled-side function
// values from bytecode (Slice 3.3). NOT a real linkable symbol —
// IR-gen recognizes the name and lowers to OP_CALL_INDIRECT. The
// fixed 7-int-arg shape mirrors vm.TrampolineScalar's variadic-
// style register-bank reading: per AAPCS, register args land in
// X1..X7 deterministically; the shim reads only the first
// f.NumParams of them. Args beyond the caller's actual count are
// uninitialized but unread. Bootstrap-subset constraint: scalars
// only, no floats / aggregates / >7 args. See `_call_dtor` in
// scripts/hygiene/naming.whitelist.
func _call_shim_scalar(fn *uint8, data *uint8,
	a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) int

// _call_shim_aggregate is the aggregate-return counterpart to
// _call_shim_scalar.  Used to dispatch aggregate-return function
// values (slices, managed-slices, multi-word structs) through the
// retbuf-style shim emitted by emit_funcvals.bn for aggregate returns.
// Caller allocates a retbuf of the aggregate type's size, passes its
// address; the shim writes the result there and returns void; caller
// reads back from the retbuf.  NOT a real linkable symbol — IR-gen
// recognizes the name and lowers to OP_CALL_INDIRECT, same as
// _call_shim_scalar / _call_dtor / _call_free_fn.
//
// Same fixed 7-user-arg shape as _call_shim_scalar.  See
// `_call_shim_aggregate` in scripts/hygiene/naming.whitelist.
func _call_shim_aggregate(fn *uint8, retbuf *uint8, data *uint8,
	a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int)

// ShimPair is the two-word by-value return of `_call_shim_pair`: the
// X0:X1 register pair an AArch64/x86-64 callee returns for a 9–16-byte
// aggregate.  Both words are carried as raw `int` bits — `_call_shim_pair`
// reinterprets whatever the callee actually returned (an interface value's
// {data, vtable}, a raw slice's {ptr, len}, a 2-word struct) without any
// per-field managed handling, so the GP register pair is captured verbatim
// for the caller to copy out.
type ShimPair struct {
	Lo int
	Hi int
}

// _call_shim_pair calls a RAW callee fn with the scalar shim's
// `<ret>(*uint8 data, <args>)` shape (data in X0, a0..a6 in X1..X7) but
// captures a 9–16-byte BY-VALUE aggregate return — the register pair
// X0:X1 (AAPCS64) / RAX:RDX (SysV).  Unlike `_call_shim_aggregate` (which
// targets a retbuf-first *shim*), this targets a raw method fn pointer
// straight out of an interface `@__ivt` slot, which returns ≤16-byte
// aggregates in registers, not through a retbuf.  Declaring the result as
// the 16-byte `ShimPair` makes IR-gen lower the OP_CALL_INDIRECT through
// the generic small-single-aggregate return path, which already spills
// X0→[0]/X1→[8]; no backend special-casing is needed.  NOT a real linkable
// symbol — IR-gen recognizes the name and lowers to OP_CALL_INDIRECT, same
// as _call_shim_scalar.  Same fixed 7-user-arg shape.  See
// `_call_shim_pair` in scripts/hygiene/naming.whitelist.
func _call_shim_pair(fn *uint8, data *uint8,
	a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) ShimPair

// ShimQuad is the four-word (32-byte) by-value return of `_call_shim_quad`: a
// raw compiled method's 17–32-byte aggregate (e.g. a managed-slice `@[]T`, four
// words; an `errors.Error.Error()` result).  Such a return comes back through
// the X8 sret buffer, not registers; the four words are captured verbatim as
// raw `int` bits, no per-field managed handling.
type ShimQuad struct {
	A int
	B int
	C int
	D int
}

// _call_shim_quad is the >16-byte (≤32) counterpart to `_call_shim_pair`: it
// calls a RAW callee fn `<ret>(*uint8 data, <args>)` and captures a 17–32-byte
// by-value aggregate return.  Such a return comes back through the X8 sret
// buffer (the AAPCS64 / SysV convention for aggregates > 16 bytes), so
// declaring the result as the 32-byte `ShimQuad` makes IR-gen lower the
// OP_CALL_INDIRECT through the generic big-single-aggregate (sret) return path
// — the callee writes the four words there.  Same raw-fn target + fixed
// 7-user-arg shape as `_call_shim_pair`.  NOT a real linkable symbol — IR-gen
// recognizes the name and lowers to OP_CALL_INDIRECT.  See `_call_shim_quad`
// in scripts/hygiene/naming.whitelist.
func _call_shim_quad(fn *uint8, data *uint8,
	a0 int, a1 int, a2 int, a3 int, a4 int, a5 int, a6 int) ShimQuad

// Exit terminates the process with the given exit code. Use this
// rather than the C `exit` directly so call sites stay at the right
// level of abstraction (a non-libc pkg/builtins/rt impl wires Exit to
// whatever its target uses).
func Exit(code int)

// RawAlloc allocates size bytes of uninitialized, unmanaged memory.
//
// Precondition: size > 0. Calling with size <= 0 aborts the process.
// On success: returns a non-null pointer to size uninitialized bytes.
// On out-of-memory: aborts the process (does not return null).
//
// The caller must release the result with RawFree. For managed
// (refcounted) allocations, use Alloc instead.
func RawAlloc(size int) *uint8

// RawAllocZero allocates size bytes of zero-initialized, unmanaged
// memory. Parallel to RawAlloc — callers that want count*size bytes
// must compute the product themselves.
//
// Precondition: size > 0. Calling with size <= 0 aborts the process.
// On success: returns a non-null pointer to size zero bytes.
// On out-of-memory: aborts the process (does not return null).
//
// The caller must release the result with RawFree.
func RawAllocZero(size int) *uint8

// RawFree releases an allocation previously returned by RawAlloc or
// RawAllocZero. Calling with nil is a no-op. Double-free is undefined
// behavior. Distinct from Free, which releases managed (refcounted)
// allocations and walks the management header.
func RawFree(ptr *uint8)

// MemCopy copies size bytes from src to dst. The two regions must
// not overlap — for overlapping regions, use a future MemMove.
//
// Precondition: size >= 0. Calling with size < 0 aborts the process.
// When size > 0: dst and src must each point to a region of at least
// size bytes (writable / readable respectively), and the regions
// must not overlap.
// When size == 0: dst and src may be nil; the call is a no-op
// (differs from C, which leaves NULL+0 as undefined).
func MemCopy(dst *uint8, src *readonly uint8, size int)

// MemZero writes size zero bytes starting at ptr.
//
// Precondition: size >= 0. Calling with size < 0 aborts the process.
// When size > 0: ptr must point to a writable region of at least
// size bytes.
// When size == 0: ptr may be nil; the call is a no-op (differs
// from C, which leaves NULL+0 as undefined).
func MemZero(ptr *uint8, size int)

// BoundsFail prints a bounds-check failure diagnostic and aborts the
// process. Does not return. Used by the bounds-check IR-emit path and
// by the bytecode VM's extern dispatch.
func BoundsFail(index int, length int)

// DivFail prints an integer divide-fault diagnostic and aborts the
// process. Does not return. kind selects the message: 0 = divide by
// zero, 1 = signed MIN / -1 overflow. The DivCheck guard analogue of
// BoundsFail.
func DivFail(kind int)

// _call_dtor is a compiler-internal indirect-call helper: NOT a real
// function. The declaration exists only so RefDec's call site type-
// checks against the expected signature `void(*uint8, *uint8)`. IR-gen
// recognizes the `_call_dtor` symbol and emits OP_CALL_INDIRECT in
// place of OP_CALL — the first argument (dtor) becomes the function
// pointer; the rest are passed as call args. The leading underscore
// signals "do not call from regular Binate code." See `_call_dtor` in
// scripts/hygiene/naming.whitelist for the matching hygiene exception.
func _call_dtor(dtor *uint8, ptr *uint8)

// _call_free_fn is a compiler-internal indirect-call helper for the
// rt's free-function dispatch — NOT a real function. Same shape as
// _call_dtor (IR-gen emits OP_CALL_INDIRECT) and same lowering; the
// distinct name documents intent at the call site (Free's call to the
// header-stored free function rather than RefDec's call to a dtor).
// See `_call_free_fn` in scripts/hygiene/naming.whitelist.
func _call_free_fn(freeFn *uint8, ptr *uint8)

// Alloc allocates a managed payload of the given size with a 16-byte
// management header (refcount=1, free_fn=null) at negative offset.
func Alloc(payloadSize int) *uint8

// Free releases a managed allocation (header + payload).
func Free(ptr *uint8)

// RefInc increments the reference count. No-op on nil.
func RefInc(ptr *uint8)

// RefDec decrements the reference count. When it reaches 0, calls dtor(ptr)
// if dtor is non-nil, then frees the allocation. No-op if ptr is nil.
func RefDec(ptr *uint8, dtor *uint8)

// ZeroRefDestroy is the slow-path helper for the inline RefDec fast
// path: backends that inline RefDec call ZeroRefDestroy when the
// decrement leaves the refcount at zero. Calls dtor(ptr) if dtor is
// non-nil, then frees the allocation. ptr is non-nil at this point
// (the inline fast path filtered nil). See plan-refcount-inlining.md.
func ZeroRefDestroy(ptr *uint8, dtor *uint8)

// Refcount returns the current reference count of a managed allocation.
// Use bit_cast(*uint8, managedPtr) to obtain the raw pointer argument.
func Refcount(ptr *uint8) int

// ManagedSlice layout matches @[]T: { data, len, backing_refptr, backing_len }.
type ManagedSlice struct {
	Data       *uint8
	Len        int
	Refptr     *uint8
	BackingLen int
}

// Box copies size bytes from src into a new managed allocation and returns it.
func Box(src *uint8, size int) *uint8

// BoundsCheck panics if index is out of [0, length).
func BoundsCheck(index int, length int)

// DivCheck panics if an integer divide/remainder would fault: the
// divisor is zero, or (when isSigned != 0) the dividend equals the
// type's signed minimum and the divisor is -1 (the MIN / -1 overflow).
// dividend and divisor are the sign/zero-extended 64-bit operands;
// signedMin is the type's most-negative value (ignored when isSigned
// is 0). The divisor analogue of BoundsCheck — emitted as a guard
// before OP_DIV / OP_REM; `unsafe_div` / `unsafe_rem` skip it.
func DivCheck(dividend int64, divisor int64, signedMin int64, isSigned int)

// MakeManagedSlice allocates a managed backing array for length elements of
// elemSize bytes each and returns a ManagedSlice with refcount=1.
func MakeManagedSlice(elemSize int, length int) ManagedSlice
