// Package softfloat provides IEEE-754 soft-float arithmetic, comparison, and
// conversion routines in pure Binate (integer bit-manipulation on uint32 /
// uint64 — it uses no float operations itself).  It backs the ARM-EABI
// (__aeabi_*) soft-float helper symbols on the C-free arm32-baremetal target:
// the native backend emits `bl __aeabi_dadd` etc., which thin bnas shims
// (runtime/baremetal_arm32/aeabi_float.s) tail-call into the functions here.
// This replaces the corresponding members of GCC's libgcc.a (the C-Free goal).
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  See the impl files + git history
// for the specific changes.
package "pkg/builtins/softfloat"

// F32ToF64 widens a float32 (IEEE binary32 bit pattern) to a float64 (binary64
// bit pattern).  Exact — binary64 represents every binary32 value.  Backs
// __aeabi_f2d.
func F32ToF64(a uint32) uint64

// F64ToI32 converts a float64 (binary64 bit pattern) to int32, rounding toward
// zero and saturating on overflow.  Backs __aeabi_d2iz.
func F64ToI32(a uint64) int

// F64ToF32 narrows a float64 (binary64 bit pattern) to a float32 (binary32 bit
// pattern), round to nearest ties to even.  Backs __aeabi_d2f.
func F64ToF32(a uint64) uint32

// F64Add computes a+b (binary64), round to nearest even.  Backs __aeabi_dadd.
func F64Add(a uint64, b uint64) uint64

// F64Sub / F64Rsub compute a-b / b-a.  Back __aeabi_dsub / __aeabi_drsub.
func F64Sub(a uint64, b uint64) uint64

func F64Rsub(a uint64, b uint64) uint64

// I32ToF64 / U32ToF64 / I64ToF64 / U64ToF64 convert an integer to a float64 bit
// pattern (round to nearest even).  Back __aeabi_i2d / ui2d / l2d / ul2d.
func I32ToF64(a int32) uint64

func U32ToF64(a uint32) uint64

func I64ToF64(a int64) uint64

func U64ToF64(a uint64) uint64

// F32Add computes a+b (binary32), round to nearest even.  Backs __aeabi_fadd.
func F32Add(a uint32, b uint32) uint32

// F32Sub / F32Rsub compute a-b / b-a (binary32).  Back __aeabi_fsub / frsub.
func F32Sub(a uint32, b uint32) uint32

func F32Rsub(a uint32, b uint32) uint32

// I32ToF32 / U32ToF32 / I64ToF32 / U64ToF32 convert an integer to a float32 bit
// pattern (round to nearest even).  Back __aeabi_i2f / ui2f / l2f / ul2f.
func I32ToF32(a int32) uint32

func U32ToF32(a uint32) uint32

func I64ToF32(a int64) uint32

func U64ToF32(a uint64) uint32

// F32Mul / F32Div compute a*b / a/b (binary32), round to nearest even.  Back
// __aeabi_fmul / __aeabi_fdiv.
func F32Mul(a uint32, b uint32) uint32

func F32Div(a uint32, b uint32) uint32

// F64Mul / F64Div compute a*b / a/b (binary64), round to nearest even.  Back
// __aeabi_dmul / __aeabi_ddiv.
func F64Mul(a uint64, b uint64) uint64

func F64Div(a uint64, b uint64) uint64

// F64Cmp{Eq,Lt,Le,Gt,Ge,Un} return 1/0 for the binary64 relation (every
// ordered relation is 0 when either operand is NaN; Un is 1 iff NaN).  Back
// __aeabi_dcmp{eq,lt,le,gt,ge,un}.
func F64CmpEq(a uint64, b uint64) int

func F64CmpLt(a uint64, b uint64) int

func F64CmpLe(a uint64, b uint64) int

func F64CmpGt(a uint64, b uint64) int

func F64CmpGe(a uint64, b uint64) int

func F64CmpUn(a uint64, b uint64) int

// F32Cmp{Eq,Lt,Le,Gt,Ge,Un} return 1/0 for the binary32 relation; see the
// F64Cmp family.  Back __aeabi_fcmp{eq,lt,le,gt,ge,un}.
func F32CmpEq(a uint32, b uint32) int

func F32CmpLt(a uint32, b uint32) int

func F32CmpLe(a uint32, b uint32) int

func F32CmpGt(a uint32, b uint32) int

func F32CmpGe(a uint32, b uint32) int

func F32CmpUn(a uint32, b uint32) int
