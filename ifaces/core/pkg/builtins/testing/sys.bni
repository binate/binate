// Package testing/sys is testing's lang-free low-level layer: the canonical
// TestResult type and the per-target standard-output sink WriteStdout.  It is
// deliberately lang-free so that pkg/builtins/lang's OWN tests can name TestResult
// (their return type) by depending on THIS package instead of pkg/builtins/testing
// — which testing.Print/Println turn into a `testing -> lang -> testing` import
// cycle by importing lang for Stringer dispatch.  See the TestResult doc in
// pkg/builtins/testing (the re-export) and explorations/claude-todo.md.
package "pkg/builtins/testing/sys"

// TestResult is the canonical return type for test functions — a *distinct* named
// char-slice type, so returning it is an explicit, type-checked label the --test
// runner keys on (not a bare `@[]char`).  pkg/builtins/testing re-exports it as
// `type TestResult = sys.TestResult`.  Empty means pass; non-empty is the failure
// message.  The underlying `@[]char` is unnamed, so a plain char slice (a string
// literal, a builder result) still assigns without a cast.
type TestResult @[]char

// WriteStdout writes n bytes at ptr to standard output.  Per-target: write(2) on
// fd 1 (hosted) or the semihosting console (bare metal).  This is PROGRAM output —
// distinct from rt's fault diagnostics, which go to standard error.  A short write
// or error is ignored (test output is best-effort).
func WriteStdout(ptr *uint8, n int)
