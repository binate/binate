// Package big provides arbitrary-precision arithmetic.  This first cut
// implements Nat, an unsigned integer.  A signed Int wrapping Nat (to
// eventually replace pkg/binate/bignum), and possibly Float, are planned
// follow-ups; see explorations/plan-strconv-float.md.
package "pkg/math/big"

// Nat is an arbitrary-precision unsigned integer, stored as little-endian
// base-2^32 limbs: the value is sum(limbs[i] << (32*i)) for i in 0..nlimbs.
//
// uint32 limbs keep any single-limb product within uint64 (Binate has no
// 128-bit integer type), so all limb arithmetic runs in uint64.  `limbs`
// may be over-allocated; `nlimbs` is the count of significant limbs.
// Normalized invariant: nlimbs == 0 (the canonical zero) or the top limb
// limbs[nlimbs-1] is nonzero.  A Nat owns its limb backing and is always
// used as @Nat.
type Nat struct {
	limbs  @[]uint32
	nlimbs int
}

// New returns a fresh Nat with value 0.
func New() @Nat

// FromUint64 returns a fresh Nat with the given value.
func FromUint64(v uint64) @Nat

// Clone returns a deep copy of x — a fresh Nat owning its own backing.
func (x @Nat) Clone() @Nat

// IsZero reports whether x is zero.
func (x @Nat) IsZero() bool

// BitLen returns the number of bits in x's minimal representation, i.e.
// floor(log2(x)) + 1, and 0 for x == 0.
func (x @Nat) BitLen() int

// Cmp returns -1, 0, or 1 as x is less than, equal to, or greater than y.
func (x @Nat) Cmp(y @Nat) int

// IsUint64 reports whether x fits in a uint64 (at most two limbs).
func (x @Nat) IsUint64() bool

// ToUint64 returns x's low 64 bits.  Callers that require a faithful value
// should check IsUint64 first.
func (x @Nat) ToUint64() uint64

// SetUint64 sets z to v and returns z.
func (z @Nat) SetUint64(v uint64) @Nat

// Set sets z to the value of x and returns z.  z may alias x.
func (z @Nat) Set(x @Nat) @Nat
