// Package cmp provides Eq[K], the equality policy a hash-based container uses to test
// key equality, plus two ready adapters: Default[K] (forward to the key type's own
// lang.Comparable.Compare) and FnEq[K] (wrap an arbitrary *func(K, K) bool).  It lives
// in the stable `std` layer (`pkg/std/cmp`).  `pkg/stdx/cmp` is a compat forwarder
// (`expose "pkg/std/cmp"`) that keeps existing `import "pkg/stdx/cmp"` consumers
// resolving the same entities.  See explorations/pkg-layout-spec.md.
//
// Eq[K] takes both keys as PARAMETERS (Equal(a K, b K) bool) rather than a receiver,
// so unlike lang.Comparable it carries no Self and can be supplied as an injected,
// per-container policy: a zero-size Default[K] monomorphizes e.Equal(a, b) to a direct
// a.Compare(b) == 0 (the same test the intrinsic path emits), while FnEq[K] routes
// each comparison through an injected function for keys that are not — or should not
// be — lang.Comparable.  It is equality-only by design; three-way ordering (for
// ordered/tree containers) is a separate Ord[K] to be introduced when one exists.
// Pairs with pkg/stdx/hash's Hasher[K] as the (hash, equality) a hash container needs.
//
// The types are generic, so their bodies live here in the interface file: a consumer
// monomorphizes each instantiation at its own call site from this source.
package "pkg/std/cmp"

import "pkg/builtins/lang"

// Eq[K] tests whether two keys of type K are equal.  A hash-based container takes an
// Eq as a type parameter (`E Eq[K]`) and calls e.Equal(key, stored) to confirm a probe
// hit.  Equal must be reflexive, symmetric, and transitive, and agree with the
// accompanying Hasher (equal keys hash equal).
interface Eq[K any] {
	Equal(a K, b K) bool
}

// Default[K] forwards to the key type's own lang.Comparable.Compare, treating a zero
// result as equal.  It is zero-size, so a container parameterized by Default[K]
// monomorphizes e.Equal(a, b) to a direct a.Compare(b) == 0 — the same test the
// intrinsic Comparable path emits, with no indirection.
type Default[K lang.Comparable] struct {}

func (e Default[K]) Equal(a K, b K) bool {
	return a.Compare(b) == 0
}

impl Default[K] : Eq[K]

// FnEq[K] is the Eq backed by an injected equality function; build one with Fn(fn).
// The container routes every comparison through fn, so K need not be lang.Comparable.
// The function is a raw *func — it captures nothing the container must keep alive; an
// equality owning captured state would be a future @func variant.
type FnEq[K any] struct {
	fn *func(K, K) bool
}

// Fn wraps an equality function as a FnEq[K].
func Fn[K any](fn *func(K, K) bool) FnEq[K] {
	var e FnEq[K]
	e.fn = fn
	return e
}

func (e FnEq[K]) Equal(a K, b K) bool {
	return e.fn(a, b)
}

impl FnEq[K] : Eq[K]
