// Package flags is a small command-line flag parser, the standard-library
// replacement for the hand-rolled `for i` + string-compare loops each cmd/*
// tool copy-pastes today.  It lives in the stable `std` layer (`pkg/std/flags`);
// see explorations/pkg-layout-spec.md.
//
// Model (Go-`flag`-shaped, deliberately not GNU getopt):
//
//   - Dash-insensitive: `-name` and `--name` are the same flag.  A flag has a
//     primary NAME plus an optional one-char ALIAS, each matchable with either
//     dash (so `-v`, `-verbose`, and `--verbose` are one flag with name
//     "verbose", alias "v").  No `-abc` bundling, no attached `-oX` values.
//   - Values: `--name value`, `--name=value`, `-a value`, `-a=value`.  A value
//     flag consumes the literal next token as its value; a bool flag never
//     consumes the next token (bare `--flag` sets true, `--flag=false` clears).
//   - Parsing STOPS at the first positional (a non-flag token) or at `--`
//     (consumed); that token and everything after it are returned as the
//     positionals.  There is no interspersing of flags and positionals — a
//     glob like `foo *` cannot inject flags.  The stop point is also where a
//     consumer hands the tail to a subcommand FlagSet (dispatch on the first
//     positional, re-parse the rest).
//   - Strict: an unrecognized `-`/`--` token is an error, as is a value flag
//     with no value, or a malformed integer value.
//
// Destinations bind by pointer — each registrar takes `&field`, so a tool fills
// its own result struct in place (mirroring the CLIArgs-style structs the tools
// already use), then reads the fields after Parse.
//
// Every string the FlagSet keeps is a managed slice it owns a reference to — a
// flag's name/alias/usage and default, and each parsed value/positional (which
// shares its argument-vector backing, kept alive by refcounting).  So a caller
// need not keep any of its inputs (or the argument vector) alive past a call.
//
// `--version` / `-h` need no special pre-scan: register them as ordinary bool
// flags and check them before any positional-count validation (Parse never
// requires positionals).
package "pkg/std/flags"

// Flag is one registered flag.  Its fields are package-private: a consumer sees
// only the opaque type (it never constructs or inspects a Flag), registering
// through the FlagSet methods below and reading results through its own bound
// destinations.  The five destination pointers are a tagged union — `kind`
// selects the one in use; the rest stay nil.
type Flag struct {
	name  @[]readonly char // primary name (matched with either dash)
	alias @[]readonly char // one-char alias, or empty for none
	usage @[]readonly char // help text for Usage()
	kind  int // one of the private kind* tags
	sep   char // element separator for a split string-list, else 0
	pbool *bool
	pstr  *@[]char
	pint  *int
	puint *uint
	plist *@[]@[]char
}

// FlagSet is a collection of registered flags to parse one argument vector
// against.  Obtain one from New, register flags with the *Var methods, then
// Parse.  Hold it as the @FlagSet New returns.
type FlagSet struct {
	name  @[]readonly char // program name, for Usage()
	flags @[]Flag
}

// New returns an empty FlagSet labeled `name` (used only by Usage()).
func New(name @[]readonly char) @FlagSet

// BoolVar registers a boolean flag bound to *p (a bare `--name` sets it true;
// `--name=false` clears it).  alias is a one-char short form, or "" for none.
func (fs @FlagSet) BoolVar(p *bool, name @[]readonly char, alias @[]readonly char,
		usage @[]readonly char)

// StringVar registers a string flag bound to *p, initialized to def (shared into
// *p, not copied).  A parsed value shares backing with the argument vector — no
// copy; it is a managed slice, so refcounting keeps it alive on its own.
func (fs @FlagSet) StringVar(p *@[]char, name @[]readonly char, alias @[]readonly char, def @[]char,
		usage @[]readonly char)

// IntVar registers a signed decimal flag bound to *p, initialized to def.  A
// non-numeric or out-of-range value is a parse error.
func (fs @FlagSet) IntVar(p *int, name @[]readonly char, alias @[]readonly char, def int,
		usage @[]readonly char)

// UintVar registers an unsigned decimal flag bound to *p, initialized to def.
// A non-numeric, negative, or out-of-range value is a parse error.
func (fs @FlagSet) UintVar(p *uint, name @[]readonly char, alias @[]readonly char, def uint,
		usage @[]readonly char)

// StringListVar registers a repeatable string flag: each occurrence appends one
// value to *p (which it resets to empty first).
func (fs @FlagSet) StringListVar(p *@[]@[]char, name @[]readonly char, alias @[]readonly char,
		usage @[]readonly char)

// StringListSepVar is StringListVar whose every occurrence is additionally
// split on sep, so `-I a:b:c` (sep ':') contributes three entries just as
// `-I a -I b -I c` would.  Empty split entries are dropped.
func (fs @FlagSet) StringListSepVar(p *@[]@[]char, name @[]readonly char, alias @[]readonly char,
		sep char, usage @[]readonly char)

// Parse consumes flags from args (the program's argument vector WITHOUT
// argv[0]), stopping at the first positional or `--`.  It returns the
// positionals and an error message; the message is empty ("") on success and a
// ready-to-print string (unknown flag, missing value, bad number) otherwise.
// The caller decides whether to print Usage() and exit.
func (fs @FlagSet) Parse(args @[]@[]char) (@[]@[]char, @[]readonly char)

// Usage renders one line per registered flag (its dash-prefixed name/alias, a
// `<value>` placeholder for value flags, and the usage text) under a header
// naming the program.  Intended for a tool's `-h` / error path.
func (fs @FlagSet) Usage() @[]readonly char
