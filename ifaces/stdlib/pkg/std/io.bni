// Package io defines Binate's byte-stream interfaces — Reader, Writer,
// and Closer, plus the positional ReaderAt / WriterAt — modeled on Go's
// io, adapted to Binate's borrow-based slices and errors-as-values
// convention.
//
// Buffers are raw-slice BORROWS, never managed-slices: an io method reads
// from / writes into a buffer the CALLER owns and outlives the call, so
// the parameter is a 2-word view — `*[]uint8` to write into,
// `*[]readonly uint8` to read from — never a `@[]uint8` the method would
// co-own.  The element type is `uint8`: these are BYTE streams (matching
// strconv's `*[]readonly uint8` inputs); text is a layer above, a
// char-slice view over the same bytes.
//
// Failure is reported as a trailing `@errors.Error`, empty on success and
// tested with `present` — the errors-as-values policy (see errors.bni).
package "pkg/std/io"

import "pkg/std/errors"

// EOF is the error a Reader returns when no more input is available: an
// ordinary errors-as-values error meaning "you asked to read and there is
// nothing left."  It is a process-lifetime sentinel, defined in io.bn.
var EOF @errors.Error

// IsEOF reports whether err is EOF — `errors.Is(err, EOF)`.  Because it
// goes through errors.Is, it matches EOF even when a Reader has wrapped
// it with context.  The idiomatic end-of-input test for a Reader
// consumer: `if io.IsEOF(err) { ... }`.
func IsEOF(err @errors.Error) bool

// Reader is the interface that wraps the basic Read method.
interface Reader {
	// Read reads up to `len(p)` bytes into p, returning the number read,
	// n (0 <= n <= len(p)), and any error.  p is a mutable borrow: Read
	// writes through it into the caller's backing and does NOT retain it
	// past the call.  A call that both consumes bytes and hits a problem
	// may return n > 0 alongside the error, so callers must honor n
	// before inspecting the error.
	Read(p *[]uint8) (int, @errors.Error)
}

// Writer is the interface that wraps the basic Write method.
interface Writer {
	// Write writes `len(p)` bytes from p, returning the number written,
	// n (0 <= n <= len(p)), and any error.  Write MUST return a non-empty
	// error when n < len(p).  p is a readonly borrow: Write reads through
	// it without mutating or retaining it.
	Write(p *[]readonly uint8) (int, @errors.Error)
}

// Closer is the interface that wraps the basic Close method.
interface Closer {
	// Close releases the resources the value holds.  Behavior after the
	// first call is implementation-defined; callers must not assume Close
	// is idempotent unless an implementation documents it.
	Close() @errors.Error
}

// ReaderAt is the interface that wraps the basic ReadAt method.
interface ReaderAt {
	// ReadAt reads `len(p)` bytes into p starting at byte offset `off`,
	// returning the count read and any error.  Unlike Read it carries an
	// explicit offset and keeps no stream position, so distinct ReadAt
	// calls do not interfere.  `off` is `int64` so offsets are
	// independent of the target word size — a 32-bit target can still
	// address a >2 GiB source.  p is a mutable borrow.
	ReadAt(p *[]uint8, off int64) (int, @errors.Error)
}

// WriterAt is the interface that wraps the basic WriteAt method.
interface WriterAt {
	// WriteAt writes `len(p)` bytes from p starting at byte offset `off`,
	// returning the count written and any error.  Like ReaderAt it keeps
	// no stream position; `off` is `int64`.  p is a readonly borrow.
	WriteAt(p *[]readonly uint8, off int64) (int, @errors.Error)
}
