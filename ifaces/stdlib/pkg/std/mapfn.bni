// Package mapfn is a compat forwarder: it re-exports pkg/std/containers/mapfn (spec
// §16.5.2 `pkg.expose`) at that package's former path.  It exists only for cmd/bnc's
// BUILDER-compiled tree, which must keep importing this path until the pinned
// BUILDER's bundled stdlib has pkg/std/containers.  Import "pkg/std/containers/mapfn".
package "pkg/std/mapfn"

expose "pkg/std/containers/mapfn"
