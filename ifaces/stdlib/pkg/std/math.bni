// Package math provides basic constants and mathematical functions for
// float64, modeled on Go's math package. This first cut covers the
// bit/sign/special-value core (Float64bits, Abs, Signbit, Copysign,
// NaN/Inf and their predicates) and the standard constants. Rounding,
// decomposition (Modf/Frexp/Ldexp), Sqrt, and the transcendental
// families follow.
//
// float64 only (as in Go); float32 callers convert.
package "pkg/std/math"

// Mathematical constants (full float64 precision). The values are
// duplicated in const.bn (the impl side); the two must stay in sync.
const (
	E float64 = 2.71828182845904523536028747135266249775724709369995957496696763
	Pi float64 = 3.14159265358979323846264338327950288419716939937510582097494459
	Phi float64 = 1.61803398874989484820458683436563811772030917980576286213544862

	Sqrt2 float64 = 1.41421356237309504880168872420969807856967187537694807317667974
	SqrtE float64 = 1.64872127070012814684865078781416357165377610071014801157507931
	SqrtPi float64 = 1.77245385090551602729816748334114518279754945612238712821380779
	SqrtPhi float64 = 1.27201964951406896425242246173749149171560804184009624861664038

	Ln2 float64 = 0.693147180559945309417232121458176568075500134360255254120680009
	Log2E float64 = 1.442695040888963407359924681001892137426645954152985934135449406931
	Ln10 float64 = 2.30258509299404568401799145468436420760110148862877297603332790
	Log10E float64 = 0.434294481903251827651128918916605082294397005803666566114453783658
)

// Floating-point limit values.
const (
	// MaxFloat64 is the largest finite float64 (0x7FEFFFFFFFFFFFFF).
	MaxFloat64 float64 = 1.7976931348623157e308
	// SmallestNonzeroFloat64 is the smallest positive (denormal) float64
	// (0x0000000000000001).
	SmallestNonzeroFloat64 float64 = 4.9406564584124654e-324
)

// Float64bits returns the IEEE 754 binary representation of f.
func Float64bits(f float64) uint64

// Float64frombits returns the float64 with IEEE 754 representation b.
func Float64frombits(b uint64) float64

// Abs returns the absolute value of x. Abs(±Inf)=+Inf, Abs(NaN)=NaN.
func Abs(x float64) float64

// Signbit reports whether x is negative or negative zero.
func Signbit(x float64) bool

// Copysign returns a value with the magnitude of f and the sign of sign.
func Copysign(f float64, sign float64) float64

// NaN returns an IEEE 754 "not-a-number" value.
func NaN() float64

// IsNaN reports whether f is an IEEE 754 "not-a-number" value.
func IsNaN(f float64) bool

// Inf returns positive infinity if sign >= 0, negative infinity if sign < 0.
func Inf(sign int) float64

// IsInf reports whether f is an infinity: sign > 0 tests +Inf, sign < 0
// tests -Inf, sign == 0 tests either.
func IsInf(f float64, sign int) bool

// Modf returns integer and fractional parts that sum to f; both share
// f's sign. Modf(±Inf) = ±Inf, NaN.
func Modf(f float64) (float64, float64)

// Floor returns the greatest integer value <= x.
func Floor(x float64) float64

// Ceil returns the least integer value >= x.
func Ceil(x float64) float64

// Trunc returns the integer value of x (rounding toward zero).
func Trunc(x float64) float64

// Round returns the nearest integer, rounding half away from zero.
func Round(x float64) float64

// RoundToEven returns the nearest integer, rounding ties to even.
func RoundToEven(x float64) float64

// Frexp breaks f into a normalized fraction and an integral power of two:
// f == frac * 2**exp with |frac| in [1/2, 1). Frexp(±0)=±0,0;
// Frexp(±Inf)=±Inf,0; Frexp(NaN)=NaN,0.
func Frexp(f float64) (float64, int)

// Ldexp is the inverse of Frexp: it returns frac * 2**exp. Ldexp(±0)=±0;
// Ldexp(±Inf)=±Inf; Ldexp(NaN)=NaN.
func Ldexp(frac float64, exp int) float64

// Max returns the larger of x or y (NaN- and ±0-aware, unlike the builtin
// max): Max(x,+Inf)=+Inf, Max(x,NaN)=NaN, Max(-0,-0)=-0 else Max(±0,±0)=+0.
func Max(x float64, y float64) float64

// Min returns the smaller of x or y (NaN- and ±0-aware, unlike the builtin
// min): Min(x,-Inf)=-Inf, Min(x,NaN)=NaN, Min(+0,+0)=+0 else Min(±0,±0)=-0.
func Min(x float64, y float64) float64

// Dim returns the maximum of x-y or 0. Dim(±Inf,±Inf) same sign = NaN;
// Dim(x,NaN)=Dim(NaN,x)=NaN.
func Dim(x float64, y float64) float64

// Mod returns the floating-point remainder of x/y; the result's magnitude
// is < |y| and its sign agrees with x. Mod(±Inf,y)=NaN, Mod(x,0)=NaN,
// Mod(x,±Inf)=x, Mod(NaN,y)=Mod(x,NaN)=NaN.
func Mod(x float64, y float64) float64

// Remainder returns the IEEE 754 floating-point remainder of x/y (quotient
// rounded to nearest, ties to even). Remainder(±Inf,y)=NaN, Remainder(x,0)
// =NaN, Remainder(x,±Inf)=x, Remainder(NaN,y)=Remainder(x,NaN)=NaN.
func Remainder(x float64, y float64) float64

// Sqrt returns the correctly-rounded square root of x. Sqrt(+Inf)=+Inf,
// Sqrt(±0)=±0, Sqrt(x<0)=NaN, Sqrt(NaN)=NaN.
func Sqrt(x float64) float64

// Hypot returns Sqrt(p*p + q*q), avoiding overflow/underflow.
// Hypot(±Inf,q)=Hypot(p,±Inf)=+Inf; Hypot(NaN,q)=Hypot(p,NaN)=NaN.
func Hypot(p float64, q float64) float64

// Cbrt returns the cube root of x. Cbrt(±0)=±0, Cbrt(±Inf)=±Inf,
// Cbrt(NaN)=NaN.
func Cbrt(x float64) float64

// Exp returns e**x, the base-e exponential of x. Exp(+Inf)=+Inf,
// Exp(NaN)=NaN; large x overflows to +Inf, very negative x to 0.
func Exp(x float64) float64

// Exp2 returns 2**x, the base-2 exponential of x. Special cases are as for Exp.
func Exp2(x float64) float64

// Expm1 returns e**x - 1, accurate even when x is near zero. Expm1(+Inf)=+Inf,
// Expm1(-Inf)=-1, Expm1(NaN)=NaN.
func Expm1(x float64) float64

// Log returns the natural logarithm of x. Log(+Inf)=+Inf, Log(0)=-Inf,
// Log(x<0)=NaN, Log(NaN)=NaN.
func Log(x float64) float64

// Log10 returns the decimal logarithm of x. Special cases are as for Log.
func Log10(x float64) float64

// Log2 returns the binary logarithm of x. Special cases are as for Log.
func Log2(x float64) float64

// Log1p returns the natural logarithm of 1 plus x, accurate for x near zero.
// Log1p(+Inf)=+Inf, Log1p(0)=0, Log1p(-1)=-Inf, Log1p(x<-1)=NaN, Log1p(NaN)=NaN.
func Log1p(x float64) float64

// Pow10 returns 10**n, the base-10 exponential of n. Pow10(n)=0 for n<-323,
// Pow10(n)=+Inf for n>308.
func Pow10(n int) float64

// Pow returns x**y, the base-x exponential of y, following the IEEE-754
// special cases (Pow(x,0)=1, Pow(1,y)=1, Pow(x,1)=x, Pow(NaN,y)=NaN, the
// ±0/±Inf/odd-int rules, and NaN for a negative base with a non-integer y).
func Pow(x float64, y float64) float64

// Sin returns the sine of the radian argument x. Sin(±0)=±0, Sin(±Inf)=NaN,
// Sin(NaN)=NaN.
func Sin(x float64) float64

// Cos returns the cosine of the radian argument x. Cos(±Inf)=NaN, Cos(NaN)=NaN.
func Cos(x float64) float64

// Tan returns the tangent of the radian argument x. Tan(±0)=±0, Tan(±Inf)=NaN,
// Tan(NaN)=NaN.
func Tan(x float64) float64

// Atan returns the arctangent, in radians, of x. Atan(±0)=±0, Atan(±Inf)=±Pi/2.
func Atan(x float64) float64

// Atan2 returns the arc tangent of y/x, using the signs of both to determine
// the quadrant, with the IEEE-754 special cases for ±0/±Inf/NaN.
func Atan2(y float64, x float64) float64

// Asin returns the arcsine, in radians, of x. Asin(±0)=±0; NaN for |x|>1.
func Asin(x float64) float64

// Acos returns the arccosine, in radians, of x. NaN for |x|>1.
func Acos(x float64) float64

// Sinh returns the hyperbolic sine of x. Sinh(±0)=±0, Sinh(±Inf)=±Inf,
// Sinh(NaN)=NaN.
func Sinh(x float64) float64

// Cosh returns the hyperbolic cosine of x. Cosh(±0)=1, Cosh(±Inf)=+Inf,
// Cosh(NaN)=NaN.
func Cosh(x float64) float64

// Tanh returns the hyperbolic tangent of x. Tanh(±0)=±0, Tanh(±Inf)=±1,
// Tanh(NaN)=NaN.
func Tanh(x float64) float64

// Asinh returns the inverse hyperbolic sine of x. Asinh(±0)=±0,
// Asinh(±Inf)=±Inf, Asinh(NaN)=NaN.
func Asinh(x float64) float64

// Acosh returns the inverse hyperbolic cosine of x. Acosh(+Inf)=+Inf,
// Acosh(1)=0, and Acosh(x) is NaN for x<1.
func Acosh(x float64) float64

// Atanh returns the inverse hyperbolic tangent of x. Atanh(±1)=±Inf,
// Atanh(±0)=±0, and Atanh(x) is NaN for |x|>1.
func Atanh(x float64) float64

// Nextafter returns the next representable float64 value after x towards y.
// Nextafter(x,x)=x; NaN if either argument is NaN.
func Nextafter(x float64, y float64) float64

// Logb returns the binary exponent of x. Logb(±0)=-Inf, Logb(±Inf)=+Inf,
// Logb(NaN)=NaN.
func Logb(x float64) float64

// Ilogb returns the binary exponent of x as an int. Ilogb(±0)=MinInt32,
// Ilogb(±Inf)=MaxInt32, Ilogb(NaN)=MaxInt32.
func Ilogb(x float64) int

// FMA returns x*y + z, computed with only one rounding (the fused
// multiply-add). It is correctly rounded for all inputs.
func FMA(x float64, y float64, z float64) float64

// Erf returns the error function of x. Erf(+Inf)=1, Erf(-Inf)=-1, Erf(NaN)=NaN.
func Erf(x float64) float64

// Erfc returns the complementary error function of x. Erfc(+Inf)=0,
// Erfc(-Inf)=2, Erfc(NaN)=NaN.
func Erfc(x float64) float64

// Gamma returns the Gamma function of x. Gamma(+Inf)=+Inf, Gamma(+0)=+Inf,
// Gamma(-0)=-Inf, Gamma(x)=NaN for integer x<0, Gamma(-Inf)=NaN, Gamma(NaN)=NaN.
func Gamma(x float64) float64

// Lgamma returns the natural logarithm and sign (-1 or +1) of Gamma(x).
// Lgamma(+Inf)=+Inf, Lgamma(0)=+Inf, Lgamma(-integer)=+Inf, Lgamma(-Inf)=-Inf,
// Lgamma(NaN)=NaN.
func Lgamma(x float64) (float64, int)

// J0 returns the order-zero Bessel function of the first kind. J0(±Inf)=0,
// J0(0)=1, J0(NaN)=NaN.
func J0(x float64) float64

// Y0 returns the order-zero Bessel function of the second kind. Y0(+Inf)=0,
// Y0(0)=-Inf, Y0(x<0)=NaN, Y0(NaN)=NaN.
func Y0(x float64) float64

// J1 returns the order-one Bessel function of the first kind. J1(±Inf)=0,
// J1(0)=0, J1(NaN)=NaN.
func J1(x float64) float64

// Y1 returns the order-one Bessel function of the second kind. Y1(+Inf)=0,
// Y1(0)=-Inf, Y1(x<0)=NaN, Y1(NaN)=NaN.
func Y1(x float64) float64

// Jn returns the order-n Bessel function of the first kind. Jn(n,±Inf)=0,
// Jn(n,NaN)=NaN.
func Jn(n int, x float64) float64

// Yn returns the order-n Bessel function of the second kind. Yn(n,+Inf)=0,
// Yn(n>=0,0)=-Inf, Yn(n<0,0)=±Inf by parity, Yn(n,x<0)=NaN, Yn(n,NaN)=NaN.
func Yn(n int, x float64) float64
