// Package os provides a minimal, platform-neutral interface to the
// operating system's file services — Open / OpenFile / Create and the
// File handle they return — modeled on Go's os, adapted to Binate's
// borrow-based slices and errors-as-values convention.
//
// File implements the byte-stream interfaces from pkg/std/io (Reader,
// Writer, Closer, ReaderAt, WriterAt) over an OS file descriptor, and
// additionally offers Seek to reposition the stream.  Buffers are
// raw-slice borrows the caller owns (`*[]uint8` to read into,
// `*[]readonly uint8` to write from), exactly as io specifies; failure
// is a trailing `@errors.Error`, empty on success and tested with
// `present`.
//
// Paths are `*[]readonly char` borrows — text the call reads but does
// not retain — matching strconv's char-slice convention.  The open
// flags (O_*) and FileMode are Binate's own portable values, NOT the
// host's <fcntl.h> / mode_t numbers; the libc-backed implementation
// maps them onto the native ones, so `O_CREATE` means "create if
// absent" on every target regardless of the host's numbering.
//
// Implementations come in target flavors (see impls/stdlib/{libc,
// baremetal}): a libc-backed impl that reaches open/read/write/close/
// lseek via __c_call, and a bare-metal impl in which Open and friends
// fail because there is no filesystem.  This .bni is the contract both
// honor.
package "pkg/std/os"

import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/time"

// File is an open operating-system file, identified by its descriptor.
// Obtain one from Open / OpenFile / Create and release it with Close;
// Binate has no finalizers and never will run one here, so a File
// dropped without Close leaks its descriptor until process exit — Close
// every File you open.
//
// File carries no buffer and no position of its own: the stream
// position that Read and Write advance, and that Seek moves, lives in
// the kernel.  ReadAt / WriteAt ignore and do not disturb it, so they
// are safe to interleave with the position-based methods.
//
// Methods take a raw `*File` receiver (a borrow): a call neither
// retains the receiver nor touches its refcount.  The owning handle is
// the `@File` that Open returns.
type File struct {
	fd int
}

// Read reads up to `len(p)` bytes from the file into p, advancing the
// stream position, and returns the count read with any error.  At
// end-of-input it returns (0, io.EOF).  Satisfies io.Reader.
func (f *File) Read(p *[]uint8) (int, @errors.Error)

// Write writes `len(p)` bytes from p to the file, advancing the stream
// position, and returns the count written with any error.  A short
// write (n < len(p)) is reported with a non-empty error.  Satisfies
// io.Writer.
func (f *File) Write(p *[]readonly uint8) (int, @errors.Error)

// Close releases the file descriptor.  After Close the File must not be
// used again; Close is not idempotent.  Satisfies io.Closer.
func (f *File) Close() @errors.Error

// ReadAt reads `len(p)` bytes into p starting at byte offset `off`,
// without consulting or disturbing the stream position, and returns the
// count read with any error.  `off` is int64 so a 32-bit target can
// still address a large file.  Satisfies io.ReaderAt.
func (f *File) ReadAt(p *[]uint8, off int64) (int, @errors.Error)

// WriteAt writes `len(p)` bytes from p starting at byte offset `off`,
// without consulting or disturbing the stream position, and returns the
// count written with any error.  Satisfies io.WriterAt.
func (f *File) WriteAt(p *[]readonly uint8, off int64) (int, @errors.Error)

// Seek sets the position of the next Read or Write to offset,
// interpreted relative to whence, and returns the resulting absolute
// offset with any error.  offset and the result are int64, independent
// of the target word size.
func (f *File) Seek(offset int64, whence Whence) (int64, @errors.Error)

// ReadByte reads and returns the next byte, advancing the stream
// position.  At end-of-input it returns (0, io.EOF); the byte is only
// meaningful when the error is empty.  Satisfies io.ByteReader.
func (f *File) ReadByte() (uint8, @errors.Error)

// WriteByte writes a single byte, advancing the stream position, and
// returns any error.  Satisfies io.ByteWriter.
func (f *File) WriteByte(c uint8) @errors.Error

impl *File : io.Reader, io.Writer, io.Closer, io.ReaderAt, io.WriterAt, io.ByteReader, io.ByteWriter

// Stdin, Stdout, and Stderr are open Files for the three standard
// descriptors (0, 1, 2).  They are process-lifetime handles — never
// Close them.  On a target with no standard streams (bare metal) they
// may be empty; test with `present` before use.
var Stdin  @File
var Stdout @File
var Stderr @File

// FileMode holds a file's type and permission bits — a portable Binate value
// laid out exactly as Go's os.FileMode, so a value is portable and would print
// the same.  The low 9 bits are the rwx Unix permissions (ModePerm); the high
// bits are the file-type and special bits below.  OpenFile uses the permission
// bits for a file it creates under O_CREATE; File.Stat fills the whole value.
// String() is a planned follow-up.
type FileMode uint32

// FileMode bits, in Go's exact layout (the highest set bit, if any, is the
// file type).  Exactly one type bit is set for a non-regular file, none for a
// regular file.  Append/Exclusive/Temporary have no POSIX source — they are
// reserved for layout compatibility with Go; the rest come from a file's mode.
const (
	ModeDir        FileMode = 1 << (32 - 1 - iota)  // d: directory
	ModeAppend                                      // a: append-only
	ModeExclusive                                   // l: exclusive use
	ModeTemporary                                   // T: temporary
	ModeSymlink                                     // L: symbolic link
	ModeDevice                                      // D: device file
	ModeNamedPipe                                   // p: named pipe (FIFO)
	ModeSocket                                      // S: socket
	ModeSetuid                                      // u: setuid
	ModeSetgid                                      // g: setgid
	ModeCharDevice                                  // c: char device (with ModeDevice)
	ModeSticky                                      // t: sticky
	ModeIrregular                                   // ?: non-regular, unknown kind
)

// ModeType masks the file-type bits; ModePerm masks the Unix permission bits.
const (
	ModeType FileMode = ModeDir | ModeSymlink | ModeNamedPipe | ModeSocket |
		ModeDevice | ModeCharDevice | ModeIrregular
	ModePerm FileMode = 0o777
)

// IsDir reports whether m describes a directory.
func (m FileMode) IsDir() bool

// IsRegular reports whether m describes a regular file (no type bit set).
func (m FileMode) IsRegular() bool

// Perm returns the Unix permission bits of m (m & ModePerm).
func (m FileMode) Perm() FileMode

// Type returns the type bits of m (m & ModeType).
func (m FileMode) Type() FileMode

// FileInfo describes a file, as returned by os.Stat and File.Stat.  It is a
// snapshot: the fields are read at the time of the call and do not track later
// changes to the file.  Stat allocates an @FileInfo and it owns the name;
// read the fields through the methods below.
type FileInfo struct {
	name    @[]char     // base name (owned)
	size    int64       // length in bytes
	mode    FileMode    // type and permission bits
	modTime time.Point  // modification time
}

// Name returns the base name of the file (the final path element).
func (fi *readonly FileInfo) Name() @[]readonly char

// Size returns the length in bytes (meaningful for regular files).
func (fi *readonly FileInfo) Size() int64

// Mode returns the file's mode and permission bits.
func (fi *readonly FileInfo) Mode() FileMode

// ModTime returns the file's modification time.
func (fi *readonly FileInfo) ModTime() time.Point

// IsDir reports whether the file is a directory (Mode().IsDir()).
func (fi *readonly FileInfo) IsDir() bool

// Open opens the named file for reading.  On success the File is ready
// for Read / ReadAt / Seek; on failure the File is empty (test the
// error with `present`).  Open is OpenFile(name, O_RDONLY, 0).
func Open(name *[]readonly char) (@File, @errors.Error)

// OpenFile is the general open.  flag combines the O_* constants —
// exactly one access mode (O_RDONLY / O_WRONLY / O_RDWR) OR-ed with any
// of the modifiers (O_APPEND / O_CREATE / O_EXCL / O_TRUNC / O_SYNC).
// flag is a plain int because it is an OR-able bitmask.  perm supplies
// the permission bits for a file newly created under O_CREATE (ignored
// otherwise).  Returns the File and any error.
func OpenFile(name *[]readonly char, flag int, perm FileMode) (@File, @errors.Error)

// Create creates or truncates the named file for reading and writing
// and returns it.  Create is OpenFile(name, O_RDWR|O_CREATE|O_TRUNC,
// 0o666) — a new file gets mode 0o666 (rw-rw-rw-, before umask).
func Create(name *[]readonly char) (@File, @errors.Error)

// Open flags for OpenFile's flag argument, OR-ed together.  These are
// Binate's own portable values, NOT the host's <fcntl.h> numbers — the
// libc-backed impl translates them to the native open(2) flags.
// Exactly one access mode (the first three) is required; the rest are
// optional modifiers.  Mirrored in os.bn; the two must stay in sync.
const (
	O_RDONLY int = 0x0000  // open the file read-only
	O_WRONLY int = 0x0001  // open the file write-only
	O_RDWR   int = 0x0002  // open the file read-write

	O_APPEND int = 0x0008  // each write goes to the end of the file
	O_CREATE int = 0x0010  // create the file if it does not exist
	O_EXCL   int = 0x0020  // with O_CREATE, fail if the file exists
	O_TRUNC  int = 0x0040  // truncate to zero length on open
	O_SYNC   int = 0x0080  // open for synchronous I/O
)

// Whence selects the reference point for a Seek offset.  A named type
// (rather than bare int) so a stray integer can't be passed where a
// seek origin is meant; the valid values are the three constants below.
type Whence int

// Whence values for File.Seek.  Mirrored in os.bn; the two must stay in
// sync.
const (
	SeekStart   Whence = 0  // offset is relative to the start of the file
	SeekCurrent Whence = 1  // offset is relative to the current position
	SeekEnd     Whence = 2  // offset is relative to the end of the file
)
