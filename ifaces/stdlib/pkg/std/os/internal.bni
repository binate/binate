// Internal helper for the os impl: a thin shim around the C errno location.
// The SIGNATURE is OS-agnostic and lives here; the BODY is per-target,
// because the errno-location symbol differs by OS — `int *__error(void)` on
// Darwin, `int *__errno_location(void)` on Linux — and __c_call needs a
// literal symbol that must LINK.  A single impl with a runtime branch would
// reference both symbols and fail to link the wrong-OS one, so the body is
// OS-gated (internal_darwin.bn / internal_linux.bn, via #[build(is(os, …))]),
// emitting only the active OS's symbol.
package "pkg/std/os/internal"

// Errno returns the current value of the C errno (thread-local).
func Errno() int
