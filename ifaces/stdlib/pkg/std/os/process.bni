// Package process runs a child program synchronously — launch it, wait for it to
// finish, and report how it ended, in a richer, lossless shape than a bare
// exit-code call: a non-zero exit code is NOT an error (only a could-not-START
// condition is), and a signal death is first-class.
//
// Hosted targets fork/exec/wait via __c_call (the sanctioned syscall interop); a
// freestanding (bare-metal) target has no process model, so every entry point
// fails with errors.Unsupported.  The value types (ExitStatus, Options) are
// unconstrained and shared by both variants, so the package LINKS on every
// target.  See explorations/design-os-process.md.
package "pkg/std/os/process"

import "pkg/std/errors"

// ExitStatus reports HOW a finished child terminated.  Exactly one of Exited()
// and Signaled() holds.  A non-zero exit code is not an error; when the child
// was killed by a signal, Code() returns -1 (never a valid 0..255 code) so a
// naive Code()==0 check cannot misread a signal death as a clean exit.
type ExitStatus struct {
	exited bool // normal exit vs signal death
	code   int // exit code 0..255 when exited
	signal int // terminating signal number when signaled
}

// Exited reports whether the child terminated normally (via exit), as opposed to
// being killed by a signal.
func (s *readonly ExitStatus) Exited() bool

// Code returns the child's exit code (0..255) when it Exited(); it returns -1
// when the child was killed by a signal (see Signal()).
func (s *readonly ExitStatus) Code() int

// Signaled reports whether the child was killed by a signal.
func (s *readonly ExitStatus) Signaled() bool

// Signal returns the terminating signal number when the child was Signaled(); it
// returns 0 when the child Exited().  The number is the raw host signal number,
// which differs across platforms — diagnostic-only until a portable signal enum.
func (s *readonly ExitStatus) Signal() int

// Success reports whether the child exited normally with code 0 — the common
// "did it work?" check.
func (s *readonly ExitStatus) Success() bool

// Options configures Run.  The ZERO VALUE is the safe default: inherit the parent
// environment, use `program` as an exact path (no PATH search), set argv[0] to
// `program`, and pass no extra arguments.
//
// Args is argv[1..] ONLY — it does NOT include argv[0] (which defaults to
// `program`, overridable via Argv0).  Folding argv[0] into Args would be a silent
// shift-by-one footgun.
//
// Child environment = (ReplaceEnv || Env is non-empty) ? Env : the inherited
// parent environment.  So Options{} inherits; Options{Env: e} replaces with e;
// Options{ReplaceEnv: true} gives an empty child environment.
type Options struct {
	Args       @[]readonly @[]readonly char // argv[1..]; does NOT include argv[0]
	Argv0      *[]readonly char // argv[0]; empty => defaults to `program`
	Env        @[]readonly @[]readonly char // child environment ("NAME=value"); see ReplaceEnv
	ReplaceEnv bool // replace env even when Env is empty (=> empty child env)
	SearchPath bool // resolve `program` along PATH (else exact path)
}

// Run runs `program` to completion and reports how it ended.  The trailing error
// is present ONLY when the child could not be STARTED (fork/exec failed, or the
// path did not resolve); on a started child it is empty and ExitStatus carries
// the outcome — a non-zero exit AND a signal death are both reported with no
// error.  opts is read-only; the zero value (see Options) is the safe default.
func Run(program *[]readonly char, opts *readonly Options) (ExitStatus, @errors.Error)

// RunArgs runs `program` at an exact path with the inherited environment, argv[0]
// = program, and argv[1..] = args — the drop-in for the common case.
func RunArgs(program *[]readonly char, args ...*[]readonly char) (ExitStatus, @errors.Error)

// RunArgsPath is like RunArgs but resolves `program` along PATH.
func RunArgsPath(program *[]readonly char, args ...*[]readonly char) (ExitStatus, @errors.Error)

// LookPath resolves `program` to a concrete executable path.  A name containing
// '/' is returned as-is when it is executable; otherwise it is searched along the
// ambient PATH.  A not-found is errors.NotFound.
func LookPath(program *[]readonly char) (@[]char, @errors.Error)
