// Package sys is the os family's low-level libc-syscall layer: thin,
// error-returning, EINTR-retrying wrappers over the libc calls that pkg/std/os
// and pkg/std/os/process build on, so errno → errors.Error classification and the
// per-OS errno() accessor live in ONE place and errno never surfaces on a
// higher-level API.
//
// pkg/std/os/sys is OS-FAMILY-INTERNAL — not a supported public API.  Only
// pkg/std/os and its subpackages import it; user code goes through pkg/std/os.
// Hosted only: every entry is a syscall, so
// a freestanding target never imports it (os / os/process fail loud there
// without it).
package "pkg/std/os/sys"

import "pkg/std/errors"

// FailErrno builds the classified error for the just-failed syscall (reading the
// current errno), wrapped with op ("open"/"read"/"fork"/...) as context.  Call it
// IMMEDIATELY after the failure, before any other call.  It panics on a defect
// errno (EBADF/EFAULT — programmer error).
func FailErrno(op @[]readonly char) @errors.Error

// Interrupted reports whether the current errno is EINTR (the "retry the syscall"
// signal).  The idiom is `if n >= 0 || !Interrupted() { break }` in a retry loop,
// keeping the raw EINTR value inside this package.  Read it immediately after the
// syscall.
func Interrupted() bool

// Fork forks the process: the child pid in the parent (0 in the child), or a
// start error if fork failed.
func Fork() (int, @errors.Error)

// ChildExecOrExit runs ONLY in the forked child: raw execve (execv when envp is
// null => inherit) then _exit(127) on failure.  NORETURN and ALLOCATION-FREE, so
// it is safe between fork and exec.  path/argv/envp are the caller's pre-built,
// pre-hoisted C string and char** arrays.
func ChildExecOrExit(path *uint8, argv *uint8, envp *uint8)

// Waitpid waits for pid and returns the raw wait-status word (the caller decodes
// it), retrying EINTR.
func Waitpid(pid int) (int, @errors.Error)

// Accessible reports whether path is an executable file (access(2) with X_OK), as
// an error: empty on success, else the classified failure.
func Accessible(path *[]readonly char) @errors.Error

// --- fd-based I/O (read/write/close/pread/pwrite/lseek/open) ---
// Each retries EINTR and classifies errno internally.  Read/Pread return the raw
// byte count (0 = end-of-input; the caller supplies stream semantics); Write/
// Pwrite return the count written.  Open's flags/mode are the NATIVE open(2)
// values (the caller does portable->native flag translation).

func Read(fd int, p *[]uint8) (int, @errors.Error)

func Write(fd int, p *[]readonly uint8) (int, @errors.Error)

func Close(fd int) @errors.Error

func Pread(fd int, p *[]uint8, off int64) (int, @errors.Error)

func Pwrite(fd int, p *[]readonly uint8, off int64) (int, @errors.Error)

func Lseek(fd int, off int64, whence int) (int64, @errors.Error)

func Open(path *[]readonly char, flags int, mode int) (int, @errors.Error)

// --- path ops + process exit ---

// Mkdir creates a directory with the given native mode bits (mkdir(2)).
func Mkdir(path *[]readonly char, mode int) @errors.Error

// Rename renames (moves) oldpath to newpath (rename(2)).
func Rename(oldpath *[]readonly char, newpath *[]readonly char) @errors.Error

// Remove removes a file or empty directory (remove(3)).
func Remove(path *[]readonly char) @errors.Error

// MkdirTemp creates a uniquely-named directory from `template` (which must end in
// "XXXXXX") via mkdtemp(3), returning the created directory's path.  The name is
// made unique and the directory created atomically (0700), so concurrent callers
// never collide.
func MkdirTemp(template *[]readonly char) (@[]char, @errors.Error)

// Exit terminates the process with the given status code (exit(3)); noreturn.
func Exit(code int)

// --- stat / lstat / fstat ---
// Each fills a portable StatInfo, retrying EINTR and classifying errno
// internally.  Stat/Lstat take a path; Fstat an open descriptor.

// StatInfo is the platform-neutral subset of a struct stat the os family reports:
// size, the raw st_mode bits (the caller maps them to a FileMode), and the mtime
// as whole Unix seconds plus nanoseconds.  Fields are exported because this is an
// os-family-internal type read directly by the caller.
type StatInfo struct {
	Size      int64 // st_size, in bytes
	Mode      uint32 // raw st_mode: S_IFMT type field | permission bits
	MtimeSec  int64 // st_mtim whole seconds since the Unix epoch
	MtimeNsec int32 // st_mtim nanoseconds, in [0, 1e9)
}

// Stat fills a StatInfo for path via stat(2) (following symlinks).
func Stat(path *[]readonly char) (StatInfo, @errors.Error)

// Lstat is Stat via lstat(2) (does not follow a final symlink).
func Lstat(path *[]readonly char) (StatInfo, @errors.Error)

// Fstat fills a StatInfo for the open descriptor fd via fstat(2).
func Fstat(fd int) (StatInfo, @errors.Error)

// --- readdir ---

// DirEnt is one directory entry from ReadDir: an owned base name plus the raw
// d_type byte from the struct dirent (the caller maps it to whatever it needs).
// Fields are exported because this is an os-family-internal type read directly by
// the caller.
type DirEnt struct {
	Name @[]char // base name (owned)
	Type uint8 // raw d_type (DT_* from <dirent.h>)
}

// ReadDir reads path (opendir/readdir/closedir) and returns its entries — each an
// owned name + raw d_type — excluding "." and "..", in directory order.  On
// failure the slice is empty and the error is present.
func ReadDir(path *[]readonly char) (@[]@DirEnt, @errors.Error)
