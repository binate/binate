// Package set provides Set[T], an unordered hash set of any lang.Hashable type.
// It lives in the stable `std` layer (`pkg/std/set`).  See
// explorations/pkg-layout-spec.md.
//
// Set is a thin wrapper over the shared open-addressing engine
// pkg/std/table.Table with a zero-size value (its vals backing is 0 bytes),
// parameterized by the INTRINSIC Default policies (hash.Default[T] / cmp.Default[T]).
// Those policies are zero-size and monomorphize hashing/equality to direct T.Hash() /
// T.Compare(other) == 0 calls — no overhead over a hand-inlined intrinsic set — so Set
// shares the probe / grow / backward-shift logic with the fn-injected setfn.SetFn rather
// than duplicating it.  The element type is lang.Hashable (which extends lang.Comparable),
// which satisfies both policy bounds.
//
// Iteration follows the shared cursor convention: s.Iter()
// returns a SetCursor[T] whose Next() yields (elem, true) per member in unspecified order,
// then (zero, false); a @Set is an iter.Iterable[T] via AsIterator().  A SetCursor projects
// the underlying table cursor's (elem, Unit) entries down to the bare element, exactly as
// setfn.SetFn does.
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/std/set"

import "pkg/builtins/lang"
import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/iter"
import "pkg/std/table"

// Unit is the zero-size value a set stores for each present element.
type Unit struct {}

// Set[T] is a hash set of T keyed by the element type's own lang.Hashable hashing and
// lang.Comparable equality.
type Set[T lang.Hashable] struct {
	t @table.Table[T, Unit, hash.Default[T], cmp.Default[T]]
}

// New returns an empty Set[T] with an initial capacity of 8.
func New[T lang.Hashable]() @Set[T] {
	var h hash.Default[T]
	var e cmp.Default[T]
	var s @Set[T] = make(Set[T])
	s.t = table.NewTable[T, Unit, hash.Default[T], cmp.Default[T]](h, e)
	return s
}

// Len returns the number of members.
func (s @Set[T]) Len() int { return s.t.Len() }

// Add inserts x and returns true, or returns false if x was already a member.
func (s @Set[T]) Add(x T) bool {
	var before int = s.t.Len()
	var u Unit
	s.t.Put(x, u)
	return s.t.Len() != before
}

// Has reports whether x is a member.
func (s @Set[T]) Has(x T) bool { return s.t.Has(x) }

// Remove deletes x and returns true, or returns false if x is not a member.
func (s @Set[T]) Remove(x T) bool { return s.t.Remove(x) }

// SetCursor is a forward iteration cursor over a Set (see Iter and Next).  It holds the
// underlying table cursor by value; that cursor owns a reference to the table, so the
// table stays live for the SetCursor's lifetime.  A structural mutation (Add that grows,
// or Remove) during iteration invalidates a live cursor.
type SetCursor[T lang.Hashable] struct {
	tc table.Cursor[T, Unit, hash.Default[T], cmp.Default[T]]
}

// Iter returns a SetCursor positioned before the first member.
func (s @Set[T]) Iter() SetCursor[T] {
	var it SetCursor[T]
	it.tc = s.t.Iter()
	return it
}

// Next advances the cursor to the next member and returns (elem, true), or (zero, false)
// once the members are exhausted.  It projects the table cursor's (elem, Unit) entry down
// to the bare element.  It takes a pointer receiver because it mutates the underlying
// cursor's position.
func (sc *SetCursor[T]) Next() (T, bool) {
	var e table.Entry[T, Unit]
	var ok bool
	e, ok = sc.tc.Next()
	return e.Key, ok
}

impl *SetCursor[T] : iter.Iterator[T]

// AsIterator returns a boxed iterator over the members, satisfying iter.Iterable[T].  It
// allocates a managed cursor (unlike the zero-cost value cursor Iter returns) so the
// cursor can be held behind the @iter.Iterator[T] interface value.
func (s @Set[T]) AsIterator() @iter.Iterator[T] {
	var c @SetCursor[T] = make(SetCursor[T])
	c.tc = s.t.Iter()
	return c
}

impl @Set[T] : iter.Iterable[T]
