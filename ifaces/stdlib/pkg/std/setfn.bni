// Package setfn provides SetFn[T], an unordered set whose element hashing and equality
// are supplied as INJECTED functions rather than derived from a lang.Hashable element —
// so T may be any type.  It is the set analogue of mapfn.MapFn.  It lives in the
// stable `std` layer (`pkg/std/setfn`); `pkg/stdx/containers/setfn` is a compat
// forwarder (`expose "pkg/std/setfn"`).  See explorations/pkg-layout-spec.md.
//
// SetFn is a thin wrapper over the shared open-addressing engine
// pkg/std/table.Table with a zero-size value (its vals backing is 0 bytes),
// parameterized by pkg/std/hash.FnHasher[T] and pkg/std/cmp.FnEq[T] — so it shares the
// probe / grow / backward-shift logic with the map containers rather than duplicating it.
// The hash/eq are indirect calls (through the stored *func) per probe.
//
// Iteration follows the shared cursor convention: s.Iter()
// returns a SetCursor[T] whose Next() yields (elem, true) per member in unspecified order,
// then (zero, false); a @SetFn is an iter.Iterable[T] via AsIterator().  A SetCursor
// projects the underlying table cursor's (elem, Unit) entries down to the bare element.
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/std/setfn"

import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/iter"
import "pkg/std/table"

// Unit is the zero-size value a set stores for each present element.
type Unit struct {}

// SetFn[T] is a set of T keyed by injected hash/equality functions.
type SetFn[T any] struct {
	t @table.Table[T, Unit, hash.FnHasher[T], cmp.FnEq[T]]
}

// NewSetFn returns an empty SetFn keyed by hashFn and eqFn (which must agree: elements
// eqFn treats as equal must hash equal).
func NewSetFn[T any](hashFn *func(T) uint, eqFn *func(T, T) bool) @SetFn[T] {
	var s @SetFn[T] = make(SetFn[T])
	s.t = table.NewTable[T, Unit, hash.FnHasher[T], cmp.FnEq[T]](hash.Fn[T](hashFn), cmp.Fn[T](eqFn))
	return s
}

// Len returns the number of elements.
func (s @SetFn[T]) Len() int { return s.t.Len() }

// Add inserts elem and returns true, or returns false if elem was already present
// (mirroring set.Set.Add's newness contract).
func (s @SetFn[T]) Add(elem T) bool {
	var before int = s.t.Len()
	var u Unit
	s.t.Put(elem, u)
	return s.t.Len() != before
}

// Has reports whether elem is present.
func (s @SetFn[T]) Has(elem T) bool { return s.t.Has(elem) }

// Remove deletes elem and returns true, or returns false if elem is absent.
func (s @SetFn[T]) Remove(elem T) bool { return s.t.Remove(elem) }

// SetCursor is a forward iteration cursor over a SetFn (see Iter and Next).  It holds the
// underlying table cursor by value; that cursor owns a reference to the table, so the
// table stays live for the SetCursor's lifetime.  A structural mutation (Add that grows,
// or Remove) during iteration invalidates a live cursor.
type SetCursor[T any] struct {
	tc table.Cursor[T, Unit, hash.FnHasher[T], cmp.FnEq[T]]
}

// Iter returns a SetCursor positioned before the first element.
func (s @SetFn[T]) Iter() SetCursor[T] {
	var it SetCursor[T]
	it.tc = s.t.Iter()
	return it
}

// Next advances the cursor to the next element and returns (elem, true), or (zero, false)
// once the elements are exhausted.  It projects the table cursor's (elem, Unit) entry down
// to the bare element.  It takes a pointer receiver because it mutates the underlying
// cursor's position.
func (sc *SetCursor[T]) Next() (T, bool) {
	var e table.Entry[T, Unit]
	var ok bool
	e, ok = sc.tc.Next()
	return e.Key, ok
}

impl *SetCursor[T] : iter.Iterator[T]

// AsIterator returns a boxed iterator over the elements, satisfying iter.Iterable[T].  It
// allocates a managed cursor (unlike the zero-cost value cursor Iter returns) so the
// cursor can be held behind the @iter.Iterator[T] interface value.
func (s @SetFn[T]) AsIterator() @iter.Iterator[T] {
	var c @SetCursor[T] = make(SetCursor[T])
	c.tc = s.t.Iter()
	return c
}

impl @SetFn[T] : iter.Iterable[T]
