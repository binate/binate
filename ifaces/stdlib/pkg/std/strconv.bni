// Package strconv converts between primitive values and their text
// (char-slice) representations.  Modeled on Go's strconv, adapted to
// Binate's view-based slices.
//
// Two families:
//   - Append*(dst *[]char, pos int, ...) int — write into a
//     caller-owned buffer at a position; no allocation.  `dst` is the
//     WHOLE buffer (a raw-slice view the caller owns); `pos` is where
//     to start writing.  Returns the position just past the written
//     text (the "next" position), or a negative "space needed" value
//     when the buffer is too small — see AppendInt for the exact
//     overflow contract.
//   - Format*(...) @[]char — allocating conveniences that return a
//     freshly-allocated managed-slice the caller owns.
//
// Covers integer (Int/Uint, base 2..36), bool, and float formatting
// (Append/FormatFloat, a Dragon4/Burger-Dybvig dtoa) in both shortest
// round-trip (prec < 0) and fixed-precision (prec >= 0) modes, plus the
// inverse Parse* family (string→value), which reports failure as an
// @errors.Error (empty on success, tested with `present`).
package "pkg/std/strconv"

import "pkg/std/errors"

// AppendInt formats v in the given base and writes it into dst
// starting at index pos, returning pos + (chars written) — the
// position a subsequent append would start at.
//
// base must be in 2..36; digits above 9 use lowercase a..z.  A base
// outside 2..36 is treated as base 10 (Binate has no panics; this is
// the sane-default analogue of Go's panic).
//
// Overflow contract: if dst lacks room (pos < 0, or pos + needed >
// len(dst), where `needed` is the number of chars the formatted
// result occupies, including any sign), NOTHING is written and the
// result is -needed.  The caller can then ensure dst has at least
// pos + needed length and retry.  Because needed >= 1 always, a
// negative result is unambiguously an overflow signal.
func AppendInt(dst *[]char, pos int, v int64, base int) int

// AppendUint is AppendInt for unsigned values — same base rules and
// overflow contract, never emits a sign char.
func AppendUint(dst *[]char, pos int, v uint64, base int) int

// AppendBool writes "true" or "false" into dst at pos, returning the
// next position, or -needed on overflow where needed is the literal's
// length (4 for "true", 5 for "false"); nothing is written.
func AppendBool(dst *[]char, pos int, b bool) int

// FormatInt is the allocating convenience for AppendInt: returns a
// fresh managed-slice holding v in the given base.  The caller owns
// the result.
func FormatInt(v int64, base int) @[]char

// Itoa returns a fresh caller-owned @[]char holding v as a base-10
// decimal string — FormatInt(cast(int64, v), 10), the analogue of Go's
// strconv.Itoa.
func Itoa(v int) @[]char

// FormatUint is the allocating convenience for AppendUint.
func FormatUint(v uint64, base int) @[]char

// FormatBool returns a freshly-allocated "true"/"false".
func FormatBool(b bool) @[]char

// AppendFloat formats f and writes it into dst starting at pos, returning the
// next position, or -(needed) (writing nothing) on overflow — the same
// contract as AppendInt.
//
//   fmt:     'f' (-ddd.dddd) / 'e','E' (-d.ddde±dd) / 'g','G' (shortest of
//            e/f).  An unrecognized fmt is treated as 'g'.
//   prec:    < 0 selects the shortest representation that round-trips.
//            prec >= 0 is a fixed digit count: digits after the point for
//            'f'/'e', total significant digits for 'g' (0 means 1).
//   bitSize: 32 (round-trip target float32) or 64; any other value is
//            treated as 64.  f is always float64.
//
// NaN renders as "NaN" (no sign); infinities as "+Inf"/"-Inf"; -0.0 keeps its
// sign.
func AppendFloat(dst *[]char, pos int, f float64, fmt char, prec int, bitSize int) int

// FormatFloat is the allocating convenience for AppendFloat: it returns a
// fresh caller-owned @[]char.
func FormatFloat(f float64, fmt char, prec int, bitSize int) @[]char

// ParseBool interprets s as a boolean.  It accepts 1, t, T, TRUE, true,
// True (→ true) and 0, f, F, FALSE, false, False (→ false); any other
// input yields a present @errors.Error (and a false value).  s is a
// byte view (char ≡ uint8), so a string literal is accepted directly.
func ParseBool(s *[]readonly uint8) (bool, @errors.Error)

// ParseInt interprets s as a signed integer in the given base, constrained
// to bitSize bits, returning an int64.
//
//   base:    2..36, or 0 to infer from a prefix — 0b/0o/0x → 2/8/16
//            (case-insensitive), a bare leading 0 → octal, else decimal.
//            Base 0 also accepts '_' digit separators (Go's rule).
//   bitSize: 0/8/16/32/64; 0 means the platform int (32 on ILP32).
//
// s may carry a leading '+'/'-'.  On out-of-range input the value
// saturates to the bitSize signed extreme and the error is present; on
// malformed input it is the syntax error (and a 0 value).
func ParseInt(s *[]readonly uint8, base int, bitSize int) (int64, @errors.Error)

// ParseUint is ParseInt for unsigned values: same base / bitSize rules,
// returning a uint64.  A leading sign is rejected (syntax error).  On
// out-of-range the value saturates to the bitSize maximum.
func ParseUint(s *[]readonly uint8, base int, bitSize int) (uint64, @errors.Error)

// Atoi is ParseInt(s, 10, 0) specialized to the platform int — the
// analogue of Go's strconv.Atoi.
func Atoi(s *[]readonly uint8) (int, @errors.Error)

// ParseFloat converts s to the nearest float, correctly rounded
// (round-half-to-even) — the exact inverse of FormatFloat.
//
//   bitSize: 64 rounds to the nearest float64; 32 rounds to the nearest
//            float32 and returns it widened to float64 (exactly as Go); any
//            other value is treated as 64.
//
// Accepts an optional sign, a decimal mantissa with optional fraction and
// exponent (`[sign] d.d e±d`), and the case-insensitive specials
// inf/infinity (signed) and nan (unsigned).  Overflow returns ±Inf with a
// present @errors.Error; underflow returns 0 with no error (matching Go);
// malformed input is a syntax error with a 0 value.  '_' digit separators
// and hex-float syntax (0x1.8p3, with a mandatory binary 'p' exponent) are
// accepted, as in Go.
func ParseFloat(s *[]readonly uint8, bitSize int) (float64, @errors.Error)
