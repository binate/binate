// Package strings provides helpers for building and inspecting byte
// strings.  It starts with Builder — an accumulating, exponentially-grown
// buffer modeled on Go's strings.Builder, byte-oriented to match
// pkg/std/io (text is a char-slice view over the same bytes).
package "pkg/std/strings"

import "pkg/std/errors"

// Builder accumulates bytes into a backing it owns and grows
// exponentially, modeled on Go's strings.Builder (minus the string / rune
// helpers Binate has no types for).  Its methods take a *Builder and
// mutate in place, so a *Builder is an io.Writer and an io.ByteWriter.
// Obtain one from NewBuilder, append with Write / WriteByte, and read the
// accumulated bytes with String.  Hold it as the @Builder NewBuilder
// returns and do not copy it — a copy would alias the same backing.
type Builder struct {
	// buf is the owned backing (len(buf) is the capacity); n (<= len(buf))
	// counts the bytes written so far.  buf stores `char` so String can
	// hand the result back without reinterpretation, while Write /
	// WriteByte accept the `uint8` the io interfaces use — char and uint8
	// are both one byte (the byte / text-view duality io.bni describes).
	buf @[]char
	n   int
}

// NewBuilder returns a new, empty Builder ready to accumulate bytes.
func NewBuilder() @Builder

// Write appends p's bytes to the Builder and returns (len(p), an empty
// error).  It never fails, satisfying io.Writer.  p is a readonly borrow
// copied into the Builder's own backing — the Builder does not retain it.
// p must NOT alias the Builder's own backing (e.g. a borrow of this
// Builder's own String() held across statements): a grow during the copy
// can free the aliased backing mid-Write.  Pass an independent copy if it
// might overlap.
func (b *Builder) Write(p *[]readonly uint8) (int, @errors.Error)

// WriteByte appends a single byte and returns an empty error.  It never
// fails, satisfying io.ByteWriter.
func (b *Builder) WriteByte(c uint8) @errors.Error

// Grow ensures at least n more bytes can be appended before the next
// reallocation.  When it must allocate, it grows the capacity
// exponentially (so a run of appends stays amortized O(1)); an n that
// already fits, or is negative, is a no-op.
func (b *Builder) Grow(n int)

// Len returns the number of bytes accumulated so far.
func (b *Builder) Len() int

// Cap returns the capacity of the backing — the number of bytes that fit
// before the next reallocation, always >= Len.
func (b *Builder) Cap() int

// Reset discards the accumulated bytes and releases the backing, leaving
// the Builder empty and reusable.  A string previously returned by String
// is unaffected: it keeps its own reference to the old backing.
func (b *Builder) Reset()

// String returns the accumulated bytes as an immutable string that shares
// the Builder's backing — no copy.  It stays valid across later appends
// and Reset: once the Builder reallocates (or resets), this result keeps
// the old backing alive on its own.
func (b *Builder) String() @[]readonly char

// A *Builder satisfies io.Writer and io.ByteWriter.  The `impl` is
// declared in strings.bn, not here: an impl written in a .bni is parsed
// but never registered for interface-value assignment, so declaring it
// here would compile yet leave `@io.Writer = aBuilder` failing (a
// CRITICAL bug tracked in claude-todo.md).  The cost is that other
// packages can't yet use a Builder *through* io.Writer/io.ByteWriter;
// move this back to the .bni once that bug is fixed.
