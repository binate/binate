// Package table provides Table[K, V, H, E], the policy-parameterized open-addressing
// engine shared by the pkg/stdx/containers hash containers.  It lives in the stable
// `std` layer (`pkg/std/table`).  `pkg/stdx/containers/table` is a compat forwarder
// (`expose "pkg/std/table"`) that keeps existing `import
// "pkg/stdx/containers/table"` consumers resolving the same entities.  See
// explorations/pkg-layout-spec.md.
//
// The hashing and equality of keys are supplied as type-parameter POLICIES — a
// pkg/std/hash.Hasher[K] and a pkg/std/cmp.Eq[K] — carried as fields (h, e) and
// dispatched as t.h.Hash(k) / t.e.Equal(a, b).  This lets ONE engine serve any policy
// pairing without duplicating the probe/grow/backward-shift logic that a hand-copied
// second engine would drift from.  mapfn.MapFn / setfn.SetFn use the fn-injected policies
// (H = hash.FnHasher[K], E = cmp.FnEq[K]); hashmap.Map / set.Set use the intrinsic
// zero-size policies (hash.Default[K], cmp.Default[K]), which monomorphize
// h.Hash(k)/e.Equal(a,b) to direct k.Hash()/k.Compare() calls — no overhead over
// hand-inlined dispatch — so the intrinsic-keyed containers keep direct dispatch while
// still sharing this one engine.
//
// The representation is open addressing with linear probing over three parallel
// managed-slices (keys, vals, used) of a power-of-two capacity; a slot i is live iff
// used[i].  Deletion is backward-shift (no tombstones), so probe chains never
// accumulate dead slots.  A value-less set stores a zero-size V (its vals backing is
// 0 bytes).
//
// Operations are methods on @Table; NewTable is a package-level constructor.  Iteration
// follows the cursor convention shared by every pkg/stdx/containers package:
// t.Iter() returns a Cursor; it.Next() yields
// (Entry{Key, Val}, true) for each live entry in unspecified order, then (zero, false).
// A *Cursor satisfies iter.Iterator[Entry[K, V]], and a @Table is an
// iter.Iterable[Entry[K, V]].
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/std/table"

import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/iter"

// Entry is a key/value pair — the element type a Table's cursor yields, so a Table is
// an iter.Iterable[Entry[K, V]].  (K/V are unconstrained here: an Entry is a plain pair
// holder, and a Table always supplies its own policy-constrained K.)
type Entry[K any, V any] struct {
	Key K
	Val V
}

// Table is an open-addressing hash table from K to V, hashing keys through the Hasher
// policy H and testing key equality through the Eq policy E.  keys/vals/used are
// parallel managed-slices of length cap (always a power of two); a slot i is live iff
// used[i].  count is the number of live entries (count <= cap).  h/e are the policy
// values (zero-size for the intrinsic Default policies; a wrapped *func for the Fn
// policies).
type Table[K any, V any, H hash.Hasher[K], E cmp.Eq[K]] struct {
	keys  @[]K
	vals  @[]V
	used  @[]bool
	count int
	cap   int
	h     H
	e     E
}

// NewTable returns an empty Table with the given policies and an initial capacity of 8.
func NewTable[K any, V any, H hash.Hasher[K], E cmp.Eq[K]](h H, e E) @Table[K, V, H, E] {
	var t @Table[K, V, H, E] = make(Table[K, V, H, E])
	t.cap = 8
	t.keys = make_slice(K, t.cap)
	t.vals = make_slice(V, t.cap)
	t.used = make_slice(bool, t.cap)
	t.count = 0
	t.h = h
	t.e = e
	return t
}

// Len returns the number of live entries.
func (t @Table[K, V, H, E]) Len() int {
	return t.count
}

// grow doubles the capacity and re-inserts every live entry into fresh backing.
// Called by insertAbsent when an insert would push the load factor past 75%.
func (t @Table[K, V, H, E]) grow() {
	var oldKeys @[]K = t.keys
	var oldVals @[]V = t.vals
	var oldUsed @[]bool = t.used
	var oldCap int = t.cap
	t.cap = t.cap * 2
	t.keys = make_slice(K, t.cap)
	t.vals = make_slice(V, t.cap)
	t.used = make_slice(bool, t.cap)
	var gmask int = t.cap - 1
	for gi := 0; gi < oldCap; gi++ {
		if oldUsed[gi] {
			var gp int = cast(int, t.h.Hash(oldKeys[gi]) & cast(uint, gmask))
			for t.used[gp] {
				gp = (gp + 1) & gmask
			}
			t.keys[gp] = oldKeys[gi]
			t.vals[gp] = oldVals[gi]
			t.used[gp] = true
		}
	}
}

// insertAbsent stores (key, val) for a key the caller has ALREADY confirmed absent;
// `i` is the empty slot the caller's probe stopped on.  If the insert would exceed
// the 75% load factor it grows first — which reallocates the backing, so `i` is
// stale and the empty slot is re-found in the resized table.  Shared by Put (on a
// miss) and GetOrPut so there is exactly one insert/grow path, and so neither
// re-probes: the caller's `i` is reused whenever no grow happens.
func (t @Table[K, V, H, E]) insertAbsent(key K, val V, i int) {
	if (t.count + 1) * 4 > t.cap * 3 {
		t.grow()
		var mask int = t.cap - 1
		i = cast(int, t.h.Hash(key) & cast(uint, mask))
		for t.used[i] {
			i = (i + 1) & mask
		}
	}
	t.keys[i] = key
	t.vals[i] = val
	t.used[i] = true
	t.count = t.count + 1
}

// Put inserts key with val, or overwrites the value if key is already present.
// Overwriting an existing key never resizes (only an insert grows the table).
func (t @Table[K, V, H, E]) Put(key K, val V) {
	var mask int = t.cap - 1
	var i int = cast(int, t.h.Hash(key) & cast(uint, mask))
	for t.used[i] {
		if t.e.Equal(key, t.keys[i]) {
			// Refresh the stored key, not just the value: two keys that compare
			// Equal can still be distinct objects, and for a BORROW key (e.g.
			// *[]readonly char) the previously-stored borrow may point at backing
			// that the caller is about to free while `key` points at live backing.
			// Keeping the freshest key lets an overwrite-capable, borrow-keyed
			// table stay use-after-free-safe.  For value-type keys this is a
			// harmless copy of an equal value.
			t.keys[i] = key
			t.vals[i] = val
			return
		}
		i = (i + 1) & mask
	}
	t.insertAbsent(key, val, i)
}

// GetOrPut returns the value already stored for key, WITHOUT modifying the table,
// when key is present — (existing, true); otherwise it inserts (key, val) and
// returns (val, false).  It is the first-wins insert primitive: a single probe
// (unlike a Has-then-Put pair) that never overwrites an existing value.  The bool
// is "was present" (matching Get's found flag): true → the returned value is the
// pre-existing one and nothing changed; false → val was inserted.  Growth on insert
// matches Put.
func (t @Table[K, V, H, E]) GetOrPut(key K, val V) (V, bool) {
	var mask int = t.cap - 1
	var i int = cast(int, t.h.Hash(key) & cast(uint, mask))
	for t.used[i] {
		if t.e.Equal(key, t.keys[i]) {
			return t.vals[i], true
		}
		i = (i + 1) & mask
	}
	t.insertAbsent(key, val, i)
	return val, false
}

// Get returns (value, true) if key is present, or (zero, false) otherwise.
func (t @Table[K, V, H, E]) Get(key K) (V, bool) {
	var mask int = t.cap - 1
	var i int = cast(int, t.h.Hash(key) & cast(uint, mask))
	for t.used[i] {
		if t.e.Equal(key, t.keys[i]) {
			return t.vals[i], true
		}
		i = (i + 1) & mask
	}
	var zero V
	return zero, false
}

// Has reports whether key is present.
func (t @Table[K, V, H, E]) Has(key K) bool {
	_, ok := t.Get(key)
	return ok
}

// Remove deletes key and returns true, or returns false if key is absent.  It uses
// backward-shift deletion (no tombstones): starting from the found slot i (the gap),
// each following live entry at slot j is shifted back into i when — and only when — its
// home slot h is NOT cyclically within (i, j], because moving it back past its home
// would break its probe chain.  With mask arithmetic, h is in (i, j] iff
// (i < j) ? (i < h && h <= j) : (h > i || h <= j).  The final vacated slot is zeroed so
// a managed key/value is released promptly.
func (t @Table[K, V, H, E]) Remove(key K) bool {
	var mask int = t.cap - 1
	var i int = cast(int, t.h.Hash(key) & cast(uint, mask))
	for t.used[i] {
		if t.e.Equal(key, t.keys[i]) {
			break
		}
		i = (i + 1) & mask
	}
	if !t.used[i] {
		return false
	}
	var j int = i
	for {
		j = (j + 1) & mask
		if !t.used[j] {
			break
		}
		var h int = cast(int, t.h.Hash(t.keys[j]) & cast(uint, mask))
		var inRange bool = false
		if i < j {
			inRange = (i < h) && (h <= j)
		} else {
			inRange = (h > i) || (h <= j)
		}
		if !inRange {
			t.keys[i] = t.keys[j]
			t.vals[i] = t.vals[j]
			i = j
		}
	}
	t.used[i] = false
	var zeroK K
	var zeroV V
	t.keys[i] = zeroK
	t.vals[i] = zeroV
	t.count = t.count - 1
	return true
}

// Cursor is a forward iteration cursor over a Table (see Iter and Next).  It holds an
// owning reference to the Table, so the Table stays live for the cursor's lifetime.  A
// structural mutation (Put that grows, or Remove) during iteration invalidates a live
// cursor.
type Cursor[K any, V any, H hash.Hasher[K], E cmp.Eq[K]] struct {
	t @Table[K, V, H, E]
	i int
}

// Iter returns a Cursor positioned before the first live entry.
func (t @Table[K, V, H, E]) Iter() Cursor[K, V, H, E] {
	var it Cursor[K, V, H, E]
	it.t = t
	it.i = 0
	return it
}

// Next advances the cursor to the next live entry and returns (Entry{Key, Val}, true),
// or (zero, false) once the entries are exhausted.  Entries are visited in unspecified
// (slot) order.  Yielding a single Entry element lets a *Cursor satisfy the
// single-element iter.Iterator[Entry[K, V]] protocol.
func (it *Cursor[K, V, H, E]) Next() (Entry[K, V], bool) {
	for it.i < it.t.cap {
		var slot int = it.i
		it.i = it.i + 1
		if it.t.used[slot] {
			var e Entry[K, V]
			e.Key = it.t.keys[slot]
			e.Val = it.t.vals[slot]
			return e, true
		}
	}
	var zero Entry[K, V]
	return zero, false
}

impl *Cursor[K, V, H, E] : iter.Iterator[Entry[K, V]]

// AsIterator returns a boxed iterator over the live entries, satisfying
// iter.Iterable[Entry[K, V]].  It allocates a managed cursor (unlike the zero-cost
// value cursor Iter returns) so the cursor can be held behind the interface value.
func (t @Table[K, V, H, E]) AsIterator() @iter.Iterator[Entry[K, V]] {
	var c @Cursor[K, V, H, E] = make(Cursor[K, V, H, E])
	c.t = t
	c.i = 0
	return c
}

impl @Table[K, V, H, E] : iter.Iterable[Entry[K, V]]
