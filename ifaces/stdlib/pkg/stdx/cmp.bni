// Package cmp was promoted to pkg/std/cmp.  Compat forwarder: re-exports
// pkg/std/cmp's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/cmp"` consumers keep resolving the same entities.  New code
// should import "pkg/std/cmp".
package "pkg/stdx/cmp"

expose "pkg/std/cmp"
