// Package hashmap was promoted to pkg/std/hashmap.  Compat forwarder: re-exports
// pkg/std/hashmap's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/hashmap"` consumers keep resolving the same entities.
// New code should import "pkg/std/hashmap".
package "pkg/stdx/containers/hashmap"

expose "pkg/std/hashmap"
