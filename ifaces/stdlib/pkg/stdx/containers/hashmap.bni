// Package hashmap provides Map[K, V], an unordered hash map keyed by any lang.Hashable
// type.  It lives in the tier-1x `stdx` layer (standards-track, bundled with the
// toolchain, no inter-version compatibility guarantee); see
// explorations/pkg-layout-spec.md and explorations/plan-stdx-containers.md.
//
// Map is a thin wrapper over the shared open-addressing engine
// pkg/stdx/containers/table.Table with the INTRINSIC Default policies (hash.Default[K] /
// cmp.Default[K]).  Those policies are zero-size and monomorphize h.Hash(k)/e.Equal(a, b)
// to direct k.Hash() / k.Compare(other) == 0 calls — the same code a hand-inlined
// intrinsic map emits, with no indirection — so Map shares the probe / grow /
// backward-shift logic with the fn-injected mapfn.MapFn rather than duplicating it.  The
// key type is lang.Hashable (which extends lang.Comparable), which satisfies both policy
// bounds (hash.Default needs Hashable, cmp.Default needs Comparable).
//
// Iteration follows the shared cursor convention (plan-stdx-containers.md §3): m.Iter()
// returns a value cursor whose Next() yields (table.Entry{Key, Val}, true) per live entry
// in unspecified order, then (zero, false); a @Map is an iter.Iterable[table.Entry[K, V]]
// via AsIterator().  The Entry and Cursor types are table's own (Map adds no projection),
// exactly as mapfn.MapFn exposes them.
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/containers/hashmap"

import "pkg/builtins/lang"
import "pkg/stdx/cmp"
import "pkg/stdx/containers/iter"
import "pkg/stdx/containers/table"
import "pkg/stdx/hash"

// Map[K, V] is a hash map from K to V keyed by the key type's own lang.Hashable hashing
// and lang.Comparable equality.
type Map[K lang.Hashable, V any] struct {
	t @table.Table[K, V, hash.Default[K], cmp.Default[K]]
}

// New returns an empty Map[K, V] with an initial capacity of 8.
func New[K lang.Hashable, V any]() @Map[K, V] {
	var h hash.Default[K]
	var e cmp.Default[K]
	var m @Map[K, V] = make(Map[K, V])
	m.t = table.NewTable[K, V, hash.Default[K], cmp.Default[K]](h, e)
	return m
}

// Len returns the number of live entries.
func (m @Map[K, V]) Len() int { return m.t.Len() }

// Put inserts key with val, or overwrites the value if key is already present.
func (m @Map[K, V]) Put(key K, val V) { m.t.Put(key, val) }

// Get returns (value, true) if key is present, or (zero, false) otherwise.
func (m @Map[K, V]) Get(key K) (V, bool) { return m.t.Get(key) }

// Has reports whether key is present.
func (m @Map[K, V]) Has(key K) bool { return m.t.Has(key) }

// Remove deletes key and returns true, or returns false if key is absent.
func (m @Map[K, V]) Remove(key K) bool { return m.t.Remove(key) }

// Iter returns a value cursor positioned before the first live entry; its Next() yields
// (table.Entry{Key, Val}, true) per entry in unspecified order, then (zero, false).
func (m @Map[K, V]) Iter() table.Cursor[K, V, hash.Default[K], cmp.Default[K]] {
	return m.t.Iter()
}

// AsIterator returns a boxed iterator over the live entries, satisfying
// iter.Iterable[table.Entry[K, V]].
func (m @Map[K, V]) AsIterator() @iter.Iterator[table.Entry[K, V]] {
	return m.t.AsIterator()
}

impl @Map[K, V] : iter.Iterable[table.Entry[K, V]]
