// Package hashmap provides Map[K, V], an unordered hash map keyed by any
// lang.Hashable type.  It lives in the tier-1x `stdx` layer (standards-track,
// bundled with the toolchain, no inter-version compatibility guarantee); see
// explorations/pkg-layout-spec.md and explorations/plan-stdx-containers.md.
//
// The implementation is open addressing with linear probing over three parallel
// managed-slices (keys, vals, used) of a power-of-two capacity; deletion is
// backward-shift (no tombstones), so probe chains never accumulate dead slots.
//
// Operations are methods on @Map[K, V]; New is a package-level constructor (no
// receiver to attach to).  The key type is constrained to lang.Hashable — which
// extends lang.Comparable — so key.Hash() picks the bucket and
// key.Compare(other) == 0 tests equality, both as direct (monomorphized)
// constraint calls, not interface-value dispatch.  (The probe loop is repeated
// inline in Get/Put/Remove rather than factored into a private helper: a
// cross-package consumer monomorphizes these generic bodies at its own call site,
// so any helper they call must also live in this `.bni` — and every `.bni` symbol
// is exported, so there is no private-helper form.)
//
// Iteration follows the cursor convention shared by every pkg/stdx/containers
// package (plan-stdx-containers.md §3): m.Iter() returns a Cursor[K, V]; it.Next()
// yields (Entry{Key, Val}, true) for each live entry in unspecified order, then
// (zero, false).  A *Cursor[K, V] satisfies iter.Iterator[Entry[K, V]], and a
// @Map[K, V] is an iter.Iterable[Entry[K, V]] (its element type is a key/value
// entry).
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/containers/hashmap"

import "pkg/builtins/lang"
import "pkg/stdx/containers/iter"

// Entry is a key/value pair — the element type a Map's cursor yields, so a Map is
// an iter.Iterable[Entry[K, V]].  (K is unconstrained here: an Entry is a plain
// pair holder, and a Map always supplies a lang.Hashable K.)
type Entry[K any, V any] struct {
	Key K
	Val V
}

// Map is an open-addressing hash map from K to V.  keys/vals/used are parallel
// managed-slices of length cap (always a power of two); a slot i is live iff
// used[i].  count is the number of live entries (count <= cap).
type Map[K lang.Hashable, V any] struct {
	keys  @[]K
	vals  @[]V
	used  @[]bool
	count int
	cap   int
}

// New returns an empty Map[K, V] with an initial capacity of 8.
func New[K lang.Hashable, V any]() @Map[K, V] {
	var m @Map[K, V] = make(Map[K, V])
	m.cap = 8
	m.keys = make_slice(K, m.cap)
	m.vals = make_slice(V, m.cap)
	m.used = make_slice(bool, m.cap)
	m.count = 0
	return m
}

// Len returns the number of live entries.
func (m @Map[K, V]) Len() int {
	return m.count
}

// Put inserts key with val, or overwrites the value if key is already present.  An
// overwrite writes only the value, leaving the stored key untouched.  An insert
// grows the table first — doubling the capacity and re-inserting every live entry
// into fresh backing — when the insert would otherwise push the load factor past
// 75%; since only an insert can grow, overwriting an existing key never resizes.
// (The live count is unchanged while the capacity doubles, so the re-inserted
// table stays below the threshold and no second grow occurs.)
func (m @Map[K, V]) Put(key K, val V) {
	var mask int = m.cap - 1
	var i int = cast(int, key.Hash() & cast(uint, mask))
	for m.used[i] {
		if key.Compare(m.keys[i]) == 0 {
			m.vals[i] = val
			return
		}
		i = (i + 1) & mask
	}
	// key is absent (i is the first empty slot on its chain) — an insert.  Grow
	// first if the insert would exceed the 75% load factor; growth reallocates the
	// backing, so re-find the empty slot for key in the resized table.
	if (m.count + 1) * 4 > m.cap * 3 {
		var oldKeys @[]K = m.keys
		var oldVals @[]V = m.vals
		var oldUsed @[]bool = m.used
		var oldCap int = m.cap
		m.cap = m.cap * 2
		m.keys = make_slice(K, m.cap)
		m.vals = make_slice(V, m.cap)
		m.used = make_slice(bool, m.cap)
		var gmask int = m.cap - 1
		for gi := 0; gi < oldCap; gi++ {
			if oldUsed[gi] {
				var gp int = cast(int, oldKeys[gi].Hash() & cast(uint, gmask))
				for m.used[gp] {
					gp = (gp + 1) & gmask
				}
				m.keys[gp] = oldKeys[gi]
				m.vals[gp] = oldVals[gi]
				m.used[gp] = true
			}
		}
		mask = m.cap - 1
		i = cast(int, key.Hash() & cast(uint, mask))
		for m.used[i] {
			i = (i + 1) & mask
		}
	}
	m.keys[i] = key
	m.vals[i] = val
	m.used[i] = true
	m.count = m.count + 1
}

// Get returns (value, true) if key is present, or (zero, false) otherwise.
func (m @Map[K, V]) Get(key K) (V, bool) {
	var mask int = m.cap - 1
	var i int = cast(int, key.Hash() & cast(uint, mask))
	for m.used[i] {
		if key.Compare(m.keys[i]) == 0 {
			return m.vals[i], true
		}
		i = (i + 1) & mask
	}
	var zero V
	return zero, false
}

// Has reports whether key is present.
func (m @Map[K, V]) Has(key K) bool {
	_, ok := m.Get(key)
	return ok
}

// Remove deletes key and returns true, or returns false if key is absent.  It
// uses backward-shift deletion (no tombstones): starting from the found slot i
// (the gap), each following live entry at slot j is shifted back into i when — and
// only when — its home slot h is NOT cyclically within (i, j], because moving it
// back past its home would break its probe chain.  The interval is anchored on the
// gap i and candidate j: with mask arithmetic, h is in (i, j] iff (i < j) ?
// (i < h && h <= j) : (h > i || h <= j).  The final vacated slot is zeroed so a
// managed key/value is released promptly.
func (m @Map[K, V]) Remove(key K) bool {
	var mask int = m.cap - 1
	var i int = cast(int, key.Hash() & cast(uint, mask))
	for m.used[i] {
		if key.Compare(m.keys[i]) == 0 {
			break
		}
		i = (i + 1) & mask
	}
	if !m.used[i] {
		return false
	}
	var j int = i
	for {
		j = (j + 1) & mask
		if !m.used[j] {
			break
		}
		var h int = cast(int, m.keys[j].Hash() & cast(uint, mask))
		var inRange bool = false
		if i < j {
			inRange = (i < h) && (h <= j)
		} else {
			inRange = (h > i) || (h <= j)
		}
		if !inRange {
			m.keys[i] = m.keys[j]
			m.vals[i] = m.vals[j]
			i = j
		}
	}
	m.used[i] = false
	var zeroK K
	var zeroV V
	m.keys[i] = zeroK
	m.vals[i] = zeroV
	m.count = m.count - 1
	return true
}

// Cursor is a forward iteration cursor over a Map (see Iter and Next).  It holds
// an owning reference to the Map, so the Map stays live for the cursor's lifetime.
// A structural mutation (Put that grows, or Remove) during iteration invalidates a
// live cursor.
type Cursor[K lang.Hashable, V any] struct {
	m @Map[K, V]
	i int
}

// Iter returns a Cursor positioned before the first live entry.
func (m @Map[K, V]) Iter() Cursor[K, V] {
	var it Cursor[K, V]
	it.m = m
	it.i = 0
	return it
}

// Next advances the cursor to the next live entry and returns (Entry{Key, Val},
// true), or (zero, false) once the entries are exhausted.  Entries are visited in
// unspecified (slot) order.  It takes a pointer receiver because it mutates the
// cursor's position.  Yielding a single Entry element (rather than a bare
// (K, V, bool)) lets a *Cursor[K, V] satisfy the single-element
// iter.Iterator[Entry[K, V]] protocol shared by every pkg/stdx/containers cursor.
func (it *Cursor[K, V]) Next() (Entry[K, V], bool) {
	for it.i < it.m.cap {
		var slot int = it.i
		it.i = it.i + 1
		if it.m.used[slot] {
			var e Entry[K, V]
			e.Key = it.m.keys[slot]
			e.Val = it.m.vals[slot]
			return e, true
		}
	}
	var zero Entry[K, V]
	return zero, false
}

impl *Cursor[K, V] : iter.Iterator[Entry[K, V]]

// AsIterator returns a boxed iterator over the live entries, satisfying
// iter.Iterable[Entry[K, V]].  It allocates a managed cursor (unlike the zero-cost
// value cursor Iter returns) so the cursor can be held behind the
// @iter.Iterator[Entry[K, V]] interface value.
func (m @Map[K, V]) AsIterator() @iter.Iterator[Entry[K, V]] {
	var c @Cursor[K, V] = make(Cursor[K, V])
	c.m = m
	c.i = 0
	return c
}

impl @Map[K, V] : iter.Iterable[Entry[K, V]]
