// Package iter defines the iteration protocols shared by the pkg/stdx/containers
// packages.  Iterator[T] is the pull-based
// iteration protocol every container cursor satisfies; Iterable[T] is a
// type-erased sequence that produces a boxed Iterator[T] on demand.  Keeping them
// in their own leaf package lets each container depend on the protocol without
// depending on the other containers.
package "pkg/stdx/containers/iter"

// Iterator is the pull-based iteration protocol.  Next advances the iterator and
// returns (element, true), or (zero, false) once iteration is exhausted.  A
// container's *Cursor[T] satisfies Iterator[T].
interface Iterator[T any] {
	Next() (T, bool)
}

// Iterable is a sequence that can produce an Iterator[T].  Unlike a container's
// concrete `Iter() Cursor[T]` (zero-cost, monomorphic), AsIterator returns a boxed
// @Iterator[T] — dynamic dispatch that lets code range over any Iterable[T]
// without being generic over the concrete container.  A map is an
// Iterable[Entry[K, V]] (its element type is a key/value entry).
interface Iterable[T any] {
	AsIterator() @Iterator[T]
}
