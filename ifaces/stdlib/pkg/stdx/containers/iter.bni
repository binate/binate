// Package iter defines the iteration protocol shared by the pkg/stdx/containers
// packages (see plan-stdx-containers.md §3).  Iterator[T] is the pull-based
// iteration protocol every container cursor satisfies.  Keeping it in its own leaf
// package lets each container depend on the protocol without depending on the
// other containers.
package "pkg/stdx/containers/iter"

// Iterator is the pull-based iteration protocol.  Next advances the iterator and
// returns (element, true), or (zero, false) once iteration is exhausted.  A
// container's *Cursor[T] satisfies Iterator[T].
interface Iterator[T any] {
	Next() (T, bool)
}
