// Package iter was promoted to pkg/std/iter.  Compat forwarder: re-exports
// pkg/std/iter's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/iter"` consumers keep resolving the same entities.
// New code should import "pkg/std/iter".
package "pkg/stdx/containers/iter"

expose "pkg/std/iter"
