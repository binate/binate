// Package mapfn was promoted to pkg/std/mapfn.  Compat forwarder: re-exports
// pkg/std/mapfn's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/mapfn"` consumers keep resolving the same entities.
// New code should import "pkg/std/mapfn".
package "pkg/stdx/containers/mapfn"

expose "pkg/std/mapfn"
