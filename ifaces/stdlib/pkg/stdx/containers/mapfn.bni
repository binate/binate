// Package mapfn provides MapFn[K, V], an unordered hash map whose key hashing and
// equality are supplied as INJECTED functions rather than derived from a lang.Hashable
// key — so K may be any type (a raw pointer keyed by identity, text compared
// case-insensitively, a struct keyed by one field), without a wrapper type + a
// hand-written `impl : lang.Hashable`.  It lives in the tier-1x `stdx` layer.
//
// MapFn is a thin wrapper over the shared open-addressing engine
// pkg/stdx/containers/table.Table parameterized by the injected-function policies
// pkg/stdx/hash.FnHasher[K] and pkg/stdx/cmp.FnEq[K] — so it shares the probe / grow /
// backward-shift logic with the other Table-based containers rather than duplicating it.
// The hash/eq are indirect calls (through the stored *func) per probe; a future
// intrinsic-keyed Map over the Default policies would keep direct dispatch.
//
// Iteration follows the shared cursor convention: m.Iter() returns a value cursor whose
// Next() yields (table.Entry{Key, Val}, true) per live entry; a @MapFn is an
// iter.Iterable[table.Entry[K, V]] via AsIterator().
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/containers/mapfn"

import "pkg/stdx/cmp"
import "pkg/stdx/containers/iter"
import "pkg/stdx/containers/table"
import "pkg/stdx/hash"

// MapFn[K, V] is a hash map from K to V keyed by injected hash/equality functions.
type MapFn[K any, V any] struct {
	t @table.Table[K, V, hash.FnHasher[K], cmp.FnEq[K]]
}

// NewMapFn returns an empty MapFn keyed by hashFn (K -> bucket seed) and eqFn (key
// equality).  eqFn must agree with hashFn: keys eqFn treats as equal must hash equal.
func NewMapFn[K any, V any](hashFn *func(K) uint, eqFn *func(K, K) bool) @MapFn[K, V] {
	var m @MapFn[K, V] = make(MapFn[K, V])
	m.t = table.NewTable[K, V, hash.FnHasher[K], cmp.FnEq[K]](hash.Fn[K](hashFn), cmp.Fn[K](eqFn))
	return m
}

// Len returns the number of live entries.
func (m @MapFn[K, V]) Len() int { return m.t.Len() }

// Put inserts key with val, or overwrites the value if key is already present.
func (m @MapFn[K, V]) Put(key K, val V) { m.t.Put(key, val) }

// Get returns (value, true) if key is present, or (zero, false) otherwise.
func (m @MapFn[K, V]) Get(key K) (V, bool) { return m.t.Get(key) }

// Has reports whether key is present.
func (m @MapFn[K, V]) Has(key K) bool { return m.t.Has(key) }

// Remove deletes key and returns true, or returns false if key is absent.
func (m @MapFn[K, V]) Remove(key K) bool { return m.t.Remove(key) }

// Iter returns a value cursor positioned before the first live entry; its Next() yields
// (table.Entry{Key, Val}, true) per entry in unspecified order, then (zero, false).
func (m @MapFn[K, V]) Iter() table.Cursor[K, V, hash.FnHasher[K], cmp.FnEq[K]] {
	return m.t.Iter()
}

// AsIterator returns a boxed iterator over the live entries, satisfying
// iter.Iterable[table.Entry[K, V]].
func (m @MapFn[K, V]) AsIterator() @iter.Iterator[table.Entry[K, V]] {
	return m.t.AsIterator()
}

impl @MapFn[K, V] : iter.Iterable[table.Entry[K, V]]
