// Package set provides Set[T], an unordered hash set of any lang.Hashable type.
// It lives in the tier-1x `stdx` layer (standards-track, bundled with the
// toolchain, no inter-version compatibility guarantee); see
// explorations/pkg-layout-spec.md and explorations/plan-stdx-containers.md.
//
// The implementation mirrors pkg/stdx/containers/hashmap minus the value slice:
// open addressing with linear probing over two parallel managed-slices (keys,
// used) of a power-of-two capacity; deletion is backward-shift (no tombstones),
// so probe chains never accumulate dead slots.  (It is deliberately standalone
// rather than a Map[T, unit] wrapper — no wasted value slice — at the cost of
// duplicating the open-addressing logic; factoring a shared core is a possible
// later refactor once the shape settles.)
//
// Operations are methods on @Set[T]; New is a package-level constructor (no
// receiver to attach to).  The element type is constrained to lang.Hashable —
// which extends lang.Comparable — so x.Hash() picks the bucket and
// x.Compare(other) == 0 tests equality, both as direct (monomorphized) constraint
// calls, not interface-value dispatch.  (The probe loop is repeated inline in
// Add/Has/Remove rather than factored into a helper: a cross-package consumer
// monomorphizes these generic bodies at its own call site, so any helper they call
// must also live in this `.bni`, which — like every `.bni` symbol — is exported.)
//
// Iteration follows the forward-compatible cursor convention shared by every
// pkg/stdx/containers package (plan-stdx-containers.md §3): s.Iter() returns a
// Cursor[T]; it.Next() yields (elem, true) for each member in unspecified order,
// then (zero, false).  A *Cursor[T] satisfies
// pkg/stdx/containers/iter.Iterator[T].
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/containers/set"

import "pkg/builtins/lang"
import "pkg/stdx/containers/iter"

// Set is an open-addressing hash set of T.  keys/used are parallel managed-slices
// of length cap (always a power of two); a slot i holds a member iff used[i].
// count is the number of members (count <= cap).
type Set[T lang.Hashable] struct {
	keys  @[]T
	used  @[]bool
	count int
	cap   int
}

// New returns an empty Set[T] with an initial capacity of 8.
func New[T lang.Hashable]() @Set[T] {
	var s @Set[T] = make(Set[T])
	s.cap = 8
	s.keys = make_slice(T, s.cap)
	s.used = make_slice(bool, s.cap)
	s.count = 0
	return s
}

// Len returns the number of members.
func (s @Set[T]) Len() int {
	return s.count
}

// Add inserts x and returns true, or returns false (leaving the set unchanged) if
// x is already a member.  A genuine insert grows the table first — doubling the
// capacity and re-inserting every member into fresh backing — when the insert
// would otherwise push the load factor past 75%; since only an insert can grow,
// re-adding an existing member never resizes.  (The member count is unchanged
// while the capacity doubles, so the re-inserted table stays below the threshold
// and no second grow occurs.)
func (s @Set[T]) Add(x T) bool {
	var mask int = s.cap - 1
	var i int = cast(int, x.Hash() & cast(uint, mask))
	for s.used[i] {
		if x.Compare(s.keys[i]) == 0 {
			return false
		}
		i = (i + 1) & mask
	}
	if (s.count + 1) * 4 > s.cap * 3 {
		var oldKeys @[]T = s.keys
		var oldUsed @[]bool = s.used
		var oldCap int = s.cap
		s.cap = s.cap * 2
		s.keys = make_slice(T, s.cap)
		s.used = make_slice(bool, s.cap)
		var gmask int = s.cap - 1
		for gi := 0; gi < oldCap; gi++ {
			if oldUsed[gi] {
				var gp int = cast(int, oldKeys[gi].Hash() & cast(uint, gmask))
				for s.used[gp] {
					gp = (gp + 1) & gmask
				}
				s.keys[gp] = oldKeys[gi]
				s.used[gp] = true
			}
		}
		mask = s.cap - 1
		i = cast(int, x.Hash() & cast(uint, mask))
		for s.used[i] {
			i = (i + 1) & mask
		}
	}
	s.keys[i] = x
	s.used[i] = true
	s.count = s.count + 1
	return true
}

// Has reports whether x is a member.
func (s @Set[T]) Has(x T) bool {
	var mask int = s.cap - 1
	var i int = cast(int, x.Hash() & cast(uint, mask))
	for s.used[i] {
		if x.Compare(s.keys[i]) == 0 {
			return true
		}
		i = (i + 1) & mask
	}
	return false
}

// Remove deletes x and returns true, or returns false if x is not a member.  It
// uses backward-shift deletion (no tombstones): starting from the found slot i
// (the gap), each following member at slot j is shifted back into i when — and
// only when — its home slot h is NOT cyclically within (i, j], because moving it
// back past its home would break its probe chain.  The interval is anchored on the
// gap i and candidate j: with mask arithmetic, h is in (i, j] iff (i < j) ?
// (i < h && h <= j) : (h > i || h <= j).  The final vacated slot is zeroed so a
// member with managed contents is released promptly.
func (s @Set[T]) Remove(x T) bool {
	var mask int = s.cap - 1
	var i int = cast(int, x.Hash() & cast(uint, mask))
	for s.used[i] {
		if x.Compare(s.keys[i]) == 0 {
			break
		}
		i = (i + 1) & mask
	}
	if !s.used[i] {
		return false
	}
	var j int = i
	for {
		j = (j + 1) & mask
		if !s.used[j] {
			break
		}
		var h int = cast(int, s.keys[j].Hash() & cast(uint, mask))
		var inRange bool = false
		if i < j {
			inRange = (i < h) && (h <= j)
		} else {
			inRange = (h > i) || (h <= j)
		}
		if !inRange {
			s.keys[i] = s.keys[j]
			i = j
		}
	}
	s.used[i] = false
	var zeroT T
	s.keys[i] = zeroT
	s.count = s.count - 1
	return true
}

// Cursor is a forward iteration cursor over a Set (see Iter and Next).  It holds
// an owning reference to the Set, so the Set stays live for the cursor's lifetime.
// A structural mutation (Add that grows, or Remove) during iteration invalidates a
// live cursor.
type Cursor[T lang.Hashable] struct {
	s @Set[T]
	i int
}

// Iter returns a Cursor positioned before the first member.
func (s @Set[T]) Iter() Cursor[T] {
	var it Cursor[T]
	it.s = s
	it.i = 0
	return it
}

// Next advances the cursor to the next member and returns (elem, true), or
// (zero, false) once the members are exhausted.  Members are visited in
// unspecified (slot) order.  It takes a pointer receiver because it mutates the
// cursor's position.
func (it *Cursor[T]) Next() (T, bool) {
	for it.i < it.s.cap {
		var slot int = it.i
		it.i = it.i + 1
		if it.s.used[slot] {
			return it.s.keys[slot], true
		}
	}
	var zeroT T
	return zeroT, false
}

impl *Cursor[T] : iter.Iterator[T]

// AsIterator returns a boxed iterator over the members, satisfying
// iter.Iterable[T].  It allocates a managed cursor (unlike the zero-cost value
// cursor Iter returns) so the cursor can be held behind the @iter.Iterator[T]
// interface value.
func (s @Set[T]) AsIterator() @iter.Iterator[T] {
	var c @Cursor[T] = make(Cursor[T])
	c.s = s
	c.i = 0
	return c
}

impl @Set[T] : iter.Iterable[T]
