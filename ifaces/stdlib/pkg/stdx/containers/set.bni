// Package set was promoted to pkg/std/set.  Compat forwarder: re-exports
// pkg/std/set's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/set"` consumers keep resolving the same entities.
// New code should import "pkg/std/set".
package "pkg/stdx/containers/set"

expose "pkg/std/set"
