// Package setfn was promoted to pkg/std/setfn.  Compat forwarder: re-exports
// pkg/std/setfn's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/setfn"` consumers keep resolving the same entities.
// New code should import "pkg/std/setfn".
package "pkg/stdx/containers/setfn"

expose "pkg/std/setfn"
