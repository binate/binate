// Package setfn provides SetFn[T], an unordered set whose element hashing and equality
// are supplied as INJECTED functions rather than derived from a lang.Hashable element —
// so T may be any type.  It is the set analogue of mapfn.MapFn; see
// explorations/plan-stdx-containers.md.
//
// SetFn is a thin wrapper over the shared open-addressing engine
// pkg/stdx/containers/table.Table with a zero-size value (its vals backing is 0 bytes),
// parameterized by pkg/stdx/hash.FnHasher[T] and pkg/stdx/cmp.FnEq[T] — so it shares the
// probe / grow / backward-shift logic with the map containers rather than duplicating it.
// The hash/eq are indirect calls (through the stored *func) per probe.
//
// TODO(iteration): a bare-element iterator (yielding T, not an Entry) needs a projecting
// cursor over table.Cursor, which currently trips a compiler bug (a struct field holding
// another package's generic Cursor + calling its multi-return Next miscodegens /
// compile-hangs; see claude-todo.md).  Add s.Iter()/AsIterator()/iter.Iterable once that
// is fixed.
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/containers/setfn"

import "pkg/stdx/cmp"
import "pkg/stdx/containers/table"
import "pkg/stdx/hash"

// Unit is the zero-size value a set stores for each present element.
type Unit struct {}

// SetFn[T] is a set of T keyed by injected hash/equality functions.
type SetFn[T any] struct {
	t @table.Table[T, Unit, hash.FnHasher[T], cmp.FnEq[T]]
}

// NewSetFn returns an empty SetFn keyed by hashFn and eqFn (which must agree: elements
// eqFn treats as equal must hash equal).
func NewSetFn[T any](hashFn *func(T) uint, eqFn *func(T, T) bool) @SetFn[T] {
	var s @SetFn[T] = make(SetFn[T])
	s.t = table.NewTable[T, Unit, hash.FnHasher[T], cmp.FnEq[T]](hash.Fn[T](hashFn), cmp.Fn[T](eqFn))
	return s
}

// Len returns the number of elements.
func (s @SetFn[T]) Len() int { return s.t.Len() }

// Add inserts elem and returns true, or returns false if elem was already present
// (mirroring set.Set.Add's newness contract).
func (s @SetFn[T]) Add(elem T) bool {
	var before int = s.t.Len()
	var u Unit
	s.t.Put(elem, u)
	return s.t.Len() != before
}

// Has reports whether elem is present.
func (s @SetFn[T]) Has(elem T) bool { return s.t.Has(elem) }

// Remove deletes elem and returns true, or returns false if elem is absent.
func (s @SetFn[T]) Remove(elem T) bool { return s.t.Remove(elem) }
