// Package table was promoted to pkg/std/table.  Compat forwarder: re-exports
// pkg/std/table's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/table"` consumers keep resolving the same entities.
// New code should import "pkg/std/table".
package "pkg/stdx/containers/table"

expose "pkg/std/table"
