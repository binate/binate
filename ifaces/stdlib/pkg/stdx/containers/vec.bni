// Package vec provides Vec[T], a growable array (dynamic vector) of any element
// type — the standard-library answer to Binate's deliberate lack of a built-in
// `append` or generic vector.  It lives in the tier-1x `stdx` layer
// (standards-track, bundled with the toolchain, no inter-version compatibility
// guarantee); see explorations/pkg-layout-spec.md and
// explorations/plan-stdx-containers.md.
//
// A Vec owns its backing managed-slice (whose length is the capacity); the first
// v.Len() elements are live.  Operations are methods on @Vec[T]; New is a
// package-level constructor (no receiver to attach to).
//
// Iteration follows the forward-compatible cursor convention shared by every
// pkg/stdx/containers package (plan-stdx-containers.md §3): v.Iter() returns a
// Cursor[T]; it.Next() yields (elem, true) until the live elements are exhausted,
// then (zero, false).  A *Cursor[T] satisfies pkg/stdx/containers/iter.Iterator[T].
//
// The operations are generic, so their bodies live here in the interface file: a
// consumer monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/containers/vec"

import "pkg/stdx/containers/iter"

// Vec is a growable array of T.  data is the backing managed-slice (its length is
// the capacity); n is the number of leading live elements (n <= len(data)).
type Vec[T any] struct {
	data @[]T
	n    int
}

// New returns an empty Vec[T]; the first Push allocates the backing.
func New[T any]() @Vec[T] {
	var v @Vec[T] = make(Vec[T])
	v.data = make_slice(T, 0)
	v.n = 0
	return v
}

// Len returns the number of live elements.
func (v @Vec[T]) Len() int {
	return v.n
}

// Cap returns the current capacity (the backing length); Push grows the backing
// only when Len reaches Cap.
func (v @Vec[T]) Cap() int {
	return len(v.data)
}

// Get returns the element at index i (the caller ensures 0 <= i < v.Len()).
func (v @Vec[T]) Get(i int) T {
	return v.data[i]
}

// Set replaces the element at index i (the caller ensures 0 <= i < v.Len()).
func (v @Vec[T]) Set(i int, x T) {
	v.data[i] = x
}

// Push appends x after the last live element.  When the backing is full it is
// replaced with one of twice the capacity (from a 4-element floor) and the live
// elements are copied across; Push is therefore amortized O(1).
func (v @Vec[T]) Push(x T) {
	if v.n == len(v.data) {
		var newCap int = 4
		if len(v.data) > 0 {
			newCap = len(v.data) * 2
		}
		var bigger @[]T = make_slice(T, newCap)
		for i := 0; i < v.n; i++ {
			bigger[i] = v.data[i]
		}
		v.data = bigger
	}
	v.data[v.n] = x
	v.n = v.n + 1
}

// Pop removes and returns the last live element as (x, true); on an empty Vec it
// returns (zero, false).  The vacated backing slot is cleared, so a managed
// element is released promptly (ownership transfers to the caller) rather than
// lingering until the slot is overwritten or the Vec is freed.
func (v @Vec[T]) Pop() (T, bool) {
	if v.n == 0 {
		var zero T
		return zero, false
	}
	v.n = v.n - 1
	var x T = v.data[v.n]
	var zero T
	v.data[v.n] = zero
	return x, true
}

// Items returns a managed-slice view of the live elements, sharing the Vec's
// backing.  It is valid until the next Push that grows the Vec, after which it
// refers to the old backing (stale content — never a dangling pointer, since the
// managed-slice retains that backing).  Mutating the returned slice mutates the
// Vec in place.
func (v @Vec[T]) Items() @[]T {
	return v.data[0:v.n]
}

// Cursor is a forward iteration cursor over a Vec (see Vec.Iter and Cursor.Next).
// It holds an owning reference to the Vec, so the Vec stays live for the cursor's
// lifetime.  A structural mutation that shrinks the Vec (Pop) invalidates a live
// cursor; a growing Push does not, because Next re-reads the Vec's current backing
// on each call.
type Cursor[T any] struct {
	v @Vec[T]
	i int
}

// Iter returns a Cursor positioned before the first element.
func (v @Vec[T]) Iter() Cursor[T] {
	var it Cursor[T]
	it.v = v
	it.i = 0
	return it
}

// Next advances the cursor and returns (element, true), or (zero, false) once the
// live elements are exhausted.  It takes a pointer receiver because it mutates the
// cursor's position.
func (it *Cursor[T]) Next() (T, bool) {
	if it.i >= it.v.n {
		var zero T
		return zero, false
	}
	var x T = it.v.data[it.i]
	it.i = it.i + 1
	return x, true
}

impl *Cursor[T] : iter.Iterator[T]
