// Package vec was promoted to pkg/std/vec.  Compat forwarder: re-exports
// pkg/std/vec's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/containers/vec"` consumers keep resolving the same entities.
// New code should import "pkg/std/vec".
package "pkg/stdx/containers/vec"

expose "pkg/std/vec"
