// Package flags was promoted to pkg/std/flags.  Compat forwarder: re-exports
// pkg/std/flags's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/flags"` consumers keep resolving the same entities.  New
// code should import "pkg/std/flags".  (cmd/bnc — BUILDER-compiled — imports
// this stdx path because the pinned BUILDER bundle ships pkg/stdx/flags but not
// pkg/std/flags; it moves to pkg/std/flags on the next BUILDER bump, when this
// forwarder is removed.)
package "pkg/stdx/flags"

expose "pkg/std/flags"
