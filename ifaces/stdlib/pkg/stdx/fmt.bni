// Package fmt provides minimal formatted I/O, modeled on Go's fmt but built on
// Binate's type-erased `...*any` variadic (claude-notes.md:252).  Each operand is
// a raw interface value `*any`; the formatter dispatches on its dynamic type at
// run time — a fast type switch over the built-in char-slice "strings" and the
// scalar numbers, written straight to the output with no reflection.  A custom
// `Formattable` interface and struct/default reflection are later layers.
//
// It lives in the tier-1x `stdx` layer (standards-track, bundled with the
// toolchain, no inter-version compatibility guarantee); see
// explorations/pkg-layout-spec.md.
//
// Operands may be passed bare or `&`-addressed.  An addressable value / scalar
// literal is implicitly value-borrowed into `*any` (`fmt.Print(s, n)`), and a
// bare STRING LITERAL boxes as its `*[]readonly char` char-slice
// (`fmt.Print("hi")`); the explicit `&` form (`fmt.Print(&s, &n)`) is equivalent.
//
// Recognized operand types: the char-slice spellings (`*[]readonly char`,
// `*[]char`, `@[]readonly char`, `@[]char` — Binate "strings"), and the scalars
// int / int64 / uint64 / bool / float32 / float64.  Any other dynamic type renders
// as a `%!?(<kind>)`-style placeholder until custom formatting / reflection lands.
package "pkg/stdx/fmt"

import "pkg/std/errors"
import "pkg/std/io"

// Fprint formats its operands and writes them to w.  Following Go, a space is
// added between two operands only when NEITHER is a string.  Returns the number of
// bytes written and the first write error (empty on success).
func Fprint(w @io.Writer, args ...*any) (int, @errors.Error)

// Fprintln formats its operands, writes them to w separated by single spaces, and
// appends a newline.  Returns the number of bytes written and the first write
// error.
func Fprintln(w @io.Writer, args ...*any) (int, @errors.Error)

// Sprint formats its operands with Fprint's spacing rule and returns the result as
// a string (a read-only char-slice).
func Sprint(args ...*any) @[]readonly char

// Sprintln formats its operands with Fprintln's spacing (spaces between all, a
// trailing newline) and returns the result as a string.
func Sprintln(args ...*any) @[]readonly char

// Print formats its operands with Fprint's rule and writes them to standard output.
func Print(args ...*any) (int, @errors.Error)

// Println formats its operands with Fprintln's rule and writes them to standard
// output.
func Println(args ...*any) (int, @errors.Error)

// Fprintf formats its operands per the format string and writes them to w.  A
// directive is `%[flags][width][.prec]verb`: verbs `%v %d %s %t %f %g %e %x %X %o
// %b %c %q %%`; flags `-` (left-justify), `0` (zero-pad), `+` (always sign), space
// (leading space for a non-negative number); `width` a minimum field width; and
// `.prec` a precision (float digits, min integer digits, or string truncation).
// Each directive consumes the next operand left-to-right.  (Not yet: `#` alternate
// form, `*` arg-width, `%x`/`%q` on non-string operands, and the `+`/space sign
// flags on `%v` of a number — use `%d`/`%f` for a signed default.)  A
// verb/type mismatch renders as `%!<verb>(<type>=<value>)`, too few operands as
// `%!<verb>(MISSING)`, extra operands as `%!(EXTRA <type>=<value>, ...)`, and a
// trailing bare `%` as `%!(NOVERB)` — never a silent drop.  Returns the number of
// bytes written and the write error (empty on success).
func Fprintf(w @io.Writer, format *[]readonly char, args ...*any) (int, @errors.Error)

// Printf formats its operands per the format string (see Fprintf) and writes them
// to standard output.
func Printf(format *[]readonly char, args ...*any) (int, @errors.Error)

// Sprintf formats its operands per the format string (see Fprintf) and returns the
// result as a string (a read-only char-slice).
func Sprintf(format *[]readonly char, args ...*any) @[]readonly char
