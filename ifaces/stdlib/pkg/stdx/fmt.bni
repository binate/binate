// Package fmt was promoted to pkg/std/fmt.  This .bni is a compat forwarder: it
// re-exports pkg/std/fmt's entire surface via `expose` (§16.5.2 `pkg.expose`), so
// existing `import "pkg/stdx/fmt"` consumers keep compiling against the same
// entities and can migrate at leisure.  New code should import "pkg/std/fmt".
package "pkg/stdx/fmt"

expose "pkg/std/fmt"
