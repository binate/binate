// Package hash provides Hasher[K], the hashing policy a hash-based container uses to
// bucket keys, plus two ready adapters: Default[K] (forward to the key type's own
// lang.Hashable.Hash) and FnHasher[K] (wrap an arbitrary *func(K) uint).  It lives in
// the tier-1x `stdx` layer (standards-track, bundled with the toolchain, no
// inter-version compatibility guarantee); see explorations/pkg-layout-spec.md and
// explorations/plan-stdx-containers.md.
//
// Hasher[K] takes the key as a PARAMETER (Hash(k K) uint) rather than a receiver, so
// unlike lang.Hashable it carries no Self and can be supplied as an injected,
// per-container policy: a zero-size Default[K] monomorphizes h.Hash(k) to a direct
// k.Hash() call (no overhead over hashing the key intrinsically), while FnHasher[K]
// routes each hash through an injected function for keys that are not — or should not
// be — lang.Hashable (pointer-by-identity, case-insensitive text, hash-by-one-field).
// Pairs with pkg/stdx/cmp's Eq[K] as the (hash, equality) a hash container needs.
//
// The types are generic, so their bodies live here in the interface file: a consumer
// monomorphizes each instantiation at its own call site from this source.
package "pkg/stdx/hash"

import "pkg/builtins/lang"

// Hasher[K] hashes a key of type K to a bucket-index seed.  A hash-based container
// takes a Hasher as a type parameter (`H Hasher[K]`) and calls h.Hash(key) to pick a
// bucket.  Two keys that an accompanying Eq treats as equal MUST hash equal.
interface Hasher[K any] {
	Hash(k K) uint
}

// Default[K] forwards to the key type's own lang.Hashable.Hash.  It is zero-size, so a
// container parameterized by Default[K] monomorphizes h.Hash(k) to a direct k.Hash()
// call — the same code the intrinsic Hashable path emits, with no indirection.
type Default[K lang.Hashable] struct {}

func (h Default[K]) Hash(k K) uint {
	return k.Hash()
}

impl Default[K] : Hasher[K]

// FnHasher[K] is the Hasher backed by an injected hash function; build one with Fn(fn).
// The container routes every hash through fn, so K need not be lang.Hashable.  The
// function is a raw *func — it captures nothing the container must keep alive; a hasher
// owning captured state would be a future @func variant.
type FnHasher[K any] struct {
	fn *func(K) uint
}

// Fn wraps a hash function as a FnHasher[K].
func Fn[K any](fn *func(K) uint) FnHasher[K] {
	var h FnHasher[K]
	h.fn = fn
	return h
}

func (h FnHasher[K]) Hash(k K) uint {
	return h.fn(k)
}

impl FnHasher[K] : Hasher[K]
