// Package hash was promoted to pkg/std/hash.  Compat forwarder: re-exports
// pkg/std/hash's surface via `expose` (§16.5.2 `pkg.expose`) so existing
// `import "pkg/stdx/hash"` consumers keep resolving the same entities.  New code
// should import "pkg/std/hash".
package "pkg/stdx/hash"

expose "pkg/std/hash"
