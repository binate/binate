// Package build exposes the compile-time target metadata — operating
// system, CPU architecture, and pointer/int widths — as constants, so
// code can specialize for the target it is being compiled for.  The
// values are compile-time constants (foldable), not runtime variables.
//
// Unusually, this package has no implementation: the constants ARE the
// package, and they vary per target.  Each supported target has its own
// copy under ifaces/targets/<key>/; `binate-paths --target <key>` (or
// host auto-detection) prepends the matching tree to the interface
// search path, so `import "pkg/builtins/build"` resolves to the copy
// for the active target.  This file is the aarch64-darwin copy.
package "pkg/builtins/build"

// OSType enumerates the supported target operating systems.
type OSType int

const (
	OS_LINUX OSType = iota
	OS_DARWIN
	OS_BAREMETAL
)

// ArchType enumerates the supported target CPU architectures.
type ArchType int

const (
	ARCH_X64 ArchType = iota
	ARCH_AARCH64
	ARCH_ARM32
)

// OS is the operating system this target runs on.
const OS OSType = OS_DARWIN

// Arch is the CPU architecture this target runs on.
const Arch ArchType = ARCH_AARCH64

// PtrSize is the size in bytes of a pointer on this target.
const PtrSize int = 8

// IntSize is the size in bytes of `int` on this target.
const IntSize int = 8
