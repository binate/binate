// Package link is a static linker library: it reads relocatable object files
// (ELF today), resolves symbols, patches relocations, and emits executables.
// This is the input/reader model plus the top-level entry points; the reader
// front-end is greenfield (the assembler has writers only).  See
// explorations/plan-linker-implementation.md.
package "pkg/binate/link"

// Normalized section flag bits (mapped from the ELF SHF_* flags).
const (
	SF_READ int = 1
	SF_WRITE int = 2
	SF_EXEC int = 4
)

// EM_X86_64 is the ELF e_machine value for x86-64 — a machine argument to Link.
const EM_X86_64 int = 62

// EM_AARCH64 is the ELF e_machine value for AArch64 — a machine argument to Link.
const EM_AARCH64 int = 183

// EM_ARM is the ELF e_machine value for arm32 — a machine argument to Link /
// NewLayout.  An arm32 object is ELF32/REL (32-bit ELF, relocations without an
// explicit addend word), which the reader and emitter handle by ELF class.
const EM_ARM int = 40

// PT_LOAD is the program-header type for a loadable segment — the p_type a driver passes
// to DefineSegment for an explicit PHDRS entry.
const PT_LOAD int = 1

// PF_X / PF_W / PF_R are the program-header segment permission flags a driver combines for
// DefineSegment (e.g. PF_R | PF_X for a text segment).
const (
	PF_X int = 1
	PF_W int = 2
	PF_R int = 4
)

// InputSection is one content section (text/rodata/data/bss) of an input object.
// Data is empty for a NOBITS (.bss) section; Size is the in-memory size, which
// is >= len(Data).  Type is the raw ELF sh_type; Flags is the normalized SF_*.
type InputSection struct {
	Name  @[]char
	Type  int
	Flags int
	Data  @[]uint8
	Size  uint
	Align int
	// OutIndex / OutOffset are assigned by Layout: which output section this
	// input section was merged into, and its byte offset within it.  Unset
	// (0) until Layout runs; OutIndex is -1 after Layout for a section that fell
	// into an omitted (entirely empty) kind, which has no output section.
	OutIndex  int
	OutOffset uint
}

// InputSymbol is one symbol-table entry.  SecIndex indexes InputObject.Sections
// for a symbol defined in one of the object's content sections, or is -1 for an
// undefined external (and for any symbol whose defining section the reader does
// not keep).  Binding is 0 local / 1 global / 2 weak.  Size is the symbol's st_size.
//
// Common marks a common (tentative-definition) symbol — a C `int x;` at file scope,
// SHN_COMMON in the object.  It has SecIndex -1 (not yet in a section); Size is the
// required byte count and Value is the required alignment.  A `*(COMMON)` placement
// allocates the space and defines the symbol, so an ordinary undefined external
// (Common false, SecIndex -1) and a tentative definition (Common true) are distinct.
type InputSymbol struct {
	Name     @[]char
	SecIndex int
	Value    uint
	Binding  int
	Size     uint
	Common   bool
}

// InputReloc is one relocation.  SecIndex is the content section being patched;
// SymIndex indexes InputObject.Symbols; Kind is the on-disk ELF relocation type
// number (decoded fresh, not the assembler's internal FIX_* tag); Addend is the
// explicit RELA addend.
type InputReloc struct {
	SecIndex int
	Offset   uint
	SymIndex int
	Kind     int
	Addend   int
}

// InputObject is a parsed relocatable object file.  Machine is the ELF e_machine
// (EM_X86_64 / EM_AARCH64 / EM_ARM).
type InputObject struct {
	Path     @[]char
	Machine  int
	Sections @[]InputSection
	Symbols  @[]InputSymbol
	Relocs   @[]InputReloc
}

// ReadObject reads the relocatable ELF object at path into an InputObject — either
// class, ELF64/RELA (x86-64, aarch64) or ELF32/REL (arm32), by the EI_CLASS byte.
// On success the returned error is empty ("") and the object is present; on failure
// the error is a non-empty message and the object is absent (test the error, or
// the object with `present`).
func ReadObject(path *[]readonly char) (@InputObject, @[]readonly char)

// ReadArchive reads a System V / GNU `ar` archive (`.a`) and returns its object
// members, each parsed into an InputObject labeled "path(member)".  The archive's
// symbol index ("/") and long-name table ("//") are consumed for name resolution
// but not returned; every other member must be a valid ELF object.  Returns
// (members, "") on success, or an empty slice and a non-empty error.
func ReadArchive(path *[]readonly char) (@[]@InputObject, @[]readonly char)

// Link links the given inputs into a static ELF64 executable at outPath (mode
// 0o755), entering at the symbol named entryName.  Each input is classified by
// magic: an ELF object is always linked; a System V / GNU `.a` archive contributes
// only the members that resolve undefined references (extracted on demand, to a
// fixpoint).  It resolves cross-object symbols, lays sections out from base,
// patches relocations, and writes the executable.  machine is the ELF e_machine
// (EM_X86_64 / EM_AARCH64 / EM_ARM — arm32 producing a static ELF32).  Returns "" on
// success or a non-empty error (a read, unrecognized-input, machine-mismatch, resolve,
// unresolved-entry, relocation, or emit failure).
func Link(inputPaths @[]@[]char, entryName *[]readonly char, machine int, base uint64,
		outPath *[]readonly char) @[]readonly char

// LinkDynElf links inputPaths into a dynamically-linked ELF executable (aarch64 or
// x86-64) at outPath, entering at entryName.  Undefined externals become dynamic
// imports resolved at load by the platform dynamic linker (ld-linux-aarch64.so.1 /
// ld-linux-x86-64.so.2) — so a program may call libc without the symbols being defined
// in any input.  libc.so.6 is always a needed library (DT_NEEDED); sharedLibPaths adds
// one more DT_NEEDED per shared object, named by that object's own SONAME (its
// DT_SONAME), so a program may also import from non-libc libraries.  It synthesizes the
// loader-facing sections (.interp/.dynsym/.dynstr/.hash/.plt/.got.plt/.rela.plt/
// .rela.dyn/.got/.dynamic) and a PT_INTERP/PT_DYNAMIC ELF.  Returns "" on success or a
// non-empty error.
func LinkDynElf(inputPaths @[]@[]char, entryName *[]readonly char, machine int, base uint64,
		outPath *[]readonly char, sharedLibPaths @[]@[]char) @[]readonly char

// LinkDynMacho links inputPaths (arm64 Mach-O objects) into a dynamically-linked,
// ad-hoc-code-signed Mach-O executable at outPath, entering at entryName.  Undefined
// externals become dynamic imports from libSystem, bound at load by /usr/lib/dyld —
// so a program may call libc (e.g. `_exit`) or reach a libSystem data symbol without
// the symbol being defined in any input.  It synthesizes a __TEXT stub per called
// import + a __got slot per import (bound via LC_DYLD_INFO_ONLY, non-lazy) in a writable
// __DATA segment shared with the program's own .data/.bss, and emits the loader-facing
// load commands (LC_LOAD_DYLINKER/DYLIB, LC_MAIN, LC_BUILD_VERSION, LC_SYMTAB) plus an
// ad-hoc signature.  base is the code base (segStart = base - header size).  Returns ""
// on success or a non-empty error.  arm64 only.
func LinkDynMacho(inputPaths @[]@[]char, entryName *[]readonly char, machine int, base uint64,
		outPath *[]readonly char) @[]readonly char

// Section is the handle BeginSection returns, naming an output section (for a later
// LoadAddrOf / AssignSection).  Idx is the section's index in creation order.
type Section struct {
	Idx int
}

// LayoutBuilder is the scripted-layout engine a bnld driver drives to place input
// sections at addresses, define symbols, and emit an executable or a flat binary — the
// substrate expressing what a GNU ld linker script expresses, within what Binate's
// linker supports.  It is opaque: a driver obtains one from NewLayout, issues placement
// primitives (memory regions, the location counter, output sections and their input
// globs, LMA≠VMA, explicit segments, symbols, data/fill), then calls Finish followed by
// EmitElf / EmitRawBinary.
type LayoutBuilder

// NewLayout creates an empty scripted-layout builder targeting machine (an EM_* value).
func NewLayout(machine int) @LayoutBuilder

// SetInputs gives the builder the pool of objects that Place globs over; each input
// section is placed at most once (consume-once), claimed by the first matching pattern.
func (b @LayoutBuilder) SetInputs(objs @[]@InputObject)

// SetDot sets the location counter (the VMA at which the next placed content lands) to
// an absolute address.
func (b @LayoutBuilder) SetDot(addr uint64)

// DefineRegion adds a named memory region (a MEMORY entry) spanning [origin, origin +
// length) with attrs (advisory permission bits).  A section routed to it (SectionAtRegion
// / SectionLoadRegion) draws VMA / LMA from the region's own advancing cursor, and
// overflowing the region is a Finish-time error.
func (b @LayoutBuilder) DefineRegion(name *[]readonly char, origin uint64, length uint64, attrs int)

// SetDotToRegion sets the location counter to a region's current allocation cursor
// (`. = ORIGIN(region)` initially, then wherever prior placement into it left off).
func (b @LayoutBuilder) SetDotToRegion(name *[]readonly char)

// BeginSection opens a new output section (its VMA taken from the current location
// counter) with the given normalized SF_* flags and returns its handle; EndSection
// closes it.
func (b @LayoutBuilder) BeginSection(name *[]readonly char, flags int) Section

// EndSection finalizes the open section, freezing its size and advancing any region
// cursor it drew from.
func (b @LayoutBuilder) EndSection()

// Place appends every not-yet-consumed input section whose name matches pattern — a
// `*(GLOB)` form such as "*(.text*)", or "*(COMMON)" to synthesize storage for common
// symbols — to the open section, in pool order, honoring each input's own alignment.
// keep marks the match as never-GC'd (accepted for shape; GC is not implemented).
func (b @LayoutBuilder) Place(pattern *[]readonly char, keep bool)

// EmitData appends literal bytes to the open section (a boot signature, a hand-built
// table).
func (b @LayoutBuilder) EmitData(bytes @[]uint8)

// PadTo advances the open section to absolute VMA addr, filling the gap with fill (a
// zero fill is a reservation; a non-zero fill writes fill bytes).  addr must be at or
// beyond the current location.
func (b @LayoutBuilder) PadTo(addr uint64, fill uint8)

// Finish resolves cross-object references against the frozen addresses (injecting the
// layout-defined symbols), resolves the entry, and applies every relocation — readying
// the layout for emit.  It must precede EmitElf / EmitRawBinary.  Returns "" on success,
// else a non-empty error (an undefined symbol or entry, or an out-of-range relocation).
func (b @LayoutBuilder) Finish() @[]readonly char

// EmitRawBinary writes the finished layout as a flat binary — section bytes packed by
// load address with no container, the `objcopy -O binary` form a boot ROM or MBR
// consumes.  Finish must have run.  Returns "" on success or a non-empty error.
func (b @LayoutBuilder) EmitRawBinary(out *[]readonly char) @[]readonly char

// AlignDot rounds the location counter up to a multiple of n — e.g. to page-align a
// writable group onto a fresh page so it maps as a segment disjoint from the read-only
// group (W^X).
func (b @LayoutBuilder) AlignDot(n int)

// SetEntry sets the program entry point to the address of the named symbol (resolved at
// Finish against the placed objects and the layout-defined symbols).
func (b @LayoutBuilder) SetEntry(name *[]readonly char)

// SetEntryAddr sets the program entry point to an absolute address (rather than a named
// symbol) — for a fixed reset vector or a raw image with no symbol to name.
func (b @LayoutBuilder) SetEntryAddr(addr uint64)

// EmitElf writes the finished layout as a static ELF executable — ELF64, or ELF32 for an
// arm32 (EM_ARM) layout — with sections coalesced into PT_LOAD segments by writability /
// VMA-LMA delta / contiguity (or the explicit DefineSegment table), entering at the
// address SetEntry / SetEntryAddr fixed.  Finish must have run.  Returns "" on success or
// a non-empty error.
func (b @LayoutBuilder) EmitElf(out *[]readonly char) @[]readonly char

// Segment is the handle DefineSegment returns, naming a program-header segment for
// AssignSection.  Idx is the segment's index in declaration order.
type Segment struct {
	Idx int
}

// Dot returns the current location counter (the VMA at which the next placed content
// lands) — a driver reads it for address arithmetic, e.g. a higher-half `AT(Dot() - KVMA)`.
func (b @LayoutBuilder) Dot() uint64

// DefineSegment declares an explicit program-header segment of type ptype (e.g. PT_LOAD)
// with permission flags (PF_*), and returns its handle.  Declaring any segment switches
// EmitElf from auto-deriving the program headers to using the declared ones.
func (b @LayoutBuilder) DefineSegment(name *[]readonly char, ptype int, flags int) Segment

// AssignSection assigns an output section to an explicit segment (the section's bytes map
// under that segment's program header).
func (b @LayoutBuilder) AssignSection(sec Section, seg Segment)

// SectionLoadAddr sets the open section's load address (LMA) to an explicit address
// (`AT(addr)`) — so it loads at one address but runs at another (a higher-half image, a
// ROM-copy).  Set before the section takes content.
func (b @LayoutBuilder) SectionLoadAddr(lma uint64)

// SectionAtRegion routes the open section's VMA to a named region (`> REGION`): the
// location counter moves to that region's cursor and the section runs (and, unless an LMA
// is set, loads) there.  Set before the section takes content.
func (b @LayoutBuilder) SectionAtRegion(name *[]readonly char)

// SectionLoadRegion routes the open section's LMA to a named region (`AT> REGION`): its
// bytes load from that region's cursor while it runs at its VMA — the ROM-copy pattern
// (a .data image shipped in FLASH, run from RAM).  Set before the section takes content.
func (b @LayoutBuilder) SectionLoadRegion(name *[]readonly char)

// SectionAlign aligns the open section's start up to a multiple of n (`. = ALIGN(n)` at a
// section boundary) and records n as the section's alignment.  Set before content.
func (b @LayoutBuilder) SectionAlign(n int)

// DefineSymbol defines an absolute (layout-defined) symbol with an explicit value,
// visible to relocations and the entry lookup at Finish (last write wins).  A driver uses
// it for fixed addresses — a stack top, an MMIO base, a region boundary.
func (b @LayoutBuilder) DefineSymbol(name *[]readonly char, value uint64)

// SymbolAtDot defines an absolute symbol equal to the current location counter — the
// section-boundary symbol idiom (`__bss_start`/`__bss_end`, `_end`) a startup routine
// reads to zero .bss or bound a copy (last write wins).
func (b @LayoutBuilder) SymbolAtDot(name *[]readonly char)

// LoadAddrOf returns a section's load address (LMA) — the LOADADDR() of a ROM-copy
// section, e.g. to define `_sidata` = LOADADDR(.data) for a startup copy loop.  Valid once
// the section has started (its start freezes at its first content op or EndSection).
func (b @LayoutBuilder) LoadAddrOf(sec Section) uint64

// --- Layer 2: declarative layout spec (sugar over the LayoutBuilder) ---
//
// A driver builds a LayoutScript value and calls LinkWithScript (or CompileScript on its
// own builder, to mix in imperative calls).  It targets the common linker-script case;
// the esoteric (hand data blobs, arbitrary PHDRS arithmetic) drops to the builder.

// ScriptItem is one ordered operation in a section body.  Construct it with Place / SymAt /
// SetDotTo / AlignTo (a driver holds and orders items but does not read their fields).
type ScriptItem struct {
	Kind    int
	Pattern @[]char
	Keep    bool
	Sym     @[]char
	Addr    uint64
	N       int
}

// Place returns a section item that appends every not-yet-consumed input section matching
// pattern (a `*(GLOB)` such as "*(.text*)" or "*(COMMON)"); keep marks it never-GC'd.
func Place(pattern *[]readonly char, keep bool) ScriptItem

// SymAt returns a section item defining an absolute symbol equal to the current location
// counter — the section-boundary idiom (`__bss_start`, `_edata`).
func SymAt(name *[]readonly char) ScriptItem

// SetDotTo returns a section item that sets the location counter to an absolute address.
func SetDotTo(addr uint64) ScriptItem

// AlignTo returns a section item that rounds the location counter up to a multiple of n.
func AlignTo(n int) ScriptItem

// RegionSpec is a MEMORY region: [Origin, Origin+Length) with advisory Attrs (SF_* bits).
type RegionSpec struct {
	Name   @[]char
	Origin uint64
	Length uint64
	Attrs  int
}

// SegmentSpec is an explicit program-header segment (PHDRS entry) of type Ptype (e.g.
// PT_LOAD) with permission Flags (PF_*); a section names it to be assigned to it.
type SegmentSpec struct {
	Name  @[]char
	Ptype int
	Flags int
}

// SectionSpec is one output section.  Flags are the normalized SF_* bits.  VmaRegion (if
// non-empty) routes the VMA to a region (`> REGION`); else the VMA is the current dot.
// LmaRegion (`AT> REGION`) or HasLmaAddr/LmaAddr (`AT(addr)`) sets a load address distinct
// from the run address (a ROM-copy / higher-half section); neither means LMA==VMA.  Align
// (if > 0) aligns the section start.  Segment (if non-empty) assigns the section to an
// explicit segment by name.  Items is the ordered body.
type SectionSpec struct {
	Name       @[]char
	Flags      int
	VmaRegion  @[]char
	LmaRegion  @[]char
	HasLmaAddr bool
	LmaAddr    uint64
	Align      int
	Segment    @[]char
	Items      @[]ScriptItem
}

// AbsSymSpec is a top-level absolute symbol with a fixed value (e.g. `_stack_top`), defined
// after the sections are placed.
type AbsSymSpec struct {
	Name  @[]char
	Value uint64
}

// LayoutScript is a whole declarative layout.  Regions and Segments are declared first;
// HasStartDot/StartDot sets the initial location counter (for a script placing from a fixed
// base rather than a region); Sections are placed in order; AbsSyms are defined after;
// Entry (a symbol name) or HasEntryAddr/EntryAddr fixes the entry; Raw selects a flat
// binary instead of ELF.
type LayoutScript struct {
	Regions      @[]RegionSpec
	Segments     @[]SegmentSpec
	HasStartDot  bool
	StartDot     uint64
	Sections     @[]SectionSpec
	AbsSyms      @[]AbsSymSpec
	Entry        @[]char
	HasEntryAddr bool
	EntryAddr    uint64
	Raw          bool
}

// CompileScript issues the Layer-1 calls for s against an existing builder b (so a driver
// can compile most of a layout declaratively, then add imperative builder calls for a
// weird section before Finish).  It does NOT call Finish or emit.  Returns "" on success or
// the first error (an unknown region/segment name, or a builder error).
func CompileScript(b @LayoutBuilder, s LayoutScript) @[]readonly char

// LinkWithScript is the one-shot convenience over Layer 1: it reads inputPaths, compiles
// the declarative script s for machine (an EM_* value), resolves + relocates (Finish), and
// emits — an ELF executable, or a flat binary if s.Raw.  Returns "" on success or a
// non-empty error (a read, script, or Finish/emit failure).
func LinkWithScript(inputPaths @[]@[]char, s LayoutScript, machine int,
		out *[]readonly char) @[]readonly char
