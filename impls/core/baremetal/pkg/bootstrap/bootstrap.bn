package "pkg/bootstrap"

import "pkg/semihost"

// Bare-metal ARM32 implementation of `pkg/bootstrap`.  Selected
// when bnc is invoked with `--target arm32-baremetal` plus
// `--impl-path runtime/baremetal_arm32` (the v1 path-mechanism
// override — see plan-arm32-bare-metal.md).
//
// Format helpers (formatInt, formatInt64, formatBool, formatFloat,
// Concat) are duplicated verbatim from the libc-host
// implementation — they're pure Binate, target-agnostic.  TODO:
// extract these into a separate package (pkg/format?) so both
// targets share rather than duplicate.
//
// Process / I/O surface (Write / Exit / Args): the libc-host build
// resolves these to binate_runtime.c's mangled `bootstrap.*` symbols at
// link time; on bare-metal there's no host OS, so we provide Binate
// implementations instead — Write and Exit go through semihosting
// (SemihostWriteChar / SemihostExit); Args is a no-op (no argv).  General
// file I/O lives in pkg/std/os and is unavailable
// on bare metal; bootstrap's Open / Read / Close / Stat / ReadDir surface
// has been retired.

// formatInt writes the decimal representation of v into buf and
// returns the number of bytes written. Caller MUST pass a buffer
// of at least 20 bytes — this function does not bounds-check.
// (int64 max is 19 digits + sign sign.)
//
// Used by the print/println builtin's IR-gen lowering: it allocs a
// stack [20]uint8, calls formatInt, then writes the resulting
// prefix via bootstrap.Write.
func formatInt(v int, buf *[]uint8) int {
	if v == 0 {
		buf[0] = cast(uint8, '0')
		return 1
	}
	var negative bool = false
	var mag uint64 = 0
	if v < 0 {
		negative = true
		// `0 - v` overflows when v is int-min; compute the
		// magnitude via two's-complement uint64 so the int-min
		// boundary stringifies correctly.
		mag = cast(uint64, 0) - cast(uint64, v)
	} else {
		mag = cast(uint64, v)
	}
	// Reverse-write digits into a temp.
	var digits [20]uint8
	var count int = 0
	for mag > cast(uint64, 0) {
		digits[count] = cast(uint8, cast(int, mag % cast(uint64, 10)) + cast(int, '0'))
		mag = mag / cast(uint64, 10)
		count = count + 1
	}
	var pos int = 0
	if negative {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
	}
	for i := count - 1; i >= 0; i-- {
		buf[pos] = digits[i]
		pos = pos + 1
	}
	return pos
}

// formatInt64 is the int64 counterpart of formatInt, needed by
// formatFloat on 32-bit targets where IEEE-754 mantissas exceed
// the host `int` width.  Identical logic, parameter widened to
// int64.
func formatInt64(v int64, buf *[]uint8) int {
	if v == 0 {
		buf[0] = cast(uint8, '0')
		return 1
	}
	var negative bool = false
	var mag uint64 = 0
	if v < 0 {
		negative = true
		// `0 - v` overflows at int64-min; go through uint64 two's-
		// complement instead.
		mag = cast(uint64, 0) - cast(uint64, v)
	} else {
		mag = cast(uint64, v)
	}
	var digits [20]uint8
	var count int = 0
	for mag > cast(uint64, 0) {
		digits[count] = cast(uint8, cast(int, mag % cast(uint64, 10)) + cast(int, '0'))
		mag = mag / cast(uint64, 10)
		count = count + 1
	}
	var pos int = 0
	if negative {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
	}
	for i := count - 1; i >= 0; i-- {
		buf[pos] = digits[i]
		pos = pos + 1
	}
	return pos
}

// formatUint writes the decimal representation of v as an
// unsigned 64-bit integer.  Caller MUST pass a buffer of at
// least 20 bytes (uint64 max is 20 digits).  Copied verbatim
// from the libc-host pkg/bootstrap.  TODO: extract format
// helpers into a shared pkg/format so the duplicate goes away.
func formatUint(v uint64, buf *[]uint8) int {
	if v == cast(uint64, 0) {
		buf[0] = cast(uint8, '0')
		return 1
	}
	var digits [20]uint8
	var count int = 0
	for v > cast(uint64, 0) {
		digits[count] = cast(uint8, cast(int, v % cast(uint64, 10)) + cast(int, '0'))
		v = v / cast(uint64, 10)
		count = count + 1
	}
	var pos int = 0
	for i := count - 1; i >= 0; i-- {
		buf[pos] = digits[i]
		pos = pos + 1
	}
	return pos
}

// formatBool writes "true" or "false" into buf and returns the
// number of bytes written. Caller MUST pass a buffer of at least
// 5 bytes — this function does not bounds-check.
func formatBool(v bool, buf *[]uint8) int {
	if v {
		buf[0] = cast(uint8, 't')
		buf[1] = cast(uint8, 'r')
		buf[2] = cast(uint8, 'u')
		buf[3] = cast(uint8, 'e')
		return 4
	}
	buf[0] = cast(uint8, 'f')
	buf[1] = cast(uint8, 'a')
	buf[2] = cast(uint8, 'l')
	buf[3] = cast(uint8, 's')
	buf[4] = cast(uint8, 'e')
	return 5
}

// formatFloat writes a human-readable representation of v into buf
// and returns the number of bytes written. Caller MUST pass a
// buffer of at least 32 bytes — this function does not
// bounds-check.
//
// Bootstrap-grade: not %g-compatible. See bni for the full spec.
// Strategy: fixed-point "integer.6digits" for normal-magnitude
// values; exact mantissa*2^exponent fallback for very large
// (|v| ≥ 2^53) or very small (0 < |v| < ~1e-6, biased exp < 1003)
// values where fixed-point would lose information.
func formatFloat(v float64, buf *[]uint8) int {
	// IEEE-754 double has a 64-bit layout (1 sign + 11 exp + 52 mant)
	// that doesn't fit in a 32-bit Binate `int` under arm32-linux —
	// use int64 explicitly for the bit-level reasoning.  The mantissa
	// value (up to 2^53 - 1) is also too wide for int32.
	var bits int64 = bit_cast(int64, v)
	var sign int64 = (bits >> 63) & 1
	var exp int64 = (bits >> 52) & 2047 // 0x7FF
	var mant int64 = bits & 4503599627370495 // 0xFFFFFFFFFFFFF (52 bits)

	// NaN: exp == 0x7FF, mant != 0
	if exp == 2047 && mant != 0 {
		buf[0] = cast(uint8, 'N')
		buf[1] = cast(uint8, 'a')
		buf[2] = cast(uint8, 'N')
		return 3
	}
	// ±Inf: exp == 0x7FF, mant == 0
	if exp == 2047 {
		var pos int = 0
		if sign != 0 {
			buf[pos] = cast(uint8, '-')
		} else {
			buf[pos] = cast(uint8, '+')
		}
		pos = pos + 1
		buf[pos] = cast(uint8, 'I')
		buf[pos + 1] = cast(uint8, 'n')
		buf[pos + 2] = cast(uint8, 'f')
		return pos + 3
	}
	// ±0: exp == 0 and mant == 0
	if exp == 0 && mant == 0 {
		buf[0] = cast(uint8, '0')
		buf[1] = cast(uint8, '.')
		buf[2] = cast(uint8, '0')
		buf[3] = cast(uint8, '0')
		buf[4] = cast(uint8, '0')
		buf[5] = cast(uint8, '0')
		buf[6] = cast(uint8, '0')
		buf[7] = cast(uint8, '0')
		return 8
	}

	// Decide: fixed-point or mantissa*2^exponent fallback?
	// |v| ≥ 2^53 → no longer representable as exact int (biased exp ≥ 1076).
	// 0 < |v| < ~1e-6 (biased exp < 1003) → would print as "0.000000".
	// Denormals (exp == 0) are well below 1e-6, so always fallback.
	var useMantExp bool = false
	if exp >= 1076 { useMantExp = true }
	if exp < 1003 { useMantExp = true }

	if useMantExp {
		// Build the exact (mantissa, exponent) representation.
		// Normal: mantissa = (1 << 52) | mant, exponent = exp - 1023 - 52
		// Denormal (exp == 0): mantissa = mant, exponent = -1074
		// mantissa is 53 bits wide so must stay int64; exponent fits
		// int but the arithmetic is on int64 here for uniformity.
		var mantissa int64
		var exponent int64
		if exp == 0 {
			mantissa = mant
			exponent = -1074
		} else {
			mantissa = (1 << 52) | mant
			exponent = exp - 1075
		}
		var pos int = 0
		if sign != 0 {
			buf[pos] = cast(uint8, '-')
			pos = pos + 1
		}
		pos = pos + formatInt64(mantissa, buf[pos:])
		buf[pos] = cast(uint8, '*')
		pos = pos + 1
		buf[pos] = cast(uint8, '2')
		pos = pos + 1
		buf[pos] = cast(uint8, '^')
		pos = pos + 1
		// formatInt64 handles negative exponents (writes '-').
		pos = pos + formatInt64(exponent, buf[pos:])
		return pos
	}

	// Fixed-point: <sign?><integer>.<6-digit fraction, truncated>
	var pos int = 0
	if sign != 0 {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
		v = 0.0 - v
	}
	var intPart int = cast(int, v)
	pos = pos + formatInt(intPart, buf[pos:])
	buf[pos] = cast(uint8, '.')
	pos = pos + 1
	// Fractional: (v - intPart) * 1e6, truncated to int. Yields
	// 0..999999 for any value in fixed-point range.
	var frac float64 = v - cast(float64, intPart)
	var fracInt int = cast(int, frac * 1000000.0)
	var divisor int = 100000
	for i := 0; i < 6; i++ {
		var d int = (fracInt / divisor) % 10
		buf[pos] = cast(uint8, d + cast(int, '0'))
		pos = pos + 1
		divisor = divisor / 10
	}
	return pos
}

// Concat returns a fresh managed-slice containing a followed by b.
func Concat(a *[]readonly char, b *[]readonly char) @[]char {
	var lenA int = len(a)
	var lenB int = len(b)
	var s @[]char = make_slice(char, lenA + lenB)
	for i := 0; i < lenA; i++ {
		s[i] = a[i]
	}
	for i := 0; i < lenB; i++ {
		s[lenA + i] = b[i]
	}
	return s
}

// ============================================================
// I/O surface — only Write remains (the print/println lowering's sink).
// General file I/O lives in pkg/std/os and is unavailable on bare metal.
// ============================================================

// Write outputs the byte buffer to the debug console via
// semihosting SYS_WRITEC, one byte at a time.  `fd` is ignored —
// the host has a single console handle.  Returns the buffer
// length (no partial-write failure mode in this transport;
// SYS_WRITEC has no error path).
func Write(fd int, buf *[]readonly uint8) int {
	var n int = len(buf)
	for i := 0; i < n; i++ {
		semihost.SemihostWriteChar(cast(char, buf[i]))
	}
	return n
}
