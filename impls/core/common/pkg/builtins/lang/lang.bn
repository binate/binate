package "pkg/builtins/lang"

// Canonical Stringer impls for every universe primitive.  Per
// `plan-primitives-impl-interfaces.md` Slice 2a, this is the
// stdlib carve-out's "out-of-the-box" support: importing
// pkg/builtins/lang makes `*Stringer` accept any primitive value, so a
// user-written `printIt(s *Stringer)` works for `int`,
// `bool`, etc. without per-type wrappers.
//
// Receivers are value (`int`, `bool`, ...) — these methods
// don't mutate the receiver and the natural shape mirrors
// the primitive's own value semantics.  iv dispatch goes
// through per-(R, M) thunks emitted by the IR-gen
// thunk-generation pass (see plan-primitives-impl-
// interfaces.md § "Interface-value dispatch and value
// receivers").

// ============================================================
// Integer → decimal formatting
// ============================================================
//
// Everything funnels through the buffer-writing primitives
// `formatUint64Into` / `formatInt64Into` — one 64-bit-wide path,
// which is what lets the impls below keep every bit on 32-bit targets
// (where `int` is 32 bits) and render unsigned values >= 2^63
// correctly.  Casting down to the signed `int` before formatting would
// truncate the wide types on ILP32 and mis-sign large unsigned values.
// The float formatter (below) writes its mantissa / exponent / integer
// part through the same primitives, so there is a single
// integer-to-decimal implementation in this package.

// digitsUint64 returns the count of decimal digits in v (1 for 0).
func digitsUint64(v uint64) int {
	if v == cast(uint64, 0) { return 1 }
	var n int = 0
	var t uint64 = v
	for t > cast(uint64, 0) {
		t = t / cast(uint64, 10)
		n = n + 1
	}
	return n
}

// formatUint64Into writes v in decimal into buf starting at pos and
// returns the position just past the last digit.  The caller must
// ensure buf has room for digitsUint64(v) chars at pos.
func formatUint64Into(v uint64, buf *[]char, pos int) int {
	var n int = digitsUint64(v)
	var rem uint64 = v
	for i := pos + n - 1; i >= pos; i = i - 1 {
		buf[i] = cast(char,
			cast(int, rem % cast(uint64, 10)) + cast(int, '0'))
		rem = rem / cast(uint64, 10)
	}
	return pos + n
}

// formatInt64Into writes v in decimal (leading '-' for negatives) into
// buf at pos and returns the position past the last digit.  A
// negative's magnitude goes through two's-complement uint64 because
// `0 - v` overflows at int64-min.
func formatInt64Into(v int64, buf *[]char, pos int) int {
	if v < cast(int64, 0) {
		buf[pos] = '-'
		return formatUint64Into(
			cast(uint64, 0) - cast(uint64, v), buf, pos + 1)
	}
	return formatUint64Into(cast(uint64, v), buf, pos)
}

// formatUint64 returns a freshly-allocated managed-slice holding v in
// decimal.
func formatUint64(v uint64) @[]char {
	var s @[]char = make_slice(char, digitsUint64(v))
	formatUint64Into(v, s, 0)
	return s
}

// formatInt64 returns a freshly-allocated managed-slice holding v in
// decimal, with a leading '-' for negatives.
func formatInt64(v int64) @[]char {
	if v < cast(int64, 0) {
		var mag uint64 = cast(uint64, 0) - cast(uint64, v)
		var s @[]char = make_slice(char, 1 + digitsUint64(mag))
		formatInt64Into(v, s, 0)
		return s
	}
	var s @[]char = make_slice(char, digitsUint64(cast(uint64, v)))
	formatInt64Into(v, s, 0)
	return s
}

// ============================================================
// Signed integers
// ============================================================

// String formats an int in decimal.
func (x int) String() @[]char {
	return formatInt64(cast(int64, x))
}

// String formats an int8 in decimal.
func (x int8) String() @[]char {
	return formatInt64(cast(int64, x))
}

// String formats an int16 in decimal.
func (x int16) String() @[]char {
	return formatInt64(cast(int64, x))
}

// String formats an int32 in decimal.
func (x int32) String() @[]char {
	return formatInt64(cast(int64, x))
}

// String formats an int64 in decimal.
func (x int64) String() @[]char {
	return formatInt64(x)
}

// ============================================================
// Unsigned integers
// ============================================================
//
// These go through formatUint64 at full width, so values >= 2^63
// render correctly — casting to the signed `int` first would
// print them as a negative number.
//
// Note: char and byte are aliases of uint8 (TypChar() and
// TypByte() return the same singleton as TypUint8()), so the
// uint8 impl below covers all three.

// String formats a uint in decimal.
func (x uint) String() @[]char {
	return formatUint64(cast(uint64, x))
}

// String formats a uint8 (also char / byte) in decimal.
func (x uint8) String() @[]char {
	return formatUint64(cast(uint64, x))
}

// String formats a uint16 in decimal.
func (x uint16) String() @[]char {
	return formatUint64(cast(uint64, x))
}

// String formats a uint32 in decimal.
func (x uint32) String() @[]char {
	return formatUint64(cast(uint64, x))
}

// String formats a uint64 in decimal.
func (x uint64) String() @[]char {
	return formatUint64(x)
}

// ============================================================
// Booleans
// ============================================================

// String returns "true" or "false".
func (b bool) String() @[]char {
	if b {
		return "true"
	}
	return "false"
}

// ============================================================
// Floats
// ============================================================
//
// Approximate decimal output — fixed-point <integer>.<6 digits> for
// normal-magnitude values, scientific <d>.<up to 6 digits>e±k for very
// large or very small values (~7 significant digits, trailing zeros
// trimmed).  Not a shortest-round-trip formatter.

// String formats a float32 in decimal.
func (x float32) String() @[]char {
	return floatToCharSlice(cast(float64, x))
}

// String formats a float64 in decimal.
func (x float64) String() @[]char {
	return floatToCharSlice(x)
}

// floatToCharSlice formats x into a fixed scratch buffer via
// formatFloat, then returns a managed-slice trimmed to the exact
// written length.  32 chars covers the widest output (fixed-point
// sign + integer + "." + 6 fraction digits, or scientific
// sign + "9.999999" + "e" + signed exponent).
func floatToCharSlice(x float64) @[]char {
	var b @[]char = make_slice(char, 32)
	var n int = formatFloat(x, b, 0)
	var s @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		s[i] = b[i]
	}
	return s
}

// pow10 returns 10.0 raised to k (k may be negative) as a float64, via
// binary exponentiation — ~10 multiplies for the full double range.
// Inexact for |k| whose power isn't exactly representable (e.g. 10^23),
// which is what makes the scientific path approximate.
func pow10(k int) float64 {
	var n int = k
	if n < 0 { n = 0 - n }
	var result float64 = 1.0
	var base float64 = 10.0
	for n > 0 {
		if n % 2 == 1 { result = result * base }
		n = n / 2
		if n > 0 { base = base * base }
	}
	if k < 0 { return 1.0 / result }
	return result
}

// formatFloat writes x's decimal rendering into buf starting at pos and
// returns the position past the last char.  The IEEE-754 bit pattern is
// pulled out at int64 width (it doesn't fit a 32-bit `int` on ILP32).
// Three branches: special values (NaN / ±Inf / ±0), fixed-point for
// normal magnitudes, and scientific e-notation for very large or very
// small magnitudes.
func formatFloat(v float64, buf *[]char, pos int) int {
	var bits int64 = bit_cast(int64, v)
	var sign int64 = (bits >> 63) & 1
	var exp int64 = (bits >> 52) & 2047                   // 0x7FF
	var mant int64 = bits & 4503599627370495              // 52 bits

	// NaN: exp == 0x7FF, mant != 0.
	if exp == 2047 && mant != 0 {
		buf[pos] = 'N'
		buf[pos + 1] = 'a'
		buf[pos + 2] = 'N'
		return pos + 3
	}
	// ±Inf: exp == 0x7FF, mant == 0.
	if exp == 2047 {
		if sign != 0 {
			buf[pos] = '-'
		} else {
			buf[pos] = '+'
		}
		buf[pos + 1] = 'I'
		buf[pos + 2] = 'n'
		buf[pos + 3] = 'f'
		return pos + 4
	}
	// ±0: exp == 0 and mant == 0.
	if exp == 0 && mant == 0 {
		buf[pos] = '0'
		buf[pos + 1] = '.'
		buf[pos + 2] = '0'
		buf[pos + 3] = '0'
		buf[pos + 4] = '0'
		buf[pos + 5] = '0'
		buf[pos + 6] = '0'
		buf[pos + 7] = '0'
		return pos + 8
	}

	// Fixed-point vs scientific (e-notation) fallback?
	// |v| >= 2^53 (biased exp >= 1076) → no longer an exact integer.
	// 0 < |v| < ~1e-6 (biased exp < 1003) → would print as "0.000000".
	// Denormals (exp == 0) are well below 1e-6, so always fallback.
	var useSci bool = false
	if exp >= 1076 { useSci = true }
	if exp < 1003 { useSci = true }

	if useSci {
		// d.ddddde±k.  Estimate the decimal exponent from the binary one
		// (log10(2) ~ 0.30103), divide |v| by 10^k to normalize the
		// mantissa into [1, 10), then emit rounded significant digits.
		// The float64 divide is what makes this approximate.
		var p int = pos
		var absv float64 = v
		if sign != 0 {
			buf[p] = '-'
			p = p + 1
			absv = 0.0 - v
		}
		var e2 int = cast(int, exp) - 1023
		var k int = cast(int, cast(float64, e2) * 0.30102999566398114)
		var m float64 = absv / pow10(k)
		for m >= 10.0 {
			m = m / 10.0
			k = k + 1
		}
		for m < 1.0 {
			m = m * 10.0
			k = k - 1
		}
		// Round to 7 significant digits (1 + 6).  A carry past the
		// leading digit (m ~ 9.9999995) bumps the exponent.
		var scaled int = cast(int, m * 1000000.0 + 0.5)
		if scaled >= 10000000 {
			scaled = 1000000
			k = k + 1
		}
		buf[p] = cast(char, (scaled / 1000000) + cast(int, '0'))
		p = p + 1
		buf[p] = '.'
		p = p + 1
		var rest int = scaled % 1000000
		var div int = 100000
		for i := 0; i < 6; i++ {
			buf[p] = cast(char, ((rest / div) % 10) + cast(int, '0'))
			p = p + 1
			div = div / 10
		}
		// Trim trailing zeros and a now-dangling '.'.
		for p > 0 && buf[p - 1] == '0' {
			p = p - 1
		}
		if p > 0 && buf[p - 1] == '.' {
			p = p - 1
		}
		buf[p] = 'e'
		p = p + 1
		return formatInt64Into(cast(int64, k), buf, p)
	}

	// Fixed-point: <sign?><integer>.<6-digit fraction, truncated>.
	var p int = pos
	if sign != 0 {
		buf[p] = '-'
		p = p + 1
		v = 0.0 - v
	}
	var intPart int = cast(int, v)
	p = formatInt64Into(cast(int64, intPart), buf, p)
	buf[p] = '.'
	p = p + 1
	// Fractional: (v - intPart) * 1e6, truncated — 0..999999 in range.
	var frac float64 = v - cast(float64, intPart)
	var fracInt int = cast(int, frac * 1000000.0)
	var divisor int = 100000
	for i := 0; i < 6; i++ {
		var d int = (fracInt / divisor) % 10
		buf[p] = cast(char, d + cast(int, '0'))
		p = p + 1
		divisor = divisor / 10
	}
	return p
}

// ============================================================
// Impl declarations
// ============================================================
//
// Each impl pairs a primitive with the Stringer interface.
// The cross-package vtable machinery
// (`plan-cross-package-interfaces.md`) emits the per-(R, I)
// vtable globals (e.g.,
// __ivt.bn_pkg_std__int__pkg_std__Stringer); the iv-dispatch
// thunks (Slice A of plan-primitives-impl-interfaces.md) sit
// in the slot to adapt the iv pointer-shape ABI to the value-
// receiver methods above.

impl int : Stringer
impl int8 : Stringer
impl int16 : Stringer
impl int32 : Stringer
impl int64 : Stringer
impl uint : Stringer
impl uint8 : Stringer
impl uint16 : Stringer
impl uint32 : Stringer
impl uint64 : Stringer
impl bool : Stringer
impl float32 : Stringer
impl float64 : Stringer
