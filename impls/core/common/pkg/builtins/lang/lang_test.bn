package "pkg/builtins/lang"

import "pkg/builtins/testing/sys"

// Direct unit-test coverage for the canonical Stringer impls
// shipped with pkg/builtins/lang.  End-to-end iv-dispatch coverage lives
// in the conformance suite (411_pkg_std_stringer); these
// tests exercise the value-receiver methods themselves via
// the named-type method-call path.

// streq compares two char slices for equality.  Test-local
// helper to avoid an import just for a one-line comparison.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// fail wraps a TestResult for readability.
func fail(msg @[]char) sys.TestResult {
	return msg
}

// ============================================================
// Integer impls
// ============================================================

func TestIntStringPositive() sys.TestResult {
	var x int = 42
	if !streq(x.String(), "42") {
		return fail("int 42 should format as \"42\"")
	}
	return ""
}

func TestIntStringZero() sys.TestResult {
	var x int = 0
	if !streq(x.String(), "0") {
		return fail("int 0 should format as \"0\"")
	}
	return ""
}

func TestIntStringNegative() sys.TestResult {
	var x int = -7
	if !streq(x.String(), "-7") {
		return fail("int -7 should format as \"-7\"")
	}
	return ""
}

func TestInt8String() sys.TestResult {
	var x int8 = 127
	if !streq(x.String(), "127") {
		return fail("int8 127 should format as \"127\"")
	}
	return ""
}

func TestInt32StringNegative() sys.TestResult {
	var x int32 = -2147483648
	if !streq(x.String(), "-2147483648") {
		return fail("int32 INT_MIN unexpected")
	}
	return ""
}

// ============================================================
// Unsigned-integer impls
// ============================================================

func TestUintString() sys.TestResult {
	var x uint = 100
	if !streq(x.String(), "100") {
		return fail("uint 100 should format as \"100\"")
	}
	return ""
}

func TestUint8String() sys.TestResult {
	var x uint8 = 255
	if !streq(x.String(), "255") {
		return fail("uint8 255 should format as \"255\"")
	}
	return ""
}

// ============================================================
// Bool impl
// ============================================================

func TestBoolStringTrue() sys.TestResult {
	var b bool = true
	if !streq(b.String(), "true") {
		return fail("bool true should format as \"true\"")
	}
	return ""
}

func TestBoolStringFalse() sys.TestResult {
	var b bool = false
	if !streq(b.String(), "false") {
		return fail("bool false should format as \"false\"")
	}
	return ""
}

// ============================================================
// Float impls
// ============================================================
//
// formatFloat output is approximate (fixed-point integer.
// 6digits for normal-magnitude values).  We assert the leading
// digits, not the full string, so the tests don't drift if the
// formatter's tail changes.

func TestFloat64StringSimple() sys.TestResult {
	var x float64 = 3.0
	var s @[]char = x.String()
	if len(s) < 1 || s[0] != cast(char, '3') {
		return fail("float64 3.0 should start with '3'")
	}
	return ""
}

func TestFloat32StringNegative() sys.TestResult {
	var x float32 = -1.0
	var s @[]char = x.String()
	if len(s) < 1 || s[0] != cast(char, '-') {
		return fail("float32 -1.0 should start with '-'")
	}
	return ""
}

// ============================================================
// Full-width formatting (formatUint64 / formatInt64)
// ============================================================
//
// These pin the behavior the old cast-through-signed-`int` path got
// wrong: unsigned values >= 2^63 (which the cast rendered negative)
// and the full 64-bit signed range (truncated on 32-bit targets,
// where `int` is 32 bits).  The unsigned cases below already fail
// with the old code on a 64-bit host; the int64-wide case is
// additionally covered by a 32-bit conformance test.

func TestFormatUint64Zero() sys.TestResult {
	if !streq(formatUint64(cast(uint64, 0)), "0") {
		return fail("formatUint64(0) should be \"0\"")
	}
	return ""
}

func TestFormatUint64Max() sys.TestResult {
	var v uint64 = 18446744073709551615
	if !streq(formatUint64(v), "18446744073709551615") {
		return fail("formatUint64(UINT64_MAX)")
	}
	return ""
}

func TestFormatUint64Above2p63() sys.TestResult {
	// 2^63: a cast to the signed int would render this negative.
	var v uint64 = 9223372036854775808
	if !streq(formatUint64(v), "9223372036854775808") {
		return fail("formatUint64(2^63)")
	}
	return ""
}

func TestFormatInt64Max() sys.TestResult {
	var v int64 = 9223372036854775807
	if !streq(formatInt64(v), "9223372036854775807") {
		return fail("formatInt64(INT64_MAX)")
	}
	return ""
}

func TestFormatInt64Min() sys.TestResult {
	var v int64 = -9223372036854775808
	if !streq(formatInt64(v), "-9223372036854775808") {
		return fail("formatInt64(INT64_MIN)")
	}
	return ""
}

func TestFormatInt64Wide() sys.TestResult {
	// > 2^32: the old cast(int, x) truncated this on 32-bit targets.
	var v int64 = 4294967296
	if !streq(formatInt64(v), "4294967296") {
		return fail("formatInt64(2^32)")
	}
	return ""
}

// The same wide cases via the user-facing String() methods.

func TestUint64StringMax() sys.TestResult {
	var x uint64 = 18446744073709551615
	if !streq(x.String(), "18446744073709551615") {
		return fail("uint64 max via String()")
	}
	return ""
}

func TestUint32StringMax() sys.TestResult {
	var x uint32 = 4294967295
	if !streq(x.String(), "4294967295") {
		return fail("uint32 max via String()")
	}
	return ""
}

func TestInt64StringWide() sys.TestResult {
	var x int64 = 4294967296
	if !streq(x.String(), "4294967296") {
		return fail("int64 2^32 via String()")
	}
	return ""
}
