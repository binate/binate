package "pkg/builtins/lang"

// Canonical Comparable / Orderable / Hashable impls for every
// universe primitive.  Per `plan-primitives-impl-interfaces.md`
// Slice 2b: pkg/builtins/lang ships the ordering / equality story for
// every primitive so user code (especially future generic
// containers) can rely on `[T Orderable]` etc. without
// per-program impl ceremony.
//
// Compare returns -1 / 0 / 1 (signed int).  Magnitude beyond
// nonzero carries no meaning; consumers compare against zero.
//
// Hash returns uint.  Consistent with Compare: if Compare(a, b)
// == 0, Hash(a) == Hash(b).
//
// NaN handling for floats realizes the ratified total order
// (spec §20.1 pkg0.lang.float-nan): every NaN — any sign, any
// payload — sorts ABOVE +Inf and compares EQUAL to every other
// NaN, so the order is -Inf < …finites… < -0 < +0 < …finites…
// < +Inf < {all NaN}.  Among non-NaN values the order is the
// IEEE-754 totalOrder on the bit pattern, which distinguishes
// -0 < +0.  Because Compare folds all NaN into one equivalence
// class, Hashable consistency requires every NaN to hash
// identically: Hash canonicalizes any NaN to the hash of the
// canonical quiet-NaN bits (non-NaN values still hash by bit
// pattern, and the totalOrder's -0 < +0 keeps signed zeros
// hash-consistent — their bit patterns already differ).

// ============================================================
// Compare — signed integers
// ============================================================

// Compare returns -1 / 0 / 1 for <, ==, > on int.
func (a int) Compare(b int) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for int8.
func (a int8) Compare(b int8) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for int16.
func (a int16) Compare(b int16) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for int32.
func (a int32) Compare(b int32) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for int64.
func (a int64) Compare(b int64) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// ============================================================
// Compare — unsigned integers
// ============================================================

// Compare for uint.
func (a uint) Compare(b uint) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for uint8 (also char / byte).
func (a uint8) Compare(b uint8) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for uint16.
func (a uint16) Compare(b uint16) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for uint32.
func (a uint32) Compare(b uint32) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// Compare for uint64.
func (a uint64) Compare(b uint64) int {
	if a < b { return -1 }
	if a > b { return 1 }
	return 0
}

// ============================================================
// Compare — bool
// ============================================================

// Compare returns 0 for equal bools; if a (true) > b (false)
// returns 1; otherwise -1.  Total-ordering convention:
// false < true.
func (a bool) Compare(b bool) int {
	if a == b { return 0 }
	if a { return 1 }
	return -1
}

// ============================================================
// Compare — floats
// ============================================================

// floatTotalOrderKey32 maps a NON-NaN float32 to an unsigned key
// whose natural order is the IEEE-754 totalOrder over non-NaN
// values: negative values get every bit flipped, non-negative
// values get only the sign bit set, so smaller floats map to
// smaller keys (and -0 < +0).  Not meaningful for NaN — callers
// must filter NaN out first.
func floatTotalOrderKey32(f float32) uint32 {
	var bits uint32 = bit_cast(uint32, f)
	var signMask uint32 = cast(uint32, 1) << cast(uint32, 31)
	if (bits & signMask) != cast(uint32, 0) {
		return ~bits
	}
	return bits | signMask
}

// floatTotalOrderKey64 is the float64 analogue of
// floatTotalOrderKey32.  Not meaningful for NaN.
func floatTotalOrderKey64(f float64) uint64 {
	var bits uint64 = bit_cast(uint64, f)
	var signMask uint64 = cast(uint64, 1) << cast(uint64, 63)
	if (bits & signMask) != cast(uint64, 0) {
		return ~bits
	}
	return bits | signMask
}

// Compare for float32.  NaN sorts above every non-NaN value and
// all NaN compare equal (see file-header note); non-NaN values
// order by IEEE-754 totalOrder.
func (a float32) Compare(b float32) int {
	var aNaN bool = a != a
	var bNaN bool = b != b
	if aNaN {
		if bNaN { return 0 }
		return 1
	}
	if bNaN { return -1 }
	var ka uint32 = floatTotalOrderKey32(a)
	var kb uint32 = floatTotalOrderKey32(b)
	if ka < kb { return -1 }
	if ka > kb { return 1 }
	return 0
}

// Compare for float64.  See float32 Compare and the file-header
// note about NaN.
func (a float64) Compare(b float64) int {
	var aNaN bool = a != a
	var bNaN bool = b != b
	if aNaN {
		if bNaN { return 0 }
		return 1
	}
	if bNaN { return -1 }
	var ka uint64 = floatTotalOrderKey64(a)
	var kb uint64 = floatTotalOrderKey64(b)
	if ka < kb { return -1 }
	if ka > kb { return 1 }
	return 0
}

// ============================================================
// Hash
// ============================================================
//
// For numeric primitives, Hash is the bit-pattern reinterpreted
// as uint.  Trivially consistent with Compare-equality on
// integers (a == b ⟺ identical bits ⟺ identical hash).  For
// floats, see file-header note about NaN.

// Hash for int.
func (x int) Hash() uint {
	return cast(uint, x)
}

// Hash for int8.
func (x int8) Hash() uint {
	return cast(uint, cast(int, x))
}

// Hash for int16.
func (x int16) Hash() uint {
	return cast(uint, cast(int, x))
}

// Hash for int32.
func (x int32) Hash() uint {
	return cast(uint, cast(int, x))
}

// Hash for int64.
func (x int64) Hash() uint {
	return cast(uint, cast(int, x))
}

// Hash for uint.
func (x uint) Hash() uint {
	return x
}

// Hash for uint8 (also char / byte).
func (x uint8) Hash() uint {
	return cast(uint, x)
}

// Hash for uint16.
func (x uint16) Hash() uint {
	return cast(uint, x)
}

// Hash for uint32.
func (x uint32) Hash() uint {
	return cast(uint, x)
}

// Hash for uint64.
func (x uint64) Hash() uint {
	return cast(uint, x)
}

// Hash for bool: 1 if true, 0 if false.
func (b bool) Hash() uint {
	if b { return cast(uint, 1) }
	return cast(uint, 0)
}

// Canonical quiet-NaN bit patterns (float32 0x7FC00000, float64
// 0x7FF8000000000000) as the signed integer of matching width.
// Compare folds every NaN into one equivalence class, so Hashable
// consistency requires all NaN to hash identically; the float Hash
// impls map any NaN to the hash of these canonical bits.
const (
	canonicalQNaN32 int = 2143289344
	canonicalQNaN64 int64 = 9221120237041090560
)

// Hash for float32: bit_cast to int32, widen to int, then to uint.
// Any NaN is canonicalized first (see canonicalQNaN32) so all NaN
// hash alike, matching Compare's "all NaN equal".
func (x float32) Hash() uint {
	if x != x {
		return cast(uint, canonicalQNaN32)
	}
	return cast(uint, cast(int, bit_cast(int32, x)))
}

// Hash for float64: bit_cast to int64 (the natural width-
// matching integer for a 64-bit float), then truncate-cast to
// uint.  `int64` (not `int`) because `bit_cast(int, x)` is an
// invalid LLVM cast on 32-bit targets where `int` is i32; the
// explicit int64 preserves the well-defined-bit-pattern semantics
// on every target.  Quality of the hash degrades slightly on
// ILP32 (high 32 bits lost in the cast-to-uint), but the result
// is still a deterministic function of x.  Any NaN is canonicalized
// first (see canonicalQNaN64) so all NaN hash alike.
func (x float64) Hash() uint {
	if x != x {
		return cast(uint, canonicalQNaN64)
	}
	return cast(uint, bit_cast(int64, x))
}

// ============================================================
// Impl declarations
// ============================================================
//
// Each primitive opts into Orderable (total-order contract)
// and Hashable (Hash + consistency with Compare).  Both
// transitively satisfy Comparable per the interface-extension
// machinery (plan-interface-embedding.md), so we don't need
// separate `impl T : Comparable` lines.

impl int : Orderable
impl int : Hashable
impl int8 : Orderable
impl int8 : Hashable
impl int16 : Orderable
impl int16 : Hashable
impl int32 : Orderable
impl int32 : Hashable
impl int64 : Orderable
impl int64 : Hashable
impl uint : Orderable
impl uint : Hashable
impl uint8 : Orderable
impl uint8 : Hashable
impl uint16 : Orderable
impl uint16 : Hashable
impl uint32 : Orderable
impl uint32 : Hashable
impl uint64 : Orderable
impl uint64 : Hashable
impl bool : Orderable
impl bool : Hashable
impl float32 : Orderable
impl float32 : Hashable
impl float64 : Orderable
impl float64 : Hashable
