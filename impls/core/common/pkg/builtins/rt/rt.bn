// Hosted (libc) implementation of pkg/builtins/rt — selected on every target
// except bare metal, which has its own variant (rt_baremetal.bn) over
// pkg/semihost.
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

// Function-value `data`-record kind tags. When the data slot of a
// function value is non-null, it points at a record whose first
// word is one of these constants. Lets every dispatcher
// (BC_CALL_FUNC_VALUE, the cross-mode trampoline, future Phase 2
// closure handling) tell apart what's behind the pointer without
// fragile null-vs-non-null heuristics.
const (
	// VM-side function value: data points at a VMClosureRec
	// `{ kind, vm_func_idx, captured_ctx_or_nil }`.
	DATA_KIND_VM_CLOSURE_REC int = 1

	// Phase 2 placeholder: compiled-side capturing closure. data
	// points at a per-closure captured-fields struct. The constant
	// is reserved now so the dispatch shape doesn't have to be
	// re-touched when Phase 2 lands.
	DATA_KIND_COMPILED_CLOSURE int = 2
)

// RawAlloc allocates size bytes of uninitialized, unmanaged memory.
// Aborts the process if size <= 0 or on out-of-memory. See rt.bni
// for the full precondition contract.
func RawAlloc(size int) *uint8 {
	if size <= 0 {
		abortWithMessage("rt.RawAlloc: size must be > 0\n")
	}
	var p *uint8 = __c_call("malloc", *uint8, size)
	if p == nil {
		abortWithMessage("rt.RawAlloc: out of memory\n")
	}
	return p
}

// RawAllocZero allocates size bytes of zero-initialized, unmanaged
// memory. Aborts the process if size <= 0 or on out-of-memory.
func RawAllocZero(size int) *uint8 {
	if size <= 0 {
		abortWithMessage("rt.RawAllocZero: size must be > 0\n")
	}
	var p *uint8 = __c_call("calloc", *uint8, 1, size)
	if p == nil {
		abortWithMessage("rt.RawAllocZero: out of memory\n")
	}
	return p
}

// RawFree releases a raw (RawAlloc / RawAllocZero) allocation.
// Distinct from Free, which releases managed (refcounted)
// allocations and walks the management header. Calls C `free` (a void
// function) via the "void" __c_call form (no result).
func RawFree(ptr *uint8) {
	if ptr == nil { return }
	__c_call("free", "void", ptr)
}

// MemCopy copies size bytes from src to dst. size == 0 is a no-op
// (no pointer requirements); size < 0 aborts. Byte-at-a-time loop —
// replaceable with a word-copy once perf matters.
func MemCopy(dst *uint8, src *readonly uint8, size int) {
	if size == 0 { return }
	if size < 0 {
		abortWithMessage("rt.MemCopy: size must be >= 0\n")
	}
	for i := 0; i < size; i++ {
		dst[i] = src[i]
	}
}

// MemZero writes size zero bytes starting at ptr. size == 0 is a
// no-op (no pointer requirement); size < 0 aborts. Byte-at-a-time
// loop — replaceable with a word-store loop once perf matters.
func MemZero(ptr *uint8, size int) {
	if size == 0 { return }
	if size < 0 {
		abortWithMessage("rt.MemZero: size must be >= 0\n")
	}
	for i := 0; i < size; i++ {
		ptr[i] = 0
	}
}

// ============================================================
// rt-owned diagnostic output (no bootstrap, no print/println)
// ============================================================
//
// rtWriteRawStderr is this (hosted) target's raw standard-ERROR sink — the
// bare-metal variant uses semihosting.  rt's diagnostics are all fault/abort
// output, so they go to stderr, not stdout (distinct from a program's normal
// output — e.g. pkg/builtins/testing's own stdout writer).  The target-neutral
// formatter, abortWithMessage, and the fault handlers that write through it
// (BoundsFail / DivFail / ShiftFail / AssertFail / Panic) live in rt_diag.bn.

// rtWriteRawStderr writes n bytes at ptr to standard error (fd 2) via write(2).
// A diagnostic on the way to Abort(), so a short write / error is ignored.
func rtWriteRawStderr(ptr *uint8, n int) {
	_ = __c_call("write", int, cast(int32, 2), ptr, cast(uint, n))
}

// Abort terminates the process immediately and abnormally — C abort()
// (SIGABRT, typically a core dump + a debugger break), for unrecoverable runtime
// faults and "this should never happen" conditions.  See rt.bni.
func Abort() {
	__c_call("abort", "void")
}

// Alloc allocates a managed object with the given payload size.
// Returns a pointer to the payload; the header (refcount=1,
// free_fn=&RawFree) is at a negative offset. The payload is zero-
// initialized. The free_fn slot records *which* allocator's free
// function releases this allocation — Free reads it and dispatches
// indirectly. A different pkg/builtins/rt impl that doesn't use libc-backed
// RawAlloc would still set header[1] to *its own* free function;
// Free's body doesn't need to know which.
func Alloc(payloadSize int) *uint8 {
	var hdrSize int = cast(int, sizeof(ManagedHeader))
	var totalSize int = hdrSize + payloadSize
	var base *uint8 = RawAlloc(totalSize)
	var hdr *ManagedHeader = bit_cast(*ManagedHeader, base)
	hdr.Refcount = 1
	hdr.FreeFn = bit_cast(int, _func_handle(RawFree))
	var payload *uint8 = bit_cast(*uint8, bit_cast(int, base) + hdrSize)
	MemZero(payload, payloadSize)
	return payload
}

// headerPtr returns a pointer to the management header for a managed payload.
// The header is sizeof(ManagedHeader) bytes before the payload pointer.
func headerPtr(ptr *uint8) *int {
	var addr int = bit_cast(int, ptr)
	var headerAddr int = addr - cast(int, sizeof(ManagedHeader))
	return bit_cast(*int, headerAddr)
}

// Free releases the memory for a managed payload (including its header).
// ptr must be a managed payload pointer from Alloc, or nil (no-op).
// Dispatches through header[1] (the free_fn slot Alloc populated) so
// the value's origin allocator releases it — important for cross-
// allocator scenarios where the value's origin and current owner may
// not agree on a globally-hardcoded free function.  header[1] == 0 is
// the "default = RawFree" sentinel (used by C-side managed_alloc, see
// runtime/binate_runtime.c), short-circuited here so the C runtime
// doesn't have to encode a function-value handle whose layout differs
// across bnc versions.
func Free(ptr *uint8) {
	if ptr == nil { return }
	var h *int = headerPtr(ptr)
	if h[1] == 0 {
		RawFree(bit_cast(*uint8, h))
		return
	}
	var freeFn *uint8 = bit_cast(*uint8, h[1])
	_call_free_fn(freeFn, bit_cast(*uint8, h))
}

// RefInc increments the reference count. ptr must be a managed payload pointer, or nil (no-op).
func RefInc(ptr *uint8) {
	if ptr == nil { return }
	var h *int = headerPtr(ptr)
	if h[0] < 0 { return } // immortal static-managed data — never counted
	h[0] = h[0] + 1
}

// RefDec decrements the reference count. If it reaches zero, calls dtor (if non-nil)
// to clean up managed fields, then frees the allocation. ptr must be a managed
// payload pointer, or nil (no-op).
func RefDec(ptr *uint8, dtor *uint8) {
	if ptr == nil { return }
	var h *int = headerPtr(ptr)
	if h[0] < 0 { return } // immortal static-managed data — never counted
	if h[0] == 0 {
		BoundsFail(h[0], 0) // abuse bounds_fail to print the bad refcount
	}
	h[0] = h[0] - 1
	if h[0] == 0 {
		if dtor != nil {
			_call_dtor(dtor, ptr)
		}
		Free(ptr)
	}
}

// ZeroRefDestroy is the slow-path helper for the inline RefDec fast
// path. Backends that inline RefDec call this when the decrement leaves
// the refcount at zero — at which point ptr is non-nil (the inline
// fast path filtered nil) and the refcount has already been written
// out as zero by the caller. Runs the optional destructor and frees.
func ZeroRefDestroy(ptr *uint8, dtor *uint8) {
	if dtor != nil {
		_call_dtor(dtor, ptr)
	}
	Free(ptr)
}

// Refcount returns the current reference count of a managed allocation.
// ptr must be a managed payload pointer (i.e., the result of Alloc or
// the raw pointer underlying an @T). Use bit_cast to convert @T to *uint8.
func Refcount(ptr *uint8) int {
	if ptr == nil { return 0 }
	var h *int = headerPtr(ptr)
	return h[0]
}

// BoundsCheck aborts with a bounds-failure diagnostic if index is out of [0, length).
func BoundsCheck(index int, length int) {
	if index < 0 || index >= length {
		BoundsFail(index, length)
	}
}

// DivCheck aborts if an integer divide/remainder would fault. dividend
// and divisor are the sign/zero-extended 64-bit operands; signedMin is
// the operand type's most-negative value (consulted only when isSigned
// is non-zero). Mirrors BoundsCheck — all the compare logic lives here
// so the backends only marshal the four arguments.
func DivCheck(dividend int64, divisor int64, signedMin int64, isSigned int) {
	if divisor == cast(int64, 0) {
		DivFail(0)
	}
	if isSigned != 0 && dividend == signedMin && divisor == cast(int64, -1) {
		DivFail(1)
	}
}

// ShiftCheck aborts with a negative-shift-count diagnostic if count < 0.
// count is the sign-extended 64-bit shift count. Mirrors BoundsCheck /
// DivCheck — the compare logic lives here so the backends only marshal the
// one argument.
func ShiftCheck(count int64) {
	if count < cast(int64, 0) {
		ShiftFail()
	}
}

// Box allocates a managed copy of size bytes from src and returns the payload pointer.
// The new allocation has refcount=1.
func Box(src *uint8, size int) *uint8 {
	var payload *uint8 = Alloc(size)
	MemCopy(payload, src, size)
	return payload
}

// MakeManagedSlice allocates a zero-initialized managed slice with the given
// element count. Returns a ManagedSlice where Data and Refptr point to the
// same allocation (refcount=1). If length is 0, Data and Refptr are nil.
// A negative length is a programmer error (e.g. an integer-overflowed
// capacity); trap rather than silently produce a nil-backed, negative-length
// slice that corrupts on the next write.
func MakeManagedSlice(elemSize int, length int) ManagedSlice {
	if length < 0 {
		abortWithMessage("runtime error: make_slice with negative length\n")
	}
	var ms ManagedSlice
	if length > 0 {
		var ptr *uint8 = Alloc(length * elemSize)
		ms.Data = ptr
		ms.Refptr = ptr
	}
	ms.Len = length
	ms.BackingLen = length
	return ms
}
