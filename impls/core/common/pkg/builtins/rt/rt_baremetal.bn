// Bare-metal ARM32 Raw-allocator backend for pkg/builtins/rt.  Gated to bare-metal
// targets by #[build(...)]; every other target uses the hosted (libc) backend in
// rt.bn.  This file supplies ONLY the per-target Raw layer — RawAlloc / RawAllocZero /
// RawFree, plus Abort and the semihosting stderr sink; the target-agnostic managed /
// refcount layer lives once in rt_managed.bn and the fault handlers in rt_diag.bn.
//
// The allocator is TagCoalesce: size-classed segregated free lists carved from one
// static arena, with SPLITTING and boundary-tag COALESCING.  It is the documented
// drop-in upgrade of the earlier SFL backend (segregated lists, no split/coalesce),
// cut over once a large-variable-buffer workload — the embeddable interpreter, which
// churns many differently-sized large buffers (1 MiB VM stacks + doubling @vec.Vec
// backings) — fragmented SFL's 4 MiB arena to exhaustion.  SFL stranded a freed large
// block: with no split it was handed WHOLE to a smaller large request (then lost to
// that size), and with no coalescing a region broken into pieces never re-formed the
// contiguous span the next large request needed, so the carve frontier marched to the
// wall even though the true peak-live set fit.  TagCoalesce reclaims that: a large
// block is split to serve a smaller request (remainder stays free), and freeing a
// block merges it with its physically-adjacent free neighbours (both directions) so
// full spans re-form regardless of the order fragments are freed.
//
// Layout per block:  [ 8B header ][ payload (`size` bytes) ][ 8B footer ].  Header and
// footer both hold `size | FREE_BIT`; the footer lets a free reach its BACKWARD physical
// neighbour (its footer sits at base-FOOTER), the header free-bit lets it test the
// FORWARD one (at base+PREFIX+size+FOOTER) — so coalescing is order-INDEPENDENT (a
// forward-only scheme reunifies a split region only if fragments free high→low, which a
// refcount-cascade teardown does not guarantee).  Free lists are DOUBLY linked (next+prev
// overlaid in the free payload) so a coalesced neighbour unlinks O(1) instead of an O(n)
// list scan.  Small payloads (<= SMALL_MAX) use per-class LIFO lists; larger use one
// first-fit list; a fresh block carves from the monotonic frontier on a miss.  No locking
// (single-threaded).  ARM32 only (ILP32: int=4, so the 8-byte min free payload holds
// next+prev; a 64-bit baremetal port would need a 16-byte min payload).
//
// CORRECTNESS INVARIANTS (the review checklist):
//   1. Free-list heads / links hold ABSOLUTE addresses, never arena offsets, so 0 is a
//      safe "empty" sentinel (the arena's address is never 0).
//   2. Every block carries a fixed 8-BYTE size prefix (NOT sizeof(int)) AND an 8-byte
//      footer: on arm32 int==4, so a 4-byte prefix would land the payload at base+4 —
//      misaligned — and every managed access would DATA-ABORT.  8-byte tags keep the
//      payload 8-aligned by induction (8-aligned base + 8-multiple `PREFIX+size+FOOTER`
//      extents), and the whole arena stays exactly tiled so a forward walk
//      (base+PREFIX+size+FOOTER) always lands on the next block's base.
//   3. RawAllocZero MUST MemZero — reused blocks are dirty (the old bump code could skip
//      it only because .bss is zero AND never reused).  It zeroes only the `size` payload
//      bytes; the footer (at payload end) is written by writeTags and left intact.
//   4. The FREE_BIT is the allocation state of record: every alloc / carve / split-served
//      path writes it CLEAR, every free / split-remainder path writes it SET, in BOTH
//      header and footer.  A live block that read as free would be swallowed by a
//      neighbour's coalesce (handing out live memory), so the bit must never lag the
//      block's real state.  An IMMEDIATE double-free — freeing a block that is still on a
//      free list, its header bit intact — is now TRAPPED (aborts) rather than silently
//      corrupting a list.  It is best-effort, not total: freeing a pointer whose block has
//      since coalesced into a neighbour (or been re-served) reads a stale bit-clear header
//      and slips through, as with any boundary-tag allocator.  Double-free stays UB per
//      rt.bni; the trap catches the common case, it does not license it.
#[build(is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/semihost"

// ARENA_BYTES is the size of the single static backing region.  4 MiB fits inside the
// linker script's 16 MiB RAM with ample room for .text / .rodata / other .bss / stack.
// With reclamation the arena need only hold the PEAK-LIVE set, so this is generous.
const ARENA_BYTES int = 4194304

// SMALL_MAX is the largest payload served from the segregated small-class lists; a
// request whose rounded payload exceeds it uses the large first-fit list.
const SMALL_MAX int = 1024

// NCLASSES is the number of small size classes — SMALL_MAX / 8 (class ci holds payloads of
// exactly (ci+1)*8 bytes); it sizes smallHeads so the array length, the class count, and the
// SMALL_MAX bound are all driven from SMALL_MAX (no drift between three spellings of one quantity).
const NCLASSES int = SMALL_MAX / 8

// PREFIX / FOOTER are the fixed per-block boundary tags in bytes (invariant #2): an 8-byte
// header at the block base and an 8-byte footer at the payload's end, each holding
// `size | FREE_BIT`.  Both are 8 so block extents stay 8-multiples and the payload stays
// 8-aligned.
const (
	PREFIX int = 8
	FOOTER int = 8
)

// FREE_BIT flags a block free in its size word (header + footer); SIZE_MASK recovers the
// payload size.  Sizes are <= ARENA_BYTES = 0x400000 (bit 22), so bit 30 is free for the
// flag with room to spare and no sign-bit interaction on ILP32.
const (
	FREE_BIT int = 0x40000000
	SIZE_MASK int = 0x3FFFFFFF
)

// MIN_PAYLOAD is the smallest payload a block can carry — 8 bytes, which on arm32 holds a
// free block's two 4-byte list links (next + prev).  MIN_SPLIT_EXTENT is the whole-block
// extent that yields (PREFIX + MIN_PAYLOAD + FOOTER = 24 bytes): a split is taken only if
// the remainder reaches it, so every free block can always hold its own tags + links.
const (
	MIN_PAYLOAD int = 8
	MIN_SPLIT_EXTENT int = 24
)

// arena is the backing region.  Element type uint64 (NOT uint8) so its TYPE alignment
// is 8: the object emitter places each global at its type alignment, so a uint8 arena
// could land at an odd address after an odd-sized .bss global and every allocation
// would then be misaligned (a data abort that hangs bare metal).  A uint64 arena is
// placed 8-aligned.  524288 * 8 == ARENA_BYTES (4 MiB).
var arena [524288]uint64

// frontier is the ABSOLUTE address of the next never-yet-carved byte (the bump front;
// reuse never touches it).  0 means "not yet initialized" — a valid frontier is always
// >= the arena's (nonzero) base, so lazy-init on first use is unambiguous.
var frontier int

// smallHeads[ci] is the head of class ci's doubly-linked free list — the ABSOLUTE address
// of a free block, or 0 for empty (invariant #1).  Zero-initialized in .bss ⇒ all empty.
var smallHeads [NCLASSES]int

// largeHead is the single first-fit doubly-linked free list for blocks with payload >
// SMALL_MAX (ABSOLUTE address; 0 == empty).
var largeHead int

// alignUp rounds n up to the next multiple of alignment (a power of 2).
func alignUp(n int, alignment int) int {
	return (n + alignment - 1) & ~(alignment - 1)
}

// arenaBase returns the arena's absolute base address (8-aligned by the uint64 element
// type).  Cheap — the address of a global — so recomputed rather than cached.
//
// Addresses are held in `int` (pointer-width; ILP32 arm32 int=4) and compared as signed in
// carve's bound check, which assumes the arena sits in the non-negative half of the address
// space (arm32 bare metal places it at 0x40000000, far below 0x7FFFFFFF).
func arenaBase() int {
	return bit_cast(int, &arena[0])
}

// --- boundary tags -------------------------------------------------------------

// writeTags stamps a block's size + free-state into BOTH its header (at base) and its
// footer (at base+PREFIX+size).  The single source that keeps the two tags in sync — every
// state change routes through it.
func writeTags(base int, size int, free bool) {
	var w int = size
	if free { w = size | FREE_BIT }
	var hp *int = bit_cast(*int, base)
	hp[0] = w
	var fp *int = bit_cast(*int, base + PREFIX + size)
	fp[0] = w
}

// sizeAt reads a block's payload size from its header (masking off the free-bit).
func sizeAt(base int) int {
	var p *int = bit_cast(*int, base)
	return p[0] & SIZE_MASK
}

// isFree reports whether the block at base is on a free list (header free-bit set).
func isFree(base int) bool {
	var p *int = bit_cast(*int, base)
	return (p[0] & FREE_BIT) != 0
}

// payloadPtr returns the caller-visible payload pointer for a block base: base + PREFIX
// (8-aligned since base is 8-aligned).
func payloadPtr(base int) *uint8 {
	return bit_cast(*uint8, base + PREFIX)
}

// blockBaseOf recovers a block's base address from its payload pointer (payload - PREFIX).
func blockBaseOf(ptr *uint8) int {
	return bit_cast(int, ptr) - PREFIX
}

// --- doubly-linked free lists --------------------------------------------------
// A FREE block overlays two links in its (dead) payload: next at base+PREFIX, prev at
// base+PREFIX+4.  The 8-byte minimum payload holds both on arm32.

// getNext reads a free block's next-link (the first list word at base+PREFIX).
func getNext(base int) int {
	var p *int = bit_cast(*int, base + PREFIX)
	return p[0]
}

// setNext writes a free block's next-link.
func setNext(base int, v int) {
	var p *int = bit_cast(*int, base + PREFIX)
	p[0] = v
}

// getPrev reads a free block's prev-link (the second list word at base+PREFIX+4).
func getPrev(base int) int {
	var p *int = bit_cast(*int, base + PREFIX)
	return p[1]
}

// setPrev writes a free block's prev-link.
func setPrev(base int, v int) {
	var p *int = bit_cast(*int, base + PREFIX)
	p[1] = v
}

// classHead returns the free-list head for a payload size: the exact small class when
// size <= SMALL_MAX, else the single large list.  Returns -1 for "large" so callers can
// tell which head to write back (Binate has no pointer-to-head to hand out).
func classIndexOf(size int) int {
	if size <= SMALL_MAX { return size / 8 - 1 }
	return -1
}

// insertFree links the (already-tagged FREE) block at base onto its size class's list head.
func insertFree(base int) {
	var ci int = classIndexOf(sizeAt(base))
	var head int = largeHead
	if ci >= 0 { head = smallHeads[ci] }
	setPrev(base, 0)
	setNext(base, head)
	if head != 0 { setPrev(head, base) }
	if ci >= 0 { smallHeads[ci] = base } else { largeHead = base }
}

// unlinkFree removes the block at base from its size class's doubly-linked list (O(1)).
func unlinkFree(base int) {
	var ci int = classIndexOf(sizeAt(base))
	var pv int = getPrev(base)
	var nx int = getNext(base)
	if pv != 0 {
		setNext(pv, nx)
	} else {
		if ci >= 0 { smallHeads[ci] = nx } else { largeHead = nx }
	}
	if nx != 0 { setPrev(nx, pv) }
}

// --- carve / alloc / free ------------------------------------------------------

// carve hands out a fresh ALLOCATED block of `need` payload bytes (need already 8-aligned)
// from the monotonic frontier, stamping its tags.  Aborts on arena exhaustion.
func carve(need int) int {
	var abase int = arenaBase()
	if frontier == 0 { frontier = abase } // lazy init (invariant #1: absolute)
	var base int = frontier
	var newFrontier int = base + PREFIX + need + FOOTER
	if newFrontier > abase + ARENA_BYTES {
		abortWithMessage("rt.RawAlloc: arena exhausted\n")
	}
	frontier = newFrontier
	writeTags(base, need, false)
	return base
}

// firstFitLarge returns the first large-list block whose payload is >= need, or 0.
func firstFitLarge(need int) int {
	var b int = largeHead
	for b != 0 {
		if sizeAt(b) >= need { return b }
		b = getNext(b)
	}
	return 0
}

// splitServed carves `need` payload out of the front of a just-unlinked free block `b`
// (payload `have`), returning `b` ALLOCATED at `need`; if the tail can form a whole block
// (>= MIN_SPLIT_EXTENT of slack) it becomes a FREE remainder placed on its class list,
// otherwise the whole block is served (internal slack).  8-alignment holds: have, need and
// PREFIX+FOOTER are all 8-multiples, so the remainder base and size are too.
func splitServed(b int, have int, need int) {
	if have >= need + MIN_SPLIT_EXTENT {
		writeTags(b, need, false)
		var remBase int = b + PREFIX + need + FOOTER
		var remSize int = have - need - PREFIX - FOOTER
		writeTags(remBase, remSize, true)
		insertFree(remBase)
	} else {
		writeTags(b, have, false)
	}
}

// RawAlloc allocates size bytes of uninitialized memory from the arena.  Aborts if
// size <= 0 or the arena is exhausted.  A small request pops its exact class (O(1)); on a
// miss it splits a larger free block (first-fit large list) or carves fresh.
func RawAlloc(size int) *uint8 {
	if size <= 0 {
		abortWithMessage("rt.RawAlloc: size must be > 0\n")
	}
	// Every non-aborting path below returns a block; RawAllocZero rides RawAlloc,
	// so counting here (not there) counts each block exactly once.
	liveBlocks = liveBlocks + 1
	var need int = alignUp(size, 8)
	if need <= SMALL_MAX {
		var ci int = need / 8 - 1
		var b int = smallHeads[ci]
		if b != 0 {
			unlinkFree(b)
			writeTags(b, need, false) // exact class ⇒ size already == need; clear free-bit
			return payloadPtr(b)
		}
	}
	// Split a larger free block (first-fit large list), else carve.  A small request whose
	// exact class was empty reuses coalesced large space here — the only way freed spans
	// re-serve small requests, so the arena doesn't march on the small side.
	var lb int = firstFitLarge(need)
	if lb != 0 {
		var have int = sizeAt(lb)
		unlinkFree(lb)
		splitServed(lb, have, need)
		return payloadPtr(lb)
	}
	return payloadPtr(carve(need))
}

// RawAllocZero allocates size bytes of zero-initialized memory.  Reused blocks are
// dirty, so it MUST explicitly zero the caller-requested bytes (invariant #3).
func RawAllocZero(size int) *uint8 {
	var p *uint8 = RawAlloc(size)
	MemZero(p, size)
	return p
}

// RawFree returns a block to the free lists, coalescing with its physically-adjacent free
// neighbours (both directions) so fragmented spans re-form.  nil is a no-op; an immediate
// double-free (block still free-listed) is TRAPPED (invariant #4; still UB per rt.bni).
func RawFree(ptr *uint8) {
	if ptr == nil { return }
	var base int = blockBaseOf(ptr)
	if isFree(base) {
		abortWithMessage("rt.RawFree: double free\n")
	}
	liveBlocks = liveBlocks - 1
	var size int = sizeAt(base)
	var abase int = arenaBase()

	// Coalesce forward: absorb the next physical block if it exists (below the frontier)
	// and is free.  The swallowed footer + prefix become payload.
	var nextBase int = base + PREFIX + size + FOOTER
	if nextBase < frontier {
		if isFree(nextBase) {
			var nsize int = sizeAt(nextBase)
			unlinkFree(nextBase)
			size = size + FOOTER + PREFIX + nsize
		}
	}

	// Coalesce backward: if a block precedes this one (base above the arena floor) and is
	// free, fold this block into it — read the predecessor's size from its footer at base-FOOTER.
	if base > abase {
		var prevFooter *int = bit_cast(*int, base - FOOTER)
		if (prevFooter[0] & FREE_BIT) != 0 {
			var prevSize int = prevFooter[0] & SIZE_MASK
			var prevBase int = base - FOOTER - prevSize - PREFIX
			unlinkFree(prevBase)
			size = prevSize + PREFIX + FOOTER + size
			base = prevBase
		}
	}

	writeTags(base, size, true)
	insertFree(base)
}

// rtWriteRawStderr is the bare-metal target's raw fault-diagnostic sink: n bytes at ptr
// to the semihosting debug console, one byte at a time via SemihostWriteChar (SYS_WRITEC).
// Semihosting has a single console (no stdout/stderr split), so the name simply matches
// the hosted variant.  The target-neutral formatter, abortWithMessage, and the fault
// handlers that write through it (BoundsFail / DivFail / ShiftFail / AssertFail / Panic)
// live in rt_diag.bn.
func rtWriteRawStderr(ptr *uint8, n int) {
	for i := 0; i < n; i++ {
		semihost.SemihostWriteChar(cast(char, ptr[i]))
	}
}

// Abort terminates abnormally for an unrecoverable runtime fault / "this should never
// happen" condition.  Bare-metal has no libc abort()/SIGABRT, so it exits with a nonzero
// status via semihosting (the closest available "crash").
func Abort() {
	semihost.SemihostExit(1)
	for {}
}
