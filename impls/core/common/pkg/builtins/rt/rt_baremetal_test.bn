// Bare-metal allocator (rt_baremetal.bn TagCoalesce) stress tests.  Gated to the
// bare-metal target: only there does RawAlloc/RawFree use the split + boundary-tag
// coalescing backend with the fixed 4 MiB arena; the hosted build rides libc, where
// these would be trivial.  rt_test.bn covers the hosted (libc) Raw contract; this file
// covers the property that made coalescing necessary — surviving a fragmenting workload
// in a fixed arena.
#[build(is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

// allocRound allocates a mix of differently-sized managed blocks and lets them all drop
// (RefDec) at scope end.  Varying the sizes per round `k` is what stresses a
// no-split / no-coalesce allocator: a freed block of one size is consumed WHOLE by a
// wrong-sized request (or stranded when no request matches), so freed regions never
// re-form the contiguous span a later round needs — the exact fragmentation that
// exhausted the arena before boundary-tag coalescing.  With TagCoalesce each round's
// frees coalesce back into reusable spans that the next round splits.
func allocRound(k int) {
	var big @[]uint8 = make_slice(uint8, 120000 + k * 2048) // ~120 KB, grows per round
	var mid @[]uint8 = make_slice(uint8, 9000 + k * 128) // varied large
	var s0 @[]uint8 = make_slice(uint8, 40) // small (exact-class churn)
	var s1 @[]uint8 = make_slice(uint8, 800 + k * 8) // varied small
	// Touch each so the allocations can't be optimized away.
	big[0] = cast(uint8, k)
	mid[0] = cast(uint8, k)
	s0[0] = 1
	s1[0] = 1
}

// A long run of varied-size alloc/free rounds must neither leak nor exhaust the arena.
// Cumulative allocation here is ~8 MiB — FAR more than the 4 MiB arena — so it only
// survives if freed blocks are reclaimed AND coalesced back into spans the growing
// later rounds can reuse (a no-coalesce backend marches the carve frontier to the wall
// and aborts with "rt.RawAlloc: arena exhausted").  Peak-live is ~one round (~230 KB),
// so with coalescing it fits with vast headroom.  LiveBlocks must return to baseline —
// no leak, and the split/coalesce accounting stayed balanced.
func TestAllocFragmentationSurvives() testing.TestResult {
	var base int = LiveBlocks()
	for k := 0; k < 48; k++ {
		allocRound(k)
	}
	if LiveBlocks() != base {
		return "varied-size alloc/free rounds leaked (LiveBlocks off baseline)"
	}
	return ""
}

// The split path must serve a small request out of a large free block and return the
// remainder for reuse, and coalescing must put a freed block's space back in play.  This
// interleaves a persistent large allocation with churning small ones so small requests
// are repeatedly served by splitting (or from coalesced remainders) rather than by ever
// growing the frontier; over many iterations that only stays bounded if split remainders
// and freed small blocks are actually reclaimed.
func TestSplitAndReuseBounded() testing.TestResult {
	var base int = LiveBlocks()
	var i int = 0
	for i < 2000 {
		var chunk @[]uint8 = make_slice(uint8, 24 + (i - (i / 32) * 32) * 8) // small, cycles 24..272
		chunk[0] = 1
		i = i + 1
	}
	if LiveBlocks() != base {
		return "small-request split/reuse churn leaked"
	}
	return ""
}
