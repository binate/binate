// Target-agnostic runtime diagnostics: an alloc-free integer formatter, the
// standard-output sink helpers, and the fault handlers the compiler emits calls
// to on a runtime fault (BoundsFail / DivFail / ShiftFail / AssertFail) plus
// Panic.  Each formats its message and writes it through the per-target
// `rtWriteRawStderr` sink, then terminates via the per-target `Abort` — both defined in
// the hosted (rt.bn) and bare-metal (rt_baremetal.bn) variants, exactly one of
// which is in any given build.
//
// rt is below the stdlib, so it can't use pkg/stdx/fmt (which allocates and
// depends on rt), and the print/println builtins (→ bootstrap.Write /
// bootstrap.format*) are being retired — so rt owns its diagnostic formatting
// here rather than leaning on either.  This file is target-neutral (not
// #[build]-gated); only the sink + Abort it calls differ per target, which is
// why the handlers no longer need to be duplicated across the two variants.
package "pkg/builtins/rt"

// rtWriteStr writes a char-slice "string" to standard error via the per-target
// rtWriteRawStderr sink.  Empty is a no-op.
func rtWriteStr(s *[]readonly char) {
	if len(s) == 0 {
		return
	}
	rtWriteRawStderr(bit_cast(*uint8, bit_cast(*int, &s)[0]), len(s))
}

// rtFormatInt writes v's decimal text into buf (which must hold at least 20
// bytes: up to 19 int64 digits + a sign) and returns the byte count.  Alloc-free
// reverse-digit fill; the int-min magnitude is taken via uint64 so `0 - v`
// doesn't overflow at the int-min boundary.
func rtFormatInt(v int, buf *uint8) int {
	if v == 0 {
		buf[0] = cast(uint8, '0')
		return 1
	}
	var negative bool = false
	var mag uint64 = 0
	if v < 0 {
		negative = true
		mag = cast(uint64, 0) - cast(uint64, v)
	} else {
		mag = cast(uint64, v)
	}
	var digits [20]uint8
	var count int = 0
	for mag > cast(uint64, 0) {
		digits[count] = cast(uint8, cast(int, mag % cast(uint64, 10)) + cast(int, '0'))
		mag = mag / cast(uint64, 10)
		count = count + 1
	}
	var pos int = 0
	if negative {
		buf[pos] = cast(uint8, '-')
		pos = pos + 1
	}
	for i := count - 1; i >= 0; i-- {
		buf[pos] = digits[i]
		pos = pos + 1
	}
	return pos
}

// rtWriteInt formats v and writes its decimal text to standard error.
func rtWriteInt(v int) {
	var arr [24]uint8
	var n int = rtFormatInt(v, &arr[0])
	rtWriteRawStderr(&arr[0], n)
}

// abortWithMessage writes each operand — a char-slice string or an int, the only
// types the fault handlers pass — to standard error in order, then Aborts.
// Operands are written verbatim (no separators), so a caller composes the exact
// diagnostic text.  The fault handlers use it to emit their diagnostic through
// rt's own bootstrap-free sink, then terminate via Abort (an abnormal-termination
// fault is not a graceful `exit`).
func abortWithMessage(args ...*any) {
	for i := 0; i < len(args); i++ {
		switch v := args[i].(type) {
		case *[]readonly char:
			rtWriteStr(v)
		case int:
			rtWriteInt(v)
		}
	}
	Abort()
}

// BoundsFail reports an out-of-bounds slice/array index against its length and
// aborts.  Emitted by the compiler's bounds check.
func BoundsFail(index int, length int) {
	abortWithMessage("runtime error: index out of bounds: ", index, " (len ", length, ")\n")
}

// DivFail reports an integer divide fault and aborts.  kind 0 = divide by zero,
// 1 = signed MIN / -1 overflow.
func DivFail(kind int) {
	if kind == 0 {
		abortWithMessage("runtime error: integer divide by zero\n")
	} else {
		abortWithMessage("runtime error: integer overflow (MIN / -1)\n")
	}
}

// ShiftFail reports a negative shift count and aborts.
func ShiftFail() {
	abortWithMessage("runtime error: negative shift count\n")
}

// AssertFail reports a failed type assertion — the expression-form `x.(K T)`
// panic (spec §17.5), verbatim `runtime error: type assertion failed: <dyn> is
// not <target>` — and aborts.  `dyn` is the value's runtime dynamic-type name
// (read from its TypeInfo record, or the literal "<unset>" for a typed-nil /
// null-vtable value); `target` is the asserted type's name.
func AssertFail(dyn *[]readonly char, target *[]readonly char) {
	abortWithMessage("runtime error: type assertion failed: ", dyn, " is not ", target, "\n")
}

// Panic writes "panic: <msg>" to standard error then Aborts — the canonical
// terminate for an internal invariant violation.  The builtin panic(msg) lowers
// to a call to this plus an unreachable.
func Panic(msg *[]readonly char) {
	abortWithMessage("panic: ", msg, "\n")
}
