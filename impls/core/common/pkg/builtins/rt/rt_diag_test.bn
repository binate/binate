// Tests for rt's target-neutral diagnostics (rt_diag.bn).
//
// Only rtFormatInt is unit-testable in isolation: it writes into a caller
// buffer and returns.  rtWriteStr / rtWriteInt write to standard output, and
// abortWithMessage + the fault handlers (BoundsFail / DivFail / …) terminate the
// process via Abort — those are exercised end-to-end by the conformance fault
// tests, which check the emitted `runtime error: …` text.
//
// Gated to the hosted variant, matching rt_test.bn (the bare-metal target runs
// no host unit tests).  int-min is deliberately not tested here: its literal
// exceeds int32 and so isn't portable to the arm32 (ILP32) build of this file.
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

// checkFormatInt formats v via rtFormatInt and compares the bytes written
// against `expected`.
func checkFormatInt(v int, expected *[]readonly char) testing.TestResult {
	var buf [24]uint8
	var n int = rtFormatInt(v, &buf[0])
	if n != len(expected) {
		return "rtFormatInt wrote the wrong number of bytes"
	}
	for i := 0; i < n; i++ {
		if buf[i] != cast(uint8, expected[i]) {
			return "rtFormatInt wrote a wrong byte"
		}
	}
	return ""
}

func TestRtFormatIntZero() testing.TestResult {
	return checkFormatInt(0, "0")
}

func TestRtFormatIntSingleDigit() testing.TestResult {
	return checkFormatInt(7, "7")
}

func TestRtFormatIntMultiDigit() testing.TestResult {
	return checkFormatInt(12345, "12345")
}

func TestRtFormatIntNegative() testing.TestResult {
	return checkFormatInt(-42, "-42")
}

func TestRtFormatIntNegativeMultiDigit() testing.TestResult {
	return checkFormatInt(-1000000, "-1000000")
}

func TestRtFormatIntLarge() testing.TestResult {
	return checkFormatInt(2000000000, "2000000000")
}

func TestRtFormatIntTrailingZeros() testing.TestResult {
	return checkFormatInt(100, "100")
}
