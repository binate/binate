package "pkg/builtins/rt"

// MemMove copies size bytes from src to dst as if through a temporary buffer, so the
// two regions may overlap.  size == 0 is a no-op (no pointer requirements); size < 0
// aborts.  When dst starts below src, or at or past its end, copying front to back
// (copyForward) reads every byte before anything is written over it; otherwise — dst
// inside [src, src + size) — it copies back to front (copyBackward).
func MemMove(dst *uint8, src *readonly uint8, size int) {
	if size == 0 { return }
	if size < 0 {
		abortWithMessage("rt.MemMove: size must be >= 0\n")
	}
	var d int = bit_cast(int, dst) - bit_cast(int, src)
	if cast(uint, d) >= cast(uint, size) {
		copyForward(dst, src, size)
		return
	}
	copyBackward(dst, src, size)
}

// copyBackward copies size bytes (more than zero) from src to dst back to front: every
// byte is read before any byte below it is written, so the copy is right when dst
// starts inside [src, src + size).  Like copyForward it moves a machine word at a time
// through the aligned middle (four per iteration) when dst and src share an alignment,
// a byte at a time otherwise and for the unaligned ends.
func copyBackward(dst *uint8, src *readonly uint8, size int) {
	var wb int = cast(int, sizeof(int))
	var da int = bit_cast(int, dst)
	var sa int = bit_cast(int, src)
	var i int = size
	if (da & (wb - 1)) == (sa & (wb - 1)) {
		for i > 0 && ((da + i) & (wb - 1)) != 0 {
			i = i - 1
			dst[i] = src[i]
		}
		// Each group of four words is moved highest first.
		for i >= 4 * wb {
			i = i - 4 * wb
			var dwp *int = bit_cast(*int, da + i)
			var swp *int = bit_cast(*int, sa + i)
			dwp[3] = swp[3]
			dwp[2] = swp[2]
			dwp[1] = swp[1]
			dwp[0] = swp[0]
		}
		for i >= wb {
			i = i - wb
			var dwp *int = bit_cast(*int, da + i)
			var swp *int = bit_cast(*int, sa + i)
			dwp[0] = swp[0]
		}
	}
	for i > 0 {
		i = i - 1
		dst[i] = src[i]
	}
}
