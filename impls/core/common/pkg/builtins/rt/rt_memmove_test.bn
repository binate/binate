package "pkg/builtins/rt"

import "pkg/builtins/testing"

// Tests for rt_memmove.bn: MemMove.

// MemMove with its destination at every shift from 12 bytes below its source to 12
// above (so overlapping either way, or not at all, at the same alignment or not), from
// every sub-word start alignment, for sizes 0..80 (several word groups either way, on
// 32- and 64-bit targets): afterwards the destination holds the
// source's bytes as they were before the copy, and nothing outside it has changed.
func TestMemMoveOverlaps() testing.TestResult {
	var cap int = 136
	var buf *uint8 = RawAlloc(cap)
	var want *uint8 = RawAlloc(cap)
	for off := 0; off < 9; off++ {
		for shift := -12; shift <= 12; shift++ {
			for sz := 0; sz <= 80; sz++ {
				var s int = 24 + off
				var d int = s + shift
				for k := 0; k < cap; k++ {
					buf[k] = cast(uint8, k + 1)
					want[k] = cast(uint8, k + 1)
				}
				for k := 0; k < sz; k++ { want[d + k] = cast(uint8, s + k + 1) }
				MemMove(offsetPtr(buf, d), offsetPtr(buf, s), sz)
				for k := 0; k < cap; k++ {
					if buf[k] != want[k] {
						RawFree(buf)
						RawFree(want)
						return fail("MemMove: wrong byte (overlap, region or overrun)")
					}
				}
			}
		}
	}
	RawFree(buf)
	RawFree(want)
	return ""
}

// MemMove of size 0 is a no-op even with nil pointers.
func TestMemMoveSizeZero() testing.TestResult {
	MemMove(nil, nil, 0)
	return ""
}
