// Tests for rt.MemZero — whichever body the target links: the portable
// word-at-a-time Binate one (rt_memzero.bn) or aarch64's hand-asm STP / DC ZVA
// fill (memzero_aarch64.s).  Hosted-only, like rt_test.bn.
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

func TestMemZero() testing.TestResult {
	var p *uint8 = RawAlloc(16)
	// Pre-fill so we can detect that MemZero actually wrote zeros.
	for i := 0; i < 16; i++ { p[i] = cast(uint8, 0xAB) }
	MemZero(p, 16)
	for i := 0; i < 16; i++ {
		if cast(int, p[i]) != 0 {
			return fail("MemZero did not write zero")
		}
	}
	RawFree(p)
	return ""
}

func TestMemZeroSizeZero() testing.TestResult {
	// size == 0 is a no-op even with nil ptr.
	MemZero(nil, 0)
	return ""
}

// MemZero across every start alignment and size (sub-word / exact-word /
// word-plus-tail), verifying the target region is zeroed AND that no byte
// outside it is touched (0xAB sentinel).  Covers the aligned lead-in, the bulk
// word stores, and the byte tail.
func TestMemZeroAlignmentsAndSizes() testing.TestResult {
	var cap int = 160
	var buf *uint8 = RawAlloc(cap)
	for off := 0; off < 9; off++ {
		for sz := 0; sz < 96; sz++ {
			for k := 0; k < cap; k++ { buf[k] = cast(uint8, 0xAB) }
			MemZero(offsetPtr(buf, off), sz)
			for k := 0; k < cap; k++ {
				var want int = 0xAB
				if k >= off && k < off + sz { want = 0 }
				if cast(int, buf[k]) != want {
					RawFree(buf)
					return fail("MemZero: wrong byte (region or overrun)")
				}
			}
		}
	}
	RawFree(buf)
	return ""
}

// MemZero over sizes 240 through 400 at every start offset within a 64-byte
// line.  On aarch64 this crosses the hand-asm fill's DC ZVA threshold (256):
// the byte lead-in to 16-byte alignment, the 16-byte steps up to 64-byte
// alignment, three to six DC ZVA blocks, and every 0..63-byte STP / byte tail
// after them — and, just below the threshold, the 64-byte STP bulk.  The region
// starts at a 64-byte-aligned point at least 64 bytes into the buffer (RawAlloc
// only guarantees word alignment), so 64 sentinel bytes before and after it
// catch an underrun or an overrun by a whole block.
func TestMemZeroWideSizesAndAlignments() testing.TestResult {
	var minSz int = 240
	var maxSz int = 400
	var cap int = 64 + 64 + 64 + maxSz + 64
	var buf *uint8 = RawAlloc(cap)
	var lead int = ((bit_cast(int, buf) + 127) & -64) - bit_cast(int, buf)
	for off := 0; off < 64; off++ {
		var start int = lead + off
		for sz := minSz; sz <= maxSz; sz++ {
			for k := start - 64; k < start + sz + 64; k++ { buf[k] = cast(uint8, 0xAB) }
			MemZero(offsetPtr(buf, start), sz)
			for k := start - 64; k < start + sz + 64; k++ {
				var want int = 0xAB
				if k >= start && k < start + sz { want = 0 }
				if cast(int, buf[k]) != want {
					RawFree(buf)
					return fail("MemZero wide: wrong byte (region, overrun, or underrun)")
				}
			}
		}
	}
	RawFree(buf)
	return ""
}
