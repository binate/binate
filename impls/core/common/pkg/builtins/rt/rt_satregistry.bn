// Interface-satisfaction registry — the native reader half of RTTI type
// assertions (spec §11.12 `iface.assert`, plan-type-assertions-execution §U.6).
// Built once at process start by walking the per-package `_pkg_satfrag` graph
// from the main module's node (BuildSatRegistry, called as `__entry`'s first
// statement), then queried by `x.(*J)` interface-target assertions via SatLookup.
// The graph is the decentralized replacement for the old whole-program
// `_satentry_root`: each package's node lists its own satentries + symrefs to its
// direct dependencies' nodes, so the walk reaches every linked package's
// satentries without any TU knowing the whole-program set.
//
// This is deliberately reflect-free: it walks the raw record words directly —
// only the first three payload words of a reflect.SatEntryInfo (`Type`, `Iface`,
// `Vtable`, all `*uint8`); the trailing cross-mode name slices (TypeSym/IfaceSym,
// read only by the bytecode-VM importer) are ignored — so Tier-0 rt takes no
// `reflect` dependency.  It is an open-addressing hash keyed by the pair (dynamic
// `*TypeInfo`, `*IfaceId`) → sub-vtable; a MISS returns nil.  Unconditional (both
// the hosted and bare-metal rt variants build it) — it relies only on
// RawAllocZero + bit_cast, which both variants provide.
//
// Word note: PointerSize == IntSize on every target, so a single `*int` view
// strides one machine word and reads both pointer and int fields.

package "pkg/builtins/rt"

// The process-wide registry: `g_satTable` addresses `g_satCap` open-addressing
// slots (each 3 words {type, iface, vtable}; an empty slot has type == 0, since a
// real `&TypeInfo` is never null), and `g_satMask` = g_satCap - 1 (g_satCap is a
// power of two).  A nil `g_satTable` ⇒ empty registry (no satentries, or
// BuildSatRegistry never ran) ⇒ every lookup MISSes.
//
// NO initializers: these must be static-zero (bss).  An explicit `= nil` / `= 0`
// generates a runtime store in rt's package `__init`, which `__init_all` runs —
// and BuildSatRegistry (the M3 fill) runs BEFORE `__init_all`, so an initializer
// would re-zero the just-built table out from under every later lookup.
var (
	g_satTable *uint8
	g_satCap int
	g_satMask int
	// g_satFallback is an OPTIONAL secondary resolver a host installs (rt itself
	// never sets it): consulted on a native-registry MISS so a caller whose
	// satentries live OUTSIDE this process's linked `_pkg_satfrag` graph can still
	// resolve `x.(*J)`.  The bytecode-VM host (pkg/binate/vm) installs one — an
	// injected-native callee (e.g. testing.Println) asserting an interface on a
	// value a BYTECODE program boxed, whose (T,J) fact lives only in the VM's own
	// satentry registry (a user type, never linked into g_satTable), routes through
	// this to the VM's lookupSatEntry.  Static-zero (bss, no initializer — same as
	// the table words above); `present()` gates it (a func value is not `==`-able).
	g_satFallback *func(*uint8, *uint8) *uint8
)

// SetSatFallback installs the optional secondary resolver SatLookup consults on a
// MISS (see g_satFallback).  A host sets it once at setup; passing an unset (bss)
// value is not possible (the setter is only called with a real resolver).
func SetSatFallback(fp *func(*uint8, *uint8) *uint8) {
	g_satFallback = fp
}

// satFallback routes a native-registry MISS to the installed g_satFallback (if
// any), else returns nil (a true MISS).  The fallback returns a sub-vtable already
// shaped for native use (the VM host translates a bytecode impl's VM-index vtable
// to a native handle-vtable before returning).
func satFallback(ti *uint8, id *uint8) *uint8 {
	if present(g_satFallback) {
		return g_satFallback(ti, id)
	}
	return nil
}

// satHash mixes the two key pointers into a slot index base.  Pointers are
// machine-word aligned, so the low bits carry no entropy — the multiply spreads
// them.  Overflow wraps (2's complement), which is fine for a hash.
func satHash(ti int, id int) int {
	var h int = ti * 1000003 + id
	if h < 0 {
		h = 0 - h
	}
	return h
}

// satInsert places one (ti, id) → vt entry into the table by linear probing.
// A repeated (ti, id) — possible when weak coalescing leaves the same (T,J)
// satentry in more than one gathered package — overwrites with the same vtable,
// a harmless no-op.
func satInsert(tw *int, ti int, id int, vt int) {
	var slot int = satHash(ti, id) & g_satMask
	for {
		var base int = slot * 3
		if tw[base] == 0 {
			tw[base] = ti
			tw[base + 1] = id
			tw[base + 2] = vt
			return
		}
		if tw[base] == ti && tw[base + 1] == id {
			tw[base + 2] = vt
			return
		}
		slot = (slot + 1) & g_satMask
	}
}

// insertPkgEntries inserts one package's satentries — its `_pkg_satentries`
// backing array of `count` @SatEntryInfo pointers at `pkgSatAddr` — into the
// table.  A SatEntryInfo (reflect.bni) payload begins {Type, Iface, Vtable} (past
// the node's 2-word managed header); the registry uses only those three words and
// ignores the trailing cross-mode name slices.
func insertPkgEntries(tw *int, pkgSatAddr int, count int) {
	if pkgSatAddr == 0 {
		return
	}
	var pkgW *int = bit_cast(*int, pkgSatAddr)
	for j := 0; j < count; j++ {
		var seAddr int = pkgW[j]
		if seAddr == 0 {
			continue
		}
		var seW *int = bit_cast(*int, seAddr)
		satInsert(tw, seW[0], seW[1], seW[2])
	}
}

// fragInList reports whether frag address `addr` is among list[0..count).  The
// graph walk's visited-set is a plain linear-scan list — the package count is
// small, so O(V²) membership is cheap, and it needs no hash primitive.
func fragInList(list *int, count int, addr int) bool {
	for i := 0; i < count; i++ {
		if list[i] == addr {
			return true
		}
	}
	return false
}

// A `_pkg_satfrag` node is { entriesPtr (&_pkg_satentries or null), ownCount,
// depCount, dep-node symrefs... } — all machine words.  These index its fields.
const (
	FRAG_ENTRIES int = 0
	FRAG_OWNCOUNT int = 1
	FRAG_DEPCOUNT int = 2
	FRAG_DEPS int = 3
)

// BuildSatRegistry builds the satisfaction hash by walking the `_pkg_satfrag`
// graph from the main module's node (`root`).  It BFS-collects every reachable
// node — `visited` doubles as the queue: a node is appended once (deduped by
// address, so the rt/lang import cycle and diamond imports terminate) and
// processed in order — sums the entry count for sizing, then fills the table.
// Idempotent-safe for the "no satentries" case (root == nil or zero total
// entries): it leaves the table nil so every SatLookup MISSes.  Called once, as
// the first statement of `__entry`, before `__init_all` (assertions can run in
// top-level variable initializers).
func BuildSatRegistry(root *uint8) {
	if root == nil {
		return
	}
	var wordSize int = cast(int, sizeof(int))

	// BFS the graph, collecting all reachable nodes into `visited` (which is also
	// the queue).  One-time startup allocation; a doubling grow leaks its old
	// buffer (process-lifetime, bounded by 2× the node count) — rt has no realloc.
	var visitedCap int = 16
	var visited *int = bit_cast(*int, RawAllocZero(visitedCap * wordSize))
	visited[0] = bit_cast(int, root)
	var count int = 1
	var total int = 0
	var i int = 0
	for i < count {
		var fragW *int = bit_cast(*int, visited[i])
		total = total + fragW[FRAG_OWNCOUNT]
		var depCount int = fragW[FRAG_DEPCOUNT]
		for d := 0; d < depCount; d++ {
			var depAddr int = fragW[FRAG_DEPS + d]
			if depAddr == 0 {
				continue
			}
			if fragInList(visited, count, depAddr) {
				continue
			}
			if count == visitedCap {
				var newCap int = visitedCap * 2
				var grown *int = bit_cast(*int, RawAllocZero(newCap * wordSize))
				for k := 0; k < count; k++ {
					grown[k] = visited[k]
				}
				visited = grown
				visitedCap = newCap
			}
			visited[count] = depAddr
			count = count + 1
		}
		i = i + 1
	}
	if total <= 0 {
		return
	}

	// Load factor ~0.5: smallest power of two strictly greater than 2*total.
	var tcap int = 1
	for tcap < total * 2 {
		tcap = tcap * 2
	}
	g_satTable = RawAllocZero(tcap * 3 * wordSize)
	g_satCap = tcap
	g_satMask = tcap - 1

	var tw *int = bit_cast(*int, g_satTable)
	for k := 0; k < count; k++ {
		var fragW *int = bit_cast(*int, visited[k])
		insertPkgEntries(tw, fragW[FRAG_ENTRIES], fragW[FRAG_OWNCOUNT])
	}
}

// SatLookup returns the sub-vtable for (dynamic `*TypeInfo` ti, `*IfaceId` id)
// if the program registered a `(T, J)` satentry, else nil (a MISS).  This is
// the native reader an `x.(*J)` interface assertion consults with the
// scrutinee's dynamic type (vtable slot 1) and the static `&__ifaceid.<J>`.
func SatLookup(ti *uint8, id *uint8) *uint8 {
	if g_satTable == nil {
		return satFallback(ti, id)
	}
	var tii int = bit_cast(int, ti)
	var idi int = bit_cast(int, id)
	var tw *int = bit_cast(*int, g_satTable)
	var slot int = satHash(tii, idi) & g_satMask
	for {
		var base int = slot * 3
		var kt int = tw[base]
		if kt == 0 {
			return satFallback(ti, id)
		}
		if kt == tii && tw[base + 1] == idi {
			return bit_cast(*uint8, tw[base + 2])
		}
		slot = (slot + 1) & g_satMask
	}
}
