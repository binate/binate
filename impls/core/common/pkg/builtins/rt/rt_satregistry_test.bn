// Tests for the interface-satisfaction registry (rt_satregistry.bn).
//
// Gated to the hosted variant (like rt_test.bn): they exercise bit_cast +
// raw-pointer walks, which currently require compiled mode.  The `fail` helper
// is shared from rt_test.bn (same package).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

// satEntryInfo builds one synthetic {Type, Iface, Vtable} record (the
// SatEntryInfo payload the registry walks) with the given opaque key values.
func satEntryInfo(ti int, id int, vt int) *uint8 {
	var w int = cast(int, sizeof(int))
	var se *uint8 = RawAlloc(3 * w)
	var sw *int = bit_cast(*int, se)
	sw[0] = ti
	sw[1] = id
	sw[2] = vt
	return se
}

// TestSatRegistry exercises the interface-satisfaction itab hash end to end:
// an empty registry MISSes; after BuildSatRegistry over a synthetic
// `_satentry_root` (one package, three entries), the registered (type, iface)
// pairs HIT with their sub-vtable and an unregistered pair MISSes.  The keys
// are opaque non-null ints (never dereferenced), so no real records are needed.
func TestSatRegistry() testing.TestResult {
	var w int = cast(int, sizeof(int))

	// Empty registry (BuildSatRegistry not yet run): every lookup MISSes.
	if SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 8192)) != nil {
		return fail("empty registry must MISS")
	}

	// Three entries; two share a type, distinct ifaces.
	var se0 *uint8 = satEntryInfo(4096, 8192, 43690)
	var se1 *uint8 = satEntryInfo(4096, 12288, 48059)
	var se2 *uint8 = satEntryInfo(16384, 8192, 52719)
	var pkg *uint8 = RawAlloc(3 * w)
	var pkgw *int = bit_cast(*int, pkg)
	pkgw[0] = bit_cast(int, se0)
	pkgw[1] = bit_cast(int, se1)
	pkgw[2] = bit_cast(int, se2)
	var pairs *uint8 = RawAlloc(2 * w)
	var pairsw *int = bit_cast(*int, pairs)
	pairsw[0] = bit_cast(int, pkg)
	pairsw[1] = 3
	var root *uint8 = RawAlloc(2 * w)
	var rootw *int = bit_cast(*int, root)
	rootw[0] = bit_cast(int, pairs)
	rootw[1] = 1

	BuildSatRegistry(root)

	if bit_cast(int, SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 8192))) != 43690 {
		return fail("(4096,8192) should HIT 43690")
	}
	if bit_cast(int, SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 12288))) != 48059 {
		return fail("(4096,12288) should HIT 48059")
	}
	if bit_cast(int, SatLookup(bit_cast(*uint8, 16384), bit_cast(*uint8, 8192))) != 52719 {
		return fail("(16384,8192) should HIT 52719")
	}
	// Unregistered (type,iface) pairs MISS.
	if SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 99999)) != nil {
		return fail("(4096,99999) should MISS")
	}
	if SatLookup(bit_cast(*uint8, 16384), bit_cast(*uint8, 12288)) != nil {
		return fail("(16384,12288) should MISS")
	}
	return ""
}
