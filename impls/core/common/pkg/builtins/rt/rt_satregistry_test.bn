// Tests for the interface-satisfaction registry (rt_satregistry.bn).
//
// Gated to the hosted variant (like rt_test.bn): they exercise bit_cast +
// raw-pointer walks, which currently require compiled mode.  The `fail` helper
// is shared from rt_test.bn (same package).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

// satEntryInfo builds one synthetic {Type, Iface, Vtable} record (the
// SatEntryInfo payload the registry walks) with the given opaque key values.
func satEntryInfo(ti int, id int, vt int) *uint8 {
	var w int = cast(int, sizeof(int))
	var se *uint8 = RawAlloc(3 * w)
	var sw *int = bit_cast(*int, se)
	sw[0] = ti
	sw[1] = id
	sw[2] = vt
	return se
}

// pkgArray builds a synthetic `_pkg_satentries` backing array of the three given
// SatEntryInfo pointers (a 3-word array of @SatEntryInfo).
func pkgArray(se0 *uint8, se1 *uint8, se2 *uint8) *uint8 {
	var w int = cast(int, sizeof(int))
	var pkg *uint8 = RawAlloc(3 * w)
	var pkgw *int = bit_cast(*int, pkg)
	pkgw[0] = bit_cast(int, se0)
	pkgw[1] = bit_cast(int, se1)
	pkgw[2] = bit_cast(int, se2)
	return pkg
}

// leafFrag builds a synthetic `_pkg_satfrag` node with no dependencies:
// { entriesPtr, ownCount, depCount = 0 }.
func leafFrag(entries *uint8, ownCount int) *uint8 {
	var w int = cast(int, sizeof(int))
	var frag *uint8 = RawAlloc(3 * w)
	var fw *int = bit_cast(*int, frag)
	fw[0] = bit_cast(int, entries)
	fw[1] = ownCount
	fw[2] = 0
	return frag
}

// TestSatRegistry exercises the interface-satisfaction itab hash end to end.
// (1) An empty registry MISSes.  (2) After BuildSatRegistry over a single
// `_pkg_satfrag` node (one package, three entries), the registered (type, iface)
// pairs HIT with their sub-vtable and unregistered pairs MISS.  Keys are opaque
// non-null ints (never dereferenced), so no real records are needed.
func TestSatRegistry() testing.TestResult {
	// (1) Empty registry (BuildSatRegistry not yet run): every lookup MISSes.
	if SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 8192)) != nil {
		return fail("empty registry must MISS")
	}

	// (2) A single node with three entries; two share a type, distinct ifaces.
	var pkg *uint8 = pkgArray(satEntryInfo(4096, 8192, 43690), satEntryInfo(4096, 12288, 48059),
			satEntryInfo(16384, 8192, 52719))
	BuildSatRegistry(leafFrag(pkg, 3))

	if bit_cast(int, SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 8192))) != 43690 {
		return fail("(4096,8192) should HIT 43690")
	}
	if bit_cast(int, SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 12288))) != 48059 {
		return fail("(4096,12288) should HIT 48059")
	}
	if bit_cast(int, SatLookup(bit_cast(*uint8, 16384), bit_cast(*uint8, 8192))) != 52719 {
		return fail("(16384,8192) should HIT 52719")
	}
	// Unregistered (type,iface) pairs MISS.
	if SatLookup(bit_cast(*uint8, 4096), bit_cast(*uint8, 99999)) != nil {
		return fail("(4096,99999) should MISS")
	}
	if SatLookup(bit_cast(*uint8, 16384), bit_cast(*uint8, 12288)) != nil {
		return fail("(16384,12288) should MISS")
	}
	return ""
}

// TestSatRegistryGraphCycle: the walk follows dependency edges and terminates on
// a cycle.  Nodes A <-> B each own one entry and depend on each other; building
// from A must register BOTH (B is reached only through the A->B edge) and not
// loop (dedup by node address).  Distinct keys from TestSatRegistry so the shared
// g_satTable global (whichever test's BuildSatRegistry ran last) never crosses a
// HIT between the two tests.
func TestSatRegistryGraphCycle() testing.TestResult {
	var w int = cast(int, sizeof(int))
	// A owns (20480,24576)->60000; B owns (28672,24576)->64000.
	var pkgA *uint8 = RawAlloc(w)
	var pkgAw *int = bit_cast(*int, pkgA)
	pkgAw[0] = bit_cast(int, satEntryInfo(20480, 24576, 60000))
	var pkgB *uint8 = RawAlloc(w)
	var pkgBw *int = bit_cast(*int, pkgB)
	pkgBw[0] = bit_cast(int, satEntryInfo(28672, 24576, 64000))

	// Two 4-word nodes { entriesPtr, ownCount=1, depCount=1, dep }, wired into a
	// cycle after both are allocated.
	var fragA *uint8 = RawAlloc(4 * w)
	var fragB *uint8 = RawAlloc(4 * w)
	var faw *int = bit_cast(*int, fragA)
	var fbw *int = bit_cast(*int, fragB)
	faw[0] = bit_cast(int, pkgA)
	faw[1] = 1
	faw[2] = 1
	faw[3] = bit_cast(int, fragB)
	fbw[0] = bit_cast(int, pkgB)
	fbw[1] = 1
	fbw[2] = 1
	fbw[3] = bit_cast(int, fragA)
	BuildSatRegistry(fragA)

	if bit_cast(int, SatLookup(bit_cast(*uint8, 20480), bit_cast(*uint8, 24576))) != 60000 {
		return fail("(20480,24576) in node A should HIT 60000")
	}
	if bit_cast(int, SatLookup(bit_cast(*uint8, 28672), bit_cast(*uint8, 24576))) != 64000 {
		return fail("(28672,24576) reached through the A->B edge should HIT 64000")
	}
	return ""
}
