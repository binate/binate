// Native stack-frame capture for pkg/std/debug's from-code stacktraces.
//
// This is Tier-0 runtime code: it uses ONLY bit_cast and raw-pointer
// arithmetic — no OS calls, no allocation — so it works identically on hosted
// and bare-metal targets.  It walks the hardware frame-pointer chain, which the
// codegen keeps intact by emitting the "frame-pointer"="all" attribute on every
// function (codegen.writeFnDefineAttrs), so every frame establishes its FP.
package "pkg/builtins/rt"

// CaptureNativeFrames walks the frame-pointer chain starting from fp0 (the frame
// of the function containing the _stack_frames intrinsic, i.e. debug.Callers),
// recording the return-address of each frame above it (the caller chain) into the
// caller-owned buffer (data, up to dataLen Frame slots of 2 words each), skipping
// the first `skip` recordable frames.  Returns the number of recordable frames AT
// OR ABOVE skip (full depth minus skip, floored at 0), which may exceed dataLen —
// so `result > dataLen` means the buffer truncated the capture.
// x86-64 / AArch64 / ARM32 all share the frame-record layout the walk assumes:
// *(fp)=caller fp, *(fp+word)=ret addr (word = sizeof(int), so 4 on arm32).
func CaptureNativeFrames(fp0 *uint8, skip int, data *uint8, dataLen int) int {
	var w int = cast(int, sizeof(int))
	var fp int = bit_cast(int, fp0)
	var total int = 0
	var written int = 0
	for fp != 0 {
		var fpw *int = bit_cast(*int, fp)
		var retAddr int = fpw[1] // *(fp+word) = return address into this frame's caller
		if retAddr == 0 { break } // reached _start / top of stack
		if total >= skip {
			if written < dataLen {
				var slot *int = bit_cast(*int, bit_cast(int, data) + written * 2 * w)
				slot[0] = 0 // FRAME_NATIVE
				slot[1] = retAddr
				written = written + 1
			}
		}
		total = total + 1
		var savedFp int = fpw[0] // *(fp) = caller's fp
		// A caller's frame is ALWAYS at a higher stack address (the stack grows
		// down), so a valid saved-fp is strictly greater (unsigned) than the current
		// fp.  Stop otherwise: 0 is the crt0/_start sentinel, and a lower / equal /
		// unaligned value is a broken chain — most importantly the walk crossing from
		// Binate frames into the C entry's glibc caller, whose saved r11 is NOT a null
		// sentinel on arm32 (unlike x86-64, where _start zeroes rbp), so following it
		// dereferences a non-frame address and FAULTS.  Without this guard the walk
		// runs off the end of the chain and SIGSEGVs on hosted arm32 (bare metal is
		// immune — its whole chain is Binate frames with r11==0 at reset).  Compared
		// unsigned so a user stack above 0x7FFFFFFF still orders correctly.
		//
		// This is a heuristic, not a categorical guard: a broken saved-fp that happens
		// to be HIGHER than fp, aligned, and unmapped would still be followed and
		// fault.  A complete check needs the live stack bounds, which this Tier-0 code
		// (no OS calls — it must also run bare-metal) cannot query; monotonic+aligned
		// catches the broken chains that occur in practice (the glibc-entry boundary).
		if bit_cast(uint, savedFp) <= bit_cast(uint, fp) { break }
		if (savedFp & (w - 1)) != 0 { break }
		fp = savedFp
	}
	// Frames available at/above skip — the count callers compare against dataLen
	// for truncation, and 0 exactly when nothing at/above skip was recordable.
	var avail int = total - skip
	if avail < 0 {
		avail = 0
	}
	return avail
}
