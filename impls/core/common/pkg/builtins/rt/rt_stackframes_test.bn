// Tests for CaptureNativeFrames.  Rather than depend on a real hardware frame
// chain (which needs the frameaddress intrinsic wired through OP_STACK_FRAMES),
// these build a FAKE frame chain in a local int buffer and point the walker at
// it: each 2-word cell is {saved-fp, return-address}, a zero saved-fp marks the
// top.  This exercises the walk, the skip offset, and the truncation contract
// (total counts every frame even past the buffer) with only in-bounds memory.
//
// Like the other rt tests these use bit_cast + pointer indexing (compiled mode),
// and are gated to the hosted variant (bare metal runs no host unit tests).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

// fail is defined once in rt_test.bn (same package, same build gate) and shared
// across the rt test files, as rt_diag_test.bn / rt_satregistry_test.bn do.

// TestCaptureNativeFramesFakeChain walks a 2-frame fake chain and checks the
// recorded FRAME_NATIVE mode + return addresses and the total depth.
func TestCaptureNativeFramesFakeChain() testing.TestResult {
	var stk [4]int
	stk[0] = bit_cast(int, &stk[2]) // frame0 saved-fp -> frame1's cell
	stk[1] = 100 // frame0 return address
	stk[2] = 0 // frame1 saved-fp = 0 (top of chain)
	stk[3] = 200 // frame1 return address
	var outbuf [4]int // room for 2 Frame slots (2 words each)
	var total int = CaptureNativeFrames(
			bit_cast(*uint8, &stk[0]), 0, bit_cast(*uint8, &outbuf[0]), 2)
	if total != 2 { return fail("expected total depth 2") }
	if outbuf[0] != 0 { return fail("frame0 Mode should be FRAME_NATIVE (0)") }
	if outbuf[1] != 100 { return fail("frame0 Loc should be the first return address") }
	if outbuf[2] != 0 { return fail("frame1 Mode should be FRAME_NATIVE (0)") }
	if outbuf[3] != 200 { return fail("frame1 Loc should be the second return address") }
	return ""
}

// TestCaptureNativeFramesSkipAndTruncate checks that `skip` drops leading frames
// and that the return is the count AT OR ABOVE skip (full depth 3 minus skip 1 =
// 2), which exceeds the one-slot buffer — so the return signals truncation.
func TestCaptureNativeFramesSkipAndTruncate() testing.TestResult {
	var stk [6]int
	stk[0] = bit_cast(int, &stk[2]) // frame0 -> frame1
	stk[1] = 100
	stk[2] = bit_cast(int, &stk[4]) // frame1 -> frame2
	stk[3] = 200
	stk[4] = 0 // frame2 saved-fp = 0 (top)
	stk[5] = 300
	var outbuf [2]int // room for only ONE Frame slot
	var avail int = CaptureNativeFrames(
			bit_cast(*uint8, &stk[0]), 1, bit_cast(*uint8, &outbuf[0]), 1)
	if avail != 2 { return fail("skip=1 over a depth-3 chain should report 2 frames at/above skip") }
	// skip=1 drops frame0, so the single buffer slot holds frame1's address.
	if outbuf[1] != 200 { return fail("with skip=1 the first recorded frame is the 2nd") }
	return ""
}

// TestCaptureNativeFramesSkipPastTop checks that a skip past the whole chain
// reports 0 (nothing at/above skip) rather than the full depth — the value
// debug.Caller keys its (_, false) result on.
func TestCaptureNativeFramesSkipPastTop() testing.TestResult {
	var stk [4]int
	stk[0] = bit_cast(int, &stk[2]) // frame0 -> frame1
	stk[1] = 100
	stk[2] = 0 // frame1 saved-fp = 0 (top)
	stk[3] = 200
	var outbuf [4]int
	var avail int = CaptureNativeFrames(
			bit_cast(*uint8, &stk[0]), 5, bit_cast(*uint8, &outbuf[0]), 2)
	if avail != 0 { return fail("skip past the top of a depth-2 chain should report 0") }
	return ""
}
