// Tests for the Binate runtime (pkg/builtins/rt).
//
// These tests use bit_cast, pointer indexing, and C FFI — features that
// currently require compiled mode. Once the interpreter supports raw memory
// operations, these tests should pass in interpreted mode as well.
//
// Gated to the hosted (libc) rt.bn variant: these exercise the libc impl, and
// the bare-metal target runs no host unit tests.
#[build(!is(os, "baremetal"))]
package "pkg/builtins/rt"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

func TestAlloc() testing.TestResult {
	var p *uint8 = Alloc(64)
	if p == nil { return fail("Alloc returned nil") }
	// Refcount should be 1 after allocation
	if Refcount(p) != 1 { return fail("expected refcount 1") }
	Free(p)
	return ""
}

func TestRefIncDec() testing.TestResult {
	var p *uint8 = Alloc(8)
	if Refcount(p) != 1 { return fail("expected rc 1") }
	RefInc(p)
	if Refcount(p) != 2 { return fail("expected rc 2 after inc") }
	RefDec(p, nil)
	if Refcount(p) != 1 { return fail("expected rc 1 after dec") }
	Free(p)
	return ""
}

func TestRefDecFrees() testing.TestResult {
	// RefDec to 0 should free — we can't verify free directly,
	// but we can verify it doesn't crash
	var p *uint8 = Alloc(8)
	RefDec(p, nil)
	// p is now freed — don't access it
	return ""
}

// TestZeroRefDestroyNoDtor: ZeroRefDestroy with nil dtor frees the
// allocation. Mirrors what the inline RefDec slow-path will do once
// backends call into this helper. ptr is non-nil at this point (the
// inline fast path filtered nil); the refcount has already been
// decremented to zero by the caller.
func TestZeroRefDestroyNoDtor() testing.TestResult {
	var p *uint8 = Alloc(8)
	// Simulate the inline fast path: decrement refcount in place, then
	// hand off to the slow-path helper.
	var h *int = bit_cast(*int, bit_cast(int, p) - 16)
	h[0] = 0
	ZeroRefDestroy(p, nil)
	// p is now freed — don't access it.
	return ""
}

// zeroRefDestroyDtorFlag is module-level state observed by
// zeroRefDestroyDtor; reset at the start of TestZeroRefDestroyWithDtor.
var zeroRefDestroyDtorFlag int = 0

// zeroRefDestroyDtor: a stand-in destructor that records its
// invocation in zeroRefDestroyDtorFlag. ZeroRefDestroy invokes it via
// _call_dtor(dtor, ptr) on the slow path before freeing.
func zeroRefDestroyDtor(ptr *uint8) {
	zeroRefDestroyDtorFlag = 1
}

// TestZeroRefDestroyWithDtor: ZeroRefDestroy with a non-nil dtor runs
// the destructor before freeing. Verifies the slow-path's dtor wiring
// in the runtime helper itself (the equivalent at the backend level
// is exercised by the inline-RefDec lowerings calling through to it).
func TestZeroRefDestroyWithDtor() testing.TestResult {
	zeroRefDestroyDtorFlag = 0
	var p *uint8 = Alloc(8)
	var h *int = bit_cast(*int, bit_cast(int, p) - 16)
	h[0] = 0
	var dtor *uint8 = bit_cast(*uint8, _func_handle(zeroRefDestroyDtor))
	ZeroRefDestroy(p, dtor)
	if zeroRefDestroyDtorFlag != 1 {
		return fail("expected dtor to be invoked before free")
	}
	return ""
}

func TestRefcountNil() testing.TestResult {
	if Refcount(nil) != 0 { return fail("nil refcount should be 0") }
	return ""
}

func TestBox() testing.TestResult {
	var val int = 42
	var src *uint8 = bit_cast(*uint8, &val)
	var boxed *uint8 = Box(src, 8)
	if boxed == nil { return fail("Box returned nil") }
	var result *int = bit_cast(*int, boxed)
	if result[0] != 42 { return fail("boxed value should be 42") }
	if Refcount(boxed) != 1 { return fail("boxed refcount should be 1") }
	Free(boxed)
	return ""
}

func TestMakeManagedSlice() testing.TestResult {
	var ms ManagedSlice = MakeManagedSlice(8, 4)
	if ms.Len != 4 { return fail("expected len 4") }
	if ms.Data == nil { return fail("data should not be nil") }
	if ms.Refptr == nil { return fail("refptr should not be nil") }
	if Refcount(ms.Refptr) != 1 { return fail("backing refcount should be 1") }
	Free(ms.Refptr)
	return ""
}

func TestMakeManagedSliceZero() testing.TestResult {
	var ms ManagedSlice = MakeManagedSlice(8, 0)
	if ms.Len != 0 { return fail("expected len 0") }
	if ms.Data != nil { return fail("data should be nil for zero length") }
	if ms.Refptr != nil { return fail("refptr should be nil for zero length") }
	return ""
}

func TestBoundsCheck() testing.TestResult {
	// Valid indices should not panic
	BoundsCheck(0, 5)
	BoundsCheck(4, 5)
	// We can't test the failing case without catching panics
	return ""
}

// TestDivCheck: valid divides must not panic. The failing paths
// (divisor 0, signed MIN / -1) abort the process, so they can't be
// asserted here — same limitation as TestBoundsCheck. Covers a non-zero
// divisor, the MIN dividend with a non-(-1) divisor, and a -1 divisor
// with a non-MIN dividend (each near a fault but not faulting).
func TestDivCheck() testing.TestResult {
	var i64min int64 = cast(int64, -9223372036854775807) - cast(int64, 1)
	DivCheck(cast(int64, 7), cast(int64, 2), i64min, 1)
	DivCheck(i64min, cast(int64, 2), i64min, 1)
	DivCheck(cast(int64, 5), cast(int64, -1), i64min, 1)
	// Unsigned: signedMin ignored, only the zero check applies.
	DivCheck(cast(int64, 100), cast(int64, -1), cast(int64, 0), 0)
	return ""
}

func TestRefIncDecNil() testing.TestResult {
	// RefInc/RefDec on nil should be no-ops
	RefInc(nil)
	RefDec(nil, nil)
	return ""
}

// TestRefIncDecImmortal: a header whose Refcount is the negative
// STATIC_REFCOUNT sentinel marks immortal static-managed data. RefInc and
// RefDec must leave the count untouched and never free it, no matter how
// many times they run.
func TestRefIncDecImmortal() testing.TestResult {
	var p *uint8 = Alloc(8)
	var h *int = headerPtr(p)
	h[0] = STATIC_REFCOUNT
	RefInc(p)
	if Refcount(p) != STATIC_REFCOUNT {
		return fail("RefInc mutated an immortal refcount")
	}
	RefDec(p, nil)
	if Refcount(p) != STATIC_REFCOUNT {
		return fail("RefDec mutated an immortal refcount")
	}
	for i := 0; i < 100; i++ {
		RefInc(p)
		RefDec(p, nil)
	}
	if Refcount(p) != STATIC_REFCOUNT {
		return fail("immortal refcount drifted under repeated inc/dec")
	}
	// Free ignores the refcount; explicit cleanup so the test allocation
	// doesn't leak (the immortal RefDec above never freed it).
	Free(p)
	return ""
}

// TestRefDecImmortalSkipsDtor: RefDec on an immortal header must short-circuit
// before the destroy path, so the destructor never runs.
func TestRefDecImmortalSkipsDtor() testing.TestResult {
	zeroRefDestroyDtorFlag = 0
	var p *uint8 = Alloc(8)
	var h *int = headerPtr(p)
	h[0] = STATIC_REFCOUNT
	var dtor *uint8 = bit_cast(*uint8, _func_handle(zeroRefDestroyDtor))
	RefDec(p, dtor)
	if zeroRefDestroyDtorFlag != 0 {
		return fail("RefDec ran the dtor on an immortal object")
	}
	if Refcount(p) != STATIC_REFCOUNT {
		return fail("immortal refcount changed under RefDec")
	}
	Free(p)
	return ""
}

func TestRawAllocFree() testing.TestResult {
	var p *uint8 = RawAlloc(32)
	if p == nil { return fail("RawAlloc returned nil") }
	// Write and read to verify the allocation is usable.
	var ip *int = bit_cast(*int, p)
	ip[0] = 12345
	if ip[0] != 12345 { return fail("write/read mismatch after RawAlloc") }
	RawFree(p)
	return ""
}

func TestRawAllocZero() testing.TestResult {
	var p *uint8 = RawAllocZero(32)
	if p == nil { return fail("RawAllocZero returned nil") }
	var ip *int = bit_cast(*int, p)
	for i := 0; i < 4; i++ {
		if ip[i] != 0 { return fail("RawAllocZero memory not zeroed") }
	}
	RawFree(p)
	return ""
}

func TestRawFreeNil() testing.TestResult {
	// RawFree(nil) must be a no-op.
	RawFree(nil)
	return ""
}

func TestMemZero() testing.TestResult {
	var p *uint8 = RawAlloc(16)
	// Pre-fill so we can detect that MemZero actually wrote zeros.
	for i := 0; i < 16; i++ { p[i] = cast(uint8, 0xAB) }
	MemZero(p, 16)
	for i := 0; i < 16; i++ {
		if cast(int, p[i]) != 0 {
			return fail("MemZero did not write zero")
		}
	}
	RawFree(p)
	return ""
}

func TestMemZeroSizeZero() testing.TestResult {
	// size == 0 is a no-op even with nil ptr.
	MemZero(nil, 0)
	return ""
}

func TestMemCopy() testing.TestResult {
	var src *uint8 = RawAllocZero(8)
	var dst *uint8 = RawAllocZero(8)
	for i := 0; i < 8; i++ { src[i] = cast(uint8, 0x42) }
	MemCopy(dst, src, 8)
	for i := 0; i < 8; i++ {
		if cast(int, dst[i]) != 0x42 {
			return fail("MemCopy did not copy bytes")
		}
	}
	RawFree(src)
	RawFree(dst)
	return ""
}

func TestMemCopySizeZero() testing.TestResult {
	// size == 0 is a no-op even with nil ptrs.
	MemCopy(nil, nil, 0)
	return ""
}

func TestLiveBlocksRawBalances() testing.TestResult {
	// RawAlloc increments the live-block count by 1, RawFree decrements it.
	var before int = LiveBlocks()
	var p *uint8 = RawAlloc(32)
	if LiveBlocks() != before + 1 {
		RawFree(p)
		return "LiveBlocks did not increment by 1 on RawAlloc"
	}
	RawFree(p)
	if LiveBlocks() != before {
		return "LiveBlocks did not return to baseline after RawFree"
	}
	return ""
}

func TestLiveBlocksRawAllocZeroCountsOnce() testing.TestResult {
	// RawAllocZero must increment LiveBlocks by EXACTLY 1 — it must not
	// double-count on a backend where it delegates to RawAlloc.
	var before int = LiveBlocks()
	var p *uint8 = RawAllocZero(32)
	if LiveBlocks() != before + 1 {
		RawFree(p)
		return "RawAllocZero did not increment LiveBlocks by exactly 1"
	}
	RawFree(p)
	if LiveBlocks() != before {
		return "LiveBlocks did not return to baseline after RawFree"
	}
	return ""
}

func TestLiveBlocksNilFreeIsNoOp() testing.TestResult {
	// RawFree(nil) is a no-op and must not decrement the count.
	var before int = LiveBlocks()
	RawFree(nil)
	if LiveBlocks() != before {
		return "RawFree(nil) changed LiveBlocks"
	}
	return ""
}

// offsetPtr returns base advanced by off bytes — used to exercise MemZero /
// MemCopy at every sub-word start alignment (RawAlloc returns word-aligned).
func offsetPtr(base *uint8, off int) *uint8 {
	return bit_cast(*uint8, bit_cast(int, base) + off)
}

// MemZero across every start alignment and size (sub-word / exact-word /
// word-plus-tail), verifying the target region is zeroed AND that no byte
// outside it is touched (0xAB sentinel).  Covers the aligned lead-in, the bulk
// word stores, and the byte tail.
func TestMemZeroAlignmentsAndSizes() testing.TestResult {
	var cap int = 64
	var buf *uint8 = RawAlloc(cap)
	for off := 0; off < 9; off++ {
		for sz := 0; sz < 19; sz++ {
			for k := 0; k < cap; k++ { buf[k] = cast(uint8, 0xAB) }
			MemZero(offsetPtr(buf, off), sz)
			for k := 0; k < cap; k++ {
				var want int = 0xAB
				if k >= off && k < off + sz { want = 0 }
				if cast(int, buf[k]) != want {
					RawFree(buf)
					return fail("MemZero: wrong byte (region or overrun)")
				}
			}
		}
	}
	RawFree(buf)
	return ""
}

// MemCopy with dst and src at the SAME alignment (the word-copy path): every
// start alignment and size, verifying the copied region matches src and no
// byte outside the dst region is disturbed.
func TestMemCopySameAlignment() testing.TestResult {
	var cap int = 64
	var src *uint8 = RawAlloc(cap)
	var dst *uint8 = RawAlloc(cap)
	for k := 0; k < cap; k++ { src[k] = cast(uint8, k + 1) }
	for off := 0; off < 9; off++ {
		for sz := 0; sz < 19; sz++ {
			for k := 0; k < cap; k++ { dst[k] = cast(uint8, 0xAB) }
			MemCopy(offsetPtr(dst, off), offsetPtr(src, off), sz)
			for k := 0; k < cap; k++ {
				var want int = 0xAB
				if k >= off && k < off + sz { want = cast(int, src[k]) }
				if cast(int, dst[k]) != want {
					RawFree(src)
					RawFree(dst)
					return fail("MemCopy same-align: wrong byte (region or overrun)")
				}
			}
		}
	}
	RawFree(src)
	RawFree(dst)
	return ""
}

// MemCopy with dst and src at DIFFERENT alignments (the byte-copy fallback,
// which strict-alignment targets require): dst offset and src offset differ by
// one, so no aligned word covers both.  Same region/overrun verification.
func TestMemCopyCrossAlignment() testing.TestResult {
	var cap int = 64
	var src *uint8 = RawAlloc(cap)
	var dst *uint8 = RawAlloc(cap)
	for k := 0; k < cap; k++ { src[k] = cast(uint8, k + 1) }
	for doff := 0; doff < 8; doff++ {
		var soff int = doff + 1
		for sz := 0; sz < 19; sz++ {
			for k := 0; k < cap; k++ { dst[k] = cast(uint8, 0xAB) }
			MemCopy(offsetPtr(dst, doff), offsetPtr(src, soff), sz)
			for k := 0; k < cap; k++ {
				var want int = 0xAB
				if k >= doff && k < doff + sz { want = cast(int, src[k - doff + soff]) }
				if cast(int, dst[k]) != want {
					RawFree(src)
					RawFree(dst)
					return fail("MemCopy cross-align: wrong byte (region or overrun)")
				}
			}
		}
	}
	RawFree(src)
	RawFree(dst)
	return ""
}
