package "pkg/builtins/rt"

import "pkg/builtins/testing"

// Helpers shared by the rt tests on every target — this file has no build gate,
// unlike rt_test.bn (hosted only), so a test that runs on bare metal too
// (rt_memmove_test.bn) can use them.

// fail returns msg as a failing test result.
func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

// offsetPtr returns base advanced by off bytes — used to exercise MemZero /
// MemCopy / MemMove at every sub-word start alignment (RawAlloc returns
// word-aligned).
func offsetPtr(base *uint8, off int) *uint8 {
	return bit_cast(*uint8, bit_cast(int, base) + off)
}
