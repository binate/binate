// IEEE-754 soft-float in pure Binate — see the package doc in
// ifaces/core/pkg/builtins/softfloat.bni.  Target-agnostic integer
// bit-manipulation (uint32 / uint64); emits no float ops.
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  F32ToF64 follows
// fp_extend_impl.inc / fp_extend.h (SRC_SINGLE -> DST_DOUBLE).
package "pkg/builtins/softfloat"

// clz32 counts leading zero bits of a uint32 (32 for 0).  A branchless binary
// search — the arm32 ISA has a CLZ instruction, but there is no Binate builtin
// for it, so this open-codes it (bnc may or may not fold it to CLZ; either is
// correct).
func clz32(x uint32) int {
	if x == 0 {
		return 32
	}
	var n int = 0
	var v uint32 = x
	if (v & 0xFFFF0000) == 0 {
		n = n + 16
		v = v << 16
	}
	if (v & 0xFF000000) == 0 {
		n = n + 8
		v = v << 8
	}
	if (v & 0xF0000000) == 0 {
		n = n + 4
		v = v << 4
	}
	if (v & 0xC0000000) == 0 {
		n = n + 2
		v = v << 2
	}
	if (v & 0x80000000) == 0 {
		n = n + 1
	}
	return n
}

// F32ToF64: binary32 -> binary64 (exact).  src: 1 sign / 8 exp (bias 127) / 23
// frac; dst: 1 sign / 11 exp (bias 1023) / 52 frac.
func F32ToF64(a uint32) uint64 {
	var srcSign uint32 = (a >> 31) & 1
	var srcExp uint32 = (a >> 23) & 0xFF
	var srcSigFrac uint32 = a & 0x7FFFFF

	var dstSign uint64 = cast(uint64, srcSign)
	var dstExp uint64 = 0
	var dstSigFrac uint64 = 0

	if srcExp >= 1 && srcExp < 255 {
		// normal
		dstExp = cast(uint64, srcExp) + cast(uint64, 896) // 1023 - 127
		dstSigFrac = cast(uint64, srcSigFrac) << 29 // 52 - 23
	} else if srcExp == 255 {
		// inf / nan
		dstExp = 2047
		dstSigFrac = cast(uint64, srcSigFrac) << 29
	} else if srcSigFrac != 0 {
		// denormal: renormalize.  scale = clz_in_sig_frac + 1, where
		// clz_in_sig_frac = clz32(srcSigFrac) - (1 + 8).
		var scale int = clz32(srcSigFrac) - 9 + 1
		dstExp = cast(uint64, 897 - scale) // 1023 - 127 + 1 - scale
		dstSigFrac = cast(uint64, srcSigFrac) << cast(uint32, 29 + scale)
		var dstMinNormal uint64 = cast(uint64, 1) << 52
		dstSigFrac = dstSigFrac ^ dstMinNormal
	}
	// else: zero — dstExp / dstSigFrac already 0.

	return (dstSign << 63) | (dstExp << 52) | dstSigFrac
}

// F64ToF32: binary64 -> binary32, round to nearest, ties to even; overflow ->
// inf, underflow -> denormal/zero (with sticky).  Backs __aeabi_d2f.  Follows
// compiler-rt fp_trunc_impl.inc (SRC_DOUBLE -> DST_SINGLE).  src: 1/11/52
// (bias 1023); dst: 1/8/23 (bias 127); tail = 52-23 = 29 bits dropped.
func F64ToF32(a uint64) uint32 {
	var srcSign uint32 = cast(uint32, (a >> 63) & 1)
	var srcExp uint64 = (a >> 52) & 0x7FF
	var srcSigFrac uint64 = a & 0xFFFFFFFFFFFFF

	var dstSign uint32 = srcSign
	var dstExp uint32 = 0
	var dstSigFrac uint32 = 0

	var dstExpCandidate int = (cast(int, srcExp) - 1023) + 127
	if dstExpCandidate >= 1 && dstExpCandidate < 255 {
		// Normal in the destination range: shift with rounding.
		dstExp = cast(uint32, dstExpCandidate)
		dstSigFrac = cast(uint32, srcSigFrac >> 29)
		var roundBits uint64 = srcSigFrac & 0x1FFFFFFF // (1<<29)-1
		if roundBits > 0x10000000 {
			// halfway = 1<<28
			dstSigFrac = dstSigFrac + 1
		} else if roundBits == 0x10000000 {
			dstSigFrac = dstSigFrac + (dstSigFrac & 1)
		}
		if dstSigFrac >= 0x800000 {
			// rounding carried into the exponent
			dstExp = dstExp + 1
			dstSigFrac = dstSigFrac ^ 0x800000
		}
	} else if srcExp == 2047 && srcSigFrac != 0 {
		// NaN: quiet + truncated payload.
		dstExp = 255
		dstSigFrac = 0x400000 // dstQNaN = 1<<22
		var payload uint32 = cast(uint32, (srcSigFrac & 0x7FFFFFFFFFFFF) >> 29) & 0x3FFFFF
		dstSigFrac = dstSigFrac | payload
	} else if cast(int, srcExp) >= 1151 {
		// overflowExponent = 1023+255-127
		dstExp = 255
		dstSigFrac = 0
	} else {
		// Underflow: denormalize with sticky, or zero.
		var significand uint64 = srcSigFrac
		var shift int = 1023 - 127 - cast(int, srcExp)
		if srcExp != 0 {
			significand = significand | 0x10000000000000 // srcMinNormal 1<<52
			shift = shift + 1
		}
		if shift > 52 {
			dstExp = 0
			dstSigFrac = 0
		} else {
			dstExp = 0
			var stickyBit uint64 = 0
			if shift != 0 {
				if (significand << cast(uint64, 64 - shift)) != 0 {
					stickyBit = 1
				}
			}
			var denorm uint64 = (significand >> cast(uint64, shift)) | stickyBit
			dstSigFrac = cast(uint32, denorm >> 29)
			var roundBits uint64 = denorm & 0x1FFFFFFF
			if roundBits > 0x10000000 {
				dstSigFrac = dstSigFrac + 1
			} else if roundBits == 0x10000000 {
				dstSigFrac = dstSigFrac + (dstSigFrac & 1)
			}
			if dstSigFrac >= 0x800000 {
				dstExp = dstExp + 1
				dstSigFrac = dstSigFrac ^ 0x800000
			}
		}
	}
	return (dstSign << 31) | (dstExp << 23) | dstSigFrac
}

// clz64 counts leading zero bits of a uint64 (64 for 0).  Branchless binary
// search; no Binate CLZ builtin.
func clz64(x uint64) int {
	if x == 0 {
		return 64
	}
	var n int = 0
	var v uint64 = x
	if (v & 0xFFFFFFFF00000000) == 0 {
		n = n + 32
		v = v << 32
	}
	if (v & 0xFFFF000000000000) == 0 {
		n = n + 16
		v = v << 16
	}
	if (v & 0xFF00000000000000) == 0 {
		n = n + 8
		v = v << 8
	}
	if (v & 0xF000000000000000) == 0 {
		n = n + 4
		v = v << 4
	}
	if (v & 0xC000000000000000) == 0 {
		n = n + 2
		v = v << 2
	}
	if (v & 0x8000000000000000) == 0 {
		n = n + 1
	}
	return n
}

// normalize64 normalizes a denormal f64 significand so the leading 1 sits at
// the implicit-bit position (1<<52), returning the shifted significand and the
// biased-exponent adjustment (compiler-rt fp_lib.h normalize).  clz64(1<<52)=11.
func normalize64(significand uint64) (uint64, int) {
	var shift int = clz64(significand) - 11
	return significand << cast(uint64, shift), 1 - shift
}

// F64Add: IEEE-754 binary64 addition, round to nearest ties to even.  Backs
// __aeabi_dadd (and, with a flipped b sign, dsub/drsub).  Translated from
// compiler-rt fp_add_impl.inc (round-to-nearest hardcoded — no fenv).
func F64Add(a uint64, b uint64) uint64 {
	var aRep uint64 = a
	var bRep uint64 = b
	var aAbs uint64 = aRep & 0x7FFFFFFFFFFFFFFF
	var bAbs uint64 = bRep & 0x7FFFFFFFFFFFFFFF
	var infRep uint64 = 0x7FF0000000000000
	var signBit uint64 = 0x8000000000000000

	// NaN / infinity / zero.
	if aAbs - 1 >= infRep - 1 || bAbs - 1 >= infRep - 1 {
		if aAbs > infRep {
			return aRep | 0x8000000000000 // quiet the NaN
		}
		if bAbs > infRep {
			return bRep | 0x8000000000000
		}
		if aAbs == infRep {
			if (aRep ^ bRep) == signBit {
				return 0x7FF8000000000000 // inf + (-inf) = qNaN
			}
			return aRep
		}
		if bAbs == infRep {
			return bRep
		}
		if aAbs == 0 {
			if bAbs == 0 {
				return aRep & bRep // +0/-0 rules
			}
			return bRep
		}
		if bAbs == 0 {
			return aRep
		}
	}

	// Ensure |a| >= |b|.
	if bAbs > aAbs {
		var t uint64 = aRep
		aRep = bRep
		bRep = t
	}

	var aExponent int = cast(int, (aRep >> 52) & 2047)
	var bExponent int = cast(int, (bRep >> 52) & 2047)
	var aSignificand uint64 = aRep & 0xFFFFFFFFFFFFF
	var bSignificand uint64 = bRep & 0xFFFFFFFFFFFFF

	if aExponent == 0 {
		aSignificand, aExponent = normalize64(aSignificand)
	}
	if bExponent == 0 {
		bSignificand, bExponent = normalize64(bSignificand)
	}

	var resultSign uint64 = aRep & signBit
	var subtraction bool = ((aRep ^ bRep) & signBit) != 0

	// Add implicit bit, make room for guard/round/sticky (<<3).
	aSignificand = (aSignificand | 0x10000000000000) << 3
	bSignificand = (bSignificand | 0x10000000000000) << 3

	// Align b to a.
	var align int = aExponent - bExponent
	if align != 0 {
		if align < 64 {
			var s uint64 = 0
			if (bSignificand << cast(uint64, 64 - align)) != 0 {
				s = 1
			}
			bSignificand = (bSignificand >> cast(uint64, align)) | s
		} else {
			bSignificand = 1 // sticky; b is nonzero
		}
	}

	if subtraction {
		aSignificand = aSignificand - bSignificand
		if aSignificand == 0 {
			return 0
		}
		if aSignificand < 0x80000000000000 {
			// implicitBit << 3
			var shift int = clz64(aSignificand) - 8 // clz64(implicitBit<<3)=8
			aSignificand = aSignificand << cast(uint64, shift)
			aExponent = aExponent - shift
		}
	} else {
		aSignificand = aSignificand + bSignificand
		if (aSignificand & 0x100000000000000) != 0 {
			// implicitBit << 4
			var s uint64 = 0
			if (aSignificand & 1) != 0 {
				s = 1
			}
			aSignificand = (aSignificand >> 1) | s
			aExponent = aExponent + 1
		}
	}

	if aExponent >= 2047 {
		return infRep | resultSign
	}

	if aExponent <= 0 {
		var shift int = 1 - aExponent
		var s uint64 = 0
		if (aSignificand << cast(uint64, 64 - shift)) != 0 {
			s = 1
		}
		aSignificand = (aSignificand >> cast(uint64, shift)) | s
		aExponent = 0
	}

	var roundGuardSticky uint64 = aSignificand & 0x7
	var result uint64 = (aSignificand >> 3) & 0xFFFFFFFFFFFFF
	result = result | (cast(uint64, aExponent) << 52)
	result = result | resultSign

	// Round to nearest, ties to even.
	if roundGuardSticky > 0x4 {
		result = result + 1
	}
	if roundGuardSticky == 0x4 {
		result = result + (result & 1)
	}
	return result
}

// F64Sub / F64Rsub: a-b and b-a, via F64Add with b's (resp. a's) sign flipped.
// Back __aeabi_dsub / __aeabi_drsub.
func F64Sub(a uint64, b uint64) uint64 {
	return F64Add(a, b ^ 0x8000000000000000)
}

// F64Rsub computes b-a (reverse subtract).  Backs __aeabi_drsub.
func F64Rsub(a uint64, b uint64) uint64 {
	return F64Add(b, a ^ 0x8000000000000000)
}

// magToF64 builds a binary64 from a sign mask + a NONZERO magnitude, with
// round-to-nearest-even.  Shared by the int->double conversions; the source
// width is irrelevant since significant-bit count = 64 - clz64(mag).  Follows
// compiler-rt int_to_fp_impl.inc (__floatXiYf__, DST_DOUBLE: dstMantDig=53).
func magToF64(sign uint64, mag uint64) uint64 {
	var sd int = 64 - clz64(mag) // significant digits
	var e int = sd - 1
	var a uint64 = mag
	if sd > 53 {
		if sd == 54 {
			a = a << 1
		} else if sd == 55 {
			// no shift
		} else {
			var shift int = sd - 55
			var sticky uint64 = 0
			if (a & (0xFFFFFFFFFFFFFFFF >> cast(uint64, 64 - shift))) != 0 {
				sticky = 1
			}
			a = (a >> cast(uint64, shift)) | sticky
		}
		if (a & 4) != 0 {
			// Or P into R
			a = a | 1
		}
		a = a + 1 // round (may carry a significant bit)
		a = a >> 2
		if (a & (cast(uint64, 1) << 53)) != 0 {
			a = a >> 1
			e = e + 1
		}
	} else {
		a = a << cast(uint64, 53 - sd)
	}
	return sign | (cast(uint64, e + 1023) << 52) | (a & 0xFFFFFFFFFFFFF)
}

// I32ToF64 converts an int32 to a float64 bit pattern (exact).  Backs __aeabi_i2d.
func I32ToF64(a int32) uint64 {
	if a == 0 {
		return 0
	}
	if a < 0 {
		return magToF64(0x8000000000000000, cast(uint64, -cast(int64, a)))
	}
	return magToF64(0, cast(uint64, a))
}

// U32ToF64 converts a uint32 to a float64 bit pattern (exact).  Backs __aeabi_ui2d.
func U32ToF64(a uint32) uint64 {
	if a == 0 {
		return 0
	}
	return magToF64(0, cast(uint64, a))
}

// I64ToF64 converts an int64 to a float64 bit pattern (round to nearest even).  Backs __aeabi_l2d.
func I64ToF64(a int64) uint64 {
	if a == 0 {
		return 0
	}
	if a < 0 {
		return magToF64(0x8000000000000000, cast(uint64, 0) - cast(uint64, a))
	}
	return magToF64(0, cast(uint64, a))
}

// U64ToF64 converts a uint64 to a float64 bit pattern (round to nearest even).  Backs __aeabi_ul2d.
func U64ToF64(a uint64) uint64 {
	if a == 0 {
		return 0
	}
	return magToF64(0, a)
}
