// IEEE-754 soft-float in pure Binate — see the package doc in
// ifaces/core/pkg/builtins/softfloat.bni.  Target-agnostic integer
// bit-manipulation (uint32 / uint64); emits no float ops.
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  F32ToF64 follows
// fp_extend_impl.inc / fp_extend.h (SRC_SINGLE -> DST_DOUBLE).
package "pkg/builtins/softfloat"

// clz32 counts leading zero bits of a uint32 (32 for 0).  A branchless binary
// search — the arm32 ISA has a CLZ instruction, but there is no Binate builtin
// for it, so this open-codes it (bnc may or may not fold it to CLZ; either is
// correct).
func clz32(x uint32) int {
	if x == 0 {
		return 32
	}
	var n int = 0
	var v uint32 = x
	if (v & 0xFFFF0000) == 0 {
		n = n + 16
		v = v << 16
	}
	if (v & 0xFF000000) == 0 {
		n = n + 8
		v = v << 8
	}
	if (v & 0xF0000000) == 0 {
		n = n + 4
		v = v << 4
	}
	if (v & 0xC0000000) == 0 {
		n = n + 2
		v = v << 2
	}
	if (v & 0x80000000) == 0 {
		n = n + 1
	}
	return n
}

// F32ToF64: binary32 -> binary64 (exact).  src: 1 sign / 8 exp (bias 127) / 23
// frac; dst: 1 sign / 11 exp (bias 1023) / 52 frac.
func F32ToF64(a uint32) uint64 {
	var srcSign uint32 = (a >> 31) & 1
	var srcExp uint32 = (a >> 23) & 0xFF
	var srcSigFrac uint32 = a & 0x7FFFFF

	var dstSign uint64 = cast(uint64, srcSign)
	var dstExp uint64 = 0
	var dstSigFrac uint64 = 0

	if srcExp >= 1 && srcExp < 255 {
		// normal
		dstExp = cast(uint64, srcExp) + cast(uint64, 896) // 1023 - 127
		dstSigFrac = cast(uint64, srcSigFrac) << 29 // 52 - 23
	} else if srcExp == 255 {
		// inf / nan
		dstExp = 2047
		dstSigFrac = cast(uint64, srcSigFrac) << 29
	} else if srcSigFrac != 0 {
		// denormal: renormalize.  scale = clz_in_sig_frac + 1, where
		// clz_in_sig_frac = clz32(srcSigFrac) - (1 + 8).
		var scale int = clz32(srcSigFrac) - 9 + 1
		dstExp = cast(uint64, 897 - scale) // 1023 - 127 + 1 - scale
		dstSigFrac = cast(uint64, srcSigFrac) << cast(uint32, 29 + scale)
		var dstMinNormal uint64 = cast(uint64, 1) << 52
		dstSigFrac = dstSigFrac ^ dstMinNormal
	}
	// else: zero — dstExp / dstSigFrac already 0.

	return (dstSign << 63) | (dstExp << 52) | dstSigFrac
}

// F64ToI32: binary64 -> int32, rounding toward zero (truncate), saturating on
// overflow (INT32_MAX / INT32_MIN).  Backs __aeabi_d2iz.  Follows compiler-rt
// fp_fixint_impl.inc (DOUBLE_PRECISION, fixint_t = int32).
func F64ToI32(a uint64) int {
	var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
	var neg bool = (a & 0x8000000000000000) != 0
	var exponent int = cast(int, aAbs >> 52) - 1023
	if exponent < 0 {
		return 0
	}
	if exponent >= 32 {
		if neg {
			return -2147483647 - 1 // INT32_MIN (portable across ILP32/LP64)
		}
		return 0x7FFFFFFF // INT32_MAX
	}
	// 0 <= exponent < 32 (< significandBits 52): right-shift the 53-bit
	// significand into place.
	var significand uint64 = (aAbs & 0xFFFFFFFFFFFFF) | 0x10000000000000
	var mag uint64 = significand >> cast(uint64, 52 - exponent)
	if neg {
		return -cast(int, mag)
	}
	return cast(int, mag)
}

// F64ToF32: binary64 -> binary32, round to nearest, ties to even; overflow ->
// inf, underflow -> denormal/zero (with sticky).  Backs __aeabi_d2f.  Follows
// compiler-rt fp_trunc_impl.inc (SRC_DOUBLE -> DST_SINGLE).  src: 1/11/52
// (bias 1023); dst: 1/8/23 (bias 127); tail = 52-23 = 29 bits dropped.
func F64ToF32(a uint64) uint32 {
	var srcSign uint32 = cast(uint32, (a >> 63) & 1)
	var srcExp uint64 = (a >> 52) & 0x7FF
	var srcSigFrac uint64 = a & 0xFFFFFFFFFFFFF

	var dstSign uint32 = srcSign
	var dstExp uint32 = 0
	var dstSigFrac uint32 = 0

	var dstExpCandidate int = (cast(int, srcExp) - 1023) + 127
	if dstExpCandidate >= 1 && dstExpCandidate < 255 {
		// Normal in the destination range: shift with rounding.
		dstExp = cast(uint32, dstExpCandidate)
		dstSigFrac = cast(uint32, srcSigFrac >> 29)
		var roundBits uint64 = srcSigFrac & 0x1FFFFFFF // (1<<29)-1
		if roundBits > 0x10000000 {
			// halfway = 1<<28
			dstSigFrac = dstSigFrac + 1
		} else if roundBits == 0x10000000 {
			dstSigFrac = dstSigFrac + (dstSigFrac & 1)
		}
		if dstSigFrac >= 0x800000 {
			// rounding carried into the exponent
			dstExp = dstExp + 1
			dstSigFrac = dstSigFrac ^ 0x800000
		}
	} else if srcExp == 2047 && srcSigFrac != 0 {
		// NaN: quiet + truncated payload.
		dstExp = 255
		dstSigFrac = 0x400000 // dstQNaN = 1<<22
		var payload uint32 = cast(uint32, (srcSigFrac & 0x7FFFFFFFFFFFF) >> 29) & 0x3FFFFF
		dstSigFrac = dstSigFrac | payload
	} else if cast(int, srcExp) >= 1151 {
		// overflowExponent = 1023+255-127
		dstExp = 255
		dstSigFrac = 0
	} else {
		// Underflow: denormalize with sticky, or zero.
		var significand uint64 = srcSigFrac
		var shift int = 1023 - 127 - cast(int, srcExp)
		if srcExp != 0 {
			significand = significand | 0x10000000000000 // srcMinNormal 1<<52
			shift = shift + 1
		}
		if shift > 52 {
			dstExp = 0
			dstSigFrac = 0
		} else {
			dstExp = 0
			var stickyBit uint64 = 0
			if shift != 0 {
				if (significand << cast(uint64, 64 - shift)) != 0 {
					stickyBit = 1
				}
			}
			var denorm uint64 = (significand >> cast(uint64, shift)) | stickyBit
			dstSigFrac = cast(uint32, denorm >> 29)
			var roundBits uint64 = denorm & 0x1FFFFFFF
			if roundBits > 0x10000000 {
				dstSigFrac = dstSigFrac + 1
			} else if roundBits == 0x10000000 {
				dstSigFrac = dstSigFrac + (dstSigFrac & 1)
			}
			if dstSigFrac >= 0x800000 {
				dstExp = dstExp + 1
				dstSigFrac = dstSigFrac ^ 0x800000
			}
		}
	}
	return (dstSign << 31) | (dstExp << 23) | dstSigFrac
}
