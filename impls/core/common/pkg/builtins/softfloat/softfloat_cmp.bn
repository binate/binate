// IEEE-754 soft-float comparisons in pure Binate, backing the ARM-EABI
// comparison helpers (__aeabi_{d,f}cmp{eq,lt,le,gt,ge,un}).
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  The F{32,64}Compare cores follow
// fp_compare_impl.inc (__leXf2__); the AEABI 0/1 wrappers follow the
// __aeabi_*cmp* semantics in the AEABI spec (IHI0043): each returns 1 iff the
// ORDERED relation holds, else 0 (so every ordered relation is 0 when either
// operand is NaN), and dcmpun/fcmpun return 1 iff unordered.
package "pkg/builtins/softfloat"

// cmpLess / cmpEqual / cmpGreater / cmpUnordered are the classifications the
// F{32,64}Compare cores return for a pair of IEEE bit patterns.  Keeping
// cmpUnordered distinct (compiler-rt's le/ge cores instead fold unordered into
// greater/less) lets all six AEABI relations be derived from one core.
// cmpLess: a < b.
const cmpLess int = -1

// cmpEqual: a == b.
const cmpEqual int = 0

// cmpGreater: a > b.
const cmpGreater int = 1

// cmpUnordered: a or b is NaN.
const cmpUnordered int = 2

// F64Compare classifies a vs b (binary64 bit patterns) as cmpLess / cmpEqual /
// cmpGreater / cmpUnordered.  Follows compiler-rt fp_compare_impl.inc: after
// the NaN and both-zero cases, the bit patterns reinterpreted as SIGNED
// integers compare the same as the floats when not both negative, and with the
// sense flipped when both are negative.
func F64Compare(a uint64, b uint64) int {
	var aInt int64 = bit_cast(int64, a)
	var bInt int64 = bit_cast(int64, b)
	var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
	var bAbs uint64 = b & 0x7FFFFFFFFFFFFFFF
	if aAbs > 0x7FF0000000000000 || bAbs > 0x7FF0000000000000 {
		return cmpUnordered
	}
	if (aAbs | bAbs) == 0 {
		return cmpEqual // +0 == -0
	}
	if (aInt & bInt) >= 0 {
		if aInt < bInt {
			return cmpLess
		}
		if aInt == bInt {
			return cmpEqual
		}
		return cmpGreater
	}
	// Both negative: flip the sense.
	if aInt > bInt {
		return cmpLess
	}
	if aInt == bInt {
		return cmpEqual
	}
	return cmpGreater
}

// F32Compare classifies a vs b (binary32 bit patterns); see F64Compare.
func F32Compare(a uint32, b uint32) int {
	var aInt int32 = bit_cast(int32, a)
	var bInt int32 = bit_cast(int32, b)
	var aAbs uint32 = a & 0x7FFFFFFF
	var bAbs uint32 = b & 0x7FFFFFFF
	if aAbs > 0x7F800000 || bAbs > 0x7F800000 {
		return cmpUnordered
	}
	if (aAbs | bAbs) == 0 {
		return cmpEqual
	}
	if (aInt & bInt) >= 0 {
		if aInt < bInt {
			return cmpLess
		}
		if aInt == bInt {
			return cmpEqual
		}
		return cmpGreater
	}
	if aInt > bInt {
		return cmpLess
	}
	if aInt == bInt {
		return cmpEqual
	}
	return cmpGreater
}

// F64CmpEq returns 1 iff a == b (binary64), else 0.  Backs __aeabi_dcmpeq.
func F64CmpEq(a uint64, b uint64) int {
	if F64Compare(a, b) == cmpEqual {
		return 1
	}
	return 0
}

// F64CmpLt returns 1 iff a < b (binary64), else 0.  Backs __aeabi_dcmplt.
func F64CmpLt(a uint64, b uint64) int {
	if F64Compare(a, b) == cmpLess {
		return 1
	}
	return 0
}

// F64CmpLe returns 1 iff a <= b (binary64), else 0.  Backs __aeabi_dcmple.
func F64CmpLe(a uint64, b uint64) int {
	var r int = F64Compare(a, b)
	if r == cmpLess || r == cmpEqual {
		return 1
	}
	return 0
}

// F64CmpGt returns 1 iff a > b (binary64), else 0.  Backs __aeabi_dcmpgt.
func F64CmpGt(a uint64, b uint64) int {
	if F64Compare(a, b) == cmpGreater {
		return 1
	}
	return 0
}

// F64CmpGe returns 1 iff a >= b (binary64), else 0.  Backs __aeabi_dcmpge.
func F64CmpGe(a uint64, b uint64) int {
	var r int = F64Compare(a, b)
	if r == cmpGreater || r == cmpEqual {
		return 1
	}
	return 0
}

// F64CmpUn returns 1 iff a or b is NaN (binary64), else 0.  Backs __aeabi_dcmpun.
func F64CmpUn(a uint64, b uint64) int {
	if F64Compare(a, b) == cmpUnordered {
		return 1
	}
	return 0
}

// F32CmpEq returns 1 iff a == b (binary32), else 0.  Backs __aeabi_fcmpeq.
func F32CmpEq(a uint32, b uint32) int {
	if F32Compare(a, b) == cmpEqual {
		return 1
	}
	return 0
}

// F32CmpLt returns 1 iff a < b (binary32), else 0.  Backs __aeabi_fcmplt.
func F32CmpLt(a uint32, b uint32) int {
	if F32Compare(a, b) == cmpLess {
		return 1
	}
	return 0
}

// F32CmpLe returns 1 iff a <= b (binary32), else 0.  Backs __aeabi_fcmple.
func F32CmpLe(a uint32, b uint32) int {
	var r int = F32Compare(a, b)
	if r == cmpLess || r == cmpEqual {
		return 1
	}
	return 0
}

// F32CmpGt returns 1 iff a > b (binary32), else 0.  Backs __aeabi_fcmpgt.
func F32CmpGt(a uint32, b uint32) int {
	if F32Compare(a, b) == cmpGreater {
		return 1
	}
	return 0
}

// F32CmpGe returns 1 iff a >= b (binary32), else 0.  Backs __aeabi_fcmpge.
func F32CmpGe(a uint32, b uint32) int {
	var r int = F32Compare(a, b)
	if r == cmpGreater || r == cmpEqual {
		return 1
	}
	return 0
}

// F32CmpUn returns 1 iff a or b is NaN (binary32), else 0.  Backs __aeabi_fcmpun.
func F32CmpUn(a uint32, b uint32) int {
	if F32Compare(a, b) == cmpUnordered {
		return 1
	}
	return 0
}
