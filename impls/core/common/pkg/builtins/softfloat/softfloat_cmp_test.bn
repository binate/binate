// Differential tests for the soft-float comparison routines against the host's
// IEEE-754 comparisons.  Host-only (the bare-metal target runs no host unit
// tests).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/softfloat"

import "pkg/builtins/testing"

func b2i(x bool) int {
	if x {
		return 1
	}
	return 0
}

// ok64 checks all six binary64 relations against the host FPU for one pair.
func ok64(fa float64, fb float64) bool {
	var a uint64 = bit_cast(uint64, fa)
	var b uint64 = bit_cast(uint64, fb)
	if F64CmpEq(a, b) != b2i(fa == fb) {
		return false
	}
	if F64CmpLt(a, b) != b2i(fa < fb) {
		return false
	}
	if F64CmpLe(a, b) != b2i(fa <= fb) {
		return false
	}
	if F64CmpGt(a, b) != b2i(fa > fb) {
		return false
	}
	if F64CmpGe(a, b) != b2i(fa >= fb) {
		return false
	}
	if F64CmpUn(a, b) != b2i(fa != fa || fb != fb) {
		return false
	}
	return true
}

func ok32(fa float32, fb float32) bool {
	var a uint32 = bit_cast(uint32, fa)
	var b uint32 = bit_cast(uint32, fb)
	if F32CmpEq(a, b) != b2i(fa == fb) {
		return false
	}
	if F32CmpLt(a, b) != b2i(fa < fb) {
		return false
	}
	if F32CmpLe(a, b) != b2i(fa <= fb) {
		return false
	}
	if F32CmpGt(a, b) != b2i(fa > fb) {
		return false
	}
	if F32CmpGe(a, b) != b2i(fa >= fb) {
		return false
	}
	if F32CmpUn(a, b) != b2i(fa != fa || fb != fb) {
		return false
	}
	return true
}

func TestF64Compare() testing.TestResult {
	var nan float64 = bit_cast(float64, cast(uint64, 0x7FF8000000000000))
	var inf float64 = bit_cast(float64, cast(uint64, 0x7FF0000000000000))
	var ninf float64 = bit_cast(float64, cast(uint64, 0xFFF0000000000000))
	var nzero float64 = bit_cast(float64, cast(uint64, 0x8000000000000000))
	if !ok64(1.0, 2.0) {
		return "1,2"
	}
	if !ok64(2.0, 1.0) {
		return "2,1"
	}
	if !ok64(1.0, 1.0) {
		return "1,1"
	}
	if !ok64(-1.0, 1.0) {
		return "-1,1"
	}
	if !ok64(-2.0, -1.0) {
		return "-2,-1 (both negative)"
	}
	if !ok64(0.0, nzero) {
		return "+0,-0"
	}
	if !ok64(nan, 1.0) {
		return "nan,1"
	}
	if !ok64(1.0, nan) {
		return "1,nan"
	}
	if !ok64(nan, nan) {
		return "nan,nan"
	}
	if !ok64(inf, 1.0) {
		return "inf,1"
	}
	if !ok64(ninf, inf) {
		return "-inf,inf"
	}
	if !ok64(inf, inf) {
		return "inf,inf"
	}
	return ""
}

func TestF32Compare() testing.TestResult {
	var nan float32 = bit_cast(float32, cast(uint32, 0x7FC00000))
	var inf float32 = bit_cast(float32, cast(uint32, 0x7F800000))
	var ninf float32 = bit_cast(float32, cast(uint32, 0xFF800000))
	var nzero float32 = bit_cast(float32, cast(uint32, 0x80000000))
	if !ok32(1.0, 2.0) {
		return "1,2"
	}
	if !ok32(2.0, 1.0) {
		return "2,1"
	}
	if !ok32(1.0, 1.0) {
		return "1,1"
	}
	if !ok32(-1.0, 1.0) {
		return "-1,1"
	}
	if !ok32(-2.0, -1.0) {
		return "-2,-1 (both negative)"
	}
	if !ok32(0.0, nzero) {
		return "+0,-0"
	}
	if !ok32(nan, 1.0) {
		return "nan,1"
	}
	if !ok32(nan, nan) {
		return "nan,nan"
	}
	if !ok32(inf, 1.0) {
		return "inf,1"
	}
	if !ok32(ninf, inf) {
		return "-inf,inf"
	}
	return ""
}
