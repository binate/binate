// IEEE-754 binary32 soft-float: addition/subtraction and integer->float32
// conversions, in pure Binate (integer bit-manipulation on uint32 / uint64).
// The f64 counterparts and the shared clz helpers live in softfloat.bn.
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  F32Add follows fp_add_impl.inc
// (SINGLE_PRECISION); the int->float32 conversions follow int_to_fp_impl.inc
// (DST_SINGLE, dstMantDig = 24).
package "pkg/builtins/softfloat"

// normalize32 normalizes a denormal binary32 significand so the leading 1 sits
// at the implicit-bit position (1<<23), returning the shifted significand and
// the biased-exponent adjustment (compiler-rt fp_lib.h normalize).
// clz32(1<<23) = 8.
func normalize32(significand uint32) (uint32, int) {
	var shift int = clz32(significand) - 8
	return significand << cast(uint32, shift), 1 - shift
}

// F32Add: IEEE-754 binary32 addition, round to nearest ties to even.  Backs
// __aeabi_fadd (and, with a flipped b sign, fsub/frsub).  Translated from
// compiler-rt fp_add_impl.inc (round-to-nearest hardcoded — no fenv).  f32
// constants: significandBits 23, maxExponent 255, implicitBit 1<<23.
func F32Add(a uint32, b uint32) uint32 {
	var aRep uint32 = a
	var bRep uint32 = b
	var aAbs uint32 = aRep & 0x7FFFFFFF
	var bAbs uint32 = bRep & 0x7FFFFFFF
	var infRep uint32 = 0x7F800000
	var signBit uint32 = 0x80000000

	// NaN / infinity / zero.
	if aAbs - 1 >= infRep - 1 || bAbs - 1 >= infRep - 1 {
		if aAbs > infRep {
			return aRep | 0x400000 // quiet the NaN (quietBit = implicitBit>>1)
		}
		if bAbs > infRep {
			return bRep | 0x400000
		}
		if aAbs == infRep {
			if (aRep ^ bRep) == signBit {
				return 0x7FC00000 // inf + (-inf) = qNaN
			}
			return aRep
		}
		if bAbs == infRep {
			return bRep
		}
		if aAbs == 0 {
			if bAbs == 0 {
				return aRep & bRep // +0/-0 rules
			}
			return bRep
		}
		if bAbs == 0 {
			return aRep
		}
	}

	// Ensure |a| >= |b|.
	if bAbs > aAbs {
		var t uint32 = aRep
		aRep = bRep
		bRep = t
	}

	var aExponent int = cast(int, (aRep >> 23) & 0xFF)
	var bExponent int = cast(int, (bRep >> 23) & 0xFF)
	var aSignificand uint32 = aRep & 0x7FFFFF
	var bSignificand uint32 = bRep & 0x7FFFFF

	if aExponent == 0 {
		aSignificand, aExponent = normalize32(aSignificand)
	}
	if bExponent == 0 {
		bSignificand, bExponent = normalize32(bSignificand)
	}

	var resultSign uint32 = aRep & signBit
	var subtraction bool = ((aRep ^ bRep) & signBit) != 0

	// Add implicit bit, make room for guard/round/sticky (<<3).
	aSignificand = (aSignificand | 0x800000) << 3
	bSignificand = (bSignificand | 0x800000) << 3

	// Align b to a.
	var align int = aExponent - bExponent
	if align != 0 {
		if align < 32 {
			var s uint32 = 0
			if (bSignificand << cast(uint32, 32 - align)) != 0 {
				s = 1
			}
			bSignificand = (bSignificand >> cast(uint32, align)) | s
		} else {
			bSignificand = 1 // sticky; b is nonzero
		}
	}

	if subtraction {
		aSignificand = aSignificand - bSignificand
		if aSignificand == 0 {
			return 0
		}
		if aSignificand < 0x4000000 {
			// implicitBit << 3
			var shift int = clz32(aSignificand) - 5 // clz32(implicitBit<<3)=5
			aSignificand = aSignificand << cast(uint32, shift)
			aExponent = aExponent - shift
		}
	} else {
		aSignificand = aSignificand + bSignificand
		if (aSignificand & 0x8000000) != 0 {
			// implicitBit << 4
			var s uint32 = 0
			if (aSignificand & 1) != 0 {
				s = 1
			}
			aSignificand = (aSignificand >> 1) | s
			aExponent = aExponent + 1
		}
	}

	if aExponent >= 255 {
		return infRep | resultSign
	}

	if aExponent <= 0 {
		var shift int = 1 - aExponent
		var s uint32 = 0
		if (aSignificand << cast(uint32, 32 - shift)) != 0 {
			s = 1
		}
		aSignificand = (aSignificand >> cast(uint32, shift)) | s
		aExponent = 0
	}

	var roundGuardSticky uint32 = aSignificand & 0x7
	var result uint32 = (aSignificand >> 3) & 0x7FFFFF
	result = result | (cast(uint32, aExponent) << 23)
	result = result | resultSign

	// Round to nearest, ties to even.
	if roundGuardSticky > 0x4 {
		result = result + 1
	}
	if roundGuardSticky == 0x4 {
		result = result + (result & 1)
	}
	return result
}

// F32Sub computes a-b, via F32Add with b's sign flipped.  Backs __aeabi_fsub.
func F32Sub(a uint32, b uint32) uint32 {
	return F32Add(a, b ^ 0x80000000)
}

// F32Rsub computes b-a (reverse subtract).  Backs __aeabi_frsub.
func F32Rsub(a uint32, b uint32) uint32 {
	return F32Add(b, a ^ 0x80000000)
}

// magToF32 builds a binary32 from a sign mask + a NONZERO magnitude, with
// round-to-nearest-even.  Shared by the int->float32 conversions; the source
// width is irrelevant since significant-bit count = 64 - clz64(mag).  Follows
// compiler-rt int_to_fp_impl.inc (__floatXiYf__, DST_SINGLE: dstMantDig=24).
func magToF32(sign uint32, mag uint64) uint32 {
	var sd int = 64 - clz64(mag) // significant digits
	var e int = sd - 1
	var a uint64 = mag
	if sd > 24 {
		if sd == 25 {
			a = a << 1
		} else if sd == 26 {
			// no shift
		} else {
			var shift int = sd - 26
			var sticky uint64 = 0
			if (a & (0xFFFFFFFFFFFFFFFF >> cast(uint64, 64 - shift))) != 0 {
				sticky = 1
			}
			a = (a >> cast(uint64, shift)) | sticky
		}
		if (a & 4) != 0 {
			// Or P into R
			a = a | 1
		}
		a = a + 1 // round (may carry a significant bit)
		a = a >> 2
		if (a & (cast(uint64, 1) << 24)) != 0 {
			a = a >> 1
			e = e + 1
		}
	} else {
		a = a << cast(uint64, 24 - sd)
	}
	return sign | (cast(uint32, e + 127) << 23) | (cast(uint32, a) & 0x7FFFFF)
}

// I32ToF32 converts an int32 to a float32 bit pattern (round to nearest even).
// Backs __aeabi_i2f.
func I32ToF32(a int32) uint32 {
	if a == 0 {
		return 0
	}
	if a < 0 {
		return magToF32(0x80000000, cast(uint64, -cast(int64, a)))
	}
	return magToF32(0, cast(uint64, a))
}

// U32ToF32 converts a uint32 to a float32 bit pattern (round to nearest even).
// Backs __aeabi_ui2f.
func U32ToF32(a uint32) uint32 {
	if a == 0 {
		return 0
	}
	return magToF32(0, cast(uint64, a))
}

// I64ToF32 converts an int64 to a float32 bit pattern (round to nearest even).
// Backs __aeabi_l2f.
func I64ToF32(a int64) uint32 {
	if a == 0 {
		return 0
	}
	if a < 0 {
		return magToF32(0x80000000, cast(uint64, 0) - cast(uint64, a))
	}
	return magToF32(0, cast(uint64, a))
}

// U64ToF32 converts a uint64 to a float32 bit pattern (round to nearest even).
// Backs __aeabi_ul2f.
func U64ToF32(a uint64) uint32 {
	if a == 0 {
		return 0
	}
	return magToF32(0, a)
}

// F32Mul: IEEE-754 binary32 multiplication, round to nearest ties to even.
// Backs __aeabi_fmul.  Translated from compiler-rt fp_mul_impl.inc
// (SINGLE_PRECISION).  The 24-bit significands multiply into a 48-bit product
// held as a productHi:productLo uint32 pair (wideMultiply = a 32x32->64 mul).
func F32Mul(a uint32, b uint32) uint32 {
	var aExponent uint32 = (a >> 23) & 0xFF
	var bExponent uint32 = (b >> 23) & 0xFF
	var productSign uint32 = (a ^ b) & 0x80000000
	var aSignificand uint32 = a & 0x7FFFFF
	var bSignificand uint32 = b & 0x7FFFFF
	var scale int = 0

	// Zero / denormal / infinity / NaN (maxExponent-1 = 254; unsigned wrap
	// catches exponent 0 too).
	if aExponent - 1 >= 254 || bExponent - 1 >= 254 {
		var aAbs uint32 = a & 0x7FFFFFFF
		var bAbs uint32 = b & 0x7FFFFFFF
		if aAbs > 0x7F800000 {
			return a | 0x400000 // NaN * anything = qNaN
		}
		if bAbs > 0x7F800000 {
			return b | 0x400000
		}
		if aAbs == 0x7F800000 {
			if bAbs != 0 {
				return aAbs | productSign // inf * nonzero = inf
			}
			return 0x7FC00000 // inf * 0 = qNaN
		}
		if bAbs == 0x7F800000 {
			if aAbs != 0 {
				return bAbs | productSign
			}
			return 0x7FC00000
		}
		if aAbs == 0 {
			return productSign // 0 * anything = +/-0
		}
		if bAbs == 0 {
			return productSign
		}
		if aAbs < 0x800000 {
			var adj int
			aSignificand, adj = normalize32(aSignificand)
			scale = scale + adj
		}
		if bAbs < 0x800000 {
			var adj int
			bSignificand, adj = normalize32(bSignificand)
			scale = scale + adj
		}
	}

	aSignificand = aSignificand | 0x800000
	bSignificand = bSignificand | 0x800000

	// wideMultiply(aSignificand, bSignificand << exponentBits(=8)).
	var product uint64 = cast(uint64, aSignificand) * cast(uint64, bSignificand << 8)
	var productHi uint32 = cast(uint32, product >> 32)
	var productLo uint32 = cast(uint32, product)

	var productExponent int = cast(int, aExponent) + cast(int, bExponent) - 127 + scale

	if (productHi & 0x800000) != 0 {
		productExponent = productExponent + 1
	} else {
		// wideLeftShift(&productHi, &productLo, 1)
		productHi = (productHi << 1) | (productLo >> 31)
		productLo = productLo << 1
	}

	if productExponent >= 255 {
		return 0x7F800000 | productSign
	}

	if productExponent <= 0 {
		var shift uint32 = cast(uint32, 1 - productExponent)
		if shift >= 32 {
			return productSign
		}
		// wideRightShiftWithSticky(&productHi, &productLo, shift); count < 32.
		var sticky uint32 = 0
		if (productLo << cast(uint32, 32 - shift)) != 0 {
			sticky = 1
		}
		productLo = (productHi << cast(uint32, 32 - shift)) | (productLo >> shift) | sticky
		productHi = productHi >> shift
	} else {
		productHi = productHi & 0x7FFFFF
		productHi = productHi | (cast(uint32, productExponent) << 23)
	}

	productHi = productHi | productSign
	// Round to nearest, ties to even (signBit = 0x80000000 = the round bit).
	if productLo > 0x80000000 {
		productHi = productHi + 1
	}
	if productLo == 0x80000000 {
		productHi = productHi + (productHi & 1)
	}
	return productHi
}

// F32Div: IEEE-754 binary32 division, round to nearest ties to even.  Backs
// __aeabi_fdiv.  Translated from compiler-rt fp_div_impl.inc as configured by
// divsf3.c (SINGLE_PRECISION, 0 half-iterations, 3 native full-width
// Newton-Raphson iterations on the reciprocal; RECIPROCAL_PRECISION = 10).
func F32Div(a uint32, b uint32) uint32 {
	var aExponent uint32 = (a >> 23) & 0xFF
	var bExponent uint32 = (b >> 23) & 0xFF
	var quotientSign uint32 = (a ^ b) & 0x80000000
	var aSignificand uint32 = a & 0x7FFFFF
	var bSignificand uint32 = b & 0x7FFFFF
	var scale int = 0

	if aExponent - 1 >= 254 || bExponent - 1 >= 254 {
		var aAbs uint32 = a & 0x7FFFFFFF
		var bAbs uint32 = b & 0x7FFFFFFF
		if aAbs > 0x7F800000 {
			return a | 0x400000 // NaN / anything = qNaN
		}
		if bAbs > 0x7F800000 {
			return b | 0x400000
		}
		if aAbs == 0x7F800000 {
			if bAbs == 0x7F800000 {
				return 0x7FC00000 // inf / inf = qNaN
			}
			return aAbs | quotientSign // inf / finite = inf
		}
		if bAbs == 0x7F800000 {
			return quotientSign // finite / inf = +/-0
		}
		if aAbs == 0 {
			if bAbs == 0 {
				return 0x7FC00000 // 0 / 0 = qNaN
			}
			return quotientSign // 0 / finite = +/-0
		}
		if bAbs == 0 {
			return 0x7F800000 | quotientSign // finite / 0 = inf
		}
		if aAbs < 0x800000 {
			var adj int
			aSignificand, adj = normalize32(aSignificand)
			scale = scale + adj
		}
		if bAbs < 0x800000 {
			var adj int
			bSignificand, adj = normalize32(bSignificand)
			scale = scale - adj
		}
	}

	aSignificand = aSignificand | 0x800000
	bSignificand = bSignificand | 0x800000
	var writtenExponent int = cast(int, aExponent) - cast(int, bExponent) + scale + 127

	// b as UQ1.(W-1): shift by typeWidth - significandBits - 1 = 8.
	var b_UQ1 uint32 = bSignificand << 8

	// Initial reciprocal estimate x0 = C - b/2, C = (3/4 + 1/sqrt(2))-1 as UQ0.n.
	var x_UQ0 uint32 = 0x7504F333 - b_UQ1

	// Three native full-width Newton-Raphson iterations: x <- x*(2 - x*b).
	for i := 0; i < 3; i++ {
		var h uint32 = cast(uint32, (cast(uint64, x_UQ0) * cast(uint64, b_UQ1)) >> 32)
		var corr_UQ1 uint32 = cast(uint32, 0) - h
		x_UQ0 = cast(uint32, (cast(uint64, x_UQ0) * cast(uint64, corr_UQ1)) >> 31)
	}

	x_UQ0 = x_UQ0 - 2 // account for possible overflow
	x_UQ0 = x_UQ0 - 10 // RECIPROCAL_PRECISION for the (0 half + 3 full) config

	// quotient = x_UQ0 * (a<<1), high half (wideMultiply = 32x32->64).
	var quotient_UQ1 uint32 = cast(uint32, (cast(uint64, x_UQ0) * cast(uint64, aSignificand << 1)) >>
			32)

	var residualLo uint32 = 0
	if quotient_UQ1 < 0x1000000 {
		// implicitBit << 1
		if quotient_UQ1 < 0x800000 {
			quotient_UQ1 = quotient_UQ1 << 1
			writtenExponent = writtenExponent - 1
		}
		residualLo = (aSignificand << 24) - quotient_UQ1 * bSignificand
		writtenExponent = writtenExponent - 1
		aSignificand = aSignificand << 1
	} else {
		quotient_UQ1 = quotient_UQ1 >> 1
		residualLo = (aSignificand << 23) - quotient_UQ1 * bSignificand
	}

	if writtenExponent >= 255 {
		return 0x7F800000 | quotientSign
	}

	var absResult uint32 = 0
	if writtenExponent > 0 {
		absResult = quotient_UQ1 & 0x7FFFFF
		absResult = absResult | (cast(uint32, writtenExponent) << 23)
		residualLo = residualLo << 1
	} else {
		if 23 + writtenExponent < 0 {
			return quotientSign
		}
		absResult = quotient_UQ1 >> cast(uint32, -writtenExponent + 1)
		residualLo = (aSignificand << cast(uint32, 23 + writtenExponent)) -
				((absResult * bSignificand) << 1)
	}

	// Round: tie to even, then one NextAfter if the residual exceeds the divisor.
	residualLo = residualLo + (absResult & 1)
	if residualLo > bSignificand {
		absResult = absResult + 1
	}
	return absResult | quotientSign
}

// F32Neg negates a binary32 (flips the sign bit unconditionally, per IEEE-754 —
// so it negates zeros, infinities, and NaNs too).  Backs __aeabi_fneg.  The
// native backend lowers float negate inline, so this is provided only for the
// full AEABI set (a linked C object may call it).
func F32Neg(a uint32) uint32 {
	return a ^ 0x80000000
}
