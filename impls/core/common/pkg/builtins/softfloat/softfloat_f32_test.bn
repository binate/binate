// Differential tests for the binary32 soft-float routines against the host FPU.
// Host-only (the bare-metal target runs no host unit tests).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/softfloat"

import "pkg/builtins/testing"

// addOk32 compares F32Add's bits to the host FPU's a+b (the oracle).
func addOk32(fa float32, fb float32) bool {
	return F32Add(bit_cast(uint32, fa), bit_cast(uint32, fb)) == bit_cast(uint32, fa + fb)
}

func TestF32Add() testing.TestResult {
	if !addOk32(1.0, 1.0) {
		return "1+1"
	}
	if !addOk32(1.0, 2.0) {
		return "1+2"
	}
	if !addOk32(1.5, 2.25) {
		return "1.5+2.25"
	}
	if !addOk32(1.0, -1.0) {
		return "1-1"
	}
	if !addOk32(3.0, -1.0) {
		return "3-1"
	}
	if !addOk32(0.1, 0.2) {
		return "0.1+0.2"
	}
	if !addOk32(10000000000.0, 0.0000000001) {
		return "1e10+1e-10"
	}
	if !addOk32(1.0, -0.99999994) {
		return "cancellation"
	}
	if !addOk32(0.0, 0.0) {
		return "0+0"
	}
	if !addOk32(-0.0, 0.0) {
		return "-0+0"
	}
	if !addOk32(-0.0, -0.0) {
		return "-0+-0"
	}
	if !addOk32(123456.789, -0.000789) {
		return "mixed"
	}
	return ""
}

func subOk32(fa float32, fb float32) bool {
	return F32Sub(bit_cast(uint32, fa), bit_cast(uint32, fb)) == bit_cast(uint32, fa - fb)
}

func TestF32SubRsub() testing.TestResult {
	if !subOk32(3.0, 1.0) {
		return "3-1"
	}
	if !subOk32(1.0, 3.0) {
		return "1-3"
	}
	if !subOk32(0.1, 0.2) {
		return "0.1-0.2"
	}
	if F32Rsub(bit_cast(uint32, cast(float32, 3.0)), bit_cast(uint32, cast(float32, 1.0))) !=
			bit_cast(uint32, cast(float32, 1.0 - 3.0)) {
		return "rsub 3,1 -> -2"
	}
	return ""
}

func TestIntToF32() testing.TestResult {
	if I32ToF32(0) != 0 {
		return "i2f 0"
	}
	if I32ToF32(1) != bit_cast(uint32, cast(float32, 1)) {
		return "i2f 1"
	}
	if I32ToF32(-42) != bit_cast(uint32, cast(float32, -42)) {
		return "i2f -42"
	}
	if I32ToF32(16777217) != bit_cast(uint32, cast(float32, 16777217)) {
		return "i2f 2^24+1 (rounds)"
	}
	if I32ToF32(-2147483648) != bit_cast(uint32, cast(float32, -2147483648)) {
		return "i2f INT32_MIN"
	}
	if U32ToF32(0xFFFFFFFF) != bit_cast(uint32, cast(float32, cast(uint32, 0xFFFFFFFF))) {
		return "ui2f UINT32_MAX (rounds)"
	}
	if I64ToF32(0) != 0 {
		return "l2f 0"
	}
	if I64ToF32(1234567890123) != bit_cast(uint32, cast(float32, cast(int64, 1234567890123))) {
		return "l2f big (rounds)"
	}
	if I64ToF32(-9223372036854775807 - 1) !=
			bit_cast(uint32, cast(float32, cast(int64, -9223372036854775807 - 1))) {
		return "l2f INT64_MIN"
	}
	if U64ToF32(0xFFFFFFFFFFFFFFFF) !=
			bit_cast(uint32, cast(float32, cast(uint64, 0xFFFFFFFFFFFFFFFF))) {
		return "ul2f UINT64_MAX (rounds)"
	}
	return ""
}

// mulOk32 compares F32Mul's bits to the host FPU's a*b (the oracle).
func mulOk32(fa float32, fb float32) bool {
	return F32Mul(bit_cast(uint32, fa), bit_cast(uint32, fb)) == bit_cast(uint32, fa * fb)
}

func TestF32Mul() testing.TestResult {
	if !mulOk32(1.0, 1.0) {
		return "1*1"
	}
	if !mulOk32(2.0, 3.0) {
		return "2*3"
	}
	if !mulOk32(1.5, 2.25) {
		return "1.5*2.25"
	}
	if !mulOk32(-2.0, 3.0) {
		return "-2*3"
	}
	if !mulOk32(0.1, 0.1) {
		return "0.1*0.1"
	}
	if !mulOk32(1000000.0, 1000000.0) {
		return "1e6*1e6"
	}
	if !mulOk32(0.0, 5.0) {
		return "0*5"
	}
	if !mulOk32(-0.0, 5.0) {
		return "-0*5"
	}
	if !mulOk32(3.14159, 2.71828) {
		return "pi*e"
	}
	if !mulOk32(1.0e-30, 1.0e-30) {
		return "underflow to denormal/0"
	}
	if !mulOk32(1.0e30, 1.0e30) {
		return "overflow to inf"
	}
	return ""
}

// divOk32 compares F32Div's bits to the host FPU's a/b (the oracle).
func divOk32(fa float32, fb float32) bool {
	return F32Div(bit_cast(uint32, fa), bit_cast(uint32, fb)) == bit_cast(uint32, fa / fb)
}

func TestF32Div() testing.TestResult {
	if !divOk32(1.0, 1.0) {
		return "1/1"
	}
	if !divOk32(6.0, 3.0) {
		return "6/3"
	}
	if !divOk32(1.0, 3.0) {
		return "1/3 (rounds)"
	}
	if !divOk32(1.0, 7.0) {
		return "1/7 (rounds)"
	}
	if !divOk32(-10.0, 4.0) {
		return "-10/4"
	}
	if !divOk32(0.1, 0.3) {
		return "0.1/0.3"
	}
	if !divOk32(0.0, 5.0) {
		return "0/5"
	}
	if !divOk32(5.0, 0.0) {
		return "5/0 -> inf"
	}
	if !divOk32(-5.0, 0.0) {
		return "-5/0 -> -inf"
	}
	if !divOk32(1.0e30, 1.0e-30) {
		return "overflow to inf"
	}
	if !divOk32(1.0e-30, 1.0e30) {
		return "underflow to denormal/0"
	}
	if !divOk32(123456.789, 0.000789) {
		return "mixed"
	}
	return ""
}
