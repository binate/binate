// IEEE-754 binary64 soft-float: multiplication and division, in pure Binate
// (integer bit-manipulation on uint32 / uint64).  The f64 add/convert routines
// and the shared clz helpers live in softfloat.bn.
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  F64Mul follows fp_mul_impl.inc
// (DOUBLE_PRECISION); F64Div follows fp_div_impl.inc as configured by divdf3.c
// (3 half-width + 1 emulated full-width Newton-Raphson iterations, no uint128).
package "pkg/builtins/softfloat"

// wideMultiply64 computes the 128-bit product of two uint64 values, returned as
// a (hi, lo) uint64 pair.  Built from four 32x32->64 partial products
// (compiler-rt fp_lib.h DOUBLE_PRECISION wideMultiply), since Binate has no
// 128-bit integer type.
func wideMultiply64(a uint64, b uint64) (uint64, uint64) {
	var aLo uint64 = a & 0xFFFFFFFF
	var aHi uint64 = a >> 32
	var bLo uint64 = b & 0xFFFFFFFF
	var bHi uint64 = b >> 32
	var plolo uint64 = aLo * bLo
	var plohi uint64 = aLo * bHi
	var philo uint64 = aHi * bLo
	var phihi uint64 = aHi * bHi
	var r0 uint64 = plolo & 0xFFFFFFFF
	var r1 uint64 = (plolo >> 32) + (plohi & 0xFFFFFFFF) + (philo & 0xFFFFFFFF)
	var lo uint64 = r0 + (r1 << 32)
	var hi uint64 = (plohi >> 32) + (philo >> 32) + (r1 >> 32) + phihi
	return hi, lo
}

// F64Mul: IEEE-754 binary64 multiplication, round to nearest ties to even.
// Backs __aeabi_dmul.  Translated from compiler-rt fp_mul_impl.inc
// (DOUBLE_PRECISION).  significandBits 52, exponentBits 11, bias 1023,
// implicitBit 1<<52.
func F64Mul(a uint64, b uint64) uint64 {
	var aExponent uint64 = (a >> 52) & 0x7FF
	var bExponent uint64 = (b >> 52) & 0x7FF
	var productSign uint64 = (a ^ b) & 0x8000000000000000
	var aSignificand uint64 = a & 0xFFFFFFFFFFFFF
	var bSignificand uint64 = b & 0xFFFFFFFFFFFFF
	var scale int = 0

	// Zero / denormal / infinity / NaN (maxExponent-1 = 2046; unsigned wrap
	// catches exponent 0 too).
	if aExponent - 1 >= 2046 || bExponent - 1 >= 2046 {
		var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
		var bAbs uint64 = b & 0x7FFFFFFFFFFFFFFF
		if aAbs > 0x7FF0000000000000 {
			return a | 0x8000000000000 // NaN * anything = qNaN
		}
		if bAbs > 0x7FF0000000000000 {
			return b | 0x8000000000000
		}
		if aAbs == 0x7FF0000000000000 {
			if bAbs != 0 {
				return aAbs | productSign // inf * nonzero = inf
			}
			return 0x7FF8000000000000 // inf * 0 = qNaN
		}
		if bAbs == 0x7FF0000000000000 {
			if aAbs != 0 {
				return bAbs | productSign
			}
			return 0x7FF8000000000000
		}
		if aAbs == 0 {
			return productSign // 0 * anything = +/-0
		}
		if bAbs == 0 {
			return productSign
		}
		if aAbs < 0x10000000000000 {
			var adj int
			aSignificand, adj = normalize64(aSignificand)
			scale = scale + adj
		}
		if bAbs < 0x10000000000000 {
			var adj int
			bSignificand, adj = normalize64(bSignificand)
			scale = scale + adj
		}
	}

	aSignificand = aSignificand | 0x10000000000000
	bSignificand = bSignificand | 0x10000000000000

	// wideMultiply64(aSignificand, bSignificand << exponentBits(=11)).
	var productHi uint64
	var productLo uint64
	productHi, productLo = wideMultiply64(aSignificand, bSignificand << 11)

	var productExponent int = cast(int, aExponent) + cast(int, bExponent) - 1023 + scale

	if (productHi & 0x10000000000000) != 0 {
		productExponent = productExponent + 1
	} else {
		// wideLeftShift(&productHi, &productLo, 1)
		productHi = (productHi << 1) | (productLo >> 63)
		productLo = productLo << 1
	}

	if productExponent >= 2047 {
		return 0x7FF0000000000000 | productSign
	}

	if productExponent <= 0 {
		var shift uint64 = cast(uint64, 1 - productExponent)
		if shift >= 64 {
			return productSign
		}
		// wideRightShiftWithSticky(&productHi, &productLo, shift); count < 64.
		var sticky uint64 = 0
		if (productLo << cast(uint64, 64 - shift)) != 0 {
			sticky = 1
		}
		productLo = (productHi << cast(uint64, 64 - shift)) | (productLo >> shift) | sticky
		productHi = productHi >> shift
	} else {
		productHi = productHi & 0xFFFFFFFFFFFFF
		productHi = productHi | (cast(uint64, productExponent) << 52)
	}

	productHi = productHi | productSign
	// Round to nearest, ties to even (signBit = 1<<63 = the round bit).
	if productLo > 0x8000000000000000 {
		productHi = productHi + 1
	}
	if productLo == 0x8000000000000000 {
		productHi = productHi + (productHi & 1)
	}
	return productHi
}

// F64Div: IEEE-754 binary64 division, round to nearest ties to even.  Backs
// __aeabi_ddiv.  Translated from compiler-rt fp_div_impl.inc as configured by
// divdf3.c (DOUBLE_PRECISION, 3 half-width + 1 emulated full-width
// Newton-Raphson reciprocal iterations, RECIPROCAL_PRECISION = 220).  HW = 32,
// so the half-width reciprocal state is a uint32 (half_rep_t); every store into
// it truncates to 32 bits — reproduced here with explicit cast(uint32, ...).
// The single full-width iteration is emulated with the ad-hoc split multiply
// (compiler-rt's non-USE_NATIVE path), so no uint128 is needed.
func F64Div(a uint64, b uint64) uint64 {
	var aExponent uint64 = (a >> 52) & 0x7FF
	var bExponent uint64 = (b >> 52) & 0x7FF
	var quotientSign uint64 = (a ^ b) & 0x8000000000000000
	var aSignificand uint64 = a & 0xFFFFFFFFFFFFF
	var bSignificand uint64 = b & 0xFFFFFFFFFFFFF
	var scale int = 0

	if aExponent - 1 >= 2046 || bExponent - 1 >= 2046 {
		var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
		var bAbs uint64 = b & 0x7FFFFFFFFFFFFFFF
		if aAbs > 0x7FF0000000000000 {
			return a | 0x8000000000000 // NaN / anything = qNaN
		}
		if bAbs > 0x7FF0000000000000 {
			return b | 0x8000000000000
		}
		if aAbs == 0x7FF0000000000000 {
			if bAbs == 0x7FF0000000000000 {
				return 0x7FF8000000000000 // inf / inf = qNaN
			}
			return aAbs | quotientSign // inf / finite = inf
		}
		if bAbs == 0x7FF0000000000000 {
			return quotientSign // finite / inf = +/-0
		}
		if aAbs == 0 {
			if bAbs == 0 {
				return 0x7FF8000000000000 // 0 / 0 = qNaN
			}
			return quotientSign // 0 / finite = +/-0
		}
		if bAbs == 0 {
			return 0x7FF0000000000000 | quotientSign // finite / 0 = inf
		}
		if aAbs < 0x10000000000000 {
			var adj int
			aSignificand, adj = normalize64(aSignificand)
			scale = scale + adj
		}
		if bAbs < 0x10000000000000 {
			var adj int
			bSignificand, adj = normalize64(bSignificand)
			scale = scale - adj
		}
	}

	aSignificand = aSignificand | 0x10000000000000
	bSignificand = bSignificand | 0x10000000000000
	var writtenExponent int = cast(int, aExponent) - cast(int, bExponent) + scale + 1023

	// b as UQ1.(W-1): shift by typeWidth - significandBits - 1 = 11.
	var b_UQ1 uint64 = bSignificand << 11

	// Half-width reciprocal state (HW = 32).  b_hw = top bits of b as UQ1.(HW-1).
	var b_UQ1_hw uint32 = cast(uint32, bSignificand >> 21) // significandBits + 1 - HW = 21
	// Seed x0 = C_hw - b_hw/2, C_hw = (3/4 + 1/sqrt(2))-1 as UQ0.HW.
	var x_UQ0_hw uint32 = 0x7504F333 - b_UQ1_hw

	// Three half-width Newton-Raphson iterations (each store truncates to 32 bits).
	for i := 0; i < 3; i++ {
		var corr_UQ1_hw uint32 = cast(uint32, cast(uint64, 0) -
				((cast(uint64, x_UQ0_hw) * cast(uint64, b_UQ1_hw)) >> 32))
		x_UQ0_hw = cast(uint32, (cast(uint64, x_UQ0_hw) * cast(uint64, corr_UQ1_hw)) >> 31)
	}
	x_UQ0_hw = x_UQ0_hw - 1
	var x_UQ0 uint64 = cast(uint64, x_UQ0_hw) << 32
	x_UQ0 = x_UQ0 - 1

	// One emulated full-width iteration via the ad-hoc split multiply (avoids a
	// uint128): reassigns x_UQ0 from the half-width x_UQ0_hw and b_UQ1.
	var blo uint64 = b_UQ1 & 0xFFFFFFFF
	var corr_UQ1 uint64 = cast(uint64, 0) -
			(cast(uint64, x_UQ0_hw) * cast(uint64, b_UQ1_hw) + ((cast(uint64, x_UQ0_hw) * blo) >> 32) - 1)
	var lo_corr uint64 = corr_UQ1 & 0xFFFFFFFF
	var hi_corr uint64 = corr_UQ1 >> 32
	x_UQ0 = ((cast(uint64, x_UQ0_hw) * hi_corr) << 1) + ((cast(uint64, x_UQ0_hw) * lo_corr) >> 31) - 2
	x_UQ0 = x_UQ0 - 1

	x_UQ0 = x_UQ0 - 2 // account for possible overflow
	x_UQ0 = x_UQ0 - 220 // RECIPROCAL_PRECISION for the (3 half + 1 full) config

	// quotient = x_UQ0 * (a<<1), high half (wideMultiply64).
	var quotient_UQ1 uint64
	var dummy uint64
	quotient_UQ1, dummy = wideMultiply64(x_UQ0, aSignificand << 1)

	var residualLo uint64 = 0
	if quotient_UQ1 < 0x20000000000000 {
		// implicitBit << 1
		if quotient_UQ1 < 0x10000000000000 {
			quotient_UQ1 = quotient_UQ1 << 1
			writtenExponent = writtenExponent - 1
		}
		residualLo = (aSignificand << 53) - quotient_UQ1 * bSignificand
		writtenExponent = writtenExponent - 1
		aSignificand = aSignificand << 1
	} else {
		quotient_UQ1 = quotient_UQ1 >> 1
		residualLo = (aSignificand << 52) - quotient_UQ1 * bSignificand
	}

	if writtenExponent >= 2047 {
		return 0x7FF0000000000000 | quotientSign
	}

	var absResult uint64 = 0
	if writtenExponent > 0 {
		absResult = quotient_UQ1 & 0xFFFFFFFFFFFFF
		absResult = absResult | (cast(uint64, writtenExponent) << 52)
		residualLo = residualLo << 1
	} else {
		if 52 + writtenExponent < 0 {
			return quotientSign
		}
		absResult = quotient_UQ1 >> cast(uint64, -writtenExponent + 1)
		residualLo = (aSignificand << cast(uint64, 52 + writtenExponent)) -
				((absResult * bSignificand) << 1)
	}

	// Round: tie to even, then one NextAfter if the residual exceeds the divisor.
	residualLo = residualLo + (absResult & 1)
	if residualLo > bSignificand {
		absResult = absResult + 1
	}
	return absResult | quotientSign
}
