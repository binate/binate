// Differential tests for the binary64 mul/div routines against the host FPU.
// Host-only (the bare-metal target runs no host unit tests).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/softfloat"

import "pkg/builtins/testing"

// mulOk64 compares F64Mul's bits to the host FPU's a*b (the oracle).
func mulOk64(fa float64, fb float64) bool {
	return F64Mul(bit_cast(uint64, fa), bit_cast(uint64, fb)) == bit_cast(uint64, fa * fb)
}

func TestF64Mul() testing.TestResult {
	if !mulOk64(1.0, 1.0) {
		return "1*1"
	}
	if !mulOk64(2.0, 3.0) {
		return "2*3"
	}
	if !mulOk64(1.5, 2.25) {
		return "1.5*2.25"
	}
	if !mulOk64(-2.0, 3.0) {
		return "-2*3"
	}
	if !mulOk64(0.1, 0.1) {
		return "0.1*0.1"
	}
	if !mulOk64(1000000000.0, 1000000000.0) {
		return "1e9*1e9"
	}
	if !mulOk64(0.0, 5.0) {
		return "0*5"
	}
	if !mulOk64(-0.0, 5.0) {
		return "-0*5"
	}
	if !mulOk64(3.141592653589793, 2.718281828459045) {
		return "pi*e"
	}
	if !mulOk64(1.0e-300, 1.0e-300) {
		return "underflow to denormal/0"
	}
	if !mulOk64(1.0e300, 1.0e300) {
		return "overflow to inf"
	}
	return ""
}

// divOk64 compares F64Div's bits to the host FPU's a/b (the oracle).
func divOk64(fa float64, fb float64) bool {
	return F64Div(bit_cast(uint64, fa), bit_cast(uint64, fb)) == bit_cast(uint64, fa / fb)
}

func TestF64Div() testing.TestResult {
	if !divOk64(1.0, 1.0) {
		return "1/1"
	}
	if !divOk64(6.0, 3.0) {
		return "6/3"
	}
	if !divOk64(1.0, 3.0) {
		return "1/3 (rounds)"
	}
	if !divOk64(1.0, 7.0) {
		return "1/7 (rounds)"
	}
	if !divOk64(-10.0, 4.0) {
		return "-10/4"
	}
	if !divOk64(0.1, 0.3) {
		return "0.1/0.3"
	}
	if !divOk64(0.0, 5.0) {
		return "0/5"
	}
	if !divOk64(5.0, 0.0) {
		return "5/0 -> inf"
	}
	if !divOk64(-5.0, 0.0) {
		return "-5/0 -> -inf"
	}
	if !divOk64(1.0e300, 1.0e-300) {
		return "overflow to inf"
	}
	if !divOk64(1.0e-300, 1.0e300) {
		return "underflow to denormal/0"
	}
	if !divOk64(123456789.123456, 0.000000789) {
		return "mixed"
	}
	return ""
}
