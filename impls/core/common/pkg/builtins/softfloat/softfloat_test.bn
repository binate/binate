// Differential tests for the soft-float routines against known IEEE-754 bit
// patterns.  Host-only (the bare-metal target runs no host unit tests).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/softfloat"

import "pkg/builtins/testing"

func TestF32ToF64() testing.TestResult {
	if F32ToF64(0x3F800000) != 0x3FF0000000000000 {
		return "1.0"
	}
	if F32ToF64(0x40000000) != 0x4000000000000000 {
		return "2.0"
	}
	if F32ToF64(0x3F000000) != 0x3FE0000000000000 {
		return "0.5"
	}
	if F32ToF64(0xBFC00000) != 0xBFF8000000000000 {
		return "-1.5"
	}
	if F32ToF64(0x00000000) != 0x0000000000000000 {
		return "+0"
	}
	if F32ToF64(0x80000000) != 0x8000000000000000 {
		return "-0"
	}
	if F32ToF64(0x7F800000) != 0x7FF0000000000000 {
		return "+inf"
	}
	if F32ToF64(0x00800000) != 0x3810000000000000 {
		return "min-normal"
	}
	if F32ToF64(0x00000001) != 0x36A0000000000000 {
		return "min-denormal"
	}
	if F32ToF64(0x7FC00000) != 0x7FF8000000000000 {
		return "qNaN"
	}
	return ""
}

func TestF64ToI32() testing.TestResult {
	if F64ToI32(0x0000000000000000) != 0 {
		return "0.0"
	}
	if F64ToI32(0x3FF0000000000000) != 1 {
		return "1.0"
	}
	if F64ToI32(0x4045000000000000) != 42 {
		return "42.0"
	}
	if F64ToI32(0xC045000000000000) != -42 {
		return "-42.0"
	}
	if F64ToI32(0x400C000000000000) != 3 {
		return "3.5->3"
	}
	if F64ToI32(0xC00C000000000000) != -3 {
		return "-3.5->-3"
	}
	if F64ToI32(0x3FE0000000000000) != 0 {
		return "0.5->0"
	}
	if F64ToI32(0x4090000000000000) != 1024 {
		return "1024.0"
	}
	if F64ToI32(0x7FF0000000000000) != 2147483647 {
		return "+inf->INT32_MAX"
	}
	if F64ToI32(0xFFF0000000000000) != -2147483647 - 1 {
		return "-inf->INT32_MIN"
	}
	return ""
}

func TestF64ToF32() testing.TestResult {
	if F64ToF32(0x3FF0000000000000) != 0x3F800000 {
		return "1.0"
	}
	if F64ToF32(0x4000000000000000) != 0x40000000 {
		return "2.0"
	}
	if F64ToF32(0x3FE0000000000000) != 0x3F000000 {
		return "0.5"
	}
	if F64ToF32(0xBFF8000000000000) != 0xBFC00000 {
		return "-1.5"
	}
	if F64ToF32(0x0000000000000000) != 0x00000000 {
		return "+0"
	}
	if F64ToF32(0x8000000000000000) != 0x80000000 {
		return "-0"
	}
	if F64ToF32(0x7FF0000000000000) != 0x7F800000 {
		return "+inf"
	}
	if F64ToF32(0xFFF0000000000000) != 0xFF800000 {
		return "-inf"
	}
	if F64ToF32(0x7FF8000000000000) != 0x7FC00000 {
		return "qNaN"
	}
	if F64ToF32(0x3FF0000010000000) != 0x3F800000 {
		return "round-half-to-even -> 1.0"
	}
	if F64ToF32(0x7FE0000000000000) != 0x7F800000 {
		return "overflow -> +inf"
	}
	if F64ToF32(0x3800000000000000) != 0x00400000 {
		return "underflow -> denormal 2^-127"
	}
	if F64ToF32(0x3690000000000000) != 0x00000000 {
		return "underflow 2^-150 -> +0"
	}
	return ""
}

// addOk compares F64Add's bits to the host FPU's a+b (the oracle).
func addOk(fa float64, fb float64) bool {
	return F64Add(bit_cast(uint64, fa), bit_cast(uint64, fb)) == bit_cast(uint64, fa + fb)
}

func TestF64Add() testing.TestResult {
	if !addOk(1.0, 1.0) {
		return "1+1"
	}
	if !addOk(1.0, 2.0) {
		return "1+2"
	}
	if !addOk(1.5, 2.25) {
		return "1.5+2.25"
	}
	if !addOk(1.0, -1.0) {
		return "1-1"
	}
	if !addOk(3.0, -1.0) {
		return "3-1"
	}
	if !addOk(0.1, 0.2) {
		return "0.1+0.2"
	}
	if !addOk(10000000000.0, 0.0000000001) {
		return "1e10+1e-10"
	}
	if !addOk(1.0, -0.9999999999) {
		return "cancellation"
	}
	if !addOk(0.0, 0.0) {
		return "0+0"
	}
	if !addOk(-0.0, 0.0) {
		return "-0+0"
	}
	if !addOk(-0.0, -0.0) {
		return "-0+-0"
	}
	if !addOk(123456.789, -0.000789) {
		return "mixed"
	}
	return ""
}

func subOk(fa float64, fb float64) bool {
	return F64Sub(bit_cast(uint64, fa), bit_cast(uint64, fb)) == bit_cast(uint64, fa - fb)
}

func TestF64SubRsub() testing.TestResult {
	if !subOk(3.0, 1.0) {
		return "3-1"
	}
	if !subOk(1.0, 3.0) {
		return "1-3"
	}
	if !subOk(0.1, 0.2) {
		return "0.1-0.2"
	}
	if F64Rsub(bit_cast(uint64, 3.0), bit_cast(uint64, 1.0)) != bit_cast(uint64, 1.0 - 3.0) {
		return "rsub 3,1 -> -2"
	}
	return ""
}

func TestIntToF64() testing.TestResult {
	if I32ToF64(0) != 0 {
		return "i2d 0"
	}
	if I32ToF64(1) != bit_cast(uint64, cast(float64, 1)) {
		return "i2d 1"
	}
	if I32ToF64(-42) != bit_cast(uint64, cast(float64, -42)) {
		return "i2d -42"
	}
	if I32ToF64(-2147483648) != bit_cast(uint64, cast(float64, -2147483648)) {
		return "i2d INT32_MIN"
	}
	if U32ToF64(0xFFFFFFFF) != bit_cast(uint64, cast(float64, cast(uint32, 0xFFFFFFFF))) {
		return "ui2d UINT32_MAX"
	}
	if I64ToF64(0) != 0 {
		return "l2d 0"
	}
	if I64ToF64(1) != bit_cast(uint64, cast(float64, cast(int64, 1))) {
		return "l2d 1"
	}
	if I64ToF64(1234567890123) != bit_cast(uint64, cast(float64, cast(int64, 1234567890123))) {
		return "l2d big (rounds)"
	}
	if I64ToF64(-9223372036854775807 - 1) !=
			bit_cast(uint64, cast(float64, cast(int64, -9223372036854775807 - 1))) {
		return "l2d INT64_MIN"
	}
	if U64ToF64(0xFFFFFFFFFFFFFFFF) !=
			bit_cast(uint64, cast(float64, cast(uint64, 0xFFFFFFFFFFFFFFFF))) {
		return "ul2d UINT64_MAX (rounds)"
	}
	return ""
}
