// IEEE-754 float -> integer conversions (round toward zero) in pure Binate,
// backing the ARM-EABI __aeabi_{d,f}2{i,ui,l,ul}z helpers.
//
// Derived from LLVM compiler-rt (compiler-rt/lib/builtins, Apache-2.0 WITH
// LLVM-exception); reimplemented in Binate.  Signed variants follow
// fp_fixint_impl.inc (__fixint), unsigned follow fp_fixuint_impl.inc
// (__fixuint).  The compiler guards saturation, +/-Inf, and NaN upstream in
// shared IR-gen (emitGuardedFloatToInt), so these helpers are only invoked for
// in-range finite values; the saturation branches below are kept for fidelity
// with compiler-rt (and match what libgcc did) but are not relied upon.
package "pkg/builtins/softfloat"

// F64ToI32: binary64 -> int32, round toward zero.  Backs __aeabi_d2iz.
func F64ToI32(a uint64) int {
	var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
	var neg bool = (a & 0x8000000000000000) != 0
	var exponent int = cast(int, aAbs >> 52) - 1023
	if exponent < 0 {
		return 0
	}
	if exponent >= 32 {
		if neg {
			return -2147483647 - 1 // INT32_MIN
		}
		return 0x7FFFFFFF // INT32_MAX
	}
	// exponent < 32 <= significandBits (52): always a right shift.
	var significand uint64 = (aAbs & 0xFFFFFFFFFFFFF) | 0x10000000000000
	var mag uint64 = significand >> cast(uint64, 52 - exponent)
	if neg {
		return -cast(int, mag)
	}
	return cast(int, mag)
}

// F64ToU32: binary64 -> uint32, round toward zero.  Backs __aeabi_d2uiz.
func F64ToU32(a uint64) uint32 {
	var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
	var neg bool = (a & 0x8000000000000000) != 0
	var exponent int = cast(int, aAbs >> 52) - 1023
	if neg || exponent < 0 {
		return 0
	}
	if exponent >= 32 {
		return 0xFFFFFFFF
	}
	// 32 <= significandBits (52): always a right shift.
	var significand uint64 = (aAbs & 0xFFFFFFFFFFFFF) | 0x10000000000000
	return cast(uint32, significand >> cast(uint64, 52 - exponent))
}

// F64ToI64: binary64 -> int64, round toward zero.  Backs __aeabi_d2lz.
func F64ToI64(a uint64) int64 {
	var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
	var neg bool = (a & 0x8000000000000000) != 0
	var exponent int = cast(int, aAbs >> 52) - 1023
	if exponent < 0 {
		return 0
	}
	if exponent >= 64 {
		if neg {
			return -9223372036854775807 - 1 // INT64_MIN
		}
		return 9223372036854775807 // INT64_MAX
	}
	var significand uint64 = (aAbs & 0xFFFFFFFFFFFFF) | 0x10000000000000
	var mag uint64
	if exponent < 52 {
		mag = significand >> cast(uint64, 52 - exponent)
	} else {
		mag = significand << cast(uint64, exponent - 52)
	}
	if neg {
		return -cast(int64, mag)
	}
	return cast(int64, mag)
}

// F64ToU64: binary64 -> uint64, round toward zero.  Backs __aeabi_d2ulz.
func F64ToU64(a uint64) uint64 {
	var aAbs uint64 = a & 0x7FFFFFFFFFFFFFFF
	var neg bool = (a & 0x8000000000000000) != 0
	var exponent int = cast(int, aAbs >> 52) - 1023
	if neg || exponent < 0 {
		return 0
	}
	if exponent >= 64 {
		return 0xFFFFFFFFFFFFFFFF
	}
	var significand uint64 = (aAbs & 0xFFFFFFFFFFFFF) | 0x10000000000000
	if exponent < 52 {
		return significand >> cast(uint64, 52 - exponent)
	}
	return significand << cast(uint64, exponent - 52)
}

// F32ToI32: binary32 -> int32, round toward zero.  Backs __aeabi_f2iz.
func F32ToI32(a uint32) int32 {
	var aAbs uint32 = a & 0x7FFFFFFF
	var neg bool = (a & 0x80000000) != 0
	var exponent int = cast(int, aAbs >> 23) - 127
	if exponent < 0 {
		return 0
	}
	if exponent >= 32 {
		if neg {
			return -2147483647 - 1
		}
		return 0x7FFFFFFF
	}
	var significand uint32 = (aAbs & 0x7FFFFF) | 0x800000
	var mag uint32
	if exponent < 23 {
		mag = significand >> cast(uint32, 23 - exponent)
	} else {
		mag = significand << cast(uint32, exponent - 23)
	}
	if neg {
		return -cast(int32, mag)
	}
	return cast(int32, mag)
}

// F32ToU32: binary32 -> uint32, round toward zero.  Backs __aeabi_f2uiz.
func F32ToU32(a uint32) uint32 {
	var aAbs uint32 = a & 0x7FFFFFFF
	var neg bool = (a & 0x80000000) != 0
	var exponent int = cast(int, aAbs >> 23) - 127
	if neg || exponent < 0 {
		return 0
	}
	if exponent >= 32 {
		return 0xFFFFFFFF
	}
	var significand uint32 = (aAbs & 0x7FFFFF) | 0x800000
	if exponent < 23 {
		return significand >> cast(uint32, 23 - exponent)
	}
	return significand << cast(uint32, exponent - 23)
}

// F32ToI64: binary32 -> int64, round toward zero.  Backs __aeabi_f2lz.
func F32ToI64(a uint32) int64 {
	var aAbs uint32 = a & 0x7FFFFFFF
	var neg bool = (a & 0x80000000) != 0
	var exponent int = cast(int, aAbs >> 23) - 127
	if exponent < 0 {
		return 0
	}
	if exponent >= 64 {
		if neg {
			return -9223372036854775807 - 1
		}
		return 9223372036854775807
	}
	var significand uint64 = cast(uint64, (aAbs & 0x7FFFFF) | 0x800000)
	var mag uint64
	if exponent < 23 {
		mag = significand >> cast(uint64, 23 - exponent)
	} else {
		mag = significand << cast(uint64, exponent - 23)
	}
	if neg {
		return -cast(int64, mag)
	}
	return cast(int64, mag)
}

// F32ToU64: binary32 -> uint64, round toward zero.  Backs __aeabi_f2ulz.
func F32ToU64(a uint32) uint64 {
	var aAbs uint32 = a & 0x7FFFFFFF
	var neg bool = (a & 0x80000000) != 0
	var exponent int = cast(int, aAbs >> 23) - 127
	if neg || exponent < 0 {
		return 0
	}
	if exponent >= 64 {
		return 0xFFFFFFFFFFFFFFFF
	}
	var significand uint64 = cast(uint64, (aAbs & 0x7FFFFF) | 0x800000)
	if exponent < 23 {
		return significand >> cast(uint64, 23 - exponent)
	}
	return significand << cast(uint64, exponent - 23)
