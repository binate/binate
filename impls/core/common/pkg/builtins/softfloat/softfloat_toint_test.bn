// Differential tests for the float -> integer conversions against the host's
// (in-range) float-to-int casts.  Only in-range finite values are tested: the
// compiler guards saturation/NaN upstream (emitGuardedFloatToInt), so the raw
// helpers are only ever called with in-range values, where they must agree
// with a plain cast.  Host-only (the bare-metal target runs no host tests).
#[build(!is(os, "baremetal"))]
package "pkg/builtins/softfloat"

import "pkg/builtins/testing"

func TestF64ToU32() testing.TestResult {
	if F64ToU32(bit_cast(uint64, 0.0)) != cast(uint32, cast(float64, 0)) {
		return "0"
	}
	if F64ToU32(bit_cast(uint64, 100.9)) != cast(uint32, 100.9) {
		return "100.9 -> 100"
	}
	if F64ToU32(bit_cast(uint64, 4000000000.5)) != cast(uint32, 4000000000.5) {
		return "4e9 (> INT32_MAX, < UINT32_MAX)"
	}
	return ""
}

func TestF64ToI64() testing.TestResult {
	if F64ToI64(bit_cast(uint64, 7500000000.9)) != cast(int64, 7500000000.9) {
		return "7.5e9 -> trunc"
	}
	if F64ToI64(bit_cast(uint64, 0.0 - 5000000000.9)) != cast(int64, 0.0 - 5000000000.9) {
		return "-5e9 -> trunc"
	}
	if F64ToI64(bit_cast(uint64, 123.0)) != cast(int64, cast(float64, 123)) {
		return "123"
	}
	return ""
}

func TestF64ToU64() testing.TestResult {
	if F64ToU64(bit_cast(uint64, 12000000000.5)) != cast(uint64, 12000000000.5) {
		return "1.2e10"
	}
	if F64ToU64(bit_cast(uint64, 1.0e19)) != cast(uint64, 1.0e19) {
		return "1e19 (> INT64_MAX, < UINT64_MAX)"
	}
	if F64ToU64(bit_cast(uint64, 0.0)) != 0 {
		return "0"
	}
	return ""
}

func TestF32ToI32() testing.TestResult {
	if F32ToI32(bit_cast(uint32, cast(float32, 100.9))) != cast(int32, cast(float32, 100.9)) {
		return "100.9"
	}
	if F32ToI32(bit_cast(uint32, cast(float32, -100.9))) != cast(int32, cast(float32, -100.9)) {
		return "-100.9"
	}
	if F32ToI32(bit_cast(uint32, cast(float32, 2000000000.0))) !=
			cast(int32, cast(float32, 2000000000.0)) {
		return "2e9"
	}
	return ""
}

func TestF32ToU32() testing.TestResult {
	if F32ToU32(bit_cast(uint32, cast(float32, 100.9))) != cast(uint32, cast(float32, 100.9)) {
		return "100.9"
	}
	if F32ToU32(bit_cast(uint32, cast(float32, 4000000000.0))) !=
			cast(uint32, cast(float32, 4000000000.0)) {
		return "4e9"
	}
	return ""
}

func TestF32ToI64() testing.TestResult {
	if F32ToI64(bit_cast(uint32, cast(float32, 300000.0))) != cast(int64, cast(float32, 300000.0)) {
		return "300000"
	}
	if F32ToI64(bit_cast(uint32, cast(float32, -300000.0))) != cast(int64, cast(float32, -300000.0)) {
		return "-300000"
	}
	if F32ToI64(bit_cast(uint32, cast(float32, 1048576.0))) != cast(int64, cast(float32, 1048576.0)) {
		return "2^20"
	}
	return ""
}

func TestF32ToU64() testing.TestResult {
	if F32ToU64(bit_cast(uint32, cast(float32, 300000.0))) != cast(uint64, cast(float32, 300000.0)) {
		return "300000"
	}
	if F32ToU64(bit_cast(uint32, cast(float32, 1.0e18))) != cast(uint64, cast(float32, 1.0e18)) {
		return "1e18"
	}
	return ""
}
