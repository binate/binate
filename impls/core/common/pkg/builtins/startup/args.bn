// Command-line arguments — startup glue.  Argv lives here (not in pkg/std/os)
// because it is an entry/startup concern: os.Args()/os.SetArgs() delegate to the
// exported startup.Args()/startup.SetArgs (os imports startup).
//
// The `args` cell has NO initializer, deliberately: the hosted entry `_entry`
// (args_main.bn) runs BEFORE bn_entry — hence before package __init — and installs
// the real argv via SetArgs, so an initializer here would run afterward (in
// __init) and clobber it.  A bare-metal image (entrypoint "start") and a --library
// build (entrypoint "init") have no entry that installs argv, so os.Args() is
// empty for them until a caller sets one via os.SetArgs.  See design-ffi-export.md
// §3.3 / plan-build-version-predicate.md.
package "pkg/builtins/startup"

// args holds the process command-line arguments, shaped like Go's os.Args:
// element 0 the program name, elements 1.. the arguments.  Empty (the zero-value
// slice) until an entry installs it via SetArgs — the hosted _entry does, from the
// real argv.  Private: os.Args()/os.SetArgs() reach it through the Args()/SetArgs
// accessors, not as a direct global read.
var args @[]readonly @[]readonly char

// Args returns the process command-line arguments, indexed like Go's os.Args:
// element 0 the program name, elements 1.. the arguments.  It hands back the one
// shared slice unchanged — empty by default, or whatever an entry / SetArgs last
// installed — safe to share because the type is fully readonly.
func Args() @[]readonly @[]readonly char {
	return args
}

// SetArgs replaces the arguments Args() returns and returns the PREVIOUS value, so
// they can be saved and restored: `old := SetArgs(new); …; SetArgs(old)` (the
// returned value flows straight back in).  newArgs is the whole argv — element 0
// the program name, 1.. the arguments — so the caller controls index 0.  It is the
// seam a bytecode interpreter (cmd/bni) uses to give an interpreted program its own
// argv (via os.SetArgs, since os is injected host-native), and the hosted entry
// uses it to install the real argv — see explorations/design-os-args-vm.md.
func SetArgs(newArgs @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	var prev @[]readonly @[]readonly char = args
	args = newArgs
	return prev
}
