// Command-line arguments — the first real content of the startup glue package.
// They live here (not in pkg/std/os) because argv is an entry/startup concern:
// os.Args()/os.SetArgs() now delegate to startup.Args/startup.SetArgs (os
// imports startup), and the eventual entry glue (the hosted `main`, which will
// set startup.Args from the real argv and retire bootstrap.Args) also lives
// here.  Not build-constrained: it rests entirely on bootstrap.Args(), which
// every target provides (the libc host captures the real argv in the C runtime's
// main; a bare-metal target, which has no command line, returns empty), so one
// definition serves all flavors.
package "pkg/builtins/startup"

import "pkg/bootstrap"

// Args holds the command-line arguments, shaped like Go's os.Args (element 0 the
// program name, elements 1.. the arguments).  Initialized at package init from
// bootstrap.Args() (argvWithProgName lays out the slice), and thereafter
// replaceable via SetArgs (or, in future, set directly by the entry glue).  Its
// readonly element type (@[]readonly @[]readonly char) means neither the slice
// nor the argument text it references can be mutated, so it is safe to hand the
// same shared slice to every caller (see os.Args); only a reassignment swaps it
// out.  A single empty element (the program-name placeholder) on a target with
// no command line.
//
// Exported (unlike the old os-private global) because os.Args() reads it across
// the package boundary and the future entry `main` sets it directly — it is the
// one shared cell the compiled program, the C runtime, and (via os's host-native
// injection) a bytecode-interpreted program all agree on.
var Args @[]readonly @[]readonly char = argvWithProgName(bootstrap.Args())

// SetArgs replaces Args and returns the PREVIOUS value, so a caller can save and
// later restore them:
//
//	old := startup.SetArgs(new)
//	// ... run with `new` visible via os.Args() ...
//	startup.SetArgs(old) // restore
//
// The value flows straight back in (both are @[]readonly @[]readonly char), so
// restore is symmetric.  `newArgs` is the whole argv — element 0 the program
// name, 1.. the arguments — so the caller controls index 0.
//
// This is the seam a bytecode interpreter (cmd/bni) uses to give an interpreted
// program its OWN arguments: os is injected into the VM as host-native code, so
// the interpreter's os.Args() and the interpreted program's os.Args() both reach
// this one shared `Args`; the interpreter calls SetArgs (through os.SetArgs)
// with the program's argv before running it (and, if it still needs its own,
// keeps the returned previous value).  Rationale:
// explorations/design-os-args-vm.md.
func SetArgs(newArgs @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	var prev @[]readonly @[]readonly char = Args
	Args = newArgs
	return prev
}

// argvWithProgName builds the Go-shaped argv from a raw argument list `src`
// (the arguments, EXCLUDING the program name): element 0 is the empty
// program-name placeholder (the zero-value slice make_slice leaves) and
// elements 1.. are readonly views of src.  It builds a mutable slice locally
// and returns it as the fully-readonly type.  Split out from the `Args`
// initializer so it is unit-testable on a synthetic argument list, independent
// of the process's real argv.
func argvWithProgName(src @[]@[]char) @[]readonly @[]readonly char {
	var n int = len(src)
	// n+1: element 0 is reserved for the program name, left as the zero-value
	// empty slice (the placeholder); the real arguments follow at 1..n.  The
	// local is mutable so it can be filled; the return widens it to the
	// readonly element type.
	var out @[]@[]readonly char = make_slice(@[]readonly char, n + 1)
	for i := 0; i < n; i++ {
		out[i + 1] = src[i]
	}
	return out
}
