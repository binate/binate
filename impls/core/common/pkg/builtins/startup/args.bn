// Command-line arguments — startup glue.  Argv lives here (not in pkg/std/os)
// because it is an entry/startup concern: os.Args()/os.SetArgs() delegate to
// startup.Args/startup.SetArgs (os imports startup).
//
// The `Args` global itself is defined in one of three `#[build]`-gated sibling
// files, selected by the build's entry point (is(entrypoint, ...)) — because how
// argv reaches Args depends on which entry runs:
//   - args_main.bn (entrypoint "main", a hosted program on a newer compiler): the
//     Binate entry `_entry` sets Args directly from the real argv (no initializer).
//   - args_baremetal.bn (entrypoint "start", plus the BUILDER transitional case):
//     Args is seeded from bootstrap.Args() at package init — crt0's `_start` or
//     the frozen bundle's C `main` reaches bn_entry, so no Binate `main` runs.
//   - args_init.bn (entrypoint "init", a --library build): no entry, no argv —
//     Args is empty until a caller installs it via os.SetArgs.
// See plan-build-version-predicate.md / design-ffi-export.md §3.3.  This file
// holds the entry-independent seam (SetArgs) and the argv layout helper.
package "pkg/builtins/startup"

// SetArgs replaces Args and returns the PREVIOUS value, so they can be saved and
// restored: `old := SetArgs(new); …; SetArgs(old)` (the returned value flows
// straight back in).  newArgs is the whole argv — element 0 the program name,
// 1.. the arguments — so the caller controls index 0.  It is the seam a bytecode
// interpreter (cmd/bni) uses to give an interpreted program its own argv (via
// os.SetArgs, since os is injected host-native) — see
// explorations/design-os-args-vm.md.
func SetArgs(newArgs @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	var prev @[]readonly @[]readonly char = Args
	Args = newArgs
	return prev
}

// argvWithProgName builds the Go-shaped argv from a raw argument list `src`
// (the arguments, EXCLUDING the program name): element 0 is the empty
// program-name placeholder (the zero-value slice make_slice leaves) and
// elements 1.. are readonly views of src.  It builds a mutable slice locally
// and returns it as the fully-readonly type.  Used by the legacy (bootstrap.Args)
// layout, whose source has no argv[0]; the hosted entry captures the real
// argv[0] and does not need it.  Split out so it is unit-testable on a synthetic
// argument list, independent of the process's real argv.
func argvWithProgName(src @[]@[]char) @[]readonly @[]readonly char {
	var n int = len(src)
	// n+1: element 0 is reserved for the program name, left as the zero-value
	// empty slice (the placeholder); the real arguments follow at 1..n.  The
	// local is mutable so it can be filled; the return widens it to the
	// readonly element type.
	var out @[]@[]readonly char = make_slice(@[]readonly char, n + 1)
	for i := 0; i < n; i++ {
		out[i + 1] = src[i]
	}
	return out
}
