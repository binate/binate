// The bare-metal argv installer — startup glue for a `start`-entry image.
//
// A bare-metal image (entrypoint == "start") reaches bn_entry through crt0's
// `_start`, which just sets sp and `bl bn_entry` — there is no argv-installing
// entry (args_main.bn's `_entry` is gated `is(entrypoint, "main")` and excluded
// here), so nothing would install `args` and os.Args() would return the empty
// zero-value slice (len 0).  That violates the Go-shaped invariant os.Args()
// promises everywhere: element 0 is always the program-name slot, so len >= 1.
//
// The QEMU `virt` machine, under `-semihosting`, exposes the `-append` string via
// SYS_GET_CMDLINE as `<program> <args…>` — exactly argv shape.  installBaremetalArgs
// fetches it and splits it on spaces so a bare-metal program (e.g. the compiled
// test runner) sees the same os.Args() a hosted build would, which is how the
// runner's --run / --shard / --skip filters reach it under `-kernel` (no real
// argv).  With no command line (empty SYS_GET_CMDLINE, or a --library host that
// never passes one) it falls back to the 1-element empty placeholder — element 0
// present so the len >= 1 invariant holds, matching what args_main._entry leaves
// for an empty argument.  On a `start`-entry image THIS is the only writer of
// `args` (args_main.bn is excluded), so there is no clobber.
#[build(is(entrypoint, "start"))]
package "pkg/builtins/startup"

import "pkg/semihost"

// installPlaceholderArgs installs the 1-element empty-placeholder argv (element 0
// the canonical empty managed-slice `make_slice` zero-inits — a valid empty
// string, `same` as every length-0 slice).  Used when there is no command line.
func installPlaceholderArgs() bool {
	var out @[]@[]readonly char = make_slice(@[]readonly char, 1)
	SetArgs(out)
	return true
}

// countArgs returns the number of space-separated tokens in cmd[0:n].
func countArgs(cmd @[]uint8, n int) int {
	var count int = 0
	var i int = 0
	for i < n {
		for i < n && cmd[i] == cast(uint8, ' ') { i = i + 1 }
		if i >= n { break }
		count = count + 1
		for i < n && cmd[i] != cast(uint8, ' ') { i = i + 1 }
	}
	return count
}

// installBaremetalArgs fetches the semihosting command line and installs it as
// argv, split on spaces.  SetArgs is the single owner of the shared `args` cell.
func installBaremetalArgs() bool {
	var cap int = 1024
	var cmd @[]uint8 = make_slice(uint8, cap)
	var n int = semihost.SemihostGetCmdline(&cmd[0], cap)
	if n <= 0 || n > cap {
		return installPlaceholderArgs()
	}
	var count int = countArgs(cmd, n)
	if count == 0 {
		return installPlaceholderArgs()
	}
	var argv @[]@[]readonly char = make_slice(@[]readonly char, count)
	var t int = 0
	var i int = 0
	for i < n {
		for i < n && cmd[i] == cast(uint8, ' ') { i = i + 1 }
		if i >= n { break }
		var start int = i
		for i < n && cmd[i] != cast(uint8, ' ') { i = i + 1 }
		var tokLen int = i - start
		var tok @[]char = make_slice(char, tokLen)
		for j := 0; j < tokLen; j++ { tok[j] = cast(char, cmd[start + j]) }
		argv[t] = tok
		t = t + 1
	}
	SetArgs(argv)
	return true
}

// _ runs installBaremetalArgs() for its side effect during startup.__init, which
// bn_entry's __init_all dispatches before main.main.
var _ bool = installBaremetalArgs()
