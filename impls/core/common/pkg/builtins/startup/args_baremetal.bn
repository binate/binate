// Baremetal Args seed — Args populated at package init from bootstrap.Args()
// (via argvWithProgName, which lays out the Go-shaped slice: element 0 the empty
// program-name placeholder, since bootstrap.Args() returns only the arguments).
// A baremetal image (entrypoint == "start") reaches bn_entry through crt0's
// `_start`, not a Binate `main`, and has no command line — so bootstrap.Args()
// returns empty, giving Args the length-1 placeholder.
//
// This file ALSO covers the BUILDER transitional case (at_most 0.0.11): BUILDER
// links the frozen bundle's binate_runtime.c, whose C `main` captures argv into
// the runtime globals bootstrap.Args() reads, and it predates the Binate `main`
// entry (args_main.bn).  That `at_most` half comes FIRST so BUILDER short-circuits
// on the true version test and never evaluates the `entrypoint` predicate it does
// not know.  Once BUILDER re-pins past the args_main.bn threshold, the `at_most`
// half is vestigial and can retire, leaving this the pure baremetal seed.
//
// Newer hosted programs use args_main.bn (its _entry sets Args from the real
// argv); a --library build uses args_init.bn (no argv, no seed).  See
// plan-build-version-predicate.md / design-ffi-export.md §3.3.
#[build(at_most(version, "0.0.11") || is(entrypoint, "start"))]
package "pkg/builtins/startup"

import "pkg/bootstrap"

// See the package doc in startup.bni.
var Args @[]readonly @[]readonly char = argvWithProgName(bootstrap.Args())
