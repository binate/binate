// The bare-metal argv placeholder — startup glue for a `start`-entry image.
//
// A bare-metal image (entrypoint == "start") reaches bn_entry through crt0's
// `_start`, which just sets sp and `bl bn_entry` — there is no argv-installing
// entry (args_main.bn's `_entry` is gated `is(entrypoint, "main")` and excluded
// here), so nothing would install `args` and os.Args() would return the empty
// zero-value slice (len 0).  That violates the Go-shaped invariant os.Args()
// promises everywhere: element 0 is always the program-name slot, so len >= 1.
//
// A bare-metal target has no command line, so element 0 is an EMPTY placeholder.
// This installs a 1-element `args` at package-init time (a blank-identifier
// package var runs its initializer for side effects during startup.__init, which
// bn_entry's __init_all dispatches before main.main — so user code and every later
// __init see len 1).  On a `start`-entry image THIS is the only writer of `args`
// (args_main.bn is excluded), so there is no clobber; a hosted `main`-entry image
// excludes THIS file instead and args_main's `_entry` installs the real argv.  A
// --library build (entrypoint "init") is left empty deliberately — the embedding C
// host provides argv via os.SetArgs, and a placeholder would mask a host that
// forgot to (see args.bn).  See design-ffi-export.md §3.3 /
// plan-build-version-predicate.md.
#[build(is(entrypoint, "start"))]
package "pkg/builtins/startup"

// installBaremetalArgs installs the 1-element empty-placeholder argv.  element 0 is
// the canonical empty managed-slice {null, 0, null, 0} that make_slice zero-inits —
// a valid empty string, `same` as every length-0 slice (spec
// type.slice.len0-no-backing) — exactly the shape args_main._entry leaves for an
// empty argument.  SetArgs is the single owner of the shared `args` cell; the
// local `out` transfers into it (the same install args_main._entry performs).
func installBaremetalArgs() bool {
	var out @[]@[]readonly char = make_slice(@[]readonly char, 1)
	SetArgs(out)
	return true
}

// _ runs installBaremetalArgs() for its side effect during startup.__init.
var _ bool = installBaremetalArgs()
