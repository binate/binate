// Library Args — for a --library build (entrypoint == "init"), whose entry is a
// C-callable init, not a `main`.  There is no argv to capture (the C host owns
// its own argv and passes any data explicitly), and the archive does not bundle
// binate_runtime.c, so bootstrap.Args() is not even linkable here.  So Args has
// no initializer and no entry sets it: os.Args() in a library is empty until a
// caller installs args via os.SetArgs.  A definition is still required — startup
// is force-loaded and os.Args reads Args across the package boundary — hence this
// file rather than simply omitting it.
//
// The `at_least` half comes FIRST so BUILDER (which predates the `entrypoint`
// predicate, and never builds a library) short-circuits on the false version test
// and never evaluates it.  See design-ffi-export.md §3.3.
#[build(at_least(version, "0.0.12") && is(entrypoint, "init"))]
package "pkg/builtins/startup"

// See the package doc in startup.bni.
var Args @[]readonly @[]readonly char
