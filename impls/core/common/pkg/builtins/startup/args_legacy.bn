// Legacy Args seed — Args populated at package init from bootstrap.Args() (via
// argvWithProgName, which lays out the Go-shaped slice: element 0 the empty
// program-name placeholder, since bootstrap.Args() returns only the arguments).
// This is the seed for every build that does NOT run the hosted Binate entry
// (args_hosted.bn's _entry):
//   - BUILDER and older (at_most 0.0.11): they link the frozen bundle's
//     binate_runtime.c, whose C `main` captures argv into the runtime globals
//     bootstrap.Args() reads.
//   - baremetal (any version): the entry is crt0's `_start`, which calls bn_entry
//     directly — there is no hosted `main`, so _entry never runs; bootstrap.Args()
//     there returns empty (no command line), giving Args the length-1 placeholder.
//
// Newer hosted compilers use args_hosted.bn instead (its _entry sets Args from the
// real argv).  The version half of the gate matches the bootstrap stage boundary:
// BUILDER builds gen1 (this file active, linking the bundle's C main), gen1 builds
// everything else.  The os half keeps baremetal on this seed regardless of
// version.  See plan-build-version-predicate.md / design-ffi-export.md §3.3.
#[build(at_most(version, "0.0.11") || is(os, "baremetal"))]
package "pkg/builtins/startup"

import "pkg/bootstrap"

// See the package doc in startup.bni.
var Args @[]readonly @[]readonly char = argvWithProgName(bootstrap.Args())
