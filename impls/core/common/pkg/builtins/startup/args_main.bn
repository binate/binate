// The `main` entry — the process `main`, written in Binate.  Active for a build
// whose entry point is `main` (entrypoint == "main": a hosted program, where the
// C runtime — crt0 — calls `main`), on a compiler past the pinned BUILDER: it
// links the tree's binate_runtime.c (with the C `main` removed), and `_entry` is
// exported under the unmangled C symbol `main` for crt0 to call.  Excluded for the
// other entry points: a bare-metal image (entrypoint == "start") reaches bn_entry
// through crt0's `_start`, and a --library build (entrypoint == "init") has no
// `main` at all — neither runs this entry, and both leave os.Args() empty (no
// argv installed).  The `at_least` half comes FIRST so BUILDER (which predates the
// `entrypoint` predicate) short-circuits on the false version test and never
// evaluates it.  See design-ffi-export.md §3.3 and plan-build-version-predicate.md.
#[build(at_least(version, "0.0.12") && is(entrypoint, "main"))]
package "pkg/builtins/startup"

import "pkg/builtins/rt"

// _entry is the process entry point.  #[c_export("main")] emits it under the
// unmangled C symbol `main`, so the platform's C runtime start calls it directly
// (replacing the C `main` in binate_runtime.c).  It takes the standard C
// `main(argc, argv, envp)` arguments: it captures the real argv (Go-shaped,
// element 0 the program name, 1.. the arguments) and envp (the "NAME=value"
// environment), and installs them via SetArgs / SetEnv (the single owners of the
// shared `args` / `env` cells), then hands off to bn_entry (the compiler-emitted
// `main.__init_all(); main.main()`).  _entry runs before bn_entry — hence before
// package __init — so it installs both before anything can read them; neither cell
// has an initializer, so __init does not clobber this.  argv is BORROWED in place
// (below); envp is COPIED (captureEnv), because the environment is mutable.  The
// int32 argc/return matches C `main`'s ABI: C `int` is 32-bit on both LP64 and
// ILP32, whereas Binate `int` is target-width and would mismatch argc/return.

#[c_export("main")]
func _entry(argc int32, argv **char, envp **char) int32 {
	var n int = cast(int, argc)
	// Go-shaped argv, keeping every element including argv[0] (the program
	// name).  Each element BORROWS its C string in place rather than copying it:
	// argv's storage is _entry's own parameter, so it outlives the whole Binate
	// program (bn_entry runs to completion inside this C `main` frame), which
	// satisfies the borrow's lifetime obligation (spec mem.managed-vs-raw /
	// mem.raw-uaf).  Only `out` — the outer array of slice headers — is an owned
	// allocation.
	var out @[]@[]readonly char = make_slice(@[]readonly char, n)
	for i := 0; i < n; i++ {
		var cstr *char = unsafe_index(argv, i)
		var m int = 0
		for unsafe_index(cstr, m) != 0 {
			m = m + 1
		}
		// out[i]'s storage IS the @[]readonly char layout {data, len, backing,
		// backingLen} (== rt.ManagedSlice).  Leaving `backing` null (make_slice
		// zero-inited it) makes the element a null-backing view — the same shape
		// a compiled @[]readonly char literal has (spec
		// type.layout.slice-managed.backing) — so RefInc/RefDec no-op on it and
		// the borrowed C bytes are never freed.  Only data/len/backingLen are set.
		//
		// An EMPTY argument (m == 0) is left as the zero-value out[i] make_slice
		// produced: the canonical empty managed-slice {null, 0, null, 0} that
		// every length-0 slice must be (spec type.slice.len0-no-backing).  Only a
		// non-empty arg gets a data pointer, so an empty arg stays `same` as every
		// other empty slice rather than a non-null-data zero-len oddity.
		if m > 0 {
			var hdr *rt.ManagedSlice = bit_cast(*rt.ManagedSlice, &out[i])
			hdr.Data = bit_cast(*uint8, cstr)
			hdr.Len = m
			hdr.BackingLen = m
		}
	}
	SetArgs(out)
	SetEnv(captureEnv(envp))
	__c_call("bn_entry", "void")
	return 0
}

// captureEnv snapshots the process environment from the C `envp` array — a
// NULL-terminated array of "NAME=value" C strings — into owned managed slices.
// Unlike argv (borrowed in place, since argv storage is immortal), environ is
// MUTABLE: setenv/putenv can rewrite or free its storage, and a raw *[]char view
// into it would dangle after such a call.  So each string is COPIED, making
// os.Env() a stable snapshot taken at process entry.  A setenv AFTER entry is
// therefore not reflected — an inherent, accepted consequence of snapshotting a
// mutable environment (a live view would trade the staleness for a use-after-free).
func captureEnv(envp **char) @[]readonly @[]readonly char {
	var cnt int = 0
	for unsafe_index(envp, cnt) != nil {
		cnt = cnt + 1
	}
	var out @[]@[]readonly char = make_slice(@[]readonly char, cnt)
	for i := 0; i < cnt; i++ {
		var cstr *char = unsafe_index(envp, i)
		var m int = 0
		for unsafe_index(cstr, m) != 0 {
			m = m + 1
		}
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = unsafe_index(cstr, j)
		}
		out[i] = s
	}
	return out
}
