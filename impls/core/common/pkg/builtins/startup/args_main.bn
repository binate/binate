// The `main` entry — the process `main`, written in Binate.  Active for a build
// whose entry point is `main` (entrypoint == "main": a hosted program, where the
// C runtime — crt0 — calls `main`), on a compiler past the pinned BUILDER: it
// links the tree's binate_runtime.c (with the C `main` removed), and `_entry` is
// exported under the unmangled C symbol `main` for crt0 to call.  Excluded
// elsewhere: BUILDER and older seed Args from the frozen bundle's C `main`
// (args_baremetal.bn); a baremetal image (entrypoint == "start") uses crt0's
// `_start`; a --library build (entrypoint == "init") has no `main` at all
// (args_init.bn) — this entry would never run in any of those, so it must be
// excluded.  The `at_least` half comes FIRST so BUILDER (which predates the
// `entrypoint` predicate) short-circuits on the false version test and never
// evaluates it.  See design-ffi-export.md §3.3 and plan-build-version-predicate.md.
#[build(at_least(version, "0.0.12") && is(entrypoint, "main"))]
package "pkg/builtins/startup"

// Args is set directly by _entry from the real argv, so it has no initializer
// here (unlike the legacy seed): _entry runs before bn_entry — hence before any
// package __init and before main.main() — and an initializer would overwrite the
// captured argv when startup.__init ran.
var Args @[]readonly @[]readonly char

// _entry is the process entry point.  #[c_export("main")] emits it under the
// unmangled C symbol `main`, so the platform's C runtime start calls it directly
// (replacing the C `main` in binate_runtime.c).  It captures the real argv —
// element 0 the program name, 1.. the arguments (Go-shaped, matching os.Args) —
// into Args, then hands off to bn_entry (the compiler-emitted
// `main.__init_all(); main.main()`).  The int32/int32 signature matches C
// `main`'s ABI: C `int` is 32-bit on both LP64 and ILP32, whereas Binate `int`
// is target-width and would mismatch argc/return.

#[c_export("main")]
func _entry(argc int32, argv **char) int32 {
	var n int = cast(int, argc)
	// Go-shaped argv, keeping every element including argv[0] (the program
	// name).  Each C string is copied into an owned managed @[]char: the C
	// strings live in argv's storage, and Args must outlive that and refcount
	// like any managed slice.
	var out @[]@[]readonly char = make_slice(@[]readonly char, n)
	for i := 0; i < n; i++ {
		var cstr *char = unsafe_index(argv, i)
		var m int = 0
		for unsafe_index(cstr, m) != 0 {
			m = m + 1
		}
		var s @[]char = make_slice(char, m)
		for j := 0; j < m; j++ {
			s[j] = unsafe_index(cstr, j)
		}
		out[i] = s
	}
	Args = out
	__c_call("bn_entry", "void")
	return 0
}
