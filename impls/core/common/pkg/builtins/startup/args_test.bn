package "pkg/builtins/startup"

import "pkg/builtins/testing"

// fail wraps a message as a failing TestResult (startup has no shared test
// helper file yet; this is the only test here).
func fail(msg @[]char) testing.TestResult {
	return msg
}

// mkArg builds an owned @[]char from a readonly literal, for a synthetic
// argument list.
func mkArg(s *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		out[i] = s[i]
	}
	return out
}

// TestSetArgsReplacesAndRestores checks that SetArgs installs a new argv that
// Args() then reflects, returns the previous value, and that feeding that previous
// value back in restores it.  The `args` cell is shared package-wide, so this
// saves and restores the process's own args around the test.
func TestSetArgsReplacesAndRestores() testing.TestResult {
	var originalLen int = len(Args())

	// A synthetic full argv (element 0 the program name, then one argument),
	// built mutable and widened to the readonly element type SetArgs takes.
	var newArgv @[]@[]readonly char = make_slice(@[]readonly char, 2)
	newArgv[0] = mkArg("prog")
	newArgv[1] = mkArg("one")
	var widened @[]readonly @[]readonly char = newArgv

	var prev @[]readonly @[]readonly char = SetArgs(widened)
	var cur @[]readonly @[]readonly char = Args()
	SetArgs(prev) // restore, using the returned previous value
	var restoredLen int = len(Args())

	// SetArgs returned the value Args() had before (the process's own args).
	if len(prev) != originalLen {
		return fail("SetArgs should return the previous args")
	}
	// While installed, Args() reflected the new argv exactly.
	if len(cur) != 2 || len(cur[0]) != 4 || len(cur[1]) != 3 {
		return fail("Args() should reflect the installed argv (prog + one)")
	}
	if cur[0][0] != 'p' || cur[1][0] != 'o' {
		return fail("Args() content should be the installed argv")
	}
	// Feeding the previous value back in restored the original.
	if restoredLen != originalLen {
		return fail("restoring the previous value should bring Args() back")
	}
	return ""
}
