// The process environment — the second entry/startup datum (after Args).  For a
// hosted program the entry glue (args_main.bn's _entry) installs `env` from the
// real envp at process start via SetEnv, copying a snapshot; a bare-metal or
// --library build has no entry to install one, so its `env` stays empty until a
// caller sets it via os.SetEnv.  Not build-constrained.
package "pkg/builtins/startup"

// env holds the process environment as a list of "NAME=value" strings (the POSIX
// `environ` shape).  Empty (the zero-value slice) until an entry installs it via
// SetEnv — the hosted _entry does, copying the snapshot from envp.  Private —
// os.Env()/os.SetEnv() reach it through the exported Env()/SetEnv accessors, the
// same shape as the `args` cell behind Args()/SetArgs().
var env @[]readonly @[]readonly char

// Env returns the process environment as "NAME=value" strings (POSIX environ
// order).  The result is a fully-readonly managed slice, safe to share; it is the
// same slice on every call — the snapshot the hosted entry installed from envp, or
// whatever SetEnv last installed (empty on a target with no entry to install one).
func Env() @[]readonly @[]readonly char {
	return env
}

// SetEnv replaces the environment Env() returns and returns the PREVIOUS value,
// so a caller can save and restore it:
//
//	old := startup.SetEnv(new)
//	// ... run with `new` visible via os.Env() ...
//	startup.SetEnv(old) // restore
//
// The value flows straight back in (both are @[]readonly @[]readonly char), so
// restore is symmetric.  Each entry is a "NAME=value" string.  This is the env
// counterpart of SetArgs — the seam a bytecode interpreter (cmd/bni) uses to give
// an interpreted program its own environment (through os.SetEnv, since os is
// injected host-native); see explorations/design-os-args-vm.md.
func SetEnv(newEnv @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	var prev @[]readonly @[]readonly char = env
	env = newEnv
	return prev
}
