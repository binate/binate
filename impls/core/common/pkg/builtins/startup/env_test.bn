package "pkg/builtins/startup"

import "pkg/builtins/testing"

// fail and mkArg are shared with args_test.bn (same package).

// TestSetEnvReplacesAndRestores checks that SetEnv installs a new environment
// that Env() then reflects, returns the previous value, and that feeding that
// value back in restores it.  env is shared package-wide, so this saves and
// restores whatever was installed around the test.
func TestSetEnvReplacesAndRestores() testing.TestResult {
	var originalLen int = len(Env())

	// A synthetic environment: two "NAME=value" entries (7 chars each), built
	// mutable and widened to the readonly element type SetEnv takes.
	var newEnv @[]@[]readonly char = make_slice(@[]readonly char, 2)
	newEnv[0] = mkArg("FOO=bar")
	newEnv[1] = mkArg("BAZ=qux")
	var widened @[]readonly @[]readonly char = newEnv

	var prev @[]readonly @[]readonly char = SetEnv(widened)
	var cur @[]readonly @[]readonly char = Env()
	SetEnv(prev) // restore, using the returned previous value
	var restoredLen int = len(Env())

	if len(prev) != originalLen {
		return fail("SetEnv should return the previous env")
	}
	if len(cur) != 2 || len(cur[0]) != 7 || len(cur[1]) != 7 {
		return fail("Env() should reflect the installed env (two NAME=value)")
	}
	if cur[0][0] != 'F' || cur[1][0] != 'B' {
		return fail("Env() content should be the installed env")
	}
	if restoredLen != originalLen {
		return fail("restoring the previous value should bring Env() back")
	}
	return ""
}

// TestEnvIsEmptyStub confirms the current stub behavior: with nothing installed,
// the environment is empty (there is no data source yet).  Saves/restores the
// shared `env` around the check so test order can't perturb it.
func TestEnvIsEmptyStub() testing.TestResult {
	var saved @[]readonly @[]readonly char = Env()
	var empty @[]readonly @[]readonly char
	SetEnv(empty)
	var got int = len(Env())
	SetEnv(saved) // restore
	if got != 0 {
		return fail("the env stub should be empty when nothing is installed")
	}
	return ""
}
