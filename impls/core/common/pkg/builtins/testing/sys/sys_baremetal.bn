// Bare-metal ARM32 implementation of pkg/builtins/testing/sys's WriteStdout, over
// semihosting.  Gated to bare-metal targets; every other target uses the hosted
// (libc) variant in sys_host.bn.
#[build(is(os, "baremetal"))]
package "pkg/builtins/testing/sys"

import "pkg/semihost"

// WriteStdout writes n bytes at ptr to the semihosting debug console, one byte at a
// time via SemihostWriteChar (SYS_WRITEC).  Semihosting has a single console (no
// stdout/stderr split), so program output and rt's fault diagnostics share it.
func WriteStdout(ptr *uint8, n int) {
	for i := 0; i < n; i++ {
		semihost.SemihostWriteChar(cast(char, ptr[i]))
	}
}
