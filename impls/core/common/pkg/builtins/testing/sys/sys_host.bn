// Hosted (libc) implementation of pkg/builtins/testing/sys's WriteStdout —
// selected on every target except bare metal, which has its own semihosting
// variant in sys_baremetal.bn.
#[build(!is(os, "baremetal"))]
package "pkg/builtins/testing/sys"

// WriteStdout writes n bytes at ptr to standard output (fd 1) via write(2).  A
// short write / error is ignored — test output is best-effort.
func WriteStdout(ptr *uint8, n int) {
	_ = __c_call("write", int, cast(int32, 1), ptr, cast(uint, n))
}
