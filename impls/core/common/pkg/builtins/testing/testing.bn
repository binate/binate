// Package testing's Print/Println write test-program output to standard output:
// a single space between adjacent operands and (Println) a trailing newline.
// Output goes through the per-target pkg/builtins/testing/sys.WriteStdout;
// per-operand formatting bottoms out in pkg/builtins/lang's Stringer impls rather
// than re-implementing scalar formatting.
//
// This file is the `testing -> lang` import edge.  The exported TestResult type
// (testing.bni) is an alias for the named sys.TestResult, which lives in the
// lang-free pkg/builtins/testing/sys precisely so lang's own tests can name it
// without closing a `testing -> lang -> testing` cycle.
package "pkg/builtins/testing"

import "pkg/builtins/lang"
import "pkg/builtins/reflect"
import "pkg/builtins/testing/sys"

// Print writes each operand with a single space between adjacent operands and no
// trailing newline.
func Print(args ...*any) {
	for i := 0; i < len(args); i++ {
		if i > 0 {
			writeStr(" ")
		}
		writeArg(args[i])
	}
}

// Println is Print plus a trailing newline.
func Println(args ...*any) {
	for i := 0; i < len(args); i++ {
		if i > 0 {
			writeStr(" ")
		}
		writeArg(args[i])
	}
	writeStr("\n")
}

// writeArg writes one operand by its dynamic type: a char slice (any of the four
// bare spellings) verbatim, a NAMED or outer-`readonly`-qualified char slice via
// reflect, anything else via its lang.Stringer String() — int/uint/bool/float and
// user types all implement Stringer in lang.  An operand that is neither a char
// slice nor a Stringer renders a visible placeholder rather than silently dropping.
func writeArg(arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		writeStr(v)
	case *[]char:
		writeStr(v)
	case @[]readonly char:
		writeStr(v[0:len(v)])
	case @[]char:
		writeStr(v[0:len(v)])
	default:
		// A NAMED (`type Str @[]char`) or outer-`readonly`-qualified char slice has
		// a distinct dynamic type the bare cases above miss, but reflect classifies
		// by UNDERLYING kind: KIND_STRING covers every char-slice spelling.  The
		// value's first two words {data, len} form a valid raw char-slice view (raw
		// and managed alike — matches the compiler's isCharSliceType, which peels
		// named/readonly wrappers).
		var ti *reflect.TypeInfo = reflect.TypeOf(arg)
		if ti != nil && ti.Kind == reflect.KIND_STRING {
			writeStr(bit_cast(*(*[]readonly char), reflect.DataOf(arg))[0])
			return
		}
		var st *lang.Stringer
		var ok bool
		st, ok = arg.(*lang.Stringer)
		if ok {
			var s @[]char = st.String()
			writeStr(s[0:len(s)])
			return
		}
		// A named non-struct scalar (`type Celsius int`, `type Flag bool`, …) is a
		// DISTINCT type with an empty method set, so it satisfies neither the
		// char-slice cases nor lang.Stringer (a named type does not inherit its
		// underlying's String()).  Format it by its UNDERLYING kind: read the value
		// at its exact width and delegate to the universe type's String().
		if ti != nil && writeScalarByKind(ti, arg) {
			return
		}
		writeStr("%!?(unknown)")
	}
}

// writeScalarByKind formats `arg` when its dynamic type is a named scalar of some
// width — int/uint/bool/float — by reading the value back at ti.Size and calling
// the corresponding universe type's String() (every width implements Stringer in
// lang).  Returns false for anything else (a named struct/slice/pointer with no
// String()), leaving the caller to render the placeholder.  This is the path a
// NAMED numeric takes: the Stringer assertion in writeArg misses it because the
// named type's method set is empty, but its underlying kind still formats.
func writeScalarByKind(ti *reflect.TypeInfo, arg *any) bool {
	var p *uint8 = reflect.DataOf(arg)
	if ti.Kind == reflect.KIND_INT {
		if ti.Size == 8 { var v int64 = bit_cast(*int64, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 4 { var v int32 = bit_cast(*int32, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 2 { var v int16 = bit_cast(*int16, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 1 { var v int8 = bit_cast(*int8, p)[0]; writeOwned(v.String()); return true }
		return false
	}
	if ti.Kind == reflect.KIND_UINT {
		if ti.Size == 8 { var v uint64 = bit_cast(*uint64, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 4 { var v uint32 = bit_cast(*uint32, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 2 { var v uint16 = bit_cast(*uint16, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 1 { var v uint8 = p[0]; writeOwned(v.String()); return true }
		return false
	}
	if ti.Kind == reflect.KIND_BOOL {
		var v bool = p[0] != 0
		writeOwned(v.String())
		return true
	}
	if ti.Kind == reflect.KIND_FLOAT {
		if ti.Size == 8 { var v float64 = bit_cast(*float64, p)[0]; writeOwned(v.String()); return true }
		if ti.Size == 4 { var v float32 = bit_cast(*float32, p)[0]; writeOwned(v.String()); return true }
		return false
	}
	return false
}

// writeOwned writes a char slice (typically a String() result) to standard
// output; it only reads (borrows) the slice.
func writeOwned(s *[]readonly char) {
	writeStr(s[0:len(s)])
}

// writeStr writes a char-slice "string" to standard output via sys.WriteStdout.
// Empty is a no-op.  char is uint8, so the slice is a byte view; word 0 of the
// slice header is the data pointer (mirrors sys/io.bn's dataOfRO and rt's
// rtWriteStr).
func writeStr(s *[]readonly char) {
	if len(s) == 0 {
		return
	}
	sys.WriteStdout(bit_cast(*uint8, bit_cast(*int, &s)[0]), len(s))
}
