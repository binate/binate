// Bare-metal pkg/std/os: a freestanding target has no filesystem, so
// every File operation and every Open / OpenFile / Create fails.  The
// package exists so that code importing pkg/std/os still links on a
// bare-metal target — it simply cannot touch files there.  The standard
// streams are empty @File handles (test with `present`).
package "pkg/std/os"

import "pkg/std/errors"

// errNoFS is the failure every operation returns: there is no
// filesystem on a freestanding target.
func errNoFS() @errors.Error {
	return errors.New("os: no filesystem on a freestanding target")
}

func (f *File) Read(p *[]uint8) (int, @errors.Error) {
	return 0, errNoFS()
}

func (f *File) Write(p *[]readonly uint8) (int, @errors.Error) {
	return 0, errNoFS()
}

func (f *File) Close() @errors.Error {
	return errNoFS()
}

func (f *File) ReadAt(p *[]uint8, off int64) (int, @errors.Error) {
	return 0, errNoFS()
}

func (f *File) WriteAt(p *[]readonly uint8, off int64) (int, @errors.Error) {
	return 0, errNoFS()
}

func (f *File) Seek(offset int64, whence Whence) (int64, @errors.Error) {
	return cast(int64, 0), errNoFS()
}

func Open(name *[]readonly char) (@File, @errors.Error) {
	var none @File
	return none, errNoFS()
}

func OpenFile(name *[]readonly char, flag int, perm FileMode) (@File, @errors.Error) {
	var none @File
	return none, errNoFS()
}

func Create(name *[]readonly char) (@File, @errors.Error) {
	var none @File
	return none, errNoFS()
}

// The standard streams are empty on a target with no standard I/O.
var Stdin  @File
var Stdout @File
var Stderr @File
