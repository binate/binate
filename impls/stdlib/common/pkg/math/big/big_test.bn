package "pkg/math/big"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// Limb-product primitive
// ============================================================

// uint32 * uint32 must fit in uint64 without loss — the invariant the
// uint32-limb representation relies on (Binate has no 128-bit integer).
// Pinned directly because no existing conformance test prints a runtime
// uint32*uint32 -> uint64 product.
func TestUint32ProductFitsUint64() testing.TestResult {
	var a uint32 = cast(uint32, 0xFFFFFFFF)
	var b uint32 = cast(uint32, 0xFFFFFFFF)
	var p uint64 = cast(uint64, a) * cast(uint64, b)
	if p != cast(uint64, 0xFFFFFFFE00000001) {
		return fail("0xFFFFFFFF * 0xFFFFFFFF should be 0xFFFFFFFE00000001")
	}
	return ""
}

// ============================================================
// Construction + uint64 round-trip
// ============================================================

func TestNewIsZero() testing.TestResult {
	var z @Nat = New()
	if !z.IsZero() { return fail("New() should be zero") }
	if z.BitLen() != 0 { return fail("BitLen(0) should be 0") }
	if z.ToUint64() != cast(uint64, 0) { return fail("ToUint64(0) should be 0") }
	if !z.IsUint64() { return fail("0 should fit uint64") }
	return ""
}

func TestFromUint64Small() testing.TestResult {
	var n @Nat = FromUint64(cast(uint64, 42))
	if n.IsZero() { return fail("42 should not be zero") }
	if n.ToUint64() != cast(uint64, 42) { return fail("round-trip 42") }
	if n.BitLen() != 6 { return fail("BitLen(42) should be 6") }
	if !n.IsUint64() { return fail("42 should fit uint64") }
	return ""
}

func TestFromUint64Zero() testing.TestResult {
	var n @Nat = FromUint64(cast(uint64, 0))
	if !n.IsZero() { return fail("FromUint64(0) should be zero") }
	return ""
}

func TestFromUint64Wide() testing.TestResult {
	// (1<<32) + 1 — exercises the two-limb path.
	var v uint64 = (cast(uint64, 1) << 32) | cast(uint64, 1)
	var n @Nat = FromUint64(v)
	if n.ToUint64() != v { return fail("round-trip (1<<32)+1") }
	if n.BitLen() != 33 { return fail("BitLen((1<<32)+1) should be 33") }
	if !n.IsUint64() { return fail("(1<<32)+1 should fit uint64") }
	return ""
}

func TestFromUint64Max() testing.TestResult {
	var max uint64 = cast(uint64, 0) - cast(uint64, 1)   // UINT64_MAX
	var n @Nat = FromUint64(max)
	if n.ToUint64() != max { return fail("round-trip UINT64_MAX") }
	if n.BitLen() != 64 { return fail("BitLen(UINT64_MAX) should be 64") }
	if !n.IsUint64() { return fail("UINT64_MAX should fit uint64") }
	return ""
}

// ============================================================
// BitLen boundaries
// ============================================================

func TestBitLenBoundaries() testing.TestResult {
	if FromUint64(cast(uint64, 1)).BitLen() != 1 { return fail("BitLen(1) should be 1") }
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)   // 0xFFFFFFFF
	if FromUint64(u32max).BitLen() != 32 { return fail("BitLen(0xFFFFFFFF) should be 32") }
	var oneLimbUp uint64 = cast(uint64, 1) << 32                    // 0x100000000
	if FromUint64(oneLimbUp).BitLen() != 33 { return fail("BitLen(1<<32) should be 33") }
	return ""
}

// ============================================================
// Cmp
// ============================================================

func TestCmpEqual() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 12345))
	var b @Nat = FromUint64(cast(uint64, 12345))
	if a.Cmp(b) != 0 { return fail("Cmp of equal values should be 0") }
	return ""
}

func TestCmpDifferentLength() testing.TestResult {
	var small @Nat = FromUint64(cast(uint64, 5))                          // 1 limb
	var big @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 7))  // 2 limbs
	if small.Cmp(big) != -1 { return fail("1-limb < 2-limb should be -1") }
	if big.Cmp(small) != 1 { return fail("2-limb > 1-limb should be 1") }
	return ""
}

func TestCmpSameLength() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 100))
	var b @Nat = FromUint64(cast(uint64, 200))
	if a.Cmp(b) != -1 { return fail("100 < 200 should be -1") }
	if b.Cmp(a) != 1 { return fail("200 > 100 should be 1") }
	return ""
}

// ============================================================
// Clone / Set
// ============================================================

func TestCloneIndependent() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 999))
	var c @Nat = a.Clone()
	if c.Cmp(a) != 0 { return fail("clone should equal original") }
	a.SetUint64(cast(uint64, 1))   // mutate the original
	if c.ToUint64() != cast(uint64, 999) {
		return fail("clone must be unaffected by mutating the original")
	}
	return ""
}

func TestSetShrinkAndGrow() testing.TestResult {
	// z starts 2-limb, Set to a 1-limb value (shrink), then to a wide value
	// (grow) — exercises the nlimbs bookkeeping and backing reuse.
	var z @Nat = FromUint64((cast(uint64, 1) << 40) | cast(uint64, 3))
	var small @Nat = FromUint64(cast(uint64, 7))
	z.Set(small)
	if z.ToUint64() != cast(uint64, 7) { return fail("Set shrink should give 7") }
	if z.BitLen() != 3 { return fail("BitLen(7) should be 3") }
	var wide @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1))
	z.Set(wide)
	if z.ToUint64() != (cast(uint64, 0) - cast(uint64, 1)) {
		return fail("Set grow should give UINT64_MAX")
	}
	return ""
}

// Cmp against zero — the most common ordering query (vs New()), hitting the
// nlimbs-differ branch with one side at nlimbs == 0.
func TestCmpZeroOperand() testing.TestResult {
	var zero @Nat = New()
	var n @Nat = FromUint64(cast(uint64, 5))
	if zero.Cmp(n) != -1 { return fail("0 < 5 should be -1") }
	if n.Cmp(zero) != 1 { return fail("5 > 0 should be 1") }
	return ""
}

// Cmp of zero vs zero — the empty descent loop (i starts at -1) returning 0.
func TestCmpZeroVsZero() testing.TestResult {
	var a @Nat = New()
	var b @Nat = New()
	if a.Cmp(b) != 0 { return fail("0 == 0 should be 0") }
	return ""
}

// Cmp of same-length values with an equal top limb but differing low limb —
// forces the descent loop past the equal limb to decide on a lower one.
func TestCmpLowerLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 5))
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 9))
	if a.Cmp(b) != -1 { return fail("equal top limb, 5 < 9 should be -1") }
	if b.Cmp(a) != 1 { return fail("equal top limb, 9 > 5 should be 1") }
	return ""
}

// Set when z aliases x (the documented "z may alias x" path): grow is a
// no-op and the copy is an identity, so the value is preserved.
func TestSetSelfAlias() testing.TestResult {
	var z @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 3))
	z.Set(z)
	if z.ToUint64() != ((cast(uint64, 1) << 32) | cast(uint64, 3)) {
		return fail("Set self-alias should preserve value")
	}
	if z.BitLen() != 33 { return fail("BitLen((1<<32)|3) should be 33") }
	if z.IsZero() { return fail("self-aliased value should be nonzero") }
	var w @Nat = New()
	w.Set(w)
	if !w.IsZero() { return fail("zero self-alias should stay zero") }
	return ""
}

// SetUint64 shrinking an already-2-limb receiver — to 0 and to 1 limb —
// exercising the downward nlimbs bookkeeping from a multi-limb start.
func TestSetUint64Shrink() testing.TestResult {
	var z @Nat = FromUint64((cast(uint64, 1) << 40) | cast(uint64, 3))   // 2 limbs
	z.SetUint64(cast(uint64, 0))                                          // 2-limb -> 0
	if !z.IsZero() { return fail("SetUint64(0) on a 2-limb value should be zero") }
	if z.BitLen() != 0 { return fail("BitLen after shrink-to-0 should be 0") }
	var w @Nat = FromUint64((cast(uint64, 1) << 40) | cast(uint64, 3))   // 2 limbs again
	w.SetUint64(cast(uint64, 7))                                          // 2-limb -> 1
	if w.ToUint64() != cast(uint64, 7) { return fail("SetUint64 shrink should give 7") }
	if w.BitLen() != 3 { return fail("BitLen(7) should be 3") }
	if w.IsZero() { return fail("7 should not be zero") }
	return ""
}

// Clone of a zero (grow no-op, empty copy loop) and its independence.
func TestCloneZero() testing.TestResult {
	var a @Nat = New()
	var c @Nat = a.Clone()
	if !c.IsZero() { return fail("clone of zero should be zero") }
	if c.Cmp(a) != 0 { return fail("clone of zero should equal original") }
	a.SetUint64(cast(uint64, 5))
	if !c.IsZero() { return fail("zero clone must be unaffected by mutating the original") }
	return ""
}

// grow's doubling loop iterating more than once: Set a 3-limb value onto a
// fresh (no-backing) receiver forces grow(z, 3) to run 1 -> 2 -> 4.  The
// 3-limb input is built via AddUint32 (2^64), since FromUint64 caps at two
// limbs.  Guards that grow preserves the live limbs across reallocation.
func TestGrowMultipleDoublings() testing.TestResult {
	var x @Nat = New().AddUint32(FromUint64(cast(uint64, 0) - cast(uint64, 1)), cast(uint32, 1))   // 2^64, 3 limbs
	var z @Nat = New()
	z.Set(x)
	if z.Cmp(x) != 0 { return fail("Set of a 3-limb value should equal the source") }
	if z.IsUint64() { return fail("2^64 should be 3 limbs (not uint64)") }
	if z.BitLen() != 65 { return fail("BitLen(2^64) should be 65") }
	if z.ToUint64() != cast(uint64, 0) { return fail("low 64 bits of 2^64 should be 0") }
	return ""
}
