// Nat core: construction, the limb-store invariant helper (grow), and the
// value queries (IsZero/BitLen/Cmp/IsUint64/ToUint64).  Arithmetic lives in
// nat_arith.bn, division in nat_div.bn, shifts in nat_shift.bn.
package "pkg/math/big"

// grow ensures z.limbs has capacity for at least n limbs, reallocating
// (doubling) and copying the nlimbs live limbs if needed.  New limbs are
// zero (make_slice zero-fills); z.nlimbs is unchanged.  The old backing is
// RefDec'd by the normal assignment to z.limbs.
func grow(z @Nat, n int) {
	if len(z.limbs) >= n {
		return
	}
	var newCap int = len(z.limbs)
	if newCap < 1 {
		newCap = 1
	}
	for newCap < n {
		newCap = newCap * 2
	}
	var newLimbs @[]uint32 = make_slice(uint32, newCap)
	for i := 0; i < z.nlimbs; i++ {
		newLimbs[i] = z.limbs[i]
	}
	z.limbs = newLimbs
}

// New allocates a fresh zero Nat.  make zero-initializes the fields: limbs
// is an empty managed-slice (no backing) and nlimbs is 0 — the canonical
// zero, so no further work is needed.
func New() @Nat {
	return make(Nat)
}

// FromUint64 allocates a fresh Nat and sets it to v.
func FromUint64(v uint64) @Nat {
	var z @Nat = make(Nat)
	return z.SetUint64(v)
}

// SetUint64 writes v into z as zero, one, or two limbs (reusing z's backing
// via grow) and returns z.
func (z @Nat) SetUint64(v uint64) @Nat {
	if v == cast(uint64, 0) {
		z.nlimbs = 0
		return z
	}
	var lo uint32 = cast(uint32, v)
	var hi uint32 = cast(uint32, v >> 32)
	if hi == cast(uint32, 0) {
		grow(z, 1)
		z.limbs[0] = lo
		z.nlimbs = 1
	} else {
		grow(z, 2)
		z.limbs[0] = lo
		z.limbs[1] = hi
		z.nlimbs = 2
	}
	return z
}

// Set copies x's significant limbs into z (growing z's backing as needed)
// and returns z.  Correct when z aliases x: grow preserves the live limbs,
// and the copy is then an identity.
func (z @Nat) Set(x @Nat) @Nat {
	grow(z, x.nlimbs)
	for i := 0; i < x.nlimbs; i++ {
		z.limbs[i] = x.limbs[i]
	}
	z.nlimbs = x.nlimbs
	return z
}

// Clone allocates a fresh Nat with its own backing and copies x into it.
func (x @Nat) Clone() @Nat {
	var z @Nat = make(Nat)
	return z.Set(x)
}

// IsZero reports whether x is the canonical zero (no significant limbs).
func (x @Nat) IsZero() bool {
	return x.nlimbs == 0
}

// BitLen counts the bits in x's top limb plus 32 per lower limb; relies on
// the normalized invariant (top limb nonzero) so the count is exact.
func (x @Nat) BitLen() int {
	if x.nlimbs == 0 {
		return 0
	}
	var top uint32 = x.limbs[x.nlimbs - 1]
	var bits int = 0
	for top != cast(uint32, 0) {
		bits = bits + 1
		top = top >> 1
	}
	return (x.nlimbs - 1) * 32 + bits
}

// Cmp compares magnitudes.  Both operands are normalized, so a differing
// significant-limb count settles the order; otherwise compare limbs from the
// most significant down.
func (x @Nat) Cmp(y @Nat) int {
	if x.nlimbs != y.nlimbs {
		if x.nlimbs < y.nlimbs {
			return -1
		}
		return 1
	}
	var i int = x.nlimbs - 1
	for i >= 0 {
		if x.limbs[i] != y.limbs[i] {
			if x.limbs[i] < y.limbs[i] {
				return -1
			}
			return 1
		}
		i = i - 1
	}
	return 0
}

// IsUint64 reports whether x has at most two limbs (so ToUint64 is faithful).
func (x @Nat) IsUint64() bool {
	return x.nlimbs <= 2
}

// ToUint64 assembles x's low two limbs into a uint64 (the low 64 bits of x).
func (x @Nat) ToUint64() uint64 {
	var result uint64 = cast(uint64, 0)
	if x.nlimbs >= 1 {
		result = cast(uint64, x.limbs[0])
	}
	if x.nlimbs >= 2 {
		result = result | (cast(uint64, x.limbs[1]) << 32)
	}
	return result
}
