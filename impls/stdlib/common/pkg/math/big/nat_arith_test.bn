package "pkg/math/big"

import "pkg/builtins/testing"

// fail is shared with big_test.bn (same package).

// ============================================================
// Add / AddUint32
// ============================================================

func TestAddSmall() testing.TestResult {
	var s @Nat = New().Add(FromUint64(cast(uint64, 100)), FromUint64(cast(uint64, 200)))
	if s.ToUint64() != cast(uint64, 300) { return fail("100 + 200 should be 300") }
	if !s.IsUint64() { return fail("300 should be one limb") }
	return ""
}

func TestAddCarryAcrossLimb() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)   // 0xFFFFFFFF
	var s @Nat = New().Add(FromUint64(u32max), FromUint64(cast(uint64, 1)))
	if s.ToUint64() != (cast(uint64, 1) << 32) { return fail("0xFFFFFFFF + 1 should be 0x100000000") }
	if s.BitLen() != 33 { return fail("BitLen(0x100000000) should be 33") }
	return ""
}

func TestAddZero() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 42))
	if New().Add(a, New()).ToUint64() != cast(uint64, 42) { return fail("42 + 0 should be 42") }
	if New().Add(New(), a).ToUint64() != cast(uint64, 42) { return fail("0 + 42 should be 42") }
	if !New().Add(New(), New()).IsZero() { return fail("0 + 0 should be 0") }
	return ""
}

func TestAddTwoLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 5))
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 7))
	var s @Nat = New().Add(a, b)
	if s.ToUint64() != ((cast(uint64, 2) << 32) | cast(uint64, 12)) {
		return fail("(2^32+5) + (2^32+7) should be 2^33+12")
	}
	return ""
}

// z aliasing both x and y: z.Add(z, z) = 2z.
func TestAddSelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 5))
	a.Add(a, a)
	if a.ToUint64() != cast(uint64, 10) { return fail("a.Add(a, a) should double to 10") }
	return ""
}

func TestAddUint32() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	if New().AddUint32(FromUint64(u32max), cast(uint32, 1)).ToUint64() != (cast(uint64, 1) << 32) {
		return fail("0xFFFFFFFF + 1 (AddUint32) should be 0x100000000")
	}
	var a @Nat = FromUint64(cast(uint64, 42))
	if New().AddUint32(a, cast(uint32, 0)).ToUint64() != cast(uint64, 42) { return fail("x + 0 should be x") }
	if New().AddUint32(New(), cast(uint32, 7)).ToUint64() != cast(uint64, 7) { return fail("0 + 7 should be 7") }
	return ""
}

// ============================================================
// Sub
// ============================================================

func TestSubSimple() testing.TestResult {
	var d @Nat = New().Sub(FromUint64(cast(uint64, 300)), FromUint64(cast(uint64, 100)))
	if d.ToUint64() != cast(uint64, 200) { return fail("300 - 100 should be 200") }
	return ""
}

func TestSubBorrowAcrossLimb() testing.TestResult {
	// 0x100000000 - 1 = 0xFFFFFFFF, shrinking from 2 limbs to 1 (tests norm).
	var d @Nat = New().Sub(FromUint64(cast(uint64, 1) << 32), FromUint64(cast(uint64, 1)))
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	if d.ToUint64() != u32max { return fail("0x100000000 - 1 should be 0xFFFFFFFF") }
	if d.BitLen() != 32 { return fail("BitLen(0xFFFFFFFF) should be 32") }
	if !d.IsUint64() { return fail("result should be one limb after norm") }
	return ""
}

func TestSubToZero() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 12345))
	var d @Nat = New().Sub(a, a)
	if !d.IsZero() { return fail("a - a should be zero") }
	if d.BitLen() != 0 { return fail("BitLen(0) should be 0") }
	return ""
}

func TestSubTwoLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 2) << 32) | cast(uint64, 12))
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 5))
	var d @Nat = New().Sub(a, b)
	if d.ToUint64() != ((cast(uint64, 1) << 32) | cast(uint64, 7)) {
		return fail("(2^33+12) - (2^32+5) should be 2^32+7")
	}
	return ""
}

// ============================================================
// MulUint32 / Mul
// ============================================================

func TestMulUint32Small() testing.TestResult {
	if New().MulUint32(FromUint64(cast(uint64, 12)), cast(uint32, 10)).ToUint64() != cast(uint64, 120) {
		return fail("12 * 10 should be 120")
	}
	return ""
}

func TestMulUint32Carry() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	var p @Nat = New().MulUint32(FromUint64(u32max), cast(uint32, 0xFFFFFFFF))
	if p.ToUint64() != cast(uint64, 0xFFFFFFFE00000001) {
		return fail("0xFFFFFFFF * 0xFFFFFFFF should be 0xFFFFFFFE00000001")
	}
	return ""
}

func TestMulUint32Zero() testing.TestResult {
	if !New().MulUint32(FromUint64(cast(uint64, 99)), cast(uint32, 0)).IsZero() { return fail("x * 0 should be 0") }
	if !New().MulUint32(New(), cast(uint32, 5)).IsZero() { return fail("0 * m should be 0") }
	return ""
}

func TestMulSmall() testing.TestResult {
	var p @Nat = New().Mul(FromUint64(cast(uint64, 1000)), FromUint64(cast(uint64, 1000)))
	if p.ToUint64() != cast(uint64, 1000000) { return fail("1000 * 1000 should be 1000000") }
	if !p.IsUint64() { return fail("1000000 should normalize to fit a uint64") }
	return ""
}

// a*a where a = 2^32+1: the product (2^64 + 2^33 + 1) is THREE limbs —
// exercises cross-limb carry/accumulation AND the >2-limb paths
// (IsUint64 false, ToUint64 dropping the high limb, BitLen across limbs).
func TestMulThreeLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))
	var p @Nat = New().Mul(a, a)
	if p.IsUint64() { return fail("(2^32+1)^2 should NOT fit a uint64 (3 limbs)") }
	if p.BitLen() != 65 { return fail("BitLen((2^32+1)^2) should be 65") }
	// ToUint64 returns the low 64 bits = 2^33 + 1.
	if p.ToUint64() != ((cast(uint64, 2) << 32) | cast(uint64, 1)) {
		return fail("low 64 bits of (2^32+1)^2 should be 2^33+1")
	}
	return ""
}

func TestMulByZeroNat() testing.TestResult {
	if !New().Mul(FromUint64(cast(uint64, 123)), New()).IsZero() { return fail("x * 0 should be 0") }
	if !New().Mul(New(), FromUint64(cast(uint64, 123))).IsZero() { return fail("0 * x should be 0") }
	return ""
}

func TestMulIdentity() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 9))
	if New().Mul(a, FromUint64(cast(uint64, 1))).ToUint64() != a.ToUint64() { return fail("x * 1 should be x") }
	return ""
}

// z aliasing both x and y: z.Mul(z, z) = z^2.
func TestMulSelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 7))
	a.Mul(a, a)
	if a.ToUint64() != cast(uint64, 49) { return fail("a.Mul(a, a) should square to 49") }
	return ""
}
