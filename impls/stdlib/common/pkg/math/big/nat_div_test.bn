package "pkg/math/big"

import "pkg/builtins/testing"

// fail is shared with big_test.bn (same package).

func TestDivModUint32Small() testing.TestResult {
	var q @Nat = New()
	var r uint32 = cast(uint32, 0)
	q, r = q.DivModUint32(FromUint64(cast(uint64, 1000)), cast(uint32, 7))
	if q.ToUint64() != cast(uint64, 142) { return fail("1000 / 7 should be 142") }
	if r != cast(uint32, 6) { return fail("1000 % 7 should be 6") }
	return ""
}

func TestDivModUint32Exact() testing.TestResult {
	var q @Nat = New()
	var r uint32 = cast(uint32, 0)
	q, r = q.DivModUint32(FromUint64(cast(uint64, 1000)), cast(uint32, 10))
	if q.ToUint64() != cast(uint64, 100) { return fail("1000 / 10 should be 100") }
	if r != cast(uint32, 0) { return fail("1000 % 10 should be 0") }
	return ""
}

func TestDivModUint32ByOne() testing.TestResult {
	var q @Nat = New()
	var r uint32 = cast(uint32, 0)
	q, r = q.DivModUint32(FromUint64(cast(uint64, 123456789)), cast(uint32, 1))
	if q.ToUint64() != cast(uint64, 123456789) { return fail("x / 1 should be x") }
	if r != cast(uint32, 0) { return fail("x % 1 should be 0") }
	return ""
}

// Multi-limb dividend, division rippling across the limb boundary:
// UINT64_MAX / 3 = 0x5555555555555555 exactly.
func TestDivModUint32MultiLimb() testing.TestResult {
	var q @Nat = New()
	var r uint32 = cast(uint32, 0)
	q, r = q.DivModUint32(FromUint64(cast(uint64, 0) - cast(uint64, 1)), cast(uint32, 3))
	if q.ToUint64() != cast(uint64, 0x5555555555555555) { return fail("UINT64_MAX / 3 should be 0x5555555555555555") }
	if r != cast(uint32, 0) { return fail("UINT64_MAX % 3 should be 0") }
	return ""
}

// Quotient shrinks from a 2-limb dividend to a 1-limb result (norm trims).
func TestDivModUint32QuotientShrinks() testing.TestResult {
	var q @Nat = New()
	var r uint32 = cast(uint32, 0)
	q, r = q.DivModUint32(FromUint64(cast(uint64, 1) << 32), cast(uint32, 2))
	if q.ToUint64() != (cast(uint64, 1) << 31) { return fail("0x100000000 / 2 should be 0x80000000") }
	if !q.IsUint64() { return fail("quotient should be one limb after norm") }
	if r != cast(uint32, 0) { return fail("0x100000000 % 2 should be 0") }
	return ""
}

func TestDivModUint32ZeroDividend() testing.TestResult {
	var q @Nat = New()
	var r uint32 = cast(uint32, 0)
	q, r = q.DivModUint32(New(), cast(uint32, 5))
	if !q.IsZero() { return fail("0 / 5 should be 0") }
	if r != cast(uint32, 0) { return fail("0 % 5 should be 0") }
	return ""
}

// z aliasing x: a.DivModUint32(a, m).
func TestDivModUint32SelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 1000))
	var r uint32 = cast(uint32, 0)
	a, r = a.DivModUint32(a, cast(uint32, 7))
	if a.ToUint64() != cast(uint64, 142) { return fail("a.DivModUint32(a, 7) quotient should be 142") }
	if r != cast(uint32, 6) { return fail("a.DivModUint32(a, 7) remainder should be 6") }
	return ""
}

// ============================================================
// DivMod (Knuth Algorithm D)
// ============================================================

// checkDivMod verifies the division contract: r < y and q*y + r == x.
func checkDivMod(x @Nat, y @Nat) testing.TestResult {
	var z @Nat = New()
	var rr @Nat = New()
	z, rr = z.DivMod(x, y, rr)
	if rr.Cmp(y) >= 0 { return fail("DivMod: remainder must be < divisor") }
	var recon @Nat = New().Mul(z, y)
	recon.Add(recon, rr)
	if recon.Cmp(x) != 0 { return fail("DivMod: q*y + r must equal x") }
	return ""
}

// Exact division by a 2-limb divisor: (2^32+1)*(2^32+7) / (2^32+1) = 2^32+7.
func TestDivModExactTwoLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))   // 2^32+1
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 7))   // 2^32+7
	var x @Nat = New().Mul(a, b)
	var z @Nat = New()
	var rr @Nat = New()
	z, rr = z.DivMod(x, a, rr)
	if z.ToUint64() != ((cast(uint64, 1) << 32) | cast(uint64, 7)) {
		return fail("(2^32+1)*(2^32+7) / (2^32+1) should be 2^32+7")
	}
	if !rr.IsZero() { return fail("exact division should leave no remainder") }
	return checkDivMod(x, a)
}

// Division with a remainder by a 2-limb divisor.
func TestDivModRemainderTwoLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))   // 2^32+1
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 7))   // 2^32+7
	var x @Nat = New().Mul(a, b)
	x.AddUint32(x, cast(uint32, 99))                                     // a*b + 99
	var z @Nat = New()
	var rr @Nat = New()
	z, rr = z.DivMod(x, a, rr)
	if z.ToUint64() != ((cast(uint64, 1) << 32) | cast(uint64, 7)) {
		return fail("(a*b + 99) / a quotient should be b (99 < a)")
	}
	if rr.ToUint64() != cast(uint64, 99) { return fail("(a*b + 99) % a should be 99") }
	return checkDivMod(x, a)
}

// x < y: quotient 0, remainder x.
func TestDivModXLessThanY() testing.TestResult {
	var x @Nat = FromUint64(cast(uint64, 5))
	var y @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))
	var z @Nat = New()
	var rr @Nat = New()
	z, rr = z.DivMod(x, y, rr)
	if !z.IsZero() { return fail("x < y quotient should be 0") }
	if rr.ToUint64() != cast(uint64, 5) { return fail("x < y remainder should be x") }
	return ""
}

// x == y: quotient 1, remainder 0.
func TestDivModEqual() testing.TestResult {
	var y @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 9))
	var x @Nat = y.Clone()
	var z @Nat = New()
	var rr @Nat = New()
	z, rr = z.DivMod(x, y, rr)
	if z.ToUint64() != cast(uint64, 1) { return fail("x == y quotient should be 1") }
	if !rr.IsZero() { return fail("x == y remainder should be 0") }
	return ""
}

// Divisor whose top limb's high bit is clear, exercising the normalization
// shift (clz = 30 here).
func TestDivModNormalization() testing.TestResult {
	var y @Nat = FromUint64((cast(uint64, 3) << 32) | cast(uint64, 5))   // top limb 3 -> shift 30
	var x @Nat = New().Mul(y, FromUint64(cast(uint64, 1234567)))
	x.AddUint32(x, cast(uint32, 41))
	var z @Nat = New()
	var rr @Nat = New()
	z, rr = z.DivMod(x, y, rr)
	if z.ToUint64() != cast(uint64, 1234567) { return fail("normalization-path quotient wrong") }
	if rr.ToUint64() != cast(uint64, 41) { return fail("normalization-path remainder wrong") }
	return checkDivMod(x, y)
}

// Single-limb divisor routes through DivModUint32.
func TestDivModSingleLimbDivisor() testing.TestResult {
	var x @Nat = New().Mul(FromUint64(cast(uint64, 0) - cast(uint64, 1)), FromUint64(cast(uint64, 12345)))   // big
	var y @Nat = FromUint64(cast(uint64, 7))
	return checkDivMod(x, y)
}

// Larger multi-limb division: a 4-limb dividend over a 2-limb divisor.
func TestDivModLarge() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 0xDEADBEEF) << 32) | cast(uint64, 0x12345678))
	var b @Nat = FromUint64((cast(uint64, 0xCAFEBABE) << 32) | cast(uint64, 0x87654321))
	var x @Nat = New().Mul(a, b)            // 4-limb product
	var r1 testing.TestResult = checkDivMod(x, b)
	if len(r1) > 0 { return r1 }
	// And with a remainder.
	x.AddUint32(x, cast(uint32, 123))
	return checkDivMod(x, b)
}

// A spread of multi-limb pairs, including ones needing normalization, to
// exercise the estimate/multiply-subtract loop (and, opportunistically, the
// add-back path) across varied limb patterns.
func TestDivModSpread() testing.TestResult {
	var hi @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1))             // UINT64_MAX
	var big @Nat = New().Mul(hi, hi)                                        // (2^64-1)^2, ~4 limbs
	var d1 @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))     // normalized-ish
	var d2 @Nat = FromUint64((cast(uint64, 1) << 33) | cast(uint64, 0xFFFFFFFF))   // needs shift
	var d3 @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1))             // UINT64_MAX (top bit set)
	var r1 testing.TestResult = checkDivMod(big, d1)
	if len(r1) > 0 { return r1 }
	var r2 testing.TestResult = checkDivMod(big, d2)
	if len(r2) > 0 { return r2 }
	var r3 testing.TestResult = checkDivMod(big, d3)
	if len(r3) > 0 { return r3 }
	return ""
}
