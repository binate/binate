package "pkg/math/big"

import "pkg/builtins/testing"

// fail is shared with big_test.bn (same package).

// ============================================================
// Shl
// ============================================================

func TestShlWithinLimb() testing.TestResult {
	if New().Shl(FromUint64(cast(uint64, 1)), 5).ToUint64() != cast(uint64, 32) {
		return fail("1 << 5 should be 32")
	}
	return ""
}

func TestShlAcrossWord() testing.TestResult {
	var s @Nat = New().Shl(FromUint64(cast(uint64, 1)), 32)
	if s.ToUint64() != (cast(uint64, 1) << 32) { return fail("1 << 32 should be 0x100000000") }
	if s.BitLen() != 33 { return fail("BitLen(1<<32) should be 33") }
	return ""
}

func TestShlWordAndBit() testing.TestResult {
	if New().Shl(FromUint64(cast(uint64, 1)), 33).ToUint64() != (cast(uint64, 1) << 33) {
		return fail("1 << 33 should be 0x200000000")
	}
	return ""
}

func TestShlCarryOut() testing.TestResult {
	// 0x80000000 << 1 carries out of the top of the limb into a new one.
	var x @Nat = FromUint64(cast(uint64, 1) << 31)
	if New().Shl(x, 1).ToUint64() != (cast(uint64, 1) << 32) {
		return fail("0x80000000 << 1 should be 0x100000000")
	}
	return ""
}

func TestShlMultiLimb() testing.TestResult {
	var x @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))   // 0x100000001
	if New().Shl(x, 4).ToUint64() != ((cast(uint64, 1) << 36) | (cast(uint64, 1) << 4)) {
		return fail("0x100000001 << 4 should be 0x1000000010")
	}
	return ""
}

// Shift past the uint64 range: UINT64_MAX << 4 = 2^68 - 16 (3 limbs).
func TestShlBeyondUint64() testing.TestResult {
	var x @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1))
	var s @Nat = New().Shl(x, 4)
	if s.IsUint64() { return fail("UINT64_MAX << 4 should NOT fit uint64") }
	if s.BitLen() != 68 { return fail("BitLen(UINT64_MAX << 4) should be 68") }
	if s.ToUint64() != (cast(uint64, 0) - cast(uint64, 16)) {
		return fail("low 64 bits of UINT64_MAX << 4 should be 0xFFFFFFFFFFFFFFF0")
	}
	return ""
}

func TestShlZeroAndIdentity() testing.TestResult {
	if !New().Shl(New(), 7).IsZero() { return fail("0 << 7 should be 0") }
	if New().Shl(FromUint64(cast(uint64, 42)), 0).ToUint64() != cast(uint64, 42) {
		return fail("x << 0 should be x")
	}
	return ""
}

func TestShlSelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 3))
	a.Shl(a, 4)
	if a.ToUint64() != cast(uint64, 48) { return fail("a.Shl(a, 4) should be 48") }
	return ""
}

// ============================================================
// Shr
// ============================================================

func TestShrWithinLimb() testing.TestResult {
	if New().Shr(FromUint64(cast(uint64, 32)), 5).ToUint64() != cast(uint64, 1) {
		return fail("32 >> 5 should be 1")
	}
	return ""
}

func TestShrAcrossWord() testing.TestResult {
	if New().Shr(FromUint64(cast(uint64, 1) << 32), 1).ToUint64() != (cast(uint64, 1) << 31) {
		return fail("0x100000000 >> 1 should be 0x80000000")
	}
	return ""
}

func TestShrWordAligned() testing.TestResult {
	if New().Shr(FromUint64(cast(uint64, 1) << 32), 32).ToUint64() != cast(uint64, 1) {
		return fail("0x100000000 >> 32 should be 1")
	}
	return ""
}

func TestShrToZero() testing.TestResult {
	if !New().Shr(FromUint64(cast(uint64, 5)), 10).IsZero() { return fail("5 >> 10 should be 0") }
	// wordShift >= nlimbs path.
	if !New().Shr(FromUint64(cast(uint64, 5)), 64).IsZero() { return fail("5 >> 64 should be 0") }
	return ""
}

// Shr early-returns: a zero operand and a zero shift count.
func TestShrZeroAndIdentity() testing.TestResult {
	if !New().Shr(New(), 7).IsZero() { return fail("0 >> 7 should be 0") }
	if New().Shr(FromUint64(cast(uint64, 42)), 0).ToUint64() != cast(uint64, 42) {
		return fail("x >> 0 should be x")
	}
	return ""
}

func TestShrSelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 48))
	a.Shr(a, 4)
	if a.ToUint64() != cast(uint64, 3) { return fail("a.Shr(a, 4) should be 3") }
	return ""
}

// (x << n) >> n == x for a multi-limb x and a non-word-aligned n.
func TestShlShrRoundTrip() testing.TestResult {
	var x @Nat = FromUint64((cast(uint64, 0xABCDEF) << 32) | cast(uint64, 0x12345678))
	var shifted @Nat = New().Shl(x, 13)
	var back @Nat = New().Shr(shifted, 13)
	if back.Cmp(x) != 0 { return fail("(x << 13) >> 13 should equal x") }
	return ""
}
