package "pkg/std/errors"

// withContext builds "<context>: <causeMsg>" in a freshly-allocated
// managed-slice the caller owns — wrappedError.Error()'s rendering of
// one layer prepended to its cause.  Tier-1 packages avoid
// pkg/binate/buf (tier-2), so the join is a plain make_slice + copy,
// the same idiom strconv's Format* family uses.
func withContext(context @[]readonly char, causeMsg @[]readonly char) @[]readonly char {
	var sep *[]readonly char = ": "
	var total int = len(context) + len(sep) + len(causeMsg)
	var out @[]char = make_slice(char, total)
	var p int = 0
	for i := 0; i < len(context); i++ {
		out[p] = context[i]
		p = p + 1
	}
	for i := 0; i < len(sep); i++ {
		out[p] = sep[i]
		p = p + 1
	}
	for i := 0; i < len(causeMsg); i++ {
		out[p] = causeMsg[i]
		p = p + 1
	}
	return out
}

// leafError is the bottom of a chain: a message and no cause.  New
// returns one boxed into @Error.
type leafError struct {
	msg @[]readonly char
}

// Error returns the leaf's message as a refcounted reference to the
// owned slice (no copy) — the caller gets its own reference.
func (e *leafError) Error() @[]readonly char {
	return e.msg
}

// Unwrap returns an empty @Error: a leaf has no cause, and emptiness
// (tested with `present`) is how that is reported.
func (e *leafError) Unwrap() @Error {
	var none @Error
	return none
}

impl *leafError : Error

// wrappedError adds a layer of context (msg) over a cause.  Its
// Error() renders "msg: <cause's message>"; its Unwrap() yields the
// cause.  The cause @Error field is a managed-interface-value field —
// its scope-exit dtor RefDec's the wrapped error when this one is
// released.
type wrappedError struct {
	msg   @[]readonly char
	cause @Error
}

// Error renders this layer's context prepended to the cause's
// rendered message, so Error() on the outermost wrapper produces the
// whole chain.
func (e *wrappedError) Error() @[]readonly char {
	var causeMsg @[]readonly char = e.cause.Error()
	return withContext(e.msg, causeMsg)
}

// Unwrap returns the wrapped cause.
func (e *wrappedError) Unwrap() @Error {
	return e.cause
}

impl *wrappedError : Error

// New returns a leaf Error carrying msg.  A string literal is copied
// into the error's owned message by the @[]char argument coercion, so
// `errors.New("file not found")` works directly.
func New(msg @[]readonly char) @Error {
	var le @leafError = make(leafError)
	le.msg = msg
	var e @Error = le
	return e
}

// Wrap returns an Error that adds context msg over cause.
func Wrap(cause @Error, msg @[]readonly char) @Error {
	var we @wrappedError = make(wrappedError)
	we.msg = msg
	we.cause = cause
	var e @Error = we
	return e
}

// Is reports whether any error in err's Unwrap() chain is the same error
// object as target.  This is the sentinel test — `errors.Is(err, io.EOF)`
// — and because it walks the chain it matches the sentinel even when it
// has been wrapped with context.  The per-layer comparison is reference
// identity (`same`): an interface value is the same iff its {data,
// vtable} words match, so a layer matches target iff it is the very same
// boxed error.  The walk stops at the empty @Error a leaf's Unwrap()
// returns (`present` is false), so an acyclic chain terminates.
func Is(err @Error, target @Error) bool {
	var cur @Error = err
	for present(cur) {
		if same(cur, target) {
			return true
		}
		cur = cur.Unwrap()
	}
	return false
}
