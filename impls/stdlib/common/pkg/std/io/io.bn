package "pkg/std/io"

import "pkg/std/errors"

// EOF is constructed once at package init: the synthetic
// pkg/std/io.__init runs this initializer before main.  The allocation
// is a process-lifetime singleton — a package global is never released.
var EOF @errors.Error = errors.New("EOF")

// IsEOF reports whether err is the EOF sentinel — errors.Is(err, EOF),
// so it matches EOF even through wrapping.  EOF carries no payload, so
// reference identity (what errors.Is / same test) is exactly the right
// notion of "is this EOF".
func IsEOF(err @errors.Error) bool {
	return errors.Is(err, EOF)
}
