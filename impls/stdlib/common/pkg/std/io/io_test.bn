package "pkg/std/io"

import "pkg/builtins/testing"
import "pkg/std/errors"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// IsEOF is true for the EOF sentinel and false for a distinct error
// (identity, not message text).
func TestIsEOFSentinel() testing.TestResult {
	if !IsEOF(EOF) { return fail("IsEOF(EOF) should be true") }
	var other @errors.Error = errors.New("nope")
	if IsEOF(other) { return fail("IsEOF(distinct error) should be false") }
	return ""
}

// IsEOF matches EOF even when it has been wrapped with context — it goes
// through errors.Is, which walks the Unwrap() chain.
func TestIsEOFThroughWrap() testing.TestResult {
	var wrapped @errors.Error = errors.Wrap(EOF, "reading header")
	if !IsEOF(wrapped) { return fail("IsEOF should see a wrapped EOF") }
	return ""
}

// IsEOF on the empty error (no error) is false.
func TestIsEOFEmpty() testing.TestResult {
	var none @errors.Error
	if IsEOF(none) { return fail("IsEOF(empty) should be false") }
	return ""
}

// EOF roots in errors.ConditionsUnmet, so the general classification
// matches alongside the specific IsEOF test — including through a wrap.
func TestEOFRootsInConditionsUnmet() testing.TestResult {
	if !errors.Is(EOF, errors.ConditionsUnmet) {
		return fail("io.EOF should root in errors.ConditionsUnmet")
	}
	var w @errors.Error = errors.Wrap(EOF, "reading header")
	if !IsEOF(w) { return fail("wrapped EOF is still EOF") }
	if !errors.Is(w, errors.ConditionsUnmet) {
		return fail("wrapped EOF is-a ConditionsUnmet")
	}
	return ""
}
