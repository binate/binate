package "pkg/std/math"

import "pkg/builtins/testing"

func TestAtan() testing.TestResult {
	if Atan(0.0) != 0.0 { return "Atan(0)" }
	if Float64bits(Atan(1.0)) != 0x3FE921FB54442D18 { return "Atan(1) should be Pi/4" }
	if Float64bits(Atan(-1.0)) != 0xBFE921FB54442D18 { return "Atan(-1)" }
	if Float64bits(Atan(0.5)) != 0x3FDDAC670561BB4F { return "Atan(0.5)" }
	if Float64bits(Atan(2.0)) != 0x3FF1B6E192EBBE44 { return "Atan(2)" }
	if Float64bits(Atan(0.66)) != 0x3FE2AAFDDE4D0C9F { return "Atan(0.66)" }
	if Float64bits(Atan(0.7)) != 0x3FE38B112D7BD4AD { return "Atan(0.7)" }
	if Float64bits(Atan(3.0)) != 0x3FF3FC176B7A8560 { return "Atan(3)" }
	if Float64bits(Atan(100.0)) != 0x3FF8F905EB2DEF21 { return "Atan(100)" }
	return ""
}

func TestAtanSpecials() testing.TestResult {
	if Float64bits(Atan(Inf(1))) != 0x3FF921FB54442D18 { return "Atan(+Inf) should be Pi/2" }
	if Float64bits(Atan(Inf(-1))) != 0xBFF921FB54442D18 { return "Atan(-Inf) should be -Pi/2" }
	if !IsNaN(Atan(NaN())) { return "Atan(NaN)" }
	return ""
}

func TestAtan2() testing.TestResult {
	if Float64bits(Atan2(1.0, 1.0)) != 0x3FE921FB54442D18 { return "Atan2(1,1) Pi/4" }
	if Float64bits(Atan2(1.0, -1.0)) != 0x4002D97C7F3321D2 { return "Atan2(1,-1) 3Pi/4" }
	if Float64bits(Atan2(-1.0, -1.0)) != 0xC002D97C7F3321D2 { return "Atan2(-1,-1)" }
	if Float64bits(Atan2(-1.0, 1.0)) != 0xBFE921FB54442D18 { return "Atan2(-1,1)" }
	if Float64bits(Atan2(3.0, 4.0)) != 0x3FE4978FA3269EE1 { return "Atan2(3,4)" }
	return ""
}

func TestAtan2Specials() testing.TestResult {
	// y==0: +0 for x>=0, ±Pi for x<0 (sign of y).
	if Atan2(0.0, 1.0) != 0.0 { return "Atan2(0,1)" }
	if Float64bits(Atan2(0.0, -1.0)) != 0x400921FB54442D18 { return "Atan2(0,-1) should be Pi" }
	// x==0: ±Pi/2 (sign of y).
	if Float64bits(Atan2(1.0, 0.0)) != 0x3FF921FB54442D18 { return "Atan2(1,0) Pi/2" }
	if Float64bits(Atan2(-1.0, 0.0)) != 0xBFF921FB54442D18 { return "Atan2(-1,0) -Pi/2" }
	if !IsNaN(Atan2(NaN(), 1.0)) { return "Atan2(NaN,1)" }
	if !IsNaN(Atan2(1.0, NaN())) { return "Atan2(1,NaN)" }
	return ""
}

func TestAsinAcos() testing.TestResult {
	if Asin(0.0) != 0.0 { return "Asin(0)" }
	if Float64bits(Asin(1.0)) != 0x3FF921FB54442D18 { return "Asin(1) Pi/2" }
	if Float64bits(Asin(-1.0)) != 0xBFF921FB54442D18 { return "Asin(-1)" }
	if Float64bits(Asin(0.5)) != 0x3FE0C152382D7366 { return "Asin(0.5)" }
	if Float64bits(Asin(0.7)) != 0x3FE8D00E692AFD95 { return "Asin(0.7)" }
	if Float64bits(Asin(0.8)) != 0x3FEDAC670561BB50 { return "Asin(0.8)" }
	if Float64bits(Acos(1.0)) != 0x0000000000000000 { return "Acos(1) should be 0" }
	if Float64bits(Acos(0.5)) != 0x3FF0C152382D7365 { return "Acos(0.5)" }
	if Float64bits(Acos(0.0)) != 0x3FF921FB54442D18 { return "Acos(0) Pi/2" }
	if Float64bits(Acos(-1.0)) != 0x400921FB54442D18 { return "Acos(-1) Pi" }
	if Float64bits(Acos(0.8)) != 0x3FE4978FA3269EE0 { return "Acos(0.8)" }
	return ""
}

func TestAsinAcosSpecials() testing.TestResult {
	if !IsNaN(Asin(2.0)) { return "Asin(2) should be NaN" }
	if !IsNaN(Asin(-2.0)) { return "Asin(-2) should be NaN" }
	if !IsNaN(Acos(2.0)) { return "Acos(2) should be NaN" }
	return ""
}
