package "pkg/std/math"

// Bessel functions of the first and second kinds, orders 0 and 1.
// Ported from Go's math/j0.go and math/j1.go (FreeBSD fdlibm e_j0.c / e_j1.c).
//
// NOTE: Binate has no Sincos; we call Sin(x) and Cos(x) separately, which
// is bit-identical to Go's Sincos result. SqrtPi and MaxFloat64 are package
// consts. Shift binds LOOSER than +/- in Binate, but these functions use no
// shifts on float paths; the only shifts are in the const initializers below,
// fully parenthesized.

// ---- J0 R0/S0 coefficients on [0,2] ----
const (
	j0R02 float64 = 1.56249999999999947958e-02
	j0R03 float64 = -1.89979294238854721751e-04
	j0R04 float64 = 1.82954049532700665670e-06
	j0R05 float64 = -4.61832688532103189199e-09
	j0S01 float64 = 1.56191029464890010492e-02
	j0S02 float64 = 1.16926784663337450260e-04
	j0S03 float64 = 5.13546550207318111446e-07
	j0S04 float64 = 1.16614003333790000205e-09
)

// 2**-27, 2**-13, 2**129 as float64 (exact powers of two).
const (
	jbTwoM27 float64 = 1.0 / cast(float64, (1 << 27))
	jbTwoM13 float64 = 1.0 / cast(float64, (1 << 13))
	jbTwoM54 float64 = 1.0 / cast(float64, (cast(int64, 1) << 54))
	// 2**129 cannot be formed by an int shift (overflows int64); use literal.
	jbTwo129 float64 = 6.80564733841876926926749214863536422912e+38
)

// J0 returns the order-zero Bessel function of the first kind.
//   J0(±Inf) = 0
//   J0(0)    = 1
//   J0(NaN)  = NaN
func J0(x float64) float64 {
	if IsNaN(x) {
		return x
	}
	if IsInf(x, 0) {
		return 0.0
	}
	if x == 0.0 {
		return 1.0
	}

	x = Abs(x)
	if x >= 2.0 {
		var s float64 = Sin(x)
		var c float64 = Cos(x)
		var ss float64 = s - c
		var cc float64 = s + c
		if x < MaxFloat64*0.5 {
			var z float64 = -Cos(x + x)
			if s*c < 0.0 {
				cc = z / ss
			} else {
				ss = z / cc
			}
		}
		var z float64
		if x > jbTwo129 {
			z = (1.0 / SqrtPi) * cc / Sqrt(x)
		} else {
			var u float64 = pzero(x)
			var v float64 = qzero(x)
			z = (1.0 / SqrtPi) * (u*cc - v*ss) / Sqrt(x)
		}
		return z
	}
	if x < jbTwoM13 {
		if x < jbTwoM27 {
			return 1.0
		}
		return 1.0 - 0.25*x*x
	}
	var z float64 = x * x
	var r float64 = z * (j0R02 + z*(j0R03+z*(j0R04+z*j0R05)))
	var s float64 = 1.0 + z*(j0S01+z*(j0S02+z*(j0S03+z*j0S04)))
	if x < 1.0 {
		return 1.0 + z*(-0.25+(r/s))
	}
	var u float64 = 0.5 * x
	return (1.0+u)*(1.0-u) + z*(r/s)
}

// ---- Y0 U/V coefficients on [0,2] ----
const (
	y0U00 float64 = -7.38042951086872317523e-02
	y0U01 float64 = 1.76666452509181115538e-01
	y0U02 float64 = -1.38185671945596898896e-02
	y0U03 float64 = 3.47453432093683650238e-04
	y0U04 float64 = -3.81407053724364161125e-06
	y0U05 float64 = 1.95590137035022920206e-08
	y0U06 float64 = -3.98205194132103398453e-11
	y0V01 float64 = 1.27304834834123699328e-02
	y0V02 float64 = 7.60068627350353253702e-05
	y0V03 float64 = 2.59150851840457805467e-07
	y0V04 float64 = 4.41110311332675467403e-10
)

// Y0 returns the order-zero Bessel function of the second kind.
//   Y0(+Inf)  = 0
//   Y0(0)     = -Inf
//   Y0(x < 0) = NaN
//   Y0(NaN)   = NaN
func Y0(x float64) float64 {
	if x < 0.0 || IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return 0.0
	}
	if x == 0.0 {
		return Inf(-1)
	}

	if x >= 2.0 {
		var s float64 = Sin(x)
		var c float64 = Cos(x)
		var ss float64 = s - c
		var cc float64 = s + c
		if x < MaxFloat64*0.5 {
			var z float64 = -Cos(x + x)
			if s*c < 0.0 {
				cc = z / ss
			} else {
				ss = z / cc
			}
		}
		var z float64
		if x > jbTwo129 {
			z = (1.0 / SqrtPi) * ss / Sqrt(x)
		} else {
			var u float64 = pzero(x)
			var v float64 = qzero(x)
			z = (1.0 / SqrtPi) * (u*ss + v*cc) / Sqrt(x)
		}
		return z
	}
	if x <= jbTwoM27 {
		return y0U00 + (2.0/Pi)*Log(x)
	}
	var z float64 = x * x
	var u float64 = y0U00 + z*(y0U01+z*(y0U02+z*(y0U03+z*(y0U04+z*(y0U05+z*y0U06)))))
	var v float64 = 1.0 + z*(y0V01+z*(y0V02+z*(y0V03+z*y0V04)))
	return u/v + (2.0/Pi)*J0(x)*Log(x)
}

// ---- pzero coefficient tables (J0/Y0 asymptotic) ----
var p0R8 [6]float64 = [6]float64{0.00000000000000000000e+00, -7.03124999999900357484e-02, -8.08167041275349795626e+00, -2.57063105679704847262e+02, -2.48521641009428822144e+03, -5.25304380490729545272e+03}
var p0S8 [5]float64 = [5]float64{1.16534364619668181717e+02, 3.83374475364121826715e+03, 4.05978572648472545552e+04, 1.16752972564375915681e+05, 4.76277284146730962675e+04}
var p0R5 [6]float64 = [6]float64{-1.14125464691894502584e-11, -7.03124940873599280078e-02, -4.15961064470587782438e+00, -6.76747652265167261021e+01, -3.31231299649172967747e+02, -3.46433388365604912451e+02}
var p0S5 [5]float64 = [5]float64{6.07539382692300335975e+01, 1.05125230595704579173e+03, 5.97897094333855784498e+03, 9.62544514357774460223e+03, 2.40605815922939109441e+03}
var p0R3 [6]float64 = [6]float64{-2.54704601771951915620e-09, -7.03119616381481654654e-02, -2.40903221549529611423e+00, -2.19659774734883086467e+01, -5.80791704701737572236e+01, -3.14479470594888503854e+01}
var p0S3 [5]float64 = [5]float64{3.58560338055209726349e+01, 3.61513983050303863820e+02, 1.19360783792111533330e+03, 1.12799679856907414432e+03, 1.73580930813335754692e+02}
var p0R2 [6]float64 = [6]float64{-8.87534333032526411254e-08, -7.03030995483624743247e-02, -1.45073846780952986357e+00, -7.63569613823527770791e+00, -1.11931668860356747786e+01, -3.23364579351335335033e+00}
var p0S2 [5]float64 = [5]float64{2.22202997532088808441e+01, 1.36206794218215208048e+02, 2.70470278658083486789e+02, 1.53875394208320329881e+02, 1.46576176948256193810e+01}

// pzero evaluates the P(0,x) asymptotic ratio for x >= 2.
// Selects coefficient tables by region, evaluating in place to avoid
// pointer-to-array (Go uses &p0R8 etc.); each branch runs its own Horner.
func pzero(x float64) float64 {
	var z float64 = 1.0 / (x * x)
	var r float64
	var s float64
	if x >= 8.0 {
		r = p0R8[0] + z*(p0R8[1]+z*(p0R8[2]+z*(p0R8[3]+z*(p0R8[4]+z*p0R8[5]))))
		s = 1.0 + z*(p0S8[0]+z*(p0S8[1]+z*(p0S8[2]+z*(p0S8[3]+z*p0S8[4]))))
	} else if x >= 4.5454 {
		r = p0R5[0] + z*(p0R5[1]+z*(p0R5[2]+z*(p0R5[3]+z*(p0R5[4]+z*p0R5[5]))))
		s = 1.0 + z*(p0S5[0]+z*(p0S5[1]+z*(p0S5[2]+z*(p0S5[3]+z*p0S5[4]))))
	} else if x >= 2.8571 {
		r = p0R3[0] + z*(p0R3[1]+z*(p0R3[2]+z*(p0R3[3]+z*(p0R3[4]+z*p0R3[5]))))
		s = 1.0 + z*(p0S3[0]+z*(p0S3[1]+z*(p0S3[2]+z*(p0S3[3]+z*p0S3[4]))))
	} else {
		r = p0R2[0] + z*(p0R2[1]+z*(p0R2[2]+z*(p0R2[3]+z*(p0R2[4]+z*p0R2[5]))))
		s = 1.0 + z*(p0S2[0]+z*(p0S2[1]+z*(p0S2[2]+z*(p0S2[3]+z*p0S2[4]))))
	}
	return 1.0 + r/s
}

// ---- qzero coefficient tables (J0/Y0 asymptotic) ----
var q0R8 [6]float64 = [6]float64{0.00000000000000000000e+00, 7.32421874999935051953e-02, 1.17682064682252693899e+01, 5.57673380256401856059e+02, 8.85919720756468632317e+03, 3.70146267776887834771e+04}
var q0S8 [6]float64 = [6]float64{1.63776026895689824414e+02, 8.09834494656449805916e+03, 1.42538291419120476348e+05, 8.03309257119514397345e+05, 8.40501579819060512818e+05, -3.43899293537866615225e+05}
var q0R5 [6]float64 = [6]float64{1.84085963594515531381e-11, 7.32421766612684765896e-02, 5.83563508962056953777e+00, 1.35111577286449829671e+02, 1.02724376596164097464e+03, 1.98997785864605384631e+03}
var q0S5 [6]float64 = [6]float64{8.27766102236537761883e+01, 2.07781416421392987104e+03, 1.88472887785718085070e+04, 5.67511122894947329769e+04, 3.59767538425114471465e+04, -5.35434275601944773371e+03}
var q0R3 [6]float64 = [6]float64{4.37741014089738620906e-09, 7.32411180042911447163e-02, 3.34423137516170720929e+00, 4.26218440745412650017e+01, 1.70808091340565596283e+02, 1.66733948696651168575e+02}
var q0S3 [6]float64 = [6]float64{4.87588729724587182091e+01, 7.09689221056606015736e+02, 3.70414822620111362994e+03, 6.46042516752568917582e+03, 2.51633368920368957333e+03, -1.49247451836156386662e+02}
var q0R2 [6]float64 = [6]float64{1.50444444886983272379e-07, 7.32234265963079278272e-02, 1.99819174093815998816e+00, 1.44956029347885735348e+01, 3.16662317504781540833e+01, 1.62527075710929267416e+01}
var q0S2 [6]float64 = [6]float64{3.03655848355219184498e+01, 2.69348118608049844624e+02, 8.44783757595320139444e+02, 8.82935845112488550512e+02, 2.12666388511798828631e+02, -5.31095493882666946917e+00}

// qzero evaluates the Q(0,x) asymptotic ratio for x >= 2.
func qzero(x float64) float64 {
	var z float64 = 1.0 / (x * x)
	var r float64
	var s float64
	if x >= 8.0 {
		r = q0R8[0] + z*(q0R8[1]+z*(q0R8[2]+z*(q0R8[3]+z*(q0R8[4]+z*q0R8[5]))))
		s = 1.0 + z*(q0S8[0]+z*(q0S8[1]+z*(q0S8[2]+z*(q0S8[3]+z*(q0S8[4]+z*q0S8[5])))))
	} else if x >= 4.5454 {
		r = q0R5[0] + z*(q0R5[1]+z*(q0R5[2]+z*(q0R5[3]+z*(q0R5[4]+z*q0R5[5]))))
		s = 1.0 + z*(q0S5[0]+z*(q0S5[1]+z*(q0S5[2]+z*(q0S5[3]+z*(q0S5[4]+z*q0S5[5])))))
	} else if x >= 2.8571 {
		r = q0R3[0] + z*(q0R3[1]+z*(q0R3[2]+z*(q0R3[3]+z*(q0R3[4]+z*q0R3[5]))))
		s = 1.0 + z*(q0S3[0]+z*(q0S3[1]+z*(q0S3[2]+z*(q0S3[3]+z*(q0S3[4]+z*q0S3[5])))))
	} else {
		r = q0R2[0] + z*(q0R2[1]+z*(q0R2[2]+z*(q0R2[3]+z*(q0R2[4]+z*q0R2[5]))))
		s = 1.0 + z*(q0S2[0]+z*(q0S2[1]+z*(q0S2[2]+z*(q0S2[3]+z*(q0S2[4]+z*q0S2[5])))))
	}
	return (-0.125 + r/s) / x
}

// ---- J1 R0/S0 coefficients on [0,2] ----
const (
	j1R00 float64 = -6.25000000000000000000e-02
	j1R01 float64 = 1.40705666955189706048e-03
	j1R02 float64 = -1.59955631084035597520e-05
	j1R03 float64 = 4.96727999609584448412e-08
	j1S01 float64 = 1.91537599538363460805e-02
	j1S02 float64 = 1.85946785588630915560e-04
	j1S03 float64 = 1.17718464042623683263e-06
	j1S04 float64 = 5.04636257076217042715e-09
	j1S05 float64 = 1.23542274426137913908e-11
)

// J1 returns the order-one Bessel function of the first kind.
//   J1(±Inf) = 0
//   J1(NaN)  = NaN
func J1(x float64) float64 {
	if IsNaN(x) {
		return x
	}
	if IsInf(x, 0) || x == 0.0 {
		return 0.0
	}

	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}
	if x >= 2.0 {
		var s float64 = Sin(x)
		var c float64 = Cos(x)
		var ss float64 = -s - c
		var cc float64 = s - c
		if x < MaxFloat64*0.5 {
			var z float64 = Cos(x + x)
			if s*c > 0.0 {
				cc = z / ss
			} else {
				ss = z / cc
			}
		}
		var z float64
		if x > jbTwo129 {
			z = (1.0 / SqrtPi) * cc / Sqrt(x)
		} else {
			var u float64 = pone(x)
			var v float64 = qone(x)
			z = (1.0 / SqrtPi) * (u*cc - v*ss) / Sqrt(x)
		}
		if sign {
			return -z
		}
		return z
	}
	if x < jbTwoM27 {
		return 0.5 * x
	}
	var z float64 = x * x
	var r float64 = z * (j1R00 + z*(j1R01+z*(j1R02+z*j1R03)))
	var s float64 = 1.0 + z*(j1S01+z*(j1S02+z*(j1S03+z*(j1S04+z*j1S05))))
	r = r * x
	z = 0.5*x + r/s
	if sign {
		return -z
	}
	return z
}

// ---- Y1 U/V coefficients on [0,2] ----
const (
	y1U00 float64 = -1.96057090646238940668e-01
	y1U01 float64 = 5.04438716639811282616e-02
	y1U02 float64 = -1.91256895875763547298e-03
	y1U03 float64 = 2.35252600561610495928e-05
	y1U04 float64 = -9.19099158039878874504e-08
	y1V00 float64 = 1.99167318236649903973e-02
	y1V01 float64 = 2.02552581025135171496e-04
	y1V02 float64 = 1.35608801097516229404e-06
	y1V03 float64 = 6.22741452364621501295e-09
	y1V04 float64 = 1.66559246207992079114e-11
)

// Y1 returns the order-one Bessel function of the second kind.
//   Y1(+Inf)  = 0
//   Y1(0)     = -Inf
//   Y1(x < 0) = NaN
//   Y1(NaN)   = NaN
func Y1(x float64) float64 {
	if x < 0.0 || IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return 0.0
	}
	if x == 0.0 {
		return Inf(-1)
	}

	if x >= 2.0 {
		var s float64 = Sin(x)
		var c float64 = Cos(x)
		var ss float64 = -s - c
		var cc float64 = s - c
		if x < MaxFloat64*0.5 {
			var z float64 = Cos(x + x)
			if s*c > 0.0 {
				cc = z / ss
			} else {
				ss = z / cc
			}
		}
		var z float64
		if x > jbTwo129 {
			z = (1.0 / SqrtPi) * ss / Sqrt(x)
		} else {
			var u float64 = pone(x)
			var v float64 = qone(x)
			z = (1.0 / SqrtPi) * (u*ss + v*cc) / Sqrt(x)
		}
		return z
	}
	if x <= jbTwoM54 {
		return -(2.0 / Pi) / x
	}
	var z float64 = x * x
	var u float64 = y1U00 + z*(y1U01+z*(y1U02+z*(y1U03+z*y1U04)))
	var v float64 = 1.0 + z*(y1V00+z*(y1V01+z*(y1V02+z*(y1V03+z*y1V04))))
	return x*(u/v) + (2.0/Pi)*(J1(x)*Log(x)-1.0/x)
}

// ---- pone coefficient tables (J1/Y1 asymptotic) ----
var p1R8 [6]float64 = [6]float64{0.00000000000000000000e+00, 1.17187499999988647970e-01, 1.32394806593073575129e+01, 4.12051854307378562225e+02, 3.87474538913960532227e+03, 7.91447954031891731574e+03}
var p1S8 [5]float64 = [5]float64{1.14207370375678408436e+02, 3.65093083420853463394e+03, 3.69562060269033463555e+04, 9.76027935934950801311e+04, 3.08042720627888811578e+04}
var p1R5 [6]float64 = [6]float64{1.31990519556243522749e-11, 1.17187493190614097638e-01, 6.80275127868432871736e+00, 1.08308182990189109773e+02, 5.17636139533199752805e+02, 5.28715201363337541807e+02}
var p1S5 [5]float64 = [5]float64{5.92805987221131331921e+01, 9.91401418733614377743e+02, 5.35326695291487976647e+03, 7.84469031749551231769e+03, 1.50404688810361062679e+03}
var p1R3 [6]float64 = [6]float64{3.02503916137373618024e-09, 1.17186865567253592491e-01, 3.93297750033315640650e+00, 3.51194035591636932736e+01, 9.10550110750781271918e+01, 4.85590685197364919645e+01}
var p1S3 [5]float64 = [5]float64{3.47913095001251519989e+01, 3.36762458747825746741e+02, 1.04687139975775130551e+03, 8.90811346398256432622e+02, 1.03787932439639277504e+02}
var p1R2 [6]float64 = [6]float64{1.07710830106873743082e-07, 1.17176219462683348094e-01, 2.36851496667608785174e+00, 1.22426109148261232917e+01, 1.76939711271687727390e+01, 5.07352312588818499250e+00}
var p1S2 [5]float64 = [5]float64{2.14364859363821409488e+01, 1.25290227168402751090e+02, 2.32276469057162813669e+02, 1.17679373287147100768e+02, 8.36463893371618283368e+00}

// pone evaluates the P(1,x) asymptotic ratio for x >= 2.
func pone(x float64) float64 {
	var z float64 = 1.0 / (x * x)
	var r float64
	var s float64
	if x >= 8.0 {
		r = p1R8[0] + z*(p1R8[1]+z*(p1R8[2]+z*(p1R8[3]+z*(p1R8[4]+z*p1R8[5]))))
		s = 1.0 + z*(p1S8[0]+z*(p1S8[1]+z*(p1S8[2]+z*(p1S8[3]+z*p1S8[4]))))
	} else if x >= 4.5454 {
		r = p1R5[0] + z*(p1R5[1]+z*(p1R5[2]+z*(p1R5[3]+z*(p1R5[4]+z*p1R5[5]))))
		s = 1.0 + z*(p1S5[0]+z*(p1S5[1]+z*(p1S5[2]+z*(p1S5[3]+z*p1S5[4]))))
	} else if x >= 2.8571 {
		r = p1R3[0] + z*(p1R3[1]+z*(p1R3[2]+z*(p1R3[3]+z*(p1R3[4]+z*p1R3[5]))))
		s = 1.0 + z*(p1S3[0]+z*(p1S3[1]+z*(p1S3[2]+z*(p1S3[3]+z*p1S3[4]))))
	} else {
		r = p1R2[0] + z*(p1R2[1]+z*(p1R2[2]+z*(p1R2[3]+z*(p1R2[4]+z*p1R2[5]))))
		s = 1.0 + z*(p1S2[0]+z*(p1S2[1]+z*(p1S2[2]+z*(p1S2[3]+z*p1S2[4]))))
	}
	return 1.0 + r/s
}

// ---- qone coefficient tables (J1/Y1 asymptotic) ----
var q1R8 [6]float64 = [6]float64{0.00000000000000000000e+00, -1.02539062499992714161e-01, -1.62717534544589987888e+01, -7.59601722513950107896e+02, -1.18498066702429587167e+04, -4.84385124285750353010e+04}
var q1S8 [6]float64 = [6]float64{1.61395369700722909556e+02, 7.82538599923348465381e+03, 1.33875336287249578163e+05, 7.19657723683240939863e+05, 6.66601232617776375264e+05, -2.94490264303834643215e+05}
var q1R5 [6]float64 = [6]float64{-2.08979931141764104297e-11, -1.02539050241375426231e-01, -8.05644828123936029840e+00, -1.83669607474888380239e+02, -1.37319376065508163265e+03, -2.61244440453215656817e+03}
var q1S5 [6]float64 = [6]float64{8.12765501384335777857e+01, 1.99179873460485964642e+03, 1.74684851924908907677e+04, 4.98514270910352279316e+04, 2.79480751638918118260e+04, -4.71918354795128470869e+03}
var q1R3 [6]float64 = [6]float64{-5.07831226461766561369e-09, -1.02537829820837089745e-01, -4.61011581139473403113e+00, -5.78472216562783643212e+01, -2.28244540737631695038e+02, -2.19210128478909325622e+02}
var q1S3 [6]float64 = [6]float64{4.76651550323729509273e+01, 6.73865112676699709482e+02, 3.38015286679526343505e+03, 5.54772909720722782367e+03, 1.90311919338810798763e+03, -1.35201191444307340817e+02}
var q1R2 [6]float64 = [6]float64{-1.78381727510958865572e-07, -1.02517042607985553460e-01, -2.75220568278187460720e+00, -1.96636162643703720221e+01, -4.23253133372830490089e+01, -2.13719211703704061733e+01}
var q1S2 [6]float64 = [6]float64{2.95333629060523854548e+01, 2.52981549982190529136e+02, 7.57502834868645436472e+02, 7.39393205320467245656e+02, 1.55949003336666123687e+02, -4.95949898822628210127e+00}

// qone evaluates the Q(1,x) asymptotic ratio for x >= 2.
func qone(x float64) float64 {
	var z float64 = 1.0 / (x * x)
	var r float64
	var s float64
	if x >= 8.0 {
		r = q1R8[0] + z*(q1R8[1]+z*(q1R8[2]+z*(q1R8[3]+z*(q1R8[4]+z*q1R8[5]))))
		s = 1.0 + z*(q1S8[0]+z*(q1S8[1]+z*(q1S8[2]+z*(q1S8[3]+z*(q1S8[4]+z*q1S8[5])))))
	} else if x >= 4.5454 {
		r = q1R5[0] + z*(q1R5[1]+z*(q1R5[2]+z*(q1R5[3]+z*(q1R5[4]+z*q1R5[5]))))
		s = 1.0 + z*(q1S5[0]+z*(q1S5[1]+z*(q1S5[2]+z*(q1S5[3]+z*(q1S5[4]+z*q1S5[5])))))
	} else if x >= 2.8571 {
		r = q1R3[0] + z*(q1R3[1]+z*(q1R3[2]+z*(q1R3[3]+z*(q1R3[4]+z*q1R3[5]))))
		s = 1.0 + z*(q1S3[0]+z*(q1S3[1]+z*(q1S3[2]+z*(q1S3[3]+z*(q1S3[4]+z*q1S3[5])))))
	} else {
		r = q1R2[0] + z*(q1R2[1]+z*(q1R2[2]+z*(q1R2[3]+z*(q1R2[4]+z*q1R2[5]))))
		s = 1.0 + z*(q1S2[0]+z*(q1S2[1]+z*(q1S2[2]+z*(q1S2[3]+z*(q1S2[4]+z*q1S2[5])))))
	}
	return (0.375 + r/s) / x
}
