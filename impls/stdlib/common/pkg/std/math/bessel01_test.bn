package "pkg/std/math"

import "pkg/builtins/testing"

func TestJ0() testing.TestResult {
	if J0(0.0) != 1.0 { return "J0(0)" }
	// <=1 ULP vs Go (Bessel polynomials + Sin/Cos are FMA-sensitive).
	if !nearULP(J0(0.5), Float64frombits(0x3FEE07F1D54C3F34)) { return "J0(0.5)" }
	if !nearULP(J0(1.0), Float64frombits(0x3FE87C7FDBD7B8F0)) { return "J0(1)" }
	if !nearULP(J0(1.5), Float64frombits(0x3FE060E46CE9651B)) { return "J0(1.5)" }
	if !nearULP(J0(2.0), Float64frombits(0x3FCCA873FB24CEF8)) { return "J0(2) boundary" }
	if !nearULP(J0(2.5), Float64frombits(0xBFA8C5C2232CFF3F)) { return "J0(2.5)" }
	if !nearULP(J0(10.0), Float64frombits(0xBFCF7AD2B89E1E53)) { return "J0(10)" }
	if !nearULP(J0(100.0), Float64frombits(0x3F94772BB5C1EF71)) { return "J0(100)" }
	return ""
}

func TestY0() testing.TestResult {
	if !nearULP(Y0(1.0), Float64frombits(0x3FB6980226F358E0)) { return "Y0(1)" }
	if !nearULP(Y0(2.0), Float64frombits(0x3FE054FF5CD68C8D)) { return "Y0(2)" }
	if !nearULP(Y0(10.0), Float64frombits(0x3FAC80EE65A05C58)) { return "Y0(10)" }
	if !nearULP(Y0(100.0), Float64frombits(0xBFB3C64887B47B66)) { return "Y0(100)" }
	return ""
}

func TestJ1() testing.TestResult {
	if J1(0.0) != 0.0 { return "J1(0)" }
	if !nearULP(J1(1.0), Float64frombits(0x3FDC29C9EE970C6C)) { return "J1(1)" }
	if !nearULP(J1(2.0), Float64frombits(0x3FE27487958371EF)) { return "J1(2) boundary" }
	if !nearULP(J1(10.0), Float64frombits(0x3FA6420F4E20090F)) { return "J1(10)" }
	if !nearULP(J1(100.0), Float64frombits(0xBFB3BFCC3BF06395)) { return "J1(100)" }
	return ""
}

func TestY1() testing.TestResult {
	if !nearULP(Y1(1.0), Float64frombits(0xBFE8FFB207D66B94)) { return "Y1(1)" }
	if !nearULP(Y1(2.0), Float64frombits(0xBFBB667A39146648)) { return "Y1(2)" }
	if !nearULP(Y1(10.0), Float64frombits(0x3FCFDFBCC7958F3B)) { return "Y1(10)" }
	if !nearULP(Y1(100.0), Float64frombits(0xBF94DC7AB72EDC20)) { return "Y1(100)" }
	return ""
}

func TestBessel01Specials() testing.TestResult {
	if J0(Inf(1)) != 0.0 { return "J0(+Inf)" }
	if J0(Inf(-1)) != 0.0 { return "J0(-Inf)" }
	if !IsNaN(J0(NaN())) { return "J0(NaN)" }
	if J1(0.0) != 0.0 { return "J1(0)" }
	if !IsInf(Y0(0.0), -1) { return "Y0(0) should be -Inf" }
	if !IsNaN(Y0(-1.0)) { return "Y0(-1) should be NaN" }
	if Y0(Inf(1)) != 0.0 { return "Y0(+Inf)" }
	if !IsInf(Y1(0.0), -1) { return "Y1(0) should be -Inf" }
	if !IsNaN(Y1(-1.0)) { return "Y1(-1) should be NaN" }
	if !IsNaN(Y0(NaN())) { return "Y0(NaN)" }
	return ""
}
