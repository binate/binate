package "pkg/std/math"

// Bessel functions of the first and second kind of order n (Go's
// math/jn.go, from FreeBSD fdlibm e_jn.c / e_yn.c).  Order-n via
// recurrence over J0/J1 (Jn) and Y0/Y1 (Yn), with a continued-fraction
// + backward-recurrence path when n > x for Jn.
//
// Depends on J0/J1/Y0/Y1 (bessel-01 group), and on Sin/Cos/Sqrt/Log/Abs,
// IsNaN/IsInf/NaN/Inf, plus the SqrtPi const.
//
// jnTwoM29 = 2**-29, jnTwo302 = 2**302.  Go writes these as
// 1.0/(1<<29) and 1<<302; here they are the exact decimal literals that
// round to the same bits (0x3E10000000000000 and 0x52D0000000000000).
const (
	jnTwoM29 float64 = 1.862645149230957e-9    // 2**-29  (0x3E10000000000000)
	jnTwo302 float64 = 8.148143905337944e90    // 2**302  (0x52D0000000000000)
	// jnOverflowThreshold: above this the recurrent value may overflow and
	// the result likely underflows to zero (Go's 7.09782712893383973096e+02).
	jnOverflowThreshold float64 = 7.09782712893383973096e+02
)

// Jn returns the order-n Bessel function of the first kind.
//
// Special cases are:
//   Jn(n, ±Inf) = 0
//   Jn(n, NaN)  = NaN
func Jn(n int, x float64) float64 {
	// special cases
	if IsNaN(x) {
		return x
	}
	if IsInf(x, 0) {
		return 0.0
	}

	// J(-n, x) = (-1)**n * J(n, x), J(n, -x) = (-1)**n * J(n, x)
	// Thus, J(-n, x) = J(n, -x)
	if n == 0 {
		return J0(x)
	}
	if x == 0.0 {
		return 0.0
	}
	if n < 0 {
		n = -n
		x = -x
	}
	if n == 1 {
		return J1(x)
	}

	var sign bool = false
	if x < 0.0 {
		x = -x
		if (n & 1) == 1 {
			sign = true // odd n and negative x
		}
	}

	var b float64 = 0.0
	if cast(float64, n) <= x {
		// Safe to use J(n+1,x)=2n/x *J(n,x)-J(n-1,x)
		if x >= jnTwo302 { // x > 2**302
			// x >> n**2: use the asymptotic form.  s=sin(x), c=cos(x).
			//   n & 3:  0 -> c+s, 1 -> -c+s, 2 -> -c-s, 3 -> c-s
			var s float64 = Sin(x)
			var c float64 = Cos(x)
			var temp float64 = 0.0
			var m4 int = n & 3
			if m4 == 0 {
				temp = c + s
			} else if m4 == 1 {
				temp = -c + s
			} else if m4 == 2 {
				temp = -c - s
			} else {
				temp = c - s
			}
			b = (1.0 / SqrtPi) * temp / Sqrt(x)
		} else {
			// forward recurrence: a,b = b, b*(2i/x) - a
			b = J1(x)
			var a float64 = J0(x)
			var i int = 1
			for i < n {
				var nb float64 = b*(cast(float64, i+i)/x) - a
				a = b
				b = nb
				i = i + 1
			}
		}
	} else {
		if x < jnTwoM29 { // x < 2**-29
			// x tiny: first Taylor term J(n,x) = 1/n! * (x/2)**n
			if n > 33 { // underflow
				b = 0.0
			} else {
				var temp float64 = x * 0.5
				b = temp
				var a float64 = 1.0
				var i int = 2
				for i <= n {
					a = a * cast(float64, i) // a = n!
					b = b * temp             // b = (x/2)**n
					i = i + 1
				}
				b = b / a
			}
		} else {
			// backward recurrence via continued fraction.
			// Determine number of terms k.
			var w float64 = cast(float64, n+n) / x
			var h float64 = 2.0 / x
			var q0 float64 = w
			var z float64 = w + h
			var q1 float64 = w*z - 1.0
			var k int = 1
			for q1 < 1e9 {
				k = k + 1
				z = z + h
				var nq float64 = z*q1 - q0
				q0 = q1
				q1 = nq
			}
			var m int = n + n
			var t float64 = 0.0
			var i int = 2 * (n + k)
			for i >= m {
				t = 1.0 / (cast(float64, i)/x - t)
				i = i - 2
			}
			var a float64 = t
			b = 1.0

			// estimate log((2/x)**n * n!); if it exceeds the threshold the
			// recurrent value may overflow, so scale b along the way.
			var tmp float64 = cast(float64, n)
			var v float64 = 2.0 / x
			tmp = tmp * Log(Abs(v*tmp))
			if tmp < jnOverflowThreshold {
				var j int = n - 1
				for j > 0 {
					var di float64 = cast(float64, j+j)
					var nb float64 = b*di/x - a
					a = b
					b = nb
					j = j - 1
				}
			} else {
				var j int = n - 1
				for j > 0 {
					var di float64 = cast(float64, j+j)
					var nb float64 = b*di/x - a
					a = b
					b = nb
					// scale b to avoid spurious overflow
					if b > 1e100 {
						a = a / b
						t = t / b
						b = 1.0
					}
					j = j - 1
				}
			}
			b = t * J0(x) / b
		}
	}

	if sign {
		return -b
	}
	return b
}

// Yn returns the order-n Bessel function of the second kind.
//
// Special cases are:
//   Yn(n, +Inf)  = 0
//   Yn(n ≥ 0, 0) = -Inf
//   Yn(n < 0, 0) = +Inf if n is odd, -Inf if n is even
//   Yn(n, x < 0) = NaN
//   Yn(n, NaN)   = NaN
func Yn(n int, x float64) float64 {
	// special cases
	if x < 0.0 || IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return 0.0
	}

	if n == 0 {
		return Y0(x)
	}
	if x == 0.0 {
		if n < 0 && (n & 1) == 1 {
			return Inf(1)
		}
		return Inf(-1)
	}

	var sign bool = false
	if n < 0 {
		n = -n
		if (n & 1) == 1 {
			sign = true // sign true if n < 0 && |n| odd
		}
	}

	if n == 1 {
		if sign {
			return -Y1(x)
		}
		return Y1(x)
	}

	var b float64 = 0.0
	if x >= jnTwo302 { // x > 2**302
		// x >> n**2: asymptotic form.  s=sin(x), c=cos(x).
		//   n & 3:  0 -> s-c, 1 -> -s-c, 2 -> -s+c, 3 -> s+c
		var s float64 = Sin(x)
		var c float64 = Cos(x)
		var temp float64 = 0.0
		var m4 int = n & 3
		if m4 == 0 {
			temp = s - c
		} else if m4 == 1 {
			temp = -s - c
		} else if m4 == 2 {
			temp = -s + c
		} else {
			temp = s + c
		}
		b = (1.0 / SqrtPi) * temp / Sqrt(x)
	} else {
		var a float64 = Y0(x)
		b = Y1(x)
		// forward recurrence; quit if b is -inf
		var i int = 1
		for i < n && !IsInf(b, -1) {
			var nb float64 = (cast(float64, i+i)/x)*b - a
			a = b
			b = nb
			i = i + 1
		}
	}

	if sign {
		return -b
	}
	return b
}
