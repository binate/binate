package "pkg/std/math"

import "pkg/builtins/testing"

func TestJn() testing.TestResult {
	// n==0/1 delegate to J0/J1.
	if Jn(0, 0.0) != 1.0 { return "Jn(0,0)" }
	if Jn(1, 0.0) != 0.0 { return "Jn(1,0)" }
	// <=1 ULP vs Go (recurrence over FMA-sensitive J0/J1).
	if !nearULP(Jn(2, 2.0), Float64frombits(0x3FD694D52D747C62)) { return "Jn(2,2)" }
	if !nearULP(Jn(2, 5.0), Float64frombits(0x3FA7D76207184293)) { return "Jn(2,5)" }
	if !nearULP(Jn(3, 5.0), Float64frombits(0x3FD759651702E379)) { return "Jn(3,5)" }
	if !nearULP(Jn(3, 10.0), Float64frombits(0x3FADE3E6E9C0CC08)) { return "Jn(3,10)" }
	// n > x: backward recurrence / continued fraction.
	if !nearULP(Jn(5, 2.0), Float64frombits(0x3F7CD596393D19FA)) { return "Jn(5,2)" }
	if !nearULP(Jn(10, 5.0), Float64frombits(0x3F580C69177FE382)) { return "Jn(10,5)" }
	if !nearULP(Jn(20, 5.0), Float64frombits(0x3DBE75C92EB69A31)) { return "Jn(20,5)" }
	// Tiny x: Taylor first term, and underflow for large n.
	if !nearULP(Jn(2, 1e-10), Float64frombits(0x3B979CA10C924224)) { return "Jn(2,1e-10)" }
	if Jn(34, 1e-10) != 0.0 { return "Jn(34,1e-10) underflow" }
	// Negative n / x parity.
	if !nearULP(Jn(-2, 3.0), Float64frombits(0x3FDF1C1E84C59EC7)) { return "Jn(-2,3)" }
	if !nearULP(Jn(3, -5.0), Float64frombits(0xBFD759651702E379)) { return "Jn(3,-5)" }
	if !nearULP(Jn(-3, -5.0), Float64frombits(0x3FD759651702E379)) { return "Jn(-3,-5)" }
	return ""
}

func TestYn() testing.TestResult {
	if !nearULP(Yn(2, 2.0), Float64frombits(0xBFE3C1CEA3F91956)) { return "Yn(2,2)" }
	if !nearULP(Yn(2, 3.0), Float64frombits(0xBFC488000624427C)) { return "Yn(2,3)" }
	if !nearULP(Yn(3, 5.0), Float64frombits(0x3FC2B8E1E41F7C16)) { return "Yn(3,5)" }
	if !nearULP(Yn(3, 10.0), Float64frombits(0xBFD016536602934E)) { return "Yn(3,10)" }
	if !nearULP(Yn(10, 5.0), Float64frombits(0xC039210D5BF63A93)) { return "Yn(10,5)" }
	// Negative-n parity.
	if !nearULP(Yn(-2, 3.0), Float64frombits(0xBFC488000624427C)) { return "Yn(-2,3)" }
	if !nearULP(Yn(-3, 5.0), Float64frombits(0xBFC2B8E1E41F7C16)) { return "Yn(-3,5)" }
	return ""
}

func TestBesselNSpecials() testing.TestResult {
	if Jn(2, Inf(1)) != 0.0 { return "Jn(2,+Inf)" }
	if !IsNaN(Jn(2, NaN())) { return "Jn(2,NaN)" }
	if Jn(2, 0.0) != 0.0 { return "Jn(2,0)" }
	// Yn(n>=0,0) = -Inf; Yn(n<0,0) = +Inf if odd else -Inf.
	if !IsInf(Yn(2, 0.0), -1) { return "Yn(2,0) should be -Inf" }
	if !IsInf(Yn(-1, 0.0), 1) { return "Yn(-1,0) should be +Inf" }
	if !IsInf(Yn(-2, 0.0), -1) { return "Yn(-2,0) should be -Inf" }
	if !IsNaN(Yn(2, -1.0)) { return "Yn(2,-1) should be NaN" }
	if Yn(2, Inf(1)) != 0.0 { return "Yn(2,+Inf)" }
	if !IsNaN(Yn(2, NaN())) { return "Yn(2,NaN)" }
	return ""
}
