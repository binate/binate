// Nat arithmetic: addition, subtraction, and multiplication.  All limb
// math runs in uint64 (uint32 limbs keep products within uint64), so it is
// correct on ILP32 where int is 32-bit.  Each op builds its result in a
// fresh backing before storing into z, so z may alias x or y.
package "pkg/std/math/big"

// norm restores the normalized invariant by trimming high zero limbs, so
// afterward nlimbs == 0 or the top limb is nonzero.
func norm(z @Nat) {
	for z.nlimbs > 0 && z.limbs[z.nlimbs - 1] == cast(uint32, 0) {
		z.nlimbs = z.nlimbs - 1
	}
}

func (z @Nat) Add(x @Nat, y @Nat) @Nat {
	var an int = x.nlimbs
	var bn int = y.nlimbs
	var maxn int = an
	if bn > maxn {
		maxn = bn
	}
	// The sum is at most max(an,bn)+1 limbs.
	var res @[]uint32 = make_slice(uint32, maxn + 1)
	var carry uint64 = cast(uint64, 0)
	for i := 0; i < maxn; i++ {
		var sum uint64 = carry
		if i < an {
			sum = sum + cast(uint64, x.limbs[i])
		}
		if i < bn {
			sum = sum + cast(uint64, y.limbs[i])
		}
		res[i] = cast(uint32, sum)
		carry = sum >> 32
	}
	res[maxn] = cast(uint32, carry)
	z.limbs = res
	z.nlimbs = maxn + 1
	norm(z)
	return z
}

func (z @Nat) AddUint32(x @Nat, c uint32) @Nat {
	if c == cast(uint32, 0) {
		return z.Set(x)
	}
	var n int = x.nlimbs
	var res @[]uint32 = make_slice(uint32, n + 1)
	var carry uint64 = cast(uint64, c)
	for i := 0; i < n; i++ {
		var sum uint64 = cast(uint64, x.limbs[i]) + carry
		res[i] = cast(uint32, sum)
		carry = sum >> 32
	}
	res[n] = cast(uint32, carry)
	z.limbs = res
	z.nlimbs = n + 1
	norm(z)
	return z
}

func (z @Nat) Sub(x @Nat, y @Nat) @Nat {
	var an int = x.nlimbs
	var bn int = y.nlimbs
	// PRECONDITION x >= y, so the result has at most an limbs.
	var res @[]uint32 = make_slice(uint32, an)
	var borrow uint64 = cast(uint64, 0)
	for i := 0; i < an; i++ {
		var xi uint64 = cast(uint64, x.limbs[i])
		var yi uint64 = cast(uint64, 0)
		if i < bn {
			yi = cast(uint64, y.limbs[i])
		}
		// uint64 wraps on underflow; the low 32 bits are the borrowed limb.
		var diff uint64 = xi - yi - borrow
		res[i] = cast(uint32, diff)
		if xi < yi + borrow {
			borrow = cast(uint64, 1)
		} else {
			borrow = cast(uint64, 0)
		}
	}
	if borrow != cast(uint64, 0) {
		panic("big: Nat.Sub: x < y")
	}
	z.limbs = res
	z.nlimbs = an
	norm(z)
	return z
}

func (z @Nat) MulUint32(x @Nat, m uint32) @Nat {
	if m == cast(uint32, 0) || x.nlimbs == 0 {
		z.nlimbs = 0
		return z
	}
	var mm uint64 = cast(uint64, m)
	var n int = x.nlimbs
	// The product is at most n+1 limbs.
	var res @[]uint32 = make_slice(uint32, n + 1)
	var carry uint64 = cast(uint64, 0)
	for i := 0; i < n; i++ {
		var t uint64 = cast(uint64, x.limbs[i]) * mm + carry
		res[i] = cast(uint32, t)
		carry = t >> 32
	}
	res[n] = cast(uint32, carry)
	z.limbs = res
	z.nlimbs = n + 1
	norm(z)
	return z
}

func (z @Nat) Mul(x @Nat, y @Nat) @Nat {
	if x.nlimbs == 0 || y.nlimbs == 0 {
		z.nlimbs = 0
		return z
	}
	var xn int = x.nlimbs
	var yn int = y.nlimbs
	// The product fits in xn+yn limbs; res is zero-filled by make_slice.
	var res @[]uint32 = make_slice(uint32, xn + yn)
	for i := 0; i < xn; i++ {
		var xi uint64 = cast(uint64, x.limbs[i])
		var carry uint64 = cast(uint64, 0)
		for j := 0; j < yn; j++ {
			// xi*yj + res[i+j] + carry <= (2^32-1)^2 + 2*(2^32-1) < 2^64,
			// so the uint64 accumulator never overflows.
			var t uint64 = xi * cast(uint64, y.limbs[j]) + cast(uint64, res[i + j]) + carry
			res[i + j] = cast(uint32, t)
			carry = t >> 32
		}
		// res[i+yn] is untouched before this row's carry lands, so assign.
		res[i + yn] = cast(uint32, carry)
	}
	z.limbs = res
	z.nlimbs = xn + yn
	norm(z)
	return z
}
