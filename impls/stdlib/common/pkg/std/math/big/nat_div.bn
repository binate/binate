// Nat division: DivModUint32 (by a single 32-bit limb) and DivMod
// (multi-limb-divisor, Knuth Algorithm D).  All limb math runs in uint64
// so it is correct on ILP32.  z and r are written via fresh backings, so
// they may alias x or y, but z and r must be distinct from each other.
package "pkg/std/math/big"

// shlFill writes src << shift (shift in [0,31]) into the pre-sized dst,
// little-endian.  dst must have at least src.nlimbs slots; the carry out of
// the top limb lands in dst[src.nlimbs] when that slot exists (so a caller
// that can produce a carry must size dst to src.nlimbs+1).
func shlFill(dst @[]uint32, src @Nat, shift uint) {
	if shift == cast(uint, 0) {
		for i := 0; i < src.nlimbs; i++ {
			dst[i] = src.limbs[i]
		}
		return
	}
	var sh uint64 = cast(uint64, shift)
	var carry uint32 = cast(uint32, 0)
	for i := 0; i < src.nlimbs; i++ {
		var t uint64 = cast(uint64, src.limbs[i]) << sh
		dst[i] = cast(uint32, t) | carry
		carry = cast(uint32, t >> 32)
	}
	if src.nlimbs < len(dst) {
		dst[src.nlimbs] = carry
	}
}

// clz32 counts the leading zero bits of v (0..31 for v != 0; 32 for v == 0).
func clz32(v uint32) int {
	if v == cast(uint32, 0) {
		return 32
	}
	var n int = 0
	var x uint32 = v
	var top uint32 = cast(uint32, 1) << 31
	for (x & top) == cast(uint32, 0) {
		n = n + 1
		x = x << 1
	}
	return n
}

// DivModUint32 sets z to x / m and returns (z, x % m) for a single-limb
// divisor m.  It panics when m is zero.  z may alias x (the quotient is
// written via a fresh backing).
func (z @Nat) DivModUint32(x @Nat, m uint32) (@Nat, uint32) {
	if m == cast(uint32, 0) {
		panic("big: Nat.DivModUint32: division by zero")
	}
	var n int = x.nlimbs
	var res @[]uint32 = make_slice(uint32, n)
	var mm uint64 = cast(uint64, m)
	// Long division from the most significant limb down: at each step the
	// running remainder (always < m, so < 2^32) is shifted up a limb and
	// the next limb appended, keeping cur < m*2^32 < 2^64.
	var rem uint64 = cast(uint64, 0)
	var i int = n - 1
	for i >= 0 {
		var cur uint64 = (rem << 32) | cast(uint64, x.limbs[i])
		res[i] = cast(uint32, cur / mm)
		rem = cur % mm
		i = i - 1
	}
	z.limbs = res
	z.nlimbs = n
	norm(z)
	return z, cast(uint32, rem)
}

// DivMod sets z to x / y, r to x % y, and returns (z, r).  z and r must be
// distinct (they may otherwise alias x or y).  It panics on a zero divisor.
//
// The general case is Knuth Algorithm D (TAOCP 4.3.1): normalize so the
// divisor's top limb has its high bit set, then for each quotient limb
// estimate the digit from the top two limbs, multiply-and-subtract, and add
// the divisor back on the rare over-estimate.  All intermediates fit uint64
// because the estimate qhat is reduced below 2^32 before the multiply.
func (z @Nat) DivMod(x @Nat, y @Nat, r @Nat) (@Nat, @Nat) {
	if y.nlimbs == 0 {
		panic("big: Nat.DivMod: division by zero")
	}
	if x.Cmp(y) < 0 {
		r.Set(x)
		z.nlimbs = 0
		return z, r
	}
	if y.nlimbs == 1 {
		var rem32 uint32 = cast(uint32, 0)
		z, rem32 = z.DivModUint32(x, y.limbs[0])
		r.SetUint64(cast(uint64, rem32))
		return z, r
	}

	var n int = y.nlimbs
	var m int = x.nlimbs - n
	var shift uint = cast(uint, clz32(y.limbs[n - 1]))
	// u = x << shift in m+n+1 limb slots (the top slot holds the shift
	// carry, or 0).  v = y << shift in exactly n limbs: shift == clz of the
	// top limb, so the top bit of v[n-1] is set and there is no carry-out.
	var u @[]uint32 = make_slice(uint32, m + n + 1)
	var v @[]uint32 = make_slice(uint32, n)
	shlFill(u, x, shift)
	shlFill(v, y, shift)
	var q @[]uint32 = make_slice(uint32, m + 1)

	var bBase uint64 = cast(uint64, 1) << 32
	var vTop uint64 = cast(uint64, v[n - 1])
	var v2 uint64 = cast(uint64, v[n - 2])
	var j int = m
	for j >= 0 {
		// D3: estimate the quotient digit from the top two limbs.
		var num uint64 = (cast(uint64, u[j + n]) << 32) | cast(uint64, u[j + n - 1])
		var qhat uint64 = num / vTop
		var rhat uint64 = num % vTop
		var ujn2 uint64 = cast(uint64, u[j + n - 2])
		for qhat >= bBase || qhat * v2 > (rhat << 32) + ujn2 {
			qhat = qhat - cast(uint64, 1)
			rhat = rhat + vTop
			if rhat >= bBase {
				break
			}
		}
		// D4: u[j..j+n] -= qhat * v.
		var borrow uint64 = cast(uint64, 0)
		var carry uint64 = cast(uint64, 0)
		var i int = 0
		for i < n {
			var p uint64 = qhat * cast(uint64, v[i]) + carry
			carry = p >> 32
			var sub uint64 = cast(uint64, cast(uint32, p)) + borrow
			var ui uint64 = cast(uint64, u[j + i])
			u[j + i] = cast(uint32, ui - sub)
			if ui < sub {
				borrow = cast(uint64, 1)
			} else {
				borrow = cast(uint64, 0)
			}
			i = i + 1
		}
		var subT uint64 = carry + borrow
		var uiT uint64 = cast(uint64, u[j + n])
		u[j + n] = cast(uint32, uiT - subT)
		if uiT < subT {
			// D6: qhat was one too large — decrement and add the divisor back.
			qhat = qhat - cast(uint64, 1)
			var c uint64 = cast(uint64, 0)
			var k int = 0
			for k < n {
				var s uint64 = cast(uint64, u[j + k]) + cast(uint64, v[k]) + c
				u[j + k] = cast(uint32, s)
				c = s >> 32
				k = k + 1
			}
			u[j + n] = cast(uint32, cast(uint64, u[j + n]) + c)
		}
		q[j] = cast(uint32, qhat)
		j = j - 1
	}

	z.limbs = q
	z.nlimbs = m + 1
	norm(z)

	// Remainder is the low n limbs of u, denormalized by shifting back.
	var remLimbs @[]uint32 = make_slice(uint32, n)
	var t int = 0
	for t < n {
		remLimbs[t] = u[t]
		t = t + 1
	}
	r.limbs = remLimbs
	r.nlimbs = n
	norm(r)
	r.Shr(r, shift)
	return z, r
}
