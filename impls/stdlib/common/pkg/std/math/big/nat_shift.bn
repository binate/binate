// Nat bit shifts: Shl (multiply by 2^n) and Shr (floor-divide by 2^n).
// A shift of n bits splits into a whole-limb shift (n/32) and a sub-limb
// bit shift (n%32); the bit-shift part runs in uint64 so the carried-out
// high bits are preserved (correct on ILP32, where int is 32-bit).  Each
// op builds its result in a fresh backing, so z may alias x.
package "pkg/std/math/big"

// Shl sets z to x shifted left by n bits (i.e. x * 2^n) and returns z.
func (z @Nat) Shl(x @Nat, n uint) @Nat {
	if x.nlimbs == 0 {
		z.nlimbs = 0
		return z
	}
	if n == cast(uint, 0) {
		return z.Set(x)
	}
	var wordShift int = cast(int, n / cast(uint, 32))
	var bitShift uint = n % cast(uint, 32)
	var xn int = x.nlimbs
	var res @[]uint32 = make_slice(uint32, xn + wordShift + 1)
	if bitShift == cast(uint, 0) {
		for i := 0; i < xn; i++ {
			res[i + wordShift] = x.limbs[i]
		}
	} else {
		var sh uint64 = cast(uint64, bitShift)
		var carry uint32 = cast(uint32, 0)
		for i := 0; i < xn; i++ {
			// v holds limb<<bitShift in 64 bits; the low 32 bits are this
			// output limb (ORed with the bits carried up from the limb
			// below), the high 32 bits carry into the next limb.
			var v uint64 = cast(uint64, x.limbs[i]) << sh
			res[i + wordShift] = cast(uint32, v) | carry
			carry = cast(uint32, v >> 32)
		}
		res[xn + wordShift] = carry
	}
	z.limbs = res
	z.nlimbs = xn + wordShift + 1
	norm(z)
	return z
}

// Shr sets z to x shifted right by n bits (i.e. floor(x / 2^n)) and returns z.
func (z @Nat) Shr(x @Nat, n uint) @Nat {
	if x.nlimbs == 0 {
		z.nlimbs = 0
		return z
	}
	if n == cast(uint, 0) {
		return z.Set(x)
	}
	var wordShift int = cast(int, n / cast(uint, 32))
	var bitShift uint = n % cast(uint, 32)
	var xn int = x.nlimbs
	if wordShift >= xn {
		z.nlimbs = 0
		return z
	}
	var rn int = xn - wordShift
	var res @[]uint32 = make_slice(uint32, rn)
	if bitShift == cast(uint, 0) {
		for i := 0; i < rn; i++ {
			res[i] = x.limbs[i + wordShift]
		}
	} else {
		var sh uint64 = cast(uint64, bitShift)
		var compl uint64 = cast(uint64, cast(uint, 32) - bitShift)
		for i := 0; i < rn; i++ {
			// Each output limb takes the high (32-bitShift) bits of its
			// source limb plus the low bitShift bits of the next limb up.
			var lo uint32 = cast(uint32, cast(uint64, x.limbs[i + wordShift]) >> sh)
			var hi uint32 = cast(uint32, 0)
			if i + wordShift + 1 < xn {
				hi = cast(uint32, cast(uint64, x.limbs[i + wordShift + 1]) << compl)
			}
			res[i] = lo | hi
		}
	}
	z.limbs = res
	z.nlimbs = rn
	norm(z)
	return z
}
