package "pkg/std/math"

// Mathematical constants, matching Go's math package (full float64
// precision — each decimal literal rounds to the same bits Go's
// compiler produces).  The values are listed in the .bni too (so
// consumers see math.Pi etc.); the two declarations must stay in sync.
const (
	E   float64 = 2.71828182845904523536028747135266249775724709369995957496696763  // https://oeis.org/A001113
	Pi  float64 = 3.14159265358979323846264338327950288419716939937510582097494459  // https://oeis.org/A000796
	Phi float64 = 1.61803398874989484820458683436563811772030917980576286213544862  // https://oeis.org/A001622

	Sqrt2   float64 = 1.41421356237309504880168872420969807856967187537694807317667974  // https://oeis.org/A002193
	SqrtE   float64 = 1.64872127070012814684865078781416357165377610071014801157507931  // https://oeis.org/A019774
	SqrtPi  float64 = 1.77245385090551602729816748334114518279754945612238712821380779  // https://oeis.org/A002161
	SqrtPhi float64 = 1.27201964951406896425242246173749149171560804184009624861664038  // https://oeis.org/A139339

	Ln2    float64 = 0.693147180559945309417232121458176568075500134360255254120680009  // https://oeis.org/A002162
	Log2E  float64 = 1.442695040888963407359924681001892137426645954152985934135449406931  // 1 / Ln2
	Ln10   float64 = 2.30258509299404568401799145468436420760110148862877297603332790  // https://oeis.org/A002392
	Log10E float64 = 0.434294481903251827651128918916605082294397005803666566114453783658  // 1 / Ln10
)

// Floating-point limit values, defined by their exact decimal value
// (which rounds to the intended IEEE 754 pattern).
const (
	// MaxFloat64 is the largest finite float64 (0x7FEFFFFFFFFFFFFF).
	MaxFloat64 float64 = 1.7976931348623157e308
	// SmallestNonzeroFloat64 is the smallest positive (denormal)
	// float64 (0x0000000000000001).
	SmallestNonzeroFloat64 float64 = 4.9406564584124654e-324
)
