package "pkg/std/math"

// Floating-point error function (Erf) and complementary error function (Erfc).
// Ported from Go's math/erf.go (FreeBSD fdlibm s_erf.c). Large rational /
// exponential approximations with several coefficient tables and branch
// thresholds.
//
// NOTE: this group has no shift expressions in its arithmetic; the only bit
// manipulation is `Float64bits(x) & 0xffffffff00000000` (pure mask, no shift),
// so the Binate loose-shift-precedence hazard does not arise here.

// erx is erf(1) rounded to single precision (24 bits): 0.84506291151...
const erfErx float64 = 8.45062911510467529297e-01 // 0x3FEB0AC160000000

// Coefficients for approximation to erf in [0, 0.84375].
const erfEfx float64 = 1.28379167095512586316e-01  // 0x3FC06EBA8214DB69
const erfEfx8 float64 = 1.02703333676410069053e+00 // 0x3FF06EBA8214DB69
const erfPp0 float64 = 1.28379167095512558561e-01  // 0x3FC06EBA8214DB68
const erfPp1 float64 = -3.25042107247001499370e-01 // 0xBFD4CD7D691CB913
const erfPp2 float64 = -2.84817495755985104766e-02 // 0xBF9D2A51DBD7194F
const erfPp3 float64 = -5.77027029648944159157e-03 // 0xBF77A291236668E4
const erfPp4 float64 = -2.37630166566501626084e-05 // 0xBEF8EAD6120016AC
const erfQq1 float64 = 3.97917223959155352819e-01  // 0x3FD97779CDDADC09
const erfQq2 float64 = 6.50222499887672944485e-02  // 0x3FB0A54C5536CEBA
const erfQq3 float64 = 5.08130628187576562776e-03  // 0x3F74D022C4D36B0F
const erfQq4 float64 = 1.32494738004321644526e-04  // 0x3F215DC9221C1A10
const erfQq5 float64 = -3.96022827877536812320e-06 // 0xBED09C4342A26120

// Coefficients for approximation to erf in [0.84375, 1.25].
const erfPa0 float64 = -2.36211856075265944077e-03 // 0xBF6359B8BEF77538
const erfPa1 float64 = 4.14856118683748331666e-01  // 0x3FDA8D00AD92B34D
const erfPa2 float64 = -3.72207876035701323847e-01 // 0xBFD7D240FBB8C3F1
const erfPa3 float64 = 3.18346619901161753674e-01  // 0x3FD45FCA805120E4
const erfPa4 float64 = -1.10894694282396677476e-01 // 0xBFBC63983D3E28EC
const erfPa5 float64 = 3.54783043256182359371e-02  // 0x3FA22A36599795EB
const erfPa6 float64 = -2.16637559486879084300e-03 // 0xBF61BF380A96073F
const erfQa1 float64 = 1.06420880400844228286e-01  // 0x3FBB3E6618EEE323
const erfQa2 float64 = 5.40397917702171048937e-01  // 0x3FE14AF092EB6F33
const erfQa3 float64 = 7.18286544141962662868e-02  // 0x3FB2635CD99FE9A7
const erfQa4 float64 = 1.26171219808761642112e-01  // 0x3FC02660E763351F
const erfQa5 float64 = 1.36370839120290507362e-02  // 0x3F8BEDC26B51DD1C
const erfQa6 float64 = 1.19844998467991074170e-02  // 0x3F888B545735151D

// Coefficients for approximation to erfc in [1.25, 1/0.35].
const erfRa0 float64 = -9.86494403484714822705e-03 // 0xBF843412600D6435
const erfRa1 float64 = -6.93858572707181764372e-01 // 0xBFE63416E4BA7360
const erfRa2 float64 = -1.05586262253232909814e+01 // 0xC0251E0441B0E726
const erfRa3 float64 = -6.23753324503260060396e+01 // 0xC04F300AE4CBA38D
const erfRa4 float64 = -1.62396669462573470355e+02 // 0xC0644CB184282266
const erfRa5 float64 = -1.84605092906711035994e+02 // 0xC067135CEBCCABB2
const erfRa6 float64 = -8.12874355063065934246e+01 // 0xC054526557E4D2F2
const erfRa7 float64 = -9.81432934416914548592e+00 // 0xC023A0EFC69AC25C
const erfSa1 float64 = 1.96512716674392571292e+01  // 0x4033A6B9BD707687
const erfSa2 float64 = 1.37657754143519042600e+02  // 0x4061350C526AE721
const erfSa3 float64 = 4.34565877475229228821e+02  // 0x407B290DD58A1A71
const erfSa4 float64 = 6.45387271733267880336e+02  // 0x40842B1921EC2868
const erfSa5 float64 = 4.29008140027567833386e+02  // 0x407AD02157700314
const erfSa6 float64 = 1.08635005541779435134e+02  // 0x405B28A3EE48AE2C
const erfSa7 float64 = 6.57024977031928170135e+00  // 0x401A47EF8E484A93
const erfSa8 float64 = -6.04244152148580987438e-02 // 0xBFAEEFF2EE749A62

// Coefficients for approximation to erfc in [1/.35, 28].
const erfRb0 float64 = -9.86494292470009928597e-03 // 0xBF84341239E86F4A
const erfRb1 float64 = -7.99283237680523006574e-01 // 0xBFE993BA70C285DE
const erfRb2 float64 = -1.77579549177547519889e+01 // 0xC031C209555F995A
const erfRb3 float64 = -1.60636384855821916062e+02 // 0xC064145D43C5ED98
const erfRb4 float64 = -6.37566443368389627722e+02 // 0xC083EC881375F228
const erfRb5 float64 = -1.02509513161107724954e+03 // 0xC09004616A2E5992
const erfRb6 float64 = -4.83519191608651397019e+02 // 0xC07E384E9BDC383F
const erfSb1 float64 = 3.03380607434824582924e+01  // 0x403E568B261D5190
const erfSb2 float64 = 3.25792512996573918826e+02  // 0x40745CAE221B9F0A
const erfSb3 float64 = 1.53672958608443695994e+03  // 0x409802EB189D5118
const erfSb4 float64 = 3.19985821950859553908e+03  // 0x40A8FFB7688C246A
const erfSb5 float64 = 2.55305040643316442583e+03  // 0x40A3F219CEDF3BE6
const erfSb6 float64 = 4.74528541206955367215e+02  // 0x407DA874E79FE763
const erfSb7 float64 = -2.24409524465858183362e+01 // 0xC03670E242712D62

// erfVeryTiny is 0x0080000000000000 (smallest positive normal float64).
const erfVeryTiny float64 = 2.848094538889218e-306
// erfSmall is 2**-28.
const erfSmall float64 = 0.000000003725290298461914
// erfcTiny is 2**-56.
const erfcTiny float64 = 0.0000000000000000138777878078144567552953958511352539

// erfMask is the high-word mask producing a pseudo-single (20-bit) precision x.
const erfMask uint64 = 0xFFFFFFFF00000000

// Erf returns the error function of x.
//   Erf(+Inf) = 1
//   Erf(-Inf) = -1
//   Erf(NaN)  = NaN
func Erf(x float64) float64 {
	// special cases
	if IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return 1.0
	}
	if IsInf(x, -1) {
		return -1.0
	}

	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}

	if x < 0.84375 { // |x| < 0.84375
		var temp float64
		if x < erfSmall { // |x| < 2**-28
			if x < erfVeryTiny {
				temp = 0.125 * (8.0*x + erfEfx8*x) // avoid underflow
			} else {
				temp = x + erfEfx*x
			}
		} else {
			var z float64 = x * x
			var r float64 = erfPp0 + z*(erfPp1+z*(erfPp2+z*(erfPp3+z*erfPp4)))
			var s float64 = 1.0 + z*(erfQq1+z*(erfQq2+z*(erfQq3+z*(erfQq4+z*erfQq5))))
			var y float64 = r / s
			temp = x + x*y
		}
		if sign {
			return -temp
		}
		return temp
	}

	if x < 1.25 { // 0.84375 <= |x| < 1.25
		var s float64 = x - 1.0
		var P float64 = erfPa0 + s*(erfPa1+s*(erfPa2+s*(erfPa3+s*(erfPa4+s*(erfPa5+s*erfPa6)))))
		var Q float64 = 1.0 + s*(erfQa1+s*(erfQa2+s*(erfQa3+s*(erfQa4+s*(erfQa5+s*erfQa6)))))
		if sign {
			return -erfErx - P/Q
		}
		return erfErx + P/Q
	}

	if x >= 6.0 { // inf > |x| >= 6
		if sign {
			return -1.0
		}
		return 1.0
	}

	var s float64 = 1.0 / (x * x)
	var R float64
	var S float64
	if x < 2.857142857142857 { // |x| < 1/0.35 ~ 2.857143
		R = erfRa0 + s*(erfRa1+s*(erfRa2+s*(erfRa3+s*(erfRa4+s*(erfRa5+s*(erfRa6+s*erfRa7))))))
		S = 1.0 + s*(erfSa1+s*(erfSa2+s*(erfSa3+s*(erfSa4+s*(erfSa5+s*(erfSa6+s*(erfSa7+s*erfSa8)))))))
	} else { // |x| >= 1/0.35 ~ 2.857143
		R = erfRb0 + s*(erfRb1+s*(erfRb2+s*(erfRb3+s*(erfRb4+s*(erfRb5+s*erfRb6)))))
		S = 1.0 + s*(erfSb1+s*(erfSb2+s*(erfSb3+s*(erfSb4+s*(erfSb5+s*(erfSb6+s*erfSb7))))))
	}
	// pseudo-single (20-bit) precision x
	var z float64 = Float64frombits(Float64bits(x) & erfMask)
	var r float64 = Exp(-z*z-0.5625) * Exp((z-x)*(z+x)+R/S)
	if sign {
		return r/x - 1.0
	}
	return 1.0 - r/x
}

// Erfc returns the complementary error function of x.
//   Erfc(+Inf) = 0
//   Erfc(-Inf) = 2
//   Erfc(NaN)  = NaN
func Erfc(x float64) float64 {
	// special cases
	if IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return 0.0
	}
	if IsInf(x, -1) {
		return 2.0
	}

	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}

	if x < 0.84375 { // |x| < 0.84375
		var temp float64
		if x < erfcTiny { // |x| < 2**-56
			temp = x
		} else {
			var z float64 = x * x
			var r float64 = erfPp0 + z*(erfPp1+z*(erfPp2+z*(erfPp3+z*erfPp4)))
			var s float64 = 1.0 + z*(erfQq1+z*(erfQq2+z*(erfQq3+z*(erfQq4+z*erfQq5))))
			var y float64 = r / s
			if x < 0.25 { // |x| < 1/4
				temp = x + x*y
			} else {
				temp = 0.5 + (x*y + (x - 0.5))
			}
		}
		if sign {
			return 1.0 + temp
		}
		return 1.0 - temp
	}

	if x < 1.25 { // 0.84375 <= |x| < 1.25
		var s float64 = x - 1.0
		var P float64 = erfPa0 + s*(erfPa1+s*(erfPa2+s*(erfPa3+s*(erfPa4+s*(erfPa5+s*erfPa6)))))
		var Q float64 = 1.0 + s*(erfQa1+s*(erfQa2+s*(erfQa3+s*(erfQa4+s*(erfQa5+s*erfQa6)))))
		if sign {
			return 1.0 + erfErx + P/Q
		}
		return 1.0 - erfErx - P/Q
	}

	if x < 28.0 { // |x| < 28
		var s float64 = 1.0 / (x * x)
		var R float64
		var S float64
		if x < 2.857142857142857 { // |x| < 1/0.35 ~ 2.857143
			R = erfRa0 + s*(erfRa1+s*(erfRa2+s*(erfRa3+s*(erfRa4+s*(erfRa5+s*(erfRa6+s*erfRa7))))))
			S = 1.0 + s*(erfSa1+s*(erfSa2+s*(erfSa3+s*(erfSa4+s*(erfSa5+s*(erfSa6+s*(erfSa7+s*erfSa8)))))))
		} else { // |x| >= 1/0.35 ~ 2.857143
			if sign && x > 6.0 {
				return 2.0 // x < -6
			}
			R = erfRb0 + s*(erfRb1+s*(erfRb2+s*(erfRb3+s*(erfRb4+s*(erfRb5+s*erfRb6)))))
			S = 1.0 + s*(erfSb1+s*(erfSb2+s*(erfSb3+s*(erfSb4+s*(erfSb5+s*(erfSb6+s*erfSb7))))))
		}
		// pseudo-single (20-bit) precision x
		var z float64 = Float64frombits(Float64bits(x) & erfMask)
		var r float64 = Exp(-z*z-0.5625) * Exp((z-x)*(z+x)+R/S)
		if sign {
			return 2.0 - r/x
		}
		return r / x
	}

	if sign {
		return 2.0
	}
	return 0.0
}
