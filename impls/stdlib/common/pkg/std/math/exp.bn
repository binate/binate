package "pkg/std/math"

// Coefficients and thresholds for Exp (Go's math/exp.go, FreeBSD fdlibm).
const (
	expLn2Hi     float64 = 6.93147180369123816490e-01
	expLn2Lo     float64 = 1.90821492927058770002e-10
	expLog2e     float64 = 1.44269504088896338700e+00
	expOverflow  float64 = 7.09782712893383973096e+02
	expUnderflow float64 = -7.45133219101941108420e+02
	expNearZero  float64 = 3.7252902984619140625e-09   // 2**-28
	expP1        float64 = 1.66666666666666657415e-01
	expP2        float64 = -2.77777777770155933842e-03
	expP3        float64 = 6.61375632143793436117e-05
	expP4        float64 = -1.65339022054652515390e-06
	expP5        float64 = 4.13813679705723846039e-08
)

// Exp returns e**x, the base-e exponential of x.
//   Exp(+Inf) = +Inf
//   Exp(NaN)  = NaN
// Very large x overflow to +Inf; very negative x underflow to 0.
func Exp(x float64) float64 {
	// special cases
	if IsNaN(x) || IsInf(x, 1) {
		return x
	}
	if IsInf(x, -1) {
		return 0.0
	}
	if x > expOverflow {
		return Inf(1)
	}
	if x < expUnderflow {
		return 0.0
	}
	if -expNearZero < x && x < expNearZero {
		return 1.0 + x
	}

	// reduce: x = k*ln2 + r, computed as r = hi - lo for extra precision.
	var k int = 0
	if x < 0.0 {
		k = cast(int, expLog2e*x - 0.5)
	} else if x > 0.0 {
		k = cast(int, expLog2e*x + 0.5)
	}
	var hi float64 = x - cast(float64, k)*expLn2Hi
	var lo float64 = cast(float64, k) * expLn2Lo
	return expmulti(hi, lo, k)
}

// expmulti returns e**r * 2**k where r = hi - lo and |r| <= ln(2)/2.
func expmulti(hi float64, lo float64, k int) float64 {
	var r float64 = hi - lo
	var t float64 = r * r
	var c float64 = r - t*(expP1+t*(expP2+t*(expP3+t*(expP4+t*expP5))))
	var y float64 = 1.0 - ((lo - (r*c)/(2.0-c)) - hi)
	return Ldexp(y, k)
}
