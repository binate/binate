package "pkg/std/math"

import "pkg/builtins/testing"

func TestExp() testing.TestResult {
	if Exp(0.0) != 1.0 { return "Exp(0) should be 1" }
	// Exp(1) is e; it should match the E constant bit-for-bit (a strong
	// correctly-rounded check, and an LLVM/VM bit-identity check — any
	// FP-contraction divergence would break exactness).
	if Float64bits(Exp(1.0)) != Float64bits(E) { return "Exp(1) != E" }
	// e**2 and 1/e in range.
	if Exp(2.0) < 7.3890560989306490 || Exp(2.0) > 7.3890560989306500 {
		return "Exp(2) range"
	}
	if Exp(-1.0) < 0.36787944117144229 || Exp(-1.0) > 0.36787944117144235 {
		return "Exp(-1) range"
	}
	// Inverse relation Exp(Log-ish): Exp(ln2) == 2 should be very close.
	if Exp(Ln2) < 1.9999999999999996 || Exp(Ln2) > 2.0000000000000004 {
		return "Exp(Ln2) range"
	}
	return ""
}

func TestExpSpecials() testing.TestResult {
	if !IsInf(Exp(Inf(1)), 1) { return "Exp(+Inf) should be +Inf" }
	if Exp(Inf(-1)) != 0.0 { return "Exp(-Inf) should be 0" }
	if !IsNaN(Exp(NaN())) { return "Exp(NaN) should be NaN" }
	// Overflow / underflow thresholds.
	if !IsInf(Exp(710.0), 1) { return "Exp(710) should overflow to +Inf" }
	if Exp(-750.0) != 0.0 { return "Exp(-750) should underflow to 0" }
	// Near zero: Exp(x) ~ 1+x for tiny x.
	if Exp(1e-20) != 1.0 + 1e-20 { return "Exp(tiny) should be 1+x" }
	return ""
}
