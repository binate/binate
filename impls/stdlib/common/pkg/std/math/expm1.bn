package "pkg/std/math"

// Coefficients and thresholds for Expm1 (Go's math/expm1.go, FreeBSD fdlibm
// s_expm1.c).  Ln2Hi/Lo (expLn2Hi/Lo), InvLn2 (expLog2e), Othreshold
// (expOverflow), Tiny (log1pTiny = 2**-54) and the 1.0 bit pattern (uvone) are
// shared; only the expm1-specific reduction thresholds and Q-polynomial are new.
const (
	expm1Ln2X56    float64 = 3.88162421113569373274e+01 // 56 * ln2
	expm1Ln2HalfX3 float64 = 1.03972077083991796413e+00 // 1.5 * ln2
	expm1Ln2Half   float64 = 3.46573590279972654709e-01 // 0.5 * ln2
	expm1Q1        float64 = -3.33333333333331316428e-02
	expm1Q2        float64 = 1.58730158725481460165e-03
	expm1Q3        float64 = -7.93650757867487942473e-05
	expm1Q4        float64 = 4.00821782732936239552e-06
	expm1Q5        float64 = -2.01099218183624371326e-07
	expm1C53       uint64  = 0x0020000000000000 // 2**53, for t = 1 - 2**-k
)

// Expm1 returns e**x - 1, accurate even when x is near zero (where e**x - 1
// loses precision).  Expm1(+Inf)=+Inf, Expm1(-Inf)=-1, Expm1(NaN)=NaN.
func Expm1(x float64) float64 {
	// special cases
	if IsInf(x, 1) || IsNaN(x) {
		return x
	}
	if IsInf(x, -1) {
		return -1.0
	}

	var absx float64 = x
	var sign bool = false
	if x < 0.0 {
		absx = -absx
		sign = true
	}

	// filter out huge argument
	if absx >= expm1Ln2X56 { // |x| >= 56 * ln2
		if sign {
			return -1.0 // x < -56*ln2
		}
		if absx >= expOverflow { // |x| >= 709.78...
			return Inf(1)
		}
	}

	// argument reduction
	var c float64 = 0.0
	var k int = 0
	if absx > expm1Ln2Half { // |x| > 0.5 * ln2
		var hi float64
		var lo float64
		if absx < expm1Ln2HalfX3 { // and |x| < 1.5 * ln2
			if !sign {
				hi = x - expLn2Hi
				lo = expLn2Lo
				k = 1
			} else {
				hi = x + expLn2Hi
				lo = -expLn2Lo
				k = -1
			}
		} else {
			if !sign {
				k = cast(int, expLog2e*x+0.5)
			} else {
				k = cast(int, expLog2e*x-0.5)
			}
			var tred float64 = cast(float64, k)
			hi = x - tred*expLn2Hi // tred * expLn2Hi is exact here
			lo = tred * expLn2Lo
		}
		x = hi - lo
		c = (hi - x) - lo
	} else if absx < log1pTiny { // |x| < 2**-54
		return x
	} else {
		k = 0
	}

	// x is now in the primary range
	var hfx float64 = 0.5 * x
	var hxs float64 = x * hfx
	var r1 float64 = 1.0 + hxs*(expm1Q1+hxs*(expm1Q2+hxs*(expm1Q3+hxs*(expm1Q4+hxs*expm1Q5))))
	var tp float64 = 3.0 - r1*hfx
	var e float64 = hxs * ((r1 - tp) / (6.0 - x*tp))
	if k == 0 {
		return x - (x*e - hxs) // c is 0
	}
	e = (x*(e-c) - c)
	e = e - hxs

	if k == -1 {
		return 0.5*(x-e) - 0.5
	}
	if k == 1 {
		if x < -0.25 {
			return -2.0 * (e - (x + 0.5))
		}
		return 1.0 + 2.0*(x-e)
	}
	if k <= -2 || k > 56 { // suffices to return exp(x)-1
		var y float64 = 1.0 - (e - x)
		// add k to y's exponent
		y = Float64frombits(Float64bits(y) + (cast(uint64, k) << shift))
		return y - 1.0
	}
	if k < 20 {
		var tk float64 = Float64frombits(uvone - (expm1C53 >> cast(uint64, k))) // 1 - 2**-k
		var y float64 = tk - (e - x)
		y = Float64frombits(Float64bits(y) + (cast(uint64, k) << shift))
		return y
	}
	// 20 <= k <= 56
	var tbig float64 = Float64frombits(cast(uint64, 1023-k) << shift) // 2**-k
	var y float64 = x - (e + tbig)
	y = y + 1.0
	y = Float64frombits(Float64bits(y) + (cast(uint64, k) << shift))
	return y
}
