package "pkg/std/math"

// Floor returns the greatest integer value less than or equal to x.
//   Floor(±0)   = ±0
//   Floor(±Inf) = ±Inf
//   Floor(NaN)  = NaN
func Floor(x float64) float64 {
	if x == 0.0 || IsNaN(x) || IsInf(x, 0) {
		return x
	}
	if x < 0.0 {
		var d float64
		var fract float64
		d, fract = Modf(-x)
		if fract != 0.0 {
			d = d + 1.0
		}
		return -d
	}
	var d float64
	d, _ = Modf(x)
	return d
}

// Ceil returns the least integer value greater than or equal to x.
//   Ceil(±0)   = ±0
//   Ceil(±Inf) = ±Inf
//   Ceil(NaN)  = NaN
func Ceil(x float64) float64 {
	return -Floor(-x)
}

// Trunc returns the integer value of x (rounding toward zero).
//   Trunc(±0)   = ±0
//   Trunc(±Inf) = ±Inf
//   Trunc(NaN)  = NaN
func Trunc(x float64) float64 {
	if x == 0.0 || IsNaN(x) || IsInf(x, 0) {
		return x
	}
	var d float64
	d, _ = Modf(x)
	return d
}

// Round returns the nearest integer, rounding half away from zero.
//   Round(±0)   = ±0
//   Round(±Inf) = ±Inf
//   Round(NaN)  = NaN
func Round(x float64) float64 {
	// A faster, branch-light form of Copysign(Floor(Abs(x)+0.5), x).
	var bits uint64 = Float64bits(x)
	var e uint64 = (bits >> shift) & expMask
	if e < bias {
		// abs(x) < 1, including denormals.
		bits = bits & signMask  // ±0
		if e == bias - cast(uint64, 1) {
			bits = bits | uvone  // ±1
		}
	} else if e < bias + shift {
		// abs(x) >= 1 with a fractional component in [0,1).
		var half uint64 = cast(uint64, 1) << (shift - cast(uint64, 1))
		e = e - bias
		bits = bits + (half >> e)
		bits = bits & ~(fracMask >> e)
	}
	return Float64frombits(bits)
}

// RoundToEven returns the nearest integer, rounding ties to even.
//   RoundToEven(±0)   = ±0
//   RoundToEven(±Inf) = ±Inf
//   RoundToEven(NaN)  = NaN
func RoundToEven(x float64) float64 {
	// TODO(shift-overshift): Go's RoundToEven has no ±Inf/NaN guard — its
	// e>=bias branch shifts by huge counts and relies on `>> n == 0` for
	// n >= width. Binate currently hardware-masks the shift count (see the
	// CRITICAL shift bug in claude-todo.md), corrupting ±Inf/NaN. This guard
	// is a temporary workaround; remove it once shifts honor the spec.
	if IsNaN(x) || IsInf(x, 0) {
		return x
	}
	var bits uint64 = Float64bits(x)
	var e uint64 = (bits >> shift) & expMask
	if e >= bias {
		// abs(x) >= 1.
		var halfMinusULP uint64 =
			(cast(uint64, 1) << (shift - cast(uint64, 1))) - cast(uint64, 1)
		e = e - bias
		var lsb uint64 = (bits >> (shift - e)) & cast(uint64, 1)
		bits = bits + ((halfMinusULP + lsb) >> e)
		bits = bits & ~(fracMask >> e)
	} else if e == bias - cast(uint64, 1) && (bits & fracMask) != cast(uint64, 0) {
		// 0.5 < abs(x) < 1.
		bits = (bits & signMask) | uvone  // ±1
	} else {
		// abs(x) <= 0.5, including denormals.
		bits = bits & signMask  // ±0
	}
	return Float64frombits(bits)
}
