package "pkg/std/math"

// Cephes gamma.c coefficient tables (Go's math/gamma.go).  Read-only
// package-level tables applied at startup; the polynomials are evaluated
// in Horner form so the result matches Go bit-for-bit (modulo FMA).

// gamP: numerator of the 6/7-degree rational approx on (2,3).
var gamP [7]float64 = [7]float64{
	1.60119522476751861407e-04,
	1.19135147006586384913e-03,
	1.04213797561761569935e-02,
	4.76367800457137231464e-02,
	2.07448227648435975150e-01,
	4.94214826801497100753e-01,
	9.99999999999999996796e-01,
}

// gamQ: denominator of the 6/7-degree rational approx on (2,3).
var gamQ [8]float64 = [8]float64{
	-2.31581873324120129819e-05,
	5.39605580493303397842e-04,
	-4.45641913851797240494e-03,
	1.18139785222060435552e-02,
	3.58236398605498653373e-02,
	-2.34591795718243348568e-01,
	7.14304917030273074085e-02,
	1.00000000000000000320e+00,
}

// gamS: Stirling series coefficients.
var gamS [5]float64 = [5]float64{
	7.87311395793093628397e-04,
	-2.29549961613378126380e-04,
	-2.68132617805781232825e-03,
	3.47222221605458667310e-03,
	8.33333333333482257126e-02,
}

// Scalar constants used by the gamma routines: sqrt(2*pi) prefactor for
// Stirling's formula, the x threshold above which Pow() in Stirling would
// overflow, and the Euler-Mascheroni constant.
const (
	gammaSqrtTwoPi float64 = 2.506628274631000502417
	gammaMaxStirling float64 = 143.01608
	gammaEuler float64 = 0.57721566490153286060651209008240243104215933593992
)

// stirling computes Gamma(x) via Stirling's formula as a PAIR of factors
// whose product is the result.  The caller multiplies them; splitting the
// multiply lets the reflection path avoid spurious Inf for 172<=x<=180.
// Valid for 33<=x<=172; larger x is only used reciprocally.
func stirling(x float64) (float64, float64) {
	if x > 200.0 {
		return Inf(1), 1.0
	}
	var w float64 = 1.0 / x
	w = 1.0 + w*((((gamS[0]*w+gamS[1])*w+gamS[2])*w+gamS[3])*w+gamS[4])
	var y1 float64 = Exp(x)
	var y2 float64 = 1.0
	if x > gammaMaxStirling { // avoid Pow() overflow
		var v float64 = Pow(x, 0.5*x-0.25)
		y1 = v
		y2 = v / Exp(x)
	} else {
		y1 = Pow(x, x-0.5) / y1
	}
	return y1, gammaSqrtTwoPi * w * y2
}

// isNegInt reports whether x is a negative integer.
func isNegInt(x float64) bool {
	if x < 0.0 {
		var xi float64
		var xf float64
		xi, xf = Modf(x)
		_ = xi
		return xf == 0.0
	}
	return false
}

// Gamma returns the Gamma function of x.
//
// Special cases:
//	Gamma(+Inf) = +Inf
//	Gamma(+0) = +Inf
//	Gamma(-0) = -Inf
//	Gamma(x) = NaN for integer x < 0
//	Gamma(-Inf) = NaN
//	Gamma(NaN) = NaN
func Gamma(x float64) float64 {
	// special cases
	if isNegInt(x) || IsInf(x, -1) || IsNaN(x) {
		return NaN()
	}
	if IsInf(x, 1) {
		return Inf(1)
	}
	if x == 0.0 {
		if Signbit(x) {
			return Inf(-1)
		}
		return Inf(1)
	}

	var q float64 = Abs(x)
	var p float64 = Floor(q)
	if q > 33.0 {
		if x >= 0.0 {
			var y1 float64
			var y2 float64
			y1, y2 = stirling(x)
			return y1 * y2
		}
		// x is negative, not a negative integer (checked above), so |x| is
		// small enough to convert to int64.
		var signgam int = 1
		var ip int64 = cast(int64, p)
		if (ip & 1) == 0 {
			signgam = -1
		}
		var z float64 = q - p
		if z > 0.5 {
			p = p + 1.0
			z = q - p
		}
		z = q * Sin(Pi*z)
		if z == 0.0 {
			return Inf(signgam)
		}
		var sq1 float64
		var sq2 float64
		sq1, sq2 = stirling(q)
		var absz float64 = Abs(z)
		var d float64 = absz * sq1 * sq2
		if IsInf(d, 0) {
			z = Pi / absz / sq1 / sq2
		} else {
			z = Pi / d
		}
		return cast(float64, signgam) * z
	}

	// Reduce argument.
	var z float64 = 1.0
	for x >= 3.0 {
		x = x - 1.0
		z = z * x
	}
	var isSmall bool = false
	for x < 0.0 {
		if x > -1e-09 {
			isSmall = true
			break
		}
		z = z / x
		x = x + 1.0
	}
	if !isSmall {
		for x < 2.0 {
			if x < 1e-09 {
				isSmall = true
				break
			}
			z = z / x
			x = x + 1.0
		}
	}

	if isSmall {
		if x == 0.0 {
			return Inf(1)
		}
		return z / ((1.0 + gammaEuler*x) * x)
	}

	if x == 2.0 {
		return z
	}

	x = x - 2.0
	p = (((((x*gamP[0]+gamP[1])*x+gamP[2])*x+gamP[3])*x+gamP[4])*x+gamP[5])*x + gamP[6]
	q = ((((((x*gamQ[0]+gamQ[1])*x+gamQ[2])*x+gamQ[3])*x+gamQ[4])*x+gamQ[5])*x+gamQ[6])*x + gamQ[7]
	return z * p / q
}
