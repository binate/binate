package "pkg/std/math"

// Coefficients for Log (Go's math/log.go, FreeBSD fdlibm e_log.c). Ln2 is
// split as logLn2Hi+logLn2Lo so that k*logLn2Hi is exact for |k|<2000;
// logL1..logL7 are the Remez polynomial for R(z) on [0, 0.1716].
const (
	logLn2Hi float64 = 6.93147180369123816490e-01
	logLn2Lo float64 = 1.90821492927058770002e-10
	logL1    float64 = 6.666666666666735130e-01
	logL2    float64 = 3.999999999940941908e-01
	logL3    float64 = 2.857142874366239149e-01
	logL4    float64 = 2.222219843214978396e-01
	logL5    float64 = 1.818357216161805012e-01
	logL6    float64 = 1.531383769920937332e-01
	logL7    float64 = 1.479819860511658591e-01
)

// Log returns the natural logarithm of x.
//   Log(+Inf) = +Inf
//   Log(0)    = -Inf
//   Log(x<0)  = NaN
//   Log(NaN)  = NaN
func Log(x float64) float64 {
	// special cases
	if IsNaN(x) || IsInf(x, 1) {
		return x
	}
	if x < 0.0 {
		return NaN()
	}
	if x == 0.0 {
		return Inf(-1)
	}

	// reduce: x = 2**ki * f1 with f1 in [1/2, 1); pull f1 into [sqrt(2)/2,
	// sqrt(2)) so that f = f1-1 is small.
	var f1 float64
	var ki int
	f1, ki = Frexp(x)
	if f1 < Sqrt2/2.0 {
		f1 = f1 * 2.0
		ki = ki - 1
	}
	var f float64 = f1 - 1.0
	var k float64 = cast(float64, ki)

	// log(1+f) via s = f/(2+f): log(1+f) = 2s + s*R(s**2).
	var s float64 = f / (2.0 + f)
	var s2 float64 = s * s
	var s4 float64 = s2 * s2
	var t1 float64 = s2 * (logL1 + s4*(logL3+s4*(logL5+s4*logL7)))
	var t2 float64 = s4 * (logL2 + s4*(logL4+s4*logL6))
	var rpoly float64 = t1 + t2
	var hfsq float64 = 0.5 * f * f
	return k*logLn2Hi - ((hfsq - (s*(hfsq+rpoly) + k*logLn2Lo)) - f)
}
