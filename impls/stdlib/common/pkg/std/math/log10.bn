package "pkg/std/math"

// Log10 returns the decimal logarithm of x. The special cases are the same
// as for Log.
func Log10(x float64) float64 {
	// Log10E == 1/Ln10 (precomputed; the reciprocal must use the full-
	// precision constant, not runtime division of the rounded Ln10).
	return Log(x) * Log10E
}

// Log2 returns the binary logarithm of x. The special cases are the same as
// for Log.
func Log2(x float64) float64 {
	var frac float64
	var exp int
	frac, exp = Frexp(x)
	// Exact powers of two give an exact answer (Frexp yields frac==0.5);
	// don't depend on Log(0.5)*Log2E+exp rounding to exactly exp-1.
	if frac == 0.5 {
		return cast(float64, exp-1)
	}
	// Log2E == 1/Ln2 (precomputed full-precision reciprocal, as in Log10).
	return Log(frac)*Log2E + cast(float64, exp)
}
