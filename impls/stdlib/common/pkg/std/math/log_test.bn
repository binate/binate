package "pkg/std/math"

import "pkg/builtins/testing"

func TestLog() testing.TestResult {
	// Bit-exact identities (also cross-backend bit-identity checks):
	// Log(1)=0, Log(e)=1, Log(2)=Ln2, Log(10)=Ln10.
	if Log(1.0) != 0.0 { return "Log(1) should be 0" }
	if Float64bits(Log(E)) != Float64bits(1.0) { return "Log(E) != 1" }
	if Float64bits(Log(2.0)) != Float64bits(Ln2) { return "Log(2) != Ln2" }
	if Float64bits(Log(10.0)) != Float64bits(Ln10) { return "Log(10) != Ln10" }
	// Log(1/2) = -Ln2.
	if Float64bits(Log(0.5)) != Float64bits(-Ln2) { return "Log(0.5) != -Ln2" }
	return ""
}

func TestLogVectors() testing.TestResult {
	// Bit-exact reference values from Go's math.Log.
	if Float64bits(Log(3.0)) != 0x3FF193EA7AAD030A { return "Log(3)" }
	if Float64bits(Log(100.0)) != 0x40126BB1BBB55516 { return "Log(100)" }
	if Float64bits(Log(1e-10)) != 0xC037069E2AA2AA5B { return "Log(1e-10)" }
	if Float64bits(Log(1e300)) != 0x4085963447F87FB5 { return "Log(1e300)" }
	if Float64bits(Log(SmallestNonzeroFloat64)) != 0xC0874385446D71C3 {
		return "Log(SmallestNonzero)"
	}
	return ""
}

func TestLogSpecials() testing.TestResult {
	if !IsInf(Log(Inf(1)), 1) { return "Log(+Inf) should be +Inf" }
	if !IsInf(Log(0.0), -1) { return "Log(0) should be -Inf" }
	if !IsInf(Log(Copysign(0.0, -1.0)), -1) { return "Log(-0) should be -Inf" }
	if !IsNaN(Log(-1.0)) { return "Log(-1) should be NaN" }
	if !IsNaN(Log(Inf(-1))) { return "Log(-Inf) should be NaN" }
	if !IsNaN(Log(NaN())) { return "Log(NaN) should be NaN" }
	return ""
}
