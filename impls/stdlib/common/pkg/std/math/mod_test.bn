package "pkg/std/math"

import "pkg/builtins/testing"

func TestMod() testing.TestResult {
	// Normal values; sign of the result follows the dividend x.
	if Mod(5.5, 2.0) != 1.5 { return "Mod(5.5, 2)" }
	if Mod(-5.5, 2.0) != -1.5 { return "Mod(-5.5, 2)" }
	if Mod(5.5, -2.0) != 1.5 { return "Mod(5.5, -2)" }
	if Mod(-5.5, -2.0) != -1.5 { return "Mod(-5.5, -2)" }
	if Mod(7.0, 3.0) != 1.0 { return "Mod(7, 3)" }
	if Mod(6.0, 3.0) != 0.0 { return "Mod(6, 3)" }
	// |x| < |y| returns x unchanged.
	if Mod(1.5, 4.0) != 1.5 { return "Mod(1.5, 4)" }
	if Mod(-1.5, 4.0) != -1.5 { return "Mod(-1.5, 4)" }

	// Special cases.
	if !IsNaN(Mod(5.5, 0.0)) { return "Mod(x, 0) should be NaN" }
	if !IsNaN(Mod(Inf(1), 2.0)) { return "Mod(+Inf, 2) should be NaN" }
	if !IsNaN(Mod(Inf(-1), 2.0)) { return "Mod(-Inf, 2) should be NaN" }
	if !IsNaN(Mod(NaN(), 2.0)) { return "Mod(NaN, 2) should be NaN" }
	if !IsNaN(Mod(5.5, NaN())) { return "Mod(5.5, NaN) should be NaN" }
	// Mod(x, ±Inf) == x.
	if Mod(5.5, Inf(1)) != 5.5 { return "Mod(5.5, +Inf) should be 5.5" }
	if Mod(5.5, Inf(-1)) != 5.5 { return "Mod(5.5, -Inf) should be 5.5" }
	return ""
}

func TestRemainder() testing.TestResult {
	// IEEE remainder rounds the quotient to nearest, ties to even.
	if Remainder(5.5, 2.0) != -0.5 { return "Remainder(5.5, 2)" }
	if Remainder(4.5, 2.0) != 0.5 { return "Remainder(4.5, 2)" }
	if Remainder(-5.5, 2.0) != 0.5 { return "Remainder(-5.5, 2)" }
	if Remainder(6.0, 3.0) != 0.0 { return "Remainder(6, 3)" }
	// Tie at the half-integer rounds to even: 1.5/1 -> 2, 1.5-2 = -0.5.
	if Remainder(1.5, 1.0) != -0.5 { return "Remainder(1.5, 1)" }
	if Remainder(0.5, 1.0) != 0.5 { return "Remainder(0.5, 1)" }

	// Special cases.
	if !IsNaN(Remainder(5.5, 0.0)) { return "Remainder(x, 0) should be NaN" }
	if !IsNaN(Remainder(Inf(1), 2.0)) { return "Remainder(+Inf, 2) should be NaN" }
	if !IsNaN(Remainder(NaN(), 2.0)) { return "Remainder(NaN, 2) should be NaN" }
	if !IsNaN(Remainder(5.5, NaN())) { return "Remainder(5.5, NaN) should be NaN" }
	// Remainder(x, ±Inf) == x.
	if Remainder(5.5, Inf(1)) != 5.5 { return "Remainder(5.5, +Inf) should be 5.5" }
	if Remainder(-3.25, Inf(-1)) != -3.25 { return "Remainder(-3.25, -Inf) should be -3.25" }

	// x == y returns a signed zero with the sign of x.
	if Remainder(3.0, 3.0) != 0.0 { return "Remainder(3, 3) should be 0" }
	if Signbit(Remainder(3.0, 3.0)) { return "Remainder(3, 3) should be +0" }
	if !Signbit(Remainder(-3.0, 3.0)) { return "Remainder(-3, 3) should be -0" }
	return ""
}
