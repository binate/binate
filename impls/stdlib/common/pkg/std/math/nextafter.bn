package "pkg/std/math"

// Nextafter returns the next representable float64 value after x towards y.
// Nextafter(x, x) = x; Nextafter(NaN, y) = Nextafter(x, NaN) = NaN.
func Nextafter(x float64, y float64) float64 {
	if IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	if x == y {
		return x
	}
	if x == 0.0 {
		return Copysign(Float64frombits(cast(uint64, 1)), y)
	}
	// Step the bit pattern up when moving away from zero towards y, else down.
	if cast(int, y > x) == cast(int, x > 0.0) {
		return Float64frombits(Float64bits(x) + cast(uint64, 1))
	}
	return Float64frombits(Float64bits(x) - cast(uint64, 1))
}
