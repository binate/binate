package "pkg/std/math"

import "pkg/builtins/testing"

func TestNextafter() testing.TestResult {
	if Float64bits(Nextafter(1.0, 2.0)) != 0x3FF0000000000001 { return "Nextafter(1,2)" }
	if Float64bits(Nextafter(1.0, 0.0)) != 0x3FEFFFFFFFFFFFFF { return "Nextafter(1,0)" }
	if Float64bits(Nextafter(2.0, 1.0)) != 0x3FFFFFFFFFFFFFFF { return "Nextafter(2,1)" }
	if Nextafter(1.0, 1.0) != 1.0 { return "Nextafter(1,1)" }
	if Float64bits(Nextafter(0.0, 1.0)) != 0x0000000000000001 {
		return "Nextafter(0,1) smallest denormal"
	}
	if Float64bits(Nextafter(0.0, -1.0)) != 0x8000000000000001 { return "Nextafter(0,-1)" }
	if Float64bits(Nextafter(-1.0, -2.0)) != 0xBFF0000000000001 { return "Nextafter(-1,-2)" }
	if Float64bits(Nextafter(1e308, Inf(1))) != 0x7FE1CCF385EBC8A1 { return "Nextafter(1e308,Inf)" }
	if !IsNaN(Nextafter(NaN(), 1.0)) { return "Nextafter(NaN,1)" }
	if !IsNaN(Nextafter(1.0, NaN())) { return "Nextafter(1,NaN)" }
	return ""
}

func TestLogbIlogb() testing.TestResult {
	if Logb(1.0) != 0.0 { return "Logb(1)" }
	if Logb(2.0) != 1.0 { return "Logb(2)" }
	if Logb(0.5) != -1.0 { return "Logb(0.5)" }
	if Logb(1024.0) != 10.0 { return "Logb(1024)" }
	if Logb(0.1) != -4.0 { return "Logb(0.1)" }
	if Logb(1e10) != 33.0 { return "Logb(1e10)" }
	if Logb(1e-10) != -34.0 { return "Logb(1e-10)" }
	if Ilogb(1.0) != 0 { return "Ilogb(1)" }
	if Ilogb(8.0) != 3 { return "Ilogb(8)" }
	if Ilogb(0.1) != -4 { return "Ilogb(0.1)" }
	if Ilogb(1e10) != 33 { return "Ilogb(1e10)" }
	return ""
}

func TestLogbIlogbSpecials() testing.TestResult {
	if !IsInf(Logb(0.0), -1) { return "Logb(0) should be -Inf" }
	if !IsInf(Logb(Inf(1)), 1) { return "Logb(+Inf) should be +Inf" }
	if !IsNaN(Logb(NaN())) { return "Logb(NaN)" }
	if Ilogb(0.0) != -2147483647-1 { return "Ilogb(0) should be MinInt32" }
	if Ilogb(NaN()) != 2147483647 { return "Ilogb(NaN) should be MaxInt32" }
	if Ilogb(Inf(1)) != 2147483647 { return "Ilogb(+Inf) should be MaxInt32" }
	return ""
}
