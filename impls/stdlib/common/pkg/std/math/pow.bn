package "pkg/std/math"

// Thresholds for Pow (Go's math/pow.go).
const (
	powTwo63 float64 = 9.223372036854776e18 // 2**63
	powTwo53 float64 = 9007199254740992.0   // 2**53, the largest exact int float64
)

// isOddInt reports whether x is an odd integer.
func isOddInt(x float64) bool {
	if Abs(x) >= powTwo53 {
		// Beyond 2**53 every float64 is already an even integer, and the
		// int64 conversion below could overflow (wrong on some targets).
		return false
	}
	var xi float64
	var xf float64
	xi, xf = Modf(x)
	return xf == 0.0 && (cast(int64, xi)&1) == 1
}

// Pow returns x**y, the base-x exponential of y.  It follows the IEEE-754
// special cases (e.g. Pow(x,0)=1 for any x including NaN, Pow(1,y)=1 for any y,
// Pow(x,1)=x, Pow(NaN,y)=Pow(x,NaN)=NaN, and the ±0 / ±Inf / odd-int rules).
func Pow(x float64, y float64) float64 {
	if y == 0.0 || x == 1.0 {
		return 1.0
	}
	if y == 1.0 {
		return x
	}
	if IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	if x == 0.0 {
		if y < 0.0 {
			if Signbit(x) && isOddInt(y) {
				return Inf(-1)
			}
			return Inf(1)
		}
		// y > 0 (y == 0 was handled above)
		if Signbit(x) && isOddInt(y) {
			return x
		}
		return 0.0
	}
	if IsInf(y, 0) {
		if x == -1.0 {
			return 1.0
		}
		// |x| < 1 with y == +Inf, or |x| > 1 with y == -Inf, -> 0
		if cast(int, Abs(x) < 1.0) == cast(int, IsInf(y, 1)) {
			return 0.0
		}
		return Inf(1)
	}
	if IsInf(x, 0) {
		if IsInf(x, -1) {
			return Pow(1.0/x, -y) // Pow(-0, -y)
		}
		if y < 0.0 {
			return 0.0
		}
		return Inf(1) // y > 0
	}
	if y == 0.5 {
		return Sqrt(x)
	}
	if y == -0.5 {
		return 1.0 / Sqrt(x)
	}

	var yi float64
	var yf float64
	yi, yf = Modf(Abs(y))
	if yf != 0.0 && x < 0.0 {
		return NaN()
	}
	if yi >= powTwo63 {
		// yi is a large even int: overflow/underflow for every x except -1.
		if x == -1.0 {
			return 1.0
		}
		if cast(int, Abs(x) < 1.0) == cast(int, y > 0.0) {
			return 0.0
		}
		return Inf(1)
	}

	// ans = a1 * 2**ae (= 1 for now).
	var a1 float64 = 1.0
	var ae int = 0

	// ans *= x**yf
	if yf != 0.0 {
		if yf > 0.5 {
			yf = yf - 1.0
			yi = yi + 1.0
		}
		a1 = Exp(yf * Log(x))
	}

	// ans *= x**yi, by multiplying in successive squarings of x according to
	// the bits of yi, accumulating powers of two into ae.
	var x1 float64
	var xe int
	x1, xe = Frexp(x)
	for i := cast(int64, yi); i != 0; i = i >> 1 {
		// Go writes this as `xe < -1<<12 || 1<<12 < xe`; both comparands are
		// kept var-on-left (`xe > 4096`, not `4096 < xe`) because a relational
		// op with an untyped literal on the LEFT against a signed int currently
		// lowers to an UNSIGNED compare (claude-todo CRITICAL; in progress).
		if xe < -4096 || xe > 4096 {
			// Catch xe before the left shift below overflows; the remaining
			// set bits guarantee ae accumulates more xe, so Ldexp will
			// under/overflow (0 / Inf) regardless.
			ae = ae + xe
			break
		}
		if (i & 1) == 1 {
			a1 = a1 * x1
			ae = ae + xe
		}
		x1 = x1 * x1
		xe = xe << 1
		if x1 < 0.5 {
			x1 = x1 + x1
			xe = xe - 1
		}
	}

	// ans = a1 * 2**ae; invert for negative y (in the opposite order).
	if y < 0.0 {
		a1 = 1.0 / a1
		ae = -ae
	}
	return Ldexp(a1, ae)
}
