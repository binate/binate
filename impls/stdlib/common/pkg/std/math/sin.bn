package "pkg/std/math"

// Coefficients and constants for Sin/Cos (Go's math/sin.go, FreeBSD fdlibm).
const (
	// Pi/4 split into three parts for extended-precision modular reduction.
	sinPI4A float64 = 7.85398125648498535156e-1
	sinPI4B float64 = 3.77489470793079817668e-8
	sinPI4C float64 = 2.69515142907905952645e-15
	// 4/Pi (matches Go's arbitrary-precision constant bit-for-bit).
	sinM4PI float64 = 1.2732395447351628
)

// sinTab/cosTab are the minimax polynomial coefficients for sin and cos on
// [0, Pi/4] (Go's _sin / _cos).
var sinTab [6]float64 = [6]float64{
	1.58962301576546568060e-10, -2.50507477628578072866e-8, 2.75573136213857245213e-6,
	-1.98412698295895385996e-4, 8.33333333332211858878e-3, -1.66666666666666307295e-1,
}
var cosTab [6]float64 = [6]float64{
	-1.13585365213876817300e-11, 2.08757008419747316778e-9, -2.75573141792967388112e-7,
	2.48015872888517045348e-5, -1.38888888888730564116e-3, 4.16666666666665929218e-2,
}

// Sin returns the sine of the radian argument x.  Sin(±0)=±0, Sin(±Inf)=NaN,
// Sin(NaN)=NaN.
func Sin(x float64) float64 {
	// special cases
	if x == 0.0 || IsNaN(x) {
		return x // ±0 or NaN
	}
	if IsInf(x, 0) {
		return NaN()
	}

	// make argument positive but save the sign
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}

	var j uint64 = cast(uint64, 0)
	var y float64 = 0.0
	var z float64 = 0.0
	if x >= reduceThreshold {
		j, z = trigReduce(x)
	} else {
		j = cast(uint64, x*sinM4PI) // integer part of x/(Pi/4)
		y = cast(float64, j)
		// map zeros to origin
		if (j & 1) == 1 {
			j = j + 1
			y = y + 1.0
		}
		j = j & 7 // octant modulo 2Pi
		z = ((x - y*sinPI4A) - y*sinPI4B) - y*sinPI4C
	}
	// reflect in x axis
	if j > 3 {
		sign = !sign
		j = j - 4
	}
	var zz float64 = z * z
	if j == 1 || j == 2 {
		y = 1.0 - 0.5*zz + zz*zz*((((((cosTab[0]*zz)+cosTab[1])*zz+cosTab[2])*zz+
			cosTab[3])*zz+cosTab[4])*zz+cosTab[5])
	} else {
		y = z + z*zz*((((((sinTab[0]*zz)+sinTab[1])*zz+sinTab[2])*zz+
			sinTab[3])*zz+sinTab[4])*zz+sinTab[5])
	}
	if sign {
		y = -y
	}
	return y
}

// Cos returns the cosine of the radian argument x.  Cos(±Inf)=NaN, Cos(NaN)=NaN.
func Cos(x float64) float64 {
	// special cases
	if IsNaN(x) || IsInf(x, 0) {
		return NaN()
	}

	// make argument positive
	var sign bool = false
	x = Abs(x)

	var j uint64 = cast(uint64, 0)
	var y float64 = 0.0
	var z float64 = 0.0
	if x >= reduceThreshold {
		j, z = trigReduce(x)
	} else {
		j = cast(uint64, x*sinM4PI)
		y = cast(float64, j)
		if (j & 1) == 1 {
			j = j + 1
			y = y + 1.0
		}
		j = j & 7
		z = ((x - y*sinPI4A) - y*sinPI4B) - y*sinPI4C
	}
	if j > 3 {
		j = j - 4
		sign = !sign
	}
	if j > 1 {
		sign = !sign
	}
	var zz float64 = z * z
	if j == 1 || j == 2 {
		y = z + z*zz*((((((sinTab[0]*zz)+sinTab[1])*zz+sinTab[2])*zz+
			sinTab[3])*zz+sinTab[4])*zz+sinTab[5])
	} else {
		y = 1.0 - 0.5*zz + zz*zz*((((((cosTab[0]*zz)+cosTab[1])*zz+cosTab[2])*zz+
			cosTab[3])*zz+cosTab[4])*zz+cosTab[5])
	}
	if sign {
		y = -y
	}
	return y
}
