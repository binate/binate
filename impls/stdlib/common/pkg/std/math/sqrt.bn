package "pkg/std/math"

// Sqrt returns the correctly-rounded square root of x.
//   Sqrt(+Inf) = +Inf
//   Sqrt(±0)   = ±0
//   Sqrt(x < 0) = NaN
//   Sqrt(NaN)  = NaN
//
// Software implementation (Go's pure-Go fallback): a digit-by-digit
// integer square root over the significand, with round-half-to-even —
// correctly rounded, identical on every backend. A hardware `sqrt`
// intrinsic may replace this as a fast path later (see plan-std-math.md).
//
// Note: Binate's shift binds looser than `+`, so the final
// `(q >> 1) + (... << shift)` is fully parenthesized (Go relies on the
// opposite precedence).
func Sqrt(x float64) float64 {
	// special cases
	if x == 0.0 || IsNaN(x) || IsInf(x, 1) {
		return x
	}
	if x < 0.0 {
		return NaN()
	}

	var ix uint64 = Float64bits(x)
	// normalize x
	var exp int = cast(int, (ix >> shift) & expMask)
	if exp == 0 {  // subnormal x
		for (ix & (cast(uint64, 1) << shift)) == cast(uint64, 0) {
			ix = ix << cast(uint64, 1)
			exp = exp - 1
		}
		exp = exp + 1
	}
	exp = exp - cast(int, bias)         // unbias exponent
	ix = ix & ~(expMask << shift)
	ix = ix | (cast(uint64, 1) << shift)
	if (exp & 1) == 1 {                 // odd exp: double x to make it even
		ix = ix << cast(uint64, 1)
	}
	exp = exp >> 1                       // exp = exp/2, the root's exponent

	// generate sqrt(x) bit by bit
	ix = ix << cast(uint64, 1)
	var q uint64 = 0                     // q = sqrt(x)
	var s uint64 = 0
	var r uint64 = cast(uint64, 1) << (shift + cast(uint64, 1))  // MSB->LSB bit
	for r != cast(uint64, 0) {
		var t uint64 = s + r
		if t <= ix {
			s = t + r
			ix = ix - t
			q = q + r
		}
		ix = ix << cast(uint64, 1)
		r = r >> cast(uint64, 1)
	}

	// final rounding
	if ix != cast(uint64, 0) {          // inexact: round half to even
		q = q + (q & cast(uint64, 1))
	}
	// significand + biased exponent (parenthesized — see the note above)
	ix = (q >> cast(uint64, 1)) +
		(cast(uint64, exp - 1 + cast(int, bias)) << shift)
	return Float64frombits(ix)
}
