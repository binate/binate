package "pkg/std/math"

// Minimax rational-approximation coefficients for Tan on [0, Pi/4] (Go's
// math/tan.go _tanP / _tanQ).  tanQTab[0] == 1 is the implicit leading
// denominator coefficient (the expression starts the denominator at zz).
var tanPTab [3]float64 = [3]float64{
	-1.30936939181383777646e4, 1.15351664838587416140e6, -1.79565251976484877988e7,
}
// tanQTab: denominator coefficients for the Tan rational approximation;
// tanQTab[0] == 1 is the implicit leading term (see tanPTab note above).
var tanQTab [5]float64 = [5]float64{
	1.00000000000000000000e0, 1.36812963470692954678e4, -1.32089234440210967447e6,
	2.50083801823357915839e7, -5.38695755929454629881e7,
}

// Tan returns the tangent of the radian argument x.  Tan(±0)=±0,
// Tan(±Inf)=NaN, Tan(NaN)=NaN.
func Tan(x float64) float64 {
	// special cases
	if x == 0.0 || IsNaN(x) {
		return x // ±0 or NaN
	}
	if IsInf(x, 0) {
		return NaN()
	}

	// make argument positive but save the sign
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}

	var j uint64 = cast(uint64, 0)
	var y float64 = 0.0
	var z float64 = 0.0
	if x >= reduceThreshold {
		j, z = trigReduce(x)
	} else {
		j = cast(uint64, x*sinM4PI)
		y = cast(float64, j)
		// map zeros and singularities to origin
		if (j & 1) == 1 {
			j = j + 1
			y = y + 1.0
		}
		z = ((x - y*sinPI4A) - y*sinPI4B) - y*sinPI4C
	}
	var zz float64 = z * z
	if zz > 1e-14 {
		y = z + z*(zz*(((tanPTab[0]*zz)+tanPTab[1])*zz+tanPTab[2])/
			((((zz+tanQTab[1])*zz+tanQTab[2])*zz+tanQTab[3])*zz+tanQTab[4]))
	} else {
		y = z
	}
	if (j & 2) == 2 {
		y = -1.0 / y
	}
	if sign {
		y = -y
	}
	return y
}
