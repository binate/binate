package "pkg/std/math"

// Minimax coefficients for Tanh on [0, 0.625] (Go's math/tanh.go).
const tanhMAXLOG float64 = 8.8029691931113054295988e+01 // log(2**127)
// tanhPTab: numerator coefficients of the Tanh minimax rational on [0, 0.625].
var tanhPTab [3]float64 = [3]float64{
	-9.64399179425052238628e-1, -9.92877231001918586564e1, -1.61468768441708447952e3,
}
// tanhQTab: denominator coefficients of the Tanh minimax rational on [0, 0.625].
var tanhQTab [3]float64 = [3]float64{
	1.12811678491632931402e2, 2.23548839060100448583e3, 4.84406305325125486048e3,
}

// Tanh returns the hyperbolic tangent of x.  Tanh(±0)=±0, Tanh(±Inf)=±1,
// Tanh(NaN)=NaN.
func Tanh(x float64) float64 {
	var z float64 = Abs(x)
	if z > 0.5*tanhMAXLOG {
		if x < 0.0 {
			return -1.0
		}
		return 1.0
	}
	if z >= 0.625 {
		var s float64 = Exp(2.0 * z)
		z = 1.0 - 2.0/(s+1.0)
		if x < 0.0 {
			z = -z
		}
	} else {
		if x == 0.0 {
			return x
		}
		var s float64 = x * x
		z = x + x*s*((tanhPTab[0]*s+tanhPTab[1])*s+tanhPTab[2])/
			(((s+tanhQTab[0])*s+tanhQTab[1])*s+tanhQTab[2])
	}
	return z
}
