package "pkg/std/math"

// nearULP reports whether got is within one ULP of want (finite, same sign).
//
// Binate's float arithmetic is non-fused IEEE; Go's compiler fuses a*b+c into
// an FMA on amd64/arm64, which occasionally flips the last bit.  Both results
// are within Go's documented <=1 ULP accuracy, and FMA is typically the more
// accurate (and faster) of the two — so value tests that exercise the
// FMA-prone polynomials (notably the large-argument trig path through
// trigReduce) assert <=1 ULP against Go's reference rather than a bit-exact
// pin, leaving room for Binate to adopt FMA later without churning the tests.
// Small-argument / simple cases stay bit-exact where they already match.
func nearULP(got float64, want float64) bool {
	if got == want {
		return true
	}
	var g uint64 = Float64bits(got)
	var w uint64 = Float64bits(want)
	if g > w {
		return (g - w) <= cast(uint64, 1)
	}
	return (w - g) <= cast(uint64, 1)
}
