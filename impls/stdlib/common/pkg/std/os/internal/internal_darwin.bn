// Darwin impl of pkg/std/os/internal.  Darwin reaches the C errno through
// `int *__error(void)`.  Gated to Darwin targets by its #[build(...)]
// constraint, so only __error is referenced when building for Darwin — the
// Linux __errno_location never has to link.  (OS-, not arch-specific: the
// errno accessor is the same on every Darwin arch.)
#[build(is(os, "darwin"))]
package "pkg/std/os/internal"

// Errno returns the current value of the C errno (thread-local).
func Errno() int {
	var p *int32 = __c_call("__error", *int32)
	return cast(int, p[0])
}
