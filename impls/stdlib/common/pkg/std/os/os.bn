// libc-backed pkg/std/os: the File handle and the Open / OpenFile /
// Create entry points, implemented over the POSIX open/read/write/
// pread/pwrite/lseek/close family reached through __c_call.
//
// C-signature reference (no pkg/c alias package exists yet, so the C
// types are spelled in raw Binate widths, with the C type in a comment).
// C `int` is 32-bit even on an LP64 host, so it is spelled `int32`, NOT
// Binate `int` (which is pointer-width); size_t / ssize_t are
// pointer-width (`uint` / `int`); off_t is 64-bit on our LP64 libc
// hosts.
//
//   int     open  (const char *path, int flags, ... /* mode_t mode */);
//   ssize_t read  (int fd, void *buf, size_t count);
//   ssize_t write (int fd, const void *buf, size_t count);
//   ssize_t pread (int fd, void *buf, size_t count, off_t offset);
//   ssize_t pwrite(int fd, const void *buf, size_t count, off_t offset);
//   off_t   lseek (int fd, off_t offset, int whence);
//   int     close (int fd);
//
// Selected on every target except bare metal, which has its own stub variant
// (os_baremetal.bn).  See plan-impls-constraints-migration.md.
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/build"
import "pkg/std/errors"
import "pkg/std/io"

// Open flags, mirrored from os.bni (the two must stay in sync — the
// .bni copy is the exported surface, this copy is what this impl's own
// code translates).  Binate's own portable values; nativeOpenFlags maps
// them onto the host's native open(2) flags.
const (
	O_RDONLY int = 0x0000
	O_WRONLY int = 0x0001
	O_RDWR   int = 0x0002

	O_APPEND int = 0x0008
	O_CREATE int = 0x0010
	O_EXCL   int = 0x0020
	O_TRUNC  int = 0x0040
	O_SYNC   int = 0x0080
)

// nativeOpenFlags maps the portable O_* bits to the host libc's native
// open(2) flags, selecting the OS at COMPILE TIME via build.OS — a
// per-target constant from pkg/builtins/build that the compiler folds,
// so there is no runtime OS check.  The three access modes
// (O_RDONLY/WRONLY/RDWR = 0/1/2) are identical on every POSIX OS and
// pass straight through; only the modifier bits diverge between Linux
// and macOS.  This libc impl is only compiled for a libc OS (Linux or
// Darwin) — the bare-metal flavor is a separate package — so the two
// arms are exhaustive.
func nativeOpenFlags(flag int) int {
	var native int = flag & 0x3  // access mode: identical on every POSIX OS
	if build.OS == build.OS_DARWIN {
		if flag & O_APPEND != 0 { native = native | 0x0008 }  // macOS O_APPEND
		if flag & O_CREATE != 0 { native = native | 0x0200 }  // macOS O_CREAT
		if flag & O_EXCL   != 0 { native = native | 0x0800 }  // macOS O_EXCL
		if flag & O_TRUNC  != 0 { native = native | 0x0400 }  // macOS O_TRUNC
		if flag & O_SYNC   != 0 { native = native | 0x0080 }  // macOS O_SYNC
	} else {
		// Linux (asm-generic; x86_64 / aarch64 / arm32 all share these).
		if flag & O_APPEND != 0 { native = native | 0x0400 }   // Linux O_APPEND
		if flag & O_CREATE != 0 { native = native | 0x0040 }   // Linux O_CREAT
		if flag & O_EXCL   != 0 { native = native | 0x0080 }   // Linux O_EXCL
		if flag & O_TRUNC  != 0 { native = native | 0x0200 }   // Linux O_TRUNC
		if flag & O_SYNC   != 0 { native = native | 0x101000 } // Linux O_SYNC (compound)
	}
	return native
}

// dataOf returns a raw *uint8 to the first byte of a mutable byte
// slice's backing.  `&p[0]` is currently restricted to slice-of-struct
// (genIndexPtr), so reach the data word directly: a raw slice is
// {data, len} and the data pointer is the first word.  Caller must
// ensure len(p) > 0 (the data word may be null for an empty slice).
func dataOf(p *[]uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// dataOfRO is dataOf for a readonly byte slice (write's buffer).  C
// write/pwrite take a `const void *`, so handing back a plain *uint8 is
// fine — the bytes are only read.
func dataOfRO(p *[]readonly uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// dataOfManaged is dataOf for a managed byte slice (the NUL-terminated
// path buffer).  A managed slice is {data, len, refptr, backingLen};
// the data pointer is still the first word.
func dataOfManaged(p @[]uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// cPath copies a borrowed path into a fresh NUL-terminated byte buffer
// for the C open(2) family — C strings are NUL-terminated, Binate
// slices are not.  The returned managed-slice owns the bytes; it stays
// alive across the open() call and is released at the caller's
// statement end, by which point open has copied the path.
func cPath(name *[]readonly char) @[]uint8 {
	var n int = len(name)
	var buf @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ {
		buf[i] = cast(uint8, name[i])
	}
	buf[n] = cast(uint8, 0)
	return buf
}

// newFile boxes a raw descriptor into an owned @File.
func newFile(fd int) @File {
	var f @File = make(File)
	f.fd = fd
	return f
}

// Read reads into p via read(2).  read returning 0 on a non-empty p is
// end-of-input → io.EOF.  A read interrupted by a signal before any byte
// moved (-1/EINTR) is retried, so EINTR never leaks to the caller — a
// partial read returns the short count, not EINTR, so re-issuing is safe.
func (f *File) Read(p *[]uint8) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	for {
		n = __c_call("read", int, cast(int32, f.fd), dataOf(p),
			cast(uint, len(p)))
		if n >= 0 || readErrno() != EINTR { break }
	}
	if n < 0 { return 0, failErrno("read") }
	if n == 0 { return 0, io.EOF }
	return n, noErr
}

// Write writes p via write(2).  A short write (n < len(p)) is reported
// with an error, as io.Writer requires.
func (f *File) Write(p *[]readonly uint8) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	for {
		n = __c_call("write", int, cast(int32, f.fd), dataOfRO(p),
			cast(uint, len(p)))
		if n >= 0 || readErrno() != EINTR { break }  // EINTR before any byte: retry
	}
	if n < 0 { return 0, failErrno("write") }
	if n < len(p) { return n, errors.Wrap(errors.Unknown, "short write") }
	return n, noErr
}

// Close closes the descriptor via close(2).
func (f *File) Close() @errors.Error {
	var r int32 = __c_call("close", int32, cast(int32, f.fd))
	if cast(int, r) < 0 {
		// close(2) on EINTR: on both Linux and macOS/BSD the descriptor
		// is released even when close reports EINTR, so a retry could
		// close an unrelated (reused) fd — treat EINTR as success.
		if readErrno() == EINTR {
			var noErr @errors.Error
			return noErr
		}
		return failErrno("close")
	}
	var noErr @errors.Error
	return noErr
}

// ReadAt reads at an explicit offset via pread(2), leaving the stream
// position untouched.  A read that cannot fill p (including at EOF)
// returns io.EOF, honoring the io.ReaderAt "n < len(p) ⟹ error"
// contract; for a regular file a short pread means end-of-file.
func (f *File) ReadAt(p *[]uint8, off int64) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	for {
		n = __c_call("pread", int, cast(int32, f.fd), dataOf(p),
			cast(uint, len(p)), off)
		if n >= 0 || readErrno() != EINTR { break }  // EINTR before any byte: retry
	}
	if n < 0 { return 0, failErrno("pread") }
	if n < len(p) { return n, io.EOF }
	return n, noErr
}

// WriteAt writes at an explicit offset via pwrite(2), leaving the stream
// position untouched.
func (f *File) WriteAt(p *[]readonly uint8, off int64) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	for {
		n = __c_call("pwrite", int, cast(int32, f.fd), dataOfRO(p),
			cast(uint, len(p)), off)
		if n >= 0 || readErrno() != EINTR { break }  // EINTR before any byte: retry
	}
	if n < 0 { return 0, failErrno("pwrite") }
	if n < len(p) { return n, errors.Wrap(errors.Unknown, "short write") }
	return n, noErr
}

// Seek repositions the stream via lseek(2).  The portable Whence values
// (0/1/2) equal the native SEEK_SET/CUR/END on every POSIX target, so
// no translation is needed.  Unlike read/write, lseek does not block, so it
// cannot return EINTR — no retry loop is needed.
func (f *File) Seek(offset int64, whence Whence) (int64, @errors.Error) {
	var pos int64 = __c_call("lseek", int64, cast(int32, f.fd), offset,
		cast(int32, cast(int, whence)))
	if pos < cast(int64, 0) {
		return cast(int64, 0), failErrno("lseek")
	}
	var noErr @errors.Error
	return pos, noErr
}

// ReadByte reads the next byte via Read.  At end-of-input the error is
// io.EOF and the returned byte is unspecified (io.ByteReader), so callers
// must check the error first.  A one-byte stack buffer avoids a heap
// allocation per call.
func (f *File) ReadByte() (uint8, @errors.Error) {
	var b [1]uint8
	var err @errors.Error
	_, err = f.Read(b[0:1])
	if present(err) { return cast(uint8, 0), err }
	return b[0], err
}

// WriteByte writes a single byte via Write.
func (f *File) WriteByte(c uint8) @errors.Error {
	var b [1]uint8
	b[0] = c
	var err @errors.Error
	_, err = f.Write(b[0:1])
	return err
}

// OpenFile opens name via open(2).  mode is always passed (open ignores
// it without O_CREATE) as the trailing vararg, per the C prototype
// `int open(const char *, int, ...)`.
func OpenFile(name *[]readonly char, flag int, perm FileMode) (@File, @errors.Error) {
	var path @[]uint8 = cPath(name)
	var fd int32
	for {
		fd = __c_call("open", int32, dataOfManaged(path),
			cast(int32, nativeOpenFlags(flag)), ..., cast(int32, perm))
		if cast(int, fd) >= 0 || readErrno() != EINTR { break }  // EINTR: retry open
	}
	if cast(int, fd) < 0 {
		var none @File
		return none, failErrno("open")
	}
	return newFile(cast(int, fd)), errEmpty()
}

// Open opens name read-only.  Open is OpenFile(name, O_RDONLY, 0).
func Open(name *[]readonly char) (@File, @errors.Error) {
	return OpenFile(name, O_RDONLY, cast(FileMode, 0))
}

// Create creates or truncates name for read-write with mode 0o666.
// Create is OpenFile(name, O_RDWR|O_CREATE|O_TRUNC, 0o666).
func Create(name *[]readonly char) (@File, @errors.Error) {
	return OpenFile(name, O_RDWR | O_CREATE | O_TRUNC, cast(FileMode, 0o666))
}

// errEmpty is the empty (no-error) @errors.Error returned on success.
func errEmpty() @errors.Error {
	var noErr @errors.Error
	return noErr
}

// Stdin is the standard input stream, wrapping descriptor 0.  A
// process-lifetime handle — never Close it.
var Stdin  @File = newFile(0)
// Stdout is the standard output stream, wrapping descriptor 1.  A
// process-lifetime handle — never Close it.
var Stdout @File = newFile(1)
// Stderr is the standard error stream, wrapping descriptor 2.  A
// process-lifetime handle — never Close it.
var Stderr @File = newFile(2)
