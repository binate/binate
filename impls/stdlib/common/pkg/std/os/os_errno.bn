// errno → base-failure mapping for the libc os impl.
//
// errno NUMERIC VALUES differ between Linux and macOS for several codes
// (EAGAIN, ENAMETOOLONG, ELOOP, ENOSYS, EOVERFLOW, EDQUOT, EOPNOTSUPP),
// so the per-OS numbers are selected at compile time by build.OS — the
// same mechanism nativeOpenFlags uses for the O_* flags.  The low codes
// (1..34) are the original Unix numbering and are identical on both.
//
// These values are NOT all testable (we can only trigger a few errnos
// from os's surface), so the full table is verified against the real
// <errno.h> on each OS by e2e/errno-values.sh — the system C compiler is
// the authoritative source (Linux CI covers the Linux column; a mac covers
// the Darwin column).  See explorations/plan-std-error-hierarchy.md §7.
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/build"
import "pkg/std/errors"
import "pkg/std/os/internal"

// errno values shared by Linux and macOS (the classic Unix codes 1..34).
const (
	EPERM  int = 1
	ENOENT int = 2
	EINTR  int = 4
	EIO    int = 5
	ENXIO  int = 6
	EBADF  int = 9   // defect: a bad/closed descriptor
	ENOMEM int = 12
	EACCES int = 13
	EFAULT int = 14  // defect: a bad pointer
	EBUSY  int = 16
	EEXIST int = 17
	EXDEV  int = 18
	ENODEV int = 19
	ENOTDIR int = 20
	EISDIR int = 21
	EINVAL int = 22
	ENFILE int = 23
	EMFILE int = 24
	ETXTBSY int = 26
	EFBIG  int = 27
	ENOSPC int = 28
	ESPIPE int = 29
	EROFS  int = 30
	EMLINK int = 31
	EPIPE  int = 32
	ERANGE int = 34
)

// readErrno reads the current C errno.  The errno-LOCATION symbol differs
// per OS (__error / __errno_location) and __c_call needs a literal symbol
// that must link, so a build.OS branch here would reference both and fail
// to link the wrong one.  internal.Errno() is supplied by the OS-gated
// pkg/std/os/internal (internal_darwin.bn / internal_linux.bn), so only the
// active OS's symbol is emitted.
func readErrno() int {
	return internal.Errno()
}

// errnoToBase maps a POSIX errno to the base failure it roots in.  Defect
// errnos (EBADF, EFAULT) are caught by failErrno before this; an errno
// with no mapping falls through to Unknown.
func errnoToBase(e int) @errors.Error {
	// Shared low codes (identical Linux/macOS):
	if e == ENOENT { return errors.NotFound }
	if e == EEXIST { return errors.AlreadyExists }
	if e == EPERM || e == EACCES || e == EROFS { return errors.PermissionDenied }
	if e == ENOTDIR || e == EISDIR || e == ETXTBSY { return errors.ConditionsUnmet }
	if e == EINVAL { return errors.InvalidArgument }
	if e == EFBIG || e == ERANGE { return errors.OutOfRange }
	if e == ENOMEM || e == ENFILE || e == EMFILE || e == ENOSPC || e == EMLINK {
		return errors.ResourceExhausted
	}
	if e == ESPIPE || e == EXDEV || e == ENODEV { return errors.Unsupported }
	if e == ENXIO || e == EPIPE { return errors.Unavailable }
	if e == EBUSY { return errors.Retryable }
	if e == EIO { return errors.Unknown }

	// Per-OS codes (values differ; selected by build.OS):
	var eagain int = 11
	var enametoolong int = 36
	var enosys int = 38
	var eloop int = 40
	var eoverflow int = 75
	var eopnotsupp int = 95
	var edquot int = 122
	if build.OS == build.OS_DARWIN {
		eagain = 35
		enametoolong = 63
		eloop = 62
		enosys = 78
		eoverflow = 84
		eopnotsupp = 102
		edquot = 69
	}
	if e == eagain { return errors.Retryable }
	if e == enametoolong { return errors.InvalidArgument }
	if e == eloop { return errors.ConditionsUnmet }
	if e == enosys { return errors.Unsupported }
	if e == eoverflow { return errors.OutOfRange }
	if e == eopnotsupp { return errors.Unsupported }
	if e == edquot { return errors.ResourceExhausted }

	return errors.Unknown
}

// failErrno builds the error for a failed syscall: it reads errno, ABORTS
// (panic) on a defect errno (EBADF / EFAULT — programmer bugs, not
// recoverable conditions: a closed/bogus fd or a bad buffer pointer), and
// otherwise wraps the mapped base failure with op as context (so it
// renders "op: <base message>" and classifies under the base).  op is a
// short verb like "open" / "read".
func failErrno(op @[]readonly char) @errors.Error {
	var e int = readErrno()
	if e == EBADF || e == EFAULT {
		panic("os: bad descriptor or fault — programmer error")
	}
	return errors.Wrap(errnoToBase(e), op)
}
