package "pkg/std/strconv"

import "pkg/std/errors"
import "pkg/std/math/big"

// ParseFloat is the exact, correctly-rounded decimal->binary conversion: it
// rounds the input to the nearest float (round-half-to-even) by evaluating
// mantissa * 10^decExp as an exact rational over big.Nat — the inverse of
// FormatFloat, free of the table-maker's dilemma.  The pieces below mirror
// Go's strconv slow path.

// floatFmt captures the per-format constants of an IEEE-754 binary float.
//   mb        significand bits including the implicit 1 (53 / 24)
//   bias      exponent bias (1023 / 127)
//   minE2     smallest binary exponent (subnormal floor): -1074 / -149
//   maxBiased the all-ones biased exponent (Inf/NaN): 2047 / 255
//   signShift sign-bit position: 63 / 31
type floatFmt struct {
	mb        int
	bias      int
	minE2     int
	maxBiased int
	signShift int
}

func f64fmt() floatFmt {
	var f floatFmt
	f.mb = 53
	f.bias = 1023
	f.minE2 = 0 - 1074
	f.maxBiased = 2047
	f.signShift = 63
	return f
}

func f32fmt() floatFmt {
	var f floatFmt
	f.mb = 24
	f.bias = 127
	f.minE2 = 0 - 149
	f.maxBiased = 255
	f.signShift = 31
	return f
}

// lowerByte lowercases an ASCII letter (leaving other bytes unchanged).
func lowerByte(c uint8) uint8 {
	if c >= 'A' && c <= 'Z' {
		return cast(uint8, cast(int, c) + 32)
	}
	return c
}

// isDigitByte reports whether c is an ASCII decimal digit.
func isDigitByte(c uint8) bool {
	return c >= '0' && c <= '9'
}

// digitFlanked reports whether s[i] sits strictly between two digits — the
// validity rule for a '_' digit separator (Go accepts '_' only there).
func digitFlanked(s *[]readonly uint8, i int) bool {
	return i > 0 && isDigitByte(s[i - 1]) &&
		i + 1 < len(s) && isDigitByte(s[i + 1])
}

// ciEqual compares a byte view to a literal case-insensitively (ASCII).
func ciEqual(s *[]readonly uint8, lit *[]readonly char) bool {
	if len(s) != len(lit) {
		return false
	}
	for i := 0; i < len(s); i++ {
		if lowerByte(s[i]) != lowerByte(lit[i]) {
			return false
		}
	}
	return true
}

// lexInfo is lexFloat's scalar result; the significand digits are written
// into the caller-provided mant.  kind: 0 number, 1 +Inf, 2 -Inf, 3 NaN,
// 4 syntax error.  decExp is the power of ten to apply (exponent minus the
// fraction-digit count); nsig is the significant-digit count (for the
// magnitude guard).
type lexInfo struct {
	decExp int
	nsig   int
	kind   int
	neg    bool
}

// lexFloat scans s as `[sign] digits [. digits] [ (e|E) [sign] digits ]`,
// or the case-insensitive specials inf/infinity/nan (nan takes no sign).
// It accumulates the significand into mant and returns the scalar lexInfo.
func lexFloat(s *[]readonly uint8, mant @big.Nat) lexInfo {
	var r lexInfo
	r.kind = 4
	mant.SetUint64(cast(uint64, 0))
	if len(s) == 0 {
		return r
	}
	if ciEqual(s, "nan") {
		r.kind = 3
		return r
	}
	var i int = 0
	if s[0] == '+' {
		i = 1
	} else if s[0] == '-' {
		r.neg = true
		i = 1
	}
	var rest *[]readonly uint8 = s[i:len(s)]
	if ciEqual(rest, "inf") || ciEqual(rest, "infinity") {
		if r.neg {
			r.kind = 2
		} else {
			r.kind = 1
		}
		return r
	}
	var sawDigit bool = false
	var sawDot bool = false
	var fracDigits int = 0
	var nsig int = 0
	for i < len(s) {
		var c uint8 = s[i]
		if c >= '0' && c <= '9' {
			mant.MulUint32(mant, cast(uint32, 10))
			mant.AddUint32(mant, cast(uint32, cast(int, c) - cast(int, '0')))
			nsig = nsig + 1
			if sawDot {
				fracDigits = fracDigits + 1
			}
			sawDigit = true
			i = i + 1
		} else if c == '.' && !sawDot {
			sawDot = true
			i = i + 1
		} else if c == '_' {
			// A digit separator is valid only between two digits.
			if digitFlanked(s, i) {
				i = i + 1
			} else {
				return r
			}
		} else {
			break
		}
	}
	if !sawDigit {
		return r
	}
	var expVal int = 0
	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
		i = i + 1
		var eNeg bool = false
		if i < len(s) && (s[i] == '+' || s[i] == '-') {
			eNeg = (s[i] == '-')
			i = i + 1
		}
		if i >= len(s) || s[i] < '0' || s[i] > '9' {
			return r
		}
		for i < len(s) {
			var ec uint8 = s[i]
			if ec >= '0' && ec <= '9' {
				if expVal < 1000000000 {
					expVal = expVal * 10 + (cast(int, ec) - cast(int, '0'))
				}
				i = i + 1
			} else if ec == '_' && digitFlanked(s, i) {
				i = i + 1
			} else {
				break
			}
		}
		if eNeg {
			expVal = 0 - expVal
		}
	}
	if i != len(s) {
		return r
	}
	r.decExp = expVal - fracDigits
	r.nsig = nsig
	r.kind = 0
	return r
}

// pow10 returns 10^n as a fresh Nat (n >= 0).
func pow10(n int) @big.Nat {
	var z @big.Nat = big.FromUint64(cast(uint64, 1))
	pow10Mul(z, n)
	return z
}

// shiftNum returns N << k (k >= 0) or N (k < 0), shiftDen the complement —
// together they form the numerator/denominator for floor(N*2^k/D).
func shiftedNum(N @big.Nat, k int) @big.Nat {
	var num @big.Nat = N.Clone()
	if k >= 0 {
		num.Shl(num, cast(uint, k))
	}
	return num
}
func shiftedDen(D @big.Nat, k int) @big.Nat {
	var den @big.Nat = D.Clone()
	if k < 0 {
		den.Shl(den, cast(uint, 0 - k))
	}
	return den
}

// floorBits returns the bit length of floor(N * 2^k / D) — used to find the
// binary exponent that normalizes the significand to mb bits.
func floorBits(N @big.Nat, D @big.Nat, k int) int {
	var num @big.Nat = shiftedNum(N, k)
	var den @big.Nat = shiftedDen(D, k)
	var q @big.Nat = big.New()
	var r @big.Nat = big.New()
	q, r = q.DivMod(num, den, r)
	return q.BitLen()
}

// roundedSig returns round-half-to-even(N * 2^k / D) as a Nat (<= 2^mb).
func roundedSig(N @big.Nat, D @big.Nat, k int) @big.Nat {
	var num @big.Nat = shiftedNum(N, k)
	var den @big.Nat = shiftedDen(D, k)
	var q @big.Nat = big.New()
	var r @big.Nat = big.New()
	q, r = q.DivMod(num, den, r)
	var r2 @big.Nat = big.New()
	r2.Shl(r, cast(uint, 1))
	var c int = r2.Cmp(den)
	if c > 0 {
		q.AddUint32(q, cast(uint32, 1))
	} else if c == 0 {
		// Exact tie: round to even (bump an odd quotient).
		if (q.ToUint64() & cast(uint64, 1)) == cast(uint64, 1) {
			q.AddUint32(q, cast(uint32, 1))
		}
	}
	return q
}

// convert rounds mant * 10^decExp to the float described by fmt, returning
// the bit pattern (sign-free) and whether the magnitude overflowed (Inf).
func convert(mant @big.Nat, decExp int, nsig int, fmt floatFmt) (uint64, bool) {
	if mant.IsZero() {
		return cast(uint64, 0), false
	}
	var infBits uint64 = cast(uint64, fmt.maxBiased) << cast(uint64, fmt.mb - 1)
	// Guards: mant >= 1 so value >= 10^decExp, and value < 10^(nsig+decExp).
	// Beyond these the result is unambiguously Inf / 0 — short-circuit before
	// building an absurd 10^n.
	if decExp >= 310 {
		return infBits, true
	}
	if nsig + decExp < (0 - 340) {
		return cast(uint64, 0), false
	}
	var N @big.Nat = big.New()
	var D @big.Nat = big.New()
	if decExp >= 0 {
		var p @big.Nat = pow10(decExp)
		N.Mul(mant, p)
		D.SetUint64(cast(uint64, 1))
	} else {
		N.Set(mant)
		D = pow10(0 - decExp)
	}
	var mb int = fmt.mb
	var k int = (mb - 1) - (N.BitLen() - D.BitLen())
	for floorBits(N, D, k) > mb {
		k = k - 1
	}
	for floorBits(N, D, k) < mb {
		k = k + 1
	}
	var biased int = (mb - 1) - k + fmt.bias
	if biased >= fmt.maxBiased {
		return infBits, true
	}
	if biased >= 1 {
		var msig @big.Nat = roundedSig(N, D, k)
		if msig.BitLen() > mb {
			// Rounded up to 2^mb: renormalize (halve, bump the exponent).
			msig.Shr(msig, cast(uint, 1))
			biased = biased + 1
			if biased >= fmt.maxBiased {
				return infBits, true
			}
		}
		var m uint64 = msig.ToUint64()
		var frac uint64 = m - (cast(uint64, 1) << cast(uint64, mb - 1))
		return (cast(uint64, biased) << cast(uint64, mb - 1)) | frac, false
	}
	// Subnormal regime: round at the fixed exponent floor (e2 = minE2).  The
	// significand IS the bit pattern (exp field 0 for subnormals; the
	// smallest-normal boundary lands as 2^(mb-1) automatically), so 0 here is
	// underflow to zero (not a range error).
	var kmax int = 0 - fmt.minE2
	var sub @big.Nat = roundedSig(N, D, kmax)
	return sub.ToUint64(), false
}

// makeFloat reinterprets bits as a float64, or (bitSize 32) as a float32
// widened to float64 — exactly as Go's ParseFloat returns a 32-bit result.
func makeFloat(bits uint64, bitSize int) float64 {
	if bitSize == 32 {
		var f32 float32 = bit_cast(float32, cast(uint32, bits))
		return cast(float64, f32)
	}
	return bit_cast(float64, bits)
}

// nanFloat returns a quiet NaN.
func nanFloat() float64 {
	var bits uint64 = (cast(uint64, 0x7FF) << cast(uint64, 52)) |
		(cast(uint64, 1) << cast(uint64, 51))
	return bit_cast(float64, bits)
}

// ParseFloat converts s to the nearest float64 (bitSize 64) or the nearest
// float32 widened to float64 (bitSize 32); any other bitSize is treated as
// 64.  It accepts an optional sign, a decimal mantissa with optional
// fraction and exponent, and the case-insensitive specials inf/infinity/nan.
// Overflow returns +/-Inf with a present @errors.Error; underflow returns 0
// (no error), matching Go.  Malformed input yields a syntax error and 0.
// '_' digit separators (between digits) are accepted; hex-float syntax is a
// documented follow-up.
func ParseFloat(s *[]readonly uint8, bitSize int) (float64, @errors.Error) {
	var fmt floatFmt = f64fmt()
	if bitSize == 32 {
		fmt = f32fmt()
	}
	var mant @big.Nat = big.New()
	var info lexInfo = lexFloat(s, mant)
	if info.kind == 4 {
		return bit_cast(float64, cast(uint64, 0)), syntaxErr("ParseFloat", s)
	}
	var sign uint64 = cast(uint64, 0)
	if info.neg {
		sign = cast(uint64, 1) << cast(uint64, fmt.signShift)
	}
	if info.kind == 1 || info.kind == 2 {
		// Explicit inf/infinity is NOT a range error (unlike overflow).
		var ibits uint64 = (cast(uint64, fmt.maxBiased) << cast(uint64, fmt.mb - 1)) | sign
		var okI @errors.Error
		return makeFloat(ibits, bitSize), okI
	}
	if info.kind == 3 {
		var okN @errors.Error
		return nanFloat(), okN
	}
	var bits uint64
	var ovf bool
	bits, ovf = convert(mant, info.decExp, info.nsig, fmt)
	bits = bits | sign
	var v float64 = makeFloat(bits, bitSize)
	if ovf {
		return v, rangeErr("ParseFloat", s)
	}
	var okF @errors.Error
	return v, okF
}
