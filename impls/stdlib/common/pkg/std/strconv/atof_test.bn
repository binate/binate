package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/errors"

// pfOK: ParseFloat(s,bitSize) succeeds and its float64 bits equal want.
// (msgEndsWith / isRangeErr live in atoi_test.bn — same package.)
func pfOK(s *[]readonly char, bitSize int, want uint64) bool {
	var v float64
	var err @errors.Error
	v, err = ParseFloat(s, bitSize)
	if present(err) {
		return false
	}
	return bit_cast(uint64, v) == want
}

// pfRange: ParseFloat range-errors and the result bits equal want.
func pfRange(s *[]readonly char, bitSize int, want uint64) bool {
	var v float64
	var err @errors.Error
	v, err = ParseFloat(s, bitSize)
	if !isRangeErr(err) {
		return false
	}
	return bit_cast(uint64, v) == want
}

// pfSyntax: ParseFloat syntax-errors with a 0 value.
func pfSyntax(s *[]readonly char) bool {
	var v float64
	var err @errors.Error
	v, err = ParseFloat(s, 64)
	if !isSyntaxErr(err) {
		return false
	}
	return bit_cast(uint64, v) == cast(uint64, 0)
}

// pf32OK: ParseFloat(s,32) succeeds; the float32 bits (narrowed back from
// the widened result) equal want.
func pf32OK(s *[]readonly char, want uint32) bool {
	var v float64
	var err @errors.Error
	v, err = ParseFloat(s, 32)
	if present(err) {
		return false
	}
	return bit_cast(uint32, cast(float32, v)) == want
}

func pf32Range(s *[]readonly char, want uint32) bool {
	var v float64
	var err @errors.Error
	v, err = ParseFloat(s, 32)
	if !isRangeErr(err) {
		return false
	}
	return bit_cast(uint32, cast(float32, v)) == want
}

func TestParseFloatNormal() testing.TestResult {
	if !pfOK("0", 64, cast(uint64, 0)) { return fail("0") }
	if !pfOK("0.1", 64, cast(uint64, 0x3fb999999999999a)) { return fail("0.1") }
	if !pfOK("0.2", 64, cast(uint64, 0x3fc999999999999a)) { return fail("0.2") }
	if !pfOK("0.3", 64, cast(uint64, 0x3fd3333333333333)) { return fail("0.3") }
	if !pfOK("1.5", 64, cast(uint64, 0x3ff8000000000000)) { return fail("1.5") }
	if !pfOK("1.", 64, cast(uint64, 0x3ff0000000000000)) { return fail("1.") }
	if !pfOK(".5", 64, cast(uint64, 0x3fe0000000000000)) { return fail(".5") }
	if !pfOK("+.5", 64, cast(uint64, 0x3fe0000000000000)) { return fail("+.5") }
	if !pfOK("1e3", 64, cast(uint64, 0x408f400000000000)) { return fail("1e3") }
	if !pfOK("1.5e2", 64, cast(uint64, 0x4062c00000000000)) { return fail("1.5e2") }
	if !pfOK("1e-3", 64, cast(uint64, 0x3f50624dd2f1a9fc)) { return fail("1e-3") }
	if !pfOK("-1.5", 64, cast(uint64, 0xbff8000000000000)) { return fail("-1.5") }
	if !pfOK("-0.1", 64, cast(uint64, 0xbfb999999999999a)) { return fail("-0.1") }
	if !pfOK("123456789.123456789", 64, cast(uint64, 0x419d6f34547e6b75)) {
		return fail("123456789.123456789")
	}
	// 2^53+1 is not representable: round-half-to-even -> 2^53.
	if !pfOK("9007199254740993", 64, cast(uint64, 0x4340000000000000)) {
		return fail("9007199254740993 round-to-even")
	}
	return ""
}

func TestParseFloatZeros() testing.TestResult {
	// Signed zero is preserved; zero with any exponent / fraction is zero.
	if !pfOK("+0", 64, cast(uint64, 0)) { return fail("+0") }
	if !pfOK("-0", 64, cast(uint64, 0x8000000000000000)) { return fail("-0 -> -0.0") }
	if !pfOK("0.0", 64, cast(uint64, 0)) { return fail("0.0") }
	if !pfOK(".0", 64, cast(uint64, 0)) { return fail(".0") }
	if !pfOK("0e100", 64, cast(uint64, 0)) { return fail("0e100") }
	if !pfOK("-0.0e5", 64, cast(uint64, 0x8000000000000000)) { return fail("-0.0e5") }
	return ""
}

func TestParseFloatBoundary() testing.TestResult {
	// smallest normal, largest finite
	if !pfOK("2.2250738585072014e-308", 64, cast(uint64, 0x0010000000000000)) {
		return fail("smallest normal")
	}
	if !pfOK("1.7976931348623157e308", 64, cast(uint64, 0x7fefffffffffffff)) {
		return fail("max double")
	}
	// subnormals
	if !pfOK("5e-324", 64, cast(uint64, 0x0000000000000001)) { return fail("5e-324") }
	if !pfOK("4.9e-324", 64, cast(uint64, 0x0000000000000001)) { return fail("4.9e-324") }
	if !pfOK("1e-323", 64, cast(uint64, 0x0000000000000002)) { return fail("1e-323") }
	// underflow to zero: no error
	if !pfOK("2e-324", 64, cast(uint64, 0)) { return fail("2e-324 underflow") }
	if !pfOK("1e-400", 64, cast(uint64, 0)) { return fail("1e-400 underflow") }
	if !pfOK("1e-1000000", 64, cast(uint64, 0)) { return fail("1e-1000000 guard") }
	return ""
}

func TestParseFloatRange() testing.TestResult {
	if !pfRange("1e309", 64, cast(uint64, 0x7ff0000000000000)) { return fail("1e309") }
	if !pfRange("1e400", 64, cast(uint64, 0x7ff0000000000000)) { return fail("1e400") }
	if !pfRange("-1e400", 64, cast(uint64, 0xfff0000000000000)) { return fail("-1e400") }
	if !pfRange("1e1000000", 64, cast(uint64, 0x7ff0000000000000)) {
		return fail("1e1000000 guard")
	}
	return ""
}

func TestParseFloatSpecials() testing.TestResult {
	if !pfOK("inf", 64, cast(uint64, 0x7ff0000000000000)) { return fail("inf") }
	if !pfOK("+inf", 64, cast(uint64, 0x7ff0000000000000)) { return fail("+inf") }
	if !pfOK("-inf", 64, cast(uint64, 0xfff0000000000000)) { return fail("-inf") }
	if !pfOK("Inf", 64, cast(uint64, 0x7ff0000000000000)) { return fail("Inf") }
	if !pfOK("Infinity", 64, cast(uint64, 0x7ff0000000000000)) { return fail("Infinity") }
	if !pfOK("+Infinity", 64, cast(uint64, 0x7ff0000000000000)) { return fail("+Infinity") }
	if !pfOK("-Infinity", 64, cast(uint64, 0xfff0000000000000)) { return fail("-Infinity") }
	// NaN is OK and self-unequal; signed nan is a syntax error.
	var v float64
	var err @errors.Error
	v, err = ParseFloat("nan", 64)
	if present(err) || v == v { return fail("nan must be NaN, no error") }
	v, err = ParseFloat("NaN", 64)
	if present(err) || v == v { return fail("NaN must be NaN") }
	if !pfSyntax("+nan") { return fail("+nan syntax") }
	if !pfSyntax("-nan") { return fail("-nan syntax") }
	return ""
}

func TestParseFloatSyntax() testing.TestResult {
	if !pfSyntax("") { return fail("empty") }
	if !pfSyntax(".") { return fail(".") }
	if !pfSyntax("-.") { return fail("-.") }
	if !pfSyntax("1e") { return fail("1e") }
	if !pfSyntax("e5") { return fail("e5") }
	if !pfSyntax("1.2.3") { return fail("1.2.3") }
	if !pfSyntax(" 1") { return fail("leading space") }
	if !pfSyntax("1 ") { return fail("trailing space") }
	if !pfSyntax("abc") { return fail("abc") }
	if !pfSyntax("+") { return fail("+ alone") }
	return ""
}

// pfSame: two spellings parse (without error) to identical bits.
func pfSame(a *[]readonly char, b *[]readonly char) bool {
	var v1 float64
	var v2 float64
	var e1 @errors.Error
	var e2 @errors.Error
	v1, e1 = ParseFloat(a, 64)
	v2, e2 = ParseFloat(b, 64)
	if present(e1) || present(e2) {
		return false
	}
	return bit_cast(uint64, v1) == bit_cast(uint64, v2)
}

func TestParseFloatUnderscore() testing.TestResult {
	// '_' between digits (int / fraction / exponent) is ignored.
	if !pfSame("1_000", "1000") { return fail("1_000") }
	if !pfSame("1_000.5", "1000.5") { return fail("1_000.5") }
	if !pfSame("1_0.0_1", "10.01") { return fail("1_0.0_1") }
	if !pfSame("1e1_0", "1e10") { return fail("1e1_0") }
	if !pfSame("1.2_3e-4_5", "1.23e-45") { return fail("1.2_3e-4_5") }
	// Misplaced '_' is a syntax error.
	if !pfSyntax("_1") { return fail("_1") }
	if !pfSyntax("1_") { return fail("1_") }
	if !pfSyntax("1__0") { return fail("1__0") }
	if !pfSyntax("1_.5") { return fail("1_.5") }
	if !pfSyntax("1._5") { return fail("1._5") }
	if !pfSyntax("1.5_") { return fail("1.5_") }
	if !pfSyntax("1e_5") { return fail("1e_5") }
	if !pfSyntax("1e5_") { return fail("1e5_") }
	return ""
}

func TestParseFloat32() testing.TestResult {
	if !pf32OK("0.1", cast(uint32, 0x3dcccccd)) { return fail("f32 0.1") }
	if !pf32OK("3.14", cast(uint32, 0x4048f5c3)) { return fail("f32 3.14") }
	if !pf32OK("-0.1", cast(uint32, 0xbdcccccd)) { return fail("f32 -0.1") }
	if !pf32OK("0.5", cast(uint32, 0x3f000000)) { return fail("f32 0.5") }
	if !pf32OK("3.4028235e38", cast(uint32, 0x7f7fffff)) { return fail("f32 max") }
	if !pf32OK("1e-45", cast(uint32, 0x00000001)) { return fail("f32 smallest subnormal") }
	if !pf32OK("1e-46", cast(uint32, 0)) { return fail("f32 underflow") }
	if !pf32Range("3.5e38", cast(uint32, 0x7f800000)) { return fail("f32 overflow") }
	return ""
}

func TestParseFloatHex() testing.TestResult {
	if !pfOK("0x1p4", 64, cast(uint64, 0x4030000000000000)) { return fail("0x1p4") }
	if !pfOK("0x1.8p3", 64, cast(uint64, 0x4028000000000000)) { return fail("0x1.8p3") }
	if !pfOK("0X1.8P-3", 64, cast(uint64, 0x3fc8000000000000)) { return fail("0X1.8P-3") }
	if !pfOK("0x.8p1", 64, cast(uint64, 0x3ff0000000000000)) { return fail("0x.8p1") }
	if !pfOK("0x10p-4", 64, cast(uint64, 0x3ff0000000000000)) { return fail("0x10p-4") }
	if !pfOK("-0x1.8p3", 64, cast(uint64, 0xc028000000000000)) { return fail("-0x1.8p3") }
	if !pfOK("0x1.921fb54442d18p+1", 64, cast(uint64, 0x400921fb54442d18)) {
		return fail("hex pi")
	}
	if !pfOK("0x0p0", 64, cast(uint64, 0)) { return fail("0x0p0") }
	if !pfOK("0x1.fffffffffffffp+1023", 64, cast(uint64, 0x7fefffffffffffff)) {
		return fail("hex max double")
	}
	if !pfOK("0x1p-1074", 64, cast(uint64, 0x0000000000000001)) {
		return fail("hex smallest subnormal")
	}
	if !pfOK("0x1p-1075", 64, cast(uint64, 0)) { return fail("hex underflow") }
	if !pfRange("0x1p1024", 64, cast(uint64, 0x7ff0000000000000)) { return fail("hex overflow") }
	// '_' separators (between hex digits, after the 0x prefix, in the exponent)
	if !pfSame("0x_1p4", "0x1p4") { return fail("0x_1p4") }
	if !pfSame("0x1_0p4", "0x10p4") { return fail("0x1_0p4") }
	if !pfSame("0x1.0_1p4", "0x1.01p4") { return fail("0x1.0_1p4") }
	if !pfSame("0x1p1_0", "0x1p10") { return fail("0x1p1_0") }
	// syntax: mandatory p-exponent, >=1 hex digit, no misplaced '_'
	if !pfSyntax("0x1") { return fail("0x1 (no p)") }
	if !pfSyntax("0x1.8") { return fail("0x1.8 (no p)") }
	if !pfSyntax("0xp4") { return fail("0xp4 (no digit)") }
	if !pfSyntax("0x1p") { return fail("0x1p (no exp digits)") }
	if !pfSyntax("0x1pp4") { return fail("0x1pp4") }
	if !pfSyntax("0x1p4.5") { return fail("0x1p4.5") }
	if !pfSyntax("0x1p_4") { return fail("0x1p_4") }
	if !pfSyntax("0x1p4_") { return fail("0x1p4_") }
	return ""
}

func TestParseFloat32Hex() testing.TestResult {
	if !pf32OK("0x1p4", cast(uint32, 0x41800000)) { return fail("f32 0x1p4") }
	if !pf32OK("0x1.8p3", cast(uint32, 0x41400000)) { return fail("f32 0x1.8p3") }
	if !pf32OK("0x1p-149", cast(uint32, 0x00000001)) { return fail("f32 0x1p-149") }
	if !pf32OK("0x1p-150", cast(uint32, 0)) { return fail("f32 0x1p-150 underflow") }
	if !pf32Range("0x1p128", cast(uint32, 0x7f800000)) { return fail("f32 0x1p128 overflow") }
	return ""
}

// TestParseFloatRoundTrip cross-checks the two directions: the shortest
// FormatFloat of x must parse back to exactly x.
func TestParseFloatRoundTrip() testing.TestResult {
	var xs @[]uint64 = make_slice(uint64, 6)
	xs[0] = cast(uint64, 0x3fb999999999999a) // 0.1
	xs[1] = cast(uint64, 0x400921fb54442d18) // pi
	xs[2] = cast(uint64, 0xc059000000000000) // -100.0
	xs[3] = cast(uint64, 0x0010000000000000) // smallest normal
	xs[4] = cast(uint64, 0x7fefffffffffffff) // max double
	xs[5] = cast(uint64, 0x3ff0000000000000) // 1.0
	for i := 0; i < len(xs); i++ {
		var x float64 = bit_cast(float64, xs[i])
		var s @[]char = FormatFloat(x, 'g', 0 - 1, 64)
		var v float64
		var err @errors.Error
		v, err = ParseFloat(s[0:len(s)], 64)
		if present(err) { return fail("roundtrip parse error") }
		if bit_cast(uint64, v) != xs[i] { return fail("roundtrip mismatch") }
	}
	return ""
}
