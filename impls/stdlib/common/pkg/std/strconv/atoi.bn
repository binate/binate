package "pkg/std/strconv"

import "pkg/std/errors"

// digitVal returns the value of byte c as a base-36 digit — 0..9 for
// '0'..'9', 10..35 for 'a'..'z'/'A'..'Z' (case-insensitive) — or -1 if c
// is not such a digit.
func digitVal(c uint8) int {
	if c >= '0' && c <= '9' {
		return cast(int, c) - cast(int, '0')
	}
	if c >= 'a' && c <= 'z' {
		return cast(int, c) - cast(int, 'a') + 10
	}
	if c >= 'A' && c <= 'Z' {
		return cast(int, c) - cast(int, 'A') + 10
	}
	return -1
}

// platformIntBits returns the platform int width in bits (32 on ILP32, 64
// on LP64), used to resolve a bitSize of 0.  It counts the set bits of an
// all-ones platform uint, avoiding any width-dependent shift (a shift by
// the full width is undefined).
func platformIntBits() int {
	var x uint = cast(uint, 0) - cast(uint, 1)
	var n int = 0
	for x != cast(uint, 0) {
		x = x >> cast(uint, 1)
		n = n + 1
	}
	return n
}

// unsignedMaxFor returns the maximum value of a bs-bit unsigned integer as
// a uint64 (2^bs - 1), special-casing bs >= 64 to dodge a 1<<64 shift.
func unsignedMaxFor(bs int) uint64 {
	if bs >= 64 {
		return cast(uint64, 0) - cast(uint64, 1)
	}
	return (cast(uint64, 1) << cast(uint64, bs)) - cast(uint64, 1)
}

// signedMax / signedMin return the extremes of a bs-bit signed integer as
// an int64: +2^(bs-1)-1 and -2^(bs-1).  bit_cast carries the bit pattern
// through unchanged, so the bs==64 case (whose magnitude does not fit in a
// positive int64) is handled without overflow.
func signedMax(bs int) int64 {
	var cutoff uint64 = cast(uint64, 1) << cast(uint64, bs - 1)
	return bit_cast(int64, cutoff - cast(uint64, 1))
}
func signedMin(bs int) int64 {
	var cutoff uint64 = cast(uint64, 1) << cast(uint64, bs - 1)
	return bit_cast(int64, cast(uint64, 0) - cutoff)
}

// underscoreOK validates '_' digit-separator placement in s (which carries
// no sign here, but may carry a 0b/0o/0x base prefix): each '_' must sit
// between two digits, or immediately after a base prefix, and s may not
// begin or end on '_'.  Mirrors Go's strconv.underscoreOK.  Called only
// after a clean digit scan, so the "other byte" branch is defensive.
func underscoreOK(s *[]readonly uint8) bool {
	// saw: 0 = start / just-reset, 1 = last byte was a digit or base prefix,
	// 2 = last byte was '_'.
	var saw int = 0
	var i int = 0
	if len(s) >= 2 && s[0] == '0' &&
		(s[1] == 'b' || s[1] == 'B' || s[1] == 'o' || s[1] == 'O' ||
			s[1] == 'x' || s[1] == 'X') {
		i = 2
		saw = 1
	}
	for i < len(s) {
		var c uint8 = s[i]
		if c == '_' {
			if saw != 1 {
				return false
			}
			saw = 2
			i = i + 1
			continue
		}
		if digitVal(c) >= 0 {
			saw = 1
			i = i + 1
			continue
		}
		if saw == 2 {
			return false
		}
		saw = 0
		i = i + 1
	}
	return saw != 2
}

// parseUintCore scans s as an unsigned integer.  With base 0 it infers the
// base from a 0b/0o/0x prefix (case-insensitive), treats a bare leading 0
// as octal (Go's legacy base-0 rule), and accepts '_' digit separators
// (only adjacent to digits / a base prefix).  With base 2..36 no prefix or
// underscore is recognized.  maxVal caps the magnitude: once the running
// value would exceed it (or overflow uint64), scanning stops and the value
// saturates to maxVal — mirroring Go, which reports ErrRange at that point
// without inspecting the rest of the input.
//
// Returns (value, kind): kind 0 on success, kindSyntax for empty/invalid
// input, kindRange when the magnitude exceeds maxVal.
func parseUintCore(s *[]readonly uint8, base int, maxVal uint64) (uint64, int) {
	if len(s) == 0 {
		return cast(uint64, 0), kindSyntax
	}
	var b int = base
	var start int = 0
	var base0 bool = false
	if base == 0 {
		base0 = true
		b = 10
		if s[0] == '0' {
			if len(s) >= 3 && (s[1] == 'b' || s[1] == 'B') {
				b = 2
				start = 2
			} else if len(s) >= 3 && (s[1] == 'o' || s[1] == 'O') {
				b = 8
				start = 2
			} else if len(s) >= 3 && (s[1] == 'x' || s[1] == 'X') {
				b = 16
				start = 2
			} else {
				// Legacy octal: a leading 0 selects base 8 and counts as a
				// digit (so "0" alone parses to 0).
				b = 8
				start = 1
			}
		}
	} else if base < 2 || base > 36 {
		return cast(uint64, 0), kindSyntax
	}
	var maxU uint64 = cast(uint64, 0) - cast(uint64, 1)
	var bb uint64 = cast(uint64, b)
	var cutoff uint64 = maxU / bb + cast(uint64, 1)
	var n uint64 = cast(uint64, 0)
	var sawUnderscore bool = false
	var i int = start
	for i < len(s) {
		var c uint8 = s[i]
		if base0 && c == '_' {
			// Defer placement validation: Go checks underscore placement
			// only after a successful scan, so an overflow (kindRange)
			// short-circuits before any placement error is reported.
			sawUnderscore = true
			i = i + 1
			continue
		}
		var d int = digitVal(c)
		if d < 0 || d >= b {
			return cast(uint64, 0), kindSyntax
		}
		if n >= cutoff {
			return maxVal, kindRange
		}
		n = n * bb
		var n1 uint64 = n + cast(uint64, d)
		if n1 < n || n1 > maxVal {
			return maxVal, kindRange
		}
		n = n1
		i = i + 1
	}
	if sawUnderscore && !underscoreOK(s) {
		return cast(uint64, 0), kindSyntax
	}
	return n, 0
}

// ParseUint interprets s in the given base (0, or 2..36) and returns its
// value as a uint64 constrained to bitSize bits (0/8/16/32/64; 0 = the
// platform int).  A sign is rejected (use ParseInt).  On out-of-range the
// value saturates to the bitSize maximum and the error is present.
func ParseUint(s *[]readonly uint8, base int, bitSize int) (uint64, @errors.Error) {
	var bs int = bitSize
	if bs == 0 {
		bs = platformIntBits()
	}
	var umax uint64 = unsignedMaxFor(bs)
	var un uint64
	var kind int
	un, kind = parseUintCore(s, base, umax)
	if kind == kindSyntax {
		return cast(uint64, 0), syntaxErr("ParseUint", s)
	}
	if kind == kindRange {
		return un, rangeErr("ParseUint", s)
	}
	var ok @errors.Error
	return un, ok
}

// parseSigned is the shared body of ParseInt / Atoi (fn names the caller
// for error messages).  It strips an optional sign, parses the magnitude
// with the unsigned bitSize cap, then applies the signed range gate —
// returning the saturated extreme (and a present error) when out of range.
func parseSigned(s *[]readonly uint8, base int, bitSize int, fn *[]readonly char) (int64, @errors.Error) {
	if len(s) == 0 {
		return cast(int64, 0), syntaxErr(fn, s)
	}
	var neg bool = false
	var start int = 0
	if s[0] == '+' {
		start = 1
	} else if s[0] == '-' {
		neg = true
		start = 1
	}
	var rest *[]readonly uint8 = s[start:len(s)]
	var bs int = bitSize
	if bs == 0 {
		bs = platformIntBits()
	}
	var umax uint64 = unsignedMaxFor(bs)
	var un uint64
	var kind int
	un, kind = parseUintCore(rest, base, umax)
	if kind == kindSyntax {
		return cast(int64, 0), syntaxErr(fn, s)
	}
	if kind == kindRange {
		if neg {
			return signedMin(bs), rangeErr(fn, s)
		}
		return signedMax(bs), rangeErr(fn, s)
	}
	// 2^(bs-1): positive values must be < it, a negative magnitude <= it.
	var cutoff uint64 = cast(uint64, 1) << cast(uint64, bs - 1)
	if !neg {
		if un >= cutoff {
			return signedMax(bs), rangeErr(fn, s)
		}
		var okp @errors.Error
		return bit_cast(int64, un), okp
	}
	if un > cutoff {
		return signedMin(bs), rangeErr(fn, s)
	}
	// Negate in uint64 (two's complement), then reinterpret — avoids the
	// INT_MIN overflow that -int64(un) would hit at un == 2^(bs-1).
	var okn @errors.Error
	return bit_cast(int64, cast(uint64, 0) - un), okn
}

// ParseInt interprets s in the given base (0, or 2..36) as a signed integer
// constrained to bitSize bits (0/8/16/32/64; 0 = the platform int).  Base 0
// infers 2/8/16 from a 0b/0o/0x prefix and treats a bare leading 0 as octal.
// On out-of-range the value saturates to the bitSize signed extreme.
func ParseInt(s *[]readonly uint8, base int, bitSize int) (int64, @errors.Error) {
	return parseSigned(s, base, bitSize, "ParseInt")
}

// Atoi is ParseInt(s, 10, 0) returning the platform int — the analogue of
// Go's strconv.Atoi (its error names "Atoi").
func Atoi(s *[]readonly uint8) (int, @errors.Error) {
	var v int64
	var err @errors.Error
	v, err = parseSigned(s, 10, 0, "Atoi")
	return cast(int, v), err
}
