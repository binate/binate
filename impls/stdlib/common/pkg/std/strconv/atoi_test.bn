package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/errors"

// ---- helpers --------------------------------------------------------

// msgEndsWith reports whether error message m ends with suffix.
func msgEndsWith(m @[]readonly char, suffix *[]readonly char) bool {
	if len(m) < len(suffix) {
		return false
	}
	var off int = len(m) - len(suffix)
	for i := 0; i < len(suffix); i++ {
		if m[off + i] != suffix[i] {
			return false
		}
	}
	return true
}

func isRangeErr(err @errors.Error) bool {
	if !present(err) {
		return false
	}
	var m @[]readonly char = err.Error()
	return msgEndsWith(m, "value out of range")
}

func isSyntaxErr(err @errors.Error) bool {
	if !present(err) {
		return false
	}
	var m @[]readonly char = err.Error()
	return msgEndsWith(m, "invalid syntax")
}

// uintOK: ParseUint(s,base,bits) succeeds with want.
func uintOK(s *[]readonly char, base int, bits int, want uint64) bool {
	var v uint64
	var err @errors.Error
	v, err = ParseUint(s, base, bits)
	if present(err) {
		return false
	}
	return v == want
}

// uintRange: ParseUint range-errors, saturating to want.
func uintRange(s *[]readonly char, base int, bits int, want uint64) bool {
	var v uint64
	var err @errors.Error
	v, err = ParseUint(s, base, bits)
	if !isRangeErr(err) {
		return false
	}
	return v == want
}

func uintSyntax(s *[]readonly char, base int, bits int) bool {
	var v uint64
	var err @errors.Error
	v, err = ParseUint(s, base, bits)
	if !isSyntaxErr(err) {
		return false
	}
	return v == cast(uint64, 0)
}

// intOK: ParseInt(s,base,bits) succeeds with want.
func intOK(s *[]readonly char, base int, bits int, want int64) bool {
	var v int64
	var err @errors.Error
	v, err = ParseInt(s, base, bits)
	if present(err) {
		return false
	}
	return v == want
}

func intRange(s *[]readonly char, base int, bits int, want int64) bool {
	var v int64
	var err @errors.Error
	v, err = ParseInt(s, base, bits)
	if !isRangeErr(err) {
		return false
	}
	return v == want
}

func intSyntax(s *[]readonly char, base int, bits int) bool {
	var v int64
	var err @errors.Error
	v, err = ParseInt(s, base, bits)
	if !isSyntaxErr(err) {
		return false
	}
	return v == cast(int64, 0)
}

// ---- ParseUint ------------------------------------------------------

func TestParseUintBasic() testing.TestResult {
	if !uintOK("0", 10, 64, cast(uint64, 0)) { return fail("ParseUint(0)") }
	if !uintOK("42", 10, 64, cast(uint64, 42)) { return fail("ParseUint(42)") }
	if !uintOK("255", 10, 64, cast(uint64, 255)) { return fail("ParseUint(255)") }
	if !uintOK("ff", 16, 64, cast(uint64, 255)) { return fail("ParseUint(ff,16)") }
	if !uintOK("777", 8, 64, cast(uint64, 511)) { return fail("ParseUint(777,8)") }
	if !uintOK("101", 2, 64, cast(uint64, 5)) { return fail("ParseUint(101,2)") }
	if !uintOK("z", 36, 64, cast(uint64, 35)) { return fail("ParseUint(z,36)") }
	return ""
}

func TestParseUintBase0() testing.TestResult {
	if !uintOK("0x10", 0, 64, cast(uint64, 16)) { return fail("0x10") }
	if !uintOK("0o17", 0, 64, cast(uint64, 15)) { return fail("0o17") }
	if !uintOK("0b101", 0, 64, cast(uint64, 5)) { return fail("0b101") }
	if !uintOK("010", 0, 64, cast(uint64, 8)) { return fail("010 (octal)") }
	if !uintOK("0", 0, 64, cast(uint64, 0)) { return fail("0 base0") }
	if !uintOK("00", 0, 64, cast(uint64, 0)) { return fail("00 base0") }
	if !uintOK("10", 0, 64, cast(uint64, 10)) { return fail("10 base0") }
	if !uintOK("0XAbC", 0, 64, cast(uint64, 2748)) { return fail("0XAbC") }
	if !uintOK("0O777", 0, 64, cast(uint64, 511)) { return fail("0O777") }
	if !uintSyntax("08", 0, 64) { return fail("08 must be syntax (bad octal)") }
	return ""
}

func TestParseUintUnderscore() testing.TestResult {
	if !uintOK("1_000", 0, 64, cast(uint64, 1000)) { return fail("1_000 base0") }
	if !uintOK("0x_ff", 0, 64, cast(uint64, 255)) { return fail("0x_ff base0") }
	if !uintSyntax("1_000", 10, 64) { return fail("1_000 base10 (no underscore)") }
	if !uintSyntax("_100", 0, 64) { return fail("_100 (leading underscore)") }
	if !uintSyntax("1__0", 0, 64) { return fail("1__0 (double underscore)") }
	if !uintSyntax("0_", 0, 64) { return fail("0_ (trailing underscore)") }
	return ""
}

func TestParseUintSignRejected() testing.TestResult {
	if !uintSyntax("-5", 10, 64) { return fail("ParseUint(-5) must be syntax") }
	if !uintSyntax("+5", 10, 64) { return fail("ParseUint(+5) must be syntax") }
	return ""
}

func TestParseUintRange() testing.TestResult {
	if !uintOK("255", 10, 8, cast(uint64, 255)) { return fail("255 bits8 ok") }
	if !uintRange("256", 10, 8, cast(uint64, 255)) { return fail("256 bits8 range") }
	if !uintRange("65536", 10, 16, cast(uint64, 65535)) { return fail("65536 bits16") }
	if !uintOK("18446744073709551615", 10, 64, unsignedMaxFor(64)) {
		return fail("uint64 max ok")
	}
	if !uintRange("18446744073709551616", 10, 64, unsignedMaxFor(64)) {
		return fail("uint64 max+1 range")
	}
	// Out-of-range short-circuits before a trailing non-digit (matches Go).
	if !uintRange("300x", 10, 8, cast(uint64, 255)) { return fail("300x bits8 range") }
	return ""
}

func TestParseUintEmpty() testing.TestResult {
	if !uintSyntax("", 10, 64) { return fail("empty must be syntax") }
	return ""
}

// ---- ParseInt -------------------------------------------------------

func TestParseIntBasic() testing.TestResult {
	if !intOK("0", 10, 64, cast(int64, 0)) { return fail("0") }
	if !intOK("42", 10, 64, cast(int64, 42)) { return fail("42") }
	if !intOK("-42", 10, 64, cast(int64, 0) - cast(int64, 42)) { return fail("-42") }
	if !intOK("+42", 10, 64, cast(int64, 42)) { return fail("+42") }
	if !intSyntax("", 10, 64) { return fail("empty") }
	if !intSyntax("+", 10, 64) { return fail("+ alone") }
	if !intSyntax("-", 10, 64) { return fail("- alone") }
	if !intSyntax("  5", 10, 64) { return fail("leading spaces") }
	return ""
}

func TestParseIntBase0() testing.TestResult {
	if !intOK("-0x10", 0, 64, cast(int64, 0) - cast(int64, 16)) { return fail("-0x10") }
	if !intOK("+0x10", 0, 64, cast(int64, 16)) { return fail("+0x10") }
	if !intOK("-010", 0, 64, cast(int64, 0) - cast(int64, 8)) { return fail("-010") }
	if !intOK("-0b11", 0, 64, cast(int64, 0) - cast(int64, 3)) { return fail("-0b11") }
	return ""
}

func TestParseIntDigitGeBase() testing.TestResult {
	if !intSyntax("8", 8, 64) { return fail("8 base8") }
	if !intSyntax("g", 16, 64) { return fail("g base16") }
	if !intOK("Z", 36, 64, cast(int64, 35)) { return fail("Z base36") }
	return ""
}

func TestParseIntRange8() testing.TestResult {
	if !intOK("127", 10, 8, cast(int64, 127)) { return fail("127 bits8 ok") }
	if !intRange("128", 10, 8, signedMax(8)) { return fail("128 bits8 -> 127 range") }
	if !intOK("-128", 10, 8, signedMin(8)) { return fail("-128 bits8 ok") }
	if !intRange("-129", 10, 8, signedMin(8)) { return fail("-129 bits8 -> -128 range") }
	return ""
}

func TestParseIntRange1632() testing.TestResult {
	// bitSize 16
	if !intOK("32767", 10, 16, cast(int64, 32767)) { return fail("32767 b16") }
	if !intRange("32768", 10, 16, signedMax(16)) { return fail("32768 b16 range") }
	if !intOK("-32768", 10, 16, signedMin(16)) { return fail("-32768 b16") }
	if !intRange("-32769", 10, 16, signedMin(16)) { return fail("-32769 b16 range") }
	if !uintOK("65535", 10, 16, cast(uint64, 65535)) { return fail("65535 u16") }
	if !uintRange("70000", 10, 16, unsignedMaxFor(16)) { return fail("70000 u16 range") }
	// bitSize 32
	if !intRange("2147483648", 10, 32, signedMax(32)) { return fail("2^31 b32 range") }
	if !intOK("-2147483648", 10, 32, signedMin(32)) { return fail("-2^31 b32") }
	if !uintOK("4294967295", 10, 32, unsignedMaxFor(32)) { return fail("u32 max") }
	if !uintRange("4294967296", 10, 32, unsignedMaxFor(32)) { return fail("u32 max+1") }
	return ""
}

func TestParseIntRange64() testing.TestResult {
	if !intOK("9223372036854775807", 10, 64, signedMax(64)) {
		return fail("int64 max ok")
	}
	if !intRange("9223372036854775808", 10, 64, signedMax(64)) {
		return fail("int64 max+1 -> range")
	}
	if !intOK("-9223372036854775808", 10, 64, signedMin(64)) {
		return fail("INT64_MIN ok")
	}
	if !intRange("-9223372036854775809", 10, 64, signedMin(64)) {
		return fail("INT64_MIN-1 -> range")
	}
	return ""
}

// ---- Atoi -----------------------------------------------------------

func TestAtoi() testing.TestResult {
	var v int
	var err @errors.Error
	v, err = Atoi("42")
	if present(err) || v != 42 { return fail("Atoi(42)") }
	v, err = Atoi("-7")
	if present(err) || v != (0 - 7) { return fail("Atoi(-7)") }
	v, err = Atoi("x")
	if !present(err) || v != 0 { return fail("Atoi(x) should error") }
	// Atoi's error names "Atoi", not "ParseInt".
	var m @[]readonly char = err.Error()
	if !streq(m[0:len(m)], "strconv.Atoi: parsing \"x\": invalid syntax") {
		return fail("Atoi error message")
	}
	return ""
}

func TestParseIntErrorFnName() testing.TestResult {
	var v int64
	var err @errors.Error
	v, err = ParseInt("x", 10, 64)
	if !present(err) { return fail("ParseInt(x) should error") }
	var m @[]readonly char = err.Error()
	if !streq(m[0:len(m)], "strconv.ParseInt: parsing \"x\": invalid syntax") {
		return fail("ParseInt error message")
	}
	return ""
}

func TestPlatformIntBits() testing.TestResult {
	var b int = platformIntBits()
	if b != 32 && b != 64 { return fail("platformIntBits must be 32 or 64") }
	return ""
}
