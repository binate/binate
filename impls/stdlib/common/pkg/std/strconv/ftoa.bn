// Float-to-decimal support for AppendFloat/FormatFloat — a Dragon4 /
// Burger-Dybvig dtoa over pkg/std/math/big.Nat.
package "pkg/std/strconv"

import "pkg/std/math/big"

// floatParts is the decomposition of a float.  For a finite nonzero value,
// |value| = mant * 2^exp with mant an exact integer.  sign is set for
// negative values (including -0.0).  kind distinguishes the categories.
type floatParts struct {
	mant uint64
	exp  int
	sign bool
	kind int
}

// kind values for floatParts.
const (
	fpFinite int = 0
	fpZero int = 1
	fpInf int = 2
	fpNaN int = 3
)

// decompose64 splits an IEEE-754 binary64 value (1 sign / 11 exponent / 52
// fraction bits).  The 64-bit-wide bit_cast partner is required: a plain int
// is 32 bits on ILP32 targets, so bit_cast(int, f) would size-mismatch.
func decompose64(f float64) floatParts {
	var p floatParts
	var bits uint64 = bit_cast(uint64, f)
	p.sign = (bits >> 63) != cast(uint64, 0)
	var be int = cast(int, (bits >> 52) & cast(uint64, 0x7FF))
	var frac uint64 = bits & cast(uint64, 0xFFFFFFFFFFFFF)
	if be == 2047 {
		if frac == cast(uint64, 0) {
			p.kind = fpInf
		} else {
			p.kind = fpNaN
		}
		return p
	}
	if be == 0 {
		if frac == cast(uint64, 0) {
			p.kind = fpZero
			return p
		}
		// Subnormal: no implicit leading bit; value = frac * 2^(1-1023-52).
		p.kind = fpFinite
		p.mant = frac
		p.exp = -1074
		return p
	}
	// Normal: restore the implicit leading 1; value = mant * 2^(be-1023-52).
	p.kind = fpFinite
	p.mant = frac | (cast(uint64, 1) << 52)
	p.exp = be - 1075
	return p
}

// decompose32 splits an IEEE-754 binary32 value (1 sign / 8 exponent / 23
// fraction bits), widening the significand to uint64 for the shared dtoa.
func decompose32(f float32) floatParts {
	var p floatParts
	var bits uint32 = bit_cast(uint32, f)
	p.sign = (bits >> 31) != cast(uint32, 0)
	var be int = cast(int, (bits >> 23) & cast(uint32, 0xFF))
	var frac uint32 = bits & cast(uint32, 0x7FFFFF)
	if be == 255 {
		if frac == cast(uint32, 0) {
			p.kind = fpInf
		} else {
			p.kind = fpNaN
		}
		return p
	}
	if be == 0 {
		if frac == cast(uint32, 0) {
			p.kind = fpZero
			return p
		}
		// Subnormal: value = frac * 2^(1-127-23).
		p.kind = fpFinite
		p.mant = cast(uint64, frac)
		p.exp = -149
		return p
	}
	p.kind = fpFinite
	p.mant = cast(uint64, frac | (cast(uint32, 1) << 23))
	p.exp = be - 150
	return p
}

// pow10Mul multiplies z by 10^n in place (n >= 0).
func pow10Mul(z @big.Nat, n int) {
	var i int = 0
	for i < n {
		z.MulUint32(z, cast(uint32, 10))
		i = i + 1
	}
}

// shortestDigits produces the shortest decimal digit string that round-trips
// to the finite value |value| = mant * 2^exp (Burger-Dybvig FPP2 over Nat).
// mantBits is 52 (binary64) / 23 (binary32) and minExp is the minimum
// (subnormal) exponent, -1074 / -149.  Returns the significant digit chars
// and dp, the count of digits before the decimal point: the value equals the
// digit integer D scaled by 10^(dp - len(digits)).  mant must be nonzero.
func shortestDigits(mant uint64, exp int, mantBits uint, minExp int) (@[]char, int) {
	var mantLow uint64 = cast(uint64, 1) << cast(uint64, mantBits)
	// Half the lower gap applies at a power of two (mant == mantLow), except
	// at the smallest normal (exp == minExp), where the predecessor is the
	// largest subnormal at the same spacing.
	var useHalf bool = (mant == mantLow) && (exp != minExp)
	var evenMant bool = (mant & cast(uint64, 1)) == cast(uint64, 0)

	// value = R/S; rounding interval is (value - Mm/S, value + Mp/S).
	var R @big.Nat = big.New()
	var S @big.Nat = big.New()
	var Mp @big.Nat = big.New()
	var Mm @big.Nat = big.New()
	R.SetUint64(mant)
	if exp >= 0 {
		var be @big.Nat = big.FromUint64(cast(uint64, 1))
		be.Shl(be, cast(uint, exp))
		R.Mul(R, be)
		if useHalf {
			R.MulUint32(R, cast(uint32, 4))
			S.SetUint64(cast(uint64, 4))
			Mp.Set(be)
			Mp.MulUint32(Mp, cast(uint32, 2))
			Mm.Set(be)
		} else {
			R.MulUint32(R, cast(uint32, 2))
			S.SetUint64(cast(uint64, 2))
			Mp.Set(be)
			Mm.Set(be)
		}
	} else {
		var pw @big.Nat = big.FromUint64(cast(uint64, 1))
		pw.Shl(pw, cast(uint, 0 - exp))
		if useHalf {
			R.MulUint32(R, cast(uint32, 4))
			S.Set(pw)
			S.MulUint32(S, cast(uint32, 4))
			Mp.SetUint64(cast(uint64, 2))
			Mm.SetUint64(cast(uint64, 1))
		} else {
			R.MulUint32(R, cast(uint32, 2))
			S.Set(pw)
			S.MulUint32(S, cast(uint32, 2))
			Mp.SetUint64(cast(uint64, 1))
			Mm.SetUint64(cast(uint64, 1))
		}
	}

	// Scale by 10^dp so the value lands in [0.1, 1): the first generated
	// digit is then nonzero.  1233/4096 approximates log10(2); the division
	// truncates toward zero, so the estimate is neither a clean floor nor
	// ceil — BOTH fixup loops below are therefore required and must not be
	// dropped (each runs at most a couple of times).
	var dp int = ((R.BitLen() - S.BitLen()) * 1233) / 4096
	if dp > 0 {
		pow10Mul(S, dp)
	} else if dp < 0 {
		pow10Mul(R, 0 - dp)
		pow10Mul(Mp, 0 - dp)
		pow10Mul(Mm, 0 - dp)
	}
	var sum @big.Nat = big.New()
	// Too small while (R + Mp) * 10 <= S (the first digit would be 0).
	sum.Add(R, Mp)
	sum.MulUint32(sum, cast(uint32, 10))
	for boundedBelow(sum, S, evenMant) {
		dp = dp - 1
		R.MulUint32(R, cast(uint32, 10))
		Mp.MulUint32(Mp, cast(uint32, 10))
		Mm.MulUint32(Mm, cast(uint32, 10))
		sum.Add(R, Mp)
		sum.MulUint32(sum, cast(uint32, 10))
	}
	// Too big while R + Mp >= S (the value with margin reaches 1.0).
	sum.Add(R, Mp)
	for boundedAbove(sum, S, evenMant) {
		dp = dp + 1
		S.MulUint32(S, cast(uint32, 10))
		sum.Add(R, Mp)
	}

	var digits @[]char = make_slice(char, 32)
	var n int = 0
	var tmp @big.Nat = big.New()
	for {
		R.MulUint32(R, cast(uint32, 10))
		Mp.MulUint32(Mp, cast(uint32, 10))
		Mm.MulUint32(Mm, cast(uint32, 10))
		var d int = 0
		for R.Cmp(S) >= 0 {
			R.Sub(R, S)
			d = d + 1
		}
		var low bool = boundedBelow(R, Mm, evenMant)
		tmp.Add(R, Mp)
		var high bool = boundedAbove(tmp, S, evenMant)
		if !low && !high {
			digits[n] = digitChar(d)
			n = n + 1
			continue
		}
		var roundUp bool = false
		if high && !low {
			roundUp = true
		} else if low && high {
			// In the rounding interval from both sides: nearest, ties to even.
			tmp.Shl(R, cast(uint, 1))
			var c int = tmp.Cmp(S)
			if c > 0 {
				roundUp = true
			} else if c == 0 {
				roundUp = (d % 2) != 0
			}
		}
		digits[n] = digitChar(d)
		n = n + 1
		if roundUp {
			var ci int = n - 1
			for ci >= 0 {
				if digits[ci] == '9' {
					digits[ci] = '0'
					ci = ci - 1
				} else {
					digits[ci] = cast(char, cast(int, digits[ci]) + 1)
					ci = -2
				}
			}
			if ci == -1 {
				// Carried out the front (e.g. 999 -> 1000): the shortest form
				// is "1" one place higher.  This is a defensive guard: the
				// [0.1, 1) scaling fixes the leading digit, so a minimal
				// shortest string never rounds up past it — but handle it so
				// a future change to the scaling can't silently corrupt.
				digits[0] = '1'
				n = 1
				dp = dp + 1
			}
		}
		break
	}

	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = digits[i]
	}
	return out, dp
}

// boundedAbove reports whether a >= b (even mantissa: closed boundary) or
// a > b (odd: open) — the round-to-even high test.
func boundedAbove(a @big.Nat, b @big.Nat, even bool) bool {
	var c int = a.Cmp(b)
	if even {
		return c >= 0
	}
	return c > 0
}

// boundedBelow reports whether a <= b (even mantissa: closed) or a < b (odd:
// open) — the round-to-even low test (digit loop) and the scale's
// "first digit would be zero" test.
func boundedBelow(a @big.Nat, b @big.Nat, even bool) bool {
	var c int = a.Cmp(b)
	if even {
		return c <= 0
	}
	return c < 0
}
