// Float-to-decimal support for AppendFloat/FormatFloat — a Dragon4 /
// Burger-Dybvig dtoa over pkg/math/big.Nat.  This commit adds the IEEE-754
// decomposition; the R/S/M setup, digit loop, and public AppendFloat follow.
package "pkg/std/strconv"

// floatParts is the decomposition of a float.  For a finite nonzero value,
// |value| = mant * 2^exp with mant an exact integer.  sign is set for
// negative values (including -0.0).  kind distinguishes the categories.
type floatParts struct {
	mant uint64
	exp  int
	sign bool
	kind int
}

// kind values for floatParts.
const fpFinite int = 0
const fpZero int = 1
const fpInf int = 2
const fpNaN int = 3

// decompose64 splits an IEEE-754 binary64 value (1 sign / 11 exponent / 52
// fraction bits).  The 64-bit-wide bit_cast partner is required: a plain int
// is 32 bits on ILP32 targets, so bit_cast(int, f) would size-mismatch.
func decompose64(f float64) floatParts {
	var p floatParts
	var bits uint64 = bit_cast(uint64, f)
	p.sign = (bits >> 63) != cast(uint64, 0)
	var be int = cast(int, (bits >> 52) & cast(uint64, 0x7FF))
	var frac uint64 = bits & cast(uint64, 0xFFFFFFFFFFFFF)
	if be == 2047 {
		if frac == cast(uint64, 0) {
			p.kind = fpInf
		} else {
			p.kind = fpNaN
		}
		return p
	}
	if be == 0 {
		if frac == cast(uint64, 0) {
			p.kind = fpZero
			return p
		}
		// Subnormal: no implicit leading bit; value = frac * 2^(1-1023-52).
		p.kind = fpFinite
		p.mant = frac
		p.exp = -1074
		return p
	}
	// Normal: restore the implicit leading 1; value = mant * 2^(be-1023-52).
	p.kind = fpFinite
	p.mant = frac | (cast(uint64, 1) << 52)
	p.exp = be - 1075
	return p
}

// decompose32 splits an IEEE-754 binary32 value (1 sign / 8 exponent / 23
// fraction bits), widening the significand to uint64 for the shared dtoa.
func decompose32(f float32) floatParts {
	var p floatParts
	var bits uint32 = bit_cast(uint32, f)
	p.sign = (bits >> 31) != cast(uint32, 0)
	var be int = cast(int, (bits >> 23) & cast(uint32, 0xFF))
	var frac uint32 = bits & cast(uint32, 0x7FFFFF)
	if be == 255 {
		if frac == cast(uint32, 0) {
			p.kind = fpInf
		} else {
			p.kind = fpNaN
		}
		return p
	}
	if be == 0 {
		if frac == cast(uint32, 0) {
			p.kind = fpZero
			return p
		}
		// Subnormal: value = frac * 2^(1-127-23).
		p.kind = fpFinite
		p.mant = cast(uint64, frac)
		p.exp = -149
		return p
	}
	p.kind = fpFinite
	p.mant = cast(uint64, frac | (cast(uint32, 1) << 23))
	p.exp = be - 150
	return p
}
