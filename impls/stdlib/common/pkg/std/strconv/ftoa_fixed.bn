// Fixed-precision (prec >= 0) float formatting: Dragon4 digit generation that
// emits exactly the requested number of decimal digits, rounded half-to-even,
// then renders per fmt.  The shortest (prec < 0) path lives in ftoa.bn /
// ftoa_format.bn; the shared layout helpers (renderDigits / appendExp /
// copyOut) are in ftoa_format.bn.
package "pkg/std/strconv"

import "pkg/math/big"

// scaledVal carries the exact value scaled into [0.1, 1): R/S is the value's
// fraction and dp is its decimal exponent, so |value| == (R/S) * 10^dp and the
// leading nonzero decimal digit sits in the 10^(dp-1) place.
type scaledVal struct {
	r  @big.Nat
	s  @big.Nat
	dp int
}

// fixedScale builds the exact R/S = |value| = mant * 2^exp and scales it into
// [0.1, 1), returning R, S and the decimal exponent dp.  mant must be nonzero.
func fixedScale(mant uint64, exp int) scaledVal {
	var R @big.Nat = big.New()
	var S @big.Nat = big.New()
	R.SetUint64(mant)
	S.SetUint64(cast(uint64, 1))
	if exp >= 0 {
		R.Shl(R, cast(uint, exp))
	} else {
		S.Shl(S, cast(uint, 0 - exp))
	}
	// 1233/4096 approximates log10(2); the truncating division is neither a
	// clean floor nor ceil, so the fixup loops below are both required.
	var dp int = ((R.BitLen() - S.BitLen()) * 1233) / 4096
	if dp > 0 {
		pow10Mul(S, dp)
	} else if dp < 0 {
		pow10Mul(R, 0 - dp)
	}
	// Pull R/S into [0.1, 1): shrink it while R/S >= 1 (grow S), then grow it
	// while R/S < 0.1 (grow R).  At most one loop runs, a step or two each.
	for R.Cmp(S) >= 0 {
		dp = dp + 1
		S.MulUint32(S, cast(uint32, 10))
	}
	var tenR @big.Nat = big.New()
	for {
		tenR.Set(R)
		tenR.MulUint32(tenR, cast(uint32, 10))
		if tenR.Cmp(S) >= 0 {
			break
		}
		dp = dp - 1
		R.MulUint32(R, cast(uint32, 10))
	}
	var out scaledVal
	out.r = R
	out.s = S
	out.dp = dp
	return out
}

// genFixed generates exactly n (>= 0) significant decimal digits of the value
// scaled in st, rounding the discarded tail half-to-even and propagating any
// carry.  Returns the digit chars and the (possibly carry-incremented) dp.
func genFixed(st scaledVal, n int) (@[]char, int) {
	var R @big.Nat = st.r
	var S @big.Nat = st.s
	var dp int = st.dp
	var digits @[]char = make_slice(char, n + 1)
	var lastDigit int = 0
	for i := 0; i < n; i++ {
		R.MulUint32(R, cast(uint32, 10))
		var d int = 0
		for R.Cmp(S) >= 0 {
			R.Sub(R, S)
			d = d + 1
		}
		digits[i] = digitChar(d)
		lastDigit = d
	}
	// Round the discarded tail: 2R vs S, ties to even on the last kept digit.
	var roundUp bool = false
	var twoR @big.Nat = big.New()
	twoR.Shl(R, cast(uint, 1))
	var c int = twoR.Cmp(S)
	if c > 0 {
		roundUp = true
	} else if c == 0 {
		roundUp = (lastDigit % 2) != 0
	}
	var rn int = n
	if roundUp {
		var ci int = n - 1
		var carried bool = true
		for ci >= 0 {
			if digits[ci] == '9' {
				digits[ci] = '0'
				ci = ci - 1
			} else {
				digits[ci] = cast(char, cast(int, digits[ci]) + 1)
				carried = false
				break
			}
		}
		if carried {
			// 999.. -> 1000.. (or an empty count rounding up to 1): one place
			// higher, the kept digits become "1" then zeros.  The trailing
			// digits are already '0' from the loop above; n == 0 gains a digit.
			digits[0] = '1'
			if n == 0 {
				rn = 1
			}
			dp = dp + 1
		}
	}
	return copyOut(digits, rn), dp
}

// renderFixedF renders digits in plain form with exactly prec fraction digits
// (no exponent), returning a fresh caller-owned @[]char.
func renderFixedF(digits *[]readonly char, dp int, sign bool, prec int) @[]char {
	var nd int = len(digits)
	var intLen int = dp
	if intLen < 1 {
		intLen = 1
	}
	var size int = intLen + 1 + prec
	if sign {
		size = size + 1
	}
	var scratch @[]char = make_slice(char, size)
	var n int = 0
	if sign {
		scratch[n] = '-'
		n = n + 1
	}
	if dp <= 0 {
		scratch[n] = '0'
		n = n + 1
	} else {
		for i := 0; i < dp; i++ {
			if i < nd {
				scratch[n] = digits[i]
			} else {
				scratch[n] = '0'
			}
			n = n + 1
		}
	}
	if prec > 0 {
		scratch[n] = '.'
		n = n + 1
		for i := 0; i < prec; i++ {
			var pos int = dp + i
			if pos >= 0 && pos < nd {
				scratch[n] = digits[pos]
			} else {
				scratch[n] = '0'
			}
			n = n + 1
		}
	}
	return copyOut(scratch, n)
}

// renderFixedE renders digits in scientific form with a normalized leading
// digit and exactly prec fraction digits, returning a fresh @[]char.
func renderFixedE(digits *[]readonly char, dp int, sign bool, prec int, upper bool) @[]char {
	var nd int = len(digits)
	// sign + leading digit + '.' + prec fraction + exponent (e±dddd, <= 6).
	var size int = 2 + prec + 6
	if sign {
		size = size + 1
	}
	var scratch @[]char = make_slice(char, size)
	var n int = 0
	if sign {
		scratch[n] = '-'
		n = n + 1
	}
	if nd > 0 {
		scratch[n] = digits[0]
	} else {
		scratch[n] = '0'
	}
	n = n + 1
	if prec > 0 {
		scratch[n] = '.'
		n = n + 1
		for i := 0; i < prec; i++ {
			var pos int = 1 + i
			if pos < nd {
				scratch[n] = digits[pos]
			} else {
				scratch[n] = '0'
			}
			n = n + 1
		}
	}
	var eChar char = 'e'
	if upper {
		eChar = 'E'
	}
	n = appendExp(scratch, n, eChar, dp - 1)
	return copyOut(scratch, n)
}

// formatFixed renders parts (already decomposed) with exactly prec digits of
// fixed precision per fmt, returning a fresh caller-owned @[]char.
func formatFixed(parts floatParts, fmt char, prec int) @[]char {
	if parts.kind == fpNaN {
		return managedStr("NaN")
	}
	if parts.kind == fpInf {
		if parts.sign {
			return managedStr("-Inf")
		}
		return managedStr("+Inf")
	}
	var upper bool = (fmt == 'E') || (fmt == 'G')
	var isE bool = (fmt == 'e') || (fmt == 'E')
	var isF bool = fmt == 'f'

	var digits @[]char = make_slice(char, 0)
	var dp int = 0
	if parts.kind == fpZero {
		// A zero significand: a single "0" digit at exponent 0 (dp == 1) so
		// both the 'e' exponent (dp-1 == 0) and the 'f'/'g' integer part work.
		digits = managedStr("0")
		dp = 1
	} else {
		var sv scaledVal = fixedScale(parts.mant, parts.exp)
		var nsig int = 0
		if isE {
			nsig = prec + 1
		} else if isF {
			nsig = sv.dp + prec
		} else {
			// 'g'/'G': prec significant digits (0 means 1).
			if prec == 0 {
				nsig = 1
			} else {
				nsig = prec
			}
		}
		if nsig < 0 {
			// 'f' whose digit count falls below the value's leading digit: the
			// value is < 0.5 * 10^(-prec), so it rounds to zero.  Leave digits
			// empty and dp 0 so renderFixedF emits "0" + the fractional pad.
			dp = 0
		} else {
			digits, dp = genFixed(sv, nsig)
		}
	}
	var nd int = len(digits)

	if isE {
		return renderFixedE(digits[0:nd], dp, parts.sign, prec, upper)
	}
	if isF {
		return renderFixedF(digits[0:nd], dp, parts.sign, prec)
	}
	// 'g'/'G': strip trailing zeros (keep at least one), then choose scientific
	// vs plain by the eprec threshold and render like shortest 'g'.
	var sig int = prec
	if prec == 0 {
		sig = 1
	}
	var nz int = nd
	for nz > 1 && digits[nz - 1] == '0' {
		nz = nz - 1
	}
	var eprec int = sig
	if eprec > nz && nz >= dp {
		eprec = nz
	}
	var dexp int = dp - 1
	var sci bool = (dexp < (cast(int, 0) - 4)) || (dexp >= eprec)
	return renderDigits(digits[0:nz], dp, parts.sign, sci, upper)
}
