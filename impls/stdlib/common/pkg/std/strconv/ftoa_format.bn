// Public float formatting: AppendFloat / FormatFloat.  This cut implements
// shortest round-trip (prec == -1); fixed precision (prec >= 0) is a planned
// follow-up and currently panics.
package "pkg/std/strconv"

// managedStr copies a literal into a fresh caller-owned @[]char.
func managedStr(s *[]readonly char) @[]char {
	var n int = len(s)
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = s[i]
	}
	return out
}

// appendExp writes the decimal exponent (value e+NN), at least two digits,
// into dst starting at pos and returns the next position.  e may be negative.
func appendExp(dst @[]char, pos int, eChar char, e int) int {
	var n int = pos
	dst[n] = eChar
	n = n + 1
	var mag int = e
	if e < 0 {
		dst[n] = '-'
		mag = 0 - e
	} else {
		dst[n] = '+'
	}
	n = n + 1
	if mag >= 100 {
		dst[n] = digitChar(mag / 100)
		dst[n + 1] = digitChar((mag / 10) % 10)
		dst[n + 2] = digitChar(mag % 10)
		return n + 3
	}
	// At least two digits (mag / 10 is 0 -> a leading '0' pad).
	dst[n] = digitChar(mag / 10)
	dst[n + 1] = digitChar(mag % 10)
	return n + 2
}

// formatShortest renders parts (already decomposed) in the shortest
// round-trip form for fmt, returning a fresh caller-owned @[]char.  bitSize
// selects the binary32/binary64 ulp for the digit generation.
func formatShortest(parts floatParts, fmt char, bitSize int) @[]char {
	if parts.kind == fpNaN {
		return managedStr("NaN")
	}
	if parts.kind == fpInf {
		if parts.sign {
			return managedStr("-Inf")
		}
		return managedStr("+Inf")
	}

	var digits @[]char = make_slice(char, 0)
	var dp int = 0
	if parts.kind == fpZero {
		digits = managedStr("0")
		dp = 1
	} else {
		var mantBits uint = cast(uint, 52)
		var minExp int = cast(int, 0) - 1074
		if bitSize == 32 {
			mantBits = cast(uint, 23)
			minExp = cast(int, 0) - 149
		}
		digits, dp = shortestDigits(parts.mant, parts.exp, mantBits, minExp)
	}

	var nd int = len(digits)
	// Decide scientific vs plain.  'g'/'G' pick scientific when the decimal
	// exponent (dp-1) is < -4 or >= 21; an unrecognized fmt defaults to 'g'.
	var sci bool = false
	var upper bool = (fmt == 'E') || (fmt == 'G')
	if fmt == 'e' || fmt == 'E' {
		sci = true
	} else if fmt == 'f' {
		sci = false
	} else {
		var dexp int = dp - 1
		sci = (dexp < (cast(int, 0) - 4)) || (dexp >= 21)
	}

	// Scratch large enough for the worst case: digits + leading/trailing
	// zeros (|dp|) + sign + point + exponent.
	var absDp int = dp
	if absDp < 0 {
		absDp = 0 - absDp
	}
	var scratch @[]char = make_slice(char, nd + absDp + 8)
	var n int = 0
	if parts.sign {
		scratch[n] = '-'
		n = n + 1
	}

	if sci {
		scratch[n] = digits[0]
		n = n + 1
		if nd > 1 {
			scratch[n] = '.'
			n = n + 1
			for i := 1; i < nd; i++ {
				scratch[n] = digits[i]
				n = n + 1
			}
		}
		var eChar char = 'e'
		if upper {
			eChar = 'E'
		}
		n = appendExp(scratch, n, eChar, dp - 1)
	} else if dp <= 0 {
		// 0.000ddd
		scratch[n] = '0'
		scratch[n + 1] = '.'
		n = n + 2
		for i := 0; i < (0 - dp); i++ {
			scratch[n] = '0'
			n = n + 1
		}
		for i := 0; i < nd; i++ {
			scratch[n] = digits[i]
			n = n + 1
		}
	} else if dp >= nd {
		// ddd000 (no fraction)
		for i := 0; i < nd; i++ {
			scratch[n] = digits[i]
			n = n + 1
		}
		for i := 0; i < (dp - nd); i++ {
			scratch[n] = '0'
			n = n + 1
		}
	} else {
		// dd.ddd
		for i := 0; i < dp; i++ {
			scratch[n] = digits[i]
			n = n + 1
		}
		scratch[n] = '.'
		n = n + 1
		for i := dp; i < nd; i++ {
			scratch[n] = digits[i]
			n = n + 1
		}
	}

	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = scratch[i]
	}
	return out
}

// decomposeBySize decomposes f as a binary64 or binary32 value.
func decomposeBySize(f float64, bitSize int) floatParts {
	if bitSize == 32 {
		return decompose32(cast(float32, f))
	}
	return decompose64(f)
}

func FormatFloat(f float64, fmt char, prec int, bitSize int) @[]char {
	if prec != (cast(int, 0) - 1) {
		panic("strconv: FormatFloat: fixed precision (prec >= 0) not yet implemented")
	}
	return formatShortest(decomposeBySize(f, bitSize), fmt, bitSize)
}

func AppendFloat(dst *[]char, pos int, f float64, fmt char, prec int, bitSize int) int {
	var s @[]char = FormatFloat(f, fmt, prec, bitSize)
	var n int = len(s)
	if pos < 0 {
		return 0 - n
	}
	if pos + n > len(dst) {
		return 0 - n
	}
	for i := 0; i < n; i++ {
		dst[pos + i] = s[i]
	}
	return pos + n
}
