package "pkg/std/strconv"

import "pkg/builtins/testing"

// streq/fail and f64bits are shared from the other strconv test files
// (same package).  shortPrec is -1 (the shortest-round-trip selector).

func shortPrec() int {
	return cast(int, 0) - 1
}

// ============================================================
// FormatFloat — shortest 'g'
// ============================================================

func TestFormatFloatG() testing.TestResult {
	if !streq(FormatFloat(1.0, 'g', shortPrec(), 64), "1") { return fail("g 1.0") }
	if !streq(FormatFloat(0.5, 'g', shortPrec(), 64), "0.5") { return fail("g 0.5") }
	if !streq(FormatFloat(100.0, 'g', shortPrec(), 64), "100") { return fail("g 100") }
	if !streq(FormatFloat(0.1, 'g', shortPrec(), 64), "0.1") { return fail("g 0.1") }
	if !streq(FormatFloat(3.141592653589793, 'g', shortPrec(), 64), "3.141592653589793") { return fail("g pi") }
	if !streq(FormatFloat(cast(float64, 0) - 2.5, 'g', shortPrec(), 64), "-2.5") { return fail("g -2.5") }
	if !streq(FormatFloat(0.0, 'g', shortPrec(), 64), "0") { return fail("g 0.0") }
	// Scientific selection: exponent >= 21 uses 'e'.
	if !streq(FormatFloat(1e21, 'g', shortPrec(), 64), "1e+21") { return fail("g 1e21") }
	// Exponent < -4 uses 'e'.
	if !streq(FormatFloat(1e-5, 'g', shortPrec(), 64), "1e-05") { return fail("g 1e-5") }
	return ""
}

// An unrecognized fmt is treated as 'g'.
func TestFormatFloatUnknownFmt() testing.TestResult {
	if !streq(FormatFloat(1.5, 'z', shortPrec(), 64), "1.5") { return fail("unknown fmt -> g") }
	return ""
}

// ============================================================
// FormatFloat — special values
// ============================================================

func TestFormatFloatSpecial() testing.TestResult {
	if !streq(FormatFloat(f64bits(cast(uint64, 0x7FF8000000000000)), 'g', shortPrec(), 64), "NaN") { return fail("NaN") }
	if !streq(FormatFloat(f64bits(cast(uint64, 0x7FF0000000000000)), 'g', shortPrec(), 64), "+Inf") { return fail("+Inf") }
	if !streq(FormatFloat(f64bits(cast(uint64, 0xFFF0000000000000)), 'g', shortPrec(), 64), "-Inf") { return fail("-Inf") }
	if !streq(FormatFloat(f64bits(cast(uint64, 1) << 63), 'g', shortPrec(), 64), "-0") { return fail("-0.0") }
	if !streq(FormatFloat(0.0, 'e', shortPrec(), 64), "0e+00") { return fail("0.0 'e'") }
	return ""
}

// ============================================================
// FormatFloat — 'e' / 'f' / uppercase
// ============================================================

func TestFormatFloatE() testing.TestResult {
	if !streq(FormatFloat(1.0, 'e', shortPrec(), 64), "1e+00") { return fail("e 1.0") }
	if !streq(FormatFloat(100.0, 'e', shortPrec(), 64), "1e+02") { return fail("e 100") }
	if !streq(FormatFloat(0.5, 'e', shortPrec(), 64), "5e-01") { return fail("e 0.5") }
	if !streq(FormatFloat(3.141592653589793, 'e', shortPrec(), 64), "3.141592653589793e+00") { return fail("e pi") }
	return ""
}

func TestFormatFloatF() testing.TestResult {
	if !streq(FormatFloat(1.0, 'f', shortPrec(), 64), "1") { return fail("f 1.0") }
	if !streq(FormatFloat(0.1, 'f', shortPrec(), 64), "0.1") { return fail("f 0.1") }
	if !streq(FormatFloat(100.0, 'f', shortPrec(), 64), "100") { return fail("f 100") }
	if !streq(FormatFloat(1234.5, 'f', shortPrec(), 64), "1234.5") { return fail("f 1234.5") }
	return ""
}

func TestFormatFloatUpper() testing.TestResult {
	if !streq(FormatFloat(1.0, 'E', shortPrec(), 64), "1E+00") { return fail("E 1.0") }
	if !streq(FormatFloat(1e-5, 'G', shortPrec(), 64), "1E-05") { return fail("G 1e-5") }
	return ""
}

// ============================================================
// FormatFloat — float32
// ============================================================

func TestFormatFloat32() testing.TestResult {
	if !streq(FormatFloat(1.0, 'g', shortPrec(), 32), "1") { return fail("f32 1.0") }
	if !streq(FormatFloat(0.1, 'g', shortPrec(), 32), "0.1") { return fail("f32 0.1") }
	if !streq(FormatFloat(0.5, 'e', shortPrec(), 32), "5e-01") { return fail("f32 e 0.5") }
	// Special values via bitSize=32 (Inf and signed zero route through decompose32).
	if !streq(FormatFloat(f64bits(cast(uint64, 0x7FF0000000000000)), 'g', shortPrec(), 32), "+Inf") { return fail("f32 +Inf") }
	if !streq(FormatFloat(f64bits(cast(uint64, 0xFFF0000000000000)), 'g', shortPrec(), 32), "-Inf") { return fail("f32 -Inf") }
	if !streq(FormatFloat(f64bits(cast(uint64, 1) << 63), 'g', shortPrec(), 32), "-0") { return fail("f32 -0") }
	return ""
}

// The g/G scientific threshold is exactly dexp >= 6 (matching Go): 1e5 stays
// plain, 1e6 switches to scientific.
func TestFormatFloatGThreshold() testing.TestResult {
	if !streq(FormatFloat(1e5, 'g', shortPrec(), 64), "100000") { return fail("g 1e5 plain") }
	if !streq(FormatFloat(123456.0, 'g', shortPrec(), 64), "123456") { return fail("g 123456 plain") }
	if !streq(FormatFloat(1e6, 'g', shortPrec(), 64), "1e+06") { return fail("g 1e6 sci") }
	if !streq(FormatFloat(1234567.0, 'g', shortPrec(), 64), "1.234567e+06") { return fail("g 1234567 sci") }
	if !streq(FormatFloat(1e15, 'g', shortPrec(), 64), "1e+15") { return fail("g 1e15 sci") }
	if !streq(FormatFloat(1e20, 'g', shortPrec(), 64), "1e+20") { return fail("g 1e20 sci") }
	return ""
}

// Three-digit exponents (appendExp's mag >= 100 branch) + the f64 extremes
// in scientific form.  1e100 / 1e-100 are built from their exact bit
// patterns rather than the float literals 1e100 / 1e-100: those literals
// currently mis-convert on the VM (a compiler float-literal bug for large
// exponents, tracked in claude-todo), which is unrelated to strconv.
func TestFormatFloatBigExp() testing.TestResult {
	if !streq(FormatFloat(f64bits(cast(uint64, 6103021453049119613)), 'e', shortPrec(), 64), "1e+100") {
		return fail("e 1e100")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 3110860544497550640)), 'e', shortPrec(), 64), "1e-100") {
		return fail("e 1e-100")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 0x7FEFFFFFFFFFFFFF)), 'e', shortPrec(), 64), "1.7976931348623157e+308") {
		return fail("e MaxFloat64")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 1)), 'e', shortPrec(), 64), "5e-324") { return fail("e min subnormal") }
	return ""
}

// checkZeroRun verifies s == prefix + (zeros) '0' + suffix without spelling
// out a 300+-char literal (the large-|dp| 'f' worst cases).
func checkZeroRun(s @[]char, prefix *[]readonly char, zeros int, suffix *[]readonly char) bool {
	var pl int = len(prefix)
	var sl int = len(suffix)
	if len(s) != pl + zeros + sl { return false }
	if !streq(s[0:pl], prefix) { return false }
	for i := 0; i < zeros; i++ {
		if s[pl + i] != '0' { return false }
	}
	if sl > 0 {
		if !streq(s[pl + zeros : pl + zeros + sl], suffix) { return false }
	}
	return true
}

// Large-|dp| plain-'f' rendering (worst-case scratch sizing + the long
// leading/trailing zero runs).
func TestFormatFloatBigF() testing.TestResult {
	// MaxFloat64 -> 17 significant digits + 292 trailing zeros (309 chars).
	if !checkZeroRun(FormatFloat(f64bits(cast(uint64, 0x7FEFFFFFFFFFFFFF)), 'f', shortPrec(), 64), "17976931348623157", 292, "") {
		return fail("f MaxFloat64 layout")
	}
	// Smallest subnormal -> "0." + 323 zeros + "5" (326 chars).
	if !checkZeroRun(FormatFloat(f64bits(cast(uint64, 1)), 'f', shortPrec(), 64), "0.", 323, "5") {
		return fail("f min subnormal layout")
	}
	return ""
}

// Negative values through the scientific and plain paths with a sign prefix.
func TestFormatFloatNegSci() testing.TestResult {
	if !streq(FormatFloat(cast(float64, 0) - 3.141592653589793, 'e', shortPrec(), 64), "-3.141592653589793e+00") {
		return fail("e -pi")
	}
	if !streq(FormatFloat(cast(float64, 0) - 1234.5, 'f', shortPrec(), 64), "-1234.5") { return fail("f -1234.5") }
	return ""
}

// ============================================================
// AppendFloat — overflow / append contract
// ============================================================

func TestAppendFloatContract() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendFloat(buf[0:32], 0, 3.5, 'g', shortPrec(), 64)
	if !streq(buf[0:n], "3.5") { return fail("AppendFloat should write 3.5") }
	if n != 3 { return fail("AppendFloat 3.5 should return next pos 3") }
	// Exact fit.
	var fit @[]char = make_slice(char, 3)
	if AppendFloat(fit[0:3], 0, 3.5, 'g', shortPrec(), 64) != 3 { return fail("exact-fit AppendFloat should return 3") }
	// One short: overflow returns -(needed) and writes nothing.
	var small @[]char = make_slice(char, 2)
	if AppendFloat(small[0:2], 0, 3.5, 'g', shortPrec(), 64) != (cast(int, 0) - 3) {
		return fail("AppendFloat overflow should return -3")
	}
	// pos < 0 also returns -(needed), writing nothing.
	if AppendFloat(buf[0:32], cast(int, 0) - 1, 3.5, 'g', shortPrec(), 64) != (cast(int, 0) - 3) {
		return fail("AppendFloat pos<0 should return -3")
	}
	// Append at a nonzero position (chaining).
	var p int = AppendFloat(buf[0:32], 0, 1.0, 'g', shortPrec(), 64)
	p = AppendFloat(buf[0:32], p, 2.0, 'g', shortPrec(), 64)
	if !streq(buf[0:p], "12") { return fail("chained AppendFloat should give 12") }
	return ""
}
