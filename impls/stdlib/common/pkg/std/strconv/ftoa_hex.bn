package "pkg/std/strconv"

// Hex-float formatting (FormatFloat fmt 'x'/'X'): renders a float as
// `[-]0x1.<hexfrac>p±dd`.  Hex is exact (each nibble is 4 bits), so the
// significand from decompose64/32 maps directly to nibbles with no big.Nat:
// shortest mode (prec < 0) trims trailing zero nibbles; fixed precision
// rounds the significand half-to-even to prec nibbles (with carry into the
// exponent).  Shared helpers (decomposeBySize, managedStr, appendExp,
// copyOut, floatParts) live in ftoa.bn / ftoa_format.bn.

// bitLen64 returns the position of the highest set bit of x plus one (0 for
// x == 0).
func bitLen64(x uint64) int {
	var n int = 0
	var v uint64 = x
	for v != cast(uint64, 0) {
		v = v >> cast(uint64, 1)
		n = n + 1
	}
	return n
}

// hexNibbleChar maps a nibble 0..15 to its hex character (upper or lower).
func hexNibbleChar(d int, upper bool) char {
	if d < 10 {
		return cast(char, cast(int, '0') + d)
	}
	if upper {
		return cast(char, cast(int, 'A') + (d - 10))
	}
	return cast(char, cast(int, 'a') + (d - 10))
}

// formatHex renders f in hex-float form to a fresh caller-owned @[]char.
// upper selects 'X'/'P'/uppercase digits.  prec < 0 is shortest round-trip;
// prec >= 0 is exactly prec fraction nibbles (rounded half-to-even).
func formatHex(f float64, prec int, bitSize int, upper bool) @[]char {
	var parts floatParts = decomposeBySize(f, bitSize)
	if parts.kind == fpNaN {
		return managedStr("NaN")
	}
	if parts.kind == fpInf {
		if parts.sign {
			return managedStr("-Inf")
		}
		return managedStr("+Inf")
	}
	var xCh char = 'x'
	var pCh char = 'p'
	if upper {
		xCh = 'X'
		pCh = 'P'
	}
	var fracCap int = 14
	if prec > 0 {
		fracCap = prec
	}
	var scratch @[]char = make_slice(char, fracCap + 16)
	var n int = 0
	if parts.sign {
		scratch[n] = '-'
		n = n + 1
	}
	scratch[n] = '0'
	n = n + 1
	scratch[n] = xCh
	n = n + 1
	if parts.kind == fpZero {
		scratch[n] = '0'
		n = n + 1
		if prec > 0 {
			scratch[n] = '.'
			n = n + 1
			for i := 0; i < prec; i++ {
				scratch[n] = '0'
				n = n + 1
			}
		}
		n = appendExp(scratch, n, pCh, 0)
		return copyOut(scratch, n)
	}
	// Normalize to 1.frac * 2^E by the leading bit of the significand.
	var topBit int = bitLen64(parts.mant) - 1
	var E int = parts.exp + topBit
	var fracBits uint64 = parts.mant - (cast(uint64, 1) << cast(uint64, topBit))
	scratch[n] = '1'
	n = n + 1
	if prec < 0 {
		n = renderHexShortest(scratch, n, fracBits, topBit, upper)
	} else {
		var numFull int = (topBit + 3) / 4
		if prec >= numFull {
			n = renderHexExact(scratch, n, fracBits, topBit, numFull, prec, upper)
		} else {
			// Round the significand to 4*prec+1 sig bits (leading 1 + prec
			// nibbles); half-to-even parity includes the leading 1.
			var dropBits int = topBit - 4 * prec
			var keptSig uint64 = parts.mant >> cast(uint64, dropBits)
			var roundBit uint64 =
				(parts.mant >> cast(uint64, dropBits - 1)) & cast(uint64, 1)
			var stickyMask uint64 =
				(cast(uint64, 1) << cast(uint64, dropBits - 1)) - cast(uint64, 1)
			var sticky bool = (parts.mant & stickyMask) != cast(uint64, 0)
			if roundBit == cast(uint64, 1) &&
				(sticky || (keptSig & cast(uint64, 1)) == cast(uint64, 1)) {
				keptSig = keptSig + cast(uint64, 1)
			}
			var kept uint64 = cast(uint64, 0)
			if keptSig >= (cast(uint64, 1) << cast(uint64, 4 * prec + 1)) {
				E = E + 1 // carried to 2.0: renormalize, fraction 0
			} else {
				kept = keptSig - (cast(uint64, 1) << cast(uint64, 4 * prec))
			}
			n = renderHexNibbles(scratch, n, kept, prec, upper)
		}
	}
	n = appendExp(scratch, n, pCh, E)
	return copyOut(scratch, n)
}

// renderHexShortest writes ".<nibbles>" for fracBits (topBit bits) with
// trailing zero nibbles trimmed, or nothing if the fraction is zero.
func renderHexShortest(scratch @[]char, pos int, fracBits uint64, topBit int, upper bool) int {
	var n int = pos
	var nn int = (topBit + 3) / 4
	if nn == 0 {
		return n
	}
	var aligned uint64 = fracBits << cast(uint64, nn * 4 - topBit)
	var last int = nn
	for last > 0 {
		var nibble uint64 =
			(aligned >> cast(uint64, 4 * (nn - last))) & cast(uint64, 0xF)
		if nibble != cast(uint64, 0) {
			break
		}
		last = last - 1
	}
	if last == 0 {
		return n
	}
	scratch[n] = '.'
	n = n + 1
	for i := 0; i < last; i++ {
		var d int = cast(int, (aligned >> cast(uint64, 4 * (nn - 1 - i))) & cast(uint64, 0xF))
		scratch[n] = hexNibbleChar(d, upper)
		n = n + 1
	}
	return n
}

// renderHexExact writes ".<nibbles>" with the fraction's numFull exact
// nibbles followed by zero-padding to prec (no rounding needed).
func renderHexExact(
	scratch @[]char, pos int, fracBits uint64, topBit int, numFull int, prec int,
	upper bool,
) int {
	var n int = pos
	if prec == 0 {
		return n
	}
	scratch[n] = '.'
	n = n + 1
	if numFull > 0 {
		var aligned uint64 = fracBits << cast(uint64, numFull * 4 - topBit)
		for i := 0; i < numFull; i++ {
			var d int = cast(int, (aligned >> cast(uint64, 4 * (numFull - 1 - i))) & cast(uint64, 0xF))
			scratch[n] = hexNibbleChar(d, upper)
			n = n + 1
		}
	}
	for i := numFull; i < prec; i++ {
		scratch[n] = '0'
		n = n + 1
	}
	return n
}

// renderHexNibbles writes ".<prec nibbles>" from the rounded fraction kept
// (4*prec bits), or nothing when prec == 0.
func renderHexNibbles(scratch @[]char, pos int, kept uint64, prec int, upper bool) int {
	var n int = pos
	if prec == 0 {
		return n
	}
	scratch[n] = '.'
	n = n + 1
	for i := 0; i < prec; i++ {
		var d int = cast(int, (kept >> cast(uint64, 4 * (prec - 1 - i))) & cast(uint64, 0xF))
		scratch[n] = hexNibbleChar(d, upper)
		n = n + 1
	}
	return n
}
