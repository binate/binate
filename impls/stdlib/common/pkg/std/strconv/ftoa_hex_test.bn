package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/errors"

// Goldens for hex-float formatting (FormatFloat 'x'/'X'), taken from Go's
// strconv.FormatFloat.  (streq / f64bits live in the package's other test
// files.)

func TestFormatHexShortest() testing.TestResult {
	if !streq(FormatFloat(1.0, 'x', -1, 64), "0x1p+00") { return fail("1.0") }
	if !streq(FormatFloat(0.5, 'x', -1, 64), "0x1p-01") { return fail("0.5") }
	if !streq(FormatFloat(2.0, 'x', -1, 64), "0x1p+01") { return fail("2.0") }
	if !streq(FormatFloat(12.0, 'x', -1, 64), "0x1.8p+03") { return fail("12.0") }
	if !streq(FormatFloat(0.1, 'x', -1, 64), "0x1.999999999999ap-04") {
		return fail("0.1")
	}
	if !streq(FormatFloat(255.0, 'x', -1, 64), "0x1.fep+07") { return fail("255") }
	if !streq(FormatFloat(0.0, 'x', -1, 64), "0x0p+00") { return fail("0") }
	if !streq(FormatFloat(-12.0, 'x', -1, 64), "-0x1.8p+03") { return fail("-12") }
	var negZero float64 = f64bits(cast(uint64, 0x8000000000000000))
	if !streq(FormatFloat(negZero, 'x', -1, 64), "-0x0p+00") { return fail("-0") }
	var maxd float64 = f64bits(cast(uint64, 0x7fefffffffffffff))
	if !streq(FormatFloat(maxd, 'x', -1, 64), "0x1.fffffffffffffp+1023") {
		return fail("max double")
	}
	var minSub float64 = f64bits(cast(uint64, 0x0000000000000001))
	if !streq(FormatFloat(minSub, 'x', -1, 64), "0x1p-1074") {
		return fail("smallest subnormal")
	}
	return ""
}

func TestFormatHexUpper() testing.TestResult {
	if !streq(FormatFloat(12.0, 'X', -1, 64), "0X1.8P+03") { return fail("X 12") }
	if !streq(FormatFloat(0.1, 'X', -1, 64), "0X1.999999999999AP-04") {
		return fail("X 0.1")
	}
	// Uppercase fixed precision (upper flag through the rounded-nibble path).
	if !streq(FormatFloat(0.1, 'X', 3, 64), "0X1.99AP-04") { return fail("X 0.1 .3") }
	return ""
}

// TestAppendFloatHex exercises the AppendFloat('x') buffer path and its
// negative "space needed" overflow contract.
func TestAppendFloatHex() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendFloat(buf[0:32], 0, 12.0, 'x', -1, 64)
	if n != 9 { return fail("AppendFloat hex next pos") }
	if !streq(buf[0:n], "0x1.8p+03") { return fail("AppendFloat hex content") }
	// Buffer too small: write nothing, return -(needed).
	var small @[]char = make_slice(char, 5)
	if AppendFloat(small[0:5], 0, 12.0, 'x', -1, 64) != (0 - 9) {
		return fail("AppendFloat hex overflow must return -needed")
	}
	return ""
}

func TestFormatHexFixed() testing.TestResult {
	if !streq(FormatFloat(0.1, 'x', 0, 64), "0x1p-03") { return fail("0.1 .0 carry") }
	if !streq(FormatFloat(0.1, 'x', 1, 64), "0x1.ap-04") { return fail("0.1 .1") }
	if !streq(FormatFloat(0.1, 'x', 3, 64), "0x1.99ap-04") { return fail("0.1 .3") }
	if !streq(FormatFloat(0.1, 'x', 13, 64), "0x1.999999999999ap-04") {
		return fail("0.1 .13 exact")
	}
	// prec beyond the exact nibble count zero-pads on the right.
	if !streq(FormatFloat(0.1, 'x', 20, 64), "0x1.999999999999a0000000p-04") {
		return fail("0.1 .20 pad")
	}
	if !streq(FormatFloat(1.0, 'x', 3, 64), "0x1.000p+00") { return fail("1 .3 pad") }
	if !streq(FormatFloat(12.0, 'x', 2, 64), "0x1.80p+03") { return fail("12 .2") }
	if !streq(FormatFloat(255.0, 'x', 1, 64), "0x1.0p+08") { return fail("255 .1 carry") }
	if !streq(FormatFloat(255.0, 'x', 0, 64), "0x1p+08") { return fail("255 .0") }
	var negZero float64 = f64bits(cast(uint64, 0x8000000000000000))
	if !streq(FormatFloat(negZero, 'x', 3, 64), "-0x0.000p+00") { return fail("-0 .3") }
	return ""
}

func TestFormatHexF32() testing.TestResult {
	if !streq(FormatFloat(0.1, 'x', -1, 32), "0x1.99999ap-04") { return fail("f32 0.1") }
	if !streq(FormatFloat(12.0, 'x', -1, 32), "0x1.8p+03") { return fail("f32 12") }
	if !streq(FormatFloat(1.0, 'x', -1, 32), "0x1p+00") { return fail("f32 1") }
	if !streq(FormatFloat(0.1, 'x', 3, 32), "0x1.99ap-04") { return fail("f32 0.1 .3") }
	// Smallest float32 subnormal (bits 1) normalizes to 0x1p-149.
	var f32sub float64 = cast(float64, f32bits(cast(uint32, 0x00000001)))
	if !streq(FormatFloat(f32sub, 'x', -1, 32), "0x1p-149") { return fail("f32 subnormal") }
	return ""
}

func TestFormatHexSpecials() testing.TestResult {
	var pInf float64 = f64bits(cast(uint64, 0x7ff0000000000000))
	var nInf float64 = f64bits(cast(uint64, 0xfff0000000000000))
	var nan float64 = f64bits(cast(uint64, 0x7ff8000000000000))
	if !streq(FormatFloat(pInf, 'x', -1, 64), "+Inf") { return fail("+Inf") }
	if !streq(FormatFloat(nInf, 'x', -1, 64), "-Inf") { return fail("-Inf") }
	if !streq(FormatFloat(nan, 'x', -1, 64), "NaN") { return fail("NaN") }
	return ""
}

// TestFormatHexParseRoundTrip: ParseFloat(FormatFloat(x,'x',-1)) == x.
func TestFormatHexParseRoundTrip() testing.TestResult {
	var xs @[]uint64 = make_slice(uint64, 6)
	xs[0] = cast(uint64, 0x3fb999999999999a) // 0.1
	xs[1] = cast(uint64, 0x400921fb54442d18) // pi
	xs[2] = cast(uint64, 0xc059000000000000) // -100.0
	xs[3] = cast(uint64, 0x0000000000000001) // smallest subnormal
	xs[4] = cast(uint64, 0x7fefffffffffffff) // max double
	xs[5] = cast(uint64, 0x3ff0000000000000) // 1.0
	for i := 0; i < len(xs); i++ {
		var x float64 = f64bits(xs[i])
		var s @[]char = FormatFloat(x, 'x', -1, 64)
		var v float64
		var err @errors.Error
		v, err = ParseFloat(s[0:len(s)], 64)
		if present(err) { return fail("hex round-trip parse error") }
		if bit_cast(uint64, v) != xs[i] { return fail("hex round-trip mismatch") }
	}
	return ""
}
