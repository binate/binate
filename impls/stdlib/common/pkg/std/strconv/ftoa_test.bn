package "pkg/std/strconv"

import "pkg/builtins/testing"

// fail is shared with strconv_test.bn (same package).

// f64bits / f32bits reinterpret an exact bit pattern as a float, so test
// inputs (especially Inf/NaN/-0/subnormals, which have no literals) are
// unambiguous on every backend.
func f64bits(bits uint64) float64 {
	return bit_cast(float64, bits)
}

func f32bits(bits uint32) float32 {
	return bit_cast(float32, bits)
}

// ============================================================
// decompose64
// ============================================================

func TestDecompose64Normal() testing.TestResult {
	// 1.0 = 2^52 * 2^-52.
	var p floatParts = decompose64(1.0)
	if p.kind != fpFinite { return fail("1.0 should be finite") }
	if p.sign { return fail("1.0 should be non-negative") }
	if p.mant != (cast(uint64, 1) << 52) { return fail("1.0 mantissa should be 2^52") }
	if p.exp != (cast(int, 0) - 52) { return fail("1.0 exponent should be -52") }
	return ""
}

func TestDecompose64Negative() testing.TestResult {
	// -2.0 = 2^52 * 2^-51.
	var p floatParts = decompose64(cast(float64, 0) - 2.0)
	if p.kind != fpFinite { return fail("-2.0 should be finite") }
	if !p.sign { return fail("-2.0 should be negative") }
	if p.mant != (cast(uint64, 1) << 52) { return fail("-2.0 mantissa should be 2^52") }
	if p.exp != (cast(int, 0) - 51) { return fail("-2.0 exponent should be -51") }
	return ""
}

func TestDecompose64Half() testing.TestResult {
	var p floatParts = decompose64(0.5)
	if p.mant != (cast(uint64, 1) << 52) { return fail("0.5 mantissa should be 2^52") }
	if p.exp != (cast(int, 0) - 53) { return fail("0.5 exponent should be -53") }
	return ""
}

func TestDecompose64Three() testing.TestResult {
	// 3.0 = (2^52 | 2^51) * 2^-51 = 3*2^51 * 2^-51.
	var p floatParts = decompose64(3.0)
	if p.mant != (cast(uint64, 3) << 51) { return fail("3.0 mantissa should be 3*2^51") }
	if p.exp != (cast(int, 0) - 51) { return fail("3.0 exponent should be -51") }
	return ""
}

func TestDecompose64PosZero() testing.TestResult {
	var p floatParts = decompose64(0.0)
	if p.kind != fpZero { return fail("0.0 should be zero-kind") }
	if p.sign { return fail("+0.0 should be non-negative") }
	return ""
}

func TestDecompose64NegZero() testing.TestResult {
	var p floatParts = decompose64(f64bits(cast(uint64, 1) << 63))   // -0.0
	if p.kind != fpZero { return fail("-0.0 should be zero-kind") }
	if !p.sign { return fail("-0.0 should preserve its sign") }
	return ""
}

func TestDecompose64Inf() testing.TestResult {
	var pos floatParts = decompose64(f64bits(cast(uint64, 0x7FF0000000000000)))
	if pos.kind != fpInf { return fail("+Inf should be inf-kind") }
	if pos.sign { return fail("+Inf should be non-negative") }
	var neg floatParts = decompose64(f64bits(cast(uint64, 0xFFF0000000000000)))
	if neg.kind != fpInf { return fail("-Inf should be inf-kind") }
	if !neg.sign { return fail("-Inf should be negative") }
	return ""
}

func TestDecompose64NaN() testing.TestResult {
	var p floatParts = decompose64(f64bits(cast(uint64, 0x7FF8000000000000)))
	if p.kind != fpNaN { return fail("NaN should be nan-kind") }
	// A low-fraction-bit-only payload is still NaN — the discriminator keys
	// on the whole fraction field, not just the quiet bit.
	var q floatParts = decompose64(f64bits(cast(uint64, 0x7FF0000000000001)))
	if q.kind != fpNaN { return fail("low-payload NaN should be nan-kind") }
	return ""
}

func TestDecompose64Subnormal() testing.TestResult {
	// Smallest positive subnormal = 2^-1074, mantissa 1.
	var p floatParts = decompose64(f64bits(cast(uint64, 1)))
	if p.kind != fpFinite { return fail("smallest subnormal should be finite") }
	if p.mant != cast(uint64, 1) { return fail("smallest subnormal mantissa should be 1") }
	if p.exp != (cast(int, 0) - 1074) { return fail("smallest subnormal exponent should be -1074") }
	return ""
}

// Largest finite normal: be == 2046, just below the Inf/NaN encoding, with
// all 52 fraction bits set.
func TestDecompose64MaxNormal() testing.TestResult {
	var p floatParts = decompose64(f64bits(cast(uint64, 0x7FEFFFFFFFFFFFFF)))
	if p.kind != fpFinite { return fail("max normal f64 should be finite") }
	if p.sign { return fail("max normal f64 should be non-negative") }
	if p.mant != ((cast(uint64, 1) << 53) - cast(uint64, 1)) { return fail("max normal f64 mantissa should be 2^53-1") }
	if p.exp != 971 { return fail("max normal f64 exponent should be 971") }
	return ""
}

// The normal/subnormal handoff: smallest normal (implicit bit, exp = be-1075)
// and largest subnormal (no implicit bit, exp = -1074) both land at exp -1074
// with adjacent mantissas 2^52 and 2^52-1.
func TestDecompose64NormalSubnormalBoundary() testing.TestResult {
	var sn floatParts = decompose64(f64bits(cast(uint64, 0x0010000000000000)))
	if sn.kind != fpFinite { return fail("smallest normal f64 should be finite") }
	if sn.mant != (cast(uint64, 1) << 52) { return fail("smallest normal f64 mantissa should be 2^52") }
	if sn.exp != (cast(int, 0) - 1074) { return fail("smallest normal f64 exponent should be -1074") }
	var ls floatParts = decompose64(f64bits(cast(uint64, 0x000FFFFFFFFFFFFF)))
	if ls.kind != fpFinite { return fail("largest subnormal f64 should be finite") }
	if ls.mant != ((cast(uint64, 1) << 52) - cast(uint64, 1)) { return fail("largest subnormal f64 mantissa should be 2^52-1") }
	if ls.exp != (cast(int, 0) - 1074) { return fail("largest subnormal f64 exponent should be -1074") }
	return ""
}

// ============================================================
// decompose32
// ============================================================

func TestDecompose32Normal() testing.TestResult {
	// 1.0f = 2^23 * 2^-23.
	var p floatParts = decompose32(cast(float32, 1.0))
	if p.kind != fpFinite { return fail("1.0f should be finite") }
	if p.mant != (cast(uint64, 1) << 23) { return fail("1.0f mantissa should be 2^23") }
	if p.exp != (cast(int, 0) - 23) { return fail("1.0f exponent should be -23") }
	return ""
}

func TestDecompose32Inf() testing.TestResult {
	var p floatParts = decompose32(f32bits(cast(uint32, 0x7F800000)))
	if p.kind != fpInf { return fail("+Inf32 should be inf-kind") }
	if p.sign { return fail("+Inf32 should be non-negative") }
	var neg floatParts = decompose32(f32bits(cast(uint32, 0xFF800000)))
	if neg.kind != fpInf { return fail("-Inf32 should be inf-kind") }
	if !neg.sign { return fail("-Inf32 should be negative") }
	return ""
}

func TestDecompose32NaN() testing.TestResult {
	var p floatParts = decompose32(f32bits(cast(uint32, 0x7FC00000)))
	if p.kind != fpNaN { return fail("NaN32 should be nan-kind") }
	return ""
}

func TestDecompose32Subnormal() testing.TestResult {
	// Smallest positive subnormal f32 = 2^-149, mantissa 1.
	var p floatParts = decompose32(f32bits(cast(uint32, 1)))
	if p.kind != fpFinite { return fail("smallest subnormal f32 should be finite") }
	if p.mant != cast(uint64, 1) { return fail("smallest subnormal f32 mantissa should be 1") }
	if p.exp != (cast(int, 0) - 149) { return fail("smallest subnormal f32 exponent should be -149") }
	return ""
}

func TestDecompose32NegZero() testing.TestResult {
	var p floatParts = decompose32(f32bits(cast(uint32, 1) << 31))   // -0.0f
	if p.kind != fpZero { return fail("-0.0f should be zero-kind") }
	if !p.sign { return fail("-0.0f should preserve its sign") }
	return ""
}

func TestDecompose32Negative() testing.TestResult {
	// -2.0f = 2^23 * 2^-22.
	var p floatParts = decompose32(f32bits(cast(uint32, 0xC0000000)))
	if p.kind != fpFinite { return fail("-2.0f should be finite") }
	if !p.sign { return fail("-2.0f should be negative") }
	if p.mant != (cast(uint64, 1) << 23) { return fail("-2.0f mantissa should be 2^23") }
	if p.exp != (cast(int, 0) - 22) { return fail("-2.0f exponent should be -22") }
	return ""
}

func TestDecompose32MaxNormal() testing.TestResult {
	var p floatParts = decompose32(f32bits(cast(uint32, 0x7F7FFFFF)))
	if p.kind != fpFinite { return fail("max normal f32 should be finite") }
	if p.sign { return fail("max normal f32 should be non-negative") }
	if p.mant != ((cast(uint64, 1) << 24) - cast(uint64, 1)) { return fail("max normal f32 mantissa should be 2^24-1") }
	if p.exp != 104 { return fail("max normal f32 exponent should be 104") }
	return ""
}

func TestDecompose32NormalSubnormalBoundary() testing.TestResult {
	var sn floatParts = decompose32(f32bits(cast(uint32, 0x00800000)))
	if sn.kind != fpFinite { return fail("smallest normal f32 should be finite") }
	if sn.mant != (cast(uint64, 1) << 23) { return fail("smallest normal f32 mantissa should be 2^23") }
	if sn.exp != (cast(int, 0) - 149) { return fail("smallest normal f32 exponent should be -149") }
	var ls floatParts = decompose32(f32bits(cast(uint32, 0x007FFFFF)))
	if ls.kind != fpFinite { return fail("largest subnormal f32 should be finite") }
	if ls.mant != ((cast(uint64, 1) << 23) - cast(uint64, 1)) { return fail("largest subnormal f32 mantissa should be 2^23-1") }
	if ls.exp != (cast(int, 0) - 149) { return fail("largest subnormal f32 exponent should be -149") }
	return ""
}

func TestDecompose32PosZero() testing.TestResult {
	var p floatParts = decompose32(f32bits(cast(uint32, 0)))
	if p.kind != fpZero { return fail("+0.0f should be zero-kind") }
	if p.sign { return fail("+0.0f should be non-negative") }
	return ""
}

// ============================================================
// shortestDigits (binary64)
// ============================================================

// checkShortest64 asserts the shortest digit string + dp for a binary64
// value given by its bit pattern.
func checkShortest64(bits uint64, want *[]readonly char, wantDp int) testing.TestResult {
	var p floatParts = decompose64(f64bits(bits))
	var digits @[]char = make_slice(char, 0)
	var dp int = 0
	digits, dp = shortestDigits(p.mant, p.exp, cast(uint, 52), cast(int, 0) - 1074)
	if !streq(digits, want) { return fail("shortest digits mismatch") }
	if dp != wantDp { return fail("shortest dp mismatch") }
	return ""
}

func TestShortest64Simple() testing.TestResult {
	var r testing.TestResult = checkShortest64(cast(uint64, 0x3FF0000000000000), "1", 1)   // 1.0
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x4000000000000000), "2", 1)                          // 2.0
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x4008000000000000), "3", 1)                          // 3.0
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x3FE0000000000000), "5", 0)                          // 0.5
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x3FD0000000000000), "25", 0)                         // 0.25
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x4059000000000000), "1", 3)                          // 100.0
	if len(r) > 0 { return r }
	return ""
}

func TestShortest64Fractions() testing.TestResult {
	var r testing.TestResult = checkShortest64(cast(uint64, 0x3FB999999999999A), "1", 0)   // 0.1
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x3FD3333333333333), "3", 0)                          // 0.3
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x3FD3333333333334), "30000000000000004", 0)          // 0.1 + 0.2
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x400921FB54442D18), "3141592653589793", 1)           // pi
	if len(r) > 0 { return r }
	return ""
}

// Structurally-distinct binary64 cases: subnormals (exp<0 setup with mant !=
// 2^52), the min-normal/max-subnormal boundary, the largest normal (largest
// dp), and 2^60 (the only case reaching the exp>=0 && useHalf setup).
func TestShortest64Edges() testing.TestResult {
	var r testing.TestResult = checkShortest64(cast(uint64, 1), "5", cast(int, 0) - 323)   // min subnormal 5e-324
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x000FFFFFFFFFFFFF), "2225073858507201", cast(int, 0) - 307)   // max subnormal
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x0010000000000000), "22250738585072014", cast(int, 0) - 307)  // min normal
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x7FEFFFFFFFFFFFFF), "17976931348623157", 309)        // max normal
	if len(r) > 0 { return r }
	r = checkShortest64(cast(uint64, 0x43B0000000000000), "1152921504606847", 19)          // 2^60 (exp>=0 && useHalf)
	if len(r) > 0 { return r }
	return ""
}

// ============================================================
// shortestDigits (binary32)
// ============================================================

func checkShortest32(bits uint32, want *[]readonly char, wantDp int) testing.TestResult {
	var p floatParts = decompose32(f32bits(bits))
	var digits @[]char = make_slice(char, 0)
	var dp int = 0
	digits, dp = shortestDigits(p.mant, p.exp, cast(uint, 23), cast(int, 0) - 149)
	if !streq(digits, want) { return fail("shortest32 digits mismatch") }
	if dp != wantDp { return fail("shortest32 dp mismatch") }
	return ""
}

func TestShortest32Simple() testing.TestResult {
	var r testing.TestResult = checkShortest32(cast(uint32, 0x3F800000), "1", 1)            // 1.0f
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x40000000), "2", 1)                                   // 2.0f
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x3F000000), "5", 0)                                   // 0.5f
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x3DCCCCCD), "1", 0)                                   // 0.1f
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x40490FDB), "31415927", 1)                            // pi (f32)
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x4B000000), "8388608", 7)                             // 2^23
	if len(r) > 0 { return r }
	return ""
}

// f32 boundaries (subnormals, min/max normal) and the f32-vs-f64 divergence:
// 0.2 as f32 is the shortest "2", whereas as f64 it needs 17 digits.
func TestShortest32Boundaries() testing.TestResult {
	var r testing.TestResult = checkShortest32(cast(uint32, 1), "1", cast(int, 0) - 44)     // min subnormal
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x007FFFFF), "11754942", cast(int, 0) - 37)            // max subnormal
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x00800000), "11754944", cast(int, 0) - 37)            // min normal
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x7F7FFFFF), "34028235", 39)                           // max normal
	if len(r) > 0 { return r }
	r = checkShortest32(cast(uint32, 0x3E4CCCCD), "2", 0)                                   // 0.2f (f32-shortest, unlike f64)
	if len(r) > 0 { return r }
	return ""
}
