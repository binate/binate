package "pkg/std/strconv"

import "pkg/std/errors"

// kindSyntax / kindRange classify a failed parse, mirroring Go's
// strconv.ErrSyntax / ErrRange.  They are internal: a caller cannot yet
// read the kind back out of an @errors.Error (that needs errors.Is /
// RTTI, deferred in plan-std-errors.md), so for now the kind only
// selects the message text.  When errors.Is lands these become the
// exported sentinels a caller compares against — purely additively, with
// no change to the Parse signatures.
const kindSyntax int = 1
const kindRange int = 2

// numError records a failed numeric conversion (mirroring Go's
// strconv.NumError: the failing function, the offending input, and the
// kind).  It implements errors.Error, so callers only ever see the boxed
// @errors.Error; numError itself is unexported.  fn borrows a static
// string literal (no copy); num is an owned copy of the input, since the
// input slice borrows caller memory that need not outlive the error.
type numError struct {
	fn   *[]readonly char
	num  @[]char
	kind int
}

// reasonText maps a kind to its human-readable clause.
func reasonText(kind int) *[]readonly char {
	if kind == kindRange {
		return "value out of range"
	}
	return "invalid syntax"
}

// Error renders `strconv.<fn>: parsing "<num>": <reason>`, matching Go's
// strconv.NumError format.  The input is wrapped in plain double quotes
// without escaping (a full strconv.Quote is a later addition), which is
// adequate for the diagnostic.
func (e *numError) Error() @[]char {
	var pre *[]readonly char = "strconv."
	var mid *[]readonly char = ": parsing \""
	var post *[]readonly char = "\": "
	var reason *[]readonly char = reasonText(e.kind)
	var total int = len(pre) + len(e.fn) + len(mid) + len(e.num) +
		len(post) + len(reason)
	var out @[]char = make_slice(char, total)
	// Exact-fit buffer, so each appendLit returns the next position and
	// none can overflow.
	var p int = 0
	p = appendLit(out[0:total], p, pre)
	p = appendLit(out[0:total], p, e.fn)
	p = appendLit(out[0:total], p, mid)
	p = appendLit(out[0:total], p, e.num[0:len(e.num)])
	p = appendLit(out[0:total], p, post)
	p = appendLit(out[0:total], p, reason)
	return out
}

// Unwrap reports that numError is a leaf: it returns an empty
// @errors.Error (test with present), since a parse failure wraps no cause.
func (e *numError) Unwrap() @errors.Error {
	var none @errors.Error
	return none
}

impl *numError : errors.Error

// copyInput returns a freshly-allocated owned copy of s, used for the
// numError.num field (the input slice borrows caller memory).
func copyInput(s *[]readonly uint8) @[]char {
	var n int = len(s)
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = s[i]
	}
	return out
}

// newNumError boxes a numError of the given kind into an @errors.Error.
func newNumError(fn *[]readonly char, s *[]readonly uint8, kind int) @errors.Error {
	var e @numError = make(numError)
	e.fn = fn
	e.num = copyInput(s)
	e.kind = kind
	var err @errors.Error = e
	return err
}

// syntaxErr builds the @errors.Error for an input that is not valid
// syntax for the target type.
func syntaxErr(fn *[]readonly char, s *[]readonly uint8) @errors.Error {
	return newNumError(fn, s, kindSyntax)
}

// rangeErr builds the @errors.Error for an input that is syntactically
// valid but out of range for the target type.
func rangeErr(fn *[]readonly char, s *[]readonly uint8) @errors.Error {
	return newNumError(fn, s, kindRange)
}
