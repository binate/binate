package "pkg/std/strconv"

import "pkg/std/errors"

// bytesEq reports whether the byte view s equals the literal lit.
func bytesEq(s *[]readonly uint8, lit *[]readonly char) bool {
	if len(s) != len(lit) {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] != lit[i] {
			return false
		}
	}
	return true
}

// ParseBool interprets s as a boolean, accepting Go's set:
// 1, t, T, TRUE, true, True → true; 0, f, F, FALSE, false, False → false.
// Anything else yields a syntax error (with a false value).
func ParseBool(s *[]readonly uint8) (bool, @errors.Error) {
	var none @errors.Error
	if bytesEq(s, "1") || bytesEq(s, "t") || bytesEq(s, "T") ||
		bytesEq(s, "TRUE") || bytesEq(s, "true") || bytesEq(s, "True") {
		return true, none
	}
	if bytesEq(s, "0") || bytesEq(s, "f") || bytesEq(s, "F") ||
		bytesEq(s, "FALSE") || bytesEq(s, "false") || bytesEq(s, "False") {
		return false, none
	}
	return false, syntaxErr("ParseBool", s)
}
