package "pkg/std/strconv"

// normBase clamps a base outside 2..36 to 10.  Go panics on an
// out-of-range base; Binate has no panics, so the Append/Format
// surface picks a sane default rather than emitting garbage.
func normBase(base int) int {
	if base < 2 { return 10 }
	if base > 36 { return 10 }
	return base
}

// digitChar maps a digit value 0..35 to its lowercase character.
func digitChar(d int) char {
	if d < 10 {
		return cast(char, cast(int, '0') + d)
	}
	return cast(char, cast(int, 'a') + (d - 10))
}

// uintDigits returns how many base-`base` digits v occupies (>= 1;
// zero is one digit).  base must already be normalized (2..36).
func uintDigits(v uint64, base int) int {
	var b uint64 = cast(uint64, base)
	var n int = 1
	var t uint64 = v
	for t >= b {
		t = t / b
		n = n + 1
	}
	return n
}

// appendLit writes the literal s into dst at pos, returning the next
// position (or -len(s) when dst lacks room — the Append overflow
// contract).
func appendLit(dst *[]char, pos int, s *[]readonly char) int {
	var n int = len(s)
	if pos < 0 { return -n }
	if pos + n > len(dst) { return -n }
	for i := 0; i < n; i++ {
		dst[pos + i] = s[i]
	}
	return pos + n
}

func AppendUint(dst *[]char, pos int, v uint64, base int) int {
	var b int = normBase(base)
	var nd int = uintDigits(v, b)
	if pos < 0 { return -nd }
	var end int = pos + nd
	if end > len(dst) { return -nd }
	var bb uint64 = cast(uint64, b)
	// Write digits low-to-high, filling from the last slot backward.
	var p int = end - 1
	var rem uint64 = v
	for {
		var d int = cast(int, rem % bb)
		dst[p] = digitChar(d)
		rem = rem / bb
		if rem == cast(uint64, 0) { break }
		p = p - 1
	}
	return end
}

func AppendInt(dst *[]char, pos int, v int64, base int) int {
	if v >= cast(int64, 0) {
		return AppendUint(dst, pos, cast(uint64, v), base)
	}
	var b int = normBase(base)
	// Two's-complement magnitude: `0 - v` overflows at INT64_MIN, so
	// negate through uint64 instead (mirrors bootstrap.Itoa).
	var mag uint64 = cast(uint64, 0) - cast(uint64, v)
	var needed int = uintDigits(mag, b) + 1
	if pos < 0 { return -needed }
	if pos + needed > len(dst) { return -needed }
	dst[pos] = '-'
	return AppendUint(dst, pos + 1, mag, b)
}

func AppendBool(dst *[]char, pos int, b bool) int {
	if b {
		return appendLit(dst, pos, "true")
	}
	return appendLit(dst, pos, "false")
}

func FormatUint(v uint64, base int) @[]char {
	var b int = normBase(base)
	var nd int = uintDigits(v, b)
	var s @[]char = make_slice(char, nd)
	AppendUint(s[0:nd], 0, v, b)
	return s
}

func FormatInt(v int64, base int) @[]char {
	if v >= cast(int64, 0) {
		return FormatUint(cast(uint64, v), base)
	}
	var b int = normBase(base)
	var mag uint64 = cast(uint64, 0) - cast(uint64, v)
	var total int = uintDigits(mag, b) + 1
	var s @[]char = make_slice(char, total)
	AppendInt(s[0:total], 0, v, b)
	return s
}

func FormatBool(b bool) @[]char {
	if b {
		var s @[]char = make_slice(char, 4)
		appendLit(s[0:4], 0, "true")
		return s
	}
	var s @[]char = make_slice(char, 5)
	appendLit(s[0:5], 0, "false")
	return s
}
