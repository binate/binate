package "pkg/std/strconv"

import "pkg/builtins/testing"

// streq compares two char slices for equality.  Test-local helper to
// avoid pulling in pkg/binate/buf or bootstrap (mirrors lang_test.bn).
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// AppendUint
// ============================================================

func TestAppendUintBase10() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendUint(buf[0:32], 0, cast(uint64, 42), 10)
	if n != 2 { return fail("AppendUint(42,10) should return next pos 2") }
	if !streq(buf[0:n], "42") { return fail("expected \"42\"") }
	return ""
}

func TestAppendUintZero() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendUint(buf[0:32], 0, cast(uint64, 0), 10)
	if n != 1 { return fail("AppendUint(0) should write one digit") }
	if !streq(buf[0:n], "0") { return fail("expected \"0\"") }
	return ""
}

func TestAppendUintBase16() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendUint(buf[0:32], 0, cast(uint64, 255), 16)
	if !streq(buf[0:n], "ff") { return fail("255 base 16 should be \"ff\"") }
	return ""
}

func TestAppendUintBase2() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendUint(buf[0:32], 0, cast(uint64, 5), 2)
	if !streq(buf[0:n], "101") { return fail("5 base 2 should be \"101\"") }
	return ""
}

func TestAppendUintBase36() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendUint(buf[0:32], 0, cast(uint64, 35), 36)
	if !streq(buf[0:n], "z") { return fail("35 base 36 should be \"z\"") }
	return ""
}

// ============================================================
// AppendInt
// ============================================================

func TestAppendIntNegative() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendInt(buf[0:32], 0, cast(int64, 0) - cast(int64, 42), 10)
	if n != 3 { return fail("-42 should occupy 3 chars") }
	if !streq(buf[0:n], "-42") { return fail("expected \"-42\"") }
	return ""
}

func TestAppendIntPositive() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendInt(buf[0:32], 0, cast(int64, 12345), 10)
	if !streq(buf[0:n], "12345") { return fail("expected \"12345\"") }
	return ""
}

func TestAppendIntNegHex() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendInt(buf[0:32], 0, cast(int64, 0) - cast(int64, 255), 16)
	if !streq(buf[0:n], "-ff") { return fail("-255 base 16 should be \"-ff\"") }
	return ""
}

// INT64_MIN exercises the two's-complement magnitude path
// (`0 - v` would overflow); built without an out-of-range literal.
func TestAppendIntMin() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var maxI64 int64 = cast(int64, 9223372036854775807)
	var minI64 int64 = (cast(int64, 0) - maxI64) - cast(int64, 1)
	var n int = AppendInt(buf[0:32], 0, minI64, 10)
	if !streq(buf[0:n], "-9223372036854775808") {
		return fail("INT64_MIN should be \"-9223372036854775808\"")
	}
	return ""
}

// ============================================================
// Positioning, chaining, overflow
// ============================================================

func TestAppendAtPosAndChain() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var p int = AppendInt(buf[0:32], 0, cast(int64, 12), 10)
	if p != 2 { return fail("first append should return next pos 2") }
	p = AppendInt(buf[0:32], p, cast(int64, 34), 10)
	if p != 4 { return fail("chained append should return next pos 4") }
	if !streq(buf[0:4], "1234") { return fail("chained writes should give \"1234\"") }
	return ""
}

func TestAppendUintOverflowReturnsNeeded() testing.TestResult {
	var small @[]char = make_slice(char, 1)
	// 42 needs 2 chars but only 1 slot is free → -2, nothing written.
	var n int = AppendUint(small[0:1], 0, cast(uint64, 42), 10)
	if n != (cast(int, 0) - 2) {
		return fail("overflow should return -(chars needed) = -2")
	}
	return ""
}

func TestAppendBoolOverflowReturnsNeeded() testing.TestResult {
	var small @[]char = make_slice(char, 2)
	// "true" needs 4 chars, only 2 slots → -4.
	var n int = AppendBool(small[0:2], 0, true)
	if n != (cast(int, 0) - 4) {
		return fail("AppendBool overflow should return -4")
	}
	return ""
}

// A base outside 2..36 is treated as base 10.
func TestAppendUintInvalidBaseDefaultsTo10() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendUint(buf[0:32], 0, cast(uint64, 42), 99)
	if !streq(buf[0:n], "42") { return fail("invalid base should default to 10") }
	var m int = AppendUint(buf[0:32], 0, cast(uint64, 42), 0)
	if !streq(buf[0:m], "42") { return fail("base 0 should default to 10") }
	return ""
}

// ============================================================
// AppendBool
// ============================================================

func TestAppendBool() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendBool(buf[0:32], 0, true)
	if !streq(buf[0:n], "true") { return fail("expected \"true\"") }
	n = AppendBool(buf[0:32], 0, false)
	if !streq(buf[0:n], "false") { return fail("expected \"false\"") }
	return ""
}

// ============================================================
// Format* (allocating conveniences)
// ============================================================

func TestFormatInt() testing.TestResult {
	if !streq(FormatInt(cast(int64, 0) - cast(int64, 42), 10), "-42") {
		return fail("FormatInt(-42,10) should be \"-42\"")
	}
	if !streq(FormatInt(cast(int64, 0), 10), "0") {
		return fail("FormatInt(0) should be \"0\"")
	}
	if !streq(FormatInt(cast(int64, 255), 16), "ff") {
		return fail("FormatInt(255,16) should be \"ff\"")
	}
	return ""
}

func TestFormatUint() testing.TestResult {
	if !streq(FormatUint(cast(uint64, 42), 10), "42") {
		return fail("FormatUint(42,10) should be \"42\"")
	}
	if !streq(FormatUint(cast(uint64, 0), 2), "0") {
		return fail("FormatUint(0,2) should be \"0\"")
	}
	return ""
}

func TestFormatBool() testing.TestResult {
	if !streq(FormatBool(true), "true") { return fail("FormatBool(true)") }
	if !streq(FormatBool(false), "false") { return fail("FormatBool(false)") }
	return ""
}
