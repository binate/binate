package "pkg/std/os"

import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/io"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// nativeOpenFlags maps the portable O_* bits to the target OS's native
// open(2) flags: access modes pass through; modifiers are remapped per
// build.OS.  The expected values are OS-specific, so the assertions
// branch the same way the function does.
func TestNativeOpenFlags() testing.TestResult {
	if nativeOpenFlags(O_RDONLY) != 0x0 { return fail("O_RDONLY passthrough") }
	if nativeOpenFlags(O_WRONLY) != 0x1 { return fail("O_WRONLY passthrough") }
	if nativeOpenFlags(O_RDWR) != 0x2 { return fail("O_RDWR passthrough") }
	if build.OS == build.OS_DARWIN {
		// Create's flags: O_RDWR|O_CREAT|O_TRUNC = 0x2|0x200|0x400 = 0x602.
		if nativeOpenFlags(O_RDWR | O_CREATE | O_TRUNC) != 0x602 {
			return fail("darwin Create flag translation")
		}
		if nativeOpenFlags(O_WRONLY | O_APPEND) != 0x9 { return fail("darwin O_APPEND") }
		if nativeOpenFlags(O_WRONLY | O_EXCL) != 0x801 { return fail("darwin O_EXCL") }
		if nativeOpenFlags(O_WRONLY | O_SYNC) != 0x81 { return fail("darwin O_SYNC") }
	} else {
		// Linux: O_RDWR|O_CREAT|O_TRUNC = 0x2|0x40|0x200 = 0x242.
		if nativeOpenFlags(O_RDWR | O_CREATE | O_TRUNC) != 0x242 {
			return fail("linux Create flag translation")
		}
		if nativeOpenFlags(O_WRONLY | O_APPEND) != 0x401 { return fail("linux O_APPEND") }
		if nativeOpenFlags(O_WRONLY | O_EXCL) != 0x81 { return fail("linux O_EXCL") }
		if nativeOpenFlags(O_WRONLY | O_SYNC) != 0x101001 { return fail("linux O_SYNC") }
	}
	return ""
}

// Create writes a file; Open reads it back with identical contents.
func TestCreateWriteReadRoundTrip() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_os_test_rw")
	if present(err) { return fail("Create should succeed") }
	var n int
	n, err = f.Write("hello world")
	if present(err) { return fail("Write should succeed") }
	if n != 11 { return fail("Write should write 11 bytes") }
	if present(f.Close()) { return fail("Close should succeed") }

	var g @File
	g, err = Open("/tmp/binate_os_test_rw")
	if present(err) { return fail("Open should succeed") }
	var buf @[]uint8 = make_slice(uint8, 32)
	var m int
	m, err = g.Read(buf[0:32])
	if present(err) { return fail("Read should succeed") }
	if m != 11 { return fail("Read should read 11 bytes") }
	if buf[0] != cast(uint8, 104) { return fail("byte 0 should be 'h'") }
	if buf[6] != cast(uint8, 119) { return fail("byte 6 should be 'w'") }
	if present(g.Close()) { return fail("Close g should succeed") }
	return ""
}

// Open of a nonexistent path reports an error.
func TestOpenNonexistent() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Open("/tmp/binate_os_test_does_not_exist_zzz")
	if !present(err) { return fail("Open of a nonexistent file should fail") }
	return ""
}

// Seek repositions the stream; a subsequent Read starts at the new
// offset.
func TestSeek() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_os_test_seek")
	if present(err) { return fail("Create should succeed") }
	var n int
	n, err = f.Write("hello world")
	if present(err) { return fail("Write should succeed") }
	if present(f.Close()) { return fail("Close should succeed") }

	var g @File
	g, err = Open("/tmp/binate_os_test_seek")
	if present(err) { return fail("Open should succeed") }
	var pos int64
	pos, err = g.Seek(cast(int64, 6), SeekStart)
	if present(err) { return fail("Seek should succeed") }
	if pos != cast(int64, 6) { return fail("Seek should land at offset 6") }
	var buf @[]uint8 = make_slice(uint8, 16)
	var m int
	m, err = g.Read(buf[0:16])
	if present(err) { return fail("Read after seek should succeed") }
	if m != 5 { return fail("should read 'world' (5 bytes)") }
	if buf[0] != cast(uint8, 119) { return fail("first byte should be 'w'") }
	if present(g.Close()) { return fail("Close g should succeed") }
	return ""
}

// WriteAt / ReadAt use explicit offsets without disturbing the stream
// position.
func TestReadAtWriteAt() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_os_test_at")
	if present(err) { return fail("Create should succeed") }
	var n int
	n, err = f.Write("abcdef")
	if present(err) { return fail("Write should succeed") }
	n, err = f.WriteAt("XY", cast(int64, 2))
	if present(err) { return fail("WriteAt should succeed") }
	if n != 2 { return fail("WriteAt should write 2 bytes") }
	var buf @[]uint8 = make_slice(uint8, 2)
	var m int
	m, err = f.ReadAt(buf[0:2], cast(int64, 2))
	if present(err) { return fail("ReadAt should succeed") }
	if m != 2 { return fail("ReadAt should read 2 bytes") }
	if buf[0] != cast(uint8, 88) { return fail("byte should be 'X'") }
	if buf[1] != cast(uint8, 89) { return fail("byte should be 'Y'") }
	if present(f.Close()) { return fail("Close should succeed") }
	return ""
}

// A Read past the end of input returns io.EOF.
func TestReadEOF() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_os_test_eof")
	if present(err) { return fail("Create should succeed") }
	var n int
	n, err = f.Write("hi")
	if present(err) { return fail("Write should succeed") }
	if present(f.Close()) { return fail("Close should succeed") }

	var g @File
	g, err = Open("/tmp/binate_os_test_eof")
	if present(err) { return fail("Open should succeed") }
	var buf @[]uint8 = make_slice(uint8, 8)
	var m int
	m, err = g.Read(buf[0:8])
	if m != 2 { return fail("first read should return 2 bytes") }
	m, err = g.Read(buf[0:8])
	if m != 0 { return fail("read at EOF should return 0 bytes") }
	if !io.IsEOF(err) { return fail("read at EOF should return io.EOF") }
	if present(g.Close()) { return fail("Close g should succeed") }
	return ""
}

// The standard streams wrap descriptors 0/1/2 and are present.
func TestStandardStreams() testing.TestResult {
	if !present(Stdin) { return fail("Stdin should be present") }
	if !present(Stdout) { return fail("Stdout should be present") }
	if !present(Stderr) { return fail("Stderr should be present") }
	if Stdin.fd != 0 { return fail("Stdin.fd should be 0") }
	if Stdout.fd != 1 { return fail("Stdout.fd should be 1") }
	if Stderr.fd != 2 { return fail("Stderr.fd should be 2") }
	return ""
}

// errno classification — the failures we can actually trigger map to the
// right base (the full per-OS errno value table is adversarially
// verified, since most codes can't be produced from os's surface).

// A nonexistent path → ENOENT → NotFound (and so ConditionsUnmet).
func TestOpenNotFoundClassified() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Open("/tmp/binate_os_nonexistent_zzz_qq")
	if !present(err) { return fail("open of a nonexistent path should fail") }
	if !errors.Is(err, errors.NotFound) { return fail("ENOENT should be NotFound") }
	if !errors.Is(err, errors.ConditionsUnmet) { return fail("NotFound is-a ConditionsUnmet") }
	return ""
}

// O_CREATE|O_EXCL on an existing file → EEXIST → AlreadyExists.
func TestOpenExclClassified() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_os_excl")
	if present(err) { return fail("Create should succeed") }
	if present(f.Close()) { return fail("Close should succeed") }
	var g @File
	g, err = OpenFile("/tmp/binate_os_excl", O_WRONLY | O_CREATE | O_EXCL, cast(FileMode, 0o644))
	if !present(err) { return fail("O_EXCL on an existing file should fail") }
	if !errors.Is(err, errors.AlreadyExists) { return fail("EEXIST should be AlreadyExists") }
	return ""
}

// Opening a directory for writing → EISDIR → ConditionsUnmet.
func TestOpenDirForWriteClassified() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = OpenFile("/tmp", O_WRONLY, cast(FileMode, 0))
	if !present(err) { return fail("opening a directory for write should fail") }
	if !errors.Is(err, errors.ConditionsUnmet) { return fail("EISDIR should be ConditionsUnmet") }
	return ""
}

// classifies reports whether errnoToBase maps errno e to (an is-a of) base.
func classifies(e int, base @errors.Error) bool {
	return errors.Is(errnoToBase(e), base)
}

// TestErrnoClassification exercises errnoToBase directly for EVERY errno os
// classifies — most can't be triggered from os's surface, so the end-to-end
// *Classified tests above only reach three.  Per-OS errno VALUES are picked
// here exactly as errnoToBase picks them (the numbers themselves are verified
// against the real <errno.h> by e2e/errno-values.sh), so this runs on either
// OS.
func TestErrnoClassification() testing.TestResult {
	// Shared codes (package consts; identical on Linux and macOS).
	if !classifies(ENOENT, errors.NotFound) { return fail("ENOENT") }
	if !classifies(EEXIST, errors.AlreadyExists) { return fail("EEXIST") }
	if !classifies(EPERM, errors.PermissionDenied) { return fail("EPERM") }
	if !classifies(EACCES, errors.PermissionDenied) { return fail("EACCES") }
	if !classifies(EROFS, errors.PermissionDenied) { return fail("EROFS") }
	if !classifies(ENOTDIR, errors.ConditionsUnmet) { return fail("ENOTDIR") }
	if !classifies(EISDIR, errors.ConditionsUnmet) { return fail("EISDIR") }
	if !classifies(ETXTBSY, errors.ConditionsUnmet) { return fail("ETXTBSY") }
	if !classifies(EINVAL, errors.InvalidArgument) { return fail("EINVAL") }
	if !classifies(EFBIG, errors.OutOfRange) { return fail("EFBIG") }
	if !classifies(ERANGE, errors.OutOfRange) { return fail("ERANGE") }
	if !classifies(ENOMEM, errors.ResourceExhausted) { return fail("ENOMEM") }
	if !classifies(ENFILE, errors.ResourceExhausted) { return fail("ENFILE") }
	if !classifies(EMFILE, errors.ResourceExhausted) { return fail("EMFILE") }
	if !classifies(ENOSPC, errors.ResourceExhausted) { return fail("ENOSPC") }
	if !classifies(EMLINK, errors.ResourceExhausted) { return fail("EMLINK") }
	if !classifies(ESPIPE, errors.Unsupported) { return fail("ESPIPE") }
	if !classifies(EXDEV, errors.Unsupported) { return fail("EXDEV") }
	if !classifies(ENODEV, errors.Unsupported) { return fail("ENODEV") }
	if !classifies(ENXIO, errors.Unavailable) { return fail("ENXIO") }
	if !classifies(EPIPE, errors.Unavailable) { return fail("EPIPE") }
	if !classifies(EBUSY, errors.Retryable) { return fail("EBUSY") }
	if !classifies(EIO, errors.Unknown) { return fail("EIO") }

	// Codes whose numbers differ per OS — pick this OS's value as
	// errnoToBase does (Linux defaults, Darwin overrides).
	var eagain int = 11
	var enametoolong int = 36
	var enosys int = 38
	var eloop int = 40
	var eoverflow int = 75
	var eopnotsupp int = 95
	var edquot int = 122
	if build.OS == build.OS_DARWIN {
		eagain = 35
		enametoolong = 63
		eloop = 62
		enosys = 78
		eoverflow = 84
		eopnotsupp = 102
		edquot = 69
	}
	if !classifies(eagain, errors.Retryable) { return fail("EAGAIN") }
	if !classifies(enametoolong, errors.InvalidArgument) { return fail("ENAMETOOLONG") }
	if !classifies(enosys, errors.Unsupported) { return fail("ENOSYS") }
	if !classifies(eloop, errors.ConditionsUnmet) { return fail("ELOOP") }
	if !classifies(eoverflow, errors.OutOfRange) { return fail("EOVERFLOW") }
	if !classifies(eopnotsupp, errors.Unsupported) { return fail("EOPNOTSUPP") }
	if !classifies(edquot, errors.ResourceExhausted) { return fail("EDQUOT") }

	// An errno os does not classify falls through to Unknown.
	if !classifies(0, errors.Unknown) { return fail("unmapped->Unknown") }
	// Negative: NotFound is in a different subtree than PermissionDenied, so
	// a true result here would mean errors.Is matches trivially.
	if classifies(ENOENT, errors.PermissionDenied) { return fail("Is false-positive") }
	return ""
}
