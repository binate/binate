package "pkg/std/cmp"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// equalVia exercises an Eq through a monomorphized constraint slot — the shape a hash
// container uses (`E Eq[K]`), so the tests cover the policy-as-type-param path and not
// just direct method calls.
func equalVia[K any, E Eq[K]](e E, a K, b K) bool {
	return e.Equal(a, b)
}

// modEq treats two ints as equal iff they are congruent mod 10 — a deliberately
// non-default equality so a passing test proves the injected fn is actually used.
func modEq(a int, b int) bool {
	return (a - (a / 10) * 10) == (b - (b / 10) * 10)
}

// Default forwards to the key type's own lang.Comparable.Compare (== 0 is equal).
func TestDefaultUsesCompare() testing.TestResult {
	var e Default[int]
	if !e.Equal(5, 5) {
		return fail("Default[int].Equal(5,5) should be true")
	}
	if e.Equal(5, 6) {
		return fail("Default[int].Equal(5,6) should be false")
	}
	return ""
}

// FnEq routes each comparison through the injected function.
func TestFnEqCallsFn() testing.TestResult {
	var e FnEq[int] = Fn[int](modEq)
	if !e.Equal(3, 13) {
		return fail("FnEq(modEq).Equal(3,13) should be true (3 == 13 mod 10)")
	}
	if e.Equal(3, 4) {
		return fail("FnEq(modEq).Equal(3,4) should be false")
	}
	return ""
}

// Both adapters satisfy Eq[K] as a monomorphized policy type argument.
func TestEqAsPolicy() testing.TestResult {
	var d Default[int]
	if !equalVia[int, Default[int]](d, 8, 8) {
		return fail("Default should work as an Eq policy")
	}
	var e FnEq[int] = Fn[int](modEq)
	if !equalVia[int, FnEq[int]](e, 7, 17) {
		return fail("FnEq should work as an Eq policy")
	}
	return ""
}
