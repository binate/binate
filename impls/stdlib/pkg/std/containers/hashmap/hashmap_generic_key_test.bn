package "pkg/std/containers/hashmap"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// gkey is a generic key type.  Its instances are lang.Hashable through the
// generic-receiver impl below, whose Compare takes the receiver's own
// instantiation (`Self` is gkey[T]).  Hash and Compare use only k, so two keys
// that differ only in tag are the same key; a tag of @cell makes moving a key
// refcount.
type gkey[T any] struct {
	k   int
	tag T
}

func (a gkey[T]) Hash() uint { return cast(uint, a.k) }

func (a gkey[T]) Compare(b gkey[T]) int {
	if a.k < b.k { return -1 }
	if a.k > b.k { return 1 }
	return 0
}

impl gkey[T] : lang.Hashable

// A map keyed by an instance of a generic type puts, overwrites, gets and
// removes as one keyed by int does, through growth.
func TestGenericKey() testing.TestResult {
	var m @Map[gkey[@cell], int] = New[gkey[@cell], int]()
	for i := 0; i < 20; i++ {
		m.Put(gkey[@cell]{k: i, tag: makeCell(i)}, i * 10)
	}
	if m.Len() != 20 { return fail("expected len 20") }
	// The same k with another tag is the same key, so its value is overwritten.
	m.Put(gkey[@cell]{k: 7, tag: makeCell(99)}, 700)
	if m.Len() != 20 { return fail("an equal key should overwrite, not add") }
	var v int
	var ok bool
	v, ok = m.Get(gkey[@cell]{k: 7})
	if !ok || v != 700 { return fail("expected 7 -> 700") }
	v, ok = m.Get(gkey[@cell]{k: 19})
	if !ok || v != 190 { return fail("expected 19 -> 190") }
	if !m.Remove(gkey[@cell]{k: 3}) { return fail("expected to remove 3") }
	if m.Has(gkey[@cell]{k: 3}) { return fail("3 should be gone") }
	if m.Len() != 19 { return fail("expected len 19 after a remove") }
	return ""
}
