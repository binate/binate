package "pkg/std/debug"

// Callers forwards directly to the _stack_frames intrinsic.  There is no offset
// adjustment: the intrinsic records the caller chain of THIS (enclosing) frame,
// so Callers' own frame is not captured and skip=0 already selects Callers'
// caller.  See debug.bni for the full contract.
func Callers(skip int, into *[]Frame) int {
	return _stack_frames(skip, into)
}

// Caller captures a single frame at `skip` into a one-element local buffer and
// returns it.  A zero return depth means the requested frame is past the top of
// the stack, reported as (zero Frame, false).
func Caller(skip int) (Frame, bool) {
	var buf [1]Frame
	var n int = _stack_frames(skip, buf[:])
	if n == 0 {
		var empty Frame
		return empty, false
	}
	return buf[0], true
}
