package "pkg/std/debug"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// captureHere is a named helper so the captured stack has a known, non-trivial
// depth (captureHere -> its caller -> the test runner ...), letting the tests
// assert a plausible minimum depth without pinning an exact count (synthetic
// wrapper frames vary by mode).  skip=0 selects captureHere itself as frame 0.
func captureHere(into *[]Frame) int {
	return Callers(0, into)
}

// validMode reports whether m is one of the two defined frame kinds.
func validMode(m int) bool {
	return m == FRAME_NATIVE || m == FRAME_VM
}

// TestCallersReturnsPlausibleDepth checks that a capture from a known call depth
// reports at least the frames we know are on the stack (captureHere and its
// caller, this test), and that frame 0 carries a valid Mode tag.
func TestCallersReturnsPlausibleDepth() testing.TestResult {
	var buf [16]Frame
	var total int = captureHere(buf[:])
	if total < 2 {
		return fail("Callers should report at least captureHere + its caller")
	}
	if !validMode(buf[0].Mode) {
		return fail("frame 0 Mode should be FRAME_NATIVE or FRAME_VM")
	}
	return ""
}

// TestCallersPopulatesFrames checks that the filled buffer entries all carry a
// valid Mode tag and that at least one entry has a nonzero Loc — robust across
// modes: a native Loc is a return address (always nonzero), and even in the VM
// (where Loc is a function index that could be 0) at least one of the several
// captured frames has a nonzero index.
func TestCallersPopulatesFrames() testing.TestResult {
	var buf [16]Frame
	var total int = captureHere(buf[:])
	var filled int = total
	if filled > len(buf) {
		filled = len(buf)
	}
	if filled < 1 {
		return fail("expected at least one captured frame")
	}
	var anyLoc bool = false
	for i := 0; i < filled; i++ {
		if !validMode(buf[i].Mode) {
			return fail("captured frame has an invalid Mode tag")
		}
		// A native frame's Loc is a code return address, which is never 0; only
		// assert per-frame for that mode (a VM function index may legitimately
		// be 0 for an early-registered function).
		if buf[i].Mode == FRAME_NATIVE && buf[i].Loc == 0 {
			return fail("native frame should carry a nonzero return address")
		}
		if buf[i].Loc != 0 {
			anyLoc = true
		}
	}
	if !anyLoc {
		return fail("no captured frame had a nonzero Loc")
	}
	return ""
}

// TestCallersReportsTotalBeyondBuffer checks the truncation contract: a buffer
// smaller than the recordable count is filled up to its length, but the return
// still reflects the full at/above-skip count (here skip=0, so the full depth),
// which exceeds the buffer — so callers can detect truncation (return > len).
func TestCallersReportsTotalBeyondBuffer() testing.TestResult {
	var small [1]Frame
	var total int = captureHere(small[:])
	if total < 2 {
		return fail("total depth should exceed a 1-slot buffer here")
	}
	if !validMode(small[0].Mode) {
		return fail("the single filled frame should carry a valid Mode")
	}
	return ""
}

// TestCallerSingle checks the Caller convenience wrapper returns a populated
// frame with ok=true when a caller exists.
func TestCallerSingle() testing.TestResult {
	var fr Frame
	var ok bool
	fr, ok = Caller(0)
	if !ok {
		return fail("Caller(0) should find this test's frame")
	}
	if !validMode(fr.Mode) {
		return fail("Caller frame should carry a valid Mode")
	}
	return ""
}

// captureTwo captures the SAME caller chain at skip=0 and skip=1 from ONE frame
// (both Callers calls share captureTwo's stack position), so skip=1 must report
// exactly one fewer frame and start one frame higher than skip=0.
func captureTwo(b0 *[]Frame, b1 *[]Frame) (int, int) {
	var n0 int = Callers(0, b0)
	var n1 int = Callers(1, b1)
	return n0, n1
}

// TestCallersSkipDropsLeadingFrame checks that skip is applied to BOTH the return
// count and the written frames (not just used to offset writes while the count
// stays the full depth): from one site, skip=1 reports one fewer recordable frame
// than skip=0, and its frame 0 equals skip=0's frame 1.
func TestCallersSkipDropsLeadingFrame() testing.TestResult {
	var b0 [16]Frame
	var b1 [16]Frame
	var n0 int = 0
	var n1 int = 0
	n0, n1 = captureTwo(b0[:], b1[:])
	if n0 < 2 {
		return fail("need at least 2 recordable frames for the skip comparison")
	}
	if n1 != n0 - 1 {
		return fail("skip=1 should report exactly one fewer recordable frame than skip=0")
	}
	if b1[0].Mode != b0[1].Mode || b1[0].Loc != b0[1].Loc {
		return fail("skip=1 frame 0 should be identical to skip=0 frame 1")
	}
	return ""
}

// TestCallerPastTopIsFalse checks Caller reports (zero Frame, false) when skip is
// past the top of the stack.  This is the count-at/above-skip contract: a one-slot
// capture returns 0 there, which is exactly Caller's false condition — the case a
// full-depth return would have wrongly reported as a valid (but unwritten) frame.
func TestCallerPastTopIsFalse() testing.TestResult {
	var fr Frame
	var ok bool
	fr, ok = Caller(100000)
	if ok {
		return fail("Caller past the top of the stack should return ok=false")
	}
	if fr.Mode != 0 || fr.Loc != 0 {
		return fail("the returned Frame should be zero when ok=false")
	}
	return ""
}
