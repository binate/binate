package "pkg/std/errors"

// withContext builds "<context>: <causeMsg>" in a freshly-allocated
// managed-slice — Wrap's construction-time rendering of one layer
// prepended to its cause.  Tier-1 packages avoid pkg/binate/buf
// (tier-2), so the join is a plain make_slice + copy, the same idiom
// strconv's Format* family uses.
func withContext(context @[]readonly char, causeMsg @[]readonly char) @[]readonly char {
	var sep *[]readonly char = ": "
	var total int = len(context) + len(sep) + len(causeMsg)
	var out @[]char = make_slice(char, total)
	var p int = 0
	for i := 0; i < len(context); i++ {
		out[p] = context[i]
		p = p + 1
	}
	for i := 0; i < len(sep); i++ {
		out[p] = sep[i]
		p = p + 1
	}
	for i := 0; i < len(causeMsg); i++ {
		out[p] = causeMsg[i]
		p = p + 1
	}
	return out
}

// errorImpl is THE error type: a fully-rendered message plus the parent
// it roots in (an empty @Error for a root, tested with `present`).  The
// "context: cause" rendering is done ONCE, at construction (by Wrap), so
// Error() just returns the stored message — a single type, no per-call
// logic, no recursive re-rendering.  The parent link is what errors.Is
// walks to give "is-a" classification.
type errorImpl struct {
	msg    @[]readonly char
	parent @Error
}

// Error returns the rendered message as a refcounted reference to the
// owned slice (no copy) — the caller gets its own reference.
func (e *errorImpl) Error() @[]readonly char {
	return e.msg
}

// Unwrap returns the parent the error roots in (empty for a root).
func (e *errorImpl) Unwrap() @Error {
	return e.parent
}

impl *errorImpl : Error

// Rooted is the single constructor: an error that renders msg and roots
// in base, so errors.Is(result, base) — and errors.Is for any ancestor
// of base — is then true.  msg is the FULL rendered message; base's
// message is not prepended here (Wrap does that before calling Rooted).
// Used to define a more-specific failure under a base (the base
// singletons below, and e.g. io.EOF under ConditionsUnmet).
func Rooted(base @Error, msg @[]readonly char) @Error {
	var e @errorImpl = make(errorImpl)
	e.msg = msg
	e.parent = base
	var ev @Error = e
	return ev
}

// New returns a fresh root error (no parent) carrying msg.  A string
// literal works directly (`errors.New("file not found")`).  New is the
// only way to make an unclassified root; the stdlib uses it solely to
// define the base singletons below (a hygiene check enforces that).
func New(msg @[]readonly char) @Error {
	var none @Error
	return Rooted(none, msg)
}

// Wrap returns an error rooting in cause whose message is
// "msg: <cause's message>".  The concatenation is computed now, at
// construction; Error() then just returns it.
func Wrap(cause @Error, msg @[]readonly char) @Error {
	return Rooted(cause, withContext(msg, cause.Error()))
}

// Is reports whether any error in err's Unwrap() lineage is the same
// error object as target — the standard classification test, e.g.
// `errors.Is(err, NotFound)` or `errors.Is(err, ConditionsUnmet)`.
// Because it walks the lineage (err, err.Unwrap(), …, stopping at the
// empty @Error a root returns) and the base singletons' parent links
// encode the hierarchy, it matches target whenever target is the error's
// category OR any ancestor of it.  The per-node comparison is reference
// identity (`same`); callers must always use Is, never `same` directly.
func Is(err @Error, target @Error) bool {
	var cur @Error = err
	for present(cur) {
		if same(cur, target) {
			return true
		}
		cur = cur.Unwrap()
	}
	return false
}

// The standard base failures, organized by caller recourse.  Every error
// the stdlib RETURNS roots in one of these; classify with errors.Is (never
// `same`), which finds a base anywhere in the lineage.
//
// Each child roots in a parent via a `Rooted(parent, ...)` call, and that
// read of `parent` is a dependency edge, so dependency-order var
// initialization runs every parent before the children that link to it —
// regardless of the declaration order below (a child reading an unset parent
// would silently misclassify).  TestBaseLineage pins the result.

// InvalidArgument: the request is prima-facie wrong; no state of the world makes it succeed.
var InvalidArgument @Error = New("invalid argument")

// Unsupported: the capability is fundamentally absent in this build/platform.
var Unsupported @Error = New("unsupported")

// ConditionsUnmet: the call is valid in principle, but current conditions don't permit it.
var ConditionsUnmet @Error = New("conditions unmet")

// PermissionDenied: the operation is actively denied (an authority withholds it).
var PermissionDenied @Error = New("permission denied")

// Retryable: an environmental impediment (capacity / throughput / availability); retry later.
var Retryable @Error = New("retryable")

// Unknown: a genuinely unclassifiable failure.
var Unknown @Error = New("unknown")

// Unimplemented (⊂ Unsupported): supportable here, just not done yet.
var Unimplemented @Error = Rooted(Unsupported, "unimplemented")

// NotFound (⊂ ConditionsUnmet): a required entity is absent.
var NotFound @Error = Rooted(ConditionsUnmet, "not found")

// AlreadyExists (⊂ ConditionsUnmet): an entity that must be absent is present.
var AlreadyExists @Error = Rooted(ConditionsUnmet, "already exists")

// OutOfRange (⊂ ConditionsUnmet): past a variable bound (e.g. reading past EOF).
var OutOfRange @Error = Rooted(ConditionsUnmet, "out of range")

// BadData (⊂ ConditionsUnmet): the input or content is malformed / corrupt.
var BadData @Error = Rooted(ConditionsUnmet, "bad data")

// ResourceExhausted (⊂ Retryable): a finite resource is used up (space, handles, memory).
var ResourceExhausted @Error = Rooted(Retryable, "resource exhausted")

// RateLimited (⊂ Retryable): a rate quota is exhausted (deliberate throttle).
var RateLimited @Error = Rooted(Retryable, "rate limited")

// Unavailable (⊂ Retryable): a needed service or device is down or unreachable.
var Unavailable @Error = Rooted(Retryable, "unavailable")
