package "pkg/std/errors"

import "pkg/builtins/testing"

// eq compares a freshly-rendered message (owned) against an expected
// literal.  Test-local helper to avoid pulling in pkg/binate/buf or
// bootstrap (mirrors strconv_test.bn's streq).
func eq(got @[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ============================================================
// New — leaf errors
// ============================================================

func TestNewMessage() testing.TestResult {
	var e @Error = New("boom")
	if !eq(e.Error(), "boom") { return fail("New(\"boom\").Error() should be \"boom\"") }
	return ""
}

// A leaf's Unwrap() is the empty @Error: present() must report false.
func TestNewUnwrapEmpty() testing.TestResult {
	var e @Error = New("boom")
	var cause @Error = e.Unwrap()
	if present(cause) { return fail("leaf Unwrap() should be empty") }
	return ""
}

// New must accept (and copy) a string literal directly.
func TestNewLiteralCopied() testing.TestResult {
	var e @Error = New("file not found")
	if !eq(e.Error(), "file not found") { return fail("literal message not preserved") }
	return ""
}

// ============================================================
// Wrap — context over a cause
// ============================================================

func TestWrapMessage() testing.TestResult {
	var werr @Error = Wrap(New("disk full"), "save")
	if !eq(werr.Error(), "save: disk full") {
		return fail("Wrap should render \"save: disk full\"")
	}
	return ""
}

// Wrap's Unwrap() returns the cause, whose own message is intact.
func TestWrapUnwrapCause() testing.TestResult {
	var cause @Error = New("disk full")
	var werr @Error = Wrap(cause, "save")
	var inner @Error = werr.Unwrap()
	if !present(inner) { return fail("wrapped Unwrap() should be present") }
	if !eq(inner.Error(), "disk full") { return fail("cause message changed") }
	return ""
}

// ============================================================
// Chain walking
// ============================================================

// A three-layer chain renders the full "top: mid: root" and walks to
// exactly three links before reaching the empty leaf-cause.
func TestChainWalk() testing.TestResult {
	var e @Error = Wrap(Wrap(New("root"), "mid"), "top")
	if !eq(e.Error(), "top: mid: root") {
		return fail("full chain should render \"top: mid: root\"")
	}
	var cur @Error = e
	var count int = 0
	for present(cur) {
		count = count + 1
		cur = cur.Unwrap()
	}
	if count != 3 { return fail("chain should have exactly 3 links") }
	return ""
}

// ============================================================
// The empty / present error value
// ============================================================

func TestPresentEmpty() testing.TestResult {
	var e @Error
	if present(e) { return fail("zero-value @Error should not be present") }
	return ""
}

// ============================================================
// The (T, @Error) error-return convention
// ============================================================

// parse returns a value and an error: an empty @Error on success, a
// leaf error on failure — the canonical errors-as-values shape.
func parse(ok bool) (int, @Error) {
	if ok {
		var none @Error
		return 42, none
	}
	return 0, New("parse failed")
}

func TestErrorReturnSuccess() testing.TestResult {
	var v int
	var err @Error
	v, err = parse(true)
	if present(err) { return fail("success should yield no error") }
	if v != 42 { return fail("success value should be 42") }
	return ""
}

func TestErrorReturnFailure() testing.TestResult {
	var v int
	var err @Error
	v, err = parse(false)
	if !present(err) { return fail("failure should yield an error") }
	if !eq(err.Error(), "parse failed") { return fail("wrong failure message") }
	_ = v
	return ""
}

// ============================================================
// Is — sentinel detection by reference identity
// ============================================================

// An error is itself; a distinct error (even with the same message) is
// not — Is compares reference identity, not the message text.
func TestIsSelfAndDistinct() testing.TestResult {
	var sentinel @Error = New("EOF")
	if !Is(sentinel, sentinel) { return fail("Is(e, e) should be true") }
	var other @Error = New("EOF")
	if Is(sentinel, other) {
		return fail("distinct errors with the same message must not be Is")
	}
	return ""
}

// Is finds the sentinel through wrapping layers, and reports false for a
// target that is not in the chain.
func TestIsThroughWrap() testing.TestResult {
	var sentinel @Error = New("sentinel")
	var wrapped @Error = Wrap(Wrap(sentinel, "mid"), "top")
	if !Is(wrapped, sentinel) {
		return fail("Is should find a wrapped sentinel")
	}
	var other @Error = New("other")
	if Is(wrapped, other) {
		return fail("Is must not match a target absent from the chain")
	}
	return ""
}

// Is involving an empty @Error (no error) is false either way.
func TestIsEmpty() testing.TestResult {
	var none @Error
	var e @Error = New("x")
	if Is(none, e) { return fail("Is(empty, e) should be false") }
	if Is(e, none) { return fail("Is(e, empty) should be false") }
	return ""
}

// ============================================================
// Base failures — lineage
// ============================================================

// Every child roots in its parent base (and a base is itself).  This also
// pins dependency-order var initialization: each child's `Rooted(parent, ...)`
// initializer reads its parent, so dependency order must run the parent first
// (regardless of declaration order); a dropped edge would read an empty parent
// and these would fail.
func TestBaseLineage() testing.TestResult {
	if !Is(Unimplemented, Unsupported) { return fail("Unimplemented roots in Unsupported") }
	if !Is(NotFound, ConditionsUnmet) { return fail("NotFound roots in ConditionsUnmet") }
	if !Is(AlreadyExists, ConditionsUnmet) { return fail("AlreadyExists roots in ConditionsUnmet") }
	if !Is(OutOfRange, ConditionsUnmet) { return fail("OutOfRange roots in ConditionsUnmet") }
	if !Is(BadData, ConditionsUnmet) { return fail("BadData roots in ConditionsUnmet") }
	if !Is(ResourceExhausted, Retryable) { return fail("ResourceExhausted roots in Retryable") }
	if !Is(RateLimited, Retryable) { return fail("RateLimited roots in Retryable") }
	if !Is(Unavailable, Retryable) { return fail("Unavailable roots in Retryable") }
	if !Is(NotFound, NotFound) { return fail("a base is itself") }
	return ""
}

// The axes are disjoint and ancestry is one-directional: a parent is not
// a child, and unrelated bases don't match.
func TestBaseDisjoint() testing.TestResult {
	if Is(ConditionsUnmet, NotFound) { return fail("ConditionsUnmet is not a NotFound") }
	if Is(NotFound, Retryable) { return fail("NotFound is not Retryable") }
	if Is(InvalidArgument, ConditionsUnmet) { return fail("InvalidArgument is its own axis") }
	if Is(Unimplemented, ConditionsUnmet) {
		return fail("Unimplemented roots in Unsupported, not ConditionsUnmet")
	}
	return ""
}

// Rooted renders its own message only — the parent link does not leak
// into the text.
func TestRootedOwnMessage() testing.TestResult {
	if !eq(NotFound.Error(), "not found") { return fail("NotFound renders own message") }
	if !eq(ConditionsUnmet.Error(), "conditions unmet") { return fail("root renders own message") }
	return ""
}

// A concrete error wrapping a base classifies as the base (and ancestors)
// and renders "context: base-message".
func TestWrappedRootsInBase() testing.TestResult {
	var e @Error = Wrap(NotFound, "open /etc/foo")
	if !Is(e, NotFound) { return fail("wrapped error is NotFound") }
	if !Is(e, ConditionsUnmet) { return fail("wrapped error is-a ConditionsUnmet") }
	if Is(e, AlreadyExists) { return fail("wrapped error is not AlreadyExists") }
	if !eq(e.Error(), "open /etc/foo: not found") { return fail("wrong rendered message") }
	return ""
}

// ============================================================
// Is over a USER-defined Error impl (not a stdlib constructor)
// ============================================================

// myLeaf is a user-shaped error with no managed fields — the shape that
// crashed the bytecode-VM leg when classified by the injected-native Is
// (plan-iface-crossmode.md).  Its Unwrap() is the empty @Error.
type myLeaf struct { tag int }

func (e @myLeaf) Error() @[]readonly char { return "leaf" }

func (e @myLeaf) Unwrap() @Error { var none @Error; return none }

impl @myLeaf : Error

// myWrap is a user-defined error carrying a managed cause (so it has a
// destructor) whose Unwrap() yields that cause — exercising Is walking a
// chain through a user impl's own Unwrap().
type myWrap struct { cause @Error }

func (e @myWrap) Error() @[]readonly char { return "wrap" }

func (e @myWrap) Unwrap() @Error { return e.cause }

impl @myWrap : Error

// Is over a user-defined Error impl: identity matches, a distinct target
// does not, and a wrapped base is found through the impl's Unwrap().
func TestIsUserDefinedImpl() testing.TestResult {
	var l @myLeaf = make(myLeaf)
	var as @Error = l
	if !Is(as, as) { return fail("Is(userLeaf, userLeaf) should be true") }
	if Is(as, New("other")) { return fail("user leaf must not match a distinct target") }

	var w @myWrap = make(myWrap)
	w.cause = NotFound
	var we @Error = w
	if !Is(we, NotFound) { return fail("Is should find a base through a user Unwrap()") }
	if !Is(we, ConditionsUnmet) { return fail("Is should find an ancestor through a user Unwrap()") }
	if Is(we, AlreadyExists) { return fail("user-wrapped base must not match a disjoint base") }
	return ""
}
