package "pkg/std/fmt"

import "pkg/builtins/lang"
import "pkg/builtins/reflect"
import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os"
import "pkg/std/strconv"
import "pkg/std/strings"

// tryStringer reports whether arg's dynamic type implements lang.Stringer, and if
// so returns its String() rendering.  The runtime interface-satisfaction assertion
// is how a formatter dispatches custom formatting on a type-erased `*any` — the
// caller uses it AFTER the built-in fast-path cases, so a `type Money int` with its
// own String() (which `case int:` cannot match — exact identity) is still honored.
func tryStringer(arg *any) (@[]char, bool) {
	var s @[]char
	var st *lang.Stringer
	var ok bool
	st, ok = arg.(*lang.Stringer)
	if !ok {
		return s, false
	}
	return st.String(), true
}

// isStringer reports whether arg's dynamic type implements lang.Stringer, without
// calling String() — for a formatting decision that only needs to know whether
// writeArg would render arg through it.
func isStringer(arg *any) bool {
	var ok bool
	_, ok = arg.(*lang.Stringer)
	return ok
}

// stringOperand returns the bytes of a string operand — a char-slice (a Binate
// "string") of any spelling, including a NAMED char-slice (`type Name @[]char`,
// a distinct dynamic type) — and ok=true; any other operand yields ok=false.  It
// classifies by the dynamic type's reflected kind (KIND_STRING) rather than by a
// type switch over spellings, so no spelling can miss.  A slice is boxed as a
// pointer to its header, whose first two words {data, len} form a raw char-slice
// view for both the raw and the managed representation; the returned view
// borrows the boxed value's storage (no allocation, no RefInc/RefDec) and is
// valid as long as arg is.  It does not consult lang.Stringer: callers that must
// honor a named string type's String() check tryStringer first.
func stringOperand(arg *any) (*[]readonly char, bool) {
	var ti *reflect.TypeInfo = reflect.TypeOf(arg)
	if ti == nil || ti.Kind != reflect.KIND_STRING {
		var none *[]readonly char
		return none, false
	}
	return bit_cast(*(*[]readonly char), reflect.DataOf(arg))[0], true
}

// isStringArg reports whether arg is a string operand (stringOperand) — used for
// Fprint's Go-style spacing rule (a space is added between two operands only when
// NEITHER is a string; a named string type counts as a string, as Go's
// reflect-Kind test does) and for the `%x` zero-pad decision.  Fprint needs the
// current operand's string-ness BEFORE it is written, to decide the leading space.
func isStringArg(arg *any) bool {
	var ok bool
	_, ok = stringOperand(arg)
	return ok
}

// writeMs writes an already-formatted managed char-slice to w.  char is uint8, so
// the slice IS a byte view; `s[0:len(s)]` takes the raw view io.Writer.Write reads
// from (a `*[]readonly uint8` after the mutable→readonly element coercion).
func writeMs(w @io.Writer, s @[]char) (int, @errors.Error) {
	return w.Write(s[0:len(s)])
}

// intOperandBuiltin classifies a BUILT-IN integer scalar (the concrete int, sized
// int8/16/32/64, uint, sized uint8/16/32, uint64 types — char is uint8), widening it
// so a single pair of strconv digit emitters serves every width.  Returns (i, u,
// signed, ok): a signed kind puts its sign-extended value in `i`; an unsigned kind
// its zero-extended value in `u`; a non-built-in-integer operand yields ok=false.
// This is the TYPE SWITCH only — no reflection — so fmt can format a built-in with
// its own strconv BEFORE considering Stringer (a built-in scalar also implements
// lang.Stringer, so %v must handle built-ins here first, not defer to their String()).
// A NAMED integer type matches no case here (it is a distinct dynamic type); intOperand
// adds the reflection fallback for those.
func intOperandBuiltin(arg *any) (int64, uint64, bool, bool) {
	switch v := arg.(type) {
	case int:
		return cast(int64, v), 0, true, true
	case int8:
		return cast(int64, v), 0, true, true
	case int16:
		return cast(int64, v), 0, true, true
	case int32:
		return cast(int64, v), 0, true, true
	case int64:
		return v, 0, true, true
	case uint:
		return 0, cast(uint64, v), false, true
	case uint8:
		return 0, cast(uint64, v), false, true
	case uint16:
		return 0, cast(uint64, v), false, true
	case uint32:
		return 0, cast(uint64, v), false, true
	case uint64:
		return 0, v, false, true
	default:
		return 0, 0, false, false
	}
}

// intOperand classifies an integer operand of ANY width — the built-in kinds
// (intOperandBuiltin) AND a NAMED integer type recovered via reflection (KIND_INT
// signed, KIND_UINT unsigned).  Used by the typed integer verbs (%d/%x/%o/%b/%c/%q,
// isIntArg, and the `*` width extractor): those render a named int NUMERICALLY,
// Stringer-independent.  Only %v/%s consult Stringer (see writeArg): the typed
// verbs render the value itself — a number, or for %q a code-compatible literal
// (`'A'`, `"text"`) — and a String() rendering is neither.  (Go differs here: it
// hex-encodes / quotes the String() text under %x/%X/%q.)
func intOperand(arg *any) (int64, uint64, bool, bool) {
	var iv int64
	var uv uint64
	var signed bool
	var ok bool
	iv, uv, signed, ok = intOperandBuiltin(arg)
	if ok {
		return iv, uv, signed, true
	}
	// A NAMED integer type matches no built-in case; recover its value via reflection.
	var rk int
	var rsize int
	var rptr *uint8
	var rok bool
	rk, rsize, rptr, rok = scalarReflect(arg)
	if rok && rk == reflect.KIND_INT {
		return readSignedField(rptr, rsize), 0, true, true
	}
	if rok && rk == reflect.KIND_UINT {
		return 0, readUnsignedField(rptr, rsize), false, true
	}
	return 0, 0, false, false
}

// writeArg formats one operand by its dynamic type and writes it to w, returning
// the byte count and any write error.  The char-slice cases write STRAIGHT through
// (no allocation — the fast path); an integer scalar of any width renders via
// intOperand + strconv; a type that implements lang.Stringer renders via its
// String(); a by-value struct without a String() renders its fields as `{…}` via
// reflection (writeStructReflect).  Anything else is a `%!?(unknown)` placeholder.
func writeArg(w @io.Writer, arg *any) (int, @errors.Error) {
	switch v := arg.(type) {
	case *[]readonly char:
		return w.Write(v)
	case *[]char:
		return w.Write(v)
	case @[]readonly char:
		return w.Write(v[0:len(v)])
	case @[]char:
		return w.Write(v[0:len(v)])
	case bool:
		return writeMs(w, strconv.FormatBool(v))
	case float64:
		return writeMs(w, strconv.FormatFloat(v, 'g', -1, 64))
	case float32:
		return writeMs(w, strconv.FormatFloat(cast(float64, v), 'g', -1, 32))
	default:
		// (1) A BUILT-IN integer scalar (int, sized ints, uint, char==uint8) formats via
		// fmt's OWN strconv.  This runs BEFORE tryStringer because a built-in scalar also
		// implements lang.Stringer — but fmt controls built-in formatting (it does not
		// defer to lang's scalar String()), matching the char-slice / bool / float cases
		// above and keeping %s of a built-in equal to %v.
		var iv int64
		var uv uint64
		var signed bool
		var isBuiltinInt bool
		iv, uv, signed, isBuiltinInt = intOperandBuiltin(arg)
		if isBuiltinInt {
			if signed {
				return writeMs(w, strconv.FormatInt(iv, 10))
			}
			return writeMs(w, strconv.FormatUint(uv, 10))
		}
		// (2) A custom String() WINS for a NAMED type / struct (Go honors Stringer under
		// %v/%s).  A `type Money int` with its own String() renders via it, not its bare
		// number.  (%d and the other typed verbs do NOT consult Stringer — they reach
		// intOperand directly — so a named int still prints numerically under %d.)
		var s @[]char
		var ok bool
		s, ok = tryStringer(arg)
		if ok {
			return writeMs(w, s)
		}
		// (3) A NAMED scalar without a String() (int/uint/float/bool) renders its value
		// via reflection — writeValue formats a scalar from (kind, size, ptr), the same
		// path a struct field's scalar uses (an integer via its width, a float in the
		// shortest-`g` form, a bool as true/false).
		var rk int
		var rsize int
		var rptr *uint8
		var rok bool
		rk, rsize, rptr, rok = scalarReflect(arg)
		if rok {
			var sctx reflectCtx
			return writeValue(w, rk, rsize, nil, rptr, sctx)
		}
		// (3b) Any other char-slice without a String() renders its text — e.g. a
		// NAMED one (`type TestResult @[]char`), a distinct dynamic type the fast
		// type switch above cannot spell.  stringOperand hands back a borrowed view,
		// exactly like those cases.
		var str *[]readonly char
		var isStr bool
		str, isStr = stringOperand(arg)
		if isStr {
			return w.Write(str)
		}
		// (4) A by-value struct without a String() renders its fields via reflection
		// (plain `%v` form, no field names; `%+v`'s named form goes through the Printf
		// path, not writeArg).  Anything else is a `%!?(unknown)` placeholder.
		var sn int
		var se @errors.Error
		var handled bool
		sn, se, handled = writeStructReflect(w, arg, false)
		if handled {
			return sn, se
		}
		return w.Write("%!?(unknown)")
	}
}

// Fprint — see fmt.bni.
func Fprint(w @io.Writer, args ...*any) (int, @errors.Error) {
	var total int = 0
	var noErr @errors.Error
	var prevStr bool = false
	for i := 0; i < len(args); i++ {
		var isStr bool = isStringArg(args[i])
		if i > 0 && !prevStr && !isStr {
			var sn int
			var se @errors.Error
			sn, se = w.Write(" ")
			total = total + sn
			if present(se) {
				return total, se
			}
		}
		var n int
		var e @errors.Error
		n, e = writeArg(w, args[i])
		total = total + n
		if present(e) {
			return total, e
		}
		prevStr = isStr
	}
	return total, noErr
}

// Fprintln — see fmt.bni.
func Fprintln(w @io.Writer, args ...*any) (int, @errors.Error) {
	var total int = 0
	for i := 0; i < len(args); i++ {
		if i > 0 {
			var sn int
			var se @errors.Error
			sn, se = w.Write(" ")
			total = total + sn
			if present(se) {
				return total, se
			}
		}
		var n int
		var e @errors.Error
		n, e = writeArg(w, args[i])
		total = total + n
		if present(e) {
			return total, e
		}
	}
	var nn int
	var ne @errors.Error
	nn, ne = w.Write("\n")
	total = total + nn
	return total, ne
}

// Sprint — see fmt.bni.
func Sprint(args ...*any) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	var w @io.Writer = b
	Fprint(w, args...)
	return b.String()
}

// Sprintln — see fmt.bni.
func Sprintln(args ...*any) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	var w @io.Writer = b
	Fprintln(w, args...)
	return b.String()
}

// Print — see fmt.bni.
func Print(args ...*any) (int, @errors.Error) {
	var w @io.Writer = os.Stdout
	return Fprint(w, args...)
}

// Println — see fmt.bni.
func Println(args ...*any) (int, @errors.Error) {
	var w @io.Writer = os.Stdout
	return Fprintln(w, args...)
}
