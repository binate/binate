package "pkg/std/fmt"

import "pkg/builtins/testing"

// `%q` quoting (fmt_printf_quote.bn).  Operands `&`-boxed for the CHECK_TOOLS
// bnlint (see fmt_printf_test.bn); expected values cross-checked against Go.

// %q double-quotes a string, escaping quote/backslash/controls; precision
// truncates the input first.
func TestSprintfQuote() testing.TestResult {
	var q *[]readonly char = "a\tb\"c\\d"
	if !sEq(Sprintf("%q", &q), "\"a\\tb\\\"c\\\\d\"") {
		return fail("Sprintf %q escaping")
	}
	var hello *[]readonly char = "hello"
	if !sEq(Sprintf("%.3q", &hello), "\"hel\"") {
		return fail("Sprintf %.3q truncate")
	}
	if !sEq(Sprintf("[%8.3q]", &hello), "[   \"hel\"]") {
		return fail("Sprintf %8.3q width+precision")
	}
	return ""
}

// %q of an integer single-quotes its byte, with C-style control escapes and \xNN
// for other non-printables.
func TestSprintfQuoteChar() testing.TestResult {
	var a int = 65
	var nl int = 10
	var bs int = 92
	if !sEq(Sprintf("%q %q %q", &a, &nl, &bs), "'A' '\\n' '\\\\'") {
		return fail("Sprintf %q of char/int")
	}
	var bell int = 7
	var esc int = 27
	if !sEq(Sprintf("%q %q", &bell, &esc), "'\\a' '\\x1b'") {
		return fail("Sprintf %q control escapes")
	}
	return ""
}
