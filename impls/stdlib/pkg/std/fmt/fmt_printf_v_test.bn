package "pkg/std/fmt"

import "pkg/builtins/testing"

// Tests for `%v` / `%+v` formatting decisions: whether a zero-padded `%v` body is a
// signed number (signAwareFor) or space-pads (zeroPadFor), and that `%+v` of a
// non-struct matches `%v` (putDefaultNamed).  Operands are `&`-boxed, as in
// fmt_printf_fields_test.bn; sgMoney, sgPoint, namedInt and ratio are declared there.

// `%v` of a number is sign-aware under zero-padding (zeros go after the sign), but a
// named int WITH a String() renders that text, whose leading `-` is content: `%08v`
// front-pads it, as Go does for Stringer output.
func TestSprintfVZeroPadStringerSign() testing.TestResult {
	var m sgMoney = -5
	if !sEq(Sprintf("%08v", &m), "000000-5") {
		return fail("%08v of a Stringer's `-5` front-pads")
	}
	var c namedInt = -5
	var i int = -5
	var f float64 = -1.5
	if !sEq(Sprintf("%08v %08v %08v", &c, &i, &f), "-0000005 -0000005 -00001.5") {
		return fail("%08v of a number zero-pads after its sign")
	}
	return ""
}

// `%08v` of a non-finite float space-pads, as `%08g` does (Go); a finite one
// zero-pads after its sign.
func TestSprintfVZeroPadNonFinite() testing.TestResult {
	var zero float64 = 0.0
	var ninf float64 = -1.0 / zero
	var pinf float64 = 1.0 / zero
	var nan float64 = zero / zero
	if !sEq(Sprintf("[%08v][%08v][%08v]", &ninf, &pinf, &nan), "[    -Inf][    +Inf][     NaN]") {
		return fail("%08v of Inf/NaN space-pads")
	}
	var r ratio = cast(ratio, ninf)
	if !sEq(Sprintf("[%08v][%08g]", &r, &ninf), "[    -Inf][    -Inf]") {
		return fail("%08v of a named float Inf space-pads, like %08g")
	}
	return ""
}

// `%+v` labels only a struct's fields; for any other operand it matches `%v`, so a
// built-in float renders in its shortest form, not through lang's String().
func TestSprintfPlusVNonStruct() testing.TestResult {
	var f float64 = 1.5
	var g float32 = 0.25
	var i int = 7
	var b bool = true
	var s *[]readonly char = "hi"
	if !sEq(Sprintf("%+v %+v %+v %+v %+v", &f, &g, &i, &b, &s), "1.5 0.25 7 true hi") {
		return fail("%+v of a built-in matches %v")
	}
	var m sgMoney = 3
	var p sgPoint
	p.n = 4
	if !sEq(Sprintf("%+v %+v", &m, &p), "3 4") {
		return fail("%+v still honors a String()")
	}
	return ""
}
