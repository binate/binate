package "pkg/std/fmt"

import "pkg/builtins/testing"

// Tests for `%v` formatting decisions: whether a zero-padded `%v` body is a signed
// number (signAwareFor).  Operands are `&`-boxed, as in fmt_printf_fields_test.bn;
// sgMoney and namedInt are declared there.

// `%v` of a number is sign-aware under zero-padding (zeros go after the sign), but a
// named int WITH a String() renders that text, whose leading `-` is content: `%08v`
// front-pads it, as Go does for Stringer output.
func TestSprintfVZeroPadStringerSign() testing.TestResult {
	var m sgMoney = -5
	if !sEq(Sprintf("%08v", &m), "000000-5") {
		return fail("%08v of a Stringer's `-5` front-pads")
	}
	var c namedInt = -5
	var i int = -5
	var f float64 = -1.5
	if !sEq(Sprintf("%08v %08v %08v", &c, &i, &f), "-0000005 -0000005 -00001.5") {
		return fail("%08v of a number zero-pads after its sign")
	}
	return ""
}
