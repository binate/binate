package "pkg/std/fmt"

import "pkg/builtins/testing"

// Tests for string operands of every spelling (stringOperand).  Every string-aware
// classifier (Fprint spacing, the `%x` zero-pad decision, `%x`/`%X`, `%q`) must
// treat a NAMED char-slice (a distinct dynamic type that misses the four plain
// type-switch cases) and an outer-`readonly` one (the `os.Args()` element type) as
// strings.  Operands are `&`-boxed, as in fmt_printf_fields_test.bn.

// soName is a named managed char-slice; soRawName a named raw one.
type soName @[]char

type soRawName *[]readonly char

// soReadonly returns a value whose static (and so boxed dynamic) type is the
// os.Args() element type, `readonly @[]readonly char`.
func soReadonly() readonly @[]readonly char {
	var m @[]char = "hi"
	return m
}

// soOperandIs reports whether stringOperand accepts arg with exactly the text want.
func soOperandIs(arg *any, want *[]readonly char) bool {
	var got *[]readonly char
	var ok bool
	got, ok = stringOperand(arg)
	return ok && sEq(got, want)
}

// stringOperand returns the text of every char-slice spelling, and rejects a
// non-string operand (a built-in int, a non-char slice).
func TestStringOperandSpellings() testing.TestResult {
	var rro *[]readonly char = "hi"
	var buf [2]char
	buf[0] = 'h'
	buf[1] = 'i'
	var rmu *[]char = buf[0:2]
	var mro @[]readonly char = "hi"
	var mmu @[]char = "hi"
	var named soName = cast(soName, mmu)
	var rawNamed soRawName = cast(soRawName, rro)
	var ro readonly @[]readonly char = soReadonly()
	if !soOperandIs(&rro, "hi") || !soOperandIs(&rmu, "hi") {
		return fail("stringOperand: raw char-slices")
	}
	if !soOperandIs(&mro, "hi") || !soOperandIs(&mmu, "hi") {
		return fail("stringOperand: managed char-slices")
	}
	if !soOperandIs(&named, "hi") || !soOperandIs(&rawNamed, "hi") {
		return fail("stringOperand: named char-slices")
	}
	if !soOperandIs(&ro, "hi") {
		return fail("stringOperand: readonly-qualified char-slice")
	}
	var n int = 7
	var ints @[]int = make_slice(int, 2)
	if isStringArg(&n) || isStringArg(&ints) {
		return fail("stringOperand: an int / a non-char slice is not a string")
	}
	return ""
}

// Fprint adds a space between two operands only when neither is a string; a named
// or `readonly` string is a string there too (Go's reflect-Kind rule).
func TestSprintSpacingWrappedStrings() testing.TestResult {
	var one int = 1
	var two int = 2
	var named soName = cast(soName, @[]char{'h', 'i'})
	var ro readonly @[]readonly char = soReadonly()
	if !sEq(Sprint(&one, &named, &two), "1hi2") {
		return fail("Sprint: no space around a named string")
	}
	if !sEq(Sprint(&one, &ro, &two), "1hi2") {
		return fail("Sprint: no space around a readonly string")
	}
	if !sEq(Sprint(&one, &two), "1 2") {
		return fail("Sprint: a space between two non-strings")
	}
	return ""
}

// `%x`/`%X` hex-encode a named / `readonly` string byte by byte (with the space and
// `#` flags), and `%08x` zero-pads it like any string.
func TestSprintfHexWrappedStrings() testing.TestResult {
	var named soName = cast(soName, @[]char{'h', 'i'})
	var ro readonly @[]readonly char = soReadonly()
	if !sEq(Sprintf("%x %X % x %#x", &named, &named, &named, &named), "6869 6869 68 69 0x6869") {
		return fail("%x/%X of a named string")
	}
	if !sEq(Sprintf("%x %X", &ro, &ro), "6869 6869") {
		return fail("%x/%X of a readonly string")
	}
	if !sEq(Sprintf("[%08x][%08x]", &named, &ro), "[00006869][00006869]") {
		return fail("%08x of a named / readonly string zero-pads")
	}
	if !sEq(Sprintf("%o", &named), "%!o(soName=hi)") {
		return fail("%o of a named string is an error verb")
	}
	return ""
}

// `%q` quotes a named / `readonly` string (precision truncates the input bytes).
func TestSprintfQuoteWrappedStrings() testing.TestResult {
	var named soName = cast(soName, @[]char{'h', 'i'})
	var ro readonly @[]readonly char = soReadonly()
	if !sEq(Sprintf("%q %q %.1q", &named, &ro, &named), "\"hi\" \"hi\" \"h\"") {
		return fail("%q of a named / readonly string")
	}
	return ""
}
