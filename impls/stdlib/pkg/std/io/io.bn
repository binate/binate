package "pkg/std/io"

import "pkg/std/errors"

// EOF is the end-of-input failure a Reader returns when no more input is
// available.  It roots in errors.ConditionsUnmet (the requested bytes
// aren't there — a condition on the stream), so errors.Is(err, io.EOF)
// tests it specifically AND errors.Is(err, errors.ConditionsUnmet) is
// also true.  Constructed once at package init (the synthetic
// pkg/std/io.__init runs before main); a process-lifetime singleton.
var EOF @errors.Error = errors.Rooted(errors.ConditionsUnmet, "EOF")

// IsEOF reports whether err is the EOF sentinel — errors.Is(err, EOF),
// so it matches EOF even through wrapping.  EOF carries no payload, so
// reference identity (what errors.Is / same test) is exactly the right
// notion of "is this EOF".
func IsEOF(err @errors.Error) bool {
	return errors.Is(err, EOF)
}
