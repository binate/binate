package "pkg/std/mapfn"

import "pkg/builtins/testing"
import "pkg/std/iter"
import "pkg/std/table"

func fail(msg @[]char) testing.TestResult { return msg }

// bnlint:allow borrowable-char-param
func byteSum(s @[]char) uint {
	var acc uint = 0
	for i := 0; i < len(s); i = i + 1 {
		acc = acc + cast(uint, s[i])
	}
	return acc
}

// bnlint:allow borrowable-char-param
func byteEq(a @[]char, b @[]char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i = i + 1 {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func mk3(a char, b char, c char) @[]char {
	var r @[]char = make_slice(char, 3)
	r[0] = a
	r[1] = b
	r[2] = c
	return r
}

// A MapFn over @[]char keys with injected byte-sum hashing / byte equality — the
// escape hatch for a key type that is not lang.Hashable.
func TestPutGetLen() testing.TestResult {
	var m @MapFn[@[]char, int] = NewMapFn[@[]char, int](byteSum, byteEq)
	m.Put(mk3('c', 'a', 't'), 1)
	m.Put(mk3('d', 'o', 'g'), 2)
	if m.Len() != 2 {
		return fail("expected len 2")
	}
	var v int
	var ok bool
	v, ok = m.Get(mk3('c', 'a', 't'))
	if !ok || v != 1 {
		return fail("expected cat -> 1")
	}
	v, ok = m.Get(mk3('d', 'o', 'g'))
	if !ok || v != 2 {
		return fail("expected dog -> 2")
	}
	if !m.Has(mk3('c', 'a', 't')) {
		return fail("expected Has(cat)")
	}
	v, ok = m.Get(mk3('z', 'z', 'z'))
	if ok {
		return fail("zzz should be absent")
	}
	return ""
}

func TestOverwriteRemove() testing.TestResult {
	var m @MapFn[@[]char, int] = NewMapFn[@[]char, int](byteSum, byteEq)
	m.Put(mk3('o', 'n', 'e'), 1)
	m.Put(mk3('o', 'n', 'e'), 11)
	if m.Len() != 1 {
		return fail("overwrite should keep len 1")
	}
	var v int
	var ok bool
	v, ok = m.Get(mk3('o', 'n', 'e'))
	if !ok || v != 11 {
		return fail("expected one -> 11")
	}
	if !m.Remove(mk3('o', 'n', 'e')) {
		return fail("Remove(one) should be true")
	}
	if m.Has(mk3('o', 'n', 'e')) {
		return fail("one should be gone")
	}
	if m.Len() != 0 {
		return fail("expected len 0")
	}
	if m.Remove(mk3('o', 'n', 'e')) {
		return fail("removing an absent key should be false")
	}
	return ""
}

// bnlint:allow borrowable-char-param
func firstCharHash(s @[]char) uint {
	if len(s) == 0 {
		return 0
	}
	return cast(uint, s[0])
}

// bnlint:allow borrowable-char-param
func firstCharEq(a @[]char, b @[]char) bool {
	if len(a) == 0 || len(b) == 0 {
		return len(a) == len(b)
	}
	return a[0] == b[0]
}

// A custom equality keyed on the FIRST char only proves the injected eq (not an
// intrinsic Compare) drives lookups: "cat" and "cow" collapse to one entry.
func TestInjectedEqCollapses() testing.TestResult {
	var m @MapFn[@[]char, int] = NewMapFn[@[]char, int](firstCharHash, firstCharEq)
	m.Put(mk3('c', 'a', 't'), 1)
	m.Put(mk3('c', 'o', 'w'), 2)
	if m.Len() != 1 {
		return fail("first-char eq should collapse c* to one entry")
	}
	var v int
	var ok bool
	v, ok = m.Get(mk3('c', 'a', 't'))
	if !ok || v != 2 {
		return fail("expected c* -> 2 (overwritten)")
	}
	return ""
}

// Growth through the wrapper preserves every entry, and the boxed iterator visits each.
func TestGrowthAndIterator() testing.TestResult {
	var m @MapFn[@[]char, int] = NewMapFn[@[]char, int](byteSum, byteEq)
	m.Put(mk3('a', 'a', 'a'), 10)
	m.Put(mk3('b', 'b', 'b'), 20)
	m.Put(mk3('c', 'c', 'c'), 30)
	m.Put(mk3('d', 'd', 'd'), 40)
	m.Put(mk3('e', 'e', 'e'), 50)
	m.Put(mk3('f', 'f', 'f'), 60)
	m.Put(mk3('g', 'g', 'g'), 70)
	if m.Len() != 7 {
		return fail("expected len 7 after growth")
	}
	var it @iter.Iterator[table.Entry[@[]char, int]] = m.AsIterator()
	var sum int = 0
	var seen int = 0
	for {
		var e table.Entry[@[]char, int]
		var ok bool
		e, ok = it.Next()
		if !ok {
			break
		}
		sum = sum + e.Val
		seen = seen + 1
	}
	if seen != 7 {
		return fail("iterator should visit 7 entries")
	}
	if sum != 280 {
		return fail("iterator value sum should be 280")
	}
	return ""
}

// Three DISTINCT keys with EQUAL byte-sums ('abc'/'bca'/'cab' all sum 294 -> slot 6)
// force the injected-fn probe-past AND drive a backward-shift Remove through the fn path.
func TestFnRemoveCollision() testing.TestResult {
	var m @MapFn[@[]char, int] = NewMapFn[@[]char, int](byteSum, byteEq)
	m.Put(mk3('a', 'b', 'c'), 1)
	m.Put(mk3('b', 'c', 'a'), 2)
	m.Put(mk3('c', 'a', 'b'), 3)
	if m.Len() != 3 {
		return fail("three distinct equal-hash keys should all be present")
	}
	if !m.Remove(mk3('b', 'c', 'a')) {
		return fail("Remove of the middle chain entry should succeed")
	}
	if m.Has(mk3('b', 'c', 'a')) {
		return fail("bca should be gone")
	}
	var v int
	var ok bool
	v, ok = m.Get(mk3('a', 'b', 'c'))
	if !ok || v != 1 {
		return fail("abc must survive")
	}
	v, ok = m.Get(mk3('c', 'a', 'b'))
	if !ok || v != 3 {
		return fail("cab must survive the backward-shift")
	}
	if m.Len() != 2 {
		return fail("expected len 2")
	}
	return ""
}

// A managed VALUE is released/updated on overwrite through the wrapper.
func TestFnManagedValue() testing.TestResult {
	var m @MapFn[@[]char, @[]char] = NewMapFn[@[]char, @[]char](byteSum, byteEq)
	m.Put(mk3('k', 'e', 'y'), mk3('v', 'a', 'l'))
	m.Put(mk3('k', 'e', 'y'), mk3('n', 'e', 'w'))
	if m.Len() != 1 {
		return fail("managed-value overwrite should keep len 1")
	}
	var v @[]char
	var ok bool
	v, ok = m.Get(mk3('k', 'e', 'y'))
	if !ok || len(v) != 3 || v[0] != 'n' {
		return fail("managed value should be updated to the new one")
	}
	return ""
}
