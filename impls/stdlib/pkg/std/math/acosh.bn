package "pkg/std/math"

// Acosh returns the inverse hyperbolic cosine of x.  Acosh(+Inf)=+Inf,
// Acosh(x) is NaN for x < 1, and Acosh(1)=0.
func Acosh(x float64) float64 {
	// special cases
	if x < 1.0 || IsNaN(x) {
		return NaN()
	}
	if x == 1.0 {
		return 0.0
	}
	if x >= invHypLarge {
		return Log(x) + Ln2 // x > 2**28
	}
	if x > 2.0 {
		return Log(2.0*x - 1.0/(x+Sqrt(x*x-1.0))) // 2**28 > x > 2
	}
	var t float64 = x - 1.0
	return Log1p(t + Sqrt(2.0*t+t*t)) // 2 >= x > 1
}
