package "pkg/std/math"

import "pkg/builtins/testing"

func TestAcosh() testing.TestResult {
	if Acosh(1.0) != 0.0 { return "Acosh(1)" }
	// Bit-exact reference values from Go's math.Acosh.
	if Float64bits(Acosh(1.5)) != 0x3FEECC2CAEC5160A { return "Acosh(1.5)" }
	if Float64bits(Acosh(2.0)) != 0x3FF5124271980434 { return "Acosh(2)" }
	if Float64bits(Acosh(3.0)) != 0x3FFC34366179D426 { return "Acosh(3)" }
	if Float64bits(Acosh(10.0)) != 0x4007F21ED1CE05D4 { return "Acosh(10)" }
	if Float64bits(Acosh(100.0)) != 0x401531738DCBC626 { return "Acosh(100)" }
	if Float64bits(Acosh(1e10)) != 0x4037B810429A7C2A { return "Acosh(1e10)" }
	return ""
}

func TestAcoshSpecials() testing.TestResult {
	if !IsNaN(Acosh(0.5)) { return "Acosh(0.5) should be NaN" }
	if !IsNaN(Acosh(-1.0)) { return "Acosh(-1) should be NaN" }
	if !IsNaN(Acosh(NaN())) { return "Acosh(NaN)" }
	if !IsInf(Acosh(Inf(1)), 1) { return "Acosh(+Inf)" }
	return ""
}
