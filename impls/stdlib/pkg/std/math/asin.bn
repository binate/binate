package "pkg/std/math"

// Asin returns the arcsine, in radians, of x.  Asin(±0)=±0, Asin(x) is NaN for
// |x| > 1.
func Asin(x float64) float64 {
	if x == 0.0 {
		return x // special case
	}
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}
	if x > 1.0 {
		return NaN() // special case
	}

	var temp float64 = Sqrt(1.0 - x * x)
	if x > 0.7 {
		temp = Pi / 2.0 - satan(temp / x)
	} else {
		temp = satan(x / temp)
	}

	if sign {
		temp = -temp
	}
	return temp
}

// Acos returns the arccosine, in radians, of x.  Acos(x) is NaN for |x| > 1.
func Acos(x float64) float64 {
	return Pi / 2.0 - Asin(x)
}
