package "pkg/std/math"

import "pkg/builtins/testing"

func TestAsin() testing.TestResult {
	if Asin(0.0) != 0.0 { return "Asin(0)" }
	// Asin is odd: Asin(-x) == -Asin(x), exactly.
	if Asin(-0.5) != -Asin(0.5) { return "Asin odd symmetry (0.5)" }
	if Asin(-0.9) != -Asin(0.9) { return "Asin odd symmetry (0.9)" }
	// Inverse of Sin: Sin(Asin(x)) ~ x for x in [-1, 1].
	if !asinClose(Sin(Asin(0.5)), 0.5) { return "Sin(Asin(0.5))" }
	if !asinClose(Sin(Asin(0.99)), 0.99) { return "Sin(Asin(0.99))" }
	if !asinClose(Sin(Asin(-0.3)), -0.3) { return "Sin(Asin(-0.3))" }
	if !asinClose(Sin(Asin(1.0)), 1.0) { return "Sin(Asin(1))" }
	return ""
}

func TestAcos() testing.TestResult {
	// Inverse of Cos: Cos(Acos(x)) ~ x for x in [-1, 1].
	if !asinClose(Cos(Acos(0.5)), 0.5) { return "Cos(Acos(0.5))" }
	if !asinClose(Cos(Acos(-0.7)), -0.7) { return "Cos(Acos(-0.7))" }
	if !asinClose(Cos(Acos(1.0)), 1.0) { return "Cos(Acos(1))" }
	// Cofunction identity: Asin(x) + Acos(x) == Pi/2.
	if !asinClose(Asin(0.4) + Acos(0.4), Pi/2.0) { return "Asin+Acos == Pi/2" }
	if !asinClose(Asin(-0.8) + Acos(-0.8), Pi/2.0) { return "Asin+Acos == Pi/2 (neg)" }
	return ""
}

func TestAsinSpecials() testing.TestResult {
	// |x| > 1 is out of domain → NaN.
	if !IsNaN(Asin(2.0)) { return "Asin(2) should be NaN" }
	if !IsNaN(Asin(-1.5)) { return "Asin(-1.5) should be NaN" }
	if !IsNaN(Asin(NaN())) { return "Asin(NaN)" }
	if !IsNaN(Acos(2.0)) { return "Acos(2) should be NaN" }
	return ""
}

// asinClose reports whether a and b are within a small absolute tolerance —
// adequate for the inverse-trig round-trip checks (a few ULPs of error).
func asinClose(a float64, b float64) bool {
	var d float64 = a - b
	if d < 0.0 { d = -d }
	return d < 1e-12
}
