package "pkg/std/math"

// Thresholds shared by the inverse-hyperbolic functions (Go's asinh/acosh/
// atanh).  Ln2 (the public constant) is reused for the large-argument arm.
const (
	invHypNearZero float64 = 3.725290298461914e-09 // 2**-28
	invHypLarge float64 = 268435456.0              // 2**28
)

// Asinh returns the inverse hyperbolic sine of x.  Asinh(±0)=±0,
// Asinh(±Inf)=±Inf, Asinh(NaN)=NaN.
func Asinh(x float64) float64 {
	// special cases
	if IsNaN(x) || IsInf(x, 0) {
		return x
	}
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}
	var temp float64 = 0.0
	if x > invHypLarge {
		temp = Log(x) + Ln2 // |x| > 2**28
	} else if x > 2.0 {
		temp = Log(2.0 * x + 1.0 / (Sqrt(x * x + 1.0) + x)) // 2**28 > |x| > 2
	} else if x < invHypNearZero {
		temp = x // |x| < 2**-28
	} else {
		temp = Log1p(x + x * x / (1.0 + Sqrt(1.0 + x * x))) // 2 > |x| > 2**-28
	}
	if sign {
		temp = -temp
	}
	return temp
}
