package "pkg/std/math"

import "pkg/builtins/testing"

func TestAsinh() testing.TestResult {
	if Asinh(0.0) != 0.0 { return "Asinh(0)" }
	// Tiny x: Asinh(x) ~ x.
	if Asinh(1e-10) != 1e-10 { return "Asinh(1e-10)" }
	// Bit-exact reference values from Go's math.Asinh.
	if Float64bits(Asinh(0.5)) != 0x3FDECC2CAEC5160A { return "Asinh(0.5)" }
	if Float64bits(Asinh(1.0)) != 0x3FEC34366179D427 { return "Asinh(1)" }
	if Float64bits(Asinh(-1.0)) != 0xBFEC34366179D427 { return "Asinh(-1)" }
	if Float64bits(Asinh(2.0)) != 0x3FF719218313D087 { return "Asinh(2)" }
	if Float64bits(Asinh(3.0)) != 0x3FFD185B507EDC0E { return "Asinh(3)" }
	if Float64bits(Asinh(100.0)) != 0x40153180A93D3C2A { return "Asinh(100)" }
	if Float64bits(Asinh(1e10)) != 0x4037B810429A7C2A { return "Asinh(1e10)" }
	return ""
}

func TestAsinhSpecials() testing.TestResult {
	if !IsInf(Asinh(Inf(1)), 1) { return "Asinh(+Inf)" }
	if !IsInf(Asinh(Inf(-1)), -1) { return "Asinh(-Inf)" }
	if !IsNaN(Asinh(NaN())) { return "Asinh(NaN)" }
	return ""
}
