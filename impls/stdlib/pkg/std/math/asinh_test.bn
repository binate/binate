package "pkg/std/math"

import "pkg/builtins/testing"

func TestAsinh() testing.TestResult {
	if Asinh(0.0) != 0.0 { return "Asinh(0)" }
	// Tiny x: Asinh(x) ~ x.
	if Asinh(1e-10) != 1e-10 { return "Asinh(1e-10)" }
	// Bit-exact reference values from Go's math.Asinh.
	if Float64bits(Asinh(0.5)) != 0x3FDECC2CAEC5160A { return "Asinh(0.5)" }
	if Float64bits(Asinh(1.0)) != 0x3FEC34366179D427 { return "Asinh(1)" }
	if Float64bits(Asinh(-1.0)) != 0xBFEC34366179D427 { return "Asinh(-1)" }
	if Float64bits(Asinh(2.0)) != 0x3FF719218313D087 { return "Asinh(2)" }
	if Float64bits(Asinh(3.0)) != 0x3FFD185B507EDC0E { return "Asinh(3)" }
	if Float64bits(Asinh(100.0)) != 0x40153180A93D3C2A { return "Asinh(100)" }
	if Float64bits(Asinh(1e10)) != 0x4037B810429A7C2A { return "Asinh(1e10)" }
	return ""
}

func TestAsinhSpecials() testing.TestResult {
	if !IsInf(Asinh(Inf(1)), 1) { return "Asinh(+Inf)" }
	if !IsInf(Asinh(Inf(-1)), -1) { return "Asinh(-Inf)" }
	if !IsNaN(Asinh(NaN())) { return "Asinh(NaN)" }
	return ""
}

func TestAcosh() testing.TestResult {
	if Acosh(1.0) != 0.0 { return "Acosh(1)" }
	if Float64bits(Acosh(1.5)) != 0x3FEECC2CAEC5160A { return "Acosh(1.5)" }
	if Float64bits(Acosh(2.0)) != 0x3FF5124271980434 { return "Acosh(2)" }
	if Float64bits(Acosh(3.0)) != 0x3FFC34366179D426 { return "Acosh(3)" }
	if Float64bits(Acosh(10.0)) != 0x4007F21ED1CE05D4 { return "Acosh(10)" }
	if Float64bits(Acosh(100.0)) != 0x401531738DCBC626 { return "Acosh(100)" }
	if Float64bits(Acosh(1e10)) != 0x4037B810429A7C2A { return "Acosh(1e10)" }
	return ""
}

func TestAcoshSpecials() testing.TestResult {
	if !IsNaN(Acosh(0.5)) { return "Acosh(0.5) should be NaN" }
	if !IsNaN(Acosh(-1.0)) { return "Acosh(-1) should be NaN" }
	if !IsNaN(Acosh(NaN())) { return "Acosh(NaN)" }
	if !IsInf(Acosh(Inf(1)), 1) { return "Acosh(+Inf)" }
	return ""
}

func TestAtanh() testing.TestResult {
	if Atanh(0.0) != 0.0 { return "Atanh(0)" }
	if Atanh(1e-10) != 1e-10 { return "Atanh(1e-10)" }
	if Float64bits(Atanh(0.5)) != 0x3FE193EA7AAD030A { return "Atanh(0.5)" }
	if Float64bits(Atanh(-0.5)) != 0xBFE193EA7AAD030A { return "Atanh(-0.5)" }
	if Float64bits(Atanh(0.3)) != 0x3FD3CF2B50617C96 { return "Atanh(0.3)" }
	if Float64bits(Atanh(0.9)) != 0x3FF78E360604B32D { return "Atanh(0.9)" }
	if Float64bits(Atanh(0.99)) != 0x40052C581997CD85 { return "Atanh(0.99)" }
	return ""
}

func TestAtanhSpecials() testing.TestResult {
	if !IsInf(Atanh(1.0), 1) { return "Atanh(1) should be +Inf" }
	if !IsInf(Atanh(-1.0), -1) { return "Atanh(-1) should be -Inf" }
	if !IsNaN(Atanh(2.0)) { return "Atanh(2) should be NaN" }
	if !IsNaN(Atanh(-2.0)) { return "Atanh(-2) should be NaN" }
	if !IsNaN(Atanh(NaN())) { return "Atanh(NaN)" }
	return ""
}
