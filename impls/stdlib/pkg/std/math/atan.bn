package "pkg/std/math"

// Coefficients and thresholds for Atan (Go's math/atan.go).
const (
	atanP0 float64 = -8.750608600031904122785e-01
	atanP1 float64 = -1.615753718733365076637e+01
	atanP2 float64 = -7.500855792314704667340e+01
	atanP3 float64 = -1.228866684490136173410e+02
	atanP4 float64 = -6.485021904942025371773e+01
	atanQ0 float64 = 2.485846490142306297962e+01
	atanQ1 float64 = 1.650270098316988542046e+02
	atanQ2 float64 = 4.328810604912902668951e+02
	atanQ3 float64 = 4.853903996359136964868e+02
	atanQ4 float64 = 1.945506571482613964425e+02
	atanMorebits float64 = 6.123233995736765886130e-17 // Pi/2 = Pio2 + Morebits
	atanTan3pio8 float64 = 2.41421356237309504880      // tan(3*Pi/8)
	atan3pio4 float64 = 2.356194490192345              // 3*Pi/4 (0x4002D97C7F3321D2)
)

// xatan evaluates atan on a reduced argument in [0, 0.66] via a rational
// minimax approximation.
func xatan(x float64) float64 {
	var z float64 = x * x
	z = z * ((((atanP0 * z + atanP1) * z + atanP2) * z + atanP3) * z + atanP4) /
			(((((z + atanQ0) * z + atanQ1) * z + atanQ2) * z + atanQ3) * z + atanQ4)
	z = x * z + x
	return z
}

// satan reduces a non-negative argument to [0, 0.66] before calling xatan.
func satan(x float64) float64 {
	if x <= 0.66 {
		return xatan(x)
	}
	if x > atanTan3pio8 {
		return Pi / 2.0 - xatan(1.0 / x) + atanMorebits
	}
	return Pi / 4.0 + xatan((x - 1.0) / (x + 1.0)) + 0.5 * atanMorebits
}

// Atan returns the arctangent, in radians, of x.  Atan(±0)=±0, Atan(±Inf)=±Pi/2.
func Atan(x float64) float64 {
	if x == 0.0 {
		return x
	}
	if x > 0.0 {
		return satan(x)
	}
	return -satan(-x)
}

// Atan2 returns the arc tangent of y/x, using the signs of the two to
// determine the quadrant of the return value.  It follows the IEEE-754
// special cases for the ±0/±Inf/NaN combinations.
func Atan2(y float64, x float64) float64 {
	// special cases
	if IsNaN(y) || IsNaN(x) {
		return NaN()
	}
	if y == 0.0 {
		if x >= 0.0 && !Signbit(x) {
			return Copysign(0.0, y)
		}
		return Copysign(Pi, y)
	}
	if x == 0.0 {
		return Copysign(Pi / 2.0, y)
	}
	if IsInf(x, 0) {
		if IsInf(x, 1) {
			if IsInf(y, 0) {
				return Copysign(Pi / 4.0, y)
			}
			return Copysign(0.0, y)
		}
		if IsInf(y, 0) {
			return Copysign(atan3pio4, y)
		}
		return Copysign(Pi, y)
	}
	if IsInf(y, 0) {
		return Copysign(Pi / 2.0, y)
	}

	// Call Atan and determine the quadrant.
	var q float64 = Atan(y / x)
	if x < 0.0 {
		if q <= 0.0 {
			return q + Pi
		}
		return q - Pi
	}
	return q
}
