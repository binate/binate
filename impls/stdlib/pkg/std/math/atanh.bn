package "pkg/std/math"

// Atanh returns the inverse hyperbolic tangent of x.  Atanh(1)=+Inf,
// Atanh(-1)=-Inf, Atanh(±0)=±0, and Atanh(x) is NaN for |x| > 1 or NaN x.
func Atanh(x float64) float64 {
	// special cases
	if x < -1.0 || x > 1.0 || IsNaN(x) {
		return NaN()
	}
	if x == 1.0 {
		return Inf(1)
	}
	if x == -1.0 {
		return Inf(-1)
	}
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}
	var temp float64 = 0.0
	if x < invHypNearZero {
		temp = x
	} else if x < 0.5 {
		temp = x + x
		temp = 0.5 * Log1p(temp+temp*x/(1.0-x))
	} else {
		temp = 0.5 * Log1p((x+x)/(1.0-x))
	}
	if sign {
		temp = -temp
	}
	return temp
}
