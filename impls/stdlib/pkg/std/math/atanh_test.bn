package "pkg/std/math"

import "pkg/builtins/testing"

func TestAtanh() testing.TestResult {
	if Atanh(0.0) != 0.0 { return "Atanh(0)" }
	// Tiny x: Atanh(x) ~ x.
	if Atanh(1e-10) != 1e-10 { return "Atanh(1e-10)" }
	// Bit-exact reference values from Go's math.Atanh.
	if Float64bits(Atanh(0.5)) != 0x3FE193EA7AAD030A { return "Atanh(0.5)" }
	if Float64bits(Atanh(-0.5)) != 0xBFE193EA7AAD030A { return "Atanh(-0.5)" }
	if Float64bits(Atanh(0.3)) != 0x3FD3CF2B50617C96 { return "Atanh(0.3)" }
	if Float64bits(Atanh(0.9)) != 0x3FF78E360604B32D { return "Atanh(0.9)" }
	if Float64bits(Atanh(0.99)) != 0x40052C581997CD85 { return "Atanh(0.99)" }
	return ""
}

func TestAtanhSpecials() testing.TestResult {
	if !IsInf(Atanh(1.0), 1) { return "Atanh(1) should be +Inf" }
	if !IsInf(Atanh(-1.0), -1) { return "Atanh(-1) should be -Inf" }
	if !IsNaN(Atanh(2.0)) { return "Atanh(2) should be NaN" }
	if !IsNaN(Atanh(-2.0)) { return "Atanh(-2) should be NaN" }
	if !IsNaN(Atanh(NaN())) { return "Atanh(NaN)" }
	return ""
}
