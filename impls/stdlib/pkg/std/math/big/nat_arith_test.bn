package "pkg/std/math/big"

import "pkg/builtins/testing"

// fail is shared with big_test.bn (same package).

// ============================================================
// Add / AddUint32
// ============================================================

func TestAddSmall() testing.TestResult {
	var s @Nat = New().Add(FromUint64(cast(uint64, 100)), FromUint64(cast(uint64, 200)))
	if s.ToUint64() != cast(uint64, 300) { return fail("100 + 200 should be 300") }
	if !s.IsUint64() { return fail("300 should be one limb") }
	return ""
}

func TestAddCarryAcrossLimb() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1) // 0xFFFFFFFF
	var s @Nat = New().Add(FromUint64(u32max), FromUint64(cast(uint64, 1)))
	if s.ToUint64() != (cast(uint64, 1) << 32) { return fail("0xFFFFFFFF + 1 should be 0x100000000") }
	if s.BitLen() != 33 { return fail("BitLen(0x100000000) should be 33") }
	return ""
}

func TestAddZero() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 42))
	if New().Add(a, New()).ToUint64() != cast(uint64, 42) { return fail("42 + 0 should be 42") }
	if New().Add(New(), a).ToUint64() != cast(uint64, 42) { return fail("0 + 42 should be 42") }
	if !New().Add(New(), New()).IsZero() { return fail("0 + 0 should be 0") }
	return ""
}

func TestAddTwoLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 5))
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 7))
	var s @Nat = New().Add(a, b)
	if s.ToUint64() != ((cast(uint64, 2) << 32) | cast(uint64, 12)) {
		return fail("(2^32+5) + (2^32+7) should be 2^33+12")
	}
	return ""
}

// z aliasing both x and y: z.Add(z, z) = 2z.
func TestAddSelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 5))
	a.Add(a, a)
	if a.ToUint64() != cast(uint64, 10) { return fail("a.Add(a, a) should double to 10") }
	return ""
}

func TestAddUint32() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	if New().AddUint32(FromUint64(u32max), cast(uint32, 1)).ToUint64() != (cast(uint64, 1) << 32) {
		return fail("0xFFFFFFFF + 1 (AddUint32) should be 0x100000000")
	}
	var a @Nat = FromUint64(cast(uint64, 42))
	if New().AddUint32(a, cast(uint32, 0)).ToUint64() != cast(uint64, 42) {
		return fail("x + 0 should be x")
	}
	if New().AddUint32(New(), cast(uint32, 7)).ToUint64() != cast(uint64, 7) {
		return fail("0 + 7 should be 7")
	}
	return ""
}

// ============================================================
// Sub
// ============================================================

func TestSubSimple() testing.TestResult {
	var d @Nat = New().Sub(FromUint64(cast(uint64, 300)), FromUint64(cast(uint64, 100)))
	if d.ToUint64() != cast(uint64, 200) { return fail("300 - 100 should be 200") }
	return ""
}

func TestSubBorrowAcrossLimb() testing.TestResult {
	// 0x100000000 - 1 = 0xFFFFFFFF, shrinking from 2 limbs to 1 (tests norm).
	var d @Nat = New().Sub(FromUint64(cast(uint64, 1) << 32), FromUint64(cast(uint64, 1)))
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	if d.ToUint64() != u32max { return fail("0x100000000 - 1 should be 0xFFFFFFFF") }
	if d.BitLen() != 32 { return fail("BitLen(0xFFFFFFFF) should be 32") }
	if !d.IsUint64() { return fail("result should be one limb after norm") }
	return ""
}

func TestSubToZero() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 12345))
	var d @Nat = New().Sub(a, a)
	if !d.IsZero() { return fail("a - a should be zero") }
	if d.BitLen() != 0 { return fail("BitLen(0) should be 0") }
	return ""
}

func TestSubTwoLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 2) << 32) | cast(uint64, 12))
	var b @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 5))
	var d @Nat = New().Sub(a, b)
	if d.ToUint64() != ((cast(uint64, 1) << 32) | cast(uint64, 7)) {
		return fail("(2^33+12) - (2^32+5) should be 2^32+7")
	}
	return ""
}

// ============================================================
// MulUint32 / Mul
// ============================================================

func TestMulUint32Small() testing.TestResult {
	if New().MulUint32(FromUint64(cast(uint64, 12)), cast(uint32, 10)).ToUint64() !=
			cast(uint64, 120) {
		return fail("12 * 10 should be 120")
	}
	return ""
}

func TestMulUint32Carry() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	var p @Nat = New().MulUint32(FromUint64(u32max), cast(uint32, 0xFFFFFFFF))
	if p.ToUint64() != cast(uint64, 0xFFFFFFFE00000001) {
		return fail("0xFFFFFFFF * 0xFFFFFFFF should be 0xFFFFFFFE00000001")
	}
	return ""
}

func TestMulUint32Zero() testing.TestResult {
	if !New().MulUint32(FromUint64(cast(uint64, 99)), cast(uint32, 0)).IsZero() {
		return fail("x * 0 should be 0")
	}
	if !New().MulUint32(New(), cast(uint32, 5)).IsZero() { return fail("0 * m should be 0") }
	return ""
}

func TestMulSmall() testing.TestResult {
	var p @Nat = New().Mul(FromUint64(cast(uint64, 1000)), FromUint64(cast(uint64, 1000)))
	if p.ToUint64() != cast(uint64, 1000000) { return fail("1000 * 1000 should be 1000000") }
	if !p.IsUint64() { return fail("1000000 should normalize to fit a uint64") }
	return ""
}

// a*a where a = 2^32+1: the product (2^64 + 2^33 + 1) is THREE limbs —
// exercises cross-limb carry/accumulation AND the >2-limb paths
// (IsUint64 false, ToUint64 dropping the high limb, BitLen across limbs).
func TestMulThreeLimb() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 1))
	var p @Nat = New().Mul(a, a)
	if p.IsUint64() { return fail("(2^32+1)^2 should NOT fit a uint64 (3 limbs)") }
	if p.BitLen() != 65 { return fail("BitLen((2^32+1)^2) should be 65") }
	// ToUint64 returns the low 64 bits = 2^33 + 1.
	if p.ToUint64() != ((cast(uint64, 2) << 32) | cast(uint64, 1)) {
		return fail("low 64 bits of (2^32+1)^2 should be 2^33+1")
	}
	return ""
}

func TestMulByZeroNat() testing.TestResult {
	if !New().Mul(FromUint64(cast(uint64, 123)), New()).IsZero() { return fail("x * 0 should be 0") }
	if !New().Mul(New(), FromUint64(cast(uint64, 123))).IsZero() { return fail("0 * x should be 0") }
	return ""
}

func TestMulIdentity() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 1) << 32) | cast(uint64, 9))
	if New().Mul(a, FromUint64(cast(uint64, 1))).ToUint64() != a.ToUint64() {
		return fail("x * 1 should be x")
	}
	return ""
}

// z aliasing both x and y: z.Mul(z, z) = z^2.
func TestMulSelfAlias() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 7))
	a.Mul(a, a)
	if a.ToUint64() != cast(uint64, 49) { return fail("a.Mul(a, a) should square to 49") }
	return ""
}

// ============================================================
// Different-length / multi-limb-ripple / aliasing coverage
// ============================================================

// Add of different-length nonzero operands — one length guard drops
// mid-loop while the other stays active (both orderings).
func TestAddDifferentLength() testing.TestResult {
	var a @Nat = FromUint64((cast(uint64, 3) << 32) | cast(uint64, 5)) // [5,3]
	var b @Nat = FromUint64(cast(uint64, 9)) // [9]
	var s @Nat = New().Add(a, b)
	if s.ToUint64() != ((cast(uint64, 3) << 32) | cast(uint64, 14)) {
		return fail("[5,3] + [9] should be [14,3]")
	}
	if !s.IsUint64() { return fail("[14,3] should fit uint64") }
	if New().Add(b, a).ToUint64() != ((cast(uint64, 3) << 32) | cast(uint64, 14)) {
		return fail("[9] + [5,3] should also be [14,3]")
	}
	return ""
}

// AddUint32 carry propagating through both limbs of a 2-limb input into
// a third limb: UINT64_MAX + 1 = 2^64.
func TestAddUint32CarryChain() testing.TestResult {
	var x @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1)) // UINT64_MAX
	var r @Nat = New().AddUint32(x, cast(uint32, 1)) // 2^64
	if r.IsUint64() { return fail("2^64 should NOT fit uint64") }
	if r.BitLen() != 65 { return fail("BitLen(2^64) should be 65") }
	if r.ToUint64() != cast(uint64, 0) { return fail("low 64 bits of 2^64 should be 0") }
	return ""
}

// Sub by a zero Nat (the inner i<bn guard is false for every limb): x - 0 = x.
func TestSubZero() testing.TestResult {
	var x @Nat = FromUint64((cast(uint64, 7) << 32) | cast(uint64, 3)) // [3,7]
	var d @Nat = New().Sub(x, New())
	if d.ToUint64() != ((cast(uint64, 7) << 32) | cast(uint64, 3)) { return fail("x - 0 should be x") }
	if d.BitLen() != 35 { return fail("BitLen([3,7]) should be 35") }
	return ""
}

// Sub borrow chaining across two boundaries (through a zero limb) into the
// high limb, then norm trims the zeroed top: 2^64 - 1 = UINT64_MAX.
func TestSubMultiLimbBorrow() testing.TestResult {
	// 2^64
	var x @Nat = New().AddUint32(FromUint64(cast(uint64, 0) - cast(uint64, 1)), cast(uint32, 1))
	// 2^64 - 1
	var d @Nat = New().Sub(x, FromUint64(cast(uint64, 1)))
	if d.ToUint64() != (cast(uint64, 0) - cast(uint64, 1)) {
		return fail("2^64 - 1 should be UINT64_MAX")
	}
	if !d.IsUint64() { return fail("UINT64_MAX should fit uint64 after norm trims the top limb") }
	if d.BitLen() != 64 { return fail("BitLen(UINT64_MAX) should be 64") }
	return ""
}

// Sub at the yi+borrow == 2^32 seam — the exact point a routing-through-int
// regression would truncate and miss a borrow: 2^64 - 0xFFFFFFFF00000001.
func TestSubBorrowBoundary() testing.TestResult {
	// 2^64
	var x @Nat = New().Add(FromUint64(cast(uint64, 0) - cast(uint64, 1)), FromUint64(cast(uint64, 1)))
	// [1,0xFFFFFFFF]
	var y @Nat = FromUint64((cast(uint64, 0xFFFFFFFF) << 32) | cast(uint64, 1))
	// 0xFFFFFFFF
	var d @Nat = New().Sub(x, y)
	if d.ToUint64() != ((cast(uint64, 1) << 32) - cast(uint64, 1)) {
		return fail("2^64 - 0xFFFFFFFF00000001 should be 0xFFFFFFFF")
	}
	if d.BitLen() != 32 { return fail("BitLen(0xFFFFFFFF) should be 32") }
	if !d.IsUint64() { return fail("0xFFFFFFFF should fit uint64") }
	return ""
}

// Mul of rectangular operands (xn != yn) with a real per-row carry and a
// surviving top carry limb: UINT64_MAX * 2 = 2^65 - 2.
func TestMulRectangularCarry() testing.TestResult {
	var x @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1)) // UINT64_MAX
	var p @Nat = New().Mul(x, FromUint64(cast(uint64, 2))) // 2^65 - 2
	if p.IsUint64() { return fail("2^65-2 should NOT fit uint64") }
	if p.BitLen() != 65 { return fail("BitLen(2^65-2) should be 65") }
	if p.ToUint64() != (cast(uint64, 0) - cast(uint64, 2)) {
		return fail("low 64 bits of 2^65-2 should be 0xFFFFFFFFFFFFFFFE")
	}
	return ""
}

// Mul rectangular where the top carry limb is zero and gets trimmed.
func TestMulRectangularTrim() testing.TestResult {
	var x @Nat = FromUint64((cast(uint64, 2) << 32) | cast(uint64, 3)) // [3,2]
	var p @Nat = New().Mul(x, FromUint64(cast(uint64, 5))) // [15,10]
	if p.ToUint64() != ((cast(uint64, 10) << 32) | cast(uint64, 15)) {
		return fail("[3,2] * 5 should be [15,10]")
	}
	if !p.IsUint64() { return fail("[15,10] should fit uint64 (top carry trimmed)") }
	return ""
}

// MulUint32 carry feeding the next input limb (multi-limb x).
func TestMulUint32CarryChain() testing.TestResult {
	var x @Nat = FromUint64(cast(uint64, 0) - cast(uint64, 1)) // UINT64_MAX
	var p @Nat = New().MulUint32(x, cast(uint32, 2)) // 2^65 - 2
	if p.IsUint64() { return fail("2^65-2 should NOT fit uint64") }
	if p.BitLen() != 65 { return fail("BitLen(2^65-2) should be 65") }
	if p.ToUint64() != (cast(uint64, 0) - cast(uint64, 2)) {
		return fail("low 64 bits of 2^65-2 should be 0xFFFFFFFFFFFFFFFE")
	}
	return ""
}

// Sub aliasing: z == x, and z == y (the y-read-before-store path).
func TestSubSelfAliasX() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 300))
	a.Sub(a, FromUint64(cast(uint64, 100)))
	if a.ToUint64() != cast(uint64, 200) { return fail("a.Sub(a, 100) should be 200") }
	return ""
}

func TestSubAliasY() testing.TestResult {
	var a @Nat = FromUint64(cast(uint64, 300))
	var b @Nat = FromUint64(cast(uint64, 100))
	b.Sub(a, b)
	if b.ToUint64() != cast(uint64, 200) { return fail("b.Sub(a, b) should be 200") }
	return ""
}

// AddUint32 aliasing (z == x), both the c!=0 and c==0 (delegates to Set) paths.
func TestAddUint32SelfAlias() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	var a @Nat = FromUint64(u32max)
	a.AddUint32(a, cast(uint32, 1))
	if a.ToUint64() != (cast(uint64, 1) << 32) {
		return fail("a.AddUint32(a, 1) should carry to 0x100000000")
	}
	var b @Nat = FromUint64(cast(uint64, 42))
	b.AddUint32(b, cast(uint32, 0))
	if b.ToUint64() != cast(uint64, 42) { return fail("b.AddUint32(b, 0) should stay 42") }
	return ""
}

// MulUint32 aliasing (z == x).
func TestMulUint32SelfAlias() testing.TestResult {
	var u32max uint64 = (cast(uint64, 1) << 32) - cast(uint64, 1)
	var a @Nat = FromUint64(u32max)
	a.MulUint32(a, cast(uint32, 0xFFFFFFFF))
	if a.ToUint64() != cast(uint64, 0xFFFFFFFE00000001) {
		return fail("a.MulUint32(a, 0xFFFFFFFF) should be 0xFFFFFFFE00000001")
	}
	return ""
}
