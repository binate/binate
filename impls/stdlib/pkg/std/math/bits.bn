package "pkg/std/math"

// IEEE 754 double special-value bit patterns and field masks (matching
// Go's math package). Unexported — internal to the package.
const (
	uvnan    uint64 = 0x7FF8000000000001  // a quiet NaN
	uvinf    uint64 = 0x7FF0000000000000  // +Inf (also the exponent mask)
	uvneginf uint64 = 0xFFF0000000000000  // -Inf
	uvone    uint64 = 0x3FF0000000000000  // 1.0
	signMask uint64 = 0x8000000000000000  // sign bit (bit 63)
	fracMask uint64 = 0x000FFFFFFFFFFFFF  // the 52 mantissa bits (1<<shift - 1)
	expMask  uint64 = 0x7FF               // the 11-bit biased exponent
	shift    uint64 = 52                  // mantissa width (64 - 11 - 1)
	bias     uint64 = 1023                // exponent bias
)

// Float64bits returns the IEEE 754 binary representation of f, with the
// sign bit of f and the result in the same bit position.
func Float64bits(f float64) uint64 {
	return bit_cast(uint64, f)
}

// Float64frombits returns the float64 with the IEEE 754 binary
// representation b — the inverse of Float64bits.
func Float64frombits(b uint64) float64 {
	return bit_cast(float64, b)
}

// Abs returns the absolute value of x.
//   Abs(±Inf) = +Inf
//   Abs(NaN)  = NaN
func Abs(x float64) float64 {
	return Float64frombits(Float64bits(x) & ~signMask)
}

// Signbit reports whether x is negative or negative zero.
func Signbit(x float64) bool {
	return (Float64bits(x) & signMask) != cast(uint64, 0)
}

// Copysign returns a value with the magnitude of f and the sign of sign.
func Copysign(f float64, sign float64) float64 {
	return Float64frombits((Float64bits(f) & ~signMask) |
		(Float64bits(sign) & signMask))
}

// NaN returns an IEEE 754 "not-a-number" value.
func NaN() float64 {
	return Float64frombits(uvnan)
}

// IsNaN reports whether f is an IEEE 754 "not-a-number" value. Tested by
// bit pattern (exponent all-ones, mantissa non-zero) rather than the
// `f != f` idiom, so it holds independent of the comparison lowering.
func IsNaN(f float64) bool {
	var b uint64 = Float64bits(f)
	var mantMask uint64 = ~(uvinf | signMask)  // 0x000FFFFFFFFFFFFF
	return (b & uvinf) == uvinf && (b & mantMask) != cast(uint64, 0)
}

// Inf returns positive infinity if sign >= 0, negative infinity if
// sign < 0.
func Inf(sign int) float64 {
	if sign >= 0 {
		return Float64frombits(uvinf)
	}
	return Float64frombits(uvneginf)
}

// IsInf reports whether f is an infinity, according to sign: sign > 0
// tests for +Inf, sign < 0 for -Inf, and sign == 0 for either.
func IsInf(f float64, sign int) bool {
	return (sign >= 0 && f > MaxFloat64) || (sign <= 0 && f < -MaxFloat64)
}
