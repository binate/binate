package "pkg/std/math"

import "pkg/builtins/testing"

// bitsEq reports whether f's IEEE 754 representation equals want.
func bitsEq(f float64, want uint64) bool {
	return Float64bits(f) == want
}

// negZero returns -0.0 (constructed via Copysign so it can't be folded
// to +0.0 by a literal-normalizing lexer).
func negZero() float64 {
	return Copysign(0.0, -1.0)
}

func TestFloat64BitsRoundTrip() testing.TestResult {
	if Float64frombits(Float64bits(2.5)) != 2.5 {
		return "frombits(bits(2.5)) should round-trip"
	}
	var piBits uint64 = cast(uint64, 0x400921FB54442D18)
	if Float64bits(Float64frombits(piBits)) != piBits {
		return "bits(frombits(pi)) should round-trip"
	}
	return ""
}

func TestAbs() testing.TestResult {
	if Abs(-3.5) != 3.5 { return "Abs(-3.5)" }
	if Abs(3.5) != 3.5 { return "Abs(3.5)" }
	if Abs(0.0) != 0.0 { return "Abs(0)" }
	if Abs(Inf(-1)) != Inf(1) { return "Abs(-Inf) should be +Inf" }
	if !IsNaN(Abs(NaN())) { return "Abs(NaN) should be NaN" }
	// Abs clears the sign of -0.0 → +0.0.
	if Signbit(Abs(negZero())) { return "Abs(-0) should be +0" }
	return ""
}

func TestSignbit() testing.TestResult {
	if !Signbit(-1.0) { return "Signbit(-1)" }
	if Signbit(1.0) { return "Signbit(1)" }
	if Signbit(0.0) { return "Signbit(+0) should be false" }
	if !Signbit(negZero()) { return "Signbit(-0) should be true" }
	if !Signbit(Inf(-1)) { return "Signbit(-Inf)" }
	if Signbit(Inf(1)) { return "Signbit(+Inf) should be false" }
	return ""
}

func TestCopysign() testing.TestResult {
	if Copysign(3.0, -1.0) != -3.0 { return "Copysign(3,-1)" }
	if Copysign(-3.0, 1.0) != 3.0 { return "Copysign(-3,1)" }
	if !Signbit(Copysign(1.0, -5.0)) { return "Copysign should take sign of arg2" }
	if Signbit(Copysign(1.0, 5.0)) { return "Copysign(+) should be positive" }
	// Magnitude comes from arg1, sign from arg2 — even for NaN/Inf sign.
	if Copysign(2.0, Inf(-1)) != -2.0 { return "Copysign magnitude" }
	return ""
}

func TestNaN() testing.TestResult {
	if !IsNaN(NaN()) { return "IsNaN(NaN())" }
	if IsNaN(1.0) { return "IsNaN(1) should be false" }
	if IsNaN(0.0) { return "IsNaN(0) should be false" }
	if IsNaN(Inf(1)) { return "IsNaN(+Inf) should be false" }
	if IsNaN(Inf(-1)) { return "IsNaN(-Inf) should be false" }
	return ""
}

func TestInf() testing.TestResult {
	if !IsInf(Inf(1), 1) { return "IsInf(+Inf, 1)" }
	if !IsInf(Inf(-1), -1) { return "IsInf(-Inf, -1)" }
	if !IsInf(Inf(1), 0) { return "IsInf(+Inf, 0) — either" }
	if !IsInf(Inf(-1), 0) { return "IsInf(-Inf, 0) — either" }
	if IsInf(Inf(1), -1) { return "IsInf(+Inf, -1) should be false" }
	if IsInf(Inf(-1), 1) { return "IsInf(-Inf, 1) should be false" }
	if IsInf(1.0, 0) { return "IsInf(1, 0) should be false" }
	if IsInf(NaN(), 0) { return "IsInf(NaN, 0) should be false" }
	if !bitsEq(Inf(1), cast(uint64, 0x7FF0000000000000)) { return "Inf(1) bits" }
	if !bitsEq(Inf(-1), cast(uint64, 0xFFF0000000000000)) { return "Inf(-1) bits" }
	return ""
}

func TestConstants() testing.TestResult {
	if !bitsEq(Pi, cast(uint64, 0x400921FB54442D18)) { return "Pi bits" }
	if !bitsEq(E, cast(uint64, 0x4005BF0A8B145769)) { return "E bits" }
	if !bitsEq(Phi, cast(uint64, 0x3FF9E3779B97F4A8)) { return "Phi bits" }
	if !bitsEq(Sqrt2, cast(uint64, 0x3FF6A09E667F3BCD)) { return "Sqrt2 bits" }
	if !bitsEq(SqrtE, cast(uint64, 0x3FFA61298E1E069C)) { return "SqrtE bits" }
	if !bitsEq(Ln2, cast(uint64, 0x3FE62E42FEFA39EF)) { return "Ln2 bits" }
	if !bitsEq(Log2E, cast(uint64, 0x3FF71547652B82FE)) { return "Log2E bits" }
	if !bitsEq(Ln10, cast(uint64, 0x40026BB1BBB55516)) { return "Ln10 bits" }
	if !bitsEq(Log10E, cast(uint64, 0x3FDBCB7B1526E50E)) { return "Log10E bits" }
	if !bitsEq(MaxFloat64, cast(uint64, 0x7FEFFFFFFFFFFFFF)) { return "MaxFloat64 bits" }
	if !bitsEq(SmallestNonzeroFloat64, cast(uint64, 1)) { return "SmallestNonzero bits" }
	// SqrtPi / SqrtPhi via tight ranges — the literal-rounding path is the
	// same one the exact-pinned constants above verify.
	if SqrtPi < 1.7724538509 || SqrtPi > 1.7724538510 { return "SqrtPi range" }
	if SqrtPhi < 1.2720196495 || SqrtPhi > 1.2720196496 { return "SqrtPhi range" }
	return ""
}
