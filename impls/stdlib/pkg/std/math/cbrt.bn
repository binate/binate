package "pkg/std/math"

// Magic constants for Cbrt, from Go's math/cbrt.go (FreeBSD fdlibm).
const (
	cbrtB1 uint64 = 715094163                   // (682-0.03306235651)*2**20
	cbrtB2 uint64 = 696219795                   // (664-0.03306235651)*2**20
	cbrtC float64 = 5.42857142857142815906e-01  // 19/35
	cbrtD float64 = -7.05306122448979611050e-01 // -864/1225
	cbrtE float64 = 1.41428571428571436819e+00  // 99/70
	cbrtF float64 = 1.60714285714285720630e+00  // 45/28
	cbrtG float64 = 3.57142857142857150787e-01  // 5/14
)

// Cbrt returns the cube root of x.
//   Cbrt(±0)   = ±0
//   Cbrt(±Inf) = ±Inf
//   Cbrt(NaN)  = NaN
//
// NOTE: Binate's shift binds LOOSER than `+` (the opposite of Go/C), so
// every `a + b<<c` / `a & b + c` here is fully parenthesized to match Go.
func Cbrt(x float64) float64 {
	if x == 0.0 || IsNaN(x) || IsInf(x, 0) {
		return x
	}
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}

	// rough cbrt to 5 bits
	var t float64 = Float64frombits((Float64bits(x) / cast(uint64, 3)) + (cbrtB1 << cast(uint64, 32)))
	if x < smallestNormal {
		// subnormal: scale up by 2**54 first
		t = 18014398509481984.0 // 2**54
		t = t * x
		t = Float64frombits((Float64bits(t) / cast(uint64, 3)) + (cbrtB2 << cast(uint64, 32)))
	}

	// new cbrt to 23 bits
	var r float64 = t * t / x
	var s float64 = cbrtC + r * t
	t = t * (cbrtG + cbrtF / (s + cbrtE + cbrtD / s))

	// chop t to 20 bits approximate result of cbrt
	t = Float64frombits(
			(Float64bits(t) & (cast(uint64, 0xFFFFFFFFC) << cast(uint64, 28))) +
					(cast(uint64, 1) << cast(uint64, 30)))

	// one Newton step to 53 bits, error < 0.667 ulp
	s = t * t // t*t is exact
	r = x / s
	var w float64 = t + t
	r = (r - t) / (w + r) // r-s is exact
	t = t + t * r

	if sign {
		t = -t
	}
	return t
}
