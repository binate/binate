package "pkg/std/math"

import "pkg/builtins/testing"

func TestCbrt() testing.TestResult {
	// Perfect cubes are exact.
	if Cbrt(8.0) != 2.0 { return "Cbrt(8)" }
	if Cbrt(27.0) != 3.0 { return "Cbrt(27)" }
	if Cbrt(64.0) != 4.0 { return "Cbrt(64)" }
	if Cbrt(1.0) != 1.0 { return "Cbrt(1)" }
	if Cbrt(1000.0) != 10.0 { return "Cbrt(1000)" }
	if Cbrt(0.125) != 0.5 { return "Cbrt(0.125)" }
	// Negative: odd function.
	if Cbrt(-8.0) != -2.0 { return "Cbrt(-8)" }
	if Cbrt(-27.0) != -3.0 { return "Cbrt(-27)" }
	// Non-cube, in range (Cbrt(2) ~ 1.2599210498948732).
	if Cbrt(2.0) < 1.2599210498948730 || Cbrt(2.0) > 1.2599210498948734 {
		return "Cbrt(2) range"
	}
	return ""
}

func TestCbrtSpecials() testing.TestResult {
	// ±0 returns the same zero (sign preserved).
	if Cbrt(0.0) != 0.0 { return "Cbrt(+0)" }
	if !Signbit(Cbrt(Copysign(0.0, -1.0))) { return "Cbrt(-0) should be -0" }
	// ±Inf pass through.
	if !IsInf(Cbrt(Inf(1)), 1) { return "Cbrt(+Inf)" }
	if !IsInf(Cbrt(Inf(-1)), -1) { return "Cbrt(-Inf)" }
	// NaN -> NaN.
	if !IsNaN(Cbrt(NaN())) { return "Cbrt(NaN)" }
	return ""
}

func TestCbrtCubeRoundTrip() testing.TestResult {
	// Cbrt(n*n*n) == n for a range of integers (exact for perfect cubes).
	var n int = 1
	for n <= 200 {
		var nf float64 = cast(float64, n)
		if Cbrt(nf*nf*nf) != nf { return "Cbrt(n^3) should be n" }
		if Cbrt(-nf*nf*nf) != -nf { return "Cbrt(-n^3) should be -n" }
		n = n + 1
	}
	return ""
}
