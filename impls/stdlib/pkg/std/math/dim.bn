package "pkg/std/math"

// Dim returns the maximum of x-y or 0.
//   Dim(+Inf, +Inf) = NaN
//   Dim(-Inf, -Inf) = NaN
//   Dim(x, NaN)     = NaN
//   Dim(NaN, x)     = NaN
func Dim(x float64, y float64) float64 {
	// The special cases result in NaN after the subtraction:
	//   +Inf - +Inf = NaN
	//   -Inf - -Inf = NaN
	//    NaN - y    = NaN
	//      x - NaN  = NaN
	var v float64 = x - y
	if v <= 0.0 {
		// v is negative or 0
		return 0.0
	}
	// v is positive or NaN
	return v
}

// Max returns the larger of x or y.
//   Max(x, +Inf) = Max(+Inf, x) = +Inf
//   Max(x, NaN)  = Max(NaN, x)  = NaN
//   Max(+0, ±0)  = Max(±0, +0)  = +0
//   Max(-0, -0)  = -0
//
// Note that this differs from the built-in max function for floating-point
// numbers: it treats NaN and ±0 specially.
func Max(x float64, y float64) float64 {
	// special cases
	if IsInf(x, 1) || IsInf(y, 1) {
		return Inf(1)
	}
	if IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	if x == 0.0 && x == y {
		if Signbit(x) {
			return y
		}
		return x
	}
	if x > y {
		return x
	}
	return y
}

// Min returns the smaller of x or y.
//   Min(x, -Inf) = Min(-Inf, x) = -Inf
//   Min(x, NaN)  = Min(NaN, x)  = NaN
//   Min(-0, ±0)  = Min(±0, -0)  = -0
//
// Note that this differs from the built-in min function for floating-point
// numbers: it treats NaN and ±0 specially.
func Min(x float64, y float64) float64 {
	// special cases
	if IsInf(x, -1) || IsInf(y, -1) {
		return Inf(-1)
	}
	if IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	if x == 0.0 && x == y {
		if Signbit(x) {
			return x
		}
		return y
	}
	if x < y {
		return x
	}
	return y
}
