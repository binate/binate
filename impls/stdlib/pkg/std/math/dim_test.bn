package "pkg/std/math"

import "pkg/builtins/testing"

func TestDim() testing.TestResult {
	if Dim(4.0, 1.5) != 2.5 { return "Dim(4, 1.5)" }
	if Dim(1.5, 4.0) != 0.0 { return "Dim(1.5, 4) should clamp to 0" }
	if Dim(3.0, 3.0) != 0.0 { return "Dim(3, 3)" }
	if Dim(-2.0, -5.0) != 3.0 { return "Dim(-2, -5)" }
	// +Inf - +Inf = NaN, and likewise -Inf - -Inf.
	if !IsNaN(Dim(Inf(1), Inf(1))) { return "Dim(+Inf, +Inf) should be NaN" }
	if !IsNaN(Dim(Inf(-1), Inf(-1))) { return "Dim(-Inf, -Inf) should be NaN" }
	// NaN propagates from either argument.
	if !IsNaN(Dim(NaN(), 1.0)) { return "Dim(NaN, 1) should be NaN" }
	if !IsNaN(Dim(1.0, NaN())) { return "Dim(1, NaN) should be NaN" }
	// +Inf - finite = +Inf; finite - +Inf = -Inf clamps to 0.
	if Dim(Inf(1), 1.0) != Inf(1) { return "Dim(+Inf, 1) should be +Inf" }
	if Dim(1.0, Inf(1)) != 0.0 { return "Dim(1, +Inf) should clamp to 0" }
	return ""
}

func TestMax() testing.TestResult {
	if Max(3.0, 2.0) != 3.0 { return "Max(3, 2)" }
	if Max(2.0, 3.0) != 3.0 { return "Max(2, 3)" }
	if Max(-3.0, -2.0) != -2.0 { return "Max(-3, -2)" }
	// +Inf dominates from either side.
	if Max(Inf(1), 5.0) != Inf(1) { return "Max(+Inf, 5) should be +Inf" }
	if Max(5.0, Inf(1)) != Inf(1) { return "Max(5, +Inf) should be +Inf" }
	if Max(Inf(1), Inf(-1)) != Inf(1) { return "Max(+Inf, -Inf) should be +Inf" }
	// -Inf loses to any finite value.
	if Max(Inf(-1), 5.0) != 5.0 { return "Max(-Inf, 5) should be 5" }
	// NaN propagates (but +Inf special-cases first).
	if !IsNaN(Max(NaN(), 5.0)) { return "Max(NaN, 5) should be NaN" }
	if !IsNaN(Max(5.0, NaN())) { return "Max(5, NaN) should be NaN" }
	if Max(Inf(1), NaN()) != Inf(1) { return "Max(+Inf, NaN) should be +Inf" }
	// ±0 sign rules: Max(-0, +0) = +0, Max(+0, -0) = +0, Max(-0, -0) = -0.
	if Signbit(Max(negZero(), 0.0)) { return "Max(-0, +0) should be +0" }
	if Signbit(Max(0.0, negZero())) { return "Max(+0, -0) should be +0" }
	if !Signbit(Max(negZero(), negZero())) { return "Max(-0, -0) should be -0" }
	return ""
}

func TestMin() testing.TestResult {
	if Min(3.0, 2.0) != 2.0 { return "Min(3, 2)" }
	if Min(2.0, 3.0) != 2.0 { return "Min(2, 3)" }
	if Min(-3.0, -2.0) != -3.0 { return "Min(-3, -2)" }
	// -Inf dominates from either side.
	if Min(Inf(-1), 5.0) != Inf(-1) { return "Min(-Inf, 5) should be -Inf" }
	if Min(5.0, Inf(-1)) != Inf(-1) { return "Min(5, -Inf) should be -Inf" }
	if Min(Inf(-1), Inf(1)) != Inf(-1) { return "Min(-Inf, +Inf) should be -Inf" }
	// +Inf loses to any finite value.
	if Min(Inf(1), 5.0) != 5.0 { return "Min(+Inf, 5) should be 5" }
	// NaN propagates (but -Inf special-cases first).
	if !IsNaN(Min(NaN(), 5.0)) { return "Min(NaN, 5) should be NaN" }
	if !IsNaN(Min(5.0, NaN())) { return "Min(5, NaN) should be NaN" }
	if Min(Inf(-1), NaN()) != Inf(-1) { return "Min(-Inf, NaN) should be -Inf" }
	// ±0 sign rules: Min(-0, +0) = -0, Min(+0, -0) = -0, Min(+0, +0) = +0.
	if !Signbit(Min(negZero(), 0.0)) { return "Min(-0, +0) should be -0" }
	if !Signbit(Min(0.0, negZero())) { return "Min(+0, -0) should be -0" }
	if Signbit(Min(0.0, 0.0)) { return "Min(+0, +0) should be +0" }
	return ""
}
