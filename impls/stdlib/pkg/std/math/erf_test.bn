package "pkg/std/math"

import "pkg/builtins/testing"

func TestErf() testing.TestResult {
	if Erf(0.0) != 0.0 { return "Erf(0)" }
	if Float64bits(Erf(Copysign(0.0, -1.0))) != 0x8000000000000000 { return "Erf(-0) should be -0" }
	// Bit-exact reference values from Go's math.Erf across the branches.
	if Float64bits(Erf(0.1)) != 0x3FBCCA5EA24FB334 { return "Erf(0.1)" }
	if Float64bits(Erf(0.5)) != 0x3FE0A7EF5C18EDD2 { return "Erf(0.5)" }
	if Float64bits(Erf(0.84375)) != 0x3FE88D1CD474A2E0 { return "Erf(0.84375) boundary" }
	if Float64bits(Erf(0.9)) != 0x3FE98045A6C8A2E6 { return "Erf(0.9)" }
	if Float64bits(Erf(1.0)) != 0x3FEAF767A741088B { return "Erf(1)" }
	if Float64bits(Erf(1.25)) != 0x3FED8865D98ABE00 { return "Erf(1.25) boundary" }
	if Float64bits(Erf(2.0)) != 0x3FEFD9AE142795E3 { return "Erf(2)" }
	if Float64bits(Erf(2.8)) != 0x3FEFFF62AF990752 { return "Erf(2.8)" }
	if Float64bits(Erf(3.0)) != 0x3FEFFFD1AC4135F9 { return "Erf(3)" }
	if Float64bits(Erf(5.0)) != 0x3FEFFFFFFFFFC9E8 { return "Erf(5)" }
	if Erf(6.0) != 1.0 { return "Erf(6) should be 1" }
	if Float64bits(Erf(-0.5)) != 0xBFE0A7EF5C18EDD2 { return "Erf(-0.5)" }
	if Erf(-6.0) != -1.0 { return "Erf(-6)" }
	return ""
}

func TestErfTiny() testing.TestResult {
	// Subnormal / very-tiny branches.
	if Float64bits(Erf(1e-300)) != 0x01A82E6D98711D3A { return "Erf(1e-300)" }
	if Float64bits(Erf(1.862645149230957e-09)) != 0x3E220DD750429B6D { return "Erf(2**-29)" }
	return ""
}

func TestErfSpecials() testing.TestResult {
	if Erf(Inf(1)) != 1.0 { return "Erf(+Inf)" }
	if Erf(Inf(-1)) != -1.0 { return "Erf(-Inf)" }
	if !IsNaN(Erf(NaN())) { return "Erf(NaN)" }
	return ""
}

func TestErfc() testing.TestResult {
	if Erfc(0.0) != 1.0 { return "Erfc(0)" }
	// Bit-exact reference values from Go's math.Erfc.
	if Float64bits(Erfc(0.1)) != 0x3FEC66B42BB6099A { return "Erfc(0.1)" }
	if Float64bits(Erfc(0.5)) != 0x3FDEB02147CE245C { return "Erfc(0.5)" }
	if Float64bits(Erfc(1.0)) != 0x3FC4226162FBDDD5 { return "Erfc(1)" }
	if Float64bits(Erfc(2.0)) != 0x3F7328F5EC350E66 { return "Erfc(2)" }
	if Float64bits(Erfc(5.0)) != 0x3D7B0C1A759F773A { return "Erfc(5)" }
	if Float64bits(Erfc(10.0)) != 0x36A7D8A7F2A8A2D0 { return "Erfc(10)" }
	if Float64bits(Erfc(-1.0)) != 0x3FFD7BB3D3A08445 { return "Erfc(-1)" }
	if Erfc(28.0) != 0.0 { return "Erfc(28) should be 0" }
	if Erfc(-6.0) != 2.0 { return "Erfc(-6) should be 2" }
	return ""
}

func TestErfcSpecials() testing.TestResult {
	if Erfc(Inf(1)) != 0.0 { return "Erfc(+Inf)" }
	if Erfc(Inf(-1)) != 2.0 { return "Erfc(-Inf)" }
	if !IsNaN(Erfc(NaN())) { return "Erfc(NaN)" }
	return ""
}
