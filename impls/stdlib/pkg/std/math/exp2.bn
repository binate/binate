package "pkg/std/math"

// Overflow/underflow thresholds for Exp2 (Go's math/exp.go).
const (
	exp2Overflow  float64 = 1.0239999999999999e+03
	exp2Underflow float64 = -1.0740e+03
)

// Exp2 returns 2**x, the base-2 exponential of x.  Special cases are as for
// Exp: Exp2(+Inf)=+Inf, Exp2(NaN)=NaN; large x overflows to +Inf, very
// negative x underflows to 0.
func Exp2(x float64) float64 {
	// special cases
	if IsNaN(x) {
		return x
	}
	if x > exp2Overflow { // handles +Inf
		return Inf(1)
	}
	if x < exp2Underflow { // handles -Inf
		return 0.0
	}

	// argument reduction: x = k + r with |r| <= 1/2, then 2**x = 2**k * e**(r*ln2).
	var k int = 0
	if x > 0.0 {
		k = cast(int, x+0.5)
	} else if x < 0.0 {
		k = cast(int, x-0.5)
	}
	var t float64 = x - cast(float64, k)
	var hi float64 = t * expLn2Hi
	var lo float64 = -t * expLn2Lo
	return expmulti(hi, lo, k)
}
