package "pkg/std/math"

import "pkg/builtins/testing"

func TestExp2() testing.TestResult {
	// Exact powers of two.
	if Exp2(0.0) != 1.0 { return "Exp2(0)" }
	if Exp2(1.0) != 2.0 { return "Exp2(1)" }
	if Exp2(2.0) != 4.0 { return "Exp2(2)" }
	if Exp2(3.0) != 8.0 { return "Exp2(3)" }
	if Exp2(10.0) != 1024.0 { return "Exp2(10)" }
	if Exp2(-1.0) != 0.5 { return "Exp2(-1)" }
	if Exp2(-2.0) != 0.25 { return "Exp2(-2)" }
	// Bit-exact reference values from Go's math.Exp2.
	if Float64bits(Exp2(0.5)) != 0x3FF6A09E667F3BCC { return "Exp2(0.5)" }
	if Float64bits(Exp2(3.3)) != 0x4023B2C47BFF8328 { return "Exp2(3.3)" }
	if Float64bits(Exp2(-3.3)) != 0x3FB9FDF8BCCE533E { return "Exp2(-3.3)" }
	// log2(1.5) -> 1.5 exactly.
	if Exp2(0.5849625007211562) != 1.5 { return "Exp2(log2 1.5)" }
	// Near the overflow edge: Exp2(1023) is finite, Exp2(1024) overflows.
	if Float64bits(Exp2(1023.0)) != 0x7FE0000000000000 { return "Exp2(1023)" }
	return ""
}

func TestExp2Specials() testing.TestResult {
	if !IsInf(Exp2(Inf(1)), 1) { return "Exp2(+Inf)" }
	if Exp2(Inf(-1)) != 0.0 { return "Exp2(-Inf)" }
	if !IsNaN(Exp2(NaN())) { return "Exp2(NaN)" }
	if !IsInf(Exp2(1024.0), 1) { return "Exp2(1024) should overflow" }
	if Exp2(-1075.0) != 0.0 { return "Exp2(-1075) should underflow" }
	return ""
}
