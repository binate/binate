package "pkg/std/math"

import "pkg/builtins/testing"

func TestExpm1() testing.TestResult {
	if Expm1(0.0) != 0.0 { return "Expm1(0)" }
	// Tiny x: Expm1(x) ~ x (the whole reason Expm1 exists).
	if Expm1(1e-20) != 1e-20 { return "Expm1(1e-20)" }
	// Bit-exact reference values from Go's math.Expm1 — exercise the primary
	// range (k==0), the |x|>0.5ln2 reduction, and both signs.
	if Float64bits(Expm1(1.0)) != 0x3FFB7E151628AED2 { return "Expm1(1)" }
	if Float64bits(Expm1(2.0)) != 0x40198E64B8D4DDAE { return "Expm1(2)" }
	if Float64bits(Expm1(-1.0)) != 0xBFE43A54E4E98864 { return "Expm1(-1)" }
	if Float64bits(Expm1(0.5)) != 0x3FE4C2531C3C0D38 { return "Expm1(0.5)" }
	if Float64bits(Expm1(-0.5)) != 0xBFD92E9A0720D3EC { return "Expm1(-0.5)" }
	if Float64bits(Expm1(1e-10)) != 0x3DDB7CDFD9DDA4E3 { return "Expm1(1e-10)" }
	if Float64bits(Expm1(-1e-10)) != 0xBDDB7CDFD9D1D693 { return "Expm1(-1e-10)" }
	if Float64bits(Expm1(0.1)) != 0x3FBAEC7B35A00D3A { return "Expm1(0.1)" }
	if Float64bits(Expm1(-0.1)) != 0xBFB85C933156A62C { return "Expm1(-0.1)" }
	return ""
}

func TestExpm1Large() testing.TestResult {
	// Larger |x| exercises the k-branch exponent arithmetic (k==1, k<20,
	// 20<=k<=56) and the k<=-2 / -56ln2 paths.
	if Float64bits(Expm1(5.0)) != 0x40626D389970338F { return "Expm1(5)" }
	if Float64bits(Expm1(10.0)) != 0x40D5825DCF950560 { return "Expm1(10)" }
	if Float64bits(Expm1(-5.0)) != 0xBFEFC8CD803FE559 { return "Expm1(-5)" }
	if Float64bits(Expm1(40.0)) != 0x438A220D397972EA { return "Expm1(40)" }
	if Float64bits(Expm1(50.0)) != 0x44719103E4080B45 { return "Expm1(50)" }
	if Float64bits(Expm1(3.3)) != 0x403A1CD5E7807B7B { return "Expm1(3.3)" }
	// |x| >= 56*ln2 on the negative side saturates at -1.
	if Expm1(-40.0) != -1.0 { return "Expm1(-40) should be -1" }
	return ""
}

func TestExpm1Specials() testing.TestResult {
	if !IsInf(Expm1(Inf(1)), 1) { return "Expm1(+Inf)" }
	if Expm1(Inf(-1)) != -1.0 { return "Expm1(-Inf) should be -1" }
	if !IsNaN(Expm1(NaN())) { return "Expm1(NaN)" }
	// |x| >= 709.78 overflows to +Inf.
	if !IsInf(Expm1(710.0), 1) { return "Expm1(710) should overflow" }
	return ""
}
