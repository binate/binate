package "pkg/std/math"

import "pkg/builtins/testing"

func TestFloor() testing.TestResult {
	if Floor(2.7) != 2.0 { return "Floor(2.7)" }
	if Floor(2.0) != 2.0 { return "Floor(2.0)" }
	if Floor(-2.1) != -3.0 { return "Floor(-2.1)" }
	if Floor(-2.0) != -2.0 { return "Floor(-2.0)" }
	if Floor(0.0) != 0.0 { return "Floor(0)" }
	if Floor(Inf(1)) != Inf(1) { return "Floor(+Inf)" }
	if Floor(Inf(-1)) != Inf(-1) { return "Floor(-Inf)" }
	if !IsNaN(Floor(NaN())) { return "Floor(NaN)" }
	// Floor(-0) is -0 (preserves sign).
	if Signbit(Copysign(0.0, -1.0)) != Signbit(Floor(Copysign(0.0, -1.0))) {
		return "Floor(-0) should be -0"
	}
	return ""
}

func TestCeil() testing.TestResult {
	if Ceil(2.1) != 3.0 { return "Ceil(2.1)" }
	if Ceil(2.0) != 2.0 { return "Ceil(2.0)" }
	if Ceil(-2.7) != -2.0 { return "Ceil(-2.7)" }
	if Ceil(0.0) != 0.0 { return "Ceil(0)" }
	if Ceil(Inf(1)) != Inf(1) { return "Ceil(+Inf)" }
	if !IsNaN(Ceil(NaN())) { return "Ceil(NaN)" }
	return ""
}

func TestTrunc() testing.TestResult {
	if Trunc(2.7) != 2.0 { return "Trunc(2.7)" }
	if Trunc(-2.7) != -2.0 { return "Trunc(-2.7)" }
	if Trunc(2.0) != 2.0 { return "Trunc(2.0)" }
	if Trunc(0.0) != 0.0 { return "Trunc(0)" }
	if Trunc(Inf(-1)) != Inf(-1) { return "Trunc(-Inf)" }
	if !IsNaN(Trunc(NaN())) { return "Trunc(NaN)" }
	return ""
}

func TestRound() testing.TestResult {
	// Ties round away from zero.
	if Round(2.5) != 3.0 { return "Round(2.5)" }
	if Round(-2.5) != -3.0 { return "Round(-2.5)" }
	if Round(0.5) != 1.0 { return "Round(0.5)" }
	if Round(-0.5) != -1.0 { return "Round(-0.5)" }
	if Round(2.4) != 2.0 { return "Round(2.4)" }
	if Round(2.6) != 3.0 { return "Round(2.6)" }
	if Round(0.49) != 0.0 { return "Round(0.49)" }
	if Round(0.0) != 0.0 { return "Round(0)" }
	if Round(Inf(1)) != Inf(1) { return "Round(+Inf)" }
	if !IsNaN(Round(NaN())) { return "Round(NaN)" }
	// Round(-0) is -0.
	if Float64bits(Round(Copysign(0.0, -1.0))) != Float64bits(Copysign(0.0, -1.0)) {
		return "Round(-0) should be -0"
	}
	return ""
}

func TestRoundToEven() testing.TestResult {
	// Ties round to the even neighbour.
	if RoundToEven(2.5) != 2.0 { return "RoundToEven(2.5)" }
	if RoundToEven(3.5) != 4.0 { return "RoundToEven(3.5)" }
	if RoundToEven(0.5) != 0.0 { return "RoundToEven(0.5)" }
	if RoundToEven(1.5) != 2.0 { return "RoundToEven(1.5)" }
	if RoundToEven(-2.5) != -2.0 { return "RoundToEven(-2.5)" }
	if RoundToEven(2.4) != 2.0 { return "RoundToEven(2.4)" }
	if RoundToEven(2.6) != 3.0 { return "RoundToEven(2.6)" }
	if RoundToEven(0.0) != 0.0 { return "RoundToEven(0)" }
	if RoundToEven(Inf(-1)) != Inf(-1) { return "RoundToEven(-Inf)" }
	if !IsNaN(RoundToEven(NaN())) { return "RoundToEven(NaN)" }
	return ""
}
