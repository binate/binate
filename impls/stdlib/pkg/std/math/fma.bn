package "pkg/std/math"

// Software fused multiply-add (Go's math/fma.go): x*y+z with a SINGLE
// rounding, via a 128-bit-wide mantissa built from the existing mul64/add64/
// leadingZeros64 helpers (trig_reduce.bn).  uvinf/fracMask/shift/bias come
// from bits.bn; expMask is the 11-bit exponent mask.  All helpers are
// lowercase + fma-prefixed; FMA itself is declared in math.bni.

// fmaZero returns 1 if x == 0, else 0.
func fmaZero(x uint64) uint64 {
	if x == cast(uint64, 0) {
		return cast(uint64, 1)
	}
	return cast(uint64, 0)
}

// fmaNonzero returns 1 if x != 0, else 0.
func fmaNonzero(x uint64) uint64 {
	if x != cast(uint64, 0) {
		return cast(uint64, 1)
	}
	return cast(uint64, 0)
}

// fmaShl shifts the two-word value (u1:u2) left by n bits.  The (64-n)/(n-64)
// shift counts are parenthesized (Binate shift binds looser than -), and rely
// on the spec's overshift-yields-0 for the out-of-range terms.
func fmaShl(u1 uint64, u2 uint64, n uint64) (uint64, uint64) {
	var r1 uint64 = (u1 << n) | (u2 >> (cast(uint64, 64) - n)) | (u2 << (n - cast(uint64, 64)))
	var r2 uint64 = u2 << n
	return r1, r2
}

// fmaShr shifts the two-word value (u1:u2) right by n bits.
func fmaShr(u1 uint64, u2 uint64, n uint64) (uint64, uint64) {
	var r2 uint64 = (u2 >> n) | (u1 << (cast(uint64, 64) - n)) | (u1 >> (n - cast(uint64, 64)))
	var r1 uint64 = u1 >> n
	return r1, r2
}

// fmaShrcompress compresses the bottom n+1 bits of (u1:u2) into a sticky bit:
// the result equals (u1:u2)>>n but its 0th bit ORs all the bits shifted out.
func fmaShrcompress(u1 uint64, u2 uint64, n uint64) (uint64, uint64) {
	if n == cast(uint64, 0) {
		return u1, u2
	}
	if n == cast(uint64, 64) {
		return cast(uint64, 0), u1 | fmaNonzero(u2)
	}
	if n >= cast(uint64, 128) {
		return cast(uint64, 0), fmaNonzero(u1 | u2)
	}
	var r1 uint64
	var r2 uint64
	if n < cast(uint64, 64) {
		r1, r2 = fmaShr(u1, u2, n)
		r2 = r2 | fmaNonzero(u2 & ((cast(uint64, 1) << n) - cast(uint64, 1)))
		return r1, r2
	}
	// 64 < n < 128
	r1, r2 = fmaShr(u1, u2, n)
	r2 = r2 | fmaNonzero((u1 & ((cast(uint64, 1) << (n - cast(uint64, 64))) - cast(uint64, 1))) | u2)
	return r1, r2
}

// fmaLz returns the number of leading zeros of the two-word value (u1:u2).
func fmaLz(u1 uint64, u2 uint64) int {
	var l int = leadingZeros64(u1)
	if l == 64 {
		l = l + leadingZeros64(u2)
	}
	return l
}

// fmaSub64 returns x - y - borrow as (diff, borrowOut), mirroring bits.Sub64
// (there is no sub64 helper in the package).
func fmaSub64(x uint64, y uint64, borrow uint64) (uint64, uint64) {
	var diff uint64 = x - y - borrow
	var borrowOut uint64 = (((~x) & y) | ((~(x ^ y)) & diff)) >> cast(uint64, 63)
	return diff, borrowOut
}

// fmaSplit splits b into sign (0/1), biased exponent, and a 53-bit mantissa
// with the implicit leading 1 restored (subnormals normalized).
func fmaSplit(b uint64) (uint64, int, uint64) {
	var sign uint64 = b >> cast(uint64, 63)
	var exp int = cast(int, (b >> shift) & expMask)
	var mantissa uint64 = b & fracMask
	if exp == 0 {
		var sh uint64 = cast(uint64, leadingZeros64(mantissa) - 11)
		mantissa = mantissa << sh
		exp = 1 - cast(int, sh)
	} else {
		mantissa = mantissa | (cast(uint64, 1) << cast(uint64, 52))
	}
	return sign, exp, mantissa
}

// FMA returns x*y + z computed with only one rounding.
func FMA(x float64, y float64, z float64) float64 {
	var bx uint64 = Float64bits(x)
	var by uint64 = Float64bits(y)
	var bz uint64 = Float64bits(z)

	// Inf/NaN/zero in x or y: at most one rounding, so the naive expression is
	// already correctly rounded.
	if x == 0.0 || y == 0.0 || (bx&uvinf) == uvinf || (by&uvinf) == uvinf {
		return x*y + z
	}
	// z == 0: x*y+0 == x*y, but +0 vs -0 of an underflowing product matters.
	if z == 0.0 {
		return x * y
	}
	// Non-finite z (x,y finite): result is exactly z.
	if (bz & uvinf) == uvinf {
		return z
	}

	// Split (sub)normal inputs into sign/exp/mantissa.
	var xs uint64
	var xe int
	var xm uint64
	xs, xe, xm = fmaSplit(bx)
	var ys uint64
	var ye int
	var ym uint64
	ys, ye, ym = fmaSplit(by)
	var zs uint64
	var ze int
	var zm uint64
	zs, ze, zm = fmaSplit(bz)

	// Product exponent ("is normal" bit not yet subtracted).
	var pe int = (xe + ye) - cast(int, bias) + 1

	// pm1:pm2 = 128-bit product mantissa, shifted so the top bit is in pm1.
	var pm1 uint64
	var pm2 uint64
	pm1, pm2 = mul64(xm<<cast(uint64, 10), ym<<cast(uint64, 11))
	var zm1 uint64 = zm << cast(uint64, 10)
	var zm2 uint64 = cast(uint64, 0)
	var ps uint64 = xs ^ ys

	// Normalize so bit 62 of pm1 is set.
	var is62zero uint64 = ((~pm1) >> cast(uint64, 62)) & cast(uint64, 1)
	pm1, pm2 = fmaShl(pm1, pm2, is62zero)
	pe = pe - cast(int, is62zero)

	// Swap so |p| >= |z|.
	if pe < ze || (pe == ze && pm1 < zm1) {
		var ts uint64 = ps
		var te int = pe
		var tm1 uint64 = pm1
		var tm2 uint64 = pm2
		ps = zs
		pe = ze
		pm1 = zm1
		pm2 = zm2
		zs = ts
		ze = te
		zm1 = tm1
		zm2 = tm2
	}

	// Exact cancellation p == -z gives +0 (neither operand is zero).
	if ps != zs && pe == ze && pm1 == zm1 && pm2 == zm2 {
		return 0.0
	}

	// Align z's significand to p's exponent.
	zm1, zm2 = fmaShrcompress(zm1, zm2, cast(uint64, pe-ze))

	var m uint64
	var c uint64
	if ps == zs {
		pm2, c = add64(pm2, zm2, cast(uint64, 0))
		pm1, _ = add64(pm1, zm1, c)
		pe = pe - cast(int, (~pm1)>>cast(uint64, 63))
		pm1, m = fmaShrcompress(pm1, pm2, cast(uint64, 64)+(pm1>>cast(uint64, 63)))
	} else {
		pm2, c = fmaSub64(pm2, zm2, cast(uint64, 0))
		pm1, _ = fmaSub64(pm1, zm1, c)
		var nz int = fmaLz(pm1, pm2)
		pe = pe - nz
		m, pm2 = fmaShl(pm1, pm2, cast(uint64, nz-1))
		m = m | fmaNonzero(pm2)
	}

	// Round, ties to even; exponent overflow -> Inf.
	if pe > 1022+cast(int, bias) ||
			(pe == 1022+cast(int, bias) &&
				((m+(cast(uint64, 1)<<cast(uint64, 9)))>>cast(uint64, 63)) == cast(uint64, 1)) {
		return Float64frombits((ps << cast(uint64, 63)) | uvinf)
	}
	if pe < 0 {
		var n uint64 = cast(uint64, -pe)
		m = (m >> n) | fmaNonzero(m & ((cast(uint64, 1) << n) - cast(uint64, 1)))
		pe = 0
	}
	// Round to nearest, ties to even; mask the result to 0 if it rounds to 0.
	m = ((m + (cast(uint64, 1) << cast(uint64, 9))) >> cast(uint64, 10)) &
		(~fmaZero((m & ((cast(uint64, 1) << cast(uint64, 10)) - cast(uint64, 1))) ^
			(cast(uint64, 1) << cast(uint64, 9))))
	// pe &= -nonzero(m): zero the exponent if the mantissa rounded to 0.
	if fmaNonzero(m) == cast(uint64, 0) {
		pe = 0
	}
	return Float64frombits((ps << cast(uint64, 63)) + (cast(uint64, pe) << cast(uint64, 52)) + m)
}
