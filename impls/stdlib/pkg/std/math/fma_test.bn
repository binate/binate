package "pkg/std/math"

import "pkg/builtins/testing"

func TestFMA() testing.TestResult {
	// Exact / simple cases.
	if FMA(2.0, 3.0, 4.0) != 10.0 { return "FMA(2,3,4)" }
	if FMA(1.0, 1.0, 1.0) != 2.0 { return "FMA(1,1,1)" }
	if FMA(3.0, 5.0, 7.0) != 22.0 { return "FMA(3,5,7)" }
	if FMA(-2.0, 3.0, 4.0) != -2.0 { return "FMA(-2,3,4)" }
	if FMA(2.0, 3.0, -6.0) != 0.0 { return "FMA(2,3,-6)" }
	if FMA(0.5, 0.5, -0.25) != 0.0 { return "FMA(0.5,0.5,-0.25)" }
	// The whole point: x*x - (correctly-rounded x*x) is exactly representable,
	// so the fused result keeps the low bits a separate x*x+z would lose.
	if Float64bits(FMA(1.0000000000000002, 1.0000000000000002, -1.0000000000000004)) !=
			0x3970000000000000 {
		return "FMA(1+ulp,1+ulp,-(1+2ulp)) single-rounding"
	}
	// Rounding ties to even.
	if FMA(1.0, 1.0, Float64frombits(0x3CA0000000000000)) != 1.0 { return "FMA(1,1,2**-53) tie->even" }
	if Float64bits(FMA(1.0, 1.0000000000000002, Float64frombits(0x3C90000000000000))) !=
			0x3FF0000000000001 {
		return "FMA(1,1+ulp,2**-54)"
	}
	return ""
}

func TestFMAVectors() testing.TestResult {
	// Bit-exact reference values from Go's math.FMA.
	if Float64bits(FMA(0.1, 0.1, 0.0)) != 0x3F847AE147AE147C { return "FMA(0.1,0.1,0)" }
	if Float64bits(FMA(3.141592653589793, 2.718281828459045, 1.4142135623730951)) !=
			0x4023E86BD815BBEE {
		return "FMA(pi,e,sqrt2)"
	}
	if Float64bits(FMA(0.3, 0.3, 0.3)) != 0x3FD8F5C28F5C28F5 { return "FMA(0.3,0.3,0.3)" }
	if Float64bits(FMA(-0.3, 0.3, 0.09)) != 0x3C4EB851EB851EB8 { return "FMA(-0.3,0.3,0.09)" }
	if Float64bits(FMA(1e300, 1e-300, 3.0)) != 0x4010000000000000 { return "FMA(1e300,1e-300,3)" }
	if Float64bits(FMA(1e150, 1e150, -1.0)) != 0x7E37E43C8800759B { return "FMA(1e150,1e150,-1)" }
	return ""
}

func TestFMASubnormalOverflow() testing.TestResult {
	// Subnormal results.
	if Float64bits(FMA(SmallestNonzeroFloat64, 2.0, 0.0)) != 0x0000000000000002 {
		return "FMA(min,2,0)"
	}
	if FMA(SmallestNonzeroFloat64, SmallestNonzeroFloat64, 0.0) != 0.0 {
		return "FMA(min,min,0) underflow"
	}
	if Float64bits(FMA(2.2250738585072014e-308, 0.5, 0.0)) != 0x0008000000000000 {
		return "FMA(minNormal,0.5,0)"
	}
	// Overflow to Inf.
	if !IsInf(FMA(MaxFloat64, 2.0, 0.0), 1) { return "FMA(max,2,0) overflow" }
	if !IsInf(FMA(-MaxFloat64, MaxFloat64, 0.0), -1) { return "FMA(-max,max,0)" }
	// Underflow sign: negative tiny product + -0 -> -0.
	if Float64bits(FMA(-SmallestNonzeroFloat64, SmallestNonzeroFloat64, Copysign(0.0, -1.0))) !=
			0x8000000000000000 {
		return "FMA(-min,min,-0) -> -0"
	}
	return ""
}

func TestFMASpecials() testing.TestResult {
	if !IsInf(FMA(Inf(1), 2.0, 3.0), 1) { return "FMA(+Inf,2,3)" }
	if !IsInf(FMA(Inf(-1), 2.0, 3.0), -1) { return "FMA(-Inf,2,3)" }
	if !IsInf(FMA(2.0, 3.0, Inf(1)), 1) { return "FMA(2,3,+Inf)" }
	if !IsNaN(FMA(Inf(1), Inf(1), Inf(-1))) { return "FMA(Inf,Inf,-Inf) should be NaN" }
	if !IsNaN(FMA(Inf(1), 0.0, 3.0)) { return "FMA(Inf,0,3) should be NaN" }
	if !IsNaN(FMA(2.0, 3.0, NaN())) { return "FMA(2,3,NaN)" }
	if !IsNaN(FMA(NaN(), 2.0, 3.0)) { return "FMA(NaN,2,3)" }
	// x or y zero (finite z): exact z added.
	if FMA(0.0, 3.0, 4.0) != 4.0 { return "FMA(0,3,4)" }
	if FMA(3.0, 0.0, 4.0) != 4.0 { return "FMA(3,0,4)" }
	return ""
}
