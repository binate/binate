package "pkg/std/math"

import "pkg/builtins/testing"

func TestGammaIntegers() testing.TestResult {
	if Gamma(1.0) != 1.0 { return "Gamma(1)" }
	if Gamma(2.0) != 1.0 { return "Gamma(2)" }
	if Gamma(3.0) != 2.0 { return "Gamma(3)" }
	if Gamma(4.0) != 6.0 { return "Gamma(4)" }
	if Gamma(5.0) != 24.0 { return "Gamma(5)" }
	if Gamma(10.0) != 362880.0 { return "Gamma(10)" }
	if Float64bits(Gamma(20.0)) != 0x437B02B930689000 { return "Gamma(20)" }
	return ""
}

func TestGammaHalfInt() testing.TestResult {
	// Bit-exact reference values from Go's math.Gamma.
	if Float64bits(Gamma(0.5)) != 0x3FFC5BF891B4EF6A { return "Gamma(0.5)" }
	if Float64bits(Gamma(1.5)) != 0x3FEC5BF891B4EF6A { return "Gamma(1.5)" }
	if Float64bits(Gamma(2.5)) != 0x3FF544FA6D47B390 { return "Gamma(2.5)" }
	if Float64bits(Gamma(3.5)) != 0x400A96390899A075 { return "Gamma(3.5)" }
	if Float64bits(Gamma(2.1)) != 0x3FF0BE67F17F6812 { return "Gamma(2.1)" }
	if Float64bits(Gamma(2.9)) != 0x3FFD3CD8AE575AD8 { return "Gamma(2.9)" }
	if Float64bits(Gamma(7.3)) != 0x4093DDB1CD05EFE5 { return "Gamma(7.3)" }
	return ""
}

func TestGammaNegative() testing.TestResult {
	if Float64bits(Gamma(-0.5)) != 0xC00C5BF891B4EF6A { return "Gamma(-0.5)" }
	if Float64bits(Gamma(-1.5)) != 0x4002E7FB0BCDF4F2 { return "Gamma(-1.5)" }
	if Float64bits(Gamma(-2.5)) != 0xBFEE3FF812E32183 { return "Gamma(-2.5)" }
	return ""
}

func TestGammaTinyAndStirling() testing.TestResult {
	// Tiny x (small-argument approximation).
	if Float64bits(Gamma(1e-10)) != 0x4202A05F1FFB61DD { return "Gamma(1e-10)" }
	if Float64bits(Gamma(-1e-10)) != 0xC202A05F20049E23 { return "Gamma(-1e-10)" }
	// q > 33 Stirling path, incl. the MaxStirling boundary.
	if Float64bits(Gamma(33.0)) != 0x474956AD0AAE33A5 { return "Gamma(33)" }
	if Float64bits(Gamma(34.0)) != 0x479A21627303A542 { return "Gamma(34)" }
	if Float64bits(Gamma(143.0)) != 0x72E3BCC9487D4436 { return "Gamma(143)" }
	if Float64bits(Gamma(143.01608)) != 0x72E5603BF6EFB4DA { return "Gamma(143.01608) boundary" }
	return ""
}

func TestGammaSpecials() testing.TestResult {
	if !IsInf(Gamma(0.0), 1) { return "Gamma(0) should be +Inf" }
	if !IsInf(Gamma(Copysign(0.0, -1.0)), -1) { return "Gamma(-0) should be -Inf" }
	if !IsNaN(Gamma(-1.0)) { return "Gamma(-1) should be NaN" }
	if !IsNaN(Gamma(-10.0)) { return "Gamma(-10) should be NaN" }
	if !IsInf(Gamma(Inf(1)), 1) { return "Gamma(+Inf)" }
	if !IsNaN(Gamma(Inf(-1))) { return "Gamma(-Inf) should be NaN" }
	if !IsNaN(Gamma(NaN())) { return "Gamma(NaN)" }
	if !IsInf(Gamma(SmallestNonzeroFloat64), 1) { return "Gamma(5e-324) should be +Inf" }
	return ""
}
