package "pkg/std/math"

// Hypot returns Sqrt(p*p + q*q), taking care to avoid unnecessary
// overflow and underflow.
//   Hypot(±Inf, q) = +Inf
//   Hypot(p, ±Inf) = +Inf
//   Hypot(NaN, q)  = NaN
//   Hypot(p, NaN)  = NaN
func Hypot(p float64, q float64) float64 {
	p = Abs(p)
	q = Abs(q)
	if IsInf(p, 1) || IsInf(q, 1) {
		return Inf(1)
	}
	if IsNaN(p) || IsNaN(q) {
		return NaN()
	}
	if p < q {
		var tmp float64 = p
		p = q
		q = tmp
	}
	if p == 0.0 {
		return 0.0
	}
	q = q / p
	return p * Sqrt(1.0 + q * q)
}
