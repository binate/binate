package "pkg/std/math"

import "pkg/builtins/testing"

func TestHypot() testing.TestResult {
	if Hypot(3.0, 4.0) != 5.0 { return "Hypot(3, 4)" }
	if Hypot(4.0, 3.0) != 5.0 { return "Hypot(4, 3)" }
	if Hypot(5.0, 12.0) != 13.0 { return "Hypot(5, 12)" }
	if Hypot(-3.0, -4.0) != 5.0 { return "Hypot(-3, -4)" }
	if Hypot(0.0, 0.0) != 0.0 { return "Hypot(0, 0)" }
	if Hypot(0.0, 7.0) != 7.0 { return "Hypot(0, 7)" }
	if Hypot(7.0, 0.0) != 7.0 { return "Hypot(7, 0)" }
	return ""
}

func TestHypotSpecials() testing.TestResult {
	// ±Inf in either argument -> +Inf (even with a NaN partner).
	if !IsInf(Hypot(Inf(1), 1.0), 1) { return "Hypot(+Inf, 1)" }
	if !IsInf(Hypot(1.0, Inf(-1)), 1) { return "Hypot(1, -Inf)" }
	if !IsInf(Hypot(Inf(1), NaN()), 1) { return "Hypot(+Inf, NaN) should be +Inf" }
	// NaN (without an Inf) propagates.
	if !IsNaN(Hypot(NaN(), 1.0)) { return "Hypot(NaN, 1)" }
	if !IsNaN(Hypot(1.0, NaN())) { return "Hypot(1, NaN)" }
	return ""
}

func TestHypotNoOverflow() testing.TestResult {
	// Both squared would overflow, but Hypot scales to stay finite:
	// Hypot(x, x) == x*Sqrt(2).
	var x float64 = 1e308
	var h float64 = Hypot(x, x)
	if IsInf(h, 0) || IsNaN(h) { return "Hypot(1e308, 1e308) should be finite" }
	if h != x * Sqrt2 { return "Hypot(x, x) should be x*Sqrt2" }
	return ""
}
