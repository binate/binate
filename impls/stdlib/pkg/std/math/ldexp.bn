package "pkg/std/math"

// smallestNormal is the smallest positive normal float64 (2**-1022,
// 0x0010000000000000). Values with smaller magnitude are denormals and
// must be scaled up before their exponent field can be read directly.
const smallestNormal float64 = 2.2250738585072014e-308 // 2**-1022

// normalize scales a denormal x up into the normal range so its exponent
// can be extracted, returning the scaled value y and the exponent
// adjustment exp such that x == y * 2**exp. For normal x it is the
// identity (exp == 0).
func normalize(x float64) (float64, int) {
	if Abs(x) < smallestNormal {
		return x * 4503599627370496.0, -52 // x * 2**52
	}
	return x, 0
}

// Frexp breaks f into a normalized fraction and an integral power of two.
// It returns frac and exp satisfying f == frac * 2**exp, with the absolute
// value of frac in the interval [1/2, 1).
//   Frexp(±0)   = ±0, 0
//   Frexp(±Inf) = ±Inf, 0
//   Frexp(NaN)  = NaN, 0
func Frexp(f float64) (float64, int) {
	if f == 0.0 {
		return f, 0 // correctly return -0
	}
	if IsInf(f, 0) || IsNaN(f) {
		return f, 0
	}
	var frac float64
	var exp int
	frac, exp = normalize(f)
	var x uint64 = Float64bits(frac)
	exp = exp + cast(int, (x >> shift) & expMask) - cast(int, bias) + 1
	x = x & ~(expMask << shift)
	x = x | ((bias - cast(uint64, 1)) << shift)
	frac = Float64frombits(x)
	return frac, exp
}

// Ldexp is the inverse of Frexp. It returns frac * 2**exp.
//   Ldexp(±0, exp)   = ±0
//   Ldexp(±Inf, exp) = ±Inf
//   Ldexp(NaN, exp)  = NaN
func Ldexp(frac float64, exp int) float64 {
	if frac == 0.0 {
		return frac // correctly return -0
	}
	if IsInf(frac, 0) || IsNaN(frac) {
		return frac
	}
	var e int
	frac, e = normalize(frac)
	exp = exp + e
	var x uint64 = Float64bits(frac)
	exp = exp + cast(int, (x >> shift) & expMask) - cast(int, bias)
	if exp < -1075 {
		return Copysign(0.0, frac) // underflow
	}
	if exp > 1023 {
		// overflow
		if frac < 0.0 {
			return Inf(-1)
		}
		return Inf(1)
	}
	var m float64 = 1.0
	if exp < -1022 {
		// denormal
		exp = exp + 53
		m = 1.0 / 9007199254740992.0 // 2**-53
	}
	x = x & ~(expMask << shift)
	x = x | (cast(uint64, exp + cast(int, bias)) << shift)
	return m * Float64frombits(x)
}
