package "pkg/std/math"

import "pkg/builtins/testing"

func TestFrexp() testing.TestResult {
	var fr float64
	var e int
	fr, e = Frexp(8.0)
	if fr != 0.5 || e != 4 { return "Frexp(8) should be 0.5, 4" }
	fr, e = Frexp(1.0)
	if fr != 0.5 || e != 1 { return "Frexp(1) should be 0.5, 1" }
	fr, e = Frexp(0.5)
	if fr != 0.5 || e != 0 { return "Frexp(0.5) should be 0.5, 0" }
	fr, e = Frexp(-8.0)
	if fr != -0.5 || e != 4 { return "Frexp(-8) should be -0.5, 4" }
	return ""
}

func TestFrexpDenormal() testing.TestResult {
	// The smallest positive denormal normalizes to 0.5 * 2**-1073.
	var fr float64
	var e int
	fr, e = Frexp(SmallestNonzeroFloat64)
	if fr != 0.5 || e != -1073 { return "Frexp(smallest) should be 0.5, -1073" }
	return ""
}

func TestFrexpSpecials() testing.TestResult {
	var fr float64
	var e int
	// ±0 returns the same zero (with sign preserved) and exp 0.
	fr, e = Frexp(0.0)
	if fr != 0.0 || e != 0 { return "Frexp(+0) should be +0, 0" }
	fr, e = Frexp(Copysign(0.0, -1.0))
	if !Signbit(fr) || e != 0 { return "Frexp(-0) should be -0, 0" }
	// ±Inf and NaN pass through with exp 0.
	fr, e = Frexp(Inf(1))
	if !IsInf(fr, 1) || e != 0 { return "Frexp(+Inf) should be +Inf, 0" }
	fr, e = Frexp(Inf(-1))
	if !IsInf(fr, -1) || e != 0 { return "Frexp(-Inf) should be -Inf, 0" }
	fr, e = Frexp(NaN())
	if !IsNaN(fr) || e != 0 { return "Frexp(NaN) should be NaN, 0" }
	return ""
}

func TestLdexp() testing.TestResult {
	if Ldexp(0.5, 4) != 8.0 { return "Ldexp(0.5, 4) should be 8" }
	if Ldexp(1.0, 0) != 1.0 { return "Ldexp(1, 0) should be 1" }
	if Ldexp(0.5, 0) != 0.5 { return "Ldexp(0.5, 0) should be 0.5" }
	if Ldexp(-0.5, 4) != -8.0 { return "Ldexp(-0.5, 4) should be -8" }
	// Smallest positive denormal: 1 * 2**-1074.
	if Float64bits(Ldexp(1.0, -1074)) != cast(uint64, 1) {
		return "Ldexp(1, -1074) should be smallest denormal"
	}
	return ""
}

func TestLdexpUnderflowOverflow() testing.TestResult {
	// Underflow rounds to a zero of the same sign.
	if Ldexp(1.0, -1075) != 0.0 { return "Ldexp(1, -1075) should underflow to 0" }
	if !Signbit(Ldexp(-1.0, -1075)) { return "Ldexp(-1, -1075) should underflow to -0" }
	// Overflow saturates to ±Inf.
	if !IsInf(Ldexp(1.0, 2000), 1) { return "Ldexp(1, 2000) should be +Inf" }
	if !IsInf(Ldexp(-1.0, 2000), -1) { return "Ldexp(-1, 2000) should be -Inf" }
	return ""
}

func TestLdexpSpecials() testing.TestResult {
	// ±0 passes through with sign preserved.
	if Ldexp(0.0, 5) != 0.0 { return "Ldexp(+0, 5) should be +0" }
	if !Signbit(Ldexp(Copysign(0.0, -1.0), 5)) { return "Ldexp(-0, 5) should be -0" }
	// ±Inf and NaN pass through.
	if !IsInf(Ldexp(Inf(1), -10), 1) { return "Ldexp(+Inf, -10) should be +Inf" }
	if !IsInf(Ldexp(Inf(-1), 10), -1) { return "Ldexp(-Inf, 10) should be -Inf" }
	if !IsNaN(Ldexp(NaN(), 3)) { return "Ldexp(NaN, 3) should be NaN" }
	return ""
}

func TestLdexpDenormalResult() testing.TestResult {
	// A result in the denormal range goes through the m = 2**-53 path.
	// 1 * 2**-1023 == 0x0008000000000000.
	if Float64bits(Ldexp(1.0, -1023)) != cast(uint64, 0x0008000000000000) {
		return "Ldexp(1, -1023) bits"
	}
	return ""
}

func TestFrexpLdexpRoundTrip() testing.TestResult {
	// Ldexp(Frexp(x)) == x for finite x (Go-documented inverse relation).
	var xs @[]float64 = make_slice(float64, 6)
	xs[0] = 3.14159
	xs[1] = 8.0
	xs[2] = 0.1
	xs[3] = 1e300
	xs[4] = 1e-300
	xs[5] = SmallestNonzeroFloat64
	for i := 0; i < len(xs); i++ {
		var fr float64
		var e int
		fr, e = Frexp(xs[i])
		if Ldexp(fr, e) != xs[i] { return "Ldexp(Frexp(x)) should round-trip x" }
	}
	return ""
}
