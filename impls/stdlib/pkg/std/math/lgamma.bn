package "pkg/std/math"

// Coefficient tables for Lgamma (Go's math/lgamma.go, FreeBSD e_lgamma_r.c).
// Note Go's _lgamR[0] and _lgamV[0] are 1.0 placeholders (index 0 unused for
// those two polynomials, which start the Horner chain at "1 + y*(...[1]+...)").

// lgamA: 12-coefficient even/odd polynomial, used for branch i==0 (x near 1/2).
var lgamA [12]float64 = [12]float64{
		7.72156649015328655494e-02, 3.22467033424113591611e-01, 6.73523010531292681824e-02,
		2.05808084325167332806e-02, 7.38555086081402883957e-03, 2.89051383673415629091e-03,
		1.19270763183362067845e-03, 5.10069792153511336608e-04, 2.20862790713908385557e-04,
		1.08011567247583939954e-04, 2.52144565451257326939e-05, 4.48640949618915160150e-05}

// lgamR: denominator poly for the 2<=x<8 rational; lgamR[0]=1.0 placeholder.
var lgamR [7]float64 = [7]float64{
		1.0, 1.39200533467621045958e+00, 7.21935547567138069525e-01, 1.71933865632803078993e-01,
		1.86459191715652901344e-02, 7.77942496381893596434e-04, 7.32668430744625636189e-06}

// lgamS: numerator poly for the 2<=x<8 rational.
var lgamS [7]float64 = [7]float64{
		-7.72156649015328655494e-02, 2.14982415960608852501e-01, 3.25778796408930981787e-01,
		1.46350472652464452805e-01, 2.66422703033638609560e-02, 1.84028451407337715652e-03,
		3.19475326584100867617e-05}

// lgamT: 15-coefficient poly for branch i==1 (x near Ymin), parallel Horner.
var lgamT [15]float64 = [15]float64{
		4.83836122723810047042e-01, -1.47587722994593911752e-01, 6.46249402391333854778e-02,
		-3.27885410759859649565e-02, 1.79706750811820387126e-02, -1.03142241298341437450e-02,
		6.10053870246291332635e-03, -3.68452016781138256760e-03, 2.25964780900612472250e-03,
		-1.40346469989232843813e-03, 8.81081882437654011382e-04, -5.38595305356740546715e-04,
		3.15632070903625950361e-04, -3.12754168375120860518e-04, 3.35529192635519073543e-04}

// lgamU: numerator poly for branch i==2 (x near 0).
var lgamU [6]float64 = [6]float64{
		-7.72156649015328655494e-02, 6.32827064025093366517e-01, 1.45492250137234768737e+00,
		9.77717527963372745603e-01, 2.28963728064692451092e-01, 1.33810918536787660377e-02}

// lgamV: denominator poly for branch i==2; lgamV[0]=1.0 placeholder.
var lgamV [6]float64 = [6]float64{
		1.0, 2.45597793713041134822e+00, 2.12848976379893395361e+00, 7.69285150456672783825e-01,
		1.04222645593369134254e-01, 3.21709242282423911810e-03}

// lgamW: asymptotic-expansion poly for 8<=x<2**58.
var lgamW [7]float64 = [7]float64{
		4.18938533204672725052e-01, 8.33333333333329678849e-02, -2.77777777728775536470e-03,
		7.93650558643019558500e-04, -5.95187557450339963135e-04, 8.36339918996282139126e-04,
		-1.63092934096575273989e-03}

// Threshold/anchor constants for Lgamma.
// bnlint:allow unused-const - Lgamma reference-algorithm threshold, kept for completeness
const (
	lgammaTwo52 float64 = 4503599627370496.0       // 1<<52
	lgammaTwo58 float64 = 288230376151711744.0     // 1<<58
	lgammaTiny float64 = 8.470329472543003e-22     // 1.0/(1<<70)
	lgammaYmin float64 = 1.461632144968362245
	lgammaTc float64 = 1.46163214496836224576e+00  // 0x3FF762D86356BE3F
	lgammaTf float64 = -1.21486290535849611461e-01 // 0xBFBF19B9BCC38A42
	lgammaTt float64 = -3.63867699703950536541e-18 // 0xBC50C7CAA48A971F
	// Pre-evaluated branch boundaries (Go computes these from Ymin/0.27 at
	// compile time; spelled out here so the comparisons match exactly).
	lgammaB1 float64 = 0.731632144968362245 // Ymin-1+0.27
	lgammaB2 float64 = 0.191632144968362245 // Ymin-1-0.27
	lgammaB3 float64 = 1.731632144968362245 // Ymin+0.27
	lgammaB4 float64 = 1.191632144968362245 // Ymin-0.27
)

// Lgamma returns the natural logarithm and sign (-1 or +1) of Gamma(x).
// Lgamma(+Inf)=+Inf, Lgamma(0)=+Inf, Lgamma(-integer)=+Inf, Lgamma(-Inf)=-Inf,
// Lgamma(NaN)=NaN.
func Lgamma(x float64) (float64, int) {
	var lgamma float64 = 0.0
	var sign int = 1

	// special cases
	if IsNaN(x) {
		return x, sign
	}
	if IsInf(x, 0) {
		return x, sign
	}
	if x == 0.0 {
		return Inf(1), sign
	}

	var neg bool = false
	if x < 0.0 {
		x = -x
		neg = true
	}

	if x < lgammaTiny {
		// if |x| < 2**-70, return -log(|x|)
		if neg {
			sign = -1
		}
		return -Log(x), sign
	}

	var nadj float64 = 0.0
	if neg {
		if x >= lgammaTwo52 {
			// |x| >= 2**52, must be -integer
			return Inf(1), sign
		}
		var t float64 = lgammaSinPi(x)
		if t == 0.0 {
			return Inf(1), sign // -integer
		}
		nadj = Log(Pi / Abs(t * x))
		if t < 0.0 {
			sign = -1
		}
	}

	if x == 1.0 || x == 2.0 {
		// purge off 1 and 2
		lgamma = 0.0
	} else if x < 2.0 {
		// use lgamma(x) = lgamma(x+1) - log(x)
		var y float64 = 0.0
		var i int = 0
		if x <= 0.9 {
			lgamma = -Log(x)
			if x >= lgammaB1 {
				// 0.7316 <= x <= 0.9
				y = 1.0 - x
				i = 0
			} else if x >= lgammaB2 {
				// 0.2316 <= x < 0.7316
				y = x - (lgammaTc - 1.0)
				i = 1
			} else {
				// 0 < x < 0.2316
				y = x
				i = 2
			}
		} else {
			lgamma = 0.0
			if x >= lgammaB3 {
				// 1.7316 <= x < 2
				y = 2.0 - x
				i = 0
			} else if x >= lgammaB4 {
				// 1.2316 <= x < 1.7316
				y = x - lgammaTc
				i = 1
			} else {
				// 0.9 < x < 1.2316
				y = x - 1.0
				i = 2
			}
		}
		if i == 0 {
			var z float64 = y * y
			var p1 float64 = lgamA[0] +
					z * (lgamA[2] + z * (lgamA[4] + z * (lgamA[6] + z * (lgamA[8] + z * lgamA[10]))))
			var p2 float64 = z *
					(lgamA[1] + z * (lgamA[3] + z * (lgamA[5] + z * (lgamA[7] + z * (lgamA[9] + z * lgamA[11])))))
			var p float64 = y * p1 + p2
			lgamma = lgamma + (p - 0.5 * y)
		} else if i == 1 {
			var z float64 = y * y
			var w float64 = z * y
			var p1 float64 = lgamT[0] + w * (lgamT[3] + w * (lgamT[6] + w * (lgamT[9] + w * lgamT[12])))
			var p2 float64 = lgamT[1] + w * (lgamT[4] + w * (lgamT[7] + w * (lgamT[10] + w * lgamT[13])))
			var p3 float64 = lgamT[2] + w * (lgamT[5] + w * (lgamT[8] + w * (lgamT[11] + w * lgamT[14])))
			var p float64 = z * p1 - (lgammaTt - w * (p2 + y * p3))
			lgamma = lgamma + (lgammaTf + p)
		} else {
			// i == 2
			var p1 float64 = y *
					(lgamU[0] + y * (lgamU[1] + y * (lgamU[2] + y * (lgamU[3] + y * (lgamU[4] + y * lgamU[5])))))
			var p2 float64 = 1.0 +
					y * (lgamV[1] + y * (lgamV[2] + y * (lgamV[3] + y * (lgamV[4] + y * lgamV[5]))))
			lgamma = lgamma + (-0.5 * y + p1 / p2)
		}
	} else if x < 8.0 {
		// 2 <= x < 8
		var i int = cast(int, x)
		var y float64 = x - cast(float64, i)
		var p float64 = y *
				(lgamS[0] +
						y *
								(lgamS[1] +
										y * (lgamS[2] + y * (lgamS[3] + y * (lgamS[4] + y * (lgamS[5] + y * lgamS[6]))))))
		var q float64 = 1.0 +
				y *
						(lgamR[1] + y * (lgamR[2] + y * (lgamR[3] + y * (lgamR[4] + y * (lgamR[5] + y * lgamR[6])))))
		lgamma = 0.5 * y + p / q
		var z float64 = 1.0 // Lgamma(1+s) = Log(s) + Lgamma(s)
		// Replicate Go's fallthrough ladder: multiply by (y+6)...(y+2) for the
		// factors strictly above each i, then add Log(z) once for i in 3..7.
		if i == 7 {
			z = z * (y + 6.0)
		}
		if i >= 6 {
			z = z * (y + 5.0)
		}
		if i >= 5 {
			z = z * (y + 4.0)
		}
		if i >= 4 {
			z = z * (y + 3.0)
		}
		if i >= 3 {
			z = z * (y + 2.0)
			lgamma = lgamma + Log(z)
		}
	} else if x < lgammaTwo58 {
		// 8 <= x < 2**58
		var t float64 = Log(x)
		var z float64 = 1.0 / x
		var y float64 = z * z
		var w float64 = lgamW[0] +
				z *
						(lgamW[1] + y * (lgamW[2] + y * (lgamW[3] + y * (lgamW[4] + y * (lgamW[5] + y * lgamW[6])))))
		lgamma = (x - 0.5) * (t - 1.0) + w
	} else {
		// 2**58 <= x <= Inf
		lgamma = x * (Log(x) - 1.0)
	}
	if neg {
		lgamma = nadj - lgamma
	}
	return lgamma, sign
}

// lgammaSinPi(x) helper: sin(Pi*x) with argument reduction, for negative-x
// Lgamma. x is the already-negated (positive) magnitude.
func lgammaSinPi(x float64) float64 {
	if x < 0.25 {
		return -Sin(Pi * x)
	}

	// argument reduction
	var z float64 = Floor(x)
	var n int = 0
	if z != x {
		// inexact
		x = Mod(x, 2.0)
		n = cast(int, x * 4.0)
	} else {
		if x >= lgammaTwo53 {
			// x must be even
			x = 0.0
			n = 0
		} else {
			if x < lgammaTwo52 {
				z = x + lgammaTwo52 // exact
			}
			n = cast(int, 1 & Float64bits(z))
			x = cast(float64, n)
			n = n << 2
		}
	}
	if n == 0 {
		x = Sin(Pi * x)
	} else if n == 1 || n == 2 {
		x = Cos(Pi * (0.5 - x))
	} else if n == 3 || n == 4 {
		x = Sin(Pi * (1.0 - x))
	} else if n == 5 || n == 6 {
		x = -Cos(Pi * (x - 1.5))
	} else {
		x = Sin(Pi * (x - 2.0))
	}
	return -x
}

// lgammaTwo52/lgammaTwo53 are also used by lgammaSinPi; Two53 declared here.
const lgammaTwo53 float64 = 9007199254740992.0 // 1<<53
