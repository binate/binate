package "pkg/std/math"

import "pkg/builtins/testing"

// chkLgamma runs Lgamma(x) and verifies the value (<=1 ULP vs Go, since the
// log-gamma polynomials/reflection are FMA-sensitive — see ulp_test.bn) and
// the sign (exact).
func chkLgamma(x float64, wantBits uint64, wantSign int) bool {
	var lg float64
	var sg int
	lg, sg = Lgamma(x)
	return nearULP(lg, Float64frombits(wantBits)) && sg == wantSign
}

func TestLgammaSmall() testing.TestResult {
	if !chkLgamma(1.0, 0x0000000000000000, 1) { return "Lgamma(1)" }
	if !chkLgamma(2.0, 0x0000000000000000, 1) { return "Lgamma(2)" }
	// x < 2 branches (i = 0/1/2 below and above the Ymin anchor).
	if !chkLgamma(0.9, 0x3FB0FE0882E465B2, 1) { return "Lgamma(0.9) i=0" }
	if !chkLgamma(0.5, 0x3FE250D048E7A1BD, 1) { return "Lgamma(0.5) i=1" }
	if !chkLgamma(0.1, 0x4002058E35F3DEED, 1) { return "Lgamma(0.1) i=2" }
	if !chkLgamma(1.8, 0xBFB2328D7D70B422, 1) { return "Lgamma(1.8) i=0" }
	if !chkLgamma(1.5, 0xBFBEEB95B094C191, 1) { return "Lgamma(1.5) i=1" }
	if !chkLgamma(1.2, 0xBFB5DB138C7D7038, 1) { return "Lgamma(1.2) i=2" }
	return ""
}

func TestLgammaMid() testing.TestResult {
	// 2 <= x < 8 (the fallthrough ladder).
	if !chkLgamma(2.5, 0x3FD2383E809A67E8, 1) { return "Lgamma(2.5)" }
	if !chkLgamma(3.0, 0x3FE62E42FEFA39EF, 1) { return "Lgamma(3)" }
	if !chkLgamma(3.5, 0x3FF3373018970A36, 1) { return "Lgamma(3.5)" }
	if !chkLgamma(6.0, 0x401326643C4479C9, 1) { return "Lgamma(6)" }
	// 8 <= x < 2**58, and large x.
	if !chkLgamma(8.0, 0x40210CE1F32DCC2F, 1) { return "Lgamma(8)" }
	if !chkLgamma(100.0, 0x40767225B4879463, 1) { return "Lgamma(100)" }
	if !chkLgamma(1000.0, 0x40B711386DA7CAB6, 1) { return "Lgamma(1000)" }
	if !chkLgamma(1e15, 0x435DC9D5B94E12F3, 1) { return "Lgamma(1e15)" }
	return ""
}

func TestLgammaNegative() testing.TestResult {
	if !chkLgamma(-0.5, 0x3FF43F89A3F0EDD6, -1) { return "Lgamma(-0.5)" }
	if !chkLgamma(-1.5, 0x3FEB858151820F85, 1) { return "Lgamma(-1.5)" }
	if !chkLgamma(-2.5, 0xBFACCBF9F5ED0F20, -1) { return "Lgamma(-2.5)" }
	if !chkLgamma(-2.3, 0x3FD7A6FAEF4ECA4D, -1) { return "Lgamma(-2.3)" }
	if !chkLgamma(-10.7, 0xC02ED5656164E0AF, -1) { return "Lgamma(-10.7)" }
	return ""
}

func TestLgammaSpecials() testing.TestResult {
	if !chkLgamma(0.0, Float64bits(Inf(1)), 1) { return "Lgamma(0) should be +Inf,1" }
	if !chkLgamma(Copysign(0.0, -1.0), Float64bits(Inf(1)), 1) { return "Lgamma(-0) should be +Inf,1" }
	if !chkLgamma(-1.0, Float64bits(Inf(1)), 1) { return "Lgamma(-1) should be +Inf,1" }
	if !chkLgamma(-3.0, Float64bits(Inf(1)), 1) { return "Lgamma(-3) should be +Inf,1" }
	if !chkLgamma(Inf(1), Float64bits(Inf(1)), 1) { return "Lgamma(+Inf)" }
	if !chkLgamma(Inf(-1), Float64bits(Inf(-1)), 1) { return "Lgamma(-Inf)" }
	var lg float64
	var sg int
	lg, sg = Lgamma(NaN())
	if !IsNaN(lg) || sg != 1 { return "Lgamma(NaN)" }
	return ""
}
