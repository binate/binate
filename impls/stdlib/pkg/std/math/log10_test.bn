package "pkg/std/math"

import "pkg/builtins/testing"

func TestLog2() testing.TestResult {
	// Powers of two are exact (the frac==0.5 fast path).
	if Log2(1.0) != 0.0 { return "Log2(1)" }
	if Log2(2.0) != 1.0 { return "Log2(2)" }
	if Log2(0.5) != -1.0 { return "Log2(0.5)" }
	if Log2(8.0) != 3.0 { return "Log2(8)" }
	if Log2(1024.0) != 10.0 { return "Log2(1024)" }
	// Bit-exact reference values from Go's math.Log2.
	if Float64bits(Log2(3.0)) != 0x3FF95C01A39FBD69 { return "Log2(3)" }
	if Float64bits(Log2(100.0)) != 0x401A934F0979A371 { return "Log2(100)" }
	if Float64bits(Log2(1e-10)) != 0xC0409C1165EC0627 { return "Log2(1e-10)" }
	if Float64bits(Log2(1e300)) != 0x408F24A09F1A8B89 { return "Log2(1e300)" }
	if Float64bits(Log2(SmallestNonzeroFloat64)) != 0xC090C80000000000 {
		return "Log2(smallest)"
	}
	return ""
}

func TestLog10() testing.TestResult {
	// Powers of ten come out exact via Log*Log10E.
	if Log10(1.0) != 0.0 { return "Log10(1)" }
	if Log10(10.0) != 1.0 { return "Log10(10)" }
	if Log10(100.0) != 2.0 { return "Log10(100)" }
	if Log10(1000.0) != 3.0 { return "Log10(1000)" }
	if Log10(0.001) != -3.0 { return "Log10(0.001)" }
	// Bit-exact reference values from Go's math.Log10.
	if Float64bits(Log10(3.0)) != 0x3FDE8927964FD5FC { return "Log10(3)" }
	if Float64bits(Log10(1e-10)) != 0xC024000000000000 { return "Log10(1e-10)" }
	if Float64bits(Log10(1e300)) != 0x4072C00000000000 { return "Log10(1e300)" }
	if Float64bits(Log10(SmallestNonzeroFloat64)) != 0xC07434E6420F4373 {
		return "Log10(smallest)"
	}
	return ""
}

func TestLog2Log10Specials() testing.TestResult {
	if !IsInf(Log2(Inf(1)), 1) { return "Log2(+Inf)" }
	if !IsInf(Log2(0.0), -1) { return "Log2(0)" }
	if !IsNaN(Log2(-1.0)) { return "Log2(-1)" }
	if !IsNaN(Log2(NaN())) { return "Log2(NaN)" }
	if !IsInf(Log10(Inf(1)), 1) { return "Log10(+Inf)" }
	if !IsInf(Log10(0.0), -1) { return "Log10(0)" }
	if !IsNaN(Log10(-1.0)) { return "Log10(-1)" }
	if !IsNaN(Log10(NaN())) { return "Log10(NaN)" }
	return ""
}
