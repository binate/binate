package "pkg/std/math"

// Thresholds and magic bit patterns for Log1p (Go's math/log1p.go, FreeBSD
// fdlibm s_log1p.c). The Ln2 split (logLn2Hi/Lo) and the log polynomial
// coefficients (logL1..logL7) are the same as Log's, and the field masks
// uvone/fracMask/shift/bias come from bits.bn.
const (
	log1pSqrt2M1 float64 = 4.142135623730950488017e-01      // Sqrt(2)-1
	log1pSqrt2HalfM1 float64 = -2.928932188134524755992e-01 // Sqrt(2)/2-1
	log1pSmall float64 = 1.862645149230957e-09              // 2**-29
	log1pTiny float64 = 5.551115123125783e-17               // 2**-54
	log1pTwo53 float64 = 9007199254740992.0                 // 2**53
	log1pSqrt2Mant uint64 = 0x0006A09E667F3BCD              // mantissa of Sqrt(2)
	log1pHalfExp uint64 = 0x3FE0000000000000                // exponent field for [0.5,1)
	log1pLeadBit uint64 = 0x0010000000000000                // 1<<52, implicit mantissa bit
)

// Log1p returns the natural logarithm of 1 plus its argument x. It is more
// accurate than Log(1+x) when x is near zero.
//   Log1p(+Inf) = +Inf
//   Log1p(0)    = 0
//   Log1p(-1)   = -Inf
//   Log1p(x<-1) = NaN
//   Log1p(NaN)  = NaN
func Log1p(x float64) float64 {
	// special cases (x < -1 includes -Inf)
	if x < -1.0 || IsNaN(x) {
		return NaN()
	}
	if x == -1.0 {
		return Inf(-1)
	}
	if IsInf(x, 1) {
		return Inf(1)
	}

	var absx float64 = Abs(x)

	var f float64 = 0.0
	var iu uint64 = cast(uint64, 0)
	var k int = 1
	if absx < log1pSqrt2M1 {
		// |x| < Sqrt(2)-1
		if absx < log1pSmall {
			// |x| < 2**-29
			if absx < log1pTiny {
				// |x| < 2**-54
				return x
			}
			return x - x * x * 0.5
		}
		if x > log1pSqrt2HalfM1 {
			// (Sqrt(2)/2-1) < x < (Sqrt(2)-1)
			k = 0
			f = x
			iu = cast(uint64, 1)
		}
	}

	var c float64 = 0.0
	if k != 0 {
		var u float64
		if absx < log1pTwo53 {
			u = 1.0 + x
			iu = Float64bits(u)
			// u > 0 here (x > -1), so the sign bit is clear and the
			// 11-bit exponent fits in int without uint64 wraparound.
			k = cast(int, iu >> shift) - cast(int, bias)
			if k > 0 {
				// correction term
				c = 1.0 - (u - x)
			} else {
				c = x - (u - 1.0)
			}
			c = c / u
		} else {
			u = x
			iu = Float64bits(u)
			k = cast(int, iu >> shift) - cast(int, bias)
			c = 0.0
		}
		iu = iu & fracMask
		if iu < log1pSqrt2Mant {
			// mantissa < that of Sqrt(2)
			u = Float64frombits(iu | uvone) // normalize u to [1, Sqrt(2))
		} else {
			k = k + 1
			u = Float64frombits(iu | log1pHalfExp) // normalize u/2
			iu = (log1pLeadBit - iu) >> cast(uint64, 2)
		}
		f = u - 1.0 // Sqrt(2)/2 < u < Sqrt(2)
	}

	var hfsq float64 = 0.5 * f * f
	var rr float64 = 0.0
	if iu == cast(uint64, 0) {
		// |f| < 2**-20
		if f == 0.0 {
			if k == 0 {
				return 0.0
			}
			c = c + cast(float64, k) * logLn2Lo
			return cast(float64, k) * logLn2Hi + c
		}
		rr = hfsq * (1.0 - 0.66666666666666666 * f) // avoid division
		if k == 0 {
			return f - rr
		}
		return cast(float64, k) * logLn2Hi - ((rr - (cast(float64, k) * logLn2Lo + c)) - f)
	}

	var s float64 = f / (2.0 + f)
	var z float64 = s * s
	rr = z * (logL1 + z * (logL2 + z * (logL3 + z * (logL4 + z * (logL5 + z * (logL6 + z * logL7))))))
	if k == 0 {
		return f - (hfsq - s * (hfsq + rr))
	}
	return cast(float64, k) * logLn2Hi -
			((hfsq - (s * (hfsq + rr) + (cast(float64, k) * logLn2Lo + c))) - f)
}
