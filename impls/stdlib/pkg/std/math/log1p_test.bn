package "pkg/std/math"

import "pkg/builtins/testing"

func TestLog1p() testing.TestResult {
	// Bit-exact identities: Log1p(0)=0; Log1p(1)=Ln2; Log1p(2)=Log(3);
	// Log1p(-0.5)=Log(0.5)=-Ln2.
	if Log1p(0.0) != 0.0 { return "Log1p(0) should be 0" }
	if Float64bits(Log1p(1.0)) != Float64bits(Ln2) { return "Log1p(1) != Ln2" }
	if Float64bits(Log1p(-0.5)) != Float64bits(-Ln2) { return "Log1p(-0.5) != -Ln2" }
	if Float64bits(Log1p(2.0)) != Float64bits(Log(3.0)) { return "Log1p(2) != Log(3)" }
	// Tiny x: Log1p(x) is accurate where Log(1+x) loses precision.
	if Log1p(1e-20) != 1e-20 { return "Log1p(1e-20) should be x" }
	if Log1p(-1e-20) != -1e-20 { return "Log1p(-1e-20) should be x" }
	return ""
}

func TestLog1pVectors() testing.TestResult {
	// Bit-exact reference values from Go's math.Log1p.
	if Float64bits(Log1p(0.5)) != 0x3FD9F323ECBF984C { return "Log1p(0.5)" }
	if Float64bits(Log1p(3.0)) != 0x3FF62E42FEFA39EF { return "Log1p(3)" }
	if Float64bits(Log1p(1e-10)) != 0x3DDB7CDFD9D1D693 { return "Log1p(1e-10)" }
	if Float64bits(Log1p(-1e-10)) != 0xBDDB7CDFD9DDA4E3 { return "Log1p(-1e-10)" }
	if Float64bits(Log1p(1e-8)) != 0x3E45798EE0636111 { return "Log1p(1e-8)" }
	if Float64bits(Log1p(-1e-8)) != 0xBE45798EE3FDB764 { return "Log1p(-1e-8)" }
	if Float64bits(Log1p(0.1)) != 0x3FB8663F793C46C7 { return "Log1p(0.1)" }
	if Float64bits(Log1p(-0.1)) != 0xBFBAF8E8210A415E { return "Log1p(-0.1)" }
	if Float64bits(Log1p(1e10)) != 0x4037069E2AA3184E { return "Log1p(1e10)" }
	if Float64bits(Log1p(1e300)) != 0x4085963447F87FB5 { return "Log1p(1e300)" }
	if Float64bits(Log1p(-0.9999999999)) != 0xC037069E293F4C5C { return "Log1p(-0.9999999999)" }
	// Near the Sqrt(2)-1 / Sqrt(2)/2-1 normalization boundaries.
	if Float64bits(Log1p(0.41421356237309515)) != 0x3FD62E42FEFA39F0 {
		return "Log1p(Sqrt2-1 boundary)"
	}
	if Float64bits(Log1p(-0.2928932188134524)) != 0xBFD62E42FEFA39EE {
		return "Log1p(Sqrt2/2-1 boundary)"
	}
	return ""
}

func TestLog1pSpecials() testing.TestResult {
	if !IsInf(Log1p(Inf(1)), 1) { return "Log1p(+Inf) should be +Inf" }
	if !IsInf(Log1p(-1.0), -1) { return "Log1p(-1) should be -Inf" }
	if !IsNaN(Log1p(-2.0)) { return "Log1p(-2) should be NaN" }
	if !IsNaN(Log1p(Inf(-1))) { return "Log1p(-Inf) should be NaN" }
	if !IsNaN(Log1p(NaN())) { return "Log1p(NaN) should be NaN" }
	return ""
}
