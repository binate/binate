package "pkg/std/math"

// ilogb returns the binary exponent of x, assuming x is neither zero, Inf, nor
// NaN.  (Denormals are normalized first so the exponent is exact.)
func ilogb(x float64) int {
	var nx float64
	var exp int
	nx, exp = normalize(x)
	return cast(int, (Float64bits(nx) >> shift) & expMask) - cast(int, bias) + exp
}

// Logb returns the binary exponent of x.  Logb(±0)=-Inf, Logb(±Inf)=+Inf,
// Logb(NaN)=NaN.
func Logb(x float64) float64 {
	if x == 0.0 {
		return Inf(-1)
	}
	if IsInf(x, 0) {
		return Inf(1)
	}
	if IsNaN(x) {
		return x
	}
	return cast(float64, ilogb(x))
}

// Ilogb returns the binary exponent of x as an integer.  Ilogb(±0)=MinInt32,
// Ilogb(±Inf)=MaxInt32, Ilogb(NaN)=MaxInt32.
func Ilogb(x float64) int {
	if x == 0.0 {
		return -2147483647 - 1 // MinInt32 (written this way to avoid 2**31 overflow)
	}
	if IsNaN(x) {
		return 2147483647 // MaxInt32
	}
	if IsInf(x, 0) {
		return 2147483647 // MaxInt32
	}
	return ilogb(x)
}
