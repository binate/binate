package "pkg/std/math"

import "pkg/builtins/testing"

func TestLogb() testing.TestResult {
	// Logb returns the binary exponent — exact for powers of two and ranges.
	if Logb(1.0) != 0.0 { return "Logb(1)" }
	if Logb(2.0) != 1.0 { return "Logb(2)" }
	if Logb(4.0) != 2.0 { return "Logb(4)" }
	if Logb(8.0) != 3.0 { return "Logb(8)" }
	if Logb(0.5) != -1.0 { return "Logb(0.5)" }
	if Logb(0.25) != -2.0 { return "Logb(0.25)" }
	if Logb(3.0) != 1.0 { return "Logb(3)" }   // 2 <= 3 < 4
	if Logb(1.5) != 0.0 { return "Logb(1.5)" }
	if Logb(-8.0) != 3.0 { return "Logb(-8)" } // exponent of |x|
	return ""
}

func TestLogbSpecials() testing.TestResult {
	// Logb(±0) = -Inf, Logb(±Inf) = +Inf, Logb(NaN) = NaN.
	if !IsInf(Logb(0.0), -1) { return "Logb(0) should be -Inf" }
	if !IsInf(Logb(Inf(1)), 1) { return "Logb(+Inf)" }
	if !IsInf(Logb(Inf(-1)), 1) { return "Logb(-Inf)" }
	if !IsNaN(Logb(NaN())) { return "Logb(NaN)" }
	return ""
}

func TestIlogb() testing.TestResult {
	if Ilogb(1.0) != 0 { return "Ilogb(1)" }
	if Ilogb(8.0) != 3 { return "Ilogb(8)" }
	if Ilogb(0.5) != -1 { return "Ilogb(0.5)" }
	if Ilogb(1024.0) != 10 { return "Ilogb(1024)" }
	// Ilogb(±0) = MinInt32, Ilogb(±Inf) = Ilogb(NaN) = MaxInt32.
	if Ilogb(0.0) != -2147483648 { return "Ilogb(0)" }
	if Ilogb(Inf(1)) != 2147483647 { return "Ilogb(+Inf)" }
	if Ilogb(NaN()) != 2147483647 { return "Ilogb(NaN)" }
	return ""
}
