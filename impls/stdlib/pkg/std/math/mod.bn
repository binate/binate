package "pkg/std/math"

// remTiny is the smallest positive normal float64 (0x0020000000000000),
// the threshold below which Remainder uses the "x+x" comparison form to
// avoid overflow in 0.5*y.
const remTiny float64 = 4.45014771701440276618e-308

// halfMax is MaxFloat64/2 (0x7FDFFFFFFFFFFFFF), the largest y for which
// y+y is still finite (so Mod(x, y+y) does not overflow). Spelled with
// the shortest decimal that rounds to that bit pattern; Go's documented
// "...953865e+307" form rounds one ULP high.
const halfMax float64 = 8.988465674311579e+307

// Mod returns the floating-point remainder of x/y. The magnitude of the
// result is less than y's and its sign agrees with that of x.
//   Mod(±Inf, y) = NaN
//   Mod(NaN, y)  = NaN
//   Mod(x, 0)    = NaN
//   Mod(x, ±Inf) = x
//   Mod(x, NaN)  = NaN
func Mod(x float64, y float64) float64 {
	if y == 0.0 || IsInf(x, 0) || IsNaN(x) || IsNaN(y) {
		return NaN()
	}
	y = Abs(y)

	var yfr float64
	var yexp int
	yfr, yexp = Frexp(y)
	var r float64 = x
	if x < 0.0 {
		r = -x
	}

	for r >= y {
		var rfr float64
		var rexp int
		rfr, rexp = Frexp(r)
		if rfr < yfr {
			rexp = rexp - 1
		}
		r = r - Ldexp(y, rexp-yexp)
	}
	if x < 0.0 {
		r = -r
	}
	return r
}

// Remainder returns the IEEE 754 floating-point remainder of x/y.
//   Remainder(±Inf, y) = NaN
//   Remainder(NaN, y)  = NaN
//   Remainder(x, 0)    = NaN
//   Remainder(x, ±Inf) = x
//   Remainder(x, NaN)  = NaN
func Remainder(x float64, y float64) float64 {
	if IsNaN(x) || IsNaN(y) || IsInf(x, 0) || y == 0.0 {
		return NaN()
	}
	if IsInf(y, 0) {
		return x
	}

	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}
	if y < 0.0 {
		y = -y
	}
	if x == y {
		if sign {
			x = Copysign(0.0, -1.0)  // -0
		}
		return Copysign(0.0, x)
	}
	if y <= halfMax {
		x = Mod(x, y+y)  // now x < 2y
	}
	if y < remTiny {
		if x+x > y {
			x = x - y
			if x+x >= y {
				x = x - y
			}
		}
	} else {
		var yHalf float64 = 0.5 * y
		if x > yHalf {
			x = x - y
			if x >= yHalf {
				x = x - y
			}
		}
	}
	if sign {
		x = -x
	}
	return x
}
