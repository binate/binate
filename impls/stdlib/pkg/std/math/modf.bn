package "pkg/std/math"

// Modf returns integer and fractional floating-point numbers that sum
// to f. Both values have the same sign as f.
//   Modf(±Inf) = ±Inf, NaN
//   Modf(NaN)  = NaN, NaN
func Modf(f float64) (float64, float64) {
	if f < 1.0 {
		if f < 0.0 {
			var i float64
			var fr float64
			i, fr = Modf(-f)
			return -i, -fr
		}
		if f == 0.0 {
			return f, f // return -0, -0 when f == -0
		}
		return 0.0, f
	}

	var x uint64 = Float64bits(f)
	var e uint64 = ((x >> shift) & expMask) - bias
	// Keep the top 12+e bits (the integer part); clear the rest.
	if e < cast(uint64, 52) {
		x = x & ~((cast(uint64, 1) << (cast(uint64, 52) - e)) - cast(uint64, 1))
	}
	var ipart float64 = Float64frombits(x)
	return ipart, f - ipart
}
