package "pkg/std/math"

import "pkg/builtins/testing"

func TestModf() testing.TestResult {
	var ip float64
	var fp float64
	ip, fp = Modf(3.75)
	if ip != 3.0 || fp != 0.75 { return "Modf(3.75)" }
	ip, fp = Modf(-3.75)
	if ip != -3.0 || fp != -0.75 { return "Modf(-3.75)" }
	ip, fp = Modf(5.0)
	if ip != 5.0 || fp != 0.0 { return "Modf(5.0)" }
	ip, fp = Modf(0.25)
	if ip != 0.0 || fp != 0.25 { return "Modf(0.25)" }
	// Modf(+Inf) = +Inf, NaN.
	ip, fp = Modf(Inf(1))
	if ip != Inf(1) || !IsNaN(fp) { return "Modf(+Inf)" }
	return ""
}
