package "pkg/std/math"

// Pre-computed powers of ten (Go's math/pow10.go).  Each value is a
// correctly-rounded float64 literal; Pow10 multiplies/divides two of them so
// its result matches Go's bit-for-bit.  These are package-level tables (read
// only, never mutated) applied at startup by the synthetic per-package init.

// pow10tab holds 10**i for i in [0, 31].
var pow10tab [32]float64 = [32]float64{
		1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12, 1e13, 1e14, 1e15, 1e16, 1e17,
		1e18, 1e19, 1e20, 1e21, 1e22, 1e23, 1e24, 1e25, 1e26, 1e27, 1e28, 1e29, 1e30, 1e31}

// pow10postab32 holds 10**(i*32) for i in [0, 9].
var pow10postab32 [10]float64 = [10]float64{
		1e0, 1e32, 1e64, 1e96, 1e128, 1e160, 1e192, 1e224, 1e256, 1e288}

// pow10negtab32 holds 10**(-i*32) for i in [0, 10].
var pow10negtab32 [11]float64 = [11]float64{
		1e0, 1e-32, 1e-64, 1e-96, 1e-128, 1e-160, 1e-192, 1e-224, 1e-256, 1e-288, 1e-320}

// Pow10 returns 10**n, the base-10 exponential of n.
//   Pow10(n) = 0    for n < -323
//   Pow10(n) = +Inf for n > 308
func Pow10(n int) float64 {
	if n >= 0 && n <= 308 {
		return pow10postab32[n / 32] * pow10tab[n % 32]
	}
	if n >= -323 && n <= 0 {
		var m int = -n
		return pow10negtab32[m / 32] / pow10tab[m % 32]
	}
	if n > 0 {
		return Inf(1)
	}
	return 0.0
}
