package "pkg/std/math"

import "pkg/builtins/testing"

func TestPow10() testing.TestResult {
	// Small exact powers of ten.
	if Pow10(0) != 1.0 { return "Pow10(0)" }
	if Pow10(1) != 10.0 { return "Pow10(1)" }
	if Pow10(2) != 100.0 { return "Pow10(2)" }
	if Pow10(5) != 100000.0 { return "Pow10(5)" }
	if Pow10(-1) != 0.1 { return "Pow10(-1)" }
	// Bit-exact reference values from Go's math.Pow10 (incl. the table
	// boundaries at 31/32 and the values that aren't exact powers of ten).
	if Float64bits(Pow10(10)) != 0x4202A05F20000000 { return "Pow10(10)" }
	if Float64bits(Pow10(22)) != 0x4480F0CF064DD592 { return "Pow10(22)" }
	if Float64bits(Pow10(23)) != 0x44B52D02C7E14AF6 { return "Pow10(23)" }
	if Float64bits(Pow10(31)) != 0x465F8DEF8808B024 { return "Pow10(31)" }
	if Float64bits(Pow10(32)) != 0x4693B8B5B5056E17 { return "Pow10(32)" }
	if Float64bits(Pow10(100)) != 0x54B249AD2594C37D { return "Pow10(100)" }
	if Float64bits(Pow10(200)) != 0x6974E718D7D7625A { return "Pow10(200)" }
	if Float64bits(Pow10(308)) != 0x7FE1CCF385EBC8A0 { return "Pow10(308)" }
	return ""
}

func TestPow10Negative() testing.TestResult {
	// Bit-exact reference values from Go (negative side uses division).
	if Float64bits(Pow10(-10)) != 0x3DDB7CDFD9D7BDBB { return "Pow10(-10)" }
	if Float64bits(Pow10(-22)) != 0x3B5E392010175EE6 { return "Pow10(-22)" }
	if Float64bits(Pow10(-50)) != 0x358DEE7A4AD4B81F { return "Pow10(-50)" }
	if Float64bits(Pow10(-100)) != 0x2B2BFF2EE48E052F { return "Pow10(-100)" }
	if Float64bits(Pow10(-200)) != 0x16687E92154EF7AD { return "Pow10(-200)" }
	if Float64bits(Pow10(-300)) != 0x01A56E1FC2F8F359 { return "Pow10(-300)" }
	if Float64bits(Pow10(-320)) != 0x00000000000007E8 { return "Pow10(-320)" }
	if Float64bits(Pow10(-323)) != 0x0000000000000002 { return "Pow10(-323)" }
	return ""
}

func TestPow10Bounds() testing.TestResult {
	// Out of range: overflow to +Inf above 308, underflow to 0 below -323.
	if !IsInf(Pow10(309), 1) { return "Pow10(309) should be +Inf" }
	if !IsInf(Pow10(400), 1) { return "Pow10(400) should be +Inf" }
	if Pow10(-324) != 0.0 { return "Pow10(-324) should be 0" }
	if Pow10(-400) != 0.0 { return "Pow10(-400) should be 0" }
	return ""
}
