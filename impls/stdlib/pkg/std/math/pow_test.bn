package "pkg/std/math"

import "pkg/builtins/testing"

func TestPow() testing.TestResult {
	// Exact / simple cases.
	if Pow(2.0, 10.0) != 1024.0 { return "Pow(2,10)" }
	if Pow(3.0, 3.0) != 27.0 { return "Pow(3,3)" }
	if Pow(10.0, 3.0) != 1000.0 { return "Pow(10,3)" }
	if Pow(2.0, -1.0) != 0.5 { return "Pow(2,-1)" }
	if Pow(0.5, 2.0) != 0.25 { return "Pow(0.5,2)" }
	if Pow(-2.0, 3.0) != -8.0 { return "Pow(-2,3)" }
	if Pow(-2.0, 2.0) != 4.0 { return "Pow(-2,2)" }
	if Pow(9.0, 0.5) != 3.0 { return "Pow(9,0.5) should be 3" }
	if Pow(2.0, 64.0) != 18446744073709551616.0 { return "Pow(2,64)" }
	// Bit-exact reference values from Go's math.Pow.
	if Float64bits(Pow(2.0, 0.5)) != 0x3FF6A09E667F3BCD { return "Pow(2,0.5)" }
	if Float64bits(Pow(2.0, 3.5)) != 0x4026A09E667F3BCC { return "Pow(2,3.5)" }
	if Float64bits(Pow(5.0, -2.0)) != 0x3FA47AE147AE147B { return "Pow(5,-2)" }
	if Float64bits(Pow(2.0, 100.0)) != 0x4630000000000000 { return "Pow(2,100)" }
	if Float64bits(Pow(1.5, 1.5)) != 0x3FFD64D51E0DB1C5 { return "Pow(1.5,1.5)" }
	if Float64bits(Pow(2.0, 1000.0)) != 0x7E70000000000000 { return "Pow(2,1000)" }
	if Float64bits(Pow(2.0, -1000.0)) != 0x0170000000000000 { return "Pow(2,-1000)" }
	if Float64bits(Pow(10.0, 100.0)) != 0x54B249AD2594C37E { return "Pow(10,100)" }
	return ""
}

func TestPowZeroAndOne() testing.TestResult {
	// Pow(x,0)=1 for every x (incl. NaN); Pow(1,y)=1 for every y; Pow(x,1)=x.
	if Pow(2.0, 0.0) != 1.0 { return "Pow(2,0)" }
	if Pow(NaN(), 0.0) != 1.0 { return "Pow(NaN,0) should be 1" }
	if Pow(1.0, 5.0) != 1.0 { return "Pow(1,5)" }
	if Pow(1.0, NaN()) != 1.0 { return "Pow(1,NaN) should be 1" }
	if Pow(7.0, 1.0) != 7.0 { return "Pow(7,1)" }
	if Pow(-1.0, 1e19) != 1.0 { return "Pow(-1,1e19) should be 1" }
	return ""
}

func TestPowZeroBase() testing.TestResult {
	if !IsInf(Pow(0.0, -1.0), 1) { return "Pow(0,-1) should be +Inf" }
	if !IsInf(Pow(0.0, -2.0), 1) { return "Pow(0,-2) should be +Inf" }
	if !IsInf(Pow(Copysign(0.0, -1.0), -3.0), -1) { return "Pow(-0,-3) should be -Inf" }
	if Pow(0.0, 3.0) != 0.0 { return "Pow(0,3) should be 0" }
	return ""
}

func TestPowInf() testing.TestResult {
	if !IsInf(Pow(2.0, Inf(1)), 1) { return "Pow(2,+Inf)" }
	if Pow(0.5, Inf(1)) != 0.0 { return "Pow(0.5,+Inf) should be 0" }
	if Pow(2.0, Inf(-1)) != 0.0 { return "Pow(2,-Inf) should be 0" }
	if Pow(-1.0, Inf(1)) != 1.0 { return "Pow(-1,+Inf) should be 1" }
	if !IsInf(Pow(Inf(1), 2.0), 1) { return "Pow(+Inf,2)" }
	if Pow(Inf(1), -2.0) != 0.0 { return "Pow(+Inf,-2) should be 0" }
	if !IsInf(Pow(Inf(-1), 3.0), -1) { return "Pow(-Inf,3) should be -Inf" }
	return ""
}

func TestPowNaN() testing.TestResult {
	if !IsNaN(Pow(NaN(), 2.0)) { return "Pow(NaN,2)" }
	if !IsNaN(Pow(2.0, NaN())) { return "Pow(2,NaN)" }
	// Negative base with a non-integer exponent is NaN.
	if !IsNaN(Pow(-2.0, 0.5)) { return "Pow(-2,0.5) should be NaN" }
	if !IsNaN(Pow(-2.0, 1.5)) { return "Pow(-2,1.5) should be NaN" }
	return ""
}
