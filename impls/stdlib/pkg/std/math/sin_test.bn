package "pkg/std/math"

import "pkg/builtins/testing"

func TestSin() testing.TestResult {
	if Sin(0.0) != 0.0 { return "Sin(0)" }
	if Sin(Pi / 2.0) != 1.0 { return "Sin(Pi/2) should be 1" }
	// Bit-exact reference values from Go's math.Sin.
	if Float64bits(Sin(0.5)) != 0x3FDEAEE8744B05F0 { return "Sin(0.5)" }
	if Float64bits(Sin(1.0)) != 0x3FEAED548F090CEE { return "Sin(1)" }
	if Float64bits(Sin(-1.0)) != 0xBFEAED548F090CEE { return "Sin(-1)" }
	if Float64bits(Sin(2.0)) != 0x3FED18F6EAD1B445 { return "Sin(2)" }
	if Float64bits(Sin(10.0)) != 0xBFE1689EF5F34F53 { return "Sin(10)" }
	if Float64bits(Sin(100.0)) != 0xBFE03425B78C4DB8 { return "Sin(100)" }
	if Float64bits(Sin(1000000.0)) != 0xBFD6664B2568D867 { return "Sin(1e6)" }
	return ""
}

func TestSinLargeArg() testing.TestResult {
	// |x| >= 2**29 exercises trigReduce; <=1 ULP vs Go (FMA — see ulp_test.bn).
	if !nearULP(Sin(1e10), Float64frombits(0xBFDF334C7896A4E4)) { return "Sin(1e10)" }
	if !nearULP(Sin(1e15), Float64frombits(0x3FEB76F88136CEBA)) { return "Sin(1e15)" }
	if !nearULP(Sin(1e20), Float64frombits(0xBFE4A5E605FD6450)) { return "Sin(1e20)" }
	return ""
}

func TestSinSpecials() testing.TestResult {
	// Sin(-0) = -0 (sign preserved).
	if Float64bits(Sin(Copysign(0.0, -1.0))) != 0x8000000000000000 { return "Sin(-0) should be -0" }
	if !IsNaN(Sin(Inf(1))) { return "Sin(+Inf) should be NaN" }
	if !IsNaN(Sin(Inf(-1))) { return "Sin(-Inf) should be NaN" }
	if !IsNaN(Sin(NaN())) { return "Sin(NaN)" }
	return ""
}

func TestCos() testing.TestResult {
	if Cos(0.0) != 1.0 { return "Cos(0)" }
	// Bit-exact reference values from Go's math.Cos.
	if Float64bits(Cos(0.5)) != 0x3FEC1528065B7D50 { return "Cos(0.5)" }
	if Float64bits(Cos(1.0)) != 0x3FE14A280FB5068C { return "Cos(1)" }
	if Float64bits(Cos(-1.0)) != 0x3FE14A280FB5068C { return "Cos(-1) should equal Cos(1)" }
	if Float64bits(Cos(2.0)) != 0xBFDAA22657537205 { return "Cos(2)" }
	if Float64bits(Cos(10.0)) != 0xBFEAD9AC890C6B1F { return "Cos(10)" }
	if Float64bits(Cos(100.0)) != 0x3FEB981DBF665FDF { return "Cos(100)" }
	if Float64bits(Cos(1000000.0)) != 0x3FEDF9DF9906D32C { return "Cos(1e6)" }
	return ""
}

func TestCosLargeArg() testing.TestResult {
	// |x| >= 2**29 exercises trigReduce; <=1 ULP vs Go (FMA — see ulp_test.bn).
	if !nearULP(Cos(1e10), Float64frombits(0x3FEBF098901C931A)) { return "Cos(1e10)" }
	if !nearULP(Cos(1e15), Float64frombits(0xBFE06C154609D33E)) { return "Cos(1e15)" }
	if !nearULP(Cos(1e20), Float64frombits(0x3FE872720FC60D3E)) { return "Cos(1e20)" }
	return ""
}

func TestCosSpecials() testing.TestResult {
	if !IsNaN(Cos(Inf(1))) { return "Cos(+Inf) should be NaN" }
	if !IsNaN(Cos(NaN())) { return "Cos(NaN)" }
	return ""
}
