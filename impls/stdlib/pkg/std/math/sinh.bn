package "pkg/std/math"

// Hart & Cheney #2029 coefficients for Sinh on [0, 0.5] (Go's math/sinh.go).
const (
	sinhP0 float64 = -0.6307673640497716991184787251e+6
	sinhP1 float64 = -0.8991272022039509355398013511e+5
	sinhP2 float64 = -0.2894211355989563807284660366e+4
	sinhP3 float64 = -0.2630563213397497062819489e+2
	sinhQ0 float64 = -0.6307673640497716991212077277e+6
	sinhQ1 float64 = 0.1521517378790019070696485176e+5
	sinhQ2 float64 = -0.173678953558233699533450911e+3
)

// Sinh returns the hyperbolic sine of x.  Sinh(±0)=±0, Sinh(±Inf)=±Inf,
// Sinh(NaN)=NaN.
func Sinh(x float64) float64 {
	var sign bool = false
	if x < 0.0 {
		x = -x
		sign = true
	}

	var temp float64 = 0.0
	if x > 21.0 {
		temp = Exp(x) * 0.5
	} else if x > 0.5 {
		var ex float64 = Exp(x)
		temp = (ex - 1.0 / ex) * 0.5
	} else {
		var sq float64 = x * x
		temp = (((sinhP3 * sq + sinhP2) * sq + sinhP1) * sq + sinhP0) * x
		temp = temp / (((sq + sinhQ2) * sq + sinhQ1) * sq + sinhQ0)
	}

	if sign {
		temp = -temp
	}
	return temp
}

// Cosh returns the hyperbolic cosine of x.  Cosh(±0)=1, Cosh(±Inf)=+Inf,
// Cosh(NaN)=NaN.
func Cosh(x float64) float64 {
	x = Abs(x)
	if x > 21.0 {
		return Exp(x) * 0.5
	}
	var ex float64 = Exp(x)
	return (ex + 1.0 / ex) * 0.5
}
