package "pkg/std/math"

import "pkg/builtins/testing"

func TestSinh() testing.TestResult {
	if Sinh(0.0) != 0.0 { return "Sinh(0)" }
	// Bit-exact reference values from Go's math.Sinh.
	if Float64bits(Sinh(0.5)) != 0x3FE0ACD00FE63B97 { return "Sinh(0.5)" }
	if Float64bits(Sinh(1.0)) != 0x3FF2CD9FC44EB982 { return "Sinh(1)" }
	if Float64bits(Sinh(-1.0)) != 0xBFF2CD9FC44EB982 { return "Sinh(-1)" }
	if Float64bits(Sinh(2.0)) != 0x400D03CF63B6E1A0 { return "Sinh(2)" }
	if Float64bits(Sinh(0.6)) != 0x3FE45F775546A77D { return "Sinh(0.6)" }
	if Float64bits(Sinh(22.0)) != 0x41DAB5ADB9C43600 { return "Sinh(22)" }
	if Float64bits(Sinh(-3.0)) != 0xC0240926E70949AE { return "Sinh(-3)" }
	return ""
}

func TestCosh() testing.TestResult {
	if Cosh(0.0) != 1.0 { return "Cosh(0)" }
	if Float64bits(Cosh(0.5)) != 0x3FF20AC1862AE8D0 { return "Cosh(0.5)" }
	if Float64bits(Cosh(1.0)) != 0x3FF8B07551D9F550 { return "Cosh(1)" }
	if Float64bits(Cosh(-1.0)) != 0x3FF8B07551D9F550 { return "Cosh(-1) should equal Cosh(1)" }
	if Float64bits(Cosh(2.0)) != 0x400E18FA0DF2D9BC { return "Cosh(2)" }
	if Float64bits(Cosh(0.6)) != 0x3FF2F7AA606E5630 { return "Cosh(0.6)" }
	if Float64bits(Cosh(22.0)) != 0x41DAB5ADB9C43600 { return "Cosh(22)" }
	return ""
}

func TestSinhCoshSpecials() testing.TestResult {
	if !IsInf(Sinh(Inf(1)), 1) { return "Sinh(+Inf)" }
	if !IsInf(Sinh(Inf(-1)), -1) { return "Sinh(-Inf)" }
	if !IsNaN(Sinh(NaN())) { return "Sinh(NaN)" }
	if !IsInf(Cosh(Inf(1)), 1) { return "Cosh(+Inf)" }
	if !IsInf(Cosh(Inf(-1)), 1) { return "Cosh(-Inf) should be +Inf" }
	if !IsNaN(Cosh(NaN())) { return "Cosh(NaN)" }
	return ""
}
