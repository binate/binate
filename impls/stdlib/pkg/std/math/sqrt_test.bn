package "pkg/std/math"

import "pkg/builtins/testing"

func TestSqrt() testing.TestResult {
	// Perfect squares are exact.
	if Sqrt(4.0) != 2.0 { return "Sqrt(4)" }
	if Sqrt(9.0) != 3.0 { return "Sqrt(9)" }
	if Sqrt(16.0) != 4.0 { return "Sqrt(16)" }
	if Sqrt(1.0) != 1.0 { return "Sqrt(1)" }
	if Sqrt(0.25) != 0.5 { return "Sqrt(0.25)" }
	if Sqrt(1e100) != 1e50 { return "Sqrt(1e100)" }
	// Sqrt(2) must equal the Sqrt2 constant, bit-for-bit (both are the
	// correctly-rounded sqrt of 2) — a strong correctly-rounded check.
	if Float64bits(Sqrt(2.0)) != Float64bits(Sqrt2) { return "Sqrt(2) != Sqrt2 const" }
	// A non-square, in range.
	if Sqrt(3.0) < 1.7320508075688770 || Sqrt(3.0) > 1.7320508075688775 {
		return "Sqrt(3) range"
	}
	return ""
}

func TestSqrtSpecials() testing.TestResult {
	// ±0 returns the same zero (sign preserved).
	if Sqrt(0.0) != 0.0 { return "Sqrt(+0)" }
	if !Signbit(Sqrt(Copysign(0.0, -1.0))) { return "Sqrt(-0) should be -0" }
	// +Inf -> +Inf.
	if !IsInf(Sqrt(Inf(1)), 1) { return "Sqrt(+Inf) should be +Inf" }
	// x < 0 -> NaN (including -Inf).
	if !IsNaN(Sqrt(-1.0)) { return "Sqrt(-1) should be NaN" }
	if !IsNaN(Sqrt(Inf(-1))) { return "Sqrt(-Inf) should be NaN" }
	// NaN -> NaN.
	if !IsNaN(Sqrt(NaN())) { return "Sqrt(NaN) should be NaN" }
	return ""
}

func TestSqrtSubnormal() testing.TestResult {
	// Square of a subnormal round-trips: Sqrt(SmallestNonzero) is exact
	// for this construction (smallest denormal = 2**-1074, sqrt = 2**-537).
	var x float64 = SmallestNonzeroFloat64
	var r float64 = Sqrt(x)
	if r * r > x * 4.0 || r <= 0.0 { return "Sqrt(subnormal) out of range" }
	// Sqrt then square returns close to the input (sanity, exactness not
	// required for subnormals).
	if Sqrt(4.0 * x) != 2.0 * r { return "Sqrt(4*sub) should be 2*Sqrt(sub)" }
	return ""
}

func TestSqrtMonotoneSquares() testing.TestResult {
	// Sqrt(n*n) == n for a range of integers (exact).
	var n int = 1
	for n <= 1000 {
		var nf float64 = cast(float64, n)
		if Sqrt(nf * nf) != nf { return "Sqrt(n*n) should be n" }
		n = n + 1
	}
	return ""
}
