package "pkg/std/math"

import "pkg/builtins/testing"

func TestTan() testing.TestResult {
	if Tan(0.0) != 0.0 { return "Tan(0)" }
	// Tan(tiny) ~ tiny.
	if Tan(1e-8) != 1e-8 { return "Tan(1e-8)" }
	// Bit-exact reference values from Go's math.Tan.
	if Float64bits(Tan(0.5)) != 0x3FE17B4F5BF3474A { return "Tan(0.5)" }
	if Float64bits(Tan(1.0)) != 0x3FF8EB245CBEE3A5 { return "Tan(1)" }
	if Float64bits(Tan(-1.0)) != 0xBFF8EB245CBEE3A5 { return "Tan(-1)" }
	if Float64bits(Tan(2.0)) != 0xC0017AF62E0950F8 { return "Tan(2)" }
	if Float64bits(Tan(10.0)) != 0x3FE4BF5F34BE3783 { return "Tan(10)" }
	if Float64bits(Tan(100.0)) != 0xBFE2CA74D62B5D37 { return "Tan(100)" }
	if Float64bits(Tan(1000000.0)) != 0xBFD7E9768AB734C0 { return "Tan(1e6)" }
	return ""
}

func TestTanLargeArg() testing.TestResult {
	// |x| >= 2**29 exercises trigReduce; <=1 ULP vs Go (FMA — see ulp_test.bn).
	if !nearULP(Tan(1e10), Float64frombits(0xBFE1DE000F443F51)) { return "Tan(1e10)" }
	if !nearULP(Tan(1e15), Float64frombits(0xBFFAC23600A95BE6)) { return "Tan(1e15)" }
	if !nearULP(Tan(1e20), Float64frombits(0xBFEB06FBBE995393)) { return "Tan(1e20)" }
	return ""
}

func TestTanSpecials() testing.TestResult {
	if Float64bits(Tan(Copysign(0.0, -1.0))) != 0x8000000000000000 { return "Tan(-0) should be -0" }
	if !IsNaN(Tan(Inf(1))) { return "Tan(+Inf) should be NaN" }
	if !IsNaN(Tan(NaN())) { return "Tan(NaN)" }
	return ""
}
