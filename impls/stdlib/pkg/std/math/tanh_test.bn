package "pkg/std/math"

import "pkg/builtins/testing"

func TestTanh() testing.TestResult {
	if Tanh(0.0) != 0.0 { return "Tanh(0)" }
	// Bit-exact reference values from Go's math.Tanh.
	if Float64bits(Tanh(0.5)) != 0x3FDD9353D7568AF3 { return "Tanh(0.5)" }
	if Float64bits(Tanh(1.0)) != 0x3FE85EFAB514F394 { return "Tanh(1)" }
	if Float64bits(Tanh(-1.0)) != 0xBFE85EFAB514F394 { return "Tanh(-1)" }
	if Float64bits(Tanh(0.625)) != 0x3FE1BF47EABB8F96 { return "Tanh(0.625)" }
	if Float64bits(Tanh(0.7)) != 0x3FE356FB17AF2E91 { return "Tanh(0.7)" }
	if Float64bits(Tanh(2.0)) != 0x3FEED9505E1BC3D4 { return "Tanh(2)" }
	if Float64bits(Tanh(-2.0)) != 0xBFEED9505E1BC3D4 { return "Tanh(-2)" }
	return ""
}

func TestTanhSpecials() testing.TestResult {
	// Large |x| saturates at ±1.
	if Tanh(50.0) != 1.0 { return "Tanh(50) should be 1" }
	if Tanh(-50.0) != -1.0 { return "Tanh(-50) should be -1" }
	if Tanh(Inf(1)) != 1.0 { return "Tanh(+Inf) should be 1" }
	if Tanh(Inf(-1)) != -1.0 { return "Tanh(-Inf) should be -1" }
	if !IsNaN(Tanh(NaN())) { return "Tanh(NaN)" }
	return ""
}
