package "pkg/std/math"

// Payne-Hanek argument reduction for Sin/Cos/Tan (Go's math/trig_reduce.go).
// For |x| >= reduceThreshold the simple x*(4/Pi) reduction loses too many
// bits, so the argument is reduced modulo Pi/4 using the high-precision
// binary expansion of 4/Pi (mPi4) and 128-bit fixed-point arithmetic.

// reduceThreshold is the largest |x| for which the simple Pi/4 reduction is
// accurate; at or above it, trigReduce is used.
const reduceThreshold float64 = 536870912.0 // 2**29

// mPi4 holds the binary digits of 4/Pi as a sequence of uint64 limbs.
var mPi4 [20]uint64 = [20]uint64{
		0x0000000000000001, 0x45f306dc9c882a53, 0xf84eafa3ea69bb81, 0xb6c52b3278872083,
		0xfca2c757bd778ac3, 0x6e48dc74849ba5c0, 0x0c925dd413a32439, 0xfc3bd63962534e7d,
		0xd1046bea5d768909, 0xd338e04d68befc82, 0x7323ac7306a673e9, 0x3908bf177bf25076,
		0x3ff12fffbc0b301f, 0xde5e2316b414da3e, 0xda6cfd9e4f96136e, 0x9e8c7ecd3cbfd45a,
		0xea4f758fd7cbe2f6, 0x7a0e73ef14a525d4, 0xd7f6bf623f1aba10, 0xac06608df8f6d757}

// mul64 returns the 128-bit product of x and y as (hi, lo).
func mul64(x uint64, y uint64) (uint64, uint64) {
	var x0 uint64 = x & 0xFFFFFFFF
	var x1 uint64 = x >> 32
	var y0 uint64 = y & 0xFFFFFFFF
	var y1 uint64 = y >> 32
	var w0 uint64 = x0 * y0
	var t uint64 = x1 * y0 + (w0 >> 32)
	var w1 uint64 = t & 0xFFFFFFFF
	var w2 uint64 = t >> 32
	w1 = w1 + x0 * y1
	var hi uint64 = x1 * y1 + w2 + (w1 >> 32)
	var lo uint64 = x * y
	return hi, lo
}

// add64 returns x+y+carry as (sum, carryOut), where carryOut is 0 or 1.
func add64(x uint64, y uint64, carry uint64) (uint64, uint64) {
	var sum uint64 = x + y + carry
	var carryOut uint64 = ((x & y) | ((x | y) & ~sum)) >> 63
	return sum, carryOut
}

// leadingZeros64 returns the number of leading zero bits in x (64 for x==0).
func leadingZeros64(x uint64) int {
	if x == cast(uint64, 0) {
		return 64
	}
	var n int = 0
	if x <= 0x00000000FFFFFFFF {
		n = n + 32
		x = x << 32
	}
	if x <= 0x0000FFFFFFFFFFFF {
		n = n + 16
		x = x << 16
	}
	if x <= 0x00FFFFFFFFFFFFFF {
		n = n + 8
		x = x << 8
	}
	if x <= 0x0FFFFFFFFFFFFFFF {
		n = n + 4
		x = x << 4
	}
	if x <= 0x3FFFFFFFFFFFFFFF {
		n = n + 2
		x = x << 2
	}
	if x <= 0x7FFFFFFFFFFFFFFF {
		n = n + 1
	}
	return n
}

// trigReduce reduces x (>= Pi/4) modulo Pi/4, returning the octant j (mod 8)
// and the reduced argument z in [0, Pi/4).
func trigReduce(x float64) (uint64, float64) {
	if x < Pi / 4.0 {
		return cast(uint64, 0), x
	}
	// x = ix * 2**exp with ix a 53-bit integer (implicit bit restored).
	var ix uint64 = Float64bits(x)
	var exp int = cast(int, (ix >> shift) & expMask) - cast(int, bias) - cast(int, shift)
	ix = ix & ~(expMask << shift)
	ix = ix | (cast(uint64, 1) << shift)
	// Select the three 4/Pi limbs whose product with ix has leading exponent
	// near 2**-61.
	var digit int = (exp + 61) / 64
	var bitshift uint64 = cast(uint64, (exp + 61) % 64)
	var z0 uint64 = (mPi4[digit] << bitshift) | (mPi4[digit + 1] >> (cast(uint64, 64) - bitshift))
	var z1 uint64 = (mPi4[digit + 1] << bitshift) | (mPi4[digit + 2] >> (cast(uint64, 64) - bitshift))
	var z2 uint64 = (mPi4[digit + 2] << bitshift) | (mPi4[digit + 3] >> (cast(uint64, 64) - bitshift))
	// 128-bit-ish product; keep the upper two limbs (hi, lo).
	var z2hi uint64
	z2hi, _ = mul64(z2, ix)
	var z1hi uint64
	var z1lo uint64
	z1hi, z1lo = mul64(z1, ix)
	var z0lo uint64 = z0 * ix
	var lo uint64
	var c uint64
	lo, c = add64(z1lo, z2hi, cast(uint64, 0))
	var hi uint64
	hi, _ = add64(z0lo, z1hi, c)
	// The top 3 bits are the octant j.
	var j uint64 = hi >> 61
	hi = (hi << cast(uint64, 3)) | (lo >> 61)
	// Normalize the fraction into a float64 mantissa.
	var lz uint64 = cast(uint64, leadingZeros64(hi))
	var e uint64 = bias - (lz + cast(uint64, 1))
	hi = (hi << (lz + cast(uint64, 1))) | (lo >> (cast(uint64, 64) - (lz + cast(uint64, 1))))
	hi = hi >> (cast(uint64, 64) - shift)
	hi = hi | (e << shift)
	var z float64 = Float64frombits(hi)
	// Map zeros to origin.
	if (j & cast(uint64, 1)) == cast(uint64, 1) {
		j = j + cast(uint64, 1)
		j = j & cast(uint64, 7)
		z = z - 1.0
	}
	return j, z * (Pi / 4.0)
}
