// os.Args / os.SetArgs — the program's command-line arguments.  The actual state
// (the shared `Args` slice, its bootstrap.Args()-fed init, and the argv shaping)
// lives in pkg/builtins/startup, because argv is an entry/startup concern (the
// eventual hosted `main` sets it there directly); os re-exports it so callers
// keep using the familiar os.Args()/os.SetArgs() API.  Not build-constrained —
// startup provides one definition for every target.
package "pkg/std/os"

import "pkg/builtins/startup"

// Args returns the program's command-line arguments, indexed like Go's os.Args:
// element 0 is the program name and elements 1.. are the arguments.  The result
// is a managed slice of readonly strings whose element slots are themselves
// readonly, so it is safe to share (a caller can read and reorder a private
// copy, but can neither reassign an element nor mutate the argument text).  On a
// target with no command line the result is a single empty element (the
// program-name placeholder).
//
// It hands back startup.Args unchanged — the one shared cell the compiled
// program, the C runtime, and (via os's host-native VM injection) a
// bytecode-interpreted program all agree on.
func Args() @[]readonly @[]readonly char {
	return startup.Args
}

// SetArgs replaces the arguments Args() returns and returns the PREVIOUS value,
// so a caller can save and later restore them (`old := SetArgs(new); …;
// SetArgs(old)` — the returned value flows straight back in).  newArgs is the
// whole argv (element 0 the program name, 1.. the arguments), so the caller
// controls index 0.  This is the seam cmd/bni uses to give an interpreted
// program its own argv (see explorations/design-os-args-vm.md); it delegates to
// startup.SetArgs, the single owner of the shared slice.
func SetArgs(newArgs @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	return startup.SetArgs(newArgs)
}
