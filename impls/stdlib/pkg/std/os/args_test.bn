// Gated to the hosted os variant, matching the rest of the os unit tests
// (the shared `fail` helper lives in os_test.bn; bare metal runs no host tests).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// mkArg builds an owned @[]char from a readonly literal, for a synthetic
// argument list.
func mkArg(s *[]readonly char) @[]char {
	var out @[]char = make_slice(char, len(s))
	for i := 0; i < len(s); i++ {
		out[i] = s[i]
	}
	return out
}

// TestArgvWithProgNamePrependsEmptyProgSlot checks that argvWithProgName shapes
// the result like Go's os.Args: a program-name slot at 0 (currently an empty
// placeholder) followed by the arguments as readonly views.
func TestArgvWithProgNamePrependsEmptyProgSlot() testing.TestResult {
	var src @[]@[]char = make_slice(@[]char, 2)
	src[0] = mkArg("alpha")
	src[1] = mkArg("beta")

	var got @[]readonly @[]readonly char = argvWithProgName(src)
	if len(got) != 3 {
		return fail("argv should be len(src)+1 (program slot + 2 args)")
	}
	// Element 0 is the empty program-name placeholder.
	if len(got[0]) != 0 {
		return fail("element 0 (program name) should be the empty placeholder")
	}
	// Elements 1.. are the arguments, in order, as readonly views.
	if len(got[1]) != 5 || got[1][0] != 'a' || got[1][4] != 'a' {
		return fail("element 1 should be \"alpha\"")
	}
	if len(got[2]) != 4 || got[2][0] != 'b' || got[2][3] != 'a' {
		return fail("element 2 should be \"beta\"")
	}
	return ""
}

// TestArgvWithProgNameEmptyInput checks the no-arguments case: the result is a
// single empty element (just the program-name placeholder).
func TestArgvWithProgNameEmptyInput() testing.TestResult {
	var src @[]@[]char
	var got @[]readonly @[]readonly char = argvWithProgName(src)
	if len(got) != 1 {
		return fail("no-args argv should be a single (program-name) element")
	}
	if len(got[0]) != 0 {
		return fail("the lone element should be the empty program-name placeholder")
	}
	return ""
}
