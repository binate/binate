// DirEntry accessors — pure field reads, shared by every os flavor (no build
// constraint), so a DirEntry behaves the same wherever ReadDir can produce
// one.  The receivers are *readonly because a DirEntry is a snapshot the
// accessors only read.
package "pkg/std/os"

// Name returns the entry's base name (the final path element).
func (e *readonly DirEntry) Name() @[]readonly char {
	return e.name
}

// IsDir reports whether the entry is a directory.
func (e *readonly DirEntry) IsDir() bool {
	return (e.mode & ModeDir) != cast(FileMode, 0)
}

// Type returns the entry's file-type bits.
func (e *readonly DirEntry) Type() FileMode {
	return e.mode
}
