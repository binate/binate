// Gated to the hosted os variant, matching the rest of the os unit tests
// (the shared `fail` helper lives in os_test.bn; bare metal runs no host tests).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestDirEntryAccessors checks Name / IsDir / Type on constructed DirEntry
// snapshots, and that the *readonly receivers dispatch from an @DirEntry.
func TestDirEntryAccessors() testing.TestResult {
	var nm @[]char = make_slice(char, 3)
	nm[0] = 's'
	nm[1] = 'u'
	nm[2] = 'b'
	var d @DirEntry = make(DirEntry)
	d.name = nm
	d.mode = ModeDir
	var got @[]readonly char = d.Name()
	if len(got) != 3 { return fail("Name length should be 3") }
	if got[0] != 's' || got[1] != 'u' || got[2] != 'b' { return fail("Name should be sub") }
	if !d.IsDir() { return fail("a ModeDir entry IsDir") }
	if d.Type() != ModeDir { return fail("Type should be ModeDir") }

	// A regular entry: no type bit, not a directory.
	var r @DirEntry = make(DirEntry)
	r.name = make_slice(char, 0)
	r.mode = cast(FileMode, 0)
	if r.IsDir() { return fail("a regular entry is not a dir") }
	if r.Type() != cast(FileMode, 0) { return fail("a regular entry has no type bits") }
	return ""
}
