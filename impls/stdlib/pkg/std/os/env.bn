// os.Env / os.SetEnv — the process environment ("NAME=value" strings).  Like
// os.Args/os.SetArgs, the state lives in pkg/builtins/startup (it is an
// entry/startup concern); os re-exports it as thin delegators.  For a hosted
// program the entry glue installs it from the real envp; a bare-metal or --library
// build has none, so os.Env() is empty there until a caller sets it via SetEnv.
// Not build-constrained — startup provides one definition for every target.
package "pkg/std/os"

import "pkg/builtins/startup"

// Env returns the process environment as "NAME=value" strings (POSIX environ
// order) — startup.Env() unchanged, the one shared list os and a
// host-native-injected VM program agree on.  The snapshot the hosted entry
// installed from envp, or whatever SetEnv last installed.
func Env() @[]readonly @[]readonly char {
	return startup.Env()
}

// SetEnv replaces the environment Env() returns and returns the PREVIOUS value,
// so a caller can save and restore it (`old := SetEnv(new); …; SetEnv(old)` — the
// returned value flows straight back in).  Each entry is a "NAME=value" string.
// It delegates to startup.SetEnv, the single owner of the shared list; it is the
// seam cmd/bni uses to give an interpreted program its own environment (see
// explorations/design-os-args-vm.md).
func SetEnv(newEnv @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	return startup.SetEnv(newEnv)
}
