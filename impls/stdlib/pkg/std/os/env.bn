// os.Env / os.SetEnv — the process environment ("NAME=value" strings).  Like
// os.Args/os.SetArgs, the state lives in pkg/builtins/startup (it is an
// entry/startup concern); os re-exports it as thin delegators.  For a hosted
// program the entry glue installs it from the real envp; a bare-metal or --library
// build has none, so os.Env() is empty there until a caller sets it via SetEnv.
// Not build-constrained — startup provides one definition for every target.
package "pkg/std/os"

import "pkg/builtins/startup"

// Env returns the process environment as "NAME=value" strings (POSIX environ
// order) — startup.Env() unchanged, the one shared list os and a
// host-native-injected VM program agree on.  The snapshot the hosted entry
// installed from envp, or whatever SetEnv last installed.
func Env() @[]readonly @[]readonly char {
	return startup.Env()
}

// SetEnv replaces the environment Env() returns and returns the PREVIOUS value,
// so a caller can save and restore it (`old := SetEnv(new); …; SetEnv(old)` — the
// returned value flows straight back in).  Each entry is a "NAME=value" string.
// It delegates to startup.SetEnv, the single owner of the shared list; it is the
// seam cmd/bni uses to give an interpreted program its own environment.
func SetEnv(newEnv @[]readonly @[]readonly char) @[]readonly @[]readonly char {
	return startup.SetEnv(newEnv)
}

// Getenv returns the value of environment variable `name` and whether it was
// set.  It scans the Env() snapshot — the safe, shared "NAME=value" list seeded
// from envp at startup (or installed via SetEnv) — rather than a live libc
// getenv(): the snapshot is immutable, so a lookup can't race a concurrent
// environ mutation.  A false second result means unset (value then empty); a set
// variable with an empty value returns ("", true).  Linear scan; fine for
// occasional lookups.  Env() is empty on a target with no entry snapshot (bare
// metal / --library), so every name reads as unset there.
func Getenv(name *[]readonly char) (@[]char, bool) {
	var env @[]readonly @[]readonly char = Env()
	for i := 0; i < len(env); i++ {
		var e @[]readonly char = env[i]
		// The entry must be "<name>=..." — at least len(name)+1 bytes, byte-equal
		// to name up to a '=' delimiter (so "PATHX=..." does not match "PATH").
		if len(e) < len(name) + 1 { continue }
		if e[len(name)] != '=' { continue }
		var match bool = true
		for j := 0; j < len(name); j++ {
			if e[j] != name[j] { match = false; break }
		}
		if !match { continue }
		// Copy the value (everything past the '=') into an owned slice, so it is
		// independent of the shared snapshot.
		var vlen int = len(e) - len(name) - 1
		var val @[]char = make_slice(char, vlen)
		for j := 0; j < vlen; j++ {
			val[j] = e[len(name) + 1 + j]
		}
		return val, true
	}
	var empty @[]char
	return empty, false
}
