// Gated to the hosted os variant, matching the rest of the os unit tests
// (the shared `fail` helper lives in os_test.bn, `mkArg` in args_test.bn; bare
// metal runs no host tests).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestSetEnvRoundTripsThroughStartup checks the os -> startup delegation for the
// environment: os.SetEnv installs a new env that os.Env() then reflects, returns
// the previous value, and feeding it back restores it.  The shared `env` and its
// logic live in pkg/builtins/startup (with its own unit tests); this only pins
// that os.Env/os.SetEnv forward to it correctly.  The state is process-wide, so
// this saves and restores around the test.
func TestSetEnvRoundTripsThroughStartup() testing.TestResult {
	var originalLen int = len(Env())

	var newEnv @[]@[]readonly char = make_slice(@[]readonly char, 1)
	newEnv[0] = mkArg("K=v")
	var widened @[]readonly @[]readonly char = newEnv

	var prev @[]readonly @[]readonly char = SetEnv(widened)
	var cur @[]readonly @[]readonly char = Env()
	SetEnv(prev) // restore
	var restoredLen int = len(Env())

	if len(prev) != originalLen {
		return fail("SetEnv should return the previous env")
	}
	if len(cur) != 1 || len(cur[0]) != 3 {
		return fail("Env() should reflect the installed env (K=v)")
	}
	if cur[0][0] != 'K' {
		return fail("Env() content should be the installed env")
	}
	if restoredLen != originalLen {
		return fail("restoring the previous value should bring Env() back")
	}
	return ""
}
