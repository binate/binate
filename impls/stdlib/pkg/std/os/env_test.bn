// Gated to the hosted os variant, matching the rest of the os unit tests
// (the shared `fail` helper lives in os_test.bn, `mkArg` in args_test.bn; bare
// metal runs no host tests).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestSetEnvRoundTripsThroughStartup checks the os -> startup delegation for the
// environment: os.SetEnv installs a new env that os.Env() then reflects, returns
// the previous value, and feeding it back restores it.  The shared `env` and its
// logic live in pkg/builtins/startup (with its own unit tests); this only pins
// that os.Env/os.SetEnv forward to it correctly.  The state is process-wide, so
// this saves and restores around the test.
func TestSetEnvRoundTripsThroughStartup() testing.TestResult {
	var originalLen int = len(Env())

	var newEnv @[]@[]readonly char = make_slice(@[]readonly char, 1)
	newEnv[0] = mkArg("K=v")
	var widened @[]readonly @[]readonly char = newEnv

	var prev @[]readonly @[]readonly char = SetEnv(widened)
	var cur @[]readonly @[]readonly char = Env()
	SetEnv(prev) // restore
	var restoredLen int = len(Env())

	if len(prev) != originalLen {
		return fail("SetEnv should return the previous env")
	}
	if len(cur) != 1 || len(cur[0]) != 3 {
		return fail("Env() should reflect the installed env (K=v)")
	}
	if cur[0][0] != 'K' {
		return fail("Env() content should be the installed env")
	}
	if restoredLen != originalLen {
		return fail("restoring the previous value should bring Env() back")
	}
	return ""
}

// TestGetenv checks os.Getenv reads the Env() snapshot: a present NAME=value
// yields (value, true), an empty value yields ("", true), and an absent name
// yields ("", false).  A known env is installed via SetEnv (restored after) so
// the test does not depend on the ambient environment.  The "FOOBAR" entry plus
// a lookup of the strict prefix "FOOB" exercise the '='-delimited match: a
// prefix of an entry name must NOT count as present (without the delimiter
// check "FOOB" would spuriously match "FOOBAR").
func TestGetenv() testing.TestResult {
	var newEnv @[]@[]readonly char = make_slice(@[]readonly char, 3)
	newEnv[0] = mkArg("FOO=bar")
	newEnv[1] = mkArg("EMPTY=")
	newEnv[2] = mkArg("FOOBAR=x")
	var widened @[]readonly @[]readonly char = newEnv
	var prev @[]readonly @[]readonly char = SetEnv(widened)

	var v @[]char
	var ok bool
	v, ok = Getenv("FOO")
	var fooOk bool = ok && len(v) == 3 && v[0] == 'b' && v[1] == 'a' && v[2] == 'r'

	var v2 @[]char
	var ok2 bool
	v2, ok2 = Getenv("EMPTY")
	var emptyOk bool = ok2 && len(v2) == 0

	var v3 @[]char
	var ok3 bool
	v3, ok3 = Getenv("ABSENT")
	var absentOk bool = !ok3 && len(v3) == 0

	// FOOBAR is a distinct entry (not confused with FOO)...
	var v4 @[]char
	var ok4 bool
	v4, ok4 = Getenv("FOOBAR")
	var foobarOk bool = ok4 && len(v4) == 1 && v4[0] == 'x'

	// ...and "FOOB", a strict prefix of the entry name "FOOBAR" that is not
	// itself an entry, must read as unset — the delimiter guard rejects it.
	var v5 @[]char
	var ok5 bool
	v5, ok5 = Getenv("FOOB")
	var prefixRejected bool = !ok5 && len(v5) == 0

	SetEnv(prev) // restore before any early return

	if !fooOk { return fail("Getenv(FOO) should be (bar, true)") }
	if !emptyOk { return fail("Getenv(EMPTY) should be (empty, true)") }
	if !absentOk { return fail("Getenv(ABSENT) should be (empty, false)") }
	if !foobarOk { return fail("Getenv(FOOBAR) should be (x, true)") }
	if !prefixRejected { return fail("Getenv(FOOB) must not prefix-match FOOBAR") }
	return ""
}
