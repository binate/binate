// FileInfo accessors — pure field reads on an immutable snapshot, shared by
// every os flavor (no build constraint).  The receivers are *readonly because
// a FileInfo is a snapshot the accessors only read.
package "pkg/std/os"

import "pkg/std/time"

// Name returns the base name of the file.
func (fi *readonly FileInfo) Name() @[]readonly char {
	return fi.name
}

// Size returns the length in bytes.
func (fi *readonly FileInfo) Size() int64 {
	return fi.size
}

// Mode returns the file's mode and permission bits.
func (fi *readonly FileInfo) Mode() FileMode {
	return fi.mode
}

// ModTime returns the file's modification time.
func (fi *readonly FileInfo) ModTime() time.Point {
	return fi.modTime
}

// IsDir reports whether the file is a directory.
func (fi *readonly FileInfo) IsDir() bool {
	return fi.Mode().IsDir()
}
