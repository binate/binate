// FileMode accessors — pure bit logic, shared by every os flavor (no build
// constraint), so a FileMode behaves the same on a hosted or freestanding
// target.
package "pkg/std/os"

// IsDir reports whether m describes a directory.
func (m FileMode) IsDir() bool {
	return (m & ModeDir) != cast(FileMode, 0)
}

// IsRegular reports whether m describes a regular file (no type bit set).
func (m FileMode) IsRegular() bool {
	return (m & ModeType) == cast(FileMode, 0)
}

// Perm returns the Unix permission bits of m.
func (m FileMode) Perm() FileMode {
	return m & ModePerm
}

// Type returns the type bits of m.
func (m FileMode) Type() FileMode {
	return m & ModeType
}

// String renders m the way Go's os.FileMode does: one letter per set type or
// special bit, highest bit first — `dalTLDpSugct?` for ModeDir .. ModeIrregular
// — or `-` when none is set, then the nine permission characters `rwxrwxrwx`,
// each `-` when its bit is clear.  So a 0o755 directory renders "drwxr-xr-x", a
// 0o644 regular file "-rw-r--r--", and a setuid 0o755 file "urwxr-xr-x".  The
// result is freshly allocated (lang.Stringer).
func (m FileMode) String() @[]char {
	var letters *[]readonly char = "dalTLDpSugct?"
	var rwx *[]readonly char = "rwxrwxrwx"
	var buf [22]char // at most 13 letters + 9 permission characters
	var w int = 0
	for i := 0; i < len(letters); i++ {
		if (m & (cast(FileMode, 1) << cast(uint, 31 - i))) != cast(FileMode, 0) {
			buf[w] = letters[i]
			w = w + 1
		}
	}
	if w == 0 {
		buf[w] = '-'
		w = w + 1
	}
	for i := 0; i < len(rwx); i++ {
		if (m & (cast(FileMode, 1) << cast(uint, 8 - i))) != cast(FileMode, 0) {
			buf[w] = rwx[i]
		} else {
			buf[w] = '-'
		}
		w = w + 1
	}
	var out @[]char = make_slice(char, w)
	for i := 0; i < w; i++ {
		out[i] = buf[i]
	}
	return out
}
