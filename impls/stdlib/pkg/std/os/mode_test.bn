// Gated to the hosted os variant, matching the rest of the os unit tests
// (the shared `fail` helper lives in os_test.bn; bare metal runs no host tests).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

// TestFileMode checks the FileMode type/permission-bit accessors.
func TestFileMode() testing.TestResult {
	// A directory with rwxr-xr-x.
	var dir FileMode = ModeDir | cast(FileMode, 0o755)
	if !dir.IsDir() { return fail("ModeDir should be IsDir") }
	if dir.IsRegular() { return fail("a directory is not regular") }
	if dir.Perm() != cast(FileMode, 0o755) { return fail("Perm should be 0o755") }
	if dir.Type() != ModeDir { return fail("Type should be ModeDir") }
	// A regular file (no type bit) that is setuid, rwsr-xr-x.  Setuid is a
	// special bit, NOT a type bit, so the file is still regular.
	var reg FileMode = ModeSetuid | cast(FileMode, 0o755)
	if reg.IsDir() { return fail("a setuid file is not a dir") }
	if !reg.IsRegular() { return fail("no type bit means regular") }
	if reg.Perm() != cast(FileMode, 0o755) { return fail("setuid is not a perm bit") }
	if reg.Type() != cast(FileMode, 0) { return fail("a regular file has no type bits") }
	// A symlink.
	var lnk FileMode = ModeSymlink | cast(FileMode, 0o777)
	if lnk.IsRegular() { return fail("a symlink is not regular") }
	if lnk.IsDir() { return fail("a symlink is not a dir") }
	if lnk.Type() != ModeSymlink { return fail("Type should be ModeSymlink") }
	// Bit positions are Go's exact layout (also checks the high-bit shifts).
	if ModeDir != cast(FileMode, 0x80000000) { return fail("ModeDir should be 1<<31") }
	if ModeSticky != cast(FileMode, 0x00100000) { return fail("ModeSticky should be 1<<20") }
	if ModeIrregular != cast(FileMode, 0x00080000) { return fail("ModeIrregular should be 1<<19") }
	return ""
}

// charsAre reports whether got is exactly want.
func charsAre(got *[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] { return false }
	}
	return true
}

// modeStrIs reports whether m.String() is exactly want.
func modeStrIs(m FileMode, want *[]readonly char) bool {
	var got @[]char = m.String()
	return charsAre(got, want)
}

// TestFileModeString checks FileMode.String against Go's os.FileMode rendering.
func TestFileModeString() testing.TestResult {
	if !modeStrIs(cast(FileMode, 0), "----------") { return fail("zero mode") }
	if !modeStrIs(cast(FileMode, 0o644), "-rw-r--r--") { return fail("regular 0o644") }
	if !modeStrIs(ModeDir | cast(FileMode, 0o755), "drwxr-xr-x") { return fail("dir 0o755") }
	if !modeStrIs(ModeSymlink | cast(FileMode, 0o777), "Lrwxrwxrwx") { return fail("symlink") }
	if !modeStrIs(ModeSetuid | cast(FileMode, 0o755), "urwxr-xr-x") { return fail("setuid") }
	// Several special bits: letters in bit order, highest first.
	if !modeStrIs(ModeDir | ModeSticky | cast(FileMode, 0o777), "dtrwxrwxrwx") {
		return fail("sticky dir")
	}
	if !modeStrIs(ModeDevice | ModeCharDevice | cast(FileMode, 0o620), "Dcrw--w----") {
		return fail("char device")
	}
	if !modeStrIs(ModeNamedPipe | cast(FileMode, 0o600), "prw-------") { return fail("fifo") }
	if !modeStrIs(ModeSocket | cast(FileMode, 0o755), "Srwxr-xr-x") { return fail("socket") }
	if !modeStrIs(ModeIrregular | cast(FileMode, 0o400), "?r--------") { return fail("irregular") }
	return ""
}

// TestFileModeStringer checks that FileMode dispatches String through
// *lang.Stringer (the impl in os.bni), which is how fmt renders it.
func TestFileModeStringer() testing.TestResult {
	var m FileMode = ModeDir | cast(FileMode, 0o750)
	var s *lang.Stringer = &m
	var got @[]char = s.String()
	if !charsAre(got, "drwxr-x---") { return fail("String through *lang.Stringer") }
	return ""
}
