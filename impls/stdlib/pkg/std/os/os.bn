// libc-backed pkg/std/os: the File handle and the high-level file API (Open /
// OpenFile / Create / Read / Write / Seek / Rename / Remove / Mkdir / Exit).  All
// of its raw syscalls go through the pkg/std/os/sys layer (including stat and
// readdir, in stat.bn / readdir.bn), which retries EINTR and classifies errno;
// this file supplies the stream semantics on top (empty read, EOF, short write),
// the portable O_* -> native flag translation, and the FileInfo/DirEntry glue.
//
// Selected on every target except bare metal, which has its own stub variant
// (os_baremetal.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/build"
import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os/sys"

// Open flags, mirrored from os.bni (the two must stay in sync — the
// .bni copy is the exported surface, this copy is what this impl's own
// code translates).  Binate's own portable values; nativeOpenFlags maps
// them onto the host's native open(2) flags.
const (
	O_RDONLY int = 0x0000
	O_WRONLY int = 0x0001
	O_RDWR int = 0x0002

	O_APPEND int = 0x0008
	O_CREATE int = 0x0010
	O_EXCL int = 0x0020
	O_TRUNC int = 0x0040
	O_SYNC int = 0x0080
)

// nativeOpenFlags maps the portable O_* bits to the host libc's native
// open(2) flags, selecting the OS at COMPILE TIME via build.OS — a
// per-target constant from pkg/builtins/build that the compiler folds,
// so there is no runtime OS check.  The three access modes
// (O_RDONLY/WRONLY/RDWR = 0/1/2) are identical on every POSIX OS and
// pass straight through; only the modifier bits diverge between Linux
// and macOS.  This libc impl is only compiled for a libc OS (Linux or
// Darwin) — the bare-metal flavor is a separate package — so the two
// arms are exhaustive.
func nativeOpenFlags(flag int) int {
	var native int = flag & 0x3 // access mode: identical on every POSIX OS
	if build.OS == build.OS_DARWIN {
		if flag & O_APPEND != 0 { native = native | 0x0008 } // macOS O_APPEND
		if flag & O_CREATE != 0 { native = native | 0x0200 } // macOS O_CREAT
		if flag & O_EXCL != 0 { native = native | 0x0800 } // macOS O_EXCL
		if flag & O_TRUNC != 0 { native = native | 0x0400 } // macOS O_TRUNC
		if flag & O_SYNC != 0 { native = native | 0x0080 } // macOS O_SYNC
	} else {
		// Linux (asm-generic; x86_64 / aarch64 / arm32 all share these).
		if flag & O_APPEND != 0 { native = native | 0x0400 } // Linux O_APPEND
		if flag & O_CREATE != 0 { native = native | 0x0040 } // Linux O_CREAT
		if flag & O_EXCL != 0 { native = native | 0x0080 } // Linux O_EXCL
		if flag & O_TRUNC != 0 { native = native | 0x0200 } // Linux O_TRUNC
		if flag & O_SYNC != 0 { native = native | 0x101000 } // Linux O_SYNC (compound)
	}
	return native
}

// cloneChars copies a borrowed char slice into a fresh owned one, so a path
// (Open) or name (Stat) can be retained past the borrow's statement lifetime.
func cloneChars(s *[]readonly char) @[]char {
	var n int = len(s)
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = s[i]
	}
	return out
}

// basename returns an owned copy of the final '/'-separated component of a
// path ("/a/b/c" -> "c", "c" -> "c", "/a/b/" -> ""), for a FileInfo's Name.
func basename(s *[]readonly char) @[]char {
	var n int = len(s)
	var start int = n
	for start > 0 && s[start - 1] != '/' {
		start = start - 1
	}
	var m int = n - start
	var out @[]char = make_slice(char, m)
	for i := 0; i < m; i++ {
		out[i] = s[start + i]
	}
	return out
}

// newFile boxes a raw descriptor and the path it was opened with into an
// owned @File; name is cloned so the File owns it independent of the caller.
func newFile(fd int, name *[]readonly char) @File {
	var f @File = make(File)
	f.fd = fd
	f.name = cloneChars(name)
	return f
}

// Read reads into p via read(2).  read returning 0 on a non-empty p is
// end-of-input → io.EOF.  A read interrupted by a signal before any byte
// moved (-1/EINTR) is retried, so EINTR never leaks to the caller — a
// partial read returns the short count, not EINTR, so re-issuing is safe.
func (f *File) Read(p *[]uint8) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	var err @errors.Error
	n, err = sys.Read(f.fd, p)
	if present(err) { return 0, err }
	if n == 0 { return 0, io.EOF }
	return n, noErr
}

// Write writes p via write(2).  A short write (n < len(p)) is reported
// with an error, as io.Writer requires.
func (f *File) Write(p *[]readonly uint8) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	var err @errors.Error
	n, err = sys.Write(f.fd, p)
	if present(err) { return 0, err }
	if n < len(p) { return n, errors.Wrap(errors.Unknown, "short write") }
	return n, noErr
}

// Close closes the descriptor via close(2).
func (f *File) Close() @errors.Error {
	return sys.Close(f.fd)
}

// ReadAt reads at an explicit offset via pread(2), leaving the stream
// position untouched.  A read that cannot fill p (including at EOF)
// returns io.EOF, honoring the io.ReaderAt "n < len(p) ⟹ error"
// contract; for a regular file a short pread means end-of-file.
func (f *File) ReadAt(p *[]uint8, off int64) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	var err @errors.Error
	n, err = sys.Pread(f.fd, p, off)
	if present(err) { return 0, err }
	if n < len(p) { return n, io.EOF }
	return n, noErr
}

// WriteAt writes at an explicit offset via pwrite(2), leaving the stream
// position untouched.
func (f *File) WriteAt(p *[]readonly uint8, off int64) (int, @errors.Error) {
	var noErr @errors.Error
	if len(p) == 0 { return 0, noErr }
	var n int
	var err @errors.Error
	n, err = sys.Pwrite(f.fd, p, off)
	if present(err) { return 0, err }
	if n < len(p) { return n, errors.Wrap(errors.Unknown, "short write") }
	return n, noErr
}

// Seek repositions the stream via lseek(2).  The portable Whence values
// (0/1/2) equal the native SEEK_SET/CUR/END on every POSIX target, so
// no translation is needed.  Unlike read/write, lseek does not block, so it
// cannot return EINTR — no retry loop is needed.
func (f *File) Seek(offset int64, whence Whence) (int64, @errors.Error) {
	return sys.Lseek(f.fd, offset, cast(int, whence))
}

// ReadByte reads the next byte via Read.  At end-of-input the error is
// io.EOF and the returned byte is unspecified (io.ByteReader), so callers
// must check the error first.  A one-byte stack buffer avoids a heap
// allocation per call.
func (f *File) ReadByte() (uint8, @errors.Error) {
	var b [1]uint8
	var err @errors.Error
	_, err = f.Read(b[0:1])
	if present(err) { return cast(uint8, 0), err }
	return b[0], err
}

// WriteByte writes a single byte via Write.
func (f *File) WriteByte(c uint8) @errors.Error {
	var b [1]uint8
	b[0] = c
	var err @errors.Error
	_, err = f.Write(b[0:1])
	return err
}

// OpenFile opens name via open(2).  mode is always passed (open ignores
// it without O_CREATE) as the trailing vararg, per the C prototype
// `int open(const char *, int, ...)`.
func OpenFile(name *[]readonly char, flag int, perm FileMode) (@File, @errors.Error) {
	var fd int
	var err @errors.Error
	fd, err = sys.Open(name, nativeOpenFlags(flag), cast(int, perm))
	if present(err) {
		var none @File
		return none, err
	}
	return newFile(fd, name), errEmpty()
}

// Open opens name read-only.  Open is OpenFile(name, O_RDONLY, 0).
func Open(name *[]readonly char) (@File, @errors.Error) {
	return OpenFile(name, O_RDONLY, cast(FileMode, 0))
}

// Create creates or truncates name for read-write with mode 0o666.
// Create is OpenFile(name, O_RDWR|O_CREATE|O_TRUNC, 0o666).
func Create(name *[]readonly char) (@File, @errors.Error) {
	return OpenFile(name, O_RDWR | O_CREATE | O_TRUNC, cast(FileMode, 0o666))
}

// Rename renames (moves) oldpath to newpath via rename(2).  When newpath
// exists and is not a directory it is replaced atomically; the rename is
// atomic within a single filesystem (a cross-filesystem rename fails with
// EXDEV -- rename(2) does not copy across devices).
func Rename(oldpath *[]readonly char, newpath *[]readonly char) @errors.Error {
	return sys.Rename(oldpath, newpath)
}

// Remove removes (deletes) the named file or empty directory via remove(3),
// which unlink(2)s a regular file and rmdir(2)s a directory -- so Remove
// handles both, matching Go's os.Remove; removing a non-empty directory fails
// (ENOTEMPTY).
func Remove(name *[]readonly char) @errors.Error {
	return sys.Remove(name)
}

// Mkdir creates the directory `name` with permission bits `perm` (before the
// process umask), via mkdir(2).  It fails if name already exists
// (errors.AlreadyExists) or a parent component is missing (errors.NotFound) --
// use MkdirAll to create missing parents.  On a bare-metal target, which has no
// filesystem, it always fails.
func Mkdir(name *[]readonly char, perm FileMode) @errors.Error {
	return sys.Mkdir(name, cast(int, perm))
}

// MkdirTemp creates a new uniquely-named directory inside `dir` whose name starts
// with `prefix`, and returns its path.  The directory is created atomically with
// 0700 permissions, so two callers racing on the same (dir, prefix) get distinct
// directories — the isolation-by-default primitive for scratch/build space.  On a
// bare-metal target, which has no filesystem, it always fails.
func MkdirTemp(dir *[]readonly char, prefix *[]readonly char) (@[]char, @errors.Error) {
	// Build "<dir>/<prefix>XXXXXX" as the mkdtemp(3) template (six trailing X's
	// are the required placeholder).  Assembled by hand to avoid importing a
	// string builder into this widely-imported package.
	var suffix *[]readonly char = "XXXXXX"
	var n int = len(dir) + 1 + len(prefix) + len(suffix)
	var t @[]char = make_slice(char, n)
	var k int = 0
	for i := 0; i < len(dir); i++ { t[k] = dir[i]; k = k + 1 }
	t[k] = '/'
	k = k + 1
	for i := 0; i < len(prefix); i++ { t[k] = prefix[i]; k = k + 1 }
	for i := 0; i < len(suffix); i++ { t[k] = suffix[i]; k = k + 1 }
	return sys.MkdirTemp(t)
}

// MkdirAll creates `path` and every missing parent directory, each with
// permission bits `perm` (before umask).  If path is already a directory it
// succeeds without error (idempotent); a component that exists as a
// non-directory, or any other creation failure, is returned.  On a bare-metal
// target it always fails.
func MkdirAll(path *[]readonly char, perm FileMode) @errors.Error {
	// Already a directory?  Then done -- idempotent, AND it terminates the
	// recursion at the first existing ancestor.  Stat FOLLOWS symlinks, so a
	// symlinked directory (e.g. macOS /tmp -> /private/tmp) counts as one, which
	// a non-following Lstat would miss and wrongly treat as a fatal EEXIST.
	var sfi @FileInfo
	var serr @errors.Error
	sfi, serr = Stat(path)
	if !present(serr) && sfi.IsDir() {
		return errEmpty()
	}
	// Trim trailing '/'; an empty or all-slash path resolves to the root, which
	// always exists -- nothing to create.
	var end int = len(path)
	for end > 0 && path[end - 1] == '/' {
		end = end - 1
	}
	if end == 0 {
		return errEmpty()
	}
	// Create the parent (everything up to the last '/') first, recursively.
	var start int = end
	for start > 0 && path[start - 1] != '/' {
		start = start - 1
	}
	if start > 1 {
		var perr @errors.Error = MkdirAll(path[0:start - 1], perm)
		if present(perr) {
			return perr
		}
	}
	// Create this directory.  Tolerate a concurrent creator that made it a
	// directory in the meantime (re-check with Stat); anything else -- e.g. the
	// path exists as a file -- surfaces Mkdir's error (AlreadyExists).
	var merr @errors.Error = Mkdir(path[0:end], perm)
	if !present(merr) {
		return errEmpty()
	}
	var fi @FileInfo
	var lerr @errors.Error
	fi, lerr = Stat(path[0:end])
	if !present(lerr) && fi.IsDir() {
		return errEmpty()
	}
	return merr
}

// Exit terminates the process via C exit(3) with the given status code.
// exit(3) is noreturn, so control never reaches the end of this function.
func Exit(code int) {
	sys.Exit(code)
}

// errEmpty is the empty (no-error) @errors.Error returned on success.
func errEmpty() @errors.Error {
	var noErr @errors.Error
	return noErr
}

// Stdin is the standard input stream, wrapping descriptor 0.  A
// process-lifetime handle — never Close it.
var Stdin @File = newFile(0, "/dev/stdin")

// Stdout is the standard output stream, wrapping descriptor 1.  A
// process-lifetime handle — never Close it.
var Stdout @File = newFile(1, "/dev/stdout")

// Stderr is the standard error stream, wrapping descriptor 2.  A
// process-lifetime handle — never Close it.
var Stderr @File = newFile(2, "/dev/stderr")
