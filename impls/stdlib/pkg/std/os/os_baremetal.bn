// Bare-metal pkg/std/os: a freestanding target has no filesystem, so
// every File operation and every Open / OpenFile / Create fails.  The
// package exists so that code importing pkg/std/os still links on a
// bare-metal target — it simply cannot touch files there.  The standard
// streams are empty @File handles (test with `present`).  Gated to bare-metal
// targets by its #[build(...)] constraint; every other target uses the hosted
// (libc) variant in os.bn.
#[build(is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/semihost"
import "pkg/std/errors"

// errNoFS is the failure every operation returns.  It roots in
// errors.Unimplemented (not a bare Unsupported): a freestanding
// filesystem is conceivable, this target just doesn't provide one.
func errNoFS() @errors.Error {
	return errors.Rooted(errors.Unimplemented, "os: no filesystem on a freestanding target")
}

// Read always fails: there is no filesystem to read from on a bare-metal
// target.
func (f *File) Read(p *[]uint8) (int, @errors.Error) {
	return 0, errNoFS()
}

// Write always fails: there is no filesystem to write to on a bare-metal
// target.
func (f *File) Write(p *[]readonly uint8) (int, @errors.Error) {
	return 0, errNoFS()
}

// Close always fails: there is no open file to close on a bare-metal target.
func (f *File) Close() @errors.Error {
	return errNoFS()
}

// ReadAt always fails: there is no filesystem to read from on a bare-metal
// target.
func (f *File) ReadAt(p *[]uint8, off int64) (int, @errors.Error) {
	return 0, errNoFS()
}

// WriteAt always fails: there is no filesystem to write to on a bare-metal
// target.
func (f *File) WriteAt(p *[]readonly uint8, off int64) (int, @errors.Error) {
	return 0, errNoFS()
}

// Seek always fails: there is no open file to seek within on a bare-metal
// target.
func (f *File) Seek(offset int64, whence Whence) (int64, @errors.Error) {
	return cast(int64, 0), errNoFS()
}

// ReadByte always fails: there is no filesystem to read from on a bare-metal
// target.
func (f *File) ReadByte() (uint8, @errors.Error) {
	return cast(uint8, 0), errNoFS()
}

// WriteByte always fails: there is no filesystem to write to on a bare-metal
// target.
func (f *File) WriteByte(c uint8) @errors.Error {
	return errNoFS()
}

// Stat always fails: there is no filesystem to stat on a bare-metal target.
func (f *File) Stat() (@FileInfo, @errors.Error) {
	var none @FileInfo
	return none, errNoFS()
}

// Open always fails: there is no filesystem to open files from on a
// bare-metal target.
func Open(name *[]readonly char) (@File, @errors.Error) {
	var none @File
	return none, errNoFS()
}

// OpenFile always fails: there is no filesystem to open files from on a
// bare-metal target.
func OpenFile(name *[]readonly char, flag int, perm FileMode) (@File, @errors.Error) {
	var none @File
	return none, errNoFS()
}

// Create always fails: there is no filesystem to create files in on a
// bare-metal target.
func Create(name *[]readonly char) (@File, @errors.Error) {
	var none @File
	return none, errNoFS()
}

// Rename always fails: there is no filesystem to rename within on a
// bare-metal target.
func Rename(oldpath *[]readonly char, newpath *[]readonly char) @errors.Error {
	return errNoFS()
}

// Remove always fails: there is no filesystem to remove from on a
// bare-metal target.
func Remove(name *[]readonly char) @errors.Error {
	return errNoFS()
}

// Stat always fails: there is no filesystem to stat on a bare-metal target.
func Stat(name *[]readonly char) (@FileInfo, @errors.Error) {
	var none @FileInfo
	return none, errNoFS()
}

// Lstat always fails: there is no filesystem to stat on a bare-metal target.
func Lstat(name *[]readonly char) (@FileInfo, @errors.Error) {
	var none @FileInfo
	return none, errNoFS()
}

// ReadDir always fails: there is no filesystem to read directories from on a
// bare-metal target.
func ReadDir(name *[]readonly char) (@[]@DirEntry, @errors.Error) {
	var none @[]@DirEntry
	return none, errNoFS()
}

// Exit terminates via the semihosting SYS_EXIT host call — the bare-metal
// exit primitive.  SemihostExit is noreturn, but the host honoring it isn't
// statically known, so a defensive spin loop follows to give the void
// function a terminating path.
func Exit(code int) {
	semihost.SemihostExit(code)
	for {}
}

// Stdin is an empty @File handle: a bare-metal target has no standard input.
var Stdin @File

// Stdout is an empty @File handle: a bare-metal target has no standard output.
var Stdout @File

// Stderr is an empty @File handle: a bare-metal target has no standard error.
var Stderr @File
