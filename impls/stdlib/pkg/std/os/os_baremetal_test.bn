// Gated to bare metal: the freestanding os stub fails every file operation.
// Runs only under a bare-metal unit-test build; `fail` (os_test.bn) is hosted-
// only, so this returns the message string directly.
#[build(is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestBaremetalNoFS confirms Open fails on a freestanding target (no filesystem).
func TestBaremetalNoFS() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Open("/anything")
	_ = f
	if !present(err) {
		return "Open must fail on a freestanding target (no filesystem)"
	}
	return ""
}
