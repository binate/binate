// Gated to Linux: exercises the Linux errno() accessor (os_errno_linux.bn).
#[build(is(os, "linux"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestErrnoLinux checks errno() returns the live C errno: a failed open of a
// nonexistent path leaves errno == ENOENT.
func TestErrnoLinux() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Open("/no_such_path_errno_probe_zzzzz")
	_ = f
	if !present(err) { return fail("open of a nonexistent path should fail") }
	if errno() != ENOENT { return fail("errno() should be ENOENT after the failed open") }
	return ""
}
