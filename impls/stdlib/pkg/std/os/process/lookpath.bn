// PATH resolution for the hosted runner: LookPath and the manual PATH walk over
// sys.Accessible (there is no portable execvpe, so search is done in Binate; the
// walk resolves in the PARENT, so a not-found/permission failure is a clean typed
// error before any fork).  errno is hidden — sys.Accessible returns a classified
// error, and the walk branches on errors.Is(..., PermissionDenied).  Hosted only.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/std/errors"
import "pkg/std/os/sys"

// LookPath resolves `program` to a concrete executable path.  A name containing
// '/' is returned as-is when executable; otherwise it is searched along the
// ambient PATH.
//
// Note (v1): the search always consults the ambient PATH (via sys.Getenv), even
// when a caller replaces the environment via Options.Env — an env-aware search is
// a future refinement.
func LookPath(program *[]readonly char) (@[]char, @errors.Error) {
	if hasSlash(program) {
		var err @errors.Error = sys.Accessible(program)
		if present(err) {
			var empty @[]char
			return empty, err
		}
		var noErr @errors.Error
		return cloneChars(program), noErr
	}
	return lookPathIn(program, ambientPath())
}

// lookPathIn walks `path` (a ':'-separated PATH), trying dir + "/" + program for
// each entry (an empty entry means the current directory), and returns the first
// that is executable.  A missing/non-directory entry skips to the next; a
// permission failure is remembered and reported if the walk exhausts (matching
// execvp).
func lookPathIn(program *[]readonly char, path *[]readonly char) (@[]char, @errors.Error) {
	var empty @[]char
	if len(program) == 0 {
		return empty, errors.Rooted(errors.NotFound, "os/process: empty program name")
	}
	var sawPerm bool = false
	var start int = 0
	var i int = 0
	for i <= len(path) {
		if i == len(path) || path[i] == ':' {
			var cand @[]char
			if i == start {
				cand = cloneChars(program) // empty PATH entry => current directory
			} else {
				cand = joinChars(path, start, i, program)
			}
			var err @errors.Error = sys.Accessible(cand)
			if !present(err) {
				var noErr @errors.Error
				return cand, noErr
			}
			// Skip to the next entry on ANY access failure (not only
			// not-found), remembering a permission failure to report if the
			// walk exhausts — matching execvp, and broader than the design's
			// illustrative ENOENT/ENOTDIR phrasing.
			if errors.Is(err, errors.PermissionDenied) {
				sawPerm = true
			}
			start = i + 1
		}
		i = i + 1
	}
	if sawPerm {
		return empty,
			errors.Rooted(errors.PermissionDenied, "os/process: found in PATH but not executable")
	}
	return empty, errors.Rooted(errors.NotFound, "os/process: executable not found in PATH")
}

// ambientPath returns the process's PATH (via sys.Getenv), or the POSIX default
// "/usr/bin:/bin" when it is unset.
func ambientPath() @[]char {
	var v @[]char
	var ok bool
	v, ok = sys.Getenv("PATH")
	if !ok {
		return cloneChars("/usr/bin:/bin")
	}
	return v
}

// hasSlash reports whether s contains a '/'.
func hasSlash(s *[]readonly char) bool {
	for i := 0; i < len(s); i++ {
		if s[i] == '/' {
			return true
		}
	}
	return false
}

// joinChars returns path[start:end] + "/" + program as an owned slice.
func joinChars(path *[]readonly char, start int, end int, program *[]readonly char) @[]char {
	var dn int = end - start
	var pn int = len(program)
	var out @[]char = make_slice(char, dn + 1 + pn)
	for i := 0; i < dn; i++ {
		out[i] = path[start + i]
	}
	out[dn] = '/'
	for i := 0; i < pn; i++ {
		out[dn + 1 + i] = program[i]
	}
	return out
}
