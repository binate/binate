// Tests for PATH resolution (lookpath.bn): an absolute path and a PATH search.
// Uses the shared `fail` (process_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/builtins/testing"
import "pkg/std/errors"

// LookPath on an absolute path returns it when executable.
func TestLookPathAbsolute() testing.TestResult {
	var p @[]char
	var err @errors.Error
	p, err = LookPath("/usr/bin/true")
	if present(err) {
		return fail("LookPath(/usr/bin/true) should succeed")
	}
	if len(p) == 0 {
		return fail("LookPath returned an empty path")
	}
	return ""
}

// LookPath on a missing absolute path is a NotFound error.
func TestLookPathMissing() testing.TestResult {
	var err @errors.Error
	_, err = LookPath("/nonexistent/binate/prog")
	if !present(err) {
		return fail("LookPath of a missing path should fail")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a missing path should classify NotFound")
	}
	return ""
}
