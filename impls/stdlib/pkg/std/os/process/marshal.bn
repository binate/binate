// char** / C-string marshalling for the process runner, plus the wait-status
// decoder.  The raw syscalls, EINTR retry, and errno classification live in
// pkg/std/os/sys; this file only builds the argv/envp arrays (a process-specific
// shape) and decodes the wait status (process semantics — the WIF* macros aren't
// linkable, so os/sys returns the raw word and os/process decodes it).  Hosted
// only.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

// dataOfManaged returns the data pointer of a managed byte slice (its first word),
// for handing to a syscall as a C `char*`.
func dataOfManaged(p @[]uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// dataOfPtrs returns the data pointer of a managed pointer array — a `char**` when
// the slice is a NUL-terminated array of C strings.  A managed slice's data lives
// at offset 0 regardless of element type, so this is the same reinterpretation as
// dataOfManaged with a pointer element width.
func dataOfPtrs(p @[]*uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// cStr copies a char borrow into a fresh NUL-terminated byte buffer.
func cStr(s *[]readonly char) @[]uint8 {
	var n int = len(s)
	var buf @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ {
		buf[i] = cast(uint8, s[i])
	}
	buf[n] = cast(uint8, 0)
	return buf
}

// cStrM copies a readonly managed char slice (an Options.Args / Options.Env
// element, whose type carries readonly slots) into a NUL-terminated buffer.  A
// readonly-qualified managed slice cannot borrow into a raw *[]readonly char, so
// it needs this managed-receiver variant of cStr.
func cStrM(s readonly @[]readonly char) @[]uint8 {
	var n int = len(s)
	var buf @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ {
		buf[i] = cast(uint8, s[i])
	}
	buf[n] = cast(uint8, 0)
	return buf
}

// cloneChars copies a char borrow into an owned @[]char (a resolved program path).
func cloneChars(s *[]readonly char) @[]char {
	var n int = len(s)
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = s[i]
	}
	return out
}

// decodeStatus decodes a raw wait(2) status word into an ExitStatus.  Linux and
// macOS share the low-byte layout: bits 0..6 are the terminating signal (0 for a
// normal exit) and, for a normal exit, bits 8..15 are the exit code.  The exit
// path is verified end-to-end on both platforms by the os/process conformance
// test (/usr/bin/true, /usr/bin/false); the signal path is unit-tested with
// crafted status words (a real signalled child is a future addition).
func decodeStatus(status int) ExitStatus {
	var st ExitStatus
	var low int = status & 0x7f
	if low == 0 {
		st.exited = true
		st.code = (status >> 8) & 0xff
	} else {
		st.exited = false
		st.signal = low
	}
	return st
}
