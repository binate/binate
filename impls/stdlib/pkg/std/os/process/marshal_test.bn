// Tests for the marshalling + wait-status decode (marshal.bn): decodeStatus and
// the @[]*uint8 pointer-array dtor.  Uses the shared `fail` (process_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/builtins/testing"

// decodeStatus: a normal exit sets Exited()/Code() and clears the signal.
func TestDecodeStatusExited() testing.TestResult {
	var s0 ExitStatus = decodeStatus(0x0000) // exit 0
	if !s0.Exited() {
		return fail("0x0000 should be exited")
	}
	if !s0.Success() {
		return fail("0x0000 should be success")
	}
	if s0.Code() != 0 {
		return fail("0x0000 code should be 0")
	}

	var s1 ExitStatus = decodeStatus(0x0100) // exit 1
	if s1.Success() {
		return fail("0x0100 should not be success")
	}
	if s1.Code() != 1 {
		return fail("0x0100 code should be 1")
	}

	var s42 ExitStatus = decodeStatus(0x2a00) // exit 42
	if s42.Code() != 42 {
		return fail("0x2a00 code should be 42")
	}
	return ""
}

// decodeStatus: a signal death sets Signaled()/Signal() and Code() returns -1.
func TestDecodeStatusSignaled() testing.TestResult {
	var s ExitStatus = decodeStatus(0x0009) // killed by signal 9
	if s.Exited() {
		return fail("0x0009 should not be exited")
	}
	if !s.Signaled() {
		return fail("0x0009 should be signaled")
	}
	if s.Signal() != 9 {
		return fail("0x0009 signal should be 9")
	}
	if s.Code() != -1 {
		return fail("signaled Code() should be -1")
	}
	return ""
}

// A @[]*uint8 (managed slice whose element is a raw pointer) is a construct new
// to the tree.  Its dtor must RefDec only the backing and never touch the
// borrowed pointees, so the pointed-to C-string buffer survives the pointer array
// being dropped.
func TestPtrSliceDtorBorrows() testing.TestResult {
	var buf @[]uint8 = cStr("hello")
	dropPtrArray(buf)
	if buf[0] != cast(uint8, 'h') {
		return fail("ptr-array dtor freed the pointee buffer")
	}
	if buf[4] != cast(uint8, 'o') {
		return fail("pointee buffer corrupted")
	}
	if buf[5] != cast(uint8, 0) {
		return fail("pointee NUL terminator lost")
	}
	return ""
}

// dropPtrArray builds a @[]*uint8 borrowing buf's data plus a NULL terminator and
// lets it drop on return.
func dropPtrArray(buf @[]uint8) {
	var ptrs @[]*uint8 = make_slice(*uint8, 2)
	ptrs[0] = dataOfManaged(buf)
	ptrs[1] = bit_cast(*uint8, 0)
}
