// ExitStatus accessors — pure value logic shared by the hosted and bare-metal
// variants, so this file is unconstrained (it links on every target).  The
// ExitStatus / Options struct declarations are the .bni's; this file only
// provides the ExitStatus method bodies.  The child-launching entry points are
// in run.bn / lookpath.bn / marshal.bn (hosted) and run_baremetal.bn.
package "pkg/std/os/process"

// Exited reports whether the child terminated normally (exit) rather than via a
// signal.
func (s *readonly ExitStatus) Exited() bool {
	return s.exited
}

// Code returns the exit code when the child Exited(); it returns -1 for a signal
// death, so a naive Code()==0 check never misreads a signal as a clean exit.
func (s *readonly ExitStatus) Code() int {
	if !s.exited {
		return -1
	}
	return s.code
}

// Signaled reports whether the child was killed by a signal.
func (s *readonly ExitStatus) Signaled() bool {
	return !s.exited
}

// Signal returns the terminating signal number for a signal death, or 0 when the
// child Exited().
func (s *readonly ExitStatus) Signal() int {
	if s.exited {
		return 0
	}
	return s.signal
}

// Success reports Exited() && Code() == 0 — the common "did it work?" check.
func (s *readonly ExitStatus) Success() bool {
	return s.exited && s.code == 0
}
