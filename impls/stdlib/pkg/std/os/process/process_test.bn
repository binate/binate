// Tests for the ExitStatus accessors (process.bn).  The shared `fail` helper for
// this package lives here.  Gated hosted like the rest (pkg/std is injected, not
// interpreted, so these run under the compiled unittest modes).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/builtins/testing"

// fail is this package's shared test helper (a failing TestResult is its message).
func fail(msg @[]char) testing.TestResult {
	return msg
}

// A normal exit: Exited()/Code()/Success() reflect the code; not Signaled().
func TestExitStatusExited() testing.TestResult {
	var st ExitStatus
	st.exited = true
	st.code = 0
	if !st.Exited() {
		return fail("exit 0 should be Exited")
	}
	if !st.Success() {
		return fail("exit 0 should be Success")
	}
	if st.Code() != 0 {
		return fail("exit 0 Code should be 0")
	}
	if st.Signaled() {
		return fail("exit 0 should not be Signaled")
	}
	if st.Signal() != 0 {
		return fail("exit 0 Signal should be 0")
	}
	st.code = 3
	if st.Success() {
		return fail("exit 3 should not be Success")
	}
	if st.Code() != 3 {
		return fail("exit 3 Code should be 3")
	}
	return ""
}

// A signal death: Signaled()/Signal() reflect the signal; Code() is -1.
func TestExitStatusSignaled() testing.TestResult {
	var st ExitStatus
	st.exited = false
	st.signal = 9
	if st.Exited() {
		return fail("signaled should not be Exited")
	}
	if !st.Signaled() {
		return fail("signaled should be Signaled")
	}
	if st.Signal() != 9 {
		return fail("Signal should be 9")
	}
	if st.Code() != -1 {
		return fail("signaled Code should be -1")
	}
	if st.Success() {
		return fail("signaled should not be Success")
	}
	return ""
}
