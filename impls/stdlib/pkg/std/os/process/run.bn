// The hosted process runner: build argv/envp in the parent, then fork + exec +
// wait via the pkg/std/os/sys wrappers (which retry EINTR and classify errno
// internally, so this file never touches errno).  The argv/env char** arrays are
// built before fork and held live (as managed locals) until after Waitpid; their
// raw pointers are hoisted so the forked child branch calls only the noreturn,
// allocation-free sys.ChildExecOrExit — async-signal-safe, matching the old C
// shim's execve-only child.  Hosted only; the bare-metal stubs are in
// run_baremetal.bn.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/std/errors"
import "pkg/std/os/sys"

// Run runs `program` to completion; see the .bni for the full contract.
func Run(program *[]readonly char, opts *readonly Options) (ExitStatus, @errors.Error) {
	var zero ExitStatus
	var path @[]char
	var rerr @errors.Error
	path, rerr = resolveProgram(program, opts)
	if present(rerr) {
		return zero, rerr
	}

	// argv[0] defaults to program; Argv0 overrides it.
	var argv0 *[]readonly char = program
	if len(opts.Argv0) > 0 {
		argv0 = opts.Argv0
	}

	// Build argv = [argv0, Args..., NULL] in the parent.  argvBufs owns the C
	// strings; argv borrows their data pointers.  BOTH are held live to end of
	// scope (past Waitpid).
	var nargs int = len(opts.Args)
	var argvBufs @[]@[]uint8 = make_slice(@[]uint8, nargs + 1)
	var argv @[]*uint8 = make_slice(*uint8, nargs + 2)
	argvBufs[0] = cStr(argv0)
	argv[0] = dataOfManaged(argvBufs[0])
	for i := 0; i < nargs; i++ {
		argvBufs[i + 1] = cStrM(opts.Args[i])
		argv[i + 1] = dataOfManaged(argvBufs[i + 1])
	}
	argv[nargs + 1] = bit_cast(*uint8, 0)

	// Environment: inherit (null envp => sys.ChildExecOrExit uses execv) unless
	// replacing.  When replacing, build envp = [Env..., NULL].
	var replace bool = opts.ReplaceEnv || len(opts.Env) > 0
	var envpBufs @[]@[]uint8
	var envp @[]*uint8
	var envpData *uint8 = bit_cast(*uint8, 0)
	if replace {
		var nenv int = len(opts.Env)
		envpBufs = make_slice(@[]uint8, nenv)
		envp = make_slice(*uint8, nenv + 1)
		for i := 0; i < nenv; i++ {
			envpBufs[i] = cStrM(opts.Env[i])
			envp[i] = dataOfManaged(envpBufs[i])
		}
		envp[nenv] = bit_cast(*uint8, 0)
		envpData = dataOfPtrs(envp)
	}

	// Hoist the raw pointers BEFORE fork (the child must call no allocating code).
	var pathBuf @[]uint8 = cStr(path)
	var pathData *uint8 = dataOfManaged(pathBuf)
	var argvData *uint8 = dataOfPtrs(argv)
	return execWait(pathData, argvData, envpData)
}

// RunArgs runs `program` at an exact path with the inherited environment and
// argv = [program, args...].
func RunArgs(program *[]readonly char, args ...*[]readonly char) (ExitStatus, @errors.Error) {
	return runVariadic(program, args, false)
}

// RunArgsPath is like RunArgs but resolves `program` along PATH.
func RunArgsPath(program *[]readonly char, args ...*[]readonly char) (ExitStatus, @errors.Error) {
	return runVariadic(program, args, true)
}

// runVariadic is the shared body of RunArgs / RunArgsPath: exact-path or searched
// resolution, inherited environment, argv built straight from the variadic.
func runVariadic(program *[]readonly char, args *[]*[]readonly char,
		search bool) (ExitStatus, @errors.Error) {
	var zero ExitStatus
	var path @[]char
	var rerr @errors.Error
	if search {
		path, rerr = LookPath(program)
	} else {
		path, rerr = resolveExact(program)
	}
	if present(rerr) {
		return zero, rerr
	}

	var nargs int = len(args)
	var argvBufs @[]@[]uint8 = make_slice(@[]uint8, nargs + 1)
	var argv @[]*uint8 = make_slice(*uint8, nargs + 2)
	argvBufs[0] = cStr(program)
	argv[0] = dataOfManaged(argvBufs[0])
	for i := 0; i < nargs; i++ {
		argvBufs[i + 1] = cStr(args[i])
		argv[i + 1] = dataOfManaged(argvBufs[i + 1])
	}
	argv[nargs + 1] = bit_cast(*uint8, 0)

	var pathBuf @[]uint8 = cStr(path)
	var pathData *uint8 = dataOfManaged(pathBuf)
	var argvData *uint8 = dataOfPtrs(argv)
	return execWait(pathData, argvData, bit_cast(*uint8, 0))
}

// execWait forks (sys.Fork), runs the async-signal-safe child (sys.ChildExecOrExit
// — execve when envpData is non-null, else execv), and waits (sys.Waitpid), then
// decodes the raw status into an ExitStatus.  The pointers are pre-hoisted by the
// caller (which holds the backing buffers live), so the pid==0 branch calls only
// ChildExecOrExit — allocation-free and noreturn, so no post-fork code runs in the
// child.
func execWait(pathData *uint8, argvData *uint8, envpData *uint8) (ExitStatus, @errors.Error) {
	var zero ExitStatus
	var noErr @errors.Error
	var pid int
	var ferr @errors.Error
	pid, ferr = sys.Fork()
	if present(ferr) {
		return zero, ferr
	}
	if pid == 0 {
		sys.ChildExecOrExit(pathData, argvData, envpData) // noreturn
	}
	var status int
	var werr @errors.Error
	status, werr = sys.Waitpid(pid)
	if present(werr) {
		return zero, werr
	}
	return decodeStatus(status), noErr
}

// resolveProgram resolves `program` to a concrete executable path for Run: a PATH
// search when Options.SearchPath is set, else the program as an exact path
// (checked executable in the parent so a not-found/permission failure is a clean
// typed error before any fork).
func resolveProgram(program *[]readonly char, opts *readonly Options) (@[]char, @errors.Error) {
	if opts.SearchPath {
		return LookPath(program)
	}
	return resolveExact(program)
}

// resolveExact returns `program` as-is when it is an executable file, else the
// classified start error (from sys.Accessible).
func resolveExact(program *[]readonly char) (@[]char, @errors.Error) {
	var err @errors.Error = sys.Accessible(program)
	if present(err) {
		var empty @[]char
		return empty, err
	}
	var noErr @errors.Error
	return cloneChars(program), noErr
}
