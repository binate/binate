// Bare-metal pkg/std/os/process: a freestanding target has no process model, so
// every entry point fails.  The value types (ExitStatus, Options) live in the
// unconstrained process.bn, shared with the hosted variant, so the package LINKS
// on every target and no importer needs its own #[build] gate.
#[build(is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/std/errors"

// errNoProc is the failure every entry returns.  It roots in errors.Unsupported
// (not Unimplemented): on a single-address-space freestanding target subprocess
// execution is CATEGORICALLY absent — you are the system — not merely unbuilt.
func errNoProc() @errors.Error {
	return errors.Rooted(errors.Unsupported, "os/process: no process model on a freestanding target")
}

// Run fails on a freestanding target — there is no process model to run a child.
func Run(program *[]readonly char, opts *readonly Options) (ExitStatus, @errors.Error) {
	var zero ExitStatus
	return zero, errNoProc()
}

// RunArgs fails on a freestanding target (no process model).
func RunArgs(program *[]readonly char, args ...*[]readonly char) (ExitStatus, @errors.Error) {
	var zero ExitStatus
	return zero, errNoProc()
}

// RunArgsPath fails on a freestanding target (no process model).
func RunArgsPath(program *[]readonly char, args ...*[]readonly char) (ExitStatus, @errors.Error) {
	var zero ExitStatus
	return zero, errNoProc()
}

// LookPath fails on a freestanding target (no PATH / process model).
func LookPath(program *[]readonly char) (@[]char, @errors.Error) {
	var empty @[]char
	return empty, errNoProc()
}
