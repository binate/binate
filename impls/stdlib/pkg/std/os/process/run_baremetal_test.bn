// Gated to bare metal: the freestanding process stubs fail every entry point.
// Runs only under a bare-metal unit-test build; the hosted `fail` (process_test.bn)
// is not in scope, so this returns the message string directly.
#[build(is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestBaremetalNoProc confirms Run fails with Unsupported on a freestanding target.
func TestBaremetalNoProc() testing.TestResult {
	var st ExitStatus
	var err @errors.Error
	st, err = Run("/bin/true", &Options{})
	_ = st
	if !present(err) {
		return "Run must fail on a freestanding target (no process model)"
	}
	if !errors.Is(err, errors.Unsupported) {
		return "a freestanding target should classify Unsupported"
	}
	return ""
}
