// Tests for the runner (run.bn): running a child to completion, the not-found
// start error, and RunArgs.  Exercises the real fork/exec/wait path (via sys)
// against /usr/bin/true and /usr/bin/false, present on Linux and macOS (as
// conformance test 273 already relied on).  Uses the shared `fail`
// (process_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/process"

import "pkg/builtins/testing"
import "pkg/std/errors"

// Run a child to completion and read its exit code.
func TestRunTrueFalse() testing.TestResult {
	var st ExitStatus
	var err @errors.Error
	st, err = Run("/usr/bin/true", &Options{})
	if present(err) {
		return fail("Run(/usr/bin/true) unexpected start error")
	}
	if !st.Success() {
		return fail("/usr/bin/true should succeed")
	}

	st, err = Run("/usr/bin/false", &Options{})
	if present(err) {
		return fail("Run(/usr/bin/false) unexpected start error")
	}
	if st.Success() {
		return fail("/usr/bin/false should not succeed")
	}
	if st.Code() != 1 {
		return fail("/usr/bin/false should exit 1")
	}
	return ""
}

// A missing program is a could-not-start error, classified NotFound.
func TestRunNotFound() testing.TestResult {
	var st ExitStatus
	var err @errors.Error
	st, err = Run("/nonexistent/binate/prog", &Options{})
	if !present(err) {
		return fail("a missing program should be a start error")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a missing program should classify as NotFound")
	}
	return ""
}

// RunArgs passes argv[1..]; /usr/bin/true ignores them and succeeds.
func TestRunArgs() testing.TestResult {
	var st ExitStatus
	var err @errors.Error
	st, err = RunArgs("/usr/bin/true", "ignored", "args")
	if present(err) {
		return fail("RunArgs unexpected start error")
	}
	if !st.Success() {
		return fail("RunArgs(/usr/bin/true) should succeed")
	}
	return ""
}

// A replaced (non-empty) environment reaches the child — exercises the execve
// path (envp char** build), which the empty-Options tests never touch.  The
// child shell exits 0 iff it sees BINATE_ENV_PROBE=1.
func TestRunEnvReplace() testing.TestResult {
	var args @[]@[]char = make_slice(@[]char, 2)
	args[0] = cloneChars("-c")
	args[1] = cloneChars("test x$BINATE_ENV_PROBE = x1")
	var env @[]@[]char = make_slice(@[]char, 1)
	env[0] = cloneChars("BINATE_ENV_PROBE=1")
	var opts Options
	opts.Args = args
	opts.Env = env
	var st ExitStatus
	var err @errors.Error
	st, err = Run("/bin/sh", &opts)
	if present(err) {
		return fail("Run(/bin/sh) with a replaced env unexpected start error")
	}
	if !st.Success() {
		return fail("BINATE_ENV_PROBE=1 in the replaced env should give exit 0")
	}
	return ""
}

// ReplaceEnv with an empty Env gives the child an EMPTY environment (envp =
// [NULL] + execve, NOT inherit-via-execv).  The child shell exits 0 iff HOME is
// unset — sh defaults PATH from an empty env but never HOME, so HOME distinguishes
// a genuinely-empty child env from an inherited one.
func TestRunReplaceEnvEmpty() testing.TestResult {
	var args @[]@[]char = make_slice(@[]char, 2)
	args[0] = cloneChars("-c")
	args[1] = cloneChars("test x$HOME = x")
	var opts Options
	opts.Args = args
	opts.ReplaceEnv = true
	var st ExitStatus
	var err @errors.Error
	st, err = Run("/bin/sh", &opts)
	if present(err) {
		return fail("Run(/bin/sh) with an empty env unexpected start error")
	}
	if !st.Success() {
		return fail("an empty replaced env should leave HOME unset (exit 0)")
	}
	return ""
}
