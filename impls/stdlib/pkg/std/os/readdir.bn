// ReadDir and its directory-stream machinery: opendir(3) / readdir(3) /
// closedir(3) via __c_call, plus the d_type -> FileMode mapping.  opendir and
// friends are libc-portable, so they live here; the only target-specific part
// is the layout of the struct dirent readdir hands back — the d_type and
// d_name offsets — read by direntType / direntName in readdir_<platform>.bn.
// Gated to hosted targets; a bare-metal target has no filesystem and returns
// errNoFS from its own ReadDir (os_baremetal.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/std/errors"

// d_type values from <dirent.h>.  These DT_* numbers are identical on Linux
// and the BSDs (Darwin included), so the mapping below is shared.
const (
	DT_UNKNOWN uint8 = 0
	DT_FIFO uint8 = 1
	DT_CHR uint8 = 2
	DT_DIR uint8 = 4
	DT_BLK uint8 = 6
	DT_REG uint8 = 8
	DT_LNK uint8 = 10
	DT_SOCK uint8 = 12
)

// modeFromDType maps a directory entry's d_type to the FileMode type bits (no
// permission bits — a listing does not carry them).  It mirrors the type half
// of modeFromStat: a char device sets both ModeDevice and ModeCharDevice, a
// regular entry sets no bit, and an entry the filesystem could not classify
// (DT_UNKNOWN) is ModeIrregular — the caller can Stat the path to learn more.
func modeFromDType(dt uint8) FileMode {
	if dt == DT_DIR {
		return ModeDir
	} else if dt == DT_LNK {
		return ModeSymlink
	} else if dt == DT_CHR {
		return ModeDevice | ModeCharDevice
	} else if dt == DT_BLK {
		return ModeDevice
	} else if dt == DT_FIFO {
		return ModeNamedPipe
	} else if dt == DT_SOCK {
		return ModeSocket
	} else if dt == DT_REG {
		return cast(FileMode, 0)
	}
	return ModeIrregular
}

// cName copies the NUL-terminated C string at p into a fresh owned @[]char —
// the directory entry's name, lifted out of readdir's reused buffer before the
// next readdir overwrites it.
func cName(p *uint8) @[]char {
	var n int = 0
	for p[n] != 0 {
		n = n + 1
	}
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = cast(char, p[i])
	}
	return out
}

// isDotName reports whether the C name at p is "." or "..", the two entries
// ReadDir drops.
func isDotName(p *uint8) bool {
	if p[0] != cast(uint8, 46) {
		// not '.'
		return false
	}
	if p[1] == 0 {
		return true // "."
	}
	return p[1] == cast(uint8, 46) && p[2] == 0 // ".."
}

// appendDirEntry grows a @[]@DirEntry by one element.
func appendDirEntry(s @[]@DirEntry, e @DirEntry) @[]@DirEntry {
	var n int = len(s)
	var ns @[]@DirEntry = make_slice(@DirEntry, n + 1)
	for i := 0; i < n; i++ {
		ns[i] = s[i]
	}
	ns[n] = e
	return ns
}

// openDir wraps opendir(3): it opens the directory at the NUL-terminated path
// and returns the DIR* as an opaque *uint8 handle (nil on failure), passed
// straight back to readDirEnt / closeDir.  Only the struct dirent readDirEnt
// yields gets decoded, by the per-platform direntType / direntName.
func openDir(path *uint8) *uint8 {
	return __c_call("opendir", *uint8, path)
}

// readDirEnt wraps the readdir(3) variant for the active platform — defined in
// readdir_<platform>.bn alongside the matching osDirent layout, because the
// SYMBOL differs: Linux must call readdir64 (the 32-bit readdir returns
// EOVERFLOW on a >2^32 d_ino, silently truncating the listing — and uses a
// narrower struct dirent), while macOS uses plain readdir.  It returns a pointer
// to the next struct dirent in the stream, or nil at end of stream.

// closeDir wraps closedir(3), releasing the directory stream opened by openDir.
func closeDir(dir *uint8) {
	// closedir returns a 32-bit C int; annotate int32 (not the 64-bit binate
	// int) so the return register is read at its true width — see stat_io.bn.
	// The result is unused (a close failure is not actionable here).
	var rc int32 = __c_call("closedir", int32, dir)
	_ = rc
}

// direntType reads the d_type byte of the struct dirent readdir returned, via
// the active platform's osDirent layout (readdir_<platform>.bn).
func direntType(ent *uint8) uint8 {
	var h *osDirent = bit_cast(*osDirent, ent)
	return h.d_type
}

// direntName returns a pointer to the NUL-terminated d_name, at the active
// platform's D_NAME_OFF within the struct dirent.
func direntName(ent *uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(int, ent) + D_NAME_OFF)
}

// ReadDir reads the named directory and returns its entries (excluding "." and
// ".."), in directory order.  readDirEnt returns nil at the end of the stream
// — and, indistinguishably without first clearing errno, on a rare
// mid-iteration readdir(3) error, which is then reported as end-of-stream
// (matching the platform's own ambiguity).
func ReadDir(name *[]readonly char) (@[]@DirEntry, @errors.Error) {
	var cp @[]uint8 = cPath(name)
	var dir *uint8 = openDir(dataOfManaged(cp))
	if dir == bit_cast(*uint8, 0) {
		var none @[]@DirEntry
		return none, failErrno("opendir")
	}
	var entries @[]@DirEntry
	for {
		var ent *uint8 = readDirEnt(dir)
		if ent == bit_cast(*uint8, 0) {
			break
		}
		var nameP *uint8 = direntName(ent)
		if isDotName(nameP) {
			continue
		}
		var e @DirEntry = make(DirEntry)
		e.name = cName(nameP)
		e.mode = modeFromDType(direntType(ent))
		entries = appendDirEntry(entries, e)
	}
	closeDir(dir)
	return entries, errEmpty()
}
