// ReadDir: the FileMode glue on top of the sys directory-stream layer.  The
// opendir/readdir/closedir syscalls, the struct dirent decode, and the "."/".."
// filtering now live in pkg/std/os/sys, which returns owned (name, d_type)
// entries; this file owns the platform-neutral d_type -> FileMode mapping (the
// DT_* bits are identical on every POSIX target) and assembles the DirEntry
// listing.  Gated to hosted targets; a bare-metal target has no filesystem and
// returns errNoFS from its own ReadDir (os_baremetal.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/std/errors"
import "pkg/std/os/sys"

// d_type values from <dirent.h>.  These DT_* numbers are identical on Linux
// and the BSDs (Darwin included), so the mapping below is shared.
const (
	DT_UNKNOWN uint8 = 0
	DT_FIFO uint8 = 1
	DT_CHR uint8 = 2
	DT_DIR uint8 = 4
	DT_BLK uint8 = 6
	DT_REG uint8 = 8
	DT_LNK uint8 = 10
	DT_SOCK uint8 = 12
)

// modeFromDType maps a directory entry's d_type to the FileMode type bits (no
// permission bits — a listing does not carry them).  It mirrors the type half
// of modeFromStat: a char device sets both ModeDevice and ModeCharDevice, a
// regular entry sets no bit, and an entry the filesystem could not classify
// (DT_UNKNOWN) is ModeIrregular — the caller can Stat the path to learn more.
func modeFromDType(dt uint8) FileMode {
	if dt == DT_DIR {
		return ModeDir
	} else if dt == DT_LNK {
		return ModeSymlink
	} else if dt == DT_CHR {
		return ModeDevice | ModeCharDevice
	} else if dt == DT_BLK {
		return ModeDevice
	} else if dt == DT_FIFO {
		return ModeNamedPipe
	} else if dt == DT_SOCK {
		return ModeSocket
	} else if dt == DT_REG {
		return cast(FileMode, 0)
	}
	return ModeIrregular
}

// ReadDir reads the named directory and returns its entries (excluding "." and
// ".."), in directory order, mapping each entry's raw d_type to the FileMode
// type bits.  The name/d_type extraction and the syscalls are done by sys.ReadDir;
// this only maps d_type -> FileMode and boxes each into a DirEntry.
func ReadDir(name *[]readonly char) (@[]@DirEntry, @errors.Error) {
	var raw @[]@sys.DirEnt
	var err @errors.Error
	raw, err = sys.ReadDir(name)
	if present(err) {
		var none @[]@DirEntry
		return none, err
	}
	var entries @[]@DirEntry = make_slice(@DirEntry, len(raw))
	for i := 0; i < len(raw); i++ {
		var e @DirEntry = make(DirEntry)
		e.name = raw[i].Name
		e.mode = modeFromDType(raw[i].Type)
		entries[i] = e
	}
	return entries, errEmpty()
}
