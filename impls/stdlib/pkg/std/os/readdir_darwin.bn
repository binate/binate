// Darwin struct dirent layout + readdir(3) for ReadDir: x86_64 and arm64 share
// it.  The shared direntType / direntName (readdir.bn) read d_type by field and
// d_name at D_NAME_OFF.
#[build(is(os, "darwin"))]
package "pkg/std/os"

// osDirent mirrors the Darwin struct dirent header up to d_type.  The char
// d_name[1024] flexible array follows at D_NAME_OFF and is read by offset.
type osDirent struct {
	d_ino     uint64
	d_seekoff uint64
	d_reclen  uint16
	d_namlen  uint16
	d_type    uint8
}

// D_NAME_OFF is the byte offset of d_name within the Darwin struct dirent.
const D_NAME_OFF int = 21

// readDirEnt wraps readdir(3): plain readdir, since macOS already uses a 64-bit
// d_ino and is not subject to the 32-bit-readdir EOVERFLOW truncation that
// forces Linux to use readdir64.  Returns the next struct dirent, nil at EOS.
func readDirEnt(dir *uint8) *uint8 {
	return __c_call("readdir", *uint8, dir)
}
