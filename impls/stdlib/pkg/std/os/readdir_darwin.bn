// Darwin struct dirent decoding for ReadDir.  x86_64 and arm64 share this
// layout, so one file covers both Darwin arches.
#[build(is(os, "darwin"))]
package "pkg/std/os"

// direntHeader mirrors the Darwin struct dirent header up to d_type: d_ino,
// d_seekoff, d_reclen, d_namlen, d_type.  The char d_name[1024] flexible array
// follows at offset 21 and is read by direntName, not modeled as a field here.
type direntHeader struct {
	d_ino     uint64
	d_seekoff uint64
	d_reclen  uint16
	d_namlen  uint16
	d_type    uint8
}

// direntType reads the d_type byte of the struct dirent that readdir returned.
func direntType(ent *uint8) uint8 {
	var h *direntHeader = bit_cast(*direntHeader, ent)
	return h.d_type
}

// direntName returns a pointer to the NUL-terminated d_name, at its fixed
// offset (21 on Darwin) within the struct dirent.
func direntName(ent *uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(int, ent) + 21)
}
