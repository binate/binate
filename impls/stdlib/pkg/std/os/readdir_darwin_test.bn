// Gated to Darwin, matching readdir_darwin.bn.  The shared `fail` helper lives
// in os_test.bn.
#[build(is(os, "darwin"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestReadDirEntDarwin exercises readDirEnt (readdir) end-to-end on "/", a
// directory that always has entries, confirming the per-platform readdir symbol
// and dirent decode yield a live first entry.
func TestReadDirEntDarwin() testing.TestResult {
	var cp @[]uint8 = cPath("/")
	var dir *uint8 = openDir(dataOfManaged(cp))
	if dir == bit_cast(*uint8, 0) {
		return fail("openDir(/) returned nil")
	}
	var ent *uint8 = readDirEnt(dir)
	closeDir(dir)
	if ent == bit_cast(*uint8, 0) {
		return fail("readDirEnt(/) returned nil for a non-empty directory")
	}
	return ""
}
