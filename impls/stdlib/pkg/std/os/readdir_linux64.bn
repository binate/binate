// 64-bit Linux struct dirent decoding for ReadDir.  glibc's x86_64 and aarch64
// share this layout, so one file covers both 64-bit Linux arches.
#[build(is(os, "linux") && !is(arch, "arm32"))]
package "pkg/std/os"

// direntHeader mirrors the glibc struct dirent header up to d_type on 64-bit
// Linux: d_ino, d_off, d_reclen, d_type.  The char d_name[256] flexible array
// follows at offset 19 and is read by direntName, not modeled as a field here.
type direntHeader struct {
	d_ino    uint64
	d_off    int64
	d_reclen uint16
	d_type   uint8
}

// direntType reads the d_type byte of the struct dirent that readdir returned.
func direntType(ent *uint8) uint8 {
	var h *direntHeader = bit_cast(*direntHeader, ent)
	return h.d_type
}

// direntName returns a pointer to the NUL-terminated d_name, at its fixed
// offset (19 on 64-bit Linux) within the struct dirent.
func direntName(ent *uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(int, ent) + 19)
}
