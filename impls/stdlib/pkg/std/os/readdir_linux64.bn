// 64-bit Linux struct dirent layout for ReadDir (data only): glibc's x86_64 and
// aarch64 share it.  Logic is shared in readdir.bn.
#[build(is(os, "linux") && !is(arch, "arm32"))]
package "pkg/std/os"

// osDirent mirrors the glibc struct dirent header up to d_type on 64-bit Linux.
// The char d_name[256] flexible array follows at D_NAME_OFF.
type osDirent struct {
	d_ino    uint64
	d_off    int64
	d_reclen uint16
	d_type   uint8
}

// D_NAME_OFF is the byte offset of d_name within the 64-bit Linux struct dirent.
const D_NAME_OFF int = 19
