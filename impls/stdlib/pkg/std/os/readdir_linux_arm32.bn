// 32-bit ARM Linux struct dirent layout for ReadDir (data only): 32-bit
// d_ino/d_off (plain readdir(3), not the *64 variant).  Logic is in readdir.bn.
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os"

// osDirent mirrors the glibc struct dirent header up to d_type on 32-bit ARM
// Linux.  The char d_name[256] flexible array follows at D_NAME_OFF.
type osDirent struct {
	d_ino    uint32
	d_off    int32
	d_reclen uint16
	d_type   uint8
}

// D_NAME_OFF is the byte offset of d_name within the 32-bit ARM struct dirent.
const D_NAME_OFF int = 11
