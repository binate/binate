// Gated to hosted Linux, matching readdir_linux.bn.  The shared `fail` helper
// lives in os_test.bn (also hosted-only).
#[build(is(os, "linux"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestReadDirEntLinux confirms the per-platform readDirEnt (readdir64) links and
// returns a live first entry for "/", a directory that always has entries.  It
// pins the SYMBOL choice; it does NOT verify the d_name/d_type OFFSETS — that is
// conformance/stdlib/os/006_readdir's job (it creates a marker file and checks
// its decoded name + d_type, the strong per-platform layout check).
func TestReadDirEntLinux() testing.TestResult {
	var cp @[]uint8 = cPath("/")
	var dir *uint8 = openDir(dataOfManaged(cp))
	if dir == bit_cast(*uint8, 0) {
		return fail("openDir(/) returned nil")
	}
	var ent *uint8 = readDirEnt(dir)
	closeDir(dir)
	if ent == bit_cast(*uint8, 0) {
		return fail("readDirEnt(/) returned nil for a non-empty directory")
	}
	return ""
}
