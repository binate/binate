// Gated to hosted Linux, matching readdir_linux.bn.  The shared `fail` helper
// lives in os_test.bn (also hosted-only).
#[build(is(os, "linux"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestReadDirEntLinux exercises readDirEnt (readdir64) end-to-end on "/", a
// directory that always has entries.  A wrong symbol or dirent layout — e.g. the
// 32-bit readdir's EOVERFLOW on a >2^32 d_ino, which would truncate the stream —
// would surface here as a nil first entry.
func TestReadDirEntLinux() testing.TestResult {
	var cp @[]uint8 = cPath("/")
	var dir *uint8 = openDir(dataOfManaged(cp))
	if dir == bit_cast(*uint8, 0) {
		return fail("openDir(/) returned nil")
	}
	var ent *uint8 = readDirEnt(dir)
	closeDir(dir)
	if ent == bit_cast(*uint8, 0) {
		return fail("readDirEnt(/) returned nil for a non-empty directory")
	}
	return ""
}
