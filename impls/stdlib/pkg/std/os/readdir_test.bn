// Gated to the hosted os variant, matching the rest of the os unit tests
// (the shared `fail` helper lives in os_test.bn; bare metal runs no host tests,
// and modeFromDType is hosted-only anyway).  The DirEntry accessors are tested
// in direntry_test.bn.
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"

// TestModeFromDType checks the d_type -> FileMode type-bit mapping for every
// DT_* value — the directory-listing counterpart of modeFromStat, covering the
// types ReadDir's conformance test cannot easily produce on a shared host.
func TestModeFromDType() testing.TestResult {
	if modeFromDType(DT_DIR) != ModeDir { return fail("DT_DIR -> ModeDir") }
	if modeFromDType(DT_REG) != cast(FileMode, 0) { return fail("DT_REG -> regular (no type bit)") }
	if modeFromDType(DT_LNK) != ModeSymlink { return fail("DT_LNK -> ModeSymlink") }
	if modeFromDType(DT_FIFO) != ModeNamedPipe { return fail("DT_FIFO -> ModeNamedPipe") }
	if modeFromDType(DT_SOCK) != ModeSocket { return fail("DT_SOCK -> ModeSocket") }
	if modeFromDType(DT_UNKNOWN) != ModeIrregular { return fail("DT_UNKNOWN -> ModeIrregular") }
	// A char device sets both ModeDevice and ModeCharDevice; a block device sets
	// only ModeDevice.
	var chr FileMode = modeFromDType(DT_CHR)
	if (chr & ModeDevice) == cast(FileMode, 0) { return fail("DT_CHR -> ModeDevice") }
	if (chr & ModeCharDevice) == cast(FileMode, 0) { return fail("DT_CHR -> ModeCharDevice") }
	var blk FileMode = modeFromDType(DT_BLK)
	if (blk & ModeDevice) == cast(FileMode, 0) { return fail("DT_BLK -> ModeDevice") }
	if (blk & ModeCharDevice) != cast(FileMode, 0) { return fail("DT_BLK is not a char device") }
	return ""
}
