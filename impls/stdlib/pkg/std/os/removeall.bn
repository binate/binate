// RemoveAll: recursive removal built on Lstat / ReadDir / Remove.  Gated to
// hosted targets; a bare-metal target has no filesystem and returns errNoFS from
// its own RemoveAll (os_baremetal.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/std/errors"

// RemoveAll removes path and, if it is a directory, everything under it.  It
// never follows a symbolic link: a link (even one to a directory, and even named
// with a trailing '/') is removed itself, not its target.  It removes everything
// it can and returns the first error it met.  A path that does not exist is not an
// error.
//
// The walk is path-based (Lstat, then ReadDir and Remove by name), so it cannot
// guard against another process replacing a directory in the tree with a symbolic
// link between those calls; use it on trees no one else is modifying.
func RemoveAll(path *[]readonly char) @errors.Error {
	// A trailing '/' makes lstat(2) resolve a symbolic link ("link/" names the
	// directory it points at), so walk the path with it stripped: "link/" then
	// names, and removes, the link itself.
	var p *[]readonly char = trimTrailingSlashes(path)
	var fi @FileInfo
	var err @errors.Error
	fi, err = Lstat(p)
	if present(err) {
		if errors.Is(err, errors.NotFound) {
			return errEmpty()
		}
		return err
	}
	if !fi.IsDir() {
		return removeIgnoringNotFound(p)
	}
	var entries @[]@DirEntry
	entries, err = ReadDir(p)
	if present(err) {
		if errors.Is(err, errors.NotFound) {
			return errEmpty()
		}
		// A directory the caller cannot list may still be empty, and removing an
		// empty directory needs only write access to its parent.
		if !present(removeIgnoringNotFound(p)) {
			return errEmpty()
		}
		return err
	}
	var first @errors.Error
	for i := 0; i < len(entries); i++ {
		var cerr @errors.Error = RemoveAll(joinChild(p, entries[i].Name()))
		if present(cerr) && !present(first) {
			first = cerr
		}
	}
	var derr @errors.Error = removeIgnoringNotFound(p)
	if present(first) {
		return first
	}
	return derr
}

// removeIgnoringNotFound is Remove, except that a path already gone (e.g.
// removed concurrently) counts as removed.
func removeIgnoringNotFound(path *[]readonly char) @errors.Error {
	var err @errors.Error = Remove(path)
	if present(err) && errors.Is(err, errors.NotFound) {
		return errEmpty()
	}
	return err
}

// trimTrailingSlashes returns path without its trailing '/' characters, keeping a
// single '/' for a path made only of slashes (the root).
func trimTrailingSlashes(path *[]readonly char) *[]readonly char {
	var end int = len(path)
	for end > 1 && path[end - 1] == '/' {
		end = end - 1
	}
	return path[0:end]
}

// joinChild returns dir + "/" + name, without doubling a '/' that dir already
// ends with.
func joinChild(dir *[]readonly char, name *[]readonly char) @[]char {
	var sep int = 1
	if len(dir) > 0 && dir[len(dir) - 1] == '/' {
		sep = 0
	}
	var out @[]char = make_slice(char, len(dir) + sep + len(name))
	for i := 0; i < len(dir); i++ {
		out[i] = dir[i]
	}
	if sep == 1 {
		out[len(dir)] = '/'
	}
	for i := 0; i < len(name); i++ {
		out[len(dir) + sep + i] = name[i]
	}
	return out
}
