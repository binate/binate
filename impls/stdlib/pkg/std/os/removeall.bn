// RemoveAll: recursive removal by directory fd (openat / unlinkat / fdopendir
// through pkg/std/os/sys).  Gated to hosted targets; a bare-metal target has no
// filesystem and returns errNoFS from its own RemoveAll (os_baremetal.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/std/errors"
import "pkg/std/os/sys"

// RemoveAll removes path and, if it is a directory, everything under it.  It
// never follows a symbolic link: a link (even one to a directory, and even named
// with a trailing '/') is removed itself, not its target.  It removes everything
// it can and returns the first error it met.  A path that does not exist is not an
// error.
//
// Below path, the walk holds each directory open and names its entries relative
// to it, so a directory another process replaces with a symbolic link mid-walk is
// not followed: the removal of that name fails instead.  Each level of the walk
// holds a file descriptor (two while it lists a directory), so a tree deeper than
// the process's open-file limit fails there (errors.ResourceExhausted).
func RemoveAll(path *[]readonly char) @errors.Error {
	// A trailing '/' would make the final component resolve through a symbolic
	// link ("link/" names the directory it points at), so walk the path with it
	// stripped: "link/" then names, and removes, the link itself.
	var p *[]readonly char = trimTrailingSlashes(path)
	if len(p) == 0 {
		return errEmpty()
	}
	return removeAllAt(sys.AtCwd(), p)
}

// removeAllAt removes name, relative to the open directory dirfd, and everything
// under it (RemoveAll).
func removeAllAt(dirfd int, name *[]readonly char) @errors.Error {
	// A file, or a symbolic link (unlinkat never follows one), goes in one call.
	var err @errors.Error = sys.UnlinkAt(dirfd, name, false)
	if !present(err) || errors.Is(err, errors.NotFound) {
		return errEmpty()
	}
	var fd int
	var oerr @errors.Error
	fd, oerr = sys.OpenDirAt(dirfd, name)
	if present(oerr) {
		if errors.Is(oerr, errors.NotFound) {
			return errEmpty()
		}
		// Not a directory, or a symbolic link: the unlink error stands.
		if errors.Is(oerr, errors.ConditionsUnmet) {
			return err
		}
		// A directory the caller cannot open may still be empty, and removing an
		// empty directory needs only write access to its parent.
		var rerr @errors.Error = sys.UnlinkAt(dirfd, name, true)
		if !present(rerr) || errors.Is(rerr, errors.NotFound) {
			return errEmpty()
		}
		return oerr
	}
	var entries @[]@sys.DirEnt
	var lerr @errors.Error
	entries, lerr = sys.ReadDirFd(fd)
	var first @errors.Error
	for i := 0; i < len(entries); i++ {
		var cerr @errors.Error = removeAllAt(fd, entries[i].Name)
		if present(cerr) && !present(first) {
			first = cerr
		}
	}
	var cerr @errors.Error = sys.Close(fd)
	_ = cerr
	var derr @errors.Error = sys.UnlinkAt(dirfd, name, true)
	if !present(derr) || errors.Is(derr, errors.NotFound) {
		// The directory is gone, so a failure to list it left nothing behind.
		return first
	}
	if present(first) {
		return first
	}
	if present(lerr) {
		return lerr
	}
	return derr
}

// trimTrailingSlashes returns path without its trailing '/' characters, keeping a
// single '/' for a path made only of slashes (the root).
func trimTrailingSlashes(path *[]readonly char) *[]readonly char {
	var end int = len(path)
	for end > 1 && path[end - 1] == '/' {
		end = end - 1
	}
	return path[0:end]
}
