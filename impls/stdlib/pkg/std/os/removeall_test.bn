// Gated to the hosted os variant, like the rest of the os unit tests (the shared
// `fail` and `joinPath` helpers live in os_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/errors"

// raWriteFile creates path holding a few bytes, reporting success.
func raWriteFile(path *[]readonly char) bool {
	var f @File
	var err @errors.Error
	f, err = Create(path)
	if present(err) { return false }
	_, err = f.Write("x")
	if present(err) { return false }
	return !present(f.Close())
}

// raGone reports whether path no longer exists (Lstat is NotFound).
func raGone(path *[]readonly char) bool {
	var err @errors.Error
	_, err = Lstat(path)
	return present(err) && errors.Is(err, errors.NotFound)
}

// RemoveAll deletes a whole tree — files, nested and empty subdirectories, and a
// symbolic link — without following the link: the directory it points at, and
// that directory's file, survive.
func TestRemoveAllTree() testing.TestResult {
	var base @[]char
	var err @errors.Error
	base, err = MkdirTemp("/tmp", "binate_os_removeall_")
	if present(err) { return fail("MkdirTemp should succeed") }
	var tree @[]char = joinPath(base, "tree")
	var sub @[]char = joinPath(tree, "sub")
	var outside @[]char = joinPath(base, "outside")
	if present(MkdirAll(joinPath(sub, "empty"), cast(FileMode, 0o755))) {
		return fail("MkdirAll should succeed")
	}
	if present(Mkdir(outside, cast(FileMode, 0o755))) { return fail("Mkdir outside should succeed") }
	if !raWriteFile(joinPath(tree, "a")) || !raWriteFile(joinPath(sub, "b")) ||
			!raWriteFile(joinPath(outside, "keep")) {
		return fail("writing the test files should succeed")
	}
	if present(Symlink(outside, joinPath(tree, "link"))) { return fail("Symlink should succeed") }

	if present(RemoveAll(tree)) { return fail("RemoveAll of the tree should succeed") }
	if !raGone(tree) { return fail("the tree should be gone") }
	if raGone(joinPath(outside, "keep")) {
		return fail("RemoveAll must not follow a symlink into the directory it names")
	}

	if present(RemoveAll(base)) { return fail("RemoveAll of the temp dir should succeed") }
	if !raGone(base) { return fail("the temp dir should be gone") }
	return ""
}

// A missing path is not an error; a single file is removed; a trailing '/' on a
// directory is accepted.
func TestRemoveAllMissingFileAndSlash() testing.TestResult {
	var base @[]char
	var err @errors.Error
	base, err = MkdirTemp("/tmp", "binate_os_removeall_")
	if present(err) { return fail("MkdirTemp should succeed") }
	if present(RemoveAll(joinPath(base, "no_such_path"))) {
		return fail("RemoveAll of a missing path should succeed")
	}
	var file @[]char = joinPath(base, "f")
	if !raWriteFile(file) { return fail("writing the file should succeed") }
	if present(RemoveAll(file)) || !raGone(file) { return fail("RemoveAll should remove a file") }
	var dir @[]char = joinPath(base, "d")
	if present(Mkdir(dir, cast(FileMode, 0o755))) || !raWriteFile(joinPath(dir, "x")) {
		return fail("making the subdirectory should succeed")
	}
	var slashed @[]char = joinPath(dir, "")
	if present(RemoveAll(slashed)) || !raGone(dir) {
		return fail("RemoveAll of `dir/` should remove the directory")
	}
	if present(RemoveAll(base)) || !raGone(base) {
		return fail("removing the temp dir should succeed")
	}
	return ""
}

// A symbolic link to a directory, named with or without a trailing '/', is removed
// itself; the directory it points at, and its file, survive.
func TestRemoveAllLinkArgument() testing.TestResult {
	var base @[]char
	var err @errors.Error
	base, err = MkdirTemp("/tmp", "binate_os_removeall_")
	if present(err) { return fail("MkdirTemp should succeed") }
	var target @[]char = joinPath(base, "target")
	var keep @[]char = joinPath(target, "keep")
	var link @[]char = joinPath(base, "link")
	var slashLink @[]char = joinPath(base, "slashlink")
	if present(Mkdir(target, cast(FileMode, 0o755))) || !raWriteFile(keep) {
		return fail("making the target directory should succeed")
	}
	if present(Symlink(target, link)) || present(Symlink(target, slashLink)) {
		return fail("Symlink should succeed")
	}
	if present(RemoveAll(link)) || !raGone(link) { return fail("RemoveAll should remove the link") }
	if present(RemoveAll(joinPath(slashLink, ""))) || !raGone(slashLink) {
		return fail("RemoveAll of `link/` should remove the link")
	}
	if raGone(keep) { return fail("RemoveAll must not follow a link to its directory") }
	if present(RemoveAll(base)) || !raGone(base) {
		return fail("removing the temp dir should succeed")
	}
	return ""
}

// An empty directory the caller cannot list (mode 000) is still removed: removing
// it needs only write access to its parent.
func TestRemoveAllUnreadableEmptyDir() testing.TestResult {
	var base @[]char
	var err @errors.Error
	base, err = MkdirTemp("/tmp", "binate_os_removeall_")
	if present(err) { return fail("MkdirTemp should succeed") }
	var locked @[]char = joinPath(base, "locked")
	if present(Mkdir(locked, cast(FileMode, 0))) { return fail("Mkdir should succeed") }
	if present(RemoveAll(locked)) || !raGone(locked) {
		return fail("RemoveAll should remove an unreadable empty directory")
	}
	if present(RemoveAll(base)) || !raGone(base) {
		return fail("removing the temp dir should succeed")
	}
	return ""
}

// trimTrailingSlashes drops trailing '/' but keeps the root.
func TestTrimTrailingSlashes() testing.TestResult {
	var a *[]readonly char = trimTrailingSlashes("a//")
	var r *[]readonly char = trimTrailingSlashes("//")
	var e *[]readonly char = trimTrailingSlashes("")
	var n *[]readonly char = trimTrailingSlashes("a/b")
	if len(a) != 1 || a[0] != 'a' || len(r) != 1 || r[0] != '/' || len(e) != 0 || len(n) != 3 {
		return fail("trimTrailingSlashes should yield a, /, empty, a/b")
	}
	return ""
}
