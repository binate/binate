// Stat / Lstat / File.Stat — the FileInfo factories, mechanism-agnostic.
//
// Everything here is written once and shared by every hosted target.  The
// only per-(os,arch) piece is filling a statbuf from the native struct stat,
// done by statFd / statPath / lstatPath in stat_<target>.bn (each reads its
// platform's struct by field name).  This file owns the platform-neutral
// rest: the st_mode -> FileMode map (the S_IF* bits are identical on every
// POSIX target), the mtime conversion, and the EINTR-retrying entry points.
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/std/errors"
import "pkg/std/os/sys"
import "pkg/std/time"

// statbuf is the fixed, platform-neutral subset of a struct stat that os
// reports: size, the raw st_mode bits, and the modification time split into
// whole Unix seconds plus nanoseconds.  A per-(os,arch) statFd/statPath/
// lstatPath fills one by reading its native struct stat by field name.
type statbuf struct {
	size      int64 // st_size, in bytes
	stMode    uint32 // raw st_mode: S_IFMT type field | permission bits
	mtimeSec  int64 // st_mtim whole seconds since the Unix epoch
	mtimeNsec int32 // st_mtim nanoseconds, in [0, 1e9)
}

// File-type and special bits of a POSIX st_mode (octal).  These values are
// fixed by POSIX and identical on Linux and Darwin, so the st_mode -> FileMode
// map is shared across every hosted target.
const (
	S_IFMT uint32 = 0o170000   // mask selecting the file-type field
	S_IFSOCK uint32 = 0o140000 // socket
	S_IFLNK uint32 = 0o120000  // symbolic link
	S_IFREG uint32 = 0o100000  // regular file
	S_IFBLK uint32 = 0o060000  // block device
	S_IFDIR uint32 = 0o040000  // directory
	S_IFCHR uint32 = 0o020000  // character device
	S_IFIFO uint32 = 0o010000  // FIFO / named pipe
	S_ISUID uint32 = 0o4000    // set-user-ID
	S_ISGID uint32 = 0o2000    // set-group-ID
	S_ISVTX uint32 = 0o1000    // sticky bit
)

// fill copies the fields os reports (size, mode, mtime) out of a filled osStat.
// The casts absorb per-platform field widths: st_mode is 16-bit on Darwin and
// 32-bit on Linux; the mtime fields are 64-bit except on the 32-bit-time arm32
// ABI.  The active platform's osStat layout lives in stat_<platform>.bn.
func fill(st *osStat, out *statbuf) {
	out.size = st.st_size
	out.stMode = cast(uint32, st.st_mode)
	out.mtimeSec = cast(int64, st.st_mtime_sec)
	out.mtimeNsec = cast(int32, st.st_mtime_nsec)
}

// modeFromStat maps a raw POSIX st_mode to a FileMode: the low 9 bits carry
// straight over as the rwx permissions, the S_IFMT field selects the type
// bit(s) (a char device sets both ModeDevice and ModeCharDevice; an
// unrecognized type is ModeIrregular; a regular file sets no type bit), and
// the setuid/setgid/sticky bits map to their FileMode flags.  This mirrors
// Go's os.fileInfoFromStat so an equivalent file yields an equal FileMode.
func modeFromStat(stMode uint32) FileMode {
	var m FileMode = cast(FileMode, stMode & 0o777)
	var typ uint32 = stMode & S_IFMT
	if typ == S_IFDIR {
		m = m | ModeDir
	} else if typ == S_IFLNK {
		m = m | ModeSymlink
	} else if typ == S_IFCHR {
		m = m | ModeDevice | ModeCharDevice
	} else if typ == S_IFBLK {
		m = m | ModeDevice
	} else if typ == S_IFIFO {
		m = m | ModeNamedPipe
	} else if typ == S_IFSOCK {
		m = m | ModeSocket
	} else if typ != S_IFREG {
		m = m | ModeIrregular
	}
	if (stMode & S_ISUID) != 0 { m = m | ModeSetuid }
	if (stMode & S_ISGID) != 0 { m = m | ModeSetgid }
	if (stMode & S_ISVTX) != 0 { m = m | ModeSticky }
	return m
}

// fileInfoFromStat builds an owned @FileInfo from a filled statbuf and an
// owned name (the entry's base name).  It takes ownership of name.
func fileInfoFromStat(sb *statbuf, name @[]char) @FileInfo {
	var fi @FileInfo = make(FileInfo)
	fi.name = name
	fi.size = sb.size
	fi.mode = modeFromStat(sb.stMode)
	fi.modTime = time.FromUnix(sb.mtimeSec, sb.mtimeNsec)
	return fi
}

// Stat returns a FileInfo for name via stat(2) (following symlinks).
func Stat(name *[]readonly char) (@FileInfo, @errors.Error) {
	var cp @[]uint8 = cPath(name)
	var sb statbuf
	var rc int
	for {
		rc = statPath(dataOfManaged(cp), &sb)
		if rc >= 0 || !sys.Interrupted() { break } // EINTR: retry the stat
	}
	if rc < 0 {
		var none @FileInfo
		return none, sys.FailErrno("stat")
	}
	return fileInfoFromStat(&sb, basename(name)), errEmpty()
}

// Lstat returns a FileInfo for name via lstat(2) (not following symlinks).
func Lstat(name *[]readonly char) (@FileInfo, @errors.Error) {
	var cp @[]uint8 = cPath(name)
	var sb statbuf
	var rc int
	for {
		rc = lstatPath(dataOfManaged(cp), &sb)
		if rc >= 0 || !sys.Interrupted() { break } // EINTR: retry the lstat
	}
	if rc < 0 {
		var none @FileInfo
		return none, sys.FailErrno("lstat")
	}
	return fileInfoFromStat(&sb, basename(name)), errEmpty()
}

// Stat returns a FileInfo for the open file via fstat(2) on its descriptor.
func (f *File) Stat() (@FileInfo, @errors.Error) {
	var sb statbuf
	var rc int
	for {
		rc = statFd(f.fd, &sb)
		if rc >= 0 || !sys.Interrupted() { break } // EINTR: retry the fstat
	}
	if rc < 0 {
		var none @FileInfo
		return none, sys.FailErrno("fstat")
	}
	return fileInfoFromStat(&sb, basename(f.name)), errEmpty()
}
