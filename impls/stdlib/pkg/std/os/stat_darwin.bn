// Darwin struct stat layout for os.Stat (data only): the 64-bit-inode flavor,
// arch-independent (x86_64 + arm64 share this 144-byte layout).  The shared
// fill (stat.bn) reads st_size / st_mode / st_mtime_* by field; the syscall
// wrappers live in stat_io.bn.  Verified against the C compiler by
// e2e/stat-values.sh.
#[build(is(os, "darwin"))]
package "pkg/std/os"

// osStat replicates Darwin's struct stat (sizeof 144).  Fields beyond
// st_size / st_mode / st_mtime are present only to reproduce the layout.
type osStat struct {
	st_dev            int32
	st_mode           uint16
	st_nlink          uint16
	st_ino            uint64
	st_uid            uint32
	st_gid            uint32
	st_rdev           int32
	st_atime_sec      int64
	st_atime_nsec     int64
	st_mtime_sec      int64
	st_mtime_nsec     int64
	st_ctime_sec      int64
	st_ctime_nsec     int64
	st_birthtime_sec  int64
	st_birthtime_nsec int64
	st_size           int64
	st_blocks         int64
	st_blksize        int32
	st_flags          uint32
	st_gen            uint32
	st_lspare         int32
	st_qspare0        int64
	st_qspare1        int64
}
