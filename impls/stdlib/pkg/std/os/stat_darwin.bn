// Darwin struct stat reader.  Darwin's struct stat (the 64-bit-inode flavor,
// the only one current macOS uses) is arch-independent: x86_64 and arm64 share
// this 144-byte layout, so one file serves both Darwin arches.  The replica is
// field-for-field faithful — fstat/stat/lstat fill it and os reads st_size /
// st_mode / st_mtime out at the platform's offsets (verified against the system
// C compiler by e2e/stat-values.sh).
#[build(is(os, "darwin"))]
package "pkg/std/os"

// darwinStat replicates Darwin's struct stat (sizeof 144).  The st_atime /
// st_ctime / st_birthtime pairs and the spare/dev fields are present only to
// reproduce the layout; os reads just st_size, st_mode, and st_mtime.
type darwinStat struct {
	st_dev           int32
	st_mode          uint16
	st_nlink         uint16
	st_ino           uint64
	st_uid           uint32
	st_gid           uint32
	st_rdev          int32
	st_atime_sec     int64
	st_atime_nsec    int64
	st_mtime_sec     int64
	st_mtime_nsec    int64
	st_ctime_sec     int64
	st_ctime_nsec    int64
	st_birthtime_sec  int64
	st_birthtime_nsec int64
	st_size          int64
	st_blocks        int64
	st_blksize       int32
	st_flags         uint32
	st_gen           uint32
	st_lspare        int32
	st_qspare0       int64
	st_qspare1       int64
}

// fill copies the fields os reports out of a filled darwinStat.  st_mode is
// 16-bit on Darwin, so it widens to the statbuf's 32-bit stMode.
func fill(st *darwinStat, out *statbuf) {
	out.size = st.st_size
	out.stMode = cast(uint32, st.st_mode)
	out.mtimeSec = st.st_mtime_sec
	out.mtimeNsec = cast(int32, st.st_mtime_nsec)
}

// statFd fills out via fstat(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st darwinStat
	var rc int = __c_call("fstat", int, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// statPath fills out via stat(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st darwinStat
	var rc int = __c_call("stat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// lstatPath fills out via lstat(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st darwinStat
	var rc int = __c_call("lstat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}
