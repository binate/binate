// stat/fstat/lstat syscall wrappers for the hosted targets whose plain stat
// symbol already fills a 64-bit-inode struct stat: 64-bit Linux and arm64-Darwin.
// Each allocates the active platform's osStat (stat_<platform>.bn), fills it via
// the C call, and hands it to the shared fill (stat.bn).  arm32 Linux uses the
// *64 LFS variants (stat_io_arm32.bn); x86_64-Darwin uses the $INODE64 variants
// (stat_io_darwin_x64.bn) because there the bare stat/lstat/fstat are the LEGACY
// 32-bit-inode functions with an incompatible struct layout.
#[build(!is(os, "baremetal") && !is(arch, "arm32") && !(is(os, "darwin") && is(arch, "x64")))]
package "pkg/std/os"

// The C stat/fstat/lstat return `int` (a 32-bit C int), so the c-call return is
// annotated `int32` and sign-extended to the wrapper's `int` result.  Reading a
// sub-word C return as the 64-bit binate `int` is wrong: the upper bits of the
// return register are unspecified for a 32-bit C return, and on x86-64 a
// `mov eax,-1` zeroes the upper half of RAX, so a -1 failure reads back as
// 4294967295 (>= 0) — the caller's `rc < 0` error test never fires and a stat of
// a missing path wrongly succeeds.  (read/write etc. correctly use `int` because
// C ssize_t is already 64-bit on LP64.)

// statFd fills out via fstat(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st osStat
	var rc int32 = __c_call("fstat", int32, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}

// statPath fills out via stat(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int32 = __c_call("stat", int32, path, &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}

// lstatPath fills out via lstat(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int32 = __c_call("lstat", int32, path, &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}
