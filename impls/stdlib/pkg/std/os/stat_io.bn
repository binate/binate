// stat/fstat/lstat syscall wrappers for the non-LFS hosted targets (Darwin +
// 64-bit Linux, where plain stat already gives a 64-bit off_t).  Each allocates
// the active platform's osStat (stat_<platform>.bn), fills it via the C call,
// and hands it to the shared fill (stat.bn).  arm32 uses the *64 LFS variants
// in stat_io_arm32.bn.
#[build(!is(os, "baremetal") && !is(arch, "arm32"))]
package "pkg/std/os"

// statFd fills out via fstat(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st osStat
	var rc int = __c_call("fstat", int, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// statPath fills out via stat(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int = __c_call("stat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// lstatPath fills out via lstat(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int = __c_call("lstat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}
