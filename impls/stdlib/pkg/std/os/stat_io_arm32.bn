// LFS stat64/fstat64/lstat64 syscall wrappers for 32-bit ARM Linux, where the
// plain struct stat caps st_size at 2 GiB.  Mirrors stat_io.bn but with the
// *64 symbols and the arm32 osStat (struct stat64) layout.
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os"

// statFd fills out via fstat64(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st osStat
	var rc int = __c_call("fstat64", int, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// statPath fills out via stat64(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int = __c_call("stat64", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// lstatPath fills out via lstat64(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int = __c_call("lstat64", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}
