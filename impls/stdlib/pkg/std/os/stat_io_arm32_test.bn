// Gated to 32-bit ARM Linux: exercises the LFS stat64/fstat64/lstat64 wrappers
// in stat_io_arm32.bn against a known file size.
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestStatIoArm32 confirms statPath (stat64) reads the right size out of the
// arm32 osStat (struct stat64) layout.
func TestStatIoArm32() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_stat_io_probe")
	if present(err) { return fail("create") }
	var n int
	n, err = f.Write("12345")
	if present(err) || n != 5 { return fail("write") }
	if present(f.Close()) { return fail("close") }
	var sb statbuf
	var cp @[]uint8 = cPath("/tmp/binate_stat_io_probe")
	if statPath(dataOfManaged(cp), &sb) != 0 { return fail("statPath") }
	if sb.size != cast(int64, 5) { return fail("statPath should read size 5") }
	return ""
}
