// stat/fstat/lstat syscall wrappers for x86_64-Darwin.  Mirrors stat_io.bn but
// calls the $INODE64 symbols.  On x86_64 macOS, <sys/stat.h> aliases
// stat/lstat/fstat via __DARWIN_INODE64 to stat$INODE64/... — the functions that
// fill the modern 64-bit-inode struct stat that stat_darwin.bn's osStat
// replicates.  The bare stat/lstat/fstat symbols still exist but are the LEGACY
// 32-bit-inode functions with a DIFFERENT layout, so linking them fills osStat
// with garbage (st_size reads 0, st_mtime_nsec lands on ctime seconds and panics
// time.FromUnix).  arm64-Darwin needs no such variant — there the bare symbol is
// already the 64-bit-inode function (stat_io.bn covers it), and no $INODE64
// symbol exists.  __c_call carries the symbol verbatim (only a Mach-O leading '_'
// is added), so the '$' passes through unmangled to _stat$INODE64.
#[build(is(os, "darwin") && is(arch, "x64"))]
package "pkg/std/os"

// The C stat/lstat/fstat return `int` (32-bit); annotate the c-call return
// `int32` and sign-extend to `int` so a -1 failure is not misread as a large
// positive — see the note in stat_io.bn.

// statFd fills out via fstat$INODE64(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st osStat
	var rc int32 = __c_call("fstat$INODE64", int32, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}

// statPath fills out via stat$INODE64(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int32 = __c_call("stat$INODE64", int32, path, &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}

// lstatPath fills out via lstat$INODE64(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st osStat
	var rc int32 = __c_call("lstat$INODE64", int32, path, &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}
