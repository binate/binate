// Gated to x86_64-Darwin, matching stat_io_darwin_x64.bn: confirms the
// $INODE64 stat wrappers read the right size out of the 64-bit-inode osStat.  A
// bare-symbol regression (legacy 32-bit-inode layout) reads size 0 here and
// panics time.FromUnix in the modtime path — see conformance/stdlib/os/009_stat.
#[build(is(os, "darwin") && is(arch, "x64"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestStatIoDarwinX64 confirms statPath (stat$INODE64) reads the right size out
// of the 64-bit-inode osStat layout.
func TestStatIoDarwinX64() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_stat_io_darwin_x64_probe")
	if present(err) { return fail("create") }
	var n int
	n, err = f.Write("12345")
	if present(err) || n != 5 { return fail("write") }
	if present(f.Close()) { return fail("close") }
	var sb statbuf
	var cp @[]uint8 = cPath("/tmp/binate_stat_io_darwin_x64_probe")
	if statPath(dataOfManaged(cp), &sb) != 0 { return fail("statPath") }
	if sb.size != cast(int64, 5) { return fail("statPath should read size 5") }
	return ""
}
