// Gated to the non-LFS hosted targets (Darwin + 64-bit Linux): exercises the
// stat/fstat/lstat wrappers in stat_io.bn against a known file size.
#[build(!is(os, "baremetal") && !is(arch, "arm32"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestStatIo confirms statPath reads the right size out of the active
// platform's osStat layout (a wrong offset would give a wrong size).
func TestStatIo() testing.TestResult {
	var f @File
	var err @errors.Error
	f, err = Create("/tmp/binate_stat_io_probe")
	if present(err) { return fail("create") }
	var n int
	n, err = f.Write("12345")
	if present(err) || n != 5 { return fail("write") }
	if present(f.Close()) { return fail("close") }
	var sb statbuf
	var cp @[]uint8 = cPath("/tmp/binate_stat_io_probe")
	if statPath(dataOfManaged(cp), &sb) != 0 { return fail("statPath") }
	if sb.size != cast(int64, 5) { return fail("statPath should read size 5") }
	return ""
}
