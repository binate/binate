// Linux/aarch64 struct stat layout for os.Stat (data only): glibc 128-byte
// layout (st_mode before a 4-byte st_nlink, an 8-byte __pad1 after st_rdev so
// st_size lands at 48).  LP64.  Shared fill + wrappers in stat.bn / stat_io.bn.
#[build(is(os, "linux") && is(arch, "aarch64"))]
package "pkg/std/os"

// osStat replicates glibc's aarch64 struct stat (sizeof 128).  __pad1 is
// load-bearing: without it st_size would read 8 bytes early.
type osStat struct {
	st_dev        uint64
	st_ino        uint64
	st_mode       uint32
	st_nlink      uint32
	st_uid        uint32
	st_gid        uint32
	st_rdev       uint64
	__pad1        uint64
	st_size       int64
	st_blksize    int32
	__pad2        int32
	st_blocks     int64
	st_atime_sec  int64
	st_atime_nsec int64
	st_mtime_sec  int64
	st_mtime_nsec int64
	st_ctime_sec  int64
	st_ctime_nsec int64
	__reserved0   int32
	__reserved1   int32
}
