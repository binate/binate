// Linux/aarch64 struct stat reader.  glibc's aarch64 struct stat is 128 bytes
// and differs from x86_64: st_mode precedes a 4-byte st_nlink, there is an
// explicit 8-byte __pad1 after st_rdev (so st_size lands at offset 48, not 40),
// and st_mtim is at 88 (verified against glibc).  LP64, so plain
// fstat/stat/lstat give a 64-bit off_t.
#[build(is(os, "linux") && is(arch, "aarch64"))]
package "pkg/std/os"

// linuxAarch64Stat replicates glibc's aarch64 struct stat (sizeof 128).  The
// __pad1 after st_rdev is load-bearing: without it st_size would read 8 bytes
// early.
type linuxAarch64Stat struct {
	st_dev        uint64
	st_ino        uint64
	st_mode       uint32
	st_nlink      uint32
	st_uid        uint32
	st_gid        uint32
	st_rdev       uint64
	__pad1        uint64
	st_size       int64
	st_blksize    int32
	__pad2        int32
	st_blocks     int64
	st_atime_sec  int64
	st_atime_nsec int64
	st_mtime_sec  int64
	st_mtime_nsec int64
	st_ctime_sec  int64
	st_ctime_nsec int64
	__reserved0   int32
	__reserved1   int32
}

// fill copies the fields os reports out of a filled linuxAarch64Stat.
func fill(st *linuxAarch64Stat, out *statbuf) {
	out.size = st.st_size
	out.stMode = st.st_mode
	out.mtimeSec = st.st_mtime_sec
	out.mtimeNsec = cast(int32, st.st_mtime_nsec)
}

// statFd fills out via fstat(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st linuxAarch64Stat
	var rc int = __c_call("fstat", int, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// statPath fills out via stat(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st linuxAarch64Stat
	var rc int = __c_call("stat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// lstatPath fills out via lstat(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st linuxAarch64Stat
	var rc int = __c_call("lstat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}
