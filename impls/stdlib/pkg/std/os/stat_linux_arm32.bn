// Linux/arm32 struct stat64 layout for os.Stat (data only): ILP32 with a
// 64-bit off_t requires the LFS struct stat64 (sizeof 104, 32-bit time
// fields).  The matching *64 syscall wrappers are in stat_io_arm32.bn.
// Verified against glibc and under qemu by the arm32-linux conformance mode.
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os"

// osStat replicates glibc's arm32 struct stat64 (sizeof 104).  The __pad fields
// and legacy 32-bit __st_ino are layout-only; the real 64-bit st_ino is last.
type osStat struct {
	st_dev        uint64
	__pad0        uint32
	__st_ino      uint32
	st_mode       uint32
	st_nlink      uint32
	st_uid        uint32
	st_gid        uint32
	st_rdev       uint64
	__pad3        uint32
	st_size       int64
	st_blksize    uint32
	st_blocks     uint64
	st_atime_sec  int32
	st_atime_nsec int32
	st_mtime_sec  int32
	st_mtime_nsec int32
	st_ctime_sec  int32
	st_ctime_nsec int32
	st_ino        uint64
}
