// Linux/arm32 struct stat reader.  arm32 is ILP32 with a 32-bit off_t in the
// plain struct stat, which would cap st_size at 2 GiB — so, exactly as os's
// seek/pread/pwrite route to the lseek64/pread64/pwrite64 LFS variants on
// arm32, Stat routes to fstat64/stat64/lstat64 and reads glibc's struct stat64
// (sizeof 104, 64-bit st_size/st_ino, 32-bit time fields; verified against
// glibc, and at runtime under qemu by the arm32-linux conformance mode).
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os"

// linuxArm32Stat64 replicates glibc's arm32 struct stat64 (sizeof 104).  The
// __pad fields and the legacy 32-bit __st_ino are layout-only; the real 64-bit
// st_ino sits at the end.  Time fields are 32-bit on this (non-time64) ABI.
type linuxArm32Stat64 struct {
	st_dev        uint64
	__pad0        uint32
	__st_ino      uint32
	st_mode       uint32
	st_nlink      uint32
	st_uid        uint32
	st_gid        uint32
	st_rdev       uint64
	__pad3        uint32
	st_size       int64
	st_blksize    uint32
	st_blocks     uint64
	st_atime_sec  int32
	st_atime_nsec int32
	st_mtime_sec  int32
	st_mtime_nsec int32
	st_ctime_sec  int32
	st_ctime_nsec int32
	st_ino        uint64
}

// fill copies the fields os reports out of a filled linuxArm32Stat64.  The
// time fields are 32-bit here, so mtimeSec widens to int64.
func fill(st *linuxArm32Stat64, out *statbuf) {
	out.size = st.st_size
	out.stMode = st.st_mode
	out.mtimeSec = cast(int64, st.st_mtime_sec)
	out.mtimeNsec = st.st_mtime_nsec
}

// statFd fills out via fstat64(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st linuxArm32Stat64
	var rc int = __c_call("fstat64", int, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// statPath fills out via stat64(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st linuxArm32Stat64
	var rc int = __c_call("stat64", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// lstatPath fills out via lstat64(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st linuxArm32Stat64
	var rc int = __c_call("lstat64", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}
