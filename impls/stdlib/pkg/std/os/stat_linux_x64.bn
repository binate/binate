// Linux/x86_64 struct stat reader.  glibc's x86_64 struct stat is 144 bytes,
// with an 8-byte st_nlink ahead of a 32-bit st_mode, a 4-byte __pad0 before
// st_rdev, and st_size at offset 48 / st_mtim at 88 (verified against glibc and
// by e2e/stat-values.sh).  LP64, so plain fstat/stat/lstat give a 64-bit
// off_t directly.
#[build(is(os, "linux") && is(arch, "x64"))]
package "pkg/std/os"

// linuxX64Stat replicates glibc's x86_64 struct stat (sizeof 144).
type linuxX64Stat struct {
	st_dev        uint64
	st_ino        uint64
	st_nlink      uint64
	st_mode       uint32
	st_uid        uint32
	st_gid        uint32
	__pad0        int32
	st_rdev       uint64
	st_size       int64
	st_blksize    int64
	st_blocks     int64
	st_atime_sec  int64
	st_atime_nsec int64
	st_mtime_sec  int64
	st_mtime_nsec int64
	st_ctime_sec  int64
	st_ctime_nsec int64
	__reserved0   int64
	__reserved1   int64
	__reserved2   int64
}

// fill copies the fields os reports out of a filled linuxX64Stat.
func fill(st *linuxX64Stat, out *statbuf) {
	out.size = st.st_size
	out.stMode = st.st_mode
	out.mtimeSec = st.st_mtime_sec
	out.mtimeNsec = cast(int32, st.st_mtime_nsec)
}

// statFd fills out via fstat(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *statbuf) int {
	var st linuxX64Stat
	var rc int = __c_call("fstat", int, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// statPath fills out via stat(2) on a NUL-terminated path.
func statPath(path *uint8, out *statbuf) int {
	var st linuxX64Stat
	var rc int = __c_call("stat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}

// lstatPath fills out via lstat(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *statbuf) int {
	var st linuxX64Stat
	var rc int = __c_call("lstat", int, path, &st)
	if rc == 0 { fill(&st, out) }
	return rc
}
