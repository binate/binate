// Unit tests for the platform-neutral Stat helpers (modeFromStat, basename,
// cloneChars, fileInfoFromStat).  These are pure logic — no syscalls — so they
// exercise the type-mapping branches and path edges that the injected stdlib
// conformance suite cannot easily reach (sockets, devices, fifos, symlinks).
// Gated to the hosted variant like the rest of the os tests.
#[build(!is(os, "baremetal"))]
package "pkg/std/os"

import "pkg/builtins/testing"
import "pkg/std/os/sys"
import "pkg/std/time"

// modeFromStat maps each S_IFMT file type to the right FileMode bit(s), carries
// the permission bits through, and maps setuid/setgid/sticky.
func TestModeFromStat() testing.TestResult {
	var reg FileMode = modeFromStat(S_IFREG | 0o644)
	if !reg.IsRegular() { return fail("S_IFREG should be a regular file") }
	if reg.Perm() != cast(FileMode, 0o644) { return fail("regular perm should be 0o644") }
	if reg.Type() != cast(FileMode, 0) { return fail("regular file has no type bit") }

	var dir FileMode = modeFromStat(S_IFDIR | 0o755)
	if !dir.IsDir() { return fail("S_IFDIR should be a directory") }
	if dir.Perm() != cast(FileMode, 0o755) { return fail("dir perm should be 0o755") }

	if modeFromStat(S_IFLNK).Type() != ModeSymlink { return fail("S_IFLNK → ModeSymlink") }
	if modeFromStat(S_IFSOCK).Type() != ModeSocket { return fail("S_IFSOCK → ModeSocket") }
	if modeFromStat(S_IFIFO).Type() != ModeNamedPipe { return fail("S_IFIFO → ModeNamedPipe") }

	// A char device sets BOTH ModeDevice and ModeCharDevice.
	var chr FileMode = modeFromStat(S_IFCHR)
	if (chr & ModeDevice) == cast(FileMode, 0) { return fail("S_IFCHR → ModeDevice") }
	if (chr & ModeCharDevice) == cast(FileMode, 0) { return fail("S_IFCHR → ModeCharDevice") }
	// A block device sets ModeDevice but NOT ModeCharDevice.
	var blk FileMode = modeFromStat(S_IFBLK)
	if (blk & ModeDevice) == cast(FileMode, 0) { return fail("S_IFBLK → ModeDevice") }
	if (blk & ModeCharDevice) != cast(FileMode, 0) {
		return fail("S_IFBLK must not set ModeCharDevice")
	}

	// setuid / setgid / sticky carry over alongside the type/perm.
	var sp FileMode = modeFromStat(S_IFREG | S_ISUID | S_ISGID | S_ISVTX | 0o600)
	if (sp & ModeSetuid) == cast(FileMode, 0) { return fail("S_ISUID → ModeSetuid") }
	if (sp & ModeSetgid) == cast(FileMode, 0) { return fail("S_ISGID → ModeSetgid") }
	if (sp & ModeSticky) == cast(FileMode, 0) { return fail("S_ISVTX → ModeSticky") }
	if sp.Perm() != cast(FileMode, 0o600) { return fail("special-bit file keeps its perm") }
	return ""
}

// basename returns an owned copy of the final '/'-separated component.
func TestBasename() testing.TestResult {
	var a @[]char = basename("/a/b/c")
	if len(a) != 1 || a[0] != 'c' { return fail("basename(/a/b/c) should be \"c\"") }
	var b @[]char = basename("foo")
	if len(b) != 3 || b[0] != 'f' || b[2] != 'o' { return fail("basename(foo) should be \"foo\"") }
	if len(basename("/a/b/")) != 0 { return fail("basename of a trailing slash is empty") }
	if len(basename("/")) != 0 { return fail("basename(/) is empty") }
	var e @[]char = basename("/var/log")
	if len(e) != 3 || e[0] != 'l' { return fail("basename(/var/log) should be \"log\"") }
	return ""
}

// cloneChars copies a borrowed char slice into a fresh owned one.
func TestCloneChars() testing.TestResult {
	var c @[]char = cloneChars("hello")
	if len(c) != 5 { return fail("cloneChars length should be 5") }
	if c[0] != 'h' || c[4] != 'o' { return fail("cloneChars content mismatch") }
	return ""
}

// fileInfoFromStat builds a FileInfo from a sys.StatInfo + owned name, mapping
// size, mode, and the mtime through time.FromUnix.
func TestFileInfoFromStat() testing.TestResult {
	var si sys.StatInfo
	si.Size = cast(int64, 4096)
	si.Mode = S_IFDIR | 0o750
	si.MtimeSec = cast(int64, 1000000000)
	si.MtimeNsec = cast(int32, 500)
	var fi @FileInfo = fileInfoFromStat(&si, basename("/var/log"))

	if fi.Size() != cast(int64, 4096) { return fail("size should be 4096") }
	if !fi.IsDir() { return fail("should be a directory") }
	if fi.Mode().Perm() != cast(FileMode, 0o750) { return fail("perm should be 0o750") }
	if len(fi.Name()) != 3 { return fail("name should be \"log\"") }

	var mt time.Point = fi.ModTime()
	var sec int64
	var nsec int32
	sec, nsec = mt.ToUnix()
	if sec != cast(int64, 1000000000) { return fail("mtime seconds round-trip") }
	if nsec != cast(int32, 500) { return fail("mtime nanoseconds round-trip") }
	return ""
}
