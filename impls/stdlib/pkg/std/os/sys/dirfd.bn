// Directory-fd-relative calls: openat(2) / unlinkat(2) / fdopendir(3).  A walk
// that holds each directory open by fd and names its entries relative to that
// fd never follows a name another process swapped for a symbolic link between
// two calls, as a walk by path would.  The AT_* / O_* values are the host's
// native ones, chosen at compile time from build.OS / build.Arch.  Hosted only;
// os-family-internal.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/builtins/build"
import "pkg/std/errors"

// AtCwd returns the native AT_FDCWD.
func AtCwd() int {
	if build.OS == build.OS_DARWIN { return -2 }
	return -100
}

// openDirFlags is the native O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC.
// Linux on ARM (arm32, aarch64) places O_DIRECTORY / O_NOFOLLOW below the
// generic bits x86-64 uses.
func openDirFlags() int {
	if build.OS == build.OS_DARWIN { return 0x100000 | 0x0100 | 0x1000000 }
	if build.Arch == build.ARCH_X64 { return 0x10000 | 0x20000 | 0x80000 }
	return 0x4000 | 0x8000 | 0x80000
}

// dupFdCloexec is the native F_DUPFD_CLOEXEC fcntl(2) command.
func dupFdCloexec() int {
	if build.OS == build.OS_DARWIN { return 67 }
	return 1030
}

// atRemoveDir is the native AT_REMOVEDIR.
func atRemoveDir() int {
	if build.OS == build.OS_DARWIN { return 0x0080 }
	return 0x0200
}

// OpenDirAt opens name relative to dirfd as a directory, not following a final
// symbolic link (sys.bni), retrying EINTR.
func OpenDirAt(dirfd int, name *[]readonly char) (int, @errors.Error) {
	var buf @[]uint8 = cStr(name)
	var fd int32
	for {
		fd = __c_call("openat", int32, cast(int32, dirfd), dataOfManaged(buf),
				cast(int32, openDirFlags()), ...)
		if cast(int, fd) >= 0 || !Interrupted() {
			break
		}
	}
	if cast(int, fd) < 0 {
		return -1, FailErrno("openat")
	}
	var noErr @errors.Error
	return cast(int, fd), noErr
}

// UnlinkAt removes name relative to dirfd (sys.bni).
func UnlinkAt(dirfd int, name *[]readonly char, dir bool) @errors.Error {
	var buf @[]uint8 = cStr(name)
	var flags int = 0
	if dir { flags = atRemoveDir() }
	var rc int32 = __c_call("unlinkat", int32, cast(int32, dirfd), dataOfManaged(buf),
			cast(int32, flags))
	if rc != 0 {
		return FailErrno("unlinkat")
	}
	var noErr @errors.Error
	return noErr
}

// ReadDirFd reads the directory open as fd through a stream over a duplicate of
// it (fdopendir takes the descriptor it is given, and closedir closes it).  The
// duplicate keeps close-on-exec (F_DUPFD_CLOEXEC, where dup(2) would clear it) and
// is rewound first, so the whole directory is read whatever fd's position.
func ReadDirFd(fd int) (@[]@DirEnt, @errors.Error) {
	var none @[]@DirEnt
	var dupFd int32 = __c_call("fcntl", int32, cast(int32, fd), cast(int32, dupFdCloexec()), ...,
			cast(int32, 0))
	if cast(int, dupFd) < 0 {
		return none, FailErrno("fcntl")
	}
	var serr @errors.Error
	_, serr = Lseek(cast(int, dupFd), 0, 0)
	if present(serr) {
		var rc int32 = __c_call("close", int32, dupFd)
		_ = rc
		return none, serr
	}
	var dir *uint8 = fdOpenDir(dupFd)
	if dir == bit_cast(*uint8, 0) {
		var err @errors.Error = FailErrno("fdopendir")
		var rc int32 = __c_call("close", int32, dupFd)
		_ = rc
		return none, err
	}
	var noErr @errors.Error
	return readDirStream(dir), noErr
}
