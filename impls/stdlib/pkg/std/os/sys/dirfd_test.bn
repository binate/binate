// Tests for the directory-fd-relative calls (dirfd.bn): OpenDirAt opens only a
// real directory, UnlinkAt removes a symbolic link itself, and an open directory
// fd keeps naming the directory it opened after its name is swapped for a link --
// the property os.RemoveAll's walk relies on.  Uses makeProbe / sysTestDir /
// sysJoin (stat_test.bn) and nameEq (readdir_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// gone reports whether path no longer exists (Lstat is NotFound).
func gone(path *[]readonly char) bool {
	var err @errors.Error
	_, err = Lstat(path)
	return present(err) && errors.Is(err, errors.NotFound)
}

// OpenDirAt opens a directory, and refuses a symbolic link to one and a regular
// file with errors.ConditionsUnmet.
func TestOpenDirAtOnlyDirectories() testing.TestResult {
	var dir @[]char = sysTestDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	if present(Mkdir(sysJoin(dir, "sub"), 0o755)) { return fail("mkdir sub") }
	if present(makeProbe(sysJoin(dir, "file"))) { return fail("create file") }
	if present(Symlink(sysJoin(dir, "sub"), sysJoin(dir, "link"))) { return fail("symlink") }
	var dfd int
	var err @errors.Error
	dfd, err = OpenDirAt(AtCwd(), dir)
	if present(err) { return fail("OpenDirAt should open the temp dir") }
	var fd int
	fd, err = OpenDirAt(dfd, "sub")
	if present(err) { return fail("OpenDirAt should open a directory") }
	Close(fd)
	_, err = OpenDirAt(dfd, "link")
	if !present(err) || !errors.Is(err, errors.ConditionsUnmet) {
		return fail("OpenDirAt must refuse a symbolic link (ELOOP)")
	}
	_, err = OpenDirAt(dfd, "file")
	if !present(err) || !errors.Is(err, errors.ConditionsUnmet) {
		return fail("OpenDirAt must refuse a regular file (ENOTDIR)")
	}
	Close(dfd)
	Remove(sysJoin(dir, "link"))
	Remove(sysJoin(dir, "file"))
	Remove(sysJoin(dir, "sub"))
	Remove(dir)
	return ""
}

// UnlinkAt removes a symbolic link to a directory without touching the
// directory, and removes an empty directory with dir set.
func TestUnlinkAtLinkAndDir() testing.TestResult {
	var dir @[]char = sysTestDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	if present(Mkdir(sysJoin(dir, "sub"), 0o755)) { return fail("mkdir sub") }
	if present(Symlink(sysJoin(dir, "sub"), sysJoin(dir, "link"))) { return fail("symlink") }
	var dfd int
	var err @errors.Error
	dfd, err = OpenDirAt(AtCwd(), dir)
	if present(err) { return fail("OpenDirAt should open the temp dir") }
	if present(UnlinkAt(dfd, "link", false)) { return fail("UnlinkAt should remove the link") }
	if !gone(sysJoin(dir, "link")) || gone(sysJoin(dir, "sub")) {
		return fail("UnlinkAt must remove the link, not the directory it names")
	}
	if present(UnlinkAt(dfd, "sub", true)) {
		return fail("UnlinkAt should remove the empty directory")
	}
	if !gone(sysJoin(dir, "sub")) { return fail("the empty directory should be gone") }
	Close(dfd)
	Remove(dir)
	return ""
}

// A directory open by fd is still the one listed and modified through the fd
// after its name is replaced by a symbolic link to another directory; ReadDirFd
// leaves the fd open for that.
func TestDirFdSurvivesNameSwap() testing.TestResult {
	var dir @[]char = sysTestDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	var a @[]char = sysJoin(dir, "a")
	var moved @[]char = sysJoin(dir, "moved")
	var outside @[]char = sysJoin(dir, "outside")
	if present(Mkdir(a, 0o755)) || present(Mkdir(outside, 0o755)) { return fail("mkdir") }
	if present(makeProbe(sysJoin(a, "inner"))) || present(makeProbe(sysJoin(outside, "inner"))) {
		return fail("create the inner files")
	}
	var fd int
	var err @errors.Error
	fd, err = OpenDirAt(AtCwd(), a)
	if present(err) { return fail("OpenDirAt should open a") }
	if present(Rename(a, moved)) || present(Symlink(outside, a)) {
		return fail("swap a for a link to outside")
	}
	var ents @[]@DirEnt
	ents, err = ReadDirFd(fd)
	if present(err) || len(ents) != 1 || !nameEq(ents[0].Name, "inner") {
		return fail("ReadDirFd should list the opened directory's one entry")
	}
	if present(UnlinkAt(fd, "inner", false)) { return fail("UnlinkAt through the fd should succeed") }
	if !gone(sysJoin(moved, "inner")) || gone(sysJoin(outside, "inner")) {
		return fail("the fd must name the opened directory, not the link now at its name")
	}
	Close(fd)
	Remove(a)
	Remove(moved)
	Remove(sysJoin(outside, "inner"))
	Remove(outside)
	Remove(dir)
	return ""
}

// ReadDirFd reads the whole directory each time, whatever fd's position: a
// second call on the same fd lists the entries again.
func TestReadDirFdTwice() testing.TestResult {
	var dir @[]char = sysTestDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	if present(makeProbe(sysJoin(dir, "one"))) || present(makeProbe(sysJoin(dir, "two"))) {
		return fail("create the entries")
	}
	var fd int
	var err @errors.Error
	fd, err = OpenDirAt(AtCwd(), dir)
	if present(err) { return fail("OpenDirAt should open the temp dir") }
	var first @[]@DirEnt
	var second @[]@DirEnt
	first, err = ReadDirFd(fd)
	if present(err) || len(first) != 2 { return fail("the first ReadDirFd should list both entries") }
	second, err = ReadDirFd(fd)
	if present(err) || len(second) != 2 {
		return fail("a second ReadDirFd should list both entries again")
	}
	Close(fd)
	Remove(sysJoin(dir, "one"))
	Remove(sysJoin(dir, "two"))
	Remove(dir)
	return ""
}
