// Gated to Darwin: exercises the Darwin errno() accessor (errno_darwin.bn).
#[build(is(os, "darwin"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestErrnoDarwin checks errno() returns the live C errno: a failed access() of a
// nonexistent path leaves errno == ENOENT (which Accessible classifies NotFound).
func TestErrnoDarwin() testing.TestResult {
	var err @errors.Error = Accessible("/no_such_path_errno_probe_zzzzz")
	if !present(err) { return fail("access of a nonexistent path should fail") }
	if errno() != ENOENT { return fail("errno() should be ENOENT after the failed access") }
	if !errors.Is(err, errors.NotFound) { return fail("a nonexistent path should classify NotFound") }
	return ""
}
