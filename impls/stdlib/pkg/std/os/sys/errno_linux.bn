// Linux errno accessor.  Linux reaches the C errno through
// `int *__errno_location(void)`.
//
// errno() lives in a per-OS file (rather than a build.OS branch inside one
// body) because __c_call needs a literal symbol that must LINK: a single body
// referencing both __error and __errno_location would fail to link the
// wrong-OS symbol.  The #[build] gate emits only the active OS's accessor.
// (The errno accessor is OS-, not arch-specific — the same on every Linux arch.)
#[build(is(os, "linux"))]
package "pkg/std/os/sys"

// errno returns the current value of the C errno (thread-local).
func errno() int {
	var p *int32 = __c_call("__errno_location", *int32)
	return cast(int, p[0])
}
