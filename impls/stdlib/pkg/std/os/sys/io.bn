// fd-based I/O syscall wrappers for the os family: read/write/close/pread/pwrite/
// lseek/open, done over __c_call with EINTR retry and internal errno
// classification, so callers get an errors.Error and never touch errno.  The
// offset-bearing calls select an LFS `*64` entry point on arm32-linux (32-bit
// `off_t` otherwise), so a Binate int64 offset passes through intact.  Hosted
// only; os-family-internal.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/std/errors"

// dataOf returns the data pointer (word 0) of a mutable raw byte slice, for
// handing to a syscall as a C `void*`.
func dataOf(p *[]uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// dataOfRO is dataOf for a readonly byte slice (a write/pwrite buffer, passed as
// a C `const void*`).
func dataOfRO(p *[]readonly uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// Read reads up to len(p) bytes into p from fd (read(2), EINTR retried).  Returns
// the byte count; 0 on a non-empty p means end-of-input (the caller maps it to
// EOF — this layer has no stream semantics).
func Read(fd int, p *[]uint8) (int, @errors.Error) {
	var n int
	for {
		n = __c_call("read", int, cast(int32, fd), dataOf(p), cast(uint, len(p)))
		if n >= 0 || !Interrupted() {
			break
		}
	}
	if n < 0 {
		return 0, FailErrno("read")
	}
	var noErr @errors.Error
	return n, noErr
}

// Write writes len(p) bytes from p to fd (write(2), EINTR retried before any byte
// moves).  Returns the count written (the caller checks for a short write).
func Write(fd int, p *[]readonly uint8) (int, @errors.Error) {
	var n int
	for {
		n = __c_call("write", int, cast(int32, fd), dataOfRO(p), cast(uint, len(p)))
		if n >= 0 || !Interrupted() {
			break
		}
	}
	if n < 0 {
		return 0, FailErrno("write")
	}
	var noErr @errors.Error
	return n, noErr
}

// Close closes fd (close(2)).  On EINTR the descriptor is already released on
// Linux and macOS, so EINTR is treated as success — a retry could close an
// unrelated (reused) fd.
func Close(fd int) @errors.Error {
	var noErr @errors.Error
	var r int32 = __c_call("close", int32, cast(int32, fd))
	if cast(int, r) < 0 {
		if Interrupted() {
			return noErr
		}
		return FailErrno("close")
	}
	return noErr
}

// Pread reads at an explicit offset (pread(2), EINTR retried), leaving the stream
// position untouched.  Returns the byte count.
func Pread(fd int, p *[]uint8, off int64) (int, @errors.Error) {
	var n int
	for {
		n = cPread(cast(int32, fd), dataOf(p), cast(uint, len(p)), off)
		if n >= 0 || !Interrupted() {
			break
		}
	}
	if n < 0 {
		return 0, FailErrno("pread")
	}
	var noErr @errors.Error
	return n, noErr
}

// Pwrite writes at an explicit offset (pwrite(2), EINTR retried), leaving the
// stream position untouched.  Returns the count written.
func Pwrite(fd int, p *[]readonly uint8, off int64) (int, @errors.Error) {
	var n int
	for {
		n = cPwrite(cast(int32, fd), dataOfRO(p), cast(uint, len(p)), off)
		if n >= 0 || !Interrupted() {
			break
		}
	}
	if n < 0 {
		return 0, FailErrno("pwrite")
	}
	var noErr @errors.Error
	return n, noErr
}

// Lseek repositions fd's stream (lseek(2)) and returns the resulting absolute
// offset.  whence is the native SEEK_SET/CUR/END (0/1/2).  lseek does not block,
// so there is no EINTR retry.
func Lseek(fd int, off int64, whence int) (int64, @errors.Error) {
	var pos int64 = cLseek(cast(int32, fd), off, cast(int32, whence))
	if pos < cast(int64, 0) {
		return cast(int64, 0), FailErrno("lseek")
	}
	var noErr @errors.Error
	return pos, noErr
}

// Open opens path via open(2) (EINTR retried) and returns the descriptor.  flags
// and mode are the NATIVE open(2) values (the caller does any portable->native
// flag translation); mode is always passed as the trailing vararg, ignored by
// open without O_CREAT.
func Open(path *[]readonly char, flags int, mode int) (int, @errors.Error) {
	var buf @[]uint8 = cStr(path)
	var fd int32
	for {
		fd = __c_call("open", int32, dataOfManaged(buf), cast(int32, flags), ..., cast(int32, mode))
		if cast(int, fd) >= 0 || !Interrupted() {
			break
		}
	}
	if cast(int, fd) < 0 {
		return -1, FailErrno("open")
	}
	var noErr @errors.Error
	return cast(int, fd), noErr
}

// Mkdir creates the directory path with the given native mode bits (mkdir(2)).
func Mkdir(path *[]readonly char, mode int) @errors.Error {
	var buf @[]uint8 = cStr(path)
	if cast(int, __c_call("mkdir", int32, dataOfManaged(buf), cast(int32, mode))) != 0 {
		return FailErrno("mkdir")
	}
	var noErr @errors.Error
	return noErr
}

// Rename renames (moves) oldpath to newpath (rename(2)).  Both C strings are held
// live across the call.
func Rename(oldpath *[]readonly char, newpath *[]readonly char) @errors.Error {
	var oldc @[]uint8 = cStr(oldpath)
	var newc @[]uint8 = cStr(newpath)
	if cast(int, __c_call("rename", int32, dataOfManaged(oldc), dataOfManaged(newc))) != 0 {
		return FailErrno("rename")
	}
	var noErr @errors.Error
	return noErr
}

// Remove removes the file or empty directory path (remove(3): unlink(2) for a
// file, rmdir(2) for a directory).
func Remove(path *[]readonly char) @errors.Error {
	var buf @[]uint8 = cStr(path)
	if cast(int, __c_call("remove", int32, dataOfManaged(buf))) != 0 {
		return FailErrno("remove")
	}
	var noErr @errors.Error
	return noErr
}

// MkdirTemp creates a uniquely-named directory from `template` — which MUST end
// in six literal 'X' characters — via mkdtemp(3), and returns the created
// directory's path (an owned copy).  mkdtemp replaces the trailing "XXXXXX" with
// a suffix that makes the name unique and creates the directory atomically with
// 0700 permissions, so concurrent callers never collide.  The template buffer is
// held live across the call because mkdtemp rewrites it in place through the
// passed pointer.
func MkdirTemp(template *[]readonly char) (@[]char, @errors.Error) {
	var buf @[]uint8 = cStr(template)
	var r *uint8 = __c_call("mkdtemp", *uint8, dataOfManaged(buf))
	if r == bit_cast(*uint8, 0) {
		var empty @[]char
		return empty, FailErrno("mkdtemp")
	}
	// buf now holds "<...>XXXXXX\0" with the X's rewritten; the path is every
	// byte before the NUL cStr appended.
	var n int = len(buf) - 1
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = cast(char, buf[i])
	}
	var noErr @errors.Error
	return out, noErr
}

// The three offset-bearing calls select a 64-bit-`off_t` libc entry point per
// target: arm32-linux glibc's plain lseek/pread/pwrite take a 32-bit `off_t`
// (handing them a 64-bit value corrupts the register-pair layout), so arm32 routes
// to the LFS `*64` variants; every other hosted target (LP64 linux/darwin) uses
// the plain names.  Per-declaration #[build] variants, not a runtime branch,
// because __c_call needs a literal symbol that must LINK.

// cLseek: lseek64 on arm32-linux (64-bit off64_t).

#[build(is(arch, "arm32"))]
func cLseek(fd int32, off int64, whence int32) int64 {
	return __c_call("lseek64", int64, fd, off, whence)
}

// cLseek: plain lseek on a 64-bit-off_t target (LP64 linux/darwin).

#[build(!is(arch, "arm32"))]
func cLseek(fd int32, off int64, whence int32) int64 {
	return __c_call("lseek", int64, fd, off, whence)
}

// cPread: pread64 on arm32-linux (64-bit off64_t).

#[build(is(arch, "arm32"))]
func cPread(fd int32, buf *uint8, count uint, off int64) int {
	return __c_call("pread64", int, fd, buf, count, off)
}

// cPread: plain pread on a 64-bit-off_t target.

#[build(!is(arch, "arm32"))]
func cPread(fd int32, buf *uint8, count uint, off int64) int {
	return __c_call("pread", int, fd, buf, count, off)
}

// cPwrite: pwrite64 on arm32-linux (64-bit off64_t).

#[build(is(arch, "arm32"))]
func cPwrite(fd int32, buf *uint8, count uint, off int64) int {
	return __c_call("pwrite64", int, fd, buf, count, off)
}

// cPwrite: plain pwrite on a 64-bit-off_t target.

#[build(!is(arch, "arm32"))]
func cPwrite(fd int32, buf *uint8, count uint, off int64) int {
	return __c_call("pwrite", int, fd, buf, count, off)
}
