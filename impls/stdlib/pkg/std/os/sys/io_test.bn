// Direct tests for the fd-I/O wrappers (io.bn): Open/Read/Write/Close via the
// always-present /dev/null and /dev/zero, using the portable=native access modes
// (O_RDONLY=0, O_WRONLY=1 — identical on Linux and macOS).  The O_CREATE / Lseek /
// positional (Pread/Pwrite) / mkdir paths are exercised end-to-end by os's File
// tests + the stdlib/os conformance suite.  Uses the shared `fail` (errno_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// Open O_WRONLY + Write + Close against /dev/null (writes are discarded).
func TestOpenWriteClose() testing.TestResult {
	var fd int
	var err @errors.Error
	fd, err = Open("/dev/null", 1, 0)
	if present(err) {
		return fail("Open /dev/null O_WRONLY")
	}
	var buf @[]uint8 = make_slice(uint8, 3)
	buf[0] = cast(uint8, 'a')
	buf[1] = cast(uint8, 'b')
	buf[2] = cast(uint8, 'c')
	var n int
	n, err = Write(fd, buf[0:3])
	if present(err) {
		return fail("Write /dev/null")
	}
	if n != 3 {
		return fail("Write should report 3 bytes")
	}
	if present(Close(fd)) {
		return fail("Close /dev/null")
	}
	return ""
}

// Open O_RDONLY + Read + Close against /dev/zero (reads yield zero bytes).
func TestOpenReadClose() testing.TestResult {
	var fd int
	var err @errors.Error
	fd, err = Open("/dev/zero", 0, 0)
	if present(err) {
		return fail("Open /dev/zero O_RDONLY")
	}
	var buf @[]uint8 = make_slice(uint8, 4)
	buf[0] = cast(uint8, 0xff)
	var n int
	n, err = Read(fd, buf[0:4])
	if present(err) {
		return fail("Read /dev/zero")
	}
	if n != 4 {
		return fail("Read should report 4 bytes")
	}
	if buf[0] != cast(uint8, 0) {
		return fail("/dev/zero should read zeros")
	}
	if present(Close(fd)) {
		return fail("Close /dev/zero")
	}
	return ""
}

// Open of a missing path is a classified start error (NotFound).
func TestOpenNotFound() testing.TestResult {
	var err @errors.Error
	_, err = Open("/nonexistent/binate/sys/probe", 0, 0)
	if !present(err) {
		return fail("Open of a missing path should fail")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a missing path should classify NotFound")
	}
	return ""
}

// Mkdir + Rename + Remove roundtrip on a temp directory (present on Linux/macOS),
// plus the NotFound classification for a removed path.
func TestPathOps() testing.TestResult {
	// Clean up any leftover from a prior aborted run.
	_ = Remove("/tmp/binate_sys_pathops_a")
	_ = Remove("/tmp/binate_sys_pathops_b")
	if present(Mkdir("/tmp/binate_sys_pathops_a", 0o755)) {
		return fail("Mkdir temp dir")
	}
	if present(Rename("/tmp/binate_sys_pathops_a", "/tmp/binate_sys_pathops_b")) {
		return fail("Rename temp dir")
	}
	if present(Remove("/tmp/binate_sys_pathops_b")) {
		return fail("Remove temp dir")
	}
	var err @errors.Error = Remove("/tmp/binate_sys_pathops_b")
	if !present(err) {
		return fail("Remove of a gone dir should fail")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a gone dir should classify NotFound")
	}
	return ""
}
