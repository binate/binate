// Process syscall wrappers for the os family: fork / exec / wait / access /
// getenv, done over __c_call.  Each hosted wrapper retries EINTR and classifies
// errno internally (via FailErrno / Interrupted in errno.bn), so callers get an
// errors.Error and never see errno.  The one exception is ChildExecOrExit, which
// runs in the async-signal-safe forked child and therefore must NOT allocate —
// it cannot classify, so a failed exec is reported to the parent as _exit(127).
//
// Hosted only (a freestanding target has no process model; os/process's baremetal
// variant fails loud without importing this).  pkg/std/os/sys is os-family-
// internal.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/std/errors"

// X_OK is access(2)'s executable-permission probe bit (kept internal to sys).
const X_OK int = 1

// Fork forks the process: returns the child pid in the parent (0 in the child),
// or a start error if fork failed.
func Fork() (int, @errors.Error) {
	var noErr @errors.Error
	var pid int = cast(int, __c_call("fork", int32))
	if pid < 0 {
		return -1, FailErrno("fork")
	}
	return pid, noErr
}

// ChildExecOrExit runs ONLY in the forked child: raw execve (execv when envp is a
// null pointer, i.e. inherit) then _exit(127) if exec fails.  NORETURN and
// ALLOCATION-FREE — it is called between fork and exec, where allocation /
// refcount ops are forbidden — so it cannot classify a failed exec; the parent
// observes that as the child's _exit(127).  path is a C string, argv/envp are
// NUL-terminated char** arrays, all built (and their raw pointers hoisted) by the
// caller in the parent before fork.
func ChildExecOrExit(path *uint8, argv *uint8, envp *uint8) {
	if envp == bit_cast(*uint8, 0) {
		__c_call("execv", "void", path, argv)
	} else {
		__c_call("execve", "void", path, argv, envp)
	}
	__c_call("_exit", "void", cast(int32, 127))
	panic("os/sys: _exit returned")
}

// Waitpid waits for pid to terminate and returns the raw wait-status word — the
// caller decodes it (the WIF* macros aren't linkable symbols).  Retries EINTR so
// a signal delivered during the wait doesn't drop the child's status.
func Waitpid(pid int) (int, @errors.Error) {
	var noErr @errors.Error
	var status int32 = 0
	for {
		var rc int = cast(int, __c_call("waitpid", int32, cast(int32, pid), &status, cast(int32, 0)))
		if rc >= 0 {
			return cast(int, status), noErr
		}
		if !Interrupted() {
			return 0, FailErrno("waitpid")
		}
	}
}

// Accessible reports whether path is an executable file — access(2) with X_OK,
// as an error (empty on success, else the classified failure: NotFound for a
// missing path, PermissionDenied for a non-executable one, ...).
func Accessible(path *[]readonly char) @errors.Error {
	var noErr @errors.Error
	var buf @[]uint8 = cStr(path)
	if cast(int, __c_call("access", int32, dataOfManaged(buf), cast(int32, X_OK))) == 0 {
		return noErr
	}
	return FailErrno("access")
}

// Getenv returns the value of the environment variable name and whether it was
// set (a false second result means unset, and the value is then empty).  getenv
// does not touch errno, so there is no error result.
func Getenv(name *[]readonly char) (@[]char, bool) {
	var nameBuf @[]uint8 = cStr(name)
	var p *uint8 = __c_call("getenv", *uint8, dataOfManaged(nameBuf))
	if p == bit_cast(*uint8, 0) {
		var empty @[]char
		return empty, false
	}
	return cStrToChars(p), true
}

// Exit terminates the process with status code (exit(3)).  exit(3) is noreturn,
// so control never returns.
func Exit(code int) {
	__c_call("exit", "void", cast(int32, code))
}

// --- marshalling helpers (private) ---

// dataOfManaged returns the data pointer of a managed byte slice (its first word).
func dataOfManaged(p @[]uint8) *uint8 {
	return bit_cast(*uint8, bit_cast(*int, &p)[0])
}

// cStr copies a char borrow into a fresh NUL-terminated byte buffer.
func cStr(s *[]readonly char) @[]uint8 {
	var n int = len(s)
	var buf @[]uint8 = make_slice(uint8, n + 1)
	for i := 0; i < n; i++ {
		buf[i] = cast(uint8, s[i])
	}
	buf[n] = cast(uint8, 0)
	return buf
}

// cStrToChars copies a NUL-terminated C string at p into an owned @[]char.
func cStrToChars(p *uint8) @[]char {
	var n int = 0
	for p[n] != cast(uint8, 0) {
		n = n + 1
	}
	var out @[]char = make_slice(char, n)
	for i := 0; i < n; i++ {
		out[i] = cast(char, p[i])
	}
	return out
}
