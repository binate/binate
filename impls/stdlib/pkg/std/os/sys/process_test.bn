// Tests for the process syscall wrappers (process.bn): Accessible and a
// Fork/Waitpid roundtrip.  Uses the shared `fail` (errno_test.bn).  Hosted only.
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// Accessible: an executable file succeeds; a missing one is NotFound.
func TestAccessible() testing.TestResult {
	if present(Accessible("/usr/bin/true")) {
		return fail("/usr/bin/true should be accessible")
	}
	var err @errors.Error = Accessible("/nonexistent/binate/prog")
	if !present(err) {
		return fail("a missing path should not be accessible")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a missing path should classify NotFound")
	}
	return ""
}

// Fork + Waitpid roundtrip: fork a child that _exit(7)s, then reap it and check
// the raw status word decodes to a normal exit with code 7.
func TestForkWaitRoundtrip() testing.TestResult {
	var pid int
	var err @errors.Error
	pid, err = Fork()
	if present(err) {
		return fail("Fork failed")
	}
	if pid == 0 {
		__c_call("_exit", "void", cast(int32, 7))
		panic("os/sys: _exit returned")
	}
	var status int
	status, err = Waitpid(pid)
	if present(err) {
		return fail("Waitpid failed")
	}
	if (status & 0x7f) != 0 {
		return fail("child should have exited, not been signaled")
	}
	if ((status >> 8) & 0xff) != 7 {
		return fail("child exit code should be 7")
	}
	return ""
}
