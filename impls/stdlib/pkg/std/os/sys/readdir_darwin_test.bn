// Gated to non-x64 Darwin, matching readdir_darwin.bn.  x86_64-Darwin uses
// readdir$INODE64 and is covered by readdir_darwin_x64_test.bn.  The shared
// `fail` helper lives in errno_test.bn.
#[build(is(os, "darwin") && !is(arch, "x64"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"

// TestReadDirEntDarwin confirms the per-platform readDirEnt (readdir) links and
// returns a live first entry for "/", a directory that always has entries.  It
// pins the SYMBOL choice; the d_name/d_type OFFSETS are verified by
// conformance/stdlib/os/006_readdir (marker-file decode), not here.
func TestReadDirEntDarwin() testing.TestResult {
	var cp @[]uint8 = cStr("/")
	var dir *uint8 = openDir(dataOfManaged(cp))
	if dir == bit_cast(*uint8, 0) {
		return fail("openDir(/) returned nil")
	}
	var ent *uint8 = readDirEnt(dir)
	closeDir(dir)
	if ent == bit_cast(*uint8, 0) {
		return fail("readDirEnt(/) returned nil for a non-empty directory")
	}
	return ""
}
