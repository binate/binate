// Darwin struct dirent layout + readdir(3) for ReadDir on x86_64-Darwin.
// Mirrors readdir_darwin.bn (identical struct dirent layout) but calls
// readdir$INODE64: on x86_64 macOS, <dirent.h> aliases readdir via
// __DARWIN_INODE64 to readdir$INODE64, which fills the modern 64-bit-inode
// struct dirent that osDirent replicates.  The bare readdir symbol is the LEGACY
// 32-bit-inode function with a DIFFERENT layout, so linking it makes
// direntType/direntName decode garbage (corrupted d_type and names).  opendir /
// closedir are NOT split — the DIR* from bare opendir works with readdir$INODE64
// (verified), and closedir is not $INODE64-aliased.  __c_call carries the symbol
// verbatim (only a Mach-O leading '_' is added), so '$' passes through to
// _readdir$INODE64.
#[build(is(os, "darwin") && is(arch, "x64"))]
package "pkg/std/os/sys"

// osDirent mirrors the Darwin struct dirent header up to d_type.  The char
// d_name[1024] flexible array follows at D_NAME_OFF and is read by offset.
type osDirent struct {
	d_ino     uint64
	d_seekoff uint64
	d_reclen  uint16
	d_namlen  uint16
	d_type    uint8
}

// D_NAME_OFF is the byte offset of d_name within the Darwin struct dirent.
const D_NAME_OFF int = 21

// readDirEnt wraps readdir$INODE64(3) — the 64-bit-inode variant that matches
// osDirent on x86_64-Darwin.  Returns the next struct dirent, nil at EOS.
func readDirEnt(dir *uint8) *uint8 {
	return __c_call("readdir$INODE64", *uint8, dir)
}
