// Linux struct dirent layout + readdir(3) for ReadDir.  ONE layout for every
// Linux arch (x86_64, aarch64, arm32): modern glibc returns the 64-bit-d_ino
// struct dirent on all of them — verified against the cross-libc (offsetof
// d_name == 19 on arm-linux-gnueabihf too, not the 11 a 32-bit d_ino/d_off
// would give).  The shared direntType / direntName (readdir.bn) read d_type by
// field and d_name at D_NAME_OFF.
#[build(is(os, "linux"))]
package "pkg/std/os/sys"

// osDirent mirrors the glibc struct dirent header up to d_type on Linux.  The
// char d_name[256] flexible array follows at D_NAME_OFF.
type osDirent struct {
	d_ino    uint64
	d_off    int64
	d_reclen uint16
	d_type   uint8
}

// D_NAME_OFF is the byte offset of d_name within the Linux struct dirent.
const D_NAME_OFF int = 19

// readDirEnt wraps readdir64(3) — NOT plain readdir: on a 32-bit arch the 32-bit
// readdir returns EOVERFLOW (nil) for a directory entry whose d_ino exceeds
// 2^32, which ReadDir would mis-read as end-of-stream and silently truncate the
// listing; readdir64 carries the full 64-bit d_ino.  On 64-bit arches readdir64
// is equivalent to readdir.  Returns the next struct dirent, nil at EOS.
func readDirEnt(dir *uint8) *uint8 {
	return __c_call("readdir64", *uint8, dir)
}
