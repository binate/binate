// Direct tests for the directory-stream wrapper (readdir.bn): sys.ReadDir lists a
// temp directory, returns the entry by name, and excludes "." / "..".  The
// per-platform readDirEnt symbol linkage is pinned by readdir_<platform>_test.bn;
// the d_name/d_type OFFSETS by conformance/stdlib/os/006_readdir.  Uses makeProbe
// (stat_test.bn) / the shared `fail` (errno_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// nameEq reports whether an owned entry name equals a C-literal borrow.
func nameEq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// sys.ReadDir lists exactly the real entries of a directory (one marker file),
// excluding "." and "..".
func TestReadDir() testing.TestResult {
	var dir @[]char = sysTestDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer Remove(dir)
	var marker @[]char = sysJoin(dir, "marker")
	defer Remove(marker)
	if present(makeProbe(marker)) {
		return fail("create marker")
	}

	var ents @[]@DirEnt
	var err @errors.Error
	ents, err = ReadDir(dir)

	if present(err) {
		return fail("ReadDir")
	}
	if len(ents) != 1 {
		return fail("ReadDir should list exactly the one marker (no ./..)")
	}
	if !nameEq(ents[0].Name, "marker") {
		return fail("the entry should be named \"marker\"")
	}
	return ""
}

// sys.ReadDir of a missing path is a classified failure (NotFound).
func TestReadDirNotFound() testing.TestResult {
	var err @errors.Error
	_, err = ReadDir("/nonexistent/binate/sys/dirprobe")
	if !present(err) {
		return fail("ReadDir of a missing path should fail")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a missing path should classify NotFound")
	}
	return ""
}
