// stat/lstat/fstat syscall entry points for the os family: EINTR-retrying,
// errno-classifying wrappers returning a portable StatInfo, so a caller
// (pkg/std/os) never touches errno or a native struct stat.  The per-(os,arch)
// pieces are the raw C call (statPath/lstatPath/statFd in stat_io*.bn, each
// naming its platform's stat symbol) and the native struct stat layout (osStat
// in stat_<platform>.bn); this file owns the platform-neutral rest: the fill
// from osStat into StatInfo and the retry loops.  Hosted only; os-family-
// internal (see explorations/design-syscall.md).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/std/errors"

// fill copies the fields the os family reports (size, mode, mtime) out of a
// filled osStat.  The casts absorb per-platform field widths: st_mode is 16-bit
// on Darwin and 32-bit on Linux; the mtime fields are 64-bit except on the
// 32-bit-time arm32 ABI.  The active platform's osStat layout lives in
// stat_<platform>.bn.
func fill(st *osStat, out *StatInfo) {
	out.Size = st.st_size
	out.Mode = cast(uint32, st.st_mode)
	out.MtimeSec = cast(int64, st.st_mtime_sec)
	out.MtimeNsec = cast(int32, st.st_mtime_nsec)
}

// Stat fills a StatInfo for path via stat(2) (following symlinks), retrying
// EINTR.  The C string is held live across the call.
func Stat(path *[]readonly char) (StatInfo, @errors.Error) {
	var buf @[]uint8 = cStr(path)
	var out StatInfo
	var rc int
	for {
		rc = statPath(dataOfManaged(buf), &out)
		if rc >= 0 || !Interrupted() {
			break
		}
	}
	if rc < 0 {
		var none StatInfo
		return none, FailErrno("stat")
	}
	var noErr @errors.Error
	return out, noErr
}

// Lstat is Stat via lstat(2) (does not follow a final symlink).
func Lstat(path *[]readonly char) (StatInfo, @errors.Error) {
	var buf @[]uint8 = cStr(path)
	var out StatInfo
	var rc int
	for {
		rc = lstatPath(dataOfManaged(buf), &out)
		if rc >= 0 || !Interrupted() {
			break
		}
	}
	if rc < 0 {
		var none StatInfo
		return none, FailErrno("lstat")
	}
	var noErr @errors.Error
	return out, noErr
}

// Fstat fills a StatInfo for the open descriptor fd via fstat(2), retrying EINTR.
func Fstat(fd int) (StatInfo, @errors.Error) {
	var out StatInfo
	var rc int
	for {
		rc = statFd(fd, &out)
		if rc >= 0 || !Interrupted() {
			break
		}
	}
	if rc < 0 {
		var none StatInfo
		return none, FailErrno("fstat")
	}
	var noErr @errors.Error
	return out, noErr
}
