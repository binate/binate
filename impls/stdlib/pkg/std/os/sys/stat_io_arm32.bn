// LFS stat64/fstat64/lstat64 syscall wrappers for 32-bit ARM Linux, where the
// plain struct stat caps st_size at 2 GiB.  Mirrors stat_io.bn but with the
// *64 symbols and the arm32 osStat (struct stat64) layout.
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os/sys"

// The C *64 stat calls return `int` (a 32-bit C int): annotate the c-call
// return `int32` and sign-extend to the `int` result.  Reading a 32-bit C
// return as the 64-bit binate `int` misses the -1 failure (the upper return-
// register bits are unspecified) — see the note in stat_io.bn.

// statFd fills out via fstat64(2) on fd; returns 0, or -1 with errno set.
func statFd(fd int, out *StatInfo) int {
	var st osStat
	var rc int32 = __c_call("fstat64", int32, cast(int32, fd), &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}

// statPath fills out via stat64(2) on a NUL-terminated path.
func statPath(path *uint8, out *StatInfo) int {
	var st osStat
	var rc int32 = __c_call("stat64", int32, path, &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}

// lstatPath fills out via lstat64(2) (does not follow a final symlink).
func lstatPath(path *uint8, out *StatInfo) int {
	var st osStat
	var rc int32 = __c_call("lstat64", int32, path, &st)
	if rc == 0 { fill(&st, out) }
	return cast(int, rc)
}
