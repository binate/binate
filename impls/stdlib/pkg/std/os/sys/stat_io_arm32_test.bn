// Gated to 32-bit ARM Linux: confirms statPath (stat64) reads the right size out
// of the arm32 osStat (struct stat64) layout.  Uses makeProbe / the shared `fail`
// (stat_test.bn / errno_test.bn).
#[build(is(os, "linux") && is(arch, "arm32"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestStatIoArm32Size probes statPath (stat64) against a known 5-byte file.
func TestStatIoArm32Size() testing.TestResult {
	var perr @errors.Error = makeProbe("/tmp/binate_sys_stat_io_arm32_probe")
	if present(perr) {
		return fail("create probe")
	}
	var sb StatInfo
	var cp @[]uint8 = cStr("/tmp/binate_sys_stat_io_arm32_probe")
	if statPath(dataOfManaged(cp), &sb) != 0 {
		return fail("statPath")
	}
	if sb.Size != cast(int64, 5) {
		return fail("statPath should read size 5")
	}
	return ""
}
