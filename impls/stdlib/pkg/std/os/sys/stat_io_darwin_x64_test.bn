// Gated to x86_64-Darwin, matching stat_io_darwin_x64.bn: confirms statPath
// (stat$INODE64) reads the right size out of the 64-bit-inode osStat layout.  A
// bare-symbol regression (legacy 32-bit-inode layout) reads size 0 here and
// panics time.FromUnix in the modtime path — see conformance/stdlib/os/009_stat.
// Uses makeProbe / the shared `fail` (stat_test.bn / errno_test.bn).
#[build(is(os, "darwin") && is(arch, "x64"))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestStatIoDarwinX64Size probes statPath (stat$INODE64) against a known 5-byte
// file.
func TestStatIoDarwinX64Size() testing.TestResult {
	var perr @errors.Error = makeProbe("/tmp/binate_sys_stat_io_darwin_x64_probe")
	if present(perr) {
		return fail("create probe")
	}
	var sb StatInfo
	var cp @[]uint8 = cStr("/tmp/binate_sys_stat_io_darwin_x64_probe")
	if statPath(dataOfManaged(cp), &sb) != 0 {
		return fail("statPath")
	}
	if sb.Size != cast(int64, 5) {
		return fail("statPath should read size 5")
	}
	return ""
}
