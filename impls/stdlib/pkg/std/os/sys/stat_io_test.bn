// Gated to match stat_io.bn (64-bit Linux + arm64-Darwin): confirms statPath
// reads the right size out of the active platform's osStat layout (a wrong field
// offset would give a wrong size).  arm32 (stat64) and x86_64-Darwin ($INODE64)
// have their own gated probes.  Uses makeProbe / the shared `fail` (stat_test.bn
// / errno_test.bn).
#[build(!is(os, "baremetal") && !is(arch, "arm32") && !(is(os, "darwin") && is(arch, "x64")))]
package "pkg/std/os/sys"

import "pkg/builtins/testing"
import "pkg/std/errors"

// TestStatIoSize probes statPath against a known 5-byte file.
func TestStatIoSize() testing.TestResult {
	var perr @errors.Error = makeProbe("/tmp/binate_sys_stat_io_probe")
	if present(perr) {
		return fail("create probe")
	}
	var sb StatInfo
	var cp @[]uint8 = cStr("/tmp/binate_sys_stat_io_probe")
	if statPath(dataOfManaged(cp), &sb) != 0 {
		return fail("statPath")
	}
	if sb.Size != cast(int64, 5) {
		return fail("statPath should read size 5")
	}
	return ""
}
