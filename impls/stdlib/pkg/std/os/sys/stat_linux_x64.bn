// Linux/x86_64 struct stat layout for the sys stat wrappers (data only): glibc 144-byte
// layout, st_size at offset 48 / st_mtim at 88.  LP64 (plain stat = 64-bit
// off_t).  Shared fill + wrappers in stat.bn / stat_io.bn.
#[build(is(os, "linux") && is(arch, "x64"))]
package "pkg/std/os/sys"

// osStat replicates glibc's x86_64 struct stat (sizeof 144).
type osStat struct {
	st_dev        uint64
	st_ino        uint64
	st_nlink      uint64
	st_mode       uint32
	st_uid        uint32
	st_gid        uint32
	__pad0        int32
	st_rdev       uint64
	st_size       int64
	st_blksize    int64
	st_blocks     int64
	st_atime_sec  int64
	st_atime_nsec int64
	st_mtime_sec  int64
	st_mtime_nsec int64
	st_ctime_sec  int64
	st_ctime_nsec int64
	__reserved0   int64
	__reserved1   int64
	__reserved2   int64
}
