// Direct tests for the stat wrappers (stat.bn): Stat/Lstat/Fstat via the
// always-present /dev/null (a character device on Linux and macOS), plus the
// NotFound classification for a missing path.  The size-read layout (the
// per-(os,arch) osStat) is exercised end-to-end by os's TestStatSize + the
// stdlib/os conformance suite.  Uses the shared `fail` (errno_test.bn).
#[build(!is(os, "baremetal"))]
package "pkg/std/os/sys"

import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"

// isCharDev reports whether a raw st_mode is a character device: its file-type
// field (S_IFMT = 0o170000) is S_IFCHR (0o020000).  /dev/null is one on both
// Linux and macOS.
func isCharDev(mode uint32) bool {
	return (mode & 0o170000) == 0o020000
}

// makeProbe creates path holding 5 bytes ("12345"), for the per-(os,arch)
// size-layout probes in stat_io*_test.bn.  Uses native O_WRONLY|O_CREAT|O_TRUNC
// (the create flags differ between Linux and macOS, selected at compile time).
func makeProbe(path *[]readonly char) @errors.Error {
	var flags int = 0x241 // Linux O_WRONLY|O_CREAT|O_TRUNC (0x1|0x40|0x200)
	if build.OS == build.OS_DARWIN {
		flags = 0x601 // Darwin O_WRONLY|O_CREAT|O_TRUNC (0x1|0x200|0x400)
	}
	var fd int
	var err @errors.Error
	fd, err = Open(path, flags, 0o600)
	if present(err) {
		return err
	}
	var buf @[]uint8 = make_slice(uint8, 5)
	for i := 0; i < 5; i++ {
		buf[i] = cast(uint8, 49 + i) // '1'..'5'
	}
	_, err = Write(fd, buf[0:5])
	if present(err) {
		_ = Close(fd)
		return err
	}
	return Close(fd)
}

// Stat of /dev/null reads a char-device st_mode (following the path).
func TestStatCharDev() testing.TestResult {
	var si StatInfo
	var err @errors.Error
	si, err = Stat("/dev/null")
	if present(err) {
		return fail("Stat /dev/null")
	}
	if !isCharDev(si.Mode) {
		return fail("/dev/null should be a character device")
	}
	return ""
}

// Lstat of /dev/null (not a symlink) reads the same char-device st_mode.
func TestLstatCharDev() testing.TestResult {
	var si StatInfo
	var err @errors.Error
	si, err = Lstat("/dev/null")
	if present(err) {
		return fail("Lstat /dev/null")
	}
	if !isCharDev(si.Mode) {
		return fail("/dev/null should be a character device")
	}
	return ""
}

// Fstat of an open /dev/null descriptor reads the char-device st_mode.
func TestFstatCharDev() testing.TestResult {
	var fd int
	var err @errors.Error
	fd, err = Open("/dev/null", 0, 0) // O_RDONLY (0 on every POSIX OS)
	if present(err) {
		return fail("Open /dev/null")
	}
	var si StatInfo
	si, err = Fstat(fd)
	if present(Close(fd)) {
		return fail("Close /dev/null")
	}
	if present(err) {
		return fail("Fstat /dev/null")
	}
	if !isCharDev(si.Mode) {
		return fail("/dev/null should be a character device")
	}
	return ""
}

// Stat of a missing path is a classified failure (NotFound).
func TestStatNotFound() testing.TestResult {
	var err @errors.Error
	_, err = Stat("/nonexistent/binate/sys/statprobe")
	if !present(err) {
		return fail("Stat of a missing path should fail")
	}
	if !errors.Is(err, errors.NotFound) {
		return fail("a missing path should classify NotFound")
	}
	return ""
}
