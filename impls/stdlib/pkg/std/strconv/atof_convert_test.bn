package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/math/big"

// White-box tests for the ParseFloat converter (atof_convert.bn): the exact
// big.Nat rational helpers (pow10, shiftedNum/Den, floorBits, the
// round-half-to-even roundedSig) and the convert/convertHex bit-pattern
// builders.  These pin the rounding core directly — the public ParseFloat path
// exercises it, but can't isolate, say, the round-to-even tie behaviour.

func TestPow10() testing.TestResult {
	if pow10(0).ToUint64() != cast(uint64, 1) { return "pow10(0)" }
	if pow10(1).ToUint64() != cast(uint64, 10) { return "pow10(1)" }
	if pow10(3).ToUint64() != cast(uint64, 1000) { return "pow10(3)" }
	if pow10(10).ToUint64() != cast(uint64, 10000000000) { return "pow10(10)" }
	return ""
}

func TestShiftedNumDen() testing.TestResult {
	var n @big.Nat = big.FromUint64(cast(uint64, 3))
	var d @big.Nat = big.FromUint64(cast(uint64, 5))
	// k >= 0: numerator shifts left, denominator unchanged.
	if shiftedNum(n, 2).ToUint64() != cast(uint64, 12) { return "shiftedNum k=2" }
	if shiftedDen(d, 2).ToUint64() != cast(uint64, 5) { return "shiftedDen k=2" }
	// k < 0: numerator unchanged, denominator shifts left by -k.
	if shiftedNum(n, 0 - 2).ToUint64() != cast(uint64, 3) { return "shiftedNum k=-2" }
	if shiftedDen(d, 0 - 2).ToUint64() != cast(uint64, 20) { return "shiftedDen k=-2" }
	return ""
}

func TestFloorBits() testing.TestResult {
	// floor(N*2^k/D) bit length.  N=1, D=1: floor(2^k) -> k+1 bits.
	var one @big.Nat = big.FromUint64(cast(uint64, 1))
	if floorBits(one, one, 0) != 1 { return "floorBits(1/1, k=0) == 1 (value 1)" }
	if floorBits(one, one, 3) != 4 { return "floorBits(1/1, k=3) == 4 (value 8)" }
	// N=3, D=2, k=0: floor(1.5) = 1 -> 1 bit.
	var three @big.Nat = big.FromUint64(cast(uint64, 3))
	var two @big.Nat = big.FromUint64(cast(uint64, 2))
	if floorBits(three, two, 0) != 1 { return "floorBits(3/2, k=0) == 1" }
	return ""
}

func TestRoundedSigHalfToEven() testing.TestResult {
	var two @big.Nat = big.FromUint64(cast(uint64, 2))
	// 5/2 = 2.5: exact tie -> round to even -> 2.
	var five @big.Nat = big.FromUint64(cast(uint64, 5))
	if roundedSig(five, two, 0).ToUint64() != cast(uint64, 2) { return "5/2 -> 2 (tie to even)" }
	// 7/2 = 3.5: exact tie -> round to even -> 4.
	var seven @big.Nat = big.FromUint64(cast(uint64, 7))
	if roundedSig(seven, two, 0).ToUint64() != cast(uint64, 4) { return "7/2 -> 4 (tie to even)" }
	// 7/4 = 1.75: not a tie -> rounds up -> 2.
	var four @big.Nat = big.FromUint64(cast(uint64, 4))
	if roundedSig(seven, four, 0).ToUint64() != cast(uint64, 2) { return "7/4 -> 2 (round up)" }
	// 5/4 = 1.25: not a tie -> rounds down -> 1.
	if roundedSig(five, four, 0).ToUint64() != cast(uint64, 1) { return "5/4 -> 1 (round down)" }
	return ""
}

// convOf converts mant*10^decExp to float64 bits via the internal convert().
func convOf(mant uint64, decExp int, nsig int) uint64 {
	var m @big.Nat = big.FromUint64(mant)
	var bits uint64
	bits, _ = convert(m, decExp, nsig, f64fmt())
	return bits
}

func TestConvertDecimalBits() testing.TestResult {
	// 1.0 -> 0x3FF0000000000000 (sign-free; convert returns the magnitude bits).
	if convOf(cast(uint64, 1), 0, 1) != 0x3FF0000000000000 { return "convert(1) bits" }
	// 2.0 -> 0x4000000000000000.
	if convOf(cast(uint64, 2), 0, 1) != 0x4000000000000000 { return "convert(2) bits" }
	// 0.5 (5 * 10^-1) -> 0x3FE0000000000000.
	if convOf(cast(uint64, 5), 0 - 1, 1) != 0x3FE0000000000000 { return "convert(0.5) bits" }
	// Zero significand -> 0, no overflow.
	if convOf(cast(uint64, 0), 0, 0) != cast(uint64, 0) { return "convert(0) bits" }
	return ""
}

func TestConvertOverflowUnderflow() testing.TestResult {
	var m @big.Nat = big.FromUint64(cast(uint64, 1))
	var bits uint64
	var over bool
	// decExp >= 310 short-circuits to +Inf magnitude bits, overflow=true.
	bits, over = convert(m, 310, 1, f64fmt())
	if !over { return "1e310 should overflow" }
	if bits != (cast(uint64, 2047) << cast(uint64, 52)) { return "overflow -> Inf bits" }
	// Far underflow short-circuits to 0, overflow=false.
	bits, over = convert(m, 0 - 400, 1, f64fmt())
	if over { return "1e-400 should not overflow" }
	if bits != cast(uint64, 0) { return "underflow -> 0 bits" }
	return ""
}

func TestConvertHexBits() testing.TestResult {
	var m @big.Nat = big.FromUint64(cast(uint64, 1))
	var bits uint64
	var over bool
	// 0x1p0 = 1.0 -> 0x3FF0000000000000.
	bits, over = convertHex(m, 0, f64fmt())
	if over || bits != 0x3FF0000000000000 { return "convertHex(1*2^0)" }
	// 1 * 2^1 = 2.0 -> 0x4000000000000000.
	bits, over = convertHex(m, 1, f64fmt())
	if over || bits != 0x4000000000000000 { return "convertHex(1*2^1)" }
	// 1 * 2^-1 = 0.5 -> 0x3FE0000000000000.
	bits, over = convertHex(m, 0 - 1, f64fmt())
	if over || bits != 0x3FE0000000000000 { return "convertHex(1*2^-1)" }
	return ""
}
