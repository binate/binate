package "pkg/std/strconv"

import "pkg/std/math/big"

// The ParseFloat lexer: scans a decimal or hex float (or a special form)
// into a lexInfo + the significand digits.  The rounding/conversion of the
// lexed value lives in atof_convert.bn; the entry point in atof.bn.

// lowerByte lowercases an ASCII letter (leaving other bytes unchanged).
func lowerByte(c uint8) uint8 {
	if c >= 'A' && c <= 'Z' {
		return cast(uint8, cast(int, c) + 32)
	}
	return c
}

// isDigitByte reports whether c is an ASCII decimal digit.
func isDigitByte(c uint8) bool {
	return c >= '0' && c <= '9'
}

// digitFlanked reports whether s[i] sits strictly between two digits — the
// validity rule for a '_' digit separator (Go accepts '_' only there).
func digitFlanked(s *[]readonly uint8, i int) bool {
	return i > 0 && isDigitByte(s[i - 1]) &&
		i + 1 < len(s) && isDigitByte(s[i + 1])
}

// ciEqual compares a byte view to a literal case-insensitively (ASCII).
func ciEqual(s *[]readonly uint8, lit *[]readonly char) bool {
	if len(s) != len(lit) {
		return false
	}
	for i := 0; i < len(s); i++ {
		if lowerByte(s[i]) != lowerByte(lit[i]) {
			return false
		}
	}
	return true
}

// isHexDigit reports whether c is an ASCII hex digit.
func isHexDigit(c uint8) bool {
	if c >= '0' && c <= '9' {
		return true
	}
	if c >= 'a' && c <= 'f' {
		return true
	}
	return c >= 'A' && c <= 'F'
}

// hexUnderscoreOK validates '_' placement in a hex float (`[sign] 0x ...`):
// each '_' must sit between two hex digits or immediately after the 0x
// prefix.  '.', 'p'/'P' (and any non-hex byte) are separators, so a '_'
// adjacent to them is rejected — distinct from the integer underscoreOK,
// which treats letters as base-36 digits.
func hexUnderscoreOK(s *[]readonly uint8) bool {
	var saw int = 0
	var i int = 0
	if len(s) >= 1 && (s[0] == '+' || s[0] == '-') {
		i = 1
	}
	if i + 1 < len(s) && s[i] == '0' &&
		(s[i + 1] == 'x' || s[i + 1] == 'X') {
		i = i + 2
		saw = 1
	}
	for i < len(s) {
		var c uint8 = s[i]
		if isHexDigit(c) {
			saw = 1
		} else if c == '_' {
			if saw != 1 {
				return false
			}
			saw = 2
		} else {
			if saw == 2 {
				return false
			}
			saw = 0
		}
		i = i + 1
	}
	return saw != 2
}

// lexInfo is lexFloat's scalar result; the significand digits are written
// into the caller-provided mant.  kind: 0 number, 1 +Inf, 2 -Inf, 3 NaN,
// 4 syntax error.  In decimal mode decExp is the power of ten to apply
// (exponent minus the fraction-digit count) and nsig the significant-digit
// count (for the magnitude guard); in hex mode (isHex) decExp instead holds
// the binary exponent e2 (the 'p' exponent minus 4x the hex fraction
// digits) and nsig is unused.
type lexInfo struct {
	decExp int
	nsig   int
	kind   int
	neg    bool
	isHex  bool
}

// lexFloat scans s as `[sign] digits [. digits] [ (e|E) [sign] digits ]`,
// or the case-insensitive specials inf/infinity/nan (nan takes no sign).
// It accumulates the significand into mant and returns the scalar lexInfo.
func lexFloat(s *[]readonly uint8, mant @big.Nat) lexInfo {
	var r lexInfo
	r.kind = 4
	mant.SetUint64(cast(uint64, 0))
	if len(s) == 0 {
		return r
	}
	if ciEqual(s, "nan") {
		r.kind = 3
		return r
	}
	var i int = 0
	if s[0] == '+' {
		i = 1
	} else if s[0] == '-' {
		r.neg = true
		i = 1
	}
	var rest *[]readonly uint8 = s[i:len(s)]
	if ciEqual(rest, "inf") || ciEqual(rest, "infinity") {
		if r.neg {
			r.kind = 2
		} else {
			r.kind = 1
		}
		return r
	}
	// Hex float: a 0x / 0X prefix (after the optional sign).
	if len(rest) >= 2 && rest[0] == '0' &&
		(rest[1] == 'x' || rest[1] == 'X') {
		return lexHexBody(s, i, mant, r.neg)
	}
	var sawDigit bool = false
	var sawDot bool = false
	var fracDigits int = 0
	var nsig int = 0
	for i < len(s) {
		var c uint8 = s[i]
		if c >= '0' && c <= '9' {
			mant.MulUint32(mant, cast(uint32, 10))
			mant.AddUint32(mant, cast(uint32, cast(int, c) - cast(int, '0')))
			nsig = nsig + 1
			if sawDot {
				fracDigits = fracDigits + 1
			}
			sawDigit = true
			i = i + 1
		} else if c == '.' && !sawDot {
			sawDot = true
			i = i + 1
		} else if c == '_' {
			// A digit separator is valid only between two digits.
			if digitFlanked(s, i) {
				i = i + 1
			} else {
				return r
			}
		} else {
			break
		}
	}
	if !sawDigit {
		return r
	}
	var expVal int = 0
	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
		i = i + 1
		var eNeg bool = false
		if i < len(s) && (s[i] == '+' || s[i] == '-') {
			eNeg = (s[i] == '-')
			i = i + 1
		}
		if i >= len(s) || s[i] < '0' || s[i] > '9' {
			return r
		}
		for i < len(s) {
			var ec uint8 = s[i]
			if ec >= '0' && ec <= '9' {
				if expVal < 1000000000 {
					expVal = expVal * 10 + (cast(int, ec) - cast(int, '0'))
				}
				i = i + 1
			} else if ec == '_' && digitFlanked(s, i) {
				i = i + 1
			} else {
				break
			}
		}
		if eNeg {
			expVal = 0 - expVal
		}
	}
	if i != len(s) {
		return r
	}
	r.decExp = expVal - fracDigits
	r.nsig = nsig
	r.kind = 0
	return r
}

// lexHexBody scans a hex float `0x hexdigits [. hexdigits] (p|P) [sign]
// decimaldigits` from index `start` (the '0' of the prefix), with neg the
// already-consumed sign.  It accumulates the hex significand into mant and
// returns lexInfo with isHex set and decExp = the binary exponent e2 (the
// 'p' exponent minus 4x the hex fraction-digit count).  The 'p' exponent is
// mandatory (Go), and at least one hex digit is required.
func lexHexBody(s *[]readonly uint8, start int, mant @big.Nat, neg bool) lexInfo {
	var r lexInfo
	r.kind = 4
	r.neg = neg
	r.isHex = true
	var i int = start + 2
	var sawDigit bool = false
	var sawDot bool = false
	var fracHex int = 0
	var sawUnderscore bool = false
	for i < len(s) {
		var c uint8 = s[i]
		if isHexDigit(c) {
			mant.MulUint32(mant, cast(uint32, 16))
			mant.AddUint32(mant, cast(uint32, digitVal(c)))
			if sawDot {
				fracHex = fracHex + 1
			}
			sawDigit = true
			i = i + 1
		} else if c == '.' && !sawDot {
			sawDot = true
			i = i + 1
		} else if c == '_' {
			sawUnderscore = true
			i = i + 1
		} else {
			break
		}
	}
	if !sawDigit {
		return r
	}
	if i >= len(s) || (s[i] != 'p' && s[i] != 'P') {
		return r
	}
	i = i + 1
	var pNeg bool = false
	if i < len(s) && (s[i] == '+' || s[i] == '-') {
		pNeg = (s[i] == '-')
		i = i + 1
	}
	if i >= len(s) || s[i] < '0' || s[i] > '9' {
		return r
	}
	var pexp int = 0
	for i < len(s) {
		var c uint8 = s[i]
		if c >= '0' && c <= '9' {
			if pexp < 1000000000 {
				pexp = pexp * 10 + (cast(int, c) - cast(int, '0'))
			}
			i = i + 1
		} else if c == '_' {
			sawUnderscore = true
			i = i + 1
		} else {
			break
		}
	}
	if pNeg {
		pexp = 0 - pexp
	}
	if i != len(s) {
		return r
	}
	if sawUnderscore && !hexUnderscoreOK(s) {
		return r
	}
	r.decExp = pexp - 4 * fracHex
	r.kind = 0
	return r
}
