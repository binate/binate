package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/math/big"

// White-box tests for the ParseFloat lexer (atof_lex.bn): the byte-class
// helpers, the '_'-placement validators, and lexFloat/lexHexBody's scalar
// lexInfo result.  These pin the lexer's internal contract directly — the
// public ParseFloat path (atof_test.bn) can't isolate the lexInfo fields or
// the exact reject points.

// bytesOf returns a raw byte view of an ASCII string literal (the lexer takes
// `*[]readonly uint8`).
func bytesOf(s *[]readonly char) *[]readonly uint8 {
	return bit_cast(*[]readonly uint8, s)
}

func TestLexByteClassHelpers() testing.TestResult {
	if lowerByte('A') != 'a' { return "lowerByte(A)" }
	if lowerByte('z') != 'z' { return "lowerByte(z) unchanged" }
	if lowerByte('5') != '5' { return "lowerByte(5) unchanged" }
	if !isDigitByte('0') || !isDigitByte('9') { return "isDigitByte digits" }
	if isDigitByte('a') || isDigitByte('/') { return "isDigitByte non-digit" }
	if !isHexDigit('0') || !isHexDigit('9') || !isHexDigit('a') || !isHexDigit('F') {
		return "isHexDigit hex"
	}
	if isHexDigit('g') || isHexDigit('G') { return "isHexDigit non-hex" }
	return ""
}

func TestCiEqual() testing.TestResult {
	if !ciEqual(bytesOf("inf"), "inf") { return "inf == inf" }
	if !ciEqual(bytesOf("InF"), "inf") { return "InF == inf (case-insensitive)" }
	if !ciEqual(bytesOf("NAN"), "nan") { return "NAN == nan" }
	if ciEqual(bytesOf("infi"), "inf") { return "length mismatch" }
	if ciEqual(bytesOf("xyz"), "inf") { return "different content" }
	return ""
}

func TestDigitFlanked() testing.TestResult {
	// "1_2": the '_' at index 1 is flanked by digits.
	if !digitFlanked(bytesOf("1_2"), 1) { return "1_2 flanked" }
	// "_2": leading '_' is not flanked.
	if digitFlanked(bytesOf("_2"), 0) { return "_2 not flanked" }
	// "1_": trailing '_' is not flanked.
	if digitFlanked(bytesOf("1_"), 1) { return "1_ not flanked" }
	// "1__2": the second '_' (index 2) is flanked by '_' and '2', not two digits.
	if digitFlanked(bytesOf("1__2"), 2) { return "1__2 inner not flanked" }
	return ""
}

func TestHexUnderscoreOK() testing.TestResult {
	if !hexUnderscoreOK(bytesOf("0x1_2p0")) { return "0x1_2 ok (digit-flanked)" }
	if !hexUnderscoreOK(bytesOf("0x_1p0")) { return "0x_1 ok (after 0x prefix)" }
	if hexUnderscoreOK(bytesOf("0x1_.2p0")) { return "0x1_. rejected ('_' before '.')" }
	if hexUnderscoreOK(bytesOf("0x1__2p0")) { return "0x1__2 rejected (double '_')" }
	return ""
}

// lexInto runs lexFloat on an ASCII string and returns the lexInfo (the
// significand lands in a scratch Nat the caller doesn't need to inspect here).
func lexInto(s *[]readonly char) lexInfo {
	var mant @big.Nat = big.New()
	return lexFloat(bytesOf(s), mant)
}

func TestLexFloatDecimal() testing.TestResult {
	// "123.45": fracDigits=2, no exponent -> decExp = -2, nsig = 5, kind 0.
	var a lexInfo = lexInto("123.45")
	if a.kind != 0 { return "123.45 kind" }
	if a.decExp != (0 - 2) { return "123.45 decExp" }
	if a.nsig != 5 { return "123.45 nsig" }
	if a.neg { return "123.45 not negative" }
	if a.isHex { return "123.45 not hex" }
	// "-50e3": exponent +3, no fraction -> decExp = 3, neg.
	var b lexInfo = lexInto("-50e3")
	if b.kind != 0 || b.decExp != 3 || !b.neg { return "-50e3" }
	// "1.5e-2": decExp = -2 - 1 = -3.
	var c lexInfo = lexInto("1.5e-2")
	if c.decExp != (0 - 3) { return "1.5e-2 decExp" }
	return ""
}

func TestLexFloatSpecialsAndErrors() testing.TestResult {
	if lexInto("nan").kind != 3 { return "nan -> kind 3" }
	if lexInto("inf").kind != 1 { return "inf -> kind 1 (+Inf)" }
	if lexInto("-Infinity").kind != 2 { return "-Infinity -> kind 2 (-Inf)" }
	// Syntax errors -> kind 4.
	if lexInto("").kind != 4 { return "empty -> error" }
	if lexInto("1.2.3").kind != 4 { return "two dots -> error" }
	if lexInto("1e").kind != 4 { return "bare exponent -> error" }
	if lexInto("_5").kind != 4 { return "leading underscore -> error" }
	if lexInto("12x").kind != 4 { return "trailing junk -> error" }
	return ""
}

func TestLexHexBody() testing.TestResult {
	// "0x1p0": M=1, e2 = 0 - 4*0 = 0.
	var a lexInfo = lexInto("0x1p0")
	if a.kind != 0 || !a.isHex || a.decExp != 0 { return "0x1p0" }
	// "0x1.8p1": one hex fraction digit -> e2 = 1 - 4*1 = -3.
	var b lexInfo = lexInto("0x1.8p1")
	if b.kind != 0 || b.decExp != (0 - 3) { return "0x1.8p1 e2" }
	// A hex float REQUIRES a 'p' exponent (Go).
	if lexInto("0x1.8").kind != 4 { return "0x1.8 (no p) -> error" }
	// At least one hex digit required.
	if lexInto("0xp0").kind != 4 { return "0xp0 (no digit) -> error" }
	return ""
}
