package "pkg/std/strconv"

import "pkg/builtins/testing"

// streq/fail and f64bits are shared from the other strconv test files (same
// package).  These exercise fixed precision (prec >= 0).  All goldens were
// verified against Go go1.26.3's strconv.FormatFloat.

func TestFormatFloatFixedF() testing.TestResult {
	if !streq(FormatFloat(3.14159, 'f', 2, 64), "3.14") { return fail("f 3.14159 .2") }
	if !streq(FormatFloat(3.14159, 'f', 0, 64), "3") { return fail("f 3.14159 .0") }
	// Round-half-to-even at the integer place: 0.5 -> 0, 1.5 -> 2, 2.5 -> 2.
	if !streq(FormatFloat(0.5, 'f', 0, 64), "0") { return fail("f 0.5 .0 even") }
	if !streq(FormatFloat(1.5, 'f', 0, 64), "2") { return fail("f 1.5 .0") }
	if !streq(FormatFloat(2.5, 'f', 0, 64), "2") { return fail("f 2.5 .0 even") }
	// Carry that grows the integer part.
	if !streq(FormatFloat(9.96, 'f', 1, 64), "10.0") { return fail("f 9.96 .1 carry") }
	if !streq(FormatFloat(99.5, 'f', 0, 64), "100") { return fail("f 99.5 .0 carry") }
	if !streq(FormatFloat(0.0625, 'f', 4, 64), "0.0625") { return fail("f 0.0625 .4") }
	// Sub-1 rounding: round up to the last place, vs round to zero.
	if !streq(FormatFloat(0.006, 'f', 2, 64), "0.01") { return fail("f 0.006 .2 roundup") }
	if !streq(FormatFloat(0.004, 'f', 2, 64), "0.00") { return fail("f 0.004 .2") }
	if !streq(FormatFloat(0.0001, 'f', 2, 64), "0.00") { return fail("f 0.0001 .2 underflow") }
	if !streq(FormatFloat(100.0, 'f', 2, 64), "100.00") { return fail("f 100 .2") }
	if !streq(FormatFloat(0.0, 'f', 2, 64), "0.00") { return fail("f 0 .2") }
	if !streq(FormatFloat(1234.5, 'f', 3, 64), "1234.500") { return fail("f 1234.5 .3") }
	if !streq(FormatFloat(2.0, 'f', 3, 64), "2.000") { return fail("f 2 .3") }
	// Half-to-even tie at a fractional place: 0.125 / 0.375 are exact in
	// binary, so the discarded tail is exactly 0.5 (last digit even -> down,
	// odd -> up).
	if !streq(FormatFloat(0.125, 'f', 2, 64), "0.12") { return fail("f 0.125 .2 tie even") }
	if !streq(FormatFloat(0.375, 'f', 2, 64), "0.38") { return fail("f 0.375 .2 tie odd") }
	// nsig == 0: zero kept digits, the tail rounds up to a fresh leading '1'.
	if !streq(FormatFloat(0.05, 'f', 1, 64), "0.1") { return fail("f 0.05 .1 nsig0 carry") }
	if !streq(FormatFloat(0.6, 'f', 0, 64), "1") { return fail("f 0.6 .0 nsig0 carry-out") }
	// nsig < 0 with prec 0: underflow to "0" with no decimal point.
	if !streq(FormatFloat(0.0001, 'f', 0, 64), "0") { return fail("f 0.0001 .0 underflow") }
	// Larger prec exercises the digit loop and scratch sizing.
	if !streq(FormatFloat(0.1, 'f', 20, 64), "0.10000000000000000555") { return fail("f 0.1 .20") }
	return ""
}

func TestFormatFloatFixedE() testing.TestResult {
	if !streq(FormatFloat(3.14159, 'e', 2, 64), "3.14e+00") { return fail("e 3.14159 .2") }
	if !streq(FormatFloat(3.14159, 'e', 0, 64), "3e+00") { return fail("e 3.14159 .0") }
	if !streq(FormatFloat(0.5, 'e', 0, 64), "5e-01") { return fail("e 0.5 .0") }
	// Carry that bumps the exponent.
	if !streq(FormatFloat(9.96, 'e', 1, 64), "1.0e+01") { return fail("e 9.96 .1 carry") }
	if !streq(FormatFloat(9.5, 'e', 0, 64), "1e+01") { return fail("e 9.5 .0 carry") }
	if !streq(FormatFloat(1.0, 'e', 3, 64), "1.000e+00") { return fail("e 1 .3") }
	if !streq(FormatFloat(0.0, 'e', 2, 64), "0.00e+00") { return fail("e 0 .2") }
	if !streq(FormatFloat(123456.0, 'e', 2, 64), "1.23e+05") { return fail("e 123456 .2") }
	if !streq(FormatFloat(9.999e9, 'e', 2, 64), "1.00e+10") { return fail("e 9.999e9 .2 carry") }
	if !streq(FormatFloat(0.0, 'e', 0, 64), "0e+00") { return fail("e 0 .0") }
	// 3-digit decimal exponent through renderFixedE (appendExp mag >= 100),
	// at both dynamic-range extremes (via bit patterns, not huge literals).
	if !streq(FormatFloat(f64bits(cast(uint64, 0x7FEFFFFFFFFFFFFF)), 'e', 2, 64), "1.80e+308") {
		return fail("e MaxFloat64 .2 exp3")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 1)), 'e', 2, 64), "4.94e-324") {
		return fail("e min-subnormal .2 exp3")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 1)), 'e', 0, 64), "5e-324") {
		return fail("e min-subnormal .0")
	}
	return ""
}

func TestFormatFloatFixedG() testing.TestResult {
	if !streq(FormatFloat(3.14159, 'g', 3, 64), "3.14") { return fail("g 3.14159 .3") }
	// prec 0 means 1 significant digit.
	if !streq(FormatFloat(3.14159, 'g', 0, 64), "3") { return fail("g 3.14159 .0") }
	// Scientific via the eprec threshold (dexp >= eprec).
	if !streq(FormatFloat(100000.0, 'g', 3, 64), "1e+05") { return fail("g 1e5 .3 sci") }
	if !streq(FormatFloat(123456.0, 'g', 3, 64), "1.23e+05") { return fail("g 123456 .3 sci") }
	if !streq(FormatFloat(0.0001234, 'g', 2, 64), "0.00012") { return fail("g 0.0001234 .2") }
	// Trailing zeros are stripped in 'g'.
	if !streq(FormatFloat(1.0, 'g', 4, 64), "1") { return fail("g 1 .4 strip") }
	if !streq(FormatFloat(1.2, 'g', 5, 64), "1.2") { return fail("g 1.2 .5 strip") }
	if !streq(FormatFloat(120.0, 'g', 5, 64), "120") { return fail("g 120 .5 strip") }
	if !streq(FormatFloat(1.25, 'g', 3, 64), "1.25") { return fail("g 1.25 .3") }
	if !streq(FormatFloat(0.0, 'g', 3, 64), "0") { return fail("g 0 .3") }
	if !streq(FormatFloat(0.0, 'g', 0, 64), "0") { return fail("g 0 .0") }
	if !streq(FormatFloat(2.5e-5, 'g', 2, 64), "2.5e-05") { return fail("g 2.5e-5 .2") }
	// A round-up carry across all 9s bumps dp; 'g' then re-decides sci vs plain.
	if !streq(FormatFloat(999999.0, 'g', 3, 64), "1e+06") { return fail("g 999999 .3 carry->sci") }
	if !streq(FormatFloat(999999.0, 'g', 6, 64), "999999") { return fail("g 999999 .6 plain") }
	if !streq(FormatFloat(99.9, 'g', 2, 64), "1e+02") { return fail("g 99.9 .2 carry") }
	// prec 0 means 1 significant digit (sci by threshold, or plain).
	if !streq(FormatFloat(1234.0, 'g', 0, 64), "1e+03") { return fail("g 1234 .0 sci") }
	if !streq(FormatFloat(0.5, 'g', 0, 64), "0.5") { return fail("g 0.5 .0 plain") }
	return ""
}

func TestFormatFloatFixedSigned() testing.TestResult {
	if !streq(FormatFloat(cast(float64, 0) - 3.14159, 'e', 2, 64), "-3.14e+00") {
		return fail("e -3.14159 .2")
	}
	if !streq(FormatFloat(cast(float64, 0) - 0.006, 'f', 2, 64), "-0.01") {
		return fail("f -0.006 .2")
	}
	// Negative zero keeps its sign in fixed precision too.
	if !streq(FormatFloat(f64bits(cast(uint64, 1) << 63), 'f', 2, 64), "-0.00") {
		return fail("f -0 .2")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 1) << 63), 'e', 2, 64), "-0.00e+00") {
		return fail("e -0 .2")
	}
	if !streq(FormatFloat(f64bits(cast(uint64, 1) << 63), 'g', 3, 64), "-0") { return fail("g -0 .3") }
	// Sign is preserved when a tiny negative rounds to zero (the nsig < 0 path).
	if !streq(FormatFloat(cast(float64, 0) - 0.0001, 'f', 2, 64), "-0.00") {
		return fail("f -0.0001 .2 sign")
	}
	// Negative through fixed 'g' on the scientific path.
	if !streq(FormatFloat(cast(float64, 0) - 123456.0, 'g', 3, 64), "-1.23e+05") {
		return fail("g -123456 .3 sci")
	}
	return ""
}

func TestFormatFloatFixedUpper() testing.TestResult {
	if !streq(FormatFloat(3.14159, 'E', 2, 64), "3.14E+00") { return fail("E 3.14159 .2") }
	if !streq(FormatFloat(123456.0, 'G', 3, 64), "1.23E+05") { return fail("G 123456 .3") }
	return ""
}

// Fixed precision over the binary32 ulp: decompose by bitSize, then the exact
// f32 value is rendered to the requested digit count.
func TestFormatFloatFixed32() testing.TestResult {
	if !streq(FormatFloat(0.1, 'f', 5, 32), "0.10000") { return fail("f32 0.1 .5") }
	if !streq(FormatFloat(0.3333333333333333, 'f', 4, 32), "0.3333") { return fail("f32 1/3 .4") }
	// Once prec exposes the binary32 rounding, f32 and f64 diverge: 0.1 as
	// float32 is 0.100000001490..., as float64 0.1000000000000000055....
	if !streq(FormatFloat(0.1, 'f', 10, 32), "0.1000000015") { return fail("f32 0.1 .10") }
	if !streq(FormatFloat(0.1, 'f', 10, 64), "0.1000000000") { return fail("f64 0.1 .10 contrast") }
	// f32 through 'g', and an f32 extreme (MaxFloat32) via its f64 widening.
	if !streq(FormatFloat(100000.0, 'g', 3, 32), "1e+05") { return fail("f32 g 1e5 .3") }
	if !streq(FormatFloat(f64bits(cast(uint64, 0x47EFFFFFE0000000)), 'e', 2, 32), "3.40e+38") {
		return fail("f32 MaxFloat32 e .2")
	}
	return ""
}

// AppendFloat honors fixed precision through the same overflow contract.
func TestAppendFloatFixed() testing.TestResult {
	var buf @[]char = make_slice(char, 32)
	var n int = AppendFloat(buf[0:32], 0, 3.14159, 'f', 2, 64)
	if !streq(buf[0:n], "3.14") { return fail("AppendFloat f .2") }
	if n != 4 { return fail("AppendFloat f .2 pos") }
	// One short: overflow returns -(needed) and writes nothing.
	var small @[]char = make_slice(char, 3)
	if AppendFloat(small[0:3], 0, 3.14159, 'f', 2, 64) != (cast(int, 0) - 4) {
		return fail("AppendFloat f .2 overflow")
	}
	return ""
}
