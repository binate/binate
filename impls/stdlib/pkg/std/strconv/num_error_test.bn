package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/errors"

// errMsgEq reports whether a present error e renders exactly want.
func errMsgEq(e @errors.Error, want *[]readonly char) bool {
	if !present(e) {
		return false
	}
	var msg @[]readonly char = e.Error()
	return streq(msg[0:len(msg)], want)
}

func TestNumErrorSyntaxMessage() testing.TestResult {
	var e @errors.Error = syntaxErr("ParseInt", "abc")
	var want *[]readonly char = "strconv.ParseInt: parsing \"abc\": invalid syntax"
	if !errMsgEq(e, want) {
		return fail("unexpected syntax error message")
	}
	return ""
}

func TestNumErrorRangeMessage() testing.TestResult {
	var e @errors.Error = rangeErr("ParseUint", "99999999999999999999")
	var want *[]readonly char = "strconv.ParseUint: parsing \"99999999999999999999\": value out of ran"
			"ge"
	if !errMsgEq(e, want) {
		return fail("unexpected range error message")
	}
	return ""
}

func TestNumErrorSyntaxRootsInBadData() testing.TestResult {
	var e @errors.Error = syntaxErr("ParseBool", "x")
	if !classifiedAs(e, errors.BadData, errors.OutOfRange) {
		return fail("syntax error must root in BadData (and ConditionsUnmet), not OutOfRange")
	}
	return ""
}

func TestNumErrorRangeRootsInOutOfRange() testing.TestResult {
	var e @errors.Error = rangeErr("ParseUint", "99999999999999999999")
	if !classifiedAs(e, errors.OutOfRange, errors.BadData) {
		return fail("range error must root in OutOfRange (and ConditionsUnmet), not BadData")
	}
	return ""
}
