package "pkg/std/strconv"

import "pkg/builtins/testing"
import "pkg/std/errors"

// parseBoolOK reports whether ParseBool(s) succeeds with the wanted value.
func parseBoolOK(s *[]readonly char, want bool) bool {
	var v bool
	var err @errors.Error
	v, err = ParseBool(s)
	if present(err) {
		return false
	}
	return v == want
}

// parseBoolErr reports whether ParseBool(s) fails (present error, false value).
func parseBoolErr(s *[]readonly char) bool {
	var v bool
	var err @errors.Error
	v, err = ParseBool(s)
	if !present(err) {
		return false
	}
	return v == false
}

func TestParseBoolTrue() testing.TestResult {
	if !parseBoolOK("1", true) { return fail("ParseBool(\"1\")") }
	if !parseBoolOK("t", true) { return fail("ParseBool(\"t\")") }
	if !parseBoolOK("T", true) { return fail("ParseBool(\"T\")") }
	if !parseBoolOK("TRUE", true) { return fail("ParseBool(\"TRUE\")") }
	if !parseBoolOK("true", true) { return fail("ParseBool(\"true\")") }
	if !parseBoolOK("True", true) { return fail("ParseBool(\"True\")") }
	return ""
}

func TestParseBoolFalse() testing.TestResult {
	if !parseBoolOK("0", false) { return fail("ParseBool(\"0\")") }
	if !parseBoolOK("f", false) { return fail("ParseBool(\"f\")") }
	if !parseBoolOK("F", false) { return fail("ParseBool(\"F\")") }
	if !parseBoolOK("FALSE", false) { return fail("ParseBool(\"FALSE\")") }
	if !parseBoolOK("false", false) { return fail("ParseBool(\"false\")") }
	if !parseBoolOK("False", false) { return fail("ParseBool(\"False\")") }
	return ""
}

func TestParseBoolInvalid() testing.TestResult {
	if !parseBoolErr("") { return fail("ParseBool(\"\")") }
	if !parseBoolErr("x") { return fail("ParseBool(\"x\")") }
	if !parseBoolErr("2") { return fail("ParseBool(\"2\")") }
	if !parseBoolErr("TRUEX") { return fail("ParseBool(\"TRUEX\")") }
	if !parseBoolErr("tru") { return fail("ParseBool(\"tru\")") }
	if !parseBoolErr("yes") { return fail("ParseBool(\"yes\")") }
	// Mixed case outside Go's accepted set is a syntax error (only the
	// exact forms 1/t/T/TRUE/true/True etc. are accepted).
	if !parseBoolErr("tRUE") { return fail("ParseBool(\"tRUE\")") }
	if !parseBoolErr("FALSe") { return fail("ParseBool(\"FALSe\")") }
	return ""
}

func TestParseBoolErrorMessage() testing.TestResult {
	var err @errors.Error
	_, err = ParseBool("nope")
	if !present(err) { return fail("expected a present error") }
	var msg @[]readonly char = err.Error()
	if !streq(msg[0:len(msg)],
		"strconv.ParseBool: parsing \"nope\": invalid syntax") {
		return fail("unexpected ParseBool error message")
	}
	return ""
}
