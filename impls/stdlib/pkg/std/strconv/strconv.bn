package "pkg/std/strconv"

// normBase clamps a base outside 2..36 to 10.  Go panics on an
// out-of-range base; Binate has no panics, so the Append/Format
// surface picks a sane default rather than emitting garbage.
func normBase(base int) int {
	if base < 2 { return 10 }
	if base > 36 { return 10 }
	return base
}

// digitChar maps a digit value 0..35 to its lowercase character.
func digitChar(d int) char {
	if d < 10 {
		return cast(char, cast(int, '0') + d)
	}
	return cast(char, cast(int, 'a') + (d - 10))
}

// uintDigits returns how many base-`base` digits v occupies (>= 1;
// zero is one digit).  base must already be normalized (2..36).
func uintDigits(v uint64, base int) int {
	var b uint64 = cast(uint64, base)
	var n int = 1
	var t uint64 = v
	for t >= b {
		t = t / b
		n = n + 1
	}
	return n
}

// appendLit writes the literal s into dst at pos, returning the next
// position (or -len(s) when dst lacks room — the Append overflow
// contract).
func appendLit(dst *[]char, pos int, s *[]readonly char) int {
	var n int = len(s)
	if pos < 0 { return -n }
	if pos + n > len(dst) { return -n }
	for i := 0; i < n; i++ {
		dst[pos + i] = s[i]
	}
	return pos + n
}

// AppendUint writes v in base (2..36; a base outside that range is
// treated as 10) into dst starting at pos.  On success returns the
// next position (pos + digit count); on overflow (pos < 0, or the
// digits would not fit before len(dst)) it writes nothing and returns
// -(digits needed), which is always <= -1.
func AppendUint(dst *[]char, pos int, v uint64, base int) int {
	var b int = normBase(base)
	var nd int = uintDigits(v, b)
	if pos < 0 { return -nd }
	var end int = pos + nd
	if end > len(dst) { return -nd }
	var bb uint64 = cast(uint64, b)
	// Write digits low-to-high, filling from the last slot backward.
	var p int = end - 1
	var rem uint64 = v
	for {
		var d int = cast(int, rem % bb)
		dst[p] = digitChar(d)
		rem = rem / bb
		if rem == cast(uint64, 0) { break }
		p = p - 1
	}
	return end
}

// AppendInt writes v in base into dst starting at pos, emitting a
// leading '-' for negative values.  Same base rules and overflow
// contract as AppendUint, except `needed` counts the sign: on overflow
// it returns -(sign + digit count).  INT64_MIN is handled via
// two's-complement magnitude (negating through uint64), so it does not
// overflow.
func AppendInt(dst *[]char, pos int, v int64, base int) int {
	if v >= cast(int64, 0) {
		return AppendUint(dst, pos, cast(uint64, v), base)
	}
	var b int = normBase(base)
	// Two's-complement magnitude: `0 - v` overflows at INT64_MIN, so
	// negate through uint64 instead.
	var mag uint64 = cast(uint64, 0) - cast(uint64, v)
	var needed int = uintDigits(mag, b) + 1
	if pos < 0 { return -needed }
	if pos + needed > len(dst) { return -needed }
	dst[pos] = '-'
	return AppendUint(dst, pos + 1, mag, b)
}

// AppendBool writes "true" or "false" into dst at pos, returning the
// next position, or -(literal length) (-4 for "true", -5 for "false")
// when it does not fit, writing nothing.
func AppendBool(dst *[]char, pos int, b bool) int {
	if b {
		return appendLit(dst, pos, "true")
	}
	return appendLit(dst, pos, "false")
}

// FormatUint returns a freshly-allocated, caller-owned @[]char holding
// v in base, sized to exactly the digit count.
func FormatUint(v uint64, base int) @[]char {
	var b int = normBase(base)
	var nd int = uintDigits(v, b)
	var s @[]char = make_slice(char, nd)
	// Exact-fit buffer: AppendUint cannot overflow here, so its result
	// (the next position) is intentionally discarded.
	AppendUint(s[0:nd], 0, v, b)
	return s
}

// FormatInt returns a freshly-allocated, caller-owned @[]char holding v
// in base, with a leading '-' for negative values.
func FormatInt(v int64, base int) @[]char {
	if v >= cast(int64, 0) {
		return FormatUint(cast(uint64, v), base)
	}
	var b int = normBase(base)
	var mag uint64 = cast(uint64, 0) - cast(uint64, v)
	var total int = uintDigits(mag, b) + 1
	var s @[]char = make_slice(char, total)
	// Exact-fit buffer (total = digits + sign): AppendInt cannot
	// overflow here, so its result is intentionally discarded.
	AppendInt(s[0:total], 0, v, b)
	return s
}

// Itoa returns a freshly-allocated, caller-owned @[]char holding v as a
// base-10 decimal string — the common case of FormatInt, and the analogue
// of Go's strconv.Itoa.
func Itoa(v int) @[]char {
	return FormatInt(cast(int64, v), 10)
}

// FormatBool returns a freshly-allocated, caller-owned @[]char holding
// "true" or "false".
func FormatBool(b bool) @[]char {
	// Mirror FormatInt/FormatUint: size from the literal, allocate,
	// delegate the write to AppendBool (no separate width constants).
	var lit *[]readonly char = "false"
	if b {
		lit = "true"
	}
	var n int = len(lit)
	var s @[]char = make_slice(char, n)
	AppendBool(s[0:n], 0, b)
	return s
}
