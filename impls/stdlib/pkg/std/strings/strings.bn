package "pkg/std/strings"

import "pkg/std/errors"

// NewBuilder returns a new, empty Builder.  The zero Builder (nil backing,
// n == 0) is already usable — the first append allocates.
func NewBuilder() @Builder {
	return make(Builder)
}

// ensureCap makes room for `needed` more bytes.  When the current backing
// can't hold them it allocates a new one at 2*cap + needed — exponential
// growth, so repeated appends stay amortized O(1) — and copies the live
// prefix across.  A no-op when the space is already there.
func ensureCap(b *Builder, needed int) {
	var cap int = len(b.buf)
	if b.n + needed <= cap {
		return
	}
	var newCap int = 2 * cap + needed
	var nb @[]char = make_slice(char, newCap)
	for i := 0; i < b.n; i++ {
		nb[i] = b.buf[i]
	}
	b.buf = nb
}

// Write appends p's bytes and returns (len(p), empty error).  See io.Writer.
func (b *Builder) Write(p *[]readonly uint8) (int, @errors.Error) {
	var m int = len(p)
	ensureCap(b, m)
	for i := 0; i < m; i++ {
		b.buf[b.n + i] = cast(char, p[i])
	}
	b.n = b.n + m
	var none @errors.Error
	return m, none
}

// WriteByte appends one byte and returns an empty error.  See io.ByteWriter.
func (b *Builder) WriteByte(c uint8) @errors.Error {
	ensureCap(b, 1)
	b.buf[b.n] = cast(char, c)
	b.n = b.n + 1
	var none @errors.Error
	return none
}

// Grow ensures n more bytes fit without a reallocation, growing
// exponentially when it must allocate.  A negative (or already-fitting) n
// is a no-op.
func (b *Builder) Grow(n int) {
	if n <= 0 {
		return
	}
	ensureCap(b, n)
}

// Len returns the number of bytes accumulated so far.
func (b *Builder) Len() int {
	return b.n
}

// Cap returns the capacity of the backing (>= Len).
func (b *Builder) Cap() int {
	return len(b.buf)
}

// Reset returns the Builder to empty and releases its backing.
func (b *Builder) Reset() {
	var empty @[]char
	b.buf = empty
	b.n = 0
}

// String returns the accumulated bytes as an immutable, backing-sharing
// string.  Empty when nothing has been written.
func (b *Builder) String() @[]readonly char {
	if b.n == 0 {
		var empty @[]readonly char
		return empty
	}
	return b.buf[0:b.n]
}
