package "pkg/std/strings"

import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/io"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// ch is the byte value of a character literal, for WriteByte calls.
func ch(c char) uint8 {
	return cast(uint8, cast(int, c))
}

// sEq compares a built string (passed as a readonly borrow) to a literal.
func sEq(got *[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) {
		return false
	}
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] {
			return false
		}
	}
	return true
}

// WriteByte accumulates single bytes; String renders them; Len counts them.
func TestBuilderWriteByte() testing.TestResult {
	var b @Builder = NewBuilder()
	b.WriteByte(ch('h'))
	b.WriteByte(ch('i'))
	if b.Len() != 2 {
		return fail("Len should be 2")
	}
	if !sEq(b.String(), "hi") {
		return fail("String should be 'hi'")
	}
	return ""
}

// Write appends a byte run and returns (len, empty error); a string
// literal is a *[]readonly uint8.  Successive Writes accumulate.
func TestBuilderWrite() testing.TestResult {
	var b @Builder = NewBuilder()
	var n int
	var err @errors.Error
	n, err = b.Write("abc")
	if present(err) {
		return fail("Write should not fail")
	}
	if n != 3 {
		return fail("Write should return 3")
	}
	n, err = b.Write("def")
	if n != 3 || b.Len() != 6 {
		return fail("a second Write should append")
	}
	if !sEq(b.String(), "abcdef") {
		return fail("String should be 'abcdef'")
	}
	return ""
}

// The empty Builder renders an empty string and reports Len 0.
func TestBuilderEmpty() testing.TestResult {
	var b @Builder = NewBuilder()
	if b.Len() != 0 {
		return fail("a fresh Builder should be empty")
	}
	if b.Cap() != 0 {
		return fail("a fresh Builder should have zero capacity")
	}
	if !sEq(b.String(), "") {
		return fail("a fresh Builder's String should be empty")
	}
	return ""
}

// Grow reserves capacity for n more bytes without changing the contents
// or Len.
func TestBuilderGrow() testing.TestResult {
	var b @Builder = NewBuilder()
	b.WriteByte(ch('a'))
	b.Grow(100)
	if b.Cap() < 101 {
		return fail("after Grow(100) the cap should fit 100 more bytes")
	}
	if b.Len() != 1 {
		return fail("Grow must not change Len")
	}
	if !sEq(b.String(), "a") {
		return fail("Grow must not change the contents")
	}
	return ""
}

// A reallocation grows the capacity exponentially (at least doubling),
// not by the exact byte needed — the amortized-O(1) growth strategy.
func TestBuilderGrowsExponentially() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Grow(4)
	var c1 int = b.Cap()
	if c1 < 4 {
		return fail("Grow(4) should give cap >= 4")
	}
	// Fill the backing with a distinguishable pattern, then one more byte
	// forces a reallocation that must both grow the capacity AND preserve
	// every byte already written.
	for i := 0; i < c1; i++ {
		b.WriteByte(cast(uint8, cast(int, '0') + i))
	}
	b.WriteByte(ch('!'))
	if b.Cap() < 2 * c1 {
		return fail("a reallocation should at least double the capacity")
	}
	if b.Len() != c1 + 1 {
		return fail("Len should count every byte across the reallocation")
	}
	var s @[]readonly char = b.String()
	for i := 0; i < c1; i++ {
		if cast(int, s[i]) != cast(int, '0') + i {
			return fail("a byte was lost or reordered across the reallocation")
		}
	}
	if s[c1] != ch('!') {
		return fail("the triggering byte should be last after the reallocation")
	}
	return ""
}

// Reset empties the Builder and releases the backing, but a string taken
// before Reset keeps its own reference and stays valid.
func TestBuilderReset() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("abc")
	var saved @[]readonly char = b.String()
	b.Reset()
	if b.Len() != 0 {
		return fail("Reset should zero Len")
	}
	if b.Cap() != 0 {
		return fail("Reset should release the backing")
	}
	if !sEq(saved, "abc") {
		return fail("a String taken before Reset must survive it")
	}
	return ""
}

// A *Builder is an io.Writer: bytes written through the interface land in
// the same Builder.
func TestBuilderSatisfiesWriter() testing.TestResult {
	var b @Builder = NewBuilder()
	var w @io.Writer = b
	var n int
	var err @errors.Error
	n, err = w.Write("xyz")
	if present(err) {
		return fail("Write via io.Writer should not fail")
	}
	if n != 3 {
		return fail("Write via io.Writer should return 3")
	}
	if !sEq(b.String(), "xyz") {
		return fail("bytes written through io.Writer should land in the Builder")
	}
	return ""
}

// A *Builder is an io.ByteWriter: bytes written through the interface land
// in the same Builder.
func TestBuilderSatisfiesByteWriter() testing.TestResult {
	var b @Builder = NewBuilder()
	var w @io.ByteWriter = b
	var err @errors.Error
	err = w.WriteByte(ch('q'))
	if present(err) {
		return fail("WriteByte via io.ByteWriter should not fail")
	}
	if !sEq(b.String(), "q") {
		return fail("a byte written through io.ByteWriter should land in the Builder")
	}
	return ""
}

// Every byte value 0..255 round-trips through WriteByte and Write.  The
// Builder is byte-oriented, so high-bit bytes (> 127) must survive the
// uint8 -> char store (char is 8-bit unsigned) — ASCII-only checks can't
// distinguish that from a sign-extending variant.
func TestBuilderByteFidelity() testing.TestResult {
	var b @Builder = NewBuilder()
	for v := 0; v < 256; v++ {
		b.WriteByte(cast(uint8, v))
	}
	var s @[]readonly char = b.String()
	if len(s) != 256 {
		return fail("Builder should hold all 256 byte values")
	}
	for v := 0; v < 256; v++ {
		if cast(int, s[v]) != v {
			return fail("a byte value did not round-trip through WriteByte")
		}
	}
	// Same through Write, across the 0x00 / 0x7F / 0x80 / 0xFF boundaries.
	var raw @[]uint8 = make_slice(uint8, 4)
	raw[0] = cast(uint8, 0)
	raw[1] = cast(uint8, 127)
	raw[2] = cast(uint8, 128)
	raw[3] = cast(uint8, 255)
	var b2 @Builder = NewBuilder()
	b2.Write(raw[0:4])
	var s2 @[]readonly char = b2.String()
	if cast(int, s2[0]) != 0 || cast(int, s2[1]) != 127 ||
			cast(int, s2[2]) != 128 || cast(int, s2[3]) != 255 {
		return fail("a byte value did not round-trip through Write")
	}
	return ""
}

// Content survives the many reallocations growth-from-empty triggers, for
// both byte-at-a-time and a bulk Write run that itself spans a regrow.
func TestBuilderContentSurvivesGrowth() testing.TestResult {
	var b @Builder = NewBuilder()
	var n int = 500
	for i := 0; i < n; i++ {
		b.WriteByte(cast(uint8, cast(int, 'a') + (i % 26)))
	}
	b.Write("0123456789ABCDEFGHIJ0123456789ABCDEFGHIJ")
	if b.Len() != n + 40 {
		return fail("Len should count every byte- and bulk-written byte")
	}
	var s @[]readonly char = b.String()
	for i := 0; i < n; i++ {
		if cast(int, s[i]) != cast(int, 'a') + (i % 26) {
			return fail("a byte-written byte was corrupted across reallocations")
		}
	}
	var want *[]readonly char = "0123456789ABCDEFGHIJ0123456789ABCDEFGHIJ"
	for j := 0; j < 40; j++ {
		if s[n + j] != want[j] {
			return fail("a bulk-written byte was corrupted across the reallocation")
		}
	}
	return ""
}

// Write of an empty slice returns (0, empty error) and changes nothing.
func TestBuilderWriteEmpty() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("ab")
	var n int
	var err @errors.Error
	n, err = b.Write("")
	if n != 0 || present(err) {
		return fail("Write of an empty slice should return (0, no error)")
	}
	if b.Len() != 2 || !sEq(b.String(), "ab") {
		return fail("Write of an empty slice should not change the Builder")
	}
	return ""
}

// Grow with a non-positive n is a no-op (a documented divergence from
// Go's panic): it changes neither capacity nor contents, on a fresh or a
// populated Builder.
func TestBuilderGrowNonPositive() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Grow(0)
	b.Grow(-5)
	if b.Cap() != 0 || b.Len() != 0 {
		return fail("Grow(0)/Grow(-5) on a fresh Builder should change nothing")
	}
	b.Write("hi")
	var capBefore int = b.Cap()
	b.Grow(0)
	b.Grow(-5)
	if b.Cap() != capBefore || b.Len() != 2 || !sEq(b.String(), "hi") {
		return fail("Grow(0)/Grow(-5) on a populated Builder should change nothing")
	}
	return ""
}

// A Builder is reusable across Reset cycles, and a String taken before a
// Reset keeps its own bytes (its reference holds the old backing alive).
func TestBuilderResetReuse() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("first")
	var saved @[]readonly char = b.String()
	b.Reset()
	b.Write("second")
	if !sEq(b.String(), "second") {
		return fail("a Builder should produce correct output after Reset+reuse")
	}
	if !sEq(saved, "first") {
		return fail("a String taken before Reset should still read its own bytes")
	}
	b.Reset()
	b.Write("third")
	if !sEq(b.String(), "third") || !sEq(saved, "first") {
		return fail("a second Reset+reuse cycle should be correct and leave saved views intact")
	}
	return ""
}

// A String view taken before a reallocation stays valid and unchanged
// after later appends move the Builder onto a fresh backing.
func TestBuilderStringSurvivesRegrow() testing.TestResult {
	var b @Builder = NewBuilder()
	b.Write("abc")
	var view @[]readonly char = b.String()
	for i := 0; i < 200; i++ {
		b.WriteByte(ch('z'))
	}
	if !sEq(view, "abc") {
		return fail("a String taken before a reallocation must stay valid")
	}
	if b.Len() != 203 {
		return fail("the Builder should have grown past the saved view")
	}
	return ""
}
