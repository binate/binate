package "pkg/std/table"

import "pkg/builtins/testing"
import "pkg/std/cmp"
import "pkg/std/hash"
import "pkg/std/iter"

func fail(msg @[]char) testing.TestResult { return msg }

// cell is a managed value type, so Table's managed-V write paths (overwrite RefDec,
// backward-shift move, final-slot zeroing) are exercised for a reference-counted V.
type cell struct { v int }

func makeCell(x int) @cell {
	var c @cell = make(cell)
	c.v = x
	return c
}

func cellTable() @Table[int, @cell, hash.Default[int], cmp.Default[int]] {
	var h hash.Default[int]
	var e cmp.Default[int]
	return NewTable[int, @cell, hash.Default[int], cmp.Default[int]](h, e)
}

// intTable builds a Table over the intrinsic Default policies (the fast path a
// Hashable-keyed Map uses).
func intTable() @Table[int, int, hash.Default[int], cmp.Default[int]] {
	var h hash.Default[int]
	var e cmp.Default[int]
	return NewTable[int, int, hash.Default[int], cmp.Default[int]](h, e)
}

func idHash(x int) uint { return cast(uint, x) }

func intEq(a int, b int) bool { return a == b }

// fnTable builds a Table over injected-fn policies (the fast path a MapFn uses).
func fnTable() @Table[int, int, hash.FnHasher[int], cmp.FnEq[int]] {
	return NewTable[int, int, hash.FnHasher[int], cmp.FnEq[int]](hash.Fn[int](idHash),
			cmp.Fn[int](intEq))
}

// Put/Get/Len over the Default policies, including a colliding probe.
func TestDefaultPutGet() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(1, 10)
	t.Put(2, 20)
	t.Put(9, 90)
	if t.Len() != 3 {
		return fail("expected len 3")
	}
	var v int
	var ok bool
	v, ok = t.Get(2)
	if !ok || v != 20 {
		return fail("expected 2 -> 20")
	}
	v, ok = t.Get(9)
	if !ok || v != 90 {
		return fail("expected 9 -> 90 (probed past 1)")
	}
	v, ok = t.Get(3)
	if ok {
		return fail("3 should be absent")
	}
	return ""
}

// The same engine over injected-fn policies.
func TestFnPutGet() testing.TestResult {
	var t @Table[int, int, hash.FnHasher[int], cmp.FnEq[int]] = fnTable()
	t.Put(3, 30)
	t.Put(11, 110)
	var v int
	var ok bool
	v, ok = t.Get(3)
	if !ok || v != 30 {
		return fail("expected 3 -> 30")
	}
	v, ok = t.Get(11)
	if !ok || v != 110 {
		return fail("expected 11 -> 110 (probed past 3)")
	}
	return ""
}

// Overwriting a present key changes the value, not the count.
func TestOverwrite() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(5, 50)
	t.Put(5, 55)
	if t.Len() != 1 {
		return fail("overwrite should keep len 1")
	}
	var v int
	var ok bool
	v, ok = t.Get(5)
	if !ok || v != 55 {
		return fail("expected 5 -> 55")
	}
	return ""
}

// Growth (past the 75% load factor) rehashes and preserves every entry.
func TestGrowth() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	for i := 0; i < 20; i = i + 1 {
		t.Put(i, i * 10)
	}
	if t.Len() != 20 {
		return fail("expected len 20 after growth")
	}
	for i := 0; i < 20; i = i + 1 {
		var v int
		var ok bool
		v, ok = t.Get(i)
		if !ok || v != i * 10 {
			return fail("growth lost an entry")
		}
	}
	return ""
}

// Remove with a backward-shift over a collision chain keeps the chain intact.
func TestRemoveBackwardShift() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(1, 10)
	t.Put(9, 90)
	t.Put(17, 170)
	if !t.Remove(9) {
		return fail("Remove(9) should be true")
	}
	if t.Has(9) {
		return fail("9 should be gone")
	}
	var v int
	var ok bool
	v, ok = t.Get(17)
	if !ok || v != 170 {
		return fail("17 must survive the backward-shift")
	}
	v, ok = t.Get(1)
	if !ok || v != 10 {
		return fail("1 must survive")
	}
	if t.Len() != 2 {
		return fail("expected len 2")
	}
	if t.Remove(9) {
		return fail("removing an absent key should be false")
	}
	return ""
}

// Iteration visits every live entry exactly once.
func TestCursor() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(1, 10)
	t.Put(2, 20)
	t.Put(3, 30)
	var keySum int = 0
	var valSum int = 0
	var seen int = 0
	var it Cursor[int, int, hash.Default[int], cmp.Default[int]] = t.Iter()
	for {
		var e Entry[int, int]
		var ok bool
		e, ok = it.Next()
		if !ok {
			break
		}
		keySum = keySum + e.Key
		valSum = valSum + e.Val
		seen = seen + 1
	}
	if seen != 3 {
		return fail("cursor should visit 3 entries")
	}
	if keySum != 6 || valSum != 60 {
		return fail("cursor should visit each entry once")
	}
	return ""
}

// Remove that shifts an entry BACKWARD across the cap boundary — the i>j branch of the
// backward-shift predicate (keys 7/15/23 all home to slot 7 mod 8, chaining 7->0->1).
func TestRemoveWraparound() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(7, 70)
	t.Put(15, 150)
	t.Put(23, 230)
	if !t.Remove(7) {
		return fail("Remove(7) should succeed")
	}
	if t.Has(7) {
		return fail("7 should be gone")
	}
	var v int
	var ok bool
	v, ok = t.Get(15)
	if !ok || v != 150 {
		return fail("15 must survive the wraparound shift")
	}
	v, ok = t.Get(23)
	if !ok || v != 230 {
		return fail("23 must survive the wraparound shift")
	}
	if t.Len() != 2 {
		return fail("expected len 2")
	}
	return ""
}

// A managed value is released on overwrite (no leak) and updated in place.
func TestManagedValueOverwrite() testing.TestResult {
	var t @Table[int, @cell, hash.Default[int], cmp.Default[int]] = cellTable()
	t.Put(5, makeCell(1))
	t.Put(5, makeCell(2))
	if t.Len() != 1 {
		return fail("overwrite should not change len")
	}
	var g @cell
	var ok bool
	g, ok = t.Get(5)
	if !ok || g.v != 2 {
		return fail("managed overwrite should update the value")
	}
	return ""
}

// A managed value survives a backward-shift move on Remove (chain 1/9/17 at slot 1).
func TestManagedValueBackwardShift() testing.TestResult {
	var t @Table[int, @cell, hash.Default[int], cmp.Default[int]] = cellTable()
	t.Put(1, makeCell(10))
	t.Put(9, makeCell(90))
	t.Put(17, makeCell(170))
	if !t.Remove(9) {
		return fail("Remove(9) should succeed")
	}
	var g @cell
	var ok bool
	g, ok = t.Get(17)
	if !ok || g.v != 170 {
		return fail("17's managed value must survive the shift")
	}
	if t.Len() != 2 {
		return fail("expected len 2")
	}
	return ""
}

func TestDeleteThenReinsert() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(1, 10)
	t.Put(9, 90)
	if !t.Remove(1) {
		return fail("Remove(1) should succeed")
	}
	t.Put(1, 11)
	var v int
	var ok bool
	v, ok = t.Get(1)
	if !ok || v != 11 {
		return fail("reinsert after delete should hold the new value")
	}
	v, ok = t.Get(9)
	if !ok || v != 90 {
		return fail("9 must remain reachable")
	}
	if t.Len() != 2 {
		return fail("expected len 2")
	}
	return ""
}

func TestRemoveMissingKeepsLen() testing.TestResult {
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(1, 10)
	t.Put(2, 20)
	if t.Remove(99) {
		return fail("removing an absent key should be false")
	}
	if t.Len() != 2 {
		return fail("a failed Remove must not change len")
	}
	return ""
}

// The boxed iterator (AsIterator / iter.Iterable) visits every entry, and an empty
// table's iterator yields nothing.
func TestAsIteratorAndEmpty() testing.TestResult {
	var e0 @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	var it0 @iter.Iterator[Entry[int, int]] = e0.AsIterator()
	var junk Entry[int, int]
	var ok0 bool
	junk, ok0 = it0.Next()
	if ok0 {
		return fail("an empty table's iterator should yield nothing")
	}
	var t @Table[int, int, hash.Default[int], cmp.Default[int]] = intTable()
	t.Put(1, 10)
	t.Put(2, 20)
	t.Put(3, 30)
	var it @iter.Iterator[Entry[int, int]] = t.AsIterator()
	var sum int = 0
	var seen int = 0
	for {
		var en Entry[int, int]
		var ok bool
		en, ok = it.Next()
		if !ok {
			break
		}
		sum = sum + en.Key + en.Val
		seen = seen + 1
	}
	if seen != 3 {
		return fail("the boxed iterator should visit 3 entries")
	}
	if sum != 66 {
		return fail("the boxed iterator visited entries incorrectly")
	}
	return ""
}
