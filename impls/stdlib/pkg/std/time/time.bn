// pkg/std/time: the Point and Delta value types.  Pure value math — no
// syscalls, no clock reading (a clock is a separate, later concern).
package "pkg/std/time"

// unixToYear1 is the number of seconds from the start of Point's idealized
// timeline (0001-01-01 00:00:00, proleptic Gregorian, no leap seconds) to the
// Unix epoch (1970-01-01 00:00:00 UTC): 719162 days * 86400.  FromUnix adds it
// to map a Unix time onto the year-1 origin.
const unixToYear1 int64 = 62135596800

// nanosPerSec is the number of nanoseconds in a second.
const nanosPerSec int64 = 1000000000

// Nanoseconds returns the difference as an exact nanosecond count.
func (d Delta) Nanoseconds() int64 {
	return cast(int64, d)
}

// FromUnix returns the Point sec seconds plus nsec nanoseconds after the Unix
// epoch.  nsec must be in [0, nanosPerSec); a value outside that range is a
// programmer error and panics.
func FromUnix(sec int64, nsec int32) Point {
	if nsec < 0 || cast(int64, nsec) >= nanosPerSec {
		panic("time.FromUnix: nsec out of range [0, 1e9)")
	}
	return Point{sec: sec + unixToYear1, nsec: nsec}
}

// ToUnix returns p as a Unix time (the inverse of FromUnix): the seconds and
// then the nanoseconds after 1970-01-01 00:00:00 UTC.
func (p Point) ToUnix() (int64, int32) {
	return p.sec - unixToYear1, p.nsec
}

// SecondsSinceEpoch returns the whole seconds from the year-1 origin to p.
func (p Point) SecondsSinceEpoch() int64 {
	return p.sec
}

// Nanosecond returns p's sub-second part, in [0, 1e9).
func (p Point) Nanosecond() int32 {
	return p.nsec
}

// Before reports whether p precedes q.
func (p Point) Before(q Point) bool {
	return p.sec < q.sec || (p.sec == q.sec && p.nsec < q.nsec)
}

// After reports whether p follows q.
func (p Point) After(q Point) bool {
	return p.sec > q.sec || (p.sec == q.sec && p.nsec > q.nsec)
}

// Equal reports whether p and q are the same point.
func (p Point) Equal(q Point) bool {
	return p.sec == q.sec && p.nsec == q.nsec
}

// Sub returns the signed difference p - q in nanoseconds.  Overflows for spans
// beyond roughly ±292 years (a Delta is an int64 nanosecond count).
func (p Point) Sub(q Point) Delta {
	var dsec int64 = p.sec - q.sec
	var dnsec int64 = cast(int64, p.nsec) - cast(int64, q.nsec)
	return cast(Delta, dsec * nanosPerSec + dnsec)
}
