package "pkg/std/time"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// TestFromUnixSub checks that FromUnix + Sub recovers a known difference (the
// epoch offset cancels in Sub), including the nanosecond part, negative
// results, and the nsec boundary value.
func TestFromUnixSub() testing.TestResult {
	var a Point = FromUnix(cast(int64, 10), cast(int32, 0))
	var b Point = FromUnix(cast(int64, 3), cast(int32, 0))
	if a.Sub(b).Nanoseconds() != cast(int64, 7000000000) {
		return fail("10s - 3s should be 7e9 ns")
	}
	if b.Sub(a).Nanoseconds() != cast(int64, 0) - cast(int64, 7000000000) {
		return fail("3s - 10s should be -7e9 ns")
	}
	var c Point = FromUnix(cast(int64, 10), cast(int32, 500000000))
	var d Point = FromUnix(cast(int64, 10), cast(int32, 200000000))
	if c.Sub(d).Nanoseconds() != cast(int64, 300000000) {
		return fail("0.5s - 0.2s should be 3e8 ns")
	}
	// nsec boundary (999999999 is valid and preserved).
	var hi Point = FromUnix(cast(int64, 10), cast(int32, 999999999))
	var lo Point = FromUnix(cast(int64, 10), cast(int32, 0))
	if hi.Sub(lo).Nanoseconds() != cast(int64, 999999999) {
		return fail("boundary nsec should be preserved")
	}
	// Sub across a second boundary (the nanosecond part is negative).
	if FromUnix(cast(int64, 11), cast(int32, 0)).Sub(
			FromUnix(cast(int64, 10), cast(int32, 999999999))).Nanoseconds() != cast(int64, 1) {
		return fail("11s - 10.999999999s should be 1 ns")
	}
	// Pre-epoch (negative Unix sec) participates like any other point.
	if FromUnix(cast(int64, 5), cast(int32, 0)).Sub(
			FromUnix(cast(int64, -5), cast(int32, 0))).Nanoseconds() != cast(int64, 10000000000) {
		return fail("5s - (-5s) should be 10e9 ns")
	}
	return ""
}

// TestOrdering checks Before/After/Equal at both second and nanosecond
// granularity.
func TestOrdering() testing.TestResult {
	var a Point = FromUnix(cast(int64, 3), cast(int32, 0))
	var b Point = FromUnix(cast(int64, 10), cast(int32, 0))
	if !a.Before(b) { return fail("3s should be before 10s") }
	if a.After(b) { return fail("3s should not be after 10s") }
	if !b.After(a) { return fail("10s should be after 3s") }
	if a.Equal(b) { return fail("3s should not equal 10s") }

	// Within one second, the nanosecond part orders the points.
	var c Point = FromUnix(cast(int64, 10), cast(int32, 1))
	var e Point = FromUnix(cast(int64, 10), cast(int32, 2))
	if !c.Before(e) { return fail("10s+1ns should be before 10s+2ns") }
	if c.After(e) { return fail("10s+1ns should not be after 10s+2ns") }
	if !c.Equal(FromUnix(cast(int64, 10), cast(int32, 1))) {
		return fail("identical points should be Equal")
	}
	// sec dominates nsec: (1s, 999999999ns) is before (2s, 0ns) despite the
	// larger nsec.
	var g Point = FromUnix(cast(int64, 1), cast(int32, 999999999))
	var h Point = FromUnix(cast(int64, 2), cast(int32, 0))
	if !g.Before(h) { return fail("1s+999999999ns should be before 2s") }
	if !h.After(g) { return fail("2s should be after 1s+999999999ns") }
	if g.Equal(h) { return fail("1s+999999999ns should not equal 2s") }
	// Ordering across the Unix epoch (negative sec).
	if !FromUnix(cast(int64, -1), cast(int32, 0)).Before(FromUnix(cast(int64, 1), cast(int32, 0))) {
		return fail("-1s should be before 1s")
	}
	return ""
}

// TestAccessors checks ToUnix (the inverse of FromUnix, incl. negative times),
// SecondsSinceEpoch (the year-1 frame), and Nanosecond.
func TestAccessors() testing.TestResult {
	var sec int64
	var ns int32
	sec, ns = FromUnix(cast(int64, 5), cast(int32, 7)).ToUnix()
	if sec != cast(int64, 5) { return fail("ToUnix sec should round-trip to 5") }
	if ns != cast(int32, 7) { return fail("ToUnix nsec should round-trip to 7") }
	sec, ns = FromUnix(cast(int64, -3), cast(int32, 9)).ToUnix()
	if sec != cast(int64, -3) { return fail("ToUnix sec should round-trip to -3") }
	if ns != cast(int32, 9) { return fail("ToUnix nsec should round-trip to 9") }
	if FromUnix(cast(int64, 0), cast(int32, 0)).SecondsSinceEpoch() != cast(int64, 62135596800) {
		return fail("SecondsSinceEpoch of the Unix epoch should be 62135596800")
	}
	if FromUnix(cast(int64, 5), cast(int32, 7)).Nanosecond() != cast(int32, 7) {
		return fail("Nanosecond should be 7")
	}
	return ""
}

// TestEpochOffset pins the year-1 origin: FromUnix maps the Unix epoch to
// 62135596800 seconds (the 719162 days from 0001-01-01 to 1970-01-01 times
// 86400) on the idealized timeline, and preserves the nanosecond part.
// White-box — reads the internal fields, which carry the absolute offset that
// Sub/comparison cancel out.
func TestEpochOffset() testing.TestResult {
	var z Point = FromUnix(cast(int64, 0), cast(int32, 0))
	if z.sec != cast(int64, 62135596800) {
		return fail("Unix epoch should map to 62135596800s on the year-1 timeline")
	}
	if z.nsec != cast(int32, 0) { return fail("nsec should be 0") }
	var p Point = FromUnix(cast(int64, 5), cast(int32, 7))
	if p.sec != cast(int64, 62135596805) {
		return fail("FromUnix should add the epoch offset to sec")
	}
	if p.nsec != cast(int32, 7) { return fail("FromUnix should preserve nsec") }
	return ""
}

// TestDeltaNanoseconds checks Delta.Nanoseconds round-trips the underlying
// count (and that a sub-second Delta is exact).
func TestDeltaNanoseconds() testing.TestResult {
	var d Delta = FromUnix(cast(int64, 0), cast(int32, 250000000)).Sub(
		FromUnix(cast(int64, 0), cast(int32, 0)))
	if d.Nanoseconds() != cast(int64, 250000000) {
		return fail("0.25s Delta should be 2.5e8 ns")
	}
	return ""
}
