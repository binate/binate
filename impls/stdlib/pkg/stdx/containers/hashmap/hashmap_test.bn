package "pkg/stdx/containers/hashmap"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// cell is a managed value type used to exercise the retain/release paths (overwrite,
// backward-shift move, final-slot zeroing) for a reference-counted V.
type cell struct {
	v int
}

// mkey is a key type carrying a managed field (ref); its Hash/Compare use only the
// int field k (so keys with k colliding mod cap form a controllable probe chain),
// while the @cell field makes @[]mkey element moves refcount — exercising the
// retain/release paths for a key with managed contents in backward-shift deletion.
type mkey struct {
	k   int
	ref @cell
}

func (a mkey) Hash() uint { return cast(uint, a.k) }
func (a mkey) Compare(b mkey) int {
	if a.k < b.k { return -1 }
	if a.k > b.k { return 1 }
	return 0
}
impl mkey : lang.Hashable

// makeCell / makeKey construct managed test objects with a given int payload.
func makeCell(x int) @cell {
	var c @cell = make(cell)
	c.v = x
	return c
}

func makeKey(x int) mkey {
	var key mkey
	key.k = x
	key.ref = make(cell)
	return key
}

// Put then Get returns the stored values; Len tracks the entry count.
func TestPutGetLen() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	if Len[int, int](m) != 0 { return fail("new map should be empty") }
	Put[int, int](m, 1, 10)
	Put[int, int](m, 2, 20)
	Put[int, int](m, 3, 30)
	if Len[int, int](m) != 3 { return fail("expected len 3") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 2)
	if !ok || v != 20 { return fail("expected 2 -> 20") }
	v, ok = Get[int, int](m, 1)
	if !ok || v != 10 { return fail("expected 1 -> 10") }
	return ""
}

// Putting an existing key overwrites its value without changing the length.
func TestOverwriteValue() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 5, 1)
	Put[int, int](m, 5, 2)
	if Len[int, int](m) != 1 { return fail("overwrite should not change len") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 5)
	if !ok || v != 2 { return fail("overwrite should update the value") }
	return ""
}

// Has reflects membership; Get on a missing key returns (zero, false).
func TestHasAndMissingGet() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 7, 70)
	if !Has[int, int](m, 7) { return fail("7 should be present") }
	if Has[int, int](m, 8) { return fail("8 should be absent") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 8)
	if ok { return fail("missing Get should be false") }
	if v != 0 { return fail("missing Get should yield the zero value") }
	return ""
}

// Inserting many entries triggers growth; every entry stays retrievable.
func TestGrowth() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	for i := 0; i < 100; i++ {
		Put[int, int](m, i, i * 10)
	}
	if Len[int, int](m) != 100 { return fail("expected len 100") }
	for i := 0; i < 100; i++ {
		var v int
		var ok bool
		v, ok = Get[int, int](m, i)
		if !ok || v != i * 10 { return fail("entry lost or corrupted after growth") }
	}
	return ""
}

// Remove deletes a key and reports true; the key is then absent and Len drops.
func TestRemoveBasic() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 10)
	Put[int, int](m, 2, 20)
	if !Remove[int, int](m, 1) { return fail("remove of present key should be true") }
	if Has[int, int](m, 1) { return fail("1 should be gone") }
	if Len[int, int](m) != 1 { return fail("len should be 1 after remove") }
	if !Has[int, int](m, 2) { return fail("2 should remain") }
	return ""
}

// Removing an absent key returns false and changes nothing.
func TestRemoveMissing() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 10)
	if Remove[int, int](m, 99) { return fail("remove of absent key should be false") }
	if Len[int, int](m) != 1 { return fail("len should be unchanged") }
	return ""
}

// Backward-shift, head of chain: keys 1, 9, 17 collide at slot 1 (identity hash,
// cap 8). Removing the head shifts the chain back; the survivors stay findable.
func TestRemoveBackwardShiftHead() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 100)
	Put[int, int](m, 9, 900)
	Put[int, int](m, 17, 1700)
	if !Remove[int, int](m, 1) { return fail("remove 1 should succeed") }
	if Has[int, int](m, 1) { return fail("1 should be gone") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 9)
	if !ok || v != 900 { return fail("9 should survive the shift") }
	v, ok = Get[int, int](m, 17)
	if !ok || v != 1700 { return fail("17 should survive the shift") }
	if Len[int, int](m) != 2 { return fail("len should be 2") }
	return ""
}

// Backward-shift, middle of chain: removing 9 from 1,9,17 pulls 17 back a slot.
func TestRemoveMidChain() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 100)
	Put[int, int](m, 9, 900)
	Put[int, int](m, 17, 1700)
	if !Remove[int, int](m, 9) { return fail("remove 9 should succeed") }
	if Has[int, int](m, 9) { return fail("9 should be gone") }
	if !Has[int, int](m, 1) { return fail("1 should survive") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 17)
	if !ok || v != 1700 { return fail("17 should survive the mid-chain shift") }
	return ""
}

// Backward-shift across the cap boundary: keys 7, 15, 23 collide at slot 7, so the
// chain wraps to slots 0 and 1. Removing the head must shift correctly across the
// wrap — the case a mis-anchored move condition corrupts.
func TestRemoveWraparound() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 7, 70)
	Put[int, int](m, 15, 150)
	Put[int, int](m, 23, 230)
	if !Remove[int, int](m, 7) { return fail("remove 7 should succeed") }
	if Has[int, int](m, 7) { return fail("7 should be gone") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 15)
	if !ok || v != 150 { return fail("15 should survive the wraparound shift") }
	v, ok = Get[int, int](m, 23)
	if !ok || v != 230 { return fail("23 should survive the wraparound shift") }
	if Len[int, int](m) != 2 { return fail("len should be 2") }
	return ""
}

// After a removal, the freed slot is reusable: reinserting a colliding key works
// and leaves the whole chain consistent.
func TestDeleteThenReinsert() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 100)
	Put[int, int](m, 9, 900)
	Put[int, int](m, 17, 1700)
	Remove[int, int](m, 9)
	Put[int, int](m, 9, 999)
	if Len[int, int](m) != 3 { return fail("len should be 3 after reinsert") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 9)
	if !ok || v != 999 { return fail("reinserted 9 should map to 999") }
	if !Has[int, int](m, 1) || !Has[int, int](m, 17) { return fail("chain corrupted after reinsert") }
	return ""
}

// The cursor visits every live entry exactly once (order unspecified).
func TestCursor() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 10)
	Put[int, int](m, 2, 20)
	Put[int, int](m, 3, 30)
	var it Cursor[int, int] = Iter[int, int](m)
	var keySum int = 0
	var valSum int = 0
	var count int = 0
	for {
		k, v, more := Next[int, int](&it)
		if !more { break }
		keySum = keySum + k
		valSum = valSum + v
		count = count + 1
	}
	if count != 3 { return fail("cursor should visit 3 entries") }
	if keySum != 6 { return fail("cursor key sum wrong") }
	if valSum != 60 { return fail("cursor value sum wrong") }
	return ""
}

// A cursor over an empty map yields nothing.
func TestCursorEmpty() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	var it Cursor[int, int] = Iter[int, int](m)
	k, v, more := Next[int, int](&it)
	if more { return fail("empty cursor should yield false immediately") }
	if k != 0 || v != 0 { return fail("exhausted cursor should yield zero values") }
	return ""
}

// Overwriting a managed value releases the old one and stores the new (exercises
// the vals[i] = val overwrite path for a reference-counted V).
func TestManagedValueOverwrite() testing.TestResult {
	var m @Map[int, @cell] = New[int, @cell]()
	Put[int, @cell](m, 5, makeCell(1))
	Put[int, @cell](m, 5, makeCell(2))
	if Len[int, @cell](m) != 1 { return fail("overwrite should not change len") }
	var g @cell
	var ok bool
	g, ok = Get[int, @cell](m, 5)
	if !ok || g.v != 2 { return fail("managed overwrite should update the value") }
	return ""
}

// Backward-shift with managed values: removing the head of a collision chain moves
// the surviving @cell values back a slot and releases the removed one.
func TestManagedValueBackwardShift() testing.TestResult {
	var m @Map[int, @cell] = New[int, @cell]()
	Put[int, @cell](m, 1, makeCell(100))
	Put[int, @cell](m, 9, makeCell(900))
	Put[int, @cell](m, 17, makeCell(1700))
	if !Remove[int, @cell](m, 1) { return fail("remove 1 should succeed") }
	if Len[int, @cell](m) != 2 { return fail("len should be 2") }
	var g @cell
	var ok bool
	g, ok = Get[int, @cell](m, 9)
	if !ok || g.v != 900 { return fail("9 -> 900 should survive the shift") }
	g, ok = Get[int, @cell](m, 17)
	if !ok || g.v != 1700 { return fail("17 -> 1700 should survive the shift") }
	return ""
}

// Backward-shift with keys carrying managed contents: removing the head of a
// collision chain moves the surviving mkey values (each retaining its @cell field)
// back a slot and releases the removed one; lookups (with freshly constructed
// equal keys) still find the survivors.
func TestManagedKeyBackwardShift() testing.TestResult {
	var m @Map[mkey, int] = New[mkey, int]()
	Put[mkey, int](m, makeKey(1), 100)
	Put[mkey, int](m, makeKey(9), 900)
	Put[mkey, int](m, makeKey(17), 1700)
	if !Remove[mkey, int](m, makeKey(1)) { return fail("remove key 1 should succeed") }
	if Has[mkey, int](m, makeKey(1)) { return fail("key 1 should be gone") }
	var v int
	var ok bool
	v, ok = Get[mkey, int](m, makeKey(9))
	if !ok || v != 900 { return fail("key 9 should survive the shift") }
	v, ok = Get[mkey, int](m, makeKey(17))
	if !ok || v != 1700 { return fail("key 17 should survive the shift") }
	if Len[mkey, int](m) != 2 { return fail("len should be 2") }
	return ""
}

// Removing every entry drains the map to empty (count back to 0), and the drained
// table is then reusable — guards against count underflow / stale-used corruption.
func TestRemoveAllThenReuse() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	Put[int, int](m, 1, 10)
	Put[int, int](m, 2, 20)
	Put[int, int](m, 3, 30)
	Remove[int, int](m, 1)
	Remove[int, int](m, 2)
	Remove[int, int](m, 3)
	if Len[int, int](m) != 0 { return fail("map should be empty after removing all") }
	if Has[int, int](m, 1) || Has[int, int](m, 2) || Has[int, int](m, 3) {
		return fail("no key should remain")
	}
	Put[int, int](m, 5, 50)
	if Len[int, int](m) != 1 { return fail("reused map should have 1 entry") }
	var v int
	var ok bool
	v, ok = Get[int, int](m, 5)
	if !ok || v != 50 { return fail("reused map should return 50") }
	return ""
}

// The cursor visits exactly the survivors when removals have left holes mid-range.
func TestCursorWithHoles() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	for i := 1; i <= 6; i++ {
		Put[int, int](m, i, i * 10)
	}
	Remove[int, int](m, 2)
	Remove[int, int](m, 5)
	// Survivors: 1, 3, 4, 6.
	var it Cursor[int, int] = Iter[int, int](m)
	var keySum int = 0
	var count int = 0
	for {
		k, v, more := Next[int, int](&it)
		if !more { break }
		if v != k * 10 { return fail("cursor entry value mismatch") }
		keySum = keySum + k
		count = count + 1
	}
	if count != 4 { return fail("cursor should visit 4 survivors") }
	if keySum != 14 { return fail("survivor key sum should be 1+3+4+6=14") }
	return ""
}

// Growth rehashes an entire collision chain: 7 keys all colliding at slot 1 (mod 8)
// force a grow on the 7th insert; every key must survive the re-probe into the
// resized table.
func TestGrowPreservesCollisionChain() testing.TestResult {
	var m @Map[int, int] = New[int, int]()
	var keys @[]int = @[]int{1, 9, 17, 25, 33, 41, 49}
	for i := 0; i < len(keys); i++ {
		Put[int, int](m, keys[i], keys[i] * 100)
	}
	if Len[int, int](m) != 7 { return fail("expected 7 entries after grow") }
	for i := 0; i < len(keys); i++ {
		var v int
		var ok bool
		v, ok = Get[int, int](m, keys[i])
		if !ok || v != keys[i] * 100 { return fail("colliding key lost across grow") }
	}
	return ""
}

// Backward-shift across the cap boundary with managed values: keys 7, 15, 23
// collide at slot 7 and wrap to 0, 1, so removing the head shifts the @cell values
// back across the wrap — the highest-risk path (wraparound plus refcount).
func TestManagedValueWraparound() testing.TestResult {
	var m @Map[int, @cell] = New[int, @cell]()
	Put[int, @cell](m, 7, makeCell(70))
	Put[int, @cell](m, 15, makeCell(150))
	Put[int, @cell](m, 23, makeCell(230))
	if !Remove[int, @cell](m, 7) { return fail("remove 7 should succeed") }
	if Has[int, @cell](m, 7) { return fail("7 should be gone") }
	var g @cell
	var ok bool
	g, ok = Get[int, @cell](m, 15)
	if !ok || g.v != 150 { return fail("15 should survive the wraparound shift") }
	g, ok = Get[int, @cell](m, 23)
	if !ok || g.v != 230 { return fail("23 should survive the wraparound shift") }
	if Len[int, @cell](m) != 2 { return fail("len should be 2") }
	return ""
}
