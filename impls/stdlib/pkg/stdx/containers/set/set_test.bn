package "pkg/stdx/containers/set"

import "pkg/builtins/lang"
import "pkg/builtins/testing"
import "pkg/stdx/containers/iter"

func fail(msg @[]char) testing.TestResult { return msg }

// cell is the managed field type carried by mcell.
type cell struct {
	v int
}

// mcell is a member type carrying a managed field (ref); its Hash/Compare use only
// the int field k (so members with k colliding mod cap form a controllable probe
// chain), while the @cell field makes @[]mcell element moves refcount — exercising
// the retain/release paths for a member with managed contents in backward-shift
// deletion.
type mcell struct {
	k   int
	ref @cell
}

func (a mcell) Hash() uint { return cast(uint, a.k) }

func (a mcell) Compare(b mcell) int {
	if a.k < b.k { return -1 }
	if a.k > b.k { return 1 }
	return 0
}

impl mcell : lang.Hashable

func makeMcell(x int) mcell {
	var m mcell
	m.k = x
	m.ref = make(cell)
	return m
}

// Add then Has reports membership; Len tracks the member count.
func TestAddHasLen() testing.TestResult {
	var s @Set[int] = New[int]()
	if s.Len() != 0 { return fail("new set should be empty") }
	s.Add(10)
	s.Add(20)
	s.Add(30)
	if s.Len() != 3 { return fail("expected len 3") }
	if !s.Has(20) { return fail("20 should be present") }
	if s.Has(99) { return fail("99 should be absent") }
	return ""
}

// Add returns true on a genuine insert and false (leaving the set unchanged) when
// the member is already present.
func TestAddReturnsNewness() testing.TestResult {
	var s @Set[int] = New[int]()
	if !s.Add(7) { return fail("first add should be true") }
	if s.Add(7) { return fail("second add of same member should be false") }
	if s.Len() != 1 { return fail("duplicate add should not change len") }
	return ""
}

// Remove deletes a member and reports true; the member is then absent and Len drops.
func TestRemoveBasic() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	s.Add(2)
	if !s.Remove(1) { return fail("remove of present member should be true") }
	if s.Has(1) { return fail("1 should be gone") }
	if s.Len() != 1 { return fail("len should be 1 after remove") }
	if !s.Has(2) { return fail("2 should remain") }
	return ""
}

// Removing an absent member returns false and changes nothing.
func TestRemoveMissing() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	if s.Remove(99) { return fail("remove of absent member should be false") }
	if s.Len() != 1 { return fail("len should be unchanged") }
	return ""
}

// Inserting many members triggers growth; every member stays present.
func TestGrowth() testing.TestResult {
	var s @Set[int] = New[int]()
	for i := 0; i < 100; i++ {
		s.Add(i)
	}
	if s.Len() != 100 { return fail("expected len 100") }
	for i := 0; i < 100; i++ {
		if !s.Has(i) { return fail("member lost after growth") }
	}
	return ""
}

// Backward-shift, head of chain: 1, 9, 17 collide at slot 1 (identity hash, cap 8).
// Removing the head shifts the chain back; the survivors stay present.
func TestRemoveBackwardShiftHead() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	s.Add(9)
	s.Add(17)
	if !s.Remove(1) { return fail("remove 1 should succeed") }
	if s.Has(1) { return fail("1 should be gone") }
	if !s.Has(9) || !s.Has(17) { return fail("9 and 17 should survive the shift") }
	if s.Len() != 2 { return fail("len should be 2") }
	return ""
}

// Backward-shift, middle of chain: removing 9 from 1,9,17 pulls 17 back a slot.
func TestRemoveMidChain() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	s.Add(9)
	s.Add(17)
	if !s.Remove(9) { return fail("remove 9 should succeed") }
	if s.Has(9) { return fail("9 should be gone") }
	if !s.Has(1) || !s.Has(17) { return fail("1 and 17 should survive") }
	return ""
}

// Backward-shift across the cap boundary: 7, 15, 23 collide at slot 7 and wrap to
// 0, 1. Removing the head must shift correctly across the wrap.
func TestRemoveWraparound() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(7)
	s.Add(15)
	s.Add(23)
	if !s.Remove(7) { return fail("remove 7 should succeed") }
	if s.Has(7) { return fail("7 should be gone") }
	if !s.Has(15) || !s.Has(23) {
		return fail("15 and 23 should survive the wraparound shift")
	}
	if s.Len() != 2 { return fail("len should be 2") }
	return ""
}

// After a removal, the freed slot is reusable: re-adding a colliding member works
// and leaves the whole chain consistent.
func TestDeleteThenReinsert() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	s.Add(9)
	s.Add(17)
	s.Remove(9)
	if !s.Add(9) { return fail("re-adding removed member should be a genuine insert") }
	if s.Len() != 3 { return fail("len should be 3 after reinsert") }
	if !s.Has(1) || !s.Has(9) || !s.Has(17) {
		return fail("chain corrupted after reinsert")
	}
	return ""
}

// Removing every member drains the set to empty (count back to 0), and the drained
// table is then reusable.
func TestRemoveAllThenReuse() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	s.Add(2)
	s.Add(3)
	s.Remove(1)
	s.Remove(2)
	s.Remove(3)
	if s.Len() != 0 { return fail("set should be empty after removing all") }
	if s.Has(1) || s.Has(2) || s.Has(3) { return fail("no member should remain") }
	s.Add(5)
	if s.Len() != 1 { return fail("reused set should have 1 member") }
	if !s.Has(5) { return fail("reused set should contain 5") }
	return ""
}

// The cursor visits every member exactly once (order unspecified).
func TestCursor() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(1)
	s.Add(2)
	s.Add(3)
	var it Cursor[int] = s.Iter()
	var sum int = 0
	var count int = 0
	for {
		x, more := it.Next()
		if !more { break }
		sum = sum + x
		count = count + 1
	}
	if count != 3 { return fail("cursor should visit 3 members") }
	if sum != 6 { return fail("cursor sum wrong") }
	return ""
}

// A *Cursor[int] satisfies iter.Iterator[int]: a managed cursor boxes into a
// managed interface value and iteration is driven through the vtable, visiting the
// same members as the concrete Cursor path.
func TestCursorAsIterator() testing.TestResult {
	var s @Set[int] = New[int]()
	s.Add(4)
	s.Add(5)
	s.Add(6)
	var c @Cursor[int] = make(Cursor[int])
	c.s = s
	c.i = 0
	var it @iter.Iterator[int] = c
	var sum int = 0
	var count int = 0
	for {
		x, ok := it.Next()
		if !ok { break }
		sum = sum + x
		count = count + 1
	}
	if count != 3 { return fail("iterator interface should visit 3 members") }
	if sum != 15 { return fail("iterator interface sum wrong") }
	return ""
}

// A cursor over an empty set yields nothing.
func TestCursorEmpty() testing.TestResult {
	var s @Set[int] = New[int]()
	var it Cursor[int] = s.Iter()
	x, more := it.Next()
	if more { return fail("empty cursor should yield false immediately") }
	if x != 0 { return fail("exhausted cursor should yield the zero value") }
	return ""
}

// The cursor visits exactly the survivors when removals have left holes mid-range.
func TestCursorWithHoles() testing.TestResult {
	var s @Set[int] = New[int]()
	for i := 1; i <= 6; i++ {
		s.Add(i)
	}
	s.Remove(2)
	s.Remove(5)
	// Survivors: 1, 3, 4, 6.
	var it Cursor[int] = s.Iter()
	var sum int = 0
	var count int = 0
	for {
		x, more := it.Next()
		if !more { break }
		sum = sum + x
		count = count + 1
	}
	if count != 4 { return fail("cursor should visit 4 survivors") }
	if sum != 14 { return fail("survivor sum should be 1+3+4+6=14") }
	return ""
}

// Growth rehashes an entire collision chain: 7 members all colliding at slot 1
// (mod 8) force a grow on the 7th insert; every member must survive the re-probe.
func TestGrowPreservesCollisionChain() testing.TestResult {
	var s @Set[int] = New[int]()
	var members @[]int = @[]int{1, 9, 17, 25, 33, 41, 49}
	for i := 0; i < len(members); i++ {
		s.Add(members[i])
	}
	if s.Len() != 7 { return fail("expected 7 members after grow") }
	for i := 0; i < len(members); i++ {
		if !s.Has(members[i]) { return fail("colliding member lost across grow") }
	}
	return ""
}

// Backward-shift with members carrying managed contents: removing the head of a
// collision chain moves the surviving mcell values (each retaining its @cell field)
// back a slot and releases the removed one; membership (with freshly constructed
// equal members) still holds for the survivors.
func TestManagedBackwardShift() testing.TestResult {
	var s @Set[mcell] = New[mcell]()
	s.Add(makeMcell(1))
	s.Add(makeMcell(9))
	s.Add(makeMcell(17))
	if !s.Remove(makeMcell(1)) { return fail("remove member 1 should succeed") }
	if s.Has(makeMcell(1)) { return fail("member 1 should be gone") }
	if !s.Has(makeMcell(9)) || !s.Has(makeMcell(17)) {
		return fail("members 9 and 17 should survive the shift")
	}
	if s.Len() != 2 { return fail("len should be 2") }
	return ""
}

// Backward-shift across the cap boundary with members carrying managed contents:
// 7, 15, 23 collide at slot 7 and wrap to 0, 1, so removing the head shifts the
// mcell values back across the wrap — the highest-risk path (wraparound + refcount).
func TestManagedWraparound() testing.TestResult {
	var s @Set[mcell] = New[mcell]()
	s.Add(makeMcell(7))
	s.Add(makeMcell(15))
	s.Add(makeMcell(23))
	if !s.Remove(makeMcell(7)) { return fail("remove member 7 should succeed") }
	if s.Has(makeMcell(7)) { return fail("member 7 should be gone") }
	if !s.Has(makeMcell(15)) || !s.Has(makeMcell(23)) {
		return fail("members 15 and 23 should survive the wraparound shift")
	}
	if s.Len() != 2 { return fail("len should be 2") }
	return ""
}

// Re-adding an existing member at the grow threshold neither grows nor double-
// inserts: Add returns false and the count/membership are unchanged, guarding the
// "grows only on a genuine insert" invariant at the boundary.
func TestAddDuplicateAtBoundary() testing.TestResult {
	var s @Set[int] = New[int]()
	// Fill to 6 members — count 6 is the last count before a grow at cap 8.
	for i := 0; i < 6; i++ {
		s.Add(i)
	}
	if s.Len() != 6 { return fail("expected 6 members") }
	if s.Add(3) { return fail("re-adding an existing member should return false") }
	if s.Len() != 6 { return fail("duplicate add at boundary should not change len") }
	for i := 0; i < 6; i++ {
		if !s.Has(i) { return fail("all members should still be present") }
	}
	return ""
}

// Backward-shift, middle of chain, with members carrying managed contents: removing
// 9 from the mcell chain 1, 9, 17 pulls 17 back a slot (a managed struct-copy in
// the i < j branch); the survivors' membership still holds.
func TestManagedMidChain() testing.TestResult {
	var s @Set[mcell] = New[mcell]()
	s.Add(makeMcell(1))
	s.Add(makeMcell(9))
	s.Add(makeMcell(17))
	if !s.Remove(makeMcell(9)) { return fail("remove member 9 should succeed") }
	if s.Has(makeMcell(9)) { return fail("member 9 should be gone") }
	if !s.Has(makeMcell(1)) || !s.Has(makeMcell(17)) {
		return fail("members 1 and 17 should survive the mid-chain shift")
	}
	if s.Len() != 2 { return fail("len should be 2") }
	return ""
}
