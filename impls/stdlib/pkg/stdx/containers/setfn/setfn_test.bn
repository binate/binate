package "pkg/stdx/containers/setfn"

import "pkg/builtins/testing"
import "pkg/stdx/containers/iter"

func fail(msg @[]char) testing.TestResult { return msg }

func byteSum(s @[]char) uint {
	var acc uint = 0
	for i := 0; i < len(s); i = i + 1 {
		acc = acc + cast(uint, s[i])
	}
	return acc
}

func byteEq(a @[]char, b @[]char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i = i + 1 {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

func mk3(a char, b char, c char) @[]char {
	var r @[]char = make_slice(char, 3)
	r[0] = a
	r[1] = b
	r[2] = c
	return r
}

func TestAddHasRemove() testing.TestResult {
	var s @SetFn[@[]char] = NewSetFn[@[]char](byteSum, byteEq)
	if !s.Add(mk3('c', 'a', 't')) {
		return fail("Add of a new element should return true")
	}
	if !s.Add(mk3('d', 'o', 'g')) {
		return fail("Add of a new element should return true")
	}
	if s.Add(mk3('c', 'a', 't')) {
		return fail("Add of a present element should return false")
	}
	if s.Len() != 2 {
		return fail("adding a duplicate should keep len 2")
	}
	if !s.Has(mk3('c', 'a', 't')) {
		return fail("expected Has(cat)")
	}
	if s.Has(mk3('z', 'z', 'z')) {
		return fail("zzz should be absent")
	}
	if !s.Remove(mk3('c', 'a', 't')) {
		return fail("Remove(cat) should be true")
	}
	if s.Has(mk3('c', 'a', 't')) {
		return fail("cat should be gone")
	}
	if s.Len() != 1 {
		return fail("expected len 1")
	}
	if s.Remove(mk3('c', 'a', 't')) {
		return fail("removing an absent element should be false")
	}
	return ""
}

func firstCharHash(s @[]char) uint {
	if len(s) == 0 {
		return 0
	}
	return cast(uint, s[0])
}

func firstCharEq(a @[]char, b @[]char) bool {
	if len(a) == 0 || len(b) == 0 {
		return len(a) == len(b)
	}
	return a[0] == b[0]
}

// A first-char equality proves the injected eq drives membership: "cat" and "cow" are
// the same element, and growth preserves membership.
func TestInjectedEqCollapses() testing.TestResult {
	var s @SetFn[@[]char] = NewSetFn[@[]char](firstCharHash, firstCharEq)
	s.Add(mk3('c', 'a', 't'))
	s.Add(mk3('c', 'o', 'w'))
	if s.Len() != 1 {
		return fail("first-char eq should treat c* as one element")
	}
	if !s.Has(mk3('c', 'u', 'p')) {
		return fail("any c* should be present")
	}
	return ""
}

// Growth (past the 75% load factor) preserves every element.
func TestGrowth() testing.TestResult {
	var s @SetFn[@[]char] = NewSetFn[@[]char](byteSum, byteEq)
	s.Add(mk3('a', 'a', 'a'))
	s.Add(mk3('b', 'b', 'b'))
	s.Add(mk3('c', 'c', 'c'))
	s.Add(mk3('d', 'd', 'd'))
	s.Add(mk3('e', 'e', 'e'))
	s.Add(mk3('f', 'f', 'f'))
	s.Add(mk3('g', 'g', 'g'))
	if s.Len() != 7 {
		return fail("expected len 7 after growth")
	}
	if !s.Has(mk3('a', 'a', 'a')) || !s.Has(mk3('g', 'g', 'g')) {
		return fail("growth should preserve every element")
	}
	return ""
}

// The value cursor (Iter/Next, a projecting SetCursor over the table cursor) visits every
// element exactly once, yielding the bare element rather than an Entry.  Byte-sum keys are
// spread so growth is exercised, and the sum-of-first-bytes pins that each is seen once.
func TestValueCursor() testing.TestResult {
	var s @SetFn[@[]char] = NewSetFn[@[]char](byteSum, byteEq)
	s.Add(mk3('a', 'a', 'a'))
	s.Add(mk3('b', 'b', 'b'))
	s.Add(mk3('c', 'c', 'c'))
	var seen int = 0
	var firstByteSum int = 0
	var it SetCursor[@[]char] = s.Iter()
	for {
		var e @[]char
		var ok bool
		e, ok = it.Next()
		if !ok {
			break
		}
		seen = seen + 1
		firstByteSum = firstByteSum + cast(int, e[0])
	}
	if seen != 3 {
		return fail("the value cursor should visit 3 elements")
	}
	if firstByteSum != cast(int, 'a') + cast(int, 'b') + cast(int, 'c') {
		return fail("the value cursor visited elements incorrectly")
	}
	return ""
}

// The boxed iterator (AsIterator / iter.Iterable) visits every element, and an empty set's
// iterator yields nothing.  Growth (7 elements past the 75% load factor) is exercised too.
func TestBoxedIterator() testing.TestResult {
	var empty @SetFn[@[]char] = NewSetFn[@[]char](byteSum, byteEq)
	var it0 @iter.Iterator[@[]char] = empty.AsIterator()
	var junk @[]char
	var ok0 bool
	junk, ok0 = it0.Next()
	if ok0 {
		return fail("an empty set's iterator should yield nothing")
	}
	var s @SetFn[@[]char] = NewSetFn[@[]char](byteSum, byteEq)
	s.Add(mk3('a', 'a', 'a'))
	s.Add(mk3('b', 'b', 'b'))
	s.Add(mk3('c', 'c', 'c'))
	s.Add(mk3('d', 'd', 'd'))
	s.Add(mk3('e', 'e', 'e'))
	s.Add(mk3('f', 'f', 'f'))
	s.Add(mk3('g', 'g', 'g'))
	var it @iter.Iterator[@[]char] = s.AsIterator()
	var seen int = 0
	var firstByteSum int = 0
	for {
		var e @[]char
		var ok bool
		e, ok = it.Next()
		if !ok {
			break
		}
		seen = seen + 1
		firstByteSum = firstByteSum + cast(int, e[0])
	}
	if seen != 7 {
		return fail("the boxed iterator should visit 7 elements")
	}
	var want int = cast(int, 'a') + cast(int, 'b') + cast(int, 'c') + cast(int, 'd') + cast(int, 'e') +
			cast(int, 'f') + cast(int, 'g')
	if firstByteSum != want {
		return fail("the boxed iterator visited elements incorrectly")
	}
	return ""
}

// Three DISTINCT elements with EQUAL byte-sums ('abc'/'bca'/'cab' all sum 294) force the
// injected-fn probe-past AND drive a backward-shift Remove through the fn path.
func TestFnRemoveCollision() testing.TestResult {
	var s @SetFn[@[]char] = NewSetFn[@[]char](byteSum, byteEq)
	if !s.Add(mk3('a', 'b', 'c')) {
		return fail("abc is new")
	}
	if !s.Add(mk3('b', 'c', 'a')) {
		return fail("bca is new (distinct from abc)")
	}
	if !s.Add(mk3('c', 'a', 'b')) {
		return fail("cab is new")
	}
	if s.Len() != 3 {
		return fail("three distinct equal-hash elements should all be present")
	}
	if !s.Remove(mk3('b', 'c', 'a')) {
		return fail("Remove of the middle chain element should succeed")
	}
	if s.Has(mk3('b', 'c', 'a')) {
		return fail("bca should be gone")
	}
	if !s.Has(mk3('a', 'b', 'c')) || !s.Has(mk3('c', 'a', 'b')) {
		return fail("abc and cab must survive the backward-shift")
	}
	if s.Len() != 2 {
		return fail("expected len 2")
	}
	return ""
}
