package "pkg/stdx/containers/vec"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// cell is a managed element type used to exercise the retain/release paths (growth
// copy, Pop slot-clear) for a reference-counted T.
type cell struct {
	v int
}

// New starts empty; Push/Get/Len track appended elements in order.
func TestPushGetLen() testing.TestResult {
	var v @Vec[int] = New[int]()
	if Len[int](v) != 0 { return fail("new vec should be empty") }
	Push[int](v, 10)
	Push[int](v, 20)
	Push[int](v, 30)
	if Len[int](v) != 3 { return fail("expected len 3") }
	if Get[int](v, 0) != 10 || Get[int](v, 1) != 20 || Get[int](v, 2) != 30 {
		return fail("wrong element order")
	}
	return ""
}

// Set replaces an element in place without changing the length.
func TestSet() testing.TestResult {
	var v @Vec[int] = New[int]()
	Push[int](v, 1)
	Push[int](v, 2)
	Set[int](v, 0, 99)
	if Get[int](v, 0) != 99 || Get[int](v, 1) != 2 { return fail("set wrong") }
	if Len[int](v) != 2 { return fail("set changed length") }
	return ""
}

// Push past the 4-element floor grows the backing (doubling) while preserving
// every element and their order; Cap tracks at least the live count.
func TestGrowthPreservesElements() testing.TestResult {
	var v @Vec[int] = New[int]()
	for i := 0; i < 100; i++ {
		Push[int](v, i * i)
	}
	if Len[int](v) != 100 { return fail("expected len 100") }
	if Cap[int](v) < 100 { return fail("cap should be >= len") }
	for i := 0; i < 100; i++ {
		if Get[int](v, i) != i * i { return fail("element corrupted after growth") }
	}
	return ""
}

// Pop returns elements LIFO, clears the slot, and reports false on an empty Vec.
func TestPop() testing.TestResult {
	var v @Vec[int] = New[int]()
	var x int
	var ok bool
	x, ok = Pop[int](v)
	if ok { return fail("pop on empty should be false") }
	Push[int](v, 5)
	Push[int](v, 6)
	x, ok = Pop[int](v)
	if !ok || x != 6 { return fail("expected 6") }
	x, ok = Pop[int](v)
	if !ok || x != 5 { return fail("expected 5") }
	if Len[int](v) != 0 { return fail("expected empty after popping all") }
	x, ok = Pop[int](v)
	if ok { return fail("pop on drained should be false") }
	return ""
}

// Items exposes a live view; writing through it mutates the Vec.
func TestItemsView() testing.TestResult {
	var v @Vec[int] = New[int]()
	Push[int](v, 1)
	Push[int](v, 2)
	Push[int](v, 3)
	var s @[]int = Items[int](v)
	if len(s) != 3 { return fail("items length") }
	s[1] = 42
	if Get[int](v, 1) != 42 { return fail("items should write through") }
	return ""
}

// Iter/Next visit every live element in order, then report exhaustion.
func TestCursor() testing.TestResult {
	var v @Vec[int] = New[int]()
	Push[int](v, 7)
	Push[int](v, 8)
	Push[int](v, 9)
	var it Cursor[int] = Iter[int](v)
	var sum int = 0
	var count int = 0
	for {
		x, ok := Next[int](&it)
		if !ok { break }
		sum = sum + x
		count = count + 1
	}
	if count != 3 { return fail("cursor should visit 3 elements") }
	if sum != 24 { return fail("cursor sum wrong") }
	return ""
}

// A cursor over an empty Vec yields nothing.
func TestCursorEmpty() testing.TestResult {
	var v @Vec[int] = New[int]()
	var it Cursor[int] = Iter[int](v)
	x, ok := Next[int](&it)
	if ok { return fail("empty cursor should yield false immediately") }
	if x != 0 { return fail("exhausted cursor should yield the zero value") }
	return ""
}

// Vec works with a managed element type: Push/Get/Pop over @cell exercises the
// retain/release paths for a reference-counted T (no leak, no use-after-free).
func TestManagedElements() testing.TestResult {
	var v @Vec[@cell] = New[@cell]()
	for i := 0; i < 10; i++ {
		var b @cell = make(cell)
		b.v = i
		Push[@cell](v, b)
	}
	if Len[@cell](v) != 10 { return fail("expected 10 cells") }
	var got @cell = Get[@cell](v, 4)
	if got.v != 4 { return fail("wrong cell value") }
	var popped @cell
	var ok bool
	popped, ok = Pop[@cell](v)
	if !ok || popped.v != 9 { return fail("expected cell 9") }
	if Len[@cell](v) != 9 { return fail("expected 9 after pop") }
	return ""
}

// A cursor keeps working across a growing Push: it holds the Vec (not a snapshot
// of the backing), so Next re-reads the current backing and the live length —
// reading the reallocated backing correctly, and seeing elements pushed after the
// cursor was created. (Guards against a future "snapshot the slice" change that
// would silently read the freed old backing.)
func TestCursorSurvivesGrowth() testing.TestResult {
	var v @Vec[int] = New[int]()
	for i := 0; i < 3; i++ {
		Push[int](v, i)
	}
	var it Cursor[int] = Iter[int](v)
	first, ok := Next[int](&it)
	if !ok || first != 0 { return fail("expected first element 0") }
	// Force reallocation well past the original 4-element backing.
	for i := 3; i < 20; i++ {
		Push[int](v, i)
	}
	if Cap[int](v) <= 4 { return fail("expected the vec to have grown past cap 4") }
	// The cursor should now walk indices 1..19 on the NEW backing, values intact.
	var next int = 1
	for {
		x, more := Next[int](&it)
		if !more { break }
		if x != next { return fail("cursor read wrong value after growth") }
		next = next + 1
	}
	if next != 20 { return fail("cursor should have visited through index 19") }
	return ""
}

// Cap starts at 0 and grows 0 -> 4 -> 8 -> 16 (doubling from a 4-element floor),
// never silently staying at 0 or growing by 1. Only Cap >= Len (as other tests
// check) would still pass under a broken growth policy, so pin the exact values.
func TestCapGrowthSequence() testing.TestResult {
	var v @Vec[int] = New[int]()
	if Cap[int](v) != 0 { return fail("new cap should be 0") }
	Push[int](v, 0)
	if Cap[int](v) != 4 { return fail("cap should be 4 after 1st push") }
	Push[int](v, 1)
	Push[int](v, 2)
	Push[int](v, 3)
	if Cap[int](v) != 4 { return fail("cap should still be 4 at 4 elements") }
	Push[int](v, 4)
	if Cap[int](v) != 8 { return fail("cap should be 8 after 5th push") }
	Push[int](v, 5)
	Push[int](v, 6)
	Push[int](v, 7)
	if Cap[int](v) != 8 { return fail("cap should still be 8 at 8 elements") }
	Push[int](v, 8)
	if Cap[int](v) != 16 { return fail("cap should be 16 after 9th push") }
	if Len[int](v) != 9 { return fail("len should be 9") }
	return ""
}

// Items returns a view sharing the current backing; after a growing Push the old
// view remains valid (stale) memory — never dangling — because the managed-slice
// retains that backing. A fresh Items reflects the grown Vec.
func TestItemsStaleAfterGrowth() testing.TestResult {
	var v @Vec[int] = New[int]()
	Push[int](v, 10)
	Push[int](v, 20)
	var oldView @[]int = Items[int](v)
	if len(oldView) != 2 { return fail("old view length") }
	for i := 0; i < 20; i++ {
		Push[int](v, i)
	}
	// The old view still points at the old backing: valid, unchanged content.
	if len(oldView) != 2 { return fail("old view length changed") }
	if oldView[0] != 10 || oldView[1] != 20 { return fail("old view content corrupted") }
	// A fresh view reflects the grown Vec.
	var newView @[]int = Items[int](v)
	if len(newView) != 22 { return fail("new view should have 22 elements") }
	if newView[0] != 10 || newView[1] != 20 { return fail("new view head wrong") }
	return ""
}
