package "pkg/stdx/flags"

import "pkg/std/strings"
import "pkg/stdx/slices"

// Flag.kind tags — which destination pointer a Flag drives.
const (
	kindBool int = 0
	kindString int = 1
	kindInt int = 2
	kindUint int = 3
	kindList int = 4
	kindListSep int = 5
)

// ---- construction / registration -----------------------------------

// New returns an empty FlagSet labeled name (used only by Usage()).
func New(name @[]readonly char) @FlagSet {
	var fs @FlagSet = make(FlagSet)
	fs.name = name
	return fs
}

// addFlag records f on fs.
func addFlag(fs @FlagSet, f Flag) {
	fs.flags = slices.Append[Flag](fs.flags, f)
}

// BoolVar registers a boolean flag bound to *p.
func (fs @FlagSet) BoolVar(p *bool, name @[]readonly char, alias @[]readonly char,
		usage @[]readonly char) {
	var f Flag
	f.name = name
	f.alias = alias
	f.usage = usage
	f.kind = kindBool
	f.pbool = p
	addFlag(fs, f)
}

// StringVar registers a string flag bound to *p, defaulting to def (shared in).
func (fs @FlagSet) StringVar(p *@[]char, name @[]readonly char, alias @[]readonly char, def @[]char,
		usage @[]readonly char) {
	*p = def
	var f Flag
	f.name = name
	f.alias = alias
	f.usage = usage
	f.kind = kindString
	f.pstr = p
	addFlag(fs, f)
}

// IntVar registers a signed-decimal flag bound to *p, defaulting to def.
func (fs @FlagSet) IntVar(p *int, name @[]readonly char, alias @[]readonly char, def int,
		usage @[]readonly char) {
	*p = def
	var f Flag
	f.name = name
	f.alias = alias
	f.usage = usage
	f.kind = kindInt
	f.pint = p
	addFlag(fs, f)
}

// UintVar registers an unsigned-decimal flag bound to *p, defaulting to def.
func (fs @FlagSet) UintVar(p *uint, name @[]readonly char, alias @[]readonly char, def uint,
		usage @[]readonly char) {
	*p = def
	var f Flag
	f.name = name
	f.alias = alias
	f.usage = usage
	f.kind = kindUint
	f.puint = p
	addFlag(fs, f)
}

// StringListVar registers a repeatable string flag; each occurrence appends to *p.
func (fs @FlagSet) StringListVar(p *@[]@[]char, name @[]readonly char, alias @[]readonly char,
		usage @[]readonly char) {
	var empty @[]@[]char
	*p = empty // guarantee the "empty list initially" the .bni promises
	var f Flag
	f.name = name
	f.alias = alias
	f.usage = usage
	f.kind = kindList
	f.plist = p
	addFlag(fs, f)
}

// StringListSepVar registers a repeatable string flag whose every occurrence is
// additionally split on sep before each field is appended to *p.
func (fs @FlagSet) StringListSepVar(p *@[]@[]char, name @[]readonly char, alias @[]readonly char,
		sep char, usage @[]readonly char) {
	var empty @[]@[]char
	*p = empty // guarantee the "empty list initially" the .bni promises
	var f Flag
	f.name = name
	f.alias = alias
	f.usage = usage
	f.kind = kindListSep
	f.sep = sep
	f.plist = p
	addFlag(fs, f)
}

// ---- parsing --------------------------------------------------------

// Parse consumes flags from args, stopping at the first positional or `--`, and
// returns (positionals, error-or-"").  See the .bni for the full contract.
func (fs @FlagSet) Parse(args @[]@[]char) (@[]@[]char, @[]readonly char) {
	var rest @[]@[]char
	var i int = 0
	var n int = len(args)
	for i < n {
		var a @[]char = args[i]
		// Stop at the first positional; `--` is consumed, everything else is
		// left in place as the first positional token.
		if len(a) == 0 {
			break
		}
		if a[0] != '-' {
			break
		}
		if len(a) == 1 {
			break // a bare "-" is a positional (conventionally stdin)
		}
		if len(a) == 2 && a[1] == '-' {
			i = i + 1
			break
		}
		// A flag token.
		var name @[]char
		var hasEq bool
		var eqval @[]char
		name, hasEq, eqval = splitFlagTok(a)
		var fi int = findFlag(fs, name)
		if fi < 0 {
			return rest, msg2("unknown flag: ", a)
		}
		var f Flag = fs.flags[fi]
		if f.kind == kindBool {
			if hasEq {
				if !setBool(f.pbool, eqval) {
					return rest, badVal("boolean", a, eqval)
				}
			} else {
				*f.pbool = true
			}
			i = i + 1
		} else {
			var value @[]char
			if hasEq {
				value = eqval
				i = i + 1
			} else {
				if i + 1 >= n {
					return rest, msg2("flag needs a value: ", a)
				}
				value = args[i + 1]
				i = i + 2
			}
			if !applyValue(f, value) {
				return rest, badVal(kindName(f.kind), a, value)
			}
		}
	}
	for ; i < n; i++ {
		rest = slices.Append[@[]char](rest, args[i])
	}
	return rest, ""
}

// splitFlagTok strips a's leading dash(es) and splits an inline `=value`.  It
// returns (name-without-dashes, whether an `=` was present, the value after it)
// as sub-slices of a.  a is a flag token (starts with '-', len >= 2, not "--").
func splitFlagTok(a @[]char) (@[]char, bool, @[]char) {
	var nd int = 1
	if len(a) >= 2 && a[1] == '-' {
		nd = 2
	}
	var eq int = -1
	for i := nd; i < len(a); i++ {
		if a[i] == '=' {
			eq = i
			break
		}
	}
	if eq < 0 {
		var noeq @[]char
		return a[nd:], false, noeq
	}
	return a[nd:eq], true, a[eq + 1:]
}

// findFlag returns the index of the flag matching name (against its primary
// name or its alias), or -1.
func findFlag(fs @FlagSet, name *[]readonly char) int {
	if len(name) == 0 {
		return -1 // an empty name (e.g. from "-=x") matches nothing
	}
	for i := 0; i < len(fs.flags); i++ {
		if streq(fs.flags[i].name, name) {
			return i
		}
		if len(fs.flags[i].alias) > 0 && streq(fs.flags[i].alias, name) {
			return i
		}
	}
	return -1
}

// applyValue stores value into f's bound destination, returning false on a
// malformed number.  Not called for bool flags.
func applyValue(f Flag, value @[]char) bool {
	if f.kind == kindString {
		*f.pstr = value
		return true
	}
	if f.kind == kindInt {
		v, ok := parseIntDec(value)
		if !ok {
			return false
		}
		*f.pint = v
		return true
	}
	if f.kind == kindUint {
		v, ok := parseUintDec(value)
		if !ok {
			return false
		}
		*f.puint = v
		return true
	}
	if f.kind == kindList {
		*f.plist = slices.Append[@[]char](*f.plist, value)
		return true
	}
	// kindListSep
	appendSplit(f.plist, value, f.sep)
	return true
}

// appendSplit appends each sep-delimited, non-empty field of s to *plist (each
// field shares backing with s).
func appendSplit(plist *@[]@[]char, s @[]char, sep char) {
	var start int = 0
	for i := 0; i <= len(s); i++ {
		if i == len(s) || s[i] == sep {
			if i > start {
				*plist = slices.Append[@[]char](*plist, s[start:i])
			}
			start = i + 1
		}
	}
}

// setBool sets *p from an explicit `=value` (true/1 or false/0), returning
// false for anything else.
func setBool(p *bool, s *[]readonly char) bool {
	if streq(s, "true") || streq(s, "1") {
		*p = true
		return true
	}
	if streq(s, "false") || streq(s, "0") {
		*p = false
		return true
	}
	return false
}

// parseIntDec parses an optionally-signed decimal integer, rejecting a bare
// sign, any non-digit, and an out-of-range value.  It accumulates the magnitude
// NEGATIVELY so the most-negative value (which has no positive counterpart) is
// itself representable, matching strconv.  Widths are derived from the target's
// own uint width, so the range check is correct on both ILP32 and LP64.
func parseIntDec(s *[]readonly char) (int, bool) {
	if len(s) == 0 {
		return 0, false
	}
	var i int = 0
	var neg bool = false
	if s[0] == '-' {
		neg = true
		i = 1
	} else if s[0] == '+' {
		i = 1
	}
	if i >= len(s) {
		return 0, false
	}
	var maxU uint = 0
	maxU = maxU - 1 // all-ones = max uint for this target's int width
	var minInt int = -cast(int, maxU >> 1) - 1
	var v int = 0
	for ; i < len(s); i++ {
		var c char = s[i]
		if c < '0' || c > '9' {
			return 0, false
		}
		var d int = cast(int, c - '0')
		if v < minInt / 10 {
			return 0, false // v*10 would underflow past minInt
		}
		v = v * 10
		if v < minInt + d {
			return 0, false // v-d would underflow past minInt
		}
		v = v - d
	}
	if !neg {
		if v == minInt {
			return 0, false // MIN_INT has no positive counterpart
		}
		v = -v
	}
	return v, true
}

// parseUintDec parses an optionally-'+'-signed decimal unsigned integer,
// rejecting a bare sign, any non-digit, a leading '-', and an out-of-range
// value (the max is the target's own uint width).
func parseUintDec(s *[]readonly char) (uint, bool) {
	if len(s) == 0 {
		return 0, false
	}
	var i int = 0
	if s[0] == '+' {
		i = 1
	}
	if i >= len(s) {
		return 0, false
	}
	var maxU uint = 0
	maxU = maxU - 1 // all-ones = max uint for this target
	var v uint = 0
	for ; i < len(s); i++ {
		var c char = s[i]
		if c < '0' || c > '9' {
			return 0, false
		}
		var d uint = cast(uint, c - '0')
		if v > maxU / 10 {
			return 0, false // v*10 would overflow
		}
		v = v * 10
		if v > maxU - d {
			return 0, false // v+d would overflow
		}
		v = v + d
	}
	return v, true
}

// ---- usage / helpers ------------------------------------------------

// Usage renders one line per registered flag under a header naming the program.
func (fs @FlagSet) Usage() @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("usage: ")
	b.Write(fs.name)
	b.Write(" [flags] [args]\n")
	for i := 0; i < len(fs.flags); i++ {
		var f Flag = fs.flags[i]
		b.Write("  ")
		if len(f.alias) > 0 {
			writeDashed(b, f.alias)
			b.Write(", ")
		}
		writeDashed(b, f.name)
		if f.kind != kindBool {
			b.Write(" <value>")
		}
		if len(f.usage) > 0 {
			b.Write("    ")
			b.Write(f.usage)
		}
		b.WriteByte('\n')
	}
	return b.String()
}

// writeDashed writes nm with the conventional dash count: one dash for a
// single-char (short) name, two for a longer one.
func writeDashed(b @strings.Builder, nm *[]readonly char) {
	if len(nm) == 1 {
		b.WriteByte('-')
	} else {
		b.Write("--")
	}
	b.Write(nm)
}

// kindName names f.kind for a value-parse error message.
func kindName(kind int) *[]readonly char {
	if kind == kindInt {
		return "integer"
	}
	if kind == kindUint {
		return "unsigned integer"
	}
	return "value"
}

// msg2 builds `prefix + tok` as an owned message.
func msg2(prefix *[]readonly char, tok @[]char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(prefix)
	b.Write(tok)
	return b.String()
}

// badVal builds `invalid <kind> value "<val>" for <tok>`.
func badVal(kind *[]readonly char, tok @[]char, val @[]char) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("invalid ")
	b.Write(kind)
	b.Write(" value \"")
	b.Write(val)
	b.Write("\" for ")
	b.Write(tok)
	return b.String()
}

// streq reports whether two char slices have identical contents.
func streq(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}
