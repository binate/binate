package "pkg/stdx/flags"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// contains reports whether haystack holds needle as a contiguous substring.
func contains(haystack @[]readonly char, needle *[]readonly char) bool {
	if len(needle) == 0 {
		return true
	}
	if len(haystack) < len(needle) {
		return false
	}
	for i := 0; i <= len(haystack) - len(needle); i++ {
		var match bool = true
		for j := 0; j < len(needle); j++ {
			if haystack[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match {
			return true
		}
	}
	return false
}

// listEq reports whether xs holds exactly the given want entries in order.
func listEq(xs @[]@[]char, want @[]@[]char) bool {
	if len(xs) != len(want) {
		return false
	}
	for i := 0; i < len(xs); i++ {
		if !streq(xs[i], want[i]) {
			return false
		}
	}
	return true
}

// A long flag and a short alias both set their bool destinations.
func TestBoolLongShort() testing.TestResult {
	var debug bool = false
	var verbose bool = false
	var fs @FlagSet = New("t")
	fs.BoolVar(&debug, "debug", "g", "")
	fs.BoolVar(&verbose, "verbose", "v", "")
	_, err := fs.Parse(@[]@[]char{"--debug", "-v"})
	if len(err) > 0 {
		return fail("unexpected error")
	}
	if !debug || !verbose {
		return fail("both bools should be set")
	}
	return ""
}

// Dash-insensitive: a single-dash long spelling matches the same flag.
func TestBoolDashInsensitive() testing.TestResult {
	var debug bool = false
	var fs @FlagSet = New("t")
	fs.BoolVar(&debug, "debug", "g", "")
	_, err := fs.Parse(@[]@[]char{"-debug"})
	if len(err) > 0 || !debug {
		return fail("-debug should set debug")
	}
	return ""
}

// A bool flag left unmentioned keeps its zero value.
func TestBoolUnset() testing.TestResult {
	var debug bool = true
	var fs @FlagSet = New("t")
	fs.BoolVar(&debug, "debug", "g", "")
	// Nothing sets --debug; but note BoolVar does not reset it, so start false.
	debug = false
	_, err := fs.Parse(@[]@[]char{})
	if len(err) > 0 || debug {
		return fail("debug should stay false")
	}
	return ""
}

// A string value given as a separate token.
func TestStringSeparate() testing.TestResult {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, err := fs.Parse(@[]@[]char{"-o", "out.o"})
	if len(err) > 0 || !streq(out, "out.o") {
		return fail("-o out.o should set out")
	}
	return ""
}

// A string value given inline with `=`.
func TestStringEquals() testing.TestResult {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, err := fs.Parse(@[]@[]char{"--output=out.o"})
	if len(err) > 0 || !streq(out, "out.o") {
		return fail("--output=out.o should set out")
	}
	return ""
}

// The registered default applies when the flag is absent.
func TestStringDefault() testing.TestResult {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "def.o", "")
	_, err := fs.Parse(@[]@[]char{})
	if len(err) > 0 || !streq(out, "def.o") {
		return fail("default should be def.o")
	}
	return ""
}

// Signed integers, including a negative value passed as the next token.
func TestIntValid() testing.TestResult {
	var n int = 0
	var fs @FlagSet = New("t")
	fs.IntVar(&n, "num", "n", 0, "")
	_, err := fs.Parse(@[]@[]char{"-n", "42"})
	if len(err) > 0 || n != 42 {
		return fail("-n 42")
	}
	var m int = 0
	var fs2 @FlagSet = New("t")
	fs2.IntVar(&m, "num", "n", 0, "")
	_, err2 := fs2.Parse(@[]@[]char{"-n", "-5"})
	if len(err2) > 0 || m != -5 {
		return fail("-n -5")
	}
	return ""
}

// A non-numeric integer value is a parse error.
func TestIntBad() testing.TestResult {
	var n int = 0
	var fs @FlagSet = New("t")
	fs.IntVar(&n, "num", "n", 0, "")
	_, err := fs.Parse(@[]@[]char{"-n", "x"})
	if len(err) == 0 {
		return fail("-n x should error")
	}
	return ""
}

// Unsigned integer via `=`.
func TestUint() testing.TestResult {
	var c uint = 0
	var fs @FlagSet = New("t")
	fs.UintVar(&c, "count", "", 0, "")
	_, err := fs.Parse(@[]@[]char{"--count=7"})
	if len(err) > 0 || c != 7 {
		return fail("--count=7")
	}
	return ""
}

// A repeated list flag accumulates; a value that looks like a flag (-O2) is
// still consumed literally.
func TestList() testing.TestResult {
	var cflags @[]@[]char
	var fs @FlagSet = New("t")
	fs.StringListVar(&cflags, "cflag", "", "")
	_, err := fs.Parse(@[]@[]char{"--cflag", "-O2", "--cflag", "-g"})
	if len(err) > 0 {
		return fail("unexpected error")
	}
	if !listEq(cflags, @[]@[]char{"-O2", "-g"}) {
		return fail("cflags should be [-O2 -g]")
	}
	return ""
}

// A separator list splits each occurrence and accumulates across occurrences.
func TestListSep() testing.TestResult {
	var paths @[]@[]char
	var fs @FlagSet = New("t")
	fs.StringListSepVar(&paths, "interface-path", "I", ':', "")
	_, err := fs.Parse(@[]@[]char{"-I", "a:b:c", "-I", "d"})
	if len(err) > 0 {
		return fail("unexpected error")
	}
	if !listEq(paths, @[]@[]char{"a", "b", "c", "d"}) {
		return fail("paths should be [a b c d]")
	}
	return ""
}

// Parsing stops at the first positional; tokens after it (even flag-looking
// ones) are returned verbatim and never validated.
func TestPositionalsStop() testing.TestResult {
	var v bool = false
	var fs @FlagSet = New("t")
	fs.BoolVar(&v, "verbose", "v", "")
	pos, err := fs.Parse(@[]@[]char{"-v", "file1.bn", "--not-a-flag", "file2"})
	if len(err) > 0 {
		return fail("unexpected error")
	}
	if !v {
		return fail("-v should be set")
	}
	if !listEq(pos, @[]@[]char{"file1.bn", "--not-a-flag", "file2"}) {
		return fail("positionals wrong")
	}
	return ""
}

// `--` terminates flags and is consumed; the remainder are positionals even if
// they look like flags.
func TestDoubleDash() testing.TestResult {
	var v bool = false
	var fs @FlagSet = New("t")
	fs.BoolVar(&v, "verbose", "v", "")
	pos, err := fs.Parse(@[]@[]char{"-v", "--", "-x", "y"})
	if len(err) > 0 || !v {
		return fail("-v before -- should set v")
	}
	if !listEq(pos, @[]@[]char{"-x", "y"}) {
		return fail("positionals should be [-x y]")
	}
	return ""
}

// An unrecognized flag is a strict error.
func TestUnknownFlag() testing.TestResult {
	var fs @FlagSet = New("t")
	_, err := fs.Parse(@[]@[]char{"--nope"})
	if len(err) == 0 {
		return fail("--nope should error")
	}
	return ""
}

// A value flag with no following value is an error.
func TestMissingValue() testing.TestResult {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, err := fs.Parse(@[]@[]char{"-o"})
	if len(err) == 0 {
		return fail("-o with no value should error")
	}
	return ""
}

// A short-only flag (no long name) is matched by its single-char name.
func TestShortOnly() testing.TestResult {
	var c bool = false
	var fs @FlagSet = New("t")
	fs.BoolVar(&c, "c", "", "")
	_, err := fs.Parse(@[]@[]char{"-c"})
	if len(err) > 0 || !c {
		return fail("-c should set c")
	}
	return ""
}

// A bool given an explicit `=true` / `=false` sets or clears it.
func TestBoolEquals() testing.TestResult {
	var d bool = false
	var fs @FlagSet = New("t")
	fs.BoolVar(&d, "debug", "g", "")
	_, err := fs.Parse(@[]@[]char{"--debug=true"})
	if len(err) > 0 || !d {
		return fail("--debug=true should set d")
	}
	var d2 bool = true
	var fs2 @FlagSet = New("t")
	fs2.BoolVar(&d2, "debug", "g", "")
	_, err2 := fs2.Parse(@[]@[]char{"--debug=false"})
	if len(err2) > 0 || d2 {
		return fail("--debug=false should clear d2")
	}
	return ""
}

// A value given inline with `=` on the SHORT form (-o=x).
func TestShortEquals() testing.TestResult {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, err := fs.Parse(@[]@[]char{"-o=x"})
	if len(err) > 0 || !streq(out, "x") {
		return fail("-o=x should set out to x")
	}
	return ""
}

// Only the FIRST `=` splits, so an inline value may itself contain `=`.
func TestInlineEqualsInValue() testing.TestResult {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, err := fs.Parse(@[]@[]char{"--output=a=b"})
	if len(err) > 0 || !streq(out, "a=b") {
		return fail("value should be a=b")
	}
	return ""
}

// A uint rejects a negative value; a leading '+' is accepted.
func TestUintSigns() testing.TestResult {
	var c uint = 0
	var fs @FlagSet = New("t")
	fs.UintVar(&c, "count", "", 0, "")
	_, err := fs.Parse(@[]@[]char{"--count=-1"})
	if len(err) == 0 {
		return fail("--count=-1 should error")
	}
	var c2 uint = 0
	var fs2 @FlagSet = New("t")
	fs2.UintVar(&c2, "count", "", 0, "")
	_, err2 := fs2.Parse(@[]@[]char{"--count=+7"})
	if len(err2) > 0 || c2 != 7 {
		return fail("--count=+7 should be 7")
	}
	return ""
}

// An out-of-range number (too many digits for any target width) is an error,
// while a large-but-in-range value parses.
func TestNumberOverflow() testing.TestResult {
	var n int = 0
	var fs @FlagSet = New("t")
	fs.IntVar(&n, "num", "n", 0, "")
	_, err := fs.Parse(@[]@[]char{"-n", "999999999999999999999999999"})
	if len(err) == 0 {
		return fail("huge int should overflow-error")
	}
	var u uint = 0
	var fs2 @FlagSet = New("t")
	fs2.UintVar(&u, "count", "", 0, "")
	_, err2 := fs2.Parse(@[]@[]char{"--count=999999999999999999999999999"})
	if len(err2) == 0 {
		return fail("huge uint should overflow-error")
	}
	var big int = 0
	var fs3 @FlagSet = New("t")
	fs3.IntVar(&big, "num", "n", 0, "")
	_, err3 := fs3.Parse(@[]@[]char{"-n", "2000000000"})
	if len(err3) > 0 || big != 2000000000 {
		return fail("2000000000 should parse")
	}
	return ""
}

// A repeated scalar is last-wins for both string and int kinds.
func TestScalarLastWins() testing.TestResult {
	var out @[]char
	var n int = 0
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	fs.IntVar(&n, "num", "n", 0, "")
	_, err := fs.Parse(@[]@[]char{"-o", "x", "-o", "y", "-n", "1", "-n", "2"})
	if len(err) > 0 || !streq(out, "y") || n != 2 {
		return fail("last occurrence should win")
	}
	return ""
}

// A separator list drops empty fields (leading, trailing, and consecutive).
func TestListSepEdges() testing.TestResult {
	var paths @[]@[]char
	var fs @FlagSet = New("t")
	fs.StringListSepVar(&paths, "path", "p", ':', "")
	_, err := fs.Parse(@[]@[]char{"-p", ":a::b:"})
	if len(err) > 0 {
		return fail("unexpected error")
	}
	if !listEq(paths, @[]@[]char{"a", "b"}) {
		return fail("paths should be [a b]")
	}
	return ""
}

// An empty `=value` is the empty string for a string flag (no error), but an
// error for a numeric flag.
func TestEmptyEqualsValue() testing.TestResult {
	var out @[]char = "pre"
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, err := fs.Parse(@[]@[]char{"--output="})
	if len(err) > 0 || len(out) != 0 {
		return fail("--output= should be empty string")
	}
	var c uint = 0
	var fs2 @FlagSet = New("t")
	fs2.UintVar(&c, "count", "", 0, "")
	_, err2 := fs2.Parse(@[]@[]char{"--count="})
	if len(err2) == 0 {
		return fail("--count= should error")
	}
	return ""
}

// With no flags at all, every token is a positional; a bare "-" is a positional.
func TestAllPositionals() testing.TestResult {
	var fs @FlagSet = New("t")
	pos, err := fs.Parse(@[]@[]char{"a", "b"})
	if len(err) > 0 || !listEq(pos, @[]@[]char{"a", "b"}) {
		return fail("[a b] should be positionals")
	}
	var fs2 @FlagSet = New("t")
	pos2, err2 := fs2.Parse(@[]@[]char{"-"})
	if len(err2) > 0 || !listEq(pos2, @[]@[]char{"-"}) {
		return fail("bare - should be a positional")
	}
	return ""
}

// A list registrar resets its destination, honoring "empty list initially".
func TestListResetsDestination() testing.TestResult {
	var xs @[]@[]char = @[]@[]char{"stale"}
	var fs @FlagSet = New("t")
	fs.StringListVar(&xs, "item", "", "")
	_, err := fs.Parse(@[]@[]char{"--item", "a"})
	if len(err) > 0 || !listEq(xs, @[]@[]char{"a"}) {
		return fail("pre-existing entry should be cleared")
	}
	return ""
}

// Usage renders the program name, each flag's dash-prefixed name/alias and its
// text, and a <value> placeholder only for value flags.
func TestUsage() testing.TestResult {
	var d bool = false
	var out @[]char
	var fs @FlagSet = New("mytool")
	fs.BoolVar(&d, "debug", "g", "enable debug")
	fs.StringVar(&out, "output", "o", "", "output path")
	var u @[]readonly char = fs.Usage()
	if !contains(u, "mytool") {
		return fail("usage should name the program")
	}
	if !contains(u, "-g, --debug") || !contains(u, "enable debug") {
		return fail("usage should list the bool flag without <value>")
	}
	if !contains(u, "-o, --output <value>") || !contains(u, "output path") {
		return fail("usage should list the string flag with <value>")
	}
	// A bool flag must NOT carry a <value> placeholder next to its name.
	if contains(u, "--debug <value>") {
		return fail("bool flag should not show <value>")
	}
	return ""
}

// A parsed value is a managed slice, so it stays valid after the argument
// vector that backed it has gone out of scope.  parseKept builds a throwaway
// vector and returns only the parsed value.
func parseKept() @[]char {
	var out @[]char
	var fs @FlagSet = New("t")
	fs.StringVar(&out, "output", "o", "", "")
	_, _ = fs.Parse(@[]@[]char{"-o", "kept"})
	return out
}

func TestValueOutlivesArgVector() testing.TestResult {
	var s @[]char = parseKept()
	if !streq(s, "kept") {
		return fail("value should survive its argument vector")
	}
	return ""
}
