package "pkg/stdx/fmt"

import "pkg/builtins/lang"
import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os"
import "pkg/std/strconv"
import "pkg/std/strings"

// tryStringer reports whether arg's dynamic type implements lang.Stringer, and if
// so returns its String() rendering.  The runtime interface-satisfaction assertion
// is how a formatter dispatches custom formatting on a type-erased `*any` — the
// caller uses it AFTER the built-in fast-path cases, so a `type Money int` with its
// own String() (which `case int:` cannot match — exact identity) is still honored.
func tryStringer(arg *any) (@[]char, bool) {
	var s @[]char
	var st *lang.Stringer
	var ok bool
	st, ok = arg.(*lang.Stringer)
	if !ok {
		return s, false
	}
	return st.String(), true
}

// argIsString reports whether arg's dynamic type is one of the char-slice
// spellings (a Binate "string") — used for Fprint's Go-style spacing rule (a space
// is added between two operands only when NEITHER is a string).  A separate, cheap
// type switch (not writeArg's return) because the rule needs the current operand's
// string-ness BEFORE it is written, to decide the leading space.
func argIsString(arg *any) bool {
	switch arg.(type) {
	case *[]readonly char:
		return true
	case *[]char:
		return true
	case @[]readonly char:
		return true
	case @[]char:
		return true
	default:
		return false
	}
}

// writeMs writes an already-formatted managed char-slice to w.  char is uint8, so
// the slice IS a byte view; `s[0:len(s)]` takes the raw view io.Writer.Write reads
// from (a `*[]readonly uint8` after the mutable→readonly element coercion).
func writeMs(w @io.Writer, s @[]char) (int, @errors.Error) {
	return w.Write(s[0:len(s)])
}

// intOperand classifies arg as an integer scalar, widening it so a single pair of
// strconv digit emitters serves every width.  It returns (i, u, signed, ok): for a
// signed kind (int, int8/16/32, int64) `i` holds the sign-extended value and
// `signed` is true; for an unsigned kind (uint, uint8/16/32, uint64) `u` holds the
// zero-extended value and `signed` is false; a non-integer operand yields ok=false.
// char is uint8, so a char operand classifies here (matched by `case uint8`) — its
// %v/%d rendering is the numeric byte value, matching Go's `byte`, while %c/%q of
// the same value render the character.  A NAMED integer type (`type Money int`) is a
// distinct dynamic type that does NOT match any case, so it still falls through to
// the caller's Stringer / error path (a `Money` with its own String() wins).
func intOperand(arg *any) (int64, uint64, bool, bool) {
	switch v := arg.(type) {
	case int:
		return cast(int64, v), 0, true, true
	case int8:
		return cast(int64, v), 0, true, true
	case int16:
		return cast(int64, v), 0, true, true
	case int32:
		return cast(int64, v), 0, true, true
	case int64:
		return v, 0, true, true
	case uint:
		return 0, cast(uint64, v), false, true
	case uint8:
		return 0, cast(uint64, v), false, true
	case uint16:
		return 0, cast(uint64, v), false, true
	case uint32:
		return 0, cast(uint64, v), false, true
	case uint64:
		return 0, v, false, true
	default:
		return 0, 0, false, false
	}
}

// writeArg formats one operand by its dynamic type and writes it to w, returning
// the byte count and any write error.  The char-slice cases write STRAIGHT through
// (no allocation — the fast path); an integer scalar of any width renders via
// intOperand + strconv; a type that implements lang.Stringer renders via its
// String(); a by-value struct without a String() renders its fields as `{…}` via
// reflection (writeStructReflect).  Anything else is a `%!?(unknown)` placeholder.
func writeArg(w @io.Writer, arg *any) (int, @errors.Error) {
	switch v := arg.(type) {
	case *[]readonly char:
		return w.Write(v)
	case *[]char:
		return w.Write(v)
	case @[]readonly char:
		return w.Write(v[0:len(v)])
	case @[]char:
		return w.Write(v[0:len(v)])
	case bool:
		return writeMs(w, strconv.FormatBool(v))
	case float64:
		return writeMs(w, strconv.FormatFloat(v, 'g', -1, 64))
	case float32:
		return writeMs(w, strconv.FormatFloat(cast(float64, v), 'g', -1, 32))
	default:
		// Every integer width (int, sized ints, uint, sized uints, char==uint8)
		// renders as its base-10 value here, widened to int64/uint64 first.
		var iv int64
		var uv uint64
		var signed bool
		var isInt bool
		iv, uv, signed, isInt = intOperand(arg)
		if isInt {
			if signed {
				return writeMs(w, strconv.FormatInt(iv, 10))
			}
			return writeMs(w, strconv.FormatUint(uv, 10))
		}
		var s @[]char
		var ok bool
		s, ok = tryStringer(arg)
		if ok {
			return writeMs(w, s)
		}
		// A by-value struct without a String() renders its fields via reflection
		// (plain `%v` form, no field names; `%+v`'s named form goes through the
		// Printf path, not writeArg).
		var sn int
		var se @errors.Error
		var handled bool
		sn, se, handled = writeStructReflect(w, arg, false)
		if handled {
			return sn, se
		}
		return w.Write("%!?(unknown)")
	}
}

// Fprint — see fmt.bni.
func Fprint(w @io.Writer, args ...*any) (int, @errors.Error) {
	var total int = 0
	var noErr @errors.Error
	var prevStr bool = false
	for i := 0; i < len(args); i++ {
		var isStr bool = argIsString(args[i])
		if i > 0 && !prevStr && !isStr {
			var sn int
			var se @errors.Error
			sn, se = w.Write(" ")
			total = total + sn
			if present(se) {
				return total, se
			}
		}
		var n int
		var e @errors.Error
		n, e = writeArg(w, args[i])
		total = total + n
		if present(e) {
			return total, e
		}
		prevStr = isStr
	}
	return total, noErr
}

// Fprintln — see fmt.bni.
func Fprintln(w @io.Writer, args ...*any) (int, @errors.Error) {
	var total int = 0
	for i := 0; i < len(args); i++ {
		if i > 0 {
			var sn int
			var se @errors.Error
			sn, se = w.Write(" ")
			total = total + sn
			if present(se) {
				return total, se
			}
		}
		var n int
		var e @errors.Error
		n, e = writeArg(w, args[i])
		total = total + n
		if present(e) {
			return total, e
		}
	}
	var nn int
	var ne @errors.Error
	nn, ne = w.Write("\n")
	total = total + nn
	return total, ne
}

// Sprint — see fmt.bni.
func Sprint(args ...*any) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	var w @io.Writer = b
	Fprint(w, args...)
	return b.String()
}

// Sprintln — see fmt.bni.
func Sprintln(args ...*any) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	var w @io.Writer = b
	Fprintln(w, args...)
	return b.String()
}

// Print — see fmt.bni.
func Print(args ...*any) (int, @errors.Error) {
	var w @io.Writer = os.Stdout
	return Fprint(w, args...)
}

// Println — see fmt.bni.
func Println(args ...*any) (int, @errors.Error) {
	var w @io.Writer = os.Stdout
	return Fprintln(w, args...)
}
