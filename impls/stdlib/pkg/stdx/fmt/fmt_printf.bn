package "pkg/stdx/fmt"

import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os"
import "pkg/std/strconv"
import "pkg/std/strings"

// The Printf family — verb-directed formatting over the type-erased `...*any`
// operands.  This lean first cut supports the verbs `%v %d %s %t %f %g %e %x %X
// %o %b %c %q %%` with Go-style error verbs, but NO width / precision / flags
// (those, plus `%x`/`%q` on non-string operands, are a follow-up).  Each `%`
// verb consumes the next operand left-to-right; a verb/type mismatch renders as
// `%!<verb>(<type>=<value>)`, a spent operand list as `%!<verb>(MISSING)`, extra
// operands as `%!(EXTRA <type>=<value>, ...)`, and a `%` at end-of-format as
// `%!(NOVERB)` — mirroring Go's fmt so mistakes are visible, never silent.
//
// The output is assembled in a strings.Builder (which never fails), so the
// walker carries no per-write error plumbing; Fprintf flushes it to the writer
// once and reports that single write's (count, error), Sprintf returns it, and
// Printf targets os.Stdout.

// putStr appends an already-formatted managed char-slice to the builder.  char
// is uint8, so `s[0:len(s)]` is the raw byte view Builder.Write reads from.
func putStr(b @strings.Builder, s @[]char) {
	b.Write(s[0:len(s)])
}

// putDefault renders arg with the shared `%v` default formatter (writeArg), used
// by `%v` itself and by the error verbs' value rendering.  writeArg wants an
// io.Writer; the Builder is one.
func putDefault(b @strings.Builder, arg *any) {
	var w @io.Writer = b
	writeArg(w, arg)
}

// argTypeName is the dynamic type's name for an error verb (`%!d(int=7)`).  A
// static string, so no allocation.  Every char-slice spelling is "string".
func argTypeName(arg *any) *[]readonly char {
	switch arg.(type) {
	case *[]readonly char:
		return "string"
	case *[]char:
		return "string"
	case @[]readonly char:
		return "string"
	case @[]char:
		return "string"
	case int:
		return "int"
	case int64:
		return "int64"
	case uint64:
		return "uint64"
	case bool:
		return "bool"
	case float64:
		return "float64"
	case float32:
		return "float32"
	default:
		return "?"
	}
}

// badVerb renders `%!<verb>(<type>=<value>)` — a verb the operand's dynamic type
// cannot satisfy (`%d` of a string), or an unknown verb.
func badVerb(b @strings.Builder, verb char, arg *any) {
	b.Write("%!")
	b.WriteByte(verb)
	b.WriteByte('(')
	b.Write(argTypeName(arg))
	b.WriteByte('=')
	putDefault(b, arg)
	b.WriteByte(')')
}

// upperHexInPlace uppercases the hex letters a–f of a freshly-formatted (owned,
// mutable) digit string, for the `%X` variant of FormatInt/FormatUint's
// lowercase output.
func upperHexInPlace(s @[]char) {
	for i := 0; i < len(s); i++ {
		var c char = s[i]
		if c >= 'a' && c <= 'f' {
			s[i] = c - 32
		}
	}
}

// putIntBase writes a base-formatted integer digit string, uppercasing for `%X`.
func putIntBase(b @strings.Builder, s @[]char, upper bool) {
	if upper {
		upperHexInPlace(s)
	}
	putStr(b, s)
}

// quoteInto writes a double-quoted rendering of bytes, escaping the quote char,
// backslash, and the common control escapes.  A lean `%q`: enough to make a
// quoted string readable, not full Go-syntax quoting of every non-printable.
func quoteInto(b @strings.Builder, bytes *[]readonly char) {
	b.WriteByte('"')
	for i := 0; i < len(bytes); i++ {
		var c char = bytes[i]
		if c == '"' || c == '\\' {
			b.WriteByte('\\')
			b.WriteByte(c)
		} else if c == '\n' {
			b.WriteByte('\\')
			b.WriteByte('n')
		} else if c == '\t' {
			b.WriteByte('\\')
			b.WriteByte('t')
		} else if c == '\r' {
			b.WriteByte('\\')
			b.WriteByte('r')
		} else {
			b.WriteByte(c)
		}
	}
	b.WriteByte('"')
}

// formatString handles `%s` — a Binate string is any of the four char-slice
// spellings, written straight through; any other type is an error verb.
func formatString(b @strings.Builder, verb char, arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		b.Write(v)
	case *[]char:
		b.Write(v)
	case @[]readonly char:
		b.Write(v[0:len(v)])
	case @[]char:
		b.Write(v[0:len(v)])
	default:
		badVerb(b, verb, arg)
	}
}

// formatDecimal handles `%d` — the integer types in base 10.
func formatDecimal(b @strings.Builder, verb char, arg *any) {
	switch v := arg.(type) {
	case int:
		putStr(b, strconv.Itoa(v))
	case int64:
		putStr(b, strconv.FormatInt(v, 10))
	case uint64:
		putStr(b, strconv.FormatUint(v, 10))
	default:
		badVerb(b, verb, arg)
	}
}

// formatBase handles `%x %X %o %b` — the integer types in the given base (`%x`
// of a string is a follow-up; here it is an error verb).
func formatBase(b @strings.Builder, verb char, arg *any, base int, upper bool) {
	switch v := arg.(type) {
	case int:
		putIntBase(b, strconv.FormatInt(cast(int64, v), base), upper)
	case int64:
		putIntBase(b, strconv.FormatInt(v, base), upper)
	case uint64:
		putIntBase(b, strconv.FormatUint(v, base), upper)
	default:
		badVerb(b, verb, arg)
	}
}

// formatBoolVerb handles `%t`.
func formatBoolVerb(b @strings.Builder, verb char, arg *any) {
	switch v := arg.(type) {
	case bool:
		putStr(b, strconv.FormatBool(v))
	default:
		badVerb(b, verb, arg)
	}
}

// formatFloatVerb handles `%f %e %g` — the verb char IS strconv's format char.
// `%f`/`%e` default to 6 digits after the point (Go's default when no precision
// is given); `%g` uses the shortest round-tripping form (prec -1).  An explicit
// precision (`%.2f`) is a follow-up.
func formatFloatVerb(b @strings.Builder, verb char, arg *any) {
	var prec int = 6
	if verb == 'g' {
		prec = -1
	}
	switch v := arg.(type) {
	case float64:
		putStr(b, strconv.FormatFloat(v, verb, prec, 64))
	case float32:
		putStr(b, strconv.FormatFloat(cast(float64, v), verb, prec, 32))
	default:
		badVerb(b, verb, arg)
	}
}

// formatChar handles `%c` — an integer operand's low byte as a character (Binate
// char is uint8, so this is a single byte, not a multi-byte code point).
func formatChar(b @strings.Builder, verb char, arg *any) {
	switch v := arg.(type) {
	case int:
		b.WriteByte(cast(char, v))
	case int64:
		b.WriteByte(cast(char, v))
	case uint64:
		b.WriteByte(cast(char, v))
	default:
		badVerb(b, verb, arg)
	}
}

// formatQuote handles `%q` — a double-quoted string (quoting a char/int operand
// is a follow-up; here a non-string is an error verb).
func formatQuote(b @strings.Builder, verb char, arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		quoteInto(b, v)
	case *[]char:
		quoteInto(b, v)
	case @[]readonly char:
		quoteInto(b, v[0:len(v)])
	case @[]char:
		quoteInto(b, v[0:len(v)])
	default:
		badVerb(b, verb, arg)
	}
}

// formatVerb dispatches one verb to its formatter.  `%v` is the shared default
// (writeArg); an unrecognized verb is an error verb.
func formatVerb(b @strings.Builder, verb char, arg *any) {
	switch verb {
	case 'v':
		putDefault(b, arg)
	case 's':
		formatString(b, verb, arg)
	case 'd':
		formatDecimal(b, verb, arg)
	case 'x':
		formatBase(b, verb, arg, 16, false)
	case 'X':
		formatBase(b, verb, arg, 16, true)
	case 'o':
		formatBase(b, verb, arg, 8, false)
	case 'b':
		formatBase(b, verb, arg, 2, false)
	case 't':
		formatBoolVerb(b, verb, arg)
	case 'f', 'e', 'g':
		formatFloatVerb(b, verb, arg)
	case 'c':
		formatChar(b, verb, arg)
	case 'q':
		formatQuote(b, verb, arg)
	default:
		badVerb(b, verb, arg)
	}
}

// writeExtra renders the operands the format string never consumed as
// `%!(EXTRA <type>=<value>, ...)`, matching Go.
func writeExtra(b @strings.Builder, args *[]*any, from int) {
	b.Write("%!(EXTRA ")
	for i := from; i < len(args); i++ {
		if i > from {
			b.Write(", ")
		}
		b.Write(argTypeName(args[i]))
		b.WriteByte('=')
		putDefault(b, args[i])
	}
	b.WriteByte(')')
}

// formatInto walks format, copying literal runs and dispatching each `%` verb to
// the next operand, into the builder.  Operand under/over-supply and a trailing
// bare `%` render as visible error verbs rather than silently.
func formatInto(b @strings.Builder, format *[]readonly char, args *[]*any) {
	var argIdx int = 0
	var i int = 0
	var n int = len(format)
	for i < n {
		if format[i] != '%' {
			var start int = i
			for i < n && format[i] != '%' {
				i++
			}
			b.Write(format[start:i])
			continue
		}
		i++ // past the '%'
		if i >= n {
			// A trailing bare `%` — break (not return) so any operands the format
			// never consumed still report as `%!(EXTRA ...)` below, matching Go.
			b.Write("%!(NOVERB)")
			break
		}
		var verb char = format[i]
		i++
		if verb == '%' {
			b.WriteByte('%')
			continue
		}
		if argIdx >= len(args) {
			b.Write("%!")
			b.WriteByte(verb)
			b.Write("(MISSING)")
			continue
		}
		var arg *any = args[argIdx]
		argIdx++
		formatVerb(b, verb, arg)
	}
	if argIdx < len(args) {
		writeExtra(b, args, argIdx)
	}
}

// Fprintf — see fmt.bni.
func Fprintf(w @io.Writer, format *[]readonly char, args ...*any) (int, @errors.Error) {
	var b @strings.Builder = strings.NewBuilder()
	formatInto(b, format, args)
	var s @[]readonly char = b.String()
	return w.Write(s[0:len(s)])
}

// Printf — see fmt.bni.
func Printf(format *[]readonly char, args ...*any) (int, @errors.Error) {
	var w @io.Writer = os.Stdout
	return Fprintf(w, format, args...)
}

// Sprintf — see fmt.bni.
func Sprintf(format *[]readonly char, args ...*any) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	formatInto(b, format, args)
	return b.String()
}
