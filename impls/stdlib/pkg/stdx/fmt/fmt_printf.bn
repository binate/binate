package "pkg/stdx/fmt"

import "pkg/std/errors"
import "pkg/std/io"
import "pkg/std/os"
import "pkg/std/strings"

// The Printf family — verb-directed formatting over the type-erased `...*any`
// operands.  A format walker copies literal runs and dispatches each `%`
// directive to the next operand.  A directive is `%[flags][width][.prec]verb`:
//   flags  - left-justify, 0 zero-pad, + always sign, space sign-for-positive,
//          # alternate form (0x/0X/0/0b prefix; per-byte 0x for %# x of a string)
//   width  minimum field width (space- or zero-padded); `*` takes it from an operand
//   .prec  precision — float digits (%f/%e), min integer digits (%d/%x/…),
//          or string truncation (%s); `.*` takes it from an operand
//   verb   v d s t f g e x X o b c q % (%x/%X also hex-encode a string; %q of an
//          integer single-quotes its byte)
// (`+`/space sign flags on `%v` of a number are not applied — use %d/%f.)  A
// verb/type mismatch renders as `%!<verb>(<type>=<value>)`, too
// few operands as `%!<verb>(MISSING)`, extra operands as `%!(EXTRA <type>=<value>,
// ...)`, and a trailing bare `%` as `%!(NOVERB)` — mirroring Go so mistakes are
// visible, never silent.
//
// Output is assembled in a strings.Builder (which never fails), so the walker
// carries no per-write error plumbing; Fprintf flushes it to the writer once and
// reports that single write's (count, error), Sprintf returns it, Printf targets
// os.Stdout.

// Spec is a parsed `%` directive's flags, width, and precision.  width/prec are
// -1 when absent; a bare `.` (precision with no digits) parses as prec 0.
type Spec struct {
	minus     bool // '-' — left-justify
	plus      bool // '+' — always show a sign
	space     bool // ' ' — leading space for a non-negative number
	zero      bool // '0' — pad with leading zeros (after the sign)
	hash      bool // '#' — alternate form (0x/0X/0/0b prefix; per-byte 0x for %# x of a string)
	width     int
	prec      int
	widthStar bool // width is `*` — taken from an operand
	precStar  bool // precision is `.*` — taken from an operand
}

// putDefault renders arg with the shared `%v` default formatter (writeArg), used
// by `%v` and the error verbs' value rendering.  writeArg wants an io.Writer;
// the Builder is one.
func putDefault(b @strings.Builder, arg *any) {
	var w @io.Writer = b
	writeArg(w, arg)
}

// putDefaultNamed renders arg with the `%+v` formatter: a struct's fields are
// labeled `name:value` (writeStructReflect with names), recursively for nested
// structs.  A custom `String()` still WINS (checked first, exactly as writeArg /
// plain `%v` do — Go honors Stringer under `%+v` too), so a struct that
// implements lang.Stringer is NOT field-dumped.  A non-struct operand falls back
// to the plain `%v` formatter — field names apply only to structs, so `%+v` of a
// number/string matches `%v`.
func putDefaultNamed(b @strings.Builder, arg *any) {
	var w @io.Writer = b
	var s @[]char
	var ok bool
	s, ok = tryStringer(arg)
	if ok {
		writeMs(w, s)
		return
	}
	var n int
	var e @errors.Error
	var handled bool
	n, e, handled = writeStructReflect(w, arg, true)
	if !handled {
		writeArg(w, arg)
	}
}

// argTypeName is the dynamic type's name for an error verb (`%!d(int=7)`).  A
// static string, so no allocation.  Every char-slice spelling is "string".
func argTypeName(arg *any) *[]readonly char {
	switch arg.(type) {
	case *[]readonly char:
		return "string"
	case *[]char:
		return "string"
	case @[]readonly char:
		return "string"
	case @[]char:
		return "string"
	case int:
		return "int"
	case int64:
		return "int64"
	case uint64:
		return "uint64"
	case bool:
		return "bool"
	case float64:
		return "float64"
	case float32:
		return "float32"
	default:
		return "?"
	}
}

// argAsInt extracts an int from an integer operand, for a `*` width/precision.
func argAsInt(arg *any) (int, bool) {
	switch v := arg.(type) {
	case int:
		return v, true
	case int64:
		return cast(int, v), true
	case uint64:
		return cast(int, v), true
	default:
		return 0, false
	}
}

// emitBadVerb renders `%!<verb>(<type>=<value>)` — a verb the operand's dynamic
// type cannot satisfy, or an unknown verb.  Written into `out` so field-width
// padding (if any) applies to it like any other body.
func emitBadVerb(out @strings.Builder, verb char, arg *any) {
	out.Write("%!")
	out.WriteByte(verb)
	out.WriteByte('(')
	out.Write(argTypeName(arg))
	out.WriteByte('=')
	putDefault(out, arg)
	out.WriteByte(')')
}

// emitVerb writes one verb's unpadded body (sign + precision applied) into `out`.
func emitVerb(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch verb {
	case 'v':
		emitDefault(out, spec, arg)
	case 's':
		emitString(out, spec, arg)
	case 'd':
		emitDecimal(out, spec, verb, arg)
	case 'x':
		emitBase(out, spec, verb, arg, 16, false)
	case 'X':
		emitBase(out, spec, verb, arg, 16, true)
	case 'o':
		emitBase(out, spec, verb, arg, 8, false)
	case 'b':
		emitBase(out, spec, verb, arg, 2, false)
	case 't':
		emitBool(out, spec, verb, arg)
	case 'f', 'e', 'g':
		emitFloat(out, spec, verb, arg)
	case 'c':
		emitChar(out, spec, verb, arg)
	case 'q':
		emitQuote(out, spec, verb, arg)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// formatVerb writes a directive's result to b.  With no width it emits straight
// through; with a width it emits the body into a scratch builder and pads it to
// width via padBody (so padding can measure the body length).
func formatVerb(b @strings.Builder, spec Spec, verb char, arg *any) {
	if spec.width < 0 {
		emitVerb(b, spec, verb, arg)
		return
	}
	var sc @strings.Builder = strings.NewBuilder()
	emitVerb(sc, spec, verb, arg)
	var body @[]readonly char = sc.String()
	padBody(b, spec, body[0:len(body)], zeroPadFor(spec, verb, arg), signAwareFor(verb, arg))
}

// argTypeName-driven error rendering for the operands the format never consumed:
// `%!(EXTRA <type>=<value>, ...)`, matching Go.
func writeExtra(b @strings.Builder, args *[]*any, from int) {
	b.Write("%!(EXTRA ")
	for i := from; i < len(args); i++ {
		if i > from {
			b.Write(", ")
		}
		b.Write(argTypeName(args[i]))
		b.WriteByte('=')
		putDefault(b, args[i])
	}
	b.WriteByte(')')
}

// parseSpec parses the `[flags][width][.prec]` of a directive starting at index
// `i` (just past the `%`), returning the filled Spec and the index of the verb.
func parseSpec(format *[]readonly char, i int) (Spec, int) {
	var spec Spec = Spec{minus: false, plus: false, space: false, zero: false, hash: false, width: -1,
			prec: -1, widthStar: false, precStar: false}
	var n int = len(format)
	for i < n {
		if format[i] == '-' {
			spec.minus = true
			i++
		} else if format[i] == '+' {
			spec.plus = true
			i++
		} else if format[i] == ' ' {
			spec.space = true
			i++
		} else if format[i] == '0' {
			spec.zero = true
			i++
		} else if format[i] == '#' {
			spec.hash = true
			i++
		} else {
			break
		}
	}
	if i < n && format[i] == '*' {
		spec.widthStar = true
		i++
	} else if i < n && format[i] >= '1' && format[i] <= '9' {
		var w int = 0
		for i < n && format[i] >= '0' && format[i] <= '9' {
			w = w * 10 + (cast(int, format[i]) - cast(int, '0'))
			i++
		}
		spec.width = w
	}
	if i < n && format[i] == '.' {
		i++
		if i < n && format[i] == '*' {
			spec.precStar = true
			i++
		} else {
			var p int = 0
			for i < n && format[i] >= '0' && format[i] <= '9' {
				p = p * 10 + (cast(int, format[i]) - cast(int, '0'))
				i++
			}
			spec.prec = p
		}
	}
	return spec, i
}

// formatInto walks format, copying literal runs and dispatching each directive to
// the next operand, into the builder.  Operand under/over-supply and a trailing
// bare `%` render as visible error verbs rather than silently.
func formatInto(b @strings.Builder, format *[]readonly char, args *[]*any) {
	var argIdx int = 0
	var i int = 0
	var n int = len(format)
	for i < n {
		if format[i] != '%' {
			var start int = i
			for i < n && format[i] != '%' {
				i++
			}
			b.Write(format[start:i])
			continue
		}
		i++ // past the '%'
		var spec Spec
		spec, i = parseSpec(format, i)
		if i >= n {
			// A trailing bare `%` (optionally with flags/width) — break (not return)
			// so any operands the format never consumed still report as
			// `%!(EXTRA ...)` below, matching Go.
			b.Write("%!(NOVERB)")
			break
		}
		var verb char = format[i]
		i++
		if verb == '%' {
			b.WriteByte('%')
			continue
		}
		// Resolve `*` width and `.*` precision from operands (consumed in order,
		// before the value operand).  A missing or non-integer operand renders as
		// `%!(BADWIDTH)` / `%!(BADPREC)` and leaves that field absent (matching Go).
		// A negative width means left-justify to its magnitude; a negative precision
		// is a `%!(BADPREC)`.
		if spec.widthStar {
			if argIdx >= len(args) {
				b.Write("%!(BADWIDTH)")
			} else {
				var wv int
				var wok bool
				wv, wok = argAsInt(args[argIdx])
				argIdx++
				if !wok {
					b.Write("%!(BADWIDTH)")
				} else if wv < 0 {
					spec.minus = true
					spec.width = -wv
				} else {
					spec.width = wv
				}
			}
		}
		if spec.precStar {
			if argIdx >= len(args) {
				b.Write("%!(BADPREC)")
			} else {
				var pv int
				var pok bool
				pv, pok = argAsInt(args[argIdx])
				argIdx++
				if !pok || pv < 0 {
					b.Write("%!(BADPREC)")
				} else {
					spec.prec = pv
				}
			}
		}
		if argIdx >= len(args) {
			b.Write("%!")
			b.WriteByte(verb)
			b.Write("(MISSING)")
			continue
		}
		var arg *any = args[argIdx]
		argIdx++
		formatVerb(b, spec, verb, arg)
	}
	if argIdx < len(args) {
		writeExtra(b, args, argIdx)
	}
}

// Fprintf — see fmt.bni.
func Fprintf(w @io.Writer, format *[]readonly char, args ...*any) (int, @errors.Error) {
	var b @strings.Builder = strings.NewBuilder()
	formatInto(b, format, args)
	var s @[]readonly char = b.String()
	return w.Write(s[0:len(s)])
}

// Printf — see fmt.bni.
func Printf(format *[]readonly char, args ...*any) (int, @errors.Error) {
	var w @io.Writer = os.Stdout
	return Fprintf(w, format, args...)
}

// Sprintf — see fmt.bni.
func Sprintf(format *[]readonly char, args ...*any) @[]readonly char {
	var b @strings.Builder = strings.NewBuilder()
	formatInto(b, format, args)
	return b.String()
}
