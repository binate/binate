package "pkg/stdx/fmt"

import "pkg/std/strconv"
import "pkg/std/strings"

// Per-verb body builders and the width/precision/flag padding, for the Printf
// family (the walker + dispatch live in fmt_printf.bn).  Each `emit*` writes a
// verb's UNPADDED body — sign and precision applied, but no field-width padding —
// into a builder; formatVerb then either writes it straight through (no width) or
// through padBody.  Splitting the sign/precision step from the width step is what
// lets zero-padding sit AFTER the sign (`%+08d` → `+0000042`), matching Go.

// repeatByte writes c to b n times (n <= 0 writes nothing).
func repeatByte(b @strings.Builder, c char, n int) {
	for i := 0; i < n; i++ {
		b.WriteByte(c)
	}
}

// padBody writes body to b padded to spec.width.  `-` left-justifies (spaces on
// the right); otherwise the pad goes on the left — as `0` when zeroPad is set,
// else spaces.  For a signed numeric body (signAware) the zeros go AFTER a leading
// `-`/`+`/space byte so the sign stays first (`%+08d` → `+0000042`); for a string
// (not signAware) they go at the very front, even if the string starts with `-`.
// A body already at/over the width is written verbatim.
func padBody(b @strings.Builder, spec Spec, body *[]readonly char, zeroPad bool, signAware bool) {
	var blen int = len(body)
	if spec.width < 0 || blen >= spec.width {
		b.Write(body)
		return
	}
	var padCount int = spec.width - blen
	if spec.minus {
		b.Write(body)
		repeatByte(b, ' ', padCount)
		return
	}
	if zeroPad {
		var s int = 0
		if signAware {
			// Keep a leading sign, then a `0x`/`0X`/`0b`/`0B` alternate-form prefix,
			// before the zeros — so `%+#08x` → `+0x00042`.  (An octal `0` prefix is
			// left in place; the pad zeros then supply the leading zero.)
			if blen > 0 && (body[0] == '-' || body[0] == '+' || body[0] == ' ') {
				s = 1
			}
			if blen >= s + 2 && body[s] == '0' &&
					(body[s + 1] == 'x' || body[s + 1] == 'X' || body[s + 1] == 'b' || body[s + 1] == 'B') {
				s = s + 2
			}
			b.Write(body[0:s])
		}
		repeatByte(b, '0', padCount)
		b.Write(body[s:blen])
		return
	}
	repeatByte(b, ' ', padCount)
	b.Write(body)
}

// zeroPadFor reports whether width padding should use `0` rather than spaces.  Go
// zero-pads with the `0` flag for EVERY verb (not just numbers), but never with
// the `-` flag, never for an integer given a precision (the precision then sets
// the minimum digit count and the field space-pads), and never for a non-finite
// float (Inf/NaN space-pad).
func zeroPadFor(spec Spec, verb char, arg *any) bool {
	if !spec.zero || spec.minus {
		return false
	}
	switch verb {
	case 'x', 'X':
		// int: precision disables zero-pad; a hex-encoded string zero-pads like any
		// string (`%08x` of "hi" → "00006869").
		if isIntArg(arg) {
			return spec.prec < 0
		}
		return isStringArg(arg)
	case 'd', 'o', 'b':
		return spec.prec < 0 && isIntArg(arg)
	case 'f', 'e', 'g':
		return isFiniteFloatArg(arg)
	default:
		return true
	}
}

// isStringArg reports whether an operand's dynamic type is a char-slice string.
func isStringArg(arg *any) bool {
	switch arg.(type) {
	case *[]readonly char:
		return true
	case *[]char:
		return true
	case @[]readonly char:
		return true
	case @[]char:
		return true
	default:
		return false
	}
}

// signAwareFor reports whether a body's leading `-`/`+`/space is a numeric sign
// (so zero-padding slots zeros after it) rather than ordinary content (a string
// that happens to start with `-`).  True for the numeric verbs and for `%v` of a
// numeric operand.
func signAwareFor(verb char, arg *any) bool {
	switch verb {
	case 'f', 'e', 'g':
		return true
	case 'd', 'x', 'X', 'o', 'b':
		// A hex-encoded STRING has no sign/prefix to preserve (its `0x` from `#`
		// zero-pads at the front, like Go), so only integer operands are sign-aware.
		return isIntArg(arg)
	case 'v':
		return isIntArg(arg) || isFloatArg(arg)
	default:
		return false
	}
}

// isIntArg reports whether an operand's dynamic type is an integer.
func isIntArg(arg *any) bool {
	switch arg.(type) {
	case int:
		return true
	case int64:
		return true
	case uint64:
		return true
	default:
		return false
	}
}

// isFloatArg reports whether an operand's dynamic type is a float.
func isFloatArg(arg *any) bool {
	switch arg.(type) {
	case float64:
		return true
	case float32:
		return true
	default:
		return false
	}
}

// isFiniteFloatArg reports whether arg is a float that is neither Inf nor NaN —
// non-finite values space-pad, never zero-pad (Go).  `f * 0.0 == 0.0` holds for
// every finite float (including -0.0) and fails for Inf and NaN (their product
// with 0 is NaN, which compares unequal to 0).
func isFiniteFloatArg(arg *any) bool {
	switch v := arg.(type) {
	case float64:
		return v * 0.0 == 0.0
	case float32:
		return cast(float64, v) * 0.0 == 0.0
	default:
		return false
	}
}

// upperHexInPlace uppercases the hex letters a–f of a freshly-formatted (owned,
// mutable) digit string, for the `%X` variant of FormatInt/FormatUint's
// lowercase output.
func upperHexInPlace(s @[]char) {
	for i := 0; i < len(s); i++ {
		var c char = s[i]
		if c >= 'a' && c <= 'f' {
			s[i] = cast(char, cast(int, c) - 32)
		}
	}
}

// emitDefault handles `%v` — the shared default formatter (writeArg).  Precision
// on `%v` is not applied (a follow-up); width padding is handled by formatVerb.
func emitDefault(out @strings.Builder, spec Spec, arg *any) {
	// `%+v` labels a struct's fields (`{x:3 y:4}`); plain `%v` does not (`{3 4}`).
	if spec.plus {
		putDefaultNamed(out, arg)
		return
	}
	putDefault(out, arg)
}

// emitIntBody writes an integer digit string (strconv's output) with its sign,
// alternate-form prefix (`0x`/`0X`/`0`/`0b` for the `#` flag, "" otherwise), and
// precision (minimum digit count) applied, but no width padding.
func emitIntBody(out @strings.Builder, spec Spec, s @[]char, upper bool, prefix *[]readonly char,
		octalHash bool) {
	if upper {
		upperHexInPlace(s)
	}
	var slen int = len(s)
	var start int = 0
	var sign char = 0
	if slen > 0 && s[0] == '-' {
		sign = '-'
		start = 1
	} else if spec.plus {
		sign = '+'
	} else if spec.space {
		sign = ' '
	}
	var ndigits int = slen - start
	// Precision is the minimum digit count; a precision of 0 applied to the value
	// 0 emits NOTHING at all (Go) — not even the sign or the prefix.
	if spec.prec == 0 && ndigits == 1 && s[start] == '0' {
		return
	}
	if sign != 0 {
		out.WriteByte(sign)
	}
	out.Write(prefix)
	var precZeros int = 0
	if spec.prec > ndigits {
		precZeros = spec.prec - ndigits
	}
	// Octal `#` only ensures a LEADING 0.  The precision zeros already supply one
	// when present, so prepend a single 0 solely when the digits would not already
	// start with 0 (i.e. a non-zero value with no precision padding).
	if octalHash && precZeros == 0 && (ndigits == 0 || s[start] != '0') {
		out.WriteByte('0')
	}
	repeatByte(out, '0', precZeros)
	out.Write(s[start:slen])
}

// emitDecimal handles `%d` — the integer types in base 10 (no alternate form).
func emitDecimal(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case int:
		emitIntBody(out, spec, strconv.FormatInt(cast(int64, v), 10), false, "", false)
	case int64:
		emitIntBody(out, spec, strconv.FormatInt(v, 10), false, "", false)
	case uint64:
		emitIntBody(out, spec, strconv.FormatUint(v, 10), false, "", false)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// basePrefix is the `#` alternate-form prefix for a base: `0x`/`0X` (16), `0b` (2);
// "" for base 10 or without the `#` flag.  Octal is NOT handled here — its `#`
// only ensures a leading `0` (see emitIntBody's octalHash), which the precision
// zeros may already supply, so it cannot be an unconditional prefix.
func basePrefix(spec Spec, base int, upper bool) *[]readonly char {
	if !spec.hash {
		return ""
	}
	if base == 16 {
		if upper {
			return "0X"
		}
		return "0x"
	}
	if base == 2 {
		return "0b"
	}
	return ""
}

// emitBase handles `%x %X %o %b` — the integer types in the given base, and (for
// `%x`/`%X`, base 16) a string operand hex-encoded byte by byte.
func emitBase(out @strings.Builder, spec Spec, verb char, arg *any, base int, upper bool) {
	var prefix *[]readonly char = basePrefix(spec, base, upper)
	var octalHash bool = spec.hash && base == 8
	switch v := arg.(type) {
	case int:
		emitIntBody(out, spec, strconv.FormatInt(cast(int64, v), base), upper, prefix, octalHash)
	case int64:
		emitIntBody(out, spec, strconv.FormatInt(v, base), upper, prefix, octalHash)
	case uint64:
		emitIntBody(out, spec, strconv.FormatUint(v, base), upper, prefix, octalHash)
	case *[]readonly char:
		emitStrHex(out, spec, v, base, upper, verb, arg)
	case *[]char:
		emitStrHex(out, spec, v, base, upper, verb, arg)
	case @[]readonly char:
		emitStrHex(out, spec, v[0:len(v)], base, upper, verb, arg)
	case @[]char:
		emitStrHex(out, spec, v[0:len(v)], base, upper, verb, arg)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitStrHex hex-encodes a string operand for `%x`/`%X` (base 16 only; `%o`/`%b`
// of a string is an error verb).  The space flag separates bytes with a space and
// the `#` flag prefixes them with `0x`/`0X` — per byte when both are set
// (`%# x` → `0x68 0x69`), once for the whole run otherwise (`%#x` → `0x6869`).
func emitStrHex(out @strings.Builder, spec Spec, bytes *[]readonly char, base int, upper bool,
		verb char, arg *any) {
	if base != 16 {
		emitBadVerb(out, verb, arg)
		return
	}
	var hb *[]readonly char = strPrecSlice(bytes, spec)
	var digits *[]readonly char = "0123456789abcdef"
	var pfx *[]readonly char = "0x"
	if upper {
		digits = "0123456789ABCDEF"
		pfx = "0X"
	}
	// A single leading `0x` for `#` (but not for an empty result — Go writes nothing).
	if spec.hash && !spec.space && len(hb) > 0 {
		out.Write(pfx)
	}
	for i := 0; i < len(hb); i++ {
		if i > 0 && spec.space {
			out.WriteByte(' ')
		}
		if spec.hash && spec.space {
			out.Write(pfx)
		}
		var by int = cast(int, hb[i])
		out.WriteByte(digits[by / 16])
		out.WriteByte(digits[by % 16])
	}
}

// emitFloatBody writes a float with its sign and precision applied, no width pad.
// `%f`/`%e` default to 6 digits, `%g` to the shortest round-tripping form.
func emitFloatBody(out @strings.Builder, spec Spec, verb char, f float64, bitSize int) {
	var prec int = spec.prec
	if prec < 0 {
		if verb == 'g' {
			prec = -1
		} else {
			prec = 6
		}
	}
	var s @[]char = strconv.FormatFloat(f, verb, prec, bitSize)
	var slen int = len(s)
	var start int = 0
	var sign char = 0
	if slen > 0 && s[0] == '-' {
		sign = '-'
		start = 1
	} else if slen > 0 && s[0] == '+' {
		// strconv already signs +Inf as "+Inf"; strip its sign and re-apply per
		// flags (default keeps '+', the space flag alone shows ' ').
		start = 1
		sign = '+'
		if spec.space && !spec.plus {
			sign = ' '
		}
	} else if spec.plus {
		sign = '+'
	} else if spec.space {
		sign = ' '
	}
	if sign != 0 {
		out.WriteByte(sign)
	}
	out.Write(s[start:slen])
}

// emitFloat handles `%f %e %g`.
func emitFloat(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case float64:
		emitFloatBody(out, spec, verb, v, 64)
	case float32:
		emitFloatBody(out, spec, verb, cast(float64, v), 32)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitBool handles `%t`.
func emitBool(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case bool:
		var s @[]char = strconv.FormatBool(v)
		out.Write(s[0:len(s)])
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitChar handles `%c` — an integer operand's low byte as a character.
func emitChar(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case int:
		out.WriteByte(cast(char, v))
	case int64:
		out.WriteByte(cast(char, v))
	case uint64:
		out.WriteByte(cast(char, v))
	default:
		emitBadVerb(out, verb, arg)
	}
}

// strPrecSlice truncates a string operand's bytes to spec.prec (`%s`/`%q`/`%x`
// precision limits the number of bytes rendered), or returns them whole.
func strPrecSlice(bytes *[]readonly char, spec Spec) *[]readonly char {
	var blen int = len(bytes)
	if spec.prec >= 0 && spec.prec < blen {
		return bytes[0:spec.prec]
	}
	return bytes
}

// emitStrBytes writes a string operand's bytes, truncated to spec.prec if given.
func emitStrBytes(out @strings.Builder, spec Spec, bytes *[]readonly char) {
	out.Write(strPrecSlice(bytes, spec))
}

// emitString handles `%s` — a Binate string is any of the four char-slice
// spellings; any other type is an error verb.
func emitString(out @strings.Builder, spec Spec, arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		emitStrBytes(out, spec, v)
	case *[]char:
		emitStrBytes(out, spec, v)
	case @[]readonly char:
		emitStrBytes(out, spec, v[0:len(v)])
	case @[]char:
		emitStrBytes(out, spec, v[0:len(v)])
	default:
		// A non-string renders through fmt's own default formatter (writeArg): the
		// built-in scalar cases (accurate strconv), then lang.Stringer for a user
		// type, else `%!?(unknown)`.  So `%s` of a built-in matches `%v` (fmt does
		// its OWN formatting for built-ins — it does not defer to lang's simple
		// String()).  Precision is applied to the rendered result.
		var sc @strings.Builder = strings.NewBuilder()
		putDefault(sc, arg)
		var r @[]readonly char = sc.String()
		emitStrBytes(out, spec, r[0:len(r)])
	}
}
