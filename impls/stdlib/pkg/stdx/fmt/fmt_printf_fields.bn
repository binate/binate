package "pkg/stdx/fmt"

import "pkg/std/strconv"
import "pkg/std/strings"

// Per-verb body builders and the width/precision/flag padding, for the Printf
// family (the walker + dispatch live in fmt_printf.bn).  Each `emit*` writes a
// verb's UNPADDED body — sign and precision applied, but no field-width padding —
// into a builder; formatVerb then either writes it straight through (no width) or
// through padBody.  Splitting the sign/precision step from the width step is what
// lets zero-padding sit AFTER the sign (`%+08d` → `+0000042`), matching Go.

// repeatByte writes c to b n times (n <= 0 writes nothing).
func repeatByte(b @strings.Builder, c char, n int) {
	for i := 0; i < n; i++ {
		b.WriteByte(c)
	}
}

// padBody writes body to b padded to spec.width.  `-` left-justifies (spaces on
// the right); otherwise the pad goes on the left — as `0` when zeroPad is set,
// else spaces.  For a signed numeric body (signAware) the zeros go AFTER a leading
// `-`/`+`/space byte so the sign stays first (`%+08d` → `+0000042`); for a string
// (not signAware) they go at the very front, even if the string starts with `-`.
// A body already at/over the width is written verbatim.
func padBody(b @strings.Builder, spec Spec, body *[]readonly char, zeroPad bool, signAware bool) {
	var blen int = len(body)
	if spec.width < 0 || blen >= spec.width {
		b.Write(body)
		return
	}
	var padCount int = spec.width - blen
	if spec.minus {
		b.Write(body)
		repeatByte(b, ' ', padCount)
		return
	}
	if zeroPad {
		var s int = 0
		if signAware && blen > 0 && (body[0] == '-' || body[0] == '+' || body[0] == ' ') {
			s = 1
			b.WriteByte(body[0])
		}
		repeatByte(b, '0', padCount)
		b.Write(body[s:blen])
		return
	}
	repeatByte(b, ' ', padCount)
	b.Write(body)
}

// zeroPadFor reports whether width padding should use `0` rather than spaces.  Go
// zero-pads with the `0` flag for EVERY verb (not just numbers), but never with
// the `-` flag, never for an integer given a precision (the precision then sets
// the minimum digit count and the field space-pads), and never for a non-finite
// float (Inf/NaN space-pad).
func zeroPadFor(spec Spec, verb char, arg *any) bool {
	if !spec.zero || spec.minus {
		return false
	}
	switch verb {
	case 'd', 'x', 'X', 'o', 'b':
		return spec.prec < 0 && isIntArg(arg)
	case 'f', 'e', 'g':
		return isFiniteFloatArg(arg)
	default:
		return true
	}
}

// signAwareFor reports whether a body's leading `-`/`+`/space is a numeric sign
// (so zero-padding slots zeros after it) rather than ordinary content (a string
// that happens to start with `-`).  True for the numeric verbs and for `%v` of a
// numeric operand.
func signAwareFor(verb char, arg *any) bool {
	switch verb {
	case 'd', 'x', 'X', 'o', 'b', 'f', 'e', 'g':
		return true
	case 'v':
		return isIntArg(arg) || isFloatArg(arg)
	default:
		return false
	}
}

// isIntArg reports whether an operand's dynamic type is an integer.
func isIntArg(arg *any) bool {
	switch arg.(type) {
	case int:
		return true
	case int64:
		return true
	case uint64:
		return true
	default:
		return false
	}
}

// isFloatArg reports whether an operand's dynamic type is a float.
func isFloatArg(arg *any) bool {
	switch arg.(type) {
	case float64:
		return true
	case float32:
		return true
	default:
		return false
	}
}

// isFiniteFloatArg reports whether arg is a float that is neither Inf nor NaN —
// non-finite values space-pad, never zero-pad (Go).  `f * 0.0 == 0.0` holds for
// every finite float (including -0.0) and fails for Inf and NaN (their product
// with 0 is NaN, which compares unequal to 0).
func isFiniteFloatArg(arg *any) bool {
	switch v := arg.(type) {
	case float64:
		return v * 0.0 == 0.0
	case float32:
		return cast(float64, v) * 0.0 == 0.0
	default:
		return false
	}
}

// upperHexInPlace uppercases the hex letters a–f of a freshly-formatted (owned,
// mutable) digit string, for the `%X` variant of FormatInt/FormatUint's
// lowercase output.
func upperHexInPlace(s @[]char) {
	for i := 0; i < len(s); i++ {
		var c char = s[i]
		if c >= 'a' && c <= 'f' {
			s[i] = cast(char, cast(int, c) - 32)
		}
	}
}

// quoteInto writes a double-quoted rendering of bytes, escaping the quote char,
// backslash, and the common control escapes.  A lean `%q`: enough to make a
// quoted string readable, not full Go-syntax quoting of every non-printable.
func quoteInto(b @strings.Builder, bytes *[]readonly char) {
	b.WriteByte('"')
	for i := 0; i < len(bytes); i++ {
		var c char = bytes[i]
		if c == '"' || c == '\\' {
			b.WriteByte('\\')
			b.WriteByte(c)
		} else if c == '\n' {
			b.WriteByte('\\')
			b.WriteByte('n')
		} else if c == '\t' {
			b.WriteByte('\\')
			b.WriteByte('t')
		} else if c == '\r' {
			b.WriteByte('\\')
			b.WriteByte('r')
		} else {
			b.WriteByte(c)
		}
	}
	b.WriteByte('"')
}

// emitDefault handles `%v` — the shared default formatter (writeArg).  Precision
// on `%v` is not applied (a follow-up); width padding is handled by formatVerb.
func emitDefault(out @strings.Builder, spec Spec, arg *any) {
	putDefault(out, arg)
}

// emitIntBody writes an integer digit string (strconv's output) with its sign
// and precision (minimum digit count) applied, but no width padding.
func emitIntBody(out @strings.Builder, spec Spec, s @[]char, upper bool) {
	if upper {
		upperHexInPlace(s)
	}
	var slen int = len(s)
	var start int = 0
	var sign char = 0
	if slen > 0 && s[0] == '-' {
		sign = '-'
		start = 1
	} else if spec.plus {
		sign = '+'
	} else if spec.space {
		sign = ' '
	}
	var ndigits int = slen - start
	// Precision is the minimum digit count; a precision of 0 applied to the value
	// 0 emits NOTHING at all (Go) — not even the sign.
	if spec.prec == 0 && ndigits == 1 && s[start] == '0' {
		return
	}
	if sign != 0 {
		out.WriteByte(sign)
	}
	if spec.prec > ndigits {
		repeatByte(out, '0', spec.prec - ndigits)
	}
	out.Write(s[start:slen])
}

// emitDecimal handles `%d` — the integer types in base 10.
func emitDecimal(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case int:
		emitIntBody(out, spec, strconv.FormatInt(cast(int64, v), 10), false)
	case int64:
		emitIntBody(out, spec, strconv.FormatInt(v, 10), false)
	case uint64:
		emitIntBody(out, spec, strconv.FormatUint(v, 10), false)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitBase handles `%x %X %o %b` — the integer types in the given base.
func emitBase(out @strings.Builder, spec Spec, verb char, arg *any, base int, upper bool) {
	switch v := arg.(type) {
	case int:
		emitIntBody(out, spec, strconv.FormatInt(cast(int64, v), base), upper)
	case int64:
		emitIntBody(out, spec, strconv.FormatInt(v, base), upper)
	case uint64:
		emitIntBody(out, spec, strconv.FormatUint(v, base), upper)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitFloatBody writes a float with its sign and precision applied, no width pad.
// `%f`/`%e` default to 6 digits, `%g` to the shortest round-tripping form.
func emitFloatBody(out @strings.Builder, spec Spec, verb char, f float64, bitSize int) {
	var prec int = spec.prec
	if prec < 0 {
		if verb == 'g' {
			prec = -1
		} else {
			prec = 6
		}
	}
	var s @[]char = strconv.FormatFloat(f, verb, prec, bitSize)
	var slen int = len(s)
	var start int = 0
	var sign char = 0
	if slen > 0 && s[0] == '-' {
		sign = '-'
		start = 1
	} else if slen > 0 && s[0] == '+' {
		// strconv already signs +Inf as "+Inf"; strip its sign and re-apply per
		// flags (default keeps '+', the space flag alone shows ' ').
		start = 1
		sign = '+'
		if spec.space && !spec.plus {
			sign = ' '
		}
	} else if spec.plus {
		sign = '+'
	} else if spec.space {
		sign = ' '
	}
	if sign != 0 {
		out.WriteByte(sign)
	}
	out.Write(s[start:slen])
}

// emitFloat handles `%f %e %g`.
func emitFloat(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case float64:
		emitFloatBody(out, spec, verb, v, 64)
	case float32:
		emitFloatBody(out, spec, verb, cast(float64, v), 32)
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitBool handles `%t`.
func emitBool(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case bool:
		var s @[]char = strconv.FormatBool(v)
		out.Write(s[0:len(s)])
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitChar handles `%c` — an integer operand's low byte as a character.
func emitChar(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case int:
		out.WriteByte(cast(char, v))
	case int64:
		out.WriteByte(cast(char, v))
	case uint64:
		out.WriteByte(cast(char, v))
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitStrBytes writes a string operand's bytes, truncated to spec.prec if given.
func emitStrBytes(out @strings.Builder, spec Spec, bytes *[]readonly char) {
	var blen int = len(bytes)
	var use int = blen
	if spec.prec >= 0 && spec.prec < blen {
		use = spec.prec
	}
	out.Write(bytes[0:use])
}

// emitString handles `%s` — a Binate string is any of the four char-slice
// spellings; any other type is an error verb.
func emitString(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		emitStrBytes(out, spec, v)
	case *[]char:
		emitStrBytes(out, spec, v)
	case @[]readonly char:
		emitStrBytes(out, spec, v[0:len(v)])
	case @[]char:
		emitStrBytes(out, spec, v[0:len(v)])
	default:
		emitBadVerb(out, verb, arg)
	}
}

// emitQuote handles `%q` — a double-quoted string (precision is not applied).
func emitQuote(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		quoteInto(out, v)
	case *[]char:
		quoteInto(out, v)
	case @[]readonly char:
		quoteInto(out, v[0:len(v)])
	case @[]char:
		quoteInto(out, v[0:len(v)])
	default:
		emitBadVerb(out, verb, arg)
	}
}
