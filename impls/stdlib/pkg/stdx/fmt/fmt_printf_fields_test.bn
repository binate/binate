package "pkg/stdx/fmt"

import "pkg/builtins/testing"

// Per-verb field formatting + width/precision/flag padding (fmt_printf_fields.bn).
// Operands are `&`-boxed because the CHECK_TOOLS bnlint predates the implicit
// value→`*any` borrow (see fmt_printf_test.bn); `&x` boxes the same dynamic type,
// so these pin identical formatting.  Expected values are cross-checked against Go.

// Integer bases: %x %X %o %b, including a negative signed value.
func TestSprintfIntBases() testing.TestResult {
	var ff int = 255
	var oo int = 8
	var bb int = 5
	if !sEq(Sprintf("%x %X %o %b", &ff, &ff, &oo, &bb), "ff FF 10 101") {
		return fail("Sprintf int bases")
	}
	var neg int = -255
	if !sEq(Sprintf("%x", &neg), "-ff") {
		return fail("Sprintf negative hex")
	}
	return ""
}

// %d over int64 / uint64.
func TestSprintfIntWidths() testing.TestResult {
	var a int64 = -9000000000
	var b uint64 = 18000000000
	if !sEq(Sprintf("%d %d", &a, &b), "-9000000000 18000000000") {
		return fail("Sprintf int64/uint64")
	}
	return ""
}

// Floats: %f and %e default to 6 digits, %g is shortest; float32 too.
func TestSprintfFloats() testing.TestResult {
	var pi float64 = 3.14
	var k float64 = 1000.0
	var h float64 = 1.5
	if !sEq(Sprintf("%f %e %g", &pi, &k, &h), "3.140000 1.000000e+03 1.5") {
		return fail("Sprintf float verbs")
	}
	var f float32 = 2.5
	if !sEq(Sprintf("%g", &f), "2.5") {
		return fail("Sprintf float32")
	}
	return ""
}

// %c writes an integer operand's byte as a character.
func TestSprintfChar() testing.TestResult {
	var cH int = 72
	var ci int = 105
	if !sEq(Sprintf("%c%c", &cH, &ci), "Hi") {
		return fail("Sprintf %c")
	}
	return ""
}

// Error verbs: a verb the operand's type cannot satisfy renders visibly.
func TestSprintfBadVerb() testing.TestResult {
	var s *[]readonly char = "hi"
	if !sEq(Sprintf("%d", &s), "%!d(string=hi)") {
		return fail("Sprintf %d of string -> bad verb")
	}
	var n int = 7
	if !sEq(Sprintf("%s", &n), "%!s(int=7)") {
		return fail("Sprintf %s of int -> bad verb")
	}
	var one int = 1
	if !sEq(Sprintf("%z", &one), "%!z(int=1)") {
		return fail("Sprintf unknown verb")
	}
	return ""
}

// Width, and the `-` (left-justify) flag, over ints and strings.
func TestSprintfWidth() testing.TestResult {
	var n int = 7
	if !sEq(Sprintf("[%5d]", &n), "[    7]") {
		return fail("Sprintf %5d")
	}
	if !sEq(Sprintf("[%-5d]", &n), "[7    ]") {
		return fail("Sprintf %-5d")
	}
	var s *[]readonly char = "hi"
	if !sEq(Sprintf("[%10s]", &s), "[        hi]") {
		return fail("Sprintf %10s")
	}
	if !sEq(Sprintf("[%-10s]", &s), "[hi        ]") {
		return fail("Sprintf %-10s")
	}
	var wide int = 12345
	if !sEq(Sprintf("[%3d]", &wide), "[12345]") {
		return fail("Sprintf width narrower than value")
	}
	return ""
}

// Sign flags (`+`, space) and zero-padding, including sign+zero placement.
func TestSprintfSignZero() testing.TestResult {
	var n int = 7
	if !sEq(Sprintf("%+d", &n), "+7") {
		return fail("Sprintf %+d")
	}
	if !sEq(Sprintf("% d", &n), " 7") {
		return fail("Sprintf space-flag")
	}
	if !sEq(Sprintf("%05d", &n), "00007") {
		return fail("Sprintf %05d")
	}
	if !sEq(Sprintf("%+05d", &n), "+0007") {
		return fail("Sprintf %+05d (zeros after sign)")
	}
	var neg int = -42
	if !sEq(Sprintf("%05d", &neg), "-0042") {
		return fail("Sprintf %05d negative")
	}
	if !sEq(Sprintf("%+5d", &neg), "  -42") {
		return fail("Sprintf %+5d negative (space pad)")
	}
	return ""
}

// `#` alternate form: `0x`/`0X`/`0`/`0b` prefixes.  Under zero-pad the prefix is
// counted toward the width (an intentional divergence from Go, which excludes it:
// `%#08x` of 255 is "0x0000ff" here vs Go's "0x000000ff").
func TestSprintfHash() testing.TestResult {
	var ff int = 255
	var oo int = 8
	var bb int = 5
	if !sEq(Sprintf("%#x %#X %#o %#b", &ff, &ff, &oo, &bb), "0xff 0XFF 010 0b101") {
		return fail("Sprintf # prefixes")
	}
	var zero int = 0
	if !sEq(Sprintf("%#x", &zero), "0x0") {
		return fail("Sprintf %#x of 0")
	}
	if !sEq(Sprintf("[%#8x][%-#8x]", &ff, &ff), "[    0xff][0xff    ]") {
		return fail("Sprintf %#8x width")
	}
	if !sEq(Sprintf("%#08x %+#08x", &ff, &ff), "0x0000ff +0x000ff") {
		return fail("Sprintf %#08x (intuitive width)")
	}
	return ""
}

// %x/%X on a string hex-encodes the bytes; the space flag separates bytes and `#`
// prefixes them (per byte when both are set).
func TestSprintfStrHex() testing.TestResult {
	var hi *[]readonly char = "hi"
	if !sEq(Sprintf("%x %X % x %#x %# x", &hi, &hi, &hi, &hi, &hi),
			"6869 6869 68 69 0x6869 0x68 0x69") {
		return fail("Sprintf string-hex forms")
	}
	if !sEq(Sprintf("[%8x][%-8x][%08x]", &hi, &hi, &hi), "[    6869][6869    ][00006869]") {
		return fail("Sprintf string-hex width (0 flag zero-pads)")
	}
	return ""
}

// The `0` flag zero-pads EVERY verb (Go), not just numbers: zeros go after a
// numeric sign but at the very front of a string (even one starting with `-`).
func TestSprintfZeroPadAllVerbs() testing.TestResult {
	var hi *[]readonly char = "hi"
	if !sEq(Sprintf("%08s", &hi), "000000hi") {
		return fail("Sprintf %08s zero-pads a string")
	}
	var neg5 *[]readonly char = "-5"
	if !sEq(Sprintf("%08s", &neg5), "000000-5") {
		return fail("Sprintf %08s of \"-5\" zeros at the front")
	}
	var n int = 7
	if !sEq(Sprintf("%010v", &n), "0000000007") {
		return fail("Sprintf %010v int")
	}
	var neg int = -42
	if !sEq(Sprintf("%010v", &neg), "-000000042") {
		return fail("Sprintf %010v negative (zeros after sign)")
	}
	var t bool = true
	if !sEq(Sprintf("%06t", &t), "00true") {
		return fail("Sprintf %06t")
	}
	var code int = 65
	if !sEq(Sprintf("%05c", &code), "0000A") {
		return fail("Sprintf %05c")
	}
	return ""
}

// Inf / NaN: signed correctly (no double `+`) and always space-padded, never
// zero-padded (Go).  Inf/NaN are produced by overflow rather than a literal.
func TestSprintfInfNaN() testing.TestResult {
	var big float64 = 1.0e308
	var inf float64 = big * 10.0
	var ninf float64 = -inf
	var nan float64 = inf - inf
	if !sEq(Sprintf("%+e", &inf), "+Inf") {
		return fail("Sprintf %+e of +Inf (no double sign)")
	}
	if !sEq(Sprintf("% e", &inf), " Inf") {
		return fail("Sprintf % e of +Inf")
	}
	if !sEq(Sprintf("[%012e]", &inf), "[        +Inf]") {
		return fail("Sprintf %012e of +Inf space-pads")
	}
	if !sEq(Sprintf("[%012e]", &ninf), "[        -Inf]") {
		return fail("Sprintf %012e of -Inf")
	}
	if !sEq(Sprintf("[%012e]", &nan), "[         NaN]") {
		return fail("Sprintf %012e of NaN")
	}
	return ""
}

// Precision: min integer digits (incl. the precision-0-of-0 empty rule), float
// digits, and string truncation; and width+precision combos.
func TestSprintfPrecision() testing.TestResult {
	var n int = 42
	if !sEq(Sprintf("%.5d", &n), "00042") {
		return fail("Sprintf %.5d")
	}
	if !sEq(Sprintf("[%8.5d]", &n), "[   00042]") {
		return fail("Sprintf %8.5d")
	}
	var zero int = 0
	if !sEq(Sprintf("[%.0d]", &zero), "[]") {
		return fail("Sprintf %.0d of 0 -> empty")
	}
	var pi float64 = 3.14159
	if !sEq(Sprintf("%.2f", &pi), "3.14") {
		return fail("Sprintf %.2f")
	}
	if !sEq(Sprintf("[%8.2f]", &pi), "[    3.14]") {
		return fail("Sprintf %8.2f")
	}
	if !sEq(Sprintf("%08.2f", &pi), "00003.14") {
		return fail("Sprintf %08.2f")
	}
	var neg float64 = -3.1
	if !sEq(Sprintf("%08.2f", &neg), "-0003.10") {
		return fail("Sprintf %08.2f negative")
	}
	var hello *[]readonly char = "hello"
	if !sEq(Sprintf("%.3s", &hello), "hel") {
		return fail("Sprintf %.3s truncate")
	}
	if !sEq(Sprintf("[%6.3s]", &hello), "[   hel]") {
		return fail("Sprintf %6.3s")
	}
	return ""
}
