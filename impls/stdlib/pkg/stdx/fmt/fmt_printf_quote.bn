package "pkg/stdx/fmt"

import "pkg/std/strings"

// `%q` quoting for the Printf family (split from fmt_printf_fields.bn for length).
// Binate char is uint8, so this quotes byte by byte — not Go's full multi-byte
// rune quoting — but matches Go for the ASCII / byte-oriented cases.

// writeHexEscape writes byte c as a `\xNN` escape.
func writeHexEscape(b @strings.Builder, c char) {
	var digits *[]readonly char = "0123456789abcdef"
	var v int = cast(int, c)
	b.WriteByte('\\')
	b.WriteByte('x')
	b.WriteByte(digits[v / 16])
	b.WriteByte(digits[v % 16])
}

// quoteEscape writes byte c inside a quoted run delimited by `quote`, escaping the
// delimiter, backslash, the C-style control chars (\a \b \f \n \r \t \v), and any
// other non-printable byte as `\xNN` — matching Go's `%q` for a byte-oriented
// value.
func quoteEscape(b @strings.Builder, c char, quote char) {
	if c == quote || c == '\\' {
		b.WriteByte('\\')
		b.WriteByte(c)
	} else if c == 7 {
		b.WriteByte('\\')
		b.WriteByte('a')
	} else if c == 8 {
		b.WriteByte('\\')
		b.WriteByte('b')
	} else if c == 9 {
		b.WriteByte('\\')
		b.WriteByte('t')
	} else if c == 10 {
		b.WriteByte('\\')
		b.WriteByte('n')
	} else if c == 11 {
		b.WriteByte('\\')
		b.WriteByte('v')
	} else if c == 12 {
		b.WriteByte('\\')
		b.WriteByte('f')
	} else if c == 13 {
		b.WriteByte('\\')
		b.WriteByte('r')
	} else if c < 32 || c > 126 {
		writeHexEscape(b, c)
	} else {
		b.WriteByte(c)
	}
}

// quoteInto writes a double-quoted rendering of bytes (the `%q` of a string).
func quoteInto(b @strings.Builder, bytes *[]readonly char) {
	b.WriteByte('"')
	for i := 0; i < len(bytes); i++ {
		quoteEscape(b, bytes[i], '"')
	}
	b.WriteByte('"')
}

// quoteByteInto writes a single-quoted rendering of one byte (the `%q` of a
// char/int — a byte, not a multi-byte rune, since Binate char is uint8).
func quoteByteInto(b @strings.Builder, c char) {
	b.WriteByte('\'')
	quoteEscape(b, c, '\'')
	b.WriteByte('\'')
}

// emitQuote handles `%q` — a double-quoted string (precision truncates the input
// bytes first), or a single-quoted char for an integer operand.
func emitQuote(out @strings.Builder, spec Spec, verb char, arg *any) {
	switch v := arg.(type) {
	case *[]readonly char:
		quoteInto(out, strPrecSlice(v, spec))
	case *[]char:
		quoteInto(out, strPrecSlice(v, spec))
	case @[]readonly char:
		quoteInto(out, strPrecSlice(v[0:len(v)], spec))
	case @[]char:
		quoteInto(out, strPrecSlice(v[0:len(v)], spec))
	default:
		// An integer of any width quotes as a single-quoted byte (char is uint8).
		var iv int64
		var uv uint64
		var signed bool
		var ok bool
		iv, uv, signed, ok = intOperand(arg)
		if !ok {
			emitBadVerb(out, verb, arg)
			return
		}
		if signed {
			quoteByteInto(out, cast(char, iv))
		} else {
			quoteByteInto(out, cast(char, uv))
		}
	}
}
