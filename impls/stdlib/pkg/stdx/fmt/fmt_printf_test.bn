package "pkg/stdx/fmt"

import "pkg/builtins/testing"

// Operands are `&`-boxed here (not passed bare) because the CHECK_TOOLS bnlint
// that hygiene runs predates the implicit value→`*any` borrow and would reject a
// bare `Sprintf("%d", 7)`.  `&x` boxes the same dynamic type a bare operand
// would, so these pin identical formatting; the bare-operand form is covered by
// the (non-linted) conformance tests 1090 / 1135.

// Verbs, literal runs, and %% — the common case.
func TestSprintfBasic() testing.TestResult {
	var w *[]readonly char = "world"
	var n int = 7
	var t bool = true
	if !sEq(Sprintf("%s=%d ok=%t", &w, &n, &t), "world=7 ok=true") {
		return fail("Sprintf %s/%d/%t basic")
	}
	var fifty int = 50
	var v42 int = 42
	if !sEq(Sprintf("%d%% v=%v", &fifty, &v42), "50% v=42") {
		return fail("Sprintf %% and %v")
	}
	var one int = 1
	if !sEq(Sprintf("plain text, no verbs", &one), "plain text, no verbs%!(EXTRA int=1)") {
		return fail("Sprintf literal run + unused operand")
	}
	if !sEq(Sprintf(""), "") {
		return fail("Sprintf empty format")
	}
	return ""
}

// Integer bases: %x %X %o %b, including a negative signed value.
func TestSprintfIntBases() testing.TestResult {
	var ff int = 255
	var oo int = 8
	var bb int = 5
	if !sEq(Sprintf("%x %X %o %b", &ff, &ff, &oo, &bb), "ff FF 10 101") {
		return fail("Sprintf int bases")
	}
	var neg int = -255
	if !sEq(Sprintf("%x", &neg), "-ff") {
		return fail("Sprintf negative hex")
	}
	return ""
}

// %d over int64 / uint64.
func TestSprintfIntWidths() testing.TestResult {
	var a int64 = -9000000000
	var b uint64 = 18000000000
	if !sEq(Sprintf("%d %d", &a, &b), "-9000000000 18000000000") {
		return fail("Sprintf int64/uint64")
	}
	return ""
}

// Floats: %f and %e default to 6 digits, %g is shortest; float32 too.
func TestSprintfFloats() testing.TestResult {
	var pi float64 = 3.14
	var k float64 = 1000.0
	var h float64 = 1.5
	if !sEq(Sprintf("%f %e %g", &pi, &k, &h), "3.140000 1.000000e+03 1.5") {
		return fail("Sprintf float verbs")
	}
	var f float32 = 2.5
	if !sEq(Sprintf("%g", &f), "2.5") {
		return fail("Sprintf float32")
	}
	return ""
}

// %c writes an integer operand's byte as a character.
func TestSprintfChar() testing.TestResult {
	var cH int = 72
	var ci int = 105
	if !sEq(Sprintf("%c%c", &cH, &ci), "Hi") {
		return fail("Sprintf %c")
	}
	return ""
}

// %q double-quotes a string, escaping quote/backslash/tab/newline.
func TestSprintfQuote() testing.TestResult {
	var q *[]readonly char = "a\tb\"c\\d"
	if !sEq(Sprintf("%q", &q), "\"a\\tb\\\"c\\\\d\"") {
		return fail("Sprintf %q escaping")
	}
	return ""
}

// A managed char-slice string operand renders through %s and %v.
func TestSprintfManagedString() testing.TestResult {
	var m @[]char = "hey"
	if !sEq(Sprintf("%s/%v", &m, &m), "hey/hey") {
		return fail("Sprintf %s/%v over @[]char")
	}
	return ""
}

// Error verbs: a verb the operand's type cannot satisfy renders visibly.
func TestSprintfBadVerb() testing.TestResult {
	var s *[]readonly char = "hi"
	if !sEq(Sprintf("%d", &s), "%!d(string=hi)") {
		return fail("Sprintf %d of string -> bad verb")
	}
	var n int = 7
	if !sEq(Sprintf("%s", &n), "%!s(int=7)") {
		return fail("Sprintf %s of int -> bad verb")
	}
	var one int = 1
	if !sEq(Sprintf("%z", &one), "%!z(int=1)") {
		return fail("Sprintf unknown verb")
	}
	return ""
}

// Operand under- and over-supply, and a trailing bare %.
func TestSprintfArgCountErrors() testing.TestResult {
	var a int = 1
	if !sEq(Sprintf("%d %d", &a), "1 %!d(MISSING)") {
		return fail("Sprintf missing operand")
	}
	var b int = 2
	var c int = 3
	if !sEq(Sprintf("%d", &a, &b, &c), "1%!(EXTRA int=2, int=3)") {
		return fail("Sprintf extra operands")
	}
	if !sEq(Sprintf("x=%"), "x=%!(NOVERB)") {
		return fail("Sprintf trailing bare %")
	}
	// A trailing bare % must still report operands it never consumed.
	if !sEq(Sprintf("%d %", &a, &b), "1 %!(NOVERB)%!(EXTRA int=2)") {
		return fail("Sprintf trailing bare % + unused operand")
	}
	return ""
}
