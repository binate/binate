package "pkg/stdx/fmt"

import "pkg/builtins/testing"

// Struct/default reflection (fmt_reflect.bn): a by-value struct without a
// String() renders its fields as `{…}` via read-bytes-per-kind (P2).  Operands
// are `&`-boxed (the CHECK_TOOLS bnlint lag — see fmt_printf_test.bn); a raw
// `*T` boxes as its pointee, so `&pt` renders identically to a bare `pt` value.

type rfPoint struct {
	x int
	y int
}

type rfMixed struct {
	i int
	u uint
	f float64
	b bool
	s @[]char
	c char
}

type rfInner struct {
	a int
}

type rfOuter struct {
	n   int
	sub rfInner
	p   *int
}

type rfEmpty struct {
}

// A struct of scalars renders `{f0 f1 ...}` (values only, space-separated) for
// %v, %s, and Sprint alike (all funnel through writeArg).
func TestSprintfStructScalars() testing.TestResult {
	var p rfPoint
	p.x = 3
	p.y = 4
	if !sEq(Sprintf("%v", &p), "{3 4}") {
		return fail("Sprintf %v of a struct")
	}
	if !sEq(Sprintf("%s", &p), "{3 4}") {
		return fail("Sprintf %s of a struct (funnels to %v)")
	}
	if !sEq(Sprint(&p), "{3 4}") {
		return fail("Sprint of a struct")
	}
	return ""
}

// Each scalar/string field renders by its KIND + size: signed int, uint, float
// (shortest %g), bool, a char-slice as text, and a bare char/uint8 as a number.
func TestSprintfStructMixedFields() testing.TestResult {
	var m rfMixed
	m.i = -5
	m.u = 42
	m.f = 3.14
	m.b = true
	m.s = "hi"
	m.c = 65
	if !sEq(Sprintf("%v", &m), "{-5 42 3.14 true hi 65}") {
		return fail("Sprintf %v of a mixed-field struct")
	}
	return ""
}

// A nested NAMED struct field recurses (P3); a pointer field renders a `<...>`
// placeholder (pointer-following is a later phase); the scalar field renders in
// full alongside them.
func TestSprintfStructNestedAndPlaceholder() testing.TestResult {
	var o rfOuter
	o.n = 1
	o.sub.a = 9
	if !sEq(Sprintf("%v", &o), "{1 {9} <...>}") {
		return fail("Sprintf %v with a nested struct + pointer placeholder")
	}
	return ""
}

// A fieldless struct renders as `{}`.
func TestSprintfStructEmpty() testing.TestResult {
	var e rfEmpty
	if !sEq(Sprintf("%v", &e), "{}") {
		return fail("Sprintf %v of an empty struct")
	}
	return ""
}

type rfDeepC struct {
	z int
}

type rfDeepB struct {
	y int
	c rfDeepC
}

type rfDeepA struct {
	x int
	b rfDeepB
}

type rfAnonHost struct {
	k  int
	an struct {
		a int
	}
}

// Nested NAMED struct fields recurse at every level (P3); an anonymous struct
// field degrades to a `{...}` placeholder (no nameable record — a follow-up).
func TestSprintfStructDeepAndAnon() testing.TestResult {
	var a rfDeepA
	a.x = 1
	a.b.y = 2
	a.b.c.z = 3
	if !sEq(Sprintf("%v", &a), "{1 {2 {3}}}") {
		return fail("Sprintf %v deep nesting")
	}
	var h rfAnonHost
	h.k = 7
	if !sEq(Sprintf("%v", &h), "{7 {...}}") {
		return fail("Sprintf %v anonymous struct field -> placeholder")
	}
	return ""
}
