package "pkg/stdx/fmt"

import "pkg/builtins/testing"

// Struct/default reflection (fmt_reflect.bn): a by-value struct without a
// String() renders its fields as `{…}` via read-bytes-per-kind (P2).  Operands
// are `&`-boxed (the CHECK_TOOLS bnlint lag — see fmt_printf_test.bn); a raw
// `*T` boxes as its pointee, so `&pt` renders identically to a bare `pt` value.

type rfPoint struct {
	x int
	y int
}

type rfMixed struct {
	i int
	u uint
	f float64
	b bool
	s @[]char
	c char
}

type rfInner struct {
	a int
}

type rfOuter struct {
	n   int
	sub rfInner
	p   *int
}

type rfEmpty struct {
}

// A struct of scalars renders `{f0 f1 ...}` (values only, space-separated) for
// %v, %s, and Sprint alike (all funnel through writeArg).
func TestSprintfStructScalars() testing.TestResult {
	var p rfPoint
	p.x = 3
	p.y = 4
	if !sEq(Sprintf("%v", &p), "{3 4}") {
		return fail("Sprintf %v of a struct")
	}
	if !sEq(Sprintf("%s", &p), "{3 4}") {
		return fail("Sprintf %s of a struct (funnels to %v)")
	}
	if !sEq(Sprint(&p), "{3 4}") {
		return fail("Sprint of a struct")
	}
	return ""
}

// Each scalar/string field renders by its KIND + size: signed int, uint, float
// (shortest %g), bool, a char-slice as text, and a bare char/uint8 as a number.
func TestSprintfStructMixedFields() testing.TestResult {
	var m rfMixed
	m.i = -5
	m.u = 42
	m.f = 3.14
	m.b = true
	m.s = "hi"
	m.c = 65
	if !sEq(Sprintf("%v", &m), "{-5 42 3.14 true hi 65}") {
		return fail("Sprintf %v of a mixed-field struct")
	}
	return ""
}

// A nested NAMED struct field recurses (P3); a nil pointer field renders `<nil>`
// (P4b-2); the scalar field renders in full alongside them.
func TestSprintfStructNestedAndNilPointer() testing.TestResult {
	var o rfOuter
	o.n = 1
	o.sub.a = 9
	if !sEq(Sprintf("%v", &o), "{1 {9} <nil>}") {
		return fail("Sprintf %v with a nested struct + nil pointer")
	}
	return ""
}

// A fieldless struct renders as `{}`.
func TestSprintfStructEmpty() testing.TestResult {
	var e rfEmpty
	if !sEq(Sprintf("%v", &e), "{}") {
		return fail("Sprintf %v of an empty struct")
	}
	return ""
}

type rfDeepC struct {
	z int
}

type rfDeepB struct {
	y int
	c rfDeepC
}

type rfDeepA struct {
	x int
	b rfDeepB
}

type rfAnonHost struct {
	k  int
	an struct {
		a int
	}
}

// Nested NAMED struct fields recurse at every level (P3); an anonymous struct
// field degrades to a `{...}` placeholder (no nameable record — a follow-up).
func TestSprintfStructDeepAndAnon() testing.TestResult {
	var a rfDeepA
	a.x = 1
	a.b.y = 2
	a.b.c.z = 3
	if !sEq(Sprintf("%v", &a), "{1 {2 {3}}}") {
		return fail("Sprintf %v deep nesting")
	}
	var h rfAnonHost
	h.k = 7
	if !sEq(Sprintf("%v", &h), "{7 {...}}") {
		return fail("Sprintf %v anonymous struct field -> placeholder")
	}
	return ""
}

// `%+v` labels each field `name:value`, recursively for nested structs; a nil
// pointer field's `<nil>` is labeled too.  Plain `%v` stays unlabeled, and `%+v` of
// a non-struct falls back to `%v`.
func TestSprintfStructPlusV() testing.TestResult {
	var p rfPoint
	p.x = 3
	p.y = 4
	if !sEq(Sprintf("%+v", &p), "{x:3 y:4}") {
		return fail("Sprintf %+v labels fields")
	}
	if !sEq(Sprintf("%v", &p), "{3 4}") {
		return fail("Sprintf %v stays unlabeled")
	}
	var o rfOuter
	o.n = 1
	o.sub.a = 9
	if !sEq(Sprintf("%+v", &o), "{n:1 sub:{a:9} p:<nil>}") {
		return fail("Sprintf %+v labels a nested struct + nil pointer")
	}
	var k int = 7
	if !sEq(Sprintf("%+v", &k), "7") {
		return fail("Sprintf %+v of a non-struct falls back to %v")
	}
	return ""
}

type rfArr struct {
	a [3]int
	n int
}

type rfSlices struct {
	ints  @[]int
	bools @[]bool
}

type rfSliceStruct struct {
	pts @[]rfPoint
}

type rfNestedSlice struct {
	rows @[]@[]int
}

type rfCyclic struct {
	label int
	kids  @[]rfCyclic
}

type rfWrapped struct {
	v int
}

type rfWrapper struct {
	inner rfWrapped
}

type rfArrStruct struct {
	pts [2]rfPoint
}

type rfStrs struct {
	tags @[]@[]char
}

type rfPtrHost struct {
	p    *rfPoint
	n    *int
	nilp *rfPoint
}

type rfMptrHost struct {
	p @rfPoint
}

type rfPtrNode struct {
	label int
	next  *rfPtrNode
}

// An array field renders its N (= Size/ElemSize) elements inline as `[e0 e1 ...]`
// (P4b-1); a following scalar field renders alongside it.
func TestSprintfStructArrayField() testing.TestResult {
	var v rfArr
	v.a[0] = 1
	v.a[1] = 2
	v.a[2] = 3
	v.n = 9
	if !sEq(Sprintf("%v", &v), "{[1 2 3] 9}") {
		return fail("Sprintf %v of an array field")
	}
	return ""
}

// A (non-char) slice field renders its live elements as `[e0 e1 ...]`, reading the
// {data,len} header; a nil (zero-value) slice renders `[]` with no element deref.
func TestSprintfStructSliceFields() testing.TestResult {
	var s rfSlices
	s.ints = make_slice(int, 3)
	s.ints[0] = 4
	s.ints[1] = 5
	s.ints[2] = 6
	s.bools = make_slice(bool, 3)
	s.bools[0] = true
	s.bools[1] = false
	s.bools[2] = true
	if !sEq(Sprintf("%v", &s), "{[4 5 6] [true false true]}") {
		return fail("Sprintf %v of int + bool slice fields")
	}
	var empty rfSlices
	if !sEq(Sprintf("%v", &empty), "{[] []}") {
		return fail("Sprintf %v of nil slice fields")
	}
	return ""
}

// A slice of structs recurses into each element via the ELEMENT record (`f.Type`
// points at the element's `__typeinfo` for an array/slice field); `%+v` labels the
// field and each element's fields.
func TestSprintfStructSliceOfStruct() testing.TestResult {
	var s rfSliceStruct
	s.pts = make_slice(rfPoint, 2)
	s.pts[0].x = 1
	s.pts[0].y = 2
	s.pts[1].x = 3
	s.pts[1].y = 4
	if !sEq(Sprintf("%v", &s), "{[{1 2} {3 4}]}") {
		return fail("Sprintf %v of a slice-of-struct field")
	}
	if !sEq(Sprintf("%+v", &s), "{pts:[{x:1 y:2} {x:3 y:4}]}") {
		return fail("Sprintf %+v of a slice-of-struct field")
	}
	return ""
}

// A nested-aggregate element (slice-of-slice) renders a `[...]` placeholder: the
// element record carries only the immediate element kind (KIND_SLICE), not a
// deeper element record, so the inner slice is not walked.
func TestSprintfStructNestedSlicePlaceholder() testing.TestResult {
	var s rfNestedSlice
	s.rows = make_slice(@[]int, 2)
	s.rows[0] = make_slice(int, 2)
	s.rows[1] = make_slice(int, 1)
	if !sEq(Sprintf("%v", &s), "{[[...] [...]]}") {
		return fail("Sprintf %v of a nested slice -> element placeholder")
	}
	return ""
}

// A slice-backed self-cycle (`t.kids[0] = t` — itself a refcount cycle, i.e. user
// error) renders `{...}` at the re-entry point instead of overflowing the stack.
// The (base, TypeInfo) guard fires when the same struct base+type reappears on the
// active render path.
func TestSprintfStructCycle() testing.TestResult {
	var c rfCyclic
	c.label = 7
	c.kids = make_slice(rfCyclic, 1)
	c.kids[0] = c // kids[0].kids now aliases c.kids's backing -> cycle
	if !sEq(Sprintf("%v", &c), "{7 [{7 [{...}]}]}") {
		return fail("Sprintf %v of a cyclic struct should render {...} at re-entry")
	}
	return ""
}

// A single-field wrapper whose inner struct shares the outer's base address (offset
// 0, equal size) must NOT read as a cycle — the guard keys on (base, TypeInfo), and
// the two types differ, so the inner struct renders in full.
func TestSprintfStructWrapperNotCycle() testing.TestResult {
	var w rfWrapper
	w.inner.v = 5
	if !sEq(Sprintf("%v", &w), "{{5}}") {
		return fail("Sprintf %v of a base-sharing single-field wrapper (not a cycle)")
	}
	return ""
}

// An array of structs recurses into each element (the array/struct-element path,
// vs. the slice-of-struct case above) for both `%v` and `%+v`.
func TestSprintfStructArrayOfStruct() testing.TestResult {
	var v rfArrStruct
	v.pts[0].x = 1
	v.pts[0].y = 2
	v.pts[1].x = 3
	v.pts[1].y = 4
	if !sEq(Sprintf("%v", &v), "{[{1 2} {3 4}]}") {
		return fail("Sprintf %v of an array-of-struct field")
	}
	if !sEq(Sprintf("%+v", &v), "{pts:[{x:1 y:2} {x:3 y:4}]}") {
		return fail("Sprintf %+v of an array-of-struct field")
	}
	return ""
}

// A slice whose ELEMENT is itself a char-slice renders each element as text — the
// element resolves to KIND_STRING (a distinct element path from scalars/structs).
func TestSprintfStructSliceOfStrings() testing.TestResult {
	var s rfStrs
	s.tags = make_slice(@[]char, 2)
	s.tags[0] = "foo"
	s.tags[1] = "bar"
	if !sEq(Sprintf("%v", &s), "{[foo bar]}") {
		return fail("Sprintf %v of a slice-of-char-slices (KIND_STRING elements)")
	}
	return ""
}

// A pointer field is followed to its pointee, `&`-prefixed (`&{3 4}` for a struct
// pointee, `&5` for a scalar); a nil pointer renders `<nil>` (P4b-2).  `%+v` labels
// the field and the struct pointee's fields.
func TestSprintfStructPointerFields() testing.TestResult {
	var pt rfPoint
	pt.x = 3
	pt.y = 4
	var k int = 5
	var h rfPtrHost
	h.p = &pt
	h.n = &k
	if !sEq(Sprintf("%v", &h), "{&{3 4} &5 <nil>}") {
		return fail("Sprintf %v of pointer fields")
	}
	if !sEq(Sprintf("%+v", &h), "{p:&{x:3 y:4} n:&5 nilp:<nil>}") {
		return fail("Sprintf %+v of pointer fields")
	}
	return ""
}

// A managed-pointer (`@T`) field follows identically to a raw `*T` — both store the
// pointee's payload address (the managed header is at a negative offset).
func TestSprintfStructManagedPointerField() testing.TestResult {
	var h rfMptrHost
	h.p = make(rfPoint)
	h.p.x = 1
	h.p.y = 2
	if !sEq(Sprintf("%v", &h), "{&{1 2}}") {
		return fail("Sprintf %v of a managed-pointer field")
	}
	return ""
}

// A self-referential pointer (`n.next = &n`, itself a refcount cycle / user error)
// renders `&{...}` at the re-entry — the base-keyed cycle guard fires on the pointee
// whose base is already on the active render path.
func TestSprintfStructPointerCycle() testing.TestResult {
	var n rfPtrNode
	n.label = 7
	n.next = &n
	if !sEq(Sprintf("%v", &n), "{7 &{...}}") {
		return fail("Sprintf %v of a self-referential pointer -> {7 &{...}}")
	}
	return ""
}
