package "pkg/stdx/fmt"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult {
	return msg
}

// sEq compares a formatted result (a readonly borrow) to a literal.
func sEq(got *[]readonly char, want *[]readonly char) bool {
	if len(got) != len(want) {
		return false
	}
	for i := 0; i < len(got); i++ {
		if got[i] != want[i] {
			return false
		}
	}
	return true
}

// A single raw-string operand renders verbatim.
func TestSprintRawString() testing.TestResult {
	var s *[]readonly char = "hi"
	var out @[]readonly char = Sprint(&s)
	if !sEq(out, "hi") {
		return fail("Sprint(string) should be \"hi\"")
	}
	return ""
}

// A managed char-slice operand also renders verbatim (the `@[]char` case).
func TestSprintManagedString() testing.TestResult {
	var m @[]char = "hey"
	var out @[]readonly char = Sprint(&m)
	if !sEq(out, "hey") {
		return fail("Sprint(@[]char) should be \"hey\"")
	}
	return ""
}

// A single int operand renders via strconv (value recovery).
func TestSprintInt() testing.TestResult {
	var n int = 42
	var out @[]readonly char = Sprint(&n)
	if !sEq(out, "42") {
		return fail("Sprint(42) should be \"42\"")
	}
	return ""
}

// bool and float operands render too.
func TestSprintBoolFloat() testing.TestResult {
	var b bool = true
	if !sEq(Sprint(&b), "true") {
		return fail("Sprint(true) should be \"true\"")
	}
	var f float64 = 3.5
	if !sEq(Sprint(&f), "3.5") {
		return fail("Sprint(3.5) should be \"3.5\"")
	}
	return ""
}

// Fprint's rule: NO space between a string operand and a following non-string.
func TestSprintStringThenIntNoSpace() testing.TestResult {
	var eq *[]readonly char = "x="
	var n int = 42
	var out @[]readonly char = Sprint(&eq, &n)
	if !sEq(out, "x=42") {
		return fail("Sprint(\"x=\", 42) should be \"x=42\" (no space)")
	}
	return ""
}

// Fprint's rule: a space IS added between two non-string operands.
func TestSprintIntThenIntSpace() testing.TestResult {
	var a int = 1
	var b int = 2
	var out @[]readonly char = Sprint(&a, &b)
	if !sEq(out, "1 2") {
		return fail("Sprint(1, 2) should be \"1 2\" (space between non-strings)")
	}
	return ""
}

// Sprintln spaces ALL operands and appends a newline.
func TestSprintlnSpacesAndNewline() testing.TestResult {
	var a *[]readonly char = "a"
	var n int = 2
	var out @[]readonly char = Sprintln(&a, &n)
	if !sEq(out, "a 2\n") {
		return fail("Sprintln(\"a\", 2) should be \"a 2\\n\"")
	}
	return ""
}

// No operands: Sprint is empty, Sprintln is just a newline.
func TestSprintEmpty() testing.TestResult {
	if !sEq(Sprint(), "") {
		return fail("Sprint() should be empty")
	}
	if !sEq(Sprintln(), "\n") {
		return fail("Sprintln() should be \"\\n\"")
	}
	return ""
}
