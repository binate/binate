package "pkg/stdx/hash"

import "pkg/builtins/lang"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// bucket exercises a Hasher through a monomorphized constraint slot — the shape a
// hash container uses (`H Hasher[K]`), so the tests cover the policy-as-type-param
// path and not just direct method calls.
func bucket[K any, H Hasher[K]](h H, k K) uint {
	return h.Hash(k)
}

func tripleHash(x int) uint { return cast(uint, x * 3) }

// Default forwards to the key type's own lang.Hashable.Hash.
func TestDefaultForwardsToKeyHash() testing.TestResult {
	var d Default[int]
	var k int = 7
	if d.Hash(k) != k.Hash() {
		return fail("Default[int].Hash should equal key.Hash()")
	}
	return ""
}

// FnHasher routes each hash through the injected function.
func TestFnHasherCallsFn() testing.TestResult {
	var h FnHasher[int] = Fn[int](tripleHash)
	if h.Hash(4) != cast(uint, 12) {
		return fail("FnHasher.Hash should call the injected fn (4*3 == 12)")
	}
	return ""
}

// Both adapters satisfy Hasher[K] as a monomorphized policy type argument.
func TestHasherAsPolicy() testing.TestResult {
	var d Default[int]
	var k int = 5
	if bucket[int, Default[int]](d, k) != k.Hash() {
		return fail("Default should work as a Hasher policy")
	}
	var h FnHasher[int] = Fn[int](tripleHash)
	if bucket[int, FnHasher[int]](h, 4) != cast(uint, 12) {
		return fail("FnHasher should work as a Hasher policy")
	}
	return ""
}
