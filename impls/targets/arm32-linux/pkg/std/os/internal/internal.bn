// arm32-linux impl of pkg/std/os/internal.  Linux reaches the C errno
// through `int *__errno_location(void)`.  Selecting this file per target (via
// impls/targets/arm32-linux) means only __errno_location is referenced when
// building for Linux/arm32 — the Darwin __error never has to link.
package "pkg/std/os/internal"

// Errno returns the current value of the C errno (thread-local).
func Errno() int {
	var p *int32 = __c_call("__errno_location", *int32)
	return cast(int, p[0])
}
