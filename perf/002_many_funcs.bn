package "main"

// Lots of code, trivial runtime. Each function does a small
// amount of arithmetic so the body is non-trivial to parse,
// type-check, and (for int) compile to bytecode. main calls
// just one of them, so total runtime is tiny — this isolates
// per-source-size fixed overheads from per-iteration cost.

func f001(x int) int {
	var a int = x + 1
	var b int = x * 2
	var c int = a - b
	if c > 0 { return c + 1 }
	return c - 1
}

func f002(x int) int {
