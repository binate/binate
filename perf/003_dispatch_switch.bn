package "main"

import "pkg/std/fmt"

// Dispatch micro-benchmark (paired with 004_dispatch_ifchain): a hot loop selecting among 48
// dense integer cases via switch.  Purpose: measure how switch/if-chain dispatch
// lowers per backend.  Today both are a linear compare chain at -O0 native and
// in bytecode (VM), so this ~matches its if-chain twin.  After the IR-level
// multi-way-branch lowering (LLVM `switch` / bytecode `BC_SWITCH`), the SWITCH
// form should become O(1) (jump table) and pull ahead of the if-chain — the
// gap is the win.  Kept out of perf/run.sh's toy set only by number; it runs
// under every non-arm32 perf mode.

func dispatch(op int) int {
	switch op {
	case 0:
		return 7
	case 1:
		return 38
	case 2:
		return 21
	case 3:
		return 4
	case 4:
		return 35
	case 5:
		return 18
	case 6:
		return 1
	case 7:
		return 32
	case 8:
		return 15
	case 9:
		return 46
	case 10:
		return 29
	case 11:
		return 12
	case 12:
		return 43
	case 13:
		return 26
	case 14:
		return 9
	case 15:
		return 40
	case 16:
		return 23
	case 17:
		return 6
	case 18:
		return 37
	case 19:
		return 20
	case 20:
		return 3
	case 21:
		return 34
	case 22:
		return 17
	case 23:
		return 0
	case 24:
		return 31
	case 25:
		return 14
	case 26:
		return 45
	case 27:
		return 28
	case 28:
		return 11
	case 29:
		return 42
	case 30:
		return 25
	case 31:
		return 8
	case 32:
		return 39
	case 33:
		return 22
	case 34:
		return 5
	case 35:
		return 36
	case 36:
		return 19
	case 37:
		return 2
	case 38:
		return 33
	case 39:
		return 16
	case 40:
		return 47
	case 41:
		return 30
	case 42:
		return 13
	case 43:
		return 44
	case 44:
		return 27
	case 45:
		return 10
	case 46:
		return 41
	case 47:
		return 24
	default:
		return 0
	}
}

func main() {
	var sum int = 0
	var i int = 0
	for i < 4800000 {
		sum = sum + dispatch(i % 48)
		i = i + 1
	}
	fmt.Println(sum)
}
