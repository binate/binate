package "main"

import "pkg/std/fmt"

// Dispatch micro-benchmark (paired with 003_dispatch_switch): a hot loop selecting among 48
// dense integer cases via ifchain.  Purpose: measure how switch/if-chain dispatch
// lowers per backend.  Today both are a linear compare chain at -O0 native and
// in bytecode (VM), so this ~matches its switch twin.  After the IR-level
// multi-way-branch lowering (LLVM `switch` / bytecode `BC_SWITCH`), the SWITCH
// form should become O(1) (jump table) and pull ahead of the if-chain — the
// gap is the win.  Kept out of perf/run.sh's toy set only by number; it runs
// under every non-arm32 perf mode.

func dispatch(op int) int {
	if op == 0 {
		return 7
	}
	if op == 1 {
		return 38
	}
	if op == 2 {
		return 21
	}
	if op == 3 {
		return 4
	}
	if op == 4 {
		return 35
	}
	if op == 5 {
		return 18
	}
	if op == 6 {
		return 1
	}
	if op == 7 {
		return 32
	}
	if op == 8 {
		return 15
	}
	if op == 9 {
		return 46
	}
	if op == 10 {
		return 29
	}
	if op == 11 {
		return 12
	}
	if op == 12 {
		return 43
	}
	if op == 13 {
		return 26
	}
	if op == 14 {
		return 9
	}
	if op == 15 {
		return 40
	}
	if op == 16 {
		return 23
	}
	if op == 17 {
		return 6
	}
	if op == 18 {
		return 37
	}
	if op == 19 {
		return 20
	}
	if op == 20 {
		return 3
	}
	if op == 21 {
		return 34
	}
	if op == 22 {
		return 17
	}
	if op == 23 {
		return 0
	}
	if op == 24 {
		return 31
	}
	if op == 25 {
		return 14
	}
	if op == 26 {
		return 45
	}
	if op == 27 {
		return 28
	}
	if op == 28 {
		return 11
	}
	if op == 29 {
		return 42
	}
	if op == 30 {
		return 25
	}
	if op == 31 {
		return 8
	}
	if op == 32 {
		return 39
	}
	if op == 33 {
		return 22
	}
	if op == 34 {
		return 5
	}
	if op == 35 {
		return 36
	}
	if op == 36 {
		return 19
	}
	if op == 37 {
		return 2
	}
	if op == 38 {
		return 33
	}
	if op == 39 {
		return 16
	}
	if op == 40 {
		return 47
	}
	if op == 41 {
		return 30
	}
	if op == 42 {
		return 13
	}
	if op == 43 {
		return 44
	}
	if op == 44 {
		return 27
	}
	if op == 45 {
		return 10
	}
	if op == 46 {
		return 41
	}
	if op == 47 {
		return 24
	}
	return 0
}

func main() {
	var sum int = 0
	var i int = 0
	for i < 4800000 {
		sum = sum + dispatch(i % 48)
		i = i + 1
	}
	fmt.Println(sum)
}
