package "main"

import "pkg/stdx/fmt"

// Memory-access micro: fill a managed slice, then repeatedly sum it.  Each a[i]
// is a bounds-checked load/store, so the hot loop hammers execMemoryOp +
// rt.BoundsCheck — the dominant path in real programs (bnc/bnlint profiles),
// which fib barely exercises.  Paired with 001_fib (call/arith) and
// 006_string_scan (char/string).
func main() {
	var n int = 1024
	var a @[]int = make_slice(int, n)
	var i int = 0
	for i < n {
		a[i] = (i * 31 + 7) % 97
		i = i + 1
	}
	var sum int = 0
	var iter int = 0
	for iter < 6000 {
		var j int = 0
		for j < n {
			sum = sum + a[j]
			j = j + 1
		}
		iter = iter + 1
	}
	fmt.Println(sum)
}
