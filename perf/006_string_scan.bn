package "main"

import "pkg/stdx/fmt"

// String/char-scan micro: repeatedly scan a readonly-char string counting a
// character.  Each s[i] is a char load + compare, exercising the string/char
// access path (execStringOp / char loads) that real text-processing hits and
// fib does not.
func main() {
	var s *[]readonly char = "the quick brown fox jumps over the lazy dog 0123456789 aeiou"
	var count int = 0
	var iter int = 0
	for iter < 120000 {
		var i int = 0
		for i < len(s) {
			if s[i] == 'o' {
				count = count + 1
			}
			i = i + 1
		}
		iter = iter + 1
	}
	fmt.Println(count)
}
