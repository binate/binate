package "main"

import "pkg/std/fmt"

// Bucket-count micro (cross-block reload isolation for the native reload work).
// For each element of a slice, an inner if/else-if chain classifies it into one
// of five buckets by comparing against four thresholds, incrementing that
// bucket's counter.  The chain splits the loop body into several basic blocks;
// the thresholds (loop-invariant, derived from the data at runtime so they are
// held in registers/home slots rather than folded to compare immediates) and
// the five counters stay live across those blocks.  With this many live values
// the native register allocator homes several to stack slots, and because its
// within-block retention cache resets at each block boundary, every block
// re-loads them — the cross-block reload / dead-load the native backend still
// emits where clang keeps the values in registers across the whole loop body.
// Paired with 008_reg_pressure (the regression counterweight): a reload
// optimization should speed this up without regressing the pressured case.
//
// All arithmetic stays within the signed 32-bit range and the per-pass counters
// reset each iteration, so the result is identical on 32- and 64-bit int.
func main() {
	var n int = 2048
	var a @[]int = make_slice(int, n)
	var i int = 0
	for i < n {
		a[i] = (i * 31 + 7) % 1000
		i = i + 1
	}
	// Thresholds derived from a runtime load so they can't fold to compare
	// immediates — they must occupy registers / home slots across the chain.
	var base int = a[0]
	var t0 int = base + 120
	var t1 int = base + 240
	var t2 int = base + 480
	var t3 int = base + 720
	var c0 int = 0
	var c1 int = 0
	var c2 int = 0
	var c3 int = 0
	var c4 int = 0
	var iter int = 0
	for iter < 3000 {
		c0 = 0
		c1 = 0
		c2 = 0
		c3 = 0
		c4 = 0
		var j int = 0
		for j < n {
			var x int = a[j]
			if x < t0 {
				c0 = c0 + 1
			} else if x < t1 {
				c1 = c1 + 1
			} else if x < t2 {
				c2 = c2 + 1
			} else if x < t3 {
				c3 = c3 + 1
			} else {
				c4 = c4 + 1
			}
			j = j + 1
		}
		iter = iter + 1
	}
	fmt.Println(c0 + c1 * 2 + c2 * 3 + c3 * 4 + c4 * 5)
}
