package "main"

import "pkg/std/fmt"

// Register-pressure micro (regression counterweight for the native reload work).
// A single pass over a slice updates MANY running aggregates at once — eight
// running reductions plus a min/max pair with their own inner branches — so the
// loop body keeps far more values live than there are allocatable registers,
// and the native allocator is already spilling here.  A reload optimization
// that keeps more values resident across blocks must NOT worsen this case:
// holding longer live ranges in registers means more spills elsewhere (the
// interval-splitting regression the home-more experiment hit).  An optimization
// that speeds up 007_bucket_count but regresses this is not a net win.
//
// Aggregates reset each pass so the totals stay within the signed 32-bit range
// (identical result on 32- and 64-bit int).
func main() {
	var n int = 1024
	var a @[]int = make_slice(int, n)
	var i int = 0
	for i < n {
		a[i] = (i * 37 + 11) % 251
		i = i + 1
	}
	var s0 int = 0
	var s1 int = 0
	var s2 int = 0
	var s3 int = 0
	var s4 int = 0
	var s5 int = 0
	var s6 int = 0
	var s7 int = 0
	var mn int = 0
	var mx int = 0
	var iter int = 0
	for iter < 5000 {
		s0 = 0
		s1 = 0
		s2 = 0
		s3 = 0
		s4 = 0
		s5 = 0
		s6 = 0
		s7 = 0
		mn = 1000000
		mx = 0
		var j int = 0
		for j < n {
			var x int = a[j]
			s0 = s0 + x
			s1 = s1 ^ x
			s2 = s2 + (x & 15)
			s3 = s3 + (x | 1)
			s4 = s4 + x * 3
			s5 = s5 + (x - j)
			s6 = s6 + x % 7
			s7 = s7 + ((x + j) & 63)
			if x < mn {
				mn = x
			}
			if x > mx {
				mx = x
			}
			j = j + 1
		}
		iter = iter + 1
	}
	fmt.Println(s0 + s1 + s2 + s3 + s4 + s5 + s6 + s7 + mn + mx)
}
