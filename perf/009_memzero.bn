package "main"

import "pkg/std/fmt"

// Memory-primitive micro: repeatedly allocate a large managed slice.  Each
// make_slice zero-fills its payload via rt.MemZero, so with a large size the hot
// cost is rt.MemZero on big fills — the DC ZVA / wide-store path.  Touching the
// first and last byte keeps the allocation (and its zeroing) live.
func main() {
	var sz int = 1048576 // 1 MiB — well past per-core cache, so the fill is
	// memory-bandwidth-bound (where DC ZVA's no-read-for-ownership wins most).
	var iters int = 2000
	var acc int = 0
	var it int = 0
	for it < iters {
		var a @[]uint8 = make_slice(uint8, sz)
		acc = acc + cast(int, a[0]) + cast(int, a[sz - 1])
		it = it + 1
	}
	fmt.Println(acc)
}
