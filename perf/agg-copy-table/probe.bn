package "main"

import "pkg/builtins/testing"

// The aggregate-copy table's probe: each function below is one shape a by-value
// aggregate (Big, 808 bytes on 64-bit targets, 404 on 32-bit) takes through a
// call, a return, a local or a field.  perf/agg-copy-table.sh counts the full-size
// copies and zero-fills each one compiles to; main calls them all so the program
// runs and checks the values (it prints "27 3 7").

type Big struct {
	n   int
	arr [100]int
}

type H struct {
	b Big
}

var g Big

func sum(b Big) int { return b.n + b.arr[0] + b.arr[99] }

func mk(k int) Big {
	var b Big
	b.n = k
	b.arr[5] = k
	return b
}

func sumDeref(p *Big) int { return sum(*p) }

func viaLocal(k int) int {
	var x Big = mk(k)
	return sum(x)
}

func direct(k int) int { return sum(mk(k)) }

func retDeref(p *Big) Big { return *p }

func retLocal(k int) Big {
	var x Big = mk(k)
	return x
}

func forward(b Big) int { return sum(b) }

func copyThen(k int) int {
	var x Big = mk(k)
	var y Big = x
	return sum(y)
}

func field(h *H, p *Big) int {
	h.b = *p
	return sum(h.b)
}

func global() int { return sum(g) }

func main() {
	var b Big = mk(3)
	var h H
	var t int = sum(b) + sumDeref(&b) + viaLocal(4) + direct(5) + forward(b) + copyThen(6) +
			field(&h, &b) + global()
	var r Big = retDeref(&b)
	var q Big = retLocal(7)
	testing.Println(t, r.n, q.n)
}
