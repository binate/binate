package "main"

import "pkg/stdx/fmt"

// A minimal "run a real program" payload for the bni_runs_* self-benchmarks
// (perf/self.sh): the interesting cost there is the VM loading + running
// cmd/bni (a large real program), so the payload itself stays trivial.  Its
// output is verified against the "Hello, world!" the benchmark expects.
func main() {
	fmt.Println("Hello, world!")
}
