func TestSubImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SUB X0, SP, #16 = 1|10|100010|0|000000010000|11111|00000
	// = 0xD10043E0
	Sub(a, true, X0, SP, Imm(16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xD10043E0 {
		return fail("SUB X0, SP, #16 encoding wrong")
	}
	return ""
}

// Add/Sub with imm > 4095 must split into two instructions: one with
// sh=1 carrying the high 12 bits (shifted by 12), then one with sh=0
// for the low 12. Pre-fix, dpImmEnc silently masked imm with 0xfff
// and dropped the high bits — so a `sub sp, sp, #0x1380` (frame size
// > 4095) became `sub sp, sp, #0x380`, leaving SP-relative addressing
// pointed at random locations in the caller's frame. Conformance
// stayed green because per-test frames stayed under 4095; the bug
// surfaced under `cmd/bnc --test --backend native`, which inflates
// the test-runner main and intermediate helpers (e.g. PlanFrame's
// compiled body wants a 0x1380-byte frame) past the limit.
func TestAddImmLarge() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD X0, SP, #0x11e0 — frame at 4576 bytes, hits the bug.
	// Expect TWO instructions: ADD X0, SP, #1, lsl #12; ADD X0, X0, #0x1e0
	Add(a, true, X0, SP, Imm(0x11e0))
	if a.Sections[0].Len != 8 {
		return fail("ADD with imm > 4095 should split into two instrs")
	}
	// First insn: sh=1, imm12=1, Rn=31 (SP), Rd=0.
	// = 0x91000000 | (1<<22) | (1<<10) | (31<<5) | 0 = 0x914007E0
	var first uint32 = readInst(a.Sections[0], 0)
	if first != cast(uint32, 0x914007E0) {
		return fail("first ADD should be #1, lsl #12")
	}
	// Second insn: sh=0, imm12=0x1e0, Rn=0 (X0), Rd=0.
	// = 0x91000000 | (0x1e0<<10) | (0<<5) | 0 = 0x91078000
	var second uint32 = readInst(a.Sections[0], 4)
	if second != cast(uint32, 0x91078000) {
		return fail("second ADD should be #0x1e0")
	}
	return ""
}

func TestSubImmLargeFrame() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SUB SP, SP, #0x1380 — the cmin TestCrashy frame size that
	// triggered the bug. Two instructions, sh=1 then sh=0.
	Sub(a, true, SP, SP, Imm(0x1380))
	if a.Sections[0].Len != 8 {
		return fail("SUB with imm > 4095 should split into two instrs")
	}
	// First: SUB SP, SP, #1, lsl #12. SUB_IMM_OPC = 0x51000000;
	// sf=1 → 0xD1000000. sh=1 → +0x00400000. imm12=1 → +0x400.
	// Rn=31 → +0x3E0. Rd=31 → +0x1F. Total = 0xD14007FF.
	var first uint32 = readInst(a.Sections[0], 0)
	if first != cast(uint32, 0xD14007FF) {
		return fail("first SUB should be #1, lsl #12")
	}
	// Second: SUB SP, SP, #0x380. imm12=0x380 → 0x380<<10 = 0xE0000.
	// = 0xD1000000 | 0xE0000 | 0x3FF = 0xD10E03FF
	var second uint32 = readInst(a.Sections[0], 4)
	if second != cast(uint32, 0xD10E03FF) {
		return fail("second SUB should be #0x380")
	}
	return ""
}

// Imm exactly at 4095: single instruction (boundary check).
func TestAddImmAt4095() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, SP, Imm(4095))
	if a.Sections[0].Len != 4 {
		return fail("imm=4095 should be a single instruction")
	}
	return ""
}

// Imm a multiple of 4096: hi-only (single instruction with sh=1).
func TestAddImmMultipleOf4096() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, SP, Imm(0x2000))
	if a.Sections[0].Len != 4 {
		return fail("imm at 4096-multiple should be a single sh=1 instr")
	}
	return ""
}

// --- Move tests ---

func TestMovReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV X0, X1 = ORR X0, XZR, X1
	// = 1|01|01010|00|0|00001|000000|11111|00000
	// = 0xAA0103E0
	Mov(a, true, X0, Reg(X1))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xAA0103E0 {
		return fail("MOV X0, X1 encoding wrong")
	}
	return ""
}

func TestMovRegSP() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV X29, SP = ADD X29, SP, #0
	// = 1|00|100010|0|000000000000|11111|11101
	// = 0x910003FD
	Mov(a, true, FP, Reg(SP))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x910003FD {
		return fail("MOV X29, SP encoding wrong")
	}
	return ""
}

func TestMovSPReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV SP, X29 = ADD SP, X29, #0
	// = 1|00|100010|0|000000000000|11101|11111
	// = 0x910003BF
	Mov(a, true, SP, Reg(FP))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x910003BF {
		return fail("MOV SP, X29 encoding wrong")
	}
	return ""
}

func TestMovz() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVZ X0, #0x1234 = 1|10|100101|00|0001001000110100|00000
	// = 0xD2824680
	Movz(a, true, X0, 0x1234, 0)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xD2824680 {
		return fail("MOVZ X0, #0x1234 encoding wrong")
	}
	return ""
}

