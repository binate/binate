// --- Load/Store tests ---

func TestLdrImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR X0, [X1, #8] = 11|111001|01|000000000001|00001|00000
	// imm12 = 8/8 = 1, shifted left 10 bits
	// = 0xF9400420
	Ldr(a, true, X0, MemImm(X1, 8))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF9400420 {
		return fail("LDR X0, [X1, #8] encoding wrong")
	}
	return ""
}

func TestStrImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STR X0, [X1, #16] = 11|111001|00|000000000010|00001|00000
	// imm12 = 16/8 = 2
	// = 0xF9000820
	Str(a, true, X0, MemImm(X1, 16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF9000820 {
		return fail("STR X0, [X1, #16] encoding wrong")
	}
	return ""
}

func TestLdrb() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRB W0, [X1, #0] = 00|111001|01|000000000000|00001|00000
	// = 0x39400020
	Ldrb(a, X0, MemImm(X1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x39400020 {
		return fail("LDRB W0, [X1, #0] encoding wrong")
	}
	return ""
}

// --- Load/Store pair tests ---

func TestStpPre() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STP X29, X30, [SP, #-16]! (pre-index)
	// opc=10, mode=pre(3), L=0, imm7=-16/8=-2 (0x7E in 7-bit signed)
	// = 0xA9BF7BFD
	Stp(a, true, FP, LR, MemPre(SP, -16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xA9BF7BFD {
		return fail("STP X29, X30, [SP, #-16]! encoding wrong")
	}
	return ""
}

func TestLdpPost() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDP X29, X30, [SP], #16 (post-index)
	// opc=10, mode=post(1), L=1, imm7=16/8=2
	// = 0xA8C17BFD
	Ldp(a, true, FP, LR, MemPost(SP, 16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xA8C17BFD {
		return fail("LDP X29, X30, [SP], #16 encoding wrong")
	}
	return ""
}

// --- Compare test ---

func TestCmp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CMP X0, #0 = SUBS XZR, X0, #0
	// = 1|11|100010|0|000000000000|00000|11111
	// = 0xF100001F
	Cmp(a, true, X0, Imm(0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF100001F {
		return fail("CMP X0, #0 encoding wrong")
	}
	return ""
}

// --- MVN tests ---

func TestMvnReg64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MVN X0, X1 = ORN X0, XZR, X1
	// 1|01|01010|00|1|00001|000000|11111|00000
	// sf=1, ORN_REG=0x2A200000, Rm=1, Rn=XZR(31), Rd=0
	// = 0xAA2103E0
	Mvn(a, true, X0, Reg(X1))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xAA2103E0 {
		return fail("MVN X0, X1 encoding wrong")
	}
	return ""
}

func TestMvnReg32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MVN W0, W1 (sf=0)
	// = 0x2A2103E0
	Mvn(a, false, X0, Reg(X1))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x2A2103E0 {
		return fail("MVN W0, W1 encoding wrong")
	}
	return ""
}

func TestMvnRegShifted() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MVN X0, X1, LSL #4
	// ORN X0, XZR, X1, LSL #4
	// = 0xAA2113E0
	Mvn(a, true, X0, RegShift(X1, LSL, 4))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xAA2113E0 {
		return fail("MVN X0, X1 LSL #4 encoding wrong")
	}
	return ""
}

// --- ADRP+ADD / ADRP+LDR fixups (for global addressing) ---

// AddImmLabel encodes ADD rd, rn, #0 and records a FIX_ADD_LO12 fixup.
// Matches the encoding of ADD X0, X1, #0.
func TestAddImmLabelEncoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// ADD X0, X1, #0 = 1|00|100010|0|000000000000|00001|00000 = 0x91000020
	AddImmLabel(a, true, X0, X1, "g")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x91000020 {
		return fail("ADD X0, X1, #0 encoding wrong")
	}
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return fail("expected 1 fixup") }
	if s.Fixups[0].Kind != FIX_ADD_LO12 { return fail("wrong fixup kind") }
	if cast(int, s.Fixups[0].Offset) != 0 { return fail("wrong fixup offset") }
	return ""
}

// LdrImmLabel encodes LDR rt, [base, #0] and records a FIX_LDR_LO12 fixup.
func TestLdrImmLabelEncoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR X0, [X1, #0] = 11|111001|01|000000000000|00001|00000 = 0xF9400020
	LdrImmLabel(a, true, X0, X1, "g")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF9400020 {
		return fail("LDR X0, [X1, #0] encoding wrong")
	}
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return fail("expected 1 fixup") }
	if s.Fixups[0].Kind != FIX_LDR_LO12 { return fail("wrong fixup kind") }
	if cast(int, s.Fixups[0].Offset) != 0 { return fail("wrong fixup offset") }
	return ""
}

// FIX_ADD_LO12 and FIX_LDR_LO12 are not PC-relative — ResolveFixups must
// leave them unresolved so Finalize emits linker relocations. This is the
// same path ADRP follows today.
func TestLo12FixupsLeftForLinker() testing.TestResult {
	var a @asm.Assembler = newAsm()
	asm.SetGlobal(a, "g")
	Adrp(a, X0, "g")
	AddImmLabel(a, true, X0, X0, "g")
	LdrImmLabel(a, true, X1, X0, "g")

	// Fixup offsets should be 0, 4, 8 (one per 4-byte instruction).
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 3 { return fail("expected 3 fixups") }
	if cast(int, s.Fixups[0].Offset) != 0 { return fail("ADRP fixup offset") }
	if cast(int, s.Fixups[1].Offset) != 4 { return fail("ADD fixup offset") }
	if cast(int, s.Fixups[2].Offset) != 8 { return fail("LDR fixup offset") }

	ResolveFixups(a)
	asm.Finalize(a)

	if a.HasError { return fail("unexpected error") }
	// 3 fixups (ADRP, ADD, LDR) all go to relocations.
	if a.NumRelocs != 3 { return fail("expected 3 relocations") }
	return ""
}

// Critical invariant: FIX_ADD_LO12 / FIX_LDR_LO12 are defined in terms of
// the target's runtime address, which isn't known at assemble time — even
// when the target is in the same section. ResolveFixups must not "optimize"
// them away; they must survive as linker relocations.
func TestLo12FixupsSameSectionStillReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	asm.SetSection(a, "data", -1)
	asm.DefineLabel(a, "_g")
	asm.SetGlobal(a, "_g")
	// Four zero bytes representing the global's storage.
	asm.EmitUint32(a, 0)

	asm.SetSection(a, "text", -1)
	Adrp(a, X0, "_g")
	AddImmLabel(a, true, X0, X0, "_g")
	LdrImmLabel(a, true, X1, X0, "_g")

	ResolveFixups(a)
	asm.Finalize(a)

	if a.HasError { return fail("unexpected error") }
	// Cross-section (text → data): all three must be relocations, not
	// resolved in place.
	if a.NumRelocs != 3 { return fail("expected 3 cross-section relocations") }
	return ""
}

