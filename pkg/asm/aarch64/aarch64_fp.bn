package "pkg/asm/aarch64"

import "pkg/asm"

// AArch64 floating-point (scalar, double-precision) instructions.
//
// All FP regs are passed in via the D0..D31 namespace (defined in
// aarch64.bni at offset 100). The encoders mask with 0x1f before
// emitting so the resulting instruction has the canonical 5-bit reg
// field.
//
// We only define what pkg/native/arm64 actually needs: GP↔FP move,
// basic arithmetic, FNEG, FCMP, FCVTZS / SCVTF, and FMOV reg-to-reg.
// FP loads and stores are deliberately omitted — float values
// round-trip through GP regs at every spill boundary, so the existing
// LDR/STR (X variant) covers spill traffic.

// Mask a register number to the 5-bit field.
func fpRegBits(r int) uint32 {
	return cast(uint32, r & 0x1f)
}

// --- FMOV (scalar, register and gp↔fp) ---

// Fmov_gp_to_fp: FMOV Dd, Xn.
// Encoding: 1|0|0|11110|01|1|00|111|000000|Rn|Rd = 0x9E670000
func Fmov_gp_to_fp(a @asm.Assembler, dd int, xn int) {
	var inst uint32 = cast(uint32, 0x9E670000)
	inst = inst | (cast(uint32, xn & 0x1f) << 5)
	inst = inst | fpRegBits(dd)
	emit32(a, inst)
}

// Fmov_fp_to_gp: FMOV Xd, Dn.
// Encoding: 1|0|0|11110|01|1|00|110|000000|Rn|Rd = 0x9E660000
func Fmov_fp_to_gp(a @asm.Assembler, xd int, dn int) {
	var inst uint32 = cast(uint32, 0x9E660000)
	inst = inst | (fpRegBits(dn) << 5)
	inst = inst | cast(uint32, xd & 0x1f)
	emit32(a, inst)
}

// Fmov_fp_to_fp: FMOV Dd, Dn.
// Encoding: 0|0|0|11110|01|1|0000|00|10000|Rn|Rd = 0x1E604000
func Fmov_fp_to_fp(a @asm.Assembler, dd int, dn int) {
	var inst uint32 = cast(uint32, 0x1E604000)
	inst = inst | (fpRegBits(dn) << 5)
	inst = inst | fpRegBits(dd)
	emit32(a, inst)
}

// --- Floating-point arithmetic (scalar, double) ---
//
// Format: 0|0|0|11110|ty|1|Rm|opc4|10|Rn|Rd
// ty=01 for double; opc selects the operation. See ARM ARM
// "Floating-point data-processing (2 source)".

func fpDataProc2Enc(opc4 uint32, dd int, dn int, dm int) uint32 {
	var inst uint32 = cast(uint32, 0x1E600800)
	inst = inst | (opc4 << 12)
	inst = inst | (fpRegBits(dm) << 16)
	inst = inst | (fpRegBits(dn) << 5)
	inst = inst | fpRegBits(dd)
	return inst
}

// FMUL: opc=0000 → 0x1E600800
func Fmul(a @asm.Assembler, dd int, dn int, dm int) {
	emit32(a, fpDataProc2Enc(0, dd, dn, dm))
}

// FDIV: opc=0001 → 0x1E601800
func Fdiv(a @asm.Assembler, dd int, dn int, dm int) {
	emit32(a, fpDataProc2Enc(1, dd, dn, dm))
}

// FADD: opc=0010 → 0x1E602800
func Fadd(a @asm.Assembler, dd int, dn int, dm int) {
	emit32(a, fpDataProc2Enc(2, dd, dn, dm))
}

// FSUB: opc=0011 → 0x1E603800
func Fsub(a @asm.Assembler, dd int, dn int, dm int) {
	emit32(a, fpDataProc2Enc(3, dd, dn, dm))
}

// --- Floating-point unary (1-source) ---
// Format: 0|0|0|11110|ty|1|0000|opc6|10000|Rn|Rd  for ty=01 (double).

// FNEG: opc=000010 → 0x1E614000
func Fneg(a @asm.Assembler, dd int, dn int) {
	var inst uint32 = cast(uint32, 0x1E614000)
	inst = inst | (fpRegBits(dn) << 5)
	inst = inst | fpRegBits(dd)
	emit32(a, inst)
}

// --- Floating-point compare ---
//
// FCMP Dn, Dm sets PSTATE.NZCV; pair with B.cond / Csinc.
// Encoding: 0|0|0|11110|01|1|Rm|001000|Rn|0|0|0|0|0 = 0x1E602000

func Fcmp(a @asm.Assembler, dn int, dm int) {
	var inst uint32 = cast(uint32, 0x1E602000)
	inst = inst | (fpRegBits(dm) << 16)
	inst = inst | (fpRegBits(dn) << 5)
	emit32(a, inst)
}

// --- Conversion: int ↔ float ---

// Fcvtzs: FCVTZS Xd, Dn (round toward zero, signed 64-bit int).
// Encoding: 1|0|0|11110|01|1|11|000|000000|Rn|Rd = 0x9E780000
func Fcvtzs(a @asm.Assembler, xd int, dn int) {
	var inst uint32 = cast(uint32, 0x9E780000)
	inst = inst | (fpRegBits(dn) << 5)
	inst = inst | cast(uint32, xd & 0x1f)
	emit32(a, inst)
}

// Scvtf: SCVTF Dd, Xn (signed 64-bit int → double).
// Encoding: 1|0|0|11110|01|1|00|010|000000|Rn|Rd = 0x9E620000
func Scvtf(a @asm.Assembler, dd int, xn int) {
	var inst uint32 = cast(uint32, 0x9E620000)
	inst = inst | (cast(uint32, xn & 0x1f) << 5)
	inst = inst | fpRegBits(dd)
	emit32(a, inst)
}
