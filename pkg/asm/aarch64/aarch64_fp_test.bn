// FCVT (single ↔ double): width conversion in the FP-data-1-source
// family. Verifies the D→S narrowing and S→D widening encodings.

func TestFcvtDToS() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FCVT Sd=0, Dn=1
	// = 0|0|0|11110|01|1|0001|00|10000|00001|00000
	// = 0x1E624020
	Fcvt_d_to_s(a, D0, D1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x1E624020) {
		return fail("FCVT S0, D1 encoding wrong")
	}
	return ""
}

func TestFcvtSToD() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FCVT Dd=0, Sn=1
	// = 0|0|0|11110|00|1|0001|01|10000|00001|00000
	// = 0x1E22C020
	Fcvt_s_to_d(a, D0, D1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x1E22C020) {
		return fail("FCVT D0, S1 encoding wrong")
	}
	return ""
}

// 32-bit GP↔FP move (W ↔ S): used at the float32 spill boundary
// where only the low 32 bits are meaningful.

func TestFmovWToS() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FMOV S0, W1 = 0|0|0|11110|00|1|00|111|000000|00001|00000
	//            = 0x1E270020
	Fmov_w_to_s(a, D0, X1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x1E270020) {
		return fail("FMOV S0, W1 encoding wrong")
	}
	return ""
}

func TestFmovSToW() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FMOV W0, S1 = 0|0|0|11110|00|1|00|110|000000|00001|00000
	//            = 0x1E260020
	Fmov_s_to_w(a, X0, D1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x1E260020) {
		return fail("FMOV W0, S1 encoding wrong")
	}
	return ""
}

// D-register offset regression guard. The encoders mask reg numbers
// with 0x1f, so the namespace offset (D0 = some int) MUST be a
// multiple of 32 — otherwise D0+n produces wrong reg numbers when
// added arithmetically. Pre-fix, the offset was 100 and `D0 + 0`
// (= 100) masked to register 4 instead of 0; emitCall's NSRN loop
// silently routed `bn_print_float`'s arg to D4. Verify by emitting
// FMOV with the 0+offset position and checking the encoded reg is 0.
func TestDRegOffsetRoundTrip() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fmov_gp_to_fp(a, D0, X0)  // expect Rd=0
	var inst uint32 = readInst(a.Sections[0], 0)
	// Bits 4-0 should be 0.
	if (inst & cast(uint32, 0x1f)) != cast(uint32, 0) {
		return fail("D0 didn't encode as register 0")
	}
	return ""
}

// Mid-range register numbers — guards against accidental sign-extension
// or bit-leakage across the 5-bit reg field. D17 is the second native
// FP scratch in pkg/native/arm64.
func TestFaddD17() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FADD D17, D17, D16 — verify both directions of D-reg masking.
	// = 0|0|0|11110|01|1|10000|0010|10|10001|10001
	// = 0x1E702A31
	Fadd(a, D17, D17, D16)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x1E702A31) {
		return fail("FADD D17, D17, D16 encoding wrong")
	}
	return ""
}
