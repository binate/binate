	// = 0x1E622820
	Fadd(a, D0, D1, D2)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x1E622820) {
		return fail("FADD D0, D1, D2 encoding wrong")
	}
	return ""
}

