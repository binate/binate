package "pkg/asm/aarch64"

import "pkg/asm"
import "pkg/builtin/testing"

// Golden-encoding tests for the FP instructions added in
// aarch64_fp.bn. Each instruction's expected hex is derived from the
// ARM ARM bit layout (see comments above the encoder); the byte
// pattern was cross-checked against clang-emitted disassembly.

func TestFmovGpToFp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FMOV D0, X1
	// = 1|0|0|11110|01|1|00|111|000000|00001|00000
	// = 0x9E670020
	Fmov_gp_to_fp(a, D0, X1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x9E670020) {
		return fail("FMOV D0, X1 encoding wrong")
	}
	return ""
}

func TestFmovFpToGp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// FMOV X0, D1
	// = 1|0|0|11110|01|1|00|110|000000|00001|00000
	// = 0x9E660020
	Fmov_fp_to_gp(a, X0, D1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x9E660020) {
		return fail("FMOV X0, D1 encoding wrong")
	}
	return ""
}

