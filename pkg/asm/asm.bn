package "pkg/asm"

import "pkg/buf"

// INITIAL_SECTIONS is the initial capacity of an Assembler's section list.
const INITIAL_SECTIONS int = 8
// INITIAL_SYMBOLS is the initial capacity of an Assembler's symbol table.
const INITIAL_SYMBOLS int = 64
// INITIAL_FIXUPS is the initial capacity of an Assembler's pending-fixup list.
const INITIAL_FIXUPS int = 64
// INITIAL_RELOCS is the initial capacity of an Assembler's relocation list.
const INITIAL_RELOCS int = 64
// INITIAL_DATA is the initial byte capacity of an Assembler's per-section
// output buffer; expanded geometrically as bytes are emitted.
const INITIAL_DATA int = 1024

// --- Helpers ---

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) {
		return false
	}
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

// setError records an error message on the assembler. Only the first
// error is kept; subsequent calls are no-ops. The msg slice is copied.
func (a @Assembler) setError(msg *[]const char) {
	if !a.HasError {
		a.HasError = true
		a.ErrorMsg = buf.CopyStr(msg)
	}
}

// SetError is the public form of setError, callable from per-arch
// helpers (e.g. aarch64.ResolveFixups) that need to report assembler
// errors from outside the asm package.
func (a @Assembler) SetError(msg *[]const char) {
	a.setError(msg)
}

// --- Section management ---

// defaultFlags returns the section flags for a well-known section name
// ("text", "data", "rodata", "bss"), or -1 for unknown names.
func defaultFlags(name *[]const char) int {
	if charsEqual(name, "text") {
		return SF_READ | SF_EXEC
	}
	if charsEqual(name, "data") {
		return SF_READ | SF_WRITE
	}
	if charsEqual(name, "rodata") {
		return SF_READ
	}
	if charsEqual(name, "bss") {
		return SF_READ | SF_WRITE
	}
	return -1
}

// findSection returns the index of a section in a.Sections by name,
// or -1 if not found.
func (a @Assembler) findSection(name *[]const char) int {
	for i := 0; i < a.NumSections; i++ {
		if charsEqual(a.Sections[i].Name, name) {
			return i
		}
	}
	return -1
}

// newSection allocates a new Section with the given name and flags.
// The name is copied. The caller must append it to the assembler's
// Sections array via appendSection.
func newSection(name *[]const char, flags int) @Section {
	var s @Section = make(Section)
	s.Name = buf.CopyStr(name)
	s.Flags = flags
	s.Data = make_slice(uint8, INITIAL_DATA)
	s.Len = 0
	s.Fixups = make_slice(Fixup, INITIAL_FIXUPS)
	s.NumFixups = 0
	return s
}

// appendSection adds a section to a.Sections, growing the array if needed.
func (a @Assembler) appendSection(s @Section) {
	if a.NumSections >= len(a.Sections) {
		// Grow sections array
		var newCap int = len(a.Sections) * 2
		var newArr @[]@Section = make_slice(@Section, newCap)
		for i := 0; i < a.NumSections; i++ {
			newArr[i] = a.Sections[i]
		}
		a.Sections = newArr
	}
	a.Sections[a.NumSections] = s
	a.NumSections = a.NumSections + 1
}

// --- Symbol management ---

// findSymbol returns the index of a symbol in a.Symbols by name,
// or -1 if not found.
func (a @Assembler) findSymbol(name *[]const char) int {
	for i := 0; i < a.NumSymbols; i++ {
		if charsEqual(a.Symbols[i].Name, name) {
			return i
		}
	}
	return -1
}

// addSymbol appends a new symbol to a.Symbols and returns its index.
// The name is copied. Does not check for duplicates — caller must
// check via findSymbol first if needed.
func (a @Assembler) addSymbol(name *[]const char, section int, offset uint, binding int) int {
	if a.NumSymbols >= len(a.Symbols) {
		var newCap int = len(a.Symbols) * 2
		var newArr @[]Symbol = make_slice(Symbol, newCap)
		for i := 0; i < a.NumSymbols; i++ {
			newArr[i] = a.Symbols[i]
		}
		a.Symbols = newArr
	}
	var idx int = a.NumSymbols
	a.Symbols[idx].Name = buf.CopyStr(name)
	a.Symbols[idx].Section = section
	a.Symbols[idx].Offset = offset
	a.Symbols[idx].Binding = binding
	a.NumSymbols = a.NumSymbols + 1
	return idx
}

// --- Fixup management ---

// addSectionFixup appends a fixup to s.Fixups, growing the array if needed.
// The label is copied.
func addSectionFixup(s @Section, offset uint, label *[]const char, kind int, addend int) {
	if s.NumFixups >= len(s.Fixups) {
		var newCap int = len(s.Fixups) * 2
		var newArr @[]Fixup = make_slice(Fixup, newCap)
		for i := 0; i < s.NumFixups; i++ {
			newArr[i] = s.Fixups[i]
		}
		s.Fixups = newArr
	}
	s.Fixups[s.NumFixups].Offset = offset
	s.Fixups[s.NumFixups].Label = buf.CopyStr(label)
	s.Fixups[s.NumFixups].Kind = kind
	s.Fixups[s.NumFixups].Addend = addend
	s.NumFixups = s.NumFixups + 1
}

// --- Relocation management ---

// addReloc appends a relocation to a.Relocs, growing the array if needed.
// section and symbol are indices into a.Sections and a.Symbols respectively.
func (a @Assembler) addReloc(section int, offset uint, symbol int, kind int, addend int) {
	if a.NumRelocs >= len(a.Relocs) {
		var newCap int = len(a.Relocs) * 2
		var newArr @[]Relocation = make_slice(Relocation, newCap)
		for i := 0; i < a.NumRelocs; i++ {
			newArr[i] = a.Relocs[i]
		}
		a.Relocs = newArr
	}
	a.Relocs[a.NumRelocs].Section = section
	a.Relocs[a.NumRelocs].Offset = offset
	a.Relocs[a.NumRelocs].Symbol = symbol
	a.Relocs[a.NumRelocs].Kind = kind
	a.Relocs[a.NumRelocs].Addend = addend
	a.NumRelocs = a.NumRelocs + 1
}

// --- Data emission helpers ---

// ensureCapacity grows s.Data if there isn't room for needed more bytes.
func ensureCapacity(s @Section, needed int) {
	var cap int = len(s.Data)
	if s.Len + needed <= cap {
		return
	}
	var newCap int = cap
	if newCap == 0 {
		newCap = INITIAL_DATA
	}
	for newCap < s.Len + needed {
		newCap = newCap * 2
	}
	var newData @[]uint8 = make_slice(uint8, newCap)
	for i := 0; i < s.Len; i++ {
		newData[i] = s.Data[i]
	}
	s.Data = newData
}

// sectionEmitByte appends a single byte to s.Data, growing if needed.
func sectionEmitByte(s @Section, val uint8) {
	ensureCapacity(s, 1)
	s.Data[s.Len] = val
	s.Len = s.Len + 1
}

// --- Public API ---

func New(word_size int) @Assembler {
	var a @Assembler = make(Assembler)
	a.Sections = make_slice(@Section, INITIAL_SECTIONS)
	a.NumSections = 0
	a.Symbols = make_slice(Symbol, INITIAL_SYMBOLS)
	a.NumSymbols = 0
	a.Relocs = make_slice(Relocation, INITIAL_RELOCS)
	a.NumRelocs = 0
	a.Current = -1
	a.WordSize = word_size
	a.HasError = false
	return a
}

// SetSection switches the assembler's "current" section to one named
// `name`, creating it if it doesn't yet exist. flags supplies the
// section attribute mask (writable/executable/etc.); a negative value
// means "use the default flags for this section name" (e.g. .text is
// allocatable+executable). Subsequent Emit* calls write into this
// section. Sets an error and is a no-op if `name` is unknown and no
// flags were supplied.
func (a @Assembler) SetSection(name *[]const char, flags int) {
	var idx int = a.findSection(name)
	if idx >= 0 {
		a.Current = idx
		return
	}
	// Create new section
	var f int = flags
	if f < 0 {
		f = defaultFlags(name)
		if f < 0 {
			a.setError("unknown section name and no flags specified")
			return
		}
	}
	var s @Section = newSection(name, f)
	a.appendSection(s)
	a.Current = a.NumSections - 1
}

// DefineLabel records a symbol whose value is the current offset in
// the active section. If `name` was previously referenced as a forward
// reference (Section == -1), that entry is filled in; if it was already
// defined, the assembler records a "duplicate label" error. New labels
// default to BIND_LOCAL — promote with SetGlobal/SetWeak as needed.
// Sets an error and is a no-op if no section is active.
func (a @Assembler) DefineLabel(name *[]const char) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var existing int = a.findSymbol(name)
	if existing >= 0 {
		// Check for redefinition
		if a.Symbols[existing].Section >= 0 {
			a.setError("duplicate label")
			return
		}
		// Was undefined (forward reference) — now define it
		a.Symbols[existing].Section = a.Current
		a.Symbols[existing].Offset = cast(uint, a.Sections[a.Current].Len)
		return
	}
	a.addSymbol(name, a.Current, cast(uint, a.Sections[a.Current].Len), BIND_LOCAL)
}

// SetGlobal marks a symbol with global linkage. Creates an undefined
// global entry if the symbol hasn't been seen yet, so a forward
// reference to an external symbol can also be marked global before
// any definition exists.
func (a @Assembler) SetGlobal(name *[]const char) {
	var idx int = a.findSymbol(name)
	if idx < 0 {
		// Create as undefined global — will be defined later or remain external
		idx = a.addSymbol(name, -1, 0, BIND_GLOBAL)
		return
	}
	a.Symbols[idx].Binding = BIND_GLOBAL
}

// SetWeak marks a symbol with weak linkage. Like SetGlobal, this also
// creates an undefined entry if the symbol is not yet known.
func (a @Assembler) SetWeak(name *[]const char) {
	var idx int = a.findSymbol(name)
	if idx < 0 {
		idx = a.addSymbol(name, -1, 0, BIND_WEAK)
		return
	}
	a.Symbols[idx].Binding = BIND_WEAK
}

// AddFixup records a pending fixup at the current section's current
// offset. `kind` is an architecture-specific tag (0 = generic absolute
// address); `addend` is added to the resolved symbol's value before
// the patch is applied; `size` describes the patched field's width
// (in bytes). Per-architecture resolvers consume this list at Finalize.
// Sets an error and is a no-op if no section is active.
func (a @Assembler) AddFixup(label *[]const char, kind int, addend int, size int) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var offset uint = cast(uint, a.Sections[a.Current].Len)
	addSectionFixup(a.Sections[a.Current], offset, label, kind, addend)
}

// CurrentOffset returns the byte offset within the active section
// where the next Emit* call would write. Returns 0 if no section is
// active. Used by clients that need to record positions for later
// patching outside the standard fixup machinery.
func (a @Assembler) CurrentOffset() uint {
	if a.Current < 0 {
		return 0
	}
	return cast(uint, a.Sections[a.Current].Len)
}

// LookupSymbol returns the index of a symbol by name, or -1 if not found.
// Exported for use by per-architecture fixup resolvers.
func (a @Assembler) LookupSymbol(name *[]const char) int {
	return a.findSymbol(name)
}

// MarkFixupResolved marks a fixup as resolved (Kind = -1) so Finalize skips it.
func (a @Assembler) MarkFixupResolved(si int, fi int) {
	a.Sections[si].Fixups[fi].Kind = -1
}

// SectionData returns the data buffer for a section. Used by per-arch resolvers.
func (a @Assembler) SectionData(si int) @[]uint8 {
	return a.Sections[si].Data
}

// Finalize processes any fixups not already resolved by per-architecture
// resolvers (those that left Kind == -1 after handling) and records
// them as relocations in the assembler's relocation list. Returns true
// on success, false if any fixup could not be resolved or if an earlier
// error was recorded on the assembler.
func (a @Assembler) Finalize() bool {
	// Process remaining fixups (those not resolved by per-arch resolvers)
	for si := 0; si < a.NumSections; si++ {
		var s @Section = a.Sections[si]
		for fi := 0; fi < s.NumFixups; fi++ {
			var f Fixup = s.Fixups[fi]
			if f.Kind == -1 {
				continue  // already resolved by per-arch resolver
			}
			var symIdx int = a.findSymbol(f.Label)
			if symIdx < 0 {
				a.setError("undefined symbol")
				return false
			}
			var sym Symbol = a.Symbols[symIdx]
			// External, cross-section, or unresolved — create relocation
			a.addReloc(si, f.Offset, symIdx, f.Kind, f.Addend)
		}
	}
	return !a.HasError
}
