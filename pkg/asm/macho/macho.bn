package "pkg/asm/macho"

import "pkg/asm"
import "pkg/binate/buf"
import "pkg/bootstrap"

// --- Mach-O section name mapping ---

// Map assembler section name to Mach-O segment/section names
func machoSegName(name *[]const char) *[]const char {
	if charsEqual(name, "text") { return "__TEXT" }
	if charsEqual(name, "rodata") { return "__TEXT" }
	if charsEqual(name, "data") { return "__DATA" }
	if charsEqual(name, "bss") { return "__DATA" }
	return "__DATA"
}

// machoSectName maps an assembler section name to a Mach-O section name.
// Returns a borrowed pointer to a string literal — valid for the program lifetime.
func machoSectName(name *[]const char) *[]const char {
	if charsEqual(name, "text") { return "__text" }
	if charsEqual(name, "rodata") { return "__const" }
	if charsEqual(name, "data") { return "__data" }
	if charsEqual(name, "bss") { return "__bss" }
	return name
}

// machoSectType returns the Mach-O section type for a section name.
func machoSectType(name *[]const char) uint32 {
	if charsEqual(name, "bss") { return S_ZEROFILL }
	return S_REGULAR
}

// machoSectAttrs returns the Mach-O section attributes for a section name.
func machoSectAttrs(name *[]const char) uint32 {
	if charsEqual(name, "text") {
		return S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
	}
	return 0
}

// machoSectAlign returns the Mach-O section alignment as a power-of-2 exponent
// (align field is 2^N). Data holds 64-bit globals so must be 8-byte aligned;
// text instructions only need 4-byte alignment.
func machoSectAlign(name *[]const char) uint32 {
	if charsEqual(name, "data") { return 3 }  // 2^3 = 8 bytes
	if charsEqual(name, "bss") { return 3 }   // same
	return 2                                     // 2^2 = 4 bytes
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]const char, b *[]const char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// --- String table builder ---

// StrTab builds a Mach-O string table: null-terminated strings preceded by
// a leading null byte. Passed by value; strTabAdd returns the updated table.
type StrTab struct {
	Buf buf.CharBuf
}

// newStrTab creates a StrTab with the required leading null byte.
func newStrTab() StrTab {
	var st StrTab
	st.Buf = buf.New()
	// String table starts with a null byte
	st.Buf = st.Buf.WriteByte(0)
	return st
}

// strTabAdd adds a string to the string table and returns the updated
// table and the string's offset.
func strTabAdd(st StrTab, s *[]const char) (StrTab, int) {
	var offset int = st.Buf.Len()
	st.Buf = st.Buf.WriteStr(s)
	st.Buf = st.Buf.WriteByte(0)
	return st, offset
}

// --- Relocation mapping ---

// Map assembler fixup kind to Mach-O relocation type.
// Returns -1 if the fixup kind has no Mach-O reloc encoding — the
// caller is expected to treat that as an error rather than silently
// emitting a wrong-instruction reloc.
//
// Mach-O ARM64 has reloc kinds for ADRP (PAGE21) and ADD/LDR (PAGEOFF12)
// pairs, plus 26-bit branches. There is no reloc kind for the
// 19-bit/14-bit conditional branches (FIX_BRANCH19, FIX_BRANCH14) or
// for ADR (FIX_ADR_LO21) — those are short-range, expected to be
// resolved within the source section by aarch64.ResolveFixups.
// Letting them fall through to a reloc would mismap to a wrong
// instruction encoding (e.g. the old FIX_ADR_LO21 → PAGE21 path used
// to silently produce a PAGE21 reloc on an ADR instruction, which ld
// rejected).
func machoRelocType(fixKind int, cpuType int) int {
	if cpuType == CPU_TYPE_ARM64 {
		if fixKind == 100 { return ARM64_RELOC_BRANCH26 }
		if fixKind == 103 { return ARM64_RELOC_PAGE21 }    // FIX_ADRP_HI21
		if fixKind == 105 { return ARM64_RELOC_PAGEOFF12 }  // FIX_ADD_LO12
		if fixKind == 106 { return ARM64_RELOC_PAGEOFF12 }  // FIX_LDR_LO12
		if fixKind == 0 { return ARM64_RELOC_UNSIGNED }
	}
	if cpuType == CPU_TYPE_X86_64 {
		if fixKind == 300 { return X86_64_RELOC_BRANCH }
		if fixKind == 301 { return X86_64_RELOC_UNSIGNED }
		if fixKind == 302 { return X86_64_RELOC_SIGNED }   // FIX_REL32_LEA
		if fixKind == 0 { return X86_64_RELOC_UNSIGNED }
	}
	return -1
}

// Relocation entry length (r_length field): log2 of size.
func machoRelocLength(fixKind int, cpuType int) int {
	if cpuType == CPU_TYPE_X86_64 {
		if fixKind == 300 { return 2 }  // rel32 = 4 bytes = log2(4) = 2
		if fixKind == 301 { return 3 }  // abs64 = 8 bytes = log2(8) = 3
		if fixKind == 302 { return 2 }  // FIX_REL32_LEA = 4 bytes
	}
	if fixKind == 0 { return 3 }  // absolute address = 8 bytes
	return 2  // ARM64 instructions = 4 bytes = log2(4) = 2
}

// Is the relocation PC-relative?
func machoRelocPCRel(fixKind int, cpuType int) int {
	if cpuType == CPU_TYPE_X86_64 {
		if fixKind == 300 { return 1 }  // FIX_REL32
		if fixKind == 302 { return 1 }  // FIX_REL32_LEA
		return 0
	}
	// ARM64
	if fixKind == 100 { return 1 }  // BRANCH26
	if fixKind == 101 { return 1 }  // BRANCH19
	if fixKind == 102 { return 1 }  // ADR
	if fixKind == 103 { return 1 }  // ADRP
	return 0
}

// Count relocations for a given section index
func countRelocsForSection(a @asm.Assembler, si int) int {
	var count int = 0
	for i := 0; i < a.NumRelocs; i++ {
		if a.Relocs[i].Section == si {
			count = count + 1
		}
	}
	return count
}

// --- Main write function ---

func Write(a @asm.Assembler, path *[]const char, cpu_type int, cpu_subtype int) bool {
	// Count non-empty sections
	var nsects int = 0
	for i := 0; i < a.NumSections; i++ {
		if a.Sections[i].Len > 0 {
			nsects = nsects + 1
		}
	}
	if nsects == 0 {
		nsects = 1  // need at least one section
	}

	// Build string table and nlist entries
	var strtab StrTab = newStrTab()
	var strOffsets @[]int = make_slice(int, a.NumSymbols)
	for i := 0; i < a.NumSymbols; i++ {
		strtab, strOffsets[i] = strTabAdd(strtab, a.Symbols[i].Name)
	}
	var strtabBytes @[]char = strtab.Buf.Bytes()
	var strtabSize int = len(strtabBytes)

	// Calculate sizes
	// mach_header_64 = 32 bytes
	var headerSize int = 32
	// LC_SEGMENT_64 = 72 bytes + 80 bytes per section
	var segCmdSize int = 72 + nsects * 80
	// LC_SYMTAB = 24 bytes
	var symtabCmdSize int = 24
	// LC_BUILD_VERSION = 24 bytes (no tool entries)
	var buildVerCmdSize int = 24

	var ncmds int = 3  // LC_SEGMENT_64 + LC_SYMTAB + LC_BUILD_VERSION
	var sizeofcmds int = segCmdSize + symtabCmdSize + buildVerCmdSize

	// Section data starts after header + load commands
	var dataOffset int = headerSize + sizeofcmds
	// Align section data to 8 bytes (not strictly required for .o but clean)
	if dataOffset % 8 != 0 {
		dataOffset = dataOffset + (8 - dataOffset % 8)
	}

	// Calculate section offsets, virtual addresses, and total data size.
	// Section virtual addresses are cumulative starting at 0 (in .o files
	// sections are packed without gaps). These are used both as the
	// `addr` field in section headers and as the base for computing
	// symbol `n_value` (absolute address, not section-local offset).
	var sectOffsets @[]int = make_slice(int, a.NumSections)
	var sectSizes @[]int = make_slice(int, a.NumSections)
	var sectAddrs @[]int = make_slice(int, a.NumSections)
	var currentOff int = dataOffset
	var currentAddr int = 0
	for i := 0; i < a.NumSections; i++ {
		sectOffsets[i] = currentOff
		sectSizes[i] = a.Sections[i].Len
		sectAddrs[i] = currentAddr
		currentOff = currentOff + a.Sections[i].Len
		currentAddr = currentAddr + a.Sections[i].Len
		// Align section file offsets AND virtual addresses to 8
		// bytes. The data section's runtime alignment is 8 (per
		// machoSectAlign), and the section's `addr` field drives
		// runtime placement — if addr is only 4-aligned,
		// ARM64_RELOC_UNSIGNED relocations land at non-8-aligned
		// runtime addresses and macOS ld rejects them with
		// "pointer not aligned in <symbol>+offset". File offsets
		// need to match so the .o reads the same bytes back. The
		// previous 4-byte alignment was OK while no section
		// needed >4-byte alignment.
		if currentOff % 8 != 0 {
			currentOff = currentOff + (8 - currentOff % 8)
		}
		if currentAddr % 8 != 0 {
			currentAddr = currentAddr + (8 - currentAddr % 8)
		}
	}

	// Relocations follow section data
	// relocation_info = 8 bytes each
	var sectRelocOffs @[]int = make_slice(int, a.NumSections)
	var sectRelocCounts @[]int = make_slice(int, a.NumSections)
	for i := 0; i < a.NumSections; i++ {
		var nreloc int = countRelocsForSection(a, i)
		sectRelocCounts[i] = nreloc
		if nreloc > 0 {
			sectRelocOffs[i] = currentOff
			currentOff = currentOff + nreloc * 8
		}
	}

	// Symbol table follows relocations
	var symtabOff int = currentOff
	// nlist_64 = 16 bytes each
	var symtabSize int = a.NumSymbols * 16

	// String table follows symbol table
	var strtabOff int = symtabOff + symtabSize

	// Total segment size: end of the last section (its addr +
	// size). Include the inter-section alignment padding so vmsize
	// covers the full address range — otherwise ld rejects the .o
	// with "section <X> end address is beyond containing segment's
	// end address".
	var segDataSize int = 0
	if a.NumSections > 0 {
		var last int = a.NumSections - 1
		segDataSize = sectAddrs[last] + sectSizes[last]
	}

	// --- Build the file ---
	var bb BinBuf = newBinBuf()

	// mach_header_64
	bb = bb.WriteU32(MH_MAGIC_64)
	bb = bb.WriteU32(cast(uint32, cpu_type))
	bb = bb.WriteU32(cast(uint32, cpu_subtype))
	bb = bb.WriteU32(MH_OBJECT)
	bb = bb.WriteU32(cast(uint32, ncmds))
	bb = bb.WriteU32(cast(uint32, sizeofcmds))
	bb = bb.WriteU32(0)  // flags
	bb = bb.WriteU32(0)  // reserved

	// LC_SEGMENT_64
	bb = bb.WriteU32(LC_SEGMENT_64)
	bb = bb.WriteU32(cast(uint32, segCmdSize))
	bb = bb.WriteFixedStr("", 16)  // segname (empty for .o)
	bb = bb.WriteU64(0)  // vmaddr
	bb = bb.WriteU64(cast(uint64, segDataSize))  // vmsize
	bb = bb.WriteU64(cast(uint64, dataOffset))  // fileoff
	bb = bb.WriteU64(cast(uint64, segDataSize))  // filesize
	bb = bb.WriteU32(7)  // maxprot (rwx)
	bb = bb.WriteU32(7)  // initprot (rwx)
	bb = bb.WriteU32(cast(uint32, nsects))
	bb = bb.WriteU32(0)  // flags

	// Section headers
	for i := 0; i < a.NumSections; i++ {
		if a.Sections[i].Len == 0 && nsects > 0 {
			// Skip truly empty sections if we have real ones
			// (but we always emit at least one)
		}
		var secName *[]const char = a.Sections[i].Name
		bb = bb.WriteFixedStr(machoSectName(secName), 16)  // sectname
		bb = bb.WriteFixedStr(machoSegName(secName), 16)    // segname
		bb = bb.WriteU64(cast(uint64, sectAddrs[i]))  // addr (relative for .o)
		bb = bb.WriteU64(cast(uint64, sectSizes[i]))  // size
		bb = bb.WriteU32(cast(uint32, sectOffsets[i]))  // offset
		bb = bb.WriteU32(machoSectAlign(secName))  // align (2^N)
		bb = bb.WriteU32(cast(uint32, sectRelocOffs[i]))  // reloff
		bb = bb.WriteU32(cast(uint32, sectRelocCounts[i]))  // nreloc
		var stype uint32 = machoSectType(secName)
		var sattrs uint32 = machoSectAttrs(secName)
		bb = bb.WriteU32(stype | sattrs)  // flags
		bb = bb.WriteU32(0)  // reserved1
		bb = bb.WriteU32(0)  // reserved2
		bb = bb.WriteU32(0)  // reserved3
	}

	// LC_SYMTAB
	bb = bb.WriteU32(LC_SYMTAB)
	bb = bb.WriteU32(cast(uint32, symtabCmdSize))
	bb = bb.WriteU32(cast(uint32, symtabOff))
	bb = bb.WriteU32(cast(uint32, a.NumSymbols))
	bb = bb.WriteU32(cast(uint32, strtabOff))
	bb = bb.WriteU32(cast(uint32, strtabSize))

	// LC_BUILD_VERSION (macOS, minimum version 11.0)
	bb = bb.WriteU32(LC_BUILD_VERSION)
	bb = bb.WriteU32(cast(uint32, buildVerCmdSize))
	bb = bb.WriteU32(1)  // platform = MACOS
	bb = bb.WriteU32(0x000B0000)  // minos = 11.0.0
	bb = bb.WriteU32(0x000B0000)  // sdk = 11.0.0
	bb = bb.WriteU32(0)  // ntools = 0

	// Pad to data offset
	for bb.Len < dataOffset {
		bb = bb.WriteU8(0)
	}

	// Section data
	for i := 0; i < a.NumSections; i++ {
		var s @asm.Section = a.Sections[i]
		if s.Len > 0 {
			var data *[]uint8 = s.Data[0:s.Len]
			bb = bb.WriteBytes(data, s.Len)
			// Pad between sections to 8 bytes — must match the
			// alignment used in sectOffsets above.
			bb = bb.Align(8)
		}
	}

	// Relocation entries (per section)
	for si := 0; si < a.NumSections; si++ {
		if sectRelocCounts[si] == 0 {
			continue
		}
		for ri := 0; ri < a.NumRelocs; ri++ {
			var rel asm.Relocation = a.Relocs[ri]
			if rel.Section != si {
				continue
			}
			// relocation_info: r_address (4 bytes)
			bb = bb.WriteU32(cast(uint32, rel.Offset))
			// r_symbolnum:24, r_pcrel:1, r_length:2, r_extern:1, r_type:4
			var rtype int = machoRelocType(rel.Kind, cpu_type)
			if rtype < 0 {
				a.SetError("macho: fixup kind has no Mach-O reloc encoding")
				return false
			}
			var rlength int = machoRelocLength(rel.Kind, cpu_type)
			var rpcrel int = machoRelocPCRel(rel.Kind, cpu_type)
			// r_extern=1 selects "by symbol index"; r_extern=0 selects
			// "by section index". All our relocations are against
			// named symbols (every fixup goes through a.Symbols), and
			// Apple's ld rejects address-based relocs (PAGE21,
			// PAGEOFF12, BRANCH26 on ARM64; SIGNED, BRANCH on x86_64)
			// with r_extern=0 even for locally-defined targets. We
			// always have a symtab entry to point to, so use it.
			var rextern int = 1
			var info uint32 = cast(uint32, rel.Symbol & 0x00FFFFFF)
			info = info | (cast(uint32, rpcrel & 1) << 24)
			info = info | (cast(uint32, rlength & 3) << 25)
			info = info | (cast(uint32, rextern & 1) << 27)
			info = info | (cast(uint32, rtype & 0xF) << 28)
			bb = bb.WriteU32(info)
		}
	}

	// Symbol table (nlist_64 entries)
	for i := 0; i < a.NumSymbols; i++ {
		var sym asm.Symbol = a.Symbols[i]
		// n_strx (4 bytes)
		bb = bb.WriteU32(cast(uint32, strOffsets[i]))
		// n_type (1 byte)
		var ntype uint8 = 0
		if sym.Section >= 0 {
			ntype = N_SECT
		}
		if sym.Binding == asm.BIND_GLOBAL || sym.Binding == asm.BIND_WEAK {
			ntype = ntype | N_EXT
		}
		bb = bb.WriteU8(ntype)
		// n_sect (1 byte) — 1-based section index, 0 for undefined
		if sym.Section >= 0 {
			bb = bb.WriteU8(cast(uint8, sym.Section + 1))
		} else {
			bb = bb.WriteU8(0)
		}
		// n_desc (2 bytes). For coalescable (linkonce-style) symbols
		// — Section >= 0 + Binding == BIND_WEAK — set N_WEAK_DEF so
		// ld dedupes across modules; non-weak symbols get 0.
		var ndesc uint16 = 0
		if sym.Section >= 0 && sym.Binding == asm.BIND_WEAK {
			ndesc = N_WEAK_DEF
		}
		bb = bb.WriteU16(ndesc)
		// n_value (8 bytes) — absolute address = section base + offset.
		// For undefined symbols (Section < 0), n_value is 0.
		var nvalue int = 0
		if sym.Section >= 0 {
			nvalue = sectAddrs[sym.Section] + cast(int, sym.Offset)
		}
		bb = bb.WriteU64(cast(uint64, nvalue))
	}

	// String table
	bb = bb.WriteBytes(strtabBytes, strtabSize)

	// --- Write to file ---
	var fd int = bootstrap.Open(path, bootstrap.O_WRONLY | bootstrap.O_CREATE | bootstrap.O_TRUNC)
	if fd < 0 {
		return false
	}
	var data *[]uint8 = bb.Data[0:bb.Len]
	var written int = bootstrap.Write(fd, data)
	bootstrap.Close(fd)
	return written == bb.Len
}

// WriteARM64 emits the assembler's contents as an arm64 Mach-O object
// at `path`. Returns true on success.
func WriteARM64(a @asm.Assembler, path *[]const char) bool {
	return Write(a, path, CPU_TYPE_ARM64, CPU_SUBTYPE_ARM64_ALL)
}

// WriteX86_64 emits the assembler's contents as an x86-64 Mach-O object
// at `path`. Returns true on success.
func WriteX86_64(a @asm.Assembler, path *[]const char) bool {
	return Write(a, path, CPU_TYPE_X86_64, CPU_SUBTYPE_X86_64_ALL)
}
