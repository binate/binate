package "pkg/asm/macho"

// BinBuf is a growable byte buffer for building binary output (Mach-O files).
// All bb* functions write little-endian values and return the updated buffer.
// BinBuf is passed and returned by value; the underlying Data is shared via
// managed pointer so callers must use the returned value (not the original).
type BinBuf struct {
	Data @[]uint8
	Len  int
}

// newBinBuf creates a BinBuf with initial capacity.
func newBinBuf() BinBuf {
	var b BinBuf
	b.Data = make_slice(uint8, 4096)
	b.Len = 0
	return b
}

// bbGrow ensures room for needed more bytes, doubling capacity as needed.
func bbGrow(b BinBuf, needed int) BinBuf {
	var cap int = len(b.Data)
	if b.Len + needed <= cap {
		return b
	}
	var newCap int = cap
	for newCap < b.Len + needed {
		newCap = newCap * 2
	}
	var newData @[]uint8 = make_slice(uint8, newCap)
	for i := 0; i < b.Len; i++ {
		newData[i] = b.Data[i]
	}
	b.Data = newData
	return b
}

func bbWriteU8(b BinBuf, v uint8) BinBuf {
	b = bbGrow(b, 1)
	b.Data[b.Len] = v
	b.Len = b.Len + 1
	return b
}

func bbWriteU16(b BinBuf, v uint16) BinBuf {
	b = bbGrow(b, 2)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Len = b.Len + 2
	return b
}

func bbWriteU32(b BinBuf, v uint32) BinBuf {
	b = bbGrow(b, 4)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Data[b.Len + 2] = cast(uint8, (v >> 16) & 0xff)
	b.Data[b.Len + 3] = cast(uint8, (v >> 24) & 0xff)
	b.Len = b.Len + 4
	return b
}

func bbWriteU64(b BinBuf, v uint64) BinBuf {
	b = bbGrow(b, 8)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Data[b.Len + 2] = cast(uint8, (v >> 16) & 0xff)
	b.Data[b.Len + 3] = cast(uint8, (v >> 24) & 0xff)
	b.Data[b.Len + 4] = cast(uint8, (v >> 32) & 0xff)
	b.Data[b.Len + 5] = cast(uint8, (v >> 40) & 0xff)
	b.Data[b.Len + 6] = cast(uint8, (v >> 48) & 0xff)
	b.Data[b.Len + 7] = cast(uint8, (v >> 56) & 0xff)
	b.Len = b.Len + 8
	return b
}

func bbWriteBytes(b BinBuf, data *[]uint8, count int) BinBuf {
	b = bbGrow(b, count)
	for i := 0; i < count; i++ {
		b.Data[b.Len + i] = data[i]
	}
	b.Len = b.Len + count
	return b
}

func bbWriteZeros(b BinBuf, count int) BinBuf {
	b = bbGrow(b, count)
	for i := 0; i < count; i++ {
		b.Data[b.Len + i] = 0
	}
	b.Len = b.Len + count
	return b
}

// Write a fixed-length string (padded with zeros to `size` bytes)
func bbWriteFixedStr(b BinBuf, s *[]const char, size int) BinBuf {
	b = bbGrow(b, size)
	var n int = len(s)
	if n > size {
		n = size
	}
	for i := 0; i < n; i++ {
		b.Data[b.Len + i] = s[i]
	}
	for i := n; i < size; i++ {
		b.Data[b.Len + i] = 0
	}
	b.Len = b.Len + size
	return b
}

// bbAlign pads with zeros to reach the given alignment boundary.
func bbAlign(b BinBuf, alignment int) BinBuf {
	var rem int = b.Len % alignment
	if rem != 0 {
		b = bbWriteZeros(b, alignment - rem)
	}
	return b
}
