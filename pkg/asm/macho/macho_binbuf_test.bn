package "pkg/asm/macho"

import "pkg/builtin/testing"

// BinBuf is a tiny growable byte buffer underpinning every Mach-O
// write. The end-to-end macho_test.bn / macho_x64_test.bn tests
// exercise it indirectly; these tests lock in the pure-function
// invariants (length advances, little-endian ordering, zero/align
// padding) so a regression shows up here first.

// bbByteAt reads a single byte from a BinBuf.
func bbByteAt(b BinBuf, i int) int { return cast(int, b.Data[i]) }

func TestBinBufWriteU8AdvancesAndStores() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU8(cast(uint8, 0x42))
	if b.Len != 1 { return "WriteU8 should advance Len by 1" }
	if bbByteAt(b, 0) != 0x42 { return "WriteU8 stored wrong byte" }
	return ""
}

// U16 / U32 / U64 all write little-endian. Pick distinct byte values
// so the endianness wiring is exercised (not just zeros).
func TestBinBufWriteU16LittleEndian() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU16(cast(uint16, 0x1234))
	if b.Len != 2 { return "WriteU16 should advance Len by 2" }
	if bbByteAt(b, 0) != 0x34 { return "low byte first" }
	if bbByteAt(b, 1) != 0x12 { return "high byte second" }
	return ""
}

func TestBinBufWriteU32LittleEndian() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU32(cast(uint32, 0xDEADBEEF))
	if b.Len != 4 { return "WriteU32 should advance Len by 4" }
	if bbByteAt(b, 0) != 0xEF { return "byte 0" }
	if bbByteAt(b, 1) != 0xBE { return "byte 1" }
	if bbByteAt(b, 2) != 0xAD { return "byte 2" }
	if bbByteAt(b, 3) != 0xDE { return "byte 3" }
	return ""
}

func TestBinBufWriteU64LittleEndian() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU64(cast(uint64, 0x0102030405060708))
	if b.Len != 8 { return "WriteU64 should advance Len by 8" }
	if bbByteAt(b, 0) != 0x08 { return "byte 0" }
	if bbByteAt(b, 7) != 0x01 { return "byte 7" }
	return ""
}

// WriteZeros advances Len by count and leaves the appended region
// zeroed (relevant because we also use it for fixed-str padding).
func TestBinBufWriteZeros() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU8(cast(uint8, 0xFF))
	b = b.WriteZeros(3)
	if b.Len != 4 { return "WriteZeros should advance Len by 3" }
	if bbByteAt(b, 0) != 0xFF { return "previous byte preserved" }
	if bbByteAt(b, 1) != 0 { return "byte 1 zero" }
	if bbByteAt(b, 3) != 0 { return "byte 3 zero" }
	return ""
}

// WriteFixedStr truncates / pads to the fixed size — Mach-O
// sectname / segname use 16-byte fixed slots.
func TestBinBufWriteFixedStrPads() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteFixedStr("__data", 16)
	if b.Len != 16 { return "FixedStr should write exactly 16 bytes" }
	if bbByteAt(b, 0) != 0x5F { return "'_' at byte 0" }  // '_' = 0x5F
	if bbByteAt(b, 5) != 0x61 { return "'a' at byte 5" }  // 'a' = 0x61
	if bbByteAt(b, 6) != 0 { return "pad byte should be 0" }
	if bbByteAt(b, 15) != 0 { return "pad byte at 15 should be 0" }
	return ""
}

// WriteFixedStr caps at size even if the input is longer — guards
// against writing past the field into the next section-header slot.
func TestBinBufWriteFixedStrTruncates() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteFixedStr("abcdefghijklmnopqrstuvwx", 16)
	if b.Len != 16 { return "FixedStr should cap at size" }
	if bbByteAt(b, 15) != 0x70 { return "last char should be 'p'" } // 'p' = 0x70
	return ""
}

// Align pads zero-filled up to the alignment boundary; already-
// aligned positions are no-ops.
func TestBinBufAlignPads() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU8(cast(uint8, 1))
	b = b.WriteU8(cast(uint8, 2))
	b = b.WriteU8(cast(uint8, 3))
	b = b.Align(8)
	if b.Len != 8 { return "Align(8) should pad 3→8" }
	if bbByteAt(b, 4) != 0 { return "padding should be zero" }
	return ""
}

func TestBinBufAlignNoopWhenAligned() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU64(cast(uint64, 0))
	var before int = b.Len
	b = b.Align(8)
	if b.Len != before { return "already-aligned Align should not advance" }
	return ""
}

// grow doubles capacity when room runs out. Exercising it directly
// ensures the grow path doesn't lose previously written bytes.
func TestBinBufGrowPreservesContents() testing.TestResult {
	var b BinBuf = newBinBuf()
	// newBinBuf caps at 4096; write enough to force a grow.
	for i := 0; i < 5000; i++ {
		b = b.WriteU8(cast(uint8, i & 0xff))
	}
	if b.Len != 5000 { return "Len should match writes" }
	if bbByteAt(b, 0) != 0 { return "first byte preserved" }
	if bbByteAt(b, 4999) != (4999 & 0xff) { return "last byte preserved" }
	return ""
}
