package "pkg/asm/macho"

import "pkg/asm"
import "pkg/asm/aarch64"
import "pkg/bootstrap"
import "pkg/builtin/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// canLinkAndRun checks if we're on macOS/AArch64 where we can link
// Mach-O and run the result. Returns true on macOS, false on Linux/etc.
func canLinkAndRun() bool {
	// otool is macOS-only; if it's not available, we can't link/run Mach-O
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = bootstrap.Concat("--version", "")
	var exit int = bootstrap.Exec("otool", args)
	return exit == 0
}

// Test that we can assemble a simple function and write a valid Mach-O object file.
func TestWriteSimpleObj() testing.TestResult {
	if !canLinkAndRun() { return "" }  // skip on non-macOS
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	// A function that returns 42: mov w0, #42; ret
	asm.DefineLabel(a, "_answer")
	asm.SetGlobal(a, "_answer")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	asm.Finalize(a)

	if a.HasError { return fail("assembler error") }

	var path *[]const char = "/tmp/binate_asm_test.o"
	var ok bool = WriteARM64(a, path)
	if !ok { return fail("failed to write object file") }

	// Verify the file exists and has reasonable size
	if bootstrap.Stat(path) != 1 {
		return fail("object file not found")
	}

	// Verify with otool -h (check Mach-O header)
	var args @[]@[]char = make_slice(@[]char, 2)
	args[0] = bootstrap.Concat("-h", "")
	args[1] = bootstrap.Concat(path, "")
	var exit int = bootstrap.Exec("otool", args)
	if exit != 0 {
		return fail("otool -h failed")
	}

	// Verify disassembly with otool -tv
	var args2 @[]@[]char = make_slice(@[]char, 2)
	args2[0] = bootstrap.Concat("-tv", "")
	args2[1] = bootstrap.Concat(path, "")
	var exit2 int = bootstrap.Exec("otool", args2)
	if exit2 != 0 {
		return fail("otool -tv failed")
	}

	return ""
}

// Test linking the object file into an executable and running it.
func TestLinkAndRun() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	// _main: mov w0, #42; ret
	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	asm.Finalize(a)

	if a.HasError { return fail("assembler error") }

	var objPath *[]const char = "/tmp/binate_asm_link_test.o"
	var ok bool = WriteARM64(a, objPath)
	if !ok { return fail("failed to write object file") }

	// Link with system linker: ld -o <exe> <obj> -lSystem -syslibroot <sdk> -e _main -arch arm64
	var exePath *[]const char = "/tmp/binate_asm_link_test"

	// Use ld via cc for simpler invocation
	var args @[]@[]char = make_slice(@[]char, 4)
	args[0] = bootstrap.Concat("-o", "")
	args[1] = bootstrap.Concat(exePath, "")
	args[2] = bootstrap.Concat(objPath, "")
	args[3] = bootstrap.Concat("-Wl,-e,_main", "")
	var exit int = bootstrap.Exec("cc", args)
	if exit != 0 {
		return fail("linking failed")
	}

	// Run the executable — should exit with code 42
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var exitCode int = bootstrap.Exec(exePath, runArgs)
	if exitCode != 42 {
		return fail("expected exit code 42")
	}

	return ""
}

// Helper to assemble, link, run, and check exit code
func assembleAndRun(a @asm.Assembler, expected int) testing.TestResult {
	aarch64.ResolveFixups(a)
	asm.Finalize(a)
	if a.HasError { return fail("assembler error") }

	var objPath *[]const char = "/tmp/binate_asm_e2e.o"
	var ok bool = WriteARM64(a, objPath)
	if !ok { return fail("failed to write object file") }

	var exePath *[]const char = "/tmp/binate_asm_e2e"
	var args @[]@[]char = make_slice(@[]char, 4)
	args[0] = bootstrap.Concat("-o", "")
	args[1] = bootstrap.Concat(exePath, "")
	args[2] = bootstrap.Concat(objPath, "")
	args[3] = bootstrap.Concat("-Wl,-e,_main", "")
	var exit int = bootstrap.Exec("cc", args)
	if exit != 0 { return fail("linking failed") }

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var exitCode int = bootstrap.Exec(exePath, runArgs)
	if exitCode != expected {
		return fail("wrong exit code")
	}
	return ""
}

// Sum 1..9 using a loop: result = 45, exit code = 45
// Tests: backward branch, forward conditional branch, compare, add
//
//   _main:
//     mov w0, #0        // sum = 0
//     mov w1, #1        // i = 1
//   .loop:
//     add w0, w0, w1    // sum += i
//     add w1, w1, #1    // i++
//     cmp w1, #10
//     b.lt .loop        // if i < 10, loop
//     ret
func TestLoopSum() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")

	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(0))   // sum = 0
	aarch64.Mov(a, false, aarch64.X1, aarch64.Imm(1))   // i = 1

	asm.DefineLabel(a, "_main.loop")
	aarch64.Add(a, false, aarch64.X0, aarch64.X0, aarch64.Reg(aarch64.X1))  // sum += i
	aarch64.Add(a, false, aarch64.X1, aarch64.X1, aarch64.Imm(1))           // i++
	aarch64.Cmp(a, false, aarch64.X1, aarch64.Imm(10))                      // cmp i, 10
	aarch64.Bcond(a, aarch64.COND_LT, "_main.loop")                         // b.lt .loop
	aarch64.Ret(a)

	// 1+2+3+...+9 = 45
	return assembleAndRun(a, 45)
}

// Conditional: return 10 if arg would be 0 (it is), else 20.
// Tests: CBZ forward branch
//
//   _main:
//     mov w1, #0
//     cbnz w1, .nonzero
//     mov w0, #10
//     ret
//   .nonzero:
//     mov w0, #20
//     ret
func TestConditionalCbz() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")

	aarch64.Mov(a, false, aarch64.X1, aarch64.Imm(0))
	aarch64.Cbnz(a, false, aarch64.X1, "_main.nonzero")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(10))
	aarch64.Ret(a)

	asm.DefineLabel(a, "_main.nonzero")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(20))
	aarch64.Ret(a)

	return assembleAndRun(a, 10)
}

// Function call: _main calls _add5 via BL, tests function call + return
//
//   _add5:
//     add w0, w0, #5
//     ret
//   _main:
//     mov w0, #7
//     bl _add5
//     ret              // exit with 12
func TestFunctionCall() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	// _add5
	asm.DefineLabel(a, "_add5")
	aarch64.Add(a, false, aarch64.X0, aarch64.X0, aarch64.Imm(5))
	aarch64.Ret(a)

	// _main
	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")

	// Save LR (BL overwrites it)
	aarch64.Stp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))

	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(7))
	aarch64.Bl(a, "_add5")

	// Restore LR and return
	aarch64.Ldp(a, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a)

	// 7 + 5 = 12
	return assembleAndRun(a, 12)
}

// Multiply and divide: compute 7 * 8 / 4 = 14, exit with 14.
// Tests: MUL, SDIV
func TestMulDiv() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")

	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(7))
	aarch64.Mov(a, false, aarch64.X1, aarch64.Imm(8))
	aarch64.Mul(a, false, aarch64.X0, aarch64.X0, aarch64.X1)   // w0 = 7 * 8 = 56
	aarch64.Mov(a, false, aarch64.X1, aarch64.Imm(4))
	aarch64.Sdiv(a, false, aarch64.X0, aarch64.X0, aarch64.X1)  // w0 = 56 / 4 = 14
	aarch64.Ret(a)

	return assembleAndRun(a, 14)
}

// Conditional select: if 5 > 3 then 10 else 20. Exit with 10.
// Tests: CMP, CSEL
func TestCselE2E() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)

	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")

	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(5))
	aarch64.Cmp(a, false, aarch64.X0, aarch64.Imm(3))
	aarch64.Mov(a, false, aarch64.X1, aarch64.Imm(10))  // true value
	aarch64.Mov(a, false, aarch64.X2, aarch64.Imm(20))  // false value
	aarch64.Csel(a, false, aarch64.X0, aarch64.X1, aarch64.X2, aarch64.COND_GT)  // w0 = 5>3 ? 10 : 20
	aarch64.Ret(a)

	return assembleAndRun(a, 10)
}

// Cross-object function call: _add5 in one .o, _main in another .o, linked together.
// Tests Mach-O relocation emission for external BL.
func TestCrossObjectCall() testing.TestResult {
	if !canLinkAndRun() { return "" }
	// Object 1: _add5
	var a1 @asm.Assembler = asm.New(8)
	asm.SetSection(a1, "text", -1)
	asm.DefineLabel(a1, "_add5")
	asm.SetGlobal(a1, "_add5")
	aarch64.Add(a1, false, aarch64.X0, aarch64.X0, aarch64.Imm(5))
	aarch64.Ret(a1)
	aarch64.ResolveFixups(a1)
	asm.Finalize(a1)
	if a1.HasError { return fail("a1 assembler error") }

	var obj1 *[]const char = "/tmp/binate_asm_cross1.o"
	if !WriteARM64(a1, obj1) { return fail("failed to write obj1") }

	// Object 2: _main calls _add5 (external)
	var a2 @asm.Assembler = asm.New(8)
	asm.SetSection(a2, "text", -1)
	asm.DefineLabel(a2, "_main")
	asm.SetGlobal(a2, "_main")
	// Save LR
	aarch64.Stp(a2, true, aarch64.FP, aarch64.LR, aarch64.MemPre(aarch64.SP, -16))
	aarch64.Mov(a2, false, aarch64.X0, aarch64.Imm(7))
	// BL to external _add5 — generates a relocation
	asm.SetGlobal(a2, "_add5")
	aarch64.Bl(a2, "_add5")
	// Restore LR
	aarch64.Ldp(a2, true, aarch64.FP, aarch64.LR, aarch64.MemPost(aarch64.SP, 16))
	aarch64.Ret(a2)
	aarch64.ResolveFixups(a2)
	asm.Finalize(a2)
	if a2.HasError { return fail("a2 assembler error") }

	// Should have 1 relocation for the external BL
	if a2.NumRelocs != 1 { return fail("expected 1 relocation in obj2") }

	var obj2 *[]const char = "/tmp/binate_asm_cross2.o"
	if !WriteARM64(a2, obj2) { return fail("failed to write obj2") }

	// Link both objects together
	var exePath *[]const char = "/tmp/binate_asm_cross"
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = bootstrap.Concat("-o", "")
	args[1] = bootstrap.Concat(exePath, "")
	args[2] = bootstrap.Concat(obj1, "")
	args[3] = bootstrap.Concat(obj2, "")
	args[4] = bootstrap.Concat("-Wl,-e,_main", "")
	var exit int = bootstrap.Exec("cc", args)
	if exit != 0 { return fail("linking failed") }

	// Run — should exit with 12 (7 + 5)
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var exitCode int = bootstrap.Exec(exePath, runArgs)
	if exitCode != 12 {
		return fail("expected exit code 12")
	}
	return ""
}

// --- PAGEOFF12 relocation wiring ---

// Helper-level: FIX_ADD_LO12 / FIX_LDR_LO12 must map to ARM64_RELOC_PAGEOFF12
// with length=2 (4-byte instruction) and pcrel=0 (linker computes from target).
func TestRelocTypeAddLO12() testing.TestResult {
	// 105 is FIX_ADD_LO12 (defined in pkg/asm/aarch64; duplicated here as an
	// integer to avoid an import cycle).
	if machoRelocType(105, CPU_TYPE_ARM64) != ARM64_RELOC_PAGEOFF12 {
		return fail("FIX_ADD_LO12 should map to ARM64_RELOC_PAGEOFF12")
	}
	if machoRelocLength(105, CPU_TYPE_ARM64) != 2 {
		return fail("FIX_ADD_LO12 length should be 2 (4-byte instr)")
	}
	if machoRelocPCRel(105, CPU_TYPE_ARM64) != 0 {
		return fail("FIX_ADD_LO12 must not be PC-relative")
	}
	return ""
}

func TestRelocTypeLdrLO12() testing.TestResult {
	// 106 is FIX_LDR_LO12.
	if machoRelocType(106, CPU_TYPE_ARM64) != ARM64_RELOC_PAGEOFF12 {
		return fail("FIX_LDR_LO12 should map to ARM64_RELOC_PAGEOFF12")
	}
	if machoRelocLength(106, CPU_TYPE_ARM64) != 2 {
		return fail("FIX_LDR_LO12 length should be 2 (4-byte instr)")
	}
	if machoRelocPCRel(106, CPU_TYPE_ARM64) != 0 {
		return fail("FIX_LDR_LO12 must not be PC-relative")
	}
	return ""
}

// Integration: assemble ADRP+ADD+LDR against an external symbol and verify
// three relocations land with the expected Kinds, so a future refactor that
// breaks the pipeline between aarch64 fixups and macho relocs is caught here.
func TestAdrpAddLdrRelocsEmitted() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	asm.SetSection(a, "text", -1)
	asm.SetGlobal(a, "_g")
	aarch64.Adrp(a, aarch64.X0, "_g")
	aarch64.AddImmLabel(a, true, aarch64.X0, aarch64.X0, "_g")
	aarch64.LdrImmLabel(a, true, aarch64.X1, aarch64.X0, "_g")

	aarch64.ResolveFixups(a)
	asm.Finalize(a)

	if a.HasError { return fail("assembler error") }
	if a.NumRelocs != 3 { return fail("expected 3 relocations") }
	if a.Relocs[0].Kind != 103 { return fail("reloc[0] should be FIX_ADRP_HI21 (103)") }
	if a.Relocs[1].Kind != 105 { return fail("reloc[1] should be FIX_ADD_LO12 (105)") }
	if a.Relocs[2].Kind != 106 { return fail("reloc[2] should be FIX_LDR_LO12 (106)") }
	// Check the macho wiring for each kind.
	if machoRelocType(a.Relocs[0].Kind, CPU_TYPE_ARM64) != ARM64_RELOC_PAGE21 {
		return fail("ADRP reloc should map to PAGE21")
	}
	if machoRelocType(a.Relocs[1].Kind, CPU_TYPE_ARM64) != ARM64_RELOC_PAGEOFF12 {
		return fail("ADD reloc should map to PAGEOFF12")
	}
	if machoRelocType(a.Relocs[2].Kind, CPU_TYPE_ARM64) != ARM64_RELOC_PAGEOFF12 {
		return fail("LDR reloc should map to PAGEOFF12")
	}
	return ""
}

// E2E: assemble a program that loads a 32-bit global via ADRP+ADD+LDR, link,
// run, and verify the loaded value flows through as the exit code. This
// exercises PAGE21 + PAGEOFF12 (on ADD) relocations in a real binary.
//
//   _main:
//     adrp x0, _g@PAGE
//     add  x0, x0, _g@PAGEOFF
//     ldr  w0, [x0]            ; plain LDR — PAGEOFF12 applied to the ADD
//     ret
//   .data _g: .long 42
//
// The plain LDR uses 4-byte access, which is safe with the current section
// alignment (__data align=4). A 64-bit (X reg) load would need step 5.
func TestAdrpAddGlobalE2E() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)

	// .data _g: .long 42
	asm.SetSection(a, "data", -1)
	asm.DefineLabel(a, "_g")
	asm.SetGlobal(a, "_g")
	asm.EmitUint32(a, 42)

	// _main
	asm.SetSection(a, "text", -1)
	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")
	aarch64.Adrp(a, aarch64.X0, "_g")
	aarch64.AddImmLabel(a, true, aarch64.X0, aarch64.X0, "_g")
	aarch64.Ldr(a, false, aarch64.X0, aarch64.MemImm(aarch64.X0, 0))  // W0 = *X0
	aarch64.Ret(a)

	return assembleAndRun(a, 42)
}

// E2E: assemble a program that loads a 32-bit global via ADRP+LDR directly
// (no separate ADD), which emits PAGE21 + PAGEOFF12 (on LDR) relocations.
//
//   _main:
//     adrp x0, _g@PAGE
//     ldr  w0, [x0, _g@PAGEOFF]
//     ret
func TestAdrpLdrGlobalE2E() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)

	asm.SetSection(a, "data", -1)
	asm.DefineLabel(a, "_g")
	asm.SetGlobal(a, "_g")
	asm.EmitUint32(a, 37)

	asm.SetSection(a, "text", -1)
	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")
	aarch64.Adrp(a, aarch64.X0, "_g")
	aarch64.LdrImmLabel(a, false, aarch64.X0, aarch64.X0, "_g")  // W0 = *_g
	aarch64.Ret(a)

	return assembleAndRun(a, 37)
}

// --- __DATA section alignment (step 5) ---

// Direct test of machoSectAlign: data/bss need 8-byte alignment (2^3) for
// 64-bit loads; text only needs 4-byte alignment (2^2).
func TestSectAlignHelper() testing.TestResult {
	if machoSectAlign("text") != 2 { return fail("text align should be 2 (4 bytes)") }
	if machoSectAlign("data") != 3 { return fail("data align should be 3 (8 bytes)") }
	if machoSectAlign("bss") != 3 { return fail("bss align should be 3 (8 bytes)") }
	if machoSectAlign("rodata") != 2 { return fail("rodata align should be 2 (4 bytes)") }
	return ""
}

// E2E: 64-bit LDR from an 8-byte global. This requires the __data section
// to be 8-byte aligned in the final binary — without the align=3 bump this
// would SIGBUS when the linker lands __data at a 4-byte-aligned address.
//
//   _main:
//     adrp x0, _g@PAGE
//     add  x0, x0, _g@PAGEOFF
//     ldr  x0, [x0]           ; 64-bit load — needs 8-byte alignment
//     ret                     ; low 32 bits become the exit code
func TestAdrpAddGlobal64E2E() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)

	// .data _g: .quad 99
	asm.SetSection(a, "data", -1)
	asm.DefineLabel(a, "_g")
	asm.SetGlobal(a, "_g")
	asm.EmitUint64(a, 99)

	asm.SetSection(a, "text", -1)
	asm.DefineLabel(a, "_main")
	asm.SetGlobal(a, "_main")
	aarch64.Adrp(a, aarch64.X0, "_g")
	aarch64.AddImmLabel(a, true, aarch64.X0, aarch64.X0, "_g")
	aarch64.Ldr(a, true, aarch64.X0, aarch64.MemImm(aarch64.X0, 0))  // 64-bit load
	aarch64.Ret(a)

	return assembleAndRun(a, 99)
}
