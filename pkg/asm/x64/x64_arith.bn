package "pkg/asm/x64"

import "pkg/asm"

// --- ALU instructions ---
// Standard ALU ops share encoding patterns. The opcode base and /r
// extension differ per operation:
//   ADD: reg base 0x01, /r=0
//   OR:  reg base 0x09, /r=1
//   AND: reg base 0x21, /r=4
//   SUB: reg base 0x29, /r=5
//   XOR: reg base 0x31, /r=6
//   CMP: reg base 0x39, /r=7

// Add emits `add dst, src` (dst <- dst + src), updating flags.
func Add(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x01, 0)
}

// Or emits `or dst, src` (dst <- dst | src), updating flags.
func Or(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x09, 1)
}

// And emits `and dst, src` (dst <- dst & src), updating flags.
func And(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x21, 4)
}

// Sub emits `sub dst, src` (dst <- dst - src), updating flags.
func Sub(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x29, 5)
}

// Xor emits `xor dst, src` (dst <- dst ^ src), updating flags.
func Xor(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x31, 6)
}

// Cmp emits `cmp dst, src`, updating flags as if `dst - src` had been
// computed but discarding the result.
func Cmp(a @asm.Assembler, dst Operand, src Operand) {
	emitALU(a, dst, src, 0x39, 7)
}

// TEST: like AND but only sets flags (no result stored).
// Encoding: reg,reg = 0x85 (word) / 0x84 (byte)
//           reg,imm = 0xF7 /0 (word) / 0xF6 /0 (byte)
func Test(a @asm.Assembler, dst Operand, src Operand) {
	var size int = operandSize(dst, src)
	emitSizePrefix(a, size)
	if src.Kind == OP_REG {
		emitRex(a, rexW(size), src.Reg, 0, dst.Reg)
		if size == SZ8 {
			emit8(a, 0x84)
		} else {
			emit8(a, 0x85)
		}
		emitModRM(a, src.Reg, dst)
	} else if src.Kind == OP_IMM {
		var dstReg int = 0
		if dst.Kind == OP_REG { dstReg = dst.Reg }
		emitRex(a, rexW(size), 0, 0, dstReg)
		if size == SZ8 {
			emit8(a, 0xF6)
			emitModRM(a, 0, dst)
			emit8(a, src.Imm)
		} else {
			emit8(a, 0xF7)
			emitModRM(a, 0, dst)
			emit32le(a, src.Imm)
		}
	}
}

// --- Unary operations (INC, DEC, NEG, NOT) ---
// These use 0xF7 /ext (word) or 0xF6 /ext (byte):
//   NOT: /2, NEG: /3
// INC/DEC use 0xFF /0 (INC) / 0xFF /1 (DEC) for word,
//   0xFE /0 / 0xFE /1 for byte.

func Inc(a @asm.Assembler, dst Operand) {
	var size int = dst.Size
	if dst.Kind == OP_REG { size = dst.Size }
	emitSizePrefix(a, size)
	var dstReg int = 0
	if dst.Kind == OP_REG { dstReg = dst.Reg }
	emitRex(a, rexW(size), 0, 0, dstReg)
	if size == SZ8 {
		emit8(a, 0xFE)
	} else {
		emit8(a, 0xFF)
	}
	emitModRM(a, 0, dst)
}

// Dec emits `dec dst` (dst <- dst - 1), updating flags.
func Dec(a @asm.Assembler, dst Operand) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var dstReg int = 0
	if dst.Kind == OP_REG { dstReg = dst.Reg }
	emitRex(a, rexW(size), 0, 0, dstReg)
	if size == SZ8 {
		emit8(a, 0xFE)
	} else {
		emit8(a, 0xFF)
	}
	emitModRM(a, 1, dst)
}

// Neg emits `neg dst` (dst <- 0 - dst), updating flags.
func Neg(a @asm.Assembler, dst Operand) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var dstReg int = 0
	if dst.Kind == OP_REG { dstReg = dst.Reg }
	emitRex(a, rexW(size), 0, 0, dstReg)
	if size == SZ8 {
		emit8(a, 0xF6)
	} else {
		emit8(a, 0xF7)
	}
	emitModRM(a, 3, dst)
}

// Not emits `not dst` (dst <- ~dst). Does NOT update flags
// (unlike most ALU ops on x86).
func Not(a @asm.Assembler, dst Operand) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var dstReg int = 0
	if dst.Kind == OP_REG { dstReg = dst.Reg }
	emitRex(a, rexW(size), 0, 0, dstReg)
	if size == SZ8 {
		emit8(a, 0xF6)
	} else {
		emit8(a, 0xF7)
	}
	emitModRM(a, 2, dst)
}

// --- Shift instructions ---
// SHL/SHR/SAR: 0xD3 /ext for reg,CL; 0xC1 /ext for reg,imm8
//   SHL: /4, SHR: /5, SAR: /7

// emitShift emits a shift instruction (SHL/SHR/SAR). ext selects the
// opcode extension (/4, /5, /7). count is either CL or an immediate.
func emitShift(a @asm.Assembler, dst Operand, count Operand, ext int) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var dstReg int = 0
	if dst.Kind == OP_REG { dstReg = dst.Reg }
	emitRex(a, rexW(size), 0, 0, dstReg)
	if count.Kind == OP_REG {
		// Shift by CL: 0xD2 (byte) / 0xD3 (word/dword/qword)
		if size == SZ8 {
			emit8(a, 0xD2)
		} else {
			emit8(a, 0xD3)
		}
		emitModRM(a, ext, dst)
	} else if count.Kind == OP_IMM {
		if count.Imm == 1 {
			// Shift by 1: 0xD0 (byte) / 0xD1 (word)
			if size == SZ8 {
				emit8(a, 0xD0)
			} else {
				emit8(a, 0xD1)
			}
			emitModRM(a, ext, dst)
		} else {
			// Shift by imm8: 0xC0 (byte) / 0xC1 (word)
			if size == SZ8 {
				emit8(a, 0xC0)
			} else {
				emit8(a, 0xC1)
			}
			emitModRM(a, ext, dst)
			emit8(a, count.Imm)
		}
	}
}

// Shl emits `shl dst, count` — logical shift left. count is either an
// immediate or `cl` (encoded by emitShift via Operand kind).
func Shl(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, dst, count, 4)
}

// Shr emits `shr dst, count` — logical (unsigned) shift right.
func Shr(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, dst, count, 5)
}

// Sar emits `sar dst, count` — arithmetic (sign-preserving) shift right.
func Sar(a @asm.Assembler, dst Operand, count Operand) {
	emitShift(a, dst, count, 7)
}

// --- MOV ---
// MOV has many forms:
//   reg, reg:  0x89 (r/m, r) or 0x8B (r, r/m)
//   reg, imm:  0xB8+rd for 32/64-bit, 0xC7 /0 for r/m32
//   mem, reg:  0x89 (r/m, r)
//   reg, mem:  0x8B (r, r/m)
//   mem, imm:  0xC7 /0

func Mov(a @asm.Assembler, dst Operand, src Operand) {
	var size int = operandSize(dst, src)
	emitSizePrefix(a, size)

	if src.Kind == OP_REG && (dst.Kind == OP_REG || dst.Kind == OP_MEM) {
		// MOV r/m, r
		var bReg int = 0
		if dst.Kind == OP_REG { bReg = dst.Reg }
		if dst.Kind == OP_MEM && dst.Base >= 0 { bReg = dst.Base }
		var xReg int = 0
		if dst.Kind == OP_MEM && dst.Index >= 0 { xReg = dst.Index }
		emitRex(a, rexW(size), src.Reg, xReg, bReg)
		if size == SZ8 {
			emit8(a, 0x88)
		} else {
			emit8(a, 0x89)
		}
		emitModRM(a, src.Reg, dst)
		return
	}
	if src.Kind == OP_MEM && dst.Kind == OP_REG {
		// MOV r, r/m
		var bReg int = 0
		if src.Base >= 0 { bReg = src.Base }
		var xReg int = 0
		if src.Index >= 0 { xReg = src.Index }
		emitRex(a, rexW(size), dst.Reg, xReg, bReg)
		if size == SZ8 {
			emit8(a, 0x8A)
		} else {
			emit8(a, 0x8B)
		}
		emitModRM(a, dst.Reg, src)
		return
	}
	if src.Kind == OP_IMM && dst.Kind == OP_REG {
		// MOV reg, imm.
		if size == SZ8 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB0 + regLo3(dst.Reg))
			emit8(a, src.Imm)
			return
		}
		if size == SZ16 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB8 + regLo3(dst.Reg))
			a.EmitUint16(cast(uint16, src.Imm))
			return
		}
		if size == SZ32 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB8 + regLo3(dst.Reg))
			emit32le(a, src.Imm)
			return
		}
		// SZ64 has two encodings:
		//   - imm32-sign-extended `0xC7 /0 imm32` with REX.W: 7 bytes,
		//     used when src.Imm fits in a signed 32-bit (REX.W
		//     sign-extends the imm32 to 64 bits).
		//   - imm64 `0xB8+rd imm64` with REX.W: 10 bytes, used when
		//     src.Imm doesn't fit signed i32.  Pre-fix, the imm32
		//     encoding was used regardless and wide constants were
		//     silently truncated to 32 bits.
		if src.Imm >= -2147483648 && src.Imm <= 2147483647 {
			emitRex(a, true, 0, 0, dst.Reg)
			emit8(a, 0xC7)
			// ModRM: mod=11 (reg-direct), reg=/0, rm=dst.
			emit8(a, 0xC0 + regLo3(dst.Reg))
			emit32le(a, src.Imm)
			return
		}
		emitRex(a, true, 0, 0, dst.Reg)
		emit8(a, 0xB8 + regLo3(dst.Reg))
		// imm64: little-endian 8 bytes.
		a.EmitUint64(cast(uint64, src.Imm))
		return
	}
	if src.Kind == OP_IMM && dst.Kind == OP_MEM {
		// MOV r/m, imm32: 0xC7 /0
		var bReg int = 0
		if dst.Base >= 0 { bReg = dst.Base }
		var xReg int = 0
		if dst.Index >= 0 { xReg = dst.Index }
		emitRex(a, rexW(size), 0, xReg, bReg)
		if size == SZ8 {
			emit8(a, 0xC6)
		} else {
			emit8(a, 0xC7)
		}
		emitModRM(a, 0, dst)
		if size == SZ8 {
			emit8(a, src.Imm)
		} else {
			emit32le(a, src.Imm)
		}
	}
}

// --- LEA ---
// LEA r, m: 0x8D r, r/m (always uses word form)

func Lea(a @asm.Assembler, dst Operand, src Operand) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var bReg int = 0
	if src.Base >= 0 { bReg = src.Base }
	var xReg int = 0
	if src.Index >= 0 { xReg = src.Index }
	emitRex(a, rexW(size), dst.Reg, xReg, bReg)
	emit8(a, 0x8D)
	emitModRM(a, dst.Reg, src)
}

// --- PUSH / POP ---
// PUSH reg: 0x50+rd (no REX.W needed, always 64-bit in 64-bit mode)
// POP reg:  0x58+rd
// PUSH imm: 0x68 imm32 or 0x6A imm8

func Push(a @asm.Assembler, src Operand) {
	if src.Kind == OP_REG {
		if regHi(src.Reg) != 0 {
			emit8(a, 0x41)  // REX.B
		}
		emit8(a, 0x50 + regLo3(src.Reg))
	} else if src.Kind == OP_IMM {
		if fitsI8(src.Imm) {
			emit8(a, 0x6A)
			emit8(a, src.Imm)
		} else {
			emit8(a, 0x68)
			emit32le(a, src.Imm)
		}
	}
}

// Pop emits `pop dst` — copy the 64-bit word at [rsp] into dst and
// then increment rsp by 8. Always 64-bit in 64-bit mode.
func Pop(a @asm.Assembler, dst Operand) {
	if dst.Kind == OP_REG {
		if regHi(dst.Reg) != 0 {
			emit8(a, 0x41)  // REX.B
		}
		emit8(a, 0x58 + regLo3(dst.Reg))
	}
}

// --- Multiply / Divide ---

// IMUL r, r/m: 0F AF /r (two-operand signed multiply)
func Imul2(a @asm.Assembler, dst Operand, src Operand) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var bReg int = 0
	if src.Kind == OP_REG { bReg = src.Reg }
	if src.Kind == OP_MEM && src.Base >= 0 { bReg = src.Base }
	emitRex(a, rexW(size), dst.Reg, 0, bReg)
	emit8(a, 0x0F)
	emit8(a, 0xAF)
	emitModRM(a, dst.Reg, src)
}

// IMUL r, r/m, imm: 0x69 /r imm32 or 0x6B /r imm8
func Imul3(a @asm.Assembler, dst Operand, src Operand, imm int) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var bReg int = 0
	if src.Kind == OP_REG { bReg = src.Reg }
	emitRex(a, rexW(size), dst.Reg, 0, bReg)
	if fitsI8(imm) {
		emit8(a, 0x6B)
		emitModRM(a, dst.Reg, src)
		emit8(a, imm)
	} else {
		emit8(a, 0x69)
		emitModRM(a, dst.Reg, src)
		emit32le(a, imm)
	}
}

// IDIV r/m: 0xF7 /7 (signed divide RDX:RAX by r/m)
func Idiv(a @asm.Assembler, src Operand) {
	var size int = src.Size
	emitSizePrefix(a, size)
	var bReg int = 0
	if src.Kind == OP_REG { bReg = src.Reg }
	emitRex(a, rexW(size), 0, 0, bReg)
	if size == SZ8 {
		emit8(a, 0xF6)
	} else {
		emit8(a, 0xF7)
	}
	emitModRM(a, 7, src)
}

// DIV r/m: 0xF7 /6 (unsigned divide)
func Div(a @asm.Assembler, src Operand) {
	var size int = src.Size
	emitSizePrefix(a, size)
	var bReg int = 0
	if src.Kind == OP_REG { bReg = src.Reg }
	emitRex(a, rexW(size), 0, 0, bReg)
	if size == SZ8 {
		emit8(a, 0xF6)
	} else {
		emit8(a, 0xF7)
	}
	emitModRM(a, 6, src)
}

// CQO: sign-extend RAX into RDX:RAX (REX.W + 0x99)
func Cqo(a @asm.Assembler) {
	emit8(a, 0x48)  // REX.W
	emit8(a, 0x99)
}

// CDQ: sign-extend EAX into EDX:EAX (0x99, no REX.W)
func Cdq(a @asm.Assembler) {
	emit8(a, 0x99)
}

// --- SETcc / MOVZX ---

// Setcc emits `setCC dst8` — write 1 to the low byte of dst if the
// flags satisfy condition cc, else 0.  Always operates on the
// 8-bit-low-byte view (AL, CL, R10B, ...).  Encoded as 0F 9{cc} /0,
// with a REX prefix when dst.Reg is RSP/RBP/RSI/RDI/R8..R15 to
// disambiguate from the legacy AH/CH/DH/BH high-byte registers.
// The cc argument is one of the CC_* constants.
//
// dst must be an OP_REG; size doesn't matter (the encoding is
// 8-bit-fixed).  Caller typically follows with MOVZX r64, dst8 to
// zero-extend the bool result into a full register.
func Setcc(a @asm.Assembler, cc int, dst Operand) {
	if dst.Kind != OP_REG { return }
	// REX prefix discipline for 8-bit operands:
	//   - regs 0-3 (AL/CL/DL/BL): no REX needed (default low byte).
	//   - regs 4-7 (RSP/RBP/RSI/RDI): low byte is SPL/BPL/SIL/DIL,
	//     which requires an explicit REX (= 0x40) to disambiguate
	//     from the legacy AH/CH/DH/BH high-byte regs (without REX,
	//     ModRM rm=100..111 in 8-bit context selects AH..BH).
	//   - regs 8-15: needs REX.B (= 0x41).  emitRex's normal path.
	if dst.Reg >= 4 && dst.Reg < 8 {
		emit8(a, 0x40)
	} else {
		emitRex(a, false, 0, 0, dst.Reg)
	}
	emit8(a, 0x0F)
	emit8(a, 0x90 + (cc & 0xF))
	// ModRM: mod=11 (reg-direct), reg=/0 (000), rm=dst low 3 bits.
	emit8(a, 0xC0 + regLo3(dst.Reg))
}

// Movzx emits `movzx dst, src` — zero-extend the byte in src into
// the wider register dst.  Most commonly used after SETcc to lift
// an 8-bit bool result to a 64-bit register.
//
// Encoding (REX.W?) + 0F B6 /r with mod=11 (reg-direct).  src is
// the 8-bit-low-byte view; dst is the wider register (size from
// dst.Size, typically SZ64).
func Movzx(a @asm.Assembler, dst Operand, src Operand) {
	if dst.Kind != OP_REG || src.Kind != OP_REG { return }
	emitRex(a, rexW(dst.Size), dst.Reg, 0, src.Reg)
	emit8(a, 0x0F)
	emit8(a, 0xB6)
	emit8(a, 0xC0 + (regLo3(dst.Reg) << 3) + regLo3(src.Reg))
}
