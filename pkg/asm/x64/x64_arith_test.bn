package "pkg/asm/x64"

import "pkg/asm"
import "pkg/builtin/testing"

// --- MOV tests ---

func TestMovRegReg64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV RAX, RCX = REX.W 89 C8 (mov r/m64, r64)
	// REX.W=0x48, 0x89, ModRM=11|001|000 = 0xC8
	Mov(a, Reg(RAX, SZ64), Reg(RCX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x48
	expected[1] = 0x89
	expected[2] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("MOV RAX, RCX encoding wrong")
	}
	return ""
}

func TestMovRegReg32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV EAX, ECX = 89 C8 (no REX needed for 32-bit)
	Mov(a, Reg(RAX, SZ32), Reg(RCX, SZ32))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0x89
	expected[1] = 0xC8
	if !checkBytes(s, 0, expected) {
		return fail("MOV EAX, ECX encoding wrong")
	}
	return ""
}

func TestMovRegImm32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV EAX, 42 = B8 2A000000
	Mov(a, Reg(RAX, SZ32), Imm(42))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 5)
	expected[0] = 0xB8
	expected[1] = 42
	expected[2] = 0
	expected[3] = 0
	expected[4] = 0
	if !checkBytes(s, 0, expected) {
		return fail("MOV EAX, 42 encoding wrong")
	}
	return ""
}

// MOV r64, imm where the immediate fits signed i32 uses the
// imm32-sign-extended form: REX.W + 0xC7 /0 + imm32 = 7 bytes
// (more compact than the 10-byte imm64 form).  Pre-fix this
// emitted `REX.W 0xB8+rd imm32` = 6 bytes, which is an invalid
// encoding — `0xB8+rd` with REX.W is the MOVABS form and expects
// an 8-byte imm64, so the 6-byte sequence would misalign the
// instruction stream.
func TestMovRegImm64SmallUsesC7Imm32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(RAX, SZ64), Imm(42))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 7)
	expected[0] = 0x48  // REX.W
	expected[1] = 0xC7  // MOV r/m64, imm32
	expected[2] = 0xC0  // ModRM: mod=11, reg=/0, rm=000 (RAX)
	expected[3] = 42
	expected[4] = 0
	expected[5] = 0
	expected[6] = 0
	if !checkBytes(s, 0, expected) {
		return fail("MOV RAX, 42 should use C7 /0 imm32 encoding")
	}
	return ""
}

// MOV r64, imm where the immediate exceeds signed i32 range MUST
// use the imm64 (MOVABS) form: REX.W + 0xB8+rd + imm64 = 10 bytes.
// Pre-fix this silently truncated to 32 bits, producing wrong
// constants for any value > INT32_MAX or < INT32_MIN.
func TestMovRegImm64WideUsesMovabsImm64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, Reg(R10, SZ64), Imm(5000000000))
	var s @asm.Section = a.Sections[0]
	// 5000000000 = 0x12A05F200 — needs all 64 bits.
	// Expected: 49 BA 00 F2 05 2A 01 00 00 00
	if s.Len != 10 {
		return fail("MOVABS r64, imm64 should be 10 bytes")
	}
	var data *[]uint8 = s.Data
	if data[0] != cast(uint8, 0x49) {
		return fail("byte 0 should be REX.WB = 0x49")
	}
	if data[1] != cast(uint8, 0xBA) {
		return fail("byte 1 should be 0xB8+rd = 0xBA (R10)")
	}
	// Spot-check the imm64 low byte and high byte for endianness.
	if data[2] != cast(uint8, 0x00) {
		return fail("byte 2 (imm64[0]) should be 0x00")
	}
	if data[9] != cast(uint8, 0x00) {
		return fail("byte 9 (imm64[7]) should be 0x00")
	}
	return ""
}

func TestMovR8Reg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV R8, RAX = REX.WB 89 C0
	// REX = 0x49 (W=1, B=1), 0x89, ModRM = 11|000|000 = 0xC0
	Mov(a, Reg(R8, SZ64), Reg(RAX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x49
	expected[1] = 0x89
	expected[2] = 0xC0
	if !checkBytes(s, 0, expected) {
		return fail("MOV R8, RAX encoding wrong")
	}
	return ""
}

func TestMovMemReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV [RBP-8], RAX = REX.W 89 45 F8
	// REX.W=0x48, 0x89, ModRM=01|000|101=0x45, disp8=0xF8(-8)
	Mov(a, Mem(RBP, -8, SZ64), Reg(RAX, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x89
	expected[2] = 0x45
	expected[3] = 0xF8
	if !checkBytes(s, 0, expected) {
		return fail("MOV [RBP-8], RAX encoding wrong")
	}
	return ""
}

func TestMovRegMem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOV RAX, [RBP-8] = REX.W 8B 45 F8
	Mov(a, Reg(RAX, SZ64), Mem(RBP, -8, SZ64))
	var s @asm.Section = a.Sections[0]
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x8B
	expected[2] = 0x45
	expected[3] = 0xF8
	if !checkBytes(s, 0, expected) {
		return fail("MOV RAX, [RBP-8] encoding wrong")
	}
	return ""
}

