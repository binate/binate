package "pkg/asm/x64"

import "pkg/asm"

// ============================================================
// Data movement: MOV / LEA / PUSH / POP / SETcc / MOVZX /
//                MOVSX / MOVSXD / LeaRipLabel
// ============================================================
//
// Split out of x64_arith.bn to keep that file under the file-
// length soft cap.  The pure-ALU / unary / shift / multiply /
// divide encoders stay in x64_arith.bn; everything that just
// moves data (or computes effective addresses) lives here.

// --- MOV ---
// MOV has many forms:
//   reg, reg:  0x89 (r/m, r) or 0x8B (r, r/m)
//   reg, imm:  0xB8+rd for 32/64-bit, 0xC7 /0 for r/m32
//   mem, reg:  0x89 (r/m, r)
//   reg, mem:  0x8B (r, r/m)
//   mem, imm:  0xC7 /0

func Mov(a @asm.Assembler, dst Operand, src Operand) {
	var size int = operandSize(dst, src)
	emitSizePrefix(a, size)

	if src.Kind == OP_REG && (dst.Kind == OP_REG || dst.Kind == OP_MEM) {
		// MOV r/m, r
		var bReg int = 0
		if dst.Kind == OP_REG { bReg = dst.Reg }
		if dst.Kind == OP_MEM && dst.Base >= 0 { bReg = dst.Base }
		var xReg int = 0
		if dst.Kind == OP_MEM && dst.Index >= 0 { xReg = dst.Index }
		emitRex(a, rexW(size), src.Reg, xReg, bReg)
		if size == SZ8 {
			emit8(a, 0x88)
		} else {
			emit8(a, 0x89)
		}
		emitModRM(a, src.Reg, dst)
		return
	}
	if src.Kind == OP_MEM && dst.Kind == OP_REG {
		// MOV r, r/m
		var bReg int = 0
		if src.Base >= 0 { bReg = src.Base }
		var xReg int = 0
		if src.Index >= 0 { xReg = src.Index }
		emitRex(a, rexW(size), dst.Reg, xReg, bReg)
		if size == SZ8 {
			emit8(a, 0x8A)
		} else {
			emit8(a, 0x8B)
		}
		emitModRM(a, dst.Reg, src)
		return
	}
	if src.Kind == OP_IMM && dst.Kind == OP_REG {
		// MOV reg, imm.
		if size == SZ8 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB0 + regLo3(dst.Reg))
			emit8(a, cast(int, src.Imm))
			return
		}
		if size == SZ16 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB8 + regLo3(dst.Reg))
			a.EmitUint16(cast(uint16, src.Imm))
			return
		}
		if size == SZ32 {
			emitRex(a, false, 0, 0, dst.Reg)
			emit8(a, 0xB8 + regLo3(dst.Reg))
			emit32le(a, cast(int, src.Imm))
			return
		}
		// SZ64 has two encodings:
		//   - imm32-sign-extended `0xC7 /0 imm32` with REX.W: 7 bytes,
		//     used when src.Imm fits in a signed 32-bit (REX.W
		//     sign-extends the imm32 to 64 bits).
		//   - imm64 `0xB8+rd imm64` with REX.W: 10 bytes, used when
		//     src.Imm doesn't fit signed i32.  Pre-fix, the imm32
		//     encoding was used regardless and wide constants were
		//     silently truncated to 32 bits.
		if src.Imm >= -2147483648 && src.Imm <= 2147483647 {
			emitRex(a, true, 0, 0, dst.Reg)
			emit8(a, 0xC7)
			// ModRM: mod=11 (reg-direct), reg=/0, rm=dst.
			emit8(a, 0xC0 + regLo3(dst.Reg))
			emit32le(a, cast(int, src.Imm))
			return
		}
		emitRex(a, true, 0, 0, dst.Reg)
		emit8(a, 0xB8 + regLo3(dst.Reg))
		// imm64: little-endian 8 bytes.
		a.EmitUint64(cast(uint64, src.Imm))
		return
	}
	if src.Kind == OP_IMM && dst.Kind == OP_MEM {
		// MOV r/m, imm32: 0xC7 /0
		var bReg int = 0
		if dst.Base >= 0 { bReg = dst.Base }
		var xReg int = 0
		if dst.Index >= 0 { xReg = dst.Index }
		emitRex(a, rexW(size), 0, xReg, bReg)
		if size == SZ8 {
			emit8(a, 0xC6)
		} else {
			emit8(a, 0xC7)
		}
		emitModRM(a, 0, dst)
		if size == SZ8 {
			emit8(a, cast(int, src.Imm))
		} else {
			emit32le(a, cast(int, src.Imm))
		}
	}
}

// --- LEA ---
// LEA r, m: 0x8D r, r/m (always uses word form)

func Lea(a @asm.Assembler, dst Operand, src Operand) {
	var size int = dst.Size
	emitSizePrefix(a, size)
	var bReg int = 0
	if src.Base >= 0 { bReg = src.Base }
	var xReg int = 0
	if src.Index >= 0 { xReg = src.Index }
	emitRex(a, rexW(size), dst.Reg, xReg, bReg)
	emit8(a, 0x8D)
	emitModRM(a, dst.Reg, src)
}

// --- PUSH / POP ---
// PUSH reg: 0x50+rd (no REX.W needed, always 64-bit in 64-bit mode)
// POP reg:  0x58+rd
// PUSH imm: 0x68 imm32 or 0x6A imm8

func Push(a @asm.Assembler, src Operand) {
	if src.Kind == OP_REG {
		if regHi(src.Reg) != 0 {
			emit8(a, 0x41)  // REX.B
		}
		emit8(a, 0x50 + regLo3(src.Reg))
	} else if src.Kind == OP_IMM {
		if fitsI8(cast(int, src.Imm)) {
			emit8(a, 0x6A)
			emit8(a, cast(int, src.Imm))
		} else {
			emit8(a, 0x68)
			emit32le(a, cast(int, src.Imm))
		}
	}
}

// Pop emits `pop dst` — copy the 64-bit word at [rsp] into dst and
// then increment rsp by 8. Always 64-bit in 64-bit mode.
func Pop(a @asm.Assembler, dst Operand) {
	if dst.Kind == OP_REG {
		if regHi(dst.Reg) != 0 {
			emit8(a, 0x41)  // REX.B
		}
		emit8(a, 0x58 + regLo3(dst.Reg))
	}
}

// --- SETcc / MOVZX / MOVSX / MOVSXD ---

// Setcc emits `setCC dst8` — write 1 to the low byte of dst if the
// flags satisfy condition cc, else 0.  Always operates on the
// 8-bit-low-byte view (AL, CL, R10B, ...).  Encoded as 0F 9{cc} /0,
// with a REX prefix when dst.Reg is RSP/RBP/RSI/RDI/R8..R15 to
// disambiguate from the legacy AH/CH/DH/BH high-byte registers.
// The cc argument is one of the CC_* constants.
//
// dst must be an OP_REG; size doesn't matter (the encoding is
// 8-bit-fixed).  Caller typically follows with MOVZX r64, dst8 to
// zero-extend the bool result into a full register.
func Setcc(a @asm.Assembler, cc int, dst Operand) {
	if dst.Kind != OP_REG { return }
	// REX prefix discipline for 8-bit operands:
	//   - regs 0-3 (AL/CL/DL/BL): no REX needed (default low byte).
	//   - regs 4-7 (RSP/RBP/RSI/RDI): low byte is SPL/BPL/SIL/DIL,
	//     which requires an explicit REX (= 0x40) to disambiguate
	//     from the legacy AH/CH/DH/BH high-byte regs (without REX,
	//     ModRM rm=100..111 in 8-bit context selects AH..BH).
	//   - regs 8-15: needs REX.B (= 0x41).  emitRex's normal path.
	if dst.Reg >= 4 && dst.Reg < 8 {
		emit8(a, 0x40)
	} else {
		emitRex(a, false, 0, 0, dst.Reg)
	}
	emit8(a, 0x0F)
	emit8(a, 0x90 + (cc & 0xF))
	// ModRM: mod=11 (reg-direct), reg=/0 (000), rm=dst low 3 bits.
	emit8(a, 0xC0 + regLo3(dst.Reg))
}

// Movzx emits `movzx dst, src` — zero-extend src into the wider
// register dst.  src is either an 8-bit / 16-bit register or an
// 8-bit / 16-bit memory operand; dst is the wider register (size
// from dst.Size, typically SZ32 or SZ64).
//
// Encoding: (REX.W?) + 0F B6 /r (byte src) or 0F B7 /r (word src).
// src.Size picks the byte vs word form.
func Movzx(a @asm.Assembler, dst Operand, src Operand) {
	if dst.Kind != OP_REG { return }
	var bReg int = 0
	var xReg int = 0
	if src.Kind == OP_REG {
		bReg = src.Reg
	} else {
		// OP_MEM: base / index drive the REX.B / REX.X bits.
		if src.Base >= 0 { bReg = src.Base }
		if src.Index >= 0 { xReg = src.Index }
	}
	emitRex(a, rexW(dst.Size), dst.Reg, xReg, bReg)
	emit8(a, 0x0F)
	if src.Size == SZ16 {
		emit8(a, 0xB7)
	} else {
		emit8(a, 0xB6)
	}
	if src.Kind == OP_REG {
		emit8(a, 0xC0 + (regLo3(dst.Reg) << 3) + regLo3(src.Reg))
	} else {
		emitModRM(a, dst.Reg, src)
	}
}

// Movsx emits `movsx dst, src` — sign-extend a byte (src.Size=SZ8)
// or word (src.Size=SZ16) source into the wider register dst.
// Used by emitScalarLoad for signed sub-word loads.  src is either
// an 8/16-bit register or an 8/16-bit memory operand.
//
// Encoding: (REX.W?) + 0F BE /r (byte src) or 0F BF /r (word src).
func Movsx(a @asm.Assembler, dst Operand, src Operand) {
	if dst.Kind != OP_REG { return }
	var bReg int = 0
	var xReg int = 0
	if src.Kind == OP_REG {
		bReg = src.Reg
	} else {
		if src.Base >= 0 { bReg = src.Base }
		if src.Index >= 0 { xReg = src.Index }
	}
	emitRex(a, rexW(dst.Size), dst.Reg, xReg, bReg)
	emit8(a, 0x0F)
	if src.Size == SZ16 {
		emit8(a, 0xBF)
	} else {
		emit8(a, 0xBE)
	}
	if src.Kind == OP_REG {
		emit8(a, 0xC0 + (regLo3(dst.Reg) << 3) + regLo3(src.Reg))
	} else {
		emitModRM(a, dst.Reg, src)
	}
}

// Movsxd emits `movsxd dst, src` — sign-extend a 32-bit source into
// the 64-bit dst.  Encoding: REX.W + 0x63 /r.  src.Size should be
// SZ32 (the source is a 32-bit register or 32-bit memory operand).
func Movsxd(a @asm.Assembler, dst Operand, src Operand) {
	if dst.Kind != OP_REG { return }
	var bReg int = 0
	var xReg int = 0
	if src.Kind == OP_REG {
		bReg = src.Reg
	} else {
		if src.Base >= 0 { bReg = src.Base }
		if src.Index >= 0 { xReg = src.Index }
	}
	emitRex(a, true, dst.Reg, xReg, bReg)
	emit8(a, 0x63)
	if src.Kind == OP_REG {
		emit8(a, 0xC0 + (regLo3(dst.Reg) << 3) + regLo3(src.Reg))
	} else {
		emitModRM(a, dst.Reg, src)
	}
}

// LeaRipLabel emits `lea dst, [rip + rel32]` where the rel32 is
// resolved by ResolveFixups (same-section) or carried into the
// ELF as an R_X86_64_PC32 relocation (cross-section / extern).
// Used by the native amd64 backend for OP_CONST_STRING and global-
// var addresses — the symmetric of arm64's ADRP+ADD pair.
//
// Encoding: REX.W + 0x8D + ModRM (mod=00, reg=dst3, rm=101) + rel32.
// The rm=101 form in mod=00 selects RIP-relative addressing in
// 64-bit mode (the legacy [disp32] absolute addressing isn't
// available without an explicit SIB byte).
func LeaRipLabel(a @asm.Assembler, dst Operand, label *[]const char) {
	if dst.Kind != OP_REG { return }
	emitRex(a, true, dst.Reg, 0, 0)
	emit8(a, 0x8D)
	emit8(a, (regLo3(dst.Reg) << 3) + 0x05)
	a.AddFixup(label, FIX_REL32, 0, 4)
	emit32le(a, 0)  // placeholder; ResolveFixups patches it
}
