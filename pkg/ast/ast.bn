package "pkg/ast"

// ExprKindName returns the string name of an expression kind constant.
// The returned slice borrows from a string literal (valid for program lifetime).
func ExprKindName(kind int) *[]const char {
	switch kind {
	case EXPR_IDENT:
		return "IDENT"
	case EXPR_INT_LIT:
		return "INT_LIT"
	case EXPR_STRING_LIT:
		return "STRING_LIT"
	case EXPR_CHAR_LIT:
		return "CHAR_LIT"
	case EXPR_BOOL_LIT:
		return "BOOL_LIT"
	case EXPR_NIL_LIT:
		return "NIL_LIT"
	case EXPR_BINARY:
		return "BINARY"
	case EXPR_UNARY:
		return "UNARY"
	case EXPR_CALL:
		return "CALL"
	case EXPR_INSTANTIATE_OR_INDEX:
		return "INSTANTIATE_OR_INDEX"
	case EXPR_SLICE:
		return "SLICE"
	case EXPR_SELECTOR:
		return "SELECTOR"
	case EXPR_COMPOSITE:
		return "COMPOSITE"
	case EXPR_BUILTIN:
		return "BUILTIN"
	case EXPR_TYPE:
		return "TYPE"
	default:
		return "UNKNOWN_EXPR"
	}
}

// StmtKindName returns the string name of a statement kind constant.
func StmtKindName(kind int) *[]const char {
	switch kind {
	case STMT_BLOCK:
		return "BLOCK"
	case STMT_EXPR:
		return "EXPR"
	case STMT_ASSIGN:
		return "ASSIGN"
	case STMT_SHORT_VAR:
		return "SHORT_VAR"
	case STMT_INC_DEC:
		return "INC_DEC"
	case STMT_RETURN:
		return "RETURN"
	case STMT_BREAK:
		return "BREAK"
	case STMT_CONTINUE:
		return "CONTINUE"
	case STMT_IF:
		return "IF"
	case STMT_FOR:
		return "FOR"
	case STMT_SWITCH:
		return "SWITCH"
	case STMT_EMPTY:
		return "EMPTY"
	case STMT_DECL:
		return "DECL"
	default:
		return "UNKNOWN_STMT"
	}
}

// DeclKindName returns the string name of a declaration kind constant.
func DeclKindName(kind int) *[]const char {
	switch kind {
	case DECL_FUNC:
		return "FUNC"
	case DECL_VAR:
		return "VAR"
	case DECL_CONST:
		return "CONST"
	case DECL_TYPE:
		return "TYPE"
	case DECL_GROUP:
		return "GROUP"
	case DECL_INTERFACE:
		return "INTERFACE"
	case DECL_IMPL:
		return "IMPL"
	default:
		return "UNKNOWN_DECL"
	}
}

// TypeExprKindName returns the string name of a type expression kind constant.
func TypeExprKindName(kind int) *[]const char {
	switch kind {
	case TEXPR_NAMED:
		return "NAMED"
	case TEXPR_POINTER:
		return "POINTER"
	case TEXPR_MANAGED:
		return "MANAGED"
	case TEXPR_MANAGED_SLICE:
		return "MANAGED_SLICE"
	case TEXPR_SLICE:
		return "SLICE"
	case TEXPR_ARRAY:
		return "ARRAY"
	case TEXPR_STRUCT:
		return "STRUCT"
	case TEXPR_PAREN:
		return "PAREN"
	case TEXPR_SELF:
		return "SELF"
	case TEXPR_TYPE_PARAM:
		return "TYPE_PARAM"
	case TEXPR_INSTANTIATE:
		return "INSTANTIATE"
	default:
		return "UNKNOWN_TEXPR"
	}
}
