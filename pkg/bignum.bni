// Package bignum provides compile-time integer constants for the
// type checker's literal + const-expression machinery. Implements
// the rules ratified in claude-notes.md § "Integer literal value
// range and constant-expression arithmetic — DECIDED 2026-05-15".
//
// Today the representation is `(uint64 magnitude, bool sign)`,
// covering the union of `int64` and `uint64` ranges (`[-2^63,
// 2^64-1]`). Operations detect overflow against that range; no
// silent wrap. The package is shaped as an abstraction so a
// future bignum drop-in (e.g. `math/big`-style precision) can be
// swapped in without touching the type-checker's call sites.
//
// `Sign == true` means strictly negative; magnitude carries the
// absolute value. Canonical zero is `(0, false)`. A negative
// `Num` is only valid for magnitudes `<= 2^63` (so the smallest
// representable value is `-2^63`, matching `int64`-min). A
// non-negative `Num` may have any uint64 magnitude.
package "pkg/bignum"

// Num is a compile-time integer constant.  Magnitude holds the
// absolute value; Sign is true iff the value is strictly negative.
type Num struct {
	Magnitude uint64
	Sign      bool
}

// Zero returns the canonical zero (magnitude 0, non-negative).
func Zero() Num

// FromInt builds a Num from a signed host int.
func FromInt(v int) Num

// FromUint64 builds a Num from an unsigned 64-bit value.  Always
// non-negative.
func FromUint64(v uint64) Num

// ParseLiteral parses an integer literal string.  Accepts decimal,
// hexadecimal (`0x` / `0X`), octal (`0o` / `0O`), and binary
// (`0b` / `0B`) bases.  The input names a non-negative magnitude;
// callers that observe a unary minus apply `Neg` afterwards.
// Returns `ok=false` if the parsed magnitude exceeds `2^64-1`.
func ParseLiteral(s *[]readonly char) (Num, bool)

// Equals reports structural equality (canonical-zero-aware).
func (a Num) Equals(b Num) bool

// IsZero reports whether a is the canonical zero.
func (a Num) IsZero() bool

// IsNegative reports whether a is strictly less than zero.
func (a Num) IsNegative() bool

// Cmp returns -1 / 0 / 1 if a < b / a == b / a > b respectively.
func (a Num) Cmp(b Num) int

// Add returns `a + b`.  `ok=false` if the result falls outside
// the representable range `[-2^63, 2^64-1]`.
func (a Num) Add(b Num) (Num, bool)

// Sub returns `a - b`.  `ok=false` on out-of-range.
func (a Num) Sub(b Num) (Num, bool)

// Mul returns `a * b`.  `ok=false` on out-of-range.
func (a Num) Mul(b Num) (Num, bool)

// Neg returns `-a`.  `ok=false` only when negating a non-negative
// value whose magnitude exceeds `2^63` (negation would underflow
// `int64`-min).
func (a Num) Neg() (Num, bool)

// Div returns `a / b` (integer division, truncated toward zero —
// Go's semantics).  `ok=false` iff `b == 0`.  Sign of the result
// is `a.Sign XOR b.Sign`; magnitudes divide as uint64.
func (a Num) Div(b Num) (Num, bool)

// Mod returns `a % b` (remainder, with the sign of the dividend
// — Go's semantics).  `ok=false` iff `b == 0`.
func (a Num) Mod(b Num) (Num, bool)

// FitsSigned reports whether a fits in a signed integer of the
// given width in bits (e.g. 8, 16, 32, 64).  Range is
// `[-2^(width-1), 2^(width-1)-1]`.
func (a Num) FitsSigned(width int) bool

// FitsUnsigned reports whether a fits in an unsigned integer of
// the given width.  Range is `[0, 2^width-1]`.  A negative value
// never fits.
func (a Num) FitsUnsigned(width int) bool

// ToInt returns the value as a host int.  Caller must have verified
// the value fits in `int` (via `FitsSigned(intWidth)`); otherwise
// the result is silently truncated.
func (a Num) ToInt() int

// ToUint64 returns the magnitude as a uint64.  Caller must have
// verified the value is non-negative; otherwise the result is the
// magnitude only (sign discarded).
func (a Num) ToUint64() uint64
