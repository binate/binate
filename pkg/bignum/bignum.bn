package "pkg/bignum"

// Implementation of pkg/bignum.  See pkg/bignum.bni for the
// public surface and the design context.

// uint64Max returns 2^64 - 1.  Built by 2*(2^63 - 1) + 1 via
// shifts so the bootstrap (which today rejects literals beyond
// int64-max) doesn't have to express the constant directly.
func uint64Max() uint64 {
	var halfPlusTopBit uint64 = cast(uint64, 1) << 63
	return halfPlusTopBit | (halfPlusTopBit - 1)
}

// int64MaxMagnitude returns 2^63 - 1 — the largest magnitude that
// fits in a positive int64.
func int64MaxMagnitude() uint64 {
	return (cast(uint64, 1) << 63) - 1
}

// int64MinNegMagnitude returns 2^63 — the magnitude of int64-min
// (the largest magnitude allowed for a negative Num).
func int64MinNegMagnitude() uint64 {
	return cast(uint64, 1) << 63
}

// ============================================================
// Construction
// ============================================================

// Zero returns the canonical zero (magnitude 0, non-negative).
func Zero() Num {
	var z Num
	return z
}

// FromInt builds a Num from a signed host int.
func FromInt(v int) Num {
	var n Num
	if v < 0 {
		n.Sign = true
		// `-v` would underflow when v == int-min, so go through
		// uint64: cast(uint64, v) reinterprets the two's-complement
		// bit pattern; negating that magnitude yields the absolute
		// value (since 0 - x == -x mod 2^64).
		n.Magnitude = cast(uint64, 0) - cast(uint64, v)
	} else {
		n.Magnitude = cast(uint64, v)
	}
	return n
}

// FromUint64 builds a Num from an unsigned 64-bit value (always
// non-negative).
func FromUint64(v uint64) Num {
	var n Num
	n.Magnitude = v
	return n
}

// ============================================================
// Parsing
// ============================================================

// digitValue returns the numeric value of a hex digit, or -1 if
// the character isn't a valid hex digit.  Used by parseDigits with
// a base check.
func digitValue(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	if c >= 'A' && c <= 'F' { return cast(int, c) - cast(int, 'A') + 10 }
	return -1
}

// parseDigits consumes digits from s[start..] in the given base,
// returning (magnitude, ok).  ok=false on out-of-range (magnitude
// would exceed uint64-max).
func parseDigits(s *[]const char, start int, base uint64) (uint64, bool) {
	var v uint64 = 0
	for i := start; i < len(s); i++ {
		var d int = digitValue(s[i])
		if d < 0 || cast(uint64, d) >= base {
			// Malformed digit — treat as zero contribution so the
			// caller's parse-time error path can still produce a
			// reasonable value.  In practice the lexer rejects
			// out-of-base digits before this point, so this arm is
			// defensive.
			continue
		}
		var du uint64 = cast(uint64, d)
		// Overflow check: v*base + du > uint64Max iff
		//   v > (uint64Max - du) / base.
		if v > (uint64Max() - du) / base {
			return 0, false
		}
		v = v * base + du
	}
	return v, true
}

// ParseLiteral parses an integer literal string (decimal, hex,
// octal, or binary), returning ok=false if the magnitude exceeds
// uint64-max.  Sign is handled by the caller via Neg.
func ParseLiteral(s *[]const char) (Num, bool) {
	var n Num
	if len(s) == 0 {
		return n, true
	}
	var mag uint64 = 0
	var ok bool = true
	if len(s) > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {
		mag, ok = parseDigits(s, 2, 16)
	} else if len(s) > 2 && s[0] == '0' && (s[1] == 'o' || s[1] == 'O') {
		mag, ok = parseDigits(s, 2, 8)
	} else if len(s) > 2 && s[0] == '0' && (s[1] == 'b' || s[1] == 'B') {
		mag, ok = parseDigits(s, 2, 2)
	} else {
		mag, ok = parseDigits(s, 0, 10)
	}
	if !ok {
		return n, false
	}
	n.Magnitude = mag
	return n, true
}

// ============================================================
// Comparison
// ============================================================

// IsZero reports whether a is the canonical zero.
func (a Num) IsZero() bool {
	return a.Magnitude == 0
}

// IsNegative reports whether a is strictly less than zero.
func (a Num) IsNegative() bool {
	return a.Sign && a.Magnitude != 0
}

// Equals reports structural equality, canonical-zero-aware.
func (a Num) Equals(b Num) bool {
	if a.Magnitude == 0 && b.Magnitude == 0 {
		return true
	}
	return a.Magnitude == b.Magnitude && a.Sign == b.Sign
}

// Cmp does the lexicographic-by-sign-then-magnitude compare,
// canonical-zero-aware.
func (a Num) Cmp(b Num) int {
	if a.Equals(b) { return 0 }
	var aNeg bool = a.IsNegative()
	var bNeg bool = b.IsNegative()
	if aNeg && !bNeg { return -1 }
	if !aNeg && bNeg { return 1 }
	if !aNeg {
		// both non-negative
		if a.Magnitude < b.Magnitude { return -1 }
		return 1
	}
	// both negative — larger magnitude means smaller value.
	if a.Magnitude > b.Magnitude { return -1 }
	return 1
}

// ============================================================
// Arithmetic
// ============================================================

// fitsRange reports whether (magnitude, sign) names a value in
// [-2^63, 2^64-1].  Used at the end of each op to detect overflow.
func fitsRange(magnitude uint64, sign bool) bool {
	if !sign { return true }  // any uint64 magnitude is fine non-negative
	return magnitude <= int64MinNegMagnitude()
}

// makeNum constructs a Num and reports whether it fits the union
// range.  Canonicalizes zero to positive sign.
func makeNum(magnitude uint64, sign bool) (Num, bool) {
	var n Num
	if magnitude == 0 {
		return n, true
	}
	if !fitsRange(magnitude, sign) {
		return n, false
	}
	n.Magnitude = magnitude
	n.Sign = sign
	return n, true
}

// Neg returns -a, with ok=false only on negate-from-uint64-magnitude
// underflow (negating a non-negative > 2^63 would land below int64-min).
func (a Num) Neg() (Num, bool) {
	if a.Magnitude == 0 { return a, true }
	var r Num
	var ok bool
	r, ok = makeNum(a.Magnitude, !a.Sign)
	return r, ok
}

// Add returns a + b, ok=false on out-of-range.
func (a Num) Add(b Num) (Num, bool) {
	var r Num
	var ok bool
	// Same-sign: add magnitudes; carry the sign.
	if a.Sign == b.Sign {
		// Overflow on magnitude addition: a + b > uint64Max iff
		// a > uint64Max - b.
		if a.Magnitude > uint64Max() - b.Magnitude {
			var zero Num
			return zero, false
		}
		r, ok = makeNum(a.Magnitude + b.Magnitude, a.Sign)
		return r, ok
	}
	// Different signs: subtract the smaller magnitude from the
	// larger; sign follows the larger.
	if a.Magnitude >= b.Magnitude {
		r, ok = makeNum(a.Magnitude - b.Magnitude, a.Sign)
		return r, ok
	}
	r, ok = makeNum(b.Magnitude - a.Magnitude, b.Sign)
	return r, ok
}

// Sub returns a - b, ok=false on out-of-range.
func (a Num) Sub(b Num) (Num, bool) {
	var negB Num
	var ok bool
	negB, ok = b.Neg()
	if !ok {
		// Negating int64-min via this path can't actually fail
		// because -2^63 has magnitude 2^63 which negates to
		// +2^63 (non-negative, magnitude 2^63, which fits
		// uint64).  Defensive return here.
		var zero Num
		return zero, false
	}
	var r Num
	r, ok = a.Add(negB)
	return r, ok
}

// Mul returns a * b, ok=false on out-of-range.
func (a Num) Mul(b Num) (Num, bool) {
	if a.Magnitude == 0 || b.Magnitude == 0 {
		var zero Num
		return zero, true
	}
	// Overflow on magnitude multiplication: a * b > uint64Max iff
	// a > uint64Max / b  (integer division, both > 0 here).
	if a.Magnitude > uint64Max() / b.Magnitude {
		var zero Num
		return zero, false
	}
	var sign bool = a.Sign != b.Sign
	var r Num
	var ok bool
	r, ok = makeNum(a.Magnitude * b.Magnitude, sign)
	return r, ok
}

// ============================================================
// Range checks
// ============================================================

// FitsSigned reports whether a fits in a signed integer of the
// given width in bits (e.g. 8, 16, 32, 64).
func (a Num) FitsSigned(width int) bool {
	if width <= 0 || width > 64 { return false }
	if width == 64 {
		// [-2^63, 2^63-1].
		if !a.Sign { return a.Magnitude <= int64MaxMagnitude() }
		return a.Magnitude <= int64MinNegMagnitude()
	}
	// width < 64.  posMax = 2^(width-1) - 1.  negMax = 2^(width-1).
	var posMax uint64 = (cast(uint64, 1) << cast(uint64, width - 1)) - 1
	var negMax uint64 = cast(uint64, 1) << cast(uint64, width - 1)
	if !a.Sign { return a.Magnitude <= posMax }
	return a.Magnitude <= negMax
}

// FitsUnsigned reports whether a fits in an unsigned integer of
// the given width.  Negative values never fit.
func (a Num) FitsUnsigned(width int) bool {
	if a.IsNegative() { return false }
	if width <= 0 || width > 64 { return false }
	if width == 64 { return true }  // any non-negative fits uint64
	var posMax uint64 = (cast(uint64, 1) << cast(uint64, width)) - 1
	return a.Magnitude <= posMax
}

// ============================================================
// Conversion
// ============================================================

// ToInt returns the value as a host int.  Caller must verify
// FitsSigned(intWidth) first.
func (a Num) ToInt() int {
	if !a.Sign { return cast(int, a.Magnitude) }
	// Sign-aware: produce the negative value by going through
	// two's-complement uint64.
	var neg uint64 = cast(uint64, 0) - a.Magnitude
	return cast(int, neg)
}

// ToUint64 returns the magnitude as a uint64.  Caller must verify
// the value is non-negative.
func (a Num) ToUint64() uint64 {
	return a.Magnitude
}
