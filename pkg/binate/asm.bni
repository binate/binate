// Package asm provides the shared core for the multi-architecture assembler.
// It manages sections, symbols, labels, fixups, and data emission.
// Per-architecture packages (pkg/binate/asm/aarch64, etc.) provide instruction encoding.
package "pkg/binate/asm"

import "pkg/std/mapfn"

// Symbol binding kinds
const (
	BIND_LOCAL int = iota
	BIND_GLOBAL
	BIND_WEAK
)

// Section flag bits
const (
	SF_READ int = 1
	SF_WRITE int = 2
	SF_EXEC int = 4
)

// A fixup records an unresolved reference to a label within a section.
type Fixup struct {
	Offset uint // byte offset in section data
	Label  @[]char
	Kind   int // architecture-specific fixup kind
	Addend int // constant added to resolved address
}

// A symbol in the symbol table.
type Symbol struct {
	Name    @[]char
	Section int // index into Sections (-1 for undefined/external)
	Offset  uint // byte offset within section
	Binding int // BIND_LOCAL, BIND_GLOBAL, BIND_WEAK
}

// A relocation is an unresolved fixup passed to the object file emitter.
type Relocation struct {
	Section int // which section contains the reference
	Offset  uint // byte offset in that section
	Symbol  int // index into symbol table
	Kind    int // architecture-specific relocation type
	Addend  int // constant added to resolved address
}

// A section being assembled.
type Section struct {
	Name      @[]char
	Flags     int
	Data      @[]uint8 // byte buffer
	Len       int // bytes written (may be less than len(Data))
	Fixups    @[]Fixup
	NumFixups int
}

// The assembler state.
type Assembler struct {
	Sections    @[]@Section
	NumSections int
	Symbols     @[]Symbol
	NumSymbols  int
	// SymIndex is a name→Symbols-index map so findSymbol is O(1) instead of an
	// O(n) charsEqual scan — the symbol resolution that dominated a native-backend
	// bnc compiling bnc (the per-reference lookups were O(n²) over the symbol
	// count).  Keyed by *[]readonly char borrowing each symbol's Name, whose char
	// backing the Symbols array keeps alive (a managed-slice backing is
	// refcount-shared, so it survives the array's growth copies).  Seeded by New,
	// kept in lockstep by addSymbol (the sole append site).
	SymIndex  @mapfn.MapFn[*[]readonly char, int]
	Relocs    @[]Relocation
	NumRelocs int
	Current   int // index of current section (-1 if none)
	WordSize  int // 4 or 8
	HasError  bool
	ErrorMsg  @[]char
}

// Create a new assembler. word_size is 4 (32-bit) or 8 (64-bit).
func New(word_size int) @Assembler

// Set the current section. Creates it if it doesn't exist.
// flags is only used when creating; -1 means use default flags for known names.
func (a @Assembler) SetSection(name *[]readonly char, flags int)

// Define a label at the current position in the current section.
func (a @Assembler) DefineLabel(name *[]readonly char)

// Set a symbol's binding to global.
func (a @Assembler) SetGlobal(name *[]readonly char)

// Set a symbol's binding to weak.
func (a @Assembler) SetWeak(name *[]readonly char)

// Emit raw bytes into the current section.
func (a @Assembler) EmitBytes(data *[]uint8)

// Emit a single byte.
func (a @Assembler) EmitUint8(val uint8)

// Emit a 16-bit value in target endianness.
func (a @Assembler) EmitUint16(val uint16)

// Emit a 32-bit value in target endianness.
func (a @Assembler) EmitUint32(val uint32)

// Emit a 64-bit value in target endianness.
func (a @Assembler) EmitUint64(val uint64)

// Emit a word-sized (WordSize bytes) label reference. Records a fixup.
func (a @Assembler) EmitAddr(label *[]readonly char)

// Emit a null-terminated string.
func (a @Assembler) EmitAsciz(s *[]readonly char)

// Align the current position to a byte boundary. Fills with zeros.
func (a @Assembler) Align(alignment int)

// Align with a custom fill byte.
func (a @Assembler) AlignFill(alignment int, fill uint8)

// Emit n zero bytes.
func (a @Assembler) Zero(n int)

// Emit n copies of a byte.
func (a @Assembler) Fill(n int, val uint8)

// Record a fixup at the current position.
func (a @Assembler) AddFixup(label *[]readonly char, kind int, addend int, size int)

// Current offset in the current section.
func (a @Assembler) CurrentOffset() uint

// Look up a symbol by name. Returns index or -1.
// Used by per-architecture fixup resolvers.
func (a @Assembler) LookupSymbol(name *[]readonly char) int

// Mark a fixup as resolved (Kind = -1) so Finalize skips it.
// Called by per-architecture resolvers after patching bytes.
func (a @Assembler) MarkFixupResolved(si int, fi int)

// Record a first-error message on the assembler. Subsequent calls are
// no-ops so the original cause is preserved. Public form of setError —
// callable from per-arch helpers that need to flag failures discovered
// during fixup resolution or object-file emission.
func (a @Assembler) SetError(msg *[]readonly char)

// Return the data buffer for a section. Used by per-arch resolvers.
func (a @Assembler) SectionData(si int) @[]uint8

// Process remaining fixups. Fixups already resolved (Kind = -1) are skipped.
// Unresolvable fixups become relocations. Returns true if no errors.
func (a @Assembler) Finalize() bool
