// Package asm provides the shared core for the multi-architecture assembler.
// It manages sections, symbols, labels, fixups, and data emission.
// Per-architecture packages (pkg/binate/asm/aarch64, etc.) provide instruction encoding.
package "pkg/binate/asm"

import "pkg/std/mapfn"

// Symbol binding kinds
const (
	BIND_LOCAL int = iota
	BIND_GLOBAL
	BIND_WEAK
)

// Object formats an Assembler's output is destined for (Assembler.ObjFormat).  Which
// same-section references are fixed at assembly time depends on it — Mach-O lets the
// linker move each symbol-delimited atom, ELF lets a global symbol be preempted — so
// the per-architecture fixup resolvers consult it.
const (
	OBJ_UNKNOWN int = iota // not set: resolve only what every format fixes
	OBJ_MACHO
	OBJ_ELF
)

// Section flag bits
const (
	SF_READ int = 1
	SF_WRITE int = 2
	SF_EXEC int = 4
)

// A fixup records an unresolved reference to a label within a section.
type Fixup struct {
	Offset uint // byte offset in section data
	Label  @[]char
	Kind   int // architecture-specific fixup kind
	Addend int // constant added to resolved address
}

// A symbol in the symbol table.
type Symbol struct {
	Name    @[]char
	Section int // index into Sections (-1 for undefined/external)
	Offset  uint // byte offset within section
	Binding int // BIND_LOCAL, BIND_GLOBAL, BIND_WEAK
	// CPrefix flags a symbol to be emitted with the platform C-symbol prefix:
	// `_<Name>` on Mach-O, `<Name>` unchanged on ELF.  Set by the `.global_c`
	// directive so one hand-written `.s` can define a Binate function symbol that
	// resolves under both object formats.  The in-assembler Name stays unprefixed
	// (internal references resolve against it); only the emitted object symbol
	// name carries the prefix, so definitions and relocations agree.
	CPrefix bool
	// SectionSym marks a section symbol (ELF STT_SECTION: its section's start, with no
	// name of its own), which an ELF object's relocations against a temporary label are
	// made against where clang's are (SectionSymbol).
	SectionSym bool
}

// A relocation is an unresolved fixup passed to the object file emitter.
type Relocation struct {
	Section int // which section contains the reference
	Offset  uint // byte offset in that section
	Symbol  int // index into symbol table
	Kind    int // architecture-specific relocation type
	Addend  int // constant added to resolved address
}

// A section being assembled.
type Section struct {
	Name      @[]char
	Flags     int
	Data      @[]uint8 // byte buffer
	Len       int // bytes written (may be less than len(Data))
	Fixups    @[]Fixup
	NumFixups int
	// Align is the largest alignment (bytes, a power of two) any Align/AlignFill
	// requested in this section, 0 if none: the object writers give the section at
	// least this alignment, so padding to it within the section also holds after
	// linking.
	Align int
}

// The assembler state.
type Assembler struct {
	Sections    @[]@Section
	NumSections int
	Symbols     @[]Symbol
	NumSymbols  int
	// SymIndex is a name→Symbols-index map so findSymbol is O(1) instead of an
	// O(n) charsEqual scan — the symbol resolution that dominated a native-backend
	// bnc compiling bnc (the per-reference lookups were O(n²) over the symbol
	// count).  Keyed by *[]readonly char borrowing each symbol's Name, whose char
	// backing the Symbols array keeps alive (a managed-slice backing is
	// refcount-shared, so it survives the array's growth copies).  Seeded by New,
	// kept in lockstep by addSymbol (the sole append site).
	SymIndex  @mapfn.MapFn[*[]readonly char, int]
	Relocs    @[]Relocation
	NumRelocs int
	Current   int // index of current section (-1 if none)
	WordSize  int // 4 or 8
	// ObjFormat is the object format the output will be written as (OBJ_*); set it
	// before resolving fixups.
	ObjFormat int
	HasError  bool
	ErrorMsg  @[]char
}

// IsTemporaryLabel reports whether name is a temporary label in an object of format
// (OBJ_*), as clang's private labels: when local, its symbol table lists it only if a
// relocation must name it (on ELF a GOT reference, or on arm32 anything but an absolute
// word; Mach-O never).  On Mach-O (and OBJ_UNKNOWN) the `L` prefix (block labels, string /
// refcount temporaries), on ELF the `.L` prefix, and on every format a GeneratedLabelName.
func IsTemporaryLabel(name *[]readonly char, format int) bool

// GeneratedLabelName returns the name of the k-th label the assembler generates for base
// (a numeric local label's number, say): `L`, a byte 2, base, a byte 2 and k — a name no
// source text can spell, temporary on every object format.
func GeneratedLabelName(base *[]readonly char, k int) @[]char

// IsGeneratedLabel reports whether name is a GeneratedLabelName: `L` and then a byte 2.
func IsGeneratedLabel(name *[]readonly char) bool

// LabelForMessage returns label name as a diagnostic shows it: a generated label as what
// it is (`local label 1 (definition 2)` for the second `1:`), any other name unchanged.
func LabelForMessage(name *[]readonly char) @[]char

// StartsAtom reports whether sym, once defined, begins a linker atom in a Mach-O
// object (MH_SUBSECTIONS_VIA_SYMBOLS): every symbol but a local temporary label, which
// the writer never lists.  The fixup resolvers and the Mach-O writer share it, so a
// displacement fixed at assembly time never crosses an atom boundary the linker may
// move.
func StartsAtom(sym Symbol) bool

// DefineLocalAt defines a local symbol name at offset in section, returning its
// index, or -1 (with the assembler error set) when name is already a symbol.  For
// object writers that need a symbol the source did not name (a Mach-O section-start
// anchor for relocations against temporaries, say).
func (a @Assembler) DefineLocalAt(name *[]readonly char, section int, offset uint) int

// AtomStarts returns the sorted, de-duplicated offsets of the symbols defined in
// section si that start a Mach-O atom (StartsAtom).
func (a @Assembler) AtomStarts(si int) @[]int

// AtomStartAt returns the offset of the atom containing byte off — the largest entry
// <= off of starts (an AtomStarts result) — or -1 when off precedes every atom.
func AtomStartAt(starts @[]int, off int) int

// DisplacementFixed reports whether a PC-relative reference at byte fixupOff of a
// section to sym, defined in the same section, is fixed at assembly time (so a
// resolver may patch it) rather than a relocation: on ELF only a local symbol's; on
// Mach-O only one within a single atom; with no object format set, only what both
// fix — a local symbol in the same atom.  starts is the section's
// AtomStarts (unused for ELF).
func (a @Assembler) DisplacementFixed(sym Symbol, fixupOff int, starts @[]int) bool

// CheckTemporaryLabels checks the temporary labels (IsTemporaryLabel under ObjFormat,
// which must be set) once the source is assembled: returns false, with the error set, for
// a reference to a temporary never defined (clang: "Undefined temporary symbol") or a
// temporary made global or weak (clang: "non-local symbol required").
func (a @Assembler) CheckTemporaryLabels() bool

// SectionSymbol returns the index of section si's section symbol — local, at the
// section's start, flagged Symbol.SectionSym — defining it on first use, or -1 with the
// error set.  An ELF writer makes a relocation against a temporary label against it where
// clang's does (every relocation but a GOT reference, and on arm32 only an absolute word).
func (a @Assembler) SectionSymbol(si int) int

// Create a new assembler. word_size is 4 (32-bit) or 8 (64-bit).
func New(word_size int) @Assembler

// Set the current section. Creates it if it doesn't exist.
// flags is only used when creating; -1 means use default flags for known names.
func (a @Assembler) SetSection(name *[]readonly char, flags int)

// Define a label at the current position in the current section.
func (a @Assembler) DefineLabel(name *[]readonly char)

// Set a symbol's binding to global.
func (a @Assembler) SetGlobal(name *[]readonly char)

// Set a symbol's binding to weak.
func (a @Assembler) SetWeak(name *[]readonly char)

// Emit raw bytes into the current section.
func (a @Assembler) EmitBytes(data *[]uint8)

// Emit a single byte.
func (a @Assembler) EmitUint8(val uint8)

// Emit a 16-bit value in target endianness.
func (a @Assembler) EmitUint16(val uint16)

// Emit a 32-bit value in target endianness.
func (a @Assembler) EmitUint32(val uint32)

// Emit a 64-bit value in target endianness.
func (a @Assembler) EmitUint64(val uint64)

// Emit a word-sized (WordSize bytes) label reference. Records a fixup.
func (a @Assembler) EmitAddr(label *[]readonly char)

// Emit a null-terminated string.
func (a @Assembler) EmitAsciz(s *[]readonly char)

// Align the current position to a byte boundary. Fills with zeros.
func (a @Assembler) Align(alignment int)

// Align with a custom fill byte.
func (a @Assembler) AlignFill(alignment int, fill uint8)

// Emit n zero bytes.
func (a @Assembler) Zero(n int)

// Emit n copies of a byte.
func (a @Assembler) Fill(n int, val uint8)

// Record a fixup at the current position.
func (a @Assembler) AddFixup(label *[]readonly char, kind int, addend int, size int)

// Current offset in the current section.
func (a @Assembler) CurrentOffset() uint

// Look up a symbol by name. Returns index or -1.
// Used by per-architecture fixup resolvers.
func (a @Assembler) LookupSymbol(name *[]readonly char) int

// Mark a fixup as resolved (Kind = -1) so Finalize skips it.
// Called by per-architecture resolvers after patching bytes.
func (a @Assembler) MarkFixupResolved(si int, fi int)

// Record a first-error message on the assembler. Subsequent calls are
// no-ops so the original cause is preserved. Public form of setError —
// callable from per-arch helpers that need to flag failures discovered
// during fixup resolution or object-file emission.
func (a @Assembler) SetError(msg *[]readonly char)

// Return the data buffer for a section. Used by per-arch resolvers.
func (a @Assembler) SectionData(si int) @[]uint8

// Process remaining fixups. Fixups already resolved (Kind = -1) are skipped.
// Unresolvable fixups become relocations. Returns true if no errors.
func (a @Assembler) Finalize() bool
