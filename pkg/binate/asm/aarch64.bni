// Package aarch64 provides AArch64 instruction encoding for the assembler.
package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// 64-bit general-purpose registers (X0-X30, SP, XZR)
const (
	X0 int = iota
	X1
	X2
	X3
	X4
	X5
	X6
	X7
	X8
	X9
	X10
	X11
	X12
	X13
	X14
	X15
	X16
	X17
	X18
	X19
	X20
	X21
	X22
	X23
	X24
	X25
	X26
	X27
	X28
	X29
	X30
	XZR
)

// SP is register 31, same encoding as XZR but context-dependent
const SP int = 31

// Frame pointer and link register aliases
const FP int = 29

const LR int = 30

// 64-bit FP/SIMD scalar registers (D0-D31). Held in a disjoint
// namespace from X regs (offset by 32) so callers can't pass an X
// where a D is expected; the encoders mask with 0x1f before emitting.
// The offset must be a multiple of 32 so n & 0x1f == n's reg number.
const (
	D0 int = iota + 32
	D1
	D2
	D3
	D4
	D5
	D6
	D7
	D8
	D9
	D10
	D11
	D12
	D13
	D14
	D15
	D16
	D17
	D18
	D19
	D20
	D21
	D22
	D23
	D24
	D25
	D26
	D27
	D28
	D29
	D30
	D31
)

// 128-bit SIMD/FP vector registers (V0-V31).  Same physical file as the D
// scalar regs (a V register's low 64 bits ARE its D register), so these share
// the D namespace values — offset by 32 from the X regs, masked with 0x1f before
// emitting.  Named separately from D0..D31 so vector (NEON) code reads in terms
// of V registers, matching the assembly mnemonics.
const (
	V0 int = iota + 32
	V1
	V2
	V3
	V4
	V5
	V6
	V7
	V8
	V9
	V10
	V11
	V12
	V13
	V14
	V15
	V16
	V17
	V18
	V19
	V20
	V21
	V22
	V23
	V24
	V25
	V26
	V27
	V28
	V29
	V30
	V31
)

// NEON vector-arrangement specifiers: the (element-width × lane-count) shape a
// packed instruction operates on.  Ordered (size, Q) so the encoder recovers the
// element-size field as arr>>1 and the Q bit (128- vs 64-bit vector) as arr&1.
const (
	ARR_8B int = iota // 8 × 8-bit   (64-bit vector)
	ARR_16B           // 16 × 8-bit  (128-bit vector)
	ARR_4H            // 4 × 16-bit  (64-bit vector)
	ARR_8H            // 8 × 16-bit  (128-bit vector)
	ARR_2S            // 2 × 32-bit  (64-bit vector)
	ARR_4S            // 4 × 32-bit  (128-bit vector)
	ARR_1D            // 1 × 64-bit  (64-bit vector)
	ARR_2D            // 2 × 64-bit  (128-bit vector)
)

// Operand kinds
const (
	OP_REG int = iota // register
	OP_IMM            // immediate value
	OP_REG_SHIFT      // shifted register
	OP_MEM_IMM        // [Rn, #imm]
	OP_MEM_PRE        // [Rn, #imm]!
	OP_MEM_POST       // [Rn], #imm
	OP_MEM_REG        // [Rn, Rm]
	OP_LABEL          // label reference
	OP_MEM_REG_SCALED // [Rn, Rm, lsl #log2(access-size)]
	OP_MEM_UNSCALED   // [Rn, #imm] via LDUR/STUR (signed 9-bit, byte-unscaled)
)

// Shift types
const (
	LSL int = iota
	LSR
	ASR
	ROR
)

// Condition codes
const (
	COND_EQ int = iota // equal (Z=1)
	COND_NE            // not equal (Z=0)
	COND_CS            // carry set / unsigned >= (C=1)
	COND_CC            // carry clear / unsigned < (C=0)
	COND_MI            // minus / negative (N=1)
	COND_PL            // plus / positive or zero (N=0)
	COND_VS            // overflow (V=1)
	COND_VC            // no overflow (V=0)
	COND_HI            // unsigned > (C=1 && Z=0)
	COND_LS            // unsigned <= (C=0 || Z=1)
	COND_GE            // signed >= (N=V)
	COND_LT            // signed < (N!=V)
	COND_GT            // signed > (Z=0 && N=V)
	COND_LE            // signed <= (Z=1 || N!=V)
	COND_AL            // always
	COND_NV            // never (reserved)
)

// Aliases
const COND_HS int = 2 // same as CS (unsigned >=)

const COND_LO int = 3 // same as CC (unsigned <)

// Fixup kinds for AArch64
const (
	FIX_BRANCH26 int = 100  // 26-bit PC-relative branch offset (B, BL)
	FIX_BRANCH19 int = 101  // 19-bit PC-relative branch offset (B.cond, CBZ, CBNZ)
	FIX_ADR_LO21 int = 102  // 21-bit PC-relative ADR
	FIX_ADRP_HI21 int = 103 // 21-bit PC-relative ADRP (page-aligned)
	FIX_BRANCH14 int = 104  // 14-bit PC-relative branch offset (TBZ, TBNZ)
	FIX_ADD_LO12 int = 105  // 12-bit unscaled low-page offset (ADD imm12)
	FIX_LDR_LO12 int = 106  // 12-bit scaled low-page offset (LDR/STR imm12, 64-bit form)
	// The GOT-indirect pair for reaching an external data symbol under PIE
	// (e.g. a C global via __c_global): ADRP loads the GOT-slot's page, LDR
	// loads the slot's contents (the symbol's real address).  Mach-O:
	// ARM64_RELOC_GOT_LOAD_PAGE21 / _PAGEOFF12; ELF (no aarch64 native ELF
	// target today): R_AARCH64_ADR_GOT_PAGE / _LD64_GOT_LO12_NC.
	FIX_ADRP_GOT_HI21 int = 107 // 21-bit PC-relative ADRP to the GOT-entry page
	FIX_LD_GOT_LO12 int = 108   // 12-bit scaled offset LDR of the GOT slot (64-bit)
)

// An operand for AArch64 instructions.
type Operand struct {
	Kind int
	Reg  int // register number (for REG, REG_SHIFT, MEM_*)
	Reg2 int // second register (for MEM_REG)
	Imm  int64 // immediate value — int64 so a 64-bit AArch64
	// logical-immediate (e.g. ORR with a repeating
	// bitmask) survives even when the assembler
	// itself is hosted on a 32-bit machine (where
	// `int` is i32).  Small-immediate readers
	// (ADD/SUB imm12, ldr/str offsets, bitfield
	// positions) cast back to int at the use site.
	Shift int // shift type (for REG_SHIFT)
	ShAmt int // shift amount (for REG_SHIFT)
	Label @[]char // label name (for LABEL)
}

// Operand constructors

// Reg creates a register operand.
func Reg(r int) Operand

// Imm creates an immediate value operand from an int (widened to
// the int64 Imm field).  For a full 64-bit immediate on a 32-bit
// host, use ImmU64.
func Imm(val int) Operand

// ImmU64 creates an immediate value operand from a full 64-bit
// value — needed for AArch64 logical-immediate encodings whose
// bitmask exceeds 32 bits (the int Imm constructor can't carry
// them when the assembler runs on a 32-bit host).
func ImmU64(val uint64) Operand

// RegShift creates a shifted register operand.
func RegShift(r int, shift int, amount int) Operand

// MemImm creates a base+offset memory operand [Rn, #imm].
func MemImm(base int, offset int) Operand

// MemPre creates a pre-indexed memory operand [Rn, #imm]!.
func MemPre(base int, offset int) Operand

// MemPost creates a post-indexed memory operand [Rn], #imm.
func MemPost(base int, offset int) Operand

// MemReg creates a base+index register memory operand [Rn, Rm].
func MemReg(base int, index int) Operand

// MemRegScaled creates a SCALED base+index register memory operand
// [Rn, Rm, lsl #log2(access-size)] — the index is scaled by the LDR/STR's own
// access size (×8 for a 64-bit access, ×4 for 32-bit), so the index register
// holds the ELEMENT index, not a byte offset.  Used to fold an array element
// address (base + index*elemSize) directly into the load/store when elemSize
// equals the access size.
func MemRegScaled(base int, index int) Operand

// MemUnscaled creates a base+offset memory operand `[Rn, #imm]` that FORCES the
// unscaled LDUR/STUR encoding — a SIGNED 9-bit byte offset in [-256, 255],
// unscaled by the access size — rather than the scaled unsigned-imm12 LDR/STR of
// MemImm.  Needed for a negative fixed offset such as the managed refcount
// header at `[ptr, #-16]`, which the unsigned form cannot represent.
func MemUnscaled(base int, offset int) Operand

// Label creates a label reference operand.
func Label(name *[]readonly char) Operand

// Indicates whether a register number refers to a 64-bit (X) register.
// Caller passes true for 64-bit operations, false for 32-bit (W).
// This is tracked per-instruction call, not per-register.

// --- Data processing (register) ---

// Add emits an ADD instruction (Rd = Rn + Op).
func Add(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Sub emits a SUB instruction (Rd = Rn - Op).
func Sub(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Adds emits an ADDS instruction (ADD setting condition flags).
func Adds(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Subs emits a SUBS instruction (SUB setting condition flags).
func Subs(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// --- Logical (register and immediate) ---

// And emits an AND instruction (Rd = Rn & Op).
func And(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Orr emits an ORR instruction (Rd = Rn | Op).
func Orr(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Eor emits an EOR instruction (Rd = Rn ^ Op).
func Eor(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Ands emits an ANDS instruction (AND setting condition flags).
func Ands(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// --- Move ---

// Mvn emits a MVN instruction (bitwise NOT: Rd = NOT Op).
func Mvn(a @asm.Assembler, sf bool, rd int, op Operand)

// Mov emits a MOV instruction (register or immediate move to Rd).
func Mov(a @asm.Assembler, sf bool, rd int, op Operand)

// Movz emits a MOVZ instruction (move wide with zero).
func Movz(a @asm.Assembler, sf bool, rd int, imm int, shift int)

// Movk emits a MOVK instruction (move wide with keep).
func Movk(a @asm.Assembler, sf bool, rd int, imm int, shift int)

// Movn emits a MOVN instruction (move wide with NOT).
func Movn(a @asm.Assembler, sf bool, rd int, imm int, shift int)

// --- Load/Store ---

// Ldr emits an LDR instruction (load register from memory).
func Ldr(a @asm.Assembler, sf bool, rt int, op Operand)

// Str emits an STR instruction (store register to memory).
func Str(a @asm.Assembler, sf bool, rt int, op Operand)

// Fstr_d emits `STR Dt, [base, #off]` — store a 64-bit D (FP) register.  The FP
// analogue of Str for spilling/saving a D-register; a GP Str would mask the
// D-number to the wrong X register.
func Fstr_d(a @asm.Assembler, dt int, base int, off int)

// Fldr_d emits `LDR Dt, [base, #off]` — load a 64-bit D (FP) register.
func Fldr_d(a @asm.Assembler, dt int, base int, off int)

// Fstr_s emits `STR St, [base, #off]` — store a 32-bit S (FP) register.
func Fstr_s(a @asm.Assembler, st int, base int, off int)

// Fldr_s emits `LDR St, [base, #off]` — load a 32-bit S (FP) register.
func Fldr_s(a @asm.Assembler, st int, base int, off int)

// LdrswRegScaled emits `LDRSW Xt, [base, index, lsl #2]` — the scaled
// register-offset form of LDRSW (signed 4-byte load, index is the element index
// scaled by 4, sign-extended to 64 bits).
func LdrswRegScaled(a @asm.Assembler, rt int, base int, index int)

// Ldrb emits an LDRB instruction (load byte, zero-extending to 32 bits).
func Ldrb(a @asm.Assembler, rt int, op Operand)

// Strb emits a STRB instruction (store byte).
func Strb(a @asm.Assembler, rt int, op Operand)

// Ldrh emits an LDRH instruction (load halfword, zero-extending to 32 bits).
func Ldrh(a @asm.Assembler, rt int, op Operand)

// Strh emits a STRH instruction (store halfword).
func Strh(a @asm.Assembler, rt int, op Operand)

// StrSized stores the low `size` bytes of rt: 1 → STRB, 2 → STRH,
// 4 → 32-bit STR, 8 → 64-bit STR (natural-size narrow stack-arg stores).
func StrSized(a @asm.Assembler, size int, rt int, op Operand)

// LdrStrImmFitsUnsigned reports whether imm is encodable as the
// unsigned-imm12 form of a 32- or 64-bit LDR/STR. Backends should
// materialize the address into a scratch register when this is false,
// since the encoder silently masks the scaled imm to 12 bits otherwise.
func LdrStrImmFitsUnsigned(sf bool, imm int) bool

// LdurSturImmFits reports whether imm is encodable in the LDUR/STUR unscaled
// signed 9-bit immediate field (-256..255, no alignment requirement). Used for
// negative fixed offsets — e.g. the refcount header at [ptr, #-16] — via a
// MemUnscaled operand.
func LdurSturImmFits(imm int) bool

// Load/Store pair

// Ldp emits an LDP instruction (load pair of registers from memory).
func Ldp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand)

// Stp emits an STP instruction (store pair of registers to memory).
func Stp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand)

// --- Branches ---

// B emits an unconditional branch to a label.
func B(a @asm.Assembler, label *[]readonly char)

// Bl emits a branch with link (function call) to a label.
func Bl(a @asm.Assembler, label *[]readonly char)

// Br emits an unconditional branch to the address in a register.
func Br(a @asm.Assembler, rn int)

// Blr emits a branch with link to the address in a register.
func Blr(a @asm.Assembler, rn int)

// Ret emits a return instruction using the link register (X30).
func Ret(a @asm.Assembler)

// RetReg emits a return instruction using the specified register.
func RetReg(a @asm.Assembler, rn int)

// Conditional branch

// Bcond emits a conditional branch to a label based on condition flags.
func Bcond(a @asm.Assembler, cond int, label *[]readonly char)

// Compare and branch

// Cbz emits a compare-and-branch-if-zero instruction.
func Cbz(a @asm.Assembler, sf bool, rt int, label *[]readonly char)

// Cbnz emits a compare-and-branch-if-nonzero instruction.
func Cbnz(a @asm.Assembler, sf bool, rt int, label *[]readonly char)

// --- Compare ---

// Cmp emits a CMP instruction (alias for SUBS with XZR destination).
func Cmp(a @asm.Assembler, sf bool, rn int, op Operand)

// Cmn emits a CMN instruction (alias for ADDS with XZR destination).
func Cmn(a @asm.Assembler, sf bool, rn int, op Operand)

// Tst emits a TST instruction (alias for ANDS with XZR destination).
func Tst(a @asm.Assembler, sf bool, rn int, op Operand)

// --- Shift ---

// Lsl emits a logical shift left instruction.
func Lsl(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Lsr emits a logical shift right instruction.
func Lsr(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Asr emits an arithmetic shift right instruction.
func Asr(a @asm.Assembler, sf bool, rd int, rn int, op Operand)

// Ror emits a rotate right instruction (register form).
func Ror(a @asm.Assembler, sf bool, rd int, rn int, rm int)

// --- Multiply / Divide ---

// Mul emits a MUL instruction (Rd = Rn * Rm).
func Mul(a @asm.Assembler, sf bool, rd int, rn int, rm int)

// Madd emits a MADD instruction (Rd = Ra + Rn * Rm).
func Madd(a @asm.Assembler, sf bool, rd int, rn int, rm int, ra int)

// Msub emits an MSUB instruction (Rd = Ra - Rn * Rm).
func Msub(a @asm.Assembler, sf bool, rd int, rn int, rm int, ra int)

// Sdiv emits an SDIV instruction (signed divide, Rd = Rn / Rm).
func Sdiv(a @asm.Assembler, sf bool, rd int, rn int, rm int)

// Udiv emits a UDIV instruction (unsigned divide, Rd = Rn / Rm).
func Udiv(a @asm.Assembler, sf bool, rd int, rn int, rm int)

// Smulh emits an SMULH instruction (Rd = high 64 bits of the signed Rn*Rm
// product).  64-bit only.
func Smulh(a @asm.Assembler, rd int, rn int, rm int)

// Umulh emits a UMULH instruction (Rd = high 64 bits of the unsigned Rn*Rm
// product).  64-bit only.
func Umulh(a @asm.Assembler, rd int, rn int, rm int)

// Neg emits a NEG instruction (Rd = -Op, alias for SUB from zero).
func Neg(a @asm.Assembler, sf bool, rd int, op Operand)

// --- Address computation ---

// Adr emits an ADR instruction (load PC-relative address into Rd).
func Adr(a @asm.Assembler, rd int, label *[]readonly char)

// Adrp emits an ADRP instruction (load PC-relative page address into Rd).
func Adrp(a @asm.Assembler, rd int, label *[]readonly char)

// AddImmLabel emits `ADD rd, rn, #0` with a FIX_ADD_LO12 fixup against label.
// Paired with Adrp to materialize a full 64-bit address via ADRP+ADD.
func AddImmLabel(a @asm.Assembler, sf bool, rd int, rn int, label *[]readonly char)

// LdrImmLabel emits `LDR rt, [base, #0]` with a FIX_LDR_LO12 fixup against label.
// Paired with Adrp to load from a PC-relative target via ADRP+LDR.
// sf selects 64-bit (true) vs 32-bit (false) load.
func LdrImmLabel(a @asm.Assembler, sf bool, rt int, base int, label *[]readonly char)

// AdrpGot emits `ADRP rd, :got:label` with a FIX_ADRP_GOT_HI21 fixup — the
// page address of the GOT slot holding label's real address.  Paired with
// LdrGotLo12 to reach an external data symbol under PIE (e.g. __c_global).
func AdrpGot(a @asm.Assembler, rd int, label *[]readonly char)

// LdrGotLo12 emits `LDR rt, [base, #:got_lo12:label]` (64-bit) with a
// FIX_LD_GOT_LO12 fixup — loads the GOT slot's contents (label's address).
// base is the ADRP result register from AdrpGot.
func LdrGotLo12(a @asm.Assembler, rt int, base int, label *[]readonly char)

// --- Extend ---

// Sxtb emits an SXTB instruction (sign-extend byte to register width).
func Sxtb(a @asm.Assembler, sf bool, rd int, rn int)

// Sxth emits an SXTH instruction (sign-extend halfword to register width).
func Sxth(a @asm.Assembler, sf bool, rd int, rn int)

// Sxtw emits an SXTW instruction (sign-extend 32-bit word to 64 bits).
func Sxtw(a @asm.Assembler, rd int, rn int)

// Uxtb emits a UXTB instruction (zero-extend byte to 32 bits).
func Uxtb(a @asm.Assembler, rd int, rn int)

// Uxth emits a UXTH instruction (zero-extend halfword to 32 bits).
func Uxth(a @asm.Assembler, rd int, rn int)

// Uxtw emits a UXTW instruction (zero-extend word to 64 bits, clearing
// bits 63:32).
func Uxtw(a @asm.Assembler, rd int, rn int)

// --- Sign-extending loads ---

// Ldrsb emits an LDRSB instruction (load byte, sign-extending to register width).
func Ldrsb(a @asm.Assembler, sf bool, rt int, op Operand)

// Ldrsh emits an LDRSH instruction (load halfword, sign-extending to register width).
func Ldrsh(a @asm.Assembler, sf bool, rt int, op Operand)

// Ldrsw emits an LDRSW instruction (load word, sign-extending to 64 bits).
func Ldrsw(a @asm.Assembler, rt int, op Operand)

// --- Conditional select ---

// Csel emits a CSEL instruction (Rd = cond ? Rn : Rm).
func Csel(a @asm.Assembler, sf bool, rd int, rn int, rm int, cond int)

// Csinc emits a CSINC instruction (Rd = cond ? Rn : Rm + 1).
func Csinc(a @asm.Assembler, sf bool, rd int, rn int, rm int, cond int)

// --- Test and branch ---

// Tbz emits a TBZ instruction (branch if bit is zero).
func Tbz(a @asm.Assembler, rt int, bit int, label *[]readonly char)

// Tbnz emits a TBNZ instruction (branch if bit is nonzero).
func Tbnz(a @asm.Assembler, rt int, bit int, label *[]readonly char)

// --- Floating-point (scalar, double-precision) ---
// Native floats round-trip through GP regs at op boundaries (FP regs
// only live across one arithmetic op), so we expose just the FP
// instructions actually needed: GP↔FP move, basic arithmetic, FNEG,
// FCMP, int↔float conversion, and width conversion.

// Fmov_gp_to_fp moves the bits of an X register into a D register.
// (FMOV Dd, Xn — encoding 0x9E670000 base.)
func Fmov_gp_to_fp(a @asm.Assembler, dd int, xn int)

// Fmov_fp_to_gp moves the bits of a D register into an X register.
// (FMOV Xd, Dn — encoding 0x9E660000 base.)
func Fmov_fp_to_gp(a @asm.Assembler, xd int, dn int)

// Fmov_fp_to_fp copies one D register to another.
// (FMOV Dd, Dn — encoding 0x1E604000 base.)
func Fmov_fp_to_fp(a @asm.Assembler, dd int, dn int)

// Fadd / Fsub / Fmul / Fdiv: scalar double-precision arithmetic.
func Fadd(a @asm.Assembler, dd int, dn int, dm int)

func Fsub(a @asm.Assembler, dd int, dn int, dm int)

func Fmul(a @asm.Assembler, dd int, dn int, dm int)

func Fdiv(a @asm.Assembler, dd int, dn int, dm int)

// Fadd_s / Fsub_s / Fmul_s / Fdiv_s: scalar single-precision (float32)
// arithmetic (ty=00).  Operate on S registers.
func Fadd_s(a @asm.Assembler, sd int, sn int, sm int)

func Fsub_s(a @asm.Assembler, sd int, sn int, sm int)

func Fmul_s(a @asm.Assembler, sd int, sn int, sm int)

func Fdiv_s(a @asm.Assembler, sd int, sn int, sm int)

// Fneg negates a double-precision FP value.
func Fneg(a @asm.Assembler, dd int, dn int)

// Fneg_s negates a single-precision (float32) FP value (ty=00).
func Fneg_s(a @asm.Assembler, sd int, sn int)

// Fcmp compares two double-precision FP values, setting PSTATE flags.
// Pair with Csinc / B.cond for branch / bool result.
func Fcmp(a @asm.Assembler, dn int, dm int)

// Fcmp_s compares two single-precision (float32) FP values (ty=00),
// setting the same PSTATE flags as Fcmp.
func Fcmp_s(a @asm.Assembler, sn int, sm int)

// Fcvtzs converts a double to a signed integer (round toward zero).
// (FCVTZS Xd, Dn — encoding 0x9E780000 base.)
func Fcvtzs(a @asm.Assembler, xd int, dn int)

// Fcvtzu converts a double to an unsigned integer (round toward zero).
// (FCVTZU Xd, Dn — encoding 0x9E790000 base.)
func Fcvtzu(a @asm.Assembler, xd int, dn int)

// Scvtf converts a signed integer to a double.
// (SCVTF Dd, Xn — encoding 0x9E620000 base.)
func Scvtf(a @asm.Assembler, dd int, xn int)

// Ucvtf converts an unsigned integer to a double.
// (UCVTF Dd, Xn — encoding 0x9E630000 base.)
func Ucvtf(a @asm.Assembler, dd int, xn int)

// Width conversion between float32 (S register) and float64 (D register).
func Fcvt_d_to_s(a @asm.Assembler, sd int, dn int)

func Fcvt_s_to_d(a @asm.Assembler, dd int, sn int)

// 32-bit GP↔FP move. The S-register holds the lower 32 bits of the
// underlying V register; the W register holds the lower 32 bits of
// the X register. FMOV Wd, Sn zero-extends to X when read.
func Fmov_w_to_s(a @asm.Assembler, sd int, wn int)

func Fmov_s_to_w(a @asm.Assembler, wd int, sn int)

// --- Advanced SIMD (NEON): packed integer + bitwise ---
// V registers (V0-V31) hold packed vectors; an arrangement specifier
// (ARR_8B..ARR_2D) names the operand shape.  See aarch64_neon.bn.

// Vadd emits `ADD Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer add for
// arrangement `arr`.
func Vadd(a @asm.Assembler, arr int, vd int, vn int, vm int)

// Vsub emits `SUB Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer subtract.
func Vsub(a @asm.Assembler, arr int, vd int, vn int, vm int)

// Vmul emits `MUL Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer multiply.  Valid
// for byte/halfword/word arrangements only (AArch64 has no .1d/.2d vector
// multiply).
func Vmul(a @asm.Assembler, arr int, vd int, vn int, vm int)

// Vand emits `AND Vd, Vn, Vm` — bitwise AND over the whole vector (.16b when
// `full`, else .8b).
func Vand(a @asm.Assembler, full bool, vd int, vn int, vm int)

// Vorr emits `ORR Vd, Vn, Vm` — bitwise OR over the whole vector.
func Vorr(a @asm.Assembler, full bool, vd int, vn int, vm int)

// Veor emits `EOR Vd, Vn, Vm` — bitwise XOR over the whole vector.
func Veor(a @asm.Assembler, full bool, vd int, vn int, vm int)

// --- Advanced SIMD (NEON): vector loads and stores ---
// LDR/STR q and LDP/STP q are plain 128-bit transfers (no arrangement); LD1/ST1
// are arrangement-typed.  See aarch64_neon_ldst.bn.

// Vldr_q emits `LDR Qt, [base, #off]` — load a 128-bit vector.  Any signed off
// is encoded correctly: the scaled LDR q for a 16-aligned non-negative offset,
// LDUR q for a small negative or non-16-aligned offset, else base±off is formed
// in the X17 scratch first.
func Vldr_q(a @asm.Assembler, vt int, base int, off int)

// Vstr_q emits `STR Qt, [base, #off]` — store a 128-bit vector (same offset
// handling as Vldr_q).
func Vstr_q(a @asm.Assembler, vt int, base int, off int)

// Vldr_q_post emits `LDR Qt, [base], #off` — load, then advance base by the
// signed byte offset off ([-256, 255]).
func Vldr_q_post(a @asm.Assembler, vt int, base int, off int)

// Vstr_q_post emits `STR Qt, [base], #off` — store, then advance base by off.
func Vstr_q_post(a @asm.Assembler, vt int, base int, off int)

// Vldp_q emits `LDP Qt1, Qt2, [base, #off]` — load a pair of 128-bit vectors
// (off is a signed offset scaled by 16).
func Vldp_q(a @asm.Assembler, vt1 int, vt2 int, base int, off int)

// Vstp_q emits `STP Qt1, Qt2, [base, #off]` — store a pair of 128-bit vectors.
func Vstp_q(a @asm.Assembler, vt1 int, vt2 int, base int, off int)

// Vldp_q_post emits `LDP Qt1, Qt2, [base], #off` — load a pair, then advance base.
func Vldp_q_post(a @asm.Assembler, vt1 int, vt2 int, base int, off int)

// Vstp_q_post emits `STP Qt1, Qt2, [base], #off` — store a pair, then advance base.
func Vstp_q_post(a @asm.Assembler, vt1 int, vt2 int, base int, off int)

// Vld1 emits `LD1 {Vt.<T>}, [base]` — arrangement-typed single-register load.
func Vld1(a @asm.Assembler, arr int, vt int, base int)

// Vst1 emits `ST1 {Vt.<T>}, [base]` — arrangement-typed single-register store.
func Vst1(a @asm.Assembler, arr int, vt int, base int)

// Vld1_post emits `LD1 {Vt.<T>}, [base], #<size>` — load, then advance base by
// the transfer size (16 bytes for a 128-bit arrangement, 8 for a 64-bit one).
func Vld1_post(a @asm.Assembler, arr int, vt int, base int)

// Vst1_post emits `ST1 {Vt.<T>}, [base], #<size>` — store, then advance base by
// the transfer size.
func Vst1_post(a @asm.Assembler, arr int, vt int, base int)

// --- System ---

// Nop emits a NOP instruction (no operation).
func Nop(a @asm.Assembler)

// Svc emits an SVC instruction (supervisor call with immediate).
func Svc(a @asm.Assembler, imm int)

// DcZva emits `DC ZVA, Xt` — zero the cache-line-sized block (DCZID_EL0
// block size) containing the address in Xt; the AArch64 bulk zero-fill
// primitive (one instruction per cache line, no read-for-ownership).
func DcZva(a @asm.Assembler, rt int)

// Mrs emits `MRS Xt, <sysreg>` — read the system register identified by
// (o0, op1, CRn, CRm, op2) into Xt.  Used to read DCZID_EL0
// (1, 3, 0, 0, 7) for the DC ZVA block size / DZP bit.
func Mrs(a @asm.Assembler, rt int, o0 int, op1 int, crn int, crm int, op2 int)

// --- Fixup resolution ---
// Resolve all same-section AArch64 fixups by patching instruction bytes.
// Must be called before asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool
