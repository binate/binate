package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- Operand constructors ---

func Reg(r int) Operand {
	var op Operand
	op.Kind = OP_REG
	op.Reg = r
	return op
}

// Imm returns an immediate-value Operand for instructions that accept
// one (e.g. ADD/SUB immediate, MOV-imm, logical-imm). Encoders enforce
// per-instruction range/encoding restrictions.  `val` widens to the
// int64 Imm field; for a 64-bit logical immediate that doesn't fit
// `int` on a 32-bit host, use ImmU64 instead.
func Imm(val int) Operand {
	var op Operand
	op.Kind = OP_IMM
	op.Imm = cast(int64, val)
	return op
}

// ImmU64 returns an immediate-value Operand carrying a full 64-bit
// value.  Use for AArch64 logical-immediate encodings (ORR/AND/EOR
// with a repeating bitmask) whose value can exceed 32 bits — the
// `int`-based Imm constructor truncates those when the assembler is
// hosted on a 32-bit machine.  Stored as the two's-complement
// int64 bit pattern.
func ImmU64(val uint64) Operand {
	var op Operand
	op.Kind = OP_IMM
	op.Imm = bit_cast(int64, val)
	return op
}

// RegShift returns a shifted-register Operand: register `r` shifted by
// `amount` bits using shift mode `shift` (LSL/LSR/ASR/ROR). Used as the
// second operand of register-form data-processing instructions.
func RegShift(r int, shift int, amount int) Operand {
	var op Operand
	op.Kind = OP_REG_SHIFT
	op.Reg = r
	op.Shift = shift
	op.ShAmt = amount
	return op
}

// MemImm returns a memory operand `[base, #offset]` (signed offset).
// The base register is unchanged.
func MemImm(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_IMM
	op.Reg = base
	op.Imm = cast(int64, offset)
	return op
}

// MemPre returns a pre-indexed memory operand `[base, #offset]!`. The
// base register is updated to `base + offset` BEFORE the access.
func MemPre(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_PRE
	op.Reg = base
	op.Imm = cast(int64, offset)
	return op
}

// MemPost returns a post-indexed memory operand `[base], #offset`. The
// access uses `[base]`, then the base register is updated to
// `base + offset` AFTER the access.
func MemPost(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_POST
	op.Reg = base
	op.Imm = cast(int64, offset)
	return op
}

// MemReg returns a memory operand `[base, index]` — register-indexed
// addressing without scaling.
func MemReg(base int, index int) Operand {
	var op Operand
	op.Kind = OP_MEM_REG
	op.Reg = base
	op.Reg2 = index
	return op
}

// MemRegScaled returns a memory operand `[base, index, lsl #log2(size)]` — the
// index is scaled by the access size (S bit set), so it holds the element index
// rather than a byte offset.  See the .bni doc.
func MemRegScaled(base int, index int) Operand {
	var op Operand
	op.Kind = OP_MEM_REG_SCALED
	op.Reg = base
	op.Reg2 = index
	return op
}

// MemUnscaled returns a memory operand `[base, #offset]` that forces the
// unscaled LDUR/STUR encoding (signed 9-bit byte offset, [-256, 255]); see the
// .bni doc.  Distinct from MemImm's scaled unsigned-imm12 form so a negative
// fixed offset (e.g. the refcount header at `[ptr, #-16]`) needs no separate
// address-forming SUB.
func MemUnscaled(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_UNSCALED
	op.Reg = base
	op.Imm = cast(int64, offset)
	return op
}

// Label returns a symbolic-target Operand referring to `name`. The name
// is copied; the input slice does not need to outlive the Operand.
// Used as the target of branches; resolved by the assembler's fixup
// machinery.
func Label(name *[]readonly char) Operand {
	var op Operand
	op.Kind = OP_LABEL
	op.Label = buf.CopyStr(name)
	return op
}

// --- Encoding helpers ---

// emit32 emits a 32-bit instruction word to the assembler's current section.
func emit32(a @asm.Assembler, inst uint32) {
	a.EmitUint32(inst)
}

// emitRnRd emits base with register fields Rn (bits 9:5) and Rd (bits 4:0), each a
// field value from zrReg / spReg / vReg: 0..31, or -1 for an operand already
// reported as an error — then nothing is emitted.
func emitRnRd(a @asm.Assembler, base uint32, rn int, rd int) {
	if rn < 0 || rd < 0 { return }
	emit32(a, base | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// emitRmRnRd emits base with register fields Rm (bits 20:16), Rn and Rd, each a
// mapped field value like emitRnRd's.
func emitRmRnRd(a @asm.Assembler, base uint32, rm int, rn int, rd int) {
	if rm < 0 { return }
	emitRnRd(a, base | (cast(uint32, rm) << 16), rn, rd)
}

// --- Bitmask immediate encoding ---
// AArch64 logical immediates are encoded as N/immr/imms fields representing
// a repeating pattern of contiguous 1-bits within a power-of-2 sized element.

// AND_IMM_OPC is the base encoding for `AND <Rd>, <Rn>, #imm`
// (logical bitmask immediate; sf bit selects 32/64-bit form).
const AND_IMM_OPC uint32 = 0x12000000

// ORR_IMM_OPC is the base encoding for `ORR <Rd>, <Rn>, #imm`.
const ORR_IMM_OPC uint32 = 0x32000000

// EOR_IMM_OPC is the base encoding for `EOR <Rd>, <Rn>, #imm`.
const EOR_IMM_OPC uint32 = 0x52000000

// ANDS_IMM_OPC is the base encoding for `ANDS <Rd>, <Rn>, #imm`
// (AND that also sets condition flags).
const ANDS_IMM_OPC uint32 = 0x72000000
