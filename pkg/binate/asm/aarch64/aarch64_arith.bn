package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// --- Arithmetic instructions ---

// ADD_REG_OPC is the 32-bit base encoding for `ADD Rd, Rn, Rm` (shifted
// register form). The sf bit (31) selects 32/64-bit operand size.
const ADD_REG_OPC uint32 = 0x0B000000

// ADD_IMM_OPC is the base encoding for `ADD Rd, Rn, #imm`.
const ADD_IMM_OPC uint32 = 0x11000000

// SUB_REG_OPC is the base encoding for `SUB Rd, Rn, Rm` (shifted register).
const SUB_REG_OPC uint32 = 0x4B000000

// SUB_IMM_OPC is the base encoding for `SUB Rd, Rn, #imm`.
const SUB_IMM_OPC uint32 = 0x51000000

// ADDS_REG_OPC is the base encoding for `ADDS Rd, Rn, Rm` — ADD that
// also sets NZCV condition flags.
const ADDS_REG_OPC uint32 = 0x2B000000

// ADDS_IMM_OPC is the base encoding for `ADDS Rd, Rn, #imm`.
const ADDS_IMM_OPC uint32 = 0x31000000

// SUBS_REG_OPC is the base encoding for `SUBS Rd, Rn, Rm` — SUB that
// also sets NZCV condition flags. CMP is `SUBS WZR/XZR, ...`.
const SUBS_REG_OPC uint32 = 0x6B000000

// SUBS_IMM_OPC is the base encoding for `SUBS Rd, Rn, #imm`.
const SUBS_IMM_OPC uint32 = 0x71000000

// dpOpsFor maps an add/sub immediate opcode (ADD/SUB/ADDS/SUBS_IMM_OPC) to its OPS_*
// operation.
func dpOpsFor(immOpc uint32) uint32 {
	if immOpc == SUB_IMM_OPC { return isa.OPS_SUB }
	if immOpc == ADDS_IMM_OPC { return isa.OPS_ADDS }
	if immOpc == SUBS_IMM_OPC { return isa.OPS_SUBS }
	return isa.OPS_ADD
}

// dpRdReg maps the destination of an ADD/SUB immediate or extended-register form:
// register 31 is SP for ADD/SUB but the zero register for the flag-setting ADDS/SUBS.
func dpRdReg(a @asm.Assembler, ops uint32, rd int) int {
	if ops == isa.OPS_ADDS || ops == isa.OPS_SUBS { return zrReg(a, rd) }
	return spReg(a, rd)
}

// emitDPReg emits an ADD/SUB/ADDS/SUBS with a (shifted) register operand rm.  The
// shifted-register form reads register 31 as the zero register in every field, so an
// SP destination or first source takes the extended-register form instead (UXTX /
// UXTW, amount = the LSL amount 0..4), as `add x0, sp, x1` assembles; any other shift
// with SP is an error.
func emitDPReg(a @asm.Assembler, sf bool, ops uint32, rd int, rn int, rm int, shift int,
		amount int) {
	if rd == SP || rn == SP {
		if shift != LSL || amount < 0 || amount > 4 {
			a.SetError("aarch64: ADD/SUB with SP takes only an LSL #0..4 of the register operand")
			return
		}
		var ext int = isa.XT_UXTW
		if sf { ext = isa.XT_UXTX }
		isa.AddSubExtended(a, ops, sf, dpRdReg(a, ops, rd), spReg(a, rn), zrReg(a, rm), ext, amount)
		return
	}
	isa.AddSubShifted(a, ops, sf, zrReg(a, rd), zrReg(a, rn), zrReg(a, rm), shift, amount)
}

// emitDPOp emits an ADD/SUB/ADDS/SUBS, dispatching on the operand kind through the
// exact encoders (register or shifted register: emitDPReg; immediate: AddSubImm,
// whose Rn — and a non-flag-setting Rd — read register 31 as SP).  An immediate up to
// 0xFFFFFF that does not fit 12 bits (optionally shifted by 12) is split for ADD/SUB
// into two instructions — rd = rn ± hi*4096, then rd ± lo — which composes; a
// `sub sp, sp, #frameSize` for a large frame needs it.  A flag-setting ADDS/SUBS (and
// CMP/CMN) is never split: the flags would come from the second, partial step alone,
// and CMP's zero-register destination cannot be the second step's source — so such
// an immediate is an error.  Any other operand kind is an error rather than a silently
// missing instruction.
func emitDPOp(a @asm.Assembler, sf bool, regOpc uint32, immOpc uint32, rd int, rn int, op Operand) {
	var ops uint32 = dpOpsFor(immOpc)
	switch op.Kind {
	case OP_REG:
		emitDPReg(a, sf, ops, rd, rn, op.Reg, LSL, 0)
	case OP_REG_SHIFT:
		emitDPReg(a, sf, ops, rd, rn, op.Reg, op.Shift, op.ShAmt)
	case OP_IMM:
		var imm int = cast(int, op.Imm)
		// The AArch64 ADD/SUB immediate is an UNSIGNED 12-bit value, optionally
		// shifted left by 12 — so only 0..0xFFFFFF is representable (as one or two
		// instructions).  A negative immediate is not encodable here: Add/Sub lower
		// it to the opposite op with the negated magnitude before reaching this
		// point, so a negative arriving directly (e.g. a flag-setting Adds/Subs,
		// where op-swapping would change NZCV) or an over-range value is a caller
		// error — fail loud rather than silently masking it to a wrong immediate.
		if imm < 0 || imm > 0xFFFFFF {
			a.SetError("aarch64: ADD/SUB immediate out of range (0..0xFFFFFF); materialize it in a register")
			return
		}
		var lo int = imm & 0xfff
		var hi int = (imm >> 12) & 0xfff
		var rdf int = dpRdReg(a, ops, rd)
		var rnf int = spReg(a, rn)
		if hi == 0 {
			isa.AddSubImm(a, ops, sf, rdf, rnf, lo, false)
		} else if lo == 0 {
			isa.AddSubImm(a, ops, sf, rdf, rnf, hi, true)
		} else if ops == isa.OPS_ADDS || ops == isa.OPS_SUBS {
			a.SetError(
					"aarch64: flag-setting ADDS/SUBS/CMP/CMN immediate needs two instructions; materialize it in "
							"a register")
		} else {
			// Non-flag-setting, so rdf reads 31 as SP in both steps.
			isa.AddSubImm(a, ops, sf, rdf, rnf, hi, true)
			isa.AddSubImm(a, ops, sf, rdf, rdf, lo, false)
		}
	default:
		a.SetError("aarch64: ADD/SUB operand must be a register, shifted register or immediate")
	}
}

// negImmMagOk reports whether a NEGATIVE immediate can be lowered to the
// opposite ADD/SUB op — its magnitude must be encodable (≤ 0xFFFFFF).  This also
// rules out the most-negative value (whose negation overflows back to itself and
// would otherwise make Add/Sub recurse forever); fails loud instead.
func negImmMagOk(a @asm.Assembler, imm int64) bool {
	if imm < cast(int64, 0) - cast(int64, 0xFFFFFF) {
		a.SetError("aarch64: ADD/SUB immediate out of range (0..0xFFFFFF)")
		return false
	}
	return true
}

// Add emits `ADD Rd, Rn, op` (Rd <- Rn + op). sf=true selects the
// 64-bit form. op may be a register, shifted register, or immediate.
// A negative immediate is lowered to `SUB Rd, Rn, #-imm` — the AArch64
// ADD-immediate field is unsigned, so adding a negative constant must be
// emitted as subtracting its magnitude (otherwise the value would be masked
// into a wrong, large positive immediate).
func Add(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	if op.Kind == OP_IMM && op.Imm < cast(int64, 0) {
		if !negImmMagOk(a, op.Imm) {
			return
		}
		Sub(a, sf, rd, rn, Imm(cast(int, cast(int64, 0) - op.Imm)))
		return
	}
	emitDPOp(a, sf, ADD_REG_OPC, ADD_IMM_OPC, rd, rn, op)
}

// AddImmLabel emits `ADD rd, rn, #0` and a FIX_ADD_LO12 fixup against label.
// The linker patches the imm12 with the low 12 bits of the target address.
// Intended for ADRP+ADD pairs that materialize a full 64-bit address.
func AddImmLabel(a @asm.Assembler, sf bool, rd int, rn int, label *[]readonly char) {
	isa.AddSubLo12(a, sf, spReg(a, rd), spReg(a, rn), label, 0)
}

// Sub emits `SUB Rd, Rn, op` (Rd <- Rn - op).  A negative immediate is lowered
// to `ADD Rd, Rn, #-imm` for the same reason as Add's negative case.
func Sub(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	if op.Kind == OP_IMM && op.Imm < cast(int64, 0) {
		if !negImmMagOk(a, op.Imm) {
			return
		}
		Add(a, sf, rd, rn, Imm(cast(int, cast(int64, 0) - op.Imm)))
		return
	}
	emitDPOp(a, sf, SUB_REG_OPC, SUB_IMM_OPC, rd, rn, op)
}

// Adds emits `ADDS Rd, Rn, op` — ADD that also sets NZCV condition
// flags from the result.
func Adds(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitDPOp(a, sf, ADDS_REG_OPC, ADDS_IMM_OPC, rd, rn, op)
}

// Subs emits `SUBS Rd, Rn, op` — SUB that also sets NZCV condition
// flags. CMP is `SUBS XZR, ...`.
func Subs(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitDPOp(a, sf, SUBS_REG_OPC, SUBS_IMM_OPC, rd, rn, op)
}

// --- Logical instructions ---

// AND_REG_OPC is the base encoding for `AND Rd, Rn, Rm` (shifted register).
const AND_REG_OPC uint32 = 0x0A000000

// ORR_REG_OPC is the base encoding for `ORR Rd, Rn, Rm` (shifted register).
const ORR_REG_OPC uint32 = 0x2A000000

// EOR_REG_OPC is the base encoding for `EOR Rd, Rn, Rm` (shifted register).
const EOR_REG_OPC uint32 = 0x4A000000

// ANDS_REG_OPC is the base encoding for `ANDS Rd, Rn, Rm` (shifted register;
// sf|11|01010|shift|0|Rm|imm6|Rn|Rd) — AND that also sets NZCV condition
// flags.  TST is `ANDS XZR/WZR, ...`.
const ANDS_REG_OPC uint32 = 0x6A000000

// emitLogOp emits a logical instruction through the exact encoders — register or
// shifted register (LogicalShifted; every register field reads 31 as the zero
// register) or bitmask immediate (LogicalImm; Rd reads 31 as SP, except for ANDS,
// and Rn as the zero register).  A logical immediate has no arbitrary-value form, so
// an unencodable one (or any other operand kind) sets an assembler error and emits
// nothing; LogicalImmFits is the matching predicate for callers that must pick the
// register form instead.  regOpc / immOpc name the operation (regOpc's opc bits
// select it).
func emitLogOp(a @asm.Assembler, sf bool, regOpc uint32, immOpc uint32, rd int, rn int,
		op Operand) {
	var lg uint32 = regOpc & 0x60000000
	switch op.Kind {
	case OP_REG:
		isa.LogicalShifted(a, lg, sf, zrReg(a, rd), zrReg(a, rn), zrReg(a, op.Reg), LSL, 0)
	case OP_REG_SHIFT:
		isa.LogicalShifted(a, lg, sf, zrReg(a, rd), zrReg(a, rn), zrReg(a, op.Reg), op.Shift, op.ShAmt)
	case OP_IMM:
		var rdf int
		if lg == isa.LG_ANDS {
			rdf = zrReg(a, rd)
		} else {
			rdf = spReg(a, rd)
		}
		isa.LogicalImm(a, lg, sf, rdf, zrReg(a, rn), cast(uint64, op.Imm))
	default:
		a.SetError("aarch64: logical operand must be a register, shifted register or immediate")
	}
}

// LogicalImmFits reports whether imm is encodable as the bitmask immediate of a
// 32-bit (sf=false) or 64-bit (sf=true) AND/ORR/EOR/ANDS/TST — exactly the
// values emitLogOp encodes, since both go through isa's logical-immediate check.
func LogicalImmFits(sf bool, imm int64) bool {
	return isa.IsLogicalImm(cast(uint64, imm), sf)
}

// And emits `AND Rd, Rn, op` — bitwise AND. op may be a register,
// shifted register, or encodable bitmask immediate.
func And(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, AND_REG_OPC, AND_IMM_OPC, rd, rn, op)
}

// Orr emits `ORR Rd, Rn, op` — bitwise OR.
func Orr(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, ORR_REG_OPC, ORR_IMM_OPC, rd, rn, op)
}

// Eor emits `EOR Rd, Rn, op` — bitwise XOR.
func Eor(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, EOR_REG_OPC, EOR_IMM_OPC, rd, rn, op)
}

// Ands emits `ANDS Rd, Rn, op` — AND that also sets NZCV condition flags.
// Rd=XZR gives TST.
func Ands(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, ANDS_REG_OPC, ANDS_IMM_OPC, rd, rn, op)
}

// Mvn emits `MVN Rd, op` — bitwise NOT. Encoded as `ORN Rd, XZR, op`.
func Mvn(a @asm.Assembler, sf bool, rd int, op Operand) {
	if op.Kind == OP_REG {
		isa.LogicalShifted(a, isa.LG_ORR | isa.LG_NOT, sf, zrReg(a, rd), 31, zrReg(a, op.Reg), LSL, 0)
	} else if op.Kind == OP_REG_SHIFT {
		isa.LogicalShifted(a, isa.LG_ORR | isa.LG_NOT, sf, zrReg(a, rd), 31, zrReg(a, op.Reg), op.Shift,
				op.ShAmt)
	} else {
		a.SetError("aarch64: MVN operand must be a register or shifted register")
	}
}

// --- Move instructions ---

// Mov emits `MOV Rd, op`: a register move or a 16-bit immediate (MOVZ).  A move to
// or from SP is `ADD Rd, Rn, #0` (whose fields read 31 as SP); any other register
// move, including one from XZR, is `ORR Rd, XZR, Rm` (whose fields read 31 as XZR).
func Mov(a @asm.Assembler, sf bool, rd int, op Operand) {
	if op.Kind == OP_REG {
		if rd == SP || op.Reg == SP {
			isa.AddSubImm(a, isa.OPS_ADD, sf, spReg(a, rd), spReg(a, op.Reg), 0, false)
		} else {
			isa.LogicalShifted(a, isa.LG_ORR, sf, zrReg(a, rd), 31, zrReg(a, op.Reg), LSL, 0)
		}
	} else if op.Kind == OP_IMM {
		// A 16-bit non-negative immediate: MOVZ.  Wider constants need a MOVZ/MOVK
		// (or MOVN / bitmask) sequence the caller chooses; masking the value to 16
		// bits here would silently load a different constant.
		if op.Imm < 0 || op.Imm > 0xFFFF {
			a.SetError("aarch64: MOV immediate outside 0..0xFFFF; materialize it with MOVZ/MOVK")
			return
		}
		isa.MoveWide(a, isa.MW_MOVZ, sf, zrReg(a, rd), cast(int, op.Imm), 0)
	} else {
		a.SetError("aarch64: MOV operand must be a register or an immediate")
	}
}

// MOVZ: sf|10|100101|hw|imm16|Rd
func Movz(a @asm.Assembler, sf bool, rd int, imm int, shift int) {
	isa.MoveWide(a, isa.MW_MOVZ, sf, zrReg(a, rd), imm, shift)
}

// MOVK: sf|11|100101|hw|imm16|Rd
func Movk(a @asm.Assembler, sf bool, rd int, imm int, shift int) {
	isa.MoveWide(a, isa.MW_MOVK, sf, zrReg(a, rd), imm, shift)
}

// MOVN: sf|00|100101|hw|imm16|Rd
func Movn(a @asm.Assembler, sf bool, rd int, imm int, shift int) {
	isa.MoveWide(a, isa.MW_MOVN, sf, zrReg(a, rd), imm, shift)
}
