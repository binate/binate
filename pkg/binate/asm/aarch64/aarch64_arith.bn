package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// --- Arithmetic instructions ---

// ADD_REG_OPC is the 32-bit base encoding for `ADD Rd, Rn, Rm` (shifted
// register form). The sf bit (31) selects 32/64-bit operand size.
const ADD_REG_OPC uint32 = 0x0B000000
// ADD_IMM_OPC is the base encoding for `ADD Rd, Rn, #imm`.
const ADD_IMM_OPC uint32 = 0x11000000
// SUB_REG_OPC is the base encoding for `SUB Rd, Rn, Rm` (shifted register).
const SUB_REG_OPC uint32 = 0x4B000000
// SUB_IMM_OPC is the base encoding for `SUB Rd, Rn, #imm`.
const SUB_IMM_OPC uint32 = 0x51000000
// ADDS_REG_OPC is the base encoding for `ADDS Rd, Rn, Rm` — ADD that
// also sets NZCV condition flags.
const ADDS_REG_OPC uint32 = 0x2B000000
// ADDS_IMM_OPC is the base encoding for `ADDS Rd, Rn, #imm`.
const ADDS_IMM_OPC uint32 = 0x31000000
// SUBS_REG_OPC is the base encoding for `SUBS Rd, Rn, Rm` — SUB that
// also sets NZCV condition flags. CMP is `SUBS WZR/XZR, ...`.
const SUBS_REG_OPC uint32 = 0x6B000000
// SUBS_IMM_OPC is the base encoding for `SUBS Rd, Rn, #imm`.
const SUBS_IMM_OPC uint32 = 0x71000000

// emitDPOp emits a data-processing instruction, dispatching to the register
// or immediate encoding based on the operand kind. For immediates that
// don't fit in 12 bits, splits into two instructions: one with sh=1
// (high 12 bits, shifted by 12) followed by one with sh=0 (low 12).
// ADD and SUB both compose this way: rd = rn ± hi*4096 ± lo. Pre-fix,
// dpImmEnc silently masked imm with 0xfff and dropped the high bits,
// so a `sub sp, sp, #frameSize` for any function with a > 4095-byte
// frame allocated too little stack and corrupted SP-relative
// addressing for every offset above 4095.
func emitDPOp(a @asm.Assembler, sf bool, regOpc uint32, immOpc uint32, rd int, rn int, op Operand) {
	if op.Kind == OP_REG {
		emit32(a, dpRegEnc(sf, regOpc, op.Reg, 0, 0, rn, rd))
	} else if op.Kind == OP_IMM {
		var imm int = cast(int, op.Imm)
		var lo int = imm & 0xfff
		var hi int = (imm >> 12) & 0xfff
		if hi == 0 {
			emit32(a, dpImmEnc(sf, immOpc, lo, rn, rd))
		} else {
			// Two-step: rd = rn ± (hi << 12), then rd = rd ± lo.
			emit32(a, dpImmEncShifted(sf, immOpc, hi, true,
				rn, rd))
			if lo != 0 {
				emit32(a, dpImmEnc(sf, immOpc, lo, rd, rd))
			}
		}
	} else if op.Kind == OP_REG_SHIFT {
		emit32(a, dpRegEnc(sf, regOpc, op.Reg, op.Shift, op.ShAmt, rn, rd))
	}
}

// Add emits `ADD Rd, Rn, op` (Rd <- Rn + op). sf=true selects the
// 64-bit form. op may be a register, shifted register, or immediate.
func Add(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitDPOp(a, sf, ADD_REG_OPC, ADD_IMM_OPC, rd, rn, op)
}

// AddImmLabel emits `ADD rd, rn, #0` and a FIX_ADD_LO12 fixup against label.
// The linker patches the imm12 with the low 12 bits of the target address.
// Intended for ADRP+ADD pairs that materialize a full 64-bit address.
func AddImmLabel(a @asm.Assembler, sf bool, rd int, rn int, label *[]readonly char) {
	a.AddFixup(label, FIX_ADD_LO12, 0, 4)
	emit32(a, dpImmEnc(sf, ADD_IMM_OPC, 0, rn, rd))
}

// Sub emits `SUB Rd, Rn, op` (Rd <- Rn - op).
func Sub(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitDPOp(a, sf, SUB_REG_OPC, SUB_IMM_OPC, rd, rn, op)
}

// Adds emits `ADDS Rd, Rn, op` — ADD that also sets NZCV condition
// flags from the result.
func Adds(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitDPOp(a, sf, ADDS_REG_OPC, ADDS_IMM_OPC, rd, rn, op)
}

// Subs emits `SUBS Rd, Rn, op` — SUB that also sets NZCV condition
// flags. CMP is `SUBS XZR, ...`.
func Subs(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitDPOp(a, sf, SUBS_REG_OPC, SUBS_IMM_OPC, rd, rn, op)
}

// --- Logical instructions ---

// AND_REG_OPC is the base encoding for `AND Rd, Rn, Rm` (shifted register).
const AND_REG_OPC uint32 = 0x0A000000
// ORR_REG_OPC is the base encoding for `ORR Rd, Rn, Rm` (shifted register).
const ORR_REG_OPC uint32 = 0x2A000000
// EOR_REG_OPC is the base encoding for `EOR Rd, Rn, Rm` (shifted register).
const EOR_REG_OPC uint32 = 0x4A000000

// emitLogOp emits a logical instruction, dispatching to register, shifted
// register, or bitmask immediate encoding based on the operand kind.
func emitLogOp(a @asm.Assembler, sf bool, regOpc uint32,
		immOpc uint32, rd int, rn int, op Operand) {
	if op.Kind == OP_REG {
		emit32(a, dpRegEnc(sf, regOpc, op.Reg, 0, 0, rn, rd))
	} else if op.Kind == OP_REG_SHIFT {
		emit32(a, dpRegEnc(sf, regOpc, op.Reg, op.Shift, op.ShAmt, rn, rd))
	} else if op.Kind == OP_IMM {
		var enc BitmaskResult = encodeBitmaskImm(cast(uint64, op.Imm), sf)
		if enc.Ok {
			emit32(a, logImmEnc(sf, immOpc, enc.N, enc.Immr, enc.Imms, rn, rd))
		}
		// If !Ok, the immediate is not encodable — silent failure for now.
		// TODO: report error
	}
}

// And emits `AND Rd, Rn, op` — bitwise AND. op may be a register,
// shifted register, or encodable bitmask immediate.
func And(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, AND_REG_OPC, AND_IMM_OPC, rd, rn, op)
}

// Orr emits `ORR Rd, Rn, op` — bitwise OR.
func Orr(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, ORR_REG_OPC, ORR_IMM_OPC, rd, rn, op)
}

// Eor emits `EOR Rd, Rn, op` — bitwise XOR.
func Eor(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	emitLogOp(a, sf, EOR_REG_OPC, EOR_IMM_OPC, rd, rn, op)
}

// ANDS: like AND but sets flags. Rd=XZR gives TST.
func Ands(a @asm.Assembler, sf bool, rd int, rn int, op Operand) {
	// ANDS register: sf|11|01010|shift|0|Rm|imm6|Rn|Rd = 0x6A000000
	// ANDS immediate: sf|11|100100|N|immr|imms|Rn|Rd = 0x72000000
	if op.Kind == OP_REG {
		emit32(a, dpRegEnc(sf, 0x6A000000, op.Reg, 0, 0, rn, rd))
	} else if op.Kind == OP_REG_SHIFT {
		emit32(a, dpRegEnc(sf, 0x6A000000, op.Reg, op.Shift, op.ShAmt, rn, rd))
	} else if op.Kind == OP_IMM {
		var enc BitmaskResult = encodeBitmaskImm(cast(uint64, op.Imm), sf)
		if enc.Ok {
			emit32(a, logImmEnc(sf, ANDS_IMM_OPC, enc.N, enc.Immr, enc.Imms, rn, rd))
		}
	}
}

// MVN: bitwise NOT. Alias for ORN Rd, XZR, Op2.
// ORN register: sf|01|01010|shift|1|Rm|imm6|Rn|Rd (N bit = bit 21)
const ORN_REG_OPC uint32 = 0x2A200000

// Mvn emits `MVN Rd, op` — bitwise NOT. Encoded as `ORN Rd, XZR, op`.
func Mvn(a @asm.Assembler, sf bool, rd int, op Operand) {
	if op.Kind == OP_REG {
		emit32(a, dpRegEnc(sf, ORN_REG_OPC, op.Reg, 0, 0, XZR, rd))
	} else if op.Kind == OP_REG_SHIFT {
		emit32(a, dpRegEnc(sf, ORN_REG_OPC, op.Reg, op.Shift, op.ShAmt, XZR, rd))
	}
}

// --- Move instructions ---

func Mov(a @asm.Assembler, sf bool, rd int, op Operand) {
	if op.Kind == OP_REG {
		// Register 31 is SP in some contexts and XZR in others.
		// ORR Rd, XZR, Rm uses XZR for Rm=31, so MOV Rd, SP via ORR
		// would incorrectly become MOV Rd, XZR.
		// When either rd or op.Reg is SP (31), use ADD Rd, Rn, #0 instead,
		// which interprets register 31 as SP.
		if rd == SP || op.Reg == SP {
			emit32(a, dpImmEnc(sf, ADD_IMM_OPC, 0, op.Reg, rd))
		} else {
			// MOV Rd, Rm is alias for ORR Rd, XZR, Rm
			emit32(a, dpRegEnc(sf, ORR_REG_OPC, op.Reg, 0, 0, XZR, rd))
		}
	} else if op.Kind == OP_IMM {
		// Small non-negative immediate: use MOVZ
		Movz(a, sf, rd, cast(int, op.Imm), 0)
	}
}

// MOVZ: sf|10|100101|hw|imm16|Rd
func Movz(a @asm.Assembler, sf bool, rd int, imm int, shift int) {
	var hw int = shift / 16  // 0, 1, 2, 3
	var inst uint32 = sfBit(sf) | 0x52800000
	inst = inst | (cast(uint32, hw & 3) << 21)
	inst = inst | (cast(uint32, imm & 0xffff) << 5)
	inst = inst | cast(uint32, rd & 0x1f)
	emit32(a, inst)
}

// MOVK: sf|11|100101|hw|imm16|Rd
func Movk(a @asm.Assembler, sf bool, rd int, imm int, shift int) {
	var hw int = shift / 16
	var inst uint32 = sfBit(sf) | 0x72800000
	inst = inst | (cast(uint32, hw & 3) << 21)
	inst = inst | (cast(uint32, imm & 0xffff) << 5)
	inst = inst | cast(uint32, rd & 0x1f)
	emit32(a, inst)
}

// MOVN: sf|00|100101|hw|imm16|Rd
func Movn(a @asm.Assembler, sf bool, rd int, imm int, shift int) {
	var hw int = shift / 16
	var inst uint32 = sfBit(sf) | 0x12800000
	inst = inst | (cast(uint32, hw & 3) << 21)
	inst = inst | (cast(uint32, imm & 0xffff) << 5)
	inst = inst | cast(uint32, rd & 0x1f)
	emit32(a, inst)
}

// --- Load/Store ---

// LDR (immediate, unsigned offset): sf|11|1001|01|imm12|Rn|Rt
// STR (immediate, unsigned offset): sf|11|1001|00|imm12|Rn|Rt
// The imm12 is scaled by the access size (8 for X, 4 for W).

func ldrStrUnsignedEnc(sf bool, isLoad bool, imm int, rn int, rt int) uint32 {
	var size uint32 = 0x80000000  // size=10 (32-bit) default
	var scale int = 4
	if sf {
		size = 0xC0000000  // size=11 (64-bit)
		scale = 8
	}
	var opc uint32 = 0x39000000  // STR base
	if isLoad {
		opc = 0x39400000  // LDR base
	}
	var inst uint32 = size | opc
	var scaledImm int = imm / scale
	inst = inst | (cast(uint32, scaledImm & 0xfff) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// LdrStrImmFitsUnsigned reports whether `imm` is encodable as the
// unsigned-imm12 form of a 32- or 64-bit LDR/STR (sf=false → 32-bit
// scaled by 4; sf=true → 64-bit scaled by 8). The encoding silently
// masks the scaled imm to 12 bits — for sp-relative ops in large
// frames (e.g. the auto-generated test runner with many tests) that
// produces wrong addresses. Native backend callers should check this
// and materialize the address into a scratch register otherwise.
func LdrStrImmFitsUnsigned(sf bool, imm int) bool {
	if imm < 0 { return false }
	var scale int = 4
	if sf { scale = 8 }
	if imm % scale != 0 { return false }
	return (imm / scale) <= 4095
}

// LDR/STR (pre-index): size|11|1000|opc|0|imm9|11|Rn|Rt
// LDR/STR (post-index): size|11|1000|opc|0|imm9|01|Rn|Rt
func ldrStrIndexEnc(sf bool, isLoad bool, imm int, rn int, rt int, isPre bool) uint32 {
	var size uint32 = 0x80000000
	if sf {
		size = 0xC0000000
	}
	var opc uint32 = 0x38000000  // STR base
	if isLoad {
		opc = 0x38400000  // LDR base
	}
	var inst uint32 = size | opc
	inst = inst | (cast(uint32, imm & 0x1ff) << 12)
	if isPre {
		inst = inst | (3 << 10)  // pre-index: 11
	} else {
		inst = inst | (1 << 10)  // post-index: 01
	}
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// LDR/STR (register): size|11|1000|opc|1|Rm|011|0|10|Rn|Rt
func ldrStrRegEnc(sf bool, isLoad bool, rm int, rn int, rt int) uint32 {
	var size uint32 = 0x80000000
	if sf {
		size = 0xC0000000
	}
	var opc uint32 = 0x38200000  // STR (register) base
	if isLoad {
		opc = 0x38600000  // LDR (register) base
	}
	var inst uint32 = size | opc
	inst = inst | (cast(uint32, rm & 0x1f) << 16)
	inst = inst | (3 << 13)   // option = 011 (LSL)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// emitLdrStr emits a load or store instruction, dispatching to unsigned-offset,
// pre/post-index, register-offset, or literal encoding based on operand kind.
//
// For OP_MEM_IMM: if the offset doesn't fit the unsigned-imm12 form
// (capped at 4096 * scale, where scale is the access size), the encoder
// would otherwise silently mask the scaled imm to 12 bits and emit
// the wrong address. Fall back to materializing base+off into X17
// first, then emit with a zero offset. Caller must not pass rt=X17 in
// the overflowing case; that's not exercised today and we set an
// assembler error if it is.
func emitLdrStr(a @asm.Assembler, sf bool, isLoad bool, rt int, op Operand) {
	if op.Kind == OP_MEM_IMM {
		if !LdrStrImmFitsUnsigned(sf, cast(int, op.Imm)) {
			if rt == X17 {
				a.SetError("LDR/STR overflow: rt=X17 conflicts with scratch")
				return
			}
			Add(a, true, X17, op.Reg, Imm(cast(int, op.Imm)))
			emit32(a, ldrStrUnsignedEnc(sf, isLoad, 0, X17, rt))
			return
		}
		emit32(a, ldrStrUnsignedEnc(sf, isLoad, cast(int, op.Imm), op.Reg, rt))
	} else if op.Kind == OP_MEM_PRE {
		emit32(a, ldrStrIndexEnc(sf, isLoad, cast(int, op.Imm), op.Reg, rt, true))
	} else if op.Kind == OP_MEM_POST {
		emit32(a, ldrStrIndexEnc(sf, isLoad, cast(int, op.Imm), op.Reg, rt, false))
	} else if op.Kind == OP_MEM_REG {
		emit32(a, ldrStrRegEnc(sf, isLoad, op.Reg2, op.Reg, rt))
	} else if op.Kind == OP_LABEL {
		// LDR (literal): sf|01|1000|imm19|Rt
		var inst uint32 = sfBit(sf) | 0x18000000
		inst = inst | cast(uint32, rt & 0x1f)
		a.AddFixup(op.Label, FIX_BRANCH19, 0, 4)
		emit32(a, inst)
	}
}

// Ldr emits `LDR Rt, op` — load a 32- or 64-bit register from memory.
// sf=true selects the 64-bit form. op may be an immediate-offset, pre-
// or post-indexed, or register-indexed memory operand.
func Ldr(a @asm.Assembler, sf bool, rt int, op Operand) {
	emitLdrStr(a, sf, true, rt, op)
}

// Str emits `STR Rt, op` — store a 32- or 64-bit register to memory.
// Same op encodings as Ldr.
func Str(a @asm.Assembler, sf bool, rt int, op Operand) {
	emitLdrStr(a, sf, false, rt, op)
}

// LdrImmLabel emits `LDR rt, [base, #0]` and a FIX_LDR_LO12 fixup against label.
// The linker patches the scaled imm12 with (low-12-of-target >> size-log2).
// Intended for ADRP+LDR pairs that load from a PC-relative target.
func LdrImmLabel(a @asm.Assembler, sf bool, rt int, base int, label *[]readonly char) {
	a.AddFixup(label, FIX_LDR_LO12, 0, 4)
	emit32(a, ldrStrUnsignedEnc(sf, true, 0, base, rt))
}

// ldrStrSubWordEmit emits a STRB/LDRB/STRH/LDRH at [base, #imm].
// scale = 1 for byte ops (no shift), 2 for halfword ops (imm12 scaled
// by 2). Materializes the address into X17 if imm doesn't fit the
// scaled-imm12 form, mirroring emitLdrStr's overflow handling.
func ldrStrSubWordEmit(a @asm.Assembler, baseInst uint32, scale int,
	rt int, op Operand) {
	if op.Kind != OP_MEM_IMM { return }
	var imm int = cast(int, op.Imm)
	var base int = op.Reg
	if imm < 0 || imm % scale != 0 || (imm / scale) > 4095 {
		if rt == X17 {
			a.SetError("STRB/STRH/LDRB/LDRH overflow: rt=X17 conflicts with scratch")
			return
		}
		Add(a, true, X17, base, Imm(imm))
		base = X17
		imm = 0
	}
	var scaledImm int = imm / scale
	var inst uint32 = baseInst
	inst = inst | (cast(uint32, scaledImm & 0xfff) << 10)
	inst = inst | (cast(uint32, base & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	emit32(a, inst)
}

// LDRB (unsigned offset): 00|111001|01|imm12|Rn|Rt
func Ldrb(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x39400000, 1, rt, op)
}

// STRB (unsigned offset): 00|111001|00|imm12|Rn|Rt
func Strb(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x39000000, 1, rt, op)
}

// LDRH (unsigned offset): 01|111001|01|imm12|Rn|Rt (imm12 scaled by 2)
func Ldrh(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x79400000, 2, rt, op)
}

// STRH (unsigned offset): 01|111001|00|imm12|Rn|Rt (imm12 scaled by 2)
func Strh(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x79000000, 2, rt, op)
}

// --- Load/Store pair ---

// LDP: opc|10100|L|1|imm7|Rt2|Rn|Rt  (signed offset)
// STP: opc|10100|L|0|imm7|Rt2|Rn|Rt
func ldpStpEnc(sf bool, isLoad bool, imm int, rt2 int, rn int, rt1 int, mode int) uint32 {
	var opc uint32 = 0x28000000  // 32-bit
	var scale int = 4
	if sf {
		opc = 0xA8000000  // 64-bit
		scale = 8
	}
	if isLoad {
		opc = opc | (1 << 22)  // L bit
	}
	// mode: 1=post, 2=signed-offset, 3=pre
	opc = opc | (cast(uint32, mode) << 23)
	var scaledImm int = imm / scale
	var inst uint32 = opc
	inst = inst | (cast(uint32, scaledImm & 0x7f) << 15)
	inst = inst | (cast(uint32, rt2 & 0x1f) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt1 & 0x1f)
	return inst
}

// Ldp emits `LDP Rt1, Rt2, op` — load a pair of registers from memory.
// op selects offset (signed scaled imm7), pre-indexed, or post-indexed
// addressing.
func Ldp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand) {
	if op.Kind == OP_MEM_IMM {
		emit32(a, ldpStpEnc(sf, true, cast(int, op.Imm), rt2, op.Reg, rt1, 2))
	} else if op.Kind == OP_MEM_PRE {
		emit32(a, ldpStpEnc(sf, true, cast(int, op.Imm), rt2, op.Reg, rt1, 3))
	} else if op.Kind == OP_MEM_POST {
		emit32(a, ldpStpEnc(sf, true, cast(int, op.Imm), rt2, op.Reg, rt1, 1))
	}
}

// Stp emits `STP Rt1, Rt2, op` — store a pair of registers to memory.
// Same op encodings as Ldp.
func Stp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand) {
	if op.Kind == OP_MEM_IMM {
		emit32(a, ldpStpEnc(sf, false, cast(int, op.Imm), rt2, op.Reg, rt1, 2))
	} else if op.Kind == OP_MEM_PRE {
		emit32(a, ldpStpEnc(sf, false, cast(int, op.Imm), rt2, op.Reg, rt1, 3))
	} else if op.Kind == OP_MEM_POST {
		emit32(a, ldpStpEnc(sf, false, cast(int, op.Imm), rt2, op.Reg, rt1, 1))
	}
}
