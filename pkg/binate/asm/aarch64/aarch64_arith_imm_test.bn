package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding + fail-loud tests for ADD/SUB immediate handling: negative
// immediates lowered to the opposite op, the two-instruction split, and the
// out-of-range / flag-setting fail-loud paths (split from aarch64_arith_test.bn
// for length).

// A negative immediate to Add must lower to SUB #-imm (the ADD-immediate field
// is unsigned; masking a negative would encode a wrong large positive value).
func TestAddNegImmLowersToSub() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0 - 16)) // -> sub x0, x1, #16
	Add(a, false, X0, X1, Imm(0 - 16)) // -> sub w0, w1, #16 (32-bit)
	Add(a, true, X0, X1, Imm(0 - 4100)) // -> sub x0,x1,#1,lsl#12 ; sub x0,x0,#4
	if readInst(a.Sections[0], 0) != cast(uint32, 0xD1004020) {
		return fail("ADD X0,X1,#-16 should be SUB X0,X1,#16")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x51004020) {
		return fail("ADD W0,W1,#-16 should be SUB W0,W1,#16")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0xD1400420) {
		return fail("ADD X0,X1,#-4100 first word wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0xD1001000) {
		return fail("ADD X0,X1,#-4100 second word wrong")
	}
	if a.HasError { return fail("negative ADD immediate should not error") }
	return ""
}

// A negative immediate to Sub must lower to ADD #-imm.
func TestSubNegImmLowersToAdd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Sub(a, true, X0, X1, Imm(0 - 16)) // -> add x0, x1, #16
	if readInst(a.Sections[0], 0) != cast(uint32, 0x91004020) {
		return fail("SUB X0,X1,#-16 should be ADD X0,X1,#16")
	}
	if a.HasError { return fail("negative SUB immediate should not error") }
	return ""
}

// An immediate that exceeds the encodable range (0..0xFFFFFF) must fail loud,
// not be silently truncated to a wrong value.
func TestAddImmOverRangeFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0x1000000)) // one past the 2-instruction max
	if !a.HasError {
		return fail("over-range ADD immediate should set HasError")
	}
	return ""
}

// A negative immediate to a FLAG-setting op (Adds/Subs) cannot be op-swapped
// without changing NZCV, so it must fail loud rather than mis-encode.
func TestAddsNegImmFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adds(a, true, X0, X1, Imm(0 - 16))
	if !a.HasError {
		return fail("negative ADDS immediate should set HasError")
	}
	return ""
}

// The maximum encodable magnitude (0xFFFFFF) is accepted as two instructions,
// for both a positive ADD and a negative ADD lowered to SUB.
func TestAddSubImmMaxMagnitude() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0xFFFFFF)) // add x0,x1,#0xfff,lsl#12 ; add x0,x0,#0xfff
	if readInst(a.Sections[0], 0) != cast(uint32, 0x917FFC20) {
		return fail("ADD #0xFFFFFF first word wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x913FFC00) {
		return fail("ADD #0xFFFFFF second word wrong")
	}
	if a.HasError { return fail("ADD #0xFFFFFF should be encodable") }

	var b @asm.Assembler = newAsm()
	Sub(b, true, X0, X1, Imm(0xFFFFFF))
	if readInst(b.Sections[0], 0) != cast(uint32, 0xD17FFC20) {
		return fail("SUB #0xFFFFFF first word wrong")
	}
	if readInst(b.Sections[0], 4) != cast(uint32, 0xD13FFC00) {
		return fail("SUB #0xFFFFFF second word wrong")
	}

	var c @asm.Assembler = newAsm()
	Add(c, true, X0, X1, Imm(0 - 0xFFFFFF)) // -> SUB #0xFFFFFF (two instrs)
	if readInst(c.Sections[0], 0) != cast(uint32, 0xD17FFC20) {
		return fail("ADD #-0xFFFFFF should lower to SUB #0xFFFFFF")
	}
	if readInst(c.Sections[0], 4) != cast(uint32, 0xD13FFC00) {
		return fail("ADD #-0xFFFFFF second word wrong")
	}
	return ""
}

// An over-range NEGATIVE immediate must fail loud (not recurse forever via the
// Add<->Sub negation, which is the path that also guards the most-negative value).
func TestAddNegImmOverRangeFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0 - 0x1000000)) // magnitude one past the max
	if !a.HasError {
		return fail("over-range negative ADD should set HasError")
	}
	return ""
}

// The flag-setting SUBS also fails loud on a negative immediate (no op-swap, as
// that would change NZCV), and both ADDS/SUBS fail loud when over-range.
func TestSubsNegAndOverRangeFailLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Subs(a, true, X0, X1, Imm(0 - 16))
	if !a.HasError { return fail("negative SUBS immediate should set HasError") }

	var b @asm.Assembler = newAsm()
	Adds(b, true, X0, X1, Imm(0x1000000))
	if !b.HasError { return fail("over-range ADDS immediate should set HasError") }
	return ""
}
