package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding + fail-loud tests for immediate operands.  ADD/SUB: negative
// immediates lowered to the opposite op, the two-instruction split, and the
// out-of-range / flag-setting fail-loud paths.  AND/ORR/EOR/ANDS/TST: bitmask
// immediates checked against clang's encodings and accept/reject decisions
// (clang -target arm64-apple-macos), the fail-loud path for unencodable values
// and for non-register, non-immediate operand kinds, and LogicalImmFits
// agreeing with the encoder.

// A negative immediate to Add must lower to SUB #-imm (the ADD-immediate field
// is unsigned; masking a negative would encode a wrong large positive value).
func TestAddNegImmLowersToSub() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0 - 16)) // -> sub x0, x1, #16
	Add(a, false, X0, X1, Imm(0 - 16)) // -> sub w0, w1, #16 (32-bit)
	Add(a, true, X0, X1, Imm(0 - 4100)) // -> sub x0,x1,#1,lsl#12 ; sub x0,x0,#4
	if readInst(a.Sections[0], 0) != cast(uint32, 0xD1004020) {
		return fail("ADD X0,X1,#-16 should be SUB X0,X1,#16")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x51004020) {
		return fail("ADD W0,W1,#-16 should be SUB W0,W1,#16")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0xD1400420) {
		return fail("ADD X0,X1,#-4100 first word wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0xD1001000) {
		return fail("ADD X0,X1,#-4100 second word wrong")
	}
	if a.HasError { return fail("negative ADD immediate should not error") }
	return ""
}

// A negative immediate to Sub must lower to ADD #-imm.
func TestSubNegImmLowersToAdd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Sub(a, true, X0, X1, Imm(0 - 16)) // -> add x0, x1, #16
	if readInst(a.Sections[0], 0) != cast(uint32, 0x91004020) {
		return fail("SUB X0,X1,#-16 should be ADD X0,X1,#16")
	}
	if a.HasError { return fail("negative SUB immediate should not error") }
	return ""
}

// An immediate that exceeds the encodable range (0..0xFFFFFF) must fail loud,
// not be silently truncated to a wrong value.
func TestAddImmOverRangeFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0x1000000)) // one past the 2-instruction max
	if !a.HasError {
		return fail("over-range ADD immediate should set HasError")
	}
	return ""
}

// A negative immediate to a FLAG-setting op (Adds/Subs) cannot be op-swapped
// without changing NZCV, so it must fail loud rather than mis-encode.
func TestAddsNegImmFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adds(a, true, X0, X1, Imm(0 - 16))
	if !a.HasError {
		return fail("negative ADDS immediate should set HasError")
	}
	return ""
}

// The maximum encodable magnitude (0xFFFFFF) is accepted as two instructions,
// for both a positive ADD and a negative ADD lowered to SUB.
func TestAddSubImmMaxMagnitude() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0xFFFFFF)) // add x0,x1,#0xfff,lsl#12 ; add x0,x0,#0xfff
	if readInst(a.Sections[0], 0) != cast(uint32, 0x917FFC20) {
		return fail("ADD #0xFFFFFF first word wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x913FFC00) {
		return fail("ADD #0xFFFFFF second word wrong")
	}
	if a.HasError { return fail("ADD #0xFFFFFF should be encodable") }

	var b @asm.Assembler = newAsm()
	Sub(b, true, X0, X1, Imm(0xFFFFFF))
	if readInst(b.Sections[0], 0) != cast(uint32, 0xD17FFC20) {
		return fail("SUB #0xFFFFFF first word wrong")
	}
	if readInst(b.Sections[0], 4) != cast(uint32, 0xD13FFC00) {
		return fail("SUB #0xFFFFFF second word wrong")
	}

	var c @asm.Assembler = newAsm()
	Add(c, true, X0, X1, Imm(0 - 0xFFFFFF)) // -> SUB #0xFFFFFF (two instrs)
	if readInst(c.Sections[0], 0) != cast(uint32, 0xD17FFC20) {
		return fail("ADD #-0xFFFFFF should lower to SUB #0xFFFFFF")
	}
	if readInst(c.Sections[0], 4) != cast(uint32, 0xD13FFC00) {
		return fail("ADD #-0xFFFFFF second word wrong")
	}
	return ""
}

// An over-range NEGATIVE immediate must fail loud (not recurse forever via the
// Add<->Sub negation, which is the path that also guards the most-negative value).
func TestAddNegImmOverRangeFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Imm(0 - 0x1000000)) // magnitude one past the max
	if !a.HasError {
		return fail("over-range negative ADD should set HasError")
	}
	return ""
}

// The flag-setting SUBS also fails loud on a negative immediate (no op-swap, as
// that would change NZCV), and both ADDS/SUBS fail loud when over-range.
func TestSubsNegAndOverRangeFailLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Subs(a, true, X0, X1, Imm(0 - 16))
	if !a.HasError { return fail("negative SUBS immediate should set HasError") }

	var b @asm.Assembler = newAsm()
	Adds(b, true, X0, X1, Imm(0x1000000))
	if !b.HasError { return fail("over-range ADDS immediate should set HasError") }
	return ""
}

// --- Logical (bitmask) immediates ---

// u64 builds a 64-bit value from its high and low 32-bit halves, so a test can
// spell any 64-bit immediate without depending on the host's int width.
func u64(hi uint32, lo uint32) uint64 {
	return (cast(uint64, hi) << 32) | cast(uint64, lo)
}

// emitLogicalOp emits one of the logical-immediate instructions, selected by
// which: 0=AND X0,X1  1=ORR X0,X1  2=EOR X0,X1  3=ANDS X0,X1  4=TST X0.
func emitLogicalOp(a @asm.Assembler, which int, sf bool, op Operand) {
	if which == 0 { And(a, sf, X0, X1, op) }
	if which == 1 { Orr(a, sf, X0, X1, op) }
	if which == 2 { Eor(a, sf, X0, X1, op) }
	if which == 3 { Ands(a, sf, X0, X1, op) }
	if which == 4 { Tst(a, sf, X0, op) }
}

// logicalImmRejected reports whether logical instruction `which` fails loud on
// op: it sets an assembler error and emits no bytes.
func logicalImmRejected(which int, sf bool, op Operand) bool {
	var a @asm.Assembler = newAsm()
	emitLogicalOp(a, which, sf, op)
	return a.HasError && a.Sections[0].Len == 0
}

// An immediate that is not a bitmask pattern must fail loud for every logical
// instruction at both widths — never be dropped silently or mis-encoded.
func TestLogicalImmUnencodableFailsLoud() testing.TestResult {
	if !logicalImmRejected(0, true, Imm(5)) { return fail("AND X #5 should fail loud") }
	if !logicalImmRejected(0, false, Imm(5)) { return fail("AND W #5 should fail loud") }
	if !logicalImmRejected(1, true, Imm(5)) { return fail("ORR X #5 should fail loud") }
	if !logicalImmRejected(1, false, Imm(5)) { return fail("ORR W #5 should fail loud") }
	if !logicalImmRejected(2, true, Imm(5)) { return fail("EOR X #5 should fail loud") }
	if !logicalImmRejected(2, false, Imm(5)) { return fail("EOR W #5 should fail loud") }
	if !logicalImmRejected(3, true, Imm(5)) { return fail("ANDS X #5 should fail loud") }
	if !logicalImmRejected(3, false, Imm(5)) { return fail("ANDS W #5 should fail loud") }
	if !logicalImmRejected(4, true, Imm(5)) { return fail("TST X #5 should fail loud") }
	if !logicalImmRejected(4, false, Imm(5)) { return fail("TST W #5 should fail loud") }
	return ""
}

// Zero and all-ones have no bitmask encoding at either width (the W-form
// all-ones is 0xFFFFFFFF, whether given zero- or sign-extended).
func TestLogicalImmZeroAndAllOnesFailLoud() testing.TestResult {
	if !logicalImmRejected(0, true, Imm(0)) { return fail("AND X #0 should fail loud") }
	if !logicalImmRejected(0, false, Imm(0)) { return fail("AND W #0 should fail loud") }
	if !logicalImmRejected(1, true, Imm(0 - 1)) { return fail("ORR X #-1 should fail loud") }
	if !logicalImmRejected(1, false, Imm(0 - 1)) { return fail("ORR W #-1 should fail loud") }
	if !logicalImmRejected(2, false, ImmU64(u64(0, 0xFFFFFFFF))) {
		return fail("EOR W #0xFFFFFFFF should fail loud")
	}
	return ""
}

// A non-immediate, non-register operand kind (e.g. a memory operand) has no
// logical-instruction encoding and must fail loud.
func TestLogicalOpBadOperandFailsLoud() testing.TestResult {
	if !logicalImmRejected(0, true, MemImm(X2, 8)) { return fail("AND X, [mem] should fail loud") }
	if !logicalImmRejected(3, false, MemImm(X2, 8)) { return fail("ANDS W, [mem] should fail loud") }
	if !logicalImmRejected(4, true, Label("L")) { return fail("TST X, label should fail loud") }
	return ""
}

// The W form accepts an immediate only when bits [63:32] are all zero or all
// one (clang's rule).  0x100000001 must NOT assemble as `and w0, w1, #1`; the
// same value is a valid 64-bit bitmask (0x00000001 repeating every 32 bits).
func TestLogicalImmW32MixedHighHalfRejected() testing.TestResult {
	if !logicalImmRejected(0, false, ImmU64(u64(1, 1))) {
		return fail("AND W #0x100000001 should fail loud")
	}
	if !logicalImmRejected(4, false, ImmU64(u64(1, 1))) {
		return fail("TST W #0x100000001 should fail loud")
	}
	if !logicalImmRejected(1, false, ImmU64(u64(0x80000000, 1))) {
		return fail("ORR W #0x8000000000000001 should fail loud")
	}
	var a @asm.Assembler = newAsm()
	And(a, true, X0, X1, ImmU64(u64(1, 1))) // and x0, x1, #0x100000001
	if a.HasError { return fail("AND X #0x100000001 should be encodable") }
	if readInst(a.Sections[0], 0) != cast(uint32, 0x92000020) {
		return fail("AND X0, X1, #0x100000001 encoding wrong")
	}
	return ""
}

// An all-ones high half is accepted in the W form and encodes the low word:
// `and w0, w1, #0xFFFFFFFF0000000F` is the same instruction as `#0xF`.
func TestLogicalImmW32AllOnesHighHalfAccepted() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, false, X0, X1, ImmU64(u64(0xFFFFFFFF, 0xF)))
	And(a, false, X0, X1, Imm(0xF))
	And(a, false, X0, X1, Imm(0 - 16)) // and w0, w1, #-16
	if a.HasError { return fail("W-form all-ones-high immediates should be encodable") }
	if readInst(a.Sections[0], 0) != cast(uint32, 0x12000C20) {
		return fail("AND W0, W1, #0xFFFFFFFF0000000F should encode as #0xF")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x12000C20) {
		return fail("AND W0, W1, #0xF encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x121C6C20) {
		return fail("AND W0, W1, #-16 encoding wrong")
	}
	return ""
}

// Golden words from clang for each logical instruction at both widths, with a
// spread of element sizes, rotations, and registers.
func TestLogicalImmClangGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	And(a, true, X0, X1, Imm(0xFF))
	And(a, false, X0, X1, Imm(0xFF))
	Tst(a, true, X0, Imm(15))
	Tst(a, false, X0, Imm(15))
	Orr(a, true, X0, X1, ImmU64(u64(0x80000000, 0)))
	Orr(a, false, X0, X1, ImmU64(u64(0, 0x80000000)))
	Eor(a, true, X0, X1, ImmU64(u64(0x55555555, 0x55555555)))
	Eor(a, false, X0, X1, Imm(0x55555555))
	Ands(a, true, X0, X1, Imm(0xFF00))
	Ands(a, false, X0, X1, Imm(0xFF00))
	Orr(a, true, X3, X7, ImmU64(u64(0x0000FFFF, 0x0000FFFF)))
	Eor(a, false, X9, X10, Imm(0x7FFFFFFE))
	Ands(a, true, X2, X5, ImmU64(u64(0xFFFFFFFF, 0xFFFFFFFE)))
	Tst(a, true, X3, ImmU64(u64(0xF0F0F0F0, 0xF0F0F0F0)))
	Tst(a, false, X3, Imm(0x0FF00FF0))
	if a.HasError { return fail("valid logical immediates should not error") }
	if a.Sections[0].Len != 60 { return fail("expected 15 instructions") }
	var s @asm.Section = a.Sections[0]
	if readInst(s, 0) != cast(uint32, 0x92401C20) { return fail("and x0, x1, #0xff") }
	if readInst(s, 4) != cast(uint32, 0x12001C20) { return fail("and w0, w1, #0xff") }
	if readInst(s, 8) != cast(uint32, 0xF2400C1F) { return fail("tst x0, #15") }
	if readInst(s, 12) != cast(uint32, 0x72000C1F) { return fail("tst w0, #15") }
	if readInst(s, 16) != cast(uint32, 0xB2410020) { return fail("orr x0, x1, #1<<63") }
	if readInst(s, 20) != cast(uint32, 0x32010020) { return fail("orr w0, w1, #0x80000000") }
	if readInst(s, 24) != cast(uint32, 0xD200F020) { return fail("eor x0, x1, #0x5555...") }
	if readInst(s, 28) != cast(uint32, 0x5200F020) { return fail("eor w0, w1, #0x55555555") }
	if readInst(s, 32) != cast(uint32, 0xF2781C20) { return fail("ands x0, x1, #0xff00") }
	if readInst(s, 36) != cast(uint32, 0x72181C20) { return fail("ands w0, w1, #0xff00") }
	if readInst(s, 40) != cast(uint32, 0xB2003CE3) { return fail("orr x3, x7, #0xffff0000ffff") }
	if readInst(s, 44) != cast(uint32, 0x521F7549) { return fail("eor w9, w10, #0x7ffffffe") }
	if readInst(s, 48) != cast(uint32, 0xF27FF8A2) { return fail("ands x2, x5, #-2") }
	if readInst(s, 52) != cast(uint32, 0xF204CC7F) { return fail("tst x3, #0xf0f0...") }
	if readInst(s, 56) != cast(uint32, 0x720C9C7F) { return fail("tst w3, #0x0ff00ff0") }
	return ""
}

// logicalFitsAgrees checks one immediate at one width against clang: want is
// clang's `and x0/w0, x1/w1, #v` word, or 0 if clang rejects v.  LogicalImmFits
// must return exactly clang's accept/reject decision, AND must emit exactly
// clang's word (or fail loud with no bytes), and ORR/EOR/ANDS/TST must make
// the same accept/reject decision as AND.
func logicalFitsAgrees(sf bool, v uint64, want uint32) bool {
	var fits bool = want != cast(uint32, 0)
	if LogicalImmFits(sf, bit_cast(int64, v)) != fits { return false }
	var a @asm.Assembler = newAsm()
	And(a, sf, X0, X1, ImmU64(v))
	if fits {
		if a.HasError || a.Sections[0].Len != 4 { return false }
		if readInst(a.Sections[0], 0) != want { return false }
	} else if !a.HasError || a.Sections[0].Len != 0 {
		return false
	}
	for which := 1; which < 5; which++ {
		if logicalImmRejected(which, sf, ImmU64(v)) == fits { return false }
	}
	return true
}

// LogicalImmFits and the encoder agree with clang's accept/reject decision and
// encoding across a table of values at both widths.
func TestLogicalImmFitsAgreesWithEncoder() testing.TestResult {
	if !logicalFitsAgrees(true, u64(0, 5), 0) { return fail("X #5") }
	if !logicalFitsAgrees(false, u64(0, 5), 0) { return fail("W #5") }
	if !logicalFitsAgrees(true, u64(0, 0), 0) { return fail("X #0") }
	if !logicalFitsAgrees(false, u64(0, 0), 0) { return fail("W #0") }
	if !logicalFitsAgrees(true, u64(0xFFFFFFFF, 0xFFFFFFFF), 0) { return fail("X #-1") }
	if !logicalFitsAgrees(false, u64(0xFFFFFFFF, 0xFFFFFFFF), 0) { return fail("W #-1") }
	if !logicalFitsAgrees(true, u64(0, 0xFF), 0x92401C20) { return fail("X #0xff") }
	if !logicalFitsAgrees(false, u64(0, 0xFF), 0x12001C20) { return fail("W #0xff") }
	if !logicalFitsAgrees(true, u64(0, 0x1234), 0) { return fail("X #0x1234") }
	if !logicalFitsAgrees(false, u64(0, 0x1234), 0) { return fail("W #0x1234") }
	if !logicalFitsAgrees(true, u64(1, 1), 0x92000020) { return fail("X #0x100000001") }
	if !logicalFitsAgrees(false, u64(1, 1), 0) { return fail("W #0x100000001") }
	if !logicalFitsAgrees(true, u64(0xFFFFFFFF, 0xF), 0x92608C20) {
		return fail("X #0xFFFFFFFF0000000F")
	}
	if !logicalFitsAgrees(false, u64(0xFFFFFFFF, 0xF), 0x12000C20) {
		return fail("W #0xFFFFFFFF0000000F")
	}
	if !logicalFitsAgrees(true, u64(0, 0xFFFFFFFF), 0x92407C20) { return fail("X #0xffffffff") }
	if !logicalFitsAgrees(false, u64(0, 0xFFFFFFFF), 0) { return fail("W #0xffffffff") }
	if !logicalFitsAgrees(true, u64(0xFFFFFFFF, 0), 0x92607C20) {
		return fail("X #0xffffffff00000000")
	}
	if !logicalFitsAgrees(false, u64(0xFFFFFFFF, 0), 0) { return fail("W #0xffffffff00000000") }
	if !logicalFitsAgrees(true, u64(0x7FFFFFFF, 1), 0) { return fail("X #0x7fffffff00000001") }
	if !logicalFitsAgrees(false, u64(0x7FFFFFFF, 1), 0) { return fail("W #0x7fffffff00000001") }
	if !logicalFitsAgrees(true, u64(0x80000000, 1), 0x92410420) {
		return fail("X #0x8000000000000001")
	}
	if !logicalFitsAgrees(false, u64(0x80000000, 1), 0) { return fail("W #0x8000000000000001") }
	if !logicalFitsAgrees(true, u64(0xFFFF, 0xFFFF), 0x92003C20) {
		return fail("X #0x0000ffff0000ffff")
	}
	if !logicalFitsAgrees(false, u64(0xFFFF, 0xFFFF), 0) { return fail("W #0x0000ffff0000ffff") }
	if !logicalFitsAgrees(true, u64(0xFFFFFFFF, 0x7FFFFFFF), 0x9260F820) {
		return fail("X #0xffffffff7fffffff")
	}
	if !logicalFitsAgrees(false, u64(0xFFFFFFFF, 0x7FFFFFFF), 0x12007820) {
		return fail("W #0xffffffff7fffffff")
	}
	if !logicalFitsAgrees(true, u64(0, 0x80000000), 0x92610020) { return fail("X #0x80000000") }
	if !logicalFitsAgrees(false, u64(0, 0x80000000), 0x12010020) { return fail("W #0x80000000") }
	if !logicalFitsAgrees(true, u64(0xFFFFFFFF, 0xFFFFFFF0), 0x927CEC20) { return fail("X #-16") }
	if !logicalFitsAgrees(false, u64(0xFFFFFFFF, 0xFFFFFFF0), 0x121C6C20) {
		return fail("W #-16")
	}
	if !logicalFitsAgrees(true, u64(0x55555555, 0x55555555), 0x9200F020) {
		return fail("X #0x5555555555555555")
	}
	if !logicalFitsAgrees(false, u64(0x55555555, 0x55555555), 0) {
		return fail("W #0x5555555555555555")
	}
	if !logicalFitsAgrees(true, u64(0, 0xAAAAAAAA), 0) { return fail("X #0xaaaaaaaa") }
	if !logicalFitsAgrees(false, u64(0, 0xAAAAAAAA), 0x1201F020) { return fail("W #0xaaaaaaaa") }
	if !logicalFitsAgrees(true, u64(0, 0xFFFFFFFE), 0x927F7820) { return fail("X #0xfffffffe") }
	if !logicalFitsAgrees(false, u64(0, 0xFFFFFFFE), 0x121F7820) { return fail("W #0xfffffffe") }
	if !logicalFitsAgrees(true, u64(0xFFFFFFFF, 0x80000000), 0x92618020) {
		return fail("X #0xffffffff80000000")
	}
	if !logicalFitsAgrees(false, u64(0xFFFFFFFF, 0x80000000), 0x12010020) {
		return fail("W #0xffffffff80000000")
	}
	if !logicalFitsAgrees(true, u64(0xFFFFFFFE, 0), 0x925F7820) {
		return fail("X #0xfffffffe00000000")
	}
	if !logicalFitsAgrees(false, u64(0xFFFFFFFE, 0), 0) { return fail("W #0xfffffffe00000000") }
	if !logicalFitsAgrees(true, u64(0, 3), 0x92400420) { return fail("X #3") }
	if !logicalFitsAgrees(false, u64(0, 3), 0x12000420) { return fail("W #3") }
	if !logicalFitsAgrees(true, u64(0xC0000000, 3), 0x92420C20) {
		return fail("X #0xc000000000000003")
	}
	if !logicalFitsAgrees(false, u64(0xC0000000, 3), 0) { return fail("W #0xc000000000000003") }
	return ""
}
