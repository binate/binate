package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Branches to an already-known target: offset is the byte distance from the branch
// instruction itself to its target (negative for a backward branch), a multiple of 4.
// The displacement is encoded on the spot, so — unlike the label forms — no fixup is
// recorded and nothing is left for Finalize to resolve.  An offset outside the
// instruction's reach is reported on the assembler.

// BOffset emits B to offset (within +/-128MB).
func BOffset(a @asm.Assembler, offset int) {
	isa.BranchOffset(a, false, offset)
}

// BlOffset emits BL to offset (within +/-128MB).
func BlOffset(a @asm.Assembler, offset int) {
	isa.BranchOffset(a, true, offset)
}

// BcondOffset emits B.cond (a COND_* condition) to offset (within +/-1MB).
func BcondOffset(a @asm.Assembler, cond int, offset int) {
	isa.CondBranchOffset(a, cond, offset)
}

// CbzOffset emits CBZ of Rt (an X register when sf, else W) to offset (within +/-1MB).
func CbzOffset(a @asm.Assembler, sf bool, rt int, offset int) {
	isa.CompareBranchOffset(a, false, sf, zrReg(a, rt), offset)
}

// CbnzOffset emits CBNZ of Rt (an X register when sf, else W) to offset (within
// +/-1MB).
func CbnzOffset(a @asm.Assembler, sf bool, rt int, offset int) {
	isa.CompareBranchOffset(a, true, sf, zrReg(a, rt), offset)
}

// TbzOffset emits TBZ testing bit (0-63) of Rt to offset (within +/-32KB).
func TbzOffset(a @asm.Assembler, rt int, bit int, offset int) {
	isa.TestBranchOffset(a, false, zrReg(a, rt), bit, offset)
}

// TbnzOffset emits TBNZ testing bit (0-63) of Rt to offset (within +/-32KB).
func TbnzOffset(a @asm.Assembler, rt int, bit int, offset int) {
	isa.TestBranchOffset(a, true, zrReg(a, rt), bit, offset)
}
