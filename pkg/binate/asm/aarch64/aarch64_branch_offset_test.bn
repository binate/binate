package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Goldens (from clang) for the branches to a resolved offset, backward and forward;
// none records a fixup.

func TestBranchOffsetGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BOffset(a, -12)
	BlOffset(a, -16)
	BcondOffset(a, COND_NE, -20)
	CbzOffset(a, true, X3, -24)
	CbnzOffset(a, false, X5, -28)
	TbzOffset(a, X7, 40, -32)
	TbnzOffset(a, X2, 3, -36)
	BOffset(a, 12)
	BcondOffset(a, COND_PL, 8)
	var want @[]uint32 = make_slice(uint32, 9)
	want[0] = 0x17FFFFFD // b    #-12
	want[1] = 0x97FFFFFC // bl   #-16
	want[2] = 0x54FFFF61 // b.ne #-20
	want[3] = 0xB4FFFF43 // cbz  x3, #-24
	want[4] = 0x35FFFF25 // cbnz w5, #-28
	want[5] = 0xB647FF07 // tbz  x7, #40, #-32
	want[6] = 0x371FFEE2 // tbnz w2, #3, #-36
	want[7] = 0x14000003 // b    #12
	want[8] = 0x54000045 // b.pl #8
	if a.HasError || a.Sections[0].NumFixups != 0 {
		return fail("offset branches must encode without an error or a fixup")
	}
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] {
			return fail("offset branch encoding wrong")
		}
	}
	return ""
}

// An offset that is not a multiple of 4, or beyond the instruction's reach, fails loud.
func TestBranchOffsetRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BOffset(a, 6)
	if !failedLoud(a) { return fail("B to a non-multiple of 4 should error") }
	a = newAsm()
	BcondOffset(a, COND_EQ, 1 << 20)
	if !failedLoud(a) { return fail("B.cond past +1MB should error") }
	a = newAsm()
	CbzOffset(a, true, X0, -(1 << 20) - 4)
	if !failedLoud(a) { return fail("CBZ past -1MB should error") }
	a = newAsm()
	TbnzOffset(a, X0, 1, 1 << 15)
	if !failedLoud(a) { return fail("TBNZ past +32KB should error") }
	return ""
}
