// --- Test and branch ---

func TestTbz() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// TBZ W0, #3, skip — bit 3, forward 8 bytes → imm14 = 2
	Tbz(a, X0, 3, "skip")
	Nop(a)
	a.DefineLabel("skip")
	Nop(a)

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	// TBZ: b5=0, 011011|0|b40=00011|imm14=2|Rt=0
	// = 0x36180040
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x36180040 {
		return fail("TBZ fixup encoding wrong")
	}
	return ""
}

// --- Branch fixup tests ---

func TestBranchForward() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// B target at offset 0, target at offset 8 → PC-relative = +8, imm26 = 2
	B(a, "target")                // offset 0: B target (placeholder)
	Nop(a)                         // offset 4: NOP
	a.DefineLabel("target")   // offset 8
	Nop(a)                         // offset 8: NOP

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	if a.NumRelocs != 0 { return fail("expected 0 relocations (branch should be resolved)") }

	// B instruction at offset 0 should now have imm26 = 2 (offset +8, /4 = 2)
	// B opcode = 0x14000000, imm26 = 2 → 0x14000002
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x14000002 {
		return fail("B forward encoding wrong after fixup")
	}
	return ""
}

func TestBranchBackward() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// target at offset 0, B target at offset 8 → PC-relative = -8, imm26 = -2
	a.DefineLabel("loop")
	Nop(a)                         // offset 0: NOP
	Nop(a)                         // offset 4: NOP
	B(a, "loop")                   // offset 8: B loop

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	if a.NumRelocs != 0 { return fail("expected 0 relocations") }

	// B at offset 8, target at offset 0 → PC-relative = -8, imm26 = -2
	// -2 in 26-bit = 0x03FFFFFE, OR'd with B opcode 0x14000000
	// = 0x17FFFFFE
	var inst uint32 = readInst(a.Sections[0], 8)
	if inst != 0x17FFFFFE {
		return fail("B backward encoding wrong after fixup")
	}
	return ""
}

func TestBcondFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// B.EQ to forward label, offset 0 → 8, PC-relative = +8, imm19 = 2
	Bcond(a, COND_EQ, "skip")     // offset 0
	Nop(a)                         // offset 4
	a.DefineLabel("skip")     // offset 8
	Nop(a)                         // offset 8

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	if a.NumRelocs != 0 { return fail("expected 0 relocations") }

	// B.EQ opcode = 0x54000000 | cond(0), imm19 = 2 → bits [23:5] = 2
	// = 0x54000040
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x54000040 {
		return fail("B.EQ fixup encoding wrong")
	}
	return ""
}

func TestCbzFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CBZ X0, skip: offset 0 → 8, imm19 = 2
	Cbz(a, true, X0, "skip")      // offset 0
	Nop(a)                          // offset 4
	a.DefineLabel("skip")      // offset 8
	Nop(a)                          // offset 8

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }

	// CBZ X0 = sf(1)|0110100|imm19|Rt(0) = 0xB4000000 | (2 << 5) = 0xB4000040
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xB4000040 {
		return fail("CBZ fixup encoding wrong")
	}
	return ""
}

func TestExternalSymbolReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// Branch to an undefined (external) symbol — should become a relocation
	a.SetGlobal("external_func")
	Bl(a, "external_func")

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	if a.NumRelocs != 1 { return fail("expected 1 relocation for external branch") }
	return ""
}

// --- Sequence test: simple function prologue/epilogue ---

func TestPrologueEpilogue() testing.TestResult {
	var a @asm.Assembler = newAsm()

	// Function prologue
	Stp(a, true, FP, LR, MemPre(SP, -16))  // stp x29, x30, [sp, #-16]!
	Mov(a, true, FP, Reg(SP))               // mov x29, sp

	// Function body: just a NOP
	Nop(a)

	// Function epilogue
	Ldp(a, true, FP, LR, MemPost(SP, 16))   // ldp x29, x30, [sp], #16
	Ret(a)                                    // ret

	var s @asm.Section = a.Sections[0]
	if s.Len != 20 { return fail("expected 20 bytes (5 instructions)") }

	// Verify each instruction
	if readInst(s, 0) != 0xA9BF7BFD { return fail("stp wrong") }
	// MOV X29, SP = ADD X29, SP, #0 (because reg 31 in ORR Rm is XZR, not SP)
	// ADD X29, SP, #0 = 1|00|100010|0|000000000000|11111|11101 = 0x910003FD
	var movInst uint32 = readInst(s, 4)
	if movInst != 0x910003FD { return fail("mov x29, sp encoding wrong") }

	if readInst(s, 8) != 0xD503201F { return fail("nop wrong") }
	if readInst(s, 12) != 0xA8C17BFD { return fail("ldp wrong") }
	if readInst(s, 16) != 0xD65F03C0 { return fail("ret wrong") }

	return ""
}

// Adrp must emit an ADRP encoding (op=1, bit 31 set), not ADR.
// Native codegen depends on this — strings live in __cstring
// (cross-section), and only ADRP+ADD pairs round-trip through ld
// for cross-section addresses (Mach-O has no ADR reloc).
func TestAdrpEmitsAdrpEncoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adrp(a, X0, "lab")
	var inst uint32 = readInst(a.Sections[0], 0)
	if (inst & 0x80000000) == 0 {
		return fail("Adrp must emit ADRP (bit 31 = 1), not ADR")
	}
	if (inst & 0x1F000000) != 0x10000000 {
		return fail("Adrp must emit the 10000 fixed opcode bits")
	}
	return ""
}

// Adr must emit an ADR encoding (op=0, bit 31 clear). Pair with the
// ADRP test so a regression that swaps Adr/Adrp is caught.
func TestAdrEmitsAdrEncoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adr(a, X0, "lab")
	var inst uint32 = readInst(a.Sections[0], 0)
	if (inst & 0x80000000) != 0 {
		return fail("Adr must emit ADR (bit 31 = 0), not ADRP")
	}
	if (inst & 0x1F000000) != 0x10000000 {
		return fail("Adr must emit the 10000 fixed opcode bits")
	}
	return ""
}

// ResolveFixups must error out when a same-section PC-relative
// fixup can't be patched in range. Before the hardening, an
// out-of-range ADR fixup leaked silently into Finalize as a
// FIX_ADR_LO21 reloc, which the macho writer mismapped to PAGE21
// — yielding the confusing
//   ld: ARM64_RELOC_PAGE21 relocation on non-ADRP instruction
// error seen on pkg/binate/ir.  Enforce the local range now so the
// --- LDRSB / LDRSH encoding tests ---
//
// Pin the sf-flag → X-form vs W-form mapping for the sign-extending
// sub-word loads.  Pre-fix the branches were swapped: sf=true emitted
// the W-form (sign-ext to 32, zero-fill upper 32) instead of the
// X-form (sign-ext to 64).  In a 64-bit ALU/comparison context the
// W-form gave a positive value for any negative narrow int — fully
// breaking `i8 < 0` etc.  See conformance 416_narrow_int_sign_ext.

// LDRSB X9, [SP, #0]  (X-form, sign-extend byte to 64-bit dest):
//   00|111001|10|000000000000|11111|01001
//   = 0x39800000 | (31<<5) | 9
//   = 0x398003E9
func TestLdrsbXForm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsb(a, true, X9, MemImm(SP, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x398003E9) {
		return fail("LDRSB X9, [SP, #0] encoding wrong (sf=true must select X-form)")
	}
	return ""
}

// LDRSB W9, [SP, #0]  (W-form, sign-extend byte to 32-bit dest):
//   00|111001|11|000000000000|11111|01001
//   = 0x39C00000 | (31<<5) | 9
//   = 0x39C003E9
func TestLdrsbWForm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsb(a, false, X9, MemImm(SP, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x39C003E9) {
		return fail("LDRSB W9, [SP, #0] encoding wrong (sf=false must select W-form)")
	}
	return ""
}

// LDRSH X9, [SP, #0]  (X-form, sign-extend halfword to 64-bit dest):
//   01|111001|10|000000000000|11111|01001
//   = 0x79800000 | (31<<5) | 9
//   = 0x798003E9
func TestLdrshXForm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsh(a, true, X9, MemImm(SP, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x798003E9) {
		return fail("LDRSH X9, [SP, #0] encoding wrong (sf=true must select X-form)")
	}
	return ""
}

// LDRSH W9, [SP, #0]  (W-form):
//   01|111001|11|000000000000|11111|01001
//   = 0x79C00000 | (31<<5) | 9
//   = 0x79C003E9
func TestLdrshWForm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsh(a, false, X9, MemImm(SP, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x79C003E9) {
		return fail("LDRSH W9, [SP, #0] encoding wrong (sf=false must select W-form)")
	}
	return ""
}

// LDRSB's imm12 isn't scaled — encodable range 0..4095.  0x1158 = 4440
// exceeds it, so the address must be materialized into X17 (ADD X17,
// SP, #0x1158 — 2 ADDs since hi=1, lo=0x158 — then LDRSB X9, [X17]).
// Pre-fix the signed sub-word loads masked the offset to 12 bits
// (0x1158 & 0xfff = 0x158) with no overflow handling, so a signed
// sub-word local in a large frame loaded from the wrong slot — the
// shift-typepair int8/int16 native-aa64 miscompile.
func TestLdrsbImmOverflowMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsb(a, true, X9, MemImm(SP, 0x1158))
	if a.Sections[0].Len != 12 {
		return fail("LDRSB overflow offset should ADD twice + LDRSB (12 bytes)")
	}
	// Final instruction: LDRSB X9, [X17, #0] (X-form, base now X17).
	var inst uint32 = readInst(a.Sections[0], 8)
	if inst != cast(uint32, 0x39800229) {
		return fail("LDRSB overflow tail must be LDRSB X9, [X17] (X-form)")
	}
	return ""
}

// LDRSH scales imm12 by 2 — encodable range 0..8190.  0x4158 = 16728
// (/2 = 8364 > 4095) exceeds it and must materialize via X17.
func TestLdrshImmOverflowMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsh(a, true, X9, MemImm(SP, 0x4158))
	if a.Sections[0].Len != 12 {
		return fail("LDRSH overflow offset should ADD twice + LDRSH (12 bytes)")
	}
	// Final instruction: LDRSH X9, [X17, #0] (X-form, base now X17).
	var inst uint32 = readInst(a.Sections[0], 8)
	if inst != cast(uint32, 0x79800229) {
		return fail("LDRSH overflow tail must be LDRSH X9, [X17] (X-form)")
	}
	return ""
}

// LDRSW scales imm12 by 4 — encodable range 0..16380.  0x8158 = 33112
// (/4 = 8278 > 4095) exceeds it and must materialize via X17.
func TestLdrswImmOverflowMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsw(a, X9, MemImm(SP, 0x8158))
	if a.Sections[0].Len != 12 {
		return fail("LDRSW overflow offset should ADD twice + LDRSW (12 bytes)")
	}
	// Final instruction: LDRSW X9, [X17, #0] (base now X17).
	var inst uint32 = readInst(a.Sections[0], 8)
	if inst != cast(uint32, 0xB9800229) {
		return fail("LDRSW overflow tail must be LDRSW X9, [X17]")
	}
	return ""
}

// Boundary: 4095 is the LARGEST byte offset that still fits LDRSB's
// imm12, so it must encode inline (one 4-byte instruction, no X17
// materialization) as LDRSB X9, [SP, #0xfff]:
//   0x39800000 | (4095<<10) | (31<<5) | 9 = 0x39BFFFE9.
// Paired with TestLdrsbImmJustOverRangeMaterializes this pins the
// `(imm/scale) > 4095` threshold against an off-by-one (a `>=` there
// would push 4095 onto the materialization path).
func TestLdrsbImmMaxInRangeInline() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsb(a, true, X9, MemImm(SP, 4095))
	if a.Sections[0].Len != 4 {
		return fail("LDRSB at offset 4095 should encode inline (4 bytes)")
	}
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != cast(uint32, 0x39BFFFE9) {
		return fail("LDRSB X9, [SP, #0xfff] encoding wrong")
	}
	return ""
}

// Boundary: 4096 is the first offset past LDRSB's imm12 range, so it
// must materialize (more than one instruction) rather than wrap to
// `4096 & 0xfff == 0` and silently emit LDRSB X9, [SP, #0] — the
// original bug.  Len != 4 distinguishes "materialized" from "wrapped to
// a single instruction" without pinning the exact ADD-split count.
func TestLdrsbImmJustOverRangeMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsb(a, true, X9, MemImm(SP, 4096))
	if a.Sections[0].Len == 4 {
		return fail("LDRSB at offset 4096 must materialize, not wrap to [SP, #0]")
	}
	return ""
}

// The W-form (sf=false) overflow path threads a different opc through
// ldrStrSubWordEmit; confirm the materialization tail is the W-form
// LDRSB W9, [X17, #0] = 0x39C00000 | (17<<5) | 9 = 0x39C00229 (vs the
// X-form 0x39800229).  The native backend only emits the X-form, so
// this guards the asm library's own W-form correctness.
func TestLdrsbWFormOverflowMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsb(a, false, X9, MemImm(SP, 0x1158))
	if a.Sections[0].Len != 12 {
		return fail("LDRSB W-form overflow should ADD twice + LDRSB (12 bytes)")
	}
	var inst uint32 = readInst(a.Sections[0], 8)
	if inst != cast(uint32, 0x39C00229) {
		return fail("LDRSB W-form overflow tail must be LDRSB W9, [X17]")
	}
	return ""
}

// failure surfaces at the assembler level instead.
func TestResolveFixupsAdrOutOfRangeIsError() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adr(a, X0, "far")  // 4 bytes at offset 0
	// Fill past ADR's ±1MB range: 262144 × 4 bytes = 1 MiB. With the
	// initial 4-byte ADR, the label lands at offset 0x100004 from
	// the ADR, just outside ±0xFFFFF.
	for i := 0; i < 262144; i++ {
		a.EmitUint32(0xD503201F)  // NOP
	}
	a.DefineLabel("far")

	if ResolveFixups(a) {
		return fail("ResolveFixups should fail for out-of-range ADR")
	}
	if !a.HasError {
		return fail("ResolveFixups should set HasError on out-of-range")
	}
	return ""
}
