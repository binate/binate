package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// AArch64 floating-point (scalar) instructions: GP↔FP moves, arithmetic, FNEG,
// FCMP, int↔float and single↔double conversion, and D/S-register loads and stores.
// FP operands are D0..D31 (V0..V31) and map through vReg; GP operands through
// zrReg (these instructions read GP register 31 as the zero register) — except a
// load/store base, which reads 31 as SP.

// --- FMOV (scalar, register and gp↔fp) ---

// Fmov_gp_to_fp: FMOV Dd, Xn.
// Encoding: 1|0|0|11110|01|1|00|111|000000|Rn|Rd = 0x9E670000
func Fmov_gp_to_fp(a @asm.Assembler, dd int, xn int) {
	emitRnRd(a, 0x9E670000, zrReg(a, xn), vReg(a, dd))
}

// Fmov_fp_to_gp: FMOV Xd, Dn.
// Encoding: 1|0|0|11110|01|1|00|110|000000|Rn|Rd = 0x9E660000
func Fmov_fp_to_gp(a @asm.Assembler, xd int, dn int) {
	emitRnRd(a, 0x9E660000, vReg(a, dn), zrReg(a, xd))
}

// Fmov_fp_to_fp: FMOV Dd, Dn.
// Encoding: 0|0|0|11110|01|1|0000|00|10000|Rn|Rd = 0x1E604000
func Fmov_fp_to_fp(a @asm.Assembler, dd int, dn int) {
	emitRnRd(a, 0x1E604000, vReg(a, dn), vReg(a, dd))
}

// --- Floating-point arithmetic (scalar, double) ---
//
// Format: 0|0|0|11110|ty|1|Rm|opc4|10|Rn|Rd
// ty=01 for double; opc selects the operation. See ARM ARM
// "Floating-point data-processing (2 source)".

// emitFPDataProc2 emits the 2-source FP op opc4 at the precision of base (0x1E600800
// double, 0x1E200800 single) on three FP registers.
func emitFPDataProc2(a @asm.Assembler, base uint32, opc4 uint32, dd int, dn int, dm int) {
	emitRmRnRd(a, base | (opc4 << 12), vReg(a, dm), vReg(a, dn), vReg(a, dd))
}

// FMUL: opc=0000 → 0x1E600800
func Fmul(a @asm.Assembler, dd int, dn int, dm int) {
	emitFPDataProc2(a, 0x1E600800, 0, dd, dn, dm)
}

// FDIV: opc=0001 → 0x1E601800
func Fdiv(a @asm.Assembler, dd int, dn int, dm int) {
	emitFPDataProc2(a, 0x1E600800, 1, dd, dn, dm)
}

// FADD: opc=0010 → 0x1E602800
func Fadd(a @asm.Assembler, dd int, dn int, dm int) {
	emitFPDataProc2(a, 0x1E600800, 2, dd, dn, dm)
}

// FSUB: opc=0011 → 0x1E603800
func Fsub(a @asm.Assembler, dd int, dn int, dm int) {
	emitFPDataProc2(a, 0x1E600800, 3, dd, dn, dm)
}

// --- Floating-point arithmetic (scalar, single / float32) ---
//
// Same format with ty=00 (base 0x1E200800 instead of the double's
// 0x1E600800).  float32 arithmetic must round at single precision, so it
// uses these on S registers rather than computing in double on the f32 bit
// pattern.

// FMUL (single): opc=0000 → 0x1E200800
func Fmul_s(a @asm.Assembler, sd int, sn int, sm int) {
	emitFPDataProc2(a, 0x1E200800, 0, sd, sn, sm)
}

// FDIV (single): opc=0001 → 0x1E201800
func Fdiv_s(a @asm.Assembler, sd int, sn int, sm int) {
	emitFPDataProc2(a, 0x1E200800, 1, sd, sn, sm)
}

// FADD (single): opc=0010 → 0x1E202800
func Fadd_s(a @asm.Assembler, sd int, sn int, sm int) {
	emitFPDataProc2(a, 0x1E200800, 2, sd, sn, sm)
}

// FSUB (single): opc=0011 → 0x1E203800
func Fsub_s(a @asm.Assembler, sd int, sn int, sm int) {
	emitFPDataProc2(a, 0x1E200800, 3, sd, sn, sm)
}

// --- Floating-point unary (1-source) ---
// Format: 0|0|0|11110|ty|1|0000|opc6|10000|Rn|Rd  for ty=01 (double).

// FNEG: opc=000010 → 0x1E614000
func Fneg(a @asm.Assembler, dd int, dn int) {
	emitRnRd(a, 0x1E614000, vReg(a, dn), vReg(a, dd))
}

// FNEG (single): the double encoding with ty=00 → 0x1E214000.  Flips a
// float32 sign bit; a double FNEG would flip bit 63, leaving the f32 sign
// (bit 31 of the value in the low half) untouched.
func Fneg_s(a @asm.Assembler, sd int, sn int) {
	emitRnRd(a, 0x1E214000, vReg(a, sn), vReg(a, sd))
}

// --- Floating-point compare ---
//
// FCMP Dn, Dm sets PSTATE.NZCV; pair with B.cond / Csinc.
// Encoding: 0|0|0|11110|01|1|Rm|001000|Rn|0|0|0|0|0 = 0x1E602000

func Fcmp(a @asm.Assembler, dn int, dm int) {
	emitRmRnRd(a, 0x1E602000, vReg(a, dm), vReg(a, dn), 0)
}

// Fcmp_s: FCMP Sn, Sm — single-precision compare (ty=00) → 0x1E202000.
// Sets the same NZCV flags as the double form, so the surrounding
// condition logic is shared; only the operand precision differs.
func Fcmp_s(a @asm.Assembler, sn int, sm int) {
	emitRmRnRd(a, 0x1E202000, vReg(a, sm), vReg(a, sn), 0)
}

// --- Conversion: int ↔ float ---

// Fcvtzs: FCVTZS Xd, Dn (round toward zero, signed 64-bit int).
// Encoding: 1|0|0|11110|01|1|11|000|000000|Rn|Rd = 0x9E780000
func Fcvtzs(a @asm.Assembler, xd int, dn int) {
	emitRnRd(a, 0x9E780000, vReg(a, dn), zrReg(a, xd))
}

// Fcvtzu: FCVTZU Xd, Dn (round toward zero, unsigned 64-bit int).
// Sibling of FCVTZS with opcode 001 instead of 000 (bit 16 set), so a
// double in [2^63, 2^64) truncates to the right large unsigned rather
// than the saturated signed result FCVTZS gives.
// Encoding: 1|0|0|11110|01|1|11|001|000000|Rn|Rd = 0x9E790000
func Fcvtzu(a @asm.Assembler, xd int, dn int) {
	emitRnRd(a, 0x9E790000, vReg(a, dn), zrReg(a, xd))
}

// Scvtf: SCVTF Dd, Xn (signed 64-bit int → double).
// Encoding: 1|0|0|11110|01|1|00|010|000000|Rn|Rd = 0x9E620000
func Scvtf(a @asm.Assembler, dd int, xn int) {
	emitRnRd(a, 0x9E620000, zrReg(a, xn), vReg(a, dd))
}

// Ucvtf: UCVTF Dd, Xn (unsigned 64-bit int → double).  Sibling of SCVTF
// with opcode 011 instead of 010 (bit 16 set), so a value with bit 63
// set converts to a large positive double rather than a negative one.
// Encoding: 1|0|0|11110|01|1|00|011|000000|Rn|Rd = 0x9E630000
func Ucvtf(a @asm.Assembler, dd int, xn int) {
	emitRnRd(a, 0x9E630000, zrReg(a, xn), vReg(a, dd))
}

// --- Width conversion (single ↔ double) ---
//
// FCVT is in "Floating-point data-processing (1 source)":
//   0|0|0|11110|ty|1|0001|opc2|10000|Rn|Rd
// For double→single: ty=01, opc=00 → 0x1E624000
// For single→double: ty=00, opc=01 → 0x1E22C000

// Fcvt_d_to_s narrows: FCVT Sd, Dn.
func Fcvt_d_to_s(a @asm.Assembler, sd int, dn int) {
	emitRnRd(a, 0x1E624000, vReg(a, dn), vReg(a, sd))
}

// Fcvt_s_to_d widens: FCVT Dd, Sn.
func Fcvt_s_to_d(a @asm.Assembler, dd int, sn int) {
	emitRnRd(a, 0x1E22C000, vReg(a, sn), vReg(a, dd))
}

// --- 32-bit GP↔FP move (S register / W register) ---

// Fmov_w_to_s: FMOV Sd, Wn (32-bit gp → 32-bit fp).
// Encoding: 0|0|0|11110|00|1|00|111|000000|Rn|Rd = 0x1E270000
func Fmov_w_to_s(a @asm.Assembler, sd int, wn int) {
	emitRnRd(a, 0x1E270000, zrReg(a, wn), vReg(a, sd))
}

// Fmov_s_to_w: FMOV Wd, Sn (32-bit fp → 32-bit gp). Zero-extends
// when read via LDR/X-register.
// Encoding: 0|0|0|11110|00|1|00|110|000000|Rn|Rd = 0x1E260000
func Fmov_s_to_w(a @asm.Assembler, wd int, sn int) {
	emitRnRd(a, 0x1E260000, vReg(a, sn), zrReg(a, wd))
}

// --- LDR/STR (SIMD&FP, 64-bit D and 32-bit S registers) ---
//
// The FP analogue of Ldr/Str: STR/LDR Dt (imm12 scaled by 8) and STR/LDR St (scaled
// by 4).  A float32 home keeps its value in the low 32 bits of the D register, so a
// full 64-bit D store/reload round-trips it losslessly; an f32 in memory is exactly
// 4 bytes, which the S forms access.

// Fstr_d: STR Dt, [base, #off] — store a 64-bit D register.
func Fstr_d(a @asm.Assembler, dt int, base int, off int) {
	emitFpLdrStr(a, isa.LS_STR_D, dt, base, off)
}

// Fldr_d: LDR Dt, [base, #off] — load a 64-bit D register.
func Fldr_d(a @asm.Assembler, dt int, base int, off int) {
	emitFpLdrStr(a, isa.LS_LDR_D, dt, base, off)
}

// Fstr_s: STR St, [base, #off] — store a 32-bit S (FP) register.
func Fstr_s(a @asm.Assembler, st int, base int, off int) {
	emitFpLdrStr(a, isa.LS_STR_S, st, base, off)
}

// Fldr_s: LDR St, [base, #off] — load a 32-bit S (FP) register.
func Fldr_s(a @asm.Assembler, st int, base int, off int) {
	emitFpLdrStr(a, isa.LS_LDR_S, st, base, off)
}

// emitFpLdrStr encodes an FP LDR/STR (an LS_* D or S spec) at [base, #off].  An
// offset that doesn't fit the scaled imm12 is added into the X17 scratch first, then
// accessed at [X17, #0] — mirroring emitLdrStr's GP overflow path (ft is an FP
// register, so it never conflicts with the X17 scratch).
func emitFpLdrStr(a @asm.Assembler, spec uint32, ft int, base int, off int) {
	var scale int = isa.LdStAccessBytes(spec)
	if off < 0 || off % scale != 0 || off / scale > 4095 {
		var ftf int = vReg(a, ft)
		if ftf < 0 || !formScratchAddr(a, base, off) { return }
		isa.LdStUImm(a, spec, ftf, X17, 0)
		return
	}
	isa.LdStUImm(a, spec, vReg(a, ft), spReg(a, base), off)
}

// --- LDR/STR (SIMD&FP, scaled register offset) ---
//
// The FP register-offset analogue of LdrswRegScaled, for folding a float a[i]
// element load/store into its addressing mode: `LDR Dt, [Xn, Xm, LSL #3]` (D, the
// index scaled by the 8-byte access size) / `LDR St, [Xn, Xm, LSL #2]` (S, scaled
// by 4).

// FldrRegScaled_d: LDR Dt, [base, index, lsl #3] — 64-bit D scaled register load.
func FldrRegScaled_d(a @asm.Assembler, dt int, base int, index int) {
	emitFpLdrStrRegScaled(a, isa.LS_LDR_D, dt, base, index)
}

// FstrRegScaled_d: STR Dt, [base, index, lsl #3] — 64-bit D scaled register store.
func FstrRegScaled_d(a @asm.Assembler, dt int, base int, index int) {
	emitFpLdrStrRegScaled(a, isa.LS_STR_D, dt, base, index)
}

// FldrRegScaled_s: LDR St, [base, index, lsl #2] — 32-bit S scaled register load.
func FldrRegScaled_s(a @asm.Assembler, st int, base int, index int) {
	emitFpLdrStrRegScaled(a, isa.LS_LDR_S, st, base, index)
}

// FstrRegScaled_s: STR St, [base, index, lsl #2] — 32-bit S scaled register store.
func FstrRegScaled_s(a @asm.Assembler, st int, base int, index int) {
	emitFpLdrStrRegScaled(a, isa.LS_STR_S, st, base, index)
}

// emitFpLdrStrRegScaled emits an FP register-offset LDR/STR (an LS_* D or S spec)
// whose X index is scaled by the access size.
func emitFpLdrStrRegScaled(a @asm.Assembler, spec uint32, ft int, base int, index int) {
	isa.LdStReg(a, spec, vReg(a, ft), spReg(a, base), zrReg(a, index), isa.EXT_LSL, true)
}
