package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// (newAsm() / readInst() are defined in aarch64_test.bn, same package;
// fail() in a sibling test file.)

// AdrpGot emits the same ADRP encoding as Adrp (only the relocation kind
// differs), plus a FIX_ADRP_GOT_HI21 fixup so the linker resolves it against
// the symbol's GOT-entry page rather than the symbol itself.
func TestAdrpGotEncoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AdrpGot(a, X0, "_environ")
	var inst uint32 = readInst(a.Sections[0], 0)
	if (inst & 0x80000000) == 0 {
		return fail("AdrpGot must emit ADRP (bit 31 = 1), not ADR")
	}
	if (inst & 0x1F000000) != 0x10000000 {
		return fail("AdrpGot must emit the 10000 fixed ADRP opcode bits")
	}
	if (inst & 0x1F) != cast(uint32, X0) {
		return fail("AdrpGot must target X0")
	}
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return fail("expected 1 fixup") }
	if s.Fixups[0].Kind != FIX_ADRP_GOT_HI21 { return fail("wrong fixup kind") }
	if cast(int, s.Fixups[0].Offset) != 0 { return fail("wrong fixup offset") }
	return ""
}

// LdrGotLo12 encodes a 64-bit LDR Xt, [base, #0] (a GOT slot is a pointer)
// and records a FIX_LD_GOT_LO12 fixup.  The encoding matches LdrImmLabel(sf=
// true) — LDR X0, [X1, #0] = 0xF9400020 — only the fixup kind differs.
func TestLdrGotLo12Encoding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdrGotLo12(a, X0, X1, "_environ")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF9400020 {
		return fail("LdrGotLo12 must encode 64-bit LDR X0, [X1, #0]")
	}
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 { return fail("expected 1 fixup") }
	if s.Fixups[0].Kind != FIX_LD_GOT_LO12 { return fail("wrong fixup kind") }
	if cast(int, s.Fixups[0].Offset) != 0 { return fail("wrong fixup offset") }
	return ""
}

// The GOT fixups are not same-section-resolvable — a GOT slot is always an
// external, cross-object reference — so ResolveFixups must leave them for
// Finalize to emit as relocations (mirroring the non-GOT ADRP+ADD/LDR path).
func TestGotFixupsLeftForLinker() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.SetGlobal("_environ")
	AdrpGot(a, X0, "_environ")
	LdrGotLo12(a, X0, X0, "_environ")

	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 2 { return fail("expected 2 fixups (ADRP-GOT, LDR-GOT)") }
	if cast(int, s.Fixups[0].Offset) != 0 { return fail("ADRP-GOT fixup offset") }
	if cast(int, s.Fixups[1].Offset) != 4 { return fail("LDR-GOT fixup offset") }

	ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("unexpected error") }
	// Both fixups become relocations (external — nothing resolvable in-section).
	if a.NumRelocs != 2 { return fail("expected 2 relocations") }
	return ""
}

// LdrImmLabel's fixup carries the load's access size: the 64-bit form records
// FIX_LDR_LO12 (imm12 in 8-byte units) and the 32-bit form FIX_LDST32_LO12 (4-byte
// units) — a 64-bit kind on a 32-bit load would have the linker scale by the wrong
// size.  Words: `ldr x1, [x0]` 0xF9400001, `ldr w1, [x0]` 0xB9400001.
func TestLdrImmLabelFixupPerWidth() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdrImmLabel(a, true, X1, X0, "g")
	LdrImmLabel(a, false, X1, X0, "g")
	var s @asm.Section = a.Sections[0]
	if a.HasError || s.NumFixups != 2 { return fail("expected two fixups, no error") }
	if readInst(s, 0) != 0xF9400001 || readInst(s, 4) != 0xB9400001 { return fail("words") }
	if s.Fixups[0].Kind != FIX_LDR_LO12 { return fail("64-bit load: FIX_LDR_LO12") }
	if s.Fixups[1].Kind != FIX_LDST32_LO12 { return fail("32-bit load: FIX_LDST32_LO12") }
	return ""
}
