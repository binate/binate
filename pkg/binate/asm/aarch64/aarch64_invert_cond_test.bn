package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// TestInvertCondPairs checks each condition below AL against the one A64
// defines as its inverse, both ways, and that InvertCond emits nothing.
func TestInvertCondPairs() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var pairs @[]int = make_slice(int, 14)
	pairs[0] = COND_EQ
	pairs[1] = COND_NE
	pairs[2] = COND_CS
	pairs[3] = COND_CC
	pairs[4] = COND_MI
	pairs[5] = COND_PL
	pairs[6] = COND_VS
	pairs[7] = COND_VC
	pairs[8] = COND_HI
	pairs[9] = COND_LS
	pairs[10] = COND_GE
	pairs[11] = COND_LT
	pairs[12] = COND_GT
	pairs[13] = COND_LE
	for i := 0; i < 14; i = i + 2 {
		if InvertCond(a, pairs[i]) != pairs[i + 1] || InvertCond(a, pairs[i + 1]) != pairs[i] {
			return fail("InvertCond does not pair a condition with its inverse")
		}
	}
	if a.HasError || a.Sections[0].Len != 0 {
		return fail("InvertCond of a valid condition should neither error nor emit")
	}
	return ""
}

// TestInvertCondRejectsAlNvAndOutOfRange checks that AL and NV (both execute
// as always) and values outside 0..15 are errors returning -1, and that a
// B.cond given that -1 emits nothing.
func TestInvertCondRejectsAlNvAndOutOfRange() testing.TestResult {
	var bad @[]int = make_slice(int, 4)
	bad[0] = COND_AL
	bad[1] = COND_NV
	bad[2] = -1
	bad[3] = 16
	for i := 0; i < len(bad); i++ {
		var a @asm.Assembler = newAsm()
		if InvertCond(a, bad[i]) != -1 || !a.HasError {
			return fail("InvertCond of AL, NV or a non-condition should error and return -1")
		}
	}
	var b @asm.Assembler = newAsm()
	Bcond(b, InvertCond(b, COND_NV), "target")
	if !b.HasError || b.Sections[0].Len != 0 || b.Sections[0].NumFixups != 0 {
		return fail("B.cond on InvertCond's -1 should emit nothing")
	}
	return ""
}
