package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 load/store instruction encoders: LDR/STR in the word and sub-word
// (byte/half) sizes across all addressing modes (unsigned offset, pre/post
// index, register offset), LDR-literal and GOT-relative loads, and the LDP/STP
// register-pair forms.

// --- Load/Store ---

// LDR (immediate, unsigned offset): sf|11|1001|01|imm12|Rn|Rt
// STR (immediate, unsigned offset): sf|11|1001|00|imm12|Rn|Rt
// The imm12 is scaled by the access size (8 for X, 4 for W).

func ldrStrUnsignedEnc(sf bool, isLoad bool, imm int, rn int, rt int) uint32 {
	var size uint32 = 0x80000000 // size=10 (32-bit) default
	var scale int = 4
	if sf {
		size = 0xC0000000 // size=11 (64-bit)
		scale = 8
	}
	var opc uint32 = 0x39000000 // STR base
	if isLoad {
		opc = 0x39400000 // LDR base
	}
	var inst uint32 = size | opc
	var scaledImm int = imm / scale
	inst = inst | (cast(uint32, scaledImm & 0xfff) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// LdrStrImmFitsUnsigned reports whether `imm` is encodable as the
// unsigned-imm12 form of a 32- or 64-bit LDR/STR (sf=false → 32-bit
// scaled by 4; sf=true → 64-bit scaled by 8). The encoding silently
// masks the scaled imm to 12 bits — for sp-relative ops in large
// frames (e.g. the auto-generated test runner with many tests) that
// produces wrong addresses. Native backend callers should check this
// and materialize the address into a scratch register otherwise.
func LdrStrImmFitsUnsigned(sf bool, imm int) bool {
	if imm < 0 { return false }
	var scale int = 4
	if sf { scale = 8 }
	if imm % scale != 0 { return false }
	return (imm / scale) <= 4095
}

// LDR/STR (pre-index): size|11|1000|opc|0|imm9|11|Rn|Rt
// LDR/STR (post-index): size|11|1000|opc|0|imm9|01|Rn|Rt
func ldrStrIndexEnc(sf bool, isLoad bool, imm int, rn int, rt int, isPre bool) uint32 {
	var size uint32 = 0x80000000
	if sf {
		size = 0xC0000000
	}
	var opc uint32 = 0x38000000 // STR base
	if isLoad {
		opc = 0x38400000 // LDR base
	}
	var inst uint32 = size | opc
	inst = inst | (cast(uint32, imm & 0x1ff) << 12)
	if isPre {
		inst = inst | (3 << 10) // pre-index: 11
	} else {
		inst = inst | (1 << 10) // post-index: 01
	}
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// LDR/STR (register): size|11|1000|opc|1|Rm|011|0|10|Rn|Rt
func ldrStrRegEnc(sf bool, isLoad bool, rm int, rn int, rt int) uint32 {
	var size uint32 = 0x80000000
	if sf {
		size = 0xC0000000
	}
	var opc uint32 = 0x38200000 // STR (register) base
	if isLoad {
		opc = 0x38600000 // LDR (register) base
	}
	var inst uint32 = size | opc
	inst = inst | (cast(uint32, rm & 0x1f) << 16)
	inst = inst | (3 << 13) // option = 011 (LSL)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// emitLdrStr emits a load or store instruction, dispatching to unsigned-offset,
// pre/post-index, register-offset, or literal encoding based on operand kind.
//
// For OP_MEM_IMM: if the offset doesn't fit the unsigned-imm12 form
// (capped at 4096 * scale, where scale is the access size), the encoder
// would otherwise silently mask the scaled imm to 12 bits and emit
// the wrong address. Fall back to materializing base+off into X17
// first, then emit with a zero offset. Caller must not pass rt=X17 in
// the overflowing case; that's not exercised today and we set an
// assembler error if it is.
func emitLdrStr(a @asm.Assembler, sf bool, isLoad bool, rt int, op Operand) {
	switch op.Kind {
	case OP_MEM_IMM:
		if !LdrStrImmFitsUnsigned(sf, cast(int, op.Imm)) {
			if rt == X17 {
				a.SetError("LDR/STR overflow: rt=X17 conflicts with scratch")
				return
			}
			Add(a, true, X17, op.Reg, Imm(cast(int, op.Imm)))
			emit32(a, ldrStrUnsignedEnc(sf, isLoad, 0, X17, rt))
			return
		}
		emit32(a, ldrStrUnsignedEnc(sf, isLoad, cast(int, op.Imm), op.Reg, rt))
	case OP_MEM_PRE:
		emit32(a, ldrStrIndexEnc(sf, isLoad, cast(int, op.Imm), op.Reg, rt, true))
	case OP_MEM_POST:
		emit32(a, ldrStrIndexEnc(sf, isLoad, cast(int, op.Imm), op.Reg, rt, false))
	case OP_MEM_REG:
		emit32(a, ldrStrRegEnc(sf, isLoad, op.Reg2, op.Reg, rt))
	case OP_LABEL:
		// LDR (literal): sf|01|1000|imm19|Rt
		var inst uint32 = sfBit(sf) | 0x18000000
		inst = inst | cast(uint32, rt & 0x1f)
		a.AddFixup(op.Label, FIX_BRANCH19, 0, 4)
		emit32(a, inst)
	}
}

// Ldr emits `LDR Rt, op` — load a 32- or 64-bit register from memory.
// sf=true selects the 64-bit form. op may be an immediate-offset, pre-
// or post-indexed, or register-indexed memory operand.
func Ldr(a @asm.Assembler, sf bool, rt int, op Operand) {
	emitLdrStr(a, sf, true, rt, op)
}

// Str emits `STR Rt, op` — store a 32- or 64-bit register to memory.
// Same op encodings as Ldr.
func Str(a @asm.Assembler, sf bool, rt int, op Operand) {
	emitLdrStr(a, sf, false, rt, op)
}

// LdrImmLabel emits `LDR rt, [base, #0]` and a FIX_LDR_LO12 fixup against label.
// The linker patches the scaled imm12 with (low-12-of-target >> size-log2).
// Intended for ADRP+LDR pairs that load from a PC-relative target.
func LdrImmLabel(a @asm.Assembler, sf bool, rt int, base int, label *[]readonly char) {
	a.AddFixup(label, FIX_LDR_LO12, 0, 4)
	emit32(a, ldrStrUnsignedEnc(sf, true, 0, base, rt))
}

// LdrGotLo12 emits `LDR rt, [base, #0]` (64-bit form) and a FIX_LD_GOT_LO12
// fixup against label — loads the GOT slot's contents (label's real address)
// into rt.  Paired with AdrpGot: base holds the GOT-slot page from the ADRP.
// The load is always 64-bit (a GOT entry is a pointer); the encoding matches
// LdrImmLabel(sf=true), only the relocation kind differs.
func LdrGotLo12(a @asm.Assembler, rt int, base int, label *[]readonly char) {
	a.AddFixup(label, FIX_LD_GOT_LO12, 0, 4)
	emit32(a, ldrStrUnsignedEnc(true, true, 0, base, rt))
}

// ldrStrSubWordEmit emits a sub-word or sign-extending load/store —
// STRB/LDRB/STRH/LDRH and the sign-extending LDRSB/LDRSH/LDRSW — at
// [base, #imm].  baseInst carries the opcode (including the LDRS* opc
// field that selects W- vs X-form sign extension); scale is the access
// size in bytes: 1 for byte ops (no shift), 2 for halfword, 4 for
// LDRSW.  Materializes the address into X17 if imm doesn't fit the
// scaled-imm12 form, mirroring emitLdrStr's overflow handling — without
// this a stack offset past the imm12 range (a sub-word local in a large
// frame) would wrap modulo 4096*scale and silently access the wrong
// slot.
func ldrStrSubWordEmit(a @asm.Assembler, baseInst uint32, scale int, rt int, op Operand) {
	switch op.Kind {
	case OP_MEM_IMM:
		var imm int = cast(int, op.Imm)
		var base int = op.Reg
		if imm < 0 || imm % scale != 0 || (imm / scale) > 4095 {
			if rt == X17 {
				a.SetError("sub-word load/store overflow: rt=X17 conflicts with scratch")
				return
			}
			Add(a, true, X17, base, Imm(imm))
			base = X17
			imm = 0
		}
		var scaledImm int = imm / scale
		var inst uint32 = baseInst
		inst = inst | (cast(uint32, scaledImm & 0xfff) << 10)
		inst = inst | (cast(uint32, base & 0x1f) << 5)
		inst = inst | cast(uint32, rt & 0x1f)
		emit32(a, inst)
	case OP_MEM_POST:
		emit32(a, subWordIndexEnc(baseInst, cast(int, op.Imm), op.Reg, rt, false))
	case OP_MEM_PRE:
		emit32(a, subWordIndexEnc(baseInst, cast(int, op.Imm), op.Reg, rt, true))
	default:
		// Emit nothing would silently drop the instruction (a wrong-code
		// hazard the sub-word register-offset form is not implemented yet).
		a.SetError("aarch64 sub-word load/store: unsupported addressing mode")
	}
}

// subWordIndexEnc encodes an STRB/STRH/LDRB/LDRH in the pre/post-indexed form
// from the unsigned-offset base instruction (STRB=0x39000000, STRH=0x79000000,
// with the LDR variant's bit 22 set).  The pre/post form is the same opcode
// with bit 24 cleared (0x39->0x38, 0x79->0x78), a signed 9-bit unscaled
// immediate in bits [20:12], and the index mode (11=pre, 01=post) in
// bits [11:10] — mirroring ldrStrIndexEnc for the full-word case.
func subWordIndexEnc(baseInst uint32, imm int, rn int, rt int, isPre bool) uint32 {
	var inst uint32 = baseInst & 0xFEFFFFFF // clear bit 24: unsigned-offset -> index form
	inst = inst | (cast(uint32, imm & 0x1ff) << 12)
	if isPre {
		inst = inst | (3 << 10) // pre-index: 11
	} else {
		inst = inst | (1 << 10) // post-index: 01
	}
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	return inst
}

// LDRB (unsigned offset): 00|111001|01|imm12|Rn|Rt
func Ldrb(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x39400000, 1, rt, op)
}

// STRB (unsigned offset): 00|111001|00|imm12|Rn|Rt
func Strb(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x39000000, 1, rt, op)
}

// LDRH (unsigned offset): 01|111001|01|imm12|Rn|Rt (imm12 scaled by 2)
func Ldrh(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x79400000, 2, rt, op)
}

// STRH (unsigned offset): 01|111001|00|imm12|Rn|Rt (imm12 scaled by 2)
func Strh(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, 0x79000000, 2, rt, op)
}

// StrSized stores the low `size` bytes of rt to op: 1 → STRB, 2 → STRH,
// 4 → 32-bit STR, 8 → 64-bit STR.  The natural-size narrow stack-arg store on
// Apple-AArch64 (a 1/2/4-byte FIXED scalar occupies a 1/2/4-byte stack slot).
// Because a natural-size slot is naturally aligned, the scaled-imm12 form always
// fits a realistic frame — no X17 materialization in practice.
func StrSized(a @asm.Assembler, size int, rt int, op Operand) {
	if size == 1 {
		Strb(a, rt, op)
		return
	}
	if size == 2 {
		Strh(a, rt, op)
		return
	}
	Str(a, size == 8, rt, op)
}

// --- Load/Store pair ---

// LDP: opc|10100|L|1|imm7|Rt2|Rn|Rt  (signed offset)
// STP: opc|10100|L|0|imm7|Rt2|Rn|Rt
func ldpStpEnc(sf bool, isLoad bool, imm int, rt2 int, rn int, rt1 int, mode int) uint32 {
	var opc uint32 = 0x28000000 // 32-bit
	var scale int = 4
	if sf {
		opc = 0xA8000000 // 64-bit
		scale = 8
	}
	if isLoad {
		opc = opc | (1 << 22) // L bit
	}
	// mode: 1=post, 2=signed-offset, 3=pre
	opc = opc | (cast(uint32, mode) << 23)
	var scaledImm int = imm / scale
	var inst uint32 = opc
	inst = inst | (cast(uint32, scaledImm & 0x7f) << 15)
	inst = inst | (cast(uint32, rt2 & 0x1f) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rt1 & 0x1f)
	return inst
}

// Ldp emits `LDP Rt1, Rt2, op` — load a pair of registers from memory.
// op selects offset (signed scaled imm7), pre-indexed, or post-indexed
// addressing.
func Ldp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand) {
	switch op.Kind {
	case OP_MEM_IMM:
		emit32(a, ldpStpEnc(sf, true, cast(int, op.Imm), rt2, op.Reg, rt1, 2))
	case OP_MEM_PRE:
		emit32(a, ldpStpEnc(sf, true, cast(int, op.Imm), rt2, op.Reg, rt1, 3))
	case OP_MEM_POST:
		emit32(a, ldpStpEnc(sf, true, cast(int, op.Imm), rt2, op.Reg, rt1, 1))
	}
}

// Stp emits `STP Rt1, Rt2, op` — store a pair of registers to memory.
// Same op encodings as Ldp.
func Stp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand) {
	switch op.Kind {
	case OP_MEM_IMM:
		emit32(a, ldpStpEnc(sf, false, cast(int, op.Imm), rt2, op.Reg, rt1, 2))
	case OP_MEM_PRE:
		emit32(a, ldpStpEnc(sf, false, cast(int, op.Imm), rt2, op.Reg, rt1, 3))
	case OP_MEM_POST:
		emit32(a, ldpStpEnc(sf, false, cast(int, op.Imm), rt2, op.Reg, rt1, 1))
	}
}
