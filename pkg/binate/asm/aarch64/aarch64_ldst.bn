package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// AArch64 load/store instruction encoders: LDR/STR in the word and sub-word
// (byte/half) sizes across all addressing modes (unsigned offset, pre/post
// index, register offset), LDR-literal and GOT-relative loads, and the LDP/STP
// register-pair forms.

// --- Load/Store ---

// LdrStrImmFitsUnsigned reports whether `imm` is encodable as the
// unsigned-imm12 form of a 32- or 64-bit LDR/STR (sf=false → 32-bit
// scaled by 4; sf=true → 64-bit scaled by 8).  The exact encoder rejects
// any other offset; Ldr/Str themselves fall back to forming the address
// in X17 (emitLdrStr), and other callers can check this first.
func LdrStrImmFitsUnsigned(sf bool, imm int) bool {
	if imm < 0 { return false }
	var scale int = 4
	if sf { scale = 8 }
	if imm % scale != 0 { return false }
	return (imm / scale) <= 4095
}

// LdurSturImmFits reports whether imm is encodable in the LDUR/STUR unscaled
// signed 9-bit immediate field: -256 <= imm <= 255.  There is no alignment
// requirement — the offset is an unscaled byte count.
func LdurSturImmFits(imm int) bool {
	return imm >= -256 && imm <= 255
}

// emitLdrStr emits a load or store instruction, dispatching to unsigned-offset,
// pre/post-index, register-offset, unscaled (LDUR/STUR), or literal encoding
// based on operand kind.
//
// For OP_MEM_IMM: an offset that doesn't fit the unsigned-imm12 form (capped at
// 4096 * scale, where scale is the access size) is materialized as base+off into
// X17 first, then accessed with a zero offset. Caller must not pass rt=X17 in the
// overflowing case; that's not exercised today and we set an assembler error if it
// is.  The transfer register reads 31 as the zero register, the base as SP, and a
// register index as the zero register.
func emitLdrStr(a @asm.Assembler, sf bool, isLoad bool, rt int, op Operand) {
	var spec uint32 = gpLdStSpec(sf, isLoad)
	switch op.Kind {
	case OP_MEM_IMM:
		if !LdrStrImmFitsUnsigned(sf, cast(int, op.Imm)) {
			if rt == X17 {
				a.SetError("LDR/STR overflow: rt=X17 conflicts with scratch")
				return
			}
			var rtf int = zrReg(a, rt)
			if rtf < 0 || !formScratchAddr(a, op.Reg, cast(int, op.Imm)) { return }
			isa.LdStUImm(a, spec, rtf, X17, 0)
			return
		}
		isa.LdStUImm(a, spec, zrReg(a, rt), spReg(a, op.Reg), cast(int, op.Imm))
	case OP_MEM_PRE:
		isa.LdStPre(a, spec, zrReg(a, rt), spReg(a, op.Reg), cast(int, op.Imm))
	case OP_MEM_POST:
		isa.LdStPost(a, spec, zrReg(a, rt), spReg(a, op.Reg), cast(int, op.Imm))
	case OP_MEM_REG:
		isa.LdStReg(a, spec, zrReg(a, rt), spReg(a, op.Reg), zrReg(a, op.Reg2), isa.EXT_LSL, false)
	case OP_MEM_REG_SCALED:
		isa.LdStReg(a, spec, zrReg(a, rt), spReg(a, op.Reg), zrReg(a, op.Reg2), isa.EXT_LSL, true)
	case OP_MEM_UNSCALED:
		isa.LdStUnscaled(a, spec, zrReg(a, rt), spReg(a, op.Reg), cast(int, op.Imm))
	case OP_LABEL:
		// Only a load has a PC-relative literal form.
		if !isLoad {
			a.SetError("STR has no PC-relative literal form")
			return
		}
		isa.LdStLiteral(a, spec, zrReg(a, rt), op.Label, 0)
	default:
		a.SetError("LDR/STR: unsupported operand kind")
	}
}

// formScratchAddr forms base+off in the X17 scratch, for an access whose offset
// doesn't fit its immediate form, and reports whether it did: an invalid base, or an
// offset the ADD/SUB pair cannot form, is an assembler error — then the caller emits
// no access through X17 (so a rejected access emits nothing, having mapped its
// transfer register first).
func formScratchAddr(a @asm.Assembler, base int, off int) bool {
	if spReg(a, base) < 0 { return false }
	Add(a, true, X17, base, Imm(off))
	return !a.HasError
}

// gpLdStSpec returns the LS_* spec of a 32- or 64-bit (sf) general-purpose LDR / STR.
func gpLdStSpec(sf bool, isLoad bool) uint32 {
	if sf {
		if isLoad { return isa.LS_LDR_X }
		return isa.LS_STR_X
	}
	if isLoad { return isa.LS_LDR_W }
	return isa.LS_STR_W
}

// Ldr emits `LDR Rt, op` — load a 32- or 64-bit register from memory.
// sf=true selects the 64-bit form. op may be an immediate-offset, pre-
// or post-indexed, or register-indexed memory operand.
func Ldr(a @asm.Assembler, sf bool, rt int, op Operand) {
	emitLdrStr(a, sf, true, rt, op)
}

// Str emits `STR Rt, op` — store a 32- or 64-bit register to memory.
// Same op encodings as Ldr.
func Str(a @asm.Assembler, sf bool, rt int, op Operand) {
	emitLdrStr(a, sf, false, rt, op)
}

// LdrswRegScaled emits `LDRSW Xt, [base, index, lsl #2]` — the scaled
// register-offset form of LDRSW: a signed 4-byte load whose index register
// holds the ELEMENT index (scaled by the 4-byte access size), sign-extending
// the loaded word to 64 bits.
func LdrswRegScaled(a @asm.Assembler, rt int, base int, index int) {
	isa.LdStReg(a, isa.LS_LDRSW, zrReg(a, rt), spReg(a, base), zrReg(a, index), isa.EXT_LSL, true)
}

// LdrImmLabel emits `LDR rt, [base, #:lo12:label]` — X (sf) or W — with the lo12
// fixup of that access size (FIX_LDR_LO12 or FIX_LDST32_LO12): the linker fills the
// imm12 with the target's page offset divided by 8 or 4.  The low half of an
// ADRP + LDR pair loading from a PC-relative target.
func LdrImmLabel(a @asm.Assembler, sf bool, rt int, base int, label *[]readonly char) {
	isa.LdStLo12(a, gpLdStSpec(sf, true), zrReg(a, rt), spReg(a, base), label, 0)
}

// LdrGotLo12 emits `LDR rt, [base, #0]` (64-bit form) and a FIX_LD_GOT_LO12
// fixup against label — loads the GOT slot's contents (label's real address)
// into rt.  Paired with AdrpGot: base holds the GOT-slot page from the ADRP.
// The load is always 64-bit (a GOT entry is a pointer); the encoding matches
// LdrImmLabel(sf=true), only the relocation kind differs.
func LdrGotLo12(a @asm.Assembler, rt int, base int, label *[]readonly char) {
	isa.LdGotLo12(a, zrReg(a, rt), spReg(a, base), label)
}

// ldrStrSubWordEmit emits a sub-word or sign-extending load/store —
// STRB/LDRB/STRH/LDRH and the sign-extending LDRSB/LDRSH/LDRSW, an LS_* spec — at
// [base, #imm] or pre/post-indexed.  An immediate offset that doesn't fit the
// scaled-imm12 form is materialized into X17 first, mirroring emitLdrStr's overflow
// handling (a sub-word local in a large frame).
func ldrStrSubWordEmit(a @asm.Assembler, spec uint32, rt int, op Operand) {
	switch op.Kind {
	case OP_MEM_IMM:
		var imm int = cast(int, op.Imm)
		var scale int = isa.LdStAccessBytes(spec)
		if imm < 0 || imm % scale != 0 || (imm / scale) > 4095 {
			if rt == X17 {
				a.SetError("sub-word load/store overflow: rt=X17 conflicts with scratch")
				return
			}
			var rtf int = zrReg(a, rt)
			if rtf < 0 || !formScratchAddr(a, op.Reg, imm) { return }
			isa.LdStUImm(a, spec, rtf, X17, 0)
			return
		}
		isa.LdStUImm(a, spec, zrReg(a, rt), spReg(a, op.Reg), imm)
	case OP_MEM_POST:
		isa.LdStPost(a, spec, zrReg(a, rt), spReg(a, op.Reg), cast(int, op.Imm))
	case OP_MEM_PRE:
		isa.LdStPre(a, spec, zrReg(a, rt), spReg(a, op.Reg), cast(int, op.Imm))
	default:
		// Emit nothing would silently drop the instruction (a wrong-code
		// hazard the sub-word register-offset form is not implemented yet).
		a.SetError("aarch64 sub-word load/store: unsupported addressing mode")
	}
}

// LDRB (unsigned offset): 00|111001|01|imm12|Rn|Rt
func Ldrb(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, isa.LS_LDRB, rt, op)
}

// STRB (unsigned offset): 00|111001|00|imm12|Rn|Rt
func Strb(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, isa.LS_STRB, rt, op)
}

// LDRH (unsigned offset): 01|111001|01|imm12|Rn|Rt (imm12 scaled by 2)
func Ldrh(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, isa.LS_LDRH, rt, op)
}

// STRH (unsigned offset): 01|111001|00|imm12|Rn|Rt (imm12 scaled by 2)
func Strh(a @asm.Assembler, rt int, op Operand) {
	ldrStrSubWordEmit(a, isa.LS_STRH, rt, op)
}

// StrSized stores the low `size` bytes of rt to op: 1 → STRB, 2 → STRH,
// 4 → 32-bit STR, 8 → 64-bit STR.  The natural-size narrow stack-arg store on
// Apple-AArch64 (a 1/2/4-byte FIXED scalar occupies a 1/2/4-byte stack slot).
// Because a natural-size slot is naturally aligned, the scaled-imm12 form always
// fits a realistic frame — no X17 materialization in practice.
func StrSized(a @asm.Assembler, size int, rt int, op Operand) {
	if size == 1 {
		Strb(a, rt, op)
		return
	}
	if size == 2 {
		Strh(a, rt, op)
		return
	}
	Str(a, size == 8, rt, op)
}

// --- Load/Store pair ---

// Ldp emits `LDP Rt1, Rt2, op` — load a pair of registers from memory.
// op selects offset (signed scaled imm7), pre-indexed, or post-indexed
// addressing.
func Ldp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand) {
	gpPair(a, sf, true, rt1, rt2, op)
}

// Stp emits `STP Rt1, Rt2, op` — store a pair of registers to memory.
// Same op encodings as Ldp.
func Stp(a @asm.Assembler, sf bool, rt1 int, rt2 int, op Operand) {
	gpPair(a, sf, false, rt1, rt2, op)
}

// gpPair emits a general-purpose LDP / STP through LdStPair, which rejects an offset
// that is misaligned or outside the scaled 7-bit range instead of truncating it.
func gpPair(a @asm.Assembler, sf bool, isLoad bool, rt1 int, rt2 int, op Operand) {
	var spec uint32 = isa.LSP_STP_W
	if sf { spec = isa.LSP_STP_X }
	if isLoad { spec = spec | 0x00400000 }
	var mode int = isa.PAIR_OFFSET
	if op.Kind == OP_MEM_PRE {
		mode = isa.PAIR_PRE
	} else if op.Kind == OP_MEM_POST {
		mode = isa.PAIR_POST
	} else if op.Kind != OP_MEM_IMM {
		a.SetError("LDP/STP: unsupported operand kind")
		return
	}
	isa.LdStPair(a, spec, zrReg(a, rt1), zrReg(a, rt2), spReg(a, op.Reg), cast(int, op.Imm), mode)
}
