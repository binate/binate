package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// AArch64 load/store encoder tests (LDR/STR word and sub-word, all addressing
// modes, and the LDP/STP pair forms).

// --- Load/Store tests ---

func TestLdrImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR X0, [X1, #8] = 11|111001|01|000000000001|00001|00000
	// imm12 = 8/8 = 1, shifted left 10 bits
	// = 0xF9400420
	Ldr(a, true, X0, MemImm(X1, 8))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF9400420 {
		return fail("LDR X0, [X1, #8] encoding wrong")
	}
	return ""
}

func TestStrImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STR X0, [X1, #16] = 11|111001|00|000000000010|00001|00000
	// imm12 = 16/8 = 2
	// = 0xF9000820
	Str(a, true, X0, MemImm(X1, 16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xF9000820 {
		return fail("STR X0, [X1, #16] encoding wrong")
	}
	return ""
}

// 64-bit STR's imm12 is scaled by 8, so the encodable range is up
// to 0x7FF8 (32760). For larger offsets — e.g. the ~0x81b8 slots a
// big-frame test runner generates — the encoder previously masked
// the scaled imm to 12 bits and emitted the wrong address. emitLdrStr
// now materializes the address into X17 first.
func TestStrImmOverflowMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STR X0, [SP, #0x81b8]: 0x81b8/8 = 0x1037 > 0xFFF, doesn't fit.
	// Expect: ADD X17, SP, #0x81b8 (2 instrs since hi=8, lo=0x1b8) +
	// STR X0, [X17, #0] = 3 instrs / 12 bytes.
	Str(a, true, X0, MemImm(SP, 0x81b8))
	if a.Sections[0].Len != 12 {
		return fail("STR with overflow offset should ADD twice + STR (12 bytes)")
	}
	return ""
}

// STRB's imm12 isn't scaled — encodable range 0..4095. 0x1158 = 4440
// triggers the materialization path. Pre-fix this silently emitted a
// STRB at sp+0x158 (= 0x1158 & 0xfff), corrupting unrelated stack data.
func TestStrbImmOverflowMaterializes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Strb(a, X0, MemImm(SP, 0x1158))
	// ADD X17, SP, #0x1158 (hi=1, lo=0x158 → 2 ADDs) + STRB = 12 bytes.
	if a.Sections[0].Len != 12 {
		return fail("STRB with overflow offset should ADD twice + STRB (12 bytes)")
	}
	return ""
}

// LdrStrImmFitsUnsigned reports the encodability up front for callers
// that want to avoid the materialization overhead in the common path.
func TestLdrStrImmFitsUnsigned() testing.TestResult {
	if !LdrStrImmFitsUnsigned(true, 8) { return fail("8/8=1 fits 64-bit") }
	if !LdrStrImmFitsUnsigned(true, 32760) { return fail("32760/8=4095 fits") }
	if LdrStrImmFitsUnsigned(true, 32768) { return fail("32768/8=4096 doesn't fit") }
	if LdrStrImmFitsUnsigned(true, 4) { return fail("4/8 not aligned") }
	if !LdrStrImmFitsUnsigned(false, 4) { return fail("4/4=1 fits 32-bit") }
	if LdrStrImmFitsUnsigned(false, 16384) { return fail("16384/4=4096 doesn't fit") }
	if LdrStrImmFitsUnsigned(true, -8) { return fail("negative doesn't fit") }
	return ""
}

func TestLdrb() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRB W0, [X1, #0] = 00|111001|01|000000000000|00001|00000
	// = 0x39400020
	Ldrb(a, X0, MemImm(X1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x39400020 {
		return fail("LDRB W0, [X1, #0] encoding wrong")
	}
	return ""
}

// Sub-word post/pre-indexed forms (a silent-drop hazard before they were
// implemented — the encoder returned without emitting for any addressing
// mode other than the unsigned offset).  Golden values from the system
// assembler (clang -arch arm64).
func TestStrbPostIndex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STRB WZR, [X0], #1 = 0x3800141F
	Strb(a, XZR, MemPost(X0, 1))
	if readInst(a.Sections[0], 0) != 0x3800141F {
		return fail("STRB WZR, [X0], #1 encoding wrong")
	}
	return ""
}

func TestStrbPostIndexReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STRB W1, [X2], #4 = 0x38004441
	Strb(a, X1, MemPost(X2, 4))
	if readInst(a.Sections[0], 0) != 0x38004441 {
		return fail("STRB W1, [X2], #4 encoding wrong")
	}
	return ""
}

func TestLdrbPostIndexNeg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRB W3, [X4], #-8 = 0x385F8483
	Ldrb(a, X3, MemPost(X4, -8))
	if readInst(a.Sections[0], 0) != 0x385F8483 {
		return fail("LDRB W3, [X4], #-8 encoding wrong")
	}
	return ""
}

func TestStrhPreIndex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STRH W0, [X1, #2]! = 0x78002C20
	Strh(a, X0, MemPre(X1, 2))
	if readInst(a.Sections[0], 0) != 0x78002C20 {
		return fail("STRH W0, [X1, #2]! encoding wrong")
	}
	return ""
}

func TestStrhPostIndex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STRH WZR, [X5], #16 = 0x780104BF
	Strh(a, XZR, MemPost(X5, 16))
	if readInst(a.Sections[0], 0) != 0x780104BF {
		return fail("STRH WZR, [X5], #16 encoding wrong")
	}
	return ""
}

// --- Load/Store pair tests ---

func TestStpPre() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STP X29, X30, [SP, #-16]! (pre-index)
	// opc=10, mode=pre(3), L=0, imm7=-16/8=-2 (0x7E in 7-bit signed)
	// = 0xA9BF7BFD
	Stp(a, true, FP, LR, MemPre(SP, -16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xA9BF7BFD {
		return fail("STP X29, X30, [SP, #-16]! encoding wrong")
	}
	return ""
}

func TestLdpPost() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDP X29, X30, [SP], #16 (post-index)
	// opc=10, mode=post(1), L=1, imm7=16/8=2
	// = 0xA8C17BFD
	Ldp(a, true, FP, LR, MemPost(SP, 16))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xA8C17BFD {
		return fail("LDP X29, X30, [SP], #16 encoding wrong")
	}
	return ""
}
