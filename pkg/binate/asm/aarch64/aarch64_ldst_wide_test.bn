package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Load / store offsets carried as int64 (MemImm64, the FP forms' int64 offset): one
// past the immediate field is formed in X17 from the whole int64 — never narrowed to
// the host's int first — and a form that cannot do that rejects it.  The expected
// words are llvm-mc's for the same instructions.

// wideWordsMatch reports whether a emitted exactly the words want.
func wideWordsMatch(a @asm.Assembler, want @[]uint32) bool {
	if a.HasError || a.Sections[0].Len != 4 * len(want) { return false }
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] { return false }
	}
	return true
}

// LDR X0, [SP, #4 GiB]: MOVZ X17, #1, LSL #32; ADD X17, SP, X17; LDR X0, [X17].
func TestLdrMemImm64PastInt32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, true, X0, MemImm64(SP, 0x100000000))
	if !wideWordsMatch(a, @[]uint32{0xd2c00031, 0x8b3163f1, 0xf9400220}) {
		return fail("LDR at SP + 4 GiB should form the address in X17")
	}
	return ""
}

// STR X1, [SP, #-0x80000008]: the negative offset is subtracted — MOVZ / MOVK X17 with
// its magnitude, SUB X17, SP, X17, STR X1, [X17].
func TestStrMemImm64Negative() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Str(a, true, X1, MemImm64(SP, -0x80000008))
	if !wideWordsMatch(a, @[]uint32{0xd2800111, 0xf2b00011, 0xcb3163f1, 0xf9000221}) {
		return fail("STR at SP - 0x80000008 should form the address in X17")
	}
	return ""
}

// STRB W2, [X3, #0x123456789]: a sub-word store forms its address the same way.
func TestStrbMemImm64PastInt32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Strb(a, X2, MemImm64(X3, 0x123456789))
	if !wideWordsMatch(a, @[]uint32{0xd28cf131, 0xf2a468b1, 0xf2c00031, 0x8b110071, 0x39000222}) {
		return fail("STRB at X3 + 0x123456789 should form the address in X17")
	}
	return ""
}

// STR D0, [SP, #0x100000008]: the FP store's int64 offset reaches X17 whole.
func TestFstrDOffsetPastInt32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fstr_d(a, D0, SP, 0x100000008)
	if !wideWordsMatch(a, @[]uint32{0xd2800111, 0xf2c00031, 0x8b3163f1, 0xfd000220}) {
		return fail("STR D0 at SP + 0x100000008 should form the address in X17")
	}
	return ""
}

// A MemImm64 offset in the immediate field encodes as MemImm's does.
func TestLdrMemImm64Near() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, true, X0, MemImm64(SP, 16))
	if !wideWordsMatch(a, @[]uint32{0xf9400be0}) { return fail("LDR X0, [SP, #16]") }
	return ""
}

// LDP / STP have no X17 path: an offset past their field is an error, not a wrapped
// encoding.
func TestLdpMemImm64Rejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldp(a, true, X0, X1, MemImm64(SP, 0x100000000))
	if !a.HasError { return fail("LDP at SP + 4 GiB must be an error") }
	return ""
}

// A load into X17 past the immediate field forms its address in X17 too: the address
// is consumed before the load overwrites it.  A store of X17 there is an error.
func TestLdrX17PastImmediate() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, true, X17, MemImm(SP, 0x8000))
	if !wideWordsMatch(a, @[]uint32{0x914023f1, 0xf9400231}) {
		return fail("LDR X17, [SP, #0x8000] should be ADD X17, SP, #8, LSL #12; LDR X17, [X17]")
	}
	a = newAsm()
	Ldrb(a, X17, MemImm64(SP, 0x100000000))
	if !wideWordsMatch(a, @[]uint32{0xd2c00031, 0x8b3163f1, 0x39400231}) {
		return fail("LDRB W17 at SP + 4 GiB should form the address in X17")
	}
	a = newAsm()
	Str(a, true, X17, MemImm(SP, 0x8000))
	if !a.HasError { return fail("STR X17 past the immediate field must be an error") }
	a = newAsm()
	Strb(a, X17, MemImm64(SP, 0x100000000))
	if !a.HasError { return fail("STRB W17 past the immediate field must be an error") }
	return ""
}

// 0x80000000 is positive: added, not subtracted (narrowed to a 32-bit int it would
// read as negative).
func TestLdrMemImm64At2GiB() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, true, X0, MemImm64(SP, 0x80000000))
	if !wideWordsMatch(a, @[]uint32{0xd2b00011, 0x8b3163f1, 0xf9400220}) {
		return fail("LDR at SP + 2 GiB should form the address in X17 by an ADD")
	}
	return ""
}

// LDRSW, a sign-extending load, forms an address past the immediate field the same way.
func TestLdrswMemImm64PastInt32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrsw(a, X0, MemImm64(SP, 0x100000000))
	if !wideWordsMatch(a, @[]uint32{0xd2c00031, 0x8b3163f1, 0xb9800220}) {
		return fail("LDRSW at SP + 4 GiB should form the address in X17")
	}
	return ""
}

// The S form's scaled field ends at 16380; 16384 takes the X17 path.
func TestFstrSBoundary() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fstr_s(a, D0, SP, 16380)
	if !wideWordsMatch(a, @[]uint32{0xbd3fffe0}) { return fail("STR S0, [SP, #16380]") }
	a = newAsm()
	Fstr_s(a, D0, SP, 16384)
	if !wideWordsMatch(a, @[]uint32{0x914013f1, 0xbd000220}) {
		return fail("STR S0 at SP + 16384 should form the address in X17")
	}
	return ""
}

// An access based on X17 whose offset needs X17 to form its address is an error, not
// a clobbered base.
func TestMemImm64BaseX17Rejected() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, true, X0, MemImm64(X17, 0x100000000))
	if !a.HasError { return fail("LDR at X17 + 4 GiB must be an error") }
	return ""
}
