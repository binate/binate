package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD (NEON) packed integer + bitwise instructions for the native
// backend, each encoded by the exact isa/simd encoder (which rejects an arrangement the
// instruction does not take).
//
// V registers are the 128-bit SIMD/FP file (V0..V31, the same values as the D
// scalar regs — a V and its D name the same physical register); each maps to its
// field through vReg.  A packed op names its operand shape with an arrangement specifier
// (ARR_8B..ARR_2D), from which neonArr derives the vector width (Q) and the element size
// — for these and for the other NEON wrappers (aarch64_neon_*.bn).

// neonArr returns arrangement arr's 128-bit flag and element size (0..3: B, H, S, D),
// or ok=false (with an assembler error) when arr is not an ARR_* value.  The ARR_*
// constants are ordered (size, Q), so Q is the low bit and the size the two above it.
func neonArr(a @asm.Assembler, arr int) (bool, int, bool) {
	if arr < ARR_8B || arr > ARR_2D {
		a.SetError("aarch64: expected a vector arrangement (ARR_8B..ARR_2D)")
		return false, 0, false
	}
	return (arr & 1) == 1, (arr >> 1) & 3, true
}

// neonThreeSame emits an integer three-same operation (a simd.S3_* value) on
// arrangement arr.
func neonThreeSame(a @asm.Assembler, op int, arr int, vd int, vn int, vm int) {
	q, size, ok := neonArr(a, arr)
	if !ok { return }
	simd.IntThreeSame(a, op, q, size, vReg(a, vd), vReg(a, vn), vReg(a, vm))
}

// --- Packed integer arithmetic (three-same) ---

// Vadd emits `ADD Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer add for
// arrangement `arr` (ARR_8B..ARR_2D except ARR_1D, which has no vector form).
func Vadd(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonThreeSame(a, simd.S3_ADD, arr, vd, vn, vm)
}

// Vsub emits `SUB Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer subtract (any
// arrangement but ARR_1D).
func Vsub(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonThreeSame(a, simd.S3_SUB, arr, vd, vn, vm)
}

// Vmul emits `MUL Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer multiply.
// Byte/halfword/word arrangements only: AArch64 has no 64-bit-element vector
// multiply, so .1d / .2d are an error.
func Vmul(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonThreeSame(a, simd.S3_MUL, arr, vd, vn, vm)
}

// --- Packed bitwise (the element size is meaningless for a bit-op, so only the vector
// width is chosen) ---

// Vand emits `AND Vd, Vn, Vm` — bitwise AND over the whole vector (.16b when
// `full`, .8b otherwise).
func Vand(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	simd.Logical(a, simd.SL_AND, full, vReg(a, vd), vReg(a, vn), vReg(a, vm))
}

// Vorr emits `ORR Vd, Vn, Vm` — bitwise OR over the whole vector.
func Vorr(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	simd.Logical(a, simd.SL_ORR, full, vReg(a, vd), vReg(a, vn), vReg(a, vm))
}

// Veor emits `EOR Vd, Vn, Vm` — bitwise XOR over the whole vector.
func Veor(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	simd.Logical(a, simd.SL_EOR, full, vReg(a, vd), vReg(a, vn), vReg(a, vm))
}
