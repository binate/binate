package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 Advanced SIMD (NEON) packed integer + bitwise instructions.
//
// V registers are the 128-bit SIMD/FP file (V0..V31, declared in aarch64.bni in
// the same +32 namespace as the D scalar regs — a V and its D name the same
// physical register, so the encoders mask with 0x1f exactly like the scalar FP
// encoders).  A packed op names its operand shape with an arrangement specifier
// (ARR_8B..ARR_2D); the encoder derives the Q bit (128- vs 64-bit vector) and
// the 2-bit element-size field from it.  Golden encodings were cross-checked
// against clang-emitted disassembly.

// arrQ returns the Q bit for arrangement `arr` — 1 for a 128-bit (full) vector,
// 0 for a 64-bit (half) vector.  The ARR_* constants are ordered (size, Q) so
// the Q selector is the low bit.
func arrQ(arr int) uint32 {
	return cast(uint32, arr & 1)
}

// arrSize returns the 2-bit element-size field for arrangement `arr`:
// 00=byte, 01=halfword, 10=word, 11=doubleword.
func arrSize(arr int) uint32 {
	return cast(uint32, (arr >> 1) & 3)
}

// qOf maps a full-vector flag to the Q bit: true → 1 (128-bit, .16b),
// false → 0 (64-bit, .8b).  Used by the bitwise ops, whose only arrangement
// choice is the vector width (the element width is meaningless for a bit-op).
func qOf(full bool) uint32 {
	if full {
		return 1
	}
	return 0
}

// neon3Same builds an "Advanced SIMD three same" instruction word:
//   0|Q|U|01110|size|1|Rm|opcode|1|Rn|Rd
// The skeleton 0x0E200400 sets the fixed bits (data-class 01110, bit 21, bit 10);
// the caller supplies Q, U, size, the 5-bit opcode, and the three registers.
func neon3Same(q uint32, u uint32, size uint32, opcode uint32, rm int, rn int, rd int) uint32 {
	var inst uint32 = cast(uint32, 0x0E200400)
	inst = inst | (q << 30) | (u << 29) | (size << 22) | (opcode << 11)
	inst = inst | (cast(uint32, rm & 0x1f) << 16)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | cast(uint32, rd & 0x1f)
	return inst
}

// --- Packed integer arithmetic (three-same) ---

// Vadd emits `ADD Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer add for
// arrangement `arr` (any of ARR_8B..ARR_2D).  opcode=10000, U=0.
func Vadd(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	emit32(a, neon3Same(arrQ(arr), 0, arrSize(arr), 0x10, vm, vn, vd))
}

// Vsub emits `SUB Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer subtract.
// opcode=10000, U=1.
func Vsub(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	emit32(a, neon3Same(arrQ(arr), 1, arrSize(arr), 0x10, vm, vn, vd))
}

// Vmul emits `MUL Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer multiply.
// opcode=10011, U=0.  Valid for byte/halfword/word arrangements only; AArch64
// has no 64-bit-element vector multiply (.1d/.2d), so the caller must not pass
// one.
func Vmul(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	emit32(a, neon3Same(arrQ(arr), 0, arrSize(arr), 0x13, vm, vn, vd))
}

// --- Packed bitwise (three-same; size field selects the logical op) ---

// Vand emits `AND Vd, Vn, Vm` — bitwise AND over the whole vector (.16b when
// `full`, .8b otherwise).  For this opcode the three-same size field selects the
// operation (00=AND), so there is no element-size choice.  opcode=00011.
func Vand(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	emit32(a, neon3Same(qOf(full), 0, 0x0, 0x03, vm, vn, vd))
}

// Vorr emits `ORR Vd, Vn, Vm` — bitwise OR (size=10 selects ORR). opcode=00011.
func Vorr(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	emit32(a, neon3Same(qOf(full), 0, 0x2, 0x03, vm, vn, vd))
}

// Veor emits `EOR Vd, Vn, Vm` — bitwise XOR (U=1, size=00). opcode=00011.
func Veor(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	emit32(a, neon3Same(qOf(full), 1, 0x0, 0x03, vm, vn, vd))
}
