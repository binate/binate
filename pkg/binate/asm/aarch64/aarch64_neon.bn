package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 Advanced SIMD (NEON) packed integer + bitwise instructions.
//
// V registers are the 128-bit SIMD/FP file (V0..V31, the same values as the D
// scalar regs — a V and its D name the same physical register); each maps to its
// field through vReg.  A packed op names its operand shape with an arrangement specifier
// (ARR_8B..ARR_2D); the encoder derives the Q bit (128- vs 64-bit vector) and
// the 2-bit element-size field from it.  Golden encodings were cross-checked
// against clang-emitted disassembly.

// arrQ returns the Q bit for arrangement `arr` — 1 for a 128-bit (full) vector,
// 0 for a 64-bit (half) vector.  The ARR_* constants are ordered (size, Q) so
// the Q selector is the low bit.
func arrQ(arr int) uint32 {
	return cast(uint32, arr & 1)
}

// arrSize returns the 2-bit element-size field for arrangement `arr`:
// 00=byte, 01=halfword, 10=word, 11=doubleword.
func arrSize(arr int) uint32 {
	return cast(uint32, (arr >> 1) & 3)
}

// qOf maps a full-vector flag to the Q bit: true → 1 (128-bit, .16b),
// false → 0 (64-bit, .8b).  Used by the bitwise ops, whose only arrangement
// choice is the vector width (the element width is meaningless for a bit-op).
func qOf(full bool) uint32 {
	if full {
		return 1
	}
	return 0
}

// Arrangement sets for neonArrOk, one bit per ARR_* value (bit n = arrangement n):
// every arrangement; all but .1d (no vector form of most integer ops); byte /
// halfword / word lanes only (no 64-bit-lane integer multiply); and the packed-FP
// arrangements .2s / .4s / .2d.
const (
	arrsAll int = 0xFF
	arrsNo1D int = 0xBF
	arrsBHS int = 0x3F
	arrsFP int = 0xB0
)

// neonArrOk reports whether arr is one of the arrangements in the set allowed (an
// arrs* mask), setting an assembler error when it is not — an out-of-set
// arrangement would otherwise encode a reserved or different instruction.
func neonArrOk(a @asm.Assembler, arr int, allowed int) bool {
	var bit int = 1
	for i := 0; i < arr; i++ { bit = bit * 2 }
	if arr < ARR_8B || arr > ARR_2D || (allowed & bit) == 0 {
		a.SetError("aarch64: arrangement not valid for this vector instruction")
		return false
	}
	return true
}

// neonLaneOk reports whether elem (ELEM_B..ELEM_D) and a lane index within a
// 128-bit vector of that element width (16 / 8 / 4 / 2 lanes) are valid, setting an
// assembler error otherwise — an out-of-range index would spill out of the imm5
// lane-select field into neighbouring bits.
func neonLaneOk(a @asm.Assembler, elem int, index int) bool {
	if elem < ELEM_B || elem > ELEM_D {
		a.SetError("aarch64: invalid vector element width")
		return false
	}
	var lanes int = 16
	for e := 0; e < elem; e++ { lanes = lanes / 2 }
	if index < 0 || index >= lanes {
		a.SetError("aarch64: vector lane index out of range for the element width")
		return false
	}
	return true
}

// emitNeon3Same emits an "Advanced SIMD three same" instruction word:
//   0|Q|U|01110|size|1|Rm|opcode|1|Rn|Rd
// The skeleton 0x0E200400 sets the fixed bits (data-class 01110, bit 21, bit 10);
// the caller supplies Q, U, size, the 5-bit opcode, and the three V registers.
func emitNeon3Same(a @asm.Assembler, q uint32, u uint32, size uint32, opcode uint32, rm int, rn int,
		rd int) {
	var inst uint32 = cast(uint32, 0x0E200400)
	inst = inst | (q << 30) | (u << 29) | (size << 22) | (opcode << 11)
	emitRmRnRd(a, inst, vReg(a, rm), vReg(a, rn), vReg(a, rd))
}

// --- Packed integer arithmetic (three-same) ---

// Vadd emits `ADD Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer add for
// arrangement `arr` (ARR_8B..ARR_2D except ARR_1D, which has no vector form).
// opcode=10000, U=0.
func Vadd(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsNo1D) { return }
	emitNeon3Same(a, arrQ(arr), 0, arrSize(arr), 0x10, vm, vn, vd)
}

// Vsub emits `SUB Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer subtract (any
// arrangement but ARR_1D).  opcode=10000, U=1.
func Vsub(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsNo1D) { return }
	emitNeon3Same(a, arrQ(arr), 1, arrSize(arr), 0x10, vm, vn, vd)
}

// Vmul emits `MUL Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise integer multiply.
// opcode=10011, U=0.  Byte/halfword/word arrangements only: AArch64 has no
// 64-bit-element vector multiply, so .1d / .2d are an error.
func Vmul(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsBHS) { return }
	emitNeon3Same(a, arrQ(arr), 0, arrSize(arr), 0x13, vm, vn, vd)
}

// --- Packed bitwise (three-same; size field selects the logical op) ---

// Vand emits `AND Vd, Vn, Vm` — bitwise AND over the whole vector (.16b when
// `full`, .8b otherwise).  For this opcode the three-same size field selects the
// operation (00=AND), so there is no element-size choice.  opcode=00011.
func Vand(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	emitNeon3Same(a, qOf(full), 0, 0x0, 0x03, vm, vn, vd)
}

// Vorr emits `ORR Vd, Vn, Vm` — bitwise OR (size=10 selects ORR). opcode=00011.
func Vorr(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	emitNeon3Same(a, qOf(full), 0, 0x2, 0x03, vm, vn, vd)
}

// Veor emits `EOR Vd, Vn, Vm` — bitwise XOR (U=1, size=00). opcode=00011.
func Veor(a @asm.Assembler, full bool, vd int, vn int, vm int) {
	emitNeon3Same(a, qOf(full), 1, 0x0, 0x03, vm, vn, vd)
}
