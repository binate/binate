package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The NEON wrappers' errors — an arrangement the instruction does not take, a value that
// is no ARR_* at all, an out-of-range lane or element width, and a non-V register each
// fail loud and emit nothing — and goldens (from clang) with V31 and the zero register
// in every field.

// failedLoud reports whether a recorded an error and emitted no bytes.
func failedLoud(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0
}

func TestNeonThreeSameFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vadd(a, ARR_1D, V0, V1, V2)
	if !failedLoud(a) { return fail("ADD .1d should error") }
	a = newAsm()
	Vsub(a, ARR_2D + 1, V0, V1, V2)
	if !failedLoud(a) { return fail("an arrangement past ARR_2D should error") }
	a = newAsm()
	Vmul(a, ARR_2D, V0, V1, V2)
	if !failedLoud(a) { return fail("MUL .2d should error") }
	a = newAsm()
	Vadd(a, -1, V0, V1, V2)
	if !failedLoud(a) { return fail("arrangement -1 should error") }
	a = newAsm()
	Vadd(a, ARR_4S, X0, V1, V2)
	if !failedLoud(a) { return fail("an X register as Vd should error") }
	a = newAsm()
	Vand(a, true, V0, X1, V2)
	if !failedLoud(a) { return fail("an X register as Vn of AND should error") }
	return ""
}

func TestNeonFPFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vfadd(a, ARR_4H, V0, V1, V2)
	if !failedLoud(a) { return fail("FADD .4h should error (the wrappers take .2s / .4s / .2d)") }
	a = newAsm()
	Vfmul(a, ARR_16B, V0, V1, V2)
	if !failedLoud(a) { return fail("FMUL .16b should error") }
	a = newAsm()
	Vfcmge(a, ARR_1D, V0, V1, V2)
	if !failedLoud(a) { return fail("FCMGE .1d should error") }
	return ""
}

func TestNeonLaneFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vdup_gp(a, ARR_1D, V0, X1)
	if !failedLoud(a) { return fail("DUP .1d should error") }
	a = newAsm()
	Vdup_elem(a, ARR_4S, V0, V1, 4)
	if !failedLoud(a) { return fail("DUP from s[4] should error") }
	a = newAsm()
	Vins_gp(a, ELEM_B, 16, V0, X1)
	if !failedLoud(a) { return fail("INS into b[16] should error") }
	a = newAsm()
	Vumov(a, ELEM_D + 1, X0, V1, 0)
	if !failedLoud(a) { return fail("UMOV of element width 4 should error") }
	a = newAsm()
	Vumov(a, ELEM_D, X0, V1, 2)
	if !failedLoud(a) { return fail("UMOV from d[2] should error") }
	a = newAsm()
	Vdup_gp(a, ARR_4S, V0, SP)
	if !failedLoud(a) { return fail("DUP from SP should error") }
	return ""
}

// A value that is no ARR_* must not be masked into one (9 would read as .16b, 12 as
// .2s): every wrapper rejects it.
func TestNeonNotAnArrangement() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmovi(a, 9, V0, 0, 0)
	if !failedLoud(a) { return fail("MOVI of arrangement 9 should error") }
	a = newAsm()
	Vmvni(a, 11, V0, 0, 0)
	if !failedLoud(a) { return fail("MVNI of arrangement 11 should error") }
	a = newAsm()
	Vmvni_msl(a, 12, V0, 0, 8)
	if !failedLoud(a) { return fail("MVNI MSL of arrangement 12 should error") }
	a = newAsm()
	Vmovi_msl(a, -3, V0, 0, 8)
	if !failedLoud(a) { return fail("MOVI MSL of arrangement -3 should error") }
	a = newAsm()
	Vfmov_imm(a, -1, V0, 0x70)
	if !failedLoud(a) { return fail("FMOV of arrangement -1 should error") }
	a = newAsm()
	Vld1(a, 8, V0, X0)
	if !failedLoud(a) { return fail("LD1 of arrangement 8 should error") }
	a = newAsm()
	Vdup_elem(a, ARR_1D, V0, V1, 0)
	if !failedLoud(a) { return fail("DUP .1d from an element should error") }
	a = newAsm()
	Vmvni_msl(a, ARR_4H, V0, 0, 8)
	if !failedLoud(a) { return fail("MVNI MSL on .4h should error") }
	a = newAsm()
	Vmovi(a, ARR_2D, V0, 0, 0)
	if !failedLoud(a) || !rejected(a, "Vmovi_2d") { return fail("MOVI .2d should point at Vmovi_2d") }
	return ""
}

func TestNeonV31AndZeroRegister() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vumov(a, ELEM_S, XZR, V31, 3)
	var r testing.TestResult = wantWord(a, 0x0E1C3FFF, "umov wzr, v31.s[3]")
	if len(r) > 0 { return r }
	a = newAsm()
	Vumov(a, ELEM_D, XZR, V31, 1)
	r = wantWord(a, 0x4E183FFF, "mov xzr, v31.d[1]")
	if len(r) > 0 { return r }
	a = newAsm()
	Vfsub(a, ARR_2S, V31, V0, V31)
	r = wantWord(a, 0x0EBFD41F, "fsub v31.2s, v0.2s, v31.2s")
	if len(r) > 0 { return r }
	a = newAsm()
	Vfmul(a, ARR_2S, V31, V0, V31)
	r = wantWord(a, 0x2E3FDC1F, "fmul v31.2s, v0.2s, v31.2s")
	if len(r) > 0 { return r }
	a = newAsm()
	Vfdiv(a, ARR_2S, V31, V0, V31)
	r = wantWord(a, 0x2E3FFC1F, "fdiv v31.2s, v0.2s, v31.2s")
	if len(r) > 0 { return r }
	a = newAsm()
	Vfcmeq(a, ARR_2S, V31, V0, V31)
	r = wantWord(a, 0x0E3FE41F, "fcmeq v31.2s, v0.2s, v31.2s")
	if len(r) > 0 { return r }
	a = newAsm()
	Vfcmgt(a, ARR_2S, V31, V0, V31)
	r = wantWord(a, 0x2EBFE41F, "fcmgt v31.2s, v0.2s, v31.2s")
	if len(r) > 0 { return r }
	a = newAsm()
	Vfcmge(a, ARR_2S, V31, V0, V31)
	r = wantWord(a, 0x2E3FE41F, "fcmge v31.2s, v0.2s, v31.2s")
	if len(r) > 0 { return r }
	a = newAsm()
	Vadd(a, ARR_16B, V31, V0, V31)
	r = wantWord(a, 0x4E3F841F, "add v31.16b, v0.16b, v31.16b")
	if len(r) > 0 { return r }
	a = newAsm()
	Veor(a, true, V31, V0, V31)
	r = wantWord(a, 0x6E3F1C1F, "eor v31.16b, v0.16b, v31.16b")
	if len(r) > 0 { return r }
	a = newAsm()
	Vmovi(a, ARR_4S, V31, 255, 24)
	r = wantWord(a, 0x4F0767FF, "movi v31.4s, #255, lsl #24")
	if len(r) > 0 { return r }
	a = newAsm()
	Vdup_elem(a, ARR_8H, V31, V0, 7)
	return wantWord(a, 0x4E1E041F, "dup v31.8h, v0.h[7]")
}
