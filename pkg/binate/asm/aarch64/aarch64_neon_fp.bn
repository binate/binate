package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 Advanced SIMD (NEON) packed floating-point instructions.
//
// The FP three-same format is  0|Q|U|01110|0|sz|1|Rm|opcode|1|Rn|Rd , where sz
// (bit 22) picks single (.2s/.4s) vs double (.2d) elements and Q picks the
// vector width.  Valid arrangements are ARR_2S, ARR_4S, and ARR_2D only (there
// is no packed FP for byte/halfword elements, nor a .1d vector form).  Compares
// (FCMEQ/FCMGT/FCMGE) write an all-ones / all-zeros mask per lane, as on the
// scalar side.  Golden encodings were cross-checked against clang.

// emitVfp3Same emits an FP three-same word from a (Q=0, sz=0) base plus the
// arrangement's Q and sz (sz=1 exactly for the .2d / doubleword arrangement).
func emitVfp3Same(a @asm.Assembler, base uint32, arr int, vd int, vn int, vm int) {
	var inst uint32 = base | (arrQ(arr) << 30)
	if arrSize(arr) == 3 {
		inst = inst | cast(uint32, 0x00400000) // sz=1 (double-precision lanes)
	}
	emitRmRnRd(a, inst, vReg(a, vm), vReg(a, vn), vReg(a, vd))
}

// Vfadd emits `FADD Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP add.
func Vfadd(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x0E20D400), arr, vd, vn, vm)
}

// Vfsub emits `FSUB Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP subtract.
func Vfsub(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x0EA0D400), arr, vd, vn, vm)
}

// Vfmul emits `FMUL Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP multiply.
func Vfmul(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x2E20DC00), arr, vd, vn, vm)
}

// Vfdiv emits `FDIV Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP divide.
func Vfdiv(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x2E20FC00), arr, vd, vn, vm)
}

// Vfcmeq emits `FCMEQ Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP compare-equal;
// each lane becomes all-ones (true) or all-zeros (false).
func Vfcmeq(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x0E20E400), arr, vd, vn, vm)
}

// Vfcmgt emits `FCMGT Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP compare
// greater-than (Vn > Vm).
func Vfcmgt(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x2EA0E400), arr, vd, vn, vm)
}

// Vfcmge emits `FCMGE Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP compare
// greater-than-or-equal (Vn >= Vm).
func Vfcmge(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	if !neonArrOk(a, arr, arrsFP) { return }
	emitVfp3Same(a, cast(uint32, 0x2E20E400), arr, vd, vn, vm)
}
