package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD (NEON) packed floating-point instructions for the native
// backend, each encoded by the exact isa/simd encoder.  Valid arrangements are ARR_2S,
// ARR_4S (single-precision lanes) and ARR_2D (double); there is no .1d vector form.
// Compares (FCMEQ/FCMGT/FCMGE) write an all-ones / all-zeros mask per lane, as on the
// scalar side.

// neonFPArr returns packed-FP arrangement arr's 128-bit flag and precision — isa.FT_S
// for .2s / .4s, isa.FT_D for .2d (and for .1d, which the encoders then reject) — or
// ok=false (with an assembler error) for a byte or halfword arrangement.
func neonFPArr(a @asm.Assembler, arr int) (bool, int, bool) {
	q, size, ok := neonArr(a, arr)
	if !ok { return false, 0, false }
	if size < 2 {
		a.SetError("aarch64: packed FP takes .2s / .4s / .2d")
		return false, 0, false
	}
	if size == 3 { return q, isa.FT_D, true }
	return q, isa.FT_S, true
}

// neonFPThreeSame emits a floating-point three-same operation (a simd.F3_* value) on
// arrangement arr.
func neonFPThreeSame(a @asm.Assembler, op int, arr int, vd int, vn int, vm int) {
	q, ft, ok := neonFPArr(a, arr)
	if !ok { return }
	simd.FPThreeSame(a, op, q, ft, vReg(a, vd), vReg(a, vn), vReg(a, vm))
}

// Vfadd emits `FADD Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP add.
func Vfadd(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FADD, arr, vd, vn, vm)
}

// Vfsub emits `FSUB Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP subtract.
func Vfsub(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FSUB, arr, vd, vn, vm)
}

// Vfmul emits `FMUL Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP multiply.
func Vfmul(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FMUL, arr, vd, vn, vm)
}

// Vfdiv emits `FDIV Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP divide.
func Vfdiv(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FDIV, arr, vd, vn, vm)
}

// Vfcmeq emits `FCMEQ Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP compare-equal;
// each lane becomes all-ones (true) or all-zeros (false).
func Vfcmeq(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FCMEQ, arr, vd, vn, vm)
}

// Vfcmgt emits `FCMGT Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP compare
// greater-than (Vn > Vm).
func Vfcmgt(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FCMGT, arr, vd, vn, vm)
}

// Vfcmge emits `FCMGE Vd.<T>, Vn.<T>, Vm.<T>` — lane-wise FP compare
// greater-than-or-equal (Vn >= Vm).
func Vfcmge(a @asm.Assembler, arr int, vd int, vn int, vm int) {
	neonFPThreeSame(a, simd.F3_FCMGE, arr, vd, vn, vm)
}
