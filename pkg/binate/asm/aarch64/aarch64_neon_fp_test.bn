package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the NEON packed floating-point encoders in
// aarch64_neon_fp.bn.  Expected words come from clang-assembled machine code
// (otool -s); cases cover the .4s / .2d / .2s arrangements with distinct
// Vd/Vn/Vm registers to catch field swaps.

func TestVfadd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vfadd(a, ARR_4S, V0, V1, V2) // fadd v0.4s, v1.4s, v2.4s
	Vfadd(a, ARR_2D, V3, V4, V5) // fadd v3.2d, v4.2d, v5.2d
	Vfadd(a, ARR_2S, V6, V7, V8) // fadd v6.2s, v7.2s, v8.2s
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4E22D420) {
		return fail("FADD v0.4s encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4E65D483) {
		return fail("FADD v3.2d encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x0E28D4E6) {
		return fail("FADD v6.2s encoding wrong")
	}
	return ""
}

func TestVfsub() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vfsub(a, ARR_4S, V0, V1, V2)
	Vfsub(a, ARR_2D, V3, V4, V5)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4EA2D420) {
		return fail("FSUB v0.4s encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4EE5D483) {
		return fail("FSUB v3.2d encoding wrong")
	}
	return ""
}

