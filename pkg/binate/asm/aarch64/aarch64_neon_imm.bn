package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 Advanced SIMD (NEON) modified-immediate instructions: MOVI, MVNI, and
// the vector-immediate form of FMOV.
//
// All share the "modified immediate" format
//   0|Q|op|0111100000|abc|cmode|01|defgh|Rd   (skeleton 0x0F000400),
// where the 4-bit cmode (with op) selects how the 8-bit immediate abcdefgh is
// expanded into each lane:
//   - MOVI shifted: byte (.8b/.16b, cmode 1110), halfword (.4h/.8h, LSL #0/#8),
//     word (.2s/.4s, LSL #0/#8/#16/#24);
//   - MOVI word MSL (.2s/.4s, MSL #8/#16 — ones shifted in);
//   - MOVI .2d (each imm8 bit expands to a 0x00/0xFF byte);
//   - MVNI: the halfword/word shifted and MSL forms, bitwise-inverted (op=1);
//   - FMOV: an 8-bit FP immediate broadcast to .2s/.4s (single) or .2d (double).
// Golden encodings were cross-checked against clang.  Invalid element/shift
// combinations fail loud (SetError) rather than encoding a wrong cmode.

// vecImmEnc builds a modified-immediate word from the Q/op/cmode selectors and
// the 8-bit immediate (split into abc = bits 18:16 and defgh = bits 9:5).
func vecImmEnc(q uint32, op uint32, cmode uint32, imm8 int, rd int) uint32 {
	var inst uint32 = cast(uint32, 0x0F000400)
	inst = inst | (q << 30) | (op << 29) | (cmode << 12)
	inst = inst | (cast(uint32, (imm8 >> 5) & 7) << 16)
	inst = inst | (cast(uint32, imm8 & 0x1f) << 5)
	inst = inst | fpRegBits(rd)
	return inst
}

// shiftedCmodeOrFail computes the cmode nibble for a shifted MOVI/MVNI given the
// element width and LSL shift, or reports failure via SetError and returns 0.
// Byte elements use cmode 1110 (no shift); halfword LSL #0/#8; word LSL
// #0/#8/#16/#24.  `allowByte` is false for MVNI (which has no byte form).
func shiftedCmodeOrFail(a @asm.Assembler, elem uint32, shift int, allowByte bool) uint32 {
	if elem == 0 {
		if !allowByte {
			a.SetError("aarch64: MVNI has no byte (.8b/.16b) form")
			return 0
		}
		if shift != 0 {
			a.SetError("aarch64: MOVI byte form takes no shift")
			return 0
		}
		return cast(uint32, 0xE)
	}
	if elem == 1 {
		if shift != 0 && shift != 8 {
			a.SetError("aarch64: MOVI/MVNI halfword shift must be 0 or 8")
			return 0
		}
		return cast(uint32, 0x8) | (cast(uint32, shift / 8) << 1)
	}
	if elem == 2 {
		if shift != 0 && shift != 8 && shift != 16 && shift != 24 {
			a.SetError("aarch64: MOVI/MVNI word shift must be 0, 8, 16, or 24")
			return 0
		}
		return cast(uint32, shift / 8) << 1
	}
	a.SetError("aarch64: MOVI/MVNI has no .1d/.2d shifted form (use Vmovi_2d)")
	return 0
}

// mslCmodeOrFail computes the cmode for a word MSL MOVI/MVNI (MSL #8 → 1100,
// MSL #16 → 1101), or fails loud.  MSL exists only for word (.2s/.4s).
func mslCmodeOrFail(a @asm.Assembler, elem uint32, mslAmt int) uint32 {
	if elem != 2 {
		a.SetError("aarch64: MOVI/MVNI MSL is word-only (.2s/.4s)")
		return 0
	}
	if mslAmt == 8 {
		return cast(uint32, 0xC)
	}
	if mslAmt == 16 {
		return cast(uint32, 0xD)
	}
	a.SetError("aarch64: MOVI/MVNI MSL amount must be 8 or 16")
	return 0
}

// imm8InRange reports whether imm8 fits the 8-bit immediate field, failing loud
// (SetError) if not.
func imm8InRange(a @asm.Assembler, imm8 int) bool {
	if imm8 < 0 || imm8 > 255 {
		a.SetError("aarch64: modified-immediate imm8 out of range 0..255")
		return false
	}
	return true
}

// Vmovi emits `MOVI Vd.<T>, #imm8 {, LSL #shift}` — the shifted modified
// immediate.  Element width comes from `arr`: byte (.8b/.16b, shift 0),
// halfword (.4h/.8h, shift 0/8), word (.2s/.4s, shift 0/8/16/24).  Use Vmovi_2d
// for the 64-bit form and Vmovi_msl for the word MSL form.
func Vmovi(a @asm.Assembler, arr int, vd int, imm8 int, shift int) {
	if !imm8InRange(a, imm8) {
		return
	}
	var cmode uint32 = shiftedCmodeOrFail(a, arrSize(arr), shift, true)
	if a.HasError {
		return
	}
	emit32(a, vecImmEnc(arrQ(arr), 0, cmode, imm8, vd))
}

// Vmovi_msl emits `MOVI Vd.<2s|4s>, #imm8, MSL #amt` — a word immediate with
// `amt` low bits set to ones (MSL #8 or #16).
func Vmovi_msl(a @asm.Assembler, arr int, vd int, imm8 int, mslAmt int) {
	if !imm8InRange(a, imm8) {
		return
	}
	var cmode uint32 = mslCmodeOrFail(a, arrSize(arr), mslAmt)
	if a.HasError {
		return
	}
	emit32(a, vecImmEnc(arrQ(arr), 0, cmode, imm8, vd))
}

// Vmvni emits `MVNI Vd.<T>, #imm8 {, LSL #shift}` — the bitwise-inverted shifted
// immediate (halfword/word only; no byte or .2d form).
func Vmvni(a @asm.Assembler, arr int, vd int, imm8 int, shift int) {
	if !imm8InRange(a, imm8) {
		return
	}
	var cmode uint32 = shiftedCmodeOrFail(a, arrSize(arr), shift, false)
	if a.HasError {
		return
	}
	emit32(a, vecImmEnc(arrQ(arr), 1, cmode, imm8, vd))
}

// Vmvni_msl emits `MVNI Vd.<2s|4s>, #imm8, MSL #amt` — the inverted word MSL form.
func Vmvni_msl(a @asm.Assembler, arr int, vd int, imm8 int, mslAmt int) {
	if !imm8InRange(a, imm8) {
		return
	}
	var cmode uint32 = mslCmodeOrFail(a, arrSize(arr), mslAmt)
	if a.HasError {
		return
	}
	emit32(a, vecImmEnc(arrQ(arr), 1, cmode, imm8, vd))
}

// Vmovi_2d emits `MOVI Vd.2d, #imm64` — the 64-bit-per-lane form, where every
// byte of imm64 must be 0x00 or 0xFF (each imm8 bit selects a byte's value).
// Fails loud if any byte is neither.
func Vmovi_2d(a @asm.Assembler, vd int, imm64 uint64) {
	var imm8 int = 0
	for i := 0; i < 8; i++ {
		var b uint64 = (imm64 >> cast(uint64, i * 8)) & cast(uint64, 0xff)
		if b == cast(uint64, 0xff) {
			imm8 = imm8 | (1 << i)
		} else if b != cast(uint64, 0) {
			a.SetError("aarch64: MOVI.2d requires every byte to be 0x00 or 0xFF")
			return
		}
	}
	emit32(a, vecImmEnc(1, 1, cast(uint32, 0xE), imm8, vd))
}

// Vfmov_imm emits `FMOV Vd.<T>, #<fp>` — broadcast an 8-bit FP immediate to
// every lane.  `arr` selects single (.2s/.4s) or double (.2d) precision; `fp8`
// is the 8-bit FP immediate encoding (abcdefgh) of the value.
func Vfmov_imm(a @asm.Assembler, arr int, vd int, fp8 int) {
	if fp8 < 0 || fp8 > 255 {
		a.SetError("aarch64: FMOV fp8 out of range 0..255")
		return
	}
	var elem uint32 = arrSize(arr)
	var op uint32 = 0
	if elem == 3 {
		if arrQ(arr) == 0 {
			a.SetError("aarch64: FMOV .1d is not a valid vector-immediate form")
			return
		}
		op = 1
	} else if elem != 2 {
		a.SetError("aarch64: FMOV vector immediate is .2s/.4s/.2d only")
		return
	}
	emit32(a, vecImmEnc(arrQ(arr), op, cast(uint32, 0xF), fp8, vd))
}
