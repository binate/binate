package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the NEON modified-immediate encoders in
// aarch64_neon_imm.bn (MOVI/MVNI/FMOV).  Expected words come from clang; cases
// span every element width, shift, MSL, the .2d byte-mask, MVNI, and FMOV, plus
// the fail-loud paths for invalid element/shift/imm combinations.

func TestVmovi() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmovi(a, ARR_16B, V1, 0, 0) // movi v1.16b, #0
	Vmovi(a, ARR_8B, V3, 0xff, 0) // movi v3.8b, #0xff
	Vmovi(a, ARR_4S, V5, 0x34, 16) // movi v5.4s, #0x34, lsl #16
	Vmovi(a, ARR_8H, V7, 0x56, 8) // movi v7.8h, #0x56, lsl #8
	Vmovi(a, ARR_4H, V9, 0x78, 0) // movi v9.4h, #0x78
	Vmovi(a, ARR_2S, V2, 0x9a, 24) // movi v2.2s, #0x9a, lsl #24
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4F00E401) {
		return fail("MOVI v1.16b, #0 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x0F07E7E3) {
		return fail("MOVI v3.8b, #0xff encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4F014685) {
		return fail("MOVI v5.4s, #0x34, lsl #16 encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4F02A6C7) {
		return fail("MOVI v7.8h, #0x56, lsl #8 encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x0F038709) {
		return fail("MOVI v9.4h, #0x78 encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x0F046742) {
		return fail("MOVI v2.2s, #0x9a, lsl #24 encoding wrong")
	}
	if a.HasError { return fail("valid MOVI should not error") }
	return ""
}

func TestVmoviMsl() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmovi_msl(a, ARR_4S, V4, 0xbc, 16) // movi v4.4s, #0xbc, msl #16
	Vmovi_msl(a, ARR_4S, V0, 0x12, 8) // movi v0.4s, #0x12, msl #8
	Vmovi_msl(a, ARR_2S, V0, 0x12, 8) // movi v0.2s, #0x12, msl #8
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4F05D784) {
		return fail("MOVI v4.4s, #0xbc, msl #16 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4F00C640) {
		return fail("MOVI v0.4s, #0x12, msl #8 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x0F00C640) {
		return fail("MOVI v0.2s, #0x12, msl #8 encoding wrong")
	}
	return ""
}

func TestVmvni() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmvni(a, ARR_4S, V4, 0xbc, 16) // mvni v4.4s, #0xbc, lsl #16
	Vmvni(a, ARR_8H, V6, 0xde, 0) // mvni v6.8h, #0xde
	Vmvni(a, ARR_4S, V0, 0x12, 0) // mvni v0.4s, #0x12
	if readInst(a.Sections[0], 0) != cast(uint32, 0x6F054784) {
		return fail("MVNI v4.4s, #0xbc, lsl #16 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x6F0687C6) {
		return fail("MVNI v6.8h, #0xde encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x6F000640) {
		return fail("MVNI v0.4s, #0x12 encoding wrong")
	}
	return ""
}

func TestVmvniMsl() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmvni_msl(a, ARR_2S, V11, 0x22, 8) // mvni v11.2s, #0x22, msl #8
	Vmvni_msl(a, ARR_4S, V0, 0x12, 8) // mvni v0.4s, #0x12, msl #8
	if readInst(a.Sections[0], 0) != cast(uint32, 0x2F01C44B) {
		return fail("MVNI v11.2s, #0x22, msl #8 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x6F00C640) {
		return fail("MVNI v0.4s, #0x12, msl #8 encoding wrong")
	}
	return ""
}

func TestVmovi2d() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmovi_2d(a, V0, cast(uint64, 0xff00ff00ff00ff00)) // movi v0.2d, #0xff00ff00ff00ff00
	Vmovi_2d(a, V8, cast(uint64, 0x00ff00ff00ff00ff)) // movi v8.2d, #0x00ff00ff00ff00ff
	Vmovi_2d(a, V0, cast(uint64, 0) - cast(uint64, 1)) // movi v0.2d, #0xffffffffffffffff
	if readInst(a.Sections[0], 0) != cast(uint32, 0x6F05E540) {
		return fail("MOVI v0.2d, #0xff00ff00ff00ff00 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x6F02E6A8) {
		return fail("MOVI v8.2d, #0x00ff00ff00ff00ff encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x6F07E7E0) {
		return fail("MOVI v0.2d, #0xffffffffffffffff encoding wrong")
	}
	if a.HasError { return fail("valid MOVI.2d should not error") }
	return ""
}

func TestVfmovImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vfmov_imm(a, ARR_4S, V0, 0x70) // fmov v0.4s, #1.0
	Vfmov_imm(a, ARR_2S, V13, 0x70) // fmov v13.2s, #1.0
	Vfmov_imm(a, ARR_2D, V10, 0x00) // fmov v10.2d, #2.0
	Vfmov_imm(a, ARR_4S, V12, 0xf0) // fmov v12.4s, #-1.0
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4F03F600) {
		return fail("FMOV v0.4s, #1.0 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x0F03F60D) {
		return fail("FMOV v13.2s, #1.0 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x6F00F40A) {
		return fail("FMOV v10.2d, #2.0 encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4F07F60C) {
		return fail("FMOV v12.4s, #-1.0 encoding wrong")
	}
	return ""
}

// Invalid element/shift/imm combinations must fail loud, not mis-encode.
func TestVmoviFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmovi(a, ARR_4S, V0, 0x12, 12) // word shift must be 0/8/16/24
	if !a.HasError { return fail("MOVI word invalid shift should error") }

	var b @asm.Assembler = newAsm()
	Vmovi(b, ARR_16B, V0, 0x12, 8) // byte form takes no shift
	if !b.HasError { return fail("MOVI byte with shift should error") }

	var c @asm.Assembler = newAsm()
	Vmovi(c, ARR_2D, V0, 0x12, 0) // no shifted .2d MOVI
	if !c.HasError { return fail("MOVI .2d via Vmovi should error") }

	var d @asm.Assembler = newAsm()
	Vmvni(d, ARR_16B, V0, 0x12, 0) // MVNI has no byte form
	if !d.HasError { return fail("MVNI byte should error") }

	var e @asm.Assembler = newAsm()
	Vmovi_2d(e, V0, cast(uint64, 0x0102030405060708)) // bytes not 0x00/0xFF
	if !e.HasError { return fail("MOVI.2d non-mask byte should error") }

	var f @asm.Assembler = newAsm()
	Vfmov_imm(f, ARR_8H, V0, 0x70) // FMOV is .2s/.4s/.2d only
	if !f.HasError { return fail("FMOV halfword should error") }

	var g @asm.Assembler = newAsm()
	Vmovi(g, ARR_4S, V0, 256, 0) // imm8 out of range
	if !g.HasError { return fail("MOVI imm8 out of range should error") }
	return ""
}

// Further fail-loud coverage: FMOV .1d and fp8 range, MSL on a non-word
// arrangement / invalid amount, and the shifted forms on ARR_1D.
func TestVmoviImmMoreFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vfmov_imm(a, ARR_1D, V0, 0x70) // .1d is not a valid FMOV vector form
	if !a.HasError { return fail("FMOV .1d should error") }

	var b @asm.Assembler = newAsm()
	Vfmov_imm(b, ARR_4S, V0, 256) // fp8 out of range
	if !b.HasError { return fail("FMOV fp8 out of range should error") }

	var c @asm.Assembler = newAsm()
	Vmovi_msl(c, ARR_8H, V0, 0x12, 8) // MSL is word-only
	if !c.HasError { return fail("MOVI MSL on halfword should error") }

	var d @asm.Assembler = newAsm()
	Vmovi_msl(d, ARR_4S, V0, 0x12, 24) // MSL amount must be 8 or 16
	if !d.HasError { return fail("MOVI MSL amount 24 should error") }

	var e @asm.Assembler = newAsm()
	Vmovi(e, ARR_1D, V0, 0x12, 0) // no shifted .1d MOVI
	if !e.HasError { return fail("MOVI .1d should error") }

	var f @asm.Assembler = newAsm()
	Vmvni(f, ARR_1D, V0, 0x12, 0) // no shifted .1d MVNI
	if !f.HasError { return fail("MVNI .1d should error") }
	return ""
}
