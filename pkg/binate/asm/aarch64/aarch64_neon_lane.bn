package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 Advanced SIMD (NEON) lane operations: move data between GP registers
// and vector lanes, broadcast, and materialize byte immediates.
//
//   DUP (general)  — broadcast a GP register to every lane.
//   DUP (element)  — broadcast one vector lane to every lane.
//   INS (general)  — insert a GP register into one lane (read-modify-write).
//   UMOV           — extract one lane into a GP register (zero-extended).
//   MOVI (byte)    — set every byte lane to an 8-bit immediate (zeroing is #0).
//
// Golden encodings were cross-checked against clang-emitted machine code.

// laneImm5 computes the imm5 lane-select field for DUP-element / INS / UMOV: the
// element width `elem` (ELEM_B..ELEM_D) picks the low marker bit (1<<elem) and
// the lane `index` shifts in above it.
func laneImm5(elem int, index int) uint32 {
	return cast(uint32, (index << (elem + 1)) | (1 << elem))
}

// Vdup_gp emits `DUP Vd.<T>, <R>` — broadcast a GP register to every lane of
// arrangement `arr`.  The imm5 field (1<<size) selects the element width; Q
// selects the vector width.
func Vdup_gp(a @asm.Assembler, arr int, vd int, rn int) {
	var imm5 uint32 = cast(uint32, 1) << arrSize(arr)
	var inst uint32 = cast(uint32, 0x0E000C00)
	inst = inst | (arrQ(arr) << 30) | (imm5 << 16)
	inst = inst | (cast(uint32, rn & 0x1f) << 5) | fpRegBits(vd)
	emit32(a, inst)
}

// Vdup_elem emits `DUP Vd.<T>, Vn.<Ts>[index]` — broadcast one lane of Vn to
// every lane of Vd.  The source element width is taken from the destination
// arrangement (they must match).
func Vdup_elem(a @asm.Assembler, arr int, vd int, vn int, index int) {
	var inst uint32 = cast(uint32, 0x0E000400)
	inst = inst | (arrQ(arr) << 30) | (laneImm5(cast(int, arrSize(arr)), index) << 16)
	inst = inst | (fpRegBits(vn) << 5) | fpRegBits(vd)
	emit32(a, inst)
}

// Vins_gp emits `INS Vd.<Ts>[index], <R>` — insert a GP register into one lane
// of Vd, preserving the other lanes.  `elem` is the element width (ELEM_B..D);
// the encoding is always full-register (no Q choice).
func Vins_gp(a @asm.Assembler, elem int, index int, vd int, rn int) {
	var inst uint32 = cast(uint32, 0x4E001C00)
	inst = inst | (laneImm5(elem, index) << 16)
	inst = inst | (cast(uint32, rn & 0x1f) << 5) | fpRegBits(vd)
	emit32(a, inst)
}

// Vumov emits `UMOV <R>, Vn.<Ts>[index]` — extract one lane of Vn into a GP
// register, zero-extended.  A 64-bit (ELEM_D) extract targets an X register and
// sets Q; narrower widths target a W register with Q=0.
func Vumov(a @asm.Assembler, elem int, rd int, vn int, index int) {
	var q uint32 = 0
	if elem == ELEM_D {
		q = 1
	}
	var inst uint32 = cast(uint32, 0x0E003C00)
	inst = inst | (q << 30) | (laneImm5(elem, index) << 16)
	inst = inst | (fpRegBits(vn) << 5) | cast(uint32, rd & 0x1f)
	emit32(a, inst)
}

// Vmovi_byte emits `MOVI Vd.<16b|8b>, #imm8` — set every byte lane to imm8
// (cmode=1110 byte-replicate).  `full` selects .16b over .8b.  imm8=0 zeroes the
// whole register — the MemZero / accumulator-init building block.  The 8-bit
// immediate splits into abc (bits 18:16) and defgh (bits 9:5).
func Vmovi_byte(a @asm.Assembler, full bool, vd int, imm8 int) {
	var abc uint32 = cast(uint32, (imm8 >> 5) & 7)
	var defgh uint32 = cast(uint32, imm8 & 0x1f)
	var inst uint32 = cast(uint32, 0x0F00E400)
	inst = inst | (qOf(full) << 30) | (abc << 16) | (defgh << 5) | fpRegBits(vd)
	emit32(a, inst)
}
