package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the NEON lane operations in aarch64_neon_lane.bn.
// Expected words come from clang-assembled machine code (otool -s); cases vary
// the arrangement/element width, lane index, and registers.

func TestVdupGp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vdup_gp(a, ARR_4S, V0, X0) // dup v0.4s, w0
	Vdup_gp(a, ARR_2D, V3, X5) // dup v3.2d, x5
	Vdup_gp(a, ARR_16B, V7, X9) // dup v7.16b, w9
	Vdup_gp(a, ARR_8H, V2, X4) // dup v2.8h, w4
	Vdup_gp(a, ARR_2S, V1, X6) // dup v1.2s, w6
	Vdup_gp(a, ARR_8B, V4, X8) // dup v4.8b, w8
	Vdup_gp(a, ARR_4H, V6, X10) // dup v6.4h, w10
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4E040C00) {
		return fail("DUP v0.4s, w0 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4E080CA3) {
		return fail("DUP v3.2d, x5 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4E010D27) {
		return fail("DUP v7.16b, w9 encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4E020C82) {
		return fail("DUP v2.8h, w4 encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x0E040CC1) {
		return fail("DUP v1.2s, w6 encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x0E010D04) {
		return fail("DUP v4.8b, w8 encoding wrong")
	}
	if readInst(a.Sections[0], 24) != cast(uint32, 0x0E020D46) {
		return fail("DUP v6.4h, w10 encoding wrong")
	}
	return ""
}

func TestVdupElem() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vdup_elem(a, ARR_4S, V0, V1, 0) // dup v0.4s, v1.s[0]
	Vdup_elem(a, ARR_4S, V3, V4, 3) // dup v3.4s, v4.s[3]
	Vdup_elem(a, ARR_2D, V5, V6, 1) // dup v5.2d, v6.d[1]
	Vdup_elem(a, ARR_8B, V7, V8, 5) // dup v7.8b, v8.b[5]
	Vdup_elem(a, ARR_8H, V9, V10, 7) // dup v9.8h, v10.h[7]
	Vdup_elem(a, ARR_16B, V0, V1, 15) // dup v0.16b, v1.b[15] (max byte index)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4E040420) {
		return fail("DUP v0.4s, v1.s[0] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4E1C0483) {
		return fail("DUP v3.4s, v4.s[3] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4E1804C5) {
		return fail("DUP v5.2d, v6.d[1] encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x0E0B0507) {
		return fail("DUP v7.8b, v8.b[5] encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x4E1E0549) {
		return fail("DUP v9.8h, v10.h[7] encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x4E1F0420) {
		return fail("DUP v0.16b, v1.b[15] encoding wrong")
	}
	return ""
}

func TestVinsGp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vins_gp(a, ELEM_S, 0, V0, X0) // ins v0.s[0], w0
	Vins_gp(a, ELEM_S, 1, V0, X2) // ins v0.s[1], w2
	Vins_gp(a, ELEM_B, 7, V3, X9) // ins v3.b[7], w9
	Vins_gp(a, ELEM_D, 1, V5, X11) // ins v5.d[1], x11
	Vins_gp(a, ELEM_H, 3, V2, X4) // ins v2.h[3], w4
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4E041C00) {
		return fail("INS v0.s[0], w0 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4E0C1C40) {
		return fail("INS v0.s[1], w2 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4E0F1D23) {
		return fail("INS v3.b[7], w9 encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4E181D65) {
		return fail("INS v5.d[1], x11 encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x4E0E1C82) {
		return fail("INS v2.h[3], w4 encoding wrong")
	}
	return ""
}

func TestVumov() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vumov(a, ELEM_S, X0, V0, 0) // umov w0, v0.s[0]
	Vumov(a, ELEM_D, X0, V0, 1) // umov x0, v0.d[1]
	Vumov(a, ELEM_B, X3, V4, 5) // umov w3, v4.b[5]
	Vumov(a, ELEM_H, X7, V8, 2) // umov w7, v8.h[2]
	if readInst(a.Sections[0], 0) != cast(uint32, 0x0E043C00) {
		return fail("UMOV w0, v0.s[0] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4E183C00) {
		return fail("UMOV x0, v0.d[1] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x0E0B3C83) {
		return fail("UMOV w3, v4.b[5] encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x0E0A3D07) {
		return fail("UMOV w7, v8.h[2] encoding wrong")
	}
	return ""
}

func TestVmoviByte() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmovi_byte(a, true, V0, 0) // movi v0.16b, #0
	Vmovi_byte(a, false, V3, 0) // movi v3.8b, #0
	Vmovi_byte(a, true, V0, 0xff) // movi v0.16b, #0xff
	Vmovi_byte(a, true, V5, 0x3c) // movi v5.16b, #0x3c
	Vmovi_byte(a, false, V9, 0x81) // movi v9.8b, #0x81
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4F00E400) {
		return fail("MOVI v0.16b, #0 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x0F00E403) {
		return fail("MOVI v3.8b, #0 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4F07E7E0) {
		return fail("MOVI v0.16b, #0xff encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4F01E785) {
		return fail("MOVI v5.16b, #0x3c encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x0F04E429) {
		return fail("MOVI v9.8b, #0x81 encoding wrong")
	}
	return ""
}
