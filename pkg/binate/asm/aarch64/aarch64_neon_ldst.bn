package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD (NEON) vector loads and stores for the native backend, each
// encoded by the exact isa / isa/simd encoder.
//
// Two families:
//   - LDR/STR q, LDP/STP q — plain 128-bit transfers of a V register's raw
//     bytes (no arrangement); the workhorses for spilling vectors and for wide
//     memory copy/zero loops.  Offset and post-index forms.
//   - LD1/ST1 — arrangement-typed loads/stores of one to four consecutive
//     registers; base and post-index-by-transfer-size forms.
// Vt is a V register (V0..V31, mapped through vReg); the base is an X register or SP.

// --- LDR/STR q (128-bit, unsigned scaled offset) ---

// qSpec returns the LS_* spec of a 128-bit Q load or store.
func qSpec(isLoad bool) uint32 {
	if isLoad { return isa.LS_LDR_Q }
	return isa.LS_STR_Q
}

// emitVLdrStrQ emits an LDR/STR q at [base, #off], picking the encoding by off:
//   - non-negative, 16-aligned, within the scaled imm12 → LDR/STR q (scaled);
//   - within the signed 9-bit range → LDUR/STUR q (unscaled) — this covers small
//     NEGATIVE and non-16-aligned offsets the scaled form cannot represent;
//   - otherwise form base±off in the X17 scratch and access [X17, #0].
// (Vt is a V register, so it never collides with the X17 scratch.)
func emitVLdrStrQ(a @asm.Assembler, isLoad bool, vt int, base int, off int) {
	if off >= 0 && (off & 15) == 0 && off / 16 <= 4095 {
		isa.LdStUImm(a, qSpec(isLoad), vReg(a, vt), spReg(a, base), off)
		return
	}
	if off >= -256 && off <= 255 {
		isa.LdStUnscaled(a, qSpec(isLoad), vReg(a, vt), spReg(a, base), off)
		return
	}
	var vtf int = vReg(a, vt)
	if vtf < 0 || !formScratchAddr(a, base, off) { return }
	isa.LdStUImm(a, qSpec(isLoad), vtf, X17, 0)
}

// Vldr_q emits `LDR Qt, [base, #off]` — load a 128-bit vector register.
func Vldr_q(a @asm.Assembler, vt int, base int, off int) {
	emitVLdrStrQ(a, true, vt, base, off)
}

// Vstr_q emits `STR Qt, [base, #off]` — store a 128-bit vector register.
func Vstr_q(a @asm.Assembler, vt int, base int, off int) {
	emitVLdrStrQ(a, false, vt, base, off)
}

// --- LDR/STR q (128-bit, post-index) ---

// Vldr_q_post emits `LDR Qt, [base], #off` — load then advance base by off, a signed
// 9-bit byte offset ([-256, 255]; anything else is an error).
func Vldr_q_post(a @asm.Assembler, vt int, base int, off int) {
	isa.LdStPost(a, isa.LS_LDR_Q, vReg(a, vt), spReg(a, base), off)
}

// Vstr_q_post emits `STR Qt, [base], #off` — store then advance base by off.
func Vstr_q_post(a @asm.Assembler, vt int, base int, off int) {
	isa.LdStPost(a, isa.LS_STR_Q, vReg(a, vt), spReg(a, base), off)
}

// --- LDP/STP q (pair of 128-bit, offset and post-index) ---
//
// The offset is a multiple of 16 in [-1024, 1008] (a signed 7-bit count of 16-byte
// units); anything else is an error rather than a truncated offset.

// Vldp_q emits `LDP Qt1, Qt2, [base, #off]` — load a pair of vectors.
func Vldp_q(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	isa.LdStPair(a, isa.LSP_LDP_Q, vReg(a, vt1), vReg(a, vt2), spReg(a, base), off, isa.PAIR_OFFSET)
}

// Vstp_q emits `STP Qt1, Qt2, [base, #off]` — store a pair of vectors.
func Vstp_q(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	isa.LdStPair(a, isa.LSP_STP_Q, vReg(a, vt1), vReg(a, vt2), spReg(a, base), off, isa.PAIR_OFFSET)
}

// Vldp_q_post emits `LDP Qt1, Qt2, [base], #off` — load a pair, then advance base.
func Vldp_q_post(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	isa.LdStPair(a, isa.LSP_LDP_Q, vReg(a, vt1), vReg(a, vt2), spReg(a, base), off, isa.PAIR_POST)
}

// Vstp_q_post emits `STP Qt1, Qt2, [base], #off` — store a pair, then advance base.
func Vstp_q_post(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	isa.LdStPair(a, isa.LSP_STP_Q, vReg(a, vt1), vReg(a, vt2), spReg(a, base), off, isa.PAIR_POST)
}

// --- LD1/ST1 (arrangement-typed; 1..4 consecutive registers) ---

// emitLd1St1Multi maps the arrangement, Vt (a V register) and the base (an X register
// or SP) and emits LD1 / ST1 of count (1..4) consecutive registers, post-indexed by the
// transfer size when post.
func emitLd1St1Multi(a @asm.Assembler, isLoad bool, post bool, arr int, vt int, count int, rn int) {
	q, size, ok := neonArr(a, arr)
	if !ok { return }
	if post {
		var bytes int = count * 8
		if q { bytes = count * 16 }
		simd.LdStMultiPostImm(a, isLoad, 1, count, q, size, vReg(a, vt), spReg(a, rn), bytes)
		return
	}
	simd.LdStMulti(a, isLoad, 1, count, q, size, vReg(a, vt), spReg(a, rn))
}

// Vld1 emits `LD1 {Vt.<T>}, [base]` — arrangement-typed single-register load.
func Vld1(a @asm.Assembler, arr int, vt int, base int) {
	emitLd1St1Multi(a, true, false, arr, vt, 1, base)
}

// Vst1 emits `ST1 {Vt.<T>}, [base]` — arrangement-typed single-register store.
func Vst1(a @asm.Assembler, arr int, vt int, base int) {
	emitLd1St1Multi(a, false, false, arr, vt, 1, base)
}

// Vld1_post emits `LD1 {Vt.<T>}, [base], #<size>` — load, then advance base by
// the transfer size (16 bytes for a 128-bit arrangement, 8 for a 64-bit one).
func Vld1_post(a @asm.Assembler, arr int, vt int, base int) {
	emitLd1St1Multi(a, true, true, arr, vt, 1, base)
}

// Vst1_post emits `ST1 {Vt.<T>}, [base], #<size>` — store, then advance base by
// the transfer size.
func Vst1_post(a @asm.Assembler, arr int, vt int, base int) {
	emitLd1St1Multi(a, false, true, arr, vt, 1, base)
}

// Vld1_multi emits `LD1 {Vt.<T>, …}, [base]` — load `count` (1..4) consecutive
// registers starting at Vt (Vt, Vt+1, … modulo 32).
func Vld1_multi(a @asm.Assembler, arr int, vt int, count int, base int) {
	emitLd1St1Multi(a, true, false, arr, vt, count, base)
}

// Vst1_multi emits `ST1 {Vt.<T>, …}, [base]` — store `count` consecutive registers.
func Vst1_multi(a @asm.Assembler, arr int, vt int, count int, base int) {
	emitLd1St1Multi(a, false, false, arr, vt, count, base)
}

// Vld1_multi_post emits `LD1 {Vt.<T>, …}, [base], #<size>` — load `count`
// consecutive registers, then advance base by count × the per-register size.
func Vld1_multi_post(a @asm.Assembler, arr int, vt int, count int, base int) {
	emitLd1St1Multi(a, true, true, arr, vt, count, base)
}

// Vst1_multi_post emits `ST1 {Vt.<T>, …}, [base], #<size>` — store `count`
// consecutive registers, then advance base.
func Vst1_multi_post(a @asm.Assembler, arr int, vt int, count int, base int) {
	emitLd1St1Multi(a, false, true, arr, vt, count, base)
}
