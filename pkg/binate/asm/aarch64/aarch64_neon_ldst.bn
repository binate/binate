package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// AArch64 Advanced SIMD (NEON) vector loads and stores.
//
// Two families:
//   - LDR/STR q, LDP/STP q — plain 128-bit transfers of a V register's raw
//     bytes (no arrangement); the workhorses for spilling vectors and for wide
//     memory copy/zero loops.  Offset and post-index forms.
//   - LD1/ST1 — arrangement-typed single-register element loads/stores; base
//     and post-index-by-transfer-size forms.
// Golden encodings were cross-checked against clang-emitted machine code.  Vt is
// a V register; the encoders mask it with 0x1f like the scalar FP encoders.

// --- LDR/STR q (128-bit, unsigned scaled offset) ---

// vLdrStrQFitsUnsigned reports whether a byte offset fits the LDR/STR q
// unsigned-offset form: non-negative, 16-byte aligned, and scaled offset ≤ 4095.
func vLdrStrQFitsUnsigned(off int) bool {
	return off >= 0 && (off & 15) == 0 && (off / 16) <= 4095
}

// vLdrStrQEnc builds the LDR/STR q (unsigned offset) word; imm12 is scaled by 16.
func vLdrStrQEnc(isLoad bool, off int, rn int, vt int) uint32 {
	var inst uint32 = cast(uint32, 0x3D800000) // STR q (size=00, V=1, opc=10)
	if isLoad {
		inst = cast(uint32, 0x3DC00000) // LDR q (opc=11)
	}
	inst = inst | (cast(uint32, (off / 16) & 0xfff) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | fpRegBits(vt)
	return inst
}

// vLdurSturQEnc builds an LDUR/STUR q word — a 128-bit transfer with an
// UNSCALED signed 9-bit byte offset ([-256, 255], any alignment).  Same field
// layout as the post-index form but with addressing-mode bits 11:10 = 00, so it
// covers small negative and non-16-aligned offsets the scaled form cannot.
func vLdurSturQEnc(isLoad bool, off int, rn int, vt int) uint32 {
	var inst uint32 = cast(uint32, 0x3C800000) // STUR q
	if isLoad {
		inst = cast(uint32, 0x3CC00000) // LDUR q
	}
	inst = inst | (cast(uint32, off & 0x1ff) << 12)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | fpRegBits(vt)
	return inst
}

// vQOffFitsUnscaled reports whether off fits the LDUR/STUR q signed 9-bit
// unscaled immediate ([-256, 255], any alignment).
func vQOffFitsUnscaled(off int) bool {
	return off >= -256 && off <= 255
}

// emitVLdrStrQ emits an LDR/STR q at [base, #off], picking the encoding by off:
//   - non-negative, 16-aligned, within the scaled imm12 → LDR/STR q (scaled);
//   - within the signed 9-bit range → LDUR/STUR q (unscaled) — this covers small
//     NEGATIVE and non-16-aligned offsets the scaled form cannot represent;
//   - otherwise form base±off in the X17 scratch and access [X17, #0].
// The scratch path uses SUB for a negative displacement: the ADD/SUB-immediate
// field is unsigned, so "add a negative constant" must be lowered to "subtract
// its magnitude" — feeding a negative to Add would silently encode base+|off|
// wraparound.  (Vt is a V register, so it never collides with the X17 scratch.)
func emitVLdrStrQ(a @asm.Assembler, isLoad bool, vt int, base int, off int) {
	if vLdrStrQFitsUnsigned(off) {
		emit32(a, vLdrStrQEnc(isLoad, off, base, vt))
		return
	}
	if vQOffFitsUnscaled(off) {
		emit32(a, vLdurSturQEnc(isLoad, off, base, vt))
		return
	}
	if off >= 0 {
		Add(a, true, X17, base, Imm(off))
	} else {
		Sub(a, true, X17, base, Imm(0 - off))
	}
	emit32(a, vLdrStrQEnc(isLoad, 0, X17, vt))
}

// Vldr_q emits `LDR Qt, [base, #off]` — load a 128-bit vector register.
func Vldr_q(a @asm.Assembler, vt int, base int, off int) {
	emitVLdrStrQ(a, true, vt, base, off)
}

// Vstr_q emits `STR Qt, [base, #off]` — store a 128-bit vector register.
func Vstr_q(a @asm.Assembler, vt int, base int, off int) {
	emitVLdrStrQ(a, false, vt, base, off)
}

// --- LDR/STR q (128-bit, post-index) ---

// vLdrStrQPostEnc builds the post-index LDR/STR q word: `[base], #off`, off is a
// signed 9-bit BYTE offset ([-256, 255]) applied to base AFTER the access.
func vLdrStrQPostEnc(isLoad bool, off int, rn int, vt int) uint32 {
	var inst uint32 = cast(uint32, 0x3C800400) // STR q post-index
	if isLoad {
		inst = cast(uint32, 0x3CC00400) // LDR q post-index
	}
	inst = inst | (cast(uint32, off & 0x1ff) << 12)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | fpRegBits(vt)
	return inst
}

// Vldr_q_post emits `LDR Qt, [base], #off` — load then advance base by off.
func Vldr_q_post(a @asm.Assembler, vt int, base int, off int) {
	emit32(a, vLdrStrQPostEnc(true, off, base, vt))
}

// Vstr_q_post emits `STR Qt, [base], #off` — store then advance base by off.
func Vstr_q_post(a @asm.Assembler, vt int, base int, off int) {
	emit32(a, vLdrStrQPostEnc(false, off, base, vt))
}

// --- LDP/STP q (pair of 128-bit, offset and post-index) ---

// vLdpStpQBase returns the LDP/STP q base word for the (load, post-index)
// combination.  The signed-offset form has addressing-mode bits 24:23 = 10 and
// the post-index form 01, so the four bases differ by more than a single bit —
// selecting them explicitly avoids error-prone bit arithmetic.
func vLdpStpQBase(isLoad bool, post bool) uint32 {
	if isLoad {
		if post {
			return cast(uint32, 0xACC00000) // LDP q, post-index
		}
		return cast(uint32, 0xAD400000) // LDP q, signed offset
	}
	if post {
		return cast(uint32, 0xAC800000) // STP q, post-index
	}
	return cast(uint32, 0xAD000000) // STP q, signed offset
}

// vLdpStpQEnc builds an LDP/STP q word.  imm7 is a signed offset scaled by 16;
// `post` selects the post-index encoding (`[base], #off`) over the
// signed-offset one (`[base, #off]`).
func vLdpStpQEnc(isLoad bool, post bool, off int, rn int, vt1 int, vt2 int) uint32 {
	var inst uint32 = vLdpStpQBase(isLoad, post)
	inst = inst | (cast(uint32, (off / 16) & 0x7f) << 15)
	inst = inst | (fpRegBits(vt2) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | fpRegBits(vt1)
	return inst
}

// Vldp_q emits `LDP Qt1, Qt2, [base, #off]` — load a pair of vectors.
func Vldp_q(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	emit32(a, vLdpStpQEnc(true, false, off, base, vt1, vt2))
}

// Vstp_q emits `STP Qt1, Qt2, [base, #off]` — store a pair of vectors.
func Vstp_q(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	emit32(a, vLdpStpQEnc(false, false, off, base, vt1, vt2))
}

// Vldp_q_post emits `LDP Qt1, Qt2, [base], #off` — load a pair, then advance base.
func Vldp_q_post(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	emit32(a, vLdpStpQEnc(true, true, off, base, vt1, vt2))
}

// Vstp_q_post emits `STP Qt1, Qt2, [base], #off` — store a pair, then advance base.
func Vstp_q_post(a @asm.Assembler, vt1 int, vt2 int, base int, off int) {
	emit32(a, vLdpStpQEnc(false, true, off, base, vt1, vt2))
}

// --- LD1/ST1 (single register, arrangement-typed) ---

// vLd1St1Enc builds an LD1/ST1 (one register) word.  Q and the size field come
// from the arrangement; `post` selects the post-index-by-transfer-size form
// (Rm=11111, base advances by 8 or 16 bytes per the Q bit).
func vLd1St1Enc(isLoad bool, post bool, arr int, rn int, vt int) uint32 {
	var inst uint32 = cast(uint32, 0x0C007000) // ST1 {Vt.T}, [Xn], one reg
	if isLoad {
		inst = cast(uint32, 0x0C407000) // LD1
	}
	if post {
		inst = inst | cast(uint32, 0x009F0000) // post-index by transfer size (Rm=11111)
	}
	inst = inst | (arrQ(arr) << 30)
	inst = inst | (arrSize(arr) << 10)
	inst = inst | (cast(uint32, rn & 0x1f) << 5)
	inst = inst | fpRegBits(vt)
	return inst
}

// Vld1 emits `LD1 {Vt.<T>}, [base]` — arrangement-typed vector load.
func Vld1(a @asm.Assembler, arr int, vt int, base int) {
	emit32(a, vLd1St1Enc(true, false, arr, base, vt))
}

// Vst1 emits `ST1 {Vt.<T>}, [base]` — arrangement-typed vector store.
func Vst1(a @asm.Assembler, arr int, vt int, base int) {
	emit32(a, vLd1St1Enc(false, false, arr, base, vt))
}

// Vld1_post emits `LD1 {Vt.<T>}, [base], #<size>` — load, then advance base by
// the transfer size (16 bytes for a 128-bit arrangement, 8 for a 64-bit one).
func Vld1_post(a @asm.Assembler, arr int, vt int, base int) {
	emit32(a, vLd1St1Enc(true, true, arr, base, vt))
}

// Vst1_post emits `ST1 {Vt.<T>}, [base], #<size>` — store, then advance base by
// the transfer size.
func Vst1_post(a @asm.Assembler, arr int, vt int, base int) {
	emit32(a, vLd1St1Enc(false, true, arr, base, vt))
}
