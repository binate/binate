package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the NEON vector load/store encoders in
// aarch64_neon_ldst.bn.  Expected words come from clang-assembled machine code
// (otool -s).  Cases vary Vt, base, and offset to catch field-placement bugs.

func TestVldrStrQOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr_q(a, V0, X0, 0) // ldr q0, [x0]
	Vldr_q(a, V5, X3, 16) // ldr q5, [x3, #16]
	Vldr_q(a, V7, X9, 4080) // ldr q7, [x9, #4080] (max scaled offset)
	Vstr_q(a, V0, X0, 0) // str q0, [x0]
	Vstr_q(a, V5, X3, 32) // str q5, [x3, #32]
	Vstr_q(a, V31, X2, 4080) // str q31, [x2, #4080]
	if readInst(a.Sections[0], 0) != cast(uint32, 0x3DC00000) {
		return fail("LDR q0, [x0] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x3DC00465) {
		return fail("LDR q5, [x3, #16] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x3DC3FD27) {
		return fail("LDR q7, [x9, #4080] encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x3D800000) {
		return fail("STR q0, [x0] encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x3D800865) {
		return fail("STR q5, [x3, #32] encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x3D83FC5F) {
		return fail("STR q31, [x2, #4080] encoding wrong")
	}
	return ""
}

// A small non-16-aligned offset (#8) uses the unscaled LDUR/STUR q form (the
// scaled imm12 can't represent it) — a single instruction, not the scratch path.
func TestVldrStrQUnaligned() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr_q(a, V0, X0, 8) // ldur q0, [x0, #8]
	Vstr_q(a, V0, X0, 8) // stur q0, [x0, #8]
	if readInst(a.Sections[0], 0) != cast(uint32, 0x3CC08000) {
		return fail("LDUR q0, [x0, #8] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x3C808000) {
		return fail("STUR q0, [x0, #8] encoding wrong")
	}
	return ""
}

// A NEGATIVE offset must NOT go through Add (whose immediate field is unsigned —
// that would encode base+16MB wraparound).  Small negatives use LDUR/STUR q; a
// large negative forms the address with SUB in the X17 scratch.
func TestVldrStrQNegative() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr_q(a, V0, X0, -16) // ldur q0, [x0, #-16]
	Vstr_q(a, V0, X0, -16) // stur q0, [x0, #-16]
	Vldr_q(a, V0, X0, -4096) // sub x17, x0, #4096 ; ldr q0, [x17]
	if readInst(a.Sections[0], 0) != cast(uint32, 0x3CDF0000) {
		return fail("LDUR q0, [x0, #-16] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x3C9F0000) {
		return fail("STUR q0, [x0, #-16] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0xD1400411) {
		return fail("large negative should SUB x17, x0, #4096")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x3DC00220) {
		return fail("large negative should then LDR q0, [x17]")
	}
	return ""
}

// A large positive offset that fits neither the scaled imm12 nor the signed
// imm9 forms the address with ADD in the X17 scratch, then accesses [X17, #0].
func TestVldrQLargeOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr_q(a, V0, X0, 65536) // add x17, x0, #65536 ; ldr q0, [x17]
	if readInst(a.Sections[0], 0) != cast(uint32, 0x91404011) {
		return fail("large offset should ADD x17, x0, #65536")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x3DC00220) {
		return fail("large offset should then LDR q0, [x17]")
	}
	return ""
}

func TestVldrStrQPost() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr_q_post(a, V0, X1, 16) // ldr q0, [x1], #16
	Vldr_q_post(a, V5, X3, 32) // ldr q5, [x3], #32
	Vldr_q_post(a, V7, X9, -16) // ldr q7, [x9], #-16
	Vstr_q_post(a, V0, X1, 16) // str q0, [x1], #16
	Vstr_q_post(a, V5, X3, 32) // str q5, [x3], #32
	if readInst(a.Sections[0], 0) != cast(uint32, 0x3CC10420) {
		return fail("LDR q0, [x1], #16 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x3CC20465) {
		return fail("LDR q5, [x3], #32 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x3CDF0527) {
		return fail("LDR q7, [x9], #-16 encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x3C810420) {
		return fail("STR q0, [x1], #16 encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x3C820465) {
		return fail("STR q5, [x3], #32 encoding wrong")
	}
	return ""
}

func TestVldpStpQ() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldp_q(a, V0, V1, X0, 0) // ldp q0, q1, [x0]
	Vldp_q(a, V5, V6, X3, 32) // ldp q5, q6, [x3, #32]
	Vstp_q(a, V0, V1, X0, 0) // stp q0, q1, [x0]
	Vstp_q(a, V5, V6, X3, 32) // stp q5, q6, [x3, #32]
	Vldp_q_post(a, V0, V1, X1, 32) // ldp q0, q1, [x1], #32
	Vstp_q_post(a, V0, V1, X1, 32) // stp q0, q1, [x1], #32
	Vldp_q(a, V5, V6, X3, 1008) // ldp q5, q6, [x3, #1008] (max offset)
	if readInst(a.Sections[0], 0) != cast(uint32, 0xAD400400) {
		return fail("LDP q0, q1, [x0] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0xAD411865) {
		return fail("LDP q5, q6, [x3, #32] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0xAD000400) {
		return fail("STP q0, q1, [x0] encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0xAD011865) {
		return fail("STP q5, q6, [x3, #32] encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0xACC10420) {
		return fail("LDP q0, q1, [x1], #32 encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0xAC810420) {
		return fail("STP q0, q1, [x1], #32 encoding wrong")
	}
	if readInst(a.Sections[0], 24) != cast(uint32, 0xAD5F9865) {
		return fail("LDP q5, q6, [x3, #1008] encoding wrong")
	}
	return ""
}

// A negative offset must ride the signed imm7 field (two's complement), for
// both the signed-offset and post-index forms.
func TestVldpStpQNegative() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldp_q(a, V0, V1, X1, -32) // ldp q0, q1, [x1, #-32]
	Vstp_q(a, V2, V3, X4, -1024) // stp q2, q3, [x4, #-1024] (min offset)
	Vldp_q_post(a, V0, V1, X1, -32) // ldp q0, q1, [x1], #-32
	if readInst(a.Sections[0], 0) != cast(uint32, 0xAD7F0420) {
		return fail("LDP q0, q1, [x1, #-32] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0xAD200C82) {
		return fail("STP q2, q3, [x4, #-1024] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0xACFF0420) {
		return fail("LDP q0, q1, [x1], #-32 encoding wrong")
	}
	return ""
}

func TestVld1St1() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vld1(a, ARR_16B, V0, X0) // ld1 {v0.16b}, [x0]
	Vld1(a, ARR_4S, V5, X3) // ld1 {v5.4s}, [x3]
	Vld1(a, ARR_2D, V7, X9) // ld1 {v7.2d}, [x9]
	Vld1(a, ARR_8B, V2, X1) // ld1 {v2.8b}, [x1]
	Vst1(a, ARR_16B, V0, X0) // st1 {v0.16b}, [x0]
	Vst1(a, ARR_4S, V5, X3) // st1 {v5.4s}, [x3]
	Vst1(a, ARR_8B, V2, X1) // st1 {v2.8b}, [x1]
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4C407000) {
		return fail("LD1 {v0.16b}, [x0] encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4C407865) {
		return fail("LD1 {v5.4s}, [x3] encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4C407D27) {
		return fail("LD1 {v7.2d}, [x9] encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x0C407022) {
		return fail("LD1 {v2.8b}, [x1] encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x4C007000) {
		return fail("ST1 {v0.16b}, [x0] encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x4C007865) {
		return fail("ST1 {v5.4s}, [x3] encoding wrong")
	}
	if readInst(a.Sections[0], 24) != cast(uint32, 0x0C007022) {
		return fail("ST1 {v2.8b}, [x1] encoding wrong")
	}
	return ""
}

func TestVld1St1Post() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vld1_post(a, ARR_16B, V0, X1) // ld1 {v0.16b}, [x1], #16
	Vld1_post(a, ARR_8B, V5, X3) // ld1 {v5.8b}, [x3], #8
	Vst1_post(a, ARR_16B, V0, X1) // st1 {v0.16b}, [x1], #16
	Vst1_post(a, ARR_8B, V5, X3) // st1 {v5.8b}, [x3], #8
	Vld1_post(a, ARR_4S, V0, X1) // ld1 {v0.4s}, [x1], #16
	Vst1_post(a, ARR_2D, V5, X3) // st1 {v5.2d}, [x3], #16
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4CDF7020) {
		return fail("LD1 {v0.16b}, [x1], #16 encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x0CDF7065) {
		return fail("LD1 {v5.8b}, [x3], #8 encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4C9F7020) {
		return fail("ST1 {v0.16b}, [x1], #16 encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x0C9F7065) {
		return fail("ST1 {v5.8b}, [x3], #8 encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x4CDF7820) {
		return fail("LD1 {v0.4s}, [x1], #16 encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x4C9F7C65) {
		return fail("ST1 {v5.2d}, [x3], #16 encoding wrong")
	}
	return ""
}

// Multi-register LD1/ST1 (1..4 consecutive registers, base + post-index).
func TestVld1St1Multi() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vld1_multi(a, ARR_16B, V0, 2, X0) // ld1 {v0.16b, v1.16b}, [x0]
	Vld1_multi(a, ARR_16B, V0, 3, X0) // ld1 {v0-v2.16b}, [x0]
	Vld1_multi(a, ARR_16B, V0, 4, X0) // ld1 {v0-v3.16b}, [x0]
	Vld1_multi(a, ARR_4S, V0, 2, X3) // ld1 {v0.4s, v1.4s}, [x3]
	Vst1_multi(a, ARR_16B, V0, 2, X0) // st1 {v0.16b, v1.16b}, [x0]
	Vst1_multi(a, ARR_2D, V5, 4, X2) // st1 {v5-v8.2d}, [x2]
	Vld1_multi(a, ARR_16B, V30, 2, X0) // ld1 {v30.16b, v31.16b}, [x0] (reg wrap)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4C40A000) {
		return fail("LD1 {v0,v1}.16b encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4C406000) {
		return fail("LD1 {v0-v2}.16b encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4C402000) {
		return fail("LD1 {v0-v3}.16b encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4C40A860) {
		return fail("LD1 {v0,v1}.4s encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x4C00A000) {
		return fail("ST1 {v0,v1}.16b encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x4C002C45) {
		return fail("ST1 {v5-v8}.2d encoding wrong")
	}
	if readInst(a.Sections[0], 24) != cast(uint32, 0x4C40A01E) {
		return fail("LD1 {v30,v31}.16b encoding wrong")
	}
	return ""
}

func TestVld1St1MultiPost() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vld1_multi_post(a, ARR_16B, V0, 2, X1) // ld1 {v0,v1}.16b, [x1], #32
	Vld1_multi_post(a, ARR_16B, V0, 4, X1) // ld1 {v0-v3}.16b, [x1], #64
	Vst1_multi_post(a, ARR_16B, V0, 2, X1) // st1 {v0,v1}.16b, [x1], #32
	Vld1_multi_post(a, ARR_8B, V0, 2, X1) // ld1 {v0,v1}.8b, [x1], #16
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4CDFA020) {
		return fail("LD1 {v0,v1}.16b post encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4CDF2020) {
		return fail("LD1 {v0-v3}.16b post encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4C9FA020) {
		return fail("ST1 {v0,v1}.16b post encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x0CDFA020) {
		return fail("LD1 {v0,v1}.8b post encoding wrong")
	}
	return ""
}

func TestVld1MultiCountFailsLoud() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vld1_multi(a, ARR_16B, V0, 0, X0) // count < 1
	if !a.HasError { return fail("count 0 should error") }
	var b @asm.Assembler = newAsm()
	Vld1_multi(b, ARR_16B, V0, 5, X0) // count > 4
	if !b.HasError { return fail("count 5 should error") }
	return ""
}

// count-1 through the multi encoder matches the fixed Vld1; plus count-3 on a
// non-.16b arrangement and count-3 post-index.
func TestVld1MultiCoverage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vld1_multi(a, ARR_16B, V0, 1, X0) // == Vld1(ARR_16B, V0, X0)
	Vld1_multi(a, ARR_4S, V0, 3, X3) // ld1 {v0-v2.4s}, [x3]
	Vld1_multi_post(a, ARR_16B, V0, 3, X1) // ld1 {v0-v2.16b}, [x1], #48
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4C407000) {
		return fail("LD1_multi count-1 should match Vld1")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4C406860) {
		return fail("LD1 {v0-v2}.4s encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x4CDF6020) {
		return fail("LD1 {v0-v2}.16b post encoding wrong")
	}
	return ""
}
