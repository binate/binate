package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the NEON packed integer + bitwise instructions in
// aarch64_neon.bn.  Each expected word was produced by assembling the mnemonic
// with clang and reading the __text section (otool -s), so the tests pin the
// encoders to the real ISA rather than to a re-derivation of the bit layout.
// Distinct Vd/Vn/Vm registers per case catch field-placement (Rd/Rn/Rm) swaps.

// The V and D register namespaces must alias: a V register's low 64 bits ARE
// the same-numbered D register (they are one physical file), so the constants
// must be equal for the shared 0x1f-masking encoders to be correct.
func TestVregAliasesD() testing.TestResult {
	if V0 != D0 || V5 != D5 || V31 != D31 {
		return fail("V registers must alias the same-numbered D registers")
	}
	return ""
}

func TestVaddArrangements() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// add v0.4s, v1.4s, v2.4s / .2d / .8b / .16b / .8h / .4h / .2s
	Vadd(a, ARR_4S, V0, V1, V2)
	Vadd(a, ARR_2D, V3, V4, V5)
	Vadd(a, ARR_8B, V6, V7, V8)
	Vadd(a, ARR_16B, V9, V10, V11)
	Vadd(a, ARR_8H, V12, V13, V14)
	Vadd(a, ARR_4H, V15, V16, V17)
	Vadd(a, ARR_2S, V18, V19, V20)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4EA28420) {
		return fail("ADD v0.4s, v1.4s, v2.4s encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4EE58483) {
		return fail("ADD v3.2d encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x0E2884E6) {
		return fail("ADD v6.8b encoding wrong")
	}
	if readInst(a.Sections[0], 12) != cast(uint32, 0x4E2B8549) {
		return fail("ADD v9.16b encoding wrong")
	}
	if readInst(a.Sections[0], 16) != cast(uint32, 0x4E6E85AC) {
		return fail("ADD v12.8h encoding wrong")
	}
	if readInst(a.Sections[0], 20) != cast(uint32, 0x0E71860F) {
		return fail("ADD v15.4h encoding wrong")
	}
	if readInst(a.Sections[0], 24) != cast(uint32, 0x0EB48672) {
		return fail("ADD v18.2s encoding wrong")
	}
	return ""
}

func TestVsub() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vsub(a, ARR_4S, V0, V1, V2)
	Vsub(a, ARR_16B, V21, V22, V23)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x6EA28420) {
		return fail("SUB v0.4s encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x6E3786D5) {
		return fail("SUB v21.16b encoding wrong")
	}
	return ""
}

func TestVmul() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmul(a, ARR_4S, V0, V1, V2)
	Vmul(a, ARR_8H, V3, V4, V5)
	Vmul(a, ARR_8B, V6, V7, V8)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4EA29C20) {
		return fail("MUL v0.4s encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x4E659C83) {
		return fail("MUL v3.8h encoding wrong")
	}
	if readInst(a.Sections[0], 8) != cast(uint32, 0x0E289CE6) {
		return fail("MUL v6.8b encoding wrong")
	}
	return ""
}

func TestVand() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vand(a, true, V0, V1, V2)
	Vand(a, false, V3, V4, V5)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4E221C20) {
		return fail("AND v0.16b encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x0E251C83) {
		return fail("AND v3.8b encoding wrong")
	}
	return ""
}

func TestVorr() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vorr(a, true, V6, V7, V8)
	Vorr(a, false, V9, V10, V11)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x4EA81CE6) {
		return fail("ORR v6.16b encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x0EAB1D49) {
		return fail("ORR v9.8b encoding wrong")
	}
	return ""
}

func TestVeor() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Veor(a, true, V12, V13, V14)
	Veor(a, false, V15, V16, V17)
	if readInst(a.Sections[0], 0) != cast(uint32, 0x6E2E1DAC) {
		return fail("EOR v12.16b encoding wrong")
	}
	if readInst(a.Sections[0], 4) != cast(uint32, 0x2E311E0F) {
		return fail("EOR v15.8b encoding wrong")
	}
	return ""
}
