package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// Register-operand mapping.  Every encoder in this package turns each register
// operand (a value in the X0..X30 / SP / XZR / D0..D31 = V0..V31 namespace, see
// aarch64.bni) into its 5-bit instruction field through exactly one of these, chosen
// by how the field reads register 31.  An operand the field cannot hold sets an
// assembler error and maps to -1, which every encoder rejects (emitting nothing):
// the isa encoders' register-range check, and emitRnRd here.

// zrReg maps a general-purpose operand of a field that reads 31 as the zero
// register: X0..X30 as themselves, XZR as 31.  SP (or any non-GP value) is an error.
func zrReg(a @asm.Assembler, r int) int {
	if r >= X0 && r <= X30 { return r }
	if r == XZR { return 31 }
	if r == SP {
		a.SetError("aarch64: SP is not valid here (this operand reads register 31 as XZR)")
	} else {
		a.SetError("aarch64: expected a general-purpose register (X0..X30 or XZR)")
	}
	return -1
}

// spReg maps a general-purpose operand of a field that reads 31 as the stack
// pointer: X0..X30 as themselves, SP as 31.  XZR (or any non-GP value) is an error.
func spReg(a @asm.Assembler, r int) int {
	if r >= X0 && r <= X30 { return r }
	if r == SP { return 31 }
	if r == XZR {
		a.SetError("aarch64: XZR is not valid here (this operand reads register 31 as SP)")
	} else {
		a.SetError("aarch64: expected a general-purpose register (X0..X30 or SP)")
	}
	return -1
}

// vReg maps an FP/SIMD operand (D0..D31 / V0..V31) to its register number 0..31.
// Anything else — an X register, SP, XZR — is an error.
func vReg(a @asm.Assembler, r int) int {
	if r >= V0 && r <= V31 { return r - V0 }
	a.SetError("aarch64: expected an FP/SIMD register (D0..D31 / V0..V31)")
	return -1
}
