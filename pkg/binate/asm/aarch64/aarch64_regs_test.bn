package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Register-operand mapping: SP and XZR each encode as register 31 only in a field
// that reads 31 that way, and a register of the wrong class is rejected.  Reference
// words are clang's (`clang -c -target arm64-apple-macos`, objdump).

// wantWord reports "" iff a has no error and its first instruction word is want.
func wantWord(a @asm.Assembler, want uint32, what *[]readonly char) testing.TestResult {
	if a.HasError { return fail(a.ErrorMsg) }
	if readInst(a.Sections[0], 0) != want { return fail(buf.CopyStr(what)) }
	return ""
}

// ADD/SUB/ADDS/SUBS/CMP/CMN with SP and a register operand use the extended-register
// form (the shifted-register form would read 31 as XZR).
func TestSPWithRegisterOperandUsesExtendedForm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, SP, Reg(X1))
	var r testing.TestResult = wantWord(a, 0x8B2163E0, "add x0, sp, x1")
	if len(r) > 0 { return r }
	a = newAsm()
	Add(a, false, X0, SP, Reg(X1))
	r = wantWord(a, 0x0B2143E0, "add w0, wsp, w1")
	if len(r) > 0 { return r }
	a = newAsm()
	Add(a, true, SP, X1, Reg(X2))
	r = wantWord(a, 0x8B22603F, "add sp, x1, x2")
	if len(r) > 0 { return r }
	a = newAsm()
	Add(a, true, X0, SP, RegShift(X1, LSL, 2))
	r = wantWord(a, 0x8B216BE0, "add x0, sp, x1, lsl #2")
	if len(r) > 0 { return r }
	a = newAsm()
	Sub(a, true, X0, SP, Reg(X1))
	r = wantWord(a, 0xCB2163E0, "sub x0, sp, x1")
	if len(r) > 0 { return r }
	a = newAsm()
	Adds(a, true, X0, SP, Reg(X1))
	r = wantWord(a, 0xAB2163E0, "adds x0, sp, x1")
	if len(r) > 0 { return r }
	a = newAsm()
	Cmp(a, true, SP, Reg(X1))
	r = wantWord(a, 0xEB2163FF, "cmp sp, x1")
	if len(r) > 0 { return r }
	a = newAsm()
	Cmn(a, true, SP, Reg(X1))
	r = wantWord(a, 0xAB2163FF, "cmn sp, x1")
	if len(r) > 0 { return r }
	a = newAsm()
	Cmp(a, true, SP, Imm(4))
	return wantWord(a, 0xF10013FF, "cmp sp, #4")
}

// MOV to or from SP is ADD #0; any other register move — including from XZR — is ORR.
func TestMovZeroAndStackPointer() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, true, X0, Reg(XZR))
	var r testing.TestResult = wantWord(a, 0xAA1F03E0, "mov x0, xzr")
	if len(r) > 0 { return r }
	a = newAsm()
	Mov(a, false, X0, Reg(XZR))
	r = wantWord(a, 0x2A1F03E0, "mov w0, wzr")
	if len(r) > 0 { return r }
	a = newAsm()
	Mov(a, true, X0, Reg(SP))
	r = wantWord(a, 0x910003E0, "mov x0, sp")
	if len(r) > 0 { return r }
	a = newAsm()
	Mov(a, true, SP, Reg(X0))
	return wantWord(a, 0x9100001F, "mov sp, x0")
}

// XZR encodes as 31 wherever a field reads 31 as the zero register: an integer
// source or destination, a store's data register, an FP move source, and the GP
// operand of the NEON lane ops.
func TestXZROperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Neg(a, true, X0, Reg(X1))
	var r testing.TestResult = wantWord(a, 0xCB0103E0, "neg x0, x1")
	if len(r) > 0 { return r }
	a = newAsm()
	Str(a, true, XZR, MemImm(SP, 8))
	r = wantWord(a, 0xF90007FF, "str xzr, [sp, #8]")
	if len(r) > 0 { return r }
	a = newAsm()
	Mul(a, true, X0, X1, X2)
	r = wantWord(a, 0x9B027C20, "mul x0, x1, x2")
	if len(r) > 0 { return r }
	a = newAsm()
	Csinc(a, true, X0, XZR, XZR, COND_EQ)
	r = wantWord(a, 0x9A9F07E0, "cset x0, ne")
	if len(r) > 0 { return r }
	a = newAsm()
	Fmov_gp_to_fp(a, D0, XZR)
	r = wantWord(a, 0x9E6703E0, "fmov d0, xzr")
	if len(r) > 0 { return r }
	a = newAsm()
	Vdup_gp(a, ARR_4S, V0, XZR)
	r = wantWord(a, 0x4E040FE0, "dup v0.4s, wzr")
	if len(r) > 0 { return r }
	a = newAsm()
	Vins_gp(a, ELEM_S, 1, V0, XZR)
	return wantWord(a, 0x4E0C1FE0, "ins v0.s[1], wzr")
}

// rejected reports whether the assembler recorded an error whose message contains sub.
func rejected(a @asm.Assembler, sub *[]readonly char) bool {
	if !a.HasError { return false }
	for i := 0; i + len(sub) <= len(a.ErrorMsg); i++ {
		var ok bool = true
		for j := 0; j < len(sub); j++ {
			if a.ErrorMsg[i + j] != sub[j] {
				ok = false
				break
			}
		}
		if ok { return true }
	}
	return false
}

// SP in a field that reads 31 as the zero register, and XZR in one that reads it as
// SP, are errors — never the other register.
func TestSPAndXZRInTheWrongFieldAreErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Madd(a, true, X0, SP, X1, X2)
	if !rejected(a, "SP is not valid here") { return fail("madd with SP") }
	a = newAsm()
	Cbz(a, true, SP, "L")
	if !rejected(a, "SP is not valid here") { return fail("cbz sp") }
	a = newAsm()
	Br(a, SP)
	if !rejected(a, "SP is not valid here") { return fail("br sp") }
	a = newAsm()
	Adds(a, true, SP, X1, Reg(X2))
	if !rejected(a, "SP is not valid here") { return fail("adds sp, x1, x2") }
	a = newAsm()
	Add(a, true, X0, SP, RegShift(X1, LSR, 1))
	if !rejected(a, "only an LSL") { return fail("add x0, sp, x1, lsr #1") }
	a = newAsm()
	Neg(a, true, X0, Imm(1))
	if !rejected(a, "XZR is not valid here") { return fail("neg with an immediate (sub x0, xzr, #1)") }
	a = newAsm()
	Cmp(a, true, XZR, Imm(4))
	if !rejected(a, "XZR is not valid here") { return fail("cmp xzr, #4") }
	a = newAsm()
	Mov(a, true, SP, Reg(XZR))
	if !rejected(a, "XZR is not valid here") { return fail("mov sp, xzr") }
	a = newAsm()
	Str(a, true, X0, MemImm(XZR, 0))
	if !rejected(a, "XZR is not valid here") { return fail("str x0, [xzr]") }
	return ""
}

// A register of the other class (or no register at all) is an error, not the
// same-numbered register of the expected class.
func TestWrongRegisterClassIsAnError() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, true, X0, X1, Reg(D1))
	if !rejected(a, "expected a general-purpose register") { return fail("add x0, x1, d1") }
	a = newAsm()
	Str(a, true, D8, MemImm(SP, 0))
	if !rejected(a, "expected a general-purpose register") { return fail("str d8 via the GP store") }
	a = newAsm()
	Fmov_gp_to_fp(a, D0, D1)
	if !rejected(a, "expected a general-purpose register") { return fail("fmov d0, d1 via gp_to_fp") }
	a = newAsm()
	Fadd(a, D0, X1, D2)
	if !rejected(a, "expected an FP/SIMD register") { return fail("fadd d0, x1, d2") }
	a = newAsm()
	Fstr_d(a, X0, SP, 0)
	if !rejected(a, "expected an FP/SIMD register") { return fail("str x0 via the D store") }
	a = newAsm()
	Vadd(a, ARR_4S, V0, X1, V2)
	if !rejected(a, "expected an FP/SIMD register") { return fail("add v0, x1, v2") }
	a = newAsm()
	Vldr_q(a, V0, V1, 0)
	if !rejected(a, "expected a general-purpose register") { return fail("ldr q0, [v1]") }
	a = newAsm()
	Vld1(a, ARR_4S, X0, SP)
	if !rejected(a, "expected an FP/SIMD register") { return fail("ld1 {x0}, [sp]") }
	a = newAsm()
	Movz(a, true, 99, 1, 0)
	if !rejected(a, "expected a general-purpose register") { return fail("movz of register 99") }
	return ""
}

// An access whose offset needs the X17 scratch emits nothing when its transfer
// register or base is rejected — not the address-forming ADD, nor the access.
func TestRejectedScratchAccessEmitsNothing() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Str(a, true, D8, MemImm(X1, 40000))
	if !a.HasError || a.Sections[0].Len != 0 { return fail("str d8 via the GP store, large offset") }
	a = newAsm()
	Ldr(a, true, X0, MemImm(XZR, 40000))
	if !a.HasError || a.Sections[0].Len != 0 { return fail("ldr x0, [xzr, #40000]") }
	a = newAsm()
	Strb(a, SP, MemImm(X1, 40000))
	if !a.HasError || a.Sections[0].Len != 0 { return fail("strb sp, large offset") }
	a = newAsm()
	Fstr_d(a, X0, X1, 40000)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("str x0 via the D store, large offset") }
	a = newAsm()
	Vstr_q(a, X0, X1, 70000)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("str q with an X register, large offset") }
	return ""
}
