package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Same-section fixup resolution: PC-relative references whose displacement is fixed
// at assembly time are patched into the instruction words here; everything else is
// left for asm.Finalize to turn into a relocation.

// readInst32 reads a little-endian uint32 from data at offset.
func readInst32(data @[]uint8, off int) uint32 {
	return cast(uint32, data[off]) | (cast(uint32, data[off + 1]) << 8) |
			(cast(uint32, data[off + 2]) << 16) | (cast(uint32, data[off + 3]) << 24)
}

// writeInst32 writes a little-endian uint32 to data at offset.
func writeInst32(data @[]uint8, off int, inst uint32) {
	data[off] = cast(uint8, inst & 0xff)
	data[off + 1] = cast(uint8, (inst >> 8) & 0xff)
	data[off + 2] = cast(uint8, (inst >> 16) & 0xff)
	data[off + 3] = cast(uint8, (inst >> 24) & 0xff)
}

// patchBranch26 patches a 26-bit PC-relative branch offset (B, BL).
func patchBranch26(data @[]uint8, off int, pcRelOffset int) bool {
	if pcRelOffset % 4 != 0 { return false } // a target off the instruction grid
	var imm int = pcRelOffset / 4
	if imm < -33554432 || imm > 33554431 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	inst = inst | (cast(uint32, imm) & 0x03FFFFFF)
	writeInst32(data, off, inst)
	return true
}

// patchBranch19 patches a 19-bit PC-relative branch offset (B.cond, CBZ, CBNZ, LDR literal).
func patchBranch19(data @[]uint8, off int, pcRelOffset int) bool {
	if pcRelOffset % 4 != 0 { return false } // a target off the instruction grid
	var imm int = pcRelOffset / 4
	if imm < -262144 || imm > 262143 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	inst = inst | ((cast(uint32, imm) & 0x7FFFF) << 5)
	writeInst32(data, off, inst)
	return true
}

// patchBranch14 patches a 14-bit PC-relative branch offset (TBZ, TBNZ).
func patchBranch14(data @[]uint8, off int, pcRelOffset int) bool {
	if pcRelOffset % 4 != 0 { return false } // a target off the instruction grid
	var imm int = pcRelOffset / 4
	if imm < -8192 || imm > 8191 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	inst = inst | ((cast(uint32, imm) & 0x3FFF) << 5)
	writeInst32(data, off, inst)
	return true
}

// patchAdr patches a 21-bit PC-relative offset for ADR.
// The 21-bit immediate is split: immlo (bits [30:29]) and immhi (bits [23:5]).
func patchAdr(data @[]uint8, off int, pcRelOffset int) bool {
	if pcRelOffset < -1048576 || pcRelOffset > 1048575 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	var immlo uint32 = cast(uint32, pcRelOffset) & 3
	var immhi uint32 = (cast(uint32, pcRelOffset) >> 2) & 0x7FFFF
	inst = inst | (immlo << 29)
	inst = inst | (immhi << 5)
	writeInst32(data, off, inst)
	return true
}

// ResolveFixups patches every same-section PC-relative fixup (B / BL, B.cond, CBZ /
// CBNZ, TBZ / TBNZ, LDR literal, ADR) whose displacement is fixed at assembly time
// (Assembler.DisplacementFixed) into its instruction and marks it resolved, so asm.Finalize skips
// it; a fixed displacement out of range or off the instruction grid is an error (the
// section layout in the object is final, so no linker can help).  Every other fixup —
// cross-section, external, page-relative (ADRP / lo12), or to a symbol the linker may
// move or preempt — is left for Finalize to emit as a relocation.  Must be called
// before asm.Finalize, after the object format (a.ObjFormat) is set.
func ResolveFixups(a @asm.Assembler) bool {
	for si := 0; si < a.NumSections; si++ {
		var s @asm.Section = a.Sections[si]
		var data @[]uint8 = a.SectionData(si)
		var starts @[]int
		if a.ObjFormat != asm.OBJ_ELF { starts = a.AtomStarts(si) }
		for fi := 0; fi < s.NumFixups; fi++ {
			var f asm.Fixup = s.Fixups[fi]
			var pcRelKind bool = f.Kind == FIX_BRANCH26 || f.Kind == FIX_BRANCH19 ||
					f.Kind == FIX_LD_PREL_LO19 || f.Kind == FIX_BRANCH14 || f.Kind == FIX_ADR_LO21
			if !pcRelKind { continue }
			var symIdx int = a.LookupSymbol(f.Label)
			if symIdx < 0 { continue } // let Finalize report the error
			var sym asm.Symbol = a.Symbols[symIdx]
			if sym.Section != si { continue } // cross-section — a relocation
			var fixupAddr int = cast(int, f.Offset)
			if !a.DisplacementFixed(sym, fixupAddr, starts) { continue }
			var pcRel int = cast(int, sym.Offset) + f.Addend - fixupAddr
			var ok bool = false
			if f.Kind == FIX_BRANCH26 {
				ok = patchBranch26(data, fixupAddr, pcRel)
			} else if f.Kind == FIX_BRANCH19 || f.Kind == FIX_LD_PREL_LO19 {
				ok = patchBranch19(data, fixupAddr, pcRel)
			} else if f.Kind == FIX_BRANCH14 {
				ok = patchBranch14(data, fixupAddr, pcRel)
			} else {
				ok = patchAdr(data, fixupAddr, pcRel)
			}
			if !ok {
				a.SetError(
						buf.Concat(buf.Concat("aarch64: PC-relative reference to '", f.Label),
								"' is out of range or misaligned"))
				return false
			}
			a.MarkFixupResolved(si, fi)
		}
	}
	return true
}
