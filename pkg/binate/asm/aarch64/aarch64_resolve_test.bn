package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/builtins/testing"

// ResolveFixups tests for the PC-relative kinds (B.cond / CBZ / TBZ / ADR / LDR
// literal, plus B / BL).  First with the object format unset: a target that is an
// `L`-prefixed label in the same section is patched in place; an atom-starting
// (non-`L`) target stays a relocation; a misaligned or out-of-range in-section target
// is an error; a label addend is part of the target.  Then with the format known
// (Mach-O atoms, ELF preemption).  Expected patched words are clang's
// (arm64-apple-macos11) for the same source.

// ctlWord returns the i-th instruction word of a's text section.
func ctlWord(a @asm.Assembler, i int) uint32 { return readInst(a.Sections[0], i * 4) }

// ctlResolved runs ResolveFixups + Finalize on a and reports whether both succeed and
// every fixup was resolved in place (no relocations left).
func ctlResolved(a @asm.Assembler) bool {
	if !ResolveFixups(a) { return false }
	if !a.Finalize() { return false }
	return a.NumRelocs == 0
}

// ctlEmitTo emits one instruction of the given kind (0 B, 1 B.NE, 2 CBZ X0, 3 TBZ W0
// #0, 4 ADR X0) targeting label + addend.
func ctlEmitTo(a @asm.Assembler, which int, label *[]readonly char, addend int) {
	if which == 0 {
		isa.BranchLabel(a, false, label, addend)
	} else if which == 1 {
		isa.CondBranchLabel(a, COND_NE, label, addend)
	} else if which == 2 {
		isa.CompareBranchLabel(a, false, true, 0, label, addend)
	} else if which == 3 {
		isa.TestBranchLabel(a, false, 0, 0, label, addend)
	} else {
		isa.PCRelLabel(a, false, false, 0, label, addend)
	}
}

// A forward B.NE to a same-section L label is patched in place (`b.ne Lx; nop; Lx:`).
func TestResolveCondBranchToLocalLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.CondBranchLabel(a, COND_NE, "Lx", 0)
	Nop(a)
	a.DefineLabel("Lx")
	Nop(a)
	if !ctlResolved(a) { return fail("b.ne Lx must resolve in place") }
	if ctlWord(a, 0) != 0x54000041 { return fail("b.ne Lx patched word") }
	return ""
}

// A backward CBZ to a same-section L label is patched in place (`Lloop: nop; cbz x0,
// Lloop`).
func TestResolveCbzBackwardToLocalLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.DefineLabel("Lloop")
	Nop(a)
	isa.CompareBranchLabel(a, false, true, 0, "Lloop", 0)
	if !ctlResolved(a) { return fail("cbz x0, Lloop must resolve in place") }
	if ctlWord(a, 1) != 0xB4FFFFE0 { return fail("cbz x0, Lloop patched word") }
	return ""
}

// A TBNZ to a same-section L label is patched in place (`tbnz w1, #2, Ldone; nop;
// nop; Ldone:`).
func TestResolveTbnzToLocalLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.TestBranchLabel(a, true, 1, 2, "Ldone", 0)
	Nop(a)
	Nop(a)
	a.DefineLabel("Ldone")
	Nop(a)
	if !ctlResolved(a) { return fail("tbnz w1, #2, Ldone must resolve in place") }
	if ctlWord(a, 0) != 0x37100061 { return fail("tbnz w1, #2, Ldone patched word") }
	return ""
}

// ADR is byte-granular: a same-section L label at an odd offset resolves in place
// (`adr x0, Lb; .byte 1; Lb: .byte 2`).
func TestResolveAdrToOddLocalLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.PCRelLabel(a, false, false, 0, "Lb", 0)
	a.EmitUint8(1)
	a.DefineLabel("Lb")
	a.EmitUint8(2)
	if !ctlResolved(a) { return fail("adr x0, Lb must resolve in place") }
	if ctlWord(a, 0) != 0x30000020 { return fail("adr x0, Lb patched word") }
	return ""
}

// The fixup addend is part of the in-section target, for every short-range kind and
// for B (`b Lx+8; Lx: nop x3; b.eq Lx+8; cbz x1, Lx-4; tbz x2, #33, Lx+4; adr x3,
// Lx+3`).
func TestResolveHonoursLabelAddend() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.BranchLabel(a, false, "Lx", 8)
	a.DefineLabel("Lx")
	Nop(a)
	Nop(a)
	Nop(a)
	isa.CondBranchLabel(a, COND_EQ, "Lx", 8)
	isa.CompareBranchLabel(a, false, true, 1, "Lx", -4)
	isa.TestBranchLabel(a, false, 2, 33, "Lx", 4)
	isa.PCRelLabel(a, false, false, 3, "Lx", 3)
	if !ctlResolved(a) { return fail("label+addend fixups must resolve in place") }
	if ctlWord(a, 0) != 0x14000003 { return fail("b Lx+8") }
	if ctlWord(a, 4) != 0x54FFFFE0 { return fail("b.eq Lx+8") }
	if ctlWord(a, 5) != 0xB4FFFF61 { return fail("cbz x1, Lx-4") }
	if ctlWord(a, 6) != 0xB60FFF82 { return fail("tbz x2, #33, Lx+4") }
	if ctlWord(a, 7) != 0x70FFFF43 { return fail("adr x3, Lx+3") }
	return ""
}

// With no object format set, a B / B.cond / CBZ / TBZ / ADR to a global symbol in the
// same section is not resolved — an ELF linker may preempt the symbol — so it stays
// one relocation and the instruction keeps its zero immediate.
func TestResolveAtomStartTargetStaysReloc() testing.TestResult {
	for which := 0; which < 5; which++ {
		var a @asm.Assembler = newAsm()
		a.SetGlobal("foo")
		a.DefineLabel("foo")
		Nop(a)
		ctlEmitTo(a, which, "foo", 0)
		var before uint32 = ctlWord(a, 1)
		if !ResolveFixups(a) { return fail("ResolveFixups must not fail on a global target") }
		if !a.Finalize() { return fail("Finalize must succeed on a global target") }
		if a.NumRelocs != 1 { return fail("a same-section global target must stay a relocation") }
		if cast(int, a.Relocs[0].Offset) != 4 { return fail("relocation at the instruction") }
		if ctlWord(a, 1) != before { return fail("a global target must not be patched") }
	}
	return ""
}

// A branch whose same-section L target is off the 4-byte instruction grid (a label
// after a single .byte) is an error, for B, B.cond, CBZ and TBZ.
func TestResolveMisalignedTargetIsError() testing.TestResult {
	for which := 0; which < 4; which++ {
		var a @asm.Assembler = newAsm()
		ctlEmitTo(a, which, "Lodd", 0)
		a.EmitUint8(0)
		a.DefineLabel("Lodd")
		a.EmitUint8(0)
		if ResolveFixups(a) { return fail("a misaligned branch target must fail ResolveFixups") }
		if !a.HasError { return fail("a misaligned branch target must set an error") }
	}
	return ""
}

// An addend that moves an aligned L label off the instruction grid is likewise an
// error (`b.ne Lx+2`).
func TestResolveMisalignedAddendIsError() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.CondBranchLabel(a, COND_NE, "Lx", 2)
	a.DefineLabel("Lx")
	Nop(a)
	if ResolveFixups(a) { return fail("b.ne Lx+2 must fail ResolveFixups") }
	if !a.HasError { return fail("b.ne Lx+2 must set an error") }
	return ""
}

// TBZ reaches exactly +0x7ffc in-section (imm14 = 0x1fff) and one word further is an
// out-of-range error.
func TestResolveTbzRangeEdge() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.TestBranchLabel(a, false, 0, 0, "Ledge", 0)
	a.Zero(0x7FF8)
	a.DefineLabel("Ledge")
	Nop(a)
	if !ctlResolved(a) { return fail("tbz w0, #0, .+0x7ffc must resolve in place") }
	if ctlWord(a, 0) != 0x3603FFE0 { return fail("tbz w0, #0, .+0x7ffc patched word") }
	a = newAsm()
	isa.TestBranchLabel(a, false, 0, 0, "Lfar", 0)
	a.Zero(0x7FFC)
	a.DefineLabel("Lfar")
	Nop(a)
	if ResolveFixups(a) { return fail("tbz to .+0x8000 must fail ResolveFixups") }
	if !a.HasError { return fail("tbz to .+0x8000 must set an error") }
	return ""
}

// ADRP to a same-section L label is page-relative (the section base does not cancel),
// so it is left as a relocation.
func TestResolveAdrpToLocalLabelStaysReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	isa.PCRelLabel(a, true, false, 0, "Lx", 0)
	a.DefineLabel("Lx")
	Nop(a)
	if !ResolveFixups(a) { return fail("ResolveFixups must not fail on adrp") }
	if !a.Finalize() { return fail("Finalize must succeed on adrp") }
	if a.NumRelocs != 1 { return fail("adrp to an L label must stay a relocation") }
	if a.Relocs[0].Kind != FIX_ADRP_HI21 { return fail("relocation kind FIX_ADRP_HI21") }
	return ""
}

// A B.cond to an L label in another section is cross-section, so it is left for the
// object writer as a relocation.
func TestResolveCrossSectionLocalLabelStaysReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.SetSection("data", -1)
	a.DefineLabel("Ld")
	a.EmitUint32(0)
	a.SetSection("text", -1)
	isa.CondBranchLabel(a, COND_EQ, "Ld", 0)
	if !ResolveFixups(a) { return fail("ResolveFixups must not fail on a cross-section target") }
	if !a.Finalize() { return fail("Finalize must succeed on a cross-section target") }
	if a.NumRelocs != 1 { return fail("a cross-section L target must stay a relocation") }
	if ctlWord(a, 0) != 0x54000000 { return fail("a cross-section target must not be patched") }
	return ""
}

// ResolveFixups with the object format known: which same-section references to a
// non-`L` symbol have a displacement fixed at assembly time, as clang decides it.
// Mach-O (subsections via symbols): a reference within the target's own atom is fixed
// — every branch kind, B / BL included — and one from another atom is a relocation.
// ELF: a local symbol's references are fixed; a global one's stay relocations (it may
// be preempted).  Words are clang's for the same source (`-target
// arm64-apple-macos11` / `aarch64-linux-gnu`).

// fmtEmitRefs emits `b.ne T; cbz x0, T; ldr x1, T; adr x2, T; b T; bl T` against T.
func fmtEmitRefs(a @asm.Assembler, t *[]readonly char) {
	isa.CondBranchLabel(a, COND_NE, t, 0)
	isa.CompareBranchLabel(a, false, true, X0, t, 0)
	isa.LdStLiteral(a, isa.LS_LDR_X, X1, t, 0)
	isa.PCRelLabel(a, false, false, X2, t, 0)
	isa.BranchLabel(a, false, t, 0)
	isa.BranchLabel(a, true, t, 0)
}

// fmtProgram assembles `_main: nop; <refs to _main>; loop: nop; <refs to loop>` for
// format, with _main global, and runs ResolveFixups + Finalize.
func fmtProgram(format int) @asm.Assembler {
	var a @asm.Assembler = newAsm()
	a.ObjFormat = format
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	Nop(a)
	fmtEmitRefs(a, "_main")
	a.DefineLabel("loop")
	Nop(a)
	fmtEmitRefs(a, "loop")
	ResolveFixups(a)
	a.Finalize()
	return a
}

// fmtWordsFrom reports whether a's words i0 .. i0+len(want)-1 are want.
func fmtWordsFrom(a @asm.Assembler, i0 int, want *[]readonly uint32) bool {
	for i := 0; i < len(want); i++ {
		if ctlWord(a, i0 + i) != want[i] { return false }
	}
	return true
}

// Mach-O: every reference lies in its target's atom (the _main block in _main's, the
// loop block in loop's), so all twelve resolve — even the global _main's.
func TestResolveMachoSameAtom() testing.TestResult {
	var a @asm.Assembler = fmtProgram(asm.OBJ_MACHO)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumRelocs != 0 { return fail("a same-atom reference must not be a relocation") }
	var refs @[]uint32 = make_slice(uint32, 6)
	refs[0] = 0x54FFFFE1 // b.ne -4
	refs[1] = 0xB4FFFFC0 // cbz x0, -8
	refs[2] = 0x58FFFFA1 // ldr x1, -12
	refs[3] = 0x10FFFF82 // adr x2, -16
	refs[4] = 0x17FFFFFB // b -20
	refs[5] = 0x97FFFFFA // bl -24
	if !fmtWordsFrom(a, 1, refs) { return fail("_main block words") }
	if !fmtWordsFrom(a, 8, refs) { return fail("loop block words") }
	return ""
}

// Mach-O: a reference from another atom — `_f: nop; _g: b.ne _f; b _f` — stays a
// relocation for each kind (the linker may move either atom).
func TestResolveMachoCrossAtom() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	a.DefineLabel("_f")
	Nop(a)
	a.DefineLabel("_g")
	fmtEmitRefs(a, "_f")
	ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumRelocs != 6 { return fail("each cross-atom reference must stay a relocation") }
	return ""
}

// Mach-O: a forward reference to a later atom is never within its target's atom.
func TestResolveMachoForwardToNextAtom() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.ObjFormat = asm.OBJ_MACHO
	a.DefineLabel("_f")
	isa.BranchLabel(a, true, "_g", 0)
	a.DefineLabel("_g")
	Ret(a)
	ResolveFixups(a)
	a.Finalize()
	if a.NumRelocs != 1 { return fail("bl to the next atom must stay a relocation") }
	return ""
}

// ELF: references to the local `loop` resolve (same words as Mach-O); references to
// the global `main` stay relocations, one per instruction.
func TestResolveElfLocalVsGlobal() testing.TestResult {
	var a @asm.Assembler = fmtProgram(asm.OBJ_ELF)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumRelocs != 6 { return fail("the six references to the global must stay relocations") }
	var refs @[]uint32 = make_slice(uint32, 6)
	refs[0] = 0x54FFFFE1
	refs[1] = 0xB4FFFFC0
	refs[2] = 0x58FFFFA1
	refs[3] = 0x10FFFF82
	refs[4] = 0x17FFFFFB
	refs[5] = 0x97FFFFFA
	if !fmtWordsFrom(a, 8, refs) { return fail("loop block words") }
	return ""
}

// With no format set, only what both Mach-O and ELF fix resolves — a local symbol's
// references from its own atom: the six to the local `loop` from inside its atom
// resolve, and the six to the global `_main` stay relocations.
func TestResolveUnknownFormatOnlyLocalLabels() testing.TestResult {
	var a @asm.Assembler = fmtProgram(asm.OBJ_UNKNOWN)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumRelocs != 6 { return fail("only the six references to the global must stay relocations") }
	return ""
}
