package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"

// --- System ---

// NOP: 11010101|00000011|0010|0000|000|11111
func Nop(a @asm.Assembler) {
	emit32(a, 0xD503201F)
}

// SVC #imm16: 11010100|000|imm16|00001
func Svc(a @asm.Assembler, imm int) {
	var inst uint32 = 0xD4000001
	inst = inst | (cast(uint32, imm & 0xffff) << 5)
	emit32(a, inst)
}

// DcZva emits `DC ZVA, Xt` — Data Cache operation, Zero by Virtual
// Address: zero the whole cache-line-sized block (the DCZID_EL0-defined
// block size, typically 64 bytes) containing the address in Xt.  It is
// the fastest zero-fill primitive on AArch64 — one instruction clears an
// entire cache line without a read-for-ownership — and is the core of a
// bzero / MemZero bulk loop.  Alias of `SYS #3, C7, C4, #1, Xt`.
// Encoding: 1101010100|0|01|011|0111|0100|001|Rt
func DcZva(a @asm.Assembler, rt int) {
	emit32(a, 0xD50B7420 | cast(uint32, rt & 0x1f))
}

// Mrs emits `MRS Xt, <sysreg>` — read a system register into Xt, where the
// register is identified by (o0, op1, CRn, CRm, op2).  Used to read
// DCZID_EL0 (o0=1, op1=3, CRn=0, CRm=0, op2=7) — whose low nibble gives the
// DC ZVA block size and bit 4 (DZP) whether DC ZVA is prohibited — before a
// DC ZVA fill loop.
// Encoding: 1101|0101|0011|o0|op1|CRn|CRm|op2|Rt
func Mrs(a @asm.Assembler, rt int, o0 int, op1 int, crn int, crm int, op2 int) {
	var inst uint32 = 0xD5300000
	inst = inst | (cast(uint32, o0 & 1) << 19)
	inst = inst | (cast(uint32, op1 & 7) << 16)
	inst = inst | (cast(uint32, crn & 0xf) << 12)
	inst = inst | (cast(uint32, crm & 0xf) << 8)
	inst = inst | (cast(uint32, op2 & 7) << 5)
	inst = inst | cast(uint32, rt & 0x1f)
	emit32(a, inst)
}

// --- Fixup resolution ---

// readInst32 reads a little-endian uint32 from data at offset.
func readInst32(data @[]uint8, off int) uint32 {
	return cast(uint32, data[off]) | (cast(uint32, data[off + 1]) << 8) |
			(cast(uint32, data[off + 2]) << 16) | (cast(uint32, data[off + 3]) << 24)
}

// writeInst32 writes a little-endian uint32 to data at offset.
func writeInst32(data @[]uint8, off int, inst uint32) {
	data[off] = cast(uint8, inst & 0xff)
	data[off + 1] = cast(uint8, (inst >> 8) & 0xff)
	data[off + 2] = cast(uint8, (inst >> 16) & 0xff)
	data[off + 3] = cast(uint8, (inst >> 24) & 0xff)
}

// patchBranch26 patches a 26-bit PC-relative branch offset (B, BL).
func patchBranch26(data @[]uint8, off int, pcRelOffset int) bool {
	var imm int = pcRelOffset / 4
	if imm < -33554432 || imm > 33554431 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	inst = inst | (cast(uint32, imm) & 0x03FFFFFF)
	writeInst32(data, off, inst)
	return true
}

// patchBranch19 patches a 19-bit PC-relative branch offset (B.cond, CBZ, CBNZ, LDR literal).
func patchBranch19(data @[]uint8, off int, pcRelOffset int) bool {
	var imm int = pcRelOffset / 4
	if imm < -262144 || imm > 262143 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	inst = inst | ((cast(uint32, imm) & 0x7FFFF) << 5)
	writeInst32(data, off, inst)
	return true
}

// patchBranch14 patches a 14-bit PC-relative branch offset (TBZ, TBNZ).
func patchBranch14(data @[]uint8, off int, pcRelOffset int) bool {
	var imm int = pcRelOffset / 4
	if imm < -8192 || imm > 8191 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	inst = inst | ((cast(uint32, imm) & 0x3FFF) << 5)
	writeInst32(data, off, inst)
	return true
}

// patchAdr patches a 21-bit PC-relative offset for ADR.
// The 21-bit immediate is split: immlo (bits [30:29]) and immhi (bits [23:5]).
func patchAdr(data @[]uint8, off int, pcRelOffset int) bool {
	if pcRelOffset < -1048576 || pcRelOffset > 1048575 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	var immlo uint32 = cast(uint32, pcRelOffset) & 3
	var immhi uint32 = (cast(uint32, pcRelOffset) >> 2) & 0x7FFFF
	inst = inst | (immlo << 29)
	inst = inst | (immhi << 5)
	writeInst32(data, off, inst)
	return true
}

// isAtomStartSymbol reports whether name begins a linker atom under
// MH_SUBSECTIONS_VIA_SYMBOLS — i.e. it is NOT a `L`-prefixed local label.
// The linker starts a new atom at every defined symbol except `L`-prefixed
// ones (block labels, string/refcount temporaries), so a B/BL whose target
// is atom-starting may cross an atom boundary the linker can relocate
// independently and must go through a relocation, not an assembly-time
// displacement.
func isAtomStartSymbol(name *[]readonly char) bool {
	return len(name) == 0 || name[0] != 'L'
}

// ResolveFixups resolves all same-section AArch64 fixups by patching instruction bytes.
// Must be called before asm.Finalize(). Fixups that are resolved are marked so
// Finalize skips them. Cross-section and external fixups are left for Finalize.
func ResolveFixups(a @asm.Assembler) bool {
	for si := 0; si < a.NumSections; si++ {
		var s @asm.Section = a.Sections[si]
		var data @[]uint8 = a.SectionData(si)
		for fi := 0; fi < s.NumFixups; fi++ {
			var f asm.Fixup = s.Fixups[fi]
			if f.Kind < FIX_BRANCH26 || f.Kind > FIX_LDR_LO12 {
				continue // not an AArch64 fixup kind
			}
			// Look up the target symbol
			var symIdx int = a.LookupSymbol(f.Label)
			if symIdx < 0 {
				continue // let Finalize report the error
			}
			var sym asm.Symbol = a.Symbols[symIdx]
			if sym.Section != si {
				continue // cross-section — leave for Finalize
			}
			// Same section — resolve.  BRANCH26/19/14 and ADR_LO21
			// have section-base-cancelling PC-relative offsets, so
			// they're computable here and out-of-range is a hard
			// error: the linker can't help (section layout in the
			// .o is fixed) and Mach-O's reloc encodings don't even
			// cover ADR, so leaking through to Finalize would just
			// produce a wrong-instruction reloc.
			//
			// FIX_ADRP_HI21 / FIX_ADD_LO12 / FIX_LDR_LO12 are
			// page-relative; section base doesn't cancel, so we
			// always leave them as relocs.
			var target int = cast(int, sym.Offset) + f.Addend
			var fixup_addr int = cast(int, f.Offset)
			var pcRel int = target - fixup_addr
			var ok bool = false
			var resolvable bool = true
			switch f.Kind {
			case FIX_BRANCH26:
				// A B/BL to an atom-starting (non-`L`) symbol must NOT be
				// resolved to a fixed displacement here: under
				// MH_SUBSECTIONS_VIA_SYMBOLS the linker treats each non-`L`
				// symbol as an independent atom it may reorder, coalesce,
				// or dead-strip, so the inter-function distance is not
				// fixed in the .o.  Leave it for Finalize to emit as an
				// ARM64_RELOC_BRANCH26 against the symbol.  Branches to
				// `L`-prefixed block labels stay within the function's
				// atom and resolve in-section (BRANCH19/14 likewise only
				// ever target block labels — see below).
				if isAtomStartSymbol(sym.Name) {
					resolvable = false
				} else {
					ok = patchBranch26(data, fixup_addr, pcRel)
				}
			case FIX_BRANCH19:
				ok = patchBranch19(data, fixup_addr, pcRel)
			case FIX_BRANCH14:
				ok = patchBranch14(data, fixup_addr, pcRel)
			case FIX_ADR_LO21:
				ok = patchAdr(data, fixup_addr, pcRel)
			default:
				resolvable = false
			}
			if resolvable {
				if !ok {
					a.SetError("aarch64: same-section PC-relative fixup out of range")
					return false
				}
				a.MarkFixupResolved(si, fi)
			}
		}
	}
	return true
}
