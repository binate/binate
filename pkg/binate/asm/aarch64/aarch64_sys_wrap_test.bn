package "pkg/binate/asm/aarch64"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for the backend-facing Svc and Mrs, which route through the isa package's
// ExceptionGen and SysRegMove and so reject what those reject.

// ctlClean reports whether a has no error and its text section holds exactly n words.
func ctlClean(a @asm.Assembler, n int) bool {
	return !a.HasError && a.Sections[0].Len == n * 4
}

// ctlRejected reports whether a has an error and nothing was emitted or recorded.
func ctlRejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0 && a.Sections[0].NumFixups == 0
}

// Svc routes through ExceptionGen, so an immediate past 16 bits is an error rather
// than being truncated.
func TestSvcRejectsWideImmediate() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Svc(a, 0xFFFF)
	if !ctlClean(a, 1) || ctlWord(a, 0) != 0xD41FFFE1 { return fail("svc #0xffff") }
	a = newAsm()
	Svc(a, 0x10000)
	if !ctlRejected(a) { return fail("svc #0x10000 must be rejected, not truncated") }
	return ""
}

// Mrs routes through SysRegMove with op0 = 2 + o0, and rejects an o0 other than 0 / 1
// rather than masking it.
func TestMrsRejectsBadO0() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mrs(a, 2, 0, 0, 0, 2, 2) // mrs x2, mdscr_el1
	if !ctlClean(a, 1) || ctlWord(a, 0) != 0xD5300242 { return fail("mrs x2, mdscr_el1") }
	a = newAsm()
	Mrs(a, 0, 2, 3, 0, 0, 7)
	if !ctlRejected(a) { return fail("o0 2 must be rejected") }
	a = newAsm()
	Mrs(a, 0, -1, 3, 0, 0, 7)
	if !ctlRejected(a) { return fail("o0 -1 must be rejected") }
	return ""
}
