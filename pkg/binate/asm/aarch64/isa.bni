// Package isa provides exact single-instruction AArch64 encoders: each call emits
// precisely the one architectural instruction its arguments name, or sets an
// assembler error when an operand has no encoding — nothing is split into several
// instructions, synthesized through a scratch register, or masked into range.  The
// text assembler (pkg/binate/asm/parse) uses these directly; the backend-oriented
// encoders in pkg/binate/asm/aarch64 route through them.  Registers are encoding
// numbers 0-31 (each operand's doc says whether 31 is SP or the zero register).
package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Shift types: the shift field of a shifted-register operand (and ROR, the rotate).
const (
	LSL int = iota
	LSR
	ASR
	ROR
)

// Fixup kinds for AArch64
const (
	FIX_BRANCH26 int = 100  // 26-bit PC-relative branch offset (B, BL)
	FIX_BRANCH19 int = 101  // 19-bit PC-relative branch offset (B.cond, CBZ, CBNZ)
	FIX_ADR_LO21 int = 102  // 21-bit PC-relative ADR
	FIX_ADRP_HI21 int = 103 // 21-bit PC-relative ADRP (page-aligned)
	FIX_BRANCH14 int = 104  // 14-bit PC-relative branch offset (TBZ, TBNZ)
	FIX_ADD_LO12 int = 105  // 12-bit unscaled low-page offset (ADD imm12)
	FIX_LDR_LO12 int = 106  // 12-bit scaled low-page offset (LDR/STR imm12, 64-bit form)
	// The GOT-indirect pair for reaching an external data symbol under PIE
	// (e.g. a C global via __c_global): ADRP loads the GOT-slot's page, LDR
	// loads the slot's contents (the symbol's real address).  Mach-O:
	// ARM64_RELOC_GOT_LOAD_PAGE21 / _PAGEOFF12; ELF (no aarch64 native ELF
	// target today): R_AARCH64_ADR_GOT_PAGE / _LD64_GOT_LO12_NC.
	FIX_ADRP_GOT_HI21 int = 107 // 21-bit PC-relative ADRP to the GOT-entry page
	FIX_LD_GOT_LO12 int = 108   // 12-bit scaled offset LDR of the GOT slot (64-bit)
)

// Fixup kinds for the `:lo12:` page offset of a non-64-bit unsigned-offset load/store
// (LdStLo12).  Like FIX_LDR_LO12 (the 64-bit form) each fills the instruction's imm12
// with the target's low 12 bits divided by the access size, so the kind carries the
// size: 1, 2, 4 or 16 bytes.
const (
	FIX_LDST8_LO12 int = 109
	FIX_LDST16_LO12 int = 110
	FIX_LDST32_LO12 int = 111
	FIX_LDST128_LO12 int = 112
)

// FIX_LD_PREL_LO19 is the 19-bit word displacement of a PC-relative literal load
// (LDR W/X/S/D/Q, LDRSW, PRFM literal).  It patches the same imm19 field as
// FIX_BRANCH19 but is a data reference, not a branch: ELF relocates it with
// R_AARCH64_LD_PREL_LO19 (a linker may route a branch relocation through a PLT
// stub, which a load must never read), and Mach-O has no relocation for it.
const FIX_LD_PREL_LO19 int = 113

// Single-register load/store transfer specs for the exact encoders (LdStUImm,
// LdStUnscaled, LdStPre, LdStPost, LdStReg, LdStLiteral, LdStLo12): each is the
// instruction's size[31:30], V[26] and opc[23:22] bits, common to all of its
// addressing modes.  General-purpose: STRB/LDRB/LDRSB (to X or W), STRH/LDRH/LDRSH,
// 32-bit STR/LDR and LDRSW, 64-bit STR/LDR, and PRFM (whose Rt is the prefetch
// operation).  SIMD&FP: STR/LDR of a B, H, S, D or Q register.
const (
	LS_STRB uint32 = 0x00000000
	LS_LDRB uint32 = 0x00400000
	LS_LDRSB_X uint32 = 0x00800000
	LS_LDRSB_W uint32 = 0x00C00000
	LS_STRH uint32 = 0x40000000
	LS_LDRH uint32 = 0x40400000
	LS_LDRSH_X uint32 = 0x40800000
	LS_LDRSH_W uint32 = 0x40C00000
	LS_STR_W uint32 = 0x80000000
	LS_LDR_W uint32 = 0x80400000
	LS_LDRSW uint32 = 0x80800000
	LS_STR_X uint32 = 0xC0000000
	LS_LDR_X uint32 = 0xC0400000
	LS_PRFM uint32 = 0xC0800000
	LS_STR_B uint32 = 0x04000000
	LS_LDR_B uint32 = 0x04400000
	LS_STR_H uint32 = 0x44000000
	LS_LDR_H uint32 = 0x44400000
	LS_STR_S uint32 = 0x84000000
	LS_LDR_S uint32 = 0x84400000
	LS_STR_D uint32 = 0xC4000000
	LS_LDR_D uint32 = 0xC4400000
	LS_STR_Q uint32 = 0x04800000
	LS_LDR_Q uint32 = 0x04C00000
)

// Load/store pair transfer specs for LdStPair: opc[31:30], V[26] and L[22].
// General-purpose W and X pairs and LDPSW (sign-extending word pair); SIMD&FP S, D
// and Q pairs.
const (
	LSP_STP_W uint32 = 0x00000000
	LSP_LDP_W uint32 = 0x00400000
	LSP_LDPSW uint32 = 0x40400000
	LSP_STP_X uint32 = 0x80000000
	LSP_LDP_X uint32 = 0x80400000
	LSP_STP_S uint32 = 0x04000000
	LSP_LDP_S uint32 = 0x04400000
	LSP_STP_D uint32 = 0x44000000
	LSP_LDP_D uint32 = 0x44400000
	LSP_STP_Q uint32 = 0x84000000
	LSP_LDP_Q uint32 = 0x84400000
)

// Load/store pair addressing modes (the bits 24:23 field): non-temporal LDNP/STNP
// `[Rn{, #imm}]`, post-indexed `[Rn], #imm`, signed offset `[Rn{, #imm}]`, and
// pre-indexed `[Rn, #imm]!`.
const (
	PAIR_NONTEMPORAL int = 0
	PAIR_POST int = 1
	PAIR_OFFSET int = 2
	PAIR_PRE int = 3
)

// Exclusive and ordered single-register loads / stores (LdStOrdered): the instruction
// word without its size bits (31:30), Rt or Rn.  LDXR / LDAXR load exclusive (plain /
// acquire); LDAR / STLR are load-acquire / store-release; LDLAR / STLLR their
// LORegion forms; LDAPR the RCpc load-acquire.
const (
	LSO_LDXR uint32 = 0x085F7C00
	LSO_LDAXR uint32 = 0x085FFC00
	LSO_LDAR uint32 = 0x08DFFC00
	LSO_STLR uint32 = 0x089FFC00
	LSO_LDLAR uint32 = 0x08DF7C00
	LSO_STLLR uint32 = 0x089F7C00
	LSO_LDAPR uint32 = 0x38BFC000
)

// Store-exclusive operations (StoreExclusive): STXR (plain) and STLXR (release).
const (
	LSO_STXR uint32 = 0x08007C00
	LSO_STLXR uint32 = 0x0800FC00
)

// Atomic memory operations (AtomicOp), the o3 / opc field (bits 15:12): LD<op> adds,
// bit-clears, exclusive-ORs, bit-sets, or takes the signed / unsigned maximum /
// minimum; SWP swaps.
const (
	AMO_ADD uint32 = 0x0000
	AMO_CLR uint32 = 0x1000
	AMO_EOR uint32 = 0x2000
	AMO_SET uint32 = 0x3000
	AMO_SMAX uint32 = 0x4000
	AMO_SMIN uint32 = 0x5000
	AMO_UMAX uint32 = 0x6000
	AMO_UMIN uint32 = 0x7000
	AMO_SWP uint32 = 0x8000
)

// Operation / flag-setting selections (bits 30:29) shared by add/sub (immediate,
// shifted and extended register — AddSubImm, AddSubShifted, AddSubExtended) and
// add/sub with carry (AddSubCarry, where they select ADC / ADCS / SBC / SBCS).
const (
	OPS_ADD uint32 = 0x00000000
	OPS_ADDS uint32 = 0x20000000
	OPS_SUB uint32 = 0x40000000
	OPS_SUBS uint32 = 0x60000000
)

// Logical operations (opc, bits 30:29) for LogicalImm and LogicalShifted; LG_NOT
// (the N bit 21, shifted-register form only) inverts Rm, giving BIC / ORN / EON / BICS
// from AND / ORR / EOR / ANDS.
const (
	LG_AND uint32 = 0x00000000
	LG_ORR uint32 = 0x20000000
	LG_EOR uint32 = 0x40000000
	LG_ANDS uint32 = 0x60000000
	LG_NOT uint32 = 0x00200000
)

// Move-wide operations (opc, bits 30:29) for MoveWide.
const (
	MW_MOVN uint32 = 0x00000000
	MW_MOVZ uint32 = 0x40000000
	MW_MOVK uint32 = 0x60000000
)

// Bitfield operations (opc, bits 30:29) for Bitfield.
const (
	BF_SBFM uint32 = 0x00000000
	BF_BFM uint32 = 0x20000000
	BF_UBFM uint32 = 0x40000000
)

// Add/sub extended-register extend options (the option field, bits 15:13): zero- or
// sign-extend the low byte, halfword, word or doubleword of Rm.
const (
	XT_UXTB int = 0
	XT_UXTH int = 1
	XT_UXTW int = 2
	XT_UXTX int = 3
	XT_SXTB int = 4
	XT_SXTH int = 5
	XT_SXTW int = 6
	XT_SXTX int = 7
)

// Two-source data-processing opcodes (bits 15:10) for DataProc2.
const (
	D2_UDIV int = 2
	D2_SDIV int = 3
	D2_LSLV int = 8
	D2_LSRV int = 9
	D2_ASRV int = 10
	D2_RORV int = 11
)

// One-source data-processing opcodes (bits 15:10) for DataProc1: D1_REV32 is the
// 32-bit REV (and REV32 of an X register), D1_REV64 the 64-bit REV.
const (
	D1_RBIT int = 0
	D1_REV16 int = 1
	D1_REV32 int = 2
	D1_REV64 int = 3
	D1_CLZ int = 4
	D1_CLS int = 5
)

// Pointer-authentication operations (PointerAuth), the opcode field (bits 15:10) of
// the one-source data-processing class with opcode2 = 00001: PAC (sign) / AUT
// (authenticate) with the instruction (I) or data (D) key A or B, first with a
// modifier register, then the zero-modifier (Z) forms, then XPACI / XPACD (strip).
const (
	PA_PACIA int = 0
	PA_PACIB int = 1
	PA_PACDA int = 2
	PA_PACDB int = 3
	PA_AUTIA int = 4
	PA_AUTIB int = 5
	PA_AUTDA int = 6
	PA_AUTDB int = 7
	PA_PACIZA int = 8
	PA_PACIZB int = 9
	PA_PACDZA int = 10
	PA_PACDZB int = 11
	PA_AUTIZA int = 12
	PA_AUTIZB int = 13
	PA_AUTDZA int = 14
	PA_AUTDZB int = 15
	PA_XPACI int = 16
	PA_XPACD int = 17
)

// Floating-point precisions (the ftype field, bits 23:22) of the scalar FP encoders:
// single, double and half.
const (
	FT_S int = 0
	FT_D int = 1
	FT_H int = 3
)

// One-source FP operations (FPDataProc1), the opcode field (bits 20:15): move,
// absolute value, negate, square root, and the roundings — to nearest with ties to
// even (N), toward +inf (P), toward -inf (M), toward zero (Z), to nearest with ties
// away (A), exact in the current mode (X), current mode (I), and to a 32- / 64-bit
// integer range toward zero (32Z / 64Z) or in the current mode (32X / 64X).
const (
	FP1_FMOV int = 0
	FP1_FABS int = 1
	FP1_FNEG int = 2
	FP1_FSQRT int = 3
	FP1_FRINTN int = 8
	FP1_FRINTP int = 9
	FP1_FRINTM int = 10
	FP1_FRINTZ int = 11
	FP1_FRINTA int = 12
	FP1_FRINTX int = 14
	FP1_FRINTI int = 15
	FP1_FRINT32Z int = 16
	FP1_FRINT32X int = 17
	FP1_FRINT64Z int = 18
	FP1_FRINT64X int = 19
)

// Two-source FP operations (FPDataProc2), the opcode field (bits 15:12).
const (
	FP2_FMUL int = 0
	FP2_FDIV int = 1
	FP2_FADD int = 2
	FP2_FSUB int = 3
	FP2_FMAX int = 4
	FP2_FMIN int = 5
	FP2_FMAXNM int = 6
	FP2_FMINNM int = 7
	FP2_FNMUL int = 8
)

// Three-source FP operations (FPDataProc3): o1:o0 (bits 21 and 15) as a two-bit value.
const (
	FP3_FMADD int = 0
	FP3_FMSUB int = 1
	FP3_FNMADD int = 2
	FP3_FNMSUB int = 3
)

// FP / integer conversions (FPIntConvert; the four FCVTZ* / *CVTF also FPFixedConvert),
// the rmode:opcode field (bits 20:16): FCVT{N,A,P,M,Z}{S,U} convert FP to a signed /
// unsigned integer rounding to nearest with ties to even (N), to nearest with ties
// away (A), toward +inf (P), toward -inf (M) or toward zero (Z); SCVTF / UCVTF convert
// a signed / unsigned integer to FP.
const (
	FI_FCVTNS int = 0x00
	FI_FCVTNU int = 0x01
	FI_SCVTF int = 0x02
	FI_UCVTF int = 0x03
	FI_FCVTAS int = 0x04
	FI_FCVTAU int = 0x05
	FI_FCVTPS int = 0x08
	FI_FCVTPU int = 0x09
	FI_FCVTMS int = 0x10
	FI_FCVTMU int = 0x11
	FI_FCVTZS int = 0x18
	FI_FCVTZU int = 0x19
)

// The same conversions with the integer in an FP register of a different size
// (FPRegIntConvert, FEAT_FPRCVT), the rmode:opcode field (bits 20:16).
const (
	FR_FCVTNS int = 0x0A
	FR_FCVTNU int = 0x0B
	FR_FCVTPS int = 0x12
	FR_FCVTPU int = 0x13
	FR_FCVTMS int = 0x14
	FR_FCVTMU int = 0x15
	FR_FCVTZS int = 0x16
	FR_FCVTZU int = 0x17
	FR_FCVTAS int = 0x1A
	FR_FCVTAU int = 0x1B
	FR_SCVTF int = 0x1C
	FR_UCVTF int = 0x1D
)

// Flag-manipulation instructions without operands (FlagManip), as whole words:
// CFINV inverts C; XAFLAG / AXFLAG convert between the Arm and the external
// (x86-style) floating-point comparison flag formats.
const (
	FL_CFINV uint32 = 0xD500401F
	FL_XAFLAG uint32 = 0xD500403F
	FL_AXFLAG uint32 = 0xD500405F
)

// Conditional-select operations (op bit 30 and op2 bits 11:10) for CondSelect.
const (
	CS_SEL uint32 = 0x00000000
	CS_INC uint32 = 0x00000400
	CS_INV uint32 = 0x40000000
	CS_NEG uint32 = 0x40000400
)

// Branch-to-register operations for BranchReg.
const (
	BR_BR int = 0
	BR_BLR int = 1
	BR_RET int = 2
)

// Exception-generating instruction words (immediate zero) for ExceptionGen; EXC_UDF
// selects the permanently-undefined UDF, whose immediate occupies bits 15:0.
const (
	EXC_UDF uint32 = 0x00000000
	EXC_SVC uint32 = 0xD4000001
	EXC_HVC uint32 = 0xD4000002
	EXC_SMC uint32 = 0xD4000003
	EXC_BRK uint32 = 0xD4200000
	EXC_HLT uint32 = 0xD4400000
	EXC_DCPS1 uint32 = 0xD4A00001
	EXC_DCPS2 uint32 = 0xD4A00002
	EXC_DCPS3 uint32 = 0xD4A00003
)

// Fixed-form branch / exception-return words for SysBranch: no-operand ERET, DRPS,
// RETAA, RETAB, ERETAA, ERETAB; Rn-only BRAAZ, BRABZ, BLRAAZ, BLRABZ; Rn + Rm BRAA,
// BRAB, BLRAA, BLRAB (pointer-authenticated branches).
const (
	SB_ERET uint32 = 0xD69F03E0
	SB_DRPS uint32 = 0xD6BF03E0
	SB_RETAA uint32 = 0xD65F0BFF
	SB_RETAB uint32 = 0xD65F0FFF
	SB_ERETAA uint32 = 0xD69F0BFF
	SB_ERETAB uint32 = 0xD69F0FFF
	SB_BRAAZ uint32 = 0xD61F081F
	SB_BRABZ uint32 = 0xD61F0C1F
	SB_BLRAAZ uint32 = 0xD63F081F
	SB_BLRABZ uint32 = 0xD63F0C1F
	SB_BRAA uint32 = 0xD71F0800
	SB_BRAB uint32 = 0xD71F0C00
	SB_BLRAA uint32 = 0xD73F0800
	SB_BLRAB uint32 = 0xD73F0C00
)

// Barrier instruction words (CRm option zero) for Barrier.
const (
	BAR_CLREX uint32 = 0xD503305F
	BAR_DSB uint32 = 0xD503309F
	BAR_DMB uint32 = 0xD50330BF
	BAR_ISB uint32 = 0xD50330DF
	BAR_SB uint32 = 0xD50330FF
)

// Register-offset extend options (the `option` field, bits 15:13, of a register-
// offset load/store): the index register Rm is a W register zero- (UXTW) or sign-
// (SXTW) extended, or an X register used as is (LSL, also written UXTX) or
// sign-extended (SXTX, equivalent for a 64-bit index).
const (
	EXT_UXTW int = 2
	EXT_LSL int = 3
	EXT_SXTW int = 6
	EXT_SXTX int = 7
)

// BranchLabel emits B / BL (link) to label + addend.
func BranchLabel(a @asm.Assembler, link bool, label *[]readonly char, addend int)

// BranchOffset emits B / BL with an explicit PC-relative byte offset.
func BranchOffset(a @asm.Assembler, link bool, offset int)

// CondBranchLabel emits B.cond to label + addend.
func CondBranchLabel(a @asm.Assembler, cond int, label *[]readonly char, addend int)

// CondBranchOffset emits B.cond with an explicit PC-relative byte offset.
func CondBranchOffset(a @asm.Assembler, cond int, offset int)

// CompareBranchLabel emits CBZ / CBNZ (nonzero) of Rt to label + addend.
func CompareBranchLabel(a @asm.Assembler, nonzero bool, sf bool, rt int, label *[]readonly char,
		addend int)

// CompareBranchOffset emits CBZ / CBNZ with an explicit PC-relative byte offset.
func CompareBranchOffset(a @asm.Assembler, nonzero bool, sf bool, rt int, offset int)

// TestBranchLabel emits TBZ / TBNZ (nonzero) of bit (0-63) of Rt to label + addend.
func TestBranchLabel(a @asm.Assembler, nonzero bool, rt int, bit int, label *[]readonly char,
		addend int)

// TestBranchOffset emits TBZ / TBNZ with an explicit PC-relative byte offset.
func TestBranchOffset(a @asm.Assembler, nonzero bool, rt int, bit int, offset int)

// BranchReg emits BR / BLR / RET (a BR_* op) of X register Rn.
func BranchReg(a @asm.Assembler, op int, rn int)

// PCRelLabel emits ADR / ADRP (page) of label + addend into Rd; got (ADRP only) takes
// the page of label's GOT slot.
func PCRelLabel(a @asm.Assembler, page bool, got bool, rd int, label *[]readonly char, addend int)

// PCRelOffset emits ADR / ADRP (page) with an explicit PC-relative offset.
func PCRelOffset(a @asm.Assembler, page bool, rd int, offset int)

// ExceptionGen emits SVC/HVC/SMC/BRK/HLT/DCPS1-3/UDF (an EXC_* op) #imm16.
func ExceptionGen(a @asm.Assembler, op uint32, imm int)

// SysBranch emits a fixed-form branch / exception return (an SB_* op) with Rn / Rm
// as the form takes them.
func SysBranch(a @asm.Assembler, op uint32, rn int, rm int)

// Hint emits HINT #imm (0..127).
func Hint(a @asm.Assembler, imm int)

// Barrier emits CLREX / DSB / DMB / ISB / SB (a BAR_* op) with CRm option crm.
func Barrier(a @asm.Assembler, op uint32, crm int)

// SysRegMove emits MRS (read) / MSR (register) of the system register op0, op1, CRn,
// CRm, op2.
func SysRegMove(a @asm.Assembler, read bool, rt int, op0 int, op1 int, crn int, crm int, op2 int)

// MsrImm emits MSR (immediate) to the PSTATE field op1 / op2.
func MsrImm(a @asm.Assembler, op1 int, op2 int, imm int)

// Sys emits SYS `#op1, Cn, Cm, #op2{, Xt}` or SYSL (sysl) `Xt, #op1, Cn, Cm, #op2`.
func Sys(a @asm.Assembler, sysl bool, op1 int, crn int, crm int, op2 int, rt int)

// AddSubImm emits ADD/ADDS/SUB/SUBS (immediate) `op Rd, Rn, #imm{, lsl #12}` (imm
// 0..4095).  Rn and a non-flag-setting Rd may be SP (register 31).
func AddSubImm(a @asm.Assembler, op uint32, sf bool, rd int, rn int, imm int, shift12 bool)

// AddSubLo12 emits `add Rd, Rn, #:lo12:label+addend` (FIX_ADD_LO12).
func AddSubLo12(a @asm.Assembler, sf bool, rd int, rn int, label *[]readonly char, addend int)

// AddSubShifted emits ADD/ADDS/SUB/SUBS (shifted register) `op Rd, Rn, Rm{, shift
// #amount}` (LSL/LSR/ASR, amount below the width).
func AddSubShifted(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, shift int,
		amount int)

// AddSubExtended emits ADD/ADDS/SUB/SUBS (extended register) `op Rd, Rn, Rm, ext
// {#amount}` (an XT_* extend, amount 0..4).
func AddSubExtended(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, ext int,
		amount int)

// AddSubCarry emits ADC/ADCS/SBC/SBCS `op Rd, Rn, Rm` (op OPS_ADD/ADDS/SUB/SUBS).
func AddSubCarry(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int)

// IsLogicalImm reports whether value is an encodable bitmask immediate for width sf.
func IsLogicalImm(value uint64, sf bool) bool

// LogicalImm emits AND/ORR/EOR/ANDS (immediate) `op Rd, Rn, #bitmask`; errors unless
// value is an encodable bitmask for the width.
func LogicalImm(a @asm.Assembler, op uint32, sf bool, rd int, rn int, value uint64)

// LogicalShifted emits AND/BIC/ORR/ORN/EOR/EON/ANDS/BICS (shifted register) `op Rd,
// Rn, Rm{, shift #amount}` (LSL/LSR/ASR/ROR, amount below the width).
func LogicalShifted(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, shift int,
		amount int)

// MoveWide emits MOVN/MOVZ/MOVK `op Rd, #imm16{, lsl #shift}`.
func MoveWide(a @asm.Assembler, op uint32, sf bool, rd int, imm16 int, shift int)

// Bitfield emits SBFM/BFM/UBFM `op Rd, Rn, #immr, #imms`.
func Bitfield(a @asm.Assembler, op uint32, sf bool, rd int, rn int, immr int, imms int)

// Extr emits EXTR `Rd, Rn, Rm, #lsb`.
func Extr(a @asm.Assembler, sf bool, rd int, rn int, rm int, lsb int)

// DataProc2 emits UDIV/SDIV/LSLV/LSRV/ASRV/RORV `op Rd, Rn, Rm` (a D2_* opcode).
func DataProc2(a @asm.Assembler, op int, sf bool, rd int, rn int, rm int)

// DataProc1 emits RBIT/REV16/REV/REV32/CLZ/CLS `op Rd, Rn` (a D1_* opcode).
func DataProc1(a @asm.Assembler, op int, sf bool, rd int, rn int)

// Crc32 emits CRC32{B,H,W,X} / CRC32C* (castagnoli) `Wd, Wn, Rm` over 1 << size bytes
// (size 0..3; Rm an X register for size 3).
func Crc32(a @asm.Assembler, castagnoli bool, size int, rd int, rn int, rm int)

// PacGA emits PACGA `Xd, Xn, Xm|SP`.
func PacGA(a @asm.Assembler, rd int, rn int, rm int)

// PointerAuth emits a PA_* operation: `Xd, Xn|SP` for PA_PACIA … PA_AUTDB, `Xd` (rn
// must be 31) for the Z forms and XPACI / XPACD.
func PointerAuth(a @asm.Assembler, op int, rd int, rn int)

// FlagManip emits CFINV / XAFLAG / AXFLAG (an FL_* op).
func FlagManip(a @asm.Assembler, op uint32)

// Rmif emits RMIF `Xn, #shift, #mask` (shift 0..63, mask 0..15).
func Rmif(a @asm.Assembler, rn int, shift int, mask int)

// SetFlags emits SETF8 / SETF16 (sixteen) `Wn`.
func SetFlags(a @asm.Assembler, sixteen bool, rn int)

// FPDataProc1 emits a one-source FP1_* operation `Fd, Fn` at precision ftype (FT_*);
// FRINT32* / FRINT64* are single / double only.
func FPDataProc1(a @asm.Assembler, op int, ftype int, rd int, rn int)

// FPConvert emits FCVT `Fd, Fn` from precision from to a different precision to.
func FPConvert(a @asm.Assembler, to int, from int, rd int, rn int)

// BFConvert emits BFCVT `Hd, Sn`.
func BFConvert(a @asm.Assembler, rd int, rn int)

// FPDataProc2 emits a two-source FP2_* operation `Fd, Fn, Fm` at precision ftype.
func FPDataProc2(a @asm.Assembler, op int, ftype int, rd int, rn int, rm int)

// FPDataProc3 emits an FP3_* operation `Fd, Fn, Fm, Fa` at precision ftype.
func FPDataProc3(a @asm.Assembler, op int, ftype int, rd int, rn int, rm int, ra int)

// FPCompare emits FCMP / FCMPE (signaling) `Fn, Fm`, or `Fn, #0.0` (withZero, rm 0).
func FPCompare(a @asm.Assembler, signaling bool, ftype int, rn int, rm int, withZero bool)

// FPCondCompare emits FCCMP / FCCMPE (signaling) `Fn, Fm, #nzcv, cond`.
func FPCondCompare(a @asm.Assembler, signaling bool, ftype int, rn int, rm int, nzcv int, cond int)

// FPCondSelect emits FCSEL `Fd, Fn, Fm, cond`.
func FPCondSelect(a @asm.Assembler, ftype int, rd int, rn int, rm int, cond int)

// FMovGP emits FMOV between a GP register (X if sf, else W) and an FP register of
// precision ftype: toFP moves Rn into Fd, else Fn into Rd.  W–S, X–D, W–H and X–H only.
func FMovGP(a @asm.Assembler, toFP bool, sf bool, ftype int, rd int, rn int)

// FMovImm emits FMOV `Fd, #imm` from the 8-bit floating-point immediate imm8 (0..255).
func FMovImm(a @asm.Assembler, ftype int, rd int, imm8 int)

// FMovTopHalf emits FMOV `Vd.D[1], Xn` (toFP) or `Xd, Vn.D[1]`.
func FMovTopHalf(a @asm.Assembler, toFP bool, rd int, rn int)

// FPIntConvert emits an FI_* conversion: FCVT* `Rd, Fn` or SCVTF / UCVTF `Fd, Rn`, with a
// W or X (sf) general-purpose register.
func FPIntConvert(a @asm.Assembler, op int, sf bool, ftype int, rd int, rn int)

// FPFixedConvert emits fixed-point FCVTZS / FCVTZU / SCVTF / UCVTF with fbits fraction
// bits (1..32 for W, 1..64 for X).
func FPFixedConvert(a @asm.Assembler, op int, sf bool, ftype int, rd int, rn int, fbits int)

// FJCvtZS emits FJCVTZS `Wd, Dn`.
func FJCvtZS(a @asm.Assembler, rd int, rn int)

// FPRegIntConvert emits an FR_* conversion with the integer in an FP register of a
// different size: 64-bit (sf, a D register) or 32-bit (an S register), FP precision ftype.
func FPRegIntConvert(a @asm.Assembler, op int, sf bool, ftype int, rd int, rn int)

// SimdDupElement emits DUP `Vd.<T>, Vn.<Ts>[index]` (q: 128-bit; size 0..3 the element;
// 1D reserved).
func SimdDupElement(a @asm.Assembler, q bool, size int, rd int, rn int, index int)

// SimdDupScalar emits DUP `<V>d, Vn.<T>[index]` (the scalar MOV alias).
func SimdDupScalar(a @asm.Assembler, size int, rd int, rn int, index int)

// SimdDupGeneral emits DUP `Vd.<T>, Rn` (W for B / H / S, X for D; 1D reserved).
func SimdDupGeneral(a @asm.Assembler, q bool, size int, rd int, rn int)

// SimdInsGeneral emits INS `Vd.<Ts>[index], Rn`.
func SimdInsGeneral(a @asm.Assembler, size int, rd int, index int, rn int)

// SimdInsElement emits INS `Vd.<Ts>[dindex], Vn.<Ts>[sindex]`.
func SimdInsElement(a @asm.Assembler, size int, rd int, dindex int, rn int, sindex int)

// SimdUmov emits UMOV `Rd, Vn.<Ts>[index]` (W for B / H / S, X for D).
func SimdUmov(a @asm.Assembler, size int, rd int, rn int, index int)

// SimdSmov emits SMOV `Rd, Vn.<Ts>[index]` (B / H into W or X, S into X only).
func SimdSmov(a @asm.Assembler, sf bool, size int, rd int, rn int, index int)

// SimdTableLookup emits TBL (or TBX, tbx) `Vd.<T>, {Vn.16B, …}, Vm.<T>` with a table of
// count (1..4) consecutive registers from Rn; <T> is 16B (q) or 8B.
func SimdTableLookup(a @asm.Assembler, q bool, tbx bool, rd int, rn int, count int, rm int)

// MulAdd emits MADD / MSUB `Rd, Rn, Rm, Ra`.
func MulAdd(a @asm.Assembler, sub bool, sf bool, rd int, rn int, rm int, ra int)

// MulAddLong emits SMADDL/SMSUBL/UMADDL/UMSUBL `Xd, Wn, Wm, Xa`.
func MulAddLong(a @asm.Assembler, isUnsigned bool, sub bool, rd int, rn int, rm int, ra int)

// MulHigh emits SMULH / UMULH `Xd, Xn, Xm`.
func MulHigh(a @asm.Assembler, isUnsigned bool, rd int, rn int, rm int)

// CondSelect emits CSEL/CSINC/CSINV/CSNEG `op Rd, Rn, Rm, cond` (a CS_* op).
func CondSelect(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, cond int)

// CondCompare emits CCMN / CCMP `Rn, <Rm | #imm5>, #nzcv, cond`.
func CondCompare(a @asm.Assembler, cmp bool, sf bool, rn int, isImm bool, imm int, nzcv int,
		cond int)

// LdStAccessBytes returns the access size in bytes of an LS_* spec (the unit of the
// unsigned-offset imm12): 1, 2, 4, 8, or 16 for a Q transfer.
func LdStAccessBytes(spec uint32) int

// LdStUImm emits `<op> Rt, [Rn, #offset]` (unsigned scaled offset); errors unless
// offset is a non-negative multiple of the access size with offset/size <= 4095.
func LdStUImm(a @asm.Assembler, spec uint32, rt int, rn int, offset int)

// LdStUnscaled emits LDUR/STUR `<op> Rt, [Rn, #offset]`, offset in [-256, 255].
func LdStUnscaled(a @asm.Assembler, spec uint32, rt int, rn int, offset int)

// LdStPre emits `<op> Rt, [Rn, #offset]!`, offset in [-256, 255].
func LdStPre(a @asm.Assembler, spec uint32, rt int, rn int, offset int)

// LdStPost emits `<op> Rt, [Rn], #offset`, offset in [-256, 255].
func LdStPost(a @asm.Assembler, spec uint32, rt int, rn int, offset int)

// LdStReg emits `<op> Rt, [Rn, Rm{, <ext> {#amount}}]`; ext is an EXT_* option and
// scaled sets S (index shifted by log2(access size)).
func LdStReg(a @asm.Assembler, spec uint32, rt int, rn int, rm int, ext int, scaled bool)

// LdStLiteral emits a PC-relative literal load `<op> Rt, label+addend` (LS_LDR_W, LS_LDR_X,
// LS_LDRSW, LS_LDR_S, LS_LDR_D, LS_LDR_Q or LS_PRFM; any other spec is an error).
func LdStLiteral(a @asm.Assembler, spec uint32, rt int, label *[]readonly char, addend int)

// LdStLiteralOffset emits the literal form with an explicit PC-relative byte offset,
// `<op> Rt, #offset` (a multiple of 4 within +/-1MB).
func LdStLiteralOffset(a @asm.Assembler, spec uint32, rt int, offset int)

// LdStLo12 emits `<op> Rt, [Rn, #:lo12:label+addend]` with a fixup of the spec's
// access size.
func LdStLo12(a @asm.Assembler, spec uint32, rt int, rn int, label *[]readonly char, addend int)

// LdGotLo12 emits `ldr Xt, [Xn, #:got_lo12:label]` — the 64-bit load of label's GOT
// slot, whose page an ADRP (PCRelLabel with got) put in Xn — with a FIX_LD_GOT_LO12
// fixup.  A GOT slot is a pointer, so only the X form exists, and it takes no addend.
func LdGotLo12(a @asm.Assembler, rt int, rn int, label *[]readonly char)

// LdStPair emits `<op> Rt1, Rt2, <addr>` for an LSP_* spec in a PAIR_* mode; offset
// must be a multiple of the element size within [-64, 63] elements.
func LdStPair(a @asm.Assembler, spec uint32, rt1 int, rt2 int, rn int, offset int, mode int)

// LdStOrdered emits `<op> Rt, [Rn]` for LSO_LDXR / LDAXR / LDAR / STLR / LDLAR / STLLR
// / LDAPR — a load-exclusive or ordered single-register transfer of 1 << size bytes
// (size 0..3: B, H, W, X).
func LdStOrdered(a @asm.Assembler, op uint32, size int, rt int, rn int)

// StoreExclusive emits STXR / STLXR (LSO_STXR / LSO_STLXR) `Ws, Rt, [Rn]` of
// 1 << size bytes; a status register that is also Rt, or Rn other than SP, is an error.
func StoreExclusive(a @asm.Assembler, op uint32, size int, rs int, rt int, rn int)

// LoadExclusivePair emits LDXP / LDAXP (acquire) `Rt, Rt2, [Rn]`, W or X (sf)
// registers; Rt == Rt2 (CONSTRAINED UNPREDICTABLE) is an error.
func LoadExclusivePair(a @asm.Assembler, acquire bool, sf bool, rt int, rt2 int, rn int)

// StoreExclusivePair emits STXP / STLXP (release) `Ws, Rt, Rt2, [Rn]`, W or X (sf)
// data registers; a status register equal to Rt, Rt2 or Rn (other than SP) is an error.
func StoreExclusivePair(a @asm.Assembler, release bool, sf bool, rs int, rt int, rt2 int, rn int)

// LdStRcpcUnscaled emits LDAPUR / STLUR (and the sign-extending LDAPURS*)
// `Rt, [Rn, #offset]`, offset in [-256, 255], for the transfer an LS_* spec names —
// general purpose or SIMD&FP; LS_PRFM is an error.
func LdStRcpcUnscaled(a @asm.Assembler, spec uint32, rt int, rn int, offset int)

// LdStOrderedPair emits LDIAPP (load) / STILP (store) `Rt, Rt2, [Rn]`, W or X (sf)
// registers; writeback post-increments (LDIAPP, `[Rn], #8|#16`) or pre-decrements
// (STILP, `[Rn, #-8|#-16]!`) Rn by the pair's size.  LDIAPP with Rt == Rt2, or a
// writeback base that is also a data register (other than SP), is an error.
func LdStOrderedPair(a @asm.Assembler, load bool, sf bool, rt int, rt2 int, rn int, writeback bool)

// LdStOrderedWriteback emits LDAPR `Rt, [Rn], #size` (load) or STLR `Rt, [Rn,
// #-size]!` (store), W or X (sf) Rt; a base that is also Rt (other than SP) is an error.
func LdStOrderedWriteback(a @asm.Assembler, load bool, sf bool, rt int, rn int)

// LdStUnprivileged emits LDTR / STTR (and the byte, halfword and sign-extending forms)
// `Rt, [Rn, #offset]`, offset in [-256, 255], for a general-purpose LS_* spec other
// than PRFM.
func LdStUnprivileged(a @asm.Assembler, spec uint32, rt int, rn int, offset int)

// LoadAuthenticated emits LDRAA / LDRAB (keyB) `Xt, [Xn{, #offset}]` or, with
// writeback, `Xt, [Xn, #offset]!`; offset a multiple of 8 in [-4096, 4088], and a
// writeback base equal to Xt (other than SP) is an error.
func LoadAuthenticated(a @asm.Assembler, keyB bool, rt int, rn int, offset int, writeback bool)

// AtomicOp emits LD<op> / SWP (an AMO_* op) `Rs, Rt, [Rn]` of 1 << size bytes (size
// 0..3), with acquire (A) / release (L) ordering; an ST<op> is AtomicOp without
// acquire and with Rt = 31 (an acquire into the zero register has no acquire
// semantics).
func AtomicOp(a @asm.Assembler, op uint32, size int, acquire bool, release bool, rs int, rt int,
		rn int)

// CompareSwap emits CAS{A}{L} `Rs, Rt, [Rn]` of 1 << size bytes (size 0..3).
func CompareSwap(a @asm.Assembler, size int, acquire bool, release bool, rs int, rt int, rn int)

// CompareSwapPair emits CASP{A}{L} `Rs, Rs+1, Rt, Rt+1, [Rn]` on W or X (sf) pairs named
// by their first registers, which must be even.
func CompareSwapPair(a @asm.Assembler, sf bool, acquire bool, release bool, rs int, rt int, rn int)
