package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the FEAT_LSE atomics: the atomic memory operations LD<op> /
// SWP (and the ST<op> aliases, which are LD<op> without acquire and with the zero
// register as Rt),
// compare-and-swap CAS, and the pair compare-and-swap CASP.  Each takes its
// acquire / release ordering as two flags (A and L in the mnemonic).  Every register
// is zero-or-register (31 = XZR / WZR) except the base Rn, which is SP-or-register.

// atomicOpValid reports whether op is one of the AMO_* operations.
func atomicOpValid(op uint32) bool {
	return op == AMO_ADD || op == AMO_CLR || op == AMO_EOR || op == AMO_SET || op == AMO_SMAX ||
			op == AMO_SMIN || op == AMO_UMAX || op == AMO_UMIN || op == AMO_SWP
}

// AtomicOp emits LD<op> / SWP (an AMO_* op) `Rs, Rt, [Rn]` of 1 << size bytes (size
// 0..3: B, H, W, X): memory at Rn is combined with Rs (or replaced by it, for SWP)
// and its old value loaded into Rt.  acquire / release select the A / L forms; an
// acquire with the zero register as Rt has no acquire semantics (the architecture
// drops them when nothing is loaded).
func AtomicOp(a @asm.Assembler, op uint32, size int, acquire bool, release bool, rs int, rt int,
		rn int) {
	if !regsOk(a, rs, rt, rn, 0) { return }
	if !atomicOpValid(op) {
		a.SetError("atomic: invalid operation")
		return
	}
	if size < 0 || size > 3 {
		a.SetError("atomic: size out of range [0, 3]")
		return
	}
	var inst uint32 = 0x38200000 | op | (cast(uint32, size) << 30) | (cast(uint32, rs) << 16)
	if acquire { inst = inst | 0x00800000 }
	if release { inst = inst | 0x00400000 }
	emit32(a, ldstRegs(inst, rn, rt))
}

// CompareSwap emits CAS `Rs, Rt, [Rn]` of 1 << size bytes (size 0..3): if memory at
// Rn equals Rs it is replaced by Rt; either way its old value is loaded into Rs.
// acquire / release select the A / L forms.
func CompareSwap(a @asm.Assembler, size int, acquire bool, release bool, rs int, rt int, rn int) {
	if !regsOk(a, rs, rt, rn, 0) { return }
	if size < 0 || size > 3 {
		a.SetError("cas: size out of range [0, 3]")
		return
	}
	var inst uint32 = 0x08A07C00 | (cast(uint32, size) << 30) | (cast(uint32, rs) << 16)
	if acquire { inst = inst | 0x00400000 }
	if release { inst = inst | 0x00008000 }
	emit32(a, ldstRegs(inst, rn, rt))
}

// CompareSwapPair emits CASP `Rs, Rs+1, Rt, Rt+1, [Rn]` on W or X (sf) register
// pairs, named by their even first registers rs and rt (an odd one is an error).
func CompareSwapPair(a @asm.Assembler, sf bool, acquire bool, release bool, rs int, rt int,
		rn int) {
	if !regsOk(a, rs, rt, rn, 0) { return }
	if (rs & 1) != 0 || (rt & 1) != 0 {
		a.SetError("casp: each register pair must start at an even register")
		return
	}
	var inst uint32 = 0x08207C00 | (cast(uint32, rs) << 16)
	if sf { inst = inst | 0x40000000 }
	if acquire { inst = inst | 0x00400000 }
	if release { inst = inst | 0x00008000 }
	emit32(a, ldstRegs(inst, rn, rt))
}
