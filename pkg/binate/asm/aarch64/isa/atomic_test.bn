package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The LSE atomic encoders (the text assembler's golden tables cover their full
// matrix): one clang word per valid call, and nothing — only an error — for an invalid
// op, size or register, or a CASP pair starting at an odd register.  (lsdpRejected /
// lsdpClean / lsdpWordIs are in ldst_test.bn.)

func TestAtomicOp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AtomicOp(a, AMO_UMIN, 3, true, true, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xF8E07041) { return fail("lduminal x0, x1, [x2]") }
	a = newAsm()
	AtomicOp(a, AMO_SWP, 0, false, true, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x38608041) { return fail("swplb w0, w1, [x2]") }
	a = newAsm()
	AtomicOp(a, AMO_ADD, 2, false, false, 0, 31, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xB820005F) { return fail("stadd w0, [x2]") }
	a = newAsm()
	AtomicOp(a, 0x9000, 3, false, false, 0, 1, 2)
	if !lsdpRejected(a) { return fail("an invalid op") }
	a = newAsm()
	AtomicOp(a, AMO_ADD, 4, false, false, 0, 1, 2)
	if !lsdpRejected(a) { return fail("size 4") }
	a = newAsm()
	AtomicOp(a, AMO_ADD, -1, false, false, 0, 1, 2)
	if !lsdpRejected(a) { return fail("size -1") }
	a = newAsm()
	AtomicOp(a, AMO_ADD, 3, false, false, 0, 1, 32)
	if !lsdpRejected(a) { return fail("register 32") }
	return ""
}

func TestCompareSwap() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CompareSwap(a, 1, true, true, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x48E0FC41) { return fail("casalh w0, w1, [x2]") }
	a = newAsm()
	CompareSwap(a, 4, false, false, 0, 1, 2)
	if !lsdpRejected(a) { return fail("size 4") }
	a = newAsm()
	CompareSwapPair(a, true, false, false, 0, 2, 4)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x48207C82) { return fail("casp x0, x1, x2, x3, [x4]") }
	a = newAsm()
	CompareSwapPair(a, true, false, false, 1, 2, 4)
	if !lsdpRejected(a) { return fail("an odd Rs") }
	a = newAsm()
	CompareSwapPair(a, false, false, false, 0, 3, 4)
	if !lsdpRejected(a) { return fail("an odd Rt") }
	a = newAsm()
	CompareSwap(a, -1, false, false, 0, 1, 2)
	if !lsdpRejected(a) { return fail("size -1") }
	a = newAsm()
	CompareSwap(a, 3, false, false, 0, 32, 2)
	if !lsdpRejected(a) { return fail("cas register 32") }
	a = newAsm()
	CompareSwapPair(a, true, false, false, 0, 2, 32)
	if !lsdpRejected(a) { return fail("casp base register 32") }
	return ""
}
