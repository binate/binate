package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact single-instruction encoders for branches, PC-relative addressing, exception
// generation, hints, barriers and system instructions — each emits exactly the one
// instruction asked for, or sets an assembler error when an operand has no encoding.
// A label operand carries an addend (label + addend is the target), recorded on the
// fixup so the in-object resolution and the object writers apply it.  An explicit
// numeric offset is encoded directly and must be in range and correctly aligned.

// checkPCRel reports whether a byte offset fits a signed field of `bits` bits scaled
// by `scale` (4 for instruction-word offsets, 1 for ADR, 4096 for ADRP pages).
func checkPCRel(offset int, bits int, scale int) bool {
	if offset % scale != 0 { return false }
	var units int = offset / scale
	var lim int = 1
	for i := 0; i < bits - 1; i++ { lim = lim * 2 }
	return units >= 0 - lim && units < lim
}

// BranchLabel emits B (link=false) or BL (link=true) to label + addend
// (±128MB, 4-byte aligned).
func BranchLabel(a @asm.Assembler, link bool, label *[]readonly char, addend int) {
	var inst uint32 = 0x14000000
	if link { inst = 0x94000000 }
	a.AddFixup(label, FIX_BRANCH26, addend, 4)
	emit32(a, inst)
}

// BranchOffset emits B / BL with an explicit PC-relative byte offset.
func BranchOffset(a @asm.Assembler, link bool, offset int) {
	if !checkPCRel(offset, 26, 4) {
		a.SetError("branch: offset must be a multiple of 4 within +/-128MB")
		return
	}
	var inst uint32 = 0x14000000
	if link { inst = 0x94000000 }
	emit32(a, inst | (cast(uint32, offset / 4) & 0x03FFFFFF))
}

// CondBranchLabel emits B.cond (cond 0-15) to label + addend (±1MB).
func CondBranchLabel(a @asm.Assembler, cond int, label *[]readonly char, addend int) {
	if cond < 0 || cond > 15 {
		a.SetError("b.cond: invalid condition")
		return
	}
	a.AddFixup(label, FIX_BRANCH19, addend, 4)
	emit32(a, 0x54000000 | cast(uint32, cond))
}

// CondBranchOffset emits B.cond with an explicit PC-relative byte offset.
func CondBranchOffset(a @asm.Assembler, cond int, offset int) {
	if cond < 0 || cond > 15 || !checkPCRel(offset, 19, 4) {
		a.SetError("b.cond: invalid condition, or offset not a multiple of 4 within +/-1MB")
		return
	}
	emit32(a, 0x54000000 | ((cast(uint32, offset / 4) & 0x7FFFF) << 5) | cast(uint32, cond))
}

// cmpBranchBase returns the CBZ / CBNZ word for sf and rt (imm19 zero).
func cmpBranchBase(nonzero bool, sf bool, rt int) uint32 {
	var inst uint32 = 0x34000000 | cast(uint32, rt)
	if nonzero { inst = inst | 0x01000000 }
	if sf { inst = inst | 0x80000000 }
	return inst
}

// CompareBranchLabel emits CBZ / CBNZ (nonzero) of zero-or-register Rt to label +
// addend (±1MB).
func CompareBranchLabel(a @asm.Assembler, nonzero bool, sf bool, rt int, label *[]readonly char,
		addend int) {
	if !regsOk(a, rt, 0, 0, 0) { return }
	a.AddFixup(label, FIX_BRANCH19, addend, 4)
	emit32(a, cmpBranchBase(nonzero, sf, rt))
}

// CompareBranchOffset emits CBZ / CBNZ with an explicit PC-relative byte offset.
func CompareBranchOffset(a @asm.Assembler, nonzero bool, sf bool, rt int, offset int) {
	if !regsOk(a, rt, 0, 0, 0) { return }
	if !checkPCRel(offset, 19, 4) {
		a.SetError("cbz/cbnz: offset must be a multiple of 4 within +/-1MB")
		return
	}
	emit32(a, cmpBranchBase(nonzero, sf, rt) | ((cast(uint32, offset / 4) & 0x7FFFF) << 5))
}

// testBranchBase returns the TBZ / TBNZ word for Rt and bit (0-63; bit 5 goes to b5,
// bit 31 of the instruction), or ok=false for an out-of-range bit.
func testBranchBase(nonzero bool, rt int, bit int) (uint32, bool) {
	if bit < 0 || bit > 63 { return 0, false }
	var inst uint32 = 0x36000000 | (cast(uint32, bit & 0x1f) << 19) | cast(uint32, rt)
	if nonzero { inst = inst | 0x01000000 }
	if bit >= 32 { inst = inst | 0x80000000 }
	return inst, true
}

// TestBranchLabel emits TBZ / TBNZ (nonzero) testing bit (0-63) of zero-or-register
// Rt, to label + addend (±32KB).  A bit of 32 or more needs an X register (the
// caller's check).
func TestBranchLabel(a @asm.Assembler, nonzero bool, rt int, bit int, label *[]readonly char,
		addend int) {
	if !regsOk(a, rt, 0, 0, 0) { return }
	inst, ok := testBranchBase(nonzero, rt, bit)
	if !ok {
		a.SetError("tbz/tbnz: bit number out of range [0, 63]")
		return
	}
	a.AddFixup(label, FIX_BRANCH14, addend, 4)
	emit32(a, inst)
}

// TestBranchOffset emits TBZ / TBNZ with an explicit PC-relative byte offset.
func TestBranchOffset(a @asm.Assembler, nonzero bool, rt int, bit int, offset int) {
	if !regsOk(a, rt, 0, 0, 0) { return }
	inst, ok := testBranchBase(nonzero, rt, bit)
	if !ok || !checkPCRel(offset, 14, 4) {
		a.SetError("tbz/tbnz: bit out of range [0, 63], or offset not a multiple of 4 within +/-32KB")
		return
	}
	emit32(a, inst | ((cast(uint32, offset / 4) & 0x3FFF) << 5))
}

// BranchReg emits BR / BLR / RET (op BR_BR, BR_BLR, BR_RET) of X register Rn.
func BranchReg(a @asm.Assembler, op int, rn int) {
	if !regsOk(a, rn, 0, 0, 0) { return }
	var inst uint32 = 0xD61F0000
	if op == BR_BLR {
		inst = 0xD63F0000
	} else if op == BR_RET {
		inst = 0xD65F0000
	} else if op != BR_BR {
		a.SetError("branch register: invalid operation")
		return
	}
	emit32(a, inst | (cast(uint32, rn) << 5))
}

// PCRelLabel emits ADR (page=false; label + addend within ±1MB) or ADRP (page=true;
// the 4KB page of label + addend, within ±4GB) into X register Rd.  got selects, for
// ADRP only, the page of label's GOT slot instead of label itself.
func PCRelLabel(a @asm.Assembler, page bool, got bool, rd int, label *[]readonly char, addend int) {
	if !regsOk(a, rd, 0, 0, 0) { return }
	var kind int = FIX_ADR_LO21
	var inst uint32 = 0x10000000
	if page {
		inst = 0x90000000
		kind = FIX_ADRP_HI21
		if got { kind = FIX_ADRP_GOT_HI21 }
	} else if got {
		a.SetError("adr: no GOT form (use adrp :got:)")
		return
	}
	if got && addend != 0 {
		a.SetError("adrp: a GOT-slot reference takes no addend")
		return
	}
	a.AddFixup(label, kind, addend, 4)
	emit32(a, inst | cast(uint32, rd))
}

// PCRelOffset emits ADR with an explicit byte offset (±1MB) or ADRP with an explicit
// page offset (a multiple of 4096 within ±4GB) into X register Rd.
func PCRelOffset(a @asm.Assembler, page bool, rd int, offset int) {
	if !regsOk(a, rd, 0, 0, 0) { return }
	var scale int = 1
	var inst uint32 = 0x10000000
	if page {
		scale = 4096
		inst = 0x90000000
	}
	if !checkPCRel(offset, 21, scale) {
		a.SetError("adr/adrp: offset out of range (adrp: a multiple of 4096 within +/-4GB)")
		return
	}
	var imm uint32 = cast(uint32, offset / scale) & 0x1FFFFF
	emit32(a, inst | ((imm & 3) << 29) | ((imm >> 2) << 5) | cast(uint32, rd))
}

// ExceptionGen emits an exception-generating instruction with a 16-bit immediate
// (0..65535): op is one of the EXC_* words (SVC, HVC, SMC, BRK, HLT, DCPS1-3) or
// EXC_UDF (the permanently undefined UDF, whose immediate sits in bits 15:0).
func ExceptionGen(a @asm.Assembler, op uint32, imm int) {
	if imm < 0 || imm > 0xFFFF {
		a.SetError("exception immediate out of range [0, 65535]")
		return
	}
	if op == EXC_UDF {
		emit32(a, cast(uint32, imm))
		return
	}
	if op != EXC_SVC && op != EXC_HVC && op != EXC_SMC && op != EXC_BRK && op != EXC_HLT &&
			op != EXC_DCPS1 && op != EXC_DCPS2 && op != EXC_DCPS3 {
		a.SetError("exception generation: invalid operation")
		return
	}
	emit32(a, op | (cast(uint32, imm) << 5))
}

// Hint emits HINT #imm (0..127): NOP is 0, and the named hints (YIELD, WFE, BTI, the
// pointer-authentication hints, …) are fixed immediates.
func Hint(a @asm.Assembler, imm int) {
	if imm < 0 || imm > 127 {
		a.SetError("hint immediate out of range [0, 127]")
		return
	}
	emit32(a, 0xD503201F | (cast(uint32, imm) << 5))
}

// Barrier emits CLREX / DSB / DMB / ISB / SB (op BAR_*) with the 4-bit CRm option
// (0..15; the named options such as SY=15, ISH=11 are fixed values; SB takes 0).
func Barrier(a @asm.Assembler, op uint32, crm int) {
	if op != BAR_CLREX && op != BAR_DSB && op != BAR_DMB && op != BAR_ISB && op != BAR_SB {
		a.SetError("barrier: invalid operation")
		return
	}
	if crm < 0 || crm > 15 || (op == BAR_SB && crm != 0) {
		a.SetError("barrier option out of range [0, 15]")
		return
	}
	emit32(a, op | (cast(uint32, crm) << 8))
}

// sysFieldsOk reports whether op0/op1/CRn/CRm/op2 fit their fields.
func sysFieldsOk(op1 int, crn int, crm int, op2 int) bool {
	return op1 >= 0 && op1 <= 7 && crn >= 0 && crn <= 15 && crm >= 0 && crm <= 15 && op2 >= 0 &&
			op2 <= 7
}

// SysRegMove emits MRS (read=true: Xt = sysreg) or MSR (register: sysreg = Xt) for
// the system register named by op0 (2 or 3; 1 is the SYS space, giving SYSL / SYS),
// op1, CRn, CRm, op2.  Rt is zero-or-register.
func SysRegMove(a @asm.Assembler, read bool, rt int, op0 int, op1 int, crn int, crm int, op2 int) {
	if !regsOk(a, rt, 0, 0, 0) { return }
	if op0 < 1 || op0 > 3 || !sysFieldsOk(op1, crn, crm, op2) {
		a.SetError("mrs/msr: system register encoding out of range")
		return
	}
	var inst uint32 = 0xD5000000 | (cast(uint32, op0) << 19) | (cast(uint32, op1) << 16) |
			(cast(uint32, crn) << 12) | (cast(uint32, crm) << 8) | (cast(uint32, op2) << 5) |
			cast(uint32, rt)
	if read { inst = inst | 0x00200000 }
	emit32(a, inst)
}

// msrImmMax returns the largest immediate MSR (immediate) takes for the PSTATE field
// op1:op2 — 15 for the DAIFSet / DAIFClr masks, 1 for the single-bit SPSel, UAO, PAN,
// DIT, SSBS and TCO — or -1 when op1:op2 names no supported field (the other
// encodings in that space are different instructions, e.g. op1:op2 0:0 is CFINV).
func msrImmMax(op1 int, op2 int) int {
	if op1 == 3 && (op2 == 6 || op2 == 7) { return 15 } // DAIFSet, DAIFClr
	if op1 == 0 && (op2 == 3 || op2 == 4 || op2 == 5) { return 1 } // UAO, PAN, SPSel
	if op1 == 3 && (op2 == 1 || op2 == 2 || op2 == 4) { return 1 } // SSBS, DIT, TCO
	return -1
}

// MsrImm emits MSR (immediate) to the PSTATE field named by op1 / op2 with the
// immediate imm (the CRm field): DAIFSet / DAIFClr take 0..15, the single-bit fields
// SPSel, UAO, PAN, DIT, SSBS and TCO take 0..1; any other op1:op2 is an error.
func MsrImm(a @asm.Assembler, op1 int, op2 int, imm int) {
	var max int = msrImmMax(op1, op2)
	if max < 0 {
		a.SetError("msr (immediate): not a PSTATE field")
		return
	}
	if imm < 0 || imm > max {
		a.SetError("msr (immediate): immediate out of range for this PSTATE field")
		return
	}
	emit32(a,
			0xD500401F | (cast(uint32, op1) << 16) | (cast(uint32, imm) << 8) | (cast(uint32, op2) << 5))
}

// Sys emits SYS (sysl=false) `#op1, Cn, Cm, #op2{, Xt}` or SYSL (sysl=true) `Xt, #op1,
// Cn, Cm, #op2`; the DC / IC / AT / TLBI operations are forms of SYS.  Rt is
// zero-or-register (31 when the operation takes no register).
func Sys(a @asm.Assembler, sysl bool, op1 int, crn int, crm int, op2 int, rt int) {
	if !regsOk(a, rt, 0, 0, 0) { return }
	if !sysFieldsOk(op1, crn, crm, op2) {
		a.SetError("sys: field out of range")
		return
	}
	var inst uint32 = 0xD5080000 | (cast(uint32, op1) << 16) | (cast(uint32, crn) << 12) |
			(cast(uint32, crm) << 8) | (cast(uint32, op2) << 5) | cast(uint32, rt)
	if sysl { inst = inst | 0x00200000 }
	emit32(a, inst)
}

// SysBranch emits the fixed-form branches and exception returns, op one of the SB_*
// words: ERET, DRPS, RETAA/RETAB, ERETAA/ERETAB (no operands); BRAAZ/BRABZ/BLRAAZ/
// BLRABZ (Rn, an X register); BRAA/BRAB/BLRAA/BLRAB (Rn and the modifier Rm, an X
// register or SP).  Operands a form does not take are ignored.
func SysBranch(a @asm.Assembler, op uint32, rn int, rm int) {
	if !regsOk(a, rn, rm, 0, 0) { return }
	var noRegs bool = op == SB_ERET || op == SB_DRPS || op == SB_RETAA || op == SB_RETAB ||
			op == SB_ERETAA || op == SB_ERETAB
	var rnOnly bool = op == SB_BRAAZ || op == SB_BRABZ || op == SB_BLRAAZ || op == SB_BLRABZ
	var rnRm bool = op == SB_BRAA || op == SB_BRAB || op == SB_BLRAA || op == SB_BLRAB
	if noRegs {
		emit32(a, op)
	} else if rnOnly {
		emit32(a, op | (cast(uint32, rn) << 5))
	} else if rnRm {
		emit32(a, op | (cast(uint32, rn) << 5) | cast(uint32, rm))
	} else {
		a.SetError("branch: invalid fixed-form branch operation")
	}
}
