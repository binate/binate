package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Exact-encoder tests for the exception, hint, barrier and system-instruction
// encoders of aarch64_ctrl_arch.bn.  Every expected word is what clang
// (arm64-apple-macos11, -march=armv8.5-a) emits for the instruction named beside it.
// (ctlWord / ctlClean / ctlRejected are in aarch64_ctrl_arch_test.bn.)

// ExceptionGen places imm16 in bits 20:5 of each EXC_* word, and UDF's imm16 in bits
// 15:0.
func TestExceptionGenWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ExceptionGen(a, EXC_SVC, 0x80) // svc #0x80
	ExceptionGen(a, EXC_HVC, 1) // hvc #1
	ExceptionGen(a, EXC_SMC, 2) // smc #2
	ExceptionGen(a, EXC_BRK, 0xF000) // brk #0xf000
	ExceptionGen(a, EXC_HLT, 0x3C) // hlt #0x3c
	ExceptionGen(a, EXC_DCPS1, 0) // dcps1
	ExceptionGen(a, EXC_DCPS2, 5) // dcps2 #5
	ExceptionGen(a, EXC_DCPS3, 0xFFFF) // dcps3 #0xffff
	ExceptionGen(a, EXC_UDF, 0x1234) // udf #0x1234
	ExceptionGen(a, EXC_UDF, 0xFFFF) // udf #0xffff
	if !ctlClean(a, 10) { return fail("ExceptionGen: expected 10 words, no error") }
	if ctlWord(a, 0) != 0xD4001001 { return fail("svc #0x80") }
	if ctlWord(a, 1) != 0xD4000022 { return fail("hvc #1") }
	if ctlWord(a, 2) != 0xD4000043 { return fail("smc #2") }
	if ctlWord(a, 3) != 0xD43E0000 { return fail("brk #0xf000") }
	if ctlWord(a, 4) != 0xD4400780 { return fail("hlt #0x3c") }
	if ctlWord(a, 5) != 0xD4A00001 { return fail("dcps1") }
	if ctlWord(a, 6) != 0xD4A000A2 { return fail("dcps2 #5") }
	if ctlWord(a, 7) != 0xD4BFFFE3 { return fail("dcps3 #0xffff") }
	if ctlWord(a, 8) != 0x00001234 { return fail("udf #0x1234") }
	if ctlWord(a, 9) != 0x0000FFFF { return fail("udf #0xffff") }
	return ""
}

// ExceptionGen rejects an immediate outside 0..65535 (UDF included) and a word that
// is not an EXC_* operation.
func TestExceptionGenRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ExceptionGen(a, EXC_SVC, 0x10000)
	if !ctlRejected(a) { return fail("svc #0x10000 must be rejected") }
	a = newAsm()
	ExceptionGen(a, EXC_UDF, -1)
	if !ctlRejected(a) { return fail("udf #-1 must be rejected") }
	a = newAsm()
	ExceptionGen(a, EXC_UDF, 0x10000)
	if !ctlRejected(a) { return fail("udf #0x10000 must be rejected") }
	a = newAsm()
	ExceptionGen(a, 0xD4000004, 0)
	if !ctlRejected(a) { return fail("a non-EXC_* op must be rejected") }
	return ""
}

// Hint places imm7 in bits 11:5 of HINT (NOP, YIELD, BTI c are fixed immediates).
func TestHintWordsAndRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Hint(a, 0) // nop
	Hint(a, 1) // yield
	Hint(a, 34) // bti c
	Hint(a, 127) // hint #127
	if !ctlClean(a, 4) { return fail("Hint: expected 4 words, no error") }
	if ctlWord(a, 0) != 0xD503201F { return fail("nop") }
	if ctlWord(a, 1) != 0xD503203F { return fail("yield") }
	if ctlWord(a, 2) != 0xD503245F { return fail("bti c") }
	if ctlWord(a, 3) != 0xD5032FFF { return fail("hint #127") }
	a = newAsm()
	Hint(a, 128)
	if !ctlRejected(a) { return fail("hint #128 must be rejected") }
	a = newAsm()
	Hint(a, -1)
	if !ctlRejected(a) { return fail("hint #-1 must be rejected") }
	return ""
}

// Barrier places the CRm option in bits 11:8 of each BAR_* word.
func TestBarrierWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Barrier(a, BAR_CLREX, 15) // clrex
	Barrier(a, BAR_DSB, 15) // dsb sy
	Barrier(a, BAR_DMB, 11) // dmb ish
	Barrier(a, BAR_ISB, 15) // isb
	Barrier(a, BAR_SB, 0) // sb
	Barrier(a, BAR_DMB, 0) // dmb #0
	Barrier(a, BAR_DSB, 1) // dsb oshld
	if !ctlClean(a, 7) { return fail("Barrier: expected 7 words, no error") }
	if ctlWord(a, 0) != 0xD5033F5F { return fail("clrex") }
	if ctlWord(a, 1) != 0xD5033F9F { return fail("dsb sy") }
	if ctlWord(a, 2) != 0xD5033BBF { return fail("dmb ish") }
	if ctlWord(a, 3) != 0xD5033FDF { return fail("isb") }
	if ctlWord(a, 4) != 0xD50330FF { return fail("sb") }
	if ctlWord(a, 5) != 0xD50330BF { return fail("dmb #0") }
	if ctlWord(a, 6) != 0xD503319F { return fail("dsb oshld") }
	return ""
}

// Barrier rejects an option outside 0..15, any option on SB (which has none), and a
// word that is not a BAR_* operation.
func TestBarrierRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Barrier(a, BAR_DSB, 16)
	if !ctlRejected(a) { return fail("dsb #16 must be rejected") }
	a = newAsm()
	Barrier(a, BAR_DMB, -1)
	if !ctlRejected(a) { return fail("dmb #-1 must be rejected") }
	a = newAsm()
	Barrier(a, BAR_SB, 1)
	if !ctlRejected(a) { return fail("sb with a non-zero option must be rejected") }
	a = newAsm()
	Barrier(a, 0xD503201F, 0)
	if !ctlRejected(a) { return fail("a non-BAR_* op must be rejected") }
	return ""
}

// SysRegMove encodes MRS / MSR (register) for op0 2 and 3, and for op0 1 (the SYS
// space) gives the SYSL / SYS words.
func TestSysRegMoveWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SysRegMove(a, true, 0, 3, 3, 13, 0, 2) // mrs x0, tpidr_el0
	SysRegMove(a, false, 1, 3, 3, 13, 0, 2) // msr tpidr_el0, x1
	SysRegMove(a, true, 2, 2, 0, 0, 2, 2) // mrs x2, mdscr_el1
	SysRegMove(a, false, 31, 2, 0, 0, 2, 2) // msr mdscr_el1, xzr
	SysRegMove(a, true, 9, 3, 7, 15, 15, 7) // mrs x9, s3_7_c15_c15_7
	SysRegMove(a, true, 3, 1, 0, 7, 5, 0) // sysl x3, #0, c7, c5, #0
	SysRegMove(a, false, 4, 1, 0, 7, 5, 0) // sys #0, c7, c5, #0, x4
	if !ctlClean(a, 7) { return fail("SysRegMove: expected 7 words, no error") }
	if ctlWord(a, 0) != 0xD53BD040 { return fail("mrs x0, tpidr_el0") }
	if ctlWord(a, 1) != 0xD51BD041 { return fail("msr tpidr_el0, x1") }
	if ctlWord(a, 2) != 0xD5300242 { return fail("mrs x2, mdscr_el1") }
	if ctlWord(a, 3) != 0xD510025F { return fail("msr mdscr_el1, xzr") }
	if ctlWord(a, 4) != 0xD53FFFE9 { return fail("mrs x9, s3_7_c15_c15_7") }
	if ctlWord(a, 5) != 0xD5287503 { return fail("op0=1 read: sysl x3, #0, c7, c5, #0") }
	if ctlWord(a, 6) != 0xD5087504 { return fail("op0=1 write: sys #0, c7, c5, #0, x4") }
	return ""
}

// SysRegMove rejects op0 outside 1..3 and each of op1 / CRn / CRm / op2 past its
// field.
func TestSysRegMoveRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SysRegMove(a, true, 0, 0, 0, 4, 0, 0)
	if !ctlRejected(a) { return fail("op0 0 must be rejected") }
	a = newAsm()
	SysRegMove(a, true, 0, 4, 0, 0, 0, 0)
	if !ctlRejected(a) { return fail("op0 4 must be rejected") }
	a = newAsm()
	SysRegMove(a, false, 0, 3, 8, 0, 0, 0)
	if !ctlRejected(a) { return fail("op1 8 must be rejected") }
	a = newAsm()
	SysRegMove(a, false, 0, 3, -1, 0, 0, 0)
	if !ctlRejected(a) { return fail("op1 -1 must be rejected") }
	a = newAsm()
	SysRegMove(a, true, 0, 3, 0, 16, 0, 0)
	if !ctlRejected(a) { return fail("CRn 16 must be rejected") }
	a = newAsm()
	SysRegMove(a, true, 0, 3, 0, 0, 16, 0)
	if !ctlRejected(a) { return fail("CRm 16 must be rejected") }
	a = newAsm()
	SysRegMove(a, true, 0, 3, 0, 0, 0, 8)
	if !ctlRejected(a) { return fail("op2 8 must be rejected") }
	return ""
}

// MsrImm places the PSTATE-field op1 / op2 in bits 18:16 / 7:5 and imm4 in CRm.
func TestMsrImmWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MsrImm(a, 0, 5, 1) // msr spsel, #1
	MsrImm(a, 3, 6, 2) // msr daifset, #2
	MsrImm(a, 3, 7, 15) // msr daifclr, #15
	MsrImm(a, 0, 4, 1) // msr pan, #1
	MsrImm(a, 0, 3, 0) // msr uao, #0
	if !ctlClean(a, 5) { return fail("MsrImm: expected 5 words, no error") }
	if ctlWord(a, 0) != 0xD50041BF { return fail("msr spsel, #1") }
	if ctlWord(a, 1) != 0xD50342DF { return fail("msr daifset, #2") }
	if ctlWord(a, 2) != 0xD5034FFF { return fail("msr daifclr, #15") }
	if ctlWord(a, 3) != 0xD500419F { return fail("msr pan, #1") }
	if ctlWord(a, 4) != 0xD500407F { return fail("msr uao, #0") }
	return ""
}

// MsrImm rejects an op1:op2 that names no PSTATE field — including the CFINV /
// XAFLAG / AXFLAG words that share the encoding space (op1 0, op2 0/1/2) — and an
// immediate past the field's range (0..15 for DAIFSet / DAIFClr, 0..1 otherwise).
func TestMsrImmRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MsrImm(a, 8, 5, 0)
	if !ctlRejected(a) { return fail("op1 8 must be rejected") }
	a = newAsm()
	MsrImm(a, 0, 8, 0)
	if !ctlRejected(a) { return fail("op2 8 must be rejected") }
	a = newAsm()
	MsrImm(a, 0, 0, 0)
	if !ctlRejected(a) { return fail("op1:op2 0:0 is CFINV, not an MSR") }
	a = newAsm()
	MsrImm(a, 0, 1, 0)
	if !ctlRejected(a) { return fail("op1:op2 0:1 is XAFLAG, not an MSR") }
	a = newAsm()
	MsrImm(a, 0, 2, 0)
	if !ctlRejected(a) { return fail("op1:op2 0:2 is AXFLAG, not an MSR") }
	a = newAsm()
	MsrImm(a, 3, 6, 16)
	if !ctlRejected(a) { return fail("daifset #16 must be rejected") }
	a = newAsm()
	MsrImm(a, 0, 5, 2)
	if !ctlRejected(a) { return fail("spsel #2 must be rejected (single-bit field)") }
	a = newAsm()
	MsrImm(a, 3, 4, 2)
	if !ctlRejected(a) { return fail("tco #2 must be rejected (single-bit field)") }
	a = newAsm()
	MsrImm(a, 0, 5, -1)
	if !ctlRejected(a) { return fail("imm -1 must be rejected") }
	return ""
}

// Sys encodes SYS / SYSL (DC ZVA and IC IALLU are SYS forms; Rt 31 is "no register").
func TestSysWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Sys(a, false, 3, 7, 4, 1, 0) // dc zva, x0
	Sys(a, false, 0, 7, 5, 0, 31) // ic iallu
	Sys(a, true, 1, 2, 3, 4, 5) // sysl x5, #1, c2, c3, #4
	Sys(a, false, 7, 15, 15, 7, 30) // sys #7, c15, c15, #7, x30
	Sys(a, false, 3, 7, 4, 1, 31) // sys #3, c7, c4, #1
	if !ctlClean(a, 5) { return fail("Sys: expected 5 words, no error") }
	if ctlWord(a, 0) != 0xD50B7420 { return fail("dc zva, x0") }
	if ctlWord(a, 1) != 0xD508751F { return fail("ic iallu") }
	if ctlWord(a, 2) != 0xD5292385 { return fail("sysl x5, #1, c2, c3, #4") }
	if ctlWord(a, 3) != 0xD50FFFFE { return fail("sys #7, c15, c15, #7, x30") }
	if ctlWord(a, 4) != 0xD50B743F { return fail("sys #3, c7, c4, #1") }
	return ""
}

// Sys rejects each of op1 / CRn / CRm / op2 past its field.
func TestSysRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Sys(a, false, 8, 7, 5, 0, 31)
	if !ctlRejected(a) { return fail("op1 8 must be rejected") }
	a = newAsm()
	Sys(a, false, 0, 16, 5, 0, 31)
	if !ctlRejected(a) { return fail("CRn 16 must be rejected") }
	a = newAsm()
	Sys(a, true, 0, 7, 16, 0, 0)
	if !ctlRejected(a) { return fail("CRm 16 must be rejected") }
	a = newAsm()
	Sys(a, false, 0, 7, 5, 8, 31)
	if !ctlRejected(a) { return fail("op2 8 must be rejected") }
	a = newAsm()
	Sys(a, false, 0, 7, -1, 0, 31)
	if !ctlRejected(a) { return fail("CRm -1 must be rejected") }
	return ""
}
