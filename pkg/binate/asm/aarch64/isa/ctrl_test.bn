package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Exact-encoder tests for the branch and PC-relative-address encoders of
// aarch64_ctrl_arch.bn.  Every expected word is what clang (arm64-apple-macos11)
// emits for the instruction named beside it.  (newAsm() / readInst() / fail() are
// defined in aarch64_test.bn, same package.)

// ctlWord returns the i-th instruction word of a's text section.
func ctlWord(a @asm.Assembler, i int) uint32 { return readInst(a.Sections[0], i * 4) }

// ctlClean reports whether a has no error and its text section holds exactly n words.
func ctlClean(a @asm.Assembler, n int) bool {
	return !a.HasError && a.Sections[0].Len == n * 4
}

// ctlRejected reports whether a has an error and nothing was emitted or recorded.
func ctlRejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0 && a.Sections[0].NumFixups == 0
}

// ctlStrEq reports whether x and y hold the same chars.
func ctlStrEq(x *[]readonly char, y *[]readonly char) bool {
	if len(x) != len(y) { return false }
	for i := 0; i < len(x); i++ {
		if x[i] != y[i] { return false }
	}
	return true
}

// ctlFixupIs reports whether fixup fi of a's text section is `kind` against label +
// addend, recorded at byte offset off.
func ctlFixupIs(a @asm.Assembler, fi int, off int, kind int, label *[]readonly char,
		addend int) bool {
	var s @asm.Section = a.Sections[0]
	if fi >= s.NumFixups { return false }
	var f asm.Fixup = s.Fixups[fi]
	return cast(int, f.Offset) == off && f.Kind == kind && f.Addend == addend &&
			ctlStrEq(f.Label, label)
}

// BranchLabel emits B / BL with a zero imm26 and a FIX_BRANCH26 fixup carrying the
// label and addend (`b .` = 0x14000000, `bl .` = 0x94000000).
func TestBranchLabelWordsAndFixups() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BranchLabel(a, false, "Lx", 0)
	BranchLabel(a, true, "_f", -8)
	if !ctlClean(a, 2) { return fail("BranchLabel: expected 2 words, no error") }
	if ctlWord(a, 0) != 0x14000000 { return fail("b label") }
	if ctlWord(a, 1) != 0x94000000 { return fail("bl label") }
	if !ctlFixupIs(a, 0, 0, FIX_BRANCH26, "Lx", 0) { return fail("b fixup") }
	if !ctlFixupIs(a, 1, 4, FIX_BRANCH26, "_f", -8) { return fail("bl fixup keeps addend -8") }
	return ""
}

// BranchOffset encodes imm26 = offset/4, including both ends of the ±128MB range.
func TestBranchOffsetWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BranchOffset(a, false, 8) // b .+8
	BranchOffset(a, true, -4) // bl .-4
	BranchOffset(a, false, 0x7FFFFFC) // b .+0x7fffffc
	BranchOffset(a, true, -0x8000000) // bl .-0x8000000
	if !ctlClean(a, 4) { return fail("BranchOffset: expected 4 words, no error") }
	if ctlWord(a, 0) != 0x14000002 { return fail("b .+8") }
	if ctlWord(a, 1) != 0x97FFFFFF { return fail("bl .-4") }
	if ctlWord(a, 2) != 0x15FFFFFF { return fail("b .+0x7fffffc") }
	if ctlWord(a, 3) != 0x96000000 { return fail("bl .-0x8000000") }
	return ""
}

// BranchOffset rejects a misaligned or out-of-range offset and emits nothing.
func TestBranchOffsetRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BranchOffset(a, false, 2)
	if !ctlRejected(a) { return fail("b .+2 (misaligned) must be rejected") }
	a = newAsm()
	BranchOffset(a, true, 0x8000000)
	if !ctlRejected(a) { return fail("bl .+128MB must be rejected") }
	a = newAsm()
	BranchOffset(a, false, -0x8000004)
	if !ctlRejected(a) { return fail("b .-(128MB+4) must be rejected") }
	return ""
}

// CondBranchLabel emits B.cond with a zero imm19 and a FIX_BRANCH19 fixup; cond 15
// (NV) is accepted.
func TestCondBranchLabelWordsAndFixups() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondBranchLabel(a, COND_NE, "Lx", 4)
	CondBranchLabel(a, COND_NV, "Ly", 0)
	if !ctlClean(a, 2) { return fail("CondBranchLabel: expected 2 words, no error") }
	if ctlWord(a, 0) != 0x54000001 { return fail("b.ne label") }
	if ctlWord(a, 1) != 0x5400000F { return fail("b.nv label") }
	if !ctlFixupIs(a, 0, 0, FIX_BRANCH19, "Lx", 4) { return fail("b.ne fixup keeps addend 4") }
	if !ctlFixupIs(a, 1, 4, FIX_BRANCH19, "Ly", 0) { return fail("b.nv fixup") }
	return ""
}

// CondBranchLabel rejects a condition outside 0..15 without recording a fixup.
func TestCondBranchLabelRejectsCond() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondBranchLabel(a, 16, "Lx", 0)
	if !ctlRejected(a) { return fail("cond 16 must be rejected") }
	a = newAsm()
	CondBranchLabel(a, -1, "Lx", 0)
	if !ctlRejected(a) { return fail("cond -1 must be rejected") }
	return ""
}

// CondBranchOffset encodes imm19 = offset/4 in bits 23:5, including the ±1MB ends.
func TestCondBranchOffsetWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondBranchOffset(a, COND_EQ, 8) // b.eq .+8
	CondBranchOffset(a, COND_LT, -4) // b.lt .-4
	CondBranchOffset(a, COND_NV, 0xFFFFC) // b.nv .+0xffffc
	CondBranchOffset(a, COND_NE, -0x100000) // b.ne .-0x100000
	if !ctlClean(a, 4) { return fail("CondBranchOffset: expected 4 words, no error") }
	if ctlWord(a, 0) != 0x54000040 { return fail("b.eq .+8") }
	if ctlWord(a, 1) != 0x54FFFFEB { return fail("b.lt .-4") }
	if ctlWord(a, 2) != 0x547FFFEF { return fail("b.nv .+0xffffc") }
	if ctlWord(a, 3) != 0x54800001 { return fail("b.ne .-0x100000") }
	return ""
}

// CondBranchOffset rejects a bad condition, a misaligned offset and either end past
// ±1MB.
func TestCondBranchOffsetRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondBranchOffset(a, 16, 0)
	if !ctlRejected(a) { return fail("cond 16 must be rejected") }
	a = newAsm()
	CondBranchOffset(a, COND_EQ, 6)
	if !ctlRejected(a) { return fail("b.eq .+6 (misaligned) must be rejected") }
	a = newAsm()
	CondBranchOffset(a, COND_EQ, 0x100000)
	if !ctlRejected(a) { return fail("b.eq .+1MB must be rejected") }
	a = newAsm()
	CondBranchOffset(a, COND_EQ, -0x100004)
	if !ctlRejected(a) { return fail("b.eq .-(1MB+4) must be rejected") }
	return ""
}

// CompareBranchLabel emits CBZ / CBNZ (W or X, Rt may be ZR) with a FIX_BRANCH19 fixup.
func TestCompareBranchLabelWordsAndFixups() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CompareBranchLabel(a, false, false, 3, "La", 0) // cbz w3
	CompareBranchLabel(a, true, true, 5, "Lb", -12) // cbnz x5
	CompareBranchLabel(a, false, true, 31, "Lc", 0) // cbz xzr
	if !ctlClean(a, 3) { return fail("CompareBranchLabel: expected 3 words, no error") }
	if ctlWord(a, 0) != 0x34000003 { return fail("cbz w3, label") }
	if ctlWord(a, 1) != 0xB5000005 { return fail("cbnz x5, label") }
	if ctlWord(a, 2) != 0xB400001F { return fail("cbz xzr, label") }
	if !ctlFixupIs(a, 1, 4, FIX_BRANCH19, "Lb", -12) { return fail("cbnz fixup keeps addend") }
	if !ctlFixupIs(a, 2, 8, FIX_BRANCH19, "Lc", 0) { return fail("cbz xzr fixup") }
	return ""
}

// CompareBranchOffset encodes imm19, including both ends of ±1MB, and rejects a
// misaligned or out-of-range offset.
func TestCompareBranchOffsetWordsAndRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CompareBranchOffset(a, false, true, 0, 8) // cbz x0, .+8
	CompareBranchOffset(a, true, false, 1, -8) // cbnz w1, .-8
	CompareBranchOffset(a, false, false, 3, 0xFFFFC) // cbz w3, .+0xffffc
	CompareBranchOffset(a, true, true, 5, -0x100000) // cbnz x5, .-0x100000
	if !ctlClean(a, 4) { return fail("CompareBranchOffset: expected 4 words, no error") }
	if ctlWord(a, 0) != 0xB4000040 { return fail("cbz x0, .+8") }
	if ctlWord(a, 1) != 0x35FFFFC1 { return fail("cbnz w1, .-8") }
	if ctlWord(a, 2) != 0x347FFFE3 { return fail("cbz w3, .+0xffffc") }
	if ctlWord(a, 3) != 0xB5800005 { return fail("cbnz x5, .-0x100000") }
	a = newAsm()
	CompareBranchOffset(a, false, true, 0, 2)
	if !ctlRejected(a) { return fail("cbz .+2 (misaligned) must be rejected") }
	a = newAsm()
	CompareBranchOffset(a, false, true, 0, 0x100000)
	if !ctlRejected(a) { return fail("cbz .+1MB must be rejected") }
	return ""
}

// TestBranchLabel puts bit[4:0] in b40 (bits 23:19) and bit[5] in b5 (bit 31), so a
// bit of 32 or more sets bit 31; each records a FIX_BRANCH14 fixup.
func TestTestBranchLabelWordsAndFixups() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TestBranchLabel(a, false, 0, 3, "La", 0) // tbz w0, #3
	TestBranchLabel(a, true, 1, 33, "Lb", 8) // tbnz x1, #33
	TestBranchLabel(a, false, 2, 63, "Lc", 0) // tbz x2, #63
	TestBranchLabel(a, false, 4, 32, "Ld", 0) // tbz x4, #32
	TestBranchLabel(a, true, 31, 5, "Le", 0) // tbnz wzr, #5
	if !ctlClean(a, 5) { return fail("TestBranchLabel: expected 5 words, no error") }
	if ctlWord(a, 0) != 0x36180000 { return fail("tbz w0, #3") }
	if ctlWord(a, 1) != 0xB7080001 { return fail("tbnz x1, #33 (b5 set)") }
	if ctlWord(a, 2) != 0xB6F80002 { return fail("tbz x2, #63") }
	if ctlWord(a, 3) != 0xB6000004 { return fail("tbz x4, #32 (b5 set, b40 zero)") }
	if ctlWord(a, 4) != 0x3728001F { return fail("tbnz wzr, #5") }
	if !ctlFixupIs(a, 1, 4, FIX_BRANCH14, "Lb", 8) { return fail("tbnz fixup keeps addend") }
	return ""
}

// TestBranchLabel rejects a bit number outside 0..63 without recording a fixup.
func TestTestBranchLabelRejectsBit() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TestBranchLabel(a, false, 0, 64, "Lx", 0)
	if !ctlRejected(a) { return fail("bit 64 must be rejected") }
	a = newAsm()
	TestBranchLabel(a, true, 0, -1, "Lx", 0)
	if !ctlRejected(a) { return fail("bit -1 must be rejected") }
	return ""
}

// TestBranchOffset encodes imm14 (bits 18:5), including both ends of ±32KB.
func TestTestBranchOffsetWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TestBranchOffset(a, false, 0, 0, 8) // tbz w0, #0, .+8
	TestBranchOffset(a, true, 3, 40, -4) // tbnz x3, #40, .-4
	TestBranchOffset(a, false, 2, 63, 0x7FFC) // tbz x2, #63, .+0x7ffc
	TestBranchOffset(a, true, 7, 31, -0x8000) // tbnz w7, #31, .-0x8000
	if !ctlClean(a, 4) { return fail("TestBranchOffset: expected 4 words, no error") }
	if ctlWord(a, 0) != 0x36000040 { return fail("tbz w0, #0, .+8") }
	if ctlWord(a, 1) != 0xB747FFE3 { return fail("tbnz x3, #40, .-4") }
	if ctlWord(a, 2) != 0xB6FBFFE2 { return fail("tbz x2, #63, .+0x7ffc") }
	if ctlWord(a, 3) != 0x37FC0007 { return fail("tbnz w7, #31, .-0x8000") }
	return ""
}

// TestBranchOffset rejects a bad bit, a misaligned offset and either end past ±32KB.
func TestTestBranchOffsetRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TestBranchOffset(a, false, 0, 64, 0)
	if !ctlRejected(a) { return fail("bit 64 must be rejected") }
	a = newAsm()
	TestBranchOffset(a, false, 0, 0, 2)
	if !ctlRejected(a) { return fail("tbz .+2 (misaligned) must be rejected") }
	a = newAsm()
	TestBranchOffset(a, false, 0, 0, 0x8000)
	if !ctlRejected(a) { return fail("tbz .+32KB must be rejected") }
	a = newAsm()
	TestBranchOffset(a, true, 0, 0, -0x8004)
	if !ctlRejected(a) { return fail("tbnz .-(32KB+4) must be rejected") }
	return ""
}

// BranchReg emits BR / BLR / RET of Rn (RET's default X30 is the caller's choice) and
// rejects an unknown operation.
func TestBranchRegWordsAndRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BranchReg(a, BR_BR, 16) // br x16
	BranchReg(a, BR_BLR, 8) // blr x8
	BranchReg(a, BR_RET, 30) // ret
	BranchReg(a, BR_RET, 5) // ret x5
	BranchReg(a, BR_BR, 31) // br xzr
	if !ctlClean(a, 5) { return fail("BranchReg: expected 5 words, no error") }
	if ctlWord(a, 0) != 0xD61F0200 { return fail("br x16") }
	if ctlWord(a, 1) != 0xD63F0100 { return fail("blr x8") }
	if ctlWord(a, 2) != 0xD65F03C0 { return fail("ret") }
	if ctlWord(a, 3) != 0xD65F00A0 { return fail("ret x5") }
	if ctlWord(a, 4) != 0xD61F03E0 { return fail("br xzr") }
	a = newAsm()
	BranchReg(a, 3, 0)
	if !ctlRejected(a) { return fail("branch-register op 3 must be rejected") }
	a = newAsm()
	BranchReg(a, -1, 0)
	if !ctlRejected(a) { return fail("branch-register op -1 must be rejected") }
	return ""
}

// SysBranch emits every fixed-form branch / exception return: the no-operand forms
// ignore Rn / Rm, the Rn-only forms ignore Rm, and BRAA-style forms take both (Rm 31
// is SP).
func TestSysBranchWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SysBranch(a, SB_ERET, 5, 6) // eret (operands ignored)
	SysBranch(a, SB_DRPS, 0, 0) // drps
	SysBranch(a, SB_RETAA, 0, 0) // retaa
	SysBranch(a, SB_RETAB, 0, 0) // retab
	SysBranch(a, SB_ERETAA, 0, 0) // eretaa
	SysBranch(a, SB_ERETAB, 0, 0) // eretab
	SysBranch(a, SB_BRAAZ, 1, 9) // braaz x1 (Rm ignored)
	SysBranch(a, SB_BRABZ, 2, 0) // brabz x2
	SysBranch(a, SB_BLRAAZ, 3, 0) // blraaz x3
	SysBranch(a, SB_BLRABZ, 4, 0) // blrabz x4
	SysBranch(a, SB_BRAA, 1, 2) // braa x1, x2
	SysBranch(a, SB_BRAB, 3, 31) // brab x3, sp
	SysBranch(a, SB_BLRAA, 5, 6) // blraa x5, x6
	SysBranch(a, SB_BLRAB, 7, 8) // blrab x7, x8
	if !ctlClean(a, 14) { return fail("SysBranch: expected 14 words, no error") }
	if ctlWord(a, 0) != 0xD69F03E0 { return fail("eret") }
	if ctlWord(a, 1) != 0xD6BF03E0 { return fail("drps") }
	if ctlWord(a, 2) != 0xD65F0BFF { return fail("retaa") }
	if ctlWord(a, 3) != 0xD65F0FFF { return fail("retab") }
	if ctlWord(a, 4) != 0xD69F0BFF { return fail("eretaa") }
	if ctlWord(a, 5) != 0xD69F0FFF { return fail("eretab") }
	if ctlWord(a, 6) != 0xD61F083F { return fail("braaz x1") }
	if ctlWord(a, 7) != 0xD61F0C5F { return fail("brabz x2") }
	if ctlWord(a, 8) != 0xD63F087F { return fail("blraaz x3") }
	if ctlWord(a, 9) != 0xD63F0C9F { return fail("blrabz x4") }
	if ctlWord(a, 10) != 0xD71F0822 { return fail("braa x1, x2") }
	if ctlWord(a, 11) != 0xD71F0C7F { return fail("brab x3, sp") }
	if ctlWord(a, 12) != 0xD73F08A6 { return fail("blraa x5, x6") }
	if ctlWord(a, 13) != 0xD73F0CE8 { return fail("blrab x7, x8") }
	return ""
}

// SysBranch rejects a word that is not one of the SB_* operations.
func TestSysBranchRejectsUnknownOp() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SysBranch(a, 0xD503201F, 0, 0) // NOP's word
	if !ctlRejected(a) { return fail("a non-SB_* op must be rejected") }
	a = newAsm()
	SysBranch(a, 0, 0, 0)
	if !ctlRejected(a) { return fail("op 0 must be rejected") }
	return ""
}

// PCRelLabel emits ADR (FIX_ADR_LO21), ADRP (FIX_ADRP_HI21) and ADRP :got:
// (FIX_ADRP_GOT_HI21) with a zero immediate, the fixup carrying label and addend.
func TestPCRelLabelWordsAndFixups() testing.TestResult {
	var a @asm.Assembler = newAsm()
	PCRelLabel(a, false, false, 0, "La", 3) // adr x0, La+3
	PCRelLabel(a, true, false, 1, "_ext", -16) // adrp x1, _ext-16@PAGE
	PCRelLabel(a, true, true, 2, "_ext", 0) // adrp x2, _ext@GOTPAGE
	if !ctlClean(a, 3) { return fail("PCRelLabel: expected 3 words, no error") }
	if ctlWord(a, 0) != 0x10000000 { return fail("adr x0, label") }
	if ctlWord(a, 1) != 0x90000001 { return fail("adrp x1, label") }
	if ctlWord(a, 2) != 0x90000002 { return fail("adrp x2, :got:label") }
	if !ctlFixupIs(a, 0, 0, FIX_ADR_LO21, "La", 3) { return fail("adr fixup") }
	if !ctlFixupIs(a, 1, 4, FIX_ADRP_HI21, "_ext", -16) { return fail("adrp fixup") }
	if !ctlFixupIs(a, 2, 8, FIX_ADRP_GOT_HI21, "_ext", 0) { return fail("adrp got fixup") }
	return ""
}

// AdrpLabelNc emits ADRP with a FIX_ADRP_HI21_NC fixup carrying label and addend.
func TestAdrpLabelNc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AdrpLabelNc(a, 3, "sym", 8) // adrp x3, :pg_hi21_nc:sym+8
	if !ctlClean(a, 1) || ctlWord(a, 0) != 0x90000003 { return fail("adrp x3, :pg_hi21_nc:sym") }
	if !ctlFixupIs(a, 0, 0, FIX_ADRP_HI21_NC, "sym", 8) { return fail("adrp :pg_hi21_nc: fixup") }
	return ""
}

// PCRelLabel rejects a GOT-slot ADRP with an addend, and ADR with got set (ADR has no
// GOT form); neither records a fixup.
func TestPCRelLabelRejectsGotForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	PCRelLabel(a, true, true, 0, "_ext", 8)
	if !ctlRejected(a) { return fail("adrp :got: with an addend must be rejected") }
	a = newAsm()
	PCRelLabel(a, false, true, 0, "_ext", 0)
	if !ctlRejected(a) { return fail("adr with got must be rejected") }
	return ""
}

// PCRelOffset splits the ADR byte offset / ADRP page offset into immlo (30:29) and
// immhi (23:5), including both ends of ±1MB (ADR) and ±4GB (ADRP).
func TestPCRelOffsetWords() testing.TestResult {
	var a @asm.Assembler = newAsm()
	PCRelOffset(a, false, 0, 1) // adr x0, .+1
	PCRelOffset(a, false, 2, -1) // adr x2, .-1
	PCRelOffset(a, false, 3, 0xFFFFF) // adr x3, .+0xfffff
	PCRelOffset(a, false, 4, -0x100000) // adr x4, .-0x100000
	PCRelOffset(a, true, 5, 4096) // adrp x5, #4096
	PCRelOffset(a, true, 6, -4096) // adrp x6, #-4096
	PCRelOffset(a, true, 7, 0xFFFFF000) // adrp x7, #0xfffff000
	PCRelOffset(a, true, 8, -0x100000000) // adrp x8, #-0x100000000
	if !ctlClean(a, 8) { return fail("PCRelOffset: expected 8 words, no error") }
	if ctlWord(a, 0) != 0x30000000 { return fail("adr x0, .+1") }
	if ctlWord(a, 1) != 0x70FFFFE2 { return fail("adr x2, .-1") }
	if ctlWord(a, 2) != 0x707FFFE3 { return fail("adr x3, .+0xfffff") }
	if ctlWord(a, 3) != 0x10800004 { return fail("adr x4, .-0x100000") }
	if ctlWord(a, 4) != 0xB0000005 { return fail("adrp x5, #4096") }
	if ctlWord(a, 5) != 0xF0FFFFE6 { return fail("adrp x6, #-4096") }
	if ctlWord(a, 6) != 0xF07FFFE7 { return fail("adrp x7, #0xfffff000") }
	if ctlWord(a, 7) != 0x90800008 { return fail("adrp x8, #-0x100000000") }
	return ""
}

// PCRelOffset rejects an ADR offset past ±1MB, and an ADRP offset that is not a
// whole number of 4KB pages or lies past ±4GB.
func TestPCRelOffsetRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	PCRelOffset(a, false, 0, 0x100000)
	if !ctlRejected(a) { return fail("adr .+1MB must be rejected") }
	a = newAsm()
	PCRelOffset(a, false, 0, -0x100001)
	if !ctlRejected(a) { return fail("adr .-(1MB+1) must be rejected") }
	a = newAsm()
	PCRelOffset(a, true, 0, 2048)
	if !ctlRejected(a) { return fail("adrp of a non-page offset must be rejected") }
	a = newAsm()
	PCRelOffset(a, true, 0, 0x100000000)
	if !ctlRejected(a) { return fail("adrp .+4GB must be rejected") }
	a = newAsm()
	PCRelOffset(a, true, 0, -0x100001000)
	if !ctlRejected(a) { return fail("adrp .-(4GB+4KB) must be rejected") }
	return ""
}
