package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact single-instruction data-processing encoders — each emits exactly the one
// architectural instruction asked for, or sets an assembler error when an operand
// has no encoding (an out-of-range immediate or shift, an unencodable bitmask, an
// invalid option).  Nothing is split into several instructions or masked into range,
// so these back the text assembler, where a written instruction must assemble to
// precisely itself or be rejected.
//
// Registers are encoding numbers 0-31.  Register 31 is SP or the zero register
// depending on the operand position, as each encoder documents; choosing the class
// (and rejecting the wrong one) is the caller's job.  sf selects the 64-bit form.

// dpWidth returns the register width in bits for sf.
func dpWidth(sf bool) int {
	if sf { return 64 }
	return 32
}

// dpRegs ORs sf (bit 31), Rn (bits 9:5) and Rd (bits 4:0) into inst.
func dpRegs(inst uint32, sf bool, rn int, rd int) uint32 {
	var w uint32 = inst | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if sf { w = w | 0x80000000 }
	return w
}

// dpOpsValid reports whether op is one of the OPS_* op/S selections.
func dpOpsValid(op uint32) bool {
	return op == OPS_ADD || op == OPS_ADDS || op == OPS_SUB || op == OPS_SUBS
}

// AddSubImm emits ADD/ADDS/SUB/SUBS (immediate): `op Rd, Rn, #imm{, lsl #12}`.  imm
// is 0..4095; shift12 applies `lsl #12`.  Rn is SP-or-register; Rd is SP-or-register
// for ADD/SUB and zero-or-register for ADDS/SUBS (register 31 = SP / XZR resp.).
func AddSubImm(a @asm.Assembler, op uint32, sf bool, rd int, rn int, imm int, shift12 bool) {
	if !RegsOk(a, rd, rn, 0, 0) { return }
	if !dpOpsValid(op) {
		a.SetError("add/sub: invalid operation")
		return
	}
	if imm < 0 || imm > 4095 {
		a.SetError("add/sub: immediate out of range [0, 4095] (optionally lsl #12)")
		return
	}
	var inst uint32 = 0x11000000 | op | (cast(uint32, imm) << 10)
	if shift12 { inst = inst | 0x00400000 }
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// AddSubLo12 emits `add Rd, Rn, #:lo12:label+addend` — ADD (immediate) with a zero
// imm12 and a fixup that fills in the target's low 12 bits (the page-offset half of an
// ADRP + ADD address materialization).  Rd and Rn are SP-or-register.  With shift12 the
// imm12 is shifted left by 12 (`lsl #12`, as clang takes it).
func AddSubLo12(a @asm.Assembler, sf bool, rd int, rn int, label *[]readonly char, addend int,
		shift12 bool) {
	if !RegsOk(a, rd, rn, 0, 0) { return }
	var base uint32 = 0x11000000
	if shift12 { base = 0x11400000 }
	a.AddFixup(label, FIX_ADD_LO12, addend, 4)
	Emit32(a, dpRegs(base, sf, rn, rd))
}

// AddSubShifted emits ADD/ADDS/SUB/SUBS (shifted register): `op Rd, Rn, Rm{, shift
// #amount}`, shift LSL / LSR / ASR, amount below the register width.  Every register
// operand is zero-or-register (31 = XZR / WZR).
func AddSubShifted(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, shift int,
		amount int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if !dpOpsValid(op) {
		a.SetError("add/sub: invalid operation")
		return
	}
	if shift != LSL && shift != LSR && shift != ASR {
		a.SetError("add/sub: shift must be lsl, lsr or asr")
		return
	}
	if amount < 0 || amount >= dpWidth(sf) {
		a.SetError("add/sub: shift amount out of range")
		return
	}
	var inst uint32 = 0x0B000000 | op | (cast(uint32, shift) << 22) | (cast(uint32, rm) << 16) |
			(cast(uint32, amount) << 10)
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// AddSubExtended emits ADD/ADDS/SUB/SUBS (extended register): `op Rd, Rn, Rm,
// <extend> {#amount}` — Rm zero- or sign-extended by ext (an XT_* option) then
// shifted left by amount 0..4.  Rn is SP-or-register; Rd is SP-or-register for
// ADD/SUB and zero-or-register for ADDS/SUBS; Rm is zero-or-register (a W register
// for the byte/halfword/word extends, an X register for UXTX/SXTX).
func AddSubExtended(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, ext int,
		amount int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if !dpOpsValid(op) {
		a.SetError("add/sub: invalid operation")
		return
	}
	if ext < XT_UXTB || ext > XT_SXTX {
		a.SetError("add/sub: invalid extend option")
		return
	}
	if amount < 0 || amount > 4 {
		a.SetError("add/sub: extend shift amount out of range [0, 4]")
		return
	}
	var inst uint32 = 0x0B200000 | op | (cast(uint32, rm) << 16) | (cast(uint32, ext) << 13) |
			(cast(uint32, amount) << 10)
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// AddSubCarry emits ADC/ADCS/SBC/SBCS: `op Rd, Rn, Rm` (op OPS_ADD = ADC, OPS_ADDS =
// ADCS, OPS_SUB = SBC, OPS_SUBS = SBCS).  All registers are zero-or-register.
func AddSubCarry(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if !dpOpsValid(op) {
		a.SetError("add/sub with carry: invalid operation")
		return
	}
	Emit32(a, dpRegs(0x1A000000 | op | (cast(uint32, rm) << 16), sf, rn, rd))
}

// logicalImmValue checks a logical immediate against the register width and returns
// it as the element pattern encodeBitmaskImm expects: for a 32-bit operation the
// upper 32 bits must be all zero or all one — clang's W-form rule, which admits a
// sign-extended or complemented constant such as `#-16` — and the value is reduced to
// its low 32 bits; any other upper half names a value the W form cannot represent.
func logicalImmValue(value uint64, sf bool) (uint64, bool) {
	if sf { return value, true }
	var hi uint64 = value >> 32
	if hi == 0 || hi == 0xFFFFFFFF { return value & 0xFFFFFFFF, true }
	return 0, false
}

// IsLogicalImm reports whether value is encodable as a logical (bitmask) immediate
// for the width sf — the check LogicalImm makes before emitting.
func IsLogicalImm(value uint64, sf bool) bool {
	v, ok := logicalImmValue(value, sf)
	if !ok { return false }
	var enc BitmaskResult = encodeBitmaskImm(v, sf)
	return enc.Ok && (sf || enc.N == 0)
}

// LogicalImm emits AND/ORR/EOR/ANDS (immediate): `op Rd, Rn, #bitmask`.  op is LG_AND,
// LG_ORR, LG_EOR or LG_ANDS; value must be a bitmask immediate for the width.  Rn is
// zero-or-register; Rd is SP-or-register for AND/ORR/EOR and zero-or-register for
// ANDS.
func LogicalImm(a @asm.Assembler, op uint32, sf bool, rd int, rn int, value uint64) {
	if !RegsOk(a, rd, rn, 0, 0) { return }
	if op != LG_AND && op != LG_ORR && op != LG_EOR && op != LG_ANDS {
		a.SetError("logical immediate: invalid operation")
		return
	}
	v, ok := logicalImmValue(value, sf)
	var enc BitmaskResult
	if ok { enc = encodeBitmaskImm(v, sf) }
	if !ok || !enc.Ok {
		a.SetError("logical immediate: value is not an encodable bitmask for this width")
		return
	}
	if !sf && enc.N != 0 {
		a.SetError("logical immediate: value is not an encodable bitmask for this width")
		return
	}
	var inst uint32 = 0x12000000 | op | (cast(uint32, enc.N) << 22) | (cast(uint32, enc.Immr) << 16) |
			(cast(uint32, enc.Imms) << 10)
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// LogicalShifted emits the shifted-register logical instructions: `op Rd, Rn, Rm{,
// shift #amount}` with op LG_AND / LG_ORR / LG_EOR / LG_ANDS, optionally ORed with
// LG_NOT for BIC / ORN / EON / BICS; shift LSL / LSR / ASR / ROR, amount below the
// register width.  All registers are zero-or-register.
func LogicalShifted(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, shift int,
		amount int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	var base uint32 = op & (0xFFFFFFFF ^ LG_NOT)
	if (op & 0x9FDFFFFF) != 0 ||
			(base != LG_AND && base != LG_ORR && base != LG_EOR && base != LG_ANDS) {
		a.SetError("logical: invalid operation")
		return
	}
	if shift < LSL || shift > ROR {
		a.SetError("logical: invalid shift")
		return
	}
	if amount < 0 || amount >= dpWidth(sf) {
		a.SetError("logical: shift amount out of range")
		return
	}
	var inst uint32 = 0x0A000000 | op | (cast(uint32, shift) << 22) | (cast(uint32, rm) << 16) |
			(cast(uint32, amount) << 10)
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// MoveWide emits MOVN/MOVZ/MOVK: `op Rd, #imm16{, lsl #shift}`, imm16 0..0xFFFF and
// shift 0 / 16 (and 32 / 48 in the 64-bit form).  Rd is zero-or-register.
func MoveWide(a @asm.Assembler, op uint32, sf bool, rd int, imm16 int, shift int) {
	inst, ok := moveWideWord(a, op, sf, rd, imm16, shift)
	if ok { Emit32(a, inst) }
}

// moveWideWord returns the MOVN/MOVZ/MOVK word MoveWide emits for its operands, or false
// with a's error set when MoveWide rejects them.
func moveWideWord(a @asm.Assembler, op uint32, sf bool, rd int, imm16 int,
		shift int) (uint32, bool) {
	if !RegsOk(a, rd, 0, 0, 0) { return 0, false }
	if op != MW_MOVN && op != MW_MOVZ && op != MW_MOVK {
		a.SetError("move wide: invalid operation")
		return 0, false
	}
	if imm16 < 0 || imm16 > 0xFFFF {
		a.SetError("move wide: immediate out of range [0, 65535]")
		return 0, false
	}
	if shift % 16 != 0 || shift < 0 || shift >= dpWidth(sf) {
		a.SetError("move wide: shift must be 0 or 16 (or 32/48 for a 64-bit register)")
		return 0, false
	}
	var inst uint32 = 0x12800000 | op | (cast(uint32, shift / 16) << 21) | (cast(uint32, imm16) << 5)
	return dpRegs(inst, sf, 0, rd), true
}

// Bitfield emits SBFM/BFM/UBFM: `op Rd, Rn, #immr, #imms`, both below the register
// width (op BF_SBFM / BF_BFM / BF_UBFM).  Registers are zero-or-register.  The shift,
// extend and bitfield-extract/insert aliases are all forms of these.
func Bitfield(a @asm.Assembler, op uint32, sf bool, rd int, rn int, immr int, imms int) {
	if !RegsOk(a, rd, rn, 0, 0) { return }
	if op != BF_SBFM && op != BF_BFM && op != BF_UBFM {
		a.SetError("bitfield: invalid operation")
		return
	}
	var w int = dpWidth(sf)
	if immr < 0 || immr >= w || imms < 0 || imms >= w {
		a.SetError("bitfield: immr/imms out of range for the register width")
		return
	}
	var inst uint32 = 0x13000000 | op | (cast(uint32, immr) << 16) | (cast(uint32, imms) << 10)
	if sf { inst = inst | 0x00400000 } // N = sf
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// Extr emits EXTR `Rd, Rn, Rm, #lsb` (lsb below the register width): the register
// pair Rn:Rm shifted right by lsb.  Registers are zero-or-register.
func Extr(a @asm.Assembler, sf bool, rd int, rn int, rm int, lsb int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if lsb < 0 || lsb >= dpWidth(sf) {
		a.SetError("extr: lsb out of range for the register width")
		return
	}
	var inst uint32 = 0x13800000 | (cast(uint32, rm) << 16) | (cast(uint32, lsb) << 10)
	if sf { inst = inst | 0x00400000 } // N = sf
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// DataProc2 emits a two-source data-processing instruction `op Rd, Rn, Rm`: op is
// D2_UDIV, D2_SDIV, D2_LSLV, D2_LSRV, D2_ASRV or D2_RORV.  Registers are
// zero-or-register.
func DataProc2(a @asm.Assembler, op int, sf bool, rd int, rn int, rm int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if op != D2_UDIV && op != D2_SDIV && (op < D2_LSLV || op > D2_RORV) {
		a.SetError("data-processing (2 source): invalid operation")
		return
	}
	var inst uint32 = 0x1AC00000 | (cast(uint32, rm) << 16) | (cast(uint32, op) << 10)
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// DataProc1 emits a one-source data-processing instruction `op Rd, Rn`: op is
// D1_RBIT, D1_REV16, D1_REV32 (the 32-bit REV, or REV32 of an X register), D1_REV64
// (64-bit only), D1_CLZ or D1_CLS.  Registers are zero-or-register.
func DataProc1(a @asm.Assembler, op int, sf bool, rd int, rn int) {
	if !RegsOk(a, rd, rn, 0, 0) { return }
	if op < D1_RBIT || op > D1_CLS {
		a.SetError("data-processing (1 source): invalid operation")
		return
	}
	if op == D1_REV64 && !sf {
		a.SetError("data-processing (1 source): 64-bit REV needs X registers")
		return
	}
	Emit32(a, dpRegs(0x5AC00000 | (cast(uint32, op) << 10), sf, rn, rd))
}

// MulAdd emits MADD / MSUB (sub): `Rd = Ra ± Rn * Rm`.  Registers are
// zero-or-register (Ra = XZR gives MUL / MNEG).
func MulAdd(a @asm.Assembler, sub bool, sf bool, rd int, rn int, rm int, ra int) {
	if !RegsOk(a, rd, rn, rm, ra) { return }
	var inst uint32 = 0x1B000000 | (cast(uint32, rm) << 16) | (cast(uint32, ra) << 10)
	if sub { inst = inst | 0x00008000 }
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// MulAddLong emits SMADDL/SMSUBL/UMADDL/UMSUBL: `Xd = Xa ± Wn * Wm` with a signed
// or unsigned 32x32->64 product.  Registers are zero-or-register (Xa = XZR gives
// SMULL / SMNEGL / UMULL / UMNEGL).
func MulAddLong(a @asm.Assembler, isUnsigned bool, sub bool, rd int, rn int, rm int, ra int) {
	if !RegsOk(a, rd, rn, rm, ra) { return }
	var inst uint32 = 0x9B200000 | (cast(uint32, rm) << 16) | (cast(uint32, ra) << 10)
	if isUnsigned { inst = inst | 0x00800000 }
	if sub { inst = inst | 0x00008000 }
	Emit32(a, dpRegs(inst, false, rn, rd))
}

// MulHigh emits SMULH / UMULH `Xd, Xn, Xm` — the high 64 bits of the 128-bit
// product.  Registers are zero-or-register.
func MulHigh(a @asm.Assembler, isUnsigned bool, rd int, rn int, rm int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	var inst uint32 = 0x9B407C00 | (cast(uint32, rm) << 16)
	if isUnsigned { inst = inst | 0x00800000 }
	Emit32(a, dpRegs(inst, false, rn, rd))
}

// CondSelect emits CSEL/CSINC/CSINV/CSNEG `op Rd, Rn, Rm, cond` (op CS_SEL, CS_INC,
// CS_INV, CS_NEG; cond 0-15).  Registers are zero-or-register.
func CondSelect(a @asm.Assembler, op uint32, sf bool, rd int, rn int, rm int, cond int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if op != CS_SEL && op != CS_INC && op != CS_INV && op != CS_NEG {
		a.SetError("conditional select: invalid operation")
		return
	}
	if cond < 0 || cond > 15 {
		a.SetError("conditional select: invalid condition")
		return
	}
	var inst uint32 = 0x1A800000 | op | (cast(uint32, rm) << 16) | (cast(uint32, cond) << 12)
	Emit32(a, dpRegs(inst, sf, rn, rd))
}

// CondCompare emits CCMN / CCMP (cmp): `op Rn, <Rm | #imm5>, #nzcv, cond`.  With
// isImm the second operand is the 5-bit unsigned immediate imm (0..31), otherwise the
// register numbered imm.  nzcv 0..15, cond 0-15; registers are zero-or-register.
func CondCompare(a @asm.Assembler, cmp bool, sf bool, rn int, isImm bool, imm int, nzcv int,
		cond int) {
	if !RegsOk(a, rn, 0, 0, 0) { return }
	if imm < 0 || imm > 31 {
		a.SetError("conditional compare: immediate/register out of range [0, 31]")
		return
	}
	if nzcv < 0 || nzcv > 15 || cond < 0 || cond > 15 {
		a.SetError("conditional compare: nzcv or condition out of range")
		return
	}
	var inst uint32 = 0x3A400000 | (cast(uint32, imm) << 16) | (cast(uint32, cond) << 12) |
			cast(uint32, nzcv)
	if cmp { inst = inst | 0x40000000 }
	if isImm { inst = inst | 0x00000800 }
	if sf { inst = inst | 0x80000000 }
	Emit32(a, inst | (cast(uint32, rn) << 5))
}
