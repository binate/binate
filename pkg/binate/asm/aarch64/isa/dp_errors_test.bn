package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Error-path tests for the exact data-processing encoders in aarch64_dp_arch.bn:
// every refused operand must set the assembler error and emit nothing — never a
// masked or split encoding.  lsdpRejected is in aarch64_ldst_arch_test.bn.

// AddSubImm refuses an imm12 outside [0, 4095] (with or without lsl #12) and an
// op that is not one of the OPS_* selections.
func TestAddSubImmErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubImm(a, OPS_ADD, true, X0, X1, 4096, false)
	if !lsdpRejected(a) { return fail("imm 4096") }
	a = newAsm()
	AddSubImm(a, OPS_SUB, true, X0, X1, -1, false)
	if !lsdpRejected(a) { return fail("imm -1") }
	a = newAsm()
	AddSubImm(a, OPS_ADDS, false, X0, X1, 4096, true)
	if !lsdpRejected(a) { return fail("imm 4096, lsl #12") }
	a = newAsm()
	AddSubImm(a, 0x10000000, true, X0, X1, 1, false)
	if !lsdpRejected(a) { return fail("op 0x10000000") }
	a = newAsm()
	AddSubImm(a, 0x80000000, true, X0, X1, 1, false)
	if !lsdpRejected(a) { return fail("op with the sf bit") }
	return ""
}

// AddSubShifted refuses ROR (reserved for add/sub; clang: "expected 'sxtx'
// 'uxtx' or 'lsl'"), an out-of-field shift, an amount at or past the register
// width, a negative amount, and an invalid op.
func TestAddSubShiftedErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubShifted(a, OPS_ADD, true, X0, X1, X2, ROR, 1)
	if !lsdpRejected(a) { return fail("ror") }
	a = newAsm()
	AddSubShifted(a, OPS_ADD, true, X0, X1, X2, 4, 1)
	if !lsdpRejected(a) { return fail("shift 4") }
	a = newAsm()
	AddSubShifted(a, OPS_SUB, false, X0, X1, X2, LSL, 32)
	if !lsdpRejected(a) { return fail("W amount 32") }
	a = newAsm()
	AddSubShifted(a, OPS_SUB, true, X0, X1, X2, LSR, 64)
	if !lsdpRejected(a) { return fail("X amount 64") }
	a = newAsm()
	AddSubShifted(a, OPS_ADDS, true, X0, X1, X2, ASR, -1)
	if !lsdpRejected(a) { return fail("amount -1") }
	a = newAsm()
	AddSubShifted(a, 0x00200000, true, X0, X1, X2, LSL, 0)
	if !lsdpRejected(a) { return fail("op 0x00200000") }
	return ""
}

// AddSubExtended refuses an extend outside XT_UXTB..XT_SXTX, an amount outside
// [0, 4] (imm3 101-111 is reserved), and an invalid op.
func TestAddSubExtendedErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubExtended(a, OPS_ADD, true, X0, X1, X2, -1, 0)
	if !lsdpRejected(a) { return fail("extend -1") }
	a = newAsm()
	AddSubExtended(a, OPS_ADD, true, X0, X1, X2, 8, 0)
	if !lsdpRejected(a) { return fail("extend 8") }
	a = newAsm()
	AddSubExtended(a, OPS_SUB, true, X0, X1, X2, XT_UXTW, 5)
	if !lsdpRejected(a) { return fail("amount 5") }
	a = newAsm()
	AddSubExtended(a, OPS_SUBS, false, X0, X1, X2, XT_SXTB, -1)
	if !lsdpRejected(a) { return fail("amount -1") }
	a = newAsm()
	AddSubExtended(a, 0x10000000, true, X0, X1, X2, XT_UXTX, 0)
	if !lsdpRejected(a) { return fail("op 0x10000000") }
	return ""
}

// AddSubCarry refuses an op that is not one of the OPS_* selections.
func TestAddSubCarryErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubCarry(a, 0x10000000, true, X0, X1, X2)
	if !lsdpRejected(a) { return fail("op 0x10000000") }
	a = newAsm()
	AddSubCarry(a, 1, false, X0, X1, X2)
	if !lsdpRejected(a) { return fail("op 1") }
	return ""
}

// logicalImmRejected reports whether LogicalImm refuses value without emitting.
func logicalImmRejected(op uint32, sf bool, value uint64) bool {
	var a @asm.Assembler = newAsm()
	LogicalImm(a, op, sf, X0, X1, value)
	return lsdpRejected(a)
}

// LogicalImm refuses LG_NOT (no immediate BIC/ORN/EON/BICS) and other stray op
// bits, 0 and all-ones in either width, a non-bitmask value, and a W value whose
// upper half is neither all zero nor all one (clang rejects each: "expected
// compatible register or logical immediate").
func TestLogicalImmErrors() testing.TestResult {
	if !logicalImmRejected(LG_AND | LG_NOT, true, 0xFF) { return fail("LG_NOT op") }
	if !logicalImmRejected(0x00000001, true, 0xFF) { return fail("op 1") }
	if !logicalImmRejected(LG_AND, true, 0) { return fail("X 0") }
	if !logicalImmRejected(LG_ORR, false, 0) { return fail("W 0") }
	if !logicalImmRejected(LG_EOR, true, 0xFFFFFFFFFFFFFFFF) { return fail("X all-ones") }
	if !logicalImmRejected(LG_AND, false, 0xFFFFFFFF) { return fail("W all-ones") }
	if !logicalImmRejected(LG_AND, false, 0xFFFFFFFFFFFFFFFF) { return fail("W -1") }
	if !logicalImmRejected(LG_ANDS, true, 0x1234) { return fail("X 0x1234") }
	if !logicalImmRejected(LG_ANDS, false, 0x1234) { return fail("W 0x1234") }
	if !logicalImmRejected(LG_AND, false, 0x100000000) { return fail("W with bit 32") }
	if !logicalImmRejected(LG_ORR, false, 0x00000001FFFFFFFE) { return fail("W upper word 1") }
	if !logicalImmRejected(LG_AND, false, 0xFFFFFFFF00000000) { return fail("W low word 0") }
	return ""
}

// LogicalShifted refuses an op with bits outside opc / N (e.g. the sf bit or a
// register field), a shift outside LSL..ROR, and an amount at or past the
// register width or negative.
func TestLogicalShiftedErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LogicalShifted(a, 0x80000000, true, X0, X1, X2, LSL, 0)
	if !lsdpRejected(a) { return fail("op with the sf bit") }
	a = newAsm()
	LogicalShifted(a, LG_ORR | 0x00000001, true, X0, X1, X2, LSL, 0)
	if !lsdpRejected(a) { return fail("op with a register bit") }
	a = newAsm()
	LogicalShifted(a, LG_AND, true, X0, X1, X2, 4, 0)
	if !lsdpRejected(a) { return fail("shift 4") }
	a = newAsm()
	LogicalShifted(a, LG_AND, true, X0, X1, X2, -1, 0)
	if !lsdpRejected(a) { return fail("shift -1") }
	a = newAsm()
	LogicalShifted(a, LG_EOR, false, X0, X1, X2, ROR, 32)
	if !lsdpRejected(a) { return fail("W amount 32") }
	a = newAsm()
	LogicalShifted(a, LG_ANDS, true, X0, X1, X2, LSL, 64)
	if !lsdpRejected(a) { return fail("X amount 64") }
	a = newAsm()
	LogicalShifted(a, LG_AND, true, X0, X1, X2, LSL, -1)
	if !lsdpRejected(a) { return fail("amount -1") }
	return ""
}

// MoveWide refuses opc=01 (unallocated), an imm16 outside [0, 0xFFFF], and a
// shift that is not a multiple of 16 below the width (clang: W takes 0 or 16,
// X 0 / 16 / 32 / 48).
func TestMoveWideErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MoveWide(a, 0x20000000, true, X0, 1, 0)
	if !lsdpRejected(a) { return fail("opc=01") }
	a = newAsm()
	MoveWide(a, MW_MOVZ, true, X0, 0x10000, 0)
	if !lsdpRejected(a) { return fail("imm16 0x10000") }
	a = newAsm()
	MoveWide(a, MW_MOVK, true, X0, -1, 0)
	if !lsdpRejected(a) { return fail("imm16 -1") }
	a = newAsm()
	MoveWide(a, MW_MOVZ, false, X0, 1, 32)
	if !lsdpRejected(a) { return fail("W shift 32") }
	a = newAsm()
	MoveWide(a, MW_MOVN, true, X0, 1, 64)
	if !lsdpRejected(a) { return fail("X shift 64") }
	a = newAsm()
	MoveWide(a, MW_MOVZ, true, X0, 1, 8)
	if !lsdpRejected(a) { return fail("shift 8") }
	a = newAsm()
	MoveWide(a, MW_MOVZ, true, X0, 1, -16)
	if !lsdpRejected(a) { return fail("shift -16") }
	return ""
}

// Bitfield refuses opc=11 (unallocated) and immr / imms outside the width.
func TestBitfieldErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bitfield(a, 0x60000000, true, X0, X1, 0, 0)
	if !lsdpRejected(a) { return fail("opc=11") }
	a = newAsm()
	Bitfield(a, BF_UBFM, false, X0, X1, 32, 0)
	if !lsdpRejected(a) { return fail("W immr 32") }
	a = newAsm()
	Bitfield(a, BF_SBFM, false, X0, X1, 0, 32)
	if !lsdpRejected(a) { return fail("W imms 32") }
	a = newAsm()
	Bitfield(a, BF_BFM, true, X0, X1, 64, 0)
	if !lsdpRejected(a) { return fail("X immr 64") }
	a = newAsm()
	Bitfield(a, BF_BFM, true, X0, X1, 0, 64)
	if !lsdpRejected(a) { return fail("X imms 64") }
	a = newAsm()
	Bitfield(a, BF_UBFM, true, X0, X1, -1, 0)
	if !lsdpRejected(a) { return fail("immr -1") }
	a = newAsm()
	Bitfield(a, BF_UBFM, true, X0, X1, 0, -1)
	if !lsdpRejected(a) { return fail("imms -1") }
	return ""
}

// Extr refuses an lsb at or past the register width, or negative.
func TestExtrErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Extr(a, false, X0, X1, X2, 32)
	if !lsdpRejected(a) { return fail("W lsb 32") }
	a = newAsm()
	Extr(a, true, X0, X1, X2, 64)
	if !lsdpRejected(a) { return fail("X lsb 64") }
	a = newAsm()
	Extr(a, true, X0, X1, X2, -1)
	if !lsdpRejected(a) { return fail("lsb -1") }
	return ""
}

// DataProc2 refuses opcodes other than UDIV / SDIV / LSLV / LSRV / ASRV / RORV.
func TestDataProc2Errors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	DataProc2(a, 0, true, X0, X1, X2)
	if !lsdpRejected(a) { return fail("opcode 0") }
	a = newAsm()
	DataProc2(a, 4, true, X0, X1, X2)
	if !lsdpRejected(a) { return fail("opcode 4") }
	a = newAsm()
	DataProc2(a, 7, false, X0, X1, X2)
	if !lsdpRejected(a) { return fail("opcode 7") }
	a = newAsm()
	DataProc2(a, 12, true, X0, X1, X2)
	if !lsdpRejected(a) { return fail("opcode 12") }
	return ""
}

// DataProc1 refuses opcodes outside RBIT..CLS, and the 64-bit REV on a W
// register (clang rejects `rev x0, w1`; there is no 32-bit REV64).
func TestDataProc1Errors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	DataProc1(a, D1_REV64, false, X0, X1)
	if !lsdpRejected(a) { return fail("REV64 on W") }
	a = newAsm()
	DataProc1(a, -1, true, X0, X1)
	if !lsdpRejected(a) { return fail("opcode -1") }
	a = newAsm()
	DataProc1(a, 6, true, X0, X1)
	if !lsdpRejected(a) { return fail("opcode 6") }
	return ""
}

// CondSelect refuses a condition outside 0..15 and an op outside the CS_* set
// (S=1 and op2=1x are unallocated).
func TestCondSelectErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondSelect(a, CS_SEL, true, X0, X1, X2, 16)
	if !lsdpRejected(a) { return fail("cond 16") }
	a = newAsm()
	CondSelect(a, CS_INC, false, X0, X1, X2, -1)
	if !lsdpRejected(a) { return fail("cond -1") }
	a = newAsm()
	CondSelect(a, 0x20000000, true, X0, X1, X2, COND_EQ)
	if !lsdpRejected(a) { return fail("S=1") }
	a = newAsm()
	CondSelect(a, 0x00000800, true, X0, X1, X2, COND_EQ)
	if !lsdpRejected(a) { return fail("op2=10") }
	return ""
}

// condCompareRejected reports whether CondCompare refuses the operands without
// emitting.
func condCompareRejected(isImm bool, imm int, nzcv int, cond int) bool {
	var a @asm.Assembler = newAsm()
	CondCompare(a, true, true, X0, isImm, imm, nzcv, cond)
	return lsdpRejected(a)
}

// CondCompare refuses an imm5 / Rm outside [0, 31], nzcv outside [0, 15] and a
// condition outside 0..15.
func TestCondCompareErrors() testing.TestResult {
	if !condCompareRejected(true, 32, 0, COND_EQ) { return fail("imm5 32") }
	if !condCompareRejected(true, -1, 0, COND_EQ) { return fail("imm5 -1") }
	if !condCompareRejected(false, 32, 0, COND_EQ) { return fail("Rm 32") }
	if !condCompareRejected(true, 0, 16, COND_EQ) { return fail("nzcv 16") }
	if !condCompareRejected(true, 0, -1, COND_EQ) { return fail("nzcv -1") }
	if !condCompareRejected(false, X1, 0, 16) { return fail("cond 16") }
	if !condCompareRejected(false, X1, 0, -1) { return fail("cond -1") }
	return ""
}
