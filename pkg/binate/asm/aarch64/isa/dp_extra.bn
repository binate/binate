package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the checksum, pointer-authentication and flag-manipulation
// data-processing instructions: CRC32 / CRC32C, the register forms of PAC* / AUT* /
// XPAC* and PACGA, and CFINV / XAFLAG / AXFLAG / RMIF / SETF8 / SETF16.

// Crc32 emits CRC32{B,H,W,X} (or CRC32C*, castagnoli) `Wd, Wn, Rm` over 1 << size
// bytes of Rm (size 0..3; Rm is an X register for size 3, else a W register).
// Registers are zero-or-register.
func Crc32(a @asm.Assembler, castagnoli bool, size int, rd int, rn int, rm int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	if size < 0 || size > 3 {
		a.SetError("crc32: size out of range [0, 3]")
		return
	}
	var inst uint32 = 0x1AC04000 | (cast(uint32, size) << 10) | (cast(uint32, rm) << 16)
	if castagnoli { inst = inst | 0x00001000 }
	if size == 3 { inst = inst | 0x80000000 }
	Emit32(a, dpRegs(inst, false, rn, rd))
}

// PacGA emits PACGA `Xd, Xn, Xm|SP`: the generic authentication code of Xn with the
// modifier Xm.  Rd and Rn are zero-or-register; Rm is SP-or-register.
func PacGA(a @asm.Assembler, rd int, rn int, rm int) {
	if !RegsOk(a, rd, rn, rm, 0) { return }
	Emit32(a, dpRegs(0x9AC03000 | (cast(uint32, rm) << 16), false, rn, rd))
}

// PointerAuth emits a PA_* pointer-authentication operation on Xd.  PA_PACIA …
// PA_AUTDB take the modifier in Rn (SP-or-register): `Xd, Xn|SP`.  The zero-modifier
// forms PA_PACIZA … PA_AUTDZB and PA_XPACI / PA_XPACD take only `Xd`, so rn must be 31
// (the architecture's fixed Rn = 11111).  Xd is zero-or-register.
func PointerAuth(a @asm.Assembler, op int, rd int, rn int) {
	if !RegsOk(a, rd, rn, 0, 0) { return }
	if op < PA_PACIA || op > PA_XPACD {
		a.SetError("pointer authentication: invalid operation")
		return
	}
	if op >= PA_PACIZA && rn != 31 {
		a.SetError("pointer authentication: this form takes no modifier register (Rn = 31)")
		return
	}
	Emit32(a, dpRegs(0xDAC10000 | (cast(uint32, op) << 10), true, rn, rd))
}

// FlagManip emits CFINV / XAFLAG / AXFLAG (FL_* ops), which take no operands.
func FlagManip(a @asm.Assembler, op uint32) {
	if op != FL_CFINV && op != FL_XAFLAG && op != FL_AXFLAG {
		a.SetError("flag manipulation: invalid operation")
		return
	}
	Emit32(a, op)
}

// Rmif emits RMIF `Xn, #shift, #mask`: rotate Xn right by shift (0..63) and insert
// the low four bits selected by mask (0..15) into NZCV.  Xn is zero-or-register.
func Rmif(a @asm.Assembler, rn int, shift int, mask int) {
	if !RegsOk(a, rn, 0, 0, 0) { return }
	if shift < 0 || shift > 63 || mask < 0 || mask > 15 {
		a.SetError("rmif: shift must be in [0, 63] and mask in [0, 15]")
		return
	}
	Emit32(a, 0xBA000400 | (cast(uint32, shift) << 15) | (cast(uint32, rn) << 5) | cast(uint32, mask))
}

// SetFlags emits SETF8 / SETF16 (sixteen) `Wn`: set NZV from the low 8 / 16 bits of
// Wn.  Wn is zero-or-register.
func SetFlags(a @asm.Assembler, sixteen bool, rn int) {
	if !RegsOk(a, rn, 0, 0, 0) { return }
	var inst uint32 = 0x3A00080D | (cast(uint32, rn) << 5)
	if sixteen { inst = inst | 0x00004000 }
	Emit32(a, inst)
}
