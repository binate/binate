package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The checksum / pointer-authentication / flag-manipulation encoders' own checks (the
// text assembler's golden tables cover their encodings).  (lsdpRejected / lsdpClean /
// lsdpWordIs are in ldst_test.bn.)

func TestDPExtraChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Crc32(a, true, 3, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9AC25C20) { return fail("crc32cx w0, w1, x2") }
	a = newAsm()
	Crc32(a, false, 4, 0, 1, 2)
	if !lsdpRejected(a) { return fail("crc32 size 4") }
	a = newAsm()
	PointerAuth(a, PA_AUTDB, 31, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xDAC11FFF) { return fail("autdb xzr, sp") }
	a = newAsm()
	PointerAuth(a, PA_PACIZA, 0, 1)
	if !lsdpRejected(a) { return fail("a zero-modifier form with Rn != 31") }
	a = newAsm()
	PointerAuth(a, 18, 0, 31)
	if !lsdpRejected(a) { return fail("an invalid op") }
	a = newAsm()
	FlagManip(a, 0xD503201F)
	if !lsdpRejected(a) { return fail("a word that is not a flag instruction") }
	a = newAsm()
	Rmif(a, 0, 64, 0)
	if !lsdpRejected(a) { return fail("rmif shift 64") }
	a = newAsm()
	SetFlags(a, true, 32)
	if !lsdpRejected(a) { return fail("setf16 register 32") }
	a = newAsm()
	PacGA(a, 0, 1, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9ADF3020) { return fail("pacga x0, x1, sp") }
	return ""
}
