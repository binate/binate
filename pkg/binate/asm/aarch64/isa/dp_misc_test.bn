package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the exact bitfield, extract, one/two-source,
// multiply, conditional-select and conditional-compare encoders in
// aarch64_dp_arch.bn.  Every expected word comes from clang-assembled machine
// code (clang -target arm64-apple-macos11, otool -s __TEXT __text).
// lsdpWordIs / lsdpClean are in aarch64_ldst_arch_test.bn.

// Bitfield: SBFM / BFM / UBFM in both widths (N = sf), immr and imms up to the
// width's maximum.
func TestBitfield() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bitfield(a, BF_SBFM, true, X0, X1, 63, 63) // sbfm x0, x1, #63, #63
	Bitfield(a, BF_UBFM, false, X2, X3, 31, 30) // ubfm w2, w3, #31, #30
	Bitfield(a, BF_BFM, true, X4, X5, 1, 2) // bfm x4, x5, #1, #2
	Bitfield(a, BF_SBFM, false, X6, X7, 0, 7) // sbfm w6, w7, #0, #7
	Bitfield(a, BF_UBFM, true, X8, X9, 0, 63) // ubfm x8, x9, #0, #63
	Bitfield(a, BF_BFM, false, X10, X11, 31, 31) // bfm w10, w11, #31, #31
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x937FFC20) { return fail("sbfm x0, x1, #63, #63") }
	if !lsdpWordIs(a, 1, 0x531F7862) { return fail("ubfm w2, w3, #31, #30") }
	if !lsdpWordIs(a, 2, 0xB34108A4) { return fail("bfm x4, x5, #1, #2") }
	if !lsdpWordIs(a, 3, 0x13001CE6) { return fail("sbfm w6, w7, #0, #7") }
	if !lsdpWordIs(a, 4, 0xD340FD28) { return fail("ubfm x8, x9, #0, #63") }
	if !lsdpWordIs(a, 5, 0x331F7D6A) { return fail("bfm w10, w11, #31, #31") }
	return ""
}

// Extr: both widths (N = sf), lsb 0 and the width's maximum, and the ROR
// (immediate) alias with Rn == Rm.
func TestExtr() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Extr(a, true, X0, X1, X2, 63) // extr x0, x1, x2, #63
	Extr(a, false, X3, X4, X5, 31) // extr w3, w4, w5, #31
	Extr(a, false, X6, X7, X7, 3) // extr w6, w7, w7, #3 (ror w6, w7, #3)
	Extr(a, true, X8, X9, X10, 0) // extr x8, x9, x10, #0
	if !lsdpClean(a, 4) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x93C2FC20) { return fail("extr x0, x1, x2, #63") }
	if !lsdpWordIs(a, 1, 0x13857C83) { return fail("extr w3, w4, w5, #31") }
	if !lsdpWordIs(a, 2, 0x13870CE6) { return fail("extr w6, w7, w7, #3") }
	if !lsdpWordIs(a, 3, 0x93CA0128) { return fail("extr x8, x9, x10, #0") }
	return ""
}

// DataProc2: every D2_* opcode, alternating widths.
func TestDataProc2() testing.TestResult {
	var a @asm.Assembler = newAsm()
	DataProc2(a, D2_UDIV, true, X0, X1, X2) // udiv x0, x1, x2
	DataProc2(a, D2_SDIV, false, X3, X4, X5) // sdiv w3, w4, w5
	DataProc2(a, D2_LSLV, true, X6, X7, X8) // lslv x6, x7, x8
	DataProc2(a, D2_LSRV, false, X9, X10, X11) // lsrv w9, w10, w11
	DataProc2(a, D2_ASRV, true, X12, X13, X14) // asrv x12, x13, x14
	DataProc2(a, D2_RORV, false, X15, X16, X17) // rorv w15, w16, w17
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x9AC20820) { return fail("udiv x0, x1, x2") }
	if !lsdpWordIs(a, 1, 0x1AC50C83) { return fail("sdiv w3, w4, w5") }
	if !lsdpWordIs(a, 2, 0x9AC820E6) { return fail("lslv x6, x7, x8") }
	if !lsdpWordIs(a, 3, 0x1ACB2549) { return fail("lsrv w9, w10, w11") }
	if !lsdpWordIs(a, 4, 0x9ACE29AC) { return fail("asrv x12, x13, x14") }
	if !lsdpWordIs(a, 5, 0x1AD12E0F) { return fail("rorv w15, w16, w17") }
	return ""
}

// DataProc1: every D1_* opcode in each width it has — D1_REV32 is REV of a W
// register and REV32 of an X register; D1_REV64 is the 64-bit REV.
func TestDataProc1() testing.TestResult {
	var a @asm.Assembler = newAsm()
	DataProc1(a, D1_RBIT, true, X0, X1) // rbit x0, x1
	DataProc1(a, D1_REV16, false, X2, X3) // rev16 w2, w3
	DataProc1(a, D1_REV32, false, X4, X5) // rev w4, w5
	DataProc1(a, D1_REV32, true, X6, X7) // rev32 x6, x7
	DataProc1(a, D1_REV64, true, X8, X9) // rev x8, x9
	DataProc1(a, D1_CLZ, false, X10, X11) // clz w10, w11
	DataProc1(a, D1_CLS, true, X12, X13) // cls x12, x13
	DataProc1(a, D1_RBIT, false, X14, X15) // rbit w14, w15
	DataProc1(a, D1_REV16, true, X16, X17) // rev16 x16, x17
	DataProc1(a, D1_CLZ, true, X18, X19) // clz x18, x19
	DataProc1(a, D1_CLS, false, X20, X21) // cls w20, w21
	if !lsdpClean(a, 11) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xDAC00020) { return fail("rbit x0, x1") }
	if !lsdpWordIs(a, 1, 0x5AC00462) { return fail("rev16 w2, w3") }
	if !lsdpWordIs(a, 2, 0x5AC008A4) { return fail("rev w4, w5") }
	if !lsdpWordIs(a, 3, 0xDAC008E6) { return fail("rev32 x6, x7") }
	if !lsdpWordIs(a, 4, 0xDAC00D28) { return fail("rev x8, x9") }
	if !lsdpWordIs(a, 5, 0x5AC0116A) { return fail("clz w10, w11") }
	if !lsdpWordIs(a, 6, 0xDAC015AC) { return fail("cls x12, x13") }
	if !lsdpWordIs(a, 7, 0x5AC001EE) { return fail("rbit w14, w15") }
	if !lsdpWordIs(a, 8, 0xDAC00630) { return fail("rev16 x16, x17") }
	if !lsdpWordIs(a, 9, 0xDAC01272) { return fail("clz x18, x19") }
	if !lsdpWordIs(a, 10, 0x5AC016B4) { return fail("cls w20, w21") }
	return ""
}

// MulAdd: MADD / MSUB in both widths, and Ra = XZR (the MUL / MNEG aliases).
func TestMulAdd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MulAdd(a, false, true, X0, X1, X2, X3) // madd x0, x1, x2, x3
	MulAdd(a, true, false, X4, X5, X6, X7) // msub w4, w5, w6, w7
	MulAdd(a, false, true, X8, X9, X10, XZR) // madd x8, x9, x10, xzr (mul)
	MulAdd(a, true, false, X11, X12, X13, XZR) // msub w11, w12, w13, wzr (mneg)
	if !lsdpClean(a, 4) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x9B020C20) { return fail("madd x0, x1, x2, x3") }
	if !lsdpWordIs(a, 1, 0x1B069CA4) { return fail("msub w4, w5, w6, w7") }
	if !lsdpWordIs(a, 2, 0x9B0A7D28) { return fail("madd x8, x9, x10, xzr") }
	if !lsdpWordIs(a, 3, 0x1B0DFD8B) { return fail("msub w11, w12, w13, wzr") }
	return ""
}

// MulAddLong: signed / unsigned x add / subtract, and Xa = XZR (UMNEGL).
func TestMulAddLong() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MulAddLong(a, false, false, X0, X1, X2, X3) // smaddl x0, w1, w2, x3
	MulAddLong(a, false, true, X4, X5, X6, X7) // smsubl x4, w5, w6, x7
	MulAddLong(a, true, false, X8, X9, X10, X11) // umaddl x8, w9, w10, x11
	MulAddLong(a, true, true, X12, X13, X14, XZR) // umsubl x12, w13, w14, xzr
	if !lsdpClean(a, 4) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x9B220C20) { return fail("smaddl x0, w1, w2, x3") }
	if !lsdpWordIs(a, 1, 0x9B269CA4) { return fail("smsubl x4, w5, w6, x7") }
	if !lsdpWordIs(a, 2, 0x9BAA2D28) { return fail("umaddl x8, w9, w10, x11") }
	if !lsdpWordIs(a, 3, 0x9BAEFDAC) { return fail("umsubl x12, w13, w14, xzr") }
	return ""
}

// MulHigh: SMULH and UMULH.
func TestMulHigh() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MulHigh(a, false, X0, X1, X2) // smulh x0, x1, x2
	MulHigh(a, true, X3, X4, X5) // umulh x3, x4, x5
	if !lsdpClean(a, 2) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x9B427C20) { return fail("smulh x0, x1, x2") }
	if !lsdpWordIs(a, 1, 0x9BC57C83) { return fail("umulh x3, x4, x5") }
	return ""
}

// CondSelect: each CS_* op, both widths, conditions including AL and NV (both
// encodable here), and the CSET form (CSINC with WZR sources).
func TestCondSelect() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondSelect(a, CS_SEL, true, X0, X1, X2, COND_EQ) // csel x0, x1, x2, eq
	CondSelect(a, CS_INC, false, X3, X4, X5, COND_NE) // csinc w3, w4, w5, ne
	CondSelect(a, CS_INV, true, X6, X7, X8, COND_AL) // csinv x6, x7, x8, al
	CondSelect(a, CS_NEG, false, X9, X10, X11, COND_NV) // csneg w9, w10, w11, nv
	CondSelect(a, CS_INC, false, X12, XZR, XZR, COND_NE) // csinc w12, wzr, wzr, ne
	CondSelect(a, CS_SEL, false, X13, X14, X15, COND_LT) // csel w13, w14, w15, lt
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x9A820020) { return fail("csel x0, x1, x2, eq") }
	if !lsdpWordIs(a, 1, 0x1A851483) { return fail("csinc w3, w4, w5, ne") }
	if !lsdpWordIs(a, 2, 0xDA88E0E6) { return fail("csinv x6, x7, x8, al") }
	if !lsdpWordIs(a, 3, 0x5A8BF549) { return fail("csneg w9, w10, w11, nv") }
	if !lsdpWordIs(a, 4, 0x1A9F17EC) { return fail("csinc w12, wzr, wzr, ne") }
	if !lsdpWordIs(a, 5, 0x1A8FB1CD) { return fail("csel w13, w14, w15, lt") }
	return ""
}

// CondCompare: CCMP / CCMN, register and imm5 forms, both widths, the imm5 /
// nzcv extremes, and register 31 as the zero register.
func TestCondCompare() testing.TestResult {
	var a @asm.Assembler = newAsm()
	CondCompare(a, true, true, X0, true, 31, 15, COND_NE) // ccmp x0, #31, #15, ne
	CondCompare(a, false, false, X1, false, X2, 0, COND_EQ) // ccmn w1, w2, #0, eq
	CondCompare(a, true, false, X3, false, X4, 4, COND_LT) // ccmp w3, w4, #4, lt
	CondCompare(a, false, true, X5, true, 0, 8, COND_NV) // ccmn x5, #0, #8, nv
	CondCompare(a, true, true, XZR, false, X30, 1, COND_AL) // ccmp xzr, x30, #1, al
	CondCompare(a, false, false, XZR, true, 17, 2, COND_HI) // ccmn wzr, #17, #2, hi
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xFA5F180F) { return fail("ccmp x0, #31, #15, ne") }
	if !lsdpWordIs(a, 1, 0x3A420020) { return fail("ccmn w1, w2, #0, eq") }
	if !lsdpWordIs(a, 2, 0x7A44B064) { return fail("ccmp w3, w4, #4, lt") }
	if !lsdpWordIs(a, 3, 0xBA40F8A8) { return fail("ccmn x5, #0, #8, nv") }
	if !lsdpWordIs(a, 4, 0xFA5EE3E1) { return fail("ccmp xzr, x30, #1, al") }
	if !lsdpWordIs(a, 5, 0x3A518BE2) { return fail("ccmn wzr, #17, #2, hi") }
	return ""
}
