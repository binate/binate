package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the exact add/sub, logical and move-wide encoders
// in aarch64_dp_arch.bn.  Every expected word comes from clang-assembled
// machine code (clang -target arm64-apple-macos11, otool -s __TEXT __text); the
// ADD lo12 relocation from clang -target aarch64-linux-gnu.  The remaining
// encoders are in aarch64_dp_arch_misc_test.bn and every refusal path in
// aarch64_dp_arch_errors_test.bn.  lsdpWordIs / lsdpClean are in
// aarch64_ldst_arch_test.bn.

// AddSubImm: each OPS_* op, both widths, the lsl #12 form, the imm12 maximum,
// and register 31 as SP (ADD/SUB Rd and Rn) or XZR (SUBS Rd, i.e. CMP).
func TestAddSubImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubImm(a, OPS_ADD, true, X0, X1, 4095, false) // add x0, x1, #4095
	AddSubImm(a, OPS_ADD, true, SP, SP, 16, false) // add sp, sp, #16
	AddSubImm(a, OPS_ADDS, false, X2, X3, 1, true) // adds w2, w3, #1, lsl #12
	AddSubImm(a, OPS_SUB, true, X4, SP, 0, false) // sub x4, sp, #0
	AddSubImm(a, OPS_SUBS, true, XZR, X5, 7, false) // subs xzr, x5, #7
	AddSubImm(a, OPS_SUB, false, X6, SP, 4095, true) // sub w6, wsp, #4095, lsl #12
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x913FFC20) { return fail("add x0, x1, #4095") }
	if !lsdpWordIs(a, 1, 0x910043FF) { return fail("add sp, sp, #16") }
	if !lsdpWordIs(a, 2, 0x31400462) { return fail("adds w2, w3, #1, lsl #12") }
	if !lsdpWordIs(a, 3, 0xD10003E4) { return fail("sub x4, sp, #0") }
	if !lsdpWordIs(a, 4, 0xF1001CBF) { return fail("subs xzr, x5, #7") }
	if !lsdpWordIs(a, 5, 0x517FFFE6) { return fail("sub w6, wsp, #4095, lsl #12") }
	return ""
}

// AddSubLo12 emits ADD (immediate) with a zero imm12 in either width and records
// a FIX_ADD_LO12 fixup with the addend (clang: R_AARCH64_ADD_ABS_LO12_NC).
func TestAddSubLo12() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubLo12(a, true, X0, X1, "sym", 0) // add x0, x1, :lo12:sym
	AddSubLo12(a, false, X2, X3, "sym", 0) // add w2, w3, :lo12:sym
	AddSubLo12(a, true, SP, SP, "sym", 24) // add sp, sp, :lo12:sym+24
	if !lsdpClean(a, 3) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x91000020) { return fail("add x0, x1, :lo12:sym") }
	if !lsdpWordIs(a, 1, 0x11000062) { return fail("add w2, w3, :lo12:sym") }
	if !lsdpWordIs(a, 2, 0x910003FF) { return fail("add sp, sp, :lo12:sym") }
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 3 { return fail("expected one fixup per lo12 add") }
	if s.Fixups[0].Kind != FIX_ADD_LO12 || s.Fixups[2].Kind != FIX_ADD_LO12 {
		return fail("lo12 add fixup must be FIX_ADD_LO12")
	}
	if cast(int, s.Fixups[2].Offset) != 8 || s.Fixups[2].Addend != 24 {
		return fail("lo12 add fixup offset / addend")
	}
	return ""
}

// AddSubShifted: LSL / LSR / ASR at the width's maximum amount, register 31 as
// XZR in every position (CMP and NEG forms).
func TestAddSubShifted() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubShifted(a, OPS_ADD, true, X0, X1, X2, LSL, 63) // add x0, x1, x2, lsl #63
	AddSubShifted(a, OPS_ADDS, false, X3, X4, X5, ASR, 31) // adds w3, w4, w5, asr #31
	AddSubShifted(a, OPS_SUB, true, X6, X7, X8, LSR, 1) // sub x6, x7, x8, lsr #1
	AddSubShifted(a, OPS_SUBS, false, XZR, X9, X10, LSL, 0) // subs wzr, w9, w10
	AddSubShifted(a, OPS_SUB, true, X11, XZR, X12, LSL, 0) // sub x11, xzr, x12
	if !lsdpClean(a, 5) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x8B02FC20) { return fail("add x0, x1, x2, lsl #63") }
	if !lsdpWordIs(a, 1, 0x2B857C83) { return fail("adds w3, w4, w5, asr #31") }
	if !lsdpWordIs(a, 2, 0xCB4804E6) { return fail("sub x6, x7, x8, lsr #1") }
	if !lsdpWordIs(a, 3, 0x6B0A013F) { return fail("subs wzr, w9, w10") }
	if !lsdpWordIs(a, 4, 0xCB0C03EB) { return fail("sub x11, xzr, x12") }
	return ""
}

// AddSubExtended: byte / half / word / doubleword extends, signed and unsigned,
// amounts 0..4, both widths (a W operation takes the X extends too), and
// register 31 as SP for ADD/SUB Rd and Rn.
func TestAddSubExtended() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubExtended(a, OPS_ADD, true, X0, SP, X1, XT_UXTW, 2) // add x0, sp, w1, uxtw #2
	AddSubExtended(a, OPS_ADD, true, SP, SP, X2, XT_SXTX, 0) // add sp, sp, x2, sxtx
	AddSubExtended(a, OPS_ADDS, false, X0, X1, X2, XT_UXTB, 0) // adds w0, w1, w2, uxtb
	AddSubExtended(a, OPS_SUB, true, X3, X4, X5, XT_SXTH, 4) // sub x3, x4, w5, sxth #4
	AddSubExtended(a, OPS_SUBS, true, X6, X7, X8, XT_UXTX, 1) // subs x6, x7, x8, uxtx #1
	AddSubExtended(a, OPS_ADD, false, X9, X10, X11, XT_SXTB, 3) // add w9, w10, w11, sxtb #3
	AddSubExtended(a, OPS_SUB, true, SP, X12, X13, XT_UXTH, 0) // sub sp, x12, w13, uxth
	AddSubExtended(a, OPS_ADD, false, X0, X1, X2, XT_SXTX, 2) // add w0, w1, w2, sxtx #2
	if !lsdpClean(a, 8) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x8B214BE0) { return fail("add x0, sp, w1, uxtw #2") }
	if !lsdpWordIs(a, 1, 0x8B22E3FF) { return fail("add sp, sp, x2, sxtx") }
	if !lsdpWordIs(a, 2, 0x2B220020) { return fail("adds w0, w1, w2, uxtb") }
	if !lsdpWordIs(a, 3, 0xCB25B083) { return fail("sub x3, x4, w5, sxth #4") }
	if !lsdpWordIs(a, 4, 0xEB2864E6) { return fail("subs x6, x7, x8, uxtx #1") }
	if !lsdpWordIs(a, 5, 0x0B2B8D49) { return fail("add w9, w10, w11, sxtb #3") }
	if !lsdpWordIs(a, 6, 0xCB2D219F) { return fail("sub sp, x12, w13, uxth") }
	if !lsdpWordIs(a, 7, 0x0B22E820) { return fail("add w0, w1, w2, sxtx #2") }
	return ""
}

// AddSubCarry: OPS_ADD / ADDS / SUB / SUBS select ADC / ADCS / SBC / SBCS.
func TestAddSubCarry() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddSubCarry(a, OPS_ADD, true, X0, X1, X2) // adc x0, x1, x2
	AddSubCarry(a, OPS_ADDS, false, X3, X4, X5) // adcs w3, w4, w5
	AddSubCarry(a, OPS_SUB, true, X6, X7, X8) // sbc x6, x7, x8
	AddSubCarry(a, OPS_SUBS, false, X9, X10, X11) // sbcs w9, w10, w11
	if !lsdpClean(a, 4) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x9A020020) { return fail("adc x0, x1, x2") }
	if !lsdpWordIs(a, 1, 0x3A050083) { return fail("adcs w3, w4, w5") }
	if !lsdpWordIs(a, 2, 0xDA0800E6) { return fail("sbc x6, x7, x8") }
	if !lsdpWordIs(a, 3, 0x7A0B0149) { return fail("sbcs w9, w10, w11") }
	return ""
}

// LogicalImm: each LG_* op, both widths, register 31 as SP (AND/ORR/EOR Rd) or
// the zero register (Rn, and ANDS Rd), and 32-bit values given with an all-ones
// upper half (0xFFFFFFFFFFFFFF00 = `#0xffffff00`, which clang also accepts written
// as `#-256`).
func TestLogicalImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LogicalImm(a, LG_AND, true, X0, X1, 0xFF) // and x0, x1, #0xff
	LogicalImm(a, LG_ORR, false, X2, XZR, 0x55555555) // orr w2, wzr, #0x55555555
	LogicalImm(a, LG_EOR, true, SP, X3, 1) // eor sp, x3, #0x1
	LogicalImm(a, LG_AND, true, SP, X4, 0xFFFFFFFFFFFFFFF0) // and sp, x4, #0xfffffffffffffff0
	LogicalImm(a, LG_ANDS, true, X5, X6, 1) // ands x5, x6, #0x1
	LogicalImm(a, LG_AND, false, X7, X8, 0xFFFFFFFFFFFFFF00) // and w7, w8, #0xffffff00
	LogicalImm(a, LG_ORR, true, X9, X10, 0x00FF00FF00FF00FF) // orr x9, x10, #0x00ff00ff00ff00ff
	LogicalImm(a, LG_EOR, false, X11, X12, 0xFFFFFFFF80000001) // eor w11, w12, #0x80000001
	LogicalImm(a, LG_ANDS, false, XZR, X13, 0xFFFFFFFE) // ands wzr, w13, #0xfffffffe
	LogicalImm(a, LG_AND, true, X0, X1, 0xFFFFFFFF) // and x0, x1, #0xffffffff
	if !lsdpClean(a, 10) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x92401C20) { return fail("and x0, x1, #0xff") }
	if !lsdpWordIs(a, 1, 0x3200F3E2) { return fail("orr w2, wzr, #0x55555555") }
	if !lsdpWordIs(a, 2, 0xD240007F) { return fail("eor sp, x3, #0x1") }
	if !lsdpWordIs(a, 3, 0x927CEC9F) { return fail("and sp, x4, #0xfffffffffffffff0") }
	if !lsdpWordIs(a, 4, 0xF24000C5) { return fail("ands x5, x6, #0x1") }
	if !lsdpWordIs(a, 5, 0x12185D07) { return fail("and w7, w8, #0xffffff00 (sign-extended)") }
	if !lsdpWordIs(a, 6, 0xB2009D49) { return fail("orr x9, x10, #0x00ff00ff00ff00ff") }
	if !lsdpWordIs(a, 7, 0x5201058B) { return fail("eor w11, w12, #0x80000001 (sign-extended)") }
	if !lsdpWordIs(a, 8, 0x721F79BF) { return fail("ands wzr, w13, #0xfffffffe") }
	if !lsdpWordIs(a, 9, 0x92407C20) { return fail("and x0, x1, #0xffffffff") }
	return ""
}

// IsLogicalImm matches clang's accept/reject on each of these values for each
// width: 0 and all-ones never are; a W value's upper half must be all zero or all
// one (clang's rule — bit 31 need not match: 0xFFFFFFFF7FFFFFFE is `#0x7ffffffe`),
// and its low half is not all-ones.
func TestIsLogicalImm() testing.TestResult {
	if !IsLogicalImm(0xFF, true) || !IsLogicalImm(0xFF, false) { return fail("0xff") }
	if !IsLogicalImm(0x5555555555555555, true) { return fail("0x5555... X") }
	if !IsLogicalImm(0x00FF00FF, false) { return fail("0x00ff00ff W") }
	if !IsLogicalImm(0xFFFFFFFF, true) { return fail("0xffffffff is 32 ones in an X") }
	if !IsLogicalImm(0xFFFFFFFFFFFFFF00, true) { return fail("0xffffffffffffff00 X") }
	if !IsLogicalImm(0xFFFFFFFFFFFFFF00, false) { return fail("sign-extended 0xffffff00 W") }
	if !IsLogicalImm(0xFFFFFFFF80000001, false) { return fail("sign-extended 0x80000001 W") }
	if !IsLogicalImm(0xFFFFFFFF7FFFFFFE, false) { return fail("all-ones upper half, bit 31 clear W") }
	if !IsLogicalImm(0xFFFFFFFF0000000F, false) { return fail("all-ones upper half, 0xf W") }
	if IsLogicalImm(0, true) || IsLogicalImm(0, false) { return fail("0 is never a bitmask") }
	if IsLogicalImm(0xFFFFFFFFFFFFFFFF, true) { return fail("all-ones X") }
	if IsLogicalImm(0xFFFFFFFF, false) { return fail("all-ones W") }
	if IsLogicalImm(0xFFFFFFFFFFFFFFFF, false) { return fail("sign-extended all-ones W") }
	if IsLogicalImm(0x1234, true) || IsLogicalImm(0x1234, false) { return fail("0x1234") }
	if IsLogicalImm(0x100000000, false) { return fail("bit 32 set is not a W value") }
	if IsLogicalImm(0x00000001FFFFFFFE, false) { return fail("upper word 1 is not a W value") }
	if IsLogicalImm(0xFFFFFFFF00000000, false) { return fail("low word 0 W") }
	return ""
}

// LogicalShifted: each base op, each op | LG_NOT (BIC / ORN / EON / BICS), every
// shift including ROR (valid here, unlike add/sub), the width's maximum amount,
// and the MVN form (ORN with XZR as Rn).
func TestLogicalShifted() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LogicalShifted(a, LG_AND, true, X0, X1, X2, ROR, 63) // and x0, x1, x2, ror #63
	LogicalShifted(a, LG_AND | LG_NOT, false, X3, X4, X5, LSL, 31) // bic w3, w4, w5, lsl #31
	LogicalShifted(a, LG_ORR, true, X6, X7, X8, LSR, 1) // orr x6, x7, x8, lsr #1
	LogicalShifted(a, LG_ORR | LG_NOT, false, X9, X10, X11, ASR, 2) // orn w9, w10, w11, asr #2
	LogicalShifted(a, LG_EOR, true, X12, X13, X14, LSL, 0) // eor x12, x13, x14
	LogicalShifted(a, LG_EOR | LG_NOT, false, X15, X16, X17, ROR, 31) // eon w15, w16, w17, ror #31
	LogicalShifted(a, LG_ANDS, true, X18, X19, X20, ASR, 63) // ands x18, x19, x20, asr #63
	LogicalShifted(a, LG_ANDS | LG_NOT, false, X21, X22, X23, LSR, 16) // bics w21, w22, w23, lsr #16
	LogicalShifted(a, LG_ORR | LG_NOT, true, X0, XZR, X1, LSL, 0) // orn x0, xzr, x1 (mvn)
	if !lsdpClean(a, 9) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x8AC2FC20) { return fail("and x0, x1, x2, ror #63") }
	if !lsdpWordIs(a, 1, 0x0A257C83) { return fail("bic w3, w4, w5, lsl #31") }
	if !lsdpWordIs(a, 2, 0xAA4804E6) { return fail("orr x6, x7, x8, lsr #1") }
	if !lsdpWordIs(a, 3, 0x2AAB0949) { return fail("orn w9, w10, w11, asr #2") }
	if !lsdpWordIs(a, 4, 0xCA0E01AC) { return fail("eor x12, x13, x14") }
	if !lsdpWordIs(a, 5, 0x4AF17E0F) { return fail("eon w15, w16, w17, ror #31") }
	if !lsdpWordIs(a, 6, 0xEA94FE72) { return fail("ands x18, x19, x20, asr #63") }
	if !lsdpWordIs(a, 7, 0x6A7742D5) { return fail("bics w21, w22, w23, lsr #16") }
	if !lsdpWordIs(a, 8, 0xAA2103E0) { return fail("orn x0, xzr, x1") }
	return ""
}

// MoveWide: MOVZ / MOVN / MOVK, both widths, every legal shift (0/16 for W,
// up to 48 for X) and the imm16 extremes.
func TestMoveWide() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MoveWide(a, MW_MOVZ, true, X0, 0xFFFF, 48) // movz x0, #0xffff, lsl #48
	MoveWide(a, MW_MOVN, false, X1, 0, 16) // movn w1, #0, lsl #16
	MoveWide(a, MW_MOVK, true, X2, 0x1234, 32) // movk x2, #0x1234, lsl #32
	MoveWide(a, MW_MOVZ, false, X3, 1, 0) // movz w3, #1
	MoveWide(a, MW_MOVK, false, X4, 0xABCD, 16) // movk w4, #0xabcd, lsl #16
	MoveWide(a, MW_MOVN, true, X5, 0x8000, 0) // movn x5, #0x8000
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xD2FFFFE0) { return fail("movz x0, #0xffff, lsl #48") }
	if !lsdpWordIs(a, 1, 0x12A00001) { return fail("movn w1, #0, lsl #16") }
	if !lsdpWordIs(a, 2, 0xF2C24682) { return fail("movk x2, #0x1234, lsl #32") }
	if !lsdpWordIs(a, 3, 0x52800023) { return fail("movz w3, #1") }
	if !lsdpWordIs(a, 4, 0x72B579A4) { return fail("movk w4, #0xabcd, lsl #16") }
	if !lsdpWordIs(a, 5, 0x92900005) { return fail("movn x5, #0x8000") }
	return ""
}
