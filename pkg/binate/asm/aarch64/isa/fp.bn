package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the scalar floating-point data-processing instructions: one-
// source (FMOV, FABS, FNEG, FSQRT, the FRINT* roundings, FCVT, BFCVT), two-source
// (FMUL … FNMUL), three-source (FMADD / FMSUB / FNMADD / FNMSUB), compare (FCMP /
// FCMPE, against a register or zero), conditional compare (FCCMP / FCCMPE) and
// conditional select (FCSEL).  Registers are FP registers 0..31; the precision is an
// FT_* type (half, single or double).

// fpTypeValid reports whether ftype is one of FT_H / FT_S / FT_D.
func fpTypeValid(ftype int) bool {
	return ftype == FT_S || ftype == FT_D || ftype == FT_H
}

// fpRegs packs the FP type (bits 23:22), Rn and Rd into an instruction word.
func fpRegs(inst uint32, ftype int, rn int, rd int) uint32 {
	return inst | (cast(uint32, ftype) << 22) | (cast(uint32, rn) << 5) | cast(uint32, rd)
}

// FPDataProc1 emits a one-source FP1_* operation `Fd, Fn` at precision ftype.  The
// FRINT32 / FRINT64 roundings exist only for single and double.  (Precision
// conversions are FPConvert.)
func FPDataProc1(a @asm.Assembler, op int, ftype int, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	if !fpTypeValid(ftype) {
		a.SetError("fp: invalid precision")
		return
	}
	// Opcodes 4..7 are the precision conversions (FPConvert / BFConvert) and 13 is
	// unallocated.
	var valid bool = (op >= FP1_FMOV && op <= FP1_FSQRT) || (op >= FP1_FRINTN && op <= FP1_FRINTA) ||
			op == FP1_FRINTX || op == FP1_FRINTI || (op >= FP1_FRINT32Z && op <= FP1_FRINT64X)
	if !valid {
		a.SetError("fp: invalid one-source operation")
		return
	}
	if op >= FP1_FRINT32Z && ftype == FT_H {
		a.SetError("frint32/frint64: single or double precision only")
		return
	}
	emit32(a, fpRegs(0x1E204000 | (cast(uint32, op) << 15), ftype, rn, rd))
}

// FPConvert emits FCVT `Fd, Fn` from precision from to precision to (different FT_*
// types).
func FPConvert(a @asm.Assembler, to int, from int, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	if !fpTypeValid(to) || !fpTypeValid(from) || to == from {
		a.SetError("fcvt: the two precisions must be different half / single / double types")
		return
	}
	emit32(a, fpRegs(0x1E224000 | (cast(uint32, to) << 15), from, rn, rd))
}

// BFConvert emits BFCVT `Hd, Sn`: single precision to BFloat16.  (Its ftype field is
// 01 and its opcode 000110 — fixed bits, not a precision choice.)
func BFConvert(a @asm.Assembler, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	emit32(a, 0x1E634000 | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FPDataProc2 emits a two-source FP2_* operation `Fd, Fn, Fm` at precision ftype.
func FPDataProc2(a @asm.Assembler, op int, ftype int, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if !fpTypeValid(ftype) || op < FP2_FMUL || op > FP2_FNMUL {
		a.SetError("fp: invalid two-source operation or precision")
		return
	}
	emit32(a, fpRegs(0x1E200800 | (cast(uint32, rm) << 16) | (cast(uint32, op) << 12), ftype, rn, rd))
}

// FPDataProc3 emits FMADD / FMSUB / FNMADD / FNMSUB (an FP3_* op) `Fd, Fn, Fm, Fa` at
// precision ftype.
func FPDataProc3(a @asm.Assembler, op int, ftype int, rd int, rn int, rm int, ra int) {
	if !regsOk(a, rd, rn, rm, ra) { return }
	if !fpTypeValid(ftype) || op < FP3_FMADD || op > FP3_FNMSUB {
		a.SetError("fp: invalid three-source operation or precision")
		return
	}
	var inst uint32 = 0x1F000000 | (cast(uint32, op >> 1) << 21) | (cast(uint32, op & 1) << 15)
	inst = inst | (cast(uint32, rm) << 16) | (cast(uint32, ra) << 10)
	emit32(a, fpRegs(inst, ftype, rn, rd))
}

// FPCompare emits FCMP (or FCMPE, signaling) `Fn, Fm`, or `Fn, #0.0` (withZero; rm
// must then be 0), at precision ftype.
func FPCompare(a @asm.Assembler, signaling bool, ftype int, rn int, rm int, withZero bool) {
	if !regsOk(a, rn, rm, 0, 0) { return }
	if !fpTypeValid(ftype) {
		a.SetError("fcmp: invalid precision")
		return
	}
	if withZero && rm != 0 {
		a.SetError("fcmp: the compare-with-zero form takes no Rm")
		return
	}
	var opc uint32 = 0
	if withZero { opc = 0x08 }
	if signaling { opc = opc | 0x10 }
	emit32(a, fpRegs(0x1E202000 | (cast(uint32, rm) << 16), ftype, rn, cast(int, opc)))
}

// FPCondCompare emits FCCMP (or FCCMPE, signaling) `Fn, Fm, #nzcv, cond` at precision
// ftype: compare if cond holds, else set NZCV to nzcv (0..15).
func FPCondCompare(a @asm.Assembler, signaling bool, ftype int, rn int, rm int, nzcv int,
		cond int) {
	if !regsOk(a, rn, rm, 0, 0) { return }
	if !fpTypeValid(ftype) || nzcv < 0 || nzcv > 15 || cond < 0 || cond > 15 {
		a.SetError("fccmp: invalid precision, nzcv or condition")
		return
	}
	var inst uint32 = 0x1E200400 | (cast(uint32, rm) << 16) | (cast(uint32, cond) << 12)
	if signaling { inst = inst | 0x10 }
	emit32(a, fpRegs(inst, ftype, rn, nzcv))
}

// FPCondSelect emits FCSEL `Fd, Fn, Fm, cond` at precision ftype.
func FPCondSelect(a @asm.Assembler, ftype int, rd int, rn int, rm int, cond int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if !fpTypeValid(ftype) || cond < 0 || cond > 15 {
		a.SetError("fcsel: invalid precision or condition")
		return
	}
	emit32(a,
			fpRegs(0x1E200C00 | (cast(uint32, rm) << 16) | (cast(uint32, cond) << 12), ftype, rn, rd))
}
