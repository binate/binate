package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the scalar conversions and moves between integer and floating-
// point values: FMOV between the general-purpose and FP register files and FMOV's
// 8-bit floating-point immediate; FCVT* / SCVTF / UCVTF with the integer in a general-
// purpose register (plain and fixed-point) or, of a different size, in an FP register
// (FEAT_FPRCVT); and FJCVTZS.  A general-purpose operand is zero-or-register (31 =
// WZR / XZR).

// FMovGP emits FMOV between a general-purpose and an FP register of precision ftype:
// toFP moves the GP register Rn into Fd, otherwise Fn into the GP register Rd.  sf
// selects an X (else W) GP register.  The pairs are W with S, X with D, and W or X
// with H; any other is an error.
func FMovGP(a @asm.Assembler, toFP bool, sf bool, ftype int, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	if !((ftype == FT_S && !sf) || (ftype == FT_D && sf) || ftype == FT_H) {
		a.SetError("fmov: the general-purpose register must be W for S, X for D, or W / X for H")
		return
	}
	var inst uint32 = 0x1E260000 | (cast(uint32, ftype) << 22)
	if sf { inst = inst | 0x80000000 }
	if toFP { inst = inst | 0x00010000 }
	emit32(a, inst | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FMovImm emits FMOV `Fd, #imm` at precision ftype from the 8-bit floating-point
// immediate imm8 (0..255, the value ±(16 + imm8[3:0]) / 16 × 2^e, e from imm8[6:4]).
func FMovImm(a @asm.Assembler, ftype int, rd int, imm8 int) {
	if !regsOk(a, rd, 0, 0, 0) { return }
	if !fpTypeValid(ftype) || imm8 < 0 || imm8 > 255 {
		a.SetError("fmov: invalid precision or 8-bit immediate")
		return
	}
	emit32(a, fpRegs(0x1E201000 | (cast(uint32, imm8) << 13), ftype, 0, rd))
}

// FMovTopHalf emits FMOV between an X register and the upper 64 bits (element D[1]) of
// a vector register: toFP moves Xn into Vd.D[1], otherwise Vn.D[1] into Xd.
func FMovTopHalf(a @asm.Assembler, toFP bool, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	var inst uint32 = 0x9EAE0000
	if toFP { inst = inst | 0x00010000 }
	emit32(a, inst | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// fpIntOpValid reports whether op is one of the FI_* conversions.
func fpIntOpValid(op int) bool {
	return op == FI_FCVTNS || op == FI_FCVTNU || op == FI_SCVTF || op == FI_UCVTF || op == FI_FCVTAS ||
			op == FI_FCVTAU || op == FI_FCVTPS || op == FI_FCVTPU || op == FI_FCVTMS || op == FI_FCVTMU ||
			op == FI_FCVTZS || op == FI_FCVTZU
}

// FPIntConvert emits an FI_* conversion between precision ftype and a W or X (sf)
// general-purpose register: FCVT* `Rd, Fn` (FP to integer) or SCVTF / UCVTF `Fd, Rn`
// (integer to FP).  The general-purpose register is zero-or-register.
func FPIntConvert(a @asm.Assembler, op int, sf bool, ftype int, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	if !fpIntOpValid(op) || !fpTypeValid(ftype) {
		a.SetError("fp/int conversion: invalid operation or precision")
		return
	}
	var inst uint32 = 0x1E200000 | (cast(uint32, op) << 16) | (cast(uint32, ftype) << 22)
	if sf { inst = inst | 0x80000000 }
	emit32(a, inst | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FPFixedConvert emits the fixed-point FCVTZS / FCVTZU `Rd, Fn, #fbits` or SCVTF /
// UCVTF `Fd, Rn, #fbits` (an FI_* op among those four): the integer has fbits
// fraction bits, 1..32 for a W register, 1..64 for X (sf).
func FPFixedConvert(a @asm.Assembler, op int, sf bool, ftype int, rd int, rn int, fbits int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	if (op != FI_FCVTZS && op != FI_FCVTZU && op != FI_SCVTF && op != FI_UCVTF) ||
			!fpTypeValid(ftype) {
		a.SetError("fixed-point conversion: invalid operation or precision")
		return
	}
	var maxBits int = 32
	if sf { maxBits = 64 }
	if fbits < 1 || fbits > maxBits {
		a.SetError("fixed-point conversion: fraction bits must be 1..32 (W) or 1..64 (X)")
		return
	}
	var inst uint32 = 0x1E000000 | (cast(uint32, op) << 16) | (cast(uint32, ftype) << 22)
	inst = inst | (cast(uint32, 64 - fbits) << 10)
	if sf { inst = inst | 0x80000000 }
	emit32(a, inst | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FJCvtZS emits FJCVTZS `Wd, Dn`: double to a 32-bit signed integer with JavaScript
// semantics (round toward zero, modulo 2^32).  Wd is zero-or-register.
func FJCvtZS(a @asm.Assembler, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	emit32(a, 0x1E7E0000 | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FPRegIntConvert emits an FR_* conversion whose integer is held in an FP register of a
// different size from the FP value (FEAT_FPRCVT): FCVT* `Sd|Dd, Hn|Sn|Dn` or SCVTF /
// UCVTF `Hd|Sd|Dd, Sn|Dn`.  sf selects a 64-bit integer (a D register; else 32-bit, an S
// register) and ftype the FP precision; the same-size pairs (S with S, D with D) are
// the Advanced SIMD scalar instructions, not this form, and are an error here.
func FPRegIntConvert(a @asm.Assembler, op int, sf bool, ftype int, rd int, rn int) {
	if !regsOk(a, rd, rn, 0, 0) { return }
	var valid bool = op == FR_FCVTNS || op == FR_FCVTNU || op == FR_FCVTPS || op == FR_FCVTPU ||
			op == FR_FCVTMS || op == FR_FCVTMU || op == FR_FCVTZS || op == FR_FCVTZU || op == FR_FCVTAS ||
			op == FR_FCVTAU || op == FR_SCVTF || op == FR_UCVTF
	if !valid || !fpTypeValid(ftype) {
		a.SetError("fp/int conversion (FP register): invalid operation or precision")
		return
	}
	if (!sf && ftype == FT_S) || (sf && ftype == FT_D) {
		a.SetError("fp/int conversion (FP register): the integer and FP value must differ in size")
		return
	}
	var inst uint32 = 0x1E200000 | (cast(uint32, op) << 16) | (cast(uint32, ftype) << 22)
	if sf { inst = inst | 0x80000000 }
	emit32(a, inst | (cast(uint32, rn) << 5) | cast(uint32, rd))
}
