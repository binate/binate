package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The GP <-> FP move and FMOV-immediate encoders' own checks (the text assembler's
// golden tables cover their encodings).  (lsdpRejected / lsdpClean / lsdpWordIs are in
// ldst_test.bn.)

func TestFMovGPAndImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FMovGP(a, true, true, FT_H, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EE70020) { return fail("fmov h0, x1") }
	a = newAsm()
	FMovGP(a, false, false, FT_D, 0, 1)
	if !lsdpRejected(a) { return fail("fmov w0, d1") }
	a = newAsm()
	FMovGP(a, true, true, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("fmov s0, x1") }
	a = newAsm()
	FMovImm(a, FT_D, 0, 0x70)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x1E6E1000) { return fail("fmov d0, #1.0") }
	a = newAsm()
	FMovImm(a, FT_S, 0, 256)
	if !lsdpRejected(a) { return fail("imm8 256") }
	a = newAsm()
	FMovImm(a, 2, 0, 0)
	if !lsdpRejected(a) { return fail("ftype 2") }
	a = newAsm()
	FMovTopHalf(a, false, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EAE0020) { return fail("fmov x0, v1.d[1]") }
	a = newAsm()
	FMovTopHalf(a, true, 2, 3)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EAF0062) { return fail("fmov v2.d[1], x3") }
	return ""
}
