package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The conversion and move encoders' own checks (the text assembler's golden tables
// cover their encodings).  (lsdpRejected / lsdpClean / lsdpWordIs are in
// ldst_test.bn.)

func TestFMovGPAndImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FMovGP(a, true, true, FT_H, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EE70020) { return fail("fmov h0, x1") }
	a = newAsm()
	FMovGP(a, false, false, FT_D, 0, 1)
	if !lsdpRejected(a) { return fail("fmov w0, d1") }
	a = newAsm()
	FMovGP(a, true, true, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("fmov s0, x1") }
	a = newAsm()
	FMovImm(a, FT_D, 0, 0x70)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x1E6E1000) { return fail("fmov d0, #1.0") }
	a = newAsm()
	FMovImm(a, FT_S, 0, 256)
	if !lsdpRejected(a) { return fail("imm8 256") }
	a = newAsm()
	FMovImm(a, 2, 0, 0)
	if !lsdpRejected(a) { return fail("ftype 2") }
	a = newAsm()
	FMovTopHalf(a, false, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EAE0020) { return fail("fmov x0, v1.d[1]") }
	a = newAsm()
	FMovTopHalf(a, true, 2, 3)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EAF0062) { return fail("fmov v2.d[1], x3") }
	return ""
}

func TestFPIntConvertChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPIntConvert(a, FI_FCVTMU, true, FT_H, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9EF10020) { return fail("fcvtmu x0, h1") }
	a = newAsm()
	FPIntConvert(a, 0x06, false, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("opcode 6 (FMOV) through FPIntConvert") }
	a = newAsm()
	FPFixedConvert(a, FI_SCVTF, false, FT_S, 0, 1, 33)
	if !lsdpRejected(a) { return fail("scvtf from W with 33 fraction bits") }
	a = newAsm()
	FPFixedConvert(a, FI_FCVTZU, true, FT_D, 0, 1, 64)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9E590020) { return fail("fcvtzu x0, d1, #64") }
	a = newAsm()
	FPFixedConvert(a, FI_FCVTNS, false, FT_S, 0, 1, 1)
	if !lsdpRejected(a) { return fail("a fixed-point FCVTNS") }
	a = newAsm()
	FJCvtZS(a, 0, 32)
	if !lsdpRejected(a) { return fail("fjcvtzs register 32") }
	return ""
}

func TestFPRegIntConvertChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPRegIntConvert(a, FR_SCVTF, true, FT_S, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x9E3C0020) { return fail("scvtf s0, d1") }
	a = newAsm()
	FPRegIntConvert(a, FR_FCVTZS, false, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("a same-size (S, S) conversion") }
	a = newAsm()
	FPRegIntConvert(a, FR_FCVTZS, true, FT_D, 0, 1)
	if !lsdpRejected(a) { return fail("a same-size (D, D) conversion") }
	a = newAsm()
	FPRegIntConvert(a, FI_FCVTZS, false, FT_D, 0, 1)
	if !lsdpRejected(a) { return fail("a general-register op code") }
	a = newAsm()
	FPIntConvert(a, FI_FCVTZS, false, 2, 0, 1)
	if !lsdpRejected(a) { return fail("ftype 2") }
	a = newAsm()
	FPFixedConvert(a, FI_SCVTF, true, FT_S, 0, 1, 65)
	if !lsdpRejected(a) { return fail("scvtf from X with 65 fraction bits") }
	return ""
}
