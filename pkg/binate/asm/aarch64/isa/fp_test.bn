package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The scalar FP encoders' own checks (the text assembler's golden tables cover their
// encodings).  (lsdpRejected / lsdpClean / lsdpWordIs are in ldst_test.bn.)

func TestFPDataProcChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPDataProc1(a, FP1_FRINT64X, FT_D, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x1E69C020) { return fail("frint64x d0, d1") }
	a = newAsm()
	FPDataProc1(a, FP1_FRINT32Z, FT_H, 0, 1)
	if !lsdpRejected(a) { return fail("frint32z on half precision") }
	a = newAsm()
	FPDataProc1(a, 13, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("unallocated opcode 13") }
	a = newAsm()
	FPDataProc1(a, 4, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("a conversion opcode through FPDataProc1") }
	a = newAsm()
	FPDataProc1(a, FP1_FABS, 2, 0, 1)
	if !lsdpRejected(a) { return fail("ftype 2") }
	a = newAsm()
	FPConvert(a, FT_S, FT_S, 0, 1)
	if !lsdpRejected(a) { return fail("fcvt to the same precision") }
	a = newAsm()
	FPDataProc2(a, 9, FT_S, 0, 1, 2)
	if !lsdpRejected(a) { return fail("two-source opcode 9") }
	a = newAsm()
	FPDataProc3(a, FP3_FNMSUB, FT_H, 0, 1, 2, 32)
	if !lsdpRejected(a) { return fail("register 32") }
	return ""
}

func TestFPCompareSelectChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPCompare(a, true, FT_H, 0, 0, true)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x1EE02018) { return fail("fcmpe h0, #0.0") }
	a = newAsm()
	FPCompare(a, false, FT_S, 0, 1, true)
	if !lsdpRejected(a) { return fail("compare-with-zero with Rm != 0") }
	a = newAsm()
	FPCondCompare(a, false, FT_S, 0, 1, 16, 0)
	if !lsdpRejected(a) { return fail("nzcv 16") }
	a = newAsm()
	FPCondSelect(a, FT_D, 0, 1, 2, 16)
	if !lsdpRejected(a) { return fail("condition 16") }
	a = newAsm()
	BFConvert(a, 0, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x1E634020) { return fail("bfcvt h0, s1") }
	return ""
}
