package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// The GOT-slot transfers: `:got_lo12:` / `:gotpage_lo15:` on an 8-byte load / store, and
// the `:got:` literal load.

// GotSlotTransferOk reports whether spec is an 8-byte transfer; see isa.bni.
func GotSlotTransferOk(spec uint32) bool {
	return spec == LS_LDR_X || spec == LS_STR_X || spec == LS_LDR_D || spec == LS_STR_D ||
			spec == LS_PRFM
}

// ldStGotSlot emits `<op> Rt, [Rn, #0]` with a GOT-slot fixup of kind; see LdStGotLo12.
func ldStGotSlot(a @asm.Assembler, spec uint32, rt int, rn int, label *[]readonly char, kind int) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	if !GotSlotTransferOk(spec) {
		a.SetError("load/store: a GOT slot's page offset needs an 8-byte transfer (X or D, or PRFM)")
		return
	}
	a.AddFixup(label, kind, 0, 4)
	Emit32(a, ldstRegs(0x39000000 | spec, rn, rt))
}

// LdStGotLo12 emits a transfer of a GOT slot at its page offset; see isa.bni.
func LdStGotLo12(a @asm.Assembler, spec uint32, rt int, rn int, label *[]readonly char) {
	ldStGotSlot(a, spec, rt, rn, label, FIX_LD_GOT_LO12)
}

// LdStGotPageLo15 emits a transfer of a GOT slot at its offset from the GOT's page; see
// isa.bni.
func LdStGotPageLo15(a @asm.Assembler, spec uint32, rt int, rn int, label *[]readonly char) {
	ldStGotSlot(a, spec, rt, rn, label, FIX_LD_GOTPAGE_LO15)
}

// LdStLiteralGot emits a literal load of a GOT slot; see isa.bni.
func LdStLiteralGot(a @asm.Assembler, spec uint32, rt int, label *[]readonly char) {
	if !RegsOk(a, rt, 0, 0, 0) { return }
	opc, ok := ldstLiteralOpc(spec)
	if !ok {
		a.SetError("load/store: no PC-relative literal form for this transfer")
		return
	}
	a.AddFixup(label, FIX_LD_GOT_PREL19, 0, 4)
	Emit32(a, 0x18000000 | opc | (spec & 0x04000000) | cast(uint32, rt))
}
