package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The GOT-slot transfers against clang's words: `:got_lo12:` / `:gotpage_lo15:` on the
// 8-byte transfers, the `:got:` literal load on every literal form; any other transfer is
// an error that emits nothing.  (ctlWord / ctlClean / ctlRejected / ctlFixupIs are in
// ctrl_test.bn.)

// clang: `ldr x0, [x1, :got_lo12:sym]` F9400020, `str x2, [x3, …]` F9000062, `ldr d4, [x5,
// …]` FD4000A4, `str d6, [sp, …]` FD0003E6, `prfm pldl1keep, [x7, …]` F98000E0; the same
// words for `:gotpage_lo15:`.
func TestLdStGotSlot() testing.TestResult {
	var specs @[]uint32 = make_slice(uint32, 5)
	specs[0] = LS_LDR_X
	specs[1] = LS_STR_X
	specs[2] = LS_LDR_D
	specs[3] = LS_STR_D
	specs[4] = LS_PRFM
	var want @[]uint32 = make_slice(uint32, 5)
	want[0] = 0xF9400020
	want[1] = 0xF9000062
	want[2] = 0xFD4000A4
	want[3] = 0xFD0003E6
	want[4] = 0xF98000E0
	for k := 0; k < 2; k++ {
		var a @asm.Assembler = newAsm()
		for i := 0; i < 5; i++ {
			var rt int = 2 * i
			var rn int = 2 * i + 1
			if i == 3 { rn = 31 }
			if i == 4 {
				rt = 0
				rn = 7
			}
			if k == 0 {
				LdStGotLo12(a, specs[i], rt, rn, "sym")
			} else {
				LdStGotPageLo15(a, specs[i], rt, rn, "sym")
			}
		}
		if !ctlClean(a, 5) { return fail("a GOT-slot transfer rejected") }
		var kind int = FIX_LD_GOT_LO12
		if k == 1 { kind = FIX_LD_GOTPAGE_LO15 }
		for i := 0; i < 5; i++ {
			if ctlWord(a, i) != want[i] { return fail("a GOT-slot transfer encoded wrongly") }
			if !ctlFixupIs(a, i, 4 * i, kind, "sym", 0) { return fail("a GOT-slot fixup wrong") }
		}
	}
	var b @asm.Assembler = newAsm()
	LdGotLo12(b, 0, 1, "sym")
	if !ctlClean(b, 1) || ctlWord(b, 0) != 0xF9400020 ||
			!ctlFixupIs(b, 0, 0, FIX_LD_GOT_LO12, "sym", 0) {
		return fail("LdGotLo12 is not LdStGotLo12 of LS_LDR_X")
	}
	return ""
}

// A 4-, 2-, 1- or 16-byte transfer of a GOT slot is an error, and so is a register
// number out of range.
func TestLdStGotSlotRejects() testing.TestResult {
	var bad @[]uint32 = make_slice(uint32, 7)
	bad[0] = LS_LDR_W
	bad[1] = LS_LDRB
	bad[2] = LS_LDR_Q
	bad[3] = LS_LDRSW
	bad[4] = LS_LDRH
	bad[5] = LS_STR_W
	bad[6] = LS_STR_Q
	for i := 0; i < 7; i++ {
		var a @asm.Assembler = newAsm()
		LdStGotLo12(a, bad[i], 0, 1, "sym")
		if !ctlRejected(a) { return fail("a non-8-byte GOT page-offset transfer accepted") }
		var c @asm.Assembler = newAsm()
		LdStGotPageLo15(c, bad[i], 0, 1, "sym")
		if !ctlRejected(c) { return fail("a non-8-byte GOT page-offset transfer accepted (lo15)") }
	}
	var r @asm.Assembler = newAsm()
	LdStGotLo12(r, LS_LDR_X, 32, 1, "sym")
	if !ctlRejected(r) { return fail("Rt 32 accepted") }
	var r2 @asm.Assembler = newAsm()
	LdStLiteralGot(r2, LS_LDR_X, -1, "sym")
	if !ctlRejected(r2) { return fail("Rt -1 accepted") }
	if !GotSlotTransferOk(LS_PRFM) || GotSlotTransferOk(LS_LDR_W) {
		return fail("GotSlotTransferOk wrong")
	}
	return ""
}

// clang: `ldr x0, :got:sym` 58000000, `ldr w1` 18000001, `ldr s2` 1C000002, `ldr d3`
// 5C000003, `ldr q4` 9C000004, `ldrsw x5` 98000005, `prfm pldl1keep` D8000000; a store
// has no literal form.
func TestLdStLiteralGot() testing.TestResult {
	var specs @[]uint32 = make_slice(uint32, 7)
	specs[0] = LS_LDR_X
	specs[1] = LS_LDR_W
	specs[2] = LS_LDR_S
	specs[3] = LS_LDR_D
	specs[4] = LS_LDR_Q
	specs[5] = LS_LDRSW
	specs[6] = LS_PRFM
	var want @[]uint32 = make_slice(uint32, 7)
	want[0] = 0x58000000
	want[1] = 0x18000001
	want[2] = 0x1C000002
	want[3] = 0x5C000003
	want[4] = 0x9C000004
	want[5] = 0x98000005
	want[6] = 0xD8000000
	var a @asm.Assembler = newAsm()
	for i := 0; i < 7; i++ {
		var rt int = i
		if i == 6 { rt = 0 }
		LdStLiteralGot(a, specs[i], rt, "sym")
	}
	if !ctlClean(a, 7) { return fail("a GOT literal load rejected") }
	for i := 0; i < 7; i++ {
		if ctlWord(a, i) != want[i] { return fail("a GOT literal load encoded wrongly") }
		if !ctlFixupIs(a, i, 4 * i, FIX_LD_GOT_PREL19, "sym", 0) {
			return fail("a GOT literal fixup wrong")
		}
	}
	var b @asm.Assembler = newAsm()
	LdStLiteralGot(b, LS_STR_X, 0, "sym")
	if !ctlRejected(b) { return fail("a GOT literal store accepted") }
	return ""
}
