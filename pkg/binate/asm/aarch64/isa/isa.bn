package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// emit32 appends one little-endian instruction word to the current section.
func emit32(a @asm.Assembler, inst uint32) {
	a.EmitUint32(inst)
}

// regsOk reports whether r0..r3 are all architectural register numbers (0..31),
// setting the assembler error otherwise.  Every exact encoder checks its register
// operands with it (an unused slot passes 0) instead of masking a number into the
// 5-bit field, where a caller's register of another class (a D/V register numbered
// 32..63, say) would silently become a different register.
func regsOk(a @asm.Assembler, r0 int, r1 int, r2 int, r3 int) bool {
	if r0 < 0 || r0 > 31 || r1 < 0 || r1 > 31 || r2 < 0 || r2 > 31 || r3 < 0 || r3 > 31 {
		a.SetError("register number out of range [0, 31]")
		return false
	}
	return true
}

// allOnes64 returns 0xFFFFFFFFFFFFFFFF (all bits set).
func allOnes64() uint64 {
	return 0xFFFFFFFFFFFFFFFF
}

// popcount64 returns the number of set bits in v.
func popcount64(v uint64) int {
	var count int = 0
	for v != 0 {
		count = count + cast(int, v & 1)
		v = v >> 1
	}
	return count
}

// ror64 rotates v right by r bits (64-bit). r must be in [0, 64].
func ror64(v uint64, r int) uint64 {
	if r == 0 || r == 64 {
		return v
	}
	var ru uint64 = cast(uint64, r)
	return (v >> ru) | (v << (64 - ru))
}

// BitmaskResult holds the result of bitmask immediate encoding.
type BitmaskResult struct {
	Ok   bool
	N    int
	Immr int
	Imms int
}

// encodeBitmaskImm tries to encode a value as an AArch64 logical immediate.
// is64 indicates 64-bit (sf=1) operation. For 32-bit, only the low 32 bits matter.
func encodeBitmaskImm(value uint64, is64 bool) BitmaskResult {
	var fail BitmaskResult

	if value == 0 {
		return fail
	}

	if !is64 {
		value = value & 0xFFFFFFFF
		if value == 0 || value == 0xFFFFFFFF {
			return fail
		}
		value = value | (value << 32)
	} else {
		if value == allOnes64() {
			return fail
		}
	}

	// Find smallest repeating element size
	var size int = 64
	for size > 2 {
		var half int = size / 2
		if ror64(value, half) == value {
			size = half
		} else {
			break
		}
	}

	// Extract one element
	var elemMask uint64 = 0
	if size == 64 {
		elemMask = allOnes64()
	} else {
		elemMask = (cast(uint64, 1) << cast(uint64, size)) - 1
	}
	var elem uint64 = value & elemMask

	var ones int = popcount64(elem)
	if ones == 0 || ones == size {
		return fail
	}

	// Find the start of the contiguous run of 1-bits (0→1 transition in ring)
	var start int = -1
	for i := 0; i < size; i++ {
		var nextI int = (i + 1) % size
		var bitI uint64 = (elem >> cast(uint64, i)) & 1
		var bitNext uint64 = (elem >> cast(uint64, nextI)) & 1
		if bitI == 0 && bitNext == 1 {
			start = nextI
			break
		}
	}
	if start < 0 {
		return fail
	}

	// Verify contiguous
	for i := 0; i < ones; i++ {
		var pos int = (start + i) % size
		if ((elem >> cast(uint64, pos)) & 1) == 0 {
			return fail
		}
	}
	for i := ones; i < size; i++ {
		var pos int = (start + i) % size
		if ((elem >> cast(uint64, pos)) & 1) != 0 {
			return fail
		}
	}

	var result BitmaskResult
	result.Ok = true
	result.Immr = (size - start) % size

	if size == 64 {
		result.N = 1
		result.Imms = ones - 1
	} else {
		result.N = 0
		// ~x = x XOR -1 (bootstrap may not support ~ operator)
		result.Imms = (((2 * size - 1) ^ -1) & 0x3f) | (ones - 1)
	}
	return result
}
