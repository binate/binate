package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Shared helpers for the isa package's tests, and register / condition names for
// them: a test here cannot import pkg/binate/asm/aarch64 (which imports isa), so the
// encoding numbers the tests pass are named locally.

func fail(msg @[]char) testing.TestResult { return msg }

// readInst reads the little-endian instruction word at off in section s.
func readInst(s @asm.Section, off int) uint32 {
	return cast(uint32, s.Data[off]) | (cast(uint32, s.Data[off + 1]) << 8) |
			(cast(uint32, s.Data[off + 2]) << 16) | (cast(uint32, s.Data[off + 3]) << 24)
}

// newAsm returns a 64-bit assembler positioned in a text section.
func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// General-purpose register encoding numbers (x0-x30; 31 is SP or XZR by operand).
const (
	X0 int = iota
	X1
	X2
	X3
	X4
	X5
	X6
	X7
	X8
	X9
	X10
	X11
	X12
	X13
	X14
	X15
	X16
	X17
	X18
	X19
	X20
	X21
	X22
	X23
)

// The frame / link registers and the zero register (x24-x28 are unused here).
const (
	X29 int = 29
	X30 int = 30
	XZR int = 31
)

// SP is register 31 in an SP operand position.
const SP int = 31

// Condition-code encodings used by the branch / select tests.
const (
	COND_EQ int = 0
	COND_NE int = 1
	COND_HI int = 8
	COND_LT int = 11
	COND_AL int = 14
	COND_NV int = 15
)

// allOnes64() must be exactly 0xFFFFFFFFFFFFFFFF — the bitmask encoder's all-ones
// check compares against it.  Oracle: unsigned 0-1 wraparound, independent of how
// allOnes64 builds the value.
func TestAllOnes64Value() testing.TestResult {
	if allOnes64() != cast(uint64, 0) - cast(uint64, 1) {
		return fail("allOnes64 must be 0xFFFFFFFFFFFFFFFF")
	}
	return ""
}

// Every exact encoder rejects a register number outside 0..31 — emitting nothing and
// recording no fixup — rather than masking it into the 5-bit field (a D/V register
// numbered 32..63 by a caller would otherwise silently become X0..X31).
func TestRegisterNumbersOutOfRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStUImm(a, LS_LDR_X, 37, X1, 0) // 37 = 32 + 5: must not become x5
	if !ctlRejected(a) { return fail("LdStUImm: rt 37") }
	a = newAsm()
	LdStPair(a, LSP_LDP_X, X0, X1, 32, 0, PAIR_OFFSET)
	if !ctlRejected(a) { return fail("LdStPair: rn 32") }
	a = newAsm()
	LdStLiteral(a, LS_LDR_X, -1, "lit", 0)
	if !ctlRejected(a) { return fail("LdStLiteral: rt -1 (no fixup either)") }
	a = newAsm()
	AddSubShifted(a, OPS_ADD, true, X0, X1, 33, LSL, 0)
	if !ctlRejected(a) { return fail("AddSubShifted: rm 33") }
	a = newAsm()
	MulAdd(a, false, true, X0, X1, X2, 40)
	if !ctlRejected(a) { return fail("MulAdd: ra 40") }
	a = newAsm()
	BranchReg(a, BR_BR, 63)
	if !ctlRejected(a) { return fail("BranchReg: rn 63") }
	a = newAsm()
	CompareBranchLabel(a, false, true, 32, "L", 0)
	if !ctlRejected(a) { return fail("CompareBranchLabel: rt 32 (no fixup either)") }
	return ""
}
