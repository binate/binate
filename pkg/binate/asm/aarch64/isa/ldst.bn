package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact single-instruction load/store encoders — one call emits exactly the one
// architectural instruction asked for, or sets an assembler error when the operands
// have no encoding.  They never synthesize an address into a scratch register and
// never mask an out-of-range field, so they are what the text assembler uses: a
// written load/store must assemble to precisely that instruction or be rejected.
//
// A single-register transfer is identified by its LS_* spec — the instruction's
// size[31:30], V[26] and opc[23:22] bits, shared by every addressing mode of that
// transfer (LDRB, LDR Xt, LDR Qt, …).  A pair transfer is identified by its LSP_*
// spec — opc[31:30], V[26] and L[22].

// ldstIsSimd reports whether a spec's V bit selects a SIMD&FP register transfer.
func ldstIsSimd(spec uint32) bool {
	return (spec & 0x04000000) != 0
}

// ldstSpecValid reports whether spec names an allocated single-register transfer:
// only the size/V/opc bits may be set, and the unallocated combinations — a SIMD&FP
// opc=1x other than Q (size=00), and a general-purpose size=10 or 11 with opc=11 —
// are refused.
func ldstSpecValid(spec uint32) bool {
	if (spec & 0x3B3FFFFF) != 0 { return false }
	var size int = cast(int, (spec >> 30) & 3)
	var opc int = cast(int, (spec >> 22) & 3)
	if ldstIsSimd(spec) { return opc < 2 || size == 0 }
	return !(size >= 2 && opc == 3)
}

// LdStAccessBytes returns the access size in bytes of an LS_* spec: 1 << size for a
// general-purpose or B/H/S/D transfer, 16 for a Q transfer (V=1, size=00, opc=1x).
// The unsigned-offset form's imm12 counts units of this size.
func LdStAccessBytes(spec uint32) int {
	var size int = cast(int, (spec >> 30) & 3)
	if ldstIsSimd(spec) && (spec & 0x00800000) != 0 && size == 0 { return 16 }
	if size == 0 { return 1 }
	if size == 1 { return 2 }
	if size == 2 { return 4 }
	return 8
}

// ldstRegs ORs Rn (bits 9:5) and Rt (bits 4:0) into an instruction word.
func ldstRegs(inst uint32, rn int, rt int) uint32 {
	return inst | (cast(uint32, rn) << 5) | cast(uint32, rt)
}

// ldstWritebackOk reports whether a single-register writeback form is predictable:
// a general-purpose Rt that is also the base register (other than SP, which as Rt
// would be XZR, a different register) makes the architecture's result
// CONSTRAINED UNPREDICTABLE, so it is rejected rather than encoded.
func ldstWritebackOk(spec uint32, rt int, rn int) bool {
	if ldstIsSimd(spec) { return true }
	return rt != rn || rn == 31
}

// LdStUImm emits `<op> Rt, [Rn, #offset]` in the unsigned scaled-offset form: offset
// must be a non-negative multiple of the access size with offset/size <= 4095.
func LdStUImm(a @asm.Assembler, spec uint32, rt int, rn int, offset int) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	if !ldstSpecValid(spec) {
		a.SetError("load/store: unallocated transfer spec")
		return
	}
	var scale int = LdStAccessBytes(spec)
	if offset < 0 || offset % scale != 0 || offset / scale > 4095 {
		a.SetError("load/store: offset not encodable as a scaled unsigned 12-bit immediate")
		return
	}
	Emit32(a, ldstRegs(0x39000000 | spec | (cast(uint32, offset / scale) << 10), rn, rt))
}

// LdStUnscaled emits the LDUR/STUR form `<op> Rt, [Rn, #offset]`: a signed byte
// offset in [-256, 255], no scaling, no writeback.
func LdStUnscaled(a @asm.Assembler, spec uint32, rt int, rn int, offset int) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	if !ldstSpecValid(spec) {
		a.SetError("load/store: unallocated transfer spec")
		return
	}
	if offset < -256 || offset > 255 {
		a.SetError("load/store: unscaled offset out of signed 9-bit range [-256, 255]")
		return
	}
	Emit32(a, ldstRegs(0x38000000 | spec | (cast(uint32, offset & 0x1ff) << 12), rn, rt))
}

// LdStPre emits the pre-indexed form `<op> Rt, [Rn, #offset]!` (signed 9-bit byte
// offset; Rn is updated to Rn + offset before the access).
func LdStPre(a @asm.Assembler, spec uint32, rt int, rn int, offset int) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	ldstIndexed(a, spec, rt, rn, offset, 0x00000C00)
}

// LdStPost emits the post-indexed form `<op> Rt, [Rn], #offset` (signed 9-bit byte
// offset; Rn is updated to Rn + offset after the access).
func LdStPost(a @asm.Assembler, spec uint32, rt int, rn int, offset int) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	ldstIndexed(a, spec, rt, rn, offset, 0x00000400)
}

// ldstIndexed encodes a pre-/post-indexed single-register transfer; mode is the
// index-mode field (bits 11:10 = 11 pre, 01 post) already in place.
func ldstIndexed(a @asm.Assembler, spec uint32, rt int, rn int, offset int, mode uint32) {
	if !ldstSpecValid(spec) {
		a.SetError("load/store: unallocated transfer spec")
		return
	}
	if spec == LS_PRFM {
		a.SetError("load/store: PRFM has no pre- or post-indexed form")
		return
	}
	if offset < -256 || offset > 255 {
		a.SetError("load/store: writeback offset out of signed 9-bit range [-256, 255]")
		return
	}
	if !ldstWritebackOk(spec, rt, rn) {
		a.SetError("load/store: writeback base register is also the transfer register (unpredictable)")
		return
	}
	Emit32(a, ldstRegs(0x38000000 | spec | (cast(uint32, offset & 0x1ff) << 12) | mode, rn, rt))
}

// LdStReg emits the register-offset form `<op> Rt, [Rn, Rm{, <ext> {#amount}}]`.
// ext is one of EXT_UXTW / EXT_LSL / EXT_SXTW / EXT_SXTX; scaled sets the S bit,
// which shifts the (extended) index left by log2(access size) — how `lsl #n` with
// n == log2(size) is encoded (and, for a byte access, an explicit `#0`).
func LdStReg(a @asm.Assembler, spec uint32, rt int, rn int, rm int, ext int, scaled bool) {
	if !RegsOk(a, rt, rn, rm, 0) { return }
	if !ldstSpecValid(spec) {
		a.SetError("load/store: unallocated transfer spec")
		return
	}
	if ext != EXT_UXTW && ext != EXT_LSL && ext != EXT_SXTW && ext != EXT_SXTX {
		a.SetError("load/store: invalid register-offset extend option")
		return
	}
	var inst uint32 = 0x38200800 | spec | (cast(uint32, rm) << 16) | (cast(uint32, ext) << 13)
	if scaled {
		inst = inst | 0x00001000
	}
	Emit32(a, ldstRegs(inst, rn, rt))
}

// ldstLiteralOpc returns the opc field (bits 31:30) of the PC-relative literal form
// of spec, or ok=false when the transfer has none.  Only LDR W/X/S/D/Q, LDRSW and
// PRFM have a literal form.
func ldstLiteralOpc(spec uint32) (uint32, bool) {
	if spec == LS_LDR_W || spec == LS_LDR_S { return 0, true }
	if spec == LS_LDR_X || spec == LS_LDR_D { return 0x40000000, true }
	if spec == LS_LDRSW || spec == LS_LDR_Q { return 0x80000000, true }
	if spec == LS_PRFM { return 0xC0000000, true }
	return 0, false
}

// LdStLiteral emits a PC-relative literal load `<op> Rt, label+addend` (±1MB, word-
// aligned).  Only these have a literal form: LS_LDR_W, LS_LDR_X, LS_LDRSW, LS_LDR_S,
// LS_LDR_D, LS_LDR_Q, and LS_PRFM (Rt the prefetch operation); any other spec is an
// error.
func LdStLiteral(a @asm.Assembler, spec uint32, rt int, label *[]readonly char, addend int) {
	if !RegsOk(a, rt, 0, 0, 0) { return }
	opc, ok := ldstLiteralOpc(spec)
	if !ok {
		a.SetError("load/store: no PC-relative literal form for this transfer")
		return
	}
	a.AddFixup(label, FIX_LD_PREL_LO19, addend, 4)
	Emit32(a, 0x18000000 | opc | (spec & 0x04000000) | cast(uint32, rt))
}

// LdStLiteralOffset emits the literal form with an explicit PC-relative byte offset
// instead of a label, `<op> Rt, #offset`: offset must be a multiple of 4 within
// [-2^20, 2^20 - 4] (the signed 19-bit word displacement).
func LdStLiteralOffset(a @asm.Assembler, spec uint32, rt int, offset int) {
	if !RegsOk(a, rt, 0, 0, 0) { return }
	opc, ok := ldstLiteralOpc(spec)
	if !ok {
		a.SetError("load/store: no PC-relative literal form for this transfer")
		return
	}
	if offset % 4 != 0 || offset < -1048576 || offset > 1048572 {
		a.SetError("load/store: literal offset must be a multiple of 4 within +/-1MB")
		return
	}
	var imm19 uint32 = cast(uint32, (offset / 4) & 0x7ffff)
	Emit32(a, 0x18000000 | opc | (spec & 0x04000000) | (imm19 << 5) | cast(uint32, rt))
}

// LdStLo12 emits `<op> Rt, [Rn, #:lo12:label+addend]` — the unsigned-offset form with a
// zero imm12 and a fixup that fills in the target's page offset scaled by the access size
// (the low half of an ADRP + load/store pair).  The fixup kind carries the access
// size, since the linker's patch depends on it.
func LdStLo12(a @asm.Assembler, spec uint32, rt int, rn int, label *[]readonly char, addend int) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	if !ldstSpecValid(spec) {
		a.SetError("load/store: unallocated transfer spec")
		return
	}
	var bytes int = LdStAccessBytes(spec)
	var kind int = FIX_LDR_LO12
	if bytes == 1 {
		kind = FIX_LDST8_LO12
	} else if bytes == 2 {
		kind = FIX_LDST16_LO12
	} else if bytes == 4 {
		kind = FIX_LDST32_LO12
	} else if bytes == 16 {
		kind = FIX_LDST128_LO12
	}
	a.AddFixup(label, kind, addend, 4)
	Emit32(a, ldstRegs(0x39000000 | spec, rn, rt))
}

// LdGotLo12 emits the 64-bit GOT-slot load `ldr Xt, [Xn, #:got_lo12:label]`: the
// unsigned-offset LDR X with a zero imm12 and a FIX_LD_GOT_LO12 fixup.
func LdGotLo12(a @asm.Assembler, rt int, rn int, label *[]readonly char) {
	if !RegsOk(a, rt, rn, 0, 0) { return }
	a.AddFixup(label, FIX_LD_GOT_LO12, 0, 4)
	Emit32(a, ldstRegs(0x39000000 | LS_LDR_X, rn, rt))
}

// lspScale returns the byte scale of an LSP_* pair spec's imm7 (its element size).
// General-purpose pairs: opc=00 W (4), opc=01 LDPSW (4), opc=10 X (8).  SIMD&FP
// pairs: opc=00 S (4), opc=01 D (8), opc=10 Q (16).
func lspScale(spec uint32) int {
	var opc int = cast(int, (spec >> 30) & 3)
	if ldstIsSimd(spec) {
		if opc == 0 { return 4 }
		if opc == 1 { return 8 }
		return 16
	}
	if opc == 2 { return 8 }
	return 4
}

// LdStPair emits a load/store pair `<op> Rt1, Rt2, <addr>` in the given PAIR_* mode:
// PAIR_OFFSET `[Rn{, #offset}]`, PAIR_PRE `[Rn, #offset]!`, PAIR_POST `[Rn], #offset`,
// or PAIR_NONTEMPORAL (LDNP/STNP) `[Rn{, #offset}]`.  offset must be a multiple of the
// element size with offset/size in [-64, 63].  A load of the same register twice, or
// a writeback whose base is one of the transferred general-purpose registers, is
// CONSTRAINED UNPREDICTABLE and rejected.
func LdStPair(a @asm.Assembler, spec uint32, rt1 int, rt2 int, rn int, offset int, mode int) {
	if !RegsOk(a, rt1, rt2, rn, 0) { return }
	// Allocated specs: opc 00 / 10 for either direction, and opc 01 only as the
	// general-purpose LDPSW (a load) or the SIMD&FP D pair — opc 01 as a
	// general-purpose STORE is not a pair transfer (it encodes the MTE STGP).
	var gpOpc01Store bool = ((spec >> 30) & 3) == 1 && (spec & 0x04000000) == 0 &&
			(spec & 0x00400000) == 0
	if (spec & 0x3BBFFFFF) != 0 || ((spec >> 30) & 3) == 3 || gpOpc01Store {
		a.SetError("load/store pair: unallocated pair spec")
		return
	}
	var scale int = lspScale(spec)
	if mode != PAIR_OFFSET && mode != PAIR_PRE && mode != PAIR_POST && mode != PAIR_NONTEMPORAL {
		a.SetError("load/store pair: invalid addressing mode")
		return
	}
	if offset % scale != 0 || offset / scale < -64 || offset / scale > 63 {
		a.SetError("load/store pair: offset not a multiple of the element size in [-64, 63] elements")
		return
	}
	var isLoad bool = (spec & 0x00400000) != 0
	var simd bool = ldstIsSimd(spec)
	if mode == PAIR_NONTEMPORAL && !simd && ((spec >> 30) & 3) == 1 {
		a.SetError("load/store pair: no non-temporal form of LDPSW")
		return
	}
	if isLoad && rt1 == rt2 {
		a.SetError("load pair: both destinations are the same register (unpredictable)")
		return
	}
	if (mode == PAIR_PRE || mode == PAIR_POST) && !simd && rn != 31 && (rt1 == rn || rt2 == rn) {
		a.SetError("load/store pair: writeback base register is also a transfer register (unpredictable)")
		return
	}
	var inst uint32 = 0x28000000 | spec | (cast(uint32, mode) << 23)
	inst = inst | (cast(uint32, (offset / scale) & 0x7f) << 15) | (cast(uint32, rt2) << 10)
	Emit32(a, ldstRegs(inst, rn, rt1))
}
