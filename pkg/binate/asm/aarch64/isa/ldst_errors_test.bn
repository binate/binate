package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Error-path tests for the exact single-register load/store encoders in
// aarch64_ldst_arch.bn: each refused operand must set the assembler error and
// emit nothing (and record no fixup).  Where an input is refused because the
// architecture has no such instruction, the claim was checked against clang /
// llvm-objdump (`<unknown>` or an assembler error).  lsdpRejected is in
// aarch64_ldst_arch_test.bn.

// lsSpecRejectedEverywhere reports whether every spec-taking single-register
// encoder refuses spec without emitting a word or recording a fixup.
func lsSpecRejectedEverywhere(spec uint32) bool {
	var a @asm.Assembler = newAsm()
	LdStUImm(a, spec, X0, X1, 0)
	if !lsdpRejected(a) { return false }
	a = newAsm()
	LdStUnscaled(a, spec, X0, X1, 0)
	if !lsdpRejected(a) { return false }
	a = newAsm()
	LdStPre(a, spec, X0, X1, 0)
	if !lsdpRejected(a) { return false }
	a = newAsm()
	LdStPost(a, spec, X0, X1, 0)
	if !lsdpRejected(a) { return false }
	a = newAsm()
	LdStReg(a, spec, X0, X1, X2, EXT_LSL, false)
	if !lsdpRejected(a) { return false }
	a = newAsm()
	LdStLo12(a, spec, X0, X1, "sym", 0)
	return lsdpRejected(a) && a.Sections[0].NumFixups == 0
}

// Unallocated size/V/opc combinations are refused by every encoder: SIMD&FP
// opc=1x with size != 00 (0x7D800000, 0xBDC00000, 0xFD800000 disassemble as
// <unknown>) and general-purpose size=1x with opc=11 (0xB9C00000, 0xF9C00000).
func TestLdStUnallocatedSpecs() testing.TestResult {
	if !lsSpecRejectedEverywhere(0x44800000) { return fail("SIMD H with opc=10") }
	if !lsSpecRejectedEverywhere(0x84C00000) { return fail("SIMD S with opc=11") }
	if !lsSpecRejectedEverywhere(0xC4800000) { return fail("SIMD D with opc=10") }
	if !lsSpecRejectedEverywhere(0x80C00000) { return fail("GP size=10 with opc=11") }
	if !lsSpecRejectedEverywhere(0xC0C00000) { return fail("GP size=11 with opc=11") }
	return ""
}

// A spec with any bit outside size[31:30], V[26] and opc[23:22] is not a spec
// (e.g. a whole instruction word, or a stray register bit) and is refused.
func TestLdStSpecStrayBits() testing.TestResult {
	if !lsSpecRejectedEverywhere(LS_LDR_X | 0x39000000) { return fail("instruction word as spec") }
	if !lsSpecRejectedEverywhere(LS_LDR_X | 0x00000001) { return fail("Rt bit in spec") }
	if !lsSpecRejectedEverywhere(LS_STRB | 0x00200000) { return fail("bit 21 in spec") }
	return ""
}

// uimmRejected reports whether LdStUImm refuses offset for spec without emitting.
func uimmRejected(spec uint32, offset int) bool {
	var a @asm.Assembler = newAsm()
	LdStUImm(a, spec, X0, X1, offset)
	return lsdpRejected(a)
}

// LdStUImm refuses a negative offset, one that is not a multiple of the access
// size, and one past 4095 * size — it never falls back to LDUR or a scratch.
func TestLdStUImmOffsetErrors() testing.TestResult {
	if !uimmRejected(LS_LDR_X, -8) { return fail("negative offset") }
	if !uimmRejected(LS_LDR_X, 4) { return fail("X offset not a multiple of 8") }
	if !uimmRejected(LS_LDR_X, 32768) { return fail("X offset 4096*8") }
	if !uimmRejected(LS_STRB, 4096) { return fail("byte offset 4096") }
	if !uimmRejected(LS_LDRH, 1) { return fail("half offset not a multiple of 2") }
	if !uimmRejected(LS_LDRSH_X, 8192) { return fail("half offset 4096*2") }
	if !uimmRejected(LS_LDR_W, 16384) { return fail("W offset 4096*4") }
	if !uimmRejected(LS_LDR_S, 2) { return fail("S offset not a multiple of 4") }
	if !uimmRejected(LS_LDR_Q, 8) { return fail("Q offset not a multiple of 16") }
	if !uimmRejected(LS_STR_Q, 65536) { return fail("Q offset 4096*16") }
	if !uimmRejected(LS_PRFM, 4) { return fail("PRFM offset not a multiple of 8") }
	return ""
}

// LdStUnscaled refuses offsets outside the signed 9-bit range [-256, 255].
func TestLdStUnscaledRangeErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStUnscaled(a, LS_LDR_X, X0, X1, -257)
	if !lsdpRejected(a) { return fail("ldur offset -257") }
	a = newAsm()
	LdStUnscaled(a, LS_STRB, X0, X1, 256)
	if !lsdpRejected(a) { return fail("sturb offset 256") }
	return ""
}

// LdStPre and LdStPost refuse writeback offsets outside [-256, 255].
func TestLdStIndexedRangeErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPre(a, LS_LDR_X, X0, X1, -257)
	if !lsdpRejected(a) { return fail("pre offset -257") }
	a = newAsm()
	LdStPre(a, LS_STR_Q, 0, X1, 256)
	if !lsdpRejected(a) { return fail("pre offset 256") }
	a = newAsm()
	LdStPost(a, LS_LDRB, X0, X1, -257)
	if !lsdpRejected(a) { return fail("post offset -257") }
	a = newAsm()
	LdStPost(a, LS_STR_W, X0, X1, 256)
	if !lsdpRejected(a) { return fail("post offset 256") }
	return ""
}

// A general-purpose writeback transfer whose Rt is also the base (other than
// 31) is CONSTRAINED UNPREDICTABLE — clang rejects `ldr x1, [x1, #8]!` and
// `str x1, [x1, #8]!` alike — so both loads and stores are refused.
func TestLdStWritebackBaseIsRt() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPre(a, LS_LDR_X, X1, X1, 8)
	if !lsdpRejected(a) { return fail("ldr x1, [x1, #8]!") }
	a = newAsm()
	LdStPre(a, LS_STR_X, X1, X1, 8)
	if !lsdpRejected(a) { return fail("str x1, [x1, #8]!") }
	a = newAsm()
	LdStPost(a, LS_LDR_X, X2, X2, 8)
	if !lsdpRejected(a) { return fail("ldr x2, [x2], #8") }
	a = newAsm()
	LdStPost(a, LS_STRB, X3, X3, 1)
	if !lsdpRejected(a) { return fail("strb w3, [x3], #1") }
	a = newAsm()
	LdStPre(a, LS_LDRSW, X30, X30, -4)
	if !lsdpRejected(a) { return fail("ldrsw x30, [x30, #-4]!") }
	return ""
}

// PRFM has no pre- or post-indexed form: size=11 V=0 opc=10 in the writeback
// classes is unallocated (clang rejects `prfm pldl1keep, [x1, #8]!` and
// `[x1], #8`; 0xF8808C20 / 0xF8808420 disassemble as <unknown>).  The base is
// X1 so the prfop (0) cannot trip the writeback-overlap check instead.
func TestLdStPrfmNoWriteback() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPre(a, LS_PRFM, 0, X1, 8)
	if !lsdpRejected(a) { return fail("prfm has no pre-indexed form") }
	a = newAsm()
	LdStPost(a, LS_PRFM, 0, X1, 8)
	if !lsdpRejected(a) { return fail("prfm has no post-indexed form") }
	return ""
}

// LdStReg refuses every option value other than UXTW / LSL / SXTW / SXTX —
// option<1> = 0 is unallocated in the register-offset class.
func TestLdStRegBadExtend() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, 0, false)
	if !lsdpRejected(a) { return fail("option 000") }
	a = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, 1, true)
	if !lsdpRejected(a) { return fail("option 001") }
	a = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, 4, false)
	if !lsdpRejected(a) { return fail("option 100") }
	a = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, 5, false)
	if !lsdpRejected(a) { return fail("option 101") }
	a = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, 8, false)
	if !lsdpRejected(a) { return fail("option 8 (out of field)") }
	a = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, -1, false)
	if !lsdpRejected(a) { return fail("option -1") }
	return ""
}

// literalRejected reports whether both literal encoders refuse spec, emitting
// no word and recording no fixup.
func literalRejected(spec uint32) bool {
	var a @asm.Assembler = newAsm()
	LdStLiteral(a, spec, X0, "lit", 0)
	if !lsdpRejected(a) || a.Sections[0].NumFixups != 0 { return false }
	a = newAsm()
	LdStLiteralOffset(a, spec, X0, 8)
	return lsdpRejected(a)
}

// Only LDR W/X/S/D/Q, LDRSW and PRFM have a PC-relative literal form: every
// store, byte and halfword transfer (and LDR B/H) is refused.
func TestLdStLiteralNoForm() testing.TestResult {
	if !literalRejected(LS_STR_W) { return fail("str w literal") }
	if !literalRejected(LS_STR_X) { return fail("str x literal") }
	if !literalRejected(LS_STRB) { return fail("strb literal") }
	if !literalRejected(LS_LDRB) { return fail("ldrb literal") }
	if !literalRejected(LS_LDRSB_X) { return fail("ldrsb literal") }
	if !literalRejected(LS_LDRH) { return fail("ldrh literal") }
	if !literalRejected(LS_LDRSH_W) { return fail("ldrsh literal") }
	if !literalRejected(LS_STR_S) { return fail("str s literal") }
	if !literalRejected(LS_STR_Q) { return fail("str q literal") }
	if !literalRejected(LS_LDR_B) { return fail("ldr b literal") }
	if !literalRejected(LS_LDR_H) { return fail("ldr h literal") }
	return ""
}

// LdStLiteralOffset refuses an offset that is not a multiple of 4 or lies
// outside [-2^20, 2^20 - 4] (clang: "expected label or encodable integer pc
// offset" for #2, #1048576 and #-1048580).
func TestLdStLiteralOffsetErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStLiteralOffset(a, LS_LDR_X, X0, 2)
	if !lsdpRejected(a) { return fail("offset 2 is not word-aligned") }
	a = newAsm()
	LdStLiteralOffset(a, LS_LDR_W, X0, -6)
	if !lsdpRejected(a) { return fail("offset -6 is not word-aligned") }
	a = newAsm()
	LdStLiteralOffset(a, LS_LDR_X, X0, 1048576)
	if !lsdpRejected(a) { return fail("offset 2^20") }
	a = newAsm()
	LdStLiteralOffset(a, LS_LDR_Q, 0, -1048580)
	if !lsdpRejected(a) { return fail("offset -2^20 - 4") }
	return ""
}
