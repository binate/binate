package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the exclusive and ordered (acquire / release) loads and stores:
// LDXR / LDAXR / STXR / STLXR and their pair forms, LDAR / STLR, LDLAR / STLLR
// (LORegions), LDAPR (RCpc), and LDAPUR / STLUR (RCpc, unscaled signed offset).
// Every register operand is zero-or-register (31 = XZR / WZR) except the base Rn,
// which is SP-or-register.  The fields a form does not use (Rs, Rt2) hold 11111.

// ldstOrderedOpValid reports whether op is one of the LSO_* single-register ops that
// LdStOrdered encodes.
func ldstOrderedOpValid(op uint32) bool {
	return op == LSO_LDXR || op == LSO_LDAXR || op == LSO_LDAR || op == LSO_STLR || op == LSO_LDLAR ||
			op == LSO_STLLR || op == LSO_LDAPR
}

// LdStOrdered emits `<op> Rt, [Rn]` — a load-exclusive or ordered single-register
// transfer (LSO_LDXR / LDAXR / LDAR / STLR / LDLAR / STLLR / LDAPR) of 1 << size bytes
// (size 0..3: B, H, W, X).
func LdStOrdered(a @asm.Assembler, op uint32, size int, rt int, rn int) {
	if !regsOk(a, rt, rn, 0, 0) { return }
	if !ldstOrderedOpValid(op) {
		a.SetError("ordered load/store: invalid operation")
		return
	}
	if size < 0 || size > 3 {
		a.SetError("ordered load/store: size out of range [0, 3]")
		return
	}
	emit32(a, ldstRegs(op | (cast(uint32, size) << 30), rn, rt))
}

// StoreExclusive emits STXR / STLXR (op LSO_STXR / LSO_STLXR) `Ws, Rt, [Rn]` of
// 1 << size bytes, writing the success status to Ws.  A status register that is
// also the transfer register, or the base (other than SP), makes the result
// CONSTRAINED UNPREDICTABLE and is rejected, as clang does.
func StoreExclusive(a @asm.Assembler, op uint32, size int, rs int, rt int, rn int) {
	if !regsOk(a, rs, rt, rn, 0) { return }
	if op != LSO_STXR && op != LSO_STLXR {
		a.SetError("store exclusive: invalid operation")
		return
	}
	if size < 0 || size > 3 {
		a.SetError("store exclusive: size out of range [0, 3]")
		return
	}
	if rs == rt || (rs == rn && rn != 31) {
		a.SetError(
				"store exclusive: the status register must differ from the transfer and "
						"base registers")
		return
	}
	emit32(a, ldstRegs(op | (cast(uint32, size) << 30) | (cast(uint32, rs) << 16), rn, rt))
}

// LoadExclusivePair emits LDXP / LDAXP (acquire) `Rt, Rt2, [Rn]`, 32-bit registers
// or 64-bit (sf).  Rt == Rt2 is CONSTRAINED UNPREDICTABLE and rejected, as LdStPair
// rejects the same LDP (clang accepts it).
func LoadExclusivePair(a @asm.Assembler, acquire bool, sf bool, rt int, rt2 int, rn int) {
	if !regsOk(a, rt, rt2, rn, 0) { return }
	if rt == rt2 {
		a.SetError("load exclusive pair: both destinations are the same register (unpredictable)")
		return
	}
	var inst uint32 = 0x887F0000 | (cast(uint32, rt2) << 10)
	if sf { inst = inst | 0x40000000 }
	if acquire { inst = inst | 0x00008000 }
	emit32(a, ldstRegs(inst, rn, rt))
}

// StoreExclusivePair emits STXP / STLXP (release) `Ws, Rt, Rt2, [Rn]`, 32-bit or
// 64-bit (sf) data registers.  The status register must differ from both data
// registers and from the base (other than SP), as for StoreExclusive.
func StoreExclusivePair(a @asm.Assembler, release bool, sf bool, rs int, rt int, rt2 int, rn int) {
	if !regsOk(a, rs, rt, rt2, rn) { return }
	if rs == rt || rs == rt2 || (rs == rn && rn != 31) {
		a.SetError(
				"store exclusive: the status register must differ from the transfer and "
						"base registers")
		return
	}
	var inst uint32 = 0x88200000 | (cast(uint32, rs) << 16) | (cast(uint32, rt2) << 10)
	if sf { inst = inst | 0x40000000 }
	if release { inst = inst | 0x00008000 }
	emit32(a, ldstRegs(inst, rn, rt))
}

// LdStRcpcUnscaled emits LDAPUR / STLUR `Rt, [Rn, #offset]` (offset in [-256, 255])
// for the transfer an LS_* spec names: a store is STLUR, a load LDAPUR, and a
// sign-extending load LDAPURS{B,H,W}.  A SIMD&FP spec (B / H / S / D / Q) selects
// the SIMD&FP form.  PRFM has no such form.
func LdStRcpcUnscaled(a @asm.Assembler, spec uint32, rt int, rn int, offset int) {
	if !regsOk(a, rt, rn, 0, 0) { return }
	if !ldstSpecValid(spec) || spec == LS_PRFM {
		a.SetError("ldapur/stlur: invalid transfer")
		return
	}
	if offset < -256 || offset > 255 {
		a.SetError("ldapur/stlur: offset out of range [-256, 255]")
		return
	}
	var inst uint32 = 0x19000000 | spec | ((cast(uint32, offset) & 0x1FF) << 12)
	if ldstIsSimd(spec) { inst = inst | 0x00000800 }
	emit32(a, ldstRegs(inst, rn, rt))
}
