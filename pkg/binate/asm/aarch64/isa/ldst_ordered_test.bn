package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The exclusive / ordered encoders: one word per valid call (clang's words), and
// nothing — only an error — for an invalid op, size, offset, register, or a
// CONSTRAINED UNPREDICTABLE register combination.  (lsdpRejected / lsdpClean /
// lsdpWordIs are in ldst_test.bn.)

func TestLdStOrderedRejectsBadOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStOrdered(a, LSO_STXR, 3, 0, 1)
	if !lsdpRejected(a) { return fail("a store-exclusive op in LdStOrdered") }
	a = newAsm()
	LdStOrdered(a, LSO_LDAR, 4, 0, 1)
	if !lsdpRejected(a) { return fail("size 4") }
	a = newAsm()
	LdStOrdered(a, LSO_LDAR, 3, 32, 1)
	if !lsdpRejected(a) { return fail("register 32") }
	a = newAsm()
	LdStOrdered(a, LSO_LDAPR, 0, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x38BFC3E0) { return fail("ldaprb w0, [sp]") }
	return ""
}

func TestStoreExclusiveStatusRegister() testing.TestResult {
	var a @asm.Assembler = newAsm()
	StoreExclusive(a, LSO_STXR, 3, 2, 2, 1)
	if !lsdpRejected(a) { return fail("status = transfer") }
	a = newAsm()
	StoreExclusive(a, LSO_STLXR, 3, 1, 0, 1)
	if !lsdpRejected(a) { return fail("status = base") }
	a = newAsm()
	StoreExclusive(a, LSO_LDXR, 3, 2, 0, 1)
	if !lsdpRejected(a) { return fail("a load op in StoreExclusive") }
	a = newAsm()
	StoreExclusive(a, LSO_STXR, 4, 2, 0, 1)
	if !lsdpRejected(a) { return fail("size 4") }
	a = newAsm()
	StoreExclusive(a, LSO_STXR, 3, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xC81F7FE0) { return fail("stxr wzr, x0, [sp]") }
	return ""
}

func TestExclusivePairs() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LoadExclusivePair(a, false, true, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xC87F0440) { return fail("ldxp x0, x1, [x2]") }
	a = newAsm()
	LoadExclusivePair(a, true, false, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x887F8440) { return fail("ldaxp w0, w1, [x2]") }
	a = newAsm()
	StoreExclusivePair(a, false, true, 3, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xC8230440) { return fail("stxp w3, x0, x1, [x2]") }
	a = newAsm()
	StoreExclusivePair(a, true, false, 3, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x88238440) { return fail("stlxp w3, w0, w1, [x2]") }
	a = newAsm()
	LoadExclusivePair(a, false, true, 0, 0, 1)
	if !lsdpRejected(a) { return fail("ldxp with Rt == Rt2") }
	a = newAsm()
	StoreExclusivePair(a, false, true, 3, 0, 3, 2)
	if !lsdpRejected(a) { return fail("pair status = second data register") }
	a = newAsm()
	LoadExclusivePair(a, true, true, 0, 1, 32)
	if !lsdpRejected(a) { return fail("pair base register 32") }
	return ""
}

func TestLdStRcpcUnscaled() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStRcpcUnscaled(a, LS_LDRB, 0, 1, -1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x195FF020) { return fail("ldapurb w0, [x1, #-1]") }
	a = newAsm()
	LdStRcpcUnscaled(a, LS_STR_X, 0, 31, 8)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xD90083E0) { return fail("stlur x0, [sp, #8]") }
	a = newAsm()
	LdStRcpcUnscaled(a, LS_LDR_Q, 4, 5, -256)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x1DD008A4) { return fail("ldapur q4, [x5, #-256]") }
	a = newAsm()
	LdStRcpcUnscaled(a, LS_PRFM, 0, 1, 0)
	if !lsdpRejected(a) { return fail("prfm has no ldapur form") }
	a = newAsm()
	LdStRcpcUnscaled(a, LS_LDR_X, 0, 1, -257)
	if !lsdpRejected(a) { return fail("offset -257") }
	a = newAsm()
	LdStRcpcUnscaled(a, LS_LDR_X, 0, 1, 256)
	if !lsdpRejected(a) { return fail("offset 256") }
	a = newAsm()
	LdStRcpcUnscaled(a, LS_LDR_X, 32, 1, 0)
	if !lsdpRejected(a) { return fail("register 32") }
	a = newAsm()
	LdStRcpcUnscaled(a, 0x00000001, 0, 1, 0)
	if !lsdpRejected(a) { return fail("an invalid spec") }
	return ""
}
