package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Tests for the exact load/store pair encoder LdStPair (aarch64_ldst_arch.bn):
// clang-verified words for every LSP_* spec in each PAIR_* mode, then every
// refusal path, each of which must emit nothing.  SIMD&FP registers are passed
// as encoding numbers.  lsdpWordIs / lsdpClean / lsdpRejected are in
// aarch64_ldst_arch_test.bn.

// General-purpose pairs (W, X, LDPSW) in the offset, pre-, post-indexed and
// non-temporal modes, at both ends of the scaled imm7 range.
func TestLdStPairGeneral() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPair(a, LSP_STP_X, X29, X30, SP, -16, PAIR_PRE) // stp x29, x30, [sp, #-16]!
	LdStPair(a, LSP_LDP_X, X29, X30, SP, 16, PAIR_POST) // ldp x29, x30, [sp], #16
	LdStPair(a, LSP_STP_W, X0, X1, X2, 252, PAIR_OFFSET) // stp w0, w1, [x2, #252]
	LdStPair(a, LSP_LDP_W, X3, X4, X5, -256, PAIR_OFFSET) // ldp w3, w4, [x5, #-256]
	LdStPair(a, LSP_LDPSW, X6, X7, X8, 8, PAIR_OFFSET) // ldpsw x6, x7, [x8, #8]
	LdStPair(a, LSP_LDPSW, X9, X10, X11, -8, PAIR_PRE) // ldpsw x9, x10, [x11, #-8]!
	LdStPair(a, LSP_LDPSW, X12, X13, X14, 252, PAIR_POST) // ldpsw x12, x13, [x14], #252
	LdStPair(a, LSP_LDP_X, X15, X16, X17, 504, PAIR_OFFSET) // ldp x15, x16, [x17, #504]
	LdStPair(a, LSP_STP_X, X18, X19, X20, -512, PAIR_NONTEMPORAL) // stnp x18, x19, [x20, #-512]
	LdStPair(a, LSP_LDP_W, X21, X22, X23, 0, PAIR_NONTEMPORAL) // ldnp w21, w22, [x23]
	if !lsdpClean(a, 10) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xA9BF7BFD) { return fail("stp x29, x30, [sp, #-16]!") }
	if !lsdpWordIs(a, 1, 0xA8C17BFD) { return fail("ldp x29, x30, [sp], #16") }
	if !lsdpWordIs(a, 2, 0x291F8440) { return fail("stp w0, w1, [x2, #252]") }
	if !lsdpWordIs(a, 3, 0x296010A3) { return fail("ldp w3, w4, [x5, #-256]") }
	if !lsdpWordIs(a, 4, 0x69411D06) { return fail("ldpsw x6, x7, [x8, #8]") }
	if !lsdpWordIs(a, 5, 0x69FF2969) { return fail("ldpsw x9, x10, [x11, #-8]!") }
	if !lsdpWordIs(a, 6, 0x68DFB5CC) { return fail("ldpsw x12, x13, [x14], #252") }
	if !lsdpWordIs(a, 7, 0xA95FC22F) { return fail("ldp x15, x16, [x17, #504]") }
	if !lsdpWordIs(a, 8, 0xA8204E92) { return fail("stnp x18, x19, [x20, #-512]") }
	if !lsdpWordIs(a, 9, 0x28405AF5) { return fail("ldnp w21, w22, [x23]") }
	return ""
}

// SIMD&FP pairs (S, D, Q) in every mode; Q scales imm7 by 16.
func TestLdStPairSimd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPair(a, LSP_STP_S, 0, 1, X2, -4, PAIR_OFFSET) // stp s0, s1, [x2, #-4]
	LdStPair(a, LSP_LDP_S, 3, 4, SP, 252, PAIR_POST) // ldp s3, s4, [sp], #252
	LdStPair(a, LSP_STP_D, 5, 6, X7, 504, PAIR_PRE) // stp d5, d6, [x7, #504]!
	LdStPair(a, LSP_LDP_D, 8, 9, X10, -512, PAIR_OFFSET) // ldp d8, d9, [x10, #-512]
	LdStPair(a, LSP_STP_Q, 10, 11, X12, -1024, PAIR_PRE) // stp q10, q11, [x12, #-1024]!
	LdStPair(a, LSP_LDP_Q, 31, 30, SP, 1008, PAIR_OFFSET) // ldp q31, q30, [sp, #1008]
	LdStPair(a, LSP_LDP_Q, 0, 1, X2, 16, PAIR_NONTEMPORAL) // ldnp q0, q1, [x2, #16]
	LdStPair(a, LSP_STP_D, 3, 4, X5, -8, PAIR_NONTEMPORAL) // stnp d3, d4, [x5, #-8]
	LdStPair(a, LSP_LDP_S, 6, 7, X8, 4, PAIR_NONTEMPORAL) // ldnp s6, s7, [x8, #4]
	if !lsdpClean(a, 9) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x2D3F8440) { return fail("stp s0, s1, [x2, #-4]") }
	if !lsdpWordIs(a, 1, 0x2CDF93E3) { return fail("ldp s3, s4, [sp], #252") }
	if !lsdpWordIs(a, 2, 0x6D9F98E5) { return fail("stp d5, d6, [x7, #504]!") }
	if !lsdpWordIs(a, 3, 0x6D602548) { return fail("ldp d8, d9, [x10, #-512]") }
	if !lsdpWordIs(a, 4, 0xADA02D8A) { return fail("stp q10, q11, [x12, #-1024]!") }
	if !lsdpWordIs(a, 5, 0xAD5FFBFF) { return fail("ldp q31, q30, [sp, #1008]") }
	if !lsdpWordIs(a, 6, 0xAC408440) { return fail("ldnp q0, q1, [x2, #16]") }
	if !lsdpWordIs(a, 7, 0x6C3F90A3) { return fail("stnp d3, d4, [x5, #-8]") }
	if !lsdpWordIs(a, 8, 0x2C409D06) { return fail("ldnp s6, s7, [x8, #4]") }
	return ""
}

// Register overlaps the architecture allows (all accepted by clang): a SIMD&FP
// writeback pair whose register number equals the base's, a store of the same
// register twice, 31/31 with an SP base, and a base reused as a non-writeback
// load destination.
func TestLdStPairAllowedOverlaps() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPair(a, LSP_LDP_D, 1, 2, X1, 16, PAIR_PRE) // ldp d1, d2, [x1, #16]!
	LdStPair(a, LSP_STP_X, XZR, XZR, SP, -16, PAIR_PRE) // stp xzr, xzr, [sp, #-16]!
	LdStPair(a, LSP_LDP_X, X1, X2, X1, 0, PAIR_OFFSET) // ldp x1, x2, [x1]
	LdStPair(a, LSP_STP_X, X0, X0, X1, 0, PAIR_OFFSET) // stp x0, x0, [x1]
	if !lsdpClean(a, 4) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x6DC10821) { return fail("ldp d1, d2, [x1, #16]!") }
	if !lsdpWordIs(a, 1, 0xA9BF7FFF) { return fail("stp xzr, xzr, [sp, #-16]!") }
	if !lsdpWordIs(a, 2, 0xA9400821) { return fail("ldp x1, x2, [x1]") }
	if !lsdpWordIs(a, 3, 0xA9000020) { return fail("stp x0, x0, [x1]") }
	return ""
}

// pairRejected reports whether LdStPair refuses the operands without emitting.
func pairRejected(spec uint32, rt1 int, rt2 int, rn int, offset int, mode int) bool {
	var a @asm.Assembler = newAsm()
	LdStPair(a, spec, rt1, rt2, rn, offset, mode)
	return lsdpRejected(a)
}

// opc=11 (general-purpose or SIMD&FP) is unallocated, and a spec with any bit
// outside opc[31:30], V[26] and L[22] — including the mode field — is refused.
func TestLdStPairUnallocatedSpec() testing.TestResult {
	if !pairRejected(0xC0000000, X0, X1, X2, 0, PAIR_OFFSET) { return fail("GP opc=11 store") }
	if !pairRejected(0xC0400000, X0, X1, X2, 0, PAIR_OFFSET) { return fail("GP opc=11 load") }
	if !pairRejected(0xC4400000, 0, 1, X2, 0, PAIR_OFFSET) { return fail("SIMD opc=11 load") }
	if !pairRejected(LSP_LDP_X | 0x00800000, X0, X1, X2, 0, PAIR_OFFSET) {
		return fail("mode bit in spec")
	}
	if !pairRejected(LSP_LDP_X | 0x00000001, X0, X1, X2, 0, PAIR_OFFSET) {
		return fail("Rt bit in spec")
	}
	return ""
}

// opc=01 V=0 L=0 — the store counterpart of LDPSW — is not an STP: in the
// non-temporal class it is unallocated (0x68000000 disassembles as <unknown>)
// and in the offset / pre / post classes it is the MTE STGP (0x69000000 is
// `stgp x0, x0, [x0]`, whose imm7 scales by 16), so it must be refused.
func TestLdStPairNoStoreOfLdpsw() testing.TestResult {
	if !pairRejected(0x40000000, X0, X1, X2, 0, PAIR_NONTEMPORAL) {
		return fail("opc=01 store, non-temporal: unallocated")
	}
	if !pairRejected(0x40000000, X0, X1, X2, 16, PAIR_OFFSET) {
		return fail("opc=01 store, offset: STGP, not a 4-byte STP")
	}
	if !pairRejected(0x40000000, X0, X1, X2, 16, PAIR_PRE) {
		return fail("opc=01 store, pre-indexed: STGP, not a 4-byte STP")
	}
	if !pairRejected(0x40000000, X0, X1, X2, 16, PAIR_POST) {
		return fail("opc=01 store, post-indexed: STGP, not a 4-byte STP")
	}
	return ""
}

// Only the four PAIR_* modes are accepted.
func TestLdStPairBadMode() testing.TestResult {
	if !pairRejected(LSP_LDP_X, X0, X1, X2, 0, -1) { return fail("mode -1") }
	if !pairRejected(LSP_LDP_X, X0, X1, X2, 0, 4) { return fail("mode 4") }
	return ""
}

// The offset must be a multiple of the element size with offset/size in
// [-64, 63]: 4 for W / S / LDPSW, 8 for X / D, 16 for Q.
func TestLdStPairOffsetErrors() testing.TestResult {
	if !pairRejected(LSP_LDP_X, X0, X1, X2, 4, PAIR_OFFSET) { return fail("X offset 4") }
	if !pairRejected(LSP_LDP_X, X0, X1, X2, 512, PAIR_OFFSET) { return fail("X offset 512") }
	if !pairRejected(LSP_STP_X, X0, X1, X2, -520, PAIR_PRE) { return fail("X offset -520") }
	if !pairRejected(LSP_STP_W, X0, X1, X2, 256, PAIR_OFFSET) { return fail("W offset 256") }
	if !pairRejected(LSP_LDP_W, X0, X1, X2, -260, PAIR_POST) { return fail("W offset -260") }
	if !pairRejected(LSP_LDPSW, X0, X1, X2, 2, PAIR_OFFSET) { return fail("LDPSW offset 2") }
	if !pairRejected(LSP_LDP_S, 0, 1, X2, 256, PAIR_OFFSET) { return fail("S offset 256") }
	if !pairRejected(LSP_STP_D, 0, 1, X2, 512, PAIR_NONTEMPORAL) { return fail("D offset 512") }
	if !pairRejected(LSP_LDP_Q, 0, 1, X2, 8, PAIR_OFFSET) { return fail("Q offset 8") }
	if !pairRejected(LSP_LDP_Q, 0, 1, X2, 1024, PAIR_OFFSET) { return fail("Q offset 1024") }
	if !pairRejected(LSP_STP_Q, 0, 1, X2, -1040, PAIR_PRE) { return fail("Q offset -1040") }
	return ""
}

// LDPSW has no non-temporal form (clang has no `ldnpsw`).
func TestLdStPairNoNontemporalLdpsw() testing.TestResult {
	if !pairRejected(LSP_LDPSW, X0, X1, X2, 0, PAIR_NONTEMPORAL) { return fail("ldnpsw") }
	return ""
}

// An LDP / LDPSW of the same register twice is CONSTRAINED UNPREDICTABLE for
// every register file and addressing mode (clang: "unpredictable LDP
// instruction, Rt2==Rt", including `ldp xzr, xzr, [sp]` and `ldp d0, d0, [x1]`).
func TestLdStPairLoadSameReg() testing.TestResult {
	if !pairRejected(LSP_LDP_X, X0, X0, X1, 0, PAIR_OFFSET) { return fail("ldp x0, x0") }
	if !pairRejected(LSP_LDP_D, 0, 0, X1, 0, PAIR_OFFSET) { return fail("ldp d0, d0") }
	if !pairRejected(LSP_LDPSW, X3, X3, X1, 0, PAIR_OFFSET) { return fail("ldpsw x3, x3") }
	if !pairRejected(LSP_LDP_Q, 1, 1, X2, 16, PAIR_POST) { return fail("ldp q1, q1 post") }
	if !pairRejected(LSP_LDP_X, XZR, XZR, SP, 0, PAIR_OFFSET) { return fail("ldp xzr, xzr") }
	return ""
}

// A general-purpose writeback pair whose base (other than SP) is one of the
// transferred registers is CONSTRAINED UNPREDICTABLE, for loads and stores and
// for either register slot (clang rejects all of these).
func TestLdStPairWritebackBase() testing.TestResult {
	if !pairRejected(LSP_LDP_X, X1, X2, X1, 16, PAIR_PRE) { return fail("ldp x1, x2, [x1]!") }
	if !pairRejected(LSP_STP_X, X1, X2, X2, 16, PAIR_POST) { return fail("stp x1, x2, [x2]") }
	if !pairRejected(LSP_STP_X, X1, X2, X1, 16, PAIR_PRE) { return fail("stp x1, x2, [x1]!") }
	if !pairRejected(LSP_LDP_W, X3, X4, X4, 8, PAIR_POST) { return fail("ldp w3, w4, [x4]") }
	if !pairRejected(LSP_LDPSW, X5, X6, X5, -8, PAIR_PRE) { return fail("ldpsw x5, x6, [x5]!") }
	return ""
}
