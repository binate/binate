package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the unprivileged loads / stores (LDTR / STTR and their byte,
// halfword and sign-extending forms, which access memory with EL0 permissions) and
// the pointer-authenticating loads LDRAA / LDRAB.  Rt is zero-or-register (31 =
// XZR / WZR) and the base Rn SP-or-register.

// LdStUnprivileged emits LDTR / STTR (LDTRB, LDTRSB, … STTRH) `Rt, [Rn, #offset]`,
// offset in [-256, 255], for the transfer a general-purpose LS_* spec names (a store
// is STTR*, a load LDTR*).  PRFM and the SIMD&FP transfers have no unprivileged form.
func LdStUnprivileged(a @asm.Assembler, spec uint32, rt int, rn int, offset int) {
	if !regsOk(a, rt, rn, 0, 0) { return }
	if !ldstSpecValid(spec) || ldstIsSimd(spec) || spec == LS_PRFM {
		a.SetError("ldtr/sttr: invalid transfer")
		return
	}
	if offset < -256 || offset > 255 {
		a.SetError("ldtr/sttr: offset out of range [-256, 255]")
		return
	}
	emit32(a, ldstRegs(0x38000800 | spec | ((cast(uint32, offset) & 0x1FF) << 12), rn, rt))
}

// LoadAuthenticated emits LDRAA (key A) / LDRAB (keyB) `Xt, [Xn{, #offset}]`, or with
// writeback the pre-indexed `Xt, [Xn, #offset]!`: the address in Xn is authenticated
// with the data key, offset added, and the doubleword loaded.  offset is a multiple
// of 8 in [-4096, 4088].  A writeback base that is also Xt (other than SP) is
// CONSTRAINED UNPREDICTABLE and rejected, as clang does.
func LoadAuthenticated(a @asm.Assembler, keyB bool, rt int, rn int, offset int, writeback bool) {
	if !regsOk(a, rt, rn, 0, 0) { return }
	if offset < -4096 || offset > 4088 || offset % 8 != 0 {
		a.SetError("ldraa/ldrab: offset must be a multiple of 8 in [-4096, 4088]")
		return
	}
	if writeback && rt == rn && rn != 31 {
		a.SetError("ldraa/ldrab: writeback base register is also the destination (unpredictable)")
		return
	}
	var imm10 uint32 = cast(uint32, offset / 8) & 0x3FF
	var inst uint32 = 0xF8200400 | ((imm10 & 0x1FF) << 12) | ((imm10 >> 9) << 22)
	if keyB { inst = inst | 0x00800000 }
	if writeback { inst = inst | 0x00000800 }
	emit32(a, ldstRegs(inst, rn, rt))
}
