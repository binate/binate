package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The unprivileged and authenticated load / store encoders' own checks (the text
// assembler's golden tables cover their encodings).  (lsdpRejected / lsdpClean /
// lsdpWordIs are in ldst_test.bn.)

func TestLdStUnprivileged() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStUnprivileged(a, LS_LDRSW, 0, 1, 4)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xB8804820) { return fail("ldtrsw x0, [x1, #4]") }
	a = newAsm()
	LdStUnprivileged(a, LS_LDR_D, 0, 1, 0)
	if !lsdpRejected(a) { return fail("a SIMD&FP spec") }
	a = newAsm()
	LdStUnprivileged(a, LS_PRFM, 0, 1, 0)
	if !lsdpRejected(a) { return fail("prfm") }
	a = newAsm()
	LdStUnprivileged(a, LS_LDR_X, 0, 1, -257)
	if !lsdpRejected(a) { return fail("offset -257") }
	a = newAsm()
	LdStUnprivileged(a, LS_LDR_X, 32, 1, 0)
	if !lsdpRejected(a) { return fail("register 32") }
	return ""
}

func TestLoadAuthenticated() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LoadAuthenticated(a, true, 0, 1, -4096, true)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xF8E00C20) { return fail("ldrab x0, [x1, #-4096]!") }
	a = newAsm()
	LoadAuthenticated(a, false, 0, 1, 4096, false)
	if !lsdpRejected(a) { return fail("offset 4096") }
	a = newAsm()
	LoadAuthenticated(a, false, 0, 1, -12, false)
	if !lsdpRejected(a) { return fail("offset not a multiple of 8") }
	a = newAsm()
	LoadAuthenticated(a, false, 3, 3, 8, true)
	if !lsdpRejected(a) { return fail("writeback base = destination") }
	a = newAsm()
	LoadAuthenticated(a, false, 3, 3, 8, false)
	if !lsdpClean(a, 1) { return fail("no writeback: base = destination is fine") }
	return ""
}
