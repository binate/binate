package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Golden-encoding tests for the exact single-register load/store encoders in
// aarch64_ldst_arch.bn.  Every expected word comes from clang-assembled machine
// code (clang -target arm64-apple-macos11, otool -s __TEXT __text); the lo12
// relocation kinds come from clang -target aarch64-linux-gnu (llvm-objdump -r).
// SIMD&FP registers are passed as their encoding numbers (the encoders mask Rt
// to five bits).  The error paths are in aarch64_ldst_arch_errors_test.bn and
// the pair encoder in aarch64_ldst_arch_pair_test.bn.

// lsdpWordIs reports whether a's first section holds at least idx+1 words and
// its idx'th little-endian 32-bit word is want.
func lsdpWordIs(a @asm.Assembler, idx int, want uint32) bool {
	var s @asm.Section = a.Sections[0]
	if s.Len < (idx + 1) * 4 { return false }
	return readInst(s, idx * 4) == want
}

// lsdpRejected reports whether a recorded an error and its first section is
// still empty — an exact encoder must refuse without emitting anything.
func lsdpRejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0
}

// lsdpClean reports whether a recorded no error and emitted exactly n words.
func lsdpClean(a @asm.Assembler, n int) bool {
	return !a.HasError && a.Sections[0].Len == n * 4
}

// LdStAccessBytes is 1 << size for every general-purpose and B/H/S/D spec, and
// 16 only for Q (V=1, size=00, opc=1x) — LDRSB_X (V=0, opc=10) stays 1.
func TestLdStAccessBytes() testing.TestResult {
	if LdStAccessBytes(LS_STRB) != 1 || LdStAccessBytes(LS_LDRB) != 1 { return fail("byte") }
	if LdStAccessBytes(LS_LDRSB_X) != 1 || LdStAccessBytes(LS_LDRSB_W) != 1 {
		return fail("signed byte must be 1 (not the Q size)")
	}
	if LdStAccessBytes(LS_STRH) != 2 || LdStAccessBytes(LS_LDRSH_W) != 2 { return fail("half") }
	if LdStAccessBytes(LS_LDRSH_X) != 2 || LdStAccessBytes(LS_LDRH) != 2 { return fail("half") }
	if LdStAccessBytes(LS_STR_W) != 4 || LdStAccessBytes(LS_LDRSW) != 4 { return fail("word") }
	if LdStAccessBytes(LS_LDR_W) != 4 { return fail("word") }
	if LdStAccessBytes(LS_STR_X) != 8 || LdStAccessBytes(LS_LDR_X) != 8 { return fail("dword") }
	if LdStAccessBytes(LS_PRFM) != 8 { return fail("prfm scales by 8") }
	if LdStAccessBytes(LS_STR_B) != 1 || LdStAccessBytes(LS_LDR_B) != 1 { return fail("B") }
	if LdStAccessBytes(LS_STR_H) != 2 || LdStAccessBytes(LS_LDR_H) != 2 { return fail("H") }
	if LdStAccessBytes(LS_STR_S) != 4 || LdStAccessBytes(LS_LDR_S) != 4 { return fail("S") }
	if LdStAccessBytes(LS_STR_D) != 8 || LdStAccessBytes(LS_LDR_D) != 8 { return fail("D") }
	if LdStAccessBytes(LS_STR_Q) != 16 || LdStAccessBytes(LS_LDR_Q) != 16 { return fail("Q") }
	return ""
}

// LdStUImm encodes every general-purpose transfer in the scaled unsigned-offset
// form, including each access size's maximum offset (4095 * size) and PRFM.
func TestLdStUImmGeneral() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStUImm(a, LS_STRB, X1, X2, 4095) // strb w1, [x2, #4095]
	LdStUImm(a, LS_LDRB, X1, X2, 0) // ldrb w1, [x2]
	LdStUImm(a, LS_LDRSB_X, X3, X4, 1) // ldrsb x3, [x4, #1]
	LdStUImm(a, LS_LDRSB_W, X3, X4, 2) // ldrsb w3, [x4, #2]
	LdStUImm(a, LS_STRH, X5, X6, 8190) // strh w5, [x6, #8190]
	LdStUImm(a, LS_LDRH, X5, X6, 2) // ldrh w5, [x6, #2]
	LdStUImm(a, LS_LDRSH_X, X7, X8, 4) // ldrsh x7, [x8, #4]
	LdStUImm(a, LS_LDRSH_W, X7, X8, 6) // ldrsh w7, [x8, #6]
	LdStUImm(a, LS_STR_W, X9, SP, 16380) // str w9, [sp, #16380]
	LdStUImm(a, LS_LDR_W, X9, X10, 4) // ldr w9, [x10, #4]
	LdStUImm(a, LS_LDRSW, X11, X12, 8) // ldrsw x11, [x12, #8]
	LdStUImm(a, LS_STR_X, X13, SP, 32760) // str x13, [sp, #32760]
	LdStUImm(a, LS_LDR_X, X14, X15, 8) // ldr x14, [x15, #8]
	LdStUImm(a, LS_PRFM, 0, X0, 8) // prfm pldl1keep, [x0, #8]
	if !lsdpClean(a, 14) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x393FFC41) { return fail("strb w1, [x2, #4095]") }
	if !lsdpWordIs(a, 1, 0x39400041) { return fail("ldrb w1, [x2]") }
	if !lsdpWordIs(a, 2, 0x39800483) { return fail("ldrsb x3, [x4, #1]") }
	if !lsdpWordIs(a, 3, 0x39C00883) { return fail("ldrsb w3, [x4, #2]") }
	if !lsdpWordIs(a, 4, 0x793FFCC5) { return fail("strh w5, [x6, #8190]") }
	if !lsdpWordIs(a, 5, 0x794004C5) { return fail("ldrh w5, [x6, #2]") }
	if !lsdpWordIs(a, 6, 0x79800907) { return fail("ldrsh x7, [x8, #4]") }
	if !lsdpWordIs(a, 7, 0x79C00D07) { return fail("ldrsh w7, [x8, #6]") }
	if !lsdpWordIs(a, 8, 0xB93FFFE9) { return fail("str w9, [sp, #16380]") }
	if !lsdpWordIs(a, 9, 0xB9400549) { return fail("ldr w9, [x10, #4]") }
	if !lsdpWordIs(a, 10, 0xB980098B) { return fail("ldrsw x11, [x12, #8]") }
	if !lsdpWordIs(a, 11, 0xF93FFFED) { return fail("str x13, [sp, #32760]") }
	if !lsdpWordIs(a, 12, 0xF94005EE) { return fail("ldr x14, [x15, #8]") }
	if !lsdpWordIs(a, 13, 0xF9800400) { return fail("prfm pldl1keep, [x0, #8]") }
	return ""
}

// LdStUImm encodes every SIMD&FP transfer (B/H/S/D/Q) in the scaled unsigned-
// offset form; Q scales by 16, so its maximum offset is 65520.
func TestLdStUImmSimd() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStUImm(a, LS_STR_B, 0, X1, 4095) // str b0, [x1, #4095]
	LdStUImm(a, LS_LDR_B, 2, X3, 1) // ldr b2, [x3, #1]
	LdStUImm(a, LS_STR_H, 4, X5, 8190) // str h4, [x5, #8190]
	LdStUImm(a, LS_LDR_H, 6, X7, 2) // ldr h6, [x7, #2]
	LdStUImm(a, LS_STR_S, 8, X9, 16380) // str s8, [x9, #16380]
	LdStUImm(a, LS_LDR_S, 10, X11, 4) // ldr s10, [x11, #4]
	LdStUImm(a, LS_STR_D, 12, X13, 32760) // str d12, [x13, #32760]
	LdStUImm(a, LS_LDR_D, 14, X15, 8) // ldr d14, [x15, #8]
	LdStUImm(a, LS_STR_Q, 16, X17, 65520) // str q16, [x17, #65520]
	LdStUImm(a, LS_LDR_Q, 31, SP, 16) // ldr q31, [sp, #16]
	if !lsdpClean(a, 10) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x3D3FFC20) { return fail("str b0, [x1, #4095]") }
	if !lsdpWordIs(a, 1, 0x3D400462) { return fail("ldr b2, [x3, #1]") }
	if !lsdpWordIs(a, 2, 0x7D3FFCA4) { return fail("str h4, [x5, #8190]") }
	if !lsdpWordIs(a, 3, 0x7D4004E6) { return fail("ldr h6, [x7, #2]") }
	if !lsdpWordIs(a, 4, 0xBD3FFD28) { return fail("str s8, [x9, #16380]") }
	if !lsdpWordIs(a, 5, 0xBD40056A) { return fail("ldr s10, [x11, #4]") }
	if !lsdpWordIs(a, 6, 0xFD3FFDAC) { return fail("str d12, [x13, #32760]") }
	if !lsdpWordIs(a, 7, 0xFD4005EE) { return fail("ldr d14, [x15, #8]") }
	if !lsdpWordIs(a, 8, 0x3DBFFE30) { return fail("str q16, [x17, #65520]") }
	if !lsdpWordIs(a, 9, 0x3DC007FF) { return fail("ldr q31, [sp, #16]") }
	return ""
}

// LdStUnscaled emits LDUR/STUR (and PRFUM for LS_PRFM) with a signed 9-bit
// byte offset at both ends of [-256, 255], unscaled even for odd offsets.
func TestLdStUnscaled() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStUnscaled(a, LS_LDR_X, X1, X2, -256) // ldur x1, [x2, #-256]
	LdStUnscaled(a, LS_STR_W, X3, SP, 255) // stur w3, [sp, #255]
	LdStUnscaled(a, LS_LDRB, X4, X5, -1) // ldurb w4, [x5, #-1]
	LdStUnscaled(a, LS_LDRSW, X6, X7, 3) // ldursw x6, [x7, #3]
	LdStUnscaled(a, LS_LDRSH_W, X8, X9, -2) // ldursh w8, [x9, #-2]
	LdStUnscaled(a, LS_STR_Q, 0, X1, -1) // stur q0, [x1, #-1]
	LdStUnscaled(a, LS_LDR_D, 2, X3, 7) // ldur d2, [x3, #7]
	LdStUnscaled(a, LS_PRFM, 0, X0, -8) // prfum pldl1keep, [x0, #-8]
	if !lsdpClean(a, 8) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xF8500041) { return fail("ldur x1, [x2, #-256]") }
	if !lsdpWordIs(a, 1, 0xB80FF3E3) { return fail("stur w3, [sp, #255]") }
	if !lsdpWordIs(a, 2, 0x385FF0A4) { return fail("ldurb w4, [x5, #-1]") }
	if !lsdpWordIs(a, 3, 0xB88030E6) { return fail("ldursw x6, [x7, #3]") }
	if !lsdpWordIs(a, 4, 0x78DFE128) { return fail("ldursh w8, [x9, #-2]") }
	if !lsdpWordIs(a, 5, 0x3C9FF020) { return fail("stur q0, [x1, #-1]") }
	if !lsdpWordIs(a, 6, 0xFC407062) { return fail("ldur d2, [x3, #7]") }
	if !lsdpWordIs(a, 7, 0xF89F8000) { return fail("prfum pldl1keep, [x0, #-8]") }
	return ""
}

// LdStPre emits the pre-indexed `[Rn, #offset]!` form (bits 11:10 = 11) for
// general-purpose, signed and SIMD&FP transfers across the signed 9-bit range.
func TestLdStPre() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPre(a, LS_LDR_X, X0, X1, -256) // ldr x0, [x1, #-256]!
	LdStPre(a, LS_STR_X, X29, SP, -16) // str x29, [sp, #-16]!
	LdStPre(a, LS_STRB, X2, X3, 255) // strb w2, [x3, #255]!
	LdStPre(a, LS_LDR_Q, 0, X1, 16) // ldr q0, [x1, #16]!
	LdStPre(a, LS_LDRSW, X4, X5, -4) // ldrsw x4, [x5, #-4]!
	if !lsdpClean(a, 5) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xF8500C20) { return fail("ldr x0, [x1, #-256]!") }
	if !lsdpWordIs(a, 1, 0xF81F0FFD) { return fail("str x29, [sp, #-16]!") }
	if !lsdpWordIs(a, 2, 0x380FFC62) { return fail("strb w2, [x3, #255]!") }
	if !lsdpWordIs(a, 3, 0x3CC10C20) { return fail("ldr q0, [x1, #16]!") }
	if !lsdpWordIs(a, 4, 0xB89FCCA4) { return fail("ldrsw x4, [x5, #-4]!") }
	return ""
}

// LdStPost emits the post-indexed `[Rn], #offset` form (bits 11:10 = 01).
func TestLdStPost() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPost(a, LS_LDR_X, X29, SP, 16) // ldr x29, [sp], #16
	LdStPost(a, LS_STRB, X2, X3, 255) // strb w2, [x3], #255
	LdStPost(a, LS_LDRH, X6, X7, -256) // ldrh w6, [x7], #-256
	LdStPost(a, LS_LDR_D, 0, X0, 8) // ldr d0, [x0], #8
	LdStPost(a, LS_LDR_S, 1, X1, -4) // ldr s1, [x1], #-4
	if !lsdpClean(a, 5) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xF84107FD) { return fail("ldr x29, [sp], #16") }
	if !lsdpWordIs(a, 1, 0x380FF462) { return fail("strb w2, [x3], #255") }
	if !lsdpWordIs(a, 2, 0x785004E6) { return fail("ldrh w6, [x7], #-256") }
	if !lsdpWordIs(a, 3, 0xFC408400) { return fail("ldr d0, [x0], #8") }
	if !lsdpWordIs(a, 4, 0xBC5FC421) { return fail("ldr s1, [x1], #-4") }
	return ""
}

// A writeback transfer register that shares the base's encoding number is
// allowed when that number is 31 (Rt = XZR, Rn = SP: different registers) and
// for any SIMD&FP transfer (d1 is not x1).
func TestLdStWritebackAllowedOverlaps() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStPre(a, LS_STR_X, XZR, SP, -16) // str xzr, [sp, #-16]!
	LdStPost(a, LS_LDR_X, XZR, SP, 8) // ldr xzr, [sp], #8
	LdStPre(a, LS_LDR_D, 1, X1, 8) // ldr d1, [x1, #8]!
	if !lsdpClean(a, 3) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xF81F0FFF) { return fail("str xzr, [sp, #-16]!") }
	if !lsdpWordIs(a, 1, 0xF84087FF) { return fail("ldr xzr, [sp], #8") }
	if !lsdpWordIs(a, 2, 0xFC408C21) { return fail("ldr d1, [x1, #8]!") }
	return ""
}

// LdStReg encodes the register-offset form for each EXT_* option, with and
// without the S (scaled) bit, including byte `lsl #0`, Q `sxtx #4` and PRFM.
func TestLdStReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStReg(a, LS_LDR_X, X0, X1, X2, EXT_LSL, false) // ldr x0, [x1, x2]
	LdStReg(a, LS_LDR_X, X0, X1, X2, EXT_LSL, true) // ldr x0, [x1, x2, lsl #3]
	LdStReg(a, LS_LDR_W, X0, X1, X2, EXT_UXTW, false) // ldr w0, [x1, w2, uxtw]
	LdStReg(a, LS_LDR_W, X0, X1, X2, EXT_UXTW, true) // ldr w0, [x1, w2, uxtw #2]
	LdStReg(a, LS_LDRB, X0, X1, X2, EXT_LSL, true) // ldrb w0, [x1, x2, lsl #0]
	LdStReg(a, LS_LDRB, X3, X4, X5, EXT_LSL, false) // ldrb w3, [x4, x5]
	LdStReg(a, LS_STRH, X0, X1, X2, EXT_SXTW, true) // strh w0, [x1, w2, sxtw #1]
	LdStReg(a, LS_LDR_Q, 0, X1, X2, EXT_SXTX, true) // ldr q0, [x1, x2, sxtx #4]
	LdStReg(a, LS_LDRSW, X3, SP, X4, EXT_SXTX, false) // ldrsw x3, [sp, x4, sxtx]
	LdStReg(a, LS_PRFM, 0, X0, X1, EXT_LSL, false) // prfm pldl1keep, [x0, x1]
	LdStReg(a, LS_STR_D, 5, X6, X7, EXT_SXTW, true) // str d5, [x6, w7, sxtw #3]
	if !lsdpClean(a, 11) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0xF8626820) { return fail("ldr x0, [x1, x2]") }
	if !lsdpWordIs(a, 1, 0xF8627820) { return fail("ldr x0, [x1, x2, lsl #3]") }
	if !lsdpWordIs(a, 2, 0xB8624820) { return fail("ldr w0, [x1, w2, uxtw]") }
	if !lsdpWordIs(a, 3, 0xB8625820) { return fail("ldr w0, [x1, w2, uxtw #2]") }
	if !lsdpWordIs(a, 4, 0x38627820) { return fail("ldrb w0, [x1, x2, lsl #0]") }
	if !lsdpWordIs(a, 5, 0x38656883) { return fail("ldrb w3, [x4, x5]") }
	if !lsdpWordIs(a, 6, 0x7822D820) { return fail("strh w0, [x1, w2, sxtw #1]") }
	if !lsdpWordIs(a, 7, 0x3CE2F820) { return fail("ldr q0, [x1, x2, sxtx #4]") }
	if !lsdpWordIs(a, 8, 0xB8A4EBE3) { return fail("ldrsw x3, [sp, x4, sxtx]") }
	if !lsdpWordIs(a, 9, 0xF8A16800) { return fail("prfm pldl1keep, [x0, x1]") }
	if !lsdpWordIs(a, 10, 0xFC27D8C5) { return fail("str d5, [x6, w7, sxtw #3]") }
	return ""
}

// LdStLiteral emits each literal-capable transfer with a zero imm19 and records
// a FIX_LD_PREL_LO19 fixup carrying the addend at the instruction's offset.
func TestLdStLiteralLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStLiteral(a, LS_LDR_W, X1, "lit", 0) // ldr w1, lit
	LdStLiteral(a, LS_LDR_X, X2, "lit", 8) // ldr x2, lit+8
	LdStLiteral(a, LS_LDRSW, X3, "lit", 0) // ldrsw x3, lit
	LdStLiteral(a, LS_LDR_S, 4, "lit", 0) // ldr s4, lit
	LdStLiteral(a, LS_LDR_D, 5, "lit", 0) // ldr d5, lit
	LdStLiteral(a, LS_LDR_Q, 6, "lit", -4) // ldr q6, lit-4
	LdStLiteral(a, LS_PRFM, 1, "lit", 0) // prfm pldl1strm, lit
	if !lsdpClean(a, 7) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x18000001) { return fail("ldr w1, lit") }
	if !lsdpWordIs(a, 1, 0x58000002) { return fail("ldr x2, lit") }
	if !lsdpWordIs(a, 2, 0x98000003) { return fail("ldrsw x3, lit") }
	if !lsdpWordIs(a, 3, 0x1C000004) { return fail("ldr s4, lit") }
	if !lsdpWordIs(a, 4, 0x5C000005) { return fail("ldr d5, lit") }
	if !lsdpWordIs(a, 5, 0x9C000006) { return fail("ldr q6, lit") }
	if !lsdpWordIs(a, 6, 0xD8000001) { return fail("prfm pldl1strm, lit") }
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 7 { return fail("expected one fixup per literal load") }
	for i := 0; i < 7; i++ {
		if s.Fixups[i].Kind != FIX_LD_PREL_LO19 { return fail("literal fixup must be FIX_LD_PREL_LO19") }
		if cast(int, s.Fixups[i].Offset) != i * 4 { return fail("literal fixup offset") }
	}
	if s.Fixups[1].Addend != 8 || s.Fixups[5].Addend != -4 { return fail("literal addend") }
	return ""
}

// LdStLiteralOffset places offset/4 in imm19 (bits 23:5), two's complement,
// at both ends of the +/-1MB range, with no fixup.
func TestLdStLiteralOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStLiteralOffset(a, LS_LDR_W, X1, -1048576) // ldr w1, #-1048576
	LdStLiteralOffset(a, LS_LDR_X, X2, 1048572) // ldr x2, #1048572
	LdStLiteralOffset(a, LS_LDRSW, X3, 4) // ldrsw x3, #4
	LdStLiteralOffset(a, LS_LDR_S, 4, -4) // ldr s4, #-4
	LdStLiteralOffset(a, LS_LDR_D, 5, 8) // ldr d5, #8
	LdStLiteralOffset(a, LS_LDR_Q, 31, 1024) // ldr q31, #1024
	LdStLiteralOffset(a, LS_PRFM, 2, -8) // prfm pldl2keep, #-8
	if !lsdpClean(a, 7) { return fail("unexpected error or word count") }
	if a.Sections[0].NumFixups != 0 { return fail("an explicit offset needs no fixup") }
	if !lsdpWordIs(a, 0, 0x18800001) { return fail("ldr w1, #-1048576") }
	if !lsdpWordIs(a, 1, 0x587FFFE2) { return fail("ldr x2, #1048572") }
	if !lsdpWordIs(a, 2, 0x98000023) { return fail("ldrsw x3, #4") }
	if !lsdpWordIs(a, 3, 0x1CFFFFE4) { return fail("ldr s4, #-4") }
	if !lsdpWordIs(a, 4, 0x5C000045) { return fail("ldr d5, #8") }
	if !lsdpWordIs(a, 5, 0x9C00201F) { return fail("ldr q31, #1024") }
	if !lsdpWordIs(a, 6, 0xD8FFFFC2) { return fail("prfm pldl2keep, #-8") }
	return ""
}

// LdStLo12 emits the unsigned-offset form with a zero imm12, matching clang's
// `[Rn, :lo12:sym]` words, and records the fixup at the instruction.
func TestLdStLo12Words() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStLo12(a, LS_LDRB, X0, X1, "sym", 0) // ldrb w0, [x1, :lo12:sym]
	LdStLo12(a, LS_STRH, X4, X5, "sym", 0) // strh w4, [x5, :lo12:sym]
	LdStLo12(a, LS_LDRSW, X8, X9, "sym", 0) // ldrsw x8, [x9, :lo12:sym]
	LdStLo12(a, LS_LDR_X, X12, SP, "sym", 16) // ldr x12, [sp, :lo12:sym+16]
	LdStLo12(a, LS_STR_Q, 16, X17, "sym", 0) // str q16, [x17, :lo12:sym]
	LdStLo12(a, LS_PRFM, 0, X22, "sym", 0) // prfm pldl1keep, [x22, :lo12:sym]
	if !lsdpClean(a, 6) { return fail("unexpected error or word count") }
	if !lsdpWordIs(a, 0, 0x39400020) { return fail("ldrb w0, [x1, :lo12:sym]") }
	if !lsdpWordIs(a, 1, 0x790000A4) { return fail("strh w4, [x5, :lo12:sym]") }
	if !lsdpWordIs(a, 2, 0xB9800128) { return fail("ldrsw x8, [x9, :lo12:sym]") }
	if !lsdpWordIs(a, 3, 0xF94003EC) { return fail("ldr x12, [sp, :lo12:sym]") }
	if !lsdpWordIs(a, 4, 0x3D800230) { return fail("str q16, [x17, :lo12:sym]") }
	if !lsdpWordIs(a, 5, 0xF98002C0) { return fail("prfm pldl1keep, [x22, :lo12:sym]") }
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 6 { return fail("expected one fixup per lo12 access") }
	if cast(int, s.Fixups[3].Offset) != 12 { return fail("lo12 fixup offset") }
	if s.Fixups[3].Addend != 16 { return fail("lo12 fixup addend") }
	return ""
}

// lo12KindOf returns the fixup kind LdStLo12 records for spec, or -1 when it
// errors or does not record exactly one fixup.
func lo12KindOf(spec uint32) int {
	var a @asm.Assembler = newAsm()
	LdStLo12(a, spec, X0, X1, "sym", 0)
	if a.HasError || a.Sections[0].NumFixups != 1 { return -1 }
	return a.Sections[0].Fixups[0].Kind
}

// The lo12 fixup kind follows the access size, as clang's ELF relocations do
// (LDST8/16/32/64/128_ABS_LO12_NC): 8-byte accesses (X, D, PRFM) use
// FIX_LDR_LO12, and sign-extending loads use their memory size, not Rt's.
func TestLdStLo12FixupKinds() testing.TestResult {
	if lo12KindOf(LS_LDRB) != FIX_LDST8_LO12 { return fail("ldrb -> LDST8") }
	if lo12KindOf(LS_LDRSB_X) != FIX_LDST8_LO12 { return fail("ldrsb x -> LDST8") }
	if lo12KindOf(LS_LDR_B) != FIX_LDST8_LO12 { return fail("ldr b -> LDST8") }
	if lo12KindOf(LS_STRH) != FIX_LDST16_LO12 { return fail("strh -> LDST16") }
	if lo12KindOf(LS_LDRSH_X) != FIX_LDST16_LO12 { return fail("ldrsh x -> LDST16") }
	if lo12KindOf(LS_LDR_H) != FIX_LDST16_LO12 { return fail("ldr h -> LDST16") }
	if lo12KindOf(LS_LDR_W) != FIX_LDST32_LO12 { return fail("ldr w -> LDST32") }
	if lo12KindOf(LS_LDRSW) != FIX_LDST32_LO12 { return fail("ldrsw -> LDST32") }
	if lo12KindOf(LS_STR_S) != FIX_LDST32_LO12 { return fail("str s -> LDST32") }
	if lo12KindOf(LS_LDR_X) != FIX_LDR_LO12 { return fail("ldr x -> LDR_LO12 (LDST64)") }
	if lo12KindOf(LS_STR_D) != FIX_LDR_LO12 { return fail("str d -> LDR_LO12 (LDST64)") }
	if lo12KindOf(LS_PRFM) != FIX_LDR_LO12 { return fail("prfm -> LDR_LO12 (LDST64)") }
	if lo12KindOf(LS_LDR_Q) != FIX_LDST128_LO12 { return fail("ldr q -> LDST128") }
	return ""
}

// LdGotLo12 emits the 64-bit unsigned-offset LDR with a zero imm12 (`ldr x0, [x1,
// #:got_lo12:sym]` is 0xF9400020 before relocation) and one FIX_LD_GOT_LO12 fixup at
// its offset; a bad register emits and records nothing.
func TestLdGotLo12() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdGotLo12(a, X0, X1, "sym")
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0xF9400020) { return fail("ldr x0, [x1, got_lo12]") }
	var s @asm.Section = a.Sections[0]
	if s.NumFixups != 1 || s.Fixups[0].Kind != FIX_LD_GOT_LO12 { return fail("fixup kind") }
	a = newAsm()
	LdGotLo12(a, 33, X1, "sym")
	if !ctlRejected(a) { return fail("register 33 must be rejected") }
	return ""
}
