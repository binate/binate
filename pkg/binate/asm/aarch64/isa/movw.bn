package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// MovwFixShift returns the shift of a FIX_MOVW_* or thread-local MOVW kind's chunk; see isa.bni.
func MovwFixShift(kind int) int {
	var tls int = tlsMovwShift(kind)
	if tls >= 0 { return tls }
	if kind == FIX_MOVW_UABS_G0 || kind == FIX_MOVW_UABS_G0_NC || kind == FIX_MOVW_SABS_G0 ||
			kind == FIX_MOVW_PREL_G0 || kind == FIX_MOVW_PREL_G0_NC {
		return 0
	}
	if kind == FIX_MOVW_UABS_G1 || kind == FIX_MOVW_UABS_G1_NC || kind == FIX_MOVW_SABS_G1 ||
			kind == FIX_MOVW_PREL_G1 || kind == FIX_MOVW_PREL_G1_NC {
		return 16
	}
	if kind == FIX_MOVW_UABS_G2 || kind == FIX_MOVW_UABS_G2_NC || kind == FIX_MOVW_SABS_G2 ||
			kind == FIX_MOVW_PREL_G2 || kind == FIX_MOVW_PREL_G2_NC {
		return 32
	}
	if kind == FIX_MOVW_UABS_G3 || kind == FIX_MOVW_PREL_G3 { return 48 }
	return -1
}

// MovwValue returns what an absolute MOVW-group kind makes of a known value; see isa.bni.
func MovwValue(kind int, value int64) (int, bool, bool) {
	var shift int = MovwFixShift(kind)
	if shift < 0 || kind >= FIX_MOVW_PREL_G0 { return 0, false, false }
	var signed bool = kind == FIX_MOVW_SABS_G0 || kind == FIX_MOVW_SABS_G1 || kind == FIX_MOVW_SABS_G2
	var checked bool = signed || kind == FIX_MOVW_UABS_G0 || kind == FIX_MOVW_UABS_G1 ||
			kind == FIX_MOVW_UABS_G2
	var u uint64 = bit_cast(uint64, value)
	if checked {
		var limit uint64 = (cast(uint64, 1) << cast(uint64, shift + 16)) - 1
		// clang shifts a signed value first and requires the result in [-0xFFFF, 0xFFFF].
		var low int64 = 0 - cast(int64, cast(uint64, 0xFFFF) << cast(uint64, shift))
		if signed && (value > cast(int64, limit) || value < low) { return 0, false, false }
		if !signed && u > limit { return 0, false, false }
	}
	var movn bool = signed && value < 0
	if movn { u = u ^ 0xFFFFFFFFFFFFFFFF }
	return cast(int, (u >> cast(uint64, shift)) & 0xFFFF), movn, true
}

// MoveWideReloc emits a move-wide instruction with a MOVW-group fixup; see isa.bni.
func MoveWideReloc(a @asm.Assembler, op uint32, sf bool, rd int, shift int, label *[]readonly char,
		addend int64, kind int) {
	if MovwFixShift(kind) < 0 {
		a.SetError("move wide: not a MOVW-group relocation")
		return
	}
	if op == MW_MOVZ && tlsMovwChecked(kind) { op = MW_MOVN }
	inst, ok := moveWideWord(a, op, sf, rd, 0, shift)
	if !ok { return }
	a.AddFixup(label, kind, addend, 4)
	Emit32(a, inst)
}
