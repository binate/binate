package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// MovwFixShift returns the shift of a FIX_MOVW_* kind's chunk; see isa.bni.
func MovwFixShift(kind int) int {
	if kind == FIX_MOVW_UABS_G0 || kind == FIX_MOVW_UABS_G0_NC || kind == FIX_MOVW_SABS_G0 ||
			kind == FIX_MOVW_PREL_G0 || kind == FIX_MOVW_PREL_G0_NC {
		return 0
	}
	if kind == FIX_MOVW_UABS_G1 || kind == FIX_MOVW_UABS_G1_NC || kind == FIX_MOVW_SABS_G1 ||
			kind == FIX_MOVW_PREL_G1 || kind == FIX_MOVW_PREL_G1_NC {
		return 16
	}
	if kind == FIX_MOVW_UABS_G2 || kind == FIX_MOVW_UABS_G2_NC || kind == FIX_MOVW_SABS_G2 ||
			kind == FIX_MOVW_PREL_G2 || kind == FIX_MOVW_PREL_G2_NC {
		return 32
	}
	if kind == FIX_MOVW_UABS_G3 || kind == FIX_MOVW_PREL_G3 { return 48 }
	return -1
}

// MoveWideReloc emits a move-wide instruction with a MOVW-group fixup; see isa.bni.
func MoveWideReloc(a @asm.Assembler, op uint32, sf bool, rd int, shift int, label *[]readonly char,
		addend int, kind int) {
	if MovwFixShift(kind) < 0 {
		a.SetError("move wide: not a MOVW-group relocation")
		return
	}
	inst, ok := moveWideWord(a, op, sf, rd, 0, shift)
	if !ok { return }
	a.AddFixup(label, kind, addend, 4)
	Emit32(a, inst)
}
