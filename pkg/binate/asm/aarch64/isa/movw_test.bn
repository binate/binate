package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The MOVW-group encoder: the instruction with a zero immediate at the shift given and
// the fixup at its offset (clang's words: `movz x0, #:abs_g3:sym` is D2E00000, `movk x0,
// #:abs_g2_nc:sym` F2C00000, `movn x2, #:abs_g1_s:sym` 92A00002, `movz w3, #:abs_g1:sym`
// 52A00003, `mov w4, #:abs_g3:sym` 52800004).
func TestMoveWideReloc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MoveWideReloc(a, MW_MOVZ, true, X0, 48, "sym", 0, FIX_MOVW_UABS_G3)
	MoveWideReloc(a, MW_MOVK, true, X0, 32, "sym", 8, FIX_MOVW_UABS_G2_NC)
	MoveWideReloc(a, MW_MOVN, true, X2, 16, "sym", 0, FIX_MOVW_SABS_G1)
	MoveWideReloc(a, MW_MOVZ, false, X3, 16, "sym", 0, FIX_MOVW_UABS_G1)
	MoveWideReloc(a, MW_MOVZ, false, X4, 0, "sym", 0, FIX_MOVW_UABS_G3)
	if a.HasError { return fail(a.ErrorMsg) }
	var s @asm.Section = a.Sections[0]
	var want @[]uint32 = make_slice(uint32, 5)
	want[0] = 0xD2E00000
	want[1] = 0xF2C00000
	want[2] = 0x92A00002
	want[3] = 0x52A00003
	want[4] = 0x52800004
	for i := 0; i < 5; i++ {
		if readInst(s, 4 * i) != want[i] { return fail("a MOVW-group instruction encoded wrongly") }
	}
	if s.NumFixups != 5 || s.Fixups[1].Kind != FIX_MOVW_UABS_G2_NC || s.Fixups[1].Offset != 4 ||
			s.Fixups[1].Addend != 8 || s.Fixups[4].Kind != FIX_MOVW_UABS_G3 {
		return fail("the fixups not recorded at their instructions")
	}
	return ""
}

// A shift a W register cannot take, a kind outside the MOVW group and an invalid
// operation are errors that emit nothing — no instruction and no fixup.
func TestMoveWideRelocRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MoveWideReloc(a, MW_MOVZ, false, X0, 32, "sym", 0, FIX_MOVW_UABS_G2)
	if !a.HasError || a.Sections[0].Len != 0 || a.Sections[0].NumFixups != 0 {
		return fail("shift 32 on a W register accepted")
	}
	var b @asm.Assembler = newAsm()
	MoveWideReloc(b, MW_MOVZ, true, X0, 0, "sym", 0, FIX_BRANCH26)
	if !b.HasError || b.Sections[0].NumFixups != 0 { return fail("a non-MOVW kind accepted") }
	var c @asm.Assembler = newAsm()
	MoveWideReloc(c, 0x12345, true, X0, 0, "sym", 0, FIX_MOVW_UABS_G0)
	if !c.HasError || c.Sections[0].NumFixups != 0 { return fail("an invalid operation accepted") }
	return ""
}

// Each FIX_MOVW_* kind's chunk shift: G0 0, G1 16, G2 32, G3 48; any other kind -1.
func TestMovwFixShift() testing.TestResult {
	var want @[]int = make_slice(int, 17)
	// UABS G0, G0_NC, G1, G1_NC, G2, G2_NC, G3; SABS G0, G1, G2; PREL as UABS.
	var u @[]int = make_slice(int, 7)
	u[0] = 0
	u[1] = 0
	u[2] = 16
	u[3] = 16
	u[4] = 32
	u[5] = 32
	u[6] = 48
	for i := 0; i < 7; i++ {
		want[i] = u[i]
		want[10 + i] = u[i]
	}
	want[7] = 0
	want[8] = 16
	want[9] = 32
	for i := 0; i < 17; i++ {
		if MovwFixShift(FIX_MOVW_UABS_G0 + i) != want[i] {
			return fail("a MOVW-group kind's shift wrong")
		}
	}
	if FIX_MOVW_PREL_G3 != FIX_MOVW_UABS_G0 + 16 { return fail("the MOVW-group kinds not contiguous") }
	if MovwFixShift(FIX_ADD_LO12) != -1 || MovwFixShift(FIX_MOVW_PREL_G3 + 1) != -1 {
		return fail("MovwFixShift took a non-MOVW kind")
	}
	return ""
}
