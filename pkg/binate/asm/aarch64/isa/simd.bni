// Package simd provides exact single-instruction encoders for the AArch64 Advanced SIMD
// (NEON) data-processing instructions, in the manner of pkg/binate/asm/aarch64/isa: each
// call emits precisely the one architectural instruction its arguments name, or sets an
// assembler error when an operand has no encoding.  Registers are encoding numbers 0-31;
// a vector operand's arrangement is given by its element size (and q for a 128-bit
// register), and in a general-purpose operand (DUP, INS, UMOV, SMOV) 31 is the zero
// register, never SP.
package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"

// DupElement emits DUP `Vd.<T>, Vn.<Ts>[index]` (q: 128-bit; size 0..3 the element;
// 1D reserved).
func DupElement(a @asm.Assembler, q bool, size int, rd int, rn int, index int)

// DupScalar emits DUP `<V>d, Vn.<T>[index]` (the scalar MOV alias).
func DupScalar(a @asm.Assembler, size int, rd int, rn int, index int)

// DupGeneral emits DUP `Vd.<T>, Rn` (W for B / H / S, X for D; 1D reserved).
func DupGeneral(a @asm.Assembler, q bool, size int, rd int, rn int)

// InsGeneral emits INS `Vd.<Ts>[index], Rn`.
func InsGeneral(a @asm.Assembler, size int, rd int, index int, rn int)

// InsElement emits INS `Vd.<Ts>[dindex], Vn.<Ts>[sindex]`.
func InsElement(a @asm.Assembler, size int, rd int, dindex int, rn int, sindex int)

// Umov emits UMOV `Rd, Vn.<Ts>[index]` (W for B / H / S, X for D).
func Umov(a @asm.Assembler, size int, rd int, rn int, index int)

// Smov emits SMOV `Rd, Vn.<Ts>[index]` (B / H into W or X, S into X only).
func Smov(a @asm.Assembler, sf bool, size int, rd int, rn int, index int)

// Advanced SIMD integer three-same operations (IntThreeSame / IntThreeSameScalar):
// bit 5 is the U bit, bits 4:0 the opcode (instruction bits 15:11).  The U=1 forms are the
// unsigned (UHADD … UABA, CMHI / CMHS, UMAXP / UMINP) or second (SUB, CMEQ, MLS, PMUL,
// SQRDMULH) of a pair.
const (
	S3_SHADD int = 0x00
	S3_SQADD int = 0x01
	S3_SRHADD int = 0x02
	S3_SHSUB int = 0x04
	S3_SQSUB int = 0x05
	S3_CMGT int = 0x06
	S3_CMGE int = 0x07
	S3_SSHL int = 0x08
	S3_SQSHL int = 0x09
	S3_SRSHL int = 0x0A
	S3_SQRSHL int = 0x0B
	S3_SMAX int = 0x0C
	S3_SMIN int = 0x0D
	S3_SABD int = 0x0E
	S3_SABA int = 0x0F
	S3_ADD int = 0x10
	S3_CMTST int = 0x11
	S3_MLA int = 0x12
	S3_MUL int = 0x13
	S3_SMAXP int = 0x14
	S3_SMINP int = 0x15
	S3_SQDMULH int = 0x16
	S3_ADDP int = 0x17
	S3_UHADD int = 0x20
	S3_UQADD int = 0x21
	S3_URHADD int = 0x22
	S3_UHSUB int = 0x24
	S3_UQSUB int = 0x25
	S3_CMHI int = 0x26
	S3_CMHS int = 0x27
	S3_USHL int = 0x28
	S3_UQSHL int = 0x29
	S3_URSHL int = 0x2A
	S3_UQRSHL int = 0x2B
	S3_UMAX int = 0x2C
	S3_UMIN int = 0x2D
	S3_UABD int = 0x2E
	S3_UABA int = 0x2F
	S3_SUB int = 0x30
	S3_CMEQ int = 0x31
	S3_MLS int = 0x32
	S3_PMUL int = 0x33
	S3_UMAXP int = 0x34
	S3_UMINP int = 0x35
	S3_SQRDMULH int = 0x36
)

// Advanced SIMD bitwise operations (Logical): bit 2 is the U bit, bits 1:0 the size
// field that selects the operation.
const (
	SL_AND int = 0
	SL_BIC int = 1
	SL_ORR int = 2
	SL_ORN int = 3
	SL_EOR int = 4
	SL_BSL int = 5
	SL_BIT int = 6
	SL_BIF int = 7
)

// IntThreeSame emits the vector form `Vd.<T>, Vn.<T>, Vm.<T>` of an S3_* operation on
// a 128-bit (q) or 64-bit vector of size-byte elements (size 0..3: B, H, S, D).
func IntThreeSame(a @asm.Assembler, op int, q bool, size int, rd int, rn int, rm int)

// IntThreeSameScalar emits the scalar form `<V>d, <V>n, <V>m` of an S3_* operation
// (size 0..3: B, H, S, D).
func IntThreeSameScalar(a @asm.Assembler, op int, size int, rd int, rn int, rm int)

// Logical emits an SL_* bitwise operation `Vd.<T>, Vn.<T>, Vm.<T>`, <T> 16B (q) or 8B.
func Logical(a @asm.Assembler, op int, q bool, rd int, rn int, rm int)

// Advanced SIMD floating-point three-same operations (FPThreeSame /
// FPThreeSameScalar): bit 4 is the U bit, bit 3 the a bit (instruction bit 23), bits
// 2:0 the low opcode bits — the same in the single / double and the half-precision
// encodings.  FAMAX / FAMIN are FEAT_FAMINMAX, FSCALE FEAT_FP8.  The values missing are
// FMLAL / FMLSL / FMLAL2 / FMLSL2 (0x05, 0x0D, 0x19, 0x11 — another operand shape) and
// the unallocated 0x0C.
const (
	F3_FMAXNM int = 0x00
	F3_FMLA int = 0x01
	F3_FADD int = 0x02
	F3_FMULX int = 0x03
	F3_FCMEQ int = 0x04
	F3_FMAX int = 0x06
	F3_FRECPS int = 0x07
	F3_FMINNM int = 0x08
	F3_FMLS int = 0x09
	F3_FSUB int = 0x0A
	F3_FAMAX int = 0x0B
	F3_FMIN int = 0x0E
	F3_FRSQRTS int = 0x0F
	F3_FMAXNMP int = 0x10
	F3_FADDP int = 0x12
	F3_FMUL int = 0x13
	F3_FCMGE int = 0x14
	F3_FACGE int = 0x15
	F3_FMAXP int = 0x16
	F3_FDIV int = 0x17
	F3_FMINNMP int = 0x18
	F3_FABD int = 0x1A
	F3_FAMIN int = 0x1B
	F3_FCMGT int = 0x1C
	F3_FACGT int = 0x1D
	F3_FMINP int = 0x1E
	F3_FSCALE int = 0x1F
)

// FPThreeSame emits the vector form `Vd.<T>, Vn.<T>, Vm.<T>` of an F3_* operation of
// precision ft: isa.FT_H (4H / 8H), isa.FT_S (2S / 4S, by q) or isa.FT_D (2D; q set).
func FPThreeSame(a @asm.Assembler, op int, q bool, ft int, rd int, rn int, rm int)

// FPThreeSameScalar emits the scalar form `<V>d, <V>n, <V>m` (H, S or D, by ft) of
// FMULX, FCMEQ, FRECPS, FRSQRTS, FCMGE, FACGE, FABD, FCMGT or FACGT.
func FPThreeSameScalar(a @asm.Assembler, op int, ft int, rd int, rn int, rm int)

// Rdmlah emits SQRDMLAH (or SQRDMLSH, sub) `Vd.<T>, Vn.<T>, Vm.<T>` on a 128-bit (q) or
// 64-bit vector of H (size 1) or S (size 2) elements.
func Rdmlah(a @asm.Assembler, sub bool, q bool, size int, rd int, rn int, rm int)

// RdmlahScalar emits SQRDMLAH (or SQRDMLSH, sub) `<V>d, <V>n, <V>m` on H (size 1) or S
// (size 2) registers.
func RdmlahScalar(a @asm.Assembler, sub bool, size int, rd int, rn int, rm int)

// Advanced SIMD 8-bit dot products (DotProduct / DotProductElem): signed, unsigned,
// unsigned Vn by signed Vm, and signed Vn by unsigned Vm (by element only).
const (
	DOT_SDOT int = 0
	DOT_UDOT int = 1
	DOT_USDOT int = 2
	DOT_SUDOT int = 3
)

// DotProduct emits a DOT_* dot product `Vd.2S|4S, Vn.8B|16B, Vm.8B|16B` (by q); DOT_SUDOT
// has no such form.
func DotProduct(a @asm.Assembler, op int, q bool, rd int, rn int, rm int)

// Advanced SIMD 8-bit integer matrix multiply-accumulates (IntMatMul): signed,
// unsigned, and unsigned Vn by signed Vm.
const (
	MM_SMMLA int = 0
	MM_UMMLA int = 1
	MM_USMMLA int = 2
)

// IntMatMul emits an MM_* matrix multiply-accumulate `Vd.4S, Vn.16B, Vm.16B`.
func IntMatMul(a @asm.Assembler, op int, rd int, rn int, rm int)

// FCmla emits FCMLA `Vd.<T>, Vn.<T>, Vm.<T>, #rot` on a 128-bit (q) or 64-bit vector of
// size (1..3: H, S, D; D only with q) elements, rot 0..3 for 0, 90, 180 and 270 degrees.
func FCmla(a @asm.Assembler, q bool, size int, rot int, rd int, rn int, rm int)

// FCadd emits FCADD `Vd.<T>, Vn.<T>, Vm.<T>, #90` (or #270, rot270) on a 128-bit (q) or
// 64-bit vector of size (1..3: H, S, D; D only with q) elements.
func FCadd(a @asm.Assembler, q bool, size int, rot270 bool, rd int, rn int, rm int)

// BFDot emits BFDOT `Vd.2S|4S, Vn.4H|8H, Vm.4H|8H` (by q).
func BFDot(a @asm.Assembler, q bool, rd int, rn int, rm int)

// BFMatMul emits BFMMLA `Vd.4S, Vn.8H, Vm.8H`.
func BFMatMul(a @asm.Assembler, rd int, rn int, rm int)

// BFMlal emits BFMLALB (or BFMLALT, top) `Vd.4S, Vn.8H, Vm.8H`.
func BFMlal(a @asm.Assembler, top bool, rd int, rn int, rm int)

// Half-to-single widening multiply-accumulates (FMlal, FEAT_FHM): add or subtract,
// from the low or the high half-precision elements.
const (
	FHM_FMLAL int = 0
	FHM_FMLSL int = 1
	FHM_FMLAL2 int = 2
	FHM_FMLSL2 int = 3
)

// FMlal emits an FHM_* multiply-accumulate `Vd.2S|4S, Vn.2H|4H, Vm.2H|4H` (by q).
func FMlal(a @asm.Assembler, op int, q bool, rd int, rn int, rm int)

// FP8Dot emits FDOT `Vd.4H|8H, Vn.8B|16B, Vm.8B|16B` (into H) or, toS, `Vd.2S|4S, …`
// (into S); q selects the 128-bit forms.
func FP8Dot(a @asm.Assembler, toS bool, q bool, rd int, rn int, rm int)

// FP8Mlal emits FMLALB (or FMLALT, top) `Vd.8H, Vn.16B, Vm.16B`.
func FP8Mlal(a @asm.Assembler, top bool, rd int, rn int, rm int)

// The four quarters of the FP8 elements that FMLALL<xy> widens into S (FP8Mlall):
// bit 1 is the first letter (T), bit 0 the second.
const (
	FP8_MLALLBB int = 0
	FP8_MLALLBT int = 1
	FP8_MLALLTB int = 2
	FP8_MLALLTT int = 3
)

// FP8Mlall emits FMLALL<xy> (which, an FP8_MLALL* value) `Vd.4S, Vn.16B, Vm.16B`.
func FP8Mlall(a @asm.Assembler, which int, rd int, rn int, rm int)

// FP8Cvtn emits the FP8 FCVTN `Vd.8B, Vn.4H, Vm.4H` (q: `Vd.16B, Vn.8H, Vm.8H`) or,
// fromS, `FCVTN Vd.8B, Vn.4S, Vm.4S` (q: `FCVTN2 Vd.16B, Vn.4S, Vm.4S`).
func FP8Cvtn(a @asm.Assembler, fromS bool, q bool, rd int, rn int, rm int)

// FP8MatMul emits FMMLA `Vd.8H, Vn.16B, Vm.16B` or, toS, `Vd.4S, Vn.16B, Vm.16B`.
func FP8MatMul(a @asm.Assembler, toS bool, rd int, rn int, rm int)

// Advanced SIMD three-different operations (ThreeDiff / ThreeDiffScalar): bit 4
// is the U bit, bits 3:0 the opcode (instruction bits 15:12).  The long operations are
// ADDL, SUBL, ABAL, ABDL, MLAL, MLSL, MULL, the SQDM* and PMULL; the wide ADDW / SUBW;
// the narrowing ADDHN / SUBHN and their rounding RADDHN / RSUBHN.
const (
	T3_SADDL int = 0x00
	T3_SADDW int = 0x01
	T3_SSUBL int = 0x02
	T3_SSUBW int = 0x03
	T3_ADDHN int = 0x04
	T3_SABAL int = 0x05
	T3_SUBHN int = 0x06
	T3_SABDL int = 0x07
	T3_SMLAL int = 0x08
	T3_SQDMLAL int = 0x09
	T3_SMLSL int = 0x0A
	T3_SQDMLSL int = 0x0B
	T3_SMULL int = 0x0C
	T3_SQDMULL int = 0x0D
	T3_PMULL int = 0x0E
	T3_UADDL int = 0x10
	T3_UADDW int = 0x11
	T3_USUBL int = 0x12
	T3_USUBW int = 0x13
	T3_RADDHN int = 0x14
	T3_UABAL int = 0x15
	T3_RSUBHN int = 0x16
	T3_UABDL int = 0x17
	T3_UMLAL int = 0x18
	T3_UMLSL int = 0x1A
	T3_UMULL int = 0x1C
)

// ThreeDiff emits the vector form of a T3_* operation with narrow element size size
// (0..2: B, H, S; PMULL also 3, the 128-bit product), q selecting the "2" (upper-half)
// form.
func ThreeDiff(a @asm.Assembler, op int, q bool, size int, rd int, rn int, rm int)

// ThreeDiffScalar emits SQDMLAL / SQDMLSL / SQDMULL `Sd, Hn, Hm` (size 1) or `Dd, Sn,
// Sm` (size 2).
func ThreeDiffScalar(a @asm.Assembler, op int, size int, rd int, rn int, rm int)

// Advanced SIMD integer two-register miscellaneous operations (TwoRegMisc /
// TwoRegMiscScalar): bit 5 is the U bit, bits 4:0 the opcode (instruction bits
// 16:12).  NOT and RBIT share U=1 opcode 00101, told apart by the size field; RBIT's
// value here (0x65) is not an encoding.  The *0 operations compare against zero.
const (
	M2_REV64 int = 0x00
	M2_REV16 int = 0x01
	M2_SADDLP int = 0x02
	M2_SUQADD int = 0x03
	M2_CLS int = 0x04
	M2_CNT int = 0x05
	M2_SADALP int = 0x06
	M2_SQABS int = 0x07
	M2_CMGT0 int = 0x08
	M2_CMEQ0 int = 0x09
	M2_CMLT0 int = 0x0A
	M2_ABS int = 0x0B
	M2_XTN int = 0x12
	M2_SQXTN int = 0x14
	M2_REV32 int = 0x20
	M2_UADDLP int = 0x22
	M2_USQADD int = 0x23
	M2_CLZ int = 0x24
	M2_NOT int = 0x25
	M2_UADALP int = 0x26
	M2_SQNEG int = 0x27
	M2_CMGE0 int = 0x28
	M2_CMLE0 int = 0x29
	M2_NEG int = 0x2B
	M2_SQXTUN int = 0x32
	M2_SHLL int = 0x33
	M2_UQXTN int = 0x34
	M2_RBIT int = 0x65
)

// TwoRegMisc emits the vector form of an M2_* operation at element size size (the
// source's for the pairwise and SHLL forms, the narrow destination's for the narrowing
// ones) on a 128-bit (q) or 64-bit vector; for the narrowing operations and SHLL, q
// selects the "2" form.
func TwoRegMisc(a @asm.Assembler, op int, q bool, size int, rd int, rn int)

// TwoRegMiscScalar emits the scalar form of an M2_* operation at element size size (the
// narrow destination's for SQXTN / UQXTN / SQXTUN).
func TwoRegMiscScalar(a @asm.Assembler, op int, size int, rd int, rn int)

// Advanced SIMD floating-point two-register miscellaneous operations (FPTwoRegMisc /
// FPTwoRegMiscScalar): bit 6 is the U bit, bit 5 the a bit (instruction bit 23), bits
// 4:0 the opcode (bits 16:12) — the same in the single / double and half-precision
// encodings.  The *0 operations compare against zero; URECPE / URSQRTE are the integer
// reciprocal estimates on S elements that share this half of the class; FCVTN / FCVTL /
// FCVTXN / BFCVTN change the element size (FPNarrowWiden, FCvtxnScalar).
const (
	F2_FCVTN int = 0x16
	F2_FCVTL int = 0x17
	F2_FRINTN int = 0x18
	F2_FRINTM int = 0x19
	F2_FCVTNS int = 0x1A
	F2_FCVTMS int = 0x1B
	F2_FCVTAS int = 0x1C
	F2_SCVTF int = 0x1D
	F2_FRINT32Z int = 0x1E
	F2_FRINT64Z int = 0x1F
	F2_FCMGT0 int = 0x2C
	F2_FCMEQ0 int = 0x2D
	F2_FCMLT0 int = 0x2E
	F2_FABS int = 0x2F
	F2_BFCVTN int = 0x36
	F2_FRINTP int = 0x38
	F2_FRINTZ int = 0x39
	F2_FCVTPS int = 0x3A
	F2_FCVTZS int = 0x3B
	F2_URECPE int = 0x3C
	F2_FRECPE int = 0x3D
	F2_FRECPX int = 0x3F
	F2_FCVTXN int = 0x56
	F2_FRINTA int = 0x58
	F2_FRINTX int = 0x59
	F2_FCVTNU int = 0x5A
	F2_FCVTMU int = 0x5B
	F2_FCVTAU int = 0x5C
	F2_UCVTF int = 0x5D
	F2_FRINT32X int = 0x5E
	F2_FRINT64X int = 0x5F
	F2_FCMGE0 int = 0x6C
	F2_FCMLE0 int = 0x6D
	F2_FNEG int = 0x6F
	F2_FRINTI int = 0x79
	F2_FCVTPU int = 0x7A
	F2_FCVTZU int = 0x7B
	F2_URSQRTE int = 0x7C
	F2_FRSQRTE int = 0x7D
	F2_FSQRT int = 0x7F
)

// FPTwoRegMisc emits the vector form `Vd.<T>, Vn.<T>` of an F2_* operation of precision
// ft: isa.FT_H (4H / 8H), isa.FT_S (2S / 4S, by q) or isa.FT_D (2D; q set).  FRINT32* /
// FRINT64* have no H form, URECPE / URSQRTE only S, FRECPX no vector form.
func FPTwoRegMisc(a @asm.Assembler, op int, q bool, ft int, rd int, rn int)

// FPTwoRegMiscScalar emits the scalar form `<V>d, <V>n` (H, S or D, by ft) of FRECPE,
// FRSQRTE, FRECPX, a compare against zero, or a conversion between floating-point and
// integer values of one size (FCVT{N,M,A,P,Z}{S,U}, SCVTF, UCVTF).
func FPTwoRegMiscScalar(a @asm.Assembler, op int, ft int, rd int, rn int)

// FPNarrowWiden emits F2_FCVTN / F2_FCVTXN / F2_BFCVTN (`Vd.<Tb>, Vn.<Ta>`) or F2_FCVTL
// (`Vd.<Ta>, Vn.<Tb>`), the wide arrangement Ta of precision wide (isa.FT_S: 4S against 4H
// / 8H; isa.FT_D: 2D against 2S / 4S), q selecting the "2" form.  FCVTXN is from D only,
// BFCVTN from S only.
func FPNarrowWiden(a @asm.Assembler, op int, q bool, wide int, rd int, rn int)

// FCvtxnScalar emits the scalar FCVTXN `Sd, Dn`.
func FCvtxnScalar(a @asm.Assembler, rd int, rn int)

// The FEAT_FP8 lengthening conversions (FP8Lengthen), the size field of FCVTL's opcode
// with U set: to half precision (F1CVTL, F2CVTL) or to BFloat16 (BF1CVTL, BF2CVTL), from
// the FP8 format of FPMR's first or second source field.
const (
	FP8CVTL_F1 int = 0
	FP8CVTL_F2 int = 1
	FP8CVTL_BF1 int = 2
	FP8CVTL_BF2 int = 3
)

// FP8Lengthen emits F1CVTL / F2CVTL / BF1CVTL / BF2CVTL (which, an FP8CVTL_* value)
// `Vd.8H, Vn.8B`, or the "2" form `Vd.8H, Vn.16B` (q).
func FP8Lengthen(a @asm.Assembler, which int, q bool, rd int, rn int)

// Advanced SIMD integer across-lanes reductions (AcrossLanes): bit 5 is the U bit, bits
// 4:0 the opcode (instruction bits 16:12).
const (
	AL_SADDLV int = 0x03
	AL_SMAXV int = 0x0A
	AL_SMINV int = 0x1A
	AL_ADDV int = 0x1B
	AL_UADDLV int = 0x23
	AL_UMAXV int = 0x2A
	AL_UMINV int = 0x3A
)

// AcrossLanes emits an AL_* reduction `<V>d, Vn.<T>` of a 128-bit (q) or 64-bit vector of
// size-byte elements (size 0..2: 8B / 16B, 4H / 8H, 4S — no 2S); the scalar is the element
// size, or twice it for SADDLV / UADDLV.
func AcrossLanes(a @asm.Assembler, op int, q bool, size int, rd int, rn int)

// Advanced SIMD floating-point across-lanes reductions (FPAcrossLanes): bit 5 is the a bit
// (instruction bit 23), bits 4:0 the opcode.
const (
	FAL_FMAXNMV int = 0x0C
	FAL_FMAXV int = 0x0F
	FAL_FMINNMV int = 0x2C
	FAL_FMINV int = 0x2F
)

// FPAcrossLanes emits an FAL_* reduction `Sd, Vn.4S` (ft isa.FT_S, q set) or `Hd, Vn.4H|8H`
// (ft isa.FT_H, by q).
func FPAcrossLanes(a @asm.Assembler, op int, q bool, ft int, rd int, rn int)

// AddpScalar emits the scalar pairwise ADDP `Dd, Vn.2D`.
func AddpScalar(a @asm.Assembler, rd int, rn int)

// Advanced SIMD floating-point scalar pairwise reductions (FPPairwiseScalar): bit 5 is the
// a bit (instruction bit 23), bits 4:0 the opcode.
const (
	FPW_FMAXNMP int = 0x0C
	FPW_FADDP int = 0x0D
	FPW_FMAXP int = 0x0F
	FPW_FMINNMP int = 0x2C
	FPW_FMINP int = 0x2F
)

// FPPairwiseScalar emits an FPW_* reduction `Hd, Vn.2H` (ft isa.FT_H), `Sd, Vn.2S`
// (isa.FT_S) or `Dd, Vn.2D` (isa.FT_D).
func FPPairwiseScalar(a @asm.Assembler, op int, ft int, rd int, rn int)

// MoviBytes emits MOVI `Vd.8B|16B, #imm8` (q: 16B).
func MoviBytes(a @asm.Assembler, q bool, imm8 int, rd int)

// The shifted-immediate operations (ShiftedImm): move, move inverted, OR, bit clear.
const (
	MI_MOVI int = 0
	MI_MVNI int = 1
	MI_ORR int = 2
	MI_BIC int = 3
)

// ShiftedImm emits an MI_* operation `Vd.<T>, #imm8{, LSL #shift}` on 16-bit (size 1: 4H /
// 8H, shift 0 or 8) or 32-bit (size 2: 2S / 4S, shift 0, 8, 16 or 24) elements.
func ShiftedImm(a @asm.Assembler, op int, q bool, size int, imm8 int, shift int, rd int)

// MoviOnes emits MOVI (or MVNI, inv) `Vd.2S|4S, #imm8, MSL #shift` (shift 8 or 16).
func MoviOnes(a @asm.Assembler, inv bool, q bool, imm8 int, shift int, rd int)

// Movi64 emits MOVI `Dd, #imm` or (vector) `Vd.2D, #imm`, imm's bytes each 0x00 or 0xFF.
func Movi64(a @asm.Assembler, vector bool, imm uint64, rd int)

// FMovVecImm emits FMOV `Vd.<T>, #imm` of the 8-bit floating-point immediate imm8 to every
// element: ft isa.FT_H (4H / 8H), isa.FT_S (2S / 4S) or isa.FT_D (2D; q set).
func FMovVecImm(a @asm.Assembler, ft int, q bool, imm8 int, rd int)

// Advanced SIMD shift-by-immediate operations (ShiftImm / ShiftImmScalar): bit 5 is the U
// bit, bits 4:0 the opcode (instruction bits 15:11).
const (
	SH_SSHR int = 0x00
	SH_SSRA int = 0x02
	SH_SRSHR int = 0x04
	SH_SRSRA int = 0x06
	SH_SHL int = 0x0A
	SH_SQSHL int = 0x0E
	SH_SHRN int = 0x10
	SH_RSHRN int = 0x11
	SH_SQSHRN int = 0x12
	SH_SQRSHRN int = 0x13
	SH_SSHLL int = 0x14
	SH_SCVTF int = 0x1C
	SH_FCVTZS int = 0x1F
	SH_USHR int = 0x20
	SH_USRA int = 0x22
	SH_URSHR int = 0x24
	SH_URSRA int = 0x26
	SH_SRI int = 0x28
	SH_SLI int = 0x2A
	SH_SQSHLU int = 0x2C
	SH_UQSHL int = 0x2E
	SH_SQSHRUN int = 0x30
	SH_SQRSHRUN int = 0x31
	SH_UQSHRN int = 0x32
	SH_UQRSHRN int = 0x33
	SH_USHLL int = 0x34
	SH_UCVTF int = 0x3C
	SH_FCVTZU int = 0x3F
)

// ShiftImm emits the vector form of an SH_* operation at element size size (the narrow
// element's for the narrowing and long forms; H / S / D for the fixed-point ones) and
// shift (or fraction bits) shift, on a 128-bit (q) or 64-bit vector; for the narrowing and
// long forms q selects the "2" form.
func ShiftImm(a @asm.Assembler, op int, q bool, size int, shift int, rd int, rn int)

// ShiftImmScalar emits the scalar form of an SH_* operation at element size size (the
// narrow result's for the narrowing forms).
func ShiftImmScalar(a @asm.Assembler, op int, size int, shift int, rd int, rn int)

// Advanced SIMD vector-by-element operations (ByElement / ByElementScalar): bit 4 is the U
// bit, bits 3:0 the opcode (instruction bits 15:12).
const (
	EL_FMLA int = 0x01
	EL_SMLAL int = 0x02
	EL_SQDMLAL int = 0x03
	EL_FMLS int = 0x05
	EL_SMLSL int = 0x06
	EL_SQDMLSL int = 0x07
	EL_MUL int = 0x08
	EL_FMUL int = 0x09
	EL_SMULL int = 0x0A
	EL_SQDMULL int = 0x0B
	EL_SQDMULH int = 0x0C
	EL_SQRDMULH int = 0x0D
	EL_MLA int = 0x10
	EL_UMLAL int = 0x12
	EL_MLS int = 0x14
	EL_UMLSL int = 0x16
	EL_FMULX int = 0x19
	EL_UMULL int = 0x1A
	EL_SQRDMLAH int = 0x1D
	EL_SQRDMLSH int = 0x1F
)

// ByElement emits the vector form of an EL_* operation with element size esize (1..3: H,
// S, D — D only for FMLA / FMLS / FMUL / FMULX, on 2D) and Vm.<Ts>[index] (H: index 0..7,
// Vm 0..15; S: 0..3; D: 0..1), on a 128-bit (q) or 64-bit vector; for the long operations
// esize is the source's and q selects the "2" form.
func ByElement(a @asm.Assembler, op int, q bool, esize int, rd int, rn int, rm int, index int)

// ByElementScalar emits the scalar form of an EL_* operation (the floating-point ones,
// SQDMULH / SQRDMULH / SQRDMLAH / SQRDMLSH, SQDMLAL / SQDMLSL / SQDMULL) with element size
// esize (the source's for the long ones).
func ByElementScalar(a @asm.Assembler, op int, esize int, rd int, rn int, rm int, index int)

// DotProductElem emits a DOT_* dot product `Vd.2S|4S, Vn.8B|16B, Vm.4B[index]` (by q;
// index 0..3).
func DotProductElem(a @asm.Assembler, op int, q bool, rd int, rn int, rm int, index int)

// BFDotElem emits BFDOT `Vd.2S|4S, Vn.4H|8H, Vm.2H[index]` (by q; index 0..3).
func BFDotElem(a @asm.Assembler, q bool, rd int, rn int, rm int, index int)

// BFMlalElem emits BFMLALB (or BFMLALT, top) `Vd.4S, Vn.8H, Vm.H[index]` (index 0..7, Vm
// V0..V15).
func BFMlalElem(a @asm.Assembler, top bool, rd int, rn int, rm int, index int)

// FMlalElem emits an FHM_* multiply-accumulate `Vd.2S|4S, Vn.2H|4H, Vm.H[index]` (by q;
// index 0..7, Vm V0..V15).
func FMlalElem(a @asm.Assembler, op int, q bool, rd int, rn int, rm int, index int)

// FCmlaElem emits FCMLA `Vd.<T>, Vn.<T>, Vm.<Ts>[index], #rot` (rot 0..3 for 0, 90, 180
// and 270 degrees) on 4H (index 0..1) or, q, 8H (0..3) for size 1, or 4S (q; index 0..1)
// for size 2.
func FCmlaElem(a @asm.Assembler, q bool, size int, rot int, rd int, rn int, rm int, index int)

// FP8DotElem emits FDOT `Vd.4H|8H, Vn.8B|16B, Vm.2B[index]` (index 0..7, Vm V0..V15) or,
// toS, `Vd.2S|4S, Vn.8B|16B, Vm.4B[index]` (index 0..3); q selects the 128-bit forms.
func FP8DotElem(a @asm.Assembler, toS bool, q bool, rd int, rn int, rm int, index int)

// FP8MlalElem emits FMLALB (or FMLALT, top) `Vd.8H, Vn.16B, Vm.B[index]` (index 0..15, Vm
// V0..V7).
func FP8MlalElem(a @asm.Assembler, top bool, rd int, rn int, rm int, index int)

// FP8MlallElem emits FMLALL<xy> (which, an FP8_MLALL* value) `Vd.4S, Vn.16B, Vm.B[index]`
// (index 0..15, Vm V0..V7).
func FP8MlallElem(a @asm.Assembler, which int, rd int, rn int, rm int, index int)

// Advanced SIMD permutes (Permute): the opcode (instruction bits 14:12).
const (
	PERM_UZP1 int = 1
	PERM_TRN1 int = 2
	PERM_ZIP1 int = 3
	PERM_UZP2 int = 5
	PERM_TRN2 int = 6
	PERM_ZIP2 int = 7
)

// Permute emits a PERM_* permute `Vd.<T>, Vn.<T>, Vm.<T>` on a 128-bit (q) or 64-bit
// vector of size (0..3: B, H, S, D; D only with q) elements.
func Permute(a @asm.Assembler, op int, q bool, size int, rd int, rn int, rm int)

// Ext emits EXT `Vd.<T>, Vn.<T>, Vm.<T>, #index`, <T> 16B (q; index 0..15) or 8B (index
// 0..7).
func Ext(a @asm.Assembler, q bool, rd int, rn int, rm int, index int)

// LdStMulti emits LD<selem> (load) or ST<selem> `{Vt.<T>, …}, [Xn|SP]` — the multiple
// structures of selem (1..4) elements over nreg consecutive registers from Vt (nreg =
// selem, or 1..4 for LD1 / ST1) — on a 128-bit (q) or 64-bit vector of size (0..3: B,
// H, S, D; 1D only for LD1 / ST1) elements.
func LdStMulti(a @asm.Assembler, load bool, selem int, nreg int, q bool, size int, rt int, rn int)

// LdStMultiPostImm emits LdStMulti's instruction post-indexed by imm, which must be the
// transfer size: nreg × 16 bytes (q) or nreg × 8.
func LdStMultiPostImm(a @asm.Assembler, load bool, selem int, nreg int, q bool, size int, rt int,
		rn int, imm int)

// LdStMultiPostReg emits LdStMulti's instruction post-indexed by Xm (rm 0..30; register
// 31 there selects the immediate form, so XZR is not a post-index register).
func LdStMultiPostReg(a @asm.Assembler, load bool, selem int, nreg int, q bool, size int, rt int,
		rn int, rm int)

// LdStSingle emits LD<selem> (load) or ST<selem> `{Vt.<Ts>, …}[index], [Xn|SP]`: element
// index of size (0..3: B, H, S, D; index 0..15 / 7 / 3 / 1) in each of selem (1..4)
// consecutive registers from Vt.
func LdStSingle(a @asm.Assembler, load bool, selem int, size int, index int, rt int, rn int)

// LdStSinglePostImm emits LdStSingle's instruction post-indexed by imm, which must be the
// transfer size: selem × the element's bytes.
func LdStSinglePostImm(a @asm.Assembler, load bool, selem int, size int, index int, rt int, rn int,
		imm int)

// LdStSinglePostReg emits LdStSingle's instruction post-indexed by Xm (rm 0..30; register
// 31 there selects the immediate form).
func LdStSinglePostReg(a @asm.Assembler, load bool, selem int, size int, index int, rt int, rn int,
		rm int)

// LdRep emits LD<selem>R `{Vt.<T>, …}, [Xn|SP]`: one element of size (0..3) loaded into
// every lane of each of selem (1..4) consecutive registers, a 128-bit (q) or 64-bit
// vector.
func LdRep(a @asm.Assembler, selem int, q bool, size int, rt int, rn int)

// LdRepPostImm emits LdRep's instruction post-indexed by imm, which must be the transfer
// size: selem × the element's bytes.
func LdRepPostImm(a @asm.Assembler, selem int, q bool, size int, rt int, rn int, imm int)

// LdRepPostReg emits LdRep's instruction post-indexed by Xm (rm 0..30).
func LdRepPostReg(a @asm.Assembler, selem int, q bool, size int, rt int, rn int, rm int)

// Ldap1 emits LDAP1 (load-acquire) or, !load, STL1 (store-release) `{Vt.D}[index],
// [Xn|SP]` (index 0..1).
func Ldap1(a @asm.Assembler, load bool, index int, rt int, rn int)

// TableLookup emits TBL (or TBX, tbx) `Vd.<T>, {Vn.16B, …}, Vm.<T>` with a table of
// count (1..4) consecutive registers from Rn; <T> is 16B (q) or 8B.
func TableLookup(a @asm.Assembler, q bool, tbx bool, rd int, rn int, count int, rm int)
