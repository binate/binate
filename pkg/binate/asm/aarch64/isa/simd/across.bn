package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD reductions to a scalar: the across-lanes class
// (ADDV, SADDLV / UADDLV, SMAXV / UMAXV / SMINV / UMINV, and FMAXNMV / FMINNMV / FMAXV /
// FMINV on 4S or, FEAT_FP16, 4H / 8H) and the scalar pairwise class (ADDP on 2D, and
// FADDP / FMAXP / FMINP / FMAXNMP / FMINNMP on 2S, 2D or, FEAT_FP16, 2H).

// AcrossLanes emits an AL_* integer reduction `<V>d, Vn.<T>` of a 128-bit (q) or 64-bit
// vector of size-byte elements (size 0..2: 8B / 16B, 4H / 8H, 4S — no 2S); the scalar is
// the element size, or twice it for SADDLV / UADDLV.
func AcrossLanes(a @asm.Assembler, op int, q bool, size int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var opOk bool = op == AL_SADDLV || op == AL_UADDLV || op == AL_SMAXV || op == AL_UMAXV ||
			op == AL_SMINV || op == AL_UMINV || op == AL_ADDV
	if !opOk || size < 0 || size > 2 || (size == 2 && !q) {
		a.SetError("simd across lanes: 8B / 16B / 4H / 8H / 4S only")
		return
	}
	var inst uint32 = 0x0E300800 | (cast(uint32, op >> 5) << 29) | (cast(uint32, size) << 22) |
			(cast(uint32, op & 0x1F) << 12) | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// FPAcrossLanes emits an FAL_* floating-point reduction: `Sd, Vn.4S` (ft isa.FT_S, q
// set) or `Hd, Vn.4H|8H` (ft isa.FT_H, by q).
func FPAcrossLanes(a @asm.Assembler, op int, q bool, ft int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var opOk bool = op == FAL_FMAXNMV || op == FAL_FMINNMV || op == FAL_FMAXV || op == FAL_FMINV
	if !opOk || (ft != isa.FT_H && (ft != isa.FT_S || !q)) {
		a.SetError("simd fp across lanes: 4S, or 4H / 8H")
		return
	}
	var inst uint32 = 0x0E300800 | (cast(uint32, op >> 5) << 23) | (cast(uint32, op & 0x1F) << 12) |
			(cast(uint32, rn) << 5) | cast(uint32, rd)
	if ft == isa.FT_S { inst = inst | 0x20000000 }
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// AddpScalar emits the scalar pairwise ADDP `Dd, Vn.2D`.
func AddpScalar(a @asm.Assembler, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	isa.Emit32(a, 0x5EF1B800 | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FPPairwiseScalar emits an FPW_* scalar pairwise reduction `<V>d, Vn.2<V>` (ft isa.FT_H:
// `Hd, Vn.2H`; isa.FT_S: `Sd, Vn.2S`; isa.FT_D: `Dd, Vn.2D`).
func FPPairwiseScalar(a @asm.Assembler, op int, ft int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var opOk bool = op == FPW_FADDP || op == FPW_FMAXP || op == FPW_FMINP || op == FPW_FMAXNMP ||
			op == FPW_FMINNMP
	if !opOk || (ft != isa.FT_H && ft != isa.FT_S && ft != isa.FT_D) {
		a.SetError("simd fp scalar pairwise: from 2H, 2S or 2D")
		return
	}
	var inst uint32 = 0x5E300800 | (cast(uint32, op >> 5) << 23) | (cast(uint32, op & 0x1F) << 12) |
			(cast(uint32, rn) << 5) | cast(uint32, rd)
	if ft != isa.FT_H { inst = inst | 0x20000000 }
	if ft == isa.FT_D { inst = inst | 0x00400000 }
	isa.Emit32(a, inst)
}
