package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/builtins/testing"

// The reduction encoders' own checks: the operation sets, the arrangements each takes (no
// 2S or D elements across lanes; the floating-point ones 4S or 4H / 8H), and register
// range (the text assembler's golden tables cover every encoding).

func TestAcrossLanesChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AcrossLanes(a, AL_ADDV, true, 0, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E31B81F) { return fail("addv b31, v0.16b") }
	a = newAsm()
	AcrossLanes(a, AL_UADDLV, true, 2, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EB03BE0) { return fail("uaddlv d0, v31.4s") }
	a = newAsm()
	AcrossLanes(a, AL_SMAXV, false, 2, 0, 1)
	if !rejected(a) { return fail("smaxv of 2s") }
	a = newAsm()
	AcrossLanes(a, AL_ADDV, true, 3, 0, 1)
	if !rejected(a) { return fail("addv of 2d") }
	a = newAsm()
	AcrossLanes(a, 0x1C, true, 0, 0, 1)
	if !rejected(a) { return fail("an operation that is not a reduction") }
	a = newAsm()
	FPAcrossLanes(a, FAL_FMAXNMV, true, isa.FT_H, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E30C81F) { return fail("fmaxnmv h31, v0.8h") }
	a = newAsm()
	FPAcrossLanes(a, FAL_FMINV, true, isa.FT_S, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EB0FBE0) { return fail("fminv s0, v31.4s") }
	a = newAsm()
	FPAcrossLanes(a, FAL_FMAXV, false, isa.FT_S, 0, 1)
	if !rejected(a) { return fail("fmaxv of 2s") }
	a = newAsm()
	FPAcrossLanes(a, FAL_FMAXV, true, isa.FT_D, 0, 1)
	if !rejected(a) { return fail("fmaxv of 2d") }
	a = newAsm()
	AcrossLanes(a, AL_UMINV, true, 0, 32, 1)
	if !rejected(a) { return fail("Bd register 32") }
	return ""
}

func TestPairwiseScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddpScalar(a, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x5EF1B81F) { return fail("addp d31, v0.2d") }
	a = newAsm()
	FPPairwiseScalar(a, FPW_FADDP, isa.FT_D, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x7E70DBE0) { return fail("faddp d0, v31.2d") }
	a = newAsm()
	FPPairwiseScalar(a, FPW_FMINNMP, isa.FT_H, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x5EB0C81F) { return fail("fminnmp h31, v0.2h") }
	a = newAsm()
	FPPairwiseScalar(a, 0x0E, isa.FT_S, 0, 1)
	if !rejected(a) { return fail("an operation that is not a pairwise reduction") }
	a = newAsm()
	FPPairwiseScalar(a, FPW_FADDP, 2, 0, 1)
	if !rejected(a) { return fail("precision 2") }
	a = newAsm()
	AddpScalar(a, 0, -1)
	if !rejected(a) { return fail("Vn register -1") }
	return ""
}
