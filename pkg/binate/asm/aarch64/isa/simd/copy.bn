package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD copy instructions: DUP (from a vector element to
// a vector or a scalar; from a general-purpose register), INS (from a general-purpose
// register or a vector element), UMOV and SMOV.  An element is given by its size (0..3:
// B, H, S, D) and its index within a 128-bit register; the imm5 field encodes both.
// Vector registers are 0..31; a general-purpose one is zero-or-register.

// simdLaneOk reports whether size is an element size (0..3) and index a lane of it in a
// 128-bit register (16 >> size lanes), setting the assembler error otherwise.
func simdLaneOk(a @asm.Assembler, size int, index int) bool {
	if size < 0 || size > 3 || index < 0 || index >= (16 >> size) {
		a.SetError("simd: invalid element size or lane index")
		return false
	}
	return true
}

// simdImm5 encodes an element size and lane index as imm5: the index above a marker bit
// at position size.
func simdImm5(size int, index int) uint32 {
	return (cast(uint32, index) << cast(uint32, size + 1)) | (cast(uint32, 1) << cast(uint32, size))
}

// simdCopy packs the copy class's Q, imm5, Rn and Rd into base.
func simdCopy(base uint32, q bool, imm5 uint32, rn int, rd int) uint32 {
	var inst uint32 = base | (imm5 << 16) | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	return inst
}

// DupElement emits DUP `Vd.<T>, Vn.<Ts>[index]`: the 128-bit (q) or 64-bit vector of
// size-byte elements, each set to lane index of Vn.  The 64-bit D arrangement (1D) is
// reserved.
func DupElement(a @asm.Assembler, q bool, size int, rd int, rn int, index int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, index) { return }
	if size == 3 && !q {
		a.SetError("dup: the 1D arrangement is reserved")
		return
	}
	isa.Emit32(a, simdCopy(0x0E000400, q, simdImm5(size, index), rn, rd))
}

// DupScalar emits DUP `<V>d, Vn.<T>[index]` (MOV's scalar alias): the scalar
// register of that element size set to lane index of Vn.
func DupScalar(a @asm.Assembler, size int, rd int, rn int, index int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, index) { return }
	isa.Emit32(a, simdCopy(0x5E000400, false, simdImm5(size, index), rn, rd))
}

// DupGeneral emits DUP `Vd.<T>, Rn`: every size-byte element of the 128-bit (q) or
// 64-bit vector set to Rn (a W register for B / H / S, X for D; 1D is reserved).
func DupGeneral(a @asm.Assembler, q bool, size int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, 0) { return }
	if size == 3 && !q {
		a.SetError("dup: the 1D arrangement is reserved")
		return
	}
	isa.Emit32(a, simdCopy(0x0E000C00, q, cast(uint32, 1) << cast(uint32, size), rn, rd))
}

// InsGeneral emits INS `Vd.<Ts>[index], Rn`: lane index of Vd set to Rn (W for
// B / H / S, X for D), the other lanes kept.
func InsGeneral(a @asm.Assembler, size int, rd int, index int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, index) { return }
	isa.Emit32(a, simdCopy(0x0E001C00, true, simdImm5(size, index), rn, rd))
}

// InsElement emits INS `Vd.<Ts>[dindex], Vn.<Ts>[sindex]`: one lane of Vd set to
// one lane of Vn, both of element size.
func InsElement(a @asm.Assembler, size int, rd int, dindex int, rn int, sindex int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, dindex) || !simdLaneOk(a, size, sindex) {
		return
	}
	var imm4 uint32 = cast(uint32, sindex) << cast(uint32, size)
	isa.Emit32(a, simdCopy(0x2E000400 | (imm4 << 11), true, simdImm5(size, dindex), rn, rd))
}

// Umov emits UMOV `Rd, Vn.<Ts>[index]`: the lane zero-extended into Rd (W for
// B / H / S, X for D).
func Umov(a @asm.Assembler, size int, rd int, rn int, index int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, index) { return }
	isa.Emit32(a, simdCopy(0x0E003C00, size == 3, simdImm5(size, index), rn, rd))
}

// Smov emits SMOV `Rd, Vn.<Ts>[index]`: the lane (B, H or S; size 0..2) sign-extended
// into a W or X (sf) register; an S lane needs X.
func Smov(a @asm.Assembler, sf bool, size int, rd int, rn int, index int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) || !simdLaneOk(a, size, index) { return }
	if size == 3 || (size == 2 && !sf) {
		a.SetError("smov: B / H lanes into W or X, an S lane into X")
		return
	}
	isa.Emit32(a, simdCopy(0x0E002C00, sf, simdImm5(size, index), rn, rd))
}
