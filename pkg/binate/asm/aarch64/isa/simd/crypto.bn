package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the cryptographic extensions: AES (AESE / AESD / AESMC / AESIMC),
// SHA-1 and SHA-256 (SHA1C / SHA1P / SHA1M / SHA1H / SHA1SU0 / SHA1SU1, SHA256H /
// SHA256H2 / SHA256SU0 / SHA256SU1), SHA-512 (SHA512H / SHA512H2 / SHA512SU0 /
// SHA512SU1), SHA-3 (EOR3 / BCAX / RAX1 / XAR), SM3 (SM3SS1, SM3TT1A / SM3TT1B /
// SM3TT2A / SM3TT2B, SM3PARTW1 / SM3PARTW2) and SM4 (SM4E / SM4EKEY).  Each CR_*
// operation has one fixed operand shape, so its encoder takes only registers.

// crBase returns the instruction word (register fields zero) of CR_* operation op and
// its register count (2, 3 or 4), or count 0.
func crBase(op int) (uint32, int) {
	if op == CR_AESE { return 0x4E284800, 2 }
	if op == CR_AESD { return 0x4E285800, 2 }
	if op == CR_AESMC { return 0x4E286800, 2 }
	if op == CR_AESIMC { return 0x4E287800, 2 }
	if op == CR_SHA1H { return 0x5E280800, 2 }
	if op == CR_SHA1SU1 { return 0x5E281800, 2 }
	if op == CR_SHA256SU0 { return 0x5E282800, 2 }
	if op == CR_SHA512SU0 { return 0xCEC08000, 2 }
	if op == CR_SM4E { return 0xCEC08400, 2 }
	if op == CR_SHA1C { return 0x5E000000, 3 }
	if op == CR_SHA1P { return 0x5E001000, 3 }
	if op == CR_SHA1M { return 0x5E002000, 3 }
	if op == CR_SHA1SU0 { return 0x5E003000, 3 }
	if op == CR_SHA256H { return 0x5E004000, 3 }
	if op == CR_SHA256H2 { return 0x5E005000, 3 }
	if op == CR_SHA256SU1 { return 0x5E006000, 3 }
	if op == CR_SHA512H { return 0xCE608000, 3 }
	if op == CR_SHA512H2 { return 0xCE608400, 3 }
	if op == CR_SHA512SU1 { return 0xCE608800, 3 }
	if op == CR_RAX1 { return 0xCE608C00, 3 }
	if op == CR_SM3PARTW1 { return 0xCE60C000, 3 }
	if op == CR_SM3PARTW2 { return 0xCE60C400, 3 }
	if op == CR_SM4EKEY { return 0xCE60C800, 3 }
	if op == CR_EOR3 { return 0xCE000000, 4 }
	if op == CR_BCAX { return 0xCE200000, 4 }
	if op == CR_SM3SS1 { return 0xCE400000, 4 }
	return 0, 0
}

// crEmit emits CR_* operation op, which must take count registers, or sets the error.
func crEmit(a @asm.Assembler, op int, count int, rd int, rn int, rm int, ra int) {
	if !isa.RegsOk(a, rd, rn, rm, ra) { return }
	base, n := crBase(op)
	if n != count {
		a.SetError("crypto: no such operation with this many registers")
		return
	}
	isa.Emit32(a,
			base | (cast(uint32, rm) << 16) | (cast(uint32, ra) << 10) | (cast(uint32, rn) << 5) |
					cast(uint32, rd))
}

// Crypto2 emits a two-register CR_* operation: AESE / AESD / AESMC / AESIMC `Vd.16B,
// Vn.16B`; SHA1H `Sd, Sn`; SHA1SU1 / SHA256SU0 / SM4E `Vd.4S, Vn.4S`; SHA512SU0 `Vd.2D,
// Vn.2D`.
func Crypto2(a @asm.Assembler, op int, rd int, rn int) {
	crEmit(a, op, 2, rd, rn, 0, 0)
}

// Crypto3 emits a three-register CR_* operation: SHA1C / SHA1P / SHA1M `Qd, Sn, Vm.4S`;
// SHA256H / SHA256H2 `Qd, Qn, Vm.4S`; SHA1SU0 / SHA256SU1 / SM3PARTW1 / SM3PARTW2 /
// SM4EKEY `Vd.4S, Vn.4S, Vm.4S`; SHA512H / SHA512H2 `Qd, Qn, Vm.2D`; SHA512SU1 / RAX1
// `Vd.2D, Vn.2D, Vm.2D`.
func Crypto3(a @asm.Assembler, op int, rd int, rn int, rm int) {
	crEmit(a, op, 3, rd, rn, rm, 0)
}

// Crypto4 emits a four-register CR_* operation: EOR3 / BCAX `Vd.16B, Vn.16B, Vm.16B,
// Va.16B`; SM3SS1 `Vd.4S, Vn.4S, Vm.4S, Va.4S`.
func Crypto4(a @asm.Assembler, op int, rd int, rn int, rm int, ra int) {
	crEmit(a, op, 4, rd, rn, rm, ra)
}

// Xar emits XAR `Vd.2D, Vn.2D, Vm.2D, #imm6` (0..63): Vn XOR Vm, rotated right by imm6.
func Xar(a @asm.Assembler, rd int, rn int, rm int, imm6 int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if imm6 < 0 || imm6 > 63 {
		a.SetError("xar: the rotation is 0..63")
		return
	}
	isa.Emit32(a,
			0xCE800000 | (cast(uint32, rm) << 16) | (cast(uint32, imm6) << 10) | (cast(uint32, rn) << 5) |
					cast(uint32, rd))
}

// Sm3tt emits SM3TT1A / SM3TT1B / SM3TT2A / SM3TT2B (op 0..3, an SM3TT_* value) `Vd.4S,
// Vn.4S, Vm.S[index]` (index 0..3).
func Sm3tt(a @asm.Assembler, op int, rd int, rn int, rm int, index int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if op < 0 || op > 3 || index < 0 || index > 3 {
		a.SetError("sm3tt: no such operation, or the index is not 0..3")
		return
	}
	isa.Emit32(a,
			0xCE408000 | (cast(uint32, rm) << 16) | (cast(uint32, index) << 12) | (cast(uint32, op) << 10) |
					(cast(uint32, rn) << 5) | cast(uint32, rd))
}
