package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The cryptographic encoders' own checks: each CR_* operation only through the encoder of
// its register count, XAR's rotation, the SM3TT operation and index, and register range
// (the text assembler's golden tables cover every encoding).

func TestCryptoChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Crypto2(a, CR_AESIMC, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E28781F) { return fail("aesimc v31.16b, v0.16b") }
	a = newAsm()
	Crypto3(a, CR_SHA512H2, 0, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0xCE6087E0) { return fail("sha512h2 q0, q31, v0.2d") }
	a = newAsm()
	Crypto4(a, CR_SM3SS1, 0, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0xCE407FE0) { return fail("sm3ss1 v0.4s, v31.4s, v0.4s, v31.4s") }
	a = newAsm()
	Crypto2(a, CR_SHA1C, 5, 18)
	if !rejected(a) { return fail("sha1c through Crypto2") }
	a = newAsm()
	Crypto3(a, CR_EOR3, 5, 18, 2)
	if !rejected(a) { return fail("eor3 through Crypto3") }
	a = newAsm()
	Crypto4(a, CR_SHA256H, 5, 18, 2, 9)
	if !rejected(a) { return fail("sha256h through Crypto4") }
	a = newAsm()
	Crypto3(a, -1, 5, 18, 2)
	if !rejected(a) { return fail("operation -1") }
	a = newAsm()
	Crypto2(a, CR_SM3SS1 + 1, 5, 18)
	if !rejected(a) { return fail("an operation past the last") }
	a = newAsm()
	Crypto4(a, CR_BCAX, 5, 18, 2, 32)
	if !rejected(a) { return fail("Va register 32") }
	a = newAsm()
	Crypto2(a, CR_AESE, 32, 18)
	if !rejected(a) { return fail("Vd register 32") }
	a = newAsm()
	Crypto3(a, CR_RAX1, 5, -1, 2)
	if !rejected(a) { return fail("Vn register -1") }
	a = newAsm()
	Crypto3(a, CR_SHA1SU0, 5, 18, 32)
	if !rejected(a) { return fail("Vm register 32") }
	return ""
}

func TestXarSm3ttChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Xar(a, 0, 31, 0, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0xCE8007E0) { return fail("xar v0.2d, v31.2d, v0.2d, #1") }
	a = newAsm()
	Xar(a, 5, 18, 2, 64)
	if !rejected(a) { return fail("xar #64") }
	a = newAsm()
	Xar(a, 5, 18, 2, -1)
	if !rejected(a) { return fail("xar #-1") }
	a = newAsm()
	Sm3tt(a, SM3TT_1A, 5, 18, 31, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0xCE5FB245) { return fail("sm3tt1a v5.4s, v18.4s, v31.s[3]") }
	a = newAsm()
	Sm3tt(a, 4, 5, 18, 2, 0)
	if !rejected(a) { return fail("sm3tt operation 4") }
	a = newAsm()
	Sm3tt(a, SM3TT_2B, 5, 18, 2, 4)
	if !rejected(a) { return fail("sm3tt index 4") }
	a = newAsm()
	Sm3tt(a, SM3TT_2B, 5, 18, 2, -1)
	if !rejected(a) { return fail("sm3tt index -1") }
	a = newAsm()
	Sm3tt(a, SM3TT_1B, 5, 18, 32, 0)
	if !rejected(a) { return fail("sm3tt Vm register 32") }
	a = newAsm()
	Xar(a, 32, 18, 2, 0)
	if !rejected(a) { return fail("xar Vd register 32") }
	return ""
}
