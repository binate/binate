package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD vector-by-element class, vector and scalar: the
// same-shape MLA / MLS / MUL, SQDMULH / SQRDMULH / SQRDMLAH / SQRDMLSH and FMLA / FMLS /
// FMUL / FMULX, and the long SMLAL / UMLAL / SMLSL / UMLSL / SMULL / UMULL / SQDMLAL /
// SQDMLSL / SQDMULL (and "2" forms), each taking one element Vm.<Ts>[index].  The index
// is H:L:M for 16-bit elements (so Vm is V0..V15), H:L for 32-bit (M the top bit of Vm),
// H for 64-bit.

// elFP reports whether op is a floating-point by-element operation.
func elFP(op int) bool {
	return op == EL_FMLA || op == EL_FMLS || op == EL_FMUL || op == EL_FMULX
}

// elLong reports whether op is a long by-element operation.
func elLong(op int) bool {
	return op == EL_SMLAL || op == EL_UMLAL || op == EL_SMLSL || op == EL_UMLSL || op == EL_SMULL ||
			op == EL_UMULL || op == EL_SQDMLAL || op == EL_SQDMLSL || op == EL_SQDMULL
}

// elOpOk reports whether op is an EL_* operation.
func elOpOk(op int) bool {
	return elFP(op) || elLong(op) || op == EL_MLA || op == EL_MLS || op == EL_MUL ||
			op == EL_SQDMULH || op == EL_SQRDMULH || op == EL_SQRDMLAH || op == EL_SQRDMLSH
}

// elScalarOk reports whether op has a scalar form.
func elScalarOk(op int) bool {
	return elFP(op) || op == EL_SQDMULH || op == EL_SQRDMULH || op == EL_SQRDMLAH ||
			op == EL_SQRDMLSH || op == EL_SQDMLAL || op == EL_SQDMLSL || op == EL_SQDMULL
}

// elWord packs a by-element instruction onto base for element size esize (1..3: H, S, D;
// the indexed element's), returning ok=false when esize, index or rm is out of range for
// op.
func elWord(base uint32, op int, esize int, rd int, rn int, rm int, index int) (uint32, bool) {
	if esize < 1 || esize > 3 || (esize == 3 && !elFP(op)) { return 0, false }
	var size int = esize
	if elFP(op) && esize == 1 { size = 0 }
	var h int = 0
	var l int = 0
	var m int = 0
	if esize == 1 {
		if index < 0 || index > 7 || rm > 15 { return 0, false }
		h = index >> 2
		l = (index >> 1) & 1
		m = index & 1
	} else if esize == 2 {
		if index < 0 || index > 3 { return 0, false }
		h = index >> 1
		l = index & 1
		m = rm >> 4
	} else {
		if index < 0 || index > 1 { return 0, false }
		h = index
		m = rm >> 4
	}
	var inst uint32 = base | (cast(uint32, op >> 4) << 29) | (cast(uint32, size) << 22) |
			(cast(uint32, l) << 21) | (cast(uint32, m) << 20) | (cast(uint32, rm & 0xF) << 16) |
			(cast(uint32, op & 0xF) << 12) | (cast(uint32, h) << 11) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	return inst, true
}

// ByElement emits the vector form of an EL_* operation with element size esize (1..3: H,
// S, D — D only for the floating-point ones) and Vm.<Ts>[index], on a 128-bit (q) or
// 64-bit vector; for the long operations esize is the source's and q selects the "2"
// form.
func ByElement(a @asm.Assembler, op int, q bool, esize int, rd int, rn int, rm int, index int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	inst, ok := elWord(0x0F000000, op, esize, rd, rn, rm, index)
	if !elOpOk(op) || !ok || (esize == 3 && !q) {
		a.SetError("simd by element: no such operation, element size, index or Vm")
		return
	}
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// ByElementScalar emits the scalar form of an EL_* operation with element size esize (the
// source's for SQDMLAL / SQDMLSL / SQDMULL, whose destination is twice as wide).
func ByElementScalar(a @asm.Assembler, op int, esize int, rd int, rn int, rm int, index int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	inst, ok := elWord(0x5F000000, op, esize, rd, rn, rm, index)
	if !elScalarOk(op) || !ok {
		a.SetError("simd by element: no such scalar operation, element size, index or Vm")
		return
	}
	isa.Emit32(a, inst)
}
