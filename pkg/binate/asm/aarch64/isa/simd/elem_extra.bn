package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the by-element forms of the three-same-extra and FP8 instructions:
// the dot products SDOT / UDOT / USDOT / SUDOT (Vm.4B[i]), BFDOT (Vm.2H[i]) and the FP8
// FDOT (Vm.2B[i] into H, Vm.4B[i] into S); the widening multiply-accumulates FMLAL /
// FMLSL / FMLAL2 / FMLSL2 and BFMLALB / BFMLALT (Vm.H[i]) and the FP8 FMLALB / FMLALT /
// FMLALL<xy> (Vm.B[i]); and FCMLA (Vm.H[i] / Vm.S[i]).  The index fills H, L, M and bit 3
// of the Rm field, from the top, with as many bits as it has: H:L leaves Vm V0..V31 (M
// its top bit), H:L:M V0..V15, and H:L:M:Rm<3> V0..V7.

// elxWord packs Rd, Rn, Vm and an index of bits bits (1..4; the index 0..maxIndex) onto
// base, returning ok=false when the index or Vm is out of range (or maxIndex does not fit
// in bits).
func elxWord(base uint32, bits int, maxIndex int, rd int, rn int, rm int,
		index int) (uint32, bool) {
	var rmMax int = 31
	if bits == 3 {
		rmMax = 15
	} else if bits == 4 {
		rmMax = 7
	}
	if bits < 1 || bits > 4 || maxIndex >= 1 << bits { return 0, false }
	if index < 0 || index > maxIndex || rm > rmMax { return 0, false }
	// The index left-aligned in the four bits H:L:M:Rm<3>.
	var ix int = index << (4 - bits)
	var rmField int = rm & 0xF
	var m int = (ix >> 1) & 1
	if bits <= 2 { m = rm >> 4 }
	if bits == 4 { rmField = rm | ((ix & 1) << 3) }
	var inst uint32 = base | (cast(uint32, (ix >> 2) & 1) << 21) | (cast(uint32, m) << 20) |
			(cast(uint32, rmField) << 16) | (cast(uint32, ix >> 3) << 11) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	return inst, true
}

// elxEmit emits elxWord's instruction (with the 128-bit bit q) or sets what's error.
func elxEmit(a @asm.Assembler, what *[]readonly char, base uint32, q bool, bits int, maxIndex int,
		rd int, rn int, rm int, index int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	inst, ok := elxWord(base, bits, maxIndex, rd, rn, rm, index)
	if !ok {
		a.SetError(what)
		return
	}
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// DotProductElem emits a DOT_* dot product `Vd.2S|4S, Vn.8B|16B, Vm.4B[index]` (by q;
// index 0..3).
func DotProductElem(a @asm.Assembler, op int, q bool, rd int, rn int, rm int, index int) {
	var base uint32 = 0x0F80E000
	if op == DOT_UDOT {
		base = 0x2F80E000
	} else if op == DOT_USDOT {
		base = 0x0F80F000
	} else if op == DOT_SUDOT {
		base = 0x0F00F000
	} else if op != DOT_SDOT {
		a.SetError("simd: no such dot product")
		return
	}
	elxEmit(a, "dot product by element: the index is 0..3", base, q, 2, 3, rd, rn, rm, index)
}

// BFDotElem emits BFDOT `Vd.2S|4S, Vn.4H|8H, Vm.2H[index]` (by q; index 0..3).
func BFDotElem(a @asm.Assembler, q bool, rd int, rn int, rm int, index int) {
	elxEmit(a, "bfdot by element: the index is 0..3", 0x0F40F000, q, 2, 3, rd, rn, rm, index)
}

// BFMlalElem emits BFMLALB (or BFMLALT, top) `Vd.4S, Vn.8H, Vm.H[index]` (index 0..7, Vm
// V0..V15).
func BFMlalElem(a @asm.Assembler, top bool, rd int, rn int, rm int, index int) {
	elxEmit(a, "bfmlal by element: the index is 0..7 and Vm V0..V15", 0x0FC0F000, top, 3, 7, rd, rn,
			rm, index)
}

// FMlalElem emits an FHM_* multiply-accumulate `Vd.2S|4S, Vn.2H|4H, Vm.H[index]` (by q;
// index 0..7, Vm V0..V15).
func FMlalElem(a @asm.Assembler, op int, q bool, rd int, rn int, rm int, index int) {
	var base uint32 = 0x0F800000
	if op == FHM_FMLSL {
		base = 0x0F804000
	} else if op == FHM_FMLAL2 {
		base = 0x2F808000
	} else if op == FHM_FMLSL2 {
		base = 0x2F80C000
	} else if op != FHM_FMLAL {
		a.SetError("simd: no such widening multiply-accumulate")
		return
	}
	elxEmit(a, "fmlal / fmlsl by element: the index is 0..7 and Vm V0..V15", base, q, 3, 7, rd, rn, rm,
			index)
}

// FCmlaElem emits FCMLA `Vd.<T>, Vn.<T>, Vm.<Ts>[index], #rot` (rot 0..3 for 0, 90, 180
// and 270 degrees) on 4H (index 0..1) or, q, 8H (0..3) for size 1, or 4S (q; index 0..1)
// for size 2.
func FCmlaElem(a @asm.Assembler, q bool, size int, rot int, rd int, rn int, rm int, index int) {
	if rot < 0 || rot > 3 || size < 1 || size > 2 || (size == 2 && !q) {
		a.SetError("fcmla by element: 4h / 8h / 4s and a rotation of 0, 90, 180 or 270")
		return
	}
	var base uint32 = 0x2F401000 | (cast(uint32, rot) << 13)
	var bits int = 2
	var maxIndex int = 1
	if size == 2 {
		base = 0x2F801000 | (cast(uint32, rot) << 13)
		bits = 1
	} else if q {
		maxIndex = 3
	}
	elxEmit(a, "fcmla by element: index out of range", base, q, bits, maxIndex, rd, rn, rm, index)
}

// FP8DotElem emits FDOT `Vd.4H|8H, Vn.8B|16B, Vm.2B[index]` (index 0..7, Vm V0..V15) or,
// toS, `Vd.2S|4S, Vn.8B|16B, Vm.4B[index]` (index 0..3); q selects the 128-bit forms.
func FP8DotElem(a @asm.Assembler, toS bool, q bool, rd int, rn int, rm int, index int) {
	if toS {
		elxEmit(a, "fdot by element: the index is 0..3", 0x0F000000, q, 2, 3, rd, rn, rm, index)
		return
	}
	elxEmit(a, "fdot by element: the index is 0..7 and Vm V0..V15", 0x0F400000, q, 3, 7, rd, rn, rm,
			index)
}

// FP8MlalElem emits FMLALB (or FMLALT, top) `Vd.8H, Vn.16B, Vm.B[index]` (index 0..15, Vm
// V0..V7).
func FP8MlalElem(a @asm.Assembler, top bool, rd int, rn int, rm int, index int) {
	elxEmit(a, "fmlalb / fmlalt by element: the index is 0..15 and Vm V0..V7", 0x0FC00000, top, 4, 15,
			rd, rn, rm, index)
}

// FP8MlallElem emits FMLALL<xy> (which, an FP8_MLALL* value) `Vd.4S, Vn.16B, Vm.B[index]`
// (index 0..15, Vm V0..V7).
func FP8MlallElem(a @asm.Assembler, which int, rd int, rn int, rm int, index int) {
	if which < 0 || which > 3 {
		a.SetError("fmlall: BB, BT, TB or TT")
		return
	}
	var base uint32 = 0x2F008000 | (cast(uint32, which & 1) << 22)
	elxEmit(a, "fmlall<xy> by element: the index is 0..15 and Vm V0..V7", base, which >= 2, 4, 15, rd,
			rn, rm, index)
}
