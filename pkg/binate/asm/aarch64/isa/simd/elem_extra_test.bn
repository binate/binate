package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The by-element dot-product, widening and complex encoders' own checks: the index and Vm
// range of each index width, the operations, FCMLA's shapes and rotation, and register
// range (the text assembler's golden tables cover every encoding).

func TestDotElemChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	DotProductElem(a, DOT_SUDOT, true, 5, 18, 31, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x4F3FF245) { return fail("sudot v5.4s, v18.16b, v31.4b[1]") }
	a = newAsm()
	DotProduct(a, DOT_SUDOT, true, 5, 18, 2)
	if !rejected(a) { return fail("sudot of three vectors") }
	a = newAsm()
	DotProductElem(a, DOT_SDOT, false, 5, 18, 2, 4)
	if !rejected(a) { return fail("sdot 4b[4]") }
	a = newAsm()
	DotProductElem(a, 4, false, 5, 18, 2, 0)
	if !rejected(a) { return fail("dot product 4") }
	a = newAsm()
	BFDotElem(a, true, 5, 18, 31, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0x4F7FFA45) { return fail("bfdot v5.4s, v18.8h, v31.2h[3]") }
	a = newAsm()
	FP8DotElem(a, false, false, 5, 18, 15, 7)
	if !clean(a, 1) || !wordIs(a, 0, 0x0F7F0A45) { return fail("fdot v5.4h, v18.8b, v15.2b[7]") }
	a = newAsm()
	FP8DotElem(a, true, false, 5, 18, 31, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0x0F3F0A45) { return fail("fdot v5.2s, v18.8b, v31.4b[3]") }
	a = newAsm()
	FP8DotElem(a, false, true, 5, 18, 16, 0)
	if !rejected(a) { return fail("fdot 2b in Vm v16") }
	a = newAsm()
	FP8DotElem(a, true, true, 5, 18, 2, 4)
	if !rejected(a) { return fail("fdot 4b[4]") }
	a = newAsm()
	DotProductElem(a, DOT_UDOT, true, 32, 18, 2, 0)
	if !rejected(a) { return fail("Vd register 32") }
	a = newAsm()
	BFDotElem(a, false, 5, 18, 2, -1)
	if !rejected(a) { return fail("bfdot index -1") }
	return ""
}

func TestWideningElemChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FMlalElem(a, FHM_FMLSL2, true, 5, 18, 2, 7)
	if !clean(a, 1) || !wordIs(a, 0, 0x6FB2CA45) { return fail("fmlsl2 v5.4s, v18.4h, v2.h[7]") }
	a = newAsm()
	FMlalElem(a, FHM_FMLAL, false, 5, 18, 2, 8)
	if !rejected(a) { return fail("fmlal h[8]") }
	a = newAsm()
	FMlalElem(a, 4, false, 5, 18, 2, 0)
	if !rejected(a) { return fail("widening multiply-accumulate 4") }
	a = newAsm()
	BFMlalElem(a, true, 5, 18, 15, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x4FDFF245) { return fail("bfmlalt v5.4s, v18.8h, v15.h[1]") }
	a = newAsm()
	BFMlalElem(a, false, 5, 18, 16, 1)
	if !rejected(a) { return fail("bfmlalb in Vm v16") }
	a = newAsm()
	FP8MlalElem(a, false, 5, 18, 7, 15)
	if !clean(a, 1) || !wordIs(a, 0, 0x0FFF0A45) { return fail("fmlalb v5.8h, v18.16b, v7.b[15]") }
	a = newAsm()
	FP8MlalElem(a, true, 5, 18, 7, 8)
	if !clean(a, 1) || !wordIs(a, 0, 0x4FC70A45) { return fail("fmlalt v5.8h, v18.16b, v7.b[8]") }
	a = newAsm()
	FP8MlalElem(a, false, 5, 18, 8, 0)
	if !rejected(a) { return fail("fmlalb in Vm v8") }
	a = newAsm()
	FP8MlalElem(a, false, 5, 18, 2, 16)
	if !rejected(a) { return fail("fmlalb b[16]") }
	a = newAsm()
	FP8MlallElem(a, FP8_MLALLTT, 5, 18, 2, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F4A8245) { return fail("fmlalltt v5.4s, v18.16b, v2.b[1]") }
	a = newAsm()
	FP8MlallElem(a, 4, 5, 18, 2, 1)
	if !rejected(a) { return fail("fmlall quarter 4") }
	a = newAsm()
	FP8MlallElem(a, -1, 5, 18, 2, 1)
	if !rejected(a) { return fail("fmlall quarter -1") }
	return ""
}

func TestFCmlaElemChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FCmlaElem(a, true, 1, 1, 5, 18, 31, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F7F3A45) { return fail("fcmla v5.8h, v18.8h, v31.h[3], #90") }
	a = newAsm()
	FCmlaElem(a, true, 2, 3, 5, 18, 31, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F9F7A45) { return fail("fcmla v5.4s, v18.4s, v31.s[1], #270") }
	a = newAsm()
	FCmlaElem(a, false, 1, 0, 5, 18, 2, 2)
	if !rejected(a) { return fail("fcmla 4h, h[2]") }
	a = newAsm()
	FCmlaElem(a, true, 2, 0, 5, 18, 2, 2)
	if !rejected(a) { return fail("fcmla 4s, s[2]") }
	a = newAsm()
	FCmlaElem(a, false, 2, 0, 5, 18, 2, 0)
	if !rejected(a) { return fail("fcmla 2s") }
	a = newAsm()
	FCmlaElem(a, true, 3, 0, 5, 18, 2, 0)
	if !rejected(a) { return fail("fcmla 2d") }
	a = newAsm()
	FCmlaElem(a, true, 1, 4, 5, 18, 2, 0)
	if !rejected(a) { return fail("fcmla rotation 4") }
	a = newAsm()
	FCmlaElem(a, true, 1, -1, 5, 18, 2, 0)
	if !rejected(a) { return fail("fcmla rotation -1") }
	a = newAsm()
	FCmlaElem(a, true, 0, 0, 5, 18, 2, 0)
	if !rejected(a) { return fail("fcmla on B elements") }
	return ""
}
