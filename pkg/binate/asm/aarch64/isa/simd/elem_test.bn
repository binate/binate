package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The by-element encoders' own checks: the index and Vm range per element size, the element
// sizes each operation takes (D only for the floating-point ones, on 2D), the scalar subset,
// and register range (the text assembler's golden tables cover every encoding).

func TestByElementChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ByElement(a, EL_MLA, true, 1, 31, 0, 15, 7)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F7F081F) { return fail("mla v31.8h, v0.8h, v15.h[7]") }
	a = newAsm()
	ByElement(a, EL_MUL, true, 2, 0, 1, 2, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0x4FA28820) { return fail("mul v0.4s, v1.4s, v2.s[3]") }
	a = newAsm()
	ByElement(a, EL_FMLA, true, 3, 0, 1, 2, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x4FC21820) { return fail("fmla v0.2d, v1.2d, v2.d[1]") }
	a = newAsm()
	ByElement(a, EL_MUL, true, 1, 0, 1, 16, 0)
	if !rejected(a) { return fail("an H element in Vm v16") }
	a = newAsm()
	ByElement(a, EL_MUL, true, 1, 0, 1, 2, 8)
	if !rejected(a) { return fail("h[8]") }
	a = newAsm()
	ByElement(a, EL_FMUL, true, 2, 0, 1, 2, 4)
	if !rejected(a) { return fail("s[4]") }
	a = newAsm()
	ByElement(a, EL_FMLA, false, 3, 0, 1, 2, 0)
	if !rejected(a) { return fail("fmla of 1d") }
	a = newAsm()
	ByElement(a, EL_MLA, true, 3, 0, 1, 2, 0)
	if !rejected(a) { return fail("mla on D elements") }
	a = newAsm()
	ByElement(a, 0x0E, true, 2, 0, 1, 2, 0)
	if !rejected(a) { return fail("opcode 1110 (a dot product) through ByElement") }
	a = newAsm()
	ByElement(a, EL_SMULL, false, 1, 32, 1, 2, 0)
	if !rejected(a) { return fail("Vd register 32") }
	return ""
}

func TestByElementScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ByElementScalar(a, EL_FMUL, 3, 31, 0, 31, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x5FDF981F) { return fail("fmul d31, d0, v31.d[1]") }
	a = newAsm()
	ByElementScalar(a, EL_SQDMULL, 2, 31, 0, 31, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0x5FBFB81F) { return fail("sqdmull d31, s0, v31.s[3]") }
	var bad [4]int = [4]int{EL_MLA, EL_MUL, EL_SMULL, EL_UMLAL}
	for i := 0; i < 4; i++ {
		a = newAsm()
		ByElementScalar(a, bad[i], 2, 0, 1, 2, 0)
		if !rejected(a) { return fail("a scalar form this class does not have") }
	}
	a = newAsm()
	ByElementScalar(a, EL_SQDMULH, 1, 0, 1, 16, 0)
	if !rejected(a) { return fail("a scalar H element in Vm v16") }
	return ""
}
