package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD 8-bit floating-point (FP8) three-register
// instructions: the dot products FDOT (FEAT_FP8DOT2 into H, FEAT_FP8DOT4 into S), the
// widening multiply-accumulates FMLALB / FMLALT (into H) and FMLALLBB / FMLALLBT /
// FMLALLTB / FMLALLTT (into S) of FEAT_FP8FMA, the narrowing conversion FCVTN / FCVTN2
// (FEAT_FP8, from two H or S vectors), and the matrix multiply FMMLA (FEAT_F8F16MM into
// H, FEAT_F8F32MM into S).  The FP8 sources are 8B / 16B vectors.

// fp8Word packs the three registers and the 128-bit bit q onto base.
func fp8Word(base uint32, q bool, rd int, rn int, rm int) uint32 {
	var inst uint32 = base | (cast(uint32, rm) << 16) | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	return inst
}

// FP8Dot emits FDOT `Vd.4H|8H, Vn.8B|16B, Vm.8B|16B` (two-way, into H) or, toS,
// `Vd.2S|4S, Vn.8B|16B, Vm.8B|16B` (four-way, into S); q selects the 128-bit forms.
func FP8Dot(a @asm.Assembler, toS bool, q bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	var base uint32 = 0x0E40FC00
	if toS { base = 0x0E00FC00 }
	isa.Emit32(a, fp8Word(base, q, rd, rn, rm))
}

// FP8Mlal emits FMLALB (or FMLALT, top) `Vd.8H, Vn.16B, Vm.16B`: the even (odd) FP8
// elements widened, multiplied and added to Vd.
func FP8Mlal(a @asm.Assembler, top bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	isa.Emit32(a, fp8Word(0x0EC0FC00, top, rd, rn, rm))
}

// FP8Mlall emits FMLALL<xy> `Vd.4S, Vn.16B, Vm.16B`: one quarter of the FP8 elements
// (which, an FP8_MLALL* value) widened to S, multiplied and added to Vd.
func FP8Mlall(a @asm.Assembler, which int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if which < 0 || which > 3 {
		a.SetError("fmlall: BB, BT, TB or TT")
		return
	}
	var base uint32 = 0x0E00C400 | (cast(uint32, which & 1) << 22)
	isa.Emit32(a, fp8Word(base, which >= 2, rd, rn, rm))
}

// FP8Cvtn emits the FP8 narrowing FCVTN from two H vectors — `Vd.8B, Vn.4H, Vm.4H` or,
// q, `Vd.16B, Vn.8H, Vm.8H` — or, fromS, from two S vectors into the low (`FCVTN Vd.8B,
// Vn.4S, Vm.4S`) or, q, the high half (`FCVTN2 Vd.16B, Vn.4S, Vm.4S`) of Vd.
func FP8Cvtn(a @asm.Assembler, fromS bool, q bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	var base uint32 = 0x0E40F400
	if fromS { base = 0x0E00F400 }
	isa.Emit32(a, fp8Word(base, q, rd, rn, rm))
}

// FP8MatMul emits FMMLA `Vd.8H, Vn.16B, Vm.16B` or, toS, `Vd.4S, Vn.16B, Vm.16B`: the
// FP8 matrix product added to the matrix in Vd.
func FP8MatMul(a @asm.Assembler, toS bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	var base uint32 = 0x6E00EC00
	if toS { base = 0x6E80EC00 }
	isa.Emit32(a, fp8Word(base, false, rd, rn, rm))
}
