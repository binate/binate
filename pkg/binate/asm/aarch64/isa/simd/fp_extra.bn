package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD floating-point instructions with operand shapes of
// their own: the complex multiply-accumulate FCMLA and complex add FCADD (FEAT_FCMA; H, S
// and D elements with a rotation), the BFloat16 dot product, matrix multiply and widening
// multiply-accumulates BFDOT / BFMMLA / BFMLALB / BFMLALT (FEAT_BF16), and the
// half-to-single widening FMLAL / FMLSL / FMLAL2 / FMLSL2 (FEAT_FHM).

// fcElemOk reports whether size (1..3: H, S, D) and q give a complex-arithmetic
// arrangement: 4H / 8H, 2S / 4S or 2D.
func fcElemOk(size int, q bool) bool {
	return size == 1 || size == 2 || (size == 3 && q)
}

// fxWord packs the three registers and the 128-bit bit q onto base.
func fxWord(base uint32, q bool, rd int, rn int, rm int) uint32 {
	var inst uint32 = base | (cast(uint32, rm) << 16) | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	return inst
}

// FCmla emits FCMLA `Vd.<T>, Vn.<T>, Vm.<T>, #rot` on a 128-bit (q) or 64-bit vector of
// size (1..3: H, S, D) elements, rot 0..3 for 0, 90, 180 and 270 degrees.
func FCmla(a @asm.Assembler, q bool, size int, rot int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if !fcElemOk(size, q) || rot < 0 || rot > 3 {
		a.SetError("fcmla: 4H / 8H / 2S / 4S / 2D, rotation 0 / 90 / 180 / 270")
		return
	}
	isa.Emit32(a,
			fxWord(0x2E00C400 | (cast(uint32, size) << 22) | (cast(uint32, rot) << 11), q, rd, rn, rm))
}

// FCadd emits FCADD `Vd.<T>, Vn.<T>, Vm.<T>, #90` (or #270, rot270) on a 128-bit (q)
// or 64-bit vector of size (1..3: H, S, D) elements.
func FCadd(a @asm.Assembler, q bool, size int, rot270 bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if !fcElemOk(size, q) {
		a.SetError("fcadd: 4H / 8H / 2S / 4S / 2D")
		return
	}
	var base uint32 = 0x2E00E400 | (cast(uint32, size) << 22)
	if rot270 { base = base | 0x1000 }
	isa.Emit32(a, fxWord(base, q, rd, rn, rm))
}

// BFDot emits BFDOT `Vd.2S|4S, Vn.4H|8H, Vm.4H|8H` (by q): each S element of Vd
// accumulates the products of two BFloat16 pairs.
func BFDot(a @asm.Assembler, q bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	isa.Emit32(a, fxWord(0x2E40FC00, q, rd, rn, rm))
}

// BFMatMul emits BFMMLA `Vd.4S, Vn.8H, Vm.8H`: the 2x4 by 4x2 BFloat16 matrix product
// added to the 2x2 single-precision matrix in Vd.
func BFMatMul(a @asm.Assembler, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	isa.Emit32(a, fxWord(0x2E40EC00, true, rd, rn, rm))
}

// BFMlal emits BFMLALB (or BFMLALT, top) `Vd.4S, Vn.8H, Vm.8H`: the even (odd)
// BFloat16 elements widened, multiplied and added to Vd.
func BFMlal(a @asm.Assembler, top bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	isa.Emit32(a, fxWord(0x2EC0FC00, top, rd, rn, rm))
}

// FMlal emits an FHM_* widening multiply-accumulate `Vd.2S|4S, Vn.2H|4H, Vm.2H|4H` (by
// q): the low (FMLAL / FMLSL) or high (FMLAL2 / FMLSL2) half-precision elements.
func FMlal(a @asm.Assembler, op int, q bool, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	var base uint32 = 0
	if op == FHM_FMLAL {
		base = 0x0E20EC00
	} else if op == FHM_FMLSL {
		base = 0x0EA0EC00
	} else if op == FHM_FMLAL2 {
		base = 0x2E20CC00
	} else if op == FHM_FMLSL2 {
		base = 0x2EA0CC00
	} else {
		a.SetError("simd: no such widening multiply-accumulate")
		return
	}
	isa.Emit32(a, fxWord(base, q, rd, rn, rm))
}
