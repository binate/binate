package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The FCMLA / FCADD, BF16 and FHM encoders' own checks: the complex-arithmetic
// arrangements (1D and B excluded) and rotations, the FHM operation set, and register
// range (the text assembler's golden tables cover every encoding).

func TestComplexChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FCmla(a, true, 3, 3, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EDFDC1F) {
		return fail("fcmla v31.2d, v0.2d, v31.2d, #270")
	}
	a = newAsm()
	FCadd(a, true, 2, false, 0, 1, 2)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E82E420) {
		return fail("fcadd v0.4s, v1.4s, v2.4s, #90")
	}
	a = newAsm()
	FCmla(a, false, 3, 0, 0, 1, 2)
	if !rejected(a) { return fail("fcmla of 1d") }
	a = newAsm()
	FCmla(a, true, 0, 0, 0, 1, 2)
	if !rejected(a) { return fail("fcmla of 16b") }
	a = newAsm()
	FCmla(a, true, 1, 4, 0, 1, 2)
	if !rejected(a) { return fail("fcmla rotation 4") }
	a = newAsm()
	FCadd(a, false, 3, true, 0, 1, 2)
	if !rejected(a) { return fail("fcadd of 1d") }
	a = newAsm()
	FCadd(a, true, 4, false, 0, 1, 2)
	if !rejected(a) { return fail("fcadd of size 4") }
	a = newAsm()
	FCmla(a, true, 1, 0, 32, 1, 2)
	if !rejected(a) { return fail("Vd register 32") }
	a = newAsm()
	FCmla(a, true, 1, -1, 0, 1, 2)
	if !rejected(a) { return fail("fcmla rotation -1") }
	a = newAsm()
	FCmla(a, true, 4, 0, 0, 1, 2)
	if !rejected(a) { return fail("fcmla of size 4") }
	a = newAsm()
	FCadd(a, true, 0, false, 0, 1, 2)
	if !rejected(a) { return fail("fcadd of 16b") }
	a = newAsm()
	FCadd(a, true, -1, false, 0, 1, 2)
	if !rejected(a) { return fail("fcadd of size -1") }
	return ""
}

func TestBF16AndFHMChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BFDot(a, true, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E5FFC1F) { return fail("bfdot v31.4s, v0.8h, v31.8h") }
	a = newAsm()
	BFMatMul(a, 31, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E40EFFF) {
		return fail("bfmmla v31.4s, v31.8h, v0.8h")
	}
	a = newAsm()
	BFMlal(a, true, 0, 31, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EDFFFE0) {
		return fail("bfmlalt v0.4s, v31.8h, v31.8h")
	}
	a = newAsm()
	FMlal(a, FHM_FMLSL2, true, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EBFCC1F) {
		return fail("fmlsl2 v31.4s, v0.4h, v31.4h")
	}
	a = newAsm()
	FMlal(a, 4, true, 0, 1, 2)
	if !rejected(a) { return fail("FHM operation 4") }
	a = newAsm()
	FMlal(a, -1, true, 0, 1, 2)
	if !rejected(a) { return fail("FHM operation -1") }
	a = newAsm()
	BFDot(a, true, 0, -1, 2)
	if !rejected(a) { return fail("Vn register -1") }
	a = newAsm()
	BFMatMul(a, 0, 1, 32)
	if !rejected(a) { return fail("Vm register 32") }
	a = newAsm()
	BFMlal(a, false, 32, 1, 2)
	if !rejected(a) { return fail("Vd register 32") }
	return ""
}
