package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD floating-point conversions that change the element
// size: FCVTN (narrow, rounding per FPCR), FCVTXN (narrow D to S, rounding to odd), BFCVTN
// (narrow S to BFloat16, FEAT_BF16) and FCVTL (lengthen), each with its "2" form on the
// upper half of the narrow vector; the scalar FCVTXN; and the FEAT_FP8 lengthenings
// F1CVTL / F2CVTL / BF1CVTL / BF2CVTL, which share FCVTL's opcode.

// FPNarrowWiden emits F2_FCVTN / F2_FCVTXN / F2_BFCVTN (`Vd.<Tb>, Vn.<Ta>`) or F2_FCVTL
// (`Vd.<Ta>, Vn.<Tb>`), where the wide arrangement Ta has precision wide (isa.FT_S: 4S
// against 4H / 8H; isa.FT_D: 2D against 2S / 4S) and q selects the "2" form.  FCVTXN is
// from D only, BFCVTN from S only.
func FPNarrowWiden(a @asm.Assembler, op int, q bool, wide int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var ok bool = (op == F2_FCVTN || op == F2_FCVTL) && (wide == isa.FT_S || wide == isa.FT_D)
	if (op == F2_FCVTXN && wide == isa.FT_D) || (op == F2_BFCVTN && wide == isa.FT_S) { ok = true }
	if !ok {
		a.SetError("simd: fcvtn / fcvtl from or to S or D, fcvtxn from D, bfcvtn from S")
		return
	}
	var inst uint32 = 0x0E200800 | (cast(uint32, op >> 6) << 29) |
			(cast(uint32, (op >> 5) & 1) << 23) | (cast(uint32, op & 0x1F) << 12) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	if wide == isa.FT_D { inst = inst | 0x00400000 }
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// FCvtxnScalar emits the scalar FCVTXN `Sd, Dn`.
func FCvtxnScalar(a @asm.Assembler, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	isa.Emit32(a, 0x7E616800 | (cast(uint32, rn) << 5) | cast(uint32, rd))
}

// FP8Lengthen emits an FP8 lengthening conversion `Vd.8H, Vn.8B` (q: the "2" form, `Vn.16B`):
// which is FP8CVTL_F1 / F2 (to half precision) or BF1 / BF2 (to BFloat16), in the FP8
// format FPMR's first or second source field selects.
func FP8Lengthen(a @asm.Assembler, which int, q bool, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	if which < 0 || which > 3 {
		a.SetError("simd: no such FP8 lengthening conversion")
		return
	}
	var inst uint32 = 0x2E217800 | (cast(uint32, which) << 22) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}
