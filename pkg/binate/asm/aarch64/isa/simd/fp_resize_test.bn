package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/builtins/testing"

// The size-changing conversion encoders' own checks, and the same-size conversions'
// place in the two-register encoders: which precisions each takes, and register range
// (the text assembler's golden tables cover every encoding).

func TestFPNarrowWidenChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPNarrowWiden(a, F2_FCVTN, true, isa.FT_S, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E21681F) { return fail("fcvtn2 v31.8h, v0.4s") }
	a = newAsm()
	FPNarrowWiden(a, F2_FCVTL, true, isa.FT_D, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E61781F) { return fail("fcvtl2 v31.2d, v0.4s") }
	a = newAsm()
	FPNarrowWiden(a, F2_FCVTXN, true, isa.FT_D, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E616BE0) { return fail("fcvtxn2 v0.4s, v31.2d") }
	a = newAsm()
	FPNarrowWiden(a, F2_BFCVTN, true, isa.FT_S, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EA1681F) { return fail("bfcvtn2 v31.8h, v0.4s") }
	var badOp [5]int = [5]int{F2_FCVTXN, F2_BFCVTN, F2_FCVTN, F2_FCVTZS, F2_FCVTL}
	var badWide [5]int = [5]int{isa.FT_S, isa.FT_D, isa.FT_H, isa.FT_S, 2}
	for i := 0; i < 5; i++ {
		a = newAsm()
		FPNarrowWiden(a, badOp[i], false, badWide[i], 0, 1)
		if !rejected(a) { return fail("a narrowing / lengthening at a precision it does not have") }
	}
	a = newAsm()
	FPNarrowWiden(a, F2_FCVTN, false, isa.FT_S, 0, 32)
	if !rejected(a) { return fail("Vn register 32") }
	a = newAsm()
	FCvtxnScalar(a, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x7E61681F) { return fail("fcvtxn s31, d0") }
	a = newAsm()
	FCvtxnScalar(a, 0, -1)
	if !rejected(a) { return fail("Dn register -1") }
	a = newAsm()
	FP8Lengthen(a, FP8CVTL_BF2, true, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EE17BE0) { return fail("bf2cvtl2 v0.8h, v31.16b") }
	a = newAsm()
	FP8Lengthen(a, FP8CVTL_F1, false, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x2E21781F) { return fail("f1cvtl v31.8h, v0.8b") }
	a = newAsm()
	FP8Lengthen(a, 4, false, 0, 1)
	if !rejected(a) { return fail("FP8 lengthening 4") }
	a = newAsm()
	FP8Lengthen(a, FP8CVTL_F2, false, 32, 1)
	if !rejected(a) { return fail("Vd register 32") }
	return ""
}

func TestFPConvertSameSizeChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPTwoRegMisc(a, F2_FCVTZS, true, isa.FT_H, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EF9B81F) { return fail("fcvtzs v31.8h, v0.8h") }
	a = newAsm()
	FPTwoRegMiscScalar(a, F2_UCVTF, isa.FT_H, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x7E79DBE0) { return fail("ucvtf h0, h31") }
	a = newAsm()
	FPTwoRegMiscScalar(a, F2_FCVTAU, isa.FT_S, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x7E21C81F) { return fail("fcvtau s31, s0") }
	a = newAsm()
	FPTwoRegMisc(a, F2_SCVTF, false, isa.FT_D, 0, 1)
	if !rejected(a) { return fail("scvtf of 1d") }
	a = newAsm()
	FPTwoRegMisc(a, F2_FCVTN, true, isa.FT_S, 0, 1)
	if !rejected(a) { return fail("fcvtn through the same-size encoder") }
	return ""
}
