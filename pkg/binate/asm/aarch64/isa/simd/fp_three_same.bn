package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD floating-point three-same class, vector and
// scalar, in single / double precision (`Vd.2S|4S|2D`, `Sd`, `Dd`) and half precision
// (`Vd.4H|8H`, `Hd`; FEAT_FP16, a separate encoding with the same operations), including
// FAMAX / FAMIN (FEAT_FAMINMAX) and FSCALE (FEAT_FP8).  An F3_* operation packs U, the a
// bit and the low three opcode bits; the four combinations that are FMLAL / FMLSL and
// their second-half forms (a different operand shape, single-precision encoding only),
// and the unallocated U=0 a=1 opcode 100, are not operations here.

// f3OpOk reports whether op is an F3_* operation of the vector form.
func f3OpOk(op int) bool {
	if op < 0 || op > 0x1F { return false }
	return op != 0x05 && op != 0x0C && op != 0x0D && op != 0x11 && op != 0x19
}

// f3ScalarOk reports whether op has a scalar form: FMULX, FCMEQ, FRECPS, FRSQRTS, FCMGE,
// FACGE, FABD, FCMGT and FACGT (the scalar FADD, FMUL, … are the floating-point
// data-processing instructions).
func f3ScalarOk(op int) bool {
	return op == F3_FMULX || op == F3_FCMEQ || op == F3_FRECPS || op == F3_FRSQRTS || op == F3_FCMGE ||
			op == F3_FACGE || op == F3_FABD || op == F3_FCMGT || op == F3_FACGT
}

// f3Word packs a floating-point three-same instruction for precision ft (isa.FT_H, isa.FT_S or
// isa.FT_D) onto base (the vector or scalar class, without the precision fields).
func f3Word(base uint32, op int, ft int, rd int, rn int, rm int) uint32 {
	var inst uint32 = base | (cast(uint32, op >> 4) << 29) | (cast(uint32, (op >> 3) & 1) << 23) |
			(cast(uint32, rm) << 16) | (cast(uint32, op & 7) << 11) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	if ft == isa.FT_H { return inst | 0x00400000 }
	inst = inst | 0x0020C000
	if ft == isa.FT_D { inst = inst | 0x00400000 }
	return inst
}

// f3TypeOk reports whether ft is isa.FT_H, isa.FT_S or isa.FT_D.
func f3TypeOk(ft int) bool {
	return ft == isa.FT_H || ft == isa.FT_S || ft == isa.FT_D
}

// FPThreeSame emits the vector form of an F3_* operation on a 128-bit (q) or 64-bit
// vector of precision ft (isa.FT_H: 4H / 8H; isa.FT_S: 2S / 4S; isa.FT_D: 2D only).
func FPThreeSame(a @asm.Assembler, op int, q bool, ft int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if !f3OpOk(op) || !f3TypeOk(ft) || (ft == isa.FT_D && !q) {
		a.SetError("simd fp three-same: no such operation for this arrangement")
		return
	}
	var inst uint32 = f3Word(0x0E000400, op, ft, rd, rn, rm)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// FPThreeSameScalar emits the scalar form of an F3_* operation on H, S or D
// registers (ft).
func FPThreeSameScalar(a @asm.Assembler, op int, ft int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if !f3OpOk(op) || !f3ScalarOk(op) || !f3TypeOk(ft) {
		a.SetError("simd fp three-same: no such scalar operation")
		return
	}
	isa.Emit32(a, f3Word(0x5E000400, op, ft, rd, rn, rm))
}
