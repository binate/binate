package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/builtins/testing"

// The floating-point three-same encoders' own checks: the operation set (the FMLAL /
// FMLSL combinations and the unallocated one excluded), the precisions and the reserved 1D, the
// scalar subset, and register range (the text assembler's golden tables cover every
// encoding).

func TestFPThreeSameChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPThreeSame(a, F3_FADD, true, isa.FT_D, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E7FD41F) { return fail("fadd v31.2d, v0.2d, v31.2d") }
	a = newAsm()
	FPThreeSame(a, F3_FDIV, false, isa.FT_H, 31, 31, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x2E5F3FFF) { return fail("fdiv v31.4h ×3") }
	a = newAsm()
	FPThreeSame(a, F3_FADD, false, isa.FT_D, 0, 1, 2)
	if !rejected(a) { return fail("fadd of 1d") }
	a = newAsm()
	FPThreeSame(a, 0x05, true, isa.FT_S, 0, 1, 2)
	if !rejected(a) { return fail("the FMLAL combination") }
	a = newAsm()
	FPThreeSame(a, F3_FSCALE, true, isa.FT_S, 5, 18, 27)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EBBFE45) {
		return fail("fscale v5.4s, v18.4s, v27.4s")
	}
	var excluded [6]int = [6]int{0x0C, 0x0D, 0x11, 0x19, -1, 0x20}
	for i := 0; i < 6; i++ {
		a = newAsm()
		FPThreeSame(a, excluded[i], true, isa.FT_S, 0, 1, 2)
		if !rejected(a) { return fail("an excluded operation value") }
	}
	a = newAsm()
	FPThreeSame(a, 0x20, true, isa.FT_S, 0, 1, 2)
	if !rejected(a) { return fail("op 0x20") }
	a = newAsm()
	FPThreeSame(a, F3_FADD, true, 2, 0, 1, 2)
	if !rejected(a) { return fail("precision 2") }
	a = newAsm()
	FPThreeSame(a, F3_FADD, true, isa.FT_S, 0, 32, 2)
	if !rejected(a) { return fail("Vn register 32") }
	return ""
}

func TestFPThreeSameScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPThreeSameScalar(a, F3_FABD, isa.FT_H, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x7EDF141F) { return fail("fabd h31, h0, h31") }
	a = newAsm()
	FPThreeSameScalar(a, F3_FCMGE, isa.FT_D, 0, 1, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x7E7FE420) { return fail("fcmge d0, d1, d31") }
	a = newAsm()
	FPThreeSameScalar(a, F3_FADD, isa.FT_S, 0, 1, 2)
	if !rejected(a) { return fail("a scalar FADD through the SIMD form") }
	a = newAsm()
	FPThreeSameScalar(a, F3_FADDP, isa.FT_D, 0, 1, 2)
	if !rejected(a) { return fail("a scalar FADDP") }
	var vecOnly [9]int = [9]int{F3_FSUB, F3_FMUL, F3_FDIV, F3_FMAX, F3_FMIN, F3_FMAXNM, F3_FMINNM,
			F3_FAMAX, F3_FSCALE}
	for i := 0; i < 9; i++ {
		a = newAsm()
		FPThreeSameScalar(a, vecOnly[i], isa.FT_S, 0, 1, 2)
		if !rejected(a) { return fail("a scalar form of a vector-only operation") }
	}
	a = newAsm()
	FPThreeSameScalar(a, F3_FMULX, 2, 0, 1, 2)
	if !rejected(a) { return fail("precision 2") }
	a = newAsm()
	FPThreeSameScalar(a, F3_FMULX, isa.FT_S, -1, 1, 2)
	if !rejected(a) { return fail("Vd register -1") }
	return ""
}
