package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the floating-point instructions of the Advanced SIMD two-register
// miscellaneous class that keep the element size, vector and scalar, in single / double
// precision and in the FEAT_FP16 half-precision encoding: FABS / FNEG / FSQRT, the FRINT*
// roundings (FRINT32* / FRINT64*, FEAT_FRINTTS, without a half-precision form), FRECPE /
// FRSQRTE, FRECPX (scalar only), the compares against zero, the conversions between
// floating-point and integer elements of one size (FCVT{N,M,A,P,Z}{S,U}, SCVTF, UCVTF),
// and the integer URECPE / URSQRTE, which sit in this half of the class (vector, S
// elements only).  The conversions that change the size are in fp_resize.bn.

// f2Frint3264 reports whether op is one of FRINT32Z / FRINT32X / FRINT64Z / FRINT64X.
func f2Frint3264(op int) bool {
	return op == F2_FRINT32Z || op == F2_FRINT32X || op == F2_FRINT64Z || op == F2_FRINT64X
}

// f2OpOk reports whether op is an F2_* operation of this file.
func f2OpOk(op int) bool {
	return op == F2_FRINTN || op == F2_FRINTM || op == F2_FRINTP || op == F2_FRINTZ ||
			op == F2_FRINTA || op == F2_FRINTX || op == F2_FRINTI || f2Frint3264(op) || op == F2_FCMGT0 ||
			op == F2_FCMEQ0 || op == F2_FCMLT0 || op == F2_FCMGE0 || op == F2_FCMLE0 || op == F2_FABS ||
			op == F2_FNEG || op == F2_FSQRT || op == F2_FRECPE || op == F2_FRSQRTE || op == F2_FRECPX ||
			op == F2_URECPE || op == F2_URSQRTE || f2Convert(op)
}

// f2Convert reports whether op is a conversion between floating-point and integer
// elements of one size.
func f2Convert(op int) bool {
	return op == F2_FCVTNS || op == F2_FCVTMS || op == F2_FCVTAS || op == F2_SCVTF ||
			op == F2_FCVTPS || op == F2_FCVTZS || op == F2_FCVTNU || op == F2_FCVTMU || op == F2_FCVTAU ||
			op == F2_UCVTF || op == F2_FCVTPU || op == F2_FCVTZU
}

// f2Compare reports whether op is a floating-point compare against zero.
func f2Compare(op int) bool {
	return op == F2_FCMGT0 || op == F2_FCMEQ0 || op == F2_FCMLT0 || op == F2_FCMGE0 || op == F2_FCMLE0
}

// f2Word packs op for precision ft onto base (the vector or scalar class without its
// precision fields): U (op bit 6), a (bit 5, instruction bit 23), the opcode (bits 4:0).
func f2Word(base uint32, op int, ft int, rd int, rn int) uint32 {
	var inst uint32 = base | (cast(uint32, op >> 6) << 29) | (cast(uint32, (op >> 5) & 1) << 23) |
			(cast(uint32, op & 0x1F) << 12) | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if ft == isa.FT_H { return inst | 0x00780000 }
	inst = inst | 0x00200000
	if ft == isa.FT_D { inst = inst | 0x00400000 }
	return inst
}

// FPTwoRegMisc emits the vector form of an F2_* operation on a 128-bit (q) or 64-bit
// vector of precision ft: isa.FT_H (4H / 8H), isa.FT_S (2S / 4S) or isa.FT_D (2D; q set).
// FRINT32* / FRINT64* have no H form, URECPE / URSQRTE only S, FRECPX no vector form.
func FPTwoRegMisc(a @asm.Assembler, op int, q bool, ft int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var ok bool = f2OpOk(op) && op != F2_FRECPX &&
			(ft == isa.FT_H || ft == isa.FT_S || (ft == isa.FT_D && q))
	if (f2Frint3264(op) && ft == isa.FT_H) ||
			((op == F2_URECPE || op == F2_URSQRTE) && ft != isa.FT_S) {
		ok = false
	}
	if !ok {
		a.SetError("simd fp two-register misc: no such operation for this arrangement")
		return
	}
	var inst uint32 = f2Word(0x0E000800, op, ft, rd, rn)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// FPTwoRegMiscScalar emits the scalar form (H, S or D, by ft) of FRECPE, FRSQRTE, FRECPX,
// a compare against zero, or a conversion between floating-point and integer values of
// one size (the scalar FABS, FSQRT, FRINT*, … are the floating-point data-processing
// instructions).
func FPTwoRegMiscScalar(a @asm.Assembler, op int, ft int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var ok bool = op == F2_FRECPE || op == F2_FRSQRTE || op == F2_FRECPX || f2Compare(op) ||
			f2Convert(op)
	if !ok || (ft != isa.FT_H && ft != isa.FT_S && ft != isa.FT_D) {
		a.SetError("simd fp two-register misc: no such scalar operation")
		return
	}
	isa.Emit32(a, f2Word(0x5E000800, op, ft, rd, rn))
}
