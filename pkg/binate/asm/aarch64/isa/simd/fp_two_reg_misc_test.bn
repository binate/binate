package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/builtins/testing"

// The non-converting floating-point two-register encoders' own checks: the operation set,
// the precisions each takes (no H for FRINT32* / FRINT64*, only S for URECPE / URSQRTE,
// no vector FRECPX, no 1D), the scalar subset, and register range (the text assembler's
// golden tables cover every encoding).

func TestFPTwoRegMiscChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPTwoRegMisc(a, F2_FABS, true, isa.FT_H, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EF8F81F) { return fail("fabs v31.8h, v0.8h") }
	a = newAsm()
	FPTwoRegMisc(a, F2_FRINTI, true, isa.FT_S, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EA19BE0) { return fail("frinti v0.4s, v31.4s") }
	a = newAsm()
	FPTwoRegMisc(a, F2_URSQRTE, true, isa.FT_S, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EA1C81F) { return fail("ursqrte v31.4s, v0.4s") }
	a = newAsm()
	FPTwoRegMisc(a, F2_FCMGT0, true, isa.FT_D, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EE0C81F) { return fail("fcmgt v31.2d, v0.2d, #0.0") }
	var bad [7]int = [7]int{F2_FRINT32Z, F2_FRINT64X, F2_URECPE, F2_URSQRTE, F2_FRECPX, F2_FABS, 0x1A}
	var badFt [7]int = [7]int{isa.FT_H, isa.FT_H, isa.FT_H, isa.FT_D, isa.FT_S, 2, isa.FT_S}
	for i := 0; i < 7; i++ {
		a = newAsm()
		FPTwoRegMisc(a, bad[i], true, badFt[i], 0, 1)
		if !rejected(a) { return fail("an operation at a precision it does not have") }
	}
	a = newAsm()
	FPTwoRegMisc(a, F2_FNEG, false, isa.FT_D, 0, 1)
	if !rejected(a) { return fail("fneg of 1d") }
	a = newAsm()
	FPTwoRegMisc(a, F2_FSQRT, true, isa.FT_S, 32, 1)
	if !rejected(a) { return fail("Vd register 32") }
	return ""
}

func TestFPTwoRegMiscScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	FPTwoRegMiscScalar(a, F2_FRECPX, isa.FT_H, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x5EF9F81F) { return fail("frecpx h31, h0") }
	a = newAsm()
	FPTwoRegMiscScalar(a, F2_FCMLE0, isa.FT_H, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x7EF8D81F) { return fail("fcmle h31, h0, #0.0") }
	var bad [4]int = [4]int{F2_FABS, F2_FRINTN, F2_URECPE, F2_FSQRT}
	for i := 0; i < 4; i++ {
		a = newAsm()
		FPTwoRegMiscScalar(a, bad[i], isa.FT_S, 0, 1)
		if !rejected(a) { return fail("a scalar form this class does not have") }
	}
	a = newAsm()
	FPTwoRegMiscScalar(a, F2_FRECPE, 2, 0, 1)
	if !rejected(a) { return fail("precision 2") }
	a = newAsm()
	FPTwoRegMiscScalar(a, F2_FRSQRTE, isa.FT_D, 0, -1)
	if !rejected(a) { return fail("Dn register -1") }
	return ""
}
