package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Helpers for the encoders' own checks: a fresh assembler, and predicates on what it
// emitted.

// fail returns msg as a failing test result.
func fail(msg @[]char) testing.TestResult { return msg }

// newAsm returns a 64-bit assembler positioned in a text section.
func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	return a
}

// readInst reads the little-endian instruction word at off in section s.
func readInst(s @asm.Section, off int) uint32 {
	return cast(uint32, s.Data[off]) | (cast(uint32, s.Data[off + 1]) << 8) |
			(cast(uint32, s.Data[off + 2]) << 16) | (cast(uint32, s.Data[off + 3]) << 24)
}

// wordIs reports whether a's first section holds instruction idx and it is want.
func wordIs(a @asm.Assembler, idx int, want uint32) bool {
	var s @asm.Section = a.Sections[0]
	if s.Len < (idx + 1) * 4 { return false }
	return readInst(s, idx * 4) == want
}

// rejected reports whether a recorded an error and its first section is still empty —
// an exact encoder must refuse without emitting anything.
func rejected(a @asm.Assembler) bool {
	return a.HasError && a.Sections[0].Len == 0
}

// clean reports whether a recorded no error and emitted exactly n words.
func clean(a @asm.Assembler, n int) bool {
	return !a.HasError && a.Sections[0].Len == n * 4
}
