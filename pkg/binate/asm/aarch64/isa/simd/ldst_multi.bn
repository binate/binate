package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD load / store multiple structures: LD1 / ST1 of one
// to four registers and the interleaving LD2..LD4 / ST2..ST4 (selem elements per
// structure, one register each), at [Xn|SP] with no offset or post-indexed by the
// transfer size (an immediate) or by a register.  The registers are consecutive from Vt
// (V31 is followed by V0), so only Vt is encoded; 1D is an LD1 / ST1 arrangement only.
// Rm 31 selects the immediate post-index, so the register form takes X0..X30 (not XZR).

// multiOpcode returns the opcode of selem elements per structure over nreg registers, or
// -1 when there is no such form.
func multiOpcode(selem int, nreg int) int {
	if selem == 1 {
		if nreg == 1 { return 0x7 }
		if nreg == 2 { return 0xA }
		if nreg == 3 { return 0x6 }
		if nreg == 4 { return 0x2 }
		return -1
	}
	if nreg != selem { return -1 }
	if selem == 2 { return 0x8 }
	if selem == 3 { return 0x4 }
	if selem == 4 { return 0x0 }
	return -1
}

// multiWord packs a multiple-structure load / store onto base, returning ok=false when
// there is no such form.
func multiWord(base uint32, load bool, selem int, nreg int, q bool, size int, rt int,
		rn int) (uint32, bool) {
	var opcode int = multiOpcode(selem, nreg)
	if opcode < 0 || size < 0 || size > 3 || (size == 3 && !q && selem != 1) { return 0, false }
	var inst uint32 = base | (cast(uint32, opcode) << 12) | (cast(uint32, size) << 10) |
			(cast(uint32, rn) << 5) | cast(uint32, rt)
	if load { inst = inst | 0x400000 }
	if q { inst = inst | 0x40000000 }
	return inst, true
}

// multiEmit emits multiWord's instruction or sets the error.
func multiEmit(a @asm.Assembler, base uint32, load bool, selem int, nreg int, q bool, size int,
		rt int, rn int) {
	inst, ok := multiWord(base, load, selem, nreg, q, size, rt, rn)
	if !ok {
		a.SetError("ld1..ld4 / st1..st4: no such register count or arrangement")
		return
	}
	isa.Emit32(a, inst)
}

// LdStMulti emits LD<selem> (load) or ST<selem> `{Vt.<T>, …}, [Xn|SP]` of nreg registers
// (nreg = selem, or 1..4 for selem 1) of a 128-bit (q) or 64-bit vector of size (0..3)
// elements.
func LdStMulti(a @asm.Assembler, load bool, selem int, nreg int, q bool, size int, rt int, rn int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) { return }
	multiEmit(a, 0x0C000000, load, selem, nreg, q, size, rt, rn)
}

// LdStMultiPostImm emits LdStMulti's instruction post-indexed by imm, which must be the
// transfer size: nreg × 16 bytes (q) or nreg × 8.
func LdStMultiPostImm(a @asm.Assembler, load bool, selem int, nreg int, q bool, size int, rt int,
		rn int, imm int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) { return }
	var bytes int = nreg * 8
	if q { bytes = nreg * 16 }
	if imm != bytes {
		a.SetError("ld1..ld4 / st1..st4: the post-index immediate is the transfer size")
		return
	}
	multiEmit(a, 0x0C9F0000, load, selem, nreg, q, size, rt, rn)
}

// LdStMultiPostReg emits LdStMulti's instruction post-indexed by Xm (rm 0..30).
func LdStMultiPostReg(a @asm.Assembler, load bool, selem int, nreg int, q bool, size int, rt int,
		rn int, rm int) {
	if !isa.RegsOk(a, rt, rn, rm, 0) { return }
	if rm == 31 {
		a.SetError("ld1..ld4 / st1..st4: the post-index register is X0..X30")
		return
	}
	multiEmit(a, 0x0C800000 | (cast(uint32, rm) << 16), load, selem, nreg, q, size, rt, rn)
}
