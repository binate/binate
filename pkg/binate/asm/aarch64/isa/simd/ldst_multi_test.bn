package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The multiple-structure load / store encoders' own checks: the register count per
// structure size, 1D, the post-index immediate (the transfer size) and register (not
// 31), and register range (the text assembler's golden tables cover every encoding).

func TestLdStMultiChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStMulti(a, true, 1, 1, true, 0, 5, 18)
	if !clean(a, 1) || !wordIs(a, 0, 0x4C407245) { return fail("ld1 {v5.16b}, [x18]") }
	a = newAsm()
	LdStMultiPostImm(a, true, 1, 1, true, 0, 5, 18, 16)
	if !clean(a, 1) || !wordIs(a, 0, 0x4CDF7245) { return fail("ld1 {v5.16b}, [x18], #16") }
	a = newAsm()
	LdStMultiPostReg(a, true, 1, 1, true, 0, 5, 18, 2)
	if !clean(a, 1) || !wordIs(a, 0, 0x4CC27245) { return fail("ld1 {v5.16b}, [x18], x2") }
	a = newAsm()
	LdStMultiPostReg(a, true, 1, 1, true, 0, 5, 18, 31)
	if !rejected(a) { return fail("post-index register 31") }
	a = newAsm()
	LdStMultiPostImm(a, false, 2, 2, false, 2, 5, 18, 32)
	if !rejected(a) { return fail("st2 of 2s post-indexed by 32") }
	a = newAsm()
	LdStMulti(a, true, 2, 2, false, 3, 5, 18)
	if !rejected(a) { return fail("ld2 of 1d") }
	a = newAsm()
	LdStMulti(a, true, 1, 4, false, 3, 5, 18)
	if !clean(a, 1) { return fail("ld1 of four 1d") }
	a = newAsm()
	LdStMulti(a, true, 3, 2, true, 2, 5, 18)
	if !rejected(a) { return fail("ld3 of two registers") }
	a = newAsm()
	LdStMulti(a, true, 1, 5, true, 2, 5, 18)
	if !rejected(a) { return fail("ld1 of five registers") }
	a = newAsm()
	LdStMulti(a, false, 5, 5, true, 2, 5, 18)
	if !rejected(a) { return fail("st5") }
	a = newAsm()
	LdStMulti(a, false, 1, 1, true, 4, 5, 18)
	if !rejected(a) { return fail("element size 4") }
	a = newAsm()
	LdStMulti(a, false, 1, 1, true, -1, 5, 18)
	if !rejected(a) { return fail("element size -1") }
	a = newAsm()
	LdStMultiPostImm(a, true, 1, 1, true, 0, 5, 32, 16)
	if !rejected(a) { return fail("Rn register 32") }
	a = newAsm()
	LdStMulti(a, false, 1, 1, true, 0, 32, 18)
	if !rejected(a) { return fail("Vt register 32") }
	a = newAsm()
	LdStMultiPostReg(a, false, 1, 1, true, 0, 5, 18, -1)
	if !rejected(a) { return fail("post-index register -1") }
	return ""
}
