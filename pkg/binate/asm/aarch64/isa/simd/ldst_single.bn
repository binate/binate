package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD load / store single structure: LD1..LD4 / ST1..ST4
// of one element into or from each of selem consecutive registers from Vt (V31 is
// followed by V0), the replicating loads LD1R..LD4R (one element to every lane), and the
// FEAT_LRCPC3 LDAP1 / STL1 of a D element.  The structure forms are at [Xn|SP] with no
// offset or post-indexed by the transfer size (selem × the element's bytes) or by a
// register; Rm 31 selects the immediate post-index, so the register form takes X0..X30.
// The element index goes, left-aligned, into Q:S:size (B: index 0..15; H: 0..7; S: 0..3;
// D: 0..1, with size 01).

// singleWord packs a single-structure load / store (or, rep, a replicating load of a
// 128-bit (q) or 64-bit vector) onto base, returning ok=false when there is no such
// form (a replicating store among them).
func singleWord(base uint32, load bool, rep bool, q bool, selem int, size int, index int, rt int,
		rn int) (uint32, bool) {
	if selem < 1 || selem > 4 || size < 0 || size > 3 || (rep && !load) { return 0, false }
	var sel int = selem - 1
	var scale int = 3
	var qBit int = 0
	var s int = 0
	var sizeField int = size
	if q { qBit = 1 }
	if !rep {
		if index < 0 || index > (16 >> size) - 1 { return 0, false }
		var ix int = index << size
		scale = size
		if size == 3 { scale = 2 }
		qBit = ix >> 3
		s = (ix >> 2) & 1
		sizeField = ix & 3
		if size == 3 { sizeField = 1 }
	}
	var inst uint32 = base | (cast(uint32, qBit) << 30) | (cast(uint32, sel & 1) << 21) |
			(cast(uint32, (scale << 1) | (sel >> 1)) << 13) | (cast(uint32, s) << 12) |
			(cast(uint32, sizeField) << 10) | (cast(uint32, rn) << 5) | cast(uint32, rt)
	if load { inst = inst | 0x400000 }
	return inst, true
}

// singleEmit emits singleWord's instruction (base carries any post-index Rm field) or
// sets the error.
func singleEmit(a @asm.Assembler, base uint32, load bool, rep bool, q bool, selem int, size int,
		index int, rt int, rn int) {
	inst, ok := singleWord(base, load, rep, q, selem, size, index, rt, rn)
	if !ok {
		a.SetError("structure load / store: no such count, element or index")
		return
	}
	isa.Emit32(a, inst)
}

// singlePostImmOk reports whether imm is the transfer size of selem elements of size,
// setting the error when it is not.
func singlePostImmOk(a @asm.Assembler, selem int, size int, imm int) bool {
	if size < 0 || size > 3 || imm != selem << size {
		a.SetError("structure load / store: the post-index immediate is the transfer size")
		return false
	}
	return true
}

// singlePostRegOk reports whether rm (already range-checked) can be a post-index register,
// setting the error when it cannot.
func singlePostRegOk(a @asm.Assembler, rm int) bool {
	if rm == 31 {
		a.SetError("structure load / store: the post-index register is X0..X30")
		return false
	}
	return true
}

// LdStSingle emits LD<selem> (load) or ST<selem> `{Vt.<Ts>, …}[index], [Xn|SP]`: element
// index of size (0..3: B, H, S, D) in each of selem (1..4) consecutive registers.
func LdStSingle(a @asm.Assembler, load bool, selem int, size int, index int, rt int, rn int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) { return }
	singleEmit(a, 0x0D000000, load, false, false, selem, size, index, rt, rn)
}

// LdStSinglePostImm emits LdStSingle's instruction post-indexed by imm, which must be the
// transfer size: selem × the element's bytes.
func LdStSinglePostImm(a @asm.Assembler, load bool, selem int, size int, index int, rt int, rn int,
		imm int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) || !singlePostImmOk(a, selem, size, imm) { return }
	singleEmit(a, 0x0D9F0000, load, false, false, selem, size, index, rt, rn)
}

// LdStSinglePostReg emits LdStSingle's instruction post-indexed by Xm (rm 0..30).
func LdStSinglePostReg(a @asm.Assembler, load bool, selem int, size int, index int, rt int, rn int,
		rm int) {
	if !isa.RegsOk(a, rt, rn, rm, 0) || !singlePostRegOk(a, rm) { return }
	singleEmit(a, 0x0D800000 | (cast(uint32, rm) << 16), load, false, false, selem, size, index, rt,
			rn)
}

// LdRep emits LD<selem>R `{Vt.<T>, …}, [Xn|SP]`: one element of size (0..3) loaded into
// every lane of each of selem (1..4) consecutive registers, a 128-bit (q) or 64-bit
// vector.
func LdRep(a @asm.Assembler, selem int, q bool, size int, rt int, rn int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) { return }
	singleEmit(a, 0x0D000000, true, true, q, selem, size, 0, rt, rn)
}

// LdRepPostImm emits LdRep's instruction post-indexed by imm, which must be the transfer
// size: selem × the element's bytes.
func LdRepPostImm(a @asm.Assembler, selem int, q bool, size int, rt int, rn int, imm int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) || !singlePostImmOk(a, selem, size, imm) { return }
	singleEmit(a, 0x0D9F0000, true, true, q, selem, size, 0, rt, rn)
}

// LdRepPostReg emits LdRep's instruction post-indexed by Xm (rm 0..30).
func LdRepPostReg(a @asm.Assembler, selem int, q bool, size int, rt int, rn int, rm int) {
	if !isa.RegsOk(a, rt, rn, rm, 0) || !singlePostRegOk(a, rm) { return }
	singleEmit(a, 0x0D800000 | (cast(uint32, rm) << 16), true, true, q, selem, size, 0, rt, rn)
}

// Ldap1 emits LDAP1 (load-acquire) or, !load, STL1 (store-release) `{Vt.D}[index],
// [Xn|SP]` (index 0..1).
func Ldap1(a @asm.Assembler, load bool, index int, rt int, rn int) {
	if !isa.RegsOk(a, rt, rn, 0, 0) { return }
	if index < 0 || index > 1 {
		a.SetError("ldap1 / stl1: the D element index is 0..1")
		return
	}
	var inst uint32 = 0x0D018400 | (cast(uint32, index) << 30) | (cast(uint32, rn) << 5) |
			cast(uint32, rt)
	if load { inst = inst | 0x400000 }
	isa.Emit32(a, inst)
}
