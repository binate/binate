package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The single-structure, replicating and LDAP1 / STL1 encoders' own checks: the index per
// element size, the structure count, the post-index immediate (the transfer size) and
// register (not 31), and register range (the text assembler's golden tables cover every
// encoding).

func TestLdStSingleChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdStSingle(a, true, 1, 2, 1, 5, 18)
	if !clean(a, 1) || !wordIs(a, 0, 0x0D409245) { return fail("ld1 {v5.s}[1], [x18]") }
	a = newAsm()
	LdStSinglePostImm(a, true, 4, 3, 1, 31, 31, 32)
	if !clean(a, 1) || !wordIs(a, 0, 0x4DFFA7FF) { return fail("ld4 {v31.d, …}[1], [sp], #32") }
	a = newAsm()
	LdStSinglePostReg(a, false, 4, 1, 7, 5, 18, 30)
	if !clean(a, 1) || !wordIs(a, 0, 0x4DBE7A45) { return fail("st4 {v5.h, …}[7], [x18], x30") }
	var maxIx [4]int = [4]int{15, 7, 3, 1}
	for size := 0; size < 4; size++ {
		a = newAsm()
		LdStSingle(a, true, 2, size, maxIx[size] + 1, 5, 18)
		if !rejected(a) { return fail("an index past the element count") }
		a = newAsm()
		LdStSingle(a, true, 2, size, maxIx[size], 5, 18)
		if !clean(a, 1) { return fail("the last index") }
	}
	a = newAsm()
	LdStSingle(a, true, 1, 0, -1, 5, 18)
	if !rejected(a) { return fail("index -1") }
	a = newAsm()
	LdStSingle(a, true, 5, 0, 0, 5, 18)
	if !rejected(a) { return fail("ld5") }
	a = newAsm()
	LdStSingle(a, true, 1, 4, 0, 5, 18)
	if !rejected(a) { return fail("element size 4") }
	a = newAsm()
	LdStSinglePostImm(a, true, 2, 2, 0, 5, 18, 16)
	if !rejected(a) { return fail("ld2 of S post-indexed by 16") }
	a = newAsm()
	LdStSinglePostReg(a, true, 1, 0, 0, 5, 18, 31)
	if !rejected(a) { return fail("post-index register 31") }
	return ""
}

func TestLdRepAndLdap1Checks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	LdRep(a, 1, true, 2, 5, 18)
	if !clean(a, 1) || !wordIs(a, 0, 0x4D40CA45) { return fail("ld1r {v5.4s}, [x18]") }
	a = newAsm()
	LdRepPostImm(a, 2, true, 3, 31, 0, 16)
	if !clean(a, 1) || !wordIs(a, 0, 0x4DFFCC1F) { return fail("ld2r {v31.2d, v0.2d}, [x0], #16") }
	a = newAsm()
	LdRepPostImm(a, 3, false, 0, 5, 18, 3)
	if !clean(a, 1) || !wordIs(a, 0, 0x0DDFE245) { return fail("ld3r {v5.8b, …}, [x18], #3") }
	a = newAsm()
	LdRep(a, 1, false, 3, 5, 18)
	if !clean(a, 1) { return fail("ld1r {v5.1d}") }
	a = newAsm()
	LdRepPostImm(a, 4, true, 1, 5, 18, 16)
	if !rejected(a) { return fail("ld4r of H post-indexed by 16") }
	a = newAsm()
	LdRepPostReg(a, 1, true, 0, 5, 18, 31)
	if !rejected(a) { return fail("ld1r post-index register 31") }
	a = newAsm()
	LdRep(a, 0, true, 0, 5, 18)
	if !rejected(a) { return fail("ld0r") }
	a = newAsm()
	LdRep(a, 1, true, 4, 5, 18)
	if !rejected(a) { return fail("ld1r of element size 4") }
	a = newAsm()
	LdRep(a, 1, true, -1, 5, 18)
	if !rejected(a) { return fail("ld1r of element size -1") }
	a = newAsm()
	LdRep(a, 1, true, 0, 32, 18)
	if !rejected(a) { return fail("ld1r Vt register 32") }
	a = newAsm()
	Ldap1(a, true, 1, 31, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4D4187FF) { return fail("ldap1 {v31.d}[1], [sp]") }
	a = newAsm()
	Ldap1(a, false, 0, 5, 18)
	if !clean(a, 1) || !wordIs(a, 0, 0x0D018645) { return fail("stl1 {v5.d}[0], [x18]") }
	a = newAsm()
	Ldap1(a, true, 2, 5, 18)
	if !rejected(a) { return fail("ldap1 d[2]") }
	a = newAsm()
	Ldap1(a, true, -1, 5, 18)
	if !rejected(a) { return fail("ldap1 d[-1]") }
	a = newAsm()
	Ldap1(a, false, 0, 5, 32)
	if !rejected(a) { return fail("Rn register 32") }
	return ""
}
