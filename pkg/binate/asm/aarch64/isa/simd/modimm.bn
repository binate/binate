package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD modified-immediate class: MOVI (bytes; 16- and
// 32-bit elements with a left shift or, for 32-bit, a shift of ones in (MSL); a 64-bit
// pattern of whole 0x00 / 0xFF bytes, to a D scalar or 2D), MVNI (inverted), ORR / BIC
// with an 8-bit immediate shifted into 16- or 32-bit elements, and FMOV of an 8-bit
// floating-point immediate to every element (4H / 8H with FEAT_FP16, 2S / 4S, 2D).  The
// 8-bit value is split into a:b:c (bits 18:16) and d:e:f:g:h (bits 9:5).

// modImmWord packs the class fields: op (bit 29), cmode (bits 15:12), o2 (bit 11) and the
// 8-bit immediate imm8, onto Q and Rd.
func modImmWord(q bool, op int, cmode int, o2 int, imm8 int, rd int) uint32 {
	var inst uint32 = 0x0F000400 | (cast(uint32, op) << 29) | (cast(uint32, imm8 >> 5) << 16) |
			(cast(uint32, cmode) << 12) | (cast(uint32, o2) << 11) | (cast(uint32, imm8 & 0x1F) << 5) |
			cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	return inst
}

// MoviBytes emits MOVI `Vd.8B|16B, #imm8` (q: 16B).
func MoviBytes(a @asm.Assembler, q bool, imm8 int, rd int) {
	if !isa.RegsOk(a, rd, 0, 0, 0) { return }
	if imm8 < 0 || imm8 > 255 {
		a.SetError("movi: the byte immediate is 0..255")
		return
	}
	isa.Emit32(a, modImmWord(q, 0, 0xE, 0, imm8, rd))
}

// ShiftedImm emits an MI_* operation (MOVI, MVNI, ORR, BIC) `Vd.<T>, #imm8{, LSL #shift}`
// on 16-bit (size 1: 4H / 8H, shift 0 or 8) or 32-bit (size 2: 2S / 4S, shift 0, 8, 16
// or 24) elements.
func ShiftedImm(a @asm.Assembler, op int, q bool, size int, imm8 int, shift int, rd int) {
	if !isa.RegsOk(a, rd, 0, 0, 0) { return }
	var opOk bool = op == MI_MOVI || op == MI_MVNI || op == MI_ORR || op == MI_BIC
	var shiftOk bool = (size == 1 && (shift == 0 || shift == 8)) ||
			(size == 2 && (shift == 0 || shift == 8 || shift == 16 || shift == 24))
	if !opOk || !shiftOk || imm8 < 0 || imm8 > 255 {
		a.SetError("simd modified immediate: #0..255 into H (lsl #0 / #8) or S (lsl #0..#24)")
		return
	}
	var cmode int = (shift / 8) << 1
	if size == 1 { cmode = 0x8 | cmode }
	if op == MI_ORR || op == MI_BIC { cmode = cmode | 1 }
	var inv int = 0
	if op == MI_MVNI || op == MI_BIC { inv = 1 }
	isa.Emit32(a, modImmWord(q, inv, cmode, 0, imm8, rd))
}

// MoviOnes emits MOVI (or MVNI, inv) `Vd.2S|4S, #imm8, MSL #shift`: the value shifted left
// by 8 or 16 with ones shifted in.
func MoviOnes(a @asm.Assembler, inv bool, q bool, imm8 int, shift int, rd int) {
	if !isa.RegsOk(a, rd, 0, 0, 0) { return }
	if (shift != 8 && shift != 16) || imm8 < 0 || imm8 > 255 {
		a.SetError("movi / mvni: #0..255, msl #8 or #16")
		return
	}
	var cmode int = 0xC
	if shift == 16 { cmode = 0xD }
	var op int = 0
	if inv { op = 1 }
	isa.Emit32(a, modImmWord(q, op, cmode, 0, imm8, rd))
}

// Movi64 emits MOVI `Dd, #imm` or (vector) `Vd.2D, #imm`: imm's eight bytes each 0x00 or
// 0xFF.
func Movi64(a @asm.Assembler, vector bool, imm uint64, rd int) {
	if !isa.RegsOk(a, rd, 0, 0, 0) { return }
	var imm8 int = 0
	for i := 0; i < 8; i++ {
		var b uint64 = (imm >> cast(uint64, i * 8)) & 0xFF
		if b == 0xFF {
			imm8 = imm8 | (1 << i)
		} else if b != 0 {
			a.SetError("movi: a 64-bit immediate's bytes are each 0x00 or 0xff")
			return
		}
	}
	isa.Emit32(a, modImmWord(vector, 1, 0xE, 0, imm8, rd))
}

// FMovVecImm emits FMOV `Vd.<T>, #imm` of the 8-bit floating-point immediate imm8 (the
// FMOV encoding: sign, 3-bit exponent, 4-bit fraction) to every element of precision ft:
// isa.FT_H (4H / 8H), isa.FT_S (2S / 4S) or isa.FT_D (2D; q set).
func FMovVecImm(a @asm.Assembler, ft int, q bool, imm8 int, rd int) {
	if !isa.RegsOk(a, rd, 0, 0, 0) { return }
	if imm8 < 0 || imm8 > 255 || (ft != isa.FT_H && ft != isa.FT_S && (ft != isa.FT_D || !q)) {
		a.SetError("fmov: 4H / 8H, 2S / 4S or 2D, an 8-bit floating-point immediate")
		return
	}
	var op int = 0
	var o2 int = 0
	if ft == isa.FT_D { op = 1 }
	if ft == isa.FT_H { o2 = 1 }
	isa.Emit32(a, modImmWord(q, op, 0xF, o2, imm8, rd))
}
