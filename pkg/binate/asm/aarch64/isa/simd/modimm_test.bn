package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/builtins/testing"

// The modified-immediate encoders' own checks: immediate and shift ranges, the MSL
// amounts, the 64-bit byte patterns, FMOV's precisions, and register range (the text
// assembler's golden tables cover every encoding).

func TestModImmChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ShiftedImm(a, MI_BIC, true, 2, 255, 24, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F0777E0) { return fail("bic v0.4s, #255, lsl #24") }
	a = newAsm()
	ShiftedImm(a, MI_MVNI, true, 1, 0xAB, 8, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F05A57F) { return fail("mvni v31.8h, #0xab, lsl #8") }
	a = newAsm()
	MoviOnes(a, false, true, 0xFF, 16, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4F07D7E0) { return fail("movi v0.4s, #0xff, msl #16") }
	a = newAsm()
	Movi64(a, true, 0xFF00, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F00E45F) { return fail("movi v31.2d, #0xff00") }
	a = newAsm()
	FMovVecImm(a, isa.FT_D, true, 0xBF, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F05F7FF) { return fail("fmov v31.2d, #-31.0") }
	a = newAsm()
	FMovVecImm(a, isa.FT_H, true, 0x60, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4F03FC00) { return fail("fmov v0.8h, #0.5") }
	a = newAsm()
	ShiftedImm(a, MI_MOVI, true, 1, 1, 16, 0)
	if !rejected(a) { return fail("lsl #16 on H") }
	a = newAsm()
	ShiftedImm(a, MI_ORR, true, 2, 256, 0, 0)
	if !rejected(a) { return fail("immediate 256") }
	a = newAsm()
	ShiftedImm(a, 4, true, 2, 1, 0, 0)
	if !rejected(a) { return fail("operation 4") }
	a = newAsm()
	MoviOnes(a, true, true, 1, 24, 0)
	if !rejected(a) { return fail("msl #24") }
	a = newAsm()
	Movi64(a, false, 0x1200, 0)
	if !rejected(a) { return fail("a 64-bit pattern with byte 0x12") }
	a = newAsm()
	MoviBytes(a, true, -1, 0)
	if !rejected(a) { return fail("byte -1") }
	a = newAsm()
	FMovVecImm(a, isa.FT_D, false, 0x70, 0)
	if !rejected(a) { return fail("fmov of 1d") }
	a = newAsm()
	FMovVecImm(a, isa.FT_S, true, 0x70, 32)
	if !rejected(a) { return fail("Vd register 32") }
	return ""
}
