package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD permutes — UZP1 / UZP2, TRN1 / TRN2 and ZIP1 /
// ZIP2 on any arrangement but 1D — and the byte extract EXT, whose index is the number
// of a byte of Vn: 0..7 for 8B, 0..15 for 16B (for 8B, imm4 with bit 3 set is UNDEFINED).

// Permute emits a PERM_* permute `Vd.<T>, Vn.<T>, Vm.<T>` on a 128-bit (q) or 64-bit
// vector of size (0..3: B, H, S, D; D only with q) elements.
func Permute(a @asm.Assembler, op int, q bool, size int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	var opOk bool = op == PERM_UZP1 || op == PERM_TRN1 || op == PERM_ZIP1 || op == PERM_UZP2 ||
			op == PERM_TRN2 || op == PERM_ZIP2
	if !opOk || size < 0 || size > 3 || (size == 3 && !q) {
		a.SetError("simd permute: no such operation or arrangement")
		return
	}
	var inst uint32 = 0x0E000800 | (cast(uint32, size) << 22) | (cast(uint32, rm) << 16) |
			(cast(uint32, op) << 12) | (cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// Ext emits EXT `Vd.<T>, Vn.<T>, Vm.<T>, #index`: the bytes of Vm:Vn from byte index
// on.  <T> is 16B (q; index 0..15) or 8B (index 0..7).
func Ext(a @asm.Assembler, q bool, rd int, rn int, rm int, index int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	var maxIndex int = 7
	if q { maxIndex = 15 }
	if index < 0 || index > maxIndex {
		a.SetError("ext: the index is 0..7 for 8b, 0..15 for 16b")
		return
	}
	var inst uint32 = 0x2E000000 | (cast(uint32, rm) << 16) | (cast(uint32, index) << 11) |
			(cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}
