package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The permute and EXT encoders' own checks: the operations, 1D, EXT's index range per
// width, and register range (the text assembler's golden tables cover every encoding).

func TestPermuteChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Permute(a, PERM_ZIP1, true, 3, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EDF381F) { return fail("zip1 v31.2d, v0.2d, v31.2d") }
	a = newAsm()
	Permute(a, PERM_UZP1, false, 0, 5, 18, 2)
	if !clean(a, 1) || !wordIs(a, 0, 0x0E021A45) { return fail("uzp1 v5.8b, v18.8b, v2.8b") }
	a = newAsm()
	Permute(a, PERM_TRN2, false, 3, 5, 18, 2)
	if !rejected(a) { return fail("trn2 of 1d") }
	var bad [4]int = [4]int{0, 4, 8, -1}
	for i := 0; i < 4; i++ {
		a = newAsm()
		Permute(a, bad[i], true, 2, 5, 18, 2)
		if !rejected(a) { return fail("a permute opcode that is none") }
	}
	a = newAsm()
	Permute(a, PERM_ZIP2, true, 4, 5, 18, 2)
	if !rejected(a) { return fail("element size 4") }
	a = newAsm()
	Permute(a, PERM_ZIP2, true, -1, 5, 18, 2)
	if !rejected(a) { return fail("element size -1") }
	a = newAsm()
	Permute(a, PERM_ZIP2, true, 2, 5, 32, 2)
	if !rejected(a) { return fail("Vn register 32") }
	return ""
}

func TestExtChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ext(a, true, 5, 18, 2, 15)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E027A45) { return fail("ext v5.16b, v18.16b, v2.16b, #15") }
	a = newAsm()
	Ext(a, false, 5, 18, 2, 7)
	if !clean(a, 1) || !wordIs(a, 0, 0x2E023A45) { return fail("ext v5.8b, v18.8b, v2.8b, #7") }
	a = newAsm()
	Ext(a, false, 5, 18, 2, 8)
	if !rejected(a) { return fail("ext 8b #8") }
	a = newAsm()
	Ext(a, true, 5, 18, 2, 16)
	if !rejected(a) { return fail("ext 16b #16") }
	a = newAsm()
	Ext(a, true, 5, 18, 2, -1)
	if !rejected(a) { return fail("ext #-1") }
	a = newAsm()
	Ext(a, true, -1, 18, 2, 0)
	if !rejected(a) { return fail("Vd register -1") }
	a = newAsm()
	Ext(a, true, 5, 18, 32, 0)
	if !rejected(a) { return fail("Vm register 32") }
	return ""
}
