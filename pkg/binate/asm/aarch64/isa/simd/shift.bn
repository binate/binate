package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD shift-by-immediate class, vector and scalar: the
// right shifts (SSHR / USHR, SSRA / USRA, SRSHR / URSHR, SRSRA / URSRA, SRI; #1..esize), the
// left shifts (SHL, SLI, SQSHL / UQSHL, SQSHLU; #0..esize-1), the narrowing right shifts
// (SHRN, RSHRN and their saturating forms; #1..the narrow esize), the long left shifts
// (SSHLL / USHLL; #0..the narrow esize-1), and the fixed-point conversions (SCVTF / UCVTF
// / FCVTZS / FCVTZU with #1..esize fraction bits, on H / S / D).  immh:immb holds the
// element size (its leading one) and the shift: 2*esize - shift for a right shift,
// esize + shift for a left shift.

// shRight reports whether op shifts right (its immediate counts down from 2*esize).
func shRight(op int) bool {
	return op == SH_SSHR || op == SH_SSRA || op == SH_SRSHR || op == SH_SRSRA || op == SH_USHR ||
			op == SH_USRA || op == SH_URSHR || op == SH_URSRA || op == SH_SRI || shNarrow(op) || shFixed(op)
}

// shNarrow reports whether op is a narrowing right shift.
func shNarrow(op int) bool {
	return op == SH_SHRN || op == SH_RSHRN || op == SH_SQSHRN || op == SH_SQRSHRN ||
			op == SH_SQSHRUN || op == SH_SQRSHRUN || op == SH_UQSHRN || op == SH_UQRSHRN
}

// shFixed reports whether op is a fixed-point conversion.
func shFixed(op int) bool {
	return op == SH_SCVTF || op == SH_UCVTF || op == SH_FCVTZS || op == SH_FCVTZU
}

// shLeft reports whether op shifts left (its immediate counts up from esize).
func shLeft(op int) bool {
	return op == SH_SHL || op == SH_SLI || op == SH_SQSHL || op == SH_UQSHL || op == SH_SQSHLU ||
			op == SH_SSHLL || op == SH_USHLL
}

// shSizeOk reports whether op takes element size size (the narrow one for the narrowing
// and long forms) in the vector (q for the 128-bit or "2" form) or scalar form.
func shSizeOk(op int, size int, q bool, scalar bool) bool {
	if size < 0 || size > 3 { return false }
	var narrowOrLong bool = shNarrow(op) || op == SH_SSHLL || op == SH_USHLL
	if narrowOrLong {
		if size > 2 { return false }
		if !scalar { return true }
		return shNarrow(op) && op != SH_SHRN && op != SH_RSHRN
	}
	if shFixed(op) && size == 0 { return false }
	if scalar {
		return size == 3 || op == SH_SQSHL || op == SH_UQSHL || op == SH_SQSHLU || shFixed(op)
	}
	return size < 3 || q
}

// shImm returns the 7-bit immh:immb of op at element size size and shift shift, or -1
// when shift is out of op's range.
func shImm(op int, size int, shift int) int {
	var esize int = 8 << size
	if shRight(op) {
		if shift < 1 || shift > esize { return -1 }
		return 2 * esize - shift
	}
	if shift < 0 || shift >= esize { return -1 }
	return esize + shift
}

// shWord packs a shift-by-immediate instruction onto base.
func shWord(base uint32, op int, imm int, rd int, rn int) uint32 {
	return base | (cast(uint32, op >> 5) << 29) | (cast(uint32, imm) << 16) |
			(cast(uint32, op & 0x1F) << 11) | (cast(uint32, rn) << 5) | cast(uint32, rd)
}

// ShiftImm emits the vector form of an SH_* operation at element size size (the narrow
// element's for the narrowing and long forms; H / S / D for the fixed-point ones) and
// shift (or fraction bits) shift, on a 128-bit (q) or 64-bit vector — for the narrowing and
// long forms q selects the "2" form.
func ShiftImm(a @asm.Assembler, op int, q bool, size int, shift int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var imm int = -1
	if (shRight(op) || shLeft(op)) && shSizeOk(op, size, q, false) { imm = shImm(op, size, shift) }
	if imm < 0 {
		a.SetError("simd shift by immediate: no such operation, arrangement or shift")
		return
	}
	var inst uint32 = shWord(0x0F000400, op, imm, rd, rn)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// ShiftImmScalar emits the scalar form of an SH_* operation at element size size (the
// narrow result's for the narrowing forms).
func ShiftImmScalar(a @asm.Assembler, op int, size int, shift int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	var imm int = -1
	if (shRight(op) || shLeft(op)) && shSizeOk(op, size, false, true) {
		imm = shImm(op, size, shift)
	}
	if imm < 0 {
		a.SetError("simd shift by immediate: no such scalar operation, size or shift")
		return
	}
	isa.Emit32(a, shWord(0x5F000400, op, imm, rd, rn))
}
