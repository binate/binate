package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The shift-by-immediate encoders' own checks: each kind's shift range, the element sizes
// of the vector, narrowing / long and scalar forms, and register range (the text
// assembler's golden tables cover every encoding).

func TestShiftImmChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ShiftImm(a, SH_SSHR, true, 3, 64, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4F40041F) { return fail("sshr v31.2d, v0.2d, #64") }
	a = newAsm()
	ShiftImm(a, SH_SHL, true, 2, 30, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4F3E57E0) { return fail("shl v0.4s, v31.4s, #30") }
	a = newAsm()
	ShiftImm(a, SH_USHLL, true, 2, 0, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F20A41F) { return fail("ushll2 v31.2d, v0.4s, #0") }
	a = newAsm()
	ShiftImm(a, SH_SQRSHRUN, true, 0, 8, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6F088C1F) { return fail("sqrshrun2 v31.16b, v0.8h, #8") }
	var badOp [6]int = [6]int{SH_SSHR, SH_SHL, SH_SHRN, SH_SSHLL, SH_SCVTF, SH_SSHR}
	var badSize [6]int = [6]int{0, 0, 0, 2, 2, 3}
	var badShift [6]int = [6]int{0, 8, 9, 32, 33, 1}
	var badQ [6]bool = [6]bool{true, true, false, false, true, false}
	for i := 0; i < 6; i++ {
		a = newAsm()
		ShiftImm(a, badOp[i], badQ[i], badSize[i], badShift[i], 0, 1)
		if !rejected(a) { return fail("a shift out of range, or 1d") }
	}
	a = newAsm()
	ShiftImm(a, SH_SHRN, false, 3, 1, 0, 1)
	if !rejected(a) { return fail("shrn to D") }
	a = newAsm()
	ShiftImm(a, SH_FCVTZS, true, 0, 1, 0, 1)
	if !rejected(a) { return fail("fcvtzs on B") }
	a = newAsm()
	ShiftImm(a, 0x08, true, 0, 1, 0, 1)
	if !rejected(a) { return fail("an operation that is not a shift") }
	a = newAsm()
	ShiftImm(a, SH_SLI, true, 0, 1, 0, 32)
	if !rejected(a) { return fail("Vn register 32") }
	return ""
}

func TestShiftImmScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ShiftImmScalar(a, SH_SQSHL, 2, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x5F3F77E0) { return fail("sqshl s0, s31, #31") }
	a = newAsm()
	ShiftImmScalar(a, SH_UQRSHRN, 2, 32, 5, 18)
	if !clean(a, 1) || !wordIs(a, 0, 0x7F209E45) { return fail("uqrshrn s5, d18, #32") }
	var badOp [5]int = [5]int{SH_SSHR, SH_SHL, SH_SHRN, SH_SSHLL, SH_SCVTF}
	var badSize [5]int = [5]int{2, 1, 0, 0, 0}
	for i := 0; i < 5; i++ {
		a = newAsm()
		ShiftImmScalar(a, badOp[i], badSize[i], 1, 0, 1)
		if !rejected(a) { return fail("a scalar shift this class does not have") }
	}
	a = newAsm()
	ShiftImmScalar(a, SH_SRI, 3, 0, 0, 1)
	if !rejected(a) { return fail("sri d0, d1, #0") }
	return ""
}
