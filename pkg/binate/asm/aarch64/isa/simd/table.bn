package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoder for the Advanced SIMD table lookup: TBL and TBX.  The table is one to
// four consecutive 128-bit registers starting at Rn (V31 is followed by V0), so only Rn
// and the count are encoded.

// TableLookup emits TBL (or TBX, tbx) `Vd.<T>, {Vn.16B, …}, Vm.<T>`: each byte of Vm
// indexes the count-register table; an out-of-range index gives zero (TBL) or leaves
// Vd's byte (TBX).  <T> is 16B (q) or 8B.
func TableLookup(a @asm.Assembler, q bool, tbx bool, rd int, rn int, count int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if count < 1 || count > 4 {
		a.SetError("tbl / tbx: the table holds one to four registers")
		return
	}
	var inst uint32 = 0x0E000000 | (cast(uint32, rm) << 16) | (cast(uint32, count - 1) << 13) |
			(cast(uint32, rn) << 5) | cast(uint32, rd)
	if q { inst = inst | 0x40000000 }
	if tbx { inst = inst | 0x1000 }
	isa.Emit32(a, inst)
}
