package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The table-lookup encoder's own checks: the table's register count and the register
// range (the text assembler's golden tables cover the encodings).

func TestTableLookupChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TableLookup(a, true, true, 31, 31, 1, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E1F13FF) {
		return fail("tbx v31.16b, {v31.16b}, v31.16b")
	}
	a = newAsm()
	TableLookup(a, false, false, 2, 5, 4, 9)
	if !clean(a, 1) || !wordIs(a, 0, 0x0E0960A2) {
		return fail("tbl v2.8b, {v5.16b-v8.16b}, v9.8b")
	}
	a = newAsm()
	TableLookup(a, true, false, 0, 1, 0, 3)
	if !rejected(a) { return fail("a table of no registers") }
	a = newAsm()
	TableLookup(a, true, false, 0, 1, 5, 3)
	if !rejected(a) { return fail("a table of five registers") }
	a = newAsm()
	TableLookup(a, true, false, 0, 1, 1, 32)
	if !rejected(a) { return fail("Vm register 32") }
	a = newAsm()
	TableLookup(a, true, false, -1, 1, 1, 3)
	if !rejected(a) { return fail("Vd register -1") }
	a = newAsm()
	TableLookup(a, true, false, 0, 32, 1, 3)
	if !rejected(a) { return fail("Vn register 32") }
	return ""
}
