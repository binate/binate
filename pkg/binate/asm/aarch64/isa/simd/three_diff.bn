package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the Advanced SIMD three-different class: the long operations
// (`Vd.<Ta>, Vn.<Tb>, Vm.<Tb>`, Ta twice Tb's element size), the wide ones (`Vd.<Ta>,
// Vn.<Ta>, Vm.<Tb>`) and the narrowing ones (`Vd.<Tb>, Vn.<Ta>, Vm.<Ta>`).  size is the
// narrow (Tb) element size and q selects the upper half of the narrow operand (the "2"
// forms).  The scalar form exists for SQDMLAL / SQDMLSL / SQDMULL.

// t3OpOk reports whether op is a T3_* operation: the U=0 opcodes 0000..1110, and the U=1
// ones with an unsigned or rounding counterpart (not 1001, 1011, 1101, 1110).
func t3OpOk(op int) bool {
	if op < 0 || op > 0x1F || op == 0x0F { return false }
	return op < 0x10 || (op != 0x19 && op != 0x1B && op != 0x1D && op != 0x1E && op != 0x1F)
}

// t3SizeOk reports whether op exists for narrow element size size: H / S for the
// saturating doubling SQDMLAL / SQDMLSL / SQDMULL, B or D (the 128-bit product, FEAT_PMULL)
// for PMULL, and B / H / S for the rest.
func t3SizeOk(op int, size int) bool {
	if op == T3_SQDMLAL || op == T3_SQDMLSL || op == T3_SQDMULL { return size == 1 || size == 2 }
	if op == T3_PMULL { return size == 0 || size == 3 }
	return size >= 0 && size <= 2
}

// t3Word packs a three-different instruction onto base: U (op bit 4), size, Rm, the
// opcode (op bits 3:0), Rn and Rd.
func t3Word(base uint32, op int, size int, rd int, rn int, rm int) uint32 {
	return base | (cast(uint32, op >> 4) << 29) | (cast(uint32, size) << 22) |
			(cast(uint32, rm) << 16) | (cast(uint32, op & 0xF) << 12) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
}

// ThreeDiff emits the vector form of a T3_* operation with narrow element size size
// (0..2: B, H, S; PMULL also 3: D), q selecting the "2" form.
func ThreeDiff(a @asm.Assembler, op int, q bool, size int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if !t3OpOk(op) || !t3SizeOk(op, size) {
		a.SetError("simd three-different: no such operation for this element size")
		return
	}
	var inst uint32 = t3Word(0x0E200000, op, size, rd, rn, rm)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// ThreeDiffScalar emits the scalar form of SQDMLAL / SQDMLSL / SQDMULL: `Sd, Hn, Hm`
// (size 1) or `Dd, Sn, Sm` (size 2).
func ThreeDiffScalar(a @asm.Assembler, op int, size int, rd int, rn int, rm int) {
	if !isa.RegsOk(a, rd, rn, rm, 0) { return }
	if (op != T3_SQDMLAL && op != T3_SQDMLSL && op != T3_SQDMULL) || (size != 1 && size != 2) {
		a.SetError(
				"simd three-different: the scalar form is SQDMLAL / SQDMLSL / SQDMULL "
						"from H or S")
		return
	}
	isa.Emit32(a, t3Word(0x5E200000, op, size, rd, rn, rm))
}
