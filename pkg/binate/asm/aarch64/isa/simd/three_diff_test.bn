package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The three-different encoders' own checks: the operation set (the unallocated U=1
// opcodes and 1111 excluded), the per-operation element sizes, the scalar subset, and
// register range (the text assembler's golden tables cover every encoding).

func TestThreeDiffChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ThreeDiff(a, T3_SMLAL, true, 2, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EBF801F) {
		return fail("smlal2 v31.2d, v0.4s, v31.4s")
	}
	a = newAsm()
	ThreeDiff(a, T3_PMULL, true, 3, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4EFFE01F) {
		return fail("pmull2 v31.1q, v0.2d, v31.2d")
	}
	a = newAsm()
	ThreeDiff(a, T3_RADDHN, true, 0, 0, 31, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E3F43E0) {
		return fail("raddhn2 v0.16b, v31.8h, v31.8h")
	}
	var badOps [7]int = [7]int{0x0F, 0x19, 0x1B, 0x1D, 0x1E, 0x1F, -1}
	for i := 0; i < 7; i++ {
		a = newAsm()
		ThreeDiff(a, badOps[i], false, 1, 0, 1, 2)
		if !rejected(a) { return fail("an unallocated operation") }
	}
	a = newAsm()
	ThreeDiff(a, T3_SADDL, false, 3, 0, 1, 2)
	if !rejected(a) { return fail("saddl of D sources") }
	a = newAsm()
	ThreeDiff(a, T3_SQDMULL, false, 0, 0, 1, 2)
	if !rejected(a) { return fail("sqdmull of B sources") }
	a = newAsm()
	ThreeDiff(a, T3_PMULL, false, 1, 0, 1, 2)
	if !rejected(a) { return fail("pmull of H sources") }
	a = newAsm()
	ThreeDiff(a, T3_UADDL, false, 0, 0, 32, 2)
	if !rejected(a) { return fail("Vn register 32") }
	return ""
}

func TestThreeDiffScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	ThreeDiffScalar(a, T3_SQDMLSL, 2, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x5EBFB01F) { return fail("sqdmlsl d31, s0, s31") }
	a = newAsm()
	ThreeDiffScalar(a, T3_SMULL, 1, 0, 1, 2)
	if !rejected(a) { return fail("a scalar SMULL") }
	a = newAsm()
	ThreeDiffScalar(a, T3_SQDMULL, 3, 0, 1, 2)
	if !rejected(a) { return fail("a scalar SQDMULL of D sources") }
	a = newAsm()
	ThreeDiffScalar(a, T3_SQDMULL, 0, 0, 1, 2)
	if !rejected(a) { return fail("a scalar SQDMULL of B sources") }
	a = newAsm()
	ThreeDiffScalar(a, T3_SQDMLAL, 1, -1, 1, 2)
	if !rejected(a) { return fail("Sd register -1") }
	return ""
}
