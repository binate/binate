package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The three-same-extra integer encoders' own checks: SQRDMLAH / SQRDMLSH element sizes,
// the dot-product and matrix-multiply operation sets, and register range (the text
// assembler's golden tables cover every encoding).

func TestRdmlahChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Rdmlah(a, false, true, 1, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E5F841F) {
		return fail("sqrdmlah v31.8h, v0.8h, v31.8h")
	}
	a = newAsm()
	RdmlahScalar(a, true, 2, 0, 31, 1)
	if !clean(a, 1) || !wordIs(a, 0, 0x7E818FE0) { return fail("sqrdmlsh s0, s31, s1") }
	var bad [3]int = [3]int{0, 3, -1}
	for i := 0; i < 3; i++ {
		a = newAsm()
		Rdmlah(a, false, true, bad[i], 0, 1, 2)
		if !rejected(a) { return fail("a vector size other than H / S") }
		a = newAsm()
		RdmlahScalar(a, false, bad[i], 0, 1, 2)
		if !rejected(a) { return fail("a scalar size other than H / S") }
	}
	a = newAsm()
	Rdmlah(a, false, true, 1, 0, 32, 2)
	if !rejected(a) { return fail("Vn register 32") }
	a = newAsm()
	RdmlahScalar(a, false, 1, -1, 1, 2)
	if !rejected(a) { return fail("Hd register -1") }
	return ""
}

func TestDotAndMatMulChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	DotProduct(a, DOT_SDOT, true, 31, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E9F941F) {
		return fail("sdot v31.4s, v0.16b, v31.16b")
	}
	a = newAsm()
	DotProduct(a, DOT_UDOT, false, 0, 1, 2)
	if !clean(a, 1) || !wordIs(a, 0, 0x2E829420) { return fail("udot v0.2s, v1.8b, v2.8b") }
	a = newAsm()
	DotProduct(a, 3, true, 0, 1, 2)
	if !rejected(a) { return fail("dot product 3") }
	a = newAsm()
	DotProduct(a, DOT_SDOT, true, 32, 1, 2)
	if !rejected(a) { return fail("Vd register 32") }
	a = newAsm()
	IntMatMul(a, MM_USMMLA, 31, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x4E80AFFF) {
		return fail("usmmla v31.4s, v31.16b, v0.16b")
	}
	a = newAsm()
	IntMatMul(a, -1, 0, 1, 2)
	if !rejected(a) { return fail("matrix multiply -1") }
	a = newAsm()
	IntMatMul(a, MM_SMMLA, 0, 1, 32)
	if !rejected(a) { return fail("Vm register 32") }
	return ""
}
