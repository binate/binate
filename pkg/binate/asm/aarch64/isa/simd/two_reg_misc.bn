package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// Exact encoders for the integer instructions of the Advanced SIMD two-register
// miscellaneous class, vector and scalar: the element reversals REV16 / REV32 / REV64,
// the pairwise add-long and accumulate SADDLP / UADDLP / SADALP / UADALP, the saturating
// accumulates SUQADD / USQADD, CLS / CLZ / CNT, NOT / RBIT, SQABS / SQNEG / ABS / NEG,
// the compares against zero, the narrowing XTN / SQXTN / UQXTN / SQXTUN, and SHLL.  size
// is the element size the operation names: the source's for the pairwise and SHLL
// forms, the narrow destination's for the narrowing ones.

// m2Field returns the encoded U:opcode (bits 5:0) and size field of op at element size
// size, or ok=false when op has no such form in the vector (scalar false) or scalar
// form (size 3 needs q in the vector form).
func m2Field(op int, size int, q bool, scalar bool) (int, int, bool) {
	if size < 0 || size > 3 { return 0, 0, false }
	if op == M2_NOT || op == M2_RBIT {
		if scalar || size != 0 { return 0, 0, false }
		if op == M2_RBIT { return 0x25, 1, true }
		return 0x25, 0, true
	}
	var anySize bool = op == M2_SUQADD || op == M2_USQADD || op == M2_SQABS || op == M2_SQNEG
	var dOnly bool = op == M2_ABS || op == M2_NEG || op == M2_CMGT0 || op == M2_CMEQ0 ||
			op == M2_CMLT0 || op == M2_CMGE0 || op == M2_CMLE0
	var narrow bool = op == M2_SQXTN || op == M2_UQXTN || op == M2_SQXTUN
	if scalar {
		if anySize || (dOnly && size == 3) || (narrow && size <= 2) { return op, size, true }
		return 0, 0, false
	}
	if anySize || dOnly { return op, size, size < 3 || q }
	var maxSize int = -1
	if op == M2_REV16 || op == M2_CNT { maxSize = 0 }
	if op == M2_REV32 { maxSize = 1 }
	if op == M2_REV64 || op == M2_CLS || op == M2_CLZ || op == M2_SADDLP || op == M2_UADDLP ||
			op == M2_SADALP || op == M2_UADALP || op == M2_XTN || narrow || op == M2_SHLL {
		maxSize = 2
	}
	return op, size, size <= maxSize
}

// m2Word packs a two-register miscellaneous instruction onto base.
func m2Word(base uint32, uop int, size int, rd int, rn int) uint32 {
	return base | (cast(uint32, uop >> 5) << 29) | (cast(uint32, size) << 22) |
			(cast(uint32, uop & 0x1F) << 12) | (cast(uint32, rn) << 5) | cast(uint32, rd)
}

// TwoRegMisc emits the vector form of an M2_* operation at element size size on a
// 128-bit (q) or 64-bit vector (for the narrowing operations and SHLL, q selects the
// "2" form).
func TwoRegMisc(a @asm.Assembler, op int, q bool, size int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	uop, field, ok := m2Field(op, size, q, false)
	if !ok {
		a.SetError("simd two-register misc: no such operation for this arrangement")
		return
	}
	var inst uint32 = m2Word(0x0E200800, uop, field, rd, rn)
	if q { inst = inst | 0x40000000 }
	isa.Emit32(a, inst)
}

// TwoRegMiscScalar emits the scalar form of an M2_* operation at element size size.
func TwoRegMiscScalar(a @asm.Assembler, op int, size int, rd int, rn int) {
	if !isa.RegsOk(a, rd, rn, 0, 0) { return }
	uop, field, ok := m2Field(op, size, false, true)
	if !ok {
		a.SetError("simd two-register misc: no such scalar operation for this size")
		return
	}
	isa.Emit32(a, m2Word(0x5E200800, uop, field, rd, rn))
}
