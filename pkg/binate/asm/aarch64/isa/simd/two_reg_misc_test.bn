package "pkg/binate/asm/aarch64/isa/simd"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The integer two-register miscellaneous encoders' own checks: NOT / RBIT sharing an
// opcode, the per-operation element sizes of the vector and scalar forms, and register
// range (the text assembler's golden tables cover every encoding).

func TestTwoRegMiscChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TwoRegMisc(a, M2_NOT, true, 0, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E20581F) { return fail("not v31.16b, v0.16b") }
	a = newAsm()
	TwoRegMisc(a, M2_RBIT, true, 0, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6E60581F) { return fail("rbit v31.16b, v0.16b") }
	a = newAsm()
	TwoRegMisc(a, M2_NEG, true, 3, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EE0B81F) { return fail("neg v31.2d, v0.2d") }
	a = newAsm()
	TwoRegMisc(a, M2_SHLL, true, 2, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x6EA1381F) { return fail("shll2 v31.2d, v0.4s, #32") }
	a = newAsm()
	TwoRegMisc(a, M2_UADALP, false, 2, 0, 31)
	if !clean(a, 1) || !wordIs(a, 0, 0x2EA06BE0) { return fail("uadalp v0.1d, v31.2s") }
	var badVec [8]int = [8]int{M2_NEG, M2_RBIT, M2_REV16, M2_REV32, M2_CLS, M2_XTN, M2_SADDLP, M2_CNT}
	var badSize [8]int = [8]int{3, 1, 1, 2, 3, 3, 3, 1}
	var badQ [8]bool = [8]bool{false, true, true, true, true, true, true, true}
	for i := 0; i < 8; i++ {
		a = newAsm()
		TwoRegMisc(a, badVec[i], badQ[i], badSize[i], 0, 1)
		if !rejected(a) { return fail("an operation at a size it does not have") }
	}
	var bad1D [4]int = [4]int{M2_ABS, M2_SQABS, M2_CMEQ0, M2_USQADD}
	for i := 0; i < 4; i++ {
		a = newAsm()
		TwoRegMisc(a, bad1D[i], false, 3, 0, 1)
		if !rejected(a) { return fail("an operation on 1d") }
	}
	a = newAsm()
	TwoRegMisc(a, M2_NOT, false, 1, 0, 1)
	if !rejected(a) { return fail("not of H elements (the size field is NOT's, not the element's)") }
	a = newAsm()
	TwoRegMisc(a, M2_REV64, true, 3, 0, 1)
	if !rejected(a) { return fail("rev64 of 2d") }
	var badOps [4]int = [4]int{0x10, 0x2C, -1, 0x40}
	for i := 0; i < 4; i++ {
		a = newAsm()
		TwoRegMisc(a, badOps[i], true, 0, 0, 1)
		if !rejected(a) { return fail("an operation value that is not one") }
	}
	a = newAsm()
	TwoRegMisc(a, M2_ABS, true, 0, 0, 32)
	if !rejected(a) { return fail("Vn register 32") }
	return ""
}

func TestTwoRegMiscScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	TwoRegMiscScalar(a, M2_SQABS, 0, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x5E20781F) { return fail("sqabs b31, b0") }
	a = newAsm()
	TwoRegMiscScalar(a, M2_CMLE0, 3, 31, 0)
	if !clean(a, 1) || !wordIs(a, 0, 0x7EE0981F) { return fail("cmle d31, d0, #0") }
	var bad [8]int = [8]int{M2_ABS, M2_CMEQ0, M2_SQXTN, M2_NOT, M2_CLZ, M2_SHLL, M2_XTN, M2_RBIT}
	var badSize [8]int = [8]int{2, 1, 3, 0, 2, 0, 0, 0}
	for i := 0; i < 8; i++ {
		a = newAsm()
		TwoRegMiscScalar(a, bad[i], badSize[i], 0, 1)
		if !rejected(a) { return fail("a scalar operation at a size it does not have") }
	}
	a = newAsm()
	TwoRegMiscScalar(a, M2_SQNEG, 0, -1, 1)
	if !rejected(a) { return fail("Bd register -1") }
	return ""
}
