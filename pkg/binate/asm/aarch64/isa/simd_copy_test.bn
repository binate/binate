package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The SIMD copy encoders' own checks: the element-size and lane-index limits, the
// reserved 1D arrangement, SMOV's size / width rule, and register range (the text
// assembler's golden tables cover the encodings).  (lsdpRejected / lsdpClean /
// lsdpWordIs are in ldst_test.bn.)

func TestSimdDupChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdDupElement(a, true, 2, 0, 1, 3)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E1C0420) { return fail("dup v0.4s, v1.s[3]") }
	a = newAsm()
	SimdDupElement(a, true, 2, 0, 1, 4)
	if !lsdpRejected(a) { return fail("dup from lane s[4]") }
	a = newAsm()
	SimdDupElement(a, false, 3, 0, 1, 0)
	if !lsdpRejected(a) { return fail("dup v0.1d, v1.d[0]") }
	a = newAsm()
	SimdDupElement(a, true, 4, 0, 1, 0)
	if !lsdpRejected(a) { return fail("dup of element size 4") }
	a = newAsm()
	SimdDupScalar(a, 0, 5, 6, 15)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x5E1F04C5) { return fail("dup b5, v6.b[15]") }
	a = newAsm()
	SimdDupScalar(a, 1, 0, 1, -1)
	if !lsdpRejected(a) { return fail("dup from lane h[-1]") }
	a = newAsm()
	SimdDupGeneral(a, true, 3, 3, 4)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E080C83) { return fail("dup v3.2d, x4") }
	a = newAsm()
	SimdDupGeneral(a, false, 3, 3, 4)
	if !lsdpRejected(a) { return fail("dup v3.1d, x4") }
	a = newAsm()
	SimdDupGeneral(a, false, 0, 32, 4)
	if !lsdpRejected(a) { return fail("dup to register 32") }
	return ""
}

func TestSimdInsChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdInsGeneral(a, 3, 7, 1, 8)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E181D07) { return fail("ins v7.d[1], x8") }
	a = newAsm()
	SimdInsGeneral(a, 3, 7, 2, 8)
	if !lsdpRejected(a) { return fail("ins to lane d[2]") }
	a = newAsm()
	SimdInsElement(a, 0, 9, 0, 10, 15)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x6E017D49) { return fail("ins v9.b[0], v10.b[15]") }
	a = newAsm()
	SimdInsElement(a, 1, 9, 0, 10, 8)
	if !lsdpRejected(a) { return fail("ins from lane h[8]") }
	a = newAsm()
	SimdInsElement(a, 1, 9, 8, 10, 0)
	if !lsdpRejected(a) { return fail("ins to lane h[8]") }
	a = newAsm()
	SimdInsElement(a, 2, 9, 0, 32, 0)
	if !lsdpRejected(a) { return fail("ins from register 32") }
	return ""
}

func TestSimdUmovSmovChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdUmov(a, 3, 11, 12, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E183D8B) { return fail("umov x11, v12.d[1]") }
	a = newAsm()
	SimdUmov(a, 0, 11, 12, 16)
	if !lsdpRejected(a) { return fail("umov from lane b[16]") }
	a = newAsm()
	SimdSmov(a, true, 2, 13, 14, 3)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E1C2DCD) { return fail("smov x13, v14.s[3]") }
	a = newAsm()
	SimdSmov(a, false, 1, 13, 14, 0)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x0E022DCD) { return fail("smov w13, v14.h[0]") }
	a = newAsm()
	SimdSmov(a, false, 2, 13, 14, 0)
	if !lsdpRejected(a) { return fail("smov w13, v14.s[0]") }
	a = newAsm()
	SimdSmov(a, true, 3, 13, 14, 0)
	if !lsdpRejected(a) { return fail("smov x13, v14.d[0]") }
	return ""
}
