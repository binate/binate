package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The FP8 encoders' own checks: one word per encoder form at the register extremes, the
// FMLALL selector range, and register range (the text assembler's golden tables cover
// every encoding).  (lsdpRejected / lsdpClean / lsdpWordIs are in ldst_test.bn.)

func TestSimdFP8Checks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdFP8Dot(a, false, true, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E5FFC1F) {
		return fail("fdot v31.8h, v0.16b, v31.16b")
	}
	a = newAsm()
	SimdFP8Dot(a, true, false, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x0E02FC20) { return fail("fdot v0.2s, v1.8b, v2.8b") }
	a = newAsm()
	SimdFP8Mlal(a, true, 31, 31, 0)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4EC0FFFF) {
		return fail("fmlalt v31.8h, v31.16b, v0.16b")
	}
	a = newAsm()
	SimdFP8Mlall(a, FP8_MLALLTT, 0, 31, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E5FC7E0) {
		return fail("fmlalltt v0.4s, v31.16b, v31.16b")
	}
	a = newAsm()
	SimdFP8Cvtn(a, true, true, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E1FF41F) {
		return fail("fcvtn2 v31.16b, v0.4s, v31.4s")
	}
	a = newAsm()
	SimdFP8Cvtn(a, false, true, 0, 31, 0)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E40F7E0) { return fail("fcvtn v0.16b, v31.8h, v0.8h") }
	a = newAsm()
	SimdFP8MatMul(a, true, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x6E9FEC1F) {
		return fail("fmmla v31.4s, v0.16b, v31.16b")
	}
	a = newAsm()
	SimdFP8Mlall(a, 4, 0, 1, 2)
	if !lsdpRejected(a) { return fail("fmlall selector 4") }
	a = newAsm()
	SimdFP8Mlall(a, -1, 0, 1, 2)
	if !lsdpRejected(a) { return fail("fmlall selector -1") }
	a = newAsm()
	SimdFP8Dot(a, false, true, 32, 1, 2)
	if !lsdpRejected(a) { return fail("Vd register 32") }
	a = newAsm()
	SimdFP8Mlal(a, false, 0, -1, 2)
	if !lsdpRejected(a) { return fail("Vn register -1") }
	a = newAsm()
	SimdFP8Cvtn(a, false, false, 0, 1, 32)
	if !lsdpRejected(a) { return fail("Vm register 32") }
	a = newAsm()
	SimdFP8MatMul(a, false, 0, 32, 2)
	if !lsdpRejected(a) { return fail("Vn register 32") }
	return ""
}
