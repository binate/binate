package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the Advanced SIMD integer three-same class — the vector form
// `Vd.<T>, Vn.<T>, Vm.<T>` and the scalar form `<V>d, <V>n, <V>m` — and for the bitwise
// operations (AND / BIC / ORR / ORN / EOR / BSL / BIT / BIF), which exist only on 8B /
// 16B.  Every operation is checked against the element sizes the architecture defines
// for it; the rest of the size space is reserved or belongs to other instructions.

// s3OpOk reports whether op is an S3_* operation (the logical opcode 00011 and U=1
// opcode 10111 are not).
func s3OpOk(op int) bool {
	if op < 0 || op > 0x3F || op == 0x37 { return false }
	var opc int = op & 0x1F
	return opc != 0x03 && opc <= 0x17
}

// s3VecSizeOk reports whether op exists in the vector form for element size size (0..3)
// in a 128-bit (q) or 64-bit vector: sizes B / H / S for all but SQDMULH / SQRDMULH (H /
// S) and PMUL (B); the 2D arrangement only for the saturating add / subtract, compare,
// shift, ADD / SUB, CMTST / CMEQ and ADDP operations; never 1D.
func s3VecSizeOk(op int, size int, q bool) bool {
	if op == S3_SQDMULH || op == S3_SQRDMULH { return size == 1 || size == 2 }
	if op == S3_PMUL { return size == 0 }
	if size < 3 { return true }
	if !q { return false }
	var opc int = op & 0x1F
	return opc == 0x01 || opc == 0x05 || (opc >= 0x06 && opc <= 0x0B) || opc == 0x10 || opc == 0x11 ||
			op == S3_ADDP
}

// s3ScalarSizeOk reports whether op exists in the scalar form for element size size:
// every size for the saturating add / subtract / shift operations, H / S for SQDMULH /
// SQRDMULH, D only for the compares, SSHL / USHL, SRSHL / URSHL, ADD / SUB and CMTST /
// CMEQ.
func s3ScalarSizeOk(op int, size int) bool {
	var opc int = op & 0x1F
	if opc == 0x01 || opc == 0x05 || opc == 0x09 || opc == 0x0B { return true }
	if opc == 0x16 { return size == 1 || size == 2 }
	if opc == 0x06 || opc == 0x07 || opc == 0x08 || opc == 0x0A || opc == 0x10 || opc == 0x11 {
		return size == 3
	}
	return false
}

// s3Word packs a three-same instruction: base, U (op bit 5), size, Rm, the opcode (op
// bits 4:0), Rn and Rd.
func s3Word(base uint32, op int, size int, rd int, rn int, rm int) uint32 {
	return base | (cast(uint32, op >> 5) << 29) | (cast(uint32, size) << 22) |
			(cast(uint32, rm) << 16) | (cast(uint32, op & 0x1F) << 11) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
}

// SimdIntThreeSame emits the vector form of an S3_* operation on a 128-bit (q) or
// 64-bit vector of size-byte elements (size 0..3: B, H, S, D).
func SimdIntThreeSame(a @asm.Assembler, op int, q bool, size int, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if !s3OpOk(op) || size < 0 || size > 3 || !s3VecSizeOk(op, size, q) {
		a.SetError("simd three-same: no such operation for this arrangement")
		return
	}
	var inst uint32 = s3Word(0x0E200400, op, size, rd, rn, rm)
	if q { inst = inst | 0x40000000 }
	emit32(a, inst)
}

// SimdIntThreeSameScalar emits the scalar form of an S3_* operation on size-byte
// registers (size 0..3: B, H, S, D).
func SimdIntThreeSameScalar(a @asm.Assembler, op int, size int, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if !s3OpOk(op) || size < 0 || size > 3 || !s3ScalarSizeOk(op, size) {
		a.SetError("simd three-same: no such scalar operation for this size")
		return
	}
	emit32(a, s3Word(0x5E200400, op, size, rd, rn, rm))
}

// SimdLogical emits an SL_* bitwise operation on a 128-bit (q, 16B) or 64-bit (8B)
// vector.
func SimdLogical(a @asm.Assembler, op int, q bool, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if op < 0 || op > 7 {
		a.SetError("simd: no such bitwise operation")
		return
	}
	var inst uint32 = s3Word(0x0E200400, ((op >> 2) << 5) | 0x03, op & 3, rd, rn, rm)
	if q { inst = inst | 0x40000000 }
	emit32(a, inst)
}
