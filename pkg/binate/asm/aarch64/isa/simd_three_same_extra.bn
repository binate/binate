package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// Exact encoders for the integer instructions of the Advanced SIMD three-same-extra
// class: SQRDMLAH / SQRDMLSH (FEAT_RDM; vector and scalar, H and S elements), the dot
// products SDOT / UDOT (FEAT_DotProd) and USDOT (FEAT_I8MM), and the matrix multiplies
// SMMLA / UMMLA / USMMLA (FEAT_I8MM).

// rdmlahWord packs SQRDMLAH (or SQRDMLSH, sub) onto base, for element size size.
func rdmlahWord(base uint32, sub bool, size int, rd int, rn int, rm int) uint32 {
	var inst uint32 = base | (cast(uint32, size) << 22) | (cast(uint32, rm) << 16) |
			(cast(uint32, rn) << 5) | cast(uint32, rd)
	if sub { inst = inst | 0x800 }
	return inst
}

// SimdRdmlah emits SQRDMLAH (or SQRDMLSH, sub) `Vd.<T>, Vn.<T>, Vm.<T>` on a 128-bit (q)
// or 64-bit vector of H (size 1) or S (size 2) elements.
func SimdRdmlah(a @asm.Assembler, sub bool, q bool, size int, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if size != 1 && size != 2 {
		a.SetError("sqrdmlah / sqrdmlsh: H or S elements only")
		return
	}
	var inst uint32 = rdmlahWord(0x2E008400, sub, size, rd, rn, rm)
	if q { inst = inst | 0x40000000 }
	emit32(a, inst)
}

// SimdRdmlahScalar emits SQRDMLAH (or SQRDMLSH, sub) `<V>d, <V>n, <V>m` on H (size 1) or S
// (size 2) registers.
func SimdRdmlahScalar(a @asm.Assembler, sub bool, size int, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	if size != 1 && size != 2 {
		a.SetError("sqrdmlah / sqrdmlsh: H or S registers only")
		return
	}
	emit32(a, rdmlahWord(0x7E008400, sub, size, rd, rn, rm))
}

// SimdDotProduct emits a DOT_* dot product `Vd.2S|4S, Vn.8B|16B, Vm.8B|16B` (by q): each S
// element of Vd accumulates the products of four byte pairs of Vn and Vm.
func SimdDotProduct(a @asm.Assembler, op int, q bool, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	var inst uint32 = 0x0E809400 | (cast(uint32, rm) << 16) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	if op == DOT_UDOT {
		inst = inst | 0x20000000
	} else if op == DOT_USDOT {
		inst = inst | 0x800
	} else if op != DOT_SDOT {
		a.SetError("simd: no such dot product")
		return
	}
	if q { inst = inst | 0x40000000 }
	emit32(a, inst)
}

// SimdIntMatMul emits an MM_* 8-bit integer matrix multiply-accumulate `Vd.4S, Vn.16B,
// Vm.16B`: the 2x8 by 8x2 product of Vn and Vm added to the 2x2 matrix in Vd.
func SimdIntMatMul(a @asm.Assembler, op int, rd int, rn int, rm int) {
	if !regsOk(a, rd, rn, rm, 0) { return }
	var inst uint32 = 0x4E80A400 | (cast(uint32, rm) << 16) | (cast(uint32, rn) << 5) |
			cast(uint32, rd)
	if op == MM_UMMLA {
		inst = inst | 0x20000000
	} else if op == MM_USMMLA {
		inst = inst | 0x800
	} else if op != MM_SMMLA {
		a.SetError("simd: no such integer matrix multiply")
		return
	}
	emit32(a, inst)
}
