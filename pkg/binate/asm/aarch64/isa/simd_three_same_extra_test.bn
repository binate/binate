package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The three-same-extra integer encoders' own checks: SQRDMLAH / SQRDMLSH element sizes,
// the dot-product and matrix-multiply operation sets, and register range (the text
// assembler's golden tables cover every encoding).  (lsdpRejected / lsdpClean /
// lsdpWordIs are in ldst_test.bn.)

func TestSimdRdmlahChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdRdmlah(a, false, true, 1, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x6E5F841F) {
		return fail("sqrdmlah v31.8h, v0.8h, v31.8h")
	}
	a = newAsm()
	SimdRdmlahScalar(a, true, 2, 0, 31, 1)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x7E818FE0) { return fail("sqrdmlsh s0, s31, s1") }
	var bad [3]int = [3]int{0, 3, -1}
	for i := 0; i < 3; i++ {
		a = newAsm()
		SimdRdmlah(a, false, true, bad[i], 0, 1, 2)
		if !lsdpRejected(a) { return fail("a vector size other than H / S") }
		a = newAsm()
		SimdRdmlahScalar(a, false, bad[i], 0, 1, 2)
		if !lsdpRejected(a) { return fail("a scalar size other than H / S") }
	}
	a = newAsm()
	SimdRdmlah(a, false, true, 1, 0, 32, 2)
	if !lsdpRejected(a) { return fail("Vn register 32") }
	a = newAsm()
	SimdRdmlahScalar(a, false, 1, -1, 1, 2)
	if !lsdpRejected(a) { return fail("Hd register -1") }
	return ""
}

func TestSimdDotAndMatMulChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdDotProduct(a, DOT_SDOT, true, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E9F941F) {
		return fail("sdot v31.4s, v0.16b, v31.16b")
	}
	a = newAsm()
	SimdDotProduct(a, DOT_UDOT, false, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x2E829420) { return fail("udot v0.2s, v1.8b, v2.8b") }
	a = newAsm()
	SimdDotProduct(a, 3, true, 0, 1, 2)
	if !lsdpRejected(a) { return fail("dot product 3") }
	a = newAsm()
	SimdDotProduct(a, DOT_SDOT, true, 32, 1, 2)
	if !lsdpRejected(a) { return fail("Vd register 32") }
	a = newAsm()
	SimdIntMatMul(a, MM_USMMLA, 31, 31, 0)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4E80AFFF) {
		return fail("usmmla v31.4s, v31.16b, v0.16b")
	}
	a = newAsm()
	SimdIntMatMul(a, -1, 0, 1, 2)
	if !lsdpRejected(a) { return fail("matrix multiply -1") }
	a = newAsm()
	SimdIntMatMul(a, MM_SMMLA, 0, 1, 32)
	if !lsdpRejected(a) { return fail("Vm register 32") }
	return ""
}
