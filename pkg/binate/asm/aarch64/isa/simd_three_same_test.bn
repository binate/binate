package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The integer three-same and bitwise encoders' own checks: the operation range, the
// per-operation element sizes of the vector and scalar forms, and register range (the
// text assembler's golden tables cover every encoding).  (lsdpRejected / lsdpClean /
// lsdpWordIs are in ldst_test.bn.)

func TestSimdIntThreeSameChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdIntThreeSame(a, S3_ADD, true, 3, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x4EFF841F) { return fail("add v31.2d, v0.2d, v31.2d") }
	a = newAsm()
	SimdIntThreeSame(a, S3_ADD, false, 3, 0, 1, 2)
	if !lsdpRejected(a) { return fail("add of 1d") }
	a = newAsm()
	SimdIntThreeSame(a, S3_MLA, true, 3, 0, 1, 2)
	if !lsdpRejected(a) { return fail("mla of 2d") }
	a = newAsm()
	SimdIntThreeSame(a, S3_SQDMULH, true, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("sqdmulh of 16b") }
	a = newAsm()
	SimdIntThreeSame(a, S3_PMUL, true, 1, 0, 1, 2)
	if !lsdpRejected(a) { return fail("pmul of 8h") }
	a = newAsm()
	SimdIntThreeSame(a, 0x03, true, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("the logical opcode through SimdIntThreeSame") }
	a = newAsm()
	SimdIntThreeSame(a, 0x37, true, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("U=1 opcode 10111") }
	a = newAsm()
	SimdIntThreeSame(a, 0x18, true, 2, 0, 1, 2)
	if !lsdpRejected(a) { return fail("an FP opcode") }
	a = newAsm()
	SimdIntThreeSame(a, S3_ADD, true, 4, 0, 1, 2)
	if !lsdpRejected(a) { return fail("size 4") }
	a = newAsm()
	SimdIntThreeSame(a, S3_ADD, true, 2, 0, 1, 32)
	if !lsdpRejected(a) { return fail("Vm register 32") }
	a = newAsm()
	SimdIntThreeSame(a, -1, true, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("op -1") }
	a = newAsm()
	SimdIntThreeSame(a, 0x40, true, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("op 0x40") }
	a = newAsm()
	SimdIntThreeSame(a, 0x23, true, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("the U=1 logical opcode through SimdIntThreeSame") }
	return ""
}

func TestSimdIntThreeSameScalarChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdIntThreeSameScalar(a, S3_SQADD, 0, 31, 0, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x5E3F0C1F) { return fail("sqadd b31, b0, b31") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_SUB, 3, 31, 30, 29)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x7EFD87DF) { return fail("sub d31, d30, d29") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_ADD, 2, 0, 1, 2)
	if !lsdpRejected(a) { return fail("add s0, s1, s2") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_SQRDMULH, 3, 0, 1, 2)
	if !lsdpRejected(a) { return fail("sqrdmulh d0, d1, d2") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_SHADD, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("shadd b0, b1, b2") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_ADDP, 3, 0, 1, 2)
	if !lsdpRejected(a) { return fail("addp d0, d1, d2") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_SQADD, -1, 0, 1, 2)
	if !lsdpRejected(a) { return fail("size -1") }
	a = newAsm()
	SimdIntThreeSameScalar(a, 0x03, 0, 0, 1, 2)
	if !lsdpRejected(a) { return fail("the logical opcode through the scalar form") }
	a = newAsm()
	SimdIntThreeSameScalar(a, S3_SQADD, 0, 0, 32, 2)
	if !lsdpRejected(a) { return fail("Vn register 32") }
	return ""
}

func TestSimdLogicalChecks() testing.TestResult {
	var a @asm.Assembler = newAsm()
	SimdLogical(a, SL_EOR, true, 31, 31, 31)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x6E3F1FFF) { return fail("eor v31.16b ×3") }
	a = newAsm()
	SimdLogical(a, SL_BIF, false, 0, 1, 2)
	if !lsdpClean(a, 1) || !lsdpWordIs(a, 0, 0x2EE21C20) { return fail("bif v0.8b, v1.8b, v2.8b") }
	a = newAsm()
	SimdLogical(a, 8, true, 0, 1, 2)
	if !lsdpRejected(a) { return fail("operation 8") }
	a = newAsm()
	SimdLogical(a, SL_AND, true, -1, 1, 2)
	if !lsdpRejected(a) { return fail("Vd register -1") }
	return ""
}
