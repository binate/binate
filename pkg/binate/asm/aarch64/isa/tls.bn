package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"

// The thread-local operators' encoders: a MOVW chunk's shift and checking (MovwFixShift,
// MoveWideReloc), an ADD's page offset (AddTlsLo12) and a load / store's (LdStTlsLo12).

// tlsMovwShift returns the shift (0, 16 or 32) of the chunk a thread-local MOVW kind fills,
// or -1 for any other kind.
func tlsMovwShift(kind int) int {
	if kind == FIX_TLSLE_MOVW_TPREL_G2 || kind == FIX_TLSLD_MOVW_DTPREL_G2 { return 32 }
	if kind == FIX_TLSLE_MOVW_TPREL_G1 || kind == FIX_TLSLE_MOVW_TPREL_G1_NC ||
			kind == FIX_TLSLD_MOVW_DTPREL_G1 || kind == FIX_TLSLD_MOVW_DTPREL_G1_NC {
		return 16
	}
	if kind == FIX_TLSLE_MOVW_TPREL_G0 || kind == FIX_TLSLE_MOVW_TPREL_G0_NC ||
			kind == FIX_TLSLD_MOVW_DTPREL_G0 || kind == FIX_TLSLD_MOVW_DTPREL_G0_NC {
		return 0
	}
	return -1
}

// tlsMovwChecked reports whether kind is a checked (not _NC) thread-local MOVW kind, whose
// MOVZ clang writes as a MOVN: the linker sets the opcode by the sign of the offset.
func tlsMovwChecked(kind int) bool {
	return kind == FIX_TLSLE_MOVW_TPREL_G2 || kind == FIX_TLSLE_MOVW_TPREL_G1 ||
			kind == FIX_TLSLE_MOVW_TPREL_G0 || kind == FIX_TLSLD_MOVW_DTPREL_G2 ||
			kind == FIX_TLSLD_MOVW_DTPREL_G1 || kind == FIX_TLSLD_MOVW_DTPREL_G0
}

// AddTlsLo12 emits ADD (immediate) with a thread-local page-offset fixup; see isa.bni.
func AddTlsLo12(a @asm.Assembler, sf bool, rd int, rn int, label *[]readonly char, addend int64,
		kind int, shift12 bool) {
	var hi bool = kind == FIX_TLSLE_ADD_TPREL_HI12 || kind == FIX_TLSLD_ADD_DTPREL_HI12
	var lo bool = kind == FIX_TLSLE_ADD_TPREL_LO12 || kind == FIX_TLSLE_ADD_TPREL_LO12_NC ||
			kind == FIX_TLSLD_ADD_DTPREL_LO12 || kind == FIX_TLSLD_ADD_DTPREL_LO12_NC
	if !hi && !lo {
		a.SetError("add: not a thread-local page-offset relocation")
		return
	}
	if !RegsOk(a, rd, rn, 0, 0) { return }
	var base uint32 = 0x11000000
	if hi || shift12 { base = 0x11400000 }
	a.AddFixup(label, kind, addend, 4)
	Emit32(a, dpRegs(base, sf, rn, rd))
}

// LdStTlsLo12 emits a load / store with a thread-local page-offset fixup; see isa.bni.
func LdStTlsLo12(a @asm.Assembler, spec uint32, rt int, rn int, label *[]readonly char,
		addend int64, family int) {
	var wide int = -1 // the family's 16-byte member
	if family == FIX_TLSLE_LDST8_TPREL_LO12 { wide = FIX_TLSLE_LDST128_TPREL_LO12 }
	if family == FIX_TLSLE_LDST8_TPREL_LO12_NC { wide = FIX_TLSLE_LDST128_TPREL_LO12_NC }
	if family == FIX_TLSLD_LDST8_DTPREL_LO12 { wide = FIX_TLSLD_LDST128_DTPREL_LO12 }
	if family == FIX_TLSLD_LDST8_DTPREL_LO12_NC { wide = FIX_TLSLD_LDST128_DTPREL_LO12_NC }
	if wide < 0 {
		a.SetError("load/store: not a thread-local page-offset relocation")
		return
	}
	if !RegsOk(a, rt, rn, 0, 0) { return }
	if !ldstSpecValid(spec) {
		a.SetError("load/store: unallocated transfer spec")
		return
	}
	// The 1-, 2-, 4- and 8-byte members follow the family's 8-bit one two apart (each
	// checked, then _NC), as their ELF relocation types do.
	var bytes int = LdStAccessBytes(spec)
	var kind int = wide
	if bytes == 1 { kind = family }
	if bytes == 2 { kind = family + 2 }
	if bytes == 4 { kind = family + 4 }
	if bytes == 8 { kind = family + 6 }
	a.AddFixup(label, kind, addend, 4)
	Emit32(a, ldstRegs(0x39000000 | spec, rn, rt))
}
