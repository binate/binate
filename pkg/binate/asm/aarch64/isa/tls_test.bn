package "pkg/binate/asm/aarch64/isa"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The thread-local encoders (tls.bn) against clang's words: a MOVZ with a checked MOVW kind
// is written MOVN (`movz x0, #:tprel_g1:v` 92A00000), an _NC or a MOVK keeps its opcode
// (`movz x0, #:tprel_g1_nc:v` D2A00000, `movk x0, #:dtprel_g0:v` F2800000); AddTlsLo12's HI12
// is the `lsl #12` form (`add x0, x0, #:tprel_hi12:v` 91400000, `add w0, w1, #:dtprel_lo12:v`
// 11000020); and LdStTlsLo12 takes the family member of the access size.
func TestTlsEncoders() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MoveWideReloc(a, MW_MOVZ, true, X0, 16, "v", 0, FIX_TLSLE_MOVW_TPREL_G1)
	MoveWideReloc(a, MW_MOVZ, true, X0, 16, "v", 0, FIX_TLSLE_MOVW_TPREL_G1_NC)
	MoveWideReloc(a, MW_MOVK, true, X0, 0, "v", 0, FIX_TLSLD_MOVW_DTPREL_G0)
	AddTlsLo12(a, true, X0, X0, "v", 0, FIX_TLSLE_ADD_TPREL_HI12, false)
	AddTlsLo12(a, false, X0, X1, "v", 0, FIX_TLSLD_ADD_DTPREL_LO12, false)
	LdStTlsLo12(a, LS_LDRH, X0, X0, "v", 0, FIX_TLSLE_LDST8_TPREL_LO12_NC)
	LdStTlsLo12(a, LS_LDR_Q, X0, X0, "v", 4, FIX_TLSLD_LDST8_DTPREL_LO12)
	if a.HasError { return fail(a.ErrorMsg) }
	var s @asm.Section = a.Sections[0]
	var want @[]uint32 = @[]uint32{0x92A00000, 0xD2A00000, 0xF2800000, 0x91400000, 0x11000020,
			0x79400000, 0x3DC00000}
	var kinds @[]int = @[]int{FIX_TLSLE_MOVW_TPREL_G1, FIX_TLSLE_MOVW_TPREL_G1_NC,
			FIX_TLSLD_MOVW_DTPREL_G0, FIX_TLSLE_ADD_TPREL_HI12, FIX_TLSLD_ADD_DTPREL_LO12,
			FIX_TLSLE_LDST16_TPREL_LO12_NC, FIX_TLSLD_LDST128_DTPREL_LO12}
	for i := 0; i < len(want); i++ {
		if readInst(s, 4 * i) != want[i] { return fail("a thread-local instruction encoded wrongly") }
		if s.Fixups[i].Kind != kinds[i] { return fail("a thread-local fixup has the wrong kind") }
	}
	if s.Fixups[6].Addend != 4 || MovwFixShift(FIX_TLSLD_MOVW_DTPREL_G2) != 32 {
		return fail("an addend or a G2 shift is wrong")
	}
	return ""
}

// A kind outside its encoder's thread-local set is an error that emits nothing: an absolute
// page offset to AddTlsLo12, a HI12 or 16-bit member to LdStTlsLo12.
func TestTlsEncoderRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AddTlsLo12(a, true, X0, X0, "v", 0, FIX_ADD_LO12, false)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("AddTlsLo12 took FIX_ADD_LO12") }
	var b @asm.Assembler = newAsm()
	LdStTlsLo12(b, LS_LDR_X, X0, X0, "v", 0, FIX_TLSLE_ADD_TPREL_HI12)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("LdStTlsLo12 took a HI12 kind") }
	var c @asm.Assembler = newAsm()
	LdStTlsLo12(c, LS_LDR_X, X0, X0, "v", 0, FIX_TLSLE_LDST16_TPREL_LO12)
	if !c.HasError || c.Sections[0].Len != 0 { return fail("LdStTlsLo12 took a 16-bit member") }
	return ""
}
