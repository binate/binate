// Package arm32 provides ARM (ARMv7-A) instruction encoding for the
// assembler. Instructions use the ARM UAL (Unified Assembly Language)
// syntax. Most instructions accept an optional condition code; the
// default is COND_AL (always execute).
//
// Every encoder is exact: a condition outside COND_EQ..COND_AL, a register outside R0..R15, or a
// value with no encoding in its field sets the assembler error and emits nothing — no field is
// masked into another's bits.  The VFP encoders are the sub-package pkg/binate/asm/arm32/vfp.
package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// General-purpose registers (R0-R15)
const (
	R0 int = iota
	R1
	R2
	R3
	R4
	R5
	R6
	R7
	R8
	R9
	R10
	R11
	R12
	R13
	R14
	R15
)

// Named register aliases
const SP int = 13 // stack pointer

const LR int = 14 // link register

const PC int = 15 // program counter

const FP int = 11 // frame pointer (APCS convention)

const IP int = 12 // intra-procedure-call scratch register

// Operand kinds
const (
	OP_REG int = iota // register
	OP_IMM            // immediate value
	OP_REG_SHIFT      // shifted register (Rm, shift #amt)
	OP_REG_SREG       // register-shifted register (Rm, shift Rs)
	OP_MEM_IMM        // [Rn, #imm]
	OP_MEM_REG        // [Rn, Rm]
	OP_MEM_SREG       // [Rn, Rm, shift #amt]
	OP_MEM_PRE        // [Rn, #imm]!
	OP_MEM_POST       // [Rn], #imm
	OP_MEM_PRE_REG    // [Rn, Rm]!
	OP_MEM_POST_REG   // [Rn], Rm
	OP_LABEL          // label reference
	OP_MEM_PRE_SREG   // [Rn, Rm, shift #amt]!
	OP_MEM_POST_SREG  // [Rn], Rm, shift #amt
	OP_IMM_ROT        // #imm8, #rot: an immediate with its rotation written out
)

// Shift types (used in flexible second operand)
const (
	LSL int = iota // logical shift left
	LSR            // logical shift right
	ASR            // arithmetic shift right
	ROR            // rotate right
)

// Special shift: rotate right with extend (RRX) — rotate right by 1
// through carry. Encoded as ROR with an amount field of 0 (the assembly
// `ror #0` is the plain register, not RRX); used as RegShift(r, RRX, 0).
const RRX int = 4

// Condition codes (bits [31:28] of every ARM instruction)
const (
	COND_EQ int = iota // equal (Z=1)
	COND_NE            // not equal (Z=0)
	COND_CS            // carry set / unsigned >= (C=1)
	COND_CC            // carry clear / unsigned < (C=0)
	COND_MI            // minus / negative (N=1)
	COND_PL            // plus / positive or zero (N=0)
	COND_VS            // overflow (V=1)
	COND_VC            // no overflow (V=0)
	COND_HI            // unsigned > (C=1 && Z=0)
	COND_LS            // unsigned <= (C=0 || Z=1)
	COND_GE            // signed >= (N=V)
	COND_LT            // signed < (N!=V)
	COND_GT            // signed > (Z=0 && N=V)
	COND_LE            // signed <= (Z=1 || N!=V)
	COND_AL            // always (default)
)

// Condition code aliases
const COND_HS int = 2 // same as CS (unsigned >=)

const COND_LO int = 3 // same as CC (unsigned <)

// InvertCond returns the condition that holds exactly when cond does not:
// cond ^ 1, pairing EQ/NE, CS/CC, MI/PL, VS/VC, HI/LS, GE/LT and GT/LE.  So a
// B on InvertCond(cond) to one target is the B on cond to the other, with
// the fall-through swapped.  COND_AL has no inverse, and a cond outside
// COND_EQ..COND_AL is no condition: either sets an assembler error and
// returns -1, which the branch encoders (B, Bl, BAddend, BOffset) also
// reject.
func InvertCond(a @asm.Assembler, cond int) int

// Fixup kinds for ARM32
const (
	FIX_BRANCH24 int = 200 // 24-bit PC-relative branch (B, BL)
	FIX_ABS32 int = 201    // 32-bit absolute address
	// FIX_MOVW_ABS_NC patches the imm4:imm12 of a MOVW with the LOW 16
	// bits of a symbol's absolute address (R_ARM_MOVW_ABS_NC). "_NC" =
	// no overflow check: it is paired with FIX_MOVT_ABS on the following
	// MOVT to materialize the full 32-bit address in a register (the
	// backend has no ADRP, so it builds addresses as MOVW+MOVT).
	FIX_MOVW_ABS_NC int = 202
	// FIX_MOVT_ABS patches the imm4:imm12 of a MOVT with the HIGH 16 bits
	// of a symbol's absolute address (R_ARM_MOVT_ABS); the low half comes
	// from a preceding MOVW carrying FIX_MOVW_ABS_NC.
	FIX_MOVT_ABS int = 203
	// FIX_LDR_PC_G0 patches the U bit and 12-bit offset of a PC-relative LDR / LDRB / STR /
	// STRB (`ldr r0, lbl`): the label's distance from PC, the instruction + 8
	// (R_ARM_LDR_PC_G0).
	FIX_LDR_PC_G0 int = 204
	// FIX_LDRS_PC_G0 patches the U bit and split 8-bit offset of a PC-relative LDRH / STRH /
	// LDRSB / LDRSH (R_ARM_LDRS_PC_G0).
	FIX_LDRS_PC_G0 int = 205
	// FIX_ALU_PC_G0 patches an ADR -- `ADD Rd, PC, #imm` or, for a target behind,
	// `SUB Rd, PC, #imm` -- with the PC-relative distance as a rotated immediate
	// (R_ARM_ALU_PC_G0).
	FIX_ALU_PC_G0 int = 206
	// FIX_MOVW_PREL_NC patches the imm4:imm12 of a MOVW with the low 16 bits of a symbol's
	// address less the instruction's (R_ARM_MOVW_PREL_NC): `:lower16:(sym - .)`.
	FIX_MOVW_PREL_NC int = 207
	// FIX_MOVT_PREL patches the imm4:imm12 of a MOVT with the high 16 bits of a symbol's
	// address less the instruction's (R_ARM_MOVT_PREL): `:upper16:(sym - .)`.
	FIX_MOVT_PREL int = 208
)

// An operand for ARM32 instructions. Covers the ARM "flexible second
// operand" (Operand2): a register with optional shift, or an immediate
// that can be expressed as an 8-bit value rotated right by an even
// amount.
type Operand struct {
	Kind  int
	Reg   int // register number
	Reg2  int // second register (MEM_REG, REG_SREG shift reg)
	Imm   int // immediate value or offset (for LABEL, the addend)
	Shift int // shift type (LSL, LSR, ASR, ROR, RRX)
	ShAmt int // shift amount
	Label @[]char // label name (for LABEL)
	// Sub marks a memory operand whose offset is subtracted from the base (the U bit
	// clear) rather than added: a register index (`[Rn, -Rm]`), or a zero immediate offset
	// (`[Rn, #-0]`, clang's negative zero).
	Sub bool
}

// RotImmResult holds the result of encoding an immediate as a rotated
// 8-bit value. ARM32 data processing immediates are encoded as an 8-bit
// value rotated right by twice a 4-bit rotation field.
type RotImmResult struct {
	Ok   bool
	Imm8 int // 8-bit immediate value
	Rot4 int // 4-bit rotation (actual rotation = Rot4 * 2)
}

// --- Operand constructors ---

// Reg creates a plain register operand.
func Reg(r int) Operand

// Imm creates an immediate operand. A data-processing encoder accepts it only
// when the value is in -2^31..2^32-1 (its 32-bit pattern) and EncodeRotImm
// finds an encoding for that pattern; otherwise the encoder sets an assembler
// error and emits nothing. Values outside the 32-bit range are rejected, not
// truncated to their low 32 bits.
func Imm(val int) Operand

// ImmRot creates a data-processing immediate written with its rotation, `#imm8,
// #rot`: the value imm8 rotated right by rot bits, encoded as written (rot / 2
// in the rotation field, imm8 in the low byte) even where another rotation
// would give the same value.  imm8 must be 0..255 and rot an even number in
// 0..30; otherwise the encoder sets an assembler error and emits nothing.
func ImmRot(imm8 int, rot int) Operand

// RegShift creates a register shifted by an immediate amount. The amount is
// the architectural shift distance: LSL and ROR take 0..31, LSR and ASR take
// 0..32, and RRX takes 0 (it has no amount). A data-processing encoder
// encodes these as clang does: an amount of 0 with LSL, LSR, ASR or ROR is
// the plain register (ROR #0 is not RRX), and LSR #32 and ASR #32 use the
// amount field 0. Given any other amount or shift mode, the encoder sets an
// assembler error and emits nothing.
func RegShift(r int, shift int, amount int) Operand

// RegSReg creates a register shifted by another register. The shift mode must
// be LSL, LSR, ASR or ROR; a data-processing encoder given RRX (which takes no
// shift register) or any other mode sets an assembler error and emits nothing.
func RegSReg(rm int, shift int, rs int) Operand

// MemImm creates a memory operand with immediate offset: [Rn, #imm].
func MemImm(base int, offset int) Operand

// MemReg creates a memory operand with register offset: [Rn, Rm].
func MemReg(base int, index int) Operand

// MemSReg creates a memory operand with shifted register: [Rn, Rm, shift #amt].
func MemSReg(base int, index int, shift int, amount int) Operand

// MemPre creates a pre-indexed memory operand: [Rn, #imm]!
func MemPre(base int, offset int) Operand

// MemPost creates a post-indexed memory operand: [Rn], #imm
func MemPost(base int, offset int) Operand

// MemPreReg creates a pre-indexed memory operand with register: [Rn, Rm]!
func MemPreReg(base int, index int) Operand

// MemPostReg creates a post-indexed memory operand with register: [Rn], Rm
func MemPostReg(base int, index int) Operand

// MemPreSReg creates a pre-indexed memory operand with a shifted register:
// [Rn, Rm, shift #amt]!
func MemPreSReg(base int, index int, shift int, amount int) Operand

// MemPostSReg creates a post-indexed memory operand with a shifted register:
// [Rn], Rm, shift #amt
func MemPostSReg(base int, index int, shift int, amount int) Operand

// SubIndex returns the memory operand op with its offset subtracted from the base
// (`[Rn, -Rm]`, `[Rn], -Rm, lsl #2`, or `[Rn, #-0]`); the load / store encoders clear
// the U bit for it.  op must be one of the register-indexed kinds (MemReg, MemSReg,
// MemPreReg, MemPostReg, MemPreSReg, MemPostSReg) or an immediate one (MemImm, MemPre,
// MemPost) with offset 0, clang's negative zero; a load or store of another operand
// marked so is an error, as is one whose Rt, base or index register is outside R0..R15.
func SubIndex(op Operand) Operand

// Label creates a label reference operand.
func Label(name *[]readonly char) Operand

// LabelAddend creates a reference to label name plus addend bytes (`lbl+4`), the addend
// in Imm; a PC-relative load / store takes it into its fixup.
func LabelAddend(name *[]readonly char, addend int) Operand

// EncodeRotImm tries to encode an immediate as a rotated 8-bit value.
func EncodeRotImm(value int) RotImmResult

// --- Data processing (two-operand with Operand2) ---
//
// Each data-processing encoder (Add through Teq) takes its second operand as
// an Operand2: a register (Reg), a register shifted by an immediate amount
// (RegShift), a register shifted by a register (RegSReg), or an immediate
// (Imm) in -2^31..2^32-1 whose 32-bit pattern EncodeRotImm can express as an
// 8-bit value rotated right by an even amount. The encoder sets an assembler
// error and emits no bytes when the instruction has no encoding:
//   - an immediate outside -2^31..2^32-1 (rejected, not truncated);
//   - an immediate whose 32-bit pattern EncodeRotImm cannot express;
//   - a memory or label operand;
//   - Rd, Rn, or a register inside the operand outside R0..R15;
//   - a RegShift amount outside its shift mode's range (see RegShift), or a
//     shift mode other than LSL, LSR, ASR, ROR or RRX;
//   - a RegSReg shift mode other than LSL, LSR, ASR or ROR.

// Add emits ADD{S}{cond} Rd, Rn, <Operand2>.
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Add(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Sub emits SUB{S}{cond} Rd, Rn, <Operand2>.
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Sub(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Rsb emits RSB{S}{cond} Rd, Rn, <Operand2> (reverse subtract).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Rsb(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Adc emits ADC{S}{cond} Rd, Rn, <Operand2> (add with carry).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Adc(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Sbc emits SBC{S}{cond} Rd, Rn, <Operand2> (subtract with carry).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Sbc(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Rsc emits RSC{S}{cond} Rd, Rn, <Operand2> (reverse subtract with carry).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Rsc(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// And emits AND{S}{cond} Rd, Rn, <Operand2>.
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func And(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Orr emits ORR{S}{cond} Rd, Rn, <Operand2>.
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Orr(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Eor emits EOR{S}{cond} Rd, Rn, <Operand2>.
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Eor(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// Bic emits BIC{S}{cond} Rd, Rn, <Operand2> (bit clear: Rd = Rn AND NOT Op2).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Bic(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand)

// --- Data processing (one-operand destination) ---

// Mov emits MOV{S}{cond} Rd, <Operand2>.
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Mov(a @asm.Assembler, cond int, s bool, rd int, op Operand)

// Mvn emits MVN{S}{cond} Rd, <Operand2> (move NOT).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Mvn(a @asm.Assembler, cond int, s bool, rd int, op Operand)

// --- Compare / Test (set flags, no destination) ---

// Cmp emits CMP{cond} Rn, <Operand2> (Rn - Op2, set flags).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Cmp(a @asm.Assembler, cond int, rn int, op Operand)

// Cmn emits CMN{cond} Rn, <Operand2> (Rn + Op2, set flags).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Cmn(a @asm.Assembler, cond int, rn int, op Operand)

// Tst emits TST{cond} Rn, <Operand2> (Rn AND Op2, set flags).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Tst(a @asm.Assembler, cond int, rn int, op Operand)

// Teq emits TEQ{cond} Rn, <Operand2> (Rn EOR Op2, set flags).
// An operand or register with no encoding (see above) sets an assembler
// error and emits nothing.
func Teq(a @asm.Assembler, cond int, rn int, op Operand)

// --- Move wide ---

// Movw emits MOVW{cond} Rd, #imm16 (move 16-bit immediate to bottom half).  It and the
// three below take a condition COND_EQ..COND_AL, Rd in R0..R14 — MOVW also PC, as clang takes
// it, though the architecture leaves it UNPREDICTABLE — and imm in [0, 65535]; otherwise they set
// an assembler error and emit nothing (no fixup either).
func Movw(a @asm.Assembler, cond int, rd int, imm int)

// Movt emits MOVT{cond} Rd, #imm16 (move 16-bit immediate to top half).
func Movt(a @asm.Assembler, cond int, rd int, imm int)

// MovwLabel emits MOVW{cond} Rd, #:lower16:name — a MOVW with a zero
// immediate plus a FIX_MOVW_ABS_NC fixup, so the object writer emits an
// R_ARM_MOVW_ABS_NC relocation and the linker patches the low 16 bits of
// `name`'s absolute address into the instruction. Pair with MovtLabel on
// the next instruction to materialize a full 32-bit address in Rd.
func MovwLabel(a @asm.Assembler, cond int, rd int, name *[]readonly char)

// MovtLabel emits MOVT{cond} Rd, #:upper16:name — a MOVT with a zero
// immediate plus a FIX_MOVT_ABS fixup (R_ARM_MOVT_ABS), patching the high
// 16 bits of `name`'s absolute address. Follows a MovwLabel to the same Rd.
func MovtLabel(a @asm.Assembler, cond int, rd int, name *[]readonly char)

// MovwRef emits MOVW{cond} Rd with the 16-bit immediate a relocation of kind fills from
// name + addend: FIX_MOVW_ABS_NC / FIX_MOVT_ABS (the low / high half of the address) or
// FIX_MOVW_PREL_NC / FIX_MOVT_PREL (of the address less the instruction's) -- either half in
// either instruction, as clang takes `movw r0, #:upper16:sym`.  An arm32 ELF relocation is
// REL, so the addend rides in the immediate, which the linker sign-extends: a low-half kind's
// addend keeps its low 16 bits (all the low half needs; any 32-bit addend), a high-half kind's
// must be in [-0x8000, 0x7FFF].  Another kind, an addend outside that, or Rd as Movw takes it
// not, is an assembler error with nothing emitted.
func MovwRef(a @asm.Assembler, cond int, rd int, name *[]readonly char, kind int, addend int64)

// MovtRef is MovwRef's MOVT.
func MovtRef(a @asm.Assembler, cond int, rd int, name *[]readonly char, kind int, addend int64)

// --- Load/Store (word and byte) ---
//
// Each load / store is exact: a condition outside COND_EQ..COND_AL, a register outside R0..R15,
// an offset outside its range, a form writing its base back with Rt as the base (except the T
// forms, as clang takes them; "destination register and base register can't be identical", or
// "source ..." for a store), or PC where clang rejects it (LDRB / STRB's Rt but in a form writing
// its base back; a T load's Rt with a register halfword offset) sets an assembler error and emits
// nothing.

// Ldr emits LDR{cond} Rt, <mem> (load word): <mem> an [Rn ...] memory operand, or a label (Label /
// LabelAddend) for the PC-relative form, whose offset a FIX_LDR_PC_G0 fixup fills in.  An operand
// with no encoding (a register, an immediate) sets the assembler error and emits nothing.
func Ldr(a @asm.Assembler, cond int, rt int, op Operand)

// Str emits STR{cond} Rt, <mem> (store word): <mem> an [Rn ...] memory operand, or a label (Label
// / LabelAddend) for the PC-relative form, whose offset a FIX_LDR_PC_G0 fixup fills in.  An
// operand with no encoding (a register, an immediate) sets the assembler error and emits nothing.
func Str(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrb emits LDRB{cond} Rt, <mem> (load byte, zero-extend): <mem> an [Rn ...] memory operand, or a
// label (Label / LabelAddend) for the PC-relative form, whose offset a FIX_LDR_PC_G0 fixup fills
// in.  An operand with no encoding (a register, an immediate) sets the assembler error and emits
// nothing.
func Ldrb(a @asm.Assembler, cond int, rt int, op Operand)

// Strb emits STRB{cond} Rt, <mem> (store byte): <mem> an [Rn ...] memory operand, or a label
// (Label / LabelAddend) for the PC-relative form, whose offset a FIX_LDR_PC_G0 fixup fills in.  An
// operand with no encoding (a register, an immediate) sets the assembler error and emits nothing.
func Strb(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrt emits LDRT{cond} Rt, <mem> (load word unprivileged): <mem> a post-indexed form (MemPost,
// MemPostReg, MemPostSReg; `[Rn]` is MemPost(Rn, 0)).  Another operand sets the assembler error
// and emits nothing.
func Ldrt(a @asm.Assembler, cond int, rt int, op Operand)

// Strt emits STRT{cond} Rt, <mem> (store word unprivileged), <mem> as for Ldrt.
func Strt(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrbt emits LDRBT{cond} Rt, <mem> (load byte unprivileged, zero-extend), <mem> as for Ldrt.
func Ldrbt(a @asm.Assembler, cond int, rt int, op Operand)

// Strbt emits STRBT{cond} Rt, <mem> (store byte unprivileged), <mem> as for Ldrt.
func Strbt(a @asm.Assembler, cond int, rt int, op Operand)

// --- Load/Store (halfword and signed) ---

// Ldrh emits LDRH{cond} Rt, <mem> (load halfword, zero-extend): <mem> an [Rn, #imm] / [Rn, Rm]
// form (offset, pre- or post-indexed; no shifted register), or a label (Label / LabelAddend) for
// the PC-relative form, whose offset a FIX_LDRS_PC_G0 fixup fills in.  An operand with no encoding
// sets the assembler error and emits nothing.
func Ldrh(a @asm.Assembler, cond int, rt int, op Operand)

// Strh emits STRH{cond} Rt, <mem> (store halfword): <mem> an [Rn, #imm] / [Rn, Rm] form (offset,
// pre- or post-indexed; no shifted register), or a label (Label / LabelAddend) for the PC-relative
// form, whose offset a FIX_LDRS_PC_G0 fixup fills in.  An operand with no encoding sets the
// assembler error and emits nothing.
func Strh(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrsb emits LDRSB{cond} Rt, <mem> (load signed byte): <mem> an [Rn, #imm] / [Rn, Rm] form
// (offset, pre- or post-indexed; no shifted register), or a label (Label / LabelAddend) for the
// PC-relative form, whose offset a FIX_LDRS_PC_G0 fixup fills in.  An operand with no encoding
// sets the assembler error and emits nothing.
func Ldrsb(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrsh emits LDRSH{cond} Rt, <mem> (load signed halfword): <mem> an [Rn, #imm] / [Rn, Rm] form
// (offset, pre- or post-indexed; no shifted register), or a label (Label / LabelAddend) for the
// PC-relative form, whose offset a FIX_LDRS_PC_G0 fixup fills in.  An operand with no encoding
// sets the assembler error and emits nothing.
func Ldrsh(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrht emits LDRHT{cond} Rt, <mem> (load halfword unprivileged, zero-extend): <mem> a
// post-indexed form with no shift (MemPost, MemPostReg; `[Rn]` is MemPost(Rn, 0)).  Another
// operand sets the assembler error and emits nothing.
func Ldrht(a @asm.Assembler, cond int, rt int, op Operand)

// Strht emits STRHT{cond} Rt, <mem> (store halfword unprivileged), <mem> as for Ldrht.
func Strht(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrsbt emits LDRSBT{cond} Rt, <mem> (load signed byte unprivileged), <mem> as for Ldrht.
func Ldrsbt(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrsht emits LDRSHT{cond} Rt, <mem> (load signed halfword unprivileged), <mem> as for Ldrht.
func Ldrsht(a @asm.Assembler, cond int, rt int, op Operand)

// Ldrd emits LDRD{cond} Rt, Rt+1, <mem> (load doubleword): Rt even and below R14 ("Rt must be
// even-numbered"); <mem> an [Rn, #imm] / [Rn, Rm] form (offset, pre- or post-indexed; no shifted
// register; a form writing its base back with neither Rt nor Rt + 1 as the base, "base register
// needs to be different from destination registers"), or a label (Label / LabelAddend) for the
// PC-relative form, whose offset a FIX_LDRS_PC_G0 fixup fills in.  Anything else sets the
// assembler error and emits nothing.
func Ldrd(a @asm.Assembler, cond int, rt int, op Operand)

// Strd emits STRD{cond} Rt, Rt+1, <mem> (store doubleword), as for Ldrd ("source register and
// base register can't be identical" for the writeback clash).
func Strd(a @asm.Assembler, cond int, rt int, op Operand)

// --- Preloads (unconditional) ---

// Pld emits PLD <mem> (preload data): <mem> an offset form -- [Rn, #imm] (MemImm, SubIndex for
// `#-0`) or [Rn, ±Rm{, shift}] (MemReg, MemSReg) -- or a label for the PC-relative form, whose
// offset a FIX_LDR_PC_G0 fixup fills in.  A form writing its base back, or any other operand, sets
// the assembler error and emits nothing.
func Pld(a @asm.Assembler, op Operand)

// Pldw emits PLDW <mem> (preload data with intent to write; the multiprocessing extension), <mem>
// as for Pld.
func Pldw(a @asm.Assembler, op Operand)

// Pli emits PLI <mem> (preload instructions; ARMv7), <mem> as for Pld.
func Pli(a @asm.Assembler, op Operand)

// --- ADR: an address computed from PC ---

// Adr emits `ADR{cond} Rd, label{+addend}`: Rd = the label's address, computed from PC
// as `ADD Rd, PC, #d` (or `SUB Rd, PC, #-d` for a label behind), with a FIX_ALU_PC_G0
// fixup filling in d.  A condition outside COND_EQ..COND_AL or an Rd outside R0..R15 is an
// error that emits nothing; a distance that is not a rotated 8-bit immediate is an error at
// resolution.
func Adr(a @asm.Assembler, cond int, rd int, label *[]readonly char, addend int64)

// AdrOffset emits `ADR{cond} Rd` for the address `offset` bytes from PC (which reads
// this instruction + 8): `ADD Rd, PC, #offset`, or `SUB Rd, PC, #-offset` for a
// negative one.  An offset whose magnitude is not a rotated 8-bit immediate is an
// error that emits nothing.
func AdrOffset(a @asm.Assembler, cond int, rd int, offset int)

// --- Load/Store multiple ---

// Block-transfer addressing modes (LDM / STM): increment after / before,
// decrement after / before.
const (
	BT_IA int = iota
	BT_IB
	BT_DA
	BT_DB
)

// BlockTransfer emits LDM{mode}{cond} (load) or STM{mode}{cond} Rn{!}, {regmask}{^}:
// mode is one of BT_IA / BT_IB / BT_DA / BT_DB, writeback writes the final address
// back to Rn, and user (`^`) transfers the user-mode registers -- or, for an LDM whose
// list holds PC, also restores CPSR from SPSR.  regmask is a non-empty 16-bit mask
// (bit i is register i); an empty or wider one, an Rn outside R0..R15, another mode,
// or an LDM with writeback (and no `^`) whose list holds Rn (UNPREDICTABLE) is an
// error that emits nothing.
func BlockTransfer(a @asm.Assembler, cond int, load bool, mode int, rn int, writeback bool,
		user bool, regmask int)

// Ldm emits LDM{cond} Rn, regmask (load multiple, increment after), checked as
// BlockTransfer checks it; so are Stm, Ldmdb, Stmdb, Push and Pop.
func Ldm(a @asm.Assembler, cond int, rn int, writeback bool, regmask int)

// Stm emits STM{cond} Rn, regmask (store multiple, increment after).
func Stm(a @asm.Assembler, cond int, rn int, writeback bool, regmask int)

// Ldmdb emits LDMDB{cond} Rn, regmask (load multiple, decrement before).
func Ldmdb(a @asm.Assembler, cond int, rn int, writeback bool, regmask int)

// Stmdb emits STMDB{cond} Rn, regmask (store multiple, decrement before).
func Stmdb(a @asm.Assembler, cond int, rn int, writeback bool, regmask int)

// Push emits PUSH{cond} regmask: STMDB SP!, regmask, or, for one register Rt, the
// encoding ARM prefers (and clang emits), STR Rt, [SP, #-4]!.
func Push(a @asm.Assembler, cond int, regmask int)

// Pop emits POP{cond} regmask: LDM SP!, regmask, or, for one register Rt, LDR Rt,
// [SP], #4.  A list holding SP, the register written back, is an error that emits
// nothing.
func Pop(a @asm.Assembler, cond int, regmask int)

// --- Branches ---

// B emits B{cond} label (branch).
func B(a @asm.Assembler, cond int, label *[]readonly char)

// Bl emits BL{cond} label (branch with link).
func Bl(a @asm.Assembler, cond int, label *[]readonly char)

// BAddend emits B{cond} (BL{cond} when link) to label plus addend bytes (`b lbl+4`); cond
// 15 (which would encode BLX) is an error that emits nothing.
func BAddend(a @asm.Assembler, cond int, link bool, label *[]readonly char, addend int64)

// BOffset emits B{cond} (BL{cond} when link) to the address `offset` bytes from this
// instruction (`b .` is offset 0) — a target the caller already knows, so no fixup is
// recorded.  offset must be a multiple of 4 within the ±32 MiB a branch reaches, and cond
// 0..14; anything else is an error that emits nothing.
func BOffset(a @asm.Assembler, cond int, link bool, offset int)

// Bx emits BX{cond} Rm (branch and exchange, for interworking); Rm may be PC, as clang takes
// it.
func Bx(a @asm.Assembler, cond int, rm int)

// Blx emits BLX{cond} Rm (branch with link and exchange).
func Blx(a @asm.Assembler, cond int, rm int)

// --- Multiply and divide (arm32_mul.bn) ---
//
// Each is exact: a condition outside COND_EQ..COND_AL, a register outside R0..R15, PC where
// clang rejects it ("operand must be a register in range [r0, r14]": MUL's and SMUAD / SMUSD's
// every register, MLA's, SMLAL<x><y>'s and SMLALD / SMLSLD's every one, SMLA<x><y>'s, SMLAW<y>'s
// and SMLAD / SMLSD's but Ra), or a long multiply's RdLo and RdHi the same register sets an
// assembler error and emits nothing.  The halves of SMLA<x><y> .. SMULW<y> are chosen by nTop
// (Rn's top half, `t` for x) and mTop (Rm's, `t` for y); x exchanges Rm's halves (SMLAD{X} ..),
// round rounds (SMMLA{R} ..).

// Mul emits MUL{S}{cond} Rd, Rn, Rm (Rd = Rn * Rm).
func Mul(a @asm.Assembler, cond int, s bool, rd int, rn int, rm int)

// Mla emits MLA{S}{cond} Rd, Rn, Rm, Ra (Rd = Ra + Rn * Rm).
func Mla(a @asm.Assembler, cond int, s bool, rd int, rn int, rm int, ra int)

// Mls emits MLS{cond} Rd, Rn, Rm, Ra (Rd = Ra - Rn * Rm; ARMv6T2).
func Mls(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int)

// Umull emits UMULL{S}{cond} RdLo, RdHi, Rn, Rm (unsigned 64-bit multiply).
func Umull(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int)

// Umlal emits UMLAL{S}{cond} RdLo, RdHi, Rn, Rm (unsigned 64-bit multiply-accumulate).
func Umlal(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int)

// Smull emits SMULL{S}{cond} RdLo, RdHi, Rn, Rm (signed 64-bit multiply).
func Smull(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int)

// Smlal emits SMLAL{S}{cond} RdLo, RdHi, Rn, Rm (signed 64-bit multiply-accumulate).
func Smlal(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int)

// Umaal emits UMAAL{cond} RdLo, RdHi, Rn, Rm (RdHi:RdLo = Rn * Rm + RdHi + RdLo; ARMv6).
func Umaal(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int)

// SmlaXY emits SMLA<x><y>{cond} Rd, Rn, Rm, Ra (a 16 x 16 multiply-accumulate; ARMv5TE).
func SmlaXY(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, nTop bool, mTop bool)

// SmlawY emits SMLAW<y>{cond} Rd, Rn, Rm, Ra (a 32 x 16 multiply-accumulate; ARMv5TE).
func SmlawY(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, mTop bool)

// SmulwY emits SMULW<y>{cond} Rd, Rn, Rm (a 32 x 16 multiply; ARMv5TE).
func SmulwY(a @asm.Assembler, cond int, rd int, rn int, rm int, mTop bool)

// SmlalXY emits SMLAL<x><y>{cond} RdLo, RdHi, Rn, Rm (a 16 x 16 long multiply-accumulate;
// ARMv5TE).
func SmlalXY(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int, nTop bool, mTop bool)

// SmulXY emits SMUL<x><y>{cond} Rd, Rn, Rm (a 16 x 16 multiply; ARMv5TE).
func SmulXY(a @asm.Assembler, cond int, rd int, rn int, rm int, nTop bool, mTop bool)

// Smlad emits SMLAD{X}{cond} Rd, Rn, Rm, Ra (dual 16-bit multiply, products added; ARMv6).
func Smlad(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, x bool)

// Smlsd emits SMLSD{X}{cond} Rd, Rn, Rm, Ra (dual 16-bit multiply, products subtracted; ARMv6).
func Smlsd(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, x bool)

// Smuad emits SMUAD{X}{cond} Rd, Rn, Rm (dual 16-bit multiply, products added; ARMv6).
func Smuad(a @asm.Assembler, cond int, rd int, rn int, rm int, x bool)

// Smusd emits SMUSD{X}{cond} Rd, Rn, Rm (dual 16-bit multiply, products subtracted; ARMv6).
func Smusd(a @asm.Assembler, cond int, rd int, rn int, rm int, x bool)

// Smlald emits SMLALD{X}{cond} RdLo, RdHi, Rn, Rm (dual multiply, 64-bit accumulate; ARMv6).
func Smlald(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int, x bool)

// Smlsld emits SMLSLD{X}{cond} RdLo, RdHi, Rn, Rm (dual multiply-subtract, 64-bit accumulate;
// ARMv6).
func Smlsld(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int, x bool)

// Smmla emits SMMLA{R}{cond} Rd, Rn, Rm, Ra (the top word of Ra:0 + Rn * Rm; ARMv6).
func Smmla(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, round bool)

// Smmls emits SMMLS{R}{cond} Rd, Rn, Rm, Ra (the top word of Ra:0 - Rn * Rm; ARMv6).
func Smmls(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, round bool)

// Smmul emits SMMUL{R}{cond} Rd, Rn, Rm (the top word of Rn * Rm; ARMv6).
func Smmul(a @asm.Assembler, cond int, rd int, rn int, rm int, round bool)

// Sdiv emits SDIV{cond} Rd, Rn, Rm (signed divide; the hardware-divide extension).
func Sdiv(a @asm.Assembler, cond int, rd int, rn int, rm int)

// Udiv emits UDIV{cond} Rd, Rn, Rm (unsigned divide; the hardware-divide extension).
func Udiv(a @asm.Assembler, cond int, rd int, rn int, rm int)

// --- Saturate, parallel add / subtract, select, absolute differences, pack (arm32_media.bn) ---
//
// Each is exact: a condition outside COND_EQ..COND_AL, a register outside R0..R15, PC where clang
// rejects it (every register of QADD .. QDSUB, the parallel ones, SSAT .. USAT16's and PKHBT /
// PKHTB's; SEL, USAD8 and USADA8 take it), or an immediate out of its range (with clang's
// message) sets an assembler error and emits nothing.

// Parallel add / subtract prefixes, the instruction's bits 22:20: signed (S), signed saturating
// (Q), signed halving (SH), unsigned (U), unsigned saturating (UQ), unsigned halving (UH).
const (
	PAR_S int = 1
	PAR_Q int = 2
	PAR_SH int = 3
	PAR_U int = 5
	PAR_UQ int = 6
	PAR_UH int = 7
)

// Parallel add / subtract operations, the instruction's bits 7:5: ADD16, ASX (add-subtract with
// exchange, the old ADDSUBX), SAX (the old SUBADDX), SUB16, ADD8, SUB8.
const (
	PAR_ADD16 int = 0
	PAR_ASX int = 1
	PAR_SAX int = 2
	PAR_SUB16 int = 3
	PAR_ADD8 int = 4
	PAR_SUB8 int = 7
)

// Qadd emits QADD{cond} Rd, Rm, Rn (Rm + Rn, saturated; the operands in that order).
func Qadd(a @asm.Assembler, cond int, rd int, rm int, rn int)

// Qsub emits QSUB{cond} Rd, Rm, Rn (Rm - Rn, saturated).
func Qsub(a @asm.Assembler, cond int, rd int, rm int, rn int)

// Qdadd emits QDADD{cond} Rd, Rm, Rn (Rm + 2 * Rn, saturated).
func Qdadd(a @asm.Assembler, cond int, rd int, rm int, rn int)

// Qdsub emits QDSUB{cond} Rd, Rm, Rn (Rm - 2 * Rn, saturated).
func Qdsub(a @asm.Assembler, cond int, rd int, rm int, rn int)

// Ssat emits SSAT{cond} Rd, #imm, Rn{, shift #amount} (signed saturate to imm bits, 1..32):
// shift LSL with amount 0..31 or ASR with 1..32.
func Ssat(a @asm.Assembler, cond int, rd int, imm int, rn int, shift int, amount int)

// Usat emits USAT{cond} Rd, #imm, Rn{, shift #amount} (unsigned saturate to imm bits, 0..31),
// the shift as Ssat's.
func Usat(a @asm.Assembler, cond int, rd int, imm int, rn int, shift int, amount int)

// Ssat16 emits SSAT16{cond} Rd, #imm, Rn (each halfword, imm 1..16; ARMv6).
func Ssat16(a @asm.Assembler, cond int, rd int, imm int, rn int)

// Usat16 emits USAT16{cond} Rd, #imm, Rn (each halfword, imm 0..15; ARMv6).
func Usat16(a @asm.Assembler, cond int, rd int, imm int, rn int)

// Parallel emits the parallel add / subtract <prefix><op>{cond} Rd, Rn, Rm (SADD16 ..
// UHSUB8): prefix PAR_S .. PAR_UH, op PAR_ADD16 .. PAR_SUB8.
func Parallel(a @asm.Assembler, cond int, prefix int, op int, rd int, rn int, rm int)

// Sel emits SEL{cond} Rd, Rn, Rm (each byte from Rn or Rm by the GE flags; ARMv6).
func Sel(a @asm.Assembler, cond int, rd int, rn int, rm int)

// Usad8 emits USAD8{cond} Rd, Rn, Rm (the sum of the bytes' absolute differences; ARMv6).
func Usad8(a @asm.Assembler, cond int, rd int, rn int, rm int)

// Usada8 emits USADA8{cond} Rd, Rn, Rm, Ra (Usad8's sum plus Ra; ARMv6).
func Usada8(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int)

// Pkhbt emits PKHBT{cond} Rd, Rn, Rm{, LSL #amount} (Rn's bottom half, shifted Rm's top; amount
// 0..31; ARMv6).
func Pkhbt(a @asm.Assembler, cond int, rd int, rn int, rm int, amount int)

// Pkhtb emits PKHTB{cond} Rd, Rn, Rm, ASR #amount (Rn's top half, shifted Rm's bottom; amount
// 1..32; ARMv6).
func Pkhtb(a @asm.Assembler, cond int, rd int, rn int, rm int, amount int)

// --- Extend, bitfield, reverse, count leading zeros (arm32_bits.bn) ---
//
// Each is exact: a condition outside COND_EQ..COND_AL, a register outside R0..R15, PC where clang
// rejects it (an extend's Rd and Rm, BFI's Rd, SBFX / UBFX's both; BFC, the reverses and CLZ take
// it), or an immediate outside its range (with clang's message) sets an assembler error and emits
// nothing.

// Extend operations, the instruction's bits 22:20: SXTB16, SXTB, SXTH, UXTB16, UXTB, UXTH (the
// extend-and-add forms SXTAB16 .. UXTAH the same).
const (
	EXT_SXTB16 int = 0
	EXT_SXTB int = 2
	EXT_SXTH int = 3
	EXT_UXTB16 int = 4
	EXT_UXTB int = 6
	EXT_UXTH int = 7
)

// Extend emits the extend op{cond} Rd, Rm{, ROR #rot}: op EXT_SXTB16 .. EXT_UXTH, rot 0, 8, 16 or
// 24.
func Extend(a @asm.Assembler, cond int, op int, rd int, rm int, rot int)

// ExtendAdd emits the extend-and-add op{cond} Rd, Rn, Rm{, ROR #rot} (SXTAB16 .. UXTAH); Rn PC
// is Extend, as clang takes it.
func ExtendAdd(a @asm.Assembler, cond int, op int, rd int, rn int, rm int, rot int)

// Sxtb emits SXTB{cond} Rd, Rm — sign-extend the low byte of Rm into Rd.
func Sxtb(a @asm.Assembler, cond int, rd int, rm int)

// Sxth emits SXTH{cond} Rd, Rm — sign-extend the low halfword of Rm into Rd.
func Sxth(a @asm.Assembler, cond int, rd int, rm int)

// Uxtb emits UXTB{cond} Rd, Rm — zero-extend the low byte of Rm into Rd.
func Uxtb(a @asm.Assembler, cond int, rd int, rm int)

// Uxth emits UXTH{cond} Rd, Rm — zero-extend the low halfword of Rm into Rd.
func Uxth(a @asm.Assembler, cond int, rd int, rm int)

// Bfc emits BFC{cond} Rd, #lsb, #width (clear width bits from lsb: lsb 0..31, width
// 1..32-lsb; ARMv6T2).
func Bfc(a @asm.Assembler, cond int, rd int, lsb int, width int)

// Bfi emits BFI{cond} Rd, Rn, #lsb, #width (insert Rn's low width bits at lsb; ARMv6T2); Rn PC
// is BFC, as clang takes it.
func Bfi(a @asm.Assembler, cond int, rd int, rn int, lsb int, width int)

// Sbfx emits SBFX{cond} Rd, Rn, #lsb, #width (extract a signed field: lsb 0..31, width
// 1..32-lsb; ARMv6T2).
func Sbfx(a @asm.Assembler, cond int, rd int, rn int, lsb int, width int)

// Ubfx emits UBFX{cond} Rd, Rn, #lsb, #width (extract an unsigned field; ARMv6T2).
func Ubfx(a @asm.Assembler, cond int, rd int, rn int, lsb int, width int)

// Rev emits REV{cond} Rd, Rm (reverse the bytes; ARMv6).
func Rev(a @asm.Assembler, cond int, rd int, rm int)

// Rev16 emits REV16{cond} Rd, Rm (reverse each halfword's bytes; ARMv6).
func Rev16(a @asm.Assembler, cond int, rd int, rm int)

// Revsh emits REVSH{cond} Rd, Rm (reverse the low halfword's bytes, sign-extended; ARMv6).
func Revsh(a @asm.Assembler, cond int, rd int, rm int)

// Rbit emits RBIT{cond} Rd, Rm (reverse the bits; ARMv6T2).
func Rbit(a @asm.Assembler, cond int, rd int, rm int)

// Clz emits CLZ{cond} Rd, Rm (count leading zeros; ARMv5T).
func Clz(a @asm.Assembler, cond int, rd int, rm int)

// Nop emits NOP{cond}, the ARMv6K hint (0x0320F000 with the condition in bits 31:28); before
// ARMv6K, MOV{cond} R0, R0 stands for it.
func Nop(a @asm.Assembler, cond int)

// Svc emits SVC{cond} #imm24 (supervisor call).  An imm outside 0..0xFFFFFF
// sets an assembler error and emits nothing.
func Svc(a @asm.Assembler, cond int, imm int)

// Bkpt emits BKPT #imm16 (breakpoint, unconditional).  An imm outside 0..0xFFFF
// sets an assembler error and emits nothing.
func Bkpt(a @asm.Assembler, imm int)

// --- For the sub-package pkg/binate/asm/arm32/vfp ---

// Emit32 emits the instruction word inst, as every encoder here does.
func Emit32(a @asm.Assembler, inst uint32)

// CondOk reports whether cond is a condition, COND_EQ..COND_AL, setting the assembler error if
// not.
func CondOk(a @asm.Assembler, cond int) bool

// RegOk reports whether r is a core register, R0..R15 (not PC when noPC), setting the assembler
// error if not.
func RegOk(a @asm.Assembler, r int, noPC bool) bool

// --- Fixup resolution ---

// ResolveFixups resolves every branch and PC-relative load / store to a local symbol in
// its own section by patching the instruction, and writes each other ARM32 fixup's addend
// into its field (REL relocations carry none) — a reference to a global or weak symbol
// stays a relocation, as clang leaves it.  Returns false, with a's error set, when a value has no
// encoding in its field (out of range or misaligned).  Must be called before
// asm.Finalize().
func ResolveFixups(a @asm.Assembler) bool
