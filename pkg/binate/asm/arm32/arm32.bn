package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- Operand constructors ---

func Reg(r int) Operand {
	var op Operand
	op.Kind = OP_REG
	op.Reg = r
	return op
}

// Imm returns an immediate-value Operand. ARM32 data-processing
// instructions encode immediates as an 8-bit value rotated by an even
// amount. A data-processing encoder takes a value in -2^31..2^32-1 as its
// 32-bit pattern and uses EncodeRotImm to find the encoding; a value outside
// that range (rejected rather than truncated to its low 32 bits), or one no
// rotation matches, makes the encoder set an assembler error and emit
// nothing.
func Imm(val int) Operand {
	var op Operand
	op.Kind = OP_IMM
	op.Imm = val
	return op
}

// RegShift returns a shifted-register Operand: register `r` shifted by
// an immediate `amount` of bits using shift mode `shift` (LSL / LSR /
// ASR / ROR / RRX). Used as the second operand of register-form
// data-processing instructions, whose encoders check the amount against the
// shift mode's range (see encodeImmShift).
func RegShift(r int, shift int, amount int) Operand {
	var op Operand
	op.Kind = OP_REG_SHIFT
	op.Reg = r
	op.Shift = shift
	op.ShAmt = amount
	return op
}

// RegSReg returns a register-shifted-by-register Operand: `rm` shifted
// by the value in register `rs` using shift mode `shift` (LSL / LSR /
// ASR / ROR). The shift amount is read from the low byte of `rs` at
// execution time.
func RegSReg(rm int, shift int, rs int) Operand {
	var op Operand
	op.Kind = OP_REG_SREG
	op.Reg = rm
	op.Shift = shift
	op.Reg2 = rs
	return op
}

// MemImm returns a memory operand `[base, #offset]` (signed 12-bit
// offset for word/byte loads). The base register is unchanged.
func MemImm(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_IMM
	op.Reg = base
	op.Imm = offset
	return op
}

// MemReg returns a memory operand `[base, index]` — register-indexed
// addressing without scaling.
func MemReg(base int, index int) Operand {
	var op Operand
	op.Kind = OP_MEM_REG
	op.Reg = base
	op.Reg2 = index
	return op
}

// MemSReg returns a memory operand `[base, index, shift #amount]` —
// register-indexed addressing with the index pre-shifted (LSL/LSR/ASR/ROR).
func MemSReg(base int, index int, shift int, amount int) Operand {
	var op Operand
	op.Kind = OP_MEM_SREG
	op.Reg = base
	op.Reg2 = index
	op.Shift = shift
	op.ShAmt = amount
	return op
}

// MemPre returns a pre-indexed memory operand `[base, #offset]!`. The
// base register is updated to `base + offset` BEFORE the access.
func MemPre(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_PRE
	op.Reg = base
	op.Imm = offset
	return op
}

// MemPost returns a post-indexed memory operand `[base], #offset`. The
// access uses `[base]`, then base is updated to `base + offset` AFTER.
func MemPost(base int, offset int) Operand {
	var op Operand
	op.Kind = OP_MEM_POST
	op.Reg = base
	op.Imm = offset
	return op
}

// MemPreReg is the register-indexed form of MemPre: `[base, index]!`,
// with `base = base + index` written back BEFORE the access.
func MemPreReg(base int, index int) Operand {
	var op Operand
	op.Kind = OP_MEM_PRE_REG
	op.Reg = base
	op.Reg2 = index
	return op
}

// MemPostReg is the register-indexed form of MemPost: `[base], index`,
// with `base = base + index` written back AFTER the access.
func MemPostReg(base int, index int) Operand {
	var op Operand
	op.Kind = OP_MEM_POST_REG
	op.Reg = base
	op.Reg2 = index
	return op
}

// Label returns a symbolic-target Operand referring to `name`. The name
// is copied; the input slice does not need to outlive the Operand. Used
// as the target of branches; resolved by the assembler's fixup machinery.
func Label(name *[]readonly char) Operand {
	var op Operand
	op.Kind = OP_LABEL
	op.Label = buf.CopyStr(name)
	return op
}

// --- Encoding helpers ---

// emit32 emits a 32-bit instruction word to the assembler's current section.
func emit32(a @asm.Assembler, inst uint32) {
	a.EmitUint32(inst)
}

// condBits places the 4-bit condition code into bits [31:28].
func condBits(cond int) uint32 {
	return cast(uint32, cond & 0xf) << 28
}

// sBit returns bit 20 (set-flags bit) if s is true.
func sBit(s bool) uint32 {
	if s {
		return cast(uint32, 1) << 20
	}
	return 0
}

// --- Rotated immediate encoding ---
// ARM32 data processing immediates: 8-bit value rotated right by
// an even amount (0, 2, 4, ..., 30). The 4-bit rotation field stores
// half the rotation. This gives a total of 16 possible rotations.

// ror32 rotates a uint32 value right by r bits.
func ror32(v uint32, r int) uint32 {
	if r == 0 || r == 32 {
		return v
	}
	var ru uint32 = cast(uint32, r)
	return (v >> ru) | (v << (32 - ru))
}

// EncodeRotImm tries to encode `value` as an ARM data-processing
// immediate: an 8-bit value rotated right by an even amount (0, 2, 4,
// ..., 30) — i.e. the I=1 form of an immediate operand. Returns Ok=true
// with Imm8 and Rot4 set on success; Ok=false if no rotation makes the
// value fit in 8 bits (callers must fall back to MOVW/MOVT or a literal
// pool).
func EncodeRotImm(value int) RotImmResult {
	var fail RotImmResult
	// The ARM immediate is: imm8 ROR (rot4*2). To find the encoding,
	// rotate value LEFT by rot4*2 and check if it fits in 8 bits.
	var uval uint32 = cast(uint32, value)
	for rot := 0; rot < 16; rot++ {
		// Rotate left = rotate right by (32 - shift)
		var shift int = rot * 2
		var candidate uint32 = ror32(uval, (32 - shift) % 32)
		if candidate <= 0xff {
			var result RotImmResult
			result.Ok = true
			result.Imm8 = cast(int, candidate)
			result.Rot4 = rot
			return result
		}
	}
	return fail
}

// --- Data processing encoding ---

// isCoreReg reports whether r names a core register, R0..R15. A number
// outside that range (a VFP register constant, a negative sentinel) has no
// 4-bit register field encoding.
func isCoreReg(r int) bool {
	return r >= 0 && r <= 15
}

// encodeImmShift returns the shift-type (bits [6:5]) and shift-amount
// (bits [11:7]) fields, already in position, of a register shifted by an
// immediate amount, encoded as clang encodes the same assembly. The amount is
// the architectural shift distance: LSL and ROR take 0..31, and LSR and ASR
// take 0..32. A shift by 0 in any of those modes leaves the register
// unchanged, so it is encoded as the plain register (LSL #0) — for ROR too:
// ROR #0 is not RRX. LSR #32 and ASR #32 are encoded with an amount field of 0.
// RRX takes no amount (amount must be 0) and is encoded as ROR with an amount
// field of 0. Any other amount or shift mode has no encoding: encodeImmShift
// then sets an assembler error and returns ok=false.
func encodeImmShift(a @asm.Assembler, shift int, amount int) (bool, uint32) {
	if shift == RRX {
		if amount != 0 {
			a.SetError("arm32: RRX takes no shift amount (amount must be 0)")
			return false, 0
		}
		return true, cast(uint32, ROR) << 5
	}
	if shift == LSL {
		if amount < 0 || amount > 31 {
			a.SetError("arm32: LSL shift amount out of range (must be 0..31)")
			return false, 0
		}
	}
	if shift == LSR || shift == ASR {
		if amount < 0 || amount > 32 {
			a.SetError("arm32: LSR/ASR shift amount out of range (must be 0..32)")
			return false, 0
		}
	}
	if shift == ROR {
		if amount < 0 || amount > 31 {
			a.SetError("arm32: ROR shift amount out of range (must be 0..31)")
			return false, 0
		}
	}
	if shift < LSL || shift > ROR {
		a.SetError("arm32: unknown shift mode (must be LSL, LSR, ASR, ROR or RRX)")
		return false, 0
	}
	if amount == 0 {
		// The plain register: shift type LSL, amount field 0.
		return true, 0
	}
	// amount & 0x1f maps LSR/ASR #32 to the amount field 0 and leaves 1..31
	// unchanged.
	return true, (cast(uint32, amount & 0x1f) << 7) | (cast(uint32, shift) << 5)
}

// fitsWord reports whether value is a 32-bit pattern written as an int: a
// value in -2^31..2^32-1, the union of the int32 and uint32 ranges. value >> 31
// is 0 for 0..2^31-1, 1 for 2^31..2^32-1 and -1 for -2^31..-1, and anything
// else for a value outside the range. Where int is 32 bits every value fits.
func fitsWord(value int) bool {
	var hi int = value >> 31
	return hi == 0 || hi == 1 || hi == -1
}

// encodeOperand2 encodes the flexible second operand of a data-processing
// instruction. It returns ok, the I bit (bit 25: set for an immediate, clear
// for a register form) and the operand2 field (bits [11:0]). These operands
// have no encoding:
//   - an immediate outside -2^31..2^32-1: it has no 32-bit pattern, and it is
//     rejected rather than truncated to its low 32 bits;
//   - an immediate whose 32-bit pattern is not an 8-bit value rotated right by
//     an even amount;
//   - a register form naming a register outside R0..R15;
//   - a register shifted by an immediate whose shift mode or amount
//     encodeImmShift rejects;
//   - a register shifted by a register with a mode other than LSL, LSR, ASR
//     or ROR;
//   - an operand that is not an Operand2 kind (a memory or label operand).
// For those, encodeOperand2 sets an assembler error and returns ok=false, and
// the caller must emit nothing for the instruction.
func encodeOperand2(a @asm.Assembler, op Operand) (bool, uint32, uint32) {
	if op.Kind == OP_IMM {
		if !fitsWord(op.Imm) {
			a.SetError(
					"arm32: data-processing immediate outside the 32-bit range "
							"(must be -2^31..2^32-1)")
			return false, 0, 0
		}
		var ri RotImmResult = EncodeRotImm(op.Imm)
		if !ri.Ok {
			a.SetError(
					"arm32: data-processing immediate is not an 8-bit value "
							"rotated right by an even amount; materialize it in a register")
			return false, 0, 0
		}
		var imm uint32 = cast(uint32, ri.Rot4 & 0xf) << 8
		imm = imm | cast(uint32, ri.Imm8 & 0xff)
		return true, cast(uint32, 1) << 25, imm
	}
	if op.Kind == OP_REG {
		if !isCoreReg(op.Reg) {
			a.SetError("arm32: data-processing register out of range (must be R0..R15)")
			return false, 0, 0
		}
		return true, 0, cast(uint32, op.Reg)
	}
	if op.Kind == OP_REG_SHIFT {
		if !isCoreReg(op.Reg) {
			a.SetError("arm32: data-processing register out of range (must be R0..R15)")
			return false, 0, 0
		}
		var ok bool = false
		var shiftBits uint32 = 0
		ok, shiftBits = encodeImmShift(a, op.Shift, op.ShAmt)
		if !ok { return false, 0, 0 }
		// Rm, shift_type #amount: imm5[11:7] | type[6:5] | 0[4] | Rm[3:0]
		return true, 0, shiftBits | cast(uint32, op.Reg)
	}
	if op.Kind == OP_REG_SREG {
		if !isCoreReg(op.Reg) || !isCoreReg(op.Reg2) {
			a.SetError("arm32: data-processing register out of range (must be R0..R15)")
			return false, 0, 0
		}
		if op.Shift < LSL || op.Shift > ROR {
			a.SetError(
					"arm32: register-shifted register needs LSL, LSR, ASR or ROR "
							"(RRX takes no shift register)")
			return false, 0, 0
		}
		var rm uint32 = cast(uint32, op.Reg)
		var shiftType uint32 = cast(uint32, op.Shift)
		var rs uint32 = cast(uint32, op.Reg2)
		// Rs[11:8] | 0[7] | type[6:5] | 1[4] | Rm[3:0]
		return true, 0, (rs << 8) | (shiftType << 5) | (1 << 4) | rm
	}
	a.SetError(
			"arm32: data-processing operand must be a register, shifted register, "
					"or immediate (not a memory or label operand)")
	return false, 0, 0
}

// emitDP emits a data-processing instruction.
// Format: cond[31:28] | 00 | I[25] | opcode[24:21] | S[20] | Rn[19:16]
//         | Rd[15:12] | operand2[11:0]
// An Rd or Rn outside R0..R15, or an op with no Operand2 encoding, sets an
// assembler error and nothing is emitted.
func emitDP(a @asm.Assembler, cond int, opcode int, s bool, rd int, rn int, op Operand) {
	if !isCoreReg(rd) || !isCoreReg(rn) {
		a.SetError("arm32: data-processing register out of range (must be R0..R15)")
		return
	}
	var ok bool = false
	var iBit uint32 = 0
	var op2 uint32 = 0
	ok, iBit, op2 = encodeOperand2(a, op)
	if !ok { return }
	var inst uint32 = condBits(cond)
	inst = inst | iBit
	inst = inst | (cast(uint32, opcode & 0xf) << 21)
	inst = inst | sBit(s)
	inst = inst | (cast(uint32, rn) << 16)
	inst = inst | (cast(uint32, rd) << 12)
	inst = inst | op2
	emit32(a, inst)
}
