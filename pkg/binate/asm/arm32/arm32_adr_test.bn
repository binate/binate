package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// ADR (Adr, AdrOffset): an ADD or SUB from PC, each word as clang assembles the
// instruction (`clang -target armv7a-none-eabi`).

// An offset forward is an ADD, one behind a SUB, the magnitude a rotated immediate:
// `add r0, pc, #8` E28F0008, `add r0, pc, #256` E28F0C01, `sub r0, pc, #264` E24F0F42,
// `subne r2, pc, #1020` 124F2FFF.
func TestAdrOffsetForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	AdrOffset(a, COND_AL, R0, 8)
	AdrOffset(a, COND_AL, R0, 0x100)
	AdrOffset(a, COND_AL, R0, -0x108)
	AdrOffset(a, COND_NE, R2, -0x3fc)
	if a.HasError { return fail(a.ErrorMsg) }
	if readInst(a.Sections[0], 0) != 0xE28F0008 { return fail("ADR +8 encoded wrong") }
	if readInst(a.Sections[0], 4) != 0xE28F0C01 { return fail("ADR +0x100 encoded wrong") }
	if readInst(a.Sections[0], 8) != 0xE24F0F42 { return fail("ADR -0x108 encoded wrong") }
	if readInst(a.Sections[0], 12) != 0x124F2FFF { return fail("ADRNE -0x3fc encoded wrong") }
	return ""
}

// A magnitude with no rotated encoding, either way, or an Rd outside R0..R15, is an
// error that emits nothing.
func TestAdrRejects() testing.TestResult {
	for i := 0; i < 4; i++ {
		var a @asm.Assembler = newAsm()
		if i == 0 { AdrOffset(a, COND_AL, R0, 0x101) }
		if i == 1 { AdrOffset(a, COND_AL, R0, -0x101) }
		if i == 2 { AdrOffset(a, COND_AL, 16, 8) }
		if i == 3 { Adr(a, COND_AL, 16, "L", 0) }
		if !a.HasError { return fail("an invalid ADR was accepted") }
		if a.Sections[0].Len != 0 { return fail("an invalid ADR emitted a word") }
	}
	return ""
}

// A label in the same section resolves in place, no relocation: one behind at 0 from
// an ADR at 0x20 is `sub r0, pc, #40` (E24F0028), one ahead at 0x50 from an ADR at 0x24
// is `add r1, pc, #36` (E28F1024).
func TestAdrResolvesLocalLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.DefineLabel("back")
	a.Fill(0x20, 0)
	Adr(a, COND_AL, R0, "back", 0)
	Adr(a, COND_AL, R1, "ahead", 0)
	a.Fill(0x28, 0)
	a.DefineLabel("ahead")
	if !ResolveFixups(a) { return fail("local ADR fixups did not resolve") }
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if readInst(a.Sections[0], 0x20) != 0xE24F0028 { return fail("ADR back encoded wrong") }
	if readInst(a.Sections[0], 0x24) != 0xE28F1024 { return fail("ADR ahead encoded wrong") }
	if a.NumRelocs != 0 { return fail("a local ADR left a relocation") }
	return ""
}

// A label 0x102 bytes from PC has no rotated encoding: resolution fails, naming it.
func TestAdrLocalOutOfRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adr(a, COND_AL, R0, "far", 0)
	a.Fill(0x106, 0)
	a.DefineLabel("far")
	if ResolveFixups(a) { return fail("an unencodable ADR distance resolved") }
	if !a.HasError { return fail("an unencodable ADR distance set no error") }
	return ""
}

// To an external symbol, the REL addend is baked into the instruction, PC's read-ahead
// included, as clang writes it: `adr r0, ext` is `sub r0, pc, #8` (E24F0008) and
// `adr r1, ext+16` `add r1, pc, #8` (E28F1008), each with a FIX_ALU_PC_G0 relocation.
func TestAdrExternalBakesAddend() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.SetGlobal("ext")
	Adr(a, COND_AL, R0, "ext", 0)
	Adr(a, COND_AL, R1, "ext", 16)
	if !ResolveFixups(a) { return fail("external ADR addends did not bake") }
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if readInst(a.Sections[0], 0) != 0xE24F0008 { return fail("ADR ext baked wrong") }
	if readInst(a.Sections[0], 4) != 0xE28F1008 { return fail("ADR ext+16 baked wrong") }
	if a.NumRelocs != 2 { return fail("expected two relocations") }
	for i := 0; i < 2; i++ {
		var r asm.Relocation = a.Relocs[i]
		if r.Kind != FIX_ALU_PC_G0 || r.Offset != cast(uint, 4 * i) {
			return fail("an ADR relocation has the wrong kind or offset")
		}
		if !charsSame(a.Symbols[r.Symbol].Name, "ext") { return fail("an ADR relocation is not to ext") }
	}
	return ""
}
