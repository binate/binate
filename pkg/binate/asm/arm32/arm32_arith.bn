package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// DP_* are the 4-bit opcode values for ARM data-processing
// instructions (bits [24:21]). See ARM ARM A5-2 for the encoding table.

// DP_AND is the data-processing opcode for `AND Rd, Rn, op` (bitwise AND).
const DP_AND int = 0x0

// DP_EOR is the data-processing opcode for `EOR Rd, Rn, op` (bitwise XOR).
const DP_EOR int = 0x1

// DP_SUB is the data-processing opcode for `SUB Rd, Rn, op`.
const DP_SUB int = 0x2

// DP_RSB is the data-processing opcode for `RSB Rd, Rn, op`
// (reverse subtract: Rd = op - Rn).
const DP_RSB int = 0x3

// DP_ADD is the data-processing opcode for `ADD Rd, Rn, op`.
const DP_ADD int = 0x4

// DP_ADC is the data-processing opcode for `ADC Rd, Rn, op`
// (add with carry).
const DP_ADC int = 0x5

// DP_SBC is the data-processing opcode for `SBC Rd, Rn, op`
// (subtract with carry).
const DP_SBC int = 0x6

// DP_RSC is the data-processing opcode for `RSC Rd, Rn, op`
// (reverse subtract with carry: Rd = op - Rn - !C).
const DP_RSC int = 0x7

// DP_TST is the data-processing opcode for `TST Rn, op`
// (AND-and-set-flags; Rd field SBZ).
const DP_TST int = 0x8

// DP_TEQ is the data-processing opcode for `TEQ Rn, op`
// (XOR-and-set-flags; Rd field SBZ).
const DP_TEQ int = 0x9

// DP_CMP is the data-processing opcode for `CMP Rn, op`
// (subtract-and-set-flags; Rd field SBZ).
const DP_CMP int = 0xA

// DP_CMN is the data-processing opcode for `CMN Rn, op`
// (add-and-set-flags; Rd field SBZ).
const DP_CMN int = 0xB

// DP_ORR is the data-processing opcode for `ORR Rd, Rn, op`
// (bitwise OR).
const DP_ORR int = 0xC

// DP_MOV is the data-processing opcode for `MOV Rd, op` (Rn SBZ).
const DP_MOV int = 0xD

// DP_BIC is the data-processing opcode for `BIC Rd, Rn, op`
// (bit clear: Rd = Rn AND NOT op).
const DP_BIC int = 0xE

// DP_MVN is the data-processing opcode for `MVN Rd, op`
// (bitwise NOT; Rn SBZ).
const DP_MVN int = 0xF

// --- Two-operand data processing ---

func Add(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_ADD, s, rd, rn, op))
}

// Sub emits `SUB{cond}{S} Rd, Rn, op` — Rd = Rn - op. cond is a 4-bit
// condition code (always = AL); s=true selects the flag-setting form.
func Sub(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_SUB, s, rd, rn, op))
}

// Rsb emits `RSB{cond}{S} Rd, Rn, op` — Rd = op - Rn (reverse subtract).
func Rsb(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_RSB, s, rd, rn, op))
}

// Adc emits `ADC{cond}{S} Rd, Rn, op` — Rd = Rn + op + C (add with carry).
func Adc(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_ADC, s, rd, rn, op))
}

// Sbc emits `SBC{cond}{S} Rd, Rn, op` — Rd = Rn - op - !C (subtract with carry).
func Sbc(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_SBC, s, rd, rn, op))
}

// Rsc emits `RSC{cond}{S} Rd, Rn, op` — Rd = op - Rn - !C (reverse SBC).
func Rsc(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_RSC, s, rd, rn, op))
}

// And emits `AND{cond}{S} Rd, Rn, op` — bitwise AND.
func And(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_AND, s, rd, rn, op))
}

// Orr emits `ORR{cond}{S} Rd, Rn, op` — bitwise OR.
func Orr(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_ORR, s, rd, rn, op))
}

// Eor emits `EOR{cond}{S} Rd, Rn, op` — bitwise XOR.
func Eor(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_EOR, s, rd, rn, op))
}

// Bic emits `BIC{cond}{S} Rd, Rn, op` — bit clear: Rd = Rn AND NOT op.
func Bic(a @asm.Assembler, cond int, s bool, rd int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_BIC, s, rd, rn, op))
}

// --- One-operand destination (MOV/MVN) ---
// Rn field is SBZ (should be zero) for MOV/MVN.

func Mov(a @asm.Assembler, cond int, s bool, rd int, op Operand) {
	emit32(a, dpEnc(cond, DP_MOV, s, rd, 0, op))
}

// Mvn emits `MVN{cond}{S} Rd, op` — Rd = NOT op (bitwise NOT).
func Mvn(a @asm.Assembler, cond int, s bool, rd int, op Operand) {
	emit32(a, dpEnc(cond, DP_MVN, s, rd, 0, op))
}

// --- Compare / Test (set flags, no Rd written) ---
// Rd field is SBZ; S is always 1 (implied).

func Cmp(a @asm.Assembler, cond int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_CMP, true, 0, rn, op))
}

// Cmn emits `CMN{cond} Rn, op` — set flags as if Rn + op had been
// computed (compare to negated). No Rd written.
func Cmn(a @asm.Assembler, cond int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_CMN, true, 0, rn, op))
}

// Tst emits `TST{cond} Rn, op` — set flags as if Rn AND op (bit-test).
// No Rd written.
func Tst(a @asm.Assembler, cond int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_TST, true, 0, rn, op))
}

// Teq emits `TEQ{cond} Rn, op` — set flags as if Rn XOR op (test for
// equality without disturbing C/V). No Rd written.
func Teq(a @asm.Assembler, cond int, rn int, op Operand) {
	emit32(a, dpEnc(cond, DP_TEQ, true, 0, rn, op))
}

// --- Move wide (ARMv6T2+) ---

// Movw: MOVW Rd, #imm16 — load 16-bit immediate into bottom half of Rd
// Encoding: cond|0011|0000|imm4[19:16]|Rd[15:12]|imm12[11:0]
func Movw(a @asm.Assembler, cond int, rd int, imm int) {
	var uimm uint32 = cast(uint32, imm & 0xffff)
	var imm4 uint32 = (uimm >> 12) & 0xf
	var imm12 uint32 = uimm & 0xfff
	var inst uint32 = condBits(cond)
	inst = inst | 0x03000000
	inst = inst | (imm4 << 16)
	inst = inst | (cast(uint32, rd & 0xf) << 12)
	inst = inst | imm12
	emit32(a, inst)
}

// Movt: MOVT Rd, #imm16 — load 16-bit immediate into top half of Rd
// Encoding: cond|0011|0100|imm4[19:16]|Rd[15:12]|imm12[11:0]
func Movt(a @asm.Assembler, cond int, rd int, imm int) {
	var uimm uint32 = cast(uint32, imm & 0xffff)
	var imm4 uint32 = (uimm >> 12) & 0xf
	var imm12 uint32 = uimm & 0xfff
	var inst uint32 = condBits(cond)
	inst = inst | 0x03400000
	inst = inst | (imm4 << 16)
	inst = inst | (cast(uint32, rd & 0xf) << 12)
	inst = inst | imm12
	emit32(a, inst)
}

// MovwLabel emits MOVW Rd with a zero 16-bit immediate and records a
// FIX_MOVW_ABS_NC fixup at the instruction's offset. The fixup is added
// BEFORE the emit (AddFixup records at the current section offset, which
// is where the instruction is about to be written) — mirroring how
// B/Bl/Ldr(Label) record their fixups. The object writer turns it into an
// R_ARM_MOVW_ABS_NC relocation so the linker patches the low 16 bits of
// `name`'s absolute address into imm4:imm12.
func MovwLabel(a @asm.Assembler, cond int, rd int, name *[]readonly char) {
	a.AddFixup(name, FIX_MOVW_ABS_NC, 0, 4)
	Movw(a, cond, rd, 0)
}

// MovtLabel emits MOVT Rd with a zero 16-bit immediate and records a
// FIX_MOVT_ABS fixup at the instruction's offset (see MovwLabel). The
// object writer turns it into an R_ARM_MOVT_ABS relocation so the linker
// patches the high 16 bits of `name`'s absolute address into imm4:imm12.
func MovtLabel(a @asm.Assembler, cond int, rd int, name *[]readonly char) {
	a.AddFixup(name, FIX_MOVT_ABS, 0, 4)
	Movt(a, cond, rd, 0)
}
