package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The extends, bitfields, reverses and CLZ, exact (arm32.bni): each checks its condition,
// registers and immediates and emits nothing when one has no encoding, with clang's message where
// clang rejects it.

// extendRotOk reports whether rot is an extend's rotation (0, 8, 16 or 24), setting clang's error
// if not.
func extendRotOk(a @asm.Assembler, rot int) bool {
	if rot == 0 || rot == 8 || rot == 16 || rot == 24 { return true }
	a.SetError("'ror' rotate amount must be 8, 16, or 24")
	return false
}

// extendOpOk reports whether op is an extend operation (EXT_SXTB16 .. EXT_UXTH), setting the
// assembler error if not.
func extendOpOk(a @asm.Assembler, op int) bool {
	if op == EXT_SXTB16 || op == EXT_SXTB || op == EXT_SXTH || op == EXT_UXTB16 || op == EXT_UXTB ||
			op == EXT_UXTH {
		return true
	}
	a.SetError("arm32: an extend operation out of range")
	return false
}

// Extend emits the extend op Rd, Rm{, ROR #rot}.
func Extend(a @asm.Assembler, cond int, op int, rd int, rm int, rot int) {
	if !extendOpOk(a, op) || !mediaRegsOk(a, cond, true, 2, rd, rm, 0, 0) || !extendRotOk(a, rot) {
		return
	}
	emit32(a,
			mulWord(cond, 0x06800070 | (cast(uint32, op) << 20) | (cast(uint32, rot / 8) << 10), 15, rd, 0,
					rm))
}

// ExtendAdd emits the extend-and-add op Rd, Rn, Rm{, ROR #rot} (Rn PC is Extend, as clang takes
// it).
func ExtendAdd(a @asm.Assembler, cond int, op int, rd int, rn int, rm int, rot int) {
	if !extendOpOk(a, op) || !mediaRegsOk(a, cond, true, 2, rd, rm, 0, 0) ||
			!mediaRegsOk(a, cond, false, 2, rn, rn, 0, 0) || !extendRotOk(a, rot) {
		return
	}
	emit32(a,
			mulWord(cond, 0x06800070 | (cast(uint32, op) << 20) | (cast(uint32, rot / 8) << 10), rn, rd, 0,
					rm))
}

// Sxtb emits SXTB Rd, Rm.
func Sxtb(a @asm.Assembler, cond int, rd int, rm int) { Extend(a, cond, EXT_SXTB, rd, rm, 0) }

// Sxth emits SXTH Rd, Rm.
func Sxth(a @asm.Assembler, cond int, rd int, rm int) { Extend(a, cond, EXT_SXTH, rd, rm, 0) }

// Uxtb emits UXTB Rd, Rm.
func Uxtb(a @asm.Assembler, cond int, rd int, rm int) { Extend(a, cond, EXT_UXTB, rd, rm, 0) }

// Uxth emits UXTH Rd, Rm.
func Uxth(a @asm.Assembler, cond int, rd int, rm int) { Extend(a, cond, EXT_UXTH, rd, rm, 0) }

// bfiFieldOk reports whether lsb and width give a BFC / BFI field, setting clang's error if not.
func bfiFieldOk(a @asm.Assembler, lsb int, width int) bool {
	if lsb < 0 || lsb > 31 {
		a.SetError("'lsb' operand must be in the range [0,31]")
		return false
	}
	if width < 1 || width > 32 - lsb {
		a.SetError("'width' operand must be in the range [1,32-lsb]")
		return false
	}
	return true
}

// Bfc emits BFC Rd, #lsb, #width (ARMv6T2; Rd PC as clang takes it).
func Bfc(a @asm.Assembler, cond int, rd int, lsb int, width int) {
	if !mediaRegsOk(a, cond, false, 2, rd, rd, 0, 0) || !bfiFieldOk(a, lsb, width) { return }
	emit32(a, mulWord(cond, 0x07C00010 | (cast(uint32, lsb) << 7), lsb + width - 1, rd, 0, 15))
}

// Bfi emits BFI Rd, Rn, #lsb, #width (ARMv6T2; Rn PC is BFC, as clang takes it).
func Bfi(a @asm.Assembler, cond int, rd int, rn int, lsb int, width int) {
	if !mediaRegsOk(a, cond, true, 2, rd, rd, 0, 0) || !mediaRegsOk(a, cond, false, 2, rn, rn, 0, 0) ||
			!bfiFieldOk(a, lsb, width) {
		return
	}
	emit32(a, mulWord(cond, 0x07C00010 | (cast(uint32, lsb) << 7), lsb + width - 1, rd, 0, rn))
}

// extractOk reports whether lsb and width give an SBFX / UBFX field, setting clang's error if
// not.
func extractOk(a @asm.Assembler, lsb int, width int) bool {
	if lsb < 0 || lsb > 31 {
		a.SetError("operand must be an immediate in the range [0,31]")
		return false
	}
	if width < 1 || width > 32 {
		a.SetError("operand must be an immediate in the range [1,32]")
		return false
	}
	if width > 32 - lsb {
		a.SetError("bitfield width must be in range [1,32-lsb]")
		return false
	}
	return true
}

// extract emits SBFX / UBFX (op) Rd, Rn, #lsb, #width.
func extract(a @asm.Assembler, cond int, op uint32, rd int, rn int, lsb int, width int) {
	if !mediaRegsOk(a, cond, true, 2, rd, rn, 0, 0) || !extractOk(a, lsb, width) { return }
	emit32(a, mulWord(cond, op | (cast(uint32, lsb) << 7), width - 1, rd, 0, rn))
}

// Sbfx emits SBFX Rd, Rn, #lsb, #width (ARMv6T2).
func Sbfx(a @asm.Assembler, cond int, rd int, rn int, lsb int, width int) {
	extract(a, cond, 0x07A00050, rd, rn, lsb, width)
}

// Ubfx emits UBFX Rd, Rn, #lsb, #width (ARMv6T2).
func Ubfx(a @asm.Assembler, cond int, rd int, rn int, lsb int, width int) {
	extract(a, cond, 0x07E00050, rd, rn, lsb, width)
}

// reverse emits the reverse or count op Rd, Rm (PC as clang takes it).
func reverse(a @asm.Assembler, cond int, op uint32, rd int, rm int) {
	if !mediaRegsOk(a, cond, false, 2, rd, rm, 0, 0) { return }
	emit32(a, mulWord(cond, op, 15, rd, 15, rm))
}

// Rev emits REV Rd, Rm (ARMv6).
func Rev(a @asm.Assembler, cond int, rd int, rm int) { reverse(a, cond, 0x06B00030, rd, rm) }

// Rev16 emits REV16 Rd, Rm (ARMv6).
func Rev16(a @asm.Assembler, cond int, rd int, rm int) { reverse(a, cond, 0x06B000B0, rd, rm) }

// Revsh emits REVSH Rd, Rm (ARMv6).
func Revsh(a @asm.Assembler, cond int, rd int, rm int) { reverse(a, cond, 0x06F000B0, rd, rm) }

// Rbit emits RBIT Rd, Rm (ARMv6T2).
func Rbit(a @asm.Assembler, cond int, rd int, rm int) { reverse(a, cond, 0x06F00030, rd, rm) }

// Clz emits CLZ Rd, Rm (ARMv5T).
func Clz(a @asm.Assembler, cond int, rd int, rm int) { reverse(a, cond, 0x01600010, rd, rm) }
