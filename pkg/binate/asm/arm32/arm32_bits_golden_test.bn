package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Every extend, extend-add, bitfield, reverse and CLZ form against clang's words (Apple clang 21,
// armv7ve): each operation, each rotation, SP and PC where clang takes them (an extend-add with
// Rn PC is the plain extend), each bitfield at the ends of its lsb and width.
func TestBitsGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Extend(a, COND_AL, EXT_SXTB, R0, R1, 0) // sxtb r0, r1
	Extend(a, COND_AL, EXT_SXTB, SP, R1, 0) // sxtb sp, r1
	Extend(a, COND_AL, EXT_SXTB, R0, SP, 0) // sxtb r0, sp
	Extend(a, COND_AL, EXT_SXTH, R0, R1, 0) // sxth r0, r1
	Extend(a, COND_AL, EXT_SXTH, SP, R1, 0) // sxth sp, r1
	Extend(a, COND_AL, EXT_SXTH, R0, SP, 0) // sxth r0, sp
	Extend(a, COND_AL, EXT_SXTB16, R0, R1, 0) // sxtb16 r0, r1
	Extend(a, COND_AL, EXT_SXTB16, SP, R1, 0) // sxtb16 sp, r1
	Extend(a, COND_AL, EXT_SXTB16, R0, SP, 0) // sxtb16 r0, sp
	Extend(a, COND_AL, EXT_UXTB, R0, R1, 0) // uxtb r0, r1
	Extend(a, COND_AL, EXT_UXTB, SP, R1, 0) // uxtb sp, r1
	Extend(a, COND_AL, EXT_UXTB, R0, SP, 0) // uxtb r0, sp
	Extend(a, COND_AL, EXT_UXTH, R0, R1, 0) // uxth r0, r1
	Extend(a, COND_AL, EXT_UXTH, SP, R1, 0) // uxth sp, r1
	Extend(a, COND_AL, EXT_UXTH, R0, SP, 0) // uxth r0, sp
	Extend(a, COND_AL, EXT_UXTB16, R0, R1, 0) // uxtb16 r0, r1
	Extend(a, COND_AL, EXT_UXTB16, SP, R1, 0) // uxtb16 sp, r1
	Extend(a, COND_AL, EXT_UXTB16, R0, SP, 0) // uxtb16 r0, sp
	Extend(a, COND_AL, EXT_SXTB, R0, R1, 8) // sxtb r0, r1, ror #8
	Extend(a, COND_AL, EXT_SXTB, R0, R1, 16) // sxtb r0, r1, ror #16
	Extend(a, COND_AL, EXT_SXTB, R0, R1, 24) // sxtb r0, r1, ror #24
	Extend(a, COND_AL, EXT_SXTH, R0, R1, 8) // sxth r0, r1, ror #8
	Extend(a, COND_AL, EXT_SXTH, R0, R1, 16) // sxth r0, r1, ror #16
	Extend(a, COND_AL, EXT_SXTH, R0, R1, 24) // sxth r0, r1, ror #24
	Extend(a, COND_AL, EXT_SXTB16, R0, R1, 8) // sxtb16 r0, r1, ror #8
	Extend(a, COND_AL, EXT_SXTB16, R0, R1, 16) // sxtb16 r0, r1, ror #16
	Extend(a, COND_AL, EXT_SXTB16, R0, R1, 24) // sxtb16 r0, r1, ror #24
	Extend(a, COND_AL, EXT_UXTB, R0, R1, 8) // uxtb r0, r1, ror #8
	Extend(a, COND_AL, EXT_UXTB, R0, R1, 16) // uxtb r0, r1, ror #16
	Extend(a, COND_AL, EXT_UXTB, R0, R1, 24) // uxtb r0, r1, ror #24
	Extend(a, COND_AL, EXT_UXTH, R0, R1, 8) // uxth r0, r1, ror #8
	Extend(a, COND_AL, EXT_UXTH, R0, R1, 16) // uxth r0, r1, ror #16
	Extend(a, COND_AL, EXT_UXTH, R0, R1, 24) // uxth r0, r1, ror #24
	Extend(a, COND_AL, EXT_UXTB16, R0, R1, 8) // uxtb16 r0, r1, ror #8
	Extend(a, COND_AL, EXT_UXTB16, R0, R1, 16) // uxtb16 r0, r1, ror #16
	Extend(a, COND_AL, EXT_UXTB16, R0, R1, 24) // uxtb16 r0, r1, ror #24
	Extend(a, COND_EQ, EXT_SXTB, R0, R1, 8) // sxtbeq r0, r1, ror #8
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, R1, R2, 0) // sxtab r0, r1, r2
	ExtendAdd(a, COND_AL, EXT_SXTB, SP, R1, R2, 0) // sxtab sp, r1, r2
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, PC, R2, 0) // sxtab r0, pc, r2
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, SP, R2, 0) // sxtab r0, sp, r2
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, R1, SP, 0) // sxtab r0, r1, sp
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, R1, R2, 8) // sxtab r0, r1, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, R1, R2, 16) // sxtab r0, r1, r2, ror #16
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, R1, R2, 24) // sxtab r0, r1, r2, ror #24
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, PC, R2, 8) // sxtab r0, pc, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, R1, R2, 0) // sxtah r0, r1, r2
	ExtendAdd(a, COND_AL, EXT_SXTH, SP, R1, R2, 0) // sxtah sp, r1, r2
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, PC, R2, 0) // sxtah r0, pc, r2
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, SP, R2, 0) // sxtah r0, sp, r2
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, R1, SP, 0) // sxtah r0, r1, sp
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, R1, R2, 8) // sxtah r0, r1, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, R1, R2, 16) // sxtah r0, r1, r2, ror #16
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, R1, R2, 24) // sxtah r0, r1, r2, ror #24
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, PC, R2, 8) // sxtah r0, pc, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, R1, R2, 0) // sxtab16 r0, r1, r2
	ExtendAdd(a, COND_AL, EXT_SXTB16, SP, R1, R2, 0) // sxtab16 sp, r1, r2
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, PC, R2, 0) // sxtab16 r0, pc, r2
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, SP, R2, 0) // sxtab16 r0, sp, r2
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, R1, SP, 0) // sxtab16 r0, r1, sp
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, R1, R2, 8) // sxtab16 r0, r1, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, R1, R2, 16) // sxtab16 r0, r1, r2, ror #16
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, R1, R2, 24) // sxtab16 r0, r1, r2, ror #24
	ExtendAdd(a, COND_AL, EXT_SXTB16, R0, PC, R2, 8) // sxtab16 r0, pc, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, R1, R2, 0) // uxtab r0, r1, r2
	ExtendAdd(a, COND_AL, EXT_UXTB, SP, R1, R2, 0) // uxtab sp, r1, r2
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, PC, R2, 0) // uxtab r0, pc, r2
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, SP, R2, 0) // uxtab r0, sp, r2
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, R1, SP, 0) // uxtab r0, r1, sp
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, R1, R2, 8) // uxtab r0, r1, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, R1, R2, 16) // uxtab r0, r1, r2, ror #16
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, R1, R2, 24) // uxtab r0, r1, r2, ror #24
	ExtendAdd(a, COND_AL, EXT_UXTB, R0, PC, R2, 8) // uxtab r0, pc, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, R1, R2, 0) // uxtah r0, r1, r2
	ExtendAdd(a, COND_AL, EXT_UXTH, SP, R1, R2, 0) // uxtah sp, r1, r2
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, PC, R2, 0) // uxtah r0, pc, r2
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, SP, R2, 0) // uxtah r0, sp, r2
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, R1, SP, 0) // uxtah r0, r1, sp
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, R1, R2, 8) // uxtah r0, r1, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, R1, R2, 16) // uxtah r0, r1, r2, ror #16
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, R1, R2, 24) // uxtah r0, r1, r2, ror #24
	ExtendAdd(a, COND_AL, EXT_UXTH, R0, PC, R2, 8) // uxtah r0, pc, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, R1, R2, 0) // uxtab16 r0, r1, r2
	ExtendAdd(a, COND_AL, EXT_UXTB16, SP, R1, R2, 0) // uxtab16 sp, r1, r2
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, PC, R2, 0) // uxtab16 r0, pc, r2
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, SP, R2, 0) // uxtab16 r0, sp, r2
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, R1, SP, 0) // uxtab16 r0, r1, sp
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, R1, R2, 8) // uxtab16 r0, r1, r2, ror #8
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, R1, R2, 16) // uxtab16 r0, r1, r2, ror #16
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, R1, R2, 24) // uxtab16 r0, r1, r2, ror #24
	ExtendAdd(a, COND_AL, EXT_UXTB16, R0, PC, R2, 8) // uxtab16 r0, pc, r2, ror #8
	Bfc(a, COND_AL, R0, 0, 1) // bfc r0, #0, #1
	Bfc(a, COND_AL, R0, 0, 32) // bfc r0, #0, #32
	Bfc(a, COND_AL, R0, 8, 8) // bfc r0, #8, #8
	Bfc(a, COND_AL, R0, 31, 1) // bfc r0, #31, #1
	Bfc(a, COND_AL, R0, 16, 16) // bfc r0, #16, #16
	Bfc(a, COND_AL, R0, 1, 31) // bfc r0, #1, #31
	Bfc(a, COND_AL, PC, 8, 8) // bfc pc, #8, #8
	Bfc(a, COND_AL, SP, 8, 8) // bfc sp, #8, #8
	Bfc(a, COND_AL, PC, 0, 1) // bfc pc, #0, #1
	Bfi(a, COND_AL, R0, R1, 0, 1) // bfi r0, r1, #0, #1
	Bfi(a, COND_AL, R0, R1, 0, 32) // bfi r0, r1, #0, #32
	Bfi(a, COND_AL, R0, R1, 8, 8) // bfi r0, r1, #8, #8
	Bfi(a, COND_AL, R0, R1, 31, 1) // bfi r0, r1, #31, #1
	Bfi(a, COND_AL, R0, R1, 16, 16) // bfi r0, r1, #16, #16
	Bfi(a, COND_AL, R0, R1, 1, 31) // bfi r0, r1, #1, #31
	Bfi(a, COND_AL, SP, R1, 8, 8) // bfi sp, r1, #8, #8
	Bfi(a, COND_AL, R0, PC, 8, 8) // bfi r0, pc, #8, #8
	Bfi(a, COND_AL, R0, SP, 8, 8) // bfi r0, sp, #8, #8
	Bfi(a, COND_EQ, R0, R1, 8, 8) // bfieq r0, r1, #8, #8
	Sbfx(a, COND_AL, R0, R1, 0, 1) // sbfx r0, r1, #0, #1
	Sbfx(a, COND_AL, R0, R1, 0, 32) // sbfx r0, r1, #0, #32
	Sbfx(a, COND_AL, R0, R1, 8, 8) // sbfx r0, r1, #8, #8
	Sbfx(a, COND_AL, R0, R1, 31, 1) // sbfx r0, r1, #31, #1
	Sbfx(a, COND_AL, R0, R1, 16, 16) // sbfx r0, r1, #16, #16
	Sbfx(a, COND_AL, R0, R1, 1, 31) // sbfx r0, r1, #1, #31
	Sbfx(a, COND_AL, SP, R1, 8, 8) // sbfx sp, r1, #8, #8
	Sbfx(a, COND_AL, R0, SP, 8, 8) // sbfx r0, sp, #8, #8
	Ubfx(a, COND_AL, R0, R1, 0, 1) // ubfx r0, r1, #0, #1
	Ubfx(a, COND_AL, R0, R1, 0, 32) // ubfx r0, r1, #0, #32
	Ubfx(a, COND_AL, R0, R1, 8, 8) // ubfx r0, r1, #8, #8
	Ubfx(a, COND_AL, R0, R1, 31, 1) // ubfx r0, r1, #31, #1
	Ubfx(a, COND_AL, R0, R1, 16, 16) // ubfx r0, r1, #16, #16
	Ubfx(a, COND_AL, R0, R1, 1, 31) // ubfx r0, r1, #1, #31
	Ubfx(a, COND_AL, SP, R1, 8, 8) // ubfx sp, r1, #8, #8
	Ubfx(a, COND_AL, R0, SP, 8, 8) // ubfx r0, sp, #8, #8
	Rev(a, COND_AL, R0, R1) // rev r0, r1
	Rev(a, COND_AL, PC, R1) // rev pc, r1
	Rev(a, COND_AL, SP, R1) // rev sp, r1
	Rev(a, COND_AL, R0, PC) // rev r0, pc
	Rev(a, COND_AL, R0, SP) // rev r0, sp
	Rev16(a, COND_AL, R0, R1) // rev16 r0, r1
	Rev16(a, COND_AL, PC, R1) // rev16 pc, r1
	Rev16(a, COND_AL, SP, R1) // rev16 sp, r1
	Rev16(a, COND_AL, R0, PC) // rev16 r0, pc
	Rev16(a, COND_AL, R0, SP) // rev16 r0, sp
	Revsh(a, COND_AL, R0, R1) // revsh r0, r1
	Revsh(a, COND_AL, PC, R1) // revsh pc, r1
	Revsh(a, COND_AL, SP, R1) // revsh sp, r1
	Revsh(a, COND_AL, R0, PC) // revsh r0, pc
	Revsh(a, COND_AL, R0, SP) // revsh r0, sp
	Rbit(a, COND_AL, R0, R1) // rbit r0, r1
	Rbit(a, COND_AL, PC, R1) // rbit pc, r1
	Rbit(a, COND_AL, SP, R1) // rbit sp, r1
	Rbit(a, COND_AL, R0, PC) // rbit r0, pc
	Rbit(a, COND_AL, R0, SP) // rbit r0, sp
	Clz(a, COND_AL, R0, R1) // clz r0, r1
	Clz(a, COND_AL, PC, R1) // clz pc, r1
	Clz(a, COND_AL, SP, R1) // clz sp, r1
	Clz(a, COND_AL, R0, PC) // clz r0, pc
	Clz(a, COND_AL, R0, SP) // clz r0, sp

	var want @[]uint32 = make_slice(uint32, 151)
	want[0] = 0xE6AF0071
	want[1] = 0xE6AFD071
	want[2] = 0xE6AF007D
	want[3] = 0xE6BF0071
	want[4] = 0xE6BFD071
