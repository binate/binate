package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// bitsRejected reports whether a holds an error and no bytes.
func bitsRejected(a @asm.Assembler) bool { return a.HasError && a.Sections[0].Len == 0 }

// The extends, bitfields, reverses and CLZ refuse what clang does -- PC where it rejects it, a
// rotation other than 0, 8, 16 or 24, a bitfield lsb or width outside its range -- and what has no
// encoding: an extend operation outside EXT_SXTB16 .. EXT_UXTH, a register outside R0..R15, a
// condition past COND_AL; nothing is emitted.
func TestBitsRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Extend(a, COND_AL, EXT_SXTB, PC, R1, 0)
	if !bitsRejected(a) { return fail("SXTB Rd PC accepted") }
	a = newAsm()
	Extend(a, COND_AL, EXT_UXTH, R0, PC, 0)
	if !bitsRejected(a) { return fail("UXTH Rm PC accepted") }
	a = newAsm()
	Extend(a, COND_AL, EXT_SXTB, R0, R1, 4)
	if !bitsRejected(a) { return fail("SXTB ROR #4 accepted") }
	a = newAsm()
	Extend(a, COND_AL, EXT_SXTB, R0, R1, 32)
	if !bitsRejected(a) { return fail("SXTB ROR #32 accepted") }
	a = newAsm()
	Extend(a, COND_AL, 1, R0, R1, 0)
	if !bitsRejected(a) { return fail("an extend operation 1 accepted") }
	a = newAsm()
	Extend(a, COND_AL, 8, R0, R1, 0)
	if !bitsRejected(a) { return fail("an extend operation 8 accepted") }
	a = newAsm()
	ExtendAdd(a, COND_AL, EXT_SXTB, R0, R1, PC, 0)
	if !bitsRejected(a) { return fail("SXTAB Rm PC accepted") }
	a = newAsm()
	ExtendAdd(a, COND_AL, EXT_UXTB16, PC, R1, R2, 0)
	if !bitsRejected(a) { return fail("UXTAB16 Rd PC accepted") }
	a = newAsm()
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, 16, R2, 0)
	if !bitsRejected(a) { return fail("SXTAH Rn 16 accepted") }
	a = newAsm()
	ExtendAdd(a, COND_AL, EXT_SXTH, R0, R1, R2, 12)
	if !bitsRejected(a) { return fail("SXTAH ROR #12 accepted") }
	a = newAsm()
	Bfc(a, COND_AL, R0, 32, 1)
	if !bitsRejected(a) { return fail("BFC lsb 32 accepted") }
	a = newAsm()
	Bfc(a, COND_AL, R0, -1, 1)
	if !bitsRejected(a) { return fail("BFC lsb -1 accepted") }
	a = newAsm()
	Bfc(a, COND_AL, R0, 8, 0)
	if !bitsRejected(a) { return fail("BFC width 0 accepted") }
	a = newAsm()
	Bfc(a, COND_AL, R0, 8, 25)
	if !bitsRejected(a) { return fail("BFC past bit 31 accepted") }
	a = newAsm()
	Bfi(a, COND_AL, PC, R1, 8, 8)
	if !bitsRejected(a) { return fail("BFI Rd PC accepted") }
	a = newAsm()
	Bfi(a, COND_AL, R0, -1, 8, 8)
	if !bitsRejected(a) { return fail("BFI Rn -1 accepted") }
	a = newAsm()
	Bfi(a, COND_AL, R0, R1, 0, 33)
	if !bitsRejected(a) { return fail("BFI width 33 accepted") }
	a = newAsm()
	Sbfx(a, COND_AL, PC, R1, 8, 8)
	if !bitsRejected(a) { return fail("SBFX Rd PC accepted") }
	a = newAsm()
	Ubfx(a, COND_AL, R0, PC, 8, 8)
	if !bitsRejected(a) { return fail("UBFX Rn PC accepted") }
	a = newAsm()
	Sbfx(a, COND_AL, R0, R1, 32, 1)
	if !bitsRejected(a) { return fail("SBFX lsb 32 accepted") }
	a = newAsm()
	Ubfx(a, COND_AL, R0, R1, 0, 0)
	if !bitsRejected(a) { return fail("UBFX width 0 accepted") }
	a = newAsm()
	Ubfx(a, COND_AL, R0, R1, 0, 33)
	if !bitsRejected(a) { return fail("UBFX width 33 accepted") }
	a = newAsm()
	Sbfx(a, COND_AL, R0, R1, 16, 17)
	if !bitsRejected(a) { return fail("SBFX past bit 31 accepted") }
	a = newAsm()
	Rev(a, COND_AL, 16, R1)
	if !bitsRejected(a) { return fail("REV Rd 16 accepted") }
	a = newAsm()
	Rbit(a, COND_AL, R0, -1)
	if !bitsRejected(a) { return fail("RBIT Rm -1 accepted") }
	a = newAsm()
	Clz(a, 15, R0, R1)
	if !bitsRejected(a) { return fail("CLZ under condition 15 accepted") }
	a = newAsm()
	Uxtb(a, -1, R0, R1)
	if !bitsRejected(a) { return fail("UXTB under condition -1 accepted") }
	return ""
}

func TestClz() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// CLZ R0, R1
	// cond=1110 | 0001 0110 | 1111 | Rd=0000 | 1111 | 0001 | Rm=0001
	// = 0xE16F0F11
	Clz(a, COND_AL, R0, R1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE16F0F11 {
		return fail("CLZ R0, R1 encoding wrong")
	}
	return ""
}

func TestSxtb() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SXTB R0, R1
	// cond=1110 | 0110 1010 | 1111 | Rd=0000 | rot=00 00 | 0111 | Rm=0001
	// = 0xE6AF0071
	Sxtb(a, COND_AL, R0, R1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE6AF0071 {
		return fail("SXTB R0, R1 encoding wrong")
	}
	return ""
}

func TestSxth() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SXTH R0, R1
	// cond=1110 | 0110 1011 | 1111 | Rd=0000 | 0000 | 0111 | Rm=0001
	// = 0xE6BF0071
	Sxth(a, COND_AL, R0, R1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE6BF0071 {
		return fail("SXTH R0, R1 encoding wrong")
	}
	return ""
}

func TestUxtb() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// UXTB R0, R1
	// cond=1110 | 0110 1110 | 1111 | Rd=0000 | 0000 | 0111 | Rm=0001
	// = 0xE6EF0071
	Uxtb(a, COND_AL, R0, R1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE6EF0071 {
		return fail("UXTB R0, R1 encoding wrong")
	}
	return ""
}

func TestUxth() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// UXTH R0, R1
	// cond=1110 | 0110 1111 | 1111 | Rd=0000 | 0000 | 0111 | Rm=0001
	// = 0xE6FF0071
	Uxth(a, COND_AL, R0, R1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE6FF0071 {
		return fail("UXTH R0, R1 encoding wrong")
	}
	return ""
}

// Rd/Rm field placement: UXTB R2, R3 exercises non-zero Rd and Rm.
func TestUxtbRegFields() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// UXTB R2, R3 = 0xE6EF0070 | (2<<12) | 3 = 0xE6EF2073
	Uxtb(a, COND_AL, R2, R3)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE6EF2073 {
		return fail("UXTB R2, R3 field placement wrong")
	}
	return ""
}

// Extends carry a condition code like other data-processing ops:
// SXTHEQ R0, R1 uses cond=EQ (0000) -> 0x06BF0071.
func TestSxthConditional() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Sxth(a, COND_EQ, R0, R1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x06BF0071 {
		return fail("SXTHEQ R0, R1 encoding wrong")
	}
	return ""
}
