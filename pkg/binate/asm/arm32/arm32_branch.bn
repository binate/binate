package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// --- Branches ---
// B:  cond[31:28] | 1010 | imm24[23:0]
// BL: cond[31:28] | 1011 | imm24[23:0]
// Offset is PC-relative, divided by 4. The PC is 8 bytes ahead
// (two instructions) due to the ARM pipeline.

func B(a @asm.Assembler, cond int, label *[]readonly char) {
	BAddend(a, cond, false, label, 0)
}

// Bl emits `BL{cond} label` — branch with link (call). The return
// address (PC of the next instruction) is written to LR, then PC is
// updated to label. cond is a 4-bit condition code (always = AL).
func Bl(a @asm.Assembler, cond int, label *[]readonly char) {
	BAddend(a, cond, true, label, 0)
}

// BAddend emits `B{cond}` (`BL{cond}` when link) to label plus addend bytes (`b lbl+4`):
// the FIX_BRANCH24 fixup carries the addend.  cond is 0..14 (COND_EQ..COND_AL): with 15
// the word would be BLX (immediate), a switch to Thumb, not a branch — an error that emits
// nothing.
func BAddend(a @asm.Assembler, cond int, link bool, label *[]readonly char, addend int64) {
	if cond < 0 || cond > 14 {
		a.SetError("arm32: a branch condition is 0..14 (15 would be BLX)")
		return
	}
	a.AddFixup(label, FIX_BRANCH24, addend, 4)
	var inst uint32 = condBits(cond) | 0x0A000000
	if link { inst = condBits(cond) | 0x0B000000 }
	emit32(a, inst)
}

// BOffset emits `B{cond}` (`BL{cond}` when link) to the address offset bytes from this
// instruction, encoding the displacement directly: imm24 is (offset - 8) / 4, as the PC
// reads two instructions ahead.  offset must be word-aligned and the displacement must fit
// the signed 24 bits (±32 MiB); cond is 0..14 (15 would encode BLX).  Any violation is an
// error that emits nothing.
func BOffset(a @asm.Assembler, cond int, link bool, offset int) {
	if cond < 0 || cond > 14 {
		a.SetError("arm32: a branch condition is 0..14 (15 would be BLX)")
		return
	}
	if offset % 4 != 0 {
		a.SetError("arm32: a branch offset must be a multiple of 4")
		return
	}
	var disp int = (offset - 8) / 4
	if disp < -(1 << 23) || disp >= (1 << 23) {
		a.SetError("arm32: a branch offset must be within +/-32 MiB")
		return
	}
	var inst uint32 = condBits(cond) | 0x0A000000
	if link { inst = condBits(cond) | 0x0B000000 }
	inst = inst | (cast(uint32, disp) & 0x00FFFFFF)
	emit32(a, inst)
}

// BX:  cond[31:28] | 0001 0010 | 1111 1111 1111 | 0001 | Rm[3:0]
func Bx(a @asm.Assembler, cond int, rm int) {
	var inst uint32 = condBits(cond) | 0x012FFF10
	inst = inst | cast(uint32, rm & 0xf)
	emit32(a, inst)
}

// BLX (register): cond[31:28] | 0001 0010 | 1111 1111 1111 | 0011 | Rm[3:0]
func Blx(a @asm.Assembler, cond int, rm int) {
	var inst uint32 = condBits(cond) | 0x012FFF30
	inst = inst | cast(uint32, rm & 0xf)
	emit32(a, inst)
}

// --- Miscellaneous ---

// CLZ: cond[31:28] | 0001 0110 | 1111[19:16] | Rd[15:12]
//      | 1111[11:8] | 0001 | Rm[3:0]
func Clz(a @asm.Assembler, cond int, rd int, rm int) {
	var inst uint32 = condBits(cond) | 0x016F0F10
	inst = inst | (cast(uint32, rd & 0xf) << 12)
	inst = inst | cast(uint32, rm & 0xf)
	emit32(a, inst)
}

// --- Sign/zero extend (ARMv6+) ---
// Extend-only (no add) form: Rn field = 1111, rotation = 0.
// Encoding: cond[31:28] | 0110 1MB0 | 1111[19:16] | Rd[15:12]
//           | rot[11:10] 00 | 0111 | Rm[3:0]
// The M/B bits (23/22) select signed/unsigned and byte/halfword:
//   SXTB = 0110 1010 (0x06A.....)   UXTB = 0110 1110 (0x06E.....)
//   SXTH = 0110 1011 (0x06B.....)   UXTH = 0110 1111 (0x06F.....)
// with 1111 in [19:16] and 0111 in [7:4] and rotation 0.  These base
// constants match the ARM ARM (ARMv7-A) SXTB/SXTH/UXTB/UXTH A1 encodings.

// extEnc encodes an extend instruction (Rd, Rm; rotation 0) from its
// cond-less base word (the value for cond=0, e.g. 0x06AF0070 for SXTB).
func extEnc(cond int, base uint32, rd int, rm int) uint32 {
	var inst uint32 = condBits(cond) | base
	inst = inst | (cast(uint32, rd & 0xf) << 12)
	inst = inst | cast(uint32, rm & 0xf)
	return inst
}

// Sxtb emits `SXTB{cond} Rd, Rm` — sign-extend Rm[7:0] to 32 bits into Rd.
func Sxtb(a @asm.Assembler, cond int, rd int, rm int) {
	emit32(a, extEnc(cond, 0x06AF0070, rd, rm))
}

// Sxth emits `SXTH{cond} Rd, Rm` — sign-extend Rm[15:0] to 32 bits into Rd.
func Sxth(a @asm.Assembler, cond int, rd int, rm int) {
	emit32(a, extEnc(cond, 0x06BF0070, rd, rm))
}

// Uxtb emits `UXTB{cond} Rd, Rm` — zero-extend Rm[7:0] to 32 bits into Rd.
func Uxtb(a @asm.Assembler, cond int, rd int, rm int) {
	emit32(a, extEnc(cond, 0x06EF0070, rd, rm))
}

// Uxth emits `UXTH{cond} Rd, Rm` — zero-extend Rm[15:0] to 32 bits into Rd.
func Uxth(a @asm.Assembler, cond int, rd int, rm int) {
	emit32(a, extEnc(cond, 0x06FF0070, rd, rm))
}
