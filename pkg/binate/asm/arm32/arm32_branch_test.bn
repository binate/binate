package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// --- B / BL ---

func TestBLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// B label (AL) — emits placeholder with fixup
	// cond=1110 | 1010 | imm24=0
	// = 0xEA000000
	B(a, COND_AL, "target")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEA000000 {
		return fail("B target placeholder wrong")
	}
	return ""
}

func TestBlLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BL label (AL)
	// cond=1110 | 1011 | imm24=0
	// = 0xEB000000
	Bl(a, COND_AL, "target")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEB000000 {
		return fail("BL target placeholder wrong")
	}
	return ""
}

func TestBCondLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BEQ label (cond=0000)
	// = 0x0A000000
	B(a, COND_EQ, "target")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0x0A000000 {
		return fail("BEQ target placeholder wrong")
	}
	return ""
}

// --- BX / BLX ---

func TestBxReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BX LR (return from function)
	// cond=1110 | 0001 0010 1111 1111 1111 0001 | Rm=1110(LR)
	// = 0xE12FFF1E
	Bx(a, COND_AL, LR)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE12FFF1E {
		return fail("BX LR encoding wrong")
	}
	return ""
}

func TestBlxReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BLX R3
	// = 0xE12FFF33
	Blx(a, COND_AL, R3)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE12FFF33 {
		return fail("BLX R3 encoding wrong")
	}
	return ""
}

// --- Branch fixup resolution ---

func TestBranchForwardFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// B .target ; offset = target - fixup - 8, then /4
	// fixup at 0, target at 12 -> offset = 12 - 0 - 8 = 4 -> 4/4 = 1
	B(a, COND_AL, "target")
	Nop(a, COND_AL) // offset 4
	Nop(a, COND_AL) // offset 8
	a.DefineLabel("target")
	Nop(a, COND_AL) // offset 12

	var ok bool = ResolveFixups(a)
	if !ok {
		return fail("forward fixup resolution failed")
	}
	var inst uint32 = readInst(a.Sections[0], 0)
	// Expected: 0xEA000001 (branch forward 1 word past PC+8)
	if inst != 0xEA000001 {
		return fail("B forward fixup encoding wrong")
	}
	return ""
}

func TestBranchBackwardFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// target:
	//   NOP          ; offset 0
	//   B target     ; offset 4, target at 0
	// offset = 0 - 4 - 8 = -12 -> -12/4 = -3
	a.DefineLabel("target")
	Nop(a, COND_AL) // offset 0
	B(a, COND_AL, "target") // offset 4

	var ok bool = ResolveFixups(a)
	if !ok {
		return fail("backward fixup resolution failed")
	}
	var inst uint32 = readInst(a.Sections[0], 4)
	// Expected: 0xEAFFFFFD (-3 in 24-bit signed = 0xFFFFFD)
	if inst != 0xEAFFFFFD {
		return fail("B backward fixup encoding wrong")
	}
	return ""
}

// A BL to a label in its own section stays a relocation, as clang leaves it (the linker knows
// whether the target is Thumb code): the -8 baked in (0xEBFFFFFE), the fixup unresolved.
func TestBlLocalStaysRelocation() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bl(a, COND_AL, "target")
	Nop(a, COND_AL)
	a.DefineLabel("target")
	Nop(a, COND_AL)
	if !ResolveFixups(a) { return fail("BL fixup resolution failed") }
	if readInst(a.Sections[0], 0) != 0xEBFFFFFE {
		return fail("BL to a local label is not 0xEBFFFFFE")
	}
	if a.Sections[0].Fixups[0].Kind != FIX_BRANCH24 { return fail("BL to a local label resolved") }
	return ""
}

// A kept fixup (asm.Fixup.Keep, a `sym(PLT)` target) stays a relocation where a B to a local
// label is resolved: the -8 baked in (0xEAFFFFFE), where the next B's is 12 bytes back from PC
// (0xEAFFFFFD).
func TestKeptBranchStaysRelocation() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.DefineLabel("target")
	B(a, COND_AL, "target")
	B(a, COND_AL, "target")
	a.KeepFixup(0, 0)
	if !ResolveFixups(a) { return fail("fixup resolution failed") }
	if readInst(a.Sections[0], 0) != 0xEAFFFFFE || a.Sections[0].Fixups[0].Kind != FIX_BRANCH24 {
		return fail("a kept B resolved")
	}
	if readInst(a.Sections[0], 4) != 0xEAFFFFFD || a.Sections[0].Fixups[1].Kind != -1 {
		return fail("a B to a local label not resolved")
	}
	return ""
}

// --- BLX (immediate) / BXJ ---

// BlxLabel emits 0xFA000000 with a FIX_BRANCH24 fixup that stays a relocation, even to a label
// in its own section, the addend baked in with H clear (0xFAFFFFFE; `+12` 0xFA000001); an
// addend that is not a multiple of 4 has no such field, an error.
func TestBlxLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.DefineLabel("f")
	BlxLabel(a, "f", 0)
	BlxLabel(a, "ext", 12)
	if a.Sections[0].NumFixups != 2 || a.Sections[0].Fixups[0].Kind != FIX_BRANCH24 {
		return fail("BLX recorded no FIX_BRANCH24 fixup")
	}
	if readInst(a.Sections[0], 0) != 0xFA000000 { return fail("BLX placeholder wrong") }
	if !ResolveFixups(a) { return fail("BLX fixup resolution failed") }
	if readInst(a.Sections[0], 0) != 0xFAFFFFFE || a.Sections[0].Fixups[0].Kind != FIX_BRANCH24 {
		return fail("BLX to a local label is not a relocation, 0xFAFFFFFE")
	}
	if readInst(a.Sections[0], 4) != 0xFA000001 { return fail("BLX ext+12 is not 0xFA000001") }
	var b @asm.Assembler = newAsm()
	BlxLabel(b, "ext", 2)
	if ResolveFixups(b) || !b.HasError { return fail("a BLX addend of 2 taken") }
	return ""
}

// BlxOffset encodes imm24:H directly, as clang does a number (`blx #N` is offset N + 8): N 4 is
// 0xFA000001, 6 0xFB000001, -6 0xFBFFFFFE, 0x1FFFFFE 0xFB7FFFFF and -0x2000000 0xFA800000; an
// odd offset or one past +/-32 MiB is an error that emits nothing.  None records a fixup.
func TestBlxOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BlxOffset(a, 12)
	BlxOffset(a, 14)
	BlxOffset(a, 2)
	BlxOffset(a, 0x1FFFFFE + 8)
	BlxOffset(a, -0x2000000 + 8)
	if a.HasError || a.Sections[0].NumFixups != 0 { return fail("BlxOffset must encode these") }
	var want @[]uint32 = make_slice(uint32, 5)
	want[0] = 0xFA000001
	want[1] = 0xFB000001
	want[2] = 0xFBFFFFFE
	want[3] = 0xFB7FFFFF
	want[4] = 0xFA800000
	for i := 0; i < 5; i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] { return fail("BlxOffset word wrong") }
	}
	var b @asm.Assembler = newAsm()
	BlxOffset(b, 11)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("an odd BLX offset must fail loud") }
	var c @asm.Assembler = newAsm()
	BlxOffset(c, 0x2000000 + 8)
	if !c.HasError || c.Sections[0].Len != 0 {
		return fail("an out-of-range BLX offset must fail loud")
	}
	var d @asm.Assembler = newAsm()
	BlxOffset(d, -0x2000002 + 8)
	if !d.HasError || d.Sections[0].Len != 0 {
		return fail("an out-of-range BLX offset must fail loud")
	}
	return ""
}

// BXJ Rm: cond | 0001 0010 1111 1111 1111 0010 | Rm, PC included; a bad register or condition
// is an error that emits nothing.
func TestBxj() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bxj(a, COND_AL, R1)
	Bxj(a, COND_EQ, PC)
	if a.HasError { return fail("BXJ rejected") }
	if readInst(a.Sections[0], 0) != 0xE12FFF21 { return fail("bxj r1 is not 0xE12FFF21") }
	if readInst(a.Sections[0], 4) != 0x012FFF2F { return fail("bxjeq pc is not 0x012FFF2F") }
	var b @asm.Assembler = newAsm()
	Bxj(b, COND_AL, 16)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("BXJ of register 16 must fail loud") }
	var c @asm.Assembler = newAsm()
	Bxj(c, 15, R1)
	if !c.HasError || c.Sections[0].Len != 0 { return fail("BXJ with condition 15 must fail loud") }
	return ""
}

// A branch to a symbol NOT defined in this section becomes a REL relocation.
// ResolveFixups bakes the -8 ARM pipeline bias into the imm24 field in place
// (bakeRelAddend → patchBranch24), so the instruction reads 0xEBFFFFFE
// (imm = #-0x8), matching clang's REL form.  GNU bfd (ARM is REL-only, no
// r_addend) then computes S - 8 - P from the field; without this bake the
// addend is dropped and every cross-object call overshoots the callee by 8.
func TestBlCrossObjectBakesMinus8() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bl(a, COND_AL, "extern_func") // never DefineLabel'd here → cross-object
	var ok bool = ResolveFixups(a)
	if !ok {
		return fail("cross-object fixup baking failed")
	}
	var inst uint32 = readInst(a.Sections[0], 0)
	// 0xEB (BL, AL) | imm24 = 0xFFFFFE (-2 words = -8 bytes)
	if inst != 0xEBFFFFFE {
		return fail("cross-object BL must bake imm24=0xfffffe (-8)")
	}
	return ""
}

// A generic word-absolute (kind 0) data relocation — how the shared
// data-global emitter lays a `&sym + off` pointer (e.g. a reflect-descriptor
// payload at sym+8) — must ALSO bake its addend into the data word under REL,
// or bfd (which drops r_addend for ARM) links the pointer to the symbol base
// instead of base+off, corrupting reflection/vtables.  ResolveFixups routes
// kind 0 through bakeRelAddend exactly like FIX_ABS32.
func TestKind0AbsBakesAddend() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.AddFixup("gvar", 0, 16, 4) // kind-0 word-absolute to gvar+16
	a.Fill(4, cast(uint8, 0)) // zeroed placeholder word
	if !ResolveFixups(a) {
		return fail("kind-0 addend baking failed")
	}
	// Under REL the addend rides the field; bfd then computes S + 16.
	if readInst(a.Sections[0], 0) != 16 {
		return fail("kind-0 ABS32 must bake the addend (16) into the field")
	}
	return ""
}

// --- BOffset ---

// BOffset encodes the displacement directly: `b .` (offset 0) is imm24 -2, the classic
// 0xEAFFFFFE; a branch 16 bytes back under PL is imm24 -6 with cond 0101; 8 bytes ahead
// is imm24 0; BL sets the link bit.  None records a fixup.
func TestBOffsetEncodes() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BOffset(a, COND_AL, false, 0)
	BOffset(a, COND_PL, false, -16)
	BOffset(a, COND_AL, false, 8)
	BOffset(a, COND_AL, true, 12)
	if a.HasError { return fail("BOffset must encode these offsets") }
	if readInst(a.Sections[0], 0) != 0xEAFFFFFE { return fail("b . must be 0xEAFFFFFE") }
	if readInst(a.Sections[0], 4) != 0x5AFFFFFA { return fail("bpl -16 must be 0x5AFFFFFA") }
	if readInst(a.Sections[0], 8) != 0xEA000000 { return fail("b +8 must be 0xEA000000") }
	if readInst(a.Sections[0], 12) != 0xEB000001 { return fail("bl +12 must be 0xEB000001") }
	if a.Sections[0].NumFixups != 0 { return fail("BOffset records no fixup") }
	return ""
}

// A misaligned or out-of-range offset, or condition 15, is an error that emits nothing.
func TestBOffsetRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BOffset(a, COND_AL, false, 6)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("a misaligned offset must fail loud") }
	var b @asm.Assembler = newAsm()
	BOffset(b, COND_AL, false, 1 << 26)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("an out-of-range offset must fail loud") }
	var c @asm.Assembler = newAsm()
	BOffset(c, 15, false, 0)
	if !c.HasError || c.Sections[0].Len != 0 { return fail("condition 15 must fail loud") }
	return ""
}
