package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The exclusive loads and stores, the load-acquires and store-releases, SWP / SWPB and CLREX,
// exact (arm32.bni):
//
//	load:  cond | 0001 1 size[22:21] 1 | Rn | Rt | 11 ord[9:8] | 1001 | 1111
//	store: cond | 0001 1 size[22:21] 0 | Rn | Rd | 11 ord[9:8] | 1001 | Rt
//
// with size EX_WORD / EX_DOUBLE / EX_BYTE / EX_HALF and ord 11 for LDREX / STREX, 10 for LDAEX /
// STLEX, 00 for LDA / STL (whose Rd field is 1111).  clang takes any register in them -- PC, SP,
// a status register Rd equal to Rt or Rn -- but a doubleword's Rt must be even and below R14.

// exclSizeOk reports whether size is an access size (EX_WORD .. EX_HALF), and not EX_DOUBLE where
// noDouble, setting the assembler error if not.
func exclSizeOk(a @asm.Assembler, size int, noDouble bool) bool {
	if size == EX_WORD || size == EX_BYTE || size == EX_HALF || size == EX_DOUBLE && !noDouble {
		return true
	}
	a.SetError("arm32: an exclusive / acquire-release access size out of range")
	return false
}

// exclPairOk reports whether rt starts a doubleword's register pair -- even and below R14 --
// setting clang's error (load: "destination ...", else "source ...") if not.
func exclPairOk(a @asm.Assembler, load bool, rt int) bool {
	if rt % 2 != 0 {
		if load {
			a.SetError("destination operands must start at an even register")
		} else {
			a.SetError("source operands must start at an even register")
		}
		return false
	}
	if rt == LR {
		a.SetError("arm32: a doubleword exclusive takes an even Rt below R14")
		return false
	}
	return true
}

// exclLoad emits the load base | size | ord of Rt from [Rn].
func exclLoad(a @asm.Assembler, cond int, size int, ord uint32, rt int, rn int) {
	if !condOk(a, cond) || !regOk(a, rt, false) || !regOk(a, rn, false) { return }
	if size == EX_DOUBLE && !exclPairOk(a, true, rt) { return }
	emit32(a,
			condBits(cond) | 0x01900C9F | (cast(uint32, size) << 21) | (ord << 8) |
					(cast(uint32, rn) << 16) | (cast(uint32, rt) << 12))
}

// exclStore emits the store base | size | ord of Rt to [Rn], with the status register Rd.
func exclStore(a @asm.Assembler, cond int, size int, ord uint32, rd int, rt int, rn int) {
	if !condOk(a, cond) || !regOk(a, rd, false) || !regOk(a, rt, false) || !regOk(a, rn, false) {
		return
	}
	if size == EX_DOUBLE && !exclPairOk(a, false, rt) { return }
	emit32(a,
			condBits(cond) | 0x01800C90 | (cast(uint32, size) << 21) | (ord << 8) |
					(cast(uint32, rn) << 16) | (cast(uint32, rd) << 12) | cast(uint32, rt))
}

// Ldrex emits LDREX{B,H,D} Rt, [Rn], or with acquire LDAEX{B,H,D}.
func Ldrex(a @asm.Assembler, cond int, size int, acquire bool, rt int, rn int) {
	if !exclSizeOk(a, size, false) { return }
	var ord uint32 = 3
	if acquire { ord = 2 }
	exclLoad(a, cond, size, ord, rt, rn)
}

// Strex emits STREX{B,H,D} Rd, Rt, [Rn], or with release STLEX{B,H,D}.
func Strex(a @asm.Assembler, cond int, size int, release bool, rd int, rt int, rn int) {
	if !exclSizeOk(a, size, false) { return }
	var ord uint32 = 3
	if release { ord = 2 }
	exclStore(a, cond, size, ord, rd, rt, rn)
}

// Lda emits LDA{B,H} Rt, [Rn].
func Lda(a @asm.Assembler, cond int, size int, rt int, rn int) {
	if exclSizeOk(a, size, true) { exclLoad(a, cond, size, 0, rt, rn) }
}

// Stl emits STL{B,H} Rt, [Rn].
func Stl(a @asm.Assembler, cond int, size int, rt int, rn int) {
	if exclSizeOk(a, size, true) { exclStore(a, cond, size, 0, PC, rt, rn) }
}

// Swp emits SWP{B} Rt, Rt2, [Rn] (byte when byteOp): Rt and Rt2 not PC, as clang has it.
func Swp(a @asm.Assembler, cond int, byteOp bool, rt int, rt2 int, rn int) {
	if !condOk(a, cond) || !regOk(a, rt, true) || !regOk(a, rt2, true) || !regOk(a, rn, false) {
		return
	}
	var inst uint32 = condBits(cond) | 0x01000090 | (cast(uint32, rn) << 16) |
			(cast(uint32, rt) << 12) | cast(uint32, rt2)
	if byteOp { inst = inst | (1 << 22) }
	emit32(a, inst)
}

// Clrex emits CLREX (unconditional).
func Clrex(a @asm.Assembler) { emit32(a, 0xF57FF01F) }
