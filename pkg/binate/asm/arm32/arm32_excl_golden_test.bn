	want[150] = 0xE1A45E92
	want[151] = 0xE1AF5E92
	want[152] = 0xE1A55E92
	want[153] = 0xF57FF01F

	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] {
			return fail("an exclusive, acquire / release, SWP or CLREX encoded unlike clang")
		}
	}
	return ""
}
