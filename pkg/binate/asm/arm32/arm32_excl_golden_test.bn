	Strex(a, COND_AL, EX_HALF, true, R0, R2, PC) // stlexh r0, r2, [pc]
	Strex(a, COND_AL, EX_HALF, true, R0, R2, SP) // stlexh r0, r2, [sp]
	Strex(a, COND_AL, EX_HALF, true, R0, R2, R2) // stlexh r0, r2, [r2]
	Strex(a, COND_AL, EX_HALF, true, R0, R2, R0) // stlexh r0, r2, [r0]
	Strex(a, COND_AL, EX_HALF, true, R0, R0, R1) // stlexh r0, r0, [r1]
	Ldrex(a, COND_AL, EX_DOUBLE, true, R0, R4) // ldaexd r0, r1, [r4]
	Ldrex(a, COND_AL, EX_DOUBLE, true, R0, PC) // ldaexd r0, r1, [pc]
	Ldrex(a, COND_AL, EX_DOUBLE, true, R0, SP) // ldaexd r0, r1, [sp]
