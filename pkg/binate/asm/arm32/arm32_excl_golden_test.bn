package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The exclusives, load-acquires and store-releases, SWP / SWPB and CLREX against clang's words
// (Apple clang 21, armv7ve, and armv8-a for the acquire / release forms): each size and ordering,
// PC and SP in each register clang takes them in (a status register equal to Rt or Rn too), a
// doubleword's register pairs, R12 with SP included, and a condition.
func TestExclGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrex(a, COND_AL, EX_WORD, false, R0, R1) // ldrex r0, [r1]
	Ldrex(a, COND_AL, EX_WORD, false, R0, SP) // ldrex r0, [sp]
	Ldrex(a, COND_AL, EX_WORD, false, R0, PC) // ldrex r0, [pc]
	Ldrex(a, COND_AL, EX_WORD, false, R0, R0) // ldrex r0, [r0]
	Ldrex(a, COND_AL, EX_WORD, false, SP, R1) // ldrex sp, [r1]
	Ldrex(a, COND_AL, EX_WORD, false, SP, SP) // ldrex sp, [sp]
	Ldrex(a, COND_EQ, EX_WORD, false, R0, R1) // ldrexeq r0, [r1]
	Ldrex(a, COND_AL, EX_BYTE, false, R0, R1) // ldrexb r0, [r1]
	Ldrex(a, COND_AL, EX_BYTE, false, R0, SP) // ldrexb r0, [sp]
	Ldrex(a, COND_AL, EX_BYTE, false, R0, PC) // ldrexb r0, [pc]
	Ldrex(a, COND_AL, EX_BYTE, false, R0, R0) // ldrexb r0, [r0]
	Ldrex(a, COND_AL, EX_BYTE, false, SP, R1) // ldrexb sp, [r1]
	Ldrex(a, COND_AL, EX_BYTE, false, SP, SP) // ldrexb sp, [sp]
	Ldrex(a, COND_EQ, EX_BYTE, false, R0, R1) // ldrexbeq r0, [r1]
	Ldrex(a, COND_AL, EX_HALF, false, R0, R1) // ldrexh r0, [r1]
	Ldrex(a, COND_AL, EX_HALF, false, R0, SP) // ldrexh r0, [sp]
	Ldrex(a, COND_AL, EX_HALF, false, R0, PC) // ldrexh r0, [pc]
	Ldrex(a, COND_AL, EX_HALF, false, R0, R0) // ldrexh r0, [r0]
	Ldrex(a, COND_AL, EX_HALF, false, SP, R1) // ldrexh sp, [r1]
	Ldrex(a, COND_AL, EX_HALF, false, SP, SP) // ldrexh sp, [sp]
	Strex(a, COND_AL, EX_WORD, false, R0, R2, R1) // strex r0, r2, [r1]
	Strex(a, COND_AL, EX_WORD, false, R0, R2, PC) // strex r0, r2, [pc]
	Strex(a, COND_AL, EX_WORD, false, R0, R2, SP) // strex r0, r2, [sp]
	Strex(a, COND_AL, EX_WORD, false, R0, R2, R2) // strex r0, r2, [r2]
	Strex(a, COND_AL, EX_WORD, false, R0, R2, R0) // strex r0, r2, [r0]
	Strex(a, COND_AL, EX_WORD, false, R0, R0, R1) // strex r0, r0, [r1]
	Strex(a, COND_EQ, EX_WORD, false, R0, R2, R1) // strexeq r0, r2, [r1]
	Strex(a, COND_AL, EX_BYTE, false, R0, R2, R1) // strexb r0, r2, [r1]
	Strex(a, COND_AL, EX_BYTE, false, R0, R2, PC) // strexb r0, r2, [pc]
	Strex(a, COND_AL, EX_BYTE, false, R0, R2, SP) // strexb r0, r2, [sp]
	Strex(a, COND_AL, EX_BYTE, false, R0, R2, R2) // strexb r0, r2, [r2]
	Strex(a, COND_AL, EX_BYTE, false, R0, R2, R0) // strexb r0, r2, [r0]
	Strex(a, COND_AL, EX_BYTE, false, R0, R0, R1) // strexb r0, r0, [r1]
	Strex(a, COND_AL, EX_HALF, false, R0, R2, R1) // strexh r0, r2, [r1]
	Strex(a, COND_AL, EX_HALF, false, R0, R2, PC) // strexh r0, r2, [pc]
	Strex(a, COND_AL, EX_HALF, false, R0, R2, SP) // strexh r0, r2, [sp]
	Strex(a, COND_AL, EX_HALF, false, R0, R2, R2) // strexh r0, r2, [r2]
	Strex(a, COND_AL, EX_HALF, false, R0, R2, R0) // strexh r0, r2, [r0]
	Strex(a, COND_AL, EX_HALF, false, R0, R0, R1) // strexh r0, r0, [r1]
	Swp(a, COND_AL, false, R0, R2, R1) // swp r0, r2, [r1]
	Swp(a, COND_AL, false, R0, R2, PC) // swp r0, r2, [pc]
	Swp(a, COND_AL, false, R0, R2, SP) // swp r0, r2, [sp]
	Swp(a, COND_AL, false, R0, R2, R2) // swp r0, r2, [r2]
	Swp(a, COND_AL, false, R0, R2, R0) // swp r0, r2, [r0]
	Swp(a, COND_AL, false, R0, R0, R1) // swp r0, r0, [r1]
	Swp(a, COND_EQ, false, R0, R2, R1) // swpeq r0, r2, [r1]
	Swp(a, COND_AL, true, R0, R2, R1) // swpb r0, r2, [r1]
	Swp(a, COND_AL, true, R0, R2, PC) // swpb r0, r2, [pc]
	Swp(a, COND_AL, true, R0, R2, SP) // swpb r0, r2, [sp]
	Swp(a, COND_AL, true, R0, R2, R2) // swpb r0, r2, [r2]
	Swp(a, COND_AL, true, R0, R2, R0) // swpb r0, r2, [r0]
	Swp(a, COND_AL, true, R0, R0, R1) // swpb r0, r0, [r1]
	Swp(a, COND_EQ, true, R0, R1, R2) // swpbeq r0, r1, [r2]
	Ldrex(a, COND_AL, EX_DOUBLE, false, R0, R4) // ldrexd r0, r1, [r4]
	Ldrex(a, COND_AL, EX_DOUBLE, false, R0, PC) // ldrexd r0, r1, [pc]
	Ldrex(a, COND_AL, EX_DOUBLE, false, R0, SP) // ldrexd r0, r1, [sp]
	Ldrex(a, COND_AL, EX_DOUBLE, false, R0, R0) // ldrexd r0, r1, [r0]
	Ldrex(a, COND_AL, EX_DOUBLE, false, R0, R1) // ldrexd r0, r1, [r1]
	Ldrex(a, COND_AL, EX_DOUBLE, false, R2, R4) // ldrexd r2, r3, [r4]
	Ldrex(a, COND_EQ, EX_DOUBLE, false, R0, R1) // ldrexdeq r0, r1, [r1]
	Strex(a, COND_AL, EX_DOUBLE, false, R5, R0, R4) // strexd r5, r0, r1, [r4]
	Strex(a, COND_AL, EX_DOUBLE, false, R5, R0, PC) // strexd r5, r0, r1, [pc]
	Strex(a, COND_AL, EX_DOUBLE, false, R5, R0, R5) // strexd r5, r0, r1, [r5]
	Strex(a, COND_AL, EX_DOUBLE, false, R5, R2, R4) // strexd r5, r2, r3, [r4]
	Strex(a, COND_AL, EX_DOUBLE, false, R5, R2, PC) // strexd r5, r2, r3, [pc]
	Strex(a, COND_AL, EX_DOUBLE, false, R5, R2, R5) // strexd r5, r2, r3, [r5]
	Lda(a, COND_AL, EX_WORD, R0, R1) // lda r0, [r1]
	Lda(a, COND_AL, EX_WORD, R0, SP) // lda r0, [sp]
	Lda(a, COND_AL, EX_WORD, R0, PC) // lda r0, [pc]
	Lda(a, COND_AL, EX_WORD, R0, R0) // lda r0, [r0]
	Lda(a, COND_AL, EX_WORD, SP, R1) // lda sp, [r1]
	Lda(a, COND_AL, EX_WORD, SP, SP) // lda sp, [sp]
	Lda(a, COND_EQ, EX_WORD, R0, R1) // ldaeq r0, [r1]
	Lda(a, COND_AL, EX_BYTE, R0, R1) // ldab r0, [r1]
	Lda(a, COND_AL, EX_BYTE, R0, SP) // ldab r0, [sp]
	Lda(a, COND_AL, EX_BYTE, R0, PC) // ldab r0, [pc]
	Lda(a, COND_AL, EX_BYTE, R0, R0) // ldab r0, [r0]
	Lda(a, COND_AL, EX_BYTE, SP, R1) // ldab sp, [r1]
	Lda(a, COND_AL, EX_BYTE, SP, SP) // ldab sp, [sp]
	Lda(a, COND_AL, EX_HALF, R0, R1) // ldah r0, [r1]
	Lda(a, COND_AL, EX_HALF, R0, SP) // ldah r0, [sp]
	Lda(a, COND_AL, EX_HALF, R0, PC) // ldah r0, [pc]
	Lda(a, COND_AL, EX_HALF, R0, R0) // ldah r0, [r0]
	Lda(a, COND_AL, EX_HALF, SP, R1) // ldah sp, [r1]
	Lda(a, COND_AL, EX_HALF, SP, SP) // ldah sp, [sp]
	Ldrex(a, COND_AL, EX_WORD, true, R0, R1) // ldaex r0, [r1]
	Ldrex(a, COND_AL, EX_WORD, true, R0, SP) // ldaex r0, [sp]
	Ldrex(a, COND_AL, EX_WORD, true, R0, PC) // ldaex r0, [pc]
	Ldrex(a, COND_AL, EX_WORD, true, R0, R0) // ldaex r0, [r0]
	Ldrex(a, COND_AL, EX_WORD, true, SP, R1) // ldaex sp, [r1]
	Ldrex(a, COND_AL, EX_WORD, true, SP, SP) // ldaex sp, [sp]
	Ldrex(a, COND_AL, EX_BYTE, true, R0, R1) // ldaexb r0, [r1]
	Ldrex(a, COND_AL, EX_BYTE, true, R0, SP) // ldaexb r0, [sp]
	Ldrex(a, COND_AL, EX_BYTE, true, R0, PC) // ldaexb r0, [pc]
	Ldrex(a, COND_AL, EX_BYTE, true, R0, R0) // ldaexb r0, [r0]
	Ldrex(a, COND_AL, EX_BYTE, true, SP, R1) // ldaexb sp, [r1]
	Ldrex(a, COND_AL, EX_BYTE, true, SP, SP) // ldaexb sp, [sp]
	Ldrex(a, COND_EQ, EX_BYTE, true, R0, R1) // ldaexbeq r0, [r1]
	Ldrex(a, COND_AL, EX_HALF, true, R0, R1) // ldaexh r0, [r1]
	Ldrex(a, COND_AL, EX_HALF, true, R0, SP) // ldaexh r0, [sp]
	Ldrex(a, COND_AL, EX_HALF, true, R0, PC) // ldaexh r0, [pc]
	Ldrex(a, COND_AL, EX_HALF, true, R0, R0) // ldaexh r0, [r0]
	Ldrex(a, COND_AL, EX_HALF, true, SP, R1) // ldaexh sp, [r1]
	Ldrex(a, COND_AL, EX_HALF, true, SP, SP) // ldaexh sp, [sp]
	Stl(a, COND_AL, EX_WORD, R0, R1) // stl r0, [r1]
	Stl(a, COND_AL, EX_WORD, R0, SP) // stl r0, [sp]
	Stl(a, COND_AL, EX_WORD, R0, PC) // stl r0, [pc]
	Stl(a, COND_AL, EX_WORD, R0, R0) // stl r0, [r0]
	Stl(a, COND_AL, EX_WORD, SP, R1) // stl sp, [r1]
	Stl(a, COND_AL, EX_WORD, SP, SP) // stl sp, [sp]
	Stl(a, COND_AL, EX_BYTE, R0, R1) // stlb r0, [r1]
	Stl(a, COND_AL, EX_BYTE, R0, SP) // stlb r0, [sp]
	Stl(a, COND_AL, EX_BYTE, R0, PC) // stlb r0, [pc]
	Stl(a, COND_AL, EX_BYTE, R0, R0) // stlb r0, [r0]
	Stl(a, COND_AL, EX_BYTE, SP, R1) // stlb sp, [r1]
	Stl(a, COND_AL, EX_BYTE, SP, SP) // stlb sp, [sp]
	Stl(a, COND_AL, EX_HALF, R0, R1) // stlh r0, [r1]
	Stl(a, COND_AL, EX_HALF, R0, SP) // stlh r0, [sp]
	Stl(a, COND_AL, EX_HALF, R0, PC) // stlh r0, [pc]
	Stl(a, COND_AL, EX_HALF, R0, R0) // stlh r0, [r0]
	Stl(a, COND_AL, EX_HALF, SP, R1) // stlh sp, [r1]
	Stl(a, COND_AL, EX_HALF, SP, SP) // stlh sp, [sp]
	Strex(a, COND_AL, EX_WORD, true, R0, R2, R1) // stlex r0, r2, [r1]
	Strex(a, COND_AL, EX_WORD, true, R0, R2, PC) // stlex r0, r2, [pc]
	Strex(a, COND_AL, EX_WORD, true, R0, R2, SP) // stlex r0, r2, [sp]
	Strex(a, COND_AL, EX_WORD, true, R0, R2, R2) // stlex r0, r2, [r2]
	Strex(a, COND_AL, EX_WORD, true, R0, R2, R0) // stlex r0, r2, [r0]
	Strex(a, COND_AL, EX_WORD, true, R0, R0, R1) // stlex r0, r0, [r1]
	Strex(a, COND_EQ, EX_WORD, true, R0, R2, R1) // stlexeq r0, r2, [r1]
	Strex(a, COND_AL, EX_BYTE, true, R0, R2, R1) // stlexb r0, r2, [r1]
	Strex(a, COND_AL, EX_BYTE, true, R0, R2, PC) // stlexb r0, r2, [pc]
	Strex(a, COND_AL, EX_BYTE, true, R0, R2, SP) // stlexb r0, r2, [sp]
	Strex(a, COND_AL, EX_BYTE, true, R0, R2, R2) // stlexb r0, r2, [r2]
