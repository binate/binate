package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The exclusives, load-acquires and store-releases and SWP refuse what clang does -- a doubleword
// pair starting at an odd register (clang's message, "destination ..." or "source ...") or at
// R14, PC as SWP's Rt or Rt2 -- and what has no encoding: an access size outside EX_WORD..EX_HALF,
// a doubleword LDA / STL, a register outside R0..R15, a condition past COND_AL; nothing is
// emitted.  (memRejected and memRejectedWith are in arm32_mem_test.bn.)
func TestExclRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrex(a, COND_AL, EX_DOUBLE, false, R1, R4)
	if !memRejectedWith(a, "destination operands must start at an even register") {
		return fail("LDREXD R1 accepted")
	}
	a = newAsm()
	Strex(a, COND_AL, EX_DOUBLE, true, R5, R3, R4)
	if !memRejectedWith(a, "source operands must start at an even register") {
		return fail("STLEXD R5, R3 accepted")
	}
	a = newAsm()
	Ldrex(a, COND_AL, EX_DOUBLE, true, LR, R4)
	if !memRejected(a) { return fail("LDAEXD LR accepted") }
	a = newAsm()
	Ldrex(a, COND_AL, 4, false, R0, R1)
	if !memRejected(a) { return fail("an access size 4 accepted") }
	a = newAsm()
	Lda(a, COND_AL, EX_DOUBLE, R0, R1)
	if !memRejected(a) { return fail("a doubleword LDA accepted") }
	a = newAsm()
	Stl(a, COND_AL, EX_DOUBLE, R0, R1)
	if !memRejected(a) { return fail("a doubleword STL accepted") }
	a = newAsm()
	Swp(a, COND_AL, false, PC, R2, R1)
	if !memRejected(a) { return fail("SWP PC, R2 accepted") }
	a = newAsm()
	Swp(a, COND_AL, true, R0, PC, R1)
	if !memRejected(a) { return fail("SWPB R0, PC accepted") }
	a = newAsm()
	Ldrex(a, COND_AL, EX_WORD, false, 16, R1)
	if !memRejected(a) { return fail("LDREX R16 accepted") }
	a = newAsm()
	Strex(a, COND_AL, EX_BYTE, false, -1, R2, R1)
	if !memRejected(a) { return fail("STREXB with Rd -1 accepted") }
	a = newAsm()
	Lda(a, COND_AL, EX_HALF, R0, 16)
	if !memRejected(a) { return fail("LDAH [R16] accepted") }
	a = newAsm()
	Ldrex(a, 15, EX_WORD, false, R0, R1)
	if !memRejected(a) { return fail("LDREX under condition 15 accepted") }
	a = newAsm()
	Strex(a, 16, EX_WORD, true, R0, R2, R1)
	if !memRejected(a) { return fail("STLEX under condition 16 accepted") }
	a = newAsm()
	Stl(a, -1, EX_WORD, R0, R1)
	if !memRejected(a) { return fail("STL under condition -1 accepted") }
	a = newAsm()
	Swp(a, 15, false, R0, R2, R1)
	if !memRejected(a) { return fail("SWP under condition 15 accepted") }
	return ""
}
