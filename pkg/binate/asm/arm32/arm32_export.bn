package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The helpers the VFP sub-package (pkg/binate/asm/arm32/vfp) shares with the encoders here.

// Emit32 emits the instruction word inst, as every encoder here does.
func Emit32(a @asm.Assembler, inst uint32) { emit32(a, inst) }

// CondOk reports whether cond is a condition, COND_EQ..COND_AL, setting the assembler error if
// not.
func CondOk(a @asm.Assembler, cond int) bool { return condOk(a, cond) }

// RegOk reports whether r is a core register, R0..R15 (not PC when noPC), setting the assembler
// error if not.
func RegOk(a @asm.Assembler, r int, noPC bool) bool { return regOk(a, r, noPC) }
