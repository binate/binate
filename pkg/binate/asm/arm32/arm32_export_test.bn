package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The helpers exported for the VFP sub-package behave as the encoders' own: Emit32 emits one
// little-endian word, CondOk takes COND_EQ..COND_AL only, RegOk takes R0..R15 (not PC when
// noPC), each refusal setting the assembler error.
func TestExportedHelpers() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Emit32(a, 0xE1A00000)
	if a.HasError || a.Sections[0].Len != 4 || readInst(a.Sections[0], 0) != 0xE1A00000 {
		return fail("Emit32 did not emit its word")
	}
	if !CondOk(a, COND_EQ) || !CondOk(a, COND_AL) || a.HasError {
		return fail("CondOk refused a condition")
	}
	a = newAsm()
	if CondOk(a, 15) || !a.HasError { return fail("CondOk took 15") }
	a = newAsm()
	if !RegOk(a, PC, false) || !RegOk(a, R0, true) || a.HasError {
		return fail("RegOk refused a register")
	}
	a = newAsm()
	if RegOk(a, PC, true) || !a.HasError { return fail("RegOk took PC with noPC") }
	a = newAsm()
	if RegOk(a, 16, false) || !a.HasError { return fail("RegOk took 16") }
	return ""
}
