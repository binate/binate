package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Every encoder's fields are exact (arm32.bni): a condition or a register number with no
// encoding sets the assembler error and emits nothing, instead of being masked into the word.
// (fail, readInst and newAsm are in arm32_test.bn, mediaRejected in arm32_media_test.bn.)

// condCalls calls each encoder that takes a condition, once, under the condition c, with
// operands it encodes as one word.
var condCalls @[]*func(@asm.Assembler, int) = @[]*func(@asm.Assembler, int){
		func(a @asm.Assembler, c int) { Add(a, c, false, R0, R1, Imm(1)) },
		func(a @asm.Assembler, c int) { Mov(a, c, false, R0, Reg(R1)) },
		func(a @asm.Assembler, c int) { Cmp(a, c, R0, Imm(1)) },
		func(a @asm.Assembler, c int) { Movw(a, c, R0, 1) },
		func(a @asm.Assembler, c int) { Movt(a, c, R0, 1) },
		func(a @asm.Assembler, c int) { MovwLabel(a, c, R0, "ext") },
		func(a @asm.Assembler, c int) { MovtRef(a, c, R0, "ext", FIX_MOVT_ABS, 0) },
		func(a @asm.Assembler, c int) { Ldr(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Ldr(a, c, R0, Label("ext")) },
		func(a @asm.Assembler, c int) { Str(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Ldrb(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Strb(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Ldrh(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Strh(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Ldrsb(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Ldrsh(a, c, R0, MemImm(R1, 4)) },
		func(a @asm.Assembler, c int) { Adr(a, c, R0, "ext", 0) },
		func(a @asm.Assembler, c int) { AdrOffset(a, c, R0, 8) },
		func(a @asm.Assembler, c int) { BlockTransfer(a, c, true, BT_IB, R1, false, false, 3) },
		func(a @asm.Assembler, c int) { Ldm(a, c, R1, false, 3) },
		func(a @asm.Assembler, c int) { Stmdb(a, c, R1, true, 3) },
		func(a @asm.Assembler, c int) { Push(a, c, 1 << R4) },
		func(a @asm.Assembler, c int) { Push(a, c, 0x30) },
		func(a @asm.Assembler, c int) { Pop(a, c, 0x30) },
		func(a @asm.Assembler, c int) { B(a, c, "ext") },
		func(a @asm.Assembler, c int) { Bl(a, c, "ext") },
		func(a @asm.Assembler, c int) { BOffset(a, c, false, 8) },
		func(a @asm.Assembler, c int) { Bx(a, c, LR) }, func(a @asm.Assembler, c int) { Blx(a, c, R3) },
		func(a @asm.Assembler, c int) { Mul(a, c, false, R0, R1, R2) },
		func(a @asm.Assembler, c int) { Mla(a, c, false, R0, R1, R2, R3) },
		func(a @asm.Assembler, c int) { Umull(a, c, false, R0, R1, R2, R3) },
		func(a @asm.Assembler, c int) { Smmul(a, c, R0, R1, R2, false) },
		func(a @asm.Assembler, c int) { Sdiv(a, c, R0, R1, R2) },
		func(a @asm.Assembler, c int) { Qadd(a, c, R0, R1, R2) },
		func(a @asm.Assembler, c int) { Ssat(a, c, R0, 8, R1, LSL, 0) },
		func(a @asm.Assembler, c int) { Parallel(a, c, PAR_S, PAR_ADD16, R0, R1, R2) },
		func(a @asm.Assembler, c int) { Sel(a, c, R0, R1, R2) },
		func(a @asm.Assembler, c int) { Pkhbt(a, c, R0, R1, R2, 4) },
		func(a @asm.Assembler, c int) { Clz(a, c, R1, R2) },
		func(a @asm.Assembler, c int) { Sxtb(a, c, R1, R2) },
		func(a @asm.Assembler, c int) { Sxth(a, c, R1, R2) },
		func(a @asm.Assembler, c int) { Uxtb(a, c, R1, R2) },
		func(a @asm.Assembler, c int) { Uxth(a, c, R1, R2) }, func(a @asm.Assembler, c int) { Nop(a, c) },
		func(a @asm.Assembler, c int) { Svc(a, c, 1) }}

// Each encoder that takes a condition emits one word under COND_AL and, under 15, 16 or -1 —
// conditions that would land in the unconditional space or wrap onto another one — sets the
// assembler error and emits nothing, no fixup either.
func TestEveryEncoderChecksItsCondition() testing.TestResult {
	var bad @[]int = @[]int{15, 16, -1}
	for i := 0; i < len(condCalls); i++ {
		var a @asm.Assembler = newAsm()
		condCalls[i](a, COND_AL)
		if a.HasError || a.Sections[0].Len != 4 {
			return fail(buf.Concat("not one word under COND_AL: call ", strconv.Itoa(i)))
		}
		for j := 0; j < len(bad); j++ {
			a = newAsm()
			condCalls[i](a, bad[j])
			if !mediaRejected(a) || a.Sections[0].NumFixups != 0 {
				return fail(
						buf.Concat(buf.Concat("call ", strconv.Itoa(i)),
								buf.Concat(" accepted condition ", strconv.Itoa(bad[j]))))
			}
		}
	}
	return ""
}

// oneWordIs reports whether a holds exactly the word want, with no error.
func oneWordIs(a @asm.Assembler, want uint32) bool {
	return !a.HasError && a.Sections[0].Len == 4 && readInst(a.Sections[0], 0) == want
}

// BX, BLX, CLZ and the extends take the registers clang takes, with clang's words — PC in BX,
// BLX and CLZ, SP in an extend — and reject a number outside R0..R15, and PC in an extend
// ("operand must be a register in range [r0, r14]", as clang says), emitting nothing.
func TestCoreRegisterFieldsChecked() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Bx(a, COND_AL, PC)
	if !oneWordIs(a, 0xE12FFF1F) { return fail("bx pc") }
	a = newAsm()
	Blx(a, COND_AL, PC)
	if !oneWordIs(a, 0xE12FFF3F) { return fail("blx pc") }
	a = newAsm()
	Clz(a, COND_AL, PC, R0)
	if !oneWordIs(a, 0xE16FFF10) { return fail("clz pc, r0") }
	a = newAsm()
	Clz(a, COND_NE, R1, R2)
	if !oneWordIs(a, 0x116F1F12) { return fail("clzne r1, r2") }
	a = newAsm()
	Sxtb(a, COND_AL, SP, R0)
	if !oneWordIs(a, 0xE6AFD070) { return fail("sxtb sp, r0") }
	a = newAsm()
	Uxth(a, COND_AL, R0, SP)
	if !oneWordIs(a, 0xE6FF007D) { return fail("uxth r0, sp") }
	a = newAsm()
	Sxtb(a, COND_NE, R1, R2)
	if !oneWordIs(a, 0x16AF1072) { return fail("sxtbne r1, r2") }
	var bad @[]*func(@asm.Assembler) = @[]*func(@asm.Assembler){
			func(a @asm.Assembler) { Bx(a, COND_AL, 16) }, func(a @asm.Assembler) { Bx(a, COND_AL, -1) },
			func(a @asm.Assembler) { Blx(a, COND_AL, 32) },
			func(a @asm.Assembler) { Clz(a, COND_AL, 16, R0) },
			func(a @asm.Assembler) { Clz(a, COND_AL, R0, 17) },
			func(a @asm.Assembler) { Sxtb(a, COND_AL, PC, R0) },
			func(a @asm.Assembler) { Sxth(a, COND_AL, R0, PC) },
			func(a @asm.Assembler) { Uxtb(a, COND_AL, 16, R0) },
			func(a @asm.Assembler) { Uxth(a, COND_AL, R0, 64) }}
	for i := 0; i < len(bad); i++ {
		a = newAsm()
		bad[i](a)
		if !mediaRejected(a) { return fail(buf.Concat("accepted: case ", strconv.Itoa(i))) }
	}
	a = newAsm()
	Sxtb(a, COND_AL, PC, R0)
	if !charsSame(a.ErrorMsg, "operand must be a register in range [r0, r14]") {
		return fail(buf.Concat("sxtb pc, r0: ", a.ErrorMsg))
	}
	return ""
}
