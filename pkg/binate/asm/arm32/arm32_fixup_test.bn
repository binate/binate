package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// A data relocation's addend is baked into its own field — one, two or four bytes (the REL
// addend R_ARM_ABS8 / ABS16 / ABS32 read back) — leaving the bytes after it alone; one the
// field cannot hold, or an 8-byte datum (no arm32 relocation), is an error.
func TestResolveFixupsBakesDataAddends() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.AddFixup("ext", asm.FIX_DATA_ABS8, -2, 1)
	a.Zero(1)
	a.AddFixup("ext", asm.FIX_DATA_ABS16, 0x1234, 2)
	a.Zero(2)
	a.AddFixup("ext", asm.FIX_DATA_ABS32, 0x55667788, 4)
	a.Zero(4)
	a.EmitUint8(0xAB)
	if !ResolveFixups(a) { return fail(a.ErrorMsg) }
	var d @[]uint8 = a.Sections[0].Data
	if d[0] != 0xFE || d[1] != 0x34 || d[2] != 0x12 || d[3] != 0x88 || d[4] != 0x77 || d[5] != 0x66 ||
			d[6] != 0x55 || d[7] != 0xAB {
		return fail("data addends not baked at their widths")
	}
	a = newAsm()
	a.AddFixup("ext", asm.FIX_DATA_PCREL32, -4, 4) // R_ARM_REL32: the addend in the word
	a.Zero(4)
	if !ResolveFixups(a) { return fail(a.ErrorMsg) }
	d = a.Sections[0].Data
	if d[0] != 0xFC || d[1] != 0xFF || d[2] != 0xFF || d[3] != 0xFF {
		return fail("REL32 addend not baked")
	}
	a = newAsm()
	a.AddFixup("ext", asm.FIX_DATA_ABS8, 256, 1)
	a.Zero(1)
	if ResolveFixups(a) { return fail("a 1-byte addend of 256 accepted") }
	a = newAsm()
	a.AddFixup("ext", asm.FIX_DATA_ABS16, -32769, 2)
	a.Zero(2)
	if ResolveFixups(a) { return fail("a 2-byte addend of -32769 accepted") }
	return ""
}

// A 4-byte field — a data relocation's or a word relocation's (R_ARM_ABS32) — takes any
// 32-bit pattern, signed or unsigned, and nothing wider.
func TestResolveFixupsWordAddendRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.AddFixup("ext", asm.FIX_DATA_ABS32, 0xFFFFFFFF, 4)
	a.Zero(4)
	a.AddFixup("ext", FIX_ABS32, -0x80000000, 4)
	a.Zero(4)
	if !ResolveFixups(a) { return fail(a.ErrorMsg) }
	var d @[]uint8 = a.Sections[0].Data
	if d[0] != 0xFF || d[3] != 0xFF || d[4] != 0 || d[7] != 0x80 {
		return fail("32-bit addends not baked whole")
	}
	a = newAsm()
	a.AddFixup("ext", asm.FIX_DATA_ABS32, 0x100000000, 4)
	a.Zero(4)
	if ResolveFixups(a) { return fail("a 4-byte data addend of 2^32 accepted") }
	a = newAsm()
	a.AddFixup("ext", FIX_ABS32, -0x80000001, 4)
	a.Zero(4)
	if ResolveFixups(a) { return fail("a word addend below -2^31 accepted") }
	return ""
}

// A PC-relative fixup's addend to an external symbol is baked into the field (REL); one past
// 32 bits is out of range rather than baked as its low bits (`adr r0, ext+0x100000008` is not
// `adr r0, ext+8`).
func TestResolveFixupsPcRelAddendRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Adr(a, COND_AL, R0, "ext", 0x100000008)
	if ResolveFixups(a) { return fail("an ADR addend past 32 bits accepted") }
	a = newAsm()
	BAddend(a, COND_AL, false, "ext", 0x100000000)
	if ResolveFixups(a) { return fail("a branch addend past 32 bits accepted") }
	return ""
}

// A FIX_LDC_PC fixup (a coprocessor load / store of a label, its word made as asm/arm32/sys's Ldc
// makes it) resolves in place to a local label in its own section -- one 12 bytes after the
// instruction is 4 past PC (U set, imm8 1), one 8 bytes before it 16 behind PC (U clear, imm8 4)
// -- and fails for one that is not a multiple of 4 away; for a global label it is an error, there
// being no relocation for it, as in clang.  1020 bytes from PC either way is the reach; 1024 is
// out of range.
func TestLdcPcFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.DefineLabel("back")
	pad(a)
	a.AddFixup("ahead", FIX_LDC_PC, 0, 4)
	emit32(a, 0xED9F1F00)
	a.AddFixup("back", FIX_LDC_PC, 0, 4)
	emit32(a, 0xED9F1F00)
	pad(a)
	a.DefineLabel("ahead")
	pad(a)
	if !ResolveFixups(a) || a.HasError { return fail("FIX_LDC_PC resolution failed") }
	if readInst(a.Sections[0], 4) != 0xED9F1F01 { return fail("LDC 4 bytes ahead is not 0xED9F1F01") }
	if readInst(a.Sections[0], 8) != 0xED1F1F04 { return fail("LDC 8 behind is not 0xED1F1F04") }
	var b @asm.Assembler = newAsm()
	b.AddFixup("odd", FIX_LDC_PC, 0, 4)
	emit32(b, 0xED9F1F00)
	b.EmitUint8(1)
	b.DefineLabel("odd")
	if ResolveFixups(b) || !b.HasError { return fail("a misaligned LDC label was taken") }
	var c @asm.Assembler = newAsm()
	c.SetGlobal("g")
	c.AddFixup("g", FIX_LDC_PC, 0, 4)
	emit32(c, 0xED9F1F00)
	c.DefineLabel("g")
	if ResolveFixups(c) || !c.HasError { return fail("an LDC of a global label was taken") }
	return ldcReach()
}

// ldcReach checks a FIX_LDC_PC's reach: a label 1020 bytes past PC (U set, imm8 255) and one 1020
// behind it (U clear) resolve; 1024 either way is an error.
func ldcReach() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.AddFixup("far", FIX_LDC_PC, 0, 4)
	emit32(a, 0xED9F1F00)
	a.Zero(1024)
	a.DefineLabel("far")
	if !ResolveFixups(a) || readInst(a.Sections[0], 0) != 0xED9F1FFF {
		return fail("LDC 1020 past PC is not 0xED9F1FFF")
	}
	a = newAsm()
	a.DefineLabel("far")
	a.Zero(1012)
	a.AddFixup("far", FIX_LDC_PC, 0, 4)
	emit32(a, 0xED9F1F00)
	if !ResolveFixups(a) || readInst(a.Sections[0], 1012) != 0xED1F1FFF {
		return fail("LDC 1020 behind PC is not 0xED1F1FFF")
	}
	a = newAsm()
	a.AddFixup("far", FIX_LDC_PC, 0, 4)
	emit32(a, 0xED9F1F00)
	a.Zero(1028)
	a.DefineLabel("far")
	if ResolveFixups(a) || !a.HasError { return fail("LDC 1024 past PC was taken") }
	a = newAsm()
	a.DefineLabel("far")
	a.Zero(1016)
	a.AddFixup("far", FIX_LDC_PC, 0, 4)
	emit32(a, 0xED9F1F00)
	if ResolveFixups(a) || !a.HasError { return fail("LDC 1024 behind PC was taken") }
	return ""
}

// A FIX_LDC16_PC fixup (a VLDR.16 / VSTR.16 of a label) resolves in place in halfwords, as clang
// and GNU as resolve one: a label 6 bytes before the instruction is 14 behind PC (U clear, imm8 7),
// one 10 bytes after it 2 past PC (U set, imm8 1), one 518 after it 510 past PC (imm8 255); an odd
// distance, 512 bytes past PC and 2^31 bytes before it (the smallest 32-bit int) are errors.
func TestLdc16PcFixup() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.Zero(2)
	a.DefineLabel("back")
	a.Zero(6)
	a.AddFixup("back", FIX_LDC16_PC, 0, 4)
	emit32(a, 0xED9F0900)
	a.AddFixup("ahead", FIX_LDC16_PC, 0, 4)
	emit32(a, 0xED9F0900)
	a.Zero(6)
	a.DefineLabel("ahead")
	if !ResolveFixups(a) || a.HasError { return fail("FIX_LDC16_PC resolution failed") }
	if readInst(a.Sections[0], 8) != 0xED1F0907 {
		return fail("VLDR.16 14 behind PC is not 0xED1F0907")
	}
	if readInst(a.Sections[0], 12) != 0xED9F0901 { return fail("VLDR.16 2 past PC is not 0xED9F0901") }
	var b @asm.Assembler = newAsm()
	b.AddFixup("far", FIX_LDC16_PC, 0, 4)
	emit32(b, 0xED9F0900)
	b.Zero(514)
	b.DefineLabel("far")
	if !ResolveFixups(b) || readInst(b.Sections[0], 0) != 0xED9F09FF {
		return fail("VLDR.16 510 past PC is not 0xED9F09FF")
	}
	var c @asm.Assembler = newAsm()
	c.AddFixup("odd", FIX_LDC16_PC, 0, 4)
	emit32(c, 0xED9F0900)
	c.Zero(5)
	c.DefineLabel("odd")
	if ResolveFixups(c) || !c.HasError { return fail("an odd VLDR.16 distance was taken") }
	var d @asm.Assembler = newAsm()
	d.AddFixup("far", FIX_LDC16_PC, 0, 4)
	emit32(d, 0xED9F0900)
	d.Zero(516)
	d.DefineLabel("far")
	if ResolveFixups(d) || !d.HasError { return fail("VLDR.16 512 past PC was taken") }
	var m @asm.Assembler = newAsm()
	m.DefineLabel("lbl")
	m.AddFixup("lbl", FIX_LDC16_PC, -0x7FFFFFF8, 4)
	emit32(m, 0xED9F0900)
	if ResolveFixups(m) || !m.HasError { return fail("VLDR.16 2^31 before PC was taken") }
	// The smallest int, whose negation overflows (ResolveFixups passes none on a 64-bit host).
	var w @[]uint8 = make_slice(uint8, 4)
	var least int64 = -9223372036854775808
	if sizeof(int) == 4 { least = -2147483648 }
	if patchLdcOffset(w, 0, cast(int, least), 2) || patchLdcOffset(w, 0, cast(int, least), 4) {
		return fail("the smallest int was taken as a PC-relative LDC / VLDR offset")
	}
	return ""
}
