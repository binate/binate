package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// --- Load/Store multiple ---
// Format: cond[31:28] | 100 | P[24] | U[23] | S[22] | W[21] | L[20]
//         | Rn[19:16] | register_list[15:0]
//
// IA (increment after):  P=0, U=1
// IB (increment before): P=1, U=1
// DA (decrement after):  P=0, U=0
// DB (decrement before): P=1, U=0
// S (`^`) selects the user-mode registers; W writes the final address back to Rn.

// ldmstmEnc encodes LDM/STM (load/store multiple). p and u select the
// addressing mode (IA, DB, etc.). regmask is a 16-bit bitmask of registers.
func ldmstmEnc(cond int, load bool, p bool, u bool, rn int, wb bool, regmask int) uint32 {
	var inst uint32 = condBits(cond) | 0x08000000 // 100 in bits [27:25]
	if p {
		inst = inst | (1 << 24)
	}
	if u {
		inst = inst | (1 << 23)
	}
	if wb {
		inst = inst | (1 << 21)
	}
	if load {
		inst = inst | (1 << 20)
	}
	inst = inst | (cast(uint32, rn & 0xf) << 16)
	inst = inst | cast(uint32, regmask & 0xffff)
	return inst
}

// BlockTransfer emits LDM / STM in any of the four addressing modes, with
// writeback and the `^` user-registers form (arm32.bni).
func BlockTransfer(a @asm.Assembler, cond int, load bool, mode int, rn int, writeback bool,
		user bool, regmask int) {
	if mode < BT_IA || mode > BT_DB {
		a.SetError("arm32: unknown LDM / STM addressing mode")
		return
	}
	if !isCoreReg(rn) {
		a.SetError("arm32: an LDM / STM base register must be R0..R15")
		return
	}
	if regmask <= 0 || regmask > 0xffff {
		a.SetError("arm32: an LDM / STM register list must be non-empty and name R0..R15 only")
		return
	}
	if load && writeback && !user && (regmask & (1 << rn)) != 0 {
		a.SetError("arm32: an LDM with writeback cannot load its base register")
		return
	}
	// P (before) for IB / DB; U (increment) for IA / IB.
	var inst uint32 = ldmstmEnc(cond, load, mode == BT_IB || mode == BT_DB,
			mode == BT_IA || mode == BT_IB, rn, writeback, regmask)
	if user {
		inst = inst | (1 << 22) // S: the user-mode registers
	}
	emit32(a, inst)
}

// Ldm emits `LDM{cond} Rn{!}, {regmask}` — load multiple, increment-after.
// regmask is a 16-bit bitmask: bit i selects register i. writeback=true
// updates Rn = Rn + 4*popcount(regmask) after the load.
func Ldm(a @asm.Assembler, cond int, rn int, writeback bool, regmask int) {
	BlockTransfer(a, cond, true, BT_IA, rn, writeback, false, regmask)
}

// Stm emits `STM{cond} Rn{!}, {regmask}` — store multiple, increment-after.
func Stm(a @asm.Assembler, cond int, rn int, writeback bool, regmask int) {
	BlockTransfer(a, cond, false, BT_IA, rn, writeback, false, regmask)
}

// Ldmdb emits `LDMDB{cond} Rn{!}, {regmask}` — load multiple,
// decrement-before. Rn is decremented by 4 before each load (equivalent
// to a "full descending" stack pop in the AAPCS sense).
func Ldmdb(a @asm.Assembler, cond int, rn int, writeback bool, regmask int) {
	BlockTransfer(a, cond, true, BT_DB, rn, writeback, false, regmask)
}

// Stmdb emits `STMDB{cond} Rn{!}, {regmask}` — store multiple,
// decrement-before. Used to push registers onto a full-descending stack.
func Stmdb(a @asm.Assembler, cond int, rn int, writeback bool, regmask int) {
	BlockTransfer(a, cond, false, BT_DB, rn, writeback, false, regmask)
}

// Push emits `PUSH{cond} {regmask}` — `STMDB SP!, {regmask}`, the registers in
// regmask pushed with the lowest at the lowest address; one register Rt is
// `STR Rt, [SP, #-4]!` (arm32.bni).
func Push(a @asm.Assembler, cond int, regmask int) {
	var rt int = singleReg(regmask)
	if rt >= 0 {
		Str(a, cond, rt, MemPre(SP, -4))
		return
	}
	Stmdb(a, cond, SP, true, regmask)
}

// Pop emits `POP{cond} {regmask}` — `LDM SP!, {regmask}`; one register Rt is
// `LDR Rt, [SP], #4` (arm32.bni).
func Pop(a @asm.Assembler, cond int, regmask int) {
	if regmask > 0 && (regmask & (1 << SP)) != 0 {
		a.SetError("arm32: POP cannot load SP, the register it writes back")
		return
	}
	var rt int = singleReg(regmask)
	if rt >= 0 {
		Ldr(a, cond, rt, MemPost(SP, 4))
		return
	}
	Ldm(a, cond, SP, true, regmask)
}

// singleReg returns the register regmask names when it names exactly one of
// R0..R15, else -1.
func singleReg(regmask int) int {
	for r := 0; r < 16; r++ {
		if regmask == (1 << r) { return r }
	}
	return -1
}
