package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// LDM / STM in each mode with and without writeback and `^`, and PUSH / POP (one register, SP
// included, as STR / LDR), against clang's words (Apple clang 21, armv7ve) -- the bases R0, SP and
// PC, lists with PC (which clang warns of but takes), conditions.
func TestBlockTransferGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Push(a, COND_AL, 0x0001) // push {r0}
	Push(a, COND_AL, 0x4000) // push {lr}
	Push(a, COND_AL, 0x8000) // push {pc}
	Push(a, COND_AL, 0x2000) // push {sp}
	Push(a, COND_AL, 0x0003) // push {r0, r1}
	Push(a, COND_AL, 0x400F) // push {r0-r3, lr}
	Push(a, COND_AL, 0x8FF0) // push {r4-r11, pc}
	Push(a, COND_AL, 0x2001) // push {r0, sp}
	Push(a, COND_AL, 0xA000) // push {sp, pc}
	Push(a, COND_AL, 0x000A) // push {r3, r1}
	Push(a, COND_AL, 0x0002) // push {r1, r1}
	Push(a, COND_AL, 0x1000) // push {r12}
	Push(a, COND_AL, 0xFFFF) // push {r0-r15}
	Push(a, COND_AL, 0x1FFE) // push {r1-r12}
	Push(a, COND_AL, 0x8005) // push {r0, r2, pc}
	Pop(a, COND_AL, 0x0001) // pop {r0}
	Pop(a, COND_AL, 0x4000) // pop {lr}
	Pop(a, COND_AL, 0x8000) // pop {pc}
	Pop(a, COND_AL, 0x0003) // pop {r0, r1}
	Pop(a, COND_AL, 0x400F) // pop {r0-r3, lr}
	Pop(a, COND_AL, 0x8FF0) // pop {r4-r11, pc}
	Pop(a, COND_AL, 0x000A) // pop {r3, r1}
	Pop(a, COND_AL, 0x0002) // pop {r1, r1}
	Pop(a, COND_AL, 0x1000) // pop {r12}
	Pop(a, COND_AL, 0x1FFE) // pop {r1-r12}
	Pop(a, COND_AL, 0x8005) // pop {r0, r2, pc}
	Push(a, COND_EQ, 0x0006) // pusheq {r1, r2}
	Pop(a, COND_EQ, 0x0002) // popeq {r1}
	Push(a, COND_EQ, 0x0002) // pusheq {r1}
	Push(a, COND_AL, 0x0006) // pushal {r1, r2}
	Push(a, COND_CS, 0x0006) // pushhs {r1, r2}
	Pop(a, COND_CS, 0x0002) // pophs {r1}
	Push(a, COND_CS, 0x0002) // pushhs {r1}
	Push(a, COND_AL, 0x000F) // push {a1-a4}
	Push(a, COND_AL, 0x003F) // push {r0-r3, r2-r5}
	Push(a, COND_AL, 0xC000) // push {lr-pc}
	Push(a, COND_AL, 0xE000) // push {sp-pc}
	Push(a, COND_AL, 0x0FF0) // push {v1-v8}
	Push(a, COND_AL, 0x7800) // push {fp, ip, sp, lr}
	Push(a, COND_AL, 0x001B) // push {r0-r1, r3-r4}
	BlockTransfer(a, COND_AL, true, BT_IA, R0, false, false, 0x0006) // ldm r0, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_IA, R0, false, false, 0x0002) // ldm r0, {r1}
	BlockTransfer(a, COND_AL, true, BT_IA, SP, false, false, 0x0002) // ldm sp, {r1}
	BlockTransfer(a, COND_AL, true, BT_IA, PC, false, false, 0x0002) // ldm pc, {r1}
	BlockTransfer(a, COND_AL, true, BT_IA, R0, true, false, 0x0006) // ldm r0!, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_IA, R0, true, false, 0x0002) // ldm r0!, {r1}
	BlockTransfer(a, COND_AL, true, BT_IA, SP, true, false, 0x0002) // ldm sp!, {r1}
	BlockTransfer(a, COND_AL, true, BT_IA, PC, true, false, 0x0002) // ldm pc!, {r1}
	BlockTransfer(a, COND_AL, true, BT_IB, R0, false, false, 0x0006) // ldmib r0, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_IB, R0, true, false, 0x0006) // ldmib r0!, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_DA, R0, false, false, 0x0006) // ldmda r0, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_DA, R0, true, false, 0x0006) // ldmda r0!, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_DB, R0, false, false, 0x0006) // ldmdb r0, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_DB, R0, false, false, 0x0002) // ldmdb r0, {r1}
	BlockTransfer(a, COND_AL, true, BT_DB, SP, false, false, 0x0002) // ldmdb sp, {r1}
	BlockTransfer(a, COND_AL, true, BT_DB, PC, false, false, 0x0002) // ldmdb pc, {r1}
	BlockTransfer(a, COND_AL, true, BT_DB, R0, true, false, 0x0006) // ldmdb r0!, {r1, r2}
	BlockTransfer(a, COND_AL, true, BT_DB, R0, true, false, 0x0002) // ldmdb r0!, {r1}
	BlockTransfer(a, COND_AL, true, BT_DB, SP, true, false, 0x0002) // ldmdb sp!, {r1}
	BlockTransfer(a, COND_AL, true, BT_DB, PC, true, false, 0x0002) // ldmdb pc!, {r1}
	BlockTransfer(a, COND_AL, false, BT_IA, R0, false, false, 0x0006) // stm r0, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_IA, R0, false, false, 0x0002) // stm r0, {r1}
	BlockTransfer(a, COND_AL, false, BT_IA, SP, false, false, 0x0002) // stm sp, {r1}
	BlockTransfer(a, COND_AL, false, BT_IA, PC, false, false, 0x0002) // stm pc, {r1}
	BlockTransfer(a, COND_AL, false, BT_IA, R0, true, false, 0x0006) // stm r0!, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_IA, R0, true, false, 0x0002) // stm r0!, {r1}
	BlockTransfer(a, COND_AL, false, BT_IA, SP, true, false, 0x0002) // stm sp!, {r1}
	BlockTransfer(a, COND_AL, false, BT_IA, PC, true, false, 0x0002) // stm pc!, {r1}
	BlockTransfer(a, COND_AL, false, BT_IB, R0, false, false, 0x0006) // stmib r0, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_IB, R0, true, false, 0x0006) // stmib r0!, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_DA, R0, false, false, 0x0006) // stmda r0, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_DA, R0, true, false, 0x0006) // stmda r0!, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_DB, R0, false, false, 0x0006) // stmdb r0, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_DB, R0, false, false, 0x0002) // stmdb r0, {r1}
	BlockTransfer(a, COND_AL, false, BT_DB, SP, false, false, 0x0002) // stmdb sp, {r1}
	BlockTransfer(a, COND_AL, false, BT_DB, PC, false, false, 0x0002) // stmdb pc, {r1}
	BlockTransfer(a, COND_AL, false, BT_DB, R0, true, false, 0x0006) // stmdb r0!, {r1, r2}
	BlockTransfer(a, COND_AL, false, BT_DB, R0, true, false, 0x0002) // stmdb r0!, {r1}
	BlockTransfer(a, COND_AL, false, BT_DB, SP, true, false, 0x0002) // stmdb sp!, {r1}
	BlockTransfer(a, COND_AL, false, BT_DB, PC, true, false, 0x0002) // stmdb pc!, {r1}
	BlockTransfer(a, COND_AL, true, BT_IA, R0, false, true, 0x0006) // ldm r0, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_IA, R0, false, true, 0x8002) // ldm r0, {r1, pc}^
	BlockTransfer(a, COND_AL, true, BT_IA, SP, false, true, 0x0006) // ldm sp, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_IA, PC, false, true, 0x0006) // ldm pc, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_IA, R0, true, true, 0x8002) // ldm r0!, {r1, pc}^
	BlockTransfer(a, COND_AL, true, BT_IA, R0, true, true, 0x8000) // ldm r0!, {pc}^
	BlockTransfer(a, COND_AL, true, BT_IA, SP, true, true, 0x8002) // ldm sp!, {r1, pc}^
	BlockTransfer(a, COND_AL, true, BT_IA, PC, true, true, 0x8002) // ldm pc!, {r1, pc}^
	BlockTransfer(a, COND_AL, false, BT_IA, R0, false, true, 0x0006) // stm r0, {r1, r2}^
	BlockTransfer(a, COND_AL, false, BT_IA, R0, false, true, 0x8002) // stm r0, {r1, pc}^
	BlockTransfer(a, COND_AL, false, BT_IA, SP, false, true, 0x0006) // stm sp, {r1, r2}^
	BlockTransfer(a, COND_AL, false, BT_IA, PC, false, true, 0x0006) // stm pc, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_DB, R0, false, true, 0x0006) // ldmdb r0, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_DB, R0, false, true, 0x8002) // ldmdb r0, {r1, pc}^
	BlockTransfer(a, COND_AL, true, BT_DB, SP, false, true, 0x0006) // ldmdb sp, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_DB, PC, false, true, 0x0006) // ldmdb pc, {r1, r2}^
	BlockTransfer(a, COND_AL, true, BT_DB, R0, true, true, 0x8002) // ldmdb r0!, {r1, pc}^
	BlockTransfer(a, COND_AL, true, BT_DB, R0, true, true, 0x8000) // ldmdb r0!, {pc}^
	BlockTransfer(a, COND_AL, true, BT_DB, SP, true, true, 0x8002) // ldmdb sp!, {r1, pc}^
	BlockTransfer(a, COND_AL, true, BT_DB, PC, true, true, 0x8002) // ldmdb pc!, {r1, pc}^
	BlockTransfer(a, COND_AL, false, BT_DB, R0, false, true, 0x0006) // stmdb r0, {r1, r2}^
	BlockTransfer(a, COND_AL, false, BT_DB, R0, false, true, 0x8002) // stmdb r0, {r1, pc}^
	BlockTransfer(a, COND_AL, false, BT_DB, SP, false, true, 0x0006) // stmdb sp, {r1, r2}^
	BlockTransfer(a, COND_AL, false, BT_DB, PC, false, true, 0x0006) // stmdb pc, {r1, r2}^
	var want @[]uint32 = make_slice(uint32, 104)
	want[0] = 0xE52D0004
	want[1] = 0xE52DE004
	want[2] = 0xE52DF004
	want[3] = 0xE52DD004
	want[4] = 0xE92D0003
	want[5] = 0xE92D400F
	want[6] = 0xE92D8FF0
	want[7] = 0xE92D2001
	want[8] = 0xE92DA000
	want[9] = 0xE92D000A
	want[10] = 0xE52D1004
	want[11] = 0xE52DC004
	want[12] = 0xE92DFFFF
	want[13] = 0xE92D1FFE
	want[14] = 0xE92D8005
	want[15] = 0xE49D0004
	want[16] = 0xE49DE004
	want[17] = 0xE49DF004
	want[18] = 0xE8BD0003
	want[19] = 0xE8BD400F
	want[20] = 0xE8BD8FF0
	want[21] = 0xE8BD000A
	want[22] = 0xE49D1004
	want[23] = 0xE49DC004
	want[24] = 0xE8BD1FFE
	want[25] = 0xE8BD8005
	want[26] = 0x092D0006
	want[27] = 0x049D1004
	want[28] = 0x052D1004
	want[29] = 0xE92D0006
	want[30] = 0x292D0006
	want[31] = 0x249D1004
	want[32] = 0x252D1004
	want[33] = 0xE92D000F
	want[34] = 0xE92D003F
	want[35] = 0xE92DC000
	want[36] = 0xE92DE000
	want[37] = 0xE92D0FF0
	want[38] = 0xE92D7800
	want[39] = 0xE92D001B
	want[40] = 0xE8900006
	want[41] = 0xE8900002
	want[42] = 0xE89D0002
	want[43] = 0xE89F0002
	want[44] = 0xE8B00006
	want[45] = 0xE8B00002
	want[46] = 0xE8BD0002
	want[47] = 0xE8BF0002
	want[48] = 0xE9900006
	want[49] = 0xE9B00006
	want[50] = 0xE8100006
	want[51] = 0xE8300006
	want[52] = 0xE9100006
	want[53] = 0xE9100002
	want[54] = 0xE91D0002
	want[55] = 0xE91F0002
	want[56] = 0xE9300006
	want[57] = 0xE9300002
	want[58] = 0xE93D0002
	want[59] = 0xE93F0002
	want[60] = 0xE8800006
	want[61] = 0xE8800002
	want[62] = 0xE88D0002
	want[63] = 0xE88F0002
	want[64] = 0xE8A00006
	want[65] = 0xE8A00002
	want[66] = 0xE8AD0002
	want[67] = 0xE8AF0002
	want[68] = 0xE9800006
	want[69] = 0xE9A00006
	want[70] = 0xE8000006
	want[71] = 0xE8200006
	want[72] = 0xE9000006
	want[73] = 0xE9000002
	want[74] = 0xE90D0002
	want[75] = 0xE90F0002
	want[76] = 0xE9200006
	want[77] = 0xE9200002
	want[78] = 0xE92D0002
	want[79] = 0xE92F0002
	want[80] = 0xE8D00006
	want[81] = 0xE8D08002
	want[82] = 0xE8DD0006
	want[83] = 0xE8DF0006
	want[84] = 0xE8F08002
	want[85] = 0xE8F08000
	want[86] = 0xE8FD8002
	want[87] = 0xE8FF8002
	want[88] = 0xE8C00006
	want[89] = 0xE8C08002
	want[90] = 0xE8CD0006
	want[91] = 0xE8CF0006
	want[92] = 0xE9500006
	want[93] = 0xE9508002
	want[94] = 0xE95D0006
	want[95] = 0xE95F0006
	want[96] = 0xE9708002
	want[97] = 0xE9708000
	want[98] = 0xE97D8002
	want[99] = 0xE97F8002
	want[100] = 0xE9400006
	want[101] = 0xE9408002
	want[102] = 0xE94D0006
	want[103] = 0xE94F0006

	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] {
			return fail("an LDM / STM / PUSH / POP encoded unlike clang")
		}
	}
	return ""
}
