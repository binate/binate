package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// --- LDM / STM / PUSH / POP ---

func TestPush() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// PUSH {R4, LR} = STMDB SP!, {R4, LR}
	// regmask = (1<<4) | (1<<14) = 0x4010
	// STM: cond=1110 | 100 | P=1 | U=0 | S=0 | W=1 | L=0
	//   | Rn=1101(SP) | regmask
	// = 0xE92D4010
	var mask int = (1 << 4) | (1 << 14)
	Push(a, COND_AL, mask)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE92D4010 {
		return fail("PUSH {R4, LR} encoding wrong")
	}
	return ""
}

func TestPop() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// POP {R4, PC} = LDM SP!, {R4, PC}
	// regmask = (1<<4) | (1<<15) = 0x8010
	// LDM: cond=1110 | 100 | P=0 | U=1 | S=0 | W=1 | L=1
	//   | Rn=1101(SP) | regmask
	// = 0xE8BD8010
	var mask int = (1 << 4) | (1 << 15)
	Pop(a, COND_AL, mask)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE8BD8010 {
		return fail("POP {R4, PC} encoding wrong")
	}
	return ""
}

func TestStmdb() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STMDB R0!, {R1, R2, R3}
	// regmask = (1<<1)|(1<<2)|(1<<3) = 0x000E
	// = 0xE920000E
	var mask int = (1 << 1) | (1 << 2) | (1 << 3)
	Stmdb(a, COND_AL, R0, true, mask)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE920000E {
		return fail("STMDB R0!, {R1-R3} encoding wrong")
	}
	return ""
}

func TestLdm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDM R0, {R1, R2} (no writeback)
	// P=0, U=1, W=0, L=1
	// regmask = (1<<1)|(1<<2) = 0x0006
	// = 0xE8900006
	var mask int = (1 << 1) | (1 << 2)
	Ldm(a, COND_AL, R0, false, mask)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE8900006 {
		return fail("LDM R0, {R1, R2} encoding wrong")
	}
	return ""
}

// btCase is one BlockTransfer call and clang's word for it.
type btCase struct {
	cond int
	load bool
	mode int
	rn   int
	wb   bool
	user bool
	mask int
	word uint32
}

// Every addressing mode, loading and storing, with writeback, `^` and a condition, each
// word as clang assembles the instruction (`ldmib r0, {r1}` is E9900002, ...).
func TestBlockTransferForms() testing.TestResult {
	var c @[]btCase = make_slice(btCase, 13)
	c[0] = btCase{cond: COND_AL, load: true, mode: BT_IA, rn: R0, mask: 0x2, word: 0xE8900002}
	c[1] = btCase{cond: COND_AL, load: true, mode: BT_IB, rn: R0, mask: 0x2, word: 0xE9900002}
	c[2] = btCase{cond: COND_AL, load: true, mode: BT_DA, rn: R0, mask: 0x2, word: 0xE8100002}
	c[3] = btCase{cond: COND_AL, load: true, mode: BT_DB, rn: R0, mask: 0x2, word: 0xE9100002}
	c[4] = btCase{cond: COND_AL, load: false, mode: BT_IA, rn: R0, mask: 0x2, word: 0xE8800002}
	c[5] = btCase{cond: COND_AL, load: false, mode: BT_IB, rn: R0, mask: 0x2, word: 0xE9800002}
	c[6] = btCase{cond: COND_AL, load: false, mode: BT_DA, rn: R0, mask: 0x2, word: 0xE8000002}
	c[7] = btCase{cond: COND_AL, load: false, mode: BT_DB, rn: R0, mask: 0x2, word: 0xE9000002}
	c[8] = btCase{cond: COND_AL, load: true, mode: BT_DA, rn: R0, wb: true, mask: 0x2,
			word: 0xE8300002}
	c[9] = btCase{cond: COND_AL, load: false, mode: BT_DB, rn: SP, user: true, mask: 0x3,
			word: 0xE94D0003}
	c[10] = btCase{cond: COND_AL, load: true, mode: BT_IA, rn: R0, wb: true, user: true, mask: 0x8002,
			word: 0xE8F08002}
	c[11] = btCase{cond: COND_EQ, load: true, mode: BT_DB, rn: R0, wb: true, mask: 0x6,
			word: 0x09300006}
	c[12] = btCase{cond: COND_AL, load: false, mode: BT_IB, rn: SP, user: true, mask: 0x1,
			word: 0xE9CD0001}
	for i := 0; i < len(c); i++ {
		var a @asm.Assembler = newAsm()
		BlockTransfer(a, c[i].cond, c[i].load, c[i].mode, c[i].rn, c[i].wb, c[i].user, c[i].mask)
		if a.HasError { return fail(a.ErrorMsg) }
		if readInst(a.Sections[0], 0) != c[i].word { return fail("a block transfer encoded wrong") }
	}
	return ""
}

// An empty or wider-than-16-bit register list, a base outside R0..R15, an unknown mode,
// an LDM with writeback loading its base, or a POP of SP is an error that emits nothing
// -- through Ldm / Stm / Push / Pop too.
func TestBlockTransferRejects() testing.TestResult {
	for i := 0; i < 11; i++ {
		var a @asm.Assembler = newAsm()
		if i == 0 { BlockTransfer(a, COND_AL, true, BT_IA, R0, false, false, 0) }
		if i == 1 { BlockTransfer(a, COND_AL, true, BT_IA, R0, false, false, 0x10002) }
		if i == 2 { BlockTransfer(a, COND_AL, true, BT_IA, 16, false, false, 0x2) }
		if i == 3 { BlockTransfer(a, COND_AL, true, BT_DB + 1, R0, false, false, 0x2) }
		if i == 4 { BlockTransfer(a, COND_AL, false, -1, R0, false, false, 0x2) }
		if i == 5 { Ldm(a, COND_AL, -1, false, 0x2) }
		if i == 6 { Push(a, COND_AL, 0) }
		if i == 7 { Stmdb(a, COND_AL, R0, true, -1) }
		if i == 8 { BlockTransfer(a, COND_AL, true, BT_DB, R2, true, false, 0x6) }
		if i == 9 { Pop(a, COND_AL, 1 << SP) }
		if i == 10 { Pop(a, COND_AL, (1 << R0) | (1 << SP)) }
		if !a.HasError { return fail("an invalid block transfer was accepted") }
		if a.Sections[0].Len != 0 { return fail("an invalid block transfer emitted a word") }
	}
	return ""
}

// One register is pushed and popped with the STR / LDR clang emits: `push {r0}` is
// E52D0004, `pop {r0}` E49D0004 and `pop {pc}` E49DF004.
func TestPushPopSingleRegister() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Push(a, COND_AL, 1 << R0)
	Pop(a, COND_AL, 1 << R0)
	Pop(a, COND_AL, 1 << PC)
	Push(a, COND_EQ, 1 << LR)
	if a.HasError { return fail(a.ErrorMsg) }
	if readInst(a.Sections[0], 0) != 0xE52D0004 { return fail("PUSH {R0} encoded wrong") }
	if readInst(a.Sections[0], 4) != 0xE49D0004 { return fail("POP {R0} encoded wrong") }
	if readInst(a.Sections[0], 8) != 0xE49DF004 { return fail("POP {PC} encoded wrong") }
	if readInst(a.Sections[0], 12) != 0x052DE004 { return fail("PUSHEQ {LR} encoded wrong") }
	return ""
}
