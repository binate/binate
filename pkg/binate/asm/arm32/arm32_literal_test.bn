package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// PC-relative loads and stores with a label operand (`ldr r0, lbl`), and fixups whose value
// its field cannot hold: every word is clang's (`clang -c -target armv7-linux-gnueabi`).

// litWordsAre checks that the words of section 0 from offset 4 on are want, in order.
func litWordsAre(a @asm.Assembler, want @[]uint32) bool {
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 + 4 * i) != want[i] { return false }
	}
	return true
}

// Each load / store form to a label in its own section, backward and forward, resolves in
// place: [PC, #±n] with n the label's distance from PC (the instruction + 8).
func TestLiteralLoadStoreSameSection() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.DefineLabel("back")
	a.EmitUint32(0x11111111)
	Ldr(a, COND_AL, R0, Label("back"))
	Ldr(a, COND_AL, R1, Label("fwd"))
	Ldrb(a, COND_AL, R2, Label("back"))
	Strb(a, COND_AL, R2, Label("fwd"))
	Str(a, COND_AL, R0, Label("back"))
	Ldrh(a, COND_AL, R3, Label("fwd"))
	Strh(a, COND_AL, R3, Label("back"))
	Ldrsb(a, COND_AL, R4, Label("back"))
	Ldrsh(a, COND_AL, R5, Label("fwd"))
	Ldr(a, COND_AL, PC, Label("back"))
	a.DefineLabel("fwd")
	a.EmitUint32(0x22222222)
	if !ResolveFixups(a) || a.HasError { return fail("resolution failed") }
	var want @[]uint32 = make_slice(uint32, 10)
	want[0] = 0xE51F000C
	want[1] = 0xE59F101C
	want[2] = 0xE55F2014
	want[3] = 0xE5CF2014
	want[4] = 0xE50F001C
	want[5] = 0xE1DF30BC
	want[6] = 0xE14F32B4
	want[7] = 0xE15F42D8
	want[8] = 0xE1DF50F0
	want[9] = 0xE51FF030
	if !litWordsAre(a, want) { return fail("a literal load / store is not clang's word") }
	for fi := 0; fi < a.Sections[0].NumFixups; fi++ {
		if a.Sections[0].Fixups[fi].Kind != -1 { return fail("a same-section literal stayed a fixup") }
	}
	return ""
}

// To a label in another section or undefined, the fixup stays (FIX_LDR_PC_G0 /
// FIX_LDRS_PC_G0, R_ARM_LDR_PC_G0 / R_ARM_LDRS_PC_G0) with the REL addend -8 in the field.
func TestLiteralLoadStoreRelocated() testing.TestResult {
	var a @asm.Assembler = newAsm()
	a.EmitUint32(0)
	Ldr(a, COND_AL, R0, Label("other"))
	Ldrh(a, COND_AL, R1, Label("other"))
	Str(a, COND_AL, R2, Label("ext"))
	Strh(a, COND_AL, R3, Label("ext"))
	a.SetSection("data", -1)
	a.DefineLabel("other")
	a.EmitUint32(1)
	if !ResolveFixups(a) || a.HasError { return fail("baking failed") }
	var want @[]uint32 = make_slice(uint32, 4)
	want[0] = 0xE51F0008
	want[1] = 0xE15F10B8
	want[2] = 0xE50F2008
	want[3] = 0xE14F30B8
	if !litWordsAre(a, want) { return fail("the -8 addend is not in the field") }
	var sec @asm.Section = a.Sections[0]
	if sec.NumFixups != 4 || sec.Fixups[0].Kind != FIX_LDR_PC_G0 ||
			sec.Fixups[1].Kind != FIX_LDRS_PC_G0 || sec.Fixups[2].Kind != FIX_LDR_PC_G0 ||
			sec.Fixups[3].Kind != FIX_LDRS_PC_G0 {
		return fail("the fixups are not the literal kinds")
	}
	return ""
}

// literalRange assembles `ldr r0, far` (or `ldrh`, half) with far gap bytes after the
// instruction's end, or — gap negative — far -gap bytes before the instruction, reporting
// whether it resolves (and the word when it does).
func literalRange(half bool, gap int) (bool, uint32) {
	var a @asm.Assembler = newAsm()
	if gap < 0 {
		a.DefineLabel("far")
		a.Zero(-gap)
	}
	var at int = a.Sections[0].Len
	if half {
		Ldrh(a, COND_AL, R0, Label("far"))
	} else {
		Ldr(a, COND_AL, R0, Label("far"))
	}
	if gap >= 0 {
		a.Zero(gap)
		a.DefineLabel("far")
		a.EmitUint32(1)
	}
	var ok bool = ResolveFixups(a)
	if ok != !a.HasError { return false, 0 }
	return ok, readInst(a.Sections[0], at)
}

// The 12-bit form reaches exactly ±4095 and the split 8-bit form ±255 from PC (clang:
// E59F0FFF / E51F0FFF, E1DF0FBF / E15F0FBF; one byte further is "out of range
// pc-relative fixup value"), and past that ResolveFixups fails with the error set.
func TestLiteralLoadRange() testing.TestResult {
	ok, w := literalRange(false, 4099)
	if !ok || w != 0xE59F0FFF { return fail("ldr at +4095 not E59F0FFF") }
	ok, w = literalRange(false, -4087)
	if !ok || w != 0xE51F0FFF { return fail("ldr at -4095 not E51F0FFF") }
	ok, w = literalRange(true, 259)
	if !ok || w != 0xE1DF0FBF { return fail("ldrh at +255 not E1DF0FBF") }
	ok, w = literalRange(true, -247)
	if !ok || w != 0xE15F0FBF { return fail("ldrh at -255 not E15F0FBF") }
	ok, _ = literalRange(false, 4100)
	if ok { return fail("ldr at +4096 accepted") }
	ok, _ = literalRange(false, -4088)
	if ok { return fail("ldr at -4096 accepted") }
	ok, _ = literalRange(true, 260)
	if ok { return fail("ldrh at +256 accepted") }
	ok, _ = literalRange(true, -248)
	if ok { return fail("ldrh at -256 accepted") }
	return ""
}

// An operand with no load / store encoding — a register, an immediate, or for the
// halfword / signed forms a shifted register offset — is an error (clang: "invalid
// operand"), not a [PC] access.
func TestLoadStoreRejectsNonMemoryOperands() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R0, Reg(R1))
	if !a.HasError { return fail("ldr r0, r1 accepted") }
	a = newAsm()
	Ldr(a, COND_AL, R0, Imm(5))
	if !a.HasError { return fail("ldr r0, #5 accepted") }
	a = newAsm()
	Strb(a, COND_AL, R0, Reg(R1))
	if !a.HasError { return fail("strb r0, r1 accepted") }
	a = newAsm()
	Ldrh(a, COND_AL, R0, Reg(R1))
	if !a.HasError { return fail("ldrh r0, r1 accepted") }
	a = newAsm()
	Ldrsb(a, COND_AL, R0, MemSReg(R1, R2, LSL, 1))
	if !a.HasError { return fail("ldrsb r0, [r1, r2, lsl #1] accepted") }
	return ""
}

// A same-section branch to a misaligned target, or a cross-section one whose addend is
// misaligned, cannot be encoded: ResolveFixups fails with the error set (clang:
// "Relocation not aligned") instead of leaving the branch unpatched.
func TestUnpatchableBranchFails() testing.TestResult {
	var a @asm.Assembler = newAsm()
	B(a, COND_AL, "odd")
	a.EmitUint8(1)
	a.DefineLabel("odd")
	if ResolveFixups(a) || !a.HasError { return fail("a misaligned same-section branch accepted") }
	a = newAsm()
	a.AddFixup("ext", FIX_BRANCH24, 2, 4)
	a.EmitUint32(0xEA000000)
	if ResolveFixups(a) || !a.HasError { return fail("a misaligned branch addend accepted") }
	return ""
}
