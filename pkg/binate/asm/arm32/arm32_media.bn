package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The saturating, parallel add / subtract, select, sum-of-absolute-differences and pack
// instructions, exact (arm32.bni): each checks its condition, registers and immediates and emits
// nothing when one has no encoding, with clang's message where clang rejects it.

// mediaRegsOk reports whether cond is a condition and the first n of the registers r0 .. r3 are
// R0..R15 and, when noPC, not PC, setting the assembler error if not.
func mediaRegsOk(a @asm.Assembler, cond int, noPC bool, n int, r0 int, r1 int, r2 int,
		r3 int) bool {
	if !condOk(a, cond) || !mulRegOk(a, r0, noPC) || !mulRegOk(a, r1, noPC) { return false }
	if n > 2 && !mulRegOk(a, r2, noPC) { return false }
	return n < 4 || mulRegOk(a, r3, noPC)
}

// mediaImmOk reports whether v is in [lo, hi], setting clang's error if not.
func mediaImmOk(a @asm.Assembler, v int, lo int, hi int) bool {
	if v >= lo && v <= hi { return true }
	if lo == 1 && hi == 32 { a.SetError("operand must be an immediate in the range [1,32]") }
	if lo == 0 && hi == 31 { a.SetError("operand must be an immediate in the range [0,31]") }
	if lo == 1 && hi == 16 { a.SetError("operand must be an immediate in the range [1,16]") }
	if lo == 0 && hi == 15 { a.SetError("operand must be an immediate in the range [0,15]") }
	return false
}

// qArith emits the saturating add / subtract op (bits 27:20 and 7:4) Rd, Rm, Rn.
func qArith(a @asm.Assembler, cond int, op uint32, rd int, rm int, rn int) {
	if !mediaRegsOk(a, cond, true, 3, rd, rm, rn, 0) { return }
	emit32(a, mulWord(cond, op, rn, rd, 0, rm))
}

// Qadd emits QADD Rd, Rm, Rn (Rm + Rn, saturated).
func Qadd(a @asm.Assembler, cond int, rd int, rm int, rn int) {
	qArith(a, cond, 0x01000050, rd, rm, rn)
}

// Qsub emits QSUB Rd, Rm, Rn (Rm - Rn, saturated).
func Qsub(a @asm.Assembler, cond int, rd int, rm int, rn int) {
	qArith(a, cond, 0x01200050, rd, rm, rn)
}

// Qdadd emits QDADD Rd, Rm, Rn (Rm + 2 * Rn, saturated).
func Qdadd(a @asm.Assembler, cond int, rd int, rm int, rn int) {
	qArith(a, cond, 0x01400050, rd, rm, rn)
}

// Qdsub emits QDSUB Rd, Rm, Rn (Rm - 2 * Rn, saturated).
func Qdsub(a @asm.Assembler, cond int, rd int, rm int, rn int) {
	qArith(a, cond, 0x01600050, rd, rm, rn)
}

// satShift returns a saturate's shift field (imm5 at bits 11:7, sh at bit 6): LSL #0..31 or
// ASR #1..32 (32 as 0), or ok false with the assembler error set.
func satShift(a @asm.Assembler, shift int, amount int) (uint32, bool) {
	if shift == LSL {
		if amount < 0 || amount > 31 {
			a.SetError("'lsl' shift amount must be in range [0,31]")
			return 0, false
		}
		return cast(uint32, amount) << 7, true
	}
	if shift == ASR {
		if amount < 1 || amount > 32 {
			a.SetError("'asr' shift amount must be in range [1,32]")
			return 0, false
		}
		return (cast(uint32, amount & 31) << 7) | 0x40, true
	}
	a.SetError("arm32: a saturate's shift is LSL or ASR")
	return 0, false
}

// Ssat emits SSAT Rd, #imm, Rn{, shift #amount}: imm 1..32, shift LSL (0..31) or ASR (1..32).
func Ssat(a @asm.Assembler, cond int, rd int, imm int, rn int, shift int, amount int) {
	if !mediaRegsOk(a, cond, true, 2, rd, rn, 0, 0) || !mediaImmOk(a, imm, 1, 32) { return }
	var sh uint32
	var ok bool
	sh, ok = satShift(a, shift, amount)
	if !ok { return }
	emit32(a, mulWord(cond, 0x06A00010 | sh, imm - 1, rd, 0, rn))
}

// Usat emits USAT Rd, #imm, Rn{, shift #amount}: imm 0..31, the shift as Ssat's.
func Usat(a @asm.Assembler, cond int, rd int, imm int, rn int, shift int, amount int) {
	if !mediaRegsOk(a, cond, true, 2, rd, rn, 0, 0) || !mediaImmOk(a, imm, 0, 31) { return }
	var sh uint32
	var ok bool
	sh, ok = satShift(a, shift, amount)
	if !ok { return }
	emit32(a, mulWord(cond, 0x06E00010 | sh, imm, rd, 0, rn))
}

// Ssat16 emits SSAT16 Rd, #imm, Rn (imm 1..16; ARMv6).
func Ssat16(a @asm.Assembler, cond int, rd int, imm int, rn int) {
	if !mediaRegsOk(a, cond, true, 2, rd, rn, 0, 0) || !mediaImmOk(a, imm, 1, 16) { return }
	emit32(a, mulWord(cond, 0x06A00F30, imm - 1, rd, 0, rn))
}

// Usat16 emits USAT16 Rd, #imm, Rn (imm 0..15; ARMv6).
func Usat16(a @asm.Assembler, cond int, rd int, imm int, rn int) {
	if !mediaRegsOk(a, cond, true, 2, rd, rn, 0, 0) || !mediaImmOk(a, imm, 0, 15) { return }
	emit32(a, mulWord(cond, 0x06E00F30, imm, rd, 0, rn))
}

// Parallel emits the parallel add / subtract of prefix (PAR_S .. PAR_UH) and op (PAR_ADD16 ..
// PAR_SUB8) Rd, Rn, Rm.
func Parallel(a @asm.Assembler, cond int, prefix int, op int, rd int, rn int, rm int) {
	if prefix != PAR_S && prefix != PAR_Q && prefix != PAR_SH && prefix != PAR_U && prefix != PAR_UQ &&
			prefix != PAR_UH {
		a.SetError("arm32: a parallel add / subtract prefix out of range")
		return
	}
	if op != PAR_ADD16 && op != PAR_ASX && op != PAR_SAX && op != PAR_SUB16 && op != PAR_ADD8 &&
			op != PAR_SUB8 {
		a.SetError("arm32: a parallel add / subtract operation out of range")
		return
	}
	if !mediaRegsOk(a, cond, true, 3, rd, rn, rm, 0) { return }
	var opBits uint32 = 0x06000F10 | (cast(uint32, prefix) << 20) | (cast(uint32, op) << 5)
	emit32(a, mulWord(cond, opBits, rn, rd, 0, rm))
}

// Sel emits SEL Rd, Rn, Rm (ARMv6).
func Sel(a @asm.Assembler, cond int, rd int, rn int, rm int) {
	if !mediaRegsOk(a, cond, false, 3, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x06800FB0, rn, rd, 0, rm))
}

// Usad8 emits USAD8 Rd, Rn, Rm (ARMv6).
func Usad8(a @asm.Assembler, cond int, rd int, rn int, rm int) {
	if !mediaRegsOk(a, cond, false, 3, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x07800010, rd, 15, rm, rn))
}

// Usada8 emits USADA8 Rd, Rn, Rm, Ra (ARMv6; Ra PC is USAD8, as clang has it).
func Usada8(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int) {
	if !mediaRegsOk(a, cond, false, 4, rd, rn, rm, ra) { return }
	emit32(a, mulWord(cond, 0x07800010, rd, ra, rm, rn))
}

// Pkhbt emits PKHBT Rd, Rn, Rm{, LSL #amount} (amount 0..31; ARMv6).
func Pkhbt(a @asm.Assembler, cond int, rd int, rn int, rm int, amount int) {
	if !mediaRegsOk(a, cond, true, 3, rd, rn, rm, 0) { return }
	if amount < 0 || amount > 31 {
		a.SetError("immediate value out of range")
		return
	}
	emit32(a, mulWord(cond, 0x06800010 | (cast(uint32, amount) << 7), rn, rd, 0, rm))
}

// Pkhtb emits PKHTB Rd, Rn, Rm, ASR #amount (amount 1..32; ARMv6).
func Pkhtb(a @asm.Assembler, cond int, rd int, rn int, rm int, amount int) {
	if !mediaRegsOk(a, cond, true, 3, rd, rn, rm, 0) { return }
	if amount < 1 || amount > 32 {
		a.SetError("immediate value out of range")
		return
	}
	emit32(a, mulWord(cond, 0x06800050 | (cast(uint32, amount & 31) << 7), rn, rd, 0, rm))
}
