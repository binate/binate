package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Every saturate, parallel add / subtract, select, absolute-difference and pack form against
// clang's words (Apple clang 21, armv7ve): each register form, SP and PC where clang takes them,
// each saturate width and shift at its ends, PKHTB with no shift as PKHBT with Rn and Rm
// exchanged.
func TestMediaGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Qadd(a, COND_AL, R0, R1, R2) // qadd r0, r1, r2
	Qadd(a, COND_AL, SP, R1, R2) // qadd sp, r1, r2
	Qadd(a, COND_AL, R0, SP, R2) // qadd r0, sp, r2
	Qadd(a, COND_AL, R0, R1, SP) // qadd r0, r1, sp
	Qsub(a, COND_AL, R0, R1, R2) // qsub r0, r1, r2
	Qsub(a, COND_AL, SP, R1, R2) // qsub sp, r1, r2
	Qsub(a, COND_AL, R0, SP, R2) // qsub r0, sp, r2
	Qsub(a, COND_AL, R0, R1, SP) // qsub r0, r1, sp
	Qdadd(a, COND_AL, R0, R1, R2) // qdadd r0, r1, r2
	Qdadd(a, COND_AL, SP, R1, R2) // qdadd sp, r1, r2
	Qdadd(a, COND_AL, R0, SP, R2) // qdadd r0, sp, r2
	Qdadd(a, COND_AL, R0, R1, SP) // qdadd r0, r1, sp
	Qdsub(a, COND_AL, R0, R1, R2) // qdsub r0, r1, r2
	Qdsub(a, COND_AL, SP, R1, R2) // qdsub sp, r1, r2
	Qdsub(a, COND_AL, R0, SP, R2) // qdsub r0, sp, r2
	Qdsub(a, COND_AL, R0, R1, SP) // qdsub r0, r1, sp
	Sel(a, COND_AL, R0, R1, R2) // sel r0, r1, r2
	Sel(a, COND_AL, PC, R1, R2) // sel pc, r1, r2
	Sel(a, COND_AL, SP, R1, R2) // sel sp, r1, r2
	Sel(a, COND_AL, R0, PC, R2) // sel r0, pc, r2
	Sel(a, COND_AL, R0, SP, R2) // sel r0, sp, r2
	Sel(a, COND_AL, R0, R1, PC) // sel r0, r1, pc
	Sel(a, COND_AL, R0, R1, SP) // sel r0, r1, sp
	Usad8(a, COND_AL, R0, R1, R2) // usad8 r0, r1, r2
	Usad8(a, COND_AL, PC, R1, R2) // usad8 pc, r1, r2
	Usad8(a, COND_AL, SP, R1, R2) // usad8 sp, r1, r2
	Usad8(a, COND_AL, R0, PC, R2) // usad8 r0, pc, r2
	Usad8(a, COND_AL, R0, SP, R2) // usad8 r0, sp, r2
	Usad8(a, COND_AL, R0, R1, PC) // usad8 r0, r1, pc
	Usad8(a, COND_AL, R0, R1, SP) // usad8 r0, r1, sp
	Parallel(a, COND_AL, PAR_S, PAR_ADD16, R0, R1, R2) // sadd16 r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_ASX, R0, R1, R2) // sasx r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_SAX, R0, R1, R2) // ssax r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_SUB16, R0, R1, R2) // ssub16 r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_ADD8, R0, R1, R2) // sadd8 r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_SUB8, R0, R1, R2) // ssub8 r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_ASX, R0, R1, R2) // saddsubx r0, r1, r2
	Parallel(a, COND_AL, PAR_S, PAR_SAX, R0, R1, R2) // ssubaddx r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_ADD16, R0, R1, R2) // qadd16 r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_ASX, R0, R1, R2) // qasx r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_SAX, R0, R1, R2) // qsax r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_SUB16, R0, R1, R2) // qsub16 r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_ADD8, R0, R1, R2) // qadd8 r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_SUB8, R0, R1, R2) // qsub8 r0, r1, r2
	Parallel(a, COND_AL, PAR_Q, PAR_SAX, R0, R1, R2) // qsubaddx r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_ADD16, R0, R1, R2) // shadd16 r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_ASX, R0, R1, R2) // shasx r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_SAX, R0, R1, R2) // shsax r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_SUB16, R0, R1, R2) // shsub16 r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_ADD8, R0, R1, R2) // shadd8 r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_SUB8, R0, R1, R2) // shsub8 r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_ASX, R0, R1, R2) // shaddsubx r0, r1, r2
	Parallel(a, COND_AL, PAR_SH, PAR_SAX, R0, R1, R2) // shsubaddx r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_ADD16, R0, R1, R2) // uadd16 r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_ASX, R0, R1, R2) // uasx r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_SAX, R0, R1, R2) // usax r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_SUB16, R0, R1, R2) // usub16 r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_ADD8, R0, R1, R2) // uadd8 r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_SUB8, R0, R1, R2) // usub8 r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_ASX, R0, R1, R2) // uaddsubx r0, r1, r2
	Parallel(a, COND_AL, PAR_U, PAR_SAX, R0, R1, R2) // usubaddx r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_ADD16, R0, R1, R2) // uqadd16 r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_ASX, R0, R1, R2) // uqasx r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_SAX, R0, R1, R2) // uqsax r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_SUB16, R0, R1, R2) // uqsub16 r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_ADD8, R0, R1, R2) // uqadd8 r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_SUB8, R0, R1, R2) // uqsub8 r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_ASX, R0, R1, R2) // uqaddsubx r0, r1, r2
	Parallel(a, COND_AL, PAR_UQ, PAR_SAX, R0, R1, R2) // uqsubaddx r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_ADD16, R0, R1, R2) // uhadd16 r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_ASX, R0, R1, R2) // uhasx r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_SAX, R0, R1, R2) // uhsax r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_SUB16, R0, R1, R2) // uhsub16 r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_ADD8, R0, R1, R2) // uhadd8 r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_SUB8, R0, R1, R2) // uhsub8 r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_ASX, R0, R1, R2) // uhaddsubx r0, r1, r2
	Parallel(a, COND_AL, PAR_UH, PAR_SAX, R0, R1, R2) // uhsubaddx r0, r1, r2
	Usada8(a, COND_AL, R0, R1, R2, R3) // usada8 r0, r1, r2, r3
	Usada8(a, COND_AL, PC, R1, R2, R3) // usada8 pc, r1, r2, r3
	Usada8(a, COND_AL, SP, R1, R2, R3) // usada8 sp, r1, r2, r3
	Usada8(a, COND_AL, R0, PC, R2, R3) // usada8 r0, pc, r2, r3
	Usada8(a, COND_AL, R0, SP, R2, R3) // usada8 r0, sp, r2, r3
	Usada8(a, COND_AL, R0, R1, PC, R3) // usada8 r0, r1, pc, r3
	Usada8(a, COND_AL, R0, R1, SP, R3) // usada8 r0, r1, sp, r3
	Usada8(a, COND_AL, R0, R1, R2, PC) // usada8 r0, r1, r2, pc
	Usada8(a, COND_AL, R0, R1, R2, SP) // usada8 r0, r1, r2, sp
	Ssat(a, COND_AL, R0, 8, R1, LSL, 0) // ssat r0, #8, r1
	Ssat(a, COND_AL, SP, 8, R1, LSL, 0) // ssat sp, #8, r1
	Ssat(a, COND_AL, R0, 8, SP, LSL, 0) // ssat r0, #8, sp
	Ssat(a, COND_AL, R0, 8, R1, LSL, 0) // ssat r0, #8, r1, lsl #0
	Ssat(a, COND_AL, R0, 8, R1, LSL, 1) // ssat r0, #8, r1, lsl #1
	Ssat(a, COND_AL, R0, 8, R1, LSL, 31) // ssat r0, #8, r1, lsl #31
	Ssat(a, COND_AL, R0, 8, R1, ASR, 1) // ssat r0, #8, r1, asr #1
	Ssat(a, COND_AL, R0, 8, R1, ASR, 31) // ssat r0, #8, r1, asr #31
	Ssat(a, COND_AL, R0, 8, R1, ASR, 32) // ssat r0, #8, r1, asr #32
	Ssat(a, COND_AL, R0, 8, R1, LSL, 3) // ssat r0, #8, r1, LSL #3
	Ssat(a, COND_AL, R0, 1, R1, LSL, 0) // ssat r0, #1, r1
	Ssat(a, COND_AL, R0, 15, R1, LSL, 0) // ssat r0, #15, r1
	Ssat(a, COND_AL, R0, 16, R1, LSL, 0) // ssat r0, #16, r1
	Ssat(a, COND_AL, R0, 17, R1, LSL, 0) // ssat r0, #17, r1
	Ssat(a, COND_AL, R0, 31, R1, LSL, 0) // ssat r0, #31, r1
	Ssat(a, COND_AL, R0, 32, R1, LSL, 0) // ssat r0, #32, r1
	Ssat(a, COND_AL, R0, 8, R1, LSL, 0) // ssat r0, 8, r1
	Usat(a, COND_AL, R0, 7, R1, LSL, 0) // usat r0, #7, r1
	Usat(a, COND_AL, SP, 7, R1, LSL, 0) // usat sp, #7, r1
	Usat(a, COND_AL, R0, 7, SP, LSL, 0) // usat r0, #7, sp
	Usat(a, COND_AL, R0, 7, R1, LSL, 0) // usat r0, #7, r1, lsl #0
	Usat(a, COND_AL, R0, 7, R1, LSL, 1) // usat r0, #7, r1, lsl #1
	Usat(a, COND_AL, R0, 7, R1, LSL, 31) // usat r0, #7, r1, lsl #31
	Usat(a, COND_AL, R0, 7, R1, ASR, 1) // usat r0, #7, r1, asr #1
	Usat(a, COND_AL, R0, 7, R1, ASR, 31) // usat r0, #7, r1, asr #31
	Usat(a, COND_AL, R0, 7, R1, ASR, 32) // usat r0, #7, r1, asr #32
	Usat(a, COND_AL, R0, 7, R1, LSL, 3) // usat r0, #7, r1, LSL #3
	Usat(a, COND_AL, R0, 0, R1, LSL, 0) // usat r0, #0, r1
	Usat(a, COND_AL, R0, 1, R1, LSL, 0) // usat r0, #1, r1
	Usat(a, COND_AL, R0, 15, R1, LSL, 0) // usat r0, #15, r1
	Usat(a, COND_AL, R0, 16, R1, LSL, 0) // usat r0, #16, r1
	Usat(a, COND_AL, R0, 17, R1, LSL, 0) // usat r0, #17, r1
	Usat(a, COND_AL, R0, 31, R1, LSL, 0) // usat r0, #31, r1
	Usat(a, COND_AL, R0, 8, R1, LSL, 0) // usat r0, 8, r1
	Ssat16(a, COND_AL, R0, 8, R1) // ssat16 r0, #8, r1
	Ssat16(a, COND_AL, SP, 8, R1) // ssat16 sp, #8, r1
	Ssat16(a, COND_AL, R0, 8, SP) // ssat16 r0, #8, sp
	Ssat16(a, COND_AL, R0, 1, R1) // ssat16 r0, #1, r1
	Ssat16(a, COND_AL, R0, 15, R1) // ssat16 r0, #15, r1
	Ssat16(a, COND_AL, R0, 16, R1) // ssat16 r0, #16, r1
	Ssat16(a, COND_AL, R0, 8, R1) // ssat16 r0, 8, r1
	Usat16(a, COND_AL, R0, 7, R1) // usat16 r0, #7, r1
	Usat16(a, COND_AL, SP, 7, R1) // usat16 sp, #7, r1
	Usat16(a, COND_AL, R0, 7, SP) // usat16 r0, #7, sp
	Usat16(a, COND_AL, R0, 0, R1) // usat16 r0, #0, r1
	Usat16(a, COND_AL, R0, 1, R1) // usat16 r0, #1, r1
	Usat16(a, COND_AL, R0, 15, R1) // usat16 r0, #15, r1
	Usat16(a, COND_AL, R0, 8, R1) // usat16 r0, 8, r1
	Pkhbt(a, COND_AL, R0, R1, R2, 0) // pkhbt r0, r1, r2
	Pkhbt(a, COND_AL, SP, R1, R2, 0) // pkhbt sp, r1, r2
	Pkhbt(a, COND_AL, R0, SP, R2, 0) // pkhbt r0, sp, r2
	Pkhbt(a, COND_AL, R0, R1, SP, 0) // pkhbt r0, r1, sp
	Pkhbt(a, COND_AL, R0, R1, R2, 0) // pkhbt r0, r1, r2, lsl #0
	Pkhbt(a, COND_AL, R0, R1, R2, 1) // pkhbt r0, r1, r2, lsl #1
	Pkhbt(a, COND_AL, R0, R1, R2, 31) // pkhbt r0, r1, r2, lsl #31
	Pkhbt(a, COND_AL, R0, R1, R2, 3) // pkhbt r0, r1, r2, LSL #3
	Pkhbt(a, COND_AL, R0, R1, R2, 3) // pkhbt r0, r1, r2, asl #3
	Pkhbt(a, COND_AL, R0, R2, R1, 0) // pkhtb r0, r1, r2
	Pkhbt(a, COND_AL, SP, R2, R1, 0) // pkhtb sp, r1, r2
	Pkhbt(a, COND_AL, R0, R2, SP, 0) // pkhtb r0, sp, r2
	Pkhbt(a, COND_AL, R0, SP, R1, 0) // pkhtb r0, r1, sp
	Pkhtb(a, COND_AL, R0, R1, R2, 1) // pkhtb r0, r1, r2, asr #1
	Pkhtb(a, COND_AL, R0, R1, R2, 31) // pkhtb r0, r1, r2, asr #31
	Pkhtb(a, COND_AL, R0, R1, R2, 32) // pkhtb r0, r1, r2, asr #32
	Pkhtb(a, COND_AL, R0, R1, R2, 3) // pkhtb r0, r1, r2, ASR #3
	Ssat(a, COND_AL, R0, 8, R1, LSL, 4) // ssat r0, #8, r1, lsl #4
	Ssat(a, COND_AL, R0, 8, R1, ASR, 4) // ssat r0, #8, r1, asr #4
	Usat(a, COND_AL, R0, 7, R1, ASR, 3) // usat r0, #7, r1, asr #3
	Pkhbt(a, COND_AL, R0, R1, R2, 4) // pkhbt r0, r1, r2, lsl #4
	Pkhtb(a, COND_AL, R0, R1, R2, 4) // pkhtb r0, r1, r2, asr #4
	Pkhbt(a, COND_EQ, R0, R1, R2, 4) // pkhbteq r0, r1, r2, lsl #4
	Parallel(a, COND_EQ, PAR_S, PAR_ADD16, R0, R1, R2) // sadd16eq r0, r1, r2
	Ssat(a, COND_EQ, R0, 8, R1, LSL, 0) // ssateq r0, #8, r1
	if a.HasError { return fail(a.ErrorMsg) }
	var want @[]uint32 = make_slice(uint32, 159)
	want[0] = 0xE1020051
