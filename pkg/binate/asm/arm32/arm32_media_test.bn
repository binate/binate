	want[132] = 0xE6EF0F31
	want[133] = 0xE6E80F31
	want[134] = 0xE6810012
	want[135] = 0xE681D012
	want[136] = 0xE68D0012
	want[137] = 0xE681001D
	want[138] = 0xE6810012
	want[139] = 0xE6810092
	want[140] = 0xE6810F92
	want[141] = 0xE6810192
	want[142] = 0xE6810192
	want[143] = 0xE6820011
	want[144] = 0xE682D011
	want[145] = 0xE682001D
	want[146] = 0xE68D0011
	want[147] = 0xE68100D2
	want[148] = 0xE6810FD2
	want[149] = 0xE6810052
	want[150] = 0xE68101D2
	want[151] = 0xE6A70211
	want[152] = 0xE6A70251
	want[153] = 0xE6E701D1
	want[154] = 0xE6810212
	want[155] = 0xE6810252
	want[156] = 0x06810212
	want[157] = 0x06110F12
	want[158] = 0x06A70011

	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] {
			return fail("a media instruction encoded unlike clang")
		}
	}
	return ""
}

// mediaRejected reports whether a holds an error and no bytes.
func mediaRejected(a @asm.Assembler) bool { return a.HasError && a.Sections[0].Len == 0 }

// The media instructions refuse what clang does -- PC where it rejects it, a saturate width or a
// shift outside its range, a saturate shift other than LSL or ASR -- and what has no encoding: a
// prefix or an operation of no parallel add / subtract, a register outside R0..R15 (USADA8's Ra
// too), a condition past COND_AL; nothing is emitted.
func TestMediaRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Qadd(a, COND_AL, R0, R1, PC)
	if !mediaRejected(a) { return fail("QADD Rn PC accepted") }
	a = newAsm()
	Parallel(a, COND_AL, PAR_UH, PAR_SUB8, PC, R1, R2)
	if !mediaRejected(a) { return fail("UHSUB8 Rd PC accepted") }
	a = newAsm()
	Parallel(a, COND_AL, 4, PAR_ADD16, R0, R1, R2)
	if !mediaRejected(a) { return fail("a parallel prefix 4 accepted") }
	a = newAsm()
	Parallel(a, COND_AL, PAR_S, 5, R0, R1, R2)
	if !mediaRejected(a) { return fail("a parallel operation 5 accepted") }
	a = newAsm()
	Ssat(a, COND_AL, R0, 33, R1, LSL, 0)
	if !mediaRejected(a) { return fail("SSAT #33 accepted") }
	a = newAsm()
	Ssat(a, COND_AL, R0, 0, R1, LSL, 0)
	if !mediaRejected(a) { return fail("SSAT #0 accepted") }
	a = newAsm()
	Usat(a, COND_AL, R0, 32, R1, LSL, 0)
	if !mediaRejected(a) { return fail("USAT #32 accepted") }
	a = newAsm()
	Ssat16(a, COND_AL, R0, 17, R1)
	if !mediaRejected(a) { return fail("SSAT16 #17 accepted") }
	a = newAsm()
	Usat16(a, COND_AL, R0, 16, R1)
	if !mediaRejected(a) { return fail("USAT16 #16 accepted") }
	a = newAsm()
	Ssat(a, COND_AL, R0, 8, R1, LSL, 32)
	if !mediaRejected(a) { return fail("SSAT LSL #32 accepted") }
	a = newAsm()
	Usat(a, COND_AL, R0, 8, R1, ASR, 0)
	if !mediaRejected(a) { return fail("USAT ASR #0 accepted") }
	a = newAsm()
	Ssat(a, COND_AL, R0, 8, R1, ROR, 1)
	if !mediaRejected(a) { return fail("SSAT ROR accepted") }
	a = newAsm()
	Ssat(a, COND_AL, PC, 8, R1, LSL, 0)
	if !mediaRejected(a) { return fail("SSAT Rd PC accepted") }
	a = newAsm()
	Pkhbt(a, COND_AL, R0, R1, R2, 32)
	if !mediaRejected(a) { return fail("PKHBT LSL #32 accepted") }
	a = newAsm()
	Pkhtb(a, COND_AL, R0, R1, R2, 0)
	if !mediaRejected(a) { return fail("PKHTB ASR #0 accepted") }
	a = newAsm()
	Pkhtb(a, COND_AL, R0, R1, PC, 4)
	if !mediaRejected(a) { return fail("PKHTB Rm PC accepted") }
	a = newAsm()
	Usada8(a, COND_AL, R0, R1, R2, -1)
	if !mediaRejected(a) { return fail("USADA8 Ra -1 accepted") }
	a = newAsm()
	Sel(a, 15, R0, R1, R2)
	if !mediaRejected(a) { return fail("SEL under condition 15 accepted") }
	return ""
}

// The data-processing, move-wide and ADR encoders check their condition too: one past COND_AL is
// an error with nothing emitted, not masked into the instruction's top bits.
func TestConditionChecked() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, 15, false, R0, R1, Imm(1))
	if !mediaRejected(a) { return fail("ADD under condition 15 accepted") }
	a = newAsm()
	Movw(a, 16, R0, 1)
	if !mediaRejected(a) { return fail("MOVW under condition 16 accepted") }
	a = newAsm()
	MovtRef(a, -1, R0, "ext", FIX_MOVT_ABS, 0)
	if !mediaRejected(a) || a.Sections[0].NumFixups != 0 {
		return fail("MOVT under condition -1 accepted")
	}
	a = newAsm()
	Adr(a, 15, R0, "lbl", 0)
	if !mediaRejected(a) || a.Sections[0].NumFixups != 0 {
		return fail("ADR under condition 15 accepted")
	}
	return ""
}
