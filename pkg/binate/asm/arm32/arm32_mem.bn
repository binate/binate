package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// --- Load/Store word and byte ---
// ARM encoding A5.2.2 (LDR/STR) and A5.2.3 (LDRB/STRB)
//
// Format: cond[31:28] | 01 | I[25] | P[24] | U[23] | B[22] | W[21]
//         | L[20] | Rn[19:16] | Rt[15:12] | offset[11:0]
//
// I=0: immediate offset (offset[11:0] is 12-bit unsigned)
// I=1: register offset (shift_imm[11:7] | shift[6:5] | 0[4] | Rm[3:0])
// P=1: pre-indexed / offset; P=0: post-indexed
// U=1: add offset; U=0: subtract offset
// B=1: byte; B=0: word
// W=1: writeback (with P=1: pre-indexed); W=0: no writeback
// L=1: load; L=0: store

// imm12Offset returns the 12-bit immediate-offset field for `offset` (a byte
// displacement), erroring on the assembler if its magnitude exceeds 4095.  An
// assembler must NOT silently emit a wrapped (wrong-slot) access — the
// programmer wrote a specific offset; a displacement past the encodable range
// needs a different instruction sequence, not a truncated one.  The sign (U
// bit) is selected by the caller; this returns only the masked magnitude.
func imm12Offset(a @asm.Assembler, offset int) uint32 {
	var mag int = offset
	if mag < 0 { mag = -mag }
	if mag > 0xfff {
		a.SetError("arm32: LDR/STR immediate offset out of range "
				"(magnitude must fit 4095)")
	}
	return cast(uint32, mag & 0xfff)
}

// imm8SplitOffset returns the split immH:immL 8-bit immediate-offset field
// (the extra-load/store encoding: immH in [11:8], immL in [3:0]) for `offset`,
// erroring on the assembler if its magnitude exceeds 255.  See imm12Offset for
// the rationale.
func imm8SplitOffset(a @asm.Assembler, offset int) uint32 {
	var mag int = offset
	if mag < 0 { mag = -mag }
	if mag > 0xff {
		a.SetError(
				"arm32: LDRH/STRH/LDRSB/LDRSH immediate offset out of "
						"range (magnitude must fit 255)")
	}
	var immH uint32 = cast(uint32, (mag >> 4) & 0xf)
	var immL uint32 = cast(uint32, mag & 0xf)
	return (immH << 8) | immL
}

// isMemIndexKind reports whether kind is a register-indexed memory operand: an
// offset, pre-indexed or post-indexed register index, plain or shifted.
func isMemIndexKind(kind int) bool {
	return kind == OP_MEM_REG || kind == OP_MEM_SREG || kind == OP_MEM_PRE_REG ||
			kind == OP_MEM_POST_REG || kind == OP_MEM_PRE_SREG || kind == OP_MEM_POST_SREG
}

// memRegsOk reports whether Rt and op's base and index registers are R0..R15 and op
// subtracts (SubIndex) only a register index, setting the assembler error otherwise —
// so no register number is masked into another register's field, and no subtraction
// is dropped.
func memRegsOk(a @asm.Assembler, rt int, op Operand) bool {
	if !isCoreReg(rt) {
		a.SetError("arm32: a load / store register must be R0..R15")
		return false
	}
	var isMem bool = op.Kind == OP_MEM_IMM || op.Kind == OP_MEM_PRE || op.Kind == OP_MEM_POST ||
			isMemIndexKind(op.Kind)
	if isMem && !isCoreReg(op.Reg) {
		a.SetError("arm32: a load / store base register must be R0..R15")
		return false
	}
	if isMemIndexKind(op.Kind) && !isCoreReg(op.Reg2) {
		a.SetError("arm32: a load / store index register must be R0..R15")
		return false
	}
	if op.Sub && !isMemIndexKind(op.Kind) {
		a.SetError("arm32: only a register index can be subtracted (SubIndex)")
		return false
	}
	return true
}

// ldrstrEnc encodes LDR/STR/LDRB/STRB with a memory operand.
func ldrstrEnc(a @asm.Assembler, cond int, load bool, byteOp bool, rt int, op Operand) uint32 {
	var inst uint32 = condBits(cond) | 0x04000000 // 01 in bits [27:26]
	if !memRegsOk(a, rt, op) { return inst }

	if load {
		inst = inst | (1 << 20) // L bit
	}
	if byteOp {
		inst = inst | (1 << 22) // B bit
	}
	inst = inst | (cast(uint32, rt & 0xf) << 12)

	if op.Kind == OP_MEM_IMM {
		// [Rn, #imm] — immediate offset, pre-indexed, no writeback
		inst = inst | (1 << 24) // P=1 (offset/pre)
		inst = inst | (cast(uint32, op.Reg & 0xf) << 16)
		var offset int = op.Imm
		if offset >= 0 {
			inst = inst | (1 << 23) // U=1 (add); else U=0 (subtract)
		}
		inst = inst | imm12Offset(a, offset)
		return inst
	}
	if isMemIndexKind(op.Kind) {
		// A register index, optionally shifted by an immediate (`rrx` included):
		// I=1.  P=1 for the offset and pre-indexed forms, W=1 for pre-indexed;
		// U=1 adds the index, U=0 (SubIndex) subtracts it.
		var ok bool
		var shiftBits uint32
		ok, shiftBits = encodeImmShift(a, op.Shift, op.ShAmt)
		if !ok { return inst }
		inst = inst | (1 << 25) // I=1
		if op.Kind != OP_MEM_POST_REG && op.Kind != OP_MEM_POST_SREG {
			inst = inst | (1 << 24) // P=1
		}
		if op.Kind == OP_MEM_PRE_REG || op.Kind == OP_MEM_PRE_SREG {
			inst = inst | (1 << 21) // W=1
		}
		if !op.Sub {
			inst = inst | (1 << 23) // U=1
		}
		inst = inst | (cast(uint32, op.Reg & 0xf) << 16)
		inst = inst | shiftBits
		inst = inst | cast(uint32, op.Reg2 & 0xf)
		return inst
	}
	if op.Kind == OP_MEM_PRE {
		// [Rn, #imm]! — immediate pre-indexed with writeback
		inst = inst | (1 << 24) // P=1
		inst = inst | (1 << 21) // W=1
		inst = inst | (cast(uint32, op.Reg & 0xf) << 16)
		var offset int = op.Imm
		if offset >= 0 {
			inst = inst | (1 << 23)
		}
		inst = inst | imm12Offset(a, offset)
		return inst
	}
	if op.Kind == OP_MEM_POST {
		// [Rn], #imm — immediate post-indexed
		// P=0, W=0 (post-indexed encoding)
		inst = inst | (cast(uint32, op.Reg & 0xf) << 16)
		var offset int = op.Imm
		if offset >= 0 {
			inst = inst | (1 << 23)
		}
		inst = inst | imm12Offset(a, offset)
		return inst
	}
	// Anything else (a register, an immediate) has no LDR / STR encoding; a label reaches
	// here only as its [PC, #0] literal form (ldrstrEmit).
	a.SetError("arm32: LDR / STR / LDRB / STRB take a memory operand ([Rn, ...]) or a label")
	return inst
}

// ldrstrEmit emits LDR / STR / LDRB / STRB (load, byteOp) Rt, op — for a label, the
// PC-relative form `[PC, #0]` with a FIX_LDR_PC_G0 fixup, which ResolveFixups fills in — or,
// when op has no encoding, sets the assembler error and emits nothing.
func ldrstrEmit(a @asm.Assembler, cond int, load bool, byteOp bool, rt int, op Operand) {
	var mem Operand = op
	if op.Kind == OP_LABEL { mem = MemImm(PC, 0) }
	var inst uint32 = ldrstrEnc(a, cond, load, byteOp, rt, mem)
	if a.HasError { return }
	if op.Kind == OP_LABEL { a.AddFixup(op.Label, FIX_LDR_PC_G0, op.Imm, 4) }
	emit32(a, inst)
}

// Ldr emits `LDR{cond} Rt, op` — load 32-bit word; a Label op is the PC-relative load of
// the word at the label (plus its addend).
func Ldr(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, true, false, rt, op)
}

// Str emits `STR{cond} Rt, op` — store 32-bit word.
func Str(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, false, false, rt, op)
}

// Ldrb emits `LDRB{cond} Rt, op` — load zero-extended byte.
func Ldrb(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, true, true, rt, op)
}

// Strb emits `STRB{cond} Rt, op` — store the low byte of Rt.
func Strb(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, false, true, rt, op)
}

// --- Load/Store halfword and signed byte ---
// ARM encoding A5.2.8 (extra load/stores)
//
// Format: cond[31:28] | 000 | P[24] | U[23] | I[22] | W[21] | L[20]
//         | Rn[19:16] | Rt[15:12] | immH[11:8] | 1 | SH[6:5] | 1
//         | immL/Rm[3:0]
//
// I=1: immediate (immH:immL is 8-bit unsigned offset, split)
// I=0: register (Rm in [3:0])
// SH: 01=H (unsigned halfword), 10=SB (signed byte), 11=SH (signed half)

// ldrstrHalfEnc encodes LDRH/STRH/LDRSB/LDRSH with a memory operand.
// sh selects the operation: 01=H, 10=SB, 11=SH.
func ldrstrHalfEnc(a @asm.Assembler, cond int, load bool, sh int, rt int, op Operand) uint32 {
	var inst uint32 = condBits(cond)
	if !memRegsOk(a, rt, op) { return inst }

	if load {
		inst = inst | (1 << 20)
	}
	inst = inst | (cast(uint32, rt & 0xf) << 12)
	inst = inst | (1 << 7) // bit 7 = 1
	inst = inst | (cast(uint32, sh & 3) << 5)
	inst = inst | (1 << 4) // bit 4 = 1

	if op.Kind == OP_MEM_IMM || op.Kind == OP_MEM_PRE || op.Kind == OP_MEM_POST {
		// Immediate mode
		inst = inst | (1 << 22) // I=1 for immediate in this encoding
		inst = inst | (cast(uint32, op.Reg & 0xf) << 16)

		if op.Kind != OP_MEM_POST {
			inst = inst | (1 << 24) // P=1
		}
		if op.Kind == OP_MEM_PRE {
			inst = inst | (1 << 21) // W=1
		}

		var offset int = op.Imm
		if offset >= 0 {
			inst = inst | (1 << 23) // U=1
		}
		inst = inst | imm8SplitOffset(a, offset)
		return inst
	}
	if op.Kind == OP_MEM_REG || op.Kind == OP_MEM_PRE_REG || op.Kind == OP_MEM_POST_REG {
		// Register mode: I=0
		inst = inst | (cast(uint32, op.Reg & 0xf) << 16)
		inst = inst | cast(uint32, op.Reg2 & 0xf)

		if op.Kind != OP_MEM_POST_REG {
			inst = inst | (1 << 24) // P=1
		}
		if op.Kind == OP_MEM_PRE_REG {
			inst = inst | (1 << 21) // W=1
		}
		if !op.Sub {
			inst = inst | (1 << 23) // U=1 (add); U=0 subtracts (SubIndex)
		}
		return inst
	}

	// Anything else — a shifted register offset (these forms take none), a register, an
	// immediate — has no encoding; a label reaches here only as [PC, #0] (ldrstrHalfEmit).
	a.SetError(
			"arm32: LDRH / STRH / LDRSB / LDRSH take an [Rn, #imm] / [Rn, Rm] form (no shift) or a label")
	return inst
}

// ldrstrHalfEmit emits LDRH / STRH / LDRSB / LDRSH (load, sh) Rt, op — for a label, the
// PC-relative form `[PC, #0]` with a FIX_LDRS_PC_G0 fixup, which ResolveFixups fills in —
// or, when op has no encoding, sets the assembler error and emits nothing.
func ldrstrHalfEmit(a @asm.Assembler, cond int, load bool, sh int, rt int, op Operand) {
	var mem Operand = op
	if op.Kind == OP_LABEL { mem = MemImm(PC, 0) }
	var inst uint32 = ldrstrHalfEnc(a, cond, load, sh, rt, mem)
	if a.HasError { return }
	if op.Kind == OP_LABEL { a.AddFixup(op.Label, FIX_LDRS_PC_G0, op.Imm, 4) }
	emit32(a, inst)
}

// SH_H is the SH field value for an unsigned halfword load/store.
const SH_H int = 1

// SH_SB is the SH field value for a signed-byte load.
const SH_SB int = 2

// SH_SH is the SH field value for a signed-halfword load.
const SH_SH int = 3

// Ldrh emits `LDRH{cond} Rt, op` — load zero-extended halfword.
func Ldrh(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, true, SH_H, rt, op)
}

// Strh emits `STRH{cond} Rt, op` — store the low halfword of Rt.
func Strh(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, false, SH_H, rt, op)
}

// Ldrsb emits `LDRSB{cond} Rt, op` — load sign-extended byte.
func Ldrsb(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, true, SH_SB, rt, op)
}

// Ldrsh emits `LDRSH{cond} Rt, op` — load sign-extended halfword.
func Ldrsh(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, true, SH_SH, rt, op)
}
