package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The loads and stores, exact (arm32.bni): each checks its condition and registers, PC and
// writeback as clang takes them, and its offset's range, and emits nothing when one has no
// encoding.  This file holds the shared checks and the word / byte forms (A5.2.2 / A5.2.3):
//
//	cond[31:28] | 01 | I[25] | P[24] | U[23] | B[22] | W[21] | L[20] | Rn[19:16] | Rt[15:12]
//	| imm12, or shift_imm[11:7] shift[6:5] 0 Rm[3:0]
//
// I=1 for a register index; P=0 post-indexed (with W=1 the unprivileged T form), P=1 W=1
// pre-indexed; U=1 adds the offset, U=0 subtracts it.

// imm12Offset returns the 12-bit immediate-offset field for `offset` (a byte displacement),
// erroring on the assembler if its magnitude exceeds 4095: a displacement past the encodable
// range needs a different instruction sequence, not a truncated one.  The sign (U bit) is
// memAdds's.
func imm12Offset(a @asm.Assembler, offset int) uint32 {
	var mag int = offset
	if mag < 0 { mag = -mag }
	if mag > 0xfff {
		a.SetError("arm32: LDR/STR immediate offset out of range "
				"(magnitude must fit 4095)")
	}
	return cast(uint32, mag & 0xfff)
}

// isMemIndexKind reports whether kind is a register-indexed memory operand: an
// offset, pre-indexed or post-indexed register index, plain or shifted.
func isMemIndexKind(kind int) bool {
	return kind == OP_MEM_REG || kind == OP_MEM_SREG || kind == OP_MEM_PRE_REG ||
			kind == OP_MEM_POST_REG || kind == OP_MEM_PRE_SREG || kind == OP_MEM_POST_SREG
}

// isMemImmKind reports whether kind is an immediate-offset memory operand: offset, pre-indexed
// or post-indexed.
func isMemImmKind(kind int) bool {
	return kind == OP_MEM_IMM || kind == OP_MEM_PRE || kind == OP_MEM_POST
}

// isMemPostKind reports whether kind is a post-indexed memory operand: an immediate, a register
// or a shifted register.
func isMemPostKind(kind int) bool {
	return kind == OP_MEM_POST || kind == OP_MEM_POST_REG || kind == OP_MEM_POST_SREG
}

// memWriteback reports whether op writes its base back: a pre- or post-indexed form.
func memWriteback(op Operand) bool {
	return op.Kind == OP_MEM_PRE || op.Kind == OP_MEM_PRE_REG || op.Kind == OP_MEM_PRE_SREG ||
			isMemPostKind(op.Kind)
}

// memAdds reports whether op's offset is added to its base (the U bit): not subtracted
// (SubIndex) and not negative.
func memAdds(op Operand) bool { return !op.Sub && op.Imm >= 0 }

// memRegsOk reports whether Rt and op's base and index registers are R0..R15 and op subtracts
// (SubIndex) only a register index or a zero immediate offset (`[Rn, #-0]`, clang's negative
// zero), setting the assembler error otherwise -- so no register number is masked into another
// register's field, and no subtraction is dropped.
func memRegsOk(a @asm.Assembler, rt int, op Operand) bool {
	if !isCoreReg(rt) {
		a.SetError("arm32: a load / store register must be R0..R15")
		return false
	}
	if (isMemImmKind(op.Kind) || isMemIndexKind(op.Kind)) && !isCoreReg(op.Reg) {
		a.SetError("arm32: a load / store base register must be R0..R15")
		return false
	}
	if isMemIndexKind(op.Kind) && !isCoreReg(op.Reg2) {
		a.SetError("arm32: a load / store index register must be R0..R15")
		return false
	}
	if op.Sub && !isMemIndexKind(op.Kind) && !(isMemImmKind(op.Kind) && op.Imm == 0) {
		a.SetError("arm32: only a register index or a zero offset can be subtracted (SubIndex)")
		return false
	}
	return true
}

// memOk reports whether a load (load) or store of Rt through op passes the checks every load /
// store makes -- its condition, memRegsOk -- and, unless unpriv (the T forms, which clang takes
// so), that a form writing its base back does not name Rt as the base, with clang's message.
func memOk(a @asm.Assembler, cond int, load bool, unpriv bool, rt int, op Operand) bool {
	if !condOk(a, cond) || !memRegsOk(a, rt, op) { return false }
	if !unpriv && memWriteback(op) && op.Reg == rt {
		if load {
			a.SetError("destination register and base register can't be identical")
		} else {
			a.SetError("source register and base register can't be identical")
		}
		return false
	}
	return true
}

// ldrstrEnc encodes LDR / STR / LDRB / STRB (load, byteOp), or with unpriv their T forms, of Rt
// through the memory operand op, or sets the assembler error: LDRB / STRB take PC as Rt only
// writing their base back (their T forms always), and a T form takes only a post-indexed operand.
func ldrstrEnc(a @asm.Assembler, cond int, load bool, byteOp bool, unpriv bool, rt int,
		op Operand) uint32 {
	if !memOk(a, cond, load, unpriv, rt, op) { return 0 }
	if !isMemImmKind(op.Kind) && !isMemIndexKind(op.Kind) {
		// A register or an immediate has no LDR / STR encoding; a label reaches here only as its
		// [PC, #0] literal form (ldrstrEmit).
		a.SetError("arm32: LDR / STR / LDRB / STRB take a memory operand ([Rn, ...]) or a label")
		return 0
	}
	if byteOp && !unpriv && rt == PC && !memWriteback(op) {
		// clang takes PC as LDRB / STRB's Rt only in a form writing its base back.
		a.SetError("operand must be a register in range [r0, r14]")
		return 0
	}
	if unpriv && !isMemPostKind(op.Kind) {
		a.SetError("arm32: LDRT / STRT / LDRBT / STRBT take a post-indexed operand")
		return 0
	}
	var inst uint32 = condBits(cond) | 0x04000000 | (cast(uint32, op.Reg) << 16) |
			(cast(uint32, rt) << 12)
	if load { inst = inst | (1 << 20) }
	if byteOp { inst = inst | (1 << 22) }
	if memAdds(op) { inst = inst | (1 << 23) }
	if !isMemPostKind(op.Kind) { inst = inst | (1 << 24) }
	if memWriteback(op) && (unpriv || !isMemPostKind(op.Kind)) { inst = inst | (1 << 21) }
	if isMemImmKind(op.Kind) { return inst | imm12Offset(a, op.Imm) }
	// A register index, optionally shifted by an immediate (`rrx` included): I=1.
	var ok bool
	var shiftBits uint32
	ok, shiftBits = encodeImmShift(a, op.Shift, op.ShAmt)
	if !ok { return inst }
	return inst | (1 << 25) | shiftBits | cast(uint32, op.Reg2)
}

// ldrstrEmit emits LDR / STR / LDRB / STRB (load, byteOp) Rt, op -- for a label, the
// PC-relative form `[PC, #0]` with a FIX_LDR_PC_G0 fixup, which ResolveFixups fills in -- or,
// when op has no encoding, sets the assembler error and emits nothing.
func ldrstrEmit(a @asm.Assembler, cond int, load bool, byteOp bool, rt int, op Operand) {
	var mem Operand = op
	if op.Kind == OP_LABEL { mem = MemImm(PC, 0) }
	var inst uint32 = ldrstrEnc(a, cond, load, byteOp, false, rt, mem)
	if a.HasError { return }
	if op.Kind == OP_LABEL { a.AddFixup(op.Label, FIX_LDR_PC_G0, cast(int64, op.Imm), 4) }
	emit32(a, inst)
}

// ldrstrTEmit emits LDRT / STRT / LDRBT / STRBT (load, byteOp) Rt, op, or sets the assembler
// error and emits nothing.
func ldrstrTEmit(a @asm.Assembler, cond int, load bool, byteOp bool, rt int, op Operand) {
	var inst uint32 = ldrstrEnc(a, cond, load, byteOp, true, rt, op)
	if !a.HasError { emit32(a, inst) }
}

// Ldr emits `LDR{cond} Rt, op` -- load 32-bit word; a Label op is the PC-relative load of
// the word at the label (plus its addend).
func Ldr(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, true, false, rt, op)
}

// Str emits `STR{cond} Rt, op` -- store 32-bit word.
func Str(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, false, false, rt, op)
}

// Ldrb emits `LDRB{cond} Rt, op` -- load zero-extended byte.
func Ldrb(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, true, true, rt, op)
}

// Strb emits `STRB{cond} Rt, op` -- store the low byte of Rt.
func Strb(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrEmit(a, cond, false, true, rt, op)
}

// Ldrt emits `LDRT{cond} Rt, op` -- load word unprivileged.
func Ldrt(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrTEmit(a, cond, true, false, rt, op)
}

// Strt emits `STRT{cond} Rt, op` -- store word unprivileged.
func Strt(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrTEmit(a, cond, false, false, rt, op)
}

// Ldrbt emits `LDRBT{cond} Rt, op` -- load zero-extended byte unprivileged.
func Ldrbt(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrTEmit(a, cond, true, true, rt, op)
}

// Strbt emits `STRBT{cond} Rt, op` -- store byte unprivileged.
func Strbt(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrTEmit(a, cond, false, true, rt, op)
}
