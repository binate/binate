package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Every word and byte load / store and its T form against clang's words (Apple clang 21, armv7ve):
// each addressing form -- offset, pre- and post-indexed; an immediate at the ends of its range and
// clang's negative zero (`#-0`, U clear); a register index added, subtracted and shifted -- and SP
// and PC where clang takes them; a T form's `[Rn]` as its post-index by 0.
func TestMemWordGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R0, MemImm(R1, 0)) // ldr r0, [r1]
	Ldr(a, COND_AL, R0, MemPre(R1, 0)) // ldr r0, [r1]!
	Ldr(a, COND_AL, R0, MemImm(R1, 4)) // ldr r0, [r1, #4]
	Ldr(a, COND_AL, SP, MemImm(R1, 4)) // ldr sp, [r1, #4]
	Ldr(a, COND_AL, PC, MemImm(R1, 4)) // ldr pc, [r1, #4]
	Ldr(a, COND_AL, R0, MemImm(R1, -4)) // ldr r0, [r1, #-4]
	Ldr(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // ldr r0, [r1, #-0]
	Ldr(a, COND_AL, R0, MemPre(R1, 4)) // ldr r0, [r1, #4]!
	Ldr(a, COND_AL, R0, MemImm(R1, 4095)) // ldr r0, [r1, #4095]
	Ldr(a, COND_AL, R0, MemImm(R1, -4095)) // ldr r0, [r1, #-4095]
	Ldr(a, COND_AL, R0, MemImm(R1, 255)) // ldr r0, [r1, #255]
	Ldr(a, COND_AL, R0, MemImm(R1, -255)) // ldr r0, [r1, #-255]
	Ldr(a, COND_AL, R0, MemPost(R1, 4)) // ldr r0, [r1], #4
	Ldr(a, COND_AL, SP, MemPost(R1, 4)) // ldr sp, [r1], #4
	Ldr(a, COND_AL, PC, MemPost(R1, 4)) // ldr pc, [r1], #4
	Ldr(a, COND_AL, R0, MemPost(R1, -4)) // ldr r0, [r1], #-4
	Ldr(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldr r0, [r1], #-0
	Ldr(a, COND_AL, R0, MemPost(R1, 4095)) // ldr r0, [r1], #4095
	Ldr(a, COND_AL, R0, MemReg(R1, R2)) // ldr r0, [r1, r2]
	Ldr(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // ldr r0, [r1, -r2]
	Ldr(a, COND_AL, R0, MemPreReg(R1, R2)) // ldr r0, [r1, r2]!
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, LSL, 2)) // ldr r0, [r1, r2, lsl #2]
	Ldr(a, COND_AL, R0, SubIndex(MemSReg(R1, R2, LSL, 2))) // ldr r0, [r1, -r2, lsl #2]
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, LSR, 32)) // ldr r0, [r1, r2, lsr #32]
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, ASR, 32)) // ldr r0, [r1, r2, asr #32]
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, ROR, 1)) // ldr r0, [r1, r2, ror #1]
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, RRX, 0)) // ldr r0, [r1, r2, rrx]
	Ldr(a, COND_AL, R0, MemPreSReg(R1, R2, LSL, 2)) // ldr r0, [r1, r2, lsl #2]!
	Ldr(a, COND_AL, R0, MemPostReg(R1, R2)) // ldr r0, [r1], r2
	Ldr(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldr r0, [r1], -r2
	Ldr(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // ldr r0, [r1], r2, lsl #2
	Ldr(a, COND_AL, R0, MemImm(PC, 4)) // ldr r0, [pc, #4]
	Ldr(a, COND_AL, R0, MemImm(PC, -4)) // ldr r0, [pc, #-4]
	Ldr(a, COND_AL, R0, MemImm(SP, 4)) // ldr r0, [sp, #4]
	Ldr(a, COND_AL, R0, MemReg(R1, PC)) // ldr r0, [r1, pc]
	Ldr(a, COND_AL, R0, MemReg(PC, R2)) // ldr r0, [pc, r2]
	Ldr(a, COND_AL, SP, MemPostReg(R1, R3)) // ldr sp, [r1], r3
	Ldr(a, COND_AL, PC, MemPostReg(R1, R3)) // ldr pc, [r1], r3
	Ldr(a, COND_AL, R0, MemPost(PC, 4)) // ldr r0, [pc], #4
	Ldr(a, COND_AL, R3, MemPostSReg(R1, R3, LSL, 2)) // ldr r3, [r1], r3, lsl #2
	Str(a, COND_AL, R0, MemImm(R1, 0)) // str r0, [r1]
	Str(a, COND_AL, R0, MemPre(R1, 0)) // str r0, [r1]!
	Str(a, COND_AL, R0, MemImm(R1, 4)) // str r0, [r1, #4]
	Str(a, COND_AL, SP, MemImm(R1, 4)) // str sp, [r1, #4]
	Str(a, COND_AL, PC, MemImm(R1, 4)) // str pc, [r1, #4]
	Str(a, COND_AL, R0, MemImm(R1, -4)) // str r0, [r1, #-4]
	Str(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // str r0, [r1, #-0]
	Str(a, COND_AL, R0, MemPre(R1, 4)) // str r0, [r1, #4]!
	Str(a, COND_AL, R0, MemImm(R1, 4095)) // str r0, [r1, #4095]
	Str(a, COND_AL, R0, MemImm(R1, -4095)) // str r0, [r1, #-4095]
	Str(a, COND_AL, R0, MemImm(R1, 255)) // str r0, [r1, #255]
	Str(a, COND_AL, R0, MemImm(R1, -255)) // str r0, [r1, #-255]
	Str(a, COND_AL, R0, MemPost(R1, 4)) // str r0, [r1], #4
	Str(a, COND_AL, SP, MemPost(R1, 4)) // str sp, [r1], #4
	Str(a, COND_AL, PC, MemPost(R1, 4)) // str pc, [r1], #4
	Str(a, COND_AL, R0, MemPost(R1, -4)) // str r0, [r1], #-4
	Str(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // str r0, [r1], #-0
	Str(a, COND_AL, R0, MemPost(R1, 4095)) // str r0, [r1], #4095
	Str(a, COND_AL, R0, MemReg(R1, R2)) // str r0, [r1, r2]
	Str(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // str r0, [r1, -r2]
	Str(a, COND_AL, R0, MemPreReg(R1, R2)) // str r0, [r1, r2]!
	Str(a, COND_AL, R0, MemSReg(R1, R2, LSL, 2)) // str r0, [r1, r2, lsl #2]
	Str(a, COND_AL, R0, SubIndex(MemSReg(R1, R2, LSL, 2))) // str r0, [r1, -r2, lsl #2]
	Str(a, COND_AL, R0, MemSReg(R1, R2, LSR, 32)) // str r0, [r1, r2, lsr #32]
	Str(a, COND_AL, R0, MemSReg(R1, R2, ASR, 32)) // str r0, [r1, r2, asr #32]
	Str(a, COND_AL, R0, MemSReg(R1, R2, ROR, 1)) // str r0, [r1, r2, ror #1]
	Str(a, COND_AL, R0, MemSReg(R1, R2, RRX, 0)) // str r0, [r1, r2, rrx]
	Str(a, COND_AL, R0, MemPreSReg(R1, R2, LSL, 2)) // str r0, [r1, r2, lsl #2]!
	Str(a, COND_AL, R0, MemPostReg(R1, R2)) // str r0, [r1], r2
	Str(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // str r0, [r1], -r2
	Str(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // str r0, [r1], r2, lsl #2
	Str(a, COND_AL, R0, MemImm(PC, 4)) // str r0, [pc, #4]
	Str(a, COND_AL, R0, MemImm(PC, -4)) // str r0, [pc, #-4]
	Str(a, COND_AL, R0, MemImm(SP, 4)) // str r0, [sp, #4]
	Str(a, COND_AL, R0, MemReg(R1, PC)) // str r0, [r1, pc]
	Str(a, COND_AL, R0, MemReg(PC, R2)) // str r0, [pc, r2]
	Str(a, COND_AL, SP, MemPostReg(R1, R3)) // str sp, [r1], r3
	Str(a, COND_AL, PC, MemPostReg(R1, R3)) // str pc, [r1], r3
	Str(a, COND_AL, R0, MemPost(PC, 4)) // str r0, [pc], #4
	Str(a, COND_AL, R3, MemPostSReg(R1, R3, LSL, 2)) // str r3, [r1], r3, lsl #2
	Ldrb(a, COND_AL, R0, MemImm(R1, 0)) // ldrb r0, [r1]
	Ldrb(a, COND_AL, R0, MemPre(R1, 0)) // ldrb r0, [r1]!
	Ldrb(a, COND_AL, R0, MemImm(R1, 4)) // ldrb r0, [r1, #4]
	Ldrb(a, COND_AL, SP, MemImm(R1, 4)) // ldrb sp, [r1, #4]
	Ldrb(a, COND_AL, R0, MemImm(R1, -4)) // ldrb r0, [r1, #-4]
	Ldrb(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // ldrb r0, [r1, #-0]
	Ldrb(a, COND_AL, R0, MemPre(R1, 4)) // ldrb r0, [r1, #4]!
	Ldrb(a, COND_AL, R0, MemImm(R1, 4095)) // ldrb r0, [r1, #4095]
	Ldrb(a, COND_AL, R0, MemImm(R1, -4095)) // ldrb r0, [r1, #-4095]
	Ldrb(a, COND_AL, R0, MemImm(R1, 255)) // ldrb r0, [r1, #255]
	Ldrb(a, COND_AL, R0, MemImm(R1, -255)) // ldrb r0, [r1, #-255]
	Ldrb(a, COND_AL, R0, MemPost(R1, 4)) // ldrb r0, [r1], #4
	Ldrb(a, COND_AL, SP, MemPost(R1, 4)) // ldrb sp, [r1], #4
	Ldrb(a, COND_AL, PC, MemPost(R1, 4)) // ldrb pc, [r1], #4
	Ldrb(a, COND_AL, R0, MemPost(R1, -4)) // ldrb r0, [r1], #-4
	Ldrb(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrb r0, [r1], #-0
	Ldrb(a, COND_AL, R0, MemPost(R1, 4095)) // ldrb r0, [r1], #4095
	Ldrb(a, COND_AL, R0, MemReg(R1, R2)) // ldrb r0, [r1, r2]
	Ldrb(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // ldrb r0, [r1, -r2]
	Ldrb(a, COND_AL, R0, MemPreReg(R1, R2)) // ldrb r0, [r1, r2]!
	Ldrb(a, COND_AL, R0, MemSReg(R1, R2, LSL, 2)) // ldrb r0, [r1, r2, lsl #2]
	Ldrb(a, COND_AL, R0, SubIndex(MemSReg(R1, R2, LSL, 2))) // ldrb r0, [r1, -r2, lsl #2]
	Ldrb(a, COND_AL, R0, MemSReg(R1, R2, LSR, 32)) // ldrb r0, [r1, r2, lsr #32]
	Ldrb(a, COND_AL, R0, MemSReg(R1, R2, ASR, 32)) // ldrb r0, [r1, r2, asr #32]
	Ldrb(a, COND_AL, R0, MemSReg(R1, R2, ROR, 1)) // ldrb r0, [r1, r2, ror #1]
	Ldrb(a, COND_AL, R0, MemSReg(R1, R2, RRX, 0)) // ldrb r0, [r1, r2, rrx]
	Ldrb(a, COND_AL, R0, MemPreSReg(R1, R2, LSL, 2)) // ldrb r0, [r1, r2, lsl #2]!
	Ldrb(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrb r0, [r1], r2
	Ldrb(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrb r0, [r1], -r2
	Ldrb(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // ldrb r0, [r1], r2, lsl #2
	Ldrb(a, COND_AL, R0, MemImm(PC, 4)) // ldrb r0, [pc, #4]
	Ldrb(a, COND_AL, R0, MemImm(PC, -4)) // ldrb r0, [pc, #-4]
	Ldrb(a, COND_AL, R0, MemImm(SP, 4)) // ldrb r0, [sp, #4]
	Ldrb(a, COND_AL, R0, MemReg(R1, PC)) // ldrb r0, [r1, pc]
	Ldrb(a, COND_AL, R0, MemReg(PC, R2)) // ldrb r0, [pc, r2]
	Ldrb(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrb sp, [r1], r3
	Ldrb(a, COND_AL, PC, MemPostReg(R1, R3)) // ldrb pc, [r1], r3
	Ldrb(a, COND_AL, R0, MemPost(PC, 4)) // ldrb r0, [pc], #4
	Ldrb(a, COND_AL, R3, MemPostSReg(R1, R3, LSL, 2)) // ldrb r3, [r1], r3, lsl #2
	Strb(a, COND_AL, R0, MemImm(R1, 0)) // strb r0, [r1]
	Strb(a, COND_AL, R0, MemPre(R1, 0)) // strb r0, [r1]!
	Strb(a, COND_AL, R0, MemImm(R1, 4)) // strb r0, [r1, #4]
	Strb(a, COND_AL, SP, MemImm(R1, 4)) // strb sp, [r1, #4]
	Strb(a, COND_AL, R0, MemImm(R1, -4)) // strb r0, [r1, #-4]
	Strb(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // strb r0, [r1, #-0]
	Strb(a, COND_AL, R0, MemPre(R1, 4)) // strb r0, [r1, #4]!
	Strb(a, COND_AL, R0, MemImm(R1, 4095)) // strb r0, [r1, #4095]
	Strb(a, COND_AL, R0, MemImm(R1, -4095)) // strb r0, [r1, #-4095]
	Strb(a, COND_AL, R0, MemImm(R1, 255)) // strb r0, [r1, #255]
	Strb(a, COND_AL, R0, MemImm(R1, -255)) // strb r0, [r1, #-255]
	Strb(a, COND_AL, R0, MemPost(R1, 4)) // strb r0, [r1], #4
	Strb(a, COND_AL, SP, MemPost(R1, 4)) // strb sp, [r1], #4
	Strb(a, COND_AL, PC, MemPost(R1, 4)) // strb pc, [r1], #4
	Strb(a, COND_AL, R0, MemPost(R1, -4)) // strb r0, [r1], #-4
	Strb(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // strb r0, [r1], #-0
	Strb(a, COND_AL, R0, MemPost(R1, 4095)) // strb r0, [r1], #4095
	Strb(a, COND_AL, R0, MemReg(R1, R2)) // strb r0, [r1, r2]
	Strb(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // strb r0, [r1, -r2]
	Strb(a, COND_AL, R0, MemPreReg(R1, R2)) // strb r0, [r1, r2]!
	Strb(a, COND_AL, R0, MemSReg(R1, R2, LSL, 2)) // strb r0, [r1, r2, lsl #2]
	Strb(a, COND_AL, R0, SubIndex(MemSReg(R1, R2, LSL, 2))) // strb r0, [r1, -r2, lsl #2]
	Strb(a, COND_AL, R0, MemSReg(R1, R2, LSR, 32)) // strb r0, [r1, r2, lsr #32]
	Strb(a, COND_AL, R0, MemSReg(R1, R2, ASR, 32)) // strb r0, [r1, r2, asr #32]
	Strb(a, COND_AL, R0, MemSReg(R1, R2, ROR, 1)) // strb r0, [r1, r2, ror #1]
	Strb(a, COND_AL, R0, MemSReg(R1, R2, RRX, 0)) // strb r0, [r1, r2, rrx]
	Strb(a, COND_AL, R0, MemPreSReg(R1, R2, LSL, 2)) // strb r0, [r1, r2, lsl #2]!
	Strb(a, COND_AL, R0, MemPostReg(R1, R2)) // strb r0, [r1], r2
	Strb(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // strb r0, [r1], -r2
	Strb(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // strb r0, [r1], r2, lsl #2
	Strb(a, COND_AL, R0, MemImm(PC, 4)) // strb r0, [pc, #4]
	Strb(a, COND_AL, R0, MemImm(PC, -4)) // strb r0, [pc, #-4]
	Strb(a, COND_AL, R0, MemImm(SP, 4)) // strb r0, [sp, #4]
	Strb(a, COND_AL, R0, MemReg(R1, PC)) // strb r0, [r1, pc]
	Strb(a, COND_AL, R0, MemReg(PC, R2)) // strb r0, [pc, r2]
	Strb(a, COND_AL, SP, MemPostReg(R1, R3)) // strb sp, [r1], r3
	Strb(a, COND_AL, PC, MemPostReg(R1, R3)) // strb pc, [r1], r3
	Strb(a, COND_AL, R0, MemPost(PC, 4)) // strb r0, [pc], #4
	Strb(a, COND_AL, R3, MemPostSReg(R1, R3, LSL, 2)) // strb r3, [r1], r3, lsl #2
	Ldrt(a, COND_AL, R0, MemPost(R1, 0)) // ldrt r0, [r1]
	Ldrt(a, COND_AL, R0, MemPost(R1, 4)) // ldrt r0, [r1], #4
	Ldrt(a, COND_AL, SP, MemPost(R1, 4)) // ldrt sp, [r1], #4
	Ldrt(a, COND_AL, PC, MemPost(R1, 4)) // ldrt pc, [r1], #4
	Ldrt(a, COND_AL, R0, MemPost(R1, -4)) // ldrt r0, [r1], #-4
	Ldrt(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrt r0, [r1], #-0
	Ldrt(a, COND_AL, R0, MemPost(R1, 4095)) // ldrt r0, [r1], #4095
	Ldrt(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrt r0, [r1], r2
	Ldrt(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrt r0, [r1], -r2
	Ldrt(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // ldrt r0, [r1], r2, lsl #2
	Ldrt(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrt sp, [r1], r3
	Ldrt(a, COND_AL, PC, MemPostReg(R1, R3)) // ldrt pc, [r1], r3
	Ldrt(a, COND_AL, R0, MemPost(PC, 4)) // ldrt r0, [pc], #4
	Ldrt(a, COND_AL, R3, MemPostSReg(R1, R3, LSL, 2)) // ldrt r3, [r1], r3, lsl #2
	Strt(a, COND_AL, R0, MemPost(R1, 0)) // strt r0, [r1]
	Strt(a, COND_AL, R0, MemPost(R1, 4)) // strt r0, [r1], #4
	Strt(a, COND_AL, SP, MemPost(R1, 4)) // strt sp, [r1], #4
	Strt(a, COND_AL, PC, MemPost(R1, 4)) // strt pc, [r1], #4
	Strt(a, COND_AL, R0, MemPost(R1, -4)) // strt r0, [r1], #-4
	Strt(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // strt r0, [r1], #-0
	Strt(a, COND_AL, R0, MemPost(R1, 4095)) // strt r0, [r1], #4095
	Strt(a, COND_AL, R0, MemPostReg(R1, R2)) // strt r0, [r1], r2
	Strt(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // strt r0, [r1], -r2
	Strt(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // strt r0, [r1], r2, lsl #2
	Strt(a, COND_AL, SP, MemPostReg(R1, R3)) // strt sp, [r1], r3
	Strt(a, COND_AL, PC, MemPostReg(R1, R3)) // strt pc, [r1], r3
	Strt(a, COND_AL, R0, MemPost(PC, 4)) // strt r0, [pc], #4
	Strt(a, COND_AL, R3, MemPostSReg(R1, R3, LSL, 2)) // strt r3, [r1], r3, lsl #2
	Ldrbt(a, COND_AL, R0, MemPost(R1, 0)) // ldrbt r0, [r1]
	Ldrbt(a, COND_AL, R0, MemPost(R1, 4)) // ldrbt r0, [r1], #4
	Ldrbt(a, COND_AL, SP, MemPost(R1, 4)) // ldrbt sp, [r1], #4
	Ldrbt(a, COND_AL, PC, MemPost(R1, 4)) // ldrbt pc, [r1], #4
	Ldrbt(a, COND_AL, R0, MemPost(R1, -4)) // ldrbt r0, [r1], #-4
	Ldrbt(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrbt r0, [r1], #-0
	Ldrbt(a, COND_AL, R0, MemPost(R1, 4095)) // ldrbt r0, [r1], #4095
	Ldrbt(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrbt r0, [r1], r2
	Ldrbt(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrbt r0, [r1], -r2
	Ldrbt(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2)) // ldrbt r0, [r1], r2, lsl #2
	Ldrbt(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrbt sp, [r1], r3
	Ldrbt(a, COND_AL, PC, MemPostReg(R1, R3)) // ldrbt pc, [r1], r3
