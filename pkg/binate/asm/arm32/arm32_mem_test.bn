package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// --- LDR / STR ---

func TestLdrImmOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1, #8]
	// cond=1110 | 01 | I=0 | P=1 | U=1 | B=0 | W=0 | L=1
	//   | Rn=0001 | Rt=0000 | imm12=000000001000
	// = 0xE5910008
	Ldr(a, COND_AL, R0, MemImm(R1, 8))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5910008 {
		return fail("LDR R0, [R1, #8] encoding wrong")
	}
	return ""
}

func TestLdrImmNegOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1, #-4]
	// U=0 (subtract), offset=4
	// = 0xE5110004
	Ldr(a, COND_AL, R0, MemImm(R1, -4))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5110004 {
		return fail("LDR R0, [R1, #-4] encoding wrong")
	}
	return ""
}

func TestLdrImmZero() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1] = LDR R0, [R1, #0]
	// = 0xE5910000
	Ldr(a, COND_AL, R0, MemImm(R1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5910000 {
		return fail("LDR R0, [R1] encoding wrong")
	}
	return ""
}

func TestStrImmOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STR R0, [R1, #4]
	// L=0
	// = 0xE5810004
	Str(a, COND_AL, R0, MemImm(R1, 4))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5810004 {
		return fail("STR R0, [R1, #4] encoding wrong")
	}
	return ""
}

func TestLdrRegOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1, R2]
	// I=1, P=1, U=1, L=1
	// = 0xE7910002
	Ldr(a, COND_AL, R0, MemReg(R1, R2))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE7910002 {
		return fail("LDR R0, [R1, R2] encoding wrong")
	}
	return ""
}

func TestLdrPreIndex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1, #4]!
	// P=1, W=1 (pre-index writeback)
	// = 0xE5B10004
	Ldr(a, COND_AL, R0, MemPre(R1, 4))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5B10004 {
		return fail("LDR R0, [R1, #4]! encoding wrong")
	}
	return ""
}

func TestLdrPostIndex() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1], #4
	// P=0, W=0 (post-index)
	// = 0xE4910004
	Ldr(a, COND_AL, R0, MemPost(R1, 4))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE4910004 {
		return fail("LDR R0, [R1], #4 encoding wrong")
	}
	return ""
}

// --- LDRB / STRB ---

func TestLdrbImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRB R0, [R1, #0]
	// B=1 (bit 22)
	// = 0xE5D10000
	Ldrb(a, COND_AL, R0, MemImm(R1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5D10000 {
		return fail("LDRB R0, [R1] encoding wrong")
	}
	return ""
}

func TestStrbImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STRB R0, [R1, #1]
	// = 0xE5C10001
	Strb(a, COND_AL, R0, MemImm(R1, 1))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE5C10001 {
		return fail("STRB R0, [R1, #1] encoding wrong")
	}
	return ""
}

// --- Scaled register offset ---

func TestLdrSregOffset() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDR R0, [R1, R2, LSL #2]
	// I=1, P=1, U=1, shift=LSL=00, shamt=2
	// operand: 00010 | 00 | 0 | 0010 = 0x00000102
	// = 0xE7910102
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, LSL, 2))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE7910102 {
		return fail("LDR R0, [R1, R2, LSL #2] encoding wrong")
	}
	return ""
}

// --- Immediate-offset range checks ---
//
// An assembler must ERROR on an unencodable immediate offset, not silently
// emit a wrapped (wrong-slot) access.  LDR/STR encode a 12-bit magnitude
// (±4095); LDRH/STRH/LDRSB/LDRSH a split 8-bit magnitude (±255).

// In-range LDR/STR offsets at the 4095 boundary must NOT error.
func TestLdrStrImm12BoundaryNoError() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R0, MemImm(R1, 4095))
	if a.HasError {
		return fail("LDR with offset 4095 (max) should NOT error")
	}
	var b @asm.Assembler = newAsm()
	Str(b, COND_AL, R0, MemImm(R1, -4095))
	if b.HasError {
		return fail("STR with offset -4095 (max) should NOT error")
	}
	return ""
}

// LDR/STR offsets past ±4095 must error (positive and negative).
func TestLdrStrImm12OverflowErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R0, MemImm(R1, 4096))
	if !a.HasError {
		return fail("LDR with offset 4096 (>4095) should error, not wrap")
	}
	var b @asm.Assembler = newAsm()
	Str(b, COND_AL, R0, MemImm(R1, -4096))
	if !b.HasError {
		return fail("STR with offset -4096 (<-4095) should error, not wrap")
	}
	return ""
}

// The register-indexed LDR / STR / LDRH forms -- a subtracted index (U=0), a
// shifted index pre- and post-indexed, RRX (ROR with an amount of 0) -- as
// clang encodes them.
func TestLdrStrRegisterIndexForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R0, MemPreSReg(R1, R2, LSL, 2))
	Ldr(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 2))
	Ldr(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2)))
	Ldr(a, COND_AL, R0, SubIndex(MemReg(R1, R2)))
	Ldr(a, COND_AL, R0, SubIndex(MemPreReg(R1, R2)))
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, RRX, 0))
	Str(a, COND_AL, R0, SubIndex(MemPreSReg(R1, R2, ASR, 5)))
	Ldrh(a, COND_AL, R0, SubIndex(MemReg(R1, R2)))
	var want @[]uint32 = make_slice(uint32, 8)
	want[0] = 0xE7B10102
	want[1] = 0xE6910102
	want[2] = 0xE6110002
	want[3] = 0xE7110002
	want[4] = 0xE7310002
	want[5] = 0xE7910062
	want[6] = 0xE72102C2
	want[7] = 0xE11100B2
	if a.HasError { return fail(a.ErrorMsg) }
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] {
			return fail("a register-indexed LDR / STR / LDRH encoded differently from clang")
		}
	}
	return ""
}

// A register-index shift with no encoding -- an amount out of its range, an
// amount on RRX -- is an error, not some other instruction.
func TestLdrRegisterIndexShiftRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R0, MemSReg(R1, R2, LSL, 32))
	if !a.HasError { return fail("LSL #32 on an index must be rejected") }
	var b @asm.Assembler = newAsm()
	Ldr(b, COND_AL, R0, MemSReg(R1, R2, RRX, 1))
	if !b.HasError { return fail("RRX with an amount must be rejected") }
	return ""
}

// An Rt, base or index register outside R0..R15, or a subtracted (SubIndex) operand
// that is neither a register index nor a zero offset, is an error that emits nothing --
// never a register number masked into another register's field, or a dropped
// subtraction.
func TestLoadStoreRegisterRejects() testing.TestResult {
	for i := 0; i < 7; i++ {
		var a @asm.Assembler = newAsm()
		if i == 0 { Ldr(a, COND_AL, 16, MemImm(R1, 0)) }
		if i == 1 { Str(a, COND_AL, R0, MemImm(16, 0)) }
		if i == 2 { Ldr(a, COND_AL, R0, MemReg(R1, 16)) }
		if i == 3 { Ldrb(a, COND_AL, R0, MemPostSReg(R1, -1, LSL, 2)) }
		if i == 4 { Ldrh(a, COND_AL, R0, MemReg(R1, 17)) }
		if i == 5 { Ldr(a, COND_AL, R0, SubIndex(MemImm(R1, 4))) }
		if i == 6 { Strh(a, COND_AL, R0, SubIndex(MemPre(R1, 2))) }
		if !a.HasError { return fail("an invalid load / store was accepted") }
		if a.Sections[0].Len != 0 { return fail("an invalid load / store emitted a word") }
	}
	return ""
}

// memRejected reports whether a holds an error and no bytes.
func memRejected(a @asm.Assembler) bool { return a.HasError && a.Sections[0].Len == 0 }

// memRejectedWith reports whether a holds the error msg and no bytes.
func memRejectedWith(a @asm.Assembler, msg *[]readonly char) bool {
	if !memRejected(a) || len(a.ErrorMsg) != len(msg) { return false }
	for i := 0; i < len(msg); i++ {
		if a.ErrorMsg[i] != msg[i] { return false }
	}
	return true
}

// The word and byte loads and stores refuse what clang does -- a form writing its base back with
// Rt as the base (each message as clang's, a T form excepted), LDRB / STRB with PC as Rt in a
// form not writing its base back, a T form with an operand other than a post-indexed one -- and a
// condition past COND_AL; nothing is emitted.
func TestMemWordRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldr(a, COND_AL, R1, MemPre(R1, 4))
	if !memRejectedWith(a, "destination register and base register can't be identical") {
		return fail("LDR R1, [R1, #4]! accepted")
	}
	a = newAsm()
	Str(a, COND_AL, R1, MemPostReg(R1, R2))
	if !memRejectedWith(a, "source register and base register can't be identical") {
		return fail("STR R1, [R1], R2 accepted")
	}
	a = newAsm()
	Ldrb(a, COND_AL, PC, MemPostSReg(PC, R2, LSL, 2))
	if !memRejected(a) { return fail("LDRB PC, [PC], R2, LSL #2 accepted") }
	a = newAsm()
	Ldrb(a, COND_AL, PC, MemImm(R1, 0))
	if !memRejected(a) { return fail("LDRB PC, [R1] accepted") }
	a = newAsm()
	Strb(a, COND_AL, PC, MemReg(R1, R2))
	if !memRejected(a) { return fail("STRB PC, [R1, R2] accepted") }
	a = newAsm()
	Ldrt(a, COND_AL, R0, MemImm(R1, 4))
	if !memRejected(a) { return fail("LDRT R0, [R1, #4] accepted") }
	a = newAsm()
	Strbt(a, COND_AL, R0, MemPre(R1, 4))
	if !memRejected(a) { return fail("STRBT R0, [R1, #4]! accepted") }
	a = newAsm()
	Ldrt(a, COND_AL, R0, Label("lbl"))
	if !memRejected(a) || a.Sections[0].NumFixups != 0 { return fail("LDRT to a label accepted") }
	a = newAsm()
	Ldr(a, 15, R0, MemImm(R1, 0))
	if !memRejected(a) { return fail("LDR under condition 15 accepted") }
	a = newAsm()
	Strt(a, -1, R0, MemPost(R1, 4))
	if !memRejected(a) { return fail("STRT under condition -1 accepted") }
	a = newAsm()
	Str(a, 16, R0, Label("lbl"))
	if !memRejected(a) || a.Sections[0].NumFixups != 0 {
		return fail("STR to a label under condition 16 accepted")
	}
	return ""
}

// A T form writes its base back with Rt as the base, as clang takes it (the plain forms do not):
// LDRT R1, [R1], #4 is 0xE4B11004, STRBT R1, [R1], R2 0xE6E11002.
func TestMemTWritebackTaken() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrt(a, COND_AL, R1, MemPost(R1, 4))
	Strbt(a, COND_AL, R1, MemPostReg(R1, R2))
	if a.HasError { return fail(a.ErrorMsg) }
	if readInst(a.Sections[0], 0) != 0xE4B11004 { return fail("LDRT R1, [R1], #4 encoded wrong") }
	if readInst(a.Sections[0], 4) != 0xE6E11002 { return fail("STRBT R1, [R1], R2 encoded wrong") }
	return ""
}
