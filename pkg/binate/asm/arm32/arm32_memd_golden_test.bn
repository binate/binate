package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// LDRD / STRD and PLD / PLDW / PLI against clang's words (Apple clang 21, armv7ve): each register
// pair clang takes (R12 with SP included), each addressing form -- offset, pre- and post-indexed,
// an immediate at the ends of its range and clang's negative zero, a register index added and
// subtracted (and, for a preload, shifted) -- and SP and PC where clang takes them.
func TestMemDoubleGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrd(a, COND_AL, R0, MemImm(R4, 0)) // ldrd r0, r1, [r4]
	Ldrd(a, COND_AL, R0, MemPre(R4, 0)) // ldrd r0, r1, [r4]!
	Ldrd(a, COND_AL, R0, MemImm(R4, 8)) // ldrd r0, r1, [r4, #8]
	Ldrd(a, COND_AL, R0, MemImm(R4, -8)) // ldrd r0, r1, [r4, #-8]
	Ldrd(a, COND_AL, R0, SubIndex(MemImm(R4, 0))) // ldrd r0, r1, [r4, #-0]
	Ldrd(a, COND_AL, R0, MemPre(R4, 8)) // ldrd r0, r1, [r4, #8]!
	Ldrd(a, COND_AL, R0, MemImm(R4, 255)) // ldrd r0, r1, [r4, #255]
	Ldrd(a, COND_AL, R0, MemPost(R4, 8)) // ldrd r0, r1, [r4], #8
	Ldrd(a, COND_AL, R0, SubIndex(MemPost(R4, 0))) // ldrd r0, r1, [r4], #-0
	Ldrd(a, COND_AL, R0, MemReg(R4, R5)) // ldrd r0, r1, [r4, r5]
	Ldrd(a, COND_AL, R0, SubIndex(MemReg(R4, R5))) // ldrd r0, r1, [r4, -r5]
	Ldrd(a, COND_AL, R0, MemPreReg(R4, R5)) // ldrd r0, r1, [r4, r5]!
	Ldrd(a, COND_AL, R0, MemPostReg(R4, R5)) // ldrd r0, r1, [r4], r5
	Ldrd(a, COND_AL, R0, SubIndex(MemPostReg(R4, R5))) // ldrd r0, r1, [r4], -r5
	Ldrd(a, COND_AL, R0, MemImm(PC, 8)) // ldrd r0, r1, [pc, #8]
	Ldrd(a, COND_AL, R0, MemReg(R4, R0)) // ldrd r0, r1, [r4, r0]
	Ldrd(a, COND_AL, R0, MemReg(R4, R1)) // ldrd r0, r1, [r4, r1]
	Ldrd(a, COND_AL, R0, MemReg(R4, PC)) // ldrd r0, r1, [r4, pc]
	Ldrd(a, COND_AL, R2, MemImm(R4, 0)) // ldrd r2, r3, [r4]
	Ldrd(a, COND_AL, R2, MemPre(R4, 0)) // ldrd r2, r3, [r4]!
	Ldrd(a, COND_AL, R2, MemImm(R4, 8)) // ldrd r2, r3, [r4, #8]
	Ldrd(a, COND_AL, R2, MemImm(R4, -8)) // ldrd r2, r3, [r4, #-8]
	Ldrd(a, COND_AL, R2, SubIndex(MemImm(R4, 0))) // ldrd r2, r3, [r4, #-0]
	Ldrd(a, COND_AL, R2, MemPre(R4, 8)) // ldrd r2, r3, [r4, #8]!
	Ldrd(a, COND_AL, R2, MemImm(R4, 255)) // ldrd r2, r3, [r4, #255]
	Ldrd(a, COND_AL, R2, MemPost(R4, 8)) // ldrd r2, r3, [r4], #8
	Ldrd(a, COND_AL, R2, SubIndex(MemPost(R4, 0))) // ldrd r2, r3, [r4], #-0
	Ldrd(a, COND_AL, R2, MemReg(R4, R5)) // ldrd r2, r3, [r4, r5]
	Ldrd(a, COND_AL, R2, SubIndex(MemReg(R4, R5))) // ldrd r2, r3, [r4, -r5]
	Ldrd(a, COND_AL, R2, MemPreReg(R4, R5)) // ldrd r2, r3, [r4, r5]!
	Ldrd(a, COND_AL, R2, MemPostReg(R4, R5)) // ldrd r2, r3, [r4], r5
	Ldrd(a, COND_AL, R2, SubIndex(MemPostReg(R4, R5))) // ldrd r2, r3, [r4], -r5
	Ldrd(a, COND_AL, R2, MemImm(PC, 8)) // ldrd r2, r3, [pc, #8]
	Ldrd(a, COND_AL, R2, MemPre(R0, 8)) // ldrd r2, r3, [r0, #8]!
	Ldrd(a, COND_AL, R2, MemPost(R1, 8)) // ldrd r2, r3, [r1], #8
	Ldrd(a, COND_AL, R2, MemReg(R4, R0)) // ldrd r2, r3, [r4, r0]
	Ldrd(a, COND_AL, R2, MemReg(R4, R1)) // ldrd r2, r3, [r4, r1]
	Ldrd(a, COND_AL, R2, MemReg(R4, PC)) // ldrd r2, r3, [r4, pc]
	Ldrd(a, COND_AL, IP, MemImm(R4, 0)) // ldrd r12, r13, [r4]
	Ldrd(a, COND_AL, IP, MemImm(R4, 8)) // ldrd r12, r13, [r4, #8]
	Ldrd(a, COND_AL, R10, MemImm(R4, 0)) // ldrd r10, r11, [r4]
	Ldrd(a, COND_AL, R10, MemImm(R4, 8)) // ldrd r10, r11, [r4, #8]
	Strd(a, COND_AL, R0, MemImm(R4, 0)) // strd r0, r1, [r4]
	Strd(a, COND_AL, R0, MemPre(R4, 0)) // strd r0, r1, [r4]!
	Strd(a, COND_AL, R0, MemImm(R4, 8)) // strd r0, r1, [r4, #8]
	Strd(a, COND_AL, R0, MemImm(R4, -8)) // strd r0, r1, [r4, #-8]
	Strd(a, COND_AL, R0, SubIndex(MemImm(R4, 0))) // strd r0, r1, [r4, #-0]
	Strd(a, COND_AL, R0, MemPre(R4, 8)) // strd r0, r1, [r4, #8]!
	Strd(a, COND_AL, R0, MemImm(R4, 255)) // strd r0, r1, [r4, #255]
	Strd(a, COND_AL, R0, MemPost(R4, 8)) // strd r0, r1, [r4], #8
	Strd(a, COND_AL, R0, SubIndex(MemPost(R4, 0))) // strd r0, r1, [r4], #-0
	Strd(a, COND_AL, R0, MemReg(R4, R5)) // strd r0, r1, [r4, r5]
	Strd(a, COND_AL, R0, SubIndex(MemReg(R4, R5))) // strd r0, r1, [r4, -r5]
	Strd(a, COND_AL, R0, MemPreReg(R4, R5)) // strd r0, r1, [r4, r5]!
	Strd(a, COND_AL, R0, MemPostReg(R4, R5)) // strd r0, r1, [r4], r5
	Strd(a, COND_AL, R0, SubIndex(MemPostReg(R4, R5))) // strd r0, r1, [r4], -r5
	Strd(a, COND_AL, R0, MemImm(PC, 8)) // strd r0, r1, [pc, #8]
	Strd(a, COND_AL, R0, MemReg(R4, R0)) // strd r0, r1, [r4, r0]
	Strd(a, COND_AL, R0, MemReg(R4, R1)) // strd r0, r1, [r4, r1]
	Strd(a, COND_AL, R0, MemReg(R4, PC)) // strd r0, r1, [r4, pc]
	Strd(a, COND_AL, R2, MemImm(R4, 0)) // strd r2, r3, [r4]
	Strd(a, COND_AL, R2, MemPre(R4, 0)) // strd r2, r3, [r4]!
	Strd(a, COND_AL, R2, MemImm(R4, 8)) // strd r2, r3, [r4, #8]
	Strd(a, COND_AL, R2, MemImm(R4, -8)) // strd r2, r3, [r4, #-8]
	Strd(a, COND_AL, R2, SubIndex(MemImm(R4, 0))) // strd r2, r3, [r4, #-0]
	Strd(a, COND_AL, R2, MemPre(R4, 8)) // strd r2, r3, [r4, #8]!
	Strd(a, COND_AL, R2, MemImm(R4, 255)) // strd r2, r3, [r4, #255]
	Strd(a, COND_AL, R2, MemPost(R4, 8)) // strd r2, r3, [r4], #8
	Strd(a, COND_AL, R2, SubIndex(MemPost(R4, 0))) // strd r2, r3, [r4], #-0
	Strd(a, COND_AL, R2, MemReg(R4, R5)) // strd r2, r3, [r4, r5]
	Strd(a, COND_AL, R2, SubIndex(MemReg(R4, R5))) // strd r2, r3, [r4, -r5]
	Strd(a, COND_AL, R2, MemPreReg(R4, R5)) // strd r2, r3, [r4, r5]!
	Strd(a, COND_AL, R2, MemPostReg(R4, R5)) // strd r2, r3, [r4], r5
	Strd(a, COND_AL, R2, SubIndex(MemPostReg(R4, R5))) // strd r2, r3, [r4], -r5
	Strd(a, COND_AL, R2, MemImm(PC, 8)) // strd r2, r3, [pc, #8]
	Strd(a, COND_AL, R2, MemPre(R0, 8)) // strd r2, r3, [r0, #8]!
	Strd(a, COND_AL, R2, MemPost(R1, 8)) // strd r2, r3, [r1], #8
	Strd(a, COND_AL, R2, MemReg(R4, R0)) // strd r2, r3, [r4, r0]
	Strd(a, COND_AL, R2, MemReg(R4, R1)) // strd r2, r3, [r4, r1]
	Strd(a, COND_AL, R2, MemReg(R4, PC)) // strd r2, r3, [r4, pc]
	Strd(a, COND_AL, IP, MemImm(R4, 0)) // strd r12, r13, [r4]
	Strd(a, COND_AL, IP, MemImm(R4, 8)) // strd r12, r13, [r4, #8]
	Strd(a, COND_AL, R10, MemImm(R4, 0)) // strd r10, r11, [r4]
	Strd(a, COND_AL, R10, MemImm(R4, 8)) // strd r10, r11, [r4, #8]
	Pld(a, MemImm(R1, 0)) // pld [r1]
	Pld(a, MemImm(R1, 4)) // pld [r1, #4]
	Pld(a, MemImm(R1, -4)) // pld [r1, #-4]
	Pld(a, SubIndex(MemImm(R1, 0))) // pld [r1, #-0]
	Pld(a, MemImm(R1, 4095)) // pld [r1, #4095]
	Pld(a, MemReg(R1, R2)) // pld [r1, r2]
	Pld(a, SubIndex(MemReg(R1, R2))) // pld [r1, -r2]
	Pld(a, MemSReg(R1, R2, LSL, 2)) // pld [r1, r2, lsl #2]
	Pld(a, MemSReg(R1, R2, RRX, 0)) // pld [r1, r2, rrx]
	Pld(a, MemImm(PC, 4)) // pld [pc, #4]
	Pld(a, MemImm(PC, -4)) // pld [pc, #-4]
	Pld(a, MemReg(R1, PC)) // pld [r1, pc]
	Pld(a, MemReg(PC, R2)) // pld [pc, r2]
	Pld(a, MemImm(SP, 4)) // pld [sp, #4]
	Pldw(a, MemImm(R1, 0)) // pldw [r1]
	Pldw(a, MemImm(R1, 4)) // pldw [r1, #4]
	Pldw(a, MemImm(R1, -4)) // pldw [r1, #-4]
	Pldw(a, SubIndex(MemImm(R1, 0))) // pldw [r1, #-0]
	Pldw(a, MemImm(R1, 4095)) // pldw [r1, #4095]
	Pldw(a, MemReg(R1, R2)) // pldw [r1, r2]
	Pldw(a, SubIndex(MemReg(R1, R2))) // pldw [r1, -r2]
	Pldw(a, MemSReg(R1, R2, LSL, 2)) // pldw [r1, r2, lsl #2]
	Pldw(a, MemSReg(R1, R2, RRX, 0)) // pldw [r1, r2, rrx]
	Pldw(a, MemImm(PC, 4)) // pldw [pc, #4]
	Pldw(a, MemImm(PC, -4)) // pldw [pc, #-4]
	Pldw(a, MemReg(R1, PC)) // pldw [r1, pc]
	Pldw(a, MemReg(PC, R2)) // pldw [pc, r2]
	Pldw(a, MemImm(SP, 4)) // pldw [sp, #4]
	Pli(a, MemImm(R1, 0)) // pli [r1]
	Pli(a, MemImm(R1, 4)) // pli [r1, #4]
	Pli(a, MemImm(R1, -4)) // pli [r1, #-4]
	Pli(a, SubIndex(MemImm(R1, 0))) // pli [r1, #-0]
	Pli(a, MemImm(R1, 4095)) // pli [r1, #4095]
	Pli(a, MemReg(R1, R2)) // pli [r1, r2]
	Pli(a, SubIndex(MemReg(R1, R2))) // pli [r1, -r2]
	Pli(a, MemSReg(R1, R2, LSL, 2)) // pli [r1, r2, lsl #2]
	Pli(a, MemSReg(R1, R2, RRX, 0)) // pli [r1, r2, rrx]
	Pli(a, MemImm(PC, 4)) // pli [pc, #4]
	Pli(a, MemImm(PC, -4)) // pli [pc, #-4]
	Pli(a, MemReg(R1, PC)) // pli [r1, pc]
	Pli(a, MemReg(PC, R2)) // pli [pc, r2]
	Pli(a, MemImm(SP, 4)) // pli [sp, #4]
	Pld(a, MemImm(PC, -4095)) // pld [pc, #-4095]
	Pld(a, SubIndex(MemSReg(R1, R2, LSL, 2))) // pld [r1, -r2, lsl #2]
	Pld(a, MemSReg(R1, R2, ROR, 1)) // pld [r1, r2, ror #1]
	Pld(a, MemSReg(R1, R2, LSR, 32)) // pld [r1, r2, lsr #32]
	Pld(a, MemReg(SP, R2)) // pld [sp, r2]
	Pld(a, MemReg(R1, SP)) // pld [r1, sp]
	Pldw(a, MemImm(PC, -4095)) // pldw [pc, #-4095]
	Pldw(a, SubIndex(MemSReg(R1, R2, LSL, 2))) // pldw [r1, -r2, lsl #2]
	Pldw(a, MemSReg(R1, R2, ROR, 1)) // pldw [r1, r2, ror #1]
	Pldw(a, MemSReg(R1, R2, LSR, 32)) // pldw [r1, r2, lsr #32]
	Pldw(a, MemReg(SP, R2)) // pldw [sp, r2]
	Pldw(a, MemReg(R1, SP)) // pldw [r1, sp]
	Pli(a, MemImm(PC, -4095)) // pli [pc, #-4095]
	Pli(a, SubIndex(MemSReg(R1, R2, LSL, 2))) // pli [r1, -r2, lsl #2]
	Pli(a, MemSReg(R1, R2, ROR, 1)) // pli [r1, r2, ror #1]
	Pli(a, MemSReg(R1, R2, LSR, 32)) // pli [r1, r2, lsr #32]
	Pli(a, MemReg(SP, R2)) // pli [sp, r2]
	Pli(a, MemReg(R1, SP)) // pli [r1, sp]
	Ldrd(a, COND_AL, R0, MemImm(PC, -255)) // ldrd r0, r1, [pc, #-255]
	Ldrd(a, COND_AL, R0, MemImm(R4, -255)) // ldrd r0, r1, [r4, #-255]
	Ldrd(a, COND_AL, R0, MemPost(R4, 255)) // ldrd r0, r1, [r4], #255
	Ldrd(a, COND_AL, R0, MemPreReg(R4, R0)) // ldrd r0, r1, [r4, r0]!
	Ldrd(a, COND_AL, R0, MemPreReg(R4, R1)) // ldrd r0, r1, [r4, r1]!
	Ldrd(a, COND_AL, R0, MemPostReg(R4, R0)) // ldrd r0, r1, [r4], r0
	Ldrd(a, COND_AL, R0, MemPostReg(R4, R1)) // ldrd r0, r1, [r4], r1
	Ldrd(a, COND_AL, R0, MemReg(PC, R5)) // ldrd r0, r1, [pc, r5]
	Ldrd(a, COND_AL, R0, MemReg(R4, SP)) // ldrd r0, r1, [r4, sp]
	Ldrd(a, COND_AL, R0, MemPre(SP, 8)) // ldrd r0, r1, [sp, #8]!
	Ldrd(a, COND_AL, R0, MemPreReg(R4, PC)) // ldrd r0, r1, [r4, pc]!
	Ldrd(a, COND_AL, R0, MemPostReg(R4, PC)) // ldrd r0, r1, [r4], pc
	Ldrd(a, COND_AL, R4, MemImm(R4, 0)) // ldrd v1, v2, [r4]
	Strd(a, COND_AL, R0, MemImm(PC, -255)) // strd r0, r1, [pc, #-255]
	Strd(a, COND_AL, R0, MemImm(R4, -255)) // strd r0, r1, [r4, #-255]
	Strd(a, COND_AL, R0, MemPost(R4, 255)) // strd r0, r1, [r4], #255
	Strd(a, COND_AL, R0, MemPreReg(R4, R0)) // strd r0, r1, [r4, r0]!
	Strd(a, COND_AL, R0, MemPreReg(R4, R1)) // strd r0, r1, [r4, r1]!
	Strd(a, COND_AL, R0, MemPostReg(R4, R0)) // strd r0, r1, [r4], r0
	Strd(a, COND_AL, R0, MemPostReg(R4, R1)) // strd r0, r1, [r4], r1
	Strd(a, COND_AL, R0, MemReg(PC, R5)) // strd r0, r1, [pc, r5]
	Strd(a, COND_AL, R0, MemReg(R4, SP)) // strd r0, r1, [r4, sp]
	Strd(a, COND_AL, R0, MemPre(SP, 8)) // strd r0, r1, [sp, #8]!
	Strd(a, COND_AL, R0, MemPreReg(R4, PC)) // strd r0, r1, [r4, pc]!
	Strd(a, COND_AL, R0, MemPostReg(R4, PC)) // strd r0, r1, [r4], pc
	Strd(a, COND_AL, R4, MemImm(R4, 0)) // strd v1, v2, [r4]
	var want @[]uint32 = make_slice(uint32, 170)
	want[0] = 0xE1C400D0
	want[1] = 0xE1E400D0
	want[2] = 0xE1C400D8
	want[3] = 0xE14400D8
	want[4] = 0xE14400D0
