package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The halfword and signed-byte loads and stores (A5.2.8, the extra loads / stores), exact
// (arm32.bni), with the checks of arm32_mem.bn:
//
//	cond[31:28] | 000 | P[24] | U[23] | I[22] | W[21] | L[20] | Rn[19:16] | Rt[15:12]
//	| immH[11:8] 1 SH[6:5] 1 immL[3:0], or 0000 1 SH[6:5] 1 Rm[3:0]
//
// I=1 for an immediate offset (immH:immL), I=0 for a register; SH 01 an unsigned halfword, 10 a
// signed byte, 11 a signed halfword; P, U and W as for the word / byte forms.

// imm8SplitOffset returns the split immH:immL 8-bit immediate-offset field (immH in [11:8],
// immL in [3:0]) for `offset`, erroring on the assembler if its magnitude exceeds 255.  See
// imm12Offset for the rationale.
func imm8SplitOffset(a @asm.Assembler, offset int) uint32 {
	var mag int = offset
	if mag < 0 { mag = -mag }
	if mag > 0xff {
		a.SetError(
				"arm32: LDRH/STRH/LDRSB/LDRSH immediate offset out of "
						"range (magnitude must fit 255)")
	}
	var immH uint32 = cast(uint32, (mag >> 4) & 0xf)
	var immL uint32 = cast(uint32, mag & 0xf)
	return (immH << 8) | immL
}

// SH_H is the SH field value for an unsigned halfword load/store.
const SH_H int = 1

// SH_SB is the SH field value for a signed-byte load.
const SH_SB int = 2

// SH_SH is the SH field value for a signed-halfword load.
const SH_SH int = 3

// ldrstrHalfEnc encodes LDRH / STRH / LDRSB / LDRSH (load, sh), or with unpriv their T forms
// (LDRHT / STRHT / LDRSBT / LDRSHT), of Rt through the memory operand op, or sets the assembler
// error: no shifted register index; a T form takes only a post-indexed operand, and a T load's
// register form no PC as Rt, as clang has it.
func ldrstrHalfEnc(a @asm.Assembler, cond int, load bool, sh int, unpriv bool, rt int,
		op Operand) uint32 {
	if !memOk(a, cond, load, unpriv, rt, op) { return 0 }
	var reg bool = op.Kind == OP_MEM_REG || op.Kind == OP_MEM_PRE_REG || op.Kind == OP_MEM_POST_REG
	if !isMemImmKind(op.Kind) && !reg {
		// A shifted register index (these forms take none), a register, an immediate; a label
		// reaches here only as [PC, #0] (ldrstrHalfEmit).
		a.SetError(
				"arm32: LDRH / STRH / LDRSB / LDRSH take an [Rn, #imm] / [Rn, Rm] form (no shift) or a label")
		return 0
	}
	if unpriv && !isMemPostKind(op.Kind) {
		a.SetError("arm32: LDRHT / STRHT / LDRSBT / LDRSHT take a post-indexed operand")
		return 0
	}
	if unpriv && load && reg && rt == PC {
		a.SetError("operand must be a register in range [r0, r14]")
		return 0
	}
	var inst uint32 = condBits(cond) | 0x90 | (cast(uint32, sh) << 5) | (cast(uint32, op.Reg) << 16) |
			(cast(uint32, rt) << 12)
	if load { inst = inst | (1 << 20) }
	if memAdds(op) { inst = inst | (1 << 23) }
	if !isMemPostKind(op.Kind) { inst = inst | (1 << 24) }
	if memWriteback(op) && (unpriv || !isMemPostKind(op.Kind)) { inst = inst | (1 << 21) }
	if reg { return inst | cast(uint32, op.Reg2) }
	return inst | (1 << 22) | imm8SplitOffset(a, op.Imm)
}

// ldrstrHalfEmit emits LDRH / STRH / LDRSB / LDRSH (load, sh) Rt, op -- for a label, the
// PC-relative form `[PC, #0]` with a FIX_LDRS_PC_G0 fixup, which ResolveFixups fills in --
// or, when op has no encoding, sets the assembler error and emits nothing.
func ldrstrHalfEmit(a @asm.Assembler, cond int, load bool, sh int, rt int, op Operand) {
	var mem Operand = op
	if op.Kind == OP_LABEL { mem = MemImm(PC, 0) }
	var inst uint32 = ldrstrHalfEnc(a, cond, load, sh, false, rt, mem)
	if a.HasError { return }
	if op.Kind == OP_LABEL { a.AddFixup(op.Label, FIX_LDRS_PC_G0, cast(int64, op.Imm), 4) }
	emit32(a, inst)
}

// ldrstrHalfTEmit emits LDRHT / STRHT / LDRSBT / LDRSHT (load, sh) Rt, op, or sets the assembler
// error and emits nothing.
func ldrstrHalfTEmit(a @asm.Assembler, cond int, load bool, sh int, rt int, op Operand) {
	var inst uint32 = ldrstrHalfEnc(a, cond, load, sh, true, rt, op)
	if !a.HasError { emit32(a, inst) }
}

// Ldrh emits `LDRH{cond} Rt, op` -- load zero-extended halfword.
func Ldrh(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, true, SH_H, rt, op)
}

// Strh emits `STRH{cond} Rt, op` -- store the low halfword of Rt.
func Strh(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, false, SH_H, rt, op)
}

// Ldrsb emits `LDRSB{cond} Rt, op` -- load sign-extended byte.
func Ldrsb(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, true, SH_SB, rt, op)
}

// Ldrsh emits `LDRSH{cond} Rt, op` -- load sign-extended halfword.
func Ldrsh(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfEmit(a, cond, true, SH_SH, rt, op)
}

// Ldrht emits `LDRHT{cond} Rt, op` -- load zero-extended halfword unprivileged.
func Ldrht(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfTEmit(a, cond, true, SH_H, rt, op)
}

// Strht emits `STRHT{cond} Rt, op` -- store halfword unprivileged.
func Strht(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfTEmit(a, cond, false, SH_H, rt, op)
}

// Ldrsbt emits `LDRSBT{cond} Rt, op` -- load sign-extended byte unprivileged.
func Ldrsbt(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfTEmit(a, cond, true, SH_SB, rt, op)
}

// Ldrsht emits `LDRSHT{cond} Rt, op` -- load sign-extended halfword unprivileged.
func Ldrsht(a @asm.Assembler, cond int, rt int, op Operand) {
	ldrstrHalfTEmit(a, cond, true, SH_SH, rt, op)
}
