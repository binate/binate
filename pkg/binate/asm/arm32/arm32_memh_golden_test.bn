package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Every halfword and signed-byte load / store and its T form against clang's words (Apple clang 21,
// armv7ve): each addressing form, an immediate at the ends of its range and clang's negative zero,
// a register index added and subtracted, SP and PC where clang takes them.
func TestMemHalfGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrh(a, COND_AL, R0, MemImm(R1, 0)) // ldrh r0, [r1]
	Ldrh(a, COND_AL, R0, MemPre(R1, 0)) // ldrh r0, [r1]!
	Ldrh(a, COND_AL, R0, MemImm(R1, 4)) // ldrh r0, [r1, #4]
	Ldrh(a, COND_AL, SP, MemImm(R1, 4)) // ldrh sp, [r1, #4]
	Ldrh(a, COND_AL, PC, MemImm(R1, 4)) // ldrh pc, [r1, #4]
	Ldrh(a, COND_AL, R0, MemImm(R1, -4)) // ldrh r0, [r1, #-4]
	Ldrh(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // ldrh r0, [r1, #-0]
	Ldrh(a, COND_AL, R0, MemPre(R1, 4)) // ldrh r0, [r1, #4]!
	Ldrh(a, COND_AL, R0, MemImm(R1, 255)) // ldrh r0, [r1, #255]
	Ldrh(a, COND_AL, R0, MemImm(R1, -255)) // ldrh r0, [r1, #-255]
	Ldrh(a, COND_AL, R0, MemPost(R1, 4)) // ldrh r0, [r1], #4
	Ldrh(a, COND_AL, SP, MemPost(R1, 4)) // ldrh sp, [r1], #4
	Ldrh(a, COND_AL, PC, MemPost(R1, 4)) // ldrh pc, [r1], #4
	Ldrh(a, COND_AL, R0, MemPost(R1, -4)) // ldrh r0, [r1], #-4
	Ldrh(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrh r0, [r1], #-0
	Ldrh(a, COND_AL, R0, MemReg(R1, R2)) // ldrh r0, [r1, r2]
	Ldrh(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // ldrh r0, [r1, -r2]
	Ldrh(a, COND_AL, R0, MemPreReg(R1, R2)) // ldrh r0, [r1, r2]!
	Ldrh(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrh r0, [r1], r2
	Ldrh(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrh r0, [r1], -r2
	Ldrh(a, COND_AL, R0, MemImm(PC, 4)) // ldrh r0, [pc, #4]
	Ldrh(a, COND_AL, R0, MemImm(PC, -4)) // ldrh r0, [pc, #-4]
	Ldrh(a, COND_AL, R0, MemImm(SP, 4)) // ldrh r0, [sp, #4]
	Ldrh(a, COND_AL, R0, MemReg(R1, PC)) // ldrh r0, [r1, pc]
	Ldrh(a, COND_AL, R0, MemReg(PC, R2)) // ldrh r0, [pc, r2]
	Ldrh(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrh sp, [r1], r3
	Ldrh(a, COND_AL, PC, MemPostReg(R1, R3)) // ldrh pc, [r1], r3
	Ldrh(a, COND_AL, R0, MemPost(PC, 4)) // ldrh r0, [pc], #4
	Strh(a, COND_AL, R0, MemImm(R1, 0)) // strh r0, [r1]
	Strh(a, COND_AL, R0, MemPre(R1, 0)) // strh r0, [r1]!
	Strh(a, COND_AL, R0, MemImm(R1, 4)) // strh r0, [r1, #4]
	Strh(a, COND_AL, SP, MemImm(R1, 4)) // strh sp, [r1, #4]
	Strh(a, COND_AL, PC, MemImm(R1, 4)) // strh pc, [r1, #4]
	Strh(a, COND_AL, R0, MemImm(R1, -4)) // strh r0, [r1, #-4]
	Strh(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // strh r0, [r1, #-0]
	Strh(a, COND_AL, R0, MemPre(R1, 4)) // strh r0, [r1, #4]!
	Strh(a, COND_AL, R0, MemImm(R1, 255)) // strh r0, [r1, #255]
	Strh(a, COND_AL, R0, MemImm(R1, -255)) // strh r0, [r1, #-255]
	Strh(a, COND_AL, R0, MemPost(R1, 4)) // strh r0, [r1], #4
	Strh(a, COND_AL, SP, MemPost(R1, 4)) // strh sp, [r1], #4
	Strh(a, COND_AL, PC, MemPost(R1, 4)) // strh pc, [r1], #4
	Strh(a, COND_AL, R0, MemPost(R1, -4)) // strh r0, [r1], #-4
	Strh(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // strh r0, [r1], #-0
	Strh(a, COND_AL, R0, MemReg(R1, R2)) // strh r0, [r1, r2]
	Strh(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // strh r0, [r1, -r2]
	Strh(a, COND_AL, R0, MemPreReg(R1, R2)) // strh r0, [r1, r2]!
	Strh(a, COND_AL, R0, MemPostReg(R1, R2)) // strh r0, [r1], r2
	Strh(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // strh r0, [r1], -r2
	Strh(a, COND_AL, R0, MemImm(PC, 4)) // strh r0, [pc, #4]
	Strh(a, COND_AL, R0, MemImm(PC, -4)) // strh r0, [pc, #-4]
	Strh(a, COND_AL, R0, MemImm(SP, 4)) // strh r0, [sp, #4]
	Strh(a, COND_AL, R0, MemReg(R1, PC)) // strh r0, [r1, pc]
	Strh(a, COND_AL, R0, MemReg(PC, R2)) // strh r0, [pc, r2]
	Strh(a, COND_AL, SP, MemPostReg(R1, R3)) // strh sp, [r1], r3
	Strh(a, COND_AL, PC, MemPostReg(R1, R3)) // strh pc, [r1], r3
	Strh(a, COND_AL, R0, MemPost(PC, 4)) // strh r0, [pc], #4
	Ldrsb(a, COND_AL, R0, MemImm(R1, 0)) // ldrsb r0, [r1]
	Ldrsb(a, COND_AL, R0, MemPre(R1, 0)) // ldrsb r0, [r1]!
	Ldrsb(a, COND_AL, R0, MemImm(R1, 4)) // ldrsb r0, [r1, #4]
	Ldrsb(a, COND_AL, SP, MemImm(R1, 4)) // ldrsb sp, [r1, #4]
	Ldrsb(a, COND_AL, PC, MemImm(R1, 4)) // ldrsb pc, [r1, #4]
	Ldrsb(a, COND_AL, R0, MemImm(R1, -4)) // ldrsb r0, [r1, #-4]
	Ldrsb(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // ldrsb r0, [r1, #-0]
	Ldrsb(a, COND_AL, R0, MemPre(R1, 4)) // ldrsb r0, [r1, #4]!
	Ldrsb(a, COND_AL, R0, MemImm(R1, 255)) // ldrsb r0, [r1, #255]
	Ldrsb(a, COND_AL, R0, MemImm(R1, -255)) // ldrsb r0, [r1, #-255]
	Ldrsb(a, COND_AL, R0, MemPost(R1, 4)) // ldrsb r0, [r1], #4
	Ldrsb(a, COND_AL, SP, MemPost(R1, 4)) // ldrsb sp, [r1], #4
	Ldrsb(a, COND_AL, PC, MemPost(R1, 4)) // ldrsb pc, [r1], #4
	Ldrsb(a, COND_AL, R0, MemPost(R1, -4)) // ldrsb r0, [r1], #-4
	Ldrsb(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrsb r0, [r1], #-0
	Ldrsb(a, COND_AL, R0, MemReg(R1, R2)) // ldrsb r0, [r1, r2]
	Ldrsb(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // ldrsb r0, [r1, -r2]
	Ldrsb(a, COND_AL, R0, MemPreReg(R1, R2)) // ldrsb r0, [r1, r2]!
	Ldrsb(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrsb r0, [r1], r2
	Ldrsb(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrsb r0, [r1], -r2
	Ldrsb(a, COND_AL, R0, MemImm(PC, 4)) // ldrsb r0, [pc, #4]
	Ldrsb(a, COND_AL, R0, MemImm(PC, -4)) // ldrsb r0, [pc, #-4]
	Ldrsb(a, COND_AL, R0, MemImm(SP, 4)) // ldrsb r0, [sp, #4]
	Ldrsb(a, COND_AL, R0, MemReg(R1, PC)) // ldrsb r0, [r1, pc]
	Ldrsb(a, COND_AL, R0, MemReg(PC, R2)) // ldrsb r0, [pc, r2]
	Ldrsb(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrsb sp, [r1], r3
	Ldrsb(a, COND_AL, PC, MemPostReg(R1, R3)) // ldrsb pc, [r1], r3
	Ldrsb(a, COND_AL, R0, MemPost(PC, 4)) // ldrsb r0, [pc], #4
	Ldrsh(a, COND_AL, R0, MemImm(R1, 0)) // ldrsh r0, [r1]
	Ldrsh(a, COND_AL, R0, MemPre(R1, 0)) // ldrsh r0, [r1]!
	Ldrsh(a, COND_AL, R0, MemImm(R1, 4)) // ldrsh r0, [r1, #4]
	Ldrsh(a, COND_AL, SP, MemImm(R1, 4)) // ldrsh sp, [r1, #4]
	Ldrsh(a, COND_AL, PC, MemImm(R1, 4)) // ldrsh pc, [r1, #4]
	Ldrsh(a, COND_AL, R0, MemImm(R1, -4)) // ldrsh r0, [r1, #-4]
	Ldrsh(a, COND_AL, R0, SubIndex(MemImm(R1, 0))) // ldrsh r0, [r1, #-0]
	Ldrsh(a, COND_AL, R0, MemPre(R1, 4)) // ldrsh r0, [r1, #4]!
	Ldrsh(a, COND_AL, R0, MemImm(R1, 255)) // ldrsh r0, [r1, #255]
	Ldrsh(a, COND_AL, R0, MemImm(R1, -255)) // ldrsh r0, [r1, #-255]
	Ldrsh(a, COND_AL, R0, MemPost(R1, 4)) // ldrsh r0, [r1], #4
	Ldrsh(a, COND_AL, SP, MemPost(R1, 4)) // ldrsh sp, [r1], #4
	Ldrsh(a, COND_AL, PC, MemPost(R1, 4)) // ldrsh pc, [r1], #4
	Ldrsh(a, COND_AL, R0, MemPost(R1, -4)) // ldrsh r0, [r1], #-4
	Ldrsh(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrsh r0, [r1], #-0
	Ldrsh(a, COND_AL, R0, MemReg(R1, R2)) // ldrsh r0, [r1, r2]
	Ldrsh(a, COND_AL, R0, SubIndex(MemReg(R1, R2))) // ldrsh r0, [r1, -r2]
	Ldrsh(a, COND_AL, R0, MemPreReg(R1, R2)) // ldrsh r0, [r1, r2]!
	Ldrsh(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrsh r0, [r1], r2
	Ldrsh(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrsh r0, [r1], -r2
	Ldrsh(a, COND_AL, R0, MemImm(PC, 4)) // ldrsh r0, [pc, #4]
	Ldrsh(a, COND_AL, R0, MemImm(PC, -4)) // ldrsh r0, [pc, #-4]
	Ldrsh(a, COND_AL, R0, MemImm(SP, 4)) // ldrsh r0, [sp, #4]
	Ldrsh(a, COND_AL, R0, MemReg(R1, PC)) // ldrsh r0, [r1, pc]
	Ldrsh(a, COND_AL, R0, MemReg(PC, R2)) // ldrsh r0, [pc, r2]
	Ldrsh(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrsh sp, [r1], r3
	Ldrsh(a, COND_AL, PC, MemPostReg(R1, R3)) // ldrsh pc, [r1], r3
	Ldrsh(a, COND_AL, R0, MemPost(PC, 4)) // ldrsh r0, [pc], #4
	Ldrht(a, COND_AL, R0, MemPost(R1, 0)) // ldrht r0, [r1]
	Ldrht(a, COND_AL, R0, MemPost(R1, 4)) // ldrht r0, [r1], #4
	Ldrht(a, COND_AL, SP, MemPost(R1, 4)) // ldrht sp, [r1], #4
	Ldrht(a, COND_AL, PC, MemPost(R1, 4)) // ldrht pc, [r1], #4
	Ldrht(a, COND_AL, R0, MemPost(R1, -4)) // ldrht r0, [r1], #-4
	Ldrht(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrht r0, [r1], #-0
	Ldrht(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrht r0, [r1], r2
	Ldrht(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrht r0, [r1], -r2
	Ldrht(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrht sp, [r1], r3
	Ldrht(a, COND_AL, R0, MemPost(PC, 4)) // ldrht r0, [pc], #4
	Strht(a, COND_AL, R0, MemPost(R1, 4)) // strht r0, [r1], #4
	Strht(a, COND_AL, SP, MemPost(R1, 4)) // strht sp, [r1], #4
	Strht(a, COND_AL, PC, MemPost(R1, 4)) // strht pc, [r1], #4
	Strht(a, COND_AL, R0, MemPost(R1, -4)) // strht r0, [r1], #-4
	Strht(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // strht r0, [r1], #-0
	Strht(a, COND_AL, R0, MemPostReg(R1, R2)) // strht r0, [r1], r2
	Strht(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // strht r0, [r1], -r2
	Strht(a, COND_AL, SP, MemPostReg(R1, R3)) // strht sp, [r1], r3
	Strht(a, COND_AL, PC, MemPostReg(R1, R3)) // strht pc, [r1], r3
	Strht(a, COND_AL, R0, MemPost(PC, 4)) // strht r0, [pc], #4
	Ldrsbt(a, COND_AL, R0, MemPost(R1, 0)) // ldrsbt r0, [r1]
	Ldrsbt(a, COND_AL, R0, MemPost(R1, 4)) // ldrsbt r0, [r1], #4
	Ldrsbt(a, COND_AL, SP, MemPost(R1, 4)) // ldrsbt sp, [r1], #4
	Ldrsbt(a, COND_AL, PC, MemPost(R1, 4)) // ldrsbt pc, [r1], #4
	Ldrsbt(a, COND_AL, R0, MemPost(R1, -4)) // ldrsbt r0, [r1], #-4
	Ldrsbt(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrsbt r0, [r1], #-0
	Ldrsbt(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrsbt r0, [r1], r2
	Ldrsbt(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrsbt r0, [r1], -r2
	Ldrsbt(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrsbt sp, [r1], r3
	Ldrsbt(a, COND_AL, R0, MemPost(PC, 4)) // ldrsbt r0, [pc], #4
	Ldrsht(a, COND_AL, R0, MemPost(R1, 0)) // ldrsht r0, [r1]
	Ldrsht(a, COND_AL, R0, MemPost(R1, 4)) // ldrsht r0, [r1], #4
	Ldrsht(a, COND_AL, SP, MemPost(R1, 4)) // ldrsht sp, [r1], #4
	Ldrsht(a, COND_AL, PC, MemPost(R1, 4)) // ldrsht pc, [r1], #4
	Ldrsht(a, COND_AL, R0, MemPost(R1, -4)) // ldrsht r0, [r1], #-4
	Ldrsht(a, COND_AL, R0, SubIndex(MemPost(R1, 0))) // ldrsht r0, [r1], #-0
	Ldrsht(a, COND_AL, R0, MemPostReg(R1, R2)) // ldrsht r0, [r1], r2
	Ldrsht(a, COND_AL, R0, SubIndex(MemPostReg(R1, R2))) // ldrsht r0, [r1], -r2
	Ldrsht(a, COND_AL, SP, MemPostReg(R1, R3)) // ldrsht sp, [r1], r3
	Ldrsht(a, COND_AL, R0, MemPost(PC, 4)) // ldrsht r0, [pc], #4
	var want @[]uint32 = make_slice(uint32, 152)
	want[0] = 0xE1D100B0
