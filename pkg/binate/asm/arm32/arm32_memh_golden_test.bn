	want[142] = 0xE0F100F0
	want[143] = 0xE0F100F4
	want[144] = 0xE0F1D0F4
	want[145] = 0xE0F1F0F4
	want[146] = 0xE07100F4
	want[147] = 0xE07100F0
	want[148] = 0xE0B100F2
	want[149] = 0xE03100F2
	want[150] = 0xE0B1D0F3
	want[151] = 0xE0FF00F4

	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] {
			return fail("a halfword or signed-byte load / store encoded unlike clang")
		}
	}
	return ""
}
