package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

func TestLdrhImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRH R0, [R1, #0]
	// Extra load/store: 000 | P=1 | U=1 | I=1 | W=0 | L=1
	//   | Rn=0001 | Rt=0000 | immH=0000 | 1 | SH=01 | 1 | immL=0000
	// = 0xE1D100B0
	Ldrh(a, COND_AL, R0, MemImm(R1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1D100B0 {
		return fail("LDRH R0, [R1] encoding wrong")
	}
	return ""
}

func TestStrhImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// STRH R0, [R1, #4]
	// L=0, I=1, offset=4 (immH=0, immL=4)
	// = 0xE1C100B4
	Strh(a, COND_AL, R0, MemImm(R1, 4))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1C100B4 {
		return fail("STRH R0, [R1, #4] encoding wrong")
	}
	return ""
}

func TestLdrsbImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRSB R0, [R1, #0]
	// SH=10 (signed byte)
	// = 0xE1D100D0
	Ldrsb(a, COND_AL, R0, MemImm(R1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1D100D0 {
		return fail("LDRSB R0, [R1] encoding wrong")
	}
	return ""
}

func TestLdrshImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// LDRSH R0, [R1, #0]
	// SH=11 (signed halfword)
	// = 0xE1D100F0
	Ldrsh(a, COND_AL, R0, MemImm(R1, 0))
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1D100F0 {
		return fail("LDRSH R0, [R1] encoding wrong")
	}
	return ""
}

// In-range LDRH/STRH offsets at the 255 boundary must NOT error.
func TestLdrhStrhImm8BoundaryNoError() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrh(a, COND_AL, R0, MemImm(R1, 255))
	if a.HasError {
		return fail("LDRH with offset 255 (max) should NOT error")
	}
	var b @asm.Assembler = newAsm()
	Strh(b, COND_AL, R0, MemImm(R1, -255))
	if b.HasError {
		return fail("STRH with offset -255 (max) should NOT error")
	}
	return ""
}

// LDRH/STRH/LDRSB/LDRSH offsets past ±255 must error.
func TestLdrhLdrshImm8OverflowErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Strh(a, COND_AL, R0, MemImm(R1, 256))
	if !a.HasError {
		return fail("STRH with offset 256 (>255) should error, not wrap")
	}
	var b @asm.Assembler = newAsm()
	Ldrsh(b, COND_AL, R0, MemImm(R1, -256))
	if !b.HasError {
		return fail("LDRSH with offset -256 (<-255) should error, not wrap")
	}
	var c @asm.Assembler = newAsm()
	Ldrsb(c, COND_AL, R0, MemImm(R1, 256))
	if !c.HasError {
		return fail("LDRSB with offset 256 (>255) should error, not wrap")
	}
	return ""
}

// The halfword and signed-byte loads and stores refuse what clang does -- a form writing its base
// back with Rt as the base, a shifted register index, a T form's operand other than a
// post-indexed one, a T load's register form with PC as Rt -- and a condition past COND_AL;
// nothing is emitted.  A T store's register form takes PC as Rt (0xE0A1F0B2).
func TestMemHalfRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldrh(a, COND_AL, R1, MemPreReg(R1, R2))
	if !memRejectedWith(a, "destination register and base register can't be identical") {
		return fail("LDRH R1, [R1, R2]! accepted")
	}
	a = newAsm()
	Strh(a, COND_AL, R1, MemPost(R1, 2))
	if !memRejectedWith(a, "source register and base register can't be identical") {
		return fail("STRH R1, [R1], #2 accepted")
	}
	a = newAsm()
	Ldrsh(a, COND_AL, R0, MemSReg(R1, R2, LSL, 1))
	if !memRejected(a) { return fail("LDRSH with a shifted index accepted") }
	a = newAsm()
	Ldrht(a, COND_AL, R0, MemImm(R1, 2))
	if !memRejected(a) { return fail("LDRHT R0, [R1, #2] accepted") }
	a = newAsm()
	Ldrsbt(a, COND_AL, R0, MemPostSReg(R1, R2, LSL, 1))
	if !memRejected(a) { return fail("LDRSBT with a shifted index accepted") }
	a = newAsm()
	Ldrsht(a, COND_AL, PC, MemPostReg(R1, R2))
	if !memRejected(a) { return fail("LDRSHT PC, [R1], R2 accepted") }
	a = newAsm()
	Ldrht(a, COND_AL, PC, MemPost(R1, 2))
	if a.HasError || readInst(a.Sections[0], 0) != 0xE0F1F0B2 {
		return fail("LDRHT PC, [R1], #2 not 0xE0F1F0B2")
	}
	a = newAsm()
	Strht(a, COND_AL, PC, MemPostReg(R1, R2))
	if a.HasError || readInst(a.Sections[0], 0) != 0xE0A1F0B2 {
		return fail("STRHT PC, [R1], R2 not 0xE0A1F0B2")
	}
	a = newAsm()
	Ldrsb(a, 15, R0, MemImm(R1, 0))
	if !memRejected(a) { return fail("LDRSB under condition 15 accepted") }
	return ""
}
