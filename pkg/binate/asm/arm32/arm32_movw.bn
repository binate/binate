package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// --- Move wide (ARMv6T2+) ---

// Movw: MOVW Rd, #imm16 — load 16-bit immediate into bottom half of Rd
// Encoding: cond|0011|0000|imm4[19:16]|Rd[15:12]|imm12[11:0]
func Movw(a @asm.Assembler, cond int, rd int, imm int) {
	if !moveWideOk(a, rd, imm, true) { return }
	var uimm uint32 = cast(uint32, imm & 0xffff)
	var imm4 uint32 = (uimm >> 12) & 0xf
	var imm12 uint32 = uimm & 0xfff
	var inst uint32 = condBits(cond)
	inst = inst | 0x03000000
	inst = inst | (imm4 << 16)
	inst = inst | (cast(uint32, rd & 0xf) << 12)
	inst = inst | imm12
	emit32(a, inst)
}

// Movt: MOVT Rd, #imm16 — load 16-bit immediate into top half of Rd
// Encoding: cond|0011|0100|imm4[19:16]|Rd[15:12]|imm12[11:0]
func Movt(a @asm.Assembler, cond int, rd int, imm int) {
	if !moveWideOk(a, rd, imm, false) { return }
	var uimm uint32 = cast(uint32, imm & 0xffff)
	var imm4 uint32 = (uimm >> 12) & 0xf
	var imm12 uint32 = uimm & 0xfff
	var inst uint32 = condBits(cond)
	inst = inst | 0x03400000
	inst = inst | (imm4 << 16)
	inst = inst | (cast(uint32, rd & 0xf) << 12)
	inst = inst | imm12
	emit32(a, inst)
}

// MovwLabel emits MOVW Rd with a zero 16-bit immediate and records a
// FIX_MOVW_ABS_NC fixup at the instruction's offset. The fixup is added
// BEFORE the emit (AddFixup records at the current section offset, which
// is where the instruction is about to be written) — mirroring how
// B/Bl/Ldr(Label) record their fixups. The object writer turns it into an
// R_ARM_MOVW_ABS_NC relocation so the linker patches the low 16 bits of
// `name`'s absolute address into imm4:imm12.
func MovwLabel(a @asm.Assembler, cond int, rd int, name *[]readonly char) {
	MovwRef(a, cond, rd, name, FIX_MOVW_ABS_NC, 0)
}

// MovwRef emits MOVW Rd with the relocated immediate (arm32.bni); the fixup is recorded first,
// at the instruction's offset, as MovwLabel's is.
func MovwRef(a @asm.Assembler, cond int, rd int, name *[]readonly char, kind int, addend int64) {
	if !moveWideOk(a, rd, 0, true) || !moveWideRefOk(a, kind, addend) { return }
	a.AddFixup(name, kind, addend, 4)
	Movw(a, cond, rd, 0)
}

// MovtRef emits MOVT Rd with the relocated immediate (MovwRef).
func MovtRef(a @asm.Assembler, cond int, rd int, name *[]readonly char, kind int, addend int64) {
	if !moveWideOk(a, rd, 0, false) || !moveWideRefOk(a, kind, addend) { return }
	a.AddFixup(name, kind, addend, 4)
	Movt(a, cond, rd, 0)
}

// moveWideRefOk reports whether kind is a MOVW / MOVT relocation kind and addend fits the
// immediate that carries it (moveWideAddendOk), setting the assembler error if not.
func moveWideRefOk(a @asm.Assembler, kind int, addend int64) bool {
	if kind != FIX_MOVW_ABS_NC && kind != FIX_MOVT_ABS && kind != FIX_MOVW_PREL_NC &&
			kind != FIX_MOVT_PREL {
		a.SetError("arm32: a MOVW / MOVT reference takes a MOVW / MOVT relocation kind")
		return false
	}
	return moveWideAddendOk(a, kind, addend)
}

// moveWideAddendOk reports whether a relocation of the MOVW / MOVT kind can carry addend in its
// 16-bit immediate, which the linker sign-extends, setting the assembler error if not: a
// low-half kind (FIX_MOVW_ABS_NC, FIX_MOVW_PREL_NC) any 32-bit addend, of which it needs the low
// 16 bits alone; a high-half one (FIX_MOVT_ABS, FIX_MOVT_PREL) one in [-0x8000, 0x7FFF], as a
// larger one would change the high half -- clang truncates a distance it folds there, a wrong
// high half.
func moveWideAddendOk(a @asm.Assembler, kind int, addend int64) bool {
	if kind == FIX_MOVT_ABS || kind == FIX_MOVT_PREL {
		if addend >= -0x8000 && addend <= 0x7FFF { return true }
		a.SetError("arm32: a MOVT relocation's addend must be in [-0x8000, 0x7FFF]")
		return false
	}
	if addend >= -0x80000000 && addend <= 0xFFFFFFFF { return true }
	a.SetError("arm32: a MOVW relocation's addend must fit 32 bits")
	return false
}

// moveWideOk reports whether MOVW / MOVT can move imm into rd — rd one of R0..R14, or PC
// where pc (MOVW: clang takes it, though the architecture leaves it UNPREDICTABLE; not MOVT) —
// and imm in [0, 65535], setting the assembler error if not.
func moveWideOk(a @asm.Assembler, rd int, imm int, pc bool) bool {
	if rd < 0 || rd > 15 || rd == PC && !pc {
		a.SetError("operand must be a register in range [r0, r14]")
		return false
	}
	if imm < 0 || imm > 0xFFFF {
		a.SetError("arm32: MOVW / MOVT immediate out of range [0, 65535]")
		return false
	}
	return true
}

// MovtLabel emits MOVT Rd with a zero 16-bit immediate and records a
// FIX_MOVT_ABS fixup at the instruction's offset (see MovwLabel). The
// object writer turns it into an R_ARM_MOVT_ABS relocation so the linker
// patches the high 16 bits of `name`'s absolute address into imm4:imm12.
func MovtLabel(a @asm.Assembler, cond int, rd int, name *[]readonly char) {
	MovtRef(a, cond, rd, name, FIX_MOVT_ABS, 0)
}
