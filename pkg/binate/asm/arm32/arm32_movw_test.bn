package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// --- MOVW / MOVT ---

func TestMovwImm16() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVW R0, #0x1234
	// cond=1110 | 0011 0000 | imm4=0001 | Rd=0000 | imm12=001000110100
	// = 0xE3010234
	Movw(a, COND_AL, R0, 0x1234)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE3010234 {
		return fail("MOVW R0, #0x1234 encoding wrong")
	}
	return ""
}

func TestMovtImm16() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVT R0, #0xABCD
	// cond=1110 | 0011 0100 | imm4=1010 | Rd=0000 | imm12=101111001101
	// = 0xE34A0BCD
	Movt(a, COND_AL, R0, 0xABCD)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE34A0BCD {
		return fail("MOVT R0, #0xABCD encoding wrong")
	}
	return ""
}

// MOVW takes Rd in R0..R15 and MOVT in R0..R14 (clang takes MOVW into PC, not MOVT), and each an
// immediate in [0, 65535]: anything else is an assembler error with nothing emitted (a label form
// records no fixup either), not a silently masked register or immediate.
func TestMoveWideRejects() testing.TestResult {
	var ok @asm.Assembler = newAsm()
	Movw(ok, COND_AL, 13, 0xFFFF)
	Movt(ok, COND_AL, 14, 0)
	if ok.HasError || ok.Sections[0].Len != 8 { return fail("MOVW SP / MOVT LR refused") }
	var a @asm.Assembler = newAsm()
	Movw(a, COND_AL, 15, 1)
	if a.HasError || readInst(a.Sections[0], 0) != 0xE300F001 { return fail("MOVW PC, #1 refused") }
	var b @asm.Assembler = newAsm()
	Movt(b, COND_AL, 15, 1)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("MOVT PC accepted") }
	var c @asm.Assembler = newAsm()
	Movw(c, COND_AL, R0, 0x10000)
	if !c.HasError || c.Sections[0].Len != 0 { return fail("MOVW #0x10000 accepted") }
	var d @asm.Assembler = newAsm()
	Movt(d, COND_AL, R0, -1)
	if !d.HasError || d.Sections[0].Len != 0 { return fail("MOVT #-1 accepted") }
	var f @asm.Assembler = newAsm()
	MovwLabel(f, COND_AL, 16, "sym")
	if !f.HasError || f.Sections[0].Len != 0 || f.Sections[0].NumFixups != 0 {
		return fail("MOVW R16, #:lower16:sym accepted")
	}
	var g @asm.Assembler = newAsm()
	MovtLabel(g, COND_AL, 15, "sym")
	if !g.HasError || g.Sections[0].NumFixups != 0 { return fail("MOVT PC, #:upper16:sym accepted") }
	return ""
}

// --- MOVW / MOVT label (absolute-address relocations) ---

func TestMovwLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVW R2, #:lower16:sym — base MOVW with zero immediate.
	// cond=1110 | 0011 0000 | imm4=0000 | Rd=0010 | imm12=0
	// = 0xE3002000
	MovwLabel(a, COND_AL, R2, "sym")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE3002000 {
		return fail("MOVW label base instruction wrong")
	}
	// One fixup recorded: FIX_MOVW_ABS_NC at offset 0 referencing "sym".
	if a.Sections[0].NumFixups != 1 {
		return fail("MOVW label should record exactly one fixup")
	}
	var fx asm.Fixup = a.Sections[0].Fixups[0]
	if fx.Kind != FIX_MOVW_ABS_NC {
		return fail("MOVW label fixup kind wrong")
	}
	if fx.Offset != 0 {
		return fail("MOVW label fixup offset wrong")
	}
	if !charsSame(fx.Label, "sym") {
		return fail("MOVW label fixup symbol wrong")
	}
	return ""
}

func TestMovtLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MOVT R2, #:upper16:sym — base MOVT with zero immediate.
	// cond=1110 | 0011 0100 | imm4=0000 | Rd=0010 | imm12=0
	// = 0xE3402000
	MovtLabel(a, COND_AL, R2, "sym")
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE3402000 {
		return fail("MOVT label base instruction wrong")
	}
	if a.Sections[0].NumFixups != 1 {
		return fail("MOVT label should record exactly one fixup")
	}
	var fx asm.Fixup = a.Sections[0].Fixups[0]
	if fx.Kind != FIX_MOVT_ABS {
		return fail("MOVT label fixup kind wrong")
	}
	if fx.Offset != 0 {
		return fail("MOVT label fixup offset wrong")
	}
	if !charsSame(fx.Label, "sym") {
		return fail("MOVT label fixup symbol wrong")
	}
	return ""
}

// MovwLabel + MovtLabel materialize a 32-bit address across two
// instructions; the second fixup must land at offset 4 (the MOVT).
func TestMovwMovtLabelPair() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovwLabel(a, COND_AL, R3, "sym") // offset 0
	MovtLabel(a, COND_AL, R3, "sym") // offset 4
	if a.Sections[0].NumFixups != 2 {
		return fail("pair should record two fixups")
	}
	var f0 asm.Fixup = a.Sections[0].Fixups[0]
	var f1 asm.Fixup = a.Sections[0].Fixups[1]
	if f0.Kind != FIX_MOVW_ABS_NC || f0.Offset != 0 {
		return fail("first fixup should be MOVW_ABS_NC at offset 0")
	}
	if f1.Kind != FIX_MOVT_ABS || f1.Offset != 4 {
		return fail("second fixup should be MOVT_ABS at offset 4")
	}
	return ""
}

// The MOVW/MOVT_ABS fixups are left unresolved by ResolveFixups (they need
// relocations) — ResolveFixups must succeed and NOT mark them resolved.
func TestMovwMovtLabelNotResolvedInSection() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovwLabel(a, COND_AL, R0, "sym")
	MovtLabel(a, COND_AL, R0, "sym")
	a.DefineLabel("sym") // even a same-section definition stays a reloc

	var ok bool = ResolveFixups(a)
	if !ok {
		return fail("ResolveFixups should succeed with MOVW/MOVT fixups")
	}
	// Kind is set to -1 only when resolved in-section; these must keep
	// their original kinds so Finalize records them as relocations.
	if a.Sections[0].Fixups[0].Kind != FIX_MOVW_ABS_NC {
		return fail("MOVW fixup must be left unresolved")
	}
	if a.Sections[0].Fixups[1].Kind != FIX_MOVT_ABS {
		return fail("MOVT fixup must be left unresolved")
	}
	return ""
}

// MovwRef / MovtRef record a fixup of the kind and addend given, either half in either
// instruction, and ResolveFixups writes the addend into the immediate, the field an arm32 REL
// relocation reads it from: a low-half kind's low 16 bits of any 32-bit addend, a high-half
// kind's addend in [-0x8000, 0x7FFF].  Another kind, an addend outside that, or MOVT into PC
// is an error with nothing emitted.
func TestMoveWideRef() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MovwRef(a, COND_AL, R0, "ext", FIX_MOVT_ABS, 4)
	MovtRef(a, COND_EQ, R1, "ext", FIX_MOVW_PREL_NC, -12)
	MovwRef(a, COND_AL, R2, "ext", FIX_MOVT_PREL, 0x7FFF)
	MovtRef(a, COND_AL, R3, "ext", FIX_MOVW_ABS_NC, -0x8000)
	if a.HasError || a.Sections[0].NumFixups != 4 { return fail("four references not recorded") }
	var f asm.Fixup = a.Sections[0].Fixups[1]
	if f.Kind != FIX_MOVW_PREL_NC || f.Addend != -12 || f.Offset != 4 {
		return fail("MOVT's fixup not FIX_MOVW_PREL_NC, -12 at 4")
	}
	if !ResolveFixups(a) { return fail("the references not resolved") }
	if readInst(a.Sections[0], 0) != 0xE3000004 || readInst(a.Sections[0], 4) != 0x034F1FF4 ||
			readInst(a.Sections[0], 8) != 0xE3072FFF || readInst(a.Sections[0], 12) != 0xE3483000 {
		return fail("an addend not in its immediate")
	}
	var b @asm.Assembler = newAsm()
	MovwRef(b, COND_AL, R0, "ext", FIX_ABS32, 0)
	if !b.HasError || b.Sections[0].Len != 0 || b.Sections[0].NumFixups != 0 {
		return fail("a MOVW reference of kind FIX_ABS32 accepted")
	}
	var c @asm.Assembler = newAsm()
	MovtRef(c, COND_AL, R0, "ext", FIX_MOVT_ABS, 0x8000)
	if !c.HasError || c.Sections[0].Len != 0 { return fail("an addend of 0x8000 accepted") }
	var d @asm.Assembler = newAsm()
	MovwRef(d, COND_AL, R0, "ext", FIX_MOVW_ABS_NC, -0x8001)
	MovtRef(d, COND_AL, R1, "ext", FIX_MOVW_PREL_NC, 0x12345)
	if d.HasError || !ResolveFixups(d) || readInst(d.Sections[0], 0) != 0xE3070FFF ||
			readInst(d.Sections[0], 4) != 0xE3421345 {
		return fail("a low-half addend past 16 bits not kept as its low 16 bits")
	}
	var h @asm.Assembler = newAsm()
	MovwRef(h, COND_AL, R0, "ext", FIX_MOVT_PREL, -0x8001)
	if !h.HasError || h.Sections[0].Len != 0 { return fail("a high-half addend of -0x8001 accepted") }
	var k @asm.Assembler = newAsm()
	MovwRef(k, COND_AL, R0, "ext", FIX_MOVW_ABS_NC, 0x100000000)
	if !k.HasError || k.Sections[0].Len != 0 { return fail("a low-half addend past 32 bits accepted") }
	var g @asm.Assembler = newAsm()
	MovtRef(g, COND_AL, PC, "ext", FIX_MOVT_ABS, 0)
	if !g.HasError || g.Sections[0].NumFixups != 0 { return fail("MOVT PC reference accepted") }
	return ""
}
