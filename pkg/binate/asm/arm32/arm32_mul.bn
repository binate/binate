package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// The multiplies and divides, exact (arm32.bni): each checks its condition and registers and
// emits nothing when one has no encoding, with clang's message where clang rejects it.

// mulOk reports whether a four-register multiply takes cond and the registers r0 .. r3,
// setting the assembler error if not: cond COND_EQ .. COND_AL, each register R0..R15, and none PC
// whose bit is set in noPC (bit i for ri), as clang takes them.
func mulOk(a @asm.Assembler, cond int, r0 int, r1 int, r2 int, r3 int, noPC int) bool {
	return mul3Ok(a, cond, r0, r1, r2, noPC) && mulRegOk(a, r3, noPC & 8 != 0)
}

// mul3Ok is mulOk for a three-register multiply or divide.
func mul3Ok(a @asm.Assembler, cond int, r0 int, r1 int, r2 int, noPC int) bool {
	if cond < COND_EQ || cond > COND_AL {
		a.SetError("arm32: condition out of range (must be COND_EQ..COND_AL)")
		return false
	}
	return mulRegOk(a, r0, noPC & 1 != 0) && mulRegOk(a, r1, noPC & 2 != 0) &&
			mulRegOk(a, r2, noPC & 4 != 0)
}

// mulRegOk reports whether r is R0..R15 and, when noPC, not PC, setting the assembler error if
// not.
func mulRegOk(a @asm.Assembler, r int, noPC bool) bool {
	if r < 0 || r > 15 {
		a.SetError("arm32: a multiply's register must be R0..R15")
		return false
	}
	if noPC && r == PC {
		a.SetError("operand must be a register in range [r0, r14]")
		return false
	}
	return true
}

// longMulOk reports whether a long multiply's two destinations differ, setting the assembler
// error if not, as clang requires.
func longMulOk(a @asm.Assembler, rdlo int, rdhi int) bool {
	if rdlo != rdhi { return true }
	a.SetError("unpredictable instruction, RdHi and RdLo must be different")
	return false
}

// mulWord returns the multiply word of cond and op (bits 27:20 and 7:4, S included) with the
// registers r19 (bits 19:16), r15 (15:12), r11 (11:8) and r3 (3:0).
func mulWord(cond int, op uint32, r19 int, r15 int, r11 int, r3 int) uint32 {
	return condBits(cond) | op | (cast(uint32, r19) << 16) | (cast(uint32, r15) << 12) |
			(cast(uint32, r11) << 8) | cast(uint32, r3)
}

// topBit returns bit for top, 0 otherwise: a halfword selector (`t` / `b`) or an `x` / `r`
// suffix.
func topBit(top bool, bit uint32) uint32 {
	if top { return bit }
	return 0
}

// Mul emits MUL{S} Rd, Rn, Rm.
func Mul(a @asm.Assembler, cond int, s bool, rd int, rn int, rm int) {
	if !mul3Ok(a, cond, rd, rn, rm, 7) { return }
	emit32(a, mulWord(cond, 0x00000090 | sBit(s), rd, 0, rm, rn))
}

// Mla emits MLA{S} Rd, Rn, Rm, Ra.
func Mla(a @asm.Assembler, cond int, s bool, rd int, rn int, rm int, ra int) {
	if !mulOk(a, cond, rd, rn, rm, ra, 15) { return }
	emit32(a, mulWord(cond, 0x00200090 | sBit(s), rd, ra, rm, rn))
}

// Mls emits MLS Rd, Rn, Rm, Ra (Rd = Ra - Rn * Rm).
func Mls(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int) {
	if !mulOk(a, cond, rd, rn, rm, ra, 0) { return }
	emit32(a, mulWord(cond, 0x00600090, rd, ra, rm, rn))
}

// longMul emits the long multiply op (bits 27:20 and 7:4) RdLo, RdHi, Rn, Rm, noPC as mulOk
// takes it.
func longMul(a @asm.Assembler, cond int, op uint32, rdlo int, rdhi int, rn int, rm int, noPC int) {
	if !mulOk(a, cond, rdlo, rdhi, rn, rm, noPC) || !longMulOk(a, rdlo, rdhi) { return }
	emit32(a, mulWord(cond, op, rdhi, rdlo, rm, rn))
}

// Umull emits UMULL{S} RdLo, RdHi, Rn, Rm.
func Umull(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int) {
	longMul(a, cond, 0x00800090 | sBit(s), rdlo, rdhi, rn, rm, 0)
}

// Umlal emits UMLAL{S} RdLo, RdHi, Rn, Rm.
func Umlal(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int) {
	longMul(a, cond, 0x00A00090 | sBit(s), rdlo, rdhi, rn, rm, 0)
}

// Smull emits SMULL{S} RdLo, RdHi, Rn, Rm.
func Smull(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int) {
	longMul(a, cond, 0x00C00090 | sBit(s), rdlo, rdhi, rn, rm, 0)
}

// Smlal emits SMLAL{S} RdLo, RdHi, Rn, Rm.
func Smlal(a @asm.Assembler, cond int, s bool, rdlo int, rdhi int, rn int, rm int) {
	longMul(a, cond, 0x00E00090 | sBit(s), rdlo, rdhi, rn, rm, 0)
}

// Umaal emits UMAAL RdLo, RdHi, Rn, Rm.
func Umaal(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int) {
	longMul(a, cond, 0x00400090, rdlo, rdhi, rn, rm, 0)
}

// SmlaXY emits SMLA<x><y> Rd, Rn, Rm, Ra: x the top (nTop) or bottom half of Rn, y of Rm.
func SmlaXY(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, nTop bool, mTop bool) {
	if !mulOk(a, cond, rd, rn, rm, ra, 7) { return }
	emit32(a, mulWord(cond, 0x01000080 | topBit(nTop, 0x20) | topBit(mTop, 0x40), rd, ra, rm, rn))
}

// SmlawY emits SMLAW<y> Rd, Rn, Rm, Ra: y the top (mTop) or bottom half of Rm.
func SmlawY(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, mTop bool) {
	if !mulOk(a, cond, rd, rn, rm, ra, 7) { return }
	emit32(a, mulWord(cond, 0x01200080 | topBit(mTop, 0x40), rd, ra, rm, rn))
}

// SmulwY emits SMULW<y> Rd, Rn, Rm: y the top (mTop) or bottom half of Rm.
func SmulwY(a @asm.Assembler, cond int, rd int, rn int, rm int, mTop bool) {
	if !mul3Ok(a, cond, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x012000A0 | topBit(mTop, 0x40), rd, 0, rm, rn))
}

// SmlalXY emits SMLAL<x><y> RdLo, RdHi, Rn, Rm: x the top (nTop) or bottom half of Rn, y of Rm.
func SmlalXY(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int, nTop bool, mTop bool) {
	longMul(a, cond, 0x01400080 | topBit(nTop, 0x20) | topBit(mTop, 0x40), rdlo, rdhi, rn, rm, 15)
}

// SmulXY emits SMUL<x><y> Rd, Rn, Rm: x the top (nTop) or bottom half of Rn, y of Rm.
func SmulXY(a @asm.Assembler, cond int, rd int, rn int, rm int, nTop bool, mTop bool) {
	if !mul3Ok(a, cond, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x01600080 | topBit(nTop, 0x20) | topBit(mTop, 0x40), rd, 0, rm, rn))
}

// Smlad emits SMLAD{X} Rd, Rn, Rm, Ra (x: Rm's halves exchanged).
func Smlad(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, x bool) {
	if !mulOk(a, cond, rd, rn, rm, ra, 7) { return }
	emit32(a, mulWord(cond, 0x07000010 | topBit(x, 0x20), rd, ra, rm, rn))
}

// Smlsd emits SMLSD{X} Rd, Rn, Rm, Ra.
func Smlsd(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, x bool) {
	if !mulOk(a, cond, rd, rn, rm, ra, 7) { return }
	emit32(a, mulWord(cond, 0x07000050 | topBit(x, 0x20), rd, ra, rm, rn))
}

// Smuad emits SMUAD{X} Rd, Rn, Rm.
func Smuad(a @asm.Assembler, cond int, rd int, rn int, rm int, x bool) {
	if !mul3Ok(a, cond, rd, rn, rm, 7) { return }
	emit32(a, mulWord(cond, 0x07000010 | topBit(x, 0x20), rd, 15, rm, rn))
}

// Smusd emits SMUSD{X} Rd, Rn, Rm.
func Smusd(a @asm.Assembler, cond int, rd int, rn int, rm int, x bool) {
	if !mul3Ok(a, cond, rd, rn, rm, 7) { return }
	emit32(a, mulWord(cond, 0x07000050 | topBit(x, 0x20), rd, 15, rm, rn))
}

// Smlald emits SMLALD{X} RdLo, RdHi, Rn, Rm.
func Smlald(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int, x bool) {
	longMul(a, cond, 0x07400010 | topBit(x, 0x20), rdlo, rdhi, rn, rm, 15)
}

// Smlsld emits SMLSLD{X} RdLo, RdHi, Rn, Rm.
func Smlsld(a @asm.Assembler, cond int, rdlo int, rdhi int, rn int, rm int, x bool) {
	longMul(a, cond, 0x07400050 | topBit(x, 0x20), rdlo, rdhi, rn, rm, 15)
}

// Smmla emits SMMLA{R} Rd, Rn, Rm, Ra (r: rounded).
func Smmla(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, round bool) {
	if !mulOk(a, cond, rd, rn, rm, ra, 0) { return }
	emit32(a, mulWord(cond, 0x07500010 | topBit(round, 0x20), rd, ra, rm, rn))
}

// Smmls emits SMMLS{R} Rd, Rn, Rm, Ra.
func Smmls(a @asm.Assembler, cond int, rd int, rn int, rm int, ra int, round bool) {
	if !mulOk(a, cond, rd, rn, rm, ra, 0) { return }
	emit32(a, mulWord(cond, 0x075000D0 | topBit(round, 0x20), rd, ra, rm, rn))
}

// Smmul emits SMMUL{R} Rd, Rn, Rm.
func Smmul(a @asm.Assembler, cond int, rd int, rn int, rm int, round bool) {
	if !mul3Ok(a, cond, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x07500010 | topBit(round, 0x20), rd, 15, rm, rn))
}

// Sdiv emits SDIV Rd, Rn, Rm.
func Sdiv(a @asm.Assembler, cond int, rd int, rn int, rm int) {
	if !mul3Ok(a, cond, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x07100010, rd, 15, rm, rn))
}

// Udiv emits UDIV Rd, Rn, Rm.
func Udiv(a @asm.Assembler, cond int, rd int, rn int, rm int) {
	if !mul3Ok(a, cond, rd, rn, rm, 0) { return }
	emit32(a, mulWord(cond, 0x07300010, rd, 15, rm, rn))
}
