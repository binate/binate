		if readInst(a.Sections[0], 4 * i) != want[i] { return fail("a multiply encoded unlike clang") }
	}
	return ""
}

// The multiplies refuse what clang does -- PC where it rejects it (each instruction's every such
// place), a long multiply's RdLo and RdHi the same -- and what has no encoding: a register past
// R15 or below R0 (a four-register form's last one too), a condition past COND_AL; nothing is
// emitted.
func TestMulRejects() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mul(a, COND_AL, false, R0, R1, PC)
	if !a.HasError || a.Sections[0].Len != 0 { return fail("MUL Rm PC accepted") }
	var b @asm.Assembler = newAsm()
	Mla(b, COND_AL, false, R0, R1, R2, PC)
	if !b.HasError || b.Sections[0].Len != 0 { return fail("MLA Ra PC accepted") }
	var c @asm.Assembler = newAsm()
	SmlaXY(c, COND_AL, R0, PC, R2, R3, false, false)
	if !c.HasError || c.Sections[0].Len != 0 { return fail("SMLABB Rn PC accepted") }
	var d @asm.Assembler = newAsm()
	SmlaXY(d, COND_AL, R0, R1, R2, PC, false, false)
	if d.HasError || readInst(d.Sections[0], 0) != 0xE100F281 { return fail("SMLABB Ra PC refused") }
	var f @asm.Assembler = newAsm()
	Smuad(f, COND_AL, R0, R1, PC, false)
	if !f.HasError || f.Sections[0].Len != 0 { return fail("SMUAD Rm PC accepted") }
	var g @asm.Assembler = newAsm()
	SmlalXY(g, COND_AL, R0, R1, R2, PC, true, true)
	if !g.HasError || g.Sections[0].Len != 0 { return fail("SMLALTT Rm PC accepted") }
	var h @asm.Assembler = newAsm()
	Umull(h, COND_AL, false, R0, R0, R1, R2)
	if !h.HasError || h.Sections[0].Len != 0 { return fail("UMULL RdLo = RdHi accepted") }
	var k @asm.Assembler = newAsm()
	Smlald(k, COND_AL, R3, R3, R1, R2, false)
	if !k.HasError || k.Sections[0].Len != 0 { return fail("SMLALD RdLo = RdHi accepted") }
	var m @asm.Assembler = newAsm()
	Sdiv(m, COND_AL, 16, R1, R2)
	if !m.HasError || m.Sections[0].Len != 0 { return fail("SDIV R16 accepted") }
	var n @asm.Assembler = newAsm()
	Smmul(n, 15, R0, R1, R2, false)
	if !n.HasError || n.Sections[0].Len != 0 { return fail("SMMUL under condition 15 accepted") }
	var q @asm.Assembler = newAsm()
	Umull(q, COND_AL, false, R0, R1, R2, -1)
	if !q.HasError || q.Sections[0].Len != 0 { return fail("UMULL Rm -1 accepted") }
	var t @asm.Assembler = newAsm()
	Mls(t, COND_AL, R0, R1, R2, -1)
	if !t.HasError || t.Sections[0].Len != 0 { return fail("MLS Ra -1 accepted") }
	var u @asm.Assembler = newAsm()
	SmlaXY(u, COND_AL, R0, R1, R2, -1, false, false)
	if !u.HasError || u.Sections[0].Len != 0 { return fail("SMLABB Ra -1 accepted") }
	var w @asm.Assembler = newAsm()
	Smmla(w, COND_AL, R0, R1, R2, 16, false)
	if !w.HasError || w.Sections[0].Len != 0 { return fail("SMMLA Ra R16 accepted") }
	return ""
}
