package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

func TestMulReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MUL R0, R1, R2 (no S)
	// cond=1110 | 0000000 | S=0 | Rd=0000 | 0000 | Rm=0010
	//   | 1001 | Rn=0001
	// = 0xE0000291
	Mul(a, COND_AL, false, R0, R1, R2)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE0000291 {
		return fail("MUL R0, R1, R2 encoding wrong")
	}
	return ""
}

func TestMlaReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MLA R0, R1, R2, R3
	// cond=1110 | 0000001 | S=0 | Rd=0000 | Ra=0011 | Rm=0010
	//   | 1001 | Rn=0001
	// = 0xE0203291
	Mla(a, COND_AL, false, R0, R1, R2, R3)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE0203291 {
		return fail("MLA R0, R1, R2, R3 encoding wrong")
	}
	return ""
}

func TestMlsReg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// MLS R0, R1, R2, R3 (Rd = Ra - Rn*Rm)
	// cond=1110 | 0000011 | 0 | Rd=0000 | Ra=0011 | Rm=0010
	//   | 1001 | Rn=0001
	// = 0xE0603291
	Mls(a, COND_AL, R0, R1, R2, R3)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE0603291 {
		return fail("MLS R0, R1, R2, R3 encoding wrong")
	}
	return ""
}

// --- UMULL / SMULL ---

func TestUmull() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// UMULL R0, R1, R2, R3
	// cond=1110 | 0000100 | S=0 | RdHi=0001 | RdLo=0000
	//   | Rm=0011 | 1001 | Rn=0010
	// = 0xE0810392
	Umull(a, COND_AL, false, R0, R1, R2, R3)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE0810392 {
		return fail("UMULL encoding wrong")
	}
	return ""
}

func TestSmull() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SMULL R0, R1, R2, R3
	// cond=1110 | 0000110 | S=0 | RdHi=0001 | RdLo=0000
	//   | Rm=0011 | 1001 | Rn=0010
	// = 0xE0C10392
	Smull(a, COND_AL, false, R0, R1, R2, R3)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE0C10392 {
		return fail("SMULL encoding wrong")
	}
	return ""
}

// --- SDIV / UDIV ---

func TestSdiv() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SDIV R0, R1, R2
	// cond=1110 | 0111 0001 | Rd=0000 | 1111 | Rm=0010 | 0001 | Rn=0001
	// = 0xE710F211
	Sdiv(a, COND_AL, R0, R1, R2)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE710F211 {
		return fail("SDIV R0, R1, R2 encoding wrong")
	}
	return ""
}

func TestUdiv() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// UDIV R0, R1, R2
	// cond=1110 | 0111 0011 | Rd=0000 | 1111 | Rm=0010 | 0001 | Rn=0001
	// = 0xE730F211
	Udiv(a, COND_AL, R0, R1, R2)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE730F211 {
		return fail("UDIV R0, R1, R2 encoding wrong")
	}
	return ""
}

// Every multiply and divide against clang's words (Apple clang 21, armv7ve): each form, SP as its
// last register, PC as its first where clang takes it there, the S and condition forms.
func TestMulGoldens() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mul(a, COND_AL, false, R0, R1, R2) // mul r0, r1, r2
	Mul(a, COND_AL, false, R0, R1, SP) // mul r0, r1, sp
	Mul(a, COND_AL, true, R0, R1, R2) // muls r0, r1, r2
	SmulXY(a, COND_AL, R0, R1, R2, false, false) // smulbb r0, r1, r2
	SmulXY(a, COND_AL, R0, R1, SP, false, false) // smulbb r0, r1, sp
	SmulXY(a, COND_AL, PC, R1, R2, false, false) // smulbb pc, r1, r2
	SmulXY(a, COND_AL, R0, R1, R2, false, true) // smulbt r0, r1, r2
	SmulXY(a, COND_AL, R0, R1, SP, false, true) // smulbt r0, r1, sp
	SmulXY(a, COND_AL, PC, R1, R2, false, true) // smulbt pc, r1, r2
	SmulXY(a, COND_AL, R0, R1, R2, true, false) // smultb r0, r1, r2
	SmulXY(a, COND_AL, R0, R1, SP, true, false) // smultb r0, r1, sp
	SmulXY(a, COND_AL, PC, R1, R2, true, false) // smultb pc, r1, r2
	SmulXY(a, COND_AL, R0, R1, R2, true, true) // smultt r0, r1, r2
	SmulXY(a, COND_AL, R0, R1, SP, true, true) // smultt r0, r1, sp
	SmulXY(a, COND_AL, PC, R1, R2, true, true) // smultt pc, r1, r2
	SmulwY(a, COND_AL, R0, R1, R2, false) // smulwb r0, r1, r2
	SmulwY(a, COND_AL, R0, R1, SP, false) // smulwb r0, r1, sp
	SmulwY(a, COND_AL, PC, R1, R2, false) // smulwb pc, r1, r2
	SmulwY(a, COND_AL, R0, R1, R2, true) // smulwt r0, r1, r2
	SmulwY(a, COND_AL, R0, R1, SP, true) // smulwt r0, r1, sp
	SmulwY(a, COND_AL, PC, R1, R2, true) // smulwt pc, r1, r2
	Smuad(a, COND_AL, R0, R1, R2, false) // smuad r0, r1, r2
	Smuad(a, COND_AL, R0, R1, SP, false) // smuad r0, r1, sp
	Smuad(a, COND_AL, R0, R1, R2, true) // smuadx r0, r1, r2
	Smuad(a, COND_AL, R0, R1, SP, true) // smuadx r0, r1, sp
	Smusd(a, COND_AL, R0, R1, R2, false) // smusd r0, r1, r2
	Smusd(a, COND_AL, R0, R1, SP, false) // smusd r0, r1, sp
	Smusd(a, COND_AL, R0, R1, R2, true) // smusdx r0, r1, r2
	Smusd(a, COND_AL, R0, R1, SP, true) // smusdx r0, r1, sp
	Smmul(a, COND_AL, R0, R1, R2, false) // smmul r0, r1, r2
	Smmul(a, COND_AL, R0, R1, SP, false) // smmul r0, r1, sp
	Smmul(a, COND_AL, PC, R1, R2, false) // smmul pc, r1, r2
	Smmul(a, COND_AL, R0, R1, R2, true) // smmulr r0, r1, r2
	Smmul(a, COND_AL, R0, R1, SP, true) // smmulr r0, r1, sp
	Smmul(a, COND_AL, PC, R1, R2, true) // smmulr pc, r1, r2
	Sdiv(a, COND_AL, R0, R1, R2) // sdiv r0, r1, r2
	Sdiv(a, COND_AL, R0, R1, SP) // sdiv r0, r1, sp
	Sdiv(a, COND_AL, PC, R1, R2) // sdiv pc, r1, r2
	Udiv(a, COND_AL, R0, R1, R2) // udiv r0, r1, r2
	Udiv(a, COND_AL, R0, R1, SP) // udiv r0, r1, sp
	Udiv(a, COND_AL, PC, R1, R2) // udiv pc, r1, r2
	Mla(a, COND_AL, false, R0, R1, R2, R3) // mla r0, r1, r2, r3
	Mla(a, COND_AL, false, R0, R1, R2, SP) // mla r0, r1, r2, sp
	Mla(a, COND_AL, true, R0, R1, R2, R3) // mlas r0, r1, r2, r3
	Mls(a, COND_AL, R0, R1, R2, R3) // mls r0, r1, r2, r3
	Mls(a, COND_AL, R0, R1, R2, SP) // mls r0, r1, r2, sp
	Mls(a, COND_AL, PC, R1, R2, R3) // mls pc, r1, r2, r3
	SmlaXY(a, COND_AL, R0, R1, R2, R3, false, false) // smlabb r0, r1, r2, r3
	SmlaXY(a, COND_AL, R0, R1, R2, SP, false, false) // smlabb r0, r1, r2, sp
	SmlaXY(a, COND_AL, R0, R1, R2, R3, false, true) // smlabt r0, r1, r2, r3
	SmlaXY(a, COND_AL, R0, R1, R2, SP, false, true) // smlabt r0, r1, r2, sp
	SmlaXY(a, COND_AL, R0, R1, R2, R3, true, false) // smlatb r0, r1, r2, r3
	SmlaXY(a, COND_AL, R0, R1, R2, SP, true, false) // smlatb r0, r1, r2, sp
	SmlaXY(a, COND_AL, R0, R1, R2, R3, true, true) // smlatt r0, r1, r2, r3
	SmlaXY(a, COND_AL, R0, R1, R2, SP, true, true) // smlatt r0, r1, r2, sp
	SmlawY(a, COND_AL, R0, R1, R2, R3, false) // smlawb r0, r1, r2, r3
	SmlawY(a, COND_AL, R0, R1, R2, SP, false) // smlawb r0, r1, r2, sp
	SmlawY(a, COND_AL, R0, R1, R2, R3, true) // smlawt r0, r1, r2, r3
	SmlawY(a, COND_AL, R0, R1, R2, SP, true) // smlawt r0, r1, r2, sp
	Smlad(a, COND_AL, R0, R1, R2, R3, false) // smlad r0, r1, r2, r3
	Smlad(a, COND_AL, R0, R1, R2, SP, false) // smlad r0, r1, r2, sp
	Smlad(a, COND_AL, R0, R1, R2, R3, true) // smladx r0, r1, r2, r3
	Smlad(a, COND_AL, R0, R1, R2, SP, true) // smladx r0, r1, r2, sp
	Smlsd(a, COND_AL, R0, R1, R2, R3, false) // smlsd r0, r1, r2, r3
	Smlsd(a, COND_AL, R0, R1, R2, SP, false) // smlsd r0, r1, r2, sp
	Smlsd(a, COND_AL, R0, R1, R2, R3, true) // smlsdx r0, r1, r2, r3
	Smlsd(a, COND_AL, R0, R1, R2, SP, true) // smlsdx r0, r1, r2, sp
	Smmla(a, COND_AL, R0, R1, R2, R3, false) // smmla r0, r1, r2, r3
	Smmla(a, COND_AL, R0, R1, R2, SP, false) // smmla r0, r1, r2, sp
	Smmla(a, COND_AL, PC, R1, R2, R3, false) // smmla pc, r1, r2, r3
	Smmla(a, COND_AL, R0, R1, R2, R3, true) // smmlar r0, r1, r2, r3
	Smmla(a, COND_AL, R0, R1, R2, SP, true) // smmlar r0, r1, r2, sp
	Smmla(a, COND_AL, PC, R1, R2, R3, true) // smmlar pc, r1, r2, r3
	Smmls(a, COND_AL, R0, R1, R2, R3, false) // smmls r0, r1, r2, r3
	Smmls(a, COND_AL, R0, R1, R2, SP, false) // smmls r0, r1, r2, sp
	Smmls(a, COND_AL, PC, R1, R2, R3, false) // smmls pc, r1, r2, r3
	Smmls(a, COND_AL, R0, R1, R2, R3, true) // smmlsr r0, r1, r2, r3
	Smmls(a, COND_AL, R0, R1, R2, SP, true) // smmlsr r0, r1, r2, sp
	Smmls(a, COND_AL, PC, R1, R2, R3, true) // smmlsr pc, r1, r2, r3
	Umull(a, COND_AL, false, R0, R1, R2, R3) // umull r0, r1, r2, r3
	Umull(a, COND_AL, false, R0, R1, R2, SP) // umull r0, r1, r2, sp
	Umull(a, COND_AL, false, PC, R1, R2, R3) // umull pc, r1, r2, r3
	Umull(a, COND_AL, true, R0, R1, R2, R3) // umulls r0, r1, r2, r3
	Smull(a, COND_AL, false, R0, R1, R2, R3) // smull r0, r1, r2, r3
	Smull(a, COND_AL, false, R0, R1, R2, SP) // smull r0, r1, r2, sp
	Smull(a, COND_AL, false, PC, R1, R2, R3) // smull pc, r1, r2, r3
	Smull(a, COND_AL, true, R0, R1, R2, R3) // smulls r0, r1, r2, r3
	Umlal(a, COND_AL, false, R0, R1, R2, R3) // umlal r0, r1, r2, r3
	Umlal(a, COND_AL, false, R0, R1, R2, SP) // umlal r0, r1, r2, sp
	Umlal(a, COND_AL, false, PC, R1, R2, R3) // umlal pc, r1, r2, r3
	Umlal(a, COND_AL, true, R0, R1, R2, R3) // umlals r0, r1, r2, r3
	Smlal(a, COND_AL, false, R0, R1, R2, R3) // smlal r0, r1, r2, r3
	Smlal(a, COND_AL, false, R0, R1, R2, SP) // smlal r0, r1, r2, sp
	Smlal(a, COND_AL, false, PC, R1, R2, R3) // smlal pc, r1, r2, r3
	Smlal(a, COND_AL, true, R0, R1, R2, R3) // smlals r0, r1, r2, r3
	Umaal(a, COND_AL, R0, R1, R2, R3) // umaal r0, r1, r2, r3
	Umaal(a, COND_AL, R0, R1, R2, SP) // umaal r0, r1, r2, sp
	Umaal(a, COND_AL, PC, R1, R2, R3) // umaal pc, r1, r2, r3
	SmlalXY(a, COND_AL, R0, R1, R2, R3, false, false) // smlalbb r0, r1, r2, r3
	SmlalXY(a, COND_AL, R0, R1, R2, SP, false, false) // smlalbb r0, r1, r2, sp
	SmlalXY(a, COND_AL, R0, R1, R2, R3, false, true) // smlalbt r0, r1, r2, r3
	SmlalXY(a, COND_AL, R0, R1, R2, SP, false, true) // smlalbt r0, r1, r2, sp
	SmlalXY(a, COND_AL, R0, R1, R2, R3, true, false) // smlaltb r0, r1, r2, r3
	SmlalXY(a, COND_AL, R0, R1, R2, SP, true, false) // smlaltb r0, r1, r2, sp
	SmlalXY(a, COND_AL, R0, R1, R2, R3, true, true) // smlaltt r0, r1, r2, r3
	SmlalXY(a, COND_AL, R0, R1, R2, SP, true, true) // smlaltt r0, r1, r2, sp
	Smlald(a, COND_AL, R0, R1, R2, R3, false) // smlald r0, r1, r2, r3
	Smlald(a, COND_AL, R0, R1, R2, SP, false) // smlald r0, r1, r2, sp
	Smlald(a, COND_AL, R0, R1, R2, R3, true) // smlaldx r0, r1, r2, r3
	Smlald(a, COND_AL, R0, R1, R2, SP, true) // smlaldx r0, r1, r2, sp
	Smlsld(a, COND_AL, R0, R1, R2, R3, false) // smlsld r0, r1, r2, r3
	Smlsld(a, COND_AL, R0, R1, R2, SP, false) // smlsld r0, r1, r2, sp
	Smlsld(a, COND_AL, R0, R1, R2, R3, true) // smlsldx r0, r1, r2, r3
	Smlsld(a, COND_AL, R0, R1, R2, SP, true) // smlsldx r0, r1, r2, sp
	Mul(a, COND_EQ, true, R0, R1, R2) // mulseq r0, r1, r2
	SmlaXY(a, COND_EQ, R0, R1, R2, R3, false, false) // smlabbeq r0, r1, r2, r3
	Smmul(a, COND_EQ, R0, R1, R2, true) // smmulreq r0, r1, r2
	if a.HasError { return fail(a.ErrorMsg) }
	var want @[]uint32 = make_slice(uint32, 117)
	want[0] = 0xE0000291
	want[1] = 0xE0000D91
