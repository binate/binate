package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// checkDPRegsReject emits one data-processing instruction with destination
// `rd`, first operand `rn` and second operand `op` into a fresh assembler,
// and returns "" if the encoder set an error and emitted no bytes, or a
// failure message naming the mnemonic and `what` (the operands' description).
func checkDPRegsReject(opcode int, rd int, rn int, op Operand, what *[]readonly char) @[]char {
	var a @asm.Assembler = newAsm()
	emitDPByOpcode(a, opcode, false, rd, rn, op)
	var name @[]char = buf.Concat(dpMnemonic(opcode), what)
	if !a.HasError {
		return buf.Concat(name, ": should set an assembler error")
	}
	if a.Sections[0].Len != 0 {
		return buf.Concat(name, ": should emit no bytes")
	}
	return ""
}

// checkErrorPrefix returns "" if the assembler's error message starts with
// `want`, or a failure message naming `want`.
func checkErrorPrefix(a @asm.Assembler, want *[]readonly char) @[]char {
	if len(a.ErrorMsg) < len(want) || !charsSame(a.ErrorMsg[0:len(want)], want) {
		return buf.Concat("error message should start with '", buf.Concat(want, "'"))
	}
	return ""
}

// --- Valid shifted-register operands: golden words from clang -target armv7a-none-eabi ---

// Each immediate shift mode at both ends of its range and at 1 (the smallest
// amount that is not the plain register), and RRX. An amount of 0 in LSL,
// LSR, ASR or ROR is the plain register, and LSR/ASR #32 is encoded with an
// amount field of 0.
func TestDPImmShiftGoldenRangeEdges() testing.TestResult {
	var m @[]char = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSL, 0), 0xE0810002,
			"add r0, r1, r2, lsl #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSL, 1), 0xE0810082, "add r0, r1, r2, lsl #1")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSL, 31), 0xE0810F82,
			"add r0, r1, r2, lsl #31")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSR, 0), 0xE0810002, "add r0, r1, r2, lsr #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSR, 1), 0xE08100A2, "add r0, r1, r2, lsr #1")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSR, 32), 0xE0810022,
			"add r0, r1, r2, lsr #32")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ASR, 0), 0xE0810002, "add r0, r1, r2, asr #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ASR, 1), 0xE08100C2, "add r0, r1, r2, asr #1")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ASR, 32), 0xE0810042,
			"add r0, r1, r2, asr #32")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ROR, 0), 0xE0810002, "add r0, r1, r2, ror #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ROR, 1), 0xE08100E2, "add r0, r1, r2, ror #1")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ROR, 31), 0xE0810FE2,
			"add r0, r1, r2, ror #31")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, RRX, 0), 0xE0810062, "add r0, r1, r2, rrx")
	if len(m) != 0 { return m }
	return ""
}

// ROR with amount 0 is the plain register, not RRX: clang encodes
// "add r0, r1, r2, ror #0" as 0xE0810002 (the same word as "add r0, r1, r2")
// and "add r0, r1, r2, rrx" as 0xE0810062.
func TestDPRorZeroIsNotRrx() testing.TestResult {
	var m @[]char = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ROR, 0), 0xE0810002,
			"add r0, r1, r2, ror #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, Reg(R2), 0xE0810002, "add r0, r1, r2")
	if len(m) != 0 { return m }
	return checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, RRX, 0), 0xE0810062, "add r0, r1, r2, rrx")
}

// A shift by 0 is the plain register on the other encoders too, with the S
// bit and in the compare form.
func TestDPShiftZeroIsPlainRegOtherEncoders() testing.TestResult {
	var m @[]char = checkDPWord(DP_MOV, false, R0, 0, RegShift(R1, ROR, 0), 0xE1A00001,
			"mov r0, r1, ror #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_MOV, false, R3, 0, RegShift(R4, LSR, 0), 0xE1A03004, "mov r3, r4, lsr #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_MVN, true, R9, 0, RegShift(R10, ASR, 0), 0xE1F0900A, "mvns r9, r10, asr #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_CMP, true, 0, R7, RegShift(R8, LSR, 0), 0xE1570008, "cmp r7, r8, lsr #0")
	if len(m) != 0 { return m }
	return ""
}

// Shifted and plain register operands on other encoders, with the S bit and
// registers up to R15.
func TestDPShiftGoldenOtherEncoders() testing.TestResult {
	var m @[]char = checkDPWord(DP_MOV, false, R3, 0, RegShift(R4, LSR, 32), 0xE1A03024,
			"mov r3, r4, lsr #32")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_SUB, false, R4, R5, RegShift(R6, ASR, 32), 0xE0454046,
			"sub r4, r5, r6, asr #32")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_CMP, true, 0, R7, RegShift(R8, LSL, 31), 0xE1570F88, "cmp r7, r8, lsl #31")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_MVN, true, R9, 0, RegShift(R10, RRX, 0), 0xE1F0906A, "mvns r9, r10, rrx")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_TEQ, true, 0, R11, RegShift(R12, ROR, 16), 0xE13B086C, "teq r11, r12, ror #16")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_MOV, false, R0, 0, Reg(R1), 0xE1A00001, "mov r0, r1")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_EOR, false, PC, LR, Reg(SP), 0xE02EF00D, "eor pc, lr, sp")
	if len(m) != 0 { return m }
	return ""
}

// Register-shifted register with each shift mode.
func TestDPRegShiftRegGoldenEveryMode() testing.TestResult {
	var m @[]char = checkDPWord(DP_ORR, false, R12, LR, RegSReg(R11, LSL, R10), 0xE18ECA1B,
			"orr r12, lr, r11, lsl r10")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ORR, false, R12, LR, RegSReg(R11, LSR, R10), 0xE18ECA3B,
			"orr r12, lr, r11, lsr r10")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ORR, false, R12, LR, RegSReg(R11, ASR, R10), 0xE18ECA5B,
			"orr r12, lr, r11, asr r10")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ORR, false, R12, LR, RegSReg(R11, ROR, R10), 0xE18ECA7B,
			"orr r12, lr, r11, ror r10")
	if len(m) != 0 { return m }
	return ""
}

// --- Out-of-range shifts and registers fail loud ---

// Every immediate shift amount just outside its mode's range at each end, an
// amount on RRX, and shift modes outside the defined set. clang rejects each
// out-of-range LSL, LSR, ASR and ROR amount (lsl #32, lsl #-1, lsr #33,
// lsr #-1, asr #33, asr #-1, ror #32, ror #-1) with "immediate shift value out
// of range", and rejects "rrx #1" with "unexpected token in argument list"
// because its RRX syntax takes no amount; a shift mode outside the defined
// set has no assembly spelling at all.
func TestDPImmShiftOutOfRange() testing.TestResult {
	var m @[]char = checkDPRejects(DP_ADD, RegShift(R2, LSL, 32), " r2, lsl #32")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, LSL, -1), " r2, lsl #-1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, LSR, 33), " r2, lsr #33")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, LSR, -1), " r2, lsr #-1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, ASR, 33), " r2, asr #33")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, ASR, -1), " r2, asr #-1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, ROR, 32), " r2, ror #32")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, ROR, -1), " r2, ror #-1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, RRX, 1), " r2, rrx #1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, RRX + 1, 1), " r2, <shift 5> #1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(R2, -1, 1), " r2, <shift -1> #1")
	if len(m) != 0 { return m }
	return ""
}

// An out-of-range shift is rejected by every encoder.
func TestDPImmShiftOutOfRangeAllEncoders() testing.TestResult {
	for opcode := 0; opcode < 16; opcode++ {
		var m @[]char = checkDPRejects(opcode, RegShift(R2, LSL, 32), " r2, lsl #32")
		if len(m) != 0 { return m }
	}
	return ""
}

// A register-shifted register takes only LSL, LSR, ASR or ROR.
func TestDPRegShiftRegBadMode() testing.TestResult {
	var m @[]char = checkDPRejects(DP_ORR, RegSReg(R2, RRX, R3), " r2, rrx r3")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ORR, RegSReg(R2, RRX + 1, R3), " r2, <shift 5> r3")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ORR, RegSReg(R2, -1, R3), " r2, <shift -1> r3")
	if len(m) != 0 { return m }
	return ""
}

// A register number outside R0..R15 in any register field of the operand (a
// plain register, the shifted register, or the shift register) is rejected,
// including a VFP register constant.
func TestDPOperandRegOutOfRange() testing.TestResult {
	var m @[]char = checkDPRejects(DP_ADD, Reg(16), " r16")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, Reg(-1), " r-1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_MOV, Reg(S1), " s1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_CMP, Reg(D0), " d0")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(16, LSL, 1), " r16, lsl #1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, RegShift(-1, LSR, 1), " r-1, lsr #1")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ORR, RegSReg(16, LSL, R3), " r16, lsl r3")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ORR, RegSReg(R2, LSL, 16), " r2, lsl r16")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ORR, RegSReg(R2, LSL, -1), " r2, lsl r-1")
	if len(m) != 0 { return m }
	return ""
}

// An Rd or Rn outside R0..R15 is rejected.
func TestDPRdRnOutOfRange() testing.TestResult {
	var m @[]char = checkDPRegsReject(DP_ADD, 16, R1, Reg(R2), " r16, r1, r2")
	if len(m) != 0 { return m }
	m = checkDPRegsReject(DP_ADD, -1, R1, Reg(R2), " r-1, r1, r2")
	if len(m) != 0 { return m }
	m = checkDPRegsReject(DP_ADD, R0, 16, Reg(R2), " r0, r16, r2")
	if len(m) != 0 { return m }
	m = checkDPRegsReject(DP_SUB, R0, S1, Imm(1), " r0, s1, #1")
	if len(m) != 0 { return m }
	m = checkDPRegsReject(DP_MOV, D0, 0, Imm(1), " d0, #1")
	if len(m) != 0 { return m }
	m = checkDPRegsReject(DP_CMP, 0, 16, Imm(1), " r16, #1")
	if len(m) != 0 { return m }
	return ""
}

// The errors name the architecture and the field at fault.
func TestDPShiftAndRegErrorMessages() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, COND_AL, false, R0, R1, RegShift(R2, LSL, 32))
	var m @[]char = checkErrorPrefix(a, "arm32: LSL shift amount out of range")
	if len(m) != 0 { return m }
	a = newAsm()
	Add(a, COND_AL, false, R0, R1, RegShift(R2, ASR, 33))
	m = checkErrorPrefix(a, "arm32: LSR/ASR shift amount out of range")
	if len(m) != 0 { return m }
	a = newAsm()
	Add(a, COND_AL, false, R0, R1, RegShift(R2, ROR, 32))
	m = checkErrorPrefix(a, "arm32: ROR shift amount out of range")
	if len(m) != 0 { return m }
	a = newAsm()
	Add(a, COND_AL, false, R0, R1, RegShift(R2, RRX, 1))
	m = checkErrorPrefix(a, "arm32: RRX takes no shift amount")
	if len(m) != 0 { return m }
	a = newAsm()
	Add(a, COND_AL, false, R0, R1, RegShift(R2, RRX + 1, 1))
	m = checkErrorPrefix(a, "arm32: unknown shift mode")
	if len(m) != 0 { return m }
	a = newAsm()
	Orr(a, COND_AL, false, R0, R1, RegSReg(R2, RRX, R3))
	m = checkErrorPrefix(a, "arm32: register-shifted register needs")
	if len(m) != 0 { return m }
	a = newAsm()
	Add(a, COND_AL, false, 16, R1, Reg(R2))
	m = checkErrorPrefix(a, "arm32: data-processing register out of range")
	if len(m) != 0 { return m }
	a = newAsm()
	Add(a, COND_AL, false, R0, R1, Reg(16))
	m = checkErrorPrefix(a, "arm32: data-processing register out of range")
	if len(m) != 0 { return m }
	return ""
}

// A rejected shift or register leaves no gap: the instructions around it are
// contiguous.
func TestDPRejectedShiftEmitsNothingMidStream() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, COND_AL, false, R0, Imm(1))
	Add(a, COND_AL, false, R0, R1, RegShift(R2, LSR, 33))
	Add(a, COND_AL, false, 16, R1, Reg(R2))
	Mov(a, COND_AL, false, R0, Imm(2))
	if !a.HasError { return fail("out-of-range shift should set an assembler error") }
	if a.Sections[0].Len != 8 { return fail("only the two valid MOVs should be emitted") }
	if readInst(a.Sections[0], 0) != 0xE3A00001 { return fail("mov r0, #1 encoding wrong") }
	if readInst(a.Sections[0], 4) != 0xE3A00002 { return fail("mov r0, #2 encoding wrong") }
	return ""
}
