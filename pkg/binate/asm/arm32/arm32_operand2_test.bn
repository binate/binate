package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// dpMnemonic returns the lowercase mnemonic of data-processing opcode
// `opcode` (a DP_* value), for failure messages.
func dpMnemonic(opcode int) *[]readonly char {
	switch opcode {
	case DP_AND:
		return "and"
	case DP_EOR:
		return "eor"
	case DP_SUB:
		return "sub"
	case DP_RSB:
		return "rsb"
	case DP_ADD:
		return "add"
	case DP_ADC:
		return "adc"
	case DP_SBC:
		return "sbc"
	case DP_RSC:
		return "rsc"
	case DP_TST:
		return "tst"
	case DP_TEQ:
		return "teq"
	case DP_CMP:
		return "cmp"
	case DP_CMN:
		return "cmn"
	case DP_ORR:
		return "orr"
	case DP_MOV:
		return "mov"
	case DP_BIC:
		return "bic"
	case DP_MVN:
		return "mvn"
	}
	return "?"
}

// emitDPByOpcode calls the public encoder for data-processing opcode `opcode`
// (a DP_* value) with condition AL. MOV/MVN ignore `rn`; the compare/test
// encoders ignore `s` and `rd` (they always set flags and write no register).
func emitDPByOpcode(a @asm.Assembler, opcode int, s bool, rd int, rn int, op Operand) {
	switch opcode {
	case DP_AND:
		And(a, COND_AL, s, rd, rn, op)
	case DP_EOR:
		Eor(a, COND_AL, s, rd, rn, op)
	case DP_SUB:
		Sub(a, COND_AL, s, rd, rn, op)
	case DP_RSB:
		Rsb(a, COND_AL, s, rd, rn, op)
	case DP_ADD:
		Add(a, COND_AL, s, rd, rn, op)
	case DP_ADC:
		Adc(a, COND_AL, s, rd, rn, op)
	case DP_SBC:
		Sbc(a, COND_AL, s, rd, rn, op)
	case DP_RSC:
		Rsc(a, COND_AL, s, rd, rn, op)
	case DP_TST:
		Tst(a, COND_AL, rn, op)
	case DP_TEQ:
		Teq(a, COND_AL, rn, op)
	case DP_CMP:
		Cmp(a, COND_AL, rn, op)
	case DP_CMN:
		Cmn(a, COND_AL, rn, op)
	case DP_ORR:
		Orr(a, COND_AL, s, rd, rn, op)
	case DP_MOV:
		Mov(a, COND_AL, s, rd, op)
	case DP_BIC:
		Bic(a, COND_AL, s, rd, rn, op)
	case DP_MVN:
		Mvn(a, COND_AL, s, rd, op)
	}
}

// imm32 returns an immediate Operand for the 32-bit pattern `v`. A constant
// with bit 31 set, such as Imm(0xff000000), does not fit a 32-bit int; taking
// the pattern as a non-constant uint32 lets the cast wrap to the negative int
// with the same bits there, so these tests also build where int is 32 bits.
func imm32(v uint32) Operand {
	return Imm(cast(int, v))
}

// checkDPWord emits one data-processing instruction into a fresh assembler
// and returns "" if it encoded to exactly `want` with no error, or a failure
// message naming `asmText` (the clang-assembled source line `want` came from).
func checkDPWord(opcode int, s bool, rd int, rn int, op Operand, want uint32,
		asmText *[]readonly char) @[]char {
	var a @asm.Assembler = newAsm()
	emitDPByOpcode(a, opcode, s, rd, rn, op)
	if a.HasError {
		return buf.Concat(asmText, ": unexpected assembler error")
	}
	if a.Sections[0].Len != 4 {
		return buf.Concat(asmText, ": should emit exactly one word")
	}
	if readInst(a.Sections[0], 0) != want {
		return buf.Concat(asmText, ": encoding differs from clang")
	}
	return ""
}

// checkDPRejects emits one data-processing instruction whose second operand
// has no Operand2 encoding into a fresh assembler, and returns "" if the
// encoder set an error and emitted no bytes and recorded no fixup, or a
// failure message naming the mnemonic and `what` (the operand's description).
func checkDPRejects(opcode int, op Operand, what *[]readonly char) @[]char {
	var a @asm.Assembler = newAsm()
	emitDPByOpcode(a, opcode, false, R0, R1, op)
	var name @[]char = buf.Concat(dpMnemonic(opcode), what)
	if !a.HasError {
		return buf.Concat(name, ": should set an assembler error")
	}
	if a.Sections[0].Len != 0 {
		return buf.Concat(name, ": should emit no bytes")
	}
	if a.Sections[0].NumFixups != 0 {
		return buf.Concat(name, ": should record no fixup")
	}
	return ""
}

// --- Valid immediates: golden words from clang -target armv7a-none-eabi ---

// The representative set: 8-bit, top-byte, wrapped-around (bits at both
// ends), a single high bit, a rotation that splits a byte, and zero.
func TestDPImmGoldenRepresentative() testing.TestResult {
	var m @[]char = checkDPWord(DP_AND, false, R0, R1, Imm(0xff), 0xE20100FF, "and r0, r1, #0xff")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ORR, false, R2, R3, imm32(0xff000000), 0xE38324FF, "orr r2, r3, #0xff000000")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_BIC, false, R0, R1, imm32(0xf000000f), 0xE3C102FF, "bic r0, r1, #0xf000000f")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_TST, true, 0, R0, Imm(0x100), 0xE3100C01, "tst r0, #0x100")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, Imm(0x3fc), 0xE2810FFF, "add r0, r1, #0x3fc")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_CMP, true, 0, R1, Imm(0), 0xE3510000, "cmp r1, #0")
	if len(m) != 0 { return m }
	return ""
}

// One valid immediate per remaining encoder, so all 16 are pinned to clang.
func TestDPImmGoldenEveryEncoder() testing.TestResult {
	var m @[]char = checkDPWord(DP_SUB, false, R4, R5, Imm(0x10000), 0xE2454801,
			"sub r4, r5, #0x10000")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_RSB, false, R6, R7, imm32(0xc0000003), 0xE267610F, "rsb r6, r7, #0xc0000003")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADC, false, R8, R9, Imm(1), 0xE2A98001, "adc r8, r9, #1")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_SBC, false, R10, R11, Imm(0x3f0), 0xE2CBAE3F, "sbc r10, r11, #0x3f0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_RSC, false, R12, LR, imm32(0x80000000), 0xE2EEC102, "rsc r12, lr, #0x80000000")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_EOR, false, R0, R2, Imm(0xab00), 0xE2220CAB, "eor r0, r2, #0xab00")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_MOV, false, R3, 0, Imm(0xff00), 0xE3A03CFF, "mov r3, #0xff00")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_MVN, false, R4, 0, Imm(0x3fc00), 0xE3E04BFF, "mvn r4, #0x3fc00")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_CMN, true, 0, R5, imm32(0xfc000003), 0xE37503FF, "cmn r5, #0xfc000003")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_TEQ, true, 0, R6, Imm(0x1000), 0xE3360A01, "teq r6, #0x1000")
	if len(m) != 0 { return m }
	return ""
}

// A negative immediate is its 32-bit two's-complement pattern: -16777216 is
// 0xff000000, which clang encodes identically to the unsigned spelling.
func TestDPImmGoldenNegativeSpelling() testing.TestResult {
	return checkDPWord(DP_ORR, false, R2, R3, Imm(-16777216), 0xE38324FF, "orr r2, r3, #-16777216")
}

// The S bit and a non-AL condition combine with an immediate operand as clang
// encodes them.
func TestDPImmGoldenFlagsAndCond() testing.TestResult {
	var m @[]char = checkDPWord(DP_ADD, true, R0, R1, Imm(0x3fc), 0xE2910FFF, "adds r0, r1, #0x3fc")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_SUB, true, R2, R3, Imm(4), 0xE2532004, "subs r2, r3, #4")
	if len(m) != 0 { return m }
	var a @asm.Assembler = newAsm()
	Mov(a, COND_NE, false, R1, Imm(0x2a))
	Eor(a, COND_EQ, true, R1, R2, Imm(0x7f0))
	if a.HasError { return fail("movne/eorseq: unexpected assembler error") }
	if readInst(a.Sections[0], 0) != 0x13A0102A {
		return fail("movne r1, #0x2a: encoding differs from clang")
	}
	if readInst(a.Sections[0], 4) != 0x02321E7F {
		return fail("eorseq r1, r2, #0x7f0: encoding differs from clang")
	}
	return ""
}

// Register-form Operand2 kinds are unaffected by the immediate checks.
func TestDPRegFormsGolden() testing.TestResult {
	var m @[]char = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ROR, 7), 0xE08103E2,
			"add r0, r1, r2, ror #7")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, LSR, 32), 0xE0810022,
			"add r0, r1, r2, lsr #32")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, ROR, 0), 0xE0810002, "add r0, r1, r2, ror #0")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ADD, false, R0, R1, RegShift(R2, RRX, 0), 0xE0810062, "add r0, r1, r2, rrx")
	if len(m) != 0 { return m }
	m = checkDPWord(DP_ORR, false, R0, R1, RegSReg(R2, LSL, R3), 0xE1810312, "orr r0, r1, r2, lsl r3")
	if len(m) != 0 { return m }
	return ""
}

// Every 8-bit value at every even rotation is accepted and decodes back to
// the value it was built from.
func TestDPImmRoundTripAllRotations() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var n int = 0
	for rot := 0; rot < 16; rot++ {
		for imm8 := 0; imm8 < 256; imm8++ {
			var v uint32 = ror32(cast(uint32, imm8), rot * 2)
			Orr(a, COND_AL, false, R0, R1, Imm(cast(int, v)))
			if a.HasError { return fail("encodable immediate rejected") }
			var inst uint32 = readInst(a.Sections[0], n * 4)
			var gotRot int = cast(int, (inst >> 8) & 0xf)
			var gotImm8 uint32 = inst & 0xff
			if ror32(gotImm8, gotRot * 2) != v {
				return fail("encoded immediate does not decode to the input value")
			}
			if (inst & 0xFFFFF000) != 0xE3810000 {
				return fail("immediate ORR fixed fields wrong")
			}
			n = n + 1
		}
	}
	if a.Sections[0].Len != n * 4 { return fail("round trip should emit one word each") }
	return ""
}

// --- Unencodable immediates and non-Operand2 operands fail loud ---

// 0x102 (bits 1 and 8) spans 8 bits but not at an even rotation, so no
// encoder may accept it.
func TestDPUnencodableImmAllEncoders() testing.TestResult {
	for opcode := 0; opcode < 16; opcode++ {
		var m @[]char = checkDPRejects(opcode, Imm(0x102), " #0x102")
		if len(m) != 0 { return m }
	}
	return ""
}

// More immediates with no rotated-8-bit encoding: 9 significant bits (0x101),
// a byte shifted by an odd amount (0x1fe), 0xff at bits 18..25 plus bit 0
// (0x3fc0001, whose set bits span 15 positions even counting the wrap from
// bit 31 to bit 0, more than an 8-bit window covers), and -1 (0xffffffff).
func TestDPUnencodableImmValues() testing.TestResult {
	var m @[]char = checkDPRejects(DP_ADD, Imm(0x101), " #0x101")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, Imm(0x1fe), " #0x1fe")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_MOV, Imm(0x3fc0001), " #0x3fc0001")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_CMP, Imm(-1), " #-1")
	if len(m) != 0 { return m }
	return ""
}

// The error names the architecture and says the immediate is not an 8-bit
// value rotated right by an even amount; it does not print the value.
func TestDPUnencodableImmMessage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Add(a, COND_AL, false, R0, R1, Imm(0x102))
	return checkErrorPrefix(a,
			"arm32: data-processing immediate is not an 8-bit value rotated right by an even amount")
}

// --- Immediates outside the 32-bit range fail loud ---

// twoTo32 returns 2^32 where int is 64 bits. Where int is 32 bits the shift
// count equals the width, so the result is 0; no int lies outside the 32-bit
// range there, and the tests that use it have nothing to check.
func twoTo32() int {
	var one int = 1
	return one << 32
}

// The ends of the 32-bit range that have a rotated-8-bit form are accepted:
// -2^31 is the pattern 0x80000000, encoded as clang encodes both spellings.
// (The top of the range, 2^32-1, is the pattern 0xffffffff, which has none.)
func TestDPImmGolden32BitRangeEdge() testing.TestResult {
	var m @[]char = checkDPWord(DP_ADD, false, R0, R1, Imm(-2147483648), 0xE2810102,
			"add r0, r1, #-2147483648")
	if len(m) != 0 { return m }
	return checkDPWord(DP_ORR, false, R0, R1, imm32(0x80000000), 0xE3810102, "orr r0, r1, #0x80000000")
}

// An immediate outside -2^31..2^32-1 is rejected even when its low 32 bits
// would encode. clang truncates such a value to its low 32 bits
// (#0x100000000 assembles as #0 and #0x1000000ff as #0xff); this encoder
// rejects it instead. The two values below -2^31 have the encodable low 32
// bits 0x7f000000 and 0.
func TestDPImmOutside32BitRange() testing.TestResult {
	var two32 int = twoTo32()
	if two32 == 0 { return "" }
	var minWord int = -2147483648
	var m @[]char = checkDPRejects(DP_ADD, Imm(two32), " #0x100000000")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, Imm(two32 + 0xff), " #0x1000000ff")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ORR, Imm(minWord - 0x1000000), " #-0x81000000")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_CMP, Imm(0 - two32), " #-0x100000000")
	if len(m) != 0 { return m }
	for opcode := 0; opcode < 16; opcode++ {
		m = checkDPRejects(opcode, Imm(two32), " #0x100000000")
		if len(m) != 0 { return m }
	}
	return ""
}

// The error names the architecture and the 32-bit range.
func TestDPImmOutside32BitRangeMessage() testing.TestResult {
	var two32 int = twoTo32()
	if two32 == 0 { return "" }
	var a @asm.Assembler = newAsm()
	Mov(a, COND_AL, false, R0, Imm(two32))
	return checkErrorPrefix(a, "arm32: data-processing immediate outside the 32-bit range")
}

// Memory and label operands are not Operand2 kinds for any encoder.
func TestDPMemAndLabelOperandsAllEncoders() testing.TestResult {
	for opcode := 0; opcode < 16; opcode++ {
		var m @[]char = checkDPRejects(opcode, MemImm(R2, 4), " [r2, #4]")
		if len(m) != 0 { return m }
		m = checkDPRejects(opcode, Label("sym"), " sym")
		if len(m) != 0 { return m }
	}
	return ""
}

// Every memory-operand kind, and a Kind outside the defined set, is rejected.
func TestDPEveryNonOperand2Kind() testing.TestResult {
	var m @[]char = checkDPRejects(DP_ADD, MemReg(R2, R3), " [r2, r3]")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, MemSReg(R2, R3, LSL, 2), " [r2, r3, lsl #2]")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, MemPre(R2, 4), " [r2, #4]!")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, MemPost(R2, 4), " [r2], #4")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, MemPreReg(R2, R3), " [r2, r3]!")
	if len(m) != 0 { return m }
	m = checkDPRejects(DP_ADD, MemPostReg(R2, R3), " [r2], r3")
	if len(m) != 0 { return m }
	var bogus Operand = Reg(R2)
	bogus.Kind = 99
	m = checkDPRejects(DP_ADD, bogus, " <kind 99>")
	if len(m) != 0 { return m }
	return ""
}

// The error names the architecture and the operand-kind problem.
func TestDPNonOperand2KindMessage() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, COND_AL, false, R0, MemImm(R1, 0))
	var want *[]readonly char = "arm32: data-processing operand must be"
	if len(a.ErrorMsg) < len(want) { return fail("error message too short") }
	if !charsSame(a.ErrorMsg[0:len(want)], want) {
		return fail("error message should start with 'arm32: data-processing operand must be'")
	}
	return ""
}

// A rejected instruction leaves no gap: the instructions around it are
// contiguous.
func TestDPRejectedInstructionEmitsNothingMidStream() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mov(a, COND_AL, false, R0, Imm(1))
	Add(a, COND_AL, false, R0, R1, Imm(0x102))
	Mov(a, COND_AL, false, R0, Imm(2))
	if !a.HasError { return fail("unencodable immediate should set an assembler error") }
	if a.Sections[0].Len != 8 { return fail("only the two valid MOVs should be emitted") }
	if readInst(a.Sections[0], 0) != 0xE3A00001 { return fail("mov r0, #1 encoding wrong") }
	if readInst(a.Sections[0], 4) != 0xE3A00002 { return fail("mov r0, #2 encoding wrong") }
	return ""
}
