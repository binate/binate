package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- System instructions ---

// NOP: MOV R0, R0 (canonical encoding: 0xE1A00000)
// ARMv6K+ has a real NOP (0xE320F000) but MOV R0,R0 is universally
// recognized as NOP.
func Nop(a @asm.Assembler) {
	emit32(a, 0xE1A00000)
}

// SVC (formerly SWI): cond[31:28] | 1111 | imm24[23:0].  An immediate outside
// 0..0xFFFFFF is an error (nothing emitted), as in LLVM and GNU as, rather than
// silently keeping its low 24 bits.
func Svc(a @asm.Assembler, cond int, imm int) {
	if imm < 0 || imm > 0xFFFFFF {
		a.SetError("arm32: SVC immediate out of range (0..0xFFFFFF)")
		return
	}
	var inst uint32 = condBits(cond) | 0x0F000000
	inst = inst | cast(uint32, imm)
	emit32(a, inst)
}

// BKPT: 1110 | 0001 0010 | imm12[19:8] | 0111 | imm4[3:0]
// Unconditional (always uses cond=AL=0xE).  An immediate outside 0..0xFFFF is an
// error (nothing emitted), as in LLVM and GNU as, rather than silently keeping
// its low 16 bits.
func Bkpt(a @asm.Assembler, imm int) {
	if imm < 0 || imm > 0xFFFF {
		a.SetError("arm32: BKPT immediate out of range (0..65535)")
		return
	}
	var inst uint32 = 0xE1200070
	var uimm uint32 = cast(uint32, imm)
	inst = inst | ((uimm >> 4) << 8)
	inst = inst | (uimm & 0xf)
	emit32(a, inst)
}

// --- Fixup resolution ---

// readInst32 reads a little-endian 32-bit word from a byte slice.
func readInst32(data *[]uint8, off int) uint32 {
	var b0 uint32 = cast(uint32, data[off])
	var b1 uint32 = cast(uint32, data[off + 1])
	var b2 uint32 = cast(uint32, data[off + 2])
	var b3 uint32 = cast(uint32, data[off + 3])
	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

// writeInst32 writes a little-endian 32-bit word to a byte slice.
func writeInst32(data *[]uint8, off int, val uint32) {
	data[off] = cast(uint8, val & 0xff)
	data[off + 1] = cast(uint8, (val >> 8) & 0xff)
	data[off + 2] = cast(uint8, (val >> 16) & 0xff)
	data[off + 3] = cast(uint8, (val >> 24) & 0xff)
}

// patchBranch24 patches a 24-bit branch offset into bits [23:0].
// The offset is PC-relative. On ARM32 the PC reads as current + 8
// (two instructions ahead), so the encoded offset is:
//   (target - fixup_addr - 8) / 4
// Returns false if out of range.
func patchBranch24(data *[]uint8, off int, offset int) bool {
	// Adjust for pipeline: subtract 8 from the raw PC-relative offset
	var adjusted int = offset - 8
	// Must be word-aligned
	if adjusted & 3 != 0 {
		return false
	}
	var wordOff int = adjusted >> 2
	// Range: 24-bit signed = [-8388608, 8388607]
	if wordOff < -8388608 || wordOff > 8388607 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	// Clear bits [23:0] and insert new offset
	inst = inst & 0xFF000000
	inst = inst | (cast(uint32, wordOff) & 0x00FFFFFF)
	writeInst32(data, off, inst)
	return true
}

// isPcRelFixup reports whether kind is PC-relative: a branch (FIX_BRANCH24) or a literal
// load / store (FIX_LDR_PC_G0, FIX_LDRS_PC_G0).
func isPcRelFixup(kind int) bool {
	return kind == FIX_BRANCH24 || kind == FIX_LDR_PC_G0 || kind == FIX_LDRS_PC_G0
}

// patchPcRel patches the PC-relative fixup of kind (isPcRelFixup) at data[off] with the
// target's byte distance dist from the instruction (the field holds dist - 8, as PC reads
// the instruction + 8).  Returns false when that does not fit the field.
func patchPcRel(data *[]uint8, kind int, off int, dist int) bool {
	if kind == FIX_BRANCH24 { return patchBranch24(data, off, dist) }
	return patchLdrPcOffset(data, off, kind, dist - 8)
}

// patchLdrPcOffset writes the offset v from PC into a PC-relative load / store at
// data[at]: the U bit and the 12-bit magnitude (kind FIX_LDR_PC_G0) or the split 8-bit
// magnitude (FIX_LDRS_PC_G0).  Returns false when the magnitude does not fit.
func patchLdrPcOffset(data *[]uint8, at int, kind int, v int) bool {
	var mag int = v
	var up uint32 = 1
	if v < 0 {
		mag = -v
		up = 0
	}
	var inst uint32 = readInst32(data, at) & 0xFF7FFFFF
	if kind == FIX_LDR_PC_G0 {
		if mag > 4095 { return false }
		inst = (inst & 0xFFFFF000) | cast(uint32, mag)
	} else {
		if mag > 255 { return false }
		inst = (inst & 0xFFFFF0F0) | (cast(uint32, mag >> 4) << 8) | cast(uint32, mag & 15)
	}
	writeInst32(data, at, inst | (up << 23))
	return true
}

// unpatchable records that fixup fix's value has no encoding in its field.
func unpatchable(a @asm.Assembler, fix asm.Fixup) {
	a.SetError(
			buf.Concat(buf.Concat("arm32: the reference to '", asm.LabelForMessage(fix.Label)),
					"' is out of range or misaligned for its instruction"))
}

// ResolveFixups finalizes every ARM32 fixup ahead of asm.Finalize().  A branch or
// PC-relative load / store to a local symbol in its own section is resolved fully in
// place (patchPcRel) and marked resolved, so it emits no relocation.  Every OTHER ARM32
// fixup — to a global or weak symbol (arm32 objects are ELF, where the linker may bind
// it elsewhere: a weak one overridden, say — so clang relocates it too), an external /
// cross-section branch or load, or any ABS32 / MOVW / MOVT — becomes an EM_ARM REL
// relocation, so its addend is baked into the
// instruction/data field here (bakeRelAddend): ARM ELF is REL-only, carrying no
// r_addend word, and GNU bfd computes `S + A` with A read from the field.  A value
// its field cannot hold (out of range, misaligned) is an error naming the label, so
// no instruction is written unpatched.  Must be called before asm.Finalize() (which
// turns the still-unresolved fixups into relocations).
func ResolveFixups(a @asm.Assembler) bool {
	var ok bool = true
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		// bnlint:allow managed-to-raw-assign - sec is a live @asm.Section; Data outlives the read
		var data *[]uint8 = sec.Data
		for fi := 0; fi < sec.NumFixups; fi++ {
			var fix asm.Fixup = sec.Fixups[fi]
			// Our fixup kinds: the generic word-absolute (kind 0, from the
			// shared data-global emitter — R_ARM_ABS32) and the ARM32-specific
			// FIX_BRANCH24..FIX_LDRS_PC_G0.  (A resolved fixup is Kind -1.)
			if fix.Kind != 0 && (fix.Kind < FIX_BRANCH24 || fix.Kind > FIX_LDRS_PC_G0) {
				continue
			}
			var fixupAddr int = cast(int, fix.Offset)
			// A branch or literal load to a local symbol in its own section resolves fully in
			// place → no relocation.
			if isPcRelFixup(fix.Kind) {
				// bnlint:allow managed-to-raw-assign - fix is a live fixup; Label outlives the read
				var symName *[]readonly char = fix.Label
				var symIdx int = a.LookupSymbol(symName)
				if symIdx >= 0 {
					var sym asm.Symbol = a.Symbols[symIdx]
					if sym.Section >= 0 && sym.Section == si && sym.Binding == asm.BIND_LOCAL {
						var pcRelOff int = cast(int, sym.Offset) + fix.Addend - fixupAddr
						if !patchPcRel(data, fix.Kind, fixupAddr, pcRelOff) {
							unpatchable(a, fix)
							ok = false
							continue
						}
						a.MarkFixupResolved(si, fi)
						continue
					}
				}
			}
			// Otherwise it becomes a REL relocation: bake the addend in place.
			if !bakeRelAddend(a, data, fix) {
				unpatchable(a, fix)
				ok = false
			}
		}
	}
	return ok
}

// bakeRelAddend writes an ARM32 relocation's addend into its instruction/data field in place, so
// the EM_ARM REL relocation (which carries no r_addend word) still conveys it — GNU bfd computes
// `S + A`, reading A from the field.  A branch or PC-relative load / store folds in the -8
// pipeline bias exactly as a resolved same-object one does (patchPcRel subtracts 8, so a plain
// call encodes imm24 = 0xfffffe and `ldr r0, ext` [PC, #-8], matching clang's REL form).  A
// word-absolute reloc — the generic kind 0 from the shared data-global emitter (a `&sym + off`
// data pointer, e.g. a reflect descriptor payload at sym+8) as well as the ARM32-specific
// FIX_ABS32 — takes the addend as a whole word.  MOVW/MOVT addends are always 0 today (the offset
// rides the symbol value); there is no MOVW/MOVT immediate-field encoding here yet, so a non-zero
// one fails loud rather than being silently dropped (which would mislink under bfd).
func bakeRelAddend(a @asm.Assembler, data *[]uint8, fix asm.Fixup) bool {
	if isPcRelFixup(fix.Kind) {
		return patchPcRel(data, fix.Kind, cast(int, fix.Offset), fix.Addend)
	}
	// kind 0 (generic word-absolute) and FIX_ABS32 both map to R_ARM_ABS32.
	if fix.Kind == 0 || fix.Kind == FIX_ABS32 {
		writeInst32(data, cast(int, fix.Offset), cast(uint32, fix.Addend))
		return true
	}
	// FIX_MOVW_ABS_NC / FIX_MOVT_ABS
	if fix.Addend != 0 {
		a.SetError("arm32: non-zero MOVW/MOVT addend has no REL field encoding")
		return false
	}
	return true
}
