package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// --- System instructions ---

// NOP: MOV R0, R0 (canonical encoding: 0xE1A00000)
// ARMv6K+ has a real NOP (0xE320F000) but MOV R0,R0 is universally
// recognized as NOP.
func Nop(a @asm.Assembler) {
	emit32(a, 0xE1A00000)
}

// SVC (formerly SWI): cond[31:28] | 1111 | imm24[23:0]
func Svc(a @asm.Assembler, cond int, imm int) {
	var inst uint32 = condBits(cond) | 0x0F000000
	inst = inst | cast(uint32, imm & 0xFFFFFF)
	emit32(a, inst)
}

// BKPT: 1110 | 0001 0010 | imm12[19:8] | 0111 | imm4[3:0]
// Unconditional (always uses cond=AL=0xE)
func Bkpt(a @asm.Assembler, imm int) {
	var inst uint32 = 0xE1200070
	var uimm uint32 = cast(uint32, imm & 0xffff)
	inst = inst | ((uimm >> 4) << 8)
	inst = inst | (uimm & 0xf)
	emit32(a, inst)
}

// --- Fixup resolution ---

// readInst32 reads a little-endian 32-bit word from a byte slice.
func readInst32(data *[]uint8, off int) uint32 {
	var b0 uint32 = cast(uint32, data[off])
	var b1 uint32 = cast(uint32, data[off + 1])
	var b2 uint32 = cast(uint32, data[off + 2])
	var b3 uint32 = cast(uint32, data[off + 3])
	return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

// writeInst32 writes a little-endian 32-bit word to a byte slice.
func writeInst32(data *[]uint8, off int, val uint32) {
	data[off] = cast(uint8, val & 0xff)
	data[off + 1] = cast(uint8, (val >> 8) & 0xff)
	data[off + 2] = cast(uint8, (val >> 16) & 0xff)
	data[off + 3] = cast(uint8, (val >> 24) & 0xff)
}

// patchBranch24 patches a 24-bit branch offset into bits [23:0].
// The offset is PC-relative. On ARM32 the PC reads as current + 8
// (two instructions ahead), so the encoded offset is:
//   (target - fixup_addr - 8) / 4
// Returns false if out of range.
func patchBranch24(data *[]uint8, off int, offset int) bool {
	// Adjust for pipeline: subtract 8 from the raw PC-relative offset
	var adjusted int = offset - 8
	// Must be word-aligned
	if adjusted & 3 != 0 {
		return false
	}
	var wordOff int = adjusted >> 2
	// Range: 24-bit signed = [-8388608, 8388607]
	if wordOff < -8388608 || wordOff > 8388607 {
		return false
	}
	var inst uint32 = readInst32(data, off)
	// Clear bits [23:0] and insert new offset
	inst = inst & 0xFF000000
	inst = inst | (cast(uint32, wordOff) & 0x00FFFFFF)
	writeInst32(data, off, inst)
	return true
}

// ResolveFixups finalizes every ARM32 fixup ahead of asm.Finalize().  A
// same-section branch is resolved fully in place (patchBranch24) and marked
// resolved, so it emits no relocation.  Every OTHER ARM32 fixup — an
// external / cross-section branch, or any ABS32 / MOVW / MOVT — becomes an
// EM_ARM REL relocation, so its addend is baked into the instruction/data field
// here (bakeRelAddend): ARM ELF is REL-only, carrying no r_addend word, and GNU
// bfd computes `S + A` with A read from the field.  Must be called before
// asm.Finalize() (which turns the still-unresolved fixups into relocations).
func ResolveFixups(a @asm.Assembler) bool {
	var ok bool = true
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		// bnlint:allow managed-to-raw-assign - sec is a live @asm.Section; Data outlives the read
		var data *[]uint8 = sec.Data
		for fi := 0; fi < sec.NumFixups; fi++ {
			var fix asm.Fixup = sec.Fixups[fi]
			// Our fixup kinds: the generic word-absolute (kind 0, from the
			// shared data-global emitter — R_ARM_ABS32) and the ARM32-specific
			// FIX_BRANCH24..FIX_MOVT_ABS.  (A resolved fixup is Kind -1.)
			if fix.Kind != 0 && (fix.Kind < FIX_BRANCH24 || fix.Kind > FIX_MOVT_ABS) {
				continue
			}
			var fixupAddr int = cast(int, fix.Offset)
			// A same-section branch resolves fully in place → no relocation.
			if fix.Kind == FIX_BRANCH24 {
				// bnlint:allow managed-to-raw-assign - fix is a live fixup; Label outlives the read
				var symName *[]readonly char = fix.Label
				var symIdx int = a.LookupSymbol(symName)
				if symIdx >= 0 {
					var sym asm.Symbol = a.Symbols[symIdx]
					if sym.Section >= 0 && sym.Section == si {
						var pcRelOff int = cast(int, sym.Offset) + fix.Addend - fixupAddr
						if !patchBranch24(data, fixupAddr, pcRelOff) {
							ok = false
						}
						a.MarkFixupResolved(si, fi)
						continue
					}
				}
			}
			// Otherwise it becomes a REL relocation: bake the addend in place.
			if !bakeRelAddend(a, data, fix) {
				ok = false
			}
		}
	}
	return ok
}

// bakeRelAddend writes an ARM32 relocation's addend into its instruction/data
// field in place, so the EM_ARM REL relocation (which carries no r_addend word)
// still conveys it — GNU bfd computes `S + A`, reading A from the field.  A
// branch folds in the -8 pipeline bias exactly as a resolved same-object branch
// does (patchBranch24 subtracts 8, so a plain call encodes imm24 = 0xfffffe,
// matching clang's REL form).  A word-absolute reloc — the generic kind 0 from
// the shared data-global emitter (a `&sym + off` data pointer, e.g. a reflect
// descriptor payload at sym+8) as well as the ARM32-specific FIX_ABS32 — takes
// the addend as a whole word.  MOVW/MOVT addends are always 0 today (the offset
// rides the symbol value); there is no MOVW/MOVT immediate-field encoding here
// yet, so a non-zero one fails loud rather than being silently dropped (which
// would mislink under bfd).
func bakeRelAddend(a @asm.Assembler, data *[]uint8, fix asm.Fixup) bool {
	if fix.Kind == FIX_BRANCH24 {
		return patchBranch24(data, cast(int, fix.Offset), fix.Addend)
	}
	// kind 0 (generic word-absolute) and FIX_ABS32 both map to R_ARM_ABS32.
	if fix.Kind == 0 || fix.Kind == FIX_ABS32 {
		writeInst32(data, cast(int, fix.Offset), cast(uint32, fix.Addend))
		return true
	}
	// FIX_MOVW_ABS_NC / FIX_MOVT_ABS
	if fix.Addend != 0 {
		a.SetError("arm32: non-zero MOVW/MOVT addend has no REL field encoding")
		return false
	}
	return true
}
