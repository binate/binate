package "pkg/binate/asm/arm32"

import "pkg/binate/asm"

// VFP (VFPv3-D32) scalar floating-point instruction encoding.
//
// Target baseline is arm-linux-gnueabihf / cortex-a15: single-precision
// registers S0..S31 and double-precision registers D0..D31 (D32 variant).
// These encoders manipulate register numbers and opcode bit-patterns as
// integers only — no float values are involved in encoding a VFP word.
//
// Every VFP register operand is a 5-bit number split across a 4-bit field
// in the instruction word plus one extra bit, at fixed positions:
//
//   Vd -> field [15:12], extra bit D [22]
//   Vn -> field [19:16], extra bit N [7]
//   Vm -> field [3:0],   extra bit M [5]
//
// Which half of the register number goes into the field vs. the extra bit
// depends on precision (this is the classic VFP gotcha):
//
//   single Sn: field = n>>1 (top 4 bits), extra = n&1  (low bit)
//   double Dn: field = n&0xF (low 4 bits), extra = n>>4 (high bit)
//
// The `sz` bit [8] selects precision (0=single/cp10, 1=double/cp11). All
// base words below are given with the condition field [31:28] cleared;
// condBits(cond) supplies it.

// splitSingle returns (field4, extra) for single-precision register S`r`.
// `r` is an S0..S31 constant; & 0x1f recovers the 0..31 hardware number.
func splitSingle(r int) (uint32, uint32) {
	var n int = r & 0x1f
	return cast(uint32, (n >> 1) & 0xf), cast(uint32, n & 1)
}

// splitDouble returns (field4, extra) for double-precision register D`r`.
// `r` is a D0..D31 constant; & 0x1f recovers the 0..31 hardware number.
func splitDouble(r int) (uint32, uint32) {
	var n int = r & 0x1f
	return cast(uint32, n & 0xf), cast(uint32, (n >> 4) & 1)
}

// placeVd returns the Vd field [15:12] + D bit [22] for register `r`,
// split as double when `dbl` else single.
func placeVd(dbl bool, r int) uint32 {
	var field uint32 = 0
	var extra uint32 = 0
	if dbl {
		field, extra = splitDouble(r)
	} else {
		field, extra = splitSingle(r)
	}
	return (field << 12) | (extra << 22)
}

// placeVn returns the Vn field [19:16] + N bit [7] for register `r`.
func placeVn(dbl bool, r int) uint32 {
	var field uint32 = 0
	var extra uint32 = 0
	if dbl {
		field, extra = splitDouble(r)
	} else {
		field, extra = splitSingle(r)
	}
	return (field << 16) | (extra << 7)
}

// placeVm returns the Vm field [3:0] + M bit [5] for register `r`.
func placeVm(dbl bool, r int) uint32 {
	var field uint32 = 0
	var extra uint32 = 0
	if dbl {
		field, extra = splitDouble(r)
	} else {
		field, extra = splitSingle(r)
	}
	return field | (extra << 5)
}

// vfpThreeReg builds a 3-register VFP data-processing word (VADD/VSUB/
// VMUL/VDIV) from a cond-less `base`, all operands the same precision.
func vfpThreeReg(cond int, base uint32, dbl bool, vd int, vn int, vm int) uint32 {
	var inst uint32 = condBits(cond) | base
	inst = inst | placeVd(dbl, vd)
	inst = inst | placeVn(dbl, vn)
	inst = inst | placeVm(dbl, vm)
	return inst
}

// vfpTwoReg builds a 2-register VFP word (VNEG/VMOV-copy/VCMP/VCVT) from a
// cond-less `base`. Vd and Vm carry independent precisions (`dblD`/`dblM`)
// so mixed-precision VCVT forms encode correctly.
func vfpTwoReg(cond int, base uint32, dblD bool, vd int, dblM bool, vm int) uint32 {
	var inst uint32 = condBits(cond) | base
	inst = inst | placeVd(dblD, vd)
	inst = inst | placeVm(dblM, vm)
	return inst
}

// --- Arithmetic (3-register) ---

// VaddF32 emits VADD.F32{cond} Sd, Sn, Sm.
func VaddF32(a @asm.Assembler, cond int, sd int, sn int, sm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E300A00), false, sd, sn, sm))
}

// VaddF64 emits VADD.F64{cond} Dd, Dn, Dm.
func VaddF64(a @asm.Assembler, cond int, dd int, dn int, dm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E300B00), true, dd, dn, dm))
}

// VsubF32 emits VSUB.F32{cond} Sd, Sn, Sm.
func VsubF32(a @asm.Assembler, cond int, sd int, sn int, sm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E300A40), false, sd, sn, sm))
}

// VsubF64 emits VSUB.F64{cond} Dd, Dn, Dm.
func VsubF64(a @asm.Assembler, cond int, dd int, dn int, dm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E300B40), true, dd, dn, dm))
}

// VmulF32 emits VMUL.F32{cond} Sd, Sn, Sm.
func VmulF32(a @asm.Assembler, cond int, sd int, sn int, sm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E200A00), false, sd, sn, sm))
}

// VmulF64 emits VMUL.F64{cond} Dd, Dn, Dm.
func VmulF64(a @asm.Assembler, cond int, dd int, dn int, dm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E200B00), true, dd, dn, dm))
}

// VdivF32 emits VDIV.F32{cond} Sd, Sn, Sm.
func VdivF32(a @asm.Assembler, cond int, sd int, sn int, sm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E800A00), false, sd, sn, sm))
}

// VdivF64 emits VDIV.F64{cond} Dd, Dn, Dm.
func VdivF64(a @asm.Assembler, cond int, dd int, dn int, dm int) {
	emit32(a, vfpThreeReg(cond, cast(uint32, 0x0E800B00), true, dd, dn, dm))
}

// --- Negate (2-register) ---

// VnegF32 emits VNEG.F32{cond} Sd, Sm.
func VnegF32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB10A40), false, sd, false, sm))
}

// VnegF64 emits VNEG.F64{cond} Dd, Dm.
func VnegF64(a @asm.Assembler, cond int, dd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB10B40), true, dd, true, dm))
}

// --- Register-copy VMOV (2-register, same precision) ---

// VmovF32 emits VMOV.F32{cond} Sd, Sm (single-precision register copy).
func VmovF32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB00A40), false, sd, false, sm))
}

// VmovF64 emits VMOV.F64{cond} Dd, Dm (double-precision register copy).
func VmovF64(a @asm.Assembler, cond int, dd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB00B40), true, dd, true, dm))
}

// --- Core <-> single-register VMOV ---

// VmovCoreToSingle emits VMOV{cond} Sn, Rt (copy a core register into a
// single-precision register). The single reg uses the Vn field + N bit.
func VmovCoreToSingle(a @asm.Assembler, cond int, sn int, rt int) {
	var inst uint32 = condBits(cond) | cast(uint32, 0x0E000A10)
	inst = inst | (cast(uint32, rt & 0xf) << 12)
	inst = inst | placeVn(false, sn)
	emit32(a, inst)
}

// VmovSingleToCore emits VMOV{cond} Rt, Sn (copy a single-precision
// register into a core register).
func VmovSingleToCore(a @asm.Assembler, cond int, rt int, sn int) {
	var inst uint32 = condBits(cond) | cast(uint32, 0x0E100A10)
	inst = inst | (cast(uint32, rt & 0xf) << 12)
	inst = inst | placeVn(false, sn)
	emit32(a, inst)
}

// --- Core-pair <-> double-register VMOV ---

// VmovCoresToDouble emits VMOV{cond} Dm, Rt, Rt2 (pack two core registers
// into a double-precision register; Rt is the low word, Rt2 the high word).
func VmovCoresToDouble(a @asm.Assembler, cond int, dm int, rt int, rt2 int) {
	var inst uint32 = condBits(cond) | cast(uint32, 0x0C400B10)
	inst = inst | (cast(uint32, rt & 0xf) << 12)
	inst = inst | (cast(uint32, rt2 & 0xf) << 16)
	inst = inst | placeVm(true, dm)
	emit32(a, inst)
}

// VmovDoubleToCores emits VMOV{cond} Rt, Rt2, Dm (unpack a double-precision
// register into two core registers; Rt gets the low word, Rt2 the high).
func VmovDoubleToCores(a @asm.Assembler, cond int, rt int, rt2 int, dm int) {
	var inst uint32 = condBits(cond) | cast(uint32, 0x0C500B10)
	inst = inst | (cast(uint32, rt & 0xf) << 12)
	inst = inst | (cast(uint32, rt2 & 0xf) << 16)
	inst = inst | placeVm(true, dm)
	emit32(a, inst)
}

// --- Compare (2-register) ---

// VcmpF32 emits VCMP.F32{cond} Sd, Sm (quiet compare, sets FPSCR flags).
func VcmpF32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB40A40), false, sd, false, sm))
}

// VcmpF64 emits VCMP.F64{cond} Dd, Dm (quiet compare, sets FPSCR flags).
func VcmpF64(a @asm.Assembler, cond int, dd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB40B40), true, dd, true, dm))
}

// VcmpeF32 emits VCMPE.F32{cond} Sd, Sm (signaling compare).
func VcmpeF32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB40AC0), false, sd, false, sm))
}

// VcmpeF64 emits VCMPE.F64{cond} Dd, Dm (signaling compare).
func VcmpeF64(a @asm.Assembler, cond int, dd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB40BC0), true, dd, true, dm))
}

// --- FPSCR flag transfer ---

// VmrsApsrNzcv emits VMRS{cond} APSR_nzcv, FPSCR — copy the FPSCR N/Z/C/V
// flags into the CPSR condition flags (used after VCMP(E) to make the
// result testable by the ordinary condition codes).
func VmrsApsrNzcv(a @asm.Assembler, cond int) {
	emit32(a, condBits(cond) | cast(uint32, 0x0EF1FA10))
}

// --- Convert: float precision ---

// VcvtF64F32 emits VCVT.F64.F32{cond} Dd, Sm (widen single to double).
func VcvtF64F32(a @asm.Assembler, cond int, dd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB70AC0), true, dd, false, sm))
}

// VcvtF32F64 emits VCVT.F32.F64{cond} Sd, Dm (narrow double to single).
func VcvtF32F64(a @asm.Assembler, cond int, sd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB70BC0), false, sd, true, dm))
}

// --- Convert: integer -> float (integer operand in a single register) ---

// VcvtF32S32 emits VCVT.F32.S32{cond} Sd, Sm (signed int32 -> float32).
func VcvtF32S32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB80AC0), false, sd, false, sm))
}

// VcvtF32U32 emits VCVT.F32.U32{cond} Sd, Sm (unsigned int32 -> float32).
func VcvtF32U32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB80A40), false, sd, false, sm))
}

// VcvtF64S32 emits VCVT.F64.S32{cond} Dd, Sm (signed int32 -> float64).
func VcvtF64S32(a @asm.Assembler, cond int, dd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB80BC0), true, dd, false, sm))
}

// VcvtF64U32 emits VCVT.F64.U32{cond} Dd, Sm (unsigned int32 -> float64).
func VcvtF64U32(a @asm.Assembler, cond int, dd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EB80B40), true, dd, false, sm))
}

// --- Convert: float -> integer, round-toward-zero (result in a single) ---

// VcvtS32F32 emits VCVT.S32.F32{cond} Sd, Sm (float32 -> signed int32, trunc).
func VcvtS32F32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EBD0AC0), false, sd, false, sm))
}

// VcvtU32F32 emits VCVT.U32.F32{cond} Sd, Sm (float32 -> unsigned int32, trunc).
func VcvtU32F32(a @asm.Assembler, cond int, sd int, sm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EBC0AC0), false, sd, false, sm))
}

// VcvtS32F64 emits VCVT.S32.F64{cond} Sd, Dm (float64 -> signed int32, trunc).
func VcvtS32F64(a @asm.Assembler, cond int, sd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EBD0BC0), false, sd, true, dm))
}

// VcvtU32F64 emits VCVT.U32.F64{cond} Sd, Dm (float64 -> unsigned int32, trunc).
func VcvtU32F64(a @asm.Assembler, cond int, sd int, dm int) {
	emit32(a, vfpTwoReg(cond, cast(uint32, 0x0EBC0BC0), false, sd, true, dm))
}

// --- Load / Store ---

// vfpOffset validates a VLDR/VSTR byte displacement and returns the 8-bit
// imm8 field (|offset|/4). It errors on the assembler if the offset is not
// a multiple of 4 or its magnitude exceeds 1020 — an assembler must NOT
// silently emit a wrapped or misaligned access (mirrors imm12Offset). The
// sign (U bit) is chosen by the caller; this returns only the magnitude.
func vfpOffset(a @asm.Assembler, offset int) uint32 {
	var mag int = offset
	if mag < 0 {
		mag = -mag
	}
	if (mag & 3) != 0 {
		a.SetError("arm32: VLDR/VSTR offset must be a multiple of 4")
	}
	if mag > 1020 {
		a.SetError("arm32: VLDR/VSTR immediate offset out of range "
				"(magnitude must fit 1020)")
	}
	return cast(uint32, (mag >> 2) & 0xff)
}

// vfpLdrStrEnc encodes a VLDR/VSTR word from a cond-less `base` (with L and
// precision already set, U clear). It sets U for a non-negative offset and
// ORs in Rn, Vd, and the scaled imm8.
func vfpLdrStrEnc(a @asm.Assembler, cond int, base uint32, dbl bool, vd int, rn int,
		offset int) uint32 {
	var inst uint32 = condBits(cond) | base
	inst = inst | (cast(uint32, rn & 0xf) << 16)
	inst = inst | placeVd(dbl, vd)
	if offset >= 0 {
		inst = inst | (cast(uint32, 1) << 23)
	}
	inst = inst | vfpOffset(a, offset)
	return inst
}

// Vldr32 emits VLDR{cond}.32 Sd, [Rn, #±offset] (load a 32-bit float).
func Vldr32(a @asm.Assembler, cond int, sd int, rn int, offset int) {
	emit32(a, vfpLdrStrEnc(a, cond, cast(uint32, 0x0D100A00), false, sd, rn, offset))
}

// Vldr64 emits VLDR{cond}.64 Dd, [Rn, #±offset] (load a 64-bit float).
func Vldr64(a @asm.Assembler, cond int, dd int, rn int, offset int) {
	emit32(a, vfpLdrStrEnc(a, cond, cast(uint32, 0x0D100B00), true, dd, rn, offset))
}

// Vstr32 emits VSTR{cond}.32 Sd, [Rn, #±offset] (store a 32-bit float).
func Vstr32(a @asm.Assembler, cond int, sd int, rn int, offset int) {
	emit32(a, vfpLdrStrEnc(a, cond, cast(uint32, 0x0D000A00), false, sd, rn, offset))
}

// Vstr64 emits VSTR{cond}.64 Dd, [Rn, #±offset] (store a 64-bit float).
func Vstr64(a @asm.Assembler, cond int, dd int, rn int, offset int) {
	emit32(a, vfpLdrStrEnc(a, cond, cast(uint32, 0x0D000B00), true, dd, rn, offset))
}
