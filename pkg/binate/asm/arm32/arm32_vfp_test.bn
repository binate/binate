package "pkg/binate/asm/arm32"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Byte-exact VFP encoding tests. Every expected word below was produced by
// arm-none-eabi-as -mcpu=cortex-a15 (.fpu vfpv3) and read back via objdump;
// the accompanying comment records the disassembly. Register choices
// deliberately exercise the split gotchas: odd single registers (low extra
// bit), double registers >= D16 (high extra bit), a negative load/store
// offset (U bit clear), and mixed-precision VCVT (Vd and Vm differ).

// --- Register-constant namespace ---

func TestVfpRegisterConstants() testing.TestResult {
	if S0 != 32 || S31 != 63 {
		return fail("S0/S31 wrong")
	}
	if D0 != 64 || D31 != 95 {
		return fail("D0/D31 wrong")
	}
	// & 0x1f must recover the hardware number and keep S/D disjoint from GP.
	if (S5 & 0x1f) != 5 || (D17 & 0x1f) != 17 {
		return fail("register & 0x1f wrong")
	}
	return ""
}

// --- Arithmetic ---

func TestVaddF32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vadd.f32 s1, s2, s3 = 0xee710a21
	VaddF32(a, COND_AL, S1, S2, S3)
	if readInst(a.Sections[0], 0) != 0xEE710A21 {
		return fail("VADD.F32 S1,S2,S3 wrong")
	}
	return ""
}

func TestVaddF64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vadd.f64 d16, d1, d2 = 0xee710b02  (Dd>=D16 sets the D top bit)
	VaddF64(a, COND_AL, D16, D1, D2)
	if readInst(a.Sections[0], 0) != 0xEE710B02 {
		return fail("VADD.F64 D16,D1,D2 wrong")
	}
	return ""
}

func TestVsubF32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vsub.f32 s4, s5, s6 = 0xee322ac3
	VsubF32(a, COND_AL, S4, S5, S6)
	if readInst(a.Sections[0], 0) != 0xEE322AC3 {
		return fail("VSUB.F32 S4,S5,S6 wrong")
	}
	return ""
}

