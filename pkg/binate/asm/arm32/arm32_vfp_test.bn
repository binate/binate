// --- Load / Store ---

func TestVldr32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vldr s1, [r0, #8] = 0xedd00a02  (positive offset, U set)
	Vldr32(a, COND_AL, S1, R0, 8)
	if readInst(a.Sections[0], 0) != 0xEDD00A02 {
		return fail("VLDR.32 S1,[R0,#8] wrong")
	}
	return ""
}

func TestVldr64Negative() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vldr d16, [r1, #-16] = 0xed510b04  (negative offset, U clear; Dd>=D16)
	Vldr64(a, COND_AL, D16, R1, -16)
	if readInst(a.Sections[0], 0) != 0xED510B04 {
		return fail("VLDR.64 D16,[R1,#-16] wrong")
	}
	return ""
}

func TestVstr32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vstr s5, [r2, #12] = 0xedc22a03  (odd single Sd)
	Vstr32(a, COND_AL, S5, R2, 12)
	if readInst(a.Sections[0], 0) != 0xEDC22A03 {
		return fail("VSTR.32 S5,[R2,#12] wrong")
	}
	return ""
}

func TestVstr64Negative() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vstr d3, [r3, #-8] = 0xed033b02  (negative offset, U clear)
	Vstr64(a, COND_AL, D3, R3, -8)
	if readInst(a.Sections[0], 0) != 0xED033B02 {
		return fail("VSTR.64 D3,[R3,#-8] wrong")
	}
	return ""
}

// --- Offset validation (must error, not silently wrap) ---

func TestVfpOffsetUnalignedErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// offset 6 is not a multiple of 4 -> must set the assembler error flag.
	Vldr32(a, COND_AL, S0, R0, 6)
	if !a.HasError {
		return fail("VLDR.32 with unaligned offset should error")
	}
	return ""
}

func TestVfpOffsetOutOfRangeErrors() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// offset 1024 > 1020 (imm8 would overflow) -> must set the error flag.
	Vstr64(a, COND_AL, D0, R0, 1024)
	if !a.HasError {
		return fail("VSTR.64 with out-of-range offset should error")
	}
	return ""
}

// --- Top-register end-to-end (assert the maximal field value, not just the const) ---

func TestVaddF32TopRegs() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// VADD.F32 S31, S30, S29 (AL): single split Sd=31->field 15,D=1; Sn=30->field 15,N=0;
	// Sm=29->field 14,M=1 = 0xEE7FFA2E (verified vs arm-none-eabi-as).
	VaddF32(a, COND_AL, S31, S30, S29)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEE7FFA2E {
		return fail("VADD.F32 S31,S30,S29 encoding wrong")
	}
	return ""
}

func TestVaddF64TopRegs() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// VADD.F64 D31, D30, D29 (AL): double split Dd=31->field 15,D=1; Dn=30->field 14,N=1;
	// Dm=29->field 13,M=1 = 0xEE7EFBAD (verified vs arm-none-eabi-as).
	VaddF64(a, COND_AL, D31, D30, D29)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEE7EFBAD {
		return fail("VADD.F64 D31,D30,D29 encoding wrong")
	}
	return ""
}
