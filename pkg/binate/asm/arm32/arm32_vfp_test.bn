func TestVcvtF64F32() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vcvt.f64.f32 d16, s3 = 0xeef70ae1  (Dd double-split, Sm single-split)
	VcvtF64F32(a, COND_AL, D16, S3)
	if readInst(a.Sections[0], 0) != 0xEEF70AE1 {
		return fail("VCVT.F64.F32 D16,S3 wrong")
	}
	return ""
}

func TestVcvtF32F64() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// vcvt.f32.f64 s1, d16 = 0xeef70be0  (odd Sd single-split, Dm double-split)
	VcvtF32F64(a, COND_AL, S1, D16)
	if readInst(a.Sections[0], 0) != 0xEEF70BE0 {
		return fail("VCVT.F32.F64 S1,D16 wrong")
	}
	return ""
}

