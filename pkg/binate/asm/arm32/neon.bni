// Package neon provides the exact Advanced SIMD (NEON) encoders for the arm32 assembler, in the
// manner of pkg/binate/asm/arm32 and its vfp sub-package: each call emits the one instruction its
// operands name, or sets the assembler error and emits nothing when they have no encoding -- a
// data type the instruction has not, a register outside D0..D31 (vfp.D0..D31) or Q0..Q15, or a
// mix of the two where the instruction takes all of one.  NEON's encodings in ARM code are
// unconditional (cond field 1111).
package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"

// The NEON quadword registers Q0..Q15, each the pair D(2n), D(2n+1).  Offset by 96 so the
// namespace is disjoint from arm32.R0..R15, vfp.S0..S31 and vfp.D0..D31; `- Q0` recovers the
// 0..15 number.
const (
	Q0 int = iota + 96
	Q1
	Q2
	Q3
	Q4
	Q5
	Q6
	Q7
	Q8
	Q9
	Q10
	Q11
	Q12
	Q13
	Q14
	Q15
)

// The data types of an instruction (its `.` suffix): integers of no sign (I), signed (S) and
// unsigned (U), polynomials (P), floating point (F), and a size alone, which the bitwise
// instructions and VTST take.
const (
	DT_I8 int = iota + 1
	DT_I16
	DT_I32
	DT_I64
	DT_S8
	DT_S16
	DT_S32
	DT_S64
	DT_U8
	DT_U16
	DT_U32
	DT_U64
	DT_P8
	DT_P64
	DT_F16
	DT_F32
	DT_8
	DT_16
	DT_32
	DT_64
)

// The operations of three registers of the same length (Three): 1111 001U 0DCC nnnn dddd oooo NQMB
// mmmm, Vd the result, Vn and Vm the operands (VSHL / VRSHL / VQSHL / VQRSHL: Vm the value and Vn
// the shift, as their syntax writes Vd, Vm, Vn).  Each takes the data types of its encodings: VADD
// / VSUB, VCEQ, VPADD, VMUL, VMLA / VMLS I8..I32 (and VADD / VSUB I64); VHADD / VHSUB / VRHADD,
// VCGE / VCGT, VABD / VABA, VMAX / VMIN, VPMAX / VPMIN S8..S32 and U8..U32; VQADD / VQSUB and the
// register shifts S8..S64 and U8..U64; VQDMULH / VQRDMULH S16 and S32; VMUL P8; F32 and F16 for the
// floating-point ones (VADD / VSUB, VCEQ / VCGE / VCGT, VACGE / VACGT, VABD, VMAX / VMIN, VPADD /
// VPMAX / VPMIN, VMUL / VMLA / VMLS, VRECPS / VRSQRTS, VFMA / VFMS, VMAXNM / VMINNM); VTST a size
// of 8, 16 or 32; the bitwise VAND .. VBIF none, or a size, which they ignore.  VPADD / VPMAX /
// VPMIN take D registers only.
const (
	THREE_VADD int = iota + 1
	THREE_VSUB
	THREE_VHADD
	THREE_VHSUB
	THREE_VRHADD
	THREE_VQADD
	THREE_VQSUB
	THREE_VAND
	THREE_VBIC
	THREE_VORR
	THREE_VORN
	THREE_VEOR
	THREE_VBSL
	THREE_VBIT
	THREE_VBIF
	THREE_VCEQ
	THREE_VCGE
	THREE_VCGT
	THREE_VACGE
	THREE_VACGT
	THREE_VTST
	THREE_VABD
	THREE_VABA
	THREE_VMAX
	THREE_VMIN
	THREE_VPADD
	THREE_VPMAX
	THREE_VPMIN
	THREE_VMUL
	THREE_VMLA
	THREE_VMLS
	THREE_VQDMULH
	THREE_VQRDMULH
	THREE_VRECPS
	THREE_VRSQRTS
	THREE_VSHL
	THREE_VRSHL
	THREE_VQSHL
	THREE_VQRSHL
	THREE_VFMA
	THREE_VFMS
	THREE_VMAXNM
	THREE_VMINNM
)

// Three emits the NEON instruction op (THREE_*) of data type dt (DT_*, or 0 for none) on D
// registers vd, vn, vm (vfp.D0..D31) or Q registers (Q0..Q15).
func Three(a @asm.Assembler, op int, dt int, vd int, vn int, vm int)

// The operations of three registers of different lengths (Diff): 1111 001U 1Dss nnnn dddd oooo
// N0M0 mmmm, the size that of the operands' elements (of the result's, for the narrowing ones).
// The long ones (VADDL, VSUBL, VABAL, VABDL, VMLAL, VMLSL, VMULL, VQDMLAL, VQDMLSL, VQDMULL) make
// a Q register of two D registers; the wide ones (VADDW, VSUBW) of a Q and a D register; the
// narrowing ones (VADDHN, VRADDHN, VSUBHN, VRSUBHN) a D register of two Q registers.  Each takes
// the data types of its encodings: S8..S32 and U8..U32, but VQDMLAL / VQDMLSL / VQDMULL S16 and
// S32 only, VMULL P8 and P64 too, and the narrowing ones I16..I64.
const (
	DIFF_VADDL int = iota + 1
	DIFF_VADDW
	DIFF_VSUBL
	DIFF_VSUBW
	DIFF_VADDHN
	DIFF_VRADDHN
	DIFF_VABAL
	DIFF_VSUBHN
	DIFF_VRSUBHN
	DIFF_VABDL
	DIFF_VMLAL
	DIFF_VQDMLAL
	DIFF_VMLSL
	DIFF_VQDMLSL
	DIFF_VMULL
	DIFF_VQDMULL
)

// Diff emits the NEON instruction op (DIFF_*) of data type dt (DT_*) on registers vd, vn, vm of the
// lengths op takes: D registers vfp.D0..D31, Q registers Q0..Q15.
func Diff(a @asm.Assembler, op int, dt int, vd int, vn int, vm int)

// The operations of two registers and a scalar (Scalar): 1111 001Q 1Dss nnnn dddd oooo N1M0 mmmm,
// bit 24 the Q bit (the U bit of VMLAL, VMLSL and VMULL, 0 for the saturating long ones), the
// scalar Dm[x] in M and Vm: for 16-bit elements D0..D7 and lanes 0..3 (Vm<2:0> the register,
// M:Vm<3> the lane), for 32-bit ones D0..D15 and lanes 0..1 (M the lane).  VMLA, VMLS and VMUL
// take I16 / I32 and F16 / F32 on D or Q registers; VQDMULH and VQRDMULH S16 / S32 on D or Q
// registers; the long ones (VMLAL, VMLSL, VMULL; VQDMLAL, VQDMLSL, VQDMULL) S16 / S32 and U16 /
// U32 (the saturating ones signed only), a Q register of a D register and the scalar.
const (
	SCALAR_VMLA int = iota + 1
	SCALAR_VMLAL
	SCALAR_VQDMLAL
	SCALAR_VMLS
	SCALAR_VMLSL
	SCALAR_VQDMLSL
	SCALAR_VMUL
	SCALAR_VMULL
	SCALAR_VQDMULL
	SCALAR_VQDMULH
	SCALAR_VQRDMULH
)

// Scalar emits the NEON instruction op (SCALAR_*) of data type dt (DT_*) on registers vd and vn
// (D registers vfp.D0..D31 or Q registers Q0..Q15, as op takes) and the scalar vm[lane] (a D
// register).
func Scalar(a @asm.Assembler, op int, dt int, vd int, vn int, vm int, lane int)

// The operations of two registers and a shift amount (Shift): 1111 001U 1Dii iiii dddd oooo LQM1
// mmmm, the element size and amount in L:imm6 -- a right shift by n of e-bit elements 2e - n, a
// left shift e + n (L set for 64-bit elements, imm6 then n's own field).  The right shifts (VSHR,
// VSRA, VRSHR, VRSRA, VSRI) take 1..e, the left ones (VSHL, VSLI, VQSHL, VQSHLU) 0..e-1.  VSHR /
// VSRA / VRSHR / VRSRA and VQSHL take S8..S64 and U8..U64 (the U bit the sign), VQSHLU S8..S64,
// VSHL I8..I64, VSRI / VSLI a size of 8..64; D or Q registers, both of one length.  The narrowing
// ones (a D register of a Q register's elements of the data type, 16 .. 64 bits, shifted right by
// 1..e/2 as a right shift of the result's elements; VRSHRN, VQRSHRN and VQRSHRUN with bit 6 set)
// take I16..I64 (VSHRN, VRSHRN), S16..S64 and U16..U64 (VQSHRN, VQRSHRN), S16..S64 (VQSHRUN,
// VQRSHRUN); VSHLL (a Q register of a D register's elements) S8..S32 and U8..U32 by 0..e-1 (0 is
// VMOVL) as a left shift, and by e -- I8..I32 too -- as 1111 0011 1D11 ss10 dddd 0011 00M0 mmmm.
const (
	SHIFT_VSHR int = iota + 1
	SHIFT_VSRA
	SHIFT_VRSHR
	SHIFT_VRSRA
	SHIFT_VSRI
	SHIFT_VSHL
	SHIFT_VSLI
	SHIFT_VQSHLU
	SHIFT_VQSHL
	SHIFT_VSHRN
	SHIFT_VRSHRN
	SHIFT_VQSHRN
	SHIFT_VQRSHRN
	SHIFT_VQSHRUN
	SHIFT_VQRSHRUN
	SHIFT_VSHLL
)

// Shift emits the NEON instruction op (SHIFT_*) of data type dt (DT_*) shifting vm into vd (D
// registers vfp.D0..D31 or Q registers Q0..Q15, of the lengths op takes) by amount.
func Shift(a @asm.Assembler, op int, dt int, vd int, vm int, amount int)

// The two-register miscellaneous operations (Two): 1111 0011 1D11 ssrr dddd 0ooo oQM0 mmmm, rr the
// row, oooo the operation (ooooo, Q's bit with it, for those on registers of two lengths and the
// crypto ones).  VREV64 / VREV32 / VREV16 take a size of 8..32 / 8..16 / 8, VCNT 8,
// VTRN / VUZP / VZIP 8..32 (VUZP and VZIP not 32 on D registers, the permutation VTRN.32's);
// VPADDL / VPADAL S8..S32 and U8..U32; VCLS, VQABS / VQNEG S8..S32, VCLZ I8..I32; VMVN and VSWP
// none or any size, which they ignore; VABS / VNEG and the comparisons with 0 (VCGT0 .. VCLT0)
// S8..S32 (VCEQ0 I8..I32) and F32 / F16; VMOVN I16..I64, VQMOVUN S16..S64, VQMOVN S16..S64 and
// U16..U64, the Q register's elements; VRECPE / VRSQRTE U32, F32 and F16; ARMv8's VRINTN ..
// VRINTP F32 and F16, and VCVTA .. VCVTM (to an integer, rounding as named) S32 / U32 from F32 and
// S16 / U16 from F16.  VCVT.F16.F32 and VCVT.BF16.F32 (a D register of a Q register's elements)
// and VCVT.F32.F16 (a Q register of a D register's) take no data type, their names giving it; the
// crypto ones Q registers only, AESE / AESD / AESMC / AESIMC a size of 8, SHA1H / SHA1SU1 /
// SHA256SU0 32.
const (
	TWO_VREV64 int = iota + 1
	TWO_VREV32
	TWO_VREV16
	TWO_VPADDL
	TWO_VPADAL
	TWO_VCLS
	TWO_VCLZ
	TWO_VCNT
	TWO_VMVN
	TWO_VQABS
	TWO_VQNEG
	TWO_VCGT0
	TWO_VCGE0
	TWO_VCEQ0
	TWO_VCLE0
	TWO_VCLT0
	TWO_VABS
	TWO_VNEG
	TWO_VSWP
	TWO_VTRN
	TWO_VUZP
	TWO_VZIP
	TWO_VMOVN
	TWO_VQMOVUN
	TWO_VQMOVN
	TWO_VRECPE
	TWO_VRSQRTE
	TWO_VCVT_F16_F32
	TWO_VCVT_BF16_F32
	TWO_VCVT_F32_F16
	TWO_VRINTN
	TWO_VRINTX
	TWO_VRINTA
	TWO_VRINTZ
	TWO_VRINTM
	TWO_VRINTP
	TWO_VCVTA
	TWO_VCVTN
	TWO_VCVTP
	TWO_VCVTM
	TWO_AESE
	TWO_AESD
	TWO_AESMC
	TWO_AESIMC
	TWO_SHA1H
	TWO_SHA1SU1
	TWO_SHA256SU0
)

// Two emits the NEON instruction op (TWO_*) of data type dt (DT_*, or 0 for none) on D registers
// vd, vm (vfp.D0..D31) or Q registers (Q0..Q15) of the lengths op takes.
func Two(a @asm.Assembler, op int, dt int, vd int, vm int)

// Cvt emits VCVT.<to>.<from> vd, vm -- to and from DT_* -- on D registers (vfp.D0..D31) or Q
// registers (Q0..Q15), both of one length: F32 from S32 or U32 and S32 or U32 from F32, and the
// half-precision F16 from S16 or U16 and S16 or U16 from F16.  With fbits 0 the integer
// conversion, 1111 0011 1D11 ss11 dddd 011o oQM0 mmmm (oo: 00 from S, 01 from U, 10 to S, 11 to
// U); with fbits fraction bits, 1..e for e-bit elements, the fixed-point one, 1111 001U 1Dii iiii
// dddd 11sf 0QM1 mmmm (ii iiii 64 - fbits, U the integer's sign, s set for 32-bit elements, f set
// to the integer).
func Cvt(a @asm.Assembler, to int, from int, vd int, vm int, fbits int)
