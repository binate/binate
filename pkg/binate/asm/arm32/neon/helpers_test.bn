package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Helpers for the encoders' own checks: a fresh assembler, and predicates on what it emitted.

// fail returns msg as a failing test result.
func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

// newAsm returns a 32-bit assembler positioned in a text section.
func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// readInst reads the little-endian instruction word at off in section s.
func readInst(s @asm.Section, off int) uint32 {
	return cast(uint32, s.Data[off]) | (cast(uint32, s.Data[off + 1]) << 8) |
			(cast(uint32, s.Data[off + 2]) << 16) | (cast(uint32, s.Data[off + 3]) << 24)
}

// rejected reports whether a recorded an error and emitted nothing.
func rejected(a @asm.Assembler) bool { return a.HasError && a.Sections[0].Len == 0 }

// wordsAre reports whether a holds exactly the words want, in order, with no error.
func wordsAre(a @asm.Assembler, want @[]uint32) bool {
	if a.HasError || a.Sections[0].Len != cast(int64, 4 * len(want)) { return false }
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] { return false }
	}
	return true
}
