package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"

// neonRegs reports whether vd, vn and vm are all D registers (vfp.D0..D31) or all Q registers
// (Q0..Q15), and which, setting the assembler error if neither.
func neonRegs(a @asm.Assembler, vd int, vn int, vm int) (bool, bool) {
	if isD(vd) && isD(vn) && isD(vm) { return false, true }
	if isQ(vd) && isQ(vn) && isQ(vm) { return true, true }
	a.SetError("arm32: a NEON instruction's registers are all D0..D31 or all Q0..Q15")
	return false, false
}

// isD reports whether r is a D register, vfp.D0..D31.
func isD(r int) bool { return r >= vfp.D0 && r <= vfp.D31 }

// isQ reports whether r is a Q register, Q0..Q15.
func isQ(r int) bool { return r >= Q0 && r <= Q15 }

// dNum returns the number of D register r, or of the first of Q register r's pair.
func dNum(r int) uint32 {
	if isQ(r) { return cast(uint32, 2 * (r - Q0)) }
	return cast(uint32, r - vfp.D0)
}

// placeD returns register r as an instruction's Vd field [15:12] and D bit [22].
func placeD(r int) uint32 {
	var n uint32 = dNum(r)
	return ((n & 15) << 12) | ((n >> 4) << 22)
}

// placeN returns register r as an instruction's Vn field [19:16] and N bit [7].
func placeN(r int) uint32 {
	var n uint32 = dNum(r)
	return ((n & 15) << 16) | ((n >> 4) << 7)
}

// placeM returns register r as an instruction's Vm field [3:0] and M bit [5].
func placeM(r int) uint32 {
	var n uint32 = dNum(r)
	return (n & 15) | ((n >> 4) << 5)
}

// bitIf returns bit when on, else 0.
func bitIf(on bool, bit uint32) uint32 {
	if on { return bit }
	return 0
}
