package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// cplxSize returns the S bit of a complex-number instruction's element size (16 or 32), setting
// the error for another.
func cplxSize(a @asm.Assembler, size int) (uint32, bool) {
	if size != 16 && size != 32 {
		a.SetError("arm32: VCMLA / VCADD take 16- or 32-bit elements")
		return 0, false
	}
	return bitIf(size == 32, 1), true
}

// Cmla emits VCMLA.F16 / .F32 (size 16 or 32) vd, vn, vm, #rot: 1111 110r rD1S nnnn dddd 1000
// NQM0 mmmm, rr the rotation (0, 90, 180 or 270) over 90, on three D registers (vfp.D0..D31) or
// three Q registers (Q0..Q15).  ARMv8.3's complex-number multiply-accumulate.
func Cmla(a @asm.Assembler, size int, vd int, vn int, vm int, rot int) {
	s, ok := cplxSize(a, size)
	if !ok { return }
	if rot != 0 && rot != 90 && rot != 180 && rot != 270 {
		a.SetError("arm32: VCMLA's rotation is 0, 90, 180 or 270")
		return
	}
	q, regs := neonRegs(a, vd, vn, vm)
	if !regs { return }
	arm32.Emit32(a,
			0xFC200800 | (cast(uint32, rot / 90) << 23) | (s << 20) | placeD(vd) | placeN(vn) | placeM(vm) |
					bitIf(q, 0x40))
}

// CmlaLane emits VCMLA.F16 / .F32 (size 16 or 32) vd, vn, dm[x], #rot: 1111 1110 SDrr nnnn dddd
// 1000 NQM0 mmmm, S set for 32-bit elements and rr the rotation (0, 90, 180 or 270) over 90, on D
// registers vd, vn (vfp.D0..D31) or Q registers (Q0..Q15) and the D register dm: for 16-bit
// elements D0..D15 (mmmm) with lane x 0..1 (M), for 32-bit ones D0..D31 (M:mmmm) with lane 0.
func CmlaLane(a @asm.Assembler, size int, vd int, vn int, dm int, x int, rot int) {
	s, ok := cplxSize(a, size)
	if !ok { return }
	if rot != 0 && rot != 90 && rot != 180 && rot != 270 {
		a.SetError("arm32: VCMLA's rotation is 0, 90, 180 or 270")
		return
	}
	var q bool = isQ(vd) && isQ(vn)
	if !q && (!isD(vd) || !isD(vn)) {
		a.SetError("arm32: VCMLA's registers are two D or two Q registers and a scalar")
		return
	}
	var m uint32 = placeM(dm)
	if size == 16 {
		if !isD(dm) || dNum(dm) > 15 || x < 0 || x > 1 {
			a.SetError("arm32: VCMLA.F16's scalar is one of D0..D15 with lane 0..1")
			return
		}
		m = dNum(dm) | (cast(uint32, x) << 5)
	} else if !isD(dm) || x != 0 {
		a.SetError("arm32: VCMLA.F32's scalar is one of D0..D31 with lane 0")
		return
	}
	arm32.Emit32(a,
			0xFE000800 | (s << 23) | (cast(uint32, rot / 90) << 20) | placeD(vd) | placeN(vn) | m |
					bitIf(q, 0x40))
}

// Cadd emits VCADD.F16 / .F32 (size 16 or 32) vd, vn, vm, #rot: 1111 110r 1D0S nnnn dddd 1000 NQM0
// mmmm, r set for a rotation of 270 (clear for 90), on three D registers (vfp.D0..D31) or three Q
// registers (Q0..Q15).  ARMv8.3's complex-number add.
func Cadd(a @asm.Assembler, size int, vd int, vn int, vm int, rot int) {
	s, ok := cplxSize(a, size)
	if !ok { return }
	if rot != 90 && rot != 270 {
		a.SetError("arm32: VCADD's rotation is 90 or 270")
		return
	}
	q, regs := neonRegs(a, vd, vn, vm)
	if !regs { return }
	arm32.Emit32(a,
			0xFC800800 | bitIf(rot == 270, 0x1000000) | (s << 20) | placeD(vd) | placeN(vn) | placeM(vm) |
					bitIf(q, 0x40))
}
