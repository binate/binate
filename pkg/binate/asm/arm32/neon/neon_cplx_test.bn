package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The complex-number instructions as clang assembles them: VCMLA.F32 D0, D1, D2, #0 and #90;
// VCMLA.F32 Q0, Q1, Q2, #180; VCMLA.F16 D0, D1, D2, #270; VCMLA.F16 Q15, Q14, Q13, #90; VCMLA.F32
// D0, D2, D1, #0; VCMLA.F16 Q8, Q10, Q9, #270; by a scalar, VCMLA.F32 Q0, Q1, D2[0], #90; VCMLA.F32
// D0, D1, D31[0], #0; VCMLA.F32 Q15, Q12, D31[0], #270; VCMLA.F16 D0, D1, D15[1], #270; VCMLA.F16
// Q0, Q1, D2[1], #90; VCMLA.F16 Q1, Q6, D1[1], #180; VCMLA.F16 D18, D31, D6[0], #180; VCADD.F32
// D0, D1, D2, #90; VCADD.F32 Q0, Q1, Q2, #270; VCADD.F16 D31, D30, D29, #90; VCADD.F16 Q15, Q14,
// Q13, #270; VCADD.F32 Q8, Q10, Q9, #90; VCADD.F16 D16, D18, D17, #270.
func TestNeonCplx() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cmla(a, 32, vfp.D0, vfp.D1, vfp.D2, 0)
	Cmla(a, 32, vfp.D0, vfp.D1, vfp.D2, 90)
	Cmla(a, 32, Q0, Q1, Q2, 180)
	Cmla(a, 16, vfp.D0, vfp.D1, vfp.D2, 270)
	Cmla(a, 16, Q15, Q14, Q13, 90)
	Cmla(a, 32, vfp.D0, vfp.D2, vfp.D1, 0)
	Cmla(a, 16, Q8, Q10, Q9, 270)
	CmlaLane(a, 32, Q0, Q1, vfp.D2, 0, 90)
	CmlaLane(a, 32, vfp.D0, vfp.D1, vfp.D31, 0, 0)
	CmlaLane(a, 32, Q15, Q12, vfp.D31, 0, 270)
	CmlaLane(a, 16, vfp.D0, vfp.D1, vfp.D15, 1, 270)
	CmlaLane(a, 16, Q0, Q1, vfp.D2, 1, 90)
	CmlaLane(a, 16, Q1, Q6, vfp.D1, 1, 180)
	CmlaLane(a, 16, vfp.D18, vfp.D31, vfp.D6, 0, 180)
	Cadd(a, 32, vfp.D0, vfp.D1, vfp.D2, 90)
	Cadd(a, 32, Q0, Q1, Q2, 270)
	Cadd(a, 16, vfp.D31, vfp.D30, vfp.D29, 90)
	Cadd(a, 16, Q15, Q14, Q13, 270)
	Cadd(a, 32, Q8, Q10, Q9, 90)
	Cadd(a, 16, vfp.D16, vfp.D18, vfp.D17, 270)
	if !wordsAre(a,
			@[]uint32{0xFC310802, 0xFCB10802, 0xFD320844, 0xFDA10802, 0xFCECE8EA, 0xFC320801, 0xFDE408E2,
					0xFE920842, 0xFE81082F, 0xFEF8E8EF, 0xFE31082F, 0xFE120862, 0xFE2C2861, 0xFE6F2886, 0xFC910802,
					0xFD920844, 0xFCCEF8AD, 0xFDCCE8EA, 0xFCD408E2, 0xFDC208A1}) {
		return fail("a NEON complex-number instruction is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: 8- or 64-bit elements (by a scalar
// too); a rotation VCMLA has not (45, -90) or VCADD has not (0, 180); D and Q registers mixed (a Q
// and a D register, or a Q register's scalar, by a scalar too); a 16-bit scalar past D15 or lane 1,
// a 32-bit one's lane past 0.
func TestNeonCplxRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 13)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Cmla(bad[0], 8, vfp.D0, vfp.D1, vfp.D2, 0)
	Cadd(bad[1], 64, vfp.D0, vfp.D1, vfp.D2, 90)
	Cmla(bad[2], 32, vfp.D0, vfp.D1, vfp.D2, 45)
	CmlaLane(bad[3], 16, vfp.D0, vfp.D1, vfp.D2, 0, -90)
	Cadd(bad[4], 32, vfp.D0, vfp.D1, vfp.D2, 0)
	Cadd(bad[5], 16, Q0, Q1, Q2, 180)
	Cmla(bad[6], 32, vfp.D0, Q1, vfp.D2, 0)
	CmlaLane(bad[7], 16, vfp.D0, vfp.D1, vfp.D16, 0, 0)
	CmlaLane(bad[8], 16, Q0, Q1, vfp.D2, 2, 90)
	CmlaLane(bad[9], 32, vfp.D0, vfp.D1, vfp.D2, 1, 0)
	CmlaLane(bad[10], 8, vfp.D0, vfp.D1, vfp.D2, 0, 0)
	CmlaLane(bad[11], 16, Q0, vfp.D1, vfp.D2, 0, 90)
	CmlaLane(bad[12], 32, Q0, Q1, Q2, 0, 90)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON complex-number instruction was taken") }
	}
	return ""
}
