package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// Cvt emits VCVT.<to>.<from> vd, vm (D registers vfp.D0..D31 or Q registers Q0..Q15, both of one
// length) with fbits fraction bits, or fbits 0 for the integer conversion.
func Cvt(a @asm.Assembler, to int, from int, vd int, vm int, fbits int) {
	regs, q := shiftRegs(shiftSame, vd, vm)
	if !regs {
		a.SetError("arm32: a NEON conversion's registers are both D0..D31 or both Q0..Q15")
		return
	}
	// The conversions, in the order of the integer conversion's op field for each element size:
	// from S, from U, to S, to U.
	var tos @[]int = @[]int{DT_F32, DT_F32, DT_S32, DT_U32, DT_F16, DT_F16, DT_S16, DT_U16}
	var froms @[]int = @[]int{DT_S32, DT_U32, DT_F32, DT_F32, DT_S16, DT_U16, DT_F16, DT_F16}
	var op int = -1
	for i := 0; i < len(tos); i++ {
		if tos[i] == to && froms[i] == from { op = i }
	}
	if op < 0 {
		a.SetError("arm32: no NEON conversion between those data types")
		return
	}
	var half bool = op >= 4
	var code uint32 = cast(uint32, op & 3)
	if fbits == 0 {
		var size uint32 = 2
		if half { size = 1 }
		arm32.Emit32(a,
				0xF3B30600 | (size << 18) | placeD(vd) | (code << 7) | bitIf(q, 0x40) | placeM(vm))
		return
	}
	var e int = 32
	if half { e = 16 }
	if fbits < 1 || fbits > e {
		a.SetError("arm32: a NEON fixed-point conversion's fraction bits past those its element size has")
		return
	}
	arm32.Emit32(a,
			0xF2800C10 | ((code & 1) << 24) | (cast(uint32, 64 - fbits) << 16) | placeD(vd) |
					bitIf(!half, 0x200) | ((code >> 1) << 8) | bitIf(q, 0x40) | placeM(vm))
}
