package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The conversions as clang assembles them: the integer ones (VCVT.S32.F32 D0, D1; VCVT.F32.U32 D0,
// D1; VCVT.U32.F32 Q15, Q14; VCVT.S16.F16 D0, D1; VCVT.U16.F16 D0, D1; VCVT.F16.S16 D0, D1;
// VCVT.F16.U16 Q0, Q1) and the fixed-point ones (VCVT.S32.F32 D0, D1, #1 and #32; VCVT.U32.F32 D0,
// D1, #1; VCVT.F32.S32 D0, D1, #1; VCVT.F32.U32 D0, D1, #1; VCVT.S32.F32 Q0, Q1, #1; VCVT.S32.F32
// D31, D30, #5; VCVT.F32.U32 Q15, Q14, #31; VCVT.S16.F16 D0, D1, #1 and #16; VCVT.U16.F16 D0, D1,
// #1; VCVT.F16.U16 Q0, Q1, #3; VCVT.F16.S16 D31, D30, #16).
func TestNeonCvt() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cvt(a, DT_S32, DT_F32, vfp.D0, vfp.D1, 0)
	Cvt(a, DT_F32, DT_U32, vfp.D0, vfp.D1, 0)
	Cvt(a, DT_U32, DT_F32, Q15, Q14, 0)
	Cvt(a, DT_S16, DT_F16, vfp.D0, vfp.D1, 0)
	Cvt(a, DT_U16, DT_F16, vfp.D0, vfp.D1, 0)
	Cvt(a, DT_F16, DT_S16, vfp.D0, vfp.D1, 0)
	Cvt(a, DT_F16, DT_U16, Q0, Q1, 0)
	Cvt(a, DT_S32, DT_F32, vfp.D0, vfp.D1, 1)
	Cvt(a, DT_S32, DT_F32, vfp.D0, vfp.D1, 32)
	Cvt(a, DT_U32, DT_F32, vfp.D0, vfp.D1, 1)
	Cvt(a, DT_F32, DT_S32, vfp.D0, vfp.D1, 1)
	Cvt(a, DT_F32, DT_U32, vfp.D0, vfp.D1, 1)
	Cvt(a, DT_S32, DT_F32, Q0, Q1, 1)
	Cvt(a, DT_S32, DT_F32, vfp.D31, vfp.D30, 5)
	Cvt(a, DT_F32, DT_U32, Q15, Q14, 31)
	Cvt(a, DT_S16, DT_F16, vfp.D0, vfp.D1, 1)
	Cvt(a, DT_S16, DT_F16, vfp.D0, vfp.D1, 16)
	Cvt(a, DT_U16, DT_F16, vfp.D0, vfp.D1, 1)
	Cvt(a, DT_F16, DT_U16, Q0, Q1, 3)
	Cvt(a, DT_F16, DT_S16, vfp.D31, vfp.D30, 16)
	if !wordsAre(a,
			@[]uint32{0xF3BB0701, 0xF3BB0681, 0xF3FBE7EC, 0xF3B70701, 0xF3B70781, 0xF3B70601, 0xF3B706C2,
					0xF2BF0F11, 0xF2A00F11, 0xF3BF0F11, 0xF2BF0E11, 0xF3BF0E11, 0xF2BF0F52, 0xF2FBFF3E, 0xF3E1EE7C,
					0xF2BF0D11, 0xF2B00D11, 0xF3BF0D11, 0xF3BD0C52, 0xF2F0FC3E}) {
		return fail("a NEON conversion is not clang's word")
	}
	return ""
}

// A conversion there is no encoding of is an error that emits nothing: data types it has not
// (F32 from S16, S32 from S32, F16 from F32), registers of two lengths or S registers, fraction
// bits past the element size (33 for 32 bits, 17 for 16) or negative.
func TestNeonCvtRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 8)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Cvt(bad[0], DT_F32, DT_S16, vfp.D0, vfp.D1, 0)
	Cvt(bad[1], DT_S32, DT_S32, vfp.D0, vfp.D1, 0)
	Cvt(bad[2], DT_F16, DT_F32, vfp.D0, vfp.D1, 0)
	Cvt(bad[3], DT_S32, DT_F32, Q0, vfp.D1, 0)
	Cvt(bad[4], DT_S32, DT_F32, vfp.D0, vfp.D1, 33)
	Cvt(bad[5], DT_S16, DT_F16, vfp.D0, vfp.D1, 17)
	Cvt(bad[6], DT_F32, DT_S32, vfp.D0, vfp.D1, -1)
	Cvt(bad[7], DT_F32, DT_S32, vfp.S0, vfp.S1, 0)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON conversion was taken") }
	}
	return ""
}
