package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The register lengths of a three-different-lengths operation (diffOp): long (Q, D, D), wide (Q,
// Q, D), narrowing (D, Q, Q).
const (
	diffLong int = iota
	diffWide
	diffNarrow
)

// diffOp returns how op (DIFF_*) is encoded: its opcode (-1 for no such operation), its registers'
// lengths (diff*), its data types' kind -- neonKindSU (8 .. 32 bits, the U bit the sign),
// neonKindS (signed 16 and 32 bits) or neonKindI (16 .. 64 bits) -- and the U bit of an S or I
// kind.
func diffOp(op int) (int, int, int, uint32) {
	if op == DIFF_VADDL { return 0, diffLong, neonKindSU, 0 }
	if op == DIFF_VADDW { return 1, diffWide, neonKindSU, 0 }
	if op == DIFF_VSUBL { return 2, diffLong, neonKindSU, 0 }
	if op == DIFF_VSUBW { return 3, diffWide, neonKindSU, 0 }
	if op == DIFF_VADDHN { return 4, diffNarrow, neonKindI, 0 }
	if op == DIFF_VRADDHN { return 4, diffNarrow, neonKindI, 1 }
	if op == DIFF_VABAL { return 5, diffLong, neonKindSU, 0 }
	if op == DIFF_VSUBHN { return 6, diffNarrow, neonKindI, 0 }
	if op == DIFF_VRSUBHN { return 6, diffNarrow, neonKindI, 1 }
	if op == DIFF_VABDL { return 7, diffLong, neonKindSU, 0 }
	if op == DIFF_VMLAL { return 8, diffLong, neonKindSU, 0 }
	if op == DIFF_VQDMLAL { return 9, diffLong, neonKindS, 0 }
	if op == DIFF_VMLSL { return 10, diffLong, neonKindSU, 0 }
	if op == DIFF_VQDMLSL { return 11, diffLong, neonKindS, 0 }
	if op == DIFF_VMULL { return 12, diffLong, neonKindSU, 0 }
	if op == DIFF_VQDMULL { return 13, diffLong, neonKindS, 0 }
	return -1, diffLong, neonKindNone, 0
}

// diffRegs reports whether vd, vn and vm have the lengths shape (diff*) takes.
func diffRegs(shape int, vd int, vn int, vm int) bool {
	if shape == diffLong { return isQ(vd) && isD(vn) && isD(vm) }
	if shape == diffWide { return isQ(vd) && isQ(vn) && isD(vm) }
	return isD(vd) && isQ(vn) && isQ(vm)
}

// Diff emits the NEON instruction op (DIFF_*) of data type dt (DT_*) on registers vd, vn, vm of the
// lengths op takes: D registers vfp.D0..D31, Q registers Q0..Q15.
func Diff(a @asm.Assembler, op int, dt int, vd int, vn int, vm int) {
	opc, shape, kind, u := diffOp(op)
	if opc < 0 {
		a.SetError("arm32: no such NEON operation")
		return
	}
	if !diffRegs(shape, vd, vn, vm) {
		a.SetError("arm32: the NEON operation's registers are not of the lengths it takes")
		return
	}
	size, dkind := neonSize(dt)
	var ok bool = false
	if op == DIFF_VMULL && (dt == DT_P8 || dt == DT_P64) {
		// The polynomial multiplies: opcode 1110, U 0, size 0 for P8 and 2 for P64.
		opc = 14
		ok = true
		size = 0
		if dt == DT_P64 { size = 2 }
	} else if kind == neonKindSU {
		ok = (dkind == neonKindS || dkind == neonKindU) && size <= 2
		u = bitIf(dkind == neonKindU, 1)
	} else if kind == neonKindS {
		ok = dkind == neonKindS && size >= 1 && size <= 2
	} else {
		ok = dkind == neonKindI && size >= 1 && size <= 3
		size = size - 1
	}
	if !ok {
		a.SetError("arm32: the NEON operation has no form of that data type")
		return
	}
	arm32.Emit32(a,
			0xF2800000 | (u << 24) | placeD(vd) | (cast(uint32, size) << 20) | placeN(vn) |
					(cast(uint32, opc) << 8) | placeM(vm))
}
