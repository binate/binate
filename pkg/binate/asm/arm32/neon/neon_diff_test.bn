package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// Three registers of different lengths as clang assembles them: VADDL.S8 Q0, D1, D2; VADDL.U32
// Q8, D17, D31; VADDW.S16 Q0, Q1, D2; VSUBW.U8 Q0, Q1, D2; VSUBL.S32 Q8, D17, D31; VADDHN.I64
// D31, Q15, Q14; VRADDHN.I16 D0, Q1, Q2; VRSUBHN.I32 D31, Q15, Q14; VSUBHN.I64 D0, Q1, Q2;
// VABAL.S32 Q8, D17, D31; VABDL.U16 Q0, D1, D2; VMLAL.U8 Q8, D17, D31; VMLSL.S16 Q0, D1, D2;
// VMULL.P8 Q8, D17, D31; VMULL.P64 Q8, D17, D31; VMULL.U32 Q0, D1, D2; VQDMULL.S16 Q8, D17,
// D31; VQDMLAL.S32 Q0, D1, D2; VQDMLSL.S16 Q8, D17, D31.
func TestNeonDiff() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Diff(a, DIFF_VADDL, DT_S8, Q0, vfp.D1, vfp.D2)
	Diff(a, DIFF_VADDL, DT_U32, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VADDW, DT_S16, Q0, Q1, vfp.D2)
	Diff(a, DIFF_VSUBW, DT_U8, Q0, Q1, vfp.D2)
	Diff(a, DIFF_VSUBL, DT_S32, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VADDHN, DT_I64, vfp.D31, Q15, Q14)
	Diff(a, DIFF_VRADDHN, DT_I16, vfp.D0, Q1, Q2)
	Diff(a, DIFF_VRSUBHN, DT_I32, vfp.D31, Q15, Q14)
	Diff(a, DIFF_VSUBHN, DT_I64, vfp.D0, Q1, Q2)
	Diff(a, DIFF_VABAL, DT_S32, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VABDL, DT_U16, Q0, vfp.D1, vfp.D2)
	Diff(a, DIFF_VMLAL, DT_U8, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VMLSL, DT_S16, Q0, vfp.D1, vfp.D2)
	Diff(a, DIFF_VMULL, DT_P8, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VMULL, DT_P64, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VMULL, DT_U32, Q0, vfp.D1, vfp.D2)
	Diff(a, DIFF_VQDMULL, DT_S16, Q8, vfp.D17, vfp.D31)
	Diff(a, DIFF_VQDMLAL, DT_S32, Q0, vfp.D1, vfp.D2)
	Diff(a, DIFF_VQDMLSL, DT_S16, Q8, vfp.D17, vfp.D31)
	if !wordsAre(a,
			@[]uint32{0xF2810002, 0xF3E100AF, 0xF2920102, 0xF3820302, 0xF2E102AF, 0xF2EEF4AC, 0xF3820404,
					0xF3DEF6AC, 0xF2A20604, 0xF2E105AF, 0xF3910702, 0xF3C108AF, 0xF2910A02, 0xF2C10EAF, 0xF2E10EAF,
					0xF3A10C02, 0xF2D10DAF, 0xF2A10902, 0xF2D10BAF}) {
		return fail("a NEON three-different-lengths operation is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: no such operation; a data type the
// operation has not (VADDL.I8, VADDL.S64, VQDMULL.S8, VQDMULL.U16, VADDHN.I8, VADDHN.S16,
// VMULL.F32, VADDW.P8); registers of other lengths (VADDL on three Q registers, VADDW's wide
// operand a D register, VADDHN's result a Q register).
func TestNeonDiffRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 12)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Diff(bad[0], 0, DT_S8, Q0, vfp.D1, vfp.D2)
	Diff(bad[1], DIFF_VADDL, DT_I8, Q0, vfp.D1, vfp.D2)
	Diff(bad[2], DIFF_VADDL, DT_S64, Q0, vfp.D1, vfp.D2)
	Diff(bad[3], DIFF_VQDMULL, DT_S8, Q0, vfp.D1, vfp.D2)
	Diff(bad[4], DIFF_VQDMULL, DT_U16, Q0, vfp.D1, vfp.D2)
	Diff(bad[5], DIFF_VADDHN, DT_I8, vfp.D0, Q1, Q2)
	Diff(bad[6], DIFF_VADDHN, DT_S16, vfp.D0, Q1, Q2)
	Diff(bad[7], DIFF_VMULL, DT_F32, Q0, vfp.D1, vfp.D2)
	Diff(bad[8], DIFF_VADDW, DT_P8, Q0, Q1, vfp.D2)
	Diff(bad[9], DIFF_VADDL, DT_S8, Q0, Q1, Q2)
	Diff(bad[10], DIFF_VADDW, DT_S8, Q0, vfp.D1, vfp.D2)
	Diff(bad[11], DIFF_VADDHN, DT_I16, Q0, Q1, Q2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON three-different-lengths operation was taken") }
	}
	return ""
}
