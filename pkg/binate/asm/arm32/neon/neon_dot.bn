package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// isS reports whether r is an S register, vfp.S0..S31.
func isS(r int) bool { return r >= vfp.S0 && r <= vfp.S31 }

// placeSN returns S register r (vfp.S0..S31) as an instruction's Vn field [19:16] and N bit [7],
// the register's number as Vn:N.
func placeSN(r int) uint32 {
	var n uint32 = cast(uint32, r - vfp.S0)
	return ((n >> 1) << 16) | ((n & 1) << 7)
}

// placeSM returns S register r (vfp.S0..S31) as an instruction's Vm field [3:0] and M bit [5], the
// register's number as Vm:M.
func placeSM(r int) uint32 {
	var n uint32 = cast(uint32, r - vfp.S0)
	return (n >> 1) | ((n & 1) << 5)
}

// Dot emits VSDOT.S8 (VUDOT.U8 when unsigned) vd, vn, vm: 1111 1100 0D10 nnnn dddd 1101 NQMU
// mmmm, on three D registers (vfp.D0..D31) or three Q registers (Q0..Q15).
func Dot(a @asm.Assembler, unsigned bool, vd int, vn int, vm int) {
	q, ok := neonRegs(a, vd, vn, vm)
	if !ok { return }
	arm32.Emit32(a,
			0xFC200D00 | placeD(vd) | placeN(vn) | placeM(vm) | bitIf(q, 0x40) | bitIf(unsigned, 0x10))
}

// DotLane emits VSDOT.S8 (VUDOT.U8 when unsigned) vd, vn, dm[x]: 1111 1110 0D10 nnnn dddd 1101
// NQMU mmmm, mmmm the D register dm (D0..D15) and M its lane x (0..1), on D registers vd, vn
// (vfp.D0..D31) or Q registers (Q0..Q15).
func DotLane(a @asm.Assembler, unsigned bool, vd int, vn int, dm int, x int) {
	var q bool = isQ(vd) && isQ(vn)
	if !q && (!isD(vd) || !isD(vn)) {
		a.SetError("arm32: VSDOT / VUDOT's registers are two D or two Q registers and a scalar")
		return
	}
	if !isD(dm) || dNum(dm) > 15 || x < 0 || x > 1 {
		a.SetError("arm32: VSDOT / VUDOT's scalar is one of D0..D15 with lane 0..1")
		return
	}
	arm32.Emit32(a,
			0xFE200D00 | placeD(vd) | placeN(vn) | dNum(dm) | (cast(uint32, x) << 5) | bitIf(q, 0x40) |
					bitIf(unsigned, 0x10))
}

// Fmal emits VFMAL.F16 (VFMSL.F16 when sub) vd, vn, vm: 1111 1100 SD10 nnnn dddd 1000 NQM1 mmmm,
// S set for VFMSL, on a D register vd (vfp.D0..D31) and S registers vn, vm (vfp.S0..S31, Vn:N and
// Vm:M), or a Q register vd (Q0..Q15) and D registers vn, vm.
func Fmal(a @asm.Assembler, sub bool, vd int, vn int, vm int) {
	var nm uint32
	if isD(vd) && isS(vn) && isS(vm) {
		nm = placeSN(vn) | placeSM(vm)
	} else if isQ(vd) && isD(vn) && isD(vm) {
		nm = placeN(vn) | placeM(vm) | 0x40
	} else {
		a.SetError("arm32: VFMAL / VFMSL take a D and two S registers, or a Q and two D registers")
		return
	}
	arm32.Emit32(a, 0xFC200810 | bitIf(sub, 0x800000) | placeD(vd) | nm)
}

// FmalLane emits VFMAL.F16 (VFMSL.F16 when sub) vd, vn, vm[x]: 1111 1110 0D0S nnnn dddd 1000 NQM1
// mmmm, S set for VFMSL, on a D register vd (vfp.D0..D31), an S register vn (vfp.S0..S31, Vn:N) and
// the S register vm (S0..S15, Vm<2:0>:M) with lane x (0..1, Vm<3>); or a Q register vd (Q0..Q15), a
// D register vn and the D register vm (D0..D7, Vm<2:0>) with lane x (0..3, M:Vm<3>).
func FmalLane(a @asm.Assembler, sub bool, vd int, vn int, vm int, x int) {
	var nm uint32
	var lane uint32 = cast(uint32, x)
	if isD(vd) && isS(vn) && isS(vm) {
		if vm - vfp.S0 > 15 || x < 0 || x > 1 {
			a.SetError("arm32: VFMAL / VFMSL's S scalar is one of S0..S15 with lane 0..1")
			return
		}
		nm = placeSN(vn) | placeSM(vm) | (lane << 3)
	} else if isQ(vd) && isD(vn) && isD(vm) {
		if dNum(vm) > 7 || x < 0 || x > 3 {
			a.SetError("arm32: VFMAL / VFMSL's D scalar is one of D0..D7 with lane 0..3")
			return
		}
		nm = placeN(vn) | dNum(vm) | ((lane & 1) << 3) | ((lane >> 1) << 5) | 0x40
	} else {
		a.SetError(
				"arm32: VFMAL / VFMSL by a scalar take a D, an S and an S scalar, or a Q, a D and a D one")
		return
	}
	arm32.Emit32(a, 0xFE000810 | bitIf(sub, 0x100000) | placeD(vd) | nm)
}
