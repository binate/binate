package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The dot products as clang assembles them: VSDOT.S8 D0, D1, D2; VUDOT.U8 Q0, Q1, Q2; VSDOT.S8
// D31, D30, D29; VSDOT.S8 Q0, Q1, D2[1]; VSDOT.S8 D0, D1, D15[1]; VUDOT.U8 Q15, Q14, D15[1];
// VUDOT.U8 D0, D1, D2[0].
func TestNeonDot() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Dot(a, false, vfp.D0, vfp.D1, vfp.D2)
	Dot(a, true, Q0, Q1, Q2)
	Dot(a, false, vfp.D31, vfp.D30, vfp.D29)
	DotLane(a, false, Q0, Q1, vfp.D2, 1)
	DotLane(a, false, vfp.D0, vfp.D1, vfp.D15, 1)
	DotLane(a, true, Q15, Q14, vfp.D15, 1)
	DotLane(a, true, vfp.D0, vfp.D1, vfp.D2, 0)
	if !wordsAre(a,
			@[]uint32{0xFC210D02, 0xFC220D54, 0xFC6EFDAD, 0xFE220D62, 0xFE210D2F, 0xFE6CEDFF, 0xFE210D12}) {
		return fail("a NEON dot product is not clang's word")
	}
	return ""
}

// The FP16 multiply-adds long as clang assembles them: VFMAL.F16 D0, S1, S2; VFMAL.F16 Q0, D1, D2;
// VFMSL.F16 D31, S31, S30; VFMSL.F16 Q15, D31, D30; VFMAL.F16 D0, S1, S2[1]; VFMAL.F16 D0, S1,
// S15[1]; VFMAL.F16 D0, S1, S15[0]; VFMAL.F16 Q0, D1, D7[3]; VFMAL.F16 Q0, D1, D7[0]; VFMSL.F16
// Q15, D31, D7[3]; VFMSL.F16 D31, S31, S15[1]; VFMSL.F16 D1, S3, S5[0]; and the lanes whose two
// bits differ, VFMAL.F16 Q0, D1, D2[1]; VFMAL.F16 Q0, D1, D1[2]; VFMSL.F16 Q0, D1, D1[1].
func TestNeonFmal() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Fmal(a, false, vfp.D0, vfp.S1, vfp.S2)
	Fmal(a, false, Q0, vfp.D1, vfp.D2)
	Fmal(a, true, vfp.D31, vfp.S31, vfp.S30)
	Fmal(a, true, Q15, vfp.D31, vfp.D30)
	FmalLane(a, false, vfp.D0, vfp.S1, vfp.S2, 1)
	FmalLane(a, false, vfp.D0, vfp.S1, vfp.S15, 1)
	FmalLane(a, false, vfp.D0, vfp.S1, vfp.S15, 0)
	FmalLane(a, false, Q0, vfp.D1, vfp.D7, 3)
	FmalLane(a, false, Q0, vfp.D1, vfp.D7, 0)
	FmalLane(a, true, Q15, vfp.D31, vfp.D7, 3)
	FmalLane(a, true, vfp.D31, vfp.S31, vfp.S15, 1)
	FmalLane(a, true, vfp.D1, vfp.S3, vfp.S5, 0)
	FmalLane(a, false, Q0, vfp.D1, vfp.D2, 1)
	FmalLane(a, false, Q0, vfp.D1, vfp.D1, 2)
	FmalLane(a, true, Q0, vfp.D1, vfp.D1, 1)
	if !wordsAre(a,
			@[]uint32{0xFC200891, 0xFC210852, 0xFCEFF89F, 0xFCEFE8FE, 0xFE000899, 0xFE0008BF, 0xFE0008B7,
					0xFE01087F, 0xFE010857, 0xFE5FE8FF, 0xFE5FF8BF, 0xFE1118B2, 0xFE01085A, 0xFE010871,
					0xFE110859}) {
		return fail("a NEON FP16 multiply-add long is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: a dot product on mixed or S
// registers, a scalar past D15 or a lane past 1; a multiply-add long on a D and two D registers, a
// Q and two S registers, a scalar past S15 / D7 or a lane past 1 / 3.
func TestNeonDotRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 10)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Dot(bad[0], false, vfp.D0, Q1, vfp.D2)
	Dot(bad[1], false, vfp.S0, vfp.S1, vfp.S2)
	DotLane(bad[2], false, vfp.D0, vfp.D1, vfp.D16, 0)
	DotLane(bad[3], true, Q0, Q1, vfp.D2, 2)
	Fmal(bad[4], false, vfp.D0, vfp.D1, vfp.D2)
	Fmal(bad[5], true, Q0, vfp.S1, vfp.S2)
	FmalLane(bad[6], false, vfp.D0, vfp.S1, vfp.S16, 0)
	FmalLane(bad[7], false, vfp.D0, vfp.S1, vfp.S2, 2)
	FmalLane(bad[8], false, Q0, vfp.D1, vfp.D8, 0)
	FmalLane(bad[9], true, Q0, vfp.D1, vfp.D2, 4)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON dot product or multiply-add long was taken") }
	}
	return ""
}
