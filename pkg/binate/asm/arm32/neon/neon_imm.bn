package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// modImmFields returns the cmode and the 8-bit immediate operation op (IMM_*) of data type dt
// encodes value with, or ok false for none: I8 0..255; I16 0x00NN or 0xNN00; I32 one byte of the
// four (and, for VMOV and VMVN, 0x0000NNFF or 0x00NNFFFF); I64 each byte 0x00 or 0xFF; F32 the bits
// of a value an 8-bit floating-point immediate encodes.  VORR's and VBIC's cmode is VMOV's plus 1.
func modImmFields(op int, dt int, value uint64) (uint32, uint32, bool) {
	var orr uint32 = bitIf(op == IMM_VORR || op == IMM_VBIC, 1)
	var mov bool = op == IMM_VMOV
	if dt == DT_I8 && mov && value <= 255 { return 14, cast(uint32, value), true }
	if dt == DT_I16 && value <= 0xFFFF {
		if value & 0xFF00 == 0 { return 8 | orr, cast(uint32, value), true }
		if value & 0xFF == 0 { return 10 | orr, cast(uint32, value >> 8), true }
	}
	if dt == DT_I32 && value <= 0xFFFFFFFF {
		for s := 0; s < 4; s++ {
			var byteMask uint64 = cast(uint64, 0xFF) << cast(uint, 8 * s)
			if value & ~byteMask == 0 {
				return cast(uint32, 2 * s) | orr, cast(uint32, value >> cast(uint, 8 * s)) & 0xFF, true
			}
		}
		if orr == 0 && value & 0xFFFF00FF == 0xFF { return 12, cast(uint32, value >> 8) & 0xFF, true }
		if orr == 0 && value & 0xFF00FFFF == 0xFFFF { return 13, cast(uint32, value >> 16) & 0xFF, true }
	}
	if dt == DT_I64 && mov {
		var imm8 uint32 = 0
		for i := 0; i < 8; i++ {
			var b uint64 = (value >> cast(uint, 8 * i)) & 0xFF
			if b != 0 && b != 0xFF { return 0, 0, false }
			if b == 0xFF { imm8 = imm8 | (cast(uint32, 1) << cast(uint, i)) }
		}
		return 14, imm8, true
	}
	if dt == DT_F32 && mov && value <= 0xFFFFFFFF {
		// a:NOT(b):bbbbb:cdefgh and 19 zero bits.
		var bits uint32 = cast(uint32, value)
		var b uint32 = (bits >> 25) & 1
		var high uint32 = (bits >> 25) & 0x3F
		var ok bool = bits & 0x7FFFF == 0 && (high == 0x1F || high == 0x20) && (high >> 5) != b
		if ok { return 15, ((bits >> 31) << 7) | (b << 6) | ((bits >> 19) & 0x3F), true }
	}
	return 0, 0, false
}

// ModImm emits the NEON instruction op (IMM_*) of data type dt (DT_*) on D register vd
// (vfp.D0..D31) or Q register (Q0..Q15) with the immediate value (an element's bits, all 64 for
// I64).
func ModImm(a @asm.Assembler, op int, dt int, vd int, value uint64) {
	if op < IMM_VMOV || op > IMM_VBIC {
		a.SetError("arm32: no such NEON operation")
		return
	}
	if !isD(vd) && !isQ(vd) {
		a.SetError("arm32: a NEON instruction's register is one of D0..D31 or Q0..Q15")
		return
	}
	cmode, imm8, ok := modImmFields(op, dt, value)
	if !ok {
		a.SetError("arm32: the NEON operation has no encoding of that immediate and data type")
		return
	}
	var opBit uint32 = bitIf(op == IMM_VMVN || op == IMM_VBIC || dt == DT_I64, 0x20)
	arm32.Emit32(a,
			0xF2800010 | ((imm8 >> 7) << 24) | (((imm8 >> 4) & 7) << 16) | placeD(vd) | (cmode << 8) |
					bitIf(isQ(vd), 0x40) | opBit | (imm8 & 15))
}
