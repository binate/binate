package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The modified immediates as clang assembles them: VMOV.I8 #0xAB; VMOV.I16 #0xAB and #0xAB00;
// VMOV.I32 #0xAB, #0xAB00, #0xAB0000, #0xAB000000, #0xABFF and #0xABFFFF; VMOV.I64
// #0xFF00FF00FF00FF00; VMOV.F32 #1.0 and #-3.0; VMVN.I16 #0xAB00; VMVN.I32 #0xABFFFF; VORR.I16
// #0xAB; VORR.I32 #0xAB000000; VBIC.I16 #0xAB00; VBIC.I32 #0xAB0000 (on D0); VMOV.I32 Q0, #0xAB;
// VMOV.I8 Q0, #0xAB; VMOV.I32 D31 and Q15, #0xFF; VMOV.I32 #0 and VMOV.I64 #0 (on D0).
func TestNeonModImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var d0 int = vfp.D0
	ModImm(a, IMM_VMOV, DT_I8, d0, 0xAB)
	ModImm(a, IMM_VMOV, DT_I16, d0, 0xAB)
	ModImm(a, IMM_VMOV, DT_I16, d0, 0xAB00)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0xAB)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0xAB00)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0xAB0000)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0xAB000000)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0xABFF)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0xABFFFF)
	ModImm(a, IMM_VMOV, DT_I64, d0, 0xFF00FF00FF00FF00)
	ModImm(a, IMM_VMOV, DT_F32, d0, 0x3F800000)
	ModImm(a, IMM_VMOV, DT_F32, d0, 0xC0400000)
	ModImm(a, IMM_VMVN, DT_I16, d0, 0xAB00)
	ModImm(a, IMM_VMVN, DT_I32, d0, 0xABFFFF)
	ModImm(a, IMM_VORR, DT_I16, d0, 0xAB)
	ModImm(a, IMM_VORR, DT_I32, d0, 0xAB000000)
	ModImm(a, IMM_VBIC, DT_I16, d0, 0xAB00)
	ModImm(a, IMM_VBIC, DT_I32, d0, 0xAB0000)
	ModImm(a, IMM_VMOV, DT_I32, Q0, 0xAB)
	ModImm(a, IMM_VMOV, DT_I8, Q0, 0xAB)
	ModImm(a, IMM_VMOV, DT_I32, vfp.D31, 0xFF)
	ModImm(a, IMM_VMOV, DT_I32, Q15, 0xFF)
	ModImm(a, IMM_VMOV, DT_I32, d0, 0)
	ModImm(a, IMM_VMOV, DT_I64, d0, 0)
	if !wordsAre(a,
			@[]uint32{0xF3820E1B, 0xF382081B, 0xF3820A1B, 0xF382001B, 0xF382021B, 0xF382041B, 0xF382061B,
					0xF3820C1B, 0xF3820D1B, 0xF3820E3A, 0xF2870F10, 0xF3800F18, 0xF3820A3B, 0xF3820D3B, 0xF382091B,
					0xF382071B, 0xF3820B3B, 0xF382053B, 0xF382005B, 0xF3820E5B, 0xF3C7F01F, 0xF3C7E05F, 0xF2800010,
					0xF2800E30}) {
		return fail("a NEON modified immediate is not clang's word")
	}
	return ""
}

// A modified immediate there is no encoding of is an error that emits nothing: a value the data
// type's forms do not hold (I8 256, I16 0x1FF and 0x10000, I32 0x1FF00 and 2^32, I64 0xAB, F32
// 0.1 and a value past 32 bits), VORR's and VBIC's ones-filled I32 (#0xABFF), VORR and VBIC of a
// data type other than I16 and I32, VMVN.I8, VMVN.F32, an S register, no such operation.
func TestNeonModImmRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 16)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	var d0 int = vfp.D0
	ModImm(bad[0], IMM_VMOV, DT_I8, d0, 256)
	ModImm(bad[1], IMM_VMOV, DT_I16, d0, 0x1FF)
	ModImm(bad[2], IMM_VMOV, DT_I16, d0, 0x10000)
	ModImm(bad[3], IMM_VMOV, DT_I32, d0, 0x1FF00)
	ModImm(bad[4], IMM_VMOV, DT_I32, d0, 0x100000000)
	ModImm(bad[5], IMM_VMOV, DT_I64, d0, 0xAB)
	ModImm(bad[6], IMM_VMOV, DT_F32, d0, 0x3DCCCCCD)
	ModImm(bad[7], IMM_VORR, DT_I32, d0, 0xABFF)
	ModImm(bad[8], IMM_VORR, DT_I8, d0, 0xAB)
	ModImm(bad[9], IMM_VBIC, DT_I64, d0, 0)
	ModImm(bad[10], IMM_VMVN, DT_I8, d0, 0xAB)
	ModImm(bad[11], IMM_VMVN, DT_F32, d0, 0x3F800000)
	ModImm(bad[12], IMM_VMOV, DT_I8, vfp.S0, 0xAB)
	ModImm(bad[13], 99, DT_I8, d0, 0xAB)
	ModImm(bad[14], IMM_VBIC, DT_I32, d0, 0xABFF)
	ModImm(bad[15], IMM_VMOV, DT_F32, d0, 0x13F800000)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON modified immediate was taken") }
	}
	return ""
}
