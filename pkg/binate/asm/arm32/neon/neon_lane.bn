package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// laneBits returns lane x of a size-bit element (8 or 16) as the opc1 [22:21] and opc2 [6:5] fields
// of a move between a core register and a lane -- 1x:xx for 8, 0x:x1 for 16 -- setting the error
// for another size or a lane past the D register's.
func laneBits(a @asm.Assembler, size int, x int) (uint32, bool) {
	if size != 8 && size != 16 {
		a.SetError("arm32: a NEON lane move's element is 8 or 16 bits")
		return 0, false
	}
	if x < 0 || x >= 64 / size {
		a.SetError("arm32: a D register's lane is 0..7 for 8-bit elements, 0..3 for 16-bit ones")
		return 0, false
	}
	var u uint32 = cast(uint32, x)
	if size == 8 { return 0x400000 | ((u >> 2) << 21) | ((u & 3) << 5), true }
	return ((u >> 1) << 21) | ((u & 1) << 6) | 0x20, true
}

// laneMove emits the lane move base (cccc 1110 U..L dddd tttt 1011 D..1 0000) of D register d's
// lane x of size bits and core register rt under cond.
func laneMove(a @asm.Assembler, cond int, base uint32, size int, d int, x int, rt int) {
	if !arm32.CondOk(a, cond) || !arm32.RegOk(a, rt, false) { return }
	if !isD(d) {
		a.SetError("arm32: a NEON lane move's register is D0..D31")
		return
	}
	bits, ok := laneBits(a, size, x)
	if !ok { return }
	arm32.Emit32(a, (cast(uint32, cond) << 28) | base | bits | (cast(uint32, rt) << 12) | placeN(d))
}

// VmovToLane emits VMOV{cond}.<size> Dd[x], Rt: cccc 1110 0ii0 dddd tttt 1011 Dii1 0000, size 8
// (x 0..7) or 16 (x 0..3) -- the 32-bit lane's is vfp.VmovCoreToLane.  Rt is R0..R15.
func VmovToLane(a @asm.Assembler, cond int, size int, dd int, x int, rt int) {
	laneMove(a, cond, 0x0E000B10, size, dd, x, rt)
}

// VmovFromLane emits VMOV{cond}.<S|U><size> Rt, Dn[x]: cccc 1110 Uii1 nnnn tttt 1011 Nii1 0000, U
// set for unsigned, size 8 (x 0..7) or 16 (x 0..3) -- the 32-bit lane's is vfp.VmovLaneToCore.  Rt
// is R0..R15.
func VmovFromLane(a @asm.Assembler, cond int, size int, unsigned bool, rt int, dn int, x int) {
	laneMove(a, cond, 0x0E100B10 | bitIf(unsigned, 0x800000), size, dn, x, rt)
}
