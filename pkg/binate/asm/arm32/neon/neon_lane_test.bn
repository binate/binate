package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The 8- and 16-bit lane moves as clang assembles them: VMOV.8 D0[7], PC; VMOV.S8 PC, D31[7];
// VMOV.U16 SP, D17[3]; VMOV.16 D17[3], SP; VMOV.8 D0[5], R3; VMOV.U8 R3, D0[5]; VMOV.S16 R3,
// D0[2]; VMOV.16 D0[2], R3; VMOVEQ.8 D0[1], R0; VMOVGT.U16 R1, D2[1]; VMOV.S16 LR, D31[0];
// VMOV.8 D16[0], R12.
func TestNeonLane() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var al int = arm32.COND_AL
	VmovToLane(a, al, 8, vfp.D0, 7, arm32.PC)
	VmovFromLane(a, al, 8, false, arm32.PC, vfp.D31, 7)
	VmovFromLane(a, al, 16, true, arm32.SP, vfp.D17, 3)
	VmovToLane(a, al, 16, vfp.D17, 3, arm32.SP)
	VmovToLane(a, al, 8, vfp.D0, 5, arm32.R3)
	VmovFromLane(a, al, 8, true, arm32.R3, vfp.D0, 5)
	VmovFromLane(a, al, 16, false, arm32.R3, vfp.D0, 2)
	VmovToLane(a, al, 16, vfp.D0, 2, arm32.R3)
	VmovToLane(a, arm32.COND_EQ, 8, vfp.D0, 1, arm32.R0)
	VmovFromLane(a, arm32.COND_GT, 16, true, arm32.R1, vfp.D2, 1)
	VmovFromLane(a, al, 16, false, arm32.LR, vfp.D31, 0)
	VmovToLane(a, al, 8, vfp.D16, 0, arm32.R12)
	if !wordsAre(a,
			@[]uint32{0xEE60FB70, 0xEE7FFBF0, 0xEEB1DBF0, 0xEE21DBF0, 0xEE603B30, 0xEEF03B30, 0xEE303B30,
					0xEE203B30, 0x0E400B30, 0xCE921B70, 0xEE1FEBB0, 0xEE40CB90}) {
		return fail("a NEON lane move is not clang's word")
	}
	return ""
}

// A lane move there is no encoding of is an error that emits nothing: a 32-bit or 4-bit element,
// a lane past the D register's (8 for 8-bit elements, 4 for 16-bit ones, -1), a Q or S register,
// no such condition, no such core register.
func TestNeonLaneRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 10)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	var al int = arm32.COND_AL
	VmovToLane(bad[0], al, 32, vfp.D0, 0, arm32.R0)
	VmovFromLane(bad[1], al, 4, false, arm32.R0, vfp.D0, 0)
	VmovToLane(bad[2], al, 8, vfp.D0, 8, arm32.R0)
	VmovFromLane(bad[3], al, 16, true, arm32.R0, vfp.D0, 4)
	VmovToLane(bad[4], al, 16, vfp.D0, -1, arm32.R0)
	VmovToLane(bad[5], al, 8, Q0, 0, arm32.R0)
	VmovFromLane(bad[6], al, 8, false, arm32.R0, vfp.S0, 0)
	VmovToLane(bad[7], 16, 8, vfp.D0, 0, arm32.R0)
	VmovFromLane(bad[8], al, 16, false, 16, vfp.D0, 0)
	VmovToLane(bad[9], al, 16, vfp.D0, 0, -1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON lane move was taken") }
	}
	return ""
}
