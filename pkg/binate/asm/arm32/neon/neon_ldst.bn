package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// ldstTail returns the Rn and Rm fields of a load or store's address, rn (R0..R14) and post
// (LDST_PLAIN, LDST_WB, or a register post-index, R0..R12 or R14), setting the error for another.
func ldstTail(a @asm.Assembler, rn int, post int) (uint32, bool) {
	if rn < 0 || rn > 14 {
		a.SetError("arm32: a NEON load's or store's base register is R0..R14")
		return 0, false
	}
	var rm int = post
	if post == LDST_PLAIN {
		rm = 15
	} else if post == LDST_WB {
		rm = 13
	} else if post < 0 || post > 14 || post == 13 {
		a.SetError("arm32: a NEON load's or store's post-index register is R0..R12 or R14")
		return 0, false
	}
	return (cast(uint32, rn) << 16) | cast(uint32, rm), true
}

// ldstRegs reports whether the registers dd, then each step on, count of them, are D0..D31,
// setting the error if not.
func ldstRegs(a @asm.Assembler, dd int, count int, step int) bool {
	if !isD(dd) || dd - vfp.D0 + (count - 1) * step > 31 {
		a.SetError("arm32: a NEON load's or store's registers are within D0..D31")
		return false
	}
	return true
}

// ldstAlign returns the bits the alignment align (in bits, 0 for none) takes among choices (the
// alignments a form allows, the first 0, each the next value of the field), setting the error for
// another.
func ldstAlign(a @asm.Assembler, align int, choices @[]int) (uint32, bool) {
	for i := 0; i < len(choices); i++ {
		if choices[i] == align { return cast(uint32, i), true }
	}
	a.SetError("arm32: a NEON load's or store's alignment is not one its form takes")
	return 0, false
}

// Elems emits VLD<n> (load) or VST<n> of multiple structures: 1111 0100 0DL0 nnnn dddd tttt ssaa
// mmmm, the type tttt from n and the registers -- VLD1 / VST1 1, 2, 3 or 4 registers (0111, 1010,
// 0110, 0010), VLD2 / VST2 2 (1000, every other one 1001) or 4 (0011), VLD3 / VST3 3 (0100, 0101),
// VLD4 / VST4 4 (0000, 0001) -- size 8, 16, 32 or (n 1) 64, the alignment (in bits, 0 for none: 64
// with 1 or 3 registers; 64 or 128 with 2; 64, 128 or 256 with 4), dd D0..D31 (vfp's) with the list
// within them, and the address [rn], [rn]! or [rn], rm (post; rn R0..R14).
func Elems(a @asm.Assembler, load bool, n int, size int, dd int, regs int, spaced bool, rn int,
		align int, post int) {
	var types @[]uint32 = @[]uint32{7, 10, 6, 2}
	var tttt uint32 = 0
	var choices @[]int = @[]int{0, 64, 128, 256}
	if n == 1 && regs >= 1 && regs <= 4 && !spaced {
		tttt = types[regs - 1]
		if regs == 1 || regs == 3 { choices = @[]int{0, 64} }
		if regs == 2 { choices = @[]int{0, 64, 128} }
	} else if n == 2 && regs == 2 {
		tttt = 8 | bitIf(spaced, 1)
		choices = @[]int{0, 64, 128}
	} else if n == 2 && regs == 4 && !spaced {
		tttt = 3
	} else if n == 3 && regs == 3 {
		tttt = 4 | bitIf(spaced, 1)
		choices = @[]int{0, 64}
	} else if n == 4 && regs == 4 {
		tttt = bitIf(spaced, 1)
	} else {
		a.SetError("arm32: VLD<n> / VST<n> of multiple structures has not these registers")
		return
	}
	var ss uint32 = 0
	if size == 16 { ss = 1 }
	if size == 32 { ss = 2 }
	if size == 64 && n == 1 { ss = 3 }
	if ss == 0 && size != 8 {
		a.SetError("arm32: VLD<n> / VST<n> of multiple structures has not this element size")
		return
	}
	var step int = 1
	if spaced { step = 2 }
	if !ldstRegs(a, dd, regs, step) { return }
	aa, okA := ldstAlign(a, align, choices)
	if !okA { return }
	tail, okT := ldstTail(a, rn, post)
	if !okT { return }
	arm32.Emit32(a,
			0xF4000000 | bitIf(load, 0x200000) | placeD(dd) | tail | (tttt << 8) | (ss << 6) | (aa << 4))
}

// ElemLane emits VLD<n> (load) or VST<n> of one lane: 1111 0100 1DL0 nnnn dddd ssNN iiii mmmm, NN
// n - 1, iiii the lane, spaced (every other register; not for 8-bit elements nor VLD1) and the
// alignment as n and the size place them -- VLD1 8 none, 16 16, 32 32; VLD2 8 16, 16 32, 32 64;
// VLD3 none; VLD4 8 32, 16 64, 32 64 or 128 -- size 8, 16 or 32, the lane 0..7, 0..3 or 0..1, dd
// D0..D31 (vfp's) with the list within them, the address [rn], [rn]! or [rn], rm (post; rn
// R0..R14).
func ElemLane(a @asm.Assembler, load bool, n int, size int, dd int, spaced bool, lane int, rn int,
		align int, post int) {
	var okSize bool = size == 8 || size == 16 || size == 32
	if !okSize || n < 1 || n > 4 || lane < 0 || lane >= 64 / size ||
			(spaced && (n == 1 || size == 8)) {
		a.SetError("arm32: VLD<n> / VST<n> of one lane has not this element size, lane or spacing")
		return
	}
	var step int = 1
	if spaced { step = 2 }
	if !ldstRegs(a, dd, n, step) { return }
	var x uint32 = cast(uint32, lane)
	var ia uint32 = x << 1
	if size == 16 { ia = (x << 2) | bitIf(spaced, 2) }
	if size == 32 { ia = (x << 3) | bitIf(spaced, 4) }
	var unit int = size * n
	var choices @[]int = @[]int{0, unit}
	if n == 1 && size == 8 { choices = @[]int{0} }
	if n == 3 { choices = @[]int{0} }
	if n == 4 && size == 8 { choices = @[]int{0, 32} }
	if n == 4 && size != 8 { choices = @[]int{0, 64} }
	if n == 4 && size == 32 { choices = @[]int{0, 64, 128} }
	aa, okA := ldstAlign(a, align, choices)
	if !okA { return }
	if n == 1 && size == 32 && aa == 1 { aa = 3 }
	tail, okT := ldstTail(a, rn, post)
	if !okT { return }
	var ss uint32 = cast(uint32, size / 16)
	arm32.Emit32(a,
			0xF4800000 | bitIf(load, 0x200000) | placeD(dd) | tail | (ss << 10) |
					(cast(uint32, n - 1) << 8) | ((ia | aa) << 4))
}

// ElemDup emits VLD<n> to all lanes: 1111 0100 1D10 nnnn dddd 11NN ssTa mmmm, NN n - 1, T the
// registers less one for VLD1 (1 or 2, not spaced) and spacing for the rest (regs n), a the
// alignment -- VLD1 8 none, 16 16, 32 32; VLD2 8 16, 16 32, 32 64; VLD3 none; VLD4 8 32, 16 64, 32
// 64 or 128 (ss 11) -- size 8, 16 or 32, dd D0..D31 (vfp's) with the list within them, the address
// [rn], [rn]! or [rn], rm (post; rn R0..R14).
func ElemDup(a @asm.Assembler, n int, size int, dd int, regs int, spaced bool, rn int, align int,
		post int) {
	var badRegs bool = (n == 1 && (regs < 1 || regs > 2 || spaced)) || (n > 1 && regs != n)
	if (size != 8 && size != 16 && size != 32) || n < 1 || n > 4 || badRegs {
		a.SetError("arm32: VLD<n> to all lanes has not this element size or these registers")
		return
	}
	var step int = 1
	if spaced { step = 2 }
	if !ldstRegs(a, dd, regs, step) { return }
	var t bool = (n == 1 && regs == 2) || (n > 1 && spaced)
	var choices @[]int = @[]int{0, size * n}
	if n == 1 && size == 8 { choices = @[]int{0} }
	if n == 3 { choices = @[]int{0} }
	if n == 4 && size == 8 { choices = @[]int{0, 32} }
	if n == 4 && size != 8 { choices = @[]int{0, 64} }
	var ss uint32 = cast(uint32, size / 16)
	if n == 4 && size == 32 && align == 128 {
		ss = 3
		align = 64
	}
	aa, okA := ldstAlign(a, align, choices)
	if !okA { return }
	tail, okT := ldstTail(a, rn, post)
	if !okT { return }
	arm32.Emit32(a,
			0xF4A00C00 | placeD(dd) | tail | (cast(uint32, n - 1) << 8) | (ss << 6) | bitIf(t, 0x20) |
					(aa << 4))
}
