package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// NEON's element and structure loads and stores as clang assembles them: VLD1.8 {D0}, [R0]; VLD1.16
// {D0, D1}, [R0]; VLD1.32 {D0-D2}, [R0]; VLD1.64 {D0-D3}, [R0]; VLD1.8 {D0}, [R0:64]; VLD1.8 {D0,
// D1}, [R0:128]; VLD1.8 {D0-D3}, [R0:256]; VLD1.8 {D0}, [R0]!; VLD1.8 {D0}, [R0], R1; VLD1.8 {D31},
// [R14], R12; VST1.8 {D0}, [R0]; VST1.32 {D16-D19}, [R0:128]!; VLD2.8 {D0, D1}, [R0]; VLD2.16 {D0,
// D2}, [R0]; VLD2.32 {D0-D3}, [R0:256]; VST2.8 {D0, D1}, [R0]; VLD3.8 {D0-D2}, [R0]; VLD3.16 {D0,
// D2, D4}, [R0:64]; VST3.32 {D0-D2}, [R0]!; VLD4.8 {D0-D3}, [R0]; VLD4.16 {D0, D2, D4, D6},
// [R0:256]; VST4.32 {D0-D3}, [R0], R2; VLD1.8 {D0[3]}, [R0]; VLD1.16 {D0[2]}, [R0:16]; VLD1.32
// {D0[1]}, [R0:32]; VST1.32 {D31[1]}, [R0]!; VLD2.8 {D0[1], D1[1]}, [R0:16]; VLD2.16 {D0[1],
// D2[1]}, [R0]; VLD2.32 {D0[1], D1[1]}, [R0:64]; VLD3.8 {D0[1], D1[1], D2[1]}, [R0]; VLD3.16
// {D0[1], D2[1], D4[1]}, [R0]; VLD4.8 {D0[1], D1[1], D2[1], D3[1]}, [R0:32]; VLD4.32 {D0[1], D2[1],
// D4[1], D6[1]}, [R0:128]; VST4.16 {D0[3], D1[3], D2[3], D3[3]}, [R0:64]; VLD1.8 {D0[]}, [R0];
// VLD1.16 {D0[], D1[]}, [R0:16]; VLD1.32 {D0[]}, [R0:32]!; VLD2.8 {D0[], D1[]}, [R0:16]; VLD2.16
// {D0[], D2[]}, [R0]; VLD3.8 {D0[], D1[], D2[]}, [R0]; VLD3.32 {D0[], D2[], D4[]}, [R0], R3; VLD4.8
// {D0[], D1[], D2[], D3[]}, [R0:32]; VLD4.32 {D0[], D2[], D4[], D6[]}, [R0:128]; VLD4.16 {D0[],
// D1[], D2[], D3[]}, [R0:64].
func TestNeonLdst() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Elems(a, true, 1, 8, vfp.D0, 1, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 1, 16, vfp.D0, 2, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 1, 32, vfp.D0, 3, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 1, 64, vfp.D0, 4, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 1, 8, vfp.D0, 1, false, 0, 64, LDST_PLAIN)
	Elems(a, true, 1, 8, vfp.D0, 2, false, 0, 128, LDST_PLAIN)
	Elems(a, true, 1, 8, vfp.D0, 4, false, 0, 256, LDST_PLAIN)
	Elems(a, true, 1, 8, vfp.D0, 1, false, 0, 0, LDST_WB)
	Elems(a, true, 1, 8, vfp.D0, 1, false, 0, 0, arm32.R1)
	Elems(a, true, 1, 8, vfp.D31, 1, false, 14, 0, arm32.R12)
	Elems(a, false, 1, 8, vfp.D0, 1, false, 0, 0, LDST_PLAIN)
	Elems(a, false, 1, 32, vfp.D16, 4, false, 0, 128, LDST_WB)
	Elems(a, true, 2, 8, vfp.D0, 2, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 2, 16, vfp.D0, 2, true, 0, 0, LDST_PLAIN)
	Elems(a, true, 2, 32, vfp.D0, 4, false, 0, 256, LDST_PLAIN)
	Elems(a, false, 2, 8, vfp.D0, 2, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 3, 8, vfp.D0, 3, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 3, 16, vfp.D0, 3, true, 0, 64, LDST_PLAIN)
	Elems(a, false, 3, 32, vfp.D0, 3, false, 0, 0, LDST_WB)
	Elems(a, true, 4, 8, vfp.D0, 4, false, 0, 0, LDST_PLAIN)
	Elems(a, true, 4, 16, vfp.D0, 4, true, 0, 256, LDST_PLAIN)
	Elems(a, false, 4, 32, vfp.D0, 4, false, 0, 0, arm32.R2)
	ElemLane(a, true, 1, 8, vfp.D0, false, 3, 0, 0, LDST_PLAIN)
	ElemLane(a, true, 1, 16, vfp.D0, false, 2, 0, 16, LDST_PLAIN)
	ElemLane(a, true, 1, 32, vfp.D0, false, 1, 0, 32, LDST_PLAIN)
	ElemLane(a, false, 1, 32, vfp.D31, false, 1, 0, 0, LDST_WB)
	ElemLane(a, true, 2, 8, vfp.D0, false, 1, 0, 16, LDST_PLAIN)
	ElemLane(a, true, 2, 16, vfp.D0, true, 1, 0, 0, LDST_PLAIN)
	ElemLane(a, true, 2, 32, vfp.D0, false, 1, 0, 64, LDST_PLAIN)
	ElemLane(a, true, 3, 8, vfp.D0, false, 1, 0, 0, LDST_PLAIN)
	ElemLane(a, true, 3, 16, vfp.D0, true, 1, 0, 0, LDST_PLAIN)
	ElemLane(a, true, 4, 8, vfp.D0, false, 1, 0, 32, LDST_PLAIN)
	ElemLane(a, true, 4, 32, vfp.D0, true, 1, 0, 128, LDST_PLAIN)
	ElemLane(a, false, 4, 16, vfp.D0, false, 3, 0, 64, LDST_PLAIN)
	ElemDup(a, 1, 8, vfp.D0, 1, false, 0, 0, LDST_PLAIN)
	ElemDup(a, 1, 16, vfp.D0, 2, false, 0, 16, LDST_PLAIN)
	ElemDup(a, 1, 32, vfp.D0, 1, false, 0, 32, LDST_WB)
	ElemDup(a, 2, 8, vfp.D0, 2, false, 0, 16, LDST_PLAIN)
	ElemDup(a, 2, 16, vfp.D0, 2, true, 0, 0, LDST_PLAIN)
	ElemDup(a, 3, 8, vfp.D0, 3, false, 0, 0, LDST_PLAIN)
	ElemDup(a, 3, 32, vfp.D0, 3, true, 0, 0, arm32.R3)
	ElemDup(a, 4, 8, vfp.D0, 4, false, 0, 32, LDST_PLAIN)
	ElemDup(a, 4, 32, vfp.D0, 4, true, 0, 128, LDST_PLAIN)
	ElemDup(a, 4, 16, vfp.D0, 4, false, 0, 64, LDST_PLAIN)
	ElemDup(a, 4, 32, vfp.D0, 4, false, 0, 64, LDST_PLAIN)
	ElemDup(a, 2, 32, vfp.D17, 2, true, 5, 64, arm32.R6)
	ElemLane(a, false, 2, 16, vfp.D16, true, 2, 1, 32, arm32.R9)
	ElemLane(a, true, 4, 32, vfp.D0, false, 1, 0, 64, LDST_PLAIN)
	Elems(a, true, 2, 8, vfp.D0, 2, true, 0, 128, LDST_PLAIN)
	if !wordsAre(a,
			@[]uint32{0xF420070F, 0xF4200A4F, 0xF420068F, 0xF42002CF, 0xF420071F, 0xF4200A2F, 0xF420023F,
					0xF420070D, 0xF4200701, 0xF46EF70C, 0xF400070F, 0xF44002AD, 0xF420080F, 0xF420094F, 0xF42003BF,
					0xF400080F, 0xF420040F, 0xF420055F, 0xF400048D, 0xF420000F, 0xF420017F, 0xF4000082, 0xF4A0006F,
					0xF4A0049F, 0xF4A008BF, 0xF4C0F88D, 0xF4A0013F, 0xF4A0056F, 0xF4A0099F, 0xF4A0022F, 0xF4A0066F,
					0xF4A0033F, 0xF4A00BEF, 0xF48007DF, 0xF4A00C0F, 0xF4A00C7F, 0xF4A00C9D, 0xF4A00D1F, 0xF4A00D6F,
					0xF4A00E0F, 0xF4A00EA3, 0xF4A00F1F, 0xF4A00FFF, 0xF4A00F5F, 0xF4A00F9F, 0xF4E51DB6, 0xF4C105B9,
					0xF4A00B9F, 0xF420092F}) {
		return fail("a NEON load or store is not clang's word")
	}
	return ""
}

// A load or store there is no encoding of is an error that emits nothing (each case named by its
// index): multiple structures -- VLD2 of 64-bit elements, three registers for VLD2, a list past
// D31, alignment 128 for one register, 256 for VLD3, PC as the base, SP and PC as the post-index
// register, 256 for VLD2 of two registers and VLD1 of two, 128 for VLD1 of three and VLD3, spaced
// VLD1 and spaced VLD2 of four, VLD4 of 64-bit elements, n 0 and 5, size 0; one lane -- a lane past
// the register's, spacing for 8-bit elements and for VLD1, alignment for VLD3's, 32 for VLD1.16's,
// a list past D31, lane -1, 64 for VLD4.8, 256 for VLD4.32, size 64 and 0, PC as the base, SP as
// the post-index; all lanes -- three registers for VLD1, alignment for VLD1.8 or VLD3, 128 for
// VLD4.16 and VLD4.8, 256 for VLD4.32, size 64 and 0, two registers for VLD3, spaced VLD1, a list
// past D31, PC as the post-index.
func TestNeonLdstRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 48)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	var d0 int = vfp.D0
	var none int = LDST_PLAIN
	Elems(bad[0], true, 2, 64, d0, 2, false, 0, 0, none)
	Elems(bad[1], true, 2, 8, d0, 3, false, 0, 0, none)
	Elems(bad[2], true, 1, 8, vfp.D30, 3, false, 0, 0, none)
	Elems(bad[3], true, 1, 8, d0, 1, false, 0, 128, none)
	Elems(bad[4], true, 3, 8, d0, 3, false, 0, 256, none)
	Elems(bad[5], true, 1, 8, d0, 1, false, arm32.PC, 0, none)
	Elems(bad[6], true, 1, 8, d0, 1, false, 0, 0, arm32.SP)
	Elems(bad[7], true, 1, 8, d0, 1, false, 0, 0, arm32.PC)
	Elems(bad[8], true, 2, 8, d0, 2, false, 0, 256, none)
	Elems(bad[9], true, 1, 8, d0, 2, false, 0, 256, none)
	Elems(bad[10], true, 1, 8, d0, 3, false, 0, 128, none)
	Elems(bad[11], true, 3, 8, d0, 3, false, 0, 128, none)
	Elems(bad[12], true, 1, 8, d0, 2, true, 0, 0, none)
	Elems(bad[13], true, 2, 8, d0, 4, true, 0, 0, none)
	Elems(bad[14], true, 4, 64, d0, 4, false, 0, 0, none)
	Elems(bad[15], true, 0, 8, d0, 1, false, 0, 0, none)
	Elems(bad[16], true, 5, 8, d0, 4, false, 0, 0, none)
	Elems(bad[17], true, 1, 0, d0, 1, false, 0, 0, none)
	ElemLane(bad[18], true, 1, 8, d0, false, 8, 0, 0, none)
	ElemLane(bad[19], true, 2, 8, d0, true, 1, 0, 0, none)
	ElemLane(bad[20], true, 1, 16, d0, true, 1, 0, 0, none)
	ElemLane(bad[21], true, 3, 16, d0, false, 1, 0, 64, none)
	ElemLane(bad[22], true, 1, 16, d0, false, 1, 0, 32, none)
	ElemLane(bad[23], true, 4, 16, vfp.D26, true, 1, 0, 0, none)
	ElemLane(bad[24], true, 1, 8, d0, false, -1, 0, 0, none)
	ElemLane(bad[25], true, 4, 8, d0, false, 1, 0, 64, none)
	ElemLane(bad[26], true, 4, 32, d0, false, 1, 0, 256, none)
	ElemLane(bad[27], true, 1, 64, d0, false, 0, 0, 0, none)
	ElemLane(bad[28], true, 1, 0, d0, false, 0, 0, 0, none)
	ElemLane(bad[29], true, 1, 8, d0, false, 0, arm32.PC, 0, none)
	ElemLane(bad[30], true, 1, 8, d0, false, 0, 0, 0, arm32.SP)
	ElemDup(bad[31], 1, 8, d0, 3, false, 0, 0, none)
	ElemDup(bad[32], 1, 8, d0, 1, false, 0, 8, none)
	ElemDup(bad[33], 3, 8, d0, 3, false, 0, 32, none)
	ElemDup(bad[34], 4, 16, d0, 4, false, 0, 128, none)
	ElemDup(bad[35], 4, 8, d0, 4, false, 0, 128, none)
	ElemDup(bad[36], 4, 32, d0, 4, false, 0, 256, none)
	ElemDup(bad[37], 1, 64, d0, 1, false, 0, 0, none)
	ElemDup(bad[38], 1, 0, d0, 1, false, 0, 0, none)
	ElemDup(bad[39], 3, 8, d0, 2, false, 0, 0, none)
	ElemDup(bad[40], 1, 8, d0, 2, true, 0, 0, none)
	ElemDup(bad[41], 2, 8, vfp.D30, 2, true, 0, 0, none)
	ElemDup(bad[42], 1, 8, d0, 1, false, 0, 0, arm32.PC)
	ElemDup(bad[43], 1, 8, d0, 1, false, arm32.PC, 0, none)
	Elems(bad[44], true, 1, 8, d0, 1, false, 0, 0, -3)
	ElemLane(bad[45], false, 1, 8, d0, false, 0, 0, 0, -3)
	ElemDup(bad[46], 1, 8, d0, 1, false, 0, 0, -3)
	Elems(bad[47], false, 4, 8, vfp.D26, 4, true, 0, 0, none)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) {
			return fail(buf.Concat("a bad NEON load or store was taken: case ", strconv.Itoa(i)))
		}
	}
	return ""
}
