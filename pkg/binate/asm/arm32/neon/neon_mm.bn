package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// mmLaneRegs reports whether vd and vn are two D registers (vfp.D0..D31) or two Q registers
// (Q0..Q15), and which, setting the error naming instruction what if not.
func mmLaneRegs(a @asm.Assembler, what *[]readonly char, vd int, vn int) (bool, bool) {
	if isQ(vd) && isQ(vn) { return true, true }
	if isD(vd) && isD(vn) { return false, true }
	a.SetError(what)
	return false, false
}

// mmQuads reports whether qd, qn and qm are Q registers (Q0..Q15), setting the error naming
// instruction what if not.
func mmQuads(a @asm.Assembler, what *[]readonly char, qd int, qn int, qm int) bool {
	if isQ(qd) && isQ(qn) && isQ(qm) { return true }
	a.SetError(what)
	return false
}

// BfDot emits VDOT.BF16 vd, vn, vm: 1111 1100 0D00 nnnn dddd 1101 NQM0 mmmm, on three D registers
// (vfp.D0..D31) or three Q registers (Q0..Q15).
func BfDot(a @asm.Assembler, vd int, vn int, vm int) {
	q, ok := neonRegs(a, vd, vn, vm)
	if !ok { return }
	arm32.Emit32(a, 0xFC000D00 | placeD(vd) | placeN(vn) | placeM(vm) | bitIf(q, 0x40))
}

// BfDotLane emits VDOT.BF16 vd, vn, dm[x]: 1111 1110 0D00 nnnn dddd 1101 NQM0 mmmm, mmmm the D
// register dm (D0..D15) and M its lane x (0..1), on D registers vd, vn (vfp.D0..D31) or Q
// registers (Q0..Q15).
func BfDotLane(a @asm.Assembler, vd int, vn int, dm int, x int) {
	q, ok := mmLaneRegs(a, "arm32: VDOT.BF16's registers are two D or two Q registers and a scalar",
			vd, vn)
	if !ok { return }
	if !isD(dm) || dNum(dm) > 15 || x < 0 || x > 1 {
		a.SetError("arm32: VDOT.BF16's scalar is one of D0..D15 with lane 0..1")
		return
	}
	arm32.Emit32(a,
			0xFE000D00 | placeD(vd) | placeN(vn) | dNum(dm) | (cast(uint32, x) << 5) | bitIf(q, 0x40))
}

// Bfmal emits VFMAB.BF16 (VFMAT.BF16 when top) qd, qn, qm: 1111 1100 0D11 nnnn dddd 1000 NTM1 mmmm,
// T set for VFMAT, on Q registers (Q0..Q15).
func Bfmal(a @asm.Assembler, top bool, qd int, qn int, qm int) {
	if !mmQuads(a, "arm32: VFMAB / VFMAT take Q registers", qd, qn, qm) { return }
	arm32.Emit32(a, 0xFC300810 | placeD(qd) | placeN(qn) | placeM(qm) | bitIf(top, 0x40))
}

// BfmalLane emits VFMAB.BF16 (VFMAT.BF16 when top) qd, qn, dm[x]: 1111 1110 0D11 nnnn dddd 1000
// NTM1 mmmm, T set for VFMAT, on Q registers qd, qn (Q0..Q15) and the D register dm (D0..D7,
// Vm<2:0>) with lane x (0..3, M:Vm<3>).
func BfmalLane(a @asm.Assembler, top bool, qd int, qn int, dm int, x int) {
	if !isQ(qd) || !isQ(qn) {
		a.SetError("arm32: VFMAB / VFMAT by a scalar take two Q registers and a scalar")
		return
	}
	if !isD(dm) || dNum(dm) > 7 || x < 0 || x > 3 {
		a.SetError("arm32: VFMAB / VFMAT's scalar is one of D0..D7 with lane 0..3")
		return
	}
	var lane uint32 = cast(uint32, x)
	arm32.Emit32(a,
			0xFE300810 | placeD(qd) | placeN(qn) | dNum(dm) | ((lane & 1) << 3) | ((lane >> 1) << 5) |
					bitIf(top, 0x40))
}

// Mmla emits the matrix multiply-accumulate op (MMLA_*) qd, qn, qm: VMMLA.BF16, 1111 1100 0D00
// nnnn dddd 1100 N1M0 mmmm; VSMMLA.S8 and VUMMLA.U8, 1111 1100 0D10 nnnn dddd 1100 N1MU mmmm (U
// set for VUMMLA); VUSMMLA.S8, 1111 1100 1D10 nnnn dddd 1100 N1M0 mmmm; on Q registers (Q0..Q15).
func Mmla(a @asm.Assembler, op int, qd int, qn int, qm int) {
	var bits uint32 = 0
	if op == MMLA_S8 { bits = 0x200000 }
	if op == MMLA_U8 { bits = 0x200010 }
	if op == MMLA_US8 { bits = 0xA00000 }
	if op != MMLA_BF16 && bits == 0 {
		a.SetError("arm32: no such NEON matrix multiply-accumulate")
		return
	}
	if !mmQuads(a, "arm32: a NEON matrix multiply-accumulate takes Q registers", qd, qn, qm) { return }
	arm32.Emit32(a, 0xFC000C40 | bits | placeD(qd) | placeN(qn) | placeM(qm))
}

// UsDot emits VUSDOT.S8 vd, vn, vm: 1111 1100 1D10 nnnn dddd 1101 NQM0 mmmm, on three D registers
// (vfp.D0..D31) or three Q registers (Q0..Q15).
func UsDot(a @asm.Assembler, vd int, vn int, vm int) {
	q, ok := neonRegs(a, vd, vn, vm)
	if !ok { return }
	arm32.Emit32(a, 0xFCA00D00 | placeD(vd) | placeN(vn) | placeM(vm) | bitIf(q, 0x40))
}

// UsDotLane emits VUSDOT.S8 (VSUDOT.U8 when su) vd, vn, dm[x]: 1111 1110 1D00 nnnn dddd 1101 NQMU
// mmmm, U set for VSUDOT, mmmm the D register dm (D0..D15) and M its lane x (0..1), on D registers
// vd, vn (vfp.D0..D31) or Q registers (Q0..Q15).
func UsDotLane(a @asm.Assembler, su bool, vd int, vn int, dm int, x int) {
	q, ok := mmLaneRegs(a,
			"arm32: VUSDOT / VSUDOT's registers are two D or two Q registers and a scalar", vd, vn)
	if !ok { return }
	if !isD(dm) || dNum(dm) > 15 || x < 0 || x > 1 {
		a.SetError("arm32: VUSDOT / VSUDOT's scalar is one of D0..D15 with lane 0..1")
		return
	}
	arm32.Emit32(a,
			0xFE800D00 | placeD(vd) | placeN(vn) | dNum(dm) | (cast(uint32, x) << 5) | bitIf(q, 0x40) |
					bitIf(su, 0x10))
}
