package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The BFloat16 forms as clang assembles them: VDOT.BF16 Q0, Q1, Q2; D0, D1, D2; Q1, Q2, Q4; Q5, Q4,
// D1[1]; D21, D4, D3[1]; D3, D26, D5[1]; VFMAB.BF16 Q0, Q1, Q2; VFMAT.BF16 Q1, Q2, Q4; VFMAB.BF16
// Q5, Q4, D1[1] and D1[2]; VFMAT.BF16 Q10, Q7, D2[2]; Q15, Q10, D3[1]; Q3, Q6, D7[3]; VMMLA.BF16
// Q0, Q1, Q2; and high registers, VDOT.BF16 Q15, Q14, Q13; D31, D30, D29; D8, D16, D1; VFMAB.BF16
// Q15, Q14, Q13; VFMAT.BF16 Q8, Q0, Q1; VMMLA.BF16 Q15, Q14, Q13.
func TestNeonBf16() testing.TestResult {
	var a @asm.Assembler = newAsm()
	BfDot(a, Q0, Q1, Q2)
	BfDot(a, vfp.D0, vfp.D1, vfp.D2)
	BfDot(a, Q1, Q2, Q4)
	BfDotLane(a, Q5, Q4, vfp.D1, 1)
	BfDotLane(a, vfp.D21, vfp.D4, vfp.D3, 1)
	BfDotLane(a, vfp.D3, vfp.D26, vfp.D5, 1)
	Bfmal(a, false, Q0, Q1, Q2)
	Bfmal(a, true, Q1, Q2, Q4)
	BfmalLane(a, false, Q5, Q4, vfp.D1, 1)
	BfmalLane(a, false, Q5, Q4, vfp.D1, 2)
	BfmalLane(a, true, Q10, Q7, vfp.D2, 2)
	BfmalLane(a, true, Q15, Q10, vfp.D3, 1)
	BfmalLane(a, true, Q3, Q6, vfp.D7, 3)
	Mmla(a, MMLA_BF16, Q0, Q1, Q2)
	BfDot(a, Q15, Q14, Q13)
	BfDot(a, vfp.D31, vfp.D30, vfp.D29)
	BfDot(a, vfp.D8, vfp.D16, vfp.D1)
	Bfmal(a, false, Q15, Q14, Q13)
	Bfmal(a, true, Q8, Q0, Q1)
	Mmla(a, MMLA_BF16, Q15, Q14, Q13)
	if !wordsAre(a,
			@[]uint32{0xFC020D44, 0xFC010D02, 0xFC042D48, 0xFE08AD61, 0xFE445D23, 0xFE0A3DA5, 0xFC320814,
					0xFC342858, 0xFE38A819, 0xFE38A831, 0xFE7E4872, 0xFE74E8DB, 0xFE3C687F, 0xFC020C44, 0xFC4CEDEA,
					0xFC4EFDAD, 0xFC008D81, 0xFC7CE8BA, 0xFC700852, 0xFC4CECEA}) {
		return fail("a NEON BFloat16 instruction is not clang's word")
	}
	return ""
}

// The Int8 matrix forms as clang assembles them: VSMMLA.S8 Q0, Q1, Q2; VUMMLA.U8 Q1, Q2, Q4;
// VUSMMLA.S8 Q1, Q2, Q4; VUSDOT.S8 Q0, Q1, Q2; D1, D2, D4; Q15, Q10, D3[1]; D3, D26, D5[1];
// VSUDOT.U8 Q0, Q1, D0[0]; D7, D14, D1[1]; Q9, Q0, D5[1]; and high registers, VSMMLA.S8 Q8, Q0, Q1;
// VUMMLA.U8 Q15, Q14, Q13; VUSMMLA.S8 Q8, Q0, Q1; VUSDOT.S8 D31, D30, D29; Q15, Q14, Q13; D8, D16,
// D1.
func TestNeonI8mm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mmla(a, MMLA_S8, Q0, Q1, Q2)
	Mmla(a, MMLA_U8, Q1, Q2, Q4)
	Mmla(a, MMLA_US8, Q1, Q2, Q4)
	UsDot(a, Q0, Q1, Q2)
	UsDot(a, vfp.D1, vfp.D2, vfp.D4)
	UsDotLane(a, false, Q15, Q10, vfp.D3, 1)
	UsDotLane(a, false, vfp.D3, vfp.D26, vfp.D5, 1)
	UsDotLane(a, true, Q0, Q1, vfp.D0, 0)
	UsDotLane(a, true, vfp.D7, vfp.D14, vfp.D1, 1)
	UsDotLane(a, true, Q9, Q0, vfp.D5, 1)
	Mmla(a, MMLA_S8, Q8, Q0, Q1)
	Mmla(a, MMLA_U8, Q15, Q14, Q13)
	Mmla(a, MMLA_US8, Q8, Q0, Q1)
	UsDot(a, vfp.D31, vfp.D30, vfp.D29)
	UsDot(a, Q15, Q14, Q13)
	UsDot(a, vfp.D8, vfp.D16, vfp.D1)
	if !wordsAre(a,
			@[]uint32{0xFC220C44, 0xFC242C58, 0xFCA42C48, 0xFCA20D44, 0xFCA21D04, 0xFEC4EDE3, 0xFE8A3DA5,
					0xFE820D50, 0xFE8E7D31, 0xFEC02D75, 0xFC600C42, 0xFC6CECFA, 0xFCE00C42, 0xFCEEFDAD, 0xFCECEDEA,
					0xFCA08D81}) {
		return fail("a NEON Int8 matrix instruction is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: mixed registers; a by-scalar form's
// scalar past D15 (D7 for VFMAB / VFMAT) or lane past 1 (3), or a Q register as it; VFMAB / VFMAT
// or a matrix multiply-accumulate on D registers; no such matrix operation.
func TestNeonMmRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 12)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	BfDot(bad[0], vfp.D0, Q1, vfp.D2)
	BfDotLane(bad[1], Q0, Q1, vfp.D16, 0)
	BfDotLane(bad[2], vfp.D0, vfp.D1, vfp.D2, 2)
	Bfmal(bad[3], false, vfp.D0, vfp.D1, vfp.D2)
	BfmalLane(bad[4], true, Q0, Q1, vfp.D8, 0)
	BfmalLane(bad[5], false, Q0, Q1, vfp.D2, 4)
	Mmla(bad[6], MMLA_S8, vfp.D0, vfp.D1, vfp.D2)
	Mmla(bad[7], 0, Q0, Q1, Q2)
	UsDot(bad[8], Q0, Q1, vfp.D2)
	UsDotLane(bad[9], true, Q0, Q1, vfp.D16, 0)
	UsDotLane(bad[10], false, Q0, vfp.D1, vfp.D2, 0)
	BfDotLane(bad[11], Q0, Q1, Q2, 0)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON BFloat16 or Int8 matrix instruction was taken") }
	}
	return ""
}
