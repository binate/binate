package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// Ext emits VEXT.<size> vd, vn, vm, #index: 1111 0010 1D11 nnnn dddd iiii NQM0 mmmm, iiii the
// index in bytes (index times the element's), on D registers (vfp.D0..D31; 8-, 16-, 32- and
// 64-bit elements, the index below 8 bytes) or Q registers (Q0..Q15; the index below 16 bytes).
func Ext(a @asm.Assembler, size int, vd int, vn int, vm int, index int) {
	q, ok := neonRegs(a, vd, vn, vm)
	if !ok { return }
	if size != 8 && size != 16 && size != 32 && size != 64 {
		a.SetError("arm32: VEXT's element is 8, 16, 32 or 64 bits")
		return
	}
	var bytes int = 8
	if q { bytes = 16 }
	if index < 0 || index >= bytes / (size / 8) {
		a.SetError("arm32: VEXT's index is past the register's elements")
		return
	}
	var imm4 uint32 = cast(uint32, index * (size / 8))
	arm32.Emit32(a, 0xF2B00000 | placeD(vd) | placeN(vn) | placeM(vm) | (imm4 << 8) | bitIf(q, 0x40))
}

// DupCore emits VDUP{cond}.<size> vd, rt: cccc 1110 1BQ0 dddd tttt 1011 D0E1 0000 (B:E 10 for 8-bit
// elements, 01 for 16-bit, 00 for 32-bit), on a D register (vfp.D0..D31) or a Q register
// (Q0..Q15), rt R0..R15.
func DupCore(a @asm.Assembler, cond int, size int, vd int, rt int) {
	if !arm32.CondOk(a, cond) || !arm32.RegOk(a, rt, false) { return }
	if !isD(vd) && !isQ(vd) {
		a.SetError("arm32: VDUP's register is D0..D31 or Q0..Q15")
		return
	}
	var be uint32 = 0
	if size == 8 {
		be = 0x400000
	} else if size == 16 {
		be = 0x20
	} else if size != 32 {
		a.SetError("arm32: VDUP's element is 8, 16 or 32 bits")
		return
	}
	arm32.Emit32(a,
			(cast(uint32, cond) << 28) | 0x0E800B10 | be | bitIf(isQ(vd), 0x200000) | placeN(vd) |
					(cast(uint32, rt) << 12))
}

// DupLane emits VDUP.<size> vd, dm[x]: 1111 0011 1D11 iiii dddd 1100 0QM0 mmmm (iiii x:1 for 8-bit
// elements, x:10 for 16-bit, x:100 for 32-bit), on a D register (vfp.D0..D31) or a Q register
// (Q0..Q15) from D register dm's lane x (0..7, 0..3, 0..1).
func DupLane(a @asm.Assembler, size int, vd int, dm int, x int) {
	if (!isD(vd) && !isQ(vd)) || !isD(dm) {
		a.SetError("arm32: VDUP's registers are D0..D31 or Q0..Q15, and a D register's lane")
		return
	}
	if size != 8 && size != 16 && size != 32 {
		a.SetError("arm32: VDUP's element is 8, 16 or 32 bits")
		return
	}
	if x < 0 || x >= 64 / size {
		a.SetError("arm32: VDUP's lane is past the D register's elements")
		return
	}
	var u uint32 = cast(uint32, x)
	var imm4 uint32 = (u << 1) | 1
	if size == 16 { imm4 = (u << 2) | 2 }
	if size == 32 { imm4 = (u << 3) | 4 }
	arm32.Emit32(a, 0xF3B00C00 | placeD(vd) | placeM(dm) | (imm4 << 16) | bitIf(isQ(vd), 0x40))
}

// Tbl emits VTBL.8 (or VTBX.8, tbx) vd, {dn .. dn + count - 1}, vm: 1111 0011 1D11 nnnn dddd 10ll
// NxM0 mmmm, ll the list's length less one and x set for VTBX; vd, dn and vm D registers
// (vfp.D0..D31), count 1..4 with the list within D0..D31.
func Tbl(a @asm.Assembler, tbx bool, vd int, dn int, count int, vm int) {
	if !isD(vd) || !isD(dn) || !isD(vm) {
		a.SetError("arm32: VTBL's and VTBX's registers are D0..D31")
		return
	}
	if count < 1 || count > 4 || dn - vfp.D0 + count > 32 {
		a.SetError("arm32: VTBL's and VTBX's list is one to four D registers within D0..D31")
		return
	}
	arm32.Emit32(a,
			0xF3B00800 | placeD(vd) | placeN(dn) | placeM(vm) | (cast(uint32, count - 1) << 8) |
					bitIf(tbx, 0x40))
}
