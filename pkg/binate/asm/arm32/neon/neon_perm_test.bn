package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// VEXT and VDUP as clang assembles them: VEXT.8 D0, D1, D2, #3; VEXT.8 Q0, Q1, Q2, #15; VEXT.16 D0,
// D1, D2, #3; VEXT.16 Q0, Q1, Q2, #7; VEXT.32 D0, D1, D2, #1; VEXT.32 Q15, Q14, Q13, #3; VEXT.64
// Q0, Q1, Q2, #1; VEXT.8 D0, D0, D1, #3; VEXT.64 D0, D1, D2, #0 (VEXT.8's #0); VDUP.8 D0, R0;
// VDUP.16 Q15, LR; VDUP.32 D31, R12; VDUP.32 Q0, SP; VDUP.32 D0, PC; VDUPEQ.8 Q1, R1; VDUP.16 D0,
// R0; VDUP.32 Q8, R0; VDUP.8 D0, D1[7]; VDUP.8 Q0, D31[0]; VDUP.16 D0, D1[3]; VDUP.32 Q15, D16[1];
// VDUP.32 D0, D1[1]; VDUP.8 Q0, D1[1].
func TestNeonPerm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var al int = arm32.COND_AL
	Ext(a, 8, vfp.D0, vfp.D1, vfp.D2, 3)
	Ext(a, 8, Q0, Q1, Q2, 15)
	Ext(a, 16, vfp.D0, vfp.D1, vfp.D2, 3)
	Ext(a, 16, Q0, Q1, Q2, 7)
	Ext(a, 32, vfp.D0, vfp.D1, vfp.D2, 1)
	Ext(a, 32, Q15, Q14, Q13, 3)
	Ext(a, 64, Q0, Q1, Q2, 1)
	Ext(a, 8, vfp.D0, vfp.D0, vfp.D1, 3)
	Ext(a, 64, vfp.D0, vfp.D1, vfp.D2, 0)
	DupCore(a, al, 8, vfp.D0, arm32.R0)
	DupCore(a, al, 16, Q15, arm32.LR)
	DupCore(a, al, 32, vfp.D31, arm32.R12)
	DupCore(a, al, 32, Q0, arm32.SP)
	DupCore(a, al, 32, vfp.D0, arm32.PC)
	DupCore(a, arm32.COND_EQ, 8, Q1, arm32.R1)
	DupCore(a, al, 16, vfp.D0, arm32.R0)
	DupCore(a, al, 32, Q8, arm32.R0)
	DupLane(a, 8, vfp.D0, vfp.D1, 7)
	DupLane(a, 8, Q0, vfp.D31, 0)
	DupLane(a, 16, vfp.D0, vfp.D1, 3)
	DupLane(a, 32, Q15, vfp.D16, 1)
	DupLane(a, 32, vfp.D0, vfp.D1, 1)
	DupLane(a, 8, Q0, vfp.D1, 1)
	if !wordsAre(a,
			@[]uint32{0xF2B10302, 0xF2B20F44, 0xF2B10602, 0xF2B20E44, 0xF2B10402, 0xF2FCECEA, 0xF2B20844,
					0xF2B00301, 0xF2B10002, 0xEEC00B10, 0xEEAEEBB0, 0xEE8FCB90, 0xEEA0DB10, 0xEE80FB10, 0x0EE21B10,
					0xEE800B30, 0xEEA00B90, 0xF3BF0C01, 0xF3B10C6F, 0xF3BE0C01, 0xF3FCEC60, 0xF3BC0C01,
					0xF3B30C41}) {
		return fail("a VEXT or VDUP is not clang's word")
	}
	return ""
}

// A VEXT or VDUP there is no encoding of is an error that emits nothing: VEXT of 4-bit elements, an
// index past the register's (8 for .8 on D, 4 for .16 on D, 16 for .8 on Q, 1 for .64 on D, -1, and
// ones whose bytes would wrap past the int's range at its width), D and Q registers mixed (a Q Vn
// or Vm); VDUP of 64-bit elements, an S register, no such condition or core register (16, -1), a
// lane past the D register's (2 for .32, -1), a Q register's lane.
func TestNeonPermRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 20)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	var al int = arm32.COND_AL
	var d0 int = vfp.D0
	Ext(bad[0], 4, d0, vfp.D1, vfp.D2, 0)
	Ext(bad[1], 8, d0, vfp.D1, vfp.D2, 8)
	Ext(bad[2], 16, d0, vfp.D1, vfp.D2, 4)
	Ext(bad[3], 8, Q0, Q1, Q2, 16)
	Ext(bad[4], 64, d0, vfp.D1, vfp.D2, 1)
	Ext(bad[5], 8, d0, vfp.D1, vfp.D2, -1)
	Ext(bad[6], 8, d0, Q1, vfp.D2, 0)
	DupCore(bad[7], al, 64, d0, arm32.R0)
	DupCore(bad[8], al, 32, vfp.S0, arm32.R0)
	DupCore(bad[9], 16, 32, d0, arm32.R0)
	DupCore(bad[10], al, 32, d0, 16)
	DupLane(bad[11], 64, d0, vfp.D1, 0)
	DupLane(bad[12], 32, d0, vfp.D1, 2)
	DupLane(bad[13], 32, d0, Q1, 0)
	DupLane(bad[14], 8, vfp.S0, vfp.D1, 0)
	// 2^(bits - 3) + 1 eight-byte elements are 8 bytes past the int's wrap, and 2^(bits - 2) + 1
	// two-byte ones 2 bytes past its sign bit, whatever the int's width.
	var one int = 1
	var bits int = cast(int, sizeof(int)) * 8
	Ext(bad[15], 64, Q0, Q1, Q2, (one << (bits - 3)) + 1)
	Ext(bad[16], 16, d0, vfp.D1, vfp.D2, (one << (bits - 2)) + 1)
	Ext(bad[17], 8, d0, vfp.D1, Q2, 0)
	DupLane(bad[18], 8, d0, vfp.D1, -1)
	DupCore(bad[19], al, 8, d0, -1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VEXT or VDUP was taken") }
	}
	return ""
}

// VTBL and VTBX as clang assembles them: VTBL.8 D0, {D1}, D2; VTBL.8 D0, {D1, D2}, D3; VTBL.8 D0,
// {D1-D3}, D4; VTBL.8 D0, {D1-D4}, D5; VTBL.8 D31, {D28-D31}, D30; VTBX.8 D0, {D1}, D2; VTBX.8 D0,
// {D1-D3}, D2; VTBL.8 D0, {D0-D3}, D4.
func TestNeonTbl() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Tbl(a, false, vfp.D0, vfp.D1, 1, vfp.D2)
	Tbl(a, false, vfp.D0, vfp.D1, 2, vfp.D3)
	Tbl(a, false, vfp.D0, vfp.D1, 3, vfp.D4)
	Tbl(a, false, vfp.D0, vfp.D1, 4, vfp.D5)
	Tbl(a, false, vfp.D31, vfp.D28, 4, vfp.D30)
	Tbl(a, true, vfp.D0, vfp.D1, 1, vfp.D2)
	Tbl(a, true, vfp.D0, vfp.D1, 3, vfp.D2)
	Tbl(a, false, vfp.D0, vfp.D0, 4, vfp.D4)
	if !wordsAre(a,
			@[]uint32{0xF3B10802, 0xF3B10903, 0xF3B10A04, 0xF3B10B05, 0xF3FCFBAE, 0xF3B10842, 0xF3B10A42,
					0xF3B00B04}) {
		return fail("a VTBL or VTBX is not clang's word")
	}
	return ""
}

// A VTBL or VTBX there is no encoding of is an error that emits nothing: a list of none or five,
// one past D31, a Q or S register.
func TestNeonTblRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 6)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Tbl(bad[0], false, vfp.D0, vfp.D1, 0, vfp.D2)
	Tbl(bad[1], false, vfp.D0, vfp.D1, 5, vfp.D2)
	Tbl(bad[2], true, vfp.D0, vfp.D30, 3, vfp.D2)
	Tbl(bad[3], false, Q0, vfp.D1, 1, vfp.D2)
	Tbl(bad[4], false, vfp.D0, vfp.D1, 1, Q2)
	Tbl(bad[5], false, vfp.D0, vfp.S1, 1, vfp.D2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VTBL or VTBX was taken") }
	}
	return ""
}
