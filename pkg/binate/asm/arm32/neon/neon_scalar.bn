package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// scalarOp returns how op (SCALAR_*) is encoded: its integer opcode (-1 for no such operation),
// its floating-point opcode (-1 for none), its data types' kind -- neonKindI (I16 / I32),
// neonKindS (S16 / S32) or neonKindSU (S16 / S32, U16 / U32, the U bit the sign) -- and whether it
// is a long one (Q, D and the scalar).
func scalarOp(op int) (int, int, int, bool) {
	if op == SCALAR_VMLA { return 0, 1, neonKindI, false }
	if op == SCALAR_VMLAL { return 2, -1, neonKindSU, true }
	if op == SCALAR_VQDMLAL { return 3, -1, neonKindS, true }
	if op == SCALAR_VMLS { return 4, 5, neonKindI, false }
	if op == SCALAR_VMLSL { return 6, -1, neonKindSU, true }
	if op == SCALAR_VQDMLSL { return 7, -1, neonKindS, true }
	if op == SCALAR_VMUL { return 8, 9, neonKindI, false }
	if op == SCALAR_VMULL { return 10, -1, neonKindSU, true }
	if op == SCALAR_VQDMULL { return 11, -1, neonKindS, true }
	if op == SCALAR_VQDMULH { return 12, -1, neonKindS, false }
	if op == SCALAR_VQRDMULH { return 13, -1, neonKindS, false }
	if op == SCALAR_VQRDMLAH { return 14, -1, neonKindS, false }
	if op == SCALAR_VQRDMLSH { return 15, -1, neonKindS, false }
	return -1, -1, neonKindNone, false
}

// scalarField returns the scalar vm[lane] of elements of size code size (1 for 16 bits, 2 for 32)
// as an instruction's M bit [5] and Vm field [3:0], or ok false for a register or lane past those
// the size has (D0..D7 and 0..3 for 16 bits, D0..D15 and 0..1 for 32).
func scalarField(size int, vm int, lane int) (uint32, bool) {
	var most int = 1
	if size == 1 { most = 3 }
	if !isD(vm) || lane < 0 || lane > most { return 0, false }
	var n uint32 = dNum(vm)
	var x uint32 = cast(uint32, lane)
	if size == 1 {
		if n > 7 { return 0, false }
		return n | ((x & 1) << 3) | ((x >> 1) << 5), true
	}
	if n > 15 { return 0, false }
	return n | (x << 5), true
}

// Scalar emits the NEON instruction op (SCALAR_*) of data type dt (DT_*) on registers vd and vn
// (D registers vfp.D0..D31 or Q registers Q0..Q15, as op takes) and the scalar vm[lane] (a D
// register).
func Scalar(a @asm.Assembler, op int, dt int, vd int, vn int, vm int, lane int) {
	opc, fopc, kind, long := scalarOp(op)
	if opc < 0 {
		a.SetError("arm32: no such NEON operation")
		return
	}
	var regs bool = isQ(vd) && isD(vn)
	if !long { regs = (isD(vd) && isD(vn)) || (isQ(vd) && isQ(vn)) }
	if !regs {
		a.SetError("arm32: the NEON operation's registers are not of the lengths it takes")
		return
	}
	size, dkind := neonSize(dt)
	var bit24 uint32 = bitIf(!long && isQ(vd), 1)
	var ok bool = false
	if dt == DT_F16 || dt == DT_F32 {
		ok = fopc >= 0
		opc = fopc
		size = 1
		if dt == DT_F32 { size = 2 }
	} else if kind == neonKindSU {
		ok = (dkind == neonKindS || dkind == neonKindU) && (size == 1 || size == 2)
		bit24 = bitIf(dkind == neonKindU, 1)
	} else {
		ok = dkind == kind && (size == 1 || size == 2)
	}
	if !ok {
		a.SetError("arm32: the NEON operation has no form of that data type")
		return
	}
	field, inRange := scalarField(size, vm, lane)
	if !inRange {
		a.SetError("arm32: the scalar's register or lane is past those its element size has")
		return
	}
	arm32.Emit32(a,
			0xF2800040 | (bit24 << 24) | placeD(vd) | (cast(uint32, size) << 20) | placeN(vn) |
					(cast(uint32, opc) << 8) | field)
}
