package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// Two registers and a scalar as clang assembles them: VMUL.I16 D0, D1, D2[0]; VMUL.I16 Q8, Q9,
// D7[3]; VMUL.I32 D0, D1, D15[1]; VMUL.F32 Q0, Q1, D2[0]; VMUL.F16 D31, D30, D7[1]; VMLA.I32
// D31, D30, D7[1]; VMLA.F16 Q8, Q9, D7[3]; VMLS.I16 D0, D1, D2[2]; VMLS.F32 D0, D1, D8[0];
// VMLAL.U32 Q15, D31, D15[1]; VMLSL.S16 Q0, D1, D2[0]; VMULL.S32 Q15, D31, D15[1]; VMULL.U16 Q0,
// D1, D2[0]; VQDMULL.S32 Q15, D31, D15[1]; VQDMLAL.S16 Q0, D1, D2[0]; VQDMLSL.S32 Q0, D1, D2[0];
// VQDMULH.S16 Q8, Q9, D7[3]; VQRDMULH.S32 D31, D30, D7[1]; VMUL.I16 D0, D0, D1[0]; VMUL.F32 Q0, Q0,
// D1[0].
func TestNeonScalar() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Scalar(a, SCALAR_VMUL, DT_I16, vfp.D0, vfp.D1, vfp.D2, 0)
	Scalar(a, SCALAR_VMUL, DT_I16, Q8, Q9, vfp.D7, 3)
	Scalar(a, SCALAR_VMUL, DT_I32, vfp.D0, vfp.D1, vfp.D15, 1)
	Scalar(a, SCALAR_VMUL, DT_F32, Q0, Q1, vfp.D2, 0)
	Scalar(a, SCALAR_VMUL, DT_F16, vfp.D31, vfp.D30, vfp.D7, 1)
	Scalar(a, SCALAR_VMLA, DT_I32, vfp.D31, vfp.D30, vfp.D7, 1)
	Scalar(a, SCALAR_VMLA, DT_F16, Q8, Q9, vfp.D7, 3)
	Scalar(a, SCALAR_VMLS, DT_I16, vfp.D0, vfp.D1, vfp.D2, 2)
	Scalar(a, SCALAR_VMLS, DT_F32, vfp.D0, vfp.D1, vfp.D8, 0)
	Scalar(a, SCALAR_VMLAL, DT_U32, Q15, vfp.D31, vfp.D15, 1)
	Scalar(a, SCALAR_VMLSL, DT_S16, Q0, vfp.D1, vfp.D2, 0)
	Scalar(a, SCALAR_VMULL, DT_S32, Q15, vfp.D31, vfp.D15, 1)
	Scalar(a, SCALAR_VMULL, DT_U16, Q0, vfp.D1, vfp.D2, 0)
	Scalar(a, SCALAR_VQDMULL, DT_S32, Q15, vfp.D31, vfp.D15, 1)
	Scalar(a, SCALAR_VQDMLAL, DT_S16, Q0, vfp.D1, vfp.D2, 0)
	Scalar(a, SCALAR_VQDMLSL, DT_S32, Q0, vfp.D1, vfp.D2, 0)
	Scalar(a, SCALAR_VQDMULH, DT_S16, Q8, Q9, vfp.D7, 3)
	Scalar(a, SCALAR_VQRDMULH, DT_S32, vfp.D31, vfp.D30, vfp.D7, 1)
	Scalar(a, SCALAR_VMUL, DT_I16, vfp.D0, vfp.D0, vfp.D1, 0)
	Scalar(a, SCALAR_VMUL, DT_F32, Q0, Q0, vfp.D1, 0)
	if !wordsAre(a,
			@[]uint32{0xF2910842, 0xF3D208EF, 0xF2A1086F, 0xF3A20942, 0xF2DEF9CF, 0xF2EEF0E7, 0xF3D201EF,
					0xF2910462, 0xF2A10548, 0xF3EFE2EF, 0xF2910642, 0xF2EFEAEF, 0xF3910A42, 0xF2EFEBEF, 0xF2910342,
					0xF2A10742, 0xF3D20CEF, 0xF2EEFDE7, 0xF2900841, 0xF3A00941}) {
		return fail("a NEON two-registers-and-a-scalar operation is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: no such operation; a data type the
// operation has not (VMUL.I8, VMLAL.I16, VQDMULH.U16, VMLA.I64, VMULL.F32); a scalar register or
// lane past those of its element size (D8 or lane 4 for 16 bits, D16 or lane 2 for 32, a negative
// lane, one whose low 32 bits are in range), or a Q register; registers of other lengths (VMULL's
// result a D register, VMUL's D and Q mixed).
func TestNeonScalarRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 15)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Scalar(bad[0], 0, DT_I16, vfp.D0, vfp.D1, vfp.D2, 0)
	Scalar(bad[1], SCALAR_VMUL, DT_I8, vfp.D0, vfp.D1, vfp.D2, 0)
	Scalar(bad[2], SCALAR_VMLAL, DT_I16, Q0, vfp.D1, vfp.D2, 0)
	Scalar(bad[3], SCALAR_VQDMULH, DT_U16, vfp.D0, vfp.D1, vfp.D2, 0)
	Scalar(bad[4], SCALAR_VMLA, DT_I64, vfp.D0, vfp.D1, vfp.D2, 0)
	Scalar(bad[5], SCALAR_VMULL, DT_F32, Q0, vfp.D1, vfp.D2, 0)
	Scalar(bad[6], SCALAR_VMUL, DT_I16, vfp.D0, vfp.D1, vfp.D8, 0)
	Scalar(bad[7], SCALAR_VMUL, DT_I16, vfp.D0, vfp.D1, vfp.D2, 4)
	Scalar(bad[8], SCALAR_VMUL, DT_I32, vfp.D0, vfp.D1, vfp.D16, 0)
	Scalar(bad[9], SCALAR_VMUL, DT_I32, vfp.D0, vfp.D1, vfp.D2, 2)
	Scalar(bad[10], SCALAR_VMUL, DT_I16, vfp.D0, vfp.D1, vfp.D2, -1)
	Scalar(bad[11], SCALAR_VMUL, DT_I16, vfp.D0, vfp.D1, Q1, 0)
	Scalar(bad[12], SCALAR_VMULL, DT_S16, vfp.D0, vfp.D1, vfp.D2, 0)
	Scalar(bad[13], SCALAR_VMUL, DT_I16, vfp.D0, Q1, vfp.D2, 0)
	// A lane past 32 bits needs an int wider than 32 bits; with none, a lane past 3 stands in.
	var lane int = 4
	if sizeof(int) > 4 {
		var big int64 = 4294967299
		lane = cast(int, big)
	}
	Scalar(bad[14], SCALAR_VMUL, DT_I16, vfp.D0, vfp.D1, vfp.D2, lane)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON two-registers-and-a-scalar operation was taken") }
	}
	return ""
}

// ARMv8.1's VQRDMLAH and VQRDMLSH by a scalar as clang assembles them: .S16 with D0..D7 and lanes
// 0..3, .S32 with D0..D15 and lanes 0..1, on D and Q registers; a scalar past those, or another
// data type, is an error that emits nothing.
func TestNeonScalarV8_1() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Scalar(a, SCALAR_VQRDMLAH, DT_S16, vfp.D0, vfp.D1, vfp.D7, 3)
	Scalar(a, SCALAR_VQRDMLAH, DT_S32, Q15, Q14, vfp.D15, 1)
	Scalar(a, SCALAR_VQRDMLAH, DT_S16, Q0, Q1, vfp.D2, 1)
	Scalar(a, SCALAR_VQRDMLSH, DT_S16, Q15, Q14, vfp.D7, 3)
	Scalar(a, SCALAR_VQRDMLSH, DT_S32, vfp.D0, vfp.D1, vfp.D15, 1)
	Scalar(a, SCALAR_VQRDMLSH, DT_S32, Q0, Q1, vfp.D2, 1)
	if !wordsAre(a,
			@[]uint32{0xF2910E6F, 0xF3ECEEEF, 0xF3920E4A, 0xF3DCEFEF, 0xF2A10F6F, 0xF3A20F62}) {
		return fail("a NEON VQRDMLAH / VQRDMLSH by a scalar is not clang's word")
	}
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 4)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Scalar(bad[0], SCALAR_VQRDMLAH, DT_S16, vfp.D0, vfp.D1, vfp.D8, 0)
	Scalar(bad[1], SCALAR_VQRDMLAH, DT_S32, vfp.D0, vfp.D1, vfp.D16, 1)
	Scalar(bad[2], SCALAR_VQRDMLSH, DT_S32, vfp.D0, vfp.D1, vfp.D2, 2)
	Scalar(bad[3], SCALAR_VQRDMLSH, DT_I16, vfp.D0, vfp.D1, vfp.D2, 0)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON VQRDMLAH / VQRDMLSH by a scalar was taken") }
	}
	return ""
}
