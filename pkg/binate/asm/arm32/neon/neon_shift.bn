package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// shiftOp returns how op (SHIFT_*) is encoded: its opcode (-1 for no such operation), its data
// types' kind -- neonKindSU (S / U, the U bit the sign), neonKindS (signed only), neonKindI (I) or
// neonKindSize (a size) -- its U bit for a kind that does not set it, and whether it shifts right.
func shiftOp(op int) (int, int, uint32, bool) {
	if op == SHIFT_VSHR { return 0, neonKindSU, 0, true }
	if op == SHIFT_VSRA { return 1, neonKindSU, 0, true }
	if op == SHIFT_VRSHR { return 2, neonKindSU, 0, true }
	if op == SHIFT_VRSRA { return 3, neonKindSU, 0, true }
	if op == SHIFT_VSRI { return 4, neonKindSize, 1, true }
	if op == SHIFT_VSHL { return 5, neonKindI, 0, false }
	if op == SHIFT_VSLI { return 5, neonKindSize, 1, false }
	if op == SHIFT_VQSHLU { return 6, neonKindS, 1, false }
	if op == SHIFT_VQSHL { return 7, neonKindSU, 0, false }
	return -1, neonKindNone, 0, false
}

// Shift emits the NEON instruction op (SHIFT_*) of data type dt (DT_*) shifting vm into vd (D
// registers vfp.D0..D31 or Q registers Q0..Q15) by amount.
func Shift(a @asm.Assembler, op int, dt int, vd int, vm int, amount int) {
	opc, kind, u, right := shiftOp(op)
	if opc < 0 {
		a.SetError("arm32: no such NEON operation")
		return
	}
	q, ok := neonRegs(a, vd, vd, vm)
	if !ok { return }
	size, dkind := neonSize(dt)
	ok = dkind == kind || (kind == neonKindSU && (dkind == neonKindS || dkind == neonKindU))
	if !ok {
		a.SetError("arm32: the NEON operation has no form of that data type")
		return
	}
	if kind == neonKindSU { u = bitIf(dkind == neonKindU, 1) }
	var e int = 8 << size
	var field int = e + amount
	if right {
		ok = amount >= 1 && amount <= e
		field = 2 * e - amount
	} else {
		ok = amount >= 0 && amount < e
	}
	if !ok {
		a.SetError("arm32: a NEON shift amount past those its element size has")
		return
	}
	arm32.Emit32(a,
			0xF2800010 | (u << 24) | (cast(uint32, field & 63) << 16) | placeD(vd) |
					(cast(uint32, opc) << 8) | bitIf(e == 64, 0x80) | bitIf(q, 0x40) | placeM(vm))
}
