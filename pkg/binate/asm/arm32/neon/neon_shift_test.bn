package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// Shifts by an immediate as clang assembles them: VSHR.S8 D0, D1, #1; VSHR.U16 D0, D1, #16;
// VSHR.S64 D0, D1, #64; VSRA.S32 D0, D1, #32; VRSHR.U64 D0, D1, #1; VRSRA.S16 D0, D1, #7;
// VSRI.8 D0, D1, #8; VSRI.64 D0, D1, #63; VSHL.I8 D0, D1, #7; VSHL.I32 D0, D1, #31; VSHL.I64 D0,
// D1, #63; VSLI.16 D0, D1, #15; VSLI.64 D0, D1, #0; VQSHLU.S8 D0, D1, #7; VQSHLU.S64 D0, D1, #63;
// VQSHL.U32 D0, D1, #31; VQSHL.S16 D0, D1, #0; VSHR.S8 Q15, Q14, #3; VSHL.I16 Q15, Q14, #3;
// VQSHL.U8 D31, D30, #5; VSRA.U8 Q0, Q0, #1; VSHR.S8 Q0, Q1, #1.
func TestNeonShift() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Shift(a, SHIFT_VSHR, DT_S8, vfp.D0, vfp.D1, 1)
	Shift(a, SHIFT_VSHR, DT_U16, vfp.D0, vfp.D1, 16)
	Shift(a, SHIFT_VSHR, DT_S64, vfp.D0, vfp.D1, 64)
	Shift(a, SHIFT_VSRA, DT_S32, vfp.D0, vfp.D1, 32)
	Shift(a, SHIFT_VRSHR, DT_U64, vfp.D0, vfp.D1, 1)
	Shift(a, SHIFT_VRSRA, DT_S16, vfp.D0, vfp.D1, 7)
	Shift(a, SHIFT_VSRI, DT_8, vfp.D0, vfp.D1, 8)
	Shift(a, SHIFT_VSRI, DT_64, vfp.D0, vfp.D1, 63)
	Shift(a, SHIFT_VSHL, DT_I8, vfp.D0, vfp.D1, 7)
	Shift(a, SHIFT_VSHL, DT_I32, vfp.D0, vfp.D1, 31)
	Shift(a, SHIFT_VSHL, DT_I64, vfp.D0, vfp.D1, 63)
	Shift(a, SHIFT_VSLI, DT_16, vfp.D0, vfp.D1, 15)
	Shift(a, SHIFT_VSLI, DT_64, vfp.D0, vfp.D1, 0)
	Shift(a, SHIFT_VQSHLU, DT_S8, vfp.D0, vfp.D1, 7)
	Shift(a, SHIFT_VQSHLU, DT_S64, vfp.D0, vfp.D1, 63)
	Shift(a, SHIFT_VQSHL, DT_U32, vfp.D0, vfp.D1, 31)
	Shift(a, SHIFT_VQSHL, DT_S16, vfp.D0, vfp.D1, 0)
	Shift(a, SHIFT_VSHR, DT_S8, Q15, Q14, 3)
	Shift(a, SHIFT_VSHL, DT_I16, Q15, Q14, 3)
	Shift(a, SHIFT_VQSHL, DT_U8, vfp.D31, vfp.D30, 5)
	Shift(a, SHIFT_VSRA, DT_U8, Q0, Q0, 1)
	Shift(a, SHIFT_VSHR, DT_S8, Q0, Q1, 1)
	if !wordsAre(a,
			@[]uint32{0xF28F0011, 0xF3900011, 0xF2800091, 0xF2A00111, 0xF3BF0291, 0xF2990311, 0xF3880411,
					0xF3810491, 0xF28F0511, 0xF2BF0511, 0xF2BF0591, 0xF39F0511, 0xF3800591, 0xF38F0611, 0xF3BF0691,
					0xF3BF0711, 0xF2900711, 0xF2CDE07C, 0xF2D3E57C, 0xF3CDF73E, 0xF38F0150, 0xF28F0052}) {
		return fail("a NEON shift by an immediate is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: no such operation; a data type the
// operation has not (VSHR.I8, VSHL.S8, VQSHLU.U8, VSRI.S8, VSHR.F32); an amount past those of the
// element size (VSHR by 0 or 9 for 8 bits, VSHL by 8 or -1, VSHR.S64 by 65, VSLI.64 by 64); D and
// Q registers mixed.
func TestNeonShiftRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 13)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Shift(bad[0], 0, DT_S8, vfp.D0, vfp.D1, 1)
	Shift(bad[1], SHIFT_VSHR, DT_I8, vfp.D0, vfp.D1, 1)
	Shift(bad[2], SHIFT_VSHL, DT_S8, vfp.D0, vfp.D1, 1)
	Shift(bad[3], SHIFT_VQSHLU, DT_U8, vfp.D0, vfp.D1, 1)
	Shift(bad[4], SHIFT_VSRI, DT_S8, vfp.D0, vfp.D1, 1)
	Shift(bad[5], SHIFT_VSHR, DT_F32, vfp.D0, vfp.D1, 1)
	Shift(bad[6], SHIFT_VSHR, DT_S8, vfp.D0, vfp.D1, 0)
	Shift(bad[7], SHIFT_VSHR, DT_S8, vfp.D0, vfp.D1, 9)
	Shift(bad[8], SHIFT_VSHL, DT_I8, vfp.D0, vfp.D1, 8)
	Shift(bad[9], SHIFT_VSHL, DT_I8, vfp.D0, vfp.D1, -1)
	Shift(bad[10], SHIFT_VSHR, DT_S64, vfp.D0, vfp.D1, 65)
	Shift(bad[11], SHIFT_VSLI, DT_64, vfp.D0, vfp.D1, 64)
	Shift(bad[12], SHIFT_VSHR, DT_S8, vfp.D0, Q1, 1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON shift by an immediate was taken") }
	}
	return ""
}

// The narrowing and long shifts as clang assembles them: VSHRN.I16 D0, Q1, #1; VSHRN.I64 D0, Q1,
// #32; VRSHRN.I32 D0, Q1, #16; VQSHRN.S16 D0, Q1, #8; VQSHRN.U64 D0, Q1, #1; VQSHRUN.S32 D0, Q1,
// #9; VQRSHRN.U32 D0, Q1, #15; VQRSHRUN.S64 D0, Q1, #32; VQRSHRUN.S16 D0, Q1, #1; VSHRN.I16 D31,
// Q15, #1; VSHLL.S8 Q0, D1, #1; VSHLL.U32 Q0, D1, #31; VSHLL.S8 Q0, D1, #8 and VSHLL.I16 Q0, D1,
// #16 (the maximum shift); VSHLL.S16 Q0, D17, #16; VSHLL.I8 Q15, D31, #8; VSHLL.U16 Q15, D31, #1;
// VMOVL.S8 Q0, D1 and VMOVL.U32 Q15, D31 (VSHLL by 0).
func TestNeonShiftNarrowLong() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Shift(a, SHIFT_VSHRN, DT_I16, vfp.D0, Q1, 1)
	Shift(a, SHIFT_VSHRN, DT_I64, vfp.D0, Q1, 32)
	Shift(a, SHIFT_VRSHRN, DT_I32, vfp.D0, Q1, 16)
	Shift(a, SHIFT_VQSHRN, DT_S16, vfp.D0, Q1, 8)
	Shift(a, SHIFT_VQSHRN, DT_U64, vfp.D0, Q1, 1)
	Shift(a, SHIFT_VQSHRUN, DT_S32, vfp.D0, Q1, 9)
	Shift(a, SHIFT_VQRSHRN, DT_U32, vfp.D0, Q1, 15)
	Shift(a, SHIFT_VQRSHRUN, DT_S64, vfp.D0, Q1, 32)
	Shift(a, SHIFT_VQRSHRUN, DT_S16, vfp.D0, Q1, 1)
	Shift(a, SHIFT_VSHRN, DT_I16, vfp.D31, Q15, 1)
	Shift(a, SHIFT_VSHLL, DT_S8, Q0, vfp.D1, 1)
	Shift(a, SHIFT_VSHLL, DT_U32, Q0, vfp.D1, 31)
	Shift(a, SHIFT_VSHLL, DT_S8, Q0, vfp.D1, 8)
	Shift(a, SHIFT_VSHLL, DT_I16, Q0, vfp.D1, 16)
	Shift(a, SHIFT_VSHLL, DT_S16, Q0, vfp.D17, 16)
	Shift(a, SHIFT_VSHLL, DT_I8, Q15, vfp.D31, 8)
	Shift(a, SHIFT_VSHLL, DT_U16, Q15, vfp.D31, 1)
	Shift(a, SHIFT_VSHLL, DT_S8, Q0, vfp.D1, 0)
	Shift(a, SHIFT_VSHLL, DT_U32, Q15, vfp.D31, 0)
	if !wordsAre(a,
			@[]uint32{0xF28F0812, 0xF2A00812, 0xF2900852, 0xF2880912, 0xF3BF0912, 0xF3970812, 0xF3910952,
					0xF3A00852, 0xF38F0852, 0xF2CFF83E, 0xF2890A11, 0xF3BF0A11, 0xF3B20301, 0xF3B60301, 0xF3B60321,
					0xF3F2E32F, 0xF3D1EA3F, 0xF2880A11, 0xF3E0EA3F}) {
		return fail("a NEON narrowing or long shift is not clang's word")
	}
	return ""
}

// A narrowing or long shift there is no encoding of is an error that emits nothing: a data type
// the operation has not (VSHRN.I8 and VSHRN.S16, VQSHRUN.U16, VSHLL.S64, VSHLL.I8 by less than
// 8, VSHLL.F32); an amount past its range (VSHRN.I16 by 0 or 9, VSHLL.S8 by 9 or -1); registers
// of other lengths (VSHRN's result a Q register, VSHLL's a D register).
func TestNeonShiftNarrowLongRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 12)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Shift(bad[0], SHIFT_VSHRN, DT_I8, vfp.D0, Q1, 1)
	Shift(bad[1], SHIFT_VSHRN, DT_S16, vfp.D0, Q1, 1)
	Shift(bad[2], SHIFT_VQSHRUN, DT_U16, vfp.D0, Q1, 1)
	Shift(bad[3], SHIFT_VSHLL, DT_S64, Q0, vfp.D1, 1)
	Shift(bad[4], SHIFT_VSHLL, DT_I8, Q0, vfp.D1, 7)
	Shift(bad[5], SHIFT_VSHLL, DT_F32, Q0, vfp.D1, 1)
	Shift(bad[6], SHIFT_VSHRN, DT_I16, vfp.D0, Q1, 0)
	Shift(bad[7], SHIFT_VSHRN, DT_I16, vfp.D0, Q1, 9)
	Shift(bad[8], SHIFT_VSHLL, DT_S8, Q0, vfp.D1, 9)
	Shift(bad[9], SHIFT_VSHLL, DT_S8, Q0, vfp.D1, -1)
	Shift(bad[10], SHIFT_VSHRN, DT_I16, Q0, Q1, 1)
	Shift(bad[11], SHIFT_VSHLL, DT_S8, vfp.D0, vfp.D1, 1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON narrowing or long shift was taken") }
	}
	return ""
}
