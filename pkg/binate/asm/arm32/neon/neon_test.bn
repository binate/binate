package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// A NEON instruction's registers are all D or all Q: Q0..Q15 are D0..D30's pairs in the fields
// (Q15 is D30, N, M and D set), and a mix, a register past Q15 or an S register is an error.
func TestNeonRegs() testing.TestResult {
	if dNum(Q15) != 30 || dNum(vfp.D31) != 31 || placeD(Q15) != 0x0040E000 ||
			placeN(vfp.D17) != 0x00010080 || placeM(vfp.D16) != 0x20 {
		return fail("a NEON register is not placed in its fields")
	}
	var a @asm.Assembler = newAsm()
	q, ok := neonRegs(a, Q0, Q1, Q2)
	if !q || !ok { return fail("three Q registers are not a Q form") }
	q, ok = neonRegs(a, vfp.D0, vfp.D1, vfp.D31)
	if q || !ok { return fail("three D registers are not a D form") }
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 3)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	_, ok = neonRegs(bad[0], vfp.D0, Q1, Q2)
	_, ok = neonRegs(bad[1], Q0, Q1, Q15 + 1)
	_, ok = neonRegs(bad[2], vfp.S0, vfp.D1, vfp.D2)
	for i := 0; i < len(bad); i++ {
		if !bad[i].HasError { return fail("a mix of NEON registers was taken") }
	}
	return ""
}
