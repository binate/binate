package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The data types an operation's integer form takes (neonOp.kind): integers of no sign (I),
// signed or unsigned (S / U, the U bit the sign), signed only, a size alone, or none or any size
// (the bitwise operations, whose bits 21:20 are fixed); and unsigned, a data type's kind only
// (neonSize).
const (
	neonKindNone int = iota
	neonKindI
	neonKindSU
	neonKindS
	neonKindSize
	neonKindBits
	neonKindU
)

// neonOp is how a three-same operation (THREE_VADD .. THREE_VMINNM, THREE_VQRDMLAH and
// THREE_VQRDMLSH) is encoded: its integer form's kind (neonKind*), U bit (-1 when the sign sets
// it), opcode, B bit and sizes (a mask: 1 for 8 bits, 2 for 16, 4 for 32, 8 for 64), or a bitwise
// form's bits 21:20 (cc); whether it has a P8 form (U 1, size 0); its floating-point form's U bit,
// bit 21, opcode and B bit (fOpc -1 for none); whether it takes D registers only.
type neonOp struct {
	kind  int
	iU    int
	iOpc  int
	iB    int
	sizes int
	cc    int
	poly  bool
	fU    int
	f21   int
	fOpc  int
	fB    int
	dOnly bool
}

// neonInt returns an operation with an integer form of kind kind, U bit u (-1 for the sign's),
// opcode opc, B bit b and sizes sizes, and no floating-point form.
func neonInt(kind int, u int, opc int, b int, sizes int) neonOp {
	var o neonOp
	o.kind = kind
	o.iU = u
	o.iOpc = opc
	o.iB = b
	o.sizes = sizes
	o.fOpc = -1
	return o
}

// neonFloat returns o with a floating-point form: U bit u, bit 21 b21, opcode opc, B bit b.
func neonFloat(o neonOp, u int, b21 int, opc int, b int) neonOp {
	o.fU = u
	o.f21 = b21
	o.fOpc = opc
	o.fB = b
	return o
}

// neonBits returns a bitwise operation: opcode 0001, B 1, U bit u, bits 21:20 cc.
func neonBits(u int, cc int) neonOp {
	var o neonOp = neonInt(neonKindBits, u, 1, 1, 0)
	o.cc = cc
	return o
}

// threeOp returns how op (THREE_*; threeSHA encodes the SHA ones) is encoded, its kind
// neonKindNone for no such operation.
func threeOp(op int) neonOp {
	var none neonOp = neonInt(neonKindNone, 0, -1, 0, 0)
	var o neonOp = none
	if op == THREE_VADD { o = neonFloat(neonInt(neonKindI, 0, 8, 0, 15), 0, 0, 13, 0) }
	if op == THREE_VSUB { o = neonFloat(neonInt(neonKindI, 1, 8, 0, 15), 0, 1, 13, 0) }
	if op == THREE_VHADD { o = neonInt(neonKindSU, -1, 0, 0, 7) }
	if op == THREE_VHSUB { o = neonInt(neonKindSU, -1, 2, 0, 7) }
	if op == THREE_VRHADD { o = neonInt(neonKindSU, -1, 1, 0, 7) }
	if op == THREE_VQADD { o = neonInt(neonKindSU, -1, 0, 1, 15) }
	if op == THREE_VQSUB { o = neonInt(neonKindSU, -1, 2, 1, 15) }
	if op >= THREE_VAND && op <= THREE_VBIF {
		var i int = op - THREE_VAND
		o = neonBits(i / 4, i % 4)
	}
	if op == THREE_VCEQ { o = neonFloat(neonInt(neonKindI, 1, 8, 1, 7), 0, 0, 14, 0) }
	if op == THREE_VCGE { o = neonFloat(neonInt(neonKindSU, -1, 3, 1, 7), 1, 0, 14, 0) }
	if op == THREE_VCGT { o = neonFloat(neonInt(neonKindSU, -1, 3, 0, 7), 1, 1, 14, 0) }
	if op == THREE_VACGE { o = neonFloat(none, 1, 0, 14, 1) }
	if op == THREE_VACGT { o = neonFloat(none, 1, 1, 14, 1) }
	if op == THREE_VTST { o = neonInt(neonKindSize, 0, 8, 1, 7) }
	if op == THREE_VABD { o = neonFloat(neonInt(neonKindSU, -1, 7, 0, 7), 1, 1, 13, 0) }
	if op == THREE_VABA { o = neonInt(neonKindSU, -1, 7, 1, 7) }
	if op == THREE_VMAX { o = neonFloat(neonInt(neonKindSU, -1, 6, 0, 7), 0, 0, 15, 0) }
	if op == THREE_VMIN { o = neonFloat(neonInt(neonKindSU, -1, 6, 1, 7), 0, 1, 15, 0) }
	if op == THREE_VPADD { o = neonFloat(neonInt(neonKindI, 0, 11, 1, 7), 1, 0, 13, 0) }
	if op == THREE_VPMAX { o = neonFloat(neonInt(neonKindSU, -1, 10, 0, 7), 1, 0, 15, 0) }
	if op == THREE_VPMIN { o = neonFloat(neonInt(neonKindSU, -1, 10, 1, 7), 1, 1, 15, 0) }
	if op == THREE_VMUL {
		o = neonFloat(neonInt(neonKindI, 0, 9, 1, 7), 1, 0, 13, 1)
		o.poly = true
	}
	if op == THREE_VMLA { o = neonFloat(neonInt(neonKindI, 0, 9, 0, 7), 0, 0, 13, 1) }
	if op == THREE_VMLS { o = neonFloat(neonInt(neonKindI, 1, 9, 0, 7), 0, 1, 13, 1) }
	if op == THREE_VQDMULH { o = neonInt(neonKindS, 0, 11, 0, 6) }
	if op == THREE_VQRDMULH { o = neonInt(neonKindS, 1, 11, 0, 6) }
	if op == THREE_VQRDMLAH { o = neonInt(neonKindS, 1, 11, 1, 6) }
	if op == THREE_VQRDMLSH { o = neonInt(neonKindS, 1, 12, 1, 6) }
	if op == THREE_VRECPS { o = neonFloat(none, 0, 0, 15, 1) }
	if op == THREE_VRSQRTS { o = neonFloat(none, 0, 1, 15, 1) }
	if op >= THREE_VSHL && op <= THREE_VQRSHL {
		var i int = op - THREE_VSHL
		o = neonInt(neonKindSU, -1, 4 + i % 2, i / 2, 15)
	}
	if op == THREE_VFMA { o = neonFloat(none, 0, 0, 12, 1) }
	if op == THREE_VFMS { o = neonFloat(none, 0, 1, 12, 1) }
	if op == THREE_VMAXNM { o = neonFloat(none, 1, 0, 15, 1) }
	if op == THREE_VMINNM { o = neonFloat(none, 1, 1, 15, 1) }
	o.dOnly = op == THREE_VPADD || op == THREE_VPMAX || op == THREE_VPMIN
	return o
}

// neonSize returns data type dt's size code (0 for 8 bits .. 3 for 64) and its kind: neonKindI for
// I, neonKindS for S, neonKindU for U, neonKindSize for a size alone, or neonKindNone for another.
func neonSize(dt int) (int, int) {
	if dt >= DT_I8 && dt <= DT_I64 { return dt - DT_I8, neonKindI }
	if dt >= DT_S8 && dt <= DT_S64 { return dt - DT_S8, neonKindS }
	if dt >= DT_U8 && dt <= DT_U64 { return dt - DT_U8, neonKindU }
	if dt >= DT_8 && dt <= DT_64 { return dt - DT_8, neonKindSize }
	return 0, neonKindNone
}

// neonIntFields returns the U bit and size code op's integer form o has for data type dt, or ok
// false: an I form takes I types, an S / U form S and U ones (U setting the U bit), a signed-only
// form S ones, a size form sizes, each among the form's sizes.
func neonIntFields(o neonOp, dt int) (uint32, uint32, bool) {
	size, kind := neonSize(dt)
	var ok bool = kind == o.kind
	if o.kind == neonKindSU { ok = kind == neonKindS || kind == neonKindU }
	if !ok || o.sizes & (1 << size) == 0 { return 0, 0, false }
	var u int = o.iU
	if u < 0 { u = 0 }
	if kind == neonKindU { u = 1 }
	return cast(uint32, u), cast(uint32, size), true
}

// Three emits the NEON instruction op (THREE_*) of data type dt (DT_*, or 0 for none) on D
// registers vd, vn, vm (vfp.D0..D31) or Q registers (Q0..Q15).
func Three(a @asm.Assembler, op int, dt int, vd int, vn int, vm int) {
	if op >= THREE_SHA1C && op <= THREE_SHA256SU1 {
		threeSHA(a, op, dt, vd, vn, vm)
		return
	}
	var o neonOp = threeOp(op)
	if o.kind == neonKindNone && o.fOpc < 0 {
		a.SetError("arm32: no such NEON operation")
		return
	}
	q, ok := neonRegs(a, vd, vn, vm)
	if !ok { return }
	if q && o.dOnly {
		a.SetError("arm32: a pairwise NEON operation takes D registers")
		return
	}
	var u uint32
	var cc uint32
	var opc int = o.iOpc
	var b int = o.iB
	if dt == DT_F16 || dt == DT_F32 {
		if o.fOpc < 0 {
			a.SetError("arm32: the NEON operation has no floating-point form")
			return
		}
		u = cast(uint32, o.fU)
		cc = cast(uint32, o.f21 * 2) | bitIf(dt == DT_F16, 1)
		opc = o.fOpc
		b = o.fB
	} else if dt == DT_P8 && o.poly {
		u = 1
	} else if o.kind == neonKindBits {
		_, kind := neonSize(dt)
		if dt != 0 && kind != neonKindSize {
			a.SetError("arm32: a bitwise NEON operation takes no data type but a size")
			return
		}
		u = cast(uint32, o.iU)
		cc = cast(uint32, o.cc)
	} else {
		u, cc, ok = neonIntFields(o, dt)
		if !ok {
			a.SetError("arm32: the NEON operation has no form of that data type")
			return
		}
	}
	arm32.Emit32(a,
			0xF2000000 | (u << 24) | placeD(vd) | (cc << 20) | placeN(vn) | (cast(uint32, opc) << 8) |
					placeM(vm) | bitIf(q, 0x40) | (cast(uint32, b) << 4))
}

// threeSHA emits SHA1C .. SHA256SU1 (op, THREE_SHA1C .. THREE_SHA256SU1): 1111 001U 0Dcc nnnn dddd
// 1100 NQM0 mmmm, U set for SHA256H .. SHA256SU1 and cc the operation's place among its four or
// three, of data type DT_32 on Q registers vd, vn, vm (Q0..Q15).
func threeSHA(a @asm.Assembler, op int, dt int, vd int, vn int, vm int) {
	if dt != DT_32 {
		a.SetError("arm32: SHA1C .. SHA256SU1 take the data type 32")
		return
	}
	if !isQ(vd) || !isQ(vn) || !isQ(vm) {
		a.SetError("arm32: SHA1C .. SHA256SU1 take Q registers")
		return
	}
	var i int = op - THREE_SHA1C
	arm32.Emit32(a,
			0xF2000C40 | (bitIf(i >= 4, 1) << 24) | placeD(vd) | (cast(uint32, i % 4) << 20) | placeN(vn) |
					placeM(vm))
}
