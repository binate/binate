package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// Three-same operations as clang assembles them: VADD.I8 D31, D30, D29; VHADD.U32 Q15, Q14, Q13;
// VQADD.S64 Q8, Q9, Q10; VAND D16, D17, D18; VORN Q0, Q1, Q2; VCEQ.F16 Q1, Q2, Q3; VMUL.P8 Q0, Q1,
// Q2; VTST.16 D0, D1, D2; VPADD.F32 D0, D1, D2; VSHL.U64 Q0, Q1, Q2 (Vm Q1, Vn Q2); VFMA.F32 Q0,
// Q1, Q2; VMAXNM.F16 D0, D1, D2; VQRDMULH.S32 Q4, Q5, Q6; VBIF Q7, Q8, Q9; VSUB.I64 D0, D1, D2;
// VMIN.F32 Q15, Q0, Q15; VABD.S16 D5, D6, D7; VAND.32 D16, D17, D18 (a size, ignored).
func TestNeonThree() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Three(a, THREE_VADD, DT_I8, vfp.D31, vfp.D30, vfp.D29)
	Three(a, THREE_VHADD, DT_U32, Q15, Q14, Q13)
	Three(a, THREE_VQADD, DT_S64, Q8, Q9, Q10)
	Three(a, THREE_VAND, 0, vfp.D16, vfp.D17, vfp.D18)
	Three(a, THREE_VORN, 0, Q0, Q1, Q2)
	Three(a, THREE_VCEQ, DT_F16, Q1, Q2, Q3)
	Three(a, THREE_VMUL, DT_P8, Q0, Q1, Q2)
	Three(a, THREE_VTST, DT_16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VPADD, DT_F32, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VSHL, DT_U64, Q0, Q2, Q1)
	Three(a, THREE_VFMA, DT_F32, Q0, Q1, Q2)
	Three(a, THREE_VMAXNM, DT_F16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VQRDMULH, DT_S32, Q4, Q5, Q6)
	Three(a, THREE_VBIF, 0, Q7, Q8, Q9)
	Three(a, THREE_VSUB, DT_I64, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VMIN, DT_F32, Q15, Q0, Q15)
	Three(a, THREE_VABD, DT_S16, vfp.D5, vfp.D6, vfp.D7)
	Three(a, THREE_VAND, DT_32, vfp.D16, vfp.D17, vfp.D18)
	if !wordsAre(a,
			@[]uint32{0xF24EF8AD, 0xF36CE0EA, 0xF27200F4, 0xF24101B2, 0xF2320154, 0xF2142E46, 0xF3020954,
					0xF2110812, 0xF3010D02, 0xF3340442, 0xF2020C54, 0xF3110F12, 0xF32A8B4C, 0xF330E1F2, 0xF3310802,
					0xF260EF6E, 0xF2165707, 0xF24101B2}) {
		return fail("a NEON three-same operation is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: no such operation; a data type the
// operation has not (VHADD.I8, VHADD.S64, VQDMULH.S8, VADD.P8, VAND.F32, VACGE.S32, VRECPS.I32,
// VTST.I8); a pairwise operation on Q registers; a mix of D and Q registers.
func TestNeonThreeRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Three(bad[0], 0, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[1], THREE_VHADD, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[2], THREE_VHADD, DT_S64, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[3], THREE_VQDMULH, DT_S8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[4], THREE_VADD, DT_P8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[5], THREE_VAND, DT_F32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[6], THREE_VACGE, DT_S32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[7], THREE_VRECPS, DT_I32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[8], THREE_VTST, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[9], THREE_VPADD, DT_I8, Q0, Q1, Q2)
	Three(bad[10], THREE_VADD, DT_I8, vfp.D0, Q1, vfp.D2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON three-same operation was taken") }
	}
	return ""
}
