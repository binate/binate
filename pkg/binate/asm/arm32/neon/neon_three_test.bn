package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// Three-same operations as clang assembles them: VADD.I8 D31, D30, D29; VHADD.U32 Q15, Q14, Q13;
// VQADD.S64 Q8, Q9, Q10; VAND D16, D17, D18; VORN Q0, Q1, Q2; VCEQ.F16 Q1, Q2, Q3; VMUL.P8 Q0, Q1,
// Q2; VTST.16 D0, D1, D2; VPADD.F32 D0, D1, D2; VSHL.U64 Q0, Q1, Q2 (Vm Q1, Vn Q2); VFMA.F32 Q0,
// Q1, Q2; VMAXNM.F16 D0, D1, D2; VQRDMULH.S32 Q4, Q5, Q6; VBIF Q7, Q8, Q9; VSUB.I64 D0, D1, D2;
// VMIN.F32 Q15, Q0, Q15; VABD.S16 D5, D6, D7; VAND.32 D16, D17, D18 (a size, ignored).
func TestNeonThree() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Three(a, THREE_VADD, DT_I8, vfp.D31, vfp.D30, vfp.D29)
	Three(a, THREE_VHADD, DT_U32, Q15, Q14, Q13)
	Three(a, THREE_VQADD, DT_S64, Q8, Q9, Q10)
	Three(a, THREE_VAND, 0, vfp.D16, vfp.D17, vfp.D18)
	Three(a, THREE_VORN, 0, Q0, Q1, Q2)
	Three(a, THREE_VCEQ, DT_F16, Q1, Q2, Q3)
	Three(a, THREE_VMUL, DT_P8, Q0, Q1, Q2)
	Three(a, THREE_VTST, DT_16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VPADD, DT_F32, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VSHL, DT_U64, Q0, Q2, Q1)
	Three(a, THREE_VFMA, DT_F32, Q0, Q1, Q2)
	Three(a, THREE_VMAXNM, DT_F16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VQRDMULH, DT_S32, Q4, Q5, Q6)
	Three(a, THREE_VBIF, 0, Q7, Q8, Q9)
	Three(a, THREE_VSUB, DT_I64, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VMIN, DT_F32, Q15, Q0, Q15)
	Three(a, THREE_VABD, DT_S16, vfp.D5, vfp.D6, vfp.D7)
	Three(a, THREE_VAND, DT_32, vfp.D16, vfp.D17, vfp.D18)
	if !wordsAre(a,
			@[]uint32{0xF24EF8AD, 0xF36CE0EA, 0xF27200F4, 0xF24101B2, 0xF2320154, 0xF2142E46, 0xF3020954,
					0xF2110812, 0xF3010D02, 0xF3340442, 0xF2020C54, 0xF3110F12, 0xF32A8B4C, 0xF330E1F2, 0xF3310802,
					0xF260EF6E, 0xF2165707, 0xF24101B2}) {
		return fail("a NEON three-same operation is not clang's word")
	}
	return ""
}

// ARMv8's SHA ones as clang assembles them: SHA1C, SHA1P, SHA1M, SHA1SU0, SHA256H, SHA256H2 and
// SHA256SU1 on Q0, Q1, Q2, and SHA1C and SHA256SU1 on Q15, Q14, Q13 and Q8, Q0, Q9.
func TestNeonThreeSHA() testing.TestResult {
	var a @asm.Assembler = newAsm()
	for op := THREE_SHA1C; op <= THREE_SHA256SU1; op++ { Three(a, op, DT_32, Q0, Q1, Q2) }
	Three(a, THREE_SHA1C, DT_32, Q15, Q14, Q13)
	Three(a, THREE_SHA256SU1, DT_32, Q15, Q14, Q13)
	Three(a, THREE_SHA1C, DT_32, Q8, Q0, Q9)
	Three(a, THREE_SHA256SU1, DT_32, Q8, Q0, Q9)
	if !wordsAre(a,
			@[]uint32{0xF2020C44, 0xF2120C44, 0xF2220C44, 0xF2320C44, 0xF3020C44, 0xF3120C44, 0xF3220C44,
					0xF24CECEA, 0xF36CECEA, 0xF2400C62, 0xF3600C62}) {
		return fail("a NEON SHA instruction is not clang's word")
	}
	return ""
}

// The SHA ones of another data type (none, I32, F32, 8) or on D registers, or a mix, are errors
// that emit nothing.
func TestNeonThreeSHARejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 6)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Three(bad[0], THREE_SHA1C, 0, Q0, Q1, Q2)
	Three(bad[1], THREE_SHA1P, DT_I32, Q0, Q1, Q2)
	Three(bad[2], THREE_SHA256H, DT_F32, Q0, Q1, Q2)
	Three(bad[3], THREE_SHA256SU1, DT_8, Q0, Q1, Q2)
	Three(bad[4], THREE_SHA1M, DT_32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[5], THREE_SHA1SU0, DT_32, Q0, Q1, vfp.D2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON SHA instruction was taken") }
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: no such operation; a data type the
// operation has not (VHADD.I8, VHADD.S64, VQDMULH.S8, VADD.P8, VAND.F32, VACGE.S32, VRECPS.I32,
// VTST.I8); a pairwise operation on Q registers; a mix of D and Q registers.
func TestNeonThreeRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Three(bad[0], 0, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[1], THREE_VHADD, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[2], THREE_VHADD, DT_S64, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[3], THREE_VQDMULH, DT_S8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[4], THREE_VADD, DT_P8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[5], THREE_VAND, DT_F32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[6], THREE_VACGE, DT_S32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[7], THREE_VRECPS, DT_I32, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[8], THREE_VTST, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[9], THREE_VPADD, DT_I8, Q0, Q1, Q2)
	Three(bad[10], THREE_VADD, DT_I8, vfp.D0, Q1, vfp.D2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON three-same operation was taken") }
	}
	return ""
}

// The floating-point rows and the multiply-accumulates as clang assembles them: VADD.F32 D0, D1,
// D2; VADD.F16 Q8, Q9, Q10; VSUB.F32 Q15, Q14, Q13; VSUB.F16 D3, D4, D5; VMUL.F32 D6, D7, D8;
// VMUL.F16 Q2, Q3, Q4; VMLA.F32 Q0, Q1, Q2; VMLA.F16 D16, D17, D18; VMLS.F32 D31, D30, D29;
// VMLS.F16 Q5, Q6, Q7; VFMS.F32 Q0, Q1, Q2; VFMS.F16 D0, D1, D2; VFMA.F16 Q9, Q10, Q11; VMINNM.F32
// D0, D1, D2; VMINNM.F16 Q1, Q2, Q3; VMAXNM.F32 Q8, Q9, Q10; VMLA.I16 D0, D1, D2; VMLS.I32 Q0,
// Q1, Q2; VMUL.I8 D0, D1, D2; VMLS.I8 D16, D17, D18.
func TestNeonThreeFloat() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Three(a, THREE_VADD, DT_F32, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VADD, DT_F16, Q8, Q9, Q10)
	Three(a, THREE_VSUB, DT_F32, Q15, Q14, Q13)
	Three(a, THREE_VSUB, DT_F16, vfp.D3, vfp.D4, vfp.D5)
	Three(a, THREE_VMUL, DT_F32, vfp.D6, vfp.D7, vfp.D8)
	Three(a, THREE_VMUL, DT_F16, Q2, Q3, Q4)
	Three(a, THREE_VMLA, DT_F32, Q0, Q1, Q2)
	Three(a, THREE_VMLA, DT_F16, vfp.D16, vfp.D17, vfp.D18)
	Three(a, THREE_VMLS, DT_F32, vfp.D31, vfp.D30, vfp.D29)
	Three(a, THREE_VMLS, DT_F16, Q5, Q6, Q7)
	Three(a, THREE_VFMS, DT_F32, Q0, Q1, Q2)
	Three(a, THREE_VFMS, DT_F16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VFMA, DT_F16, Q9, Q10, Q11)
	Three(a, THREE_VMINNM, DT_F32, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VMINNM, DT_F16, Q1, Q2, Q3)
	Three(a, THREE_VMAXNM, DT_F32, Q8, Q9, Q10)
	Three(a, THREE_VMLA, DT_I16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VMLS, DT_I32, Q0, Q1, Q2)
	Three(a, THREE_VMUL, DT_I8, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VMLS, DT_I8, vfp.D16, vfp.D17, vfp.D18)
	if !wordsAre(a,
			@[]uint32{0xF2010D02, 0xF2520DE4, 0xF26CEDEA, 0xF2343D05, 0xF3076D18, 0xF3164D58, 0xF2020D54,
					0xF2510DB2, 0xF26EFDBD, 0xF23CAD5E, 0xF2220C54, 0xF2310C12, 0xF2542CF6, 0xF3210F12, 0xF3342F56,
					0xF3420FF4, 0xF2110902, 0xF3220944, 0xF2010912, 0xF34109A2}) {
		return fail("a NEON floating-point or multiply-accumulate operation is not clang's word")
	}
	return ""
}

// ARMv8.1's VQRDMLAH and VQRDMLSH as clang assembles them, .S16 and .S32 on D and Q registers, high
// registers too; another data type (I16, U16, S8, S64, F32) is an error that emits nothing.
func TestNeonThreeV8_1() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Three(a, THREE_VQRDMLAH, DT_S16, vfp.D0, vfp.D1, vfp.D2)
	Three(a, THREE_VQRDMLAH, DT_S32, Q0, Q1, Q2)
	Three(a, THREE_VQRDMLAH, DT_S16, vfp.D31, vfp.D30, vfp.D29)
	Three(a, THREE_VQRDMLSH, DT_S32, Q15, Q14, Q13)
	Three(a, THREE_VQRDMLSH, DT_S16, Q0, Q1, Q2)
	Three(a, THREE_VQRDMLSH, DT_S32, vfp.D0, vfp.D1, vfp.D2)
	if !wordsAre(a,
			@[]uint32{0xF3110B12, 0xF3220B54, 0xF35EFBBD, 0xF36CECFA, 0xF3120C54, 0xF3210C12}) {
		return fail("a NEON VQRDMLAH / VQRDMLSH is not clang's word")
	}
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 5)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Three(bad[0], THREE_VQRDMLAH, DT_I16, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[1], THREE_VQRDMLAH, DT_U16, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[2], THREE_VQRDMLSH, DT_S8, vfp.D0, vfp.D1, vfp.D2)
	Three(bad[3], THREE_VQRDMLSH, DT_S64, Q0, Q1, Q2)
	Three(bad[4], THREE_VQRDMLAH, DT_F32, Q0, Q1, Q2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON VQRDMLAH / VQRDMLSH was taken") }
	}
	return ""
}
