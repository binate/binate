package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The register lengths of a two-register operation (twoOp.shape): both one length; a D register of
// a Q register's elements; a Q register of a D register's; Q registers only.  All but the first
// take their operation in bits 10:6, bit 6 not the Q bit.
const (
	twoSame int = iota
	twoNarrow
	twoLong
	twoQuad
)

// twoOp is how a two-register miscellaneous operation (TWO_*) is encoded: its row (bits 17:16, -1
// for no such operation); its integer form's kind (neonKind*, neonKindNone for none), operation
// (bits 10:7, or 10:6) and sizes (a mask: 1 for 8 bits, 2 for 16, 4 for 32, 8 for 64; a narrowing
// one's those of the Q register's elements); what an unsigned data type adds to the operation; its
// floating-point form's operation (-1 for none); its registers' lengths (two*); and a size field
// it fixes, with no data type (-1 for none).
type twoOp struct {
	row   int
	kind  int
	opc   int
	sizes int
	uAdd  int
	fOpc  int
	shape int
	fixed int
}

// twoInt returns an operation of row row with an integer form of kind kind, operation opc and
// sizes sizes, and no floating-point form.
func twoInt(row int, kind int, opc int, sizes int) twoOp {
	var o twoOp
	o.row = row
	o.kind = kind
	o.opc = opc
	o.sizes = sizes
	o.fOpc = -1
	o.fixed = -1
	return o
}

// twoFloat returns o with a floating-point form, operation opc.
func twoFloat(o twoOp, opc int) twoOp {
	o.fOpc = opc
	return o
}

// twoShaped returns o with registers of shape shape (two*) and size field fixed (-1 for none).
func twoShaped(o twoOp, shape int, fixed int) twoOp {
	o.shape = shape
	o.fixed = fixed
	return o
}

// twoOps returns how op (TWO_*) is encoded, its row -1 for no such operation.
func twoOps(op int) twoOp {
	var o twoOp = twoInt(-1, neonKindNone, 0, 0)
	var none int = neonKindNone
	if op == TWO_VREV64 { o = twoInt(0, neonKindSize, 0, 7) }
	if op == TWO_VREV32 { o = twoInt(0, neonKindSize, 1, 3) }
	if op == TWO_VREV16 { o = twoInt(0, neonKindSize, 2, 1) }
	if op == TWO_VPADDL { o = twoInt(0, neonKindSU, 4, 7) }
	if op == TWO_VCLS { o = twoInt(0, neonKindS, 8, 7) }
	if op == TWO_VCLZ { o = twoInt(0, neonKindI, 9, 7) }
	if op == TWO_VCNT { o = twoInt(0, neonKindSize, 10, 1) }
	if op == TWO_VMVN { o = twoInt(0, neonKindBits, 11, 15) }
	if op == TWO_VPADAL { o = twoInt(0, neonKindSU, 12, 7) }
	if op == TWO_VQABS { o = twoInt(0, neonKindS, 14, 7) }
	if op == TWO_VQNEG { o = twoInt(0, neonKindS, 15, 7) }
	if op >= TWO_VCGT0 && op <= TWO_VCLT0 {
		var i int = op - TWO_VCGT0
		var kind int = neonKindS
		if op == TWO_VCEQ0 { kind = neonKindI }
		o = twoFloat(twoInt(1, kind, i, 7), 8 + i)
	}
	if op == TWO_VABS { o = twoFloat(twoInt(1, neonKindS, 6, 7), 14) }
	if op == TWO_VNEG { o = twoFloat(twoInt(1, neonKindS, 7, 7), 15) }
	if op == TWO_VSWP { o = twoInt(2, neonKindBits, 0, 15) }
	if op >= TWO_VTRN && op <= TWO_VZIP { o = twoInt(2, neonKindSize, 1 + op - TWO_VTRN, 7) }
	if op == TWO_VMOVN { o = twoShaped(twoInt(2, neonKindI, 8, 14), twoNarrow, -1) }
	if op == TWO_VQMOVUN { o = twoShaped(twoInt(2, neonKindS, 9, 14), twoNarrow, -1) }
	if op == TWO_VQMOVN { o = twoShaped(twoInt(2, neonKindSU, 10, 14), twoNarrow, -1) }
	if op == TWO_VRECPE { o = twoFloat(twoInt(3, neonKindU, 8, 4), 10) }
	if op == TWO_VRSQRTE { o = twoFloat(twoInt(3, neonKindU, 9, 4), 11) }
	if op == TWO_VCVT_F16_F32 { o = twoShaped(twoInt(2, none, 24, 0), twoNarrow, 1) }
	if op == TWO_VCVT_BF16_F32 { o = twoShaped(twoInt(2, none, 25, 0), twoNarrow, 1) }
	if op == TWO_VCVT_F32_F16 { o = twoShaped(twoInt(2, none, 28, 0), twoLong, 1) }
	if op >= TWO_VRINTN && op <= TWO_VRINTP {
		var rint @[]int = @[]int{8, 9, 10, 11, 13, 15}
		o = twoFloat(twoInt(2, none, 0, 0), rint[op - TWO_VRINTN])
	}
	if op >= TWO_VCVTA && op <= TWO_VCVTM { o = twoInt(3, neonKindSU, 2 * (op - TWO_VCVTA), 6) }
	if op >= TWO_AESE && op <= TWO_AESIMC {
		o = twoShaped(twoInt(0, neonKindSize, 12 + op - TWO_AESE, 1), twoQuad, -1)
	}
	if op == TWO_SHA1H { o = twoShaped(twoInt(1, neonKindSize, 11, 4), twoQuad, -1) }
	if op == TWO_SHA1SU1 { o = twoShaped(twoInt(2, neonKindSize, 14, 4), twoQuad, -1) }
	if op == TWO_SHA256SU0 { o = twoShaped(twoInt(2, neonKindSize, 15, 4), twoQuad, -1) }
	var unsigned bool = op == TWO_VPADDL || op == TWO_VPADAL || op == TWO_VQMOVN
	if unsigned || (op >= TWO_VCVTA && op <= TWO_VCVTM) { o.uAdd = 1 }
	return o
}

// twoRegs reports whether vd and vm have the lengths shape (two*) takes, and whether they are Q
// registers (a same-length operation's).
func twoRegs(shape int, vd int, vm int) (bool, bool) {
	if shape == twoNarrow { return isD(vd) && isQ(vm), false }
	if shape == twoLong { return isQ(vd) && isD(vm), false }
	if shape == twoQuad { return isQ(vd) && isQ(vm), false }
	return shiftRegs(shiftSame, vd, vm)
}

// Two emits the NEON instruction op (TWO_*) of data type dt (DT_*, or 0 for none) on D registers
// vd, vm (vfp.D0..D31) or Q registers (Q0..Q15) of the lengths op takes.
func Two(a @asm.Assembler, op int, dt int, vd int, vm int) {
	var o twoOp = twoOps(op)
	if o.row < 0 {
		a.SetError("arm32: no such NEON operation")
		return
	}
	regs, q := twoRegs(o.shape, vd, vm)
	if !regs {
		a.SetError("arm32: the NEON instruction's registers are not of the lengths it takes")
		return
	}
	var ok bool = false
	var size int = 0
	var opc int = o.opc
	if o.fixed >= 0 {
		ok = dt == 0
		size = o.fixed
	} else if dt == DT_F32 || dt == DT_F16 {
		ok = o.fOpc >= 0
		opc = o.fOpc
		size = 2
		if dt == DT_F16 { size = 1 }
	} else if o.kind == neonKindBits {
		ok = dt == 0 || (dt >= DT_8 && dt <= DT_64)
	} else {
		sz, kind := neonSize(dt)
		ok = kind == o.kind || (o.kind == neonKindSU && (kind == neonKindS || kind == neonKindU))
		ok = ok && o.sizes & (1 << sz) != 0
		if kind == neonKindU { opc = opc + o.uAdd }
		size = sz
	}
	if o.shape == twoNarrow && o.fixed < 0 { size = size - 1 }
	if (op == TWO_VUZP || op == TWO_VZIP) && o.shape == twoSame && !q && size == 2 {
		// VUZP.32 and VZIP.32 on D registers have no encoding (VTRN.32 is the same permutation).
		ok = false
	}
	if !ok {
		a.SetError("arm32: the NEON operation has no form of that data type")
		return
	}
	var fields uint32 = cast(uint32, opc) << 7 | bitIf(q, 0x40)
	if o.shape != twoSame { fields = cast(uint32, opc) << 6 }
	arm32.Emit32(a,
			0xF3B00000 | (cast(uint32, size) << 18) | (cast(uint32, o.row) << 16) | placeD(vd) | fields |
					placeM(vm))
}
