package "pkg/binate/asm/arm32/neon"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32/vfp"
import "pkg/builtins/testing"

// The reverses, pairwise adds, counts, VMVN and the saturating absolute value and negation as
// clang assembles them: VREV64.8 D0, D1; VREV64.32 D0, D1; VREV32.16 D0, D1; VREV16.8 D0, D1;
// VREV64.8 Q0, Q1; VREV64.8 Q15, Q14; VREV64.8 D31, D30; VPADDL.S8 / .U32; VPADAL.U16; VCLS.S32;
// VCLZ.I16; VCNT.8 D0, D1 and Q15, Q14; VMVN with no data type and with .32; VQABS.S16;
// VQNEG.S8 (D0, D1 where no registers are named).
func TestNeonTwoRowZero() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var d0 int = vfp.D0
	var d1 int = vfp.D1
	Two(a, TWO_VREV64, DT_8, d0, d1)
	Two(a, TWO_VREV64, DT_32, d0, d1)
	Two(a, TWO_VREV32, DT_16, d0, d1)
	Two(a, TWO_VREV16, DT_8, d0, d1)
	Two(a, TWO_VREV64, DT_8, Q0, Q1)
	Two(a, TWO_VREV64, DT_8, Q15, Q14)
	Two(a, TWO_VREV64, DT_8, vfp.D31, vfp.D30)
	Two(a, TWO_VPADDL, DT_S8, d0, d1)
	Two(a, TWO_VPADDL, DT_U32, d0, d1)
	Two(a, TWO_VPADAL, DT_U16, d0, d1)
	Two(a, TWO_VCLS, DT_S32, d0, d1)
	Two(a, TWO_VCLZ, DT_I16, d0, d1)
	Two(a, TWO_VCNT, DT_8, d0, d1)
	Two(a, TWO_VCNT, DT_8, Q15, Q14)
	Two(a, TWO_VMVN, 0, d0, d1)
	Two(a, TWO_VMVN, DT_32, d0, d1)
	Two(a, TWO_VQABS, DT_S16, d0, d1)
	Two(a, TWO_VQNEG, DT_S8, d0, d1)
	if !wordsAre(a,
			@[]uint32{0xF3B00001, 0xF3B80001, 0xF3B40081, 0xF3B00101, 0xF3B00042, 0xF3F0E06C, 0xF3F0F02E,
					0xF3B00201, 0xF3B80281, 0xF3B40681, 0xF3B80401, 0xF3B40481, 0xF3B00501, 0xF3F0E56C, 0xF3B00581,
					0xF3B00581, 0xF3B40701, 0xF3B00781}) {
		return fail("a NEON two-register instruction is not clang's word")
	}
	return ""
}

// VABS, VNEG and the comparisons with 0 as clang assembles them: VABS.S8; VABS.F32 D0, D1 and Q0,
// Q1; VNEG.S32; VABS.F16; VNEG.F16 Q0, Q1; VCGT.S8; VCGE.S16; VCEQ.I32; VCLE.S8 Q0, Q1; VCLT.S32;
// VCGT.F32; VCGE.F32 Q0, Q1; VCEQ.F32; VCLE.F16; VCLT.F16 Q15, Q14; VCEQ.I8 D31, D30 (D0, D1 where
// no registers are named).
func TestNeonTwoRowOne() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var d0 int = vfp.D0
	var d1 int = vfp.D1
	Two(a, TWO_VABS, DT_S8, d0, d1)
	Two(a, TWO_VABS, DT_F32, d0, d1)
	Two(a, TWO_VABS, DT_F32, Q0, Q1)
	Two(a, TWO_VNEG, DT_S32, d0, d1)
	Two(a, TWO_VABS, DT_F16, d0, d1)
	Two(a, TWO_VNEG, DT_F16, Q0, Q1)
	Two(a, TWO_VCGT0, DT_S8, d0, d1)
	Two(a, TWO_VCGE0, DT_S16, d0, d1)
	Two(a, TWO_VCEQ0, DT_I32, d0, d1)
	Two(a, TWO_VCLE0, DT_S8, Q0, Q1)
	Two(a, TWO_VCLT0, DT_S32, d0, d1)
	Two(a, TWO_VCGT0, DT_F32, d0, d1)
	Two(a, TWO_VCGE0, DT_F32, Q0, Q1)
	Two(a, TWO_VCEQ0, DT_F32, d0, d1)
	Two(a, TWO_VCLE0, DT_F16, d0, d1)
	Two(a, TWO_VCLT0, DT_F16, Q15, Q14)
	Two(a, TWO_VCEQ0, DT_I8, vfp.D31, vfp.D30)
	if !wordsAre(a,
			@[]uint32{0xF3B10301, 0xF3B90701, 0xF3B90742, 0xF3B90381, 0xF3B50701, 0xF3B507C2, 0xF3B10001,
					0xF3B50081, 0xF3B90101, 0xF3B101C2, 0xF3B90201, 0xF3B90401, 0xF3B904C2, 0xF3B90501, 0xF3B50581,
					0xF3F5E66C, 0xF3F1F12E}) {
		return fail("a NEON two-register instruction is not clang's word")
	}
	return ""
}

// The permutes, the narrowing moves and the reciprocal estimates as clang assembles them: VSWP D0,
// D1 and Q15, Q14; VTRN.16; VTRN.32 Q0, Q1; VUZP.8; VUZP.32 Q0, Q1; VZIP.16; VZIP.32 Q0, Q1;
// VMOVN.I16 / .I64, VQMOVN.S16 / .U16, VQMOVUN.S16 / .S64 (D0, Q1); VRECPE.U32; VRECPE.F32 Q0,
// Q1; VRSQRTE.U32; VRSQRTE.F32; VRECPE.F16; VRSQRTE.F16 Q0, Q1 (D0, D1 where no registers are
// named).
func TestNeonTwoRowsTwoThree() testing.TestResult {
	var a @asm.Assembler = newAsm()
	var d0 int = vfp.D0
	var d1 int = vfp.D1
	Two(a, TWO_VSWP, 0, d0, d1)
	Two(a, TWO_VSWP, 0, Q15, Q14)
	Two(a, TWO_VTRN, DT_16, d0, d1)
	Two(a, TWO_VTRN, DT_32, Q0, Q1)
	Two(a, TWO_VUZP, DT_8, d0, d1)
	Two(a, TWO_VUZP, DT_32, Q0, Q1)
	Two(a, TWO_VZIP, DT_16, d0, d1)
	Two(a, TWO_VZIP, DT_32, Q0, Q1)
	Two(a, TWO_VMOVN, DT_I16, d0, Q1)
	Two(a, TWO_VMOVN, DT_I64, d0, Q1)
	Two(a, TWO_VQMOVN, DT_S16, d0, Q1)
	Two(a, TWO_VQMOVN, DT_U16, d0, Q1)
	Two(a, TWO_VQMOVUN, DT_S16, d0, Q1)
	Two(a, TWO_VQMOVUN, DT_S64, d0, Q1)
	Two(a, TWO_VRECPE, DT_U32, d0, d1)
	Two(a, TWO_VRECPE, DT_F32, Q0, Q1)
	Two(a, TWO_VRSQRTE, DT_U32, d0, d1)
	Two(a, TWO_VRSQRTE, DT_F32, d0, d1)
	Two(a, TWO_VRECPE, DT_F16, d0, d1)
	Two(a, TWO_VRSQRTE, DT_F16, Q0, Q1)
	if !wordsAre(a,
			@[]uint32{0xF3B20001, 0xF3F2E06C, 0xF3B60081, 0xF3BA00C2, 0xF3B20101, 0xF3BA0142, 0xF3B60181,
					0xF3BA01C2, 0xF3B20202, 0xF3BA0202, 0xF3B20282, 0xF3B202C2, 0xF3B20242, 0xF3BA0242, 0xF3BB0401,
					0xF3BB0542, 0xF3BB0481, 0xF3BB0581, 0xF3B70501, 0xF3B705C2}) {
		return fail("a NEON two-register instruction is not clang's word")
	}
	return ""
}

// A two-register instruction there is no encoding of is an error that emits nothing: a size the
// operation has not (VREV16.16, VREV32.32, VCNT.16, VPADDL.S64, VMOVN.I8, VABS.S64), a data type
// of another kind (VCLS.U8, VCLZ.S8, VMVN.S8, VQMOVUN.U16, VRECPE.S32, VREV64.F32), VUZP.32 and
// VZIP.32 on D registers, registers of other lengths (D and Q mixed, a narrowing one's Q result),
// no such operation.
func TestNeonTwoRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 17)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	var d0 int = vfp.D0
	var d1 int = vfp.D1
	Two(bad[0], TWO_VREV16, DT_16, d0, d1)
	Two(bad[1], TWO_VREV32, DT_32, d0, d1)
	Two(bad[2], TWO_VCNT, DT_16, d0, d1)
	Two(bad[3], TWO_VPADDL, DT_S64, d0, d1)
	Two(bad[4], TWO_VMOVN, DT_I8, d0, Q1)
	Two(bad[5], TWO_VCLS, DT_U8, d0, d1)
	Two(bad[6], TWO_VCLZ, DT_S8, d0, d1)
	Two(bad[7], TWO_VMVN, DT_S8, d0, d1)
	Two(bad[8], TWO_VQMOVUN, DT_U16, d0, Q1)
	Two(bad[9], TWO_VRECPE, DT_S32, d0, d1)
	Two(bad[10], TWO_VREV64, DT_F32, d0, d1)
	Two(bad[11], TWO_VUZP, DT_32, d0, d1)
	Two(bad[12], TWO_VZIP, DT_32, d0, d1)
	Two(bad[13], TWO_VTRN, DT_8, d0, Q1)
	Two(bad[14], TWO_VMOVN, DT_I16, Q0, Q1)
	Two(bad[15], 999, DT_8, d0, d1)
	Two(bad[16], TWO_VABS, DT_S64, d0, d1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad NEON two-register instruction was taken") }
	}
	return ""
}
