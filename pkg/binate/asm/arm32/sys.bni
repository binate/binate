// Package sys provides the arm32 system and hint instruction encoders, in the manner of
// pkg/binate/asm/arm32: each call emits the one instruction its operands name, or sets the
// assembler error and emits nothing when one has no encoding -- a condition outside
// arm32.COND_EQ..COND_AL, an immediate past its field.
package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// Nop emits NOP{cond}, the ARMv6K hint (0x0320F000 with the condition in bits 31:28); before
// ARMv6K, MOV{cond} R0, R0 stands for it.
func Nop(a @asm.Assembler, cond int)

// Svc emits SVC{cond} #imm24 (supervisor call).  An imm outside 0..0xFFFFFF
// sets an assembler error and emits nothing.
func Svc(a @asm.Assembler, cond int, imm int)

// Bkpt emits BKPT #imm16 (breakpoint, unconditional).  An imm outside 0..0xFFFF
// sets an assembler error and emits nothing.
func Bkpt(a @asm.Assembler, imm int)

// HINT numbers the named hints stand for (Hint).
const (
	HINT_NOP int = 0
	HINT_YIELD int = 1
	HINT_WFE int = 2
	HINT_WFI int = 3
	HINT_SEV int = 4
	HINT_SEVL int = 5
	HINT_ESB int = 16
	HINT_TSB_CSYNC int = 18
	HINT_CSDB int = 20
	HINT_CLRBHB int = 22
)

// Hint emits HINT{cond} #n (n 0..255: NOP, YIELD, WFE, ... are HINT_*).  A condition or n out of
// range sets an assembler error and emits nothing; so do the other encoders here for theirs.
func Hint(a @asm.Assembler, cond int, n int)

// Dbg emits DBG{cond} #option (option 0..15), the hint 0xF0 | option.
func Dbg(a @asm.Assembler, cond int, option int)

// Udf emits UDF #imm16 (permanently undefined, unconditional).
func Udf(a @asm.Assembler, imm int)

// Hvc emits HVC #imm16 (hypervisor call, unconditional).
func Hvc(a @asm.Assembler, imm int)

// Hlt emits HLT #imm16 (halting debug breakpoint, unconditional).
func Hlt(a @asm.Assembler, imm int)

// Smc emits SMC{cond} #imm4 (secure monitor call).
func Smc(a @asm.Assembler, cond int, imm int)

// Eret emits ERET{cond} (exception return).
func Eret(a @asm.Assembler, cond int)

// MSR field-mask bits (Msr, MsrImm): flags (f, APSR_nzcvq), status (s, APSR_g), extension (x)
// and control (c).
const (
	PSR_C int = 1
	PSR_X int = 2
	PSR_S int = 4
	PSR_F int = 8
)

// Mrs emits MRS{cond} Rd, CPSR (or SPSR when spsr); Rd is R0..R14.
func Mrs(a @asm.Assembler, cond int, rd int, spsr bool)

// Msr emits MSR{cond} CPSR_<mask> (or SPSR_<mask>), Rn: mask is a non-empty set of PSR_* bits,
// Rn R0..R15 (PC too, as clang takes it).
func Msr(a @asm.Assembler, cond int, spsr bool, mask int, rn int)

// MsrImm emits MSR{cond} CPSR_<mask> (or SPSR_<mask>), #imm, imm the 8-bit imm8 rotated right
// by 2 * rot (rot 0..15).
func MsrImm(a @asm.Assembler, cond int, spsr bool, mask int, imm8 int, rot int)

// MrsBanked emits MRS{cond} Rd, <banked register>, sysm its number R:M:M1 (0..63: R the SPSR of
// a mode, as the architecture's SYSm table numbers them); Rd is R0..R14.
func MrsBanked(a @asm.Assembler, cond int, rd int, sysm int)

// MsrBanked emits MSR{cond} <banked register>, Rn, sysm as MrsBanked takes it; Rn is R0..R14.
func MsrBanked(a @asm.Assembler, cond int, sysm int, rn int)

// CPS imod values (Cps): change the mode only, enable (IE) or disable (ID) interrupts.
const (
	CPS_NONE int = 0
	CPS_IE int = 2
	CPS_ID int = 3
)

// CPS interrupt flags (Cps): asynchronous abort, IRQ, FIQ.
const (
	CPS_F int = 1
	CPS_I int = 2
	CPS_A int = 4
)

// Cps emits CPS: CPSIE / CPSID (imod CPS_IE / CPS_ID) of the CPS_* flags (none, UNPREDICTABLE, as
// clang takes `none`) and mode 0..31 or -1 for none; or CPS #mode (imod CPS_NONE, flags 0).
func Cps(a @asm.Assembler, imod int, flags int, mode int)

// Setend emits SETEND BE (bigEndian) or SETEND LE.
func Setend(a @asm.Assembler, bigEndian bool)

// Srs emits SRS{mode} SP{!}, #number (store return state to the stack of mode number, 0..31):
// mode is arm32.BT_IA / BT_IB / BT_DA / BT_DB.
func Srs(a @asm.Assembler, mode int, writeback bool, number int)

// Rfe emits RFE{mode} Rn{!} (return from exception): mode as Srs takes it, Rn R0..R15.
func Rfe(a @asm.Assembler, mode int, rn int, writeback bool)

// Setpan emits SETPAN #imm (0 or 1: privileged access never).
func Setpan(a @asm.Assembler, imm int)

// Barrier options (Dmb, Dsb, Isb): the shareability domain -- full system, outer shareable,
// inner shareable, non-shareable -- and the accesses ordered -- all, stores (ST), loads (LD).
const (
	BAR_OSHLD int = 1
	BAR_OSHST int = 2
	BAR_OSH int = 3
	BAR_NSHLD int = 5
	BAR_NSHST int = 6
	BAR_NSH int = 7
	BAR_ISHLD int = 9
	BAR_ISHST int = 10
	BAR_ISH int = 11
	BAR_LD int = 13
	BAR_ST int = 14
	BAR_SY int = 15
)

// Dmb emits DMB #option (data memory barrier), option 0..15 (BAR_*).
func Dmb(a @asm.Assembler, option int)

// Dsb emits DSB #option (data synchronization barrier), option 0..15 (BAR_*).
func Dsb(a @asm.Assembler, option int)

// Isb emits ISB #option (instruction synchronization barrier), option 0..15 (BAR_SY the one
// defined).
func Isb(a @asm.Assembler, option int)

// Sb emits SB (speculation barrier).
func Sb(a @asm.Assembler)

// The coprocessor instructions, each with its `2` form (two: the unconditional encoding; cond must
// be COND_AL): cp, a coprocessor's number, and the coprocessor registers CRn, CRm, CRd are 0..15.

// Mcr emits MCR{cond} (MCR2 when two) coproc, #opc1, Rt, CRn, CRm, #opc2: opc1 and opc2 0..7, Rt
// R0..R15 (PC too, as clang takes it).
func Mcr(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, crn int, crm int, opc2 int)

// Mrc emits MRC{cond} (MRC2 when two), its fields as Mcr takes them; Rt R15 is APSR_nzcv.
func Mrc(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, crn int, crm int, opc2 int)

// Mcrr emits MCRR{cond} (MCRR2 when two) coproc, #opc1, Rt, Rt2, CRm: opc1 0..15, Rt and Rt2
// R0..R14.
func Mcrr(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, rt2 int, crm int)

// Mrrc emits MRRC{cond} (MRRC2 when two), its fields as Mcrr takes them.
func Mrrc(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, rt2 int, crm int)

// Cdp emits CDP{cond} (CDP2 when two) coproc, #opc1, CRd, CRn, CRm, #opc2: opc1 0..15, opc2 0..7.
func Cdp(a @asm.Assembler, cond int, two bool, cp int, opc1 int, crd int, crn int, crm int,
		opc2 int)

// Ldc emits LDC{L}{cond} (LDC2{L} when two; L when long) coproc, CRd, op: [Rn, #±off],
// [Rn, #±off]!, [Rn], #±off (off a multiple of 4 within +/-1020, its negative zero op.Sub --
// with any other offset an error) or a label (an arm32.FIX_LDC_PC fixup, which only a local label
// in the same section resolves).
func Ldc(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, op arm32.Operand)

// Stc emits STC{L}{cond} (STC2{L} when two), its operands as Ldc takes them.
func Stc(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, op arm32.Operand)

// LdcOption emits LDC{L}{cond} (LDC2{L} when two) coproc, CRd, [Rn], {option}, option 0..255.
func LdcOption(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, rn int, option int)

// StcOption emits STC{L}{cond} (STC2{L} when two) coproc, CRd, [Rn], {option}.
func StcOption(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, rn int, option int)
