package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// condBits places the condition code cond, one arm32.CondOk accepts, into bits [31:28].
func condBits(cond int) uint32 { return cast(uint32, cond) << 28 }

// NOP{cond}: cond[31:28] | 0011 0010 0000 1111 0000 0000 0000 (the hint with op 0).  A
// condition outside COND_EQ..COND_AL is an error (nothing emitted).
func Nop(a @asm.Assembler, cond int) {
	if !arm32.CondOk(a, cond) { return }
	arm32.Emit32(a, condBits(cond) | 0x0320F000)
}

// SVC (formerly SWI): cond[31:28] | 1111 | imm24[23:0].  A condition outside
// COND_EQ..COND_AL, or an immediate outside 0..0xFFFFFF, is an error (nothing emitted), as in
// LLVM and GNU as, rather than silently keeping its low 24 bits.
func Svc(a @asm.Assembler, cond int, imm int) {
	if !arm32.CondOk(a, cond) { return }
	if imm < 0 || imm > 0xFFFFFF {
		a.SetError("arm32: SVC immediate out of range (0..0xFFFFFF)")
		return
	}
	var inst uint32 = condBits(cond) | 0x0F000000
	inst = inst | cast(uint32, imm)
	arm32.Emit32(a, inst)
}

// BKPT: 1110 | 0001 0010 | imm12[19:8] | 0111 | imm4[3:0]
// Unconditional (always uses cond=AL=0xE).  An immediate outside 0..0xFFFF is an
// error (nothing emitted), as in LLVM and GNU as, rather than silently keeping
// its low 16 bits.
func Bkpt(a @asm.Assembler, imm int) { emitImm16(a, 0xE1200070, imm, "BKPT") }

// emitImm16 emits base with the 16-bit immediate imm split across bits [19:8] and [3:0], as
// BKPT, HVC, UDF and HLT hold it, or sets the error naming what (and emits nothing) when imm is
// outside 0..0xFFFF.
func emitImm16(a @asm.Assembler, base uint32, imm int, what *[]readonly char) {
	if imm < 0 || imm > 0xFFFF {
		a.SetError(buf.Concat(buf.Concat("arm32: ", what), " immediate out of range (0..65535)"))
		return
	}
	var u uint32 = cast(uint32, imm)
	arm32.Emit32(a, base | ((u >> 4) << 8) | (u & 0xF))
}

// HINT{cond} #n: cond[31:28] | 0011 0010 0000 1111 0000 | n[7:0].  n is 0..255 (DBG's hints
// included, 240..255); a condition or n outside its range is an error (nothing emitted).
func Hint(a @asm.Assembler, cond int, n int) {
	if !arm32.CondOk(a, cond) { return }
	if n < 0 || n > 255 {
		a.SetError("arm32: hint number out of range (0..255)")
		return
	}
	arm32.Emit32(a, condBits(cond) | 0x0320F000 | cast(uint32, n))
}

// DBG{cond} #option: the hint 0xF0 | option, option 0..15.
func Dbg(a @asm.Assembler, cond int, option int) {
	if option < 0 || option > 15 {
		a.SetError("arm32: DBG option out of range (0..15)")
		return
	}
	Hint(a, cond, 0xF0 | option)
}

// UDF #imm16: 1110 0111 1111 | imm12[19:8] | 1111 | imm4[3:0], unconditional.
func Udf(a @asm.Assembler, imm int) { emitImm16(a, 0xE7F000F0, imm, "UDF") }

// HVC #imm16: 1110 0001 0100 | imm12[19:8] | 0111 | imm4[3:0], unconditional.
func Hvc(a @asm.Assembler, imm int) { emitImm16(a, 0xE1400070, imm, "HVC") }

// HLT #imm16: 1110 0001 0000 | imm12[19:8] | 0111 | imm4[3:0], unconditional.
func Hlt(a @asm.Assembler, imm int) { emitImm16(a, 0xE1000070, imm, "HLT") }

// SMC{cond} #imm4: cond[31:28] | 0001 0110 0000 0000 0000 0111 | imm4[3:0].
func Smc(a @asm.Assembler, cond int, imm int) {
	if !arm32.CondOk(a, cond) { return }
	if imm < 0 || imm > 15 {
		a.SetError("arm32: SMC immediate out of range (0..15)")
		return
	}
	arm32.Emit32(a, condBits(cond) | 0x01600070 | cast(uint32, imm))
}

// ERET{cond}: cond[31:28] | 0001 0110 0000 0000 0000 0110 1110.
func Eret(a @asm.Assembler, cond int) {
	if !arm32.CondOk(a, cond) { return }
	arm32.Emit32(a, condBits(cond) | 0x0160006E)
}
