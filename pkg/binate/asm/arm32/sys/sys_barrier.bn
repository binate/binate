package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The barriers, all unconditional: DMB, DSB and ISB with a 4-bit option (BAR_*), and SB.

// emitBarrier emits base | option, or sets the error (and emits nothing) when option is outside
// 0..15.
func emitBarrier(a @asm.Assembler, base uint32, option int) {
	if option < 0 || option > 15 {
		a.SetError("arm32: barrier option out of range (0..15)")
		return
	}
	arm32.Emit32(a, base | cast(uint32, option))
}

// DMB #option: 1111 0101 0111 1111 1111 0000 0101 | option[3:0].
func Dmb(a @asm.Assembler, option int) { emitBarrier(a, 0xF57FF050, option) }

// DSB #option: 1111 0101 0111 1111 1111 0000 0100 | option[3:0].
func Dsb(a @asm.Assembler, option int) { emitBarrier(a, 0xF57FF040, option) }

// ISB #option: 1111 0101 0111 1111 1111 0000 0110 | option[3:0].
func Isb(a @asm.Assembler, option int) { emitBarrier(a, 0xF57FF060, option) }

// SB (speculation barrier): 1111 0101 0111 1111 1111 0000 0111 0000.
func Sb(a @asm.Assembler) { arm32.Emit32(a, 0xF57FF070) }
