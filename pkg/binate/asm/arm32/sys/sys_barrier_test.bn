package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The barriers as clang assembles them: DMB SY, DMB #0, DMB ISHST, DMB OSHLD, DSB SY, DSB #0
// (SSBB), DSB #4 (PSSBB), DSB ISHLD, ISB SY, ISB #0, SB.  An option past 15 or below 0 is an
// error.
func TestBarriers() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Dmb(a, BAR_SY)
	Dmb(a, 0)
	Dmb(a, BAR_ISHST)
	Dmb(a, BAR_OSHLD)
	Dsb(a, BAR_SY)
	Dsb(a, 0)
	Dsb(a, 4)
	Dsb(a, BAR_ISHLD)
	Isb(a, BAR_SY)
	Isb(a, 0)
	Sb(a)
	if !wordsAre(a,
			@[]uint32{0xF57FF05F, 0xF57FF050, 0xF57FF05A, 0xF57FF051, 0xF57FF04F, 0xF57FF040, 0xF57FF044,
					0xF57FF049, 0xF57FF06F, 0xF57FF060, 0xF57FF070}) {
		return fail("a barrier is not clang's word")
	}
	var b @asm.Assembler = newAsm()
	Dmb(b, 16)
	var c @asm.Assembler = newAsm()
	Dsb(c, -1)
	var d @asm.Assembler = newAsm()
	Isb(d, 16)
	if !rejected(b) || !rejected(c) || !rejected(d) { return fail("a bad barrier option was taken") }
	return ""
}
