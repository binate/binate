package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// The coprocessor instructions: MCR / MRC, MCRR / MRRC, CDP and LDC / STC, each with its `2`
// form (two: the unconditional encoding, its condition field 1111; cond must be COND_AL), LDC /
// STC's long (L) one too.

// cpCond returns the condition field of a coprocessor instruction -- 1111 for its 2 form -- or ok
// false with the error set.
func cpCond(a @asm.Assembler, cond int, two bool) (uint32, bool) {
	if !two {
		if !arm32.CondOk(a, cond) { return 0, false }
		return condBits(cond), true
	}
	if cond != arm32.COND_AL {
		a.SetError("arm32: a coprocessor instruction's 2 form takes no condition")
		return 0, false
	}
	return 0xF0000000, true
}

// fieldOk reports whether v, the field what names, is within 0..max, setting the error if not.
func fieldOk(a @asm.Assembler, v int, max int, what *[]readonly char) bool {
	if v < 0 || v > max {
		a.SetError(buf.Concat(buf.Concat("arm32: coprocessor ", what), " out of range"))
		return false
	}
	return true
}

// cpMove emits MCR (MRC when toCore): cond | 1110 | opc1[23:21] | L[20] | CRn[19:16] | Rt[15:12]
// | coproc[11:8] | opc2[7:5] | 1 | CRm[3:0].
func cpMove(a @asm.Assembler, cond int, two bool, toCore bool, cp int, opc1 int, rt int, crn int,
		crm int, opc2 int) {
	c, ok := cpCond(a, cond, two)
	if !ok || !fieldOk(a, cp, 15, "number") || !fieldOk(a, opc1, 7, "opcode 1") ||
			!arm32.RegOk(a, rt, false) || !fieldOk(a, crn, 15, "register") ||
			!fieldOk(a, crm, 15, "register") || !fieldOk(a, opc2, 7, "opcode 2") {
		return
	}
	var inst uint32 = c | 0x0E000010 | (cast(uint32, opc1) << 21) | (cast(uint32, crn) << 16) |
			(cast(uint32, rt) << 12) | (cast(uint32, cp) << 8) | (cast(uint32, opc2) << 5) |
			cast(uint32, crm)
	if toCore { inst = inst | 0x00100000 }
	arm32.Emit32(a, inst)
}

// Mcr emits MCR{cond} (MCR2 when two) coproc, #opc1, Rt, CRn, CRm, #opc2: cp, crn and crm 0..15,
// opc1 and opc2 0..7, Rt R0..R15 (PC too, as clang takes it).
func Mcr(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, crn int, crm int,
		opc2 int) {
	cpMove(a, cond, two, false, cp, opc1, rt, crn, crm, opc2)
}

// Mrc emits MRC{cond} (MRC2 when two), its fields as Mcr takes them; Rt R15 is APSR_nzcv.
func Mrc(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, crn int, crm int,
		opc2 int) {
	cpMove(a, cond, two, true, cp, opc1, rt, crn, crm, opc2)
}

// cpMove2 emits MCRR (MRRC when toCore): cond | 1100 010 | L[20] | Rt2[19:16] | Rt[15:12] |
// coproc[11:8] | opc1[7:4] | CRm[3:0].
func cpMove2(a @asm.Assembler, cond int, two bool, toCore bool, cp int, opc1 int, rt int, rt2 int,
		crm int) {
	c, ok := cpCond(a, cond, two)
	if !ok || !fieldOk(a, cp, 15, "number") || !fieldOk(a, opc1, 15, "opcode 1") ||
			!arm32.RegOk(a, rt, true) || !arm32.RegOk(a, rt2, true) || !fieldOk(a, crm, 15, "register") {
		return
	}
	var inst uint32 = c | 0x0C400000 | (cast(uint32, rt2) << 16) | (cast(uint32, rt) << 12) |
			(cast(uint32, cp) << 8) | (cast(uint32, opc1) << 4) | cast(uint32, crm)
	if toCore { inst = inst | 0x00100000 }
	arm32.Emit32(a, inst)
}

// Mcrr emits MCRR{cond} (MCRR2 when two) coproc, #opc1, Rt, Rt2, CRm: cp and crm 0..15, opc1
// 0..15, Rt and Rt2 R0..R14.
func Mcrr(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, rt2 int, crm int) {
	cpMove2(a, cond, two, false, cp, opc1, rt, rt2, crm)
}

// Mrrc emits MRRC{cond} (MRRC2 when two), its fields as Mcrr takes them.
func Mrrc(a @asm.Assembler, cond int, two bool, cp int, opc1 int, rt int, rt2 int, crm int) {
	cpMove2(a, cond, two, true, cp, opc1, rt, rt2, crm)
}

// Cdp emits CDP{cond} (CDP2 when two) coproc, #opc1, CRd, CRn, CRm, #opc2: cond | 1110 |
// opc1[23:20] | CRn[19:16] | CRd[15:12] | coproc[11:8] | opc2[7:5] | 0 | CRm[3:0]; opc1 0..15,
// opc2 0..7, the rest 0..15.
func Cdp(a @asm.Assembler, cond int, two bool, cp int, opc1 int, crd int, crn int, crm int,
		opc2 int) {
	c, ok := cpCond(a, cond, two)
	if !ok || !fieldOk(a, cp, 15, "number") || !fieldOk(a, opc1, 15, "opcode 1") ||
			!fieldOk(a, crd, 15, "register") || !fieldOk(a, crn, 15, "register") ||
			!fieldOk(a, crm, 15, "register") || !fieldOk(a, opc2, 7, "opcode 2") {
		return
	}
	arm32.Emit32(a,
			c | 0x0E000000 | (cast(uint32, opc1) << 20) | (cast(uint32, crn) << 16) |
					(cast(uint32, crd) << 12) | (cast(uint32, cp) << 8) | (cast(uint32, opc2) << 5) |
					cast(uint32, crm))
}

// cpTransferBase returns an LDC / STC's word without its P, U, W, Rn and imm8 fields: cond |
// 110 | D[22] | L[20] | CRd[15:12] | coproc[11:8]; ok false with the error set for a bad field.
func cpTransferBase(a @asm.Assembler, cond int, two bool, load bool, long bool, cp int,
		crd int) (uint32, bool) {
	c, ok := cpCond(a, cond, two)
	if !ok || !fieldOk(a, cp, 15, "number") || !fieldOk(a, crd, 15, "register") { return 0, false }
	var inst uint32 = c | 0x0C000000 | (cast(uint32, crd) << 12) | (cast(uint32, cp) << 8)
	if long { inst = inst | 0x00400000 }
	if load { inst = inst | 0x00100000 }
	return inst, true
}

// cpTransfer emits LDC (STC when !load) with op: [Rn, #±off] (P), with writeback (P W), post-
// indexed [Rn], #±off (W), or a label (PC-relative, FIX_LDC_PC); off a multiple of 4, -1020..1020,
// op.Sub its negative zero (a zero offset only).
func cpTransfer(a @asm.Assembler, cond int, two bool, load bool, long bool, cp int, crd int,
		op arm32.Operand) {
	base, ok := cpTransferBase(a, cond, two, load, long, cp, crd)
	if !ok { return }
	var pw uint32 = 0
	var rn int = op.Reg
	if op.Kind == arm32.OP_MEM_IMM { pw = 0x01000000 }
	if op.Kind == arm32.OP_MEM_PRE { pw = 0x01200000 }
	if op.Kind == arm32.OP_MEM_POST { pw = 0x00200000 }
	if op.Kind == arm32.OP_LABEL {
		pw = 0x01000000
		rn = arm32.PC
	}
	if pw == 0 {
		a.SetError(
				"arm32: a coprocessor load / store takes [Rn, #imm] (with or without writeback), "
						"[Rn], #imm or a label")
		return
	}
	if !arm32.RegOk(a, rn, false) { return }
	if op.Sub && (op.Kind == arm32.OP_LABEL || op.Imm != 0) {
		a.SetError("arm32: only a zero offset can be subtracted (SubIndex)")
		return
	}
	var off int = 0
	if op.Kind != arm32.OP_LABEL { off = op.Imm }
	if off % 4 != 0 || off < -1020 || off > 1020 {
		a.SetError("arm32: a coprocessor load / store's offset is a multiple of 4 within +/-1020")
		return
	}
	var mag int = off
	var up uint32 = 0x00800000
	if off < 0 || op.Sub {
		mag = -off
		up = 0
	}
	if op.Kind == arm32.OP_LABEL { a.AddFixup(op.Label, arm32.FIX_LDC_PC, cast(int64, op.Imm), 4) }
	arm32.Emit32(a, base | pw | up | (cast(uint32, rn) << 16) | cast(uint32, mag / 4))
}

// Ldc emits LDC{L}{cond} (LDC2{L} when two) coproc, CRd, op: cp and crd 0..15; op [Rn, #±off],
// [Rn, #±off]!, [Rn], #±off or a label (off a multiple of 4 within +/-1020; Rn R0..R15).
func Ldc(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, op arm32.Operand) {
	cpTransfer(a, cond, two, true, long, cp, crd, op)
}

// Stc emits STC{L}{cond} (STC2{L} when two), its operands as Ldc takes them.
func Stc(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, op arm32.Operand) {
	cpTransfer(a, cond, two, false, long, cp, crd, op)
}

// cpTransferOption emits LDC (STC when !load) coproc, CRd, [Rn], {option}: unindexed, U set,
// option 0..255 in imm8.
func cpTransferOption(a @asm.Assembler, cond int, two bool, load bool, long bool, cp int, crd int,
		rn int, option int) {
	base, ok := cpTransferBase(a, cond, two, load, long, cp, crd)
	if !ok || !arm32.RegOk(a, rn, false) || !fieldOk(a, option, 255, "option") { return }
	arm32.Emit32(a, base | 0x00800000 | (cast(uint32, rn) << 16) | cast(uint32, option))
}

// LdcOption emits LDC{L}{cond} (LDC2{L} when two) coproc, CRd, [Rn], {option}, option 0..255.
func LdcOption(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, rn int,
		option int) {
	cpTransferOption(a, cond, two, true, long, cp, crd, rn, option)
}

// StcOption emits STC{L}{cond} (STC2{L} when two) coproc, CRd, [Rn], {option}.
func StcOption(a @asm.Assembler, cond int, two bool, long bool, cp int, crd int, rn int,
		option int) {
	cpTransferOption(a, cond, two, false, long, cp, crd, rn, option)
}
