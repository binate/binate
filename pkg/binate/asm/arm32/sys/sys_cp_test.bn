package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// MCR / MRC, MCRR / MRRC and CDP with their 2 forms, as clang assembles them: MCR P15, 0, R0,
// C1, C0, 0; MCREQ P14, 7, R12, C15, C15, 7; MCR ... PC; MRC; MRC APSR_nzcv; MRC2 P14, 7, R12, C15,
// C15, 7; MCR2; MCRR P15, 0, R0, R1, C2; MCRR P15, 15, R0, R1, C15; MCRREQ P14, 3, R2, R3, C4;
// MCRR R0, SP; MRRC; MRRC2; MCRR2; CDP P15, 0, C1, C2, C3, 0; CDP P15, 15, ..., 7; CDPEQ P14, 3,
// C15, C14, C13, 2; CDP2; CDP2 P14, 15, C15, C14, C13, 7.
func TestCoprocMoves() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mcr(a, arm32.COND_AL, false, 15, 0, arm32.R0, 1, 0, 0)
	Mcr(a, arm32.COND_EQ, false, 14, 7, arm32.R12, 15, 15, 7)
	Mcr(a, arm32.COND_AL, false, 15, 0, arm32.PC, 1, 0, 0)
	Mrc(a, arm32.COND_AL, false, 15, 0, arm32.R0, 1, 0, 0)
	Mrc(a, arm32.COND_AL, false, 15, 0, arm32.PC, 1, 0, 0)
	Mrc(a, arm32.COND_AL, true, 14, 7, arm32.R12, 15, 15, 7)
	Mcr(a, arm32.COND_AL, true, 15, 0, arm32.R0, 1, 0, 0)
	Mcrr(a, arm32.COND_AL, false, 15, 0, arm32.R0, arm32.R1, 2)
	Mcrr(a, arm32.COND_AL, false, 15, 15, arm32.R0, arm32.R1, 15)
	Mcrr(a, arm32.COND_EQ, false, 14, 3, arm32.R2, arm32.R3, 4)
	Mcrr(a, arm32.COND_AL, false, 15, 0, arm32.R0, arm32.SP, 2)
	Mrrc(a, arm32.COND_AL, false, 15, 0, arm32.R0, arm32.R1, 2)
	Mrrc(a, arm32.COND_AL, true, 15, 0, arm32.R0, arm32.R1, 2)
	Mcrr(a, arm32.COND_AL, true, 15, 0, arm32.R0, arm32.R1, 2)
	Cdp(a, arm32.COND_AL, false, 15, 0, 1, 2, 3, 0)
	Cdp(a, arm32.COND_AL, false, 15, 15, 1, 2, 3, 7)
	Cdp(a, arm32.COND_EQ, false, 14, 3, 15, 14, 13, 2)
	Cdp(a, arm32.COND_AL, true, 15, 0, 1, 2, 3, 0)
	Cdp(a, arm32.COND_AL, true, 14, 15, 15, 14, 13, 7)
	if !wordsAre(a,
			@[]uint32{0xEE010F10, 0x0EEFCEFF, 0xEE01FF10, 0xEE110F10, 0xEE11FF10, 0xFEFFCEFF, 0xFE010F10,
					0xEC410F02, 0xEC410FFF, 0x0C432E34, 0xEC4D0F02, 0xEC510F02, 0xFC510F02, 0xFC410F02, 0xEE021F03,
					0xEEF21FE3, 0x0E3EFE4D, 0xFE021F03, 0xFEFEFEED}) {
		return fail("a coprocessor move is not clang's word")
	}
	return ""
}

// A field past its range, a 2 form with a condition, MCRR / MRRC's PC, is an error that emits
// nothing.
func TestCoprocMoveRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Mcr(bad[0], arm32.COND_AL, false, 16, 0, arm32.R0, 1, 0, 0)
	Mcr(bad[1], arm32.COND_AL, false, 15, 8, arm32.R0, 1, 0, 0)
	Mcr(bad[2], arm32.COND_AL, false, 15, 0, arm32.R0, 16, 0, 0)
	Mrc(bad[3], arm32.COND_AL, false, 15, 0, arm32.R0, 1, 0, 8)
	Mcr(bad[4], arm32.COND_EQ, true, 15, 0, arm32.R0, 1, 0, 0)
	Mcrr(bad[5], arm32.COND_AL, false, 15, 16, arm32.R0, arm32.R1, 2)
	Mcrr(bad[6], arm32.COND_AL, false, 15, 0, arm32.PC, arm32.R1, 2)
	Mrrc(bad[7], arm32.COND_AL, false, 15, 0, arm32.R0, arm32.PC, 2)
	Cdp(bad[8], arm32.COND_AL, false, 15, 16, 1, 2, 3, 0)
	Cdp(bad[9], arm32.COND_AL, false, 15, 0, 1, 2, 3, 8)
	Cdp(bad[10], 15, false, 15, 0, 1, 2, 3, 0)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad coprocessor move was taken") }
	}
	return ""
}

// LDC / STC in each addressing form, as clang assembles them: [R0]; [R0, #4]; [R0, #-4]; [R0,
// #1020]; [R0, #-0]; [R0, #4]!; [R0], #4; [R0], #-4; [R0], {5}; [R0], {255}; [PC, #4]; [PC, #4]!;
// LDCL [R0]; LDCEQ [R0, #4]; LDC2 [R0]; LDC2L [R0, #4]!; STC [R0]; STC [R0, #-1020]; STC [R0], #4;
// STC [R0], {7}; STCL [R0, #4]!; STC2 [R0]; STC2L [R0], #-8; STC [PC], #4.
func TestCoprocLoadStore() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, 0))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, 4))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, -4))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, 1020))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.SubIndex(arm32.MemImm(arm32.R0, 0)))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemPre(arm32.R0, 4))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemPost(arm32.R0, 4))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemPost(arm32.R0, -4))
	LdcOption(a, arm32.COND_AL, false, false, 15, 1, arm32.R0, 5)
	LdcOption(a, arm32.COND_AL, false, false, 15, 1, arm32.R0, 255)
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.PC, 4))
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemPre(arm32.PC, 4))
	Ldc(a, arm32.COND_AL, false, true, 15, 1, arm32.MemImm(arm32.R0, 0))
	Ldc(a, arm32.COND_EQ, false, false, 15, 1, arm32.MemImm(arm32.R0, 4))
	Ldc(a, arm32.COND_AL, true, false, 15, 1, arm32.MemImm(arm32.R0, 0))
	Ldc(a, arm32.COND_AL, true, true, 15, 1, arm32.MemPre(arm32.R0, 4))
	Stc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, 0))
	Stc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, -1020))
	Stc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemPost(arm32.R0, 4))
	StcOption(a, arm32.COND_AL, false, false, 15, 1, arm32.R0, 7)
	Stc(a, arm32.COND_AL, false, true, 15, 1, arm32.MemPre(arm32.R0, 4))
	Stc(a, arm32.COND_AL, true, false, 15, 1, arm32.MemImm(arm32.R0, 0))
	Stc(a, arm32.COND_AL, true, true, 15, 1, arm32.MemPost(arm32.R0, -8))
	Stc(a, arm32.COND_AL, false, false, 15, 1, arm32.MemPost(arm32.PC, 4))
	if !wordsAre(a,
			@[]uint32{0xED901F00, 0xED901F01, 0xED101F01, 0xED901FFF, 0xED101F00, 0xEDB01F01, 0xECB01F01,
					0xEC301F01, 0xEC901F05, 0xEC901FFF, 0xED9F1F01, 0xEDBF1F01, 0xEDD01F00, 0x0D901F01, 0xFD901F00,
					0xFDF01F01, 0xED801F00, 0xED001FFF, 0xECA01F01, 0xEC801F07, 0xEDE01F01, 0xFD801F00, 0xFC601F02,
					0xECAF1F01}) {
		return fail("a coprocessor load / store is not clang's word")
	}
	return ""
}

// An offset that is no multiple of 4 or past 1020, a register index, an option past 255 or below
// 0, a base past R15, a subtracted (SubIndex) offset other than zero or label, is an error that
// emits nothing; a label is an arm32.FIX_LDC_PC fixup with PC as the base.
func TestCoprocLoadStoreRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Ldc(bad[0], arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, 2))
	Ldc(bad[1], arm32.COND_AL, false, false, 15, 1, arm32.MemImm(arm32.R0, 1024))
	Ldc(bad[2], arm32.COND_AL, false, false, 15, 1, arm32.MemReg(arm32.R0, arm32.R1))
	LdcOption(bad[3], arm32.COND_AL, false, false, 15, 1, arm32.R0, 256)
	StcOption(bad[4], arm32.COND_AL, false, false, 15, 1, arm32.R0, -1)
	Ldc(bad[5], arm32.COND_AL, false, false, 15, 16, arm32.MemImm(arm32.R0, 0))
	LdcOption(bad[6], arm32.COND_AL, false, false, 15, 1, 16, 0)
	Ldc(bad[7], arm32.COND_AL, false, false, 15, 1, arm32.SubIndex(arm32.MemImm(arm32.R0, 4)))
	Ldc(bad[8], arm32.COND_AL, false, false, 15, 1, arm32.SubIndex(arm32.MemImm(arm32.R0, -4)))
	Stc(bad[9], arm32.COND_AL, false, false, 15, 1, arm32.SubIndex(arm32.MemPost(arm32.R0, 8)))
	Ldc(bad[10], arm32.COND_AL, false, false, 15, 1, arm32.SubIndex(arm32.Label("lbl")))
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad coprocessor load / store was taken") }
	}
	var a @asm.Assembler = newAsm()
	Ldc(a, arm32.COND_AL, false, false, 15, 1, arm32.LabelAddend("lbl", 4))
	if !wordsAre(a, @[]uint32{0xED9F1F00}) || a.Sections[0].NumFixups != 1 ||
			a.Sections[0].Fixups[0].Kind != arm32.FIX_LDC_PC || a.Sections[0].Fixups[0].Addend != 4 {
		return fail("a coprocessor load of a label is not a FIX_LDC_PC fixup")
	}
	return ""
}
