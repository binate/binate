package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The processor-state changes, all unconditional: CPS, SETEND, SRS, RFE and SETPAN.

// CPS (change processor state): 1111 0001 0000 | imod[19:18] | M[17] | 0 0000 000 | A I F
// [8:6] | 0 | mode[4:0].  imod is CPS_IE or CPS_ID (enable or disable the interrupts flags
// names, CPS_A | CPS_I | CPS_F -- none too, UNPREDICTABLE as clang takes it) or CPS_NONE (flags
// 0); mode is a mode number, 0..31, or -1 for none (needed with CPS_NONE).  Any other
// combination -- no change at all, flags without CPS_IE / CPS_ID, imod 1 -- is an error, nothing
// emitted.
func Cps(a @asm.Assembler, imod int, flags int, mode int) {
	if (imod != CPS_NONE && imod != CPS_IE && imod != CPS_ID) || flags < 0 || flags > 7 || mode < -1 ||
			mode > 31 {
		a.SetError("arm32: CPS operand out of range")
		return
	}
	if imod == CPS_NONE && (flags != 0 || mode < 0) {
		a.SetError("arm32: CPS changes the interrupt flags it names, the mode, or both")
		return
	}
	var inst uint32 = 0xF1000000 | (cast(uint32, imod) << 18) | (cast(uint32, flags) << 6)
	if mode >= 0 { inst = inst | 0x00020000 | cast(uint32, mode) }
	arm32.Emit32(a, inst)
}

// SETEND BE / LE: 1111 0001 0000 0001 0000 00 | E[9] | 0 0000 0000.
func Setend(a @asm.Assembler, bigEndian bool) {
	var inst uint32 = 0xF1010000
	if bigEndian { inst = inst | 0x200 }
	arm32.Emit32(a, inst)
}

// puBits returns the P (bit 24) and U (bit 23) bits of an SRS / RFE in mode, one of
// arm32.BT_IA / BT_IB / BT_DA / BT_DB, and whether it is one.
func puBits(mode int) (uint32, bool) {
	if mode == arm32.BT_IA { return 0x00800000, true }
	if mode == arm32.BT_IB { return 0x01800000, true }
	if mode == arm32.BT_DA { return 0, true }
	if mode == arm32.BT_DB { return 0x01000000, true }
	return 0, false
}

// SRS{mode} SP{!}, #number (store return state): 1111 100P U1W0 1101 0000 0101 000 |
// number[4:0].  mode is arm32.BT_IA / BT_IB / BT_DA / BT_DB, number the mode whose banked SP
// is the base, 0..31; writeback writes the final address back.
func Srs(a @asm.Assembler, mode int, writeback bool, number int) {
	var pu uint32
	var ok bool
	pu, ok = puBits(mode)
	if !ok || number < 0 || number > 31 {
		a.SetError("arm32: SRS mode or number out of range")
		return
	}
	var inst uint32 = 0xF84D0500 | pu | cast(uint32, number)
	if writeback { inst = inst | 0x00200000 }
	arm32.Emit32(a, inst)
}

// RFE{mode} Rn{!} (return from exception): 1111 100P U0W1 | Rn[19:16] | 0000 1010 0000 0000.
// mode is arm32.BT_IA / BT_IB / BT_DA / BT_DB; Rn is R0..R15 (PC too, as clang takes it).
func Rfe(a @asm.Assembler, mode int, rn int, writeback bool) {
	var pu uint32
	var ok bool
	pu, ok = puBits(mode)
	if !ok {
		a.SetError("arm32: RFE mode out of range")
		return
	}
	if !arm32.RegOk(a, rn, false) { return }
	var inst uint32 = 0xF8100A00 | pu | (cast(uint32, rn) << 16)
	if writeback { inst = inst | 0x00200000 }
	arm32.Emit32(a, inst)
}

// SETPAN #imm1: 1111 0001 0001 0000 0000 00 | imm1[9] | 0 0000 0000, imm1 0 or 1.
func Setpan(a @asm.Assembler, imm int) {
	if imm < 0 || imm > 1 {
		a.SetError("arm32: SETPAN takes 0 or 1")
		return
	}
	arm32.Emit32(a, 0xF1100000 | (cast(uint32, imm) << 9))
}
