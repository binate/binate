package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// CPS as clang assembles it: CPS #16, CPS #31, CPSIE I / A / F / AIF, CPSID IF, CPSIE I, #16,
// CPSID AIF, #0x13, CPSIE NONE, CPSID NONE, #16.  No change at all, flags with CPS #mode, the
// reserved imod 1, a mode past 31 or below -1, a flag past F | I | A or below 0 is an error.
func TestCps() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Cps(a, CPS_NONE, 0, 16)
	Cps(a, CPS_NONE, 0, 31)
	Cps(a, CPS_IE, CPS_I, -1)
	Cps(a, CPS_IE, CPS_A, -1)
	Cps(a, CPS_IE, CPS_F, -1)
	Cps(a, CPS_IE, CPS_A | CPS_I | CPS_F, -1)
	Cps(a, CPS_ID, CPS_I | CPS_F, -1)
	Cps(a, CPS_IE, CPS_I, 16)
	Cps(a, CPS_ID, CPS_A | CPS_I | CPS_F, 0x13)
	Cps(a, CPS_IE, 0, -1)
	Cps(a, CPS_ID, 0, 16)
	if !wordsAre(a,
			@[]uint32{0xF1020010, 0xF102001F, 0xF1080080, 0xF1080100, 0xF1080040, 0xF10801C0, 0xF10C00C0,
					0xF10A0090, 0xF10E01D3, 0xF1080000, 0xF10E0010}) {
		return fail("a CPS is not clang's word")
	}
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 7)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Cps(bad[0], CPS_NONE, 0, -1)
	Cps(bad[1], CPS_IE, -1, -1)
	Cps(bad[2], CPS_NONE, CPS_I, 16)
	Cps(bad[3], 1, CPS_I, -1)
	Cps(bad[4], CPS_NONE, 0, 32)
	Cps(bad[5], CPS_IE, 8, -1)
	Cps(bad[6], CPS_IE, CPS_I, -2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad CPS was taken") }
	}
	return ""
}

// SETEND BE / LE and SETPAN #0 / #1, as clang assembles them; SETPAN #2 is an error.
func TestSetendSetpan() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Setend(a, true)
	Setend(a, false)
	Setpan(a, 0)
	Setpan(a, 1)
	if !wordsAre(a, @[]uint32{0xF1010200, 0xF1010000, 0xF1100000, 0xF1100200}) {
		return fail("a SETEND / SETPAN is not clang's word")
	}
	var b @asm.Assembler = newAsm()
	Setpan(b, 2)
	if !rejected(b) { return fail("SETPAN #2 was taken") }
	return ""
}

// SRS and RFE in each mode, with and without writeback, as clang assembles them: SRS SP!, #16
// (IA); SRS SP, #16; SRSDB SP!, #19; SRSIA SP, #31; SRSDA SP, #19; SRSIB SP!, #19; RFE R0; RFE
// R0!; RFEDB R2!; RFEDA R3; RFEIB R4!; RFE PC; RFE SP!.  A mode number past 31, another
// addressing mode or a register past R15 is an error.
func TestSrsRfe() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Srs(a, arm32.BT_IA, true, 16)
	Srs(a, arm32.BT_IA, false, 16)
	Srs(a, arm32.BT_DB, true, 19)
	Srs(a, arm32.BT_IA, false, 31)
	Srs(a, arm32.BT_DA, false, 19)
	Srs(a, arm32.BT_IB, true, 19)
	Rfe(a, arm32.BT_IA, arm32.R0, false)
	Rfe(a, arm32.BT_IA, arm32.R0, true)
	Rfe(a, arm32.BT_DB, arm32.R2, true)
	Rfe(a, arm32.BT_DA, arm32.R3, false)
	Rfe(a, arm32.BT_IB, arm32.R4, true)
	Rfe(a, arm32.BT_IA, arm32.PC, false)
	Rfe(a, arm32.BT_IA, arm32.SP, true)
	if !wordsAre(a,
			@[]uint32{0xF8ED0510, 0xF8CD0510, 0xF96D0513, 0xF8CD051F, 0xF84D0513, 0xF9ED0513, 0xF8900A00,
					0xF8B00A00, 0xF9320A00, 0xF8130A00, 0xF9B40A00, 0xF89F0A00, 0xF8BD0A00}) {
		return fail("an SRS / RFE is not clang's word")
	}
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 4)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Srs(bad[0], arm32.BT_IA, false, 32)
	Srs(bad[1], 4, false, 19)
	Rfe(bad[2], 4, arm32.R0, false)
	Rfe(bad[3], arm32.BT_IA, 16, false)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad SRS / RFE was taken") }
	}
	return ""
}
