package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The status-register moves: MRS / MSR of CPSR (APSR) or SPSR, with MSR's field mask, and the
// banked-register forms (the virtualization extensions).

// rBit returns bit 22, R, set for the SPSR.
func rBit(spsr bool) uint32 {
	if spsr { return 0x00400000 }
	return 0
}

// maskOk reports whether mask is an MSR field mask, 1..15 (f s x c), setting the error if not.
func maskOk(a @asm.Assembler, mask int) bool {
	if mask < 1 || mask > 15 {
		a.SetError("arm32: MSR field mask out of range (1..15)")
		return false
	}
	return true
}

// MRS{cond} Rd, CPSR / SPSR: cond[31:28] | 0001 0R00 1111 | Rd[15:12] | 0000 0000 0000.
func Mrs(a @asm.Assembler, cond int, rd int, spsr bool) {
	if !arm32.CondOk(a, cond) || !arm32.RegOk(a, rd, true) { return }
	arm32.Emit32(a, condBits(cond) | 0x010F0000 | rBit(spsr) | (cast(uint32, rd) << 12))
}

// MSR{cond} CPSR / SPSR_<mask>, Rn: cond[31:28] | 0001 0R10 | mask[19:16] | 1111 0000 0000 |
// Rn[3:0].
func Msr(a @asm.Assembler, cond int, spsr bool, mask int, rn int) {
	if !arm32.CondOk(a, cond) || !maskOk(a, mask) || !arm32.RegOk(a, rn, false) { return }
	arm32.Emit32(a,
			condBits(cond) | 0x0120F000 | rBit(spsr) | (cast(uint32, mask) << 16) | cast(uint32, rn))
}

// MSR{cond} CPSR / SPSR_<mask>, #imm: cond[31:28] | 0011 0R10 | mask[19:16] | 1111 | rot[11:8] |
// imm8[7:0], the value imm8 rotated right by 2 * rot.
func MsrImm(a @asm.Assembler, cond int, spsr bool, mask int, imm8 int, rot int) {
	if !arm32.CondOk(a, cond) || !maskOk(a, mask) { return }
	if imm8 < 0 || imm8 > 255 || rot < 0 || rot > 15 {
		a.SetError("arm32: MSR immediate needs an 8-bit value and a 4-bit rotation")
		return
	}
	arm32.Emit32(a,
			condBits(cond) | 0x0320F000 | rBit(spsr) | (cast(uint32, mask) << 16) |
					(cast(uint32, rot) << 8) | cast(uint32, imm8))
}

// sysmOk reports whether sysm is a banked register's number, 0..63 (R:M:M1), setting the error if
// not.
func sysmOk(a @asm.Assembler, sysm int) bool {
	if sysm < 0 || sysm > 63 {
		a.SetError("arm32: banked register number out of range (0..63)")
		return false
	}
	return true
}

// sysmBits places sysm (R:M:M1) into an MRS / MSR (banked register): R in bit 22, M1 in bits
// [19:16], M in bit 8.
func sysmBits(sysm int) uint32 {
	var s uint32 = cast(uint32, sysm)
	return ((s >> 5) << 22) | ((s & 0xF) << 16) | (((s >> 4) & 1) << 8)
}

// MRS{cond} Rd, <banked register>: cond[31:28] | 0001 0R00 | M1[19:16] | Rd[15:12] | 001M 0000
// 0000.  sysm is R:M:M1 (0..63, the register's number: R the SPSR of a mode); Rd is R0..R14.
func MrsBanked(a @asm.Assembler, cond int, rd int, sysm int) {
	if !arm32.CondOk(a, cond) || !arm32.RegOk(a, rd, true) || !sysmOk(a, sysm) { return }
	arm32.Emit32(a, condBits(cond) | 0x01000200 | sysmBits(sysm) | (cast(uint32, rd) << 12))
}

// MSR{cond} <banked register>, Rn: cond[31:28] | 0001 0R10 | M1[19:16] | 1111 001M 0000 |
// Rn[3:0], sysm as MrsBanked takes it; Rn is R0..R14.
func MsrBanked(a @asm.Assembler, cond int, sysm int, rn int) {
	if !arm32.CondOk(a, cond) || !sysmOk(a, sysm) || !arm32.RegOk(a, rn, true) { return }
	arm32.Emit32(a, condBits(cond) | 0x0120F200 | sysmBits(sysm) | cast(uint32, rn))
}
