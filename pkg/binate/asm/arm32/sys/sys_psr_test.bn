package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// MRS and MSR of CPSR / SPSR, as clang assembles them: MRS R0, APSR; MRS R0, SPSR; MRSEQ R1,
// CPSR; MRS SP, APSR; MSR APSR_nzcvq / APSR_g / APSR_nzcvqg / CPSR_fc / CPSR_fsxc / CPSR_c /
// CPSR_x / SPSR_fc / SPSR_fsxc, Rn; MSR CPSR_fc, PC; MSREQ CPSR_fc, R0.  MRS into PC, an empty
// or wider mask, is an error.
func TestMrsMsr() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Mrs(a, arm32.COND_AL, arm32.R0, false)
	Mrs(a, arm32.COND_AL, arm32.R0, true)
	Mrs(a, arm32.COND_EQ, arm32.R1, false)
	Mrs(a, arm32.COND_AL, arm32.SP, false)
	Msr(a, arm32.COND_AL, false, PSR_F, arm32.R0)
	Msr(a, arm32.COND_AL, false, PSR_S, arm32.R0)
	Msr(a, arm32.COND_AL, false, PSR_F | PSR_S, arm32.R1)
	Msr(a, arm32.COND_AL, false, PSR_F | PSR_C, arm32.R0)
	Msr(a, arm32.COND_AL, false, 15, arm32.R0)
	Msr(a, arm32.COND_AL, false, PSR_C, arm32.R0)
	Msr(a, arm32.COND_AL, false, PSR_X, arm32.R0)
	Msr(a, arm32.COND_AL, true, PSR_F | PSR_C, arm32.R0)
	Msr(a, arm32.COND_AL, true, 15, arm32.R2)
	Msr(a, arm32.COND_AL, false, PSR_F | PSR_C, arm32.PC)
	Msr(a, arm32.COND_EQ, false, PSR_F | PSR_C, arm32.R0)
	if !wordsAre(a,
			@[]uint32{0xE10F0000, 0xE14F0000, 0x010F1000, 0xE10FD000, 0xE128F000, 0xE124F000, 0xE12CF001,
					0xE129F000, 0xE12FF000, 0xE121F000, 0xE122F000, 0xE169F000, 0xE16FF002, 0xE129F00F,
					0x0129F000}) {
		return fail("an MRS / MSR is not clang's word")
	}
	var b @asm.Assembler = newAsm()
	Mrs(b, arm32.COND_AL, arm32.PC, false)
	var c @asm.Assembler = newAsm()
	Msr(c, arm32.COND_AL, false, 0, arm32.R0)
	var d @asm.Assembler = newAsm()
	Msr(d, arm32.COND_AL, false, 16, arm32.R0)
	if !rejected(b) || !rejected(c) || !rejected(d) { return fail("a bad MRS / MSR was taken") }
	return ""
}

// MSR of an immediate, as clang assembles it: CPSR_f, #0xf0000000 (0xF rotated by 2 * 2);
// CPSR_fc, #0x10; SPSR_c, #0x13; APSR_g, #0; CPSR_fc, #1, 2.  A value past 8 bits, a rotation
// past 15 or an empty mask is an error.
func TestMsrImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MsrImm(a, arm32.COND_AL, false, PSR_F, 0xF, 2)
	MsrImm(a, arm32.COND_AL, false, PSR_F | PSR_C, 0x10, 0)
	MsrImm(a, arm32.COND_AL, true, PSR_C, 0x13, 0)
	MsrImm(a, arm32.COND_AL, false, PSR_S, 0, 0)
	MsrImm(a, arm32.COND_AL, false, PSR_F | PSR_C, 1, 1)
	if !wordsAre(a, @[]uint32{0xE328F20F, 0xE329F010, 0xE361F013, 0xE324F000, 0xE329F101}) {
		return fail("an MSR of an immediate is not clang's word")
	}
	var b @asm.Assembler = newAsm()
	MsrImm(b, arm32.COND_AL, false, PSR_F, 256, 0)
	var c @asm.Assembler = newAsm()
	MsrImm(c, arm32.COND_AL, false, PSR_F, 1, 16)
	var d @asm.Assembler = newAsm()
	MsrImm(d, arm32.COND_AL, false, 0, 1, 0)
	var e @asm.Assembler = newAsm()
	MsrImm(e, arm32.COND_AL, false, PSR_F, -1, 0)
	var f @asm.Assembler = newAsm()
	MsrImm(f, arm32.COND_AL, false, PSR_F, 1, -1)
	if !rejected(b) || !rejected(c) || !rejected(d) || !rejected(e) || !rejected(f) {
		return fail("a bad MSR immediate was taken")
	}
	return ""
}

// The banked-register forms, as clang assembles them: MRS R0 of R8_usr (SYSm 0), LR_irq (16),
// SP_irq (17), SPSR_fiq (32 + 14), SPSR_hyp (32 + 16 + 14), ELR_hyp (30), SP_hyp (31); MRS SP,
// R8_usr; MSR R8_usr, R1; MSR SPSR_irq (48), R2; MSRNE SP_svc (19), R2; MSR R8_usr, SP.  PC, or a
// number past 63, is an error.
func TestBanked() testing.TestResult {
	var a @asm.Assembler = newAsm()
	MrsBanked(a, arm32.COND_AL, arm32.R0, 0)
	MrsBanked(a, arm32.COND_AL, arm32.R0, 16)
	MrsBanked(a, arm32.COND_AL, arm32.R0, 17)
	MrsBanked(a, arm32.COND_AL, arm32.R0, 46)
	MrsBanked(a, arm32.COND_AL, arm32.R0, 62)
	MrsBanked(a, arm32.COND_AL, arm32.R0, 30)
	MrsBanked(a, arm32.COND_AL, arm32.R0, 31)
	MrsBanked(a, arm32.COND_AL, arm32.SP, 0)
	MsrBanked(a, arm32.COND_AL, 0, arm32.R1)
	MsrBanked(a, arm32.COND_AL, 48, arm32.R2)
	MsrBanked(a, arm32.COND_NE, 19, arm32.R2)
	MsrBanked(a, arm32.COND_AL, 0, arm32.SP)
	if !wordsAre(a,
			@[]uint32{0xE1000200, 0xE1000300, 0xE1010300, 0xE14E0200, 0xE14E0300, 0xE10E0300, 0xE10F0300,
					0xE100D200, 0xE120F201, 0xE160F302, 0x1123F302, 0xE120F20D}) {
		return fail("a banked MRS / MSR is not clang's word")
	}
	var b @asm.Assembler = newAsm()
	MrsBanked(b, arm32.COND_AL, arm32.PC, 0)
	var c @asm.Assembler = newAsm()
	MsrBanked(c, arm32.COND_AL, 0, arm32.PC)
	var d @asm.Assembler = newAsm()
	MrsBanked(d, arm32.COND_AL, arm32.R0, 64)
	if !rejected(b) || !rejected(c) || !rejected(d) { return fail("a bad banked MRS / MSR was taken") }
	return ""
}
