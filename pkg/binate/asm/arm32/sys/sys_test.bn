package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// fail returns msg as a failing test result.
func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

// newAsm returns a 32-bit assembler positioned in a text section.
func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// readInst reads the little-endian instruction word at off in section s.
func readInst(s @asm.Section, off int) uint32 {
	return cast(uint32, s.Data[off]) | (cast(uint32, s.Data[off + 1]) << 8) |
			(cast(uint32, s.Data[off + 2]) << 16) | (cast(uint32, s.Data[off + 3]) << 24)
}

// Each encoder that takes a condition emits one word under COND_AL and, under 15, 16 or -1,
// sets the error and emits nothing.
func TestEveryEncoderChecksItsCondition() testing.TestResult {
	var encs @[]*func(@asm.Assembler, int) = @[]*func(@asm.Assembler, int){
			func(a @asm.Assembler, c int) { Nop(a, c) }, func(a @asm.Assembler, c int) { Svc(a, c, 1) },
			func(a @asm.Assembler, c int) { Hint(a, c, 1) }, func(a @asm.Assembler, c int) { Dbg(a, c, 1) },
			func(a @asm.Assembler, c int) { Smc(a, c, 1) }, func(a @asm.Assembler, c int) { Eret(a, c) },
			func(a @asm.Assembler, c int) { Mrs(a, c, arm32.R0, false) },
			func(a @asm.Assembler, c int) { Msr(a, c, false, PSR_F, arm32.R0) },
			func(a @asm.Assembler, c int) { MsrImm(a, c, false, PSR_F, 1, 0) },
			func(a @asm.Assembler, c int) { MrsBanked(a, c, arm32.R0, 0) },
			func(a @asm.Assembler, c int) { MsrBanked(a, c, 0, arm32.R0) }}
	var bad @[]int = @[]int{15, 16, -1}
	for i := 0; i < len(encs); i++ {
		var a @asm.Assembler = newAsm()
		encs[i](a, arm32.COND_AL)
		if a.HasError || a.Sections[0].Len != 4 { return fail("an encoder rejected COND_AL") }
		for k := 0; k < len(bad); k++ {
			var b @asm.Assembler = newAsm()
			encs[i](b, bad[k])
			if !b.HasError || b.Sections[0].Len != 0 { return fail("an encoder took a bad condition") }
		}
	}
	return ""
}

// --- NOP ---

// NOP is the ARMv6K hint, its condition in bits 31:28.
func TestNop() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Nop(a, arm32.COND_AL)
	Nop(a, arm32.COND_EQ)
	if readInst(a.Sections[0], 0) != 0xE320F000 { return fail("NOP encoding wrong") }
	if readInst(a.Sections[0], 4) != 0x0320F000 { return fail("NOPEQ encoding wrong") }
	return ""
}

// --- SVC ---

func TestSvc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SVC #0 (AL)
	// cond=1110 | 1111 | imm24=0
	// = 0xEF000000
	Svc(a, arm32.COND_AL, 0)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEF000000 {
		return fail("SVC #0 encoding wrong")
	}
	return ""
}

func TestSvcImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SVC #1
	// = 0xEF000001
	Svc(a, arm32.COND_AL, 1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEF000001 {
		return fail("SVC #1 encoding wrong")
	}
	return ""
}

// --- BKPT ---

func TestBkpt() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BKPT #0
	// 1110 | 0001 0010 | 000000000000 | 0111 | 0000
	// = 0xE1200070
	Bkpt(a, 0)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1200070 {
		return fail("BKPT #0 encoding wrong")
	}
	return ""
}

func TestBkptImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BKPT #0x1234
	// imm12 = 0x123 (bits [19:8]), imm4 = 0x4 (bits [3:0])
	// 0xE1200070 | (0x123 << 8) | 0x4 = 0xE1212374
	Bkpt(a, 0x1234)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1212374 {
		return fail("BKPT #0x1234 encoding wrong")
	}
	return ""
}

// The largest immediates encode; one past them, or a negative one, is an error
// with nothing emitted (LLVM and GNU as reject these too) rather than being
// truncated to the low 24 / 16 bits.
func TestSvcBkptImmediateRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Svc(a, arm32.COND_AL, 0xFFFFFF)
	if a.HasError || readInst(a.Sections[0], 0) != 0xEFFFFFFF { return fail("svc #0xffffff") }
	a = newAsm()
	Bkpt(a, 0xFFFF)
	if a.HasError || readInst(a.Sections[0], 0) != 0xE12FFF7F { return fail("bkpt #0xffff") }
	var bad @[]int = make_slice(int, 2)
	bad[0] = -1
	bad[1] = 0x1000000
	for i := 0; i < len(bad); i++ {
		a = newAsm()
		Svc(a, arm32.COND_AL, bad[i])
		if !a.HasError || a.Sections[0].Len != 0 { return fail("svc out of range must be rejected") }
	}
	bad[1] = 0x10000
	for i := 0; i < len(bad); i++ {
		a = newAsm()
		Bkpt(a, bad[i])
		if !a.HasError || a.Sections[0].Len != 0 { return fail("bkpt out of range must be rejected") }
	}
	return ""
}

// wordsAre reports whether a holds exactly the words want, with no error.
func wordsAre(a @asm.Assembler, want @[]uint32) bool {
	if a.HasError || a.Sections[0].Len != cast(int64, 4 * len(want)) { return false }
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] { return false }
	}
	return true
}

// rejected reports whether a recorded an error and emitted nothing.
func rejected(a @asm.Assembler) bool { return a.HasError && a.Sections[0].Len == 0 }

// The hints, conditional, as clang assembles them: HINT #5, YIELD, WFINE, DBG #15, DBGEQ #3,
// CSDB, ESB, TSB CSYNC, CLRBHB, SEVL.  A hint past 255 or below 0, a DBG option past 15, a bad
// condition, is an error.
func TestHintDbg() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Hint(a, arm32.COND_AL, 5)
	Hint(a, arm32.COND_AL, HINT_YIELD)
	Hint(a, arm32.COND_NE, HINT_WFI)
	Dbg(a, arm32.COND_AL, 15)
	Dbg(a, arm32.COND_EQ, 3)
	Hint(a, arm32.COND_AL, HINT_CSDB)
	Hint(a, arm32.COND_AL, HINT_ESB)
	Hint(a, arm32.COND_AL, HINT_TSB_CSYNC)
	Hint(a, arm32.COND_AL, HINT_CLRBHB)
	Hint(a, arm32.COND_AL, HINT_SEVL)
	if !wordsAre(a,
			@[]uint32{0xE320F005, 0xE320F001, 0x1320F003, 0xE320F0FF, 0x0320F0F3, 0xE320F014, 0xE320F010,
					0xE320F012, 0xE320F016, 0xE320F005}) {
		return fail("a hint is not clang's word")
	}
	var b @asm.Assembler = newAsm()
	Hint(b, arm32.COND_AL, 256)
	var c @asm.Assembler = newAsm()
	Hint(c, arm32.COND_AL, -1)
	var d @asm.Assembler = newAsm()
	Dbg(d, arm32.COND_AL, 16)
	var e @asm.Assembler = newAsm()
	Hint(e, 15, 1)
	if !rejected(b) || !rejected(c) || !rejected(d) || !rejected(e) {
		return fail("a bad hint was taken")
	}
	return ""
}

// UDF, HVC and HLT split a 16-bit immediate as BKPT does; SMC takes 4 bits and a condition, ERET
// a condition: UDF #65535, UDF #5, HVC #65535, HVC #0, HLT #63, HLT #64, HLT #65535, SMC #15,
// SMCEQ #1, ERET, ERETEQ.  An immediate past its field is an error.
func TestExceptionGenerating() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Udf(a, 65535)
	Udf(a, 5)
	Hvc(a, 65535)
	Hvc(a, 0)
	Hlt(a, 63)
	Hlt(a, 64)
	Hlt(a, 65535)
	Smc(a, arm32.COND_AL, 15)
	Smc(a, arm32.COND_EQ, 1)
	Eret(a, arm32.COND_AL)
	Eret(a, arm32.COND_EQ)
	if !wordsAre(a,
			@[]uint32{0xE7FFFFFF, 0xE7F000F5, 0xE14FFF7F, 0xE1400070, 0xE100037F, 0xE1000470, 0xE10FFF7F,
					0xE160007F, 0x01600071, 0xE160006E, 0x0160006E}) {
		return fail("an exception-generating instruction is not clang's word")
	}
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 9)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Udf(bad[0], 65536)
	Udf(bad[1], -1)
	Hvc(bad[2], 65536)
	Hlt(bad[3], -1)
	Smc(bad[4], arm32.COND_AL, 16)
	Eret(bad[5], 16)
	Smc(bad[6], arm32.COND_AL, -1)
	Hvc(bad[7], -1)
	Dbg(bad[8], arm32.COND_AL, -1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad exception-generating operand was taken") }
	}
	return ""
}
