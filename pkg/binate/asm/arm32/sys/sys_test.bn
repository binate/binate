package "pkg/binate/asm/arm32/sys"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// fail returns msg as a failing test result.
func fail(msg @[]char) testing.TestResult {
	// An empty message would read as a pass.
	if len(msg) == 0 { return "check failed (with an empty failure message)" }
	return msg
}

// newAsm returns a 32-bit assembler positioned in a text section.
func newAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	return a
}

// readInst reads the little-endian instruction word at off in section s.
func readInst(s @asm.Section, off int) uint32 {
	return cast(uint32, s.Data[off]) | (cast(uint32, s.Data[off + 1]) << 8) |
			(cast(uint32, s.Data[off + 2]) << 16) | (cast(uint32, s.Data[off + 3]) << 24)
}

// Each encoder that takes a condition emits one word under COND_AL and, under 15, 16 or -1,
// sets the error and emits nothing.
func TestEveryEncoderChecksItsCondition() testing.TestResult {
	var bad @[]int = @[]int{15, 16, -1}
	var a @asm.Assembler = newAsm()
	Nop(a, arm32.COND_AL)
	Svc(a, arm32.COND_AL, 1)
	if a.HasError || a.Sections[0].Len != 8 { return fail("NOP / SVC rejected under COND_AL") }
	for i := 0; i < len(bad); i++ {
		var n @asm.Assembler = newAsm()
		Nop(n, bad[i])
		var s @asm.Assembler = newAsm()
		Svc(s, bad[i], 1)
		if !n.HasError || n.Sections[0].Len != 0 || !s.HasError || s.Sections[0].Len != 0 {
			return fail("NOP / SVC took a bad condition")
		}
	}
	return ""
}

// --- NOP ---

// NOP is the ARMv6K hint, its condition in bits 31:28.
func TestNop() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Nop(a, arm32.COND_AL)
	Nop(a, arm32.COND_EQ)
	if readInst(a.Sections[0], 0) != 0xE320F000 { return fail("NOP encoding wrong") }
	if readInst(a.Sections[0], 4) != 0x0320F000 { return fail("NOPEQ encoding wrong") }
	return ""
}

// --- SVC ---

func TestSvc() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SVC #0 (AL)
	// cond=1110 | 1111 | imm24=0
	// = 0xEF000000
	Svc(a, arm32.COND_AL, 0)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEF000000 {
		return fail("SVC #0 encoding wrong")
	}
	return ""
}

func TestSvcImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// SVC #1
	// = 0xEF000001
	Svc(a, arm32.COND_AL, 1)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xEF000001 {
		return fail("SVC #1 encoding wrong")
	}
	return ""
}

// --- BKPT ---

func TestBkpt() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BKPT #0
	// 1110 | 0001 0010 | 000000000000 | 0111 | 0000
	// = 0xE1200070
	Bkpt(a, 0)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1200070 {
		return fail("BKPT #0 encoding wrong")
	}
	return ""
}

func TestBkptImm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	// BKPT #0x1234
	// imm12 = 0x123 (bits [19:8]), imm4 = 0x4 (bits [3:0])
	// 0xE1200070 | (0x123 << 8) | 0x4 = 0xE1212374
	Bkpt(a, 0x1234)
	var inst uint32 = readInst(a.Sections[0], 0)
	if inst != 0xE1212374 {
		return fail("BKPT #0x1234 encoding wrong")
	}
	return ""
}

// The largest immediates encode; one past them, or a negative one, is an error
// with nothing emitted (LLVM and GNU as reject these too) rather than being
// truncated to the low 24 / 16 bits.
func TestSvcBkptImmediateRange() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Svc(a, arm32.COND_AL, 0xFFFFFF)
	if a.HasError || readInst(a.Sections[0], 0) != 0xEFFFFFFF { return fail("svc #0xffffff") }
	a = newAsm()
	Bkpt(a, 0xFFFF)
	if a.HasError || readInst(a.Sections[0], 0) != 0xE12FFF7F { return fail("bkpt #0xffff") }
	var bad @[]int = make_slice(int, 2)
	bad[0] = -1
	bad[1] = 0x1000000
	for i := 0; i < len(bad); i++ {
		a = newAsm()
		Svc(a, arm32.COND_AL, bad[i])
		if !a.HasError || a.Sections[0].Len != 0 { return fail("svc out of range must be rejected") }
	}
	bad[1] = 0x10000
	for i := 0; i < len(bad); i++ {
		a = newAsm()
		Bkpt(a, bad[i])
		if !a.HasError || a.Sections[0].Len != 0 { return fail("bkpt out of range must be rejected") }
	}
	return ""
}
