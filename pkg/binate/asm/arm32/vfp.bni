// Package vfp provides the exact VFP (VFPv3-D32) scalar floating-point encoders for the arm32
// assembler, in the manner of pkg/binate/asm/arm32: each call emits the one instruction its
// operands name, or sets the assembler error and emits nothing when one has no encoding -- a
// condition outside arm32.COND_EQ..COND_AL, a register outside S0..S31 for a single-precision
// operand, D0..D31 for a double, or R0..R15 for a core one (R0..R14 where an instruction says).
package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// VFP single-precision registers S0..S31. Offset by 32 so the namespace is
// disjoint from arm32.R0..R15 (and from D0..D31); `& 0x1f` recovers the 0..31
// hardware number.
const (
	S0 int = iota + 32
	S1
	S2
	S3
	S4
	S5
	S6
	S7
	S8
	S9
	S10
	S11
	S12
	S13
	S14
	S15
	S16
	S17
	S18
	S19
	S20
	S21
	S22
	S23
	S24
	S25
	S26
	S27
	S28
	S29
	S30
	S31
)

// VFP double-precision registers D0..D31 (VFPv3-D32). Offset by 64 so the
// namespace is disjoint from arm32.R0..R15 and S0..S31; `& 0x1f` recovers the
// 0..31 hardware number.
const (
	D0 int = iota + 64
	D1
	D2
	D3
	D4
	D5
	D6
	D7
	D8
	D9
	D10
	D11
	D12
	D13
	D14
	D15
	D16
	D17
	D18
	D19
	D20
	D21
	D22
	D23
	D24
	D25
	D26
	D27
	D28
	D29
	D30
	D31
)

// The three-register VFP data-processing operations (Arith3): VMLA, VMLS, VNMLS, VNMLA (the
// multiply-accumulates), VMUL, VNMUL, VADD, VSUB, VDIV, and VFPv4's fused VFNMS, VFNMA, VFMA, VFMS.
const (
	ARITH_MLA int = iota
	ARITH_MLS
	ARITH_NMLS
	ARITH_NMLA
	ARITH_MUL
	ARITH_NMUL
	ARITH_ADD
	ARITH_SUB
	ARITH_DIV
	ARITH_FNMS
	ARITH_FNMA
	ARITH_FMA
	ARITH_FMS
)

// The two-register VFP data-processing operations (Arith2): VABS, VNEG, VSQRT, VCMP, VCMPE.
const (
	UNARY_ABS int = iota
	UNARY_NEG
	UNARY_SQRT
	UNARY_CMP
	UNARY_CMPE
)

// Arith3 emits the three-register operation op (ARITH_*) on data of size bits, 16, 32 or 64 --
// .F16 / .F32 / .F64{cond} Vd, Vn, Vm: S registers for F16 and F32, D registers for F64; an
// F16 one (ARMv8.2's full FP16) only unconditional.
func Arith3(a @asm.Assembler, cond int, op int, size int, vd int, vn int, vm int)

// Arith2 emits the two-register operation op (UNARY_*) on data of size bits, as Arith3 does:
// .F16 / .F32 / .F64{cond} Vd, Vm.
func Arith2(a @asm.Assembler, cond int, op int, size int, vd int, vm int)

// CmpZero emits VCMP (VCMPE when signal) on data of size bits, as Arith3 does: .F16 / .F32 /
// .F64{cond} Vd, #0.0.
func CmpZero(a @asm.Assembler, cond int, signal bool, size int, vd int)

// The VFP system registers VMRS reads and VMSR writes (the MVFRs VMSR does not), by their
// numbers in the instruction's reg field.
const (
	FPSID int = 0
	FPSCR int = 1
	MVFR2 int = 5
	MVFR1 int = 6
	MVFR0 int = 7
	FPEXC int = 8
	FPINST int = 9
	FPINST2 int = 10
)

// VmovReg emits VMOV.F32 / .F64{cond} Vd, Vm (size 32 or 64): a register copy.
func VmovReg(a @asm.Assembler, cond int, size int, vd int, vm int)

// VmovImm emits VMOV.F16 / .F32 / .F64{cond} Vd, #imm (size 16, 32 or 64; F16 unconditional),
// imm8 the immediate's 8-bit encoding, 0 .. 255 (its sign, exponent and fraction, as
// VFPExpandImm reads them).
func VmovImm(a @asm.Assembler, cond int, size int, vd int, imm8 int)

// VmovCoresToSingles emits VMOV{cond} Sm, Sm + 1, Rt, Rt2 (Sm S0 .. S30).
func VmovCoresToSingles(a @asm.Assembler, cond int, sm int, rt int, rt2 int)

// VmovSinglesToCores emits VMOV{cond} Rt, Rt2, Sm, Sm + 1 (Sm S0 .. S30).
func VmovSinglesToCores(a @asm.Assembler, cond int, rt int, rt2 int, sm int)

// VmovCoreToLane emits VMOV{cond}.32 Dd[x], Rt (x 0 or 1).
func VmovCoreToLane(a @asm.Assembler, cond int, dd int, x int, rt int)

// VmovLaneToCore emits VMOV{cond}.32 Rt, Dn[x] (x 0 or 1).
func VmovLaneToCore(a @asm.Assembler, cond int, rt int, dn int, x int)

// Vmrs emits VMRS{cond} Rt, reg (FPSID .. FPINST2): Rt R0 .. R14, or PC -- APSR_nzcv -- with
// FPSCR.
func Vmrs(a @asm.Assembler, cond int, rt int, reg int)

// Vmsr emits VMSR{cond} reg, Rt: reg FPSID, FPSCR, FPEXC, FPINST or FPINST2, Rt R0 .. R14.
func Vmsr(a @asm.Assembler, cond int, reg int, rt int)

// VmovHalfToCore emits VMOV.F16 Rt, Sn (unconditional; Rt R0 .. R14).
func VmovHalfToCore(a @asm.Assembler, rt int, sn int)

// VmovCoreToHalf emits VMOV.F16 Sn, Rt (unconditional; Rt R0 .. R14).
func VmovCoreToHalf(a @asm.Assembler, sn int, rt int)

// Vins emits VINS.F16 Sd, Sm (unconditional): Sm's low half into Sd's high half.
func Vins(a @asm.Assembler, sd int, sm int)

// Vmovx emits VMOVX.F16 Sd, Sm (unconditional): Sm's high half into Sd's low half.
func Vmovx(a @asm.Assembler, sd int, sm int)

// The roundings of VCVTA / VCVTN / VCVTP / VCVTM (VcvtRound) and VRINTA .. VRINTM (Vrint): to
// nearest with ties away from zero, to nearest with ties to even, toward +infinity, toward
// -infinity; and VRINT's other forms, by FPSCR's rounding mode (VRINTR), toward zero (VRINTZ),
// and by FPSCR's mode signalling inexact (VRINTX).
const (
	RM_A int = iota
	RM_N
	RM_P
	RM_M
	RINT_R
	RINT_Z
	RINT_X
)

// VcvtFP emits VCVT.F64.F32{cond} Dd, Sm (to 64) or VCVT.F32.F64{cond} Sd, Dm (to 32).
func VcvtFP(a @asm.Assembler, cond int, to int, vd int, vm int)

// VcvtFromInt emits VCVT.F16 / .F32 / .F64 (size 16, 32 or 64) .S32 (signed) or .U32{cond} Vd,
// Sm: a 32-bit integer to floating point, F16 unconditional.
func VcvtFromInt(a @asm.Assembler, cond int, size int, signed bool, vd int, sm int)

// VcvtToInt emits VCVT (rounding toward zero) or VCVTR (by FPSCR's rounding mode, fpscr) .S32
// (signed) or .U32 .F16 / .F32 / .F64{cond} Sd, Vm (size the source's 16, 32 or 64): floating
// point to a 32-bit integer, F16 unconditional.
func VcvtToInt(a @asm.Assembler, cond int, size int, signed bool, fpscr bool, sd int, vm int)

// VcvtFixed emits VCVT between floating point of size bits (16, 32 or 64) and a fixed-point
// number of bits bits (16 or 32) with fbits fraction bits (0 .. 16 for 16 bits, 1 .. 32 for 32),
// in place: .S<bits> / .U<bits> .F<size> (toFixed) or .F<size> .S<bits> / .U<bits>{cond} Vd, Vd,
// #fbits; F16 unconditional.
func VcvtFixed(a @asm.Assembler, cond int, size int, toFixed bool, signed bool, bits int, vd int,
		fbits int)

// VcvtHalf emits VCVTB (the bottom half) or VCVTT (top) .F16.F32 / .F16.F64 (toHalf) Sd, Vm or
// .F32.F16 / .F64.F16{cond} Vd, Sm (size 32 or 64).
func VcvtHalf(a @asm.Assembler, cond int, top bool, toHalf bool, size int, vd int, vm int)

// VcvtBF16 emits VCVTB (the bottom half) or VCVTT (top) .BF16.F32{cond} Sd, Sm.
func VcvtBF16(a @asm.Assembler, cond int, top bool, sd int, sm int)

// VcvtRound emits VCVTA / VCVTN / VCVTP / VCVTM (rm RM_A .. RM_M) .S32 (signed) or .U32 .F16 /
// .F32 / .F64 Sd, Vm (size the source's; unconditional).
func VcvtRound(a @asm.Assembler, rm int, size int, signed bool, sd int, vm int)

// Vjcvt emits VJCVT.S32.F64{cond} Sd, Dm: ARMv8.3's JavaScript conversion, toward zero modulo
// 2^32.
func Vjcvt(a @asm.Assembler, cond int, sd int, dm int)

// Vrint emits VRINTA .. VRINTM, VRINTR, VRINTZ or VRINTX (mode RM_A .. RINT_X) .F16 / .F32 /
// .F64{cond} Vd, Vm: rounding to an integral value; VRINTA .. VRINTM and F16 unconditional.
func Vrint(a @asm.Assembler, cond int, mode int, size int, vd int, vm int)

// Vsel emits VSELEQ / VSELVS / VSELGE / VSELGT (cc arm32.COND_EQ, COND_VS, COND_GE, COND_GT)
// .F16 / .F32 / .F64 Vd, Vn, Vm: Vn when cc holds, else Vm.
func Vsel(a @asm.Assembler, cc int, size int, vd int, vn int, vm int)

// Vmaxnm emits VMAXNM (VMINNM when min) .F16 / .F32 / .F64 Vd, Vn, Vm: IEEE 754-2008's maxNum
// (minNum).
func Vmaxnm(a @asm.Assembler, min bool, size int, vd int, vn int, vm int)

// Vldr emits VLDR{cond}.16 / .32 / .64 (size 16, 32 or 64) Vd, op: [Rn, #imm] (arm32.MemImm, its
// negative zero arm32.SubIndex) with imm a multiple of 4 within +/-1020 (for .16, of 2 within
// +/-510), or a label (arm32.Label, arm32.LabelAddend), PC-relative, which only a local label in
// its own section resolves (arm32.FIX_LDC_PC; FIX_LDC16_PC for .16).  .16 is unconditional.
func Vldr(a @asm.Assembler, cond int, size int, vd int, op arm32.Operand)

// Vstr emits VSTR{cond}.16 / .32 / .64 Vd, op, its operands as Vldr takes them.
func Vstr(a @asm.Assembler, cond int, size int, vd int, op arm32.Operand)

// VaddF32 emits VADD.F32{cond} Sd, Sn, Sm (single-precision add).
func VaddF32(a @asm.Assembler, cond int, sd int, sn int, sm int)

// VaddF64 emits VADD.F64{cond} Dd, Dn, Dm (double-precision add).
func VaddF64(a @asm.Assembler, cond int, dd int, dn int, dm int)

// VsubF32 emits VSUB.F32{cond} Sd, Sn, Sm (single-precision subtract).
func VsubF32(a @asm.Assembler, cond int, sd int, sn int, sm int)

// VsubF64 emits VSUB.F64{cond} Dd, Dn, Dm (double-precision subtract).
func VsubF64(a @asm.Assembler, cond int, dd int, dn int, dm int)

// VmulF32 emits VMUL.F32{cond} Sd, Sn, Sm (single-precision multiply).
func VmulF32(a @asm.Assembler, cond int, sd int, sn int, sm int)

// VmulF64 emits VMUL.F64{cond} Dd, Dn, Dm (double-precision multiply).
func VmulF64(a @asm.Assembler, cond int, dd int, dn int, dm int)

// VdivF32 emits VDIV.F32{cond} Sd, Sn, Sm (single-precision divide).
func VdivF32(a @asm.Assembler, cond int, sd int, sn int, sm int)

// VdivF64 emits VDIV.F64{cond} Dd, Dn, Dm (double-precision divide).
func VdivF64(a @asm.Assembler, cond int, dd int, dn int, dm int)

// VnegF32 emits VNEG.F32{cond} Sd, Sm (single-precision negate).
func VnegF32(a @asm.Assembler, cond int, sd int, sm int)

// VnegF64 emits VNEG.F64{cond} Dd, Dm (double-precision negate).
func VnegF64(a @asm.Assembler, cond int, dd int, dm int)

// VmovF32 emits VMOV.F32{cond} Sd, Sm (single-precision register copy).
func VmovF32(a @asm.Assembler, cond int, sd int, sm int)

// VmovF64 emits VMOV.F64{cond} Dd, Dm (double-precision register copy).
func VmovF64(a @asm.Assembler, cond int, dd int, dm int)

// VmovCoreToSingle emits VMOV{cond} Sn, Rt (core register -> single reg).
func VmovCoreToSingle(a @asm.Assembler, cond int, sn int, rt int)

// VmovSingleToCore emits VMOV{cond} Rt, Sn (single reg -> core register).
func VmovSingleToCore(a @asm.Assembler, cond int, rt int, sn int)

// VmovCoresToDouble emits VMOV{cond} Dm, Rt, Rt2 (Rt low word, Rt2 high) —
// pack a core-register pair into a double-precision register.
func VmovCoresToDouble(a @asm.Assembler, cond int, dm int, rt int, rt2 int)

// VmovDoubleToCores emits VMOV{cond} Rt, Rt2, Dm (Rt low word, Rt2 high) —
// unpack a double-precision register into a core-register pair.
func VmovDoubleToCores(a @asm.Assembler, cond int, rt int, rt2 int, dm int)

// VcmpF32 emits VCMP.F32{cond} Sd, Sm (quiet compare, sets FPSCR flags).
func VcmpF32(a @asm.Assembler, cond int, sd int, sm int)

// VcmpF64 emits VCMP.F64{cond} Dd, Dm (quiet compare, sets FPSCR flags).
func VcmpF64(a @asm.Assembler, cond int, dd int, dm int)

// VcmpeF32 emits VCMPE.F32{cond} Sd, Sm (signaling compare).
func VcmpeF32(a @asm.Assembler, cond int, sd int, sm int)

// VcmpeF64 emits VCMPE.F64{cond} Dd, Dm (signaling compare).
func VcmpeF64(a @asm.Assembler, cond int, dd int, dm int)

// VmrsApsrNzcv emits VMRS{cond} APSR_nzcv, FPSCR (copy FPSCR N/Z/C/V into
// the CPSR condition flags; used after VCMP(E)).
func VmrsApsrNzcv(a @asm.Assembler, cond int)

// VcvtF64F32 emits VCVT.F64.F32{cond} Dd, Sm (widen float32 -> float64).
func VcvtF64F32(a @asm.Assembler, cond int, dd int, sm int)

// VcvtF32F64 emits VCVT.F32.F64{cond} Sd, Dm (narrow float64 -> float32).
func VcvtF32F64(a @asm.Assembler, cond int, sd int, dm int)

// VcvtF32S32 emits VCVT.F32.S32{cond} Sd, Sm (signed int32 -> float32).
func VcvtF32S32(a @asm.Assembler, cond int, sd int, sm int)

// VcvtF32U32 emits VCVT.F32.U32{cond} Sd, Sm (unsigned int32 -> float32).
func VcvtF32U32(a @asm.Assembler, cond int, sd int, sm int)

// VcvtF64S32 emits VCVT.F64.S32{cond} Dd, Sm (signed int32 -> float64).
func VcvtF64S32(a @asm.Assembler, cond int, dd int, sm int)

// VcvtF64U32 emits VCVT.F64.U32{cond} Dd, Sm (unsigned int32 -> float64).
func VcvtF64U32(a @asm.Assembler, cond int, dd int, sm int)

// VcvtS32F32 emits VCVT.S32.F32{cond} Sd, Sm (float32 -> signed int32, trunc).
func VcvtS32F32(a @asm.Assembler, cond int, sd int, sm int)

// VcvtU32F32 emits VCVT.U32.F32{cond} Sd, Sm (float32 -> unsigned int32, trunc).
func VcvtU32F32(a @asm.Assembler, cond int, sd int, sm int)

// VcvtS32F64 emits VCVT.S32.F64{cond} Sd, Dm (float64 -> signed int32, trunc).
func VcvtS32F64(a @asm.Assembler, cond int, sd int, dm int)

// VcvtU32F64 emits VCVT.U32.F64{cond} Sd, Dm (float64 -> unsigned int32, trunc).
func VcvtU32F64(a @asm.Assembler, cond int, sd int, dm int)

// Vldr32 emits VLDR{cond}.32 Sd, [Rn, #±offset] (load a 32-bit float).
// The offset must be a multiple of 4 with magnitude <= 1020.
func Vldr32(a @asm.Assembler, cond int, sd int, rn int, offset int)

// Vldr64 emits VLDR{cond}.64 Dd, [Rn, #±offset] (load a 64-bit float).
// The offset must be a multiple of 4 with magnitude <= 1020.
func Vldr64(a @asm.Assembler, cond int, dd int, rn int, offset int)

// Vstr32 emits VSTR{cond}.32 Sd, [Rn, #±offset] (store a 32-bit float).
// The offset must be a multiple of 4 with magnitude <= 1020.
func Vstr32(a @asm.Assembler, cond int, sd int, rn int, offset int)

// Vstr64 emits VSTR{cond}.64 Dd, [Rn, #±offset] (store a 64-bit float).
// The offset must be a multiple of 4 with magnitude <= 1020.
func Vstr64(a @asm.Assembler, cond int, dd int, rn int, offset int)
