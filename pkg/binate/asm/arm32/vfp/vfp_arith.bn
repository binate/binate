package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The VFP data-processing instructions by operation and data type: cond | 1110 | opc1 D opc2 |
// Vn | Vd | 10 size | N op M 0 | Vm, the size field 01 for F16, 10 for F32, 11 for F64.  An F16
// or F32 operand is an S register, an F64 one a D register (placeVd and the rest).  The
// half-precision forms (ARMv8.2's full FP16) are unconditional.

// arithWord returns the three-register operation op's word without its condition, type and
// registers (ARITH_*): its opc1 [23:20] and op [6] bits on the data-processing base; ok false for
// none.
func arithWord(op int) (uint32, bool) {
	if op == ARITH_MLA { return 0x0E000000, true }
	if op == ARITH_MLS { return 0x0E000040, true }
	if op == ARITH_NMLS { return 0x0E100000, true }
	if op == ARITH_NMLA { return 0x0E100040, true }
	if op == ARITH_MUL { return 0x0E200000, true }
	if op == ARITH_NMUL { return 0x0E200040, true }
	if op == ARITH_ADD { return 0x0E300000, true }
	if op == ARITH_SUB { return 0x0E300040, true }
	if op == ARITH_DIV { return 0x0E800000, true }
	if op == ARITH_FNMS { return 0x0E900000, true }
	if op == ARITH_FNMA { return 0x0E900040, true }
	if op == ARITH_FMA { return 0x0EA00000, true }
	if op == ARITH_FMS { return 0x0EA00040, true }
	return 0, false
}

// unaryWord returns the two-register operation op's word likewise (UNARY_*): opc1 1D11, its
// opc2 [19:16] and its op [7] and bit 6; ok false for none.
func unaryWord(op int) (uint32, bool) {
	if op == UNARY_ABS { return 0x0EB000C0, true }
	if op == UNARY_NEG { return 0x0EB10040, true }
	if op == UNARY_SQRT { return 0x0EB100C0, true }
	if op == UNARY_CMP { return 0x0EB40040, true }
	if op == UNARY_CMPE { return 0x0EB400C0, true }
	return 0, false
}

// typeHead returns the condition and size fields of an instruction on data of size bits (16, 32
// or 64) under cond, or ok false with the error set: no other size, and F16 only unconditional.
func typeHead(a @asm.Assembler, cond int, size int) (uint32, bool) {
	if size != 16 && size != 32 && size != 64 {
		a.SetError("arm32: a VFP data type must be F16, F32 or F64")
		return 0, false
	}
	if size == 16 && cond != arm32.COND_AL {
		a.SetError("arm32: a half-precision VFP instruction is unconditional")
		return 0, false
	}
	if !arm32.CondOk(a, cond) { return 0, false }
	var bits uint32 = 0xB00
	if size == 32 { bits = 0xA00 }
	if size == 16 { bits = 0x900 }
	return condBits(cond) | bits, true
}

// Arith3 emits the three-register operation op (ARITH_*) .F16 / .F32 / .F64{cond} Vd, Vn, Vm.
func Arith3(a @asm.Assembler, cond int, op int, size int, vd int, vn int, vm int) {
	word, known := arithWord(op)
	if !known {
		a.SetError("arm32: unknown VFP three-register operation")
		return
	}
	head, ok := typeHead(a, cond, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) || !vfpRegOk(a, dbl, vn) || !vfpRegOk(a, dbl, vm) { return }
	arm32.Emit32(a, head | word | placeVd(dbl, vd) | placeVn(dbl, vn) | placeVm(dbl, vm))
}

// Arith2 emits the two-register operation op (UNARY_*) .F16 / .F32 / .F64{cond} Vd, Vm.
func Arith2(a @asm.Assembler, cond int, op int, size int, vd int, vm int) {
	word, known := unaryWord(op)
	if !known {
		a.SetError("arm32: unknown VFP two-register operation")
		return
	}
	head, ok := typeHead(a, cond, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) || !vfpRegOk(a, dbl, vm) { return }
	arm32.Emit32(a, head | word | placeVd(dbl, vd) | placeVm(dbl, vm))
}

// CmpZero emits VCMP (VCMPE when signal) .F16 / .F32 / .F64{cond} Vd, #0.0.
func CmpZero(a @asm.Assembler, cond int, signal bool, size int, vd int) {
	head, ok := typeHead(a, cond, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) { return }
	var e uint32 = 0
	if signal { e = 0x80 }
	arm32.Emit32(a, head | 0x0EB50040 | e | placeVd(dbl, vd))
}
