package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// wordsAre reports whether a holds exactly the words want, with no error.
func wordsAre(a @asm.Assembler, want @[]uint32) bool {
	if a.HasError || a.Sections[0].Len != cast(int64, 4 * len(want)) { return false }
	for i := 0; i < len(want); i++ {
		if readInst(a.Sections[0], 4 * i) != want[i] { return false }
	}
	return true
}

// Each three-register operation in each size, as clang assembles it: VMLA.F32 S0, S1, S2;
// VMLS.F64 D0, D1, D2; VNMLS.F64; VNMLA.F32; VMUL.F64 D1, D2, D3; VNMUL.F32; VADD.F64 D16, D17,
// D31; VSUB.F32 S31, S30, S29; VDIV.F64; VFNMS.F32; VFNMA.F64; VFMA.F32; VFMS.F32; VADDEQ.F32;
// VADD.F16; VSUB.F16 S31, S30, S29; VMLA.F16; VFMA.F16.
func TestArith3() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Arith3(a, arm32.COND_AL, ARITH_MLA, 32, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_MLS, 64, D0, D1, D2)
	Arith3(a, arm32.COND_AL, ARITH_NMLS, 64, D0, D1, D2)
	Arith3(a, arm32.COND_AL, ARITH_NMLA, 32, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_MUL, 64, D1, D2, D3)
	Arith3(a, arm32.COND_AL, ARITH_NMUL, 32, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_ADD, 64, D16, D17, D31)
	Arith3(a, arm32.COND_AL, ARITH_SUB, 32, S31, S30, S29)
	Arith3(a, arm32.COND_AL, ARITH_DIV, 64, D0, D1, D2)
	Arith3(a, arm32.COND_AL, ARITH_FNMS, 32, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_FNMA, 64, D0, D1, D2)
	Arith3(a, arm32.COND_AL, ARITH_FMA, 32, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_FMS, 32, S0, S1, S2)
	Arith3(a, arm32.COND_EQ, ARITH_ADD, 32, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_ADD, 16, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_SUB, 16, S31, S30, S29)
	Arith3(a, arm32.COND_AL, ARITH_MLA, 16, S0, S1, S2)
	Arith3(a, arm32.COND_AL, ARITH_FMA, 16, S0, S1, S2)
	if !wordsAre(a,
			@[]uint32{0xEE000A81, 0xEE010B42, 0xEE110B02, 0xEE100AC1, 0xEE221B03, 0xEE200AC1, 0xEE710BAF,
					0xEE7FFA6E, 0xEE810B02, 0xEE900A81, 0xEE910B42, 0xEEA00A81, 0xEEA00AC1, 0x0E300A81, 0xEE300981,
					0xEE7FF96E, 0xEE000981, 0xEEA00981}) {
		return fail("a three-register operation is not clang's word")
	}
	return ""
}

// Each two-register operation and the compares with zero, as clang assembles them: VABS.F32 S0,
// S1; VNEG.F64 D0, D1; VSQRT.F32; VCMP.F32; VCMPE.F64; VSQRTEQ.F64; VABS.F16; VCMPE.F16; VCMP.F32
// S0, #0; VCMPE.F64 D0, #0; VCMP.F16 S0, #0; VCMPE.F16 S0, #0; VCMP.F64 D16, #0; VCMP.F32 S17,
// #0; VCMPE.F64 D31, #0.
func TestArith2() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Arith2(a, arm32.COND_AL, UNARY_ABS, 32, S0, S1)
	Arith2(a, arm32.COND_AL, UNARY_NEG, 64, D0, D1)
	Arith2(a, arm32.COND_AL, UNARY_SQRT, 32, S0, S1)
	Arith2(a, arm32.COND_AL, UNARY_CMP, 32, S0, S1)
	Arith2(a, arm32.COND_AL, UNARY_CMPE, 64, D0, D1)
	Arith2(a, arm32.COND_EQ, UNARY_SQRT, 64, D0, D1)
	Arith2(a, arm32.COND_AL, UNARY_ABS, 16, S0, S1)
	Arith2(a, arm32.COND_AL, UNARY_CMPE, 16, S0, S1)
	CmpZero(a, arm32.COND_AL, false, 32, S0)
	CmpZero(a, arm32.COND_AL, true, 64, D0)
	CmpZero(a, arm32.COND_AL, false, 16, S0)
	CmpZero(a, arm32.COND_AL, true, 16, S0)
	CmpZero(a, arm32.COND_AL, false, 64, D16)
	CmpZero(a, arm32.COND_AL, false, 32, S17)
	CmpZero(a, arm32.COND_AL, true, 64, D31)
	if !wordsAre(a,
			@[]uint32{0xEEB00AE0, 0xEEB10B41, 0xEEB10AE0, 0xEEB40A60, 0xEEB40BC1, 0x0EB10BC1, 0xEEB009E0,
					0xEEB409E0, 0xEEB50A40, 0xEEB50BC0, 0xEEB50940, 0xEEB509C0, 0xEEF50B40, 0xEEF58A40,
					0xEEF5FBC0}) {
		return fail("a two-register operation is not clang's word")
	}
	return ""
}

// An operation or size there is none of, an F16 one with a condition, a condition past AL, a
// register of the other kind or none, is an error that emits nothing.
func TestArithRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Arith3(bad[0], arm32.COND_AL, ARITH_FMS + 1, 32, S0, S1, S2)
	Arith3(bad[1], arm32.COND_AL, -1, 32, S0, S1, S2)
	Arith3(bad[2], arm32.COND_AL, ARITH_ADD, 8, S0, S1, S2)
	Arith3(bad[3], arm32.COND_EQ, ARITH_ADD, 16, S0, S1, S2)
	Arith3(bad[4], 15, ARITH_ADD, 32, S0, S1, S2)
	Arith3(bad[5], arm32.COND_AL, ARITH_ADD, 32, S0, S1, D2)
	Arith3(bad[6], arm32.COND_AL, ARITH_ADD, 64, D0, S1, D2)
	Arith2(bad[7], arm32.COND_AL, UNARY_CMPE + 1, 32, S0, S1)
	Arith2(bad[8], arm32.COND_AL, UNARY_ABS, 16, D0, S1)
	CmpZero(bad[9], arm32.COND_NE, false, 16, S0)
	CmpZero(bad[10], arm32.COND_AL, true, 64, S0)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VFP data-processing instruction was taken") }
	}
	return ""
}
