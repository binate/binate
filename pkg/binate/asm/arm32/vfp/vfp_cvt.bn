package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The VFP conversions: cond | 1110 1D11 | opc2 | Vd | 10 size | op 1 M 0 | Vm, the size field
// [9:8] 01 for F16, 10 for F32 and 11 for F64 -- the floating-point operand's, the source's
// when both are -- and VCVTA .. VCVTM, ARMv8's, 1111 in place of the condition.

// bitIf returns bit when on, else 0.
func bitIf(on bool, bit uint32) uint32 {
	if on { return bit }
	return 0
}

// VcvtFP emits VCVT.F64.F32{cond} Dd, Sm (to 64) or VCVT.F32.F64{cond} Sd, Dm (to 32).
func VcvtFP(a @asm.Assembler, cond int, to int, vd int, vm int) {
	if to != 32 && to != 64 {
		a.SetError("arm32: a VCVT between precisions converts to F32 or F64")
		return
	}
	var from int = 96 - to
	head, ok := typeHead(a, cond, from)
	if !ok || !vfpRegOk(a, to == 64, vd) || !vfpRegOk(a, from == 64, vm) { return }
	arm32.Emit32(a, head | 0x0EB700C0 | placeVd(to == 64, vd) | placeVm(from == 64, vm))
}

// VcvtFromInt emits VCVT.F16 / .F32 / .F64 (size 16, 32 or 64) .S32 (signed) or .U32{cond} Vd,
// Sm: a 32-bit integer to floating point, F16 unconditional.
func VcvtFromInt(a @asm.Assembler, cond int, size int, signed bool, vd int, sm int) {
	head, ok := typeHead(a, cond, size)
	if !ok || !vfpRegOk(a, size == 64, vd) || !vfpRegOk(a, false, sm) { return }
	arm32.Emit32(a,
			head | 0x0EB80040 | bitIf(signed, 0x80) | placeVd(size == 64, vd) | placeVm(false, sm))
}

// VcvtToInt emits VCVT (rounding toward zero) or VCVTR (by FPSCR's rounding mode, fpscr) .S32
// (signed) or .U32 .F16 / .F32 / .F64{cond} Sd, Vm (size the source's 16, 32 or 64): floating
// point to a 32-bit integer, F16 unconditional.
func VcvtToInt(a @asm.Assembler, cond int, size int, signed bool, fpscr bool, sd int, vm int) {
	head, ok := typeHead(a, cond, size)
	if !ok || !vfpRegOk(a, false, sd) || !vfpRegOk(a, size == 64, vm) { return }
	arm32.Emit32(a,
			head | 0x0EBC0040 | bitIf(signed, 0x10000) | bitIf(!fpscr, 0x80) | placeVd(false, sd) |
					placeVm(size == 64, vm))
}

// VcvtFixed emits VCVT between floating point of size bits (16, 32 or 64) and a fixed-point
// number of bits bits (16 or 32) with fbits fraction bits (0 .. 16 for 16 bits, 1 .. 32 for 32),
// in place: .S<bits> / .U<bits> .F<size> (toFixed) or .F<size> .S<bits> / .U<bits>{cond} Vd, Vd,
// #fbits; F16 unconditional.  The instruction holds bits - fbits, in imm4:i.
func VcvtFixed(a @asm.Assembler, cond int, size int, toFixed bool, signed bool, bits int, vd int,
		fbits int) {
	if bits != 16 && bits != 32 {
		a.SetError("arm32: a fixed-point VCVT's integer has 16 or 32 bits")
		return
	}
	var least int = 1
	if bits == 16 { least = 0 }
	if fbits < least || fbits > bits {
		a.SetError("arm32: a fixed-point VCVT's fraction bits are 0..16 for 16 bits, 1..32 for 32")
		return
	}
	head, ok := typeHead(a, cond, size)
	if !ok || !vfpRegOk(a, size == 64, vd) { return }
	var imm uint32 = cast(uint32, bits - fbits)
	arm32.Emit32(a,
			head | 0x0EBA0040 | bitIf(toFixed, 0x40000) | bitIf(!signed, 0x10000) | bitIf(bits == 32, 0x80) |
					((imm & 1) << 5) | (imm >> 1) | placeVd(size == 64, vd))
}

// VcvtHalf emits VCVTB (the bottom half) or VCVTT (top) .F16.F32 / .F16.F64 (toHalf) Sd, Vm or
// .F32.F16 / .F64.F16{cond} Vd, Sm (size 32 or 64).
func VcvtHalf(a @asm.Assembler, cond int, top bool, toHalf bool, size int, vd int, vm int) {
	if size != 32 && size != 64 {
		a.SetError("arm32: a VCVTB / VCVTT converts between F16 and F32 or F64")
		return
	}
	var dblD bool = size == 64 && !toHalf
	var dblM bool = size == 64 && toHalf
	if !arm32.CondOk(a, cond) || !vfpRegOk(a, dblD, vd) || !vfpRegOk(a, dblM, vm) { return }
	arm32.Emit32(a,
			condBits(cond) | 0x0EB20A40 | bitIf(size == 64, 0x100) | bitIf(toHalf, 0x10000) |
					bitIf(top, 0x80) | placeVd(dblD, vd) | placeVm(dblM, vm))
}

// VcvtBF16 emits VCVTB (the bottom half) or VCVTT (top) .BF16.F32{cond} Sd, Sm.
func VcvtBF16(a @asm.Assembler, cond int, top bool, sd int, sm int) {
	if !arm32.CondOk(a, cond) || !vfpRegOk(a, false, sd) || !vfpRegOk(a, false, sm) { return }
	arm32.Emit32(a,
			condBits(cond) | 0x0EB30940 | bitIf(top, 0x80) | placeVd(false, sd) | placeVm(false, sm))
}

// VcvtRound emits VCVTA / VCVTN / VCVTP / VCVTM (rm RM_A .. RM_M) .S32 (signed) or .U32 .F16 /
// .F32 / .F64 Sd, Vm (size the source's; unconditional).
func VcvtRound(a @asm.Assembler, rm int, size int, signed bool, sd int, vm int) {
	if rm < RM_A || rm > RM_M {
		a.SetError("arm32: VCVTA / VCVTN / VCVTP / VCVTM round to nearest, +infinity or -infinity")
		return
	}
	head, ok := typeHead(a, arm32.COND_AL, size)
	if !ok || !vfpRegOk(a, false, sd) || !vfpRegOk(a, size == 64, vm) { return }
	arm32.Emit32(a,
			head | 0x1EBC0040 | (cast(uint32, rm) << 16) | bitIf(signed, 0x80) | placeVd(false, sd) |
					placeVm(size == 64, vm))
}

// Vjcvt emits VJCVT.S32.F64{cond} Sd, Dm: ARMv8.3's JavaScript conversion, toward zero modulo
// 2^32.
func Vjcvt(a @asm.Assembler, cond int, sd int, dm int) {
	if !arm32.CondOk(a, cond) || !vfpRegOk(a, false, sd) || !vfpRegOk(a, true, dm) { return }
	arm32.Emit32(a, condBits(cond) | 0x0EB90BC0 | placeVd(false, sd) | placeVm(true, dm))
}
