package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// The conversions between precisions and with integers, as clang assembles them: VCVT.F64.F32
// D17, S31; .F32.F64 S31, D17; VCVTEQ.F64.F32; .F16.S32 S31, S30; .F32.U32 S1, S2; .F64.S32
// D31, S5; VCVTNE.F64.U32 D3, S4; .S32.F16 S3, S9; .U32.F32 S30, S1; VCVTR.S32.F64 S7, D20;
// VCVTR.U32.F32; VCVT.S32.F64 S2, D3.
func TestVcvtPrecisionAndInt() testing.TestResult {
	var a @asm.Assembler = newAsm()
	VcvtFP(a, arm32.COND_AL, 64, D17, S31)
	VcvtFP(a, arm32.COND_AL, 32, S31, D17)
	VcvtFP(a, arm32.COND_EQ, 64, D0, S1)
	VcvtFromInt(a, arm32.COND_AL, 16, true, S31, S30)
	VcvtFromInt(a, arm32.COND_AL, 32, false, S1, S2)
	VcvtFromInt(a, arm32.COND_AL, 64, true, D31, S5)
	VcvtFromInt(a, arm32.COND_NE, 64, false, D3, S4)
	VcvtToInt(a, arm32.COND_AL, 16, true, false, S3, S9)
	VcvtToInt(a, arm32.COND_AL, 32, false, false, S30, S1)
	VcvtToInt(a, arm32.COND_AL, 64, true, true, S7, D20)
	VcvtToInt(a, arm32.COND_AL, 32, false, true, S0, S1)
	VcvtToInt(a, arm32.COND_AL, 64, true, false, S2, D3)
	if !wordsAre(a,
			@[]uint32{0xEEF71AEF, 0xEEF7FBE1, 0x0EB70AE0, 0xEEF8F9CF, 0xEEF80A41, 0xEEF8FBE2, 0x1EB83B42,
					0xEEFD19E4, 0xEEBCFAE0, 0xEEFD3B64, 0xEEBC0A60, 0xEEBD1BC3}) {
		return fail("a precision or integer VCVT is not clang's word")
	}
	return ""
}

// The fixed-point, half-precision, BFloat16, directed-rounding and JavaScript conversions, as
// clang assembles them: VCVT.F32.S16 S0, S0, #16; #0; .U16.F64 D17, D17, #3; .F16.U32 S31, S31,
// #32; .S32.F32 S5, S5, #1; VCVTGT.F64.S32 D2, D2, #20; VCVTB.F32.F16 S0, S1; VCVTT.F16.F32
// S31, S30; VCVTB.F64.F16 D17, S3; VCVTT.F16.F64 S5, D30; VCVTBEQ.F16.F64; VCVTB.BF16.F32;
// VCVTTLT.BF16.F32 S31, S2; VCVTA.S32.F32; VCVTN.U32.F64 S31, D17; VCVTP.S32.F16 S2, S3;
// VCVTM.U32.F32 S4, S5; VJCVT.S32.F64 S0, D1; VJCVTVS S31, D31.
func TestVcvtFixedHalfAndRounding() testing.TestResult {
	var a @asm.Assembler = newAsm()
	VcvtFixed(a, arm32.COND_AL, 32, false, true, 16, S0, 16)
	VcvtFixed(a, arm32.COND_AL, 32, false, true, 16, S0, 0)
	VcvtFixed(a, arm32.COND_AL, 64, true, false, 16, D17, 3)
	VcvtFixed(a, arm32.COND_AL, 16, false, false, 32, S31, 32)
	VcvtFixed(a, arm32.COND_AL, 32, true, true, 32, S5, 1)
	VcvtFixed(a, arm32.COND_GT, 64, false, true, 32, D2, 20)
	VcvtHalf(a, arm32.COND_AL, false, false, 32, S0, S1)
	VcvtHalf(a, arm32.COND_AL, true, true, 32, S31, S30)
	VcvtHalf(a, arm32.COND_AL, false, false, 64, D17, S3)
	VcvtHalf(a, arm32.COND_AL, true, true, 64, S5, D30)
	VcvtHalf(a, arm32.COND_EQ, false, true, 64, S0, D1)
	VcvtBF16(a, arm32.COND_AL, false, S0, S1)
	VcvtBF16(a, arm32.COND_LT, true, S31, S2)
	VcvtRound(a, RM_A, 32, true, S0, S1)
	VcvtRound(a, RM_N, 64, false, S31, D17)
	VcvtRound(a, RM_P, 16, true, S2, S3)
	VcvtRound(a, RM_M, 32, false, S4, S5)
	Vjcvt(a, arm32.COND_AL, S0, D1)
	Vjcvt(a, arm32.COND_VS, S31, D31)
	if !wordsAre(a,
			@[]uint32{0xEEBA0A40, 0xEEBA0A48, 0xEEFF1B66, 0xEEFBF9C0, 0xEEFE2AEF, 0xCEBA2BC6, 0xEEB20A60,
					0xEEF3FACF, 0xEEF21B61, 0xEEF32BEE, 0x0EB30B41, 0xEEB30960, 0xBEF3F9C1, 0xFEBC0AE0, 0xFEFDFB61,
					0xFEBE19E1, 0xFEBF2A62, 0xEEB90BC1, 0x6EF9FBEF}) {
		return fail("a fixed-point, half, BFloat16, rounding or JavaScript VCVT is not clang's word")
	}
	return ""
}

// A conversion there is no encoding of is an error that emits nothing: a precision VCVT to F16,
// an F16 one with a condition, an integer one from a D register, fraction bits past the integer's
// width or below its least (0 for 16 bits, 1 for 32), a fixed-point integer of 8 bits, a
// half-precision VCVTB to F16 from F16, a rounding past RM_M, a JavaScript one from an S register.
func TestVcvtRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	VcvtFP(bad[0], arm32.COND_AL, 16, S0, S1)
	VcvtFromInt(bad[1], arm32.COND_EQ, 16, true, S0, S1)
	VcvtFromInt(bad[2], arm32.COND_AL, 32, true, S0, D1)
	VcvtFixed(bad[3], arm32.COND_AL, 32, false, true, 16, S0, 17)
	VcvtFixed(bad[4], arm32.COND_AL, 32, false, true, 32, S0, 33)
	VcvtFixed(bad[5], arm32.COND_AL, 32, false, true, 32, S0, 0)
	VcvtFixed(bad[6], arm32.COND_AL, 32, false, true, 8, S0, 1)
	VcvtHalf(bad[7], arm32.COND_AL, false, true, 16, S0, S1)
	VcvtRound(bad[8], RINT_R, 32, true, S0, S1)
	Vjcvt(bad[9], arm32.COND_AL, S0, S1)
	VcvtToInt(bad[10], arm32.COND_AL, 64, true, false, D0, D1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VFP conversion was taken") }
	}
	return ""
}
