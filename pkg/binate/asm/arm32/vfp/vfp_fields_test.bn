package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Every VFP encoder's fields are exact (vfp.bni): a condition or a register number with no
// encoding sets the assembler error and emits nothing, instead of being masked into the word.
// (fail, newAsm, readInst, oneWordIs and rejected are in helpers_test.bn.)

// condCalls calls each VFP encoder that takes a condition, once, under the condition c, with
// operands it encodes as one word.
var condCalls @[]*func(@asm.Assembler, int) = @[]*func(@asm.Assembler, int){
		func(a @asm.Assembler, c int) { VaddF32(a, c, S1, S2, S3) },
		func(a @asm.Assembler, c int) { VsubF64(a, c, D1, D2, D3) },
		func(a @asm.Assembler, c int) { VmulF32(a, c, S1, S2, S3) },
		func(a @asm.Assembler, c int) { VdivF64(a, c, D1, D2, D3) },
		func(a @asm.Assembler, c int) { VnegF32(a, c, S1, S2) },
		func(a @asm.Assembler, c int) { VmovF64(a, c, D1, D2) },
		func(a @asm.Assembler, c int) { VmovCoreToSingle(a, c, S1, arm32.R2) },
		func(a @asm.Assembler, c int) { VmovSingleToCore(a, c, arm32.R2, S1) },
		func(a @asm.Assembler, c int) { VmovCoresToDouble(a, c, D1, arm32.R2, arm32.R3) },
		func(a @asm.Assembler, c int) { VmovDoubleToCores(a, c, arm32.R2, arm32.R3, D1) },
		func(a @asm.Assembler, c int) { VcmpF32(a, c, S1, S2) },
		func(a @asm.Assembler, c int) { VcmpeF64(a, c, D1, D2) },
		func(a @asm.Assembler, c int) { VmrsApsrNzcv(a, c) },
		func(a @asm.Assembler, c int) { VcvtF64F32(a, c, D1, S2) },
		func(a @asm.Assembler, c int) { VcvtS32F64(a, c, S1, D2) },
		func(a @asm.Assembler, c int) { Vldr32(a, c, S1, arm32.R2, 8) },
		func(a @asm.Assembler, c int) { Vstr64(a, c, D1, arm32.R2, -8) }}

// Each VFP encoder emits one word under COND_AL and, under 15, 16 or -1 -- conditions that would
// land in the unconditional space or wrap onto another one -- sets the assembler error and emits
// nothing, no fixup either.
func TestEveryEncoderChecksItsCondition() testing.TestResult {
	var bad @[]int = @[]int{15, 16, -1}
	for i := 0; i < len(condCalls); i++ {
		var a @asm.Assembler = newAsm()
		condCalls[i](a, arm32.COND_AL)
		if a.HasError || a.Sections[0].Len != 4 {
			return fail(buf.Concat("not one word under COND_AL: call ", strconv.Itoa(i)))
		}
		for j := 0; j < len(bad); j++ {
			a = newAsm()
			condCalls[i](a, bad[j])
			if !rejected(a) || a.Sections[0].NumFixups != 0 {
				return fail(
						buf.Concat(buf.Concat("call ", strconv.Itoa(i)),
								buf.Concat(" accepted condition ", strconv.Itoa(bad[j]))))
			}
		}
	}
	return ""
}

// The VFP encoders take S0..S31 for a single-precision operand, D0..D31 for a double and
// R0..R15 for a core register (PC included, as clang takes it), with clang's words
// (`clang -target armv7a-none-eabi -mfpu=vfpv3`), and reject a register of another precision
// or kind, a core register outside R0..R15, and a VLDR / VSTR offset with no imm8 encoding,
// emitting nothing.
func TestVfpRegisterFieldsChecked() testing.TestResult {
	var a @asm.Assembler = newAsm()
	VaddF64(a, arm32.COND_AL, D16, D17, D31)
	if !oneWordIs(a, 0xEE710BAF) { return fail("vadd.f64 d16, d17, d31") }
	a = newAsm()
	VaddF32(a, arm32.COND_NE, S1, S2, S3)
	if !oneWordIs(a, 0x1E710A21) { return fail("vaddne.f32 s1, s2, s3") }
	a = newAsm()
	VmovCoreToSingle(a, arm32.COND_AL, S0, arm32.PC)
	if !oneWordIs(a, 0xEE00FA10) { return fail("vmov s0, pc") }
	a = newAsm()
	VmovSingleToCore(a, arm32.COND_AL, arm32.PC, S0)
	if !oneWordIs(a, 0xEE10FA10) { return fail("vmov pc, s0") }
	a = newAsm()
	VmovCoresToDouble(a, arm32.COND_AL, D0, arm32.PC, arm32.R0)
	if !oneWordIs(a, 0xEC40FB10) { return fail("vmov d0, pc, r0") }
	a = newAsm()
	VmovDoubleToCores(a, arm32.COND_AL, arm32.R0, arm32.PC, D0)
	if !oneWordIs(a, 0xEC5F0B10) { return fail("vmov r0, pc, d0") }
	a = newAsm()
	Vldr32(a, arm32.COND_AL, S0, arm32.PC, 4)
	if !oneWordIs(a, 0xED9F0A01) { return fail("vldr s0, [pc, #4]") }
	a = newAsm()
	Vstr64(a, arm32.COND_AL, D0, arm32.PC, 4)
	if !oneWordIs(a, 0xED8F0B01) { return fail("vstr d0, [pc, #4]") }
	a = newAsm()
	Vldr64(a, arm32.COND_NE, D3, arm32.R1, -8)
	if !oneWordIs(a, 0x1D113B02) { return fail("vldrne d3, [r1, #-8]") }
	var bad @[]*func(@asm.Assembler) = @[]*func(@asm.Assembler){
			func(a @asm.Assembler) { VaddF32(a, arm32.COND_AL, D1, S2, S3) },
			func(a @asm.Assembler) { VaddF32(a, arm32.COND_AL, S1, arm32.R2, S3) },
			func(a @asm.Assembler) { VaddF32(a, arm32.COND_AL, S1, S2, 96) },
			func(a @asm.Assembler) { VsubF64(a, arm32.COND_AL, S1, D2, D3) },
			func(a @asm.Assembler) { VmulF64(a, arm32.COND_AL, D1, D2, 96) },
			func(a @asm.Assembler) { VnegF64(a, arm32.COND_AL, D1, S2) },
			func(a @asm.Assembler) { VmovF32(a, arm32.COND_AL, S1, D2) },
			func(a @asm.Assembler) { VcmpF32(a, arm32.COND_AL, arm32.R1, S2) },
			func(a @asm.Assembler) { VcvtF64F32(a, arm32.COND_AL, D1, D2) },
			func(a @asm.Assembler) { VcvtF32F64(a, arm32.COND_AL, S1, S2) },
			func(a @asm.Assembler) { VcvtS32F64(a, arm32.COND_AL, D1, D2) },
			func(a @asm.Assembler) { VmovCoreToSingle(a, arm32.COND_AL, D0, arm32.R0) },
			func(a @asm.Assembler) { VmovCoreToSingle(a, arm32.COND_AL, S0, 16) },
			func(a @asm.Assembler) { VmovSingleToCore(a, arm32.COND_AL, S0, S1) },
			func(a @asm.Assembler) { VmovCoresToDouble(a, arm32.COND_AL, S0, arm32.R0, arm32.R1) },
			func(a @asm.Assembler) { VmovCoresToDouble(a, arm32.COND_AL, D0, arm32.R0, 16) },
			func(a @asm.Assembler) { VmovDoubleToCores(a, arm32.COND_AL, -1, arm32.R1, D0) },
			func(a @asm.Assembler) { Vldr32(a, arm32.COND_AL, D0, arm32.R1, 4) },
			func(a @asm.Assembler) { Vldr64(a, arm32.COND_AL, D0, 16, 4) },
			func(a @asm.Assembler) { Vstr32(a, arm32.COND_AL, S0, arm32.R1, 1024) },
			func(a @asm.Assembler) { Vstr32(a, arm32.COND_AL, S0, arm32.R1, -1024) },
			func(a @asm.Assembler) { Vstr64(a, arm32.COND_AL, D0, arm32.R1, 2) },
			func(a @asm.Assembler) { Vstr64(a, arm32.COND_AL, D0, arm32.R1, -2) }}
	for i := 0; i < len(bad); i++ {
		a = newAsm()
		bad[i](a)
		if !rejected(a) { return fail(buf.Concat("accepted: case ", strconv.Itoa(i))) }
	}
	return ""
}
