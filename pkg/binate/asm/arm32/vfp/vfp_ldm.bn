package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// VLDM and VSTM: cond | 110P UDWL | Rn | Vd | 101 sz | imm8, P U 01 for increment after, 10 for
// decrement before (which writes back), W for the write-back, sz 1 for D registers (imm8 twice
// their number; FLDMX / FSTMX's twice plus 1) and 0 for S (imm8 their number), Vd the first.  More
// than 16 D registers is UNPREDICTABLE in the architecture; clang encodes such a list all the same
// (but for VLDMIA / VSTMIA without write-back), and so do these.

// vfpMultiple emits VLDM (VSTM when !load), FLDMX / FSTMX when x, as Vldm and Fldmx take their
// operands.
func vfpMultiple(a @asm.Assembler, cond int, load bool, db bool, wb bool, rn int, first int, n int,
		x bool) {
	if !arm32.CondOk(a, cond) || !arm32.RegOk(a, rn, false) { return }
	if db && !wb {
		a.SetError("arm32: a decrement-before VLDM / VSTM writes back")
		return
	}
	var dbl bool = first >= D0 && first <= D31
	if x && !dbl {
		a.SetError("arm32: an FLDMX / FSTMX transfers D registers")
		return
	}
	if !dbl && !vfpRegOk(a, false, first) { return }
	var top int = S31
	if dbl { top = D31 }
	if n < 1 || n > top - first + 1 {
		a.SetError("arm32: a VLDM / VSTM list is 1 or more registers, up to S31 or D31")
		return
	}
	var imm8 int = n
	var sz uint32 = 0xA00
	if dbl {
		imm8 = 2 * n
		sz = 0xB00
	}
	if x { imm8 = imm8 + 1 }
	var pu uint32 = 0x00800000
	if db { pu = 0x01000000 }
	arm32.Emit32(a,
			condBits(cond) | 0x0C000000 | pu | bitIf(wb, 0x00200000) | bitIf(load, 0x00100000) |
					(cast(uint32, rn) << 16) | placeVd(dbl, first) | sz | cast(uint32, imm8))
}

// Vldm emits VLDMIA{cond} Rn{!}, {list} (VLDMDB{cond} Rn!, {list} when db, which writes back):
// list n S or D registers from first (S0..S31 or D0..D31; up to the last of them).
func Vldm(a @asm.Assembler, cond int, db bool, wb bool, rn int, first int, n int) {
	vfpMultiple(a, cond, true, db, wb, rn, first, n, false)
}

// Vstm emits VSTMIA{cond} / VSTMDB{cond}, its operands as Vldm takes them.
func Vstm(a @asm.Assembler, cond int, db bool, wb bool, rn int, first int, n int) {
	vfpMultiple(a, cond, false, db, wb, rn, first, n, false)
}

// Fldmx emits FLDMIAX{cond} / FLDMDBX{cond} (the pre-UAL load of unknown precision), its operands
// as Vldm takes them, the list D registers only.
func Fldmx(a @asm.Assembler, cond int, db bool, wb bool, rn int, first int, n int) {
	vfpMultiple(a, cond, true, db, wb, rn, first, n, true)
}

// Fstmx emits FSTMIAX{cond} / FSTMDBX{cond}, its operands as Fldmx takes them.
func Fstmx(a @asm.Assembler, cond int, db bool, wb bool, rn int, first int, n int) {
	vfpMultiple(a, cond, false, db, wb, rn, first, n, true)
}

// Vpush emits VPUSH{cond} {list}, VSTMDB SP!: n S or D registers from first.
func Vpush(a @asm.Assembler, cond int, first int, n int) {
	vfpMultiple(a, cond, false, true, true, arm32.SP, first, n, false)
}

// Vpop emits VPOP{cond} {list}, VLDMIA SP!: n S or D registers from first.
func Vpop(a @asm.Assembler, cond int, first int, n int) {
	vfpMultiple(a, cond, true, false, true, arm32.SP, first, n, false)
}
