package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// Each VLDM / VSTM form as clang assembles it: VLDMIA R0, {D0-D3}; VLDMIA R0!, {S0-S3}; VLDMDB R0!,
// {D0}; VSTMIA R1, {S5-S7}; VLDMIA R0, {S31}; VLDMIA R0, {D15-D16}; VLDMIA R0, {D16-D31};
// VLDMIA R0!, {D0-D16} (17, which clang takes with write-back); VLDMIA PC!, {D0}; VPUSH {D8-D15};
// VPOP {S0, S1}; VPUSHEQ {D0}; VPUSH {D0-D31}; VPUSH {S0-S31}; FLDMIAX R0, {D0}; FLDMDBX R0!, {D0};
// FSTMIAX R0!, {D0-D1}; FSTMDBX R0!, {D0}.
func TestVldmVstm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldm(a, arm32.COND_AL, false, false, arm32.R0, D0, 4)
	Vldm(a, arm32.COND_AL, false, true, arm32.R0, S0, 4)
	Vldm(a, arm32.COND_AL, true, true, arm32.R0, D0, 1)
	Vstm(a, arm32.COND_AL, false, false, arm32.R1, S5, 3)
	Vldm(a, arm32.COND_AL, false, false, arm32.R0, S31, 1)
	Vldm(a, arm32.COND_AL, false, false, arm32.R0, D15, 2)
	Vldm(a, arm32.COND_AL, false, false, arm32.R0, D16, 16)
	Vldm(a, arm32.COND_AL, false, true, arm32.R0, D0, 17)
	Vldm(a, arm32.COND_AL, false, true, arm32.PC, D0, 1)
	Vpush(a, arm32.COND_AL, D8, 8)
	Vpop(a, arm32.COND_AL, S0, 2)
	Vpush(a, arm32.COND_EQ, D0, 1)
	Vpush(a, arm32.COND_AL, D0, 32)
	Vpush(a, arm32.COND_AL, S0, 32)
	Fldmx(a, arm32.COND_AL, false, false, arm32.R0, D0, 1)
	Fldmx(a, arm32.COND_AL, true, true, arm32.R0, D0, 1)
	Fstmx(a, arm32.COND_AL, false, true, arm32.R0, D0, 2)
	Fstmx(a, arm32.COND_AL, true, true, arm32.R0, D0, 1)
	if !wordsAre(a,
			@[]uint32{0xEC900B08, 0xECB00A04, 0xED300B02, 0xECC12A03, 0xECD0FA01, 0xEC90FB04, 0xECD00B20,
					0xECB00B22, 0xECBF0B02, 0xED2D8B10, 0xECBD0A02, 0x0D2D0B02, 0xED2D0B40, 0xED2D0A20, 0xEC900B03,
					0xED300B03, 0xECA00B05, 0xED200B03}) {
		return fail("a VLDM / VSTM is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: decrement before without write-back,
// an S list for FLDMX, no registers, a list past S31 or D31, a base past R15, a register that is
// neither S nor D, a condition past AL.
func TestVldmVstmRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 8)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Vldm(bad[0], arm32.COND_AL, true, false, arm32.R0, D0, 1)
	Fldmx(bad[1], arm32.COND_AL, false, false, arm32.R0, S0, 1)
	Vstm(bad[2], arm32.COND_AL, false, false, arm32.R0, D0, 0)
	Vldm(bad[3], arm32.COND_AL, false, false, arm32.R0, S30, 3)
	Vpush(bad[4], arm32.COND_AL, D16, 17)
	Vldm(bad[5], arm32.COND_AL, false, false, 16, D0, 1)
	Vldm(bad[6], arm32.COND_AL, false, false, arm32.R0, arm32.R1, 1)
	Vpop(bad[7], 15, D0, 1)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VLDM / VSTM was taken") }
	}
	return ""
}
