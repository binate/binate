package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// VLDR and VSTR: cond | 1101 UD0L | Rn | Vd | 10 size | imm8, the size field 01 for .16 (ARMv8.2's,
// unconditional), 10 for .32 and 11 for .64, imm8 the offset in units of the size (halfwords for
// .16, words otherwise) and U whether it is added.

// vfpTransfer emits VLDR (VSTR when !load), as Vldr and Vstr take their operands.
func vfpTransfer(a @asm.Assembler, cond int, load bool, size int, vd int, op arm32.Operand) {
	if size != 16 && size != 32 && size != 64 {
		a.SetError("arm32: a VLDR / VSTR transfers 16, 32 or 64 bits")
		return
	}
	if size == 16 && cond != arm32.COND_AL {
		a.SetError("arm32: VLDR.16 and VSTR.16 are unconditional")
		return
	}
	if !arm32.CondOk(a, cond) || !vfpRegOk(a, size == 64, vd) { return }
	var scale int = 4
	var bits uint32 = 0xB00
	if size == 32 { bits = 0xA00 }
	if size == 16 {
		scale = 2
		bits = 0x900
	}
	var word uint32 = condBits(cond) | 0x0D000000 | bitIf(load, 0x00100000) | bits |
			placeVd(size == 64, vd)
	if op.Kind == arm32.OP_LABEL {
		if op.Sub {
			a.SetError("arm32: only a zero offset can be subtracted (SubIndex)")
			return
		}
		var kind int = arm32.FIX_LDC_PC
		if size == 16 { kind = arm32.FIX_LDC16_PC }
		a.AddFixup(op.Label, kind, cast(int64, op.Imm), 4)
		arm32.Emit32(a, word | 0x00800000 | (cast(uint32, arm32.PC) << 16))
		return
	}
	if op.Kind != arm32.OP_MEM_IMM {
		a.SetError("arm32: a VLDR / VSTR takes [Rn, #imm] or a label")
		return
	}
	if !arm32.RegOk(a, op.Reg, false) { return }
	if op.Sub && op.Imm != 0 {
		a.SetError("arm32: only a zero offset can be subtracted (SubIndex)")
		return
	}
	if op.Imm % scale != 0 || op.Imm < -255 * scale || op.Imm > 255 * scale {
		a.SetError(
				"arm32: a VLDR / VSTR offset is a multiple of 4 within +/-1020 (of 2 within +/-510 for .16)")
		return
	}
	var mag int = op.Imm
	var up uint32 = 0x00800000
	if mag < 0 || op.Sub {
		mag = -mag
		up = 0
	}
	arm32.Emit32(a, word | up | (cast(uint32, op.Reg) << 16) | cast(uint32, mag / scale))
}

// Vldr emits VLDR{cond}.16 / .32 / .64 (size 16, 32 or 64) Vd, op: [Rn, #±imm] (arm32.MemImm, its
// negative zero arm32.SubIndex) with imm a multiple of 4 within +/-1020 (for .16, of 2 within
// +/-510), or a label (arm32.Label, arm32.LabelAddend), PC-relative, which only a local label in
// its own section resolves (arm32.FIX_LDC_PC; FIX_LDC16_PC for .16).  .16 is unconditional.
func Vldr(a @asm.Assembler, cond int, size int, vd int, op arm32.Operand) {
	vfpTransfer(a, cond, true, size, vd, op)
}

// Vstr emits VSTR{cond}.16 / .32 / .64 Vd, op, its operands as Vldr takes them.
func Vstr(a @asm.Assembler, cond int, size int, vd int, op arm32.Operand) {
	vfpTransfer(a, cond, false, size, vd, op)
}
