package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// Each VLDR / VSTR form as clang assembles it: VLDR S0, [R0]; [R0, #-4]; [R0, #1020]; [R0, #-0];
// VLDR D16, [SP, #-1020]; VLDR.16 S0, [R0, #2]; [R0, #510]; VSTR.16 S0, [R0, #-2]; VSTR D31, [R0,
// #-8]; VLDREQ S0, [R0]; VLDR S0, [PC, #8]; VLDR D0, [R0, #4] (a .64's offset counts words).
func TestVldrVstr() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr(a, arm32.COND_AL, 32, S0, arm32.MemImm(arm32.R0, 0))
	Vldr(a, arm32.COND_AL, 32, S0, arm32.MemImm(arm32.R0, -4))
	Vldr(a, arm32.COND_AL, 32, S0, arm32.MemImm(arm32.R0, 1020))
	Vldr(a, arm32.COND_AL, 32, S0, arm32.SubIndex(arm32.MemImm(arm32.R0, 0)))
	Vldr(a, arm32.COND_AL, 64, D16, arm32.MemImm(arm32.SP, -1020))
	Vldr(a, arm32.COND_AL, 16, S0, arm32.MemImm(arm32.R0, 2))
	Vldr(a, arm32.COND_AL, 16, S0, arm32.MemImm(arm32.R0, 510))
	Vstr(a, arm32.COND_AL, 16, S0, arm32.MemImm(arm32.R0, -2))
	Vstr(a, arm32.COND_AL, 64, D31, arm32.MemImm(arm32.R0, -8))
	Vldr(a, arm32.COND_EQ, 32, S0, arm32.MemImm(arm32.R0, 0))
	Vldr(a, arm32.COND_AL, 32, S0, arm32.MemImm(arm32.PC, 8))
	Vldr(a, arm32.COND_AL, 64, D0, arm32.MemImm(arm32.R0, 4))
	if !wordsAre(a,
			@[]uint32{0xED900A00, 0xED100A01, 0xED900AFF, 0xED100A00, 0xED5D0BFF, 0xED900901, 0xED9009FF,
					0xED000901, 0xED40FB02, 0x0D900A00, 0xED9F0A02, 0xED900B01}) {
		return fail("a VLDR / VSTR is not clang's word")
	}
	return ""
}

// A VLDR of a label is the PC-relative word with U set and a fixup: arm32.FIX_LDC_PC, and
// FIX_LDC16_PC for .16 (its offset in halfwords).
func TestVldrLabel() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vldr(a, arm32.COND_AL, 64, D0, arm32.LabelAddend("lbl", 4))
	Vstr(a, arm32.COND_AL, 16, S1, arm32.Label("lbl"))
	var s @asm.Section = a.Sections[0]
	if !wordsAre(a, @[]uint32{0xED9F0B00, 0xEDCF0900}) || s.NumFixups != 2 ||
			s.Fixups[0].Kind != arm32.FIX_LDC_PC || s.Fixups[0].Addend != 4 ||
			s.Fixups[1].Kind != arm32.FIX_LDC16_PC {
		return fail("a VLDR / VSTR of a label is not the PC-relative word with its fixup")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: 8 bits, .16 with a condition, an
// offset past 1020, one no multiple of 4 (of 2 for .16, or past 510), a writeback, a subtracted
// offset other than zero or label, a D register for .32, the smallest int as the offset.
func TestVldrVstrRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 11)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Vldr(bad[0], arm32.COND_AL, 8, S0, arm32.MemImm(arm32.R0, 0))
	Vldr(bad[1], arm32.COND_EQ, 16, S0, arm32.MemImm(arm32.R0, 0))
	Vldr(bad[2], arm32.COND_AL, 32, S0, arm32.MemImm(arm32.R0, 1024))
	Vldr(bad[3], arm32.COND_AL, 32, S0, arm32.MemImm(arm32.R0, 2))
	Vldr(bad[4], arm32.COND_AL, 16, S0, arm32.MemImm(arm32.R0, 1))
	Vldr(bad[5], arm32.COND_AL, 16, S0, arm32.MemImm(arm32.R0, 512))
	Vldr(bad[6], arm32.COND_AL, 32, S0, arm32.MemPre(arm32.R0, 4))
	Vstr(bad[7], arm32.COND_AL, 32, S0, arm32.SubIndex(arm32.MemImm(arm32.R0, 4)))
	Vstr(bad[8], arm32.COND_AL, 32, D0, arm32.MemImm(arm32.R0, 0))
	Vldr(bad[9], arm32.COND_AL, 32, S0, arm32.SubIndex(arm32.Label("lbl")))
	Vldr(bad[10], arm32.COND_AL, 64, D0, arm32.MemImm(arm32.R0, hostMinInt()))
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VLDR / VSTR was taken") }
	}
	return ""
}

// hostMinInt returns the host's smallest int.
func hostMinInt() int {
	var v int64 = -9223372036854775808
	if sizeof(int) == 4 { v = -2147483648 }
	return cast(int, v)
}
