package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The VFP moves: a register copy, VFPv3's immediate, a pair of S registers to or from two core
// registers, a D register's 32-bit lane to or from one, the system registers to or from one
// (VMRS / VMSR), and ARMv8.2's half-precision moves (VMOV.F16 to or from a core register, VINS,
// VMOVX; each unconditional).

// VmovReg emits VMOV.F32 / .F64{cond} Vd, Vm (size 32 or 64): a register copy.
func VmovReg(a @asm.Assembler, cond int, size int, vd int, vm int) {
	if size != 32 && size != 64 {
		a.SetError("arm32: a VFP register copy is F32 or F64")
		return
	}
	head, ok := typeHead(a, cond, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) || !vfpRegOk(a, dbl, vm) { return }
	arm32.Emit32(a, head | 0x0EB00040 | placeVd(dbl, vd) | placeVm(dbl, vm))
}

// VmovImm emits VMOV.F16 / .F32 / .F64{cond} Vd, #imm, imm8 the immediate's 8-bit encoding, 0 ..
// 255 (its sign, exponent and fraction, as VFPExpandImm reads them).
func VmovImm(a @asm.Assembler, cond int, size int, vd int, imm8 int) {
	head, ok := typeHead(a, cond, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) { return }
	if imm8 < 0 || imm8 > 255 {
		a.SetError("arm32: a VFP immediate's encoding is 0..255")
		return
	}
	var imm uint32 = cast(uint32, imm8)
	arm32.Emit32(a, head | 0x0EB00000 | ((imm >> 4) << 16) | (imm & 15) | placeVd(dbl, vd))
}

// emitSinglePair emits a two-core-register move with Sm and Sm + 1 (base: to or from the core
// registers): Sm S0 .. S30, Rt and Rt2 R0 .. R15.
func emitSinglePair(a @asm.Assembler, cond int, base uint32, sm int, rt int, rt2 int) {
	if !arm32.CondOk(a, cond) || !vfpRegOk(a, false, sm) || !arm32.RegOk(a, rt, false) ||
			!arm32.RegOk(a, rt2, false) {
		return
	}
	if sm == S31 {
		a.SetError("arm32: a pair of single-precision registers starts at S0..S30")
		return
	}
	arm32.Emit32(a,
			condBits(cond) | base | (cast(uint32, rt2) << 16) | (cast(uint32, rt) << 12) |
					placeVm(false, sm))
}

// VmovCoresToSingles emits VMOV{cond} Sm, Sm + 1, Rt, Rt2.
func VmovCoresToSingles(a @asm.Assembler, cond int, sm int, rt int, rt2 int) {
	emitSinglePair(a, cond, 0x0C400A10, sm, rt, rt2)
}

// VmovSinglesToCores emits VMOV{cond} Rt, Rt2, Sm, Sm + 1.
func VmovSinglesToCores(a @asm.Assembler, cond int, rt int, rt2 int, sm int) {
	emitSinglePair(a, cond, 0x0C500A10, sm, rt, rt2)
}

// emitLane emits a move of D register d's 32-bit lane x (0 or 1) to or from Rt (base).
func emitLane(a @asm.Assembler, cond int, base uint32, d int, x int, rt int) {
	if !arm32.CondOk(a, cond) || !vfpRegOk(a, true, d) || !arm32.RegOk(a, rt, false) { return }
	if x != 0 && x != 1 {
		a.SetError("arm32: a D register's 32-bit lane is 0 or 1")
		return
	}
	arm32.Emit32(a,
			condBits(cond) | base | (cast(uint32, x) << 21) | (cast(uint32, rt) << 12) | placeVn(true, d))
}

// VmovCoreToLane emits VMOV{cond}.32 Dd[x], Rt.
func VmovCoreToLane(a @asm.Assembler, cond int, dd int, x int, rt int) {
	emitLane(a, cond, 0x0E000B10, dd, x, rt)
}

// VmovLaneToCore emits VMOV{cond}.32 Rt, Dn[x].
func VmovLaneToCore(a @asm.Assembler, cond int, rt int, dn int, x int) {
	emitLane(a, cond, 0x0E100B10, dn, x, rt)
}

// sysRegOk reports whether reg is a VFP system register (FPSID .. FPINST2) -- one VMSR may write
// unless an MVFR -- setting the error if not.
func sysRegOk(a @asm.Assembler, reg int, write bool) bool {
	var known bool = reg == FPSID || reg == FPSCR || reg == FPEXC || reg == FPINST || reg == FPINST2
	if !write && (reg == MVFR0 || reg == MVFR1 || reg == MVFR2) { known = true }
	if !known {
		if write {
			a.SetError("arm32: VMSR writes FPSID, FPSCR, FPEXC, FPINST or FPINST2")
		} else {
			a.SetError("arm32: VMRS reads FPSID, FPSCR, MVFR0..MVFR2, FPEXC, FPINST or FPINST2")
		}
	}
	return known
}

// Vmrs emits VMRS{cond} Rt, reg: Rt R0 .. R14, or PC for APSR_nzcv with FPSCR.
func Vmrs(a @asm.Assembler, cond int, rt int, reg int) {
	if !arm32.CondOk(a, cond) || !sysRegOk(a, reg, false) || !arm32.RegOk(a, rt, false) { return }
	if rt == arm32.PC && reg != FPSCR {
		a.SetError("arm32: VMRS writes APSR_nzcv only from FPSCR")
		return
	}
	arm32.Emit32(a, condBits(cond) | 0x0EF00A10 | (cast(uint32, reg) << 16) | (cast(uint32, rt) << 12))
}

// Vmsr emits VMSR{cond} reg, Rt: Rt R0 .. R14.
func Vmsr(a @asm.Assembler, cond int, reg int, rt int) {
	if !arm32.CondOk(a, cond) || !sysRegOk(a, reg, true) || !arm32.RegOk(a, rt, true) { return }
	arm32.Emit32(a, condBits(cond) | 0x0EE00A10 | (cast(uint32, reg) << 16) | (cast(uint32, rt) << 12))
}

// VmovHalfToCore emits VMOV.F16 Rt, Sn: Rt R0 .. R14.
func VmovHalfToCore(a @asm.Assembler, rt int, sn int) {
	if !arm32.RegOk(a, rt, true) || !vfpRegOk(a, false, sn) { return }
	arm32.Emit32(a, 0xEE100910 | (cast(uint32, rt) << 12) | placeVn(false, sn))
}

// VmovCoreToHalf emits VMOV.F16 Sn, Rt: Rt R0 .. R14.
func VmovCoreToHalf(a @asm.Assembler, sn int, rt int) {
	if !vfpRegOk(a, false, sn) || !arm32.RegOk(a, rt, true) { return }
	arm32.Emit32(a, 0xEE000910 | (cast(uint32, rt) << 12) | placeVn(false, sn))
}

// Vins emits VINS.F16 Sd, Sm (Sm's low half into Sd's high half).
func Vins(a @asm.Assembler, sd int, sm int) {
	if !vfpRegOk(a, false, sd) || !vfpRegOk(a, false, sm) { return }
	arm32.Emit32(a, 0xFEB00AC0 | placeVd(false, sd) | placeVm(false, sm))
}

// Vmovx emits VMOVX.F16 Sd, Sm (Sm's high half into Sd's low half).
func Vmovx(a @asm.Assembler, sd int, sm int) {
	if !vfpRegOk(a, false, sd) || !vfpRegOk(a, false, sm) { return }
	arm32.Emit32(a, 0xFEB00A40 | placeVd(false, sd) | placeVm(false, sm))
}
