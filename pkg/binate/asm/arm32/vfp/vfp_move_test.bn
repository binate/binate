package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// Each move as clang assembles it: VMOV.F32 S0, S1; VMOV.F64 D0, D1; VMOV.F64 D16, D1; VMOVEQ.F32;
// VMOV.F32 S0, #1.0; #-2.5; VMOV.F64 D0, #31.0; D16, #0.125; VMOV.F16 S0, #1.0; VMOV S0, S1, R0,
// R1; S30, S31; PC, R1; VMOV R0, R1, S0, S1; VMOV.32 D0[1], R0; D16[0]; D0[1], PC; VMOV.32 R0,
// D0[1].
func TestVmovForms() testing.TestResult {
	var a @asm.Assembler = newAsm()
	VmovReg(a, arm32.COND_AL, 32, S0, S1)
	VmovReg(a, arm32.COND_AL, 64, D0, D1)
	VmovReg(a, arm32.COND_AL, 64, D16, D1)
	VmovReg(a, arm32.COND_EQ, 32, S0, S1)
	VmovImm(a, arm32.COND_AL, 32, S0, 0x70)
	VmovImm(a, arm32.COND_AL, 32, S0, 0x84)
	VmovImm(a, arm32.COND_AL, 64, D0, 0x3F)
	VmovImm(a, arm32.COND_AL, 64, D16, 0x40)
	VmovImm(a, arm32.COND_AL, 16, S0, 0x70)
	VmovCoresToSingles(a, arm32.COND_AL, S0, arm32.R0, arm32.R1)
	VmovCoresToSingles(a, arm32.COND_AL, S30, arm32.R0, arm32.R1)
	VmovCoresToSingles(a, arm32.COND_AL, S0, arm32.PC, arm32.R1)
	VmovSinglesToCores(a, arm32.COND_AL, arm32.R0, arm32.R1, S0)
	VmovCoreToLane(a, arm32.COND_AL, D0, 1, arm32.R0)
	VmovCoreToLane(a, arm32.COND_AL, D16, 0, arm32.R0)
	VmovCoreToLane(a, arm32.COND_AL, D0, 1, arm32.PC)
	VmovLaneToCore(a, arm32.COND_AL, arm32.R0, D0, 1)
	if !wordsAre(a,
			@[]uint32{0xEEB00A60, 0xEEB00B41, 0xEEF00B41, 0x0EB00A60, 0xEEB70A00, 0xEEB80A04, 0xEEB30B0F,
					0xEEF40B00, 0xEEB70900, 0xEC410A10, 0xEC410A1F, 0xEC41FA10, 0xEC510A10, 0xEE200B10, 0xEE000B90,
					0xEE20FB10, 0xEE300B10}) {
		return fail("a VFP move is not clang's word")
	}
	return ""
}

// VMRS from each system register, APSR_nzcv from FPSCR, SP; VMSR to each it writes, from SP,
// conditional; the half-precision moves, VINS and VMOVX -- as clang assembles them.
func TestVmovSystemAndHalf() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vmrs(a, arm32.COND_AL, arm32.R0, FPSCR)
	Vmrs(a, arm32.COND_AL, arm32.PC, FPSCR)
	Vmrs(a, arm32.COND_AL, arm32.R0, FPSID)
	Vmrs(a, arm32.COND_AL, arm32.R0, MVFR0)
	Vmrs(a, arm32.COND_AL, arm32.R0, MVFR1)
	Vmrs(a, arm32.COND_AL, arm32.R0, MVFR2)
	Vmrs(a, arm32.COND_AL, arm32.R0, FPEXC)
	Vmrs(a, arm32.COND_AL, arm32.R0, FPINST)
	Vmrs(a, arm32.COND_AL, arm32.R0, FPINST2)
	Vmrs(a, arm32.COND_AL, arm32.SP, FPSCR)
	Vmsr(a, arm32.COND_AL, FPSCR, arm32.R0)
	Vmsr(a, arm32.COND_AL, FPEXC, arm32.R0)
	Vmsr(a, arm32.COND_AL, FPSID, arm32.R0)
	Vmsr(a, arm32.COND_AL, FPINST, arm32.R0)
	Vmsr(a, arm32.COND_AL, FPSCR, arm32.SP)
	Vmsr(a, arm32.COND_EQ, FPSCR, arm32.R0)
	VmovHalfToCore(a, arm32.R0, S1)
	VmovCoreToHalf(a, S1, arm32.R0)
	VmovHalfToCore(a, arm32.SP, S1)
	Vins(a, S0, S1)
	Vmovx(a, S0, S1)
	if !wordsAre(a,
			@[]uint32{0xEEF10A10, 0xEEF1FA10, 0xEEF00A10, 0xEEF70A10, 0xEEF60A10, 0xEEF50A10, 0xEEF80A10,
					0xEEF90A10, 0xEEFA0A10, 0xEEF1DA10, 0xEEE10A10, 0xEEE80A10, 0xEEE00A10, 0xEEE90A10, 0xEEE1DA10,
					0x0EE10A10, 0xEE100990, 0xEE000990, 0xEE10D990, 0xFEB00AE0, 0xFEB00A60}) {
		return fail("a system register or half-precision move is not clang's word")
	}
	return ""
}

// A move there is no encoding of is an error that emits nothing: a half-precision register copy,
// an immediate's encoding past 0..255, .F16 with a condition, a pair from S31, a lane past 1, a
// system register there is none of, APSR_nzcv from other than FPSCR, VMSR to an MVFR or from PC,
// a half-precision move with PC, VINS with a D register.
func TestVmovRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 13)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	VmovReg(bad[0], arm32.COND_AL, 16, S0, S1)
	VmovImm(bad[1], arm32.COND_AL, 32, S0, 256)
	VmovImm(bad[2], arm32.COND_AL, 32, S0, -1)
	VmovImm(bad[3], arm32.COND_EQ, 16, S0, 0x70)
	VmovCoresToSingles(bad[4], arm32.COND_AL, S31, arm32.R0, arm32.R1)
	VmovCoreToLane(bad[5], arm32.COND_AL, D0, 2, arm32.R0)
	Vmrs(bad[6], arm32.COND_AL, arm32.R0, 2)
	Vmrs(bad[7], arm32.COND_AL, arm32.PC, FPEXC)
	Vmsr(bad[8], arm32.COND_AL, MVFR0, arm32.R0)
	Vmsr(bad[9], arm32.COND_AL, FPSCR, arm32.PC)
	VmovHalfToCore(bad[10], arm32.PC, S1)
	Vins(bad[11], D0, S1)
	VmovLaneToCore(bad[12], arm32.COND_AL, arm32.R0, S0, 0)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VFP move was taken") }
	}
	return ""
}
