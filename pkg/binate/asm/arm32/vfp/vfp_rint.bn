package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// ARMv8's rounding to an integral value, selection and IEEE 754-2008 maximum and minimum: VRINTR,
// VRINTZ and VRINTX are conditional data-processing words (opc2 0110 / 0111); VRINTA .. VRINTM,
// VSEL and VMAXNM / VMINNM have 1111 in place of the condition.

// Vrint emits VRINTA .. VRINTM, VRINTR, VRINTZ or VRINTX (mode RM_A .. RINT_X) .F16 / .F32 /
// .F64{cond} Vd, Vm: rounding to an integral value; VRINTA .. VRINTM and F16 unconditional.
func Vrint(a @asm.Assembler, cond int, mode int, size int, vd int, vm int) {
	if mode < RM_A || mode > RINT_X {
		a.SetError("arm32: unknown VRINT rounding")
		return
	}
	if mode <= RM_M && cond != arm32.COND_AL {
		a.SetError("arm32: VRINTA, VRINTN, VRINTP and VRINTM are unconditional")
		return
	}
	head, ok := typeHead(a, cond, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) || !vfpRegOk(a, dbl, vm) { return }
	var word uint32 = 0x1EB80040 | (cast(uint32, mode) << 16)
	if mode == RINT_R { word = 0x0EB60040 }
	if mode == RINT_Z { word = 0x0EB600C0 }
	if mode == RINT_X { word = 0x0EB70040 }
	arm32.Emit32(a, head | word | placeVd(dbl, vd) | placeVm(dbl, vm))
}

// Vsel emits VSELEQ / VSELVS / VSELGE / VSELGT (cc arm32.COND_EQ, COND_VS, COND_GE, COND_GT)
// .F16 / .F32 / .F64 Vd, Vn, Vm: Vn when cc holds, else Vm.
func Vsel(a @asm.Assembler, cc int, size int, vd int, vn int, vm int) {
	var bits uint32 = 0
	if cc == arm32.COND_VS {
		bits = 1
	} else if cc == arm32.COND_GE {
		bits = 2
	} else if cc == arm32.COND_GT {
		bits = 3
	} else if cc != arm32.COND_EQ {
		a.SetError("arm32: VSEL's condition is EQ, VS, GE or GT")
		return
	}
	head, ok := typeHead(a, arm32.COND_AL, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) || !vfpRegOk(a, dbl, vn) || !vfpRegOk(a, dbl, vm) { return }
	arm32.Emit32(a,
			head | 0x1E000000 | (bits << 20) | placeVd(dbl, vd) | placeVn(dbl, vn) | placeVm(dbl, vm))
}

// Vmaxnm emits VMAXNM (VMINNM when min) .F16 / .F32 / .F64 Vd, Vn, Vm: IEEE 754-2008's maxNum
// (minNum).
func Vmaxnm(a @asm.Assembler, min bool, size int, vd int, vn int, vm int) {
	head, ok := typeHead(a, arm32.COND_AL, size)
	var dbl bool = size == 64
	if !ok || !vfpRegOk(a, dbl, vd) || !vfpRegOk(a, dbl, vn) || !vfpRegOk(a, dbl, vm) { return }
	arm32.Emit32(a,
			head | 0x1E800000 | bitIf(min, 0x40) | placeVd(dbl, vd) | placeVn(dbl, vn) | placeVm(dbl, vm))
}
