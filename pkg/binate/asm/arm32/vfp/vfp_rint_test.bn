package "pkg/binate/asm/arm32/vfp"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// Each rounding to an integral value, selection, maximum and minimum, as clang assembles it:
// VRINTA.F32 S0, S1; VRINTN.F64 D17, D18; VRINTP.F16 S30, S31; VRINTM.F32 S4, S5; VRINTR.F64
// D1, D2; VRINTZEQ.F32; VRINTX.F16 S1, S2; VRINTXMI.F64 D31, D0; VSELEQ.F32 S0, S1, S2;
// VSELVS.F64 D17, D18, D19; VSELGE.F16 S31, S30, S29; VSELGT.F32 S1, S3, S5; VMAXNM.F32;
// VMINNM.F64 D31, D30, D29; VMAXNM.F16 S5, S6, S7; VMINNM.F32 S1, S2, S3.
func TestVrintSelMaxnm() testing.TestResult {
	var a @asm.Assembler = newAsm()
	Vrint(a, arm32.COND_AL, RM_A, 32, S0, S1)
	Vrint(a, arm32.COND_AL, RM_N, 64, D17, D18)
	Vrint(a, arm32.COND_AL, RM_P, 16, S30, S31)
	Vrint(a, arm32.COND_AL, RM_M, 32, S4, S5)
	Vrint(a, arm32.COND_AL, RINT_R, 64, D1, D2)
	Vrint(a, arm32.COND_EQ, RINT_Z, 32, S0, S1)
	Vrint(a, arm32.COND_AL, RINT_X, 16, S1, S2)
	Vrint(a, arm32.COND_MI, RINT_X, 64, D31, D0)
	Vsel(a, arm32.COND_EQ, 32, S0, S1, S2)
	Vsel(a, arm32.COND_VS, 64, D17, D18, D19)
	Vsel(a, arm32.COND_GE, 16, S31, S30, S29)
	Vsel(a, arm32.COND_GT, 32, S1, S3, S5)
	Vmaxnm(a, false, 32, S0, S1, S2)
	Vmaxnm(a, true, 64, D31, D30, D29)
	Vmaxnm(a, false, 16, S5, S6, S7)
	Vmaxnm(a, true, 32, S1, S2, S3)
	if !wordsAre(a,
			@[]uint32{0xFEB80A60, 0xFEF91B62, 0xFEBAF96F, 0xFEBB2A62, 0xEEB61B42, 0x0EB60AE0, 0xEEF70941,
					0x4EF7FB40, 0xFE000A81, 0xFE521BA3, 0xFE6FF92E, 0xFE710AA2, 0xFE800A81, 0xFECEFBED, 0xFEC32923,
					0xFEC10A61}) {
		return fail("a VRINT, VSEL or VMAXNM / VMINNM is not clang's word")
	}
	return ""
}

// One there is no encoding of is an error that emits nothing: VRINTA with a condition, an F16
// VRINTZ with one, a rounding past RINT_X, VSEL on NE, VMAXNM of 8-bit data, VSEL with an S
// register for F64.
func TestVrintSelMaxnmRejects() testing.TestResult {
	var bad @[]@asm.Assembler = make_slice(@asm.Assembler, 6)
	for i := 0; i < len(bad); i++ { bad[i] = newAsm() }
	Vrint(bad[0], arm32.COND_EQ, RM_A, 32, S0, S1)
	Vrint(bad[1], arm32.COND_EQ, RINT_Z, 16, S0, S1)
	Vrint(bad[2], arm32.COND_AL, RINT_X + 1, 32, S0, S1)
	Vsel(bad[3], arm32.COND_NE, 32, S0, S1, S2)
	Vmaxnm(bad[4], false, 8, S0, S1, S2)
	Vsel(bad[5], arm32.COND_EQ, 64, D0, S1, D2)
	for i := 0; i < len(bad); i++ {
		if !rejected(bad[i]) { return fail("a bad VRINT, VSEL or VMAXNM was taken") }
	}
	return ""
}
