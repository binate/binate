package "pkg/binate/asm"

import "pkg/binate/buf"

// ARM build attributes (asm.bni ArmAttr): those a file sets explicitly, the values each tag
// takes, and the attributes clang's `.fpu` names imply.

// SetArmAttr sets ARM build attribute tag explicitly; see asm.bni.
func (a @Assembler) SetArmAttr(tag int64, num int64, str *[]readonly char) {
	var at int = a.NumArmAttrs
	for i := 0; i < a.NumArmAttrs; i++ {
		if a.ArmAttrs[i].Tag == tag { at = i }
	}
	if at == a.NumArmAttrs {
		if a.NumArmAttrs == len(a.ArmAttrs) {
			var n int = 2 * len(a.ArmAttrs)
			if n == 0 { n = 8 }
			var grown @[]ArmAttr = make_slice(ArmAttr, n)
			for i := 0; i < a.NumArmAttrs; i++ { grown[i] = a.ArmAttrs[i] }
			a.ArmAttrs = grown
		}
		a.NumArmAttrs = a.NumArmAttrs + 1
	}
	var attr ArmAttr
	attr.Tag = tag
	attr.Num = num
	attr.Str = buf.CopyStr(str)
	a.ArmAttrs[at] = attr
}

// ArmAttrKind reports whether ARM build attribute tag takes a number and whether a string; see
// asm.bni.
func ArmAttrKind(tag int64) (bool, bool) {
	if tag == ARM_TAG_COMPATIBILITY { return true, true }
	var str bool = tag == ARM_TAG_CPU_RAW_NAME || tag == ARM_TAG_CPU_NAME ||
			(tag > ARM_TAG_COMPATIBILITY && tag % 2 == 1)
	return !str, str
}

// ArmFPUAttrs returns the attributes FPU name implies; see asm.bni.  names[i] implies values[3i]
// (Tag_FP_arch), values[3i + 1] (Tag_Advanced_SIMD_arch) and values[3i + 2] (Tag_FP_HP_extension),
// as clang writes them for armv7ve.
func ArmFPUAttrs(name *[]readonly char) (int64, int64, int64, bool) {
	var names @[]*[]readonly char = @[]*[]readonly char{"none", "softvfp", "vfp", "vfpv2", "vfpv3",
			"vfp3", "vfpv3-fp16", "vfpv3-d16", "vfpv3-d16-fp16", "vfpv3xd", "vfpv3xd-fp16", "vfpv4", "vfp4",
			"vfpv4-d16", "fpv4-sp-d16", "fpv5-d16", "fpv5-sp-d16", "fp-armv8", "fp-armv8-fullfp16-d16",
			"fp-armv8-fullfp16-sp-d16", "neon", "neon-vfpv3", "neon-fp16", "neon-vfpv4", "neon-fp-armv8",
			"crypto-neon-fp-armv8", "vfp2", "vfp3-d16", "vfp4-d16", "fp4-sp-d16", "vfpv4-sp-d16",
			"fp4-dp-d16", "fpv4-dp-d16", "fp5-sp-d16", "fp5-dp-d16", "fpv5-dp-d16"}
	var values @[]int64 = @[]int64{0, 0, 0, 0, 0, 0, 2, 0, 0, 2, 0, 0, 3, 0, 0, 3, 0, 0, 3, 0, 1, 4, 0,
			0, 4, 0, 1, 4, 0, 0, 4, 0, 1, 5, 0, 0, 5, 0, 0, 6, 0, 0, 6, 0, 0, 8, 0, 0, 8, 0, 0, 7, 0, 0, 8,
			0, 0, 8, 0, 0, 3, 1, 0, 3, 1, 0, 3, 1, 1, 5, 2, 0, 7, 0, 0, 7, 0, 0, 2, 0, 0, 4, 0, 0, 6, 0, 0,
			6, 0, 0, 6, 0, 0, 6, 0, 0, 6, 0, 0, 8, 0, 0, 8, 0, 0, 8, 0, 0}
	for i := 0; i < len(names); i++ {
		if charsEqual(names[i], name) { return values[3 * i], values[3 * i + 1], values[3 * i + 2], true }
	}
	return 0, 0, 0, false
}
