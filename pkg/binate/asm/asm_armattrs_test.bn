package "pkg/binate/asm"

import "pkg/builtins/testing"

// An ARM build attribute set again replaces its value in place; a new tag is appended, past
// the table's first growth too.
func TestSetArmAttr() testing.TestResult {
	var a @Assembler = New(4)
	a.SetArmAttr(ARM_TAG_CPU_NAME, 0, "cortex-a9")
	a.SetArmAttr(ARM_TAG_ABI_VFP_ARGS, 1, "")
	a.SetArmAttr(ARM_TAG_CPU_NAME, 0, "cortex-a15")
	if a.NumArmAttrs != 2 { return fail("Tag_CPU_name set twice is not one attribute") }
	var first ArmAttr = a.ArmAttrs[0]
	if first.Tag != ARM_TAG_CPU_NAME || !charsEqual(first.Str, "cortex-a15") {
		return fail("Tag_CPU_name is not first, cortex-a15")
	}
	if a.ArmAttrs[1].Tag != ARM_TAG_ABI_VFP_ARGS || a.ArmAttrs[1].Num != 1 {
		return fail("Tag_ABI_VFP_args is not second, 1")
	}
	for tag := 40; tag < 60; tag++ { a.SetArmAttr(cast(int64, tag), cast(int64, tag) + 1, "") }
	if a.NumArmAttrs != 22 || a.ArmAttrs[21].Tag != 59 || a.ArmAttrs[21].Num != 60 {
		return fail("the 22nd attribute is not tag 59, 60")
	}
	a.SetArmAttr(ARM_TAG_COMPATIBILITY, 1, "gnu")
	var compat ArmAttr = a.ArmAttrs[22]
	if compat.Num != 1 || !charsEqual(compat.Str, "gnu") {
		return fail("Tag_compatibility does not keep both its number and its string")
	}
	return ""
}

// armAttrKindIs reports whether ArmAttrKind(tag) is num, str.
func armAttrKindIs(tag int64, num bool, str bool) bool {
	var n bool
	var s bool
	n, s = ArmAttrKind(tag)
	return n == num && s == str
}

// Tag_CPU_raw_name, Tag_CPU_name and the odd tags above Tag_compatibility take a string,
// Tag_compatibility a number and a string, and the others a number — tags below 32 and even
// ones alike.
func TestArmAttrKind() testing.TestResult {
	if !armAttrKindIs(4, false, true) || !armAttrKindIs(5, false, true) {
		return fail("Tag_CPU_raw_name and Tag_CPU_name do not take a string")
	}
	if !armAttrKindIs(32, true, true) { return fail("Tag_compatibility does not take both") }
	if !armAttrKindIs(33, false, true) || !armAttrKindIs(65, false, true) ||
			!armAttrKindIs(67, false, true) || !armAttrKindIs(129, false, true) {
		return fail("an odd tag above 32 does not take a string")
	}
	if !armAttrKindIs(6, true, false) || !armAttrKindIs(31, true, false) ||
			!armAttrKindIs(34, true, false) || !armAttrKindIs(128, true, false) {
		return fail("a tag below 32, or an even one, does not take a number")
	}
	return ""
}

// armFPUIs reports whether ArmFPUAttrs(name) is fp, simd, hp and known.
func armFPUIs(name *[]readonly char, fp int64, simd int64, hp int64) bool {
	var f int64
	var s int64
	var h int64
	var ok bool
	f, s, h, ok = ArmFPUAttrs(name)
	return ok && f == fp && s == simd && h == hp
}

// Every FPU name clang's `.fpu` takes, its aliases too, implies the Tag_FP_arch,
// Tag_Advanced_SIMD_arch and Tag_FP_HP_extension clang writes for it (Apple clang 21,
// -march=armv7ve); another name, or one in another case, is none.
func TestArmFPUAttrs() testing.TestResult {
	if !armFPUIs("none", 0, 0, 0) || !armFPUIs("softvfp", 0, 0, 0) { return fail("none, softvfp") }
	if !armFPUIs("vfp", 2, 0, 0) || !armFPUIs("vfpv2", 2, 0, 0) { return fail("vfp, vfpv2") }
	if !armFPUIs("vfpv3", 3, 0, 0) || !armFPUIs("vfp3", 3, 0, 0) { return fail("vfpv3, vfp3") }
	if !armFPUIs("vfpv3-fp16", 3, 0, 1) { return fail("vfpv3-fp16") }
	if !armFPUIs("vfpv3-d16", 4, 0, 0) || !armFPUIs("vfpv3xd", 4, 0, 0) {
		return fail("vfpv3-d16, vfpv3xd")
	}
	if !armFPUIs("vfpv3-d16-fp16", 4, 0, 1) || !armFPUIs("vfpv3xd-fp16", 4, 0, 1) {
		return fail("vfpv3-d16-fp16, vfpv3xd-fp16")
	}
	if !armFPUIs("vfpv4", 5, 0, 0) || !armFPUIs("vfp4", 5, 0, 0) { return fail("vfpv4, vfp4") }
	if !armFPUIs("vfpv4-d16", 6, 0, 0) || !armFPUIs("fpv4-sp-d16", 6, 0, 0) {
		return fail("vfpv4-d16, fpv4-sp-d16")
	}
	if !armFPUIs("fpv5-d16", 8, 0, 0) || !armFPUIs("fpv5-sp-d16", 8, 0, 0) {
		return fail("fpv5-d16, fpv5-sp-d16")
	}
	if !armFPUIs("fp-armv8", 7, 0, 0) { return fail("fp-armv8") }
	if !armFPUIs("fp-armv8-fullfp16-d16", 8, 0, 0) || !armFPUIs("fp-armv8-fullfp16-sp-d16", 8, 0, 0) {
		return fail("fp-armv8-fullfp16-d16, fp-armv8-fullfp16-sp-d16")
	}
	if !armFPUIs("neon", 3, 1, 0) || !armFPUIs("neon-vfpv3", 3, 1, 0) { return fail("neon") }
	if !armFPUIs("neon-fp16", 3, 1, 1) { return fail("neon-fp16") }
	if !armFPUIs("neon-vfpv4", 5, 2, 0) { return fail("neon-vfpv4") }
	if !armFPUIs("neon-fp-armv8", 7, 0, 0) || !armFPUIs("crypto-neon-fp-armv8", 7, 0, 0) {
		return fail("neon-fp-armv8, crypto-neon-fp-armv8")
	}
	if !armFPUIs("vfp2", 2, 0, 0) || !armFPUIs("vfp3-d16", 4, 0, 0) { return fail("vfp2, vfp3-d16") }
	if !armFPUIs("vfp4-d16", 6, 0, 0) || !armFPUIs("fp4-sp-d16", 6, 0, 0) ||
			!armFPUIs("vfpv4-sp-d16", 6, 0, 0) || !armFPUIs("fp4-dp-d16", 6, 0, 0) ||
			!armFPUIs("fpv4-dp-d16", 6, 0, 0) {
		return fail("the VFPv4 D16 aliases")
	}
	if !armFPUIs("fp5-sp-d16", 8, 0, 0) || !armFPUIs("fp5-dp-d16", 8, 0, 0) ||
			!armFPUIs("fpv5-dp-d16", 8, 0, 0) {
		return fail("the FPv5 aliases")
	}
	var ok bool
	_, _, _, ok = ArmFPUAttrs("NEON")
	if ok { return fail("NEON is an FPU name") }
	_, _, _, ok = ArmFPUAttrs("vfpv5")
	if ok { return fail("vfpv5 is an FPU name") }
	_, _, _, ok = ArmFPUAttrs("vfpv3-sp-d16")
	if ok { return fail("vfpv3-sp-d16 is an FPU name") }
	_, _, _, ok = ArmFPUAttrs("")
	if ok { return fail("an empty name is an FPU name") }
	return ""
}
