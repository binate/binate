package "pkg/binate/asm"

// Mach-O atoms and which same-section references are fixed at assembly time — shared
// by every architecture's fixup resolver and the Mach-O writer, so that none of them
// fixes a displacement across an atom boundary the linker may move.

// AtomStarts returns the sorted, de-duplicated offsets of the symbols defined in
// section si that start a Mach-O atom (StartsAtom).
func (a @Assembler) AtomStarts(si int) @[]int {
	var n int = 0
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Section == si && StartsAtom(a.Symbols[i]) { n = n + 1 }
	}
	var offs @[]int = make_slice(int, n)
	var k int = 0
	for i := 0; i < a.NumSymbols; i++ {
		var sym Symbol = a.Symbols[i]
		if sym.Section == si && StartsAtom(sym) {
			offs[k] = cast(int, sym.Offset)
			k = k + 1
		}
	}
	mergeSortInts(offs)
	var m int = 0
	for i := 0; i < n; i++ {
		if m == 0 || offs[m - 1] != offs[i] {
			offs[m] = offs[i]
			m = m + 1
		}
	}
	return offs[0:m]
}

// mergeSortInts sorts v ascending (bottom-up merge sort: O(n log n) whatever the
// input order — symbols are recorded in first-mention order, not by offset).
func mergeSortInts(v @[]int) {
	var n int = len(v)
	var tmp @[]int = make_slice(int, n)
	for width := 1; width < n; width = width * 2 {
		for lo := 0; lo < n; lo = lo + 2 * width {
			var mid int = lo + width
			if mid > n { mid = n }
			var hi int = lo + 2 * width
			if hi > n { hi = n }
			var i int = lo
			var j int = mid
			for k := lo; k < hi; k++ {
				if i < mid && (j >= hi || v[i] <= v[j]) {
					tmp[k] = v[i]
					i = i + 1
				} else {
					tmp[k] = v[j]
					j = j + 1
				}
			}
		}
		for k := 0; k < n; k++ { v[k] = tmp[k] }
	}
}

// AtomStartAt returns the offset of the atom containing byte off — the largest
// atom-start offset <= off in the sorted starts — or -1 when off precedes them all.
func AtomStartAt(starts @[]int, off int) int {
	var lo int = 0
	var hi int = len(starts)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if starts[mid] <= off { lo = mid + 1 } else { hi = mid }
	}
	if lo == 0 { return -1 }
	return starts[lo - 1]
}

// DisplacementFixed reports whether a PC-relative reference at byte fixupOff of a
// section to sym, defined in that same section, has a displacement fixed at assembly
// time — the line clang draws:
//   - ELF: a global or weak symbol may be preempted at link or load time, so a
//     reference to a local symbol is fixed and any other is not (an `L` prefix means
//     nothing on ELF);
//   - Mach-O: the linker may move each atom (MH_SUBSECTIONS_VIA_SYMBOLS), which
//     starts at every emitted symbol, so a reference is fixed only within one atom:
//     the atom holding fixupOff also holds sym (sym is an `L` label inside it, or the
//     symbol that starts it);
//   - an unknown object format: only what both fix — a local symbol in the same
//     atom.
// starts is the section's AtomStarts (unused for ELF).
func (a @Assembler) DisplacementFixed(sym Symbol, fixupOff int, starts @[]int) bool {
	if a.ObjFormat == OBJ_ELF { return sym.Binding == BIND_LOCAL }
	var sameAtom bool = AtomStartAt(starts, fixupOff) == AtomStartAt(starts, cast(int, sym.Offset))
	if a.ObjFormat == OBJ_MACHO { return sameAtom }
	return sameAtom && sym.Binding == BIND_LOCAL
}
