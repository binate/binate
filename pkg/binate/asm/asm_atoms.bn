package "pkg/binate/asm"

// Mach-O atoms and which same-section references are fixed at assembly time — shared
// by every architecture's fixup resolver and the Mach-O writer, so that none of them
// fixes a displacement across an atom boundary the linker may move.

// AtomStarts returns the indices of section si's atom-starting symbols, sorted by offset
// and then definition; see asm.bni.
func (a @Assembler) AtomStarts(si int) @[]int {
	var n int = 0
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Section == si && StartsAtom(a.Symbols[i]) { n = n + 1 }
	}
	var idx @[]int = make_slice(int, n)
	var k int = 0
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Section == si && StartsAtom(a.Symbols[i]) {
			idx[k] = i
			k = k + 1
		}
	}
	a.sortByPlace(idx)
	return idx
}

// placeBefore reports whether symbol i comes before symbol j in AtomStarts' order: a lower
// offset, or the same offset and an earlier definition.
func (a @Assembler) placeBefore(i int, j int) bool {
	var si Symbol = a.Symbols[i]
	var sj Symbol = a.Symbols[j]
	if si.Offset != sj.Offset { return si.Offset < sj.Offset }
	return si.DefOrder < sj.DefOrder
}

// sortByPlace sorts the symbol indices v by placeBefore (bottom-up merge sort: O(n log n)
// whatever the input order — symbols are recorded in first-mention order, not by offset).
func (a @Assembler) sortByPlace(v @[]int) {
	var n int = len(v)
	var tmp @[]int = make_slice(int, n)
	for width := 1; width < n; width = width * 2 {
		for lo := 0; lo < n; lo = lo + 2 * width {
			var mid int = lo + width
			if mid > n { mid = n }
			var hi int = lo + 2 * width
			if hi > n { hi = n }
			var i int = lo
			var j int = mid
			for k := lo; k < hi; k++ {
				if i < mid && (j >= hi || !a.placeBefore(v[j], v[i])) {
					tmp[k] = v[i]
					i = i + 1
				} else {
					tmp[k] = v[j]
					j = j + 1
				}
			}
		}
		for k := 0; k < n; k++ { v[k] = tmp[k] }
	}
}

// AtomStartAt returns the offset of the atom holding byte off; see asm.bni.
func (a @Assembler) AtomStartAt(starts @[]int, off int) int {
	var lo int = 0
	var hi int = len(starts)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if cast(int, a.Symbols[starts[mid]].Offset) <= off { lo = mid + 1 } else { hi = mid }
	}
	if lo == 0 { return -1 }
	return cast(int, a.Symbols[starts[lo - 1]].Offset)
}

// AtomOf returns the symbol starting sym's atom; see asm.bni.
func (a @Assembler) AtomOf(starts @[]int, sym Symbol) int {
	var s Symbol = sym
	for steps := 0; len(s.AliasOf) > 0 && steps < a.NumSymbols; steps++ {
		var t int = a.findSymbol(s.AliasOf)
		if t < 0 { break }
		s = a.Symbols[t]
	}
	if StartsAtom(s) {
		var self int = a.findSymbol(s.Name)
		if self >= 0 { return self }
	}
	return a.atomAt(starts, cast(int, s.Offset), s.DefOrder)
}

// atomAt returns the atom start among starts placed last before offset off and definition
// order: the greatest (offset, DefOrder) below (off, order) — of a label and an alias of it
// at that place, the label — or -1 when none is.
func (a @Assembler) atomAt(starts @[]int, off int, order int) int {
	var lo int = 0
	var hi int = len(starts)
	for lo < hi {
		var mid int = (lo + hi) / 2
		var m Symbol = a.Symbols[starts[mid]]
		if cast(int, m.Offset) < off || (cast(int, m.Offset) == off && m.DefOrder < order) {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 0 { return -1 }
	var best int = starts[lo - 1]
	var b Symbol = a.Symbols[best]
	for k := lo - 1; k >= 0; k-- {
		var c Symbol = a.Symbols[starts[k]]
		if c.Offset != b.Offset || c.DefOrder != b.DefOrder { break }
		if len(c.AliasOf) == 0 { return starts[k] }
	}
	return best
}

// isTemporaryRef reports whether sym is a temporary (an unlisted Mach-O label, a generated
// one included) or an alias of one with no addend, followed as clang follows an alias to the
// symbol it names.
func (a @Assembler) isTemporaryRef(sym Symbol) bool {
	var s Symbol = sym
	for steps := 0; len(s.AliasOf) > 0 && steps < a.NumSymbols; steps++ {
		var t int = a.findSymbol(s.AliasOf)
		if t < 0 || a.Symbols[t].Offset != s.Offset { break }
		s = a.Symbols[t]
	}
	return s.Binding == BIND_LOCAL && IsTemporaryLabel(s.Name, OBJ_MACHO)
}

// DisplacementFixed reports whether a PC-relative reference at byte fixupOff of a
// section to sym, defined in that same section, has a displacement fixed at assembly
// time — the line clang draws:
//   - ELF: a global or weak symbol may be preempted at link or load time, so a
//     reference to a local symbol is fixed and any other is not (an `L` prefix means
//     nothing on ELF);
//   - Mach-O: the linker may move each atom (MH_SUBSECTIONS_VIA_SYMBOLS), which
//     starts at every emitted symbol, so a reference is fixed only within one atom:
//     the atom the code at fixupOff is in is the one sym belongs to (AtomOf: sym starts
//     it, or is a temporary defined in it, or an alias of a symbol in it) — except that
//     when tempsFixed (clang on AArch64) a reference to a temporary is fixed whatever its
//     atom, clang taking a temporary to be referred to only from its own atom;
//   - an unknown object format: only what both fix — a local symbol in the same
//     atom, or a temporary when tempsFixed.
// starts is the section's AtomStarts (unused for ELF).
func (a @Assembler) DisplacementFixed(sym Symbol, fixupOff int, starts @[]int,
		tempsFixed bool) bool {
	if a.ObjFormat == OBJ_ELF { return sym.Binding == BIND_LOCAL }
	if tempsFixed && a.isTemporaryRef(sym) { return true }
	// The code at fixupOff follows every label at its offset: it is in the last atom
	// started at or before it.
	var sameAtom bool = a.atomAt(starts, fixupOff, a.NumDefs + 1) == a.AtomOf(starts, sym)
	if a.ObjFormat == OBJ_MACHO { return sameAtom }
	return sameAtom && sym.Binding == BIND_LOCAL
}
