package "pkg/binate/asm"

import "pkg/builtins/testing"

// atomAsm returns an assembler in a text section holding `_a: nop; Lx: nop; _b: nop;
// _c: nop`, with _c recorded first (a forward global declaration) and defined last,
// and a global `Lg` defined at the end: symbols are recorded in first-mention order.
func atomAsm() @Assembler {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.SetGlobal("_c")
	a.DefineLabel("_a")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Lx")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("_b")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("_c")
	a.EmitUint32(0xD503201F)
	a.SetGlobal("Lg")
	a.DefineLabel("Lg")
	a.EmitUint32(0xD503201F)
	return a
}

// AtomStarts lists every atom-starting symbol's offset, sorted, whatever order the
// symbols were recorded in: not the local temporary Lx, but the global `L`-named Lg
// (which a Mach-O object lists, so it starts an atom); AtomStartAt finds the atom
// holding an offset.
func TestAtomStartsAndLookup() testing.TestResult {
	var a @Assembler = atomAsm()
	var starts @[]int = a.AtomStarts(0)
	if len(starts) != 4 || starts[0] != 0 || starts[1] != 8 || starts[2] != 12 || starts[3] != 16 {
		return fail("atom starts must be 0, 8, 12, 16")
	}
	if AtomStartAt(starts, 4) != 0 || AtomStartAt(starts, 8) != 8 || AtomStartAt(starts, 17) != 16 {
		return fail("AtomStartAt")
	}
	if AtomStartAt(starts, -1) != -1 { return fail("before every atom") }
	var v @[]int = make_slice(int, 5)
	v[0] = 5
	v[1] = 1
	v[2] = 4
	v[3] = 1
	v[4] = 0
	mergeSortInts(v)
	if v[0] != 0 || v[1] != 1 || v[2] != 1 || v[3] != 4 || v[4] != 5 { return fail("mergeSortInts") }
	return ""
}

// DisplacementFixed per object format: Mach-O fixes a reference within one atom
// (to the atom's own symbol or a temporary inside it) and not one across atoms, nor
// one across a global `L`-named symbol; ELF fixes a reference to a local symbol only;
// with no format, only what both fix — a local symbol in the same atom.
func TestDisplacementFixedPerFormat() testing.TestResult {
	var a @Assembler = atomAsm()
	var starts @[]int = a.AtomStarts(0)
	var sa Symbol = a.Symbols[a.LookupSymbol("_a")]
	var sx Symbol = a.Symbols[a.LookupSymbol("Lx")]
	var sc Symbol = a.Symbols[a.LookupSymbol("_c")]
	a.ObjFormat = OBJ_MACHO
	if !a.DisplacementFixed(sa, 4, starts) { return fail("Mach-O: within _a's atom, to _a") }
	if !a.DisplacementFixed(sx, 0, starts) { return fail("Mach-O: within _a's atom, to Lx") }
	if a.DisplacementFixed(sa, 8, starts) { return fail("Mach-O: from _b's atom to _a") }
	if a.DisplacementFixed(sc, 16, starts) { return fail("Mach-O: from Lg's atom to _c") }
	a.ObjFormat = OBJ_ELF
	if !a.DisplacementFixed(sa, 8, starts) { return fail("ELF: to the local _a") }
	if a.DisplacementFixed(sc, 0, starts) { return fail("ELF: to the global _c") }
	a.ObjFormat = OBJ_UNKNOWN
	if !a.DisplacementFixed(sx, 0, starts) { return fail("unknown format: to Lx within _a's atom") }
	if a.DisplacementFixed(sx, 8, starts) { return fail("unknown format: to Lx from _b's atom") }
	if !a.DisplacementFixed(sa, 4, starts) { return fail("unknown format: to local _a, same atom") }
	if a.DisplacementFixed(sc, 12, starts) { return fail("unknown format: to the global _c") }
	return ""
}
