package "pkg/binate/asm"

import "pkg/builtins/testing"

// atomAsm returns an assembler in a text section holding `_a: nop; Lx: nop; _b: nop;
// _c: nop`, with _c recorded first (a forward global declaration) and defined last,
// and a global `Lg` defined at the end: symbols are recorded in first-mention order.
func atomAsm() @Assembler {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.SetGlobal("_c")
	a.DefineLabel("_a")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Lx")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("_b")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("_c")
	a.EmitUint32(0xD503201F)
	a.SetGlobal("Lg")
	a.DefineLabel("Lg")
	a.EmitUint32(0xD503201F)
	return a
}

// AtomStarts lists every atom-starting symbol, sorted by offset, whatever order the
// symbols were recorded in: not the local temporary Lx, but the global `L`-named Lg
// (which a Mach-O object lists, so it starts an atom); AtomStartAt finds the atom
// holding an offset.
func TestAtomStartsAndLookup() testing.TestResult {
	var a @Assembler = atomAsm()
	var starts @[]int = a.AtomStarts(0)
	if len(starts) != 4 || a.Symbols[starts[0]].Offset != 0 || a.Symbols[starts[1]].Offset != 8 ||
			a.Symbols[starts[2]].Offset != 12 || a.Symbols[starts[3]].Offset != 16 {
		return fail("atom starts must be at 0, 8, 12, 16")
	}
	if a.AtomStartAt(starts, 4) != 0 || a.AtomStartAt(starts, 8) != 8 ||
			a.AtomStartAt(starts, 17) != 16 {
		return fail("AtomStartAt")
	}
	if a.AtomStartAt(starts, -1) != -1 { return fail("before every atom") }
	return ""
}

// DisplacementFixed per object format: Mach-O fixes a reference within one atom
// (to the atom's own symbol or a temporary inside it) and not one across atoms, nor
// one across a global `L`-named symbol; ELF fixes a reference to a local symbol only;
// with no format, only what both fix — a local symbol in the same atom.
func TestDisplacementFixedPerFormat() testing.TestResult {
	var a @Assembler = atomAsm()
	var starts @[]int = a.AtomStarts(0)
	var sa Symbol = a.Symbols[a.LookupSymbol("_a")]
	var sx Symbol = a.Symbols[a.LookupSymbol("Lx")]
	var sc Symbol = a.Symbols[a.LookupSymbol("_c")]
	a.ObjFormat = OBJ_MACHO
	if !a.DisplacementFixed(sa, 4, starts, false) { return fail("Mach-O: within _a's atom, to _a") }
	if !a.DisplacementFixed(sx, 0, starts, false) { return fail("Mach-O: within _a's atom, to Lx") }
	if a.DisplacementFixed(sa, 8, starts, false) { return fail("Mach-O: from _b's atom to _a") }
	if a.DisplacementFixed(sc, 16, starts, false) { return fail("Mach-O: from Lg's atom to _c") }
	a.ObjFormat = OBJ_ELF
	if !a.DisplacementFixed(sa, 8, starts, false) { return fail("ELF: to the local _a") }
	if a.DisplacementFixed(sc, 0, starts, false) { return fail("ELF: to the global _c") }
	a.ObjFormat = OBJ_UNKNOWN
	if !a.DisplacementFixed(sx, 0, starts, false) {
		return fail("unknown format: to Lx within _a's atom")
	}
	if a.DisplacementFixed(sx, 8, starts, false) {
		return fail("unknown format: to Lx from _b's atom")
	}
	if !a.DisplacementFixed(sa, 4, starts, false) {
		return fail("unknown format: to local _a, same atom")
	}
	if a.DisplacementFixed(sc, 12, starts, false) { return fail("unknown format: to the global _c") }
	return ""
}

// Without SubsectionsViaSymbols the linker keeps a Mach-O section whole: clang on AArch64
// (aarch64Rule) then fixes every reference within the section, a global one in another atom
// included, while clang on x86-64 still compares atoms; with no object format set, only what
// ELF fixes too — a local symbol, whatever its atom.
func TestDisplacementFixedWithoutSubsections() testing.TestResult {
	var a @Assembler = atomAsm()
	var starts @[]int = a.AtomStarts(0)
	var sa Symbol = a.Symbols[a.LookupSymbol("_a")]
	var sc Symbol = a.Symbols[a.LookupSymbol("_c")]
	a.ObjFormat = OBJ_MACHO
	if !a.DisplacementFixed(sc, 0, starts, true) { return fail("AArch64: from _a's atom to _c") }
	if !a.DisplacementFixed(sa, 8, starts, true) { return fail("AArch64: from _b's atom to _a") }
	if a.DisplacementFixed(sc, 0, starts, false) { return fail("x86-64: from _a's atom to _c") }
	a.SubsectionsViaSymbols = true
	if a.DisplacementFixed(sc, 0, starts, true) { return fail("subsections: from _a's atom to _c") }
	if a.DisplacementFixed(sa, 8, starts, true) { return fail("subsections: from _b's atom to _a") }
	a.SubsectionsViaSymbols = false
	a.ObjFormat = OBJ_UNKNOWN
	if !a.DisplacementFixed(sa, 8, starts, true) { return fail("unknown format: to the local _a") }
	if a.DisplacementFixed(sc, 0, starts, true) { return fail("unknown format: to the global _c") }
	a.ObjFormat = OBJ_ELF
	if a.DisplacementFixed(sc, 0, starts, true) { return fail("ELF: to the global _c") }
	return ""
}

// A temporary at the end of an atom belongs to that atom, not the next one starting at its
// address (it was defined before that one), one inside the next atom to that one, and an
// alias to its target's atom even past that atom's end — as clang attributes them — so a
// reference to the end label from the next atom is no fixed one where atoms decide (clang
// on x86-64), while clang on AArch64 (aarch64Rule) fixes any reference to a temporary.
func TestAtomOfDefinitionOrder() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.ObjFormat = OBJ_MACHO
	a.SubsectionsViaSymbols = true
	a.DefineLabel("_f")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Lend")
	a.DefineLabel("_g")
	a.EmitUint32(0xD503201F)
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Lmid")
	a.EmitUint32(0xD503201F)
	a.DefineAlias("La8", 0, 8, true)
	var la8 int = a.LookupSymbol("La8")
	a.Symbols[la8].AliasOf = a.Symbols[a.LookupSymbol("_f")].Name
	var starts @[]int = a.AtomStarts(0)
	var f int = a.LookupSymbol("_f")
	var g int = a.LookupSymbol("_g")
	var lend Symbol = a.Symbols[a.LookupSymbol("Lend")]
	var lmid Symbol = a.Symbols[a.LookupSymbol("Lmid")]
	if a.AtomOf(starts, lend) != f { return fail("Lend belongs to _f's atom") }
	if a.AtomOf(starts, lmid) != g { return fail("Lmid belongs to _g's atom") }
	if a.AtomOf(starts, a.Symbols[la8]) != f { return fail("La8 = _f + 8 belongs to _f's atom") }
	if a.AtomOf(starts, a.Symbols[g]) != g { return fail("_g starts its own atom") }
	if a.DisplacementFixed(lend, 8, starts, false) { return fail("from _g's atom to Lend") }
	if !a.DisplacementFixed(lend, 0, starts, false) { return fail("from _f's atom to Lend") }
	if !a.DisplacementFixed(lmid, 8, starts, false) { return fail("from _g's atom to Lmid") }
	if a.DisplacementFixed(a.Symbols[la8], 8, starts, false) { return fail("from _g's atom to La8") }
	// clang on AArch64 (aarch64Rule): a temporary, or an alias of one, is fixed from any atom.
	if !a.DisplacementFixed(lend, 8, starts, true) { return fail("AArch64: from _g's atom to Lend") }
	if !a.DisplacementFixed(a.Symbols[la8], 8, starts, true) { return fail("AArch64: to La8") }
	if a.DisplacementFixed(a.Symbols[f], 8, starts, true) { return fail("AArch64: to _f from _g") }
	return ""
}

// An alias at an atom start (`A = _f`, a plain symbol with its target's definition order)
// does not take a temporary defined before that start (clang: Lend belongs to _e); of two
// labels at one place the last defined starts the atom a temporary after them is in, weak or
// not (clang: `_a: _b: Lx` is _b + 0); and code after zero-length atoms is in the last one,
// so a reference from it to a temporary of an earlier one at that offset is no fixed one.
func TestAtomOfAtOnePlace() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.ObjFormat = OBJ_MACHO
	a.DefineLabel("_e")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Lend")
	a.DefineLabel("_f")
	a.EmitUint32(0xD503201F)
	a.DefineAlias("A", 0, 4, false)
	var ai int = a.LookupSymbol("A")
	var f int = a.LookupSymbol("_f")
	a.Symbols[ai].AliasOf = a.Symbols[f].Name
	a.Symbols[ai].DefOrder = a.Symbols[f].DefOrder
	a.DefineLabel("_a")
	a.DefineLabel("Lx")
	a.DefineLabel("_b")
	a.SetWeak("_b")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Ly")
	var starts @[]int = a.AtomStarts(0)
	var e int = a.LookupSymbol("_e")
	var ab int = a.LookupSymbol("_a")
	var b int = a.LookupSymbol("_b")
	if a.AtomOf(starts, a.Symbols[a.LookupSymbol("Lend")]) != e { return fail("Lend belongs to _e") }
	if a.AtomOf(starts, a.Symbols[ai]) != f { return fail("A belongs to _f's atom") }
	if a.AtomOf(starts, a.Symbols[a.LookupSymbol("Lx")]) != ab { return fail("Lx belongs to _a") }
	if a.AtomOf(starts, a.Symbols[a.LookupSymbol("Ly")]) != b { return fail("Ly belongs to _b") }
	var lx Symbol = a.Symbols[a.LookupSymbol("Lx")]
	if a.DisplacementFixed(lx, 8, starts, false) { return fail("from _b's code to Lx of _a") }
	if !a.DisplacementFixed(a.Symbols[a.LookupSymbol("Ly")], 8, starts, false) {
		return fail("from _b's code to Ly")
	}
	return ""
}
