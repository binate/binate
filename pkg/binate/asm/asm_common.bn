package "pkg/binate/asm"

import "pkg/binate/buf"

// Common symbols: a common (a tentative definition the linker allocates) and a local common
// (a local data object in the section bss).

// DefineCommon declares name a common symbol; see asm.bni.
func (a @Assembler) DefineCommon(name *[]readonly char, size int64, align int64) {
	if !a.commonShapeOk(name, size, align) { return }
	var idx int = a.findSymbol(name)
	if idx < 0 {
		idx = a.addSymbol(name, -1, 0, BIND_GLOBAL)
	} else {
		var sym Symbol = a.Symbols[idx]
		if sym.Section >= 0 || sym.Abs {
			a.setError(buf.Concat(buf.Concat("symbol '", name), "' is already defined"))
			return
		}
		if sym.Common && (sym.Size != size || sym.CommonAlign != align) {
			a.setError(
					buf.Concat(buf.Concat("common '", name), "' declared again with another size or alignment"))
			return
		}
		if sym.Binding == BIND_LOCAL { a.Symbols[idx].Binding = BIND_GLOBAL }
	}
	a.Symbols[idx].Common = true
	a.Symbols[idx].CommonAlign = align
	a.Symbols[idx].Size = size
	a.Symbols[idx].Type = SYM_OBJECT
}

// DefineLocalCommon defines name as a local common; see asm.bni.
func (a @Assembler) DefineLocalCommon(name *[]readonly char, size int64, align int64) {
	if !a.commonShapeOk(name, size, align) { return }
	var idx int = a.findSymbol(name)
	if idx >= 0 {
		var sym Symbol = a.Symbols[idx]
		if sym.Section >= 0 || sym.Abs || sym.Common {
			a.setError(buf.Concat(buf.Concat("symbol '", name), "' is already defined"))
			return
		}
	}
	// The zero bytes are held in the section, and its alignment kept as an int, so both must
	// fit this host's int.
	if cast(int64, cast(int, size)) != size || cast(int64, cast(int, align)) != align {
		a.setError(buf.Concat(buf.Concat("local common '", name), "' is too large for this host"))
		return
	}
	var prev int = a.Current
	a.SetSection("bss", -1)
	a.Align(cast(int, align))
	a.DefineLabel(name)
	a.Zero(cast(int, size))
	a.Current = prev
	if a.HasError { return }
	idx = a.findSymbol(name)
	a.Symbols[idx].Size = size
	a.Symbols[idx].Type = SYM_OBJECT
}

// commonShapeOk reports whether size and align suit a common named name — size not negative,
// align a power of two, each within a 4-byte word when WordSize is 4 — else sets the error.
func (a @Assembler) commonShapeOk(name *[]readonly char, size int64, align int64) bool {
	if size < 0 {
		a.setError(buf.Concat(buf.Concat("common '", name), "' has a negative size"))
		return false
	}
	if align <= 0 || (align & (align - 1)) != 0 {
		a.setError(
				buf.Concat(buf.Concat("common '", name), "' has an alignment that is not a power of two"))
		return false
	}
	if a.WordSize == 4 && (size > 0xFFFFFFFF || align > 0x80000000) {
		a.setError(buf.Concat(buf.Concat("common '", name), "' is too large for a 32-bit target"))
		return false
	}
	return true
}
