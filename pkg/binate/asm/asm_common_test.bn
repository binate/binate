package "pkg/binate/asm"

import "pkg/builtins/testing"

// Common symbols (asm_common.bn): a common's fields and binding, its redeclaration and
// redefinition rules, its size and alignment checks, and a local common's place in bss.

// A common is global, in no section, with its size, alignment and the data-object mark; a
// weak one stays weak, whichever comes first; declaring it again the same way changes nothing.
func TestDefineCommon() testing.TestResult {
	var a @Assembler = New(8)
	a.DefineCommon("c", 100, 8)
	a.SetWeak("w")
	a.DefineCommon("w", 4, 4)
	a.DefineCommon("v", 2, 2)
	a.SetWeak("v")
	a.DefineCommon("c", 100, 8)
	if a.HasError { return fail(a.ErrorMsg) }
	var c Symbol = a.Symbols[a.LookupSymbol("c")]
	if !c.Common || !c.Object || c.Size != 100 || c.CommonAlign != 8 || c.Section != -1 ||
			c.Binding != BIND_GLOBAL {
		return fail("c not a global common of 100 bytes aligned to 8")
	}
	if a.Symbols[a.LookupSymbol("w")].Binding != BIND_WEAK { return fail("w not weak") }
	if a.Symbols[a.LookupSymbol("v")].Binding != BIND_WEAK { return fail("v not weak") }
	return ""
}

// A common declared again with another size or alignment, a name already defined, a label,
// absolute symbol or alias of a common's name, a negative size, an alignment that is not a
// power of two, and a size beyond 32 bits on a 32-bit target are errors.
func TestDefineCommonRejected() testing.TestResult {
	var cases int = 9
	for i := 0; i < cases; i++ {
		var a @Assembler = New(8)
		if i == 8 { a = New(4) }
		a.SetSection("text", -1)
		if i == 0 {
			a.DefineCommon("c", 4, 4)
			a.DefineCommon("c", 8, 4)
		} else if i == 1 {
			a.DefineCommon("c", 4, 4)
			a.DefineCommon("c", 4, 8)
		} else if i == 2 {
			a.DefineLabel("c")
			a.DefineCommon("c", 4, 4)
		} else if i == 3 {
			a.DefineCommon("c", 4, 4)
			a.DefineLabel("c")
		} else if i == 4 {
			a.DefineCommon("c", 4, 4)
			a.DefineAbsolute("c", 5)
		} else if i == 5 {
			a.DefineCommon("c", 4, 4)
			a.DefineAlias("c", 0, cast(uint, 0), false)
		} else if i == 6 {
			a.DefineCommon("c", -1, 1)
		} else if i == 7 {
			a.DefineCommon("c", 4, 3)
		} else {
			a.DefineCommon("c", 0x100000000, 1)
		}
		if !a.HasError { return fail("a bad common accepted") }
	}
	var z @Assembler = New(8)
	z.DefineCommon("c", 4, 0)
	if !z.HasError { return fail("a zero alignment accepted") }
	return ""
}

// A local common is a local data object in bss at the next offset its alignment allows, with
// its size, the current section unchanged; a global or weak name keeps its binding (Mach-O's
// `.globl` then `.lcomm`); one of a common's or a defined name is an error.
func TestDefineLocalCommon() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLocalCommon("la", 1, 1)
	a.DefineLocalCommon("lb", 12, 8)
	if a.HasError { return fail(a.ErrorMsg) }
	if !charsEqual(a.Sections[a.Current].Name, "text") { return fail("the current section changed") }
	var lb Symbol = a.Symbols[a.LookupSymbol("lb")]
	var bss int = a.findSection("bss")
	if bss < 0 || lb.Section != bss || lb.Offset != 8 || lb.Size != 12 || !lb.Object ||
			lb.Binding != BIND_LOCAL || lb.Common {
		return fail("lb not a local object of 12 bytes at bss+8")
	}
	if a.Sections[bss].Len != 20 || a.Sections[bss].Align != 8 {
		return fail("bss not 20 bytes aligned to 8")
	}
	a.SetGlobal("lg")
	a.DefineLocalCommon("lg", 4, 4)
	a.SetWeak("lw")
	a.DefineLocalCommon("lw", 4, 4)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.Symbols[a.LookupSymbol("lg")].Binding != BIND_GLOBAL { return fail("lg not global") }
	if a.Symbols[a.LookupSymbol("lw")].Binding != BIND_WEAK { return fail("lw not weak") }
	for i := 0; i < 2; i++ {
		var b @Assembler = New(8)
		b.SetSection("text", -1)
		if i == 0 { b.DefineCommon("x", 4, 4) }
		if i == 1 { b.DefineLabel("x") }
		b.DefineLocalCommon("x", 4, 4)
		if !b.HasError { return fail("a bad local common accepted") }
	}
	return ""
}

// A label may not take an absolute symbol's name: no symbol is both absolute and in a section.
func TestDefineLabelOfAbsoluteName() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineAbsolute("n", 5)
	a.DefineLabel("n")
	if !a.HasError { return fail("a label took an absolute symbol's name") }
	return ""
}
