package "pkg/binate/asm"

// ============================================================
// Data Emission
// ============================================================
//
// Public byte / word / string / alignment / fill writers for the
// current section. Every emitter sets HasError and is a no-op when
// no section is active. Per-architecture packages call these to
// emit instruction encodings and inline data.

// EmitBytes appends every byte of data to the current section, growing
// the section's backing as needed. Sets an error and is a no-op if no
// section is active.
func (a @Assembler) EmitBytes(data *[]uint8) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var s @Section = a.Sections[a.Current]
	ensureCapacity(s, len(data))
	for i := 0; i < len(data); i++ {
		s.Data[s.Len] = data[i]
		s.Len = s.Len + 1
	}
}

// EmitUint8 appends one byte to the current section.
func (a @Assembler) EmitUint8(val uint8) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	sectionEmitByte(a.Sections[a.Current], val)
}

// EmitUint16 appends val to the current section in little-endian byte
// order (low byte first).
func (a @Assembler) EmitUint16(val uint16) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var s @Section = a.Sections[a.Current]
	// Little-endian (ARM, x86)
	sectionEmitByte(s, cast(uint8, val & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 8) & 0xff))
}

// EmitUint32 appends val to the current section in little-endian byte order.
func (a @Assembler) EmitUint32(val uint32) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var s @Section = a.Sections[a.Current]
	// Little-endian
	sectionEmitByte(s, cast(uint8, val & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 8) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 16) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 24) & 0xff))
}

// EmitUint64 appends val to the current section in little-endian byte order.
func (a @Assembler) EmitUint64(val uint64) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var s @Section = a.Sections[a.Current]
	// Little-endian
	sectionEmitByte(s, cast(uint8, val & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 8) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 16) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 24) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 32) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 40) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 48) & 0xff))
	sectionEmitByte(s, cast(uint8, (val >> 56) & 0xff))
}

// EmitAddr emits a word-sized absolute-address placeholder (zero bytes)
// and records a fixup against `label` so Finalize can patch it. Uses
// fixup kind 0 (generic absolute address); per-architecture packages
// may use specific kinds via AddFixup directly. Word size comes from
// the assembler (set by NewAssembler).
func (a @Assembler) EmitAddr(label *[]readonly char) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	// Record fixup for word-sized absolute address
	// Kind 0 = generic absolute address (architecture packages define specific kinds)
	a.AddFixup(label, 0, 0, a.WordSize)
	// Emit placeholder zeros
	for i := 0; i < a.WordSize; i++ {
		sectionEmitByte(a.Sections[a.Current], 0)
	}
}

// EmitAsciz appends s to the current section followed by a single
// trailing NUL byte (C-string convention).
func (a @Assembler) EmitAsciz(s *[]readonly char) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var sec @Section = a.Sections[a.Current]
	ensureCapacity(sec, len(s) + 1)
	for i := 0; i < len(s); i++ {
		sec.Data[sec.Len] = s[i]
		sec.Len = sec.Len + 1
	}
	sec.Data[sec.Len] = 0
	sec.Len = sec.Len + 1
}

// Align pads the current section with zero bytes until its length is a
// multiple of `alignment`. Equivalent to `a.AlignFill(alignment, 0)`.
func (a @Assembler) Align(alignment int) {
	a.AlignFill(alignment, 0)
}

// AlignFill pads the current section with `fill` bytes until its length
// is a multiple of `alignment`. No-op when alignment <= 0 or already
// aligned; sets an error if no section is active.
func (a @Assembler) AlignFill(alignment int, fill uint8) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	if alignment <= 0 {
		return
	}
	var pos int = a.Sections[a.Current].Len
	var rem int = pos % alignment
	if rem == 0 {
		return
	}
	var pad int = alignment - rem
	var s @Section = a.Sections[a.Current]
	ensureCapacity(s, pad)
	for i := 0; i < pad; i++ {
		s.Data[s.Len] = fill
		s.Len = s.Len + 1
	}
}

// Zero appends n zero bytes to the current section. Equivalent to
// `a.Fill(n, 0)`.
func (a @Assembler) Zero(n int) {
	a.Fill(n, 0)
}

// Fill appends n copies of `val` to the current section.
func (a @Assembler) Fill(n int, val uint8) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var s @Section = a.Sections[a.Current]
	ensureCapacity(s, n)
	for i := 0; i < n; i++ {
		s.Data[s.Len] = val
		s.Len = s.Len + 1
	}
}
