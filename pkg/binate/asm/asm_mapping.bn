package "pkg/binate/asm"

import "pkg/binate/buf"

// The mapping marks (asm.bni MapMarks): where each section's contents change between
// instructions and data, as clang's ELF objects record them with mapping symbols.

// noteInstruction prepares the current section for an instruction: it holds instructions,
// marked as code where it was not holding code.  A zero-fill section can hold none, even one
// encoded as zero bytes, which its contents could otherwise take (clang: "virtual section …
// cannot have instructions").  It reports whether the instruction may be written.
func (a @Assembler) noteInstruction() bool {
	if a.Current < 0 {
		a.setError("no current section")
		return false
	}
	var s @Section = a.Sections[a.Current]
	if s.ZeroFill {
		a.setError(buf.Concat(buf.Concat("the zero-fill section ", s.Name), " can hold no instruction"))
		return false
	}
	s.HasInstructions = true
	if s.MapState != MAP_CODE { a.addMapMark(true) }
	s.MapState = MAP_CODE
	return true
}

// noteData marks data at the current position unless the current section holds data
// already.  The data emitters call it with a section current.
func (a @Assembler) noteData() {
	if a.Sections[a.Current].MapState == MAP_DATA { return }
	a.addMapMark(false)
	a.Sections[a.Current].MapState = MAP_DATA
}

// EmitInstrUint8 appends one byte of an instruction; see asm.bni.
func (a @Assembler) EmitInstrUint8(val uint8) {
	if a.noteInstruction() { sectionEmitByte(a.Sections[a.Current], val) }
}

// EmitInstrUint16 appends two bytes of an instruction; see asm.bni.
func (a @Assembler) EmitInstrUint16(val uint16) {
	if !a.noteInstruction() { return }
	for k := 0; k < 2; k++ {
		sectionEmitByte(a.Sections[a.Current], cast(uint8, (val >> cast(uint16, 8 * k)) & 0xFF))
	}
}

// EmitInstrUint32 appends four bytes of an instruction; see asm.bni.
func (a @Assembler) EmitInstrUint32(val uint32) {
	if !a.noteInstruction() { return }
	for k := 0; k < 4; k++ {
		sectionEmitByte(a.Sections[a.Current], cast(uint8, (val >> cast(uint32, 8 * k)) & 0xFF))
	}
}

// EmitInstrUint64 appends eight bytes of an instruction; see asm.bni.
func (a @Assembler) EmitInstrUint64(val uint64) {
	if !a.noteInstruction() { return }
	for k := 0; k < 8; k++ {
		sectionEmitByte(a.Sections[a.Current], cast(uint8, (val >> cast(uint64, 8 * k)) & 0xFF))
	}
}

// MarkInstruction records an instruction of no bytes; see asm.bni.
func (a @Assembler) MarkInstruction() { _ = a.noteInstruction() }

// ReserveMarkMention reserves the next mention for the next mapping mark; see asm.bni.
func (a @Assembler) ReserveMarkMention() {
	a.NumMentions = a.NumMentions + 1
	a.MarkMention = a.NumMentions
	a.MarkReserved = a.NumMentions
	a.MarkFirstName = a.NumMentionNames
	a.MarkInWindow = true
}

// ClearMarkMention ends a reservation, the item's `.` labels moved first; see asm.bni.
func (a @Assembler) ClearMarkMention() {
	if a.MarkReserved > 0 { a.hoistDotMentions() }
	a.MarkMention = 0
	a.MarkReserved = 0
}

// EndMentionWindow orders a part of an item and begins the next; see asm.bni.
func (a @Assembler) EndMentionWindow() {
	if a.MarkReserved == 0 { return }
	a.hoistDotMentions()
	a.MarkFirstName = a.NumMentionNames
	a.MarkInWindow = false
}

// ForgetMention drops an unused name's mention; see asm.bni.
func (a @Assembler) ForgetMention(name *[]readonly char) {
	if a.findSymbol(name) < 0 { _ = a.Mentions.Remove(name) }
}

// hoistDotMentions reassigns the numbers the names the item's current part first mentioned
// hold, and the reserved mark's in the item's first part -- ascending, in the order they were
// taken -- to the part's `.` labels, then the mark, then its other names (ClearMarkMention).
func (a @Assembler) hoistDotMentions() {
	var first int = a.MarkFirstName
	var n int = a.NumMentionNames - first
	var dots int = 0
	for k := 0; k < n; k++ {
		if IsDotLabel(a.MentionNames[first + k]) { dots = dots + 1 }
	}
	if dots == 0 { return }
	var mark int = 0
	if a.MarkInWindow { mark = 1 }
	var nums @[]int = make_slice(int, n + mark)
	if a.MarkInWindow { nums[0] = a.MarkReserved }
	for k := 0; k < n; k++ {
		var m int
		m, _ = a.Mentions.Get(a.MentionNames[first + k])
		nums[k + mark] = m
	}
	var at int = 0
	for k := 0; k < n; k++ {
		if !IsDotLabel(a.MentionNames[first + k]) { continue }
		a.setMention(a.MentionNames[first + k], nums[at])
		at = at + 1
	}
	if a.MarkInWindow {
		for m := a.NumMapMarks - 1; m >= 0; m-- {
			if a.MapMarks[m].Mention == a.MarkReserved {
				a.MapMarks[m].Mention = nums[at]
				break
			}
		}
		at = at + 1
	}
	for k := 0; k < n; k++ {
		if IsDotLabel(a.MentionNames[first + k]) { continue }
		a.setMention(a.MentionNames[first + k], nums[at])
		at = at + 1
	}
}

// setMention makes name's mention m, its symbol's too once it has one.
func (a @Assembler) setMention(name *[]readonly char, m int) {
	a.Mentions.Put(name, m)
	var si int = a.findSymbol(name)
	if si >= 0 { a.Symbols[si].Mention = m }
}

// addMapMark appends a mark of code (or data) at the current position, registered now, or
// where ReserveMarkMention reserved.
func (a @Assembler) addMapMark(code bool) {
	if a.NumMapMarks == len(a.MapMarks) {
		var n int = 2 * len(a.MapMarks)
		if n == 0 { n = 8 }
		var grown @[]MapMark = make_slice(MapMark, n)
		for i := 0; i < a.NumMapMarks; i++ { grown[i] = a.MapMarks[i] }
		a.MapMarks = grown
	}
	var m MapMark
	m.Section = a.Current
	m.Offset = a.Sections[a.Current].Len
	m.Code = code
	if a.MarkMention > 0 {
		m.Mention = a.MarkMention
		a.MarkMention = 0
	} else {
		a.NumMentions = a.NumMentions + 1
		m.Mention = a.NumMentions
	}
	a.MapMarks[a.NumMapMarks] = m
	a.NumMapMarks = a.NumMapMarks + 1
}

// EmitPadding appends data as alignment padding, marking nothing; see asm.bni.
func (a @Assembler) EmitPadding(data *[]readonly uint8) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	var nonZero bool = false
	for i := 0; i < len(data); i++ {
		if data[i] != 0 { nonZero = true }
	}
	if a.zeroFillRejects(nonZero) { return }
	var s @Section = a.Sections[a.Current]
	if s.ZeroFill {
		a.countZeroFill(s, len(data))
		return
	}
	ensureCapacity(s, len(data))
	for i := 0; i < len(data); i++ {
		s.Data[s.Len] = data[i]
		s.Len = s.Len + 1
	}
}
