package "pkg/binate/asm"

import "pkg/builtins/testing"

// markIs reports whether a's mapping mark k is at offset off of section si, of code (or data).
func markIs(a @Assembler, k int, si int, off int, code bool) bool {
	if k >= a.NumMapMarks { return false }
	var m MapMark = a.MapMarks[k]
	return m.Section == si && m.Offset == off && m.Code == code
}

// An instruction marks code where its section was not holding code, data marks data where
// it was not holding data — even data of no bytes — and its own bytes are no data; padding
// (AlignFill, EmitPadding) marks neither, so the item after it is marked at its aligned
// place; each section keeps its own state; each mark is registered when it is made.
func TestMapMarks() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.EmitInstrUint32(0xD65F03C0)
	a.EmitInstrUint32(0xD65F03C0) // still code: no mark
	a.EmitUint8(1) // data at 8
	a.AlignFill(4, 0) // padding: nothing
	a.EmitPadding("\x1f\x20\x03\xd5\x1f\x20\x03\xd5") // padding: nothing
	a.EmitInstrUint32(0xD65F03C0) // code at 20
	a.Zero(0) // data of no bytes at 24
	a.SetSection("data", -1)
	a.DefineLabel("d")
	a.EmitUint64(1) // data at 0 of data
	a.SetSection("text", -1)
	a.EmitUint32(5) // text holds data already: no mark
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumMapMarks != 5 || !markIs(a, 0, 0, 0, true) || !markIs(a, 1, 0, 8, false) ||
			!markIs(a, 2, 0, 20, true) || !markIs(a, 3, 0, 24, false) || !markIs(a, 4, 1, 0, false) {
		return fail("the marks are not code 0, data 8, code 20, data 24 in text and data 0 in data")
	}
	if a.MapMarks[3].Mention >= a.Symbols[a.LookupSymbol("d")].Mention ||
			a.Symbols[a.LookupSymbol("d")].Mention >= a.MapMarks[4].Mention {
		return fail("the marks are not registered where they are made, around d")
	}
	return ""
}

// Every data emitter marks data: bytes, sized data, an address, a string, a fill.
func TestMapMarksEveryEmitter() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	for k := 0; k < 7; k++ {
		a.EmitInstrUint32(0xD65F03C0)
		if k == 0 { a.EmitBytes(make_slice(uint8, 1)) }
		if k == 1 { a.EmitUint16(1) }
		if k == 2 { a.EmitUint64(1) }
		if k == 3 { a.EmitAddr("x") }
		if k == 4 { a.EmitAsciz("s") }
		if k == 5 { a.Fill(2, 7) }
		if k == 6 { a.EmitUint8(1) }
	}
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumMapMarks != 14 { return fail("not a code and a data mark for each emitter") }
	for k := 0; k < 14; k++ {
		if a.MapMarks[k].Code != (k % 2 == 0) { return fail("the marks do not alternate") }
	}
	return ""
}

// A reserved mention (ReserveMarkMention) puts the next mark before the names mentioned after
// the reservation, as clang registers an instruction's mapping symbol before its operands'
// symbols; a cleared one (ClearMarkMention) leaves the next mark where it is made.  An
// instruction of no bytes (MarkInstruction) marks code and holds instructions.
func TestMarkMentionReserved() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.ReserveMarkMention()
	a.NoteMention("g") // the instruction's operand, mentioned before its bytes
	a.EmitInstrUint32(0x94000000)
	a.ClearMarkMention()
	a.DefineLabel("g")
	a.DefineLabel("h")
	a.ReserveMarkMention()
	a.ClearMarkMention()
	a.EmitUint32(1) // data, marked after h
	if a.HasError || a.NumMapMarks != 2 { return fail("not two marks") }
	var f int = a.Symbols[a.LookupSymbol("f")].Mention
	var g int = a.Symbols[a.LookupSymbol("g")].Mention
	var h int = a.Symbols[a.LookupSymbol("h")].Mention
	if !(f < a.MapMarks[0].Mention && a.MapMarks[0].Mention < g) {
		return fail("the code mark is not between f and its operand g")
	}
	if a.MapMarks[1].Mention <= h { return fail("the data mark is not after h") }
	a.SetSection("data", -1)
	a.MarkInstruction()
	if a.HasError || a.NumMapMarks != 3 || !markIs(a, 2, 1, 0, true) ||
			!a.Sections[1].HasInstructions || a.Sections[1].Len != 0 {
		return fail("an instruction of no bytes did not mark code in data")
	}
	return ""
}
