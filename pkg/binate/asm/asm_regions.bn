package "pkg/binate/asm"

// BeginDataRegion begins a data region of kind at the current position; see asm.bni.
func (a @Assembler) BeginDataRegion(kind int) {
	if a.Current < 0 {
		a.setError("no current section")
		return
	}
	if kind < REGION_DATA || kind > REGION_ABS_JUMP_TABLE32 {
		a.setError("unknown data region kind")
		return
	}
	if a.DataRegionOpen() {
		a.setError("a data region is already open (regions do not nest)")
		return
	}
	if a.NumDataRegions == len(a.DataRegions) {
		var n int = 2 * len(a.DataRegions)
		if n == 0 { n = 4 }
		var grown @[]DataRegion = make_slice(DataRegion, n)
		for i := 0; i < a.NumDataRegions; i++ { grown[i] = a.DataRegions[i] }
		a.DataRegions = grown
	}
	var r DataRegion
	r.Section = a.Current
	r.Start = a.Sections[a.Current].Len
	r.End = -1
	r.Kind = kind
	a.DataRegions[a.NumDataRegions] = r
	a.NumDataRegions = a.NumDataRegions + 1
}

// EndDataRegion ends the open data region at the current position; see asm.bni.
func (a @Assembler) EndDataRegion() {
	if !a.DataRegionOpen() {
		a.setError("no data region is open")
		return
	}
	var i int = a.NumDataRegions - 1
	if a.Current != a.DataRegions[i].Section {
		a.setError("a data region must end in the section it began in")
		return
	}
	a.DataRegions[i].End = a.Sections[a.Current].Len
}

// DataRegionOpen reports whether a data region is open; see asm.bni.
func (a @Assembler) DataRegionOpen() bool {
	return a.NumDataRegions > 0 && a.DataRegions[a.NumDataRegions - 1].End < 0
}
