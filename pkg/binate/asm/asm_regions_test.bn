package "pkg/binate/asm"

import "pkg/builtins/testing"

// regionRejected reports whether a recorded an error containing want.
func regionRejected(a @Assembler, want *[]readonly char) bool {
	return a.HasError && charsContain(a.ErrorMsg, want)
}

// A data region records its section, its start and end there, and its kind, in the order the
// regions began (past the table's first growth too).
func TestDataRegions() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.EmitUint32(1)
	a.BeginDataRegion(REGION_JUMP_TABLE16)
	if !a.DataRegionOpen() { return fail("the region is not open") }
	a.EmitUint16(2)
	a.EndDataRegion()
	if a.HasError { return fail(a.ErrorMsg) }
	var r DataRegion = a.DataRegions[0]
	if a.NumDataRegions != 1 || r.Section != 0 || r.Start != 4 || r.End != 6 ||
			r.Kind != REGION_JUMP_TABLE16 || a.DataRegionOpen() {
		return fail("the region is not text 4..6, a 16-bit jump table, ended")
	}
	a.SetSection("data", -1)
	for k := 0; k < 5; k++ {
		a.BeginDataRegion(REGION_DATA + k)
		a.EmitUint8(3)
		a.EndDataRegion()
	}
	if a.HasError { return fail(a.ErrorMsg) }
	r = a.DataRegions[5]
	if a.NumDataRegions != 6 || r.Section != 1 || r.Start != 4 || r.End != 5 ||
			r.Kind != REGION_ABS_JUMP_TABLE32 {
		return fail("the sixth region is not data 4..5, an absolute jump table")
	}
	if !a.Finalize() { return fail(a.ErrorMsg) }
	return ""
}

// A data region needs a section and a known kind; regions do not nest, and one ends in the
// section it began in; ending none is an error, and so is one still open at Finalize.
func TestDataRegionErrors() testing.TestResult {
	var a @Assembler = New(8)
	a.BeginDataRegion(REGION_DATA)
	if !regionRejected(a, "no current section") || a.NumDataRegions != 0 {
		return fail("a region with no section was begun")
	}
	a = New(8)
	a.SetSection("text", -1)
	a.BeginDataRegion(0)
	if !regionRejected(a, "unknown data region kind") { return fail("kind 0 was taken") }
	a = New(8)
	a.SetSection("text", -1)
	a.BeginDataRegion(REGION_ABS_JUMP_TABLE32 + 1)
	if !regionRejected(a, "unknown data region kind") { return fail("kind 6 was taken") }
	a = New(8)
	a.SetSection("text", -1)
	a.BeginDataRegion(REGION_DATA)
	a.BeginDataRegion(REGION_DATA)
	if !regionRejected(a, "do not nest") || a.NumDataRegions != 1 { return fail("a region nested") }
	a = New(8)
	a.SetSection("text", -1)
	a.EndDataRegion()
	if !regionRejected(a, "no data region is open") { return fail("ending no region was taken") }
	a = New(8)
	a.SetSection("text", -1)
	a.BeginDataRegion(REGION_DATA)
	a.SetSection("data", -1)
	a.EndDataRegion()
	if !regionRejected(a, "the section it began in") || !a.DataRegionOpen() {
		return fail("a region ended in another section")
	}
	a = New(8)
	a.SetSection("text", -1)
	a.BeginDataRegion(REGION_DATA)
	if a.Finalize() || !regionRejected(a, "not ended") { return fail("Finalize took an open region") }
	return ""
}
