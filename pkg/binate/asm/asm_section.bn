package "pkg/binate/asm"

import "pkg/binate/buf"

// Section names and flags: the flags a name implies, as clang gives them to `.section
// .<name>`; the zero-fill names; and the checks SetSection makes.

// SectionNameIs reports whether a section name is base, alone or followed by a "." and a
// suffix (text, text.hot), as clang matches a section name against a family of names.
func SectionNameIs(name *[]readonly char, base *[]readonly char) bool {
	if len(name) < len(base) || !charsEqual(name[0:len(base)], base) { return false }
	return len(name) == len(base) || name[len(base)] == '.'
}

// impliedFlags returns the flags clang gives a section named `.<name>` whatever flags it is
// given (it adds them to those): text (alone or with a suffix), init and fini are readable and
// executable; rodata and rodata1 readable; data, data1, bss, the init, fini and preinit arrays
// and rodata_relro readable and writable; tdata and tbss (alone or with a suffix) readable,
// writable and thread-local; any other name has none — but thread_vars, Mach-O's
// `__thread_vars` (clang's section of that name, `thread_local_variables`), readable and
// writable: its descriptors are ordinary data, one per thread-local variable.
func impliedFlags(name *[]readonly char) int {
	if SectionNameIs(name, "text") || charsEqual(name, "init") || charsEqual(name, "fini") {
		return SF_READ | SF_EXEC
	}
	if SectionNameIs(name, "tdata") || SectionNameIs(name, "tbss") {
		return SF_READ | SF_WRITE | SF_TLS
	}
	if charsEqual(name, "thread_vars") { return SF_READ | SF_WRITE }
	if SectionNameIs(name, "rodata") || charsEqual(name, "rodata1") { return SF_READ }
	// "rodata_relro" is read-only-after-load data that still bears
	// relocations: writable while the loader applies fixups, then made
	// read-only (Mach-O __DATA_CONST / ELF .data.rel.ro via PT_GNU_RELRO).
	// It carries the same READ|WRITE mask as "data"; the object writers
	// key the relro placement off the NAME, not the flags.
	if SectionNameIs(name, "data") || charsEqual(name, "data1") || SectionNameIs(name, "bss") ||
			SectionNameIs(name, "init_array") || SectionNameIs(name, "fini_array") ||
			SectionNameIs(name, "preinit_array") || charsEqual(name, "rodata_relro") {
		return SF_READ | SF_WRITE
	}
	return 0
}

// isFixedFlagsSection reports whether name is one of the sections clang creates before any
// `.section` (text, data, bss, rodata, rodata_relro as .data.rel.ro, tdata and tbss), so that
// flags beyond the ones its name implies are "changed section flags".
func isFixedFlagsSection(name *[]readonly char) bool {
	return charsEqual(name, "text") || charsEqual(name, "data") || charsEqual(name, "bss") ||
			charsEqual(name, "rodata") || charsEqual(name, "rodata_relro") || charsEqual(name, "tdata") ||
			charsEqual(name, "tbss")
}

// IsZeroFill reports whether a section named name is zero-filled: bss or tbss, alone or with
// a "." suffix (bss.x), the names clang gives a zero-fill (SHT_NOBITS) section.
func IsZeroFill(name *[]readonly char) bool {
	return SectionNameIs(name, "bss") || SectionNameIs(name, "tbss")
}

// SetSection switches the assembler's "current" section to one named `name`, creating it if
// it doesn't yet exist.  flags (SF_*) are added to the ones the name implies (impliedFlags),
// as clang adds them; leaving them out (-1, or 0 for an existing section, as GNU as allows)
// takes the section's own.  Subsequent Emit* calls write into this section.  Sets an error
// and is a no-op if flags is not -1 or a set of SF_* bits, if flags differ from the existing
// section's or (as clang's "changed section flags") add to the fixed flags of text, data, bss,
// rodata, rodata_relro, tdata or tbss, or if they are left out (-1) for a new section whose
// name implies none.
func (a @Assembler) SetSection(name *[]readonly char, flags int) {
	if flags < -1 || flags > (SF_READ | SF_WRITE | SF_EXEC | SF_TLS) {
		a.setError(buf.Concat("invalid flags for section ", name))
		return
	}
	var f int = impliedFlags(name)
	if flags > 0 { f = f | flags }
	var idx int = a.findSection(name)
	if idx >= 0 {
		if flags > 0 && f != a.Sections[idx].Flags {
			a.setError(buf.Concat("changed section flags for ", name))
			return
		}
		a.Current = idx
		return
	}
	if isFixedFlagsSection(name) && f != impliedFlags(name) {
		a.setError(buf.Concat("changed section flags for ", name))
		return
	}
	if flags < 0 && f == 0 {
		a.setError(buf.Concat("no flags given for section ", name))
		return
	}
	var s @Section = newSection(name, f)
	a.appendSection(s)
	a.Current = a.NumSections - 1
}
