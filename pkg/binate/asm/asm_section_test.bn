package "pkg/binate/asm"

import "pkg/builtins/testing"

// Section names and flags (asm_section.bn).  (fail and charsContain are in asm_test.bn.)

// The well-known sections take their flags from their names.
func TestSetSection() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	if a.NumSections != 1 { return fail("expected 1 section") }
	if a.Current != 0 { return fail("expected current = 0") }
	if a.Sections[0].Flags != (SF_READ | SF_EXEC) {
		return fail("expected text section flags = read|exec")
	}

	// Switching to same section doesn't create a new one
	a.SetSection("text", -1)
	if a.NumSections != 1 { return fail("expected still 1 section") }

	// Create data section
	a.SetSection("data", -1)
	if a.NumSections != 2 { return fail("expected 2 sections") }
	if a.Current != 1 { return fail("expected current = 1") }
	if a.Sections[1].Flags != (SF_READ | SF_WRITE) {
		return fail("expected data section flags = read|write")
	}
	return ""
}

// The zero-fill sections are the ones clang gives SHT_NOBITS: bss and tbss, alone or with a
// "." suffix, and no other name.
func TestIsZeroFill() testing.TestResult {
	if !IsZeroFill("bss") || !IsZeroFill("bss.x") || !IsZeroFill("tbss") || !IsZeroFill("tbss.1") {
		return fail("a zero-fill name is not zero-fill")
	}
	if IsZeroFill("bssx") || IsZeroFill("tbssx") || IsZeroFill("data") || IsZeroFill("bs") ||
			IsZeroFill("") || IsZeroFill("xbss") {
		return fail("another name is zero-fill")
	}
	return ""
}

// A name matches a family when it is the family's name alone or followed by a "." suffix.
func TestSectionNameIs() testing.TestResult {
	if !SectionNameIs("text", "text") || !SectionNameIs("text.hot", "text") ||
			!SectionNameIs("text.", "text") {
		return fail("a member of the text family does not match")
	}
	if SectionNameIs("textx", "text") || SectionNameIs("tex", "text") || SectionNameIs("", "text") {
		return fail("another name matches the text family")
	}
	return ""
}

// flagsOf returns the flags of a new section named name made with flags, or -2 when that is
// an error.
func flagsOf(name *[]readonly char, flags int) int {
	var a @Assembler = New(8)
	a.SetSection(name, flags)
	if a.HasError { return -2 }
	return a.Sections[0].Flags
}

// A section's flags are the ones given added to the ones clang implies for its name (as
// llvm-readelf shows for `.section .<name>,""` and `,"a"`), and -1 takes the implied ones.
func TestSectionImpliedFlags() testing.TestResult {
	var rx int = SF_READ | SF_EXEC
	var rw int = SF_READ | SF_WRITE
	if flagsOf("text.hot", SF_READ) != rx || flagsOf("text.hot", -1) != rx ||
			flagsOf("init", 0) != rx || flagsOf("fini", -1) != rx {
		return fail("a code section is not readable and executable")
	}
	if flagsOf("init_array", SF_READ) != rw || flagsOf("init_array.5", 0) != rw ||
			flagsOf("fini_array", -1) != rw || flagsOf("preinit_array", SF_READ) != rw ||
			flagsOf("data.x", 0) != rw || flagsOf("data1", -1) != rw || flagsOf("bss.z", SF_READ) != rw {
		return fail("a data section is not readable and writable")
	}
	if flagsOf("rodata.x", 0) != SF_READ || flagsOf("rodata1", -1) != SF_READ {
		return fail("a read-only data section is not readable")
	}
	if flagsOf("textx", 0) != 0 || flagsOf("note.x", 0) != 0 ||
			flagsOf("init.x", SF_READ) != SF_READ || flagsOf("data2", rw) != rw {
		return fail("a name that implies no flags gained some")
	}
	if flagsOf("note.x", -1) != -2 || flagsOf("foo", -1) != -2 {
		return fail("flags left out for a name that implies none were accepted")
	}
	if flagsOf("text.hot", SF_WRITE) != (rx | SF_WRITE) {
		return fail("given flags are not added to the implied ones")
	}
	return ""
}

// Flags given for a section are never dropped: flags other than an existing section's are an
// error (clang's "changed section flags"), and so are flags beyond the fixed ones of a section
// clang creates up front; giving no flags (-1, or 0 again for an existing section) selects it.
func TestSetSectionFlagChecks() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", SF_READ | SF_WRITE)
	if !a.HasError || !charsContain(a.ErrorMsg, "changed section flags for text") {
		return fail("other flags for text were accepted")
	}
	if flagsOf("data", SF_READ | SF_WRITE) != (SF_READ | SF_WRITE) ||
			flagsOf("rodata", SF_READ) != SF_READ ||
			flagsOf("rodata_relro", SF_READ) != (SF_READ | SF_WRITE) ||
			flagsOf("bss", 0) != (SF_READ | SF_WRITE) {
		return fail("a well-known section made with its own flags was rejected")
	}
	if flagsOf("rodata", SF_READ | SF_WRITE) != -2 || flagsOf("data", SF_EXEC) != -2 {
		return fail("flags beyond a well-known section's were accepted")
	}
	a = New(8)
	a.SetSection("foo", SF_READ)
	a.SetSection("text", -1)
	a.SetSection("foo", SF_READ)
	a.SetSection("text", SF_READ | SF_EXEC)
	a.SetSection("foo", -1)
	a.SetSection("text", 0)
	a.SetSection("foo", 0)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.NumSections != 2 || a.Current != 0 { return fail("foo is not selected again") }
	a.SetSection("foo", SF_READ | SF_WRITE)
	if !a.HasError || !charsContain(a.ErrorMsg, "changed section flags for foo") {
		return fail("changed flags for foo were accepted")
	}
	return ""
}

// Flags other than -1 or a set of SF_* bits are rejected, and so is a thread-local section,
// whose thread-locality no flag can express.
func TestSetSectionRejects() testing.TestResult {
	if flagsOf("foo", 8) != -2 || flagsOf("foo", -2) != -2 || flagsOf("text", 9) != -2 {
		return fail("invalid flags were accepted")
	}
	if flagsOf("foo", SF_READ | SF_WRITE | SF_EXEC) != (SF_READ | SF_WRITE | SF_EXEC) {
		return fail("all three flags were rejected")
	}
	if flagsOf("tdata", -1) != -2 || flagsOf("tbss", SF_READ | SF_WRITE) != -2 ||
			flagsOf("tbss.x", 0) != -2 || flagsOf("tdata.y", SF_READ) != -2 {
		return fail("a thread-local section was accepted")
	}
	if flagsOf("tdatax", SF_READ) != SF_READ { return fail("tdatax is not an ordinary name") }
	return ""
}
