package "pkg/binate/asm"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Absolute symbols and aliases (DefineAbsolute / DefineAlias): a new one is local, one a
// `.global` / `.weak` declared keeps that binding, an already-defined name is an error; an
// alt entry and an absolute symbol start no Mach-O atom.

// A new absolute symbol is local, sectionless, with its value; a declared global one keeps
// its binding; a defined name cannot become one.
func TestDefineAbsolute() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineAbsolute("N", -3)
	var n Symbol = a.Symbols[a.LookupSymbol("N")]
	if !n.Abs || n.AbsValue != -3 || n.Section != -1 || n.Binding != BIND_LOCAL {
		return fail("N not a local absolute symbol of -3")
	}
	a.SetGlobal("G")
	a.DefineAbsolute("G", 7)
	var g Symbol = a.Symbols[a.LookupSymbol("G")]
	if !g.Abs || g.AbsValue != 7 || g.Binding != BIND_GLOBAL { return fail("G lost its binding") }
	a.DefineLabel("lbl")
	a.DefineAbsolute("lbl", 1)
	if !a.HasError { return fail("a label redefined as an absolute symbol") }
	return ""
}

// An alias is defined at its section and offset, as an alt entry when asked; a declared
// weak one keeps its binding; an absolute symbol's name cannot become one.
func TestDefineAlias() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineAlias("A", 0, cast(uint, 8), true)
	var al Symbol = a.Symbols[a.LookupSymbol("A")]
	if al.Section != 0 || al.Offset != 8 || !al.AltEntry || al.Binding != BIND_LOCAL {
		return fail("A not a local alt entry at text+8")
	}
	a.SetWeak("W")
	a.DefineAlias("W", 0, cast(uint, 0), false)
	var w Symbol = a.Symbols[a.LookupSymbol("W")]
	if w.Binding != BIND_WEAK || w.AltEntry || w.Offset != 0 { return fail("W lost its binding") }
	a.DefineAbsolute("N", 1)
	a.DefineAlias("N", 0, cast(uint, 0), false)
	if !a.HasError { return fail("an absolute symbol redefined as an alias") }
	return ""
}

// An alt entry and an absolute symbol start no atom; an alias that is no alt entry does.
func TestStartsAtomAltEntryAbsolute() testing.TestResult {
	var sym Symbol
	sym.Name = "A"
	sym.Section = 0
	if !StartsAtom(sym) { return fail("a plain symbol starts no atom") }
	sym.AltEntry = true
	if StartsAtom(sym) { return fail("an alt entry starts an atom") }
	sym.AltEntry = false
	sym.Abs = true
	sym.Section = -1
	if StartsAtom(sym) { return fail("an absolute symbol starts an atom") }
	return ""
}

// SetVisibility sets a symbol's visibility — a defined one or a declared external — the
// last call winning; an unknown name or visibility is an error.
func TestSetVisibility() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("l")
	a.SetGlobal("ext")
	a.SetVisibility("l", VIS_PROTECTED)
	a.SetVisibility("l", VIS_HIDDEN)
	a.SetVisibility("ext", VIS_INTERNAL)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.Symbols[a.LookupSymbol("l")].Visibility != VIS_HIDDEN { return fail("l not hidden") }
	if a.Symbols[a.LookupSymbol("ext")].Visibility != VIS_INTERNAL { return fail("ext not internal") }
	a.SetVisibility("nope", VIS_HIDDEN)
	if !a.HasError { return fail("a visibility for an unknown symbol accepted") }
	var b @Assembler = New(8)
	b.SetGlobal("g")
	b.SetVisibility("g", 4)
	if !b.HasError { return fail("an unknown visibility accepted") }
	return ""
}

// SetType keeps the stronger of a symbol's types (NOTYPE < OBJECT < FUNC < IFUNC, as clang
// combines `.type`s), whether the symbol is defined or a declared external; SetSize replaces
// the size.  An unknown name or type is an error.
func TestSetTypeAndSize() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.SetGlobal("ext")
	a.SetType("f", SYM_OBJECT)
	a.SetType("f", SYM_FUNC)
	a.SetType("f", SYM_OBJECT)
	a.SetType("f", SYM_NOTYPE)
	a.SetType("ext", SYM_IFUNC)
	a.SetType("ext", SYM_FUNC)
	a.SetSize("f", 16)
	a.SetSize("f", -1)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.Symbols[a.LookupSymbol("f")].Type != SYM_FUNC { return fail("f's type is not FUNC") }
	if a.Symbols[a.LookupSymbol("ext")].Type != SYM_IFUNC { return fail("ext's type is not IFUNC") }
	if a.Symbols[a.LookupSymbol("f")].Size != -1 { return fail("the last size did not win") }
	a.SetType("nope", SYM_FUNC)
	if !a.HasError { return fail("a type for an unknown symbol was accepted") }
	var b @Assembler = New(8)
	b.SetGlobal("g")
	b.SetSize("nope", 4)
	if !b.HasError { return fail("a size for an unknown symbol was accepted") }
	var c @Assembler = New(8)
	c.SetGlobal("g")
	c.SetType("g", SYM_TLS + 1)
	if !c.HasError { return fail("an unknown type was accepted") }
	return ""
}

// A symbol takes the place of its name's first mention (Symbol.Mention): a fixup's label,
// or a name noted, before it is defined, comes before a label defined in between; a mention
// after the symbol exists changes nothing; a section records the mentions before it.
func TestNoteMention() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	a.AddFixup("_h", 0, 0, 8) // `.uint64 _h`, _h defined later
	a.NoteMention("_k")
	a.DefineLabel("_g")
	a.EmitUint64(0)
	a.DefineLabel("_h")
	a.DefineLabel("_k")
	a.NoteMention("_g")
	a.SetSection("data", -1)
	var f int = a.Symbols[a.LookupSymbol("_f")].Mention
	var h int = a.Symbols[a.LookupSymbol("_h")].Mention
	var k int = a.Symbols[a.LookupSymbol("_k")].Mention
	var g int = a.Symbols[a.LookupSymbol("_g")].Mention
	if f != 1 || h != 2 || k != 3 || g != 4 { return fail("the order is not _f _h _k _g") }
	// The `.uint64` after _g made a mapping mark, registered fifth, as clang registers its $d.
	if a.Sections[0].MentionsBefore != 0 || a.Sections[1].MentionsBefore != 5 {
		return fail("MentionsBefore")
	}
	return ""
}

// probeAverage inserts the names prefix<0> .. prefix<n - 1> into a linearly probed
// table of cap slots (a power of two) indexed by symHash's low bits, as SymIndex's
// table is, and returns the average number of slots each insert looked at, times 100.
func probeAverage(prefix *[]readonly char, n int, cap int) int {
	var used @[]bool = make_slice(bool, cap)
	var total int = 0
	for i := 0; i < n; i++ {
		var sb @strings.Builder = strings.NewBuilder()
		sb.Write(prefix)
		stringutils.WriteInt(sb, i)
		var name @[]char = buf.CopyStr(sb.String())
		var k int = cast(int, symHash(name) & cast(uint, cap - 1))
		total = total + 1
		for used[k] {
			k = (k + 1) & (cap - 1)
			total = total + 1
		}
		used[k] = true
	}
	return total * 100 / n
}

// Labels that differ only in their trailing digits spread over the table: at half
// load, an insert looks at about 1.5 slots (unmixed djb2 makes it 5 to 8).
func TestSymHashSpreadsNumberedLabels() testing.TestResult {
	if probeAverage("main.if.then.", 4096, 8192) > 250 { return "numbered block labels cluster" }
	if probeAverage("L", 4096, 8192) > 250 { return "numbered local labels cluster" }
	return ""
}
