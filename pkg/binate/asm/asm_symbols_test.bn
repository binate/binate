package "pkg/binate/asm"

import "pkg/builtins/testing"

// Absolute symbols and aliases (DefineAbsolute / DefineAlias): a new one is local, one a
// `.global` / `.weak` declared keeps that binding, an already-defined name is an error; an
// alt entry and an absolute symbol start no Mach-O atom.

// A new absolute symbol is local, sectionless, with its value; a declared global one keeps
// its binding; a defined name cannot become one.
func TestDefineAbsolute() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineAbsolute("N", -3)
	var n Symbol = a.Symbols[a.LookupSymbol("N")]
	if !n.Abs || n.AbsValue != -3 || n.Section != -1 || n.Binding != BIND_LOCAL {
		return fail("N not a local absolute symbol of -3")
	}
	a.SetGlobal("G")
	a.DefineAbsolute("G", 7)
	var g Symbol = a.Symbols[a.LookupSymbol("G")]
	if !g.Abs || g.AbsValue != 7 || g.Binding != BIND_GLOBAL { return fail("G lost its binding") }
	a.DefineLabel("lbl")
	a.DefineAbsolute("lbl", 1)
	if !a.HasError { return fail("a label redefined as an absolute symbol") }
	return ""
}

// An alias is defined at its section and offset, as an alt entry when asked; a declared
// weak one keeps its binding; an absolute symbol's name cannot become one.
func TestDefineAlias() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineAlias("A", 0, cast(uint, 8), true)
	var al Symbol = a.Symbols[a.LookupSymbol("A")]
	if al.Section != 0 || al.Offset != 8 || !al.AltEntry || al.Binding != BIND_LOCAL {
		return fail("A not a local alt entry at text+8")
	}
	a.SetWeak("W")
	a.DefineAlias("W", 0, cast(uint, 0), false)
	var w Symbol = a.Symbols[a.LookupSymbol("W")]
	if w.Binding != BIND_WEAK || w.AltEntry || w.Offset != 0 { return fail("W lost its binding") }
	a.DefineAbsolute("N", 1)
	a.DefineAlias("N", 0, cast(uint, 0), false)
	if !a.HasError { return fail("an absolute symbol redefined as an alias") }
	return ""
}

// An alt entry and an absolute symbol start no atom; an alias that is no alt entry does.
func TestStartsAtomAltEntryAbsolute() testing.TestResult {
	var sym Symbol
	sym.Name = "A"
	sym.Section = 0
	if !StartsAtom(sym) { return fail("a plain symbol starts no atom") }
	sym.AltEntry = true
	if StartsAtom(sym) { return fail("an alt entry starts an atom") }
	sym.AltEntry = false
	sym.Abs = true
	sym.Section = -1
	if StartsAtom(sym) { return fail("an absolute symbol starts an atom") }
	return ""
}
