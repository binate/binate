package "pkg/binate/asm"

import "pkg/builtins/testing"

// Tests for the name→index symbol map (a.SymIndex) backing findSymbol.
// `fail` lives in asm_test.bn (same package).

// symName builds a distinct 2-char name for index i (base-26: "aa", "ab", …),
// so the growth test can register many collision-free labels without an
// int→string helper.  Valid for i in [0, 676).
func symName(i int) @[]char {
	var s @[]char = make_slice(char, 2)
	s[0] = cast(char, cast(int, 'a') + (i / 26))
	s[1] = cast(char, cast(int, 'a') + (i % 26))
	return s
}

// A fresh assembler resolves every name as absent; adding labels then looking
// them up round-trips to the append index.
func TestFindSymbolBasic() testing.TestResult {
	var a @Assembler = New(8)
	if a.findSymbol("nope") != -1 {
		return fail("fresh assembler must miss")
	}
	a.SetSection("text", -1)
	a.DefineLabel("first")
	a.DefineLabel("second")
	if a.findSymbol("first") != 0 {
		return fail("first must map to index 0")
	}
	if a.findSymbol("second") != 1 {
		return fail("second must map to index 1")
	}
	if a.findSymbol("third") != -1 {
		return fail("unregistered third must miss")
	}
	return ""
}

// A forward reference (SetGlobal on an undefined name creates an entry) is
// filled in by a later DefineLabel WITHOUT adding a second symbol — the index
// must still resolve to that same entry, now defined.  Guards that DefineLabel's
// in-place fill path leaves SymIndex consistent (it adds no new mapping).
func TestFindSymbolForwardRefFillIn() testing.TestResult {
	var a @Assembler = New(8)
	a.SetGlobal("ext") // undefined forward ref → entry at index 0, Section == -1
	if a.findSymbol("ext") != 0 {
		return fail("forward-ref ext must map to index 0")
	}
	if a.Symbols[0].Section != -1 {
		return fail("forward ref must start undefined (Section -1)")
	}
	a.SetSection("text", -1)
	a.EmitUint32(0) // advance the offset so the fill-in offset is nonzero
	a.DefineLabel("ext")
	if a.NumSymbols != 1 {
		return fail("DefineLabel of a forward ref must not add a second symbol")
	}
	if a.findSymbol("ext") != 0 {
		return fail("ext must still map to index 0 after fill-in")
	}
	if a.Symbols[0].Section != 0 {
		return fail("ext must be defined in the text section after fill-in")
	}
	return ""
}

// Growing past the initial Symbols capacity (INITIAL_SYMBOLS == 64) AND the
// map's load threshold must keep every name resolvable.  The map keys are raw
// *[]readonly char borrows of each symbol's Name; the Symbols array's growth
// copies the Symbol structs (RefInc'ing each Name's refcount-shared backing), so
// the borrowed keys must not dangle, and the map's own rehash-on-grow must
// preserve every mapping.  300 labels force both an array regrow and a table
// resize.
func TestFindSymbolSurvivesGrowth() testing.TestResult {
	var a @Assembler = New(8)
	var n int = 300
	for i := 0; i < n; i++ {
		a.addSymbol(symName(i), -1, 0, BIND_GLOBAL)
	}
	if a.NumSymbols != n {
		return fail("every label must be stored")
	}
	for i := 0; i < n; i++ {
		if a.findSymbol(symName(i)) != i {
			return fail("every name must resolve to its append index after growth")
		}
	}
	if a.findSymbol(symName(n)) != -1 {
		return fail("an unregistered name must still miss after growth")
	}
	return ""
}
