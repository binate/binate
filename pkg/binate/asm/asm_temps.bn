package "pkg/binate/asm"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Temporary labels: labels an object's symbol table does not list unless a relocation
// must name them.  Which names are temporary depends on the object format — Mach-O's
// private prefix `L`, ELF's `.L` — and the names the assembler generates for itself
// (GeneratedLabelName) are temporary on every format.  The object writer makes a reference
// to a temporary against what contains it: on Mach-O its atom; on ELF its section's symbol
// (SectionSymbol), except where clang keeps the label (a GOT reference, and on arm32
// anything but an absolute word), which then lists it.

// IsGeneratedLabel reports whether name is one GeneratedLabelName made; see asm.bni.
func IsGeneratedLabel(name *[]readonly char) bool {
	return len(name) > 1 && name[0] == 'L' && name[1] == cast(char, 2)
}

// IsTemporaryLabel reports whether name is a temporary label in an object of format.
func IsTemporaryLabel(name *[]readonly char, format int) bool {
	if IsGeneratedLabel(name) { return true }
	if format == OBJ_ELF { return len(name) > 1 && name[0] == '.' && name[1] == 'L' }
	return len(name) > 0 && name[0] == 'L'
}

// GeneratedLabelName returns the name of the k-th label the assembler generates for base
// (a numeric local label's number, say); see asm.bni.
func GeneratedLabelName(base *[]readonly char, k int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('L')
	b.WriteByte(cast(char, 2))
	b.Write(base)
	b.WriteByte(cast(char, 2))
	stringutils.WriteInt(b, k)
	return buf.CopyStr(b.String())
}

// LabelForMessage returns name as a diagnostic shows it; see asm.bni.
func LabelForMessage(name *[]readonly char) @[]char {
	if !IsGeneratedLabel(name) { return buf.CopyStr(name) }
	var sep int = 2
	for sep < len(name) && name[sep] != cast(char, 2) { sep = sep + 1 }
	if sep >= len(name) { return buf.CopyStr(name) }
	var b @strings.Builder = strings.NewBuilder()
	if sep == 3 && name[2] == '.' {
		b.Write("location ")
	} else {
		b.Write("local label ")
	}
	b.Write(name[2:sep])
	b.Write(" (definition ")
	b.Write(name[sep + 1:len(name)])
	b.Write(")")
	return buf.CopyStr(b.String())
}

// StartsAtom reports whether sym begins a Mach-O atom: any symbol but a local
// temporary label (a global or weak `L`-named symbol is emitted, so it starts one).
func StartsAtom(sym Symbol) bool {
	return !IsTemporaryLabel(sym.Name, OBJ_MACHO) || sym.Binding != BIND_LOCAL
}

// CheckTemporaryLabels checks the temporary labels; see asm.bni.
func (a @Assembler) CheckTemporaryLabels() bool {
	for i := 0; i < a.NumSymbols; i++ {
		var sym Symbol = a.Symbols[i]
		if sym.Binding != BIND_LOCAL && IsTemporaryLabel(sym.Name, a.ObjFormat) {
			a.setError(
					buf.Concat(buf.Concat("a temporary label cannot be global or weak: '", sym.Name), "'"))
			return false
		}
	}
	for si := 0; si < a.NumSections; si++ {
		var sec @Section = a.Sections[si]
		for fi := 0; fi < sec.NumFixups; fi++ {
			var f Fixup = sec.Fixups[fi]
			if f.Kind < 0 || !IsTemporaryLabel(f.Label, a.ObjFormat) { continue }
			var ti int = a.findSymbol(f.Label)
			if ti < 0 || a.Symbols[ti].Section < 0 {
				a.setError(
						buf.Concat(buf.Concat("undefined temporary label '", LabelForMessage(f.Label)), "'"))
				return false
			}
		}
	}
	return true
}

// SectionSymbol returns section si's section symbol; see asm.bni.  Its name — a byte 2,
// `section`, a byte 2 and si — is internal: no source text can spell it, and an ELF
// section symbol carries no name.
func (a @Assembler) SectionSymbol(si int) int {
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte(cast(char, 2))
	b.Write("section")
	b.WriteByte(cast(char, 2))
	stringutils.WriteInt(b, si)
	var name @[]char = buf.CopyStr(b.String())
	var idx int = a.findSymbol(name)
	if idx >= 0 { return idx }
	idx = a.DefineLocalAt(name, si, 0)
	if idx >= 0 { a.Symbols[idx].SectionSym = true }
	return idx
}
