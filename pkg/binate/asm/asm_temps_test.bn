package "pkg/binate/asm"

import "pkg/builtins/testing"

// Tests for the temporary labels (asm_temps.bn): which names are temporary per object
// format, the generated names, section symbols, and CheckTemporaryLabels' checks.

// A name's temporariness follows the object format: `L` on Mach-O (and OBJ_UNKNOWN),
// `.L` on ELF, and a generated name on every format.
func TestIsTemporaryLabelPerFormat() testing.TestResult {
	if !IsTemporaryLabel("Lx", OBJ_MACHO) || !IsTemporaryLabel("Lx", OBJ_UNKNOWN) {
		return fail("Lx is a Mach-O temporary")
	}
	if IsTemporaryLabel(".Lx", OBJ_MACHO) { return fail(".Lx is an ordinary Mach-O symbol") }
	if !IsTemporaryLabel(".Lx", OBJ_ELF) { return fail(".Lx is an ELF temporary") }
	if IsTemporaryLabel("Lx", OBJ_ELF) { return fail("Lx is an ordinary ELF symbol") }
	if IsTemporaryLabel(".x", OBJ_ELF) || IsTemporaryLabel("x", OBJ_ELF) {
		return fail("only .L names are ELF temporaries")
	}
	if IsTemporaryLabel(".L", OBJ_MACHO) || IsTemporaryLabel("", OBJ_ELF) {
		return fail("the empty name and a Mach-O .L are not temporaries")
	}
	var g @[]char = GeneratedLabelName("1", 2)
	if !IsTemporaryLabel(g, OBJ_ELF) || !IsTemporaryLabel(g, OBJ_MACHO) ||
			!IsTemporaryLabel(g, OBJ_UNKNOWN) {
		return fail("a generated name is temporary on every format")
	}
	return ""
}

// GeneratedLabelName is `L`, a byte 2, the base, a byte 2 and k; IsGeneratedLabel
// recognizes exactly the `L`-byte-2 start.
func TestGeneratedLabelName() testing.TestResult {
	var g @[]char = GeneratedLabelName("12", 3)
	if len(g) != 6 || g[0] != 'L' || g[1] != cast(char, 2) || g[2] != '1' || g[3] != '2' ||
			g[4] != cast(char, 2) || g[5] != '3' {
		return fail("wrong generated name")
	}
	if !IsGeneratedLabel(g) { return fail("a generated name is not recognized") }
	if IsGeneratedLabel("L2") || IsGeneratedLabel("L") || IsGeneratedLabel(".L") {
		return fail("a source name taken for a generated one")
	}
	return ""
}

// tempsAsm returns an assembler with section text holding `f` at 0 and the given label at
// 8, and a data section with a word-absolute fixup against target+4.
func tempsAsm(label *[]readonly char, target *[]readonly char) @Assembler {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.EmitUint64(0)
	a.DefineLabel(label)
	a.EmitUint32(0)
	a.SetSection("data", -1)
	a.AddFixup(target, 0, 4, 8)
	a.EmitUint64(0)
	return a
}

// SectionSymbol defines section si's symbol once — local, at the section's start, flagged
// SectionSym — and returns the same index after.
func TestSectionSymbol() testing.TestResult {
	var a @Assembler = tempsAsm(".Lx", ".Lx")
	var ss int = a.SectionSymbol(0)
	if ss < 0 || !a.Symbols[ss].SectionSym { return fail("no section symbol") }
	if a.Symbols[ss].Section != 0 || a.Symbols[ss].Offset != 0 {
		return fail("the section symbol is not text's start")
	}
	if a.Symbols[ss].Binding != BIND_LOCAL { return fail("the section symbol is not local") }
	if a.SectionSymbol(0) != ss { return fail("a second section symbol for text") }
	if a.SectionSymbol(1) == ss { return fail("data shares text's section symbol") }
	return ""
}

// CheckTemporaryLabels only checks: every fixup keeps its label and addend.
func TestCheckTemporaryLabelsKeepsFixups() testing.TestResult {
	var a @Assembler = tempsAsm(".Lx", ".Lx")
	a.ObjFormat = OBJ_ELF
	if !a.CheckTemporaryLabels() { return fail(a.ErrorMsg) }
	var f Fixup = a.Sections[1].Fixups[0]
	if !charsEqual(f.Label, ".Lx") || f.Addend != 4 { return fail("a reference was changed") }
	return ""
}

// A diagnostic shows a generated label as the numeric label instance or `.` location it
// is, and any other name unchanged.
func TestLabelForMessage() testing.TestResult {
	if !charsEqual(LabelForMessage(GeneratedLabelName("1", 2)), "local label 1 (definition 2)") {
		return fail("a generated label shown raw")
	}
	if !charsEqual(LabelForMessage(GeneratedLabelName(".", 1)), "location . (definition 1)") {
		return fail("a generated `.` label not shown as a location")
	}
	if !charsEqual(LabelForMessage(GeneratedLabelName(".5", 1)), "local label .5 (definition 1)") {
		return fail("a longer base taken for `.`")
	}
	if !charsEqual(LabelForMessage(GeneratedLabelName("=", 3)), "literal pool entry 3") {
		return fail("a literal-pool entry's label not shown as one")
	}
	if !charsEqual(LabelForMessage(".Lx"), ".Lx") { return fail("a source name changed") }
	return ""
}

// A reference to a temporary never defined is an error, as is a global or weak one
// (clang: "non-local symbol required"); a reference to an undefined ordinary symbol is not
// this check's to reject (Finalize takes it for an external when declared `.global`).
func TestCheckTemporaryLabelsRejects() testing.TestResult {
	var a @Assembler = tempsAsm(".Lx", ".Ly")
	a.ObjFormat = OBJ_ELF
	if a.CheckTemporaryLabels() || !a.HasError { return fail("an undefined .Ly accepted on ELF") }
	a = tempsAsm("Lx", "Ly")
	a.ObjFormat = OBJ_MACHO
	if a.CheckTemporaryLabels() { return fail("an undefined Ly accepted on Mach-O") }
	a = tempsAsm("x", GeneratedLabelName("1", 1))
	a.ObjFormat = OBJ_ELF
	if a.CheckTemporaryLabels() { return fail("an undefined generated label accepted") }
	a = tempsAsm(".Lx", ".Lx")
	a.SetGlobal(".Lx")
	a.ObjFormat = OBJ_ELF
	if a.CheckTemporaryLabels() { return fail("a global .Lx accepted on ELF") }
	a = tempsAsm("Lx", "Lx")
	a.SetWeak("Lx")
	a.ObjFormat = OBJ_MACHO
	if a.CheckTemporaryLabels() { return fail("a weak Lx accepted on Mach-O") }
	a = tempsAsm(".Lx", "ext")
	a.ObjFormat = OBJ_ELF
	if !a.CheckTemporaryLabels() { return fail("an undefined external rejected") }
	return ""
}
