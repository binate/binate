package "pkg/binate/asm"

import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

func TestNew() testing.TestResult {
	var a @Assembler = New(8)
	if a.WordSize != 8 { return fail("expected word size 8") }
	if a.NumSections != 0 { return fail("expected 0 sections") }
	if a.NumSymbols != 0 { return fail("expected 0 symbols") }
	if a.Current != -1 { return fail("expected current = -1") }
	if a.HasError { return fail("expected no error") }
	return ""
}

func TestSetSection() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	if a.NumSections != 1 { return fail("expected 1 section") }
	if a.Current != 0 { return fail("expected current = 0") }
	if a.Sections[0].Flags != (SF_READ | SF_EXEC) {
		return fail("expected text section flags = read|exec")
	}

	// Switching to same section doesn't create a new one
	a.SetSection("text", -1)
	if a.NumSections != 1 { return fail("expected still 1 section") }

	// Create data section
	a.SetSection("data", -1)
	if a.NumSections != 2 { return fail("expected 2 sections") }
	if a.Current != 1 { return fail("expected current = 1") }
	if a.Sections[1].Flags != (SF_READ | SF_WRITE) {
		return fail("expected data section flags = read|write")
	}
	return ""
}

func TestDefineLabel() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.EmitUint32(0) // 4 bytes of padding
	a.DefineLabel("my_label")
	if a.NumSymbols != 1 { return fail("expected 1 symbol") }
	if a.Symbols[0].Section != 0 { return fail("expected section 0") }
	if a.Symbols[0].Offset != 4 { return fail("expected offset 4") }
	if a.Symbols[0].Binding != BIND_LOCAL { return fail("expected local binding") }
	return ""
}

func TestSetGlobal() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("my_func")
	a.SetGlobal("my_func")
	if a.Symbols[0].Binding != BIND_GLOBAL { return fail("expected global binding") }

	// SetGlobal on undefined symbol creates it
	a.SetGlobal("external")
	if a.NumSymbols != 2 { return fail("expected 2 symbols") }
	if a.Symbols[1].Section != -1 { return fail("expected section -1 for external") }
	if a.Symbols[1].Binding != BIND_GLOBAL { return fail("expected global binding") }
	return ""
}

// SetGlobal must NOT demote a symbol that's already BIND_WEAK to
// BIND_GLOBAL — weak symbols are already linker-visible, and the
// "ensure visible" semantics of SetGlobal must preserve the weak
// linkage so cross-TU duplicates dedupe at link time.  Pre-fix,
// emitFuncValueVtables' `a.SetGlobal(shimLabel)` (called after
// emitFuncValueShims' `a.SetWeak(shimLabel)`) silently demoted the
// shim, producing `duplicate symbol <mangled-fn>__shim` link
// errors when two .o files (e.g., bni.o + vm.o) both emitted the
// same shim under builder-comp_native_aa64-comp_native_aa64.
func TestSetGlobalPreservesWeak() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("weak_sym")
	a.SetWeak("weak_sym")
	if a.Symbols[0].Binding != BIND_WEAK {
		return fail("setup: expected weak binding after SetWeak")
	}
	a.SetGlobal("weak_sym")
	if a.Symbols[0].Binding != BIND_WEAK {
		return fail("SetGlobal should not demote a weak symbol to global")
	}
	return ""
}

func TestCurrentOffset() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	if a.CurrentOffset() != 0 { return fail("expected offset 0") }
	a.EmitUint32(0)
	if a.CurrentOffset() != 4 { return fail("expected offset 4") }
	a.EmitUint32(0)
	if a.CurrentOffset() != 8 { return fail("expected offset 8") }
	return ""
}

func TestDuplicateLabel() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("dup")
	a.DefineLabel("dup")
	if !a.HasError { return fail("expected error on duplicate label") }
	return ""
}

// bssFresh returns an assembler positioned in the zero-fill section bss.
func bssFresh() @Assembler {
	var a @Assembler = New(8)
	a.SetSection("bss", -1)
	return a
}

// The zero-fill section bss (stored with no file contents) takes zero bytes from any
// emitter but rejects non-zero data, a string's characters, a non-zero fill, and a
// relocated value, which the object writers would otherwise silently drop.
func TestZeroFillSectionRejectsContent() testing.TestResult {
	var a @Assembler = bssFresh()
	a.EmitUint8(0)
	a.EmitUint64(0)
	a.Zero(5)
	a.Align(16)
	a.Fill(3, 0)
	a.EmitAsciz("")
	var zeros @[]uint8 = make_slice(uint8, 4)
	a.EmitBytes(zeros)
	if a.HasError { return fail(a.ErrorMsg) }
	if a.Sections[0].Len != 16 + 3 + 1 + 4 { return fail("zero content must still be laid out") }
	a = bssFresh()
	a.EmitUint32(1)
	if !a.HasError { return fail("a non-zero word in bss was accepted") }
	a = bssFresh()
	a.EmitUint8(0x80)
	if !a.HasError { return fail("a non-zero byte in bss was accepted") }
	a = bssFresh()
	a.Fill(2, 7)
	if !a.HasError { return fail("a non-zero fill in bss was accepted") }
	a = bssFresh()
	a.EmitUint8(0)
	a.AlignFill(8, 0xFF)
	if !a.HasError { return fail("non-zero alignment padding in bss was accepted") }
	a = bssFresh()
	a.EmitAsciz("x")
	if !a.HasError { return fail("a string in bss was accepted") }
	a = bssFresh()
	a.EmitAddr("sym")
	if !a.HasError { return fail("a relocated address in bss was accepted") }
	return ""
}

// An unresolved reference names the symbol, and a duplicate label names the label.
func TestErrorMessagesNameTheSymbol() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("data", -1)
	a.EmitAddr("nosuch")
	if a.Finalize() { return fail("an undefined, undeclared symbol was accepted") }
	if !charsContain(a.ErrorMsg, "nosuch") { return fail(a.ErrorMsg) }
	a = New(8)
	a.SetSection("text", -1)
	a.DefineLabel("twice")
	a.DefineLabel("twice")
	if !a.HasError || !charsContain(a.ErrorMsg, "twice") { return fail("duplicate label message") }
	return ""
}

// charsContain reports whether s contains sub.
func charsContain(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if charsEqual(s[i:i + len(sub)], sub) { return true }
	}
	return false
}

// A data fixup kind patches 1, 2, 4 or 8 bytes (DataFixupSize), and AddFixup takes it only
// with that size.
func TestDataFixupSize() testing.TestResult {
	if DataFixupSize(FIX_DATA_ABS8) != 1 || DataFixupSize(FIX_DATA_PCREL8) != 1 {
		return fail("8-bit kinds")
	}
	if DataFixupSize(FIX_DATA_ABS16) != 2 || DataFixupSize(FIX_DATA_PCREL16) != 2 {
		return fail("16-bit kinds")
	}
	if DataFixupSize(FIX_DATA_ABS32) != 4 || DataFixupSize(FIX_DATA_ABS32S) != 4 ||
			DataFixupSize(FIX_DATA_PCREL32) != 4 {
		return fail("32-bit kinds")
	}
	if DataFixupSize(FIX_DATA_ABS64) != 8 || DataFixupSize(FIX_DATA_PCREL64) != 8 {
		return fail("64-bit kinds")
	}
	if DataFixupSize(0) != 0 || DataFixupSize(100) != 0 {
		return fail("a non-data kind has a data size")
	}
	var a @Assembler = New(8)
	a.SetSection("data", -1)
	a.AddFixup("ext", FIX_DATA_ABS16, 0, 2)
	if a.HasError { return fail(a.ErrorMsg) }
	a.AddFixup("ext", FIX_DATA_ABS16, 0, 4)
	if !a.HasError { return fail("a 2-byte kind with size 4 accepted") }
	return ""
}

// A difference fixup (AddDiffFixup) becomes a relocation subtracting its Sub's symbol
// (HasSub, SubSymbol); an undefined subtrahend fails Finalize, and an undefined temporary one
// CheckTemporaryLabels; only an absolute data kind is taken.  A plain fixup's relocation
// has no subtrahend.
func TestAddDiffFixup() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("data", -1)
	a.DefineLabel("d")
	a.SetGlobal("ext")
	a.AddDiffFixup("ext", "d", FIX_DATA_ABS32, 4, 4)
	a.Zero(4)
	a.AddFixup("ext", FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	if !a.Finalize() { return fail(a.ErrorMsg) }
	if a.NumRelocs != 2 || !a.Relocs[0].HasSub || a.Relocs[0].SubSymbol != a.LookupSymbol("d") ||
			a.Relocs[0].Addend != 4 {
		return fail("the difference's relocation does not subtract d")
	}
	if a.Relocs[1].HasSub { return fail("a plain relocation has a subtrahend") }
	a = New(8)
	a.SetSection("data", -1)
	a.SetGlobal("ext")
	a.AddDiffFixup("ext", "nowhere", FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	if a.Finalize() { return fail("an undefined subtrahend accepted") }
	a = New(8)
	a.ObjFormat = OBJ_MACHO
	a.SetSection("data", -1)
	a.SetGlobal("_ext")
	a.AddDiffFixup("_ext", "Lmissing", FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	if a.CheckTemporaryLabels() { return fail("an undefined temporary subtrahend accepted") }
	a = New(8)
	a.SetSection("data", -1)
	a.AddDiffFixup("ext", "d", FIX_DATA_PCREL32, 0, 4)
	if !a.HasError { return fail("a PC-relative kind taken for a difference") }
	return ""
}
