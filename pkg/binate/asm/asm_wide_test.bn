package "pkg/binate/asm"

import "pkg/builtins/testing"

// Lengths and offsets past a 32-bit host's int and uint (2^31, 2^32): a zero-fill section's
// length is an int64 and a symbol's offset a uint64, so a 32-bit host lays out a large bss
// exactly as a 64-bit one does.

// A bss past 4 GiB (on a 64-bit target) counts every zero byte; a label after them, and the
// position there, lie past 2^32.
func TestZeroFillPast4GiB() testing.TestResult {
	var a @Assembler = bssFresh()
	a.DefineLabel("lo")
	a.Zero(0x100000000)
	a.EmitUint64(0)
	a.DefineLabel("hi")
	if a.HasError { return fail(a.ErrorMsg) }
	if a.Sections[0].Len != 0x100000008 { return fail("bss's length is not 2^32 + 8") }
	if a.CurrentOffset() != 0x100000008 { return fail("the position is not 2^32 + 8") }
	if a.Symbols[a.LookupSymbol("hi")].Offset != 0x100000008 { return fail("hi is not at 2^32 + 8") }
	if len(a.Sections[0].Data) != 0 { return fail("bss must hold no bytes") }
	return ""
}

// A 32-bit target's bss past 2 GiB, within its 4 GiB, is accepted, and alignment padding is
// computed from the whole length; a length past the int64 range is an error, not a wrapped
// one.
func TestZeroFillPast2GiBAndInt64Limit() testing.TestResult {
	var a @Assembler = New(4)
	a.SetSection("bss", -1)
	a.Zero(0xC0000001)
	a.Align(8)
	a.DefineLabel("x")
	if a.HasError { return fail(a.ErrorMsg) }
	if a.Sections[0].Len != 0xC0000008 { return fail("bss's length is not 3 GiB + 8") }
	if a.Symbols[a.LookupSymbol("x")].Offset != 0xC0000008 { return fail("x is not at 3 GiB + 8") }
	var b @Assembler = bssFresh()
	b.Zero(0x7FFFFFFFFFFFFFFF)
	if b.HasError { return fail(b.ErrorMsg) }
	b.Zero(1)
	if !b.HasError { return fail("a bss past the int64 range was accepted") }
	return ""
}

// Mach-O atoms past 4 GiB: the atom holding a byte there starts at the symbol before it.
func TestAtomStartPast4GiB() testing.TestResult {
	var a @Assembler = bssFresh()
	a.DefineLabel("_a")
	a.Zero(0x100000000)
	a.DefineLabel("_b")
	a.Zero(16)
	var starts @[]int = a.AtomStarts(0)
	if len(starts) != 2 || a.Symbols[starts[1]].Offset != 0x100000000 {
		return fail("the atom starts are not at 0 and 2^32")
	}
	if a.AtomStartAt(starts, 0xFFFFFFFF) != 0 || a.AtomStartAt(starts, 0x100000008) != 0x100000000 {
		return fail("AtomStartAt past 2^32")
	}
	if a.AtomOf(starts, a.Symbols[a.LookupSymbol("_b")]) != a.LookupSymbol("_b") {
		return fail("_b does not start its own atom")
	}
	return ""
}

// A section that holds its bytes keeps its length within the host's int: a count that would
// take it past (Zero, Fill), or on a 32-bit host a Zero count past 2^31, is an error, not a
// wrapped length, and emits nothing.  A negative count is an error in every section.
func TestHeldZeroCountLimits() testing.TestResult {
	var a @Assembler = New(8)
	a.SetSection("data", -1)
	a.Zero(-1)
	if !a.HasError { return fail("a negative zero count was accepted") }
	var b @Assembler = bssFresh()
	b.Zero(-1)
	if !b.HasError { return fail("a negative zero count in bss was accepted") }
	var limit int = cast(int, ~cast(uint, 0) >> 1)
	var d @Assembler = New(8)
	d.SetSection("data", -1)
	d.EmitUint8(1)
	d.Zero(cast(int64, limit))
	if !d.HasError || d.Sections[0].Len != 1 {
		return fail("a held section past the host's int was accepted")
	}
	var f @Assembler = New(8)
	f.SetSection("data", -1)
	f.EmitUint8(1)
	f.Fill(limit, 1)
	if !f.HasError || f.Sections[0].Len != 1 { return fail("a fill past the host's int was accepted") }
	if sizeof(int) != 4 { return "" }
	var c @Assembler = New(8)
	c.SetSection("data", -1)
	c.Zero(0x80000000)
	if !c.HasError { return fail("2 GiB of held zero bytes on a 32-bit host was accepted") }
	if c.Sections[0].Len != 0 { return fail("a rejected zero count emitted bytes") }
	return ""
}
