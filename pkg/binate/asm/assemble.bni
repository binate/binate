// Package assemble is the reusable driver over the Binate assembler: it runs the
// whole text-to-object pipeline (parse -> per-arch fixup resolve -> finalize ->
// object write) for one `.s` file.  cmd/bnas is a thin CLI over it, and bnc
// embeds it to assemble its `.s` runtime files in-process (no subprocess).
package "pkg/binate/asm/assemble"

// AssembleFile assembles the `.s` file at inputPath and writes the object to
// outputPath.  archName selects the target — "aarch64"/"arm64" (Mach-O),
// "arm32"/"arm" (ELF32), "x64"/"x86_64" (ELF64) — or "" to take the arch from
// the file's own `.arch` directive.  Soft-float is assumed for arm32 (no VFP
// `.ARM.attributes`), matching the bare-metal runtime.
//
// Returns (true, "") on success, or (false, message) on any error.  It never
// exits the process: an embedding caller (bnc) handles failures itself, and the
// CLI (bnas) prints the message and exits.
func AssembleFile(inputPath *[]readonly char, outputPath *[]readonly char,
		archName *[]readonly char) (bool, @[]char)
