package "pkg/binate/asm/assemble"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/asm/parse"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"

// AssembleFile runs the full parse -> resolve-fixups -> finalize -> write
// pipeline for one `.s` file.  archName ("" defers to the file's `.arch`) picks
// the instruction set; osName picks the object-file format (linux -> ELF,
// darwin -> Mach-O; "" keeps the per-arch host default).  Returns (ok, errMsg);
// never exits the process.
func AssembleFile(inputPath *[]readonly char, outputPath *[]readonly char,
		archName *[]readonly char, osName *[]readonly char) (bool, @[]char) {
	var a @asm.Assembler = asm.New(8)
	var p @parse.Parser = parse.NewParser(a, inputPath)

	// An explicit arch name overrides the file's `.arch`; "" defers to it.
	if len(archName) > 0 {
		var arch int = 0
		var ok bool = false
		arch, ok = archToConst(archName)
		if !ok {
			return false, buf.CopyStr("unknown architecture")
		}
		p.Arch = arch
	}

	p.ParseFile(inputPath)
	if p.HasError {
		return false, buf.CopyStr(p.ErrorMsg)
	}
	if p.Arch == parse.ARCH_UNKNOWN {
		return false, buf.CopyStr("no architecture specified (use .arch directive or -arch flag)")
	}

	// Per-arch fixup resolution (same-section branches patched in place;
	// everything else left for the object writer to emit as a relocation).
	if p.Arch == parse.ARCH_AARCH64 {
		aarch64.ResolveFixups(a)
	}
	if p.Arch == parse.ARCH_ARM32 {
		arm32.ResolveFixups(a)
	}
	if p.Arch == parse.ARCH_X64 {
		x64.ResolveFixups(a)
	}

	if !a.Finalize() || a.HasError {
		return false, buf.CopyStr("assembly failed")
	}

	// Object write.  The object *format* follows the OS: linux -> ELF, darwin ->
	// Mach-O.  osName == "" keeps the per-arch host default (aarch64 -> Mach-O on
	// the darwin dev host; arm32/x64 -> ELF) so existing callers are unchanged; an
	// explicit "linux"/"darwin" overrides it (e.g. bnas -target linux-aarch64,
	// whose ELF-aarch64 object bnld links).  arm32 emits ELF32 (EM_ARM), soft-float
	// (no VFP `.ARM.attributes`); x64/aarch64 emit ELF64 (EM_X86_64 / EM_AARCH64).
	useMacho, oerr := useMachoFor(p.Arch, osName)
	if len(oerr) != 0 {
		return false, oerr
	}
	var writeOk bool = false
	if p.Arch == parse.ARCH_AARCH64 {
		if useMacho {
			writeOk = macho.WriteARM64(a, outputPath)
		} else {
			writeOk = elf.WriteAArch64(a, outputPath)
		}
	}
	if p.Arch == parse.ARCH_ARM32 {
		if useMacho {
			return false, buf.CopyStr("no Mach-O writer for arm32")
		}
		writeOk = elf.WriteARM32(a, outputPath, false)
	}
	if p.Arch == parse.ARCH_X64 {
		if useMacho {
			writeOk = macho.WriteX86_64(a, outputPath)
		} else {
			writeOk = elf.WriteX86_64(a, outputPath)
		}
	}
	if !writeOk {
		return false, buf.CopyStr("failed to write output file")
	}
	return true, ""
}

// useMachoFor decides the object-file format for (arch, osName): osName == ""
// keeps the per-arch host default (aarch64 -> Mach-O, else ELF); "darwin"/"macos"
// forces Mach-O; "linux" forces ELF.  Returns (useMacho, "") or (false, errMsg)
// for an unrecognized OS.
func useMachoFor(arch int, osName *[]readonly char) (bool, @[]char) {
	if len(osName) == 0 {
		return arch == parse.ARCH_AARCH64, ""
	}
	if charsEqual(osName, "darwin") || charsEqual(osName, "macos") {
		return true, ""
	}
	if charsEqual(osName, "linux") {
		return false, ""
	}
	return false, buf.Concat("unknown os: ", osName)
}

// archToConst maps an -arch CLI name to a parse.ARCH_* constant.  Returns
// (ARCH_*, true) on a match, (parse.ARCH_UNKNOWN, false) otherwise.
func archToConst(name *[]readonly char) (int, bool) {
	if charsEqual(name, "aarch64") || charsEqual(name, "arm64") {
		return parse.ARCH_AARCH64, true
	}
	if charsEqual(name, "arm32") || charsEqual(name, "arm") {
		return parse.ARCH_ARM32, true
	}
	if charsEqual(name, "x64") || charsEqual(name, "x86_64") {
		return parse.ARCH_X64, true
	}
	return parse.ARCH_UNKNOWN, false
}

// charsEqual returns true if two char slices have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}
