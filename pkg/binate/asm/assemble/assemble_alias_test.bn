package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// References to aliases in the written objects, as clang writes them (`clang -c -target
// x86_64-apple-macos` / `x86_64-linux-gnu`, llvm-objdump -r): a listed alias is the
// relocation's symbol on Mach-O and section-relative on ELF (a local symbol); a temporary
// alias moves to its atom's symbol on Mach-O; a use before an alias's redefinition keeps the
// old definition; a branch to a local alias in its own section is resolved in place.
// (tlsRead / tlsU / elfShdr / elfSectionIndex / machoSection / machoRelocInfo / machoSymbolIs
// are in assemble_tls_test.bn and assemble_tlv_test.bn.)

// aliasProgram's text holds five `lea rax, [rip + …]` (rel32 fields at 3, 10, 17, 24, 31),
// a `jmp` to a local alias of _f + 1, and a `.uint64` of an alias (at 40).
var aliasProgram *[]readonly char = ".arch x64\n.section data\n.global _d\n_d: .uint32 0\n"
		".uint32 0\n.uint32 0\n_e: .uint32 0\n_a2 = _d + 3\nLa3 = _d + 5\n_z = _a2\n"
		".section text\n.global _f\n_f: lea rax, [rip + _a2]\nlea rax, [rip + La3]\n"
		"lea rax, [rip + _z]\n_r = _d\nlea rax, [rip + _r]\n_r = _e\nlea rax, [rip + _r]\n"
		"_t = _f + 1\njmp _t\n.uint64 _a2\n"

// aliasMachoReloc appends to e a failure unless the Mach-O object b's text has a relocation at
// addr of type rtype against sym, its field (nbytes long) holding field.
func aliasMachoReloc(e @[]char, b @[]uint8, addr int, rtype int, sym *[]readonly char, field int,
		nbytes int) @[]char {
	var text int = machoSection(b, "__text")
	var info int = machoRelocInfo(b, text, addr)
	var data int = tlsU(b, text + 48, 4)
	var got int = tlsU(b, data + addr, nbytes)
	if nbytes == 4 && got >= 0x80000000 { got = got - 0x100000000 }
	if info >= 0 && (info >> 28) == rtype && machoSymbolIs(b, info & 0xFFFFFF, sym) && got == field {
		return e
	}
	return buf.Concat(e, buf.Concat(sym, " (Mach-O); "))
}

// elfRela returns relocation k of the 64-bit ELF object b's .rela.text: its offset, type,
// symbol's section index and addend.
func elfRela(b @[]uint8, k int) (int, int, int, int) {
	var sh int = elfShdr(b, true, elfSectionIndex(b, true, ".rela.text"))
	var r int = tlsU(b, sh + 24, 8) + k * 24
	var info int = tlsU(b, r + 8, 8)
	var symsh int = elfShdr(b, true, tlsU(b, sh + 40, 4))
	var s int = tlsU(b, symsh + 24, 8) + (info >> 32) * 24
	return tlsU(b, r, 8), info & 0xFFFFFFFF, tlsU(b, s + 6, 2), tlsU(b, r + 16, 8)
}

// The x86-64 alias references on Mach-O and ELF, as clang writes them.
func TestAssembleFileAliasReferences() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/alias.s")
	if !asmWrite(src, aliasProgram) { return fail("cannot write the test source") }
	var obj @[]char = buf.Concat(dir, "/alias.o")
	ok, msg := AssembleFile(src, obj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var e @[]char = ""
	// SIGNED = 1, UNSIGNED = 0; the jmp at 35 has no relocation.
	e = aliasMachoReloc(e, b, 3, 1, "_a2", 0, 4)
	e = aliasMachoReloc(e, b, 10, 1, "_d", 5, 4)
	e = aliasMachoReloc(e, b, 17, 1, "_z", 0, 4)
	e = aliasMachoReloc(e, b, 24, 1, "_d", 0, 4)
	e = aliasMachoReloc(e, b, 31, 1, "_r", 0, 4)
	e = aliasMachoReloc(e, b, 40, 0, "_a2", 0, 8)
	if machoRelocInfo(b, machoSection(b, "__text"), 36) >= 0 { e = buf.Concat(e, "jmp _t (Mach-O); ") }
	ok, msg = AssembleFile(src, obj, "x64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	b = tlsRead(obj)
	var data int = elfSectionIndex(b, true, ".data")
	// R_X86_64_PC32 = 2 against .data (the section's symbol) with clang's addends, then
	// R_X86_64_64 = 1 at 40; the jmp has none.
	var offs @[]int = @[]int{3, 10, 17, 24, 31, 40}
	var addends @[]int = @[]int{-1, 1, -1, -4, 8, 3}
	for k := 0; k < len(offs); k++ {
		off, rtype, shndx, addend := elfRela(b, k)
		var want int = 2
		if k == 5 { want = 1 }
		if off != offs[k] || rtype != want || shndx != data || addend != addends[k] {
			e = buf.Concat(e, "an ELF relocation; ")
		}
	}
	var rela int = elfShdr(b, true, elfSectionIndex(b, true, ".rela.text"))
	if tlsU(b, rela + 32, 8) != 6 * 24 { e = buf.Concat(e, "not six ELF relocations; ") }
	if len(e) > 0 { return fail(e) }
	return ""
}

// atomEndProgram's text is `_f: nop`, a temporary Lend at its end, `_g: adrp x0, Lend@PAGE`,
// `b Lend` (at 8), `adr x1, Lend` (at 12), a temporary Lmid, `nop`, then (at 20) `.uint64` of
// Lend, of the aliases La20 = _f + 8 (inside _g's atom) and LaE = Lend, and of Lmid.
var atomEndProgram *[]readonly char = ".arch aarch64\n.section text\n.global _f\n_f: nop\nLend:\n"
		".global _g\n_g: adrp x0, Lend@PAGE\nb Lend\nadr x1, Lend\nLmid:\nnop\nLa20 = _f + 8\n"
		"LaE = Lend\n.uint64 Lend\n.uint64 La20\n.uint64 LaE\n.uint64 Lmid\n"

// A temporary at the end of an atom belongs to that atom, not the next one at its address;
// one inside the next atom to that one; an alias to its target's atom, even past its end — as
// clang writes them (`clang -c -target arm64-apple-macos`): PAGE21 against _f with an ADDEND of
// 4, and UNSIGNED _f+4, _f+8, _f+4 and _g+12.  A branch or ADR to the temporary from the next
// atom is patched in place, as clang does on AArch64 (17FFFFFF, 10FFFFC1).
func TestAssembleFileTemporaryAtAtomEnd() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/atomend.s")
	if !asmWrite(src, atomEndProgram) { return fail("cannot write the test source") }
	var obj @[]char = buf.Concat(dir, "/atomend.o")
	ok, msg := AssembleFile(src, obj, "aarch64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var e @[]char = ""
	// PAGE21 = 3 (after its ARM64_RELOC_ADDEND entry, type 10), UNSIGNED = 0.
	var text int = machoSection(b, "__text")
	var info int = -1
	for k := 0; k < tlsU(b, text + 60, 4); k++ {
		var r int = tlsU(b, text + 56, 4) + k * 8
		if tlsU(b, r, 4) == 4 && (tlsU(b, r + 4, 4) >> 28) != 10 { info = tlsU(b, r + 4, 4) }
	}
	if info < 0 || (info >> 28) != 3 || !machoSymbolIs(b, info & 0xFFFFFF, "_f") {
		e = buf.Concat(e, "adrp x0, Lend@PAGE (PAGE21 against _f); ")
	}
	e = aliasMachoReloc(e, b, 20, 0, "_f", 4, 8)
	e = aliasMachoReloc(e, b, 28, 0, "_f", 8, 8)
	e = aliasMachoReloc(e, b, 36, 0, "_f", 4, 8)
	e = aliasMachoReloc(e, b, 44, 0, "_g", 12, 8)
	var data int = tlsU(b, text + 48, 4)
	if machoRelocInfo(b, text, 8) >= 0 || tlsU(b, data + 8, 4) != 0x17FFFFFF {
		e = buf.Concat(e, "b Lend (in place); ")
	}
	if machoRelocInfo(b, text, 12) >= 0 || tlsU(b, data + 12, 4) != 0x10FFFFC1 {
		e = buf.Concat(e, "adr x1, Lend (in place); ")
	}
	if len(e) > 0 { return fail(e) }
	return ""
}
