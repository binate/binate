package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// armAttrsHexOf returns the .ARM.attributes section of the arm32 ELF object b in hex, or a word
// saying why there is none.
func armAttrsHexOf(b @[]uint8) @[]char {
	var si int = elfSectionIndex(b, false, ".ARM.attributes")
	if si < 0 { return buf.CopyStr("none") }
	var sh int = elfShdr(b, false, si)
	var off int = tlsU(b, sh + 16, 4)
	var size int = tlsU(b, sh + 20, 4)
	if off + size > len(b) { return buf.CopyStr("truncated") }
	var digits *[]readonly char = "0123456789abcdef"
	var out @[]char = make_slice(char, 2 * size)
	for i := 0; i < size; i++ {
		out[2 * i] = digits[b[off + i] >> 4]
		out[2 * i + 1] = digits[b[off + i] & 15]
	}
	return out
}

// armAttrsCase appends to e a failure unless src, assembled for arm32 on osName, has the
// .ARM.attributes section want (hex).
func armAttrsCase(e @[]char, dir *[]readonly char, osName *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	var path @[]char = buf.Concat(dir, "/attrs.s")
	if !asmWrite(path, src) { return buf.Concat(e, "cannot write the source\n") }
	var obj @[]char = buf.Concat(dir, "/attrs.o")
	ok, msg := AssembleFile(path, obj, "arm32", osName)
	if !ok { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var got @[]char = armAttrsHexOf(tlsRead(obj))
	if charsEqual(got, want) { return e }
	var where @[]char = buf.Concat(buf.Concat(buf.Concat("`", src), "` on `"), osName)
	return buf.Concat(e, buf.Concat(buf.Concat(where, "`: "), buf.Concat(got, "\n")))
}

// The .ARM.attributes section, through the parser and the writer, byte for byte as clang
// (Apple clang 21) writes it for each target: Linux's (arm-linux-gnueabihf -march=armv7ve),
// with VFPv3 and NEON; bare metal's (no OS: arm-none-eabi -march=armv7ve -mfloat-abi=soft
// -mno-unaligned-access), with no FPU and Tag_CPU_unaligned_access 0; and `.fpu`, `.cpu` and
// `.eabi_attribute` over each — `.fpu none` dropping the FPU, an explicit
// Tag_CPU_unaligned_access over bare metal's 0, a string as written (escapes kept) but
// Tag_also_compatible_with's, whose escapes are read, a tag and a number of two ULEB128 bytes.
func TestAssembleFileArmAttributes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var s1 *[]readonly char = ".arch arm32\n.section text\n.global f\nf: bx lr\n"
	var s3 *[]readonly char = ".arch arm32\n.fpu vfpv4\n.cpu cortex-a7\n"
			".eabi_attribute Tag_ABI_VFP_args, 1\n.eabi_attribute 67, \"2.09\"\n.section text\nf: bx lr\n"
	var s4 *[]readonly char = ".arch arm32\n.fpu none\n.eabi_attribute Tag_compatibility, 1, \"gnu\"\n"
			".eabi_attribute 34, 1\n.section text\nf: bx lr\n"
	var s5 *[]readonly char = ".arch arm32\n.eabi_attribute 5, \"a\\\\x41\"\n"
			".eabi_attribute 65, \"\\\\006\\\\012\"\n.eabi_attribute 129, \"x\"\n"
			".eabi_attribute 44, 300\n.section text\nf: bx lr\n"
	var e @[]char = ""
	e = armAttrsCase(e, dir, "linux", s1,
			"41230000006165616269000119000000060a0741080109020a030c0122012a01"
					"2c024403")
	e = armAttrsCase(e, dir, "", s1,
			"411f0000006165616269000115000000060a07410801090222002a012c024403")
	e = armAttrsCase(e, dir, "linux", s3,
			"4134000000616561626900012a00000043322e30390005636f727465782d6137"
					"00060a0741080109020a051c0122012a012c024403")
	e = armAttrsCase(e, dir, "", s3,
			"4134000000616561626900012a00000043322e30390005636f727465782d6137"
					"00060a0741080109020a051c0122002a012c024403")
	e = armAttrsCase(e, dir, "linux", s4,
			"4125000000616561626900011b000000060a0741080109022001676e75002201"
					"2a012c024403")
	e = armAttrsCase(e, dir, "", s4,
			"4125000000616561626900011b000000060a0741080109022001676e75002201"
					"2a012c024403")
	e = armAttrsCase(e, dir, "linux", s5,
			"413a000000616561626900013000000005615c5c78343100060a074108010902"
					"0a030c0122012a012cac02415c3030365c30313200440381017800")
	e = armAttrsCase(e, dir, "", s5,
			"4136000000616561626900012c00000005615c5c78343100060a074108010902"
					"22002a012cac02415c3030365c30313200440381017800")
	if len(e) > 0 { return fail(e) }
	return ""
}

// `.arch` gives the object its architecture's Tag_CPU_name, and for iwmmxt / iwmmxt2 its
// Tag_WMMX_arch, only where nothing sets them explicitly, in either order — clang's bytes for
// each target.
func TestAssembleFileArmArchAttributes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = armAttrsCase(e, dir, "linux", ".arch arm32\n.arch iwmmxt\n.section text\nbx lr\n",
			"412d00000061656162690001230000000569776d6d787400060a074108010902"
					"0a030b010c0122012a012c024403")
	e = armAttrsCase(e, dir, "", ".arch arm32\n.arch iwmmxt\n.section text\nbx lr\n",
			"4129000000616561626900011f0000000569776d6d787400060a074108010902"
					"0b0122002a012c024403")
	e = armAttrsCase(e, dir, "linux",
			".arch arm32\n.arch armv6\n.cpu cortex-a8\n.section text\nbx lr\n",
			"412e000000616561626900012400000005636f727465782d613800060a074108"
					"0109020a030c0122012a012c024403")
	e = armAttrsCase(e, dir, "", ".arch arm32\n.cpu cortex-a8\n.arch armv6\n.section text\nbx lr\n",
			"412a000000616561626900012000000005636f727465782d613800060a074108"
					"01090222002a012c024403")
	e = armAttrsCase(e, dir, "linux",
			".arch arm32\n.arch iwmmxt2\n.eabi_attribute 11, 0\n.section text\nbx lr\n",
			"412e00000061656162690001240000000569776d6d78743200060a0741080109"
					"020a030b000c0122012a012c024403")
	e = armAttrsCase(e, dir, "", ".arch arm32\n.arch iwmmxt\n.arch armv7-a\n.section text\nbx lr\n",
			"4124000000616561626900011a00000005372d4100060a07410801090222002a"
					"012c024403")
	if len(e) > 0 { return fail(e) }
	return ""
}
