package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Label differences through the whole driver: a forward one (a second pass) assembles for
// ELF and, within one atom, for Mach-O; across atoms on Mach-O it is no number.  (asmWrite
// / asmHas / testTmpDir are in assemble_test.bn.)
func TestAssembleFileLabelDifferences() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var src @[]char = buf.Concat(dir, "/diff.s")
	if !asmWrite(src,
			".arch aarch64\n.section text\n.global _f\n_f: mov x0, #(Lend - _f)\n.uint32 Lend - Lmid\n"
					"Lmid: nop\nLend: ret\n") {
		return fail("cannot write the test source")
	}
	ok, msg := AssembleFile(src, buf.Concat(dir, "/diff_elf.o"), "aarch64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	ok, msg = AssembleFile(src, buf.Concat(dir, "/diff_macho.o"), "aarch64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var src2 @[]char = buf.Concat(dir, "/diff2.s")
	if !asmWrite(src2, ".arch aarch64\n.section text\n_a: nop\n_b: mov x0, #(_c - _a)\n_c: ret\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src2, buf.Concat(dir, "/diff2_macho.o"), "aarch64", "darwin")
	if ok || !asmHas(msg, "different sections or atoms is not a number") {
		return fail(buf.Concat("Mach-O across atoms: ", msg))
	}
	return ""
}
