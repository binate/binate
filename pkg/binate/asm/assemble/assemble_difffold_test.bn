package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/os"
import "pkg/std/strings"

// A label difference across Mach-O atoms, against clang's objects (`clang -c -target
// arm64-apple-macos` / `x86_64-apple-macos`): with no `.subsections_via_symbols`, two labels
// in one section, both defined before the difference, with no fragment boundary between them
// (an alignment, a literal pool's, a `.zero` a difference sizes, an x86-64 jump clang may
// relax, a zero-fill symbol) fold to a number — in data, in a constant — and any other pair
// stays a SUBTRACTOR / UNSIGNED pair (a forward one too, and one through an alias); with the
// directive anywhere in the input it is a pair, where clang folds it and ld64 may move the
// atoms apart; and a fold in an expression that still names a symbol is an error, as in
// clang.  (machoRelocEntries is in
// assemble_relorder_test.bn, symtabObject in assemble_symtab_test.bn, machoSection and tlsU
// in assemble_tls_test.bn, testTmpDir in assemble_test.bn.)

// diffFoldCase appends to e a failure unless src, assembled for arch on darwin, has clang's
// relocation entries and __data contents, want (machoRelocEntries, then `data` and the
// contents in hex).
func diffFoldCase(e @[]char, dir *[]readonly char, arch *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	b, msg := symtabObject(dir, arch, src)
	if len(msg) != 0 { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("data ")
	var sh int = machoSection(b, "__data")
	if sh >= 0 {
		for k := 0; k < tlsU(b, sh + 40, 8); k++ {
			stringutils.WriteHexByte(sb, tlsU(b, tlsU(b, sh + 48, 4) + k, 1))
		}
	}
	sb.WriteByte('\n')
	var got @[]char = buf.Concat(machoRelocEntries(b), sb.String())
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(buf.Concat("`", src), "`: object\n"), got))
}

func TestAssembleFileMachoDifferenceFold() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_g: ret\n.section data\n"
					".p2align 3\n.uint64 _g - _f\n",
			"__text\n__data\ndata 0400000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n.p2align 2\n_g: ret\n"
					".section data\n.p2align 3\n.uint64 _g - _f\n",
			"__text\n__data\n0 503316481\n0 234881026\n"
					"data 0000000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n.zero 8\n_g: ret\n"
					".section data\n.p2align 3\n.uint64 _g - _f\n",
			"__text\n__data\ndata 0C00000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ldr x0, =0x123456789\n ret\n"
					".ltorg\n_g: ret\n.section data\n.p2align 3\n.uint64 _g - _f\n",
			"__text\n__data\n0 503316481\n0 234881026\n"
					"data 0000000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n.section data\n"
					".p2align 3\n.uint64 _g - _f\n.section text\n_g: ret\n",
			"__text\n__data\n0 503316481\n0 234881027\n"
					"data 0000000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_g: ret\nx = _g - _f\n"
					".section data\n.p2align 3\n.uint64 x\n",
			"__text\n__data\ndata 0400000000000000\n")
	e = diffFoldCase(e, dir, "x64",
			".arch x64\n.section text\n.global _ext\n_f: call _ext\n_g: ret\n"
					".section data\n.p2align 3\n.uint64 _g - _f\n .uint32 _g - _f\n",
			"__text\n1 754974722\n__data\ndata 050000000000000005000000\n")
	e = diffFoldCase(e, dir, "x64",
			".arch x64\n.section text\n_f: jne _f\n_g: ret\n.section data\n"
					".p2align 3\n.uint64 _g - _f\n",
			"__text\n__data\n0 1577058304\n0 234881025\n"
					"data 0000000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_a: ret\n_b: ret\n_f: ret\n"
					".zero _b - _a\n_g: ret\n.section data\n.p2align 3\n"
					".uint64 _g - _f\n",
			"__text\n__data\n0 503316483\n0 234881028\n"
					"data 0000000000000000\n")
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_g: ret\n_h: ret\n"
					"A = _f + 4\n.section data\n.p2align 3\n.uint64 _h - A\n"
					" .uint64 A - _g\n",
			"__text\n__data\n8 503316482\n8 234881028\n0 503316484\n"
					"0 234881027\ndata 00000000000000000000000000000000\n")
	// With the directive, after the difference: a pair (the second pass knows the directive).
	e = diffFoldCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_g: ret\n.section data\n.p2align 3\n"
					".uint64 _g - _f\n.subsections_via_symbols\n",
			"__text\n__data\n0 503316481\n0 234881026\ndata 0000000000000000\n")
	// A difference folded across atoms in an expression that still names a symbol: clang
	// evaluates it again where the atoms count ("expected relocatable expression").
	_, msg := symtabObject(dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_g: ret\n.section data\n_k: .uint64 _k + (_g - _f)\n")
	if !asmHas(msg, "takes only a number added or subtracted") {
		e = buf.Concat(e, buf.Concat("a fold in a relocatable expression: ", msg))
	}
	return e
}
