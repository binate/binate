package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"
import "pkg/std/strings"

// Mapping symbols in ELF objects against clang's (`clang -c -target aarch64-linux-gnu` /
// `armv7a-linux-gnueabihf` of the same source, `.section .note.GNU-stack,"",%progbits`
// appended).  (elfObject, elfLayoutCase and elfLayoutText are in assemble_elf_test.bn.)

// elfSymbolLines returns the `sym` lines of elfLayoutText(b).
func elfSymbolLines(b @[]uint8) @[]char {
	var all @[]char = elfLayoutText(b)
	var sb @strings.Builder = strings.NewBuilder()
	var start int = 0
	for i := 0; i < len(all); i++ {
		if all[i] != '\n' { continue }
		if i - start > 4 && all[start] == 's' && all[start + 1] == 'y' && all[start + 2] == 'm' {
			sb.Write(all[start:i + 1])
		}
		start = i + 1
	}
	return buf.CopyStr(sb.String())
}

// elfSymbolsCase appends to e a failure unless src, assembled for arch on linux, has the
// symbols want (elfSymbolLines).
func elfSymbolsCase(e @[]char, dir *[]readonly char, arch *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	b, msg := elfObject(dir, arch, src)
	if len(msg) != 0 { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var got @[]char = elfSymbolLines(b)
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(buf.Concat("`", src), "`: symbols\n"), got))
}

// AArch64 objects as clang writes them, mapping symbols included: `$x` where a section starts
// holding instructions and `$d` where it starts holding data (a literal pool after its
// padding, a zero fill, a local common in bss, a thread-local section's, STT_TLS), padding
// marking neither, each section keeping its own state; each listed among the locals where it
// was made — before the symbols its instruction or datum uses (a forward branch, a page
// reference, a datum or a pool entry naming a later label, a label difference); `.tlsdesccall`
// marking code, then naming its symbol; `.fill` of size 0 still marking data.
func TestAssembleFileElfMappingSymbolsAArch64() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\n.global f\nf: ret\n",
			"headers 5 1\nsec .strtab 3 0 144 44 0 0 1 0\nsec .text 1 6 64 4 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 68 0 0 0 1 0\nsec .symtab 2 0 72 72 1 2 8 24\n"
					"sym $x 0 0 2 0 0\nsym f 16 0 2 0 0\nfile 512\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\na: ret\nLx: ret\nb: ret\n.section data\n"
					"d: .uint64 1\n",
			"headers 6 1\nsec .strtab 3 0 256 54 0 0 1 0\nsec .text 1 6 64 12 0 0 4 0\n"
					"sec .data 1 3 76 8 0 0 1 0\nsec .note.GNU-stack 1 0 84 0 0 0 1 0\n"
					"sec .symtab 2 0 88 168 1 7 8 24\nsym a 0 0 2 0 0\nsym $x 0 0 2 0 0\n"
					"sym Lx 0 0 2 4 0\nsym b 0 0 2 8 0\nsym d 0 0 3 0 0\nsym $d 0 0 3 0 0\n"
					"file 696\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global f\nf: adrp x0, d\n"
					" ldr x0, [x0, :lo12:d]\n ret\n.section data\n.p2align 4\n.global d\n"
					"d: .uint64 1\n",
			"headers 7 1\nsec .strtab 3 0 256 58 0 0 1 0\nsec .text 1 6 64 12 0 0 4 0\n"
					"sec .rela.text 4 64 208 48 6 2 8 24\nsec .data 1 3 80 8 0 0 16 0\n"
					"sec .note.GNU-stack 1 0 88 0 0 0 1 0\nsec .symtab 2 0 88 120 1 3 8 24\n"
					"sym $x 0 0 2 0 0\nsym $d 0 0 4 0 0\nsym f 16 0 2 0 0\nsym d 16 0 4 0 0\n"
					"rel .rela.text 0 17179869459 0\nrel .rela.text 4 17179869470 0\nfile 768\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global f\nf: ldr x0, =0x123456789\n ret\n",
			"headers 5 1\nsec .strtab 3 0 176 47 0 0 1 0\nsec .text 1 6 64 16 0 0 8 0\n"
					"sec .note.GNU-stack 1 0 80 0 0 0 1 0\nsec .symtab 2 0 80 96 1 3 8 24\n"
					"sym $x 0 0 2 0 0\nsym $d 0 0 2 8 0\nsym f 16 0 2 0 0\nfile 544\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\nret\n.section data\n.uint32 1\n.section text\n"
					"ret\n",
			"headers 6 1\nsec .strtab 3 0 152 51 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .data 1 3 72 4 0 0 1 0\nsec .note.GNU-stack 1 0 76 0 0 0 1 0\n"
					"sec .symtab 2 0 80 72 1 3 8 24\nsym $x 0 0 2 0 0\nsym $d 0 0 3 0 0\nfile 592\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\n.uint32 1\n.p2align 4\nret\n",
			"headers 5 1\nsec .strtab 3 0 160 45 0 0 1 0\nsec .text 1 6 64 20 0 0 16 0\n"
					"sec .note.GNU-stack 1 0 84 0 0 0 1 0\nsec .symtab 2 0 88 72 1 3 8 24\n"
					"sym $d 0 0 2 0 0\nsym $x 0 0 2 16 0\nfile 528\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\nret\n.zero 4\n.fill 2, 1, 7\n ret\n",
			"headers 5 1\nsec .strtab 3 0 176 45 0 0 1 0\nsec .text 1 6 64 14 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 78 0 0 0 1 0\nsec .symtab 2 0 80 96 1 4 8 24\n"
					"sym $x 0 0 2 0 0\nsym $d 0 0 2 4 0\nsym $x 0 0 2 10 0\nfile 544\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\nret\n.lcomm c, 8\n ret\n",
			"headers 6 1\nsec .strtab 3 0 168 52 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .bss 8 3 72 8 0 0 1 0\nsec .note.GNU-stack 1 0 72 0 0 0 1 0\n"
					"sec .symtab 2 0 72 96 1 4 8 24\nsym $x 0 0 2 0 0\nsym c 1 0 3 0 8\n"
					"sym $d 0 0 3 0 0\nfile 608\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section tbss\n.zero 8\n",
			"headers 6 1\nsec .strtab 3 0 112 48 0 0 1 0\nsec .text 1 6 64 0 0 0 4 0\n"
					"sec .tbss 8 1027 64 8 0 0 1 0\nsec .note.GNU-stack 1 0 64 0 0 0 1 0\n"
					"sec .symtab 2 0 64 48 1 2 8 24\nsym $d 6 0 3 0 0\nfile 544\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\nf: bl g\ng: ret\n",
			"headers 5 1\nsec .strtab 3 0 168 46 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 72 0 0 0 1 0\nsec .symtab 2 0 72 96 1 4 8 24\n"
					"sym f 0 0 2 0 0\nsym $x 0 0 2 0 0\nsym g 0 0 2 4 0\nfile 536\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\nf: adrp x0, d\n ret\n.section data\n"
					"d: .uint64 1\n",
			"headers 7 1\nsec .strtab 3 0 248 58 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .rela.text 4 64 224 24 6 2 8 24\nsec .data 1 3 72 8 0 0 1 0\n"
					"sec .note.GNU-stack 1 0 80 0 0 0 1 0\nsec .symtab 2 0 80 144 1 6 8 24\n"
					"sym f 0 0 2 0 0\nsym $x 0 0 2 0 0\nsym d 0 0 4 0 0\nsym - 3 0 4 0 0\n"
					"sym $d 0 0 4 0 0\nrel .rela.text 0 17179869459 0\nfile 760\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section data\n.uint64 x\n.section text\nx: ret\n",
			"headers 7 1\nsec .strtab 3 0 224 56 0 0 1 0\nsec .text 1 6 64 4 0 0 4 0\n"
					"sec .data 1 3 68 8 0 0 1 0\nsec .rela.data 4 64 200 24 6 3 8 24\n"
					"sec .note.GNU-stack 1 0 76 0 0 0 1 0\nsec .symtab 2 0 80 120 1 5 8 24\n"
					"sym - 3 0 2 0 0\nsym $d 0 0 3 0 0\nsym x 0 0 2 0 0\nsym $x 0 0 2 0 0\n"
					"rel .rela.data 0 4294967553 0\nfile 728\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\nf: ret\n.uint32 h - f\nh: ret\n",
			"headers 5 1\nsec .strtab 3 0 224 49 0 0 1 0\nsec .text 1 6 64 12 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 76 0 0 0 1 0\nsec .symtab 2 0 80 144 1 6 8 24\n"
					"sym f 0 0 2 0 0\nsym $x 0 0 2 0 0\nsym $d 0 0 2 4 0\nsym h 0 0 2 8 0\n"
					"sym $x 0 0 2 8 0\nfile 600\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\nf: ldr x0, =g\n ret\ng: ret\n",
			"headers 6 1\nsec .strtab 3 0 256 54 0 0 1 0\nsec .text 1 6 64 24 0 0 8 0\n"
					"sec .rela.text 4 64 232 24 5 2 8 24\nsec .note.GNU-stack 1 0 88 0 0 0 1 0\n"
					"sec .symtab 2 0 88 144 1 6 8 24\nsym - 3 0 2 0 0\nsym f 0 0 2 0 0\n"
					"sym $x 0 0 2 0 0\nsym g 0 0 2 8 0\nsym $d 0 0 2 16 0\n"
					"rel .rela.text 16 4294967553 8\nfile 696\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.global w\n.section text\n.uint32 1\n.tlsdesccall w\n"
					"m: blr x1\n",
			"headers 6 1\nsec .strtab 3 0 216 54 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .rela.text 4 64 192 24 5 2 8 24\nsec .note.GNU-stack 1 0 72 0 0 0 1 0\n"
					"sec .symtab 2 0 72 120 1 4 8 24\nsym $d 0 0 2 0 0\nsym $x 0 0 2 4 0\n"
					"sym m 0 0 2 4 0\nsym w 22 0 0 0 0\nrel .rela.text 4 17179869753 0\nfile 656\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\nret\n.fill 2, 0, 0\nret\n",
			"headers 5 1\nsec .strtab 3 0 168 45 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 72 0 0 0 1 0\nsec .symtab 2 0 72 96 1 4 8 24\n"
					"sym $x 0 0 2 0 0\nsym $d 0 0 2 4 0\nsym $x 0 0 2 4 0\nfile 536\n")
	e = elfLayoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\nf: mov x0, #(g - f)\ng: ret\n",
			"headers 5 1\nsec .strtab 3 0 168 46 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 72 0 0 0 1 0\nsec .symtab 2 0 72 96 1 4 8 24\n"
					"sym f 0 0 2 0 0\nsym $x 0 0 2 0 0\nsym g 0 0 2 4 0\nfile 536\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\nf: ldr x0, =h\n ret\n.ltorg\nh: ret\n",
			"headers 6 1\nsec .strtab 3 0 280 54 0 0 1 0\nsec .text 1 6 64 20 0 0 8 0\n"
					"sec .rela.text 4 64 256 24 5 2 8 24\nsec .note.GNU-stack 1 0 84 0 0 0 1 0\n"
					"sec .symtab 2 0 88 168 1 7 8 24\nsym - 3 0 2 0 0\nsym f 0 0 2 0 0\n"
					"sym $x 0 0 2 0 0\nsym $d 0 0 2 8 0\nsym h 0 0 2 16 0\nsym $x 0 0 2 16 0\n"
					"rel .rela.text 8 4294967553 16\nfile 720\n")
	e = elfLayoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.uint32 1\n.tlsdesccall w\nm: blr x1\n"
					".section tdata\nw: .uint32 0\n",
			"headers 7 1\nsec .strtab 3 0 248 61 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .rela.text 4 64 224 24 6 2 8 24\nsec .tdata 1 1027 72 4 0 0 1 0\n"
					"sec .note.GNU-stack 1 0 76 0 0 0 1 0\nsec .symtab 2 0 80 144 1 6 8 24\n"
					"sym $d 0 0 2 0 0\nsym $x 0 0 2 4 0\nsym w 6 0 4 0 0\nsym m 0 0 2 4 0\n"
					"sym $d 6 0 4 0 0\nrel .rela.text 4 12884902457 0\nfile 760\n")
	return e
}

// arm32 objects as clang writes them (arm-linux-gnueabihf -march=armv7ve), .ARM.attributes
// included: `$a` and `$d`, but a section's first mark, data, listed only when code follows in
// the section, just before that code's `$a` — none for a data section alone; before the
// symbols the item uses; STT_NOTYPE in a thread-local section.  Where an object differs from
// clang's elsewhere — an instruction in a data section aligns it to 4 (clang leaves it 1), a
// `bl` to a label in the same section is resolved (clang leaves a relocation) — only its
// symbols are compared.
func TestAssembleFileElfMappingSymbolsArm32() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = elfLayoutCase(e, dir, "arm32", ".arch arm32\n.section text\nf: bx lr\n.uint32 1\n bx lr\n",
			"headers 6 1\nsec .strtab 3 0 180 63 0 0 1 0\nsec .text 1 6 52 12 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 64 0 0 0 1 0\nsec .ARM.attributes 1879048195 0 64 36 0 0 1 0\n"
					"sec .symtab 2 0 100 80 1 5 4 16\nsym f 0 0 2 0 0\nsym $a 0 0 2 0 0\n"
					"sym $d 0 0 2 4 0\nsym $a 0 0 2 8 0\nfile 484\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section text\n.uint32 1\nf: bx lr\n",
			"sym f 0 0 2 4 0\nsym $d 0 0 2 0 0\nsym $a 0 0 2 4 0\n")
	e = elfLayoutCase(e, dir, "arm32", ".arch arm32\n.section data\n.uint32 1\n",
			"headers 7 1\nsec .strtab 3 0 108 61 0 0 1 0\nsec .text 1 6 52 0 0 0 4 0\n"
					"sec .data 1 3 52 4 0 0 1 0\nsec .note.GNU-stack 1 0 56 0 0 0 1 0\n"
					"sec .ARM.attributes 1879048195 0 56 36 0 0 1 0\nsec .symtab 2 0 92 16 1 1 4 16\n"
					"file 452\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section data\n.uint32 1\nbx lr\n",
			"sym $d 0 0 3 0 0\nsym $a 0 0 3 4 0\n")
	e = elfLayoutCase(e, dir, "arm32", ".arch arm32\n.section text\nf: ldr r0, =0x12345678\n bx lr\n",
			"headers 6 1\nsec .strtab 3 0 164 63 0 0 1 0\nsec .text 1 6 52 12 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 64 0 0 0 1 0\nsec .ARM.attributes 1879048195 0 64 36 0 0 1 0\n"
					"sec .symtab 2 0 100 64 1 4 4 16\nsym f 0 0 2 0 0\nsym $a 0 0 2 0 0\n"
					"sym $d 0 0 2 8 0\nfile 468\n")
	e = elfSymbolsCase(e, dir, "arm32",
			".arch arm32\n.section text\n.uint32 1\n.section data\n.uint32 2\nbx lr\n"
					".section text\nbx lr\n",
			"sym $d 0 0 3 0 0\nsym $a 0 0 3 4 0\nsym $d 0 0 2 0 0\nsym $a 0 0 2 4 0\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section text\nf: bl g\ng: bx lr\n",
			"sym f 0 0 2 0 0\nsym $a 0 0 2 0 0\nsym g 0 0 2 4 0\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section text\n.uint32 1\nf: bl g\ng: bx lr\n",
			"sym f 0 0 2 4 0\nsym $d 0 0 2 0 0\nsym $a 0 0 2 4 0\nsym g 0 0 2 8 0\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section tdata\nbx lr\n.uint32 1\n",
			"sym $a 0 0 3 0 0\nsym $d 0 0 3 4 0\n")
	e = elfLayoutCase(e, dir, "arm32", ".arch arm32\n.section text\nf: ldr r0, =g\n bx lr\ng: bx lr\n",
			"headers 7 1\nsec .strtab 3 0 208 69 0 0 1 0\nsec .text 1 6 52 16 0 0 4 0\n"
					"sec .rel.text 9 64 200 8 6 2 4 8\nsec .note.GNU-stack 1 0 68 0 0 0 1 0\n"
					"sec .ARM.attributes 1879048195 0 68 36 0 0 1 0\nsec .symtab 2 0 104 96 1 6 4 16\n"
					"sym - 3 0 2 0 0\nsym f 0 0 2 0 0\nsym $a 0 0 2 0 0\nsym g 0 0 2 8 0\n"
					"sym $d 0 0 2 12 0\nrel .rel.text 12 258 -\nfile 560\n")
	e = elfLayoutCase(e, dir, "arm32",
			".arch arm32\n.section text\nf: ldr r0, =h\n bx lr\n.ltorg\nh: bx lr\n",
			"headers 7 1\nsec .strtab 3 0 224 69 0 0 1 0\nsec .text 1 6 52 16 0 0 4 0\n"
					"sec .rel.text 9 64 216 8 6 2 4 8\nsec .note.GNU-stack 1 0 68 0 0 0 1 0\n"
					"sec .ARM.attributes 1879048195 0 68 36 0 0 1 0\nsec .symtab 2 0 104 112 1 7 4 16\n"
					"sym - 3 0 2 0 0\nsym f 0 0 2 0 0\nsym $a 0 0 2 0 0\nsym $d 0 0 2 8 0\n"
					"sym h 0 0 2 12 0\nsym $a 0 0 2 12 0\nrel .rel.text 8 258 -\nfile 576\n")
	// clang drops this held-back `$d` (data opening its first text section, no label before
	// it); bnas keeps it, so the data is not decoded as code.
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section text\n.ascii \"abcd\"\nbx lr\n",
			"sym $d 0 0 2 0 0\nsym $a 0 0 2 4 0\n")
	return e
}

// A label made for `.` comes before the mapping symbol of the item it is in, as clang registers
// it where it reads the `.` -- a forward reference before or after it in the same expression
// notwithstanding -- and the item's other new names after; in a data directive, before its own
// value's other names only, after the mark and the names of the values before it, as clang
// parses and emits each value in turn (the objects clang writes, compared byte for byte).
func TestAssembleFileElfDotBeforeMappingSymbol() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = elfSymbolsCase(e, dir, "arm32",
			".arch arm32\n.section text\n.global ext\nmovw r0, #:lower16:((2f - 1f) + .)\n1: nop\n2: nop\n",
			"sym .L0  0 0 2 0 0\nsym $a 0 0 2 0 0\nsym ext 16 0 0 0 0\n")
	e = elfSymbolsCase(e, dir, "arm32",
			".arch arm32\n.section text\nnop\n.uint16 . + (b - a)\na: nop\nb: nop\n",
			"sym $a 0 0 2 0 0\nsym .L0  0 0 2 4 0\nsym $d 0 0 2 4 0\nsym b 0 0 2 10 0\nsym a 0 0 2 6 0\n"
					"sym $a 0 0 2 6 0\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section text\nnop\n.uint16 1, 2, .\nnop\n",
			"sym $a 0 0 2 0 0\nsym $d 0 0 2 4 0\nsym .L0  0 0 2 8 0\nsym $a 0 0 2 10 0\n")
	e = elfSymbolsCase(e, dir, "arm32", ".arch arm32\n.section text\nnop\n.uint16 b, .\nb: nop\n",
			"sym $a 0 0 2 0 0\nsym $d 0 0 2 4 0\nsym b 0 0 2 8 0\nsym .L0  0 0 2 6 0\nsym $a 0 0 2 8 0\n")
	e = elfSymbolsCase(e, dir, "arm32",
			".arch arm32\n.section text\nlbl0: nop\n.uint16 (. - lbl0), fwd, .\nfwd: nop\n",
			"sym lbl0 0 0 2 0 0\nsym $a 0 0 2 0 0\nsym $d 0 0 2 4 0\nsym fwd 0 0 2 10 0\n"
					"sym .L0  0 0 2 8 0\nsym $a 0 0 2 10 0\n")
	if len(e) > 0 { return fail(e) }
	return ""
}
