package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/os"
import "pkg/std/strings"

// ELF objects against clang's (`clang -c -target x86_64-linux-gnu` of the same source with
// `.section .note.GNU-stack,"",%progbits` appended, as bnas always writes that section), read
// back as elfLayoutText reads them.  (tlsU, tlsU64 and tlsRead are in assemble_tls_test.bn,
// asmWrite and testTmpDir in assemble_test.bn.)

// elfName returns the NUL-terminated name at off in the section whose header is at sh.
func elfName(b @[]uint8, is64 bool, sh int, off int) @[]char {
	var at int = tlsU(b, sh + 16, 4) + off
	if is64 { at = tlsU(b, sh + 24, 8) + off }
	var sb @strings.Builder = strings.NewBuilder()
	for k := at; k < len(b) && b[k] != 0; k++ { sb.WriteByte(b[k]) }
	return buf.CopyStr(sb.String())
}

// elfLayoutText returns the layout of the ELF object b: `headers` and the number of section
// headers and e_shstrndx; a line per header after the null one — `sec name type flags offset
// size link info align entsize`; a line per symbol after the null one — `sym name info other
// shndx value size` (`-` for no name); a line per relocation — `rel section offset info
// addend` (`-` for none, in a REL section); then `file` and the file's size, all in decimal.
// The printed fields are read as int64: an int on a 32-bit host would keep only the low 32
// bits of a 64-bit field (r_info packs the symbol index above them) and print a field with
// its top bit set (a flag such as SHF_EXCLUDE) negative.
func elfLayoutText(b @[]uint8) @[]char {
	var is64 bool = b[4] == 2
	var shoff int = tlsU(b, 0x20, 4)
	var shent int = tlsU(b, 0x2E, 2)
	var shnum int = tlsU(b, 0x30, 2)
	var shstr int = tlsU(b, 0x32, 2)
	if is64 {
		shoff = tlsU(b, 0x28, 8)
		shent = tlsU(b, 0x3A, 2)
		shnum = tlsU(b, 0x3C, 2)
		shstr = tlsU(b, 0x3E, 2)
	}
	var w int = 4 // the width of an address-sized header field
	if is64 { w = 8 }
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("headers ")
	stringutils.WriteInt(sb, shnum)
	sb.WriteByte(' ')
	stringutils.WriteInt(sb, shstr)
	sb.WriteByte('\n')
	var strSh int = shoff + shstr * shent
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shent
		sb.Write("sec ")
		sb.Write(elfName(b, is64, strSh, tlsU(b, sh, 4)))
		var fields @[]int64 = make_slice(int64, 8)
		fields[0] = tlsU64(b, sh + 4, 4)
		fields[1] = tlsU64(b, sh + 8, w)
		fields[2] = tlsU64(b, sh + 8 + 2 * w, w)
		fields[3] = tlsU64(b, sh + 8 + 3 * w, w)
		fields[4] = tlsU64(b, sh + 8 + 4 * w, 4)
		fields[5] = tlsU64(b, sh + 12 + 4 * w, 4)
		fields[6] = tlsU64(b, sh + 16 + 4 * w, w)
		fields[7] = tlsU64(b, sh + 16 + 5 * w, w)
		for k := 0; k < len(fields); k++ {
			sb.WriteByte(' ')
			stringutils.WriteInt64(sb, fields[k])
		}
		sb.WriteByte('\n')
	}
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shent
		if tlsU(b, sh + 4, 4) == 2 {
			elfSymbolsText(sb, b, is64, shoff + tlsU(b, sh + 8 + 4 * w, 4) * shent, sh, w)
		}
	}
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shent
		var t int = tlsU(b, sh + 4, 4)
		if t == 4 || t == 9 {
			elfRelocsText(sb, b, elfName(b, is64, strSh, tlsU(b, sh, 4)), sh, w, t == 4)
		}
	}
	sb.Write("file ")
	stringutils.WriteInt(sb, len(b))
	sb.WriteByte('\n')
	return buf.CopyStr(sb.String())
}

// elfSymbolsText writes to sb a line per symbol after the null one of the symbol table whose
// header is at sh, its names in the section whose header is at strSh (elfLayoutText).
func elfSymbolsText(sb @strings.Builder, b @[]uint8, is64 bool, strSh int, sh int, w int) {
	var off int = tlsU(b, sh + 8 + 2 * w, w)
	var ent int = tlsU(b, sh + 16 + 5 * w, w)
	for k := 1; k < tlsU(b, sh + 8 + 3 * w, w) / ent; k++ {
		var e int = off + k * ent
		var fields @[]int64 = make_slice(int64, 5)
		if is64 {
			fields[0] = tlsU64(b, e + 4, 1)
			fields[1] = tlsU64(b, e + 5, 1)
			fields[2] = tlsU64(b, e + 6, 2)
			fields[3] = tlsU64(b, e + 8, 8)
			fields[4] = tlsU64(b, e + 16, 8)
		} else {
			fields[0] = tlsU64(b, e + 12, 1)
			fields[1] = tlsU64(b, e + 13, 1)
			fields[2] = tlsU64(b, e + 14, 2)
			fields[3] = tlsU64(b, e + 4, 4)
			fields[4] = tlsU64(b, e + 8, 4)
		}
		sb.Write("sym ")
		var name @[]char = elfName(b, is64, strSh, tlsU(b, e, 4))
		if len(name) == 0 { name = buf.CopyStr("-") }
		sb.Write(name)
		for f := 0; f < len(fields); f++ {
			sb.WriteByte(' ')
			stringutils.WriteInt64(sb, fields[f])
		}
		sb.WriteByte('\n')
	}
}

// elfRelocsText writes to sb a line per relocation of the relocation section name whose header
// is at sh, with addends when rela (elfLayoutText).
func elfRelocsText(sb @strings.Builder, b @[]uint8, name *[]readonly char, sh int, w int,
		rela bool) {
	var off int = tlsU(b, sh + 8 + 2 * w, w)
	var ent int = tlsU(b, sh + 16 + 5 * w, w)
	for k := 0; k < tlsU(b, sh + 8 + 3 * w, w) / ent; k++ {
		var e int = off + k * ent
		sb.Write("rel ")
		sb.Write(name)
		sb.WriteByte(' ')
		stringutils.WriteInt64(sb, tlsU64(b, e, w))
		sb.WriteByte(' ')
		stringutils.WriteInt64(sb, tlsU64(b, e + w, w))
		sb.WriteByte(' ')
		if rela {
			var addend int64 = tlsU64(b, e + 2 * w, w)
			if w == 4 { addend = cast(int64, cast(int32, cast(uint32, addend))) }
			stringutils.WriteInt64(sb, addend)
		} else {
			sb.WriteByte('-')
		}
		sb.WriteByte('\n')
	}
}

// elfObject assembles src for arch on linux into dir/elf.o and returns its bytes, or empty
// bytes and the error.
func elfObject(dir *[]readonly char, arch *[]readonly char,
		src *[]readonly char) (@[]uint8, @[]char) {
	var path @[]char = buf.Concat(dir, "/elf.s")
	if !asmWrite(path, src) { return make_slice(uint8, 0), buf.CopyStr("cannot write the source") }
	var obj @[]char = buf.Concat(dir, "/elf.o")
	ok, msg := AssembleFile(path, obj, arch, "linux")
	if !ok { return make_slice(uint8, 0), msg }
	return tlsRead(obj), ""
}

// elfLayoutCase appends to e a failure unless src, assembled for arch on linux, has the
// layout want (elfLayoutText).
func elfLayoutCase(e @[]char, dir *[]readonly char, arch *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	b, msg := elfObject(dir, arch, src)
	if len(msg) != 0 { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var got @[]char = elfLayoutText(b)
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(buf.Concat("`", src), "`: layout\n"), got))
}

// The objects clang writes for the same sources, x86-64: the null header, .strtab (which
// names the sections too), each section followed by its relocation section (SHF_INFO_LINK, 64),
// .note.GNU-stack, then .symtab; the contents, the symbol table, the relocations and the
// string table in that order in the file; the symbols in the order their names were first
// mentioned, a section symbol where its section was created (`.lcomm` makes bss, after its
// name is mentioned); a name first mentioned by `.local`, `.hidden`, `.internal` or
// `.protected` (`.type` and `.weak` too, not `.size`); weak, hidden, common and absolute
// symbols, aliases and thread-local sections; an empty .text first in a data-only object.
func TestAssembleFileElfLayoutLikeClang() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = elfLayoutCase(e, dir, "x64", ".arch x64\n.section text\nret\n",
			"headers 5 1\nsec .strtab 3 0 96 39 0 0 1 0\nsec .text 1 6 64 1 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 65 0 0 0 1 0\nsec .symtab 2 0 72 24 1 1 8 24\n"
					"file 456\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.global f\nf: lea rax, [rip + d]\n ret\n"
					".section data\n.global d\nd: .uint64 1\n",
			"headers 7 1\nsec .strtab 3 0 176 54 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .rela.text 4 64 152 24 6 2 8 24\nsec .data 1 3 72 8 0 0 1 0\n"
					"sec .note.GNU-stack 1 0 80 0 0 0 1 0\nsec .symtab 2 0 80 72 1 1 8 24\n"
					"sym f 16 0 2 0 0\nsym d 16 0 4 0 0\nrel .rela.text 3 8589934594 -4\nfile 680\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.global g\nf: call g\n ret\n.section data\n"
					".uint64 g\n.uint64 f\n",
			"headers 8 1\nsec .strtab 3 0 256 59 0 0 1 0\nsec .text 1 6 64 6 0 0 4 0\n"
					"sec .rela.text 4 64 184 24 7 2 8 24\nsec .data 1 3 70 16 0 0 1 0\n"
					"sec .rela.data 4 64 208 48 7 4 8 24\nsec .note.GNU-stack 1 0 86 0 0 0 1 0\n"
					"sec .symtab 2 0 88 96 1 3 8 24\nsym - 3 0 2 0 0\nsym f 0 0 2 0 0\n"
					"sym g 16 0 0 0 0\nrel .rela.text 1 12884901892 -4\n"
					"rel .rela.data 0 12884901889 0\nrel .rela.data 8 4294967297 0\nfile 832\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\nf: lea rax, [rip + b]\n ret\n.section rodata\n"
					"r: .uint32 1\n.lcomm b, 8\n.section data\n.uint64 r\n",
			"headers 10 1\nsec .strtab 3 0 280 72 0 0 1 0\nsec .text 1 6 64 8 0 0 4 0\n"
					"sec .rela.text 4 64 232 24 9 2 8 24\nsec .rodata 1 2 72 4 0 0 1 0\n"
					"sec .bss 8 3 76 8 0 0 1 0\nsec .data 1 3 76 8 0 0 1 0\n"
					"sec .rela.data 4 64 256 24 9 6 8 24\nsec .note.GNU-stack 1 0 84 0 0 0 1 0\n"
					"sec .symtab 2 0 88 144 1 6 8 24\nsym f 0 0 2 0 0\nsym b 1 0 5 0 8\n"
					"sym - 3 0 4 0 0\nsym r 0 0 4 0 0\nsym - 3 0 5 0 0\n"
					"rel .rela.text 3 21474836482 -4\nrel .rela.data 0 12884901889 0\nfile 992\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.weak w\nw: ret\n.global h\n.hidden h\nh: call w\n"
					" call h\n ret\n",
			"headers 6 1\nsec .strtab 3 0 200 48 0 0 1 0\nsec .text 1 6 64 12 0 0 4 0\n"
					"sec .rela.text 4 64 152 48 5 2 8 24\nsec .note.GNU-stack 1 0 76 0 0 0 1 0\n"
					"sec .symtab 2 0 80 72 1 1 8 24\nsym w 32 0 2 0 0\nsym h 16 2 2 1 0\n"
					"rel .rela.text 2 4294967300 -4\nrel .rela.text 7 8589934596 -4\nfile 632\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.lcomm q, 4\nf: lea rax, [rip + q]\n.hidden hh\n"
					"lea rax, [rip + hh]\nhh: ret\n.section tdata\ntv: .uint32 7\n.section tbss\n"
					"tb: .zero 8\n.section text\nlea rax, [rip + tb]\n",
			"headers 9 1\nsec .strtab 3 0 312 75 0 0 1 0\nsec .text 1 6 64 22 0 0 4 0\n"
					"sec .rela.text 4 64 264 48 8 2 8 24\nsec .bss 8 3 86 4 0 0 1 0\n"
					"sec .tdata 1 1027 86 4 0 0 1 0\nsec .tbss 8 1027 90 8 0 0 1 0\n"
					"sec .note.GNU-stack 1 0 90 0 0 0 1 0\nsec .symtab 2 0 96 168 1 7 8 24\n"
					"sym q 1 0 4 0 4\nsym - 3 0 4 0 0\nsym f 0 0 2 0 0\nsym hh 0 2 2 14 0\n"
					"sym tv 6 0 5 0 0\nsym tb 6 0 6 0 0\nrel .rela.text 3 8589934594 -4\n"
					"rel .rela.text 18 25769803778 -4\nfile 968\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.local zz\n.type yy, @function\n.size qq, 4\n"
					"f: ret\nyy: ret\nqq: ret\nzz: ret\n",
			"headers 5 1\nsec .strtab 3 0 192 50 0 0 1 0\nsec .text 1 6 64 4 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 68 0 0 0 1 0\nsec .symtab 2 0 72 120 1 5 8 24\n"
					"sym zz 0 0 2 3 0\nsym yy 2 0 2 1 0\nsym f 0 0 2 0 0\nsym qq 0 0 2 2 4\n"
					"file 568\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.hidden hh2\n.internal ii\n.protected pp\nf: ret\n"
					"hh2: ret\nii: ret\npp: ret\n",
			"headers 5 1\nsec .strtab 3 0 192 51 0 0 1 0\nsec .text 1 6 64 4 0 0 4 0\n"
					"sec .note.GNU-stack 1 0 68 0 0 0 1 0\nsec .symtab 2 0 72 120 1 5 8 24\n"
					"sym hh2 0 2 2 1 0\nsym ii 0 1 2 2 0\nsym pp 0 3 2 3 0\nsym f 0 0 2 0 0\n"
					"file 568\n")
	e = elfLayoutCase(e, dir, "x64",
			".arch x64\n.section text\n.weak w\n.hidden h\n.global h\n.comm cm, 16, 8\n"
					".local lc\n.comm lc, 8, 4\n.lcomm lcm, 4\nA = h + 4\nB = f + 1\nf:\n"
					"  lea rax, [rip + A]\n  lea rax, [rip + cm]\n  lea rax, [rip + lc]\n"
					"  lea rax, [rip + lcm]\n  lea rax, [rip + .Lq]\n  lea rax, [rip + w]\n  ret\n"
					"h: ret\nw: ret\n.Lq: ret\n.section data\nd: .uint64 B\n.uint64 .Lq\n"
					".uint64 A\n.uint64 lc\n",
			"headers 9 1\nsec .strtab 3 0 624 79 0 0 1 0\nsec .text 1 6 64 46 0 0 4 0\n"
					"sec .rela.text 4 64 432 96 8 2 8 24\nsec .bss 8 3 112 12 0 0 4 0\n"
					"sec .data 1 3 112 32 0 0 1 0\nsec .rela.data 4 64 528 96 8 5 8 24\n"
					"sec .note.GNU-stack 1 0 144 0 0 0 1 0\nsec .symtab 2 0 144 288 1 9 8 24\n"
					"sym - 3 0 2 0 0\nsym lc 1 0 4 0 8\nsym - 3 0 4 0 0\nsym lcm 1 0 4 8 4\n"
					"sym A 0 0 2 47 0\nsym B 0 0 2 1 0\nsym f 0 0 2 0 0\nsym d 0 0 5 0 0\n"
					"sym w 32 0 2 44 0\nsym h 16 2 2 43 0\nsym cm 17 0 65522 8 16\n"
					"rel .rela.text 10 47244640258 -4\nrel .rela.text 17 12884901890 -4\n"
					"rel .rela.text 24 12884901890 4\nrel .rela.text 38 38654705666 -4\n"
					"rel .rela.data 0 4294967297 1\nrel .rela.data 8 4294967297 45\n"
					"rel .rela.data 16 4294967297 47\nrel .rela.data 24 12884901889 0\nfile 1280\n")
	e = elfLayoutCase(e, dir, "x64", ".arch x64\n.section data\n.global d\nd: .uint64 1\n",
			"headers 6 1\nsec .strtab 3 0 120 47 0 0 1 0\nsec .text 1 6 64 0 0 0 4 0\n"
					"sec .data 1 3 64 8 0 0 1 0\nsec .note.GNU-stack 1 0 72 0 0 0 1 0\n"
					"sec .symtab 2 0 72 48 1 1 8 24\nsym d 16 0 3 0 0\nfile 552\n")
	return e
}
