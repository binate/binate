package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/os"
import "pkg/std/strings"

// Mach-O object layout against clang's (`clang -c -target arm64-apple-macos` /
// `x86_64-apple-macos`, read back as machoLayoutText reads it): LC_SEGMENT_64, then
// LC_BUILD_VERSION, then LC_SYMTAB and LC_DYSYMTAB only when a symbol is listed; the section
// headers in the order the sections were created, `__text` first even when nothing is
// written there; each section aligned only as its contents ask, its contents right after the
// load commands, a zero-fill section placed after the regular ones; S_ATTR_SOME_INSTRUCTIONS
// only on a section holding an instruction.  One field differs on purpose: an AArch64
// `__text` holding instructions has alignment 2^2 where clang's has 2^0, as an instruction
// needs its section 4-aligned wherever it is linked (after another object's `__text` of an
// odd size, say).  (symtabObject is in assemble_symtab_test.bn, tlsU in
// assemble_tls_test.bn, testTmpDir in assemble_test.bn.)

// machoLayoutText returns the layout of the Mach-O object b: `cmds` and its load-command
// types in order, then a line per section header — `segment section addr size offset align
// flags` — then `file` and the file's size, all in decimal.
func machoLayoutText(b @[]uint8) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	sb.Write("cmds")
	var lc int = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		sb.WriteByte(' ')
		stringutils.WriteInt(sb, tlsU(b, lc, 4))
		lc = lc + tlsU(b, lc + 4, 4)
	}
	sb.WriteByte('\n')
	lc = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		if tlsU(b, lc, 4) == 0x19 {
			for i := 0; i < tlsU(b, lc + 64, 4); i++ {
				var s int = lc + 72 + 80 * i
				layoutName(sb, b, s + 16)
				sb.WriteByte(' ')
				layoutName(sb, b, s)
				var fields @[]int = make_slice(int, 5)
				fields[0] = tlsU(b, s + 32, 8)
				fields[1] = tlsU(b, s + 40, 8)
				fields[2] = tlsU(b, s + 48, 4)
				fields[3] = tlsU(b, s + 52, 4)
				fields[4] = tlsU(b, s + 64, 4)
				for k := 0; k < len(fields); k++ {
					sb.WriteByte(' ')
					stringutils.WriteInt(sb, fields[k])
				}
				sb.WriteByte('\n')
			}
		}
		lc = lc + tlsU(b, lc + 4, 4)
	}
	sb.Write("file ")
	stringutils.WriteInt(sb, len(b))
	sb.WriteByte('\n')
	return buf.CopyStr(sb.String())
}

// layoutName writes the 16-byte, NUL-padded name at b[at] to sb.
func layoutName(sb @strings.Builder, b @[]uint8, at int) {
	for k := at; k < at + 16 && b[k] != 0; k++ { sb.WriteByte(b[k]) }
}

// layoutCase appends to e a failure unless src, assembled for arch on darwin, has the layout
// want (machoLayoutText).
func layoutCase(e @[]char, dir *[]readonly char, arch *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	b, msg := symtabObject(dir, arch, src)
	if len(msg) != 0 { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var got @[]char = machoLayoutText(b)
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(buf.Concat("`", src), "`: layout\n"), got))
}

// The layouts of clang's objects for the same sources (2147484672 is S_ATTR_PURE_INSTRUCTIONS
// | S_ATTR_SOME_INSTRUCTIONS, 2147483648 the first alone): data right after three
// instructions at 12, or at 16 after `.p2align 4`; an empty `__text` before the data of a
// data-only file; a local common's `__bss` header where `.lcomm` created it, its address
// after `__data`'s; no symbol or string table in an object with no symbol.
func TestAssembleFileMachoLayoutLikeClang() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = layoutCase(e, dir, "aarch64", ".arch aarch64\n.section text\n.global _f\n_f: ret\n",
			"cmds 25 50 2 11\n__TEXT __text 0 4 312 2 2147484672\n"
					"file 368\n")
	e = layoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_a: ret\nLx: ret\n_b: ret\n.section data\n"
					"_d: .uint64 1\n",
			"cmds 25 50 2 11\n__TEXT __text 0 12 392 2 2147484672\n__DATA __data 12 8 404 0 0\n"
					"file 520\n")
	e = layoutCase(e, dir, "aarch64", ".arch aarch64\n.section data\n.global _d\n_d: .uint64 1\n",
			"cmds 25 50 2 11\n__TEXT __text 0 0 392 0 2147483648\n__DATA __data 0 8 392 0 0\n"
					"file 464\n")
	e = layoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global _f\n_f: adrp x0, _d@PAGE\n"
					" ldr x0, [x0, _d@PAGEOFF]\n ret\n.section data\n.p2align 4\n.global _d\n"
					"_d: .uint64 1\n",
			"cmds 25 50 2 11\n__TEXT __text 0 12 392 2 2147484672\n__DATA __data 16 8 408 4 0\n"
					"file 520\n")
	e = layoutCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global _f\n_f: ret\n.lcomm _c, 8, 3\n"
					".section data\n.global _d\n_d: .uint64 1\n",
			"cmds 25 50 2 11\n__TEXT __text 0 4 472 2 2147484672\n__DATA __bss 16 8 0 3 1\n"
					"__DATA __data 4 8 476 0 0\n"
					"file 616\n")
	e = layoutCase(e, dir, "x64", ".arch x64\n.section text\nret\n",
			"cmds 25 50\n__TEXT __text 0 1 208 0 2147484672\n"
					"file 216\n")
	e = layoutCase(e, dir, "x64",
			".arch x64\n.section text\n.global _f\n_f: lea rax, [rip + _d]\n ret\n"
					".section data\n.global _d\n_d: .uint64 1\n",
			"cmds 25 50 2 11\n__TEXT __text 0 8 392 0 2147484672\n__DATA __data 8 8 400 0 0\n"
					"file 456\n")
	e = layoutCase(e, dir, "x64", ".arch x64\n.section data\n.global _d\n_d: .uint64 1\n",
			"cmds 25 50 2 11\n__TEXT __text 0 0 392 0 2147483648\n__DATA __data 0 8 392 0 0\n"
					"file 424\n")
	return e
}
