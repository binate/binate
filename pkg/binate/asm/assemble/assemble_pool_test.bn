package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/os/process"

// Literal pools through the whole driver: entries holding numbers and symbols (8- and
// 4-byte) are written for ELF and Mach-O; a pool entry out of a load's reach is reported
// by name; on Mach-O a load reaches a pool in a later atom in place, as clang's does on
// AArch64; and on a macOS arm64 host a Mach-O program loading pool numbers links with cc
// and runs.  (A pool entry holding an address in a code section is a text relocation,
// which ld64 rejects for clang's objects too.)
// (asmWrite / asmHas / testTmpDir are in assemble_test.bn.)

// poolSymbols holds pool entries of symbols, 8 and 4 bytes, and a number.
var poolSymbols *[]readonly char = ".arch aarch64\n.section text\n.global _main\n_main:\n"
		" ldr x1, =0x100000002\n ldr x2, =_data\n ldr w4, =_data\n ret\n"
		".section data\n_data: .uint64 40\n"

// poolProgram returns `_main`, which returns 42 = 2 + 40 from three pool numbers (8, 8
// and 4 bytes).
var poolProgram *[]readonly char = ".arch aarch64\n.section text\n.global _main\n_main:\n"
		" ldr x1, =0x100000002\n ldr x3, =0x2800000028\n ldr w4, =0x12345678\n"
		" and x1, x1, #0xff\n and x3, x3, #0xff\n add w0, w1, w3\n ret\n"

// assemblePool writes src to dir/pool.s and assembles it for osName into dir/pool.o.
func assemblePool(dir *[]readonly char, src *[]readonly char,
		osName *[]readonly char) (bool, @[]char) {
	var path @[]char = buf.Concat(dir, "/pool.s")
	if !asmWrite(path, src) { return false, buf.CopyStr("cannot write the test source") }
	return AssembleFile(path, buf.Concat(dir, "/pool.o"), "aarch64", osName)
}

func TestAssembleFileLiteralPools() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	ok, msg := assemblePool(dir, poolSymbols, "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	ok, msg = assemblePool(dir, poolSymbols, "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	ok, msg = assemblePool(dir, ".arch aarch64\n.section text\n ldr x0, =0x123456789\n.zero 1048576\n",
			"linux")
	if ok || !asmHas(msg, "'literal pool entry 0' is out of range") {
		return fail(buf.Concat("an entry out of reach: ", msg))
	}
	var split *[]readonly char = ".arch aarch64\n.section text\n.global _f\n_f: ldr x0, =0x123456789\n"
			" ret\n"
	ok, msg = assemblePool(dir, buf.Concat(split, ".global _g\n_g: ret\n"), "darwin")
	if !ok { return fail(buf.Concat("a pool in a later atom: ", msg)) }
	ok, msg = assemblePool(dir, buf.Concat(split, ".ltorg\n.global _g\n_g: ret\n"), "darwin")
	if !ok { return fail(buf.Concat("with .ltorg: ", msg)) }
	// Two functions loading the same number, with `.ltorg` after each: the second load
	// shares the entry the first `.ltorg` emitted.
	var twice @[]char = buf.Concat(split,
			".ltorg\n.global _g\n_g: ldr x1, =0x123456789\n ret\n.ltorg\n")
	ok, msg = assemblePool(dir, twice, "darwin")
	if !ok { return fail(buf.Concat("two functions: ", msg)) }
	if build.OS != build.OS_DARWIN || build.Arch != build.ARCH_AARCH64 { return "" }
	ok, msg = assemblePool(dir, poolProgram, "darwin")
	if !ok { return fail(msg) }
	var exe @[]char = buf.Concat(dir, "/pool")
	var args @[]@[]char = make_slice(@[]char, 6)
	args[0] = "-arch"
	args[1] = "arm64"
	args[2] = "-o"
	args[3] = buf.CopyStr(exe)
	args[4] = buf.Concat(dir, "/pool.o")
	args[5] = "-Wl,-e,_main"
	var st process.ExitStatus
	var err @errors.Error
	st, err = process.Run("cc", &process.Options{SearchPath: true, Args: args})
	if present(err) || !st.Exited() || st.Code() != 0 { return fail("the object does not link") }
	st, err = process.Run(exe, &process.Options{Args: make_slice(@[]char, 0)})
	if present(err) || !st.Exited() || st.Code() != 42 {
		return fail("the program does not return 42")
	}
	return ""
}

// poolTextSize assembles src for Mach-O (macho) or ELF and returns the size of its text
// section, or -1.  (tlsRead, tlsU, elfShdr, elfSectionIndex and machoSection are in
// assemble_tls_test.bn.)
func poolTextSize(dir *[]readonly char, src *[]readonly char, macho bool) int {
	var osName *[]readonly char = "linux"
	if macho { osName = "darwin" }
	ok, _ := assemblePool(dir, src, osName)
	if !ok { return -1 }
	var b @[]uint8 = tlsRead(buf.Concat(dir, "/pool.o"))
	if macho {
		var sh int = machoSection(b, "__text")
		if sh < 0 { return -1 }
		return tlsU(b, sh + 40, 8)
	}
	var si int = elfSectionIndex(b, true, ".text")
	if si < 0 { return -1 }
	return tlsU(b, elfShdr(b, true, si) + 32, 8)
}

// A second function's load shares the first's entry, for ELF and Mach-O alike, as clang's
// does: the text is the two functions and one 8-byte entry (24 bytes), where two different
// numbers take two entries.
func TestAssembleFilePoolSharedAcrossFunctions() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var oneNum *[]readonly char = ".section text\n.global f\nf: ldr x0, =0x123456789\n ret\n"
			".global g\ng: ldr x1, =0x123456789\n ret\n"
	var twoNums *[]readonly char = ".section text\n.global f\nf: ldr x0, =0x123456789\n ret\n"
			".global g\ng: ldr x1, =0x123456788\n ret\n"
	for m := 0; m < 2; m++ {
		var oneSize int = poolTextSize(dir, oneNum, m == 1)
		var twoSize int = poolTextSize(dir, twoNums, m == 1)
		var format *[]readonly char = "ELF"
		if m == 1 { format = "Mach-O" }
		if oneSize != 24 || twoSize != 32 {
			return fail(buf.Concat(format, ": the loads of one number do not share its entry"))
		}
	}
	return ""
}
