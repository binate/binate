package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The ELF-only relocation operators through the whole driver — the MOVW group,
// `:pg_hi21_nc:`, a `:got:` literal load and `:gotpage_lo15:` (beside a STR through
// `:got_lo12:`, which Mach-O does have): an ELF object is written; Mach-O has no
// relocation for them, and the error names the symbol and the operator.  (asmWrite /
// asmHas / testTmpDir are in assemble_test.bn.)
func TestAssembleFileElfOnlyOperators() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var src @[]char = buf.Concat(dir, "/movw.s")
	if !asmWrite(src,
			".arch aarch64\n.section text\n.global _g\n_f: movz x0, #:abs_g1:_g\n"
					" movk x0, #:abs_g0_nc:_g\n movz x1, #:prel_g0:_f\n ret\n") {
		return fail("cannot write the test source")
	}
	ok, msg := AssembleFile(src, buf.Concat(dir, "/movw_elf.o"), "aarch64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	ok, msg = AssembleFile(src, buf.Concat(dir, "/movw_macho.o"), "aarch64", "darwin")
	if ok || !asmHas(msg, "reference to '_g' (the `:abs_g*:` / `:prel_g*:` operators are ELF-only)") {
		return fail(buf.Concat("Mach-O: ", msg))
	}
	var src2 @[]char = buf.Concat(dir, "/pgnc.s")
	if !asmWrite(src2,
			".arch aarch64\n.section text\n.global _g\n_f: adrp x0, :pg_hi21_nc:_g\n ret\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src2, buf.Concat(dir, "/pgnc_elf.o"), "aarch64", "linux")
	if !ok { return fail(buf.Concat("ELF, :pg_hi21_nc:: ", msg)) }
	ok, msg = AssembleFile(src2, buf.Concat(dir, "/pgnc_macho.o"), "aarch64", "darwin")
	if ok || !asmHas(msg, "reference to '_g' (`:pg_hi21_nc:` is ELF-only)") {
		return fail(buf.Concat("Mach-O, :pg_hi21_nc:: ", msg))
	}
	var src3 @[]char = buf.Concat(dir, "/got.s")
	if !asmWrite(src3,
			".arch aarch64\n.section text\n.global _g\n_f: ldr x0, :got:_g\n"
					" ldr x1, [x2, :gotpage_lo15:_g]\n str x3, [x4, :got_lo12:_g]\n ret\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src3, buf.Concat(dir, "/got_elf.o"), "aarch64", "linux")
	if !ok { return fail(buf.Concat("ELF, GOT forms: ", msg)) }
	ok, msg = AssembleFile(src3, buf.Concat(dir, "/got_macho.o"), "aarch64", "darwin")
	if ok || !asmHas(msg, "reference to '_g' (a `:got:` literal load is ELF-only)") {
		return fail(buf.Concat("Mach-O, GOT literal: ", msg))
	}
	// Mach-O does have a GOT-slot page offset on every 8-byte transfer (GOT_LOAD_PAGEOFF12).
	var src4 @[]char = buf.Concat(dir, "/gotoff.s")
	if !asmWrite(src4,
			".arch aarch64\n.section text\n.global _g\n_f: adrp x4, _g@GOTPAGE\n"
					" str x3, [x4, _g@GOTPAGEOFF]\n ldr d0, [x4, _g@GOTPAGEOFF]\n"
					" prfm pldl1keep, [x4, _g@GOTPAGEOFF]\n ret\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src4, buf.Concat(dir, "/gotoff_macho.o"), "aarch64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O, 8-byte @GOTPAGEOFF: ", msg)) }
	return ""
}
