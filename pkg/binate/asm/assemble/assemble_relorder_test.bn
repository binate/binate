package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/os"
import "pkg/std/strings"

// Mach-O relocations come in clang's order (`clang -c -target arm64-apple-macos` /
// `x86_64-apple-macos`): each section's in reverse, an ARM64_RELOC_ADDEND or SUBTRACTOR entry
// still before the relocation it belongs to.  (symtabObject is in assemble_symtab_test.bn,
// tlsU and tlsU64 in assemble_tls_test.bn, testTmpDir in assemble_test.bn.)

// machoRelocEntries returns, for each section of the Mach-O object b, its name and its
// relocation entries in file order (`r_address info`, in decimal), a line each.
func machoRelocEntries(b @[]uint8) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	var lc int = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		if tlsU(b, lc, 4) == 0x19 {
			for s := 0; s < tlsU(b, lc + 64, 4); s++ {
				var sh int = lc + 72 + s * 80
				for k := sh; k < sh + 16 && b[k] != 0; k++ { sb.WriteByte(b[k]) }
				sb.WriteByte('\n')
				for k := 0; k < tlsU(b, sh + 60, 4); k++ {
					var e int = tlsU(b, sh + 56, 4) + 8 * k
					// int64: an info word's top bits are its type (ARM64_RELOC_ADDEND is 10),
					// which an int on a 32-bit host would print negative.
					stringutils.WriteInt64(sb, tlsU64(b, e, 4))
					sb.WriteByte(' ')
					stringutils.WriteInt64(sb, tlsU64(b, e + 4, 4))
					sb.WriteByte('\n')
				}
			}
		}
		lc = lc + tlsU(b, lc + 4, 4)
	}
	return buf.CopyStr(sb.String())
}

// relOrderCase appends to e a failure unless src, assembled for arch on darwin, has clang's
// relocation entries in clang's order, want (machoRelocEntries).
func relOrderCase(e @[]char, dir *[]readonly char, arch *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	b, msg := symtabObject(dir, arch, src)
	if len(msg) != 0 { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var got @[]char = machoRelocEntries(b)
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(buf.Concat("`", src), "`: relocations\n"), got))
}

// ADRP / ADD lo12 with addends (each with its ADDEND entry), two BLs, a word and a difference
// (SUBTRACTOR then UNSIGNED) on AArch64; two calls, a RIP-relative `lea`, a word and a
// difference on x86-64.
func TestAssembleFileMachoRelocationOrder() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = relOrderCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global _f\n.global _ext\n.global _ext2\n"
					"_f: adrp x0, _ext@PAGE+16\n add x0, x0, _ext@PAGEOFF+16\n bl _ext\n bl _ext2\n"
					".section data\n.global _d\n_d: .uint64 _ext\n .uint64 _ext - _f\n",
			"__text\n12 754974725\n8 754974724\n4 2751463440\n4 1275068420\n0 2751463440\n"
					"0 1023410180\n__data\n8 503316483\n8 234881028\n0 234881028\n")
	e = relOrderCase(e, dir, "x64",
			".arch x64\n.section text\n.global _f\n.global _ext\n.global _ext2\n"
					"_f: call _ext\n call _ext2\n lea rax, [rip + _ext + 8]\n ret\n"
					".section data\n.global _d\n_d: .uint64 _ext\n .uint64 _d - _f\n",
			"__text\n13 486539266\n6 754974723\n1 754974722\n__data\n8 1577058305\n"
					"8 234881024\n0 234881026\n")
	return e
}
