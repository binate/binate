package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/os/process"

// `.subsections_via_symbols` through the whole driver, against clang (`clang -c -target
// arm64-apple-macos` / `x86_64-apple-macos`; otool -h, -rv and -t): the Mach-O header
// claims MH_SUBSECTIONS_VIA_SYMBOLS only when the source writes the directive.  Without it
// an AArch64 branch to another atom's symbol in the section is patched in place, the linker
// keeping the section whole, while an x86-64 call is a relocation either way; with it the
// AArch64 branch is a relocation, and a conditional branch, which has none, an error.  On
// an arm64 macOS host a program whose load reaches a literal pool in the atom of a
// function nothing calls links with -dead_strip and runs: without the directive the
// linker cannot strip that function, and the pool with it.  (tlsRead, tlsU and
// machoSection are in assemble_tls_test.bn, machoRelocAt in assemble_tlv_test.bn.)

// subsecObject assembles src for arch on darwin into dir/subsec.o and returns its bytes,
// or empty bytes and the error.
func subsecObject(dir *[]readonly char, src *[]readonly char,
		arch *[]readonly char) (@[]uint8, @[]char) {
	var path @[]char = buf.Concat(dir, "/subsec.s")
	if !asmWrite(path, src) { return make_slice(uint8, 0), buf.CopyStr("cannot write the source") }
	var obj @[]char = buf.Concat(dir, "/subsec.o")
	ok, msg := AssembleFile(path, obj, arch, "darwin")
	if !ok { return make_slice(uint8, 0), msg }
	return tlsRead(obj), ""
}

// subsecText returns the first instruction word of b's __text section and the type of the
// relocation at its start (-1 when none is there), or (0, -2) when b has no __text.
func subsecText(b @[]uint8) (uint32, int) {
	var text int = machoSection(b, "__text")
	if text < 0 { return 0, -2 }
	t, _ := machoRelocAt(b, text, 0)
	return cast(uint32, tlsU(b, tlsU(b, text + 48, 4), 4)), t
}

func TestAssembleFileSubsectionsViaSymbols() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var bl *[]readonly char = ".arch aarch64\n.section text\n.global _f\n_f: bl _g\n ret\n"
			".global _g\n_g: ret\n"
	b, msg := subsecObject(dir, bl, "aarch64")
	if len(msg) != 0 { return fail(buf.Concat("AArch64: ", msg)) }
	w, t := subsecText(b)
	if tlsU(b, 24, 4) != 0 || w != 0x94000002 || t != -1 {
		return fail("AArch64: bl _g is not patched in place in an object without subsections")
	}
	b, msg = subsecObject(dir, buf.Concat(bl, ".subsections_via_symbols\n"), "aarch64")
	if len(msg) != 0 { return fail(buf.Concat("AArch64 with the directive: ", msg)) }
	w, t = subsecText(b)
	if tlsU(b, 24, 4) != 0x2000 || w != 0x94000000 || t != 2 {
		return fail("AArch64 with the directive: bl _g is not a BRANCH26 relocation")
	}
	var beq *[]readonly char = ".arch aarch64\n.section text\n_f:\n nop\n_g:\n b.eq _f\n"
	b, msg = subsecObject(dir, beq, "aarch64")
	if len(msg) != 0 { return fail(buf.Concat("a conditional branch to another atom: ", msg)) }
	_, msg = subsecObject(dir, buf.Concat(beq, ".subsections_via_symbols\n"), "aarch64")
	if !asmHas(msg, "no Mach-O relocation") {
		return fail(buf.Concat("a conditional branch to another atom, with the directive: ", msg))
	}
	var call *[]readonly char = ".arch x64\n.section text\n.global _f\n_f: call _g\n ret\n"
			".global _g\n_g: ret\n"
	b, msg = subsecObject(dir, call, "x64")
	if len(msg) != 0 { return fail(buf.Concat("x86-64: ", msg)) }
	var text int = machoSection(b, "__text")
	t, _ = machoRelocAt(b, text, 1)
	if tlsU(b, 24, 4) != 0 || t != 2 { return fail("x86-64: call _g is not a BRANCH relocation") }
	// With no `.arch`, the arch and OS given up front name the object format the directive needs.
	b, msg = subsecObject(dir, ".section text\n.subsections_via_symbols\n ret\n", "aarch64")
	if len(msg) != 0 || tlsU(b, 24, 4) != 0x2000 { return fail(buf.Concat("before any .arch: ", msg)) }
	if build.OS != build.OS_DARWIN || build.Arch != build.ARCH_AARCH64 { return "" }
	// _main's load reaches the pool flushed at the end of the section, in _unused's atom.
	var prog *[]readonly char = ".arch aarch64\n.section text\n.global _main\n"
			"_main: ldr x0, =0x2A0000002A\n and x0, x0, #0xff\n ret\n.global _unused\n_unused: ret\n"
	_, msg = subsecObject(dir, prog, "aarch64")
	if len(msg) != 0 { return fail(buf.Concat("the dead-strip program: ", msg)) }
	var exe @[]char = buf.Concat(dir, "/subsec")
	var args @[]@[]char = @[]@[]char{"-arch", "arm64", "-o", buf.CopyStr(exe),
			buf.Concat(dir, "/subsec.o"), "-Wl,-e,_main", "-Wl,-dead_strip"}
	var st process.ExitStatus
	var err @errors.Error
	st, err = process.Run("cc", &process.Options{SearchPath: true, Args: args})
	if present(err) || !st.Exited() || st.Code() != 0 { return fail("the program does not link") }
	st, err = process.Run(exe, &process.Options{Args: make_slice(@[]char, 0)})
	if present(err) || !st.Exited() || st.Code() != 42 {
		return fail("the program linked with -dead_strip does not return 42")
	}
	return ""
}
