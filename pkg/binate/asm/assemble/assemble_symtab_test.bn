package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/os/process"
import "pkg/std/strings"

// Mach-O symbol and string tables against clang's (`clang -c -target arm64-apple-macos` /
// `x86_64-apple-macos`, the tables read back as machoSymtabText reads them): on AArch64 an
// `ltmp<N>` anchor for every section, among the locals where its section was created; the
// locals in creation order, the defined externals and the undefined symbols each sorted by
// name; a string table of the listed names alone, tail-merged and padded as LLVM lays it
// out.  (tlsRead, tlsU and machoSection are in assemble_tls_test.bn, machoRelocInfo and
// machoSymbolIs in assemble_tlv_test.bn, asmWrite / asmHas / testTmpDir in
// assemble_test.bn.)

// machoSymtabText returns the symbol table of the Mach-O object b, an entry a line —
// `name n_type n_sect n_desc n_value`, in decimal — then `strtab` and the string table in
// hex.
func machoSymtabText(b @[]uint8) @[]char {
	var sb @strings.Builder = strings.NewBuilder()
	var lc int = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		if tlsU(b, lc, 4) == 2 {
			var symoff int = tlsU(b, lc + 8, 4)
			var stroff int = tlsU(b, lc + 16, 4)
			for i := 0; i < tlsU(b, lc + 12, 4); i++ {
				var e int = symoff + 16 * i
				for k := stroff + tlsU(b, e, 4); k < len(b) && b[k] != 0; k++ { sb.WriteByte(b[k]) }
				sb.WriteByte(' ')
				stringutils.WriteInt(sb, tlsU(b, e + 4, 1))
				sb.WriteByte(' ')
				stringutils.WriteInt(sb, tlsU(b, e + 5, 1))
				sb.WriteByte(' ')
				stringutils.WriteInt(sb, tlsU(b, e + 6, 2))
				sb.WriteByte(' ')
				stringutils.WriteInt(sb, tlsU(b, e + 8, 8))
				sb.WriteByte('\n')
			}
			sb.Write("strtab ")
			for k := 0; k < tlsU(b, lc + 20, 4); k++ { stringutils.WriteHexByte(sb, tlsU(b, stroff + k, 1)) }
		}
		lc = lc + tlsU(b, lc + 4, 4)
	}
	return buf.CopyStr(sb.String())
}

// symtabObject assembles src for arch on darwin into dir/symtab.o and returns its bytes, or
// empty bytes and the error.
func symtabObject(dir *[]readonly char, arch *[]readonly char,
		src *[]readonly char) (@[]uint8, @[]char) {
	var path @[]char = buf.Concat(dir, "/symtab.s")
	if !asmWrite(path, src) { return make_slice(uint8, 0), buf.CopyStr("cannot write the source") }
	var obj @[]char = buf.Concat(dir, "/symtab.o")
	ok, msg := AssembleFile(path, obj, arch, "darwin")
	if !ok { return make_slice(uint8, 0), msg }
	return tlsRead(obj), ""
}

// symtabCase appends to e a failure unless src, assembled for arch on darwin, has the symbol
// and string tables want (machoSymtabText), clang's for the same source.
func symtabCase(e @[]char, dir *[]readonly char, arch *[]readonly char, src *[]readonly char,
		want *[]readonly char) @[]char {
	b, msg := symtabObject(dir, arch, src)
	if len(msg) != 0 { return buf.Concat(e, buf.Concat(buf.Concat("rejected: ", msg), "\n")) }
	var got @[]char = machoSymtabText(b)
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(buf.Concat("`", src), "`: tables\n"), got))
}

// The tables of clang's objects: externals and undefined symbols sorted by name (both
// arches), an anchor at each section's start on AArch64, placed where its section was
// created (`sects`), a name kept inside the one it ends (`_x` in `a_x`), an alias at a
// section's start listed as a plain symbol beside the anchor, a `.global_c` symbol under its
// `_` name, and locals where their names are first mentioned: a label referred to before it
// is defined (both arches, from another section, by an alias, by a label difference, by a
// local common's reference), a constant where it is assigned, and the symbols a literal-pool
// entry uses where the entry is emitted, not at its load.
func TestAssembleFileMachoSymtabLikeClang() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var e @[]char = ""
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global _zz\n.global _a\n.global _m\n"
					".global _uz\n.global _ua\n_zz: bl _uz\n bl _ua\n ret\n_m: ret\n_a: ret\n"
					"_loc2: ret\n_loc1: ret\n",
			"ltmp0 14 1 0 0\n_loc2 14 1 0 20\n_loc1 14 1 0 24\n_a 15 1 0 16\n"
					"_m 15 1 0 12\n_zz 15 1 0 0\n_ua 1 0 0 0\n_uz 1 0 0 0\n"
					"strtab 005F7A7A005F757A005F6D005F7561005F61005F6C6F6332005F6C6F6331006C7"
					"46D703000000000")
	e = symtabCase(e, dir, "x64",
			".arch x64\n.section text\n.global _zz\n.global _a\n.global _m\n"
					".global _uz\n.global _ua\n_zz: call _uz\n call _ua\n ret\n_m: ret\n"
					"_a: ret\n_loc2: ret\n_loc1: ret\n",
			"_loc2 14 1 0 13\n_loc1 14 1 0 14\n_a 15 1 0 12\n_m 15 1 0 11\n"
					"_zz 15 1 0 0\n_ua 1 0 0 0\n_uz 1 0 0 0\n"
					"strtab 005F7A7A005F757A005F6D005F7561005F61005F6C6F6332005F6C6F63310000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\na_x: ret\n.global _x\n_x: ret\n"
					".global _main\n_main: ret\n",
			"ltmp0 14 1 0 0\na_x 14 1 0 0\n_main 15 1 0 8\n_x 15 1 0 4\n"
					"strtab 00615F78005F6D61696E006C746D70300000000000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_t1: ret\n.section data\n_d1: .uint64 1\n"
					".section text\n_t2: ret\n.section data\n_d2: .uint64 2\n"
					".section rodata\n_c1: .uint64 3\n",
			"ltmp0 14 1 0 0\n_t1 14 1 0 0\nltmp1 14 2 0 8\n_d1 14 2 0 8\n"
					"_t2 14 1 0 4\n_d2 14 2 0 16\nltmp2 14 3 0 24\n_c1 14 3 0 24\n"
					"strtab 005F7432006C746D7032005F6432005F7431006C746D7031005F6431005F63310"
					"06C746D70300000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\nLx: ret\n.global _A\n_A = Lx\n"
					".global _main\n_main: ret\n",
			"ltmp0 14 1 0 0\n_A 15 1 0 0\n_main 15 1 0 4\n"
					"strtab 005F6D61696E005F41006C746D703000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n.global_c f\nf: ret\n.global _b\n_b: ret\n",
			"ltmp0 14 1 0 0\n_b 15 1 0 4\n_f 15 1 0 0\n"
					"strtab 005F66005F62006C746D703000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: bl _h\n ret\n_g: ret\n_h: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_h 14 1 0 12\n_g 14 1 0 8\n"
					"strtab 005F68005F67005F66006C746D703000")
	e = symtabCase(e, dir, "x64", ".arch x64\n.section text\n_f: call _h\n ret\n_g: ret\n_h: ret\n",
			"_f 14 1 0 0\n_h 14 1 0 7\n_g 14 1 0 6\n"
					"strtab 005F68005F67005F6600000000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: adrp x0, _d2@PAGE\n ret\n"
					".section data\n_d1: .uint64 1\n_d2: .uint64 2\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_d2 14 2 0 16\nltmp1 14 2 0 8\n"
					"_d1 14 2 0 8\nstrtab 005F66005F6432006C746D7031005F6431006C746D703000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_a = _f + 4\nM = 7\n_g: ret\n"
					"_h: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_a 14 1 512 4\nM 2 0 0 7\n_g 14 1 0 4\n"
					"_h 14 1 0 8\nstrtab 005F68005F67005F66005F61004D006C746D703000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n_a = _h + 4\n_g: ret\n_h: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_a 14 1 512 12\n_h 14 1 0 8\n_g 14 1 0 4\n"
					"strtab 005F68005F67005F66005F61006C746D7030000000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ret\n.uint64 _b - _a\n_g: ret\n"
					"_a: ret\n_b: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_b 14 1 0 20\n_a 14 1 0 16\n_g 14 1 0 12\n"
					"strtab 005F67005F66005F62005F61006C746D7030000000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: adrp x0, _c@PAGE\n ret\n_g: ret\n"
					".lcomm _c, 8\n_h: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_c 14 2 0 16\n_g 14 1 0 8\n"
					"ltmp1 14 2 0 16\n_h 14 1 0 12\n"
					"strtab 005F68005F67005F66005F63006C746D7031006C746D70300000000000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ldr x0, =_h\n ret\n_g: ret\n.ltorg\n"
					"_k: ret\n_h: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_g 14 1 0 8\n_h 14 1 0 28\n_k 14 1 0 24\n"
					"strtab 005F6B005F68005F67005F66006C746D7030000000000000")
	e = symtabCase(e, dir, "aarch64",
			".arch aarch64\n.section text\n_f: ldr x0, =Lb - _a\n ret\n_g: ret\n"
					"_a: nop\nLb: ret\n",
			"ltmp0 14 1 0 0\n_f 14 1 0 0\n_g 14 1 0 8\n_a 14 1 0 12\n"
					"strtab 005F67005F66005F61006C746D703000")
	return e
}

// symtabPeerSource loads the word at Lx, which shares its address with _d at the start of
// data (an anchor ltmp1 there too): 7.
var symtabPeerSource *[]readonly char = ".arch aarch64\n.section text\n.global _main\n"
		"_main: adrp x1, Lx@PAGE\n add x1, x1, Lx@PAGEOFF\n ldr w0, [x1]\n ret\n"
		".section data\nLx:\n.global _d\n_d: .uint64 7\n"

// A reference to a temporary at an anchor's address goes against the anchor, as clang's
// does, in an object whose sections are whole; in one divisible at its symbols it goes
// against the symbol sharing that address instead, since ld64 rejects a relocation against
// the anchor there ("invalid r_symbolnum", clang's object included) — on x86-64 too, with no
// anchor listed — and on an arm64 macOS host that object links with -dead_strip and returns 7.
func TestAssembleFileMachoAnchorPeer() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	b, msg := symtabObject(dir, "aarch64", symtabPeerSource)
	if len(msg) != 0 { return fail(buf.Concat("whole sections: ", msg)) }
	var info int64 = machoRelocInfo(b, machoSection(b, "__text"), 0)
	if info < 0 || !machoSymbolIs(b, cast(int, info & 0xFFFFFF), "ltmp1") {
		return fail("whole sections: the reference is not against ltmp1")
	}
	b, msg = symtabObject(dir, "aarch64", buf.Concat(symtabPeerSource, ".subsections_via_symbols\n"))
	if len(msg) != 0 { return fail(buf.Concat("subsections: ", msg)) }
	info = machoRelocInfo(b, machoSection(b, "__text"), 0)
	if info < 0 || !machoSymbolIs(b, cast(int, info & 0xFFFFFF), "_d") {
		return fail("subsections: the reference is not against _d")
	}
	// On x86-64, where no anchor is defined unless used, the peer leaves none listed.
	b, msg = symtabObject(dir, "x64",
			".arch x64\n.section text\n.global _main\n_main: lea rax, [rip + Lx]\n ret\n"
					".section data\nLx:\n.global _d\n_d: .uint64 7\n.subsections_via_symbols\n")
	if len(msg) != 0 { return fail(buf.Concat("x86-64: ", msg)) }
	info = machoRelocInfo(b, machoSection(b, "__text"), 3)
	if info < 0 || !machoSymbolIs(b, cast(int, info & 0xFFFFFF), "_d") ||
			asmHas(machoSymtabText(b), "ltmp") {
		return fail("x86-64: the reference is not against _d, or an anchor is listed")
	}
	if build.OS != build.OS_DARWIN || build.Arch != build.ARCH_AARCH64 { return "" }
	b, msg = symtabObject(dir, "aarch64", buf.Concat(symtabPeerSource, ".subsections_via_symbols\n"))
	if len(msg) != 0 { return fail(buf.Concat("subsections, for the link: ", msg)) }
	var exe @[]char = buf.Concat(dir, "/symtab")
	var args @[]@[]char = @[]@[]char{"-arch", "arm64", "-o", buf.CopyStr(exe),
			buf.Concat(dir, "/symtab.o"), "-Wl,-e,_main", "-Wl,-dead_strip"}
	var st process.ExitStatus
	var err @errors.Error
	st, err = process.Run("cc", &process.Options{SearchPath: true, Args: args})
	if present(err) || !st.Exited() || st.Code() != 0 { return fail("the object does not link") }
	st, err = process.Run(exe, &process.Options{Args: make_slice(@[]char, 0)})
	if present(err) || !st.Exited() || st.Code() != 7 { return fail("the program does not return 7") }
	return ""
}

// A short-range reference Mach-O has no relocation for names the label the source wrote,
// not the section anchor it was moved to: `adr x0, Ld` with Ld in data.
func TestAssembleFileMachoErrorNamesLabel() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	_, msg := symtabObject(dir, "aarch64",
			".arch aarch64\n.section text\n_f: adr x0, Ld\n ret\n.section data\n.uint64 0\nLd: .uint64 1\n")
	if !asmHas(msg, "no Mach-O relocation for the reference to 'Ld'") {
		return fail(buf.Concat("wrong error: ", msg))
	}
	return ""
}
