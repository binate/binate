package "pkg/binate/asm/assemble"

import "pkg/binate/asm/parse"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

func fail(msg @[]char) testing.TestResult { return msg }

// TestAssembleFileUnknownArch: an unrecognized -arch is rejected before any
// file I/O (the arch check precedes ParseFile), and returns an error rather
// than exiting the process.
func TestAssembleFileUnknownArch() testing.TestResult {
	var ok bool = false
	var msg @[]char = ""
	ok, msg = AssembleFile("dummy.s", "dummy.o", "sparc", "")
	if ok {
		return fail("expected failure for an unknown architecture")
	}
	if !charsEqual(msg, "unknown architecture") {
		return fail("expected the 'unknown architecture' message")
	}
	return ""
}

// TestAssembleFileMissingInput: a missing input file surfaces the parser's
// open error as (false, msg) — the library never exits, so an embedding caller
// can handle it.
func TestAssembleFileMissingInput() testing.TestResult {
	var ok bool = true
	ok, _ = AssembleFile("/nonexistent/definitely/missing.s", "/tmp/bnas_assemble_test_missing.o",
			"arm32", "")
	if ok {
		return fail("expected failure for a missing input file")
	}
	return ""
}

// TestUseMachoFor: object-format selection.  osName "" keeps the per-arch host
// default (aarch64 -> Mach-O, x64/arm32 -> ELF); "linux" forces ELF and "darwin"
// forces Mach-O for every arch; an unrecognized OS is an error.
func TestUseMachoFor() testing.TestResult {
	var m bool = false
	var e @[]char = ""

	// Default (host convention).
	m, e = useMachoFor(parse.ARCH_AARCH64, "")
	if len(e) != 0 || !m { return fail("aarch64 default should be Mach-O") }
	m, e = useMachoFor(parse.ARCH_X64, "")
	if len(e) != 0 || m { return fail("x64 default should be ELF") }
	m, e = useMachoFor(parse.ARCH_ARM32, "")
	if len(e) != 0 || m { return fail("arm32 default should be ELF") }

	// linux forces ELF regardless of arch (this is what unblocks ELF-aarch64).
	m, e = useMachoFor(parse.ARCH_AARCH64, "linux")
	if len(e) != 0 || m { return fail("linux aarch64 should be ELF") }
	m, e = useMachoFor(parse.ARCH_X64, "linux")
	if len(e) != 0 || m { return fail("linux x64 should be ELF") }

	// darwin forces Mach-O regardless of arch.
	m, e = useMachoFor(parse.ARCH_X64, "darwin")
	if len(e) != 0 || !m { return fail("darwin x64 should be Mach-O") }
	m, e = useMachoFor(parse.ARCH_AARCH64, "macos")
	if len(e) != 0 || !m { return fail("macos aarch64 should be Mach-O") }

	// Unknown OS is an error.
	m, e = useMachoFor(parse.ARCH_AARCH64, "plan9")
	if len(e) == 0 { return fail("an unknown os should be rejected") }
	return ""
}

// assembleText writes src as a `.s` file in a fresh temporary directory and
// runs AssembleFile on it for archName (osName "" — the per-arch default
// object format), returning AssembleFile's result.  The directory and its
// contents are removed afterwards.
func assembleText(src *[]readonly char, archName *[]readonly char) (bool, @[]char) {
	dir, derr := os.MkdirTemp("/tmp", "bnas_assemble_test_")
	if present(derr) {
		return false, buf.CopyStr("cannot create a temporary directory")
	}
	var sPath @[]char = buf.Concat(dir, "/in.s")
	var oPath @[]char = buf.Concat(dir, "/out.o")
	f, ferr := os.OpenFile(sPath, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(ferr) {
		_ = os.Remove(dir)
		return false, buf.CopyStr("cannot write the temporary .s file")
	}
	var b @[]uint8 = make_slice(uint8, len(src))
	for i := 0; i < len(src); i++ {
		b[i] = cast(uint8, src[i])
	}
	_, _ = f.Write(b)
	_ = f.Close()
	ok, msg := AssembleFile(sPath, oPath, archName, "")
	_ = os.Remove(oPath)
	_ = os.Remove(sPath)
	_ = os.Remove(dir)
	return ok, msg
}

// rejectsAfterGoodLines checks that the well-formed lines in good assemble for
// archName, and that appending bad — a line whose operand the instruction
// encoder cannot encode — fails the whole file.  The encoder records that
// error on the Assembler rather than as a parse error, so this pins that
// AssembleFile surfaces it instead of writing an object without the line.
func rejectsAfterGoodLines(archName *[]readonly char, good *[]readonly char,
		bad *[]readonly char) testing.TestResult {
	ok, msg := assembleText(good, archName)
	if !ok {
		return fail(buf.Concat(buf.Concat(archName, ": the well-formed lines failed: "), msg))
	}
	ok, _ = assembleText(buf.Concat(good, bad), archName)
	if ok {
		return fail(buf.Concat(buf.Concat(archName, ": expected failure for: "), bad))
	}
	return ""
}

// An AArch64 logical immediate that is not a bitmask pattern.
func TestAssembleFileRejectsUnencodableAArch64() testing.TestResult {
	return rejectsAfterGoodLines("aarch64", ".section text\nand x0, x1, #0xff\n", "and x0, x1, #5\n")
}

// An ARM32 Operand2 immediate that needs an odd rotation.
func TestAssembleFileRejectsUnencodableArm32() testing.TestResult {
	return rejectsAfterGoodLines("arm32", ".section text\nand r0, r1, #0xff\n", "and r0, r1, #0x102\n")
}

// An x86-64 64-bit ALU immediate that does not fit the sign-extended imm32.
func TestAssembleFileRejectsUnencodableX64() testing.TestResult {
	return rejectsAfterGoodLines("x64", ".section text\nand rcx, -16\n", "and rcx, 0x100000000\n")
}
