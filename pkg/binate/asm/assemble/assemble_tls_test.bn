package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Thread-local sections and symbols through the whole driver, against clang's objects
// (`clang -c`; llvm-readelf -S -s, llvm-objdump --macho): on ELF, tdata and tbss (alone or with
// a suffix) are SHF_WRITE | SHF_ALLOC | SHF_TLS, tbss SHT_NOBITS, and every symbol defined in
// them is STT_TLS — a `.type`d function and an alias included — as are a `.type tls_object` in
// data and an undefined one; on Mach-O they are __DATA,__thread_data / __thread_bss, with
// thread_vars as __DATA,__thread_vars, each its thread-local section type, and `.tbss` fills
// __thread_bss.  (asmWrite / asmHas / testTmpDir are in assemble_test.bn.)

// tlsRead returns the bytes of the object at path (at most 16 KiB), empty when unreadable.
func tlsRead(path *[]readonly char) @[]uint8 {
	var whole @[]uint8 = make_slice(uint8, 16384)
	f, err := os.Open(path)
	if present(err) { return make_slice(uint8, 0) }
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = whole
	n, _ := f.Read(raw)
	_ = f.Close()
	return whole[0:n]
}

// tlsU returns the n-byte little-endian number at off in b (0 past its end).
func tlsU(b @[]uint8, off int, n int) int {
	if off < 0 || off + n > len(b) { return 0 }
	var v int = 0
	for i := n - 1; i >= 0; i = i - 1 { v = (v << 8) | cast(int, b[off + i]) }
	return v
}

// tlsNameIs reports whether the NUL-terminated string at at in b is want.
func tlsNameIs(b @[]uint8, at int, want *[]readonly char) bool {
	if at < 0 || at + len(want) >= len(b) { return false }
	for i := 0; i < len(want); i++ { if b[at + i] != want[i] { return false } }
	return b[at + len(want)] == 0
}

// elfShdr returns the offset in the ELF object b (64-bit when is64) of its section header i.
func elfShdr(b @[]uint8, is64 bool, i int) int {
	if is64 { return tlsU(b, 40, 8) + i * tlsU(b, 58, 2) }
	return tlsU(b, 32, 4) + i * tlsU(b, 46, 2)
}

// elfSectionIndex returns the index of the section named name in the ELF object b, or -1.
func elfSectionIndex(b @[]uint8, is64 bool, name *[]readonly char) int {
	var w int = 4
	var shnum int = tlsU(b, 48, 2)
	var strndx int = tlsU(b, 50, 2)
	if is64 {
		w = 8
		shnum = tlsU(b, 60, 2)
		strndx = tlsU(b, 62, 2)
	}
	var strtab int = tlsU(b, elfShdr(b, is64, strndx) + 8 + 2 * w, w)
	for i := 0; i < shnum; i++ {
		if tlsNameIs(b, strtab + tlsU(b, elfShdr(b, is64, i), 4), name) { return i }
	}
	return -1
}

// elfSectionIs reports whether the ELF object b has a section name of type stype and flags.
func elfSectionIs(b @[]uint8, is64 bool, name *[]readonly char, stype int, flags int) bool {
	var i int = elfSectionIndex(b, is64, name)
	if i < 0 { return false }
	var sh int = elfShdr(b, is64, i)
	var w int = 4
	if is64 { w = 8 }
	return tlsU(b, sh + 4, 4) == stype && tlsU(b, sh + 8, w) == flags
}

// elfSymbolIs reports whether the ELF object b's symbol table has name with st_info info, in
// the section named sect ("" for none: undefined).
func elfSymbolIs(b @[]uint8, is64 bool, name *[]readonly char, info int,
		sect *[]readonly char) bool {
	var sym int = elfSectionIndex(b, is64, ".symtab")
	if sym < 0 { return false }
	var w int = 4
	var ent int = 16
	if is64 {
		w = 8
		ent = 24
	}
	var sh int = elfShdr(b, is64, sym)
	var off int = tlsU(b, sh + 8 + 2 * w, w)
	var n int = tlsU(b, sh + 8 + 3 * w, w) / ent
	var strs int = tlsU(b, elfShdr(b, is64, tlsU(b, sh + 8 + 4 * w, 4)) + 8 + 2 * w, w)
	var want int = 0
	if len(sect) != 0 { want = elfSectionIndex(b, is64, sect) }
	for i := 1; i < n; i++ {
		var e int = off + i * ent
		if !tlsNameIs(b, strs + tlsU(b, e, 4), name) { continue }
		if is64 { return cast(int, b[e + 4]) == info && tlsU(b, e + 6, 2) == want }
		return cast(int, b[e + 12]) == info && tlsU(b, e + 14, 2) == want
	}
	return false
}

// tlsElfSource is the thread-local program assembled for each ELF machine.
func tlsElfSource(arch *[]readonly char) @[]char {
	var body *[]readonly char = "\n.section tdata\n.global a\na: .uint32 5\n.type f1, %function\n"
			"f1: .uint32 6\n.section tbss\nb: .zero 4\n.section tbss.x\nty: .zero 4\nloc: .zero 4\n"
			".section data\n.type d, %tls_object\nd: .uint32 1\n.uint32 ty\n.uint32 loc + 4\n"
			".type ext, %tls_object\nal = a\nal4 = a + 4\n.section tdata.x\ntx: .uint32 1\n"
	return buf.Concat(buf.Concat(".arch ", arch), body)
}

// elfRelocSymbolIs reports whether relocation k of the ELF object b's relocation section named
// rel is against the symbol name.
func elfRelocSymbolIs(b @[]uint8, is64 bool, rel *[]readonly char, k int,
		name *[]readonly char) bool {
	var ri int = elfSectionIndex(b, is64, rel)
	if ri < 0 { return false }
	var w int = 4
	var ent int = 8
	var sym int = 0
	var sh int = elfShdr(b, is64, ri)
	var symsh int = 0
	if is64 {
		w = 8
		ent = 24
	}
	var e int = tlsU(b, sh + 8 + 2 * w, w) + k * ent
	if is64 {
		sym = tlsU(b, e + 12, 4)
	} else {
		sym = tlsU(b, e + 4, 4) >> 8
	}
	symsh = elfShdr(b, is64, tlsU(b, sh + 8 + 4 * w, 4))
	var symEnt int = 16
	if is64 { symEnt = 24 }
	var s int = tlsU(b, symsh + 8 + 2 * w, w) + sym * symEnt
	var strs int = tlsU(b, elfShdr(b, is64, tlsU(b, symsh + 8 + 4 * w, 4)) + 8 + 2 * w, w)
	return tlsNameIs(b, strs + tlsU(b, s, 4), name)
}

// Each ELF machine's object has clang's thread-local sections and symbol types: WAT tdata,
// tdata.x and NOBITS tbss, tbss.x; STT_TLS (6) for a (global), f1, b, ty, loc, d (in .data), the
// aliases al and al4, tx and the undefined global ext; and a relocation against a local symbol
// in a thread-local section keeps the symbol (ty, loc), where clang's writer would otherwise
// relocate against the section.
func TestAssembleFileThreadLocalElf() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var arches @[]@[]char = @[]@[]char{"aarch64", "x64", "arm32"}
	for i := 0; i < len(arches); i++ {
		var is64 bool = i < 2
		var src @[]char = buf.Concat(buf.Concat(dir, "/tls_"), buf.Concat(arches[i], ".s"))
		var obj @[]char = buf.Concat(src, ".o")
		if !asmWrite(src, tlsElfSource(arches[i])) { return fail("cannot write the test source") }
		ok, msg := AssembleFile(src, obj, arches[i], "linux")
		if !ok { return fail(buf.Concat(buf.Concat(arches[i], ": "), msg)) }
		var b @[]uint8 = tlsRead(obj)
		var wat int = 0x403
		if !elfSectionIs(b, is64, ".tdata", 1, wat) || !elfSectionIs(b, is64, ".tbss", 8, wat) ||
				!elfSectionIs(b, is64, ".tdata.x", 1, wat) || !elfSectionIs(b, is64, ".tbss.x", 8, wat) {
			return fail(buf.Concat(arches[i], ": the thread-local sections are not clang's"))
		}
		if !elfSymbolIs(b, is64, "a", 0x16, ".tdata") || !elfSymbolIs(b, is64, "f1", 6, ".tdata") ||
				!elfSymbolIs(b, is64, "b", 6, ".tbss") || !elfSymbolIs(b, is64, "d", 6, ".data") ||
				!elfSymbolIs(b, is64, "al", 6, ".tdata") || !elfSymbolIs(b, is64, "al4", 6, ".tdata") ||
				!elfSymbolIs(b, is64, "tx", 6, ".tdata.x") || !elfSymbolIs(b, is64, "ext", 0x16, "") ||
				!elfSymbolIs(b, is64, "ty", 6, ".tbss.x") || !elfSymbolIs(b, is64, "loc", 6, ".tbss.x") {
			return fail(buf.Concat(arches[i], ": a thread-local symbol is not STT_TLS"))
		}
		var rel *[]readonly char = ".rela.data"
		if !is64 { rel = ".rel.data" }
		if !elfRelocSymbolIs(b, is64, rel, 0, "ty") || !elfRelocSymbolIs(b, is64, rel, 1, "loc") {
			return fail(buf.Concat(arches[i], ": a relocation against a thread-local local moved"))
		}
	}
	var vars @[]char = buf.Concat(dir, "/vars.s")
	if !asmWrite(vars, ".arch aarch64\n.section thread_vars\n.uint64 0\n") {
		return fail("cannot write the test source")
	}
	ok, msg := AssembleFile(vars, buf.Concat(dir, "/vars.o"), "aarch64", "linux")
	if ok || !asmHas(msg, "Mach-O's thread-local variable descriptors") {
		return fail(buf.Concat("thread_vars on ELF: ", msg))
	}
	return ""
}

// machoSection returns the offset of the section_64 named sectname (shorter than its 16
// bytes) in the Mach-O object b, or -1.
func machoSection(b @[]uint8, sectname *[]readonly char) int {
	var lc int = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		if tlsU(b, lc, 4) == 0x19 {
			for s := 0; s < tlsU(b, lc + 64, 4); s++ {
				var sh int = lc + 72 + s * 80
				if tlsNameIs(b, sh, sectname) { return sh }
			}
		}
		lc = lc + tlsU(b, lc + 4, 4)
	}
	return -1
}

// machoSymbolValue returns the value of the symbol name in the Mach-O object b, and its n_type
// (-1 when absent).
func machoSymbolValue(b @[]uint8, name *[]readonly char) (int, int) {
	var lc int = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		if tlsU(b, lc, 4) == 2 {
			var off int = tlsU(b, lc + 8, 4)
			var strs int = tlsU(b, lc + 16, 4)
			for i := 0; i < tlsU(b, lc + 12, 4); i++ {
				var e int = off + i * 16
				if tlsNameIs(b, strs + tlsU(b, e, 4), name) {
					return tlsU(b, e + 8, 8), cast(int, b[e + 4])
				}
			}
		}
		lc = lc + tlsU(b, lc + 4, 4)
	}
	return 0, -1
}

// The Mach-O objects (arm64 and x86-64) have clang's thread-local sections — __thread_data
// (S_THREAD_LOCAL_REGULAR), __thread_vars (S_THREAD_LOCAL_VARIABLES: two descriptors, for a
// variable in __thread_data and one in __thread_bss, each with its two pointers relocated)
// and, zero-filled with no file bytes, __thread_bss (S_THREAD_LOCAL_ZEROFILL), all in __DATA —
// and `.tbss` places each object in __thread_bss by its alignment, local unless `.global`.
func TestAssembleFileThreadLocalMacho() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var arches @[]@[]char = @[]@[]char{"aarch64", "x64"}
	for i := 0; i < len(arches); i++ {
		var src @[]char = buf.Concat(buf.Concat(dir, "/tlv_"), buf.Concat(arches[i], ".s"))
		var obj @[]char = buf.Concat(src, ".o")
		var body *[]readonly char = "\n.section tdata\n_a$tlv$init: .uint32 5\n"
				".tbss _b$tlv$init, 4, 2\n.tbss _c$tlv$init, 8\n.section thread_vars\n.global _a\n"
				".global __tlv_bootstrap\n_a: .uint64 __tlv_bootstrap\n.uint64 0\n.uint64 _a$tlv$init\n"
				".global _b\n_b: .uint64 __tlv_bootstrap\n.uint64 0\n.uint64 _b$tlv$init\n"
		if !asmWrite(src, buf.Concat(buf.Concat(".arch ", arches[i]), body)) {
			return fail("cannot write the test source")
		}
		ok, msg := AssembleFile(src, obj, arches[i], "darwin")
		if !ok { return fail(buf.Concat(buf.Concat(arches[i], ": "), msg)) }
		var b @[]uint8 = tlsRead(obj)
		var data int = machoSection(b, "__thread_data")
		var vars int = machoSection(b, "__thread_vars")
		var bss int = machoSection(b, "__thread_bss")
		if data < 0 || vars < 0 || bss < 0 || !tlsNameIs(b, data + 16, "__DATA") ||
				!tlsNameIs(b, vars + 16, "__DATA") || !tlsNameIs(b, bss + 16, "__DATA") {
			return fail(buf.Concat(arches[i], ": a thread-local section is missing or not in __DATA"))
		}
		if tlsU(b, data + 64, 4) != 0x11 || tlsU(b, vars + 64, 4) != 0x13 ||
				tlsU(b, bss + 64, 4) != 0x12 {
			return fail(buf.Concat(arches[i], ": a thread-local section has the wrong type"))
		}
		if tlsU(b, vars + 60, 4) != 4 || tlsU(b, vars + 40, 8) != 48 {
			return fail(buf.Concat(arches[i], ": __thread_vars is not two relocated descriptors"))
		}
		var bssAddr int = tlsU(b, bss + 32, 8)
		if tlsU(b, bss + 48, 4) != 0 || tlsU(b, bss + 40, 8) != 12 ||
				bssAddr < tlsU(b, vars + 32, 8) + 48 {
			return fail(buf.Concat(arches[i], ": __thread_bss is not zero-filled after the rest"))
		}
		bv, bt := machoSymbolValue(b, "_b$tlv$init")
		cv, ct := machoSymbolValue(b, "_c$tlv$init")
		_, at := machoSymbolValue(b, "_a")
		if bv != bssAddr || cv != bssAddr + 4 || bt != 0x0e || ct != 0x0e || at != 0x0f {
			return fail(buf.Concat(arches[i], ": a .tbss object is misplaced, or a binding wrong"))
		}
	}
	return ""
}
