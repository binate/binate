package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/build"
import "pkg/builtins/testing"
import "pkg/std/errors"
import "pkg/std/os"
import "pkg/std/os/process"

// Mach-O's thread-local variables through the whole driver: `@TLVPPAGE` / `@TLVPPAGEOFF` are
// ARM64_RELOC_TLVP_LOAD_PAGE21 (PC-relative) / _PAGEOFF12 against the variable's descriptor, as
// clang writes them, and a program reading and writing a thread-local variable in __thread_data
// and one in __thread_bss links (ld64) and runs.  (tlsRead / tlsU / tlsNameIs / machoSection
// are in assemble_tls_test.bn.)

// tlvProgram is `_main`, which sets the zero-filled thread-local w to 1, reads v (41, its initial
// bytes) and w back through their descriptors' thunks, and returns their sum, 42.
var tlvProgram *[]readonly char = ".arch aarch64\n.section tdata\n_v$tlv$init: .uint32 41\n"
		".tbss _w$tlv$init, 4, 2\n.section thread_vars\n.global __tlv_bootstrap\n.global _v\n"
		"_v: .uint64 __tlv_bootstrap\n.uint64 0\n.uint64 _v$tlv$init\n.global _w\n"
		"_w: .uint64 __tlv_bootstrap\n.uint64 0\n.uint64 _w$tlv$init\n.section text\n.global _main\n"
		"_main: stp x29, x30, [sp, #-32]!\n mov x29, sp\n adrp x0, _w@TLVPPAGE\n"
		" ldr x0, [x0, _w@TLVPPAGEOFF]\n ldr x8, [x0]\n blr x8\n mov w9, #1\n str w9, [x0]\n"
		" adrp x0, _v@TLVPPAGE\n ldr x0, [x0, _v@TLVPPAGEOFF]\n ldr x8, [x0]\n blr x8\n"
		" ldr w10, [x0]\n str x10, [sp, #16]\n adrp x0, _w@TLVPPAGE\n ldr x0, [x0, _w@TLVPPAGEOFF]\n"
		" ldr x8, [x0]\n blr x8\n ldr w9, [x0]\n ldr x10, [sp, #16]\n add w0, w10, w9\n"
		" ldp x29, x30, [sp], #32\n ret\n"

// machoRelocAt returns the r_type and r_pcrel of the relocation at address addr of the Mach-O
// section at sh (a section_64's offset in b), or (-1, -1).
func machoRelocAt(b @[]uint8, sh int, addr int) (int, int) {
	for k := 0; k < tlsU(b, sh + 60, 4); k++ {
		var r int = tlsU(b, sh + 56, 4) + k * 8
		if tlsU(b, r, 4) != addr { continue }
		var info int = tlsU(b, r + 4, 4)
		return (info >> 28) & 0xf, (info >> 24) & 1
	}
	return -1, -1
}

// The TLV references' relocations; ELF has none; a reference naming a label that is not a
// descriptor in thread_vars is rejected (clang writes it regardless); and on an arm64 macOS host
// the program links and returns 42.
func TestAssembleFileThreadLocalVariables() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/tlv.s")
	if !asmWrite(src, tlvProgram) { return fail("cannot write the test source") }
	var obj @[]char = buf.Concat(dir, "/tlv.o")
	ok, msg := AssembleFile(src, obj, "aarch64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var text int = machoSection(b, "__text")
	t0, p0 := machoRelocAt(b, text, 8) // the first adrp
	t1, p1 := machoRelocAt(b, text, 12) // its ldr
	if text < 0 || t0 != 8 || p0 != 1 || t1 != 9 || p1 != 0 {
		return fail("a TLV reference is not clang's TLVP_LOAD_PAGE21 / _PAGEOFF12")
	}
	var elfSrc @[]char = buf.Concat(dir, "/tlv_elf.s")
	if !asmWrite(elfSrc, ".arch aarch64\n.global _v\n.section text\nadrp x0, _v@TLVPPAGE\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(elfSrc, buf.Concat(dir, "/tlv_elf.o"), "aarch64", "linux")
	if ok || !asmHas(msg, "`@TLVPPAGE` / `@TLVPPAGEOFF` are Mach-O-only") {
		return fail(buf.Concat("ELF: ", msg))
	}
	var bad @[]char = buf.Concat(dir, "/bad.s")
	if !asmWrite(bad,
			".arch aarch64\n.section data\n_d: .uint64 0\n.section text\nadrp x0, _d@TLVPPAGE\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(bad, buf.Concat(dir, "/bad.o"), "aarch64", "darwin")
	if ok || !asmHas(msg, "names '_d', which is not a descriptor in thread_vars") {
		return fail(buf.Concat("a TLV reference naming a data label: ", msg))
	}
	if build.OS != build.OS_DARWIN || build.Arch != build.ARCH_AARCH64 { return "" }
	var exe @[]char = buf.Concat(dir, "/tlv")
	var args @[]@[]char = @[]@[]char{"-arch", "arm64", "-o", buf.CopyStr(exe), buf.CopyStr(obj),
			"-Wl,-e,_main"}
	var st process.ExitStatus
	var err @errors.Error
	st, err = process.Run("cc", &process.Options{SearchPath: true, Args: args})
	if present(err) || !st.Exited() || st.Code() != 0 { return fail("the TLV object does not link") }
	st, err = process.Run(exe, &process.Options{Args: make_slice(@[]char, 0)})
	if present(err) || !st.Exited() || st.Code() != 42 {
		return fail("the TLV program does not return 42")
	}
	return ""
}

// machoRelocInfo returns the relocation_info word (r_symbolnum, r_pcrel, r_length, r_extern,
// r_type) of the relocation at address addr of the Mach-O section at sh, or -1.
func machoRelocInfo(b @[]uint8, sh int, addr int) int {
	for k := 0; k < tlsU(b, sh + 60, 4); k++ {
		var r int = tlsU(b, sh + 56, 4) + k * 8
		if tlsU(b, r, 4) == addr { return tlsU(b, r + 4, 4) }
	}
	return -1
}

// machoSymbolIs reports whether symbol table entry i of the Mach-O object b is named name.
func machoSymbolIs(b @[]uint8, i int, name *[]readonly char) bool {
	var lc int = 32
	for c := 0; c < tlsU(b, 16, 4); c++ {
		if tlsU(b, lc, 4) == 2 {
			var e int = tlsU(b, lc + 8, 4) + i * 16
			return tlsNameIs(b, tlsU(b, lc + 16, 4) + tlsU(b, e, 4), name)
		}
		lc = lc + tlsU(b, lc + 4, 4)
	}
	return false
}

// Each TLV reference is clang's relocation in full — TLVP_LOAD_PAGE21 (pcrel) or _PAGEOFF12, 4
// bytes long, extern — against the descriptor's own symbol, a local one (clang's `static
// __thread`) as an undefined one; a common is no descriptor; and ELF has no `@TLVPPAGEOFF`.
func TestAssembleFileTlvReferences() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/refs.s")
	var body *[]readonly char = ".arch aarch64\n.section tdata\n_s$tlv$init: .uint32 7\n"
			".section thread_vars\n.global __tlv_bootstrap\n_s: .uint64 __tlv_bootstrap\n.uint64 0\n"
			".uint64 _s$tlv$init\n.global _u\n.section text\n.global _f\n_f: adrp x0, _s@TLVPPAGE\n"
			" ldr x0, [x0, _s@TLVPPAGEOFF]\n adrp x1, _u@TLVPPAGE\n ldr x1, [x1, _u@TLVPPAGEOFF]\n ret\n"
	if !asmWrite(src, body) { return fail("cannot write the test source") }
	var obj @[]char = buf.Concat(dir, "/refs.o")
	ok, msg := AssembleFile(src, obj, "aarch64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var text int = machoSection(b, "__text")
	var syms @[]@[]char = @[]@[]char{"_s", "_s", "_u", "_u"}
	for k := 0; k < 4; k++ {
		var info int = machoRelocInfo(b, text, 4 * k)
		var wantType int = 8 + (k % 2)
		var wantPcrel int = 1 - (k % 2)
		if info < 0 || ((info >> 28) & 0xf) != wantType || ((info >> 24) & 1) != wantPcrel ||
				((info >> 25) & 3) != 2 || ((info >> 27) & 1) != 1 ||
				!machoSymbolIs(b, info & 0xffffff, syms[k]) {
			return fail("a TLV relocation is not clang's")
		}
	}
	var comm @[]char = buf.Concat(dir, "/comm.s")
	if !asmWrite(comm, ".arch aarch64\n.comm _c, 8, 3\n.section text\nadrp x0, _c@TLVPPAGE\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(comm, buf.Concat(dir, "/comm.o"), "aarch64", "darwin")
	if ok || !asmHas(msg, "names '_c', which is not a descriptor in thread_vars") {
		return fail(buf.Concat("a TLV reference naming a common: ", msg))
	}
	var elf @[]char = buf.Concat(dir, "/off_elf.s")
	if !asmWrite(elf, ".arch aarch64\n.global _v\n.section text\nldr x0, [x0, _v@TLVPPAGEOFF]\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(elf, buf.Concat(dir, "/off_elf.o"), "aarch64", "linux")
	if ok || !asmHas(msg, "`@TLVPPAGE` / `@TLVPPAGEOFF` are Mach-O-only") {
		return fail(buf.Concat("ELF @TLVPPAGEOFF: ", msg))
	}
	return ""
}
