package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// GOT slot operands through the whole driver, against clang's objects.  (elfRelocTypeAt,
// elfRelaAt, machoSection, tlsRead and tlsU are in assemble_tls_test.bn, machoRelocInfo in
// assemble_tlv_test.bn.)

// On ELF: `add rax, [rip + x@GOTPCREL]` R_X86_64_REX_GOTPCRELX (42) at 3, `mov eax, [rip +
// x@GOTPCREL]` R_X86_64_GOTPCRELX (41) at 9, `add qword ptr [rip + x@GOTPCREL], 1`
// R_X86_64_GOTPCREL (9) at 16 with addend -5, `call [rip + x@GOTPCREL]` GOTPCRELX at 23 — each
// addend -4 less any immediate after the field.
func TestAssembleFileGotElf() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/got.s")
	if !asmWrite(src,
			".arch x64\n.section text\nadd rax, [rip + x@GOTPCREL]\nmov eax, [rip + x@GOTPCREL]\n"
					"add qword ptr [rip + x@GOTPCREL], 1\ncall [rip + x@GOTPCREL]\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/got.o")
	ok, msg := AssembleFile(src, obj, "x64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var types @[]int = @[]int{42, 41, 9, 41}
	var offs @[]int = @[]int{3, 9, 16, 23}
	var addends @[]int = @[]int{-4, -4, -5, -4}
	for k := 0; k < len(types); k++ {
		off, addend := elfRelaAt(b, ".rela.text", k)
		if elfRelocTypeAt(b, ".rela.text", k) != types[k] || off != offs[k] ||
				addend != cast(int64, addends[k]) {
			return fail("a GOT slot operand's ELF relocation is not clang's")
		}
	}
	return ""
}

// On Mach-O: `call [rip + _x@GOTPCREL]` X86_64_RELOC_GOT (type 4, pcrel, 4 bytes, extern) at 2,
// and `add qword ptr [rip + _x@GOTPCREL], 1` at 9 with -1 (the immediate) in its field, as clang;
// a GOT reference to a temporary label past its atom's symbol, which the writer would move onto
// that symbol (reading its slot), is an error; at the symbol's own address it is taken.
func TestAssembleFileGotMacho() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/got.s")
	if !asmWrite(src,
			".arch x64\n.section text\ncall [rip + _x@GOTPCREL]\nadd qword ptr [rip + _x@GOTPCREL], 1\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/got.o")
	ok, msg := AssembleFile(src, obj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var sh int = machoSection(b, "__text")
	var offs @[]int = @[]int{2, 9}
	for k := 0; k < len(offs); k++ {
		var info int64 = machoRelocInfo(b, sh, offs[k])
		if info < 0 || ((info >> 28) & 0xf) != 4 || ((info >> 24) & 1) != 1 || ((info >> 25) & 3) != 2 ||
				((info >> 27) & 1) != 1 {
			return fail("a GOT slot operand's Mach-O relocation is not clang's")
		}
	}
	if cast(uint32, tlsU(b, tlsU(b, sh + 48, 4) + 9, 4)) != 0xFFFFFFFF {
		return fail("the immediate's -1 is not in the GOT relocation's field")
	}
	if !asmWrite(src, ".arch x64\n.section text\n_f: mov eax, [rip + Lt@GOTPCREL]\nLt: nop\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src, obj, "x64", "darwin")
	if ok || !asmHas(msg, "GOT reference to the temporary label") {
		return fail(buf.Concat("Mach-O GOT reference to a temporary: ", msg))
	}
	// At its atom symbol's own address the temporary's slot is that symbol's: as clang, taken.
	if !asmWrite(src, ".arch x64\n.section text\n_f:\nLt: mov eax, [rip + Lt@GOTPCREL]\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src, obj, "x64", "darwin")
	if !ok {
		return fail(buf.Concat("Mach-O GOT reference to a temporary at its atom's start: ", msg))
	}
	return ""
}
