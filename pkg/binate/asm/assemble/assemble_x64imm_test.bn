package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Symbolic immediates through the whole driver, against clang's objects.  (elfRelocTypeAt,
// elfRelaAt and machoSection are in assemble_tls_test.bn, machoRelocInfo and machoSymbolIs in
// assemble_tlv_test.bn.)

// On ELF: `mov rax, offset x` R_X86_64_32S at its imm32 (3), `mov eax, offset x + 8` R_X86_64_32
// (8, addend 8), `movabs rcx, offset x` R_X86_64_64 (14), `mov ax, offset x` R_X86_64_16 (24),
// `mov rax, offset y@TPOFF` R_X86_64_TPOFF32 (29).
func TestAssembleFileSymbolicImmediatesElf() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/imm.s")
	if !asmWrite(src,
			".arch x64\n.global x\n.section text\nmov rax, offset x\nmov eax, offset x + 8\n"
					"movabs rcx, offset x\nmov ax, offset x\nmov rax, offset y@TPOFF\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/imm.o")
	ok, msg := AssembleFile(src, obj, "x64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var types @[]int = @[]int{11, 10, 1, 12, 23}
	var offs @[]int = @[]int{3, 8, 14, 24, 29}
	var addends @[]int = @[]int{0, 8, 0, 0, 0}
	for k := 0; k < len(types); k++ {
		off, addend := elfRelaAt(b, ".rela.text", k)
		if elfRelocTypeAt(b, ".rela.text", k) != types[k] || off != offs[k] ||
				addend != cast(int64, addends[k]) {
			return fail("a symbolic immediate's ELF relocation is not clang's")
		}
	}
	return ""
}

// On Mach-O: X86_64_RELOC_UNSIGNED (type 0, extern, not pcrel) of the field's length, its addend
// in the field — `mov eax, offset _x + 8` 4 bytes at 1 holding 8, `movabs rcx, offset _x` 8 at 7,
// `mov ax, offset _x` 2 at 17 — and a sign-extended imm32 (`mov rax, offset _x`) an error.
func TestAssembleFileSymbolicImmediatesMacho() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/imm.s")
	if !asmWrite(src,
			".arch x64\n.global _x\n.section text\nmov eax, offset _x + 8\nmovabs rcx, offset _x\n"
					"mov ax, offset _x\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/imm.o")
	ok, msg := AssembleFile(src, obj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var text int = machoSection(b, "__text")
	var addrs @[]int = @[]int{1, 7, 17}
	var lengths @[]int64 = @[]int64{2, 3, 1}
	for k := 0; k < 3; k++ {
		var info int64 = machoRelocInfo(b, text, addrs[k])
		if info < 0 || ((info >> 28) & 0xf) != 0 || ((info >> 24) & 1) != 0 ||
				((info >> 25) & 3) != lengths[k] || ((info >> 27) & 1) != 1 ||
				!machoSymbolIs(b, cast(int, info & 0xffffff), "_x") {
			return fail("a symbolic immediate's Mach-O relocation is not clang's")
		}
	}
	if tlsU(b, tlsU(b, text + 48, 4) + 1, 4) != 8 {
		return fail("the inline addend is not in the field")
	}
	var wide @[]char = buf.Concat(dir, "/wide.s")
	if !asmWrite(wide, ".arch x64\n.global _x\n.section text\nmov rax, offset _x\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(wide, buf.Concat(dir, "/wide.o"), "x64", "darwin")
	if ok || !asmHas(msg, "32-bit absolute addressing is not supported") {
		return fail(buf.Concat("Mach-O mov rax, offset _x: ", msg))
	}
	return ""
}
