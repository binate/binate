package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A loop instruction's rel8 to a symbol it cannot reach in its section, through the whole driver,
// against clang's objects.  (elfRelocTypeAt, elfRelaAt, machoSection, tlsRead and tlsU are in
// assemble_tls_test.bn, machoRelocInfo in assemble_tlv_test.bn.)

// On ELF `loop x` is R_X86_64_PC8 (15) at its rel8 (1, addend -1) and `jrcxz x + 3` at 3 (addend
// 2); on Mach-O `jrcxz _x` is an X86_64_RELOC_BRANCH (type 2, pcrel, 1 byte, extern) at 1, and
// `jrcxz _x + 3` an error: ld64 drops a 1-byte branch's addend, where clang emits it.
func TestAssembleFileLoopRel8() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/loop.s")
	if !asmWrite(src, ".arch x64\n.section text\nloop x\njrcxz x + 3\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/loop.o")
	ok, msg := AssembleFile(src, obj, "x64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var offs @[]int = @[]int{1, 3}
	var addends @[]int = @[]int{-1, 2}
	for k := 0; k < len(offs); k++ {
		off, addend := elfRelaAt(b, ".rela.text", k)
		if elfRelocTypeAt(b, ".rela.text", k) != 15 || off != offs[k] ||
				addend != cast(int64, addends[k]) {
			return fail("a loop's ELF relocation is not clang's")
		}
	}
	var msrc @[]char = buf.Concat(dir, "/mloop.s")
	if !asmWrite(msrc, ".arch x64\n.section text\njrcxz _x\n") {
		return fail("cannot write the test source")
	}
	var mobj @[]char = buf.Concat(dir, "/mloop.o")
	ok, msg = AssembleFile(msrc, mobj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	b = tlsRead(mobj)
	var info int64 = machoRelocInfo(b, machoSection(b, "__text"), 1)
	if info < 0 || ((info >> 28) & 0xf) != 2 || ((info >> 24) & 1) != 1 || ((info >> 25) & 3) != 0 ||
			((info >> 27) & 1) != 1 {
		return fail("a loop's Mach-O relocation is not clang's")
	}
	if !asmWrite(msrc, ".arch x64\n.section text\njrcxz _x + 3\n") {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(msrc, mobj, "x64", "darwin")
	if ok || !asmHas(msg, "ld64 drops") { return fail(buf.Concat("Mach-O addend: ", msg)) }
	return ""
}

// On Mach-O a loop to a temporary label past a listed one, which the writer would relocate
// against that symbol with the label's offset as the addend (ld64 drops it, linking a loop that
// reruns the code before), is patched in place (E2 FD, no relocation) when the section is one atom
// to ld64; with .subsections_via_symbols it is an error.
func TestAssembleFileLoopMachoAtoms() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/atoms.s")
	var body *[]readonly char = ".section text\n.global _main\n_main: nop\nLloop: nop\n"
			"inner: loop Lloop\n"
	if !asmWrite(src, buf.Concat(".arch x64\n", body)) { return fail("cannot write the test source") }
	var obj @[]char = buf.Concat(dir, "/atoms.o")
	ok, msg := AssembleFile(src, obj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var sh int = machoSection(b, "__text")
	if tlsU(b, sh + 60, 4) != 0 || tlsU(b, tlsU(b, sh + 48, 4) + 2, 2) != 0xFDE2 {
		return fail("a loop past a listed label: not patched in place")
	}
	if !asmWrite(src, buf.Concat(".arch x64\n.subsections_via_symbols\n", body)) {
		return fail("cannot write the test source")
	}
	ok, msg = AssembleFile(src, obj, "x64", "darwin")
	if ok || !asmHas(msg, "ld64 drops") { return fail(buf.Concat("with subsections: ", msg)) }
	return ""
}
