package "pkg/binate/asm/assemble"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A symbol in a memory operand through the whole driver, against clang's objects.
// (elfRelocTypeAt, elfRelaAt, machoSection, tlsRead and tlsU are in assemble_tls_test.bn,
// machoRelocInfo and machoSymbolIs in assemble_tlv_test.bn.)

// On ELF: `mov rax, [x]` R_X86_64_32S at its disp32 (4), `mov rax, x[rbx + 8]` R_X86_64_32S (11,
// addend 8), `mov rax, x[rip]` R_X86_64_PC32 (18, addend -4), and a local label's `mov rax,
// [lbl]` R_X86_64_32S against its section (26, addend 22, the label's offset).
func TestAssembleFileSymbolicMemoryElf() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/mem.s")
	if !asmWrite(src,
			".arch x64\n.global x\n.section text\nmov rax, [x]\nmov rax, x[rbx + 8]\nmov rax, x[rip]\n"
					"lbl: mov rax, [lbl]\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/mem.o")
	ok, msg := AssembleFile(src, obj, "x64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var types @[]int = @[]int{11, 11, 2, 11}
	var offs @[]int = @[]int{4, 11, 18, 26}
	var addends @[]int = @[]int{0, 8, -4, 22}
	for k := 0; k < len(types); k++ {
		off, addend := elfRelaAt(b, ".rela.text", k)
		if elfRelocTypeAt(b, ".rela.text", k) != types[k] || off != offs[k] ||
				addend != cast(int64, addends[k]) {
			return fail("a symbolic memory operand's ELF relocation is not clang's")
		}
	}
	return ""
}

// On Mach-O a symbol beside `rip` is X86_64_RELOC_SIGNED (type 1, pcrel, 4 bytes, extern) at its
// displacement (3); its absolute address, with a base or none, is an error, as in clang.
func TestAssembleFileSymbolicMemoryMacho() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/mem.s")
	if !asmWrite(src, ".arch x64\n.global _x\n.section text\nmov rax, _x[rip]\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/mem.o")
	ok, msg := AssembleFile(src, obj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	var info int64 = machoRelocInfo(b, machoSection(b, "__text"), 3)
	if info < 0 || ((info >> 28) & 0xf) != 1 || ((info >> 24) & 1) != 1 || ((info >> 25) & 3) != 2 ||
			((info >> 27) & 1) != 1 || !machoSymbolIs(b, cast(int, info & 0xffffff), "_x") {
		return fail("a RIP-relative symbol's Mach-O relocation is not clang's")
	}
	var lines @[]*[]readonly char = @[]*[]readonly char{"mov rax, [_x]", "mov rax, _x[rbx]", "push _x"}
	for k := 0; k < len(lines); k++ {
		var abs @[]char = buf.Concat(dir, "/abs.s")
		if !asmWrite(abs, buf.Concat(".arch x64\n.global _x\n.section text\n", lines[k])) {
			return fail("cannot write the test source")
		}
		ok, msg = AssembleFile(abs, buf.Concat(dir, "/abs.o"), "x64", "darwin")
		if ok || !asmHas(msg, "32-bit absolute addressing is not supported") {
			return fail(buf.Concat("Mach-O absolute symbol: ", msg))
		}
	}
	return ""
}

// MOVABS's moffs form: on ELF `movabs rax, [x + 8]` R_X86_64_64 at its 8-byte address (2, addend
// 8); on Mach-O `movabs rax, [_x]` an 8-byte X86_64_RELOC_UNSIGNED at 2 (type 0, extern, not
// pcrel).
func TestAssembleFileMoffs() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var src @[]char = buf.Concat(dir, "/moffs.s")
	if !asmWrite(src, ".arch x64\n.global x\n.section text\nmovabs rax, [x + 8]\n") {
		return fail("cannot write the test source")
	}
	var obj @[]char = buf.Concat(dir, "/moffs.o")
	ok, msg := AssembleFile(src, obj, "x64", "linux")
	if !ok { return fail(buf.Concat("ELF: ", msg)) }
	var b @[]uint8 = tlsRead(obj)
	off, addend := elfRelaAt(b, ".rela.text", 0)
	if elfRelocTypeAt(b, ".rela.text", 0) != 1 || off != 2 || addend != 8 {
		return fail("movabs's moffs ELF relocation is not clang's")
	}
	var msrc @[]char = buf.Concat(dir, "/moffs_macho.s")
	if !asmWrite(msrc, ".arch x64\n.global _x\n.section text\nmovabs rax, [_x]\n") {
		return fail("cannot write the test source")
	}
	var mobj @[]char = buf.Concat(dir, "/moffs_macho.o")
	ok, msg = AssembleFile(msrc, mobj, "x64", "darwin")
	if !ok { return fail(buf.Concat("Mach-O: ", msg)) }
	var m @[]uint8 = tlsRead(mobj)
	var info int64 = machoRelocInfo(m, machoSection(m, "__text"), 2)
	if info < 0 || ((info >> 28) & 0xf) != 0 || ((info >> 24) & 1) != 0 || ((info >> 25) & 3) != 3 ||
			((info >> 27) & 1) != 1 || !machoSymbolIs(m, cast(int, info & 0xffffff), "_x") {
		return fail("movabs's moffs Mach-O relocation is not clang's")
	}
	return ""
}
