// Package elf emits ELF object files from assembled data.
package "pkg/binate/asm/elf"

import "pkg/binate/asm"

// Machine types
const EM_ARM int = 40

const EM_AARCH64 int = 183

const EM_X86_64 int = 62

// EF_ARM_EABI_VER5 is the ARM EABI version-5 tag written into the ELF header's
// e_flags for every arm32 object.  GNU arm-linux-gnueabihf-ld refuses to merge
// an object whose EABI version differs from the rest of the link (clang-produced
// objects are ver 5); a plain 0 reads as "EABI version 0" and the link fails.
// The float ABI is NOT encoded in e_flags (clang leaves it 0 for hard and soft
// alike) — it travels in the .ARM.attributes section (see buildArmAttributesHard).
const EF_ARM_EABI_VER5 int = 0x05000000

// Write emits an ELF relocatable object file. Uses ELF32 for ARM32 (EM_ARM) and
// ELF64 for all other machine types.  For EM_ARM the header's e_flags carries
// EF_ARM_EABI_VER5; hardFloat additionally emits a .ARM.attributes section
// declaring the VFP calling convention (see WriteARM32).  hardFloat is ignored
// for non-ARM machines (they have neither e_flags bits nor this section).
func Write(a @asm.Assembler, path *[]readonly char, machine int, hardFloat bool) bool

// WriteAArch64 is a convenience for AArch64 ELF64.
func WriteAArch64(a @asm.Assembler, path *[]readonly char) bool

// WriteX86_64 is a convenience for x86-64 ELF64.
func WriteX86_64(a @asm.Assembler, path *[]readonly char) bool

// WriteARM32 is a convenience for ARM32 ELF32.  hardFloat (arm32-linux
// AAPCS-VFP) emits a .ARM.attributes section declaring Tag_ABI_VFP_args = "VFP
// registers"; soft-float (baremetal) omits it.  Every arm32 object carries EABI
// version 5 in e_flags so GNU ld will merge it.  Callers pass types.Arm32HardFloat().
func WriteARM32(a @asm.Assembler, path *[]readonly char, hardFloat bool) bool
