package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/bootstrap"

// ELFMAG0..ELFMAG3 are the four magic bytes at the start of every ELF
// file: 0x7F 'E' 'L' 'F'.
const ELFMAG0 uint8 = 0x7f
// ELFMAG1 is the second byte of the ELF magic ('E').
const ELFMAG1 uint8 = 0x45
// ELFMAG2 is the third byte of the ELF magic ('L').
const ELFMAG2 uint8 = 0x4c
// ELFMAG3 is the fourth byte of the ELF magic ('F').
const ELFMAG3 uint8 = 0x46

// ELFCLASS32 marks an ELF file as 32-bit (Elf32_* structures).
const ELFCLASS32 uint8 = 1
// ELFCLASS64 marks an ELF file as 64-bit (Elf64_* structures).
const ELFCLASS64 uint8 = 2
// ELFDATA2LSB indicates little-endian byte order in the data fields.
const ELFDATA2LSB uint8 = 1
// EV_CURRENT is the current ELF format version (always 1).
const EV_CURRENT uint8 = 1
// ELFOSABI_NONE is the System V / generic ABI marker; we use this for
// all ELF objects we emit.
const ELFOSABI_NONE uint8 = 0

// ET_REL marks an ELF file as a relocatable object (.o), the only
// filetype this package emits.
const ET_REL uint16 = 1

// SHT_NULL is the inactive (sentinel) section header type. The first
// section header in every ELF object must be SHT_NULL.
const SHT_NULL uint32 = 0
// SHT_PROGBITS marks a section that contains program-defined data
// (text, rodata, data).
const SHT_PROGBITS uint32 = 1
// SHT_SYMTAB marks a symbol table section.
const SHT_SYMTAB uint32 = 2
// SHT_STRTAB marks a string table section.
const SHT_STRTAB uint32 = 3
// SHT_REL marks a relocation table section without explicit addends
// (the addend is read from the patched location).
const SHT_REL uint32 = 9
// SHT_RELA marks a relocation table section with explicit addends.
const SHT_RELA uint32 = 4
// SHT_NOBITS marks a zero-fill section that occupies no bytes in the
// file (e.g. .bss).
const SHT_NOBITS uint32 = 8

// SHF_WRITE marks a section that should be writable at runtime.
const SHF_WRITE uint64 = 1
// SHF_ALLOC marks a section that occupies memory at runtime
// (allocatable).
const SHF_ALLOC uint64 = 2
// SHF_EXECINSTR marks a section that contains executable instructions.
const SHF_EXECINSTR uint64 = 4

// STB_LOCAL marks a symbol as local (visible only within the object).
const STB_LOCAL int = 0
// STB_GLOBAL marks a symbol as global (visible to the linker across
// objects).
const STB_GLOBAL int = 1
// STB_WEAK marks a symbol as weak (overridable by a strong definition).
const STB_WEAK int = 2

// STT_NOTYPE is the unspecified symbol-type tag.
const STT_NOTYPE int = 0
// STT_FUNC marks a symbol as a function (code address).
const STT_FUNC int = 2
// STT_SECTION marks a symbol as a section symbol (its value is the
// section's address).
const STT_SECTION int = 3

// SHN_UNDEF is the section index meaning "no section" — used by
// undefined external references.
const SHN_UNDEF int = 0

// R_AARCH64_ABS64 is a 64-bit absolute address relocation.
const R_AARCH64_ABS64 int = 257
// R_AARCH64_ABS32 is a 32-bit absolute address relocation.
const R_AARCH64_ABS32 int = 258
// R_AARCH64_CALL26 patches the imm26 of a BL instruction with the
// target's PC-relative offset (in instruction units).
const R_AARCH64_CALL26 int = 283
// R_AARCH64_JUMP26 patches the imm26 of an unconditional B instruction
// with the target's PC-relative offset (in instruction units).
const R_AARCH64_JUMP26 int = 282
// R_AARCH64_ADR_PREL_LO21 patches the imm21 of an ADR instruction with
// the target's signed PC-relative byte offset.
const R_AARCH64_ADR_PREL_LO21 int = 274
// R_AARCH64_ADR_PREL_PG_HI21 patches the imm21 of an ADRP instruction
// with the page-aligned PC-relative offset (high 21 bits).
const R_AARCH64_ADR_PREL_PG_HI21 int = 275
// R_AARCH64_CONDBR19 patches the imm19 of a B.cond / CBZ / CBNZ
// instruction with the target's PC-relative offset (in instructions).
const R_AARCH64_CONDBR19 int = 280
// R_AARCH64_TSTBR14 patches the imm14 of a TBZ / TBNZ instruction.
const R_AARCH64_TSTBR14 int = 279

// R_ARM_ABS32 is a 32-bit absolute address relocation for ARM32.
const R_ARM_ABS32 int = 2
// R_ARM_CALL patches the imm24 of a BL/BLX instruction.
const R_ARM_CALL int = 28
// R_ARM_JUMP24 patches the imm24 of an unconditional B/BL.
const R_ARM_JUMP24 int = 29

// R_X86_64_64 is a 64-bit absolute address relocation.
const R_X86_64_64 int = 1
// R_X86_64_PC32 is a 32-bit PC-relative relocation (used by RIP-relative
// references).
const R_X86_64_PC32 int = 2
// R_X86_64_32 is a 32-bit zero-extended absolute address relocation.
const R_X86_64_32 int = 10

// --- Main write function ---

func Write(a @asm.Assembler, path *[]const char, machine int) bool {
	// Determine 32 vs 64-bit from machine type
	var is64 bool = machine != EM_ARM

	// Structure sizes depend on ELF class
	var ehdrSize int = 64   // Elf64_Ehdr
	var shdrSize int = 64   // Elf64_Shdr
	var symSize int = 24    // Elf64_Sym
	var relaSize int = 24   // Elf64_Rela
	if !is64 {
		ehdrSize = 52   // Elf32_Ehdr
		shdrSize = 40   // Elf32_Shdr
		symSize = 16    // Elf32_Sym
		relaSize = 12   // Elf32_Rela
	}

	// Count data sections
	var numDataSects int = a.NumSections

	// Build section header string table (.shstrtab)
	var shstrtab StrTab = newStrTab()
	var shstrtabNames @[]int = make_slice(int, numDataSects + 10)

	// Collect section names
	for i := 0; i < numDataSects; i++ {
		var ename @[]char = elfSectName(a.Sections[i].Name)
		shstrtabNames[i] = strTabAdd(&shstrtab, ename)
	}

	// Count rela sections
	var numRelaSects int = 0
	var relaForSect @[]int = make_slice(int, numDataSects)
	for i := 0; i < numDataSects; i++ {
		var nreloc int = countRelocsForSection(a, i)
		if nreloc > 0 {
			relaForSect[i] = numRelaSects
			numRelaSects = numRelaSects + 1
		} else {
			relaForSect[i] = -1
		}
	}

	// Rela section names
	var relaNameOffsets @[]int = make_slice(int, numRelaSects)
	var relaIdx int = 0
	for i := 0; i < numDataSects; i++ {
		if relaForSect[i] >= 0 {
			var rname buf.CharBuf = buf.New()
			rname = rname.WriteStr(".rela.")
			rname = rname.WriteStr(a.Sections[i].Name)
			relaNameOffsets[relaIdx] = strTabAdd(&shstrtab, rname.Bytes())
			relaIdx = relaIdx + 1
		}
	}

	var symtabNameOff int = strTabAdd(&shstrtab, ".symtab")
	var strtabNameOff int = strTabAdd(&shstrtab, ".strtab")
	var shstrtabNameOff int = strTabAdd(&shstrtab, ".shstrtab")

	// Total section count: null + data + rela + symtab + strtab + shstrtab
	var totalSects int = 1 + numDataSects + numRelaSects + 3
	var symtabSectIdx int = 1 + numDataSects + numRelaSects
	var strtabSectIdx int = symtabSectIdx + 1
	var shstrtabSectIdx int = strtabSectIdx + 1

	// Build sorted symbol order: locals first, then globals.
	// ELF requires all STB_LOCAL symbols before STB_GLOBAL/STB_WEAK.
	// symOrder[i] = original index of the i-th symbol in sorted order.
	// symRemap[orig] = new index (1-based, since 0 is null).
	var symOrder @[]int = make_slice(int, a.NumSymbols)
	var symRemap @[]int = make_slice(int, a.NumSymbols)
	var nextLocal int = 0
	var nextGlobal int = 0
	// Count locals first to know where globals start
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Binding == asm.BIND_LOCAL {
			nextGlobal = nextGlobal + 1
		}
	}
	var globalStart int = nextGlobal
	nextGlobal = globalStart
	// Build the order
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Binding == asm.BIND_LOCAL {
			symOrder[nextLocal] = i
			symRemap[i] = nextLocal
			nextLocal = nextLocal + 1
		} else {
			symOrder[nextGlobal] = i
			symRemap[i] = nextGlobal
			nextGlobal = nextGlobal + 1
		}
	}

	// Build symbol string table (.strtab) in sorted order
	var strtab StrTab = newStrTab()
	var symStrOffsets @[]int = make_slice(int, a.NumSymbols)
	for i := 0; i < a.NumSymbols; i++ {
		var orig int = symOrder[i]
		symStrOffsets[i] = strTabAdd(&strtab, a.Symbols[orig].Name)
	}

	// --- Layout calculation ---
	var offset int = ehdrSize

	// Data section offsets
	var sectOffsets @[]int = make_slice(int, numDataSects)
	for i := 0; i < numDataSects; i++ {
		if offset % 16 != 0 { offset = offset + (16 - offset % 16) }
		sectOffsets[i] = offset
		offset = offset + a.Sections[i].Len
	}

	// Rela section offsets
	var relaAlign int = 8
	if !is64 { relaAlign = 4 }
	var relaSectOffsets @[]int = make_slice(int, numRelaSects)
	var relaSectSizes @[]int = make_slice(int, numRelaSects)
	relaIdx = 0
	for i := 0; i < numDataSects; i++ {
		if relaForSect[i] >= 0 {
			if offset % relaAlign != 0 {
				offset = offset + (relaAlign - offset % relaAlign)
			}
			relaSectOffsets[relaIdx] = offset
			var nreloc int = countRelocsForSection(a, i)
			relaSectSizes[relaIdx] = nreloc * relaSize
			offset = offset + relaSectSizes[relaIdx]
			relaIdx = relaIdx + 1
		}
	}

	// Symtab offset
	var symAlign int = 8
	if !is64 { symAlign = 4 }
	if offset % symAlign != 0 {
		offset = offset + (symAlign - offset % symAlign)
	}
	var symtabOff int = offset
	var numSyms int = 1 + a.NumSymbols
	var symtabSize int = numSyms * symSize
	offset = offset + symtabSize

	// Count local symbols for sh_info
	var numLocals int = 1
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Binding == asm.BIND_LOCAL {
			numLocals = numLocals + 1
		}
	}

	// Strtab offset
	var strtabOff int = offset
	var strtabData @[]char = strtab.Buf.Bytes()
	var strtabSize int = len(strtabData)
	offset = offset + strtabSize

	// Shstrtab offset
	var shstrtabOff int = offset
	var shstrtabData @[]char = shstrtab.Buf.Bytes()
	var shstrtabSize int = len(shstrtabData)
	offset = offset + shstrtabSize

	// Section header table offset
	if offset % symAlign != 0 {
		offset = offset + (symAlign - offset % symAlign)
	}
	var shoff int = offset

	// --- Build the file ---
	var bb BinBuf = newBinBuf()

	// ELF header (e_ident is the same for both classes)
	bb = bb.WriteU8(ELFMAG0)
	bb = bb.WriteU8(ELFMAG1)
	bb = bb.WriteU8(ELFMAG2)
	bb = bb.WriteU8(ELFMAG3)
	if is64 {
		bb = bb.WriteU8(ELFCLASS64)
	} else {
		bb = bb.WriteU8(ELFCLASS32)
	}
	bb = bb.WriteU8(ELFDATA2LSB)
	bb = bb.WriteU8(EV_CURRENT)
	bb = bb.WriteU8(ELFOSABI_NONE)
	bb = bb.WriteZeros(8)  // padding
	bb = bb.WriteU16(ET_REL)
	bb = bb.WriteU16(cast(uint16, machine))
	bb = bb.WriteU32(1)  // e_version
	bb = bb.WriteAddr(0, is64)              // e_entry
	bb = bb.WriteAddr(0, is64)              // e_phoff
	bb = bb.WriteAddr(shoff, is64)          // e_shoff
	bb = bb.WriteU32(0)                     // e_flags
	bb = bb.WriteU16(cast(uint16, ehdrSize))  // e_ehsize
	bb = bb.WriteU16(0)                     // e_phentsize
	bb = bb.WriteU16(0)                     // e_phnum
	bb = bb.WriteU16(cast(uint16, shdrSize))  // e_shentsize
	bb = bb.WriteU16(cast(uint16, totalSects))
	bb = bb.WriteU16(cast(uint16, shstrtabSectIdx))

	// Section data
	for i := 0; i < numDataSects; i++ {
		for bb.Len < sectOffsets[i] { bb = bb.WriteU8(0) }
		var s @asm.Section = a.Sections[i]
		if s.Len > 0 {
			var data *[]uint8 = s.Data[0:s.Len]
			bb = bb.WriteBytes(data, s.Len)
		}
	}

	// Relocation sections (.rela)
	relaIdx = 0
	for si := 0; si < numDataSects; si++ {
		if relaForSect[si] < 0 { continue }
		for bb.Len < relaSectOffsets[relaIdx] { bb = bb.WriteU8(0) }
		for ri := 0; ri < a.NumRelocs; ri++ {
			var rel asm.Relocation = a.Relocs[ri]
			if rel.Section != si { continue }
			var rtype int = elfRelocType(rel.Kind, machine)
			// Remap symbol index to sorted order (+1 for null entry)
			var symPlusOne int = symRemap[rel.Symbol] + 1
			if is64 {
				bb = bb.WriteU64(cast(uint64, rel.Offset))
				// r_info = (sym << 32) | type
				var si64 uint64 = cast(uint64, symPlusOne)
				bb = bb.WriteU64((si64 << 32) | cast(uint64, rtype))
				bb = bb.WriteU64(cast(uint64, rel.Addend))
			} else {
				bb = bb.WriteU32(cast(uint32, rel.Offset))
				// r_info = (sym << 8) | type
				var ri32 uint32 = cast(uint32, symPlusOne)
				bb = bb.WriteU32((ri32 << 8) | cast(uint32, rtype))
				bb = bb.WriteU32(cast(uint32, rel.Addend))
			}
		}
		relaIdx = relaIdx + 1
	}

	// Symbol table
	for bb.Len < symtabOff { bb = bb.WriteU8(0) }
	// Null symbol
	bb = bb.WriteZeros(symSize)
	// Our symbols (sorted: locals first, then globals)
	for i := 0; i < a.NumSymbols; i++ {
		var orig int = symOrder[i]
		var sym asm.Symbol = a.Symbols[orig]
		var binding int = STB_LOCAL
		if sym.Binding == asm.BIND_GLOBAL { binding = STB_GLOBAL }
		if sym.Binding == asm.BIND_WEAK { binding = STB_WEAK }
		var stype int = STT_NOTYPE
		var stInfo uint8 = cast(uint8, (binding << 4) | stype)
		var shndx uint16 = 0
		if sym.Section >= 0 {
			shndx = cast(uint16, sym.Section + 1)
		}

		if is64 {
			// Elf64_Sym: name(4), info(1), other(1), shndx(2), value(8), size(8)
			bb = bb.WriteU32(cast(uint32, symStrOffsets[i]))
			bb = bb.WriteU8(stInfo)
			bb = bb.WriteU8(0)
			bb = bb.WriteU16(shndx)
			bb = bb.WriteU64(cast(uint64, sym.Offset))
			bb = bb.WriteU64(0)
		} else {
			// Elf32_Sym: name(4), value(4), size(4), info(1), other(1), shndx(2)
			bb = bb.WriteU32(cast(uint32, symStrOffsets[i]))
			bb = bb.WriteU32(cast(uint32, sym.Offset))
			bb = bb.WriteU32(0)
			bb = bb.WriteU8(stInfo)
			bb = bb.WriteU8(0)
			bb = bb.WriteU16(shndx)
		}
	}

	// String table (.strtab)
	bb = bb.WriteBytes(strtabData, strtabSize)

	// Section header string table (.shstrtab)
	bb = bb.WriteBytes(shstrtabData, shstrtabSize)

	// Section header table
	for bb.Len < shoff { bb = bb.WriteU8(0) }

	// SHdr 0: null
	bb = bb.WriteZeros(shdrSize)

	// SHdr: data sections
	for i := 0; i < numDataSects; i++ {
		var flags int = cast(int, elfSectFlags(a.Sections[i].Name))
		bb = emitShdr(bb, is64,
			cast(uint32, shstrtabNames[i]),
			elfSectType(a.Sections[i].Name),
			flags, 0, sectOffsets[i], a.Sections[i].Len,
			0, 0, 16, 0)
	}

	// SHdr: rela sections
	relaIdx = 0
	for i := 0; i < numDataSects; i++ {
		if relaForSect[i] < 0 { continue }
		bb = emitShdr(bb, is64,
			cast(uint32, relaNameOffsets[relaIdx]),
			SHT_RELA, 0, 0,
			relaSectOffsets[relaIdx], relaSectSizes[relaIdx],
			cast(uint32, symtabSectIdx), cast(uint32, i + 1),
			relaAlign, relaSize)
		relaIdx = relaIdx + 1
	}

	// SHdr: .symtab
	bb = emitShdr(bb, is64,
		cast(uint32, symtabNameOff), SHT_SYMTAB,
		0, 0, symtabOff, symtabSize,
		cast(uint32, strtabSectIdx), cast(uint32, numLocals),
		symAlign, symSize)

	// SHdr: .strtab
	bb = emitShdr(bb, is64,
		cast(uint32, strtabNameOff), SHT_STRTAB,
		0, 0, strtabOff, strtabSize,
		0, 0, 1, 0)

	// SHdr: .shstrtab
	bb = emitShdr(bb, is64,
		cast(uint32, shstrtabNameOff), SHT_STRTAB,
		0, 0, shstrtabOff, shstrtabSize,
		0, 0, 1, 0)

	// --- Write to file ---
	var fd int = bootstrap.Open(path, bootstrap.O_WRONLY | bootstrap.O_CREATE | bootstrap.O_TRUNC)
	if fd < 0 { return false }
	var data *[]uint8 = bb.Data[0:bb.Len]
	var written int = bootstrap.Write(fd, data)
	bootstrap.Close(fd)
	return written == bb.Len
}

// WriteAArch64 emits the assembler's contents as an AArch64 ELF object
// at `path`. Returns true on success.
func WriteAArch64(a @asm.Assembler, path *[]const char) bool {
	return Write(a, path, EM_AARCH64)
}

// WriteX86_64 emits the assembler's contents as an x86-64 ELF object
// at `path`. Returns true on success.
func WriteX86_64(a @asm.Assembler, path *[]const char) bool {
	return Write(a, path, EM_X86_64)
}

// WriteARM32 is a convenience for ARM32 ELF.
func WriteARM32(a @asm.Assembler, path *[]const char) bool {
	return Write(a, path, EM_ARM)
}
