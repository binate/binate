package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/std/os"

// ELF format constants (magic, class, section/symbol/relocation types)
// live in elf_const.bn.

// --- Main write function ---

func Write(a @asm.Assembler, path *[]readonly char, machine int, hardFloat bool) bool {
	// Whether each relocation is to a symbol with no addend of its own (plain), which picks
	// an x86-64 branch's type (elfRelocType) — read before the retargeting below adds a
	// temporary's offset to its addend.
	var plain @[]bool = make_slice(bool, a.NumRelocs)
	for ri := 0; ri < a.NumRelocs; ri++ { plain[ri] = a.Relocs[ri].Addend == 0 }
	// Relocations against temporary labels go against their section's symbol where
	// clang's would (elf_temps.bn), before the symbol table is laid out.
	if !retargetElfTemporaryRelocs(a, machine) { return false }
	// Determine 32 vs 64-bit from machine type
	var is64 bool = machine != EM_ARM
	// ARM (EM_ARM) uses REL relocations (SHT_REL, no r_addend word) per the
	// ARM 32-bit ELF psABI: GNU bfd's ARM backend is REL-only and ignores any
	// r_addend, so every addend (the -8 branch pipeline bias, ABS32 offsets)
	// must ride the instruction/data field in place, not a RELA addend.  The
	// arm32 backend bakes those addends into the fields (arm32.ResolveFixups →
	// bakeRelAddend); here we just emit the narrower REL form.  aarch64/x86-64
	// stay RELA.  (Only EM_ARM is 32-bit today, but gate on the machine, not
	// !is64, so a future 32-bit RELA arch would not be misclassified.)
	var useRel bool = machine == EM_ARM
	// e_flags: arm32 objects must carry EABI version 5 (top byte) so GNU
	// arm-linux-gnueabihf-ld will merge them with the clang-produced, EABI-ver-5
	// dependency objects — a plain 0 reads as "EABI version 0" and the link
	// fails.  The float ABI is NOT in e_flags (clang leaves it 0 for hard and
	// soft alike); it travels in the .ARM.attributes section below.  aarch64 /
	// x86-64 have no such bits → 0.
	var eFlags int = 0
	if machine == EM_ARM {
		eFlags = EF_ARM_EABI_VER5
	}
	// A hard-float arm32 object declares its VFP calling convention via an
	// .ARM.attributes section, exactly as clang does; soft/baremetal and the
	// other machines carry none.  Appended after the string tables as the last
	// section (like .note.GNU-stack) so no existing section index shifts.
	var armAttrs @[]uint8
	var hasAttrs bool = machine == EM_ARM && hardFloat
	if hasAttrs {
		armAttrs = buildArmAttributesHard()
	}

	// Structure sizes depend on ELF class
	var ehdrSize int = 64 // Elf64_Ehdr
	var shdrSize int = 64 // Elf64_Shdr
	var symSize int = 24 // Elf64_Sym
	var relaSize int = 24 // Elf64_Rela
	if !is64 {
		ehdrSize = 52 // Elf32_Ehdr
		shdrSize = 40 // Elf32_Shdr
		symSize = 16 // Elf32_Sym
		relaSize = 12 // Elf32_Rela
	}
	if useRel {
		relaSize = 8 // Elf32_Rel (r_offset + r_info; no r_addend)
	}

	// Count data sections
	var numDataSects int = a.NumSections

	// Build section header string table (.shstrtab)
	var shstrtab StrTab = newStrTab()
	var shstrtabNames @[]int = make_slice(int, numDataSects + 10)

	// Collect section names
	for i := 0; i < numDataSects; i++ {
		var ename @[]char = elfSectName(a.Sections[i].Name)
		shstrtabNames[i] = strTabAdd(&shstrtab, ename)
	}

	// Count rela sections
	var numRelaSects int = 0
	var relaForSect @[]int = make_slice(int, numDataSects)
	for i := 0; i < numDataSects; i++ {
		var nreloc int = countRelocsForSection(a, i)
		if nreloc > 0 {
			relaForSect[i] = numRelaSects
			numRelaSects = numRelaSects + 1
		} else {
			relaForSect[i] = -1
		}
	}

	// Rela section names
	var relaNameOffsets @[]int = make_slice(int, numRelaSects)
	var relaIdx int = 0
	for i := 0; i < numDataSects; i++ {
		if relaForSect[i] >= 0 {
			var rname @[]char = relaSectName(a.Sections[i].Name, useRel)
			relaNameOffsets[relaIdx] = strTabAdd(&shstrtab, rname)
			relaIdx = relaIdx + 1
		}
	}

	var symtabNameOff int = strTabAdd(&shstrtab, ".symtab")
	var strtabNameOff int = strTabAdd(&shstrtab, ".strtab")
	var shstrtabNameOff int = strTabAdd(&shstrtab, ".shstrtab")
	// An empty .note.GNU-stack section (SHT_PROGBITS, no SHF_EXECINSTR)
	// tells ld this object needs no executable stack.  Without it, ld
	// conservatively marks the linked binary's stack RWX (PT_GNU_STACK
	// with execute).  Emitted as the LAST section so every existing
	// index (rela/symtab sh_link, e_shstrndx) is unchanged.
	var gnuStackNameOff int = strTabAdd(&shstrtab, ".note.GNU-stack")
	// .ARM.attributes name (only when we emit that section).
	var armAttrNameOff int = 0
	if hasAttrs {
		armAttrNameOff = strTabAdd(&shstrtab, ".ARM.attributes")
	}

	// Total section count: null + data + rela + symtab + strtab + shstrtab
	// + .note.GNU-stack (+ .ARM.attributes when present)
	var totalSects int = 1 + numDataSects + numRelaSects + 4
	if hasAttrs { totalSects = totalSects + 1 }
	var symtabSectIdx int = 1 + numDataSects + numRelaSects
	var strtabSectIdx int = symtabSectIdx + 1
	var shstrtabSectIdx int = strtabSectIdx + 1

	// The symbol table (locals first; temporaries only when a relocation names one) and its
	// names (.strtab).
	var strtab StrTab = newStrTab()
	var symtab elfSymtab = buildElfSymtab(a, &strtab)

	// --- Layout calculation ---
	var offset int = ehdrSize

	// Data section offsets
	var sectOffsets @[]int = make_slice(int, numDataSects)
	for i := 0; i < numDataSects; i++ {
		// Each section's file offset is a multiple of its sh_addralign (16, or the
		// larger alignment `.balign` / `.p2align` requested), as the gABI expects.
		var sa int = 16
		if a.Sections[i].Align > sa { sa = a.Sections[i].Align }
		if offset % sa != 0 { offset = offset + (sa - offset % sa) }
		sectOffsets[i] = offset
		offset = offset + a.Sections[i].Len
	}

	// Rela section offsets
	var relaAlign int = 8
	if !is64 { relaAlign = 4 }
	var relaSectOffsets @[]int = make_slice(int, numRelaSects)
	var relaSectSizes @[]int = make_slice(int, numRelaSects)
	relaIdx = 0
	for i := 0; i < numDataSects; i++ {
		if relaForSect[i] >= 0 {
			if offset % relaAlign != 0 {
				offset = offset + (relaAlign - offset % relaAlign)
			}
			relaSectOffsets[relaIdx] = offset
			var nreloc int = countRelocsForSection(a, i)
			relaSectSizes[relaIdx] = nreloc * relaSize
			offset = offset + relaSectSizes[relaIdx]
			relaIdx = relaIdx + 1
		}
	}

	// Symtab offset
	var symAlign int = 8
	if !is64 { symAlign = 4 }
	if offset % symAlign != 0 {
		offset = offset + (symAlign - offset % symAlign)
	}
	var symtabOff int = offset
	var numSyms int = 1 + symtab.N
	var symtabSize int = numSyms * symSize
	offset = offset + symtabSize
	var numLocals int = symtab.NumLocals

	// Strtab offset
	var strtabOff int = offset
	var strtabData @[]char = buf.CopyStr(strtab.Buf.String())
	var strtabSize int = len(strtabData)
	offset = offset + strtabSize

	// Shstrtab offset
	var shstrtabOff int = offset
	var shstrtabData @[]char = buf.CopyStr(shstrtab.Buf.String())
	var shstrtabSize int = len(shstrtabData)
	offset = offset + shstrtabSize

	// .ARM.attributes content, placed after .shstrtab and before the section
	// header table.  addralign 1, so no padding is needed before it.
	var armAttrsOff int = 0
	if hasAttrs {
		armAttrsOff = offset
		offset = offset + len(armAttrs)
	}

	// Section header table offset
	if offset % symAlign != 0 {
		offset = offset + (symAlign - offset % symAlign)
	}
	var shoff int = offset

	// --- Build the file ---
	var bb BinBuf = newBinBuf()

	// ELF header (e_ident is the same for both classes)
	bb = bb.WriteU8(ELFMAG0)
	bb = bb.WriteU8(ELFMAG1)
	bb = bb.WriteU8(ELFMAG2)
	bb = bb.WriteU8(ELFMAG3)
	if is64 {
		bb = bb.WriteU8(ELFCLASS64)
	} else {
		bb = bb.WriteU8(ELFCLASS32)
	}
	bb = bb.WriteU8(ELFDATA2LSB)
	bb = bb.WriteU8(EV_CURRENT)
	bb = bb.WriteU8(ELFOSABI_NONE)
	bb = bb.WriteZeros(8) // padding
	bb = bb.WriteU16(ET_REL)
	bb = bb.WriteU16(cast(uint16, machine))
	bb = bb.WriteU32(1) // e_version
	bb = bb.WriteAddr(0, is64) // e_entry
	bb = bb.WriteAddr(0, is64) // e_phoff
	bb = bb.WriteAddr(shoff, is64) // e_shoff
	bb = bb.WriteU32(cast(uint32, eFlags)) // e_flags
	bb = bb.WriteU16(cast(uint16, ehdrSize)) // e_ehsize
	bb = bb.WriteU16(0) // e_phentsize
	bb = bb.WriteU16(0) // e_phnum
	bb = bb.WriteU16(cast(uint16, shdrSize)) // e_shentsize
	bb = bb.WriteU16(cast(uint16, totalSects))
	bb = bb.WriteU16(cast(uint16, shstrtabSectIdx))

	// Section data
	for i := 0; i < numDataSects; i++ {
		for bb.Len < sectOffsets[i] { bb = bb.WriteU8(0) }
		var s @asm.Section = a.Sections[i]
		if s.Len > 0 {
			// bnlint:allow managed-to-raw-assign - s is a live @asm.Section; Data outlives the read
			var data *[]uint8 = s.Data[0:s.Len]
			bb = bb.WriteBytes(data, s.Len)
		}
	}

	// Relocation sections (.rela)
	relaIdx = 0
	for si := 0; si < numDataSects; si++ {
		if relaForSect[si] < 0 { continue }
		for bb.Len < relaSectOffsets[relaIdx] { bb = bb.WriteU8(0) }
		for ri := 0; ri < a.NumRelocs; ri++ {
			var rel asm.Relocation = a.Relocs[ri]
			if rel.Section != si { continue }
			var rtype int = elfRelocType(rel.Kind, machine, plain[ri])
			// FIX_BRANCH26 covers both B and BL; ELF distinguishes a call (CALL26)
			// from a jump (JUMP26), so read the patched word: BL is 100101 in 31:26.
			if machine == EM_AARCH64 && rtype == R_AARCH64_JUMP26 &&
					isBlWord(a.Sections[rel.Section].Data, cast(int, rel.Offset)) {
				rtype = R_AARCH64_CALL26
			}
			// Likewise FIX_BRANCH24 covers B and BL: an unconditional BL is a call
			// (R_ARM_CALL, which a linker may turn into BLX for Thumb code); B and a
			// conditional B or BL stay R_ARM_JUMP24, as clang emits them.
			if machine == EM_ARM && rtype == R_ARM_JUMP24 &&
					isArmBlWord(a.Sections[rel.Section].Data, cast(int, rel.Offset)) {
				rtype = R_ARM_CALL
			}
			// An unmapped (kind, machine) has no ELF encoding: fail loud
			// rather than write R_<arch>_NONE (reloc type 0, a linker no-op
			// that would silently leave the field unrelocated — a silent
			// miscompile).  Mirrors the Mach-O writer's rtype<0 guard.
			if rtype < 0 {
				a.SetError("elf: fixup kind has no ELF reloc encoding")
				return false
			}
			// The target's symbol table index (every symbol a relocation names is listed;
			// one that is not would bind the relocation to the null symbol).
			var symPlusOne int = symtab.Remap[rel.Symbol]
			if symPlusOne == 0 {
				a.SetError(
						buf.Concat(
								buf.Concat("elf: a relocation targets '", asm.LabelForMessage(a.Symbols[rel.Symbol].Name)),
								"', which is not in the symbol table"))
				return false
			}
			// PC-relative relocs need a per-arch addend correction (x86-64
			// PC32 is measured from the instruction end — see elfRelocAddend).
			var effAddend int = elfRelocAddend(rtype, machine, rel.Addend)
			if is64 {
				bb = bb.WriteU64(cast(uint64, rel.Offset))
				// r_info = (sym << 32) | type
				var si64 uint64 = cast(uint64, symPlusOne)
				bb = bb.WriteU64((si64 << 32) | cast(uint64, rtype))
				bb = bb.WriteU64(cast(uint64, effAddend))
			} else {
				bb = bb.WriteU32(cast(uint32, rel.Offset))
				// r_info = (sym << 8) | type
				var ri32 uint32 = cast(uint32, symPlusOne)
				bb = bb.WriteU32((ri32 << 8) | cast(uint32, rtype))
				if !useRel {
					bb = bb.WriteU32(cast(uint32, effAddend))
				}
				// useRel (ARM): Elf32_Rel has no r_addend — the addend is baked
				// into the instruction/data field by arm32.ResolveFixups.
			}
		}
		relaIdx = relaIdx + 1
	}

	// Symbol table
	for bb.Len < symtabOff { bb = bb.WriteU8(0) }
	// Null symbol
	bb = bb.WriteZeros(symSize)
	bb = writeElfSymbols(bb, a, symtab, is64)

	// String table (.strtab)
	bb = bb.WriteBytes(strtabData, strtabSize)

	// Section header string table (.shstrtab)
	bb = bb.WriteBytes(shstrtabData, shstrtabSize)

	// .ARM.attributes section content
	if hasAttrs {
		for bb.Len < armAttrsOff { bb = bb.WriteU8(0) }
		// bnlint:allow managed-to-raw-assign - armAttrs is a live managed local; outlives the read
		var attrRaw *[]uint8 = armAttrs[0:len(armAttrs)]
		bb = bb.WriteBytes(attrRaw, len(armAttrs))
	}

	// Section header table
	for bb.Len < shoff { bb = bb.WriteU8(0) }

	// SHdr 0: null
	bb = bb.WriteZeros(shdrSize)

	// SHdr: data sections
	for i := 0; i < numDataSects; i++ {
		var flags int = cast(int, elfSectFlags(a.Sections[i].Name))
		// At least 16, raised to any larger alignment the section requested.
		var addralign int = 16
		if a.Sections[i].Align > addralign { addralign = a.Sections[i].Align }
		bb = emitShdr(bb, is64, cast(uint32, shstrtabNames[i]), elfSectType(a.Sections[i].Name), flags, 0,
				sectOffsets[i], a.Sections[i].Len, 0, 0, addralign, 0)
	}

	// SHdr: relocation sections (SHT_REL for ARM, SHT_RELA otherwise)
	var relSectType uint32 = SHT_RELA
	if useRel { relSectType = SHT_REL }
	relaIdx = 0
	for i := 0; i < numDataSects; i++ {
		if relaForSect[i] < 0 { continue }
		bb = emitShdr(bb, is64, cast(uint32, relaNameOffsets[relaIdx]), relSectType, 0, 0,
				relaSectOffsets[relaIdx], relaSectSizes[relaIdx], cast(uint32, symtabSectIdx),
				cast(uint32, i + 1), relaAlign, relaSize)
		relaIdx = relaIdx + 1
	}

	// SHdr: .symtab
	bb = emitShdr(bb, is64, cast(uint32, symtabNameOff), SHT_SYMTAB, 0, 0, symtabOff, symtabSize,
			cast(uint32, strtabSectIdx), cast(uint32, numLocals), symAlign, symSize)

	// SHdr: .strtab
	bb = emitShdr(bb, is64, cast(uint32, strtabNameOff), SHT_STRTAB, 0, 0, strtabOff, strtabSize, 0, 0,
			1, 0)

	// SHdr: .shstrtab
	bb = emitShdr(bb, is64, cast(uint32, shstrtabNameOff), SHT_STRTAB, 0, 0, shstrtabOff, shstrtabSize,
			0, 0, 1, 0)

	// SHdr: .note.GNU-stack — empty, flags 0 (no SHF_EXECINSTR) → the
	// linker leaves the program stack non-executable.  Zero size, so
	// sh_offset is immaterial.
	bb = emitShdr(bb, is64, cast(uint32, gnuStackNameOff), SHT_PROGBITS, 0, 0, 0, 0, 0, 0, 1, 0)

	// SHdr: .ARM.attributes — SHT_ARM_ATTRIBUTES, non-alloc (flags 0), align 1,
	// no link/info.  Emitted last, so it does not shift any earlier index.
	if hasAttrs {
		bb = emitShdr(bb, is64, cast(uint32, armAttrNameOff), SHT_ARM_ATTRIBUTES, 0, 0, armAttrsOff,
				len(armAttrs), 0, 0, 1, 0)
	}

	// --- Write to file ---
	f, oerr := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(oerr) { return false }
	// bnlint:allow managed-to-raw-assign - bb is the live output builder; Data outlives the read
	var data *[]uint8 = bb.Data[0:bb.Len]
	written, _ := f.Write(data)
	_ = f.Close()
	return written == bb.Len
}

// WriteAArch64 emits the assembler's contents as an AArch64 ELF object
// at `path`. Returns true on success.  aarch64 has no EABI-version / float-ABI
// e_flags bits and no .ARM.attributes, so hardFloat is false.
func WriteAArch64(a @asm.Assembler, path *[]readonly char) bool {
	return Write(a, path, EM_AARCH64, false)
}

// WriteX86_64 emits the assembler's contents as an x86-64 ELF object
// at `path`. Returns true on success.
func WriteX86_64(a @asm.Assembler, path *[]readonly char) bool {
	return Write(a, path, EM_X86_64, false)
}

// WriteARM32 is a convenience for ARM32 ELF.  hardFloat (arm32-linux AAPCS-VFP)
// adds the .ARM.attributes VFP-args declaration; the caller passes
// types.Arm32HardFloat().  Every arm32 object gets EABI version 5 in e_flags.
func WriteARM32(a @asm.Assembler, path *[]readonly char, hardFloat bool) bool {
	return Write(a, path, EM_ARM, hardFloat)
}
