package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Absolute symbols (asm.Symbol.Abs — the assembler's constants) and aliases in an ELF
// object, as clang lists them: an absolute symbol has section index SHN_ABS and its value
// (two's complement when negative, the low 32 bits in an ELF32 object) with its binding; a
// temporary's (`.LN`) is left out; an alias is a symbol at its location.  (c26Read is in
// elf_call26_test.bn, tmpSymtab / tmpNameIs in elf_symtab_test.bn, rdU16 / rdU32 / rdU64 in
// elf_test.bn.)

// absSymAt returns the info byte, section index and value of the ELF64 symbol named name in
// b, or found=false.
func absSymAt(b @[]uint8, name *[]readonly char) (int, int, int, bool) {
	symOff, nsyms, _, strOff := tmpSymtab(b)
	if symOff < 0 { return 0, 0, 0, false }
	for i := 1; i < nsyms; i++ {
		var e int = symOff + i * 24
		if tmpNameIs(b, strOff + rdU32(b, e), name) {
			return cast(int, b[e + 4]), rdU16(b, e + 6), rdU64(b, e + 8), true
		}
	}
	return 0, 0, 0, false
}

// An AArch64 object with local N = -3, global G = 7, a temporary .LN = 5, an alias A at
// text+4 and a temporary alias .Lend: N and G are SHN_ABS with their values and bindings,
// .LN and .Lend are not listed, and A is a local symbol in text at 4.
func TestWriteElfAbsoluteSymbols() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.EmitUint32(0xD503201F)
	a.EmitUint32(0xD503201F)
	a.DefineAbsolute("N", -3)
	a.SetGlobal("G")
	a.DefineAbsolute("G", 7)
	a.DefineAbsolute(".LN", 5)
	a.DefineAlias("A", 0, cast(uint, 4), true)
	a.DefineAlias(".Lend", 0, cast(uint, 8), true)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/elf_abs.o")
	if !WriteAArch64(a, path) { return fail("failed to write ELF") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	ni, ns, nv, nok := absSymAt(b, "N")
	if !nok || ni != (STB_LOCAL << 4) || ns != SHN_ABS || nv != -3 {
		return fail("N not local ABS -3")
	}
	gi, gs, gv, gok := absSymAt(b, "G")
	if !gok || (gi >> 4) != STB_GLOBAL || gs != SHN_ABS || gv != 7 {
		return fail("G not global ABS 7")
	}
	_, _, _, lok := absSymAt(b, ".LN")
	if lok { return fail("the temporary .LN listed") }
	_, _, _, eok := absSymAt(b, ".Lend")
	if eok { return fail("the temporary alias .Lend listed") }
	ai, as, av, aok := absSymAt(b, "A")
	if !aok || (ai >> 4) != STB_LOCAL || as != 1 || av != 4 {
		return fail("A not a local text symbol at 4")
	}
	return ""
}

// In an ELF32 (arm32) object an absolute symbol keeps the low 32 bits of its value, as
// clang's does (BIG = 0x123456789 is 0x23456789).
func TestWriteElf32AbsoluteValueTruncates() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.EmitUint32(0xE320F000)
	a.DefineAbsolute("BIG", 0x123456789)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/elf32_abs.o")
	if !WriteARM32(a, path, false) { return fail("failed to write ELF32") }
	b, n := c26Read(path)
	if n < 100 { return fail("cannot read back the ELF32 object") }
	var shoff int = rdU32(b, 32)
	var shentsize int = rdU16(b, 46)
	var shnum int = rdU16(b, 48)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if rdU32(b, sh + 4) != cast(int, SHT_SYMTAB) { continue }
		var symOff int = rdU32(b, sh + 16)
		var nsyms int = rdU32(b, sh + 20) / 16
		var strOff int = rdU32(b, shoff + rdU32(b, sh + 24) * shentsize + 16)
		for k := 1; k < nsyms; k++ {
			var e int = symOff + k * 16
			if !tmpNameIs(b, strOff + rdU32(b, e), "BIG") { continue }
			if rdU16(b, e + 14) != SHN_ABS { return fail("BIG not SHN_ABS") }
			if rdU32(b, e + 4) != 0x23456789 { return fail("BIG's value not its low 32 bits") }
			return ""
		}
	}
	return fail("BIG not listed")
}
