package "pkg/binate/asm/elf"

// ARM build attributes (.ARM.attributes, EABI "Addenda to ABI" §2.2).  A
// hard-float arm32 object declares its VFP calling convention here so the
// object truthfully describes its ABI, exactly as clang/gcc do.  The critical
// tag is Tag_ABI_VFP_args = "VFP registers": GNU ld cross-checks it when merging
// objects, and an object that declares the SOFT convention linked against
// hard-float dependencies is rejected outright.  (An object with NO attributes
// section links either way — ld skips the merge — which is why a soft/baremetal
// object omits it entirely; see Write.)  We also record Tag_CPU_arch = v7 and
// Tag_FP_arch = VFPv3 to match the armv7-a hard-float deps, but deliberately do
// NOT advertise NEON (Tag_Advanced_SIMD_arch): the native backend emits only
// scalar VFP.
//
// Byte layout (all length fields little-endian u32; all tag values are
// single-byte ULEB128 here):
//
//   'A'                       attribute format version
//   u32 vendorLen = 21        length of the "aeabi" vendor subsection, COUNTING
//                             this length field
//   "aeabi\0"                 vendor name (NUL-terminated)
//   u8  Tag_File = 1          these attributes apply to the whole file
//   u32 fileLen = 11          length of this Tag_File block, COUNTING the tag
//                             byte and this length field
//   06 0a                     Tag_CPU_arch (6)      = v7 (10)
//   0a 03                     Tag_FP_arch (10)      = VFPv3 (3)
//   1c 01                     Tag_ABI_VFP_args (28) = VFP registers (1)
//
// Total 22 bytes.  Verified byte-identical in intent against
// `clang -target arm-linux-gnueabihf -march=armv7-a -mfloat-abi=hard`
// (readelf -A).  See explorations/plan-native-arm32.md (inc 3f).
func buildArmAttributesHard() @[]uint8 {
	var b @[]uint8 = make_slice(uint8, 22)
	// make_slice zero-fills, so every unset byte below (the high bytes of the
	// two u32 lengths, and the "aeabi" NUL terminator at b[10]) is already 0.
	b[0] = 0x41 // 'A'
	b[1] = 21 // vendorLen = 21 (low byte; b[2..4] = 0)
	b[5] = 0x61 // 'a'
	b[6] = 0x65 // 'e'
	b[7] = 0x61 // 'a'
	b[8] = 0x62 // 'b'
	b[9] = 0x69 // 'i'  (b[10] = 0: NUL terminator)
	b[11] = 1 // Tag_File
	b[12] = 11 // fileLen = 11 (low byte; b[13..15] = 0)
	b[16] = 6 // Tag_CPU_arch
	b[17] = 10 //   = v7
	b[18] = 10 // Tag_FP_arch
	b[19] = 3 //   = VFPv3
	b[20] = 28 // Tag_ABI_VFP_args
	b[21] = 1 //   = VFP registers
	return b
}
