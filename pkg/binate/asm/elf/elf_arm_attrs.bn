package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"

// ARM build attributes (.ARM.attributes; the Addenda to the ABI for the Arm Architecture),
// written as clang writes them for armv7ve — armv7-a with hardware divide, bnc's `-march`:
// Tag_CPU_arch v7, Tag_CPU_arch_profile 'A', Tag_ARM_ISA_use, Tag_THUMB_ISA_use (Thumb-2),
// Tag_CPU_unaligned_access (v6), Tag_MPextension_use, Tag_DIV_use (allowed) and
// Tag_Virtualization_use; the FPU's (asm.Assembler.ArmFPU, asm.ArmFPUAttrs: Tag_FP_arch,
// Tag_Advanced_SIMD_arch, Tag_FP_HP_extension, each only if nonzero); the architecture's a file
// names (asm.Assembler.ArmArchName, ArmWMMX: Tag_CPU_name, Tag_WMMX_arch); and those set
// explicitly (asm.Assembler.SetArmAttr), which replace the others.  The tags go in ascending order,
// Tag_conformance first, each with a ULEB128 number, a NUL-terminated string or both
// (asm.ArmAttrKind), in one Tag_File block of one "aeabi" subsection.

// armAttrSet is the attributes an object lists: N of them, tag Tags[i] with number Nums[i] and
// string Strs[i] (as asm.ArmAttrKind says the tag takes).
type armAttrSet struct {
	Tags @[]int64
	Nums @[]int64
	Strs @[]@[]char
	N    int
}

// armAttrSetTo sets tag in s to num and str, replacing any value it has.
func armAttrSetTo(s *armAttrSet, tag int64, num int64, str *[]readonly char) {
	var at int = s.N
	for i := 0; i < s.N; i++ {
		if s.Tags[i] == tag { at = i }
	}
	if at == s.N { s.N = s.N + 1 }
	s.Tags[at] = tag
	s.Nums[at] = num
	s.Strs[at] = buf.CopyStr(str)
}

// armAttrDefault sets tag in s to num and str unless a sets it explicitly.
func armAttrDefault(a @asm.Assembler, s *armAttrSet, tag int64, num int64, str *[]readonly char) {
	for i := 0; i < a.NumArmAttrs; i++ {
		if a.ArmAttrs[i].Tag == tag { return }
	}
	armAttrSetTo(s, tag, num, str)
}

// elfArmAttributes returns the .ARM.attributes section of a's object.
func elfArmAttributes(a @asm.Assembler) @[]uint8 {
	var s armAttrSet
	var room int = 16 + a.NumArmAttrs
	s.Tags = make_slice(int64, room)
	s.Nums = make_slice(int64, room)
	s.Strs = make_slice(@[]char, room)
	armAttrDefault(a, &s, 6, 10, "") // Tag_CPU_arch: v7
	armAttrDefault(a, &s, 7, 65, "") // Tag_CPU_arch_profile: 'A'
	armAttrDefault(a, &s, 8, 1, "") // Tag_ARM_ISA_use
	armAttrDefault(a, &s, 9, 2, "") // Tag_THUMB_ISA_use: Thumb-2
	armAttrDefault(a, &s, asm.ARM_TAG_CPU_UNALIGNED_ACCESS, 1, "") // v6-style
	armAttrDefault(a, &s, 42, 1, "") // Tag_MPextension_use
	armAttrDefault(a, &s, 44, 2, "") // Tag_DIV_use: allowed
	armAttrDefault(a, &s, 68, 3, "") // Tag_Virtualization_use: TrustZone and virtualization
	if len(a.ArmArchName) > 0 { armAttrDefault(a, &s, asm.ARM_TAG_CPU_NAME, 0, a.ArmArchName) }
	if a.ArmWMMX != 0 { armAttrDefault(a, &s, asm.ARM_TAG_WMMX_ARCH, a.ArmWMMX, "") }
	if len(a.ArmFPU) > 0 {
		var fp int64
		var simd int64
		var hp int64
		fp, simd, hp, _ = asm.ArmFPUAttrs(a.ArmFPU)
		if fp != 0 { armAttrDefault(a, &s, asm.ARM_TAG_FP_ARCH, fp, "") }
		if simd != 0 { armAttrDefault(a, &s, asm.ARM_TAG_ADVANCED_SIMD_ARCH, simd, "") }
		if hp != 0 { armAttrDefault(a, &s, asm.ARM_TAG_FP_HP_EXTENSION, hp, "") }
	}
	for i := 0; i < a.NumArmAttrs; i++ {
		var attr asm.ArmAttr = a.ArmAttrs[i]
		armAttrSetTo(&s, attr.Tag, attr.Num, attr.Str)
	}
	// The order: Tag_conformance first, then ascending.
	var order @[]int = make_slice(int, s.N)
	var keys @[]int64 = make_slice(int64, s.N)
	for i := 0; i < s.N; i++ {
		order[i] = i
		keys[i] = s.Tags[i]
		if s.Tags[i] == asm.ARM_TAG_CONFORMANCE { keys[i] = -1 }
	}
	asm.SortIndices(order, asm.SORT_BY_KEY, keys, make_slice(@[]char, 0))
	var body BinBuf = newBinBuf()
	for k := 0; k < s.N; k++ {
		var i int = order[k]
		var takesNum bool
		var takesStr bool
		takesNum, takesStr = asm.ArmAttrKind(s.Tags[i])
		body = writeULEB128(body, cast(uint64, s.Tags[i]))
		if takesNum { body = writeULEB128(body, cast(uint64, s.Nums[i])) }
		if takesStr {
			// bnlint:allow managed-to-raw-assign - s.Strs[i] is live in s; outlives the write
			var str *[]uint8 = s.Strs[i][0:len(s.Strs[i])]
			body = body.WriteBytes(str, len(str))
			body = body.WriteU8(0)
		}
	}
	var out BinBuf = newBinBuf()
	out = out.WriteU8(0x41) // 'A': the format version
	out = out.WriteU32(cast(uint32, 15 + body.Len)) // the "aeabi" subsection, this field included
	var vendor *[]readonly uint8 = "aeabi"
	for i := 0; i < len(vendor); i++ { out = out.WriteU8(vendor[i]) }
	out = out.WriteU8(0)
	out = out.WriteU8(1) // Tag_File: the attributes apply to the whole file
	// The Tag_File block's length, its tag and this field included.
	out = out.WriteU32(cast(uint32, 5 + body.Len))
	// bnlint:allow managed-to-raw-assign - body is a live local; outlives the write
	var attrs *[]uint8 = body.Data[0:body.Len]
	out = out.WriteBytes(attrs, body.Len)
	var section @[]uint8 = make_slice(uint8, out.Len)
	for i := 0; i < out.Len; i++ { section[i] = out.Data[i] }
	return section
}

// writeULEB128 appends v to b as an unsigned LEB128 number.
func writeULEB128(b BinBuf, v uint64) BinBuf {
	for {
		var byte8 uint8 = cast(uint8, v & 0x7F)
		v = v >> 7
		if v == 0 { return b.WriteU8(byte8) }
		b = b.WriteU8(byte8 | 0x80)
	}
}
