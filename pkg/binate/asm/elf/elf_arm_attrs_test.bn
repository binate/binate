package "pkg/binate/asm/elf"

import "pkg/builtins/testing"

// TestArmAttributesHardBytes pins buildArmAttributesHard byte-for-byte — the ABI
// contract for the hard-float .ARM.attributes section: 'A' + the "aeabi" vendor
// subsection carrying Tag_CPU_arch=v7, Tag_FP_arch=VFPv3, Tag_ABI_VFP_args=VFP
// registers.  A wrong byte is a link-time ABI mismatch (GNU ld rejects a
// soft-declaring object against hard-float deps), so pin every byte.  The fail()
// helper lives in elf_test.bn (same package).
func TestArmAttributesHardBytes() testing.TestResult {
	var b @[]uint8 = buildArmAttributesHard()
	if len(b) != 22 { return fail("hard .ARM.attributes should be 22 bytes") }
	var want @[]uint8 = make_slice(uint8, 22)
	want[0] = 0x41 // 'A'
	want[1] = 21 // vendorLen (u32 LE; want[2..4]=0)
	want[5] = 0x61 // 'a'
	want[6] = 0x65 // 'e'
	want[7] = 0x61 // 'a'
	want[8] = 0x62 // 'b'
	want[9] = 0x69 // 'i' (want[10]=0: NUL terminator)
	want[11] = 1 // Tag_File
	want[12] = 11 // fileLen (u32 LE; want[13..15]=0)
	want[16] = 6 // Tag_CPU_arch
	want[17] = 10 // = v7
	want[18] = 10 // Tag_FP_arch
	want[19] = 3 // = VFPv3
	want[20] = 28 // Tag_ABI_VFP_args
	want[21] = 1 // = VFP registers
	for i := 0; i < 22; i++ {
		if b[i] != want[i] { return fail("hard .ARM.attributes bytes mismatch") }
	}
	return ""
}
