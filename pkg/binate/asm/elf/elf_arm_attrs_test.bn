package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// attrHexByte returns the value of hex digit c.
func attrHexByte(c char) uint8 {
	if c >= 'a' { return cast(uint8, c - 'a' + 10) }
	return cast(uint8, c - '0')
}

// attrsAre reports whether a's .ARM.attributes section is the bytes hex spells.
func attrsAre(a @asm.Assembler, hex *[]readonly char) bool {
	var got @[]uint8 = elfArmAttributes(a)
	if len(got) * 2 != len(hex) { return false }
	for i := 0; i < len(got); i++ {
		if got[i] != attrHexByte(hex[2 * i]) * 16 + attrHexByte(hex[2 * i + 1]) { return false }
	}
	return true
}

// With nothing set, an object lists armv7ve's attributes, as clang writes them for arm-none-eabi
// -march=armv7ve -mfloat-abi=soft; an FPU adds its own (neon: arm-linux-gnueabihf's); and an
// attribute set explicitly replaces the default (Tag_CPU_unaligned_access 0:
// -mno-unaligned-access; vfpv3 with Tag_ABI_VFP_args: `.fpu vfpv3`, `.eabi_attribute 28, 1`).
// Each expected section is clang's (Apple clang 21) byte for byte.
func TestArmAttributesDefaults() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	if !attrsAre(a, "411f0000006165616269000115000000060a07410801090222012a012c024403") {
		return fail("the attributes are not armv7ve's")
	}
	a.ArmFPU = buf.CopyStr("neon")
	if !attrsAre(a, "41230000006165616269000119000000060a0741080109020a030c0122012a012c024403") {
		return fail("the attributes are not armv7ve's with NEON")
	}
	var b @asm.Assembler = asm.New(4)
	b.SetArmAttr(asm.ARM_TAG_CPU_UNALIGNED_ACCESS, 0, "")
	if !attrsAre(b, "411f0000006165616269000115000000060a07410801090222002a012c024403") {
		return fail("Tag_CPU_unaligned_access 0 does not replace the default")
	}
	var c @asm.Assembler = asm.New(4)
	c.ArmFPU = buf.CopyStr("vfpv3")
	c.SetArmAttr(asm.ARM_TAG_ABI_VFP_ARGS, 1, "")
	if !attrsAre(c, "41230000006165616269000119000000060a0741080109020a031c0122012a012c024403") {
		return fail("the attributes are not VFPv3's with VFP arguments")
	}
	return ""
}

// Attributes set explicitly go in tag order, Tag_conformance first: a string NUL-terminated,
// Tag_compatibility's number then string, a tag or number of more than 7 bits in several ULEB128
// bytes, and an explicit 0 (Tag_Advanced_SIMD_arch, over NEON's) written, not dropped — clang's
// bytes for `.fpu neon`, `.eabi_attribute 6, 0`, `.eabi_attribute 67, "2.09"`,
// `.eabi_attribute 32, 1, "gnu"`, `.eabi_attribute 129, "x"`, `.eabi_attribute 44, 300`,
// `.eabi_attribute 12, 0`, `.cpu cortex-a15`.
func TestArmAttributesExplicit() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.ArmFPU = buf.CopyStr("neon")
	a.SetArmAttr(6, 0, "")
	a.SetArmAttr(asm.ARM_TAG_CONFORMANCE, 0, "2.09")
	a.SetArmAttr(asm.ARM_TAG_COMPATIBILITY, 1, "gnu")
	a.SetArmAttr(129, 0, "x")
	a.SetArmAttr(44, 300, "")
	a.SetArmAttr(asm.ARM_TAG_ADVANCED_SIMD_ARCH, 0, "")
	a.SetArmAttr(asm.ARM_TAG_CPU_NAME, 0, "cortex-a15")
	if !attrsAre(a,
			"4140000000616561626900013600000043322e30390005636f727465782d613135000600074108010902"
					"0a030c002001676e750022012a012cac02440381017800") {
		return fail("the explicit attributes are not clang's")
	}
	return ""
}
