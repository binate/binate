package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// AArch64 ELF B / BL relocation tests.  One fixup kind (FIX_BRANCH26) covers both B
// and BL; the ELF writer tells them apart from the instruction word, emitting
// R_AARCH64_CALL26 for a BL and R_AARCH64_JUMP26 for a B, with the fixup addend in
// r_addend — what clang (aarch64-linux-gnu) emits for `bl ext+12` / `b ext-8`.  The
// objects are parsed back, so these run anywhere.  (fail() and rdU16 / rdU32 /
// rdU64 are defined in elf_test.bn.)

// c26Read reads the ELF object at path into a fresh 8KB buffer and returns the
// buffer and the byte count read (0 when the file cannot be opened).
func c26Read(path *[]readonly char) (@[]uint8, int) {
	var whole @[]uint8 = make_slice(uint8, 8192)
	f, oerr := os.Open(path)
	if present(oerr) { return whole, 0 }
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = whole
	n, _ := f.Read(raw)
	_ = f.Close()
	return whole, n
}

// c26Rela returns the file offset and byte size of the (single) SHT_RELA section of
// the ELF64 object in b, or (-1, 0) when there is none.
func c26Rela(b @[]uint8) (int, int) {
	var shoff int = rdU64(b, 40)
	var shentsize int = rdU16(b, 58)
	var shnum int = rdU16(b, 60)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if rdU32(b, sh + 4) == cast(int, SHT_RELA) {
			return rdU64(b, sh + 24), rdU64(b, sh + 32)
		}
	}
	return -1, 0
}

// c26EntryIs reports whether Elf64_Rela entry i at relaOff has r_offset off, type
// rtype (the low word of r_info) and r_addend addend.
func c26EntryIs(b @[]uint8, relaOff int, i int, off int, rtype int, addend int) bool {
	var e int = relaOff + i * 24
	return rdU64(b, e) == off && rdU32(b, e + 8) == rtype && rdU64(b, e + 16) == addend
}

// A BL to an undefined external gets R_AARCH64_CALL26 and a B gets R_AARCH64_JUMP26,
// each with the fixup's addend (positive, negative or zero) in r_addend.
func TestWriteElfAArch64Call26VsJump26() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("ext") // declared, never defined
	isa.BranchLabel(a, true, "ext", 0) // bl ext
	isa.BranchLabel(a, false, "ext", 0) // b ext
	isa.BranchLabel(a, true, "ext", 12) // bl ext+12
	isa.BranchLabel(a, false, "ext", -8) // b ext-8
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	if a.NumRelocs != 4 { return fail("each external B / BL must stay a relocation") }

	var path @[]char = buf.Concat(dir, "/elf_aa64_call26.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	relaOff, relaSize := c26Rela(b)
	if relaOff < 0 { return fail("no SHT_RELA section") }
	if relaSize != 4 * 24 { return fail("expected 4 Elf64_Rela entries") }
	if !c26EntryIs(b, relaOff, 0, 0, R_AARCH64_CALL26, 0) { return fail("bl ext -> CALL26") }
	if !c26EntryIs(b, relaOff, 1, 4, R_AARCH64_JUMP26, 0) { return fail("b ext -> JUMP26") }
	if !c26EntryIs(b, relaOff, 2, 8, R_AARCH64_CALL26, 12) {
		return fail("bl ext+12 -> CALL26 with r_addend 12")
	}
	if !c26EntryIs(b, relaOff, 3, 12, R_AARCH64_JUMP26, -8) {
		return fail("b ext-8 -> JUMP26 with r_addend -8")
	}
	return ""
}

// A BL / B to a defined atom-starting symbol in the same object also stays a
// relocation, and is likewise CALL26 for the BL and JUMP26 for the B.
func TestWriteElfAArch64Call26DefinedTarget() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	isa.BranchLabel(a, false, "callee", 4) // b callee+4
	isa.BranchLabel(a, true, "callee", 0) // bl callee
	a.DefineLabel("callee")
	a.SetGlobal("callee")
	aarch64.Ret(a)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	if a.NumRelocs != 2 { return fail("a B / BL to a non-L symbol must stay a relocation") }

	var path @[]char = buf.Concat(dir, "/elf_aa64_call26_def.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	relaOff, relaSize := c26Rela(b)
	if relaOff < 0 || relaSize != 2 * 24 { return fail("expected 2 Elf64_Rela entries") }
	if !c26EntryIs(b, relaOff, 0, 0, R_AARCH64_JUMP26, 4) { return fail("b callee+4 -> JUMP26") }
	if !c26EntryIs(b, relaOff, 1, 4, R_AARCH64_CALL26, 0) { return fail("bl callee -> CALL26") }
	return ""
}

// B.cond / CBZ / TBZ / ADR to an external symbol stay relocations (only an L-label
// target resolves in place) and map to R_AARCH64_CONDBR19 / CONDBR19 / TSTBR14 /
// ADR_PREL_LO21, each carrying its addend, and the words keep a zero immediate.
func TestWriteElfAArch64ShortRangeRelocs() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetGlobal("ext")
	isa.CondBranchLabel(a, aarch64.COND_EQ, "ext", 4) // b.eq ext+4
	isa.CompareBranchLabel(a, false, true, aarch64.X0, "ext", 0) // cbz x0, ext
	isa.TestBranchLabel(a, false, aarch64.X0, 1, "ext", -8) // tbz w0, #1, ext-8
	isa.PCRelLabel(a, false, false, aarch64.X0, "ext", 3) // adr x0, ext+3
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }

	var path @[]char = buf.Concat(dir, "/elf_aa64_short.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	relaOff, relaSize := c26Rela(b)
	if relaOff < 0 || relaSize != 4 * 24 { return fail("expected 4 Elf64_Rela entries") }
	if !c26EntryIs(b, relaOff, 0, 0, R_AARCH64_CONDBR19, 4) { return fail("b.eq ext+4") }
	if !c26EntryIs(b, relaOff, 1, 4, R_AARCH64_CONDBR19, 0) { return fail("cbz x0, ext") }
	if !c26EntryIs(b, relaOff, 2, 8, R_AARCH64_TSTBR14, -8) { return fail("tbz w0, #1, ext-8") }
	if !c26EntryIs(b, relaOff, 3, 12, R_AARCH64_ADR_PREL_LO21, 3) { return fail("adr x0, ext+3") }
	var s @asm.Section = a.Sections[0]
	if rdU32(s.Data, 0) != 0x54000000 || rdU32(s.Data, 4) != 0xB4000000 ||
			rdU32(s.Data, 8) != 0x36080000 || rdU32(s.Data, 12) != 0x10000000 {
		return fail("relocated words must keep a zero immediate")
	}
	return ""
}

// A PC-relative literal load (LDR / LDRSW / PRFM literal) of an external symbol is a
// data reference: it maps to R_AARCH64_LD_PREL_LO19 (never the branch relocation
// CONDBR19, which a linker may send through a PLT stub), carrying its addend.
func TestWriteElfAArch64LiteralLoadReloc() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetGlobal("ext")
	isa.LdStLiteral(a, isa.LS_LDR_X, aarch64.X0, "ext", 0) // ldr x0, ext
	isa.LdStLiteral(a, isa.LS_LDRSW, aarch64.X1, "ext", 8) // ldrsw x1, ext+8
	isa.LdStLiteral(a, isa.LS_PRFM, 0, "ext", -4) // prfm pldl1keep, ext-4
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }

	var path @[]char = buf.Concat(dir, "/elf_aa64_literal.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	relaOff, relaSize := c26Rela(b)
	if relaOff < 0 || relaSize != 3 * 24 { return fail("expected 3 Elf64_Rela entries") }
	if !c26EntryIs(b, relaOff, 0, 0, R_AARCH64_LD_PREL_LO19, 0) { return fail("ldr x0, ext") }
	if !c26EntryIs(b, relaOff, 1, 4, R_AARCH64_LD_PREL_LO19, 8) { return fail("ldrsw x1, ext+8") }
	if !c26EntryIs(b, relaOff, 2, 8, R_AARCH64_LD_PREL_LO19, -4) { return fail("prfm ext-4") }
	return ""
}

// isBlWord classifies a little-endian word by bits 31:26 (100101 = BL), whatever the
// imm26, and reports false for an offset without four bytes behind it.
func TestIsBlWord() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 16)
	// bl .-4 (0x97FFFFFF), b .-4 (0x17FFFFFF), bl . (0x94000000), b . (0x14000000)
	d[0] = 0xFF
	d[1] = 0xFF
	d[2] = 0xFF
	d[3] = 0x97
	d[4] = 0xFF
	d[5] = 0xFF
	d[6] = 0xFF
	d[7] = 0x17
	d[11] = 0x94
	d[15] = 0x14
	if !isBlWord(d, 0) { return fail("bl .-4 is a BL") }
	if isBlWord(d, 4) { return fail("b .-4 is not a BL") }
	if !isBlWord(d, 8) { return fail("bl . is a BL") }
	if isBlWord(d, 12) { return fail("b . is not a BL") }
	if isBlWord(d, 13) { return fail("an offset past the data is not a BL") }
	if isBlWord(d, -1) { return fail("a negative offset is not a BL") }
	return ""
}
