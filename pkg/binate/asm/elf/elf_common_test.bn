package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Common symbols in an ELF object, as clang writes them: a common is STT_OBJECT in section
// SHN_COMMON, its value its alignment and its size its size, with its binding and visibility;
// a local common is a local STT_OBJECT in .bss with its size.  (c26Read is in
// elf_call26_test.bn, tmpSymtab / tmpNameIs in elf_symtab_test.bn, rdU16 / rdU32 / rdU64 in
// elf_test.bn.)

// commonProgram returns an assembler holding commons ca (4 bytes, 4-aligned), cb (100 bytes,
// 1-aligned), a weak cw and a hidden ch, and local commons la (4 bytes) and lb (12 bytes,
// 8-aligned).
func commonProgram(wordSize int, insn uint32) @asm.Assembler {
	var a @asm.Assembler = asm.New(wordSize)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.EmitUint32(insn)
	a.DefineCommon("ca", 4, 4)
	a.DefineCommon("cb", 100, 1)
	a.SetWeak("cw")
	a.DefineCommon("cw", 4, 4)
	a.DefineCommon("ch", 4, 4)
	a.SetVisibility("ch", asm.VIS_HIDDEN)
	a.DefineLocalCommon("la", 4, 1)
	a.DefineLocalCommon("lb", 12, 8)
	return a
}

// elfCommonEntry holds one symbol-table entry's fields.
type elfCommonEntry struct {
	Info  int
	Other int
	Shndx int
	Value int
	Size  int
	Found bool
}

// commonEntry returns the entry named name in the ELF object b (ELF64 or, is64 unset, ELF32).
func commonEntry(b @[]uint8, name *[]readonly char, is64 bool) elfCommonEntry {
	var r elfCommonEntry
	var symOff int = -1
	var nsyms int = 0
	var strOff int = 0
	var entSize int = 16
	if is64 {
		symOff, nsyms, _, strOff = tmpSymtab(b)
		entSize = 24
	} else {
		var shoff int = rdU32(b, 32)
		var shentsize int = rdU16(b, 46)
		for i := 0; i < rdU16(b, 48); i++ {
			var sh int = shoff + i * shentsize
			if rdU32(b, sh + 4) != cast(int, SHT_SYMTAB) { continue }
			symOff = rdU32(b, sh + 16)
			nsyms = rdU32(b, sh + 20) / 16
			strOff = rdU32(b, shoff + rdU32(b, sh + 24) * shentsize + 16)
		}
	}
	if symOff < 0 { return r }
	for i := 1; i < nsyms; i++ {
		var e int = symOff + i * entSize
		if !tmpNameIs(b, strOff + rdU32(b, e), name) { continue }
		r.Found = true
		if is64 {
			r.Info = cast(int, b[e + 4])
			r.Other = cast(int, b[e + 5])
			r.Shndx = rdU16(b, e + 6)
			r.Value = rdU64(b, e + 8)
			r.Size = rdU64(b, e + 16)
		} else {
			r.Value = rdU32(b, e + 4)
			r.Size = rdU32(b, e + 8)
			r.Info = cast(int, b[e + 12])
			r.Other = cast(int, b[e + 13])
			r.Shndx = rdU16(b, e + 14)
		}
	}
	return r
}

// commonChecks checks commonProgram's symbols in the ELF object b.
func commonChecks(b @[]uint8, is64 bool) @[]char {
	var ca elfCommonEntry = commonEntry(b, "ca", is64)
	if !ca.Found || ca.Info != (STB_GLOBAL << 4 | STT_OBJECT) || ca.Shndx != SHN_COMMON ||
			ca.Value != 4 || ca.Size != 4 {
		return buf.CopyStr("ca not a global common of 4 bytes aligned to 4")
	}
	var cb elfCommonEntry = commonEntry(b, "cb", is64)
	if !cb.Found || cb.Shndx != SHN_COMMON || cb.Value != 1 || cb.Size != 100 {
		return buf.CopyStr("cb not a common of 100 bytes aligned to 1")
	}
	var cw elfCommonEntry = commonEntry(b, "cw", is64)
	if !cw.Found || cw.Info != (STB_WEAK << 4 | STT_OBJECT) || cw.Shndx != SHN_COMMON {
		return buf.CopyStr("cw not a weak common")
	}
	var ch elfCommonEntry = commonEntry(b, "ch", is64)
	if !ch.Found || ch.Other != asm.VIS_HIDDEN || ch.Shndx != SHN_COMMON {
		return buf.CopyStr("ch not a hidden common")
	}
	var la elfCommonEntry = commonEntry(b, "la", is64)
	var lb elfCommonEntry = commonEntry(b, "lb", is64)
	if !la.Found || la.Info != (STB_LOCAL << 4 | STT_OBJECT) || la.Shndx == SHN_COMMON ||
			la.Shndx == SHN_UNDEF || la.Value != 0 || la.Size != 4 {
		return buf.CopyStr("la not a local object of 4 bytes at .bss+0")
	}
	if !lb.Found || lb.Shndx != la.Shndx || lb.Value != 8 || lb.Size != 12 {
		return buf.CopyStr("lb not a local object of 12 bytes at .bss+8")
	}
	return ""
}

// An ELF64 (AArch64) object's commons and local commons are clang's.
func TestWriteElfCommons() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = commonProgram(8, 0xD503201F)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/comm.o")
	if !WriteAArch64(a, path) { return fail("failed to write ELF") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	var err @[]char = commonChecks(b, true)
	if len(err) != 0 { return fail(err) }
	return ""
}

// An ELF32 (arm32) object's commons and local commons are clang's.
func TestWriteElf32Commons() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = commonProgram(4, 0xE320F000)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/comm32.o")
	if !WriteARM32(a, path) { return fail("failed to write ELF32") }
	b, n := c26Read(path)
	if n < 100 { return fail("cannot read back the ELF32 object") }
	var err @[]char = commonChecks(b, false)
	if len(err) != 0 { return fail(err) }
	return ""
}
