package "pkg/binate/asm/elf"

// ELF format constants shared by the writer (elf.bn) and the mapping
// helpers (elf_util.bn): file/class/data identification, section header
// types and flags, symbol binding/type tags, and the per-architecture
// relocation type numbers.

// ELFMAG0..ELFMAG3 are the four magic bytes at the start of every ELF
// file: 0x7F 'E' 'L' 'F'.
const ELFMAG0 uint8 = 0x7f

// ELFMAG1 is the second byte of the ELF magic ('E').
const ELFMAG1 uint8 = 0x45

// ELFMAG2 is the third byte of the ELF magic ('L').
const ELFMAG2 uint8 = 0x4c

// ELFMAG3 is the fourth byte of the ELF magic ('F').
const ELFMAG3 uint8 = 0x46

// ELFCLASS32 marks an ELF file as 32-bit (Elf32_* structures).
const ELFCLASS32 uint8 = 1

// ELFCLASS64 marks an ELF file as 64-bit (Elf64_* structures).
const ELFCLASS64 uint8 = 2

// ELFDATA2LSB indicates little-endian byte order in the data fields.
const ELFDATA2LSB uint8 = 1

// EV_CURRENT is the current ELF format version (always 1).
const EV_CURRENT uint8 = 1

// ELFOSABI_NONE is the System V / generic ABI marker; we use this for
// all ELF objects we emit.
const ELFOSABI_NONE uint8 = 0

// ET_REL marks an ELF file as a relocatable object (.o), the only
// filetype this package emits.
const ET_REL uint16 = 1

// SHT_NULL is the inactive (sentinel) section header type. The first
// section header in every ELF object must be SHT_NULL.
const SHT_NULL uint32 = 0

// SHT_PROGBITS marks a section that contains program-defined data
// (text, rodata, data).
const SHT_PROGBITS uint32 = 1

// SHT_SYMTAB marks a symbol table section.
const SHT_SYMTAB uint32 = 2

// SHT_STRTAB marks a string table section.
const SHT_STRTAB uint32 = 3

// SHT_REL marks a relocation table section without explicit addends
// (the addend is read from the patched location).
const SHT_REL uint32 = 9

// SHT_RELA marks a relocation table section with explicit addends.
const SHT_RELA uint32 = 4

// SHT_NOBITS marks a zero-fill section that occupies no bytes in the
// file (e.g. .bss).
const SHT_NOBITS uint32 = 8

// SHF_WRITE marks a section that should be writable at runtime.
const SHF_WRITE uint64 = 1

// SHF_ALLOC marks a section that occupies memory at runtime
// (allocatable).
const SHF_ALLOC uint64 = 2

// SHF_EXECINSTR marks a section that contains executable instructions.
const SHF_EXECINSTR uint64 = 4

// STB_LOCAL marks a symbol as local (visible only within the object).
const STB_LOCAL int = 0

// STB_GLOBAL marks a symbol as global (visible to the linker across
// objects).
const STB_GLOBAL int = 1

// STB_WEAK marks a symbol as weak (overridable by a strong definition).
const STB_WEAK int = 2

// STT_NOTYPE is the unspecified symbol-type tag.
const STT_NOTYPE int = 0

// STT_FUNC marks a symbol as a function (code address).
const STT_FUNC int = 2

// STT_SECTION marks a symbol as a section symbol (its value is the
// section's address).
const STT_SECTION int = 3

// SHN_UNDEF is the section index meaning "no section" — used by
// undefined external references.
const SHN_UNDEF int = 0

// R_AARCH64_ABS64 is a 64-bit absolute address relocation.
const R_AARCH64_ABS64 int = 257

// R_AARCH64_ABS32 is a 32-bit absolute address relocation.
const R_AARCH64_ABS32 int = 258

// R_AARCH64_CALL26 patches the imm26 of a BL instruction with the
// target's PC-relative offset (in instruction units).
const R_AARCH64_CALL26 int = 283

// R_AARCH64_JUMP26 patches the imm26 of an unconditional B instruction
// with the target's PC-relative offset (in instruction units).
const R_AARCH64_JUMP26 int = 282

// R_AARCH64_ADR_PREL_LO21 patches the imm21 of an ADR instruction with
// the target's signed PC-relative byte offset.
const R_AARCH64_ADR_PREL_LO21 int = 274

// R_AARCH64_ADR_PREL_PG_HI21 patches the imm21 of an ADRP instruction
// with the page-aligned PC-relative offset (high 21 bits).
const R_AARCH64_ADR_PREL_PG_HI21 int = 275

// R_AARCH64_CONDBR19 patches the imm19 of a B.cond / CBZ / CBNZ
// instruction with the target's PC-relative offset (in instructions).
const R_AARCH64_CONDBR19 int = 280

// R_AARCH64_TSTBR14 patches the imm14 of a TBZ / TBNZ instruction.
const R_AARCH64_TSTBR14 int = 279

// R_ARM_ABS32 is a 32-bit absolute address relocation for ARM32.
const R_ARM_ABS32 int = 2

// R_ARM_CALL patches the imm24 of a BL/BLX instruction.
const R_ARM_CALL int = 28

// R_ARM_JUMP24 patches the imm24 of an unconditional B/BL.
const R_ARM_JUMP24 int = 29

// R_ARM_MOVW_ABS_NC patches the imm4:imm12 of a MOVW with the low 16 bits
// of the symbol's absolute address ("_NC" = no overflow check). Paired
// with R_ARM_MOVT_ABS on a following MOVT to materialize a 32-bit address.
const R_ARM_MOVW_ABS_NC int = 43

// R_ARM_MOVT_ABS patches the imm4:imm12 of a MOVT with the high 16 bits
// of the symbol's absolute address.
const R_ARM_MOVT_ABS int = 44

// R_X86_64_64 is a 64-bit absolute address relocation.
const R_X86_64_64 int = 1

// R_X86_64_PC32 is a 32-bit PC-relative relocation (used by RIP-relative
// references and by CALL/JMP rel32 against a DEFINED symbol).
const R_X86_64_PC32 int = 2

// R_X86_64_PLT32 is a 32-bit PC-relative relocation via the procedure
// linkage table.  A CALL rel32 against an UNDEFINED (extern) symbol must use
// this rather than PC32: a PIE link rejects PC32 against an undefined symbol
// ("relocation R_X86_64_PC32 against symbol X can not be used when making a
// PIE object"), because the load-time-resolved distance isn't a link-time
// constant.  PLT32 routes the call through the PLT, which the linker also
// relaxes to a direct call for a non-PIE link, so it is safe in both.  Its
// field is end-of-instruction-relative, identical to PC32 (see elfRelocAddend).
const R_X86_64_PLT32 int = 4

// R_X86_64_32 is a 32-bit zero-extended absolute address relocation.
const R_X86_64_32 int = 10
