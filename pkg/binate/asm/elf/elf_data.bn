package "pkg/binate/asm/elf"

import "pkg/binate/asm"

// elfDataRelocType returns the ELF relocation type of a data fixup kind (asm.FIX_DATA_*) on
// machine, or -1 for a size the machine has none for (1-byte data on AArch64; arm32's 8-byte
// data and its PC-relative data but for 4 bytes), which Write reports.
func elfDataRelocType(fixKind int, machine int) int {
	var abs32 bool = fixKind == asm.FIX_DATA_ABS32 || fixKind == asm.FIX_DATA_ABS32S
	if machine == EM_AARCH64 {
		if fixKind == asm.FIX_DATA_PCREL16 { return R_AARCH64_PREL16 }
		if fixKind == asm.FIX_DATA_PCREL32 { return R_AARCH64_PREL32 }
		if fixKind == asm.FIX_DATA_PCREL64 { return R_AARCH64_PREL64 }
		if fixKind == asm.FIX_DATA_ABS16 { return R_AARCH64_ABS16 }
		if abs32 { return R_AARCH64_ABS32 }
		if fixKind == asm.FIX_DATA_ABS64 { return R_AARCH64_ABS64 }
	}
	if machine == EM_ARM {
		if fixKind == asm.FIX_DATA_PCREL32 { return R_ARM_REL32 }
		if fixKind == asm.FIX_DATA_ABS8 { return R_ARM_ABS8 }
		if fixKind == asm.FIX_DATA_ABS16 { return R_ARM_ABS16 }
		if abs32 { return R_ARM_ABS32 }
	}
	if machine == EM_X86_64 {
		if fixKind == asm.FIX_DATA_PCREL8 { return R_X86_64_PC8 }
		if fixKind == asm.FIX_DATA_PCREL16 { return R_X86_64_PC16 }
		if fixKind == asm.FIX_DATA_PCREL32 { return R_X86_64_PC32 }
		if fixKind == asm.FIX_DATA_PCREL64 { return R_X86_64_PC64 }
		if fixKind == asm.FIX_DATA_ABS8 { return R_X86_64_8 }
		if fixKind == asm.FIX_DATA_ABS16 { return R_X86_64_16 }
		if fixKind == asm.FIX_DATA_ABS32 { return R_X86_64_32 }
		if fixKind == asm.FIX_DATA_ABS32S { return R_X86_64_32S }
		if fixKind == asm.FIX_DATA_ABS64 { return R_X86_64_64 }
	}
	return -1
}

// elfRelAddend returns the r_addend to store for rel (of ELF type rtype): a data relocation's
// own addend — its PC-relative field is measured from itself, so x86-64's PC32 takes no -4
// there — else elfRelocAddend's.
func elfRelAddend(rel asm.Relocation, rtype int, machine int) int {
	if asm.DataFixupSize(rel.Kind) > 0 { return rel.Addend }
	return elfRelocAddend(rtype, machine, rel.Addend)
}
