package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Data fixup kinds map to the relocations clang emits for `.byte` / `.short` / `.long` /
// `.quad sym` (`clang -c`, objdump -r): AArch64 ABS16 / ABS32 / ABS64 (no 1-byte one),
// arm32 ABS8 / ABS16 / ABS32 (no 8-byte one), x86-64 8 / 16 / 32 / 64 — and 32S for a
// signed 4-byte datum (`.int32`).
func TestElfDataRelocTypes() testing.TestResult {
	if elfRelocType(asm.FIX_DATA_ABS8, EM_AARCH64, true) != -1 { return fail("aarch64 1-byte mapped") }
	if elfRelocType(asm.FIX_DATA_ABS16, EM_AARCH64, true) != R_AARCH64_ABS16 {
		return fail("aarch64 2-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32, EM_AARCH64, true) != R_AARCH64_ABS32 {
		return fail("aarch64 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32S, EM_AARCH64, true) != R_AARCH64_ABS32 {
		return fail("aarch64 signed 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS64, EM_AARCH64, true) != R_AARCH64_ABS64 {
		return fail("aarch64 8-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS8, EM_ARM, true) != R_ARM_ABS8 { return fail("arm32 1-byte") }
	if elfRelocType(asm.FIX_DATA_ABS16, EM_ARM, true) != R_ARM_ABS16 { return fail("arm32 2-byte") }
	if elfRelocType(asm.FIX_DATA_ABS32, EM_ARM, true) != R_ARM_ABS32 { return fail("arm32 4-byte") }
	if elfRelocType(asm.FIX_DATA_ABS32S, EM_ARM, true) != R_ARM_ABS32 {
		return fail("arm32 signed 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS64, EM_ARM, true) != -1 { return fail("arm32 8-byte mapped") }
	if elfRelocType(asm.FIX_DATA_ABS8, EM_X86_64, true) != R_X86_64_8 { return fail("x86-64 1-byte") }
	if elfRelocType(asm.FIX_DATA_ABS16, EM_X86_64, true) != R_X86_64_16 {
		return fail("x86-64 2-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32, EM_X86_64, true) != R_X86_64_32 {
		return fail("x86-64 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32S, EM_X86_64, true) != R_X86_64_32S {
		return fail("x86-64 signed 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS64, EM_X86_64, true) != R_X86_64_64 {
		return fail("x86-64 8-byte")
	}
	return ""
}

// An absolute data relocation's addend is stored as is (no x86-64 PC32 correction).
func TestElfDataRelocAddend() testing.TestResult {
	if elfRelocAddend(R_X86_64_32, EM_X86_64, 5) != 5 { return fail("x86-64 32 addend changed") }
	if elfRelocAddend(R_X86_64_8, EM_X86_64, -3) != -3 { return fail("x86-64 8 addend changed") }
	if elfRelocAddend(R_AARCH64_ABS16, EM_AARCH64, 7) != 7 {
		return fail("aarch64 ABS16 addend changed")
	}
	return ""
}

// PC-relative data kinds map to clang's relocations for `.short` / `.long` / `.quad sym - .`
// (and x86-64's `.byte`): AArch64 PREL16 / 32 / 64, arm32 REL32, x86-64 PC8 / 16 / 32 / 64;
// AArch64 has no 1-byte one, arm32 none but 4 bytes.
func TestElfDataPcrelTypes() testing.TestResult {
	if elfRelocType(asm.FIX_DATA_PCREL16, EM_AARCH64, true) != R_AARCH64_PREL16 {
		return fail("aarch64 PREL16")
	}
	if elfRelocType(asm.FIX_DATA_PCREL32, EM_AARCH64, true) != R_AARCH64_PREL32 {
		return fail("aarch64 PREL32")
	}
	if elfRelocType(asm.FIX_DATA_PCREL64, EM_AARCH64, true) != R_AARCH64_PREL64 {
		return fail("aarch64 PREL64")
	}
	if elfRelocType(asm.FIX_DATA_PCREL8, EM_AARCH64, true) != -1 {
		return fail("aarch64 1-byte mapped")
	}
	if elfRelocType(asm.FIX_DATA_PCREL32, EM_ARM, true) != R_ARM_REL32 { return fail("arm32 REL32") }
	if elfRelocType(asm.FIX_DATA_PCREL16, EM_ARM, true) != -1 { return fail("arm32 2-byte mapped") }
	if elfRelocType(asm.FIX_DATA_PCREL8, EM_X86_64, true) != R_X86_64_PC8 { return fail("x86-64 PC8") }
	if elfRelocType(asm.FIX_DATA_PCREL16, EM_X86_64, true) != R_X86_64_PC16 {
		return fail("x86-64 PC16")
	}
	if elfRelocType(asm.FIX_DATA_PCREL32, EM_X86_64, true) != R_X86_64_PC32 {
		return fail("x86-64 PC32")
	}
	if elfRelocType(asm.FIX_DATA_PCREL64, EM_X86_64, true) != R_X86_64_PC64 {
		return fail("x86-64 PC64")
	}
	return ""
}

// A data relocation's r_addend is its own — x86-64's data PC32 measures from the field, so it
// takes no -4, where an instruction's PC32 (measured from the instruction's end) does.
func TestElfRelAddendData() testing.TestResult {
	var r asm.Relocation
	r.Kind = asm.FIX_DATA_PCREL32
	r.Addend = 6
	if elfRelAddend(r, R_X86_64_PC32, EM_X86_64) != 6 { return fail("a data PC32 addend corrected") }
	r.Kind = 302 // x64 FIX_REL32_LEA, an instruction's disp32
	if elfRelAddend(r, R_X86_64_PC32, EM_X86_64) != 2 {
		return fail("an instruction PC32 addend not corrected")
	}
	return ""
}

// No ELF relocation subtracts a symbol: a difference relocation (a Mach-O pair's shape) is
// an error naming the subtracted symbol, not a plain relocation.
func TestElfRejectsDifference() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("d")
	a.SetGlobal("ext")
	a.AddDiffFixup("ext", "d", asm.FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	if !a.Finalize() { return fail(a.ErrorMsg) }
	if WriteAArch64(a, buf.Concat(dir, "/diff.o")) { return fail("written") }
	if !elfHas(a.ErrorMsg, "no relocation for a difference subtracting 'd'") {
		return fail(buf.Concat("wrong error: ", a.ErrorMsg))
	}
	return ""
}

// elfHas reports whether sub occurs within msg.
func elfHas(msg *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(msg); i++ {
		var match bool = true
		for j := 0; j < len(sub); j++ {
			if msg[i + j] != sub[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}
