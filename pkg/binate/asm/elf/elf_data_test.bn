package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Data fixup kinds map to the relocations clang emits for `.byte` / `.short` / `.long` /
// `.quad sym` (`clang -c`, objdump -r): AArch64 ABS16 / ABS32 / ABS64 (no 1-byte one),
// arm32 ABS8 / ABS16 / ABS32 (no 8-byte one), x86-64 8 / 16 / 32 / 64 — and 32S for a
// signed 4-byte datum (`.int32`).
func TestElfDataRelocTypes() testing.TestResult {
	if elfRelocType(asm.FIX_DATA_ABS8, EM_AARCH64, true) != -1 { return fail("aarch64 1-byte mapped") }
	if elfRelocType(asm.FIX_DATA_ABS16, EM_AARCH64, true) != R_AARCH64_ABS16 {
		return fail("aarch64 2-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32, EM_AARCH64, true) != R_AARCH64_ABS32 {
		return fail("aarch64 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32S, EM_AARCH64, true) != R_AARCH64_ABS32 {
		return fail("aarch64 signed 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS64, EM_AARCH64, true) != R_AARCH64_ABS64 {
		return fail("aarch64 8-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS8, EM_ARM, true) != R_ARM_ABS8 { return fail("arm32 1-byte") }
	if elfRelocType(asm.FIX_DATA_ABS16, EM_ARM, true) != R_ARM_ABS16 { return fail("arm32 2-byte") }
	if elfRelocType(asm.FIX_DATA_ABS32, EM_ARM, true) != R_ARM_ABS32 { return fail("arm32 4-byte") }
	if elfRelocType(asm.FIX_DATA_ABS32S, EM_ARM, true) != R_ARM_ABS32 {
		return fail("arm32 signed 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS64, EM_ARM, true) != -1 { return fail("arm32 8-byte mapped") }
	if elfRelocType(asm.FIX_DATA_ABS8, EM_X86_64, true) != R_X86_64_8 { return fail("x86-64 1-byte") }
	if elfRelocType(asm.FIX_DATA_ABS16, EM_X86_64, true) != R_X86_64_16 {
		return fail("x86-64 2-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32, EM_X86_64, true) != R_X86_64_32 {
		return fail("x86-64 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS32S, EM_X86_64, true) != R_X86_64_32S {
		return fail("x86-64 signed 4-byte")
	}
	if elfRelocType(asm.FIX_DATA_ABS64, EM_X86_64, true) != R_X86_64_64 {
		return fail("x86-64 8-byte")
	}
	return ""
}

// An absolute data relocation's addend is stored as is (no x86-64 PC32 correction).
func TestElfDataRelocAddend() testing.TestResult {
	if elfRelocAddend(R_X86_64_32, EM_X86_64, 5) != 5 { return fail("x86-64 32 addend changed") }
	if elfRelocAddend(R_X86_64_8, EM_X86_64, -3) != -3 { return fail("x86-64 8 addend changed") }
	if elfRelocAddend(R_AARCH64_ABS16, EM_AARCH64, 7) != 7 {
		return fail("aarch64 ABS16 addend changed")
	}
	return ""
}
