package "pkg/binate/asm/elf"

import "pkg/binate/asm"

// The section header table, numbered as clang's ELF writer numbers it: the null header,
// .strtab, then each section the assembler made followed by its relocation section when it
// has relocations, then .note.GNU-stack, .ARM.attributes when written, and .symtab last.  One
// string table (.strtab) names the sections and the symbols alike (asm.StringTable, with no
// padding).

// elfHeaders records the header index of each section of an object's table.
type elfHeaders struct {
	Sect     @[]int // Sect[i]: assembler section i's header index
	Rel      @[]int // Rel[i]: its relocation section's header index, or -1 when it has none
	NumRel   @[]int // NumRel[i]: its relocations
	GnuStack int
	ArmAttrs int // -1 when not written
	Symtab   int
	Total    int // the number of headers
}

// elfHeaderIndices numbers a's section headers; hasAttrs is whether .ARM.attributes is
// written.
func elfHeaderIndices(a @asm.Assembler, hasAttrs bool) elfHeaders {
	var h elfHeaders
	var n int = a.NumSections
	h.Sect = make_slice(int, n)
	h.Rel = make_slice(int, n)
	h.NumRel = make_slice(int, n)
	var next int = 2 // after the null header and .strtab
	for i := 0; i < n; i++ {
		h.Sect[i] = next
		next = next + 1
		h.NumRel[i] = countRelocsForSection(a, i)
		h.Rel[i] = -1
		if h.NumRel[i] > 0 {
			h.Rel[i] = next
			next = next + 1
		}
	}
	h.GnuStack = next
	next = next + 1
	h.ArmAttrs = -1
	if hasAttrs {
		h.ArmAttrs = next
		next = next + 1
	}
	h.Symtab = next
	h.Total = next + 1
	return h
}

// elfStringTable lays out the string table of a's object: the names of the section headers
// h numbers and of the symbols st lists, whose offsets it sets in st.StrOffs (a section
// symbol has no name).  It returns the table and each header's name offset (0 for the null
// header).
func elfStringTable(a @asm.Assembler, h elfHeaders, st elfSymtab, useRel bool) (@[]uint8, @[]int) {
	var hdrNames @[]@[]char = make_slice(@[]char, h.Total)
	hdrNames[1] = ".strtab"
	for i := 0; i < a.NumSections; i++ {
		hdrNames[h.Sect[i]] = elfSectName(a.Sections[i].Name)
		if h.Rel[i] >= 0 { hdrNames[h.Rel[i]] = relaSectName(a.Sections[i].Name, useRel) }
	}
	hdrNames[h.GnuStack] = ".note.GNU-stack"
	if h.ArmAttrs >= 0 { hdrNames[h.ArmAttrs] = ".ARM.attributes" }
	hdrNames[h.Symtab] = ".symtab"
	var named int = 0
	for i := 0; i < st.N; i++ {
		if len(st.Names[i]) > 0 { named = named + 1 }
	}
	// The headers' names (the null header's left out), then the named symbols'.
	var all @[]@[]char = make_slice(@[]char, h.Total - 1 + named)
	for i := 1; i < h.Total; i++ { all[i - 1] = hdrNames[i] }
	var symAt @[]int = make_slice(int, st.N) // each symbol's name's index in all, or -1
	var k int = h.Total - 1
	for i := 0; i < st.N; i++ {
		symAt[i] = -1
		if len(st.Names[i]) > 0 {
			all[k] = st.Names[i]
			symAt[i] = k
			k = k + 1
		}
	}
	tab, offs := asm.StringTable(all, 0)
	var hdrOffs @[]int = make_slice(int, h.Total)
	for i := 1; i < h.Total; i++ { hdrOffs[i] = offs[i - 1] }
	for i := 0; i < st.N; i++ {
		if symAt[i] >= 0 { st.StrOffs[i] = offs[symAt[i]] }
	}
	return tab, hdrOffs
}
