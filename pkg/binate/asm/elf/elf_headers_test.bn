package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The section header table as clang numbers it (elf_headers.bn), on arm32, whose relocation
// sections are SHT_REL and which can carry .ARM.attributes.  (c26Read is in elf_call26_test.bn;
// rdU16 / rdU32 and strEqAt in elf_test.bn.)

// An arm32 object with a relocated data word and hard-float attributes has, in order, the
// null header, .strtab (which names the sections: e_shstrndx 1), .text, .data and its .rel.data
// (SHT_REL with SHF_INFO_LINK, 8-byte entries, linked to the symbol table, sh_info data's
// header), .note.GNU-stack, .ARM.attributes and .symtab (its names in .strtab).
func TestElfHeaderOrderArm32() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.EmitUint32(0xE1A00000) // nop (mov r0, r0)
	a.SetSection("data", -1)
	a.SetGlobal("g")
	a.AddFixup("g", 0, 0, 4)
	a.EmitUint32(0)
	if !a.Finalize() { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/elf_headers_arm32.o")
	if !WriteARM32(a, path) { return fail(a.ErrorMsg) }
	whole, n := c26Read(path)
	if n < 300 { return fail("cannot read back the ELF object") }
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the reads
	var b *[]uint8 = whole
	var shoff int = rdU32(b, 0x20)
	if rdU16(b, 0x30) != 8 || rdU16(b, 0x32) != 1 { return fail("not 8 headers, .strtab first") }
	var strtab int = rdU32(b, shoff + 40 + 16)
	var want @[]@[]char = @[]@[]char{"", ".strtab", ".text", ".data", ".rel.data", ".note.GNU-stack",
			".ARM.attributes", ".symtab"}
	for i := 1; i < 8; i++ {
		var at int = strtab + rdU32(b, shoff + 40 * i)
		if !strEqAt(b, at, want[i]) || b[at + len(want[i])] != 0 {
			return fail(buf.Concat("header out of order: ", want[i]))
		}
	}
	var rel int = shoff + 40 * 4
	if cast(uint32, rdU32(b, rel + 4)) != SHT_REL ||
			cast(uint64, rdU32(b, rel + 8)) != SHF_INFO_LINK || rdU32(b, rel + 24) != 7 ||
			rdU32(b, rel + 28) != 3 || rdU32(b, rel + 32) != 4 || rdU32(b, rel + 36) != 8 {
		return fail(".rel.data is not REL, info-linked to data, of the symbol table's 8-byte entries")
	}
	if rdU32(b, shoff + 40 * 7 + 24) != 1 { return fail(".symtab's names are not in .strtab") }
	return ""
}
