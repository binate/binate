package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// ELF layout: each section's sh_addralign (clang's minimum, raised by a `.balign` / `.p2align`)
// and a file offset that is a multiple of it; each section's type and flags; and a zero-fill
// section's place in the file.  (c26Read is in elf_call26_test.bn; rdU16 / rdU32 /
// rdU64 and strEqAt in elf_test.bn.)

// Each section header's sh_offset is a multiple of its sh_addralign, including a data
// section aligned to 64 behind a short text section.
func TestWriteElfSectionOffsetsAligned() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.SetGlobal("f")
	aarch64.Ret(a)
	a.SetSection("data", -1)
	a.EmitUint8(1)
	a.Align(64)
	a.EmitUint64(5)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/elf_layout.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	var shoff int = rdU64(b, 40)
	var shentsize int = rdU16(b, 58)
	var shnum int = rdU16(b, 60)
	var saw64 bool = false
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var off int = rdU64(b, sh + 24)
		var align int = rdU64(b, sh + 48)
		if align > 1 && off % align != 0 {
			return fail("a section's offset is not a multiple of its alignment")
		}
		if align == 64 { saw64 = true }
	}
	if !saw64 { return fail("the data section's sh_addralign is not 64") }
	return ""
}

// elfShdrNamed returns the byte offset of the section header named name in the ELF64 object
// b, or -1 when there is none.
func elfShdrNamed(b @[]uint8, name *[]readonly char) int {
	var shoff int = rdU64(b, 40)
	var shentsize int = rdU16(b, 58)
	var shnum int = rdU16(b, 60)
	var strOff int = rdU64(b, shoff + rdU16(b, 62) * shentsize + 24)
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if strEqAt(b, strOff + rdU32(b, sh), name) { return sh }
	}
	return -1
}

// shdrIs reports whether the section named name in the ELF64 object b has type stype and
// flags shflags.
func shdrIs(b @[]uint8, name *[]readonly char, stype uint32, shflags uint64) bool {
	var sh int = elfShdrNamed(b, name)
	return sh >= 0 && rdU32(b, sh + 4) == cast(int, stype) && rdU64(b, sh + 8) == cast(int, shflags)
}

// A section's type and flags are clang's for `.section .<name>,"<flags>"` (checked with
// llvm-readelf): the flags it was made with, whatever its name, and the type its name implies.
// A zero-fill section takes no bytes in the file, so the sections after it start where it does.
func TestWriteElfSectionTypesAndFlags() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	aarch64.Ret(a)
	a.SetSection("fast", asm.SF_READ | asm.SF_EXEC)
	aarch64.Ret(a)
	a.SetSection("init_array.5", asm.SF_READ | asm.SF_WRITE)
	a.EmitUint64(0)
	a.SetSection("note.x", asm.SF_READ)
	a.EmitUint32(1)
	a.SetSection("meta", 0)
	a.EmitUint32(7)
	a.SetSection("bss.z", asm.SF_READ | asm.SF_WRITE)
	a.Zero(16)
	a.SetSection("bss", -1)
	a.Zero(8)
	a.SetSection("data", -1)
	a.EmitUint64(5)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/elf_sect_types.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	if !shdrIs(b, ".text", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR) ||
			!shdrIs(b, ".fast", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR) {
		return fail("an executable section is not PROGBITS AX")
	}
	if !shdrIs(b, ".init_array.5", SHT_INIT_ARRAY, SHF_ALLOC | SHF_WRITE) {
		return fail(".init_array.5 is not INIT_ARRAY WA")
	}
	if !shdrIs(b, ".note.x", SHT_NOTE, SHF_ALLOC) { return fail(".note.x is not NOTE A") }
	if !shdrIs(b, ".meta", SHT_PROGBITS, 0) { return fail(".meta is not unallocated PROGBITS") }
	if !shdrIs(b, ".bss.z", SHT_NOBITS, SHF_ALLOC | SHF_WRITE) {
		return fail(".bss.z is not NOBITS WA")
	}
	if !shdrIs(b, ".data", SHT_PROGBITS, SHF_ALLOC | SHF_WRITE) {
		return fail(".data is not PROGBITS WA")
	}
	if !shdrIs(b, ".bss", SHT_NOBITS, SHF_ALLOC | SHF_WRITE) { return fail(".bss is not NOBITS WA") }
	var bss int = elfShdrNamed(b, ".bss.z")
	var bss2 int = elfShdrNamed(b, ".bss")
	if rdU64(b, bss + 32) != 16 || rdU64(b, bss2 + 32) != 8 {
		return fail("a zero-fill section's size is not its length")
	}
	var dataOff int = rdU64(b, elfShdrNamed(b, ".data") + 24)
	if dataOff != rdU64(b, bss + 24) || dataOff != rdU64(b, bss2 + 24) {
		return fail("a zero-fill section takes bytes in the file")
	}
	return ""
}

// shdrPlace returns the sh_offset and sh_addralign of the section named name in the ELF32
// or ELF64 object b, or (-1, -1) when there is none.
func shdrPlace(b @[]uint8, name *[]readonly char) (int, int) {
	var shoff int = 0
	var shentsize int = 0
	var shnum int = 0
	var strOff int = 0
	if b[4] == 2 {
		shoff = rdU64(b, 40)
		shentsize = rdU16(b, 58)
		shnum = rdU16(b, 60)
		strOff = rdU64(b, shoff + rdU16(b, 62) * shentsize + 24)
	} else {
		shoff = rdU32(b, 32)
		shentsize = rdU16(b, 46)
		shnum = rdU16(b, 48)
		strOff = rdU32(b, shoff + rdU16(b, 50) * shentsize + 16)
	}
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if !strEqAt(b, strOff + rdU32(b, sh), name) { continue }
		if b[4] == 2 { return rdU64(b, sh + 24), rdU64(b, sh + 48) }
		return rdU32(b, sh + 16), rdU32(b, sh + 32)
	}
	return -1, -1
}

// alignIs reports whether the section named name in b has sh_addralign want and a file offset
// that is a multiple of it.
func alignIs(b @[]uint8, name *[]readonly char, want int) bool {
	off, al := shdrPlace(b, name)
	return al == want && off % want == 0
}

// alignObject writes, for machine, an object with a 4-byte text; executable sections fast
// and text.hot holding one byte each; a section code made without SF_EXEC holding one
// instruction; a data byte; an 8-aligned word in words; 4 bytes of bss; and a rodata byte —
// each after a byte of padding, so a misplaced file offset shows — and returns its bytes
// (empty on failure).
func alignObject(dir *[]readonly char, machine int) @[]uint8 {
	var wordSize int = 8
	if machine == EM_ARM { wordSize = 4 }
	var a @asm.Assembler = asm.New(wordSize)
	a.SetSection("text", -1)
	a.EmitUint32(0)
	a.SetSection("fast", asm.SF_READ | asm.SF_EXEC)
	a.EmitUint8(1)
	a.SetSection("text.hot", -1)
	a.EmitUint8(1)
	a.SetSection("code", asm.SF_READ)
	if machine == EM_AARCH64 { aarch64.Ret(a) }
	if machine == EM_X86_64 { x64.Ret(a) }
	if machine == EM_ARM { arm32.Bx(a, arm32.COND_AL, arm32.LR) }
	a.SetSection("data", -1)
	a.EmitUint8(2)
	a.SetSection("words", asm.SF_READ | asm.SF_WRITE)
	a.Align(8)
	a.EmitUint64(3)
	a.SetSection("bss", -1)
	a.Zero(4)
	a.SetSection("rodata", -1)
	a.EmitUint8(4)
	var none @[]uint8
	if !a.Finalize() { return none }
	var path @[]char = buf.Concat(dir, "/elf_align.o")
	var ok bool = false
	if machine == EM_AARCH64 { ok = WriteAArch64(a, path) }
	if machine == EM_X86_64 { ok = WriteX86_64(a, path) }
	if machine == EM_ARM { ok = WriteARM32(a, path, false) }
	if !ok { return none }
	b, n := c26Read(path)
	if n < 100 { return none }
	return b
}

// alignsAre reports whether b's sections text, fast, text.hot and code have the alignments
// text, fast, fast and code, and data, words, bss and rodata 1, 8, 1 and 1, each at a file
// offset that is a multiple of its alignment.
func alignsAre(b @[]uint8, text int, fast int, code int) bool {
	return alignIs(b, ".text", text) && alignIs(b, ".fast", fast) && alignIs(b, ".text.hot", fast) &&
			alignIs(b, ".code", code) && alignIs(b, ".data", 1) && alignIs(b, ".words", 8) &&
			alignIs(b, ".bss", 1) && alignIs(b, ".rodata", 1)
}

// A section's sh_addralign is the largest alignment it requested, at least clang's minimum
// (llvm-readelf on clang's objects): 4 for text on every machine (the name alone: text.hot
// is like any other executable section), and for any other executable section on AArch64,
// else 1 — so an 8-aligned word's section is 8 and a byte's 1.  An A64 or A32 instruction
// makes its section 4, even without SF_EXEC, as GNU as aligns a section holding code (clang
// leaves such a section 1, which would let a linker misalign its instructions); an x86-64
// instruction needs no alignment.
func TestWriteElfSectionAlignments() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var b @[]uint8 = alignObject(dir, EM_AARCH64)
	if len(b) == 0 || !alignsAre(b, 4, 4, 4) { return fail("wrong AArch64 section alignments") }
	b = alignObject(dir, EM_X86_64)
	if len(b) == 0 || !alignsAre(b, 4, 1, 1) { return fail("wrong x86-64 section alignments") }
	b = alignObject(dir, EM_ARM)
	if len(b) == 0 || !alignsAre(b, 4, 1, 4) { return fail("wrong ARM section alignments") }
	return ""
}
