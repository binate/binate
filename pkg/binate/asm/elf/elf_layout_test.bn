package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// ELF layout: every section's file offset is a multiple of its sh_addralign, which a
// `.balign` / `.p2align` beyond the default 16 raises; each section's type and flags; and a
// zero-fill section's place in the file.  (c26Read is in elf_call26_test.bn; rdU16 / rdU32 /
// rdU64 and strEqAt in elf_test.bn.)

// Each section header's sh_offset is a multiple of its sh_addralign, including a data
// section aligned to 64 behind a short text section.
func TestWriteElfSectionOffsetsAligned() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.SetGlobal("f")
	aarch64.Ret(a)
	a.SetSection("data", -1)
	a.EmitUint8(1)
	a.Align(64)
	a.EmitUint64(5)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/elf_layout.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	var shoff int = rdU64(b, 40)
	var shentsize int = rdU16(b, 58)
	var shnum int = rdU16(b, 60)
	var saw64 bool = false
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var off int = rdU64(b, sh + 24)
		var align int = rdU64(b, sh + 48)
		if align > 1 && off % align != 0 {
			return fail("a section's offset is not a multiple of its alignment")
		}
		if align == 64 { saw64 = true }
	}
	if !saw64 { return fail("the data section's sh_addralign is not 64") }
	return ""
}

// elfShdrNamed returns the byte offset of the section header named name in the ELF64 object
// b, or -1 when there is none.
func elfShdrNamed(b @[]uint8, name *[]readonly char) int {
	var shoff int = rdU64(b, 40)
	var shentsize int = rdU16(b, 58)
	var shnum int = rdU16(b, 60)
	var strOff int = rdU64(b, shoff + rdU16(b, 62) * shentsize + 24)
	for i := 1; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if strEqAt(b, strOff + rdU32(b, sh), name) { return sh }
	}
	return -1
}

// shdrIs reports whether the section named name in the ELF64 object b has type stype and
// flags shflags.
func shdrIs(b @[]uint8, name *[]readonly char, stype uint32, shflags uint64) bool {
	var sh int = elfShdrNamed(b, name)
	return sh >= 0 && rdU32(b, sh + 4) == cast(int, stype) && rdU64(b, sh + 8) == cast(int, shflags)
}

// A section's type and flags are clang's for `.section .<name>,"<flags>"` (checked with
// llvm-readelf): the flags it was made with, whatever its name, and the type its name implies.
// A zero-fill section takes no bytes in the file, so the sections after it start where it does.
func TestWriteElfSectionTypesAndFlags() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	aarch64.Ret(a)
	a.SetSection("fast", asm.SF_READ | asm.SF_EXEC)
	aarch64.Ret(a)
	a.SetSection("init_array.5", asm.SF_READ | asm.SF_WRITE)
	a.EmitUint64(0)
	a.SetSection("note.x", asm.SF_READ)
	a.EmitUint32(1)
	a.SetSection("meta", 0)
	a.EmitUint32(7)
	a.SetSection("bss.z", asm.SF_READ | asm.SF_WRITE)
	a.Zero(16)
	a.SetSection("bss", -1)
	a.Zero(8)
	a.SetSection("data", -1)
	a.EmitUint64(5)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/elf_sect_types.o")
	if !WriteAArch64(a, path) { return fail("WriteAArch64 failed") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	if !shdrIs(b, ".text", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR) ||
			!shdrIs(b, ".fast", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR) {
		return fail("an executable section is not PROGBITS AX")
	}
	if !shdrIs(b, ".init_array.5", SHT_INIT_ARRAY, SHF_ALLOC | SHF_WRITE) {
		return fail(".init_array.5 is not INIT_ARRAY WA")
	}
	if !shdrIs(b, ".note.x", SHT_NOTE, SHF_ALLOC) { return fail(".note.x is not NOTE A") }
	if !shdrIs(b, ".meta", SHT_PROGBITS, 0) { return fail(".meta is not unallocated PROGBITS") }
	if !shdrIs(b, ".bss.z", SHT_NOBITS, SHF_ALLOC | SHF_WRITE) {
		return fail(".bss.z is not NOBITS WA")
	}
	if !shdrIs(b, ".data", SHT_PROGBITS, SHF_ALLOC | SHF_WRITE) {
		return fail(".data is not PROGBITS WA")
	}
	if !shdrIs(b, ".bss", SHT_NOBITS, SHF_ALLOC | SHF_WRITE) { return fail(".bss is not NOBITS WA") }
	var bss int = elfShdrNamed(b, ".bss.z")
	var bss2 int = elfShdrNamed(b, ".bss")
	if rdU64(b, bss + 32) != 16 || rdU64(b, bss2 + 32) != 8 {
		return fail("a zero-fill section's size is not its length")
	}
	var dataOff int = rdU64(b, elfShdrNamed(b, ".data") + 24)
	if dataOff != rdU64(b, bss + 24) || dataOff != rdU64(b, bss2 + 24) {
		return fail("a zero-fill section takes bytes in the file")
	}
	return ""
}
