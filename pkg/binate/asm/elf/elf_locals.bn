package "pkg/binate/asm/elf"

import "pkg/binate/asm"

// Relocations against local symbols defined in a section — temporary labels
// (asm.IsTemporaryLabel for ELF: `.L…` and the assembler's generated labels), which an ELF
// symbol table lists only when a relocation must name one, and named ones (labels, aliases,
// local commons), which it always lists.  As clang's ELF writer decides
// (shouldRelocateWithSymbol and each target's needsRelocateWithSymbol), a relocation against
// one is made against its section's symbol, the symbol's offset added to the addend — except
// a GOT reference, whose GOT slot is the symbol's own, on arm32 anything but an absolute word
// (R_ARM_ABS32), and anything against a symbol in a thread-local section (asm.SF_TLS), whose
// value is an offset in the thread-local template: those keep the symbol.  (An aarch64 `bl
// sym@PLT` or an x86-64 `call sym@PLT` is a plain branch fixup here, so it goes against the
// section too, where clang keeps the symbol; the linked result is the same.)

// elfRelocWithSection reports whether a relocation of ELF type rtype on machine against a
// local symbol defined in a section is made against its section's symbol instead.
func elfRelocWithSection(rtype int, machine int) bool {
	if machine == EM_ARM { return rtype == R_ARM_ABS32 }
	if machine == EM_AARCH64 {
		return rtype != R_AARCH64_ADR_GOT_PAGE && rtype != R_AARCH64_LD64_GOT_LO12_NC &&
				rtype != R_AARCH64_LD64_GOTPAGE_LO15 && rtype != R_AARCH64_GOT_LD_PREL19
	}
	if machine == EM_X86_64 { return rtype != R_X86_64_REX_GOTPCRELX }
	return false
}

// isElfTemporary reports whether sym is a defined local temporary label — or constant
// (`.LN = 5`), never listed either — in an ELF object.
func isElfTemporary(sym asm.Symbol) bool {
	return (sym.Section >= 0 || sym.Abs) && sym.Binding == asm.BIND_LOCAL && !sym.SectionSym &&
			asm.IsTemporaryLabel(sym.Name, asm.OBJ_ELF)
}

// isElfSectionLocal reports whether sym is a local symbol defined in a section (a label, an
// alias or a local common, temporary or named) — not a section symbol, nor absolute.
func isElfSectionLocal(sym asm.Symbol) bool {
	return sym.Section >= 0 && !sym.Abs && sym.Binding == asm.BIND_LOCAL && !sym.SectionSym
}

// retargetElfLocalRelocs makes each relocation against a local symbol defined in a section
// that elfRelocWithSection allows a relocation against its section's symbol
// (asm.SectionSymbol), the symbol's offset added to the addend — into the relocated word
// itself for arm32, whose REL relocations carry the addend in the field (the only one
// retargeted there, R_ARM_ABS32, is a whole word).  Returns false, with a's error set,
// when a section symbol cannot be defined.
func retargetElfLocalRelocs(a @asm.Assembler, machine int) bool {
	var secSyms @[]int = make_slice(int, a.NumSections) // each section's symbol, 0 until made
	for ri := 0; ri < a.NumRelocs; ri++ {
		var rel asm.Relocation = a.Relocs[ri]
		var t asm.Symbol = a.Symbols[rel.Symbol]
		if !isElfSectionLocal(t) || (a.Sections[t.Section].Flags & asm.SF_TLS) != 0 ||
				!elfRelocWithSection(elfRelocType(rel.Kind, machine, rel.Addend == 0), machine) {
			continue
		}
		var ss int = secSyms[t.Section]
		if ss == 0 {
			ss = a.SectionSymbol(t.Section)
			if ss < 0 { return false }
			secSyms[t.Section] = ss
		}
		a.Relocs[ri].Symbol = ss
		if machine == EM_ARM {
			addToWord32(a.Sections[rel.Section].Data, cast(int, rel.Offset), cast(uint32, t.Offset))
		} else {
			a.Relocs[ri].Addend = rel.Addend + cast(int64, t.Offset)
		}
	}
	return true
}

// addToWord32 adds v to the little-endian 32-bit word at data[off].
func addToWord32(data @[]uint8, off int, v uint32) {
	var w uint32 = cast(uint32, data[off]) | (cast(uint32, data[off + 1]) << 8) |
			(cast(uint32, data[off + 2]) << 16) | (cast(uint32, data[off + 3]) << 24)
	w = w + v
	data[off] = cast(uint8, w & 0xFF)
	data[off + 1] = cast(uint8, (w >> 8) & 0xFF)
	data[off + 2] = cast(uint8, (w >> 16) & 0xFF)
	data[off + 3] = cast(uint8, w >> 24)
}
