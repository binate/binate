package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// Tests for the relocations against local symbols defined in a section (elf_locals.bn):
// clang's per-type choice between the symbol and its section's symbol, and the retargeting.

// A relocation against such a local goes against its section's symbol except, as clang's:
// on aarch64 the GOT page / GOT load pair, on x86-64 the GOTPCREL load, on arm32 anything
// but R_ARM_ABS32.
func TestElfRelocWithSection() testing.TestResult {
	if !elfRelocWithSection(R_AARCH64_ABS64, EM_AARCH64) ||
			!elfRelocWithSection(R_AARCH64_JUMP26, EM_AARCH64) ||
			!elfRelocWithSection(R_AARCH64_ADR_PREL_PG_HI21, EM_AARCH64) ||
			!elfRelocWithSection(R_AARCH64_ADR_PREL_PG_HI21_NC, EM_AARCH64) ||
			!elfRelocWithSection(R_AARCH64_MOVW_UABS_G0, EM_AARCH64) {
		return fail("an aarch64 non-GOT relocation keeps the label")
	}
	if elfRelocWithSection(R_AARCH64_ADR_GOT_PAGE, EM_AARCH64) ||
			elfRelocWithSection(R_AARCH64_LD64_GOT_LO12_NC, EM_AARCH64) ||
			elfRelocWithSection(R_AARCH64_LD64_GOTPAGE_LO15, EM_AARCH64) ||
			elfRelocWithSection(R_AARCH64_GOT_LD_PREL19, EM_AARCH64) {
		return fail("an aarch64 GOT relocation goes against the section")
	}
	if !elfRelocWithSection(R_X86_64_PC32, EM_X86_64) ||
			elfRelocWithSection(R_X86_64_REX_GOTPCRELX, EM_X86_64) {
		return fail("wrong x86-64 choice")
	}
	if !elfRelocWithSection(R_ARM_ABS32, EM_ARM) || elfRelocWithSection(R_ARM_JUMP24, EM_ARM) ||
			elfRelocWithSection(R_ARM_MOVW_ABS_NC, EM_ARM) || elfRelocWithSection(R_ARM_LDR_PC_G0, EM_ARM) ||
			elfRelocWithSection(R_ARM_LDRS_PC_G0, EM_ARM) || elfRelocWithSection(R_ARM_ALU_PC_G0, EM_ARM) {
		return fail("wrong arm32 choice")
	}
	return ""
}

// addToWord32 adds to a little-endian word in place, carrying across its bytes.
func TestAddToWord32() testing.TestResult {
	var d @[]uint8 = make_slice(uint8, 8)
	d[4] = 0xFF
	d[5] = 0xFF
	addToWord32(d, 4, 1)
	if d[4] != 0 || d[5] != 0 || d[6] != 1 || d[7] != 0 || d[3] != 0 {
		return fail("wrong sum or carry")
	}
	return ""
}

// On arm32 only an absolute word (R_ARM_ABS32) is made against the section symbol, the
// label's offset added into the word (REL keeps the addend there); a branch keeps its
// temporary (clang: `bl .Lx` is `R_ARM_CALL .Lx`).
func TestRetargetElfTemporaryRelocsArm32() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.Fill(8, cast(uint8, 0))
	a.DefineLabel(".Lx")
	a.Fill(4, cast(uint8, 0))
	a.SetSection("other", asm.SF_READ | asm.SF_EXEC)
	a.AddFixup(".Lx", 0, 4, 4)
	a.Fill(4, cast(uint8, 0))
	arm32.Bl(a, arm32.COND_AL, ".Lx")
	a.ObjFormat = asm.OBJ_ELF
	if !a.CheckTemporaryLabels() { return fail(a.ErrorMsg) }
	arm32.ResolveFixups(a)
	if !a.Finalize() || a.NumRelocs != 2 { return fail("expected two relocations") }
	if !retargetElfLocalRelocs(a, EM_ARM) { return fail(a.ErrorMsg) }
	var ss int = a.Relocs[0].Symbol
	if !a.Symbols[ss].SectionSym || a.Symbols[ss].Section != 0 {
		return fail("the ABS32 relocation is not against text's section symbol")
	}
	var d @[]uint8 = a.Sections[1].Data
	if cast(int, d[0]) != 12 || d[1] != 0 || d[2] != 0 || d[3] != 0 {
		return fail("the label's offset is not added into the ABS32 word")
	}
	if !charsEqual(a.Symbols[a.Relocs[1].Symbol].Name, ".Lx") {
		return fail("the branch does not keep .Lx")
	}
	return ""
}

// A named local symbol's relocations follow the same rules as a temporary's, as clang's do:
// on aarch64 a data word and an ADRP of `loc` go against text's section symbol, `loc`'s
// offset added to the addend, while an ADRP of loc's GOT page keeps `loc` (addend 0); on arm32
// an absolute word goes against the section, a branch keeps the symbol.
func TestRetargetElfNamedLocalRelocs() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.Fill(8, cast(uint8, 0))
	a.DefineLabel("loc")
	a.Fill(4, cast(uint8, 0))
	a.SetSection("data", -1)
	a.EmitAddr("loc")
	a.SetSection("other", asm.SF_READ | asm.SF_EXEC)
	aarch64.Adrp(a, aarch64.X0, "loc")
	aarch64.AdrpGot(a, aarch64.X1, "loc")
	aarch64.ResolveFixups(a)
	if !a.Finalize() || a.NumRelocs != 3 { return fail("expected three aarch64 relocations") }
	if !retargetElfLocalRelocs(a, EM_AARCH64) { return fail(a.ErrorMsg) }
	for i := 0; i < 2; i++ {
		var s asm.Symbol = a.Symbols[a.Relocs[i].Symbol]
		if !s.SectionSym || s.Section != 0 || a.Relocs[i].Addend != 8 {
			return fail("an aarch64 non-GOT relocation of loc is not text's section + 8")
		}
	}
	if !charsEqual(a.Symbols[a.Relocs[2].Symbol].Name, "loc") || a.Relocs[2].Addend != 0 {
		return fail("the GOT-page ADRP does not keep loc with addend 0")
	}
	var b @asm.Assembler = asm.New(4)
	b.ObjFormat = asm.OBJ_ELF
	b.SetSection("text", -1)
	b.Fill(8, cast(uint8, 0))
	b.DefineLabel("lx")
	b.Fill(4, cast(uint8, 0))
	b.SetSection("other", asm.SF_READ | asm.SF_EXEC)
	b.AddFixup("lx", 0, 0, 4)
	b.Fill(4, cast(uint8, 0))
	arm32.Bl(b, arm32.COND_AL, "lx")
	arm32.ResolveFixups(b)
	if !b.Finalize() || b.NumRelocs != 2 { return fail("expected two arm32 relocations") }
	if !retargetElfLocalRelocs(b, EM_ARM) { return fail(b.ErrorMsg) }
	if !b.Symbols[b.Relocs[0].Symbol].SectionSym || cast(int, b.Sections[1].Data[0]) != 8 {
		return fail("the arm32 ABS32 of lx is not text's section, lx's offset in the word")
	}
	if !charsEqual(b.Symbols[b.Relocs[1].Symbol].Name, "lx") {
		return fail("the arm32 branch does not keep lx")
	}
	return ""
}
