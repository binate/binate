package "pkg/binate/asm/elf"

import "pkg/binate/asm"

// Mapping symbols, as clang writes them from the assembler's mapping marks (asm.MapMark):
// on AArch64 `$x` where a section starts holding instructions and `$d` where it starts
// holding data; on arm32 `$a` and `$d`, except that a section's first mark, when data, is
// listed only if code follows in the section, and is then registered just before that
// code's `$a` (clang holds it back until then, so a section of data alone has none); none on
// x86-64.  Each is a local symbol of no size at its mark (writeElfMapSymbol), listed among the
// locals where clang registers it (elfSymbolKey's order).

// elfMapName returns the name of the mapping symbol for a mark of code (or data) on
// machine, or "" when machine has none.
func elfMapName(machine int, code bool) *[]readonly char {
	if machine == EM_AARCH64 {
		if code { return "$x" }
		return "$d"
	}
	if machine == EM_ARM {
		if code { return "$a" }
		return "$d"
	}
	return ""
}

// elfMapKeys returns, for each of a's mapping marks, its key among the local symbols
// (elfSymbolKey), or -1 when machine lists no symbol for it.
func elfMapKeys(a @asm.Assembler, machine int) @[]int64 {
	var keys @[]int64 = make_slice(int64, a.NumMapMarks)
	var stride int64 = cast(int64, a.NumSections + 1)
	var seen @[]bool = make_slice(bool, a.NumSections) // whether a section's first mark is past
	for k := 0; k < a.NumMapMarks; k++ {
		var m asm.MapMark = a.MapMarks[k]
		keys[k] = (2 * cast(int64, m.Mention) - 1) * stride
		if len(elfMapName(machine, m.Code)) == 0 { keys[k] = -1 }
		var first bool = !seen[m.Section]
		seen[m.Section] = true
		if machine != EM_ARM || !first || m.Code { continue }
		// arm32's held-back `$d`: registered just before the section's next code mark, ahead
		// of it and after everything registered before that mark.
		keys[k] = -1
		for j := k + 1; j < a.NumMapMarks; j++ {
			if a.MapMarks[j].Section == m.Section && a.MapMarks[j].Code {
				keys[k] = (2 * cast(int64, a.MapMarks[j].Mention) - 1) * stride - 1
				break
			}
		}
	}
	return keys
}

// writeElfMapSymbol writes the mapping symbol for mark m, its name at strOff: local, of no
// size, at the mark in its section; STT_NOTYPE, or STT_TLS when tls — an AArch64 one in a
// thread-local section, as clang types every symbol there (its arm32 ones stay STT_NOTYPE).
func writeElfMapSymbol(bb BinBuf, m asm.MapMark, tls bool, strOff int, h elfHeaders,
		is64 bool) BinBuf {
	var stype int = STT_NOTYPE
	if tls { stype = STT_TLS }
	var info uint8 = cast(uint8, (STB_LOCAL << 4) | stype)
	var shndx uint16 = cast(uint16, h.Sect[m.Section])
	bb = bb.WriteU32(cast(uint32, strOff))
	if is64 {
		bb = bb.WriteU8(info)
		bb = bb.WriteU8(0)
		bb = bb.WriteU16(shndx)
		bb = bb.WriteU64(cast(uint64, m.Offset))
		bb = bb.WriteU64(0)
		return bb
	}
	bb = bb.WriteU32(cast(uint32, m.Offset))
	bb = bb.WriteU32(0)
	bb = bb.WriteU8(info)
	bb = bb.WriteU8(0)
	bb = bb.WriteU16(shndx)
	return bb
}
