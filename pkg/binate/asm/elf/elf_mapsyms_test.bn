package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// Which mapping marks each machine lists, and where among the locals (elf_mapsyms.bn): a text
// section holding data, then (after a label f) code; a data section holding data alone.  On
// AArch64 every mark, each where it was made; on arm32 the data section's lone mark is not
// listed, and text's first, data, is listed just before the code mark that follows it (after
// f); on x86-64 none.
func TestElfMapKeys() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.EmitUint32(1)
	a.DefineLabel("f")
	a.EmitInstrUint32(0xE12FFF1E) // bx lr
	a.SetSection("data", -1)
	a.EmitUint32(2)
	if a.HasError || a.NumMapMarks != 3 { return fail("not three marks") }
	var f int64 = elfSymbolKey(a, a.LookupSymbol("f"))
	var k @[]int64 = elfMapKeys(a, EM_AARCH64)
	if !(k[0] >= 0 && k[0] < f && f < k[1] && k[1] < k[2]) {
		return fail("AArch64: the marks are not listed where they were made")
	}
	if !charsEqual(elfMapName(EM_AARCH64, true), "$x") ||
			!charsEqual(elfMapName(EM_AARCH64, false), "$d") {
		return fail("AArch64: not $x and $d")
	}
	k = elfMapKeys(a, EM_ARM)
	if k[2] != -1 { return fail("arm32: the data section's lone mark is listed") }
	if !(f < k[0] && k[0] < k[1]) { return fail("arm32: text's first mark is not just before its $a") }
	if !charsEqual(elfMapName(EM_ARM, true), "$a") || !charsEqual(elfMapName(EM_ARM, false), "$d") {
		return fail("arm32: not $a and $d")
	}
	k = elfMapKeys(a, EM_X86_64)
	if k[0] != -1 || k[1] != -1 || k[2] != -1 { return fail("x86-64: a mark is listed") }
	return ""
}
