package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// The ELF symbol table: which of the assembler's symbols it lists, in the order ELF
// requires (every local before the globals and weaks), and their names.  A local
// temporary label (asm.IsTemporaryLabel, ELF's `.L` and the assembler's generated names)
// is listed only when a relocation still names it (elf_locals.bn) — as `.Ltmp<n>` for a
// generated one, whose own name no source can spell, and `.L0 ` for one made for `.` — a
// section symbol is listed as STT_SECTION, unnamed, and the mapping symbols (elf_mapsyms.bn)
// among the locals.

// elfSymtab is an ELF symbol table's layout.
type elfSymtab struct {
	// Order[i]: what table index i + 1 lists (0 is the null entry): the assembler symbol
	// Order[i], or, at a.NumSymbols + k and above, a's mapping mark k
	Order     @[]int
	Remap     @[]int // Remap[s]: assembler symbol s's table index, or 0 when not listed
	N         int // symbols listed, not counting the null entry
	NumLocals int // local entries, counting the null entry (the table's sh_info)
	Names     @[]@[]char // Names[i]: the name Order[i] is listed under ("" for none)
	StrOffs   @[]int // StrOffs[i]: the .strtab offset of Names[i] (elfStringTable; 0: no name)
}

// elfSymbolKey returns where symbol i of a comes in its part of the symbol table (the locals,
// or the rest): in the order clang registers its symbols — a section symbol when its section
// was created, after every name mentioned before that, before the next, and after the
// symbols of the sections created earlier; any other symbol where its name was first
// mentioned (asm.Symbol.Mention).
func elfSymbolKey(a @asm.Assembler, i int) int64 {
	var stride int64 = cast(int64, a.NumSections + 1)
	var sym asm.Symbol = a.Symbols[i]
	if sym.SectionSym {
		return 2 * cast(int64, a.Sections[sym.Section].MentionsBefore) * stride + cast(int64, sym.Section)
	}
	return (2 * cast(int64, sym.Mention) - 1) * stride
}

// buildElfSymtab lays out a's symbol table for machine — every symbol but a local temporary
// label no relocation names, and machine's mapping symbols, the locals first, each part in
// elfSymbolKey order — and the names its entries are listed under.
func buildElfSymtab(a @asm.Assembler, machine int) elfSymtab {
	var st elfSymtab
	var total int = a.NumSymbols + a.NumMapMarks
	st.Order = make_slice(int, total)
	st.Remap = make_slice(int, a.NumSymbols)
	st.Names = make_slice(@[]char, total)
	st.StrOffs = make_slice(int, total)
	var named @[]bool = make_slice(bool, a.NumSymbols)
	for ri := 0; ri < a.NumRelocs; ri++ { named[a.Relocs[ri].Symbol] = true }
	var keys @[]int64 = make_slice(int64, total)
	for i := 0; i < a.NumSymbols; i++ { keys[i] = elfSymbolKey(a, i) }
	var mapKeys @[]int64 = elfMapKeys(a, machine)
	for k := 0; k < a.NumMapMarks; k++ { keys[a.NumSymbols + k] = mapKeys[k] }
	var tmps int = 0
	for pass := 0; pass < 2; pass++ {
		var part @[]int = make_slice(int, total)
		var n int = 0
		for i := 0; i < a.NumSymbols; i++ {
			var sym asm.Symbol = a.Symbols[i]
			var local bool = sym.Binding == asm.BIND_LOCAL
			if (isElfTemporary(sym) && !named[i]) || local != (pass == 0) { continue }
			part[n] = i
			n = n + 1
		}
		for k := 0; pass == 0 && k < a.NumMapMarks; k++ {
			if mapKeys[k] < 0 { continue }
			part[n] = a.NumSymbols + k
			n = n + 1
		}
		var ordered @[]int = make_slice(int, n)
		for k := 0; k < n; k++ { ordered[k] = part[k] }
		asm.SortIndices(ordered, asm.SORT_BY_KEY, keys, make_slice(@[]char, 0))
		for k := 0; k < n; k++ {
			var i int = ordered[k]
			st.Order[st.N] = i
			st.N = st.N + 1
			if i >= a.NumSymbols {
				st.Names[st.N - 1] = buf.CopyStr(elfMapName(machine, a.MapMarks[i - a.NumSymbols].Code))
				continue
			}
			var sym asm.Symbol = a.Symbols[i]
			st.Remap[i] = st.N
			if sym.SectionSym { continue }
			if isDotLabel(sym.Name) {
				// clang lists each `.` it makes a symbol of as `.L0 `, a trailing space included.
				st.Names[st.N - 1] = buf.CopyStr(".L0 ")
			} else if asm.IsGeneratedLabel(sym.Name) {
				var tmpName @[]char = ltmpName(tmps)
				for a.LookupSymbol(tmpName) >= 0 {
					tmps = tmps + 1
					tmpName = ltmpName(tmps)
				}
				st.Names[st.N - 1] = tmpName
				tmps = tmps + 1
			} else {
				st.Names[st.N - 1] = buf.CopyStr(sym.Name)
			}
		}
		if pass == 0 { st.NumLocals = st.N + 1 }
	}
	return st
}

// isDotLabel reports whether name is a label the parser made for `.` in an expression
// (asm.GeneratedLabelName with base ".").
func isDotLabel(name *[]readonly char) bool {
	return asm.IsGeneratedLabel(name) && len(name) > 3 && name[2] == '.' && name[3] == cast(char, 2)
}

// ltmpName returns `.Ltmp<n>`, the name a listed generated label is given (as clang names
// its own); buildElfSymtab skips any n whose name a source label already has.
func ltmpName(n int) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(".Ltmp")
	stringutils.WriteInt(b, n)
	return buf.CopyStr(b.String())
}

// writeElfSymbols writes st's entries after the null one: each symbol's name, binding,
// type (elfSymType, STT_SECTION for a section symbol), visibility (st_other: asm.VIS_* are
// its values), section index (h's), value and size — a common's section index SHN_COMMON and
// value its alignment.
func writeElfSymbols(bb BinBuf, a @asm.Assembler, st elfSymtab, h elfHeaders, machine int,
		is64 bool) BinBuf {
	for i := 0; i < st.N; i++ {
		if st.Order[i] >= a.NumSymbols {
			var m asm.MapMark = a.MapMarks[st.Order[i] - a.NumSymbols]
			var tls bool = machine == EM_AARCH64 && (a.Sections[m.Section].Flags & asm.SF_TLS) != 0
			bb = writeElfMapSymbol(bb, m, tls, st.StrOffs[i], h, is64)
			continue
		}
		var sym asm.Symbol = a.Symbols[st.Order[i]]
		var binding int = STB_LOCAL
		if sym.Binding == asm.BIND_GLOBAL { binding = STB_GLOBAL }
		if sym.Binding == asm.BIND_WEAK { binding = STB_WEAK }
		var stype int = elfSymType(sym)
		if sym.SectionSym { stype = STT_SECTION }
		var stInfo uint8 = cast(uint8, (binding << 4) | stype)
		var stOther uint8 = cast(uint8, sym.Visibility)
		var shndx uint16 = cast(uint16, SHN_UNDEF) // an undefined symbol: no section
		var value uint64 = cast(uint64, sym.Offset)
		if sym.Section >= 0 {
			shndx = cast(uint16, h.Sect[sym.Section])
		}
		if sym.Abs {
			shndx = cast(uint16, SHN_ABS)
			value = bit_cast(uint64, sym.AbsValue)
		}
		if sym.Common {
			shndx = cast(uint16, SHN_COMMON)
			value = cast(uint64, sym.CommonAlign)
		}
		var size uint64 = cast(uint64, sym.Size)
		if is64 {
			// Elf64_Sym: name(4), info(1), other(1), shndx(2), value(8), size(8)
			bb = bb.WriteU32(cast(uint32, st.StrOffs[i]))
			bb = bb.WriteU8(stInfo)
			bb = bb.WriteU8(stOther)
			bb = bb.WriteU16(shndx)
			bb = bb.WriteU64(value)
			bb = bb.WriteU64(size)
		} else {
			// Elf32_Sym: name(4), value(4), size(4), info(1), other(1), shndx(2) — a
			// value keeps its low 32 bits, as clang's arm32 objects do (a common's size and
			// alignment fit: DefineCommon checks them against a 4-byte word).
			bb = bb.WriteU32(cast(uint32, st.StrOffs[i]))
			bb = bb.WriteU32(cast(uint32, value & 0xFFFFFFFF))
			bb = bb.WriteU32(cast(uint32, size & 0xFFFFFFFF))
			bb = bb.WriteU8(stInfo)
			bb = bb.WriteU8(stOther)
			bb = bb.WriteU16(shndx)
		}
	}
	return bb
}
