package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Temporary labels in an ELF object (elf_symtab.bn, elf_temps.bn): a relocation against a
// `.L` label or an assembler-generated one is made against its section's symbol
// (STT_SECTION, unnamed) with the label's offset in the addend — clang's `R_AARCH64_ABS64
// .text+0x28` — except where clang keeps the label (a GOT reference; on arm32 anything but
// R_ARM_ABS32), and the symbol table lists only the temporaries a relocation names.
// (c26Read / c26Rela / c26EntryIs are in elf_call26_test.bn; rdU16 / rdU32 / rdU64 in
// elf_test.bn.)

// tmpSymtab returns the file offset, entry count and sh_info of the SHT_SYMTAB section of
// the ELF64 object in b, and the file offset of its string table, or -1s.
func tmpSymtab(b @[]uint8) (int, int, int, int) {
	var shoff int = rdU64(b, 40)
	var shentsize int = rdU16(b, 58)
	var shnum int = rdU16(b, 60)
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if rdU32(b, sh + 4) != cast(int, SHT_SYMTAB) { continue }
		var link int = rdU32(b, sh + 40)
		var strOff int = rdU64(b, shoff + link * shentsize + 24)
		return rdU64(b, sh + 24), rdU64(b, sh + 32) / 24, rdU32(b, sh + 44), strOff
	}
	return -1, -1, -1, -1
}

// tmpNameIs reports whether the NUL-terminated string at b[at] is want.
func tmpNameIs(b @[]uint8, at int, want *[]readonly char) bool {
	for i := 0; i < len(want); i++ {
		if b[at + i] != cast(uint8, want[i]) { return false }
	}
	return b[at + len(want)] == 0
}

// tmpRelaSym returns the symbol index (r_info's high word) of Elf64_Rela entry i at relaOff.
func tmpRelaSym(b @[]uint8, relaOff int, i int) int {
	return rdU64(b, relaOff + i * 24 + 8) >> 32
}

// Text holds f (local), .Lx at 8, Lkeep at 12 and a generated label at 16, then ABS64
// words against .Lx+4 and the generated label and GOT page references to .Lg and to a
// second generated label (both in data).  The ABS64 relocations go against text's section
// symbol (addends 12 and 16) and the table does not list .Lx or the first generated
// label; the GOT references keep their targets, which the table then lists — .Lg by name,
// the generated one as .Ltmp0 — as clang's `R_AARCH64_ADR_GOT_PAGE .Lv`.
func TestWriteElfTemporaryLabels() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var gen @[]char = asm.GeneratedLabelName("1", 1)
	var gen2 @[]char = asm.GeneratedLabelName("2", 1)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("f")
	a.EmitUint64(0)
	a.DefineLabel(".Lx")
	a.EmitUint32(0)
	a.DefineLabel("Lkeep")
	a.EmitUint32(0)
	a.DefineLabel(gen)
	a.EmitUint32(0)
	a.AddFixup(".Lx", 0, 4, 8)
	a.EmitUint64(0)
	a.AddFixup(gen, 0, 0, 8)
	a.EmitUint64(0)
	aarch64.AdrpGot(a, 0, ".Lg")
	aarch64.AdrpGot(a, 1, gen2)
	a.SetSection("data", -1)
	a.DefineLabel(".Lg")
	a.EmitUint64(0)
	a.DefineLabel(gen2)
	a.EmitUint64(0)
	a.ObjFormat = asm.OBJ_ELF
	if !a.CheckTemporaryLabels() { return fail(a.ErrorMsg) }
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }

	var path @[]char = buf.Concat(dir, "/elf_temps.o")
	if !WriteAArch64(a, path) { return fail(a.ErrorMsg) }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	symOff, nsyms, info, strOff := tmpSymtab(b)
	if symOff < 0 { return fail("no SHT_SYMTAB section") }
	if nsyms != 6 { return fail("expected null, f, Lkeep, .Lg, .Ltmp0 and one section symbol") }
	if info != 6 { return fail("sh_info must count the null entry and the five locals") }
	var secSym int = -1
	var lg int = -1
	var ltmp int = -1
	var seen int = 0
	for i := 1; i < nsyms; i++ {
		var s int = symOff + i * 24
		var name int = rdU32(b, s)
		var stype int = cast(int, b[s + 4]) & 15
		if stype == STT_SECTION {
			if name != 0 || rdU16(b, s + 6) != 1 { return fail("the section symbol is not text's") }
			secSym = i
		} else if tmpNameIs(b, strOff + name, ".Lg") {
			lg = i
		} else if tmpNameIs(b, strOff + name, ".Ltmp0") {
			if rdU16(b, s + 6) != 2 || rdU64(b, s + 8) != 8 { return fail(".Ltmp0 is not data+8") }
			ltmp = i
		} else if tmpNameIs(b, strOff + name, "f") || tmpNameIs(b, strOff + name, "Lkeep") {
			seen = seen + 1
		} else {
			return fail("an unreferenced temporary label is in the symbol table")
		}
	}
	if secSym < 0 || lg < 0 || ltmp < 0 || seen != 2 { return fail("a listed symbol is missing") }
	relaOff, relaSize := c26Rela(b)
	if relaOff < 0 || relaSize != 4 * 24 { return fail("expected 4 Elf64_Rela entries in .rela.text") }
	if tmpRelaSym(b, relaOff, 0) != secSym || tmpRelaSym(b, relaOff, 1) != secSym {
		return fail("the ABS64 relocations are not against the section symbol")
	}
	if !c26EntryIs(b, relaOff, 0, 20, R_AARCH64_ABS64, 12) ||
			!c26EntryIs(b, relaOff, 1, 28, R_AARCH64_ABS64, 16) {
		return fail("wrong ABS64 type, offset or addend")
	}
	if tmpRelaSym(b, relaOff, 2) != lg || tmpRelaSym(b, relaOff, 3) != ltmp {
		return fail("a GOT relocation does not keep its temporary label")
	}
	if !c26EntryIs(b, relaOff, 2, 36, R_AARCH64_ADR_GOT_PAGE, 0) ||
			!c26EntryIs(b, relaOff, 3, 40, R_AARCH64_ADR_GOT_PAGE, 0) {
		return fail("wrong GOT relocation type, offset or addend")
	}
	return ""
}

// A listed generated label is named `.Ltmp<n>` for the first n no source label has: next
// to a source `.Ltmp0`, it is `.Ltmp1`, and `.Ltmp0` stays the source label's alone.
func TestWriteElfLtmpNameSkipsSourceLabels() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var gen @[]char = asm.GeneratedLabelName("1", 1)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	aarch64.AdrpGot(a, 0, ".Ltmp0")
	aarch64.AdrpGot(a, 1, gen)
	a.SetSection("data", -1)
	a.DefineLabel(".Ltmp0")
	a.EmitUint64(0)
	a.DefineLabel(gen)
	a.EmitUint64(0)
	a.ObjFormat = asm.OBJ_ELF
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/elf_ltmp.o")
	if !WriteAArch64(a, path) { return fail(a.ErrorMsg) }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	symOff, nsyms, _, strOff := tmpSymtab(b)
	var zero int = 0
	var one int = 0
	for i := 1; i < nsyms; i++ {
		var s int = symOff + i * 24
		var name int = rdU32(b, s)
		if tmpNameIs(b, strOff + name, ".Ltmp0") {
			if rdU64(b, s + 8) != 0 { return fail("the source .Ltmp0 is not data+0") }
			zero = zero + 1
		}
		if tmpNameIs(b, strOff + name, ".Ltmp1") {
			if rdU64(b, s + 8) != 8 { return fail("the generated label is not data+8") }
			one = one + 1
		}
	}
	if zero != 1 || one != 1 { return fail("expected one .Ltmp0 (source) and one .Ltmp1 (generated)") }
	return ""
}
