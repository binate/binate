package "pkg/binate/asm/elf"

import "pkg/binate/asm"

// Relocations against temporary labels (asm.IsTemporaryLabel for ELF: `.L…` and the
// assembler's generated labels), which an ELF symbol table lists only when a relocation
// must name one.  As clang's ELF writer decides (shouldRelocateWithSymbol and each
// target's needsRelocateWithSymbol), a relocation against a defined local temporary is
// made against its section's symbol, the label's offset added to the addend — except a GOT
// reference, whose GOT slot is the label's own, and on arm32 anything but an absolute word
// (R_ARM_ABS32): those keep the temporary, and the symbol table lists it.  (An aarch64
// `@PLT` branch is a plain branch fixup here, so it goes against the section too, where
// clang keeps the label; the linked result is the same.)

// elfRelocWithSection reports whether a relocation of ELF type rtype on machine against a
// local temporary label is made against its section's symbol instead.
func elfRelocWithSection(rtype int, machine int) bool {
	if machine == EM_ARM { return rtype == R_ARM_ABS32 }
	if machine == EM_AARCH64 {
		return rtype != R_AARCH64_ADR_GOT_PAGE && rtype != R_AARCH64_LD64_GOT_LO12_NC
	}
	if machine == EM_X86_64 { return rtype != R_X86_64_REX_GOTPCRELX }
	return false
}

// isElfTemporary reports whether sym is a defined local temporary label — or constant
// (`.LN = 5`), never listed either — in an ELF object.
func isElfTemporary(sym asm.Symbol) bool {
	return (sym.Section >= 0 || sym.Abs) && sym.Binding == asm.BIND_LOCAL && !sym.SectionSym &&
			asm.IsTemporaryLabel(sym.Name, asm.OBJ_ELF)
}

// retargetElfTemporaryRelocs makes each relocation against a temporary label that
// elfRelocWithSection allows a relocation against its section's symbol
// (asm.SectionSymbol), the label's offset added to the addend — into the relocated word
// itself for arm32, whose REL relocations carry the addend in the field (the only one
// retargeted there, R_ARM_ABS32, is a whole word).  Returns false, with a's error set,
// when a section symbol cannot be defined.
func retargetElfTemporaryRelocs(a @asm.Assembler, machine int) bool {
	for ri := 0; ri < a.NumRelocs; ri++ {
		var rel asm.Relocation = a.Relocs[ri]
		var t asm.Symbol = a.Symbols[rel.Symbol]
		if !isElfTemporary(t) || t.Abs ||
				!elfRelocWithSection(elfRelocType(rel.Kind, machine, false), machine) {
			continue
		}
		var ss int = a.SectionSymbol(t.Section)
		if ss < 0 { return false }
		a.Relocs[ri].Symbol = ss
		if machine == EM_ARM {
			addToWord32(a.Sections[rel.Section].Data, cast(int, rel.Offset), cast(uint32, t.Offset))
		} else {
			a.Relocs[ri].Addend = rel.Addend + cast(int, t.Offset)
		}
	}
	return true
}

// addToWord32 adds v to the little-endian 32-bit word at data[off].
func addToWord32(data @[]uint8, off int, v uint32) {
	var w uint32 = cast(uint32, data[off]) | (cast(uint32, data[off + 1]) << 8) |
			(cast(uint32, data[off + 2]) << 16) | (cast(uint32, data[off + 3]) << 24)
	w = w + v
	data[off] = cast(uint8, w & 0xFF)
	data[off + 1] = cast(uint8, (w >> 8) & 0xFF)
	data[off + 2] = cast(uint8, (w >> 16) & 0xFF)
	data[off + 3] = cast(uint8, w >> 24)
}
