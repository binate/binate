package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/bootstrap"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

// Test writing a simple AArch64 ELF object file and verify the header.
func TestWriteSimpleElf() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_elf_test.o"
	var ok bool = WriteAArch64(a, path)
	if !ok { return fail("failed to write ELF") }

	// Read the file back and verify ELF magic
	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return fail("cannot open ELF file") }
	var hdr @[]uint8 = make_slice(uint8, 64)
	var raw *[]uint8 = hdr
	var n int = bootstrap.Read(fd, raw)
	bootstrap.Close(fd)
	if n < 64 { return fail("ELF file too small") }

	// ELF magic: 7f 45 4c 46
	if hdr[0] != 0x7f { return fail("bad magic[0]") }
	if hdr[1] != 0x45 { return fail("bad magic[1]") }
	if hdr[2] != 0x4c { return fail("bad magic[2]") }
	if hdr[3] != 0x46 { return fail("bad magic[3]") }

	// Class: 64-bit
	if hdr[4] != 2 { return fail("expected ELFCLASS64") }
	// Data: little-endian
	if hdr[5] != 1 { return fail("expected ELFDATA2LSB") }
	// Type: ET_REL = 1 (at offset 16, little-endian uint16)
	if hdr[16] != 1 || hdr[17] != 0 { return fail("expected ET_REL") }
	// Machine: EM_AARCH64 = 183 = 0xB7 (at offset 18)
	if hdr[18] != 0xB7 || hdr[19] != 0 { return fail("expected EM_AARCH64") }

	return ""
}

// Test ELF with multiple sections.
func TestWriteMultiSection() testing.TestResult {
	var a @asm.Assembler = asm.New(8)

	a.SetSection("text", -1)
	a.DefineLabel("func1")
	a.SetGlobal("func1")
	aarch64.Nop(a)
	aarch64.Ret(a)

	a.SetSection("data", -1)
	a.EmitUint32(0xDEADBEEF)

	a.SetSection("rodata", -1)
	a.EmitAsciz("hello")

	aarch64.ResolveFixups(a)
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_multi.o"
	var ok bool = WriteAArch64(a, path)
	if !ok { return fail("failed to write ELF") }

	// Verify file exists and has reasonable size
	if bootstrap.Stat(path) != 1 { return fail("ELF file not found") }
	return ""
}

// Test ELF with relocations.
func TestWriteElfReloc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("external")
	aarch64.Bl(a, "external")
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("assembler error") }
	if a.NumRelocs != 1 { return fail("expected 1 relocation") }

	var path *[]readonly char = "/tmp/binate_elf_reloc.o"
	var ok bool = WriteAArch64(a, path)
	if !ok { return fail("failed to write ELF") }

	if bootstrap.Stat(path) != 1 { return fail("ELF file not found") }
	return ""
}

// elfRelocAddend must subtract 4 for x86-64 PC32 (the CALL/JMP/Jcc rel32
// and RIP-relative LEA disp32 are next-instruction-relative) and leave
// every other relocation untouched.  Regression guard: a 0 addend lands
// each cross-object call at symbol+4, skipping the callee's 4-byte
// `push %rbp; mov %rsp,%rbp` prologue → frame corruption → SIGSEGV, which
// crashed native_x64-ELF on any program making a cross-package call.
func TestElfRelocAddendPC32() testing.TestResult {
	if elfRelocAddend(R_X86_64_PC32, EM_X86_64, 0) != -4 {
		return fail("x86-64 PC32 addend must be -4")
	}
	if elfRelocAddend(R_X86_64_PC32, EM_X86_64, 8) != 4 {
		return fail("x86-64 PC32 must carry rawAddend then subtract 4")
	}
	if elfRelocAddend(R_X86_64_64, EM_X86_64, 0) != 0 {
		return fail("x86-64 absolute (R_X86_64_64) addend must be unchanged")
	}
	if elfRelocAddend(R_AARCH64_JUMP26, EM_AARCH64, 0) != 0 {
		return fail("aarch64 branch addend must be unchanged")
	}
	return ""
}

// Test x86-64 ELF header.
func TestWriteX86Elf() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// Just emit some bytes (no real x86 instructions, just testing the header)
	a.EmitUint8(0xC3)  // ret
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_x86.o"
	var ok bool = WriteX86_64(a, path)
	if !ok { return fail("failed to write ELF") }

	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return fail("cannot open ELF file") }
	var hdr @[]uint8 = make_slice(uint8, 64)
	var raw *[]uint8 = hdr
	bootstrap.Read(fd, raw)
	bootstrap.Close(fd)

	// Machine: EM_X86_64 = 62 = 0x3E
	if hdr[18] != 0x3E || hdr[19] != 0 { return fail("expected EM_X86_64") }
	// e_shnum (offset 60) must count: null + text + symtab + strtab +
	// shstrtab + .note.GNU-stack = 6.  The .note.GNU-stack is the guard
	// here — without it the count is 5 and ld marks the stack executable.
	var shnum int = cast(int, hdr[60]) | (cast(int, hdr[61]) << 8)
	if shnum != 6 { return fail("expected 6 sections incl .note.GNU-stack") }
	return ""
}

// Test ARM32 ELF32 header.
func TestWriteArm32Elf() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	// Emit a NOP (MOV R0, R0 = 0xE1A00000)
	a.EmitUint32(0xE1A00000)
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_arm32.o"
	var ok bool = WriteARM32(a, path)
	if !ok { return fail("failed to write ARM32 ELF") }

	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return fail("cannot open ELF file") }
	var hdr @[]uint8 = make_slice(uint8, 52)
	var raw *[]uint8 = hdr
	bootstrap.Read(fd, raw)
	bootstrap.Close(fd)

	// Magic
	if hdr[0] != 0x7f || hdr[1] != 0x45 {
		return fail("bad magic")
	}
	// Class: 32-bit (ELFCLASS32 = 1)
	if hdr[4] != 1 { return fail("expected ELFCLASS32") }
	// Data: little-endian
	if hdr[5] != 1 { return fail("expected ELFDATA2LSB") }
	// Type: ET_REL = 1
	if hdr[16] != 1 || hdr[17] != 0 { return fail("expected ET_REL") }
	// Machine: EM_ARM = 40 = 0x28
	if hdr[18] != 0x28 || hdr[19] != 0 {
		return fail("expected EM_ARM")
	}
	// e_ehsize at offset 40 (ELF32) should be 52
	if hdr[40] != 52 || hdr[41] != 0 {
		return fail("expected e_ehsize=52")
	}
	// e_shentsize at offset 46 should be 40
	if hdr[46] != 40 || hdr[47] != 0 {
		return fail("expected e_shentsize=40")
	}
	return ""
}

// --- ARM32 semihosting end-to-end tests ---
// These assemble ARM32 code, link as bare-metal ELF32, and run under
// qemu-system-arm with semihosting. The semihosting ABI lets us exit
// with a specific code (SYS_EXIT_EXTENDED) without needing a Linux
// userspace or syscall forwarding.

func canRunArm32Semihosting() bool {
	// Check for qemu-system-arm
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = "--version"
	var exit int = bootstrap.Exec("qemu-system-arm", args)
	if exit != 0 { return false }
	// Check for arm-none-eabi-ld
	var args2 @[]@[]char = make_slice(@[]char, 1)
	args2[0] = "--version"
	var exit2 int = bootstrap.Exec("arm-none-eabi-ld", args2)
	return exit2 == 0
}

// writeLinkerScript writes a minimal bare-metal linker script for the
// ARM virt machine (RAM at 0x40000000).
func writeLinkerScript(path *[]readonly char) bool {
	var fd int = bootstrap.Open(path,
		bootstrap.O_WRONLY | bootstrap.O_CREATE | bootstrap.O_TRUNC)
	if fd < 0 { return false }
	bootstrap.Write(fd,
		"ENTRY(_start)\n"
		"SECTIONS {\n"
		"    . = 0x40000000;\n"
		"    .text : { *(.text) }\n"
		"    .data : { *(.data) }\n"
		"}\n")
	bootstrap.Close(fd)
	return true
}

// linkArm32 links an ARM32 ELF object into a bare-metal executable.
func linkArm32(objPath *[]readonly char, elfPath *[]readonly char, ldScript *[]readonly char) bool {
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-T"
	args[1] = buf.CopyStr(ldScript)
	args[2] = "-o"
	args[3] = buf.CopyStr(elfPath)
	args[4] = buf.CopyStr(objPath)
	var exit int = bootstrap.Exec("arm-none-eabi-ld", args)
	return exit == 0
}

// runArm32Semihosting runs a bare-metal ELF under QEMU with semihosting.
func runArm32Semihosting(elfPath *[]readonly char) int {
	var args @[]@[]char = make_slice(@[]char, 8)
	args[0] = "-M"
	args[1] = "virt"
	args[2] = "-cpu"
	args[3] = "cortex-a15"
	args[4] = "-semihosting"
	args[5] = "-nographic"
	args[6] = "-kernel"
	args[7] = buf.CopyStr(elfPath)
	return bootstrap.Exec("qemu-system-arm", args)
}

// semiExit emits ARM32 semihosting SYS_EXIT_EXTENDED with a given
// exit code. Uses movw/movt to build the address of the exit block
// in the data section. The caller must define "exit_block" as a label
// in the data section containing {0x20026, exitCode}.
func semiExit(a @asm.Assembler, exitBlockLabel *[]readonly char) {
	// mov r0, #0x20 (SYS_EXIT_EXTENDED)
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0x20))
	// Load exit_block address via label fixup
	// For now, use a simple approach: emit the address in a literal
	// after the svc and load it PC-relative.
	// Actually: we can use the label mechanism with LDR.
	arm32.Ldr(a, arm32.COND_AL, arm32.R1, arm32.Label(exitBlockLabel))
	// svc #0x123456
	arm32.Svc(a, arm32.COND_AL, 0x123456)
}

// emitExitBlock emits a semihosting exit block in the data section:
// {ADP_Stopped_ApplicationExit (0x20026), exitCode}.
func emitExitBlock(a @asm.Assembler, label *[]readonly char, exitCode int) {
	a.DefineLabel(label)
	// 0x20026 = ADP_Stopped_ApplicationExit
	a.EmitUint32(0x00020026)
	a.EmitUint32(cast(uint32, exitCode))
}

// Test: exit with code 42 via semihosting.
func TestArm32SemihostingExit() testing.TestResult {
	if !canRunArm32Semihosting() { return "" }

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// mov r0, #0x20 (SYS_EXIT_EXTENDED)
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0x20))
	// movw r1, #low16(exit_block)  — filled by linker via relocation
	// movt r1, #high16(exit_block) — filled by linker via relocation
	// For now, build the address manually with known data layout.
	// Data section follows text. text = _start + 3 instrs + literal
	// This is fragile; instead use movw/movt with known address.
	// The virt machine loads at 0x40000000. Our text is small, data
	// follows immediately. Let's place the exit block right after the
	// code using .data section and use movw/movt with the address.
	// Actually, the simplest approach: put the exit block in .text
	// right after the svc, and use a PC-relative offset.
	// Simplest: use inline data after a branch-to-self.

	// Let's just build a flat binary with data after code:
	// _start:
	//   mov r0, #0x20
	//   ldr r1, [pc, #4]    ; load address from literal pool
	//   svc #0x123456
	//   b .                  ; halt
	//   .word exit_block     ; literal pool
	// exit_block:
	//   .word 0x20026
	//   .word 42
	//
	// PC-relative: at the ldr, PC = addr+8, offset=4, loads from addr+12
	// That's right after the b instruction at addr+12.

	// Emit ldr r1, [pc, #4]
	arm32.Ldr(a, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.PC, 4))
	arm32.Svc(a, arm32.COND_AL, 0x123456)
	// b . (infinite loop as safety)
	a.DefineLabel("halt")
	arm32.B(a, arm32.COND_AL, "halt")
	// Literal pool: address of exit_block (filled at link time)
	a.EmitAddr("exit_block")

	// Exit block (in same section for simplicity)
	a.DefineLabel("exit_block")
	a.EmitUint32(0x00020026)
	a.EmitUint32(42)

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }

	var objPath *[]readonly char = "/tmp/binate_arm32_semi.o"
	if !WriteARM32(a, objPath) { return fail("write ELF failed") }

	var ldScript *[]readonly char = "/tmp/binate_arm32.ld"
	if !writeLinkerScript(ldScript) { return fail("write ld script failed") }

	var elfPath *[]readonly char = "/tmp/binate_arm32_semi.elf"
	if !linkArm32(objPath, elfPath, ldScript) {
		return fail("link failed")
	}

	var exitCode int = runArm32Semihosting(elfPath)
	if exitCode != 42 { return fail("expected exit code 42") }
	return ""
}

// emitSemiExit emits the semihosting exit sequence. The exit block
// must immediately follow this code (label + 2 words of data).
// blockLabel is the label for the exit block.
func emitSemiExit(a @asm.Assembler, blockLabel *[]readonly char) {
	// mov r0, #0x20 (SYS_EXIT_EXTENDED)
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0x20))
	// ldr r1, [pc, #4] — load exit_block address from literal pool
	arm32.Ldr(a, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.PC, 4))
	// svc #0x123456
	arm32.Svc(a, arm32.COND_AL, 0x123456)
	// b . (safety halt)
	a.DefineLabel("halt_safety")
	arm32.B(a, arm32.COND_AL, "halt_safety")
	// Literal pool: address of exit_block (resolved by linker)
	a.EmitAddr(blockLabel)
}

// emitSemiExitDynamic emits the semihosting exit sequence where r0
// already contains the exit code. Writes r0 into the exit block and
// exits. blockLabel is the label for the exit block. Uses r3 as
// scratch.
func emitSemiExitDynamic(a @asm.Assembler, blockLabel *[]readonly char,
		haltLabel *[]readonly char) {
	// ldr r3, [pc, #16] — load exit_block address
	// str r0, [r3, #4]  — store exit code into block
	// mov r0, #0x20
	// mov r1, r3
	// svc #0x123456
	// b .
	// .word exit_block
	arm32.Ldr(a, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.PC, 16))
	arm32.Str(a, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R3, 4))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0x20))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(arm32.R3))
	arm32.Svc(a, arm32.COND_AL, 0x123456)
	a.DefineLabel(haltLabel)
	arm32.B(a, arm32.COND_AL, haltLabel)
	a.EmitAddr(blockLabel)
}

// Test: loop summing 1..9, exit with result (45).
func TestArm32SemihostingLoop() testing.TestResult {
	if !canRunArm32Semihosting() { return "" }

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// r0 = sum = 0, r1 = i = 1, r2 = limit = 10
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Imm(1))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R2, arm32.Imm(10))

	// loop: sum += i; i++; if i != limit goto loop
	a.DefineLabel("loop")
	arm32.Add(a, arm32.COND_AL, false, arm32.R0, arm32.R0, arm32.Reg(arm32.R1))
	arm32.Add(a, arm32.COND_AL, false, arm32.R1, arm32.R1, arm32.Imm(1))
	arm32.Cmp(a, arm32.COND_AL, arm32.R1, arm32.Reg(arm32.R2))
	arm32.B(a, arm32.COND_NE, "loop")

	// Exit with sum in r0
	emitSemiExitDynamic(a, "exit_block2", "halt2")

	a.DefineLabel("exit_block2")
	a.EmitUint32(0x00020026)
	a.EmitUint32(0)  // placeholder, overwritten by str

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }

	var objPath *[]readonly char = "/tmp/binate_arm32_loop.o"
	if !WriteARM32(a, objPath) { return fail("write failed") }

	var ldScript *[]readonly char = "/tmp/binate_arm32.ld"
	writeLinkerScript(ldScript)

	var elfPath *[]readonly char = "/tmp/binate_arm32_loop.elf"
	if !linkArm32(objPath, elfPath, ldScript) {
		return fail("link failed")
	}

	var exitCode int = runArm32Semihosting(elfPath)
	if exitCode != 45 { return fail("expected exit code 45 (sum 1..9)") }
	return ""
}

// Test: function call with PUSH/POP prologue/epilogue.
func TestArm32SemihostingCall() testing.TestResult {
	if !canRunArm32Semihosting() { return "" }

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// Set up stack pointer (virt machine RAM at 0x40000000, use top of 1MB)
	arm32.Movw(a, arm32.COND_AL, arm32.SP, 0x0000)
	arm32.Movt(a, arm32.COND_AL, arm32.SP, 0x4010)

	// Call add_five(37) -> should return 42 in r0
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(37))
	arm32.Bl(a, arm32.COND_AL, "add_five")

	// Exit with result in r0
	emitSemiExitDynamic(a, "exit_block3", "halt3")

	// add_five: push {lr}; add r0, r0, #5; pop {pc}
	a.DefineLabel("add_five")
	var lrMask int = 1 << 14
	var pcMask int = 1 << 15
	arm32.Push(a, arm32.COND_AL, lrMask)
	arm32.Add(a, arm32.COND_AL, false, arm32.R0, arm32.R0, arm32.Imm(5))
	arm32.Pop(a, arm32.COND_AL, pcMask)

	// Exit block
	a.DefineLabel("exit_block3")
	a.EmitUint32(0x00020026)
	a.EmitUint32(0)

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }

	var objPath *[]readonly char = "/tmp/binate_arm32_call.o"
	if !WriteARM32(a, objPath) { return fail("write failed") }

	var ldScript *[]readonly char = "/tmp/binate_arm32.ld"
	writeLinkerScript(ldScript)

	var elfPath *[]readonly char = "/tmp/binate_arm32_call.elf"
	if !linkArm32(objPath, elfPath, ldScript) {
		return fail("link failed")
	}

	var exitCode int = runArm32Semihosting(elfPath)
	if exitCode != 42 {
		return fail("expected exit code 42 (37+5)")
	}
	return ""
}

// If on Linux, test linking and running an ELF binary.
func canLinkElf() bool {
	// Check if we're on Linux by trying to run 'readelf'
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = "--version"
	var exit int = bootstrap.Exec("readelf", args)
	if exit != 0 { return false }
	// Check we're on AArch64 (the test uses AArch64 syscalls)
	var args2 @[]@[]char = make_slice(@[]char, 1)
	args2[0] = "-m"
	var exit2 int = bootstrap.Exec("uname", args2)
	// uname -m always succeeds on Linux, but we can't easily read its output.
	// Instead, try a test link: assemble a minimal AArch64 object and link it.
	// If we're on x86-64, the linker will reject the AArch64 object.
	return canLinkAArch64Elf()
}

func canLinkAArch64Elf() bool {
	// Write a minimal AArch64 ELF object and try to link it
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Movz(a, true, aarch64.X0, 0, 0)
	aarch64.Svc(a, 0)
	aarch64.ResolveFixups(a)
	a.Finalize()

	var objPath *[]readonly char = "/tmp/binate_elf_probe.o"
	if !WriteAArch64(a, objPath) { return false }

	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = "/tmp/binate_elf_probe"
	args[4] = buf.CopyStr(objPath)
	var exit int = bootstrap.Exec("cc", args)
	return exit == 0
}

func TestElfLinkAndRun() testing.TestResult {
	if !canLinkElf() { return "" }  // skip on non-Linux

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	a.DefineLabel("_start")
	a.SetGlobal("_start")
	// exit(42) via syscall on Linux/AArch64:
	// mov x8, #93   (SYS_exit)
	// mov x0, #42
	// svc #0
	aarch64.Movz(a, true, aarch64.X8, 93, 0)
	aarch64.Movz(a, true, aarch64.X0, 42, 0)
	aarch64.Svc(a, 0)

	aarch64.ResolveFixups(a)
	a.Finalize()

	var objPath *[]readonly char = "/tmp/binate_elf_run.o"
	if !WriteAArch64(a, objPath) { return fail("write failed") }

	// Link as static executable
	var exePath *[]readonly char = "/tmp/binate_elf_run"
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	var exit int = bootstrap.Exec("cc", args)
	if exit != 0 { return fail("linking failed") }

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var exitCode int = bootstrap.Exec(exePath, runArgs)
	if exitCode != 42 { return fail("expected exit code 42") }
	return ""
}

// --- x86-64 native end-to-end tests on Linux ---
// Assemble x86-64 -> ELF64 -> link with cc -nostdlib -static -> run
// directly. No QEMU or semihosting needed: the ELF runs on the host
// kernel via SYSCALL. Tests only run on Linux/x86-64 (probe below).

// canLinkX86_64Elf detects whether the host can link and run an x86-64
// ELF (i.e., we are on Linux/x86-64). Probes by assembling exit(0) and
// running it; returns true only if both link and exec succeed.
func canLinkX86_64Elf() bool {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	// mov rax, 60 ; mov rdi, 0 ; syscall  (exit(0))
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(0))
	x64.Syscall(a)
	x64.ResolveFixups(a)
	a.Finalize()

	var objPath *[]readonly char = "/tmp/binate_x64_probe.o"
	if !WriteX86_64(a, objPath) { return false }

	var exePath *[]readonly char = "/tmp/binate_x64_probe"
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	if bootstrap.Exec("cc", args) != 0 { return false }

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	return bootstrap.Exec(exePath, runArgs) == 0
}

// linkAndRunX64 writes obj, links with cc -nostdlib -static, runs the
// result, and returns its exit code (or -1 on link failure).
func linkAndRunX64(a @asm.Assembler, objPath *[]readonly char, exePath *[]readonly char) int {
	if !WriteX86_64(a, objPath) { return -1 }
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	if bootstrap.Exec("cc", args) != 0 { return -1 }
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	return bootstrap.Exec(exePath, runArgs)
}

// TestX86_64ElfExit: exit(42) via SYSCALL.
//   mov rax, 60   ; SYS_exit
//   mov rdi, 42
//   syscall
func TestX86_64ElfExit() testing.TestResult {
	if !canLinkX86_64Elf() { return "" }  // skip on non-Linux/x86-64
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(42))
	x64.Syscall(a)
	x64.ResolveFixups(a)
	a.Finalize()
	var rc int = linkAndRunX64(a, "/tmp/binate_x64_exit.o", "/tmp/binate_x64_exit")
	if rc != 42 { return fail("expected exit code 42") }
	return ""
}

// TestX86_64ElfLoop: sum 1..9 = 45, exit with that value.
//   xor rbx, rbx          ; sum = 0
//   mov rcx, 1            ; i = 1
// loop_top:
//   cmp rcx, 10
//   jge loop_end
//   add rbx, rcx
//   inc rcx
//   jmp loop_top
// loop_end:
//   mov rax, 60
//   mov rdi, rbx          ; (use mov rdi, rbx via Mov reg,reg)
//   syscall
func TestX86_64ElfLoop() testing.TestResult {
	if !canLinkX86_64Elf() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Xor(a, x64.Reg(x64.RBX, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RCX, x64.SZ64), x64.Imm(1))
	a.DefineLabel("loop_top")
	x64.Cmp(a, x64.Reg(x64.RCX, x64.SZ64), x64.Imm(10))
	x64.Jcc(a, x64.CC_GE, "loop_end")
	x64.Add(a, x64.Reg(x64.RBX, x64.SZ64), x64.Reg(x64.RCX, x64.SZ64))
	x64.Inc(a, x64.Reg(x64.RCX, x64.SZ64))
	x64.Jmp(a, "loop_top")
	a.DefineLabel("loop_end")
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64))
	x64.Syscall(a)
	x64.ResolveFixups(a)
	a.Finalize()
	var rc int = linkAndRunX64(a, "/tmp/binate_x64_loop.o", "/tmp/binate_x64_loop")
	if rc != 45 { return fail("expected exit code 45") }
	return ""
}

// TestX86_64ElfCall: function call exercising PUSH/POP for callee-save
// register preservation. The callee adds 5 to rdi and returns it.
//   _start:
//     mov rdi, 37
//     call add5
//     mov rax, 60
//     syscall            ; exit(rdi) — rdi holds the return value
//   add5:                ; takes rdi, returns updated rdi
//     push rbx           ; demonstrate PUSH/POP
//     mov rbx, 5
//     add rdi, rbx
//     pop rbx
//     ret
func TestX86_64ElfCall() testing.TestResult {
	if !canLinkX86_64Elf() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(37))
	x64.Call(a, "add5")
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Syscall(a)
	a.DefineLabel("add5")
	x64.Push(a, x64.Reg(x64.RBX, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBX, x64.SZ64), x64.Imm(5))
	x64.Add(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64))
	x64.Pop(a, x64.Reg(x64.RBX, x64.SZ64))
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	var rc int = linkAndRunX64(a, "/tmp/binate_x64_call.o", "/tmp/binate_x64_call")
	if rc != 42 { return fail("expected exit code 42 (37+5)") }
	return ""
}

// Little-endian readers over a raw object-file byte buffer (for parsing the
// emitted ELF back in TestWriteElfX64RelocPltVsPc).
func rdU16(b *[]uint8, off int) int {
	return cast(int, b[off]) | (cast(int, b[off+1]) << 8)
}
func rdU32(b *[]uint8, off int) int {
	var v int = 0
	for i := 0; i < 4; i++ { v = v | (cast(int, b[off+i]) << cast(uint, 8*i)) }
	return v
}
func rdU64(b *[]uint8, off int) int {
	var v int = 0
	for i := 0; i < 8; i++ { v = v | (cast(int, b[off+i]) << cast(uint, 8*i)) }
	return v
}

// End-to-end: a CALL to an UNDEFINED (extern) symbol must be emitted as
// R_X86_64_PLT32, a CALL to a DEFINED (same-object) symbol as R_X86_64_PC32.
// This exercises the actual reloc-emission call site (elf.bn computes
// `symUndef = a.Symbols[rel.Symbol].Section < 0` and feeds it to
// elfRelocType) — the isolated elfRelocType tests can't catch a regression
// in that wiring (wrong symbol index, inverted comparison, predicate read
// after the symtab sort).  PC32 against an undefined symbol is what a PIE
// link rejects, so this is the property that keeps the native_x64 C-interop
// mode linkable.
// A DEFINED-WEAK call must also be PC32 (st_shndx is its defining section, not
// SHN_UNDEF — only Section<0 picks PLT32).  This is the actual shipping shape:
// generic instantiations + dtor/copy helpers are DefineLabel'd then SetWeak'd
// (IsLinkOnce) and called directly, so a regression that treated BIND_WEAK as
// undefined for reloc purposes would mis-emit PLT32 and surface only in the
// Linux PIE link — this pins it at the object level.
func TestWriteElfX64RelocPltVsPc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("ext")          // declared but never defined -> undefined
	x64.Call(a, "callee")       // defined strong, same object -> PC32
	x64.Call(a, "ext")          // undefined -> PLT32
	x64.Call(a, "wcallee")      // defined WEAK, same object -> PC32
	x64.Ret(a)
	a.DefineLabel("callee")
	a.SetGlobal("callee")
	x64.Ret(a)
	a.DefineLabel("wcallee")
	a.SetWeak("wcallee")        // defined + weak (the instantiation/dtor shape)
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_elf_x64_plt.o"
	if !WriteX86_64(a, path) { return fail("failed to write ELF") }

	var fd int = bootstrap.Open(path, bootstrap.O_RDONLY)
	if fd < 0 { return fail("cannot open ELF file") }
	var bufv @[]uint8 = make_slice(uint8, 16384)
	var raw *[]uint8 = bufv
	var n int = bootstrap.Read(fd, raw)
	bootstrap.Close(fd)
	if n < 200 { return fail("ELF file too small") }

	// Locate the .rela.text (SHT_RELA) and .symtab (SHT_SYMTAB) sections.
	var shoff int = rdU64(raw, 40)
	var shentsize int = rdU16(raw, 58)
	var shnum int = rdU16(raw, 60)
	var relaOff int = -1
	var relaSize int = 0
	var symOff int = -1
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var stype int = rdU32(raw, sh + 4)
		if stype == cast(int, SHT_RELA) {
			relaOff = rdU64(raw, sh + 24)
			relaSize = rdU64(raw, sh + 32)
		}
		if stype == cast(int, SHT_SYMTAB) {
			symOff = rdU64(raw, sh + 24)
		}
	}
	if relaOff < 0 { return fail("no SHT_RELA section") }
	if symOff < 0 { return fail("no SHT_SYMTAB section") }

	// Each Elf64_Rela is 24 bytes (r_offset, r_info, r_addend); each Elf64_Sym
	// is 24 bytes with st_info at offset 4 (binding = st_info >> 4) and
	// st_shndx at offset 6.  Check every CALL reloc's type against its target
	// symbol's definedness AND binding.
	var sawUndefPlt bool = false
	var sawStrongDefPc bool = false
	var sawWeakDefPc bool = false
	var off int = 0
	for off < relaSize {
		var rinfo int = rdU64(raw, relaOff + off + 8)
		var rtype int = rinfo & 0xffffffff
		var symIdx int = (rinfo >> 32) & 0xffffffff
		// Every CALL reloc (PC32 and PLT32 alike) is field-relative, so its
		// r_addend (Elf64_Rela offset +16) is -4 — the type and addend are
		// pinned together here, in the actual emitted object, not just in the
		// isolated elfRelocAddend test.  A wrong addend silently corrupts the
		// call displacement (the prologue-corruption scenario it documents).
		var raddend int = rdU64(raw, relaOff + off + 16)
		if raddend != -4 {
			return fail("CALL reloc r_addend must be -4 (field-relative)")
		}
		var shndx int = rdU16(raw, symOff + symIdx * 24 + 6)
		var binding int = cast(int, raw[symOff + symIdx * 24 + 4]) >> 4
		if shndx == SHN_UNDEF {
			if rtype != R_X86_64_PLT32 {
				return fail("undefined-symbol CALL must be R_X86_64_PLT32")
			}
			sawUndefPlt = true
		} else {
			if rtype != R_X86_64_PC32 {
				return fail("defined-symbol CALL must be R_X86_64_PC32")
			}
			if binding == STB_WEAK {
				sawWeakDefPc = true
			} else {
				sawStrongDefPc = true
			}
		}
		off = off + 24
	}
	if !sawUndefPlt { return fail("no PLT32 reloc for the undefined call") }
	if !sawStrongDefPc { return fail("no PC32 reloc for the defined-strong call") }
	if !sawWeakDefPc {
		return fail("no PC32 reloc for the defined-WEAK call (instantiation/dtor shape)")
	}
	return ""
}
