package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

func fail(msg @[]char) testing.TestResult { return msg }

// Test writing a simple AArch64 ELF object file and verify the header.
func TestWriteSimpleElf() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(42))
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_elf_test.o"
	var ok bool = WriteAArch64(a, path)
	if !ok { return fail("failed to write ELF") }

	// Read the file back and verify ELF magic
	f, oerr := os.Open(path)
	if present(oerr) { return fail("cannot open ELF file") }
	var hdr @[]uint8 = make_slice(uint8, 64)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = hdr
	n, _ := f.Read(raw)
	_ = f.Close()
	if n < 64 { return fail("ELF file too small") }

	// ELF magic: 7f 45 4c 46
	if hdr[0] != 0x7f { return fail("bad magic[0]") }
	if hdr[1] != 0x45 { return fail("bad magic[1]") }
	if hdr[2] != 0x4c { return fail("bad magic[2]") }
	if hdr[3] != 0x46 { return fail("bad magic[3]") }

	// Class: 64-bit
	if hdr[4] != 2 { return fail("expected ELFCLASS64") }
	// Data: little-endian
	if hdr[5] != 1 { return fail("expected ELFDATA2LSB") }
	// Type: ET_REL = 1 (at offset 16, little-endian uint16)
	if hdr[16] != 1 || hdr[17] != 0 { return fail("expected ET_REL") }
	// Machine: EM_AARCH64 = 183 = 0xB7 (at offset 18)
	if hdr[18] != 0xB7 || hdr[19] != 0 { return fail("expected EM_AARCH64") }

	return ""
}

// Test ELF with multiple sections.
func TestWriteMultiSection() testing.TestResult {
	var a @asm.Assembler = asm.New(8)

	a.SetSection("text", -1)
	a.DefineLabel("func1")
	a.SetGlobal("func1")
	aarch64.Nop(a)
	aarch64.Ret(a)

	a.SetSection("data", -1)
	a.EmitUint32(0xDEADBEEF)

	a.SetSection("rodata", -1)
	a.EmitAsciz("hello")

	aarch64.ResolveFixups(a)
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_multi.o"
	var ok bool = WriteAArch64(a, path)
	if !ok { return fail("failed to write ELF") }

	// Verify file exists and has reasonable size
	elfFi, elfErr := os.Stat(path)
	if present(elfErr) || elfFi.IsDir() { return fail("ELF file not found") }
	return ""
}

// Direct test of the relro section mapping: a "rodata_relro" assembler
// section maps to the conventional ELF ".data.rel.ro" with
// SHF_ALLOC|SHF_WRITE (writable while the loader applies relocations,
// then re-protected read-only via PT_GNU_RELRO) and ordinary
// SHT_PROGBITS.  reloc-free "rodata" stays ".rodata" / SHF_ALLOC.
func TestElfRelroSectionMapping() testing.TestResult {
	if !charsEqual(elfSectName("rodata_relro"), ".data.rel.ro") {
		return fail("rodata_relro should map to .data.rel.ro")
	}
	if elfSectFlags("rodata_relro") != (SHF_ALLOC | SHF_WRITE) {
		return fail("rodata_relro flags should be ALLOC|WRITE")
	}
	if elfSectType("rodata_relro") != SHT_PROGBITS {
		return fail("rodata_relro should be SHT_PROGBITS")
	}
	if !charsEqual(elfSectName("rodata"), ".rodata") {
		return fail("rodata should map to .rodata")
	}
	if elfSectFlags("rodata") != SHF_ALLOC {
		return fail("reloc-free rodata flags should be ALLOC only")
	}
	// The relro section's relocation table is ".rela.data.rel.ro" (not the
	// raw-token ".rela.rodata_relro"); the RELA prefix is ".rela.<name>".
	if !charsEqual(relaSectName("rodata_relro", false), ".rela.data.rel.ro") {
		return fail("relro rela section should be .rela.data.rel.ro")
	}
	if !charsEqual(relaSectName("data", false), ".rela.data") {
		return fail("data rela section should be .rela.data")
	}
	// ARM uses the REL form, so the prefix is ".rel" (the section's sh_type
	// SHT_REL and 8-byte entries must agree — see elf.Write's useRel path).
	if !charsEqual(relaSectName("text", true), ".rel.text") {
		return fail("ARM (REL) text reloc section should be .rel.text")
	}
	if !charsEqual(relaSectName("rodata_relro", true), ".rel.data.rel.ro") {
		return fail("ARM (REL) relro reloc section should be .rel.data.rel.ro")
	}
	return ""
}

// Test ELF with relocations.
func TestWriteElfReloc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("external")
	aarch64.Bl(a, "external")
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	a.Finalize()

	if a.HasError { return fail("assembler error") }
	if a.NumRelocs != 1 { return fail("expected 1 relocation") }

	var path *[]readonly char = "/tmp/binate_elf_reloc.o"
	var ok bool = WriteAArch64(a, path)
	if !ok { return fail("failed to write ELF") }

	elfFi, elfErr := os.Stat(path)
	if present(elfErr) || elfFi.IsDir() { return fail("ELF file not found") }
	return ""
}

// elfRelocAddend must subtract 4 for x86-64 PC32 (the CALL/JMP/Jcc rel32
// and RIP-relative LEA disp32 are next-instruction-relative) and leave
// every other relocation untouched.  Regression guard: a 0 addend lands
// each cross-object call at symbol+4, skipping the callee's 4-byte
// `push %rbp; mov %rsp,%rbp` prologue → frame corruption → SIGSEGV, which
// crashed native_x64-ELF on any program making a cross-package call.
func TestElfRelocAddendPC32() testing.TestResult {
	if elfRelocAddend(R_X86_64_PC32, EM_X86_64, 0) != -4 {
		return fail("x86-64 PC32 addend must be -4")
	}
	if elfRelocAddend(R_X86_64_PC32, EM_X86_64, 8) != 4 {
		return fail("x86-64 PC32 must carry rawAddend then subtract 4")
	}
	if elfRelocAddend(R_X86_64_64, EM_X86_64, 0) != 0 {
		return fail("x86-64 absolute (R_X86_64_64) addend must be unchanged")
	}
	if elfRelocAddend(R_AARCH64_JUMP26, EM_AARCH64, 0) != 0 {
		return fail("aarch64 branch addend must be unchanged")
	}
	// GOTPCREL (mov r64, sym@GOTPCREL(%rip)) shares PC32's end-of-field
	// semantics, so its RELA addend takes the same -4 correction — else the
	// linker's S + GOT - P lands 4 bytes off and the load reads the wrong slot.
	if elfRelocAddend(R_X86_64_REX_GOTPCRELX, EM_X86_64, 0) != -4 {
		return fail("x86-64 GOTPCREL addend must be -4")
	}
	if elfRelocAddend(R_X86_64_REX_GOTPCRELX, EM_X86_64, 8) != 4 {
		return fail("x86-64 GOTPCREL must carry rawAddend then subtract 4")
	}
	return ""
}

// Emitting the aarch64 page-relative data (ADRP+ADD) and GOT-indirect (ADRP+
// LDR) sequences records fixups whose kinds map — via elfRelocType — to the
// real AArch64 ELF ABI data / GOT relocations, and WriteAArch64 SUCCEEDS (the
// -1 guard does not fire; every emitted kind is mapped).  End-to-end regression
// guard for the silent R_AARCH64_NONE miscompile: before the low-12 kinds were
// mapped, the ADD/LDR halves emitted reloc type 0 (a linker no-op) and every
// string literal / &global / __c_global address lost its low 12 bits.
func TestWriteElfAArch64DataAndGotRelocs() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	// Page-relative data address (ADRP+ADD) against a defined local symbol.
	a.DefineLabel("g")
	aarch64.Adrp(a, aarch64.X0, "g") // FIX_ADRP_HI21 (103)
	aarch64.AddImmLabel(a, true, aarch64.X0, aarch64.X0, "g") // FIX_ADD_LO12 (105)
	// GOT-indirect address (ADRP+LDR) against an external symbol.
	a.SetGlobal("ext")
	aarch64.AdrpGot(a, aarch64.X1, "ext") // FIX_ADRP_GOT_HI21 (107)
	aarch64.LdrGotLo12(a, aarch64.X1, aarch64.X1, "ext") // FIX_LD_GOT_LO12 (108)
	aarch64.Ret(a)

	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	// Each emitted data/GOT fixup kind must resolve to the right AArch64 ELF
	// reloc (not R_AARCH64_NONE) — tie the emitter's kind to elfRelocType's type.
	var sawAdd bool = false
	var sawGotPage bool = false
	var sawGotLo12 bool = false
	for i := 0; i < a.NumRelocs; i++ {
		var k int = a.Relocs[i].Kind
		if k == 105 {
			if elfRelocType(k, EM_AARCH64, false) != R_AARCH64_ADD_ABS_LO12_NC {
				return fail("FIX_ADD_LO12 must map to R_AARCH64_ADD_ABS_LO12_NC")
			}
			sawAdd = true
		} else if k == 107 {
			if elfRelocType(k, EM_AARCH64, true) != R_AARCH64_ADR_GOT_PAGE {
				return fail("FIX_ADRP_GOT_HI21 must map to R_AARCH64_ADR_GOT_PAGE")
			}
			sawGotPage = true
		} else if k == 108 {
			if elfRelocType(k, EM_AARCH64, true) != R_AARCH64_LD64_GOT_LO12_NC {
				return fail("FIX_LD_GOT_LO12 must map to R_AARCH64_LD64_GOT_LO12_NC")
			}
			sawGotLo12 = true
		}
	}
	if !sawAdd { return fail("expected a FIX_ADD_LO12 relocation") }
	if !sawGotPage { return fail("expected a FIX_ADRP_GOT_HI21 relocation") }
	if !sawGotLo12 { return fail("expected a FIX_LD_GOT_LO12 relocation") }

	// The whole object must write — the -1 guard does NOT fire on mapped kinds.
	var path *[]readonly char = "/tmp/binate_elf_aa64_data_got.o"
	if !WriteAArch64(a, path) {
		return fail("WriteAArch64 must succeed for mapped aarch64 data/GOT kinds")
	}
	return ""
}

// Emitting the x64 GOT-indirect load (`mov r64, [rip + sym@GOTPCREL]`) records
// a FIX_GOTPCREL fixup that maps to R_X86_64_REX_GOTPCRELX, and WriteX86_64
// succeeds (the -1 guard does not fire).  The reloc must carry the -4
// end-of-field correction (elfRelocAddend) so the linker's S + GOT - P lands on
// the GOT slot, not 4 bytes past it.
func TestWriteElfX64GotPcRelReloc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("environ")
	x64.MovGotPcRel(a, x64.Reg(x64.RAX, x64.SZ64), "environ") // FIX_GOTPCREL (303)
	x64.Ret(a)

	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var sawGot bool = false
	for i := 0; i < a.NumRelocs; i++ {
		if a.Relocs[i].Kind == 303 {
			if elfRelocType(303, EM_X86_64, true) != R_X86_64_REX_GOTPCRELX {
				return fail("FIX_GOTPCREL must map to R_X86_64_REX_GOTPCRELX")
			}
			if elfRelocAddend(R_X86_64_REX_GOTPCRELX, EM_X86_64, 0) != -4 {
				return fail("GOTPCREL reloc must carry the -4 correction")
			}
			sawGot = true
		}
	}
	if !sawGot { return fail("expected a FIX_GOTPCREL relocation") }

	var path *[]readonly char = "/tmp/binate_elf_x64_gotpcrel.o"
	if !WriteX86_64(a, path) {
		return fail("WriteX86_64 must succeed for the mapped GOTPCREL kind")
	}
	return ""
}

// elf.Write must FAIL LOUD (SetError, return false) — never silently emit
// R_<arch>_NONE (reloc type 0, a linker no-op) — when a fixup kind has no ELF
// reloc encoding.  Uses a synthetic kind no backend emits (950) so elfRelocType
// returns -1 and the writer's guard fires.  Pins the fail-loud half of the fix.
func TestWriteElfUnmappedKindFailsLoud() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("ext")
	a.AddFixup("ext", 950, 0, 4) // synthetic unmapped fixup kind
	aarch64.Ret(a) // occupy the 4-byte slot the fixup covers

	a.Finalize()
	if a.HasError { return fail("Finalize should not error: ext is a known global") }

	var path *[]readonly char = "/tmp/binate_elf_unmapped_kind.o"
	if WriteAArch64(a, path) {
		return fail("WriteAArch64 must FAIL on an unmapped fixup kind, not emit NONE")
	}
	if !a.HasError { return fail("an unmapped fixup kind must set an assembler error") }
	return ""
}

// Test x86-64 ELF header.
func TestWriteX86Elf() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	// Just emit some bytes (no real x86 instructions, just testing the header)
	a.EmitUint8(0xC3) // ret
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_x86.o"
	var ok bool = WriteX86_64(a, path)
	if !ok { return fail("failed to write ELF") }

	f, oerr := os.Open(path)
	if present(oerr) { return fail("cannot open ELF file") }
	var hdr @[]uint8 = make_slice(uint8, 64)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = hdr
	_, _ = f.Read(raw)
	_ = f.Close()

	// Machine: EM_X86_64 = 62 = 0x3E
	if hdr[18] != 0x3E || hdr[19] != 0 { return fail("expected EM_X86_64") }
	// e_shnum (offset 60) must count: null + text + symtab + strtab +
	// shstrtab + .note.GNU-stack = 6.  The .note.GNU-stack is the guard
	// here — without it the count is 5 and ld marks the stack executable.
	var shnum int = cast(int, hdr[60]) | (cast(int, hdr[61]) << 8)
	if shnum != 6 { return fail("expected 6 sections incl .note.GNU-stack") }
	return ""
}

// Test ARM32 ELF32 header.
func TestWriteArm32Elf() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	// Emit a NOP (MOV R0, R0 = 0xE1A00000)
	a.EmitUint32(0xE1A00000)
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_arm32.o"
	var ok bool = WriteARM32(a, path, false)
	if !ok { return fail("failed to write ARM32 ELF") }

	f, oerr := os.Open(path)
	if present(oerr) { return fail("cannot open ELF file") }
	var hdr @[]uint8 = make_slice(uint8, 52)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = hdr
	_, _ = f.Read(raw)
	_ = f.Close()

	// Magic
	if hdr[0] != 0x7f || hdr[1] != 0x45 {
		return fail("bad magic")
	}
	// Class: 32-bit (ELFCLASS32 = 1)
	if hdr[4] != 1 { return fail("expected ELFCLASS32") }
	// Data: little-endian
	if hdr[5] != 1 { return fail("expected ELFDATA2LSB") }
	// Type: ET_REL = 1
	if hdr[16] != 1 || hdr[17] != 0 { return fail("expected ET_REL") }
	// Machine: EM_ARM = 40 = 0x28
	if hdr[18] != 0x28 || hdr[19] != 0 {
		return fail("expected EM_ARM")
	}
	// e_flags at offset 36 (ELF32), little-endian: every arm32 object carries
	// EF_ARM_EABI_VER5 = 0x05000000 (top byte 0x05 = EABI version 5, which is
	// what lets GNU ld merge the object).  The float ABI is NOT in e_flags — it
	// lives in .ARM.attributes — so soft and hard both read 0x05000000 here.
	if hdr[36] != 0x00 || hdr[37] != 0x00 || hdr[38] != 0x00 || hdr[39] != 0x05 {
		return fail("expected e_flags EABI-ver5 (0x05000000)")
	}
	// e_ehsize at offset 40 (ELF32) should be 52
	if hdr[40] != 52 || hdr[41] != 0 {
		return fail("expected e_ehsize=52")
	}
	// e_shentsize at offset 46 should be 40
	if hdr[46] != 40 || hdr[47] != 0 {
		return fail("expected e_shentsize=40")
	}
	return ""
}

// Hard-float (arm32-linux, AAPCS-VFP) keeps the same EABI-ver5 e_flags but adds
// a .ARM.attributes section declaring Tag_ABI_VFP_args = "VFP registers".  This
// verifies e_flags is unchanged AND that the attribute section's bytes are
// actually written to the object (the injection wiring, not just the builder).
func TestWriteArm32ElfHardFloat() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.EmitUint32(0xE1A00000) // NOP (MOV R0, R0)
	a.Finalize()

	var path *[]readonly char = "/tmp/binate_elf_arm32_hf.o"
	if !WriteARM32(a, path, true) { return fail("failed to write ARM32 ELF") }

	f, oerr := os.Open(path)
	if present(oerr) { return fail("cannot open ELF file") }
	// The object is tiny (one instruction); one Read of a generous buffer
	// captures the whole file, header through the trailing .ARM.attributes.
	var whole @[]uint8 = make_slice(uint8, 4096)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = whole
	nread, _ := f.Read(raw)
	_ = f.Close()

	// e_flags at offset 36 (ELF32), little-endian: EABI-ver5 (0x05000000) — same
	// as soft; the float ABI is carried in .ARM.attributes, not e_flags.
	if whole[36] != 0x00 || whole[37] != 0x00 || whole[38] != 0x00 || whole[39] != 0x05 {
		return fail("expected e_flags EABI-ver5 (0x05000000)")
	}
	// The .ARM.attributes section content must be present in the file.
	if !containsBytes(whole, nread, buildArmAttributesHard()) {
		return fail("hard-float object must contain the .ARM.attributes VFP-args declaration")
	}
	return ""
}

// containsBytes reports whether needle occurs as a contiguous subsequence within
// the first hayLen bytes of hay.
func containsBytes(hay @[]uint8, hayLen int, needle @[]uint8) bool {
	var n int = len(needle)
	if n == 0 { return true }
	for i := 0; i + n <= hayLen; i++ {
		var match bool = true
		for j := 0; j < n; j++ {
			if hay[i + j] != needle[j] {
				match = false
				break
			}
		}
		if match { return true }
	}
	return false
}

// --- ARM32 semihosting end-to-end tests ---
// These assemble ARM32 code, link as bare-metal ELF32, and run under
// qemu-system-arm with semihosting. The semihosting ABI lets us exit
// with a specific code (SYS_EXIT_EXTENDED) without needing a Linux
// userspace or syscall forwarding.

func canRunArm32Semihosting() bool {
	// Check for qemu-system-arm
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = "--version"
	var exit int = execExit("qemu-system-arm", args)
	if exit != 0 { return false }
	// Check for arm-none-eabi-ld
	var args2 @[]@[]char = make_slice(@[]char, 1)
	args2[0] = "--version"
	var exit2 int = execExit("arm-none-eabi-ld", args2)
	return exit2 == 0
}

// writeLinkerScript writes a minimal bare-metal linker script for the
// ARM virt machine (RAM at 0x40000000).
func writeLinkerScript(path *[]readonly char) bool {
	f, oerr := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(oerr) { return false }
	_, _ = f.Write(
			"ENTRY(_start)\n"
					"SECTIONS {\n"
					"    . = 0x40000000;\n"
					"    .text : { *(.text) }\n"
					"    .data : { *(.data) }\n"
					"}\n")
	_ = f.Close()
	return true
}

// linkArm32 links an ARM32 ELF object into a bare-metal executable.
func linkArm32(objPath *[]readonly char, elfPath *[]readonly char, ldScript *[]readonly char) bool {
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-T"
	args[1] = buf.CopyStr(ldScript)
	args[2] = "-o"
	args[3] = buf.CopyStr(elfPath)
	args[4] = buf.CopyStr(objPath)
	var exit int = execExit("arm-none-eabi-ld", args)
	return exit == 0
}

// runArm32Semihosting runs a bare-metal ELF under QEMU with semihosting.
func runArm32Semihosting(elfPath *[]readonly char) int {
	var args @[]@[]char = make_slice(@[]char, 8)
	args[0] = "-M"
	args[1] = "virt"
	args[2] = "-cpu"
	args[3] = "cortex-a15"
	args[4] = "-semihosting"
	args[5] = "-nographic"
	args[6] = "-kernel"
	args[7] = buf.CopyStr(elfPath)
	return execExit("qemu-system-arm", args)
}

// Test: exit with code 42 via semihosting.
func TestArm32SemihostingExit() testing.TestResult {
	if !canRunArm32Semihosting() { return "" }

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// mov r0, #0x20 (SYS_EXIT_EXTENDED)
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0x20))
	// movw r1, #low16(exit_block)  — filled by linker via relocation
	// movt r1, #high16(exit_block) — filled by linker via relocation
	// For now, build the address manually with known data layout.
	// Data section follows text. text = _start + 3 instrs + literal
	// This is fragile; instead use movw/movt with known address.
	// The virt machine loads at 0x40000000. Our text is small, data
	// follows immediately. Let's place the exit block right after the
	// code using .data section and use movw/movt with the address.
	// Actually, the simplest approach: put the exit block in .text
	// right after the svc, and use a PC-relative offset.
	// Simplest: use inline data after a branch-to-self.

	// Let's just build a flat binary with data after code:
	// _start:
	//   mov r0, #0x20
	//   ldr r1, [pc, #4]    ; load address from literal pool
	//   svc #0x123456
	//   b .                  ; halt
	//   .word exit_block     ; literal pool
	// exit_block:
	//   .word 0x20026
	//   .word 42
	//
	// PC-relative: at the ldr, PC = addr+8, offset=4, loads from addr+12
	// That's right after the b instruction at addr+12.

	// Emit ldr r1, [pc, #4]
	arm32.Ldr(a, arm32.COND_AL, arm32.R1, arm32.MemImm(arm32.PC, 4))
	arm32.Svc(a, arm32.COND_AL, 0x123456)
	// b . (infinite loop as safety)
	a.DefineLabel("halt")
	arm32.B(a, arm32.COND_AL, "halt")
	// Literal pool: address of exit_block (filled at link time)
	a.EmitAddr("exit_block")

	// Exit block (in same section for simplicity)
	a.DefineLabel("exit_block")
	a.EmitUint32(0x00020026)
	a.EmitUint32(42)

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }

	var objPath *[]readonly char = "/tmp/binate_arm32_semi.o"
	if !WriteARM32(a, objPath, false) { return fail("write ELF failed") }

	var ldScript *[]readonly char = "/tmp/binate_arm32.ld"
	if !writeLinkerScript(ldScript) { return fail("write ld script failed") }

	var elfPath *[]readonly char = "/tmp/binate_arm32_semi.elf"
	if !linkArm32(objPath, elfPath, ldScript) {
		return fail("link failed")
	}

	var exitCode int = runArm32Semihosting(elfPath)
	if exitCode != 42 { return fail("expected exit code 42") }
	return ""
}

// emitSemiExitDynamic emits the semihosting exit sequence where r0
// already contains the exit code. Writes r0 into the exit block and
// exits. blockLabel is the label for the exit block. Uses r3 as
// scratch.
func emitSemiExitDynamic(a @asm.Assembler, blockLabel *[]readonly char,
		haltLabel *[]readonly char) {
	// ldr r3, [pc, #16] — load exit_block address
	// str r0, [r3, #4]  — store exit code into block
	// mov r0, #0x20
	// mov r1, r3
	// svc #0x123456
	// b .
	// .word exit_block
	arm32.Ldr(a, arm32.COND_AL, arm32.R3, arm32.MemImm(arm32.PC, 16))
	arm32.Str(a, arm32.COND_AL, arm32.R0, arm32.MemImm(arm32.R3, 4))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0x20))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Reg(arm32.R3))
	arm32.Svc(a, arm32.COND_AL, 0x123456)
	a.DefineLabel(haltLabel)
	arm32.B(a, arm32.COND_AL, haltLabel)
	a.EmitAddr(blockLabel)
}

// Test: loop summing 1..9, exit with result (45).
func TestArm32SemihostingLoop() testing.TestResult {
	if !canRunArm32Semihosting() { return "" }

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// r0 = sum = 0, r1 = i = 1, r2 = limit = 10
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(0))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R1, arm32.Imm(1))
	arm32.Mov(a, arm32.COND_AL, false, arm32.R2, arm32.Imm(10))

	// loop: sum += i; i++; if i != limit goto loop
	a.DefineLabel("loop")
	arm32.Add(a, arm32.COND_AL, false, arm32.R0, arm32.R0, arm32.Reg(arm32.R1))
	arm32.Add(a, arm32.COND_AL, false, arm32.R1, arm32.R1, arm32.Imm(1))
	arm32.Cmp(a, arm32.COND_AL, arm32.R1, arm32.Reg(arm32.R2))
	arm32.B(a, arm32.COND_NE, "loop")

	// Exit with sum in r0
	emitSemiExitDynamic(a, "exit_block2", "halt2")

	a.DefineLabel("exit_block2")
	a.EmitUint32(0x00020026)
	a.EmitUint32(0) // placeholder, overwritten by str

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }

	var objPath *[]readonly char = "/tmp/binate_arm32_loop.o"
	if !WriteARM32(a, objPath, false) { return fail("write failed") }

	var ldScript *[]readonly char = "/tmp/binate_arm32.ld"
	writeLinkerScript(ldScript)

	var elfPath *[]readonly char = "/tmp/binate_arm32_loop.elf"
	if !linkArm32(objPath, elfPath, ldScript) {
		return fail("link failed")
	}

	var exitCode int = runArm32Semihosting(elfPath)
	if exitCode != 45 { return fail("expected exit code 45 (sum 1..9)") }
	return ""
}

// Test: function call with PUSH/POP prologue/epilogue.
func TestArm32SemihostingCall() testing.TestResult {
	if !canRunArm32Semihosting() { return "" }

	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// Set up stack pointer (virt machine RAM at 0x40000000, use top of 1MB)
	arm32.Movw(a, arm32.COND_AL, arm32.SP, 0x0000)
	arm32.Movt(a, arm32.COND_AL, arm32.SP, 0x4010)

	// Call add_five(37) -> should return 42 in r0
	arm32.Mov(a, arm32.COND_AL, false, arm32.R0, arm32.Imm(37))
	arm32.Bl(a, arm32.COND_AL, "add_five")

	// Exit with result in r0
	emitSemiExitDynamic(a, "exit_block3", "halt3")

	// add_five: push {lr}; add r0, r0, #5; pop {pc}
	a.DefineLabel("add_five")
	var lrMask int = 1 << 14
	var pcMask int = 1 << 15
	arm32.Push(a, arm32.COND_AL, lrMask)
	arm32.Add(a, arm32.COND_AL, false, arm32.R0, arm32.R0, arm32.Imm(5))
	arm32.Pop(a, arm32.COND_AL, pcMask)

	// Exit block
	a.DefineLabel("exit_block3")
	a.EmitUint32(0x00020026)
	a.EmitUint32(0)

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }

	var objPath *[]readonly char = "/tmp/binate_arm32_call.o"
	if !WriteARM32(a, objPath, false) { return fail("write failed") }

	var ldScript *[]readonly char = "/tmp/binate_arm32.ld"
	writeLinkerScript(ldScript)

	var elfPath *[]readonly char = "/tmp/binate_arm32_call.elf"
	if !linkArm32(objPath, elfPath, ldScript) {
		return fail("link failed")
	}

	var exitCode int = runArm32Semihosting(elfPath)
	if exitCode != 42 {
		return fail("expected exit code 42 (37+5)")
	}
	return ""
}

// If on Linux, test linking and running an ELF binary.
func canLinkElf() bool {
	// Check if we're on Linux by trying to run 'readelf'
	var args @[]@[]char = make_slice(@[]char, 1)
	args[0] = "--version"
	var exit int = execExit("readelf", args)
	if exit != 0 { return false }
	// Check we're on AArch64 (the test uses AArch64 syscalls)
	var args2 @[]@[]char = make_slice(@[]char, 1)
	args2[0] = "-m"
	_ = execExit("uname", args2)
	// uname -m always succeeds on Linux, but we can't easily read its output.
	// Instead, try a test link: assemble a minimal AArch64 object and link it.
	// If we're on x86-64, the linker will reject the AArch64 object.
	return canLinkAArch64Elf()
}

func canLinkAArch64Elf() bool {
	// Write a minimal AArch64 ELF object and try to link it
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	aarch64.Movz(a, true, aarch64.X0, 0, 0)
	aarch64.Svc(a, 0)
	aarch64.ResolveFixups(a)
	a.Finalize()

	var objPath *[]readonly char = "/tmp/binate_elf_probe.o"
	if !WriteAArch64(a, objPath) { return false }

	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = "/tmp/binate_elf_probe"
	args[4] = buf.CopyStr(objPath)
	var exit int = execExit("cc", args)
	return exit == 0
}

func TestElfLinkAndRun() testing.TestResult {
	if !canLinkElf() { return "" } // skip on non-Linux

	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)

	a.DefineLabel("_start")
	a.SetGlobal("_start")
	// exit(42) via syscall on Linux/AArch64:
	// mov x8, #93   (SYS_exit)
	// mov x0, #42
	// svc #0
	aarch64.Movz(a, true, aarch64.X8, 93, 0)
	aarch64.Movz(a, true, aarch64.X0, 42, 0)
	aarch64.Svc(a, 0)

	aarch64.ResolveFixups(a)
	a.Finalize()

	var objPath *[]readonly char = "/tmp/binate_elf_run.o"
	if !WriteAArch64(a, objPath) { return fail("write failed") }

	// Link as static executable
	var exePath *[]readonly char = "/tmp/binate_elf_run"
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	var exit int = execExit("cc", args)
	if exit != 0 { return fail("linking failed") }

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var exitCode int = execExit(exePath, runArgs)
	if exitCode != 42 { return fail("expected exit code 42") }
	return ""
}

// --- x86-64 native end-to-end tests on Linux ---
// Assemble x86-64 -> ELF64 -> link with cc -nostdlib -static -> run
// directly. No QEMU or semihosting needed: the ELF runs on the host
// kernel via SYSCALL. Tests only run on Linux/x86-64 (probe below).

// canLinkX86_64Elf detects whether the host can link and run an x86-64
// ELF (i.e., we are on Linux/x86-64). Probes by assembling exit(0) and
// running it; returns true only if both link and exec succeed.
func canLinkX86_64Elf() bool {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	// mov rax, 60 ; mov rdi, 0 ; syscall  (exit(0))
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(0))
	x64.Syscall(a)
	x64.ResolveFixups(a)
	a.Finalize()

	var objPath *[]readonly char = "/tmp/binate_x64_probe.o"
	if !WriteX86_64(a, objPath) { return false }

	var exePath *[]readonly char = "/tmp/binate_x64_probe"
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	if execExit("cc", args) != 0 { return false }

	var runArgs @[]@[]char = make_slice(@[]char, 0)
	return execExit(exePath, runArgs) == 0
}

// linkAndRunX64 writes obj, links with cc -nostdlib -static, runs the
// result, and returns its exit code (or -1 on link failure).
func linkAndRunX64(a @asm.Assembler, objPath *[]readonly char, exePath *[]readonly char) int {
	if !WriteX86_64(a, objPath) { return -1 }
	var args @[]@[]char = make_slice(@[]char, 5)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	if execExit("cc", args) != 0 { return -1 }
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	return execExit(exePath, runArgs)
}

// TestX86_64ElfExit: exit(42) via SYSCALL.
//   mov rax, 60   ; SYS_exit
//   mov rdi, 42
//   syscall
func TestX86_64ElfExit() testing.TestResult {
	if !canLinkX86_64Elf() { return "" } // skip on non-Linux/x86-64
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(42))
	x64.Syscall(a)
	x64.ResolveFixups(a)
	a.Finalize()
	var rc int = linkAndRunX64(a, "/tmp/binate_x64_exit.o", "/tmp/binate_x64_exit")
	if rc != 42 { return fail("expected exit code 42") }
	return ""
}

// #[c_export] mints a SECOND, unmangled symbol coincident with the mangled one
// at the function's entry (native emitFunc).
// This proves the ELF WRITER emits that coincident symbol as a defined global a
// real linker resolves: object 1 defines one function under BOTH `realadd` and
// the c_export-style alias `cexp_add` at the same offset; object 2's `_start`
// calls the ALIAS name (external), and the linked program runs it (37 + 5 = 42).
func TestX86_64ElfCExportCoincidentSymbol() testing.TestResult {
	if !canLinkX86_64Elf() { return "" } // skip on non-Linux/x86-64

	// Object 1: one function, two coincident global symbols at offset 0.
	var a1 @asm.Assembler = asm.New(8)
	a1.SetSection("text", -1)
	a1.DefineLabel("realadd")
	a1.SetGlobal("realadd")
	a1.DefineLabel("cexp_add") // coincident c_export-style second symbol (ELF: no _ prefix)
	a1.SetGlobal("cexp_add")
	x64.Lea(a1, x64.Reg(x64.RAX, x64.SZ32), x64.Mem(x64.RDI, 5, x64.SZ32))
	x64.Ret(a1)
	var mi int = a1.LookupSymbol("realadd")
	var ai int = a1.LookupSymbol("cexp_add")
	if mi < 0 || ai < 0 {
		return fail("both the mangled and c_export symbols must be defined")
	}
	if a1.Symbols[mi].Offset != a1.Symbols[ai].Offset {
		return fail("the c_export symbol must be coincident with the mangled one")
	}
	x64.ResolveFixups(a1)
	a1.Finalize()
	if a1.HasError { return fail(a1.ErrorMsg) }
	var obj1 *[]readonly char = "/tmp/binate_elf_cexp1.o"
	if !WriteX86_64(a1, obj1) { return fail("write obj1 failed") }

	// Object 2: _start calls the ALIAS name (external), exit(result).
	var a2 @asm.Assembler = asm.New(8)
	a2.SetSection("text", -1)
	a2.DefineLabel("_start")
	a2.SetGlobal("_start")
	a2.SetGlobal("cexp_add")
	x64.Mov(a2, x64.Reg(x64.RDI, x64.SZ32), x64.Imm(37))
	x64.Call(a2, "cexp_add")
	x64.Mov(a2, x64.Reg(x64.RDI, x64.SZ32), x64.Reg(x64.RAX, x64.SZ32))
	x64.Mov(a2, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Syscall(a2)
	x64.ResolveFixups(a2)
	a2.Finalize()
	if a2.HasError { return fail(a2.ErrorMsg) }
	// The call to the alias must be an EXTERNAL reference (a relocation the
	// linker resolves via obj1's coincident symbol), not intra-object — the
	// host-independent half of the coincident-symbol proof.
	if a2.NumRelocs != 1 {
		return fail("expected 1 external relocation to the alias in obj2")
	}
	var obj2 *[]readonly char = "/tmp/binate_elf_cexp2.o"
	if !WriteX86_64(a2, obj2) { return fail("write obj2 failed") }

	// Link both static + run — resolving the alias must reach the function.
	var exePath *[]readonly char = "/tmp/binate_elf_cexp"
	var args @[]@[]char = make_slice(@[]char, 6)
	args[0] = "-nostdlib"
	args[1] = "-static"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(obj1)
	args[5] = buf.CopyStr(obj2)
	if execExit("cc", args) != 0 { return fail("linking failed") }
	var runArgs @[]@[]char = make_slice(@[]char, 0)
	var exitCode int = execExit(exePath, runArgs)
	if exitCode != 42 {
		return fail("expected exit 42 (37+5) resolved via the c_export alias symbol")
	}
	return ""
}

// TestX86_64ElfLoop: sum 1..9 = 45, exit with that value.
//   xor rbx, rbx          ; sum = 0
//   mov rcx, 1            ; i = 1
// loop_top:
//   cmp rcx, 10
//   jge loop_end
//   add rbx, rcx
//   inc rcx
//   jmp loop_top
// loop_end:
//   mov rax, 60
//   mov rdi, rbx          ; (use mov rdi, rbx via Mov reg,reg)
//   syscall
func TestX86_64ElfLoop() testing.TestResult {
	if !canLinkX86_64Elf() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Xor(a, x64.Reg(x64.RBX, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RCX, x64.SZ64), x64.Imm(1))
	a.DefineLabel("loop_top")
	x64.Cmp(a, x64.Reg(x64.RCX, x64.SZ64), x64.Imm(10))
	x64.Jcc(a, x64.CC_GE, "loop_end")
	x64.Add(a, x64.Reg(x64.RBX, x64.SZ64), x64.Reg(x64.RCX, x64.SZ64))
	x64.Inc(a, x64.Reg(x64.RCX, x64.SZ64))
	x64.Jmp(a, "loop_top")
	a.DefineLabel("loop_end")
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64))
	x64.Syscall(a)
	x64.ResolveFixups(a)
	a.Finalize()
	var rc int = linkAndRunX64(a, "/tmp/binate_x64_loop.o", "/tmp/binate_x64_loop")
	if rc != 45 { return fail("expected exit code 45") }
	return ""
}

// TestX86_64ElfCall: function call exercising PUSH/POP for callee-save
// register preservation. The callee adds 5 to rdi and returns it.
//   _start:
//     mov rdi, 37
//     call add5
//     mov rax, 60
//     syscall            ; exit(rdi) — rdi holds the return value
//   add5:                ; takes rdi, returns updated rdi
//     push rbx           ; demonstrate PUSH/POP
//     mov rbx, 5
//     add rdi, rbx
//     pop rbx
//     ret
func TestX86_64ElfCall() testing.TestResult {
	if !canLinkX86_64Elf() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")
	x64.Mov(a, x64.Reg(x64.RDI, x64.SZ64), x64.Imm(37))
	x64.Call(a, "add5")
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ64), x64.Imm(60))
	x64.Syscall(a)
	a.DefineLabel("add5")
	x64.Push(a, x64.Reg(x64.RBX, x64.SZ64))
	x64.Mov(a, x64.Reg(x64.RBX, x64.SZ64), x64.Imm(5))
	x64.Add(a, x64.Reg(x64.RDI, x64.SZ64), x64.Reg(x64.RBX, x64.SZ64))
	x64.Pop(a, x64.Reg(x64.RBX, x64.SZ64))
	x64.Ret(a)
	x64.ResolveFixups(a)
	a.Finalize()
	var rc int = linkAndRunX64(a, "/tmp/binate_x64_call.o", "/tmp/binate_x64_call")
	if rc != 42 { return fail("expected exit code 42 (37+5)") }
	return ""
}

// Little-endian readers over a raw object-file byte buffer (for parsing the
// emitted ELF back in TestWriteElfX64RelocPltVsPc).
func rdU16(b *[]uint8, off int) int {
	return cast(int, b[off]) | (cast(int, b[off + 1]) << 8)
}

func rdU32(b *[]uint8, off int) int {
	var v int = 0
	for i := 0; i < 4; i++ { v = v | (cast(int, b[off + i]) << cast(uint, 8 * i)) }
	return v
}

func rdU64(b *[]uint8, off int) int {
	var v int = 0
	for i := 0; i < 8; i++ { v = v | (cast(int, b[off + i]) << cast(uint, 8 * i)) }
	return v
}

// End-to-end: a CALL to an UNDEFINED (extern) symbol must be emitted as
// R_X86_64_PLT32, a CALL to a DEFINED (same-object) symbol as R_X86_64_PC32.
// This exercises the actual reloc-emission call site (elf.bn computes
// `symUndef = a.Symbols[rel.Symbol].Section < 0` and feeds it to
// elfRelocType) — the isolated elfRelocType tests can't catch a regression
// in that wiring (wrong symbol index, inverted comparison, predicate read
// after the symtab sort).  PC32 against an undefined symbol is what a PIE
// link rejects, so this is the property that keeps the native_x64 C-interop
// mode linkable.
// A DEFINED-WEAK call must also be PC32 (st_shndx is its defining section, not
// SHN_UNDEF — only Section<0 picks PLT32).  This is the actual shipping shape:
// generic instantiations + dtor/copy helpers are DefineLabel'd then SetWeak'd
// (IsLinkOnce) and called directly, so a regression that treated BIND_WEAK as
// undefined for reloc purposes would mis-emit PLT32 and surface only in the
// Linux PIE link — this pins it at the object level.
func TestWriteElfX64RelocPltVsPc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("caller")
	a.SetGlobal("caller")
	a.SetGlobal("ext") // declared but never defined -> undefined
	x64.Call(a, "callee") // defined strong, same object -> PC32
	x64.Call(a, "ext") // undefined -> PLT32
	x64.Call(a, "wcallee") // defined WEAK, same object -> PC32
	x64.Ret(a)
	a.DefineLabel("callee")
	a.SetGlobal("callee")
	x64.Ret(a)
	a.DefineLabel("wcallee")
	a.SetWeak("wcallee") // defined + weak (the instantiation/dtor shape)
	x64.Ret(a)

	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_elf_x64_plt.o"
	if !WriteX86_64(a, path) { return fail("failed to write ELF") }

	f, oerr := os.Open(path)
	if present(oerr) { return fail("cannot open ELF file") }
	var bufv @[]uint8 = make_slice(uint8, 16384)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = bufv
	n, _ := f.Read(raw)
	_ = f.Close()
	if n < 200 { return fail("ELF file too small") }

	// Locate the .rela.text (SHT_RELA) and .symtab (SHT_SYMTAB) sections.
	var shoff int = rdU64(raw, 40)
	var shentsize int = rdU16(raw, 58)
	var shnum int = rdU16(raw, 60)
	var relaOff int = -1
	var relaSize int = 0
	var symOff int = -1
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var stype int = rdU32(raw, sh + 4)
		if stype == cast(int, SHT_RELA) {
			relaOff = rdU64(raw, sh + 24)
			relaSize = rdU64(raw, sh + 32)
		}
		if stype == cast(int, SHT_SYMTAB) {
			symOff = rdU64(raw, sh + 24)
		}
	}
	if relaOff < 0 { return fail("no SHT_RELA section") }
	if symOff < 0 { return fail("no SHT_SYMTAB section") }

	// Each Elf64_Rela is 24 bytes (r_offset, r_info, r_addend); each Elf64_Sym
	// is 24 bytes with st_info at offset 4 (binding = st_info >> 4) and
	// st_shndx at offset 6.  Check every CALL reloc's type against its target
	// symbol's definedness AND binding.
	var sawUndefPlt bool = false
	var sawStrongDefPc bool = false
	var sawWeakDefPc bool = false
	var off int = 0
	for off < relaSize {
		// r_info is {sym: high 32, type: low 32}; read the two 32-bit halves
		// directly rather than a 64-bit read shifted by 32 — rdU64 returns a host
		// `int`, which drops the high (symIdx) word on a 32-bit host, so every
		// reloc would resolve to symbol 0 (SHN_UNDEF).
		var rtype int = rdU32(raw, relaOff + off + 8)
		var symIdx int = rdU32(raw, relaOff + off + 12)
		// Every CALL reloc (PC32 and PLT32 alike) is field-relative, so its
		// r_addend (Elf64_Rela offset +16) is -4 — the type and addend are
		// pinned together here, in the actual emitted object, not just in the
		// isolated elfRelocAddend test.  A wrong addend silently corrupts the
		// call displacement (the prologue-corruption scenario it documents).
		var raddend int = rdU64(raw, relaOff + off + 16)
		if raddend != -4 {
			return fail("CALL reloc r_addend must be -4 (field-relative)")
		}
		var shndx int = rdU16(raw, symOff + symIdx * 24 + 6)
		var binding int = cast(int, raw[symOff + symIdx * 24 + 4]) >> 4
		if shndx == SHN_UNDEF {
			if rtype != R_X86_64_PLT32 {
				return fail("undefined-symbol CALL must be R_X86_64_PLT32")
			}
			sawUndefPlt = true
		} else {
			if rtype != R_X86_64_PC32 {
				return fail("defined-symbol CALL must be R_X86_64_PC32")
			}
			if binding == STB_WEAK {
				sawWeakDefPc = true
			} else {
				sawStrongDefPc = true
			}
		}
		off = off + 24
	}
	if !sawUndefPlt { return fail("no PLT32 reloc for the undefined call") }
	if !sawStrongDefPc { return fail("no PC32 reloc for the defined-strong call") }
	if !sawWeakDefPc {
		return fail("no PC32 reloc for the defined-WEAK call (instantiation/dtor shape)")
	}
	return ""
}

// End-to-end: a MovwLabel + MovtLabel pair addressing a symbol must emit,
// through the actual ELF32 object writer, an R_ARM_MOVW_ABS_NC (43) and an
// R_ARM_MOVT_ABS (44) relocation — at the MOVW's and MOVT's byte offsets,
// against that symbol, with a zero addend.
//
// This drives the P1 feature (FIX_MOVW_ABS_NC=202 / FIX_MOVT_ABS=203 fixup
// recording in asm/arm32 -> the elfRelocType 202->43 / 203->44 mapping in
// asm/elf) through the ELF writer's ARM reloc-emission path (elf.bn's ELF32
// branch: `symUndef` lookup, symRemap, `r_info = (sym << 8) | type`,
// Elf32_Rel layout).  The isolated encoder / mapping tests can't catch a
// regression in that wiring — a wrong r_info field packing, a swapped
// r_offset, a bad Elf32_Rel stride, or the writer picking RELA over REL
// (ARM must be REL per the psABI) would all pass those and surface only here.
func TestWriteArm32ElfMovwMovtReloc() testing.TestResult {
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.DefineLabel("_start")
	a.SetGlobal("_start")

	// movw r0, #:lower16:gvar  (text offset 0 -> R_ARM_MOVW_ABS_NC)
	// movt r0, #:upper16:gvar  (text offset 4 -> R_ARM_MOVT_ABS)
	arm32.MovwLabel(a, arm32.COND_AL, arm32.R0, "gvar")
	arm32.MovtLabel(a, arm32.COND_AL, arm32.R0, "gvar")
	arm32.Bx(a, arm32.COND_AL, arm32.LR)

	// Define the target symbol so the reloc has a valid target.  A
	// same-section definition still yields a relocation for MOVW/MOVT ABS
	// (only in-section branches resolve at assemble time).
	a.DefineLabel("gvar")
	a.SetGlobal("gvar")
	a.EmitUint32(0)

	arm32.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("assembler error") }

	var path *[]readonly char = "/tmp/binate_elf_arm32_movwt.o"
	if !WriteARM32(a, path, false) { return fail("failed to write ARM32 ELF") }

	f, oerr := os.Open(path)
	if present(oerr) { return fail("cannot open ELF file") }
	var bufv @[]uint8 = make_slice(uint8, 16384)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = bufv
	n, _ := f.Read(raw)
	_ = f.Close()
	if n < 100 { return fail("ELF file too small") }

	// Elf32 header: e_shoff@32(u32), e_shentsize@46(u16), e_shnum@48(u16).
	var shoff int = rdU32(raw, 32)
	var shentsize int = rdU16(raw, 46)
	var shnum int = rdU16(raw, 48)

	// Locate .rel.text (SHT_REL — ARM uses REL, not RELA) and .symtab
	// (SHT_SYMTAB) + its .strtab.
	// Elf32_Shdr (40 bytes): sh_type@4, sh_offset@16, sh_size@20, sh_link@24.
	var relOff int = -1
	var relSize int = 0
	var symOff int = -1
	var strOff int = -1
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		var stype int = rdU32(raw, sh + 4)
		if stype == cast(int, SHT_REL) {
			relOff = rdU32(raw, sh + 16)
			relSize = rdU32(raw, sh + 20)
		}
		if stype == cast(int, SHT_SYMTAB) {
			symOff = rdU32(raw, sh + 16)
			// sh_link of .symtab is the section index of its .strtab.
			var strSh int = shoff + rdU32(raw, sh + 24) * shentsize
			strOff = rdU32(raw, strSh + 16)
		}
	}
	if relOff < 0 { return fail("no SHT_REL section") }
	if symOff < 0 { return fail("no SHT_SYMTAB section") }
	if strOff < 0 { return fail("no .strtab for .symtab") }

	// Each Elf32_Rel is 8 bytes: r_offset(4), r_info(4) — NO r_addend (ARM is
	// REL; any addend rides the instruction field, and it is 0 for MOVW/MOVT).
	// r_info = (sym << 8) | type; type = r_info & 0xff, sym = r_info >> 8.
	// Each Elf32_Sym is 16 bytes: st_name@0(u32), st_value@4, st_size@8,
	// st_info@12, st_other@13, st_shndx@14.
	var sawMovw bool = false
	var sawMovt bool = false
	var off int = 0
	for off < relSize {
		var roffset int = rdU32(raw, relOff + off + 0)
		var rinfo int = rdU32(raw, relOff + off + 4)
		var rtype int = rinfo & 0xff
		var symIdx int = rinfo >> 8
		// The symbol's name lives in .strtab at st_name; it must be "gvar".
		var stName int = rdU32(raw, symOff + symIdx * 16 + 0)
		if !strEqAt(raw, strOff + stName, "gvar") {
			return fail("MOVW/MOVT reloc must reference the 'gvar' symbol")
		}
		if rtype == R_ARM_MOVW_ABS_NC {
			if roffset != 0 {
				return fail("R_ARM_MOVW_ABS_NC must be at the MOVW offset (0)")
			}
			sawMovw = true
		} else if rtype == R_ARM_MOVT_ABS {
			if roffset != 4 {
				return fail("R_ARM_MOVT_ABS must be at the MOVT offset (4)")
			}
			sawMovt = true
		} else {
			return fail("unexpected reloc type in .rel.text")
		}
		off = off + 8
	}
	if !sawMovw { return fail("no R_ARM_MOVW_ABS_NC (43) reloc emitted") }
	if !sawMovt { return fail("no R_ARM_MOVT_ABS (44) reloc emitted") }
	return ""
}

// strEqAt reports whether the null-terminated C string at byte offset `at`
// in the raw object buffer equals `want` (used to check a symbol's .strtab
// name in the ARM32 reloc readback test).
func strEqAt(b *[]uint8, at int, want *[]readonly char) bool {
	for i := 0; i < len(want); i++ {
		if b[at + i] != cast(uint8, want[i]) { return false }
	}
	return b[at + len(want)] == 0
}

// elfSymType marks a defined non-local symbol in an executable section STT_FUNC
// (needed for Thumb->ARM interworking and for tools to see functions), and
// everything else STT_NOTYPE: a local label (block labels, "$a"/"$x" mapping
// symbols), a data symbol, and an undefined reference.
func TestElfSymTypeFuncVsNonFunc() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1) // executable
	a.DefineLabel("fn")
	a.SetGlobal("fn") // global function in .text
	a.DefineLabel("blocklbl") // local label in .text (e.g. a block target)
	a.SetSection("data", -1) // non-executable
	a.DefineLabel("datum")
	a.SetGlobal("datum") // global data symbol
	a.SetGlobal("ext") // undefined external (Section stays -1)

	if elfSymType(a, a.Symbols[a.LookupSymbol("fn")]) != STT_FUNC {
		return fail("global symbol in .text must be STT_FUNC")
	}
	if elfSymType(a, a.Symbols[a.LookupSymbol("blocklbl")]) != STT_NOTYPE {
		return fail("local label in .text must be STT_NOTYPE")
	}
	if elfSymType(a, a.Symbols[a.LookupSymbol("datum")]) != STT_NOTYPE {
		return fail("global data symbol must be STT_NOTYPE")
	}
	if elfSymType(a, a.Symbols[a.LookupSymbol("ext")]) != STT_NOTYPE {
		return fail("undefined external must be STT_NOTYPE")
	}
	return ""
}
