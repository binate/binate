package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"

// The thread-local relocations of an ELF object: each aarch64 and x86-64 thread-local fixup
// kind's relocation type, and the symbols they name — a thread-local symbol (STT_TLS), as clang
// types every symbol a thread-local operator names, which must be defined in a thread-local
// section, or be a common (a thread-local common, which GNU ld allocates in .tbss), if it is
// defined here.

// elfTlsRelocType returns the ELF relocation type of an aarch64 thread-local fixup kind
// (isa's FIX_TLS* and FIX_AUTH_TLSDESC_*, numbered from their relocation types: R_AARCH64_<name>
// = kind + 312), or -1 for any other kind.
func elfTlsRelocType(fixKind int) int {
	if (fixKind >= 211 && fixKind <= 247) || (fixKind >= 250 && fixKind <= 252) || fixKind == 257 ||
			(fixKind >= 258 && fixKind <= 261) || (fixKind >= 283 && fixKind <= 285) {
		return fixKind + 312
	}
	return -1
}

// elfX64TlsRelocType returns the ELF relocation type of an x86-64 thread-local fixup kind
// (x64's FIX_TPOFF32 .. FIX_DTPOFF64, 304 to 312), or -1 for any other kind.
func elfX64TlsRelocType(fixKind int) int {
	if fixKind == 304 { return R_X86_64_TPOFF32 } // FIX_TPOFF32
	if fixKind == 305 { return R_X86_64_DTPOFF32 } // FIX_DTPOFF32
	if fixKind == 306 { return R_X86_64_GOTTPOFF } // FIX_GOTTPOFF
	if fixKind == 307 { return R_X86_64_TLSGD } // FIX_TLSGD
	if fixKind == 308 { return R_X86_64_TLSLD } // FIX_TLSLD
	if fixKind == 309 { return R_X86_64_GOTPC32_TLSDESC } // FIX_TLSDESC
	if fixKind == 310 { return R_X86_64_TLSDESC_CALL } // FIX_TLSCALL
	if fixKind == 311 { return R_X86_64_TPOFF64 } // FIX_TPOFF64
	if fixKind == 312 { return R_X86_64_DTPOFF64 } // FIX_DTPOFF64
	return -1
}

// elfIsTlsReloc reports whether fixKind is a thread-local fixup kind of machine.
func elfIsTlsReloc(fixKind int, machine int) bool {
	if machine == EM_AARCH64 { return elfTlsRelocType(fixKind) >= 0 }
	if machine == EM_X86_64 { return elfX64TlsRelocType(fixKind) >= 0 }
	return false
}

// elfMachoOnlyOperator returns how a diagnostic names the operator of a fixup kind only Mach-O
// has a relocation for — Mach-O's thread-local variable references (aarch64's `@TLVPPAGE` /
// `@TLVPPAGEOFF`, isa's FIX_TLVP_LOAD_*, 135 and 136; x86-64's `@TLVP`, x64's FIX_TLVP, 313) —
// or "" for any other kind.
func elfMachoOnlyOperator(fixKind int, machine int) *[]readonly char {
	if machine == EM_AARCH64 && (fixKind == 135 || fixKind == 136) {
		return "`@TLVPPAGE` / `@TLVPPAGEOFF` are"
	}
	if machine == EM_X86_64 && fixKind == 313 { return "`@TLVP` is" }
	return ""
}

// elfTlsRelocsOk types each symbol a thread-local relocation of a (for machine) names
// thread-local (asm.SYM_TLS), and reports whether every one may be, else sets the error: a
// label in a section that is not thread-local has no offset in the thread-local template (clang
// types such a `.data` label STT_TLS, linking nonsense), and neither has an absolute symbol
// (clang: "relocation for a thread-local variable points to an absolute symbol").
func elfTlsRelocsOk(a @asm.Assembler, machine int) bool {
	for ri := 0; ri < a.NumRelocs; ri++ {
		if !elfIsTlsReloc(a.Relocs[ri].Kind, machine) { continue }
		var si int = a.Relocs[ri].Symbol
		var sym asm.Symbol = a.Symbols[si]
		if sym.Abs || (sym.Section >= 0 && (a.Sections[sym.Section].Flags & asm.SF_TLS) == 0) {
			var msg @[]char = buf.Concat("elf: a thread-local relocation names '",
					asm.LabelForMessage(sym.Name))
			a.SetError(buf.Concat(msg, "', which is not defined in a thread-local section"))
			return false
		}
		a.Symbols[si].Type = asm.SYM_TLS
	}
	return true
}
