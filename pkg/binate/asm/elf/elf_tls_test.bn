package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The thread-local relocations (elf_tls.bn): each thread-local kind's ELF type, and the
// symbols the relocations name.

// A thread-local kind's ELF relocation type is the kind + 312 (FIX_TLSLD_MOVW_DTPREL_G2 211 is
// R_AARCH64_TLSLD_MOVW_DTPREL_G2 523, through FIX_TLSLE_LDST64_TPREL_LO12_NC 247; the TLSDESC
// kinds 250 to 252 and 257; the LDST128 kinds 258 to 261; the AUTH TLSDESC kinds 283 to 285);
// any other kind, a gap between them included, has none.
func TestElfTlsRelocType() testing.TestResult {
	if elfTlsRelocType(211) != 523 || elfTlsRelocType(226) != 538 || elfTlsRelocType(232) != 544 ||
			elfTlsRelocType(247) != 559 || elfTlsRelocType(258) != 570 || elfTlsRelocType(261) != 573 {
		return fail("a thread-local kind maps to the wrong relocation type")
	}
	if elfTlsRelocType(227) != 539 || elfTlsRelocType(231) != 543 || elfTlsRelocType(250) != 562 ||
			elfTlsRelocType(252) != 564 || elfTlsRelocType(257) != 569 || elfTlsRelocType(283) != 595 ||
			elfTlsRelocType(285) != 597 {
		return fail("an initial-exec or TLSDESC kind maps to the wrong relocation type")
	}
	if elfTlsRelocType(210) != -1 || elfTlsRelocType(248) != -1 || elfTlsRelocType(253) != -1 ||
			elfTlsRelocType(262) != -1 || elfTlsRelocType(286) != -1 || elfTlsRelocType(105) != -1 {
		return fail("a kind that is not thread-local maps to a relocation type")
	}
	return ""
}

// tlsMsgHas reports whether s contains sub.
func tlsMsgHas(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if charsEqual(s[i:i + len(sub)], sub) { return true }
	}
	return false
}

// tlsRelocAsm returns an aarch64 assembler with a thread-local relocation (kind 238, a
// TPREL LO12) against target, which it defines in section sec ("" leaves it undefined).
func tlsRelocAsm(sec *[]readonly char, target *[]readonly char) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	if len(sec) == 0 { a.SetGlobal(target) }
	if len(sec) != 0 {
		a.SetSection(sec, -1)
		a.DefineLabel(target)
		a.EmitUint32(0)
	}
	a.SetSection("text", -1)
	a.AddFixup(target, 238, 0, 4)
	a.EmitUint32(0x91000000)
	a.Finalize()
	return a
}

// elfTlsRelocsOk types the symbol a thread-local relocation names STT_TLS — an undefined one,
// one defined in a thread-local section, or a common (clang's thread-local common) — and rejects
// one defined in any other section or an absolute one; another machine's relocations are left
// alone.
func TestElfTlsRelocsOk() testing.TestResult {
	var u @asm.Assembler = tlsRelocAsm("", "v")
	if u.HasError || !elfTlsRelocsOk(u, EM_AARCH64) ||
			u.Symbols[u.LookupSymbol("v")].Type != asm.SYM_TLS {
		return fail("an undefined symbol is not made thread-local")
	}
	var t @asm.Assembler = tlsRelocAsm("tbss", "t")
	if t.HasError || !elfTlsRelocsOk(t, EM_AARCH64) {
		return fail("a symbol in tbss is rejected")
	}
	var d @asm.Assembler = tlsRelocAsm("data", "d")
	if d.HasError || elfTlsRelocsOk(d, EM_AARCH64) || !tlsMsgHas(d.ErrorMsg, "not defined in a") {
		return fail("a symbol in data is accepted")
	}
	var c @asm.Assembler = asm.New(8)
	c.ObjFormat = asm.OBJ_ELF
	c.DefineCommon("cv", 8, 8)
	c.SetSection("text", -1)
	c.AddFixup("cv", 238, 0, 4)
	c.EmitUint32(0x91000000)
	c.Finalize()
	if c.HasError || !elfTlsRelocsOk(c, EM_AARCH64) ||
			c.Symbols[c.LookupSymbol("cv")].Type != asm.SYM_TLS {
		return fail("a common is not made a thread-local common")
	}
	var k @asm.Assembler = asm.New(8)
	k.ObjFormat = asm.OBJ_ELF
	k.DefineAbsolute("K", 5)
	k.SetSection("text", -1)
	k.AddFixup("K", 238, 0, 4)
	k.EmitUint32(0x91000000)
	k.Finalize()
	if k.HasError || elfTlsRelocsOk(k, EM_AARCH64) { return fail("an absolute symbol is accepted") }
	var x @asm.Assembler = tlsRelocAsm("data", "d")
	if !elfTlsRelocsOk(x, EM_X86_64) || x.Symbols[x.LookupSymbol("d")].Type == asm.SYM_TLS {
		return fail("an x86-64 relocation of the same kind is taken as thread-local")
	}
	return ""
}

// An x86-64 thread-local kind's relocation (x64's FIX_TPOFF32 304 .. FIX_DTPOFF64 312):
// TPOFF32, DTPOFF32, GOTTPOFF, TLSGD, TLSLD, GOTPC32_TLSDESC, TLSDESC_CALL, TPOFF64, DTPOFF64,
// as elfRelocType maps them; the PC-relative ones take elfRelocAddend's -4, the others their
// addend as written.
func TestElfX64TlsRelocType() testing.TestResult {
	if elfRelocType(304, EM_X86_64, true) != 23 || elfRelocType(305, EM_X86_64, true) != 21 ||
			elfRelocType(306, EM_X86_64, true) != 22 || elfRelocType(307, EM_X86_64, true) != 19 ||
			elfRelocType(308, EM_X86_64, true) != 20 || elfRelocType(309, EM_X86_64, true) != 34 ||
			elfRelocType(310, EM_X86_64, true) != 35 || elfRelocType(311, EM_X86_64, true) != 18 ||
			elfRelocType(312, EM_X86_64, true) != 17 {
		return fail("an x86-64 thread-local kind maps to the wrong relocation type")
	}
	if elfX64TlsRelocType(303) != -1 || elfX64TlsRelocType(313) != -1 ||
			elfRelocType(304, EM_AARCH64, true) != -1 {
		return fail("a kind that is not x86-64 thread-local maps to a thread-local relocation")
	}
	if elfRelocAddend(R_X86_64_GOTTPOFF, EM_X86_64, -1) != -5 ||
			elfRelocAddend(R_X86_64_TLSGD, EM_X86_64, 0) != -4 ||
			elfRelocAddend(R_X86_64_TLSLD, EM_X86_64, 0) != -4 ||
			elfRelocAddend(R_X86_64_GOTPC32_TLSDESC, EM_X86_64, 0) != -4 {
		return fail("a PC-relative thread-local relocation's addend is not measured from its end")
	}
	if elfRelocAddend(R_X86_64_TPOFF32, EM_X86_64, 8) != 8 ||
			elfRelocAddend(R_X86_64_DTPOFF32, EM_X86_64, -8) != -8 ||
			elfRelocAddend(R_X86_64_TPOFF64, EM_X86_64, 8) != 8 ||
			elfRelocAddend(R_X86_64_DTPOFF64, EM_X86_64, 8) != 8 ||
			elfRelocAddend(R_X86_64_TLSDESC_CALL, EM_X86_64, 0) != 0 {
		return fail("a thread-local offset's addend is changed")
	}
	return ""
}

// x64TlsRelocAsm returns an x86-64 assembler with a FIX_TPOFF32 relocation against target, which
// it defines in section sec ("" leaves it undefined).
func x64TlsRelocAsm(sec *[]readonly char, target *[]readonly char) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_ELF
	if len(sec) == 0 { a.SetGlobal(target) }
	if len(sec) != 0 {
		a.SetSection(sec, -1)
		a.DefineLabel(target)
		a.EmitUint32(0)
	}
	a.SetSection("text", -1)
	a.AddFixup(target, 304, 0, 4)
	a.EmitUint32(0)
	a.Finalize()
	return a
}

// On x86-64 too, the symbol a thread-local relocation names is STT_TLS, and one defined in a
// section that is not thread-local is rejected.
func TestElfX64TlsRelocsOk() testing.TestResult {
	var u @asm.Assembler = x64TlsRelocAsm("", "v")
	if u.HasError || !elfTlsRelocsOk(u, EM_X86_64) ||
			u.Symbols[u.LookupSymbol("v")].Type != asm.SYM_TLS {
		return fail("an undefined symbol is not made thread-local")
	}
	var t @asm.Assembler = x64TlsRelocAsm("tdata", "t")
	if t.HasError || !elfTlsRelocsOk(t, EM_X86_64) { return fail("a symbol in tdata is rejected") }
	var d @asm.Assembler = x64TlsRelocAsm("data", "d")
	if d.HasError || elfTlsRelocsOk(d, EM_X86_64) || !tlsMsgHas(d.ErrorMsg, "not defined in a") {
		return fail("a symbol in data is accepted")
	}
	return ""
}
