package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/std/strings"

// --- Binary writing helpers ---

// BinBuf is a growable byte buffer for building binary output (ELF files).
// All Write* methods write little-endian values and return the updated
// buffer. BinBuf is passed and returned by value; the underlying Data is
// shared via managed pointer so callers must use the returned value (not
// the original).
type BinBuf struct {
	Data @[]uint8
	Len  int
}

// newBinBuf creates a BinBuf with initial capacity.
func newBinBuf() BinBuf {
	var b BinBuf
	b.Data = make_slice(uint8, 4096)
	b.Len = 0
	return b
}

// grow ensures room for `needed` more bytes, doubling capacity as needed.
func (b BinBuf) grow(needed int) BinBuf {
	var cap int = len(b.Data)
	if b.Len + needed <= cap { return b }
	var newCap int = cap
	for newCap < b.Len + needed { newCap = newCap * 2 }
	var newData @[]uint8 = make_slice(uint8, newCap)
	for i := 0; i < b.Len; i++ { newData[i] = b.Data[i] }
	b.Data = newData
	return b
}

// WriteU8 appends one byte to b. Returns the (possibly grown) buffer.
func (b BinBuf) WriteU8(v uint8) BinBuf {
	b = b.grow(1)
	b.Data[b.Len] = v
	b.Len = b.Len + 1
	return b
}

// WriteU16 appends v in little-endian byte order. ELFDATA2LSB is assumed
// throughout this package.
func (b BinBuf) WriteU16(v uint16) BinBuf {
	b = b.grow(2)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Len = b.Len + 2
	return b
}

// WriteU32 appends v in little-endian byte order.
func (b BinBuf) WriteU32(v uint32) BinBuf {
	b = b.grow(4)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Data[b.Len + 2] = cast(uint8, (v >> 16) & 0xff)
	b.Data[b.Len + 3] = cast(uint8, (v >> 24) & 0xff)
	b.Len = b.Len + 4
	return b
}

// WriteU64 appends v in little-endian byte order.
func (b BinBuf) WriteU64(v uint64) BinBuf {
	b = b.grow(8)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Data[b.Len + 2] = cast(uint8, (v >> 16) & 0xff)
	b.Data[b.Len + 3] = cast(uint8, (v >> 24) & 0xff)
	b.Data[b.Len + 4] = cast(uint8, (v >> 32) & 0xff)
	b.Data[b.Len + 5] = cast(uint8, (v >> 40) & 0xff)
	b.Data[b.Len + 6] = cast(uint8, (v >> 48) & 0xff)
	b.Data[b.Len + 7] = cast(uint8, (v >> 56) & 0xff)
	b.Len = b.Len + 8
	return b
}

// WriteBytes appends `count` bytes from data to b. The caller is
// responsible for ensuring data has at least `count` readable bytes.
func (b BinBuf) WriteBytes(data *[]uint8, count int) BinBuf {
	b = b.grow(count)
	for i := 0; i < count; i++ { b.Data[b.Len + i] = data[i] }
	b.Len = b.Len + count
	return b
}

// WriteZeros appends `count` zero bytes to b (padding helper).
func (b BinBuf) WriteZeros(count int) BinBuf {
	b = b.grow(count)
	for i := 0; i < count; i++ { b.Data[b.Len + i] = 0 }
	b.Len = b.Len + count
	return b
}

// Align pads b with zero bytes until its length is a multiple of
// alignment. No-op when already aligned.
func (b BinBuf) Align(alignment int) BinBuf {
	var rem int = b.Len % alignment
	if rem != 0 { b = b.WriteZeros(alignment - rem) }
	return b
}

// WriteAddr writes a 4-byte (ELF32) or 8-byte (ELF64) address/offset.
func (b BinBuf) WriteAddr(v int, is64 bool) BinBuf {
	if is64 {
		return b.WriteU64(cast(uint64, v))
	}
	return b.WriteU32(cast(uint32, v))
}

// --- String table helpers ---

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}

// StrTab builds an ELF string table: a sequence of null-terminated strings
// preceded by a leading null byte. Offsets returned by strTabAdd are byte
// positions into the table.
type StrTab struct {
	Buf @strings.Builder
}

// newStrTab creates a StrTab with the required leading null byte.
func newStrTab() StrTab {
	var st StrTab
	st.Buf = strings.NewBuilder()
	st.Buf.WriteByte(0) // first byte is null
	return st
}

// strTabAdd appends a null-terminated string to the table and returns
// its byte offset. Mutates through the pointer.
func strTabAdd(st *StrTab, s *[]readonly char) int {
	var offset int = st.Buf.Len()
	st.Buf.Write(s)
	st.Buf.WriteByte(0)
	return offset
}

// --- ELF section mapping ---

// elfSectName returns the ELF section name for an assembler section name.
// Most names just gain a "." prefix ("data" → ".data"); "rodata_relro" maps
// to the conventional ".data.rel.ro" so the linker's default script folds it
// into the PT_GNU_RELRO segment (read-only after relocation).  The returned
// managed-slice is a new allocation.
func elfSectName(name *[]readonly char) @[]char {
	if charsEqual(name, "rodata_relro") {
		return buf.CopyStr(".data.rel.ro")
	}
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('.')
	b.Write(name)
	return buf.CopyStr(b.String())
}

// relaSectName returns the name of the relocation-table section that
// holds the relocations for the data section named `name`: ".rela" +
// the section's ELF name (elfSectName supplies the leading ".").  So a
// "rodata_relro" section's relocations live in ".rela.data.rel.ro" and
// "data"'s in ".rela.data".  A new allocation.
func relaSectName(name *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(".rela")
	var en @[]char = elfSectName(name)
	b.Write(en)
	return buf.CopyStr(b.String())
}

// elfSectType returns the ELF section type for a section name.
func elfSectType(name *[]readonly char) uint32 {
	if charsEqual(name, "bss") { return SHT_NOBITS }
	return SHT_PROGBITS
}

// elfSectFlags returns the ELF section flags (SHF_*) for a section name.
func elfSectFlags(name *[]readonly char) uint64 {
	if charsEqual(name, "text") { return SHF_ALLOC | SHF_EXECINSTR }
	if charsEqual(name, "data") { return SHF_ALLOC | SHF_WRITE }
	if charsEqual(name, "rodata") { return SHF_ALLOC }
	// .data.rel.ro must be ALLOC|WRITE so the loader can apply relocations;
	// PT_GNU_RELRO then re-protects it read-only after fixups.
	if charsEqual(name, "rodata_relro") { return SHF_ALLOC | SHF_WRITE }
	if charsEqual(name, "bss") { return SHF_ALLOC | SHF_WRITE }
	return SHF_ALLOC
}

// --- Relocation mapping ---

// elfRelocType maps an assembler fixup kind to the ELF relocation type
// for the given machine. Returns -1 for an unmapped (kind, machine)
// combination — the caller (elf.Write) MUST treat that as an error, not
// emit it: ELF reloc type 0 is R_<arch>_NONE (a linker no-op), so emitting
// it would silently drop the relocation and leave the patched field
// unrelocated (a silent miscompile).  Mirrors machoRelocType's -1 contract.
// A concrete gap this guards: the aarch64 low-12 fixup kinds
// (FIX_ADD_LO12/LDR_LO12, and the GOT pair FIX_ADRP_GOT_HI21/LD_GOT_LO12)
// have no aarch64 ELF mapping yet, so `--target aarch64-linux -backend
// native` fails loud instead of emitting R_AARCH64_NONE.  (See claude-todo.md.)
//
// symUndefined reports whether the relocation's target symbol is undefined
// (extern) in this object.  On x86-64 a CALL rel32 (FIX_REL32) against an
// undefined symbol must be R_X86_64_PLT32, not R_X86_64_PC32, or a PIE link
// rejects it; against a defined symbol PC32 is correct and PIE-safe.  Other
// machines route undefined branch targets through linker-synthesized PLT
// veneers regardless of reloc type, so they ignore symUndefined.
//
// PC32 for ALL defined symbols (including weak/global, e.g. weak_odr generic
// instantiations and dtor/copy helpers) holds because we link PIE EXECUTABLES,
// where a defined symbol binds to this image's own copy (not interposed).
// clang uses PLT32 for any PREEMPTIBLE defined symbol; a shared-object (.so)
// target — which Binate does not emit — would need that, since a PIE .so can
// interpose a defined non-LOCAL symbol and rejects PC32 against it.
func elfRelocType(fixKind int, machine int, symUndefined bool) int {
	if machine == EM_AARCH64 {
		if fixKind == 100 { return R_AARCH64_JUMP26 }
		if fixKind == 101 { return R_AARCH64_CONDBR19 }
		if fixKind == 102 { return R_AARCH64_ADR_PREL_LO21 }
		if fixKind == 103 { return R_AARCH64_ADR_PREL_PG_HI21 }
		if fixKind == 104 { return R_AARCH64_TSTBR14 }
		if fixKind == 105 { return R_AARCH64_ADD_ABS_LO12_NC } // FIX_ADD_LO12
		// FIX_LDR_LO12 / FIX_LD_GOT_LO12 assume a 64-bit (8-byte-scaled)
		// load — LDST64 / LD64 encode that scale.  The emitters only ever
		// produce the 64-bit form (LdrGotLo12 hard-codes it; LdrImmLabel is
		// used only for pointer-width loads).  A future sub-64-bit LDR reaching
		// the ELF path would need the LDST8/16/32 variant instead.
		if fixKind == 106 { return R_AARCH64_LDST64_ABS_LO12_NC } // FIX_LDR_LO12
		if fixKind == 107 { return R_AARCH64_ADR_GOT_PAGE } // FIX_ADRP_GOT_HI21
		if fixKind == 108 { return R_AARCH64_LD64_GOT_LO12_NC } // FIX_LD_GOT_LO12
		if fixKind == 0 { return R_AARCH64_ABS64 }
	}
	if machine == EM_ARM {
		if fixKind == 200 { return R_ARM_JUMP24 }
		if fixKind == 201 { return R_ARM_ABS32 }
		if fixKind == 202 { return R_ARM_MOVW_ABS_NC }
		if fixKind == 203 { return R_ARM_MOVT_ABS }
		if fixKind == 0 { return R_ARM_ABS32 }
	}
	if machine == EM_X86_64 {
		if fixKind == 300 {
			// FIX_REL32 (CALL/JMP rel32)
			if symUndefined { return R_X86_64_PLT32 }
			return R_X86_64_PC32
		}
		if fixKind == 301 { return R_X86_64_64 } // FIX_ABS64
		if fixKind == 302 { return R_X86_64_PC32 } // FIX_REL32_LEA (local data)
		if fixKind == 303 { return R_X86_64_REX_GOTPCRELX } // FIX_GOTPCREL
		if fixKind == 0 { return R_X86_64_64 } // generic absolute
	}
	return -1
}

// elfRelocAddend returns the r_addend to store for a relocation, applying
// the per-arch PC-relative correction.  x86-64 PC32 (CALL/JMP/Jcc rel32
// and RIP-relative LEA disp32) is field-relative, but the displacement is
// measured from the END of the instruction — the rel32/disp32 IS its last
// 4 bytes — so RELA needs `addend - 4`, matching the in-section
// patchRel32's `target - (fixup + 4)`.  Omitting it lands every
// cross-object call 4 bytes past the callee, skipping its `push %rbp; mov
// %rsp,%rbp` prologue → frame corruption → crash.  AArch64 / ARM branch
// relocs are instruction-relative (no -4); Mach-O carries the -4
// implicitly in its branch reloc, so only the ELF path corrects it.
// rtype is the value from elfRelocType.  R_X86_64_PLT32 shares PC32's
// end-of-field semantics, so it takes the same -4 correction.
//
// ARM branch relocs (R_ARM_CALL / R_ARM_JUMP24) are measured from the
// instruction, but the ARM pipeline puts the reference PC 8 bytes (two
// instructions) ahead of the branch — so the RELA addend needs `-8` to land on
// the callee's entry.  This mirrors the in-section resolver's
// patchBranch24 (`offset - 8`): a same-object branch subtracts 8 in the patched
// field, and a cross-object branch must subtract the same 8 in its explicit
// addend, or the linker's `S + A - P` (with A=0 and imm24=0) lands every
// cross-object call 8 bytes past the callee — skipping its prologue.  clang's
// ARM objects encode the same -8 as `0xfffffe` in the instruction's imm24 (REL
// form); we use RELA, so the -8 rides the addend instead.
func elfRelocAddend(rtype int, machine int, addend int) int {
	// GOTPCREL (mov r64, sym@GOTPCREL(%rip)) shares PC32's end-of-field
	// semantics — the disp32 is measured from the end of the instruction — so
	// it takes the same -4 correction, or the reloc lands 4 bytes off.
	if machine == EM_X86_64 &&
			(rtype == R_X86_64_PC32 || rtype == R_X86_64_PLT32 || rtype == R_X86_64_REX_GOTPCRELX) {
		return addend - 4
	}
	if machine == EM_ARM && (rtype == R_ARM_CALL || rtype == R_ARM_JUMP24) {
		return addend - 8
	}
	return addend
}

// countRelocsForSection returns the number of relocations in a.Relocs
// that reference section si.
func countRelocsForSection(a @asm.Assembler, si int) int {
	var count int = 0
	for i := 0; i < a.NumRelocs; i++ {
		if a.Relocs[i].Section == si { count = count + 1 }
	}
	return count
}

// --- Section header emission ---

// emitShdr writes one ELF section header entry (Elf32_Shdr or Elf64_Shdr)
// to the binary buffer, using 4- or 8-byte fields based on is64.
func emitShdr(bb BinBuf, is64 bool, name uint32, shtype uint32, flags int, addr int, offset int,
		size int, link uint32, info uint32, addralign int, entsize int) BinBuf {
	bb = bb.WriteU32(name)
	bb = bb.WriteU32(shtype)
	bb = bb.WriteAddr(flags, is64)
	bb = bb.WriteAddr(addr, is64)
	bb = bb.WriteAddr(offset, is64)
	bb = bb.WriteAddr(size, is64)
	bb = bb.WriteU32(link)
	bb = bb.WriteU32(info)
	bb = bb.WriteAddr(addralign, is64)
	bb = bb.WriteAddr(entsize, is64)
	return bb
}
