package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/std/strings"

// --- Binary writing helpers ---

// BinBuf is a growable byte buffer for building binary output (ELF files).
// All Write* methods write little-endian values and return the updated
// buffer. BinBuf is passed and returned by value; the underlying Data is
// shared via managed pointer so callers must use the returned value (not
// the original).
type BinBuf struct {
	Data @[]uint8
	Len  int
}

// newBinBuf creates a BinBuf with initial capacity.
func newBinBuf() BinBuf {
	var b BinBuf
	b.Data = make_slice(uint8, 4096)
	b.Len = 0
	return b
}

// grow ensures room for `needed` more bytes, doubling capacity as needed.
func (b BinBuf) grow(needed int) BinBuf {
	var cap int = len(b.Data)
	if b.Len + needed <= cap { return b }
	var newCap int = cap
	for newCap < b.Len + needed { newCap = newCap * 2 }
	var newData @[]uint8 = make_slice(uint8, newCap)
	for i := 0; i < b.Len; i++ { newData[i] = b.Data[i] }
	b.Data = newData
	return b
}

// WriteU8 appends one byte to b. Returns the (possibly grown) buffer.
func (b BinBuf) WriteU8(v uint8) BinBuf {
	b = b.grow(1)
	b.Data[b.Len] = v
	b.Len = b.Len + 1
	return b
}

// WriteU16 appends v in little-endian byte order. ELFDATA2LSB is assumed
// throughout this package.
func (b BinBuf) WriteU16(v uint16) BinBuf {
	b = b.grow(2)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Len = b.Len + 2
	return b
}

// WriteU32 appends v in little-endian byte order.
func (b BinBuf) WriteU32(v uint32) BinBuf {
	b = b.grow(4)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Data[b.Len + 2] = cast(uint8, (v >> 16) & 0xff)
	b.Data[b.Len + 3] = cast(uint8, (v >> 24) & 0xff)
	b.Len = b.Len + 4
	return b
}

// WriteU64 appends v in little-endian byte order.
func (b BinBuf) WriteU64(v uint64) BinBuf {
	b = b.grow(8)
	b.Data[b.Len] = cast(uint8, v & 0xff)
	b.Data[b.Len + 1] = cast(uint8, (v >> 8) & 0xff)
	b.Data[b.Len + 2] = cast(uint8, (v >> 16) & 0xff)
	b.Data[b.Len + 3] = cast(uint8, (v >> 24) & 0xff)
	b.Data[b.Len + 4] = cast(uint8, (v >> 32) & 0xff)
	b.Data[b.Len + 5] = cast(uint8, (v >> 40) & 0xff)
	b.Data[b.Len + 6] = cast(uint8, (v >> 48) & 0xff)
	b.Data[b.Len + 7] = cast(uint8, (v >> 56) & 0xff)
	b.Len = b.Len + 8
	return b
}

// WriteBytes appends `count` bytes from data to b. The caller is
// responsible for ensuring data has at least `count` readable bytes.
func (b BinBuf) WriteBytes(data *[]uint8, count int) BinBuf {
	b = b.grow(count)
	for i := 0; i < count; i++ { b.Data[b.Len + i] = data[i] }
	b.Len = b.Len + count
	return b
}

// WriteZeros appends `count` zero bytes to b (padding helper).
func (b BinBuf) WriteZeros(count int) BinBuf {
	b = b.grow(count)
	for i := 0; i < count; i++ { b.Data[b.Len + i] = 0 }
	b.Len = b.Len + count
	return b
}

// Align pads b with zero bytes until its length is a multiple of
// alignment. No-op when already aligned.
func (b BinBuf) Align(alignment int) BinBuf {
	var rem int = b.Len % alignment
	if rem != 0 { b = b.WriteZeros(alignment - rem) }
	return b
}

// WriteAddr writes a 4-byte (ELF32) or 8-byte (ELF64) address/offset.
func (b BinBuf) WriteAddr(v int, is64 bool) BinBuf {
	if is64 {
		return b.WriteU64(cast(uint64, v))
	}
	return b.WriteU32(cast(uint32, v))
}

// --- String table helpers ---

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ { if a[i] != b[i] { return false } }
	return true
}

// --- ELF section mapping ---

// elfSectName returns the ELF section name for an assembler section name.
// Most names just gain a "." prefix ("data" → ".data"); "rodata_relro" maps
// to the conventional ".data.rel.ro" so the linker's default script folds it
// into the PT_GNU_RELRO segment (read-only after relocation).  The returned
// managed-slice is a new allocation.
func elfSectName(name *[]readonly char) @[]char {
	if charsEqual(name, "rodata_relro") {
		return buf.CopyStr(".data.rel.ro")
	}
	var b @strings.Builder = strings.NewBuilder()
	b.WriteByte('.')
	b.Write(name)
	return buf.CopyStr(b.String())
}

// relaSectName returns the name of the relocation-table section that holds the
// relocations for the data section named `name`: the reloc prefix (".rel" for
// REL / ARM, ".rela" for RELA / everything else) + the section's ELF name
// (elfSectName supplies the leading ".").  So a "rodata_relro" section's
// relocations live in ".rela.data.rel.ro" (RELA) or ".rel.data.rel.ro" (REL),
// and "data"'s in ".rela.data" / ".rel.data".  The prefix MUST match the
// section's sh_type (SHT_REL vs SHT_RELA) and entry size, or the linker
// mis-parses the table.  A new allocation.
func relaSectName(name *[]readonly char, useRel bool) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	if useRel {
		b.Write(".rel")
	} else {
		b.Write(".rela")
	}
	var en @[]char = elfSectName(name)
	b.Write(en)
	return buf.CopyStr(b.String())
}

// elfSectType returns the ELF section type for a section name, as clang infers a `.section`
// directive's type from the name when none is given: a note (note, notes, note.x, ...), an
// init, fini or preinit array (init_array, alone or with a "." suffix, ...), or zero-fill
// (asm.IsZeroFill); any other section holds program data.
func elfSectType(name *[]readonly char) uint32 {
	if len(name) >= 4 && charsEqual(name[0:4], "note") { return SHT_NOTE }
	if asm.IsZeroFill(name) { return SHT_NOBITS }
	if asm.SectionNameIs(name, "init_array") { return SHT_INIT_ARRAY }
	if asm.SectionNameIs(name, "fini_array") { return SHT_FINI_ARRAY }
	if asm.SectionNameIs(name, "preinit_array") { return SHT_PREINIT_ARRAY }
	return SHT_PROGBITS
}

// elfSectAlign returns section s's sh_addralign for machine: the largest alignment it requested
// (Section.Align, which an A64 or A32 instruction raises to 4, as GNU as aligns a section
// holding code), and at least what clang gives — 4 for text on every machine and for any other
// executable section on AArch64, 1 otherwise.  No larger minimum: the padding a linker puts
// between two objects' pieces of an over-aligned init array is a null entry, which the C
// runtime calls.
func elfSectAlign(s @asm.Section, machine int) int {
	var least int = 1
	if charsEqual(s.Name, "text") { least = 4 }
	if (s.Flags & asm.SF_EXEC) != 0 && machine == EM_AARCH64 { least = 4 }
	if s.Align > least { return s.Align }
	return least
}

// elfSectFlags returns the ELF section flags (SHF_*) for a section's flags (asm.SF_*): a
// readable section is allocated (loaded), and writable, executable or thread-local as its
// flags say.
func elfSectFlags(flags int) uint64 {
	var f uint64 = 0
	if (flags & asm.SF_READ) != 0 { f = f | SHF_ALLOC }
	if (flags & asm.SF_WRITE) != 0 { f = f | SHF_WRITE }
	if (flags & asm.SF_EXEC) != 0 { f = f | SHF_EXECINSTR }
	if (flags & asm.SF_TLS) != 0 { f = f | SHF_TLS }
	return f
}

// elfSectionsOk reports whether an ELF object can express every section of a, else sets the
// error: thread_vars is Mach-O's table of thread-local variable descriptors, which ELF has none
// of (an ELF thread-local object is its bytes in tdata or tbss, reached by its offset).
func elfSectionsOk(a @asm.Assembler) bool {
	for i := 0; i < a.NumSections; i++ {
		if !charsEqual(a.Sections[i].Name, "thread_vars") { continue }
		a.SetError(
				"elf: section 'thread_vars' is Mach-O's thread-local variable descriptors, "
						"which an ELF object has none of")
		return false
	}
	return true
}

// elfSymType returns the ELF symbol type (STT_*) for sym: its Type, as `.type` (or SetType, a
// common, or a label in a thread-local section) gave it — clang types a symbol by nothing else,
// so one with none is STT_NOTYPE wherever it is defined.  The native backends type their
// functions (common.EmitObject), which a linker interworking a Thumb caller into A32 code needs.
func elfSymType(sym asm.Symbol) int {
	if sym.Type == asm.SYM_TLS { return STT_TLS }
	if sym.Type == asm.SYM_OBJECT { return STT_OBJECT }
	if sym.Type == asm.SYM_FUNC { return STT_FUNC }
	if sym.Type == asm.SYM_IFUNC { return STT_GNU_IFUNC }
	return STT_NOTYPE
}

// --- Relocation mapping ---

// elfRelocType maps an assembler fixup kind to the ELF relocation type
// for the given machine. Returns -1 for an unmapped (kind, machine)
// combination — the caller (elf.Write) MUST treat that as an error, not
// emit it: ELF reloc type 0 is R_<arch>_NONE (a linker no-op), so emitting
// it would silently drop the relocation and leave the patched field
// unrelocated (a silent miscompile).  Mirrors machoRelocType's -1 contract.
// plain reports whether the relocation is to a symbol with no addend of its own — as
// the assembler records the target, an `=` alias of a symbol not defined here folded into
// that symbol plus offset.
// On x86-64 a call / jump rel32 (FIX_REL32) to a plain target is R_X86_64_PLT32, as
// clang emits it — defined here or not, global, weak or local (a local one against its
// section's symbol): a linker resolves it directly in an executable and through the PLT
// where the symbol may be preempted (a shared object, which rejects PC32 against such a
// symbol).  With an addend it is R_X86_64_PC32: a PLT stub plus an addend is no address
// in the callee (`call ext+8`, as clang emits it).  clang takes the alias by its name
// instead — `E = ext + 8`, `call E` is its PLT32 ext+4, which a PLT stub would misroute;
// here it is PC32.  Other machines route branches through linker-synthesized veneers
// regardless of the relocation type, so they ignore plain.
func elfRelocType(fixKind int, machine int, plain bool) int {
	if asm.DataFixupSize(fixKind) > 0 { return elfDataRelocType(fixKind, machine) }
	if machine == EM_AARCH64 {
		var tls int = elfTlsRelocType(fixKind)
		if tls >= 0 { return tls }
		if fixKind == 100 { return R_AARCH64_JUMP26 }
		if fixKind == 101 { return R_AARCH64_CONDBR19 }
		if fixKind == 113 { return R_AARCH64_LD_PREL_LO19 } // FIX_LD_PREL_LO19
		if fixKind == 102 { return R_AARCH64_ADR_PREL_LO21 }
		if fixKind == 103 { return R_AARCH64_ADR_PREL_PG_HI21 }
		if fixKind == 104 { return R_AARCH64_TSTBR14 }
		if fixKind == 105 { return R_AARCH64_ADD_ABS_LO12_NC } // FIX_ADD_LO12
		// The lo12 load/store kinds carry the access size, which selects the
		// LDST reloc of the matching imm12 scale; FIX_LD_GOT_LO12 is always an
		// 8-byte access of the GOT slot.
		if fixKind == 106 { return R_AARCH64_LDST64_ABS_LO12_NC } // FIX_LDR_LO12
		if fixKind == 109 { return R_AARCH64_LDST8_ABS_LO12_NC } // FIX_LDST8_LO12
		if fixKind == 110 { return R_AARCH64_LDST16_ABS_LO12_NC } // FIX_LDST16_LO12
		if fixKind == 111 { return R_AARCH64_LDST32_ABS_LO12_NC } // FIX_LDST32_LO12
		if fixKind == 112 { return R_AARCH64_LDST128_ABS_LO12_NC } // FIX_LDST128_LO12
		if fixKind == 107 { return R_AARCH64_ADR_GOT_PAGE } // FIX_ADRP_GOT_HI21
		if fixKind == 108 { return R_AARCH64_LD64_GOT_LO12_NC } // FIX_LD_GOT_LO12
		if fixKind == 0 { return R_AARCH64_ABS64 }
		if fixKind == 114 { return R_AARCH64_ABS32 } // FIX_ABS32
		if fixKind == 115 { return R_AARCH64_MOVW_UABS_G0 } // FIX_MOVW_UABS_G0
		if fixKind == 116 { return R_AARCH64_MOVW_UABS_G0_NC } // FIX_MOVW_UABS_G0_NC
		if fixKind == 117 { return R_AARCH64_MOVW_UABS_G1 } // FIX_MOVW_UABS_G1
		if fixKind == 118 { return R_AARCH64_MOVW_UABS_G1_NC } // FIX_MOVW_UABS_G1_NC
		if fixKind == 119 { return R_AARCH64_MOVW_UABS_G2 } // FIX_MOVW_UABS_G2
		if fixKind == 120 { return R_AARCH64_MOVW_UABS_G2_NC } // FIX_MOVW_UABS_G2_NC
		if fixKind == 121 { return R_AARCH64_MOVW_UABS_G3 } // FIX_MOVW_UABS_G3
		if fixKind == 122 { return R_AARCH64_MOVW_SABS_G0 } // FIX_MOVW_SABS_G0
		if fixKind == 123 { return R_AARCH64_MOVW_SABS_G1 } // FIX_MOVW_SABS_G1
		if fixKind == 124 { return R_AARCH64_MOVW_SABS_G2 } // FIX_MOVW_SABS_G2
		if fixKind == 125 { return R_AARCH64_MOVW_PREL_G0 } // FIX_MOVW_PREL_G0
		if fixKind == 126 { return R_AARCH64_MOVW_PREL_G0_NC } // FIX_MOVW_PREL_G0_NC
		if fixKind == 127 { return R_AARCH64_MOVW_PREL_G1 } // FIX_MOVW_PREL_G1
		if fixKind == 128 { return R_AARCH64_MOVW_PREL_G1_NC } // FIX_MOVW_PREL_G1_NC
		if fixKind == 129 { return R_AARCH64_MOVW_PREL_G2 } // FIX_MOVW_PREL_G2
		if fixKind == 130 { return R_AARCH64_MOVW_PREL_G2_NC } // FIX_MOVW_PREL_G2_NC
		if fixKind == 131 { return R_AARCH64_MOVW_PREL_G3 } // FIX_MOVW_PREL_G3
		if fixKind == 132 { return R_AARCH64_ADR_PREL_PG_HI21_NC } // FIX_ADRP_HI21_NC
		if fixKind == 133 { return R_AARCH64_LD64_GOTPAGE_LO15 } // FIX_LD_GOTPAGE_LO15
		if fixKind == 134 { return R_AARCH64_GOT_LD_PREL19 } // FIX_LD_GOT_PREL19
	}
	if machine == EM_ARM {
		if fixKind == 200 { return R_ARM_JUMP24 }
		if fixKind == 201 { return R_ARM_ABS32 }
		if fixKind == 202 { return R_ARM_MOVW_ABS_NC }
		if fixKind == 203 { return R_ARM_MOVT_ABS }
		if fixKind == 204 { return R_ARM_LDR_PC_G0 } // FIX_LDR_PC_G0
		if fixKind == 205 { return R_ARM_LDRS_PC_G0 } // FIX_LDRS_PC_G0
		if fixKind == 206 { return R_ARM_ALU_PC_G0 } // FIX_ALU_PC_G0
		if fixKind == 207 { return R_ARM_MOVW_PREL_NC } // FIX_MOVW_PREL_NC
		if fixKind == 208 { return R_ARM_MOVT_PREL } // FIX_MOVT_PREL
		if fixKind == 0 { return R_ARM_ABS32 }
	}
	if machine == EM_X86_64 {
		if fixKind == 300 {
			// FIX_REL32 (CALL/JMP/Jcc rel32)
			if plain { return R_X86_64_PLT32 }
			return R_X86_64_PC32
		}
		if fixKind == 301 { return R_X86_64_64 } // FIX_ABS64
		if fixKind == 302 { return R_X86_64_PC32 } // FIX_REL32_LEA (local data)
		if fixKind == 303 { return R_X86_64_REX_GOTPCRELX } // FIX_GOTPCREL
		if fixKind == 0 { return R_X86_64_64 } // generic absolute
	}
	return -1
}

// elfRelocAddend returns the r_addend to store for a relocation, applying
// the per-arch PC-relative correction.  x86-64 PC32 (CALL/JMP/Jcc rel32
// and RIP-relative disp32) is field-relative, but the displacement is
// measured from the END of the instruction — 4 bytes past the field's
// start, plus any immediate after it, which the assembler has already
// taken off the fixup's addend — so RELA needs `addend - 4`, matching the
// in-section patchRel32's `target - (fixup + 4)`.  Omitting it lands every
// cross-object call 4 bytes past the callee, skipping its `push %rbp; mov
// %rsp,%rbp` prologue → frame corruption → crash.  AArch64 / ARM branch
// relocs are instruction-relative (no -4); Mach-O carries the -4
// implicitly in its branch reloc, so only the ELF path corrects it.
// rtype is the value from elfRelocType.  R_X86_64_PLT32 shares PC32's
// end-of-field semantics, so it takes the same -4 correction.
//
// ARM has NO case here: EM_ARM emits REL relocations (no r_addend word), so
// every ARM addend — including the -8 branch pipeline bias — is baked into the
// instruction field by arm32.ResolveFixups (bakeRelAddend), not returned here.
// This function is only consulted for the RELA machines (aarch64/x86-64).
func elfRelocAddend(rtype int, machine int, addend int64) int64 {
	// GOTPCREL (mov r64, sym@GOTPCREL(%rip)) shares PC32's end-of-field
	// semantics — the disp32 is measured from the end of the instruction — so
	// it takes the same -4 correction, or the reloc lands 4 bytes off.
	if machine == EM_X86_64 &&
			(rtype == R_X86_64_PC32 || rtype == R_X86_64_PLT32 || rtype == R_X86_64_REX_GOTPCRELX) {
		return addend - 4
	}
	return addend
}

// countRelocsForSection returns the number of relocations in a.Relocs
// that reference section si.
func countRelocsForSection(a @asm.Assembler, si int) int {
	var count int = 0
	for i := 0; i < a.NumRelocs; i++ {
		if a.Relocs[i].Section == si { count = count + 1 }
	}
	return count
}

// --- Section header emission ---

// emitShdr writes one ELF section header entry (Elf32_Shdr or Elf64_Shdr)
// to the binary buffer, using 4- or 8-byte fields based on is64.
func emitShdr(bb BinBuf, is64 bool, name uint32, shtype uint32, flags int, addr int, offset int,
		size int, link uint32, info uint32, addralign int, entsize int) BinBuf {
	bb = bb.WriteU32(name)
	bb = bb.WriteU32(shtype)
	bb = bb.WriteAddr(flags, is64)
	bb = bb.WriteAddr(addr, is64)
	bb = bb.WriteAddr(offset, is64)
	bb = bb.WriteAddr(size, is64)
	bb = bb.WriteU32(link)
	bb = bb.WriteU32(info)
	bb = bb.WriteAddr(addralign, is64)
	bb = bb.WriteAddr(entsize, is64)
	return bb
}

// isBlWord reports whether the little-endian instruction word at off in data is an
// AArch64 BL (bits 31:26 = 100101), as opposed to a B.
func isBlWord(data @[]uint8, off int) bool {
	if off < 0 || off + 4 > len(data) { return false }
	return (data[off + 3] & 0xFC) == 0x94
}

// isArmBlWord reports whether the little-endian instruction word at off in data is an
// unconditional arm32 BL (cond AL, bits 27:24 = 1011: top byte 0xEB).
func isArmBlWord(data @[]uint8, off int) bool {
	if off < 0 || off + 4 > len(data) { return false }
	return data[off + 3] == 0xEB
}
