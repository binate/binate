package "pkg/binate/asm/elf"

import "pkg/builtins/testing"

// Test helper fail() is in elf_test.bn

// --- BinBuf tests ---

func TestWriteU8() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU8(0x42)
	if b.Len != 1 || b.Data[0] != 0x42 {
		return fail("WriteU8 wrong")
	}
	return ""
}

func TestWriteU16() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU16(0x1234)
	if b.Len != 2 { return fail("WriteU16 length wrong") }
	// Little-endian: 0x34, 0x12
	if b.Data[0] != 0x34 || b.Data[1] != 0x12 {
		return fail("WriteU16 encoding wrong")
	}
	return ""
}

func TestWriteU32() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU32(0xDEADBEEF)
	if b.Len != 4 { return fail("WriteU32 length wrong") }
	if b.Data[0] != 0xEF || b.Data[1] != 0xBE {
		return fail("WriteU32 low bytes wrong")
	}
	if b.Data[2] != 0xAD || b.Data[3] != 0xDE {
		return fail("WriteU32 high bytes wrong")
	}
	return ""
}

func TestWriteZeros() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteZeros(4)
	if b.Len != 4 { return fail("WriteZeros length wrong") }
	for i := 0; i < 4; i++ {
		if b.Data[i] != 0 { return fail("WriteZeros not zero") }
	}
	return ""
}

func TestAlign() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteU8(1)  // 1 byte
	b = b.Align(4)  // align to 4 -> should pad 3 bytes
	if b.Len != 4 { return fail("Align length wrong") }
	return ""
}

// --- String table tests ---

func TestStrTab() testing.TestResult {
	var st StrTab = newStrTab()
	var off1 int = strTabAdd(&st, "hello")
	var off2 int = strTabAdd(&st, "world")
	// First byte is null (0), then "hello\0" at offset 1, "world\0" after
	if off1 != 1 { return fail("first string offset wrong") }
	if off2 != 7 { return fail("second string offset wrong") }
	return ""
}

// --- Section mapping tests ---

func TestElfSectFlags() testing.TestResult {
	var textFlags uint64 = elfSectFlags("text")
	if textFlags != (SHF_ALLOC | SHF_EXECINSTR) {
		return fail("text flags wrong")
	}
	var dataFlags uint64 = elfSectFlags("data")
	if dataFlags != (SHF_ALLOC | SHF_WRITE) {
		return fail("data flags wrong")
	}
	var roFlags uint64 = elfSectFlags("rodata")
	if roFlags != SHF_ALLOC {
		return fail("rodata flags wrong")
	}
	return ""
}

func TestElfSectType() testing.TestResult {
	if elfSectType("text") != SHT_PROGBITS {
		return fail("text type wrong")
	}
	if elfSectType("bss") != SHT_NOBITS {
		return fail("bss type wrong")
	}
	return ""
}

// --- WriteAddr tests ---

func TestWriteAddr64() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteAddr(0x100, true)
	if b.Len != 8 { return fail("WriteAddr 64-bit should be 8 bytes") }
	if b.Data[0] != 0x00 || b.Data[1] != 0x01 {
		return fail("WriteAddr 64-bit value wrong")
	}
	return ""
}

func TestWriteAddr32() testing.TestResult {
	var b BinBuf = newBinBuf()
	b = b.WriteAddr(0x100, false)
	if b.Len != 4 { return fail("WriteAddr 32-bit should be 4 bytes") }
	if b.Data[0] != 0x00 || b.Data[1] != 0x01 {
		return fail("WriteAddr 32-bit value wrong")
	}
	return ""
}

// --- Relocation type / addend tests ---

// An x86-64 CALL rel32 (FIX_REL32 = 300) must be R_X86_64_PLT32 when the
// target symbol is undefined (extern) — PC32 against an undefined symbol is
// rejected by a PIE link — and R_X86_64_PC32 when it is defined (local).
func TestElfRelocTypeX64Rel32PltVsPc() testing.TestResult {
	if elfRelocType(300, EM_X86_64, true) != R_X86_64_PLT32 {
		return fail("FIX_REL32 to undefined symbol must be PLT32")
	}
	if elfRelocType(300, EM_X86_64, false) != R_X86_64_PC32 {
		return fail("FIX_REL32 to defined symbol must stay PC32")
	}
	return ""
}

// A RIP-relative data LEA (FIX_REL32_LEA = 302) always targets a local
// defined label, so it stays PC32 regardless of the symUndefined flag.
func TestElfRelocTypeX64LeaStaysPc32() testing.TestResult {
	if elfRelocType(302, EM_X86_64, false) != R_X86_64_PC32 {
		return fail("FIX_REL32_LEA (defined) must be PC32")
	}
	if elfRelocType(302, EM_X86_64, true) != R_X86_64_PC32 {
		return fail("FIX_REL32_LEA must be PC32 even with symUndefined set")
	}
	return ""
}

// Other machines route undefined branch targets through linker PLT veneers
// regardless of reloc type, so symUndefined does not change their mapping:
// an AArch64 branch (FIX_BRANCH26 = 100) stays JUMP26 either way.
func TestElfRelocTypeAArch64IgnoresUndefined() testing.TestResult {
	if elfRelocType(100, EM_AARCH64, true) != R_AARCH64_JUMP26 {
		return fail("AArch64 branch must be JUMP26 (undefined)")
	}
	if elfRelocType(100, EM_AARCH64, false) != R_AARCH64_JUMP26 {
		return fail("AArch64 branch must be JUMP26 (defined)")
	}
	return ""
}

// PLT32 shares PC32's end-of-field semantics, so it takes the same -4 addend
// correction on x86-64; non-x86-64 and absolute relocs are untouched.
func TestElfRelocAddendPlt32GetsMinus4() testing.TestResult {
	if elfRelocAddend(R_X86_64_PLT32, EM_X86_64, 0) != -4 {
		return fail("PLT32 addend must be corrected by -4")
	}
	if elfRelocAddend(R_X86_64_PC32, EM_X86_64, 0) != -4 {
		return fail("PC32 addend must be corrected by -4")
	}
	if elfRelocAddend(R_X86_64_64, EM_X86_64, 7) != 7 {
		return fail("absolute reloc addend must be unchanged")
	}
	return ""
}
