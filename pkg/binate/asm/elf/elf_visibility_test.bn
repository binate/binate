package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Symbol visibilities (asm.Symbol.Visibility) in an ELF object: each symbol's st_other is
// its visibility, a local's included, as clang writes them (`.hidden`, `.internal`,
// `.protected`).  (c26Read is in elf_call26_test.bn, tmpSymtab / tmpNameIs in
// elf_symtab_test.bn, rdU16 / rdU32 in elf_test.bn.)

// visProgram returns an assembler holding a global hidden a, a local internal b, a global
// protected d, a weak hidden w, a local hidden loc, a default global g — each a label before
// the instruction insn — and an undefined global hidden u.
func visProgram(wordSize int, insn uint32) @asm.Assembler {
	var a @asm.Assembler = asm.New(wordSize)
	a.ObjFormat = asm.OBJ_ELF
	a.SetSection("text", -1)
	a.DefineLabel("a")
	a.EmitUint32(insn)
	a.DefineLabel("b")
	a.EmitUint32(insn)
	a.DefineLabel("d")
	a.EmitUint32(insn)
	a.DefineLabel("w")
	a.EmitUint32(insn)
	a.DefineLabel("loc")
	a.EmitUint32(insn)
	a.DefineLabel("g")
	a.EmitUint32(insn)
	a.SetGlobal("a")
	a.SetVisibility("a", asm.VIS_HIDDEN)
	a.SetVisibility("b", asm.VIS_INTERNAL)
	a.SetGlobal("d")
	a.SetVisibility("d", asm.VIS_PROTECTED)
	a.SetWeak("w")
	a.SetVisibility("w", asm.VIS_HIDDEN)
	a.SetVisibility("loc", asm.VIS_HIDDEN)
	a.SetGlobal("g")
	a.SetGlobal("u")
	a.SetVisibility("u", asm.VIS_HIDDEN)
	return a
}

// visWant is each symbol visProgram names and the st_other clang gives it.
func visWant(i int) (*[]readonly char, int) {
	if i == 0 { return "a", asm.VIS_HIDDEN }
	if i == 1 { return "b", asm.VIS_INTERNAL }
	if i == 2 { return "d", asm.VIS_PROTECTED }
	if i == 3 { return "w", asm.VIS_HIDDEN }
	if i == 4 { return "loc", asm.VIS_HIDDEN }
	if i == 5 { return "g", asm.VIS_DEFAULT }
	return "u", asm.VIS_HIDDEN
}

// An ELF64 (AArch64) object's st_other is each symbol's visibility.
func TestWriteElfVisibility() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = visProgram(8, 0xD503201F)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/vis.o")
	if !WriteAArch64(a, path) { return fail("failed to write ELF") }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	symOff, nsyms, _, strOff := tmpSymtab(b)
	if symOff < 0 { return fail("no symbol table") }
	for w := 0; w < 7; w++ {
		name, vis := visWant(w)
		var found bool = false
		for i := 1; i < nsyms; i++ {
			var e int = symOff + i * 24
			if !tmpNameIs(b, strOff + rdU32(b, e), name) { continue }
			found = true
			if cast(int, b[e + 5]) != vis { return fail(buf.Concat("wrong st_other for ", name)) }
		}
		if !found { return fail(buf.Concat("not listed: ", name)) }
	}
	return ""
}

// An ELF32 (arm32) object's st_other is each symbol's visibility.
func TestWriteElf32Visibility() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = visProgram(4, 0xE320F000)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/vis32.o")
	if !WriteARM32(a, path, false) { return fail("failed to write ELF32") }
	b, n := c26Read(path)
	if n < 100 { return fail("cannot read back the ELF32 object") }
	var shoff int = rdU32(b, 32)
	var shentsize int = rdU16(b, 46)
	var shnum int = rdU16(b, 48)
	var symOff int = -1
	var nsyms int = 0
	var strOff int = 0
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if rdU32(b, sh + 4) != cast(int, SHT_SYMTAB) { continue }
		symOff = rdU32(b, sh + 16)
		nsyms = rdU32(b, sh + 20) / 16
		strOff = rdU32(b, shoff + rdU32(b, sh + 24) * shentsize + 16)
	}
	if symOff < 0 { return fail("no symbol table") }
	for w := 0; w < 7; w++ {
		name, vis := visWant(w)
		var found bool = false
		for k := 1; k < nsyms; k++ {
			var e int = symOff + k * 16
			if !tmpNameIs(b, strOff + rdU32(b, e), name) { continue }
			found = true
			if cast(int, b[e + 13]) != vis { return fail(buf.Concat("wrong st_other for ", name)) }
		}
		if !found { return fail(buf.Concat("not listed: ", name)) }
	}
	return ""
}
