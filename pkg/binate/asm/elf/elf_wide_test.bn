package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A zero-fill section past a 32-bit host's int and uint in an ELF object: its header's
// sh_size and the value of a symbol in it are the target's, whatever the host.  (c26Read is
// in elf_call26_test.bn, elfShdrNamed in elf_layout_test.bn, tmpSymtab / tmpNameIs in
// elf_symtab_test.bn, rdU16 / rdU32 / rdW32 / rdI64 in elf_test.bn.)

// symValue64 returns the st_value of the symbol named name in the ELF64 object b, or -1 when
// it lists none.
func symValue64(b @[]uint8, name *[]readonly char) int64 {
	symOff, n, _, strOff := tmpSymtab(b)
	for i := 1; i < n; i++ {
		var e int = symOff + i * 24
		if tmpNameIs(b, strOff + rdU32(b, e), name) { return rdI64(b, e + 8) }
	}
	return -1
}

// An ELF64 .bss of 2^32 + 16 bytes: its sh_size is that, and a symbol after its first 2^32
// bytes has st_value 2^32.
func TestWriteElfBssPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	aarch64.Ret(a)
	a.SetSection("bss", -1)
	a.DefineLabel("lo")
	a.Zero(0x100000000)
	a.DefineLabel("hi")
	a.Zero(16)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/elf_bss_wide.o")
	if !WriteAArch64(a, path) { return fail(a.ErrorMsg) }
	b, n := c26Read(path)
	if n < 200 { return fail("cannot read back the ELF object") }
	var sh int = elfShdrNamed(b, ".bss")
	if sh < 0 { return fail("no .bss section header") }
	if rdI64(b, sh + 32) != 0x100000010 { return fail(".bss's sh_size is not 2^32 + 16") }
	if symValue64(b, "hi") != 0x100000000 { return fail("hi's st_value is not 2^32") }
	return ""
}

// An ELF32 object's sizes are 32 bits: a .bss of 4 GiB (which an assembler of 8-byte words
// counts) is an error, not a truncated sh_size, and one of 4 GiB - 1 is written.
func TestWriteElf32BssPast4GiBIsError() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/elf32_bss_4gib.o")
	for over := 0; over < 2; over++ {
		var a @asm.Assembler = asm.New(8)
		a.SetSection("text", -1)
		a.EmitUint32(0xE320F000)
		a.SetSection("bss", -1)
		a.Zero(0xFFFFFFFF + cast(int64, over))
		a.Finalize()
		if a.HasError { return fail(a.ErrorMsg) }
		var ok bool = WriteARM32(a, path)
		if over == 0 && !ok { return fail(buf.Concat("an ELF32 .bss of 4 GiB - 1: ", a.ErrorMsg)) }
		if over == 1 && (ok || !elfHas(a.ErrorMsg, "larger than 4 GiB")) {
			return fail("an ELF32 .bss of 4 GiB was written")
		}
	}
	return ""
}

// An ELF32 .bss of 3 GiB (past 2^31, within a 32-bit target's 4 GiB): its sh_size, and the
// st_value of a symbol at 3 GiB, are 0xC0000000.
func TestWriteElf32BssPast2GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(4)
	a.SetSection("text", -1)
	a.EmitUint32(0xE320F000)
	a.SetSection("bss", -1)
	a.Zero(0xC0000000)
	a.DefineLabel("hi")
	a.Zero(4)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/elf32_bss_wide.o")
	if !WriteARM32(a, path) { return fail("failed to write ELF32") }
	b, n := c26Read(path)
	if n < 100 { return fail("cannot read back the ELF32 object") }
	var shoff int = rdU32(b, 32)
	var shentsize int = rdU16(b, 46)
	var shnum int = rdU16(b, 48)
	var strtab int = rdU32(b, shoff + rdU16(b, 50) * shentsize + 16)
	var sawBss bool = false
	var sawHi bool = false
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if tmpNameIs(b, strtab + rdU32(b, sh), ".bss") {
			sawBss = true
			if rdW32(b, sh + 20) != 0xC0000004 { return fail(".bss's sh_size is not 3 GiB + 4") }
		}
		if rdU32(b, sh + 4) != cast(int, SHT_SYMTAB) { continue }
		var symOff int = rdU32(b, sh + 16)
		var nsyms int = rdU32(b, sh + 20) / 16
		var strOff int = rdU32(b, shoff + rdU32(b, sh + 24) * shentsize + 16)
		for k := 1; k < nsyms; k++ {
			var e int = symOff + k * 16
			if !tmpNameIs(b, strOff + rdU32(b, e), "hi") { continue }
			sawHi = true
			if rdW32(b, e + 4) != 0xC0000000 { return fail("hi's st_value is not 3 GiB") }
		}
	}
	if !sawBss || !sawHi { return fail("no .bss section header or no symbol hi") }
	return ""
}
