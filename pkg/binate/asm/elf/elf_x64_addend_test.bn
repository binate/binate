package "pkg/binate/asm/elf"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// An x86-64 branch to an undefined symbol with an addend is R_X86_64_PC32, not PLT32 —
// a PLT stub plus an addend is no address in the callee — as clang emits `call ext+8`
// (R_X86_64_PC32 ext+4), while a plain call stays PLT32.  (rdU16 / rdU32 / rdU64 /
// testTmpDir are in elf_test.bn.)

// x64AddendRelocs writes an object with a CALL to undefined ext, then one to ext+8, and
// returns the type and r_addend of each relocation, in order, or a failure.
func x64AddendRelocs() (@[]int, @[]int, testing.TestResult) {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetGlobal("ext")
	x64.Call(a, "ext")
	x64.CallAddend(a, "ext", 8)
	return x64WriteRelocs(a, 2)
}

// x64WriteRelocs resolves a's fixups, writes it as an ELF object, and returns the type and
// r_addend of each of its count relocations, in order, or a failure.
func x64WriteRelocs(a @asm.Assembler, count int) (@[]int, @[]int, testing.TestResult) {
	var types @[]int = make_slice(int, count)
	var addends @[]int = make_slice(int, count)
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return types, addends, "cannot create a temporary directory" }
	defer { os.RemoveAll(dir) }
	x64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return types, addends, "assembler error" }
	var path @[]char = buf.Concat(dir, "/x64_addend.o")
	if !WriteX86_64(a, path) { return types, addends, "failed to write ELF" }
	f, oerr := os.Open(path)
	if present(oerr) { return types, addends, "cannot open ELF file" }
	var bufv @[]uint8 = make_slice(uint8, 16384)
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = bufv
	n, _ := f.Read(raw)
	_ = f.Close()
	if n < 200 { return types, addends, "ELF file too small" }
	var shoff int = rdU64(raw, 40)
	var shentsize int = rdU16(raw, 58)
	var shnum int = rdU16(raw, 60)
	var relaOff int = -1
	var relaSize int = 0
	for i := 0; i < shnum; i++ {
		var sh int = shoff + i * shentsize
		if rdU32(raw, sh + 4) == cast(int, SHT_RELA) {
			relaOff = rdU64(raw, sh + 24)
			relaSize = rdU64(raw, sh + 32)
		}
	}
	if relaOff < 0 || relaSize != 24 * count {
		return types, addends, "not the expected number of relocations"
	}
	for k := 0; k < count; k++ {
		types[k] = rdU32(raw, relaOff + k * 24 + 8)
		addends[k] = rdU64(raw, relaOff + k * 24 + 16)
	}
	return types, addends, ""
}

// The plain call is PLT32 ext-4; the call to ext+8 is PC32 ext+4 (r_addend: the addend
// minus the rel32's end-of-field bias).
func TestWriteElfX64BranchAddendIsPc32() testing.TestResult {
	types, addends, err := x64AddendRelocs()
	if len(err) > 0 { return err }
	if types[0] != R_X86_64_PLT32 || addends[0] != -4 {
		return fail("plain call to ext not PLT32 ext-4")
	}
	if types[1] != R_X86_64_PC32 || addends[1] != 4 { return fail("call to ext+8 not PC32 ext+4") }
	return ""
}

// A RIP-relative operand followed by an immediate is R_X86_64_PC32 with r_addend the operand's
// addend less 4 and the immediate's size, as clang emits `add dword ptr [rip + ext], 5`
// (ext-5), `cmp byte ptr [rip + ext + 8], 1` (ext+3), `imul ecx, dword ptr [rip + ext], 1000`
// (ext-8) and `mov word ptr [rip + ext], 7` (ext-6).
func TestWriteElfX64RipImmediateAddends() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetGlobal("ext")
	var d x64.Operand = x64.RipLabel("ext")
	d.Size = x64.SZ32
	x64.Add(a, d, x64.Imm(5))
	var b x64.Operand = x64.RipLabelAddend("ext", 8)
	b.Size = x64.SZ8
	x64.Cmp(a, b, x64.Imm(1))
	x64.Imul3(a, x64.Reg(x64.RCX, x64.SZ32), x64.RipLabel("ext"), 1000)
	var w x64.Operand = x64.RipLabel("ext")
	w.Size = x64.SZ16
	x64.Mov(a, w, x64.Imm(7))
	types, addends, err := x64WriteRelocs(a, 4)
	if len(err) > 0 { return err }
	for k := 0; k < 4; k++ {
		if types[k] != R_X86_64_PC32 { return fail("a RIP-relative reference not PC32") }
	}
	if addends[0] != -5 { return fail("add dword ptr [rip + ext], 5: not ext-5") }
	if addends[1] != 3 { return fail("cmp byte ptr [rip + ext + 8], 1: not ext+3") }
	if addends[2] != -8 { return fail("imul ecx, dword ptr [rip + ext], 1000: not ext-8") }
	if addends[3] != -6 { return fail("mov word ptr [rip + ext], 7: not ext-6") }
	return ""
}
