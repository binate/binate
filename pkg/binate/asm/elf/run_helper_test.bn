// Package-local test helper: run an external tool to completion via
// pkg/std/os/process, returning the plain exit-code int the harnesses read (the
// child's exit code, or -1 on a start error or a signal death).  SearchPath
// reproduces execvp's always-search — a '/'-bearing path is used directly — so a
// bare tool name ("cc") searches PATH and an absolute exePath runs directly.
package "pkg/binate/asm/elf"

import "pkg/std/errors"
import "pkg/std/os/process"

// execExit runs prog with args (argv[1..]) and returns its exit code, or -1 if it
// could not be started or was killed by a signal.
func execExit(prog *[]readonly char, args @[]@[]char) int {
	var st process.ExitStatus
	var err @errors.Error
	st, err = process.Run(prog, &process.Options{SearchPath: true, Args: args})
	if present(err) {
		return -1
	}
	if !st.Exited() {
		return -1
	}
	return st.Code()
}
