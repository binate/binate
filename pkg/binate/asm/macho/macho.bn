package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/std/os"
import "pkg/std/strings"

// --- Mach-O section name mapping ---

// Map assembler section name to Mach-O segment/section names
func machoSegName(name *[]readonly char) *[]readonly char {
	if charsEqual(name, "text") { return "__TEXT" }
	if charsEqual(name, "rodata") { return "__TEXT" }
	// Relocatable read-only data: __DATA_CONST is the segment ld marks
	// read-only after applying fixups (SG_READ_ONLY), so its __const may
	// bear relocations — unlike __TEXT,__const, which rejects them.
	if charsEqual(name, "rodata_relro") { return "__DATA_CONST" }
	if charsEqual(name, "data") { return "__DATA" }
	if charsEqual(name, "bss") { return "__DATA" }
	return "__DATA"
}

// machoSectName maps an assembler section name to a Mach-O section name.
// Returns a borrowed pointer to a string literal — valid for the program lifetime.
func machoSectName(name *[]readonly char) *[]readonly char {
	if charsEqual(name, "text") { return "__text" }
	if charsEqual(name, "rodata") { return "__const" }
	// __DATA_CONST,__const — same section name as __TEXT,__const, placed in
	// the read-only-after-fixup segment via machoSegName.
	if charsEqual(name, "rodata_relro") { return "__const" }
	if charsEqual(name, "data") { return "__data" }
	if charsEqual(name, "bss") { return "__bss" }
	return name
}

// machoSectType returns the Mach-O section type for a section name.
func machoSectType(name *[]readonly char) uint32 {
	if charsEqual(name, "bss") { return S_ZEROFILL }
	return S_REGULAR
}

// machoSectAttrs returns the Mach-O section attributes for a section name.
func machoSectAttrs(name *[]readonly char) uint32 {
	if charsEqual(name, "text") {
		return S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
	}
	return 0
}

// machoSectAlign returns the Mach-O section alignment as a power-of-2 exponent
// (align field is 2^N). Data holds 64-bit globals so must be 8-byte aligned;
// text instructions only need 4-byte alignment.
func machoSectAlign(name *[]readonly char) uint32 {
	if charsEqual(name, "data") { return 3 } // 2^3 = 8 bytes
	if charsEqual(name, "bss") { return 3 } // same
	// Relro holds pointer-bearing nodes/vtables whose ARM64_RELOC_UNSIGNED
	// slots ld requires 8-byte aligned ("pointer not aligned"), like __data.
	if charsEqual(name, "rodata_relro") { return 3 }
	return 2 // 2^2 = 4 bytes
}

// machoSectAlignFor returns a section's alignment exponent: the name-based default
// (machoSectAlign), raised to cover requested (a byte alignment from Align/AlignFill,
// 0 for none).
func machoSectAlignFor(name *[]readonly char, requested int) uint32 {
	var e uint32 = machoSectAlign(name)
	var need uint32 = 0
	var bytes int = 1
	for bytes < requested {
		bytes = bytes * 2
		need = need + 1
	}
	if need > e { return need }
	return e
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// --- String table builder ---

// StrTab builds a Mach-O string table: null-terminated strings preceded by
// a leading null byte. Buf is a managed Builder (the table accumulates in
// place); strTabAdd still returns the table for the offset it computes.
type StrTab struct {
	Buf @strings.Builder
}

// newStrTab creates a StrTab with the required leading null byte.
func newStrTab() StrTab {
	var st StrTab
	st.Buf = strings.NewBuilder()
	// String table starts with a null byte
	st.Buf.WriteByte(0)
	return st
}

// strTabAdd adds a string to the string table and returns the updated
// table and the string's offset.
func strTabAdd(st StrTab, s *[]readonly char) (StrTab, int) {
	var offset int = st.Buf.Len()
	st.Buf.Write(s)
	st.Buf.WriteByte(0)
	return st, offset
}

// --- Main write function ---

func Write(a @asm.Assembler, path *[]readonly char, cpu_type int, cpu_subtype int) bool {
	// One section header per assembler section, empty ones included (an empty
	// section is legal, and a symbol may be defined in one): nsects must count
	// exactly the headers written below.
	var nsects int = a.NumSections
	// Relocations against temporary labels go to the symbol starting their atom (or
	// a section-start anchor), so no temporary is listed (a listed one would split
	// the atom, and the classic linker would misresolve it).
	if !retargetTemporaryRelocs(a) { return false }

	// Build string table and nlist entries
	var strtab StrTab = newStrTab()
	var strOffsets @[]int = make_slice(int, a.NumSymbols)
	for i := 0; i < a.NumSymbols; i++ {
		// A CPrefix symbol (`.global_c`) carries the platform C-symbol prefix:
		// on Mach-O that is a leading `_`, matching what the compiler emits for
		// a Binate function on this platform.  This is the sole site that
		// materializes an emitted symbol name — the nlist reads strOffsets and
		// relocations resolve by symbol index — so both the definition and any
		// reference pick up the prefix here.  The partition/`L`-drop reads the
		// unprefixed .Name, so it is unaffected.
		var emitName @[]char = a.Symbols[i].Name
		if a.Symbols[i].CPrefix {
			emitName = buf.Concat("_", a.Symbols[i].Name)
		}
		strtab, strOffsets[i] = strTabAdd(strtab, emitName)
	}
	var strtabBytes @[]char = buf.CopyStr(strtab.Buf.String())
	var strtabSize int = len(strtabBytes)

	// Partition the symbol table into local / defined-external /
	// undefined runs so an LC_DYSYMTAB can name each range. ld needs
	// this to coalesce external-defined weak symbols (e.g. linkonce dtor
	// vtables) across objects; without it, two objects defining the same
	// weak symbol link-fail with "duplicate symbol". symOrder drives the
	// nlist emission below; symNewIndex remaps relocation r_symbolnum.
	var symOrder @[]int
	var symNewIndex @[]int
	var nLocalSym int
	var nExtDefSym int
	var nUndefSym int
	symOrder, symNewIndex, nLocalSym, nExtDefSym, nUndefSym = partitionSymbols(a)
	// L-prefixed temporary labels are dropped from the symbol table (see
	// partitionSymbols), so the EMITTED count is the partition sum, not
	// a.NumSymbols.  Drives symtab size / nsyms / the nlist loop bound.
	var nEmittedSym int = nLocalSym + nExtDefSym + nUndefSym

	// Calculate sizes
	// mach_header_64 = 32 bytes
	var headerSize int = 32
	// LC_SEGMENT_64 = 72 bytes + 80 bytes per section
	var segCmdSize int = 72 + nsects * 80
	// LC_SYMTAB = 24 bytes
	var symtabCmdSize int = 24
	// LC_DYSYMTAB = 80 bytes
	var dysymtabCmdSize int = 80
	// LC_BUILD_VERSION = 24 bytes (no tool entries)
	var buildVerCmdSize int = 24

	var ncmds int = 4 // LC_SEGMENT_64 + LC_SYMTAB + LC_DYSYMTAB + LC_BUILD_VERSION
	var sizeofcmds int = segCmdSize + symtabCmdSize + dysymtabCmdSize + buildVerCmdSize

	// Section data starts after header + load commands, on the largest alignment
	// any section needs (at least 8), so that every section's file offset can equal
	// dataOffset + its address and stay congruent with it modulo its alignment.
	var maxAlign int = 8
	for i := 0; i < a.NumSections; i++ {
		if a.Sections[i].Align > maxAlign { maxAlign = a.Sections[i].Align }
	}
	var dataOffset int = headerSize + sizeofcmds
	if dataOffset % maxAlign != 0 {
		dataOffset = dataOffset + (maxAlign - dataOffset % maxAlign)
	}

	// Section placement (see layoutSections): addresses, file offsets, header order.
	var lay machoLayout = layoutSections(a, dataOffset)
	var sectOffsets @[]int = lay.Offset
	var sectAddrs @[]int = lay.Addr
	var sectSizes @[]int = make_slice(int, a.NumSections)
	for i := 0; i < a.NumSections; i++ { sectSizes[i] = a.Sections[i].Len }
	// The relocation entries start 8-byte aligned after the regular sections' data.
	var currentOff int = dataOffset + lay.FileSize
	if currentOff % 8 != 0 { currentOff = currentOff + (8 - currentOff % 8) }
	var relocStart int = currentOff

	// Relocations follow section data
	// relocation_info = 8 bytes each
	var sectRelocOffs @[]int = make_slice(int, a.NumSections)
	var sectRelocCounts @[]int = make_slice(int, a.NumSections)
	for i := 0; i < a.NumSections; i++ {
		var nreloc int = countRelocsForSection(a, i, cpu_type)
		sectRelocCounts[i] = nreloc
		if nreloc > 0 {
			sectRelocOffs[i] = currentOff
			currentOff = currentOff + nreloc * 8
		}
	}

	// Symbol table follows relocations
	var symtabOff int = currentOff
	// nlist_64 = 16 bytes each
	var symtabSize int = nEmittedSym * 16

	// String table follows symbol table
	var strtabOff int = symtabOff + symtabSize

	// --- Build the file ---
	var bb BinBuf = newBinBuf()

	// mach_header_64
	bb = bb.WriteU32(MH_MAGIC_64)
	bb = bb.WriteU32(cast(uint32, cpu_type))
	bb = bb.WriteU32(cast(uint32, cpu_subtype))
	bb = bb.WriteU32(MH_OBJECT)
	bb = bb.WriteU32(cast(uint32, ncmds))
	bb = bb.WriteU32(cast(uint32, sizeofcmds))
	bb = bb.WriteU32(MH_SUBSECTIONS_VIA_SYMBOLS) // flags
	bb = bb.WriteU32(0) // reserved

	// LC_SEGMENT_64
	bb = bb.WriteU32(LC_SEGMENT_64)
	bb = bb.WriteU32(cast(uint32, segCmdSize))
	bb = bb.WriteFixedStr("", 16) // segname (empty for .o)
	bb = bb.WriteU64(0) // vmaddr
	bb = bb.WriteU64(cast(uint64, lay.VMSize)) // vmsize (zero-fill sections included)
	bb = bb.WriteU64(cast(uint64, dataOffset)) // fileoff
	bb = bb.WriteU64(cast(uint64, lay.FileSize)) // filesize (regular sections only)
	bb = bb.WriteU32(7) // maxprot (rwx)
	bb = bb.WriteU32(7) // initprot (rwx)
	bb = bb.WriteU32(cast(uint32, nsects))
	bb = bb.WriteU32(0) // flags

	// Section headers, in layout order (regular sections, then zero-fill ones)
	for h := 0; h < a.NumSections; h++ {
		var i int = lay.Order[h]
		// bnlint:allow managed-to-raw-assign - live @Assembler; Sections[i].Name outlives the read
		var secName *[]readonly char = a.Sections[i].Name
		bb = bb.WriteFixedStr(machoSectName(secName), 16) // sectname
		bb = bb.WriteFixedStr(machoSegName(secName), 16) // segname
		bb = bb.WriteU64(cast(uint64, sectAddrs[i])) // addr (relative for .o)
		bb = bb.WriteU64(cast(uint64, sectSizes[i])) // size
		bb = bb.WriteU32(cast(uint32, sectOffsets[i])) // offset
		bb = bb.WriteU32(machoSectAlignFor(secName, a.Sections[i].Align)) // align (2^N)
		bb = bb.WriteU32(cast(uint32, sectRelocOffs[i])) // reloff
		bb = bb.WriteU32(cast(uint32, sectRelocCounts[i])) // nreloc
		var stype uint32 = machoSectType(secName)
		var sattrs uint32 = machoSectAttrs(secName)
		bb = bb.WriteU32(stype | sattrs) // flags
		bb = bb.WriteU32(0) // reserved1
		bb = bb.WriteU32(0) // reserved2
		bb = bb.WriteU32(0) // reserved3
	}

	// LC_SYMTAB
	bb = bb.WriteU32(LC_SYMTAB)
	bb = bb.WriteU32(cast(uint32, symtabCmdSize))
	bb = bb.WriteU32(cast(uint32, symtabOff))
	bb = bb.WriteU32(cast(uint32, nEmittedSym))
	bb = bb.WriteU32(cast(uint32, strtabOff))
	bb = bb.WriteU32(cast(uint32, strtabSize))

	// LC_DYSYMTAB — names the local / defined-external / undefined ranges
	// of the (partitioned) symbol table. Required for ld to treat
	// external-defined weak symbols as coalescing candidates across
	// objects; without it ld link-fails on duplicate weak defs. All the
	// dynamic-relocation / table fields are zero — we only need the
	// symbol-range partition, not two-level-namespace or indirect tables.
	bb = bb.WriteU32(LC_DYSYMTAB)
	bb = bb.WriteU32(cast(uint32, dysymtabCmdSize))
	bb = bb.WriteU32(0) // ilocalsym
	bb = bb.WriteU32(cast(uint32, nLocalSym)) // nlocalsym
	bb = bb.WriteU32(cast(uint32, nLocalSym)) // iextdefsym
	bb = bb.WriteU32(cast(uint32, nExtDefSym)) // nextdefsym
	bb = bb.WriteU32(cast(uint32, nLocalSym + nExtDefSym)) // iundefsym
	bb = bb.WriteU32(cast(uint32, nUndefSym)) // nundefsym
	bb = bb.WriteU32(0) // tocoff
	bb = bb.WriteU32(0) // ntoc
	bb = bb.WriteU32(0) // modtaboff
	bb = bb.WriteU32(0) // nmodtab
	bb = bb.WriteU32(0) // extrefsymoff
	bb = bb.WriteU32(0) // nextrefsyms
	bb = bb.WriteU32(0) // indirectsymoff
	bb = bb.WriteU32(0) // nindirectsyms
	bb = bb.WriteU32(0) // extreloff
	bb = bb.WriteU32(0) // nextrel
	bb = bb.WriteU32(0) // locreloff
	bb = bb.WriteU32(0) // nlocrel

	// LC_BUILD_VERSION (macOS, minimum version 11.0)
	bb = bb.WriteU32(LC_BUILD_VERSION)
	bb = bb.WriteU32(cast(uint32, buildVerCmdSize))
	bb = bb.WriteU32(1) // platform = MACOS
	bb = bb.WriteU32(0x000B0000) // minos = 11.0.0
	bb = bb.WriteU32(0x000B0000) // sdk = 11.0.0
	bb = bb.WriteU32(0) // ntools = 0

	// Pad to data offset
	for bb.Len < dataOffset {
		bb = bb.WriteU8(0)
	}

	// Bake each absolute relocation's addend into the section data inline.
	// A Mach-O relocation_info has no addend field — the linker computes
	// `symbol_address + the inline value` — so a fixup's non-zero addend must
	// be written into its slot here. The load-bearing case is the +16 that
	// points a static-managed pointer (e.g. reflect FunctionInfo.Pkg, the
	// Functions array entries) at its node's PAYLOAD, past the 2-word managed
	// header; without this the pointer lands on the header (the refcount
	// sentinel) and a by-pointer read is 16 bytes low. PC-relative kinds keep
	// their 0 placeholder (the linker derives the displacement), so only
	// absolute (UNSIGNED, kind 0) relocations carry an inline addend. ELF
	// stores the addend in r_addend instead, which is why only this path
	// needs it.
	for ri := 0; ri < a.NumRelocs; ri++ {
		var rel asm.Relocation = a.Relocs[ri]
		if rel.Addend == 0 || !machoAddendInline(rel.Kind, cpu_type) {
			continue
		}
		// r_length encodes the byte width as a log2: 0->1, 1->2, 2->4, 3->8.
		var nbytes int = 1
		var rl int = machoRelocLength(rel.Kind, cpu_type)
		if rl == 1 { nbytes = 2 } else if rl == 2 { nbytes = 4 } else if rl == 3 { nbytes = 8 }
		bakeAddend(a.Sections[rel.Section].Data, cast(int, rel.Offset), rel.Addend, nbytes)
	}

	// Section data, each at its recorded offset (zero padding fills the alignment
	// gaps), then padding up to the relocation entries — so every offset the load
	// commands name is where its bytes are, whether or not a section is empty.
	for i := 0; i < a.NumSections; i++ {
		var s @asm.Section = a.Sections[i]
		if isZeroFillSection(s) { continue } // no bytes in the file
		for bb.Len < sectOffsets[i] { bb = bb.WriteU8(0) }
		if s.Len > 0 {
			// bnlint:allow managed-to-raw-assign - s is a live @asm.Section; Data outlives the read
			var data *[]uint8 = s.Data[0:s.Len]
			bb = bb.WriteBytes(data, s.Len)
		}
	}
	for bb.Len < relocStart { bb = bb.WriteU8(0) }

	// Relocation entries (per section)
	var relOk bool = false
	bb, relOk = writeMachoRelocs(bb, a, sectRelocCounts, symNewIndex, cpu_type)
	if !relOk { return false }

	// Symbol table (nlist_64 entries), emitted in the partitioned order
	// (local, then defined-external, then undefined) that LC_DYSYMTAB
	// names above. symOrder[i] is the original a.Symbols index.
	for i := 0; i < nEmittedSym; i++ {
		var oldIdx int = symOrder[i]
		var sym asm.Symbol = a.Symbols[oldIdx]
		// n_strx (4 bytes)
		bb = bb.WriteU32(cast(uint32, strOffsets[oldIdx]))
		// n_type (1 byte)
		var ntype uint8 = 0
		if sym.Section >= 0 {
			ntype = N_SECT
		}
		if sym.Binding == asm.BIND_GLOBAL || sym.Binding == asm.BIND_WEAK {
			ntype = ntype | N_EXT
		}
		bb = bb.WriteU8(ntype)
		// n_sect (1 byte) — 1-based section index, 0 for undefined
		if sym.Section >= 0 {
			bb = bb.WriteU8(cast(uint8, lay.Pos[sym.Section] + 1))
		} else {
			bb = bb.WriteU8(0)
		}
		// n_desc (2 bytes). A weak symbol is marked so the linker/loader
		// treats it as overridable-or-optional: a weak *definition*
		// (Section >= 0) gets N_WEAK_DEF (a coalescable linkonce-style def
		// ld dedupes across modules); a weak *undefined reference*
		// (Section < 0) gets N_WEAK_REF (an optional import a dynamic
		// linker binds to 0 if absent).  Non-weak symbols get 0.
		var ndesc uint16 = 0
		if sym.Binding == asm.BIND_WEAK {
			if sym.Section >= 0 {
				ndesc = N_WEAK_DEF
			} else {
				ndesc = N_WEAK_REF
			}
		}
		bb = bb.WriteU16(ndesc)
		// n_value (8 bytes) — absolute address = section base + offset.
		// For undefined symbols (Section < 0), n_value is 0.
		var nvalue int = 0
		if sym.Section >= 0 {
			nvalue = sectAddrs[sym.Section] + cast(int, sym.Offset)
		}
		bb = bb.WriteU64(cast(uint64, nvalue))
	}

	// String table
	bb = bb.WriteBytes(strtabBytes, strtabSize)

	// --- Write to file ---
	f, oerr := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	if present(oerr) {
		return false
	}
	// bnlint:allow managed-to-raw-assign - bb is the live output builder; Data outlives the read
	var data *[]uint8 = bb.Data[0:bb.Len]
	written, _ := f.Write(data)
	_ = f.Close()
	return written == bb.Len
}

// WriteARM64 emits the assembler's contents as an arm64 Mach-O object
// at `path`. Returns true on success.
func WriteARM64(a @asm.Assembler, path *[]readonly char) bool {
	return Write(a, path, CPU_TYPE_ARM64, CPU_SUBTYPE_ARM64_ALL)
}

// WriteX86_64 emits the assembler's contents as an x86-64 Mach-O object
// at `path`. Returns true on success.
func WriteX86_64(a @asm.Assembler, path *[]readonly char) bool {
	return Write(a, path, CPU_TYPE_X86_64, CPU_SUBTYPE_X86_64_ALL)
}
