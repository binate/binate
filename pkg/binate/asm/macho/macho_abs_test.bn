package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Absolute symbols (asm.Symbol.Abs — the assembler's constants) and aliases in a Mach-O
// object, as clang lists them: an absolute symbol is N_ABS (with N_EXT when global or weak,
// and N_WEAK_DEF when weak) and its value; a temporary's (`LN`) is left out; an alias is an
// N_SECT symbol at its location, N_ALT_ENTRY in n_desc when an alt entry, which then starts
// no atom.  (madRead / madU32 / madSect0 are in macho_addend_test.bn.)

// absNlist returns the n_type, n_desc and n_value of the nlist_64 entry named name in the
// Mach-O object in b (n bytes), or found=false.
func absNlist(b @[]uint8, n int, name *[]readonly char) (int, int, uint64, bool) {
	var nsects int = cast(int, madU32(b, 32 + 64))
	var st int = madSect0() + 80 * nsects
	var symoff int = cast(int, madU32(b, st + 8))
	var nsyms int = cast(int, madU32(b, st + 12))
	var stroff int = cast(int, madU32(b, st + 16))
	for e := 0; e < nsyms; e++ {
		var ent int = symoff + 16 * e
		var at int = stroff + cast(int, madU32(b, ent))
		if at + len(name) >= n { continue }
		var hit bool = b[at + len(name)] == 0
		for k := 0; hit && k < len(name); k++ { hit = b[at + k] == name[k] }
		if !hit { continue }
		var desc int = cast(int, b[ent + 6]) | (cast(int, b[ent + 7]) << 8)
		var value uint64 = cast(uint64, madU32(b, ent + 8)) | (cast(uint64, madU32(b, ent + 12)) << 32)
		return cast(int, b[ent + 4]), desc, value, true
	}
	return 0, 0, 0, false
}

// _f at 0 with an alias A = _f + 4 (an alt entry) and B = _f (not one), local N = -3,
// global G = 7, weak W = 6 and a temporary LN = 5: N, G and W are N_ABS with their values
// (G and W with N_EXT, W a weak definition), LN is not listed, A and B are N_SECT at 4 and
// 0 with N_ALT_ENTRY only on A — which leaves _f's atom whole.
func TestWriteMachoAbsoluteSymbolsAndAltEntries() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	a.EmitUint32(0xD503201F)
	a.EmitUint32(0xD503201F)
	a.DefineAlias("A", 0, cast(uint, 4), true)
	a.DefineAlias("B", 0, cast(uint, 0), false)
	a.DefineAbsolute("N", -3)
	a.SetGlobal("G")
	a.DefineAbsolute("G", 7)
	a.SetWeak("W")
	a.DefineAbsolute("W", 6)
	a.DefineAbsolute("LN", 5)
	a.ObjFormat = asm.OBJ_MACHO
	var starts @[]int = a.AtomStarts(0)
	if len(starts) != 1 || starts[0] != 0 { return fail("an alt entry split _f's atom") }
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_abs.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	nt, _, nv, nok := absNlist(b, n, "N")
	if !nok || nt != cast(int, N_ABS) || nv != 0xFFFFFFFFFFFFFFFD { return fail("N not N_ABS -3") }
	gt, _, gv, gok := absNlist(b, n, "G")
	if !gok || gt != cast(int, N_ABS | N_EXT) || gv != 7 { return fail("G not external N_ABS 7") }
	wt, wd, wv, wok := absNlist(b, n, "W")
	if !wok || wt != cast(int, N_ABS | N_EXT) || wd != cast(int, N_WEAK_DEF) || wv != 6 {
		return fail("W not a weak external N_ABS 6")
	}
	_, _, _, lok := absNlist(b, n, "LN")
	if lok { return fail("the temporary LN listed") }
	at, ad, av, aok := absNlist(b, n, "A")
	if !aok || at != cast(int, N_SECT) || ad != cast(int, N_ALT_ENTRY) || av != 4 {
		return fail("A not an alt-entry N_SECT symbol at 4")
	}
	bt, bd, bv, bok := absNlist(b, n, "B")
	if !bok || bt != cast(int, N_SECT) || bd != 0 || bv != 0 {
		return fail("B not a plain N_SECT symbol at 0")
	}
	return ""
}

// altEntryProgram returns an assembler holding `nop`, then (at 4) `_main: mov w0, #7;
// ret`, with an alias defined at offset alt as an alt entry and a temporary-named alias
// Lend at 4.
func altEntryProgram(alt int) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.EmitUint32(0xD503201F) // nop
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	a.EmitUint32(0x528000E0) // mov w0, #7
	a.EmitUint32(0xD65F03C0) // ret
	a.DefineAlias("C", 0, cast(uint, alt), true)
	a.DefineAlias("Lend", 0, cast(uint, 4), true)
	return a
}

// ld64 rejects an object whose first atom in a section is an alt entry: an alt entry
// before every atom start gets the section's start anchor (ltmp0, as clang's objects
// carry), and one at the section's start becomes a plain symbol starting the atom.  A
// temporary-named alias (Lend) is not listed, as clang lists none.  Both objects link and
// run.
func TestWriteMachoLeadingAltEntry() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = altEntryProgram(2)
	a.ObjFormat = asm.OBJ_MACHO
	a.Finalize()
	var path @[]char = buf.Concat(dir, "/macho_alt_lead.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if !symtabHas(b, n, "ltmp0") { return fail("no start anchor before the leading alt entry") }
	if symtabHas(b, n, "Lend") { return fail("the temporary alias Lend listed") }
	_, cd, _, cok := absNlist(b, n, "C")
	if !cok || cd != cast(int, N_ALT_ENTRY) { return fail("C not an alt entry") }
	var z @asm.Assembler = altEntryProgram(0)
	z.ObjFormat = asm.OBJ_MACHO
	z.Finalize()
	var zpath @[]char = buf.Concat(dir, "/macho_alt_zero.o")
	if !WriteARM64(z, zpath) { return fail(z.ErrorMsg) }
	zb, zn := madRead(zpath)
	_, zd, _, zok := absNlist(zb, zn, "C")
	if !zok || zd != 0 { return fail("an alt entry at the section's start not made plain") }
	if canLinkAndRun() {
		code, err := atomsLinkRun(altEntryProgram(2))
		if code != 7 { return fail(buf.Concat("the anchored object does not link and run: ", err)) }
		code2, err2 := atomsLinkRun(altEntryProgram(0))
		if code2 != 7 { return fail(buf.Concat("the plain-made object does not link and run: ", err2)) }
	}
	return ""
}

// leadingAliasProgram returns `_main: adrp x1, D; add x1, x1, :lo12:D; mov w0, #7; ret`
// with D a label made for `.` at the start of data (as `Dz = .` makes one) and the alias
// Dz there, an alt entry.
func leadingAliasProgram() @asm.Assembler {
	var gen @[]char = asm.GeneratedLabelName(".", 0)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X1, gen)
	isa.AddSubLo12(a, true, aarch64.X1, aarch64.X1, gen, 0, false)
	a.EmitUint32(0x528000E0) // mov w0, #7
	a.EmitUint32(0xD65F03C0) // ret
	a.SetSection("data", -1)
	a.DefineLabel(gen)
	a.EmitUint64(1)
	a.DefineAlias("Dz", 1, cast(uint, 0), true)
	return a
}

// An alias at a section's start that a relocation reaches: the alias is made a plain symbol
// before the relocations against the temporary there are moved to an atom's symbol, so the
// relocation goes against Dz and no anchor shares its address (which would leave Dz the
// first atom's alt entry, rejected by ld64).  The object links and runs.
func TestWriteMachoLeadingAliasReferenced() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = leadingAliasProgram()
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_alt_ref.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	_, dd, _, dok := absNlist(b, n, "Dz")
	if !dok || dd != 0 { return fail("Dz not a plain symbol") }
	if symtabHas(b, n, "ltmp1") { return fail("an anchor beside Dz") }
	if canLinkAndRun() {
		code, err := atomsLinkRun(leadingAliasProgram())
		if code != 7 { return fail(buf.Concat("the object does not link and run: ", err)) }
	}
	return ""
}

// A relocation against a listed alt entry — a global alias _P inside _f's atom, branched
// to from _g's — stays against it, as clang keeps it (so that another object's definition
// can override a weak one); one against a local temporary there moves to _f.
func TestWriteMachoRelocAgainstListedAltEntry() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Ltmp")
	a.EmitUint32(0xD503201F)
	a.SetGlobal("_P")
	a.DefineAlias("_P", 0, cast(uint, 4), true)
	a.DefineLabel("_g")
	aarch64.Bl(a, "_P")
	aarch64.Bl(a, "Ltmp")
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if !WriteARM64(a, buf.Concat(dir, "/macho_alt_reloc.o")) { return fail(a.ErrorMsg) }
	if a.NumRelocs != 2 { return fail("not two relocations") }
	var seenP bool = false
	var seenF bool = false
	for i := 0; i < a.NumRelocs; i++ {
		var r asm.Relocation = a.Relocs[i]
		var name @[]char = a.Symbols[r.Symbol].Name
		if charsEqual(name, "_P") && r.Addend == 0 { seenP = true }
		if charsEqual(name, "_f") && r.Addend == 4 { seenF = true }
	}
	if !seenP { return fail("the branch to _P moved off it") }
	if !seenF { return fail("the branch to Ltmp not moved to _f + 4") }
	return ""
}
