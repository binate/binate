package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Mach-O arm64 relocation-addend tests.  relocation_info has no addend field: an
// arm64 instruction relocation (BRANCH26 / PAGE21 / PAGEOFF12) with a non-zero addend
// is preceded by an ARM64_RELOC_ADDEND entry (r_address as the paired relocation's,
// the addend in r_symbolnum as signed 24 bits, r_pcrel 0, r_length 2, r_extern 0,
// r_type 10) — the shape clang emits for `adrp x0, _ext@PAGE+16` / `bl _ext+8`.  An
// UNSIGNED data relocation instead carries its addend inline.  Relocations Mach-O
// cannot express make Write fail.  Each test writes the object and parses it back,
// so it runs anywhere (no linker).  (fail() is defined in macho_test.bn.)

// madRead reads the object file at path into a fresh 8KB buffer and returns the
// buffer and the byte count read (0 when the file cannot be opened).
func madRead(path *[]readonly char) (@[]uint8, int) {
	var whole @[]uint8 = make_slice(uint8, 8192)
	f, oerr := os.Open(path)
	if present(oerr) { return whole, 0 }
	// bnlint:allow managed-to-raw-assign - borrows a live managed local; outlives the read
	var raw *[]uint8 = whole
	n, _ := f.Read(raw)
	_ = f.Close()
	return whole, n
}

// madU32 reads a little-endian uint32 from b at off.
func madU32(b @[]uint8, off int) uint32 {
	return cast(uint32, b[off]) | (cast(uint32, b[off + 1]) << 8) | (cast(uint32, b[off + 2]) << 16) |
			(cast(uint32, b[off + 3]) << 24)
}

// madSect0 returns the first section header's byte offset: after the 32-byte
// mach_header_64 and the 72-byte LC_SEGMENT_64 command header.
func madSect0() int { return 32 + 72 }

// madRelocAt returns relocation_info entry i of the first section as (r_address,
// the packed r_symbolnum/r_pcrel/r_length/r_extern/r_type word).  section_64 holds
// reloff at +56.
func madRelocAt(b @[]uint8, i int) (uint32, uint32) {
	var off int = cast(int, madU32(b, madSect0() + 56)) + i * 8
	return madU32(b, off), madU32(b, off + 4)
}

// madNReloc returns the first section's nreloc (section_64 +60).
func madNReloc(b @[]uint8) int { return cast(int, madU32(b, madSect0() + 60)) }

// madHas reports whether sub occurs within msg.
func madHas(msg *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(msg); i++ {
		var match bool = true
		for j := 0; j < len(sub); j++ {
			if msg[i + j] != sub[j] { match = false; break }
		}
		if match { return true }
	}
	return false
}

// madExtAsm returns an assembler with a text section and one undefined global,
// `_ext` (so it is symbol 0 of the emitted table).
func madExtAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetGlobal("_ext")
	return a
}

// madEntryIs reports whether relocation entry i of the object in b has r_address
// addr and packed word info.
func madEntryIs(b @[]uint8, i int, addr uint32, info uint32) bool {
	ra, ri := madRelocAt(b, i)
	return ra == addr && ri == info
}

// An ADRP / ADD lo12 / BL to an external symbol with a non-zero addend each get an
// ARM64_RELOC_ADDEND entry immediately before the paired relocation; a BL with no
// addend gets none, and nreloc counts the ADDEND entries.
func TestMachoArm64AddendPairsPrecedeRelocs() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = madExtAsm()
	isa.PCRelLabel(a, true, false, aarch64.X0, "_ext", 16) // adrp x0, _ext@PAGE+16
	isa.AddSubLo12(a, true, aarch64.X0, aarch64.X0, "_ext", 16) // add, _ext@PAGEOFF+16
	isa.BranchLabel(a, true, "_ext", 8) // bl _ext+8
	isa.BranchLabel(a, true, "_ext", 0) // bl _ext
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_addend_pairs.o")
	if !WriteARM64(a, path) { return fail("WriteARM64 must accept in-range arm64 addends") }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 7 { return fail("nreloc must count 4 relocations + 3 ADDEND entries") }
	// ADDEND = 10 << 28 | 2 << 25 | addend; PAGE21 / PAGEOFF12 / BRANCH26 against
	// symbol 0, extern, length 2, pcrel as the kind requires.
	if !madEntryIs(b, 0, 0, 0xA4000010) { return fail("ADDEND +16 before the PAGE21") }
	if !madEntryIs(b, 1, 0, 0x3D000000) { return fail("PAGE21 against _ext") }
	if !madEntryIs(b, 2, 4, 0xA4000010) { return fail("ADDEND +16 before the PAGEOFF12") }
	if !madEntryIs(b, 3, 4, 0x4C000000) { return fail("PAGEOFF12 against _ext") }
	if !madEntryIs(b, 4, 8, 0xA4000008) { return fail("ADDEND +8 before the BRANCH26") }
	if !madEntryIs(b, 5, 8, 0x2D000000) { return fail("BRANCH26 against _ext") }
	if !madEntryIs(b, 6, 12, 0x2D000000) { return fail("addend-free BRANCH26 has no ADDEND") }
	return ""
}

// A negative addend is stored as its low 24 bits (two's complement) in r_symbolnum,
// leaving r_pcrel / r_length / r_extern / r_type intact; both ends of the signed
// 24-bit range are accepted.
func TestMachoArm64NegativeAndEdgeAddends() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = madExtAsm()
	isa.BranchLabel(a, false, "_ext", -4) // b _ext-4
	isa.PCRelLabel(a, true, false, aarch64.X1, "_ext", -8388608)
	isa.AddSubLo12(a, true, aarch64.X1, aarch64.X1, "_ext", 8388607)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_addend_neg.o")
	if !WriteARM64(a, path) { return fail("WriteARM64 must accept signed-24-bit addends") }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 6 { return fail("nreloc must count 3 relocations + 3 ADDEND entries") }
	if !madEntryIs(b, 0, 0, 0xA4FFFFFC) { return fail("ADDEND -4 = 0xFFFFFC in r_symbolnum") }
	if !madEntryIs(b, 1, 0, 0x2D000000) { return fail("BRANCH26 (b) against _ext") }
	if !madEntryIs(b, 2, 4, 0xA4800000) { return fail("ADDEND -2^23 = 0x800000") }
	if !madEntryIs(b, 3, 4, 0x3D000000) { return fail("PAGE21 against _ext") }
	if !madEntryIs(b, 4, 8, 0xA47FFFFF) { return fail("ADDEND 2^23-1 = 0x7FFFFF") }
	if !madEntryIs(b, 5, 8, 0x4C000000) { return fail("PAGEOFF12 against _ext") }
	return ""
}

// An addend outside ARM64_RELOC_ADDEND's signed 24 bits makes Write fail.
func TestMachoArm64AddendOutOfRangeFails() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = madExtAsm()
	isa.BranchLabel(a, true, "_ext", 8388608)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	if WriteARM64(a, buf.Concat(dir, "/macho_addend_big.o")) {
		return fail("an addend of 2^23 must make WriteARM64 fail")
	}
	if !madHas(a.ErrorMsg, "addend") { return fail("the error must name the addend") }
	a = madExtAsm()
	isa.PCRelLabel(a, true, false, aarch64.X0, "_ext", -8388609)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	if WriteARM64(a, buf.Concat(dir, "/macho_addend_small.o")) {
		return fail("an addend of -2^23-1 must make WriteARM64 fail")
	}
	return ""
}

// A GOT-load relocation has no addend form: an ADRP :got: fixup with addend 8 makes
// Write fail, while the same fixup with no addend writes one plain relocation.
func TestMachoGotFixupAddendFails() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = madExtAsm()
	a.AddFixup("_ext", aarch64.FIX_ADRP_GOT_HI21, 8, 4)
	a.EmitUint32(0x90000000) // adrp x0, _ext@GOTPAGE
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	if WriteARM64(a, buf.Concat(dir, "/macho_got_addend.o")) {
		return fail("a GOT fixup with an addend must make WriteARM64 fail")
	}
	if !madHas(a.ErrorMsg, "cannot carry an addend") {
		return fail("the error must say the relocation cannot carry an addend")
	}
	a = madExtAsm()
	a.AddFixup("_ext", aarch64.FIX_ADRP_GOT_HI21, 0, 4)
	a.EmitUint32(0x90000000)
	aarch64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_got_plain.o")
	if !WriteARM64(a, path) { return fail("an addend-free GOT fixup must write") }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 1 { return fail("an addend-free GOT fixup is one relocation") }
	// GOT_LOAD_PAGE21 (5), pcrel, length 2, extern, symbol 0.
	if !madEntryIs(b, 0, 0, 0x5D000000) { return fail("GOT_LOAD_PAGE21 against _ext") }
	return ""
}

// B.cond / CBZ / TBZ / ADR to an external symbol stay relocations after Finalize, but
// Mach-O has no relocation for them, so Write fails and says the target must be an
// L-prefixed label.
func TestMachoShortRangeToExternalFails() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	for which := 0; which < 4; which++ {
		var a @asm.Assembler = madExtAsm()
		if which == 0 {
			isa.CondBranchLabel(a, aarch64.COND_EQ, "_ext", 0) // FIX_BRANCH19
		} else if which == 1 {
			isa.CompareBranchLabel(a, false, true, aarch64.X0, "_ext", 0) // FIX_BRANCH19
		} else if which == 2 {
			isa.TestBranchLabel(a, false, aarch64.X0, 1, "_ext", 0) // FIX_BRANCH14
		} else {
			isa.PCRelLabel(a, false, false, aarch64.X0, "_ext", 0) // FIX_ADR_LO21
		}
		aarch64.ResolveFixups(a)
		if !a.Finalize() { return fail("Finalize must accept an external target") }
		if a.NumRelocs != 1 { return fail("an external target must stay a relocation") }
		if WriteARM64(a, buf.Concat(dir, "/macho_short_ext.o")) {
			return fail("a short-range fixup to an external symbol must make WriteARM64 fail")
		}
		if !madHas(a.ErrorMsg, "L-prefixed") {
			return fail("the error must say the target must be an L-prefixed label")
		}
	}
	return ""
}

// An UNSIGNED (absolute data) relocation keeps its addend inline in the data word
// and gets no ADDEND entry.
func TestMachoDataAddendStaysInline() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.SetGlobal("_ext")
	a.AddFixup("_ext", 0, 16, 8) // .quad _ext+16
	a.EmitUint64(0)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_data_addend.o")
	if !WriteARM64(a, path) { return fail("WriteARM64 must accept a data addend") }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 1 { return fail("a data relocation's addend needs no ADDEND entry") }
	// UNSIGNED (0), not pcrel, length 3, extern, symbol 0.
	if !madEntryIs(b, 0, 0, 0x0E000000) { return fail("UNSIGNED against _ext") }
	var dataOff int = cast(int, madU32(b, madSect0() + 48)) // section_64 offset field
	if madU32(b, dataOff) != 16 || madU32(b, dataOff + 4) != 0 {
		return fail("the addend must be baked into the data word")
	}
	return ""
}
