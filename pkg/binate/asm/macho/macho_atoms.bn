package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Keeping a Mach-O object's atoms exactly the ones the fixup resolvers assumed.  The
// linker (MH_SUBSECTIONS_VIA_SYMBOLS) starts an atom at every symbol the object lists
// and may move, reorder or dead-strip each; a local temporary (`L`) label listed as a
// symbol would split the code around it into two atoms, breaking any displacement the
// resolver fixed across it — and the classic linker (ld64 before ld-prime) does not
// even treat a listed temporary as an atom, resolving a relocation against it to the
// start of the section's anonymous atom.  So, as clang does, no temporary is listed:
// a relocation against one targets the atom it belongs to (asm.Assembler.AtomOf: the atom
// it was defined in, or an alias's target's), through that atom's symbol with the label's
// offset from it in the addend.  A temporary that no listed symbol precedes
// in its section goes through a local anchor symbol placed at the section start
// (`ltmp<section>`, LLVM's name) — the same grouping the resolvers assumed, where
// everything before the first atom-starting symbol is one atom.

// sectionAnchorName returns an unused symbol name for section si's start anchor:
// `ltmp<si>`, or with a `_<n>` suffix if the source already uses that name.
func sectionAnchorName(a @asm.Assembler, si int) @[]char {
	var base @[]char = buf.Concat("ltmp", decimal(si))
	var name @[]char = base
	for n := 1; a.LookupSymbol(name) >= 0; n++ {
		name = buf.Concat(buf.Concat(base, "_"), decimal(n))
	}
	return name
}

// decimal returns the decimal digits of a non-negative v.
func decimal(v int) @[]char {
	if v == 0 { return buf.CopyStr("0") }
	var digits @[]char = make_slice(char, 20)
	var n int = 0
	for v > 0 {
		digits[19 - n] = cast(char, cast(int, '0') + v % 10)
		v = v / 10
		n = n + 1
	}
	return buf.CopyStr(digits[20 - n:20])
}

// noAnchors returns a's section-start anchor table with no anchor defined yet: for each
// section, the index of its anchor symbol (`ltmp<N>`), or -1.
func noAnchors(a @asm.Assembler) @[]int {
	var anchors @[]int = make_slice(int, a.NumSections)
	for si := 0; si < a.NumSections; si++ { anchors[si] = -1 }
	return anchors
}

// sectionAnchor returns section si's start anchor, defining it (and recording it in
// anchors) on first use, or -1 with a's error set when it cannot be defined.
func sectionAnchor(a @asm.Assembler, si int, anchors @[]int) int {
	if anchors[si] >= 0 { return anchors[si] }
	var anchor int = a.DefineLocalAt(sectionAnchorName(a, si), si, 0)
	if anchor < 0 { return -1 }
	a.Symbols[anchor].DefOrder = 0 // the section's start, before every definition
	anchors[si] = anchor
	return anchor
}

// anchorEverySection defines every section's start anchor, as clang's AArch64 objects carry
// an `ltmp<N>` at the start of each section; false, with a's error set, when one cannot be.
func anchorEverySection(a @asm.Assembler, anchors @[]int) bool {
	for si := 0; si < a.NumSections; si++ {
		if sectionAnchor(a, si, anchors) < 0 { return false }
	}
	return true
}

// retargetTemporaryRelocs rewrites each relocation against a defined symbol the symbol
// table does not list (machoListed: a local temporary label) into one against the symbol
// starting the label's atom (AtomOf; or its section's start anchor, sectionAnchor),
// adding the label's offset from that symbol to the addend — and a difference's subtracted
// temporary likewise, subtracting its offset.  A listed alt entry (an alias inside an
// atom) stays the target, as clang keeps it, so that another object's definition can
// override a weak one.  An atom started by a weak symbol is addressed
// through that symbol, as clang does: the linker keeps one copy of a weak definition, and
// a weak definition is the same in every object (a generic instantiation, a string
// header), so the offset lands on the same bytes in whichever copy is kept.  Returns
// false, with a's error set, when a section anchor cannot be defined.
func retargetTemporaryRelocs(a @asm.Assembler, anchors @[]int) bool {
	for si := 0; si < a.NumSections; si++ {
		var starts @[]int
		var have bool = false
		for ri := 0; ri < a.NumRelocs; ri++ {
			var rel asm.Relocation = a.Relocs[ri]
			var t asm.Symbol = a.Symbols[rel.Symbol]
			var tMoves bool = t.Section == si && !machoListed(t)
			var bMoves bool = false
			if rel.HasSub {
				var b asm.Symbol = a.Symbols[rel.SubSymbol]
				bMoves = b.Section == si && !machoListed(b)
			}
			if !tMoves && !bMoves { continue }
			if !have {
				starts = a.AtomStarts(si)
				have = true
			}
			if tMoves {
				var c int = atomBaseFor(a, si, starts, t, anchors)
				if c < 0 { return false }
				a.Relocs[ri].Symbol = c
				a.Relocs[ri].Addend = a.Relocs[ri].Addend + cast(int64, t.Offset) -
						cast(int64, a.Symbols[c].Offset)
			}
			if bMoves {
				// A subtracted temporary moves to its atom too, its offset leaving the addend.
				var bOff int = cast(int, a.Symbols[rel.SubSymbol].Offset)
				var cb int = atomBaseFor(a, si, starts, a.Symbols[rel.SubSymbol], anchors)
				if cb < 0 { return false }
				a.Relocs[ri].SubSymbol = cb
				a.Relocs[ri].Addend = a.Relocs[ri].Addend - cast(int64, bOff) +
						cast(int64, a.Symbols[cb].Offset)
			}
		}
	}
	return true
}

// atomBaseFor returns the symbol starting the atom sym belongs to (AtomOf, among starts,
// section si's AtomStarts) — or the section's start anchor (sectionAnchor) — or -1 with a's
// error set when the anchor cannot be defined.  In an object divisible at its symbols, a
// relocation against the anchor where another listed symbol shares its address (the
// section's start) is one ld64 rejects ("invalid r_symbolnum"), as it rejects clang's: the
// last such symbol, which starts the same atom, is the base instead, and no anchor is
// defined for it.
func atomBaseFor(a @asm.Assembler, si int, starts @[]int, sym asm.Symbol, anchors @[]int) int {
	var c int = a.AtomOf(starts, sym)
	if c >= 0 && c != anchors[si] { return c }
	if a.SubsectionsViaSymbols {
		// starts is sorted by offset: the symbols at the section's start come first.
		var peer int = -1
		for k := 0; k < len(starts) && a.Symbols[starts[k]].Offset == 0; k++ {
			if starts[k] != anchors[si] { peer = starts[k] }
		}
		if peer >= 0 { return peer }
	}
	return sectionAnchor(a, si, anchors)
}

// anchorLeadingAltEntries gives each section whose first listed symbol would be an alt
// entry an atom start at or before it, since ld64 rejects an object whose first atom in a
// section is an alt entry ("N_ALT_ENTRY bit set on first atom"): an alt entry at the
// section's start becomes a plain symbol, starting the atom there (nothing precedes it, so
// no displacement changes), and otherwise the section gets its start anchor (as clang's
// objects carry ltmp<n>).  A weak alt entry at the section's start is an error instead: a
// plain weak symbol there would start the atom holding the code before the next atom
// start, which a strong definition elsewhere discards (along with whatever local labels
// in it lead to), and ld64 takes a weak alt entry there, beside only the anchor, for the
// first atom.  Returns false, with a's error set, when an anchor cannot be defined or a
// weak alt entry starts the section.
func anchorLeadingAltEntries(a @asm.Assembler, anchors @[]int) bool {
	for si := 0; si < a.NumSections; si++ {
		if !hasListedAltEntry(a, si) { continue }
		var starts @[]int = a.AtomStarts(si)
		var atZero bool = false
		var needAnchor bool = false
		for i := 0; i < a.NumSymbols; i++ {
			var sym asm.Symbol = a.Symbols[i]
			if sym.Section != si || !sym.AltEntry || !machoListed(sym) { continue }
			var off int = cast(int, sym.Offset)
			if len(starts) > 0 && off >= cast(int, a.Symbols[starts[0]].Offset) { continue }
			if off == 0 && sym.Binding == asm.BIND_WEAK {
				a.SetError(
						buf.Concat(buf.Concat("macho: '", sym.Name),
								"' is a weak alias at the start of its section, where no symbol starts an atom"))
				return false
			}
			if off == 0 {
				a.Symbols[i].AltEntry = false
				atZero = true
			} else {
				needAnchor = true
			}
		}
		if needAnchor && !atZero && sectionAnchor(a, si, anchors) < 0 { return false }
	}
	return true
}

// hasListedAltEntry reports whether section si holds an alt entry the symbol table lists.
func hasListedAltEntry(a @asm.Assembler, si int) bool {
	for i := 0; i < a.NumSymbols; i++ {
		var sym asm.Symbol = a.Symbols[i]
		if sym.Section == si && sym.AltEntry && machoListed(sym) { return true }
	}
	return false
}
