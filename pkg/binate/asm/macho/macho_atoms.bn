package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Keeping a Mach-O object's atoms exactly the ones the fixup resolvers assumed.  The
// linker (MH_SUBSECTIONS_VIA_SYMBOLS) starts an atom at every symbol the object lists
// and may move, reorder or dead-strip each; a local temporary (`L`) label listed as a
// symbol would split the code around it into two atoms, breaking any displacement the
// resolver fixed across it — and the classic linker (ld64 before ld-prime) does not
// even treat a listed temporary as an atom, resolving a relocation against it to the
// start of the section's anonymous atom.  So, as clang does, no temporary is listed:
// a relocation against one targets the atom it lies in, through that atom's symbol
// with the label's offset in the addend.  A temporary that no listed symbol precedes
// in its section goes through a local anchor symbol placed at the section start
// (`ltmp<section>`, LLVM's name) — the same grouping the resolvers assumed, where
// everything before the first atom-starting symbol is one atom.

// sectionAtomSymbols returns, for section si, the indices of the atom-starting
// symbols defined there sorted by offset, and their offsets in the same order.
func sectionAtomSymbols(a @asm.Assembler, si int) (@[]int, @[]int) {
	var n int = 0
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Section == si && asm.StartsAtom(a.Symbols[i]) { n = n + 1 }
	}
	var idx @[]int = make_slice(int, n)
	var off @[]int = make_slice(int, n)
	var k int = 0
	for i := 0; i < a.NumSymbols; i++ {
		if a.Symbols[i].Section == si && asm.StartsAtom(a.Symbols[i]) {
			idx[k] = i
			off[k] = cast(int, a.Symbols[i].Offset)
			k = k + 1
		}
	}
	sortPairsByKey(off, idx)
	return idx, off
}

// sortPairsByKey sorts key ascending, permuting val alongside (a stable bottom-up
// merge sort, O(n log n)).
func sortPairsByKey(key @[]int, val @[]int) {
	var n int = len(key)
	var tk @[]int = make_slice(int, n)
	var tv @[]int = make_slice(int, n)
	for width := 1; width < n; width = width * 2 {
		for lo := 0; lo < n; lo = lo + 2 * width {
			var mid int = lo + width
			if mid > n { mid = n }
			var hi int = lo + 2 * width
			if hi > n { hi = n }
			var i int = lo
			var j int = mid
			for k := lo; k < hi; k++ {
				if i < mid && (j >= hi || key[i] <= key[j]) {
					tk[k] = key[i]
					tv[k] = val[i]
					i = i + 1
				} else {
					tk[k] = key[j]
					tv[k] = val[j]
					j = j + 1
				}
			}
		}
		for k := 0; k < n; k++ {
			key[k] = tk[k]
			val[k] = tv[k]
		}
	}
}

// containingAtomSymbol returns the index of the symbol starting the atom that holds
// byte off — the atom-starting symbol with the largest offset <= off among idx / offs
// (sectionAtomSymbols' result), preferring a non-weak one among aliases at that
// offset — or -1 when none precedes off.
func containingAtomSymbol(a @asm.Assembler, idx @[]int, offs @[]int, off int) int {
	var lo int = 0
	var hi int = len(offs)
	for lo < hi {
		var mid int = (lo + hi) / 2
		if offs[mid] <= off { lo = mid + 1 } else { hi = mid }
	}
	if lo == 0 { return -1 }
	for k := lo - 1; k >= 0 && offs[k] == offs[lo - 1]; k-- {
		if a.Symbols[idx[k]].Binding != asm.BIND_WEAK { return idx[k] }
	}
	return idx[lo - 1]
}

// sectionAnchorName returns an unused symbol name for section si's start anchor:
// `ltmp<si>`, or with a `_<n>` suffix if the source already uses that name.
func sectionAnchorName(a @asm.Assembler, si int) @[]char {
	var base @[]char = buf.Concat("ltmp", decimal(si))
	var name @[]char = base
	for n := 1; a.LookupSymbol(name) >= 0; n++ {
		name = buf.Concat(buf.Concat(base, "_"), decimal(n))
	}
	return name
}

// decimal returns the decimal digits of a non-negative v.
func decimal(v int) @[]char {
	if v == 0 { return buf.CopyStr("0") }
	var digits @[]char = make_slice(char, 20)
	var n int = 0
	for v > 0 {
		digits[19 - n] = cast(char, cast(int, '0') + v % 10)
		v = v / 10
		n = n + 1
	}
	return buf.CopyStr(digits[20 - n:20])
}

// retargetTemporaryRelocs rewrites each relocation against a defined local temporary
// label into one against the symbol starting the label's atom (or its section's
// start anchor, defined on first use), adding the label's offset within the atom to
// the addend.  An atom started by a weak symbol is addressed through that symbol, as
// clang does: the linker keeps one copy of a weak definition, and a weak definition
// is the same in every object (a generic instantiation, a string header), so the
// offset lands on the same bytes in whichever copy is kept.  Returns false, with a's
// error set, when a section anchor cannot be defined.
func retargetTemporaryRelocs(a @asm.Assembler) bool {
	for si := 0; si < a.NumSections; si++ {
		var idx @[]int
		var offs @[]int
		var have bool = false
		var anchor int = -1
		for ri := 0; ri < a.NumRelocs; ri++ {
			var rel asm.Relocation = a.Relocs[ri]
			var t asm.Symbol = a.Symbols[rel.Symbol]
			if t.Section != si || asm.StartsAtom(t) { continue }
			if !have {
				idx, offs = sectionAtomSymbols(a, si)
				have = true
			}
			var c int = containingAtomSymbol(a, idx, offs, cast(int, t.Offset))
			if c < 0 {
				if anchor < 0 {
					anchor = a.DefineLocalAt(sectionAnchorName(a, si), si, 0)
					if anchor < 0 { return false }
				}
				c = anchor
			}
			a.Relocs[ri].Symbol = c
			a.Relocs[ri].Addend = rel.Addend + cast(int, t.Offset) - cast(int, a.Symbols[c].Offset)
		}
	}
	return true
}

// anchorLeadingAltEntries gives each section whose first listed symbol would be an alt
// entry an atom start at or before it, since ld64 rejects an object whose first atom in a
// section is an alt entry ("N_ALT_ENTRY bit set on first atom"): an alt entry at the
// section's start becomes a plain symbol, starting the atom there (nothing precedes it, so
// no displacement changes), and otherwise the section gets its start anchor (as clang's
// objects carry ltmp<n>).  Returns false, with a's error set, when an anchor cannot be
// defined.
func anchorLeadingAltEntries(a @asm.Assembler) bool {
	for si := 0; si < a.NumSections; si++ {
		if !hasListedAltEntry(a, si) { continue }
		var starts @[]int = a.AtomStarts(si)
		var atZero bool = false
		var needAnchor bool = false
		for i := 0; i < a.NumSymbols; i++ {
			var sym asm.Symbol = a.Symbols[i]
			if sym.Section != si || !sym.AltEntry || !machoListed(sym) { continue }
			var off int = cast(int, sym.Offset)
			if len(starts) > 0 && off >= starts[0] { continue }
			if off == 0 {
				a.Symbols[i].AltEntry = false
				atZero = true
			} else {
				needAnchor = true
			}
		}
		if needAnchor && !atZero && a.DefineLocalAt(sectionAnchorName(a, si), si, 0) < 0 {
			return false
		}
	}
	return true
}

// hasListedAltEntry reports whether section si holds an alt entry the symbol table lists.
func hasListedAltEntry(a @asm.Assembler, si int) bool {
	for i := 0; i < a.NumSymbols; i++ {
		var sym asm.Symbol = a.Symbols[i]
		if sym.Section == si && sym.AltEntry && machoListed(sym) { return true }
	}
	return false
}
