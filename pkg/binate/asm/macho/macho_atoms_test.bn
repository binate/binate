package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The Mach-O atom model: a relocation against a local temporary label inside an atom
// is moved to the atom's own symbol (the label's offset in the addend) and the label
// is not listed, so the linker keeps each atom whole — including under -dead_strip,
// which bnc links with.  (madRead / madU32 / madSect0 are in macho_addend_test.bn,
// canLinkAndRun in macho_test.bn, execExit in run_helper_test.bn.)

// atomsLinkRun resolves a's fixups as a Mach-O object, writes it, links it with
// `cc -arch arm64 -Wl,-dead_strip` and runs it, returning the exit code and "" — or
// -1 and the reason when it cannot get that far.
func atomsLinkRun(a @asm.Assembler) (int, @[]char) {
	return atomsLinkRunWith(a, "-Wl,-dead_strip")
}

// atomsLinkRunWith is atomsLinkRun with the linker flag flag instead of -dead_strip.
func atomsLinkRunWith(a @asm.Assembler, flag *[]readonly char) (int, @[]char) {
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return -1, buf.CopyStr(a.ErrorMsg) }
	var objPath *[]readonly char = "/tmp/binate_macho_atoms.o"
	if !WriteARM64(a, objPath) { return -1, buf.CopyStr(a.ErrorMsg) }
	var exePath *[]readonly char = "/tmp/binate_macho_atoms"
	var args @[]@[]char = make_slice(@[]char, 7)
	args[0] = "-arch"
	args[1] = "arm64"
	args[2] = "-o"
	args[3] = buf.CopyStr(exePath)
	args[4] = buf.CopyStr(objPath)
	args[5] = "-Wl,-e,_main"
	args[6] = buf.CopyStr(flag)
	if execExit("cc", args) != 0 { return -1, buf.CopyStr("linking failed") }
	return execExit(exePath, make_slice(@[]char, 0)), ""
}

// symtabHas reports whether the symbol table of the Mach-O object in b (n bytes) lists
// a symbol named name (each nlist_64 entry's n_strx names it in the string table).
func symtabHas(b @[]uint8, n int, name *[]readonly char) bool {
	var nsects int = cast(int, madU32(b, 32 + 64))
	var st int = madSect0() + 80 * nsects
	var symoff int = cast(int, madU32(b, st + 8))
	var nsyms int = cast(int, madU32(b, st + 12))
	var stroff int = cast(int, madU32(b, st + 16))
	for e := 0; e < nsyms; e++ {
		var at int = stroff + cast(int, madU32(b, symoff + 16 * e))
		if at + len(name) >= n { continue }
		var hit bool = b[at + len(name)] == 0
		for k := 0; hit && k < len(name); k++ { hit = b[at + k] == name[k] }
		if hit { return true }
	}
	return false
}

// A function whose conditional branch targets a temporary label another function also
// references (so the label is relocated): the relocation goes to the function's own
// symbol, the label is not listed, and -dead_strip — which would split and drop a
// listed label's atom — leaves the function whole (`cbz x1` falls through: x1 is argv,
// so the exit code is 4).
func TestMachoTemporaryInsideAtomKeepsAtomWhole() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Movz(a, true, aarch64.X0, 3, 0)
	aarch64.Cbz(a, true, aarch64.X1, "Lskip")
	aarch64.Movz(a, true, aarch64.X0, 4, 0)
	a.DefineLabel("Lskip")
	aarch64.Ret(a)
	a.DefineLabel("_other")
	aarch64.Adrp(a, aarch64.X1, "Lskip")
	aarch64.Ret(a)
	var path *[]readonly char = "/tmp/binate_macho_atoms_symtab.o"
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if symtabHas(b, n, "Lskip") { return fail("the temporary Lskip must not be listed") }
	if !symtabHas(b, n, "_main") { return fail("_main must be listed") }
	return ""
}

// The same program linked with -dead_strip runs correctly.
func TestMachoTemporaryInsideAtomDeadStrip() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Movz(a, true, aarch64.X0, 3, 0)
	aarch64.Cbz(a, true, aarch64.X1, "Lskip")
	aarch64.Movz(a, true, aarch64.X0, 4, 0)
	a.DefineLabel("Lskip")
	aarch64.Ret(a)
	a.DefineLabel("_other")
	aarch64.Adrp(a, aarch64.X1, "Lskip")
	aarch64.Ret(a)
	code, why := atomsLinkRun(a)
	if code != 4 { return fail(buf.Concat("expected exit 4: ", why)) }
	return ""
}

// A data word reached through a temporary label inside a data atom (`_d: .uint32 7;
// Ld: .uint32 42`) is loaded through the atom's symbol plus 4 — an ARM64_RELOC_ADDEND
// pair for the ADRP / LDR — and the program still reads 42 after -dead_strip.
func TestMachoTemporaryDataInsideAtom() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.DefineLabel("_d")
	a.EmitUint32(7)
	a.DefineLabel("Ld")
	a.EmitUint32(42)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X0, "Ld")
	isa.LdStLo12(a, isa.LS_LDR_W, aarch64.X0, aarch64.X0, "Ld", 0)
	aarch64.Ret(a)
	code, why := atomsLinkRun(a)
	if code != 42 { return fail(buf.Concat("expected exit 42: ", why)) }
	return ""
}

// A branch to a temporary label that no listed symbol precedes in its code section
// goes through the section's start anchor `ltmp0` (the code before the first symbol
// is one atom, as the resolver assumed): `Lstart: mov x0, #9; ret` reached by
// `_main: b Lstart` runs and exits 9 after -dead_strip.
func TestMachoTemporaryBeforeFirstSymbolUsesAnchor() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("Lstart")
	aarch64.Movz(a, true, aarch64.X0, 9, 0)
	aarch64.Ret(a)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.B(a, "Lstart")
	code, why := atomsLinkRun(a)
	if code != 9 { return fail(buf.Concat("expected exit 9: ", why)) }
	return ""
}

// ldClassicAvailable reports whether `cc -Wl,-ld_classic` links a trivial arm64
// object here (the classic linker is deprecated and may be absent).
func ldClassicAvailable() bool {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Ret(a)
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if !WriteARM64(a, "/tmp/binate_macho_ldclassic_probe.o") { return false }
	var args @[]@[]char = make_slice(@[]char, 7)
	args[0] = "-arch"
	args[1] = "arm64"
	args[2] = "-o"
	args[3] = "/tmp/binate_macho_ldclassic_probe"
	args[4] = "/tmp/binate_macho_ldclassic_probe.o"
	args[5] = "-Wl,-e,_main"
	args[6] = "-Wl,-ld_classic"
	return execExit("cc", args) == 0
}

// Data temporaries with no symbol before them (`Lx: 1; Ly: 2; Lz: 4` — how the native
// backends lay out string literals) are reached through the data section's anchor
// with their offsets as addends, so both linkers resolve them: the classic linker
// resolved a relocation against a listed temporary to the start of the section's
// anonymous atom, reading Lx for Lz (exit 2 instead of 5).
func TestMachoTemporariesWithoutAtomBothLinkers() testing.TestResult {
	if !canLinkAndRun() { return "" }
	var classic bool = ldClassicAvailable()
	for pass := 0; pass < 2; pass++ {
		if pass == 1 && !classic { break }
		var a @asm.Assembler = asm.New(8)
		a.SetSection("data", -1)
		a.DefineLabel("Lx")
		a.EmitUint64(1)
		a.DefineLabel("Ly")
		a.EmitUint64(2)
		a.DefineLabel("Lz")
		a.EmitUint64(4)
		a.SetSection("text", -1)
		a.DefineLabel("_main")
		a.SetGlobal("_main")
		aarch64.Adrp(a, aarch64.X0, "Lx")
		isa.LdStLo12(a, isa.LS_LDR_X, aarch64.X1, aarch64.X0, "Lx", 0)
		aarch64.Adrp(a, aarch64.X0, "Lz")
		isa.LdStLo12(a, isa.LS_LDR_X, aarch64.X2, aarch64.X0, "Lz", 0)
		aarch64.Add(a, true, aarch64.X0, aarch64.X1, aarch64.Reg(aarch64.X2))
		aarch64.Ret(a)
		var code int = -1
		var why @[]char = ""
		if pass == 0 {
			code, why = atomsLinkRun(a)
		} else {
			code, why = atomsLinkRunWith(a, "-Wl,-ld_classic")
		}
		if code != 5 { return fail(buf.Concat("expected exit 5: ", why)) }
	}
	return ""
}

// A relocation against a temporary inside a weak symbol's atom goes through the weak
// symbol with the temporary's offset (as clang does): a weak definition is the same in
// every object, so the offset lands on the same bytes in whichever copy the linker
// keeps.  Among aliases at the atom's start a non-weak symbol is preferred.
func TestMachoTemporaryInsideWeakAtom() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	a.SetWeak("_w")
	a.DefineLabel("_w")
	a.EmitUint64(1)
	a.DefineLabel("Lfoo")
	a.EmitUint64(42)
	a.DefineLabel("_s") // a non-weak alias of the weak _t below
	a.SetWeak("_t")
	a.DefineLabel("_t")
	a.DefineLabel("Lbar")
	a.EmitUint64(7)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X0, "Lfoo")
	aarch64.Adrp(a, aarch64.X1, "Lbar")
	aarch64.Ret(a)
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if !retargetTemporaryRelocs(a) { return fail(a.ErrorMsg) }
	if a.Relocs[0].Symbol != a.LookupSymbol("_w") || a.Relocs[0].Addend != 8 {
		return fail("Lfoo must be addressed as _w + 8")
	}
	if a.Relocs[1].Symbol != a.LookupSymbol("_s") || a.Relocs[1].Addend != 0 {
		return fail("Lbar must be addressed through the non-weak alias _s")
	}
	return ""
}

// A global `L`-named symbol is listed (it would otherwise vanish from the object),
// and it starts an atom: a branch across it stays a relocation.
func TestMachoGlobalTemporaryNameListed() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	aarch64.Ret(a)
	a.SetGlobal("Lg")
	a.DefineLabel("Lg")
	aarch64.Bl(a, "_f")
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.NumRelocs != 1 { return fail("bl _f from Lg's atom must stay a relocation") }
	var path *[]readonly char = "/tmp/binate_macho_atoms_global_l.o"
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if !symtabHas(b, n, "Lg") { return fail("the global Lg must be listed") }
	return ""
}

// x86-64 carries a moved relocation's addend inline: a call from _g to a temporary
// inside _f becomes an X86_64_RELOC_BRANCH against _f with the label's offset (1) in
// the rel32 field.
func TestMachoX64TemporaryInsideAtomInlineAddend() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	x64.Nop(a)
	a.DefineLabel("Lmid")
	x64.Ret(a)
	a.DefineLabel("_g")
	x64.Call(a, "Lmid")
	a.ObjFormat = asm.OBJ_MACHO
	x64.ResolveFixups(a)
	a.Finalize()
	if a.NumRelocs != 1 { return fail("a call into another atom must stay a relocation") }
	var path *[]readonly char = "/tmp/binate_macho_atoms_x64.o"
	if !WriteX86_64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if symtabHas(b, n, "Lmid") { return fail("the temporary Lmid must not be listed") }
	// The call's rel32 field (after the E8 opcode at offset 2) holds the addend 1.
	var text int = cast(int, madU32(b, madSect0() + 48))
	if madU32(b, text + 3) != 1 { return fail("the rel32 field must hold the addend 1") }
	return ""
}
