package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Common symbols in a Mach-O object, as clang writes them: a common is an external N_UNDF
// whose n_value is its size and whose n_desc holds its alignment's exponent (GET_COMM_ALIGN,
// 0 for one byte), a private external when hidden, a weak definition when weak; a local
// common is a local symbol in __DATA,__bss.  (absNlist is in macho_abs_test.bn, madRead in
// macho_addend_test.bn, testTmpDir in macho_test.bn.)

// machoCommonProgram returns an assembler holding commons _ca (4 bytes, 4-aligned), _cb (100
// bytes, 1-aligned), a hidden _ch and a weak _cw, and local commons _la (4 bytes) and _lb (12
// bytes, 8-aligned).
func machoCommonProgram() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.EmitUint32(0xD65F03C0) // ret
	a.DefineCommon("_ca", 4, 4)
	a.DefineCommon("_cb", 100, 1)
	a.DefineCommon("_ch", 4, 4)
	a.SetVisibility("_ch", asm.VIS_HIDDEN)
	a.SetWeak("_cw")
	a.DefineCommon("_cw", 4, 4)
	a.DefineLocalCommon("_la", 4, 1)
	a.DefineLocalCommon("_lb", 12, 8)
	return a
}

// machoCommonChecks checks machoCommonProgram's symbols in the Mach-O object b (n bytes): each
// one's n_type, n_desc and n_value are clang's.
func machoCommonChecks(b @[]uint8, n int) @[]char {
	at, ad, av, aok := absNlist(b, n, "_ca")
	if !aok || at != cast(int, N_EXT) || ad != 0x200 || av != 4 {
		return buf.CopyStr("_ca not a common of 4 bytes, 2^2")
	}
	bt, bd, bv, bok := absNlist(b, n, "_cb")
	if !bok || bt != cast(int, N_EXT) || bd != 0 || bv != 100 {
		return buf.CopyStr("_cb not a common of 100 bytes, 2^0")
	}
	ht, _, _, hok := absNlist(b, n, "_ch")
	if !hok || ht != cast(int, N_EXT | N_PEXT) {
		return buf.CopyStr("_ch not a private external common")
	}
	wt, wd, _, wok := absNlist(b, n, "_cw")
	if !wok || wt != cast(int, N_EXT) || wd != (0x200 | cast(int, N_WEAK_DEF)) {
		return buf.CopyStr("_cw not a weak common")
	}
	lt, _, lv, lok := absNlist(b, n, "_la")
	_, _, mv, mok := absNlist(b, n, "_lb")
	if !lok || lt != cast(int, N_SECT) || !mok || mv != lv + 8 {
		return buf.CopyStr("_la / _lb not local symbols 8 bytes apart in bss")
	}
	return ""
}

// An arm64 object's commons are clang's.
func TestWriteMachoCommons() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = machoCommonProgram()
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/comm.o")
	if !WriteARM64(a, path) { return fail(buf.Concat("failed to write Mach-O: ", a.ErrorMsg)) }
	b, n := madRead(path)
	if n < 200 { return fail("cannot read back the Mach-O object") }
	var err @[]char = machoCommonChecks(b, n)
	if len(err) != 0 { return fail(err) }
	return ""
}

// An x86-64 object's commons are clang's.
func TestWriteMachoX64Commons() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = machoCommonProgram()
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/comm64.o")
	if !WriteX86_64(a, path) { return fail(buf.Concat("failed to write Mach-O: ", a.ErrorMsg)) }
	b, n := madRead(path)
	if n < 200 { return fail("cannot read back the Mach-O object") }
	var err @[]char = machoCommonChecks(b, n)
	if len(err) != 0 { return fail(err) }
	return ""
}

// A local common aligned to 2^20 bytes pads no file bytes: bss has no file contents, so its
// alignment does not move the start of the sections' data (clang's object is 464 bytes).
func TestWriteMachoLocalCommonAlignNoPadding() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.EmitUint32(0xD65F03C0)
	a.DefineLocalCommon("_x", 4, 0x100000)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/align.o")
	if !WriteARM64(a, path) { return fail(buf.Concat("failed to write Mach-O: ", a.ErrorMsg)) }
	_, n := madRead(path)
	if n <= 0 || n >= 4096 { return fail("the object was padded to bss's alignment") }
	return ""
}
