package "pkg/binate/asm/macho"

// Mach-O format constants — magic numbers, load-command kinds,
// section type/attribute bits, n_type / n_desc symbol bits, and
// per-architecture relocation kinds. Constant values track
// `<mach-o/loader.h>` and `<mach-o/{arm64,x86_64}/reloc.h>`.

// MH_MAGIC_64 is the magic number identifying a 64-bit Mach-O header.
const MH_MAGIC_64 uint32 = 0xFEEDFACF

// MH_OBJECT is the filetype for an unlinked relocatable object (.o).
const MH_OBJECT uint32 = 1

// MH_SUBSECTIONS_VIA_SYMBOLS marks the object's sections as divisible
// into independent atoms at defined-symbol boundaries. ld requires this
// to coalesce duplicate external weak definitions (e.g. linkonce dtor
// vtables) across objects — without it ld treats each section as one
// indivisible blob and reports duplicate weak symbols as hard
// collisions. Every fixup in this writer targets a named symbol, so the
// per-symbol-atom invariant holds.
const MH_SUBSECTIONS_VIA_SYMBOLS uint32 = 0x2000

// LC_SEGMENT_64 is the load-command type for a 64-bit segment descriptor.
const LC_SEGMENT_64 uint32 = 0x19

// LC_SYMTAB is the load-command type for the classic symbol/string table.
const LC_SYMTAB uint32 = 0x02

// LC_DYSYMTAB is the load-command type for the dynamic-linker symbol
// info (local/external/undefined index ranges).
const LC_DYSYMTAB uint32 = 0x0B

// LC_BUILD_VERSION is the load-command type that records the target
// platform and minimum OS version (replaces the older LC_VERSION_MIN_*).
const LC_BUILD_VERSION uint32 = 0x32

// S_REGULAR marks a regular (file-backed) section type.
const S_REGULAR uint32 = 0

// S_ZEROFILL marks a section whose contents are zero-filled at load
// time and therefore stored without bytes in the file (e.g. .bss).
const S_ZEROFILL uint32 = 1

// S_ATTR_PURE_INSTRUCTIONS marks a section that contains only
// machine instructions (the entire section is executable).
const S_ATTR_PURE_INSTRUCTIONS uint32 = 0x80000000

// S_ATTR_SOME_INSTRUCTIONS marks a section that contains some
// instructions (mixed with data); used alongside PURE_INSTRUCTIONS.
const S_ATTR_SOME_INSTRUCTIONS uint32 = 0x00000400

// N_EXT marks an external (visible to the linker) symbol in n_type.
const N_EXT uint8 = 0x01

// N_TYPE_MASK is the bitmask isolating the type field of n_type.
const N_TYPE_MASK uint8 = 0x0E

// N_SECT marks a defined-in-section symbol in n_type (its n_sect
// field holds the section number).
const N_SECT uint8 = 0x0E

// n_desc bits — see <mach-o/nlist.h>. N_WEAK_DEF marks a coalescable
// (linkonce-style) definition: the linker keeps one copy across all
// modules that emit it. Used for IR IsLinkOnce dtors / copy helpers.
const N_WEAK_DEF uint16 = 0x0080

// N_UNDF marks an undefined symbol in n_type (referenced but not
// defined in this object; the linker resolves it).
const N_UNDF uint8 = 0x00

// ARM64_RELOC_UNSIGNED is an absolute 64-bit (or 32-bit, per length
// field) address relocation (from mach-o/arm64/reloc.h).
const ARM64_RELOC_UNSIGNED int = 0

// ARM64_RELOC_BRANCH26 is a 26-bit pc-relative branch (B/BL) relocation.
const ARM64_RELOC_BRANCH26 int = 2

// ARM64_RELOC_PAGE21 is the high-21-bit-of-page form for ADRP.
const ARM64_RELOC_PAGE21 int = 3

// ARM64_RELOC_PAGEOFF12 is the low-12-bit-within-page form for the
// LDR/STR/ADD that follows ADRP.
const ARM64_RELOC_PAGEOFF12 int = 4

// ARM64_RELOC_GOT_LOAD_PAGE21 is the ADRP-to-GOT-entry-page form: like
// PAGE21 but the target is the symbol's GOT slot, not the symbol.  Used to
// reach an external data symbol under PIE (e.g. __c_global).
const ARM64_RELOC_GOT_LOAD_PAGE21 int = 5

// ARM64_RELOC_GOT_LOAD_PAGEOFF12 is the LDR-of-GOT-slot form paired with
// GOT_LOAD_PAGE21.  Like PAGEOFF12 it patches a within-instruction imm12, so
// it is NOT pc-relative (r_pcrel=0) — see machoRelocPCRel.
const ARM64_RELOC_GOT_LOAD_PAGEOFF12 int = 6

// X86_64_RELOC_UNSIGNED is an absolute address relocation
// (from mach-o/x86_64/reloc.h).
const X86_64_RELOC_UNSIGNED int = 0

// X86_64_RELOC_SIGNED is a signed pc-relative relocation (RIP-relative
// data references).
const X86_64_RELOC_SIGNED int = 1

// X86_64_RELOC_BRANCH is a pc-relative call/jump relocation.
const X86_64_RELOC_BRANCH int = 2
