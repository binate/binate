package "pkg/binate/asm/macho"

import "pkg/builtins/testing"

// Tests for macho_const.bn — these aren't behaviour tests in the
// usual sense, but constant-value drift is silent and catastrophic
// (a wrong magic number or reloc kind breaks every emitted .o), so
// pinning each value to the canonical <mach-o/...> definition makes
// regressions visible at unit-test time instead of at link time.

func TestMagicAndFiletype() testing.TestResult {
	if MH_MAGIC_64 != cast(uint32, 0xFEEDFACF) {
		return fail("MH_MAGIC_64 must be 0xFEEDFACF")
	}
	if MH_OBJECT != cast(uint32, 1) {
		return fail("MH_OBJECT must be 1 (relocatable .o)")
	}
	return ""
}

func TestLoadCommands() testing.TestResult {
	if LC_SEGMENT_64 != cast(uint32, 0x19) {
		return fail("LC_SEGMENT_64 must be 0x19")
	}
	if LC_SYMTAB != cast(uint32, 0x02) {
		return fail("LC_SYMTAB must be 0x02")
	}
	if LC_DYSYMTAB != cast(uint32, 0x0B) {
		return fail("LC_DYSYMTAB must be 0x0B")
	}
	if LC_BUILD_VERSION != cast(uint32, 0x32) {
		return fail("LC_BUILD_VERSION must be 0x32")
	}
	return ""
}

func TestSectionTypeAndAttrs() testing.TestResult {
	if S_REGULAR != cast(uint32, 0) {
		return fail("S_REGULAR must be 0")
	}
	if S_ZEROFILL != cast(uint32, 1) {
		return fail("S_ZEROFILL must be 1")
	}
	if S_ATTR_PURE_INSTRUCTIONS != cast(uint32, 0x80000000) {
		return fail("S_ATTR_PURE_INSTRUCTIONS must be 0x80000000")
	}
	if S_ATTR_SOME_INSTRUCTIONS != cast(uint32, 0x00000400) {
		return fail("S_ATTR_SOME_INSTRUCTIONS must be 0x00000400")
	}
	return ""
}

func TestSymbolBits() testing.TestResult {
	if N_EXT != cast(uint8, 0x01) {
		return fail("N_EXT must be 0x01")
	}
	if N_TYPE_MASK != cast(uint8, 0x0E) {
		return fail("N_TYPE_MASK must be 0x0E")
	}
	if N_SECT != cast(uint8, 0x0E) {
		return fail("N_SECT must be 0x0E")
	}
	if N_UNDF != cast(uint8, 0x00) {
		return fail("N_UNDF must be 0x00")
	}
	if N_WEAK_DEF != cast(uint16, 0x0080) {
		return fail("N_WEAK_DEF must be 0x0080")
	}
	return ""
}

func TestArm64RelocKinds() testing.TestResult {
	if ARM64_RELOC_UNSIGNED != 0 {
		return fail("ARM64_RELOC_UNSIGNED must be 0")
	}
	if ARM64_RELOC_BRANCH26 != 2 {
		return fail("ARM64_RELOC_BRANCH26 must be 2")
	}
	if ARM64_RELOC_PAGE21 != 3 {
		return fail("ARM64_RELOC_PAGE21 must be 3")
	}
	if ARM64_RELOC_PAGEOFF12 != 4 {
		return fail("ARM64_RELOC_PAGEOFF12 must be 4")
	}
	return ""
}

func TestX86_64RelocKinds() testing.TestResult {
	if X86_64_RELOC_UNSIGNED != 0 {
		return fail("X86_64_RELOC_UNSIGNED must be 0")
	}
	if X86_64_RELOC_SIGNED != 1 {
		return fail("X86_64_RELOC_SIGNED must be 1")
	}
	if X86_64_RELOC_BRANCH != 2 {
		return fail("X86_64_RELOC_BRANCH must be 2")
	}
	return ""
}
