package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Absolute data fixup kinds are UNSIGNED relocations of their size on arm64 and x86-64
// alike, their addend in the field, as clang emits `.byte` / `.short` / `.long` / `.quad
// sym+k` (otool -rv: r_length byte / word / long / quad, the addend in the data).
func TestMachoDataRelocs() testing.TestResult {
	var kinds [4]int
	kinds[0] = asm.FIX_DATA_ABS8
	kinds[1] = asm.FIX_DATA_ABS16
	kinds[2] = asm.FIX_DATA_ABS32
	kinds[3] = asm.FIX_DATA_ABS64
	for i := 0; i < 4; i++ {
		if machoRelocType(kinds[i], CPU_TYPE_ARM64) != ARM64_RELOC_UNSIGNED {
			return fail("arm64 not UNSIGNED")
		}
		if machoRelocType(kinds[i], CPU_TYPE_X86_64) != X86_64_RELOC_UNSIGNED {
			return fail("x86-64 not UNSIGNED")
		}
		if machoRelocLength(kinds[i], CPU_TYPE_ARM64) != i ||
				machoRelocLength(kinds[i], CPU_TYPE_X86_64) != i {
			return fail("r_length not log2 of the size")
		}
		if machoRelocPCRel(kinds[i], CPU_TYPE_ARM64) != 0 ||
				machoRelocPCRel(kinds[i], CPU_TYPE_X86_64) != 0 {
			return fail("data relocation marked PC-relative")
		}
		if !machoAddendInline(kinds[i], CPU_TYPE_ARM64) || !machoAddendInline(kinds[i], CPU_TYPE_X86_64) {
			return fail("data addend not inline")
		}
	}
	if machoRelocType(asm.FIX_DATA_ABS32S, CPU_TYPE_X86_64) != X86_64_RELOC_UNSIGNED {
		return fail("a signed 4-byte datum not UNSIGNED")
	}
	if machoRelocLength(asm.FIX_DATA_ABS32S, CPU_TYPE_ARM64) != 2 {
		return fail("signed 4-byte length")
	}
	return ""
}

// A data relocation's addend must fit its field, read as signed or unsigned.
func TestMachoDataAddendRange() testing.TestResult {
	var r asm.Relocation
	r.Kind = asm.FIX_DATA_ABS8
	r.Addend = 255
	if !machoAddendOk(r, CPU_TYPE_ARM64) { return fail("1-byte 255 rejected") }
	r.Addend = 256
	if machoAddendOk(r, CPU_TYPE_ARM64) { return fail("1-byte 256 accepted") }
	r.Addend = -129
	if machoAddendOk(r, CPU_TYPE_X86_64) { return fail("1-byte -129 accepted") }
	r.Kind = asm.FIX_DATA_ABS16
	r.Addend = 65535
	if !machoAddendOk(r, CPU_TYPE_X86_64) { return fail("2-byte 65535 rejected") }
	r.Addend = -32769
	if machoAddendOk(r, CPU_TYPE_ARM64) { return fail("2-byte -32769 accepted") }
	r.Kind = asm.FIX_DATA_ABS32
	r.Addend = -2147483648
	if !machoAddendOk(r, CPU_TYPE_ARM64) { return fail("4-byte -2^31 rejected") }
	return ""
}

// A temporary's offset from the atom it is retargeted to (macho_atoms.bn) can grow a data
// relocation's addend past its field — `_a` then 300 bytes on, `Lt: .uint8 Lt` is _a + 300 in
// a byte: an error naming the symbol (clang writes the low byte, silently wrong).
func TestMachoDataAddendRetargetOverflow() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("data", -1)
	a.DefineLabel("_a")
	a.Zero(300)
	a.DefineLabel("Lt")
	a.AddFixup("Lt", asm.FIX_DATA_ABS8, 0, 1)
	a.Zero(1)
	if !a.Finalize() { return fail(a.ErrorMsg) }
	if WriteARM64(a, buf.Concat(dir, "/macho_data_retarget.o")) { return fail("written") }
	if !madHas(a.ErrorMsg, "the addend of a data reference to '_a' does not fit its field") {
		return fail(buf.Concat("wrong error: ", a.ErrorMsg))
	}
	return ""
}
