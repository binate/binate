package "pkg/binate/asm/macho"

import "pkg/binate/asm"

// The data-in-code table (LC_DATA_IN_CODE), as clang writes it: an 8-byte entry per data
// region (asm.DataRegion), in the order the regions began, holding the address of its start
// in the object (4 bytes), its length (2 bytes) and its kind (2 bytes: DICE_KIND_*, the
// values of asm's REGION_*).  The entries follow the relocation entries, before the symbol
// table.  A region longer than an entry's length holds (65535 bytes) takes consecutive
// entries of its kind, each as long as it can be, where clang would record its length
// modulo 65536.

// machoDiceMax is the most bytes a data-in-code entry's length holds.
const machoDiceMax int = 0xFFFF

// machoDataRegionsOk reports whether a's data regions can be listed: each ended.
func machoDataRegionsOk(a @asm.Assembler) bool {
	for i := 0; i < a.NumDataRegions; i++ {
		if a.DataRegions[i].End < 0 {
			a.SetError("macho: a data region is not ended")
			return false
		}
	}
	return true
}

// machoDiceEntries returns the number of data-in-code entries a's data regions take: one per
// machoDiceMax bytes or part of them, and one for an empty region.
func machoDiceEntries(a @asm.Assembler) int {
	var n int = 0
	for i := 0; i < a.NumDataRegions; i++ {
		var length int = a.DataRegions[i].End - a.DataRegions[i].Start
		n = n + 1
		if length > 0 { n = n + (length - 1) / machoDiceMax }
	}
	return n
}

// writeMachoDataInCode writes a's data-in-code entries to bb, its sections at addresses addrs.
func writeMachoDataInCode(bb BinBuf, a @asm.Assembler, addrs @[]int) BinBuf {
	for i := 0; i < a.NumDataRegions; i++ {
		var r asm.DataRegion = a.DataRegions[i]
		var at int = addrs[r.Section] + r.Start
		var left int = r.End - r.Start
		for {
			var length int = left
			if length > machoDiceMax { length = machoDiceMax }
			bb = bb.WriteU32(cast(uint32, at))
			bb = bb.WriteU16(cast(uint16, length))
			bb = bb.WriteU16(cast(uint16, r.Kind))
			at = at + length
			left = left - length
			if left == 0 { break }
		}
	}
	return bb
}
