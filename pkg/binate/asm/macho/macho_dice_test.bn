package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The data-in-code table (macho_dice.bn).  (madRead / madU32 / madSect0 / madLoadCmd are in
// macho_addend_test.bn, testTmpDir in macho_test.bn.)

// Each data region is an LC_DATA_IN_CODE entry, in the order the regions began: its start's
// address in the object (its section's address plus its offset there), its length and its
// kind.  The command comes after LC_BUILD_VERSION and before LC_SYMTAB, and its entries right
// after the relocation entries.
func TestMachoDataInCode() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	a.EmitUint32(0xD65F03C0)
	a.SetSection("data", -1)
	a.EmitUint32(1)
	a.BeginDataRegion(asm.REGION_JUMP_TABLE8)
	a.EmitUint8(2)
	a.EndDataRegion()
	a.SetSection("text", -1)
	a.BeginDataRegion(asm.REGION_DATA)
	a.EmitUint64(3)
	a.EndDataRegion()
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_dice.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 100 { return fail("cannot read the object back") }
	var dc int = madLoadCmd(b, LC_DATA_IN_CODE)
	if dc < 0 || madU32(b, dc + 4) != 16 || madU32(b, dc + 12) != 16 {
		return fail("no LC_DATA_IN_CODE of two entries")
	}
	if madLoadCmd(b, LC_BUILD_VERSION) > dc || madLoadCmd(b, LC_SYMTAB) < dc {
		return fail("LC_DATA_IN_CODE is not between LC_BUILD_VERSION and LC_SYMTAB")
	}
	// The data section's address (its header second, as created); the relocation-free
	// object's entries start where the 8-aligned relocation table would.
	var dataAddr uint32 = madU32(b, madSect0() + 80 + 32)
	var at int = cast(int, madU32(b, dc + 8))
	var dataEnd int = cast(int, madU32(b, madSect0() + 80 + 48)) + 5
	if at != dataEnd + (8 - dataEnd % 8) % 8 {
		return fail("the entries do not follow the section data")
	}
	if madU32(b, at) != dataAddr + 4 || madU32(b, at + 4) != (cast(uint32, 2) << 16) | 1 {
		return fail("the first entry is not data's 1-byte jump table at 4")
	}
	if madU32(b, at + 8) != 4 || madU32(b, at + 12) != (cast(uint32, 1) << 16) | 8 {
		return fail("the second entry is not text's 8 bytes of data at 4")
	}
	return ""
}

// diceErrorHas reports whether a's error message contains want.
func diceErrorHas(a @asm.Assembler, want *[]readonly char) bool {
	for i := 0; i + len(want) <= len(a.ErrorMsg); i++ {
		if charsEqual(a.ErrorMsg[i:i + len(want)], want) { return true }
	}
	return false
}

// A region longer than an entry's 16-bit length takes consecutive entries of its kind, each
// as long as it can be; an empty region takes one.  (bss holds the long regions, so the
// object stays small.)
func TestMachoDataInCodeSplitsLongRegions() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("bss", -1)
	a.BeginDataRegion(asm.REGION_JUMP_TABLE32)
	a.Zero(65535)
	a.EndDataRegion()
	a.BeginDataRegion(asm.REGION_DATA)
	a.Zero(65536)
	a.EndDataRegion()
	a.BeginDataRegion(asm.REGION_JUMP_TABLE8)
	a.EndDataRegion()
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_dice_long.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 100 { return fail("cannot read the object back") }
	var dc int = madLoadCmd(b, LC_DATA_IN_CODE)
	if dc < 0 || madU32(b, dc + 12) != 32 { return fail("not four entries") }
	var at int = cast(int, madU32(b, dc + 8))
	var bss uint32 = madU32(b, madSect0() + 32)
	var want @[]uint32 = make_slice(uint32, 8)
	want[0] = bss
	want[1] = (cast(uint32, 4) << 16) | 0xFFFF
	want[2] = bss + 65535
	want[3] = (cast(uint32, 1) << 16) | 0xFFFF
	want[4] = bss + 2 * 65535
	want[5] = (cast(uint32, 1) << 16) | 1
	want[6] = bss + 65535 + 65536
	want[7] = cast(uint32, 2) << 16
	for k := 0; k < len(want); k++ {
		if madU32(b, at + 4 * k) != want[k] {
			return fail("the entries are not 65535, 65535 + 1 and 0 bytes")
		}
	}
	return ""
}

// A data region never ended makes Write fail.
func TestMachoDataInCodeRejectsOpenRegion() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/macho_dice_bad.o")
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("data", -1)
	a.BeginDataRegion(asm.REGION_DATA)
	if WriteARM64(a, path) || !diceErrorHas(a, "not ended") {
		return fail("an open region was written")
	}
	return ""
}
