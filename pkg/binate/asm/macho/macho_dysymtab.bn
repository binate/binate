package "pkg/binate/asm/macho"

import "pkg/binate/asm"

// classifySymbolAt buckets symbol i for the LC_DYSYMTAB partition: 0 =
// local (defined, not external), 1 = defined external, 2 = undefined
// external reference. The buckets mirror the n_type bits the nlist loop
// writes — N_SECT iff Section >= 0, N_EXT iff the binding is global or
// weak — and Mach-O requires the symbol table to list the buckets in
// this 0, 1, 2 order, with LC_DYSYMTAB naming each contiguous range.
// (An undefined symbol always carries an external binding: extern
// references are added BIND_GLOBAL / BIND_WEAK, never BIND_LOCAL.)
func classifySymbolAt(a @asm.Assembler, i int) int {
	if a.Symbols[i].Section < 0 {
		return 2
	}
	if a.Symbols[i].Binding == asm.BIND_GLOBAL || a.Symbols[i].Binding == asm.BIND_WEAK {
		return 1
	}
	return 0
}

// isTemporaryLabel reports whether name is an assembler-internal temporary
// label (the `L` prefix — block labels, string/refcount temporaries).
// Branches to these are resolved in-section before Write, so they need not
// appear in the object's symbol table.
func isTemporaryLabel(name *[]readonly char) bool {
	return len(name) > 0 && name[0] == 'L'
}

// partitionSymbols computes the symbol-table permutation that groups a's
// EMITTED symbols into local, then defined-external, then undefined runs —
// the order LC_DYSYMTAB indexes into. It returns:
//   order    — new position -> original index (drives nlist + n_strx emission)
//   newIndex — original index -> new position, or -1 for a dropped symbol
//              (remaps relocation r_symbolnum; relocs never target a dropped one)
//   nLocal, nExtDef, nUndef — the three range lengths (their sum = #emitted).
// `L`-prefixed temporary labels are DROPPED: emitting them makes ld (under
// MH_SUBSECTIONS_VIA_SYMBOLS) split a function into atoms at each label and
// reorder/coalesce the pieces, which breaks the in-section intra-function
// branches — and conditional BRANCH19/14 have no Mach-O relocation fallback.
// clang likewise never emits them; dropping them keeps each function a
// single atom.  Relative order within each bucket is preserved (stable).
func partitionSymbols(a @asm.Assembler) (@[]int, @[]int, int, int, int) {
	var n int = a.NumSymbols
	// A relocation references its target symbol by index, so any symbol a
	// relocation points at MUST stay in the table — even if `L`-prefixed
	// (string-constant labels `Lstr_*` are reached by ADRP+ADD relocs).
	// Only UNREFERENCED `L` temporaries — block labels and refcount-skip
	// labels, which are resolved in-section and never relocated — are the
	// ones that wrongly split functions into atoms, so drop only those.
	var referenced @[]bool = make_slice(bool, n)
	for r := 0; r < a.NumRelocs; r++ {
		var s int = a.Relocs[r].Symbol
		if s >= 0 && s < n { referenced[s] = true }
	}
	var order @[]int = make_slice(int, n)
	var newIndex @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { newIndex[i] = -1 }
	var counts @[]int = make_slice(int, 3)
	var pos int = 0
	for cls := 0; cls < 3; cls = cls + 1 {
		for i := 0; i < n; i++ {
			if isTemporaryLabel(a.Symbols[i].Name) && !referenced[i] { continue }
			if classifySymbolAt(a, i) == cls {
				order[pos] = i
				newIndex[i] = pos
				pos = pos + 1
				counts[cls] = counts[cls] + 1
			}
		}
	}
	return order, newIndex, counts[0], counts[1], counts[2]
}
