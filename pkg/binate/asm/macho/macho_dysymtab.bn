package "pkg/binate/asm/macho"

import "pkg/binate/asm"

// classifySymbolAt buckets symbol i for the LC_DYSYMTAB partition: 0 =
// local (defined, not external), 1 = defined external, 2 = undefined
// external reference. The buckets mirror the n_type bits the nlist loop
// writes — N_SECT iff Section >= 0, N_ABS for an absolute symbol (defined),
// N_EXT iff the binding is global or weak — and Mach-O requires the symbol
// table to list the buckets in this 0, 1, 2 order, with LC_DYSYMTAB naming
// each contiguous range.
// (An undefined symbol always carries an external binding: extern
// references are added BIND_GLOBAL / BIND_WEAK, never BIND_LOCAL.)
func classifySymbolAt(a @asm.Assembler, i int) int {
	if a.Symbols[i].Section < 0 && !a.Symbols[i].Abs {
		return 2
	}
	if a.Symbols[i].Binding == asm.BIND_GLOBAL || a.Symbols[i].Binding == asm.BIND_WEAK {
		return 1
	}
	return 0
}

// partitionSymbols computes the symbol-table permutation that groups a's
// EMITTED symbols into local, then defined-external, then undefined runs —
// the order LC_DYSYMTAB indexes into. It returns:
//   order    — new position -> original index (drives nlist + n_strx emission)
//   newIndex — original index -> new position, or -1 for a dropped symbol
//              (remaps relocation r_symbolnum; relocs never target a dropped one)
//   nLocal, nExtDef, nUndef — the three range lengths (their sum = #emitted).
// A local temporary (`L`) label is never listed: every relocation against one was
// moved to its atom's symbol (retargetTemporaryRelocs), and a listed temporary would
// start an atom there, splitting a function and breaking the displacements resolved
// across the label.  Every atom-starting symbol (asm.StartsAtom), a global or weak
// `L`-named one included, is listed, and so are an alt entry and an absolute symbol that
// are not local temporaries (machoListed).  Relative order within each bucket is preserved
// (stable).
func partitionSymbols(a @asm.Assembler) (@[]int, @[]int, int, int, int) {
	var n int = a.NumSymbols
	var order @[]int = make_slice(int, n)
	var newIndex @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { newIndex[i] = -1 }
	var counts @[]int = make_slice(int, 3)
	var pos int = 0
	for cls := 0; cls < 3; cls = cls + 1 {
		for i := 0; i < n; i++ {
			if !machoListed(a.Symbols[i]) { continue }
			if classifySymbolAt(a, i) == cls {
				order[pos] = i
				newIndex[i] = pos
				pos = pos + 1
				counts[cls] = counts[cls] + 1
			}
		}
	}
	return order, newIndex, counts[0], counts[1], counts[2]
}

// machoListed reports whether sym is in the Mach-O symbol table: an atom-starting symbol
// (asm.StartsAtom), or an alt entry or absolute symbol other than a local temporary (`Lend
// = .`, `LN = 5`, which clang does not list either).
func machoListed(sym asm.Symbol) bool {
	if asm.StartsAtom(sym) { return true }
	if !sym.AltEntry && !sym.Abs { return false }
	return !asm.IsTemporaryLabel(sym.Name, asm.OBJ_MACHO) || sym.Binding != asm.BIND_LOCAL
}
