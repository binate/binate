package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/builtins/testing"

// (fail() is defined in macho_test.bn, same package.)

// TestClassifySymbolAt checks the LC_DYSYMTAB bucket assignment that the
// nlist emission and dysymtab partition both rely on: local defined = 0,
// defined-external (global or weak) = 1, undefined = 2.
func TestClassifySymbolAt() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_loc") // 0: local defined
	a.DefineLabel("_glob")
	a.SetGlobal("_glob") // 1: global defined
	a.DefineLabel("_wk")
	a.SetWeak("_wk") // 2: weak defined
	a.SetGlobal("_undef") // 3: undefined external

	if classifySymbolAt(a, 0) != 0 { return fail("_loc should classify local (0)") }
	if classifySymbolAt(a, 1) != 1 { return fail("_glob should classify defined-external (1)") }
	if classifySymbolAt(a, 2) != 1 { return fail("_wk (weak) should classify defined-external (1)") }
	if classifySymbolAt(a, 3) != 2 { return fail("_undef should classify undefined (2)") }
	return ""
}

// TestIsTemporaryLabel checks `L`-prefix recognition — the predicate that
// decides which symbols are candidates for dropping from the table.
func TestIsTemporaryLabel() testing.TestResult {
	if !asm.IsTemporaryLabel("Lblock.0") { return fail("Lblock.0 is a temporary") }
	if !asm.IsTemporaryLabel("Lstr_x") { return fail("Lstr_x is a temporary") }
	if asm.IsTemporaryLabel("_main") { return fail("_main is not a temporary") }
	if asm.IsTemporaryLabel("bn_pkg__foo") { return fail("a normal symbol is not a temporary") }
	if asm.IsTemporaryLabel("") { return fail("the empty name is not a temporary") }
	return ""
}

// TestPartitionDropsUnreferencedLabel checks that an `L`-prefixed temporary
// no relocation references is dropped from the emitted table — that is the
// crux that stops ld (under MH_SUBSECTIONS_VIA_SYMBOLS) from splitting a
// function into atoms at its internal block labels. Non-temporary symbols
// stay, in local-then-extdef order.
func TestPartitionDropsUnreferencedLabel() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_a") // 0: local non-L, kept
	a.DefineLabel("Lblk") // 1: local L, unreferenced -> dropped
	a.DefineLabel("_b")
	a.SetGlobal("_b") // 2: global, kept

	var order @[]int
	var newIndex @[]int
	var nLocal int
	var nExtDef int
	var nUndef int
	order, newIndex, nLocal, nExtDef, nUndef = partitionSymbols(a)

	if nLocal != 1 { return fail("expected 1 local (_a)") }
	if nExtDef != 1 { return fail("expected 1 defined-external (_b)") }
	if nUndef != 0 { return fail("expected 0 undefined") }
	if order[0] != 0 { return fail("the sole local should be _a") }
	if newIndex[0] < 0 { return fail("_a should be kept") }
	if newIndex[1] != -1 { return fail("unreferenced Lblk should be dropped (newIndex -1)") }
	if newIndex[2] < 0 { return fail("_b should be kept") }
	return ""
}

// TestPartitionRelocatedTemporaryGoesThroughAnchor checks that an `L`-prefixed
// temporary a relocation targets — a string-constant label at the start of rodata,
// reached by an ADRP page-relative reference — is not listed: the relocation is moved
// to the section's start anchor `ltmp1` (rodata is section 1) with the label's offset
// as its addend, and the anchor is listed as a local symbol instead.
func TestPartitionRelocatedTemporaryGoesThroughAnchor() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X0, "Lstr") // page-relative ref -> relocation
	aarch64.Ret(a)
	a.SetSection("rodata", -1)
	a.EmitUint64(0)
	a.DefineLabel("Lstr") // defined local L, reloc-referenced, 8 bytes in
	a.EmitUint64(1)
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail("unexpected assembler error") }
	if a.NumRelocs != 1 { return fail("the ADRP should produce one relocation") }
	if !retargetTemporaryRelocs(a) { return fail(a.ErrorMsg) }

	var anchor int = a.LookupSymbol("ltmp1")
	if anchor < 0 { return fail("the rodata start anchor ltmp1 was not defined") }
	if a.Relocs[0].Symbol != anchor || a.Relocs[0].Addend != 8 {
		return fail("the relocation must target ltmp1 + 8")
	}
	var lstrIdx int = a.LookupSymbol("Lstr")

	var order @[]int
	var newIndex @[]int
	var nLocal int
	var nExtDef int
	var nUndef int
	order, newIndex, nLocal, nExtDef, nUndef = partitionSymbols(a)

	if newIndex[lstrIdx] != -1 { return fail("the temporary Lstr must not be listed") }
	if order[0] != anchor { return fail("the sole emitted local should be ltmp1") }
	if nLocal != 1 { return fail("expected 1 local (ltmp1)") }
	if nExtDef != 1 { return fail("expected 1 defined-external (_main)") }
	if nUndef != 0 { return fail("expected 0 undefined") }
	return ""
}
