package "pkg/binate/asm/macho"

import "pkg/binate/asm"

// Where Write places each section.  The headers follow the order the sections were
// created in, as clang writes them, so a section's n_sect is its index + 1.  Regular
// sections come first in the address space, in that order, each at an address aligned to
// its alignment (sectionAlignment) and at file offset dataOffset + its address.  Zero-fill
// sections (bss) come after them — as clang places them — with an address past every
// regular section, file offset 0 and no bytes in the file; ld -ld_classic rejects a
// zero-fill section with a file offset.

// machoLayout records the placement: addresses, file offsets, and the segment's file and
// address extents.
type machoLayout struct {
	Addr     @[]int // section index -> address
	Offset   @[]int // section index -> file offset (0 for a zero-fill section)
	FileSize int // the regular sections' span in the file, from dataOffset
	VMSize   int // the segment's address span, zero-fill sections included
}

// isZeroFillSection reports whether section s is stored without file contents (S_ZEROFILL,
// S_THREAD_LOCAL_ZEROFILL).
func isZeroFillSection(s @asm.Section) bool {
	return asm.IsZeroFill(s.Name)
}

// sectionAlignment returns section s's alignment in bytes: what its contents ask
// (Section.Align, at least 1) when a.AlignAsAsked, as clang aligns a section; else at least 8
// (data's runtime alignment: ld rejects an ARM64_RELOC_UNSIGNED at an address not a
// multiple of 8).
func sectionAlignment(a @asm.Assembler, s @asm.Section) int {
	if a.AlignAsAsked {
		if s.Align > 1 { return s.Align }
		return 1
	}
	if s.Align > 8 { return s.Align }
	return 8
}

// machoSectAlignExp returns the alignment exponent section s's header records: its
// alignment's (sectionAlignment) when a.AlignAsAsked, else its name's default raised to its
// contents' (machoSectAlignFor).
func machoSectAlignExp(a @asm.Assembler, s @asm.Section) uint32 {
	if !a.AlignAsAsked { return machoSectAlignFor(s.Name, s.Align) }
	var e uint32 = 0
	for bytes := 1; bytes < sectionAlignment(a, s); bytes = bytes * 2 { e = e + 1 }
	return e
}

// layoutSections places a's sections, the regular ones' contents starting at file offset
// dataOffset: the addresses in the order the sections were created, the zero-fill sections
// after every regular one.
func layoutSections(a @asm.Assembler, dataOffset int) machoLayout {
	var lay machoLayout
	var n int = a.NumSections
	lay.Addr = make_slice(int, n)
	lay.Offset = make_slice(int, n)
	var addr int = 0
	for pass := 0; pass < 2; pass++ {
		for i := 0; i < n; i++ {
			var s @asm.Section = a.Sections[i]
			if isZeroFillSection(s) != (pass == 1) { continue }
			var sa int = sectionAlignment(a, s)
			if addr % sa != 0 { addr = addr + (sa - addr % sa) }
			lay.Addr[i] = addr
			if pass == 0 { lay.Offset[i] = dataOffset + addr }
			addr = addr + s.Len
		}
		if pass == 0 { lay.FileSize = addr }
	}
	lay.VMSize = addr
	return lay
}
