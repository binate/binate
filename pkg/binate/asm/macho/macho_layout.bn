package "pkg/binate/asm/macho"

import "pkg/binate/asm"

// Where Write places each section.  Regular sections come first, in assembler order,
// each at an address aligned to 8 (data's runtime alignment; an ARM64_RELOC_UNSIGNED
// at a non-8-aligned address makes ld reject the object) or to the larger alignment
// the section asked for, and at file offset dataOffset + its address.  Zero-fill
// sections (bss) come after them — as clang places them — with an address past every
// regular section, file offset 0 and no bytes in the file; ld -ld_classic rejects a
// zero-fill section with a file offset.

// machoLayout records the placement: header order, addresses, file offsets, and the
// segment's file and address extents.
type machoLayout struct {
	Order    @[]int // header position -> section index
	Pos      @[]int // section index -> header position (its n_sect is Pos + 1)
	Addr     @[]int // section index -> address
	Offset   @[]int // section index -> file offset (0 for a zero-fill section)
	FileSize int // the regular sections' span in the file, from dataOffset
	VMSize   int // the segment's address span, zero-fill sections included
}

// isZeroFillSection reports whether section s is stored without file contents.
func isZeroFillSection(s @asm.Section) bool {
	return machoSectType(s.Name) == S_ZEROFILL
}

// sectionAlignment returns the alignment section s starts on: at least 8.
func sectionAlignment(s @asm.Section) int {
	if s.Align > 8 { return s.Align }
	return 8
}

// layoutSections places a's sections, the regular ones' contents starting at file
// offset dataOffset (a multiple of every section's alignment).
func layoutSections(a @asm.Assembler, dataOffset int) machoLayout {
	var lay machoLayout
	var n int = a.NumSections
	lay.Order = make_slice(int, n)
	lay.Pos = make_slice(int, n)
	lay.Addr = make_slice(int, n)
	lay.Offset = make_slice(int, n)
	var h int = 0
	var addr int = 0
	for pass := 0; pass < 2; pass++ {
		for i := 0; i < n; i++ {
			var s @asm.Section = a.Sections[i]
			if isZeroFillSection(s) != (pass == 1) { continue }
			var sa int = sectionAlignment(s)
			if addr % sa != 0 { addr = addr + (sa - addr % sa) }
			lay.Order[h] = i
			lay.Pos[i] = h
			h = h + 1
			lay.Addr[i] = addr
			if pass == 0 { lay.Offset[i] = dataOffset + addr }
			addr = addr + s.Len
		}
		if pass == 0 { lay.FileSize = addr }
	}
	lay.VMSize = addr
	return lay
}
