package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Mach-O layout: a header per section, empty ones included, and every section's file
// offset equal to the data start plus its address — so an aligned section is aligned
// in the file too, and every offset the load commands name (including the symbol and
// string tables after an empty, highly aligned last section) is where its bytes are.
// (madRead / madU32 are in macho_addend_test.bn; assembleAndRun in macho_test.bn.)

// mlProgram returns an assembler holding `_main: mov w0, #5; ret` in text, plus a
// data section that is empty (dataFirst: created before text) or, otherwise, holds
// one byte, 64-byte padding and a word; in both cases the data section requested
// 64-byte alignment.
func mlProgram(dataFirst bool) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	if dataFirst {
		a.SetSection("data", -1)
		a.Align(64)
	}
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Movz(a, false, aarch64.X0, 5, 0)
	aarch64.Ret(a)
	if !dataFirst {
		a.SetSection("data", -1)
		a.EmitUint8(1)
		a.Align(64)
		a.EmitUint64(5)
	}
	return a
}

// mlEmptyLast returns an assembler whose last section is an empty data section that
// requested 64-byte alignment.
func mlEmptyLast() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Movz(a, false, aarch64.X0, 5, 0)
	aarch64.Ret(a)
	a.SetSection("data", -1)
	a.Align(64)
	return a
}

// mlCheckLayout writes a, reads it back and checks: nsects is the number of
// sections; each section's offset is the first one's offset plus the address delta
// and a multiple of its alignment; and the string table ends within the file.
func mlCheckLayout(a @asm.Assembler, path *[]readonly char) @[]char {
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return "assembler error" }
	if !WriteARM64(a, path) { return "failed to write the object" }
	b, n := madRead(path)
	if n < 100 { return "cannot read the object back" }
	var nsects int = cast(int, madU32(b, 32 + 64))
	if nsects != a.NumSections { return "nsects must count every section, empty ones included" }
	var base int = -1
	for i := 0; i < nsects; i++ {
		var sh int = madSect0() + 80 * i
		var addr int = cast(int, madU32(b, sh + 32))
		var off int = cast(int, madU32(b, sh + 48))
		var align int = 1
		for k := 0; k < cast(int, madU32(b, sh + 52)); k++ { align = align * 2 }
		if base < 0 { base = off - addr }
		if off - addr != base { return "section offsets must track their addresses" }
		if off % align != 0 { return "a section's file offset must honor its alignment" }
	}
	var symtab int = madSect0() + 80 * nsects
	if madU32(b, symtab) != 2 { return "LC_SYMTAB must follow the segment command" }
	var stroff int = cast(int, madU32(b, symtab + 16))
	var strsize int = cast(int, madU32(b, symtab + 20))
	if stroff + strsize > n { return "the string table lies past the end of the file" }
	return ""
}

// An empty last section that asked for 64-byte alignment leaves the symbol and string
// tables where the load commands say, and the object links and runs.
func TestMachoEmptyAlignedLastSection() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var e @[]char = mlCheckLayout(mlEmptyLast(), buf.Concat(dir, "/macho_layout_last.o"))
	if len(e) > 0 { return fail(e) }
	if !canLinkAndRun() { return "" }
	return assembleAndRun(mlEmptyLast(), 5)
}

// An empty section before the code still gets a header (nsects counts it), and the
// object links and runs.
func TestMachoEmptyFirstSection() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var e @[]char = mlCheckLayout(mlProgram(true), buf.Concat(dir, "/macho_layout_first.o"))
	if len(e) > 0 { return fail(e) }
	if !canLinkAndRun() { return "" }
	return assembleAndRun(mlProgram(true), 5)
}

// A 64-byte-aligned data section after the code sits on a 64-byte file offset, in
// lock-step with its address.
func TestMachoAlignedSectionOffsets() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var e @[]char = mlCheckLayout(mlProgram(false), buf.Concat(dir, "/macho_layout_aligned.o"))
	if len(e) > 0 { return fail(e) }
	if !canLinkAndRun() { return "" }
	return assembleAndRun(mlProgram(false), 5)
}

// A zero-fill (bss) section is placed as clang places it: its header after the
// regular sections', its address past theirs, file offset 0 and no bytes in the file
// (the segment's filesize ends with the regular sections).  The object links — with
// the classic linker too, where available, which rejects a zero-fill section with a
// file offset — and a program reading a bss word sees zero.
func TestMachoZeroFillLayout() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X0, "_z")
	aarch64.LdrImmLabel(a, false, aarch64.X0, aarch64.X0, "_z")
	aarch64.Ret(a)
	a.SetSection("bss", -1)
	a.DefineLabel("_z")
	a.Zero(16)
	a.SetSection("data", -1)
	a.DefineLabel("_d")
	a.EmitUint64(5)
	a.ObjFormat = asm.OBJ_MACHO
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_zerofill.o")
	if !WriteARM64(a, path) { return fail("failed to write the object") }
	b, n := madRead(path)
	if n < 100 { return fail("cannot read the object back") }
	// Headers: text, data, then bss.
	var bss int = madSect0() + 80 * 2
	if b[bss] != '_' || b[bss + 2] != 'b' { return fail("the zero-fill header must come last") }
	if madU32(b, bss + 48) != 0 { return fail("a zero-fill section has file offset 0") }
	var dataHdr int = madSect0() + 80
	var bssAddr uint32 = madU32(b, bss + 32)
	if bssAddr < madU32(b, dataHdr + 32) + 8 { return fail("bss must be placed after data") }
	var filesize uint32 = madU32(b, 32 + 48)
	if filesize > bssAddr { return fail("the segment's filesize must not cover bss") }
	if !canLinkAndRun() { return "" }
	var classic bool = ldClassicAvailable()
	for pass := 0; pass < 2; pass++ {
		if pass == 1 && !classic { break }
		var args @[]@[]char = make_slice(@[]char, 7)
		args[0] = "-arch"
		args[1] = "arm64"
		args[2] = "-o"
		args[3] = buf.Concat(dir, "/macho_zerofill")
		args[4] = buf.CopyStr(path)
		args[5] = "-Wl,-e,_main"
		args[6] = "-Wl,-dead_strip"
		if pass == 1 { args[6] = "-Wl,-ld_classic" }
		if execExit("cc", args) != 0 { return fail("the linker rejected the object") }
		if execExit(buf.Concat(dir, "/macho_zerofill"), make_slice(@[]char, 0)) != 0 {
			return fail("a bss word must read as zero")
		}
	}
	return ""
}
