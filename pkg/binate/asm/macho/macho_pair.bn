package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"

// A difference S - B + A (asm.Relocation.HasSub) is a Mach-O relocation pair: a SUBTRACTOR
// entry for B, then the UNSIGNED entry for S at the same address and of the same length,
// the addend in the field — the order ld64 reads, as clang writes it.

// machoSubtractorType returns cpuType's SUBTRACTOR relocation type.
func machoSubtractorType(cpuType int) int {
	if cpuType == CPU_TYPE_X86_64 { return X86_64_RELOC_SUBTRACTOR }
	return ARM64_RELOC_SUBTRACTOR
}

// writeMachoSubtractor appends rel's SUBTRACTOR entry (for its SubSymbol, remapped through
// symNewIndex).  Returns (bb, false) with a's error set when the subtracted symbol is not in
// the symbol table, or is the symbol subtracted from (a pair of one base, which ld64 rejects;
// the parser folds such a difference to a number).
func writeMachoSubtractor(bb BinBuf, a @asm.Assembler, rel asm.Relocation, symNewIndex @[]int,
		cpuType int) (BinBuf, bool) {
	var name @[]char = asm.LabelForMessage(a.Symbols[rel.SubSymbol].Name)
	if symNewIndex[rel.SubSymbol] < 0 {
		a.SetError(
				buf.Concat(buf.Concat("macho: a difference subtracts '", name),
						"', which is not in the symbol table"))
		return bb, false
	}
	if rel.SubSymbol == rel.Symbol {
		a.SetError(
				buf.Concat(buf.Concat("macho: a difference of two locations in one atom of '", name), "'"))
		return bb, false
	}
	bb = bb.WriteU32(cast(uint32, rel.Offset))
	var info uint32 = cast(uint32, symNewIndex[rel.SubSymbol] & 0x00FFFFFF)
	info = info | (cast(uint32, machoRelocLength(rel.Kind, cpuType) & 3) << 25)
	info = info | (cast(uint32, 1) << 27) // r_extern
	info = info | (cast(uint32, machoSubtractorType(cpuType) & 0xF) << 28)
	bb = bb.WriteU32(info)
	return bb, true
}
