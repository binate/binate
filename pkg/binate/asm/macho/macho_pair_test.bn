package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A difference S - B + A in data (asm.Relocation.HasSub) is a SUBTRACTOR entry for B then
// the UNSIGNED for S, at one address and of one length, the addend in the field — clang's
// pair; a temporary on either side moves to its atom, its offset in the addend with its
// sign.  (madRead / madU32 / madSect0 / madRelocAt / madNReloc are in macho_addend_test.bn,
// atomsLinkRun in macho_atoms_test.bn, canLinkAndRun / testTmpDir in macho_test.bn.)

// pairAsm returns a data section (section 0) holding `Lf - _d` (4 bytes) and `_f - Ld + 8`
// (8 bytes), then a text section of _f, Lf: Lf moves to _f + 4 and Ld to _d + 4.
func pairAsm() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("data", -1)
	a.DefineLabel("_d")
	a.AddDiffFixup("Lf", "_d", asm.FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	a.DefineLabel("Ld")
	a.AddDiffFixup("_f", "Ld", asm.FIX_DATA_ABS64, 8, 8)
	a.Zero(8)
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Lf")
	a.EmitUint32(0xD503201F)
	return a
}

// pairCheck writes a for cpu and checks its first section's four relocation entries — each
// pair a SUBTRACTOR (subType) then an UNSIGNED, r_extern, not PC-relative, the pair's
// length (2, then 3) — the subtracted symbol and the symbol subtracted from differing,
// and the fields 4 (Lf at _f + 4) and 4 (8 less Ld's offset 4 in _d).
func pairCheck(a @asm.Assembler, x86 bool, subType uint32) testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	if !a.Finalize() { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/pair.o")
	var ok bool = false
	if x86 {
		ok = WriteX86_64(a, path)
	} else {
		ok = WriteARM64(a, path)
	}
	if !ok { return fail(buf.Concat("write failed: ", a.ErrorMsg)) }
	b, n := madRead(path)
	if n < 100 { return fail("cannot read the object back") }
	if madNReloc(b) != 4 { return fail("not four relocation entries") }
	for i := 0; i < 4; i++ {
		addr, info := madRelocAt(b, i)
		var wantType uint32 = subType
		if i % 2 == 1 { wantType = 0 }
		var wantLen uint32 = 2
		var wantAddr uint32 = 0
		if i >= 2 {
			wantLen = 3
			wantAddr = 4
		}
		if addr != wantAddr || (info >> 28) != wantType || ((info >> 25) & 3) != wantLen ||
				((info >> 27) & 1) != 1 || ((info >> 24) & 1) != 0 {
			return fail("an entry of the pair is not as clang writes it")
		}
	}
	_, s0 := madRelocAt(b, 0)
	_, u0 := madRelocAt(b, 1)
	if (s0 & 0xFFFFFF) == (u0 & 0xFFFFFF) {
		return fail("the pair subtracts the symbol it subtracts from")
	}
	var data int = cast(int, madU32(b, madSect0() + 48))
	if madU32(b, data) != 4 || madU32(b, data + 4) != 4 || madU32(b, data + 8) != 0 {
		return fail("the fields' addends are not 4 and 4")
	}
	return ""
}

func TestMachoDifferencePairArm64() testing.TestResult {
	return pairCheck(pairAsm(), false, cast(uint32, ARM64_RELOC_SUBTRACTOR))
}

func TestMachoDifferencePairX86() testing.TestResult {
	return pairCheck(pairAsm(), true, cast(uint32, X86_64_RELOC_SUBTRACTOR))
}

// relPtrProg returns `_main`, which reads two relative pointers in `_tbl` — `.long _target
// - _tbl` and `.long Ltgt - .`, Ltgt inside _target's atom — and returns 7 when both lead to
// their targets, else 0.
func relPtrProg() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.Adrp(a, aarch64.X0, "_tbl")
	isa.AddSubLo12(a, true, aarch64.X0, aarch64.X0, "_tbl", 0, false)
	a.EmitUint32(0xB9800001) // ldrsw x1, [x0]
	a.EmitUint32(0x8B010001) // add x1, x0, x1
	a.EmitUint32(0xB9800402) // ldrsw x2, [x0, #4]
	a.EmitUint32(0x8B020002) // add x2, x0, x2
	a.EmitUint32(0x91001042) // add x2, x2, #4
	aarch64.Adrp(a, aarch64.X3, "_target")
	isa.AddSubLo12(a, true, aarch64.X3, aarch64.X3, "_target", 0, false)
	a.EmitUint32(0x91001064) // add x4, x3, #4
	a.EmitUint32(0xD2800000) // mov x0, #0
	a.EmitUint32(0xEB03003F) // cmp x1, x3
	a.EmitUint32(0x540000A1) // b.ne fail
	a.EmitUint32(0xEB04005F) // cmp x2, x4
	a.EmitUint32(0x54000061) // b.ne fail
	a.EmitUint32(0xD28000E0) // mov x0, #7
	a.EmitUint32(0xD65F03C0) // ret
	a.EmitUint32(0xD65F03C0) // fail: ret
	a.DefineLabel("_target")
	a.EmitUint32(0xD503201F)
	a.DefineLabel("Ltgt")
	a.EmitUint32(0xD503201F)
	a.SetSection("data", -1)
	a.DefineLabel("_tbl")
	a.AddDiffFixup("_target", "_tbl", asm.FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	a.DefineLabel("Ldot")
	a.AddDiffFixup("Ltgt", "Ldot", asm.FIX_DATA_ABS32, 0, 4)
	a.Zero(4)
	return a
}

// The relative pointers link (ld64) and run, both reaching their targets (exit 7).
func TestMachoDifferenceRuns() testing.TestResult {
	if !canLinkAndRun() { return "" }
	code, why := atomsLinkRun(relPtrProg())
	if code != 7 { return fail(buf.Concat("expected exit 7: ", why)) }
	return ""
}
