package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// (fail() is defined in macho_test.bn, same package.)

// TestMachoRelocType pins the fixup-kind -> Mach-O relocation-type mapping,
// including that a kind with no Mach-O encoding returns -1 (so the writer
// errors rather than emitting a wrong-instruction reloc).
func TestMachoRelocType() testing.TestResult {
	if machoRelocType(100, CPU_TYPE_ARM64) != ARM64_RELOC_BRANCH26 {
		return fail("ARM64 BL -> BRANCH26")
	}
	if machoRelocType(103, CPU_TYPE_ARM64) != ARM64_RELOC_PAGE21 {
		return fail("ARM64 ADRP -> PAGE21")
	}
	if machoRelocType(0, CPU_TYPE_ARM64) != ARM64_RELOC_UNSIGNED {
		return fail("ARM64 absolute -> UNSIGNED")
	}
	if machoRelocType(300, CPU_TYPE_X86_64) != X86_64_RELOC_BRANCH {
		return fail("x86 CALL -> BRANCH")
	}
	if machoRelocType(302, CPU_TYPE_X86_64) != X86_64_RELOC_SIGNED {
		return fail("x86 LEA -> SIGNED")
	}
	if machoRelocType(0, CPU_TYPE_X86_64) != X86_64_RELOC_UNSIGNED {
		return fail("x86 absolute -> UNSIGNED")
	}
	if machoRelocType(101, CPU_TYPE_ARM64) != -1 {
		return fail("BRANCH19 has no Mach-O reloc -> -1")
	}
	return ""
}

// TestMachoRelocLength pins r_length (log2 of the patched field's byte size).
func TestMachoRelocLength() testing.TestResult {
	if machoRelocLength(0, CPU_TYPE_ARM64) != 3 {
		return fail("absolute = 8 bytes (len 3)")
	}
	if machoRelocLength(100, CPU_TYPE_ARM64) != 2 {
		return fail("ARM64 instruction = 4 bytes (len 2)")
	}
	if machoRelocLength(300, CPU_TYPE_X86_64) != 2 {
		return fail("rel32 = 4 bytes (len 2)")
	}
	if machoRelocLength(301, CPU_TYPE_X86_64) != 3 {
		return fail("abs64 = 8 bytes (len 3)")
	}
	return ""
}

// TestMachoRelocPCRel pins r_pcrel.
func TestMachoRelocPCRel() testing.TestResult {
	if machoRelocPCRel(100, CPU_TYPE_ARM64) != 1 { return fail("BRANCH26 is pc-relative") }
	if machoRelocPCRel(0, CPU_TYPE_ARM64) != 0 { return fail("ARM64 absolute is not pc-relative") }
	if machoRelocPCRel(300, CPU_TYPE_X86_64) != 1 { return fail("REL32 is pc-relative") }
	if machoRelocPCRel(0, CPU_TYPE_X86_64) != 0 { return fail("x86 absolute is not pc-relative") }
	return ""
}

// TestBakeAddend checks the inline-addend write that fixes the static-managed
// pointer bug: Mach-O has no addend field, so a non-zero fixup addend — the
// load-bearing case is +16 (a managed pointer skipping its node's 2-word
// header to land on the payload) — is written little-endian into the slot.
func TestBakeAddend() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("data", -1)
	for i := 0; i < 8; i++ { a.EmitUint8(cast(uint8, 0)) }
	var s @asm.Section = a.Sections[0]

	bakeAddend(s.Data, 0, 16, 8)
	if s.Data[0] != cast(uint8, 16) { return fail("addend 16 should land in byte 0") }
	for i := 1; i < 8; i++ {
		if s.Data[i] != cast(uint8, 0) { return fail("addend 16 high bytes should be 0") }
	}

	// Multi-byte value confirms little-endian order: 0x0102 -> [0x02, 0x01].
	bakeAddend(s.Data, 0, 0x0102, 8)
	if s.Data[0] != cast(uint8, 0x02) { return fail("LE low byte should be 0x02") }
	if s.Data[1] != cast(uint8, 0x01) { return fail("LE second byte should be 0x01") }
	return ""
}
