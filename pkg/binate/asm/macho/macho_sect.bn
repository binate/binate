package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"

// The Mach-O segment, section name, type, attributes and alignment of an assembler section,
// and the sections a Mach-O object cannot express.

// machoSegName returns the Mach-O segment of a section named name with flags (asm.SF_*):
// relro data in __DATA_CONST, any other writable section in __DATA, and a read-only or
// executable one in __TEXT (text, and rodata as __TEXT,__const).
func machoSegName(name *[]readonly char, flags int) *[]readonly char {
	// Relocatable read-only data: __DATA_CONST is the segment ld marks
	// read-only after applying fixups (SG_READ_ONLY), so its __const may
	// bear relocations — unlike __TEXT,__const, which rejects them.
	if charsEqual(name, "rodata_relro") { return "__DATA_CONST" }
	if (flags & asm.SF_WRITE) != 0 { return "__DATA" }
	return "__TEXT"
}

// machoSectName maps an assembler section name to a Mach-O section name.
// Returns a borrowed pointer to a string literal — valid for the program lifetime.
func machoSectName(name *[]readonly char) *[]readonly char {
	if charsEqual(name, "text") { return "__text" }
	if charsEqual(name, "rodata") { return "__const" }
	// __DATA_CONST,__const — same section name as __TEXT,__const, placed in
	// the read-only-after-fixup segment via machoSegName.
	if charsEqual(name, "rodata_relro") { return "__const" }
	if charsEqual(name, "data") { return "__data" }
	if charsEqual(name, "bss") { return "__bss" }
	return name
}

// machoSectType returns the Mach-O section type for a section name: zero-fill
// (asm.IsZeroFill) or regular.
func machoSectType(name *[]readonly char) uint32 {
	if asm.IsZeroFill(name) { return S_ZEROFILL }
	return S_REGULAR
}

// machoSectAttrs returns the Mach-O section attributes for a section's flags (asm.SF_*): an
// executable section holds only instructions, as clang marks __TEXT,__text.
func machoSectAttrs(flags int) uint32 {
	if (flags & asm.SF_EXEC) != 0 {
		return S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
	}
	return 0
}

// machoSectAlign returns the Mach-O section alignment as a power-of-2 exponent
// (align field is 2^N). Data holds 64-bit globals so must be 8-byte aligned;
// text instructions only need 4-byte alignment.
func machoSectAlign(name *[]readonly char) uint32 {
	if charsEqual(name, "data") { return 3 } // 2^3 = 8 bytes
	if charsEqual(name, "bss") { return 3 } // same
	// Relro holds pointer-bearing nodes/vtables whose ARM64_RELOC_UNSIGNED
	// slots ld requires 8-byte aligned ("pointer not aligned"), like __data.
	if charsEqual(name, "rodata_relro") { return 3 }
	return 2 // 2^2 = 4 bytes
}

// machoSectAlignFor returns a section's alignment exponent: the name-based default
// (machoSectAlign), raised to cover requested (a byte alignment from Align/AlignFill,
// 0 for none).
func machoSectAlignFor(name *[]readonly char, requested int) uint32 {
	var e uint32 = machoSectAlign(name)
	var need uint32 = 0
	var bytes int = 1
	for bytes < requested {
		bytes = bytes * 2
		need = need + 1
	}
	if need > e { return need }
	return e
}

// machoIsArraySection reports whether name is an init, fini or preinit array's, alone or with
// a "." suffix.
func machoIsArraySection(name *[]readonly char) bool {
	return asm.SectionNameIs(name, "init_array") || asm.SectionNameIs(name, "fini_array") ||
			asm.SectionNameIs(name, "preinit_array")
}

// machoMaxSectNameLen is the longest Mach-O section name: the 16 bytes of sectname.
const machoMaxSectNameLen int = 16

// machoSectionsOk reports whether a Mach-O object can express every section, else sets the
// error: its name must fit sectname (1 to 16 characters, as clang requires), and
// it must be loaded (SF_READ — Mach-O has no unloaded section) and not both writable and
// executable (no Mach-O segment is both: __TEXT is not writable, __DATA not executable).  An
// init, fini or preinit array (alone or with a "." suffix) is rejected too: written as an
// ordinary section, its functions would silently never run.
func machoSectionsOk(a @asm.Assembler) bool {
	for i := 0; i < a.NumSections; i++ {
		var f int = a.Sections[i].Flags
		var why *[]readonly char = ""
		var n int = len(machoSectName(a.Sections[i].Name))
		if n == 0 || n > machoMaxSectNameLen {
			why = "' is not 1 to 16 characters long, as a Mach-O section name must be"
		} else if (f & asm.SF_READ) == 0 {
			why = "' is not loaded (no SF_READ), which a Mach-O section cannot express"
		} else if (f & asm.SF_WRITE) != 0 && (f & asm.SF_EXEC) != 0 {
			why = "' is writable and executable, which no Mach-O segment is"
		} else if machoIsArraySection(a.Sections[i].Name) {
			why = "' is an init, fini or preinit array, which the Mach-O writer does not support"
		}
		if len(why) == 0 { continue }
		a.SetError(buf.Concat(buf.Concat("macho: section '", a.Sections[i].Name), why))
		return false
	}
	return true
}
