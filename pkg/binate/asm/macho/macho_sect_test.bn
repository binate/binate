package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A section's Mach-O segment, name, type, attributes and alignment (macho_sect.bn), and the
// sections a Mach-O object cannot express.  (madRead / madU32 / madSect0 are in
// macho_addend_test.bn; assembleAndRun, canLinkAndRun and testTmpDir in macho_test.bn.)

// Direct test of machoSectAlign: data/bss need 8-byte alignment (2^3) for
// 64-bit loads; text only needs 4-byte alignment (2^2).
func TestSectAlignHelper() testing.TestResult {
	if machoSectAlign("text") != 2 { return fail("text align should be 2 (4 bytes)") }
	if machoSectAlign("data") != 3 { return fail("data align should be 3 (8 bytes)") }
	if machoSectAlign("bss") != 3 { return fail("bss align should be 3 (8 bytes)") }
	if machoSectAlign("rodata") != 2 { return fail("rodata align should be 2 (4 bytes)") }
	// rodata_relro holds pointer-bearing nodes/vtables → 8-byte aligned,
	// like __data, so ARM64_RELOC_UNSIGNED slots land 8-aligned.
	if machoSectAlign("rodata_relro") != 3 {
		return fail("rodata_relro align should be 3 (8 bytes, holds pointers)")
	}
	return ""
}

// The thread-local sections: tdata, tbss and thread_vars are clang's __thread_data,
// __thread_bss and __thread_vars, each its thread-local type, aligned as data; a thread-local
// section of another name keeps its name and takes the thread-local kind of zero-fill or regular.
func TestThreadLocalSectionMapping() testing.TestResult {
	var tls int = asm.SF_READ | asm.SF_WRITE | asm.SF_TLS
	var rw int = asm.SF_READ | asm.SF_WRITE
	if !charsEqual(machoSectName("tdata"), "__thread_data") ||
			!charsEqual(machoSectName("tbss"), "__thread_bss") ||
			!charsEqual(machoSectName("thread_vars"), "__thread_vars") {
		return fail("a thread-local section's name is not clang's")
	}
	if machoSectType("tdata", tls) != S_THREAD_LOCAL_REGULAR ||
			machoSectType("tbss", tls) != S_THREAD_LOCAL_ZEROFILL ||
			machoSectType("thread_vars", rw) != S_THREAD_LOCAL_VARIABLES ||
			machoSectType("tbss.x", tls) != S_THREAD_LOCAL_ZEROFILL ||
			machoSectType("mytls", tls) != S_THREAD_LOCAL_REGULAR ||
			machoSectType("bss.x", rw) != S_ZEROFILL || machoSectType("data", rw) != S_REGULAR {
		return fail("a section has the wrong type")
	}
	if machoSectAlign("tdata") != 3 || machoSectAlign("tbss") != 3 ||
			machoSectAlign("thread_vars") != 3 {
		return fail("a thread-local section is not aligned as data")
	}
	if !charsEqual(machoSegName("tdata", tls), "__DATA") { return fail("tdata is not in __DATA") }
	return ""
}

// Relro section mapping: a "rodata_relro" section lands in the
// __DATA_CONST segment (made read-only after dyld applies fixups, so it
// MAY bear relocations — unlike __TEXT,__const, which the linker rejects
// text-relocations in) with section name __const.  reloc-free "rodata"
// stays in __TEXT,__const.
func TestRelroSectionMapping() testing.TestResult {
	if !charsEqual(machoSegName("rodata_relro", asm.SF_READ | asm.SF_WRITE), "__DATA_CONST") {
		return fail("rodata_relro segment should be __DATA_CONST")
	}
	if !charsEqual(machoSectName("rodata_relro"), "__const") {
		return fail("rodata_relro section should be __const")
	}
	if !charsEqual(machoSegName("rodata", asm.SF_READ), "__TEXT") {
		return fail("reloc-free rodata should remain in __TEXT")
	}
	return ""
}

// sectProgram returns an unfinalized program whose _main branches to _f, in the executable
// section fast, which returns 7; it also has a writable section rw, a read-only one ro and a
// zero-fill one bss.z.
func sectProgram() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	aarch64.B(a, "_f")
	a.SetSection("fast", asm.SF_READ | asm.SF_EXEC)
	a.DefineLabel("_f")
	aarch64.Mov(a, false, aarch64.X0, aarch64.Imm(7))
	aarch64.Ret(a)
	a.SetSection("rw", asm.SF_READ | asm.SF_WRITE)
	a.EmitUint64(1)
	a.SetSection("ro", asm.SF_READ)
	a.EmitUint32(2)
	a.SetSection("bss.z", asm.SF_READ | asm.SF_WRITE)
	a.Zero(8)
	return a
}

// sectHdrIs reports whether the Mach-O object b has a section header for sect in segment seg
// with flags (type and attributes) flags.
func sectHdrIs(b @[]uint8, sect *[]readonly char, seg *[]readonly char, flags uint32) bool {
	var nsects int = cast(int, madU32(b, 32 + 64))
	for h := 0; h < nsects; h++ {
		var at int = madSect0() + 80 * h
		if fixedNameIs(b, at, sect) { return fixedNameIs(b, at + 16, seg) && madU32(b, at + 64) == flags }
	}
	return false
}

// fixedNameIs reports whether the 16-byte, NUL-padded name at b[at] is name.
func fixedNameIs(b @[]uint8, at int, name *[]readonly char) bool {
	for i := 0; i < len(name); i++ {
		if b[at + i] != cast(uint8, name[i]) { return false }
	}
	return len(name) == 16 || b[at + len(name)] == 0
}

// A section made with other than a well-known name is placed by its flags: an executable one
// in __TEXT, marked as holding instructions (as __TEXT,__text is); a writable one in __DATA;
// a read-only one in __TEXT (as rodata's __const); a zero-fill one is S_ZEROFILL.  Code in the
// executable section runs.
func TestMachoSectionPlacementByFlags() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = sectProgram()
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_sect_flags.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 100 { return fail("cannot read the object back") }
	var code uint32 = S_REGULAR | S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS
	if !sectHdrIs(b, "__text", "__TEXT", code) || !sectHdrIs(b, "fast", "__TEXT", code) {
		return fail("an executable section is not in __TEXT, holding instructions")
	}
	if !sectHdrIs(b, "rw", "__DATA", S_REGULAR) {
		return fail("the writable section is not in __DATA")
	}
	if !sectHdrIs(b, "ro", "__TEXT", S_REGULAR) {
		return fail("the read-only section is not in __TEXT")
	}
	if !sectHdrIs(b, "bss.z", "__DATA", S_ZEROFILL) {
		return fail("bss.z is not a __DATA zero-fill section")
	}
	if !canLinkAndRun() { return "" }
	return assembleAndRun(sectProgram(), 7)
}

// sectRejected reports whether writing an object with one section named name, made with
// flags, fails with an error containing want.
func sectRejected(dir *[]readonly char, name *[]readonly char, flags int,
		want *[]readonly char) bool {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection(name, flags)
	a.EmitUint32(0)
	a.Finalize()
	if a.HasError { return false }
	if WriteARM64(a, buf.Concat(dir, "/macho_sect_rejected.o")) { return false }
	for i := 0; i + len(want) <= len(a.ErrorMsg); i++ {
		if charsEqual(a.ErrorMsg[i:i + len(want)], want) { return true }
	}
	return false
}

// A section a Mach-O object cannot express is rejected: an unloaded one (no SF_READ), a
// writable executable one, one whose name does not fit the 16 bytes of sectname (as clang
// rejects a 17-character name and takes a 16-character one), and an init, fini or preinit
// array, whose functions would otherwise silently never run.
func TestMachoSectionsOk() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	if !sectRejected(dir, "meta", 0, "'meta' is not loaded") ||
			!sectRejected(dir, "wonly", asm.SF_WRITE, "'wonly' is not loaded") {
		return fail("an unloaded section was accepted")
	}
	if !sectRejected(dir, "rwx", asm.SF_READ | asm.SF_WRITE | asm.SF_EXEC,
			"'rwx' is writable and executable") {
		return fail("a writable executable section was accepted")
	}
	if !sectRejected(dir, "abcdefghijklmnopq", asm.SF_READ, "is not 1 to 16 characters long") {
		return fail("a 17-character section name was accepted")
	}
	if !sectRejected(dir, "init_array", -1, "'init_array' is an init, fini or preinit array") ||
			!sectRejected(dir, "fini_array.1", -1, "'fini_array.1' is an init, fini or preinit array") ||
			!sectRejected(dir, "preinit_array", -1, "'preinit_array' is an init, fini or preinit array") {
		return fail("an init, fini or preinit array was accepted")
	}
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("abcdefghijklmnop", asm.SF_READ)
	a.EmitUint32(0)
	a.Finalize()
	if !WriteARM64(a, buf.Concat(dir, "/macho_sect_16.o")) { return fail(a.ErrorMsg) }
	b, n := madRead(buf.Concat(dir, "/macho_sect_16.o"))
	if n < 100 || !sectHdrIs(b, "abcdefghijklmnop", "__TEXT", S_REGULAR) {
		return fail("a 16-character section name is not written whole")
	}
	return ""
}

// A Mach-O object numbers at most 255 sections (a symbol's n_sect is one byte), so 255 are
// written and 256 rejected, where clang writes an n_sect of 0 (no section) for the anchor of
// the last.
func TestMachoTooManySections() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	for n := 255; n <= 256; n++ {
		var a @asm.Assembler = asm.New(8)
		a.ObjFormat = asm.OBJ_MACHO
		for i := 0; i < n; i++ {
			a.SetSection(buf.Concat("d", decimal(i)), asm.SF_READ | asm.SF_WRITE)
			a.EmitUint32(0)
		}
		a.Finalize()
		if a.HasError { return fail(a.ErrorMsg) }
		var ok bool = WriteARM64(a, buf.Concat(dir, "/macho_many_sections.o"))
		if n == 255 && !ok { return fail(buf.Concat("255 sections: ", a.ErrorMsg)) }
		if n == 256 && (ok || !madHas(a.ErrorMsg, "more than 255 sections")) {
			return fail("256 sections written")
		}
	}
	return ""
}

// The instruction attributes follow clang's: S_ATTR_PURE_INSTRUCTIONS on an executable section
// whether or not it holds any, S_ATTR_SOME_INSTRUCTIONS on a section an instruction was
// emitted into, whatever its kind — so an empty text section has PURE alone, a data section
// holding an instruction SOME alone, and a word emitted as data is no instruction.
func TestMachoSomeInstructionsWhereEmitted() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.SetSection("data", -1)
	aarch64.Ret(a)
	a.SetSection("fast", asm.SF_READ | asm.SF_EXEC)
	a.EmitUint32(0xD65F03C0)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_some_instr.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 100 { return fail("cannot read the object back") }
	if !sectHdrIs(b, "__text", "__TEXT", S_REGULAR | S_ATTR_PURE_INSTRUCTIONS) {
		return fail("the empty text section is not PURE alone")
	}
	if !sectHdrIs(b, "__data", "__DATA", S_REGULAR | S_ATTR_SOME_INSTRUCTIONS) {
		return fail("the data section holding an instruction is not SOME alone")
	}
	if !sectHdrIs(b, "fast", "__TEXT", S_REGULAR | S_ATTR_PURE_INSTRUCTIONS) {
		return fail("a word emitted as data marked the section")
	}
	return ""
}
