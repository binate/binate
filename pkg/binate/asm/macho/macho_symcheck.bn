package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Symbols a Mach-O object can and cannot express — visibilities and common alignments — and
// a common's n_desc.

// machoVisibilitiesOk reports whether every symbol's visibility is one a Mach-O object
// can mark — default or hidden (a private external, N_PEXT) — else sets the error: Mach-O
// has no internal or protected symbol.
func machoVisibilitiesOk(a @asm.Assembler) bool {
	for i := 0; i < a.NumSymbols; i++ {
		var vis int = a.Symbols[i].Visibility
		if vis == asm.VIS_DEFAULT || vis == asm.VIS_HIDDEN { continue }
		a.SetError(
				buf.Concat(buf.Concat("macho: no internal or protected symbol in Mach-O: '", a.Symbols[i].Name),
						"'"))
		return false
	}
	return true
}

// machoMaxCommonAlignLog2 is the largest alignment exponent a common's n_desc holds (its
// four GET_COMM_ALIGN bits allow 15, as ld64 reads them).
const machoMaxCommonAlignLog2 int = 15

// machoCommonsOk reports whether every common's alignment fits its n_desc — at most
// 2^machoMaxCommonAlignLog2 bytes, as clang requires ("invalid 'common' alignment") — else
// sets the error.
func machoCommonsOk(a @asm.Assembler) bool {
	for i := 0; i < a.NumSymbols; i++ {
		var sym asm.Symbol = a.Symbols[i]
		if !sym.Common || alignLog2(sym.CommonAlign) <= machoMaxCommonAlignLog2 { continue }
		a.SetError(
				buf.Concat(buf.Concat("macho: a common's alignment is over 2^15 bytes: '", sym.Name), "'"))
		return false
	}
	return true
}

// machoCommonDesc returns the n_desc bits a common carries — its alignment's exponent in the
// GET_COMM_ALIGN field (bits 8-11) — or 0 for any other symbol.  An alignment of one byte is 0
// there, which ld64 reads as the size's natural alignment (as for a `.comm` with none given).
func machoCommonDesc(sym asm.Symbol) uint16 {
	if !sym.Common { return 0 }
	return cast(uint16, alignLog2(sym.CommonAlign) << 8)
}

// alignLog2 returns the exponent of align, a power of two.
func alignLog2(align int64) int {
	var n int = 0
	var v int64 = 1
	for v < align {
		v = v * 2
		n = n + 1
	}
	return n
}
