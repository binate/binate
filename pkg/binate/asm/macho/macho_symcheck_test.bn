package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// The symbols a Mach-O object cannot express (macho_symcheck.bn) — an internal or protected
// visibility, a common aligned past 2^15 bytes — and a common's n_desc.  (visMachoProgram is in
// macho_visibility_test.bn, testTmpDir in macho_test.bn.)

// A common's n_desc holds its alignment's exponent in bits 8-11 (0 for one byte); any other
// symbol's holds none.
func TestMachoCommonDesc() testing.TestResult {
	var sym asm.Symbol
	sym.Common = true
	var aligns @[]int64 = @[]int64{1, 2, 4, 8, 0x8000}
	var want @[]int = @[]int{0, 0x100, 0x200, 0x300, 0xF00}
	for i := 0; i < len(aligns); i++ {
		sym.CommonAlign = aligns[i]
		if cast(int, machoCommonDesc(sym)) != want[i] {
			return fail("wrong n_desc for a common's alignment")
		}
	}
	sym.Common = false
	if machoCommonDesc(sym) != 0 { return fail("n_desc bits for a symbol that is no common") }
	return ""
}

// An internal or a protected symbol has no Mach-O form: the writer fails, naming it.
func TestWriteMachoRejectsInternalProtected() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	for i := 0; i < 2; i++ {
		var a @asm.Assembler = visMachoProgram()
		a.SetVisibility("_g", asm.VIS_INTERNAL)
		if i == 1 { a.SetVisibility("_g", asm.VIS_PROTECTED) }
		a.Finalize()
		if a.HasError { return fail(a.ErrorMsg) }
		if WriteARM64(a, buf.Concat(dir, "/bad.o")) { return fail("an internal or protected _g written") }
		if !a.HasError { return fail("no error for an internal or protected _g") }
	}
	return ""
}

// A common aligned to 2^16 bytes has no n_desc encoding: the writer fails (clang: "invalid
// 'common' alignment").
func TestWriteMachoCommonAlignTooLarge() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.EmitUint32(0xD65F03C0)
	a.DefineCommon("_big", 4, 0x10000)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if WriteARM64(a, buf.Concat(dir, "/big.o")) { return fail("a common aligned to 2^16 written") }
	if !a.HasError { return fail("no error for a common aligned to 2^16") }
	return ""
}
