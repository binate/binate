package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"

// The symbol and string tables as clang (LLVM's MachObjectWriter) lays them out.  The
// locals come in the order clang creates them — a section's start anchor when its section
// is created, any other symbol where its name is first mentioned (asm.Symbol.Mention) — then
// the defined externals and the undefined symbols, each sorted by name.  The string table
// holds only the listed names, laid out by LLVM's StringTableBuilder for 64-bit Mach-O: a
// leading NUL, then the names in descending order of their bytes read from the end, a name
// that ends the one stored before it kept inside that one (tail merging), padded with NULs
// to a multiple of 8.

// machoSymbolName returns the name sym is listed under: with the platform's leading `_` for
// a CPrefix symbol (`.global_c`), the compiler's spelling of a Binate function here.
func machoSymbolName(sym asm.Symbol) @[]char {
	if sym.CPrefix { return buf.Concat("_", sym.Name) }
	return buf.CopyStr(sym.Name)
}

// localKey returns where symbol i of a comes among the local symbols, in creation order: a
// section's start anchor (anchors[s] == i, s its section) when its section was created —
// after every name mentioned before that, before the next, and after the anchors of the
// sections created earlier — any other symbol where its name was first mentioned
// (asm.Symbol.Mention).
func localKey(a @asm.Assembler, anchors @[]int, i int) int64 {
	var stride int64 = cast(int64, a.NumSections + 1)
	var s int = a.Symbols[i].Section
	if s >= 0 && s < len(anchors) && anchors[s] == i {
		return 2 * cast(int64, a.Sections[s].MentionsBefore) * stride + cast(int64, s)
	}
	return (2 * cast(int64, a.Symbols[i].Mention) - 1) * stride
}

// bytesLess reports whether x sorts before y: the first byte that differs is smaller in x,
// or x is a proper prefix of y.
func bytesLess(x *[]readonly char, y *[]readonly char) bool {
	for k := 0; k < len(x) && k < len(y); k++ {
		if x[k] != y[k] { return x[k] < y[k] }
	}
	return len(x) < len(y)
}

// reversedBefore reports whether x is stored before y in the string table: reading both from
// their last byte backwards, the first byte that differs is greater in x, or y runs out first
// (so a name comes before every name it ends).
func reversedBefore(x *[]readonly char, y *[]readonly char) bool {
	for k := 0; k < len(x) || k < len(y); k++ {
		var cx int = -1
		var cy int = -1
		if k < len(x) { cx = cast(int, x[len(x) - 1 - k]) }
		if k < len(y) { cy = cast(int, y[len(y) - 1 - k]) }
		if cx != cy { return cx > cy }
	}
	return false
}

// endsWith reports whether x ends with y.
func endsWith(x *[]readonly char, y *[]readonly char) bool {
	if len(y) > len(x) { return false }
	for k := 1; k <= len(y); k++ {
		if x[len(x) - k] != y[len(y) - k] { return false }
	}
	return true
}

// Orders sortIndices sorts by (the cmp argument).
const (
	BY_KEY int = iota // keys[i] ascending
	BY_NAME           // names[i] by bytesLess
	BY_REVERSED       // names[i] by reversedBefore
)

// indexBefore reports whether index i sorts before index j under cmp (BY_*).
func indexBefore(cmp int, keys @[]int64, names @[]@[]char, i int, j int) bool {
	if cmp == BY_KEY { return keys[i] < keys[j] }
	if cmp == BY_NAME { return bytesLess(names[i], names[j]) }
	return reversedBefore(names[i], names[j])
}

// sortIndices sorts the indices v stably by cmp (BY_*) over keys or names, which they index
// (bottom-up merge sort: O(n log n) for the native backends' large symbol tables).
func sortIndices(v @[]int, cmp int, keys @[]int64, names @[]@[]char) {
	var n int = len(v)
	var tmp @[]int = make_slice(int, n)
	for width := 1; width < n; width = width * 2 {
		for lo := 0; lo < n; lo = lo + 2 * width {
			var mid int = lo + width
			if mid > n { mid = n }
			var hi int = lo + 2 * width
			if hi > n { hi = n }
			var i int = lo
			var j int = mid
			for k := lo; k < hi; k++ {
				if i < mid && (j >= hi || !indexBefore(cmp, keys, names, v[j], v[i])) {
					tmp[k] = v[i]
					i = i + 1
				} else {
					tmp[k] = v[j]
					j = j + 1
				}
			}
		}
		for k := 0; k < n; k++ { v[k] = tmp[k] }
	}
}

// machoStringTable lays out the string table of names (the listed symbols' names, distinct)
// as clang's, returning the table and the offset of each name in it.
func machoStringTable(names @[]@[]char) (@[]uint8, @[]int) {
	var n int = len(names)
	var order @[]int = make_slice(int, n)
	for i := 0; i < n; i++ { order[i] = i }
	sortIndices(order, BY_REVERSED, make_slice(int64, 0), names)
	var offs @[]int = make_slice(int, n)
	var size int = 1
	var prev int = -1
	for k := 0; k < n; k++ {
		var i int = order[k]
		if prev >= 0 && endsWith(names[prev], names[i]) {
			offs[i] = size - len(names[i]) - 1
			continue
		}
		offs[i] = size
		size = size + len(names[i]) + 1
		prev = i
	}
	var tab @[]uint8 = make_slice(uint8, (size + 7) / 8 * 8)
	for i := 0; i < n; i++ {
		for c := 0; c < len(names[i]); c++ { tab[offs[i] + c] = names[i][c] }
	}
	return tab, offs
}
