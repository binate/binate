package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/builtins/testing"

// The symbol orders of macho_symtab.bn, against the tables of clang's objects (`clang -c
// -target arm64-apple-macos`).

// A section's anchor comes among the locals where its section was created, before the
// symbol first mentioned then; any other symbol where it was first mentioned.
func TestMachoLocalKey() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_t1")
	a.SetSection("data", -1)
	a.DefineLabel("_d1")
	var anchors @[]int = noAnchors(a)
	if !anchorEverySection(a, anchors) { return fail(a.ErrorMsg) }
	var t1 int = a.LookupSymbol("_t1")
	var d1 int = a.LookupSymbol("_d1")
	var k0 int64 = localKey(a, anchors, anchors[0])
	var k1 int64 = localKey(a, anchors, anchors[1])
	if !(k0 < localKey(a, anchors, t1) && localKey(a, anchors, t1) < k1 &&
			k1 < localKey(a, anchors, d1)) {
		return fail("ltmp0 _t1 ltmp1 _d1 is not the order")
	}
	return ""
}

// Sections created with no name mentioned between them keep their anchors in section order,
// whichever anchor is defined first (a leading alt entry's section gets its anchor before
// anchorEverySection runs).
func TestMachoAnchorTies() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetSection("data", -1)
	a.SetSection("rodata", -1)
	var anchors @[]int = noAnchors(a)
	if sectionAnchor(a, 2, anchors) < 0 || !anchorEverySection(a, anchors) { return fail(a.ErrorMsg) }
	var k0 int64 = localKey(a, anchors, anchors[0])
	var k1 int64 = localKey(a, anchors, anchors[1])
	var k2 int64 = localKey(a, anchors, anchors[2])
	if !(k0 < k1 && k1 < k2) { return fail("ltmp0 ltmp1 ltmp2 is not the order") }
	return ""
}
