package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The string-table layout and the symbol orders of macho_symtab.bn, against the tables of
// clang's objects (`clang -c -target arm64-apple-macos`).

// strtabIs reports whether tab is the bytes of want, `|` standing for each NUL.
func strtabIs(tab @[]uint8, want *[]readonly char) bool {
	if len(tab) != len(want) { return false }
	for i := 0; i < len(want); i++ {
		var c uint8 = want[i]
		if c == '|' { c = 0 }
		if tab[i] != c { return false }
	}
	return true
}

// names returns the names a..e as a managed-slice (empty strings dropped from the end).
func names(a *[]readonly char, b *[]readonly char, c *[]readonly char, d *[]readonly char,
		e *[]readonly char) @[]@[]char {
	var all @[]*[]readonly char = @[]*[]readonly char{a, b, c, d, e}
	var n int = 0
	for n < 5 && len(all[n]) > 0 { n = n + 1 }
	var out @[]@[]char = make_slice(@[]char, n)
	for i := 0; i < n; i++ { out[i] = buf.CopyStr(all[i]) }
	return out
}

// The names in descending order of their bytes read from the end, after a leading NUL,
// padded to a multiple of 8 — `_d _b _a ltmp1 ltmp0` as clang stores them, whatever order
// they come in; a name that ends the one stored before it is kept inside it (`_x` at 2, in
// `a_x`); with no names, the NUL padded.
func TestMachoStringTable() testing.TestResult {
	tab, offs := machoStringTable(names("ltmp0", "_a", "ltmp1", "_d", "_b"))
	if !strtabIs(tab, "|_d|_b|_a|ltmp1|ltmp0|||") { return fail("the order or padding") }
	if offs[0] != 16 || offs[1] != 7 || offs[2] != 10 || offs[3] != 1 || offs[4] != 4 {
		return fail("the offsets")
	}
	tab, offs = machoStringTable(names("_x", "_main", "a_x", "ltmp0", ""))
	if !strtabIs(tab, "|a_x|_main|ltmp0||||||||") { return fail("the tail merge") }
	if offs[0] != 2 || offs[2] != 1 { return fail("_x is not inside a_x") }
	tab, offs = machoStringTable(make_slice(@[]char, 0))
	if !strtabIs(tab, "||||||||") || len(offs) != 0 { return fail("no names") }
	return ""
}

// bytesLess orders by the first differing byte, a prefix first; reversedBefore reads from
// the end, the greater byte first, a name before every name it ends.
func TestMachoNameOrders() testing.TestResult {
	if !bytesLess("_a", "_m") || bytesLess("_m", "_a") || !bytesLess("_a", "_ab") ||
			bytesLess("_ab", "_a") || bytesLess("_a", "_a") {
		return fail("bytesLess")
	}
	if !reversedBefore("_zz", "_uz") || !reversedBefore("a_x", "_x") || reversedBefore("_x", "a_x") ||
			reversedBefore("_x", "_x") || !reversedBefore("_d", "_b") {
		return fail("reversedBefore")
	}
	if !endsWith("a_x", "_x") || endsWith("_x", "a_x") || !endsWith("_x", "_x") {
		return fail("endsWith")
	}
	return ""
}

// sortIndices is stable: indices with equal keys keep their order.
func TestMachoSortIndicesStable() testing.TestResult {
	var keys @[]int64 = @[]int64{5, 1, 5, 0, 1}
	var v @[]int = @[]int{0, 1, 2, 3, 4}
	sortIndices(v, BY_KEY, keys, make_slice(@[]char, 0))
	if v[0] != 3 || v[1] != 1 || v[2] != 4 || v[3] != 0 || v[4] != 2 { return fail("BY_KEY") }
	var ns @[]@[]char = names("_m", "_a", "_zz", "_a1", "")
	var w @[]int = @[]int{0, 1, 2, 3}
	sortIndices(w, BY_NAME, make_slice(int64, 0), ns)
	if w[0] != 1 || w[1] != 3 || w[2] != 0 || w[3] != 2 { return fail("BY_NAME") }
	return ""
}

// A section's anchor comes among the locals where its section was created, before the
// symbol first mentioned then; any other symbol where it was first mentioned.
func TestMachoLocalKey() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.DefineLabel("_t1")
	a.SetSection("data", -1)
	a.DefineLabel("_d1")
	var anchors @[]int = noAnchors(a)
	if !anchorEverySection(a, anchors) { return fail(a.ErrorMsg) }
	var t1 int = a.LookupSymbol("_t1")
	var d1 int = a.LookupSymbol("_d1")
	var k0 int64 = localKey(a, anchors, anchors[0])
	var k1 int64 = localKey(a, anchors, anchors[1])
	if !(k0 < localKey(a, anchors, t1) && localKey(a, anchors, t1) < k1 &&
			k1 < localKey(a, anchors, d1)) {
		return fail("ltmp0 _t1 ltmp1 _d1 is not the order")
	}
	return ""
}

// Sections created with no name mentioned between them keep their anchors in section order,
// whichever anchor is defined first (a leading alt entry's section gets its anchor before
// anchorEverySection runs).
func TestMachoAnchorTies() testing.TestResult {
	var a @asm.Assembler = asm.New(8)
	a.SetSection("text", -1)
	a.SetSection("data", -1)
	a.SetSection("rodata", -1)
	var anchors @[]int = noAnchors(a)
	if sectionAnchor(a, 2, anchors) < 0 || !anchorEverySection(a, anchors) { return fail(a.ErrorMsg) }
	var k0 int64 = localKey(a, anchors, anchors[0])
	var k1 int64 = localKey(a, anchors, anchors[1])
	var k2 int64 = localKey(a, anchors, anchors[2])
	if !(k0 < k1 && k1 < k2) { return fail("ltmp0 ltmp1 ltmp2 is not the order") }
	return ""
}
