package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Symbol visibilities (asm.Symbol.Visibility) in a Mach-O object: a hidden external is a
// private external (N_PEXT with N_EXT), as clang writes one for `.private_extern`; a hidden
// local needs no mark; internal and protected have no Mach-O form, so the writer rejects
// them.  (absNlist is in macho_abs_test.bn, madRead in macho_addend_test.bn, testTmpDir in
// macho_test.bn.)

// visMachoProgram returns an assembler with labels _a (global hidden), _b (local hidden),
// _w (weak hidden), _g (global) and cf (`.global_c`, hidden), an undefined global hidden
// _u, and an absolute global hidden _N = 5.
func visMachoProgram() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_a")
	a.EmitUint32(0xD65F03C0) // ret
	a.DefineLabel("_b")
	a.EmitUint32(0xD65F03C0)
	a.DefineLabel("_w")
	a.EmitUint32(0xD65F03C0)
	a.DefineLabel("_g")
	a.EmitUint32(0xD65F03C0)
	a.DefineLabel("cf")
	a.EmitUint32(0xD65F03C0)
	a.SetGlobal("_a")
	a.SetVisibility("_a", asm.VIS_HIDDEN)
	a.SetVisibility("_b", asm.VIS_HIDDEN)
	a.SetWeak("_w")
	a.SetVisibility("_w", asm.VIS_HIDDEN)
	a.SetGlobal("_g")
	a.SetGlobal("_u")
	a.SetVisibility("_u", asm.VIS_HIDDEN)
	a.SetGlobalC("cf")
	a.SetVisibility("cf", asm.VIS_HIDDEN)
	a.SetGlobal("_N")
	a.DefineAbsolute("_N", 5)
	a.SetVisibility("_N", asm.VIS_HIDDEN)
	return a
}

// Each symbol's n_type and n_desc are clang's: _a and _cf (named with the C prefix) N_SECT |
// N_EXT | N_PEXT, _b N_SECT, _w N_SECT | N_EXT | N_PEXT with N_WEAK_DEF, _g N_SECT | N_EXT,
// _u N_EXT | N_PEXT, _N N_ABS | N_EXT | N_PEXT.
func TestWriteMachoPrivateExtern() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = visMachoProgram()
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/vis.o")
	if !WriteARM64(a, path) { return fail(buf.Concat("failed to write Mach-O: ", a.ErrorMsg)) }
	b, n := madRead(path)
	if n < 200 { return fail("cannot read back the Mach-O object") }
	var pext int = cast(int, N_SECT | N_EXT | N_PEXT)
	at, ad, _, aok := absNlist(b, n, "_a")
	if !aok || at != pext || ad != 0 { return fail("_a not a private external") }
	bt, _, _, bok := absNlist(b, n, "_b")
	if !bok || bt != cast(int, N_SECT) { return fail("_b not a plain local") }
	wt, wd, _, wok := absNlist(b, n, "_w")
	if !wok || wt != pext || wd != cast(int, N_WEAK_DEF) {
		return fail("_w not a weak private external")
	}
	gt, _, _, gok := absNlist(b, n, "_g")
	if !gok || gt != cast(int, N_SECT | N_EXT) { return fail("_g not a plain external") }
	ut, _, _, uok := absNlist(b, n, "_u")
	if !uok || ut != cast(int, N_EXT | N_PEXT) { return fail("_u not an undefined private external") }
	ct, _, _, cok := absNlist(b, n, "_cf")
	if !cok || ct != pext { return fail("_cf not a private external") }
	nt, _, nv, nok := absNlist(b, n, "_N")
	if !nok || nt != cast(int, N_ABS | N_EXT | N_PEXT) || nv != 5 {
		return fail("_N not an absolute private external 5")
	}
	return ""
}

// An internal or a protected symbol has no Mach-O form: the writer fails, naming it.
func TestWriteMachoRejectsInternalProtected() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	for i := 0; i < 2; i++ {
		var a @asm.Assembler = visMachoProgram()
		a.SetVisibility("_g", asm.VIS_INTERNAL)
		if i == 1 { a.SetVisibility("_g", asm.VIS_PROTECTED) }
		a.Finalize()
		if a.HasError { return fail(a.ErrorMsg) }
		if WriteARM64(a, buf.Concat(dir, "/bad.o")) { return fail("an internal or protected _g written") }
		if !a.HasError { return fail("no error for an internal or protected _g") }
	}
	return ""
}
