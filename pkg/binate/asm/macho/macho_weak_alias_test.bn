package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Weak aliases in a Mach-O object: an alt entry (asm.Symbol.AltEntry), even at a plain
// symbol's address, so the atom holding the aliased code keeps its own symbol; ld64 links a
// call through one to the alias's code alone, and to a strong definition elsewhere when
// there is one.  A weak alias at a section's start where no symbol starts an atom is an
// error.  (absNlist is in macho_abs_test.bn, madRead / madHas in macho_addend_test.bn,
// testTmpDir / canLinkAndRun in macho_test.bn, execExit in run_helper_test.bn.)

// weakAliasProgram returns `_dh: mov w0, #2; ret` (after a nop when lead), a weak alias _W
// at _dh, and `_main`, which returns what _W returns.
func weakAliasProgram(lead bool) @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	var dh int = 0
	if lead {
		a.EmitUint32(0xD503201F) // nop
		dh = 4
	}
	a.DefineLabel("_dh")
	a.EmitUint32(0x52800040) // mov w0, #2
	a.EmitUint32(0xD65F03C0) // ret
	a.SetWeak("_W")
	a.DefineAlias("_W", 0, cast(uint, dh), true)
	a.DefineLabel("_main")
	a.SetGlobal("_main")
	a.EmitUint32(0xA9BF7BFD) // stp x29, x30, [sp, #-16]!
	aarch64.Bl(a, "_W")
	a.EmitUint32(0xA8C17BFD) // ldp x29, x30, [sp], #16
	a.EmitUint32(0xD65F03C0) // ret
	return a
}

// strongWProgram returns a strong `_W: mov w0, #9; ret`.
func strongWProgram() @asm.Assembler {
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_W")
	a.SetGlobal("_W")
	a.EmitUint32(0x52800120) // mov w0, #9
	a.EmitUint32(0xD65F03C0) // ret
	return a
}

// writeWeakAliasObj resolves, finalizes and writes a at dir/name, returning the path or ""
// on failure.
func writeWeakAliasObj(a @asm.Assembler, dir *[]readonly char, name *[]readonly char) @[]char {
	aarch64.ResolveFixups(a)
	a.Finalize()
	if a.HasError { return "" }
	var path @[]char = buf.Concat(buf.Concat(dir, "/"), name)
	if !WriteARM64(a, path) { return "" }
	return path
}

// linkRunObjs links the objects at paths with cc into dir/exe, entering at _main, and
// returns its exit code (-1 if it does not link or run).
func linkRunObjs(dir *[]readonly char, paths @[]@[]char) int {
	var exe @[]char = buf.Concat(dir, "/weak_alias_exe")
	var args @[]@[]char = make_slice(@[]char, 5 + len(paths))
	args[0] = "-arch"
	args[1] = "arm64"
	args[2] = "-o"
	args[3] = buf.CopyStr(exe)
	args[4] = "-Wl,-e,_main"
	for i := 0; i < len(paths); i++ { args[5 + i] = paths[i] }
	if execExit("cc", args) != 0 { return -1 }
	return execExit(exe, make_slice(@[]char, 0))
}

// A weak alias of _dh — at the section's start too, beside _dh — is a weak alt entry; ld64
// links the call through it to _dh alone (2) and to a strong _W with it (9).
func TestWriteMachoWeakAlias() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	for lead := 0; lead < 2; lead++ {
		var path @[]char = writeWeakAliasObj(weakAliasProgram(lead == 1), dir, "weak_alias.o")
		if len(path) == 0 { return fail("cannot write the weak alias") }
		b, n := madRead(path)
		wt, wd, _, wok := absNlist(b, n, "_W")
		if !wok || wt != cast(int, N_SECT | N_EXT) || wd != cast(int, N_WEAK_DEF | N_ALT_ENTRY) {
			return fail("_W not a weak external alt entry")
		}
		if !canLinkAndRun() { continue }
		var strong @[]char = writeWeakAliasObj(strongWProgram(), dir, "strong_w.o")
		var one @[]@[]char = make_slice(@[]char, 1)
		one[0] = path
		if linkRunObjs(dir, one) != 2 { return fail("alone, the call does not reach _dh") }
		var two @[]@[]char = make_slice(@[]char, 2)
		two[0] = path
		two[1] = strong
		if linkRunObjs(dir, two) != 9 { return fail("the strong _W does not override the alias") }
	}
	return ""
}

// A weak alias at a section's start, where no symbol starts an atom (only a temporary
// label), is an error: a plain weak symbol would take the code up to the next atom with
// it, and ld64 takes a weak alt entry there for the section's first atom.
func TestWriteMachoWeakAliasAtSectionStart() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("Ltmp")
	a.EmitUint32(0xD503201F)
	a.SetWeak("_A")
	a.DefineAlias("_A", 0, cast(uint, 0), true)
	a.Finalize()
	if WriteARM64(a, buf.Concat(dir, "/weak_lead.o")) {
		return fail("a weak alias starting the section written")
	}
	if !madHas(a.ErrorMsg, "weak alias at the start of its section") {
		return fail(buf.Concat("wrong diagnostic: ", a.ErrorMsg))
	}
	return ""
}
