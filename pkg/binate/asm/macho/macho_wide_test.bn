package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// A zero-fill section past a 32-bit host's int and uint in a Mach-O object: its section
// header's size, the segment's vmsize and the n_value of a symbol in it are the target's,
// whatever the host.  (madRead / madU32 / madSect0 are in macho_addend_test.bn, absNlist in
// macho_abs_test.bn.)

// madU64 reads a little-endian uint64 from b at off.
func madU64(b @[]uint8, off int) uint64 {
	return cast(uint64, madU32(b, off)) | (cast(uint64, madU32(b, off + 4)) << 32)
}

// Text holds one instruction (at 0, 4 bytes) and __bss 2^32 + 16 bytes, placed after it at
// 8 (sections are 8-aligned): __bss's header has addr 8 and size 2^32 + 16, the segment's
// vmsize is 2^32 + 24, and _hi, 2^32 bytes into __bss, has n_value 2^32 + 8.
func TestWriteMachoBssPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.EmitInstrUint32(0xD503201F)
	a.SetSection("bss", -1)
	a.DefineLabel("_lo")
	a.Zero(0x100000000)
	a.DefineLabel("_hi")
	a.Zero(16)
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	var path @[]char = buf.Concat(dir, "/macho_bss_wide.o")
	if !WriteARM64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	var bss int = madSect0() + 80
	if madU64(b, bss + 32) != 8 { return fail("__bss's addr is not 8") }
	if madU64(b, bss + 40) != 0x100000010 { return fail("__bss's size is not 2^32 + 16") }
	if madU64(b, 32 + 32) != 0x100000018 { return fail("the segment's vmsize is not 2^32 + 24") }
	_, _, hv, hok := absNlist(b, n, "_hi")
	if !hok || hv != 0x100000008 { return fail("_hi's n_value is not 2^32 + 8") }
	return ""
}

// A data region whose data-in-code offset would pass 32 bits — in __bss after 4 GiB of it — is
// an error, not a truncated entry; a region in __bss ending exactly at 4 GiB is listed (__bss
// starts at 8, after text's 4 bytes), and one a byte later is the error.  (diceErrorHas is in
// macho_dice_test.bn.)
func TestWriteMachoDataRegionPast4GiB() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var path @[]char = buf.Concat(dir, "/macho_dice_wide.o")
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.EmitInstrUint32(0xD503201F)
	a.SetSection("bss", -1)
	a.Zero(0x100000000)
	a.BeginDataRegion(asm.REGION_DATA)
	a.Zero(8)
	a.EndDataRegion()
	a.Finalize()
	if a.HasError { return fail(a.ErrorMsg) }
	if WriteARM64(a, path) { return fail("a data region past 4 GiB was written") }
	if !diceErrorHas(a, "data region past") { return fail(buf.Concat("wrong error: ", a.ErrorMsg)) }
	for extra := 0; extra < 2; extra++ {
		var b @asm.Assembler = asm.New(8)
		b.ObjFormat = asm.OBJ_MACHO
		b.SetSection("text", -1)
		b.EmitInstrUint32(0xD503201F)
		b.SetSection("bss", -1)
		b.Zero(0x100000000 - 16 + cast(int64, extra))
		b.BeginDataRegion(asm.REGION_DATA)
		b.Zero(8)
		b.EndDataRegion()
		b.Finalize()
		if b.HasError { return fail(b.ErrorMsg) }
		var ok bool = WriteARM64(b, path)
		if extra == 0 && !ok { return fail(buf.Concat("a data region ending at 4 GiB: ", b.ErrorMsg)) }
		if extra == 1 && (ok || !diceErrorHas(b, "data region past")) {
			return fail("a data region ending a byte past 4 GiB was written")
		}
	}
	return ""
}
