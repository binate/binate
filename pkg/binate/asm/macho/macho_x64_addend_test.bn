package "pkg/binate/asm/macho"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Mach-O x86-64 relocations carry an addend inline, in the rel32 field: a CALL to
// `_ext+8` is X86_64_RELOC_BRANCH against _ext with 8 in the field, and RIP-relative
// references to `_ext-4` / `_ext+4` are X86_64_RELOC_SIGNED_4 / SIGNED with -4 / 4 — the
// types and fields clang writes.  (madExtAsm / madRead / madRelocAt / madNReloc / madU32 /
// madSect0 are in macho_addend_test.bn.)

// madX64EntryAt returns the packed relocation word of the entry at r_address addr, or 0.
func madX64EntryAt(b @[]uint8, addr uint32) uint32 {
	for i := 0; i < madNReloc(b); i++ {
		ra, ri := madRelocAt(b, i)
		if ra == addr { return ri }
	}
	return 0
}

// A branch and a RIP-relative load and store to _ext with addends: one relocation each,
// BRANCH / SIGNED_4 / SIGNED (pcrel, length 2, extern, symbol 0), the addend in the rel32
// field.
func TestMachoX64InlineAddends() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = madExtAsm()
	x64.CallAddend(a, "_ext", 8) // e8 rel32: the field at 1
	x64.Lea(a, x64.Reg(x64.RAX, x64.SZ64), x64.RipLabelAddend("_ext", -4)) // 48 8d 05: field at 8
	x64.Mov(a, x64.RipLabelAddend("_ext", 4), x64.Reg(x64.RAX, x64.SZ64)) // 48 89 05: field at 15
	x64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_x64_addend.o")
	if !WriteX86_64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 3 { return fail("one relocation per reference, no addend entries") }
	// BRANCH = 2 << 28, SIGNED = 1 << 28, SIGNED_4 = 8 << 28; extern 1 << 27, length 2 << 25,
	// pcrel 1 << 24.
	if madX64EntryAt(b, 1) != 0x2D000000 { return fail("BRANCH against _ext at 1") }
	if madX64EntryAt(b, 8) != 0x8D000000 { return fail("SIGNED_4 against _ext at 8") }
	if madX64EntryAt(b, 15) != 0x1D000000 { return fail("SIGNED against _ext at 15") }
	var text int = cast(int, madU32(b, madSect0() + 48))
	if madU32(b, text + 1) != 8 { return fail("the call's field must hold 8") }
	if madU32(b, text + 8) != 0xFFFFFFFC { return fail("the lea's field must hold -4") }
	if madU32(b, text + 15) != 4 { return fail("the store's field must hold 4") }
	return ""
}

// An immediate after the rel32 reduces the field by its size, and the field picks the type as
// clang does: -1 / -2 / -4 are SIGNED_1 / SIGNED_2 / SIGNED_4 whatever the instruction, any other
// value SIGNED (`clang -c -target x86_64-apple-macos`, `llvm-objdump --macho -r`).
func TestMachoX64SignedTypes() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = madExtAsm()
	var d x64.Operand = x64.RipLabel("_ext")
	d.Size = x64.SZ32
	x64.Add(a, d, x64.Imm(5)) // 83 05 rel32 05: field at 2, -1
	var w x64.Operand = x64.RipLabel("_ext")
	w.Size = x64.SZ16
	x64.Add(a, w, x64.Imm(300)) // 66 81 05 rel32 2c 01: field at 10, -2
	x64.Imul3(a, x64.Reg(x64.RCX, x64.SZ32), x64.RipLabel("_ext"), 1000) // 69 0d: at 18, -4
	var b8 x64.Operand = x64.RipLabelAddend("_ext", 8)
	b8.Size = x64.SZ8
	x64.Cmp(a, b8, x64.Imm(1)) // 80 3d rel32 01: field at 28, 7
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.RipLabelAddend("_ext", -3)) // 8b 05: at 35, -3
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.RipLabelAddend("_ext", -1)) // 8b 05: at 41, -1
	x64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_x64_signed.o")
	if !WriteX86_64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 6 { return fail("one relocation per reference") }
	// SIGNED_1 = 6 << 28, SIGNED_2 = 7 << 28, SIGNED_4 = 8 << 28, SIGNED = 1 << 28; extern,
	// length 2, pcrel = 0x0D000000.
	if madX64EntryAt(b, 2) != 0x6D000000 { return fail("add dword: SIGNED_1") }
	if madX64EntryAt(b, 10) != 0x7D000000 { return fail("add word: SIGNED_2") }
	if madX64EntryAt(b, 18) != 0x8D000000 { return fail("imul: SIGNED_4") }
	if madX64EntryAt(b, 28) != 0x1D000000 { return fail("cmp [_ext + 8]: SIGNED") }
	if madX64EntryAt(b, 35) != 0x1D000000 { return fail("mov [_ext - 3]: SIGNED") }
	if madX64EntryAt(b, 41) != 0x6D000000 { return fail("mov [_ext - 1]: SIGNED_1") }
	var text int = cast(int, madU32(b, madSect0() + 48))
	if madU32(b, text + 2) != 0xFFFFFFFF { return fail("add dword's field must hold -1") }
	if madU32(b, text + 10) != 0xFFFFFFFE { return fail("add word's field must hold -2") }
	if madU32(b, text + 18) != 0xFFFFFFFC { return fail("imul's field must hold -4") }
	if madU32(b, text + 28) != 7 { return fail("cmp's field must hold 7") }
	if madU32(b, text + 35) != 0xFFFFFFFD { return fail("mov's field must hold -3") }
	return ""
}

// The type follows the addend as written against the label: a reference to a temporary moves to
// its atom's symbol with the temporary's offset added to the field, but `cmp byte ptr [rip +
// Ltmp], 1` stays a SIGNED_1, as clang writes it (the field 3: Ltmp is 4 bytes into _d's atom).
func TestMachoX64SignedTypeOfTemporary() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer { os.RemoveAll(dir) }
	var a @asm.Assembler = asm.New(8)
	a.ObjFormat = asm.OBJ_MACHO
	a.SetSection("text", -1)
	a.DefineLabel("_f")
	var b8 x64.Operand = x64.RipLabel("Ltmp")
	b8.Size = x64.SZ8
	x64.Cmp(a, b8, x64.Imm(1)) // 80 3d rel32 01: field at 2
	var d4 x64.Operand = x64.RipLabelAddend("Ltmp", 4)
	d4.Size = x64.SZ32
	x64.Mov(a, d4, x64.Imm(7)) // c7 05 rel32 imm32: field at 9
	x64.Mov(a, x64.Reg(x64.RAX, x64.SZ32), x64.RipLabel("Ltmp")) // 8b 05: field at 19
	a.SetSection("data", -1)
	a.DefineLabel("_d")
	a.EmitUint32(0)
	a.DefineLabel("Ltmp")
	a.EmitUint32(0)
	a.EmitUint32(0)
	x64.ResolveFixups(a)
	if !a.Finalize() { return fail("Finalize failed") }
	var path @[]char = buf.Concat(dir, "/macho_x64_signed_tmp.o")
	if !WriteX86_64(a, path) { return fail(a.ErrorMsg) }
	b, n := madRead(path)
	if n < 300 { return fail("cannot read back the Mach-O object") }
	if madNReloc(b) != 3 { return fail("one relocation per reference") }
	if madX64EntryAt(b, 2) >> 28 != 6 { return fail("cmp [Ltmp], 1: SIGNED_1") }
	if madX64EntryAt(b, 9) >> 28 != 1 { return fail("mov [Ltmp + 4], 7: SIGNED") }
	if madX64EntryAt(b, 19) >> 28 != 1 { return fail("mov eax, [Ltmp]: SIGNED") }
	var text int = cast(int, madU32(b, madSect0() + 48))
	if madU32(b, text + 2) != 3 { return fail("cmp's field must hold 3") }
	if madU32(b, text + 9) != 4 { return fail("the store's field must hold 4") }
	if madU32(b, text + 19) != 4 { return fail("the load's field must hold 4") }
	return ""
}
