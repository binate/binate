// Package parse provides the text assembly parser.
// It reads assembly source files and drives the assembler core and
// per-architecture encoding packages. The parser is line-oriented:
// directives, labels, constants, and instructions are each on one line.
package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// Token types for the assembly lexer.
const (
	TOK_EOF int = iota
	TOK_IDENT          // identifier (register name, mnemonic, label)
	TOK_INT            // integer literal (decimal, hex, binary, octal)
	TOK_STRING         // string literal ("...")
	TOK_CHAR           // character literal ('x')
	TOK_COMMA          // ,
	TOK_LBRACKET       // [
	TOK_RBRACKET       // ]
	TOK_HASH           // #
	TOK_BANG           // !
	TOK_DOT            // .
	TOK_COLON          // :
	TOK_EQUALS         // =
	TOK_PLUS           // +
	TOK_MINUS          // -
	TOK_STAR           // *
	TOK_SLASH          // /
	TOK_PERCENT        // %
	TOK_AMP            // &
	TOK_PIPE           // |
	TOK_CARET          // ^
	TOK_TILDE          // ~
	TOK_SHL            // <<
	TOK_SHR            // >>
	TOK_LPAREN         // (
	TOK_RPAREN         // )
	TOK_AT             // @ (relocation qualifier, e.g. sym@GOTPCREL)
	TOK_LBRACE         // {
	TOK_RBRACE         // }
	TOK_NEWLINE        // end of line
	TOK_ERROR          // lexer error
	TOK_FLOAT          // floating-point literal (Text holds it as written)
)

// Token represents a single lexical token from assembly source.
type Token struct {
	Kind int
	Text @[]char // raw text (for identifiers and strings)
	Ival int64 // parsed integer value (for TOK_INT, TOK_CHAR); int64 so a
	// uint32/64-bit immediate is representable on a 32-bit-int host
	Line int // source line number (1-based)
	Col  int // source column (1-based)
}

// Lexer holds the state for tokenizing a line of assembly text.
type Lexer struct {
	Src  *[]readonly char // source text
	Pos  int // current byte position
	Line int // line number (1-based)
	Col  int // column (1-based)
}

// NewLexer creates a lexer for the given source text and line number.
func NewLexer(src *[]readonly char, line int) Lexer

// LexNext returns the next token and the advanced lexer state.
func LexNext(l Lexer) (Lexer, Token)

// ExprResult holds the result of evaluating an expression: a number, or — where a symbol
// may stand — a symbol plus a number, or the current location (`.`) plus a number.
type ExprResult struct {
	Val int64 // int64 so a uint32/64-bit immediate survives on a 32-bit-int host
	Ok  bool
	Err @[]char // when !Ok: the diagnostic, or empty for a generic "invalid expression"
	Sym @[]char // the symbol Val is added to (resolved: a numeric label's instance), or empty
	Dot bool // Val is added to the current location (`.`); Sym is empty
	// A difference of two locations not fixed at assembly (in different sections, or
	// Mach-O atoms): the location subtracted — a symbol (Neg) or the current location
	// (NegDot) — from Sym / Dot.  A difference whose distance is fixed folds to a number.
	Neg    @[]char
	NegDot bool
	// Pending marks a value a label difference decides whose label a first pass has not
	// reached yet: Val is a placeholder 0, and the input is assembled again (see
	// Parser.Prev) with that label's location.
	Pending bool
	// FromDiff marks a number a difference of two locations decided (pending or folded):
	// a PC-relative target takes none (clang reads it as an absolute address there), and a
	// literal-pool load of one is always an entry, as clang's is.
	FromDiff bool
}

// ParseExpr parses and evaluates a constant expression from the token stream:
// literals, the names of constants p defined on earlier lines, differences of two
// locations whose distance is fixed (`l2 - l1`, `. - l1`: one section, or one Mach-O atom),
// parentheses, unary - + ~ and binary * / % << >> + - | & ^.  Operator mixes whose
// precedence clang's Mach-O and ELF assemblers disagree on are rejected (see expr.bn); >>
// is logical; a bad shift count or division, a location that is no such difference, or a
// name that is neither a constant nor a label, fails with Err set.  A difference whose
// label a first pass has not reached is Pending (see Parser.Prev).
func ParseExpr(p @Parser, l Lexer, cur Token) (Lexer, Token, ExprResult)

// Architecture constants for the .arch directive.
const ARCH_UNKNOWN int = 0

const ARCH_AARCH64 int = 1

const ARCH_ARM32 int = 2

const ARCH_X64 int = 3

// Parser holds the state for parsing an assembly file.
type Parser struct {
	Asm      @asm.Assembler
	Arch     int // target architecture (ARCH_*)
	FileName @[]char
	LineNum  int
	HasError bool
	ErrorMsg @[]char
	// Constants (`name = expr`), in order of first definition: a definition replaces the
	// value, and a later label of the same name turns the name into that label.  An alias
	// (`A = sym + 8`) has its symbol in ConstSyms and its addend in ConstVals; a number has
	// an empty ConstSyms entry.
	ConstNames @[]@[]char
	ConstVals  @[]int64
	ConstSyms  @[]@[]char
	ConstLines @[]int // the line of each constant's latest definition (for diagnostics)
	// ConstUsed records each alias used by an instruction operand (not by another
	// constant's definition) since its latest definition.
	ConstUsed @[]bool
	NumConsts int
	// Literal-pool entries (`ldr Rt, =expr`), in the order added: each one's section,
	// label, size (4 / 8 bytes), value — a number, or a symbol (PoolSyms) plus a number —
	// the key later loads share it by ("" for none), its offset once emitted (-1 while
	// pending), and the atom it is in (PoolGens: its section's PoolSecGens count when it
	// was added, then when it was emitted).  PoolSecGens counts, per section, the labels
	// that start a Mach-O atom so far (none on ELF), which no sharing crosses.
	PoolSecs    @[]int
	PoolLabels  @[]@[]char
	PoolSizes   @[]int
	PoolVals    @[]int64
	PoolSyms    @[]@[]char
	PoolKeys    @[]@[]char
	PoolOffs    @[]int
	PoolGens    @[]int
	NumPool     int
	PoolSecGens @[]int
	// InConstDef is set while a constant's value is parsed, where a global or weak alias
	// stands for its target (`C = A` copies A's target) rather than for its own symbol.
	InConstDef   bool
	NumDotLabels int // the labels made for `name = .` definitions so far
	// Numeric local labels (`N:`, referred to as `Nb` / `Nf`): each label number defined
	// so far (its decimal text) and how many instances of it; and the references not yet
	// satisfied — the number, the instance meant (0: a backward reference with none before)
	// and the line — which Finish checks.
	NumLabelNums    @[]@[]char
	NumLabelCounts  @[]int
	NumNumLabels    int
	FwdRefNums      @[]@[]char
	FwdRefInstances @[]int
	FwdRefLines     @[]int
	NumFwdRefs      int
	InComment       bool // inside a `/* ... */` comment opened on an earlier line
	// CommentSplit: the most recently opened comment interrupted a statement — statement
	// text (not only labels) came before its `/*`, on its line or before an earlier
	// comment it continues; SplitLine: this line closed such a comment that spans lines
	// and has statement text after it.
	CommentSplit bool
	SplitLine    bool
	// ConstPending marks each constant whose value a pending label difference decided
	// (ExprResult.Pending), and so is pending itself; ConstFromDiff each whose value a
	// difference of two locations decided (ExprResult.FromDiff).
	ConstPending  @[]bool
	ConstFromDiff @[]bool
	// LabelGens holds, for each symbol index of a label defined so far, 1 + the number of
	// atom-starting labels its section had when it was defined (Mach-O, or the object format
	// unknown; see notePoolAtom): two locations in one atom have the same count, which is
	// how clang places a label at the end of one atom, before the next one's label at the
	// same offset.  PrevLabelGens is the first pass's, which a second pass reads for a label
	// after its use.
	LabelGens     @[]int
	PrevLabelGens @[]int
	// DiffFwdNames holds the names a label difference used before any definition (pending
	// on a first pass): a constant may not take one later — a constant is defined before it
	// is used.
	DiffFwdNames @[]@[]char
	NumDiffFwd   int
	// AliasMarks holds the aliases this line's expressions have marked used (ConstUsed): a
	// difference that folds to a number unmarks those its operands marked, since its value
	// does not depend on any binding.
	AliasMarks    @[]int
	NumAliasMarks int
	// TargetOs is the target operating system the input is assembled for (OsKnown), from
	// which a `.arch` directive sets the object format when it is not yet set (UseMachoFor).
	TargetOs @[]char
	OsKnown  bool
	// A label difference whose label is not yet defined is pending on a first pass: the
	// value is a placeholder, SawPending is set, and the input is assembled a second time
	// (ParseSource) with Prev the first pass's assembler, whose label locations a forward
	// difference then reads.  LinePending marks a pending value on the current line.
	Prev        @asm.Assembler
	SawPending  bool
	LinePending bool
	// IntelOperands is set while an x86-64 instruction's operands are parsed: clang's
	// Intel-syntax operand parser misreads `~` right after a unary operator in most places
	// (`[rbx + -~8]` is rbx - 9 to it; `-~8` and `~ ~1` crash it), so the evaluator rejects
	// every such `~` there, the few clang reads correctly (`2 * -~8`) included
	// (intelTildeError).
	IntelOperands bool
}

// NewParser creates a parser for the given assembler and source filename.
func NewParser(a @asm.Assembler, filename *[]readonly char) @Parser

// SetArch sets the architecture the input is assembled for (ARCH_*), as a `.arch`
// directive does, and the assembler's word size to match (4 bytes for arm32, else 8).
func (p @Parser) SetArch(arch int)

// ParseLine parses a single line of assembly text (successive calls are successive
// lines: a `/* ... */` comment may span them).
func (p @Parser) ParseLine(line *[]readonly char)

// ParseFile reads an entire assembly file from disk and parses it (ParseSource).
func (p @Parser) ParseFile(path *[]readonly char)

// ParseSource parses text, the whole input, line by line and ends it (Finish).  When a
// label difference was pending (a label defined after its use), the input is assembled
// again from the start with the first pass's label locations — AArch64 and arm32
// instruction and data sizes do not depend on the values (an x86-64 instruction's do, so a
// pending difference there is an error), so the second pass lays the labels out where the
// first did, which it checks — and the second pass's output is the result.  The second
// pass starts from a fresh parser and assembler (Assembler.Reset), keeping the word size,
// object format, a target set before (SetArch) and the target operating system (TargetOs),
// so the input must make everything else it relies on (its sections) itself.
func (p @Parser) ParseSource(text *[]readonly char)

// UseMachoFor reports whether the output for arch on osName is a Mach-O object (else ELF):
// darwin / macos, or no OS named for AArch64; linux, or no OS named for anything else.  An
// unknown OS is an error (the message).
func UseMachoFor(arch int, osName *[]readonly char) (bool, @[]char)

// Finish ends the input after its last line: a `/*` comment still open, or a numeric local
// label reference to an instance never defined — forward (`1f`) with none after it, or
// backward (`1b`) with none before it — is an error, at the reference's line.  Then it
// enters the constants into the symbol table: a number as a local absolute symbol, an alias
// of a symbol defined here as a local symbol at that location (an alias found before its
// section's start is an error, at its definition's line).
func (p @Parser) Finish()
