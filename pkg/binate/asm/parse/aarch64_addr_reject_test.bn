package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the rejected forms of the AArch64 load/store address parser
// (parseA64Addr in aarch64_addr.bn).  Each rejected form is also rejected by clang,
// except where a test says the rejection is this assembler's own rule.

// addrRejectCase checks that parseA64Addr rejects src with p's error set.
func addrRejectCase(e @[]char, src *[]readonly char) @[]char {
	_, ok, _, p := addrScanLine(src)
	if ok { return goldenFail(e, src, "accepted a malformed address") }
	if !p.HasError { return goldenFail(e, src, "rejected without an error message") }
	return e
}

// The address must start with '[' and be closed by ']' — after the base, after an
// immediate offset, after an index (with or without an extend), and after a page
// offset.
func TestA64AddrRejectUnclosed() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "x1]")
	e = addrRejectCase(e, "#8")
	e = addrRejectCase(e, "")
	e = addrRejectCase(e, "[x1")
	e = addrRejectCase(e, "[x1 x2]")
	e = addrRejectCase(e, "[x1, #8")
	e = addrRejectCase(e, "[x1, #8, x2]")
	e = addrRejectCase(e, "[x1, x2")
	e = addrRejectCase(e, "[x1, x2, lsl #3")
	e = addrRejectCase(e, "[x1, w2, uxtw")
	e = addrRejectCase(e, "[x1, :lo12:sym")
	e = addrRejectCase(e, "[x1, #:got_lo12:sym")
	e = addrRejectCase(e, "[x1, sym@PAGEOFF")
	return e
}

// The base must be an X register or SP: not a W register, WSP, XZR (or its x31
// spelling), a SIMD&FP register, a symbol, an immediate, or nothing.
func TestA64AddrRejectBase() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[w1]")
	e = addrRejectCase(e, "[w1, #8]")
	e = addrRejectCase(e, "[wsp]")
	e = addrRejectCase(e, "[xzr]")
	e = addrRejectCase(e, "[x31]")
	e = addrRejectCase(e, "[wzr]")
	e = addrRejectCase(e, "[d0]")
	e = addrRejectCase(e, "[q1]")
	e = addrRejectCase(e, "[x32]")
	e = addrRejectCase(e, "[sym]")
	e = addrRejectCase(e, "[#8]")
	e = addrRejectCase(e, "[]")
	return e
}

// A post-index offset must follow the `],` as an immediate: a missing offset, a
// register, or a lone '#' is rejected.
func TestA64AddrRejectPostIndex() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[x1],")
	e = addrRejectCase(e, "[x1], x2")
	e = addrRejectCase(e, "[x1], #")
	return e
}

// An immediate offset must be a valid expression, and something must follow the ','.
func TestA64AddrRejectBadOffset() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[x1, #]")
	e = addrRejectCase(e, "[x1, #(8]")
	e = addrRejectCase(e, "[x1, ]")
	e = addrRejectCase(e, "[x1, ,]")
	return e
}

// The index register must be an X or W data register (XZR / WZR allowed): SP, WSP and
// the SIMD&FP registers are not indexes.
func TestA64AddrRejectIndexClass() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[x1, sp]")
	e = addrRejectCase(e, "[x1, wsp, uxtw]")
	e = addrRejectCase(e, "[x1, s0]")
	e = addrRejectCase(e, "[x1, d2]")
	e = addrRejectCase(e, "[x1, q3]")
	return e
}

// A W index requires uxtw or sxtw (not a bare W index, nor lsl / sxtx); an X index takes
// lsl or sxtx, not uxtw / sxtw.
func TestA64AddrRejectIndexExtend() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[x1, w2]")
	e = addrRejectCase(e, "[x1, wzr]")
	e = addrRejectCase(e, "[x1, w2, lsl #2]")
	e = addrRejectCase(e, "[x1, w2, sxtx]")
	e = addrRejectCase(e, "[x1, w2, sxtx #3]")
	e = addrRejectCase(e, "[x1, x2, uxtw]")
	e = addrRejectCase(e, "[x1, x2, uxtw #3]")
	e = addrRejectCase(e, "[x1, x2, sxtw #3]")
	e = addrRejectCase(e, "[x1, xzr, sxtw]")
	return e
}

// After the index only `, <extend> {#amount}` may appear: lsl needs its '#amount', the
// extend must be one of lsl / sxtx / uxtw / sxtw (not ror, uxtx, or an arbitrary
// word), the ',' must be followed by a keyword, and the ',' itself is required.
func TestA64AddrRejectIndexTail() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[x1, x2, lsl]")
	e = addrRejectCase(e, "[x1, x2, lsl #]")
	e = addrRejectCase(e, "[x1, x2, ror #3]")
	e = addrRejectCase(e, "[x1, x2, uxtx]")
	e = addrRejectCase(e, "[x1, x2, foo]")
	e = addrRejectCase(e, "[x1, x2, #3]")
	e = addrRejectCase(e, "[x1, x2,]")
	e = addrRejectCase(e, "[x1, x2 lsl #3]")
	e = addrRejectCase(e, "[x1, x2, lsl #3, x4]")
	e = addrRejectCase(e, "[x1, w2, uxtw #]")
	return e
}

// A symbolic offset must be a page offset (`:lo12:` / `:got_lo12:` / `@PAGEOFF` /
// `@GOTPAGEOFF`): a plain symbol, a page (`@PAGE`, `:got:`, `@GOTPAGE`), a `@PLT`
// target, a shift keyword, or a `:lo12:` operand that also carries an `@` specifier
// is rejected, as are malformed qualifiers and addends.  (An unparenthesized compound
// addend such as `sym+4*2`, which clang reads as sym+8, is this assembler's own
// rejection: a compound addend must be parenthesized.)
func TestA64AddrRejectSymbolOffset() testing.TestResult {
	var e @[]char = ""
	e = addrRejectCase(e, "[x1, sym]")
	e = addrRejectCase(e, "[x1, sym+8]")
	e = addrRejectCase(e, "[x1, sym@PAGE]")
	e = addrRejectCase(e, "[x1, sym@GOTPAGE]")
	e = addrRejectCase(e, "[x1, sym@PLT]")
	e = addrRejectCase(e, "[x1, #:got:sym]")
	e = addrRejectCase(e, "[x1, :got:sym]")
	e = addrRejectCase(e, "[x1, lsl]")
	e = addrRejectCase(e, "[x1, eq]")
	e = addrRejectCase(e, "[x1, :lo12:sym@PAGEOFF]")
	e = addrRejectCase(e, "[x1, #:foo:sym]")
	e = addrRejectCase(e, "[x1, #:lo12 sym]")
	e = addrRejectCase(e, "[x1, #:lo12:]")
	e = addrRejectCase(e, "[x1, :lo12:sym+4*2]")
	e = addrRejectCase(e, "[x1, sym@FOO]")
	return e
}
