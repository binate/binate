package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the AArch64 register-name classifier (parseA64Reg, regIndexSuffix,
// rcIsX / rcIsW) and the accepted forms of the load/store address parser
// (parseA64Addr) in aarch64_addr.bn.  The rejected address forms are in
// aarch64_addr_reject_test.bn.  Every acceptance / rejection matches clang
// (`clang -c -target arm64-apple-macos11`, or aarch64-linux-gnu for the ELF-only
// `:lo12:` / `:got_lo12:` syntax) unless a test says otherwise.

// regNameCase checks that parseA64Reg(name) is register num of class cls, appending
// a failure about name to e.
func regNameCase(e @[]char, name *[]readonly char, num int, cls int) @[]char {
	n, c := parseA64Reg(name)
	if c != cls { return goldenFail(e, name, "wrong register class") }
	if n != num { return goldenFail(e, name, "wrong register number") }
	return e
}

// regNameReject checks that parseA64Reg(name) reports no register: (-1, RC_NONE).
func regNameReject(e @[]char, name *[]readonly char) @[]char {
	n, c := parseA64Reg(name)
	if n != -1 || c != RC_NONE { return goldenFail(e, name, "accepted as a register") }
	return e
}

// The general-purpose registers: x0-x30 / w0-w30, the fp (x29) / lr (x30) aliases,
// xzr / wzr, sp / wsp; x31 / w31 are the zero registers (as clang reads them), never SP.
func TestA64RegGeneralPurpose() testing.TestResult {
	var e @[]char = ""
	e = regNameCase(e, "x0", 0, RC_X)
	e = regNameCase(e, "x9", 9, RC_X)
	e = regNameCase(e, "x10", 10, RC_X)
	e = regNameCase(e, "x29", 29, RC_X)
	e = regNameCase(e, "x30", 30, RC_X)
	e = regNameCase(e, "w0", 0, RC_W)
	e = regNameCase(e, "w15", 15, RC_W)
	e = regNameCase(e, "w30", 30, RC_W)
	e = regNameCase(e, "fp", 29, RC_X)
	e = regNameCase(e, "lr", 30, RC_X)
	e = regNameCase(e, "xzr", 31, RC_XZR)
	e = regNameCase(e, "wzr", 31, RC_WZR)
	e = regNameCase(e, "x31", 31, RC_XZR)
	e = regNameCase(e, "w31", 31, RC_WZR)
	e = regNameCase(e, "sp", 31, RC_SP)
	e = regNameCase(e, "wsp", 31, RC_WSP)
	return e
}

// The SIMD&FP scalar registers: b / h / s / d / q followed by 0-31.
func TestA64RegSimdFp() testing.TestResult {
	var e @[]char = ""
	e = regNameCase(e, "b0", 0, RC_B)
	e = regNameCase(e, "b31", 31, RC_B)
	e = regNameCase(e, "h0", 0, RC_H)
	e = regNameCase(e, "h31", 31, RC_H)
	e = regNameCase(e, "s0", 0, RC_S)
	e = regNameCase(e, "s15", 15, RC_S)
	e = regNameCase(e, "s31", 31, RC_S)
	e = regNameCase(e, "d0", 0, RC_D)
	e = regNameCase(e, "d7", 7, RC_D)
	e = regNameCase(e, "d31", 31, RC_D)
	e = regNameCase(e, "q0", 0, RC_Q)
	e = regNameCase(e, "q31", 31, RC_Q)
	return e
}

// Register names match case-insensitively, including the aliases and zero registers.
func TestA64RegMixedCase() testing.TestResult {
	var e @[]char = ""
	e = regNameCase(e, "X0", 0, RC_X)
	e = regNameCase(e, "W30", 30, RC_W)
	e = regNameCase(e, "XZR", 31, RC_XZR)
	e = regNameCase(e, "Wzr", 31, RC_WZR)
	e = regNameCase(e, "X31", 31, RC_XZR)
	e = regNameCase(e, "SP", 31, RC_SP)
	e = regNameCase(e, "Sp", 31, RC_SP)
	e = regNameCase(e, "WSP", 31, RC_WSP)
	e = regNameCase(e, "FP", 29, RC_X)
	e = regNameCase(e, "Lr", 30, RC_X)
	e = regNameCase(e, "B1", 1, RC_B)
	e = regNameCase(e, "H2", 2, RC_H)
	e = regNameCase(e, "S3", 3, RC_S)
	e = regNameCase(e, "D5", 5, RC_D)
	e = regNameCase(e, "Q31", 31, RC_Q)
	return e
}

// A register index with a leading zero (x01, x00) is not a register name, as in clang;
// "0" itself is the only index that may start with '0'.
func TestA64RegRejectLeadingZero() testing.TestResult {
	var e @[]char = ""
	e = regNameReject(e, "x01")
	e = regNameReject(e, "x00")
	e = regNameReject(e, "w05")
	e = regNameReject(e, "b01")
	e = regNameReject(e, "h00")
	e = regNameReject(e, "s09")
	e = regNameReject(e, "d00")
	e = regNameReject(e, "q01")
	e = regNameCase(e, "x0", 0, RC_X)
	return e
}

// v0-v31 name the SIMD&FP vector registers (RC_V): no text form takes one yet, but
// the name is a register, never a symbol (as clang reads it).
func TestA64RegVectorNames() testing.TestResult {
	var e @[]char = ""
	e = regNameCase(e, "v0", 0, RC_V)
	e = regNameCase(e, "V31", 31, RC_V)
	e = regNameReject(e, "v32")
	e = regNameReject(e, "v01")
	return e
}

// An index above 31 is not a register name in any class (x32, w32, q32, ...), nor is
// a four-character index form such as x100.
func TestA64RegRejectOutOfRange() testing.TestResult {
	var e @[]char = ""
	e = regNameReject(e, "x32")
	e = regNameReject(e, "w32")
	e = regNameReject(e, "x99")
	e = regNameReject(e, "x100")
	e = regNameReject(e, "b32")
	e = regNameReject(e, "h32")
	e = regNameReject(e, "s32")
	e = regNameReject(e, "d32")
	e = regNameReject(e, "q32")
	e = regNameReject(e, "q99")
	return e
}

// Names that are not registers at all: empty, a bare class letter, an unknown prefix
// (r0), a non-digit index, near-misses of the named registers, and a keyword.
func TestA64RegRejectNonRegisters() testing.TestResult {
	var e @[]char = ""
	e = regNameReject(e, "")
	e = regNameReject(e, "x")
	e = regNameReject(e, "w")
	e = regNameReject(e, "q")
	e = regNameReject(e, "r0")
	e = regNameReject(e, "xa")
	e = regNameReject(e, "x1a")
	e = regNameReject(e, "x-1")
	e = regNameReject(e, "spx")
	e = regNameReject(e, "xzrr")
	e = regNameReject(e, "zr")
	e = regNameReject(e, "pc")
	e = regNameReject(e, "lsl")
	return e
}

// regIndexSuffix reads the decimal index after the one-letter prefix (which it does
// not examine), bounded by max, rejecting a leading zero, a non-digit, or more than two
// digits.
func TestA64RegIndexSuffix() testing.TestResult {
	if regIndexSuffix("x0", 31) != 0 { return fail("x0") }
	if regIndexSuffix("x7", 7) != 7 { return fail("x7 with max 7") }
	if regIndexSuffix("x8", 7) != -1 { return fail("x8 above max 7 accepted") }
	if regIndexSuffix("x10", 31) != 10 { return fail("x10") }
	if regIndexSuffix("x31", 31) != 31 { return fail("x31 with max 31") }
	if regIndexSuffix("x31", 30) != -1 { return fail("x31 above max 30 accepted") }
	if regIndexSuffix("x01", 31) != -1 { return fail("leading zero accepted") }
	if regIndexSuffix("x", 31) != -1 { return fail("empty index accepted") }
	if regIndexSuffix("x123", 999) != -1 { return fail("three-digit index accepted") }
	if regIndexSuffix("xa", 31) != -1 { return fail("non-digit index accepted") }
	if regIndexSuffix("x1a", 31) != -1 { return fail("trailing non-digit accepted") }
	if regIndexSuffix("z9", 31) != 9 { return fail("prefix letter examined") }
	return ""
}

// rcIsX / rcIsW accept exactly the data-register classes of their width, including the
// zero register but never SP / WSP or a SIMD&FP class.
func TestA64RcIsXW() testing.TestResult {
	if !rcIsX(RC_X) || !rcIsX(RC_XZR) { return fail("rcIsX rejects x / xzr") }
	if rcIsX(RC_SP) || rcIsX(RC_W) || rcIsX(RC_WZR) || rcIsX(RC_WSP) {
		return fail("rcIsX accepts sp or a W class")
	}
	if rcIsX(RC_D) || rcIsX(RC_Q) || rcIsX(RC_NONE) { return fail("rcIsX accepts d / q / none") }
	if !rcIsW(RC_W) || !rcIsW(RC_WZR) { return fail("rcIsW rejects w / wzr") }
	if rcIsW(RC_WSP) || rcIsW(RC_X) || rcIsW(RC_XZR) || rcIsW(RC_SP) {
		return fail("rcIsW accepts wsp or an X class")
	}
	if rcIsW(RC_S) || rcIsW(RC_B) || rcIsW(RC_NONE) { return fail("rcIsW accepts s / b / none") }
	return ""
}

// addrScanLine parses src as one load/store address in a fresh parser, returning the
// address, whether it was accepted, the kind of the token just past it, and the parser.
func addrScanLine(src *[]readonly char) (a64Addr, bool, int, @Parser) {
	var p @Parser = newTestParser()
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	var ad a64Addr
	var ok bool = false
	l, tok, ad, ok = parseA64Addr(p, l, tok)
	return ad, ok, tok.Kind, p
}

// addrAcceptCheck is the common head of the accepting address checks: src must parse,
// leaving next as the token just past the address, with the given mode and base.
func addrAcceptCheck(e @[]char, src *[]readonly char, next int, mode int,
		base int) (@[]char, a64Addr, bool) {
	ad, ok, nextKind, p := addrScanLine(src)
	if !ok { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)), ad, false }
	if p.HasError { return goldenFail(e, src, "accepted with an error set"), ad, false }
	if nextKind != next { return goldenFail(e, src, "stopped at the wrong token"), ad, false }
	if ad.Mode != mode { return goldenFail(e, src, "wrong addressing mode"), ad, false }
	if ad.Base != base { return goldenFail(e, src, "wrong base register"), ad, false }
	return e, ad, true
}

// addrImmCase checks that src (the whole line) is an address of the given mode (BASE,
// IMM, PRE or POST), base and offset.
func addrImmCase(e @[]char, src *[]readonly char, mode int, base int, imm int) @[]char {
	e2, ad, ok := addrAcceptCheck(e, src, TOK_EOF, mode, base)
	if !ok { return e2 }
	if ad.Imm != imm { return goldenFail(e, src, "wrong offset") }
	return e
}

// addrIndexCase checks that src (the whole line) is a register-offset address with the
// given base, index register / class, extend, and optional amount.
func addrIndexCase(e @[]char, src *[]readonly char, base int, idx int, cls int, ext int,
		amtGiven bool, amt int) @[]char {
	e2, ad, ok := addrAcceptCheck(e, src, TOK_EOF, ADDR_REG, base)
	if !ok { return e2 }
	if ad.Index != idx || ad.IndexCls != cls { return goldenFail(e, src, "wrong index register") }
	if ad.Ext != ext { return goldenFail(e, src, "wrong extend") }
	if ad.AmtGiven != amtGiven { return goldenFail(e, src, "wrong amount-given flag") }
	if amtGiven && ad.Amt != amt { return goldenFail(e, src, "wrong amount") }
	return e
}

// addrPageCase checks that src (the whole line) is a page-offset address (LO12 or
// GOT_LO12) of the given base, symbol and addend.
func addrPageCase(e @[]char, src *[]readonly char, mode int, base int, label *[]readonly char,
		imm int) @[]char {
	e2, ad, ok := addrAcceptCheck(e, src, TOK_EOF, mode, base)
	if !ok { return e2 }
	if !charsEqual(ad.Label, label) { return goldenFail(e, src, "wrong symbol") }
	if ad.Imm != imm { return goldenFail(e, src, "wrong addend") }
	return e
}

// Base-only addresses: an X register, SP, and the fp / lr aliases, in any case.
func TestA64AddrBase() testing.TestResult {
	var e @[]char = ""
	e = addrImmCase(e, "[x1]", ADDR_BASE, 1, 0)
	e = addrImmCase(e, "[x30]", ADDR_BASE, 30, 0)
	e = addrImmCase(e, "[sp]", ADDR_BASE, 31, 0)
	e = addrImmCase(e, "[fp]", ADDR_BASE, 29, 0)
	e = addrImmCase(e, "[lr]", ADDR_BASE, 30, 0)
	e = addrImmCase(e, "[X3]", ADDR_BASE, 3, 0)
	e = addrImmCase(e, "[SP]", ADDR_BASE, 31, 0)
	e = addrImmCase(e, "[ x2 ]", ADDR_BASE, 2, 0)
	return e
}

// Immediate-offset, pre-index (`]!`) and post-index (`], #imm`) addresses, with
// negative, hex and parenthesized-expression offsets.
func TestA64AddrImmediate() testing.TestResult {
	var e @[]char = ""
	e = addrImmCase(e, "[x1, #16]", ADDR_IMM, 1, 16)
	e = addrImmCase(e, "[x1, #0]", ADDR_IMM, 1, 0)
	e = addrImmCase(e, "[x1, #-256]", ADDR_IMM, 1, -256)
	e = addrImmCase(e, "[x1, #0x10]", ADDR_IMM, 1, 16)
	e = addrImmCase(e, "[x1, #(4*4)]", ADDR_IMM, 1, 16)
	e = addrImmCase(e, "[sp, #8]", ADDR_IMM, 31, 8)
	e = addrImmCase(e, "[x1, #-8]!", ADDR_PRE, 1, -8)
	e = addrImmCase(e, "[sp, #16]!", ADDR_PRE, 31, 16)
	e = addrImmCase(e, "[x1], #8", ADDR_POST, 1, 8)
	e = addrImmCase(e, "[x1], #-16", ADDR_POST, 1, -16)
	e = addrImmCase(e, "[sp], #0x20", ADDR_POST, 31, 32)
	// A bare post-index offset (no '#') is accepted, as clang does.
	e = addrImmCase(e, "[x1], 8", ADDR_POST, 1, 8)
	return e
}

// Register-offset addresses: an X (or XZR / x31) index with no extend, `lsl #n` or
// `sxtx {#n}`; a W (or WZR) index with `uxtw {#n}` or `sxtw {#n}`; any case.
func TestA64AddrIndex() testing.TestResult {
	var e @[]char = ""
	var lsl int = isa.EXT_LSL
	var sxtx int = isa.EXT_SXTX
	var uxtw int = isa.EXT_UXTW
	var sxtw int = isa.EXT_SXTW
	e = addrIndexCase(e, "[x1, x2]", 1, 2, RC_X, lsl, false, 0)
	e = addrIndexCase(e, "[x1, x2, lsl #3]", 1, 2, RC_X, lsl, true, 3)
	e = addrIndexCase(e, "[x1, x2, lsl #0]", 1, 2, RC_X, lsl, true, 0)
	// A bare shift amount (no '#') is accepted, as clang does.
	e = addrIndexCase(e, "[x1, x2, lsl 3]", 1, 2, RC_X, lsl, true, 3)
	e = addrIndexCase(e, "[x1, x2, sxtx]", 1, 2, RC_X, sxtx, false, 0)
	e = addrIndexCase(e, "[x1, x2, sxtx #3]", 1, 2, RC_X, sxtx, true, 3)
	e = addrIndexCase(e, "[x1, w2, uxtw]", 1, 2, RC_W, uxtw, false, 0)
	e = addrIndexCase(e, "[x1, w2, uxtw #2]", 1, 2, RC_W, uxtw, true, 2)
	e = addrIndexCase(e, "[x1, w2, sxtw]", 1, 2, RC_W, sxtw, false, 0)
	e = addrIndexCase(e, "[x1, w2, sxtw #3]", 1, 2, RC_W, sxtw, true, 3)
	e = addrIndexCase(e, "[x1, xzr]", 1, 31, RC_XZR, lsl, false, 0)
	e = addrIndexCase(e, "[x1, x31]", 1, 31, RC_XZR, lsl, false, 0)
	e = addrIndexCase(e, "[x1, wzr, uxtw]", 1, 31, RC_WZR, uxtw, false, 0)
	e = addrIndexCase(e, "[sp, x2, lsl #3]", 31, 2, RC_X, lsl, true, 3)
	e = addrIndexCase(e, "[X1, X2, LSL #3]", 1, 2, RC_X, lsl, true, 3)
	e = addrIndexCase(e, "[x1, W2, UXTW #2]", 1, 2, RC_W, uxtw, true, 2)
	e = addrIndexCase(e, "[x1, x2, SxtX]", 1, 2, RC_X, sxtx, false, 0)
	return e
}

// Page-offset addresses: `#:lo12:sym` / `:lo12:sym` (with an addend) and
// `#:got_lo12:sym` (ELF syntax), `sym@PAGEOFF` / `sym@GOTPAGEOFF` (Mach-O syntax, with
// the addend before or after the specifier).
func TestA64AddrPageOffset() testing.TestResult {
	var e @[]char = ""
	e = addrPageCase(e, "[x1, #:lo12:sym]", ADDR_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[x1, :lo12:sym]", ADDR_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[x1, :lo12:sym+8]", ADDR_LO12, 1, "sym", 8)
	e = addrPageCase(e, "[x1, #:lo12:sym-8]", ADDR_LO12, 1, "sym", -8)
	e = addrPageCase(e, "[x1, #:LO12:sym]", ADDR_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[sp, #:lo12:sym]", ADDR_LO12, 31, "sym", 0)
	e = addrPageCase(e, "[x1, #:got_lo12:sym]", ADDR_GOT_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[x1, :got_lo12:sym]", ADDR_GOT_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[x1, sym@PAGEOFF]", ADDR_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[x1, sym+8@PAGEOFF]", ADDR_LO12, 1, "sym", 8)
	e = addrPageCase(e, "[x1, sym@PAGEOFF+8]", ADDR_LO12, 1, "sym", 8)
	e = addrPageCase(e, "[x1, sym@pageoff]", ADDR_LO12, 1, "sym", 0)
	e = addrPageCase(e, "[x1, sym@GOTPAGEOFF]", ADDR_GOT_LO12, 1, "sym", 0)
	return e
}

// parseA64Addr stops just past the address and leaves what follows to its caller: the
// returned token is the one after `]` (or after `!`, or after the post-index offset).
// (A ',' straight after `]` always introduces a post-index offset.)
func TestA64AddrStopsAfterOperand() testing.TestResult {
	var e @[]char = ""
	e, _, _ = addrAcceptCheck(e, "[x1] x2", TOK_IDENT, ADDR_BASE, 1)
	e, _, _ = addrAcceptCheck(e, "[x1, #8]!, x2", TOK_COMMA, ADDR_PRE, 1)
	e, _, _ = addrAcceptCheck(e, "[x1, #8]]", TOK_RBRACKET, ADDR_IMM, 1)
	e, _, _ = addrAcceptCheck(e, "[x1], #8, x3", TOK_COMMA, ADDR_POST, 1)
	e, _, _ = addrAcceptCheck(e, "[x1, x2]!", TOK_BANG, ADDR_REG, 1)
	e, _, _ = addrAcceptCheck(e, "[x1, :lo12:sym]!", TOK_BANG, ADDR_LO12, 1)
	return e
}

// An offset wider than 32 bits is carried whole for the instruction to reject as out
// of range (as clang does), never truncated to its low 32 bits: on a 32-bit-int host
// `[x1, #0x100000008]` must not read as `[x1, #8]`.
func TestA64AddrWideOffsetNotTruncated() testing.TestResult {
	ad, ok, _, _ := addrScanLine("[x1, #0x100000008]")
	if ok && ad.Imm == 8 { return fail("immediate offset truncated to its low 32 bits") }
	ad, ok, _, _ = addrScanLine("[x1], #0x100000008")
	if ok && ad.Imm == 8 { return fail("post-index offset truncated to its low 32 bits") }
	ad, ok, _, _ = addrScanLine("[x1, :lo12:sym+0x100000008]")
	if ok && ad.Imm == 8 { return fail("page-offset addend truncated to its low 32 bits") }
	var e @[]char = ""
	e = goldenReject(e, "ldr x0, [x1, #0x100000008]")
	e = goldenReject(e, "ldr x0, [x1], #0x100000008")
	e = goldenReject(e, "ldr x0, [x1, #0x100000008]!")
	return e
}
