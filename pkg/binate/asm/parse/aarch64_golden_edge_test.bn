package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden cases at the edges of the AArch64 syntax: operand expressions, the
// inverted-immediate aliases on W registers, literal loads at `.`-relative offsets,
// PRFM's addressing, the 32-bit extended-register form, shift-amount spelling, and
// character literals.  Each word is clang's (`clang -c -target arm64-apple-macos11`,
// else `-target aarch64-linux-gnu`); each rejection is a line clang rejects, unless
// the test says it is a deliberate one.

// Expressions whose operator mixes all of clang's precedence tables (Mach-O's
// Darwin table, ELF's GNU table, x86 Intel syntax's C table) agree on: * / % bind
// tighter than + - and than | & ^, << >> bind tighter than | & ^, each group is
// left-associative; >> of a non-negative value is logical.
func TestGoldenExprAgreedPrecedence() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "add x0, x1, #4|1|2", 0x91001C20)
	e = goldenWord(e, "add x0, x1, #(1+2)<<3", 0x91006020)
	e = goldenWord(e, "add x0, x1, #1+(2<<3)", 0x91004420)
	e = goldenWord(e, "add x0, x1, #6/2|1", 0x91000C20)
	e = goldenWord(e, "add x0, x1, #2*3+1", 0x91001C20)
	e = goldenWord(e, "add x0, x1, #(4|1)&2", 0x91000020)
	e = goldenWord(e, "add x0, x1, #64>>3>>1", 0x91001020)
	e = goldenWord(e, "add x0, x1, #(-9223372036854775808)%-1", 0x91000020)
	e = goldenReject(e, "add x0, x1, #(1<<-1)")
	e = goldenReject(e, "add x0, x1, #1/0")
	e = goldenReject(e, "add x0, x1, #(-9223372036854775808)/-1")
	return e
}

// Deliberate rejections clang accepts: an unparenthesized mix of operator groups the
// tables rank differently (+ - with << >>, + - with | & ^, * / % with << >>, two
// different bitwise operators), which clang evaluates differently for Mach-O, ELF and
// x86 operands (`#1+2<<3` is 24 on Mach-O, 17 on ELF; `#4|1&2` is 0 on both, 4 in
// x86 syntax); a right shift of a negative value (logical on Mach-O and ELF,
// arithmetic in x86 syntax); and a shift count of 64 or more, whose value clang
// leaves to the host's shift.
func TestGoldenExprDeliberateRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "add x0, x1, #1+2<<3")
	e = goldenReject(e, "add x0, x1, #16-1<<2")
	e = goldenReject(e, "add x0, x1, #1|1+1")
	e = goldenReject(e, "add x0, x1, #1<<2*2")
	e = goldenReject(e, "add x0, x1, #2*3<<1")
	e = goldenReject(e, "add x0, x1, #4|1&2")
	e = goldenReject(e, "add x0, x1, #1|2^3")
	e = goldenReject(e, "add x0, x1, #6^3&1")
	e = goldenReject(e, "mov x0, #-16>>60")
	e = goldenReject(e, "add x0, x1, #(-8 >> 61)")
	e = goldenReject(e, "add x0, x1, #1<<63>>63")
	e = goldenReject(e, "add x0, x1, #(4>>64)")
	e = goldenReject(e, "add x0, x1, #(1<<64)")
	return e
}

// bic / bics / orn / eon #imm on a W register take an immediate whose upper half is
// all zero or all one (clang's W-form rule) and complement it within 32 bits; any
// other value is rejected, not cut to its low half.
func TestGoldenInvertedLogicalImmW() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "bic w0, w1, #0xFFFFFFFFFFFFFFFE", 0x12000020)
	e = goldenWord(e, "bic w0, w1, #-2", 0x12000020)
	e = goldenWord(e, "bic x0, x1, #0x100000001", 0x921F7820)
	e = goldenReject(e, "bic w0, w1, #0x100000001")
	e = goldenReject(e, "orn w0, w1, #0x1234567800000001")
	e = goldenReject(e, "eon w0, w1, #0x1FFFFFFFE")
	e = goldenReject(e, "bics w0, w1, #0x100000001")
	return e
}

// A literal load at an offset from `.`; only LDR W / X / S / D / Q, LDRSW and PRFM have
// the literal form, and a literal takes a plain label — not `sym@PAGEOFF`, and not a
// shift or extend keyword.
func TestGoldenLiteralForms() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldr x0, .+8", 0x58000040)
	e = goldenWord(e, "ldr w0, .-4", 0x18FFFFE0)
	e = goldenWord(e, "ldr x0, .", 0x58000000)
	e = goldenWord(e, "prfm pldl1keep, .+8", 0xD8000040)
	e = goldenWord(e, "ldr q0, .+16", 0x9C000080)
	e = goldenWord(e, "ldrsw x1, .+12", 0x98000061)
	e = goldenReject(e, "str x0, .+8")
	e = goldenReject(e, "ldrb w0, .+8")
	e = goldenReject(e, "ldr x0, sym@PAGEOFF")
	e = goldenReject(e, "prfm pldl1keep, sym@PAGEOFF")
	e = goldenReject(e, "ldr x0, lsl")
	e = goldenReject(e, "ldr x0, uxtw")
	return e
}

// `prfm` names the scaled unsigned-offset form only; an unscaled offset is spelled
// `prfum` (LDR / STR alone fall back to the unscaled form).
func TestGoldenPrfmScaledOnly() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "prfm pldl1keep, [x1, #8]", 0xF9800420)
	e = goldenWord(e, "prfum pldl1keep, [x1, #-8]", 0xF89F8020)
	e = goldenReject(e, "prfm pldl1keep, [x1, #-8]")
	e = goldenReject(e, "prfm pldl1keep, [x1, #1]")
	return e
}

// The 32-bit extended-register add / sub takes a W Rm with any of the eight extends,
// uxtx / sxtx included; an X Rm is the 64-bit form's.
func TestGoldenExtendedRegisterW() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "add w0, w1, w2, uxtx", 0x0B226020)
	e = goldenWord(e, "add w0, w1, w2, sxtx #2", 0x0B22E820)
	e = goldenWord(e, "add w0, wsp, w2, uxtx #1", 0x0B2267E0)
	e = goldenWord(e, "sub w0, w1, w2, sxtx", 0x4B22E020)
	e = goldenWord(e, "adds w0, w1, w2, uxtx #4", 0x2B227020)
	e = goldenReject(e, "add w0, w1, x2, uxtx")
	return e
}

// A shift / extend amount follows `#` or starts with an integer literal; clang takes
// nothing else (`lsl (3)`, `lsl -0`, `lsl +3`, `lsl ~0+2`) as an amount.  ADRP takes a
// plain label, its @PAGE or its @GOTPAGE — not @PLT; ADR only a plain label.  A vector
// register name is not a symbol.
func TestGoldenOperandSpelling() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "add x0, x1, x2, lsl 1+1", 0x8B020820)
	e = goldenReject(e, "add x0, x1, x2, lsl (3)")
	e = goldenReject(e, "add x0, x1, x2, lsl ~0+2")
	e = goldenReject(e, "add x0, x1, x2, lsl -0")
	e = goldenReject(e, "add x0, x1, x2, lsl +3")
	e = goldenReject(e, "add x0, x1, w2, uxtw (2)")
	e = goldenReject(e, "adrp x0, sym@PLT")
	e = goldenReject(e, "adr x0, sym@PAGE")
	e = goldenReject(e, "add x0, x1, v0")
	e = goldenReject(e, "b v0")
	return e
}

// Character-literal operands take the escapes GNU as and clang agree on.  `'\0'` is a
// deliberate rejection: clang reads it as the character '0' (0x30) where GNU reads the
// octal 0, so it has no single meaning; `'\101'` / `'\x41'` clang rejects outright.
func TestGoldenCharLiterals() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "mov w0, #'\\n'", 0x52800140)
	e = goldenWord(e, "mov w0, #'\"'", 0x52800440)
	e = goldenReject(e, "mov w0, #'\\0'")
	e = goldenReject(e, "mov w0, #'\\101'")
	e = goldenReject(e, "mov w0, #'\\x41'")
	return e
}

// Operands written without `#` (a character literal like an integer — also as a shift
// amount or a symbol addend — and an offset inside the brackets, with pre-index, in
// pairs, PRFM, a Q register, the exclusive, unprivileged, authenticated and LDAP1 forms
// and LDAPR's #0), and an add / sub immediate that only fits shifted written with `lsl
// #0`, which clang encodes with `lsl #12` (negated into the other operation for a negative
// one); an atomic takes no offset at all.
func TestGoldenSmallForms() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "mov w0, 'a'", 0x52800C20)
	e = goldenWord(e, "add x0, x1, 'a'", 0x91018420)
	e = goldenWord(e, "cmp x0, 'a'", 0xF101841F)
	e = goldenWord(e, "movz x0, 'a', lsl #16", 0xD2A00C20)
	e = goldenWord(e, "svc 'a'", 0xD4000C21)
	e = goldenWord(e, "ldr x0, [x1, 8]", 0xF9400420)
	e = goldenWord(e, "ldr x0, [x1, (8)]", 0xF9400420)
	e = goldenWord(e, "ldr x0, [x1, -8]", 0xF85F8020)
	e = goldenWord(e, "ldr x0, [x1, 8]!", 0xF8408C20)
	e = goldenWord(e, "ldr x0, [x1, 1+7]", 0xF9400420)
	e = goldenWord(e, "ldr x0, [x1, 'a']", 0xF8461020)
	e = goldenWord(e, "ldp x0, x1, [x2, 16]", 0xA9410440)
	e = goldenWord(e, "ldur x0, [x1, -3]", 0xF85FD020)
	e = goldenWord(e, "prfm pldl1keep, [x1, 8]", 0xF9800420)
	e = goldenWord(e, "ldr q0, [x1, 32]", 0x3DC00820)
	e = goldenWord(e, "ldapr x0, [x1, 0]", 0xF8BFC020)
	e = goldenWord(e, "add x0, x1, #4096, lsl #0", 0x91400420)
	e = goldenWord(e, "add w0, w1, #4096, lsl #0", 0x11400420)
	e = goldenWord(e, "sub x0, x1, #8192, lsl #0", 0xD1400820)
	e = goldenWord(e, "add x0, x1, #-4096, lsl #0", 0xD1400420)
	e = goldenWord(e, "adds w0, w1, #4096, lsl #0", 0x31400420)
	e = goldenWord(e, "cmp x0, #4096, lsl #0", 0xF140041F)
	e = goldenWord(e, "cmn w0, #-4096, lsl #0", 0x7140041F)
	e = goldenWord(e, "ldxr x0, [x1, 0]", 0xC85F7C20)
	e = goldenWord(e, "ldtr x0, [x1, 8]", 0xF8408820)
	e = goldenWord(e, "ldraa x0, [x1, 8]!", 0xF8201C20)
	e = goldenWord(e, "ldap1 {v0.d}[1], [x1, 0]", 0x4D418420)
	e = goldenWord(e, "add x0, x1, x2, lsl '!'", 0x8B028420)
	e = goldenWord(e, "movz x0, #1, lsl ' '", 0xD2C00020)
	e = goldenWord(e, "movi v0.4s, #1, msl '\\b'", 0x4F00C420)
	e = goldenWord(e, "b sym+'a'", 0x14000000)
	e = goldenWord(e, "ldr x0, sym+'a'", 0x58000000)
	e = goldenReject(e, "add x0, x1, #0x1001, lsl #0")
	e = goldenReject(e, "add x0, x1, #4096, lsl #12")
	e = goldenReject(e, "ldr x0, [x1, 8+sym]")
	e = goldenReject(e, "ldr x0, [x1, 8, lsl #0]")
	e = goldenReject(e, "ldadd x0, x1, [x2, 0]")
	return e
}

// A symbol named like a condition (eq, al, …) is a label wherever one is taken; one named
// like a shift or extend (lsl, uxtw, msl, …) is a label for B / BL / B.cond / ADR / ADRP,
// but after CBZ / TBZ's register or bit operand and in a literal LDR clang reads it as a
// shift, and rejects it; a shift name with an addend or `@` after it names a symbol only
// in those label positions (so `lsl -1` in a shift position is rejected), while a
// condition name so followed is a symbol anywhere.  Words are clang's, Mach-O or — where
// Mach-O cannot express the relocation (a conditional branch or ADR to a non-local symbol,
// ADRP without @PAGE, @PLT) — ELF, the targets unresolved.
func TestGoldenKeywordNamedLabels() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "b lsl", 0x14000000)
	e = goldenWord(e, "b uxtw", 0x14000000)
	e = goldenWord(e, "b sxtb", 0x14000000)
	e = goldenWord(e, "b sxtx", 0x14000000)
	e = goldenWord(e, "b msl", 0x14000000)
	e = goldenWord(e, "b ror", 0x14000000)
	e = goldenWord(e, "b al", 0x14000000)
	e = goldenWord(e, "b nv", 0x14000000)
	e = goldenWord(e, "b hs", 0x14000000)
	e = goldenWord(e, "b lo", 0x14000000)
	e = goldenWord(e, "b eq", 0x14000000)
	e = goldenWord(e, "b ne", 0x14000000)
	e = goldenWord(e, "bl eq", 0x94000000)
	e = goldenWord(e, "bl lsl", 0x94000000)
	e = goldenWord(e, "b lsl+4", 0x14000000)
	e = goldenWord(e, "b eq+4", 0x14000000)
	e = goldenWord(e, "b msl+4", 0x14000000)
	e = goldenWord(e, "cbz x0, eq", 0xB4000000)
	e = goldenWord(e, "cbz x0, eq+8", 0xB4000000)
	e = goldenWord(e, "tbz x0, #1, eq", 0x36080000)
	e = goldenWord(e, "b.eq eq", 0x54000000)
	e = goldenWord(e, "b.ne lsl", 0x54000001)
	e = goldenWord(e, "adr x0, lsl", 0x10000000)
	e = goldenWord(e, "adrp x0, eq", 0x90000000)
	e = goldenWord(e, "adrp x0, lsl", 0x90000000)
	e = goldenWord(e, "ldr x0, eq", 0x58000000)
	e = goldenReject(e, "cbz x0, lsl")
	e = goldenReject(e, "cbnz x0, msl")
	e = goldenReject(e, "tbz x0, #1, lsl")
	e = goldenReject(e, "ldr x0, lsl")
	e = goldenWord(e, "b lsl -1", 0x14000000)
	e = goldenReject(e, "add x0, x1, x2, lsl -1")
	e = goldenReject(e, "add x0, x1, x2, lsl +1")
	e = goldenReject(e, "ldr x0, [x1, x2, lsl -1]")
	e = goldenWord(e, "b lsl@PLT", 0x14000000)
	e = goldenWord(e, "adrp x0, eq@PAGE", 0x90000000)
	e = goldenWord(e, "add x0, x0, eq@PAGEOFF", 0x91000000)
	e = goldenWord(e, "ldr x0, [x0, eq+8@PAGEOFF]", 0xF9400000)
	e = goldenReject(e, "cbz x0, lsl+4")
	e = goldenReject(e, "cbz x0, uxtw+4")
	e = goldenReject(e, "cbz x0, lsl -1")
	e = goldenReject(e, "cbnz w0, lsr+4")
	e = goldenReject(e, "tbz x0, #1, lsl+4")
	e = goldenReject(e, "tbz x0, #1, uxtw+4")
	e = goldenReject(e, "cbz x0, lsl@PLT")
	e = goldenReject(e, "add x0, x0, lsl@PAGEOFF")
	e = goldenReject(e, "ldr x0, [x0, lsl@PAGEOFF]")
	e = goldenReject(e, "ldr x0, [x0, uxtw@GOTPAGEOFF]")
	return e
}
