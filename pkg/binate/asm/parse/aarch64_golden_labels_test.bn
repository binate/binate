package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Golden tests for numeric local labels (`1:`, `1b`, `2f`) and `.`-leading names (`.Lf`),
// each source assembled for an ELF object as the assemble driver does — its lines, the end
// of the input, the temporary labels and then the fixups resolved — to clang's words
// (`clang -c -target aarch64-linux-gnu`), with every reference resolved in place (no
// relocation, as clang's objects have none).

// labelsSource assembles the multi-line src (after `.arch aarch64` and `.section text`)
// for an object of format.
func labelsSource(src *[]readonly char, format int) @Parser {
	var p @Parser = newTestParser()
	p.Asm.ObjFormat = format
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
	p.Finish()
	if !p.HasError && !p.Asm.HasError {
		p.Asm.ObjFormat = format
		if p.Asm.CheckTemporaryLabels() {
			aarch64.ResolveFixups(p.Asm)
			if !p.Asm.HasError { p.Asm.Finalize() }
		}
	}
	return p
}

// labelsWordsHex returns the words of p's first section as uppercase 8-digit hex, each
// followed by a space.
func labelsWordsHex(p @Parser) @[]char {
	var s @asm.Section = p.Asm.Sections[0]
	var digits *[]readonly char = "0123456789ABCDEF"
	var b @strings.Builder = strings.NewBuilder()
	for off := 0; off + 4 <= s.Len; off = off + 4 {
		var w uint32 = readInst(s, off)
		for sh := 28; sh >= 0; sh = sh - 4 {
			b.WriteByte(digits[cast(int, (w >> cast(uint32, sh)) & 15)])
		}
		b.WriteByte(' ')
	}
	return buf.CopyStr(b.String())
}

// labelsCase checks that src assembles for an ELF object to exactly the words want
// (uppercase hex, each followed by a space) with no relocation left.
func labelsCase(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	if p.Asm.NumRelocs != 0 { return goldenFail(e, src, "left a relocation") }
	return e
}

// labelsReject checks that src is rejected, by a line or at the end of the input.
func labelsReject(e @[]char, src *[]readonly char) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if !p.HasError && !p.Asm.HasError { return goldenFail(e, src, "accepted") }
	return e
}

// `Nb` is the latest instance of N defined so far (on its own line too), `Nf` the next
// one; the number is read by value (`01:`, `0x1:`, `0b1b`), the letter may follow after
// spaces (`1 b`), and 1 and 10 are different labels.
func TestGoldenNumericLabels() testing.TestResult {
	var e @[]char = ""
	e = labelsCase(e, "b 1f\n1: nop", "14000001 D503201F ")
	e = labelsCase(e, "1: nop\n b 1b", "D503201F 17FFFFFF ")
	e = labelsCase(e, "1: nop\n1: b 1b", "D503201F 14000000 ")
	e = labelsCase(e, "b 1f\n1: nop\n1: nop", "14000001 D503201F D503201F ")
	e = labelsCase(e, "1: nop\n1: nop\n b 1b\n b 1f\n1: nop",
			"D503201F D503201F 17FFFFFF 14000001 D503201F ")
	e = labelsCase(e, "0: b 0b", "14000000 ")
	e = labelsCase(e, "b 0f\n0: nop", "14000001 D503201F ")
	e = labelsCase(e, "1: b 1 b", "14000000 ")
	e = labelsCase(e, "b 2 f\n2: nop", "14000001 D503201F ")
	e = labelsCase(e, "01: b 1b", "14000000 ")
	e = labelsCase(e, "0x1: b 1b", "14000000 ")
	e = labelsCase(e, "1: b 0x1 b", "14000000 ")
	e = labelsCase(e, "1: b 0b1b", "14000000 ")
	e = labelsCase(e, "cbz x0, 2f\n2: b 2b", "B4000020 14000000 ")
	e = labelsCase(e, "1: nop\n b.eq 1b", "D503201F 54FFFFE0 ")
	e = labelsCase(e, "1: adr x0, 1b-4", "10FFFFE0 ")
	e = labelsCase(e, "1: ldr x0, 1b", "58000000 ")
	e = labelsCase(e, "1: nop\n10: nop\n b 1b", "D503201F D503201F 17FFFFFE ")
	return e
}

// Numeric label errors clang reports: a reference to an instance never defined (backward
// before any, or forward with none after), a reference as a label name, and `@PLT` on a
// reference.
func TestGoldenNumericLabelRejects() testing.TestResult {
	var e @[]char = ""
	e = labelsReject(e, "b 1b")
	e = labelsReject(e, "b 1f")
	e = labelsReject(e, "1: nop\n b 1f")
	e = labelsReject(e, "b 1b\n1: nop")
	e = labelsReject(e, "1b: nop")
	e = labelsReject(e, "1: b 1b@PLT")
	e = labelsReject(e, "1: b 1bx")
	e = labelsReject(e, "1: b 1B")
	return e
}

// A name may start with '.', as a label and as a reference; on ELF a `.L` label is
// temporary, so a reference to it resolves against the section — in place.
func TestGoldenDotLeadingLabels() testing.TestResult {
	var e @[]char = ""
	e = labelsCase(e, ".Lf: nop\n b .Lf", "D503201F 17FFFFFF ")
	e = labelsCase(e, "b .Lb\n.Lb: nop", "14000001 D503201F ")
	e = labelsCase(e, "adr x0, .Lf+8\n.Lf: nop", "10000060 D503201F ")
	e = labelsCase(e, "..x: b ..x", "14000000 ")
	return e
}
