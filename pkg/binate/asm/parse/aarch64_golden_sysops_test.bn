	return e
}

// PRFM / PRFUM prefetch operations clang accepts: each type, target and policy.
func TestGoldenPrfmOps() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "prfm pldl1keep, [x15]", 0xF98001E0)
	e = goldenWord(e, "prfm pldl1strm, [x22]", 0xF98002C1)
	e = goldenWord(e, "prfm pldl2keep, [x29]", 0xF98003A2)
	e = goldenWord(e, "prfm pldl2strm, [x5]", 0xF98000A3)
	e = goldenWord(e, "prfm pldl3keep, [x12]", 0xF9800184)
	e = goldenWord(e, "prfm pldl3strm, [x19]", 0xF9800265)
	e = goldenWord(e, "prfm pldslckeep, [x26]", 0xF9800346)
	e = goldenWord(e, "prfm pldslcstrm, [x2]", 0xF9800047)
	e = goldenWord(e, "prfm plil1keep, [x9]", 0xF9800128)
	e = goldenWord(e, "prfm plil1strm, [x16]", 0xF9800209)
	e = goldenWord(e, "prfm plil2keep, [x23]", 0xF98002EA)
	e = goldenWord(e, "prfm plil2strm, [x30]", 0xF98003CB)
	e = goldenWord(e, "prfm plil3keep, [x6]", 0xF98000CC)
	e = goldenWord(e, "prfm plil3strm, [x13]", 0xF98001AD)
	e = goldenWord(e, "prfm plislckeep, [x20]", 0xF980028E)
	e = goldenWord(e, "prfm plislcstrm, [x27]", 0xF980036F)
	e = goldenWord(e, "prfm pstl1keep, [x3]", 0xF9800070)
	e = goldenWord(e, "prfm pstl1strm, [x10]", 0xF9800151)
	e = goldenWord(e, "prfm pstl2keep, [x17]", 0xF9800232)
	e = goldenWord(e, "prfm pstl2strm, [x24]", 0xF9800313)
	e = goldenWord(e, "prfm pstl3keep, [x0]", 0xF9800014)
	e = goldenWord(e, "prfm pstl3strm, [x7]", 0xF98000F5)
	e = goldenWord(e, "prfm pstslckeep, [x14]", 0xF98001D6)
	e = goldenWord(e, "prfm pstslcstrm, [x21]", 0xF98002B7)
	e = goldenWord(e, "prfum pldslcstrm, [x1, #1]", 0xF8801027)
	e = goldenWord(e, "prfum pstslckeep, [x2, #-256]", 0xF8900056)
	e = goldenWord(e, "prfm plislckeep, [x3, #8]", 0xF980046E)
	e = goldenWord(e, "prfm pldslckeep, [x4, x5, lsl #3]", 0xF8A57886)
	e = goldenWord(e, "PRFM PSTSLCSTRM, [x6]", 0xF98000D7)
	return e
}

// DSB nXS (named and #16 / #20 / #24 / #28, a single literal with or without '#'), the csync
// barrier option, a barrier immediate without '#' (a literal, or after '#' any expression;
// CLREX and HINT take any expression), CLRBHB / PACM and MSR (immediate) of each PSTATE
// field: 0..15 for the CRm-immediate fields, 0..1 for ALLINT, PM and the SVCR fields.
func TestGoldenBarrierHintPstate() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "dsb oshnxs", 0xD503323F)
	e = goldenWord(e, "dsb nshnxs", 0xD503363F)
	e = goldenWord(e, "dsb ishnxs", 0xD5033A3F)
	e = goldenWord(e, "dsb synxs", 0xD5033E3F)
	e = goldenWord(e, "dsb SYnXS", 0xD5033E3F)
	e = goldenWord(e, "dsb #16", 0xD503323F)
	e = goldenWord(e, "dsb #20", 0xD503363F)
	e = goldenWord(e, "dsb #24", 0xD5033A3F)
	e = goldenWord(e, "dsb #28", 0xD5033E3F)
	e = goldenWord(e, "dsb #0x1c", 0xD5033E3F)
	e = goldenWord(e, "dsb 16", 0xD503323F)
	e = goldenWord(e, "dsb 0x10", 0xD503323F)
	e = goldenWord(e, "dsb #020", 0xD503323F)
	e = goldenWord(e, "dsb #0b10000", 0xD503323F)
	e = goldenWord(e, "dsb 28", 0xD5033E3F)
	e = goldenWord(e, "dsb #(4)", 0xD503349F)
	e = goldenWord(e, "dmb 4", 0xD50334BF)
	e = goldenWord(e, "isb 4", 0xD50334DF)
	e = goldenWord(e, "clrex (4)", 0xD503345F)
	e = goldenWord(e, "clrex +4", 0xD503345F)
	e = goldenWord(e, "hint (4)", 0xD503209F)
	e = goldenWord(e, "hint +4", 0xD503209F)
	e = goldenWord(e, "dsb csync", 0xD503309F)
	e = goldenWord(e, "dmb csync", 0xD50330BF)
	e = goldenWord(e, "dsb CSYNC", 0xD503309F)
	e = goldenWord(e, "clrbhb", 0xD50322DF)
	e = goldenWord(e, "CLRBHB", 0xD50322DF)
	e = goldenWord(e, "pacm", 0xD50324FF)
	e = goldenWord(e, "msr allint, #0", 0xD501401F)
	e = goldenWord(e, "msr allint, #1", 0xD501411F)
	e = goldenWord(e, "msr pm, #0", 0xD501421F)
	e = goldenWord(e, "msr PM, #1", 0xD501431F)
	e = goldenWord(e, "msr svcrsm, #0", 0xD503427F)
	e = goldenWord(e, "msr svcrsm, #1", 0xD503437F)
	e = goldenWord(e, "msr svcrza, #0", 0xD503447F)
	e = goldenWord(e, "msr svcrza, #1", 0xD503457F)
	e = goldenWord(e, "msr svcrsmza, #0", 0xD503467F)
	e = goldenWord(e, "msr SVCRSMZA, #1", 0xD503477F)
	e = goldenWord(e, "msr pan, #15", 0xD5004F9F)
	e = goldenWord(e, "msr uao, #2", 0xD500427F)
	e = goldenWord(e, "msr spsel, #15", 0xD5004FBF)
	e = goldenWord(e, "msr dit, #7", 0xD503475F)
	e = goldenWord(e, "msr ssbs, #15", 0xD5034F3F)
	e = goldenWord(e, "msr tco, #15", 0xD5034F9F)
	return e
}

// System-operation lines clang rejects: a DSB nXS option on DMB / ISB or with a tail or
// operand, an immediate that is no barrier option (or, for DSB nXS, not a single literal),
// a DSB / DMB / ISB immediate without '#' that does not start with a literal, operands on
// CLRBHB / PACM, a PSTATE immediate out of its field's range, an unknown AT / DC operation
// (including GBVA / ZGBVA, which only newer LLVM knows), an operation's register missing,
// extra or not an X register, and a prefetch name that is not <type><target><policy>.
func TestGoldenSysOpRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "dmb synxs")
	e = goldenReject(e, "dmb oshnxs")
	e = goldenReject(e, "dmb #16")
	e = goldenReject(e, "isb #16")
	e = goldenReject(e, "isb synxs")
	e = goldenReject(e, "dsb #17")
	e = goldenReject(e, "dsb #29")
	e = goldenReject(e, "dsb #32")
	e = goldenReject(e, "dsb #-16")
	e = goldenReject(e, "dsb ishnxs, x1")
	e = goldenReject(e, "dsb synxs+4")
	e = goldenReject(e, "dsb ishnxs@PAGE")
	e = goldenReject(e, "dsb nxs")
	e = goldenReject(e, "dsb shnxs")
	e = goldenReject(e, "dsb #(16)")
	e = goldenReject(e, "dsb #'a'")
	e = goldenReject(e, "dsb 'a'")
	e = goldenReject(e, "dsb (4)")
	e = goldenReject(e, "dsb +4")
	e = goldenReject(e, "dmb (4)")
	e = goldenReject(e, "dmb +4")
	e = goldenReject(e, "isb (4)")
	e = goldenReject(e, "dsb (16)")
	e = goldenReject(e, "dsb ~-17")
	e = goldenReject(e, "dsb #-(-16)")
	e = goldenReject(e, "dsb #32-4")
	e = goldenReject(e, "dsb #(8)+8")
	e = goldenReject(e, "clrbhb x0")
	e = goldenReject(e, "clrbhb #1")
	e = goldenReject(e, "pacm #1")
	e = goldenReject(e, "pacm x0")
	e = goldenReject(e, "msr allint, #2")
	e = goldenReject(e, "msr pm, #2")
	e = goldenReject(e, "msr svcrsm, #2")
	e = goldenReject(e, "msr svcrza, #16")
	e = goldenReject(e, "msr svcrsmza, #-1")
	e = goldenReject(e, "msr pan, #16")
	e = goldenReject(e, "msr svcr, #1")
	e = goldenReject(e, "msr allint+1, #1")
	e = goldenReject(e, "at s1e1r")
	e = goldenReject(e, "at s1e1r, w1")
	e = goldenReject(e, "at s1e1r, x1, x2")
	e = goldenReject(e, "at s1e2rp, x1")
	e = goldenReject(e, "at s1e0a, x1")
	e = goldenReject(e, "at s1e1r+0, x1")
	e = goldenReject(e, "at foo, x1")
	e = goldenReject(e, "at s1e1r, sp")
	e = goldenReject(e, "dc gbva, x1")
	e = goldenReject(e, "dc zgbva, x1")
	e = goldenReject(e, "dc gva")
	e = goldenReject(e, "dc cvaoc")
	e = goldenReject(e, "dc cipapa, w1")
	e = goldenReject(e, "ic ivau, w1")
	e = goldenReject(e, "ic ialluis, xzr")
	e = goldenReject(e, "prfm pldslc, [x1]")
	e = goldenReject(e, "prfm pldl4keep, [x1]")
	e = goldenReject(e, "prfm plislcstrmx, [x1]")
	e = goldenReject(e, "prfm pldslckeep")
	e = goldenReject(e, "prfm slckeep, [x1]")
	e = goldenReject(e, "prfm pldslckep, [x1]")
	e = goldenReject(e, "prfum pldslcstrm, [x1, #256]")
	return e
}
