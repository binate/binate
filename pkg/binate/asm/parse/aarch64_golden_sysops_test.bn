package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests for the other system operation tables: every AT, DC and IC operation, PRFM
// prefetch operation (with the system-level-cache SLC target), DSB nXS option, the CLRBHB /
// PACM hints and the MSR (immediate) PSTATE fields clang accepts (`clang -c -target
// arm64-apple-macos11 -march=armv9.6-a+…`, with the MTE, outer-cache, physical-storage,
// realm-management and SME forms), each to clang's word, and the forms clang rejects.

// AT, DC and IC operations clang accepts.
func TestGoldenAtDcIc() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "at s12e0r, x0", 0xD50C78C0)
	e = goldenWord(e, "at s12e0w, x1", 0xD50C78E1)
	e = goldenWord(e, "at s12e1r, x2", 0xD50C7882)
	e = goldenWord(e, "at s12e1w, x3", 0xD50C78A3)
	e = goldenWord(e, "at s1e0r, x5", 0xD5087845)
	e = goldenWord(e, "at s1e0w, x8", 0xD5087868)
	e = goldenWord(e, "at s1e1a, x9", 0xD5087949)
	e = goldenWord(e, "at s1e1r, x13", 0xD508780D)
	e = goldenWord(e, "at s1e1rp, x16", 0xD5087910)
	e = goldenWord(e, "at S1E1W, x17", 0xD5087831)
	e = goldenWord(e, "at s1e1wp, x20", 0xD5087934)
	e = goldenWord(e, "at s1e2a, x27", 0xD50C795B)
	e = goldenWord(e, "at s1e2r, x29", 0xD50C781D)
	e = goldenWord(e, "at s1e2w, x30", 0xD50C783E)
	e = goldenWord(e, "at s1e3a, xzr", 0xD50E795F)
	e = goldenWord(e, "at s1e3r, fp", 0xD50E781D)
	e = goldenWord(e, "at s1e3w, lr", 0xD50E783E)
	e = goldenWord(e, "dc cgdsw, x0", 0xD5087AC0)
	e = goldenWord(e, "dc cgdvac, x1", 0xD50B7AA1)
	e = goldenWord(e, "dc cgdvadp, x2", 0xD50B7DA2)
	e = goldenWord(e, "dc CGDVAOC, x3", 0xD50B7BE3)
	e = goldenWord(e, "dc cgdvap, x5", 0xD50B7CA5)
	e = goldenWord(e, "dc cgsw, x8", 0xD5087A88)
	e = goldenWord(e, "dc cgvac, x9", 0xD50B7A69)
	e = goldenWord(e, "dc cgvadp, x13", 0xD50B7D6D)
	e = goldenWord(e, "dc cgvap, x16", 0xD50B7C70)
	e = goldenWord(e, "dc cigdpae, x17", 0xD50C7EF1)
	e = goldenWord(e, "dc cigdpapa, x20", 0xD50E7EB4)
	e = goldenWord(e, "dc cigdsw, x27", 0xD5087EDB)
	e = goldenWord(e, "dc cigdvac, x29", 0xD50B7EBD)
	e = goldenWord(e, "dc cigdvaoc, x30", 0xD50B7FFE)
	e = goldenWord(e, "dc CIGDVAPS, xzr", 0xD5087FBF)
	e = goldenWord(e, "dc cigsw, fp", 0xD5087E9D)
	e = goldenWord(e, "dc cigvac, lr", 0xD50B7E7E)
	e = goldenWord(e, "dc cipae, x0", 0xD50C7E00)
	e = goldenWord(e, "dc cipapa, x1", 0xD50E7E21)
	e = goldenWord(e, "dc cisw, x2", 0xD5087E42)
	e = goldenWord(e, "dc civac, x3", 0xD50B7E23)
	e = goldenWord(e, "dc civaoc, x5", 0xD50B7F05)
	e = goldenWord(e, "dc civaps, x8", 0xD5087F28)
	e = goldenWord(e, "dc csw, x9", 0xD5087A49)
	e = goldenWord(e, "dc cvac, x13", 0xD50B7A2D)
	e = goldenWord(e, "dc CVADP, x16", 0xD50B7D30)
	e = goldenWord(e, "dc cvaoc, x17", 0xD50B7B11)
	e = goldenWord(e, "dc cvap, x20", 0xD50B7C34)
	e = goldenWord(e, "dc cvau, x27", 0xD50B7B3B)
	e = goldenWord(e, "dc gva, x29", 0xD50B747D)
	e = goldenWord(e, "dc gzva, x30", 0xD50B749E)
	e = goldenWord(e, "dc igdsw, xzr", 0xD50876DF)
	e = goldenWord(e, "dc igdvac, fp", 0xD50876BD)
	e = goldenWord(e, "dc igsw, lr", 0xD508769E)
	e = goldenWord(e, "dc igvac, x0", 0xD5087660)
	e = goldenWord(e, "dc isw, x1", 0xD5087641)
