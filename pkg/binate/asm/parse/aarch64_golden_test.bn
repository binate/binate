package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Helpers for the AArch64 golden tables (aarch64_instr_*_test.bn): each case
// assembles one line in a fresh parser.  Both accumulate into e — a failing case
// appends its message — so a table is a run of `e = golden…(e, …)` lines ending in
// `return e`, reporting every failing line.

// goldenFail appends msg (about line) to the accumulated failures e.
func goldenFail(e *[]readonly char, line *[]readonly char, msg *[]readonly char) @[]char {
	var m @[]char = buf.Concat(buf.Concat("`", line), buf.Concat("`: ", msg))
	if len(e) == 0 { return m }
	return buf.Concat(buf.Concat(e, "\n  "), m)
}

// goldenWord checks that line assembles to exactly the one instruction word want.
func goldenWord(e @[]char, line *[]readonly char, want uint32) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine(line)
	if p.HasError { return goldenFail(e, line, buf.Concat("rejected: ", p.ErrorMsg)) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 4 { return goldenFail(e, line, "did not emit exactly one instruction") }
	if readInst(s, 0) != want { return goldenFail(e, line, "assembled to the wrong word") }
	return e
}

// goldenReject checks that line is rejected with an error.
func goldenReject(e @[]char, line *[]readonly char) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine(line)
	if !p.HasError { return goldenFail(e, line, "accepted, but it has no encoding") }
	return e
}

// Lines clang accepts that this assembler deliberately rejects: a 64-bit immediate
// for a W register, which clang silently truncates to its low 32 bits (a value that
// changes meaning without a diagnostic); the `ldr Xt, =imm` literal-pool
// pseudo-instruction; `;`, a comment on Mach-O but a statement separator on ELF (so
// the same line would mean different things per target); a register name used as a
// symbol (`adr x0, x1`, `adrp x0, v2.2d`, `adr x0, v1.3s`: clang parses ADR / ADRP's
// operand as an expression, so it reads these as symbols called x1, v2.2d and v1.3s,
// while other instructions take them for registers); an addend on a GOT
// reference, which Mach-O cannot represent; thread-local `@TLVPPAGE`, which has no
// fixup; a parenthesized symbol operand; LDXP / LDAXP loading both halves into the
// same register, which is CONSTRAINED UNPREDICTABLE (as the LDP that clang does
// reject), as are LDIAPP into one register twice and an LDIAPP / STILP / LDAPR /
// STLR writeback base that is also a data register; and a bare V register as the Q
// transfer of LDAPUR / STLUR (clang takes `v0` for `q0` there, and nowhere else in
// the load/store forms); SETF8 / SETF16 / RMIF written without operands, which
// clang fills with zeros (register 0, #0) though the architecture's syntax requires
// them; FCMP's zero written as a nonzero literal that rounds to zero (`#1e-400`), and
// with a dangling exponent letter (`#0.0e`, whose `e` clang ignores); and a
// floating-point literal in an integer operand, which clang takes as its IEEE double
// bit pattern; an FMOV immediate literal whose exact value the 8-bit form cannot hold
// but which rounds (as a double) to one it can, or to zero (clang rounds first); FMOV's
// dangling exponent letter too (in the scalar and the vector FMOV alike); an FMOV raw
// hexadecimal encoding of 2^63 or more, of
// which clang silently keeps the low byte; a fixed-point SCVTF / UCVTF with fraction
// bits outside 1..32 (from W) or 1..64 (from X), which clang reduces modulo 32 / 64 to a
// different count (#0 as #32 / #64, #33 as #1, #65 as #1); the zero of an FCMxx compare
// against zero written as a nonzero literal that rounds to zero, with a dangling
// exponent letter, signed, or inside an expression (clang evaluates the last two as the
// literal's IEEE bit pattern, as for an integer operand); and Apple's legacy NEON
// syntax, with the arrangement on the mnemonic and suffix-less vector registers
// (`dup.4s v0, w1`, `umov.s w0, v1[1]`, `tbl.16b v0, {v1}, v3`), which clang accepts on
// every target — this assembler takes only the architecture's own syntax; and an EXT
// index outside the vector (0..7 for 8b, 0..15 for 16b), which clang wraps into range
// (8b #8 as #0, #-1 as #7, 16b #0x100000003 as #3), or given as a symbol or `.`, which
// clang encodes as #0 with no relocation.
func TestGoldenDeliberateRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "mov w0, #0x100000000")
	e = goldenReject(e, "ldr x0, =0x1234")
	e = goldenReject(e, "add x0, x1, x2 ; comment")
	e = goldenReject(e, "nop ; nop")
	e = goldenReject(e, "adr x0, x1")
	e = goldenReject(e, "adr x0, v1.d")
	e = goldenReject(e, "adrp x0, v2.2d")
	e = goldenReject(e, "adr x0, v1.3s")
	e = goldenReject(e, "adrp x0, :got:ext+8")
	e = goldenReject(e, "adrp x0, ext@TLVPPAGE")
	e = goldenReject(e, "b (Ltgt)")
	e = goldenReject(e, "ldxp x0, x0, [x1]")
	e = goldenReject(e, "ldaxp w1, w1, [x2]")
	e = goldenReject(e, "ldapur v0, [x1]")
	e = goldenReject(e, "stlur v3, [x1]")
	e = goldenReject(e, "ldiapp x0, x0, [x2]")
	e = goldenReject(e, "ldiapp x0, x1, [x0], #16")
	e = goldenReject(e, "ldiapp x0, x1, [x1], #16")
	e = goldenReject(e, "stilp x0, x1, [x0, #-16]!")
	e = goldenReject(e, "stilp x0, x1, [x1, #-16]!")
	e = goldenReject(e, "ldapr x0, [x0], #8")
	e = goldenReject(e, "stlr x0, [x0, #-8]!")
	e = goldenReject(e, "setf8")
	e = goldenReject(e, "setf16")
	e = goldenReject(e, "rmif")
	e = goldenReject(e, "fcmp s0, #1e-400")
	e = goldenReject(e, "fcmp s0, #0x1p-2000")
	e = goldenReject(e, "fcmp s0, #0.0e")
	e = goldenReject(e, "mov x0, #1.5")
	e = goldenReject(e, "cmp x0, #0.0")
	e = goldenReject(e, "fmov v0.4s, #1.50000000000000000001")
	e = goldenReject(e, "fmov v0.4s, #1.0e")
	e = goldenReject(e, "fmov v0.4s, #0x8000000000000000")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #1e-400")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #0.0e")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #(0.0)")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, +0.0")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, -0.0")
	e = goldenReject(e, "svc #(0.0)")
	e = goldenReject(e, "fmov d0, #1.50000000000000000001")
	e = goldenReject(e, "fmov d0, #1e-400")
	e = goldenReject(e, "fmov d0, #1.0e")
	e = goldenReject(e, "fmov d0, #0x8000000000000000")
	e = goldenReject(e, "scvtf s0, w1, #0")
	e = goldenReject(e, "scvtf s0, w1, #33")
	e = goldenReject(e, "ucvtf d0, w1, #33")
	e = goldenReject(e, "scvtf s0, x1, #0")
	e = goldenReject(e, "ucvtf d0, x1, #65")
	e = goldenReject(e, "dup.4s v0, w1")
	e = goldenReject(e, "umov.s w0, v1[1]")
	e = goldenReject(e, "ins.s v0[1], w1")
	e = goldenReject(e, "tbl.16b v0, {v1}, v3")
	e = goldenReject(e, "add.4s v0, v1, v2")
	e = goldenReject(e, "cmle.4s v0, v1, v2")
	e = goldenReject(e, "mov.16b v0, v1")
	e = goldenReject(e, "fadd.4s v0, v1, v2")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #8")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #-1")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #16")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #0x100000003")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #sym")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, sym")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #:lo12:sym")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, .")
	return e
}

// Architecture-extension instructions (RNG, MTE, SPE) that clang accepts only with the
// feature enabled; the words are clang's with `-march=armv8.5-a+rng` / `+memtag` /
// `armv8.2-a+profile`.  And the `0o17` octal spelling, which this lexer accepts
// alongside the GNU leading-zero form (`017`).
func TestGoldenFeatureGatedAndOctal() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "mrs x0, rndr", 0xD53B2400)
	e = goldenWord(e, "mrs x1, rndrrs", 0xD53B2421)
	e = goldenWord(e, "msr tco, #1", 0xD503419F)
	e = goldenWord(e, "mrs x0, tco", 0xD53B42E0)
	e = goldenWord(e, "msr tco, x2", 0xD51B42E2)
	e = goldenWord(e, "psb csync", 0xD503223F)
	e = goldenReject(e, "msr rndr, x0")
	e = goldenWord(e, "svc #0o17", 0xD40001E1)
	e = goldenWord(e, "svc #017", 0xD40001E1)
	e = goldenReject(e, "svc #019")
	return e
}
