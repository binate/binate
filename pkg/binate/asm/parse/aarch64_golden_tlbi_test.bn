// TLBI lines clang rejects: a register missing, or given to an operation without one (even
// xzr), or not an X register; an unknown operation, an nXS suffix on nothing or twice, a
// scope an operation lacks (no PAALLIS, no RPAIS); an operation name with a symbol tail or
// qualifier; and stray operands.
func TestGoldenTlbiRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "tlbi vae1")
	e = goldenReject(e, "tlbi vmalle1, x1")
	e = goldenReject(e, "tlbi vmalle1, xzr")
	e = goldenReject(e, "tlbi vae1, w1")
	e = goldenReject(e, "tlbi vae1, sp")
	e = goldenReject(e, "tlbi vae1, wzr")
	e = goldenReject(e, "tlbi vae1, #1")
	e = goldenReject(e, "tlbi #0, x1")
	e = goldenReject(e, "tlbi vae1, x1, x2")
	e = goldenReject(e, "tlbi foo, x1")
	e = goldenReject(e, "tlbi nxs")
	e = goldenReject(e, "tlbi vae1nxsnxs, x1")
	e = goldenReject(e, "tlbi vae1nx, x1")
	e = goldenReject(e, "tlbi vae1+4, x1")
	e = goldenReject(e, "tlbi vae1@PAGE, x1")
	e = goldenReject(e, "tlbi :got:vae1, x1")
	e = goldenReject(e, "tlbi")
	e = goldenReject(e, "tlbi paallis")
	e = goldenReject(e, "tlbi rpais, x1")
	e = goldenReject(e, "tlbi vae1 x1")
	e = goldenReject(e, "tlbi vae1, [x1]")
	e = goldenReject(e, "tlbi vae1, x1 junk")
	return e
}
