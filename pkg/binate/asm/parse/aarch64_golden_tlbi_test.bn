package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests for TLBI: every operation clang accepts (`clang -c -target arm64-apple-macos11
// -march=armv9.6-a+…`, with the TLB-range, outer-shareable, nXS and realm-management
// forms), each assembling to clang's word — with its register when the operation takes one
// — and the operand forms clang rejects.

// TLBI operations clang accepts, chunk 0.
func TestGoldenTlbi0() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "tlbi alle1", 0xD50C879F)
	e = goldenWord(e, "tlbi alle1is", 0xD50C839F)
	e = goldenWord(e, "tlbi alle1isnxs", 0xD50C939F)
	e = goldenWord(e, "tlbi ALLE1NXS", 0xD50C979F)
