package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// The AArch64 GOT-slot transfers: an 8-byte load / store of a slot at its page offset
// (`:got_lo12:`, `@GOTPAGEOFF`) or at its offset from the GOT's page (`:gotpage_lo15:`),
// and a literal load of a slot (`:got:`).

// emitA64GotSlot emits the transfer spec (Rt rt) of a GOT slot at ad, an ADDR_GOT_LO12 or
// ADDR_GOTPAGE_LO15 address: an LDR / STR of X or D, or PRFM, as clang takes them — a slot
// is 8 bytes, so no other access scales for its page offset — with no addend; on Mach-O only
// the LDR of X, which is all ld64 links a GOT slot's page offset (GOT_LOAD_PAGEOFF12) on
// wherever the symbol is defined: it refuses a store or a prefetch ("relocation on
// non-LDR/ADD instruction"), and an LDR of a D register when it elides the slot of a symbol
// the image defines (a fixup error), all of which clang assembles.  clang writes a
// GOT-slot reference with an addend on ELF as a relocation against the symbol with that
// addend, but linkers disagree on what it means: the ABI text (and bnld, for an object that
// has one) the slot of S + A, GNU ld the symbol's own slot (the addend dropped), lld the
// symbol's slot address plus A (a neighbouring slot) — so the source would not say what it
// links to; and Mach-O has no form for one (clang: "gotpage label reference not allowed an
// addend").
func emitA64GotSlot(p @Parser, spec uint32, rt int, ad a64Addr) {
	if !isa.GotSlotTransferOk(spec) {
		setErr(p, "a GOT slot's page offset needs an 8-byte ldr / str (an X or D register) or prfm")
		return
	}
	if p.Asm.ObjFormat == asm.OBJ_MACHO && ad.Mode == ADDR_GOT_LO12 && spec != isa.LS_LDR_X {
		setErr(p, "on Mach-O a GOT slot's page offset (@GOTPAGEOFF) takes only `ldr Xt`, all ld64 links")
		return
	}
	if ad.Addend != 0 {
		setErr(p, "a GOT-slot reference takes no addend")
		return
	}
	if ad.Mode == ADDR_GOTPAGE_LO15 {
		isa.LdStGotPageLo15(p.Asm, spec, rt, ad.Base, ad.Label)
	} else {
		isa.LdStGotLo12(p.Asm, spec, rt, ad.Base, ad.Label)
	}
}

// isA64QualifierStart reports whether tok (l just after it) starts a `:qual:` operand —
// `:` or `#:`.
func isA64QualifierStart(l Lexer, tok Token) bool {
	if tok.Kind == TOK_COLON { return true }
	if tok.Kind != TOK_HASH { return false }
	_, next := LexNext(l)
	return next.Kind == TOK_COLON
}

// parseA64GotLiteral parses the `:got:sym` / `#:got:sym` operand of a literal load (tok
// its `:` or `#`, l just after it) for transfer spec and Rt rt, and emits the literal load
// of the symbol's GOT slot — or, `:gottprel:sym`, of its GOT slot of its thread-pointer
// offset.  No other qualifier names a literal: clang reads `:got_lo12:` and `:gotpage_lo15:`
// there as `:got:`, and `:gottprel_lo12:` and the `:gottprel_g*:` ones as `:gottprel:`, and
// drops `:lo12:`, `:tlsdesc:` and the rest, loading from the plain symbol — rejected here, as is
// a number (clang relocates `:got:5` against an absolute 5) and an addend (as on every GOT-slot
// reference).
func parseA64GotLiteral(p @Parser, l Lexer, tok Token, spec uint32, rt int,
		unscaledOnly bool) (Lexer, Token) {
	if unscaledOnly || !hasLiteralForm(spec) {
		setErr(p, "this load/store has no PC-relative literal form")
		return l, tok
	}
	if tok.Kind == TOK_HASH { l, tok = LexNext(l) } // the ':'
	var it a64Item
	var ok bool = false
	l, tok, it, ok = parseQualifiedItem(p, l)
	if !ok { return l, tok }
	var tlsSlot bool = it.Kind == IT_LABEL && it.Spec == isa.FIX_TLSIE_ADR_GOTTPREL_PAGE21
	if !tlsSlot && (it.Kind != IT_LABEL || it.Spec != SPEC_GOTPAGE) {
		setErr(p,
				"a literal load takes only `:got:sym` or `:gottprel:sym` (a GOT slot) after a qualifier")
		return l, tok
	}
	if it.Imm != 0 {
		setErr(p, "a GOT-slot reference takes no addend")
		return l, tok
	}
	if !a64AtEOL(p, tok) { return l, tok }
	if tlsSlot {
		isa.LdStLiteralTls(p.Asm, spec, rt, it.Label)
		return l, tok
	}
	isa.LdStLiteralGot(p.Asm, spec, rt, it.Label)
	return l, tok
}
