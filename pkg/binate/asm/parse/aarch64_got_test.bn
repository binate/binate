package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// The GOT-slot transfers against clang's words and relocations (`clang -c -target
// aarch64-linux-gnu`).  (relocOpCase is in aarch64_relocop_test.bn, labelsReject in
// aarch64_golden_labels_test.bn.)

// gotRelocs renders, as relocOps does, a relocation of fixup kind against each of syms, at
// offsets 4 * first, 4 * (first + 1), …
func gotRelocs(kind int, syms @[]*[]readonly char, first int) @[]char {
	var out @[]char = ""
	for i := 0; i < len(syms); i++ {
		var one @[]char = buf.Concat(strconv.Itoa(kind), "@")
		one = buf.Concat(one, strconv.Itoa(4 * (first + i)))
		one = buf.Concat(one, ":")
		out = buf.Concat(out, buf.Concat(buf.Concat(one, syms[i]), " "))
	}
	return out
}

// `:got_lo12:` and `:gotpage_lo15:` on every 8-byte transfer clang takes — LDR / STR of X
// and D, PRFM — with `#` or without, any case, SP as the base, and a local symbol or a
// temporary label (a GOT reference names the label itself, as clang's does).
func TestGotSlotTransfers() testing.TestResult {
	var e @[]char = ""
	var lo12 @[]*[]readonly char = make_slice(*[]readonly char, 5)
	for i := 0; i < 5; i++ { lo12[i] = "sym" }
	var lo15 @[]*[]readonly char = make_slice(*[]readonly char, 7)
	for i := 0; i < 5; i++ { lo15[i] = "sym" }
	lo15[5] = "f"
	lo15[6] = ".Lq"
	var want @[]char = buf.Concat(gotRelocs(isa.FIX_LD_GOT_LO12, lo12, 0),
			gotRelocs(isa.FIX_LD_GOTPAGE_LO15, lo15, 5))
	e = relocOpCase(e,
			".global sym\nf:\nldr x0, [x1, :got_lo12:sym]\nstr x2, [x3, #:got_lo12:sym]\n"
					"ldr d4, [x5, :got_lo12:sym]\nstr d6, [sp, :got_lo12:sym]\n"
					"prfm pldl1keep, [x7, :got_lo12:sym]\nldr x8, [x9, :gotpage_lo15:sym]\n"
					"str x10, [x11, #:gotpage_lo15:sym]\nldr d12, [x13, :GOTPAGE_LO15:sym]\n"
					"str d14, [x15, :gotpage_lo15:sym]\nprfm pstl2strm, [x16, :gotpage_lo15:sym]\n"
					"ldr x17, [x18, :gotpage_lo15:f]\nldr x19, [x20, :gotpage_lo15:.Lq]\n.Lq: nop",
			"F9400020 F9000062 FD4000A4 FD0003E6 F98000E0 F9400128 F900016A FD4001AC FD0001EE "
					"F9800213 F9400251 F9400293 D503201F ",
			want)
	return e
}

// A `:got:` literal load on every literal form — LDR of W / X / S / D / Q, LDRSW, PRFM —
// with `#` or without, any case, a parenthesized symbol; and, deliberately where clang
// differs, a local symbol in the same section is a relocation too (clang resolves `ldr
// x0, :got:f` into a literal load of f's own bytes, as if `:got:` were not there).
func TestGotLiteralLoads() testing.TestResult {
	var e @[]char = ""
	var syms @[]*[]readonly char = make_slice(*[]readonly char, 10)
	for i := 0; i < 9; i++ { syms[i] = "sym" }
	syms[9] = "f"
	e = relocOpCase(e,
			".global sym\nf:\nldr x0, :got:sym\nldr w1, #:got:sym\nldr s2, :got:sym\nldr d3, :got:sym\n"
					"ldr q4, :got:sym\nldrsw x5, :got:sym\nprfm pldl1keep, :got:sym\nldr x6, :GOT:sym\n"
					"ldr x7, :got:(sym)\nldr x8, :got:f",
			"58000000 18000001 1C000002 5C000003 9C000004 98000005 D8000000 58000006 58000007 "
					"58000008 ",
			gotRelocs(isa.FIX_LD_GOT_PREL19, syms, 0))
	return e
}

// Rejected as clang rejects them: a GOT slot's page offset on a transfer of other than 8
// bytes, an unscaled, pair or writeback form; a `:got:` literal on a store or a byte load;
// `:gotpage_lo15:` on ADD or ADRP.  Deliberately, where clang accepts: an addend on any
// GOT-slot reference (Mach-O has no form for one); `:got_lo12:` / `:gotpage_lo15:` on a
// literal load (clang reads them as `:got:`), `:lo12:` or a MOVW operator there (clang
// drops it); a number after `:got:`.
func TestGotRejects() testing.TestResult {
	var e @[]char = ""
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 21)
	bad[0] = "ldr w0, [x1, :gotpage_lo15:sym]"
	bad[1] = "ldr q0, [x1, :gotpage_lo15:sym]"
	bad[2] = "ldrb w0, [x1, :got_lo12:sym]"
	bad[3] = "ldrsw x0, [x1, :gotpage_lo15:sym]"
	bad[4] = "ldur x0, [x1, :got_lo12:sym]"
	bad[5] = "ldp x0, x1, [x2, :gotpage_lo15:sym]"
	bad[6] = "ldr x0, [x1, :gotpage_lo15:sym]!"
	bad[7] = "str x0, :got:sym"
	bad[8] = "ldrb w0, :got:sym"
	bad[9] = "ldr x0, :got:sym+8"
	bad[10] = "ldr x0, [x1, :gotpage_lo15:sym+8]"
	bad[11] = "str x0, [x1, :got_lo12:sym-8]"
	bad[12] = "ldr x0, :got_lo12:sym"
	bad[13] = "ldr x0, :gotpage_lo15:sym"
	bad[14] = "ldr x0, :lo12:sym"
	bad[15] = "ldr x0, :got:5"
	bad[16] = "ldr x0, #:abs_g0:sym"
	bad[17] = "add x0, x1, :gotpage_lo15:sym"
	bad[18] = "adrp x0, :gotpage_lo15:sym"
	bad[19] = "ldrh w0, [x1, :got_lo12:sym]"
	bad[20] = "str w0, [x1, :got_lo12:sym]"
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global sym\n", bad[i])) }
	return e
}
