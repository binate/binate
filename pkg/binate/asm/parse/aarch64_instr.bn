package "pkg/binate/asm/parse"

// parseAarch64Instruction parses an AArch64 mnemonic and its operands,
// then emits the instruction via the aarch64 encoding package.
func parseAarch64Instruction(p @Parser, l Lexer, mnemTok Token) {
	// bnlint:allow managed-to-raw-assign - mnemTok is a live token; Text outlives the read
	var mnem *[]readonly char = mnemTok.Text
	var ord a64Ordered = a64OrderedOf(mnem)
	if ord.Kind != ORD_NONE {
		var oTok Token
		l, oTok = parseA64Ordered(p, l, ord)
		expectA64EOL(p, oTok)
		return
	}
	var atom a64Atomic = a64AtomicOf(mnem)
	if atom.Kind != AT_NONE {
		var aTok Token
		l, aTok = parseA64Atomic(p, l, atom)
		expectA64EOL(p, aTok)
		return
	}
	if isA64LdStSpecial(mnem) {
		var sTok Token
		l, sTok = parseA64LdStSpecial(p, l, mnem)
		expectA64EOL(p, sTok)
		return
	}
	if isA64LdSt(mnem) {
		var lsTok Token
		l, lsTok = parseA64LdSt(p, l, mnem)
		expectA64EOL(p, lsTok)
		return
	}
	if emitA64DP(p, l, mnem) { return }
	if emitA64DPExtra(p, l, mnem) { return }
	if emitA64FP(p, l, mnem) { return }
	if emitA64FPInt(p, l, mnem) { return }
	if emitA64SimdCopy(p, l, mnem) { return }
	if emitA64SimdTable(p, l, mnem) { return }
	if emitA64Simd3(p, l, mnem) { return }
	if emitA64SimdFP3(p, l, mnem) { return }
	if emitA64Simd3Extra(p, l, mnem) { return }
	if emitA64SimdFPExtra(p, l, mnem) { return }
	if emitA64SimdFP8(p, l, mnem) { return }
	if emitA64Simd3Diff(p, l, mnem) { return }
	if emitA64Simd2Misc(p, l, mnem) { return }
	if emitA64SimdFP2(p, l, mnem) { return }
	if parseA64Ctrl(p, l, mnemTok) { return }
	setErr(p, "unknown instruction")
}
