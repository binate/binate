package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 LSE atomics: LD<op> / ST<op> (op ADD, CLR, EOR, SET, SMAX, SMIN, UMAX,
// UMIN), SWP, CAS and CASP, each with its ordering suffix — A (acquire), AL, or L
// (release); ST<op> takes only L — and, except CASP, a B / H size suffix.  The
// address is a bare `[Xn|SP]`: clang rejects even `#0`, though the Arm syntax allows
// it for CAS / CASP.

// Kinds of atomic mnemonic (a64Atomic.Kind).
const (
	AT_NONE int = iota
	AT_OP              // isa.AtomicOp:        `ld<op>|swp{a|al|l}{b|h} Rs, Rt, [Xn|SP]`
	AT_ST              // isa.AtomicOp, Rt=ZR: `st<op>{l}{b|h} Rs, [Xn|SP]`
	AT_CAS             // isa.CompareSwap:     `cas{a|al|l}{b|h} Rs, Rt, [Xn|SP]`
	AT_CASP            // isa.CompareSwapPair: `casp{a|al|l} Rs, Rs+1, Rt, Rt+1, [Xn|SP]`
)

// a64Atomic describes an atomic mnemonic: its kind, the AMO_* op of an LD<op> /
// ST<op> / SWP, its ordering, and its size suffix (0 = B, 1 = H, -1 = none: the
// registers' width then sets the size).
type a64Atomic struct {
	Kind    int
	Op      uint32
	Acquire bool
	Release bool
	Size    int
}

// prefixIs reports whether s starts with the lowercase literal lit, ignoring case.
func prefixIs(s *[]readonly char, lit *[]readonly char) bool {
	return len(s) >= len(lit) && nameIs(s[0:len(lit)], lit)
}

// atomicOpPrefix maps the LD<op> / ST<op> operation name at the start of s to its
// AMO_* op and the name's length, or (0, 0).
func atomicOpPrefix(s *[]readonly char) (uint32, int) {
	if prefixIs(s, "smax") { return isa.AMO_SMAX, 4 }
	if prefixIs(s, "smin") { return isa.AMO_SMIN, 4 }
	if prefixIs(s, "umax") { return isa.AMO_UMAX, 4 }
	if prefixIs(s, "umin") { return isa.AMO_UMIN, 4 }
	if prefixIs(s, "add") { return isa.AMO_ADD, 3 }
	if prefixIs(s, "clr") { return isa.AMO_CLR, 3 }
	if prefixIs(s, "eor") { return isa.AMO_EOR, 3 }
	if prefixIs(s, "set") { return isa.AMO_SET, 3 }
	return 0, 0
}

// atomicSuffix parses s as an ordering suffix ("", a, al or l) followed by a size
// suffix ("", b or h), returning the ordering, the size (-1 when absent), and whether
// the two make up all of s.
func atomicSuffix(s *[]readonly char) (bool, bool, int, bool) {
	var i int = 0
	var acq bool = false
	var rel bool = false
	if i < len(s) && lowerChar(s[i]) == 'a' {
		acq = true
		i = i + 1
		if i < len(s) && lowerChar(s[i]) == 'l' {
			rel = true
			i = i + 1
		}
	} else if i < len(s) && lowerChar(s[i]) == 'l' {
		rel = true
		i = i + 1
	}
	var size int = -1
	if i < len(s) && (lowerChar(s[i]) == 'b' || lowerChar(s[i]) == 'h') {
		size = 0
		if lowerChar(s[i]) == 'h' { size = 1 }
		i = i + 1
	}
	return acq, rel, size, i == len(s)
}

// a64AtomicOf classifies mnem (Kind AT_NONE when it is not an atomic).
func a64AtomicOf(mnem *[]readonly char) a64Atomic {
	var at a64Atomic
	at.Size = -1
	var none a64Atomic
	var rest *[]readonly char = ""
	if prefixIs(mnem, "casp") {
		at.Kind = AT_CASP
		rest = mnem[4:len(mnem)]
	} else if prefixIs(mnem, "cas") {
		at.Kind = AT_CAS
		rest = mnem[3:len(mnem)]
	} else if prefixIs(mnem, "swp") {
		at.Kind = AT_OP
		at.Op = isa.AMO_SWP
		rest = mnem[3:len(mnem)]
	} else if prefixIs(mnem, "ld") || prefixIs(mnem, "st") {
		var n int = 0
		at.Op, n = atomicOpPrefix(mnem[2:len(mnem)])
		if n == 0 { return none }
		at.Kind = AT_OP
		if prefixIs(mnem, "st") { at.Kind = AT_ST }
		rest = mnem[2 + n:len(mnem)]
	} else {
		return none
	}
	var ok bool = false
	at.Acquire, at.Release, at.Size, ok = atomicSuffix(rest)
	if !ok { return none }
	if at.Kind == AT_CASP && at.Size >= 0 { return none }
	if at.Kind == AT_ST && at.Acquire { return none }
	return at
}

// atomicWidth reports the access size of registers all of class cls under size
// suffix sizeSuffix: a B / H suffix takes W registers, no suffix W (size 2) or X (3);
// -1 for any other register.
func atomicWidth(sizeSuffix int, cls int) int {
	if sizeSuffix >= 0 {
		if rcIsW(cls) { return sizeSuffix }
		return -1
	}
	if rcIsW(cls) { return 2 }
	if rcIsX(cls) { return 3 }
	return -1
}

// parseA64Atomic parses and emits one atomic at; l is positioned just after the
// mnemonic.  Returns the lexer and the token after the last operand for the caller's
// end-of-line check.
func parseA64Atomic(p @Parser, l Lexer, at a64Atomic) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	var nregs int = 2
	if at.Kind == AT_ST { nregs = 1 }
	if at.Kind == AT_CASP { nregs = 4 }
	var regs @[]int = make_slice(int, 4)
	var cls0 int = RC_NONE
	var ok bool = true
	for i := 0; i < nregs; i++ {
		var cls int = RC_NONE
		l, tok, regs[i], cls, ok = a64RegComma(p, l, tok)
		if !ok { return l, tok }
		if i == 0 { cls0 = cls }
		if atomicWidth(at.Size, cls) < 0 || rcIsW(cls) != rcIsW(cls0) {
			setErr(p, "atomic registers must all be W, or all X (W for a B / H form)")
			return l, tok
		}
	}
	var size int = atomicWidth(at.Size, cls0)
	var ad a64Addr
	l, tok, ad, ok = parseA64Addr(p, l, tok)
	if !ok { return l, tok }
	if ad.Mode != ADDR_BASE {
		setErr(p, "atomic instructions take only a bare [Xn|SP] address")
		return l, tok
	}
	if at.Kind == AT_CASP {
		if (regs[0] & 1) != 0 || (regs[2] & 1) != 0 {
			setErr(p, "expected first even register of a consecutive same-size even/odd register pair")
			return l, tok
		}
		if regs[1] != regs[0] + 1 || regs[3] != regs[2] + 1 {
			setErr(p, "expected second odd register of a consecutive same-size even/odd register pair")
			return l, tok
		}
		isa.CompareSwapPair(p.Asm, size == 3, at.Acquire, at.Release, regs[0], regs[2], ad.Base)
		return l, tok
	}
	if at.Kind == AT_CAS {
		isa.CompareSwap(p.Asm, size, at.Acquire, at.Release, regs[0], regs[1], ad.Base)
		return l, tok
	}
	var rt int = 31
	if at.Kind == AT_OP { rt = regs[1] }
	isa.AtomicOp(p.Asm, at.Op, size, at.Acquire, at.Release, regs[0], rt, ad.Base)
	return l, tok
}
