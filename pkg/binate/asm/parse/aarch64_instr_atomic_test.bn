package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the LSE atomics — every LD<op> / ST<op> / SWP / CAS ordering and
// size, and CASP — from clang (`clang -c -target aarch64-linux-gnu -march=armv8.1-a`),
// objdump'd.

func TestGoldenAtomics1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldaddb w0, w1, [x2]", 0x38200041)
	e = goldenWord(e, "ldaddh w0, w1, [x2]", 0x78200041)
	e = goldenWord(e, "ldadd w0, w1, [x2]", 0xB8200041)
