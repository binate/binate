// Register choices clang accepts: overlapping registers (no LSE form constrains them),
// the zero register and SP, CASP's x30 / xzr pair, and an upper-case mnemonic.
func TestGoldenAtomicsEdges() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldadd w0, w0, [x2]", 0xB8200040)
	e = goldenWord(e, "ldadd x0, x1, [x0]", 0xF8200001)
	e = goldenWord(e, "ldadd x1, x0, [x0]", 0xF8210000)
	e = goldenWord(e, "ldadd xzr, xzr, [sp]", 0xF83F03FF)
	e = goldenWord(e, "stadd x0, [sp]", 0xF82003FF)
	e = goldenWord(e, "stadd xzr, [x1]", 0xF83F003F)
	e = goldenWord(e, "swp x0, x0, [x0]", 0xF8208000)
	e = goldenWord(e, "cas x0, x0, [x0]", 0xC8A07C00)
	e = goldenWord(e, "casp x0, x1, x0, x1, [x0]", 0x48207C00)
	e = goldenWord(e, "casp x30, xzr, x2, x3, [x4]", 0x483E7C82)
	e = goldenWord(e, "casp x0, x1, x30, xzr, [x4]", 0x48207C9E)
	e = goldenWord(e, "LDADDAL X0, X1, [SP]", 0xF8E003E1)
	return e
}

// Rejected as clang rejects them: mixed or wrong-size registers, any address but a
// bare base, an ordering or size suffix the mnemonic lacks (ST<op> takes no A; CASP
// no B / H), a CASP pair that is not an even register and its successor, SP or WSP
// where a data or base register belongs.
func TestGoldenAtomicsRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ldadd w0, x1, [x2]")
	e = goldenReject(e, "ldaddb x0, x1, [x2]")
	e = goldenReject(e, "ldadd x0, x1, [x2, #0]")
	e = goldenReject(e, "ldadd x0, x1, [x2, #8]")
	e = goldenReject(e, "ldadd x0, x1, [x2], #8")
	e = goldenReject(e, "stadda x0, [x1]")
	e = goldenReject(e, "staddal x0, [x1]")
	e = goldenReject(e, "stadd x0, [x1, #0]")
	e = goldenReject(e, "cas w0, x1, [x2]")
	e = goldenReject(e, "casb x0, x1, [x2]")
	e = goldenReject(e, "casp x1, x2, x4, x5, [x6]")
	e = goldenReject(e, "casp x0, x1, x3, x4, [x6]")
	e = goldenReject(e, "casp x0, x2, x4, x5, [x6]")
	e = goldenReject(e, "casp x0, x1, x4, x6, [x6]")
	e = goldenReject(e, "casp w0, w1, x2, x3, [x4]")
	e = goldenReject(e, "caspb w0, w1, w2, w3, [x4]")
	e = goldenReject(e, "casp x0, x1, x2, x3, [x4, #0]")
	e = goldenReject(e, "ldadd x0, x1, [wsp]")
	e = goldenReject(e, "ldadd sp, x1, [x2]")
	e = goldenReject(e, "ldadd x0, x1")
	e = goldenReject(e, "ldadd x0, x1, [x2] x3")
	e = goldenReject(e, "ldaddlal x0, x1, [x2]")
	e = goldenReject(e, "swpbh w0, w1, [x2]")
	e = goldenReject(e, "ldadd x0, x1, [x2]!")
	e = goldenReject(e, "ldadd x0, x1, [x31]")
	e = goldenReject(e, "ldadd s0, s1, [x2]")
	e = goldenReject(e, "casb b0, b1, [x2]")
	return e
}

// Later-extension lookalikes (FEAT_LSE128, FEAT_LSUI) that are not LSE mnemonics:
// the atomic dispatch must not take them for one.
func TestGoldenAtomicsLookalikes() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ldclrp x0, x1, [x2]")
	e = goldenReject(e, "swpp x0, x1, [x2]")
	e = goldenReject(e, "ldsetpa x0, x1, [x2]")
	e = goldenReject(e, "caspt x0, x1, x2, x3, [x4]")
	e = goldenReject(e, "cast x0, x1, [x2]")
	e = goldenReject(e, "ldtadd w0, w1, [x2]")
	e = goldenReject(e, "swpt w0, w1, [x2]")
	return e
}

// x31 / w31 name the zero register, and fp / lr x29 / x30, in every atomic operand.
func TestGoldenAtomicsRegisterSpellings() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldaddh w30, w29, [x28]", 0x783E039D)
	e = goldenWord(e, "cas x31, x30, [x28]", 0xC8BF7F9E)
	e = goldenWord(e, "casp x28, fp, lr, xzr, [lr]", 0x483C7FDE)
	e = goldenWord(e, "casp w0, w1, w30, w31, [sp]", 0x08207FFE)
	e = goldenWord(e, "staddlh w30, [sp]", 0x787E03FF)
	e = goldenWord(e, "CASPAL X0, X1, X2, X3, [SP]", 0x4860FFE2)
	return e
}
