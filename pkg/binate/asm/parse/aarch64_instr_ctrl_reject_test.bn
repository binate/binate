package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF — with the needed -march extensions — where Mach-O rejects
// the syntax or an undefined local label), or — where clang rejects it — is rejected.
// A label target is left unresolved (its offset field zero) on both sides.

// Branch / system lines clang rejects, chunk 0.
func TestGoldenCtrlRejects0() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "@ comment")
	e = goldenReject(e, "add x0, x0, #:got_lo12:ext")
	e = goldenReject(e, "add x0, x0, #:lo12:ext junk")
	e = goldenReject(e, "add x0, x0, #:lo12_nc:ext")
	e = goldenReject(e, "add x0, x0, Ltgt")
	e = goldenReject(e, "add x0, x1, #1 junk")
	e = goldenReject(e, "add xzr, x0, #1")
	e = goldenReject(e, "adds x0, x1, #0x1001")
	e = goldenReject(e, "adr sp, Ltgt")
	e = goldenReject(e, "adr w0, Ltgt")
	e = goldenReject(e, "adr x0")
	e = goldenReject(e, "adr x0, #1048576")
	e = goldenReject(e, "adr x0, Ltgt junk")
	e = goldenReject(e, "adr x0, Ltgt, x1")
	e = goldenReject(e, "adrp sp, ext")
	e = goldenReject(e, "adrp sp, ext@PAGE")
	e = goldenReject(e, "adrp w0, ext")
	e = goldenReject(e, "adrp w0, ext@PAGE")
	e = goldenReject(e, "adrp x0, #4097")
	e = goldenReject(e, "adrp x0, :got:ext junk")
	e = goldenReject(e, "adrp x0, :got:ext@PAGE")
	e = goldenReject(e, "adrp x0, :pg_hi21:ext")
	e = goldenReject(e, "adrp x0, ext junk")
	e = goldenReject(e, "adrp x0, ext, x1")
	e = goldenReject(e, "adrp x0, ext@GOTPAGE+8")
	e = goldenReject(e, "adrp x0, ext@PAGE junk")
	e = goldenReject(e, "adrp x0, ext@PAGE, x1")
	e = goldenReject(e, "asr x0, x1, #-1")
	e = goldenReject(e, "b")
	e = goldenReject(e, "b #0x8000000")
	e = goldenReject(e, "b #6")
	e = goldenReject(e, "b . eq Ltgt")
	e = goldenReject(e, "b Ltgt junk")
	e = goldenReject(e, "b Ltgt*2")
	e = goldenReject(e, "b Ltgt, x0")
	e = goldenReject(e, "b x0")
	e = goldenReject(e, "b. eq Ltgt")
	e = goldenReject(e, "b.eq")
	e = goldenReject(e, "b.eq Ltgt junk")
	e = goldenReject(e, "b.eq Ltgt, x1")
	e = goldenReject(e, "b.eqx Ltgt")
	e = goldenReject(e, "b.xx Ltgt")
	e = goldenReject(e, "bc.eq Ltgt")
	e = goldenReject(e, "bl")
	e = goldenReject(e, "bl ext junk")
	e = goldenReject(e, "bl x0")
	e = goldenReject(e, "blr")
	e = goldenReject(e, "blr Ltgt")
	e = goldenReject(e, "blr sp")
	e = goldenReject(e, "blr w8")
	e = goldenReject(e, "blr x8 junk")
	e = goldenReject(e, "blr x8, x9")
	e = goldenReject(e, "bogus x0, x1, x2, x3")
	e = goldenReject(e, "br")
	e = goldenReject(e, "br #0")
	e = goldenReject(e, "br Ltgt")
	e = goldenReject(e, "br sp")
	e = goldenReject(e, "br w0")
	e = goldenReject(e, "br wzr")
	e = goldenReject(e, "br x0 junk")
	e = goldenReject(e, "br x0, #4")
	e = goldenReject(e, "br x0, x1")
	e = goldenReject(e, "braa x1, xzr")
	e = goldenReject(e, "brk")
	e = goldenReject(e, "brk #0x10000")
	e = goldenReject(e, "bti x")
	e = goldenReject(e, "cbnz sp, Ltgt")
	e = goldenReject(e, "cbz #1, Ltgt")
	e = goldenReject(e, "cbz sp, Ltgt")
	e = goldenReject(e, "cbz wsp, Ltgt")
	e = goldenReject(e, "cbz x0")
	e = goldenReject(e, "cbz x0 Ltgt")
	e = goldenReject(e, "cbz x0, #0x100000")
	e = goldenReject(e, "cbz x0, Ltgt junk")
	e = goldenReject(e, "cbz x0, Ltgt, x2")
	e = goldenReject(e, "cbz x0, x1")
	e = goldenReject(e, "clrex #16")
	e = goldenReject(e, "cmn w0, #0x1001")
	e = goldenReject(e, "cmp x0, #0x1001")
	e = goldenReject(e, "cmp x0, #1 junk")
	e = goldenReject(e, "cmp x0, x1, x2")
	e = goldenReject(e, "csel x0, x1, w2, eq")
	e = goldenReject(e, "csel x0, x1, x2, eq, x3")
	e = goldenReject(e, "dc zva")
	e = goldenReject(e, "dc zva x0")
	return e
}

// Branch / system lines clang rejects, chunk 1.
func TestGoldenCtrlRejects1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "dc zva, [x0]")
	e = goldenReject(e, "dc zva, sp")
	e = goldenReject(e, "dc zva, w0")
	e = goldenReject(e, "dc zva, x0 junk")
	e = goldenReject(e, "dc zva, x0, x1")
	e = goldenReject(e, "dmb")
	e = goldenReject(e, "dsb #17")
	e = goldenReject(e, "eor w0, w1, #0xffffffff")
	e = goldenReject(e, "eret x0")
	e = goldenReject(e, "foo")
	e = goldenReject(e, "foo #1")
	e = goldenReject(e, "foo x0")
	e = goldenReject(e, "foo x0, x1")
	e = goldenReject(e, "foo x0, x1, #1")
	e = goldenReject(e, "foo x0, x1, x2")
	e = goldenReject(e, "foo x0, x1, x2, x3")
	e = goldenReject(e, "hint #128")
	e = goldenReject(e, "ic iallu, x0")
	e = goldenReject(e, "ic ivau")
	e = goldenReject(e, "isb ish")
	e = goldenReject(e, "lsl x0, x1, Ltgt")
	e = goldenReject(e, "lsl x0, x1, x2, lsl #1")
	e = goldenReject(e, "lsr x0, x1, [x2]")
	e = goldenReject(e, "madd w0, w1, w2, x3")
	e = goldenReject(e, "madd x0, x1, x2, x3, x4")
	e = goldenReject(e, "mov w0, #0x12345")
	e = goldenReject(e, "mov x0, Ltgt")
	e = goldenReject(e, "mov x0, ext")
	e = goldenReject(e, "movz x0, #1, junk")
	e = goldenReject(e, "mrs sp, dczid_el0")
	e = goldenReject(e, "mrs w0, dczid_el0")
	e = goldenReject(e, "mrs w0, nzcv")
	e = goldenReject(e, "mrs x0")
	e = goldenReject(e, "mrs x0, #3")
	e = goldenReject(e, "mrs x0, dczid_el0 junk")
	e = goldenReject(e, "mrs x0, dczid_el0, x1")
	e = goldenReject(e, "mrs x5 dczid_el0")
	e = goldenReject(e, "msr daifset, #16")
	e = goldenReject(e, "msr dczid_el0, x0")
	e = goldenReject(e, "msr nzcv, sp")
	e = goldenReject(e, "mul w0, x1, w2")
	e = goldenReject(e, "mul x0, x1, #3")
	e = goldenReject(e, "mul x0, x1, Ltgt")
	e = goldenReject(e, "mul x0, x1, x2 junk")
	e = goldenReject(e, "mul x0, x1, x2, lsl #1")
	e = goldenReject(e, "nop #1")
	e = goldenReject(e, "nop junk")
	e = goldenReject(e, "nop nop")
	e = goldenReject(e, "nop x0")
	e = goldenReject(e, "nop, x0")
	e = goldenReject(e, "orr x0, sp, x1")
	e = goldenReject(e, "orr x0, x1, #0")
	e = goldenReject(e, "ret #1")
	e = goldenReject(e, "ret , x0")
	e = goldenReject(e, "ret Ltgt")
	e = goldenReject(e, "ret Sp")
	e = goldenReject(e, "ret [x0]")
	e = goldenReject(e, "ret junk")
	e = goldenReject(e, "ret sp")
	e = goldenReject(e, "ret w0")
	e = goldenReject(e, "ret w30")
	e = goldenReject(e, "ret wzr")
	e = goldenReject(e, "ret x0 junk")
	e = goldenReject(e, "ret x0, x1")
	e = goldenReject(e, "ror x0, x1, x2, lsl #1")
	e = goldenReject(e, "sdiv x0, x1, #3")
	e = goldenReject(e, "sdiv x0, x1, w2")
	e = goldenReject(e, "sub sp, sp, #0x1010")
	e = goldenReject(e, "sub x0, x1, #0x1000000")
	e = goldenReject(e, "sub x0, x1, ext@PAGEOFF")
	e = goldenReject(e, "subs x0, x1, #0x12345")
	e = goldenReject(e, "svc")
	e = goldenReject(e, "svc #$")
	e = goldenReject(e, "svc #(1")
	e = goldenReject(e, "svc #-1")
	e = goldenReject(e, "svc #0 junk")
	e = goldenReject(e, "svc #0, x0")
	e = goldenReject(e, "svc #08")
	e = goldenReject(e, "svc #0x10000")
	e = goldenReject(e, "svc #0x12345")
	e = goldenReject(e, "svc #4/0")
	e = goldenReject(e, "svc #65535+1")
	e = goldenReject(e, "svc #Ltgt")
	e = goldenReject(e, "svc x0")
	e = goldenReject(e, "sys #3, c16, c5, #1")
	e = goldenReject(e, "sys #8, c7, c5, #1")
	e = goldenReject(e, "tbnz w3, #40, Ltgt")
	e = goldenReject(e, "tbnz x0, #65, Ltgt")
	e = goldenReject(e, "tbnz x0, #96, Ltgt")
	e = goldenReject(e, "tbz sp, #1, Ltgt")
	e = goldenReject(e, "tbz w0, #32, Ltgt")
	e = goldenReject(e, "tbz w0, #63, Ltgt")
	e = goldenReject(e, "tbz x0, #-1, Ltgt")
	e = goldenReject(e, "tbz x0, #1")
	e = goldenReject(e, "tbz x0, #1 Ltgt")
	e = goldenReject(e, "tbz x0, #1, Ltgt junk")
	e = goldenReject(e, "tbz x0, #1, Ltgt, x1")
	e = goldenReject(e, "tbz x0, #1, x3")
	return e
}

// Branch / system lines clang rejects, chunk 2.
func TestGoldenCtrlRejects2() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "tbz x0, #64, Ltgt")
	e = goldenReject(e, "udiv w0, w1, w2, lsl #2")
	e = goldenReject(e, "yield x0")
	return e
}

// Branch / system sources of several lines — a label defined twice, a branch to an
// odd byte offset (B and CBZ reach whole instructions only), a constant used before its
// definition (for now any reference to a constant is rejected), a statement split by a
// comment that spans lines, directly or through a second one — that clang rejects (the
// data written `.byte` for clang).
func TestGoldenCtrlSourceRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenSourceReject(e, "Lx:\nLx:")
	e = goldenSourceReject(e, "b Lodd\n.uint8 1\nLodd:\n.uint8 1, 2, 3")
	e = goldenSourceReject(e, "cbz x0, Lodd\n.uint8 1\nLodd:\n.uint8 1, 2, 3")
	e = goldenSourceReject(e, "svc #Kc2\nKc2 = 3")
	e = goldenSourceReject(e, "nop /* multi\n still */ nop")
	e = goldenSourceReject(e, "nop /* a\n */ /* b\n */ nop")
	return e
}
