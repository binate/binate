package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF — with the needed -march extensions — where Mach-O rejects
// the syntax or an undefined local label), or — where clang rejects it — is rejected.
// A label target is left unresolved (its offset field zero) on both sides.

// Branch / system lines clang accepts, chunk 0.
func TestGoldenCtrlAccepts0() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ADR X3, Ltgt", 0x10000003)
	e = goldenWord(e, "B Ltgt", 0x14000000)
	e = goldenWord(e, "B.EQ Ltgt", 0x54000000)
	e = goldenWord(e, "B.eq Ltgt", 0x54000000)
	e = goldenWord(e, "BLR X17", 0xD63F0220)
	e = goldenWord(e, "BR X16", 0xD61F0200)
	e = goldenWord(e, "Bl ext", 0x94000000)
	e = goldenWord(e, "CBZ X0, Ltgt", 0xB4000000)
	e = goldenWord(e, "DC ZVA, X0", 0xD50B7420)
	e = goldenWord(e, "Lfoo : nop", 0xD503201F)
	e = goldenWord(e, "Lfoo: Lbar: nop", 0xD503201F)
	e = goldenWord(e, "Lfoo: nop", 0xD503201F)
	e = goldenWord(e, "Lz: ret", 0xD65F03C0)
