	e = goldenWord(e, "sys #3, c7, c4, #1, x0", 0xD50B7420)
	e = goldenWord(e, "sys #3, c7, c5, #1, x0", 0xD50B7520)
	e = goldenWord(e, "sysl x0, #0, c0, c0, #0", 0xD5280000)
	e = goldenWord(e, "sysl x0, #3, c7, c5, #1", 0xD52B7520)
	e = goldenWord(e, "tbnz w0, #3, ext+4", 0x37180000)
	e = goldenWord(e, "tbnz x0, #0x3f, Ltgt", 0xB7F80000)
	e = goldenWord(e, "tbnz x1, #40, Ltgt", 0xB7400001)
	e = goldenWord(e, "tbnz x3, #5, Ltgt", 0x37280003)
	e = goldenWord(e, "tbz w0, #31, Ltgt", 0x36F80000)
	e = goldenWord(e, "tbz x0, #(1+2), Ltgt", 0x36180000)
	e = goldenWord(e, "tbz x0, #0, Ltgt", 0x36000000)
	e = goldenWord(e, "tbz x0, #1, #8", 0x36080040)
	e = goldenWord(e, "tbz x0, #1, Lback", 0x36080000)
	e = goldenWord(e, "tbz x0, #1, Ltgt+4", 0x36080000)
	e = goldenWord(e, "tbz x0, #3, ext", 0x36180000)
	e = goldenWord(e, "tbz x0, #31, Ltgt", 0x36F80000)
	e = goldenWord(e, "tbz x0, #32, Ltgt", 0xB6000000)
	e = goldenWord(e, "tbz x0, #63, #8", 0xB6F80040)
	e = goldenWord(e, "tbz x0, #63, Ltgt", 0xB6F80000)
	e = goldenWord(e, "tbz x0, 1, Ltgt", 0x36080000)
	e = goldenWord(e, "tbz x9, #3, Ltgt-4", 0x36180009)
	e = goldenWord(e, "tbz xzr, #1, Ltgt", 0x3608001F)
	e = goldenWord(e, "tsb csync", 0xD503225F)
	e = goldenWord(e, "tst w0, #0xff", 0x72001C1F)
	e = goldenWord(e, "tst x0, x1, lsl #1", 0xEA01041F)
	e = goldenWord(e, "udf #0", 0x00000000)
	e = goldenWord(e, "udf #5", 0x00000005)
	e = goldenWord(e, "wfe", 0xD503205F)
	e = goldenWord(e, "wfi", 0xD503207F)
	e = goldenWord(e, "xpaclri", 0xD50320FF)
	e = goldenWord(e, "yield", 0xD503203F)
	return e
}

// Branch sources of several lines clang accepts: a label with a '.' in its name, a call
// to a label defined before it, and ADR to an odd byte offset (ADR reaches any byte) —
// the words from clang (the data written `.byte` for clang).
func TestGoldenCtrlSources() testing.TestResult {
	var e @[]char = ""
	e = goldenSourceWord(e, "Lfoo.bar:\nb Lfoo.bar", 0x14000000)
	e = goldenSourceWord(e, "_foo:\nbl _foo", 0x94000000)
	e = goldenSourceWord(e, "adr x0, Lodd\n.uint8 1\nLodd:\n.uint8 1, 2, 3", 0x30000020)
	return e
}
