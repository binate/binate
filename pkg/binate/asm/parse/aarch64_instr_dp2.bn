package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 data-processing instructions, part 2: shifts, extends, bitfield operations
// and their aliases, EXTR, multiply / divide, the one-source bit operations,
// conditional select / compare, and add/sub with carry — plus the family dispatcher.

// dpImmAt returns the immediate of item i, checked to lie in [lo, hi]; ok=false with
// p's error set otherwise.
func dpImmAt(p @Parser, its a64Items, i int, lo int, hi int, what *[]readonly char) (int, bool) {
	if i >= its.N || its.It[i].Kind != IT_IMM {
		setErr(p, "expected an immediate operand")
		return 0, false
	}
	var v int64 = its.It[i].Imm
	if v < cast(int64, lo) || v > cast(int64, hi) {
		setErr(p, what)
		return 0, false
	}
	return cast(int, v), true
}

// dpWidthBits returns 64 or 32 for sf.
func dpWidthBits(sf bool) int {
	if sf { return 64 }
	return 32
}

// dpShift emits lsl / lsr / asr / ror: with an immediate, the UBFM / SBFM / EXTR alias;
// with a register, LSLV / LSRV / ASRV / RORV.
func dpShift(p @Parser, mnem *[]readonly char, its a64Items) {
	if !dpExpectCount(p, its, 3) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = dpRegAt(p, its, 1, sf, false, true)
	if p.HasError { return }
	if its.It[2].Kind == IT_REG {
		var rm int = dpRegAt(p, its, 2, sf, false, true)
		if p.HasError { return }
		var op int = isa.D2_LSLV
		if mnemIs(mnem, "lsr") { op = isa.D2_LSRV }
		if mnemIs(mnem, "asr") { op = isa.D2_ASRV }
		if mnemIs(mnem, "ror") { op = isa.D2_RORV }
		isa.DataProc2(p.Asm, op, sf, rd, rn, rm)
		return
	}
	var w int = dpWidthBits(sf)
	sh, okI := dpImmAt(p, its, 2, 0, w - 1, "shift amount out of range for the register width")
	if !okI { return }
	if mnemIs(mnem, "lsl") {
		isa.Bitfield(p.Asm, isa.BF_UBFM, sf, rd, rn, (w - sh) % w, w - 1 - sh)
	} else if mnemIs(mnem, "lsr") {
		isa.Bitfield(p.Asm, isa.BF_UBFM, sf, rd, rn, sh, w - 1)
	} else if mnemIs(mnem, "asr") {
		isa.Bitfield(p.Asm, isa.BF_SBFM, sf, rd, rn, sh, w - 1)
	} else {
		isa.Extr(p.Asm, sf, rd, rn, rn, sh)
	}
}

// dpTwoSource emits `op Rd, Rn, Rm` for the register-only two-source forms:
// lslv / lsrv / asrv / rorv / udiv / sdiv.
func dpTwoSource(p @Parser, op int, its a64Items) {
	if !dpExpectCount(p, its, 3) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = dpRegAt(p, its, 1, sf, false, true)
	var rm int = dpRegAt(p, its, 2, sf, false, true)
	if p.HasError { return }
	isa.DataProc2(p.Asm, op, sf, rd, rn, rm)
}

// dpExtend emits sxtb / sxth / sxtw / uxtb / uxth / uxtw `Rd, Wn`: SBFM / UBFM of the
// low byte / halfword / word.  sxtb / sxth take a W or X destination; sxtw / uxtw an
// X destination; uxtb / uxth (which zero-extend, so the upper word is zero either way)
// encode the 32-bit form whether the destination is written W or X.
func dpExtend(p @Parser, mnem *[]readonly char, its a64Items) {
	if !dpExpectCount(p, its, 2) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	if p.HasError { return }
	// The source is architecturally a W register; like clang, an X spelling of the
	// same register is accepted for the sign-extends (the encoding is identical).
	var srcSf bool = false
	var signExt bool = mnemIs(mnem, "sxtb") || mnemIs(mnem, "sxth") || mnemIs(mnem, "sxtw")
	if signExt && sf && its.It[1].Kind == IT_REG && rcIsX(its.It[1].Cls) { srcSf = true }
	var rn int = dpRegAt(p, its, 1, srcSf, false, true)
	if p.HasError { return }
	var wordOp bool = mnemIs(mnem, "sxtw") || mnemIs(mnem, "uxtw")
	if wordOp && !sf {
		setErr(p, "sxtw/uxtw need an X destination")
		return
	}
	var top int = 7
	if mnemIs(mnem, "sxth") || mnemIs(mnem, "uxth") { top = 15 }
	if wordOp { top = 31 }
	if mnemIs(mnem, "sxtb") || mnemIs(mnem, "sxth") || mnemIs(mnem, "sxtw") {
		isa.Bitfield(p.Asm, isa.BF_SBFM, sf, rd, rn, 0, top)
	} else if wordOp {
		isa.Bitfield(p.Asm, isa.BF_UBFM, true, rd, rn, 0, top)
	} else {
		isa.Bitfield(p.Asm, isa.BF_UBFM, false, rd, rn, 0, top)
	}
}

// dpBitfield emits sbfm / bfm / ubfm `Rd, Rn, #immr, #imms` and the aliases
// sbfx / ubfx / bfxil (extract: immr = lsb, imms = lsb + width - 1), sbfiz / ubfiz /
// bfi (insert: immr = -lsb mod w, imms = width - 1), and bfc `Rd, #lsb, #width` (BFI
// from the zero register).
func dpBitfield(p @Parser, mnem *[]readonly char, its a64Items) {
	var isBfc bool = mnemIs(mnem, "bfc")
	var n int = 4
	if isBfc { n = 3 }
	if !dpExpectCount(p, its, n) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var w int = dpWidthBits(sf)
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = 31
	var k int = 1
	if !isBfc {
		rn = dpRegAt(p, its, 1, sf, false, true)
		k = 2
	}
	if p.HasError { return }
	var op uint32 = isa.BF_UBFM
	if mnemIs(mnem, "sbfm") || mnemIs(mnem, "sbfx") || mnemIs(mnem, "sbfiz") { op = isa.BF_SBFM }
	if mnemIs(mnem, "bfm") || mnemIs(mnem, "bfxil") || mnemIs(mnem, "bfi") || isBfc {
		op = isa.BF_BFM
	}
	var raw bool = mnemIs(mnem, "sbfm") || mnemIs(mnem, "bfm") || mnemIs(mnem, "ubfm")
	if raw {
		immr, ok1 := dpImmAt(p, its, k, 0, w - 1, "immr out of range for the register width")
		if !ok1 { return }
		imms, ok2 := dpImmAt(p, its, k + 1, 0, w - 1, "imms out of range for the register width")
		if !ok2 { return }
		isa.Bitfield(p.Asm, op, sf, rd, rn, immr, imms)
		return
	}
	lsb, okL := dpImmAt(p, its, k, 0, w - 1, "lsb out of range for the register width")
	if !okL { return }
	width, okW := dpImmAt(p, its, k + 1, 1, w - lsb, "bitfield width out of range (1..width-lsb)")
	if !okW { return }
	var insert bool = mnemIs(mnem, "sbfiz") || mnemIs(mnem, "ubfiz") || mnemIs(mnem, "bfi") || isBfc
	if insert {
		isa.Bitfield(p.Asm, op, sf, rd, rn, (w - lsb) % w, width - 1)
	} else {
		isa.Bitfield(p.Asm, op, sf, rd, rn, lsb, lsb + width - 1)
	}
}

// dpExtr emits extr `Rd, Rn, Rm, #lsb`.
func dpExtr(p @Parser, its a64Items) {
	if !dpExpectCount(p, its, 4) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = dpRegAt(p, its, 1, sf, false, true)
	var rm int = dpRegAt(p, its, 2, sf, false, true)
	if p.HasError { return }
	lsb, okL := dpImmAt(p, its, 3, 0, dpWidthBits(sf) - 1, "lsb out of range for the register width")
	if !okL { return }
	isa.Extr(p.Asm, sf, rd, rn, rm, lsb)
}

// dpMul emits mul / mneg `Rd, Rn, Rm` (MADD / MSUB with the zero register as Ra) and
// madd / msub `Rd, Rn, Rm, Ra`.
func dpMul(p @Parser, mnem *[]readonly char, its a64Items) {
	var four bool = mnemIs(mnem, "madd") || mnemIs(mnem, "msub")
	var n int = 3
	if four { n = 4 }
	if !dpExpectCount(p, its, n) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = dpRegAt(p, its, 1, sf, false, true)
	var rm int = dpRegAt(p, its, 2, sf, false, true)
	var ra int = 31
	if four { ra = dpRegAt(p, its, 3, sf, false, true) }
	if p.HasError { return }
	isa.MulAdd(p.Asm, mnemIs(mnem, "msub") || mnemIs(mnem, "mneg"), sf, rd, rn, rm, ra)
}

// dpMulLong emits the widening multiplies — smull / umull / smnegl / umnegl
// `Xd, Wn, Wm`, smaddl / smsubl / umaddl / umsubl `Xd, Wn, Wm, Xa` — and smulh / umulh
// `Xd, Xn, Xm`.
func dpMulLong(p @Parser, mnem *[]readonly char, its a64Items) {
	var isUnsigned bool = len(mnem) > 0 && (mnem[0] == 'u' || mnem[0] == 'U')
	if mnemIs(mnem, "smulh") || mnemIs(mnem, "umulh") {
		if !dpExpectCount(p, its, 3) { return }
		var hd int = dpRegAt(p, its, 0, true, false, true)
		var hn int = dpRegAt(p, its, 1, true, false, true)
		var hm int = dpRegAt(p, its, 2, true, false, true)
		if p.HasError { return }
		isa.MulHigh(p.Asm, isUnsigned, hd, hn, hm)
		return
	}
	var four bool = mnemIs(mnem, "smaddl") || mnemIs(mnem, "smsubl") || mnemIs(mnem, "umaddl") ||
			mnemIs(mnem, "umsubl")
	var n int = 3
	if four { n = 4 }
	if !dpExpectCount(p, its, n) { return }
	var rd int = dpRegAt(p, its, 0, true, false, true)
	var rn int = dpRegAt(p, its, 1, false, false, true)
	var rm int = dpRegAt(p, its, 2, false, false, true)
	var ra int = 31
	if four { ra = dpRegAt(p, its, 3, true, false, true) }
	if p.HasError { return }
	var sub bool = mnemIs(mnem, "smsubl") || mnemIs(mnem, "umsubl") || mnemIs(mnem, "smnegl") ||
			mnemIs(mnem, "umnegl")
	isa.MulAddLong(p.Asm, isUnsigned, sub, rd, rn, rm, ra)
}

// dpOneSource emits rbit / rev16 / rev / rev32 / rev64 / clz / cls `Rd, Rn`.  rev is
// the full-width byte reverse (REV of a W register, REV64 of an X one); rev32 and
// rev64 need X registers.
func dpOneSource(p @Parser, mnem *[]readonly char, its a64Items) {
	if !dpExpectCount(p, its, 2) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = dpRegAt(p, its, 1, sf, false, true)
	if p.HasError { return }
	var op int = isa.D1_RBIT
	if mnemIs(mnem, "rev16") { op = isa.D1_REV16 }
	if mnemIs(mnem, "clz") { op = isa.D1_CLZ }
	if mnemIs(mnem, "cls") { op = isa.D1_CLS }
	if mnemIs(mnem, "rev") {
		op = isa.D1_REV32
		if sf { op = isa.D1_REV64 }
	}
	if mnemIs(mnem, "rev32") || mnemIs(mnem, "rev64") {
		if !sf {
			setErr(p, "rev32/rev64 need X registers")
			return
		}
		op = isa.D1_REV32
		if mnemIs(mnem, "rev64") { op = isa.D1_REV64 }
	}
	isa.DataProc1(p.Asm, op, sf, rd, rn)
}

// dpCondSelect emits csel / csinc / csinv / csneg `Rd, Rn, Rm, cond` and the aliases
// cset / csetm `Rd, cond` and cinc / cinv / cneg `Rd, Rn, cond`, which select on the
// inverted condition (so al / nv, whose inverse is not a distinct test, are refused).
func dpCondSelect(p @Parser, mnem *[]readonly char, its a64Items) {
	var op uint32 = isa.CS_SEL
	if mnemIs(mnem, "csinc") || mnemIs(mnem, "cset") || mnemIs(mnem, "cinc") { op = isa.CS_INC }
	if mnemIs(mnem, "csinv") || mnemIs(mnem, "csetm") || mnemIs(mnem, "cinv") { op = isa.CS_INV }
	if mnemIs(mnem, "csneg") || mnemIs(mnem, "cneg") { op = isa.CS_NEG }
	var set bool = mnemIs(mnem, "cset") || mnemIs(mnem, "csetm")
	var alias bool = set || mnemIs(mnem, "cinc") || mnemIs(mnem, "cinv") || mnemIs(mnem, "cneg")
	var n int = 4
	if set { n = 2 } else if alias { n = 3 }
	if !dpExpectCount(p, its, n) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = 31
	var rm int = 31
	if !set { rn = dpRegAt(p, its, 1, sf, false, true) }
	if !alias { rm = dpRegAt(p, its, 2, sf, false, true) } else { rm = rn }
	if p.HasError { return }
	var ci a64Item = its.It[n - 1]
	if ci.Kind != IT_COND {
		setErr(p, "expected a condition code")
		return
	}
	var cond int = ci.Cond
	if alias {
		if cond >= 14 {
			setErr(p, "condition codes al and nv are invalid for this instruction")
			return
		}
		cond = cond ^ 1
	}
	isa.CondSelect(p.Asm, op, sf, rd, rn, rm, cond)
}

// dpCondCompare emits ccmp / ccmn `Rn, <Rm | #imm5>, #nzcv, cond`.
func dpCondCompare(p @Parser, mnem *[]readonly char, its a64Items) {
	if !dpExpectCount(p, its, 4) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var rn int = dpRegAt(p, its, 0, sf, false, true)
	if p.HasError { return }
	var isImm bool = its.It[1].Kind == IT_IMM
	var second int = 0
	if isImm {
		second, ok = dpImmAt(p, its, 1, 0, 31, "conditional-compare immediate out of range [0, 31]")
		if !ok { return }
	} else {
		second = dpRegAt(p, its, 1, sf, false, true)
		if p.HasError { return }
	}
	nzcv, okN := dpImmAt(p, its, 2, 0, 15, "nzcv out of range [0, 15]")
	if !okN { return }
	if its.It[3].Kind != IT_COND {
		setErr(p, "expected a condition code")
		return
	}
	isa.CondCompare(p.Asm, mnemIs(mnem, "ccmp"), sf, rn, isImm, second, nzcv, its.It[3].Cond)
}

// dpCarry emits adc / adcs / sbc / sbcs `Rd, Rn, Rm` and ngc / ngcs `Rd, Rm` (SBC /
// SBCS from the zero register).
func dpCarry(p @Parser, mnem *[]readonly char, its a64Items) {
	var ngc bool = mnemIs(mnem, "ngc") || mnemIs(mnem, "ngcs")
	var n int = 3
	if ngc { n = 2 }
	if !dpExpectCount(p, its, n) { return }
	sf, ok := dpFirstWidth(p, its, 0)
	if !ok { return }
	var op uint32 = isa.OPS_ADD
	if mnemIs(mnem, "adcs") { op = isa.OPS_ADDS }
	if mnemIs(mnem, "sbc") || mnemIs(mnem, "ngc") { op = isa.OPS_SUB }
	if mnemIs(mnem, "sbcs") || mnemIs(mnem, "ngcs") { op = isa.OPS_SUBS }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	var rn int = 31
	var rm int = 0
	if ngc {
		rm = dpRegAt(p, its, 1, sf, false, true)
	} else {
		rn = dpRegAt(p, its, 1, sf, false, true)
		rm = dpRegAt(p, its, 2, sf, false, true)
	}
	if p.HasError { return }
	isa.AddSubCarry(p.Asm, op, sf, rd, rn, rm)
}

// emitA64DP parses the operand list of a data-processing instruction (l positioned
// just after the mnemonic) and emits it; returns false when mnem is not one.
func emitA64DP(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var kind int = a64DPKind(mnem)
	if kind == DPK_NONE { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if kind == DPK_ADDSUB { dpAddSub(p, mnem, its) }
	if kind == DPK_LOGICAL { dpLogical(p, mnem, its) }
	if kind == DPK_MOV { dpMov(p, its) }
	if kind == DPK_MOVEWIDE { dpMoveWide(p, mnem, its) }
	if kind == DPK_SHIFT { dpShift(p, mnem, its) }
	if kind == DPK_TWOSRC { dpTwoSource(p, a64TwoSrcOp(mnem), its) }
	if kind == DPK_EXTEND { dpExtend(p, mnem, its) }
	if kind == DPK_BITFIELD { dpBitfield(p, mnem, its) }
	if kind == DPK_EXTR { dpExtr(p, its) }
	if kind == DPK_MUL { dpMul(p, mnem, its) }
	if kind == DPK_MULLONG { dpMulLong(p, mnem, its) }
	if kind == DPK_ONESRC { dpOneSource(p, mnem, its) }
	if kind == DPK_CSEL { dpCondSelect(p, mnem, its) }
	if kind == DPK_CCMP { dpCondCompare(p, mnem, its) }
	if kind == DPK_CARRY { dpCarry(p, mnem, its) }
	return true
}

// Data-processing mnemonic families (a64DPKind).
const (
	DPK_NONE int = iota
	DPK_ADDSUB
	DPK_LOGICAL
	DPK_MOV
	DPK_MOVEWIDE
	DPK_SHIFT
	DPK_TWOSRC
	DPK_EXTEND
	DPK_BITFIELD
	DPK_EXTR
	DPK_MUL
	DPK_MULLONG
	DPK_ONESRC
	DPK_CSEL
	DPK_CCMP
	DPK_CARRY
)

// a64TwoSrcOp returns the D2_* opcode of a register-only two-source mnemonic.
func a64TwoSrcOp(mnem *[]readonly char) int {
	if mnemIs(mnem, "lslv") { return isa.D2_LSLV }
	if mnemIs(mnem, "lsrv") { return isa.D2_LSRV }
	if mnemIs(mnem, "asrv") { return isa.D2_ASRV }
	if mnemIs(mnem, "rorv") { return isa.D2_RORV }
	if mnemIs(mnem, "udiv") { return isa.D2_UDIV }
	return isa.D2_SDIV
}

// a64DPKind classifies a mnemonic into its data-processing family, or DPK_NONE.
func a64DPKind(m *[]readonly char) int {
	_, _, _, isAS := dpAddSubOp(m)
	if isAS { return DPK_ADDSUB }
	_, _, _, isLG := dpLogicalOp(m)
	if isLG { return DPK_LOGICAL }
	if mnemIs(m, "mov") { return DPK_MOV }
	if mnemIs(m, "movz") || mnemIs(m, "movn") || mnemIs(m, "movk") { return DPK_MOVEWIDE }
	if mnemIs(m, "lsl") || mnemIs(m, "lsr") || mnemIs(m, "asr") || mnemIs(m, "ror") {
		return DPK_SHIFT
	}
	if mnemIs(m, "lslv") || mnemIs(m, "lsrv") || mnemIs(m, "asrv") || mnemIs(m, "rorv") ||
			mnemIs(m, "udiv") || mnemIs(m, "sdiv") {
		return DPK_TWOSRC
	}
	if mnemIs(m, "sxtb") || mnemIs(m, "sxth") || mnemIs(m, "sxtw") || mnemIs(m, "uxtb") ||
			mnemIs(m, "uxth") || mnemIs(m, "uxtw") {
		return DPK_EXTEND
	}
	if mnemIs(m, "sbfm") || mnemIs(m, "bfm") || mnemIs(m, "ubfm") || mnemIs(m, "sbfx") ||
			mnemIs(m, "ubfx") || mnemIs(m, "sbfiz") || mnemIs(m, "ubfiz") || mnemIs(m, "bfi") ||
			mnemIs(m, "bfxil") || mnemIs(m, "bfc") {
		return DPK_BITFIELD
	}
	if mnemIs(m, "extr") { return DPK_EXTR }
	if mnemIs(m, "mul") || mnemIs(m, "mneg") || mnemIs(m, "madd") || mnemIs(m, "msub") {
		return DPK_MUL
	}
	if mnemIs(m, "smull") || mnemIs(m, "umull") || mnemIs(m, "smnegl") || mnemIs(m, "umnegl") ||
			mnemIs(m, "smaddl") || mnemIs(m, "smsubl") || mnemIs(m, "umaddl") || mnemIs(m, "umsubl") ||
			mnemIs(m, "smulh") || mnemIs(m, "umulh") {
		return DPK_MULLONG
	}
	if mnemIs(m, "rbit") || mnemIs(m, "rev16") || mnemIs(m, "rev") || mnemIs(m, "rev32") ||
			mnemIs(m, "rev64") || mnemIs(m, "clz") || mnemIs(m, "cls") {
		return DPK_ONESRC
	}
	if mnemIs(m, "csel") || mnemIs(m, "csinc") || mnemIs(m, "csinv") || mnemIs(m, "csneg") ||
			mnemIs(m, "cset") || mnemIs(m, "csetm") || mnemIs(m, "cinc") || mnemIs(m, "cinv") ||
			mnemIs(m, "cneg") {
		return DPK_CSEL
	}
	if mnemIs(m, "ccmp") || mnemIs(m, "ccmn") { return DPK_CCMP }
	if mnemIs(m, "adc") || mnemIs(m, "adcs") || mnemIs(m, "sbc") || mnemIs(m, "sbcs") ||
			mnemIs(m, "ngc") || mnemIs(m, "ngcs") {
		return DPK_CARRY
	}
	return DPK_NONE
}
