package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF for the ELF-only `:lo12:` syntax and undefined local labels),
// or — where clang rejects it — is rejected.  Every valid instruction is one word:
// the text assembler never synthesizes a sequence.

// Shift, extend, bitfield, multiply, one-source, conditional and carry lines clang
// accepts, chunk 0.
func TestGoldenDP2Accepts0() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "adc x0, x1, x2", 0x9A020020)
	e = goldenWord(e, "asr w0, w1, #5", 0x13057C20)
	e = goldenWord(e, "asr x0, x1, #63", 0x937FFC20)
	e = goldenWord(e, "asr x0, x1, x2", 0x9AC22820)
	e = goldenWord(e, "asrv x0, x1, x2", 0x9AC22820)
	e = goldenWord(e, "bfc x0, #3, #4", 0xB37D0FE0)
	e = goldenWord(e, "bfi w0, w1, #3, #4", 0x331D0C20)
	e = goldenWord(e, "bfi x0, x1, #4, #8", 0xB37C1C20)
	e = goldenWord(e, "ccmn w0, w1, #0, eq", 0x3A410000)
	e = goldenWord(e, "ccmp x0, #5, #4, ne", 0xFA451804)
	e = goldenWord(e, "ccmp x0, x1, #0, eq", 0xFA410000)
	e = goldenWord(e, "cinc w0, w1, ne", 0x1A810420)
	e = goldenWord(e, "cinc x0, x1, eq", 0x9A811420)
	e = goldenWord(e, "cinv x0, x1, eq", 0xDA811020)
	e = goldenWord(e, "cls x0, x1", 0xDAC01420)
	e = goldenWord(e, "clz w0, w1", 0x5AC01020)
	e = goldenWord(e, "clz x0, x1", 0xDAC01020)
	e = goldenWord(e, "cneg x0, x1, eq", 0xDA811420)
	e = goldenWord(e, "csel w0, w1, w2, ne", 0x1A821020)
	e = goldenWord(e, "csel x0, x1, x2, al", 0x9A82E020)
	e = goldenWord(e, "csel x0, x1, x2, eq", 0x9A820020)
	e = goldenWord(e, "csel x0, x1, x2, hs", 0x9A822020)
	e = goldenWord(e, "csel x0, x1, x2, nv", 0x9A82F020)
	e = goldenWord(e, "cset w0, ne", 0x1A9F07E0)
	e = goldenWord(e, "cset x0, eq", 0x9A9F17E0)
	e = goldenWord(e, "csetm x0, eq", 0xDA9F13E0)
	e = goldenWord(e, "csinc w0, w1, w2, ge", 0x1A82A420)
	e = goldenWord(e, "csinc x0, x1, x2, lt", 0x9A82B420)
	e = goldenWord(e, "csinv x0, x1, x2, eq", 0xDA820020)
	e = goldenWord(e, "csneg x0, x1, x2, eq", 0xDA820420)
	e = goldenWord(e, "extr x0, x1, x2, #3", 0x93C20C20)
	e = goldenWord(e, "extr x0, x1, x2, #7", 0x93C21C20)
	e = goldenWord(e, "lsl w0, w1, #3", 0x531D7020)
	e = goldenWord(e, "lsl w0, w1, #31", 0x53010020)
	e = goldenWord(e, "lsl w0, w1, w2", 0x1AC22020)
	e = goldenWord(e, "lsl x0, x1, #0", 0xD340FC20)
	e = goldenWord(e, "lsl x0, x1, #3", 0xD37DF020)
	e = goldenWord(e, "lsl x0, x1, #63", 0xD3410020)
	e = goldenWord(e, "lsl x0, x1, x2", 0x9AC22020)
	e = goldenWord(e, "lslv x0, x1, x2", 0x9AC22020)
	e = goldenWord(e, "lsr w0, w1, #31", 0x531F7C20)
	e = goldenWord(e, "lsr x0, x1, #0", 0xD340FC20)
	e = goldenWord(e, "lsr x0, x1, #3", 0xD343FC20)
	e = goldenWord(e, "lsr x0, x1, x2", 0x9AC22420)
	e = goldenWord(e, "lsrv x0, x1, x2", 0x9AC22420)
	e = goldenWord(e, "madd w0, w1, w2, w3", 0x1B020C20)
	e = goldenWord(e, "madd x0, x1, x2, x3", 0x9B020C20)
	e = goldenWord(e, "mneg x0, x1, x2", 0x9B02FC20)
	e = goldenWord(e, "msub w0, w1, w2, w3", 0x1B028C20)
	e = goldenWord(e, "msub x0, x1, x2, x3", 0x9B028C20)
	e = goldenWord(e, "mul w0, w1, w2", 0x1B027C20)
	e = goldenWord(e, "mul x0, x1, x2", 0x9B027C20)
	e = goldenWord(e, "ngc w0, w1", 0x5A0103E0)
	e = goldenWord(e, "ngc x0, x1", 0xDA0103E0)
	e = goldenWord(e, "rbit x0, x1", 0xDAC00020)
	e = goldenWord(e, "rev x0, x1", 0xDAC00C20)
	e = goldenWord(e, "rev16 w0, w1", 0x5AC00420)
	e = goldenWord(e, "rev32 x0, x1", 0xDAC00820)
	e = goldenWord(e, "ror w0, w1, #5", 0x13811420)
	e = goldenWord(e, "ror w0, w1, w2", 0x1AC22C20)
	e = goldenWord(e, "ror x0, x1, #3", 0x93C10C20)
	e = goldenWord(e, "ror x0, x1, x2", 0x9AC22C20)
	e = goldenWord(e, "rorv x0, x1, x2", 0x9AC22C20)
	e = goldenWord(e, "sbc x0, x1, x2", 0xDA020020)
	e = goldenWord(e, "sbfx x0, x1, #4, #8", 0x93442C20)
	e = goldenWord(e, "sdiv w0, w1, w2", 0x1AC20C20)
	e = goldenWord(e, "sdiv x0, x1, x2", 0x9AC20C20)
	e = goldenWord(e, "smaddl x0, w1, w2, x3", 0x9B220C20)
	e = goldenWord(e, "smulh x0, x1, x2", 0x9B427C20)
	e = goldenWord(e, "smull x0, w1, w2", 0x9B227C20)
	e = goldenWord(e, "sxtb w0, w1", 0x13001C20)
	e = goldenWord(e, "sxtb x0, w1", 0x93401C20)
	e = goldenWord(e, "sxtb x0, x1", 0x93401C20)
	e = goldenWord(e, "sxth w0, w1", 0x13003C20)
	e = goldenWord(e, "sxth x0, w1", 0x93403C20)
	e = goldenWord(e, "sxth x0, x1", 0x93403C20)
	e = goldenWord(e, "sxtw x0, w1", 0x93407C20)
	e = goldenWord(e, "sxtw x0, x1", 0x93407C20)
	e = goldenWord(e, "ubfiz x0, x1, #4, #8", 0xD37C1C20)
	e = goldenWord(e, "ubfm x0, x1, #4, #8", 0xD3442020)
	e = goldenWord(e, "ubfx x0, x1, #4, #8", 0xD3442C20)
	e = goldenWord(e, "udiv x0, x1, x2", 0x9AC20820)
	e = goldenWord(e, "umulh x0, x1, x2", 0x9BC27C20)
	e = goldenWord(e, "umull x0, w1, w2", 0x9BA27C20)
	e = goldenWord(e, "uxtb w0, w1", 0x53001C20)
	e = goldenWord(e, "uxtb x0, w1", 0x53001C20)
	e = goldenWord(e, "uxth w0, w1", 0x53003C20)
	e = goldenWord(e, "uxth x0, w1", 0x53003C20)
	e = goldenWord(e, "uxtw x0, w1", 0xD3407C20)
	return e
}
