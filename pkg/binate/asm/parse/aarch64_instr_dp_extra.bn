package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 data-processing instructions, part 3: the checksums CRC32{B,H,W,X} /
// CRC32C{B,H,W,X} `Wd, Wn, Wm|Xm`; the pointer-authentication register forms PAC* /
// AUT* `Xd, Xn|SP`, their zero-modifier forms and XPACI / XPACD `Xd`, and PACGA
// `Xd, Xn, Xm|SP`; and the flag manipulation CFINV / XAFLAG / AXFLAG, RMIF
// `Xn, #shift, #mask` and SETF8 / SETF16 `Wn`.

// crcOf decodes a CRC32 mnemonic: whether it is CRC32C (Castagnoli) and its size
// (0..3 for B / H / W / X), or ok=false.
func crcOf(m *[]readonly char) (bool, int, bool) {
	var c bool = prefixIs(m, "crc32c")
	var n int = 5
	if c { n = 6 }
	if !prefixIs(m, "crc32") || len(m) != n + 1 { return false, 0, false }
	var s char = lowerChar(m[n])
	if s == 'b' { return c, 0, true }
	if s == 'h' { return c, 1, true }
	if s == 'w' { return c, 2, true }
	if s == 'x' { return c, 3, true }
	return false, 0, false
}

// pointerAuthOf returns the isa.PA_* operation of a pointer-authentication register
// mnemonic, or -1.
func pointerAuthOf(m *[]readonly char) int {
	if mnemIs(m, "pacia") { return isa.PA_PACIA }
	if mnemIs(m, "pacib") { return isa.PA_PACIB }
	if mnemIs(m, "pacda") { return isa.PA_PACDA }
	if mnemIs(m, "pacdb") { return isa.PA_PACDB }
	if mnemIs(m, "autia") { return isa.PA_AUTIA }
	if mnemIs(m, "autib") { return isa.PA_AUTIB }
	if mnemIs(m, "autda") { return isa.PA_AUTDA }
	if mnemIs(m, "autdb") { return isa.PA_AUTDB }
	if mnemIs(m, "paciza") { return isa.PA_PACIZA }
	if mnemIs(m, "pacizb") { return isa.PA_PACIZB }
	if mnemIs(m, "pacdza") { return isa.PA_PACDZA }
	if mnemIs(m, "pacdzb") { return isa.PA_PACDZB }
	if mnemIs(m, "autiza") { return isa.PA_AUTIZA }
	if mnemIs(m, "autizb") { return isa.PA_AUTIZB }
	if mnemIs(m, "autdza") { return isa.PA_AUTDZA }
	if mnemIs(m, "autdzb") { return isa.PA_AUTDZB }
	if mnemIs(m, "xpaci") { return isa.PA_XPACI }
	if mnemIs(m, "xpacd") { return isa.PA_XPACD }
	return -1
}

// flagManipOf returns the isa.FL_* word of an operand-less flag instruction, or 0.
func flagManipOf(m *[]readonly char) uint32 {
	if mnemIs(m, "cfinv") { return isa.FL_CFINV }
	if mnemIs(m, "xaflag") { return isa.FL_XAFLAG }
	if mnemIs(m, "axflag") { return isa.FL_AXFLAG }
	return 0
}

// isA64DPExtra reports whether mnem is one of this file's instructions.
func isA64DPExtra(m *[]readonly char) bool {
	_, _, isCrc := crcOf(m)
	return isCrc || pointerAuthOf(m) >= 0 || flagManipOf(m) != 0 || mnemIs(m, "pacga") ||
			mnemIs(m, "rmif") || mnemIs(m, "setf8") || mnemIs(m, "setf16")
}

// emitA64DPExtra parses the operand list of one of this file's instructions (l
// positioned just after the mnemonic) and emits it; returns false when mnem is not
// one.
func emitA64DPExtra(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !isA64DPExtra(mnem) { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	c, size, isCrc := crcOf(mnem)
	if isCrc {
		if !dpExpectCount(p, its, 3) { return true }
		var rd int = dpRegAt(p, its, 0, false, false, true)
		var rn int = dpRegAt(p, its, 1, false, false, true)
		var rm int = dpRegAt(p, its, 2, size == 3, false, true)
		if !p.HasError { isa.Crc32(p.Asm, c, size, rd, rn, rm) }
		return true
	}
	var pa int = pointerAuthOf(mnem)
	if pa >= isa.PA_PACIZA {
		if !dpExpectCount(p, its, 1) { return true }
		var rz int = dpRegAt(p, its, 0, true, false, true)
		if !p.HasError { isa.PointerAuth(p.Asm, pa, rz, 31) }
		return true
	}
	if pa >= 0 {
		if !dpExpectCount(p, its, 2) { return true }
		var rd int = dpRegAt(p, its, 0, true, false, true)
		var rn int = dpRegAt(p, its, 1, true, true, false)
		if !p.HasError { isa.PointerAuth(p.Asm, pa, rd, rn) }
		return true
	}
	if mnemIs(mnem, "pacga") {
		if !dpExpectCount(p, its, 3) { return true }
		var rd int = dpRegAt(p, its, 0, true, false, true)
		var rn int = dpRegAt(p, its, 1, true, false, true)
		var rm int = dpRegAt(p, its, 2, true, true, false)
		if !p.HasError { isa.PacGA(p.Asm, rd, rn, rm) }
		return true
	}
	var fl uint32 = flagManipOf(mnem)
	if fl != 0 {
		if dpExpectCount(p, its, 0) { isa.FlagManip(p.Asm, fl) }
		return true
	}
	if mnemIs(mnem, "rmif") {
		if !dpExpectCount(p, its, 3) { return true }
		var rn int = dpRegAt(p, its, 0, true, false, true)
		if p.HasError { return true }
		if its.It[1].Kind != IT_IMM || its.It[2].Kind != IT_IMM {
			setErr(p, "rmif takes Xn, #shift, #mask")
			return true
		}
		if !intFits(its.It[1].Imm) || !intFits(its.It[2].Imm) {
			setErr(p, "rmif: shift must be in [0, 63] and mask in [0, 15]")
			return true
		}
		isa.Rmif(p.Asm, rn, cast(int, its.It[1].Imm), cast(int, its.It[2].Imm))
		return true
	}
	// setf8 / setf16
	if !dpExpectCount(p, its, 1) { return true }
	var rw int = dpRegAt(p, its, 0, false, false, true)
	if !p.HasError { isa.SetFlags(p.Asm, mnemIs(mnem, "setf16"), rw) }
	return true
}
