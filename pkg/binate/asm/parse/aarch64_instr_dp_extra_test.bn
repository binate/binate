package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for CRC32 / CRC32C, the pointer-authentication register forms and
// PACGA, and the flag manipulation instructions, from clang (`clang -c -target
// aarch64-linux-gnu -march=armv8.5-a+crc`), objdump'd.
func TestGoldenCrc32() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "crc32b w0, w1, w2", 0x1AC24020)
	e = goldenWord(e, "crc32h w0, w1, w2", 0x1AC24420)
	e = goldenWord(e, "crc32w w0, w1, w2", 0x1AC24820)
	e = goldenWord(e, "crc32x w0, w1, x2", 0x9AC24C20)
	e = goldenWord(e, "crc32cb w0, w1, w2", 0x1AC25020)
	e = goldenWord(e, "crc32ch w0, w1, w2", 0x1AC25420)
	e = goldenWord(e, "crc32cw w0, w1, w2", 0x1AC25820)
	e = goldenWord(e, "crc32cx w0, w1, x2", 0x9AC25C20)
	e = goldenWord(e, "crc32b wzr, wzr, wzr", 0x1ADF43FF)
	e = goldenWord(e, "crc32cx wzr, wzr, xzr", 0x9ADF5FFF)
	e = goldenWord(e, "CRC32CX W0, W1, X2", 0x9AC25C20)
	return e
}

func TestGoldenPointerAuthRegs() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "pacia x0, x1", 0xDAC10020)
	e = goldenWord(e, "pacib x0, x1", 0xDAC10420)
	e = goldenWord(e, "pacda x0, x1", 0xDAC10820)
	e = goldenWord(e, "pacdb x0, x1", 0xDAC10C20)
	e = goldenWord(e, "autia x0, x1", 0xDAC11020)
	e = goldenWord(e, "autib x0, x1", 0xDAC11420)
	e = goldenWord(e, "autda x0, x1", 0xDAC11820)
	e = goldenWord(e, "autdb x0, x1", 0xDAC11C20)
	e = goldenWord(e, "pacia x0, sp", 0xDAC103E0)
	e = goldenWord(e, "autdb xzr, sp", 0xDAC11FFF)
	e = goldenWord(e, "paciza x0", 0xDAC123E0)
	e = goldenWord(e, "pacizb x0", 0xDAC127E0)
	e = goldenWord(e, "pacdza x0", 0xDAC12BE0)
	e = goldenWord(e, "pacdzb x0", 0xDAC12FE0)
	e = goldenWord(e, "autiza x0", 0xDAC133E0)
	e = goldenWord(e, "autizb x0", 0xDAC137E0)
	e = goldenWord(e, "autdza x0", 0xDAC13BE0)
	e = goldenWord(e, "autdzb x0", 0xDAC13FE0)
	e = goldenWord(e, "xpaci x0", 0xDAC143E0)
	e = goldenWord(e, "xpacd x0", 0xDAC147E0)
	e = goldenWord(e, "xpaci xzr", 0xDAC143FF)
	e = goldenWord(e, "pacga x0, x1, x2", 0x9AC23020)
	e = goldenWord(e, "pacga x0, x1, sp", 0x9ADF3020)
	e = goldenWord(e, "pacga xzr, x1, x2", 0x9AC2303F)
	e = goldenWord(e, "pacga x0, xzr, x2", 0x9AC233E0)
	return e
}

func TestGoldenFlagManip() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "cfinv", 0xD500401F)
	e = goldenWord(e, "axflag", 0xD500405F)
	e = goldenWord(e, "xaflag", 0xD500403F)
	e = goldenWord(e, "rmif x0, #63, #15", 0xBA1F840F)
	e = goldenWord(e, "rmif x1, #0, #0", 0xBA000420)
	e = goldenWord(e, "rmif xzr, #1, #2", 0xBA0087E2)
	e = goldenWord(e, "setf8 w0", 0x3A00080D)
	e = goldenWord(e, "setf16 w1", 0x3A00482D)
	e = goldenWord(e, "setf8 wzr", 0x3A000BED)
	return e
}

// Rejected as clang rejects them: a register of the wrong width, SP where the field
// reads 31 as the zero register (and XZR where it reads SP), an immediate out of
// range, and operands on an operand-less instruction.
func TestGoldenDPExtraRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "crc32x x0, w1, x2")
	e = goldenReject(e, "crc32w w0, w1, x2")
	e = goldenReject(e, "crc32b w0, wsp, w2")
	e = goldenReject(e, "crc32d w0, w1, w2")
	e = goldenReject(e, "pacia x0, xzr")
	e = goldenReject(e, "pacia sp, x1")
	e = goldenReject(e, "pacia w0, x1")
	e = goldenReject(e, "paciza sp")
	e = goldenReject(e, "paciza x0, x1")
	e = goldenReject(e, "xpacd sp")
	e = goldenReject(e, "pacga x0, sp, x2")
	e = goldenReject(e, "pacga sp, x1, x2")
	e = goldenReject(e, "pacga x0, x1, xzr")
	e = goldenReject(e, "pacga w0, w1, w2")
	e = goldenReject(e, "rmif x0, #64, #0")
	e = goldenReject(e, "rmif x0, #0, #16")
	e = goldenReject(e, "rmif w0, #0, #0")
	e = goldenReject(e, "rmif sp, #0, #0")
	e = goldenReject(e, "setf8 x0")
	e = goldenReject(e, "cfinv x0")
	e = goldenReject(e, "setf16 xzr")
	e = goldenReject(e, "crc32x w0, w1, sp")
	e = goldenReject(e, "pacia x0, wsp")
	e = goldenReject(e, "pacia x0, x31")
	e = goldenReject(e, "rmif x0, #-1, #0")
	return e
}

// Registers 28-31 in every field, mixed-case mnemonics and registers, and RMIF
// immediates written bare or as expressions.
func TestGoldenDPExtraSpellings() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "crc32b w28, w29, w30", 0x1ADE43BC)
	e = goldenWord(e, "crc32x w30, wzr, x28", 0x9ADC4FFE)
	e = goldenWord(e, "pacia x28, x29", 0xDAC103BC)
	e = goldenWord(e, "paciza x30", 0xDAC123FE)
	e = goldenWord(e, "pacga x28, x29, x30", 0x9ADE33BC)
	e = goldenWord(e, "PaCgA X0, X1, SP", 0x9ADF3020)
	e = goldenWord(e, "Crc32Ch W3, w4, W5", 0x1AC55483)
	e = goldenWord(e, "SETF16 W7", 0x3A0048ED)
	e = goldenWord(e, "rmif x0, 63, 15", 0xBA1F840F)
	e = goldenWord(e, "rmif x0, #(60+3), #(1<<3)", 0xBA1F8408)
	e = goldenWord(e, "rmif x30, #1, #2", 0xBA0087C2)
	return e
}
