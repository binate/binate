package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF for the ELF-only `:lo12:` syntax and undefined local labels),
// or — where clang rejects it — is rejected.  Every valid instruction is one word:
// the text assembler never synthesizes a sequence.

// Data-processing lines clang rejects, chunk 0.
func TestGoldenDPRejects0() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "add w0, w1, #0x1001")
	e = goldenReject(e, "add w0, w1, w2, lsl #32")
	e = goldenReject(e, "add w0, w1, x2")
	e = goldenReject(e, "add w0, x1, #1")
	e = goldenReject(e, "add w0, x1, w2")
	e = goldenReject(e, "add x0")
	e = goldenReject(e, "add x0, w1, #1")
	e = goldenReject(e, "add x0, w1, x2")
	e = goldenReject(e, "add x0, x1")
	e = goldenReject(e, "add x0, x1, [x2]")
	e = goldenReject(e, "add x0, x1, #0x1000, lsl #12")
	e = goldenReject(e, "add x0, x1, #0x1000000")
	e = goldenReject(e, "add x0, x1, #0x1001")
	e = goldenReject(e, "add x0, x1, #1 garbage")
	e = goldenReject(e, "add x0, x1, #1, lsl #11")
	e = goldenReject(e, "add x0, x1, #1, lsl #24")
	e = goldenReject(e, "add x0, x1, #1, lsr #12")
	e = goldenReject(e, "add x0, x1, #4097")
	e = goldenReject(e, "add x0, x1, foo")
	e = goldenReject(e, "add x0, x1, sp")
	e = goldenReject(e, "add x0, x1, w2")
	e = goldenReject(e, "add x0, x1, w2, lsl #2")
	e = goldenReject(e, "add x0, x1, w2, uxtw #5")
	e = goldenReject(e, "add x0, x1, wsp")
	e = goldenReject(e, "add x0, x1, x2 x3")
	e = goldenReject(e, "add x0, x1, x2, lsl")
	e = goldenReject(e, "add x0, x1, x2, lsl #-1")
	e = goldenReject(e, "add x0, x1, x2, lsl #100")
	e = goldenReject(e, "add x0, x1, x2, lsl #3, lsl #4")
	e = goldenReject(e, "add x0, x1, x2, lsl #64")
	e = goldenReject(e, "add x0, x1, x2, msl #3")
	e = goldenReject(e, "add x0, x1, x2, ror #3")
	e = goldenReject(e, "add x0, x1, x2, uxtw")
	e = goldenReject(e, "add x0, x1, x2, x3")
	e = goldenReject(e, "add x0, x1, x32")
	e = goldenReject(e, "add x0, xzr, #1")
	e = goldenReject(e, "adds sp, x0, #1")
	e = goldenReject(e, "adds x0, w1, w2")
	e = goldenReject(e, "adds x0, x1, #4097")
	e = goldenReject(e, "adds x0, x1, x2, ror #3")
	e = goldenReject(e, "and w0, w1, #-1")
	e = goldenReject(e, "and w0, w1, #0")
	e = goldenReject(e, "and w0, w1, #0x100000001")
	e = goldenReject(e, "and w0, w1, #0x1000000ff")
	e = goldenReject(e, "and w0, w1, #0x1ff00000000")
	e = goldenReject(e, "and w0, w1, #0xffffffff")
	e = goldenReject(e, "and w0, w1, x2")
	e = goldenReject(e, "and x0, sp, x1")
	e = goldenReject(e, "and x0, w1, x2")
	e = goldenReject(e, "and x0, x1, [x2]")
	e = goldenReject(e, "and x0, x1, #-1")
	e = goldenReject(e, "and x0, x1, #0")
	e = goldenReject(e, "and x0, x1, #0xff, lsl #4")
	e = goldenReject(e, "and x0, x1, #5")
	e = goldenReject(e, "and x0, x1, foo")
	e = goldenReject(e, "and x0, x1, x2, lsl #64")
	e = goldenReject(e, "and x0, x1, x2, uxtw")
	e = goldenReject(e, "ands sp, x0, #0xff")
	e = goldenReject(e, "ands sp, x1, #0xff")
	e = goldenReject(e, "ands w0, x1, w2")
	e = goldenReject(e, "ands x0, x1, #0")
	e = goldenReject(e, "ands x0, x1, #5")
	e = goldenReject(e, "cmn w0, x1")
	e = goldenReject(e, "cmn x0, #4097")
	e = goldenReject(e, "cmp w0, #0x1001")
	e = goldenReject(e, "cmp w0, x1")
	e = goldenReject(e, "cmp x0, [x1]")
	e = goldenReject(e, "cmp x0, #4097")
	e = goldenReject(e, "cmp x0, foo")
	e = goldenReject(e, "cmp x0, w1")
	e = goldenReject(e, "cmp x0, x1, lsl #64")
	e = goldenReject(e, "cmp x0, x1, ror #3")
	e = goldenReject(e, "eor x0, x1, sp")
	e = goldenReject(e, "mov w0, x1")
	e = goldenReject(e, "mov x0, [x1]")
	e = goldenReject(e, "mov x0, #0x12345")
	e = goldenReject(e, "mov x0, #0x123456")
	e = goldenReject(e, "mov x0, #0x1234567812345678")
	e = goldenReject(e, "mov x0, #1 junk")
	e = goldenReject(e, "mov x0, #1, lsl #16")
	e = goldenReject(e, "mov x0, foo")
	e = goldenReject(e, "mov x0, label")
	e = goldenReject(e, "mov x0, w1")
	e = goldenReject(e, "mov x0, x1, lsl #2")
	e = goldenReject(e, "mov x0, x1, lsl #3")
	e = goldenReject(e, "mov x0, x1, x2")
	e = goldenReject(e, "movk w0, #0x1234, lsl #32")
	e = goldenReject(e, "movk x0, #0x12345")
	e = goldenReject(e, "movk x0, #1, lsl #12")
	e = goldenReject(e, "movn w0, #1, lsl #48")
	e = goldenReject(e, "movn x0, #-1")
	e = goldenReject(e, "movn x0, #0x10000")
	e = goldenReject(e, "movz sp, #1")
	e = goldenReject(e, "movz w0, #1, lsl #32")
	e = goldenReject(e, "movz w0, #1, lsl #48")
	e = goldenReject(e, "movz x0, #-1")
	e = goldenReject(e, "movz x0, #0x10000")
	e = goldenReject(e, "movz x0, #0x10000, lsl #16")
	e = goldenReject(e, "movz x0, #0x1234, lsl #-16")
	e = goldenReject(e, "movz x0, #1 junk")
	return e
}

// Data-processing lines clang rejects, chunk 1.
func TestGoldenDPRejects1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "movz x0, #1, lsl")
	e = goldenReject(e, "movz x0, #1, lsl #16, junk")
	e = goldenReject(e, "movz x0, #1, lsl #17")
	e = goldenReject(e, "movz x0, #1, lsl #64")
	e = goldenReject(e, "movz x0, #1, lsl #8")
	e = goldenReject(e, "movz x0, #1, lsr #16")
	e = goldenReject(e, "movz x0, x1")
	e = goldenReject(e, "mvn x0, #1")
	e = goldenReject(e, "mvn x0, foo")
	e = goldenReject(e, "mvn x0, sp")
	e = goldenReject(e, "mvn x0, w1")
	e = goldenReject(e, "neg sp, x1")
	e = goldenReject(e, "neg w0, x1")
	e = goldenReject(e, "neg x0, #1")
	e = goldenReject(e, "neg x0, foo")
	e = goldenReject(e, "neg x0, sp")
	e = goldenReject(e, "neg x0, w1")
	e = goldenReject(e, "neg x0, x1, ror #3")
	e = goldenReject(e, "orr w0, w1, w2, lsl #32")
	e = goldenReject(e, "orr x0, sp, #0xff")
	e = goldenReject(e, "orr x0, x1, #5")
	e = goldenReject(e, "orr x0, x1, w2")
	e = goldenReject(e, "sub sp, sp, #4097")
	e = goldenReject(e, "sub x0, w1, x2")
	e = goldenReject(e, "sub x0, x1, #0x1001")
	e = goldenReject(e, "sub x0, x1, #4097")
	e = goldenReject(e, "sub x0, x1, q0")
	e = goldenReject(e, "sub x0, xzr, #1")
	e = goldenReject(e, "subs sp, x0, x1")
	e = goldenReject(e, "subs w0, w1, w2, lsl #32")
	e = goldenReject(e, "subs x0, x1, #4097")
	e = goldenReject(e, "tst sp, #1")
	e = goldenReject(e, "tst w0, #0xffffffff")
	e = goldenReject(e, "tst x0, #-1")
	e = goldenReject(e, "tst x0, #0")
	e = goldenReject(e, "tst x0, #5")
	e = goldenReject(e, "tst x0, foo")
	e = goldenReject(e, "tst x0, sp")
	e = goldenReject(e, "tst x0, w1")
	e = goldenReject(e, "asr w0, w1, #32")
	e = goldenReject(e, "asr w0, w1, x2")
	e = goldenReject(e, "asr x0, x1, #-3")
	e = goldenReject(e, "asr x0, x1, #64")
	e = goldenReject(e, "asr x0, x1, x2, asr #2")
	e = goldenReject(e, "csel w0, w1, x2, eq")
	e = goldenReject(e, "csel x0, w1, x2, eq")
	e = goldenReject(e, "csel x0, x1, #1, eq")
	e = goldenReject(e, "csel x0, x1, foo, eq")
	e = goldenReject(e, "csel x0, x1, sp, eq")
	e = goldenReject(e, "csel x0, x1, x2, eq, junk")
	e = goldenReject(e, "csel x0, x1, x2, foo")
	e = goldenReject(e, "csetm x0, al")
	e = goldenReject(e, "csinc x0, x1, w2, ge")
	e = goldenReject(e, "lsl sp, x1, #3")
	e = goldenReject(e, "lsl w0, w1, #32")
	e = goldenReject(e, "lsl w0, w1, x2")
	e = goldenReject(e, "lsl x0, sp, x2")
	e = goldenReject(e, "lsl x0, w1, #3")
	e = goldenReject(e, "lsl x0, x1, [x2]")
	e = goldenReject(e, "lsl x0, x1, #-1")
	e = goldenReject(e, "lsl x0, x1, #100")
	e = goldenReject(e, "lsl x0, x1, #3, lsl #2")
	e = goldenReject(e, "lsl x0, x1, #64")
	e = goldenReject(e, "lsl x0, x1, label")
	e = goldenReject(e, "lsl x0, x1, w2")
	e = goldenReject(e, "lsl x0, x1, x2, lsl #2")
	e = goldenReject(e, "lsr w0, w1, #32")
	e = goldenReject(e, "lsr x0, x1, #-1")
	e = goldenReject(e, "lsr x0, x1, #64")
	e = goldenReject(e, "lsr x0, x1, w2")
	e = goldenReject(e, "lsr x0, x1, x2, lsr #1")
	e = goldenReject(e, "madd x0, w1, x2, x3")
	e = goldenReject(e, "madd x0, x1, x2, #3")
	e = goldenReject(e, "madd x0, x1, x2, foo")
	e = goldenReject(e, "madd x0, x1, x2, sp")
	e = goldenReject(e, "madd x0, x1, x2, w3")
	e = goldenReject(e, "msub x0, x1, x2")
	e = goldenReject(e, "msub x0, x1, x2, x3, lsl #2")
	e = goldenReject(e, "mul sp, x1, x2")
	e = goldenReject(e, "mul w0, w1, x2")
	e = goldenReject(e, "mul x0, w1, x2")
	e = goldenReject(e, "mul x0, x1")
	e = goldenReject(e, "mul x0, x1, [x2]")
	e = goldenReject(e, "mul x0, x1, #2")
	e = goldenReject(e, "mul x0, x1, label")
	e = goldenReject(e, "mul x0, x1, sp")
	e = goldenReject(e, "mul x0, x1, w2")
	e = goldenReject(e, "mul x0, x1, x2, lsl #2")
	e = goldenReject(e, "ror x0, x1, #64")
	e = goldenReject(e, "ror x0, x1, w2")
	e = goldenReject(e, "ror x0, x1, x2, ror #2")
	e = goldenReject(e, "sdiv x0, w1, x2")
	e = goldenReject(e, "sdiv x0, x1, #2")
	e = goldenReject(e, "sdiv x0, x1, x2, lsl #1")
	e = goldenReject(e, "sxtb sp, w1")
	e = goldenReject(e, "sxtb w0, x1")
	e = goldenReject(e, "sxtb x0, #1")
	e = goldenReject(e, "sxtb x0, foo")
	e = goldenReject(e, "sxtb x0, w1, lsl #2")
	e = goldenReject(e, "sxth w0, x1")
	return e
}

// Data-processing lines clang rejects, chunk 2.
func TestGoldenDPRejects2() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sxtw w0, w1")
	e = goldenReject(e, "udiv w0, w1, x2")
	e = goldenReject(e, "udiv x0, x1, #4")
	e = goldenReject(e, "uxtb w0, x1")
	e = goldenReject(e, "uxtw w0, w1")
	return e
}
