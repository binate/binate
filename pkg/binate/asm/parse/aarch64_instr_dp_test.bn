package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF for the ELF-only `:lo12:` syntax and undefined local labels),
// or — where clang rejects it — is rejected.  Every valid instruction is one word:
// the text assembler never synthesizes a sequence.

// Add/sub, logical and move lines clang accepts, chunk 0.
func TestGoldenDPAccepts0() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "add fp, sp, #16", 0x910043FD)
	e = goldenWord(e, "add sp, sp, #16", 0x910043FF)
	e = goldenWord(e, "add sp, sp, x1", 0x8B2163FF)
	e = goldenWord(e, "add sp, sp, x1, lsl #3", 0x8B216FFF)
	e = goldenWord(e, "add sp, x0, #16", 0x9100401F)
	e = goldenWord(e, "add sp, x0, x1", 0x8B21601F)
	e = goldenWord(e, "add w0, w1, #-5", 0x51001420)
	e = goldenWord(e, "add w0, w1, #0x1000", 0x11400420)
	e = goldenWord(e, "add w0, w1, #1", 0x11000420)
	e = goldenWord(e, "add w0, w1, w2, lsl #31", 0x0B027C20)
	e = goldenWord(e, "add w0, w1, w2, sxth #1", 0x0B22A420)
	e = goldenWord(e, "add w0, w1, w2, uxtb", 0x0B220020)
	e = goldenWord(e, "add w0, w1, w2, uxtw #2", 0x0B224820)
	e = goldenWord(e, "add w0, wsp, #16", 0x110043E0)
	e = goldenWord(e, "add w0, wsp, w1", 0x0B2143E0)
	e = goldenWord(e, "add w31, w1, w2", 0x0B02003F)
	e = goldenWord(e, "add wsp, w0, #1", 0x1100041F)
	e = goldenWord(e, "add wsp, wsp, w1", 0x0B2143FF)
	e = goldenWord(e, "add x0, sp, #16", 0x910043E0)
	e = goldenWord(e, "add x0, sp, w1, uxtw #2", 0x8B214BE0)
	e = goldenWord(e, "add x0, sp, x1", 0x8B2163E0)
	e = goldenWord(e, "add x0, sp, x1, lsl #2", 0x8B216BE0)
	e = goldenWord(e, "add x0, x1, #-1", 0xD1000420)
	e = goldenWord(e, "add x0, x1, #-4096", 0xD1400420)
	e = goldenWord(e, "add x0, x1, #(2+3)", 0x91001420)
	e = goldenWord(e, "add x0, x1, #0x1000", 0x91400420)
	e = goldenWord(e, "add x0, x1, #0xfff000", 0x917FFC20)
	e = goldenWord(e, "add x0, x1, #1", 0x91000420)
	e = goldenWord(e, "add x0, x1, #1, lsl #0", 0x91000420)
	e = goldenWord(e, "add x0, x1, #1, lsl #12", 0x91400420)
	e = goldenWord(e, "add x0, x1, #2+3", 0x91001420)
	e = goldenWord(e, "add x0, x1, #4095", 0x913FFC20)
	e = goldenWord(e, "add x0, x1, #4095, lsl #12", 0x917FFC20)
	e = goldenWord(e, "add x0, x1, #4096", 0x91400420)
	e = goldenWord(e, "add x0, x1, 1", 0x91000420)
	e = goldenWord(e, "add x0, x1, 5", 0x91001420)
	e = goldenWord(e, "add x0, x1, w2, sxtb", 0x8B228020)
	e = goldenWord(e, "add x0, x1, w2, sxtb #4", 0x8B229020)
	e = goldenWord(e, "add x0, x1, w2, sxth", 0x8B22A020)
	e = goldenWord(e, "add x0, x1, w2, sxtw", 0x8B22C020)
	e = goldenWord(e, "add x0, x1, w2, sxtw #3", 0x8B22CC20)
	e = goldenWord(e, "add x0, x1, w2, uxtb", 0x8B220020)
	e = goldenWord(e, "add x0, x1, w2, uxth #1", 0x8B222420)
	e = goldenWord(e, "add x0, x1, w2, uxtw", 0x8B224020)
	e = goldenWord(e, "add x0, x1, w2, uxtw #2", 0x8B224820)
	e = goldenWord(e, "add x0, x1, x2", 0x8B020020)
	e = goldenWord(e, "ADD X0, X1, X2", 0x8B020020)
	e = goldenWord(e, "add x0, x1, x2 // comment", 0x8B020020)
	e = goldenWord(e, "add x0, x1, x2, asr #63", 0x8B82FC20)
	e = goldenWord(e, "add x0, x1, x2, lsl #3", 0x8B020C20)
	e = goldenWord(e, "add x0, x1, x2, LSL #3", 0x8B020C20)
	e = goldenWord(e, "add x0, x1, x2, lsl 3", 0x8B020C20)
	e = goldenWord(e, "add x0, x1, x2, lsr #3", 0x8B420C20)
	e = goldenWord(e, "add x0, x1, x2, sxtx #1", 0x8B22E420)
	e = goldenWord(e, "add x0, x1, x2, uxtx", 0x8B226020)
	e = goldenWord(e, "add x0, x1, x2, uxtx #2", 0x8B226820)
	e = goldenWord(e, "add x31, x1, x2", 0x8B02003F)
	e = goldenWord(e, "adds w0, w1, w2, lsr #5", 0x2B421420)
	e = goldenWord(e, "adds x0, sp, #1", 0xB10007E0)
	e = goldenWord(e, "adds x0, x1, #-1", 0xF1000420)
	e = goldenWord(e, "adds x0, x1, #0x1000", 0xB1400420)
	e = goldenWord(e, "adds x0, x1, w2, uxtw #1", 0xAB224420)
	e = goldenWord(e, "adds xzr, x0, x1", 0xAB01001F)
	e = goldenWord(e, "and sp, x0, #0xff", 0x92401C1F)
	e = goldenWord(e, "and sp, x1, #0xff", 0x92401C3F)
	e = goldenWord(e, "and w0, w1, #-2", 0x121F7820)
	e = goldenWord(e, "and w0, w1, #0xff", 0x12001C20)
	e = goldenWord(e, "and x0, x1, #0x8000000000000000", 0x92410020)
	e = goldenWord(e, "and x0, x1, #0xff", 0x92401C20)
	e = goldenWord(e, "and x0, x1, #0xffff0000ffff0000", 0x92103C20)
	e = goldenWord(e, "and x0, x1, x2", 0x8A020020)
	e = goldenWord(e, "and x0, x1, x2, lsl #3", 0x8A020C20)
	e = goldenWord(e, "and x0, x1, x2, lsl 3", 0x8A020C20)
	e = goldenWord(e, "and x0, x1, x2, ror #3", 0x8AC20C20)
	e = goldenWord(e, "ands x0, x1, #0xf0", 0xF27C0C20)
	e = goldenWord(e, "ands x0, x1, x2, lsr #1", 0xEA420420)
	e = goldenWord(e, "bic w0, w1, #0xff", 0x12185C20)
	e = goldenWord(e, "bic x0, x1, #1", 0x927FF820)
	e = goldenWord(e, "bic x0, x1, x2", 0x8A220020)
	e = goldenWord(e, "bics w0, w1, w2", 0x6A220020)
	e = goldenWord(e, "bics x0, x1, x2", 0xEA220020)
	e = goldenWord(e, "cmn sp, #1", 0xB10007FF)
	e = goldenWord(e, "cmn sp, x1", 0xAB2163FF)
	e = goldenWord(e, "cmn w0, #-5", 0x7100141F)
	e = goldenWord(e, "cmn w0, #1, lsl #12", 0x3140041F)
	e = goldenWord(e, "cmn x0, #-1", 0xF100041F)
	e = goldenWord(e, "cmn x0, w1, sxtb", 0xAB21801F)
	e = goldenWord(e, "cmn x0, x1, asr #3", 0xAB810C1F)
	e = goldenWord(e, "cmp sp, #16", 0xF10043FF)
	e = goldenWord(e, "cmp sp, x1", 0xEB2163FF)
	e = goldenWord(e, "cmp w0, #1", 0x7100041F)
	e = goldenWord(e, "cmp x0, #-1", 0xB100041F)
	e = goldenWord(e, "cmp x0, #-4096", 0xB140041F)
	e = goldenWord(e, "cmp x0, #0", 0xF100001F)
	e = goldenWord(e, "cmp x0, #1, lsl #12", 0xF140041F)
	e = goldenWord(e, "cmp x0, #4096", 0xF140041F)
	e = goldenWord(e, "cmp x0, w1, sxtw #2", 0xEB21C81F)
	e = goldenWord(e, "cmp x0, w1, uxtw", 0xEB21401F)
	e = goldenWord(e, "cmp x0, x1, lsl #3", 0xEB010C1F)
	e = goldenWord(e, "cmp x0, x1, lsl 3", 0xEB010C1F)
	return e
}

// Add/sub, logical and move lines clang accepts, chunk 1.
func TestGoldenDPAccepts1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "eon x0, x1, x2", 0xCA220020)
	e = goldenWord(e, "eon x0, x1, x2, ror #5", 0xCAE21420)
	e = goldenWord(e, "eor w0, w1, #0xaaaaaaaa", 0x5201F020)
	e = goldenWord(e, "eor x0, x1, #0x5555555555555555", 0xD200F020)
	e = goldenWord(e, "eor x0, x1, #3", 0xD2400420)
	e = goldenWord(e, "eor x0, x1, x2, asr #63", 0xCA82FC20)
	e = goldenWord(e, "mov fp, sp", 0x910003FD)
	e = goldenWord(e, "mov lr, x0", 0xAA0003FE)
	e = goldenWord(e, "mov sp, #1", 0xB24003FF)
	e = goldenWord(e, "mov sp, #16", 0xB27C03FF)
	e = goldenWord(e, "mov sp, sp", 0x910003FF)
	e = goldenWord(e, "mov sp, x0", 0x9100001F)
	e = goldenWord(e, "mov w0, #-1", 0x12800000)
	e = goldenWord(e, "mov w0, #0x12340000", 0x52A24680)
	e = goldenWord(e, "mov w0, #0x55555555", 0x3200F3E0)
