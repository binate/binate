	e = goldenWord(e, "tst w0, #0x80", 0x7219001F)
	return e
}

// Add/sub, logical and move lines clang accepts, chunk 2.
func TestGoldenDPAccepts2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "tst x0, #0xff", 0xF2401C1F)
	e = goldenWord(e, "tst x0, #1", 0xF240001F)
	e = goldenWord(e, "tst x0, x1", 0xEA01001F)
	e = goldenWord(e, "tst x0, x1, ror #4", 0xEAC1101F)
	return e
}
