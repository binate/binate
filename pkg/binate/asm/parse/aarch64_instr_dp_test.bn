	e = goldenWord(e, "mov w0, #0xfffffffe", 0x12800020)
	e = goldenWord(e, "mov w0, #0xffffffff", 0x12800000)
	e = goldenWord(e, "mov w0, w1", 0x2A0103E0)
	e = goldenWord(e, "mov w0, wsp", 0x110003E0)
	e = goldenWord(e, "mov w0, wzr", 0x2A1F03E0)
