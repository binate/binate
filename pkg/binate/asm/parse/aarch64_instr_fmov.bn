package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 scalar FMOV: register to register (`Fd, Fn` of one precision), between a
// general-purpose and an FP register (W with S, X with D, W / X with H), and the
// immediate `Fd, #imm`.  The immediate follows clang: a floating-point literal or an
// integer written in decimal digits (a leading zero does not make it octal here) is a
// value, optionally negative, that the 8-bit FP immediate must represent exactly — no
// rounding; a hexadecimal integer `0x00`..`0xff` (lowercase prefix) is the 8-bit
// encoding itself; and zero (not -0.0), which the 8-bit form cannot encode, is
// `FMOV Fd, WZR / XZR`.

// parseA64FMov parses and emits one scalar FMOV; l is positioned just after the
// mnemonic.
func parseA64FMov(p @Parser, l Lexer) {
	var tok Token
	l, tok = LexNext(l)
	var rd int = -1
	var dcls int = RC_NONE
	var ok bool = false
	l, tok, rd, dcls, ok = a64RegComma(p, l, tok)
	if !ok { return }
	var dt int = fpTypeOf(dcls)
	if tok.Kind == TOK_IDENT {
		rn, ncls := parseA64Reg(tok.Text)
		l, tok = LexNext(l)
		expectA64EOL(p, tok)
		if p.HasError { return }
		var nt int = fpTypeOf(ncls)
		if dt >= 0 && nt == dt {
			isa.FPDataProc1(p.Asm, isa.FP1_FMOV, dt, rd, rn)
		} else if dt >= 0 && (rcIsW(ncls) || rcIsX(ncls)) {
			isa.FMovGP(p.Asm, true, rcIsX(ncls), dt, rd, rn)
		} else if nt >= 0 && (rcIsW(dcls) || rcIsX(dcls)) {
			isa.FMovGP(p.Asm, false, rcIsX(dcls), nt, rd, rn)
		} else {
			setErr(p, "fmov takes two FP registers of one precision, or an FP and a W / X register")
		}
		return
	}
	if dt < 0 {
		setErr(p, "fmov with an immediate needs an H, S or D destination")
		return
	}
	var imm8 int = -1
	var zero bool = false
	l, tok, imm8, zero = parseFMovImm(p, l, tok)
	if p.HasError { return }
	expectA64EOL(p, tok)
	if p.HasError { return }
	if zero {
		isa.FMovGP(p.Asm, true, dt == isa.FT_D, dt, rd, 31)
		return
	}
	isa.FMovImm(p.Asm, dt, rd, imm8)
}

// parseFMovImm parses FMOV's immediate operand starting at tok (an optional '#', an
// optional '-', then a floating-point or integer literal), returning the token after
// it and either the 8-bit immediate or zero=true; p's error is set when the operand
// is malformed or its value has no 8-bit form.
func parseFMovImm(p @Parser, l Lexer, tok Token) (Lexer, Token, int, bool) {
	if tok.Kind == TOK_HASH { l, tok = LexNext(l) }
	var neg bool = tok.Kind == TOK_MINUS
	if neg { l, tok = LexNext(l) }
	var lit Token = tok
	l, tok = LexNext(l)
	var w uint64 = 0
	if lit.Kind == TOK_INT && len(lit.Text) > 1 && lit.Text[0] == '0' && lit.Text[1] == 'x' {
		if neg || lit.Ival < 0 || lit.Ival > 255 {
			setErr(p, "fmov: a hexadecimal immediate is the 8-bit encoding, 0x00..0xff")
			return l, tok, -1, false
		}
		return l, tok, cast(int, lit.Ival), false
	} else if lit.Kind == TOK_INT {
		// The integer's digits read in decimal (the lexer's octal value of a leading-
		// zero literal is not what clang takes here); a 0X / 0b / 0o literal is an error.
		var v uint64 = 0
		for i := 0; i < len(lit.Text); i++ {
			if !isDigit(lit.Text[i]) {
				setErr(p, "fmov: an integer immediate must be decimal digits (or 0x.., the encoding)")
				return l, tok, -1, false
			}
			if v <= 31 { v = v * 10 + cast(uint64, lit.Text[i]) - cast(uint64, '0') }
		}
		if v > 31 {
			setErr(p, "fmov: immediate not representable as an 8-bit floating-point value")
			return l, tok, -1, false
		}
		w = v * 128
	} else if lit.Kind == TOK_FLOAT {
		var okW bool = false
		w, okW = floatLitTimes128(lit.Text)
		if !okW {
			setErr(p, "fmov: immediate not representable as an 8-bit floating-point value")
			return l, tok, -1, false
		}
	} else {
		setErr(p, "fmov: expected a floating-point immediate")
		return l, tok, -1, false
	}
	if w == 0 {
		if neg { setErr(p, "fmov: -0.0 has no encoding") }
		return l, tok, -1, true
	}
	var imm8 int = fp8Imm(neg, w)
	if imm8 < 0 { setErr(p, "fmov: immediate not representable as an 8-bit floating-point value") }
	return l, tok, imm8, false
}
