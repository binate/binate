	e = goldenWord(e, "fmov h31, #19.00000000", 0x1EE6701F)
	e = goldenWord(e, "fmov s3, #0.15625000", 0x1E289003)
	e = goldenWord(e, "fmov h31, #0.15625000", 0x1EE8901F)
	e = goldenWord(e, "fmov s3, #0.32812500", 0x1E2AB003)
	e = goldenWord(e, "fmov h31, #0.32812500", 0x1EEAB01F)
	e = goldenWord(e, "fmov s3, #0.68750000", 0x1E2CD003)
	e = goldenWord(e, "fmov h31, #0.68750000", 0x1EECD01F)
	e = goldenWord(e, "fmov s3, #1.43750000", 0x1E2EF003)
	e = goldenWord(e, "fmov h31, #1.43750000", 0x1EEEF01F)
	e = goldenWord(e, "fmov s3, #-3.00000000", 0x1E311003)
	e = goldenWord(e, "fmov h31, #-3.00000000", 0x1EF1101F)
	e = goldenWord(e, "fmov s3, #-6.25000000", 0x1E333003)
	e = goldenWord(e, "fmov h31, #-6.25000000", 0x1EF3301F)
	e = goldenWord(e, "fmov s3, #-13.00000000", 0x1E355003)
	e = goldenWord(e, "fmov h31, #-13.00000000", 0x1EF5501F)
	e = goldenWord(e, "fmov s3, #-27.00000000", 0x1E377003)
	e = goldenWord(e, "fmov h31, #-27.00000000", 0x1EF7701F)
	e = goldenWord(e, "fmov s3, #-0.21875000", 0x1E399003)
	e = goldenWord(e, "fmov h31, #-0.21875000", 0x1EF9901F)
	e = goldenWord(e, "fmov s3, #-0.45312500", 0x1E3BB003)
	e = goldenWord(e, "fmov h31, #-0.45312500", 0x1EFBB01F)
	e = goldenWord(e, "fmov s3, #-0.93750000", 0x1E3DD003)
	e = goldenWord(e, "fmov h31, #-0.93750000", 0x1EFDD01F)
	e = goldenWord(e, "fmov s3, #-1.93750000", 0x1E3FF003)
	e = goldenWord(e, "fmov h31, #-1.93750000", 0x1EFFF01F)
	return e
}

// The other immediate spellings clang takes (a decimal integer as its value, a hex
// float, no '#'), zero as FMOV from the zero register, and the general-purpose moves.
func TestGoldenFMovForms() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fmov d0, #2", 0x1E601000)
	e = goldenWord(e, "fmov d0, #31", 0x1E67F000)
	e = goldenWord(e, "fmov d0, #-2", 0x1E701000)
	e = goldenWord(e, "fmov d0, #0x1.fp4", 0x1E67F000)
	e = goldenWord(e, "fmov d0, 1.5", 0x1E6F1000)
	e = goldenWord(e, "fmov d0, #1.0e1", 0x1E649000)
	e = goldenWord(e, "fmov d0, #010", 0x1E649000)
	e = goldenWord(e, "fmov d0, #017", 0x1E663000)
	e = goldenWord(e, "fmov d0, #01", 0x1E6E1000)
	e = goldenWord(e, "fmov d0, #00", 0x9E6703E0)
	e = goldenWord(e, "fmov d0, #0", 0x9E6703E0)
	e = goldenWord(e, "fmov d0, #0.0", 0x9E6703E0)
	e = goldenWord(e, "fmov s0, #0", 0x1E2703E0)
	e = goldenWord(e, "fmov h0, #0.0", 0x1EE703E0)
	e = goldenWord(e, "fmov w0, s1", 0x1E260020)
	e = goldenWord(e, "fmov s0, w1", 0x1E270020)
	e = goldenWord(e, "fmov x0, d1", 0x9E660020)
	e = goldenWord(e, "fmov d0, x1", 0x9E670020)
	e = goldenWord(e, "fmov w0, h1", 0x1EE60020)
	e = goldenWord(e, "fmov h0, w1", 0x1EE70020)
	e = goldenWord(e, "fmov x0, h1", 0x9EE60020)
	e = goldenWord(e, "fmov h0, x1", 0x9EE70020)
	e = goldenWord(e, "fmov s0, wzr", 0x1E2703E0)
	e = goldenWord(e, "fmov h0, wzr", 0x1EE703E0)
	e = goldenWord(e, "fmov wzr, s1", 0x1E26003F)
	e = goldenWord(e, "fmov xzr, d1", 0x9E66003F)
	return e
}

// Rejected as clang rejects them: a raw encoding from 0x100 up to 2^63 or negated, the
// raw form with a capital `0X`, a value with no 8-bit form (`#070` is decimal 70), -0.0,
// a binary integer, a parenthesized or '+'-signed literal, trailing operands, and
// register pairs of the wrong kinds.
func TestGoldenFMovRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fmov d0, #0x100")
	e = goldenReject(e, "fmov d0, #0X10")
	e = goldenReject(e, "fmov d0, #0XFF")
	e = goldenReject(e, "fmov d0, #-0x70")
	e = goldenReject(e, "fmov d0, #112")
	e = goldenReject(e, "fmov d0, #32")
	e = goldenReject(e, "fmov d0, #0.0625")
	e = goldenReject(e, "fmov d0, #15.75")
	e = goldenReject(e, "fmov d0, #-0.0")
	e = goldenReject(e, "fmov d0, #0b1110000")
	e = goldenReject(e, "fmov d0, #070")
	e = goldenReject(e, "fmov d0, #(1.5)")
	e = goldenReject(e, "fmov d0, #+1.0")
	e = goldenReject(e, "fmov d0, #1.5, lsl #0")
	e = goldenReject(e, "fmov w0, d1")
	e = goldenReject(e, "fmov x0, s1")
	e = goldenReject(e, "fmov d0, w1")
	e = goldenReject(e, "fmov s0, x1")
	e = goldenReject(e, "fmov d0, sp")
	e = goldenReject(e, "fmov sp, d0")
	e = goldenReject(e, "fmov w0, w1")
	e = goldenReject(e, "fmov q0, q1")
	e = goldenReject(e, "fmov w0, #1.0")
	return e
}
