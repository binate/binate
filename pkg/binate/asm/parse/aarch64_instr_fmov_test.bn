package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Every 8-bit FMOV immediate written as its value (the decimal objdump prints for it),
// which must assemble to the same word as the raw encoding — D for all 256, S and H
// for a sample — from clang (`-march=armv8.6-a+fp16`).

