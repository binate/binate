package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 scalar floating-point data processing on H / S / D registers: FMOV (its
// register, general-register and immediate forms, parsed in aarch64_instr_fmov.bn),
// FABS / FNEG / FSQRT, the FRINT* roundings, FCVT between precisions and BFCVT, the
// two-source FMUL … FNMUL, the three-source FMADD / FMSUB / FNMADD / FNMSUB, FCMP /
// FCMPE (against a register or `#0.0`), FCCMP / FCCMPE and FCSEL.  Every register of
// an instruction has one precision, except FCVT's (two different ones) and BFCVT's
// (`Hd, Sn`).  FADD, FSUB, FMUL, FDIV, FMAX, FMIN, FMAXNM and FMINNM with a vector
// destination are the Advanced SIMD three-same instructions (aarch64_instr_simd3fp.bn).

// fpTypeOf maps a scalar FP register class to its isa.FT_* precision, or -1.
func fpTypeOf(cls int) int {
	if cls == RC_H { return isa.FT_H }
	if cls == RC_S { return isa.FT_S }
	if cls == RC_D { return isa.FT_D }
	return -1
}

// fp1Of returns the isa.FP1_* operation of a one-source mnemonic, or -1.
func fp1Of(m *[]readonly char) int {
	if mnemIs(m, "fmov") { return isa.FP1_FMOV }
	if mnemIs(m, "fabs") { return isa.FP1_FABS }
	if mnemIs(m, "fneg") { return isa.FP1_FNEG }
	if mnemIs(m, "fsqrt") { return isa.FP1_FSQRT }
	if mnemIs(m, "frintn") { return isa.FP1_FRINTN }
	if mnemIs(m, "frintp") { return isa.FP1_FRINTP }
	if mnemIs(m, "frintm") { return isa.FP1_FRINTM }
	if mnemIs(m, "frintz") { return isa.FP1_FRINTZ }
	if mnemIs(m, "frinta") { return isa.FP1_FRINTA }
	if mnemIs(m, "frintx") { return isa.FP1_FRINTX }
	if mnemIs(m, "frinti") { return isa.FP1_FRINTI }
	if mnemIs(m, "frint32z") { return isa.FP1_FRINT32Z }
	if mnemIs(m, "frint32x") { return isa.FP1_FRINT32X }
	if mnemIs(m, "frint64z") { return isa.FP1_FRINT64Z }
	if mnemIs(m, "frint64x") { return isa.FP1_FRINT64X }
	return -1
}

// fp2Of returns the isa.FP2_* operation of a two-source mnemonic, or -1.
func fp2Of(m *[]readonly char) int {
	if mnemIs(m, "fmul") { return isa.FP2_FMUL }
	if mnemIs(m, "fdiv") { return isa.FP2_FDIV }
	if mnemIs(m, "fadd") { return isa.FP2_FADD }
	if mnemIs(m, "fsub") { return isa.FP2_FSUB }
	if mnemIs(m, "fmax") { return isa.FP2_FMAX }
	if mnemIs(m, "fmin") { return isa.FP2_FMIN }
	if mnemIs(m, "fmaxnm") { return isa.FP2_FMAXNM }
	if mnemIs(m, "fminnm") { return isa.FP2_FMINNM }
	if mnemIs(m, "fnmul") { return isa.FP2_FNMUL }
	return -1
}

// fp3Of returns the isa.FP3_* operation of a three-source mnemonic, or -1.
func fp3Of(m *[]readonly char) int {
	if mnemIs(m, "fmadd") { return isa.FP3_FMADD }
	if mnemIs(m, "fmsub") { return isa.FP3_FMSUB }
	if mnemIs(m, "fnmadd") { return isa.FP3_FNMADD }
	if mnemIs(m, "fnmsub") { return isa.FP3_FNMSUB }
	return -1
}

// isA64FP reports whether mnem is one of this file's instructions.
func isA64FP(m *[]readonly char) bool {
	return fp1Of(m) >= 0 || fp2Of(m) >= 0 || fp3Of(m) >= 0 || mnemIs(m, "fcvt") ||
			mnemIs(m, "bfcvt") || mnemIs(m, "fcmp") || mnemIs(m, "fcmpe") || mnemIs(m, "fccmp") ||
			mnemIs(m, "fccmpe") || mnemIs(m, "fcsel")
}

// fpItemsType checks that items [0, n) of its are FP registers of one precision and
// returns it (isa.FT_*), or -1 with p's error set.
func fpItemsType(p @Parser, its a64Items, n int) int {
	var ft int = -1
	for i := 0; i < n; i++ {
		var t int = -1
		if its.It[i].Kind == IT_REG { t = fpTypeOf(its.It[i].Cls) }
		if t < 0 || (i > 0 && t != ft) {
			setErr(p, "expected H, S or D registers, all of one precision")
			return -1
		}
		ft = t
	}
	return ft
}

// emitA64FP parses and emits one of this file's instructions (l positioned just
// after the mnemonic); returns false when mnem is not one.
func emitA64FP(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !isA64FP(mnem) { return false }
	if mnemIs(mnem, "fmov") {
		parseA64FMov(p, l)
		return true
	}
	if mnemIs(mnem, "fcmp") || mnemIs(mnem, "fcmpe") {
		parseA64FPCompare(p, l, mnemIs(mnem, "fcmpe"))
		return true
	}
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if its.N > 0 && its.It[0].Kind == IT_VREG && emitA64SimdFP3Items(p, mnem, its) { return true }
	var reg0 int = its.It[0].Reg
	if mnemIs(mnem, "fcvt") || mnemIs(mnem, "bfcvt") {
		if !dpExpectCount(p, its, 2) { return true }
		var to int = -1
		var from int = -1
		if its.It[0].Kind == IT_REG { to = fpTypeOf(its.It[0].Cls) }
		if its.It[1].Kind == IT_REG { from = fpTypeOf(its.It[1].Cls) }
		if mnemIs(mnem, "bfcvt") {
			if to != isa.FT_H || from != isa.FT_S {
				setErr(p, "bfcvt takes Hd, Sn")
				return true
			}
			isa.BFConvert(p.Asm, reg0, its.It[1].Reg)
			return true
		}
		if to < 0 || from < 0 || to == from {
			setErr(p, "fcvt converts between two different H / S / D precisions")
			return true
		}
		isa.FPConvert(p.Asm, to, from, reg0, its.It[1].Reg)
		return true
	}
	var op int = fp1Of(mnem)
	if op >= 0 {
		if !dpExpectCount(p, its, 2) { return true }
		var ft1 int = fpItemsType(p, its, 2)
		if ft1 >= 0 { isa.FPDataProc1(p.Asm, op, ft1, reg0, its.It[1].Reg) }
		return true
	}
	op = fp2Of(mnem)
	if op >= 0 {
		if !dpExpectCount(p, its, 3) { return true }
		var ft2 int = fpItemsType(p, its, 3)
		if ft2 >= 0 { isa.FPDataProc2(p.Asm, op, ft2, reg0, its.It[1].Reg, its.It[2].Reg) }
		return true
	}
	op = fp3Of(mnem)
	if op >= 0 {
		if !dpExpectCount(p, its, 4) { return true }
		var ft3 int = fpItemsType(p, its, 4)
		if ft3 >= 0 {
			isa.FPDataProc3(p.Asm, op, ft3, reg0, its.It[1].Reg, its.It[2].Reg, its.It[3].Reg)
		}
		return true
	}
	if mnemIs(mnem, "fcsel") {
		if !dpExpectCount(p, its, 4) { return true }
		var ftc int = fpItemsType(p, its, 3)
		if ftc < 0 { return true }
		if its.It[3].Kind != IT_COND {
			setErr(p, "fcsel takes Fd, Fn, Fm, cond")
			return true
		}
		isa.FPCondSelect(p.Asm, ftc, reg0, its.It[1].Reg, its.It[2].Reg, its.It[3].Cond)
		return true
	}
	// fccmp / fccmpe
	if !dpExpectCount(p, its, 4) { return true }
	var ftq int = fpItemsType(p, its, 2)
	if ftq < 0 { return true }
	if its.It[2].Kind != IT_IMM || its.It[3].Kind != IT_COND || its.It[2].Imm < 0 ||
			its.It[2].Imm > 15 {
		setErr(p, "fccmp takes Fn, Fm, #nzcv (0..15), cond")
		return true
	}
	isa.FPCondCompare(p.Asm, mnemIs(mnem, "fccmpe"), ftq, reg0, its.It[1].Reg,
			cast(int, its.It[2].Imm), its.It[3].Cond)
	return true
}

// parseA64FPCompare parses and emits FCMP / FCMPE `Fn, Fm` or `Fn, #0.0` (the zero may
// be written without '#', as any spelling of a floating-point zero, but not as an
// integer); l is positioned just after the mnemonic.
func parseA64FPCompare(p @Parser, l Lexer, signaling bool) {
	var tok Token
	l, tok = LexNext(l)
	var rn int = -1
	var cls int = RC_NONE
	var ok bool = false
	l, tok, rn, cls, ok = a64RegComma(p, l, tok)
	if !ok { return }
	var ft int = fpTypeOf(cls)
	if ft < 0 {
		setErr(p, "expected an H, S or D register")
		return
	}
	if tok.Kind == TOK_IDENT {
		rm, mcls := parseA64Reg(tok.Text)
		if fpTypeOf(mcls) != ft {
			setErr(p, "expected a register of the same precision, or #0.0")
			return
		}
		l, tok = LexNext(l)
		expectA64EOL(p, tok)
		if !p.HasError { isa.FPCompare(p.Asm, signaling, ft, rn, rm, false) }
		return
	}
	if tok.Kind == TOK_HASH { l, tok = LexNext(l) }
	if tok.Kind != TOK_FLOAT || !floatLitIsZero(tok.Text) {
		setErr(p, "expected floating-point constant #0.0")
		return
	}
	l, tok = LexNext(l)
	expectA64EOL(p, tok)
	if !p.HasError { isa.FPCompare(p.Asm, signaling, ft, rn, 0, true) }
}
