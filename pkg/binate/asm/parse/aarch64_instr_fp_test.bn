package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the scalar floating-point data-processing instructions at every
// precision they have, from clang (`clang -c -target aarch64-linux-gnu
// -march=armv8.6-a+fp16`), objdump'd.

func TestGoldenFPScalar1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fmov h0, h1", 0x1EE04020)
	e = goldenWord(e, "fmov s0, s1", 0x1E204020)
	e = goldenWord(e, "fmov d0, d1", 0x1E604020)
	e = goldenWord(e, "fabs h0, h1", 0x1EE0C020)
	e = goldenWord(e, "fabs s0, s1", 0x1E20C020)
	e = goldenWord(e, "fabs d0, d1", 0x1E60C020)
	e = goldenWord(e, "fneg h0, h1", 0x1EE14020)
	e = goldenWord(e, "fneg s0, s1", 0x1E214020)
	e = goldenWord(e, "fneg d0, d1", 0x1E614020)
	e = goldenWord(e, "fsqrt h0, h1", 0x1EE1C020)
	e = goldenWord(e, "fsqrt s0, s1", 0x1E21C020)
	e = goldenWord(e, "fsqrt d0, d1", 0x1E61C020)
	e = goldenWord(e, "frintn h0, h1", 0x1EE44020)
	e = goldenWord(e, "frintn s0, s1", 0x1E244020)
	e = goldenWord(e, "frintn d0, d1", 0x1E644020)
	e = goldenWord(e, "frintp h0, h1", 0x1EE4C020)
	e = goldenWord(e, "frintp s0, s1", 0x1E24C020)
	e = goldenWord(e, "frintp d0, d1", 0x1E64C020)
	e = goldenWord(e, "frintm h0, h1", 0x1EE54020)
	e = goldenWord(e, "frintm s0, s1", 0x1E254020)
	e = goldenWord(e, "frintm d0, d1", 0x1E654020)
	e = goldenWord(e, "frintz h0, h1", 0x1EE5C020)
	e = goldenWord(e, "frintz s0, s1", 0x1E25C020)
	e = goldenWord(e, "frintz d0, d1", 0x1E65C020)
	e = goldenWord(e, "frinta h0, h1", 0x1EE64020)
	e = goldenWord(e, "frinta s0, s1", 0x1E264020)
	e = goldenWord(e, "frinta d0, d1", 0x1E664020)
	e = goldenWord(e, "frintx h0, h1", 0x1EE74020)
	e = goldenWord(e, "frintx s0, s1", 0x1E274020)
	e = goldenWord(e, "frintx d0, d1", 0x1E674020)
	e = goldenWord(e, "frinti h0, h1", 0x1EE7C020)
	e = goldenWord(e, "frinti s0, s1", 0x1E27C020)
	e = goldenWord(e, "frinti d0, d1", 0x1E67C020)
	e = goldenWord(e, "frint32z s0, s1", 0x1E284020)
	e = goldenWord(e, "frint32z d0, d1", 0x1E684020)
	e = goldenWord(e, "frint32x s0, s1", 0x1E28C020)
	e = goldenWord(e, "frint32x d0, d1", 0x1E68C020)
	e = goldenWord(e, "frint64z s0, s1", 0x1E294020)
	e = goldenWord(e, "frint64z d0, d1", 0x1E694020)
	e = goldenWord(e, "frint64x s0, s1", 0x1E29C020)
	e = goldenWord(e, "frint64x d0, d1", 0x1E69C020)
	e = goldenWord(e, "fcvt h0, s1", 0x1E23C020)
	e = goldenWord(e, "fcvt h0, d1", 0x1E63C020)
	e = goldenWord(e, "fcvt s0, h1", 0x1EE24020)
	e = goldenWord(e, "fcvt s0, d1", 0x1E624020)
	e = goldenWord(e, "fcvt d0, h1", 0x1EE2C020)
	e = goldenWord(e, "fcvt d0, s1", 0x1E22C020)
	e = goldenWord(e, "bfcvt h0, s1", 0x1E634020)
	e = goldenWord(e, "fmul h0, h1, h2", 0x1EE20820)
	e = goldenWord(e, "fmul s0, s1, s2", 0x1E220820)
	e = goldenWord(e, "fmul d0, d1, d2", 0x1E620820)
	e = goldenWord(e, "fdiv h0, h1, h2", 0x1EE21820)
	e = goldenWord(e, "fdiv s0, s1, s2", 0x1E221820)
	e = goldenWord(e, "fdiv d0, d1, d2", 0x1E621820)
	return e
}

func TestGoldenFPScalar2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fadd h0, h1, h2", 0x1EE22820)
	e = goldenWord(e, "fadd s0, s1, s2", 0x1E222820)
	e = goldenWord(e, "fadd d0, d1, d2", 0x1E622820)
	e = goldenWord(e, "fsub h0, h1, h2", 0x1EE23820)
	e = goldenWord(e, "fsub s0, s1, s2", 0x1E223820)
	e = goldenWord(e, "fsub d0, d1, d2", 0x1E623820)
	e = goldenWord(e, "fmax h0, h1, h2", 0x1EE24820)
	e = goldenWord(e, "fmax s0, s1, s2", 0x1E224820)
	e = goldenWord(e, "fmax d0, d1, d2", 0x1E624820)
	e = goldenWord(e, "fmin h0, h1, h2", 0x1EE25820)
	e = goldenWord(e, "fmin s0, s1, s2", 0x1E225820)
	e = goldenWord(e, "fmin d0, d1, d2", 0x1E625820)
	e = goldenWord(e, "fmaxnm h0, h1, h2", 0x1EE26820)
	e = goldenWord(e, "fmaxnm s0, s1, s2", 0x1E226820)
	e = goldenWord(e, "fmaxnm d0, d1, d2", 0x1E626820)
	e = goldenWord(e, "fminnm h0, h1, h2", 0x1EE27820)
	e = goldenWord(e, "fminnm s0, s1, s2", 0x1E227820)
	e = goldenWord(e, "fminnm d0, d1, d2", 0x1E627820)
	e = goldenWord(e, "fnmul h0, h1, h2", 0x1EE28820)
	e = goldenWord(e, "fnmul s0, s1, s2", 0x1E228820)
	e = goldenWord(e, "fnmul d0, d1, d2", 0x1E628820)
	e = goldenWord(e, "fmadd h0, h1, h2, h3", 0x1FC20C20)
	e = goldenWord(e, "fmadd s0, s1, s2, s3", 0x1F020C20)
	e = goldenWord(e, "fmadd d0, d1, d2, d3", 0x1F420C20)
	e = goldenWord(e, "fmsub h0, h1, h2, h3", 0x1FC28C20)
	e = goldenWord(e, "fmsub s0, s1, s2, s3", 0x1F028C20)
	e = goldenWord(e, "fmsub d0, d1, d2, d3", 0x1F428C20)
	e = goldenWord(e, "fnmadd h0, h1, h2, h3", 0x1FE20C20)
	e = goldenWord(e, "fnmadd s0, s1, s2, s3", 0x1F220C20)
	e = goldenWord(e, "fnmadd d0, d1, d2, d3", 0x1F620C20)
	e = goldenWord(e, "fnmsub h0, h1, h2, h3", 0x1FE28C20)
	e = goldenWord(e, "fnmsub s0, s1, s2, s3", 0x1F228C20)
	e = goldenWord(e, "fnmsub d0, d1, d2, d3", 0x1F628C20)
	e = goldenWord(e, "fcmp h0, h1", 0x1EE12000)
	e = goldenWord(e, "fcmp h0, #0.0", 0x1EE02008)
	e = goldenWord(e, "fcmp s0, s1", 0x1E212000)
	e = goldenWord(e, "fcmp s0, #0.0", 0x1E202008)
	e = goldenWord(e, "fcmp d0, d1", 0x1E612000)
	e = goldenWord(e, "fcmp d0, #0.0", 0x1E602008)
	e = goldenWord(e, "fcmpe h0, h1", 0x1EE12010)
	e = goldenWord(e, "fcmpe h0, #0.0", 0x1EE02018)
	e = goldenWord(e, "fcmpe s0, s1", 0x1E212010)
	e = goldenWord(e, "fcmpe s0, #0.0", 0x1E202018)
	e = goldenWord(e, "fcmpe d0, d1", 0x1E612010)
	e = goldenWord(e, "fcmpe d0, #0.0", 0x1E602018)
	e = goldenWord(e, "fccmp h0, h1, #5, ne", 0x1EE11405)
	e = goldenWord(e, "fccmp s0, s1, #5, ne", 0x1E211405)
	e = goldenWord(e, "fccmp d0, d1, #5, ne", 0x1E611405)
	e = goldenWord(e, "fccmpe h0, h1, #5, ne", 0x1EE11415)
	e = goldenWord(e, "fccmpe s0, s1, #5, ne", 0x1E211415)
	e = goldenWord(e, "fccmpe d0, d1, #5, ne", 0x1E611415)
	e = goldenWord(e, "fcsel h0, h1, h2, lt", 0x1EE2BC20)
	e = goldenWord(e, "fcsel s0, s1, s2, lt", 0x1E22BC20)
	e = goldenWord(e, "fcsel d0, d1, d2, lt", 0x1E62BC20)
	return e
}

// Spellings clang accepts: the compare-with-zero operand as any floating-point zero
// literal (with or without '#'), FCSEL on al / nv, registers 29-31, and upper case.
func TestGoldenFPScalarEdges() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fcmp s0, #0.0e0", 0x1E202008)
	e = goldenWord(e, "fcmp s0, 0.0", 0x1E202008)
	e = goldenWord(e, "fcmp s0, #0.", 0x1E202008)
	e = goldenWord(e, "fcmp s0, #.0", 0x1E202008)
	e = goldenWord(e, "fcmp s0, #0.00", 0x1E202008)
	e = goldenWord(e, "fcmp s0, #0.0E+5", 0x1E202008)
	e = goldenWord(e, "fcmp s0, #0x0.0p0", 0x1E202008)
	e = goldenWord(e, "fcmp s0, # 0.0", 0x1E202008)
	e = goldenWord(e, "fcsel s0, s1, s2, al", 0x1E22EC20)
	e = goldenWord(e, "fcsel s0, s1, s2, nv", 0x1E22FC20)
	e = goldenWord(e, "FADD S0, S1, S2", 0x1E222820)
	e = goldenWord(e, "fmax d31, d30, d29", 0x1E7D4BDF)
	e = goldenWord(e, "fnmul h31, h0, h31", 0x1EFF881F)
	return e
}

// Rejected as clang rejects them: mixed precisions (other than FCVT's), a same-
// precision FCVT, BFCVT from anything but S to H, FRINT32 / 64 on H, B / Q / V / GP
// registers, a compare against anything but a floating-point zero, and an nzcv out of
// range.
func TestGoldenFPScalarRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcmp s0, #0")
	e = goldenReject(e, "fcmp s0, #-0.0")
	e = goldenReject(e, "fcmp s0, #1.0")
	e = goldenReject(e, "fcmp s0, #0x0")
	e = goldenReject(e, "fcmp s0, #00.0")
	e = goldenReject(e, "fcmp s0, #0e0")
	e = goldenReject(e, "fcmp s0, #0.0f")
	e = goldenReject(e, "fcmp s0, d1")
	e = goldenReject(e, "fadd s0, s1, d2")
	e = goldenReject(e, "fadd v0, v1, v2")
	e = goldenReject(e, "fmov s0, d1")
	e = goldenReject(e, "frint32z h0, h1")
	e = goldenReject(e, "fcvt s0, s1")
	e = goldenReject(e, "bfcvt h0, d1")
	e = goldenReject(e, "bfcvt s0, s1")
	e = goldenReject(e, "fccmp s0, s1, #16, eq")
	e = goldenReject(e, "fccmp s0, #0.0, #0, eq")
	e = goldenReject(e, "fmadd s0, s1, s2, d3")
	e = goldenReject(e, "fsqrt q0, q1")
	e = goldenReject(e, "fabs b0, b1")
	e = goldenReject(e, "fadd x0, x1, x2")
	e = goldenReject(e, "fcsel s0, s1, s2")
	e = goldenReject(e, "fcmp s0, s1, s2")
	return e
}
