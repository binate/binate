package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 scalar conversions between floating-point values and integers: FCVT{N,A,P,M,
// Z}{S,U} `Wd|Xd, Hn|Sn|Dn`, SCVTF / UCVTF `Hd|Sd|Dd, Wn|Xn`, the fixed-point forms of
// FCVTZS / FCVTZU / SCVTF / UCVTF with a trailing `#fbits` (1..32 for a W register,
// 1..64 for X), FJCVTZS `Wd, Dn`, and (FEAT_FPRCVT) the same conversions with the
// integer in an S or D register of a different size from the FP value (`fcvtzs s0,
// d1`, `scvtf d0, s1`).  The same-size FP-register forms (`fcvtzs s0, s1`, and with
// `#fbits`) and the vector forms are Advanced SIMD instructions
// (aarch64_instr_simd2fcvt.bn).

// fpIntOf returns the isa.FI_* conversion of a mnemonic, or -1.
func fpIntOf(m *[]readonly char) int {
	if mnemIs(m, "fcvtns") { return isa.FI_FCVTNS }
	if mnemIs(m, "fcvtnu") { return isa.FI_FCVTNU }
	if mnemIs(m, "fcvtas") { return isa.FI_FCVTAS }
	if mnemIs(m, "fcvtau") { return isa.FI_FCVTAU }
	if mnemIs(m, "fcvtps") { return isa.FI_FCVTPS }
	if mnemIs(m, "fcvtpu") { return isa.FI_FCVTPU }
	if mnemIs(m, "fcvtms") { return isa.FI_FCVTMS }
	if mnemIs(m, "fcvtmu") { return isa.FI_FCVTMU }
	if mnemIs(m, "fcvtzs") { return isa.FI_FCVTZS }
	if mnemIs(m, "fcvtzu") { return isa.FI_FCVTZU }
	if mnemIs(m, "scvtf") { return isa.FI_SCVTF }
	if mnemIs(m, "ucvtf") { return isa.FI_UCVTF }
	return -1
}

// emitA64FPInt parses and emits one of this file's instructions (l positioned just
// after the mnemonic); returns false when mnem is not one.
func emitA64FPInt(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var op int = fpIntOf(mnem)
	var fj bool = mnemIs(mnem, "fjcvtzs")
	if op < 0 && !fj { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if !fj && isSimdFCvtShape(its) && emitA64SimdFCvtItems(p, mnem, its) { return true }
	if its.N != 2 && its.N != 3 {
		setErr(p, "wrong number of operands")
		return true
	}
	var toFP bool = op == isa.FI_SCVTF || op == isa.FI_UCVTF
	var gi int = 0 // the integer operand's index
	var fi int = 1 // the FP operand's index
	if toFP {
		gi = 1
		fi = 0
	}
	if !fj && its.N == 2 && its.It[gi].Kind == IT_REG && fpTypeOf(its.It[gi].Cls) >= 0 {
		emitA64FPRegInt(p, op, its, gi, fi)
		return true
	}
	var gcls int = RC_NONE
	if its.It[gi].Kind == IT_REG { gcls = its.It[gi].Cls }
	var ft int = -1
	if its.It[fi].Kind == IT_REG { ft = fpTypeOf(its.It[fi].Cls) }
	if !(rcIsW(gcls) || rcIsX(gcls)) || ft < 0 {
		setErr(p, "expected a W or X register and an H, S or D register")
		return true
	}
	var sf bool = rcIsX(gcls)
	var rd int = its.It[0].Reg
	var rn int = its.It[1].Reg
	if fj {
		if its.N != 2 || sf || ft != isa.FT_D {
			setErr(p, "fjcvtzs takes Wd, Dn")
			return true
		}
		isa.FJCvtZS(p.Asm, rd, rn)
		return true
	}
	if its.N == 2 {
		isa.FPIntConvert(p.Asm, op, sf, ft, rd, rn)
		return true
	}
	if op != isa.FI_FCVTZS && op != isa.FI_FCVTZU && !toFP {
		setErr(p, "only fcvtzs / fcvtzu / scvtf / ucvtf have a fixed-point form")
		return true
	}
	if its.It[2].Kind != IT_IMM || !intFits(its.It[2].Imm) {
		setErr(p, "expected #fbits (1..32 for W, 1..64 for X)")
		return true
	}
	isa.FPFixedConvert(p.Asm, op, sf, ft, rd, rn, cast(int, its.It[2].Imm))
	return true
}

// fpRegIntOf maps an isa.FI_* conversion to its isa.FR_* form (the integer held in an FP
// register).
func fpRegIntOf(op int) int {
	if op == isa.FI_FCVTNS { return isa.FR_FCVTNS }
	if op == isa.FI_FCVTNU { return isa.FR_FCVTNU }
	if op == isa.FI_FCVTPS { return isa.FR_FCVTPS }
	if op == isa.FI_FCVTPU { return isa.FR_FCVTPU }
	if op == isa.FI_FCVTMS { return isa.FR_FCVTMS }
	if op == isa.FI_FCVTMU { return isa.FR_FCVTMU }
	if op == isa.FI_FCVTZS { return isa.FR_FCVTZS }
	if op == isa.FI_FCVTZU { return isa.FR_FCVTZU }
	if op == isa.FI_FCVTAS { return isa.FR_FCVTAS }
	if op == isa.FI_FCVTAU { return isa.FR_FCVTAU }
	if op == isa.FI_SCVTF { return isa.FR_SCVTF }
	return isa.FR_UCVTF
}

// emitA64FPRegInt emits a conversion whose integer operand (item gi) is an FP register:
// it must be S (32-bit) or D (64-bit) and differ in size from the FP operand (item fi) —
// a same-size pair is the Advanced SIMD scalar form, which emitA64FPInt routes there.
func emitA64FPRegInt(p @Parser, op int, its a64Items, gi int, fi int) {
	var icls int = its.It[gi].Cls
	var ft int = -1
	if its.It[fi].Kind == IT_REG { ft = fpTypeOf(its.It[fi].Cls) }
	if (icls != RC_S && icls != RC_D) || ft < 0 {
		setErr(p, "expected an S or D register for the integer and an H, S or D register")
		return
	}
	var sf bool = icls == RC_D
	isa.FPRegIntConvert(p.Asm, fpRegIntOf(op), sf, ft, its.It[0].Reg, its.It[1].Reg)
}
