package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the FP / integer conversions (every rounding, signedness, register
// width and precision; the fixed-point forms at their fraction-bit limits) and
// FJCVTZS, from clang (`clang -c -target aarch64-linux-gnu -march=armv8.6-a+fp16`).

func TestGoldenFPIntConvert1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fcvtns w0, h1", 0x1EE00020)
	e = goldenWord(e, "fcvtns w0, s1", 0x1E200020)
	e = goldenWord(e, "fcvtns w0, d1", 0x1E600020)
	e = goldenWord(e, "fcvtns x0, h1", 0x9EE00020)
	e = goldenWord(e, "fcvtns x0, s1", 0x9E200020)
	e = goldenWord(e, "fcvtns x0, d1", 0x9E600020)
	e = goldenWord(e, "fcvtnu w0, h1", 0x1EE10020)
	e = goldenWord(e, "fcvtnu w0, s1", 0x1E210020)
	e = goldenWord(e, "fcvtnu w0, d1", 0x1E610020)
	e = goldenWord(e, "fcvtnu x0, h1", 0x9EE10020)
	e = goldenWord(e, "fcvtnu x0, s1", 0x9E210020)
	e = goldenWord(e, "fcvtnu x0, d1", 0x9E610020)
	e = goldenWord(e, "fcvtas w0, h1", 0x1EE40020)
	e = goldenWord(e, "fcvtas w0, s1", 0x1E240020)
	e = goldenWord(e, "fcvtas w0, d1", 0x1E640020)
	e = goldenWord(e, "fcvtas x0, h1", 0x9EE40020)
	e = goldenWord(e, "fcvtas x0, s1", 0x9E240020)
	e = goldenWord(e, "fcvtas x0, d1", 0x9E640020)
	e = goldenWord(e, "fcvtau w0, h1", 0x1EE50020)
	e = goldenWord(e, "fcvtau w0, s1", 0x1E250020)
	e = goldenWord(e, "fcvtau w0, d1", 0x1E650020)
	e = goldenWord(e, "fcvtau x0, h1", 0x9EE50020)
	e = goldenWord(e, "fcvtau x0, s1", 0x9E250020)
	e = goldenWord(e, "fcvtau x0, d1", 0x9E650020)
	e = goldenWord(e, "fcvtps w0, h1", 0x1EE80020)
	e = goldenWord(e, "fcvtps w0, s1", 0x1E280020)
	e = goldenWord(e, "fcvtps w0, d1", 0x1E680020)
	e = goldenWord(e, "fcvtps x0, h1", 0x9EE80020)
	e = goldenWord(e, "fcvtps x0, s1", 0x9E280020)
	e = goldenWord(e, "fcvtps x0, d1", 0x9E680020)
	e = goldenWord(e, "fcvtpu w0, h1", 0x1EE90020)
	e = goldenWord(e, "fcvtpu w0, s1", 0x1E290020)
	e = goldenWord(e, "fcvtpu w0, d1", 0x1E690020)
	e = goldenWord(e, "fcvtpu x0, h1", 0x9EE90020)
	e = goldenWord(e, "fcvtpu x0, s1", 0x9E290020)
	e = goldenWord(e, "fcvtpu x0, d1", 0x9E690020)
	e = goldenWord(e, "fcvtms w0, h1", 0x1EF00020)
	e = goldenWord(e, "fcvtms w0, s1", 0x1E300020)
	e = goldenWord(e, "fcvtms w0, d1", 0x1E700020)
	e = goldenWord(e, "fcvtms x0, h1", 0x9EF00020)
	e = goldenWord(e, "fcvtms x0, s1", 0x9E300020)
	e = goldenWord(e, "fcvtms x0, d1", 0x9E700020)
	e = goldenWord(e, "fcvtmu w0, h1", 0x1EF10020)
	e = goldenWord(e, "fcvtmu w0, s1", 0x1E310020)
	e = goldenWord(e, "fcvtmu w0, d1", 0x1E710020)
	e = goldenWord(e, "fcvtmu x0, h1", 0x9EF10020)
	e = goldenWord(e, "fcvtmu x0, s1", 0x9E310020)
	e = goldenWord(e, "fcvtmu x0, d1", 0x9E710020)
	e = goldenWord(e, "fcvtzs w0, h1", 0x1EF80020)
	e = goldenWord(e, "fcvtzs w0, s1", 0x1E380020)
	e = goldenWord(e, "fcvtzs w0, d1", 0x1E780020)
	e = goldenWord(e, "fcvtzs x0, h1", 0x9EF80020)
	e = goldenWord(e, "fcvtzs x0, s1", 0x9E380020)
	e = goldenWord(e, "fcvtzs x0, d1", 0x9E780020)
	e = goldenWord(e, "fcvtzu w0, h1", 0x1EF90020)
	e = goldenWord(e, "fcvtzu w0, s1", 0x1E390020)
