	e = goldenWord(e, "fcvtzu w0, d1, #1", 0x1E59FC20)
	e = goldenWord(e, "fcvtzu w0, d1, #32", 0x1E598020)
	e = goldenWord(e, "fcvtzu x0, h1, #1", 0x9ED9FC20)
	e = goldenWord(e, "fcvtzu x0, h1, #64", 0x9ED90020)
	e = goldenWord(e, "fcvtzu x0, s1, #1", 0x9E19FC20)
	e = goldenWord(e, "fcvtzu x0, s1, #64", 0x9E190020)
	e = goldenWord(e, "fcvtzu x0, d1, #1", 0x9E59FC20)
	e = goldenWord(e, "fcvtzu x0, d1, #64", 0x9E590020)
	e = goldenWord(e, "scvtf h0, w1, #1", 0x1EC2FC20)
	e = goldenWord(e, "scvtf h0, w1, #32", 0x1EC28020)
	e = goldenWord(e, "scvtf s0, w1, #1", 0x1E02FC20)
	e = goldenWord(e, "scvtf s0, w1, #32", 0x1E028020)
	e = goldenWord(e, "scvtf d0, w1, #1", 0x1E42FC20)
	e = goldenWord(e, "scvtf d0, w1, #32", 0x1E428020)
	e = goldenWord(e, "scvtf h0, x1, #1", 0x9EC2FC20)
