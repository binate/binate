	e = goldenWord(e, "fcvtzs w0, s1, #1", 0x1E18FC20)
	e = goldenWord(e, "fcvtzs w0, s1, #32", 0x1E188020)
	e = goldenWord(e, "fcvtzs w0, d1, #1", 0x1E58FC20)
	e = goldenWord(e, "fcvtzs w0, d1, #32", 0x1E588020)
	e = goldenWord(e, "fcvtzs x0, h1, #1", 0x9ED8FC20)
