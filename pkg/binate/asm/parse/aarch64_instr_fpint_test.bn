	e = goldenWord(e, "ucvtf d0, w1, #32", 0x1E438020)
	e = goldenWord(e, "ucvtf h0, x1, #1", 0x9EC3FC20)
	e = goldenWord(e, "ucvtf h0, x1, #64", 0x9EC30020)
	e = goldenWord(e, "ucvtf s0, x1, #1", 0x9E03FC20)
	e = goldenWord(e, "ucvtf s0, x1, #64", 0x9E030020)
