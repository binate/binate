// FEAT_FPRCVT: the integer in an S or D register of a different size from the FP value
// (clang `-march=armv9.6-a+fprcvt+fp16`).
func TestGoldenFPRegIntConvert() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fcvtns s0, h1", 0x1EEA0020)
	e = goldenWord(e, "fcvtns s0, d1", 0x1E6A0020)
	e = goldenWord(e, "fcvtns d0, h1", 0x9EEA0020)
	e = goldenWord(e, "fcvtns d0, s1", 0x9E2A0020)
	e = goldenWord(e, "fcvtnu s0, h1", 0x1EEB0020)
	e = goldenWord(e, "fcvtnu s0, d1", 0x1E6B0020)
	e = goldenWord(e, "fcvtnu d0, h1", 0x9EEB0020)
	e = goldenWord(e, "fcvtnu d0, s1", 0x9E2B0020)
	e = goldenWord(e, "fcvtas s0, h1", 0x1EFA0020)
	e = goldenWord(e, "fcvtas s0, d1", 0x1E7A0020)
	e = goldenWord(e, "fcvtas d0, h1", 0x9EFA0020)
	e = goldenWord(e, "fcvtas d0, s1", 0x9E3A0020)
	e = goldenWord(e, "fcvtau s0, h1", 0x1EFB0020)
	e = goldenWord(e, "fcvtau s0, d1", 0x1E7B0020)
	e = goldenWord(e, "fcvtau d0, h1", 0x9EFB0020)
	e = goldenWord(e, "fcvtau d0, s1", 0x9E3B0020)
	e = goldenWord(e, "fcvtps s0, h1", 0x1EF20020)
	e = goldenWord(e, "fcvtps s0, d1", 0x1E720020)
	e = goldenWord(e, "fcvtps d0, h1", 0x9EF20020)
	e = goldenWord(e, "fcvtps d0, s1", 0x9E320020)
	e = goldenWord(e, "fcvtpu s0, h1", 0x1EF30020)
	e = goldenWord(e, "fcvtpu s0, d1", 0x1E730020)
	e = goldenWord(e, "fcvtpu d0, h1", 0x9EF30020)
	e = goldenWord(e, "fcvtpu d0, s1", 0x9E330020)
	e = goldenWord(e, "fcvtms s0, h1", 0x1EF40020)
	e = goldenWord(e, "fcvtms s0, d1", 0x1E740020)
	e = goldenWord(e, "fcvtms d0, h1", 0x9EF40020)
	e = goldenWord(e, "fcvtms d0, s1", 0x9E340020)
	e = goldenWord(e, "fcvtmu s0, h1", 0x1EF50020)
	e = goldenWord(e, "fcvtmu s0, d1", 0x1E750020)
	e = goldenWord(e, "fcvtmu d0, h1", 0x9EF50020)
	e = goldenWord(e, "fcvtmu d0, s1", 0x9E350020)
	e = goldenWord(e, "fcvtzs s0, h1", 0x1EF60020)
	e = goldenWord(e, "fcvtzs s0, d1", 0x1E760020)
	e = goldenWord(e, "fcvtzs d0, h1", 0x9EF60020)
	e = goldenWord(e, "fcvtzs d0, s1", 0x9E360020)
	e = goldenWord(e, "fcvtzu s0, h1", 0x1EF70020)
	e = goldenWord(e, "fcvtzu s0, d1", 0x1E770020)
	e = goldenWord(e, "fcvtzu d0, h1", 0x9EF70020)
	e = goldenWord(e, "fcvtzu d0, s1", 0x9E370020)
	e = goldenWord(e, "scvtf h0, s1", 0x1EFC0020)
	e = goldenWord(e, "scvtf h0, d1", 0x9EFC0020)
	e = goldenWord(e, "scvtf s0, d1", 0x9E3C0020)
	e = goldenWord(e, "scvtf d0, s1", 0x1E7C0020)
	e = goldenWord(e, "ucvtf h0, s1", 0x1EFD0020)
	e = goldenWord(e, "ucvtf h0, d1", 0x9EFD0020)
	e = goldenWord(e, "ucvtf s0, d1", 0x9E3D0020)
	e = goldenWord(e, "ucvtf d0, s1", 0x1E7D0020)
	return e
}

// The zero register, #fbits as a bare, hexadecimal or parenthesized expression, registers
// 29-31, and upper case.
func TestGoldenFPIntConvertEdges() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fcvtzs wzr, s1", 0x1E38003F)
	e = goldenWord(e, "scvtf s0, wzr", 0x1E2203E0)
	e = goldenWord(e, "fcvtzs w0, s1, 5", 0x1E18EC20)
	e = goldenWord(e, "fcvtzs w0, s1, #(2+3)", 0x1E18EC20)
	e = goldenWord(e, "FCVTZS W0, S1", 0x1E380020)
	e = goldenWord(e, "ucvtf d31, xzr, #64", 0x9E4303FF)
	e = goldenWord(e, "fcvtzs w0, s1, #0x10", 0x1E18C020)
	e = goldenWord(e, "fcvtms x29, d30", 0x9E7003DD)
	e = goldenWord(e, "scvtf h31, w30", 0x1EE203DF)
	return e
}

// Rejected as clang rejects them: fraction bits out of range for FCVTZ*, a fixed-point
// form of any other rounding, SP / WSP, two general-purpose registers, B / Q / V
// registers, reversed operands, a missing or extra operand, trailing tokens, and
// FJCVTZS other than Wd, Dn.
func TestGoldenFPIntConvertRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcvtzs w0, s1, #0")
	e = goldenReject(e, "fcvtzs w0, s1, #33")
	e = goldenReject(e, "fcvtzs x0, s1, #65")
	e = goldenReject(e, "fcvtns w0, s1, #1")
	e = goldenReject(e, "fcvtzs sp, s1")
	e = goldenReject(e, "scvtf s0, sp")
	e = goldenReject(e, "fcvtzs w0, w1")
	e = goldenReject(e, "fcvtzs w0, q1")
	e = goldenReject(e, "fjcvtzs x0, d1")
	e = goldenReject(e, "fjcvtzs w0, s1")
	e = goldenReject(e, "scvtf w0, s1")
	e = goldenReject(e, "fcvtzs w0")
	e = goldenReject(e, "fcvtzs wsp, s1")
	e = goldenReject(e, "scvtf s0, wsp")
	e = goldenReject(e, "fjcvtzs wsp, d1")
	e = goldenReject(e, "fcvtzs w0, b1")
	e = goldenReject(e, "scvtf v0, w1")
	e = goldenReject(e, "fcvtzs w0, s1, #1, #2")
	e = goldenReject(e, "fcvtzs w0, s1, #1 x")
	e = goldenReject(e, "fjcvtzs w0, d1, #0")
	e = goldenReject(e, "fcvtzs h0, s1")
	return e
}
