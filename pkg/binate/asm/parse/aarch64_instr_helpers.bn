package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64"

// --- AArch64 instruction dispatch ---

// Helper: case-insensitive mnemonic match
func mnemIs(mnem *[]readonly char, name *[]readonly char) bool {
	if len(mnem) != len(name) { return false }
	for i := 0; i < len(mnem); i++ {
		var a char = mnem[i]
		var b char = name[i]
		// lowercase both
		if a >= 'A' && a <= 'Z' { a = a + 32 }
		if b >= 'A' && b <= 'Z' { b = b + 32 }
		if a != b { return false }
	}
	return true
}

// Helper: parse comma then operand
func expectCommaOperand(p @Parser, l Lexer, tok Token) (Lexer, Token, aarch64.Operand) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, aarch64.Imm(0)
	}
	l, tok = LexNext(l)
	var op aarch64.Operand
	l, tok, op, _, _ = parseOperand(p, l, tok)
	return l, tok, op
}

// Helper: parse comma then register
func expectCommaReg(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected register")
		return l, tok, -1
	}
	var reg int = 0
	reg, _ = parseReg(tok.Text)
	if reg < 0 {
		setErr(p, "expected register")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	return l, tok, reg
}

// Helper: parse comma then label
func expectCommaLabel(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, ""
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected label")
		return l, tok, ""
	}
	var name @[]char = resolveLabel(p, tok.Text)
	l, tok = LexNext(l)
	return l, tok, name
}

// Helper: parse comma then #imm
func expectCommaImm(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, 0
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_HASH {
		setErr(p, "expected '#'")
		return l, tok, 0
	}
	l, tok = LexNext(l)
	var result ExprResult
	l, tok, result = ParseExpr(l, tok)
	if !result.Ok {
		setErr(p, "invalid immediate")
	}
	return l, tok, cast(int, result.Val)
}

// Helper: parse comma then condition code
func expectCommaCond(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected condition code")
		return l, tok, -1
	}
	var cond int = parseCondCode(tok.Text)
	if cond < 0 {
		setErr(p, "unknown condition code")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	return l, tok, cond
}

// tryCommaLo12 recognizes a `, #:lo12:label` operand (the low-12-bits half of an
// ADRP+ADD address materialization) without committing on a non-match.  Lexer and
// Token are value types, so it scans on local copies and advances the caller's
// l/tok only when the full `# : lo12 : IDENT` sequence follows the comma.  Returns
// (l, tok, label, true) on a match (l/tok positioned past the label), or the
// caller's unchanged (l, tok, "", false) otherwise.
func tryCommaLo12(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, bool) {
	if tok.Kind != TOK_COMMA { return l, tok, "", false }
	var pl Lexer = l
	var pt Token = tok
	pl, pt = LexNext(pl) // past ','
	if pt.Kind != TOK_HASH { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COLON { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT || !charsEqual(pt.Text, "lo12") { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COLON { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT { return l, tok, "", false }
	var label @[]char = resolveLabel(p, pt.Text)
	pl, pt = LexNext(pl)
	return pl, pt, label, true
}
