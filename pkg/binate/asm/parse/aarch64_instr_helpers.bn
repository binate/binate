package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64"

// --- AArch64 instruction dispatch ---

// Helper: case-insensitive mnemonic match
func mnemIs(mnem *[]readonly char, name *[]readonly char) bool {
	if len(mnem) != len(name) { return false }
	for i := 0; i < len(mnem); i++ {
		var a char = mnem[i]
		var b char = name[i]
		// lowercase both
		if a >= 'A' && a <= 'Z' { a = a + 32 }
		if b >= 'A' && b <= 'Z' { b = b + 32 }
		if a != b { return false }
	}
	return true
}

// Helper: parse comma then operand
func expectCommaOperand(p @Parser, l Lexer, tok Token) (Lexer, Token, aarch64.Operand) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, aarch64.Imm(0)
	}
	l, tok = LexNext(l)
	var op aarch64.Operand
	l, tok, op, _, _ = parseOperand(p, l, tok)
	return l, tok, op
}

// Helper: parse comma then register
func expectCommaReg(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected register")
		return l, tok, -1
	}
	var reg int = 0
	reg, _ = parseReg(tok.Text)
	if reg < 0 {
		setErr(p, "expected register")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	return l, tok, reg
}

// Helper: parse comma then label
func expectCommaLabel(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, ""
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected label")
		return l, tok, ""
	}
	var name @[]char = resolveLabel(p, tok.Text)
	l, tok = LexNext(l)
	return l, tok, name
}

// Helper: parse comma then #imm
func expectCommaImm(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, 0
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_HASH {
		setErr(p, "expected '#'")
		return l, tok, 0
	}
	l, tok = LexNext(l)
	var result ExprResult
	l, tok, result = ParseExpr(l, tok)
	if !result.Ok {
		setErr(p, "invalid immediate")
	}
	return l, tok, cast(int, result.Val)
}

// Helper: parse comma then condition code
func expectCommaCond(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected condition code")
		return l, tok, -1
	}
	var cond int = parseCondCode(tok.Text)
	if cond < 0 {
		setErr(p, "unknown condition code")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	return l, tok, cond
}

// tryCommaLo12 recognizes a `, #:lo12:label` operand (the low-12-bits half of an
// ADRP+ADD address materialization) without committing on a non-match.  Lexer and
// Token are value types, so it scans on local copies and advances the caller's
// l/tok only when the full `# : lo12 : IDENT` sequence follows the comma.  Returns
// (l, tok, label, true) on a match (l/tok positioned past the label), or the
// caller's unchanged (l, tok, "", false) otherwise.
func tryCommaLo12(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, bool) {
	if tok.Kind != TOK_COMMA { return l, tok, "", false }
	var pl Lexer = l
	var pt Token = tok
	pl, pt = LexNext(pl) // past ','
	if pt.Kind != TOK_HASH { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COLON { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT || !charsEqual(pt.Text, "lo12") { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COLON { return l, tok, "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT { return l, tok, "", false }
	var label @[]char = resolveLabel(p, pt.Text)
	pl, pt = LexNext(pl)
	return pl, pt, label, true
}

// tryLdrLo12 recognizes a `, [base, #:QUAL:label]` memory operand (the low-12-bits
// half of an ADRP+LDR that loads from a datum) without committing on a non-match,
// where QUAL is `lo12` (a same-image datum → FIX_LDR_LO12) or `got_lo12` (the GOT
// slot of an external symbol → FIX_LD_GOT_LO12).  Like tryCommaLo12 it scans on
// local copies of the value-type Lexer/Token and only advances the caller's l/tok on
// a full `[ REG , # : QUAL : IDENT ]` match, returning (l, tok, baseReg, label, qual,
// true); otherwise it returns the unchanged (l, tok, -1, "", "", false).
func tryLdrLo12(p @Parser, l Lexer, tok Token) (Lexer, Token, int, @[]char, @[]char, bool) {
	if tok.Kind != TOK_COMMA { return l, tok, -1, "", "", false }
	var pl Lexer = l
	var pt Token = tok
	pl, pt = LexNext(pl) // past ','
	if pt.Kind != TOK_LBRACKET { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT { return l, tok, -1, "", "", false }
	var base int = 0
	base, _ = parseReg(pt.Text)
	if base < 0 { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COMMA { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_HASH { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COLON { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT { return l, tok, -1, "", "", false }
	var qual @[]char = pt.Text
	if !charsEqual(qual, "lo12") && !charsEqual(qual, "got_lo12") {
		return l, tok, -1, "", "", false
	}
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_COLON { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_IDENT { return l, tok, -1, "", "", false }
	// Hold the label; resolve it only once the full match (including ']') is confirmed.
	var labelTok Token = pt
	pl, pt = LexNext(pl)
	if pt.Kind != TOK_RBRACKET { return l, tok, -1, "", "", false }
	pl, pt = LexNext(pl) // past ']'
	return pl, pt, base, resolveLabel(p, labelTok.Text), qual, true
}

// expectCommaAdrpLabel parses an ADRP operand after Rd: a bare `, label` (the page
// of the symbol itself → FIX_ADRP_HI21) or `, :got:label` (the page of the symbol's
// GOT slot → FIX_ADRP_GOT_HI21, reaching an external data symbol through the GOT).
// Returns (l, tok, label, isGot); on a syntax error it sets p's error and returns an
// empty label with isGot=false.
func expectCommaAdrpLabel(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, bool) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, "", false
	}
	l, tok = LexNext(l)
	var isGot bool = false
	if tok.Kind == TOK_COLON {
		l, tok = LexNext(l)
		if tok.Kind != TOK_IDENT || !charsEqual(tok.Text, "got") {
			setErr(p, "expected :got: qualifier for adrp")
			return l, tok, "", false
		}
		l, tok = LexNext(l)
		if tok.Kind != TOK_COLON {
			setErr(p, "expected ':' to close :got:")
			return l, tok, "", false
		}
		l, tok = LexNext(l)
		isGot = true
	}
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected label")
		return l, tok, "", false
	}
	var name @[]char = resolveLabel(p, tok.Text)
	l, tok = LexNext(l)
	return l, tok, name, isGot
}
