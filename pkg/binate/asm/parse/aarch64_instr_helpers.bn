package "pkg/binate/asm/parse"

// mnemIs reports whether mnem equals name, ASCII case-insensitively (shared by the
// AArch64 and ARM32 instruction dispatch).
func mnemIs(mnem *[]readonly char, name *[]readonly char) bool {
	if len(mnem) != len(name) { return false }
	for i := 0; i < len(mnem); i++ {
		var a char = mnem[i]
		var b char = name[i]
		// lowercase both
		if a >= 'A' && a <= 'Z' { a = a + 32 }
		if b >= 'A' && b <= 'Z' { b = b + 32 }
		if a != b { return false }
	}
	return true
}
