package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the comma-operand parse helpers in
// aarch64_instr_helpers.bn. The expectComma* helpers are exercised
// indirectly through the instruction-parse tests in
// aarch64_instr_test.bn; this file pins the case-insensitive
// mnemonic match (mnemIs) as a direct unit test, since that's the
// only helper without a clean end-to-end equivalent.

func TestMnemIsCaseInsensitive() testing.TestResult {
	if !mnemIs("mov", "mov") { return "lower vs lower failed" }
	if !mnemIs("MOV", "mov") { return "upper vs lower failed" }
	if !mnemIs("Mov", "mov") { return "mixed vs lower failed" }
	if !mnemIs("mov", "MOV") { return "lower vs upper failed" }
	if mnemIs("mov", "mvn") { return "different mnemonics matched" }
	if mnemIs("mo", "mov") { return "shorter prefix matched" }
	if mnemIs("mova", "mov") { return "longer extension matched" }
	return ""
}
