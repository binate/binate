package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"

// AArch64 load/store instructions: every single-register transfer (LDR/STR and the
// byte, halfword and sign-extending forms, their LDUR/STUR unscaled spellings, and
// PRFM/PRFUM) of general-purpose and SIMD&FP registers, and every pair transfer
// (LDP/STP, LDPSW, LDNP/STNP).  Each written instruction assembles to exactly one
// instruction through the exact encoders (isa.LdSt*), or is rejected: an
// immediate offset that fits neither the scaled unsigned form nor the LDUR/STUR
// alias is an error, never an address synthesized into a scratch register.

// unscaledBase maps an unscaled-only mnemonic (LDUR/STUR/LDURB/…/PRFUM) to the
// scaled mnemonic whose transfer it names, or returns "" when mnem is not one.
func unscaledBase(mnem *[]readonly char) *[]readonly char {
	if mnemIs(mnem, "ldur") { return "ldr" }
	if mnemIs(mnem, "stur") { return "str" }
	if mnemIs(mnem, "ldurb") { return "ldrb" }
	if mnemIs(mnem, "sturb") { return "strb" }
	if mnemIs(mnem, "ldurh") { return "ldrh" }
	if mnemIs(mnem, "sturh") { return "strh" }
	if mnemIs(mnem, "ldursb") { return "ldrsb" }
	if mnemIs(mnem, "ldursh") { return "ldrsh" }
	if mnemIs(mnem, "ldursw") { return "ldrsw" }
	if mnemIs(mnem, "prfum") { return "prfm" }
	return ""
}

// isA64SingleLdSt reports whether mnem is a single-register load/store (scaled or
// unscaled spelling) handled by parseA64LdSt.
func isA64SingleLdSt(mnem *[]readonly char) bool {
	if len(unscaledBase(mnem)) != 0 { return true }
	return mnemIs(mnem, "ldr") || mnemIs(mnem, "str") || mnemIs(mnem, "ldrb") ||
			mnemIs(mnem, "strb") || mnemIs(mnem, "ldrh") || mnemIs(mnem, "strh") || mnemIs(mnem, "ldrsb") ||
			mnemIs(mnem, "ldrsh") || mnemIs(mnem, "ldrsw") || mnemIs(mnem, "prfm")
}

// isA64PairLdSt reports whether mnem is a load/store pair.
func isA64PairLdSt(mnem *[]readonly char) bool {
	return mnemIs(mnem, "ldp") || mnemIs(mnem, "stp") || mnemIs(mnem, "ldpsw") ||
			mnemIs(mnem, "ldnp") || mnemIs(mnem, "stnp")
}

// isA64LdSt reports whether mnem is any load/store parseA64LdSt handles.
func isA64LdSt(mnem *[]readonly char) bool {
	return isA64SingleLdSt(mnem) || isA64PairLdSt(mnem)
}

// singleSpec returns the isa.LS_* transfer spec of scaled mnemonic base with a
// transfer register of class cls, or ok=false when that register class is not
// legal for the mnemonic (e.g. LDRB of an X register, LDRSW of a W register, any
// transfer of SP).
func singleSpec(base *[]readonly char, cls int) (uint32, bool) {
	var ld bool = mnemIs(base, "ldr")
	if ld || mnemIs(base, "str") {
		if rcIsX(cls) { if ld { return isa.LS_LDR_X, true }; return isa.LS_STR_X, true }
		if rcIsW(cls) { if ld { return isa.LS_LDR_W, true }; return isa.LS_STR_W, true }
		if cls == RC_B { if ld { return isa.LS_LDR_B, true }; return isa.LS_STR_B, true }
		if cls == RC_H { if ld { return isa.LS_LDR_H, true }; return isa.LS_STR_H, true }
		if cls == RC_S { if ld { return isa.LS_LDR_S, true }; return isa.LS_STR_S, true }
		if cls == RC_D { if ld { return isa.LS_LDR_D, true }; return isa.LS_STR_D, true }
		if cls == RC_Q { if ld { return isa.LS_LDR_Q, true }; return isa.LS_STR_Q, true }
		return 0, false
	}
	if mnemIs(base, "ldrb") && rcIsW(cls) { return isa.LS_LDRB, true }
	if mnemIs(base, "strb") && rcIsW(cls) { return isa.LS_STRB, true }
	if mnemIs(base, "ldrh") && rcIsW(cls) { return isa.LS_LDRH, true }
	if mnemIs(base, "strh") && rcIsW(cls) { return isa.LS_STRH, true }
	if mnemIs(base, "ldrsb") && rcIsX(cls) { return isa.LS_LDRSB_X, true }
	if mnemIs(base, "ldrsb") && rcIsW(cls) { return isa.LS_LDRSB_W, true }
	if mnemIs(base, "ldrsh") && rcIsX(cls) { return isa.LS_LDRSH_X, true }
	if mnemIs(base, "ldrsh") && rcIsW(cls) { return isa.LS_LDRSH_W, true }
	if mnemIs(base, "ldrsw") && rcIsX(cls) { return isa.LS_LDRSW, true }
	return 0, false
}

// prfopValue decodes a named prefetch operation `<type><target><policy>` — type
// pld / pli / pst, target l1 / l2 / l3 / slc (the system-level cache), policy keep /
// strm — into its 5-bit PRFM operand (type << 3 | target << 1 | policy), or -1 for any
// other name.
func prfopValue(name *[]readonly char) int {
	var n int = len(name)
	if n != 9 && n != 10 { return -1 }
	var ty int = -1
	if nameIs(name[0:3], "pld") { ty = 0 }
	if nameIs(name[0:3], "pli") { ty = 1 }
	if nameIs(name[0:3], "pst") { ty = 2 }
	var tgt int = -1
	if n == 9 && nameIs(name[3:5], "l1") { tgt = 0 }
	if n == 9 && nameIs(name[3:5], "l2") { tgt = 1 }
	if n == 9 && nameIs(name[3:5], "l3") { tgt = 2 }
	if n == 10 && nameIs(name[3:6], "slc") { tgt = 3 }
	var pol int = -1
	if nameIs(name[n - 4:n], "keep") { pol = 0 }
	if nameIs(name[n - 4:n], "strm") { pol = 1 }
	if ty < 0 || tgt < 0 || pol < 0 { return -1 }
	return ty * 8 + tgt * 2 + pol
}

// expectA64EOL reports an error when tok — the token after an instruction's last
// operand — is not the end of the line, so trailing operand text (an extend, an
// addend, a stray register) is rejected instead of silently ignored.
func expectA64EOL(p @Parser, tok Token) {
	if !p.HasError && tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the instruction's operands")
	}
}

// a64AtEOL reports whether the line is still free of errors and tok ends it, setting
// expectA64EOL's error when tok does not: a parser that reads its operands token by token
// checks this before it emits, so a line with trailing text emits nothing.
func a64AtEOL(p @Parser, tok Token) bool {
	expectA64EOL(p, tok)
	return !p.HasError
}

// parseA64LdSt parses and emits one load/store instruction; l is positioned just
// after the mnemonic.  It emits only once the line has ended (a64AtEOL), and returns
// the lexer and the token after the last operand.
func parseA64LdSt(p @Parser, l Lexer, mnem *[]readonly char) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if isA64PairLdSt(mnem) { return parseA64Pair(p, l, tok, mnem) }
	var base *[]readonly char = unscaledBase(mnem)
	var unscaledOnly bool = len(base) != 0
	if !unscaledOnly { base = mnem }
	var rt int = -1
	var spec uint32 = 0
	if mnemIs(base, "prfm") {
		spec = isa.LS_PRFM
		// A prefetch operation number follows `#`, or starts with an integer or character
		// literal (as clang: `prfm 5, …`, not `prfm (5), …`).
		if tok.Kind == TOK_HASH || tok.Kind == TOK_INT || tok.Kind == TOK_CHAR {
			var ok bool = false
			if tok.Kind == TOK_HASH {
				l, tok, rt, ok = parseHashImmValue(p, l)
			} else {
				l, tok, rt, ok = parseImmValueAt(p, l, tok)
			}
			if !ok { return l, tok }
			if rt < 0 || rt > 31 {
				setErr(p, "prefetch operation immediate out of range [0, 31]")
				return l, tok
			}
		} else {
			if tok.Kind == TOK_IDENT { rt = prfopValue(tok.Text) }
			if rt < 0 {
				setErr(p, "expected a prefetch operation (e.g. pldl1keep) or #imm")
				return l, tok
			}
			l, tok = LexNext(l)
		}
	} else {
		var cls int = RC_NONE
		if tok.Kind == TOK_IDENT { rt, cls = parseA64Reg(tok.Text) }
		var ok bool = false
		spec, ok = singleSpec(base, cls)
		if !ok {
			setErr(p, "invalid transfer register for this load/store")
			return l, tok
		}
		l, tok = LexNext(l)
	}
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' after the transfer register")
		return l, tok
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_EQUALS { return parseA64PoolLoad(p, l, tok, spec, rt, unscaledOnly) }
	if isA64QualifierStart(l, tok) { return parseA64GotLiteral(p, l, tok, spec, rt, unscaledOnly) }
	if tok.Kind == TOK_IDENT && !isA64ConstName(p, tok) {
		return parseA64Literal(p, l, tok, spec, rt, unscaledOnly)
	}
	if tok.Kind == TOK_HASH || tok.Kind == TOK_DOT || tok.Kind == TOK_IDENT || startsNumericExpr(tok) {
		// `<op> Rt, #target` / `<op> Rt, target`: a literal load (a constant's name is an
		// offset, as a number is).
		if tok.Kind == TOK_HASH { l, tok = LexNext(l) }
		return emitA64Literal(p, l, tok, spec, rt, unscaledOnly)
	}
	var ad a64Addr
	var okAddr bool = false
	l, tok, ad, okAddr = parseA64Addr(p, l, tok)
	if !okAddr || !a64AtEOL(p, tok) { return l, tok }
	emitA64Single(p, spec, rt, ad, unscaledOnly)
	return l, tok
}

// hasLiteralForm reports whether transfer spec has a PC-relative literal form: LDR
// W / X / S / D / Q, LDRSW and PRFM.
func hasLiteralForm(spec uint32) bool {
	return spec == isa.LS_LDR_W || spec == isa.LS_LDR_X || spec == isa.LS_LDRSW ||
			spec == isa.LS_LDR_S || spec == isa.LS_LDR_D || spec == isa.LS_LDR_Q || spec == isa.LS_PRFM
}

// parseA64Literal handles `<op> Rt, name…` (tok is the name, l just after it): a literal
// load (emitA64Literal), unless the name is a register or — except for PRFM — a shift /
// extend.
func parseA64Literal(p @Parser, l Lexer, tok Token, spec uint32, rt int,
		unscaledOnly bool) (Lexer, Token) {
	_, rcls := parseA64Reg(tok.Text)
	if rcls != RC_NONE || isVecRegShaped(tok.Text) {
		setErr(p, "expected a memory address or label, not a register")
		return l, tok
	}
	// As clang: a load reads a shift / extend name (MSL included) there as a modifier
	// missing its amount, while PRFM takes it as a label (or the constant so named).
	if (parseModName(tok.Text) >= 0 || nameIs(tok.Text, "msl")) && spec != isa.LS_PRFM {
		setErr(p, "expected a memory address or label, not a shift / extend")
		return l, tok
	}
	return emitA64Literal(p, l, tok, spec, rt, unscaledOnly)
}

// emitA64Literal emits the PC-relative literal load whose target expression starts at tok
// (l just after it): a symbol plus a number is a label and addend (`lbl+8`, `4+lbl`), and
// a number or `.` plus a number an offset from this instruction (`8`, `#8`, `.+8`, a
// constant's name).  Stores, the byte / halfword forms and the unscaled spellings have no
// literal form.
func emitA64Literal(p @Parser, l Lexer, tok Token, spec uint32, rt int,
		unscaledOnly bool) (Lexer, Token) {
	if unscaledOnly || !hasLiteralForm(spec) {
		setErr(p, "this load/store has no PC-relative literal form")
		return l, tok
	}
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid literal target"))
		return l, tok
	}
	if tok.Kind == TOK_AT {
		setErr(p, "a literal load takes a plain label (no @ specifier)")
		return l, tok
	}
	if len(r.Sym) == 0 && !r.Dot && r.FromDiff {
		diffTargetError(p)
		return l, tok
	}
	if !intFits(r.Val) {
		setErr(p, "literal offset or addend out of range")
		return l, tok
	}
	if !a64AtEOL(p, tok) { return l, tok }
	if len(r.Sym) > 0 {
		isa.LdStLiteral(p.Asm, spec, rt, r.Sym, cast(int, r.Val))
	} else {
		isa.LdStLiteralOffset(p.Asm, spec, rt, cast(int, r.Val))
	}
	return l, tok
}

// emitA64Single emits a single-register transfer at a parsed address, choosing the
// encoding the way the architecture's assembler aliases do: an immediate offset
// takes the scaled unsigned form when it fits and the LDUR/STUR form otherwise.
func emitA64Single(p @Parser, spec uint32, rt int, ad a64Addr, unscaledOnly bool) {
	var a @asm.Assembler = p.Asm
	var isPrfm bool = spec == isa.LS_PRFM
	if unscaledOnly && ad.Mode != ADDR_BASE && ad.Mode != ADDR_IMM {
		setErr(p, "LDUR/STUR-family instructions take only [Xn{, #simm9}]")
		return
	}
	if ad.Mode == ADDR_BASE || ad.Mode == ADDR_IMM {
		var scale int = isa.LdStAccessBytes(spec)
		var off int = ad.Imm
		if ad.Mode == ADDR_BASE { off = 0 }
		if !unscaledOnly && off >= 0 && off % scale == 0 && off / scale <= 4095 {
			isa.LdStUImm(a, spec, rt, ad.Base, off)
			return
		}
		if isPrfm && !unscaledOnly {
			// Only LDR / STR fall back to the unscaled form; `prfm` names the scaled
			// encoding and an unscaled offset must be spelled `prfum`.
			setErr(p, "prfm offset must be a multiple of 8 in [0, 32760] (prfum takes an unscaled one)")
			return
		}
		if off < -256 || off > 255 {
			setErr(p,
					"load/store offset fits neither the scaled 12-bit form nor the unscaled [-256, 255] form")
			return
		}
		isa.LdStUnscaled(a, spec, rt, ad.Base, off)
		return
	}
	if (ad.Mode == ADDR_PRE || ad.Mode == ADDR_POST) && isPrfm {
		setErr(p, "PRFM has no writeback addressing form")
		return
	}
	if ad.Mode == ADDR_PRE {
		isa.LdStPre(a, spec, rt, ad.Base, ad.Imm)
		return
	}
	if ad.Mode == ADDR_POST {
		isa.LdStPost(a, spec, rt, ad.Base, ad.Imm)
		return
	}
	if ad.Mode == ADDR_REG {
		emitA64RegOffset(p, spec, rt, ad)
		return
	}
	if ad.Mode == ADDR_LO12 {
		isa.LdStLo12(a, spec, rt, ad.Base, ad.Label, ad.Imm)
		return
	}
	emitA64GotSlot(p, spec, rt, ad) // ADDR_GOT_LO12 / ADDR_GOTPAGE_LO15
}

// emitA64RegOffset emits the register-offset form after checking the shift amount:
// if written it must be #0 or #log2(access size), and a byte access allows only #0.
// The S bit is set for an amount of log2(size), and for a byte access whenever an
// amount is written — the encodings clang produces.
func emitA64RegOffset(p @Parser, spec uint32, rt int, ad a64Addr) {
	var bytes int = isa.LdStAccessBytes(spec)
	var log2 int = 0
	if bytes == 2 { log2 = 1 }
	if bytes == 4 { log2 = 2 }
	if bytes == 8 { log2 = 3 }
	if bytes == 16 { log2 = 4 }
	var scaled bool = false
	if ad.AmtGiven {
		if ad.Amt != 0 && ad.Amt != log2 {
			setErr(p, "register-offset shift amount must be #0 or #log2(access size)")
			return
		}
		scaled = ad.Amt == log2
	}
	isa.LdStReg(p.Asm, spec, rt, ad.Base, ad.Index, ad.Ext, scaled)
}

// pairSpec returns the isa.LSP_* spec of pair mnemonic mnem for a first
// transfer register of class cls, or ok=false when that class is not legal for it.
func pairSpec(mnem *[]readonly char, cls int) (uint32, bool) {
	if mnemIs(mnem, "ldpsw") {
		if rcIsX(cls) { return isa.LSP_LDPSW, true }
		return 0, false
	}
	var ld bool = mnemIs(mnem, "ldp") || mnemIs(mnem, "ldnp")
	if rcIsX(cls) { if ld { return isa.LSP_LDP_X, true }; return isa.LSP_STP_X, true }
	if rcIsW(cls) { if ld { return isa.LSP_LDP_W, true }; return isa.LSP_STP_W, true }
	if cls == RC_S { if ld { return isa.LSP_LDP_S, true }; return isa.LSP_STP_S, true }
	if cls == RC_D { if ld { return isa.LSP_LDP_D, true }; return isa.LSP_STP_D, true }
	if cls == RC_Q { if ld { return isa.LSP_LDP_Q, true }; return isa.LSP_STP_Q, true }
	return 0, false
}

// sameTransferKind reports whether two register classes are interchangeable as the
// two registers of a pair (both 64-bit GP, both 32-bit GP, or the same SIMD&FP size).
func sameTransferKind(c1 int, c2 int) bool {
	if rcIsX(c1) { return rcIsX(c2) }
	if rcIsW(c1) { return rcIsW(c2) }
	return c1 == c2
}

// parseA64Pair parses `<pair-op> Rt1, Rt2, <addr>` (tok is Rt1) and emits it.  The two
// registers must be the same kind; LDNP/STNP take only the offset form.
func parseA64Pair(p @Parser, l Lexer, tok Token, mnem *[]readonly char) (Lexer, Token) {
	var rt1 int = -1
	var c1 int = RC_NONE
	if tok.Kind == TOK_IDENT { rt1, c1 = parseA64Reg(tok.Text) }
	var spec uint32 = 0
	var ok bool = false
	spec, ok = pairSpec(mnem, c1)
	if !ok {
		setErr(p, "invalid first transfer register for this load/store pair")
		return l, tok
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' after the first transfer register")
		return l, tok
	}
	l, tok = LexNext(l)
	var rt2 int = -1
	var c2 int = RC_NONE
	if tok.Kind == TOK_IDENT { rt2, c2 = parseA64Reg(tok.Text) }
	if !sameTransferKind(c1, c2) {
		setErr(p, "the two registers of a load/store pair must be the same kind and size")
		return l, tok
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' after the second transfer register")
		return l, tok
	}
	l, tok = LexNext(l)
	var ad a64Addr
	l, tok, ad, ok = parseA64Addr(p, l, tok)
	if !ok { return l, tok }
	var nt bool = mnemIs(mnem, "ldnp") || mnemIs(mnem, "stnp")
	var mode int = isa.PAIR_OFFSET
	if nt { mode = isa.PAIR_NONTEMPORAL }
	var off int = 0
	if ad.Mode == ADDR_IMM {
		off = ad.Imm
	} else if ad.Mode == ADDR_PRE && !nt {
		mode = isa.PAIR_PRE
		off = ad.Imm
	} else if ad.Mode == ADDR_POST && !nt {
		mode = isa.PAIR_POST
		off = ad.Imm
	} else if ad.Mode != ADDR_BASE {
		setErr(p, "invalid addressing mode for a load/store pair")
		return l, tok
	}
	if !a64AtEOL(p, tok) { return l, tok }
	isa.LdStPair(p.Asm, spec, rt1, rt2, ad.Base, off, mode)
	return l, tok
}
