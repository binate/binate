package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF for the ELF-only `:lo12:` syntax and undefined local labels),
// or — where clang rejects it — is rejected.  Every valid instruction is one word:
// the text assembler never synthesizes a sequence.

// Load/store lines clang rejects, chunk 0.
func TestGoldenLdStRejects0() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ldnp x0, x1, [x2, #16]!")
	e = goldenReject(e, "ldnp x0, x1, [x2], #16")
	e = goldenReject(e, "ldp d0, d1, [x2, #-520]")
	e = goldenReject(e, "ldp q0, q0, [x1]")
	e = goldenReject(e, "ldp q0, q1, [x1, #-1040]")
	e = goldenReject(e, "ldp q0, q1, [x1, #-8]")
	e = goldenReject(e, "ldp q0, q1, [x1, #1024]")
	e = goldenReject(e, "ldp q0, q1, [x1, #2048]")
	e = goldenReject(e, "ldp q0, q1, [x1, #24]")
	e = goldenReject(e, "ldp q0, q1, [x1, #32] junk")
	e = goldenReject(e, "ldp q0, q1, [x1, #8]")
	e = goldenReject(e, "ldp q0, q1, [x1, x2]")
	e = goldenReject(e, "ldp q0, q1, [x1], #1024")
	e = goldenReject(e, "ldp q0, q1, [x1], #8")
	e = goldenReject(e, "ldp q0, x1, [x2]")
	e = goldenReject(e, "ldp w0, w1, [x2, #-2]")
	e = goldenReject(e, "ldp w0, w1, [x2, #-260]")
	e = goldenReject(e, "ldp w0, w1, [x2, #2]")
	e = goldenReject(e, "ldp w0, w1, [x2, #2]!")
	e = goldenReject(e, "ldp w0, w1, [x2, #256]")
	e = goldenReject(e, "ldp w0, w1, [x2, #256]!")
	e = goldenReject(e, "ldp w0, w1, [x2, #6]")
	e = goldenReject(e, "ldp w0, w1, [x2], #-260")
	e = goldenReject(e, "ldp w0, w1, [x2], #6")
	e = goldenReject(e, "ldp w0, x1, [x2]")
	e = goldenReject(e, "ldp x0, w1, [x2]")
	e = goldenReject(e, "ldp x0, x0, [x2]")
	e = goldenReject(e, "ldp x0, x1, [x0], #16")
	e = goldenReject(e, "ldp x0, x1, [x2, #-1000]")
	e = goldenReject(e, "ldp x0, x1, [x2, #-12]")
	e = goldenReject(e, "ldp x0, x1, [x2, #-4]")
	e = goldenReject(e, "ldp x0, x1, [x2, #-520]")
	e = goldenReject(e, "ldp x0, x1, [x2, #-520]!")
	e = goldenReject(e, "ldp x0, x1, [x2, #1000]")
	e = goldenReject(e, "ldp x0, x1, [x2, #12]")
	e = goldenReject(e, "ldp x0, x1, [x2, #16")
	e = goldenReject(e, "ldp x0, x1, [x2, #16] junk")
	e = goldenReject(e, "ldp x0, x1, [x2, #4]")
	e = goldenReject(e, "ldp x0, x1, [x2, #4]!")
	e = goldenReject(e, "ldp x0, x1, [x2, #4096]")
	e = goldenReject(e, "ldp x0, x1, [x2, #512]")
	e = goldenReject(e, "ldp x0, x1, [x2, #512]!")
	e = goldenReject(e, "ldp x0, x1, [x2, x3, lsl #3]")
	e = goldenReject(e, "ldp x0, x1, [x2, x3]")
	e = goldenReject(e, "ldp x0, x1, [x2], #-520")
	e = goldenReject(e, "ldp x0, x1, [x2], #4")
	e = goldenReject(e, "ldp x0, x1, [x2], #512")
	e = goldenReject(e, "ldp x0, x1, #16")
	e = goldenReject(e, "ldp x0, x1, foo")
	e = goldenReject(e, "ldpsw w0, w1, [x2]")
	e = goldenReject(e, "ldr b0, [x1, #4096]")
	e = goldenReject(e, "ldr d0, [x1, #32768]")
	e = goldenReject(e, "ldr q0, [sp, #-272]")
	e = goldenReject(e, "ldr q0, [x1, #-20000000]")
	e = goldenReject(e, "ldr q0, [x1, #-272]")
	e = goldenReject(e, "ldr q0, [x1, #-4096]")
	e = goldenReject(e, "ldr q0, [x1, #264]")
	e = goldenReject(e, "ldr q0, [x1, #65532]")
	e = goldenReject(e, "ldr q0, [x1, #65536]")
	e = goldenReject(e, "ldr q0, [x1, #70000]")
	e = goldenReject(e, "ldr q0, [x1, x2, lsl #3]")
	e = goldenReject(e, "ldr q0, [x1], #-257")
	e = goldenReject(e, "ldr q0, [x1], #256")
	e = goldenReject(e, "ldr q0, [x1], #512")
	e = goldenReject(e, "ldr q0, [x17, #264]")
	e = goldenReject(e, "ldr sp, [x1]")
	e = goldenReject(e, "ldr v0, [x1]")
	e = goldenReject(e, "ldr w0, [x1, #-257]")
	e = goldenReject(e, "ldr w0, [x1, #:got_lo12:sym]")
	e = goldenReject(e, "ldr w0, [x1, #16384]")
	e = goldenReject(e, "ldr w0, [x1, #256]!")
	e = goldenReject(e, "ldr w0, [x1, w2]")
	e = goldenReject(e, "ldr wsp, [x1]")
	e = goldenReject(e, "ldr x0, [w1]")
	e = goldenReject(e, "ldr x0, [x0, #8]!")
	e = goldenReject(e, "ldr x0, [x0], #8")
	e = goldenReject(e, "ldr x0, [x1, #-257]")
	e = goldenReject(e, "ldr x0, [x1, #-257]!")
	e = goldenReject(e, "ldr x0, [x1, #-4096]")
	e = goldenReject(e, "ldr x0, [x1, #0x1000000]")
	e = goldenReject(e, "ldr x0, [x1, #256]!")
	e = goldenReject(e, "ldr x0, [x1, #32768]")
	e = goldenReject(e, "ldr x0, [x1, #4096]!")
	e = goldenReject(e, "ldr x0, [x1, #4097]")
	e = goldenReject(e, "ldr x0, [x1, #8")
	e = goldenReject(e, "ldr x0, [x1, sp]")
	e = goldenReject(e, "ldr x0, [x1, x2, lsl #2]")
	e = goldenReject(e, "ldr x0, [x1, x2, lsl]")
	e = goldenReject(e, "ldr x0, [x1, x2,]")
	e = goldenReject(e, "ldr x0, [x1,]")
	e = goldenReject(e, "ldr x0, [x1] #8")
	e = goldenReject(e, "ldr x0, [x1], #-257")
	e = goldenReject(e, "ldr x0, [x1], #256")
	e = goldenReject(e, "ldr x0, [x1], #512")
	e = goldenReject(e, "ldr x0, [x1], x2")
	e = goldenReject(e, "ldr x0, [xzr]")
	e = goldenReject(e, "ldr x0, #1048576")
	e = goldenReject(e, "ldr x0, #6")
	e = goldenReject(e, "ldr x0, x1")
	e = goldenReject(e, "ldr x1, [x1, #8]!")
	return e
}

// Load/store lines clang rejects, chunk 1.
func TestGoldenLdStRejects1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ldr x1, [x1], #8")
	e = goldenReject(e, "ldrb w0, [x1, #-257]")
	e = goldenReject(e, "ldrb w0, [x1, #256]!")
	e = goldenReject(e, "ldrb w0, [x1, #4096]")
	e = goldenReject(e, "ldrb w0, [x1], #-257")
	e = goldenReject(e, "ldrb w0, lbl")
	e = goldenReject(e, "ldrb w1, [x1], #1")
	e = goldenReject(e, "ldrb x0, [x1]")
	e = goldenReject(e, "ldrh w0, [x1, #-257]")
	e = goldenReject(e, "ldrh w0, [x1, #300]!")
	e = goldenReject(e, "ldrh w0, [x1, #8192]")
	e = goldenReject(e, "ldrsb x0, [x1, #256]!")
	e = goldenReject(e, "ldrsb x0, [x1, #4096]")
	e = goldenReject(e, "ldrsh x0, [x1, #8192]")
	e = goldenReject(e, "ldrsh x0, [x1], #-257")
	e = goldenReject(e, "ldrsw w0, [x1]")
	e = goldenReject(e, "ldrsw x0, [x1, #-257]")
	e = goldenReject(e, "ldrsw x0, [x1, #16384]")
	e = goldenReject(e, "ldrsw x0, [x1, #256]!")
	e = goldenReject(e, "ldrsw x0, [x1], #256")
	e = goldenReject(e, "ldur q0, [x1, #256]")
	e = goldenReject(e, "ldur x0, [x1, #:lo12:sym]")
	e = goldenReject(e, "ldur x0, [x1, #256]")
	e = goldenReject(e, "ldur x0, #8")
	e = goldenReject(e, "ldurb w0, [x1, x2]")
	e = goldenReject(e, "prfm #32, [x1]")
	e = goldenReject(e, "prfm bogus, [x1]")
	e = goldenReject(e, "prfm pldl1keep, [x1, #8]!")
	e = goldenReject(e, "prfum pldl1keep, [x1, #256]")
	e = goldenReject(e, "stp q0, q1, [x1, #-1040]")
	e = goldenReject(e, "stp q0, q1, [x1, #1024]")
	e = goldenReject(e, "stp q0, q1, [x1, #20]")
	e = goldenReject(e, "stp q0, q1, [x1], #-1040")
	e = goldenReject(e, "stp w0, w1, [x2, #256]")
	e = goldenReject(e, "stp w0, w1, [x2, #3]")
	e = goldenReject(e, "stp w0, w1, [x2], #300")
	e = goldenReject(e, "stp x0, x1, [x2, #-520]")
	e = goldenReject(e, "stp x0, x1, [x2, #4]")
	e = goldenReject(e, "stp x0, x1, [x2, #512]")
	e = goldenReject(e, "stp x0, x1, [x2, x3]")
	e = goldenReject(e, "stp x0, x1, [x2], #1024")
	e = goldenReject(e, "stp x0, x1, [x2], #20")
	e = goldenReject(e, "stp x29, x30, [sp, #-528]!")
	e = goldenReject(e, "str q0, [x1, #-272]")
	e = goldenReject(e, "str q0, [x1, #264]")
	e = goldenReject(e, "str q0, [x1], #-300")
	e = goldenReject(e, "str q0, [x1], #256")
	e = goldenReject(e, "str q0, [x17, #-272]")
	e = goldenReject(e, "str w0, [x1, #16384]")
	e = goldenReject(e, "str x0, [x1, #-257]")
	e = goldenReject(e, "str x0, [x1, #256]!")
	e = goldenReject(e, "str x0, [x1, #32768]")
	e = goldenReject(e, "str x0, [x1], #-257")
	e = goldenReject(e, "str x0, #8")
	e = goldenReject(e, "str x0, lbl")
	e = goldenReject(e, "str x1, [x1, #8]!")
	e = goldenReject(e, "str x1, [x1], #8")
	e = goldenReject(e, "strb w0, [x1, #4096]")
	e = goldenReject(e, "strb w0, [x1], #256")
	e = goldenReject(e, "strh w0, [x1], #-300")
	e = goldenReject(e, "strh x0, [x1]")
	e = goldenReject(e, "stur w0, [x1, #-257]")
	return e
}
