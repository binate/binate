package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 unprivileged loads / stores — LDTR / STTR and LDTRB / LDTRH / LDTRSB /
// LDTRSH / LDTRSW / STTRB / STTRH, at `[Xn|SP{, #simm9}]` — and the pointer-
// authenticating loads LDRAA / LDRAB of an X register, at `[Xn|SP{, #simm}]` or
// pre-indexed `[Xn|SP{, #simm}]!` (the byte offset simm a multiple of 8 in
// [-4096, 4088], encoded scaled as a signed 10-bit field; 0 when omitted).

// unprivBase maps an LDTR / STTR-family mnemonic to the scaled load / store whose
// transfer it names, or "".
func unprivBase(mnem *[]readonly char) *[]readonly char {
	if mnemIs(mnem, "ldtr") { return "ldr" }
	if mnemIs(mnem, "ldtrb") { return "ldrb" }
	if mnemIs(mnem, "ldtrh") { return "ldrh" }
	if mnemIs(mnem, "ldtrsb") { return "ldrsb" }
	if mnemIs(mnem, "ldtrsh") { return "ldrsh" }
	if mnemIs(mnem, "ldtrsw") { return "ldrsw" }
	if mnemIs(mnem, "sttr") { return "str" }
	if mnemIs(mnem, "sttrb") { return "strb" }
	if mnemIs(mnem, "sttrh") { return "strh" }
	return ""
}

// isA64LdStSpecial reports whether mnem is an unprivileged or pointer-authenticating
// load / store.
func isA64LdStSpecial(mnem *[]readonly char) bool {
	return len(unprivBase(mnem)) != 0 || mnemIs(mnem, "ldraa") || mnemIs(mnem, "ldrab")
}

// parseA64LdStSpecial parses and emits one unprivileged or pointer-authenticating
// load / store; l is positioned just after the mnemonic.  It emits only once the line
// has ended (a64AtEOL), and returns the lexer and the token after the last operand.
func parseA64LdStSpecial(p @Parser, l Lexer, mnem *[]readonly char) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	var rt int = -1
	var cls int = RC_NONE
	var ok bool = false
	l, tok, rt, cls, ok = a64RegComma(p, l, tok)
	if !ok { return l, tok }
	var ad a64Addr
	l, tok, ad, ok = parseA64Addr(p, l, tok)
	if !ok { return l, tok }
	var off int = 0
	if ad.Mode == ADDR_IMM || ad.Mode == ADDR_PRE { off = ad.Imm }
	var base *[]readonly char = unprivBase(mnem)
	if len(base) != 0 {
		var spec uint32 = 0
		spec, ok = singleSpec(base, cls)
		if !ok {
			setErr(p, "invalid transfer register for this load/store")
			return l, tok
		}
		if ad.Mode != ADDR_BASE && ad.Mode != ADDR_IMM {
			setErr(p, "LDTR/STTR-family instructions take only [Xn|SP{, #simm9}]")
			return l, tok
		}
		if !a64AtEOL(p, tok) { return l, tok }
		// A SIMD&FP transfer register gives a SIMD&FP spec, which has no unprivileged
		// form: LdStUnprivileged rejects it.
		isa.LdStUnprivileged(p.Asm, spec, rt, ad.Base, off)
		return l, tok
	}
	if !rcIsX(cls) {
		setErr(p, "LDRAA/LDRAB load an X register")
		return l, tok
	}
	if ad.Mode != ADDR_BASE && ad.Mode != ADDR_IMM && ad.Mode != ADDR_PRE {
		setErr(p, "LDRAA/LDRAB take [Xn|SP{, #simm}] or [Xn|SP{, #simm}]!")
		return l, tok
	}
	var wb bool = ad.Mode == ADDR_PRE
	if ad.Mode == ADDR_BASE && tok.Kind == TOK_BANG {
		// `[Xn|SP]!` — pre-index by 0, a form only LDRAA / LDRAB have (parseA64Addr
		// leaves the '!' for the caller, as a bare base with writeback is an error for
		// every other load / store).
		wb = true
		l, tok = LexNext(l)
	}
	if !a64AtEOL(p, tok) { return l, tok }
	isa.LoadAuthenticated(p.Asm, mnemIs(mnem, "ldrab"), rt, ad.Base, off, wb)
	return l, tok
}
