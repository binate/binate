package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the unprivileged loads / stores and LDRAA / LDRAB, from clang
// (`clang -c -target aarch64-linux-gnu -march=armv8.3-a`), objdump'd.
func TestGoldenUnprivilegedLdSt() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldtr w0, [x1]", 0xB8400820)
	e = goldenWord(e, "ldtr x0, [x1, #-256]", 0xF8500820)
	e = goldenWord(e, "ldtr x0, [sp, #255]", 0xF84FFBE0)
	e = goldenWord(e, "ldtrb w0, [x1, #1]", 0x38401820)
	e = goldenWord(e, "ldtrh w0, [x1, #-2]", 0x785FE820)
	e = goldenWord(e, "ldtrsb w0, [x1]", 0x38C00820)
	e = goldenWord(e, "ldtrsb x0, [x1]", 0x38800820)
	e = goldenWord(e, "ldtrsh w0, [x1]", 0x78C00820)
	e = goldenWord(e, "ldtrsh x0, [x1, #3]", 0x78803820)
	e = goldenWord(e, "ldtrsw x0, [x1, #4]", 0xB8804820)
	e = goldenWord(e, "sttr w0, [x1]", 0xB8000820)
	e = goldenWord(e, "sttr x0, [x1, #8]", 0xF8008820)
	e = goldenWord(e, "sttrb w0, [x1]", 0x38000820)
	e = goldenWord(e, "sttrh w0, [x1, #-1]", 0x781FF820)
	e = goldenWord(e, "sttr xzr, [sp]", 0xF8000BFF)
	e = goldenWord(e, "ldtr x0, [x0, #8]", 0xF8408800)
	return e
}

func TestGoldenAuthenticatedLoads() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldraa x0, [x1]", 0xF8200420)
	e = goldenWord(e, "ldraa x0, [x1, #8]", 0xF8201420)
	e = goldenWord(e, "ldraa x0, [x1, #-4096]", 0xF8600420)
	e = goldenWord(e, "ldraa x0, [x1, #4088]", 0xF83FF420)
	e = goldenWord(e, "ldraa x0, [x1, #8]!", 0xF8201C20)
	e = goldenWord(e, "ldraa x0, [x1, #-8]!", 0xF87FFC20)
	e = goldenWord(e, "ldrab x0, [x1]", 0xF8A00420)
	e = goldenWord(e, "ldrab x0, [sp, #16]!", 0xF8A02FE0)
	e = goldenWord(e, "ldrab x0, [x1, #-4096]!", 0xF8E00C20)
	e = goldenWord(e, "ldraa x0, [x0, #8]", 0xF8201400)
	e = goldenWord(e, "ldraa xzr, [sp, #8]!", 0xF8201FFF)
	e = goldenWord(e, "ldraa x0, [x1, #0]!", 0xF8200C20)
	e = goldenWord(e, "ldraa x0, [x1]!", 0xF8200C20)
	e = goldenWord(e, "ldrab x0, [x1]!", 0xF8A00C20)
	e = goldenWord(e, "ldraa xzr, [sp]!", 0xF8200FFF)
	e = goldenWord(e, "ldraa x0, [x1] !", 0xF8200C20)
	return e
}

// Rejected as clang rejects them: an offset out of range or (LDRAA / LDRAB) not a
// multiple of 8, writeback or register-offset addresses (LDTR / STTR take neither;
// LDRAA / LDRAB only pre-index), a register of the wrong size or kind, and an LDRAA
// writeback into its own base.
func TestGoldenUnprivilegedAuthRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ldtr x0, [x1, #256]")
	e = goldenReject(e, "ldtr x0, [x1, #8]!")
	e = goldenReject(e, "ldtr x0, [x1], #8")
	e = goldenReject(e, "ldtr x0, [x1, x2]")
	e = goldenReject(e, "ldtrb x0, [x1]")
	e = goldenReject(e, "ldtrsw w0, [x1]")
	e = goldenReject(e, "ldtr d0, [x1]")
	e = goldenReject(e, "sttr q0, [x1]")
	e = goldenReject(e, "ldraa x0, [x1, #4096]")
	e = goldenReject(e, "ldraa x0, [x1, #4]")
	e = goldenReject(e, "ldraa w0, [x1]")
	e = goldenReject(e, "ldraa x0, [x1], #8")
	e = goldenReject(e, "ldraa x0, [x0, #8]!")
	e = goldenReject(e, "ldraa x0, [x1, x2]")
	e = goldenReject(e, "ldrab x0, [x1, #-4104]!")
	e = goldenReject(e, "ldraa x1, [x1]!")
	e = goldenReject(e, "ldtr x0, [x1]!")
	return e
}
