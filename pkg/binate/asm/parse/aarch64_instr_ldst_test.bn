	e = goldenWord(e, "ldr q0, [x1, x2]", 0x3CE26820)
	e = goldenWord(e, "ldr q0, [x1]", 0x3DC00020)
	e = goldenWord(e, "ldr q0, [x1], #-256", 0x3CD00420)
	e = goldenWord(e, "ldr q0, [x1], #16", 0x3CC10420)
	e = goldenWord(e, "ldr q0, [x1], #255", 0x3CCFF420)
	e = goldenWord(e, "ldr q0, #16", 0x9C000080)
	e = goldenWord(e, "ldr q0, lbl", 0x9C000000)
	e = goldenWord(e, "ldr s0, [x1, #-4]", 0xBC5FC020)
	e = goldenWord(e, "ldr s0, [x1, #4]", 0xBD400420)
	e = goldenWord(e, "ldr s0, [x1], #4", 0xBC404420)
	e = goldenWord(e, "ldr w0, [x1, #-256]!", 0xB8500C20)
	e = goldenWord(e, "ldr w0, [x1, #-4]", 0xB85FC020)
	e = goldenWord(e, "ldr w0, [x1, #:lo12:sym]", 0xB9400020)
	e = goldenWord(e, "ldr w0, [x1, #16]", 0xB9401020)
	e = goldenWord(e, "ldr w0, [x1, #16380]", 0xB97FFC20)
	e = goldenWord(e, "ldr w0, [x1, #3]", 0xB8403020)
	e = goldenWord(e, "ldr w0, [x1, #3]!", 0xB8403C20)
	e = goldenWord(e, "ldr w0, [x1, #6]", 0xB8406020)
	e = goldenWord(e, "ldr w0, [x1, w2, sxtw #2]", 0xB862D820)
	e = goldenWord(e, "ldr w0, [x1, w2, uxtw]", 0xB8624820)
	e = goldenWord(e, "ldr w0, [x1, x2, lsl #2]", 0xB8627820)
	e = goldenWord(e, "ldr w0, #-4", 0x18FFFFE0)
	e = goldenWord(e, "ldr w0, lbl", 0x18000000)
	e = goldenWord(e, "ldr x0, [sp, #-8]", 0xF85F83E0)
	e = goldenWord(e, "ldr x0, [sp, #4088]", 0xF947FFE0)
	e = goldenWord(e, "ldr x0, [sp, xzr]", 0xF87F6BE0)
	e = goldenWord(e, "ldr x0, [x1, #-256]", 0xF8500020)
	e = goldenWord(e, "ldr x0, [x1, #-256]!", 0xF8500C20)
	e = goldenWord(e, "ldr x0, [x1, #-8]", 0xF85F8020)
	e = goldenWord(e, "ldr x0, [x1, #-8] // comment", 0xF85F8020)
	e = goldenWord(e, "ldr x0, [x1, #:got_lo12:sym]", 0xF9400020)
	e = goldenWord(e, "ldr x0, [x1, #:lo12:sym]", 0xF9400020)
	e = goldenWord(e, "ldr x0, [x1, #:lo12:sym+8]", 0xF9400020)
	e = goldenWord(e, "ldr x0, [x1, #0]", 0xF9400020)
	e = goldenWord(e, "ldr x0, [x1, #1+2*3]", 0xF8407020)
	e = goldenWord(e, "ldr x0, [x1, #12]", 0xF840C020)
	e = goldenWord(e, "ldr x0, [x1, #16]", 0xF9400820)
	e = goldenWord(e, "ldr x0, [x1, #255]", 0xF84FF020)
	e = goldenWord(e, "ldr x0, [x1, #255]!", 0xF84FFC20)
	e = goldenWord(e, "ldr x0, [x1, #32760]", 0xF97FFC20)
	e = goldenWord(e, "LDR X0, [X1, #8]", 0xF9400420)
	e = goldenWord(e, "ldr x0, [x1, #8]!", 0xF8408C20)
	e = goldenWord(e, "ldr x0, [x1, x2, lsl #0]", 0xF8626820)
