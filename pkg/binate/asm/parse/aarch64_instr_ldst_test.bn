package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden tests: each line assembles to exactly clang's word (`clang -c`, Mach-O
// arm64, or aarch64 ELF for the ELF-only `:lo12:` syntax and undefined local labels),
// or — where clang rejects it — is rejected.  Every valid instruction is one word:
// the text assembler never synthesizes a sequence.

// Load/store lines clang accepts, chunk 0.
func TestGoldenLdStAccepts0() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldnp d0, d1, [sp, #504]", 0x6C5F87E0)
	e = goldenWord(e, "ldnp q0, q1, [x1, #32]", 0xAC410420)
	e = goldenWord(e, "ldnp w0, w1, [x2]", 0x28400440)
	e = goldenWord(e, "ldnp x0, x1, [x2, #16]", 0xA8410440)
	e = goldenWord(e, "ldp d0, d1, [x1, #16]", 0x6D410420)
	e = goldenWord(e, "ldp d0, d1, [x1], #16", 0x6CC10420)
	e = goldenWord(e, "ldp d0, d1, [x2, #-512]", 0x6D600440)
	e = goldenWord(e, "ldp q0, q1, [x1, #-1024]", 0xAD600420)
	e = goldenWord(e, "ldp q0, q1, [x1, #1008]", 0xAD5F8420)
	e = goldenWord(e, "ldp q0, q1, [x1, #32]", 0xAD410420)
	e = goldenWord(e, "ldp q0, q1, [x1, #32]!", 0xADC10420)
	e = goldenWord(e, "ldp q0, q1, [x1]", 0xAD400420)
	e = goldenWord(e, "ldp q0, q1, [x1], #-1024", 0xACE00420)
	e = goldenWord(e, "ldp q0, q1, [x1], #32", 0xACC10420)
	e = goldenWord(e, "ldp s0, s1, [x1, #8]", 0x2D410420)
	e = goldenWord(e, "ldp s0, s1, [x2], #8", 0x2CC10440)
	e = goldenWord(e, "ldp w0, w1, [x2, #-256]", 0x29600440)
	e = goldenWord(e, "ldp w0, w1, [x2, #252]", 0x295F8440)
	e = goldenWord(e, "ldp x0, x1, [sp], #16", 0xA8C107E0)
	e = goldenWord(e, "ldp x0, x1, [x2, #-16]!", 0xA9FF0440)
	e = goldenWord(e, "ldp x0, x1, [x2, #-512]", 0xA9600440)
	e = goldenWord(e, "ldp x0, x1, [x2, #0]!", 0xA9C00440)
	e = goldenWord(e, "ldp x0, x1, [x2, #16]!", 0xA9C10440)
	e = goldenWord(e, "ldp x0, x1, [x2, #504]", 0xA95F8440)
	e = goldenWord(e, "ldp x0, x1, [x2, #504]!", 0xA9DF8440)
	e = goldenWord(e, "ldp x0, x1, [x2]", 0xA9400440)
	e = goldenWord(e, "ldp x0, x1, [x2], #-16", 0xA8FF0440)
	e = goldenWord(e, "ldp x0, x1, [x2], #16", 0xA8C10440)
	e = goldenWord(e, "ldp x29, x30, [sp], #16", 0xA8C17BFD)
	e = goldenWord(e, "ldpsw x0, x1, [x2, #8]", 0x69410440)
	e = goldenWord(e, "ldpsw x0, x1, [x2, #8]!", 0x69C10440)
	e = goldenWord(e, "ldr b0, [x1, #4095]", 0x3D7FFC20)
	e = goldenWord(e, "ldr b0, [x1]", 0x3D400020)
	e = goldenWord(e, "ldr d0, [x0], #8", 0xFC408400)
	e = goldenWord(e, "ldr d0, [x1, #-8]", 0xFC5F8020)
	e = goldenWord(e, "ldr d0, [x1, #:lo12:sym]", 0xFD400020)
	e = goldenWord(e, "ldr d0, [x1, #4]", 0xFC404020)
	e = goldenWord(e, "ldr d0, [x1, #8]", 0xFD400420)
	e = goldenWord(e, "ldr d0, [x1, #8]!", 0xFC408C20)
	e = goldenWord(e, "ldr d0, [x1, x2, lsl #3]", 0xFC627820)
	e = goldenWord(e, "ldr d0, [x1], #8", 0xFC408420)
	e = goldenWord(e, "ldr h0, [x1, #2]", 0x7D400420)
	e = goldenWord(e, "ldr h0, [x1, x2, lsl #1]", 0x7C627820)
