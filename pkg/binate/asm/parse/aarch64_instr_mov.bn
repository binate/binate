package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/aarch64/isa"

// AArch64 moves: `mov` (register, immediate or MOVW-group operand) and MOVZ / MOVN /
// MOVK, with the ELF MOVW-group relocation operators (`#:abs_g1:sym`, `#:prel_g0_nc:sym`,
// …), which the linker fills with a 16-bit chunk of a symbol's address (isa.FIX_MOVW_*).

// movwSpecKind returns the isa.FIX_MOVW_* kind of a MOVW-group operator's name (any
// case, as clang reads it), or -1.
func movwSpecKind(name *[]readonly char) int {
	if nameIs(name, "abs_g0") { return isa.FIX_MOVW_UABS_G0 }
	if nameIs(name, "abs_g0_nc") { return isa.FIX_MOVW_UABS_G0_NC }
	if nameIs(name, "abs_g1") { return isa.FIX_MOVW_UABS_G1 }
	if nameIs(name, "abs_g1_nc") { return isa.FIX_MOVW_UABS_G1_NC }
	if nameIs(name, "abs_g2") { return isa.FIX_MOVW_UABS_G2 }
	if nameIs(name, "abs_g2_nc") { return isa.FIX_MOVW_UABS_G2_NC }
	if nameIs(name, "abs_g3") { return isa.FIX_MOVW_UABS_G3 }
	if nameIs(name, "abs_g0_s") { return isa.FIX_MOVW_SABS_G0 }
	if nameIs(name, "abs_g1_s") { return isa.FIX_MOVW_SABS_G1 }
	if nameIs(name, "abs_g2_s") { return isa.FIX_MOVW_SABS_G2 }
	if nameIs(name, "prel_g0") { return isa.FIX_MOVW_PREL_G0 }
	if nameIs(name, "prel_g0_nc") { return isa.FIX_MOVW_PREL_G0_NC }
	if nameIs(name, "prel_g1") { return isa.FIX_MOVW_PREL_G1 }
	if nameIs(name, "prel_g1_nc") { return isa.FIX_MOVW_PREL_G1_NC }
	if nameIs(name, "prel_g2") { return isa.FIX_MOVW_PREL_G2 }
	if nameIs(name, "prel_g2_nc") { return isa.FIX_MOVW_PREL_G2_NC }
	if nameIs(name, "prel_g3") { return isa.FIX_MOVW_PREL_G3 }
	return -1
}

// emitA64Movw emits move-wide op (sf, Rd rd) at shift with the MOVW-group operand it
// (IT_MOVW), its addend within a host int.
func emitA64Movw(p @Parser, op uint32, sf bool, rd int, it a64Item, shift int) {
	if !intFits(it.Imm) {
		setErr(p, "relocation addend out of range")
		return
	}
	isa.MoveWideReloc(p.Asm, op, sf, rd, shift, it.Label, cast(int, it.Imm), it.Spec)
}

// dpMov emits `mov`: register-to-register (ADD #0 when either side is SP, else ORR
// from the zero register), an immediate — MOVZ, else MOVN, else an ORR bitmask, the
// order clang uses — rejecting a value none of them encodes, or a MOVW-group operand
// (IT_MOVW) as clang assembles it: a MOVZ at shift 0 for any chunk and either width.
func dpMov(p @Parser, its a64Items) {
	if !dpExpectCount(p, its, 2) { return }
	var sf bool = false
	var ok bool = false
	sf, ok = dpFirstWidth(p, its, 0)
	if !ok { return }
	if its.It[1].Kind == IT_REG {
		var sp bool = rcIsSP(its.It[0].Cls) || rcIsSP(its.It[1].Cls)
		var rd int = dpRegAt(p, its, 0, sf, sp, !sp)
		var rm int = dpRegAt(p, its, 1, sf, sp, !sp)
		if p.HasError { return }
		if sp {
			isa.AddSubImm(p.Asm, isa.OPS_ADD, sf, rd, rm, 0, false)
		} else {
			isa.LogicalShifted(p.Asm, isa.LG_ORR, sf, rd, 31, rm, aarch64.LSL, 0)
		}
		return
	}
	if its.It[1].Kind == IT_MOVW {
		// clang's alias: a MOVZ at shift 0, whatever the chunk (see isa.MoveWideReloc).
		var mrd int = dpRegAt(p, its, 0, sf, false, true)
		if p.HasError { return }
		emitA64Movw(p, isa.MW_MOVZ, sf, mrd, its.It[1], 0)
		return
	}
	if its.It[1].Kind != IT_IMM {
		setErr(p, "mov takes a register or an immediate")
		return
	}
	var toSP bool = rcIsSP(its.It[0].Cls)
	var rd int = dpRegAt(p, its, 0, sf, true, true)
	if p.HasError { return }
	var v uint64 = cast(uint64, its.It[1].Imm)
	if !sf {
		var hi uint64 = v >> 32
		if hi != 0 && !(hi == 0xFFFFFFFF && (v & 0x80000000) != 0) {
			setErr(p, "mov immediate does not fit a 32-bit register")
			return
		}
		v = v & 0xFFFFFFFF
	}
	if !toSP {
		var chunk int = 0
		var shift int = 0
		chunk, shift, ok = movWideChunk(v, sf)
		if ok {
			isa.MoveWide(p.Asm, isa.MW_MOVZ, sf, rd, chunk, shift)
			return
		}
		var inv uint64 = v ^ 0xFFFFFFFFFFFFFFFF
		if !sf { inv = inv & 0xFFFFFFFF }
		chunk, shift, ok = movWideChunk(inv, sf)
		if ok {
			isa.MoveWide(p.Asm, isa.MW_MOVN, sf, rd, chunk, shift)
			return
		}
	}
	if !isa.IsLogicalImm(v, sf) {
		setErr(p, "mov immediate is not encodable as MOVZ, MOVN or a bitmask immediate")
		return
	}
	// ORR (immediate)'s Rd 31 is SP, so the zero register cannot take this form.
	if its.It[0].Cls == RC_XZR || its.It[0].Cls == RC_WZR {
		setErr(p, "a bitmask-immediate mov cannot target the zero register")
		return
	}
	isa.LogicalImm(p.Asm, isa.LG_ORR, sf, rd, 31, v)
}

// movWideChunk reports whether v is a single 16-bit chunk at a 16-bit-aligned
// position within the register width (zero is chunk 0 at shift 0), returning the
// chunk and its shift.
func movWideChunk(v uint64, sf bool) (int, int, bool) {
	var w int = 32
	if sf { w = 64 }
	if v == 0 { return 0, 0, true }
	for s := 0; s < w; s = s + 16 {
		var chunk uint64 = (v >> cast(uint64, s)) & 0xFFFF
		if (chunk << cast(uint64, s)) == v { return cast(int, chunk), s, true }
	}
	return 0, 0, false
}

// dpMoveWide emits movz / movn / movk `Rd, #imm16{, lsl #shift}`, or `Rd, #:abs_g1:sym`
// (an IT_MOVW operand: its chunk's shift, which a W register allows only for G0 / G1).
func dpMoveWide(p @Parser, mnem *[]readonly char, its a64Items) {
	var op uint32 = isa.MW_MOVZ
	if mnemIs(mnem, "movn") { op = isa.MW_MOVN }
	if mnemIs(mnem, "movk") { op = isa.MW_MOVK }
	if its.N < 2 || its.N > 3 {
		setErr(p, "wrong number of operands")
		return
	}
	var sf bool = false
	var ok bool = false
	sf, ok = dpFirstWidth(p, its, 0)
	if !ok { return }
	var rd int = dpRegAt(p, its, 0, sf, false, true)
	if p.HasError { return }
	if its.It[1].Kind == IT_MOVW {
		var mshift int = isa.MovwFixShift(its.It[1].Spec)
		if its.N == 3 {
			setErr(p, "a MOVW-group relocation operator sets the shift; it takes no `lsl`")
			return
		}
		if !sf && mshift > 16 {
			setErr(p, "a W register takes only a G0 or G1 relocation operator")
			return
		}
		emitA64Movw(p, op, sf, rd, its.It[1], mshift)
		return
	}
	if its.It[1].Kind != IT_IMM {
		setErr(p, "expected a 16-bit immediate")
		return
	}
	var shift int = 0
	if its.N == 3 {
		var m a64Item = its.It[2]
		if m.Kind != IT_MOD || m.Mod != MOD_LSL || !m.AmtGiven {
			setErr(p, "expected `lsl #shift`")
			return
		}
		shift = m.Amt
	}
	var imm int64 = its.It[1].Imm
	if imm < 0 || imm > 0xFFFF {
		setErr(p, "move-wide immediate out of range [0, 65535]")
		return
	}
	isa.MoveWide(p.Asm, op, sf, rd, cast(int, imm), shift)
}
