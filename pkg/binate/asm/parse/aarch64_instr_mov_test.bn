package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// The MOVW-group relocation operators against clang's words and relocations (`clang -c
// -target aarch64-linux-gnu`): MOVZ / MOVN / MOVK at the chunk's shift, `mov` a MOVZ at
// shift 0 for any chunk and width, and a relocation of the operator's kind against the
// symbol plus the addend.  (labelsSource / labelsWordsHex / labelsReject are in
// aarch64_golden_labels_test.bn, goldenFail in aarch64_golden_test.bn.)

// movwRelocs renders p's relocations as `<kind - FIX_MOVW_UABS_G0>@<offset>:<symbol as
// a diagnostic names it><addend> `, the addend signed and omitted when 0.
func movwRelocs(p @Parser) @[]char {
	var out @[]char = ""
	for i := 0; i < p.Asm.NumRelocs; i++ {
		var r asm.Relocation = p.Asm.Relocs[i]
		var one @[]char = buf.Concat(strconv.Itoa(r.Kind - isa.FIX_MOVW_UABS_G0), "@")
		one = buf.Concat(one, strconv.Itoa(cast(int, r.Offset)))
		one = buf.Concat(one, ":")
		one = buf.Concat(one, asm.LabelForMessage(p.Asm.Symbols[r.Symbol].Name))
		if r.Addend > 0 { one = buf.Concat(one, "+") }
		if r.Addend != 0 { one = buf.Concat(one, strconv.Itoa(r.Addend)) }
		out = buf.Concat(out, buf.Concat(one, " "))
	}
	return out
}

// movwCase checks that src assembles for ELF to exactly the words want and the
// relocations relocs (movwRelocs).
func movwCase(e @[]char, src *[]readonly char, want *[]readonly char,
		relocs *[]readonly char) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	var gotR @[]char = movwRelocs(p)
	if !charsEqual(gotR, relocs) { return goldenFail(e, src, buf.Concat("relocations ", gotR)) }
	return e
}

// Each of the 17 operators on the instruction clang puts it on, at its chunk's shift.
func TestMovwForms() testing.TestResult {
	var e @[]char = ""
	e = movwCase(e,
			".global sym\nmovz x0, #:abs_g3:sym\nmovz x1, #:abs_g2:sym\nmovz x2, #:abs_g2_nc:sym+4\n"
					"movk x3, #:abs_g2_nc:sym\nmovz x4, #:abs_g1:sym\nmovk x5, #:abs_g1_nc:sym\n"
					"movn x6, #:abs_g2_s:sym\nmovz x7, #:abs_g1_s:sym\nmovz x8, #:abs_g0_s:sym\n"
					"movz x9, #:abs_g0:sym\nmovk x10, #:abs_g0_nc:sym\nmovz x11, #:prel_g3:sym\n"
					"movz x12, #:prel_g2:sym\nmovk x13, #:prel_g2_nc:sym\nmovn x14, #:prel_g1:sym\n"
					"movk x15, #:prel_g1_nc:sym\nmovz x16, #:prel_g0:sym\nmovk x17, #:prel_g0_nc:sym",
			"D2E00000 D2C00001 D2C00002 F2C00003 D2A00004 F2A00005 92C00006 D2A00007 D2800008 "
					"D2800009 F280000A D2E0000B D2C0000C F2C0000D 92A0000E F2A0000F D2800010 F2800011 ",
			"6@0:sym 4@4:sym 5@8:sym+4 5@12:sym 2@16:sym 3@20:sym 9@24:sym 8@28:sym 7@32:sym "
					"0@36:sym 1@40:sym 16@44:sym 14@48:sym 15@52:sym 12@56:sym 13@60:sym 10@64:sym "
					"11@68:sym ")
	return e
}

// A W register takes G0 / G1 on MOVZ / MOVN / MOVK; `mov` is a MOVZ at shift 0 whatever
// the chunk, on either width; the zero register is a destination.
func TestMovwWidths() testing.TestResult {
	var e @[]char = ""
	e = movwCase(e,
			".global sym\nmovz w18, #:abs_g1:sym\nmovk w19, #:abs_g0_nc:sym\nmovn w20, #:prel_g1:sym\n"
					"mov x21, #:abs_g3:sym\nmov w22, #:abs_g2_nc:sym\nmov x23, #:prel_g0:sym\n"
					"movz xzr, #:abs_g0:sym\nmov wzr, #:abs_g1_s:sym",
			"52A00012 72800013 12A00014 D2800015 52800016 D2800017 D280001F 5280001F ",
			"2@0:sym 1@4:sym 12@8:sym 6@12:sym 5@16:sym 10@20:sym 0@24:sym 8@28:sym ")
	return e
}

// No `#`, spaces, any case, a parenthesized or leading addend, a local symbol, `.` (a
// label made at the instruction), an alias (its symbol plus offset), an addend past 32
// bits and numeric local labels.  (clang relocates every local one against its section's
// symbol; the ELF writer does so for the temporaries — `.` and the numeric labels — and
// names `f` and the alias's `f`, which links to the same address.)
func TestMovwSpellings() testing.TestResult {
	var e @[]char = ""
	e = movwCase(e,
			".global sym\nf:\nmovz x24, :abs_g0:sym-8\nmovz x25, #:ABS_G1:(sym+4)\n"
					"movz x26, #:abs_g0:4+sym\nmovz x27, #:abs_g0:f\nmovz x28, #:abs_g1:.+8\nA = f + 4\n"
					"movk x29, #:abs_g0_nc:A\nmovz x30, #:abs_g0:sym+0x100000000\n1: movz x0, #:abs_g0:1b\n"
					"movz x1, #:prel_g0_nc:2f\n2: nop",
			"D2800018 D2A00019 D280001A D280001B D2A0001C F280001D D280001E D2800000 D2800001 "
					"D503201F ",
			"0@0:sym-8 2@4:sym+4 0@8:sym+4 0@12:f 2@16:location . (definition 0)+8 1@20:f+4 "
					"0@24:sym+4294967296 0@28:local label 1 (definition 1) "
					"11@32:local label 2 (definition 1) ")
	e = movwCase(e, ".global sym\nmovz x1, # : abs_g0 : sym", "D2800001 ", "0@0:sym ")
	return e
}

// Rejected as clang rejects them: an explicit shift, a G2 / G3 operator on a W register's
// MOVZ / MOVN / MOVK, SP, an `@` specifier, `:lo12:` on a MOVZ, add / ldr (an offset) / adrp
// / orr / cmp / adr, a data word, an unknown or empty operator, a trailing operand.
func TestMovwRejects() testing.TestResult {
	var e @[]char = ""
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 22)
	bad[0] = "movz x0, #:abs_g1:sym, lsl #16"
	bad[1] = "movz x0, #:abs_g0:sym, lsl #0"
	bad[2] = "movz w0, #:abs_g2:sym"
	bad[3] = "movk w0, #:prel_g3:sym"
	bad[4] = "movn w0, #:abs_g2_s:sym"
	bad[5] = "movk w0, #:abs_g2_nc:sym"
	bad[6] = "movz sp, #:abs_g0:sym"
	bad[7] = "mov sp, #:abs_g0:sym"
	bad[8] = "movz x0, #:abs_g0:sym@PAGE"
	bad[9] = "movz x2, #:lo12:sym"
	bad[10] = "add x0, x0, #:abs_g0_nc:sym"
	bad[11] = "ldr x0, [x1, #:abs_g0_nc:sym]"
	bad[12] = "adrp x0, :abs_g1:sym"
	bad[13] = "orr x0, xzr, #:abs_g0:sym"
	bad[14] = "cmp x0, #:abs_g0:sym"
	bad[15] = "adr x0, :abs_g0:sym"
	bad[16] = ".uint64 0, :abs_g0:sym"
	bad[17] = "movz x0, #:abs_g9:sym"
	bad[18] = "movz x0, #:abs_g0:"
	bad[19] = "movz x0, #:abs_g0:sym, #1"
	bad[20] = "mov x0, #:abs_g0:sym, lsl #16"
	bad[21] = "movz x0, #:abs_g0"
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global sym\n", bad[i])) }
	return e
}

// Rejected deliberately, where clang accepts: a number after the operator (clang folds
// `#:abs_g0:5` to 5, as it does `:lo12:5`), and the operator on a branch, a literal load,
// EXT or a fixed-point conversion — clang drops the operator there, relocating the branch or
// load to the plain symbol (`b #:abs_g0:sym` is a JUMP26 to sym) and taking 8 as EXT's
// index and the conversion's fraction bits, so the source does not say what it assembles to.
func TestMovwRejectsDeliberate() testing.TestResult {
	var e @[]char = ""
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 11)
	bad[0] = "movz x0, #:abs_g0:5"
	bad[1] = "b #:abs_g0:sym"
	bad[2] = "bl #:abs_g0:sym"
	bad[3] = "b.eq #:abs_g0:sym"
	bad[4] = "cbz x0, #:abs_g0:sym"
	bad[5] = "cbnz w0, :abs_g0:sym"
	bad[6] = "tbz x0, #1, #:abs_g0:sym"
	bad[7] = "ldr x0, :abs_g0:sym"
	bad[8] = "ext v0.16b, v1.16b, v2.16b, #:abs_g0:sym"
	bad[9] = "ucvtf d0, x0, #:abs_g0:sym"
	bad[10] = "scvtf s0, w0, #:abs_g0:sym"
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global sym\n", bad[i])) }
	return e
}
