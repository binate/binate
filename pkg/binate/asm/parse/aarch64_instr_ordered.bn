package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 exclusive and ordered loads / stores: LDXR / LDAXR / STXR / STLXR (and
// their B / H forms), the pair forms LDXP / LDAXP / STXP / STLXP, LDAR / STLR,
// LDLAR / STLLR, LDAPR, the RCpc unscaled LDAPUR / LDAPURS{B,H,W} / STLUR (general
// purpose and SIMD&FP), and the RCpc pairs LDIAPP / STILP.  Their address is a bare
// base `[Xn|SP]` — `#0` is the only offset allowed — except LDAPUR / STLUR's signed
// 9-bit offset and the writeback forms: LDAPR / LDIAPP post-increment the base by the
// transfer size, STLR / STILP pre-decrement it.

// Kinds of exclusive / ordered load-store mnemonic (a64Ordered.Kind).
const (
	ORD_NONE int = iota
	ORD_SINGLE          // isa.LdStOrdered:        `<op> Rt, [Xn|SP]`
	ORD_STXR            // isa.StoreExclusive:     `<op> Ws, Rt, [Xn|SP]`
	ORD_LDXP            // isa.LoadExclusivePair:  `<op> Rt, Rt2, [Xn|SP]`
	ORD_STXP            // isa.StoreExclusivePair: `<op> Ws, Rt, Rt2, [Xn|SP]`
	ORD_RCPC            // isa.LdStRcpcUnscaled:   `<op> Rt, [Xn|SP{, #simm9}]`
	ORD_LDIAPP          // isa.LdStOrderedPair:    `ldiapp Rt, Rt2, [Xn|SP]` or `…, [Xn|SP], #size`
	ORD_STILP           // isa.LdStOrderedPair:    `stilp Rt, Rt2, [Xn|SP]` or `…, [Xn|SP, #-size]!`
)

// a64Ordered describes an exclusive / ordered load-store mnemonic: its kind; the
// LSO_* op of a single or STXR form and its byte / halfword suffix size (0 / 1, or -1
// for none: a W or X transfer register then sets the size); whether a pair form
// acquires / releases; and the scaled mnemonic whose transfer an LDAPUR / STLUR names.
type a64Ordered struct {
	Kind    int
	Op      uint32
	Size    int
	Ordered bool
	Base    *[]readonly char
}

// orderedStem maps a size-less single-register or store-exclusive mnemonic to its
// kind and LSO_* op, or ORD_NONE.
func orderedStem(stem *[]readonly char) (int, uint32) {
	if mnemIs(stem, "ldxr") { return ORD_SINGLE, isa.LSO_LDXR }
	if mnemIs(stem, "ldaxr") { return ORD_SINGLE, isa.LSO_LDAXR }
	if mnemIs(stem, "ldar") { return ORD_SINGLE, isa.LSO_LDAR }
	if mnemIs(stem, "stlr") { return ORD_SINGLE, isa.LSO_STLR }
	if mnemIs(stem, "ldlar") { return ORD_SINGLE, isa.LSO_LDLAR }
	if mnemIs(stem, "stllr") { return ORD_SINGLE, isa.LSO_STLLR }
	if mnemIs(stem, "ldapr") { return ORD_SINGLE, isa.LSO_LDAPR }
	if mnemIs(stem, "stxr") { return ORD_STXR, isa.LSO_STXR }
	if mnemIs(stem, "stlxr") { return ORD_STXR, isa.LSO_STLXR }
	return ORD_NONE, 0
}

// rcpcBase maps an LDAPUR / STLUR-family mnemonic to the scaled load / store whose
// transfer it names, or "".
func rcpcBase(mnem *[]readonly char) *[]readonly char {
	if mnemIs(mnem, "ldapur") { return "ldr" }
	if mnemIs(mnem, "ldapurb") { return "ldrb" }
	if mnemIs(mnem, "ldapurh") { return "ldrh" }
	if mnemIs(mnem, "ldapursb") { return "ldrsb" }
	if mnemIs(mnem, "ldapursh") { return "ldrsh" }
	if mnemIs(mnem, "ldapursw") { return "ldrsw" }
	if mnemIs(mnem, "stlur") { return "str" }
	if mnemIs(mnem, "stlurb") { return "strb" }
	if mnemIs(mnem, "stlurh") { return "strh" }
	return ""
}

// a64OrderedOf classifies mnem (Kind ORD_NONE when it is not one of these).
func a64OrderedOf(mnem *[]readonly char) a64Ordered {
	var o a64Ordered
	o.Size = -1
	o.Kind, o.Op = orderedStem(mnem)
	if o.Kind != ORD_NONE { return o }
	var n int = len(mnem)
	if n > 1 {
		var last char = lowerChar(mnem[n - 1])
		if last == 'b' || last == 'h' {
			o.Kind, o.Op = orderedStem(mnem[0:n - 1])
			if o.Kind != ORD_NONE {
				o.Size = 0
				if last == 'h' { o.Size = 1 }
				return o
			}
		}
	}
	if mnemIs(mnem, "ldxp") || mnemIs(mnem, "ldaxp") {
		o.Kind = ORD_LDXP
		o.Ordered = mnemIs(mnem, "ldaxp")
		return o
	}
	if mnemIs(mnem, "stxp") || mnemIs(mnem, "stlxp") {
		o.Kind = ORD_STXP
		o.Ordered = mnemIs(mnem, "stlxp")
		return o
	}
	if mnemIs(mnem, "ldiapp") {
		o.Kind = ORD_LDIAPP
		return o
	}
	if mnemIs(mnem, "stilp") {
		o.Kind = ORD_STILP
		return o
	}
	o.Base = rcpcBase(mnem)
	if len(o.Base) != 0 { o.Kind = ORD_RCPC }
	return o
}

// orderedReg reads the register at tok and the ',' after it, returning the lexer and
// the token after the comma, the register's number and class (RC_NONE when tok is
// not a register), and ok=false with p's error set on a missing comma.
func orderedReg(p @Parser, l Lexer, tok Token) (Lexer, Token, int, int, bool) {
	var r int = -1
	var cls int = RC_NONE
	if tok.Kind == TOK_IDENT { r, cls = parseA64Reg(tok.Text) }
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' after the register")
		return l, tok, r, cls, false
	}
	l, tok = LexNext(l)
	return l, tok, r, cls, true
}

// parseA64Ordered parses and emits one exclusive / ordered load-store o; l is
// positioned just after the mnemonic.  Returns the lexer and the token after the
// last operand for the caller's end-of-line check.
func parseA64Ordered(p @Parser, l Lexer, o a64Ordered) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	var ok bool = true
	var rs int = -1
	var scls int = RC_NONE
	if o.Kind == ORD_STXR || o.Kind == ORD_STXP {
		l, tok, rs, scls, ok = orderedReg(p, l, tok)
		if !ok { return l, tok }
		if !rcIsW(scls) {
			setErr(p, "the status register of a store exclusive must be a W register")
			return l, tok
		}
	}
	var rt int = -1
	var tcls int = RC_NONE
	l, tok, rt, tcls, ok = orderedReg(p, l, tok)
	if !ok { return l, tok }
	var rt2 int = -1
	var paired bool = o.Kind == ORD_LDXP || o.Kind == ORD_STXP || o.Kind == ORD_LDIAPP ||
			o.Kind == ORD_STILP
	if paired {
		var cls2 int = RC_NONE
		l, tok, rt2, cls2, ok = orderedReg(p, l, tok)
		if !ok { return l, tok }
		if !(rcIsW(tcls) && rcIsW(cls2)) && !(rcIsX(tcls) && rcIsX(cls2)) {
			setErr(p, "the two data registers must both be W or both be X registers")
			return l, tok
		}
	}
	var ad a64Addr
	l, tok, ad, ok = parseA64Addr(p, l, tok)
	if !ok { return l, tok }
	if o.Kind == ORD_RCPC {
		emitA64Rcpc(p, o, rt, tcls, ad)
		return l, tok
	}
	if o.Kind == ORD_LDIAPP || o.Kind == ORD_STILP {
		emitA64OrderedPair(p, o.Kind == ORD_LDIAPP, rcIsX(tcls), rt, rt2, ad)
		return l, tok
	}
	if (o.Op == isa.LSO_LDAPR && ad.Mode == ADDR_POST) ||
			(o.Op == isa.LSO_STLR && ad.Mode == ADDR_PRE) {
		emitA64OrderedWriteback(p, o, rt, tcls, ad)
		return l, tok
	}
	if !(ad.Mode == ADDR_BASE || (ad.Mode == ADDR_IMM && ad.Imm == 0)) {
		setErr(p, "index must be absent or #0")
		return l, tok
	}
	if o.Kind == ORD_LDXP {
		isa.LoadExclusivePair(p.Asm, o.Ordered, rcIsX(tcls), rt, rt2, ad.Base)
		return l, tok
	}
	if o.Kind == ORD_STXP {
		isa.StoreExclusivePair(p.Asm, o.Ordered, rcIsX(tcls), rs, rt, rt2, ad.Base)
		return l, tok
	}
	var size int = o.Size
	if size < 0 && rcIsW(tcls) { size = 2 }
	if size < 0 && rcIsX(tcls) { size = 3 }
	if size < 0 || (!rcIsW(tcls) && size != 3) {
		setErr(p, "invalid transfer register for this load/store")
		return l, tok
	}
	if o.Kind == ORD_STXR {
		isa.StoreExclusive(p.Asm, o.Op, size, rs, rt, ad.Base)
		return l, tok
	}
	isa.LdStOrdered(p.Asm, o.Op, size, rt, ad.Base)
	return l, tok
}

// emitA64Rcpc emits an LDAPUR / STLUR-family transfer at [Xn|SP{, #simm9}]: the
// transfer register's class picks the LS_* spec as for the scaled mnemonic o.Base.
func emitA64Rcpc(p @Parser, o a64Ordered, rt int, cls int, ad a64Addr) {
	var spec uint32 = 0
	var ok bool = false
	spec, ok = singleSpec(o.Base, cls)
	if !ok {
		setErr(p, "invalid transfer register for this load/store")
		return
	}
	var off int = 0
	if ad.Mode == ADDR_IMM {
		off = ad.Imm
	} else if ad.Mode != ADDR_BASE {
		setErr(p, "LDAPUR/STLUR-family instructions take only [Xn|SP{, #simm9}]")
		return
	}
	isa.LdStRcpcUnscaled(p.Asm, spec, rt, ad.Base, off)
}

// emitA64OrderedPair emits LDIAPP (load) / STILP at [Xn|SP] or in its one writeback
// form: LDIAPP `[Xn|SP], #size` post-increments by the pair's size (8 for W, 16 for
// X), STILP `[Xn|SP, #-size]!` pre-decrements.
func emitA64OrderedPair(p @Parser, load bool, sf bool, rt int, rt2 int, ad a64Addr) {
	var size int = 8
	if sf { size = 16 }
	var wb bool = false
	if load && ad.Mode == ADDR_POST && ad.Imm == size {
		wb = true
	} else if !load && ad.Mode == ADDR_PRE && ad.Imm == -size {
		wb = true
	} else if !(ad.Mode == ADDR_BASE || (ad.Mode == ADDR_IMM && ad.Imm == 0)) {
		setErr(p,
				"ldiapp takes [Xn|SP] or [Xn|SP], #<pair size>; stilp [Xn|SP] or "
						"[Xn|SP, #-<pair size>]!")
		return
	}
	isa.LdStOrderedPair(p.Asm, load, sf, rt, rt2, ad.Base, wb)
}

// emitA64OrderedWriteback emits the writeback form of LDAPR (`[Xn|SP], #size`) or
// STLR (`[Xn|SP, #-size]!`) — W or X registers only, size the register's width.
func emitA64OrderedWriteback(p @Parser, o a64Ordered, rt int, cls int, ad a64Addr) {
	var load bool = o.Op == isa.LSO_LDAPR
	if o.Size >= 0 || !(rcIsW(cls) || rcIsX(cls)) {
		setErr(p, "only LDAPR / STLR of a W or X register have a writeback form")
		return
	}
	var size int = 4
	if rcIsX(cls) { size = 8 }
	if (load && ad.Imm != size) || (!load && ad.Imm != -size) {
		setErr(p, "LDAPR post-increments, and STLR pre-decrements, by the register's size")
		return
	}
	isa.LdStOrderedWriteback(p.Asm, load, rcIsX(cls), rt, ad.Base)
}
