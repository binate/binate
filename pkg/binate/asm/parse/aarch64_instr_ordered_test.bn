package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the exclusive / ordered loads and stores, from clang
// (`clang -c -target aarch64-linux-gnu -march=armv8.4-a`; the SIMD&FP LDAPUR / STLUR
// lines with `-march=armv9.4-a+rcpc3`), objdump'd.

func TestGoldenOrderedLdSt() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldxrb w0, [x1]", 0x085F7C20)
	e = goldenWord(e, "ldxrh w0, [x1]", 0x485F7C20)
	e = goldenWord(e, "ldxr w0, [x1]", 0x885F7C20)
	e = goldenWord(e, "ldxr x0, [x1, #0]", 0xC85F7C20)
	e = goldenWord(e, "ldxr x0, [sp]", 0xC85F7FE0)
	e = goldenWord(e, "ldaxrb w0, [x1]", 0x085FFC20)
	e = goldenWord(e, "ldaxrh w0, [x1]", 0x485FFC20)
	e = goldenWord(e, "ldaxr w0, [x1]", 0x885FFC20)
	e = goldenWord(e, "ldaxr x0, [x1]", 0xC85FFC20)
	e = goldenWord(e, "stxrb w2, w0, [x1]", 0x08027C20)
	e = goldenWord(e, "stxrh w2, w0, [x1]", 0x48027C20)
	e = goldenWord(e, "stxr w2, w0, [x1]", 0x88027C20)
	e = goldenWord(e, "stxr w2, x0, [x1]", 0xC8027C20)
	e = goldenWord(e, "stlxrb w2, w0, [x1]", 0x0802FC20)
	e = goldenWord(e, "stlxrh w2, w0, [x1]", 0x4802FC20)
	e = goldenWord(e, "stlxr w2, w0, [x1]", 0x8802FC20)
	e = goldenWord(e, "stlxr w2, x0, [sp]", 0xC802FFE0)
	e = goldenWord(e, "ldxp w0, w1, [x2]", 0x887F0440)
	e = goldenWord(e, "ldxp x0, x1, [x2]", 0xC87F0440)
	e = goldenWord(e, "ldaxp w0, w1, [x2]", 0x887F8440)
	e = goldenWord(e, "ldaxp x0, x1, [x2]", 0xC87F8440)
	e = goldenWord(e, "stxp w3, w0, w1, [x2]", 0x88230440)
	e = goldenWord(e, "stxp w3, x0, x1, [x2]", 0xC8230440)
	e = goldenWord(e, "stlxp w3, w0, w1, [x2]", 0x88238440)
	e = goldenWord(e, "stlxp w3, x0, x1, [x2]", 0xC8238440)
	e = goldenWord(e, "ldarb w0, [x1]", 0x08DFFC20)
	e = goldenWord(e, "ldarh w0, [x1]", 0x48DFFC20)
	e = goldenWord(e, "ldar w0, [x1]", 0x88DFFC20)
	e = goldenWord(e, "ldar x0, [x1]", 0xC8DFFC20)
	e = goldenWord(e, "stlrb w0, [x1]", 0x089FFC20)
	e = goldenWord(e, "stlrh w0, [x1]", 0x489FFC20)
	e = goldenWord(e, "stlr w0, [x1]", 0x889FFC20)
	e = goldenWord(e, "stlr x0, [x1]", 0xC89FFC20)
	e = goldenWord(e, "ldlarb w0, [x1]", 0x08DF7C20)
	e = goldenWord(e, "ldlarh w0, [x1]", 0x48DF7C20)
	return e
}

func TestGoldenOrderedLdSt2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ldlar w0, [x1]", 0x88DF7C20)
	e = goldenWord(e, "ldlar x0, [x1]", 0xC8DF7C20)
	e = goldenWord(e, "stllrb w0, [x1]", 0x089F7C20)
	e = goldenWord(e, "stllrh w0, [x1]", 0x489F7C20)
	e = goldenWord(e, "stllr w0, [x1]", 0x889F7C20)
	e = goldenWord(e, "stllr x0, [x1]", 0xC89F7C20)
	e = goldenWord(e, "ldaprb w0, [x1]", 0x38BFC020)
	e = goldenWord(e, "ldaprh w0, [x1]", 0x78BFC020)
	e = goldenWord(e, "ldapr w0, [x1]", 0xB8BFC020)
	e = goldenWord(e, "ldapr x0, [x1]", 0xF8BFC020)
	e = goldenWord(e, "ldapurb w0, [x1, #-1]", 0x195FF020)
	e = goldenWord(e, "ldapurh w0, [x1, #2]", 0x59402020)
	e = goldenWord(e, "ldapur w0, [x1, #255]", 0x994FF020)
	e = goldenWord(e, "ldapur x0, [x1, #-256]", 0xD9500020)
	e = goldenWord(e, "ldapursb w0, [x1]", 0x19C00020)
	e = goldenWord(e, "ldapursb x0, [x1, #3]", 0x19803020)
	e = goldenWord(e, "ldapursh w0, [x1]", 0x59C00020)
	e = goldenWord(e, "ldapursh x0, [x1]", 0x59800020)
	e = goldenWord(e, "ldapursw x0, [x1, #4]", 0x99804020)
	e = goldenWord(e, "stlurb w0, [x1, #-1]", 0x191FF020)
	e = goldenWord(e, "stlurh w0, [x1]", 0x59000020)
	e = goldenWord(e, "stlur w0, [x1]", 0x99000020)
	e = goldenWord(e, "stlur x0, [sp, #8]", 0xD90083E0)
	e = goldenWord(e, "ldxr xzr, [x1]", 0xC85F7C3F)
	e = goldenWord(e, "stxr wzr, x0, [x1]", 0xC81F7C20)
	e = goldenWord(e, "ldapur b0, [x1]", 0x1D400820)
	e = goldenWord(e, "ldapur h1, [x2, #-2]", 0x5D5FE841)
	e = goldenWord(e, "ldapur s2, [sp, #4]", 0x9D404BE2)
	e = goldenWord(e, "ldapur d3, [x4, #255]", 0xDD4FF883)
	e = goldenWord(e, "ldapur q4, [x5, #-256]", 0x1DD008A4)
	e = goldenWord(e, "stlur b0, [x1, #1]", 0x1D001820)
	e = goldenWord(e, "stlur h1, [x2]", 0x5D000841)
	e = goldenWord(e, "stlur s2, [x3, #-4]", 0x9D1FC862)
	e = goldenWord(e, "stlur d3, [sp]", 0xDD000BE3)
	e = goldenWord(e, "stlur q31, [x30, #16]", 0x1D810BDF)
	return e
}

// Register combinations clang accepts whose status register or data registers
// coincide without being CONSTRAINED UNPREDICTABLE, and an explicit #0.
func TestGoldenOrderedEdges() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "stxr w1, x0, [sp]", 0xC8017FE0)
	e = goldenWord(e, "stxp w2, x0, x0, [x3]", 0xC8220060)
	e = goldenWord(e, "ldaxr x1, [x1]", 0xC85FFC21)
	e = goldenWord(e, "ldxp x0, x1, [x1]", 0xC87F0420)
	e = goldenWord(e, "stlr x1, [x1]", 0xC89FFC21)
	e = goldenWord(e, "stlr x0, [x1, #0]", 0xC89FFC20)
	e = goldenWord(e, "ldapr x0, [x1, #0]", 0xF8BFC020)
	e = goldenWord(e, "LDAXR X0, [X1]", 0xC85FFC20)
	return e
}

// Rejected as clang rejects them: a status register that is also a data or base
// register (other than SP), an offset other than #0 (or outside LDAPUR / STLUR's
// signed 9 bits), a register of the wrong size or kind, and any writeback or
// register-offset address.
func TestGoldenOrderedRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "stxr w0, x0, [x1]")
	e = goldenReject(e, "stxr w1, x0, [x1]")
	e = goldenReject(e, "stxr wzr, xzr, [x1]")
	e = goldenReject(e, "stxrb w0, w0, [x1]")
	e = goldenReject(e, "stlxr w1, w0, [x1]")
	e = goldenReject(e, "stxp w0, x0, x1, [x2]")
	e = goldenReject(e, "stxp w1, x0, x1, [x2]")
	e = goldenReject(e, "stxp w2, x0, x1, [x2]")
	e = goldenReject(e, "ldxr x0, [x1, #8]")
	e = goldenReject(e, "ldar x0, [x1, #8]")
	e = goldenReject(e, "ldapr x0, [x1, #8]")
	e = goldenReject(e, "stxr x2, x0, [x1]")
	e = goldenReject(e, "ldxrb x0, [x1]")
	e = goldenReject(e, "ldxp w0, x1, [x2]")
	e = goldenReject(e, "ldapur x0, [x1, #256]")
	e = goldenReject(e, "stlxr w2, x0, [xzr]")
	e = goldenReject(e, "ldapurb x0, [x1]")
	e = goldenReject(e, "ldapursw w0, [x1]")
	e = goldenReject(e, "stlur x0, [x1, #8]!")
	e = goldenReject(e, "ldxr x0, [x1], #0")
	e = goldenReject(e, "ldxr x0, [x1, x2]")
	e = goldenReject(e, "ldapur x0, [x1, x2]")
	e = goldenReject(e, "ldar sp, [x1]")
	e = goldenReject(e, "ldar d0, [x1]")
	e = goldenReject(e, "stxr w2, x0")
	e = goldenReject(e, "ldxr x0, [x1] x2")
	return e
}
