package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD floating-point conversions of the two-register miscellaneous
// class: FCVT{N,M,A,P,Z}{S,U} / SCVTF / UCVTF between floating-point and integer elements
// of one size, on a vector (`Vd.<T>, Vn.<T>`, <T> 4h / 8h, 2s / 4s or 2d) or an H / S / D
// scalar (`Sd, Sn` — a different-size scalar pair, or a general-purpose integer, is the
// floating-point / integer conversion parser's); FCVTN / FCVTN2 and FCVTXN / FCVTXN2
// (`Vd.4h|8h, Vn.4s` or `Vd.2s|4s, Vn.2d`; FCVTXN from 2d only, and as a scalar `Sd, Dn`),
// BFCVTN / BFCVTN2 (`Vd.4h|8h, Vn.4s`) and FCVTL / FCVTL2 (`Vd.4s, Vn.4h|8h` or `Vd.2d,
// Vn.2s|4s`); and the FP8 lengthenings F1CVTL / F2CVTL / BF1CVTL / BF2CVTL (`Vd.8h,
// Vn.8b`, the "2" forms `Vd.8h, Vn.16b`).  The fixed-point forms (`fcvtzs v0.4s, v1.4s,
// #3`, `fcvtzs s0, s1, #3`) belong to the shift-by-immediate class; this parser rejects
// them.

// simd2FCvtOf returns the simd.F2_* conversion of a same-size mnemonic, or -1.
func simd2FCvtOf(m *[]readonly char) int {
	if mnemIs(m, "fcvtns") { return simd.F2_FCVTNS }
	if mnemIs(m, "fcvtms") { return simd.F2_FCVTMS }
	if mnemIs(m, "fcvtas") { return simd.F2_FCVTAS }
	if mnemIs(m, "scvtf") { return simd.F2_SCVTF }
	if mnemIs(m, "fcvtps") { return simd.F2_FCVTPS }
	if mnemIs(m, "fcvtzs") { return simd.F2_FCVTZS }
	if mnemIs(m, "fcvtnu") { return simd.F2_FCVTNU }
	if mnemIs(m, "fcvtmu") { return simd.F2_FCVTMU }
	if mnemIs(m, "fcvtau") { return simd.F2_FCVTAU }
	if mnemIs(m, "ucvtf") { return simd.F2_UCVTF }
	if mnemIs(m, "fcvtpu") { return simd.F2_FCVTPU }
	if mnemIs(m, "fcvtzu") { return simd.F2_FCVTZU }
	return -1
}

// simd2ResizeOf returns the simd.F2_* size-changing conversion of a mnemonic and whether
// it is the "2" form, or -1.
func simd2ResizeOf(m *[]readonly char) (int, bool) {
	if mnemIs(m, "fcvtn") { return simd.F2_FCVTN, false }
	if mnemIs(m, "fcvtn2") { return simd.F2_FCVTN, true }
	if mnemIs(m, "fcvtxn") { return simd.F2_FCVTXN, false }
	if mnemIs(m, "fcvtxn2") { return simd.F2_FCVTXN, true }
	if mnemIs(m, "bfcvtn") { return simd.F2_BFCVTN, false }
	if mnemIs(m, "bfcvtn2") { return simd.F2_BFCVTN, true }
	if mnemIs(m, "fcvtl") { return simd.F2_FCVTL, false }
	if mnemIs(m, "fcvtl2") { return simd.F2_FCVTL, true }
	return -1, false
}

// simdFP8CvtlOf returns the simd.FP8CVTL_* lengthening of a mnemonic and whether it is
// the "2" form, or -1.
func simdFP8CvtlOf(m *[]readonly char) (int, bool) {
	var q bool = len(m) > 1 && m[len(m) - 1] == '2'
	var base *[]readonly char = m
	if q { base = m[0:len(m) - 1] }
	if mnemIs(base, "f1cvtl") { return simd.FP8CVTL_F1, q }
	if mnemIs(base, "f2cvtl") { return simd.FP8CVTL_F2, q }
	if mnemIs(base, "bf1cvtl") { return simd.FP8CVTL_BF1, q }
	if mnemIs(base, "bf2cvtl") { return simd.FP8CVTL_BF2, q }
	return -1, false
}

// emitA64SimdResize parses and emits a size-changing conversion that no other parser
// claims (FCVTL / FCVTXN / BFCVTN and their "2" forms; l positioned just after the
// mnemonic); returns false for any other mnemonic.
func emitA64SimdResize(p @Parser, l Lexer, mnem *[]readonly char) bool {
	op, _ := simd2ResizeOf(mnem)
	which, q := simdFP8CvtlOf(mnem)
	if (op < 0 || op == simd.F2_FCVTN) && which < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if which < 0 {
		emitA64SimdResizeItems(p, mnem, its)
		return true
	}
	if !dpExpectCount(p, its, 2) { return true }
	var nl int = 8
	if q { nl = 16 }
	if !vecArrIs(its.It[0], 1, 8) || !vecArrIs(its.It[1], 0, nl) {
		setErr(p, "an FP8 lengthening takes Vd.8h, Vn.8b (Vn.16b for the 2 form)")
		return true
	}
	simd.FP8Lengthen(p.Asm, which, q, its.It[0].Reg, its.It[1].Reg)
	return true
}

// emitA64SimdFCvtItems emits a same-size conversion from its scanned operands: two
// vectors of one H / S / D arrangement, or two H / S / D registers of one size.  Returns
// false (nothing done) when mnem is not one.
func emitA64SimdFCvtItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	var op int = simd2FCvtOf(mnem)
	if op < 0 { return false }
	if its.N == 3 && its.It[2].Kind == IT_IMM {
		setErr(p,
				"the fixed-point vector / same-size scalar conversions (shift by immediate) "
						"are not supported yet")
		return true
	}
	if !dpExpectCount(p, its, 2) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	if sameVecArr(d, n) && vecFPType(d.VEl) >= 0 {
		q, _ := vecArrQ(d.VEl, d.VLanes)
		simd.FPTwoRegMisc(p.Asm, op, q, vecFPType(d.VEl), d.Reg, n.Reg)
		return true
	}
	var ft int = -1
	if d.Kind == IT_REG { ft = fpTypeOf(d.Cls) }
	if ft < 0 || n.Kind != IT_REG || n.Cls != d.Cls {
		setErr(p,
				"expected two 4h / 8h / 2s / 4s / 2d vectors of one arrangement, "
						"or two H / S / D registers of one size")
		return true
	}
	simd.FPTwoRegMiscScalar(p.Asm, op, ft, d.Reg, n.Reg)
	return true
}

// emitA64SimdResizeItems emits FCVTN / FCVTXN / BFCVTN / FCVTL (or a "2" form) from its
// scanned operands; returns false (nothing done) when mnem is not one.
func emitA64SimdResizeItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, q := simd2ResizeOf(mnem)
	if op < 0 { return false }
	if !dpExpectCount(p, its, 2) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	if op == simd.F2_FCVTXN && !q && d.Kind == IT_REG && d.Cls == RC_S && n.Kind == IT_REG &&
			n.Cls == RC_D {
		simd.FCvtxnScalar(p.Asm, d.Reg, n.Reg)
		return true
	}
	// The wide operand is 4s or 2d; the narrow one has half its element size and 64
	// bits (128 for a "2" form).
	var wideIt a64Item = n
	var narrowIt a64Item = d
	if op == simd.F2_FCVTL {
		wideIt = d
		narrowIt = n
	}
	var wide int = -1
	if vecArrIs(wideIt, 2, 4) { wide = isa.FT_S }
	if vecArrIs(wideIt, 3, 2) { wide = isa.FT_D }
	var nl int = 4
	if wide == isa.FT_D { nl = 2 }
	if q { nl = nl * 2 }
	if wide < 0 || !vecArrIs(narrowIt, wideIt.VEl - 1, nl) {
		setErr(p,
				"expected a 4s or 2d vector and one of half its element size (the upper "
						"half for a 2 form)")
		return true
	}
	simd.FPNarrowWiden(p.Asm, op, q, wide, d.Reg, n.Reg)
	return true
}

// isSimdFCvtShape reports whether a conversion's operands are its Advanced SIMD form's: a
// vector destination, or two H / S / D registers of one size (and, for the fixed-point
// form, an immediate).
func isSimdFCvtShape(its a64Items) bool {
	if its.N == 0 { return false }
	if its.It[0].Kind == IT_VREG { return true }
	if its.N != 2 && (its.N != 3 || its.It[2].Kind != IT_IMM) { return false }
	return its.It[0].Kind == IT_REG && its.It[1].Kind == IT_REG && its.It[0].Cls == its.It[1].Cls &&
			fpTypeOf(its.It[0].Cls) >= 0
}
