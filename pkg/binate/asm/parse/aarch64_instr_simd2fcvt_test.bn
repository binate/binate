func TestGoldenSimdFP8Cvtl() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "f1cvtl v5.8h, v18.8b", 0x2E217A45)
	e = goldenWord(e, "f1cvtl2 v5.8h, v18.16b", 0x6E217A45)
	e = goldenWord(e, "f2cvtl v5.8h, v18.8b", 0x2E617A45)
	e = goldenWord(e, "f2cvtl2 v5.8h, v18.16b", 0x6E617A45)
	e = goldenWord(e, "bf1cvtl v5.8h, v18.8b", 0x2EA17A45)
	e = goldenWord(e, "bf1cvtl2 v5.8h, v18.16b", 0x6EA17A45)
	e = goldenWord(e, "bf2cvtl v5.8h, v18.8b", 0x2EE17A45)
	e = goldenWord(e, "bf2cvtl2 v5.8h, v18.16b", 0x6EE17A45)
	e = goldenWord(e, "F1CVTL V31.8H, V0.8B", 0x2E21781F)
	e = goldenWord(e, "bf2cvtl2 v0.8h, v31.16b", 0x6EE17BE0)
	return e
}
