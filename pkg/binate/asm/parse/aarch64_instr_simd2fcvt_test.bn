package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the floating-point conversions: FCVT{N,M,A,P,Z}{S,U} / SCVTF / UCVTF on
// vectors and on same-size scalars (beside the FEAT_FPRCVT different-size scalars and the
// general-purpose forms, which other parsers handle), FCVTN / FCVTXN / BFCVTN / FCVTL and
// their "2" forms, the scalar FCVTXN, and the FP8 lengthenings F1CVTL / F2CVTL / BF1CVTL /
// BF2CVTL, from clang (`clang -c -target aarch64-linux-gnu -march=armv9.6-a+fprcvt+fp16`,
// with `+fp8` for the FP8 forms).

func TestGoldenSimd2FCvt1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fcvtns v5.4h, v18.4h", 0x0E79AA45)
	e = goldenWord(e, "fcvtns v5.8h, v18.8h", 0x4E79AA45)
	e = goldenWord(e, "fcvtns v5.2s, v18.2s", 0x0E21AA45)
	e = goldenWord(e, "fcvtns v5.4s, v18.4s", 0x4E21AA45)
	e = goldenWord(e, "fcvtns v5.2d, v18.2d", 0x4E61AA45)
	e = goldenWord(e, "fcvtns h5, h18", 0x5E79AA45)
	e = goldenWord(e, "fcvtns s5, h18", 0x1EEA0245)
	e = goldenWord(e, "fcvtns s5, s18", 0x5E21AA45)
	e = goldenWord(e, "fcvtns s5, d18", 0x1E6A0245)
	e = goldenWord(e, "fcvtns d5, h18", 0x9EEA0245)
	e = goldenWord(e, "fcvtns d5, s18", 0x9E2A0245)
	e = goldenWord(e, "fcvtns d5, d18", 0x5E61AA45)
	e = goldenWord(e, "fcvtnu v5.4h, v18.4h", 0x2E79AA45)
	e = goldenWord(e, "fcvtnu v5.8h, v18.8h", 0x6E79AA45)
	e = goldenWord(e, "fcvtnu v5.2s, v18.2s", 0x2E21AA45)
	e = goldenWord(e, "fcvtnu v5.4s, v18.4s", 0x6E21AA45)
	e = goldenWord(e, "fcvtnu v5.2d, v18.2d", 0x6E61AA45)
	e = goldenWord(e, "fcvtnu h5, h18", 0x7E79AA45)
	e = goldenWord(e, "fcvtnu s5, h18", 0x1EEB0245)
	e = goldenWord(e, "fcvtnu s5, s18", 0x7E21AA45)
	e = goldenWord(e, "fcvtnu s5, d18", 0x1E6B0245)
	e = goldenWord(e, "fcvtnu d5, h18", 0x9EEB0245)
	e = goldenWord(e, "fcvtnu d5, s18", 0x9E2B0245)
	e = goldenWord(e, "fcvtnu d5, d18", 0x7E61AA45)
	e = goldenWord(e, "fcvtps v5.4h, v18.4h", 0x0EF9AA45)
	e = goldenWord(e, "fcvtps v5.8h, v18.8h", 0x4EF9AA45)
	e = goldenWord(e, "fcvtps v5.2s, v18.2s", 0x0EA1AA45)
	e = goldenWord(e, "fcvtps v5.4s, v18.4s", 0x4EA1AA45)
	e = goldenWord(e, "fcvtps v5.2d, v18.2d", 0x4EE1AA45)
	e = goldenWord(e, "fcvtps h5, h18", 0x5EF9AA45)
	e = goldenWord(e, "fcvtps s5, h18", 0x1EF20245)
	e = goldenWord(e, "fcvtps s5, s18", 0x5EA1AA45)
	e = goldenWord(e, "fcvtps s5, d18", 0x1E720245)
	e = goldenWord(e, "fcvtps d5, h18", 0x9EF20245)
	e = goldenWord(e, "fcvtps d5, s18", 0x9E320245)
	e = goldenWord(e, "fcvtps d5, d18", 0x5EE1AA45)
	e = goldenWord(e, "fcvtpu v5.4h, v18.4h", 0x2EF9AA45)
	e = goldenWord(e, "fcvtpu v5.8h, v18.8h", 0x6EF9AA45)
	e = goldenWord(e, "fcvtpu v5.2s, v18.2s", 0x2EA1AA45)
	e = goldenWord(e, "fcvtpu v5.4s, v18.4s", 0x6EA1AA45)
	e = goldenWord(e, "fcvtpu v5.2d, v18.2d", 0x6EE1AA45)
	e = goldenWord(e, "fcvtpu h5, h18", 0x7EF9AA45)
	e = goldenWord(e, "fcvtpu s5, h18", 0x1EF30245)
	e = goldenWord(e, "fcvtpu s5, s18", 0x7EA1AA45)
	e = goldenWord(e, "fcvtpu s5, d18", 0x1E730245)
	e = goldenWord(e, "fcvtpu d5, h18", 0x9EF30245)
	e = goldenWord(e, "fcvtpu d5, s18", 0x9E330245)
	e = goldenWord(e, "fcvtpu d5, d18", 0x7EE1AA45)
	e = goldenWord(e, "fcvtms v5.4h, v18.4h", 0x0E79BA45)
	e = goldenWord(e, "fcvtms v5.8h, v18.8h", 0x4E79BA45)
	return e
}

