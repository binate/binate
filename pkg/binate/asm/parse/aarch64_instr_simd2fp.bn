package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD floating-point two-register miscellaneous instructions that do
// not convert: FABS / FNEG / FSQRT and the FRINT* roundings on a vector (`Vd.<T>, Vn.<T>`,
// <T> 4h / 8h, 2s / 4s or 2d; no 4h / 8h for FRINT32* / FRINT64*); FRECPE / FRSQRTE on a
// vector or H / S / D scalar, FRECPX on a scalar; the integer URECPE / URSQRTE on 2s /
// 4s; and the compares against zero FCMGT / FCMEQ / FCMLT / FCMGE / FCMLE `Vd.<T>, Vn.<T>,
// #0.0` (or a scalar), the zero written `#0.0`, `0.0`, `#0` or `0`.  The scalar FABS /
// FNEG / FSQRT / FRINT* are the floating-point data-processing instructions (whose
// parser hands the vector forms here), and the compare mnemonics also name the register
// compares (whose parser hands the zero forms here).

// simd2FPOf returns the simd.F2_* operation of a mnemonic, or -1.
func simd2FPOf(m *[]readonly char) int {
	if mnemIs(m, "fabs") { return simd.F2_FABS }
	if mnemIs(m, "fneg") { return simd.F2_FNEG }
	if mnemIs(m, "fsqrt") { return simd.F2_FSQRT }
	if mnemIs(m, "frintn") { return simd.F2_FRINTN }
	if mnemIs(m, "frintm") { return simd.F2_FRINTM }
	if mnemIs(m, "frintp") { return simd.F2_FRINTP }
	if mnemIs(m, "frintz") { return simd.F2_FRINTZ }
	if mnemIs(m, "frinta") { return simd.F2_FRINTA }
	if mnemIs(m, "frintx") { return simd.F2_FRINTX }
	if mnemIs(m, "frinti") { return simd.F2_FRINTI }
	if mnemIs(m, "frint32z") { return simd.F2_FRINT32Z }
	if mnemIs(m, "frint32x") { return simd.F2_FRINT32X }
	if mnemIs(m, "frint64z") { return simd.F2_FRINT64Z }
	if mnemIs(m, "frint64x") { return simd.F2_FRINT64X }
	if mnemIs(m, "frecpe") { return simd.F2_FRECPE }
	if mnemIs(m, "frsqrte") { return simd.F2_FRSQRTE }
	if mnemIs(m, "frecpx") { return simd.F2_FRECPX }
	if mnemIs(m, "urecpe") { return simd.F2_URECPE }
	if mnemIs(m, "ursqrte") { return simd.F2_URSQRTE }
	if mnemIs(m, "fcmgt") { return simd.F2_FCMGT0 }
	if mnemIs(m, "fcmeq") { return simd.F2_FCMEQ0 }
	if mnemIs(m, "fcmlt") { return simd.F2_FCMLT0 }
	if mnemIs(m, "fcmge") { return simd.F2_FCMGE0 }
	if mnemIs(m, "fcmle") { return simd.F2_FCMLE0 }
	return -1
}

// f2CompareOp reports whether op is a floating-point compare against zero.
func f2CompareOp(op int) bool {
	return op == simd.F2_FCMGT0 || op == simd.F2_FCMEQ0 || op == simd.F2_FCMLT0 ||
			op == simd.F2_FCMGE0 || op == simd.F2_FCMLE0
}

// emitA64SimdFP2 parses and emits one of this file's instructions that no other parser
// claims (FRECPE, FRSQRTE, FRECPX, URECPE, URSQRTE; l positioned just after the
// mnemonic); returns false for any other mnemonic.
func emitA64SimdFP2(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !mnemIs(mnem, "frecpe") && !mnemIs(mnem, "frsqrte") && !mnemIs(mnem, "frecpx") &&
			!mnemIs(mnem, "urecpe") && !mnemIs(mnem, "ursqrte") {
		return false
	}
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	emitA64SimdFP2Items(p, mnem, its)
	return true
}

// fpZeroOk reports whether item it is the zero of a floating-point compare: `#0.0`
// (any spelling of the floating-point zero, not negative) or the integer 0.
func fpZeroOk(it a64Item) bool {
	if it.Kind == IT_IMM { return it.Imm == 0 }
	return it.Kind == IT_FLOAT && floatLitIsZero(it.FText)
}

// emitA64SimdFP2Items emits one of this file's instructions from its scanned operands;
// returns false (nothing done) when mnem is not one.
func emitA64SimdFP2Items(p @Parser, mnem *[]readonly char, its a64Items) bool {
	var op int = simd2FPOf(mnem)
	if op < 0 { return false }
	var want int = 2
	if f2CompareOp(op) { want = 3 }
	if !dpExpectCount(p, its, want) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	if f2CompareOp(op) && !fpZeroOk(its.It[2]) {
		setErr(p, "a compare against zero takes #0.0")
		return true
	}
	if sameVecArr(d, n) && vecFPType(d.VEl) >= 0 {
		q, _ := vecArrQ(d.VEl, d.VLanes)
		simd.FPTwoRegMisc(p.Asm, op, q, vecFPType(d.VEl), d.Reg, n.Reg)
		return true
	}
	var ft int = -1
	if d.Kind == IT_REG { ft = fpTypeOf(d.Cls) }
	if ft < 0 || n.Kind != IT_REG || n.Cls != d.Cls {
		setErr(p,
				"expected two 4h / 8h / 2s / 4s / 2d vectors of one arrangement, "
						"or two H / S / D registers")
		return true
	}
	simd.FPTwoRegMiscScalar(p.Asm, op, ft, d.Reg, n.Reg)
	return true
}
