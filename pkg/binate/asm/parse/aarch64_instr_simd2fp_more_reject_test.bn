package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Floating-point two-register miscellaneous lines clang rejects: the arrangements and
// scalar sizes each operation does not take (B vectors, 1D, H for FRINT32* / FRINT64*,
// all but 2S / 4S for URECPE / URSQRTE, vectors for FRECPX), a zero other than `#0.0` /
// `#0` for a compare, float literals in integer operands, and mixed or missing
// operands.

