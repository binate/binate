// The compare against zero's operand on a valid arrangement: a nonzero integer or float,
// and `#-0.0`; and `#0.0` for compares that have no zero form.
func TestGoldenSimd2FPZeroReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #1")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, 1")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #(1)")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #0.5")
	e = goldenReject(e, "fcmeq v0.4s, v1.4s, #-0.0")
	e = goldenReject(e, "fcmge s0, s1, #1")
	e = goldenReject(e, "fcmgt d0, d1, #0.5")
	e = goldenReject(e, "fcmlt h0, h1, #-0.0")
	e = goldenReject(e, "facge v0.4s, v1.4s, #0.0")
	e = goldenReject(e, "cmeq v0.4s, v1.4s, #0.0")
	return e
}
