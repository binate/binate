package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the non-converting floating-point two-register miscellaneous
// instructions — FABS / FNEG / FSQRT, the FRINT* roundings, FRECPE / FRSQRTE / FRECPX,
// URECPE / URSQRTE, the compares against zero with each spelling of the zero, and the
// scalar FP data-processing forms beside them — from clang (`clang -c -target
// aarch64-linux-gnu -march=armv8.6-a+fp16`).

func TestGoldenSimd2FP1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fabs v5.4h, v18.4h", 0x0EF8FA45)
	e = goldenWord(e, "fabs v5.8h, v18.8h", 0x4EF8FA45)
	e = goldenWord(e, "fabs v5.2s, v18.2s", 0x0EA0FA45)
