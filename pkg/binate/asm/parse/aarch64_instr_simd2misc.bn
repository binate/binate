package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD integer two-register miscellaneous instructions: the unary
// `Vd.<T>, Vn.<T>` (REV16 / REV32 / REV64, SUQADD / USQADD, CLS / CLZ / CNT, NOT / MVN /
// RBIT, SQABS / SQNEG / ABS / NEG) and, where defined, their scalar `<V>d, <V>n`; the
// pairwise add-long SADDLP / UADDLP / SADALP / UADALP (`Vd` of twice the element size and
// half the lanes); the narrowing XTN / SQXTN / UQXTN / SQXTUN and their "2" forms (and
// scalar `<V>d, <V2>n` for the saturating three); the compares against zero CMGT / CMEQ /
// CMLT / CMGE / CMLE `Vd.<T>, Vn.<T>, #0`; and SHLL / SHLL2 `Vd.<Ta>, Vn.<Tb>, #shift`
// with the shift equal to the source element width.  The zero and the shift are
// expressions, with or without `#`.  NEG, MVN, REV16 / REV32 / REV64, RBIT, CLS and CLZ
// are also integer instructions (the data-processing parser hands them here when the
// destination is a SIMD&FP register), and the compare mnemonics also name the register
// compares (the three-same parser hands the `#0` forms here).

// simd2MiscBase returns the simd.M2_* operation of a mnemonic without a "2", or -1.
func simd2MiscBase(m *[]readonly char) int {
	if mnemIs(m, "rev64") { return simd.M2_REV64 }
	if mnemIs(m, "rev16") { return simd.M2_REV16 }
	if mnemIs(m, "rev32") { return simd.M2_REV32 }
	if mnemIs(m, "saddlp") { return simd.M2_SADDLP }
	if mnemIs(m, "uaddlp") { return simd.M2_UADDLP }
	if mnemIs(m, "sadalp") { return simd.M2_SADALP }
	if mnemIs(m, "uadalp") { return simd.M2_UADALP }
	if mnemIs(m, "suqadd") { return simd.M2_SUQADD }
	if mnemIs(m, "usqadd") { return simd.M2_USQADD }
	if mnemIs(m, "cls") { return simd.M2_CLS }
	if mnemIs(m, "clz") { return simd.M2_CLZ }
	if mnemIs(m, "cnt") { return simd.M2_CNT }
	if mnemIs(m, "not") || mnemIs(m, "mvn") { return simd.M2_NOT }
	if mnemIs(m, "rbit") { return simd.M2_RBIT }
	if mnemIs(m, "sqabs") { return simd.M2_SQABS }
	if mnemIs(m, "sqneg") { return simd.M2_SQNEG }
	if mnemIs(m, "abs") { return simd.M2_ABS }
	if mnemIs(m, "neg") { return simd.M2_NEG }
	if mnemIs(m, "cmgt") { return simd.M2_CMGT0 }
	if mnemIs(m, "cmeq") { return simd.M2_CMEQ0 }
	if mnemIs(m, "cmlt") { return simd.M2_CMLT0 }
	if mnemIs(m, "cmge") { return simd.M2_CMGE0 }
	if mnemIs(m, "cmle") { return simd.M2_CMLE0 }
	if mnemIs(m, "xtn") { return simd.M2_XTN }
	if mnemIs(m, "sqxtn") { return simd.M2_SQXTN }
	if mnemIs(m, "uqxtn") { return simd.M2_UQXTN }
	if mnemIs(m, "sqxtun") { return simd.M2_SQXTUN }
	if mnemIs(m, "shll") { return simd.M2_SHLL }
	return -1
}

// m2Narrowing reports whether op is one of the narrowing XTN family.
func m2Narrowing(op int) bool {
	return op == simd.M2_XTN || op == simd.M2_SQXTN || op == simd.M2_UQXTN || op == simd.M2_SQXTUN
}

// m2Compare reports whether op is a compare against zero.
func m2Compare(op int) bool {
	return op == simd.M2_CMGT0 || op == simd.M2_CMEQ0 || op == simd.M2_CMLT0 || op == simd.M2_CMGE0 ||
			op == simd.M2_CMLE0
}

// simd2MiscOf returns the simd.M2_* operation of a mnemonic and whether it is a "2" form
// (only the narrowing operations and SHLL have one), or -1.
func simd2MiscOf(m *[]readonly char) (int, bool) {
	var op int = simd2MiscBase(m)
	if op >= 0 { return op, false }
	if len(m) > 1 && m[len(m) - 1] == '2' {
		op = simd2MiscBase(m[0:len(m) - 1])
		if m2Narrowing(op) || op == simd.M2_SHLL { return op, true }
	}
	return -1, false
}

// emitA64Simd2Misc parses and emits a two-register miscellaneous instruction that exists
// only for SIMD&FP registers (l positioned just after the mnemonic); returns false for
// any other mnemonic.
func emitA64Simd2Misc(p @Parser, l Lexer, mnem *[]readonly char) bool {
	op, _ := simd2MiscOf(mnem)
	if op < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	emitA64Simd2MiscItems(p, mnem, its)
	return true
}

// emitA64Simd2MiscItems emits a two-register miscellaneous instruction from its scanned
// operands; returns false (nothing done) when mnem is not one.
func emitA64Simd2MiscItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, q2 := simd2MiscOf(mnem)
	if op < 0 { return false }
	var want int = 2
	if m2Compare(op) || op == simd.M2_SHLL { want = 3 }
	if !dpExpectCount(p, its, want) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	if d.Kind == IT_REG {
		emitA64Simd2MiscScalar(p, op, q2, its)
		return true
	}
	if n.Kind != IT_VREG || n.VEl > 3 || n.Lane >= 0 {
		setErr(p, "expected vector operands")
		return true
	}
	if m2Narrowing(op) || op == simd.M2_SHLL {
		emitA64Simd2MiscResize(p, op, q2, its)
		return true
	}
	if op == simd.M2_SADDLP || op == simd.M2_UADDLP || op == simd.M2_SADALP || op == simd.M2_UADALP {
		q, okN := vecArrQ(n.VEl, n.VLanes)
		if !okN || !vecArrIs(d, n.VEl + 1, n.VLanes / 2) {
			setErr(p, "a pairwise add-long takes Vd of twice the element size and half the lanes")
			return true
		}
		simd.TwoRegMisc(p.Asm, op, q, n.VEl, d.Reg, n.Reg)
		return true
	}
	if !sameVecArr(d, n) || (m2Compare(op) && !m2ZeroOk(its.It[2])) {
		setErr(p, "expected two vectors of one arrangement (and #0 for a compare)")
		return true
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	simd.TwoRegMisc(p.Asm, op, q, d.VEl, d.Reg, n.Reg)
	return true
}

// m2ZeroOk reports whether item it is the immediate zero of a compare against zero.
func m2ZeroOk(it a64Item) bool {
	return it.Kind == IT_IMM && it.Imm == 0
}

// emitA64Simd2MiscResize emits a narrowing operation (`Vd.<Tb>, Vn.<Ta>`) or SHLL
// (`Vd.<Ta>, Vn.<Tb>, #shift`), q2 selecting the "2" form: Tb fills 64 bits, or 128 for
// a "2" form, and Ta has twice its element size and fills 128.
func emitA64Simd2MiscResize(p @Parser, op int, q2 bool, its a64Items) {
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var tb a64Item = d
	if op == simd.M2_SHLL { tb = n }
	var el int = tb.VEl
	var nl int = 8 >> el
	if q2 { nl = 16 >> el }
	var wl int = 16 >> (el + 1)
	if op == simd.M2_SHLL {
		var sh a64Item = its.It[2]
		if !vecArrIs(n, el, nl) || !vecArrIs(d, el + 1, wl) || sh.Kind != IT_IMM ||
				sh.Imm != cast(int64, 8 << el) {
			setErr(p, "shll takes Vd.8h|4s|2d, Vn.8b|4h|2s (16b|8h|4s for shll2), #8|#16|#32")
			return
		}
	} else if tb.Kind != IT_VREG || tb.VEl > 2 || !vecArrIs(d, el, nl) || !vecArrIs(n, el + 1, wl) {
		setErr(p, "a narrowing takes Vd.8b|4h|2s (16b|8h|4s for the 2 form), Vn.8h|4s|2d")
		return
	}
	simd.TwoRegMisc(p.Asm, op, q2, el, d.Reg, n.Reg)
}

// emitA64Simd2MiscScalar emits the scalar form of a two-register miscellaneous operation:
// `<V>d, <V>n` of one size, `<V>d, <V2>n` for the narrowing ones (V2 of twice V's size),
// or `Dd, Dn, #0` for a compare against zero.
func emitA64Simd2MiscScalar(p @Parser, op int, q2 bool, its a64Items) {
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var size int = scalarSize(d.Cls)
	var nsize int = -1
	if n.Kind == IT_REG { nsize = scalarSize(n.Cls) }
	var shapeOk bool = size >= 0 && nsize >= 0 && !q2
	if m2Narrowing(op) {
		shapeOk = shapeOk && nsize == size + 1
	} else {
		shapeOk = shapeOk && nsize == size && (!m2Compare(op) || m2ZeroOk(its.It[2]))
	}
	if !shapeOk || op == simd.M2_SHLL {
		setErr(p, "expected scalar registers of the sizes this operation takes")
		return
	}
	simd.TwoRegMiscScalar(p.Asm, op, size, d.Reg, n.Reg)
}
