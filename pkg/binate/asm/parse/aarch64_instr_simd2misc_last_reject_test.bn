// Arrangements and scalar sizes outside each operation's set, a general-purpose
// destination (these mnemonics' general-purpose forms, MVN / ABS / CNT, are other
// instructions), compares that have no zero form, a nonzero compare immediate, and the
// D-element pairwise and SHLL shapes.
func TestGoldenSimd2MiscOutOfSetReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "rev64 v0.2d, v1.2d")
	e = goldenReject(e, "rev32 v0.4s, v1.4s")
	e = goldenReject(e, "rev16 v0.4h, v1.4h")
	e = goldenReject(e, "cnt v0.4h, v1.4h")
	e = goldenReject(e, "cls v0.2d, v1.2d")
	e = goldenReject(e, "not v0.4h, v1.4h")
	e = goldenReject(e, "mvn v0.2s, v1.2s")
	e = goldenReject(e, "rbit v0.4h, v1.4h")
	e = goldenReject(e, "abs v0.1d, v1.1d")
	e = goldenReject(e, "sqabs v0.1d, v1.1d")
	e = goldenReject(e, "cmeq v0.1d, v1.1d, #0")
	e = goldenReject(e, "abs s0, s1")
	e = goldenReject(e, "neg h0, h1")
	e = goldenReject(e, "cmeq s0, s1, #0")
	e = goldenReject(e, "xtn b0, h1")
	e = goldenReject(e, "cls d0, d1")
	e = goldenReject(e, "rev64 d0, d1")
	e = goldenReject(e, "not d0, d1")
	e = goldenReject(e, "saddlp h0, b1")
	e = goldenReject(e, "shll h0, b1, #8")
	e = goldenReject(e, "sqxtn2 b0, h1")
	e = goldenReject(e, "not x0, x1")
	e = goldenReject(e, "cmhi v0.4s, v1.4s, #0")
	e = goldenReject(e, "cmhs v0.4s, v1.4s, #0")
	e = goldenReject(e, "cmtst v0.4s, v1.4s, #0")
	e = goldenReject(e, "cmeq v0.4s, v1.4s, #1")
	e = goldenReject(e, "saddlp v0.1q, v1.2d")
	e = goldenReject(e, "shll v0.1q, v1.1d, #64")
	return e
}
