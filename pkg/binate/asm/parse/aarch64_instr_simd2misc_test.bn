package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the integer two-register miscellaneous instructions — every accepted
// form of each mnemonic at every arrangement and scalar size, the compares against zero,
// SHLL at each width, the zero and the shift written as expressions — from clang (`clang
// -c -target aarch64-linux-gnu -march=armv8.6-a`).

