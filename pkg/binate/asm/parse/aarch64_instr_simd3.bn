package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD integer three-same instructions: the vector form `Vd.<T>, Vn.<T>,
// Vm.<T>` and, where the architecture defines it, the scalar form `<V>d, <V>n, <V>m`;
// the bitwise AND / BIC / ORR / ORN / EOR / BSL / BIT / BIF on 8b / 16b; and the
// register-compare aliases CMLE / CMLT / CMLO / CMLS (CMGE / CMGT / CMHI / CMHS with Vn
// and Vm swapped).  ADD, SUB, MUL, AND, BIC, ORR, ORN and EOR are also integer
// instructions; the data-processing parser hands them here when the destination is a
// SIMD&FP register.  A compare against an immediate is the two-register compare
// against zero (aarch64_instr_simd2misc.bn).  The vector-immediate forms of ORR / BIC,
// the by-element forms of MUL / MLA / MLS / SQDMULH / SQRDMULH belong to another class,
// which this parser rejects; the scalar pairwise ADDP is aarch64_instr_simd_across.bn's.

// simd3IntOpA returns the simd.S3_* operation of a U=0 mnemonic (the signed forms and
// the first of each pair), or -1.
func simd3IntOpA(m *[]readonly char) int {
	if mnemIs(m, "shadd") { return simd.S3_SHADD }
	if mnemIs(m, "sqadd") { return simd.S3_SQADD }
	if mnemIs(m, "srhadd") { return simd.S3_SRHADD }
	if mnemIs(m, "shsub") { return simd.S3_SHSUB }
	if mnemIs(m, "sqsub") { return simd.S3_SQSUB }
	if mnemIs(m, "cmgt") { return simd.S3_CMGT }
	if mnemIs(m, "cmge") { return simd.S3_CMGE }
	if mnemIs(m, "sshl") { return simd.S3_SSHL }
	if mnemIs(m, "sqshl") { return simd.S3_SQSHL }
	if mnemIs(m, "srshl") { return simd.S3_SRSHL }
	if mnemIs(m, "sqrshl") { return simd.S3_SQRSHL }
	if mnemIs(m, "smax") { return simd.S3_SMAX }
	if mnemIs(m, "smin") { return simd.S3_SMIN }
	if mnemIs(m, "sabd") { return simd.S3_SABD }
	if mnemIs(m, "saba") { return simd.S3_SABA }
	if mnemIs(m, "add") { return simd.S3_ADD }
	if mnemIs(m, "cmtst") { return simd.S3_CMTST }
	if mnemIs(m, "mla") { return simd.S3_MLA }
	if mnemIs(m, "mul") { return simd.S3_MUL }
	if mnemIs(m, "smaxp") { return simd.S3_SMAXP }
	if mnemIs(m, "sminp") { return simd.S3_SMINP }
	if mnemIs(m, "sqdmulh") { return simd.S3_SQDMULH }
	if mnemIs(m, "addp") { return simd.S3_ADDP }
	return -1
}

// simd3IntOpB returns the simd.S3_* operation of an unsigned / U=1 mnemonic, or -1.
func simd3IntOpB(m *[]readonly char) int {
	if mnemIs(m, "uhadd") { return simd.S3_UHADD }
	if mnemIs(m, "uqadd") { return simd.S3_UQADD }
	if mnemIs(m, "urhadd") { return simd.S3_URHADD }
	if mnemIs(m, "uhsub") { return simd.S3_UHSUB }
	if mnemIs(m, "uqsub") { return simd.S3_UQSUB }
	if mnemIs(m, "cmhi") { return simd.S3_CMHI }
	if mnemIs(m, "cmhs") { return simd.S3_CMHS }
	if mnemIs(m, "ushl") { return simd.S3_USHL }
	if mnemIs(m, "uqshl") { return simd.S3_UQSHL }
	if mnemIs(m, "urshl") { return simd.S3_URSHL }
	if mnemIs(m, "uqrshl") { return simd.S3_UQRSHL }
	if mnemIs(m, "umax") { return simd.S3_UMAX }
	if mnemIs(m, "umin") { return simd.S3_UMIN }
	if mnemIs(m, "uabd") { return simd.S3_UABD }
	if mnemIs(m, "uaba") { return simd.S3_UABA }
	if mnemIs(m, "sub") { return simd.S3_SUB }
	if mnemIs(m, "cmeq") { return simd.S3_CMEQ }
	if mnemIs(m, "mls") { return simd.S3_MLS }
	if mnemIs(m, "pmul") { return simd.S3_PMUL }
	if mnemIs(m, "umaxp") { return simd.S3_UMAXP }
	if mnemIs(m, "uminp") { return simd.S3_UMINP }
	if mnemIs(m, "sqrdmulh") { return simd.S3_SQRDMULH }
	return -1
}

// simd3IntOf returns the simd.S3_* operation of a mnemonic and whether its Vn / Vm are
// swapped (the CMLE / CMLT / CMLO / CMLS aliases), or -1.
func simd3IntOf(m *[]readonly char) (int, bool) {
	if mnemIs(m, "cmle") { return simd.S3_CMGE, true }
	if mnemIs(m, "cmlt") { return simd.S3_CMGT, true }
	if mnemIs(m, "cmlo") { return simd.S3_CMHI, true }
	if mnemIs(m, "cmls") { return simd.S3_CMHS, true }
	var op int = simd3IntOpA(m)
	if op < 0 { op = simd3IntOpB(m) }
	return op, false
}

// simdLogicalOf returns the simd.SL_* operation of a bitwise mnemonic, or -1.
func simdLogicalOf(m *[]readonly char) int {
	if mnemIs(m, "and") { return simd.SL_AND }
	if mnemIs(m, "bic") { return simd.SL_BIC }
	if mnemIs(m, "orr") { return simd.SL_ORR }
	if mnemIs(m, "orn") { return simd.SL_ORN }
	if mnemIs(m, "eor") { return simd.SL_EOR }
	if mnemIs(m, "bsl") { return simd.SL_BSL }
	if mnemIs(m, "bit") { return simd.SL_BIT }
	if mnemIs(m, "bif") { return simd.SL_BIF }
	return -1
}

// emitA64Simd3 parses and emits a three-same instruction that exists only for SIMD&FP
// registers (l positioned just after the mnemonic); returns false for any other mnemonic.
func emitA64Simd3(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var op int = -1
	op, _ = simd3IntOf(mnem)
	if op < 0 && simdLogicalOf(mnem) < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	emitA64Simd3Items(p, mnem, its)
	return true
}

// sameVecArr reports whether items a and b are whole vectors of one B / H / S / D
// arrangement.
func sameVecArr(a a64Item, b a64Item) bool {
	return isVecArr(a) && isVecArr(b) && a.VEl <= 3 && a.VEl == b.VEl && a.VLanes == b.VLanes
}

// emitA64Simd3Items emits a three-same instruction from its scanned operands; returns
// false (nothing done) when mnem is not a three-same mnemonic.
func emitA64Simd3Items(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, swap := simd3IntOf(mnem)
	var lg int = simdLogicalOf(mnem)
	if op < 0 && lg < 0 { return false }
	// A compare against an immediate is the two-register compare against zero, and a
	// two-operand ADDP the scalar pairwise reduction.
	if its.N == 3 && its.It[2].Kind == IT_IMM && emitA64Simd2MiscItems(p, mnem, its) {
		return true
	}
	if its.N == 2 && emitA64SimdPairwiseItems(p, mnem, its) { return true }
	// SQSHL / UQSHL with an immediate shift are the shift-by-immediate instructions.
	if its.N == 3 && its.It[2].Kind == IT_IMM && emitA64SimdShiftItems(p, mnem, its) { return true }
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	if swap {
		n = its.It[2]
		m = its.It[1]
	}
	if sameVecArr(d, n) && sameVecArr(d, m) {
		q, _ := vecArrQ(d.VEl, d.VLanes)
		if lg >= 0 {
			if d.VEl != 0 {
				setErr(p, "a bitwise operation takes 8b or 16b vectors")
				return true
			}
			simd.Logical(p.Asm, lg, q, d.Reg, n.Reg, m.Reg)
			return true
		}
		simd.IntThreeSame(p.Asm, op, q, d.VEl, d.Reg, n.Reg, m.Reg)
		return true
	}
	var size int = -1
	if d.Kind == IT_REG { size = scalarSize(d.Cls) }
	if op >= 0 && size >= 0 && n.Kind == IT_REG && m.Kind == IT_REG && n.Cls == d.Cls &&
			m.Cls == d.Cls {
		simd.IntThreeSameScalar(p.Asm, op, size, d.Reg, n.Reg, m.Reg)
		return true
	}
	setErr(p, "expected three vectors of one arrangement, or three scalar registers of one size")
	return true
}
