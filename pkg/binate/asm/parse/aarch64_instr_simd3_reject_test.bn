}

// Integer instructions sharing a three-same mnemonic, with a stray SIMD&FP operand, and
// vector registers written without an arrangement: rejected, as by clang.
func TestGoldenSimd3MixedRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "and w0, w1, s2")
	e = goldenReject(e, "mul x0, x1, d2")
	e = goldenReject(e, "orr x0, x1, d2, lsl #1")
	e = goldenReject(e, "eor x0, x1, d2")
	e = goldenReject(e, "bic w0, w1, s2")
	e = goldenReject(e, "orn x0, x1, d2")
	e = goldenReject(e, "add x0, x1, d2, lsl #3")
	e = goldenReject(e, "add v0, v1, v2")
	e = goldenReject(e, "add v0.4s, v1, v2.4s")
	e = goldenReject(e, "mov v0, v1")
	return e
}
