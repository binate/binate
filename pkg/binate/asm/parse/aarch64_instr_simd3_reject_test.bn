	e = goldenReject(e, "cmlt v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "cmlt b5, b18, b27")
	e = goldenReject(e, "cmlt h5, h18, h27")
	e = goldenReject(e, "cmlt s5, s18, s27")
	e = goldenReject(e, "cmlo v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "cmlo b5, b18, b27")
	e = goldenReject(e, "cmlo h5, h18, h27")
	return e
}

func TestGoldenSimd3Reject6() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "cmlo s5, s18, s27")
	e = goldenReject(e, "cmls v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "cmls b5, b18, b27")
