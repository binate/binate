	e = goldenReject(e, "add d0, d1, x2")
	e = goldenReject(e, "add d0, s1, d2")
	e = goldenReject(e, "add v0.1q, v1.1q, v2.1q")
	e = goldenReject(e, "add v0.4b, v1.4b, v2.4b")
	e = goldenReject(e, "add v0.4s, v1.4s, v2.s[1]")
	e = goldenReject(e, "and v0.16b, v1.16b, #1")
	e = goldenReject(e, "and v0.4s, v1.4s, v2.4s")
	e = goldenReject(e, "mov v0.4s, v1.2s")
	e = goldenReject(e, "mov v0.2s, v1.4s")
	e = goldenReject(e, "mov v0.1q, v1.1q")
	e = goldenReject(e, "mov v0.4b, v1.4b")
