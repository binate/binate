package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the Advanced SIMD integer three-same instructions (every operation at
// every arrangement and scalar size it has, the bitwise operations, the CMLE / CMLT / CMLO
// / CMLS aliases and the whole-vector MOV alias), from clang (`clang -c -target
// aarch64-linux-gnu -march=armv8.6-a`); the rest of the table is in
// aarch64_instr_simd3_more_test.bn.

