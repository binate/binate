package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD three-different instructions and their "2" (upper-half) forms:
// the long `Vd.<Ta>, Vn.<Tb>, Vm.<Tb>` (SADDL … UMULL, the SQDM* and PMULL), the wide
// `Vd.<Ta>, Vn.<Ta>, Vm.<Tb>` (SADDW … USUBW) and the narrowing `Vd.<Tb>, Vn.<Ta>, Vm.<Ta>`
// (ADDHN / RADDHN / SUBHN / RSUBHN), where Ta has twice Tb's element size and fills 128
// bits, and Tb fills 64 bits (128 for a "2" form); and the scalar SQDMLAL / SQDMLSL /
// SQDMULL `Sd, Hn, Hm` / `Dd, Sn, Sm`.  SMULL / UMULL are also integer instructions; the
// data-processing parser hands them here when the destination is a SIMD&FP register.  The
// by-element forms belong to another class; this parser rejects them.

// simd3DiffBase returns the simd.T3_* operation of a mnemonic without its "2", or -1.
func simd3DiffBase(m *[]readonly char) int {
	if mnemIs(m, "saddl") { return simd.T3_SADDL }
	if mnemIs(m, "saddw") { return simd.T3_SADDW }
	if mnemIs(m, "ssubl") { return simd.T3_SSUBL }
	if mnemIs(m, "ssubw") { return simd.T3_SSUBW }
	if mnemIs(m, "addhn") { return simd.T3_ADDHN }
	if mnemIs(m, "sabal") { return simd.T3_SABAL }
	if mnemIs(m, "subhn") { return simd.T3_SUBHN }
	if mnemIs(m, "sabdl") { return simd.T3_SABDL }
	if mnemIs(m, "smlal") { return simd.T3_SMLAL }
	if mnemIs(m, "sqdmlal") { return simd.T3_SQDMLAL }
	if mnemIs(m, "smlsl") { return simd.T3_SMLSL }
	if mnemIs(m, "sqdmlsl") { return simd.T3_SQDMLSL }
	if mnemIs(m, "smull") { return simd.T3_SMULL }
	if mnemIs(m, "sqdmull") { return simd.T3_SQDMULL }
	if mnemIs(m, "pmull") { return simd.T3_PMULL }
	if mnemIs(m, "uaddl") { return simd.T3_UADDL }
	if mnemIs(m, "uaddw") { return simd.T3_UADDW }
	if mnemIs(m, "usubl") { return simd.T3_USUBL }
	if mnemIs(m, "usubw") { return simd.T3_USUBW }
	if mnemIs(m, "raddhn") { return simd.T3_RADDHN }
	if mnemIs(m, "uabal") { return simd.T3_UABAL }
	if mnemIs(m, "rsubhn") { return simd.T3_RSUBHN }
	if mnemIs(m, "uabdl") { return simd.T3_UABDL }
	if mnemIs(m, "umlal") { return simd.T3_UMLAL }
	if mnemIs(m, "umlsl") { return simd.T3_UMLSL }
	if mnemIs(m, "umull") { return simd.T3_UMULL }
	return -1
}

// simd3DiffOf returns the simd.T3_* operation of a mnemonic and whether it is the "2"
// form, or -1.
func simd3DiffOf(m *[]readonly char) (int, bool) {
	var op int = simd3DiffBase(m)
	if op >= 0 { return op, false }
	if len(m) > 1 && m[len(m) - 1] == '2' {
		op = simd3DiffBase(m[0:len(m) - 1])
		if op >= 0 { return op, true }
	}
	return -1, false
}

// emitA64Simd3Diff parses and emits a three-different instruction that exists only for
// SIMD&FP registers (l positioned just after the mnemonic); returns false for any other
// mnemonic.
func emitA64Simd3Diff(p @Parser, l Lexer, mnem *[]readonly char) bool {
	op, _ := simd3DiffOf(mnem)
	if op < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	emitA64Simd3DiffItems(p, mnem, its)
	return true
}

// emitA64Simd3DiffItems emits a three-different instruction from its scanned operands;
// returns false (nothing done) when mnem is not one.
func emitA64Simd3DiffItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, q := simd3DiffOf(mnem)
	if op < 0 { return false }
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	if d.Kind == IT_REG {
		emitA64Simd3DiffScalar(p, op, q, d, n, m)
		return true
	}
	var opc int = op & 0xF
	var wide bool = opc == 0x1 || opc == 0x3
	var narrowing bool = opc == 0x4 || opc == 0x6
	// The narrow (Tb) operand fixes the element size; every other shape follows.
	var tb a64Item = n
	if wide { tb = m }
	if narrowing { tb = d }
	if tb.Kind != IT_VREG || tb.VEl > 3 {
		setErr(p, "expected vector operands of a long, wide or narrowing shape")
		return true
	}
	var el int = tb.VEl
	var nl int = 8 >> el
	if q { nl = 16 >> el }
	var wl int = 16 >> (el + 1)
	var shapeOk bool = false
	if wide {
		shapeOk = vecArrIs(d, el + 1, wl) && vecArrIs(n, el + 1, wl) && vecArrIs(m, el, nl)
	} else if narrowing {
		shapeOk = vecArrIs(d, el, nl) && vecArrIs(n, el + 1, wl) && vecArrIs(m, el + 1, wl)
	} else {
		shapeOk = vecArrIs(d, el + 1, wl) && vecArrIs(n, el, nl) && vecArrIs(m, el, nl)
	}
	if !shapeOk {
		setErr(p, "operand arrangements do not match this long / wide / narrowing instruction")
		return true
	}
	simd.ThreeDiff(p.Asm, op, q, el, d.Reg, n.Reg, m.Reg)
	return true
}

// emitA64Simd3DiffScalar emits the scalar SQDMLAL / SQDMLSL / SQDMULL from its operands:
// `Sd, Hn, Hm` or `Dd, Sn, Sm`.
func emitA64Simd3DiffScalar(p @Parser, op int, q bool, d a64Item, n a64Item, m a64Item) {
	var size int = -1
	if n.Kind == IT_REG && m.Kind == IT_REG && n.Cls == m.Cls { size = scalarSize(n.Cls) }
	if q || size < 0 || scalarSize(d.Cls) != size + 1 {
		setErr(p, "only sqdmlal / sqdmlsl / sqdmull have a scalar form: Sd, Hn, Hm or Dd, Sn, Sm")
		return
	}
	simd.ThreeDiffScalar(p.Asm, op, size, d.Reg, n.Reg, m.Reg)
}
