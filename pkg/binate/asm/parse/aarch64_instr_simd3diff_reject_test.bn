// The scalar form beyond SQDMLAL / SQDMLSL / SQDMULL: another operation, a "2" suffix
// (which has no scalar meaning — it must not assemble as the plain scalar form), B
// sources, general-purpose registers; and the D-element wide and narrowing shapes.
func TestGoldenSimd3DiffScalarReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sqdmull2 s0, h1, h2")
	e = goldenReject(e, "saddl s0, h1, h2")
	e = goldenReject(e, "smull s0, h1, h2")
	e = goldenReject(e, "sqdmull h0, b1, b2")
	e = goldenReject(e, "sqdmull d0, w1, w2")
	e = goldenReject(e, "addhn v0.1d, v1.1q, v2.1q")
	e = goldenReject(e, "saddw v0.1q, v1.1q, v2.1d")
	return e
}
