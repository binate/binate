package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the Advanced SIMD three-different instructions — every long, wide and
// narrowing operation and its "2" form at each element size it has, PMULL's 1Q, the scalar
// SQDMLAL / SQDMLSL / SQDMULL — and the integer SMULL / UMULL beside them, from clang
// (`clang -c -target aarch64-linux-gnu -march=armv8.6-a+aes`).

