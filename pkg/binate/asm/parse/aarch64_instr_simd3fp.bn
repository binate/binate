package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD floating-point three-same instructions (with FAMAX / FAMIN,
// FEAT_FAMINMAX, and FSCALE, FEAT_FP8): the vector form `Vd.<T>, Vn.<T>, Vm.<T>` (<T>
// 4h / 8h, 2s / 4s or 2d) and, for FMULX, the compares,
// FRECPS / FRSQRTS and FABD, the scalar form `<V>d, <V>n, <V>m` (H, S or D); and the
// register-compare aliases FCMLE / FCMLT / FACLE / FACLT (FCMGE / FCMGT / FACGE / FACGT
// with Vn and Vm swapped), whose scalar forms clang has only for S and D.  A compare
// against zero (`#0.0`) is the two-register compare (aarch64_instr_simd2fp.bn).  FADD,
// FSUB, FMUL, FDIV, FMAX, FMIN, FMAXNM and FMINNM on scalar registers are the floating-point
// data-processing instructions; the floating-point parser hands them here when the
// destination is a vector.  The by-element forms (FMLA / FMLS / FMUL / FMULX with a lane)
// belong to another class, which this parser rejects; the scalar pairwise forms
// (`faddp s0, v1.2s`) are aarch64_instr_simd_across.bn's.

// simd3FPOpA returns the simd.F3_* operation of a U=0 mnemonic, or -1.
func simd3FPOpA(m *[]readonly char) int {
	if mnemIs(m, "fmaxnm") { return simd.F3_FMAXNM }
	if mnemIs(m, "fmla") { return simd.F3_FMLA }
	if mnemIs(m, "fadd") { return simd.F3_FADD }
	if mnemIs(m, "fmulx") { return simd.F3_FMULX }
	if mnemIs(m, "fcmeq") { return simd.F3_FCMEQ }
	if mnemIs(m, "fmax") { return simd.F3_FMAX }
	if mnemIs(m, "frecps") { return simd.F3_FRECPS }
	if mnemIs(m, "fminnm") { return simd.F3_FMINNM }
	if mnemIs(m, "fmls") { return simd.F3_FMLS }
	if mnemIs(m, "fsub") { return simd.F3_FSUB }
	if mnemIs(m, "famax") { return simd.F3_FAMAX }
	if mnemIs(m, "fmin") { return simd.F3_FMIN }
	if mnemIs(m, "frsqrts") { return simd.F3_FRSQRTS }
	return -1
}

// simd3FPOpB returns the simd.F3_* operation of a U=1 mnemonic, or -1.
func simd3FPOpB(m *[]readonly char) int {
	if mnemIs(m, "fmaxnmp") { return simd.F3_FMAXNMP }
	if mnemIs(m, "faddp") { return simd.F3_FADDP }
	if mnemIs(m, "fmul") { return simd.F3_FMUL }
	if mnemIs(m, "fcmge") { return simd.F3_FCMGE }
	if mnemIs(m, "facge") { return simd.F3_FACGE }
	if mnemIs(m, "fmaxp") { return simd.F3_FMAXP }
	if mnemIs(m, "fdiv") { return simd.F3_FDIV }
	if mnemIs(m, "fminnmp") { return simd.F3_FMINNMP }
	if mnemIs(m, "fabd") { return simd.F3_FABD }
	if mnemIs(m, "famin") { return simd.F3_FAMIN }
	if mnemIs(m, "fscale") { return simd.F3_FSCALE }
	if mnemIs(m, "fcmgt") { return simd.F3_FCMGT }
	if mnemIs(m, "facgt") { return simd.F3_FACGT }
	if mnemIs(m, "fminp") { return simd.F3_FMINP }
	return -1
}

// simd3FPOf returns the simd.F3_* operation of a mnemonic and whether its Vn / Vm are
// swapped (the FCMLE / FCMLT / FACLE / FACLT aliases), or -1.
func simd3FPOf(m *[]readonly char) (int, bool) {
	if mnemIs(m, "fcmle") { return simd.F3_FCMGE, true }
	if mnemIs(m, "fcmlt") { return simd.F3_FCMGT, true }
	if mnemIs(m, "facle") { return simd.F3_FACGE, true }
	if mnemIs(m, "faclt") { return simd.F3_FACGT, true }
	var op int = simd3FPOpA(m)
	if op < 0 { op = simd3FPOpB(m) }
	return op, false
}

// emitA64SimdFP3 parses and emits a floating-point three-same instruction that the
// floating-point data-processing parser does not claim (l positioned just after the
// mnemonic); returns false for any other mnemonic.
func emitA64SimdFP3(p @Parser, l Lexer, mnem *[]readonly char) bool {
	op, _ := simd3FPOf(mnem)
	if op < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	var its a64Items
	var ok bool = false
	// The compare mnemonics also take `#0.0`, the floating-point zero (their compare
	// against zero), so only their operand lists may hold a floating-point literal.
	if f2CompareOp(simd2FPOf(mnem)) {
		its, ok = parseA64ItemsFloat(p, l, tok)
	} else {
		its, ok = parseA64Items(p, l, tok)
	}
	if !ok { return true }
	emitA64SimdFP3Items(p, mnem, its)
	return true
}

// vecFPType maps a vector element size to its isa.FT_* precision (H, S, D), or -1.
func vecFPType(el int) int {
	if el == 1 { return isa.FT_H }
	if el == 2 { return isa.FT_S }
	if el == 3 { return isa.FT_D }
	return -1
}

// emitA64SimdFP3Items emits a floating-point three-same instruction from its scanned
// operands; returns false (nothing done) when mnem is not one.
func emitA64SimdFP3Items(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, swap := simd3FPOf(mnem)
	if op < 0 { return false }
	// A compare against an immediate is the two-register compare against zero, and a
	// two-operand pairwise mnemonic the scalar pairwise reduction.
	if its.N == 3 && (its.It[2].Kind == IT_IMM || its.It[2].Kind == IT_FLOAT) &&
			emitA64SimdFP2Items(p, mnem, its) {
		return true
	}
	if its.N == 2 && emitA64SimdPairwiseItems(p, mnem, its) { return true }
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	if swap {
		n = its.It[2]
		m = its.It[1]
	}
	if sameVecArr(d, n) && sameVecArr(d, m) && vecFPType(d.VEl) >= 0 {
		q, _ := vecArrQ(d.VEl, d.VLanes)
		simd.FPThreeSame(p.Asm, op, q, vecFPType(d.VEl), d.Reg, n.Reg, m.Reg)
		return true
	}
	var ft int = -1
	if d.Kind == IT_REG { ft = fpTypeOf(d.Cls) }
	if ft >= 0 && n.Kind == IT_REG && m.Kind == IT_REG && n.Cls == d.Cls && m.Cls == d.Cls &&
			!(swap && ft == isa.FT_H) {
		simd.FPThreeSameScalar(p.Asm, op, ft, d.Reg, n.Reg, m.Reg)
		return true
	}
	setErr(p,
			"expected three 4h / 8h / 2s / 4s / 2d vectors of one arrangement, "
					"or three H / S / D registers")
	return true
}
