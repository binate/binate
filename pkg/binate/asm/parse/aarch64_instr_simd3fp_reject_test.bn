package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Floating-point three-same lines clang rejects: every operation on B vectors and B
// registers, 1D, the pairwise operations and FMLA / FMLS in scalar form, the scalar
// half-precision forms of the FCMLE / FCMLT / FACLE / FACLT aliases (which clang does not
// define), and mixed, partial or missing operands.

func TestGoldenSimd3FPReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fmaxnm v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmaxnm v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fmaxnm v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fmaxnm b5, b18, b27")
	e = goldenReject(e, "fmla v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmla v5.16b, v18.16b, v27.16b")
