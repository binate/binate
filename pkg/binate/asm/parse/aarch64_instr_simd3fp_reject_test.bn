	e = goldenReject(e, "fmla b5, b18, b27")
	e = goldenReject(e, "fmla h5, h18, h27")
	e = goldenReject(e, "fmla s5, s18, s27")
	e = goldenReject(e, "fmla d5, d18, d27")
	e = goldenReject(e, "fadd v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fadd v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fadd v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fadd b5, b18, b27")
	e = goldenReject(e, "fmulx v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmulx v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fmulx v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fmulx b5, b18, b27")
	e = goldenReject(e, "fcmeq v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fcmeq v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fcmeq v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fcmeq b5, b18, b27")
	e = goldenReject(e, "fmax v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmax v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fmax v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fmax b5, b18, b27")
	e = goldenReject(e, "frecps v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "frecps v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "frecps v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "frecps b5, b18, b27")
	e = goldenReject(e, "fminnm v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fminnm v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fminnm v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fminnm b5, b18, b27")
	e = goldenReject(e, "fmls v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmls v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fmls v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fmls b5, b18, b27")
	e = goldenReject(e, "fmls h5, h18, h27")
	e = goldenReject(e, "fmls s5, s18, s27")
	e = goldenReject(e, "fmls d5, d18, d27")
	e = goldenReject(e, "fsub v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fsub v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fsub v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fsub b5, b18, b27")
	e = goldenReject(e, "fmin v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmin v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fmin v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fmin b5, b18, b27")
	e = goldenReject(e, "frsqrts v5.8b, v18.8b, v27.8b")
