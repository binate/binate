	e = goldenReject(e, "fmaxnmp v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fmaxnmp v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fmaxnmp v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fmaxnmp b5, b18, b27")
	e = goldenReject(e, "fmaxnmp h5, h18, h27")
	e = goldenReject(e, "fmaxnmp s5, s18, s27")
	return e
}

