func TestGoldenSimd3FPReject3() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcmle b5, b18, b27")
	e = goldenReject(e, "fcmle h5, h18, h27")
	e = goldenReject(e, "fcmlt v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "fcmlt v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "fcmlt v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "fcmlt b5, b18, b27")
	e = goldenReject(e, "fcmlt h5, h18, h27")
	e = goldenReject(e, "facle v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "facle v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "facle v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "facle b5, b18, b27")
	e = goldenReject(e, "facle h5, h18, h27")
	e = goldenReject(e, "faclt v5.8b, v18.8b, v27.8b")
	e = goldenReject(e, "faclt v5.16b, v18.16b, v27.16b")
	e = goldenReject(e, "faclt v5.1d, v18.1d, v27.1d")
	e = goldenReject(e, "faclt b5, b18, b27")
	e = goldenReject(e, "faclt h5, h18, h27")
	e = goldenReject(e, "fadd v0.4s, v1.4s, s2")
	e = goldenReject(e, "fadd v0.4s, v1.2s, v2.4s")
	e = goldenReject(e, "fadd v0.2h, v1.2h, v2.2h")
	e = goldenReject(e, "fadd v0.1q, v1.1q, v2.1q")
	e = goldenReject(e, "fabd v0, v1, v2")
	e = goldenReject(e, "fabd s0, s1, d2")
	e = goldenReject(e, "fmla s0, s1, s2")
	e = goldenReject(e, "faddp s0, s1, s2")
	e = goldenReject(e, "fadd x0, x1, x2")
	e = goldenReject(e, "fmulx q0, q1, q2")
	e = goldenReject(e, "fcmge v0.8h, v1.4h, v2.8h")
	e = goldenReject(e, "fadd v0.4s, v1.4s")
	e = goldenReject(e, "fadd v0.4s, v1.4s, v2.4s, v3.4s")
	return e
}

// FAMAX / FAMIN / FSCALE have only the vector form, on H / S / D elements.
