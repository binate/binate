package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the Advanced SIMD floating-point three-same instructions (every
// operation at every arrangement and scalar precision it has — the scalar FADD, FMUL, …
// being the floating-point data-processing instructions — and the FCMLE / FCMLT / FACLE /
// FACLT aliases), from clang (`clang -c -target aarch64-linux-gnu -march=armv8.6-a+fp16`;
// FAMAX / FAMIN / FSCALE with `-march=armv9.5-a+faminmax+fp8`).

func TestGoldenSimd3FP1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fmaxnm v5.4h, v18.4h, v27.4h", 0x0E5B0645)
	e = goldenWord(e, "fmaxnm v5.8h, v18.8h, v27.8h", 0x4E5B0645)
	e = goldenWord(e, "fmaxnm v5.2s, v18.2s, v27.2s", 0x0E3BC645)
