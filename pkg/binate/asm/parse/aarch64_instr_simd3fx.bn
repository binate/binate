package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 Advanced SIMD floating-point instructions with operand shapes of their own:
// FCMLA `Vd.<T>, Vn.<T>, Vm.<T>, #rot` (rot 0 / 90 / 180 / 270) and FCADD (rot 90 / 270) on
// 4h / 8h / 2s / 4s / 2d, the rotation an expression with or without `#`; BFDOT
// `Vd.2s|4s, Vn.4h|8h, Vm.4h|8h`; BFMMLA / BFMLALB / BFMLALT `Vd.4s, Vn.8h, Vm.8h`; and
// FMLAL / FMLSL / FMLAL2 / FMLSL2 `Vd.2s|4s, Vn.2h|4h, Vm.2h|4h`.  The by-element forms
// belong to another class; this parser rejects them.

// vecArrIs reports whether item it is the whole-vector arrangement of lanes elements of
// size el (partial ones included), with no lane index.
func vecArrIs(it a64Item, el int, lanes int) bool {
	return it.Kind == IT_VREG && it.VEl == el && it.VLanes == lanes && it.Lane < 0
}

// simdFMlalOf returns the isa.FHM_* operation of a mnemonic, or -1.
func simdFMlalOf(m *[]readonly char) int {
	if mnemIs(m, "fmlal") { return isa.FHM_FMLAL }
	if mnemIs(m, "fmlsl") { return isa.FHM_FMLSL }
	if mnemIs(m, "fmlal2") { return isa.FHM_FMLAL2 }
	if mnemIs(m, "fmlsl2") { return isa.FHM_FMLSL2 }
	return -1
}

// isA64SimdFPExtra reports whether mnem is one of this file's instructions.
func isA64SimdFPExtra(m *[]readonly char) bool {
	return mnemIs(m, "fcmla") || mnemIs(m, "fcadd") || mnemIs(m, "bfdot") || mnemIs(m, "bfmmla") ||
			mnemIs(m, "bfmlalb") || mnemIs(m, "bfmlalt") || simdFMlalOf(m) >= 0
}

// emitA64SimdFPExtra parses and emits one of this file's instructions (l positioned just
// after the mnemonic); returns false for any other mnemonic.
func emitA64SimdFPExtra(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !isA64SimdFPExtra(mnem) { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if mnemIs(mnem, "fcmla") || mnemIs(mnem, "fcadd") {
		emitA64Complex(p, mnemIs(mnem, "fcadd"), its)
		return true
	}
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	if mnemIs(mnem, "bfdot") {
		var q bool = vecArrIs(d, 2, 4)
		var lanes int = 4
		if q { lanes = 8 }
		if (!q && !vecArrIs(d, 2, 2)) || !vecArrIs(n, 1, lanes) || !vecArrIs(m, 1, lanes) {
			setErr(p, "bfdot takes Vd.2s, Vn.4h, Vm.4h or Vd.4s, Vn.8h, Vm.8h")
			return true
		}
		isa.SimdBFDot(p.Asm, q, d.Reg, n.Reg, m.Reg)
		return true
	}
	var fhm int = simdFMlalOf(mnem)
	if fhm >= 0 {
		var q bool = vecArrIs(d, 2, 4)
		var lanes int = 2
		if q { lanes = 4 }
		if (!q && !vecArrIs(d, 2, 2)) || !vecArrIs(n, 1, lanes) || !vecArrIs(m, 1, lanes) {
			setErr(p, "a widening multiply-accumulate takes Vd.2s, Vn.2h, Vm.2h or "
					"Vd.4s, Vn.4h, Vm.4h")
			return true
		}
		isa.SimdFMlal(p.Asm, fhm, q, d.Reg, n.Reg, m.Reg)
		return true
	}
	if !vecArrIs(d, 2, 4) || !vecArrIs(n, 1, 8) || !vecArrIs(m, 1, 8) {
		setErr(p, "bfmmla / bfmlalb / bfmlalt take Vd.4s, Vn.8h, Vm.8h")
		return true
	}
	if mnemIs(mnem, "bfmmla") {
		isa.SimdBFMatMul(p.Asm, d.Reg, n.Reg, m.Reg)
	} else {
		isa.SimdBFMlal(p.Asm, mnemIs(mnem, "bfmlalt"), d.Reg, n.Reg, m.Reg)
	}
	return true
}

// emitA64Complex emits FCMLA (or FCADD, add) from its operands: three vectors of one H /
// S / D arrangement and the rotation.
func emitA64Complex(p @Parser, add bool, its a64Items) {
	if !dpExpectCount(p, its, 4) { return }
	var d a64Item = its.It[0]
	var r a64Item = its.It[3]
	if !sameVecArr(d, its.It[1]) || !sameVecArr(d, its.It[2]) || d.VEl < 1 || r.Kind != IT_IMM {
		setErr(p, "fcmla / fcadd take three 4h / 8h / 2s / 4s / 2d vectors and a rotation")
		return
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	if add {
		if r.Imm != 90 && r.Imm != 270 {
			setErr(p, "fcadd: the rotation is 90 or 270")
			return
		}
		isa.SimdFCadd(p.Asm, q, d.VEl, r.Imm == 270, d.Reg, its.It[1].Reg, its.It[2].Reg)
		return
	}
	if r.Imm != 0 && r.Imm != 90 && r.Imm != 180 && r.Imm != 270 {
		setErr(p, "fcmla: the rotation is 0, 90, 180 or 270")
		return
	}
	isa.SimdFCmla(p.Asm, q, d.VEl, cast(int, r.Imm / 90), d.Reg, its.It[1].Reg, its.It[2].Reg)
}
