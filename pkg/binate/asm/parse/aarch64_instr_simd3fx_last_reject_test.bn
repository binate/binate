// FCMLA / FCADD, BF16 and FHM with sources of different arrangements, or partial ones.
func TestGoldenSimd3FPExtraMixedReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcmla v0.4s, v1.4s, v2.2s, #0")
	e = goldenReject(e, "fcmla v0.2h, v1.2h, v2.2h, #0")
	e = goldenReject(e, "fcadd v0.4b, v1.4b, v2.4b, #90")
	e = goldenReject(e, "fcadd v0.4s, v1.2s, v2.4s, #90")
	e = goldenReject(e, "bfdot v0.2s, v1.4h, v2.8h")
	e = goldenReject(e, "bfmmla v0.4s, v1.8h, v2.4h")
