package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for FCMLA / FCADD (every arrangement and rotation, the rotation written
// with or without `#` and as an expression), BFDOT / BFMMLA / BFMLALB / BFMLALT and
// FMLAL / FMLSL / FMLAL2 / FMLSL2, from clang (`clang -c -target aarch64-linux-gnu
// -march=armv8.6-a+fp16+fp16fml`).

func TestGoldenSimd3FPExtra1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, #0", 0x2E5BC645)
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, #90", 0x2E5BCE45)
	e = goldenWord(e, "fcadd v5.4h, v18.4h, v27.4h, #90", 0x2E5BE645)
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, #180", 0x2E5BD645)
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, #270", 0x2E5BDE45)
	e = goldenWord(e, "fcadd v5.4h, v18.4h, v27.4h, #270", 0x2E5BF645)
	e = goldenWord(e, "fcmla v5.8h, v18.8h, v27.8h, #0", 0x6E5BC645)
	e = goldenWord(e, "fcmla v5.8h, v18.8h, v27.8h, #90", 0x6E5BCE45)
	e = goldenWord(e, "fcadd v5.8h, v18.8h, v27.8h, #90", 0x6E5BE645)
	e = goldenWord(e, "fcmla v5.8h, v18.8h, v27.8h, #180", 0x6E5BD645)
	e = goldenWord(e, "fcmla v5.8h, v18.8h, v27.8h, #270", 0x6E5BDE45)
	e = goldenWord(e, "fcadd v5.8h, v18.8h, v27.8h, #270", 0x6E5BF645)
	e = goldenWord(e, "fcmla v5.2s, v18.2s, v27.2s, #0", 0x2E9BC645)
	e = goldenWord(e, "fcmla v5.2s, v18.2s, v27.2s, #90", 0x2E9BCE45)
	e = goldenWord(e, "fcadd v5.2s, v18.2s, v27.2s, #90", 0x2E9BE645)
	e = goldenWord(e, "fcmla v5.2s, v18.2s, v27.2s, #180", 0x2E9BD645)
	e = goldenWord(e, "fcmla v5.2s, v18.2s, v27.2s, #270", 0x2E9BDE45)
	e = goldenWord(e, "fcadd v5.2s, v18.2s, v27.2s, #270", 0x2E9BF645)
	e = goldenWord(e, "fcmla v5.4s, v18.4s, v27.4s, #0", 0x6E9BC645)
	e = goldenWord(e, "fcmla v5.4s, v18.4s, v27.4s, #90", 0x6E9BCE45)
	e = goldenWord(e, "fcadd v5.4s, v18.4s, v27.4s, #90", 0x6E9BE645)
	e = goldenWord(e, "fcmla v5.4s, v18.4s, v27.4s, #180", 0x6E9BD645)
	e = goldenWord(e, "fcmla v5.4s, v18.4s, v27.4s, #270", 0x6E9BDE45)
	e = goldenWord(e, "fcadd v5.4s, v18.4s, v27.4s, #270", 0x6E9BF645)
	e = goldenWord(e, "fcmla v5.2d, v18.2d, v27.2d, #0", 0x6EDBC645)
	e = goldenWord(e, "fcmla v5.2d, v18.2d, v27.2d, #90", 0x6EDBCE45)
	e = goldenWord(e, "fcadd v5.2d, v18.2d, v27.2d, #90", 0x6EDBE645)
	e = goldenWord(e, "fcmla v5.2d, v18.2d, v27.2d, #180", 0x6EDBD645)
	e = goldenWord(e, "fcmla v5.2d, v18.2d, v27.2d, #270", 0x6EDBDE45)
	e = goldenWord(e, "fcadd v5.2d, v18.2d, v27.2d, #270", 0x6EDBF645)
	e = goldenWord(e, "bfdot v5.2s, v18.4h, v27.4h", 0x2E5BFE45)
	e = goldenWord(e, "bfdot v5.4s, v18.8h, v27.8h", 0x6E5BFE45)
	e = goldenWord(e, "bfmmla v5.4s, v18.8h, v27.8h", 0x6E5BEE45)
	e = goldenWord(e, "bfmlalb v5.4s, v18.8h, v27.8h", 0x2EDBFE45)
	e = goldenWord(e, "bfmlalt v5.4s, v18.8h, v27.8h", 0x6EDBFE45)
	e = goldenWord(e, "fmlal v5.2s, v18.2h, v27.2h", 0x0E3BEE45)
	e = goldenWord(e, "fmlal v5.4s, v18.4h, v27.4h", 0x4E3BEE45)
	e = goldenWord(e, "fmlsl v5.2s, v18.2h, v27.2h", 0x0EBBEE45)
	e = goldenWord(e, "fmlsl v5.4s, v18.4h, v27.4h", 0x4EBBEE45)
	e = goldenWord(e, "fmlal2 v5.2s, v18.2h, v27.2h", 0x2E3BCE45)
	e = goldenWord(e, "fmlal2 v5.4s, v18.4h, v27.4h", 0x6E3BCE45)
	e = goldenWord(e, "fmlsl2 v5.2s, v18.2h, v27.2h", 0x2EBBCE45)
	e = goldenWord(e, "fmlsl2 v5.4s, v18.4h, v27.4h", 0x6EBBCE45)
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, 90", 0x2E5BCE45)
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, #0x5a", 0x2E5BCE45)
	e = goldenWord(e, "fcmla v5.4h, v18.4h, v27.4h, #(45*2)", 0x2E5BCE45)
	e = goldenWord(e, "fcadd v5.4h, v18.4h, v27.4h, #0x10e", 0x2E5BF645)
	e = goldenWord(e, "fcadd v5.4h, v18.4h, v27.4h, 270", 0x2E5BF645)
	e = goldenWord(e, "fcmla v31.2d, v0.2d, v31.2d, #270", 0x6EDFDC1F)
	e = goldenWord(e, "FCADD V0.4S, V1.4S, V2.4S, #90", 0x6E82E420)
	return e
}

func TestGoldenSimd3FPExtra2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "bfdot v31.4s, v0.8h, v31.8h", 0x6E5FFC1F)
	e = goldenWord(e, "bfmmla v31.4s, v31.8h, v0.8h", 0x6E40EFFF)
	e = goldenWord(e, "bfmlalt v0.4s, v31.8h, v31.8h", 0x6EDFFFE0)
	e = goldenWord(e, "fmlsl2 v31.4s, v0.4h, v31.4h", 0x6EBFCC1F)
	return e
}
