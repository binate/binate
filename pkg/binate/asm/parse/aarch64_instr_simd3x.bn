package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD three-same-extra integer instructions: SQRDMLAH / SQRDMLSH
// (`Vd.<T>, Vn.<T>, Vm.<T>` on 4h / 8h / 2s / 4s, or H / S scalars), the dot products
// SDOT / UDOT / USDOT (`Vd.2s|4s, Vn.8b|16b, Vm.8b|16b`), and the matrix multiplies
// SMMLA / UMMLA / USMMLA (`Vd.4s, Vn.16b, Vm.16b`).  SQRDMLAH / SQRDMLSH with a lane on Vm
// are aarch64_instr_simd_elem.bn's; the dot products' by-element forms belong to another
// class, which this parser rejects.

// simdDotOf returns the simd.DOT_* dot product of a mnemonic, or -1.
func simdDotOf(m *[]readonly char) int {
	if mnemIs(m, "sdot") { return simd.DOT_SDOT }
	if mnemIs(m, "udot") { return simd.DOT_UDOT }
	if mnemIs(m, "usdot") { return simd.DOT_USDOT }
	return -1
}

// simdMatMulOf returns the simd.MM_* matrix multiply of a mnemonic, or -1.
func simdMatMulOf(m *[]readonly char) int {
	if mnemIs(m, "smmla") { return simd.MM_SMMLA }
	if mnemIs(m, "ummla") { return simd.MM_UMMLA }
	if mnemIs(m, "usmmla") { return simd.MM_USMMLA }
	return -1
}

// emitA64Simd3Extra parses and emits one of this file's instructions (l positioned just
// after the mnemonic); returns false for any other mnemonic.
func emitA64Simd3Extra(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var rdm bool = mnemIs(mnem, "sqrdmlah") || mnemIs(mnem, "sqrdmlsh")
	var dot int = simdDotOf(mnem)
	var mm int = simdMatMulOf(mnem)
	if !rdm && dot < 0 && mm < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	// A lane as the last source makes SQRDMLAH / SQRDMLSH by-element.
	if emitA64SimdElemItems(p, mnem, its) { return true }
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	if rdm {
		emitA64Rdmlah(p, mnemIs(mnem, "sqrdmlsh"), d, n, m)
		return true
	}
	// The byte sources: two 8b / 16b vectors of one width.
	var bytesOk bool = sameVecArr(n, m) && n.VEl == 0
	if dot >= 0 {
		if !bytesOk || !isVecArr(d) || d.VEl != 2 || n.VLanes != d.VLanes * 4 {
			setErr(p, "a dot product takes Vd.2s, Vn.8b, Vm.8b or Vd.4s, Vn.16b, Vm.16b")
			return true
		}
		simd.DotProduct(p.Asm, dot, d.VLanes == 4, d.Reg, n.Reg, m.Reg)
		return true
	}
	if !bytesOk || n.VLanes != 16 || !isVecArr(d) || d.VEl != 2 || d.VLanes != 4 {
		setErr(p, "a matrix multiply takes Vd.4s, Vn.16b, Vm.16b")
		return true
	}
	simd.IntMatMul(p.Asm, mm, d.Reg, n.Reg, m.Reg)
	return true
}

// emitA64Rdmlah emits SQRDMLAH / SQRDMLSH (sub) from its operands: three vectors of one
// H / S arrangement, or three H / S registers.
func emitA64Rdmlah(p @Parser, sub bool, d a64Item, n a64Item, m a64Item) {
	if sameVecArr(d, n) && sameVecArr(d, m) && (d.VEl == 1 || d.VEl == 2) {
		q, _ := vecArrQ(d.VEl, d.VLanes)
		simd.Rdmlah(p.Asm, sub, q, d.VEl, d.Reg, n.Reg, m.Reg)
		return
	}
	var size int = -1
	if d.Kind == IT_REG && (d.Cls == RC_H || d.Cls == RC_S) { size = scalarSize(d.Cls) }
	if size >= 0 && n.Kind == IT_REG && m.Kind == IT_REG && n.Cls == d.Cls && m.Cls == d.Cls {
		simd.RdmlahScalar(p.Asm, sub, size, d.Reg, n.Reg, m.Reg)
		return
	}
	setErr(p, "sqrdmlah / sqrdmlsh take three 4h / 8h / 2s / 4s vectors or three H / S registers")
}
