// SQRDMLAH / SQRDMLSH with sources of different arrangements or register classes.
func TestGoldenSimd3ExtraRdmMixedReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sqrdmlah v5.4h, v18.4h, v27.8h")
	e = goldenReject(e, "sqrdmlsh v5.4s, v18.2s, v27.4s")
