package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for SQRDMLAH / SQRDMLSH, SDOT / UDOT / USDOT and SMMLA / UMMLA / USMMLA
// (every accepted operand shape), from clang (`clang -c -target aarch64-linux-gnu
// -march=armv8.6-a`).

func TestGoldenSimd3Extra1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "sqrdmlah v5.4h, v18.4h, v27.4h", 0x2E5B8645)
	e = goldenWord(e, "sqrdmlah v5.8h, v18.8h, v27.8h", 0x6E5B8645)
	e = goldenWord(e, "sqrdmlah v5.2s, v18.2s, v27.2s", 0x2E9B8645)
	e = goldenWord(e, "sqrdmlah v5.4s, v18.4s, v27.4s", 0x6E9B8645)
	e = goldenWord(e, "sqrdmlah h5, h18, h27", 0x7E5B8645)
	e = goldenWord(e, "sqrdmlah s5, s18, s27", 0x7E9B8645)
	e = goldenWord(e, "sqrdmlsh v5.4h, v18.4h, v27.4h", 0x2E5B8E45)
	e = goldenWord(e, "sqrdmlsh v5.8h, v18.8h, v27.8h", 0x6E5B8E45)
	e = goldenWord(e, "sqrdmlsh v5.2s, v18.2s, v27.2s", 0x2E9B8E45)
	e = goldenWord(e, "sqrdmlsh v5.4s, v18.4s, v27.4s", 0x6E9B8E45)
	e = goldenWord(e, "sqrdmlsh h5, h18, h27", 0x7E5B8E45)
	e = goldenWord(e, "sqrdmlsh s5, s18, s27", 0x7E9B8E45)
	e = goldenWord(e, "sdot v5.2s, v18.8b, v27.8b", 0x0E9B9645)
	e = goldenWord(e, "sdot v5.4s, v18.16b, v27.16b", 0x4E9B9645)
	e = goldenWord(e, "udot v5.2s, v18.8b, v27.8b", 0x2E9B9645)
	e = goldenWord(e, "udot v5.4s, v18.16b, v27.16b", 0x6E9B9645)
	e = goldenWord(e, "usdot v5.2s, v18.8b, v27.8b", 0x0E9B9E45)
	e = goldenWord(e, "usdot v5.4s, v18.16b, v27.16b", 0x4E9B9E45)
	e = goldenWord(e, "smmla v5.4s, v18.16b, v27.16b", 0x4E9BA645)
	e = goldenWord(e, "ummla v5.4s, v18.16b, v27.16b", 0x6E9BA645)
	e = goldenWord(e, "usmmla v5.4s, v18.16b, v27.16b", 0x4E9BAE45)
	e = goldenWord(e, "sqrdmlah v31.8h, v0.8h, v31.8h", 0x6E5F841F)
	e = goldenWord(e, "SQRDMLSH S0, S31, S1", 0x7E818FE0)
	e = goldenWord(e, "sdot v31.4s, v0.16b, v31.16b", 0x4E9F941F)
	e = goldenWord(e, "UDOT V0.2S, V1.8B, V2.8B", 0x2E829420)
	e = goldenWord(e, "usmmla v31.4s, v31.16b, v0.16b", 0x4E80AFFF)
	return e
}
