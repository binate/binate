package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD reductions to a scalar: the across-lanes ADDV / SMAXV / UMAXV /
// SMINV / UMINV `<V>d, Vn.<T>` (8b / 16b to B, 4h / 8h to H, 4s to S) and SADDLV / UADDLV
// (to twice the element size), FMAXNMV / FMINNMV / FMAXV / FMINV (`Sd, Vn.4s`, `Hd,
// Vn.4h|8h`); and the scalar pairwise ADDP `Dd, Vn.2d` and FADDP / FMAXP / FMINP / FMAXNMP
// / FMINNMP `Hd, Vn.2h` / `Sd, Vn.2s` / `Dd, Vn.2d`.  The pairwise mnemonics also name
// three-same instructions; those parsers hand the two-operand forms here.

// simdAcrossOf returns the simd.AL_* integer reduction of a mnemonic, or -1.
func simdAcrossOf(m *[]readonly char) int {
	if mnemIs(m, "addv") { return simd.AL_ADDV }
	if mnemIs(m, "saddlv") { return simd.AL_SADDLV }
	if mnemIs(m, "uaddlv") { return simd.AL_UADDLV }
	if mnemIs(m, "smaxv") { return simd.AL_SMAXV }
	if mnemIs(m, "umaxv") { return simd.AL_UMAXV }
	if mnemIs(m, "sminv") { return simd.AL_SMINV }
	if mnemIs(m, "uminv") { return simd.AL_UMINV }
	return -1
}

// simdFPAcrossOf returns the simd.FAL_* floating-point reduction of a mnemonic, or -1.
func simdFPAcrossOf(m *[]readonly char) int {
	if mnemIs(m, "fmaxnmv") { return simd.FAL_FMAXNMV }
	if mnemIs(m, "fminnmv") { return simd.FAL_FMINNMV }
	if mnemIs(m, "fmaxv") { return simd.FAL_FMAXV }
	if mnemIs(m, "fminv") { return simd.FAL_FMINV }
	return -1
}

// simdFPPairwiseOf returns the simd.FPW_* scalar pairwise reduction of a mnemonic, or -1.
func simdFPPairwiseOf(m *[]readonly char) int {
	if mnemIs(m, "faddp") { return simd.FPW_FADDP }
	if mnemIs(m, "fmaxp") { return simd.FPW_FMAXP }
	if mnemIs(m, "fminp") { return simd.FPW_FMINP }
	if mnemIs(m, "fmaxnmp") { return simd.FPW_FMAXNMP }
	if mnemIs(m, "fminnmp") { return simd.FPW_FMINNMP }
	return -1
}

// emitA64SimdAcross parses and emits an across-lanes reduction (l positioned just after
// the mnemonic); returns false for any other mnemonic.
func emitA64SimdAcross(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var op int = simdAcrossOf(mnem)
	var fop int = simdFPAcrossOf(mnem)
	if op < 0 && fop < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok || !dpExpectCount(p, its, 2) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var dsize int = -1
	if d.Kind == IT_REG { dsize = scalarSize(d.Cls) }
	if n.Kind != IT_VREG || n.VLanes == 0 || n.Lane >= 0 || dsize < 0 {
		setErr(p, "a reduction takes a scalar register and a vector")
		return true
	}
	q, okQ := vecArrQ(n.VEl, n.VLanes)
	var want int = n.VEl
	if op == simd.AL_SADDLV || op == simd.AL_UADDLV { want = n.VEl + 1 }
	if !okQ || dsize != want {
		setErr(p, "the scalar's size does not match the reduction of this arrangement")
		return true
	}
	if op >= 0 {
		simd.AcrossLanes(p.Asm, op, q, n.VEl, d.Reg, n.Reg)
		return true
	}
	simd.FPAcrossLanes(p.Asm, fop, q, fpTypeOf(d.Cls), d.Reg, n.Reg)
	return true
}

// emitA64SimdPairwiseItems emits a scalar pairwise reduction from its scanned operands
// (`<V>d, Vn.2<V>`); returns false (nothing done) when mnem is not a pairwise mnemonic.
func emitA64SimdPairwiseItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	var fop int = simdFPPairwiseOf(mnem)
	if fop < 0 && !mnemIs(mnem, "addp") { return false }
	if !dpExpectCount(p, its, 2) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var ft int = -1
	if d.Kind == IT_REG { ft = fpTypeOf(d.Cls) }
	if ft < 0 || !vecArrIs(n, scalarSize(d.Cls), 2) || (fop < 0 && ft != isa.FT_D) {
		setErr(p,
				"a scalar pairwise reduction takes Dd, Vn.2d (faddp etc. also Sd, Vn.2s / "
						"Hd, Vn.2h)")
		return true
	}
	if fop < 0 {
		simd.AddpScalar(p.Asm, d.Reg, n.Reg)
		return true
	}
	simd.FPPairwiseScalar(p.Asm, fop, ft, d.Reg, n.Reg)
	return true
}
