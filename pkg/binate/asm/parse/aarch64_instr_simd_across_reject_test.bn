package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Reduction lines clang rejects: each mnemonic's scalar and vector at sizes that do not
// go together (2s and 2d for the across-lanes forms, a scalar of the wrong size), and a
// vector destination, a lane, a bare V register, or a wrong operand count.

func TestGoldenSimdAcrossReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "addv b5, v18.4h")
	e = goldenReject(e, "addv b5, v18.8h")
	e = goldenReject(e, "addv b5, v18.4s")
	e = goldenReject(e, "addv h5, v18.8b")
	e = goldenReject(e, "addv h5, v18.16b")
	e = goldenReject(e, "addv h5, v18.4s")
	e = goldenReject(e, "addv s5, v18.8b")
	e = goldenReject(e, "addv s5, v18.16b")
	e = goldenReject(e, "addv s5, v18.4h")
	e = goldenReject(e, "addv s5, v18.8h")
	e = goldenReject(e, "saddlv h5, v18.4h")
	e = goldenReject(e, "saddlv h5, v18.8h")
	e = goldenReject(e, "saddlv h5, v18.4s")
	e = goldenReject(e, "saddlv s5, v18.8b")
	e = goldenReject(e, "saddlv s5, v18.16b")
	e = goldenReject(e, "saddlv s5, v18.4s")
	e = goldenReject(e, "saddlv d5, v18.8b")
	e = goldenReject(e, "saddlv d5, v18.16b")
	e = goldenReject(e, "saddlv d5, v18.4h")
	e = goldenReject(e, "saddlv d5, v18.8h")
	e = goldenReject(e, "uaddlv h5, v18.4h")
	e = goldenReject(e, "uaddlv h5, v18.8h")
	e = goldenReject(e, "uaddlv h5, v18.4s")
	e = goldenReject(e, "uaddlv s5, v18.8b")
	e = goldenReject(e, "uaddlv s5, v18.16b")
	e = goldenReject(e, "uaddlv s5, v18.4s")
	e = goldenReject(e, "uaddlv d5, v18.8b")
	e = goldenReject(e, "uaddlv d5, v18.16b")
	e = goldenReject(e, "uaddlv d5, v18.4h")
	e = goldenReject(e, "uaddlv d5, v18.8h")
	e = goldenReject(e, "smaxv b5, v18.4h")
	e = goldenReject(e, "smaxv b5, v18.8h")
	e = goldenReject(e, "smaxv b5, v18.4s")
	e = goldenReject(e, "smaxv h5, v18.8b")
	e = goldenReject(e, "smaxv h5, v18.16b")
	e = goldenReject(e, "smaxv h5, v18.4s")
	e = goldenReject(e, "smaxv s5, v18.8b")
	e = goldenReject(e, "smaxv s5, v18.16b")
	e = goldenReject(e, "smaxv s5, v18.4h")
	e = goldenReject(e, "smaxv s5, v18.8h")
	e = goldenReject(e, "umaxv b5, v18.4h")
	e = goldenReject(e, "umaxv b5, v18.8h")
	e = goldenReject(e, "umaxv b5, v18.4s")
	e = goldenReject(e, "umaxv h5, v18.8b")
	e = goldenReject(e, "umaxv h5, v18.16b")
	e = goldenReject(e, "umaxv h5, v18.4s")
	e = goldenReject(e, "umaxv s5, v18.8b")
	e = goldenReject(e, "umaxv s5, v18.16b")
	e = goldenReject(e, "umaxv s5, v18.4h")
	e = goldenReject(e, "umaxv s5, v18.8h")
	e = goldenReject(e, "sminv b5, v18.4h")
	e = goldenReject(e, "sminv b5, v18.8h")
	e = goldenReject(e, "sminv b5, v18.4s")
	e = goldenReject(e, "sminv h5, v18.8b")
	e = goldenReject(e, "sminv h5, v18.16b")
	e = goldenReject(e, "sminv h5, v18.4s")
	e = goldenReject(e, "sminv s5, v18.8b")
	e = goldenReject(e, "sminv s5, v18.16b")
	e = goldenReject(e, "sminv s5, v18.4h")
	e = goldenReject(e, "sminv s5, v18.8h")
	return e
}

func TestGoldenSimdAcrossReject2() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "uminv b5, v18.4h")
	e = goldenReject(e, "uminv b5, v18.8h")
	e = goldenReject(e, "uminv b5, v18.4s")
	e = goldenReject(e, "uminv h5, v18.8b")
	e = goldenReject(e, "uminv h5, v18.16b")
	e = goldenReject(e, "uminv h5, v18.4s")
	e = goldenReject(e, "uminv s5, v18.8b")
	e = goldenReject(e, "uminv s5, v18.16b")
	e = goldenReject(e, "uminv s5, v18.4h")
	e = goldenReject(e, "uminv s5, v18.8h")
	e = goldenReject(e, "fmaxnmv h5, v18.4s")
	e = goldenReject(e, "fmaxnmv s5, v18.4h")
	e = goldenReject(e, "fmaxnmv s5, v18.8h")
	e = goldenReject(e, "fminnmv h5, v18.4s")
	e = goldenReject(e, "fminnmv s5, v18.4h")
	e = goldenReject(e, "fminnmv s5, v18.8h")
	e = goldenReject(e, "fmaxv h5, v18.4s")
	e = goldenReject(e, "fmaxv s5, v18.4h")
	e = goldenReject(e, "fmaxv s5, v18.8h")
	e = goldenReject(e, "fminv h5, v18.4s")
	e = goldenReject(e, "fminv s5, v18.4h")
	e = goldenReject(e, "fminv s5, v18.8h")
	e = goldenReject(e, "faddp h5, v18.2s")
	e = goldenReject(e, "faddp h5, v18.2d")
	e = goldenReject(e, "faddp s5, v18.2d")
	e = goldenReject(e, "faddp s5, v18.2h")
	e = goldenReject(e, "faddp d5, v18.2s")
	e = goldenReject(e, "faddp d5, v18.2h")
	e = goldenReject(e, "fmaxp h5, v18.2s")
	e = goldenReject(e, "fmaxp h5, v18.2d")
	e = goldenReject(e, "fmaxp s5, v18.2d")
	e = goldenReject(e, "fmaxp s5, v18.2h")
	e = goldenReject(e, "fmaxp d5, v18.2s")
	e = goldenReject(e, "fmaxp d5, v18.2h")
	e = goldenReject(e, "fminp h5, v18.2s")
	e = goldenReject(e, "fminp h5, v18.2d")
	e = goldenReject(e, "fminp s5, v18.2d")
	e = goldenReject(e, "fminp s5, v18.2h")
	e = goldenReject(e, "fminp d5, v18.2s")
	e = goldenReject(e, "fminp d5, v18.2h")
	e = goldenReject(e, "fmaxnmp h5, v18.2s")
	e = goldenReject(e, "fmaxnmp h5, v18.2d")
	e = goldenReject(e, "fmaxnmp s5, v18.2d")
	e = goldenReject(e, "fmaxnmp s5, v18.2h")
	e = goldenReject(e, "fmaxnmp d5, v18.2s")
	e = goldenReject(e, "fmaxnmp d5, v18.2h")
	e = goldenReject(e, "fminnmp h5, v18.2s")
	e = goldenReject(e, "fminnmp h5, v18.2d")
	e = goldenReject(e, "fminnmp s5, v18.2d")
	e = goldenReject(e, "fminnmp s5, v18.2h")
	e = goldenReject(e, "fminnmp d5, v18.2s")
	e = goldenReject(e, "fminnmp d5, v18.2h")
	e = goldenReject(e, "addv v0.8b, v1.8b")
	e = goldenReject(e, "faddp v0.2s, v1.2s")
	e = goldenReject(e, "faddp s0, v1.2s, v2.2s")
	e = goldenReject(e, "addp d0, d1")
	e = goldenReject(e, "addv b0, v1.b[0]")
	e = goldenReject(e, "addv b0, v1")
	return e
}

// The shapes the matrix's own arrangements do not reach: ADDP from anything but 2d (only
// the size check between scalar and vector stops `addp s0, v1.2s` encoding as the D form),
// the across-lanes forms on 2s / 2d / 1d / 2h, and destinations of a size no reduction
// produces.
func TestGoldenSimdAcrossShapeReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "addp s5, v18.2s")
	e = goldenReject(e, "addp h5, v18.2h")
	e = goldenReject(e, "addv s5, v18.2s")
	e = goldenReject(e, "smaxv s5, v18.2s")
	e = goldenReject(e, "saddlv d5, v18.2s")
	e = goldenReject(e, "uaddlv d5, v18.2s")
	e = goldenReject(e, "addv d5, v18.2d")
	e = goldenReject(e, "fmaxv s5, v18.2s")
	e = goldenReject(e, "fmaxv d5, v18.2d")
	e = goldenReject(e, "fmaxv b5, v18.8b")
	e = goldenReject(e, "faddp q5, v18.2d")
	e = goldenReject(e, "faddp b5, v18.2b")
	e = goldenReject(e, "addv h5, v18.2h")
	e = goldenReject(e, "addv d5, v18.1d")
	return e
}
