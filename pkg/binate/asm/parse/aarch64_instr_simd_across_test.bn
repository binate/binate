package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the reductions to a scalar — the integer and floating-point
// across-lanes instructions at every arrangement they take, the scalar pairwise ADDP /
// FADDP / FMAXP / FMINP / FMAXNMP / FMINNMP, and the vector ADDP / FADDP beside them —
// from clang (`clang -c -target aarch64-linux-gnu -march=armv8.6-a+fp16`).

func TestGoldenSimdAcross1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "addv b5, v18.8b", 0x0E31BA45)
	e = goldenWord(e, "addv b5, v18.16b", 0x4E31BA45)
	e = goldenWord(e, "addv h5, v18.4h", 0x0E71BA45)
	e = goldenWord(e, "addv h5, v18.8h", 0x4E71BA45)
	e = goldenWord(e, "addv s5, v18.4s", 0x4EB1BA45)
	e = goldenWord(e, "saddlv h5, v18.8b", 0x0E303A45)
	e = goldenWord(e, "saddlv h5, v18.16b", 0x4E303A45)
	e = goldenWord(e, "saddlv s5, v18.4h", 0x0E703A45)
	e = goldenWord(e, "saddlv s5, v18.8h", 0x4E703A45)
	e = goldenWord(e, "saddlv d5, v18.4s", 0x4EB03A45)
	e = goldenWord(e, "uaddlv h5, v18.8b", 0x2E303A45)
	e = goldenWord(e, "uaddlv h5, v18.16b", 0x6E303A45)
	e = goldenWord(e, "uaddlv s5, v18.4h", 0x2E703A45)
	e = goldenWord(e, "uaddlv s5, v18.8h", 0x6E703A45)
	e = goldenWord(e, "uaddlv d5, v18.4s", 0x6EB03A45)
	e = goldenWord(e, "smaxv b5, v18.8b", 0x0E30AA45)
	e = goldenWord(e, "smaxv b5, v18.16b", 0x4E30AA45)
	e = goldenWord(e, "smaxv h5, v18.4h", 0x0E70AA45)
	e = goldenWord(e, "smaxv h5, v18.8h", 0x4E70AA45)
	e = goldenWord(e, "smaxv s5, v18.4s", 0x4EB0AA45)
	e = goldenWord(e, "umaxv b5, v18.8b", 0x2E30AA45)
	e = goldenWord(e, "umaxv b5, v18.16b", 0x6E30AA45)
	e = goldenWord(e, "umaxv h5, v18.4h", 0x2E70AA45)
	e = goldenWord(e, "umaxv h5, v18.8h", 0x6E70AA45)
	e = goldenWord(e, "umaxv s5, v18.4s", 0x6EB0AA45)
	e = goldenWord(e, "sminv b5, v18.8b", 0x0E31AA45)
	e = goldenWord(e, "sminv b5, v18.16b", 0x4E31AA45)
	e = goldenWord(e, "sminv h5, v18.4h", 0x0E71AA45)
	e = goldenWord(e, "sminv h5, v18.8h", 0x4E71AA45)
	e = goldenWord(e, "sminv s5, v18.4s", 0x4EB1AA45)
	e = goldenWord(e, "uminv b5, v18.8b", 0x2E31AA45)
	e = goldenWord(e, "uminv b5, v18.16b", 0x6E31AA45)
	e = goldenWord(e, "uminv h5, v18.4h", 0x2E71AA45)
	e = goldenWord(e, "uminv h5, v18.8h", 0x6E71AA45)
	e = goldenWord(e, "uminv s5, v18.4s", 0x6EB1AA45)
	e = goldenWord(e, "fmaxnmv h5, v18.4h", 0x0E30CA45)
	e = goldenWord(e, "fmaxnmv h5, v18.8h", 0x4E30CA45)
	e = goldenWord(e, "fmaxnmv s5, v18.4s", 0x6E30CA45)
	e = goldenWord(e, "fminnmv h5, v18.4h", 0x0EB0CA45)
	e = goldenWord(e, "fminnmv h5, v18.8h", 0x4EB0CA45)
	e = goldenWord(e, "fminnmv s5, v18.4s", 0x6EB0CA45)
	e = goldenWord(e, "fmaxv h5, v18.4h", 0x0E30FA45)
	e = goldenWord(e, "fmaxv h5, v18.8h", 0x4E30FA45)
	e = goldenWord(e, "fmaxv s5, v18.4s", 0x6E30FA45)
	e = goldenWord(e, "fminv h5, v18.4h", 0x0EB0FA45)
	e = goldenWord(e, "fminv h5, v18.8h", 0x4EB0FA45)
	e = goldenWord(e, "fminv s5, v18.4s", 0x6EB0FA45)
	e = goldenWord(e, "addp d5, v18.2d", 0x5EF1BA45)
	e = goldenWord(e, "faddp h5, v18.2h", 0x5E30DA45)
	e = goldenWord(e, "faddp s5, v18.2s", 0x7E30DA45)
	return e
}

func TestGoldenSimdAcross2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "faddp d5, v18.2d", 0x7E70DA45)
	e = goldenWord(e, "fmaxp h5, v18.2h", 0x5E30FA45)
	e = goldenWord(e, "fmaxp s5, v18.2s", 0x7E30FA45)
	e = goldenWord(e, "fmaxp d5, v18.2d", 0x7E70FA45)
	e = goldenWord(e, "fminp h5, v18.2h", 0x5EB0FA45)
	e = goldenWord(e, "fminp s5, v18.2s", 0x7EB0FA45)
	e = goldenWord(e, "fminp d5, v18.2d", 0x7EF0FA45)
	e = goldenWord(e, "fmaxnmp h5, v18.2h", 0x5E30CA45)
	e = goldenWord(e, "fmaxnmp s5, v18.2s", 0x7E30CA45)
	e = goldenWord(e, "fmaxnmp d5, v18.2d", 0x7E70CA45)
	e = goldenWord(e, "fminnmp h5, v18.2h", 0x5EB0CA45)
	e = goldenWord(e, "fminnmp s5, v18.2s", 0x7EB0CA45)
	e = goldenWord(e, "fminnmp d5, v18.2d", 0x7EF0CA45)
	e = goldenWord(e, "ADDV B31, V0.16B", 0x4E31B81F)
	e = goldenWord(e, "uaddlv d0, v31.4s", 0x6EB03BE0)
	e = goldenWord(e, "fmaxnmv h31, v0.8h", 0x4E30C81F)
	e = goldenWord(e, "fminv s0, v31.4s", 0x6EB0FBE0)
	e = goldenWord(e, "addp d31, v0.2d", 0x5EF1B81F)
	e = goldenWord(e, "FADDP D0, V31.2D", 0x7E70DBE0)
	e = goldenWord(e, "fminnmp h31, v0.2h", 0x5EB0C81F)
	e = goldenWord(e, "addp v0.2d, v1.2d, v2.2d", 0x4EE2BC20)
	e = goldenWord(e, "faddp v0.4s, v1.4s, v2.4s", 0x6E22D420)
	return e
}
