package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD copy instructions: DUP `Vd.<T>, Rn`, `Vd.<T>, Vn.<t>[i]` and the
// scalar `<V>d, Vn.<t>[i]`; INS `Vd.<t>[i], Rn` and `Vd.<t>[i], Vn.<t>[j]`; UMOV / SMOV
// `Rd, Vn.<t>[i]`; the MOV aliases of INS, of UMOV (S / D lanes) and of the scalar DUP
// (and, emitted here with them, the whole-vector MOV alias of ORR); and FMOV between an
// X register and `Vn.d[1]`.  A general-purpose operand is W for a
// B / H / S element and X for D; the zero register is allowed, SP is not.

// vecArrQ returns whether an arrangement (element size el, lanes > 0) fills a 128-bit
// register (q), and ok=false for one that is neither 64 nor 128 bits.
func vecArrQ(el int, lanes int) (bool, bool) {
	var bits int = lanes * (8 << el)
	if bits == 128 { return true, true }
	if bits == 64 { return false, true }
	return false, false
}

// simdGPFor reports whether a general-purpose register class suits an element of size
// el: W for B / H / S, X for D.
func simdGPFor(cls int, el int) bool {
	if el == 3 { return rcIsX(cls) }
	return rcIsW(cls)
}

// isVecArr reports whether item it is a whole 64- or 128-bit vector arrangement (no lane
// index).
func isVecArr(it a64Item) bool {
	if it.Kind != IT_VREG || it.VLanes == 0 || it.Lane >= 0 { return false }
	_, ok := vecArrQ(it.VEl, it.VLanes)
	return ok
}

// isVecLane reports whether item it is a vector element with a lane index.
func isVecLane(it a64Item) bool {
	return it.Kind == IT_VREG && it.VLanes == 0 && it.Lane >= 0
}

// scalarSize maps a scalar SIMD&FP register class to its element size, or -1.
func scalarSize(cls int) int {
	if cls == RC_B { return 0 }
	if cls == RC_H { return 1 }
	if cls == RC_S { return 2 }
	if cls == RC_D { return 3 }
	return -1
}

// itemIsSimd reports whether item it is a SIMD&FP register: a vector with an
// arrangement or element, or a B / H / S / D / Q / V register.
func itemIsSimd(it a64Item) bool {
	if it.Kind == IT_VREG { return true }
	return it.Kind == IT_REG && (scalarSize(it.Cls) >= 0 || it.Cls == RC_Q || it.Cls == RC_V)
}

// itemsHaveSimd reports whether an operand list names a SIMD&FP register (so a MOV is
// one of the SIMD aliases, not an integer move).
func itemsHaveSimd(its a64Items) bool {
	for i := 0; i < its.N; i++ {
		if itemIsSimd(its.It[i]) { return true }
	}
	return false
}

// isA64SimdCopy reports whether mnem is DUP / INS / UMOV / SMOV.
func isA64SimdCopy(m *[]readonly char) bool {
	return mnemIs(m, "dup") || mnemIs(m, "ins") || mnemIs(m, "umov") || mnemIs(m, "smov")
}

// emitA64SimdCopy parses and emits DUP / INS / UMOV / SMOV (l positioned just after the
// mnemonic); returns false when mnem is not one of them.
func emitA64SimdCopy(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !isA64SimdCopy(mnem) { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok || !dpExpectCount(p, its, 2) { return true }
	var d a64Item = its.It[0]
	var s a64Item = its.It[1]
	if mnemIs(mnem, "dup") {
		emitA64Dup(p, d, s)
	} else if mnemIs(mnem, "ins") {
		if !emitA64Ins(p, d, s) { setErr(p, "ins takes Vd.<t>[i], Rn or Vd.<t>[i], Vn.<t>[j]") }
	} else if mnemIs(mnem, "umov") {
		if !emitA64Umov(p, d, s, false) { setErr(p, "umov takes Wd, Vn.b|h|s[i] or Xd, Vn.d[i]") }
	} else {
		var ok2 bool = d.Kind == IT_REG && isVecLane(s) && s.VEl <= 2 &&
				(rcIsX(d.Cls) || (rcIsW(d.Cls) && s.VEl <= 1))
		if !ok2 {
			setErr(p, "smov takes Wd, Vn.b|h[i] or Xd, Vn.b|h|s[i]")
			return true
		}
		simd.Smov(p.Asm, rcIsX(d.Cls), s.VEl, d.Reg, s.Reg, s.Lane)
	}
	return true
}

// emitA64Dup emits DUP from a general-purpose register or a lane, to a vector or (the
// scalar form) to a B / H / S / D register.
func emitA64Dup(p @Parser, d a64Item, s a64Item) {
	if d.Kind == IT_REG && isVecLane(s) && scalarSize(d.Cls) == s.VEl {
		simd.DupScalar(p.Asm, s.VEl, d.Reg, s.Reg, s.Lane)
		return
	}
	var q bool = false
	var okArr bool = false
	if isVecArr(d) && d.VEl <= 3 { q, okArr = vecArrQ(d.VEl, d.VLanes) }
	if !okArr {
		setErr(p, "dup takes Vd.<T>, Rn / Vn.<t>[i], or <V>d, Vn.<t>[i]")
		return
	}
	if isVecLane(s) && s.VEl == d.VEl {
		simd.DupElement(p.Asm, q, d.VEl, d.Reg, s.Reg, s.Lane)
		return
	}
	if s.Kind == IT_REG && simdGPFor(s.Cls, d.VEl) {
		simd.DupGeneral(p.Asm, q, d.VEl, d.Reg, s.Reg)
		return
	}
	setErr(p, "dup: the source must be a W (B / H / S) or X (D) register, or a lane of that size")
}

// emitA64Ins emits INS from a general-purpose register or a lane; false (nothing done)
// when the operands are neither form.
func emitA64Ins(p @Parser, d a64Item, s a64Item) bool {
	if !isVecLane(d) { return false }
	if isVecLane(s) && s.VEl == d.VEl {
		simd.InsElement(p.Asm, d.VEl, d.Reg, d.Lane, s.Reg, s.Lane)
		return true
	}
	if s.Kind == IT_REG && simdGPFor(s.Cls, d.VEl) {
		simd.InsGeneral(p.Asm, d.VEl, d.Reg, d.Lane, s.Reg)
		return true
	}
	return false
}

// emitA64Umov emits UMOV `Rd, Vn.<t>[i]` (the MOV alias, movAlias, takes only S and D
// lanes); false (nothing done) when the operands are not that form.
func emitA64Umov(p @Parser, d a64Item, s a64Item, movAlias bool) bool {
	if d.Kind != IT_REG || !isVecLane(s) || s.VEl > 3 || !simdGPFor(d.Cls, s.VEl) { return false }
	if movAlias && s.VEl < 2 { return false }
	simd.Umov(p.Asm, s.VEl, d.Reg, s.Reg, s.Lane)
	return true
}

// emitA64SimdMov emits a MOV whose operands name SIMD&FP registers: INS (to a lane),
// UMOV (a W / X from an S / D lane), the scalar DUP (a B / H / S / D from a lane), or
// ORR `Vd, Vn, Vn` between whole vectors of one arrangement (any 64- or 128-bit one, as
// clang accepts; the encoding is the 8b / 16b ORR of that width).
func emitA64SimdMov(p @Parser, its a64Items) {
	if !dpExpectCount(p, its, 2) { return }
	var d a64Item = its.It[0]
	var s a64Item = its.It[1]
	if emitA64Ins(p, d, s) || emitA64Umov(p, d, s, true) { return }
	if d.Kind == IT_REG && isVecLane(s) && scalarSize(d.Cls) == s.VEl {
		simd.DupScalar(p.Asm, s.VEl, d.Reg, s.Reg, s.Lane)
		return
	}
	if sameVecArr(d, s) {
		q, _ := vecArrQ(d.VEl, d.VLanes)
		simd.Logical(p.Asm, simd.SL_ORR, q, d.Reg, s.Reg, s.Reg)
		return
	}
	setErr(p, "invalid operands for a SIMD mov")
}

// emitA64FMovTopHalf emits FMOV between an X register and `Vn.d[1]` (either direction);
// the lane must be 1.
func emitA64FMovTopHalf(p @Parser, its a64Items) {
	if !dpExpectCount(p, its, 2) { return }
	var d a64Item = its.It[0]
	var s a64Item = its.It[1]
	var toFP bool = d.Kind == IT_VREG
	var v a64Item = s
	var g a64Item = d
	if toFP {
		v = d
		g = s
	}
	if g.Kind != IT_REG || !rcIsX(g.Cls) || !isVecLane(v) || v.VEl != 3 {
		setErr(p, "fmov with a vector element takes Xd, Vn.d[1] or Vd.d[1], Xn")
		return
	}
	if v.Lane != 1 {
		setErr(p, "fmov: expected lane specifier '[1]'")
		return
	}
	isa.FMovTopHalf(p.Asm, toFP, d.Reg, s.Reg)
}
