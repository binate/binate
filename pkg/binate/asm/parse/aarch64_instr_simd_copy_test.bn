package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the Advanced SIMD copy instructions (DUP from a register, a lane and to
// a scalar; INS from a register and a lane; UMOV; SMOV; their MOV aliases) at every
// arrangement and each element size's first and last lane, and for FMOV between an X
// register and the top half `Vn.d[1]`, from clang (`clang -c -target aarch64-linux-gnu
// -march=armv8.6-a`).

func TestGoldenSimdDup() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "dup v3.8b, w4", 0x0E010C83)
	e = goldenWord(e, "dup v3.8b, v30.b[0]", 0x0E0107C3)
	e = goldenWord(e, "dup v3.8b, v30.b[15]", 0x0E1F07C3)
	e = goldenWord(e, "dup v3.16b, w4", 0x4E010C83)
	e = goldenWord(e, "dup v3.16b, v30.b[0]", 0x4E0107C3)
	e = goldenWord(e, "dup v3.16b, v30.b[15]", 0x4E1F07C3)
	e = goldenWord(e, "dup v3.4h, w4", 0x0E020C83)
	e = goldenWord(e, "dup v3.4h, v30.h[0]", 0x0E0207C3)
	e = goldenWord(e, "dup v3.4h, v30.h[7]", 0x0E1E07C3)
	e = goldenWord(e, "dup v3.8h, w4", 0x4E020C83)
	e = goldenWord(e, "dup v3.8h, v30.h[0]", 0x4E0207C3)
	e = goldenWord(e, "dup v3.8h, v30.h[7]", 0x4E1E07C3)
	e = goldenWord(e, "dup v3.2s, w4", 0x0E040C83)
	e = goldenWord(e, "dup v3.2s, v30.s[0]", 0x0E0407C3)
	e = goldenWord(e, "dup v3.2s, v30.s[3]", 0x0E1C07C3)
	e = goldenWord(e, "dup v3.4s, w4", 0x4E040C83)
	e = goldenWord(e, "dup v3.4s, v30.s[0]", 0x4E0407C3)
	e = goldenWord(e, "dup v3.4s, v30.s[3]", 0x4E1C07C3)
	e = goldenWord(e, "dup v3.2d, x4", 0x4E080C83)
	e = goldenWord(e, "dup v3.2d, v30.d[0]", 0x4E0807C3)
	e = goldenWord(e, "dup v3.2d, v30.d[1]", 0x4E1807C3)
	return e
}

func TestGoldenSimdInsUmovSmov() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "dup b5, v6.b[15]", 0x5E1F04C5)
	e = goldenWord(e, "mov b5, v6.b[1]", 0x5E0304C5)
	e = goldenWord(e, "ins v7.b[15], w8", 0x4E1F1D07)
	e = goldenWord(e, "mov v7.b[0], w8", 0x4E011D07)
	e = goldenWord(e, "ins v9.b[15], v10.b[0]", 0x6E1F0549)
	e = goldenWord(e, "ins v9.b[0], v10.b[15]", 0x6E017D49)
	e = goldenWord(e, "mov v9.b[1], v10.b[1]", 0x6E030D49)
	e = goldenWord(e, "umov w11, v12.b[15]", 0x0E1F3D8B)
	e = goldenWord(e, "dup h5, v6.h[7]", 0x5E1E04C5)
	e = goldenWord(e, "mov h5, v6.h[1]", 0x5E0604C5)
	e = goldenWord(e, "ins v7.h[7], w8", 0x4E1E1D07)
	e = goldenWord(e, "mov v7.h[0], w8", 0x4E021D07)
	e = goldenWord(e, "ins v9.h[7], v10.h[0]", 0x6E1E0549)
	e = goldenWord(e, "ins v9.h[0], v10.h[7]", 0x6E027549)
	e = goldenWord(e, "mov v9.h[1], v10.h[1]", 0x6E061549)
	e = goldenWord(e, "umov w11, v12.h[7]", 0x0E1E3D8B)
	e = goldenWord(e, "dup s5, v6.s[3]", 0x5E1C04C5)
	e = goldenWord(e, "mov s5, v6.s[1]", 0x5E0C04C5)
	e = goldenWord(e, "ins v7.s[3], w8", 0x4E1C1D07)
	e = goldenWord(e, "mov v7.s[0], w8", 0x4E041D07)
	e = goldenWord(e, "ins v9.s[3], v10.s[0]", 0x6E1C0549)
	e = goldenWord(e, "ins v9.s[0], v10.s[3]", 0x6E046549)
	e = goldenWord(e, "mov v9.s[1], v10.s[1]", 0x6E0C2549)
	e = goldenWord(e, "umov w11, v12.s[3]", 0x0E1C3D8B)
	e = goldenWord(e, "dup d5, v6.d[1]", 0x5E1804C5)
	e = goldenWord(e, "mov d5, v6.d[1]", 0x5E1804C5)
	e = goldenWord(e, "ins v7.d[1], x8", 0x4E181D07)
	e = goldenWord(e, "mov v7.d[0], x8", 0x4E081D07)
	e = goldenWord(e, "ins v9.d[1], v10.d[0]", 0x6E180549)
	e = goldenWord(e, "ins v9.d[0], v10.d[1]", 0x6E084549)
	e = goldenWord(e, "mov v9.d[1], v10.d[1]", 0x6E184549)
	e = goldenWord(e, "umov x11, v12.d[1]", 0x4E183D8B)
	e = goldenWord(e, "smov x13, v14.b[15]", 0x4E1F2DCD)
	e = goldenWord(e, "smov w13, v14.b[0]", 0x0E012DCD)
	e = goldenWord(e, "smov x13, v14.h[7]", 0x4E1E2DCD)
	e = goldenWord(e, "smov w13, v14.h[0]", 0x0E022DCD)
	e = goldenWord(e, "smov x13, v14.s[3]", 0x4E1C2DCD)
	return e
}

func TestGoldenSimdCopyMisc() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "mov w0, v1.s[3]", 0x0E1C3C20)
	e = goldenWord(e, "mov x0, v1.d[1]", 0x4E183C20)
	e = goldenWord(e, "fmov x0, v1.d[1]", 0x9EAE0020)
	e = goldenWord(e, "fmov v2.d[1], x3", 0x9EAF0062)
	e = goldenWord(e, "fmov xzr, v31.d[1]", 0x9EAE03FF)
	e = goldenWord(e, "DUP V0.4S, W1", 0x4E040C20)
	e = goldenWord(e, "dup v0.4S, w1", 0x4E040C20)
	e = goldenWord(e, "Mov V0.S[1], W1", 0x4E0C1C20)
	e = goldenWord(e, "dup v31.8h, wzr", 0x4E020FFF)
	e = goldenWord(e, "ins v0.d[1], xzr", 0x4E181FE0)
	e = goldenWord(e, "umov wzr, v1.b[0]", 0x0E013C3F)
	e = goldenWord(e, "fmov v0.d[1], xzr", 0x9EAF03E0)
	e = goldenWord(e, "dup v0.4s, v1.s[1+2]", 0x4E1C0420)
	e = goldenWord(e, "fmov x0, v1.d[1-0]", 0x9EAE0020)
	return e
}

// Operand forms clang rejects: a general-purpose register of the wrong width for the
// element, the reserved 1D and 1Q arrangements and the partial 2b / 4b / 2h ones, a lane
// on an arrangement, a lane past the element count, mismatched element sizes, SP, UMOV
// / SMOV / MOV extensions clang does not define, a MOV between scalar SIMD&FP registers
// or unequal arrangements, FMOV's lane other than [1], and malformed vector-register
// syntax.
func TestGoldenSimdCopyRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "dup v0.2d, w1")
	e = goldenReject(e, "dup v0.4s, x1")
	e = goldenReject(e, "dup v0.1d, x1")
	e = goldenReject(e, "dup v0.1d, v1.d[0]")
	e = goldenReject(e, "dup v0.4s, v1.4s[1]")
	e = goldenReject(e, "dup v0.4s, v1.s[4]")
	e = goldenReject(e, "dup v0.16b, v1.b[16]")
	e = goldenReject(e, "dup v0.8h, v1.h[8]")
	e = goldenReject(e, "dup v0.2d, v1.d[2]")
	e = goldenReject(e, "dup v0.4s, v1.h[1]")
	e = goldenReject(e, "dup v0.4s, sp")
	e = goldenReject(e, "dup v0.4s, wsp")
	e = goldenReject(e, "dup s0, v1.h[1]")
	e = goldenReject(e, "dup s0, v1.4s")
	e = goldenReject(e, "dup v0.4s, v1.4s")
	e = goldenReject(e, "dup q0, v1.q[0]")
	e = goldenReject(e, "dup v0.1q, x1")
	e = goldenReject(e, "dup v0.4s, s1")
	e = goldenReject(e, "ins v0.4s[1], w1")
	e = goldenReject(e, "ins v0.s[4], w1")
	e = goldenReject(e, "ins v0.s[1], x1")
	e = goldenReject(e, "ins v0.d[1], w1")
	e = goldenReject(e, "ins v0.s[1], v1.h[1]")
	e = goldenReject(e, "ins v0.s, w1")
	e = goldenReject(e, "ins v0.b[16], w1")
	e = goldenReject(e, "ins v0.4s, v1.4s")
	e = goldenReject(e, "mov w0, v1.h[1]")
	e = goldenReject(e, "mov w0, v1.b[1]")
	e = goldenReject(e, "mov x0, v1.s[1]")
	e = goldenReject(e, "mov w0, v1.d[1]")
	e = goldenReject(e, "umov x0, v1.s[1]")
	e = goldenReject(e, "umov w0, v1.d[1]")
	e = goldenReject(e, "umov x0, v1.b[1]")
	e = goldenReject(e, "umov w0, v1.s[4]")
	e = goldenReject(e, "smov w0, v1.s[1]")
	e = goldenReject(e, "smov x0, v1.d[1]")
	e = goldenReject(e, "smov w0, v1.d[0]")
	e = goldenReject(e, "smov w0, v1.b[16]")
	e = goldenReject(e, "smov wsp, v1.b[1]")
	e = goldenReject(e, "umov sp, v1.d[0]")
	e = goldenReject(e, "fmov v2.d[0], x3")
	e = goldenReject(e, "fmov x0, v1.d[0]")
	e = goldenReject(e, "fmov w0, v1.s[1]")
	e = goldenReject(e, "fmov v1.s[1], w0")
	e = goldenReject(e, "fmov x0, v1.d[2]")
	e = goldenReject(e, "fmov v1.2d, x0")
	e = goldenReject(e, "dup v0.3s, w1")
	e = goldenReject(e, "dup v0.4s[1], w1")
	e = goldenReject(e, "dup v0.4s, v1.s[-1]")
	e = goldenReject(e, "dup v0.4s, v1.s")
	e = goldenReject(e, "dup v0.4s, v1.s[1")
	e = goldenReject(e, "dup v32.4s, w1")
	e = goldenReject(e, "dup v0.04s, w1")
	e = goldenReject(e, "dup v0.4s w1")
	e = goldenReject(e, "mov v0.s[1], sp")
	e = goldenReject(e, "mov b0, v1.h[1]")
	e = goldenReject(e, "dup v0.4s, v1.s[#1]")
	e = goldenReject(e, "dup v0.4s, v1.4b[1]")
	e = goldenReject(e, "dup v0.4s, v1.8b[1]")
	e = goldenReject(e, "dup v0.4b, w1")
	e = goldenReject(e, "dup v0.2h, w1")
	e = goldenReject(e, "ins v0.4b[1], w1")
	e = goldenReject(e, "umov w0, v1.2h[1]")
	e = goldenReject(e, "mov d0, d1")
	e = goldenReject(e, "mov s0, w1")
	e = goldenReject(e, "mov x0, d1")
	e = goldenReject(e, "mov v0.d[1], d1")
	e = goldenReject(e, "mov v0.2b, v1.2b")
	e = goldenReject(e, "mov v0.4b[1], v1.4b[1]")
	e = goldenReject(e, "mov v0.4s, v1.2d")
	return e
}
