package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 cryptographic instructions — AES, SHA-1 / SHA-256, SHA-512, SHA-3, SM3 and SM4 —
// each with one operand shape: AESE / AESD / AESMC / AESIMC `Vd.16b, Vn.16b`; SHA1C /
// SHA1P / SHA1M `Qd, Sn, Vm.4s`; SHA1H `Sd, Sn`; SHA256H / SHA256H2 `Qd, Qn, Vm.4s`;
// SHA512H / SHA512H2 `Qd, Qn, Vm.2d`; SHA1SU0 / SHA1SU1 / SHA256SU0 / SHA256SU1 /
// SM3PARTW1 / SM3PARTW2 / SM4E / SM4EKEY and SHA512SU0 / SHA512SU1 / RAX1 on 4s and 2d
// vectors; EOR3 / BCAX `Vd.16b, Vn.16b, Vm.16b, Va.16b`; SM3SS1 `Vd.4s, Vn.4s, Vm.4s,
// Va.4s`; XAR `Vd.2d, Vn.2d, Vm.2d, #imm6`; and SM3TT1A / SM3TT1B / SM3TT2A / SM3TT2B
// `Vd.4s, Vn.4s, Vm.s[imm2]`.  (PMULL / PMULL2 of 1q are three-different instructions.)

// simdCryptoOf returns a mnemonic's simd.CR_* operation (-1 for XAR and SM3TT<x>), its
// simd.SM3TT_* operation (-1 for all but SM3TT<x>) and its operand shape: a character per
// operand — b / s / d a 16b / 4s / 2d vector, Q / S a Q / S register, L an S element, i
// an immediate — or "" when the mnemonic is none of this file's.
func simdCryptoOf(m *[]readonly char) (int, int, *[]readonly char) {
	if mnemIs(m, "aese") { return simd.CR_AESE, -1, "bb" }
	if mnemIs(m, "aesd") { return simd.CR_AESD, -1, "bb" }
	if mnemIs(m, "aesmc") { return simd.CR_AESMC, -1, "bb" }
	if mnemIs(m, "aesimc") { return simd.CR_AESIMC, -1, "bb" }
	if mnemIs(m, "sha1h") { return simd.CR_SHA1H, -1, "SS" }
	if mnemIs(m, "sha1su1") { return simd.CR_SHA1SU1, -1, "ss" }
	if mnemIs(m, "sha256su0") { return simd.CR_SHA256SU0, -1, "ss" }
	if mnemIs(m, "sha512su0") { return simd.CR_SHA512SU0, -1, "dd" }
	if mnemIs(m, "sm4e") { return simd.CR_SM4E, -1, "ss" }
	if mnemIs(m, "sha1c") { return simd.CR_SHA1C, -1, "QSs" }
	if mnemIs(m, "sha1p") { return simd.CR_SHA1P, -1, "QSs" }
	if mnemIs(m, "sha1m") { return simd.CR_SHA1M, -1, "QSs" }
	if mnemIs(m, "sha1su0") { return simd.CR_SHA1SU0, -1, "sss" }
	if mnemIs(m, "sha256h") { return simd.CR_SHA256H, -1, "QQs" }
	if mnemIs(m, "sha256h2") { return simd.CR_SHA256H2, -1, "QQs" }
	if mnemIs(m, "sha256su1") { return simd.CR_SHA256SU1, -1, "sss" }
	if mnemIs(m, "sha512h") { return simd.CR_SHA512H, -1, "QQd" }
	if mnemIs(m, "sha512h2") { return simd.CR_SHA512H2, -1, "QQd" }
	if mnemIs(m, "sha512su1") { return simd.CR_SHA512SU1, -1, "ddd" }
	if mnemIs(m, "rax1") { return simd.CR_RAX1, -1, "ddd" }
	if mnemIs(m, "sm3partw1") { return simd.CR_SM3PARTW1, -1, "sss" }
	if mnemIs(m, "sm3partw2") { return simd.CR_SM3PARTW2, -1, "sss" }
	if mnemIs(m, "sm4ekey") { return simd.CR_SM4EKEY, -1, "sss" }
	if mnemIs(m, "eor3") { return simd.CR_EOR3, -1, "bbbb" }
	if mnemIs(m, "bcax") { return simd.CR_BCAX, -1, "bbbb" }
	if mnemIs(m, "sm3ss1") { return simd.CR_SM3SS1, -1, "ssss" }
	if mnemIs(m, "xar") { return -1, -1, "dddi" }
	if mnemIs(m, "sm3tt1a") { return -1, simd.SM3TT_1A, "ssL" }
	if mnemIs(m, "sm3tt1b") { return -1, simd.SM3TT_1B, "ssL" }
	if mnemIs(m, "sm3tt2a") { return -1, simd.SM3TT_2A, "ssL" }
	if mnemIs(m, "sm3tt2b") { return -1, simd.SM3TT_2B, "ssL" }
	return -1, -1, ""
}

// cryptoOperandIs reports whether item it has shape character c.
func cryptoOperandIs(it a64Item, c char) bool {
	if c == 'b' { return vecArrIs(it, 0, 16) }
	if c == 's' { return vecArrIs(it, 2, 4) }
	if c == 'd' { return vecArrIs(it, 3, 2) }
	if c == 'Q' { return it.Kind == IT_REG && it.Cls == RC_Q }
	if c == 'S' { return it.Kind == IT_REG && it.Cls == RC_S }
	if c == 'L' { return isVecLane(it) && it.VEl == 2 }
	return it.Kind == IT_IMM
}

// emitA64SimdCrypto parses and emits a cryptographic instruction (l positioned just after
// the mnemonic); returns false for any other mnemonic.
func emitA64SimdCrypto(p @Parser, l Lexer, mnem *[]readonly char) bool {
	op, tt, shape := simdCryptoOf(mnem)
	if len(shape) == 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok || !dpExpectCount(p, its, len(shape)) { return true }
	for i := 0; i < len(shape); i++ {
		if !cryptoOperandIs(its.It[i], shape[i]) {
			setErr(p, "the operands do not have this instruction's shape")
			return true
		}
	}
	var r0 int = its.It[0].Reg
	var r1 int = its.It[1].Reg
	if len(shape) == 2 {
		simd.Crypto2(p.Asm, op, r0, r1)
	} else if tt >= 0 {
		simd.Sm3tt(p.Asm, tt, r0, r1, its.It[2].Reg, its.It[2].Lane)
	} else if op < 0 {
		var imm a64Item = its.It[3]
		if !intFits(imm.Imm) {
			setErr(p, "xar: the rotation is 0..63")
			return true
		}
		simd.Xar(p.Asm, r0, r1, its.It[2].Reg, cast(int, imm.Imm))
	} else if len(shape) == 3 {
		simd.Crypto3(p.Asm, op, r0, r1, its.It[2].Reg)
	} else {
		simd.Crypto4(p.Asm, op, r0, r1, its.It[2].Reg, its.It[3].Reg)
	}
	return true
}
