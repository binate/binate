	e = goldenReject(e, "sm4ekey v5.4s, v18.4s, v2.2d")
	e = goldenReject(e, "sm4ekey v5.4s, v18.4s, v2.2s")
	e = goldenReject(e, "sm4ekey v5.4s, v18.4s, q2")
	e = goldenReject(e, "sm4ekey v5.4s, v18.4s, v2.s[1]")
	e = goldenReject(e, "sm4ekey v5.4s, v18.4s")
	e = goldenReject(e, "sm4ekey v5.4s, v18.4s, v2.4s, v9.4s")
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, #64")
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, #-1")
	e = goldenReject(e, "sm3tt1a v5.4s, v18.4s, v2.s[4]")
	e = goldenReject(e, "sm3tt1a v5.4s, v18.4s, v2.s[-1]")
	e = goldenReject(e, "sm3tt1b v5.4s, v18.4s, v2.s[4]")
	e = goldenReject(e, "sm3tt1b v5.4s, v18.4s, v2.s[-1]")
	e = goldenReject(e, "sm3tt2a v5.4s, v18.4s, v2.s[4]")
	e = goldenReject(e, "sm3tt2a v5.4s, v18.4s, v2.s[-1]")
	e = goldenReject(e, "sm3tt2b v5.4s, v18.4s, v2.s[4]")
	e = goldenReject(e, "sm3tt2b v5.4s, v18.4s, v2.s[-1]")
	return e
}

// XAR immediates that are not a number in 0..63: symbols, `.`, a relocation operator, and
// a value past 32 bits.
func TestGoldenSimdCryptoRejectSmXarImm() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, #sym")
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, sym")
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, .")
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, #:lo12:sym")
	e = goldenReject(e, "xar v5.2d, v18.2d, v2.2d, #0x100000001")
	return e
}
