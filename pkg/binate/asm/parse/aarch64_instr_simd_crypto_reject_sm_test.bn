package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// SHA-512, SHA-3, SM3 and SM4 lines clang rejects: each operand in turn given a
// neighbouring shape (another arrangement, a 64-bit vector, a Q / S / D register, an
// element), one operand short or extra, XAR's rotation past 0..63, and SM3TT<x>'s index
// past 0..3.

func TestGoldenSimdCryptoRejectSm1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sha512h v5.16b, q18, v2.2d")
	e = goldenReject(e, "sha512h s5, q18, v2.2d")
	e = goldenReject(e, "sha512h d5, q18, v2.2d")
	e = goldenReject(e, "sha512h q5, v18.16b, v2.2d")
	e = goldenReject(e, "sha512h q5, s18, v2.2d")
	e = goldenReject(e, "sha512h q5, d18, v2.2d")
	e = goldenReject(e, "sha512h q5, q18, v2.4s")
	e = goldenReject(e, "sha512h q5, q18, v2.1q")
	e = goldenReject(e, "sha512h q5, q18, q2")
	e = goldenReject(e, "sha512h q5, q18, v2.d[1]")
	e = goldenReject(e, "sha512h q5, q18")
	e = goldenReject(e, "sha512h q5, q18, v2.2d, v9.4s")
	e = goldenReject(e, "sha512h2 v5.16b, q18, v2.2d")
	e = goldenReject(e, "sha512h2 s5, q18, v2.2d")
	e = goldenReject(e, "sha512h2 d5, q18, v2.2d")
	e = goldenReject(e, "sha512h2 q5, v18.16b, v2.2d")
	e = goldenReject(e, "sha512h2 q5, s18, v2.2d")
	e = goldenReject(e, "sha512h2 q5, d18, v2.2d")
	e = goldenReject(e, "sha512h2 q5, q18, v2.4s")
	e = goldenReject(e, "sha512h2 q5, q18, v2.1q")
	e = goldenReject(e, "sha512h2 q5, q18, q2")
	e = goldenReject(e, "sha512h2 q5, q18, v2.d[1]")
	e = goldenReject(e, "sha512h2 q5, q18")
	e = goldenReject(e, "sha512h2 q5, q18, v2.2d, v9.4s")
	e = goldenReject(e, "sha512su0 v5.4s, v18.2d")
	e = goldenReject(e, "sha512su0 v5.1q, v18.2d")
	e = goldenReject(e, "sha512su0 q5, v18.2d")
	e = goldenReject(e, "sha512su0 v5.d[1], v18.2d")
	e = goldenReject(e, "sha512su0 v5.2d, v18.4s")
	e = goldenReject(e, "sha512su0 v5.2d, v18.1q")
	e = goldenReject(e, "sha512su0 v5.2d, q18")
	e = goldenReject(e, "sha512su0 v5.2d, v18.d[1]")
	e = goldenReject(e, "sha512su0 v5.2d")
	e = goldenReject(e, "sha512su0 v5.2d, v18.2d, v2.4s")
	e = goldenReject(e, "sha512su1 v5.4s, v18.2d, v2.2d")
	e = goldenReject(e, "sha512su1 v5.1q, v18.2d, v2.2d")
	e = goldenReject(e, "sha512su1 q5, v18.2d, v2.2d")
	e = goldenReject(e, "sha512su1 v5.d[1], v18.2d, v2.2d")
	e = goldenReject(e, "sha512su1 v5.2d, v18.4s, v2.2d")
	e = goldenReject(e, "sha512su1 v5.2d, v18.1q, v2.2d")
	e = goldenReject(e, "sha512su1 v5.2d, q18, v2.2d")
	e = goldenReject(e, "sha512su1 v5.2d, v18.d[1], v2.2d")
	e = goldenReject(e, "sha512su1 v5.2d, v18.2d, v2.4s")
	e = goldenReject(e, "sha512su1 v5.2d, v18.2d, v2.1q")
	e = goldenReject(e, "sha512su1 v5.2d, v18.2d, q2")
	e = goldenReject(e, "sha512su1 v5.2d, v18.2d, v2.d[1]")
	e = goldenReject(e, "sha512su1 v5.2d, v18.2d")
	e = goldenReject(e, "sha512su1 v5.2d, v18.2d, v2.2d, v9.4s")
	e = goldenReject(e, "eor3 v5.4s, v18.16b, v2.16b, v9.16b")
	e = goldenReject(e, "eor3 v5.8b, v18.16b, v2.16b, v9.16b")
	return e
}

