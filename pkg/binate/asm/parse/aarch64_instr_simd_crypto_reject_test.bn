func TestGoldenSimdCryptoReject4() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sha256su1 v5.4s, v18.4s, v2.2d")
	e = goldenReject(e, "sha256su1 v5.4s, v18.4s, v2.2s")
	e = goldenReject(e, "sha256su1 v5.4s, v18.4s, q2")
	e = goldenReject(e, "sha256su1 v5.4s, v18.4s, v2.s[1]")
	e = goldenReject(e, "sha256su1 v5.4s, v18.4s")
	e = goldenReject(e, "sha256su1 v5.4s, v18.4s, v2.4s, v9.4s")
	return e
}
