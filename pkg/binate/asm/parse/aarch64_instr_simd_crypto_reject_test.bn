package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AES, SHA-1 and SHA-256 lines clang rejects: each operand in turn given a neighbouring
// shape (another arrangement, a 64-bit vector, a Q / S / D register, an element), and one
// operand short or extra.

func TestGoldenSimdCryptoReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "aese v5.4s, v18.16b")
	e = goldenReject(e, "aese v5.8b, v18.16b")
	e = goldenReject(e, "aese q5, v18.16b")
	e = goldenReject(e, "aese v5.s[1], v18.16b")
	e = goldenReject(e, "aese v5.16b, v18.4s")
	e = goldenReject(e, "aese v5.16b, v18.8b")
	e = goldenReject(e, "aese v5.16b, q18")
	e = goldenReject(e, "aese v5.16b, v18.s[1]")
	e = goldenReject(e, "aese v5.16b")
	e = goldenReject(e, "aese v5.16b, v18.16b, v2.4s")
	e = goldenReject(e, "aesd v5.4s, v18.16b")
	e = goldenReject(e, "aesd v5.8b, v18.16b")
	e = goldenReject(e, "aesd q5, v18.16b")
	e = goldenReject(e, "aesd v5.s[1], v18.16b")
	e = goldenReject(e, "aesd v5.16b, v18.4s")
	e = goldenReject(e, "aesd v5.16b, v18.8b")
	e = goldenReject(e, "aesd v5.16b, q18")
	e = goldenReject(e, "aesd v5.16b, v18.s[1]")
	e = goldenReject(e, "aesd v5.16b")
	e = goldenReject(e, "aesd v5.16b, v18.16b, v2.4s")
	e = goldenReject(e, "aesmc v5.4s, v18.16b")
	e = goldenReject(e, "aesmc v5.8b, v18.16b")
	e = goldenReject(e, "aesmc q5, v18.16b")
	e = goldenReject(e, "aesmc v5.s[1], v18.16b")
	e = goldenReject(e, "aesmc v5.16b, v18.4s")
	e = goldenReject(e, "aesmc v5.16b, v18.8b")
	e = goldenReject(e, "aesmc v5.16b, q18")
	e = goldenReject(e, "aesmc v5.16b, v18.s[1]")
	e = goldenReject(e, "aesmc v5.16b")
	e = goldenReject(e, "aesmc v5.16b, v18.16b, v2.4s")
	e = goldenReject(e, "aesimc v5.4s, v18.16b")
	e = goldenReject(e, "aesimc v5.8b, v18.16b")
	e = goldenReject(e, "aesimc q5, v18.16b")
	e = goldenReject(e, "aesimc v5.s[1], v18.16b")
	e = goldenReject(e, "aesimc v5.16b, v18.4s")
	e = goldenReject(e, "aesimc v5.16b, v18.8b")
	e = goldenReject(e, "aesimc v5.16b, q18")
	e = goldenReject(e, "aesimc v5.16b, v18.s[1]")
	e = goldenReject(e, "aesimc v5.16b")
	e = goldenReject(e, "aesimc v5.16b, v18.16b, v2.4s")
	e = goldenReject(e, "sha1c v5.16b, s18, v2.4s")
	e = goldenReject(e, "sha1c s5, s18, v2.4s")
	e = goldenReject(e, "sha1c d5, s18, v2.4s")
	e = goldenReject(e, "sha1c q5, q18, v2.4s")
	e = goldenReject(e, "sha1c q5, d18, v2.4s")
	e = goldenReject(e, "sha1c q5, v18.4s, v2.4s")
	e = goldenReject(e, "sha1c q5, s18, v2.2d")
	e = goldenReject(e, "sha1c q5, s18, v2.2s")
	e = goldenReject(e, "sha1c q5, s18, q2")
	e = goldenReject(e, "sha1c q5, s18, v2.s[1]")
	return e
}

func TestGoldenSimdCryptoReject2() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sha1c q5, s18")
	e = goldenReject(e, "sha1c q5, s18, v2.4s, v9.4s")
	e = goldenReject(e, "sha1p v5.16b, s18, v2.4s")
	e = goldenReject(e, "sha1p s5, s18, v2.4s")
	e = goldenReject(e, "sha1p d5, s18, v2.4s")
	e = goldenReject(e, "sha1p q5, q18, v2.4s")
	e = goldenReject(e, "sha1p q5, d18, v2.4s")
	e = goldenReject(e, "sha1p q5, v18.4s, v2.4s")
	e = goldenReject(e, "sha1p q5, s18, v2.2d")
	e = goldenReject(e, "sha1p q5, s18, v2.2s")
	e = goldenReject(e, "sha1p q5, s18, q2")
	e = goldenReject(e, "sha1p q5, s18, v2.s[1]")
	e = goldenReject(e, "sha1p q5, s18")
	e = goldenReject(e, "sha1p q5, s18, v2.4s, v9.4s")
	e = goldenReject(e, "sha1m v5.16b, s18, v2.4s")
	e = goldenReject(e, "sha1m s5, s18, v2.4s")
	e = goldenReject(e, "sha1m d5, s18, v2.4s")
	e = goldenReject(e, "sha1m q5, q18, v2.4s")
	e = goldenReject(e, "sha1m q5, d18, v2.4s")
	e = goldenReject(e, "sha1m q5, v18.4s, v2.4s")
	e = goldenReject(e, "sha1m q5, s18, v2.2d")
	e = goldenReject(e, "sha1m q5, s18, v2.2s")
	e = goldenReject(e, "sha1m q5, s18, q2")
	e = goldenReject(e, "sha1m q5, s18, v2.s[1]")
	e = goldenReject(e, "sha1m q5, s18")
	e = goldenReject(e, "sha1m q5, s18, v2.4s, v9.4s")
	e = goldenReject(e, "sha1su0 v5.2d, v18.4s, v2.4s")
	e = goldenReject(e, "sha1su0 v5.2s, v18.4s, v2.4s")
	e = goldenReject(e, "sha1su0 q5, v18.4s, v2.4s")
	e = goldenReject(e, "sha1su0 v5.s[1], v18.4s, v2.4s")
	e = goldenReject(e, "sha1su0 v5.4s, v18.2d, v2.4s")
	e = goldenReject(e, "sha1su0 v5.4s, v18.2s, v2.4s")
	e = goldenReject(e, "sha1su0 v5.4s, q18, v2.4s")
	e = goldenReject(e, "sha1su0 v5.4s, v18.s[1], v2.4s")
	e = goldenReject(e, "sha1su0 v5.4s, v18.4s, v2.2d")
	e = goldenReject(e, "sha1su0 v5.4s, v18.4s, v2.2s")
	e = goldenReject(e, "sha1su0 v5.4s, v18.4s, q2")
	e = goldenReject(e, "sha1su0 v5.4s, v18.4s, v2.s[1]")
	e = goldenReject(e, "sha1su0 v5.4s, v18.4s")
	e = goldenReject(e, "sha1su0 v5.4s, v18.4s, v2.4s, v9.4s")
	e = goldenReject(e, "sha1h q5, s18")
	e = goldenReject(e, "sha1h d5, s18")
	e = goldenReject(e, "sha1h v5.4s, s18")
	e = goldenReject(e, "sha1h s5, q18")
	e = goldenReject(e, "sha1h s5, d18")
	e = goldenReject(e, "sha1h s5, v18.4s")
	e = goldenReject(e, "sha1h s5")
	e = goldenReject(e, "sha1h s5, s18, v2.4s")
	e = goldenReject(e, "sha1su1 v5.2d, v18.4s")
	e = goldenReject(e, "sha1su1 v5.2s, v18.4s")
	return e
}

func TestGoldenSimdCryptoReject3() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "sha1su1 q5, v18.4s")
