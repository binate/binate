package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the cryptographic instructions — each at its shape with three register
// assignments (v0 / v31 in every field), XAR at every edge of its rotation, and SM3TT<x>
// at every index — from clang (`clang -c -target aarch64-linux-gnu
// -march=armv9.5-a+aes+sha2+sha3+sm4`).

func TestGoldenSimdCrypto1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "aese v5.16b, v18.16b", 0x4E284A45)
	e = goldenWord(e, "aese v31.16b, v0.16b", 0x4E28481F)
	e = goldenWord(e, "aese v0.16b, v31.16b", 0x4E284BE0)
	e = goldenWord(e, "aesd v5.16b, v18.16b", 0x4E285A45)
	e = goldenWord(e, "aesd v31.16b, v0.16b", 0x4E28581F)
	e = goldenWord(e, "aesd v0.16b, v31.16b", 0x4E285BE0)
	e = goldenWord(e, "aesmc v5.16b, v18.16b", 0x4E286A45)
	e = goldenWord(e, "aesmc v31.16b, v0.16b", 0x4E28681F)
	e = goldenWord(e, "aesmc v0.16b, v31.16b", 0x4E286BE0)
	e = goldenWord(e, "aesimc v5.16b, v18.16b", 0x4E287A45)
	e = goldenWord(e, "aesimc v31.16b, v0.16b", 0x4E28781F)
	e = goldenWord(e, "aesimc v0.16b, v31.16b", 0x4E287BE0)
	e = goldenWord(e, "sha1c q5, s18, v2.4s", 0x5E020245)
	e = goldenWord(e, "sha1c q31, s0, v31.4s", 0x5E1F001F)
	e = goldenWord(e, "sha1c q0, s31, v0.4s", 0x5E0003E0)
	e = goldenWord(e, "sha1p q5, s18, v2.4s", 0x5E021245)
	e = goldenWord(e, "sha1p q31, s0, v31.4s", 0x5E1F101F)
	e = goldenWord(e, "sha1p q0, s31, v0.4s", 0x5E0013E0)
	e = goldenWord(e, "sha1m q5, s18, v2.4s", 0x5E022245)
	e = goldenWord(e, "sha1m q31, s0, v31.4s", 0x5E1F201F)
	e = goldenWord(e, "sha1m q0, s31, v0.4s", 0x5E0023E0)
	e = goldenWord(e, "sha1su0 v5.4s, v18.4s, v2.4s", 0x5E023245)
	e = goldenWord(e, "sha1su0 v31.4s, v0.4s, v31.4s", 0x5E1F301F)
	e = goldenWord(e, "sha1su0 v0.4s, v31.4s, v0.4s", 0x5E0033E0)
	e = goldenWord(e, "sha1h s5, s18", 0x5E280A45)
	e = goldenWord(e, "sha1h s31, s0", 0x5E28081F)
	e = goldenWord(e, "sha1h s0, s31", 0x5E280BE0)
	e = goldenWord(e, "sha1su1 v5.4s, v18.4s", 0x5E281A45)
	e = goldenWord(e, "sha1su1 v31.4s, v0.4s", 0x5E28181F)
	e = goldenWord(e, "sha1su1 v0.4s, v31.4s", 0x5E281BE0)
	e = goldenWord(e, "sha256h q5, q18, v2.4s", 0x5E024245)
	e = goldenWord(e, "sha256h q31, q0, v31.4s", 0x5E1F401F)
	e = goldenWord(e, "sha256h q0, q31, v0.4s", 0x5E0043E0)
	e = goldenWord(e, "sha256h2 q5, q18, v2.4s", 0x5E025245)
	e = goldenWord(e, "sha256h2 q31, q0, v31.4s", 0x5E1F501F)
	e = goldenWord(e, "sha256h2 q0, q31, v0.4s", 0x5E0053E0)
	e = goldenWord(e, "sha256su0 v5.4s, v18.4s", 0x5E282A45)
	e = goldenWord(e, "sha256su0 v31.4s, v0.4s", 0x5E28281F)
	e = goldenWord(e, "sha256su0 v0.4s, v31.4s", 0x5E282BE0)
	e = goldenWord(e, "sha256su1 v5.4s, v18.4s, v2.4s", 0x5E026245)
	e = goldenWord(e, "sha256su1 v31.4s, v0.4s, v31.4s", 0x5E1F601F)
	e = goldenWord(e, "sha256su1 v0.4s, v31.4s, v0.4s", 0x5E0063E0)
	e = goldenWord(e, "sha512h q5, q18, v2.2d", 0xCE628245)
	e = goldenWord(e, "sha512h q31, q0, v31.2d", 0xCE7F801F)
	e = goldenWord(e, "sha512h q0, q31, v0.2d", 0xCE6083E0)
	e = goldenWord(e, "sha512h2 q5, q18, v2.2d", 0xCE628645)
	e = goldenWord(e, "sha512h2 q31, q0, v31.2d", 0xCE7F841F)
	e = goldenWord(e, "sha512h2 q0, q31, v0.2d", 0xCE6087E0)
	e = goldenWord(e, "sha512su0 v5.2d, v18.2d", 0xCEC08245)
	e = goldenWord(e, "sha512su0 v31.2d, v0.2d", 0xCEC0801F)
	return e
}

func TestGoldenSimdCrypto2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "sha512su0 v0.2d, v31.2d", 0xCEC083E0)
	e = goldenWord(e, "sha512su1 v5.2d, v18.2d, v2.2d", 0xCE628A45)
	e = goldenWord(e, "sha512su1 v31.2d, v0.2d, v31.2d", 0xCE7F881F)
	e = goldenWord(e, "sha512su1 v0.2d, v31.2d, v0.2d", 0xCE608BE0)
	e = goldenWord(e, "eor3 v5.16b, v18.16b, v2.16b, v9.16b", 0xCE022645)
	e = goldenWord(e, "eor3 v31.16b, v0.16b, v31.16b, v0.16b", 0xCE1F001F)
	e = goldenWord(e, "eor3 v0.16b, v31.16b, v0.16b, v31.16b", 0xCE007FE0)
	e = goldenWord(e, "bcax v5.16b, v18.16b, v2.16b, v9.16b", 0xCE222645)
	e = goldenWord(e, "bcax v31.16b, v0.16b, v31.16b, v0.16b", 0xCE3F001F)
	e = goldenWord(e, "bcax v0.16b, v31.16b, v0.16b, v31.16b", 0xCE207FE0)
	e = goldenWord(e, "rax1 v5.2d, v18.2d, v2.2d", 0xCE628E45)
	e = goldenWord(e, "rax1 v31.2d, v0.2d, v31.2d", 0xCE7F8C1F)
	e = goldenWord(e, "rax1 v0.2d, v31.2d, v0.2d", 0xCE608FE0)
	e = goldenWord(e, "xar v5.2d, v18.2d, v2.2d, #1", 0xCE820645)
	e = goldenWord(e, "xar v31.2d, v0.2d, v31.2d, #1", 0xCE9F041F)
	e = goldenWord(e, "xar v0.2d, v31.2d, v0.2d, #1", 0xCE8007E0)
	e = goldenWord(e, "sm3ss1 v5.4s, v18.4s, v2.4s, v9.4s", 0xCE422645)
	e = goldenWord(e, "sm3ss1 v31.4s, v0.4s, v31.4s, v0.4s", 0xCE5F001F)
	e = goldenWord(e, "sm3ss1 v0.4s, v31.4s, v0.4s, v31.4s", 0xCE407FE0)
	e = goldenWord(e, "sm3tt1a v5.4s, v18.4s, v2.s[1]", 0xCE429245)
	e = goldenWord(e, "sm3tt1a v31.4s, v0.4s, v31.s[1]", 0xCE5F901F)
	e = goldenWord(e, "sm3tt1a v0.4s, v31.4s, v0.s[1]", 0xCE4093E0)
	e = goldenWord(e, "sm3tt1b v5.4s, v18.4s, v2.s[1]", 0xCE429645)
	e = goldenWord(e, "sm3tt1b v31.4s, v0.4s, v31.s[1]", 0xCE5F941F)
	e = goldenWord(e, "sm3tt1b v0.4s, v31.4s, v0.s[1]", 0xCE4097E0)
	e = goldenWord(e, "sm3tt2a v5.4s, v18.4s, v2.s[1]", 0xCE429A45)
	e = goldenWord(e, "sm3tt2a v31.4s, v0.4s, v31.s[1]", 0xCE5F981F)
	e = goldenWord(e, "sm3tt2a v0.4s, v31.4s, v0.s[1]", 0xCE409BE0)
	e = goldenWord(e, "sm3tt2b v5.4s, v18.4s, v2.s[1]", 0xCE429E45)
	e = goldenWord(e, "sm3tt2b v31.4s, v0.4s, v31.s[1]", 0xCE5F9C1F)
	e = goldenWord(e, "sm3tt2b v0.4s, v31.4s, v0.s[1]", 0xCE409FE0)
	e = goldenWord(e, "sm3partw1 v5.4s, v18.4s, v2.4s", 0xCE62C245)
	e = goldenWord(e, "sm3partw1 v31.4s, v0.4s, v31.4s", 0xCE7FC01F)
	e = goldenWord(e, "sm3partw1 v0.4s, v31.4s, v0.4s", 0xCE60C3E0)
	e = goldenWord(e, "sm3partw2 v5.4s, v18.4s, v2.4s", 0xCE62C645)
	e = goldenWord(e, "sm3partw2 v31.4s, v0.4s, v31.4s", 0xCE7FC41F)
	e = goldenWord(e, "sm3partw2 v0.4s, v31.4s, v0.4s", 0xCE60C7E0)
	e = goldenWord(e, "sm4e v5.4s, v18.4s", 0xCEC08645)
	e = goldenWord(e, "sm4e v31.4s, v0.4s", 0xCEC0841F)
	e = goldenWord(e, "sm4e v0.4s, v31.4s", 0xCEC087E0)
	e = goldenWord(e, "sm4ekey v5.4s, v18.4s, v2.4s", 0xCE62CA45)
	e = goldenWord(e, "sm4ekey v31.4s, v0.4s, v31.4s", 0xCE7FC81F)
	e = goldenWord(e, "sm4ekey v0.4s, v31.4s, v0.4s", 0xCE60CBE0)
	e = goldenWord(e, "xar v5.2d, v18.2d, v2.2d, #0", 0xCE820245)
	e = goldenWord(e, "xar v5.2d, v18.2d, v2.2d, #32", 0xCE828245)
	e = goldenWord(e, "xar v5.2d, v18.2d, v2.2d, #63", 0xCE82FE45)
	e = goldenWord(e, "xar v5.2d, v18.2d, v2.2d, 7", 0xCE821E45)
	e = goldenWord(e, "xar v5.2d, v18.2d, v2.2d, #(1+2)", 0xCE820E45)
	e = goldenWord(e, "sm3tt1a v5.4s, v18.4s, v2.s[0]", 0xCE428245)
	e = goldenWord(e, "sm3tt1a v5.4s, v18.4s, v2.s[2]", 0xCE42A245)
	return e
}

func TestGoldenSimdCrypto3() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "sm3tt1a v5.4s, v18.4s, v2.s[3]", 0xCE42B245)
	e = goldenWord(e, "sm3tt1a v5.4s, v18.4s, v31.s[3]", 0xCE5FB245)
	e = goldenWord(e, "sm3tt1b v5.4s, v18.4s, v2.s[0]", 0xCE428645)
	e = goldenWord(e, "sm3tt1b v5.4s, v18.4s, v2.s[2]", 0xCE42A645)
	e = goldenWord(e, "sm3tt1b v5.4s, v18.4s, v2.s[3]", 0xCE42B645)
	e = goldenWord(e, "sm3tt1b v5.4s, v18.4s, v31.s[3]", 0xCE5FB645)
	e = goldenWord(e, "sm3tt2a v5.4s, v18.4s, v2.s[0]", 0xCE428A45)
	e = goldenWord(e, "sm3tt2a v5.4s, v18.4s, v2.s[2]", 0xCE42AA45)
	e = goldenWord(e, "sm3tt2a v5.4s, v18.4s, v2.s[3]", 0xCE42BA45)
	e = goldenWord(e, "sm3tt2a v5.4s, v18.4s, v31.s[3]", 0xCE5FBA45)
	e = goldenWord(e, "sm3tt2b v5.4s, v18.4s, v2.s[0]", 0xCE428E45)
	e = goldenWord(e, "sm3tt2b v5.4s, v18.4s, v2.s[2]", 0xCE42AE45)
	e = goldenWord(e, "sm3tt2b v5.4s, v18.4s, v2.s[3]", 0xCE42BE45)
	e = goldenWord(e, "sm3tt2b v5.4s, v18.4s, v31.s[3]", 0xCE5FBE45)
	e = goldenWord(e, "AESE V5.16B, V18.16B", 0x4E284A45)
	e = goldenWord(e, "SHA1C Q5, S18, V2.4S", 0x5E020245)
	return e
}
