package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD vector-by-element instructions (the last source one element
// `Vm.<Ts>[index]`): MLA / MLS / MUL, SQDMULH / SQRDMULH / SQRDMLAH / SQRDMLSH and FMLA /
// FMLS / FMUL / FMULX on `Vd.<T>, Vn.<T>` (and, but for MLA / MLS / MUL, as scalars `<V>d,
// <V>n`); and the long SMLAL / UMLAL / SMLSL / UMLSL / SMULL / UMULL / SQDMLAL / SQDMLSL /
// SQDMULL and their "2" forms on `Vd.<Ta>, Vn.<Tb>` (the SQDM* also as scalars `Sd, Hn` /
// `Dd, Sn`).  Every mnemonic also names a three-same or three-different instruction; those
// parsers hand a lane-indexed last source here.

// simdElemOf returns the simd.EL_* operation of a mnemonic and whether it is a long "2"
// form, or -1.
func simdElemOf(m *[]readonly char) (int, bool) {
	if mnemIs(m, "mla") { return simd.EL_MLA, false }
	if mnemIs(m, "mls") { return simd.EL_MLS, false }
	if mnemIs(m, "mul") { return simd.EL_MUL, false }
	if mnemIs(m, "sqdmulh") { return simd.EL_SQDMULH, false }
	if mnemIs(m, "sqrdmulh") { return simd.EL_SQRDMULH, false }
	if mnemIs(m, "sqrdmlah") { return simd.EL_SQRDMLAH, false }
	if mnemIs(m, "sqrdmlsh") { return simd.EL_SQRDMLSH, false }
	if mnemIs(m, "fmla") { return simd.EL_FMLA, false }
	if mnemIs(m, "fmls") { return simd.EL_FMLS, false }
	if mnemIs(m, "fmul") { return simd.EL_FMUL, false }
	if mnemIs(m, "fmulx") { return simd.EL_FMULX, false }
	var q bool = len(m) > 1 && m[len(m) - 1] == '2'
	var base *[]readonly char = m
	if q { base = m[0:len(m) - 1] }
	if mnemIs(base, "smlal") { return simd.EL_SMLAL, q }
	if mnemIs(base, "umlal") { return simd.EL_UMLAL, q }
	if mnemIs(base, "smlsl") { return simd.EL_SMLSL, q }
	if mnemIs(base, "umlsl") { return simd.EL_UMLSL, q }
	if mnemIs(base, "smull") { return simd.EL_SMULL, q }
	if mnemIs(base, "umull") { return simd.EL_UMULL, q }
	if mnemIs(base, "sqdmlal") { return simd.EL_SQDMLAL, q }
	if mnemIs(base, "sqdmlsl") { return simd.EL_SQDMLSL, q }
	if mnemIs(base, "sqdmull") { return simd.EL_SQDMULL, q }
	return -1, false
}

// elLongOp reports whether op is a long by-element operation.
func elLongOp(op int) bool {
	return op == simd.EL_SMLAL || op == simd.EL_UMLAL || op == simd.EL_SMLSL || op == simd.EL_UMLSL ||
			op == simd.EL_SMULL || op == simd.EL_UMULL || op == simd.EL_SQDMLAL || op == simd.EL_SQDMLSL ||
			op == simd.EL_SQDMULL
}

// isElemIndexed reports whether a three-operand list's last source is one element (a lane).
func isElemIndexed(its a64Items) bool {
	return its.N == 3 && isVecLane(its.It[2])
}

// emitA64SimdElemItems emits a by-element instruction from its scanned operands; returns
// false (nothing done) when mnem is not one or its last source is not a lane.
func emitA64SimdElemItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, q2 := simdElemOf(mnem)
	if op < 0 || !isElemIndexed(its) { return false }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	var esize int = m.VEl
	if d.Kind == IT_REG {
		var dsize int = scalarSize(d.Cls)
		var want int = esize
		if elLongOp(op) { want = esize + 1 }
		if q2 || n.Kind != IT_REG || scalarSize(n.Cls) != esize || dsize != want {
			setErr(p, "a scalar by-element form takes <V>d, <V>n, Vm.<Ts>[i] of matching sizes")
			return true
		}
		simd.ByElementScalar(p.Asm, op, esize, d.Reg, n.Reg, m.Reg, m.Lane)
		return true
	}
	if elLongOp(op) {
		var nl int = 8 >> esize
		if q2 { nl = 16 >> esize }
		if !vecArrIs(n, esize, nl) || !vecArrIs(d, esize + 1, 16 >> (esize + 1)) {
			setErr(p, "a long by-element form takes Vd.4s|2d, Vn.4h|2s (8h|4s for the 2 form)")
			return true
		}
		simd.ByElement(p.Asm, op, q2, esize, d.Reg, n.Reg, m.Reg, m.Lane)
		return true
	}
	if !sameVecArr(d, n) || d.VEl != esize {
		setErr(p, "expected two vectors of the indexed element's size")
		return true
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	simd.ByElement(p.Asm, op, q, esize, d.Reg, n.Reg, m.Reg, m.Lane)
	return true
}
