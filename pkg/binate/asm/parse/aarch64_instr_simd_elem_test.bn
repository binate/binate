package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the vector-by-element instructions — the same-shape and long ones at
// every shape they take, at index 1 and the largest index (and 16-bit elements at 2 and 4,
// telling H from L), with Vm v15 / v16 around the 16-bit elements' limit — and the
// three-same / three-different / FP forms beside them,
// from clang (`clang -c -target aarch64-linux-gnu -march=armv9.5-a+fp16+rdm`).

