package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD by-element dot products, widening multiply-accumulates and FCMLA:
// SDOT / UDOT / USDOT / SUDOT `Vd.2s|4s, Vn.8b|16b, Vm.4b[i]`; BFDOT `Vd.2s|4s, Vn.4h|8h,
// Vm.2h[i]`; FDOT `Vd.4h|8h, Vn.8b|16b, Vm.2b[i]` or `Vd.2s|4s, Vn.8b|16b, Vm.4b[i]`;
// FMLAL / FMLSL / FMLAL2 / FMLSL2 `Vd.2s|4s, Vn.2h|4h, Vm.h[i]`; BFMLALB / BFMLALT `Vd.4s,
// Vn.8h, Vm.h[i]`; FMLALB / FMLALT `Vd.8h, Vn.16b, Vm.b[i]` and FMLALL<xy> `Vd.4s,
// Vn.16b, Vm.b[i]`; and FCMLA `Vd.4h|8h|4s, Vn.<T>, Vm.h[i]|s[i], #rot`.  The encoders
// check the index and Vm ranges.  Every mnemonic but SUDOT also names a three-register
// instruction; those parsers hand a lane-indexed Vm here.

// isVecLaneOf reports whether item it is an indexed element of size el — a bare element
// (lanes 0) or the partial arrangement of lanes elements.
func isVecLaneOf(it a64Item, el int, lanes int) bool {
	return it.Kind == IT_VREG && it.Lane >= 0 && it.VEl == el && it.VLanes == lanes
}

// isA64SimdElemX reports whether mnem is one of this file's instructions.
func isA64SimdElemX(m *[]readonly char) bool {
	return simdDotOf(m) >= 0 || mnemIs(m, "bfdot") || mnemIs(m, "fdot") || simdFMlalOf(m) >= 0 ||
			mnemIs(m, "bfmlalb") || mnemIs(m, "bfmlalt") || mnemIs(m, "fmlalb") || mnemIs(m, "fmlalt") ||
			simdFP8MlallOf(m) >= 0 || mnemIs(m, "fcmla")
}

// emitA64SimdElemXItems emits one of this file's instructions from its scanned operands;
// returns false (nothing done) when mnem is not one or its third operand is not a lane.
func emitA64SimdElemXItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	if !isA64SimdElemX(mnem) || its.N < 3 || its.It[2].Kind != IT_VREG || its.It[2].Lane < 0 {
		return false
	}
	if mnemIs(mnem, "fcmla") {
		emitA64FCmlaElem(p, its)
		return true
	}
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	var dot int = simdDotOf(mnem)
	if dot >= 0 || mnemIs(mnem, "fdot") {
		// Into S from groups of four bytes; FDOT also into H from pairs.
		var el int = 2
		if dot < 0 && d.VEl != 2 { el = 1 }
		var q bool = vecArrIs(n, 0, 16)
		var dl int = 8 >> el
		if q { dl = 16 >> el }
		if (!q && !vecArrIs(n, 0, 8)) || !vecArrIs(d, el, dl) || !isVecLaneOf(m, 0, 2 * el) {
			setErr(p,
					"a dot product by element takes Vd.2s|4s, Vn.8b|16b, Vm.4b[i] (fdot also "
							"Vd.4h|8h, Vn.8b|16b, Vm.2b[i])")
			return true
		}
		if dot >= 0 {
			simd.DotProductElem(p.Asm, dot, q, d.Reg, n.Reg, m.Reg, m.Lane)
		} else {
			simd.FP8DotElem(p.Asm, el == 2, q, d.Reg, n.Reg, m.Reg, m.Lane)
		}
		return true
	}
	if mnemIs(mnem, "bfdot") {
		var q bool = vecArrIs(n, 1, 8)
		var dl int = 2
		if q { dl = 4 }
		if (!q && !vecArrIs(n, 1, 4)) || !vecArrIs(d, 2, dl) || !isVecLaneOf(m, 1, 2) {
			setErr(p, "bfdot by element takes Vd.2s|4s, Vn.4h|8h, Vm.2h[i]")
			return true
		}
		simd.BFDotElem(p.Asm, q, d.Reg, n.Reg, m.Reg, m.Lane)
		return true
	}
	var fhm int = simdFMlalOf(mnem)
	if fhm >= 0 {
		var q bool = vecArrIs(n, 1, 4)
		var dl int = 2
		if q { dl = 4 }
		if (!q && !vecArrIs(n, 1, 2)) || !vecArrIs(d, 2, dl) || !isVecLaneOf(m, 1, 0) {
			setErr(p, "fmlal / fmlsl by element take Vd.2s|4s, Vn.2h|4h, Vm.h[i]")
			return true
		}
		simd.FMlalElem(p.Asm, fhm, q, d.Reg, n.Reg, m.Reg, m.Lane)
		return true
	}
	if mnemIs(mnem, "bfmlalb") || mnemIs(mnem, "bfmlalt") {
		if !vecArrIs(d, 2, 4) || !vecArrIs(n, 1, 8) || !isVecLaneOf(m, 1, 0) {
			setErr(p, "bfmlalb / bfmlalt by element take Vd.4s, Vn.8h, Vm.h[i]")
			return true
		}
		simd.BFMlalElem(p.Asm, mnemIs(mnem, "bfmlalt"), d.Reg, n.Reg, m.Reg, m.Lane)
		return true
	}
	// The FP8 widening multiply-accumulates: FMLALB / FMLALT into 8h, FMLALL<xy> into 4s.
	var mlall int = simdFP8MlallOf(mnem)
	var dOk bool = vecArrIs(d, 1, 8)
	if mlall >= 0 { dOk = vecArrIs(d, 2, 4) }
	if !dOk || !vecArrIs(n, 0, 16) || !isVecLaneOf(m, 0, 0) {
		setErr(p,
				"fmlalb / fmlalt by element take Vd.8h, Vn.16b, Vm.b[i]; fmlall<xy> Vd.4s, "
						"Vn.16b, Vm.b[i]")
		return true
	}
	if mlall >= 0 {
		simd.FP8MlallElem(p.Asm, mlall, d.Reg, n.Reg, m.Reg, m.Lane)
	} else {
		simd.FP8MlalElem(p.Asm, mnemIs(mnem, "fmlalt"), d.Reg, n.Reg, m.Reg, m.Lane)
	}
	return true
}

// emitA64FCmlaElem emits FCMLA by element from its operands: two vectors of one 4h / 8h /
// 4s arrangement, an element of their size, and the rotation.
func emitA64FCmlaElem(p @Parser, its a64Items) {
	if !dpExpectCount(p, its, 4) { return }
	var d a64Item = its.It[0]
	var m a64Item = its.It[2]
	var r a64Item = its.It[3]
	if !sameVecArr(d, its.It[1]) || (d.VEl != 1 && !vecArrIs(d, 2, 4)) || !isVecLaneOf(m, d.VEl, 0) ||
			r.Kind != IT_IMM {
		setErr(p, "fcmla by element takes Vd.4h|8h|4s, Vn.<T>, Vm.h[i]|s[i], #rot")
		return
	}
	if r.Imm != 0 && r.Imm != 90 && r.Imm != 180 && r.Imm != 270 {
		setErr(p, "fcmla: the rotation is 0, 90, 180 or 270")
		return
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	simd.FCmlaElem(p.Asm, q, d.VEl, cast(int, r.Imm / 90), d.Reg, its.It[1].Reg, m.Reg, m.Lane)
}
