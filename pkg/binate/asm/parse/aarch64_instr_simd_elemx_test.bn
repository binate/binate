import "pkg/builtins/testing"

// Golden words for the by-element dot products, widening multiply-accumulates and FCMLA —
// every shape at every index, Vm at the edges of each index width's range (v7 / v8, v15 /
// v16, v31), FCMLA at every rotation, and Vn v13 / v31 — from clang (`clang -c -target
// aarch64-linux-gnu -march=armv9.5-a` with fp8, fp8fma, fp8dot2, fp8dot4, fp16fml, fp16,
// bf16, i8mm, dotprod and fcma).

