package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 Advanced SIMD FP8 three-register instructions: FDOT `Vd.4h|8h` or `Vd.2s|4s`
// from `Vn.8b|16b, Vm.8b|16b` of the same width; FMLALB / FMLALT `Vd.8h, Vn.16b, Vm.16b`;
// FMLALLBB / FMLALLBT / FMLALLTB / FMLALLTT `Vd.4s, Vn.16b, Vm.16b`; the three-register
// FCVTN `Vd.8b, Vn.4h, Vm.4h`, `Vd.16b, Vn.8h, Vm.8h` or `Vd.8b, Vn.4s, Vm.4s` and FCVTN2
// `Vd.16b, Vn.4s, Vm.4s`; and FMMLA `Vd.8h|4s, Vn.16b, Vm.16b`.  The two-register FCVTN /
// FCVTN2 (a narrowing between floating-point precisions) and the by-element forms belong
// to other classes; this parser rejects them.

// simdFP8MlallOf returns the isa.FP8_MLALL* quarter of an FMLALL<xy> mnemonic, or -1.
func simdFP8MlallOf(m *[]readonly char) int {
	if mnemIs(m, "fmlallbb") { return isa.FP8_MLALLBB }
	if mnemIs(m, "fmlallbt") { return isa.FP8_MLALLBT }
	if mnemIs(m, "fmlalltb") { return isa.FP8_MLALLTB }
	if mnemIs(m, "fmlalltt") { return isa.FP8_MLALLTT }
	return -1
}

// isA64SimdFP8 reports whether mnem is one of this file's instructions.
func isA64SimdFP8(m *[]readonly char) bool {
	return mnemIs(m, "fdot") || mnemIs(m, "fmlalb") || mnemIs(m, "fmlalt") || simdFP8MlallOf(m) >= 0 ||
			mnemIs(m, "fcvtn") || mnemIs(m, "fcvtn2") || mnemIs(m, "fmmla")
}

// emitA64SimdFP8 parses and emits one of this file's instructions (l positioned just
// after the mnemonic); returns false for any other mnemonic.
func emitA64SimdFP8(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !isA64SimdFP8(mnem) { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if its.N == 2 && (mnemIs(mnem, "fcvtn") || mnemIs(mnem, "fcvtn2")) {
		setErr(p,
				"the two-register fcvtn / fcvtn2 (a narrowing between floating-point "
						"precisions) is not supported yet")
		return true
	}
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var m a64Item = its.It[2]
	if mnemIs(mnem, "fcvtn") || mnemIs(mnem, "fcvtn2") {
		emitA64FP8Cvtn(p, mnemIs(mnem, "fcvtn2"), d, n, m)
		return true
	}
	// Every other form takes two FP8 sources of one width: 8b / 16b.
	var q bool = vecArrIs(n, 0, 16)
	if (!q && !vecArrIs(n, 0, 8)) || !vecArrIs(m, 0, n.VLanes) {
		setErr(p, "expected two 8b or two 16b FP8 sources")
		return true
	}
	if mnemIs(mnem, "fdot") {
		var toS bool = d.VEl == 2
		var lanes int = 4
		if toS { lanes = 2 }
		if q { lanes = lanes * 2 }
		if (d.VEl != 1 && d.VEl != 2) || !vecArrIs(d, d.VEl, lanes) {
			setErr(p, "fdot takes Vd.4h|8h or Vd.2s|4s from sources of the same width")
			return true
		}
		isa.SimdFP8Dot(p.Asm, toS, q, d.Reg, n.Reg, m.Reg)
		return true
	}
	if !q {
		setErr(p, "fmlalb / fmlalt / fmlall<xy> / fmmla take Vn.16b, Vm.16b")
		return true
	}
	var mlall int = simdFP8MlallOf(mnem)
	var toS bool = vecArrIs(d, 2, 4)
	if mlall >= 0 {
		if !toS {
			setErr(p, "fmlall<xy> takes Vd.4s")
			return true
		}
		isa.SimdFP8Mlall(p.Asm, mlall, d.Reg, n.Reg, m.Reg)
		return true
	}
	if mnemIs(mnem, "fmmla") {
		if !toS && !vecArrIs(d, 1, 8) {
			setErr(p, "fmmla takes Vd.8h or Vd.4s")
			return true
		}
		isa.SimdFP8MatMul(p.Asm, toS, d.Reg, n.Reg, m.Reg)
		return true
	}
	if !vecArrIs(d, 1, 8) {
		setErr(p, "fmlalb / fmlalt take Vd.8h")
		return true
	}
	isa.SimdFP8Mlal(p.Asm, mnemIs(mnem, "fmlalt"), d.Reg, n.Reg, m.Reg)
	return true
}

// emitA64FP8Cvtn emits the three-register FCVTN (or FCVTN2, high) into FP8: from two 4h /
// 8h vectors into 8b / 16b, or from two 4s vectors into the low (8b) or high (16b) half.
func emitA64FP8Cvtn(p @Parser, high bool, d a64Item, n a64Item, m a64Item) {
	var fromS bool = vecArrIs(n, 2, 4)
	var q bool = vecArrIs(n, 1, 8) || high
	var shapeOk bool = false
	if fromS {
		shapeOk = (!high && vecArrIs(d, 0, 8)) || (high && vecArrIs(d, 0, 16))
	} else if !high {
		shapeOk = (vecArrIs(n, 1, 4) && vecArrIs(d, 0, 8)) || (vecArrIs(n, 1, 8) && vecArrIs(d, 0, 16))
	}
	if !shapeOk || !vecArrIs(m, n.VEl, n.VLanes) {
		setErr(p,
				"fcvtn takes Vd.8b|16b, Vn.4h|8h, Vm.4h|8h or Vd.8b, Vn.4s, Vm.4s; "
						"fcvtn2 Vd.16b, Vn.4s, Vm.4s")
		return
	}
	isa.SimdFP8Cvtn(p.Asm, fromS, q, d.Reg, n.Reg, m.Reg)
}
