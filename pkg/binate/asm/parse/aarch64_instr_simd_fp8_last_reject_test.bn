// Partial (32- or 16-bit) FP8 source arrangements.
func TestGoldenSimdFP8PartialReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fdot v0.2s, v1.4b, v2.4b")
	e = goldenReject(e, "fdot v0.4h, v1.2b, v2.2b")
	e = goldenReject(e, "fmmla v0.4s, v1.4b, v2.4b")
	return e
}
