package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the FP8 three-register instructions (FDOT, FMLALB / FMLALT,
// FMLALL<xy>, the three-register FCVTN / FCVTN2, FMMLA), from clang (`clang -c -target
// aarch64-linux-gnu -march=armv9.5-a+fp8+fp8dot2+fp8dot4+fp8fma+f8f16mm+f8f32mm`).

func TestGoldenSimdFP81() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fdot v5.4h, v18.8b, v27.8b", 0x0E5BFE45)
	e = goldenWord(e, "fdot v5.8h, v18.16b, v27.16b", 0x4E5BFE45)
	e = goldenWord(e, "fdot v5.2s, v18.8b, v27.8b", 0x0E1BFE45)
	e = goldenWord(e, "fdot v5.4s, v18.16b, v27.16b", 0x4E1BFE45)
	e = goldenWord(e, "fmlalb v5.8h, v18.16b, v27.16b", 0x0EDBFE45)
	e = goldenWord(e, "fmlalt v5.8h, v18.16b, v27.16b", 0x4EDBFE45)
	e = goldenWord(e, "fmlallbb v5.4s, v18.16b, v27.16b", 0x0E1BC645)
	e = goldenWord(e, "fmlallbt v5.4s, v18.16b, v27.16b", 0x0E5BC645)
	e = goldenWord(e, "fmlalltb v5.4s, v18.16b, v27.16b", 0x4E1BC645)
	e = goldenWord(e, "fmlalltt v5.4s, v18.16b, v27.16b", 0x4E5BC645)
	e = goldenWord(e, "fcvtn v5.8b, v18.4h, v27.4h", 0x0E5BF645)
	e = goldenWord(e, "fcvtn v5.8b, v18.4s, v27.4s", 0x0E1BF645)
	e = goldenWord(e, "fcvtn v5.16b, v18.8h, v27.8h", 0x4E5BF645)
	e = goldenWord(e, "fcvtn2 v5.16b, v18.4s, v27.4s", 0x4E1BF645)
	e = goldenWord(e, "fmmla v5.8h, v18.16b, v27.16b", 0x6E1BEE45)
	e = goldenWord(e, "fmmla v5.4s, v18.16b, v27.16b", 0x6E9BEE45)
	e = goldenWord(e, "fdot v31.8h, v0.16b, v31.16b", 0x4E5FFC1F)
	e = goldenWord(e, "FDOT V0.2S, V1.8B, V2.8B", 0x0E02FC20)
	e = goldenWord(e, "fmlalt v31.8h, v31.16b, v0.16b", 0x4EC0FFFF)
	e = goldenWord(e, "fmlalltt v0.4s, v31.16b, v31.16b", 0x4E5FC7E0)
	e = goldenWord(e, "fcvtn2 v31.16b, v0.4s, v31.4s", 0x4E1FF41F)
	e = goldenWord(e, "fcvtn v0.16b, v31.8h, v0.8h", 0x4E40F7E0)
	e = goldenWord(e, "fmmla v31.4s, v0.16b, v31.16b", 0x6E9FEC1F)
	return e
}
