package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD structure loads and stores: LD1..LD4 / ST1..ST4 `{Vt.<T>, …},
// <addr>` — the multiple structures, a list of whole vectors (one to four for LD1 / ST1,
// exactly n for LDn / STn; 1d only for LD1 / ST1) — and `{Vt.<Ts>, …}[index], <addr>`,
// the single structure, n bare elements and a lane; LD1R..LD4R `{Vt.<T>, …}, <addr>`,
// n whole vectors each filled with one loaded element; and LDAP1 / STL1 `{Vt.d}[index],
// [Xn|SP{, #0}]`.  The structure address is `[Xn|SP]`, optionally post-indexed by the
// transfer size (`, #imm`, the `#` optional) or by a register (`, Xm`).  XZR is not a
// post-index register: its number selects the immediate form, so `[x0], xzr` would
// advance by the transfer size, not by zero.

// simdStructOf returns whether a mnemonic is LD<n> or LD<n>R (a load; else ST<n>), its n
// (the elements per structure) and whether it is LD<n>R (replicating), or n = 0.
func simdStructOf(m *[]readonly char) (bool, int, bool) {
	var rep bool = len(m) == 4 && (m[3] == 'r' || m[3] == 'R')
	if (len(m) != 3 && !rep) || m[2] < '1' || m[2] > '4' { return false, 0, false }
	var n int = cast(int, m[2] - '0')
	if mnemIs(m[0:2], "ld") { return true, n, rep }
	if mnemIs(m[0:2], "st") && !rep { return false, n, false }
	return false, 0, false
}

// a64StructAddr is a structure load / store address: the base register, and the
// post-index (POST_NONE, POST_IMM with Imm, or POST_REG with Rm).
type a64StructAddr struct {
	Base int
	Post int
	Imm  int
	Rm   int
}

// Post-indexing of a structure load / store address (a64StructAddr.Post).
const (
	POST_NONE int = iota
	POST_IMM
	POST_REG
)

// parseA64StructAddr parses a structure load / store address at tok == '[' — `[Xn|SP]`
// and an optional post-index `, #imm` / `, imm` / `, Xm` — returning the token after it.
func parseA64StructAddr(p @Parser, l Lexer, tok Token) (Lexer, Token, a64StructAddr, bool) {
	var sa a64StructAddr
	if tok.Kind != TOK_LBRACKET {
		setErr(p, "expected '[' to start a memory address")
		return l, tok, sa, false
	}
	l, tok = LexNext(l)
	var bcls int = RC_NONE
	if tok.Kind == TOK_IDENT { sa.Base, bcls = parseA64Reg(tok.Text) }
	if bcls != RC_X && bcls != RC_SP {
		setErr(p, "memory base must be an X register or SP")
		return l, tok, sa, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "a structure load / store address is [Xn|SP], with no offset inside")
		return l, tok, sa, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		sa.Post = POST_NONE
		return l, tok, sa, true
	}
	l, tok = LexNext(l)
	var ok bool = false
	if tok.Kind == TOK_IDENT {
		reg, cls := parseA64Reg(tok.Text)
		if cls != RC_X {
			setErr(p, "the post-index register is X0..X30")
			return l, tok, sa, false
		}
		sa.Post = POST_REG
		sa.Rm = reg
		l, tok = LexNext(l)
		return l, tok, sa, true
	}
	if tok.Kind == TOK_HASH {
		l, tok, sa.Imm, ok = parseHashImmValue(p, l)
	} else if startsNumericExpr(tok) {
		l, tok, sa.Imm, ok = parseImmValueAt(p, l, tok)
	} else {
		setErr(p, "expected a post-index immediate or register after ']'")
		return l, tok, sa, false
	}
	sa.Post = POST_IMM
	return l, tok, sa, ok
}

// emitA64SimdLdSt parses and emits a structure load / store or LDAP1 / STL1 (l positioned
// just after the mnemonic); returns false for any other mnemonic.
func emitA64SimdLdSt(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var ldap bool = mnemIs(mnem, "ldap1")
	if ldap || mnemIs(mnem, "stl1") {
		emitA64Ldap1(p, l, ldap)
		return true
	}
	load, selem, rep := simdStructOf(mnem)
	if selem == 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_LBRACE {
		setErr(p, "expected a register list")
		return true
	}
	var list a64Item
	var ok bool = false
	l, tok, list, ok = parseA64VecList(p, l)
	if !ok { return true }
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' and the address after the register list")
		return true
	}
	l, tok = LexNext(l)
	var sa a64StructAddr
	l, tok, sa, ok = parseA64StructAddr(p, l, tok)
	if !ok { return true }
	expectA64EOL(p, tok)
	if p.HasError { return true }
	if list.Lane >= 0 && !rep {
		emitA64LdStSingle(p, load, selem, list, sa)
		return true
	}
	q, okQ := vecArrQ(list.VEl, list.VLanes)
	if list.Lane >= 0 || list.VLanes == 0 || !okQ || list.VEl > 3 ||
			((selem > 1 || rep) && list.VCount != selem) {
		setErr(p, "ld<n> / st<n> / ld<n>r take a list of n whole vectors (one to four for ld1 / st1)")
		return true
	}
	if rep {
		if sa.Post == POST_IMM {
			simd.LdRepPostImm(p.Asm, selem, q, list.VEl, list.Reg, sa.Base, sa.Imm)
		} else if sa.Post == POST_REG {
			simd.LdRepPostReg(p.Asm, selem, q, list.VEl, list.Reg, sa.Base, sa.Rm)
		} else {
			simd.LdRep(p.Asm, selem, q, list.VEl, list.Reg, sa.Base)
		}
		return true
	}
	if sa.Post == POST_IMM {
		simd.LdStMultiPostImm(p.Asm, load, selem, list.VCount, q, list.VEl, list.Reg, sa.Base, sa.Imm)
	} else if sa.Post == POST_REG {
		simd.LdStMultiPostReg(p.Asm, load, selem, list.VCount, q, list.VEl, list.Reg, sa.Base, sa.Rm)
	} else {
		simd.LdStMulti(p.Asm, load, selem, list.VCount, q, list.VEl, list.Reg, sa.Base)
	}
	return true
}

// emitA64LdStSingle emits a single-structure load / store from its list — selem bare
// elements of one size and a lane — and address.
func emitA64LdStSingle(p @Parser, load bool, selem int, list a64Item, sa a64StructAddr) {
	if list.VCount != selem || list.VEl > 3 {
		setErr(p, "ld<n> / st<n> of one lane take n elements (b / h / s / d) and the index")
		return
	}
	if sa.Post == POST_IMM {
		simd.LdStSinglePostImm(p.Asm, load, selem, list.VEl, list.Lane, list.Reg, sa.Base, sa.Imm)
	} else if sa.Post == POST_REG {
		simd.LdStSinglePostReg(p.Asm, load, selem, list.VEl, list.Lane, list.Reg, sa.Base, sa.Rm)
	} else {
		simd.LdStSingle(p.Asm, load, selem, list.VEl, list.Lane, list.Reg, sa.Base)
	}
}

// emitA64Ldap1 parses and emits LDAP1 (or STL1, !load) `{Vt.d}[index], [Xn|SP{, #0}]` (l
// positioned just after the mnemonic).
func emitA64Ldap1(p @Parser, l Lexer, load bool) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_LBRACE {
		setErr(p, "expected a register list")
		return
	}
	var list a64Item
	var ok bool = false
	l, tok, list, ok = parseA64VecList(p, l)
	if !ok { return }
	if list.VCount != 1 || list.VLanes != 0 || list.VEl != 3 || list.Lane < 0 ||
			tok.Kind != TOK_COMMA {
		setErr(p, "ldap1 / stl1 take {Vt.d}[index], [Xn|SP]")
		return
	}
	l, tok = LexNext(l)
	var ad a64Addr
	l, tok, ad, ok = parseA64Addr(p, l, tok)
	if !ok { return }
	expectA64EOL(p, tok)
	if p.HasError { return }
	// The offset is checked by value, as for LDAPR / STLR (clang wants LDAP1's to start
	// with an integer literal, and takes any zero for STL1).
	if ad.Mode != ADDR_BASE && !(ad.Mode == ADDR_IMM && ad.Imm == 0) {
		setErr(p, "ldap1 / stl1 take [Xn|SP] with no offset (or #0)")
		return
	}
	simd.Ldap1(p.Asm, load, list.Lane, list.Reg, ad.Base)
}
