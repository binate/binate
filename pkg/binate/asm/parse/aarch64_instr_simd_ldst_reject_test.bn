package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Structure load / store lines clang rejects: arrangements that are not whole vectors (1q,
// the partial ones, bare elements), 1d and a register count other than n for LDn / STn, a
// post-index immediate other than the transfer size, an offset or writeback inside the
// brackets, a W or XZR base, a W or SP post-index register, a missing or extra
// operand, and lists whose registers are not consecutive, differ in arrangement, number
// five, or carry a lane.

func TestGoldenSimdLdStReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ld1 {v5.1q}, [x18]")
