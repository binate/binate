// A post-index XZR (or X31): clang accepts it and encodes register 31, which selects the
// immediate form — the line advances the base by the transfer size, not by zero — so
// it is an error (TestGoldenDeliberateRejects lists it with the other lines clang
// accepts).
func TestGoldenSimdLdStReject8() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ld1 {v5.16b, v6.16b, v7.16b, v8.16b}, [x18], xzr")
	e = goldenReject(e, "ld2 {v5.16b, v6.16b}, [x18], xzr")
	e = goldenReject(e, "ld3 {v5.16b, v6.16b, v7.16b}, [x18], xzr")
	e = goldenReject(e, "ld4 {v5.16b, v6.16b, v7.16b, v8.16b}, [x18], xzr")
	e = goldenReject(e, "st1 {v5.16b, v6.16b, v7.16b, v8.16b}, [x18], xzr")
	e = goldenReject(e, "st2 {v5.16b, v6.16b}, [x18], xzr")
	e = goldenReject(e, "st3 {v5.16b, v6.16b, v7.16b}, [x18], xzr")
	e = goldenReject(e, "st4 {v5.16b, v6.16b, v7.16b, v8.16b}, [x18], xzr")
	e = goldenReject(e, "ld1 {v5.16b}, [x18], x31")
	e = goldenReject(e, "st3 {v5.4s, v6.4s, v7.4s}, [x18], x31")
	return e
}
