package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// LD1R..LD4R, LDAP1 and STL1 lines clang rejects: for LDnR an arrangement that is not a
// whole vector, a register count other than n, a post-index immediate other than the
// transfer size, a lane, an offset or writeback inside the brackets, and ST1R (there is no
// replicating store); for LDAP1 / STL1 an element other than d, an index past 1, a
// post-index, an offset other than #0, writeback, a W or XZR base, and a list of two.  And
// (last) a post-index XZR on LDnR or a single-structure load / store, which clang accepts.

func TestGoldenSimdLdRepReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ld1r {v5.1q}, [x18]")
	e = goldenReject(e, "ld1r {v5.2h}, [x18]")
	e = goldenReject(e, "ld1r {v5.s}, [x18]")
	e = goldenReject(e, "ld1r {v5.b}, [x18]")
	e = goldenReject(e, "ld1r {v5.4s, v6.4s}, [x18]")
	e = goldenReject(e, "ld1r {v5.4s, v6.4s, v7.4s}, [x18]")
	e = goldenReject(e, "ld1r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18]")
	e = goldenReject(e, "ld1r {v5.8b}, [x18], #0")
	e = goldenReject(e, "ld1r {v5.8b}, [x18], #2")
	e = goldenReject(e, "ld1r {v5.8b}, [x18], #16")
	e = goldenReject(e, "ld1r {v5.8b}, [x18], #64")
	e = goldenReject(e, "ld1r {v5.2d}, [x18], #0")
	e = goldenReject(e, "ld1r {v5.2d}, [x18], #16")
	e = goldenReject(e, "ld1r {v5.2d}, [x18], #64")
	e = goldenReject(e, "ld1r {v5.4s}[1], [x18]")
	e = goldenReject(e, "ld1r {v5.s}[1], [x18]")
	e = goldenReject(e, "ld1r {v5.4s}, [x18, #0]")
	e = goldenReject(e, "ld1r {v5.4s}, [x18]!")
	e = goldenReject(e, "ld2r {v5.1q, v6.1q}, [x18]")
	e = goldenReject(e, "ld2r {v5.2h, v6.2h}, [x18]")
	e = goldenReject(e, "ld2r {v5.s, v6.s}, [x18]")
	e = goldenReject(e, "ld2r {v5.b, v6.b}, [x18]")
	e = goldenReject(e, "ld2r {v5.4s}, [x18]")
	e = goldenReject(e, "ld2r {v5.4s, v6.4s, v7.4s}, [x18]")
	e = goldenReject(e, "ld2r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18]")
	e = goldenReject(e, "ld2r {v5.8b, v6.8b}, [x18], #0")
	e = goldenReject(e, "ld2r {v5.8b, v6.8b}, [x18], #4")
	e = goldenReject(e, "ld2r {v5.8b, v6.8b}, [x18], #16")
	e = goldenReject(e, "ld2r {v5.8b, v6.8b}, [x18], #64")
	e = goldenReject(e, "ld2r {v5.2d, v6.2d}, [x18], #0")
	e = goldenReject(e, "ld2r {v5.2d, v6.2d}, [x18], #32")
	e = goldenReject(e, "ld2r {v5.2d, v6.2d}, [x18], #64")
	e = goldenReject(e, "ld2r {v5.4s, v6.4s}[1], [x18]")
	e = goldenReject(e, "ld2r {v5.s, v6.s}[1], [x18]")
	e = goldenReject(e, "ld2r {v5.4s, v6.4s}, [x18, #0]")
	e = goldenReject(e, "ld2r {v5.4s, v6.4s}, [x18]!")
	e = goldenReject(e, "ld3r {v5.1q, v6.1q, v7.1q}, [x18]")
	e = goldenReject(e, "ld3r {v5.2h, v6.2h, v7.2h}, [x18]")
	e = goldenReject(e, "ld3r {v5.s, v6.s, v7.s}, [x18]")
	e = goldenReject(e, "ld3r {v5.b, v6.b, v7.b}, [x18]")
	e = goldenReject(e, "ld3r {v5.4s}, [x18]")
	e = goldenReject(e, "ld3r {v5.4s, v6.4s}, [x18]")
	e = goldenReject(e, "ld3r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18]")
	e = goldenReject(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18], #0")
	e = goldenReject(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18], #6")
	e = goldenReject(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18], #16")
	e = goldenReject(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18], #64")
	e = goldenReject(e, "ld3r {v5.2d, v6.2d, v7.2d}, [x18], #0")
	e = goldenReject(e, "ld3r {v5.2d, v6.2d, v7.2d}, [x18], #16")
	e = goldenReject(e, "ld3r {v5.2d, v6.2d, v7.2d}, [x18], #48")
	return e
}

func TestGoldenSimdLdRepReject2() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ld3r {v5.2d, v6.2d, v7.2d}, [x18], #64")
	e = goldenReject(e, "ld3r {v5.4s, v6.4s, v7.4s}[1], [x18]")
	e = goldenReject(e, "ld3r {v5.s, v6.s, v7.s}[1], [x18]")
	e = goldenReject(e, "ld3r {v5.4s, v6.4s, v7.4s}, [x18, #0]")
	e = goldenReject(e, "ld3r {v5.4s, v6.4s, v7.4s}, [x18]!")
	e = goldenReject(e, "ld4r {v5.1q, v6.1q, v7.1q, v8.1q}, [x18]")
	e = goldenReject(e, "ld4r {v5.2h, v6.2h, v7.2h, v8.2h}, [x18]")
	e = goldenReject(e, "ld4r {v5.s, v6.s, v7.s, v8.s}, [x18]")
	e = goldenReject(e, "ld4r {v5.b, v6.b, v7.b, v8.b}, [x18]")
	e = goldenReject(e, "ld4r {v5.4s}, [x18]")
	e = goldenReject(e, "ld4r {v5.4s, v6.4s}, [x18]")
	e = goldenReject(e, "ld4r {v5.4s, v6.4s, v7.4s}, [x18]")
	e = goldenReject(e, "ld4r {v5.8b, v6.8b, v7.8b, v8.8b}, [x18], #0")
	e = goldenReject(e, "ld4r {v5.8b, v6.8b, v7.8b, v8.8b}, [x18], #8")
	e = goldenReject(e, "ld4r {v5.8b, v6.8b, v7.8b, v8.8b}, [x18], #16")
	e = goldenReject(e, "ld4r {v5.8b, v6.8b, v7.8b, v8.8b}, [x18], #64")
	e = goldenReject(e, "ld4r {v5.2d, v6.2d, v7.2d, v8.2d}, [x18], #0")
	e = goldenReject(e, "ld4r {v5.2d, v6.2d, v7.2d, v8.2d}, [x18], #16")
	e = goldenReject(e, "ld4r {v5.2d, v6.2d, v7.2d, v8.2d}, [x18], #64")
	e = goldenReject(e, "ld4r {v5.4s, v6.4s, v7.4s, v8.4s}[1], [x18]")
	e = goldenReject(e, "ld4r {v5.s, v6.s, v7.s, v8.s}[1], [x18]")
	e = goldenReject(e, "ld4r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18, #0]")
	e = goldenReject(e, "ld4r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18]!")
	e = goldenReject(e, "st1r {v5.4s}, [x18]")
	e = goldenReject(e, "st1r {v5.8b}, [x18], #1")
	e = goldenReject(e, "ldap1 {v5.d}[2], [x18]")
	e = goldenReject(e, "ldap1 {v5.s}[0], [x18]")
	e = goldenReject(e, "ldap1 {v5.s}[1], [x18]")
	e = goldenReject(e, "ldap1 {v5.s}[2], [x18]")
	e = goldenReject(e, "ldap1 {v5.b}[0], [x18]")
	e = goldenReject(e, "ldap1 {v5.b}[1], [x18]")
	e = goldenReject(e, "ldap1 {v5.b}[2], [x18]")
	e = goldenReject(e, "ldap1 {v5.2d}[0], [x18]")
	e = goldenReject(e, "ldap1 {v5.2d}[1], [x18]")
	e = goldenReject(e, "ldap1 {v5.2d}[2], [x18]")
	e = goldenReject(e, "ldap1 {v5.1d}[0], [x18]")
	e = goldenReject(e, "ldap1 {v5.1d}[1], [x18]")
	e = goldenReject(e, "ldap1 {v5.1d}[2], [x18]")
	e = goldenReject(e, "ldap1 {v5.d}[1], [x18], #8")
	e = goldenReject(e, "ldap1 {v5.d}[1], [x18], x2")
	e = goldenReject(e, "ldap1 {v5.d, v6.d}[1], [x18]")
	e = goldenReject(e, "ldap1 {v5.d}[1], [x18]!")
	e = goldenReject(e, "ldap1 {v5.d}, [x18]")
	e = goldenReject(e, "ldap1 {v5.2d}, [x18]")
	e = goldenReject(e, "stl1 {v5.d}[2], [x18]")
	e = goldenReject(e, "stl1 {v5.s}[0], [x18]")
	e = goldenReject(e, "stl1 {v5.s}[1], [x18]")
	e = goldenReject(e, "stl1 {v5.s}[2], [x18]")
	e = goldenReject(e, "stl1 {v5.b}[0], [x18]")
	e = goldenReject(e, "stl1 {v5.b}[1], [x18]")
	return e
}

func TestGoldenSimdLdRepReject3() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "stl1 {v5.b}[2], [x18]")
	e = goldenReject(e, "stl1 {v5.2d}[0], [x18]")
	e = goldenReject(e, "stl1 {v5.2d}[1], [x18]")
	e = goldenReject(e, "stl1 {v5.2d}[2], [x18]")
	e = goldenReject(e, "stl1 {v5.1d}[0], [x18]")
	e = goldenReject(e, "stl1 {v5.1d}[1], [x18]")
	e = goldenReject(e, "stl1 {v5.1d}[2], [x18]")
	e = goldenReject(e, "stl1 {v5.d}[1], [x18], #8")
	e = goldenReject(e, "stl1 {v5.d}[1], [x18], x2")
	e = goldenReject(e, "stl1 {v5.d, v6.d}[1], [x18]")
	e = goldenReject(e, "stl1 {v5.d}[1], [x18]!")
	e = goldenReject(e, "stl1 {v5.d}, [x18]")
	e = goldenReject(e, "stl1 {v5.2d}, [x18]")
	e = goldenReject(e, "ldap1 {v5.d}[1], [x18, #8]")
	e = goldenReject(e, "stl1 {v5.d}[1], [x18, #0]!")
	e = goldenReject(e, "ldap1 {v5.d}[1], [xzr]")
	e = goldenReject(e, "ldap1 {v5.d}[1], [w18]")
	e = goldenReject(e, "ldap1 {v5.h}[1], [x18]")
	e = goldenReject(e, "stl1 {v5.d}[1], [x18], #0")
	e = goldenReject(e, "ldap1 {v5.d}[1], [x18, x2]")
	e = goldenReject(e, "stl1 {v5.d}[1], [x18, #:lo12:sym]")
	return e
}

// A post-index XZR (or X31): clang accepts it and encodes register 31, which selects the
// immediate form — the line advances the base by the transfer size, not by zero — so
// it is an error (TestGoldenDeliberateRejects lists it with the other lines clang
// accepts).
func TestGoldenSimdLdRepReject4() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ld1 {v5.s}[1], [x18], xzr")
	e = goldenReject(e, "st4 {v5.b, v6.b, v7.b, v8.b}[1], [x18], xzr")
	e = goldenReject(e, "ld1r {v5.4s}, [x18], xzr")
	e = goldenReject(e, "ld2r {v5.2d, v6.2d}, [x18], xzr")
	e = goldenReject(e, "ld1r {v5.4s}, [x18], x31")
	e = goldenReject(e, "ld1 {v5.s}[1], [x18], x31")
	return e
}
