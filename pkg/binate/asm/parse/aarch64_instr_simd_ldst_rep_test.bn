	e = goldenWord(e, "ld4r {v5.2d, v6.2d, v7.2d, v8.2d}, [x18], 32", 0x4DFFEE45)
	e = goldenWord(e, "ld4r {v5.2d, v6.2d, v7.2d, v8.2d}, [x18], x2", 0x4DE2EE45)
	e = goldenWord(e, "ldap1 {v5.d}[0], [x18]", 0x0D418645)
	e = goldenWord(e, "ldap1 {v5.d}[1], [x18]", 0x4D418645)
	e = goldenWord(e, "ldap1 {v5.d}[1], [x18, #0]", 0x4D418645)
	e = goldenWord(e, "ldap1 {v31.d}[1], [sp]", 0x4D4187FF)
	e = goldenWord(e, "stl1 {v5.d}[0], [x18]", 0x0D018645)
	e = goldenWord(e, "stl1 {v5.d}[1], [x18]", 0x4D018645)
	e = goldenWord(e, "stl1 {v5.d}[1], [x18, #0]", 0x4D018645)
	e = goldenWord(e, "stl1 {v31.d}[1], [sp]", 0x4D0187FF)
	e = goldenWord(e, "LD3R {V5.4S-V7.4S}, [X18], X2", 0x4DC2EA45)
	e = goldenWord(e, "LDAP1 {V5.D}[1], [X18]", 0x4D418645)
	e = goldenWord(e, "ld2r {v31.2d, v0.2d}, [x0], #16", 0x4DFFCC1F)
	e = goldenWord(e, "ldap1 {v5.d}[1+0], [x18]", 0x4D418645)
	return e
}
