	e = goldenWord(e, "ld2r {v5.1d, v6.1d}, [x18], x2", 0x0DE2CE45)
	e = goldenWord(e, "ld2r {v30.2d, v31.2d}, [sp]", 0x4D60CFFE)
	e = goldenWord(e, "ld2r {v5.2d, v6.2d}, [x18], #16", 0x4DFFCE45)
	e = goldenWord(e, "ld2r {v5.2d, v6.2d}, [x18], 16", 0x4DFFCE45)
	e = goldenWord(e, "ld2r {v5.2d, v6.2d}, [x18], x2", 0x4DE2CE45)
	e = goldenWord(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18]", 0x0D40E245)
	e = goldenWord(e, "ld3r {v5.16b, v6.16b, v7.16b}, [x18]", 0x4D40E245)
	e = goldenWord(e, "ld3r {v5.4h, v6.4h, v7.4h}, [x18]", 0x0D40E645)
