func TestGoldenSimdLdRep4() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ld4r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18], 16", 0x4DFFEA45)
	e = goldenWord(e, "ld4r {v5.4s, v6.4s, v7.4s, v8.4s}, [x18], x2", 0x4DE2EA45)
