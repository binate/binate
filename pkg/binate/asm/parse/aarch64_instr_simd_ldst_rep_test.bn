	e = goldenWord(e, "ld3r {v5.8h, v6.8h, v7.8h}, [x18], #6", 0x4DDFE645)
	e = goldenWord(e, "ld3r {v5.8h, v6.8h, v7.8h}, [x18], 6", 0x4DDFE645)
	e = goldenWord(e, "ld3r {v5.8h, v6.8h, v7.8h}, [x18], x2", 0x4DC2E645)
	e = goldenWord(e, "ld3r {v30.2s, v31.2s, v0.2s}, [sp]", 0x0D40EBFE)
	e = goldenWord(e, "ld3r {v5.2s, v6.2s, v7.2s}, [x18], #12", 0x0DDFEA45)
	e = goldenWord(e, "ld3r {v5.2s, v6.2s, v7.2s}, [x18], 12", 0x0DDFEA45)
	e = goldenWord(e, "ld3r {v5.2s, v6.2s, v7.2s}, [x18], x2", 0x0DC2EA45)
	e = goldenWord(e, "ld3r {v30.4s, v31.4s, v0.4s}, [sp]", 0x4D40EBFE)
	e = goldenWord(e, "ld3r {v5.4s, v6.4s, v7.4s}, [x18], #12", 0x4DDFEA45)
	e = goldenWord(e, "ld3r {v5.4s, v6.4s, v7.4s}, [x18], 12", 0x4DDFEA45)
	e = goldenWord(e, "ld3r {v5.4s, v6.4s, v7.4s}, [x18], x2", 0x4DC2EA45)
