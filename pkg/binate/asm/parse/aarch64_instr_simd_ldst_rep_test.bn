package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the replicating loads LD1R..LD4R — every arrangement, with no offset,
// post-indexed by the transfer size (with and without `#`) and by a register, and a
// wrapping register list at [sp] — and LDAP1 / STL1, from clang (`clang -c -target
// aarch64-linux-gnu -march=armv9.5-a+rcpc3`).

func TestGoldenSimdLdRep1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ld1r {v5.8b}, [x18]", 0x0D40C245)
	e = goldenWord(e, "ld1r {v5.16b}, [x18]", 0x4D40C245)
	e = goldenWord(e, "ld1r {v5.4h}, [x18]", 0x0D40C645)
	e = goldenWord(e, "ld1r {v5.8h}, [x18]", 0x4D40C645)
	e = goldenWord(e, "ld1r {v5.2s}, [x18]", 0x0D40CA45)
	e = goldenWord(e, "ld1r {v5.4s}, [x18]", 0x4D40CA45)
	e = goldenWord(e, "ld1r {v5.1d}, [x18]", 0x0D40CE45)
	e = goldenWord(e, "ld1r {v5.2d}, [x18]", 0x4D40CE45)
	e = goldenWord(e, "ld1r {v30.8b}, [sp]", 0x0D40C3FE)
	e = goldenWord(e, "ld1r {v5.8b}, [x18], #1", 0x0DDFC245)
	e = goldenWord(e, "ld1r {v5.8b}, [x18], 1", 0x0DDFC245)
	e = goldenWord(e, "ld1r {v5.8b}, [x18], x2", 0x0DC2C245)
	e = goldenWord(e, "ld1r {v30.16b}, [sp]", 0x4D40C3FE)
	e = goldenWord(e, "ld1r {v5.16b}, [x18], #1", 0x4DDFC245)
	e = goldenWord(e, "ld1r {v5.16b}, [x18], 1", 0x4DDFC245)
	e = goldenWord(e, "ld1r {v5.16b}, [x18], x2", 0x4DC2C245)
	e = goldenWord(e, "ld1r {v30.4h}, [sp]", 0x0D40C7FE)
	e = goldenWord(e, "ld1r {v5.4h}, [x18], #2", 0x0DDFC645)
	e = goldenWord(e, "ld1r {v5.4h}, [x18], 2", 0x0DDFC645)
	e = goldenWord(e, "ld1r {v5.4h}, [x18], x2", 0x0DC2C645)
	e = goldenWord(e, "ld1r {v30.8h}, [sp]", 0x4D40C7FE)
	e = goldenWord(e, "ld1r {v5.8h}, [x18], #2", 0x4DDFC645)
	e = goldenWord(e, "ld1r {v5.8h}, [x18], 2", 0x4DDFC645)
	e = goldenWord(e, "ld1r {v5.8h}, [x18], x2", 0x4DC2C645)
	e = goldenWord(e, "ld1r {v30.2s}, [sp]", 0x0D40CBFE)
	e = goldenWord(e, "ld1r {v5.2s}, [x18], #4", 0x0DDFCA45)
	e = goldenWord(e, "ld1r {v5.2s}, [x18], 4", 0x0DDFCA45)
	e = goldenWord(e, "ld1r {v5.2s}, [x18], x2", 0x0DC2CA45)
	e = goldenWord(e, "ld1r {v30.4s}, [sp]", 0x4D40CBFE)
	e = goldenWord(e, "ld1r {v5.4s}, [x18], #4", 0x4DDFCA45)
	e = goldenWord(e, "ld1r {v5.4s}, [x18], 4", 0x4DDFCA45)
	e = goldenWord(e, "ld1r {v5.4s}, [x18], x2", 0x4DC2CA45)
	e = goldenWord(e, "ld1r {v30.1d}, [sp]", 0x0D40CFFE)
	e = goldenWord(e, "ld1r {v5.1d}, [x18], #8", 0x0DDFCE45)
	e = goldenWord(e, "ld1r {v5.1d}, [x18], 8", 0x0DDFCE45)
	e = goldenWord(e, "ld1r {v5.1d}, [x18], x2", 0x0DC2CE45)
	e = goldenWord(e, "ld1r {v30.2d}, [sp]", 0x4D40CFFE)
	e = goldenWord(e, "ld1r {v5.2d}, [x18], #8", 0x4DDFCE45)
	e = goldenWord(e, "ld1r {v5.2d}, [x18], 8", 0x4DDFCE45)
	e = goldenWord(e, "ld1r {v5.2d}, [x18], x2", 0x4DC2CE45)
	e = goldenWord(e, "ld2r {v5.8b, v6.8b}, [x18]", 0x0D60C245)
	e = goldenWord(e, "ld2r {v5.16b, v6.16b}, [x18]", 0x4D60C245)
	e = goldenWord(e, "ld2r {v5.4h, v6.4h}, [x18]", 0x0D60C645)
	e = goldenWord(e, "ld2r {v5.8h, v6.8h}, [x18]", 0x4D60C645)
	e = goldenWord(e, "ld2r {v5.2s, v6.2s}, [x18]", 0x0D60CA45)
	e = goldenWord(e, "ld2r {v5.4s, v6.4s}, [x18]", 0x4D60CA45)
	e = goldenWord(e, "ld2r {v5.1d, v6.1d}, [x18]", 0x0D60CE45)
	e = goldenWord(e, "ld2r {v5.2d, v6.2d}, [x18]", 0x4D60CE45)
	e = goldenWord(e, "ld2r {v30.8b, v31.8b}, [sp]", 0x0D60C3FE)
	e = goldenWord(e, "ld2r {v5.8b, v6.8b}, [x18], #2", 0x0DFFC245)
	return e
}

func TestGoldenSimdLdRep2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ld2r {v5.8b, v6.8b}, [x18], 2", 0x0DFFC245)
