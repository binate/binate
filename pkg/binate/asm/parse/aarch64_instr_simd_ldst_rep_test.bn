	e = goldenWord(e, "ld4r {v5.1d, v6.1d, v7.1d, v8.1d}, [x18], #32", 0x0DFFEE45)
	e = goldenWord(e, "ld4r {v5.1d, v6.1d, v7.1d, v8.1d}, [x18], 32", 0x0DFFEE45)
	e = goldenWord(e, "ld4r {v5.1d, v6.1d, v7.1d, v8.1d}, [x18], x2", 0x0DE2EE45)
