	e = goldenWord(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18], 3", 0x0DDFE245)
	e = goldenWord(e, "ld3r {v5.8b, v6.8b, v7.8b}, [x18], x2", 0x0DC2E245)
	e = goldenWord(e, "ld3r {v30.16b, v31.16b, v0.16b}, [sp]", 0x4D40E3FE)
