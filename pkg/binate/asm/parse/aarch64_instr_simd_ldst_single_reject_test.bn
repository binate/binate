package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Single-structure load / store lines clang rejects: a lane on something other than a bare
// b / h / s / d element, a register count other than n, an index past the element count
// (or negative), a post-index immediate other than the transfer size, an offset or
// writeback inside the brackets, a W base, an SP or W post-index register, and a missing
// lane, address or index.

func TestGoldenSimdLdStSingleReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ld1 {v5.q}[1], [x18]")
	e = goldenReject(e, "ld1 {v5.2s}[1], [x18]")
	e = goldenReject(e, "ld1 {v5.4b}[1], [x18]")
