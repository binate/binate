	e = goldenReject(e, "ld1 {v5.s, v6.s, v7.s, v8.s}[1], [x18]")
	e = goldenReject(e, "ld1 {v5.b}[16], [x18]")
	e = goldenReject(e, "ld1 {v5.b}[-1], [x18]")
	e = goldenReject(e, "ld1 {v5.h}[8], [x18]")
	e = goldenReject(e, "ld1 {v5.h}[-1], [x18]")
	e = goldenReject(e, "ld1 {v5.h}[16], [x18]")
	e = goldenReject(e, "ld1 {v5.s}[4], [x18]")
	e = goldenReject(e, "ld1 {v5.s}[-1], [x18]")
	e = goldenReject(e, "ld1 {v5.s}[16], [x18]")
	e = goldenReject(e, "ld1 {v5.d}[2], [x18]")
	e = goldenReject(e, "ld1 {v5.d}[-1], [x18]")
	e = goldenReject(e, "ld1 {v5.d}[16], [x18]")
	e = goldenReject(e, "ld1 {v5.b}[1], [x18], #-1")
	e = goldenReject(e, "ld1 {v5.b}[1], [x18], #0")
	e = goldenReject(e, "ld1 {v5.b}[1], [x18], #2")
	e = goldenReject(e, "ld1 {v5.b}[1], [x18], #16")
	e = goldenReject(e, "ld1 {v5.d}[1], [x18], #-8")
	e = goldenReject(e, "ld1 {v5.d}[1], [x18], #0")
	e = goldenReject(e, "ld1 {v5.d}[1], [x18], #9")
	e = goldenReject(e, "ld1 {v5.d}[1], [x18], #16")
	e = goldenReject(e, "ld1 {v5.s}[1], [x18, #0]")
	e = goldenReject(e, "ld1 {v5.s}[1], [x18]!")
	e = goldenReject(e, "ld1 {v5.s}[1], [w18]")
	e = goldenReject(e, "ld1 {v5.s}[1], [x18], sp")
	e = goldenReject(e, "ld1 {v5.s}[1], [x18], w2")
	e = goldenReject(e, "ld1 {v5.s}, [x18]")
	e = goldenReject(e, "ld1 {v5.s}[1]")
	e = goldenReject(e, "ld1 {v5.s}[x1], [x18]")
	e = goldenReject(e, "ld2 {v5.q, v6.q}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.2s, v6.2s}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.4b, v6.4b}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.2h, v6.2h}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.s}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.s, v6.s, v7.s}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.s, v6.s, v7.s, v8.s}[1], [x18]")
	e = goldenReject(e, "ld2 {v5.b, v6.b}[16], [x18]")
	e = goldenReject(e, "ld2 {v5.b, v6.b}[-1], [x18]")
	e = goldenReject(e, "ld2 {v5.h, v6.h}[8], [x18]")
	e = goldenReject(e, "ld2 {v5.h, v6.h}[-1], [x18]")
	e = goldenReject(e, "ld2 {v5.h, v6.h}[16], [x18]")
	e = goldenReject(e, "ld2 {v5.s, v6.s}[4], [x18]")
	e = goldenReject(e, "ld2 {v5.s, v6.s}[-1], [x18]")
	e = goldenReject(e, "ld2 {v5.s, v6.s}[16], [x18]")
	e = goldenReject(e, "ld2 {v5.d, v6.d}[2], [x18]")
	return e
}

