package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the single-structure stores ST1..ST4 — every element size at every
// index, with no offset, post-indexed by the transfer size (with and without `#`) and by a
// register, and a register list from v30 wrapping to v0 at [sp] — from clang (`clang -c
// -target aarch64-linux-gnu -march=armv9.5-a+rcpc3`).

func TestGoldenSimdStSingle1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "st1 {v5.b}[1], [x18]", 0x0D000645)
	e = goldenWord(e, "st1 {v5.h}[1], [x18]", 0x0D004A45)
