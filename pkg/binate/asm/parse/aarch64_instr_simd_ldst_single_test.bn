	e = goldenWord(e, "ld1 {v5.b}[4], [x18]", 0x0D401245)
	e = goldenWord(e, "ld1 {v5.b}[5], [x18]", 0x0D401645)
	e = goldenWord(e, "ld1 {v5.b}[6], [x18]", 0x0D401A45)
