	e = goldenWord(e, "ld1 {v5.h}[7], [x18]", 0x4D405A45)
	e = goldenWord(e, "ld1 {v30.h}[7], [sp]", 0x4D405BFE)
	e = goldenWord(e, "ld1 {v5.h}[1], [x18], #2", 0x0DDF4A45)
