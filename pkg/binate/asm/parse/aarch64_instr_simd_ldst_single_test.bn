	e = goldenWord(e, "ld1 {v5.s}[2], [x18]", 0x4D408245)
	e = goldenWord(e, "ld1 {v5.s}[3], [x18]", 0x4D409245)
	e = goldenWord(e, "ld1 {v30.s}[3], [sp]", 0x4D4093FE)
