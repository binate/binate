	e = goldenWord(e, "ld1 {v5.b}[10], [x18]", 0x4D400A45)
	e = goldenWord(e, "ld1 {v5.b}[11], [x18]", 0x4D400E45)
	e = goldenWord(e, "ld1 {v5.b}[12], [x18]", 0x4D401245)
	e = goldenWord(e, "ld1 {v5.b}[13], [x18]", 0x4D401645)
	e = goldenWord(e, "ld1 {v5.b}[14], [x18]", 0x4D401A45)
	e = goldenWord(e, "ld1 {v5.b}[15], [x18]", 0x4D401E45)
	e = goldenWord(e, "ld1 {v30.b}[15], [sp]", 0x4D401FFE)
	e = goldenWord(e, "ld1 {v5.b}[1], [x18], #1", 0x0DDF0645)
	e = goldenWord(e, "ld1 {v5.b}[1], [x18], 1", 0x0DDF0645)
	e = goldenWord(e, "ld1 {v5.b}[1], [x18], x2", 0x0DC20645)
	e = goldenWord(e, "ld1 {v5.b}[1], [x18], x30", 0x0DDE0645)
