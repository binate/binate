package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the multiple-structure stores ST1..ST4 — every register count at every
// arrangement, with no offset, post-indexed by the transfer size (with and without `#`) and by
// a register, and a register range from v30 wrapping to v0 at [sp] — from clang (`clang -c
// -target aarch64-linux-gnu -march=armv9.5-a`).

func TestGoldenSimdStoreMulti1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "st1 {v5.8b}, [x18]", 0x0C007245)
	e = goldenWord(e, "st1 {v5.16b}, [x18]", 0x4C007245)
	e = goldenWord(e, "st1 {v5.4h}, [x18]", 0x0C007645)
	e = goldenWord(e, "st1 {v5.8h}, [x18]", 0x4C007645)
	e = goldenWord(e, "st1 {v5.2s}, [x18]", 0x0C007A45)
	e = goldenWord(e, "st1 {v5.4s}, [x18]", 0x4C007A45)
	e = goldenWord(e, "st1 {v5.1d}, [x18]", 0x0C007E45)
	e = goldenWord(e, "st1 {v5.2d}, [x18]", 0x4C007E45)
	e = goldenWord(e, "st1 {v30.8b}, [sp]", 0x0C0073FE)
	e = goldenWord(e, "st1 {v5.8b}, [x18], #8", 0x0C9F7245)
	e = goldenWord(e, "st1 {v5.8b}, [x18], 8", 0x0C9F7245)
	e = goldenWord(e, "st1 {v5.8b}, [x18], x2", 0x0C827245)
	e = goldenWord(e, "st1 {v30.16b}, [sp]", 0x4C0073FE)
	e = goldenWord(e, "st1 {v5.16b}, [x18], #16", 0x4C9F7245)
	e = goldenWord(e, "st1 {v5.16b}, [x18], 16", 0x4C9F7245)
	e = goldenWord(e, "st1 {v5.16b}, [x18], x2", 0x4C827245)
	e = goldenWord(e, "st1 {v30.4h}, [sp]", 0x0C0077FE)
	e = goldenWord(e, "st1 {v5.4h}, [x18], #8", 0x0C9F7645)
	e = goldenWord(e, "st1 {v5.4h}, [x18], 8", 0x0C9F7645)
	e = goldenWord(e, "st1 {v5.4h}, [x18], x2", 0x0C827645)
	e = goldenWord(e, "st1 {v30.8h}, [sp]", 0x4C0077FE)
	e = goldenWord(e, "st1 {v5.8h}, [x18], #16", 0x4C9F7645)
	e = goldenWord(e, "st1 {v5.8h}, [x18], 16", 0x4C9F7645)
	e = goldenWord(e, "st1 {v5.8h}, [x18], x2", 0x4C827645)
	e = goldenWord(e, "st1 {v30.2s}, [sp]", 0x0C007BFE)
	e = goldenWord(e, "st1 {v5.2s}, [x18], #8", 0x0C9F7A45)
	e = goldenWord(e, "st1 {v5.2s}, [x18], 8", 0x0C9F7A45)
	e = goldenWord(e, "st1 {v5.2s}, [x18], x2", 0x0C827A45)
	e = goldenWord(e, "st1 {v30.4s}, [sp]", 0x4C007BFE)
	e = goldenWord(e, "st1 {v5.4s}, [x18], #16", 0x4C9F7A45)
	e = goldenWord(e, "st1 {v5.4s}, [x18], 16", 0x4C9F7A45)
	e = goldenWord(e, "st1 {v5.4s}, [x18], x2", 0x4C827A45)
	e = goldenWord(e, "st1 {v30.1d}, [sp]", 0x0C007FFE)
	e = goldenWord(e, "st1 {v5.1d}, [x18], #8", 0x0C9F7E45)
	e = goldenWord(e, "st1 {v5.1d}, [x18], 8", 0x0C9F7E45)
	e = goldenWord(e, "st1 {v5.1d}, [x18], x2", 0x0C827E45)
	e = goldenWord(e, "st1 {v30.2d}, [sp]", 0x4C007FFE)
	e = goldenWord(e, "st1 {v5.2d}, [x18], #16", 0x4C9F7E45)
	e = goldenWord(e, "st1 {v5.2d}, [x18], 16", 0x4C9F7E45)
	e = goldenWord(e, "st1 {v5.2d}, [x18], x2", 0x4C827E45)
	e = goldenWord(e, "st1 {v5.8b, v6.8b}, [x18]", 0x0C00A245)
	e = goldenWord(e, "st1 {v5.16b, v6.16b}, [x18]", 0x4C00A245)
	e = goldenWord(e, "st1 {v5.4h, v6.4h}, [x18]", 0x0C00A645)
	e = goldenWord(e, "st1 {v5.8h, v6.8h}, [x18]", 0x4C00A645)
	e = goldenWord(e, "st1 {v5.2s, v6.2s}, [x18]", 0x0C00AA45)
	e = goldenWord(e, "st1 {v5.4s, v6.4s}, [x18]", 0x4C00AA45)
	e = goldenWord(e, "st1 {v5.1d, v6.1d}, [x18]", 0x0C00AE45)
	e = goldenWord(e, "st1 {v5.2d, v6.2d}, [x18]", 0x4C00AE45)
	e = goldenWord(e, "st1 {v30.8b - v31.8b}, [sp]", 0x0C00A3FE)
	e = goldenWord(e, "st1 {v5.8b, v6.8b}, [x18], #16", 0x0C9FA245)
	return e
}

