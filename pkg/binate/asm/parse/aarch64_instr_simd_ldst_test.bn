package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the multiple-structure loads LD1..LD4 — every register count at every
// arrangement, with no offset, post-indexed by the transfer size (with and without `#`) and by
// a register, and a register range from v30 wrapping to v0 at [sp] — from clang (`clang -c
// -target aarch64-linux-gnu -march=armv9.5-a`).

func TestGoldenSimdLoadMulti1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "ld1 {v5.8b}, [x18]", 0x0C407245)
	e = goldenWord(e, "ld1 {v5.16b}, [x18]", 0x4C407245)
	e = goldenWord(e, "ld1 {v5.4h}, [x18]", 0x0C407645)
	e = goldenWord(e, "ld1 {v5.8h}, [x18]", 0x4C407645)
	e = goldenWord(e, "ld1 {v5.2s}, [x18]", 0x0C407A45)
	e = goldenWord(e, "ld1 {v5.4s}, [x18]", 0x4C407A45)
	e = goldenWord(e, "ld1 {v5.1d}, [x18]", 0x0C407E45)
	e = goldenWord(e, "ld1 {v5.2d}, [x18]", 0x4C407E45)
	e = goldenWord(e, "ld1 {v30.8b}, [sp]", 0x0C4073FE)
	e = goldenWord(e, "ld1 {v5.8b}, [x18], #8", 0x0CDF7245)
	e = goldenWord(e, "ld1 {v5.8b}, [x18], 8", 0x0CDF7245)
	e = goldenWord(e, "ld1 {v5.8b}, [x18], x2", 0x0CC27245)
	e = goldenWord(e, "ld1 {v30.16b}, [sp]", 0x4C4073FE)
	e = goldenWord(e, "ld1 {v5.16b}, [x18], #16", 0x4CDF7245)
	e = goldenWord(e, "ld1 {v5.16b}, [x18], 16", 0x4CDF7245)
	e = goldenWord(e, "ld1 {v5.16b}, [x18], x2", 0x4CC27245)
	e = goldenWord(e, "ld1 {v30.4h}, [sp]", 0x0C4077FE)
	e = goldenWord(e, "ld1 {v5.4h}, [x18], #8", 0x0CDF7645)
	e = goldenWord(e, "ld1 {v5.4h}, [x18], 8", 0x0CDF7645)
	e = goldenWord(e, "ld1 {v5.4h}, [x18], x2", 0x0CC27645)
	e = goldenWord(e, "ld1 {v30.8h}, [sp]", 0x4C4077FE)
	e = goldenWord(e, "ld1 {v5.8h}, [x18], #16", 0x4CDF7645)
	e = goldenWord(e, "ld1 {v5.8h}, [x18], 16", 0x4CDF7645)
	e = goldenWord(e, "ld1 {v5.8h}, [x18], x2", 0x4CC27645)
	e = goldenWord(e, "ld1 {v30.2s}, [sp]", 0x0C407BFE)
	e = goldenWord(e, "ld1 {v5.2s}, [x18], #8", 0x0CDF7A45)
	e = goldenWord(e, "ld1 {v5.2s}, [x18], 8", 0x0CDF7A45)
	e = goldenWord(e, "ld1 {v5.2s}, [x18], x2", 0x0CC27A45)
	e = goldenWord(e, "ld1 {v30.4s}, [sp]", 0x4C407BFE)
	e = goldenWord(e, "ld1 {v5.4s}, [x18], #16", 0x4CDF7A45)
	e = goldenWord(e, "ld1 {v5.4s}, [x18], 16", 0x4CDF7A45)
	e = goldenWord(e, "ld1 {v5.4s}, [x18], x2", 0x4CC27A45)
	e = goldenWord(e, "ld1 {v30.1d}, [sp]", 0x0C407FFE)
	e = goldenWord(e, "ld1 {v5.1d}, [x18], #8", 0x0CDF7E45)
	e = goldenWord(e, "ld1 {v5.1d}, [x18], 8", 0x0CDF7E45)
	e = goldenWord(e, "ld1 {v5.1d}, [x18], x2", 0x0CC27E45)
	e = goldenWord(e, "ld1 {v30.2d}, [sp]", 0x4C407FFE)
	e = goldenWord(e, "ld1 {v5.2d}, [x18], #16", 0x4CDF7E45)
	e = goldenWord(e, "ld1 {v5.2d}, [x18], 16", 0x4CDF7E45)
	e = goldenWord(e, "ld1 {v5.2d}, [x18], x2", 0x4CC27E45)
	e = goldenWord(e, "ld1 {v5.8b, v6.8b}, [x18]", 0x0C40A245)
	e = goldenWord(e, "ld1 {v5.16b, v6.16b}, [x18]", 0x4C40A245)
	e = goldenWord(e, "ld1 {v5.4h, v6.4h}, [x18]", 0x0C40A645)
	e = goldenWord(e, "ld1 {v5.8h, v6.8h}, [x18]", 0x4C40A645)
	e = goldenWord(e, "ld1 {v5.2s, v6.2s}, [x18]", 0x0C40AA45)
	e = goldenWord(e, "ld1 {v5.4s, v6.4s}, [x18]", 0x4C40AA45)
	e = goldenWord(e, "ld1 {v5.1d, v6.1d}, [x18]", 0x0C40AE45)
	e = goldenWord(e, "ld1 {v5.2d, v6.2d}, [x18]", 0x4C40AE45)
	e = goldenWord(e, "ld1 {v30.8b - v31.8b}, [sp]", 0x0C40A3FE)
	e = goldenWord(e, "ld1 {v5.8b, v6.8b}, [x18], #16", 0x0CDFA245)
	return e
}

