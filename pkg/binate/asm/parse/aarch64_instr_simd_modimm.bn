package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD modified-immediate instructions: MOVI `Vd.8b|16b, #imm8`, `Dd,
// #imm64` and `Vd.2d, #imm64` (bytes each 0x00 or 0xff); MOVI / MVNI / ORR / BIC `Vd.4h|8h,
// #imm8{, lsl #0|8}` and `Vd.2s|4s, #imm8{, lsl #0|8|16|24}`; MOVI / MVNI `Vd.2s|4s, #imm8,
// msl #8|16`; and FMOV `Vd.4h|8h|2s|4s|2d, #fpimm`, whose immediate is read as the scalar
// FMOV's (aarch64_instr_fmov.bn).  ORR and BIC are also the register forms (three-same)
// and the integer instructions; the routing hands the immediate forms here.  As clang, the
// byte form takes no `lsl #0`.

// simdModImmOf returns the simd.MI_* operation of a mnemonic, or -1.
func simdModImmOf(m *[]readonly char) int {
	if mnemIs(m, "movi") { return simd.MI_MOVI }
	if mnemIs(m, "mvni") { return simd.MI_MVNI }
	if mnemIs(m, "orr") { return simd.MI_ORR }
	if mnemIs(m, "bic") { return simd.MI_BIC }
	return -1
}

// emitA64SimdModImm parses and emits MOVI / MVNI (l positioned just after the mnemonic);
// returns false for any other mnemonic.
func emitA64SimdModImm(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !mnemIs(mnem, "movi") && !mnemIs(mnem, "mvni") { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	emitA64SimdModImmItems(p, mnem, its)
	return true
}

// emitA64SimdModImmItems emits a modified-immediate instruction from its scanned operands;
// returns false (nothing done) when mnem is not one, or is ORR / BIC without an immediate
// second operand (their register forms).
func emitA64SimdModImmItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	var op int = simdModImmOf(mnem)
	if op < 0 { return false }
	var logical bool = op == simd.MI_ORR || op == simd.MI_BIC
	if logical && (its.N < 2 || its.It[1].Kind != IT_IMM) { return false }
	if its.N < 2 || its.N > 3 || its.It[1].Kind != IT_IMM {
		setErr(p, "expected a vector (or D register), an immediate, and an optional shift")
		return true
	}
	var d a64Item = its.It[0]
	var imm int64 = its.It[1].Imm
	var hasShift bool = its.N == 3
	// The 64-bit patterns: MOVI to a D register or 2d.
	if op == simd.MI_MOVI && !hasShift && ((d.Kind == IT_REG && d.Cls == RC_D) || vecArrIs(d, 3, 2)) {
		simd.Movi64(p.Asm, d.Kind == IT_VREG, cast(uint64, imm), d.Reg)
		return true
	}
	if !isVecArr(d) || d.VEl > 2 || !intFits(imm) {
		setErr(p, "expected an 8b / 16b / 4h / 8h / 2s / 4s vector and an 8-bit immediate")
		return true
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	if d.VEl == 0 {
		if op != simd.MI_MOVI || hasShift {
			setErr(p, "only movi takes 8b / 16b, and without a shift")
			return true
		}
		simd.MoviBytes(p.Asm, q, cast(int, imm), d.Reg)
		return true
	}
	var shift int = 0
	if hasShift {
		var sh a64Item = its.It[2]
		if sh.Kind == IT_MSL && !logical && d.VEl == 2 {
			simd.MoviOnes(p.Asm, op == simd.MI_MVNI, q, cast(int, imm), sh.Amt, d.Reg)
			return true
		}
		if sh.Kind != IT_MOD || sh.Mod != MOD_LSL || !sh.AmtGiven {
			setErr(p, "expected lsl #amount (or msl #8 / #16 for movi / mvni on 2s / 4s)")
			return true
		}
		shift = sh.Amt
	}
	simd.ShiftedImm(p.Asm, op, q, d.VEl, cast(int, imm), shift, d.Reg)
	return true
}

// emitA64FMovVecImm parses and emits FMOV `Vd.<T>, #fpimm` (l positioned just after the
// mnemonic); returns false, having consumed nothing, when the operands are not a vector
// with an arrangement and an immediate.
func emitA64FMovVecImm(p @Parser, l Lexer) bool {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT { return false }
	reg, el, lanes, isVec := parseA64VecReg(tok.Text)
	if !isVec || lanes == 0 { return false }
	var t2 Token
	var l2 Lexer
	l2, t2 = LexNext(l)
	if t2.Kind != TOK_COMMA { return false }
	var t3 Token
	l2, t3 = LexNext(l2)
	if t3.Kind != TOK_HASH && t3.Kind != TOK_MINUS && t3.Kind != TOK_INT && t3.Kind != TOK_FLOAT {
		return false
	}
	var imm8 int = -1
	var zero bool = false
	l2, t3, imm8, zero = parseFMovImm(p, l2, t3)
	if p.HasError { return true }
	expectA64EOL(p, t3)
	if p.HasError { return true }
	if zero {
		setErr(p, "fmov: a vector has no #0.0 form (movi v0.2d, #0 clears it)")
		return true
	}
	q, okQ := vecArrQ(el, lanes)
	var ft int = vecFPType(el)
	if !okQ || ft < 0 || (ft == isa.FT_D && !q) {
		setErr(p, "fmov takes a 4h / 8h / 2s / 4s / 2d vector")
		return true
	}
	simd.FMovVecImm(p.Asm, ft, q, imm8, reg)
	return true
}
