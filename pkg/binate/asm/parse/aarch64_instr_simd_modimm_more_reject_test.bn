package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Modified-immediate lines clang rejects: arrangements an operation does not take (1d
// always; 8b / 16b / 2d but for MOVI), immediates outside 0..255 or, for the 64-bit
// forms, with a byte other than 0x00 / 0xff, shifts an arrangement does not have
// (including `lsl #0` on the byte form, and MSL except MOVI / MVNI on 2s / 4s), and FMOV
// immediates clang too finds unencodable (zero among them).

func TestGoldenSimdModImmMoreReject1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "orr v5.8h, #-1")
	e = goldenReject(e, "orr v5.8h, #0x12, lsl #16")
	e = goldenReject(e, "orr v5.8h, #0x12, lsl #24")
	e = goldenReject(e, "orr v5.8h, #0x12, lsl #4")
	e = goldenReject(e, "orr v5.8h, #0x12, msl #8")
	e = goldenReject(e, "orr v5.8h, #0x12, msl #16")
	e = goldenReject(e, "orr v5.8h, #0x12, msl #0")
	e = goldenReject(e, "orr v5.2s, #256")
	e = goldenReject(e, "orr v5.2s, #-1")
	e = goldenReject(e, "orr v5.2s, #0x12, lsl #4")
	e = goldenReject(e, "orr v5.2s, #0x12, msl #8")
	e = goldenReject(e, "orr v5.2s, #0x12, msl #16")
	e = goldenReject(e, "orr v5.2s, #0x12, msl #0")
	e = goldenReject(e, "orr v5.4s, #256")
	e = goldenReject(e, "orr v5.4s, #-1")
	e = goldenReject(e, "orr v5.4s, #0x12, lsl #4")
	e = goldenReject(e, "orr v5.4s, #0x12, msl #8")
	e = goldenReject(e, "orr v5.4s, #0x12, msl #16")
	e = goldenReject(e, "orr v5.4s, #0x12, msl #0")
	e = goldenReject(e, "orr v5.1d, #0x12")
	e = goldenReject(e, "orr v5.1d, #255")
	e = goldenReject(e, "orr v5.1d, #256")
	e = goldenReject(e, "orr v5.1d, #-1")
	e = goldenReject(e, "orr v5.1d, #0x12, lsl #0")
	e = goldenReject(e, "orr v5.1d, #0x12, lsl #8")
	e = goldenReject(e, "orr v5.1d, #0x12, lsl #16")
	e = goldenReject(e, "orr v5.1d, #0x12, lsl #24")
	e = goldenReject(e, "orr v5.1d, #0x12, lsl #4")
	e = goldenReject(e, "orr v5.1d, #0x12, msl #8")
	e = goldenReject(e, "orr v5.1d, #0x12, msl #16")
	e = goldenReject(e, "orr v5.1d, #0x12, msl #0")
	e = goldenReject(e, "orr v5.2d, #0x12")
	e = goldenReject(e, "orr v5.2d, #255")
	e = goldenReject(e, "orr v5.2d, #256")
	e = goldenReject(e, "orr v5.2d, #-1")
	e = goldenReject(e, "orr v5.2d, #0x12, lsl #0")
	e = goldenReject(e, "orr v5.2d, #0x12, lsl #8")
	e = goldenReject(e, "orr v5.2d, #0x12, lsl #16")
	e = goldenReject(e, "orr v5.2d, #0x12, lsl #24")
	e = goldenReject(e, "orr v5.2d, #0x12, lsl #4")
	e = goldenReject(e, "orr v5.2d, #0x12, msl #8")
	e = goldenReject(e, "orr v5.2d, #0x12, msl #16")
	e = goldenReject(e, "orr v5.2d, #0x12, msl #0")
	e = goldenReject(e, "bic v5.8b, #0x12")
	e = goldenReject(e, "bic v5.8b, #255")
	e = goldenReject(e, "bic v5.8b, #256")
	e = goldenReject(e, "bic v5.8b, #-1")
	e = goldenReject(e, "bic v5.8b, #0x12, lsl #0")
	e = goldenReject(e, "bic v5.8b, #0x12, lsl #8")
	e = goldenReject(e, "bic v5.8b, #0x12, lsl #16")
	e = goldenReject(e, "bic v5.8b, #0x12, lsl #24")
	e = goldenReject(e, "bic v5.8b, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.8b, #0x12, msl #8")
	e = goldenReject(e, "bic v5.8b, #0x12, msl #16")
	e = goldenReject(e, "bic v5.8b, #0x12, msl #0")
	e = goldenReject(e, "bic v5.16b, #0x12")
	e = goldenReject(e, "bic v5.16b, #255")
	e = goldenReject(e, "bic v5.16b, #256")
	e = goldenReject(e, "bic v5.16b, #-1")
	e = goldenReject(e, "bic v5.16b, #0x12, lsl #0")
	return e
}

