	e = goldenReject(e, "bic v5.2d, #0x12, msl #16")
	e = goldenReject(e, "bic v5.2d, #0x12, msl #0")
	e = goldenReject(e, "movi d5, #0x1200")
	return e
}

func TestGoldenSimdModImmMoreReject3() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "movi v5.2d, #0x1200")
	e = goldenReject(e, "movi v5.1d, #0")
	e = goldenReject(e, "movi v5.1d, #0xff00ff00ff00ff00")
	e = goldenReject(e, "movi v5.1d, #0xffffffffffffffff")
	e = goldenReject(e, "movi v5.1d, #0x1200")
	e = goldenReject(e, "movi v5.1d, #0xff")
	e = goldenReject(e, "movi s5, #0")
	e = goldenReject(e, "movi s5, #0xff00ff00ff00ff00")
	e = goldenReject(e, "movi s5, #0xffffffffffffffff")
	e = goldenReject(e, "movi s5, #0x1200")
	e = goldenReject(e, "movi s5, #0xff")
	e = goldenReject(e, "movi v5.16b, #0xff00ff00ff00ff00")
	e = goldenReject(e, "movi v5.16b, #0xffffffffffffffff")
	e = goldenReject(e, "movi v5.16b, #0x1200")
	e = goldenReject(e, "fmov v5.8b, #1.0")
	e = goldenReject(e, "fmov v5.8b, #-2.5")
	e = goldenReject(e, "fmov v5.8b, #1")
	e = goldenReject(e, "fmov v5.8b, #0x70")
	e = goldenReject(e, "fmov v5.8b, #0.0")
	e = goldenReject(e, "fmov v5.8b, #31.0")
	e = goldenReject(e, "fmov v5.8b, #0.125")
	e = goldenReject(e, "fmov v5.16b, #1.0")
	e = goldenReject(e, "fmov v5.16b, #-2.5")
	e = goldenReject(e, "fmov v5.16b, #1")
	e = goldenReject(e, "fmov v5.16b, #0x70")
	e = goldenReject(e, "fmov v5.16b, #0.0")
	e = goldenReject(e, "fmov v5.16b, #31.0")
	e = goldenReject(e, "fmov v5.16b, #0.125")
	e = goldenReject(e, "fmov v5.4h, #0.0")
	e = goldenReject(e, "fmov v5.8h, #0.0")
	e = goldenReject(e, "fmov v5.2s, #0.0")
	e = goldenReject(e, "fmov v5.4s, #0.0")
	e = goldenReject(e, "fmov v5.1d, #1.0")
	e = goldenReject(e, "fmov v5.1d, #-2.5")
	e = goldenReject(e, "fmov v5.1d, #1")
	e = goldenReject(e, "fmov v5.1d, #0x70")
	e = goldenReject(e, "fmov v5.1d, #0.0")
	e = goldenReject(e, "fmov v5.1d, #31.0")
	e = goldenReject(e, "fmov v5.1d, #0.125")
	e = goldenReject(e, "fmov v5.2d, #0.0")
	e = goldenReject(e, "movi v0.4s, #0x12, msl #24")
	e = goldenReject(e, "mvni v0.4h, #1, msl #8")
	e = goldenReject(e, "orr v0.4s, #1, msl #8")
	e = goldenReject(e, "fmov v0.4s, #0.0")
	e = goldenReject(e, "fmov v0.4s, #1e-400")
	e = goldenReject(e, "fmov v0.1d, #1.0")
	e = goldenReject(e, "fmov v0.4s, #1.1")
	e = goldenReject(e, "movi x0, #1")
	e = goldenReject(e, "movi v0.4s, #0x12, lsl")
	e = goldenReject(e, "movi v0.4s, #-1")
	e = goldenReject(e, "movi v0.16b, #-1")
	return e
}

// The vector FMOV's zero and out-of-range raw encodings, an MSL modifier where no
// instruction takes one or with no amount, and a load from a label named like a modifier.
func TestGoldenSimdModImmSpellingReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fmov v0.4s, #0")
	e = goldenReject(e, "fmov v0.4s, #-0.0")
	e = goldenReject(e, "fmov v0.4s, #-0x70")
	e = goldenReject(e, "fmov v0.4s, #0x100")
	e = goldenReject(e, "add x0, x1, x2, msl #8")
	e = goldenReject(e, "orr v0.16b, v1.16b, v2.16b, msl #8")
	e = goldenReject(e, "movi v0.2s, #1, msl")
	e = goldenReject(e, "ldr x0, msl")
	e = goldenReject(e, "ldr w1, msl")
	e = goldenReject(e, "ldrsw x0, msl")
	e = goldenReject(e, "ldr d0, msl")
	e = goldenReject(e, "ldr q0, msl")
	e = goldenReject(e, "ldr x0, lsl")
	return e
}
