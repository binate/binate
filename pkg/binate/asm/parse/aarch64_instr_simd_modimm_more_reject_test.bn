	var e @[]char = ""
	e = goldenReject(e, "bic v5.16b, #0x12, lsl #8")
	e = goldenReject(e, "bic v5.16b, #0x12, lsl #16")
	e = goldenReject(e, "bic v5.16b, #0x12, lsl #24")
	e = goldenReject(e, "bic v5.16b, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.16b, #0x12, msl #8")
	e = goldenReject(e, "bic v5.16b, #0x12, msl #16")
	e = goldenReject(e, "bic v5.16b, #0x12, msl #0")
	e = goldenReject(e, "bic v5.4h, #256")
	e = goldenReject(e, "bic v5.4h, #-1")
	e = goldenReject(e, "bic v5.4h, #0x12, lsl #16")
	e = goldenReject(e, "bic v5.4h, #0x12, lsl #24")
	e = goldenReject(e, "bic v5.4h, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.4h, #0x12, msl #8")
	e = goldenReject(e, "bic v5.4h, #0x12, msl #16")
	e = goldenReject(e, "bic v5.4h, #0x12, msl #0")
	e = goldenReject(e, "bic v5.8h, #256")
	e = goldenReject(e, "bic v5.8h, #-1")
	e = goldenReject(e, "bic v5.8h, #0x12, lsl #16")
	e = goldenReject(e, "bic v5.8h, #0x12, lsl #24")
	e = goldenReject(e, "bic v5.8h, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.8h, #0x12, msl #8")
	e = goldenReject(e, "bic v5.8h, #0x12, msl #16")
	e = goldenReject(e, "bic v5.8h, #0x12, msl #0")
	e = goldenReject(e, "bic v5.2s, #256")
	e = goldenReject(e, "bic v5.2s, #-1")
	e = goldenReject(e, "bic v5.2s, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.2s, #0x12, msl #8")
	e = goldenReject(e, "bic v5.2s, #0x12, msl #16")
	e = goldenReject(e, "bic v5.2s, #0x12, msl #0")
	e = goldenReject(e, "bic v5.4s, #256")
	e = goldenReject(e, "bic v5.4s, #-1")
	e = goldenReject(e, "bic v5.4s, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.4s, #0x12, msl #8")
	e = goldenReject(e, "bic v5.4s, #0x12, msl #16")
	e = goldenReject(e, "bic v5.4s, #0x12, msl #0")
	e = goldenReject(e, "bic v5.1d, #0x12")
	e = goldenReject(e, "bic v5.1d, #255")
	e = goldenReject(e, "bic v5.1d, #256")
	e = goldenReject(e, "bic v5.1d, #-1")
	e = goldenReject(e, "bic v5.1d, #0x12, lsl #0")
	e = goldenReject(e, "bic v5.1d, #0x12, lsl #8")
	e = goldenReject(e, "bic v5.1d, #0x12, lsl #16")
	e = goldenReject(e, "bic v5.1d, #0x12, lsl #24")
	e = goldenReject(e, "bic v5.1d, #0x12, lsl #4")
	e = goldenReject(e, "bic v5.1d, #0x12, msl #8")
	e = goldenReject(e, "bic v5.1d, #0x12, msl #16")
	e = goldenReject(e, "bic v5.1d, #0x12, msl #0")
	e = goldenReject(e, "bic v5.2d, #0x12")
	e = goldenReject(e, "bic v5.2d, #255")
	e = goldenReject(e, "bic v5.2d, #256")
	e = goldenReject(e, "bic v5.2d, #-1")
	e = goldenReject(e, "bic v5.2d, #0x12, lsl #0")
	e = goldenReject(e, "bic v5.2d, #0x12, lsl #8")
