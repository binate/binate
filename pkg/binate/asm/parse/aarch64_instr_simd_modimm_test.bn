package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the Advanced SIMD modified-immediate instructions — MOVI / MVNI / ORR /
// BIC at each arrangement, immediate and shift they take, MOVI's 64-bit patterns, and the
// vector FMOV — beside the integer and register ORR / BIC and a branch to a label named
// msl, from clang (`clang -c -target aarch64-linux-gnu -march=armv8.6-a+fp16`).

func TestGoldenSimdModImm1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "movi v5.8b, #0x12", 0x0F00E645)
	e = goldenWord(e, "movi v5.8b, #255", 0x0F07E7E5)
	e = goldenWord(e, "movi v5.16b, #0x12", 0x4F00E645)
	e = goldenWord(e, "movi v5.16b, #255", 0x4F07E7E5)
	e = goldenWord(e, "movi v5.4h, #0x12", 0x0F008645)
	e = goldenWord(e, "movi v5.4h, #255", 0x0F0787E5)
	e = goldenWord(e, "movi v5.4h, #0x12, lsl #0", 0x0F008645)
	e = goldenWord(e, "movi v5.4h, #0x12, lsl #8", 0x0F00A645)
	e = goldenWord(e, "movi v5.8h, #0x12", 0x4F008645)
	e = goldenWord(e, "movi v5.8h, #255", 0x4F0787E5)
	e = goldenWord(e, "movi v5.8h, #0x12, lsl #0", 0x4F008645)
	e = goldenWord(e, "movi v5.8h, #0x12, lsl #8", 0x4F00A645)
	e = goldenWord(e, "movi v5.2s, #0x12", 0x0F000645)
	e = goldenWord(e, "movi v5.2s, #255", 0x0F0707E5)
	e = goldenWord(e, "movi v5.2s, #0x12, lsl #0", 0x0F000645)
	e = goldenWord(e, "movi v5.2s, #0x12, lsl #8", 0x0F002645)
	e = goldenWord(e, "movi v5.2s, #0x12, lsl #16", 0x0F004645)
	e = goldenWord(e, "movi v5.2s, #0x12, lsl #24", 0x0F006645)
	e = goldenWord(e, "movi v5.2s, #0x12, msl #8", 0x0F00C645)
	e = goldenWord(e, "movi v5.2s, #0x12, msl #16", 0x0F00D645)
	e = goldenWord(e, "movi v5.4s, #0x12", 0x4F000645)
	e = goldenWord(e, "movi v5.4s, #255", 0x4F0707E5)
	e = goldenWord(e, "movi v5.4s, #0x12, lsl #0", 0x4F000645)
	e = goldenWord(e, "movi v5.4s, #0x12, lsl #8", 0x4F002645)
	e = goldenWord(e, "movi v5.4s, #0x12, lsl #16", 0x4F004645)
	e = goldenWord(e, "movi v5.4s, #0x12, lsl #24", 0x4F006645)
	e = goldenWord(e, "movi v5.4s, #0x12, msl #8", 0x4F00C645)
	e = goldenWord(e, "movi v5.4s, #0x12, msl #16", 0x4F00D645)
	e = goldenWord(e, "movi v5.2d, #255", 0x6F00E425)
	e = goldenWord(e, "movi v5.2d, #-1", 0x6F07E7E5)
	e = goldenWord(e, "mvni v5.4h, #0x12", 0x2F008645)
	e = goldenWord(e, "mvni v5.4h, #255", 0x2F0787E5)
	e = goldenWord(e, "mvni v5.4h, #0x12, lsl #0", 0x2F008645)
	e = goldenWord(e, "mvni v5.4h, #0x12, lsl #8", 0x2F00A645)
	e = goldenWord(e, "mvni v5.8h, #0x12", 0x6F008645)
	e = goldenWord(e, "mvni v5.8h, #255", 0x6F0787E5)
	e = goldenWord(e, "mvni v5.8h, #0x12, lsl #0", 0x6F008645)
	e = goldenWord(e, "mvni v5.8h, #0x12, lsl #8", 0x6F00A645)
	e = goldenWord(e, "mvni v5.2s, #0x12", 0x2F000645)
	e = goldenWord(e, "mvni v5.2s, #255", 0x2F0707E5)
	e = goldenWord(e, "mvni v5.2s, #0x12, lsl #0", 0x2F000645)
	e = goldenWord(e, "mvni v5.2s, #0x12, lsl #8", 0x2F002645)
	e = goldenWord(e, "mvni v5.2s, #0x12, lsl #16", 0x2F004645)
	e = goldenWord(e, "mvni v5.2s, #0x12, lsl #24", 0x2F006645)
	e = goldenWord(e, "mvni v5.2s, #0x12, msl #8", 0x2F00C645)
	e = goldenWord(e, "mvni v5.2s, #0x12, msl #16", 0x2F00D645)
	e = goldenWord(e, "mvni v5.4s, #0x12", 0x6F000645)
	e = goldenWord(e, "mvni v5.4s, #255", 0x6F0707E5)
	e = goldenWord(e, "mvni v5.4s, #0x12, lsl #0", 0x6F000645)
	e = goldenWord(e, "mvni v5.4s, #0x12, lsl #8", 0x6F002645)
	return e
}

func TestGoldenSimdModImm2() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "mvni v5.4s, #0x12, lsl #16", 0x6F004645)
	e = goldenWord(e, "mvni v5.4s, #0x12, lsl #24", 0x6F006645)
	e = goldenWord(e, "mvni v5.4s, #0x12, msl #8", 0x6F00C645)
	e = goldenWord(e, "mvni v5.4s, #0x12, msl #16", 0x6F00D645)
	e = goldenWord(e, "orr v5.4h, #0x12", 0x0F009645)
	e = goldenWord(e, "orr v5.4h, #255", 0x0F0797E5)
	e = goldenWord(e, "orr v5.4h, #0x12, lsl #0", 0x0F009645)
	e = goldenWord(e, "orr v5.4h, #0x12, lsl #8", 0x0F00B645)
	e = goldenWord(e, "orr v5.8h, #0x12", 0x4F009645)
	e = goldenWord(e, "orr v5.8h, #255", 0x4F0797E5)
	e = goldenWord(e, "orr v5.8h, #0x12, lsl #0", 0x4F009645)
	e = goldenWord(e, "orr v5.8h, #0x12, lsl #8", 0x4F00B645)
	e = goldenWord(e, "orr v5.2s, #0x12", 0x0F001645)
	e = goldenWord(e, "orr v5.2s, #255", 0x0F0717E5)
	e = goldenWord(e, "orr v5.2s, #0x12, lsl #0", 0x0F001645)
	e = goldenWord(e, "orr v5.2s, #0x12, lsl #8", 0x0F003645)
	e = goldenWord(e, "orr v5.2s, #0x12, lsl #16", 0x0F005645)
	e = goldenWord(e, "orr v5.2s, #0x12, lsl #24", 0x0F007645)
	e = goldenWord(e, "orr v5.4s, #0x12", 0x4F001645)
	e = goldenWord(e, "orr v5.4s, #255", 0x4F0717E5)
	e = goldenWord(e, "orr v5.4s, #0x12, lsl #0", 0x4F001645)
	e = goldenWord(e, "orr v5.4s, #0x12, lsl #8", 0x4F003645)
	e = goldenWord(e, "orr v5.4s, #0x12, lsl #16", 0x4F005645)
	e = goldenWord(e, "orr v5.4s, #0x12, lsl #24", 0x4F007645)
	e = goldenWord(e, "bic v5.4h, #0x12", 0x2F009645)
	e = goldenWord(e, "bic v5.4h, #255", 0x2F0797E5)
	e = goldenWord(e, "bic v5.4h, #0x12, lsl #0", 0x2F009645)
	e = goldenWord(e, "bic v5.4h, #0x12, lsl #8", 0x2F00B645)
	e = goldenWord(e, "bic v5.8h, #0x12", 0x6F009645)
	e = goldenWord(e, "bic v5.8h, #255", 0x6F0797E5)
	e = goldenWord(e, "bic v5.8h, #0x12, lsl #0", 0x6F009645)
	e = goldenWord(e, "bic v5.8h, #0x12, lsl #8", 0x6F00B645)
	e = goldenWord(e, "bic v5.2s, #0x12", 0x2F001645)
	e = goldenWord(e, "bic v5.2s, #255", 0x2F0717E5)
	e = goldenWord(e, "bic v5.2s, #0x12, lsl #0", 0x2F001645)
	e = goldenWord(e, "bic v5.2s, #0x12, lsl #8", 0x2F003645)
	e = goldenWord(e, "bic v5.2s, #0x12, lsl #16", 0x2F005645)
	e = goldenWord(e, "bic v5.2s, #0x12, lsl #24", 0x2F007645)
	e = goldenWord(e, "bic v5.4s, #0x12", 0x6F001645)
	e = goldenWord(e, "bic v5.4s, #255", 0x6F0717E5)
	e = goldenWord(e, "bic v5.4s, #0x12, lsl #0", 0x6F001645)
	e = goldenWord(e, "bic v5.4s, #0x12, lsl #8", 0x6F003645)
	e = goldenWord(e, "bic v5.4s, #0x12, lsl #16", 0x6F005645)
	e = goldenWord(e, "bic v5.4s, #0x12, lsl #24", 0x6F007645)
	e = goldenWord(e, "movi d5, #0", 0x2F00E405)
	e = goldenWord(e, "movi d5, #0xff00ff00ff00ff00", 0x2F05E545)
	e = goldenWord(e, "movi d5, #0xffffffffffffffff", 0x2F07E7E5)
	e = goldenWord(e, "movi d5, #0xff", 0x2F00E425)
	e = goldenWord(e, "movi v5.2d, #0", 0x6F00E405)
	e = goldenWord(e, "movi v5.2d, #0xff00ff00ff00ff00", 0x6F05E545)
	return e
}

func TestGoldenSimdModImm3() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "movi v5.2d, #0xffffffffffffffff", 0x6F07E7E5)
	e = goldenWord(e, "movi v5.2d, #0xff", 0x6F00E425)
	e = goldenWord(e, "movi v5.16b, #0", 0x4F00E405)
	e = goldenWord(e, "movi v5.16b, #0xff", 0x4F07E7E5)
	e = goldenWord(e, "fmov v5.4h, #1.0", 0x0F03FE05)
	e = goldenWord(e, "fmov v5.4h, #-2.5", 0x0F04FC85)
	e = goldenWord(e, "fmov v5.4h, #1", 0x0F03FE05)
	e = goldenWord(e, "fmov v5.4h, #0x70", 0x0F03FE05)
	e = goldenWord(e, "fmov v5.4h, #31.0", 0x0F01FFE5)
	e = goldenWord(e, "fmov v5.4h, #0.125", 0x0F02FC05)
	e = goldenWord(e, "fmov v5.8h, #1.0", 0x4F03FE05)
	e = goldenWord(e, "fmov v5.8h, #-2.5", 0x4F04FC85)
	e = goldenWord(e, "fmov v5.8h, #1", 0x4F03FE05)
	e = goldenWord(e, "fmov v5.8h, #0x70", 0x4F03FE05)
	e = goldenWord(e, "fmov v5.8h, #31.0", 0x4F01FFE5)
	e = goldenWord(e, "fmov v5.8h, #0.125", 0x4F02FC05)
	e = goldenWord(e, "fmov v5.2s, #1.0", 0x0F03F605)
	e = goldenWord(e, "fmov v5.2s, #-2.5", 0x0F04F485)
	e = goldenWord(e, "fmov v5.2s, #1", 0x0F03F605)
	e = goldenWord(e, "fmov v5.2s, #0x70", 0x0F03F605)
	e = goldenWord(e, "fmov v5.2s, #31.0", 0x0F01F7E5)
	e = goldenWord(e, "fmov v5.2s, #0.125", 0x0F02F405)
	e = goldenWord(e, "fmov v5.4s, #1.0", 0x4F03F605)
	e = goldenWord(e, "fmov v5.4s, #-2.5", 0x4F04F485)
	e = goldenWord(e, "fmov v5.4s, #1", 0x4F03F605)
	e = goldenWord(e, "fmov v5.4s, #0x70", 0x4F03F605)
	e = goldenWord(e, "fmov v5.4s, #31.0", 0x4F01F7E5)
	e = goldenWord(e, "fmov v5.4s, #0.125", 0x4F02F405)
	e = goldenWord(e, "fmov v5.2d, #1.0", 0x6F03F605)
	e = goldenWord(e, "fmov v5.2d, #-2.5", 0x6F04F485)
	e = goldenWord(e, "fmov v5.2d, #1", 0x6F03F605)
	e = goldenWord(e, "fmov v5.2d, #0x70", 0x6F03F605)
	e = goldenWord(e, "fmov v5.2d, #31.0", 0x6F01F7E5)
	e = goldenWord(e, "fmov v5.2d, #0.125", 0x6F02F405)
	e = goldenWord(e, "movi v31.2d, #0xff00", 0x6F00E45F)
	e = goldenWord(e, "MOVI V0.4S, #0XFF, MSL #16", 0x4F07D7E0)
	e = goldenWord(e, "mvni v31.8h, #0xab, lsl #8", 0x6F05A57F)
	e = goldenWord(e, "bic v0.4s, #255, lsl #24", 0x6F0777E0)
	e = goldenWord(e, "fmov v31.2d, #-31.0", 0x6F05F7FF)
	e = goldenWord(e, "FMOV V0.8H, #0.5", 0x4F03FC00)
	e = goldenWord(e, "movi v0.4s, #0x12, lsl 8", 0x4F002640)
	e = goldenWord(e, "orr x0, x1, #1", 0xB2400020)
	e = goldenWord(e, "bic w0, w1, w2", 0x0A220020)
	e = goldenWord(e, "orr v0.16b, v1.16b, v2.16b", 0x4EA21C20)
	e = goldenWord(e, "b msl", 0x14000000)
	return e
}

// Spellings of the vector FMOV immediate beyond `#`-prefixed decimals, MOVI's 64-bit pattern
// from a negative or an expression, and `msl` as a label where a symbol is expected.
func TestGoldenSimdModImmSpellings() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "fmov v0.4s, 1.0", 0x4F03F600)
	e = goldenWord(e, "fmov v0.4s, -2.5", 0x4F04F480)
	e = goldenWord(e, "fmov v0.4s, #01", 0x4F03F600)
	e = goldenWord(e, "fmov v0.2d, #0x00", 0x6F00F400)
	e = goldenWord(e, "movi d0, #-1", 0x2F07E7E0)
	e = goldenWord(e, "movi d0, #(0xff << 8)", 0x2F00E440)
	e = goldenWord(e, "adr x0, msl", 0x10000000)
	e = goldenWord(e, "adr x0, msl+4", 0x10000000)
	e = goldenWord(e, "prfm pldl1keep, msl", 0xD8000000)
	e = goldenWord(e, "prfm pldl1keep, lsl", 0xD8000000)
	e = goldenWord(e, "prfm pldl1keep, uxtw", 0xD8000000)
	e = goldenWord(e, "prfm #5, msl", 0xD8000005)
	return e
}
