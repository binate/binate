package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD permutes and extract: UZP1 / UZP2 / TRN1 / TRN2 / ZIP1 / ZIP2
// `Vd.<T>, Vn.<T>, Vm.<T>` on 8b / 16b / 4h / 8h / 2s / 4s / 2d, and EXT `Vd.<T>, Vn.<T>,
// Vm.<T>, #index` on 8b (index 0..7) or 16b (0..15), the index an expression with or
// without `#`.  An EXT index outside the vector is an error, not wrapped into range.

// simdPermuteOf returns the simd.PERM_* permute of a mnemonic, or -1.
func simdPermuteOf(m *[]readonly char) int {
	if mnemIs(m, "uzp1") { return simd.PERM_UZP1 }
	if mnemIs(m, "trn1") { return simd.PERM_TRN1 }
	if mnemIs(m, "zip1") { return simd.PERM_ZIP1 }
	if mnemIs(m, "uzp2") { return simd.PERM_UZP2 }
	if mnemIs(m, "trn2") { return simd.PERM_TRN2 }
	if mnemIs(m, "zip2") { return simd.PERM_ZIP2 }
	return -1
}

// emitA64SimdPermute parses and emits a permute or EXT (l positioned just after the
// mnemonic); returns false for any other mnemonic.
func emitA64SimdPermute(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var op int = simdPermuteOf(mnem)
	var ext bool = mnemIs(mnem, "ext")
	if op < 0 && !ext { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	if ext {
		emitA64Ext(p, its)
		return true
	}
	if !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	if !sameVecArr(d, its.It[1]) || !sameVecArr(d, its.It[2]) {
		setErr(p, "expected three vectors of one arrangement")
		return true
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	simd.Permute(p.Asm, op, q, d.VEl, d.Reg, its.It[1].Reg, its.It[2].Reg)
	return true
}

// emitA64Ext emits EXT from its operands: three 8b or three 16b vectors and the index.
func emitA64Ext(p @Parser, its a64Items) {
	if !dpExpectCount(p, its, 4) { return }
	var d a64Item = its.It[0]
	var ix a64Item = its.It[3]
	if !isByteVec(d) || !sameVecArr(d, its.It[1]) || !sameVecArr(d, its.It[2]) || ix.Kind != IT_IMM {
		setErr(p, "ext takes Vd.8b|16b, Vn.<T>, Vm.<T>, #index")
		return
	}
	if !intFits(ix.Imm) {
		setErr(p, "ext: the index is 0..7 for 8b, 0..15 for 16b")
		return
	}
	simd.Ext(p.Asm, d.VLanes == 16, d.Reg, its.It[1].Reg, its.It[2].Reg, cast(int, ix.Imm))
}
