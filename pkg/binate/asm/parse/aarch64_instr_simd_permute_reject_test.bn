	e = goldenReject(e, "zip1 v5.2b, v18.2b, v2.2b")
	e = goldenReject(e, "zip1 v5.1q, v18.1q, v2.1q")
	e = goldenReject(e, "zip2 v5.8b, v18.8b, v2.4h")
	e = goldenReject(e, "zip2 v5.8b, v18.16b, v2.8b")
	e = goldenReject(e, "zip2 v5.16b, v18.16b, v2.8h")
