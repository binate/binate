// EXT indexes outside the vector: clang accepts these and silently wraps them (8b #8
// assembles as #0, #-1 as #7), but the index is the number of a byte of Vn — 0..7 for
// 8b, 0..15 for 16b — and other values have no encoding, so an out-of-range index is an
// error (TestGoldenDeliberateRejects lists these with the other lines clang accepts).
func TestGoldenSimdPermuteReject5() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #8")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #9")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #10")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #11")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #12")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #13")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #14")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #15")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #16")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #17")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #-1")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #255")
	e = goldenReject(e, "ext v5.8b, v18.8b, v2.8b, #256")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #16")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #17")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #-1")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #255")
	e = goldenReject(e, "ext v5.16b, v18.16b, v2.16b, #256")
	return e
}
