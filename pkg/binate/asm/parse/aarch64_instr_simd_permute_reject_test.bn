package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Permute and EXT lines rejected: arrangements that differ in size or width, 1d, the
// partial arrangements and 1q, EXT on anything but 8b / 16b, lanes and scalar or general
// registers, and wrong operand counts.

