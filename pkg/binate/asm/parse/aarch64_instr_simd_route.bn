package "pkg/binate/asm/parse"

// Routing of the mnemonics shared by the integer data-processing instructions and the
// Advanced SIMD ones (ADD, SUB, MUL and the bitwise mnemonics; SMULL / UMULL; NEG, MVN,
// REV16 / REV32 / REV64, RBIT, CLS, CLZ): with a SIMD&FP destination they are the SIMD
// instructions.

// emitA64SimdFromDP emits a shared mnemonic's SIMD form from its scanned operands
// (whose destination is a SIMD&FP register); returns false when mnem has none.
func emitA64SimdFromDP(p @Parser, mnem *[]readonly char, its a64Items) bool {
	if emitA64Simd3Items(p, mnem, its) { return true }
	if emitA64Simd3DiffItems(p, mnem, its) { return true }
	return emitA64Simd2MiscItems(p, mnem, its)
}
