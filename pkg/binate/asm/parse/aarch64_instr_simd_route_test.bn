package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The integer and SIMD forms of the shared mnemonics side by side: each goes to its own
// instruction by its destination register (words from clang, `-march=armv8.6-a`).
func TestGoldenSimdRoute() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "neg x0, x1", 0xCB0103E0)
	e = goldenWord(e, "neg v31.2d, v0.2d", 0x6EE0B81F)
	e = goldenWord(e, "mvn x0, x1", 0xAA2103E0)
	e = goldenWord(e, "mvn v31.16b, v0.16b", 0x6E20581F)
	e = goldenWord(e, "rev16 w0, w1", 0x5AC00420)
	e = goldenWord(e, "rev64 x0, x1", 0xDAC00C20)
	e = goldenWord(e, "rbit x0, x1", 0xDAC00020)
	e = goldenWord(e, "cls w0, w1", 0x5AC01420)
	e = goldenWord(e, "clz x0, x1", 0xDAC01020)
	e = goldenWord(e, "rev32 x0, x1", 0xDAC00820)
	e = goldenWord(e, "smull x0, w1, w2", 0x9B227C20)
	return e
}
