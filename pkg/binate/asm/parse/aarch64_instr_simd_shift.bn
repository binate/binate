package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD shift-by-immediate instructions: the same-arrangement shifts
// `Vd.<T>, Vn.<T>, #shift` (SSHR … SRI, SHL, SLI, SQSHL / UQSHL / SQSHLU, and the
// fixed-point SCVTF / UCVTF / FCVTZS / FCVTZU with #fbits) and their scalar forms (D for
// the plain shifts; any size for the saturating ones; H / S / D for the conversions); the
// narrowing SHRN / RSHRN / SQSHRN / SQRSHRN / SQSHRUN / SQRSHRUN / UQSHRN / UQRSHRN
// (`Vd.<Tb>, Vn.<Ta>, #shift`, the "2" forms into the upper half; scalar `<Vb>d, <Va>n`
// for the saturating ones); and the long SSHLL / USHLL (`Vd.<Ta>, Vn.<Tb>, #shift`) with
// their SXTL / UXTL aliases (shift 0).  The shift is an expression, with or without `#`.
// SQSHL / UQSHL are also three-same instructions and the conversions also scalar FP ones;
// their parsers hand the immediate forms here.

// simdShiftBase returns the simd.SH_* operation of a mnemonic without a "2", or -1.
func simdShiftBase(m *[]readonly char) int {
	if mnemIs(m, "sshr") { return simd.SH_SSHR }
	if mnemIs(m, "ssra") { return simd.SH_SSRA }
	if mnemIs(m, "srshr") { return simd.SH_SRSHR }
	if mnemIs(m, "srsra") { return simd.SH_SRSRA }
	if mnemIs(m, "shl") { return simd.SH_SHL }
	if mnemIs(m, "sqshl") { return simd.SH_SQSHL }
	if mnemIs(m, "shrn") { return simd.SH_SHRN }
	if mnemIs(m, "rshrn") { return simd.SH_RSHRN }
	if mnemIs(m, "sqshrn") { return simd.SH_SQSHRN }
	if mnemIs(m, "sqrshrn") { return simd.SH_SQRSHRN }
	if mnemIs(m, "sshll") || mnemIs(m, "sxtl") { return simd.SH_SSHLL }
	if mnemIs(m, "scvtf") { return simd.SH_SCVTF }
	if mnemIs(m, "fcvtzs") { return simd.SH_FCVTZS }
	if mnemIs(m, "ushr") { return simd.SH_USHR }
	if mnemIs(m, "usra") { return simd.SH_USRA }
	if mnemIs(m, "urshr") { return simd.SH_URSHR }
	if mnemIs(m, "ursra") { return simd.SH_URSRA }
	if mnemIs(m, "sri") { return simd.SH_SRI }
	if mnemIs(m, "sli") { return simd.SH_SLI }
	if mnemIs(m, "sqshlu") { return simd.SH_SQSHLU }
	if mnemIs(m, "uqshl") { return simd.SH_UQSHL }
	if mnemIs(m, "sqshrun") { return simd.SH_SQSHRUN }
	if mnemIs(m, "sqrshrun") { return simd.SH_SQRSHRUN }
	if mnemIs(m, "uqshrn") { return simd.SH_UQSHRN }
	if mnemIs(m, "uqrshrn") { return simd.SH_UQRSHRN }
	if mnemIs(m, "ushll") || mnemIs(m, "uxtl") { return simd.SH_USHLL }
	if mnemIs(m, "ucvtf") { return simd.SH_UCVTF }
	if mnemIs(m, "fcvtzu") { return simd.SH_FCVTZU }
	return -1
}

// shNarrowOp reports whether op is a narrowing shift.
func shNarrowOp(op int) bool {
	return op == simd.SH_SHRN || op == simd.SH_RSHRN || op == simd.SH_SQSHRN ||
			op == simd.SH_SQRSHRN || op == simd.SH_SQSHRUN || op == simd.SH_SQRSHRUN ||
			op == simd.SH_UQSHRN || op == simd.SH_UQRSHRN
}

// simdShiftOf returns the simd.SH_* operation of a mnemonic, whether it is a "2" form
// (only the narrowing and long shifts have one) and whether it is SXTL / UXTL (no shift
// operand), or -1.
func simdShiftOf(m *[]readonly char) (int, bool, bool) {
	var xtl bool = mnemIs(m, "sxtl") || mnemIs(m, "uxtl")
	var op int = simdShiftBase(m)
	if op >= 0 { return op, false, xtl }
	if len(m) > 1 && m[len(m) - 1] == '2' {
		var base *[]readonly char = m[0:len(m) - 1]
		op = simdShiftBase(base)
		if shNarrowOp(op) || op == simd.SH_SSHLL || op == simd.SH_USHLL {
			return op, true, mnemIs(base, "sxtl") || mnemIs(base, "uxtl")
		}
	}
	return -1, false, false
}

// emitA64SimdShift parses and emits a shift by immediate that no other parser claims (l
// positioned just after the mnemonic); returns false for any other mnemonic.
func emitA64SimdShift(p @Parser, l Lexer, mnem *[]readonly char) bool {
	op, _, _ := simdShiftOf(mnem)
	if op < 0 { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok { return true }
	emitA64SimdShiftItems(p, mnem, its)
	return true
}

// emitA64SimdShiftItems emits a shift by immediate from its scanned operands; returns
// false (nothing done) when mnem is not one.
func emitA64SimdShiftItems(p @Parser, mnem *[]readonly char, its a64Items) bool {
	op, q2, xtl := simdShiftOf(mnem)
	if op < 0 { return false }
	var want int = 3
	if xtl { want = 2 }
	if !dpExpectCount(p, its, want) { return true }
	var d a64Item = its.It[0]
	var n a64Item = its.It[1]
	var shift int = 0
	if !xtl {
		var sh a64Item = its.It[2]
		if sh.Kind != IT_IMM || !intFits(sh.Imm) {
			setErr(p, "expected the shift amount, #imm")
			return true
		}
		shift = cast(int, sh.Imm)
	}
	var long bool = op == simd.SH_SSHLL || op == simd.SH_USHLL
	if d.Kind == IT_REG {
		var size int = scalarSize(d.Cls)
		var nsize int = -1
		if n.Kind == IT_REG { nsize = scalarSize(n.Cls) }
		var want2 int = size
		if shNarrowOp(op) { want2 = size + 1 }
		if size < 0 || nsize != want2 || q2 || long {
			setErr(p, "expected scalar registers of the sizes this shift takes")
			return true
		}
		simd.ShiftImmScalar(p.Asm, op, size, shift, d.Reg, n.Reg)
		return true
	}
	if shNarrowOp(op) || long {
		var tb a64Item = d
		if long { tb = n }
		var el int = tb.VEl
		var nl int = 8 >> el
		if q2 { nl = 16 >> el }
		var wl int = 16 >> (el + 1)
		var shapeOk bool = tb.Kind == IT_VREG && el <= 2 && vecArrIs(tb, el, nl)
		if long {
			shapeOk = shapeOk && vecArrIs(d, el + 1, wl)
		} else {
			shapeOk = shapeOk && vecArrIs(n, el + 1, wl)
		}
		if !shapeOk {
			setErr(p, "the arrangements do not match this narrowing / long shift")
			return true
		}
		simd.ShiftImm(p.Asm, op, q2, el, shift, d.Reg, n.Reg)
		return true
	}
	if !sameVecArr(d, n) {
		setErr(p, "expected two vectors of one arrangement")
		return true
	}
	q, _ := vecArrQ(d.VEl, d.VLanes)
	simd.ShiftImm(p.Asm, op, q, d.VEl, shift, d.Reg, n.Reg)
	return true
}
