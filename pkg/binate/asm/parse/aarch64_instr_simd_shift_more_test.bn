package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for the shift-by-immediate instructions — each mnemonic's every shape
// (vector, scalar, narrowing and long, the "2" forms) at its smallest and largest shift,
// the SXTL / UXTL aliases, the shift as an expression or without `#`, and the register
// SQSHL / UQSHL and the general-purpose fixed-point conversions beside them — from clang
// (`clang -c -target aarch64-linux-gnu -march=armv8.6-a+fp16`).

func TestGoldenSimdShiftMore1() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "scvtf v5.2d, v18.2d, #1", 0x4F7FE645)
	e = goldenWord(e, "scvtf v5.2d, v18.2d, #64", 0x4F40E645)
