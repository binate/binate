	e = goldenWord(e, "ucvtf v5.4s, v18.4s, #32", 0x6F20E645)
	e = goldenWord(e, "ucvtf v5.2d, v18.2d, #1", 0x6F7FE645)
	e = goldenWord(e, "ucvtf v5.2d, v18.2d, #64", 0x6F40E645)
