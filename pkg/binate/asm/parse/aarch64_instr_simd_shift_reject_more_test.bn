// Each right shift and fixed-point conversion one past its largest shift (esize + 1 —
// larger would wrap into another element size or class), shapes the matrix does not reach
// (1d, a plain shift on a B / H / S scalar, a conversion on B, mismatched arrangements, a
// lane), and a conversion with no fixed-point form taking an immediate.
func TestGoldenSimdShiftBoundaryReject() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcvtns v0.4s, v1.4s, #3")
	e = goldenReject(e, "fcvtns s0, s1, #3")
	e = goldenReject(e, "fcvtpu h0, h1, #2")
	e = goldenReject(e, "fcvtas v0.2d, v1.2d, #3")
	e = goldenReject(e, "fcvtmu d0, d1, #1")
	e = goldenReject(e, "fcvtns v0.4s, x1, #3")
	e = goldenReject(e, "sshr v0.8b, v1.8b, #9")
	e = goldenReject(e, "sshr v0.2d, v1.2d, #65")
	e = goldenReject(e, "ushr v0.4h, v1.4h, #17")
	e = goldenReject(e, "ssra v0.2s, v1.2s, #33")
	e = goldenReject(e, "srshr v0.16b, v1.16b, #9")
	e = goldenReject(e, "ursra v0.4s, v1.4s, #33")
	e = goldenReject(e, "sri d0, d1, #65")
	e = goldenReject(e, "sri v0.8h, v1.8h, #17")
	e = goldenReject(e, "fcvtzs d0, d1, #65")
	e = goldenReject(e, "fcvtzs h0, h1, #17")
	e = goldenReject(e, "fcvtzu s0, s1, #33")
	e = goldenReject(e, "scvtf v0.2d, v1.2d, #65")
	e = goldenReject(e, "scvtf v0.4h, v1.4h, #17")
	e = goldenReject(e, "ucvtf v0.4s, v1.4s, #33")
	e = goldenReject(e, "sshr v0.1d, v1.1d, #3")
	e = goldenReject(e, "sshr s0, s1, #3")
	e = goldenReject(e, "sri s0, s1, #3")
	e = goldenReject(e, "sli h0, h1, #3")
	e = goldenReject(e, "shl b0, b1, #3")
	e = goldenReject(e, "scvtf v0.8b, v1.8b, #3")
	e = goldenReject(e, "scvtf b0, b1, #3")
	e = goldenReject(e, "sshr v0.4s, v1.2s, #3")
	e = goldenReject(e, "sshr v0.4s, v1.s[1], #3")
	e = goldenReject(e, "sqshl v0.4s, v1.2s, #3")
	return e
}
