package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Shift-by-immediate lines clang rejects: each shape at the shift just below and just above
// its range, the shapes a mnemonic does not take whose operands each appear in one it
// does, and wrong operand counts or kinds.

func TestGoldenSimdShiftRejectMore1() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "fcvtzu d5, d18, #0")
	e = goldenReject(e, "shrn v5.8b, v18.8h, #0")
