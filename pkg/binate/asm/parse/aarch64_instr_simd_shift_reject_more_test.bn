	e = goldenReject(e, "rshrn2 v5.8h, v18.8h, #16")
	e = goldenReject(e, "rshrn2 v5.4s, v18.4s, #16")
	e = goldenReject(e, "sqshrn v5.8b, v18.8h, #0")
	e = goldenReject(e, "sqshrn v5.8b, v18.8h, #9")
