package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa/simd"

// AArch64 Advanced SIMD table lookup: TBL / TBX `Vd.<T>, {Vn.16b, …}, Vm.<T>`, <T> 8b or
// 16b (the same for Vd and Vm), with a table of one to four registers written as a
// list (`{v1.16b, v2.16b}`) or a range (`{v1.16b-v4.16b}`).

// isByteVec reports whether item it is a whole 8b or 16b vector.
func isByteVec(it a64Item) bool {
	return isVecArr(it) && it.VEl == 0
}

// emitA64SimdTable parses and emits TBL / TBX (l positioned just after the mnemonic);
// returns false when mnem is neither.
func emitA64SimdTable(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var tbx bool = mnemIs(mnem, "tbx")
	if !tbx && !mnemIs(mnem, "tbl") { return false }
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	if !ok || !dpExpectCount(p, its, 3) { return true }
	var d a64Item = its.It[0]
	var t a64Item = its.It[1]
	var m a64Item = its.It[2]
	if !isByteVec(d) || !isByteVec(m) || d.VLanes != m.VLanes || t.Kind != IT_VLIST || t.VEl != 0 ||
			t.VLanes != 16 || t.Lane >= 0 {
		setErr(p, "tbl / tbx take Vd.8b|16b, {Vn.16b, …}, Vm.8b|16b")
		return true
	}
	simd.TableLookup(p.Asm, d.VLanes == 16, tbx, d.Reg, t.Reg, t.VCount, m.Reg)
	return true
}
