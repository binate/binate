package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Golden words for TBL / TBX (both widths, tables of one to four registers, wrapping past
// V31, the range form, spacing and case), from clang (`clang -c -target
// aarch64-linux-gnu -march=armv8.6-a`).

func TestGoldenSimdTable() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "tbl v2.8b, {v5.16b}, v9.8b", 0x0E0900A2)
	e = goldenWord(e, "tbl v2.8b, {v5.16b, v6.16b}, v9.8b", 0x0E0920A2)
	e = goldenWord(e, "tbl v2.8b, {v5.16b, v6.16b, v7.16b}, v9.8b", 0x0E0940A2)
	e = goldenWord(e, "tbl v2.8b, {v5.16b, v6.16b, v7.16b, v8.16b}, v9.8b", 0x0E0960A2)
	e = goldenWord(e, "tbl v2.16b, {v5.16b}, v9.16b", 0x4E0900A2)
	e = goldenWord(e, "tbl v2.16b, {v5.16b, v6.16b}, v9.16b", 0x4E0920A2)
	e = goldenWord(e, "tbl v2.16b, {v5.16b, v6.16b, v7.16b}, v9.16b", 0x4E0940A2)
	e = goldenWord(e, "tbl v2.16b, {v5.16b, v6.16b, v7.16b, v8.16b}, v9.16b", 0x4E0960A2)
	e = goldenWord(e, "tbx v2.8b, {v5.16b}, v9.8b", 0x0E0910A2)
	e = goldenWord(e, "tbx v2.8b, {v5.16b, v6.16b}, v9.8b", 0x0E0930A2)
	e = goldenWord(e, "tbx v2.8b, {v5.16b, v6.16b, v7.16b}, v9.8b", 0x0E0950A2)
	e = goldenWord(e, "tbx v2.8b, {v5.16b, v6.16b, v7.16b, v8.16b}, v9.8b", 0x0E0970A2)
	e = goldenWord(e, "tbx v2.16b, {v5.16b}, v9.16b", 0x4E0910A2)
	e = goldenWord(e, "tbx v2.16b, {v5.16b, v6.16b}, v9.16b", 0x4E0930A2)
	e = goldenWord(e, "tbx v2.16b, {v5.16b, v6.16b, v7.16b}, v9.16b", 0x4E0950A2)
	e = goldenWord(e, "tbx v2.16b, {v5.16b, v6.16b, v7.16b, v8.16b}, v9.16b", 0x4E0970A2)
	e = goldenWord(e, "tbl v0.16b, {v31.16b, v0.16b}, v3.16b", 0x4E0323E0)
	e = goldenWord(e, "tbl v0.16b, {v30.16b, v31.16b, v0.16b, v1.16b}, v3.16b", 0x4E0363C0)
	e = goldenWord(e, "tbl v0.16b, {v1.16b-v2.16b}, v3.16b", 0x4E032020)
	e = goldenWord(e, "tbl v0.16b, {v1.16b - v4.16b}, v3.16b", 0x4E036020)
	e = goldenWord(e, "tbl v0.16b, {v30.16b-v1.16b}, v3.16b", 0x4E0363C0)
	e = goldenWord(e, "tbx v0.8b, {v31.16b-v0.16b}, v3.8b", 0x0E0333E0)
	e = goldenWord(e, "tbl v0.16b, { v1.16b }, v3.16b", 0x4E030020)
	e = goldenWord(e, "tbl v0.16b, {v1.16b,v2.16b}, v3.16b", 0x4E032020)
	e = goldenWord(e, "TBL V0.16B, {V1.16B, V2.16B}, V3.16B", 0x4E032020)
	e = goldenWord(e, "tbl v0.16b, {V1.16b, v2.16b}, v3.16b", 0x4E032020)
	e = goldenWord(e, "tbl v0.16b, {v1.16b-V2.16b}, v3.16b", 0x4E032020)
	e = goldenWord(e, "tbx v31.16b, {v31.16b}, v31.16b", 0x4E1F13FF)
	e = goldenWord(e, "tbl v0.16b, {v1.16b, v2.16b} , v3.16b", 0x4E032020)
	return e
}

// Register lists and operands clang rejects: non-consecutive or mixed-size entries, a
// suffix differing only in case, a range of one or more than four registers, a range
// mixed with commas, empty or unterminated lists, entries that are not vector registers
// with an arrangement, a table not of 16b registers, a lane on the table, and mismatched
// or out-of-range Vd / Vm.
func TestGoldenSimdTableRejects() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "tbl v0.16b, {v1.16b, v3.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b, v2.8b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-v2.8b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16B, V2.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-v5.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v2.16b-v1.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-v1.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b - v1.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b, v2.16b, v3.16b, v4.16b, v5.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-v2.16b, v3.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b, v2.16b, v3.16b-v4.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-v2.16b-v3.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-v2.16b,}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b,}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {-v2.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b-}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b, , v2.16b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b} v3.16b")
	e = goldenReject(e, "tbl v0.16b, {q1, q2}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1, v2}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {x1}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.3b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.8b}, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b}[1], v3.16b")
	e = goldenReject(e, "tbl v0.4s, {v1.16b}, v3.4s")
	e = goldenReject(e, "tbl v0.16b, {v1.16b}, v3.8b")
	e = goldenReject(e, "tbl v0.16b, v1.16b, v3.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b}, v3.16b, v4.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b}, v32.16b")
	e = goldenReject(e, "tbl v0.16b, {v1.16b}, v3.16b[1]")
	e = goldenReject(e, "tbl v0.16b, {v1.16b}, {v3.16b}")
	return e
}
