package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"

// AArch64 system instructions: hints (named, `hint #n`, `bti`, `psb` / `tsb`),
// barriers, MRS / MSR (system registers and PSTATE fields), SYS / SYSL and the DC /
// IC cache operations.  Dispatched from parseA64Ctrl; the name tables are in
// aarch64_sysnames.bn.

// btiTargetValue returns the HINT immediate of `bti <target>` (c 34, j 36, jc 38), or
// -1 for any other target name.
func btiTargetValue(t *[]readonly char) int {
	if nameIs(t, "c") { return 34 }
	if nameIs(t, "j") { return 36 }
	if nameIs(t, "jc") { return 38 }
	return -1
}

// ctrlHint emits a named hint (no operands), `hint #imm`, `bti {c|j|jc}`, or
// `psb csync` / `tsb csync`.
func ctrlHint(p @Parser, mnem *[]readonly char, its a64Items) {
	if mnemIs(mnem, "hint") {
		if !dpExpectCount(p, its, 1) { return }
		imm, ok := dpImmAt(p, its, 0, 0, 127, "hint immediate out of range [0, 127]")
		if !ok { return }
		isa.Hint(p.Asm, imm)
		return
	}
	if mnemIs(mnem, "bti") {
		var v int = 32
		if its.N == 1 && its.It[0].Kind == IT_LABEL {
			v = btiTargetValue(its.It[0].Label)
		} else if its.N != 0 {
			v = -1
		}
		if v < 0 {
			setErr(p, "bti takes an optional c, j or jc")
			return
		}
		isa.Hint(p.Asm, v)
		return
	}
	if mnemIs(mnem, "psb") || mnemIs(mnem, "tsb") {
		if its.N != 1 || its.It[0].Kind != IT_LABEL || !nameIs(its.It[0].Label, "csync") {
			setErr(p, "expected csync")
			return
		}
		var hv int = 17
		if mnemIs(mnem, "tsb") { hv = 18 }
		isa.Hint(p.Asm, hv)
		return
	}
	if !dpExpectCount(p, its, 0) { return }
	isa.Hint(p.Asm, hintValue(mnem))
}

// ctrlBarrier emits clrex {#imm}, dsb / dmb <option|#imm>, isb {sy|#imm}, sb, and the
// ssbb / pssbb aliases (dsb #0 / dsb #4).
func ctrlBarrier(p @Parser, mnem *[]readonly char, its a64Items) {
	if mnemIs(mnem, "sb") || mnemIs(mnem, "ssbb") || mnemIs(mnem, "pssbb") {
		if !dpExpectCount(p, its, 0) { return }
		if mnemIs(mnem, "sb") {
			isa.Barrier(p.Asm, isa.BAR_SB, 0)
		} else if mnemIs(mnem, "ssbb") {
			isa.Barrier(p.Asm, isa.BAR_DSB, 0)
		} else {
			isa.Barrier(p.Asm, isa.BAR_DSB, 4)
		}
		return
	}
	var op uint32 = isa.BAR_CLREX
	if mnemIs(mnem, "dsb") { op = isa.BAR_DSB }
	if mnemIs(mnem, "dmb") { op = isa.BAR_DMB }
	if mnemIs(mnem, "isb") { op = isa.BAR_ISB }
	var crm int = 15
	if its.N > 1 {
		setErr(p, "too many operands")
		return
	}
	if its.N == 1 {
		var it a64Item = its.It[0]
		if it.Kind == IT_IMM {
			var okI bool = false
			crm, okI = dpImmAt(p, its, 0, 0, 15, "barrier option out of range [0, 15]")
			if !okI { return }
		} else if it.Kind == IT_LABEL && (op == isa.BAR_DSB || op == isa.BAR_DMB) {
			crm = barrierOption(it.Label)
		} else if it.Kind == IT_LABEL && op == isa.BAR_ISB && nameIs(it.Label, "sy") {
			crm = 15
		} else {
			crm = -1
		}
		if crm < 0 {
			setErr(p, "invalid barrier option")
			return
		}
	} else if op == isa.BAR_DSB || op == isa.BAR_DMB {
		setErr(p, "dsb/dmb need a barrier option")
		return
	}
	isa.Barrier(p.Asm, op, crm)
}

// ctrlSysReg emits `mrs Xt, sysreg`, `msr sysreg, Xt`, or `msr pstatefield, #imm`.
func ctrlSysReg(p @Parser, mnem *[]readonly char, its a64Items) {
	if !dpExpectCount(p, its, 2) { return }
	var read bool = mnemIs(mnem, "mrs")
	var ri int = 1
	var ni int = 0
	if read {
		ri = 0
		ni = 1
	}
	if its.It[ni].Kind != IT_LABEL {
		setErr(p, "expected a system register name")
		return
	}
	if !read && its.It[1].Kind == IT_IMM {
		var f int = pstateField(its.It[0].Label)
		if f < 0 {
			setErr(p, "unknown PSTATE field for msr (immediate)")
			return
		}
		imm, okI := dpImmAt(p, its, 1, 0, 15, "msr immediate out of range [0, 15]")
		if !okI { return }
		isa.MsrImm(p.Asm, f / 8, f % 8, imm)
		return
	}
	var enc int = sysRegByName(its.It[ni].Label)
	if enc < 0 {
		setErr(p, "unknown system register")
		return
	}
	if !read && sysRegReadOnly(its.It[ni].Label) {
		setErr(p, "msr to a read-only system register")
		return
	}
	var rt int = ctrlXReg(p, its, ri, true)
	if p.HasError { return }
	op0, op1, crn, crm, op2 := sysRegFields(enc)
	isa.SysRegMove(p.Asm, read, rt, op0, op1, crn, crm, op2)
}

// crName parses a `c<n>` (n 0-15) system-instruction register name, or -1.
func crName(it a64Item) int {
	if it.Kind != IT_LABEL || len(it.Label) < 2 || len(it.Label) > 3 || lowerChar(it.Label[0]) != 'c' {
		return -1
	}
	var v int = 0
	for i := 1; i < len(it.Label); i++ {
		var c char = it.Label[i]
		if c < '0' || c > '9' { return -1 }
		v = v * 10 + cast(int, c) - cast(int, '0')
	}
	if v > 15 { return -1 }
	return v
}

// ctrlSys emits `sys #op1, Cn, Cm, #op2{, Xt}`, `sysl Xt, #op1, Cn, Cm, #op2`, and the
// DC / IC operations `dc <op>, Xt` / `ic <op>{, Xt}` (SYS with CRn = 7).
func ctrlSys(p @Parser, mnem *[]readonly char, its a64Items) {
	if mnemIs(mnem, "dc") || mnemIs(mnem, "ic") {
		if its.N < 1 || its.It[0].Kind != IT_LABEL {
			setErr(p, "expected a cache operation name")
			return
		}
		var ci int = dcOperation(its.It[0].Label)
		if mnemIs(mnem, "ic") { ci = icOperation(its.It[0].Label) }
		if ci < 0 {
			setErr(p, "unknown cache operation")
			return
		}
		var needsReg bool = ci % 8 == 1
		var want int = 1
		if needsReg { want = 2 }
		if !dpExpectCount(p, its, want) { return }
		var rt int = 31
		if needsReg { rt = ctrlXReg(p, its, 1, true) }
		if p.HasError { return }
		isa.Sys(p.Asm, false, ci / 1024, 7, (ci / 64) % 16, (ci / 8) % 8, rt)
		return
	}
	var sysl bool = mnemIs(mnem, "sysl")
	var b int = 0
	var rt int = 31
	if sysl {
		if !dpExpectCount(p, its, 5) { return }
		rt = ctrlXReg(p, its, 0, true)
		if p.HasError { return }
		b = 1
	} else if its.N != 4 && its.N != 5 {
		setErr(p, "wrong number of operands")
		return
	}
	op1, ok1 := dpImmAt(p, its, b, 0, 7, "op1 out of range [0, 7]")
	if !ok1 { return }
	var crn int = crName(its.It[b + 1])
	var crm int = crName(its.It[b + 2])
	if crn < 0 || crm < 0 {
		setErr(p, "expected c0-c15")
		return
	}
	op2, ok2 := dpImmAt(p, its, b + 3, 0, 7, "op2 out of range [0, 7]")
	if !ok2 { return }
	if !sysl && its.N == 5 {
		rt = ctrlXReg(p, its, 4, true)
		if p.HasError { return }
	}
	isa.Sys(p.Asm, sysl, op1, crn, crm, op2, rt)
}
