package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// System instructions through the text parser — hints, barriers, MRS / MSR (named,
// generic and PSTATE forms), SYS / SYSL and DC / IC — each to clang's word
// (`clang -c -target arm64-apple-macos11`), and their operand rejections.
func TestParseSystemInstructions() testing.TestResult {
	var e @[]char = ""
	e = goldenWord(e, "yield", 0xD503203F)
	e = goldenWord(e, "hint #127", 0xD5032FFF)
	e = goldenWord(e, "bti jc", 0xD50324DF)
	e = goldenWord(e, "paciasp", 0xD503233F)
	e = goldenWord(e, "dsb ish", 0xD5033B9F)
	e = goldenWord(e, "dmb #7", 0xD50337BF)
	e = goldenWord(e, "isb", 0xD5033FDF)
	e = goldenWord(e, "clrex #5", 0xD503355F)
	e = goldenWord(e, "ssbb", 0xD503309F)
	e = goldenWord(e, "mrs x0, tpidr_el0", 0xD53BD040)
	e = goldenWord(e, "mrs x0, s3_3_c14_c0_2", 0xD53BE040)
	e = goldenWord(e, "mrs x0, s1_0_c0_c0_0", 0xD5280000)
	e = goldenWord(e, "msr nzcv, x0", 0xD51B4200)
	e = goldenWord(e, "msr daifset, #2", 0xD50342DF)
	e = goldenWord(e, "sys #3, c7, c5, #1, x0", 0xD50B7520)
	e = goldenWord(e, "sysl x0, #3, c7, c5, #1", 0xD52B7520)
	e = goldenWord(e, "dc civac, x0", 0xD50B7E20)
	e = goldenWord(e, "ic iallu", 0xD508751F)
	e = goldenReject(e, "bti x")
	e = goldenReject(e, "isb ish")
	e = goldenReject(e, "dsb")
	e = goldenReject(e, "msr dczid_el0, x0")
	e = goldenReject(e, "mrs w0, nzcv")
	e = goldenReject(e, "mrs x0, s3_03_c0_c0_0")
	e = goldenReject(e, "ic ivau")
	e = goldenReject(e, "dc zva, w0")
	return e
}

// A system operand name — barrier option, hint target, system register, PSTATE field,
// `c<n>` (as Cn or Cm, in SYS or SYSL), cache operation — followed by an addend (even
// `+0`) or `@` specifier, or given a `:got:` qualifier, is rejected (as clang rejects it),
// not assembled as the bare name.
func TestParseSystemNameWithSymbolTail() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "dmb ish-1")
	e = goldenReject(e, "dsb sy+4")
	e = goldenReject(e, "isb sy@PLT")
	e = goldenReject(e, "bti c+4")
	e = goldenReject(e, "bti c@PLT")
	e = goldenReject(e, "psb csync+4")
	e = goldenReject(e, "mrs x0, nzcv+4")
	e = goldenReject(e, "msr nzcv+4, x0")
	e = goldenReject(e, "msr daifset+1, #2")
	e = goldenReject(e, "sys #0, c7+4, c5, #0")
	e = goldenReject(e, "dc cvac+4, x0")
	e = goldenReject(e, "ic iallu+4")
	e = goldenReject(e, "dmb ish+0")
	e = goldenReject(e, "dmb ish-0")
	e = goldenReject(e, "bti c+0")
	e = goldenReject(e, "sysl x0, #0, c7, c5+0, #0")
	e = goldenReject(e, "dmb :got:ish")
	return e
}
