package "pkg/binate/asm/parse"

// Operand lists of the AArch64 data-processing instructions are scanned into a flat
// list of typed items (register, immediate, shift/extend modifier, condition, label,
// page offset) before any instruction looks at them.  The scan consumes every token
// of the line or fails, so an instruction handler sees exactly what was written —
// nothing trailing is silently ignored — and matches the item shape it accepts.

// Item kinds (a64Item.Kind).
const (
	IT_REG int = iota // a register (Reg, Cls)
	IT_IMM            // an immediate, `#expr` or a bare numeric expression (Imm)
	// a shift or extend modifier with optional amount (Mod, Amt, AmtGiven; its name in
	// Label and, without an amount, any symbol tail after it in Imm and Spec)
	IT_MOD
	IT_COND  // a condition code (Cond; its name in Label)
	IT_LABEL // a symbol with optional addend and page specifier (Label, Imm, Spec)
	IT_LO12  // a page offset: `#:lo12:sym{+n}` or `sym{+n}@PAGEOFF` (Label, Imm, Spec)
	IT_DOT   // `.`, the current location, plus an optional offset (Imm)
	IT_VREG  // a vector register with an arrangement or element (Reg, VEl, VLanes, Lane)
	IT_VLIST // a vector register list `{…}` (Reg: the first, VCount, VEl, VLanes, Lane)
	IT_FLOAT // a floating-point literal, `#`-prefixed or not (FText); see parseA64ItemsFloat
	IT_MSL   // an MSL shifting-ones modifier and its amount (Amt); only vector MOVI / MVNI take one
	// an ELF MOVW-group relocation operand, `#:abs_g1:sym{+n}` (Label, Imm; its
	// isa.FIX_MOVW_* kind in Spec); only MOVZ / MOVN / MOVK and `mov` take one
	IT_MOVW
)

// Symbol specifiers (a64Item.Spec) of IT_LABEL / IT_LO12 items: the plain symbol, its
// 4KB page (`sym@PAGE` — the same as the plain symbol for ADRP), its GOT slot's page
// (`:got:sym` / `sym@GOTPAGE`), the GOT slot's page offset (`sym@GOTPAGEOFF`, an
// IT_LO12), a call through the PLT (`sym@PLT`, a plain branch target), its page with no
// overflow check (`:pg_hi21_nc:sym`, for ADRP), or the GOT slot's offset from the GOT's
// page (`:gotpage_lo15:sym`, an IT_LO12).
const (
	SPEC_NONE int = iota
	SPEC_PAGE
	SPEC_GOTPAGE
	SPEC_GOTPAGEOFF
	SPEC_PLT
	SPEC_PAGE_NC
	SPEC_GOTPAGE_LO15
)

// Modifier kinds (a64Item.Mod): the four shifts, then the eight extends in option-
// field order (MOD_UXTB + n is extend option n).
const (
	MOD_LSL int = iota
	MOD_LSR
	MOD_ASR
	MOD_ROR
	MOD_UXTB
	MOD_UXTH
	MOD_UXTW
	MOD_UXTX
	MOD_SXTB
	MOD_SXTH
	MOD_SXTW
	MOD_SXTX
)

// a64Item is one scanned operand; see the IT_* kinds for which fields are set.  A
// label's addend (`sym+8`) is carried in Imm.
type a64Item struct {
	Kind     int
	Reg      int
	Cls      int
	Imm      int64
	Mod      int
	Amt      int
	AmtGiven bool
	Cond     int
	Spec     int
	Label    @[]char
	VEl      int // IT_VREG / IT_VLIST: element size, 0..4 for B / H / S / D / Q
	VLanes   int // IT_VREG / IT_VLIST: lane count of an arrangement (`v0.4s`), 0 for a bare element
	Lane     int // IT_VREG / IT_VLIST: the `[index]` after the register or list, -1 when absent
	VCount   int // IT_VLIST: the number of registers, 1..4
	FText    @[]char // IT_FLOAT: the literal's text, as lexed
	AmtLit   bool // IT_MOD: the amount is a single integer or character literal
	// The operand began with '#' or an integer or character literal — the spellings clang
	// lets a shift follow an IT_IMM / IT_LO12 operand (`#1, lsl #12`, `1+1, lsl #12`,
	// `#:lo12:s, lsl #0`; not `(1), lsl #12` or `:lo12:s, lsl #0`)
	Shiftable bool
	// IT_IMM: the operand (after any '#') is a single integer or character literal, not an
	// expression — what clang reads a DSB nXS immediate from (`dsb #16`, not `dsb #8+8`)
	ImmLit bool
	// IT_LABEL: written as one plain name — no '#', addend (not even `+0`), parentheses or
	// `@` specifier, and not a constant's, an alias's or a numeric local label's name — the
	// only spelling of a system operand name (`dmb ish`, not `dmb #ish` or `dmb A`)
	Bare bool
}

// maxA64Items bounds an operand list (the longest, e.g. `ccmp Rn, #imm, #nzcv, cond`
// or `madd Rd, Rn, Rm, Ra`, has four; a modifier makes five).
const maxA64Items int = 6

// a64Items is a scanned operand list: N items in It.
type a64Items struct {
	N  int
	It [6]a64Item
}

// parseModName returns the MOD_* kind of a shift/extend keyword, or -1.
func parseModName(name *[]readonly char) int {
	if nameIs(name, "lsl") { return MOD_LSL }
	if nameIs(name, "lsr") { return MOD_LSR }
	if nameIs(name, "asr") { return MOD_ASR }
	if nameIs(name, "ror") { return MOD_ROR }
	if nameIs(name, "uxtb") { return MOD_UXTB }
	if nameIs(name, "uxth") { return MOD_UXTH }
	if nameIs(name, "uxtw") { return MOD_UXTW }
	if nameIs(name, "uxtx") { return MOD_UXTX }
	if nameIs(name, "sxtb") { return MOD_SXTB }
	if nameIs(name, "sxth") { return MOD_SXTH }
	if nameIs(name, "sxtw") { return MOD_SXTW }
	if nameIs(name, "sxtx") { return MOD_SXTX }
	return -1
}

// parseCondName returns the 4-bit condition of a condition-code name
// (case-insensitive, including the hs / lo aliases and nv), or -1.
func parseCondName(name *[]readonly char) int {
	if nameIs(name, "eq") { return 0 }
	if nameIs(name, "ne") { return 1 }
	if nameIs(name, "cs") || nameIs(name, "hs") { return 2 }
	if nameIs(name, "cc") || nameIs(name, "lo") { return 3 }
	if nameIs(name, "mi") { return 4 }
	if nameIs(name, "pl") { return 5 }
	if nameIs(name, "vs") { return 6 }
	if nameIs(name, "vc") { return 7 }
	if nameIs(name, "hi") { return 8 }
	if nameIs(name, "ls") { return 9 }
	if nameIs(name, "ge") { return 10 }
	if nameIs(name, "lt") { return 11 }
	if nameIs(name, "gt") { return 12 }
	if nameIs(name, "le") { return 13 }
	if nameIs(name, "al") { return 14 }
	if nameIs(name, "nv") { return 15 }
	return -1
}

// intFits reports whether v survives narrowing to this host's int (a no-op check on
// a 64-bit host; on a 32-bit one it stops a large value silently wrapping into a
// small offset or addend).
func intFits(v int64) bool {
	return cast(int64, cast(int, v)) == v
}

// startsNumericExpr reports whether tok can begin a bare numeric expression (an
// immediate written without '#').
func startsNumericExpr(tok Token) bool {
	return tok.Kind == TOK_INT || tok.Kind == TOK_CHAR || tok.Kind == TOK_MINUS ||
			tok.Kind == TOK_LPAREN || tok.Kind == TOK_TILDE || tok.Kind == TOK_PLUS
}

// parseExprValue parses an expression starting at tok, returning the lexer / next
// token and its value; ok=false with p's error set on an invalid expression.
func parseExprValue(p @Parser, l Lexer, tok Token) (Lexer, Token, int64, bool) {
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid immediate expression"))
		return l, tok, 0, false
	}
	return l, tok, r.Val, true
}

// parseA64Items scans the rest of the line (tok is the first operand token, or EOF
// for none) into an operand list.  Returns ok=false with p's error set on a malformed
// operand, more than maxA64Items operands, or anything left after the last one.  A
// floating-point literal is an error here: an integer operand never takes one.
func parseA64Items(p @Parser, l Lexer, tok Token) (a64Items, bool) {
	return scanA64Items(p, l, tok, false)
}

// parseA64ItemsFloat is parseA64Items for the instructions that take a floating-point
// literal operand (the floating-point compares against `#0.0`): such an operand is an
// IT_FLOAT item.  Kept apart so that no other instruction ever sees an IT_FLOAT (an
// integer operand reading its Imm would silently take zero).
func parseA64ItemsFloat(p @Parser, l Lexer, tok Token) (a64Items, bool) {
	return scanA64Items(p, l, tok, true)
}

// scanA64Items scans an operand list, IT_FLOAT items allowed only when allowFloat.
func scanA64Items(p @Parser, l Lexer, tok Token, allowFloat bool) (a64Items, bool) {
	var its a64Items
	if tok.Kind == TOK_EOF { return its, true }
	for {
		if its.N >= maxA64Items {
			setErr(p, "too many operands")
			return its, false
		}
		var it a64Item
		var ok bool = false
		l, tok, it, ok = parseA64Item(p, l, tok)
		if !ok { return its, false }
		if it.Kind == IT_FLOAT && !allowFloat {
			setErr(p, "a floating-point literal where an integer operand is expected")
			return its, false
		}
		its.It[its.N] = it
		its.N = its.N + 1
		if tok.Kind == TOK_EOF { return its, true }
		if tok.Kind != TOK_COMMA {
			setErr(p, "unexpected token after an operand (expected ',' or end of line)")
			return its, false
		}
		l, tok = LexNext(l)
	}
	return its, false
}

// parseA64Item scans one operand starting at tok.
func parseA64Item(p @Parser, l Lexer, tok Token) (Lexer, Token, a64Item, bool) {
	var it a64Item
	var ok bool = false
	if tok.Kind == TOK_HASH {
		var peek Lexer = l
		var pt Token
		peek, pt = LexNext(peek)
		if pt.Kind == TOK_COLON {
			l, tok, it, ok = parseQualifiedItem(p, peek)
			it.Shiftable = true
			return l, tok, it, ok
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_FLOAT { return parseA64FloatItem(l, tok) }
		// (A symbol after '#' is a label where one is taken: clang's `b #lbl`.)
		it.Shiftable = true
		it.ImmLit = isA64SingleLiteral(l, tok)
		l, tok, it, ok = a64ExprItem(p, l, tok, it)
		it.Bare = false
		return l, tok, it, ok
	}
	if startsNumericExpr(tok) || tok.Kind == TOK_DOT {
		it.Shiftable = tok.Kind == TOK_INT || tok.Kind == TOK_CHAR
		it.ImmLit = isA64SingleLiteral(l, tok)
		return a64ExprItem(p, l, tok, it)
	}
	if tok.Kind == TOK_COLON { return parseQualifiedItem(p, l) }
	if tok.Kind == TOK_LBRACE { return parseA64VecList(p, l) }
	if tok.Kind == TOK_FLOAT { return parseA64FloatItem(l, tok) }
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected an operand")
		return l, tok, it, false
	}
	// The name and the lexer just after it, to scan an operand that starts with it again.
	var lName Lexer = l
	var tName Token = tok
	var reg int = -1
	var cls int = RC_NONE
	reg, cls = parseA64Reg(tok.Text)
	vreg, vel, vlanes, isVec := parseA64VecReg(tok.Text)
	if isVec { return parseA64VecItem(p, l, vreg, vel, vlanes) }
	if isVecRegShaped(tok.Text) {
		setErr(p, "invalid vector kind qualifier")
		return l, tok, it, false
	}
	if cls != RC_NONE {
		it.Kind = IT_REG
		it.Reg = reg
		it.Cls = cls
		l, tok = LexNext(l)
		return l, tok, it, true
	}
	if nameIs(tok.Text, "msl") && mslHasAmount(l) { return parseA64MslItem(p, l) }
	var mod int = parseModName(tok.Text)
	if mod >= 0 {
		it.Kind = IT_MOD
		it.Mod = mod
		it.Label = tok.Text
		l, tok = LexNext(l)
		// A shift / extend name followed by an addend or `@` names a symbol (`b lsl+4`),
		// but only where a label is taken; the item stays IT_MOD, carrying the tail.
		if isA64LabelTail(tok) { return a64ShiftNameTail(p, lName, tName, it) }
		// The amount follows `#`, or starts with an integer or character literal (`lsl
		// 3`, `lsl 1+1`, `lsl '!'`); anything else (`lsl (3)`) is not an amount.
		if tok.Kind == TOK_HASH {
			l, tok = LexNext(l)
			if !startsA64ShiftAmount(p, tok) {
				setErr(p, "expected an integer shift amount")
				return l, tok, it, false
			}
		} else if tok.Kind != TOK_INT && tok.Kind != TOK_CHAR {
			return l, tok, it, true
		}
		it.AmtLit = isA64SingleLiteral(l, tok)
		var amt int64 = 0
		l, tok, amt, ok = parseExprValue(p, l, tok)
		if !ok { return l, tok, it, false }
		if amt < 0 || amt > 64 {
			setErr(p, "shift/extend amount out of range")
			return l, tok, it, false
		}
		it.Amt = cast(int, amt)
		it.AmtGiven = true
		return l, tok, it, true
	}
	var cond int = parseCondName(tok.Text)
	if cond >= 0 {
		it.Kind = IT_COND
		it.Cond = cond
		it.Label = tok.Text
		l, tok = LexNext(l)
		// A condition name followed by an addend or `@` is a symbol (`b eq+4`), as
		// clang reads it wherever a symbol is taken; a constant so named is an error
		// (resolveLabel), clang reading the constant there.
		if isA64LabelTail(tok) {
			_ = resolveLabel(p, it.Label)
			if p.HasError { return l, tok, it, false }
			var lab a64Item
			return a64ExprItem(p, lName, tName, lab)
		}
		return l, tok, it, true
	}
	if constIndex(p, tName.Text) >= 0 && isA64ReservedName(tName.Text) {
		_ = resolveLabel(p, tName.Text) // a constant named like a register or msl: an error
		return l, tok, it, false
	}
	// A symbol (a label or an alias) plus a number, or a constant's value — a bare
	// immediate (clang: `add x0, x1, N`; as a branch target, an offset like `b 8`), which
	// no shift may follow (`N, lsl #12`).
	return a64ExprItem(p, lName, tName, it)
}

// startsA64ShiftAmount reports whether tok, just after a shift / extend's `#`, can start
// its amount: an integer or character literal, a '(' or a constant's name (as clang:
// `lsl #(3)`, `lsl #1+2`, `lsl #N`, not `lsl #+3`, `lsl #-0` or `lsl #~-4`).
func startsA64ShiftAmount(p @Parser, tok Token) bool {
	return tok.Kind == TOK_INT || tok.Kind == TOK_CHAR || tok.Kind == TOK_LPAREN ||
			(tok.Kind == TOK_IDENT && constIndex(p, tok.Text) >= 0)
}

// isA64ConstName reports whether tok, an operand written without '#', is a constant's
// name read as the constant there: a name read as nothing else (isA64ReservedName) — `x3
// = 7` leaves a bare `x3` the register, and such a constant is written `#x3`.
func isA64ConstName(p @Parser, tok Token) bool {
	if tok.Kind != TOK_IDENT || constIndex(p, tok.Text) < 0 { return false }
	return !isA64ReservedName(tok.Text)
}

// isA64ReservedName reports whether a bare operand name is read as something other than a
// symbol or constant: a register — general, FP / SIMD or vector, or one clang names in any
// operand (z0..z31, ffr, zt0, fpcr, fpsr, nzcv), though most take no part here — a shift /
// extend / msl modifier, or a condition.
func isA64ReservedName(name *[]readonly char) bool {
	_, cls := parseA64Reg(name)
	if cls != RC_NONE || isVecRegShaped(name) { return true }
	if parseModName(name) >= 0 || nameIs(name, "msl") || parseCondName(name) >= 0 { return true }
	if len(name) > 1 && (name[0] == 'z' || name[0] == 'Z') && regIndexSuffix(name, 31) >= 0 {
		return true
	}
	return nameIs(name, "ffr") || nameIs(name, "zt0") || nameIs(name, "fpcr") ||
			nameIs(name, "fpsr") || nameIs(name, "nzcv")
}

// isA64SingleLiteral reports whether the operand or modifier amount starting at tok (l just
// after it) is a single integer or character literal, closing the operand — what clang
// takes as the amount of an add / sub immediate's shift (`lsl #12`, not `lsl #(12)` or
// `lsl #6+6`) and reads a DSB nXS immediate from.
func isA64SingleLiteral(l Lexer, tok Token) bool {
	if tok.Kind != TOK_INT && tok.Kind != TOK_CHAR { return false }
	var next Token
	l, next = LexNext(l)
	return next.Kind == TOK_EOF || next.Kind == TOK_COMMA || next.Kind == TOK_RBRACKET
}
