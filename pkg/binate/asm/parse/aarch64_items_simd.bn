package "pkg/binate/asm/parse"

// Operand items of the Advanced SIMD instructions that no other instruction takes: a
// floating-point literal (the floating-point compares' `#0.0`, IT_FLOAT) and the MSL
// shifting-ones modifier of the vector MOVI / MVNI (IT_MSL).  Each is its own item kind,
// so an integer operand or a shift / extend never mistakes one for its own.

// parseA64FloatItem makes the floating-point literal tok an IT_FLOAT item.
func parseA64FloatItem(l Lexer, tok Token) (Lexer, Token, a64Item, bool) {
	var it a64Item
	it.Kind = IT_FLOAT
	it.FText = tok.Text
	l, tok = LexNext(l)
	return l, tok, it, true
}

// mslHasAmount reports whether the token after an `msl` name (l positioned just after
// it) starts an amount — `#` or an integer — which makes it the modifier; otherwise the
// name is a symbol.
func mslHasAmount(l Lexer) bool {
	var tok Token
	l, tok = LexNext(l)
	return tok.Kind == TOK_HASH || tok.Kind == TOK_INT || tok.Kind == TOK_CHAR
}

// parseA64MslItem scans the amount of an MSL modifier (l positioned just after `msl`)
// into an IT_MSL item.
func parseA64MslItem(p @Parser, l Lexer) (Lexer, Token, a64Item, bool) {
	var it a64Item
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind == TOK_HASH {
		l, tok = LexNext(l)
		if !startsA64ShiftAmount(tok) {
			setErr(p, "expected an integer shift amount")
			return l, tok, it, false
		}
	}
	var amt int64 = 0
	var ok bool = false
	l, tok, amt, ok = parseExprValue(p, l, tok)
	if !ok { return l, tok, it, false }
	if !intFits(amt) {
		setErr(p, "msl amount out of range")
		return l, tok, it, false
	}
	it.Kind = IT_MSL
	it.Amt = cast(int, amt)
	return l, tok, it, true
}
