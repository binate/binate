package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the SIMD-only operand items (aarch64_items_simd.bn): a floating-point literal
// is an item only through parseA64ItemsFloat, and `msl` is the modifier only with an
// amount.

func TestItemsFloatOnlyWhenAsked() testing.TestResult {
	var p @Parser = newTestParser()
	var l Lexer = NewLexer("v0.4s, #0.5", 1)
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64ItemsFloat(p, l, tok)
	if !ok || its.N != 2 || its.It[1].Kind != IT_FLOAT { return "#0.5 not a float item" }
	its, ok, p = itemsScanLine("v0.4s, #0.5")
	if ok || !p.HasError { return "a float literal accepted by parseA64Items" }
	its, ok, p = itemsScanLine("x0, 0.0")
	if ok || !p.HasError { return "a bare float literal accepted by parseA64Items" }
	return ""
}

func TestItemsMsl() testing.TestResult {
	its, ok, p := itemsScanLine("v0.4s, #1, msl #8")
	if !ok || its.N != 3 || its.It[2].Kind != IT_MSL || its.It[2].Amt != 8 {
		return "msl #8 not an MSL item"
	}
	its, ok, p = itemsScanLine("v0.4s, #1, msl 16")
	if !ok || its.It[2].Kind != IT_MSL || its.It[2].Amt != 16 { return "msl 16 not an MSL item" }
	its, ok, p = itemsScanLine("msl")
	if !ok || its.N != 1 || its.It[0].Kind != IT_LABEL { return "a bare msl not a label" }
	its, ok, p = itemsScanLine("v0.4s, #1, msl #")
	if ok || !p.HasError { return "msl with a missing amount accepted" }
	return ""
}
