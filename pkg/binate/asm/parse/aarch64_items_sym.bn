package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// Symbol operands of the AArch64 operand scanner (aarch64_items.bn): an operand
// expression — a number, a symbol plus a number, or `.` plus a number — then a symbol's
// `@` specifier and the addend that may follow it, and the `:lo12:` / `:got:` /
// `:got_lo12:` / MOVW-group (`:abs_g1:`, …) qualified forms.

// isA64LabelTail reports whether tok can only continue a symbol operand: an addend's
// sign or an `@` specifier.
func isA64LabelTail(tok Token) bool {
	return tok.Kind == TOK_PLUS || tok.Kind == TOK_MINUS || tok.Kind == TOK_AT
}

// a64ExprItem scans the operand expression starting at tok (l just after it) into it: a
// number is IT_IMM (it keeps the caller's Shiftable / ImmLit), the current location plus
// a number IT_DOT, and a symbol plus a number IT_LABEL — finished by any `@` specifier
// (parseLabelTail).  Bare records a symbol written as one plain name (see a64Item).
func a64ExprItem(p @Parser, l Lexer, tok Token, it a64Item) (Lexer, Token, a64Item, bool) {
	var first Token = tok
	var peek Lexer = l
	peek, _ = LexNext(peek)
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid operand expression"))
		return l, tok, it, false
	}
	it.Imm = r.Val
	if !isSymbolic(r) {
		it.Kind = IT_IMM
		return l, tok, it, true
	}
	it.Bare = l.Pos == peek.Pos && first.Kind == TOK_IDENT && !isDigit(first.Text[0]) &&
			constIndex(p, first.Text) < 0
	if r.Dot {
		it.Kind = IT_DOT
		return l, tok, it, true
	}
	it.Kind = IT_LABEL
	it.Label = r.Sym
	return parseLabelTail(p, l, tok, it)
}

// a64ShiftNameTail finishes a shift / extend name item it (its name in Label) followed
// by a symbol tail, scanning the operand again from the name (tok, l just after it): the
// addend and `@` specifier go into it (Imm, Spec), which stays IT_MOD with no
// amount, so only a position that takes the name as a label (a branch or ADR / ADRP
// target, asA64Label) accepts it — elsewhere clang reads the name as a shift and rejects
// the line.  No position takes it as a page offset (`@PAGEOFF`); a constant so named is
// an error (resolveLabel), clang reading the constant there.
func a64ShiftNameTail(p @Parser, l Lexer, tok Token, it a64Item) (Lexer, Token, a64Item, bool) {
	_ = resolveLabel(p, it.Label)
	if p.HasError { return l, tok, it, false }
	var lab a64Item
	var ok bool = false
	l, tok, lab, ok = a64ExprItem(p, l, tok, lab)
	if !ok { return l, tok, it, false }
	if lab.Kind != IT_LABEL {
		setErr(p, "a shift / extend name is not a page-offset symbol")
		return l, tok, it, false
	}
	it.Imm = lab.Imm
	it.Spec = lab.Spec
	return l, tok, it, true
}

// parseLabelTail finishes a symbol operand it (IT_LABEL, its addend already in Imm) at
// tok: an optional `@PAGE` / `@PAGEOFF` / `@GOTPAGE` / `@GOTPAGEOFF` / `@PLT` specifier,
// which may itself be followed by an addend, added to the one before it (clang:
// `sym+4@PAGE+8` is sym+12).
func parseLabelTail(p @Parser, l Lexer, tok Token, it a64Item) (Lexer, Token, a64Item, bool) {
	if tok.Kind != TOK_AT { return l, tok, it, true }
	it.Bare = false
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected a symbol specifier after '@'")
		return l, tok, it, false
	}
	if nameIs(tok.Text, "page") {
		it.Spec = SPEC_PAGE
	} else if nameIs(tok.Text, "pageoff") {
		it.Kind = IT_LO12
	} else if nameIs(tok.Text, "gotpage") {
		it.Spec = SPEC_GOTPAGE
	} else if nameIs(tok.Text, "gotpageoff") {
		it.Kind = IT_LO12
		it.Spec = SPEC_GOTPAGEOFF
	} else if nameIs(tok.Text, "plt") && !asm.IsGeneratedLabel(it.Label) {
		// (clang takes no @PLT on a numeric local label reference: `b 1b@PLT`.)
		it.Spec = SPEC_PLT
	} else {
		setErr(p, "unsupported symbol specifier (@PAGE, @PAGEOFF, @GOTPAGE, @GOTPAGEOFF, @PLT)")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_PLUS || tok.Kind == TOK_MINUS {
		var neg bool = tok.Kind == TOK_MINUS
		l, tok = LexNext(l)
		var v int64 = 0
		var ok bool = false
		l, tok, v, ok = parseAddendTerm(p, l, tok)
		if !ok { return l, tok, it, false }
		if neg { v = 0 - v }
		it.Imm = it.Imm + v
	}
	return l, tok, it, true
}

// parseAddendTerm parses the addend after a symbol specifier's '+' / '-': one term — a
// number, a number constant's name or a parenthesized expression — as clang takes it
// there (`sym@PAGE+8`, `sym@PAGE+N`, `sym@PAGE+(4*2)`, not `sym@PAGE+4+4`).
func parseAddendTerm(p @Parser, l Lexer, tok Token) (Lexer, Token, int64, bool) {
	var v int64 = 0
	if tok.Kind == TOK_INT || tok.Kind == TOK_CHAR {
		v = tok.Ival
		l, tok = LexNext(l)
	} else if tok.Kind == TOK_IDENT && constIndex(p, tok.Text) >= 0 {
		var r ExprResult = nameValue(p, tok.Text, false)
		if !r.Ok {
			setErr(p, r.Err)
			return l, tok, 0, false
		}
		v = r.Val
		l, tok = LexNext(l)
	} else if tok.Kind == TOK_LPAREN {
		// Only the parenthesized term: `(` expr `)`, so a following `+2` is not folded
		// into the value the caller then negates (`sym@PAGE-(4)+2` must not become -6).
		l, tok = LexNext(l)
		var r ExprResult
		l, tok, r = ParseExpr(p, l, tok)
		if !r.Ok {
			setErr(p, exprErr(r, "invalid parenthesized symbol addend"))
			return l, tok, 0, false
		}
		if tok.Kind != TOK_RPAREN {
			setErr(p, "invalid parenthesized symbol addend")
			return l, tok, 0, false
		}
		v = r.Val
		l, tok = LexNext(l)
	} else {
		setErr(p, "expected a number, a constant or a parenthesized expression as the addend")
		return l, tok, 0, false
	}
	if tok.Kind != TOK_EOF && tok.Kind != TOK_COMMA && tok.Kind != TOK_RBRACKET {
		setErr(p, "the addend after a symbol specifier is a single term")
		return l, tok, 0, false
	}
	return l, tok, v, true
}

// parseQualifiedItem finishes a `:qual:expr` operand with l positioned so the next token
// is the qualifier (just past the opening ':'): `:lo12:` (a page offset, IT_LO12),
// `:got_lo12:` (the GOT slot's page offset, IT_LO12 / SPEC_GOTPAGEOFF), `:got:` (the GOT
// slot's page, IT_LABEL / SPEC_GOTPAGE), or a MOVW-group operator (`:abs_g1:`,
// `:prel_g0_nc:`, …; IT_MOVW, see movwSpecKind).  The expression is a symbol plus a number
// (`:lo12:sym+8`, `:lo12:(sym+8)`, `:lo12:8+sym`), or `.` plus a number, which names a
// label made at this instruction (dotLabel); a number is an error (clang folds `:lo12:N`
// and relocates `:got:N` against an absolute symbol, and folds `:abs_g0:N`).
func parseQualifiedItem(p @Parser, l Lexer) (Lexer, Token, a64Item, bool) {
	var it a64Item
	var tok Token
	l, tok = LexNext(l) // the qualifier
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected a relocation qualifier (:lo12:, :got:, :got_lo12:, :abs_g*:, :prel_g*:)")
		return l, tok, it, false
	}
	var movw int = movwSpecKind(tok.Text)
	if movw >= 0 {
		it.Kind = IT_MOVW
		it.Spec = movw
	} else if nameIs(tok.Text, "lo12") {
		it.Kind = IT_LO12
	} else if nameIs(tok.Text, "got_lo12") {
		it.Kind = IT_LO12
		it.Spec = SPEC_GOTPAGEOFF
	} else if nameIs(tok.Text, "got") {
		it.Kind = IT_LABEL
		it.Spec = SPEC_GOTPAGE
	} else {
		setErr(p, "unsupported relocation qualifier (:lo12:, :got:, :got_lo12:, :abs_g*:, :prel_g*:)")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COLON {
		setErr(p, "expected ':' after the relocation qualifier")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid symbol after the relocation qualifier"))
		return l, tok, it, false
	}
	if r.Dot { r.Sym = dotLabel(p) }
	if len(r.Sym) == 0 {
		setErr(p, "a relocation qualifier takes a symbol, not a number")
		return l, tok, it, false
	}
	it.Label = r.Sym
	it.Imm = r.Val
	if tok.Kind == TOK_AT {
		setErr(p, "a qualified operand takes no @ specifier")
		return l, tok, it, false
	}
	return l, tok, it, true
}
