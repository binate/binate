package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// Symbol operands of the AArch64 operand scanner (aarch64_items.bn): an operand
// expression — a number, a symbol plus a number, or `.` plus a number — then a symbol's
// `@` specifier and the addend that may follow it, and the `:lo12:` / `:got:` /
// `:got_lo12:` / `:gotpage_lo15:` / `:pg_hi21_nc:` / MOVW-group (`:abs_g1:`, …) /
// thread-local (`:tprel_lo12:`, `:dtprel_g1:`, `:gottprel:`, `:tlsdesc_lo12:`, …) qualified
// forms.

// isA64LabelTail reports whether tok can only continue a symbol operand: an addend's
// sign or an `@` specifier.
func isA64LabelTail(tok Token) bool {
	return tok.Kind == TOK_PLUS || tok.Kind == TOK_MINUS || tok.Kind == TOK_AT
}

// a64ExprItem scans the operand expression starting at tok (l just after it) into it: a
// number is IT_IMM (it keeps the caller's Shiftable / ImmLit), the current location plus
// a number IT_DOT, and a symbol plus a number IT_LABEL — finished by any `@` specifier
// (parseLabelTail).  Bare records a symbol written as one plain name (see a64Item).
func a64ExprItem(p @Parser, l Lexer, tok Token, it a64Item) (Lexer, Token, a64Item, bool) {
	var first Token = tok
	var peek Lexer = l
	peek, _ = LexNext(peek)
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid operand expression"))
		return l, tok, it, false
	}
	it.Imm = r.Val
	if !isSymbolic(r) {
		it.Kind = IT_IMM
		it.FromDiff = r.FromDiff
		return l, tok, it, true
	}
	it.Bare = l.Pos == peek.Pos && first.Kind == TOK_IDENT && !isDigit(first.Text[0]) &&
			constIndex(p, first.Text) < 0
	if r.Dot {
		it.Kind = IT_DOT
		return l, tok, it, true
	}
	it.Kind = IT_LABEL
	it.Label = r.Sym
	return parseLabelTail(p, l, tok, it)
}

// a64ShiftNameTail finishes a shift / extend name item it (its name in Label) followed
// by a symbol tail, scanning the operand again from the name (tok, l just after it): the
// addend and `@` specifier go into it (Imm, Spec), which stays IT_MOD with no
// amount, so only a position that takes the name as a label (a branch or ADR / ADRP
// target, asA64Label) accepts it — elsewhere clang reads the name as a shift and rejects
// the line.  No position takes it as a page offset (`@PAGEOFF`); a constant so named is
// an error (resolveLabel), clang reading the constant there.
func a64ShiftNameTail(p @Parser, l Lexer, tok Token, it a64Item) (Lexer, Token, a64Item, bool) {
	_ = resolveLabel(p, it.Label)
	if p.HasError { return l, tok, it, false }
	var lab a64Item
	var ok bool = false
	l, tok, lab, ok = a64ExprItem(p, l, tok, lab)
	if !ok { return l, tok, it, false }
	if lab.Kind != IT_LABEL {
		setErr(p, "a shift / extend name is not a page-offset symbol")
		return l, tok, it, false
	}
	it.Imm = lab.Imm
	it.Spec = lab.Spec
	return l, tok, it, true
}

// parseLabelTail finishes a symbol operand it (IT_LABEL, its addend already in Imm) at
// tok: an optional `@PAGE` / `@PAGEOFF` / `@GOTPAGE` / `@GOTPAGEOFF` / `@PLT` / `@TLVPPAGE` /
// `@TLVPPAGEOFF` specifier, which may itself be followed by an addend, added to the one before
// it (clang: `sym+4@PAGE+8` is sym+12) — but for a thread-local variable's (`@TLVPPAGE*`), which
// takes none, as clang.
func parseLabelTail(p @Parser, l Lexer, tok Token, it a64Item) (Lexer, Token, a64Item, bool) {
	if tok.Kind != TOK_AT { return l, tok, it, true }
	it.Bare = false
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected a symbol specifier after '@'")
		return l, tok, it, false
	}
	if nameIs(tok.Text, "page") {
		it.Spec = SPEC_PAGE
	} else if nameIs(tok.Text, "pageoff") {
		it.Kind = IT_LO12
	} else if nameIs(tok.Text, "gotpage") {
		it.Spec = SPEC_GOTPAGE
	} else if nameIs(tok.Text, "gotpageoff") {
		it.Kind = IT_LO12
		it.Spec = SPEC_GOTPAGEOFF
	} else if nameIs(tok.Text, "tlvppage") {
		it.Spec = SPEC_TLVPPAGE
	} else if nameIs(tok.Text, "tlvppageoff") {
		it.Kind = IT_LO12
		it.Spec = SPEC_TLVPPAGEOFF
	} else if nameIs(tok.Text, "plt") && !asm.IsGeneratedLabel(it.Label) {
		// (clang takes no @PLT on a numeric local label reference: `b 1b@PLT`.)
		it.Spec = SPEC_PLT
	} else {
		setErr(p,
				"unsupported symbol specifier (@PAGE, @PAGEOFF, @GOTPAGE, @GOTPAGEOFF, @PLT, @TLVPPAGE, "
						"@TLVPPAGEOFF)")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_PLUS || tok.Kind == TOK_MINUS {
		var neg bool = tok.Kind == TOK_MINUS
		l, tok = LexNext(l)
		var v int64 = 0
		var ok bool = false
		l, tok, v, ok = parseAddendTerm(p, l, tok)
		if !ok { return l, tok, it, false }
		if neg { v = 0 - v }
		it.Imm = it.Imm + v
	}
	if (it.Spec == SPEC_TLVPPAGE || it.Spec == SPEC_TLVPPAGEOFF) && it.Imm != 0 {
		setErr(p, "a thread-local variable reference (@TLVPPAGE, @TLVPPAGEOFF) takes no addend")
		return l, tok, it, false
	}
	return l, tok, it, true
}

// parseAddendTerm parses the addend after a symbol specifier's '+' / '-': one term — a
// number, a number constant's name or a parenthesized expression — as clang takes it
// there (`sym@PAGE+8`, `sym@PAGE+N`, `sym@PAGE+(4*2)`, not `sym@PAGE+4+4`).
func parseAddendTerm(p @Parser, l Lexer, tok Token) (Lexer, Token, int64, bool) {
	var v int64 = 0
	if tok.Kind == TOK_INT || tok.Kind == TOK_CHAR {
		v = tok.Ival
		l, tok = LexNext(l)
	} else if tok.Kind == TOK_IDENT && constIndex(p, tok.Text) >= 0 {
		var r ExprResult = nameValue(p, tok.Text, false)
		if !r.Ok {
			setErr(p, r.Err)
			return l, tok, 0, false
		}
		v = r.Val
		l, tok = LexNext(l)
	} else if tok.Kind == TOK_LPAREN {
		// Only the parenthesized term: `(` expr `)`, so a following `+2` is not folded
		// into the value the caller then negates (`sym@PAGE-(4)+2` must not become -6).
		l, tok = LexNext(l)
		var r ExprResult
		l, tok, r = ParseExpr(p, l, tok)
		if !r.Ok {
			setErr(p, exprErr(r, "invalid parenthesized symbol addend"))
			return l, tok, 0, false
		}
		if tok.Kind != TOK_RPAREN {
			setErr(p, "invalid parenthesized symbol addend")
			return l, tok, 0, false
		}
		v = r.Val
		l, tok = LexNext(l)
	} else {
		setErr(p, "expected a number, a constant or a parenthesized expression as the addend")
		return l, tok, 0, false
	}
	if tok.Kind != TOK_EOF && tok.Kind != TOK_COMMA && tok.Kind != TOK_RBRACKET {
		setErr(p, "the addend after a symbol specifier is a single term")
		return l, tok, 0, false
	}
	return l, tok, v, true
}

// soleConstName reports whether the operand that starts at tok (l just after it) and that end
// is now past (the token after the operand, as parseSymExpr leaves it) is one constant's name,
// alone or in parentheses (`N`, `(N)`).
func soleConstName(p @Parser, tok Token, l Lexer, end Lexer) bool {
	var t Token = tok
	var k Lexer = l
	var parens bool = t.Kind == TOK_LPAREN
	if parens { k, t = LexNext(k) }
	if t.Kind != TOK_IDENT || isDigit(t.Text[0]) || constIndex(p, t.Text) < 0 { return false }
	if parens {
		k, t = LexNext(k)
		if t.Kind != TOK_RPAREN { return false }
	}
	k, _ = LexNext(k)
	return k.Pos == end.Pos
}

// parseQualifiedItem finishes a `:qual:expr` operand with l positioned so the next token is the
// qualifier (just past the opening ':'): `:lo12:` (a page offset, IT_LO12), `:got_lo12:` (the GOT
// slot's page offset, IT_LO12 / SPEC_GOTPAGEOFF), `:gotpage_lo15:` (the slot's offset from the
// GOT's page, IT_LO12 / SPEC_GOTPAGE_LO15), `:got:` (the GOT slot's page, IT_LABEL / SPEC_GOTPAGE),
// `:pg_hi21_nc:` (the page, unchecked, IT_LABEL / SPEC_PAGE_NC), a thread-local page offset
// (`:tprel_lo12:`, `:gottprel_lo12:`, `:tlsdesc_lo12:`, …; IT_LO12, its Spec the kind,
// aarch64_tls.bn) or page (`:gottprel:`, `:tlsdesc:`, `:tlsdesc_auth:`; IT_LABEL, its Spec the
// kind), or a MOVW-group operator (`:abs_g1:`, `:prel_g0_nc:`, `:tprel_g1:`, `:gottprel_g1:`, …;
// IT_MOVW, see movwSpecKind).  A thread-local GOT-slot or descriptor reference takes no addend
// (isTlsSlotKind).  The expression is a symbol plus a number (`:lo12:sym+8`, `:lo12:(sym+8)`,
// `:lo12:8+sym`), or `.` plus a number, which names a label made at this instruction (dotLabel).
// An absolute MOVW-group operator also takes a number (an IT_MOVW with no Label, which the
// move-wide instructions fold as clang does); a difference of locations written there is an error,
// as in clang, but a constant whose value is one is not, given alone (`N`, `(N)`), as clang folds
// it.  Any other qualifier's number is an error (clang folds `:lo12:N`, and relocates `:got:N` and
// `:pg_hi21_nc:N` against an absolute symbol), and so is a PC-relative MOVW operator's (clang's
// message for it is about thread-local variables).
func parseQualifiedItem(p @Parser, l Lexer) (Lexer, Token, a64Item, bool) {
	var it a64Item
	var tok Token
	l, tok = LexNext(l) // the qualifier
	if tok.Kind != TOK_IDENT {
		setErr(p,
				"expected a relocation qualifier (:lo12:, :got:, :got_lo12:, :gotpage_lo15:, "
						":pg_hi21_nc:, :abs_g*:, :prel_g*:, :tprel_*:, :dtprel_*:, :gottprel*:, :tlsdesc*:)")
		return l, tok, it, false
	}
	var movw int = movwSpecKind(tok.Text)
	if movw >= 0 {
		it.Kind = IT_MOVW
		it.Spec = movw
	} else if nameIs(tok.Text, "lo12") {
		it.Kind = IT_LO12
	} else if nameIs(tok.Text, "got_lo12") {
		it.Kind = IT_LO12
		it.Spec = SPEC_GOTPAGEOFF
	} else if nameIs(tok.Text, "gotpage_lo15") {
		it.Kind = IT_LO12
		it.Spec = SPEC_GOTPAGE_LO15
	} else if nameIs(tok.Text, "got") {
		it.Kind = IT_LABEL
		it.Spec = SPEC_GOTPAGE
	} else if nameIs(tok.Text, "pg_hi21_nc") {
		it.Kind = IT_LABEL
		it.Spec = SPEC_PAGE_NC
	} else if tlsLo12Kind(tok.Text) >= 0 {
		it.Kind = IT_LO12
		it.Spec = tlsLo12Kind(tok.Text)
	} else if tlsLabelKind(tok.Text) >= 0 {
		it.Kind = IT_LABEL
		it.Spec = tlsLabelKind(tok.Text)
	} else {
		setErr(p,
				"unsupported relocation qualifier (:lo12:, :got:, :got_lo12:, :gotpage_lo15:, "
						":pg_hi21_nc:, :abs_g*:, :prel_g*:, :tprel_*:, :dtprel_*:, :gottprel*:, :tlsdesc*:)")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COLON {
		setErr(p, "expected ':' after the relocation qualifier")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	var first Token = tok
	var start Lexer = l
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid symbol after the relocation qualifier"))
		return l, tok, it, false
	}
	if r.Dot { r.Sym = dotLabel(p) }
	if len(r.Sym) == 0 && it.Kind == IT_MOVW && movwAbsolute(it.Spec) {
		if r.FromDiff && !soleConstName(p, first, start, l) {
			setErr(p,
					"a MOVW-group relocation operator takes a symbol or a number, not a difference of locations")
			return l, tok, it, false
		}
	} else if len(r.Sym) == 0 {
		setErr(p, "a relocation qualifier takes a symbol, not a number")
		return l, tok, it, false
	}
	it.Label = r.Sym
	it.Imm = r.Val
	if isTlsSlotKind(it.Spec) && it.Imm != 0 {
		setErr(p, "a GOT-slot or TLS-descriptor reference takes no addend")
		return l, tok, it, false
	}
	if tok.Kind == TOK_AT {
		setErr(p, "a qualified operand takes no @ specifier")
		return l, tok, it, false
	}
	return l, tok, it, true
}
