package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the symbol operands of the AArch64 operand-list scanner
// (aarch64_items_sym.bn): labels and their addends (parseLabelTail / parseAddendTerm), the
// Mach-O `@` specifiers, the ELF `:qual:` operands (parseQualifiedItem), and `.`
// (IT_DOT).  The helpers are in aarch64_items_test.bn.  Accepted forms match clang
// (Mach-O for `@` specifiers, aarch64-linux-gnu for `:qual:` and `@PLT`).

// itemSymCase checks that src is the one symbol operand of the given kind (IT_LABEL or
// IT_LO12), symbol, addend and specifier.
func itemSymCase(e @[]char, src *[]readonly char, kind int, label *[]readonly char, imm int64,
		spec int) @[]char {
	e2, it, ok := itemOnlyCheck(e, src, kind)
	if !ok { return e2 }
	if !charsEqual(it.Label, label) { return goldenFail(e, src, "wrong symbol") }
	if it.Imm != imm { return goldenFail(e, src, "wrong addend") }
	if it.Spec != spec { return goldenFail(e, src, "wrong specifier") }
	return e
}

// itemDotCase checks that src is the one `.` operand with offset imm.
func itemDotCase(e @[]char, src *[]readonly char, imm int64) @[]char {
	e2, it, ok := itemOnlyCheck(e, src, IT_DOT)
	if !ok { return e2 }
	if it.Imm != imm { return goldenFail(e, src, "wrong offset from '.'") }
	return e
}

// itemAddendOrRejectCase checks that src is either rejected or the one operand of the
// given kind with addend imm — never accepted with a different addend.
func itemAddendOrRejectCase(e @[]char, src *[]readonly char, kind int, imm int64) @[]char {
	its, ok, _ := itemsScanLine(src)
	if !ok { return e }
	if its.N != 1 || its.It[0].Kind != kind { return goldenFail(e, src, "wrong operand shape") }
	if its.It[0].Imm != imm { return goldenFail(e, src, "accepted with the wrong addend") }
	return e
}

// lineWordOrRejectCase checks that line is either rejected or assembles to exactly the
// one word want — never to a different word.
func lineWordOrRejectCase(e @[]char, line *[]readonly char, want uint32) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine(line)
	if p.HasError { return e }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 4 || readInst(s, 0) != want {
		return goldenFail(e, line, "assembled to the wrong word")
	}
	return e
}

// A plain symbol plus a number — any sum or difference with numbers, as clang reads it
// (`sym+4+4`, `sym+4*2`, `4+sym`, `(sym+4)`, `sym-(4)+2`); symbol names may contain '.'
// and '_'.
func TestA64ItemsLabels() testing.TestResult {
	var e @[]char = ""
	e = itemSymCase(e, "sym", IT_LABEL, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, "_start", IT_LABEL, "_start", 0, SPEC_NONE)
	e = itemSymCase(e, "memcpy.part.0", IT_LABEL, "memcpy.part.0", 0, SPEC_NONE)
	e = itemSymCase(e, "sym+8", IT_LABEL, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "sym-8", IT_LABEL, "sym", -8, SPEC_NONE)
	e = itemSymCase(e, "sym + 8", IT_LABEL, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "sym+0x10", IT_LABEL, "sym", 16, SPEC_NONE)
	e = itemSymCase(e, "sym+0", IT_LABEL, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, "sym+(8+4)", IT_LABEL, "sym", 12, SPEC_NONE)
	e = itemSymCase(e, "sym-(8+4)", IT_LABEL, "sym", -12, SPEC_NONE)
	e = itemSymCase(e, "sym+(2*4)", IT_LABEL, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "sym+4*2", IT_LABEL, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "sym-4*2", IT_LABEL, "sym", -8, SPEC_NONE)
	e = itemSymCase(e, "sym+4+4", IT_LABEL, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "sym-4+12", IT_LABEL, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "4+sym", IT_LABEL, "sym", 4, SPEC_NONE)
	e = itemSymCase(e, "(sym+4)", IT_LABEL, "sym", 4, SPEC_NONE)
	e = itemSymCase(e, "(sym)", IT_LABEL, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, "sym-(4)+2", IT_LABEL, "sym", -2, SPEC_NONE)
	e = itemSymCase(e, "#sym+4", IT_LABEL, "sym", 4, SPEC_NONE)
	e = itemsCountCase(e, "x0, sym+8, sym-(1+1)", 3)
	return e
}

// A symbol takes only numbers added to or subtracted from it: a missing operand, a
// second symbol, a negated or scaled symbol, and anything left after the expression are
// rejected.
func TestA64ItemsLabelAddendRejects() testing.TestResult {
	var e @[]char = ""
	e = itemsRejectCase(e, "sym+4 x")
	e = itemsRejectCase(e, "-sym")
	e = itemsRejectCase(e, "~sym")
	e = itemsRejectCase(e, "4-sym")
	e = itemsRejectCase(e, "sym+sym")
	e = itemsRejectCase(e, "sym+8>>1")
	e = itemsRejectCase(e, "sym+")
	e = itemsRejectCase(e, "sym-")
	e = itemsRejectCase(e, "sym+foo")
	e = itemsRejectCase(e, "sym+#4")
	e = itemsRejectCase(e, "sym+(4")
	e = itemsRejectCase(e, "sym*2")
	e = itemsRejectCase(e, "sym sym")
	return e
}

// A parenthesized addend is the whole addend: in `sym-(4)+2` the '-' negates only the
// parenthesized term, so the value is sym-2 (clang: `add x0, x0, :lo12:sym-(4)+2` is
// R_AARCH64_ADD_ABS_LO12_NC sym-0x2, and `b .-(8)+4` is 0x17FFFFFF).  Rejecting the
// trailing `+2` (as `sym+4*2` is rejected) would also be correct; reading the addend
// as -(4+2) is not.
func TestA64ItemsParenAddendSign() testing.TestResult {
	var e @[]char = ""
	e = itemAddendOrRejectCase(e, "sym-(4)+2", IT_LABEL, -2)
	e = itemAddendOrRejectCase(e, "sym-(8)-4", IT_LABEL, -12)
	e = itemAddendOrRejectCase(e, ":lo12:sym-(4)+2", IT_LO12, -2)
	e = itemAddendOrRejectCase(e, ".-(8)+4", IT_DOT, -4)
	e = lineWordOrRejectCase(e, "b .-(8)+4", 0x17FFFFFF)
	e = lineWordOrRejectCase(e, "b .-(8)-4", 0x17FFFFFD)
	return e
}

// The `@` specifiers, case-insensitively: @PAGE and @GOTPAGE (and @PLT) stay IT_LABEL
// with their specifier; @PAGEOFF and @GOTPAGEOFF make the operand a page offset.
func TestA64ItemsPageSpecifiers() testing.TestResult {
	var e @[]char = ""
	e = itemSymCase(e, "sym@PAGE", IT_LABEL, "sym", 0, SPEC_PAGE)
	e = itemSymCase(e, "sym@PAGEOFF", IT_LO12, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, "sym@GOTPAGE", IT_LABEL, "sym", 0, SPEC_GOTPAGE)
	e = itemSymCase(e, "sym@GOTPAGEOFF", IT_LO12, "sym", 0, SPEC_GOTPAGEOFF)
	e = itemSymCase(e, "sym@PLT", IT_LABEL, "sym", 0, SPEC_PLT)
	e = itemSymCase(e, "sym@page", IT_LABEL, "sym", 0, SPEC_PAGE)
	e = itemSymCase(e, "sym@PageOff", IT_LO12, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, "sym@gotpage", IT_LABEL, "sym", 0, SPEC_GOTPAGE)
	e = itemSymCase(e, "sym@plt", IT_LABEL, "sym", 0, SPEC_PLT)
	e = itemSymCase(e, "sym @ PAGE", IT_LABEL, "sym", 0, SPEC_PAGE)
	return e
}

// An addend may precede the specifier (`sym+8@PAGE`, any sum) or follow it as one term
// (`sym@PAGE+8`); both together add up (clang: `sym+4@PAGE+8` is sym+12).
func TestA64ItemsPageSpecifierAddends() testing.TestResult {
	var e @[]char = ""
	e = itemSymCase(e, "sym@PAGE+8", IT_LABEL, "sym", 8, SPEC_PAGE)
	e = itemSymCase(e, "sym+8@PAGE", IT_LABEL, "sym", 8, SPEC_PAGE)
	e = itemSymCase(e, "sym-8@PAGE", IT_LABEL, "sym", -8, SPEC_PAGE)
	e = itemSymCase(e, "sym@PAGE-8", IT_LABEL, "sym", -8, SPEC_PAGE)
	e = itemSymCase(e, "sym@PAGE+(4+4)", IT_LABEL, "sym", 8, SPEC_PAGE)
	e = itemSymCase(e, "sym+0@PAGE+8", IT_LABEL, "sym", 8, SPEC_PAGE)
	e = itemSymCase(e, "sym+4@PAGE+8", IT_LABEL, "sym", 12, SPEC_PAGE)
	e = itemSymCase(e, "sym+4*2@PAGE", IT_LABEL, "sym", 8, SPEC_PAGE)
	e = itemSymCase(e, "(sym+4)@PAGE", IT_LABEL, "sym", 4, SPEC_PAGE)
	e = itemSymCase(e, "sym@PAGEOFF+8", IT_LO12, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "sym+4@PAGEOFF", IT_LO12, "sym", 4, SPEC_NONE)
	e = itemSymCase(e, "sym@PAGEOFF-4", IT_LO12, "sym", -4, SPEC_NONE)
	return e
}

// Unknown or missing specifiers, a second specifier, and malformed addends after the
// specifier are rejected.
func TestA64ItemsPageSpecifierRejects() testing.TestResult {
	var e @[]char = ""
	e = itemsRejectCase(e, "sym@FOO")
	e = itemsRejectCase(e, "sym@TLVPPAGE")
	e = itemsRejectCase(e, "sym@")
	e = itemsRejectCase(e, "sym@8")
	e = itemsRejectCase(e, "sym@PAGE@PAGEOFF")
	e = itemsRejectCase(e, "sym@PAGE+")
	e = itemsRejectCase(e, "sym@PAGE+4*2")
	e = itemsRejectCase(e, "sym@PAGE+4+4")
	e = itemsRejectCase(e, "sym@PAGE x")
	e = itemsRejectCase(e, "sym@PAGE, @PAGE")
	return e
}

// The `:qual:sym` operands, with or without a leading '#', case-insensitively and with
// an addend: :lo12: is a page offset, :got_lo12: the GOT slot's page offset, :got: the
// GOT slot's page.
func TestA64ItemsRelocQualifiers() testing.TestResult {
	var e @[]char = ""
	e = itemSymCase(e, ":lo12:sym", IT_LO12, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, "#:lo12:sym", IT_LO12, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, ":lo12:sym+8", IT_LO12, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, "#:lo12:sym-8", IT_LO12, "sym", -8, SPEC_NONE)
	e = itemSymCase(e, ":lo12:sym+(4+4)", IT_LO12, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, ":lo12:sym+4*2", IT_LO12, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, ":lo12:(sym+8)", IT_LO12, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, ":lo12:8+sym", IT_LO12, "sym", 8, SPEC_NONE)
	e = itemSymCase(e, ":lo12:memcpy.part.0", IT_LO12, "memcpy.part.0", 0, SPEC_NONE)
	e = itemSymCase(e, ":LO12:sym", IT_LO12, "sym", 0, SPEC_NONE)
	e = itemSymCase(e, ":got_lo12:sym", IT_LO12, "sym", 0, SPEC_GOTPAGEOFF)
	e = itemSymCase(e, "#:got_lo12:sym", IT_LO12, "sym", 0, SPEC_GOTPAGEOFF)
	e = itemSymCase(e, ":GOT_LO12:sym", IT_LO12, "sym", 0, SPEC_GOTPAGEOFF)
	e = itemSymCase(e, ":got:sym", IT_LABEL, "sym", 0, SPEC_GOTPAGE)
	e = itemSymCase(e, "#:got:sym", IT_LABEL, "sym", 0, SPEC_GOTPAGE)
	e = itemSymCase(e, ":Got:sym", IT_LABEL, "sym", 0, SPEC_GOTPAGE)
	e = itemsCountCase(e, "x0, x0, #:lo12:sym", 3)
	return e
}

// Malformed qualifiers: unknown or missing qualifier, missing ':' or symbol, an `@`
// specifier after a qualified operand (its relocation is already fixed), and a
// malformed addend.
func TestA64ItemsRelocQualifierRejects() testing.TestResult {
	var e @[]char = ""
	e = itemsRejectCase(e, ":foo:sym")
	e = itemsRejectCase(e, "#:foo:sym")
	e = itemsRejectCase(e, ":")
	e = itemsRejectCase(e, "#:")
	e = itemsRejectCase(e, "::lo12:sym")
	e = itemsRejectCase(e, ":lo12 sym")
	e = itemsRejectCase(e, ":lo12::sym")
	e = itemsRejectCase(e, ":lo12:")
	e = itemsRejectCase(e, ":lo12:8")
	e = itemsRejectCase(e, ":lo12:#sym")
	e = itemsRejectCase(e, ":lo12:sym@PAGEOFF")
	e = itemsRejectCase(e, ":got:sym@PAGE")
	e = itemsRejectCase(e, ":got_lo12:sym@GOTPAGEOFF")
	e = itemsRejectCase(e, ":lo12:sym*2")
	e = itemsRejectCase(e, ":lo12:sym+")
	return e
}

// `.` is the current location, plus or minus numbers (`.+4*2`, `4+.`).
func TestA64ItemsDot() testing.TestResult {
	var e @[]char = ""
	e = itemDotCase(e, ".", 0)
	e = itemDotCase(e, ".+8", 8)
	e = itemDotCase(e, ".-8", -8)
	e = itemDotCase(e, ". + 8", 8)
	e = itemDotCase(e, ".+0x10", 16)
	e = itemDotCase(e, ".+(4+4)", 8)
	e = itemDotCase(e, ".-(2*4)", -8)
	e = itemDotCase(e, ".+4*2", 8)
	e = itemDotCase(e, ". + 4 + 4", 8)
	e = itemDotCase(e, "4+.", 4)
	e = itemsCountCase(e, "x0, ., .+4", 3)
	return e
}

// A name may start with '.' (`.Lfoo`, `.foo`, `..x`, `.$x`: clang's symbol names), with
// an addend or specifier like any symbol.
func TestA64ItemsDotNames() testing.TestResult {
	var e @[]char = ""
	e = itemSymCase(e, ".Lfoo", IT_LABEL, ".Lfoo", 0, SPEC_NONE)
	e = itemSymCase(e, ".L1+4", IT_LABEL, ".L1", 4, SPEC_NONE)
	e = itemSymCase(e, ".foo.bar", IT_LABEL, ".foo.bar", 0, SPEC_NONE)
	e = itemSymCase(e, "..x", IT_LABEL, "..x", 0, SPEC_NONE)
	e = itemSymCase(e, ".$x", IT_LABEL, ".$x", 0, SPEC_NONE)
	e = itemSymCase(e, ".Lp@PAGE", IT_LABEL, ".Lp", 0, SPEC_PAGE)
	return e
}

// A `.` operand followed by a separate name, or with a missing or malformed offset, is
// rejected, as is anything else after `.`.
func TestA64ItemsDotRejects() testing.TestResult {
	var e @[]char = ""
	e = itemsRejectCase(e, ". foo")
	e = itemsRejectCase(e, ".1")
	e = itemsRejectCase(e, ".+")
	e = itemsRejectCase(e, ".-")
	e = itemsRejectCase(e, ".+foo")
	e = itemsRejectCase(e, ".*2")
	return e
}

// parseAddendTerm reads one number, constant or parenthesized expression and accepts only
// ',', ']' or end of line after it.
func TestA64ParseAddendTerm() testing.TestResult {
	var p @Parser = newTestParser()
	var l Lexer = NewLexer("8, x0", 1)
	var tok Token
	l, tok = LexNext(l)
	var v int64 = 0
	var ok bool = false
	l, tok, v, ok = parseAddendTerm(p, l, tok)
	if !ok || v != 8 || tok.Kind != TOK_COMMA { return fail("`8,` not read as 8") }
	l = NewLexer("(1+2)]", 1)
	l, tok = LexNext(l)
	l, tok, v, ok = parseAddendTerm(p, l, tok)
	if !ok || v != 3 || tok.Kind != TOK_RBRACKET { return fail("`(1+2)]` not read as 3") }
	p.ParseLine("N = 5")
	l = NewLexer("N", 1)
	l, tok = LexNext(l)
	l, tok, v, ok = parseAddendTerm(p, l, tok)
	if !ok || v != 5 || tok.Kind != TOK_EOF { return fail("`N` not read as 5") }
	if p.HasError { return fail("error set by an accepted addend") }
	var bad [6]*[]readonly char
	bad[0] = "sym"
	bad[1] = "#8"
	bad[2] = "8*2"
	bad[3] = "8 x"
	bad[4] = "(8"
	bad[5] = "8@PAGE"
	for i := 0; i < 6; i++ {
		var q @Parser = newTestParser()
		l = NewLexer(bad[i], 1)
		l, tok = LexNext(l)
		l, tok, v, ok = parseAddendTerm(q, l, tok)
		if ok || !q.HasError { return fail(buf.Concat("accepted addend ", bad[i])) }
	}
	return ""
}

// parseQualifiedItem starts just past the opening ':' and stops at the token after the
// operand, carrying the qualifier's kind / specifier and the addend.
func TestA64ParseQualifiedItem() testing.TestResult {
	var p @Parser = newTestParser()
	var l Lexer = NewLexer("lo12:sym+4, x0", 1)
	var tok Token
	var it a64Item
	var ok bool = false
	l, tok, it, ok = parseQualifiedItem(p, l)
	if !ok || it.Kind != IT_LO12 || it.Spec != SPEC_NONE { return fail("lo12 kind") }
	if !charsEqual(it.Label, "sym") || it.Imm != 4 { return fail("lo12 symbol / addend") }
	if tok.Kind != TOK_COMMA { return fail("lo12 did not stop at ','") }
	l = NewLexer("got:sym]", 1)
	l, tok, it, ok = parseQualifiedItem(p, l)
	if !ok || it.Kind != IT_LABEL || it.Spec != SPEC_GOTPAGE { return fail("got kind") }
	if tok.Kind != TOK_RBRACKET { return fail("got did not stop at ']'") }
	l = NewLexer("got_lo12:sym", 1)
	l, tok, it, ok = parseQualifiedItem(p, l)
	if !ok || it.Kind != IT_LO12 || it.Spec != SPEC_GOTPAGEOFF { return fail("got_lo12 kind") }
	if tok.Kind != TOK_EOF { return fail("got_lo12 did not stop at end of line") }
	l = NewLexer("gotpage_lo15:sym]", 1)
	l, tok, it, ok = parseQualifiedItem(p, l)
	if !ok || it.Kind != IT_LO12 || it.Spec != SPEC_GOTPAGE_LO15 { return fail("gotpage_lo15 kind") }
	if tok.Kind != TOK_RBRACKET { return fail("gotpage_lo15 did not stop at ']'") }
	return ""
}

// parseLabelTail on an IT_LABEL reads the specifier and the addend after it, adding that
// to the item's addend, and stops after them.
func TestA64ParseLabelTail() testing.TestResult {
	var p @Parser = newTestParser()
	var l Lexer = NewLexer("@PAGE+8, x1", 1)
	var tok Token
	l, tok = LexNext(l)
	var it a64Item
	it.Kind = IT_LABEL
	it.Imm = 4
	var ok bool = false
	l, tok, it, ok = parseLabelTail(p, l, tok, it)
	if !ok || it.Kind != IT_LABEL || it.Spec != SPEC_PAGE || it.Imm != 12 {
		return fail("@PAGE+8 not read (onto an addend of 4)")
	}
	if tok.Kind != TOK_COMMA { return fail("did not stop at ','") }
	l = NewLexer("", 1)
	l, tok = LexNext(l)
	var plain a64Item
	plain.Kind = IT_LABEL
	l, tok, plain, ok = parseLabelTail(p, l, tok, plain)
	if !ok || plain.Imm != 0 || plain.Spec != SPEC_NONE { return fail("empty tail changed it") }
	return ""
}
