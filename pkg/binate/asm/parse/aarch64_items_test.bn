package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the AArch64 operand-list scanner (parseA64Items / parseA64Item in
// aarch64_items.bn): list shape, registers, immediates, shift / extend modifiers,
// condition codes, and the rejection of anything left after the last operand.  The
// symbol operands (labels, `@` specifiers, `:qual:` operands, `.`) are tested in
// aarch64_items_sym_test.bn.  Condition-code values are clang's (`csel x0, x1, x2,
// <cond>`, bits 15:12).

// itemsScanLine scans src as an operand list in a fresh parser, returning the list,
// whether the scan succeeded, and the parser.
func itemsScanLine(src *[]readonly char) (a64Items, bool, @Parser) {
	var p @Parser = newTestParser()
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	its, ok := parseA64Items(p, l, tok)
	return its, ok, p
}

// itemOnlyCheck scans src, which must be exactly one operand of the given kind,
// returning it; on a mismatch it appends a failure to e and returns ok=false.
func itemOnlyCheck(e @[]char, src *[]readonly char, kind int) (@[]char, a64Item, bool) {
	its, ok, p := itemsScanLine(src)
	var it a64Item
	if !ok { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)), it, false }
	if p.HasError { return goldenFail(e, src, "accepted with an error set"), it, false }
	if its.N != 1 { return goldenFail(e, src, "not exactly one operand"), it, false }
	it = its.It[0]
	if it.Kind != kind { return goldenFail(e, src, "wrong operand kind"), it, false }
	return e, it, true
}

// itemsRejectCase checks that scanning src fails with p's error set.
func itemsRejectCase(e @[]char, src *[]readonly char) @[]char {
	_, ok, p := itemsScanLine(src)
	if ok { return goldenFail(e, src, "accepted a malformed operand list") }
	if !p.HasError { return goldenFail(e, src, "rejected without an error message") }
	return e
}

// itemsCountCase checks that src scans to exactly n operands.
func itemsCountCase(e @[]char, src *[]readonly char, n int) @[]char {
	its, ok, p := itemsScanLine(src)
	if !ok { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if its.N != n { return goldenFail(e, src, "wrong operand count") }
	return e
}

// itemRegCase checks that src is the one register operand reg of class cls.
func itemRegCase(e @[]char, src *[]readonly char, reg int, cls int) @[]char {
	e2, it, ok := itemOnlyCheck(e, src, IT_REG)
	if !ok { return e2 }
	if it.Reg != reg || it.Cls != cls { return goldenFail(e, src, "wrong register") }
	return e
}

// itemImmCase checks that src is the one immediate operand imm.
func itemImmCase(e @[]char, src *[]readonly char, imm int64) @[]char {
	e2, it, ok := itemOnlyCheck(e, src, IT_IMM)
	if !ok { return e2 }
	if it.Imm != imm { return goldenFail(e, src, "wrong immediate value") }
	return e
}

// itemModCase checks that src is the one modifier operand mod, with the amount amt
// when amtGiven.
func itemModCase(e @[]char, src *[]readonly char, mod int, amtGiven bool, amt int) @[]char {
	e2, it, ok := itemOnlyCheck(e, src, IT_MOD)
	if !ok { return e2 }
	if it.Mod != mod { return goldenFail(e, src, "wrong modifier") }
	if it.AmtGiven != amtGiven { return goldenFail(e, src, "wrong amount-given flag") }
	if amtGiven && it.Amt != amt { return goldenFail(e, src, "wrong amount") }
	return e
}

// itemCondCase checks that src is the one condition-code operand cond.
func itemCondCase(e @[]char, src *[]readonly char, cond int) @[]char {
	e2, it, ok := itemOnlyCheck(e, src, IT_COND)
	if !ok { return e2 }
	if it.Cond != cond { return goldenFail(e, src, "wrong condition code") }
	return e
}

// An empty operand list (end of line, or only a comment) scans to zero operands.
func TestA64ItemsEmpty() testing.TestResult {
	var e @[]char = ""
	e = itemsCountCase(e, "", 0)
	e = itemsCountCase(e, "   ", 0)
	e = itemsCountCase(e, "// just a comment", 0)
	return e
}

// A comma-separated list keeps every operand in order, with or without spaces.
func TestA64ItemsListShape() testing.TestResult {
	its, ok, p := itemsScanLine("x0, w1,d2 ,  #3, lsl #4")
	if !ok { return fail(p.ErrorMsg) }
	if its.N != 5 { return fail("expected 5 operands") }
	if its.It[0].Kind != IT_REG || its.It[0].Reg != 0 || its.It[0].Cls != RC_X {
		return fail("operand 0 is not x0")
	}
	if its.It[1].Kind != IT_REG || its.It[1].Reg != 1 || its.It[1].Cls != RC_W {
		return fail("operand 1 is not w1")
	}
	if its.It[2].Kind != IT_REG || its.It[2].Reg != 2 || its.It[2].Cls != RC_D {
		return fail("operand 2 is not d2")
	}
	if its.It[3].Kind != IT_IMM || its.It[3].Imm != 3 { return fail("operand 3 is not #3") }
	if its.It[4].Kind != IT_MOD || its.It[4].Mod != MOD_LSL || its.It[4].Amt != 4 {
		return fail("operand 4 is not lsl #4")
	}
	var e @[]char = ""
	e = itemsCountCase(e, "x0, #5, #4, ne", 4)
	e = itemsCountCase(e, "x0, x1, x2, x3", 4)
	e = itemsCountCase(e, "x0, sym@PAGEOFF // trailing comment", 2)
	return e
}

// Up to six operands scan; a seventh is "too many operands".
func TestA64ItemsTooMany() testing.TestResult {
	var e @[]char = ""
	e = itemsCountCase(e, "x0, x1, x2, x3, x4, x5", 6)
	e = itemsCountCase(e, "x0, x1, x2, lsl #3, #1, eq", 6)
	e = itemsRejectCase(e, "x0, x1, x2, x3, x4, x5, x6")
	e = itemsRejectCase(e, "#1, #2, #3, #4, #5, #6, #7, #8")
	return e
}

// Anything after an operand other than ',' or end of line is an error, as is an empty
// operand (a leading, doubled, or dangling ',') or a token that starts no operand.
func TestA64ItemsTrailingTokens() testing.TestResult {
	var e @[]char = ""
	e = itemsRejectCase(e, "x0 x1")
	e = itemsRejectCase(e, "x0, x1]")
	e = itemsRejectCase(e, "x0 ]")
	e = itemsRejectCase(e, "#1 #2")
	e = itemsRejectCase(e, "#1)")
	e = itemsRejectCase(e, "x0, lsl #3 x1")
	e = itemsRejectCase(e, "eq ne")
	e = itemsRejectCase(e, "x0!")
	e = itemsRejectCase(e, "x0,")
	e = itemsRejectCase(e, ", x0")
	e = itemsRejectCase(e, "x0,, x1")
	e = itemsRejectCase(e, "x0, [x1]")
	e = itemsRejectCase(e, "x0, {x1}")
	e = itemsRejectCase(e, "x0, \"str\"")
	return e
}

// Registers of every class scan as IT_REG, including the aliases, zero registers,
// x31 / w31, SP / WSP, and mixed case.
func TestA64ItemsRegisters() testing.TestResult {
	var e @[]char = ""
	e = itemRegCase(e, "x0", 0, RC_X)
	e = itemRegCase(e, "W30", 30, RC_W)
	e = itemRegCase(e, "fp", 29, RC_X)
	e = itemRegCase(e, "LR", 30, RC_X)
	e = itemRegCase(e, "xzr", 31, RC_XZR)
	e = itemRegCase(e, "w31", 31, RC_WZR)
	e = itemRegCase(e, "sp", 31, RC_SP)
	e = itemRegCase(e, "wsp", 31, RC_WSP)
	e = itemRegCase(e, "b7", 7, RC_B)
	e = itemRegCase(e, "h8", 8, RC_H)
	e = itemRegCase(e, "s9", 9, RC_S)
	e = itemRegCase(e, "D10", 10, RC_D)
	e = itemRegCase(e, "q31", 31, RC_Q)
	return e
}

// Immediates: `#expr`, or a bare numeric expression (one starting with a number, '-',
// '~' or '('); hex, negative, and operator expressions evaluate.
func TestA64ItemsImmediates() testing.TestResult {
	var e @[]char = ""
	e = itemImmCase(e, "#5", 5)
	e = itemImmCase(e, "5", 5)
	e = itemImmCase(e, "#0", 0)
	e = itemImmCase(e, "#-5", -5)
	e = itemImmCase(e, "-5", -5)
	e = itemImmCase(e, "#0x10", 16)
	e = itemImmCase(e, "0xffff", 65535)
	e = itemImmCase(e, "(2+3)", 5)
	e = itemImmCase(e, "#(2+3)*2", 10)
	e = itemImmCase(e, "#1<<4", 16)
	e = itemImmCase(e, "~0", -1)
	e = itemImmCase(e, "#0x100000000", 4294967296)
	e = itemsRejectCase(e, "#")
	e = itemsRejectCase(e, "#)")
	e = itemsRejectCase(e, "(1")
	e = itemsRejectCase(e, "#1/0")
	return e
}

// A unary '+' starts an immediate, with or without '#' (clang: `add x0, x1, +3` and
// `add x0, x1, #+3` are both 0x91000C20); startsNumericExpr admits a leading '+'.
func TestA64ItemsUnaryPlusImmediate() testing.TestResult {
	var e @[]char = ""
	e = itemImmCase(e, "+3", 3)
	e = itemImmCase(e, "#+3", 3)
	e = goldenWord(e, "add x0, x1, #+3", 0x91000C20)
	e = goldenWord(e, "add x0, x1, +3", 0x91000C20)
	return e
}

// Each shift / extend keyword maps to its MOD_* kind, case-insensitively, with no
// amount given.
func TestA64ItemsModifierNames() testing.TestResult {
	var e @[]char = ""
	e = itemModCase(e, "lsl", MOD_LSL, false, 0)
	e = itemModCase(e, "lsr", MOD_LSR, false, 0)
	e = itemModCase(e, "asr", MOD_ASR, false, 0)
	e = itemModCase(e, "ror", MOD_ROR, false, 0)
	e = itemModCase(e, "uxtb", MOD_UXTB, false, 0)
	e = itemModCase(e, "uxth", MOD_UXTH, false, 0)
	e = itemModCase(e, "uxtw", MOD_UXTW, false, 0)
	e = itemModCase(e, "uxtx", MOD_UXTX, false, 0)
	e = itemModCase(e, "sxtb", MOD_SXTB, false, 0)
	e = itemModCase(e, "sxth", MOD_SXTH, false, 0)
	e = itemModCase(e, "sxtw", MOD_SXTW, false, 0)
	e = itemModCase(e, "sxtx", MOD_SXTX, false, 0)
	e = itemModCase(e, "LSL", MOD_LSL, false, 0)
	e = itemModCase(e, "Uxtb", MOD_UXTB, false, 0)
	e = itemModCase(e, "sXtW", MOD_SXTW, false, 0)
	if parseModName("lsx") != -1 || parseModName("") != -1 || parseModName("lsll") != -1 {
		return fail("parseModName accepted a non-modifier")
	}
	return e
}

// A modifier amount may be written with '#' or, as clang accepts, starting with an
// integer literal (`lsl 3`, `lsl 1+1`), and may be an expression; 0 and 64 are the ends
// of the accepted range.  Without '#' clang takes nothing else as an amount (`lsl (3)`,
// `lsl -0`, `lsl ~0` are errors), so neither does this.
func TestA64ItemsModifierAmounts() testing.TestResult {
	var e @[]char = ""
	e = itemModCase(e, "lsl #12", MOD_LSL, true, 12)
	e = itemModCase(e, "lsl 12", MOD_LSL, true, 12)
	e = itemModCase(e, "LSR #3", MOD_LSR, true, 3)
	e = itemModCase(e, "asr 63", MOD_ASR, true, 63)
	e = itemModCase(e, "uxtw #2", MOD_UXTW, true, 2)
	e = itemModCase(e, "sxtx 3", MOD_SXTX, true, 3)
	e = itemModCase(e, "lsl #(1+2)", MOD_LSL, true, 3)
	e = itemModCase(e, "lsl #0", MOD_LSL, true, 0)
	e = itemModCase(e, "lsl #64", MOD_LSL, true, 64)
	e = itemModCase(e, "lsl #0x10", MOD_LSL, true, 16)
	return e
}

// A modifier amount outside 0-64, or an invalid amount expression, is rejected.
func TestA64ItemsModifierAmountRejects() testing.TestResult {
	var e @[]char = ""
	e = itemsRejectCase(e, "lsl #65")
	e = itemsRejectCase(e, "lsl 65")
	e = itemsRejectCase(e, "lsl #-1")
	e = itemsRejectCase(e, "lsl -1")
	e = itemsRejectCase(e, "lsl #")
	e = itemsRejectCase(e, "lsl #)")
	e = itemsRejectCase(e, "x0, x1, lsl #3 #4")
	return e
}

// Every condition code and alias (hs = cs, lo = cc, and nv) has clang's 4-bit value,
// case-insensitively.
func TestA64ItemsConditionCodes() testing.TestResult {
	var e @[]char = ""
	e = itemCondCase(e, "eq", 0)
	e = itemCondCase(e, "ne", 1)
	e = itemCondCase(e, "cs", 2)
	e = itemCondCase(e, "hs", 2)
	e = itemCondCase(e, "cc", 3)
	e = itemCondCase(e, "lo", 3)
	e = itemCondCase(e, "mi", 4)
	e = itemCondCase(e, "pl", 5)
	e = itemCondCase(e, "vs", 6)
	e = itemCondCase(e, "vc", 7)
	e = itemCondCase(e, "hi", 8)
	e = itemCondCase(e, "ls", 9)
	e = itemCondCase(e, "ge", 10)
	e = itemCondCase(e, "lt", 11)
	e = itemCondCase(e, "gt", 12)
	e = itemCondCase(e, "le", 13)
	e = itemCondCase(e, "al", 14)
	e = itemCondCase(e, "nv", 15)
	e = itemCondCase(e, "EQ", 0)
	e = itemCondCase(e, "Ne", 1)
	e = itemCondCase(e, "HS", 2)
	e = itemCondCase(e, "Lo", 3)
	e = itemCondCase(e, "nV", 15)
	if parseCondName("eqq") != -1 || parseCondName("e") != -1 || parseCondName("") != -1 {
		return fail("parseCondName accepted a non-condition")
	}
	return e
}
