package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Text-assembler tests for the AArch64 logical-immediate operand (AND, ORR,
// EOR, ANDS, TST).  The immediate is a bitmask pattern — a rotated run of
// ones within a 2-, 4-, 8-, 16-, 32- or 64-bit element, replicated to fill
// the register — so a value that is not such a pattern has no encoding, and
// the line must be rejected rather than assembled to some other value.
// Expected words are clang's
// (`clang -target arm64-apple-macos -c`, disassembled with objdump).

// newA64TextParser returns a parser with `.arch aarch64` set and an empty
// text section selected.
func newA64TextParser() @Parser {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	return p
}

// 0xff is a run of eight ones in a 64-bit element: N=1, immr=0, imms=7.
func TestParseA64AndImmMask() testing.TestResult {
	return lineEmitsWord(newA64TextParser(), "and x0, x1, #0xff", 0x92401C20)
}

// TST is ANDS with the zero register as destination; 15 is a run of four ones.
func TestParseA64TstImmMask() testing.TestResult {
	return lineEmitsWord(newA64TextParser(), "tst x0, #15", 0xF2400C1F)
}

// 5 (0b101) is not a replicated rotated run of ones at any element size:
// within 8 or more bits its ones form two separate runs, and no 2- or 4-bit
// element repeats to make it.
func TestParseA64AndImmNotBitmaskRejected() testing.TestResult {
	return lineRejected(newA64TextParser(), "and x0, x1, #5")
}

// 0x1234 is not a replicated rotated run of ones at any element size: within
// 16 or more bits its ones form several separate runs, and no smaller element
// repeats to make it.
func TestParseA64TstImmNotBitmaskRejected() testing.TestResult {
	return lineRejected(newA64TextParser(), "tst x0, #0x1234")
}

// A W-register logical immediate whose high 32 bits are zero encodes in the
// 32-bit form: 0xffff0000 is a run of sixteen ones in a 32-bit element.
func TestParseA64OrrWImmMask() testing.TestResult {
	return lineEmitsWord(newA64TextParser(), "orr w0, w1, #0xffff0000", 0x32103C20)
}

// A 32-bit operation's immediate must fit in 32 bits: 0x100000001 is a
// valid 64-bit pattern (a one replicated in each 32-bit half) but not a
// W-register value.
func TestParseA64OrrWImmTooWideRejected() testing.TestResult {
	return lineRejected(newA64TextParser(), "orr w0, w1, #0x100000001")
}
