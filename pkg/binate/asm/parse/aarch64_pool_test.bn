package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Literal pools (`ldr Rt, =expr`, `.ltorg` / `.pool`) against clang's words and
// relocations (`clang -c -target aarch64-linux-gnu`): the MOVZ a one-chunk number becomes,
// the pool's entries — sized by the register, aligned to their size, shared by value or
// plain name, in order of first use — at `.ltorg` / `.pool` and each section's end.
// (labelsSource / labelsWordsHex / labelsReject are in aarch64_golden_labels_test.bn,
// plContains in parse_line_test.bn, x64Source in x64_target_test.bn.)

// poolCase checks that src assembles for ELF to exactly the words want, with nRelocs
// relocations.
func poolCase(e @[]char, src *[]readonly char, want *[]readonly char, nRelocs int) @[]char {
	return poolCaseIn(e, src, asm.OBJ_ELF, want, nRelocs)
}

// poolCaseIn is poolCase for an object of format.
func poolCaseIn(e @[]char, src *[]readonly char, format int, want *[]readonly char,
		nRelocs int) @[]char {
	var p @Parser = labelsSource(src, format)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	if p.Asm.NumRelocs != nRelocs { return goldenFail(e, src, "wrong number of relocations") }
	return e
}

// poolReloc checks that src's relocation i is at offset, of fixup kind, against the
// symbol diagnostics call sym, with addend.
func poolReloc(e @[]char, src *[]readonly char, i int, offset uint, kind int, sym *[]readonly char,
		addend int) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError || p.Asm.HasError || i >= p.Asm.NumRelocs {
		return goldenFail(e, src, "no such relocation")
	}
	var r asm.Relocation = p.Asm.Relocs[i]
	var name @[]char = asm.LabelForMessage(p.Asm.Symbols[r.Symbol].Name)
	if r.Offset != offset || r.Kind != kind || !charsEqual(name, sym) || r.Addend != addend {
		return goldenFail(e, src, buf.Concat("wrong relocation, against ", name))
	}
	return e
}

// poolSrc1 is clang's MOVZ forms, the sizes, sharing and a pool at the section's end.
var poolSrc1 *[]readonly char = ".global ext\nf:\nldr x0, =0x1234\nldr x0, =0x12340000\n"
		"ldr x0, =0x123400000000\n"
		"ldr x0, =0x8000000000000000\nldr w0, =0x12340000\nldr x0, =0\nldr x0, =-1\nldr w0, =-1\n"
		"ldr x0, =0x12345678\nldr w1, =0x12345678\nldr x2, =0x12345678\nldr x3, =f\nldr x4, =f+4\n"
		"ldr x5, =ext\nldr w6, =ext\nldr x7, =0x12345678\nnop"

// One-chunk numbers are MOVZ (any shift a register allows, 0 included); -1 is no MOVN but
// an entry, X 8 bytes and W 4 (one each, though the bytes agree), a W entry followed by
// zero padding to the next X entry's alignment; 0x12345678 shared by the X loads, apart
// from the W one; a symbol an absolute word (8 bytes, or FIX_ABS32 for W).
func TestPoolForms() testing.TestResult {
	var e @[]char = ""
	e = poolCase(e, poolSrc1,
			"D2824680 D2A24680 D2C24680 D2F00000 52A24680 D2800000 58000180 180001A0 580001C0 180001E1 "
					"58000182 580001E3 58000204 58000225 18000246 580000E7 D503201F 00000000 FFFFFFFF FFFFFFFF "
					"FFFFFFFF 00000000 12345678 00000000 12345678 00000000 00000000 00000000 00000000 00000000 "
					"00000000 00000000 00000000 ",
			4)
	e = poolReloc(e, poolSrc1, 0, 0x68, 0, "f", 0)
	e = poolReloc(e, poolSrc1, 1, 0x70, 0, "f", 4)
	e = poolReloc(e, poolSrc1, 2, 0x78, 0, "ext", 0)
	e = poolReloc(e, poolSrc1, 3, 0x80, 114, "ext", 0)
	return e
}

// poolSrc2 is clang's `.ltorg` / `.pool` placement and its operand kinds.
var poolSrc2 *[]readonly char = "f:\nldr w0, =0x11111111\nldr w1, =0x22222222\n"
		"ldr x2, =0x3333333333\n"
		".ltorg\nldr w3, =0x11111111\n.pool\nN = 0x55555555\nldr x4, =N\n1: ldr x5, =1b\nldr x6, =.\n"
		"A = f + 8\nldr x7, =A\nnop"

// `.ltorg` emits the pending entries there, each aligned to its size; a later load shares
// an emitted entry behind it (w3), so the `.pool` after it has nothing to emit; a
// constant's name is its number, `1b` and `.` symbols (the load's own address), an alias
// its target.
func TestPoolDirectives() testing.TestResult {
	var e @[]char = ""
	e = poolCase(e, poolSrc2,
			"18000060 18000061 58000082 11111111 22222222 00000000 33333333 00000033 18FFFF63 580000A4 "
					"580000C5 580000E6 58000107 D503201F 55555555 00000000 00000000 00000000 00000000 00000000 "
					"00000000 00000000 ",
			3)
	e = poolReloc(e, poolSrc2, 0, 0x40, 0, "local label 1 (definition 1)", 0)
	e = poolReloc(e, poolSrc2, 1, 0x48, 0, "location . (definition 0)", 0)
	e = poolReloc(e, poolSrc2, 2, 0x50, 0, "f", 8)
	return e
}

// poolSrc3 is clang's sharing of symbols and its W ranges.
var poolSrc3 *[]readonly char =
	".global ext\nf:\nldr x0, =f\nldr x1, =f\nldr x2, =f+4\nldr x3, =f+4\n"
			"ldr x4, =ext\n"
			"ldr x5, =ext\nldr w6, =-65536\nldr w7, =0xffff0000\nldr w8, =-0x80000000\nldr x9, =-65536"

// A plain name shares its entry, a symbol with arithmetic does not; a W value is read as
// written — -65536 is no one-chunk number (an entry of its low 32 bits) where 0xffff0000
// is — and may be as low as -2^31.
func TestPoolSharing() testing.TestResult {
	var e @[]char = ""
	e = poolCase(e, poolSrc3,
			"58000140 58000121 58000142 58000163 58000184 58000165 18000186 52BFFFE7 18000168 58000169 "
					"00000000 00000000 00000000 00000000 00000000 00000000 00000000 00000000 FFFF0000 80000000 "
					"FFFF0000 FFFFFFFF ",
			4)
	return e
}

// sectionWordsHex returns the words of p's section si as uppercase hex (labelsWordsHex for
// any section).
func sectionWordsHex(p @Parser, si int) @[]char {
	var s @[]char = ""
	var sec @asm.Section = p.Asm.Sections[si]
	var digits *[]readonly char = "0123456789ABCDEF"
	for off := 0; off + 4 <= sec.Len; off = off + 4 {
		var w uint32 = readInst(sec, off)
		var word @[]char = make_slice(char, 9)
		for k := 0; k < 8; k++ { word[k] = digits[cast(int, (w >> cast(uint32, 28 - 4 * k)) & 15)] }
		word[8] = ' '
		s = buf.Concat(s, word)
	}
	return s
}

// Each section's pending entries go at its own end, in the order of first use; a label at
// `.ltorg` names the pool's start, before its alignment padding; the pool after a
// misaligned `.uint8` is aligned with zeros.
func TestPoolSections() testing.TestResult {
	var src *[]readonly char = "ldr x0, =0x1111111111\n.section rodata\nldr x1, =0x2222222222\n"
			".section text\nnop\nnop\nldr w2, =0x33333333\n.uint8 1\nP: .ltorg"
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	var t @[]char = sectionWordsHex(p, 0)
	if !charsEqual(t,
			"580000C0 D503201F D503201F 180000A2 00000001 00000000 11111111 00000011 33333333 ") {
		return fail(buf.Concat("text assembled to ", t))
	}
	var r @[]char = sectionWordsHex(p, 1)
	if !charsEqual(r, "58000041 00000000 22222222 00000022 ") {
		return fail(buf.Concat("rodata assembled to ", r))
	}
	var pi int = p.Asm.LookupSymbol("P")
	if pi < 0 || p.Asm.Symbols[pi].Offset != 17 { return fail("P not at the pool's unaligned start") }
	return ""
}

// An emitted entry is shared while a load reaches it (1 MB back, exactly 1 MB included);
// past that, a load gets a new entry.
func TestPoolReach() testing.TestResult {
	var e @[]char = ""
	// The entry at 8, the second load at 16 + n: 1 MB - 8 back (shared), or 1 MB + 8 (not).
	var near *[]readonly char = "ldr x0, =0x123456789\n.ltorg\n.zero 1048560\nldr x1, =0x123456789"
	var p @Parser = labelsSource(near, asm.OBJ_ELF)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	if readInst(p.Asm.Sections[0], 16 + 1048560) != 0x58800041 {
		e = goldenFail(e, "1 MB - 8 back", "not shared")
	}
	var edge *[]readonly char = "ldr x0, =0x123456789\n.ltorg\n.zero 1048568\nldr x1, =0x123456789"
	var r @Parser = labelsSource(edge, asm.OBJ_ELF)
	if r.HasError || r.Asm.HasError { return fail(buf.Concat("rejected: ", r.ErrorMsg)) }
	if readInst(r.Asm.Sections[0], 16 + 1048568) != 0x58800001 {
		e = goldenFail(e, "1 MB back", "not shared")
	}
	var far *[]readonly char = "ldr x0, =0x123456789\n.ltorg\n.zero 1048576\nldr x1, =0x123456789"
	var q @Parser = labelsSource(far, asm.OBJ_ELF)
	if q.HasError || q.Asm.HasError { return fail(buf.Concat("rejected: ", q.ErrorMsg)) }
	if readInst(q.Asm.Sections[0], 16 + 1048576) != 0x58000041 {
		e = goldenFail(e, "1 MB + 8 back", "shared")
	}
	return e
}

// poolReject checks that src is rejected with a diagnostic containing want.
func poolReject(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if !p.HasError { return goldenFail(e, src, "accepted") }
	if !plContains(p.ErrorMsg, want) {
		return goldenFail(e, src, buf.Concat("wrong diagnostic: ", p.ErrorMsg))
	}
	return e
}

// Rejected, as clang rejects them: a pool load other than LDR of a W or X register
// (LDRSW, a store, LDUR, SP, and — deliberately, where clang takes S by accident and
// fails D — an FP / SIMD register), a W value outside [-2^31, 2^32), a shift; and a name a
// pending entry holds cannot then become a constant (a forward reference).
func TestPoolRejects() testing.TestResult {
	var e @[]char = ""
	var form *[]readonly char = "is an LDR of a W or X register"
	e = poolReject(e, "ldrsw x0, =1", form)
	e = poolReject(e, "str x0, =1", form)
	e = poolReject(e, "ldur x0, =1", form)
	e = poolReject(e, "ldr s0, =0x12345678", form)
	e = poolReject(e, "ldr d0, =1", form)
	e = poolReject(e, "ldr q0, =1", form)
	e = labelsReject(e, "ldr sp, =1")
	e = poolReject(e, "ldr w0, =0x100000000", "does not fit a W register")
	e = poolReject(e, "ldr w0, =-0x80000001", "does not fit a W register")
	e = labelsReject(e, "ldr x0, =0x1234, lsl 12")
	e = labelsReject(e, "ldr x0, =")
	e = labelsReject(e, "ldr x0, =1\n.ltorg 4")
	var x @Parser = x64Source(".ltorg")
	if !x.HasError { e = goldenFail(e, ".ltorg", "accepted on x86-64") }
	e = poolReject(e, "ldr x0, =K\nK = 5", "a constant must be defined before use")
	return e
}

// The zero registers take a pool load (clang: `mov xzr, #1`, `ldr wzr, <entry>`), and a
// space may follow the '='.
func TestPoolZeroRegisters() testing.TestResult {
	var e @[]char = ""
	e = poolCase(e, "ldr xzr, =1\nldr wzr, =0x12345678\nldr x0, = 5",
			"D280003F 1800005F D28000A0 12345678 ", 0)
	return e
}

// Sharing stays within a Mach-O atom: on ELF a later function's load shares the entry
// (pending, or emitted by `.ltorg`), as clang does; on Mach-O — and with the object format
// unknown — `_g` starts an atom and its load gets its own entry (without `.ltorg`, `_f`'s
// lands in `_g`'s atom too, so its load stays a relocation the Mach-O writer rejects),
// and with `.ltorg` each function's load stays in its own atom; an `L` temporary starts
// none, and its load shares; an entry belongs to the atom it is emitted in.
func TestPoolAtoms() testing.TestResult {
	var e @[]char = ""
	var two *[]readonly char = "_f: ldr x0, =0x123456789\nret\n_g: ldr x1, =0x123456789\nret"
	e = poolCaseIn(e, two, asm.OBJ_ELF, "58000080 D65F03C0 58000041 D65F03C0 23456789 00000001 ", 0)
	var split *[]readonly char = "58000000 D65F03C0 58000081 D65F03C0 "
			"23456789 00000001 23456789 00000001 "
	e = poolCaseIn(e, two, asm.OBJ_MACHO, split, 1)
	e = poolCaseIn(e, two, asm.OBJ_UNKNOWN, split, 1)
	var each *[]readonly char = "_f: ldr x0, =0x123456789\nret\n.ltorg\n_g: ldr x1, =0x123456789\n"
			"ret\n"
			".ltorg"
	e = poolCaseIn(e, each, asm.OBJ_ELF, "58000040 D65F03C0 23456789 00000001 58FFFFC1 D65F03C0 ", 0)
	e = poolCaseIn(e, each, asm.OBJ_MACHO,
			"58000040 D65F03C0 23456789 00000001 58000041 D65F03C0 23456789 00000001 ", 0)
	e = poolCaseIn(e, "_f: ldr x0, =0x123456789\nLx: ldr x1, =0x123456789", asm.OBJ_MACHO,
			"58000040 58000021 23456789 00000001 ", 0)
	// An entry emitted in `_g`'s atom is `_g`'s: a load after it there shares it.
	e = poolCaseIn(e, "_f: ldr x0, =0x123456789\n_g: .ltorg\nldr x1, =0x123456789", asm.OBJ_MACHO,
			"58000000 00000000 23456789 00000001 58FFFFC1 ", 1)
	return e
}

// A plain name shares by the name: `=(f)` shares `=f`'s entry (as clang's does), an alias
// redefined between loads does not share its earlier value's entry.
func TestPoolNameKeys() testing.TestResult {
	var e @[]char = ""
	e = poolCase(e, "f: ldr x0, =f\nldr x1, =(f)\nldr x2, =((f))",
			"58000080 58000061 58000042 00000000 00000000 00000000 ", 1)
	var redef *[]readonly char = "f: nop\ng: nop\nA = f\nldr x0, =A\nA = g\nldr x1, =A"
	e = poolCase(e, redef, "D503201F D503201F 58000040 58000061 00000000 00000000 00000000 00000000 ",
			2)
	e = poolReloc(e, redef, 0, 0x10, 0, "f", 0)
	e = poolReloc(e, redef, 1, 0x18, 0, "g", 0)
	return e
}
