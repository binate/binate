package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// The ELF relocation operators beyond `:lo12:`, `:got:`, `:got_lo12:` and the MOVW group
// (aarch64_instr_mov_test.bn), against clang's words and relocations (`clang -c -target
// aarch64-linux-gnu`).  (labelsSource / labelsWordsHex / labelsReject are in
// aarch64_golden_labels_test.bn, goldenFail in aarch64_golden_test.bn.)

// relocOps renders p's relocations as `<kind>@<offset>:<symbol as a diagnostic names
// it><addend> `, the addend signed and omitted when 0.
func relocOps(p @Parser) @[]char {
	var out @[]char = ""
	for i := 0; i < p.Asm.NumRelocs; i++ {
		var r asm.Relocation = p.Asm.Relocs[i]
		var one @[]char = buf.Concat(strconv.Itoa(r.Kind), "@")
		one = buf.Concat(one, strconv.Itoa(cast(int, r.Offset)))
		one = buf.Concat(one, ":")
		one = buf.Concat(one, asm.LabelForMessage(p.Asm.Symbols[r.Symbol].Name))
		if r.Addend > 0 { one = buf.Concat(one, "+") }
		if r.Addend != 0 { one = buf.Concat(one, strconv.Itoa(r.Addend)) }
		out = buf.Concat(out, buf.Concat(one, " "))
	}
	return out
}

// relocOpCase checks that src assembles for ELF to exactly the words want and the
// relocations relocs (relocOps).
func relocOpCase(e @[]char, src *[]readonly char, want *[]readonly char,
		relocs *[]readonly char) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	var gotR @[]char = relocOps(p)
	if !charsEqual(gotR, relocs) { return goldenFail(e, src, buf.Concat("relocations ", gotR)) }
	return e
}

// `:pg_hi21_nc:` on ADRP: the page with no overflow check (isa.FIX_ADRP_HI21_NC), with `#`
// or without, any case, an addend, a local symbol, `.` and a numeric label.
func TestRelocOpPageNc() testing.TestResult {
	var e @[]char = ""
	var k @[]char = strconv.Itoa(isa.FIX_ADRP_HI21_NC)
	var want @[]char = buf.Concat(k, "@0:sym ")
	want = buf.Concat(want, buf.Concat(k, "@4:sym+8 "))
	want = buf.Concat(want, buf.Concat(k, "@8:sym-4 "))
	want = buf.Concat(want, buf.Concat(k, "@12:f "))
	want = buf.Concat(want, buf.Concat(k, "@16:location . (definition 0)+8 "))
	want = buf.Concat(want, buf.Concat(k, "@20:local label 1 (definition 1) "))
	e = relocOpCase(e,
			".global sym\nf:\nadrp x0, :pg_hi21_nc:sym\nadrp x1, #:pg_hi21_nc:sym+8\n"
					"adrp x2, :PG_HI21_NC:(sym-4)\nadrp x3, :pg_hi21_nc:f\nadrp x4, :pg_hi21_nc:.+8\n"
					"adrp x5, :pg_hi21_nc:1f\n1: nop",
			"90000000 90000001 90000002 90000003 90000004 90000005 D503201F ", want)
	return e
}

// `:pg_hi21_nc:` elsewhere is rejected, as clang rejects it on ADR and ADD; and
// deliberately, where clang accepts: on a literal load or a branch (clang drops the
// operator, relocating to the plain symbol), and with a number (clang relocates
// `:pg_hi21_nc:5` against an absolute 5).
func TestRelocOpPageNcRejects() testing.TestResult {
	var e @[]char = ""
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 7)
	bad[0] = "adr x0, :pg_hi21_nc:sym"
	bad[1] = "add x0, x0, :pg_hi21_nc:sym"
	bad[2] = "ldr x0, :pg_hi21_nc:sym"
	bad[3] = "b #:pg_hi21_nc:sym"
	bad[4] = "adrp x0, :pg_hi21_nc:5"
	bad[5] = "adrp x0, :pg_hi21_nc:sym@PAGE"
	bad[6] = "ldr x0, [x1, :pg_hi21_nc:sym]"
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global sym\n", bad[i])) }
	return e
}
