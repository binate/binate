package "pkg/binate/asm/parse"

// Name tables for the AArch64 system instructions: hint names, barrier options,
// system registers, PSTATE fields, and the DC / IC cache operations.  Every value is
// the architecture's encoding; a name not listed is rejected (a system register can
// always be written generically as `s<op0>_<op1>_c<n>_c<m>_<op2>`).

// hintValue returns the HINT immediate of a named hint (nop, yield, wfe, wfi, sev,
// sevl, dgh, esb, csdb, and the pointer-authentication hints), or -1.
func hintValue(name *[]readonly char) int {
	if nameIs(name, "nop") { return 0 }
	if nameIs(name, "yield") { return 1 }
	if nameIs(name, "wfe") { return 2 }
	if nameIs(name, "wfi") { return 3 }
	if nameIs(name, "sev") { return 4 }
	if nameIs(name, "sevl") { return 5 }
	if nameIs(name, "dgh") { return 6 }
	if nameIs(name, "xpaclri") { return 7 }
	if nameIs(name, "pacia1716") { return 8 }
	if nameIs(name, "pacib1716") { return 10 }
	if nameIs(name, "autia1716") { return 12 }
	if nameIs(name, "autib1716") { return 14 }
	if nameIs(name, "esb") { return 16 }
	if nameIs(name, "csdb") { return 20 }
	if nameIs(name, "paciaz") { return 24 }
	if nameIs(name, "paciasp") { return 25 }
	if nameIs(name, "pacibz") { return 26 }
	if nameIs(name, "pacibsp") { return 27 }
	if nameIs(name, "autiaz") { return 28 }
	if nameIs(name, "autiasp") { return 29 }
	if nameIs(name, "autibz") { return 30 }
	if nameIs(name, "autibsp") { return 31 }
	return -1
}

// barrierOption returns the 4-bit CRm value of a DSB / DMB option name, or -1.
func barrierOption(name *[]readonly char) int {
	if nameIs(name, "oshld") { return 1 }
	if nameIs(name, "oshst") { return 2 }
	if nameIs(name, "osh") { return 3 }
	if nameIs(name, "nshld") { return 5 }
	if nameIs(name, "nshst") { return 6 }
	if nameIs(name, "nsh") { return 7 }
	if nameIs(name, "ishld") { return 9 }
	if nameIs(name, "ishst") { return 10 }
	if nameIs(name, "ish") { return 11 }
	if nameIs(name, "ld") { return 13 }
	if nameIs(name, "st") { return 14 }
	if nameIs(name, "sy") { return 15 }
	return -1
}

// sysRegEncoding packs a system register's op0, op1, CRn, CRm, op2 into one int
// (op0<<14 | op1<<11 | CRn<<7 | CRm<<3 | op2), the key sysRegFields unpacks.
func sysRegEncoding(op0 int, op1 int, crn int, crm int, op2 int) int {
	return op0 * 16384 + op1 * 2048 + crn * 128 + crm * 8 + op2
}

// sysRegFields unpacks a sysRegEncoding value into op0, op1, CRn, CRm, op2.
func sysRegFields(enc int) (int, int, int, int, int) {
	return enc / 16384, (enc / 2048) % 8, (enc / 128) % 16, (enc / 8) % 16, enc % 8
}

// sysRegByName returns the packed encoding (sysRegEncoding) of a named system
// register, or -1: the generic `s<op0>_<op1>_c<n>_c<m>_<op2>` form (op0 2 or 3), or
// one of the listed EL0 / EL1 / EL2 / EL3 registers.  (op0 1 in the generic form is
// the SYS space: `mrs` / `msr` of it encode SYSL / SYS, as clang does.)
func sysRegByName(name *[]readonly char) int {
	var g int = genericSysReg(name)
	if g >= 0 { return g }
	if nameIs(name, "nzcv") { return sysRegEncoding(3, 3, 4, 2, 0) }
	if nameIs(name, "daif") { return sysRegEncoding(3, 3, 4, 2, 1) }
	if nameIs(name, "fpcr") { return sysRegEncoding(3, 3, 4, 4, 0) }
	if nameIs(name, "fpsr") { return sysRegEncoding(3, 3, 4, 4, 1) }
	if nameIs(name, "dit") { return sysRegEncoding(3, 3, 4, 2, 5) }
	if nameIs(name, "ssbs") { return sysRegEncoding(3, 3, 4, 2, 6) }
	if nameIs(name, "tco") { return sysRegEncoding(3, 3, 4, 2, 7) }
	if nameIs(name, "tpidr_el0") { return sysRegEncoding(3, 3, 13, 0, 2) }
	if nameIs(name, "tpidrro_el0") { return sysRegEncoding(3, 3, 13, 0, 3) }
	if nameIs(name, "ctr_el0") { return sysRegEncoding(3, 3, 0, 0, 1) }
	if nameIs(name, "dczid_el0") { return sysRegEncoding(3, 3, 0, 0, 7) }
	if nameIs(name, "rndr") { return sysRegEncoding(3, 3, 2, 4, 0) }
	if nameIs(name, "rndrrs") { return sysRegEncoding(3, 3, 2, 4, 1) }
	if nameIs(name, "cntfrq_el0") { return sysRegEncoding(3, 3, 14, 0, 0) }
	if nameIs(name, "cntpct_el0") { return sysRegEncoding(3, 3, 14, 0, 1) }
	if nameIs(name, "cntvct_el0") { return sysRegEncoding(3, 3, 14, 0, 2) }
	if nameIs(name, "cntp_tval_el0") { return sysRegEncoding(3, 3, 14, 2, 0) }
	if nameIs(name, "cntp_ctl_el0") { return sysRegEncoding(3, 3, 14, 2, 1) }
	if nameIs(name, "cntp_cval_el0") { return sysRegEncoding(3, 3, 14, 2, 2) }
	if nameIs(name, "cntv_tval_el0") { return sysRegEncoding(3, 3, 14, 3, 0) }
	if nameIs(name, "cntv_ctl_el0") { return sysRegEncoding(3, 3, 14, 3, 1) }
	if nameIs(name, "cntv_cval_el0") { return sysRegEncoding(3, 3, 14, 3, 2) }
	return sysRegByNameEL1(name)
}

// sysRegByNameEL1 continues sysRegByName with the EL1 and higher registers.
func sysRegByNameEL1(name *[]readonly char) int {
	if nameIs(name, "currentel") { return sysRegEncoding(3, 0, 4, 2, 2) }
	if nameIs(name, "spsel") { return sysRegEncoding(3, 0, 4, 2, 0) }
	if nameIs(name, "pan") { return sysRegEncoding(3, 0, 4, 2, 3) }
	if nameIs(name, "uao") { return sysRegEncoding(3, 0, 4, 2, 4) }
	if nameIs(name, "sp_el0") { return sysRegEncoding(3, 0, 4, 1, 0) }
	if nameIs(name, "sp_el1") { return sysRegEncoding(3, 4, 4, 1, 0) }
	if nameIs(name, "sp_el2") { return sysRegEncoding(3, 6, 4, 1, 0) }
	if nameIs(name, "spsr_el1") { return sysRegEncoding(3, 0, 4, 0, 0) }
	if nameIs(name, "elr_el1") { return sysRegEncoding(3, 0, 4, 0, 1) }
	if nameIs(name, "midr_el1") { return sysRegEncoding(3, 0, 0, 0, 0) }
	if nameIs(name, "mpidr_el1") { return sysRegEncoding(3, 0, 0, 0, 5) }
	if nameIs(name, "revidr_el1") { return sysRegEncoding(3, 0, 0, 0, 6) }
	if nameIs(name, "id_aa64pfr0_el1") { return sysRegEncoding(3, 0, 0, 4, 0) }
	if nameIs(name, "id_aa64pfr1_el1") { return sysRegEncoding(3, 0, 0, 4, 1) }
	if nameIs(name, "id_aa64dfr0_el1") { return sysRegEncoding(3, 0, 0, 5, 0) }
	if nameIs(name, "id_aa64isar0_el1") { return sysRegEncoding(3, 0, 0, 6, 0) }
	if nameIs(name, "id_aa64isar1_el1") { return sysRegEncoding(3, 0, 0, 6, 1) }
	if nameIs(name, "id_aa64mmfr0_el1") { return sysRegEncoding(3, 0, 0, 7, 0) }
	if nameIs(name, "id_aa64mmfr1_el1") { return sysRegEncoding(3, 0, 0, 7, 1) }
	if nameIs(name, "sctlr_el1") { return sysRegEncoding(3, 0, 1, 0, 0) }
	if nameIs(name, "actlr_el1") { return sysRegEncoding(3, 0, 1, 0, 1) }
	if nameIs(name, "cpacr_el1") { return sysRegEncoding(3, 0, 1, 0, 2) }
	if nameIs(name, "ttbr0_el1") { return sysRegEncoding(3, 0, 2, 0, 0) }
	if nameIs(name, "ttbr1_el1") { return sysRegEncoding(3, 0, 2, 0, 1) }
	if nameIs(name, "tcr_el1") { return sysRegEncoding(3, 0, 2, 0, 2) }
	if nameIs(name, "esr_el1") { return sysRegEncoding(3, 0, 5, 2, 0) }
	if nameIs(name, "far_el1") { return sysRegEncoding(3, 0, 6, 0, 0) }
	if nameIs(name, "par_el1") { return sysRegEncoding(3, 0, 7, 4, 0) }
	if nameIs(name, "mair_el1") { return sysRegEncoding(3, 0, 10, 2, 0) }
	if nameIs(name, "amair_el1") { return sysRegEncoding(3, 0, 10, 3, 0) }
	if nameIs(name, "vbar_el1") { return sysRegEncoding(3, 0, 12, 0, 0) }
	if nameIs(name, "isr_el1") { return sysRegEncoding(3, 0, 12, 1, 0) }
	if nameIs(name, "contextidr_el1") { return sysRegEncoding(3, 0, 13, 0, 1) }
	if nameIs(name, "tpidr_el1") { return sysRegEncoding(3, 0, 13, 0, 4) }
	if nameIs(name, "cntkctl_el1") { return sysRegEncoding(3, 0, 14, 1, 0) }
	if nameIs(name, "sctlr_el2") { return sysRegEncoding(3, 4, 1, 0, 0) }
	if nameIs(name, "hcr_el2") { return sysRegEncoding(3, 4, 1, 1, 0) }
	if nameIs(name, "spsr_el2") { return sysRegEncoding(3, 4, 4, 0, 0) }
	if nameIs(name, "elr_el2") { return sysRegEncoding(3, 4, 4, 0, 1) }
	if nameIs(name, "esr_el2") { return sysRegEncoding(3, 4, 5, 2, 0) }
	if nameIs(name, "far_el2") { return sysRegEncoding(3, 4, 6, 0, 0) }
	if nameIs(name, "vbar_el2") { return sysRegEncoding(3, 4, 12, 0, 0) }
	if nameIs(name, "sctlr_el3") { return sysRegEncoding(3, 6, 1, 0, 0) }
	if nameIs(name, "scr_el3") { return sysRegEncoding(3, 6, 1, 1, 0) }
	if nameIs(name, "spsr_el3") { return sysRegEncoding(3, 6, 4, 0, 0) }
	if nameIs(name, "elr_el3") { return sysRegEncoding(3, 6, 4, 0, 1) }
	if nameIs(name, "esr_el3") { return sysRegEncoding(3, 6, 5, 2, 0) }
	if nameIs(name, "vbar_el3") { return sysRegEncoding(3, 6, 12, 0, 0) }
	return -1
}

// genericSysReg parses `s<op0>_<op1>_c<n>_c<m>_<op2>` (op0 1-3 — op0 1 being the
// SYS / SYSL space — op1 0-7, CRn / CRm 0-15, op2 0-7), returning its packed
// encoding or -1.
func genericSysReg(name *[]readonly char) int {
	var i int = 0
	var fields [5]int
	for f := 0; f < 5; f++ {
		// Each field is introduced by its letter ('s' for op0, 'c' for CRn / CRm) or,
		// for op1 / op2, only by the preceding '_'.
		if f > 0 {
			if i >= len(name) || name[i] != '_' { return -1 }
			i = i + 1
		}
		if f == 0 || f == 2 || f == 3 {
			var want char = 'c'
			if f == 0 { want = 's' }
			if i >= len(name) || lowerChar(name[i]) != want { return -1 }
			i = i + 1
		}
		var start int = i
		var v int = 0
		for i < len(name) && name[i] >= '0' && name[i] <= '9' {
			v = v * 10 + cast(int, name[i]) - cast(int, '0')
			i = i + 1
		}
		// One or two digits, no leading zero (as clang requires).
		if i == start || i - start > 2 || (i - start == 2 && name[start] == '0') { return -1 }
		fields[f] = v
	}
	if i != len(name) { return -1 }
	if fields[0] < 1 || fields[0] > 3 || fields[1] > 7 || fields[2] > 15 || fields[3] > 15 ||
			fields[4] > 7 {
		return -1
	}
	return sysRegEncoding(fields[0], fields[1], fields[2], fields[3], fields[4])
}

// pstateField returns the MSR (immediate) op1*8+op2 selector of a PSTATE field name,
// or -1: spsel, daifset, daifclr, uao, pan, dit, ssbs, tco.
func pstateField(name *[]readonly char) int {
	if nameIs(name, "spsel") { return 0 * 8 + 5 }
	if nameIs(name, "daifset") { return 3 * 8 + 6 }
	if nameIs(name, "daifclr") { return 3 * 8 + 7 }
	if nameIs(name, "uao") { return 0 * 8 + 3 }
	if nameIs(name, "pan") { return 0 * 8 + 4 }
	if nameIs(name, "dit") { return 3 * 8 + 2 }
	if nameIs(name, "ssbs") { return 3 * 8 + 1 }
	if nameIs(name, "tco") { return 3 * 8 + 4 }
	return -1
}

// dcOperation returns the SYS fields of a DC operation name packed as op1*1024 +
// CRm*64 + op2*8 + needsReg (CRn is always 7; every DC operation takes Xt), or -1.
func dcOperation(name *[]readonly char) int {
	if nameIs(name, "zva") { return 3 * 1024 + 4 * 64 + 1 * 8 + 1 }
	if nameIs(name, "civac") { return 3 * 1024 + 14 * 64 + 1 * 8 + 1 }
	if nameIs(name, "cvac") { return 3 * 1024 + 10 * 64 + 1 * 8 + 1 }
	if nameIs(name, "cvau") { return 3 * 1024 + 11 * 64 + 1 * 8 + 1 }
	if nameIs(name, "cvap") { return 3 * 1024 + 12 * 64 + 1 * 8 + 1 }
	if nameIs(name, "cvadp") { return 3 * 1024 + 13 * 64 + 1 * 8 + 1 }
	if nameIs(name, "ivac") { return 0 * 1024 + 6 * 64 + 1 * 8 + 1 }
	if nameIs(name, "isw") { return 0 * 1024 + 6 * 64 + 2 * 8 + 1 }
	if nameIs(name, "csw") { return 0 * 1024 + 10 * 64 + 2 * 8 + 1 }
	if nameIs(name, "cisw") { return 0 * 1024 + 14 * 64 + 2 * 8 + 1 }
	return -1
}

// icOperation returns the SYS fields of an IC operation name, packed as dcOperation
// does (needsReg is 1 only for IVAU), or -1.
func icOperation(name *[]readonly char) int {
	if nameIs(name, "ialluis") { return 0 * 1024 + 1 * 64 + 0 * 8 + 0 }
	if nameIs(name, "iallu") { return 0 * 1024 + 5 * 64 + 0 * 8 + 0 }
	if nameIs(name, "ivau") { return 3 * 1024 + 5 * 64 + 1 * 8 + 1 }
	return -1
}

// sysRegReadOnly reports whether a named system register is read-only (an `msr` to
// it has no meaning): the identification registers, CurrentEL, the counters, the
// random-number registers and ISR_EL1.
func sysRegReadOnly(name *[]readonly char) bool {
	if len(name) > 3 && nameIs(name[0:3], "id_") { return true }
	return nameIs(name, "currentel") || nameIs(name, "midr_el1") || nameIs(name, "mpidr_el1") ||
			nameIs(name, "revidr_el1") || nameIs(name, "ctr_el0") || nameIs(name, "dczid_el0") ||
			nameIs(name, "cntpct_el0") || nameIs(name, "cntvct_el0") || nameIs(name, "rndr") ||
			nameIs(name, "rndrrs") || nameIs(name, "isr_el1")
}
