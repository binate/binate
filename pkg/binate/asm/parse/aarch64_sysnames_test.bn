package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the AArch64 system-instruction name tables in aarch64_sysnames.bn: hint
// immediates, barrier options, system registers (named and the generic
// `s<op0>_<op1>_c<n>_c<m>_<op2>` form), PSTATE fields, and the read-only register set.
// Every expected value is decoded from clang's encoding of the name (`clang -c -target
// arm64-apple-macos11`): `hint` / `dmb` / `dsb` / `msr #imm` / `mrs` words, and the set of
// registers clang refuses to `msr`.

// sysNameCase checks that got, a name-table function's value for name, is want,
// appending a failure about name to e.
func sysNameCase(e @[]char, name *[]readonly char, got int, want int) @[]char {
	if got != want { return goldenFail(e, name, "wrong table value") }
	return e
}

// sysRegCase checks that sysRegByName(name) is the register (op0, op1, CRn, CRm, op2),
// both packed and as unpacked by sysRegFields.
func sysRegCase(e @[]char, name *[]readonly char, op0 int, op1 int, crn int, crm int,
		op2 int) @[]char {
	var enc int = sysRegByName(name)
	if enc < 0 { return goldenFail(e, name, "not recognized as a system register") }
	if enc != sysRegEncoding(op0, op1, crn, crm, op2) { return goldenFail(e, name, "wrong encoding") }
	g0, g1, gn, gm, g2 := sysRegFields(enc)
	if g0 != op0 || g1 != op1 || gn != crn || gm != crm || g2 != op2 {
		return goldenFail(e, name, "sysRegFields does not invert sysRegEncoding")
	}
	return e
}

// sysRegRejectCase checks that sysRegByName(name) rejects name.
func sysRegRejectCase(e @[]char, name *[]readonly char) @[]char {
	if sysRegByName(name) != -1 { return goldenFail(e, name, "accepted as a system register") }
	return e
}

// sysReadOnlyCase checks that sysRegReadOnly(name) is want.
func sysReadOnlyCase(e @[]char, name *[]readonly char, want bool) @[]char {
	if sysRegReadOnly(name) != want { return goldenFail(e, name, "wrong read-only flag") }
	return e
}

// Every named hint has clang's HINT immediate (bits 11:5 of its word), any case; other
// names are -1.
func TestA64HintValue() testing.TestResult {
	var e @[]char = ""
	e = sysNameCase(e, "nop", hintValue("nop"), 0)
	e = sysNameCase(e, "yield", hintValue("yield"), 1)
	e = sysNameCase(e, "wfe", hintValue("wfe"), 2)
	e = sysNameCase(e, "wfi", hintValue("wfi"), 3)
	e = sysNameCase(e, "sev", hintValue("sev"), 4)
	e = sysNameCase(e, "sevl", hintValue("sevl"), 5)
	e = sysNameCase(e, "dgh", hintValue("dgh"), 6)
	e = sysNameCase(e, "xpaclri", hintValue("xpaclri"), 7)
	e = sysNameCase(e, "pacia1716", hintValue("pacia1716"), 8)
	e = sysNameCase(e, "pacib1716", hintValue("pacib1716"), 10)
	e = sysNameCase(e, "autia1716", hintValue("autia1716"), 12)
	e = sysNameCase(e, "autib1716", hintValue("autib1716"), 14)
	e = sysNameCase(e, "esb", hintValue("esb"), 16)
	e = sysNameCase(e, "csdb", hintValue("csdb"), 20)
	e = sysNameCase(e, "clrbhb", hintValue("clrbhb"), 22)
	e = sysNameCase(e, "paciaz", hintValue("paciaz"), 24)
	e = sysNameCase(e, "paciasp", hintValue("paciasp"), 25)
	e = sysNameCase(e, "pacibz", hintValue("pacibz"), 26)
	e = sysNameCase(e, "pacibsp", hintValue("pacibsp"), 27)
	e = sysNameCase(e, "autiaz", hintValue("autiaz"), 28)
	e = sysNameCase(e, "autiasp", hintValue("autiasp"), 29)
	e = sysNameCase(e, "autibz", hintValue("autibz"), 30)
	e = sysNameCase(e, "autibsp", hintValue("autibsp"), 31)
	e = sysNameCase(e, "pacm", hintValue("pacm"), 39)
	e = sysNameCase(e, "NOP", hintValue("NOP"), 0)
	e = sysNameCase(e, "PacIASP", hintValue("PacIASP"), 25)
	e = sysNameCase(e, "hint", hintValue("hint"), -1)
	e = sysNameCase(e, "nopp", hintValue("nopp"), -1)
	e = sysNameCase(e, "", hintValue(""), -1)
	return e
}

// Every DSB / DMB option has clang's CRm (bits 11:8 of `dmb <opt>`), any case; other
// names (including the unallocated option values' would-be names) are -1.
func TestA64BarrierOption() testing.TestResult {
	var e @[]char = ""
	e = sysNameCase(e, "oshld", barrierOption("oshld"), 1)
	e = sysNameCase(e, "oshst", barrierOption("oshst"), 2)
	e = sysNameCase(e, "osh", barrierOption("osh"), 3)
	e = sysNameCase(e, "nshld", barrierOption("nshld"), 5)
	e = sysNameCase(e, "nshst", barrierOption("nshst"), 6)
	e = sysNameCase(e, "nsh", barrierOption("nsh"), 7)
	e = sysNameCase(e, "ishld", barrierOption("ishld"), 9)
	e = sysNameCase(e, "ishst", barrierOption("ishst"), 10)
	e = sysNameCase(e, "ish", barrierOption("ish"), 11)
	e = sysNameCase(e, "ld", barrierOption("ld"), 13)
	e = sysNameCase(e, "st", barrierOption("st"), 14)
	e = sysNameCase(e, "sy", barrierOption("sy"), 15)
	e = sysNameCase(e, "csync", barrierOption("csync"), 0)
	e = sysNameCase(e, "synxs", barrierOption("synxs"), -1)
	e = sysNameCase(e, "ISH", barrierOption("ISH"), 11)
	e = sysNameCase(e, "Sy", barrierOption("Sy"), 15)
	e = sysNameCase(e, "syy", barrierOption("syy"), -1)
	e = sysNameCase(e, "ishh", barrierOption("ishh"), -1)
	e = sysNameCase(e, "", barrierOption(""), -1)
	return e
}

// Every DSB nXS option has clang's immediate (`dsb <option>nxs` is `dsb #imm`), any case;
// the plain options and other names are -1.
func TestA64DsbNxsOption() testing.TestResult {
	var e @[]char = ""
	e = sysNameCase(e, "oshnxs", dsbNxsOption("oshnxs"), 16)
	e = sysNameCase(e, "nshnxs", dsbNxsOption("nshnxs"), 20)
	e = sysNameCase(e, "ishnxs", dsbNxsOption("ishnxs"), 24)
	e = sysNameCase(e, "synxs", dsbNxsOption("synxs"), 28)
	e = sysNameCase(e, "SYnXS", dsbNxsOption("SYnXS"), 28)
	e = sysNameCase(e, "sy", dsbNxsOption("sy"), -1)
	e = sysNameCase(e, "ldnxs", dsbNxsOption("ldnxs"), -1)
	e = sysNameCase(e, "nxs", dsbNxsOption("nxs"), -1)
	return e
}

// The EL0-accessible named system registers have clang's (op0, op1, CRn, CRm, op2),
// decoded from `mrs x0, <name>`.
func TestA64SysRegEL0() testing.TestResult {
	var e @[]char = ""
	e = sysRegCase(e, "nzcv", 3, 3, 4, 2, 0)
	e = sysRegCase(e, "daif", 3, 3, 4, 2, 1)
	e = sysRegCase(e, "fpcr", 3, 3, 4, 4, 0)
	e = sysRegCase(e, "fpsr", 3, 3, 4, 4, 1)
	e = sysRegCase(e, "dit", 3, 3, 4, 2, 5)
	e = sysRegCase(e, "ssbs", 3, 3, 4, 2, 6)
	e = sysRegCase(e, "tco", 3, 3, 4, 2, 7)
	e = sysRegCase(e, "tpidr_el0", 3, 3, 13, 0, 2)
	e = sysRegCase(e, "tpidrro_el0", 3, 3, 13, 0, 3)
	e = sysRegCase(e, "ctr_el0", 3, 3, 0, 0, 1)
	e = sysRegCase(e, "dczid_el0", 3, 3, 0, 0, 7)
	e = sysRegCase(e, "rndr", 3, 3, 2, 4, 0)
	e = sysRegCase(e, "rndrrs", 3, 3, 2, 4, 1)
	e = sysRegCase(e, "cntfrq_el0", 3, 3, 14, 0, 0)
	e = sysRegCase(e, "cntpct_el0", 3, 3, 14, 0, 1)
	e = sysRegCase(e, "cntvct_el0", 3, 3, 14, 0, 2)
	e = sysRegCase(e, "cntp_tval_el0", 3, 3, 14, 2, 0)
	e = sysRegCase(e, "cntp_ctl_el0", 3, 3, 14, 2, 1)
	e = sysRegCase(e, "cntp_cval_el0", 3, 3, 14, 2, 2)
	e = sysRegCase(e, "cntv_tval_el0", 3, 3, 14, 3, 0)
	e = sysRegCase(e, "cntv_ctl_el0", 3, 3, 14, 3, 1)
	e = sysRegCase(e, "cntv_cval_el0", 3, 3, 14, 3, 2)
	e = sysRegCase(e, "NZCV", 3, 3, 4, 2, 0)
	e = sysRegCase(e, "TPIDR_El0", 3, 3, 13, 0, 2)
	return e
}

// The EL1 named system registers have clang's (op0, op1, CRn, CRm, op2).
func TestA64SysRegEL1() testing.TestResult {
	var e @[]char = ""
	e = sysRegCase(e, "currentel", 3, 0, 4, 2, 2)
	e = sysRegCase(e, "spsel", 3, 0, 4, 2, 0)
	e = sysRegCase(e, "pan", 3, 0, 4, 2, 3)
	e = sysRegCase(e, "uao", 3, 0, 4, 2, 4)
	e = sysRegCase(e, "sp_el0", 3, 0, 4, 1, 0)
	e = sysRegCase(e, "spsr_el1", 3, 0, 4, 0, 0)
	e = sysRegCase(e, "elr_el1", 3, 0, 4, 0, 1)
	e = sysRegCase(e, "midr_el1", 3, 0, 0, 0, 0)
	e = sysRegCase(e, "mpidr_el1", 3, 0, 0, 0, 5)
	e = sysRegCase(e, "revidr_el1", 3, 0, 0, 0, 6)
	e = sysRegCase(e, "id_aa64pfr0_el1", 3, 0, 0, 4, 0)
	e = sysRegCase(e, "id_aa64pfr1_el1", 3, 0, 0, 4, 1)
	e = sysRegCase(e, "id_aa64dfr0_el1", 3, 0, 0, 5, 0)
	e = sysRegCase(e, "id_aa64isar0_el1", 3, 0, 0, 6, 0)
	e = sysRegCase(e, "id_aa64isar1_el1", 3, 0, 0, 6, 1)
	e = sysRegCase(e, "id_aa64mmfr0_el1", 3, 0, 0, 7, 0)
	e = sysRegCase(e, "id_aa64mmfr1_el1", 3, 0, 0, 7, 1)
	e = sysRegCase(e, "sctlr_el1", 3, 0, 1, 0, 0)
	e = sysRegCase(e, "actlr_el1", 3, 0, 1, 0, 1)
	e = sysRegCase(e, "cpacr_el1", 3, 0, 1, 0, 2)
	e = sysRegCase(e, "ttbr0_el1", 3, 0, 2, 0, 0)
	e = sysRegCase(e, "ttbr1_el1", 3, 0, 2, 0, 1)
	e = sysRegCase(e, "tcr_el1", 3, 0, 2, 0, 2)
	e = sysRegCase(e, "esr_el1", 3, 0, 5, 2, 0)
	e = sysRegCase(e, "far_el1", 3, 0, 6, 0, 0)
	e = sysRegCase(e, "par_el1", 3, 0, 7, 4, 0)
	e = sysRegCase(e, "mair_el1", 3, 0, 10, 2, 0)
	e = sysRegCase(e, "amair_el1", 3, 0, 10, 3, 0)
	e = sysRegCase(e, "vbar_el1", 3, 0, 12, 0, 0)
	e = sysRegCase(e, "isr_el1", 3, 0, 12, 1, 0)
	e = sysRegCase(e, "contextidr_el1", 3, 0, 13, 0, 1)
	e = sysRegCase(e, "tpidr_el1", 3, 0, 13, 0, 4)
	e = sysRegCase(e, "cntkctl_el1", 3, 0, 14, 1, 0)
	e = sysRegCase(e, "CurrentEL", 3, 0, 4, 2, 2)
	return e
}

// The EL2 / EL3 named system registers (and SP_EL1 / SP_EL2) have clang's (op0, op1,
// CRn, CRm, op2).
func TestA64SysRegEL2EL3() testing.TestResult {
	var e @[]char = ""
	e = sysRegCase(e, "sp_el1", 3, 4, 4, 1, 0)
	e = sysRegCase(e, "sp_el2", 3, 6, 4, 1, 0)
	e = sysRegCase(e, "sctlr_el2", 3, 4, 1, 0, 0)
	e = sysRegCase(e, "hcr_el2", 3, 4, 1, 1, 0)
	e = sysRegCase(e, "spsr_el2", 3, 4, 4, 0, 0)
	e = sysRegCase(e, "elr_el2", 3, 4, 4, 0, 1)
	e = sysRegCase(e, "esr_el2", 3, 4, 5, 2, 0)
	e = sysRegCase(e, "far_el2", 3, 4, 6, 0, 0)
	e = sysRegCase(e, "vbar_el2", 3, 4, 12, 0, 0)
	e = sysRegCase(e, "sctlr_el3", 3, 6, 1, 0, 0)
	e = sysRegCase(e, "scr_el3", 3, 6, 1, 1, 0)
	e = sysRegCase(e, "spsr_el3", 3, 6, 4, 0, 0)
	e = sysRegCase(e, "elr_el3", 3, 6, 4, 0, 1)
	e = sysRegCase(e, "esr_el3", 3, 6, 5, 2, 0)
	e = sysRegCase(e, "vbar_el3", 3, 6, 12, 0, 0)
	return e
}

// The generic `s<op0>_<op1>_c<n>_c<m>_<op2>` form, any case, covering each field's
// range: op0 2 and 3 (clang's `mrs`), and op0 1 (the SYS space, which clang encodes
// as SYSL: `mrs x0, s1_2_c3_c4_5` is 0xD52A34A0).
func TestA64SysRegGeneric() testing.TestResult {
	var e @[]char = ""
	e = sysRegCase(e, "s3_7_c15_c15_7", 3, 7, 15, 15, 7)
	e = sysRegCase(e, "s2_0_c0_c0_0", 2, 0, 0, 0, 0)
	e = sysRegCase(e, "s1_2_c3_c4_5", 1, 2, 3, 4, 5)
	e = sysRegCase(e, "s1_0_c0_c0_0", 1, 0, 0, 0, 0)
	e = sysRegCase(e, "s3_3_c13_c0_2", 3, 3, 13, 0, 2)
	e = sysRegCase(e, "S3_3_C13_C0_2", 3, 3, 13, 0, 2)
	e = sysRegCase(e, "s3_0_c10_c2_0", 3, 0, 10, 2, 0)
	return e
}

// Malformed generic names are rejected, as clang rejects them: op0 above 3, op1 / op2
// above 7, CRn / CRm above 15, a three-digit field, a missing, empty or extra field, a
// missing 's' / 'c' letter, and a trailing character.  (op0 0 is this assembler's own
// rejection: clang accepts `mrs x0, s0_0_c0_c0_0`, but op0 0 is the hint / barrier /
// PSTATE space, not a system register.)
func TestA64SysRegGenericRejects() testing.TestResult {
	var e @[]char = ""
	e = sysRegRejectCase(e, "s0_0_c0_c0_0")
	e = sysRegRejectCase(e, "s4_0_c0_c0_0")
	e = sysRegRejectCase(e, "s3_8_c0_c0_0")
	e = sysRegRejectCase(e, "s3_0_c16_c0_0")
	e = sysRegRejectCase(e, "s3_0_c0_c16_0")
	e = sysRegRejectCase(e, "s3_0_c0_c0_8")
	e = sysRegRejectCase(e, "s3_0_c015_c0_0")
	e = sysRegRejectCase(e, "s3_0_c0_c0")
	e = sysRegRejectCase(e, "s3_0_c0_c0_")
	e = sysRegRejectCase(e, "s3__c0_c0_0")
	e = sysRegRejectCase(e, "s3_0_c0_c0_0_")
	e = sysRegRejectCase(e, "s3_0_c0_c0_0_0")
	e = sysRegRejectCase(e, "s3_0_0_0_0")
	e = sysRegRejectCase(e, "s3_0_c0_0_0")
	e = sysRegRejectCase(e, "3_0_c0_c0_0")
	e = sysRegRejectCase(e, "x3_0_c0_c0_0")
	e = sysRegRejectCase(e, "s3-0-c0-c0-0")
	e = sysRegRejectCase(e, "s3_0_c0_c0_0x")
	e = sysRegRejectCase(e, "s")
	e = sysRegRejectCase(e, "")
	return e
}

// Names that are neither listed nor generic are rejected: near-misses, a wrong
// exception-level suffix, and non-register words.
func TestA64SysRegUnknown() testing.TestResult {
	var e @[]char = ""
	e = sysRegRejectCase(e, "nzc")
	e = sysRegRejectCase(e, "nzcvv")
	e = sysRegRejectCase(e, "tpidr_el4")
	e = sysRegRejectCase(e, "sctlr")
	e = sysRegRejectCase(e, "x0")
	e = sysRegRejectCase(e, "sp")
	return e
}

// sysRegReadOnly is exactly the set of listed registers clang refuses to `msr` (the ID
// registers, CurrentEL, MIDR / MPIDR / REVIDR, CTR / DCZID, the physical and virtual
// counters, RNDR / RNDRRS, ISR_EL1), any case; every other register is writable.
func TestA64SysRegReadOnly() testing.TestResult {
	var e @[]char = ""
	e = sysReadOnlyCase(e, "id_aa64pfr0_el1", true)
	e = sysReadOnlyCase(e, "id_aa64mmfr1_el1", true)
	e = sysReadOnlyCase(e, "ID_AA64ISAR0_EL1", true)
	e = sysReadOnlyCase(e, "currentel", true)
	e = sysReadOnlyCase(e, "midr_el1", true)
	e = sysReadOnlyCase(e, "mpidr_el1", true)
	e = sysReadOnlyCase(e, "revidr_el1", true)
	e = sysReadOnlyCase(e, "ctr_el0", true)
	e = sysReadOnlyCase(e, "dczid_el0", true)
	e = sysReadOnlyCase(e, "cntpct_el0", true)
	e = sysReadOnlyCase(e, "cntvct_el0", true)
	e = sysReadOnlyCase(e, "rndr", true)
	e = sysReadOnlyCase(e, "rndrrs", true)
	e = sysReadOnlyCase(e, "isr_el1", true)
	e = sysReadOnlyCase(e, "CurrentEL", true)
	e = sysReadOnlyCase(e, "nzcv", false)
	e = sysReadOnlyCase(e, "tpidr_el0", false)
	e = sysReadOnlyCase(e, "cntfrq_el0", false)
	e = sysReadOnlyCase(e, "cntv_ctl_el0", false)
	e = sysReadOnlyCase(e, "sctlr_el1", false)
	e = sysReadOnlyCase(e, "spsel", false)
	e = sysReadOnlyCase(e, "vbar_el3", false)
	e = sysReadOnlyCase(e, "fpcr", false)
	e = sysReadOnlyCase(e, "id_", false)
	return e
}

// pstateCase checks that pstateField(name) is (f, crm, max).
func pstateCase(e @[]char, name *[]readonly char, f int, crm int, max int) @[]char {
	gf, gcrm, gmax := pstateField(name)
	if gf != f || (f >= 0 && (gcrm != crm || gmax != max)) {
		return goldenFail(e, name, "wrong PSTATE field")
	}
	return e
}

// Every PSTATE field has clang's op1*8+op2, CRm base and immediate range (from `msr
// <field>, #0` / `#1` and the largest immediate clang takes), any case; other names,
// including non-PSTATE registers such as nzcv, are -1.
func TestA64PstateField() testing.TestResult {
	var e @[]char = ""
	e = pstateCase(e, "spsel", 5, 0, 15)
	e = pstateCase(e, "daifset", 30, 0, 15)
	e = pstateCase(e, "daifclr", 31, 0, 15)
	e = pstateCase(e, "uao", 3, 0, 15)
	e = pstateCase(e, "pan", 4, 0, 15)
	e = pstateCase(e, "dit", 26, 0, 15)
	e = pstateCase(e, "ssbs", 25, 0, 15)
	e = pstateCase(e, "tco", 28, 0, 15)
	e = pstateCase(e, "allint", 8, 0, 1)
	e = pstateCase(e, "pm", 8, 2, 1)
	e = pstateCase(e, "svcrsm", 27, 2, 1)
	e = pstateCase(e, "svcrza", 27, 4, 1)
	e = pstateCase(e, "svcrsmza", 27, 6, 1)
	e = pstateCase(e, "DAIFSet", 30, 0, 15)
	e = pstateCase(e, "SVCRZA", 27, 4, 1)
	e = pstateCase(e, "nzcv", -1, 0, 0)
	e = pstateCase(e, "daif", -1, 0, 0)
	e = pstateCase(e, "svcr", -1, 0, 0)
	e = pstateCase(e, "", -1, 0, 0)
	return e
}
