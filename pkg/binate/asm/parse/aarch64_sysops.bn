package "pkg/binate/asm/parse"

// Operation tables for the AArch64 SYS aliases AT (address translation), DC (data cache),
// IC (instruction cache) and TLBI (TLB invalidation): each operation name maps to its SYS
// instruction's op1, CRn, CRm and op2, and to whether the operation takes an Xt operand
// (an address, set / way, ASID or page range; `xzr` is accepted).  A name not listed is
// rejected; `sys` itself reaches any encoding.

// sysOp packs a SYS alias operation — op1, CRn, CRm, op2 and whether it takes Xt (reg) —
// into one int (op1<<14 | CRn<<10 | CRm<<6 | op2<<3 | reg), the value the operation tables
// return and sysOpFields unpacks.
func sysOp(op1 int, crn int, crm int, op2 int, reg bool) int {
	var r int = 0
	if reg { r = 1 }
	return op1 * 16384 + crn * 1024 + crm * 64 + op2 * 8 + r
}

// sysOpFields unpacks a sysOp value into op1, CRn, CRm, op2 and whether it takes Xt.
func sysOpFields(enc int) (int, int, int, int, bool) {
	return enc / 16384, (enc / 1024) % 16, (enc / 64) % 16, (enc / 8) % 8, enc % 8 == 1
}

// isSysAlias reports whether mnemonic m is one of the SYS aliases at, dc, ic, tlbi.
func isSysAlias(m *[]readonly char) bool {
	return mnemIs(m, "at") || mnemIs(m, "dc") || mnemIs(m, "ic") || mnemIs(m, "tlbi")
}

// sysAliasOperation returns the sysOp value of operation name under the SYS alias mnem, or
// -1 when mnem has no such operation.
func sysAliasOperation(mnem *[]readonly char, name *[]readonly char) int {
	if mnemIs(mnem, "at") { return atOperation(name) }
	if mnemIs(mnem, "dc") { return dcOperation(name) }
	if mnemIs(mnem, "ic") { return icOperation(name) }
	if mnemIs(mnem, "tlbi") { return tlbiOperation(name) }
	return -1
}

// dcOperation returns the sysOp value of a DC operation (every one takes Xt), or -1: zero
// a block by address (ZVA; with MTE, GVA sets its allocation tags and GZVA does both);
// invalidate (I), clean (C) or clean and invalidate (CI) by address to the point of
// coherency (…VAC) or by set / way (…SW), and clean to the point of persistence (CVAP) or
// deep persistence (CVADP) — each also in MTE's G (tags) and GD (tags and data) forms;
// clean to the point of unification (CVAU); and — each also in the GD form — clean or clean
// and invalidate to the outer cache (…VAOC), and clean and invalidate to the point of
// physical storage (CIVAPS), or by physical address to the point of encryption (CIPAE) or
// of physical aliasing (CIPAPA).
func dcOperation(name *[]readonly char) int {
	if nameIs(name, "zva") { return sysOp(3, 7, 4, 1, true) }
	if nameIs(name, "gva") { return sysOp(3, 7, 4, 3, true) }
	if nameIs(name, "gzva") { return sysOp(3, 7, 4, 4, true) }
	if nameIs(name, "ivac") { return sysOp(0, 7, 6, 1, true) }
	if nameIs(name, "igvac") { return sysOp(0, 7, 6, 3, true) }
	if nameIs(name, "igdvac") { return sysOp(0, 7, 6, 5, true) }
	if nameIs(name, "isw") { return sysOp(0, 7, 6, 2, true) }
	if nameIs(name, "igsw") { return sysOp(0, 7, 6, 4, true) }
	if nameIs(name, "igdsw") { return sysOp(0, 7, 6, 6, true) }
	if nameIs(name, "cvac") { return sysOp(3, 7, 10, 1, true) }
	if nameIs(name, "cgvac") { return sysOp(3, 7, 10, 3, true) }
	if nameIs(name, "cgdvac") { return sysOp(3, 7, 10, 5, true) }
	if nameIs(name, "csw") { return sysOp(0, 7, 10, 2, true) }
	if nameIs(name, "cgsw") { return sysOp(0, 7, 10, 4, true) }
	if nameIs(name, "cgdsw") { return sysOp(0, 7, 10, 6, true) }
	if nameIs(name, "cvau") { return sysOp(3, 7, 11, 1, true) }
	if nameIs(name, "cvap") { return sysOp(3, 7, 12, 1, true) }
	if nameIs(name, "cgvap") { return sysOp(3, 7, 12, 3, true) }
	if nameIs(name, "cgdvap") { return sysOp(3, 7, 12, 5, true) }
	if nameIs(name, "cvadp") { return sysOp(3, 7, 13, 1, true) }
	if nameIs(name, "cgvadp") { return sysOp(3, 7, 13, 3, true) }
	if nameIs(name, "cgdvadp") { return sysOp(3, 7, 13, 5, true) }
	if nameIs(name, "civac") { return sysOp(3, 7, 14, 1, true) }
	if nameIs(name, "cigvac") { return sysOp(3, 7, 14, 3, true) }
	if nameIs(name, "cigdvac") { return sysOp(3, 7, 14, 5, true) }
	if nameIs(name, "cisw") { return sysOp(0, 7, 14, 2, true) }
	if nameIs(name, "cigsw") { return sysOp(0, 7, 14, 4, true) }
	if nameIs(name, "cigdsw") { return sysOp(0, 7, 14, 6, true) }
	if nameIs(name, "cvaoc") { return sysOp(3, 7, 11, 0, true) }
	if nameIs(name, "cgdvaoc") { return sysOp(3, 7, 11, 7, true) }
	if nameIs(name, "civaoc") { return sysOp(3, 7, 15, 0, true) }
	if nameIs(name, "cigdvaoc") { return sysOp(3, 7, 15, 7, true) }
	if nameIs(name, "civaps") { return sysOp(0, 7, 15, 1, true) }
	if nameIs(name, "cigdvaps") { return sysOp(0, 7, 15, 5, true) }
	if nameIs(name, "cipae") { return sysOp(4, 7, 14, 0, true) }
	if nameIs(name, "cigdpae") { return sysOp(4, 7, 14, 7, true) }
	if nameIs(name, "cipapa") { return sysOp(6, 7, 14, 1, true) }
	if nameIs(name, "cigdpapa") { return sysOp(6, 7, 14, 5, true) }
	return -1
}

// icOperation returns the sysOp value of an IC operation, or -1: invalidate all to the
// point of unification, Inner Shareable (IALLUIS) or local (IALLU), and by address
// (IVAU, the only one taking Xt).
func icOperation(name *[]readonly char) int {
	if nameIs(name, "ialluis") { return sysOp(0, 7, 1, 0, false) }
	if nameIs(name, "iallu") { return sysOp(0, 7, 5, 0, false) }
	if nameIs(name, "ivau") { return sysOp(3, 7, 5, 1, true) }
	return -1
}

// atOperation returns the sysOp value of an AT operation (every one takes the address in
// Xt), or -1: stage 1 translation (S1) or stages 1 and 2 (S12) as if from EL0..EL3 (E0..E3),
// for a read (R) or write (W), taking PSTATE.PAN into account (…RP / …WP), or without
// permission checks (…A).
func atOperation(name *[]readonly char) int {
	if nameIs(name, "s1e1r") { return sysOp(0, 7, 8, 0, true) }
	if nameIs(name, "s1e1w") { return sysOp(0, 7, 8, 1, true) }
	if nameIs(name, "s1e0r") { return sysOp(0, 7, 8, 2, true) }
	if nameIs(name, "s1e0w") { return sysOp(0, 7, 8, 3, true) }
	if nameIs(name, "s1e1rp") { return sysOp(0, 7, 9, 0, true) }
	if nameIs(name, "s1e1wp") { return sysOp(0, 7, 9, 1, true) }
	if nameIs(name, "s1e1a") { return sysOp(0, 7, 9, 2, true) }
	if nameIs(name, "s1e2r") { return sysOp(4, 7, 8, 0, true) }
	if nameIs(name, "s1e2w") { return sysOp(4, 7, 8, 1, true) }
	if nameIs(name, "s1e2a") { return sysOp(4, 7, 9, 2, true) }
	if nameIs(name, "s12e1r") { return sysOp(4, 7, 8, 4, true) }
	if nameIs(name, "s12e1w") { return sysOp(4, 7, 8, 5, true) }
	if nameIs(name, "s12e0r") { return sysOp(4, 7, 8, 6, true) }
	if nameIs(name, "s12e0w") { return sysOp(4, 7, 8, 7, true) }
	if nameIs(name, "s1e3r") { return sysOp(6, 7, 8, 0, true) }
	if nameIs(name, "s1e3w") { return sysOp(6, 7, 8, 1, true) }
	if nameIs(name, "s1e3a") { return sysOp(6, 7, 9, 2, true) }
	return -1
}

// tlbiOperation returns the sysOp value of a TLBI operation, or -1.  Each operation has an
// nXS form, spelled with an `nxs` suffix, which need not wait for accesses with the XS
// attribute: the same fields with CRn 9 in place of 8.
func tlbiOperation(name *[]readonly char) int {
	var n int = len(name)
	if n > 3 && nameIs(name[n - 3:n], "nxs") { return tlbiEL1Op(name[0:n - 3], 9) }
	return tlbiEL1Op(name, 8)
}

// tlbiEL1Op returns the sysOp value, with CRn crn, of a TLBI operation of the EL1&0
// translation regime (op1 0), or continues with tlbiEL2Op.  Each comes local, Inner
// Shareable (…IS) and Outer Shareable (…OS); those taking Xt name a VA and ASID, an ASID,
// or (the R… range forms) a range of pages.
func tlbiEL1Op(name *[]readonly char, crn int) int {
	if nameIs(name, "vmalle1") { return sysOp(0, crn, 7, 0, false) }
	if nameIs(name, "vmalle1is") { return sysOp(0, crn, 3, 0, false) }
	if nameIs(name, "vmalle1os") { return sysOp(0, crn, 1, 0, false) }
	if nameIs(name, "vae1") { return sysOp(0, crn, 7, 1, true) }
	if nameIs(name, "vae1is") { return sysOp(0, crn, 3, 1, true) }
	if nameIs(name, "vae1os") { return sysOp(0, crn, 1, 1, true) }
	if nameIs(name, "aside1") { return sysOp(0, crn, 7, 2, true) }
	if nameIs(name, "aside1is") { return sysOp(0, crn, 3, 2, true) }
	if nameIs(name, "aside1os") { return sysOp(0, crn, 1, 2, true) }
	if nameIs(name, "vaae1") { return sysOp(0, crn, 7, 3, true) }
	if nameIs(name, "vaae1is") { return sysOp(0, crn, 3, 3, true) }
	if nameIs(name, "vaae1os") { return sysOp(0, crn, 1, 3, true) }
	if nameIs(name, "vale1") { return sysOp(0, crn, 7, 5, true) }
	if nameIs(name, "vale1is") { return sysOp(0, crn, 3, 5, true) }
	if nameIs(name, "vale1os") { return sysOp(0, crn, 1, 5, true) }
	if nameIs(name, "vaale1") { return sysOp(0, crn, 7, 7, true) }
	if nameIs(name, "vaale1is") { return sysOp(0, crn, 3, 7, true) }
	if nameIs(name, "vaale1os") { return sysOp(0, crn, 1, 7, true) }
	if nameIs(name, "rvae1") { return sysOp(0, crn, 6, 1, true) }
	if nameIs(name, "rvae1is") { return sysOp(0, crn, 2, 1, true) }
	if nameIs(name, "rvae1os") { return sysOp(0, crn, 5, 1, true) }
	if nameIs(name, "rvaae1") { return sysOp(0, crn, 6, 3, true) }
	if nameIs(name, "rvaae1is") { return sysOp(0, crn, 2, 3, true) }
	if nameIs(name, "rvaae1os") { return sysOp(0, crn, 5, 3, true) }
	if nameIs(name, "rvale1") { return sysOp(0, crn, 6, 5, true) }
	if nameIs(name, "rvale1is") { return sysOp(0, crn, 2, 5, true) }
	if nameIs(name, "rvale1os") { return sysOp(0, crn, 5, 5, true) }
	if nameIs(name, "rvaale1") { return sysOp(0, crn, 6, 7, true) }
	if nameIs(name, "rvaale1is") { return sysOp(0, crn, 2, 7, true) }
	if nameIs(name, "rvaale1os") { return sysOp(0, crn, 5, 7, true) }
	return tlbiEL2Op(name, crn)
}

// tlbiEL2Op continues tlbiEL1Op with the operations of op1 4: all of EL1 (ALLE1), stage 1
// and 2 (VMALLS12E1), the stage-2 dirty-state invalidation (VMALLWS2E1) and the stage-2 IPA
// forms, then EL2's own.
func tlbiEL2Op(name *[]readonly char, crn int) int {
	if nameIs(name, "alle1") { return sysOp(4, crn, 7, 4, false) }
	if nameIs(name, "alle1is") { return sysOp(4, crn, 3, 4, false) }
	if nameIs(name, "alle1os") { return sysOp(4, crn, 1, 4, false) }
	if nameIs(name, "vmalls12e1") { return sysOp(4, crn, 7, 6, false) }
	if nameIs(name, "vmalls12e1is") { return sysOp(4, crn, 3, 6, false) }
	if nameIs(name, "vmalls12e1os") { return sysOp(4, crn, 1, 6, false) }
	if nameIs(name, "vmallws2e1") { return sysOp(4, crn, 6, 2, false) }
	if nameIs(name, "vmallws2e1is") { return sysOp(4, crn, 2, 2, false) }
	if nameIs(name, "vmallws2e1os") { return sysOp(4, crn, 5, 2, false) }
	if nameIs(name, "ipas2e1") { return sysOp(4, crn, 4, 1, true) }
	if nameIs(name, "ipas2e1is") { return sysOp(4, crn, 0, 1, true) }
	if nameIs(name, "ipas2e1os") { return sysOp(4, crn, 4, 0, true) }
	if nameIs(name, "ipas2le1") { return sysOp(4, crn, 4, 5, true) }
	if nameIs(name, "ipas2le1is") { return sysOp(4, crn, 0, 5, true) }
	if nameIs(name, "ipas2le1os") { return sysOp(4, crn, 4, 4, true) }
	if nameIs(name, "ripas2e1") { return sysOp(4, crn, 4, 2, true) }
	if nameIs(name, "ripas2e1is") { return sysOp(4, crn, 0, 2, true) }
	if nameIs(name, "ripas2e1os") { return sysOp(4, crn, 4, 3, true) }
	if nameIs(name, "ripas2le1") { return sysOp(4, crn, 4, 6, true) }
	if nameIs(name, "ripas2le1is") { return sysOp(4, crn, 0, 6, true) }
	if nameIs(name, "ripas2le1os") { return sysOp(4, crn, 4, 7, true) }
	if nameIs(name, "alle2") { return sysOp(4, crn, 7, 0, false) }
	if nameIs(name, "alle2is") { return sysOp(4, crn, 3, 0, false) }
	if nameIs(name, "alle2os") { return sysOp(4, crn, 1, 0, false) }
	if nameIs(name, "vae2") { return sysOp(4, crn, 7, 1, true) }
	if nameIs(name, "vae2is") { return sysOp(4, crn, 3, 1, true) }
	if nameIs(name, "vae2os") { return sysOp(4, crn, 1, 1, true) }
	if nameIs(name, "vale2") { return sysOp(4, crn, 7, 5, true) }
	if nameIs(name, "vale2is") { return sysOp(4, crn, 3, 5, true) }
	if nameIs(name, "vale2os") { return sysOp(4, crn, 1, 5, true) }
	if nameIs(name, "rvae2") { return sysOp(4, crn, 6, 1, true) }
	if nameIs(name, "rvae2is") { return sysOp(4, crn, 2, 1, true) }
	if nameIs(name, "rvae2os") { return sysOp(4, crn, 5, 1, true) }
	if nameIs(name, "rvale2") { return sysOp(4, crn, 6, 5, true) }
	if nameIs(name, "rvale2is") { return sysOp(4, crn, 2, 5, true) }
	if nameIs(name, "rvale2os") { return sysOp(4, crn, 5, 5, true) }
	return tlbiEL3Op(name, crn)
}

// tlbiEL3Op continues tlbiEL2Op with the operations of op1 6: EL3's, and the realm
// management extension's invalidation of cached granule protection table entries — all of
// them (PAALL) or those of a physical address range (RPAOS, RPALOS).
func tlbiEL3Op(name *[]readonly char, crn int) int {
	if nameIs(name, "alle3") { return sysOp(6, crn, 7, 0, false) }
	if nameIs(name, "alle3is") { return sysOp(6, crn, 3, 0, false) }
	if nameIs(name, "alle3os") { return sysOp(6, crn, 1, 0, false) }
	if nameIs(name, "vae3") { return sysOp(6, crn, 7, 1, true) }
	if nameIs(name, "vae3is") { return sysOp(6, crn, 3, 1, true) }
	if nameIs(name, "vae3os") { return sysOp(6, crn, 1, 1, true) }
	if nameIs(name, "vale3") { return sysOp(6, crn, 7, 5, true) }
	if nameIs(name, "vale3is") { return sysOp(6, crn, 3, 5, true) }
	if nameIs(name, "vale3os") { return sysOp(6, crn, 1, 5, true) }
	if nameIs(name, "rvae3") { return sysOp(6, crn, 6, 1, true) }
	if nameIs(name, "rvae3is") { return sysOp(6, crn, 2, 1, true) }
	if nameIs(name, "rvae3os") { return sysOp(6, crn, 5, 1, true) }
	if nameIs(name, "rvale3") { return sysOp(6, crn, 6, 5, true) }
	if nameIs(name, "rvale3is") { return sysOp(6, crn, 2, 5, true) }
	if nameIs(name, "rvale3os") { return sysOp(6, crn, 5, 5, true) }
	if nameIs(name, "paall") { return sysOp(6, crn, 7, 4, false) }
	if nameIs(name, "paallos") { return sysOp(6, crn, 1, 4, false) }
	if nameIs(name, "rpaos") { return sysOp(6, crn, 4, 3, true) }
	if nameIs(name, "rpalos") { return sysOp(6, crn, 4, 7, true) }
	return -1
}
