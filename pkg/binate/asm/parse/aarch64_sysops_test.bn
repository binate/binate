package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the SYS alias operation tables in aarch64_sysops.bn: the sysOp packing, the
// AT / DC / IC / TLBI lookups (fields decoded from clang's word for the operation, any
// case), the nXS suffix, and the mnemonic dispatch.  The golden tests assemble every
// operation; these pin the table values and the lookups' edges.

// sysOpCase checks that got, an operation table's value for name, is the operation (op1,
// CRn, CRm, op2, reg), both packed and as unpacked by sysOpFields.
func sysOpCase(e @[]char, name *[]readonly char, got int, op1 int, crn int, crm int, op2 int,
		reg bool) @[]char {
	if got != sysOp(op1, crn, crm, op2, reg) { return goldenFail(e, name, "wrong operation") }
	g1, gn, gm, g2, gr := sysOpFields(got)
	if g1 != op1 || gn != crn || gm != crm || g2 != op2 || gr != reg {
		return goldenFail(e, name, "sysOpFields does not invert sysOp")
	}
	return e
}

// sysOpMissCase checks that got, an operation table's value for name, is -1.
func sysOpMissCase(e @[]char, name *[]readonly char, got int) @[]char {
	if got != -1 { return goldenFail(e, name, "accepted as an operation") }
	return e
}

// sysOp packs and sysOpFields unpacks every field at its extremes.
func TestA64SysOpPacking() testing.TestResult {
	var e @[]char = ""
	e = sysOpCase(e, "all max", sysOp(7, 15, 15, 7, true), 7, 15, 15, 7, true)
	e = sysOpCase(e, "all zero", sysOp(0, 0, 0, 0, false), 0, 0, 0, 0, false)
	e = sysOpCase(e, "mixed", sysOp(6, 9, 1, 4, false), 6, 9, 1, 4, false)
	return e
}

// DC and IC operations: clang's fields, Xt for every DC operation and for IC IVAU only
// (clang rejects `ic ialluis, x0` and `dc zva`); any case; other names are -1.
func TestA64CacheOperations() testing.TestResult {
	var e @[]char = ""
	e = sysOpCase(e, "zva", dcOperation("zva"), 3, 7, 4, 1, true)
	e = sysOpCase(e, "gzva", dcOperation("gzva"), 3, 7, 4, 4, true)
	e = sysOpCase(e, "cigdsw", dcOperation("cigdsw"), 0, 7, 14, 6, true)
	e = sysOpCase(e, "cvaoc", dcOperation("cvaoc"), 3, 7, 11, 0, true)
	e = sysOpCase(e, "cigdvaps", dcOperation("cigdvaps"), 0, 7, 15, 5, true)
	e = sysOpCase(e, "cipapa", dcOperation("cipapa"), 6, 7, 14, 1, true)
	e = sysOpCase(e, "ZVA", dcOperation("ZVA"), 3, 7, 4, 1, true)
	e = sysOpMissCase(e, "ivau", dcOperation("ivau"))
	e = sysOpMissCase(e, "gbva", dcOperation("gbva"))
	e = sysOpMissCase(e, "", dcOperation(""))
	e = sysOpCase(e, "ialluis", icOperation("ialluis"), 0, 7, 1, 0, false)
	e = sysOpCase(e, "iallu", icOperation("iallu"), 0, 7, 5, 0, false)
	e = sysOpCase(e, "ivau", icOperation("ivau"), 3, 7, 5, 1, true)
	e = sysOpCase(e, "IAllU", icOperation("IAllU"), 0, 7, 5, 0, false)
	e = sysOpMissCase(e, "zva", icOperation("zva"))
	e = sysOpMissCase(e, "", icOperation(""))
	return e
}

// AT operations: clang's fields, all taking Xt; other names are -1.
func TestA64AtOperations() testing.TestResult {
	var e @[]char = ""
	e = sysOpCase(e, "s1e1r", atOperation("s1e1r"), 0, 7, 8, 0, true)
	e = sysOpCase(e, "s1e0r", atOperation("s1e0r"), 0, 7, 8, 2, true)
	e = sysOpCase(e, "s1e1wp", atOperation("s1e1wp"), 0, 7, 9, 1, true)
	e = sysOpCase(e, "s12e0w", atOperation("s12e0w"), 4, 7, 8, 7, true)
	e = sysOpCase(e, "S1E3A", atOperation("S1E3A"), 6, 7, 9, 2, true)
	e = sysOpMissCase(e, "s1e2rp", atOperation("s1e2rp"))
	e = sysOpMissCase(e, "s1e1rnxs", atOperation("s1e1rnxs"))
	e = sysOpMissCase(e, "", atOperation(""))
	return e
}

// TLBI operations: clang's fields, CRn 8, or 9 with the nXS suffix (any case); a suffix on
// nothing, twice, or on an unknown operation is -1, as is a scope an operation lacks.
func TestA64TlbiOperations() testing.TestResult {
	var e @[]char = ""
	e = sysOpCase(e, "vmalle1", tlbiOperation("vmalle1"), 0, 8, 7, 0, false)
	e = sysOpCase(e, "vae1is", tlbiOperation("vae1is"), 0, 8, 3, 1, true)
	e = sysOpCase(e, "rvaale1os", tlbiOperation("rvaale1os"), 0, 8, 5, 7, true)
	e = sysOpCase(e, "ipas2e1os", tlbiOperation("ipas2e1os"), 4, 8, 4, 0, true)
	e = sysOpCase(e, "vmallws2e1is", tlbiOperation("vmallws2e1is"), 4, 8, 2, 2, false)
	e = sysOpCase(e, "alle2", tlbiOperation("alle2"), 4, 8, 7, 0, false)
	e = sysOpCase(e, "rpalos", tlbiOperation("rpalos"), 6, 8, 4, 7, true)
	e = sysOpCase(e, "vae1nxs", tlbiOperation("vae1nxs"), 0, 9, 7, 1, true)
	e = sysOpCase(e, "ALLE3OSNXS", tlbiOperation("ALLE3OSNXS"), 6, 9, 1, 0, false)
	e = sysOpCase(e, "paallnXS", tlbiOperation("paallnXS"), 6, 9, 7, 4, false)
	e = sysOpMissCase(e, "nxs", tlbiOperation("nxs"))
	e = sysOpMissCase(e, "vae1nxsnxs", tlbiOperation("vae1nxsnxs"))
	e = sysOpMissCase(e, "foonxs", tlbiOperation("foonxs"))
	e = sysOpMissCase(e, "paallis", tlbiOperation("paallis"))
	e = sysOpMissCase(e, "", tlbiOperation(""))
	return e
}

// sysAliasOperation dispatches on the mnemonic (any case): an operation of one alias is
// not one of another's, and a mnemonic that is no SYS alias has none.
func TestA64SysAliasOperation() testing.TestResult {
	var e @[]char = ""
	e = sysOpCase(e, "at s1e0r", sysAliasOperation("at", "s1e0r"), 0, 7, 8, 2, true)
	e = sysOpCase(e, "DC cvac", sysAliasOperation("DC", "cvac"), 3, 7, 10, 1, true)
	e = sysOpCase(e, "ic iallu", sysAliasOperation("ic", "iallu"), 0, 7, 5, 0, false)
	e = sysOpCase(e, "Tlbi alle2", sysAliasOperation("Tlbi", "alle2"), 4, 8, 7, 0, false)
	e = sysOpMissCase(e, "dc iallu", sysAliasOperation("dc", "iallu"))
	e = sysOpMissCase(e, "tlbi zva", sysAliasOperation("tlbi", "zva"))
	e = sysOpMissCase(e, "sys zva", sysAliasOperation("sys", "zva"))
	if !isSysAlias("TLBI") || !isSysAlias("at") || isSysAlias("sys") || isSysAlias("atx") {
		e = goldenFail(e, "isSysAlias", "wrong mnemonic set")
	}
	return e
}
