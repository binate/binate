	p.ParseLine("svc #0x80")
	if p.HasError { return fail(p.ErrorMsg) }
	var inst uint32 = readInst(p.Asm.Sections[0], 0)
	if inst != 0xD4001001 { return fail("SVC #0x80 encoding wrong") }
	return ""
}

func TestParseBranch() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	// Branch to an `L`-prefixed block label — resolves in-section (stays
	// within the function's atom); a non-`L` target would be left as a reloc.
	p.ParseLine("b Lblock")
	p.ParseLine("nop")
	p.ParseLine("Lblock:")
	p.ParseLine("nop")
	if p.HasError { return fail(p.ErrorMsg) }
	aarch64.ResolveFixups(p.Asm)
	p.Asm.Finalize()
	// B at offset 0 → Lblock at offset 8, imm26 = 2
	var inst uint32 = readInst(p.Asm.Sections[0], 0)
	if inst != 0x14000002 { return fail("B encoding wrong after fixup") }
	return ""
}

// `add rd, rn, #:lo12:label` records a FIX_ADD_LO12 relocation (the low-12-bits
// half of an ADRP+ADD address materialization) and encodes ADD rd, rn, #0.  Paired
// with the adrp's FIX_ADRP_HI21, this is how hand-written aa64 asm reaches a datum.
func TestParseAddLo12() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("adrp x1, msg")
	p.ParseLine("add x1, x1, #:lo12:msg")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.NumFixups != 2 { return fail("expected two fixups (ADRP + ADD lo12)") }
	if s.Fixups[0].Kind != aarch64.FIX_ADRP_HI21 { return fail("first fixup should be FIX_ADRP_HI21") }
	if s.Fixups[1].Kind != aarch64.FIX_ADD_LO12 { return fail("second fixup should be FIX_ADD_LO12") }
	if s.Fixups[1].Offset != cast(uint, 4) { return fail("the ADD lo12 fixup should be at offset 4") }
	if !charsEqual(s.Fixups[1].Label, "msg") { return fail("the ADD lo12 fixup should target msg") }
	// ADD x1, x1, #0 (imm12 patched by the linker): 0x91000021.
	if readInst(s, 4) != 0x91000021 { return fail("ADD lo12 encoding wrong") }
	return ""
}

// The lo12 lookahead must not disturb a normal immediate ADD: `add rd, rn, #imm`
// still parses as an ordinary add (no fixup).
func TestParseAddImmNotLo12() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("add x0, x1, #42")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.NumFixups != 0 { return fail("a plain immediate add should record no fixup") }
	return ""
}

// `ldr xt, [xn, #:lo12:label]` records a FIX_LDR_LO12 relocation (the load half of
// an ADRP+LDR that reads a datum) and encodes LDR xt, [xn].  A 32-bit destination
// is rejected (FIX_LDR_LO12 always encodes the 64-bit scaled form).
func TestParseLdrLo12() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("adrp x1, val")
	p.ParseLine("ldr x0, [x1, #:lo12:val]")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.NumFixups != 2 { return fail("expected two fixups (ADRP + LDR lo12)") }
	if s.Fixups[1].Kind != aarch64.FIX_LDR_LO12 { return fail("second fixup should be FIX_LDR_LO12") }
	if s.Fixups[1].Offset != cast(uint, 4) { return fail("the LDR lo12 fixup should be at offset 4") }
	if !charsEqual(s.Fixups[1].Label, "val") { return fail("the LDR lo12 fixup should target val") }
	// LDR x0, [x1, #0] (imm12 patched by the linker): 0xF9400020.
	if readInst(s, 4) != 0xf9400020 { return fail("LDR lo12 encoding wrong") }
	return ""
}

// A 32-bit `ldr w0, [x1, #:lo12:val]` is rejected — FIX_LDR_LO12 always encodes the
// 64-bit (8-byte-scaled) form, so a 32-bit load would relocate with the wrong scale.
func TestParseLdrLo12Rejects32Bit() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("ldr w0, [x1, #:lo12:val]")
	if !p.HasError { return fail("a 32-bit ldr with #:lo12: should be rejected") }
	return ""
}
