func TestParseSvc() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("svc #0x80")
	if p.HasError { return fail(p.ErrorMsg) }
	var inst uint32 = readInst(p.Asm.Sections[0], 0)
	if inst != 0xD4001001 { return fail("SVC #0x80 encoding wrong") }
	return ""
}

func TestParseBranch() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	// Branch to an `L`-prefixed block label — resolves in-section (stays
	// within the function's atom); a non-`L` target would be left as a reloc.
	p.ParseLine("b Lblock")
	p.ParseLine("nop")
	p.ParseLine("Lblock:")
	p.ParseLine("nop")
	if p.HasError { return fail(p.ErrorMsg) }
	aarch64.ResolveFixups(p.Asm)
	p.Asm.Finalize()
	// B at offset 0 → Lblock at offset 8, imm26 = 2
	var inst uint32 = readInst(p.Asm.Sections[0], 0)
	if inst != 0x14000002 { return fail("B encoding wrong after fixup") }
	return ""
}
