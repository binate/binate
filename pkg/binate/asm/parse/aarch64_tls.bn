package "pkg/binate/asm/parse"

import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// The ELF thread-local relocation operators (isa's FIX_TLS* / FIX_AUTH_TLSDESC_* kinds): the
// local-exec `:tprel_*:` and local-dynamic `:dtprel_*:` families — a MOVW chunk on MOVZ / MOVN /
// MOVK / `mov` (an IT_MOVW item, its Spec the kind), and a page offset on ADD (`:tprel_hi12:`,
// `_lo12`, `_lo12_nc`) or, but HI12, on a load / store (an IT_LO12 item, its Spec the ADD kind;
// the load / store takes its family, tlsLdStFamily) — and the initial-exec and TLSDESC ones: a
// GOT slot's or descriptor's page on ADRP (`:gottprel:`, `:tlsdesc:`, `:tlsdesc_auth:`; an
// IT_LABEL item, its Spec the ADRP kind), the slot's literal load (`ldr Rt, :gottprel:sym`), its
// page offset on an 8-byte transfer and the descriptor's on ADD too (`:gottprel_lo12:`,
// `:tlsdesc_lo12:`, `:tlsdesc_auth_lo12:`), the slot's MOVW chunks (`:gottprel_g1:`,
// `:gottprel_g0_nc:`) and `.tlsdesccall`.  A slot or descriptor reference takes no addend: as
// for a `:got:` one, linkers disagree on what it means.

// tlsMovwKind returns the isa kind of a thread-local MOVW-group operator's name (any case,
// as clang reads it), or -1.
func tlsMovwKind(name *[]readonly char) int {
	if nameIs(name, "tprel_g2") { return isa.FIX_TLSLE_MOVW_TPREL_G2 }
	if nameIs(name, "tprel_g1") { return isa.FIX_TLSLE_MOVW_TPREL_G1 }
	if nameIs(name, "tprel_g1_nc") { return isa.FIX_TLSLE_MOVW_TPREL_G1_NC }
	if nameIs(name, "tprel_g0") { return isa.FIX_TLSLE_MOVW_TPREL_G0 }
	if nameIs(name, "tprel_g0_nc") { return isa.FIX_TLSLE_MOVW_TPREL_G0_NC }
	if nameIs(name, "dtprel_g2") { return isa.FIX_TLSLD_MOVW_DTPREL_G2 }
	if nameIs(name, "dtprel_g1") { return isa.FIX_TLSLD_MOVW_DTPREL_G1 }
	if nameIs(name, "dtprel_g1_nc") { return isa.FIX_TLSLD_MOVW_DTPREL_G1_NC }
	if nameIs(name, "dtprel_g0") { return isa.FIX_TLSLD_MOVW_DTPREL_G0 }
	if nameIs(name, "dtprel_g0_nc") { return isa.FIX_TLSLD_MOVW_DTPREL_G0_NC }
	if nameIs(name, "gottprel_g1") { return isa.FIX_TLSIE_MOVW_GOTTPREL_G1 }
	if nameIs(name, "gottprel_g0_nc") { return isa.FIX_TLSIE_MOVW_GOTTPREL_G0_NC }
	return -1
}

// tlsLabelKind returns the isa ADRP kind of a thread-local page operator's name (`:gottprel:`,
// `:tlsdesc:`, `:tlsdesc_auth:`; any case), or -1.
func tlsLabelKind(name *[]readonly char) int {
	if nameIs(name, "gottprel") { return isa.FIX_TLSIE_ADR_GOTTPREL_PAGE21 }
	if nameIs(name, "tlsdesc") { return isa.FIX_TLSDESC_ADR_PAGE21 }
	if nameIs(name, "tlsdesc_auth") { return isa.FIX_AUTH_TLSDESC_ADR_PAGE21 }
	return -1
}

// isTlsSlotKind reports whether a thread-local kind refers to a GOT slot or a TLS descriptor
// (initial-exec, TLSDESC), which takes no addend.
func isTlsSlotKind(kind int) bool {
	return (kind >= isa.FIX_TLSIE_MOVW_GOTTPREL_G1 && kind <= isa.FIX_TLSIE_LD_GOTTPREL_PREL19) ||
			(kind >= isa.FIX_TLSDESC_ADR_PAGE21 && kind <= isa.FIX_TLSDESC_CALL) ||
			(kind >= isa.FIX_AUTH_TLSDESC_ADR_PAGE21 && kind <= isa.FIX_AUTH_TLSDESC_ADD_LO12)
}

// tlsLo12Kind returns the isa kind of a thread-local page-offset operator's name (any case) —
// its ADD kind, or for `:gottprel_lo12:`, which only a load / store takes, its 8-byte transfer
// kind — or -1.
func tlsLo12Kind(name *[]readonly char) int {
	if nameIs(name, "tprel_hi12") { return isa.FIX_TLSLE_ADD_TPREL_HI12 }
	if nameIs(name, "tprel_lo12") { return isa.FIX_TLSLE_ADD_TPREL_LO12 }
	if nameIs(name, "tprel_lo12_nc") { return isa.FIX_TLSLE_ADD_TPREL_LO12_NC }
	if nameIs(name, "dtprel_hi12") { return isa.FIX_TLSLD_ADD_DTPREL_HI12 }
	if nameIs(name, "dtprel_lo12") { return isa.FIX_TLSLD_ADD_DTPREL_LO12 }
	if nameIs(name, "dtprel_lo12_nc") { return isa.FIX_TLSLD_ADD_DTPREL_LO12_NC }
	if nameIs(name, "gottprel_lo12") { return isa.FIX_TLSIE_LD64_GOTTPREL_LO12_NC }
	if nameIs(name, "tlsdesc_lo12") { return isa.FIX_TLSDESC_ADD_LO12 }
	if nameIs(name, "tlsdesc_auth_lo12") { return isa.FIX_AUTH_TLSDESC_ADD_LO12 }
	return -1
}

// isTlsSpec reports whether an IT_LO12 or IT_LABEL item's Spec is a thread-local kind
// (tlsLo12Kind, tlsLabelKind) rather than a SPEC_* specifier.
func isTlsSpec(spec int) bool { return spec >= isa.FIX_TLSLD_MOVW_DTPREL_G2 }

// tlsLdStFamily returns the isa load / store family of a thread-local page-offset kind (the
// 8-bit member of a LO12 or LO12_NC; the 8-byte slot transfer's kind for `:gottprel_lo12:` and
// the descriptor ones), or -1 for a HI12 kind, which only ADD takes.
func tlsLdStFamily(kind int) int {
	if kind == isa.FIX_TLSIE_LD64_GOTTPREL_LO12_NC { return kind }
	if kind == isa.FIX_TLSDESC_ADD_LO12 { return isa.FIX_TLSDESC_LD64_LO12 }
	if kind == isa.FIX_AUTH_TLSDESC_ADD_LO12 { return isa.FIX_AUTH_TLSDESC_LD64_LO12 }
	if kind == isa.FIX_TLSLE_ADD_TPREL_LO12 { return isa.FIX_TLSLE_LDST8_TPREL_LO12 }
	if kind == isa.FIX_TLSLE_ADD_TPREL_LO12_NC { return isa.FIX_TLSLE_LDST8_TPREL_LO12_NC }
	if kind == isa.FIX_TLSLD_ADD_DTPREL_LO12 { return isa.FIX_TLSLD_LDST8_DTPREL_LO12 }
	if kind == isa.FIX_TLSLD_ADD_DTPREL_LO12_NC { return isa.FIX_TLSLD_LDST8_DTPREL_LO12_NC }
	return -1
}

// isTlsSlotTransfer reports whether a load / store family (tlsLdStFamily, or Mach-O's
// `@TLVPPAGEOFF`) is an 8-byte slot transfer's kind (isa.LdStTlsSlot) rather than an
// access-sized LO12 family (isa.LdStTlsLo12).
func isTlsSlotTransfer(family int) bool {
	return family == isa.FIX_TLSIE_LD64_GOTTPREL_LO12_NC || family == isa.FIX_TLSDESC_LD64_LO12 ||
			family == isa.FIX_AUTH_TLSDESC_LD64_LO12 || family == isa.FIX_TLVP_LOAD_PAGEOFF12
}

// parseTlsDescCallDirective handles `.tlsdesccall sym`: the next instruction, which must be the
// call through sym's TLS descriptor (tlsDescCallNext), takes the TLSDESC_CALL relocation.  The
// operand is one symbol name, as clang takes it — no number, addend or second symbol.
func parseTlsDescCallDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) || constIndex(p, tok.Text) >= 0 {
		setErr(p, "expected the symbol whose TLS descriptor the next instruction calls")
		return l, tok
	}
	p.TlsDescCall = buf.CopyStr(tok.Text)
	p.TlsDescLine = p.LineNum
	// clang emits the directive as an instruction of no bytes, naming the symbol: it marks
	// code, then the symbol is mentioned.
	p.Asm.MarkInstruction()
	p.Asm.NoteMention(p.TlsDescCall)
	l, tok = LexNext(l)
	return l, tok
}

// tlsDescCallNext handles the statement a pending `.tlsdesccall` marks — tok its first token,
// isConst a constant definition: the call through a register (`blr`, or the PAuth `blraa`,
// `blrab`, `blraaz`, `blrabz`), which a linker may rewrite, takes the TLSDESC_CALL relocation
// (isa.TlsDescCall).  Anything else is an error (clang marks whatever comes next, a relocation
// past the end of the section included).  Reports whether the statement goes on.
func tlsDescCallNext(p @Parser, tok Token, isConst bool) bool {
	var call bool = !isConst && tok.Text[0] != '.' &&
			(mnemIs(tok.Text, "blr") || mnemIs(tok.Text, "blraa") || mnemIs(tok.Text, "blrab") ||
					mnemIs(tok.Text, "blraaz") || mnemIs(tok.Text, "blrabz"))
	if !call {
		setErr(p, tlsDescCallError(p))
		return false
	}
	isa.TlsDescCall(p.Asm, p.TlsDescCall)
	p.TlsDescCall = ""
	return true
}

// tlsDescCallError is the error for a pending `.tlsdesccall` not followed by a call.
func tlsDescCallError(p @Parser) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write("the `.tlsdesccall` on line ")
	stringutils.WriteInt(b, p.TlsDescLine)
	b.Write(" is not followed by the call through a register it marks (blr)")
	return buf.CopyStr(b.String())
}
