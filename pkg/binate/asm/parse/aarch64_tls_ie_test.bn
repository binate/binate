package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// The ELF initial-exec and TLSDESC operators (aarch64_tls.bn) against clang's words and
// relocations (`clang -c -target aarch64-linux-gnu -march=armv8.3-a`, llvm-objdump -d,
// llvm-readelf -r), each relocation's ELF type the fixup kind + 312.  (relocOpCase is in
// aarch64_relocop_test.bn, labelsReject in aarch64_golden_labels_test.bn.)

// The GOT slot of a thread-pointer offset — its page (ADRP), page offset on every 8-byte
// transfer (X or D, PRFM), MOVW chunks (a MOVZ with the checked G1 a MOVN, W too) and literal
// load in every literal form — and the TLS descriptor: its page, its page offset on ADD (X or W,
// `lsl #12` written with '#') and on an 8-byte transfer, `.tlsdesccall` on the call after it
// (a label, a blank or a comment line between them allowed), and the PAuth signed descriptor,
// called through `blraa` (or `blraaz`, `blrab`, `blrabz`).
func TestTlsInitialExecAndDescOperators() testing.TestResult {
	var e @[]char = ""
	var src @[]char = ".global v\n"
	src = buf.Concat(src, "adrp x0, :gottprel:v\n")
	src = buf.Concat(src, "ldr x0, [x0, :gottprel_lo12:v]\n")
	src = buf.Concat(src, "str x0, [x0, :gottprel_lo12:v]\n")
	src = buf.Concat(src, "ldr d0, [x0, :gottprel_lo12:v]\n")
	src = buf.Concat(src, "str d0, [x0, #:gottprel_lo12:v]\n")
	src = buf.Concat(src, "prfm pldl1keep, [x0, :gottprel_lo12:v]\n")
	src = buf.Concat(src, "movz x0, #:gottprel_g1:v\n")
	src = buf.Concat(src, "movk x0, #:gottprel_g0_nc:v\n")
	src = buf.Concat(src, "movz w0, #:gottprel_g1:v\n")
	src = buf.Concat(src, "ldr x0, :gottprel:v\n")
	src = buf.Concat(src, "ldr w0, :gottprel:v\n")
	src = buf.Concat(src, "ldr q0, :gottprel:v\n")
	src = buf.Concat(src, "ldrsw x0, #:gottprel:v\n")
	src = buf.Concat(src, "adrp x0, :tlsdesc:v\n")
	src = buf.Concat(src, "ldr x1, [x0, :tlsdesc_lo12:v]\n")
	src = buf.Concat(src, "str x1, [x0, :tlsdesc_lo12:v]\n")
	src = buf.Concat(src, "add x0, x0, :tlsdesc_lo12:v\n")
	src = buf.Concat(src, "add w0, w0, :tlsdesc_lo12:v\n")
	src = buf.Concat(src, "add x0, x0, #:tlsdesc_lo12:v, lsl #12\n")
	src = buf.Concat(src, ".tlsdesccall v\nblr x1\n")
	src = buf.Concat(src, "adrp x0, :tlsdesc_auth:v\n")
	src = buf.Concat(src, "ldr x16, [x0, :tlsdesc_auth_lo12:v]\n")
	src = buf.Concat(src, "add x0, x0, :tlsdesc_auth_lo12:v\n")
	src = buf.Concat(src, ".tlsdesccall v\nlbl:\nblraa x16, x0\n")
	src = buf.Concat(src, "ldr s0, :gottprel:v\n")
	src = buf.Concat(src, "ldr d0, :gottprel:v\n")
	src = buf.Concat(src, "prfm pldl1keep, :gottprel:v\n")
	src = buf.Concat(src, ".tlsdesccall v\n\n// a comment\nblraaz x1\n")
	src = buf.Concat(src, ".tlsdesccall v\nblrab x16, x0\n")
	src = buf.Concat(src, ".tlsdesccall v\nblrabz x1\n")
	var types @[]int = @[]int{541, 542, 542, 542, 542, 542, 539, 540, 539, 543, 543, 543, 543, 562,
			563, 563, 564, 564, 564, 569, 595, 596, 597, 569, 543, 543, 543, 569, 569, 569}
	var hex @[]@[]char = @[]@[]char{"90000000", "F9400000", "F9000000", "FD400000", "FD000000",
			"F9800000", "92A00000", "F2800000", "12A00000", "58000000", "18000000", "9C000000", "98000000",
			"90000000", "F9400001", "F9000001", "91000000", "11000000", "91400000", "D63F0020", "90000000",
			"F9400010", "91000000", "D73F0A00", "1C000000", "5C000000", "D8000000", "D63F083F", "D73F0E00",
			"D63F0C3F"}
	var words @[]char = ""
	var relocs @[]char = ""
	for i := 0; i < len(types); i++ {
		words = buf.Concat(words, buf.Concat(hex[i], " "))
		var one @[]char = buf.Concat(strconv.Itoa(types[i] - 312), "@")
		relocs = buf.Concat(relocs, buf.Concat(buf.Concat(one, strconv.Itoa(4 * i)), ":v "))
	}
	return relocOpCase(e, src, words, relocs)
}

// What clang rejects: a 16- or 4-byte transfer of a slot or descriptor word, ADR with a page
// operator, ADRP with a page offset, `:gottprel_lo12:` on ADD, `:gottprel:` on a branch.  And
// deliberately, where clang accepts: an addend on a slot or descriptor reference (linkers
// disagree on what one means, as for `:got:`); a literal load of a TLS descriptor (clang writes
// a plain literal load, losing the descriptor); and a `.tlsdesccall` not followed by the call
// through a register it marks — another instruction, a directive, a second `.tlsdesccall`, the
// end of the input (clang marks whatever comes next, even past the section's end) — or with an
// operand other than one symbol name.
func TestTlsInitialExecAndDescRejects() testing.TestResult {
	var e @[]char = ""
	var bad @[]@[]char = @[]@[]char{"ldr q0, [x0, :gottprel_lo12:v]",
			"ldrsw x0, [x0, :gottprel_lo12:v]", "ldr w1, [x0, :tlsdesc_lo12:v]", "adr x0, :gottprel:v",
			"adr x0, :tlsdesc:v", "adrp x0, :gottprel_lo12:v", "add x0, x0, :gottprel_lo12:v",
			"b :gottprel:v", "adrp x0, :gottprel:v+8", "ldr x0, [x0, :gottprel_lo12:v+8]",
			"add x0, x0, :tlsdesc_lo12:v+8", "movz x0, #:gottprel_g1:v+4", "ldr x0, :gottprel:v+8",
			"adrp x0, :tlsdesc_auth:v-4", "ldr x1, :tlsdesc:v", "ldr x1, :tlsdesc_auth:v",
			".tlsdesccall v\nnop", ".tlsdesccall v\n.uint32 0", ".tlsdesccall v",
			".tlsdesccall v\n.tlsdesccall v\nblr x1", ".tlsdesccall v+4\nblr x1", ".tlsdesccall\nblr x1",
			".tlsdesccall 5\nblr x1", ".tlsdesccall v\nK = 1\nblr x1", "K = 1\n.tlsdesccall K\nblr x1",
			".tlsdesccall 1f\n1: blr x1"}
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global v\n", bad[i])) }
	return e
}
