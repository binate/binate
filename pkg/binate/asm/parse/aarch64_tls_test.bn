package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// The ELF thread-local operators (aarch64_tls.bn) against clang's words and relocations
// (`clang -c -target aarch64-linux-gnu`, llvm-objdump -d, llvm-readelf -r): each line's word, and
// its relocation, whose ELF type is the fixup kind + 312.  (relocOpCase is in
// aarch64_relocop_test.bn, labelsReject in aarch64_golden_labels_test.bn.)

// The local-exec `:tprel_*:` operators: a MOVZ (or `mov`, at shift 0) with a checked MOVW one is
// written as a MOVN, a MOVK or an _NC keeps its opcode; ADD's HI12 is its `lsl #12` form, on SP
// or a W register too, and an ADD written with '#' takes `lsl #0|#12` as after `:lo12:` (a HI12
// shifted either way); a load / store's page offset by access size (1, 2, 4, 8, 16 bytes),
// PRFM's an 8-byte one; the operator names in any case.
func TestTlsLocalExecOperators() testing.TestResult {
	var e @[]char = ""
	var src @[]char = ".global v\n"
	src = buf.Concat(src, "movz x0, #:tprel_g2:v\n")
	src = buf.Concat(src, "movn x0, #:tprel_g2:v\n")
	src = buf.Concat(src, "movz x0, #:tprel_g1:v\n")
	src = buf.Concat(src, "movk x0, #:tprel_g1_nc:v\n")
	src = buf.Concat(src, "movz w0, #:tprel_g1:v\n")
	src = buf.Concat(src, "movz x0, #:tprel_g0:v\n")
	src = buf.Concat(src, "movk x0, #:tprel_g0_nc:v\n")
	src = buf.Concat(src, "movz x0, #:tprel_g1_nc:v\n")
	src = buf.Concat(src, "movk x0, #:tprel_g1:v\n")
	src = buf.Concat(src, "mov x0, #:tprel_g1:v\n")
	src = buf.Concat(src, "mov x0, #:tprel_g0_nc:v\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_hi12:v\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_lo12:v\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_lo12_nc:v\n")
	src = buf.Concat(src, "add w0, w1, #:tprel_lo12:v\n")
	src = buf.Concat(src, "add sp, x0, :tprel_lo12:v\n")
	src = buf.Concat(src, "add x0, sp, :TPREL_LO12:v\n")
	src = buf.Concat(src, "ldrb w0, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "strb w0, [x0, :tprel_lo12_nc:v]\n")
	src = buf.Concat(src, "ldrsb x0, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "ldr b0, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "ldrh w0, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "ldr w0, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "ldrsw x0, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "ldr x0, [x0, #:tprel_lo12:v]\n")
	src = buf.Concat(src, "ldr x0, [sp, :tprel_lo12_nc:v]\n")
	src = buf.Concat(src, "prfm pldl1keep, [x0, :tprel_lo12:v]\n")
	src = buf.Concat(src, "ldr q0, [x0, :tprel_lo12_nc:v]\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_hi12:v, lsl #12\n")
	src = buf.Concat(src, "add w0, w0, #:tprel_hi12:v, lsl #12\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_hi12:v, lsl #0\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_lo12:v, lsl #12\n")
	src = buf.Concat(src, "add x0, x0, #:tprel_lo12_nc:v, lsl #0\n")
	src = buf.Concat(src, "mov w0, #:tprel_g1:v\n")
	src = buf.Concat(src, "movn x0, #:tprel_g1_nc:v\n")
	var words @[]char = ""
	var relocs @[]char = ""
	var types @[]int = @[]int{544, 544, 545, 546, 545, 547, 548, 546, 545, 545, 548, 549, 550, 551,
			550, 550, 550, 552, 553, 552, 552, 554, 556, 556, 558, 559, 558, 571, 549, 549, 549, 550, 551,
			545, 546}
	var hex @[]@[]char = @[]@[]char{
			"92C00000", "92C00000", "92A00000", "F2A00000", "12A00000", "92800000", "F2800000", "D2A00000",
			"F2A00000", "92800000", "D2800000", "91400000", "91000000", "91000000", "11000020", "9100001F",
			"910003E0", "39400000", "39000000", "39800000", "3D400000", "79400000", "B9400000", "B9800000",
			"F9400000", "F94003E0", "F9800000", "3DC00000", "91400000", "11400000", "91400000", "91400000",
			"91000000", "12800000", "92A00000"}
	for i := 0; i < len(types); i++ {
		words = buf.Concat(words, buf.Concat(hex[i], " "))
		var one @[]char = buf.Concat(strconv.Itoa(types[i] - 312), "@")
		one = buf.Concat(buf.Concat(one, strconv.Itoa(4 * i)), ":v ")
		relocs = buf.Concat(relocs, one)
	}
	return relocOpCase(e, src, words, relocs)
}

// The local-dynamic `:dtprel_*:` operators, as the local-exec ones.
func TestTlsLocalDynamicOperators() testing.TestResult {
	var e @[]char = ""
	var src @[]char = ".global v\n"
	src = buf.Concat(src, "movz x0, #:dtprel_g2:v\n")
	src = buf.Concat(src, "movz x0, #:dtprel_g1:v\n")
	src = buf.Concat(src, "movk x0, #:dtprel_g1_nc:v\n")
	src = buf.Concat(src, "movz x0, #:dtprel_g0:v\n")
	src = buf.Concat(src, "movk x0, #:dtprel_g0_nc:v\n")
	src = buf.Concat(src, "add x0, x0, #:dtprel_hi12:v\n")
	src = buf.Concat(src, "add x0, x0, #:dtprel_lo12:v\n")
	src = buf.Concat(src, "add x0, x0, #:dtprel_lo12_nc:v\n")
	src = buf.Concat(src, "ldrb w0, [x0, :dtprel_lo12:v]\n")
	src = buf.Concat(src, "ldrh w0, [x0, :dtprel_lo12_nc:v]\n")
	src = buf.Concat(src, "ldr w0, [x0, :dtprel_lo12:v]\n")
	src = buf.Concat(src, "ldr x0, [x0, :dtprel_lo12:v]\n")
	src = buf.Concat(src, "ldr x0, [x0, :dtprel_lo12_nc:v]\n")
	src = buf.Concat(src, "ldr q0, [x0, :dtprel_lo12:v]\n")
	src = buf.Concat(src, "str q0, [x0, :dtprel_lo12_nc:v]\n")
	src = buf.Concat(src, "add x0, x0, #:dtprel_hi12:v, lsl #12\n")
	var words @[]char = ""
	var relocs @[]char = ""
	var types @[]int = @[]int{523, 524, 525, 526, 527, 528, 529, 530, 531, 534, 535, 537, 538, 572,
			573, 528}
	var hex @[]@[]char = @[]@[]char{
			"92C00000", "92A00000", "F2A00000", "92800000", "F2800000", "91400000", "91000000", "91000000",
			"39400000", "79400000", "B9400000", "F9400000", "F9400000", "3DC00000", "3D800000", "91400000"}
	for i := 0; i < len(types); i++ {
		words = buf.Concat(words, buf.Concat(hex[i], " "))
		var one @[]char = buf.Concat(strconv.Itoa(types[i] - 312), "@")
		one = buf.Concat(buf.Concat(one, strconv.Itoa(4 * i)), ":v ")
		relocs = buf.Concat(relocs, one)
	}
	return relocOpCase(e, src, words, relocs)
}

// What clang rejects: ADDS / SUB / XZR with a thread-local page offset, a shift after one written
// without '#' or by other than 0 or 12, a HI12 one on a load / store, an unscaled, writeback or
// pair form, G2 on a W register, an `lsl` after a MOVW operator; and a number after one, which
// clang folds on ADD and loads / stores (a deliberate reject, as for every operator but the
// absolute MOVW group) and rejects on a move.
func TestTlsOperatorRejects() testing.TestResult {
	var e @[]char = ""
	var bad @[]@[]char = @[]@[]char{"adds x0, x1, #:tprel_lo12:v", "sub x0, x1, #:tprel_lo12:v",
			"add x0, x0, :tprel_lo12:v, lsl #12", "add x0, x0, :tprel_hi12:v, lsl #0",
			"add xzr, x0, :tprel_lo12:v", "ldr x0, [x0, #:tprel_lo12:v]!", "ldur x0, [x0, #:tprel_lo12:v]",
			"ldp x0, x1, [x0, :tprel_lo12:v]", "ldr x0, [x0, :tprel_hi12:v]", "movz w0, #:tprel_g2:v",
			"movz x0, #:tprel_g2:v, lsl #32", "movz x0, #:tprel_g1:5", "add x0, x0, :tprel_lo12:5",
			"add x0, x0, :dtprel_lo12:5", "add x0, x0, :tprel_lo13:v", "add x0, x0, #:tprel_hi12:v, lsl #4",
			"ldr x0, [x0, :tprel_lo12:8]"}
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global v\n", bad[i])) }
	return e
}
