package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64/isa"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strconv"

// Mach-O's thread-local variable references (`@TLVPPAGE`, `@TLVPPAGEOFF`) against clang's words
// and relocations (`clang -c -target arm64-apple-macos`, llvm-objdump --macho -dr).  (relocOps is
// in aarch64_relocop_test.bn, labelsSource / labelsWordsHex / labelsReject in
// aarch64_golden_labels_test.bn.)

// `@TLVPPAGE` on ADRP and `@TLVPPAGEOFF` on the 64-bit LDR of the descriptor pointer (any case,
// SP as the base), each its isa.FIX_TLVP_LOAD_* fixup against the descriptor.
func TestTlvpOperators() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".global _a\nadrp x0, _a@TLVPPAGE\nldr x0, [x0, _a@TLVPPAGEOFF]\n"
			"adrp x1, _a@tlvppage\nldr x1, [x1, _a@tlvppageoff]\nadrp x2, _a@TLVPPAGE\n"
			"ldr x3, [sp, _a@TLVPPAGEOFF]"
	var p @Parser = labelsSource(src, asm.OBJ_MACHO)
	if p.HasError || p.Asm.HasError {
		return goldenFail(e, src, buf.Concat(buf.Concat("rejected: ", p.ErrorMsg), p.Asm.ErrorMsg))
	}
	var words @[]char = labelsWordsHex(p)
	if !charsEqual(words, "90000000 F9400000 90000001 F9400021 90000002 F94003E3 ") {
		return goldenFail(e, src, buf.Concat("assembled to ", words))
	}
	var page @[]char = strconv.Itoa(isa.FIX_TLVP_LOAD_PAGE21)
	var off @[]char = strconv.Itoa(isa.FIX_TLVP_LOAD_PAGEOFF12)
	var want @[]char = buf.Concat(buf.Concat(page, "@0:_a "), buf.Concat(off, "@4:_a "))
	want = buf.Concat(want, buf.Concat(buf.Concat(page, "@8:_a "), buf.Concat(off, "@12:_a ")))
	want = buf.Concat(want, buf.Concat(buf.Concat(page, "@16:_a "), buf.Concat(off, "@20:_a ")))
	var got @[]char = relocOps(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("relocations ", got)) }
	return e
}

// What clang rejects: an addend, either side of the specifier; ADR; a load with `@TLVPPAGE`, an
// ADRP with `@TLVPPAGEOFF`; a literal load.  And deliberately, where clang accepts: ADD or any
// transfer but the 64-bit LDR with `@TLVPPAGEOFF` (ld64 links no other: "relocation on non-LDR
// instruction", or a 32-bit load rewritten to a 64-bit ADD), and a branch with `@TLVPPAGE` (clang
// drops the specifier and branches to the descriptor).
func TestTlvpOperatorRejects() testing.TestResult {
	var e @[]char = ""
	var bad @[]@[]char = @[]@[]char{"adrp x0, _a@TLVPPAGE+8", "adrp x0, _a+8@TLVPPAGE",
			"ldr x0, [x0, _a@TLVPPAGEOFF+8]", "adr x0, _a@TLVPPAGE", "ldr x0, [x0, _a@TLVPPAGE]",
			"adrp x0, _a@TLVPPAGEOFF", "ldr q0, [x0, _a@TLVPPAGEOFF]", "add x0, x0, _a@TLVPPAGEOFF",
			"ldr w0, [x0, _a@TLVPPAGEOFF]", "b _a@TLVPPAGE", "ldr x0, _a@TLVPPAGE",
			"str x1, [x0, _a@TLVPPAGEOFF]", "ldr d0, [x0, _a@TLVPPAGEOFF]",
			"prfm pldl1keep, [x0, _a@TLVPPAGEOFF]", "ldrsw x0, [x0, _a@TLVPPAGEOFF]"}
	for i := 0; i < len(bad); i++ { e = labelsReject(e, buf.Concat(".global _a\n", bad[i])) }
	return e
}
