package "pkg/binate/asm/parse"

// AArch64 vector register lists: `{Vt.<T>, …}` of one to four registers, each the one
// after the last (V31 is followed by V0), or the range form `{Vt.<T> - Vu.<T>}` naming
// two to four such registers; a list of bare elements may be followed by a lane index
// (`{v0.s, v1.s}[1]`).  Every entry carries the same suffix, compared as written (as
// clang does: `{v1.16B, v2.16b}` is a size mismatch), and a list is either commas or a
// single range, never both.

// vecSuffixSame reports whether two vector-register names carry the same text after
// their '.'.
func vecSuffixSame(a *[]readonly char, b *[]readonly char) bool {
	var da int = vecNameDot(a)
	var db int = vecNameDot(b)
	if len(a) - da != len(b) - db { return false }
	for i := 1; da + i < len(a); i++ {
		if a[da + i] != b[db + i] { return false }
	}
	return true
}

// parseVecListEntry parses one list entry at tok — a vector register with an arrangement
// or bare element, whose suffix must match first's (unless first is empty) — returning
// the token after it, the entry's name and its number.
func parseVecListEntry(p @Parser, l Lexer, tok Token,
		first *[]readonly char) (Lexer, Token, @[]char, int, bool) {
	var name @[]char = tok.Text
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected a vector register in the list")
		return l, tok, name, -1, false
	}
	reg, _, _, ok := parseA64VecReg(name)
	if !ok {
		if isVecRegShaped(name) {
			setErr(p, "invalid vector kind qualifier")
		} else {
			setErr(p, "expected a vector register with an arrangement or element in the list")
		}
		return l, tok, name, -1, false
	}
	if len(first) > 0 && !vecSuffixSame(first, name) {
		setErr(p, "mismatched register size suffix in the list")
		return l, tok, name, -1, false
	}
	l, tok = LexNext(l)
	return l, tok, name, reg, true
}

// parseA64VecList parses a register list (l just after the '{') and an optional lane
// index after it.
func parseA64VecList(p @Parser, l Lexer) (Lexer, Token, a64Item, bool) {
	var it a64Item
	it.Kind = IT_VLIST
	it.Lane = -1
	var tok Token
	l, tok = LexNext(l)
	var first @[]char
	var ok bool = false
	l, tok, first, it.Reg, ok = parseVecListEntry(p, l, tok, "")
	if !ok { return l, tok, it, false }
	_, it.VEl, it.VLanes, _ = parseA64VecReg(first)
	it.VCount = 1
	var reg int = it.Reg
	var ranged bool = tok.Kind == TOK_MINUS
	if ranged {
		l, tok = LexNext(l)
		l, tok, _, reg, ok = parseVecListEntry(p, l, tok, first)
		if !ok { return l, tok, it, false }
		it.VCount = ((reg - it.Reg) & 31) + 1
		if it.VCount < 2 || it.VCount > 4 {
			setErr(p, "a register range names two to four registers")
			return l, tok, it, false
		}
	}
	for !ranged && tok.Kind == TOK_COMMA {
		l, tok = LexNext(l)
		var next int = -1
		l, tok, _, next, ok = parseVecListEntry(p, l, tok, first)
		if !ok { return l, tok, it, false }
		if next != ((reg + 1) & 31) {
			setErr(p, "the registers of a list must be consecutive")
			return l, tok, it, false
		}
		reg = next
		it.VCount = it.VCount + 1
		if it.VCount > 4 {
			setErr(p, "a register list holds at most four registers")
			return l, tok, it, false
		}
	}
	if tok.Kind != TOK_RBRACE {
		setErr(p, "expected '}' to close the register list")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_LBRACKET { return l, tok, it, true }
	if it.VLanes != 0 {
		setErr(p, "a lane index follows a list of bare elements ({v0.s, v1.s}[1])")
		return l, tok, it, false
	}
	l, tok, it.Lane, ok = parseVecLaneIndex(p, l)
	return l, tok, it, ok
}
