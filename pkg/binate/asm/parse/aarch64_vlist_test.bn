package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the vector register-list operand (aarch64_vlist.bn): the comma and range
// forms, wrapping past V31, the lane index after a list of bare elements, and the
// malformed lists.

// vecListCase checks that src scans to one register-list item starting at reg with
// count registers of element size el, lanes lanes (0 for bare elements) and lane lane
// (-1 for none).
func vecListCase(e @[]char, src *[]readonly char, reg int, count int, el int, lanes int,
		lane int) @[]char {
	var it a64Item
	var ok bool = false
	e, it, ok = itemOnlyCheck(e, src, IT_VLIST)
	if !ok { return e }
	if it.Reg != reg || it.VCount != count || it.VEl != el || it.VLanes != lanes || it.Lane != lane {
		return goldenFail(e, src, "wrong fields")
	}
	return e
}

func TestVecListItems() testing.TestResult {
	var e @[]char = ""
	e = vecListCase(e, "{v1.16b}", 1, 1, 0, 16, -1)
	e = vecListCase(e, "{ v1.16b }", 1, 1, 0, 16, -1)
	e = vecListCase(e, "{v31.4s, v0.4s}", 31, 2, 2, 4, -1)
	e = vecListCase(e, "{v1.2d,v2.2d,v3.2d,v4.2d}", 1, 4, 3, 2, -1)
	e = vecListCase(e, "{v1.8h-v2.8h}", 1, 2, 1, 8, -1)
	e = vecListCase(e, "{v30.1d - v1.1d}", 30, 4, 3, 1, -1)
	e = vecListCase(e, "{V1.8b, v2.8b}", 1, 2, 0, 8, -1)
	e = vecListCase(e, "{v0.s, v1.s}[1]", 0, 2, 2, 0, 1)
	e = vecListCase(e, "{v0.b}[15]", 0, 1, 0, 0, 15)
	e = vecListCase(e, "{v0.d-v2.d}[1]", 0, 3, 3, 0, 1)
	e = vecListCase(e, "{v0.4b}", 0, 1, 0, 4, -1)
	e = vecListCase(e, "{v0.s, v1.s} [1]", 0, 2, 2, 0, 1)
	e = itemsRejectCase(e, "{}")
	e = itemsRejectCase(e, "{v1.16b")
	e = itemsRejectCase(e, "{v1.16b,}")
	e = itemsRejectCase(e, "{v1.16b, v3.16b}")
	e = itemsRejectCase(e, "{v1.16b, v2.8b}")
	e = itemsRejectCase(e, "{v1.16B, v2.16b}")
	e = itemsRejectCase(e, "{v1.16b-v2.16B}")
	e = itemsRejectCase(e, "{v1.16b-v1.16b}")
	e = itemsRejectCase(e, "{v2.16b-v1.16b}")
	e = itemsRejectCase(e, "{v1.16b-v5.16b}")
	e = itemsRejectCase(e, "{v1.16b-v2.16b, v3.16b}")
	e = itemsRejectCase(e, "{v1.16b, v2.16b-v3.16b}")
	e = itemsRejectCase(e, "{v1.s, v2.s, v3.s, v4.s, v5.s}")
	e = itemsRejectCase(e, "{v1, v2}")
	e = itemsRejectCase(e, "{q1}")
	e = itemsRejectCase(e, "{v1.3s}")
	e = itemsRejectCase(e, "{v1.4s}[1]")
	e = itemsRejectCase(e, "{v1.s}[16]")
	e = itemsRejectCase(e, "{v1.s}[1")
	return e
}

func TestVecSuffixSame() testing.TestResult {
	if !vecSuffixSame("v1.16b", "v30.16b") { return fail("v1.16b / v30.16b") }
	if !vecSuffixSame("V1.s", "v2.s") { return fail("V1.s / v2.s") }
	if vecSuffixSame("v1.16B", "v2.16b") { return fail("case differs") }
	if vecSuffixSame("v1.16b", "v2.8b") { return fail("sizes differ") }
	if vecSuffixSame("v1.4s", "v2.4s4") { return fail("longer suffix") }
	return ""
}

// A register list is an operand only of the instructions that take one; elsewhere it is
// rejected (as by clang).
func TestVecListContexts() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "umov w0, {v1.s}[1]")
	e = goldenReject(e, "dup v0.4s, {v1.s}[1]")
	e = goldenReject(e, "mov v0.16b, {v1.16b}")
	e = goldenReject(e, "add x0, x1, {v2.16b}")
	e = goldenReject(e, "b {v1.16b}")
	return e
}
