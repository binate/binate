package "pkg/binate/asm/parse"

// AArch64 vector-register operands: `vN.<T>` with an arrangement <T> — a lane count and
// element letter: 8b 16b 4h 8h 2s 4s 1d 2d 1q, and the partial 2b / 4b / 2h — or `vN.<t>`
// with a bare element letter (b h s d).  A bare element, and a partial arrangement,
// may be followed by a lane index `[i]`: the partial arrangements name an indexed group
// of elements (SDOT / UDOT's `v2.4b[3]`, BFDOT's `v2.2h[3]`, the FP8 FDOT's `v2.2b[3]`),
// and `.2h` is also the FP16 pairwise-reduction source (`faddp h0, v1.2h`).  The lexer
// takes `v0.4s` / `v0.s` as one identifier (a '.' may follow a symbol's first
// character).  Any name of the form `vN.<suffix>` with N 0..31 is a vector register,
// never a symbol, so an unknown suffix (`v0.3s`) is an error.

// vecElemOf maps an element letter (either case) to its size, 0..4 for B / H / S / D / Q,
// or -1.
func vecElemOf(c char) int {
	var l char = lowerChar(c)
	if l == 'b' { return 0 }
	if l == 'h' { return 1 }
	if l == 's' { return 2 }
	if l == 'd' { return 3 }
	if l == 'q' { return 4 }
	return -1
}

// vecLanesValid reports whether lanes × element size el is an arrangement the
// architecture names (lanes 0 is a bare element, which exists for B / H / S / D).
func vecLanesValid(el int, lanes int) bool {
	if lanes == 0 { return el <= 3 }
	if el == 0 { return lanes == 2 || lanes == 4 || lanes == 8 || lanes == 16 }
	if el == 1 { return lanes == 2 || lanes == 4 || lanes == 8 }
	if el == 2 { return lanes == 2 || lanes == 4 }
	if el == 3 { return lanes == 1 || lanes == 2 }
	return lanes == 1
}

// vecPartialArr reports whether lanes × element size el is a partial arrangement (2b,
// 4b, 2h), the ones that may take a lane index.
func vecPartialArr(el int, lanes int) bool {
	return (el == 0 && (lanes == 2 || lanes == 4)) || (el == 1 && lanes == 2)
}

// vecNameDot returns the index of the '.' in name when the text before it is a vector
// register name (v0..v31, either case, no leading zero), or -1.
func vecNameDot(name *[]readonly char) int {
	var dot int = 0
	for dot < len(name) && name[dot] != '.' { dot = dot + 1 }
	if dot >= len(name) || lowerChar(name[0]) != 'v' || regIndexSuffix(name[0:dot], 31) < 0 {
		return -1
	}
	return dot
}

// isVecRegShaped reports whether name is `vN.<suffix>` with N 0..31 — a vector register
// whatever the suffix, so never a symbol.
func isVecRegShaped(name *[]readonly char) bool {
	return vecNameDot(name) >= 0
}

// parseA64VecReg parses name as a vector register with an arrangement or bare element,
// returning its number, element size, lane count (0 for a bare element) and ok.  A
// plain `vN` is not one (parseA64Reg classifies it).
func parseA64VecReg(name *[]readonly char) (int, int, int, bool) {
	var dot int = vecNameDot(name)
	if dot < 0 || dot >= len(name) - 1 { return -1, 0, 0, false }
	var reg int = regIndexSuffix(name[0:dot], 31)
	var i int = dot + 1
	var lanes int = 0
	for i < len(name) && isDigit(name[i]) {
		if lanes > 16 { return -1, 0, 0, false }
		lanes = lanes * 10 + cast(int, name[i]) - cast(int, '0')
		i = i + 1
	}
	if i != len(name) - 1 || (i > dot + 1 && name[dot + 1] == '0') { return -1, 0, 0, false }
	var el int = vecElemOf(name[i])
	if el < 0 || !vecLanesValid(el, lanes) { return -1, 0, 0, false }
	return reg, el, lanes, true
}

// parseA64VecItem finishes a vector-register item (its name just scanned, l after it):
// a bare element or a partial arrangement may take a lane index `[i]` (0..15; the
// instruction checks it against the element size), a full arrangement may not.
func parseA64VecItem(p @Parser, l Lexer, reg int, el int, lanes int) (Lexer, Token, a64Item, bool) {
	var it a64Item
	it.Kind = IT_VREG
	it.Reg = reg
	it.VEl = el
	it.VLanes = lanes
	it.Lane = -1
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_LBRACKET { return l, tok, it, true }
	if lanes != 0 && !vecPartialArr(el, lanes) {
		setErr(p, "a lane index follows a bare element (v0.s[1], not v0.4s[1])")
		return l, tok, it, false
	}
	var ok bool = false
	l, tok, it.Lane, ok = parseVecLaneIndex(p, l)
	return l, tok, it, ok
}

// parseVecLaneIndex parses a lane index's expression and closing ']' (l just after the
// '['), returning the token after it and the index, 0..15 (the instruction checks it
// against the element size).
func parseVecLaneIndex(p @Parser, l Lexer) (Lexer, Token, int, bool) {
	var tok Token
	l, tok = LexNext(l)
	var idx int64 = 0
	var ok bool = false
	l, tok, idx, ok = parseExprValue(p, l, tok)
	if !ok { return l, tok, -1, false }
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "expected ']' after the lane index")
		return l, tok, -1, false
	}
	if idx < 0 || idx > 15 {
		setErr(p, "vector lane index out of range")
		return l, tok, -1, false
	}
	l, tok = LexNext(l)
	return l, tok, cast(int, idx), true
}
