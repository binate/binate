package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Tests for the vector-register operand syntax (aarch64_vreg.bn): arrangements, bare
// elements, lane indices, and the names that are not vector registers.

// vecRegCase checks that name parses as vector register reg with element size el and
// lanes lanes.
func vecRegCase(e @[]char, name *[]readonly char, reg int, el int, lanes int) @[]char {
	r, gotEl, gotLanes, ok := parseA64VecReg(name)
	if !ok { return goldenFail(e, name, "not parsed as a vector register") }
	if r != reg || gotEl != el || gotLanes != lanes { return goldenFail(e, name, "wrong fields") }
	return e
}

// vecRegNotCase checks that name is not a vector register with an arrangement or element.
func vecRegNotCase(e @[]char, name *[]readonly char) @[]char {
	_, _, _, ok := parseA64VecReg(name)
	if ok { return goldenFail(e, name, "parsed as a vector register") }
	return e
}

func TestVecRegNames() testing.TestResult {
	var e @[]char = ""
	e = vecRegCase(e, "v0.4s", 0, 2, 4)
	e = vecRegCase(e, "V31.16B", 31, 0, 16)
	e = vecRegCase(e, "v9.8b", 9, 0, 8)
	e = vecRegCase(e, "v2.2b", 2, 0, 2)
	e = vecRegCase(e, "v2.4b", 2, 0, 4)
	e = vecRegCase(e, "v3.2h", 3, 1, 2)
	e = vecRegCase(e, "v3.4h", 3, 1, 4)
	e = vecRegCase(e, "v3.8H", 3, 1, 8)
	e = vecRegCase(e, "v4.2s", 4, 2, 2)
	e = vecRegCase(e, "v7.1d", 7, 3, 1)
	e = vecRegCase(e, "v7.2d", 7, 3, 2)
	e = vecRegCase(e, "v1.1q", 1, 4, 1)
	e = vecRegCase(e, "v5.b", 5, 0, 0)
	e = vecRegCase(e, "v5.h", 5, 1, 0)
	e = vecRegCase(e, "v5.S", 5, 2, 0)
	e = vecRegCase(e, "v5.d", 5, 3, 0)
	e = vecRegNotCase(e, "v0")
	e = vecRegNotCase(e, "v0.")
	e = vecRegNotCase(e, "v.4s")
	e = vecRegNotCase(e, "v32.4s")
	e = vecRegNotCase(e, "x0.4s")
	e = vecRegNotCase(e, "q0.4s")
	e = vecRegNotCase(e, "v0.3s")
	e = vecRegNotCase(e, "v0.8s")
	e = vecRegNotCase(e, "v0.04s")
	e = vecRegNotCase(e, "v0.32b")
	e = vecRegNotCase(e, "v0.4d")
	e = vecRegNotCase(e, "v0.2q")
	e = vecRegNotCase(e, "v0.q")
	e = vecRegNotCase(e, "v0.4x")
	e = vecRegNotCase(e, "v0.4s4")
	e = vecRegNotCase(e, "v0.s.4s")
	e = vecRegNotCase(e, "v0.100000000000000000000b")
	return e
}

func TestVecRegShaped() testing.TestResult {
	if !isVecRegShaped("v0.4s") { return fail("v0.4s") }
	if !isVecRegShaped("V31.foo") { return fail("V31.foo") }
	if !isVecRegShaped("v0.") { return fail("v0.") }
	if !isVecRegShaped("v0.4s.x") { return fail("v0.4s.x") }
	if isVecRegShaped("v0") { return fail("v0 without a suffix") }
	if isVecRegShaped("v32.4s") { return fail("v32.4s") }
	if isVecRegShaped("v01.4s") { return fail("v01.4s") }
	if isVecRegShaped("q0.4s") { return fail("q0.4s") }
	if isVecRegShaped("v.4s") { return fail("v.4s") }
	return ""
}

// vecItemCase checks that src scans to one vector-register item with lane lane (-1 for
// none).
func vecItemCase(e @[]char, src *[]readonly char, reg int, lanes int, lane int) @[]char {
	var it a64Item
	var ok bool = false
	e, it, ok = itemOnlyCheck(e, src, IT_VREG)
	if !ok { return e }
	if it.Reg != reg || it.VLanes != lanes || it.Lane != lane {
		return goldenFail(e, src, "wrong fields")
	}
	return e
}

func TestVecRegItems() testing.TestResult {
	var e @[]char = ""
	e = vecItemCase(e, "v1.4s", 1, 4, -1)
	e = vecItemCase(e, "v1.s", 1, 0, -1)
	e = vecItemCase(e, "v1.s[3]", 1, 0, 3)
	e = vecItemCase(e, "v30.b[15]", 30, 0, 15)
	e = vecItemCase(e, "v2.d[0]", 2, 0, 0)
	e = vecItemCase(e, "v2.d[1 - 1]", 2, 0, 0)
	e = vecItemCase(e, "v2.4b", 2, 4, -1)
	e = vecItemCase(e, "v2.4b[3]", 2, 4, 3)
	e = vecItemCase(e, "v2.2h[1]", 2, 2, 1)
	e = vecItemCase(e, "v2.2b[7]", 2, 2, 7)
	e = itemsRejectCase(e, "v1.4s[1]")
	e = itemsRejectCase(e, "v1.8b[1]")
	e = itemsRejectCase(e, "v1.2s[1]")
	e = itemsRejectCase(e, "v1.3s")
	e = itemsRejectCase(e, "v1.foo")
	e = itemsRejectCase(e, "v1.s[16]")
	e = itemsRejectCase(e, "v1.s[-1]")
	e = itemsRejectCase(e, "v1.s[1")
	e = itemsRejectCase(e, "v1.s[]")
	e = itemsRejectCase(e, "v1.s[1]]")
	return e
}

// A `vN.<suffix>` name is a vector register wherever an operand is parsed — branch
// targets, literal loads, immediates — so clang's "invalid vector kind qualifier" and
// "expected label" rejects hold here too; a name that is not a vector register (v32,
// v01, q0) with a dotted suffix is still a symbol.
func TestVecRegNameContexts() testing.TestResult {
	var e @[]char = ""
	e = goldenReject(e, "b v0.3s")
	e = goldenReject(e, "b v0.foo")
	e = goldenReject(e, "b v0.")
	e = goldenReject(e, "b v0.4s")
	e = goldenReject(e, "b V0.4S")
	e = goldenReject(e, "b v0.2b")
	e = goldenReject(e, "bl v0.q")
	e = goldenReject(e, "b v0.4s.x")
	e = goldenReject(e, "b v0.s[1]")
	e = goldenReject(e, "cbz x0, v1.3s")
	e = goldenReject(e, "add x0, x0, v1.3s")
	e = goldenReject(e, "ldr x0, v1.b")
	e = goldenReject(e, "ldr x0, v1.3s")
	e = goldenReject(e, "ldr x0, v0.2d")
	e = goldenReject(e, "prfm pldl1keep, v1.s")
	e = goldenWord(e, "b v32.4s", 0x14000000)
	e = goldenWord(e, "b v01.4s", 0x14000000)
	e = goldenWord(e, "b q0.4s", 0x14000000)
	e = goldenWord(e, "ldr x0, v32.b", 0x58000000)
	return e
}
