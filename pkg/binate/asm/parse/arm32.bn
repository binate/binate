package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// --- ARM32 register parsing ---

// parseArm32Reg returns the register name names, in any case, as clang reads ARM register names:
// r0 .. r15 (no leading zero), the APCS names a1 .. a4 (r0 .. r3), v1 .. v8 (r4 .. r11), sb (r9),
// sl (r10), fp (r11), ip (r12), sp, lr and pc; or -1.
func parseArm32Reg(name *[]readonly char) int {
	if len(name) < 2 || len(name) > 3 { return -1 }
	var c0 char = arm32Lower(name[0])
	var c1 char = arm32Lower(name[1])
	if len(name) == 3 {
		// r10 .. r15
		if c0 != 'r' || c1 != '1' || name[2] < '0' || name[2] > '5' { return -1 }
		return 10 + cast(int, name[2]) - cast(int, '0')
	}
	if c0 == 'r' && c1 >= '0' && c1 <= '9' { return cast(int, c1) - cast(int, '0') }
	if c0 == 'a' && c1 >= '1' && c1 <= '4' { return cast(int, c1) - cast(int, '1') }
	if c0 == 'v' && c1 >= '1' && c1 <= '8' { return cast(int, c1) - cast(int, '1') + 4 }
	if c0 == 's' && c1 == 'p' { return arm32.SP }
	if c0 == 'l' && c1 == 'r' { return arm32.LR }
	if c0 == 'p' && c1 == 'c' { return arm32.PC }
	if c0 == 'f' && c1 == 'p' { return arm32.FP }
	if c0 == 'i' && c1 == 'p' { return arm32.IP }
	if c0 == 's' && c1 == 'b' { return 9 }
	if c0 == 's' && c1 == 'l' { return 10 }
	return -1
}

// arm32Lower returns the ASCII letter c in lower case, any other byte as it is.
func arm32Lower(c char) char {
	if c >= 'A' && c <= 'Z' { return c + 32 }
	return c
}

// arm32OneCase reports whether the letters of name are all lower case or all upper case, as
// clang needs a memory operand's shift name.
func arm32OneCase(name *[]readonly char) bool {
	var lower bool = false
	var upper bool = false
	for i := 0; i < len(name); i++ {
		if name[i] >= 'a' && name[i] <= 'z' { lower = true }
		if name[i] >= 'A' && name[i] <= 'Z' { upper = true }
	}
	return !(lower && upper)
}

// parseArm32ShiftKind parses a shift keyword, in any case: lsl (asl, as clang takes it), lsr,
// asr, ror or rrx.
func parseArm32ShiftKind(name *[]readonly char) int {
	if mnemIs(name, "lsl") || mnemIs(name, "asl") { return arm32.LSL }
	if mnemIs(name, "lsr") { return arm32.LSR }
	if mnemIs(name, "asr") { return arm32.ASR }
	if mnemIs(name, "ror") { return arm32.ROR }
	if mnemIs(name, "rrx") { return arm32.RRX }
	return -1
}

// parseArm32CondCode parses a condition code name.
func parseArm32CondCode(name *[]readonly char) int {
	if mnemIs(name, "eq") { return arm32.COND_EQ }
	if mnemIs(name, "ne") { return arm32.COND_NE }
	if mnemIs(name, "cs") { return arm32.COND_CS }
	if mnemIs(name, "hs") { return arm32.COND_HS }
	if mnemIs(name, "cc") { return arm32.COND_CC }
	if mnemIs(name, "lo") { return arm32.COND_LO }
	if mnemIs(name, "mi") { return arm32.COND_MI }
	if mnemIs(name, "pl") { return arm32.COND_PL }
	if mnemIs(name, "vs") { return arm32.COND_VS }
	if mnemIs(name, "vc") { return arm32.COND_VC }
	if mnemIs(name, "hi") { return arm32.COND_HI }
	if mnemIs(name, "ls") { return arm32.COND_LS }
	if mnemIs(name, "ge") { return arm32.COND_GE }
	if mnemIs(name, "lt") { return arm32.COND_LT }
	if mnemIs(name, "gt") { return arm32.COND_GT }
	if mnemIs(name, "le") { return arm32.COND_LE }
	if mnemIs(name, "al") { return arm32.COND_AL }
	return -1
}

// --- ARM32 operand parsing ---

// parseArm32Imm parses #expr and returns the immediate value.  On a host whose int is
// narrower than the value, a 32-bit pattern (up to 2^32 - 1) passes as that pattern, as
// arm32.Imm reads it, and anything wider is an error — never truncated by the cast.
func parseArm32Imm(p @Parser, l Lexer) (Lexer, Token, arm32.Operand) {
	var tok Token
	l, tok = LexNext(l) // consume #, get expr start
	var result ExprResult
	l, tok, result = ParseExpr(p, l, tok)
	if !result.Ok {
		setErr(p, exprErr(result, "invalid immediate expression"))
	}
	return l, tok, arm32ImmOf(p, result.Val)
}

// arm32ImmPrefix reports whether tok is an immediate's prefix, `#` or a lone `$` (which clang
// takes wherever it takes `#`), and returns the lexer after it (where parseArm32Imm, which lexes
// the expression's first token, starts).  `$4` lexes as a name (a `$` starts one before a letter
// or digit); with names — where clang reads `$4` as `$` and then 4: a data-processing operand,
// its shift amount, a pre-indexed memory offset and its shift amount — it is a prefix too.
func arm32ImmPrefix(l Lexer, tok Token, names bool) (Lexer, bool) {
	if tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR { return l, true }
	if names && tok.Kind == TOK_IDENT && len(tok.Text) > 1 && tok.Text[0] == '$' {
		// The name's `$` is byte tok.Col - 1 of the line (a column counts one per byte).
		var after Lexer = l
		after.Pos = tok.Col
		after.Col = tok.Col + 1
		return after, true
	}
	return l, false
}

// arm32ImmOf is the immediate operand of the value v (parseArm32Imm): on a host whose
// int is narrower than v, a 32-bit pattern passes as that pattern, and anything wider is
// an error.
func arm32ImmOf(p @Parser, v int64) arm32.Operand {
	if !intFits(v) {
		if v < -2147483648 || v > 4294967295 {
			setErr(p, "immediate out of range")
			return arm32.Imm(0)
		}
		v = cast(int64, cast(int32, v & 0xFFFFFFFF))
	}
	return arm32.Imm(cast(int, v))
}

// arm32IntOf is v as an int, or, when it does not fit the host's int, an error naming
// what (rather than a value truncated by the cast; the encoder checks its own range).
func arm32IntOf(p @Parser, v int64, what *[]readonly char) (int, bool) {
	if !intFits(v) {
		setErr(p, buf.Concat(what, " out of range"))
		return 0, false
	}
	return cast(int, v), true
}

// parseArm32Operand parses a single ARM32 operand.  An immediate takes `#` or `$` (or neither,
// before a number), and a data-processing instruction's `imm8, rot` writes its rotation out,
// either part with or without its prefix (`#255, #2`, `255, 2`), as clang takes them; a
// constant's name is the immediate it stands for (marked Parser.Arm32ImmName).  An immediate a
// label difference decides is marked (Parser.Arm32ImmDiff), as clang leaves it to a fixup
// (arm32ImmFor), and may not be a rotation or a shift amount.
// Returns: lexer, next token, operand, register number (or -1).
func parseArm32Operand(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32.Operand, int) {
	var immL Lexer
	var prefixed bool
	immL, prefixed = arm32ImmPrefix(l, tok, p.Arm32DataProc)
	if prefixed || startsNumericExpr(tok) || tok.Kind == TOK_IDENT && arm32ImmName(p, tok.Text) {
		var named bool = !prefixed && tok.Kind == TOK_IDENT
		var op arm32.Operand
		var r ExprResult
		if prefixed {
			var t Token
			immL, t = LexNext(immL)
			l, tok, r = ParseExpr(p, immL, t)
		} else {
			l, tok, r = parseSymExpr(p, l, tok)
			if r.Ok && len(r.Sym) > 0 {
				// A label expression starting with a number or '(' (`4+lbl`, `(lbl+4)`).
				if !intFits(r.Val) {
					setErr(p, "label addend out of range")
					return l, tok, arm32.Imm(0), -1
				}
				return l, tok, arm32.LabelAddend(r.Sym, cast(int, r.Val)), -1
			}
		}
		if !r.Ok {
			setErr(p, exprErr(r, "invalid immediate expression"))
			return l, tok, arm32.Imm(0), -1
		}
		op = arm32ImmOf(p, r.Val)
		if r.FromDiff { p.Arm32ImmDiff = true }
		// `imm8, rot`, a data-processing immediate's: what follows the comma is the rotation,
		// prefixed or not, as clang reads it.
		if tok.Kind == TOK_COMMA && p.Arm32DataProc {
			if r.FromDiff {
				setErr(p, "too many operands for instruction")
				return l, tok, arm32.Imm(0), -1
			}
			var l2 Lexer
			var t2 Token
			l2, t2 = LexNext(l)
			var rotL Lexer
			var rotPrefixed bool
			rotL, rotPrefixed = arm32ImmPrefix(l2, t2, true)
			if rotPrefixed { l2, t2 = LexNext(rotL) }
			var rot ExprResult
			l2, t2, rot = ParseExpr(p, l2, t2)
			if !rot.Ok || rot.FromDiff {
				setErr(p, exprErr(rot, "constant expression expected"))
				return l2, t2, arm32.Imm(0), -1
			}
			var r8 int
			var rr int
			var fits bool
			r8, fits = arm32IntOf(p, r.Val, "immediate")
			if !fits { return l2, t2, arm32.Imm(0), -1 }
			rr, fits = arm32IntOf(p, rot.Val, "rotation")
			if !fits { return l2, t2, arm32.Imm(0), -1 }
			return l2, t2, arm32.ImmRot(r8, rr), -1
		}
		if named { p.Arm32ImmName = true }
		return l, tok, op, -1
	}

	// [memory]
	if tok.Kind == TOK_LBRACKET {
		var l2 Lexer = l
		var tok2 Token
		var op arm32.Operand
		l2, tok2, op = parseArm32MemOperand(p, l)
		return l2, tok2, op, -1
	}

	// Register or label
	if tok.Kind == TOK_IDENT {
		var reg int = parseArm32Reg(tok.Text)
		if reg >= 0 {
			l, tok = LexNext(l)
			// Check for shifted register: reg, shift #n
			if tok.Kind == TOK_COMMA {
				var l2 Lexer = l
				var tok2 Token
				l2, tok2 = LexNext(l2)
				if tok2.Kind == TOK_IDENT {
					var sk int = parseArm32ShiftKind(tok2.Text)
					if sk >= 0 {
						if sk == arm32.RRX {
							// RRX has no amount; it is its own shift kind (a ROR by 0 is
							// the plain register, not RRX).
							l2, tok2 = LexNext(l2)
							return l2, tok2, arm32.RegShift(reg, arm32.RRX, 0), reg
						}
						l2, tok2 = LexNext(l2)
						var amtL Lexer
						var amtPrefixed bool
						amtL, amtPrefixed = arm32ImmPrefix(l2, tok2, p.Arm32DataProc)
						if amtPrefixed {
							amtL, tok2 = LexNext(amtL)
							var amt ExprResult
							l2, tok2, amt = ParseExpr(p, amtL, tok2)
							if !amt.Ok {
								setErr(p, exprErr(amt, "invalid shift amount"))
								return l2, tok2, arm32.Imm(0), -1
							}
							if amt.FromDiff {
								setErr(p, "invalid immediate shift value")
								return l2, tok2, arm32.Imm(0), -1
							}
							var n int
							var fits bool
							n, fits = arm32IntOf(p, amt.Val, "shift amount")
							if !fits { return l2, tok2, arm32.Imm(0), -1 }
							return l2, tok2, arm32.RegShift(reg, sk, n), reg
						}
						// Could be register-shifted: Rm, shift Rs
						if tok2.Kind == TOK_IDENT {
							var rs int = parseArm32Reg(tok2.Text)
							if rs >= 0 {
								l2, tok2 = LexNext(l2)
								return l2, tok2, arm32.RegSReg(reg, sk, rs), reg
							}
						}
					}
				}
			}
			return l, tok, arm32.Reg(reg), reg
		}
		// Must be a label, with an optional addend.
		var name @[]char
		var addend int = 0
		var ok bool = false
		l, tok, name, addend, ok = parseArm32LabelRef(p, l, tok)
		if !ok { return l, tok, arm32.Imm(0), -1 }
		return l, tok, arm32.LabelAddend(name, addend), -1
	}

	// `.±N`: the location N bytes from this instruction, as a PC-relative memory
	// operand (PC reads this instruction + 8), as clang takes `ldr r0, .+12`.
	if tok.Kind == TOK_DOT {
		var r ExprResult
		l, tok, r = parseSymExpr(p, l, tok)
		if !r.Ok || !r.Dot || !intFits(r.Val) {
			setErr(p, exprErr(r, "invalid location operand"))
			return l, tok, arm32.Imm(0), -1
		}
		return l, tok, arm32.MemImm(arm32.PC, cast(int, r.Val) - 8), -1
	}

	setErr(p, "expected operand")
	return l, tok, arm32.Imm(0), -1
}

// arm32ImmName reports whether an operand starting with the name name is an immediate: a
// constant whose value is a number (arm32NamesNumber), or, in a data-processing instruction, any
// name but a register's -- an expression clang leaves to a fixup when it is a label difference
// (`add r0, r1, l2 - l1`), and a label operand when it is a location.
func arm32ImmName(p @Parser, name *[]readonly char) bool {
	if arm32NamesNumber(p, name) { return true }
	return p.Arm32DataProc && parseArm32Reg(name) < 0
}

// arm32NamesNumber reports whether name is a constant whose value is a number (not an alias of
// a location), which an operand reads as that immediate.
func arm32NamesNumber(p @Parser, name *[]readonly char) bool {
	if parseArm32Reg(name) >= 0 { return false }
	var i int = constIndex(p, name)
	return i >= 0 && len(p.ConstSyms[i]) == 0
}

// --- ARM32 instruction parser helpers ---

// expectArm32CommaOp parses comma then operand.
func expectArm32CommaOp(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32.Operand) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, arm32.Imm(0)
	}
	l, tok = LexNext(l)
	var op arm32.Operand
	l, tok, op, _ = parseArm32Operand(p, l, tok)
	return l, tok, op
}

// expectArm32CommaReg parses comma then register.
func expectArm32CommaReg(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected register")
		return l, tok, -1
	}
	var reg int = parseArm32Reg(tok.Text)
	if reg < 0 {
		setErr(p, "expected register")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	return l, tok, reg
}

// expectArm32CommaImm parses MOVW / MOVT's `, imm` (tok the comma) and returns the value: `#`
// or `$` before it or neither, a constant's name too, as clang takes them.  A label difference
// is an error, as clang leaves it to a fixup these instructions take only as `:lower16:` /
// `:upper16:`; so is a value that does not fit the host's int (rather than truncated by the
// cast).  The encoder checks its own range.
func expectArm32CommaImm(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, 0
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR { l, tok = LexNext(l) }
	var result ExprResult
	l, tok, result = ParseExpr(p, l, tok)
	if !result.Ok {
		setErr(p, exprErr(result, "invalid immediate"))
		return l, tok, 0
	}
	if result.FromDiff {
		setErr(p, "immediate expression for mov requires :lower16: or :upper16")
		return l, tok, 0
	}
	if !intFits(result.Val) {
		setErr(p, "immediate out of range")
		return l, tok, 0
	}
	return l, tok, cast(int, result.Val)
}

// parseArm32RegList parses the contents of {r0, r1, r2-r7, ...}
// after the opening { has been consumed. Returns the register bitmask.
func parseArm32RegList(p @Parser, l Lexer) (Lexer, Token, int) {
	var tok Token
	l, tok = LexNext(l)
	var mask int = 0
	for {
		if tok.Kind != TOK_IDENT {
			setErr(p, "expected register in register list")
			return l, tok, 0
		}
		var reg int = parseArm32Reg(tok.Text)
		if reg < 0 {
			setErr(p, "invalid register in list")
			return l, tok, 0
		}
		l, tok = LexNext(l)
		// Check for range: r0-r7
		if tok.Kind == TOK_MINUS {
			l, tok = LexNext(l)
			if tok.Kind != TOK_IDENT {
				setErr(p, "expected register after '-'")
				return l, tok, 0
			}
			var endReg int = parseArm32Reg(tok.Text)
			if endReg < 0 || endReg < reg {
				setErr(p, "invalid register range")
				return l, tok, 0
			}
			for r := reg; r <= endReg; r++ {
				mask = mask | (1 << r)
			}
			l, tok = LexNext(l)
		} else {
			mask = mask | (1 << reg)
		}
		if tok.Kind == TOK_COMMA {
			l, tok = LexNext(l)
			continue
		}
		break
	}
	if tok.Kind != TOK_RBRACE {
		setErr(p, "expected '}' to close register list")
	}
	l, tok = LexNext(l)
	return l, tok, mask
}
