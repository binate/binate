package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"

// arm32ShiftAliasKind returns the shift a shift instruction names -- `lsl`,
// `lsr`, `asr`, `ror` or `rrx`, each an alias of MOV with a shifted register --
// or -1 when baseMnem is none of them.
func arm32ShiftAliasKind(baseMnem *[]readonly char) int {
	if mnemIs(baseMnem, "lsl") { return arm32.LSL }
	if mnemIs(baseMnem, "lsr") { return arm32.LSR }
	if mnemIs(baseMnem, "asr") { return arm32.ASR }
	if mnemIs(baseMnem, "ror") { return arm32.ROR }
	if mnemIs(baseMnem, "rrx") { return arm32.RRX }
	return -1
}

// parseArm32ShiftAlias assembles a shift instruction (arm32ShiftAliasKind), as
// clang takes it: `lsl` / `lsr` / `asr` / `ror` Rd, Rm, #amount or Rd, Rm, Rs,
// and the two-operand forms with Rm = Rd (`lsl r0, #3`, `lsr r2, r3`); `rrx`
// Rd, Rm.  The amount's '#' is optional, and a constant's name is the amount it stands
// for.  tok is the token after Rd; reports
// whether baseMnem was a shift instruction (it is then assembled, or the error
// set).
func parseArm32ShiftAlias(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		setFlags bool, rd int) bool {
	var sk int = arm32ShiftAliasKind(baseMnem)
	if sk < 0 { return false }
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return true
	}
	l, tok = LexNext(l)
	var rm int = rd
	if tok.Kind == TOK_IDENT && !arm32NamesNumber(p, tok.Text) {
		var r int = parseArm32Reg(tok.Text)
		if r < 0 {
			setErr(p, "expected register")
			return true
		}
		l, tok = LexNext(l)
		if sk == arm32.RRX {
			if arm32AtEOL(p, tok) { arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegShift(r, arm32.RRX, 0)) }
			return true
		}
		if tok.Kind != TOK_COMMA {
			// The two-operand register form `op Rd, Rs`: Rd shifted by Rs.
			if arm32AtEOL(p, tok) && arm32ShiftRegsOk(p, rd, rd, r) {
				arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegSReg(rd, sk, r))
			}
			return true
		}
		rm = r
		l, tok = LexNext(l)
		if tok.Kind == TOK_IDENT && !arm32NamesNumber(p, tok.Text) {
			// `op Rd, Rm, Rs`
			var rs int = parseArm32Reg(tok.Text)
			if rs < 0 {
				setErr(p, "expected register")
				return true
			}
			l, tok = LexNext(l)
			if arm32AtEOL(p, tok) && arm32ShiftRegsOk(p, rd, rm, rs) {
				arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegSReg(rm, sk, rs))
			}
			return true
		}
	} else if sk == arm32.RRX {
		setErr(p, "expected register")
		return true
	}
	// The amount: `op Rd, Rm, #n` or the two-operand `op Rd, #n`.
	var amt ExprResult
	l, tok, amt = parseArm32OperandExpr(p, l, tok)
	if !amt.Ok {
		setErr(p, exprErr(amt, "invalid shift amount"))
		return true
	}
	if amt.FromDiff {
		// clang leaves a label difference to a fixup, which a shift amount has none of.
		setErr(p, "invalid immediate shift value")
		return true
	}
	if !arm32AtEOL(p, tok) { return true }
	var n int
	var fits bool
	n, fits = arm32IntOf(p, amt.Val, "shift amount")
	if fits { arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegShift(rm, sk, n)) }
	return true
}

// arm32ImmAlt returns the instruction clang assembles in place of baseMnem (with the S flag when
// setFlags) when op is an immediate with no rotated encoding: MOV of a 16-bit value is MOVW
// ("movw"; there is no MOVWS) where the architecture has it (movw: ARMv6T2); MOV / MVN, AND / BIC
// and ADC / SBC swap with the immediate's bitwise complement, and ADD / SUB and CMP / CMN with its
// negation, when that encodes (`mov r0, #-1` is `mvn r0, #0`, `add r0, r1, #-4` is `sub r0, r1,
// #4`) -- with the same result and flags, but MOV / MVN and CMP / CMN not with reg (their Rd, Rn)
// SP or PC, as clang has them.  Otherwise it returns baseMnem and op unchanged, and the encoder
// reports the immediate.  A named immediate (an expression starting with a constant's name, which
// clang matches only to MOVW or a substitute) is MOVW even when it has a rotated encoding.
func arm32ImmAlt(baseMnem *[]readonly char, setFlags bool, op arm32.Operand, movw bool, reg int,
		named bool) (*[]readonly char, arm32.Operand) {
	if op.Kind != arm32.OP_IMM || cast(int64, op.Imm) < -0x80000000 ||
			cast(int64, op.Imm) > 0xFFFFFFFF {
		return baseMnem, op
	}
	var v uint32 = cast(uint32, op.Imm)
	var wide bool = mnemIs(baseMnem, "mov") && !setFlags && movw && v <= 0xFFFF
	if named && wide { return "movw", op }
	if arm32.EncodeRotImm(op.Imm).Ok { return baseMnem, op }
	if wide { return "movw", op }
	var other *[]readonly char = ""
	var alt uint32 = ~v
	var spPC bool = reg == arm32.SP || reg == arm32.PC
	if spPC &&
			(mnemIs(baseMnem, "mov") || mnemIs(baseMnem, "mvn") || mnemIs(baseMnem, "cmp") ||
					mnemIs(baseMnem, "cmn")) {
		return baseMnem, op
	}
	if mnemIs(baseMnem, "mov") { other = "mvn" }
	if mnemIs(baseMnem, "mvn") { other = "mov" }
	if mnemIs(baseMnem, "and") { other = "bic" }
	if mnemIs(baseMnem, "bic") { other = "and" }
	if mnemIs(baseMnem, "adc") { other = "sbc" }
	if mnemIs(baseMnem, "sbc") { other = "adc" }
	if mnemIs(baseMnem, "add") || mnemIs(baseMnem, "sub") || mnemIs(baseMnem, "cmp") ||
			mnemIs(baseMnem, "cmn") {
		alt = cast(uint32, 0) - v
		if mnemIs(baseMnem, "add") { other = "sub" }
		if mnemIs(baseMnem, "sub") { other = "add" }
		if mnemIs(baseMnem, "cmp") { other = "cmn" }
		if mnemIs(baseMnem, "cmn") { other = "cmp" }
	}
	if len(other) == 0 { return baseMnem, op }
	var altImm int = cast(int, cast(int32, alt))
	if !arm32.EncodeRotImm(altImm).Ok { return baseMnem, op }
	return other, arm32.Imm(altImm)
}

// arm32ShiftRegsOk reports whether none of a shift instruction's registers (`lsl Rd, Rm, Rs`
// ..) is PC, which clang rejects there (unlike in `mov Rd, Rm, lsl Rs`), else sets its error.
func arm32ShiftRegsOk(p @Parser, rd int, rm int, rs int) bool {
	if rd != arm32.PC && rm != arm32.PC && rs != arm32.PC { return true }
	setErr(p, "operand must be a register in range [r0, r14]")
	return false
}

// arm32ImmFor returns the instruction clang assembles for baseMnem with op and the register reg
// (MOV / MVN's Rd, CMP / CMN / TST / TEQ's Rn, another's Rd), or ok false with p's error set.  An
// immediate a label difference decided (Parser.Arm32ImmDiff) is left to a fixup, as clang leaves
// it: MOV takes none, and another only its own encoding, no substitute; any other immediate is
// replaced as arm32ImmAlt says.
func arm32ImmFor(p @Parser, baseMnem *[]readonly char, setFlags bool, op arm32.Operand,
		reg int) (*[]readonly char, arm32.Operand, bool) {
	if op.Kind == arm32.OP_IMM && p.Arm32ImmDiff {
		if mnemIs(baseMnem, "mov") {
			setErr(p, "immediate expression for mov requires :lower16: or :upper16")
			return baseMnem, op, false
		}
		if !arm32.EncodeRotImm(op.Imm).Ok {
			setErr(p, "out of range immediate fixup value")
			return baseMnem, op, false
		}
		return baseMnem, op, true
	}
	var m *[]readonly char
	m, op = arm32ImmAlt(baseMnem, setFlags, op, p.Arm32Feats & armV6T2 != 0, reg, p.Arm32ImmName)
	return m, op, true
}
