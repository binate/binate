package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"

// arm32ShiftAliasKind returns the shift a shift instruction names -- `lsl`,
// `lsr`, `asr`, `ror` or `rrx`, each an alias of MOV with a shifted register --
// or -1 when baseMnem is none of them.
func arm32ShiftAliasKind(baseMnem *[]readonly char) int {
	if mnemIs(baseMnem, "lsl") { return arm32.LSL }
	if mnemIs(baseMnem, "lsr") { return arm32.LSR }
	if mnemIs(baseMnem, "asr") { return arm32.ASR }
	if mnemIs(baseMnem, "ror") { return arm32.ROR }
	if mnemIs(baseMnem, "rrx") { return arm32.RRX }
	return -1
}

// parseArm32ShiftAlias assembles a shift instruction (arm32ShiftAliasKind), as
// clang takes it: `lsl` / `lsr` / `asr` / `ror` Rd, Rm, #amount or Rd, Rm, Rs,
// and the two-operand forms with Rm = Rd (`lsl r0, #3`, `lsr r2, r3`); `rrx`
// Rd, Rm.  The amount's '#' is optional.  tok is the token after Rd; reports
// whether baseMnem was a shift instruction (it is then assembled, or the error
// set).
func parseArm32ShiftAlias(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		setFlags bool, rd int) bool {
	var sk int = arm32ShiftAliasKind(baseMnem)
	if sk < 0 { return false }
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return true
	}
	l, tok = LexNext(l)
	var rm int = rd
	if tok.Kind == TOK_IDENT {
		var r int = parseArm32Reg(tok.Text)
		if r < 0 {
			setErr(p, "expected register")
			return true
		}
		l, tok = LexNext(l)
		if sk == arm32.RRX {
			if arm32AtEOL(p, tok) { arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegShift(r, arm32.RRX, 0)) }
			return true
		}
		if tok.Kind != TOK_COMMA {
			// The two-operand register form `op Rd, Rs`: Rd shifted by Rs.
			if arm32AtEOL(p, tok) { arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegSReg(rd, sk, r)) }
			return true
		}
		rm = r
		l, tok = LexNext(l)
		if tok.Kind == TOK_IDENT {
			// `op Rd, Rm, Rs`
			var rs int = parseArm32Reg(tok.Text)
			if rs < 0 {
				setErr(p, "expected register")
				return true
			}
			l, tok = LexNext(l)
			if arm32AtEOL(p, tok) { arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegSReg(rm, sk, rs)) }
			return true
		}
	} else if sk == arm32.RRX {
		setErr(p, "expected register")
		return true
	}
	// The amount: `op Rd, Rm, #n` or the two-operand `op Rd, #n`.
	if tok.Kind == TOK_HASH { l, tok = LexNext(l) }
	var amt ExprResult
	l, tok, amt = ParseExpr(p, l, tok)
	if !amt.Ok {
		setErr(p, exprErr(amt, "invalid shift amount"))
		return true
	}
	if !arm32AtEOL(p, tok) { return true }
	var n int
	var fits bool
	n, fits = arm32IntOf(p, amt.Val, "shift amount")
	if fits { arm32.Mov(p.Asm, cond, setFlags, rd, arm32.RegShift(rm, sk, n)) }
	return true
}

// arm32ImmAlt returns the instruction clang assembles in place of baseMnem (with the S
// flag when setFlags) when op is an immediate with no rotated encoding: MOV of a 16-bit
// value is MOVW ("movw"; there is no MOVWS); MOV / MVN, AND / BIC and ADC / SBC swap
// with the immediate's bitwise complement, and ADD / SUB and CMP / CMN with its
// negation, when that encodes (`mov r0, #-1` is `mvn r0, #0`, `add r0, r1, #-4` is `sub
// r0, r1, #4`) -- with the same result and flags.  Otherwise it returns baseMnem and op
// unchanged, and the encoder reports the immediate.
func arm32ImmAlt(baseMnem *[]readonly char, setFlags bool,
		op arm32.Operand) (*[]readonly char, arm32.Operand) {
	if op.Kind != arm32.OP_IMM || arm32.EncodeRotImm(op.Imm).Ok { return baseMnem, op }
	if cast(int64, op.Imm) < -0x80000000 || cast(int64, op.Imm) > 0xFFFFFFFF { return baseMnem, op }
	var v uint32 = cast(uint32, op.Imm)
	if mnemIs(baseMnem, "mov") && !setFlags && v <= 0xFFFF { return "movw", op }
	var other *[]readonly char = ""
	var alt uint32 = ~v
	if mnemIs(baseMnem, "mov") { other = "mvn" }
	if mnemIs(baseMnem, "mvn") { other = "mov" }
	if mnemIs(baseMnem, "and") { other = "bic" }
	if mnemIs(baseMnem, "bic") { other = "and" }
	if mnemIs(baseMnem, "adc") { other = "sbc" }
	if mnemIs(baseMnem, "sbc") { other = "adc" }
	if mnemIs(baseMnem, "add") || mnemIs(baseMnem, "sub") || mnemIs(baseMnem, "cmp") ||
			mnemIs(baseMnem, "cmn") {
		alt = cast(uint32, 0) - v
		if mnemIs(baseMnem, "add") { other = "sub" }
		if mnemIs(baseMnem, "sub") { other = "add" }
		if mnemIs(baseMnem, "cmp") { other = "cmn" }
		if mnemIs(baseMnem, "cmn") { other = "cmp" }
	}
	if len(other) == 0 { return baseMnem, op }
	var altImm int = cast(int, cast(int32, alt))
	if !arm32.EncodeRotImm(altImm).Ok { return baseMnem, op }
	return other, arm32.Imm(altImm)
}
