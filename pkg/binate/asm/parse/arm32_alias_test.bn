package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The shift instructions, each line's word as clang assembles it: MOV with a
// shifted register, an amount of 0 being the plain register, LSR / ASR #32 an
// amount field of 0.

// arm32CheckGoldens assembles each line of g alone and checks its word.
func arm32CheckGoldens(g @[]arm32MemGolden) testing.TestResult {
	for i := 0; i < len(g); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(g[i].line)
		if p.HasError { return fail(buf.Concat(g[i].line, buf.Concat(": ", p.ErrorMsg))) }
		if a.HasError { return fail(buf.Concat(g[i].line, buf.Concat(": ", a.ErrorMsg))) }
		if readWord(a.Sections[0], 0) != g[i].word {
			return fail(buf.Concat(g[i].line, ": encoded differently from clang"))
		}
	}
	return ""
}

// arm32CheckRejects assembles each line alone and checks it is an error.
func arm32CheckRejects(bad @[]*[]readonly char) testing.TestResult {
	for i := 0; i < len(bad); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(bad[i])
		if !p.HasError && !a.HasError { return fail(buf.Concat(bad[i], ": accepted")) }
	}
	return ""
}

func TestParseArm32ShiftAliases() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 17)
	g[0] = arm32MemGolden{line: "lsl r0, r1, #3", word: 0xE1A00181}
	g[1] = arm32MemGolden{line: "lsr r0, r1, #3", word: 0xE1A001A1}
	g[2] = arm32MemGolden{line: "asr r0, r1, #3", word: 0xE1A001C1}
	g[3] = arm32MemGolden{line: "ror r0, r1, #3", word: 0xE1A001E1}
	g[4] = arm32MemGolden{line: "lsl r0, r1, r2", word: 0xE1A00211}
	g[5] = arm32MemGolden{line: "ror r0, r1, r2", word: 0xE1A00271}
	g[6] = arm32MemGolden{line: "lsls r0, r1, #1", word: 0xE1B00081}
	g[7] = arm32MemGolden{line: "rrx r0, r1", word: 0xE1A00061}
	g[8] = arm32MemGolden{line: "lsr r0, r1, #32", word: 0xE1A00021}
	g[9] = arm32MemGolden{line: "asr r0, r1, #32", word: 0xE1A00041}
	g[10] = arm32MemGolden{line: "lsl r0, r1, #0", word: 0xE1A00001}
	g[11] = arm32MemGolden{line: "lsl r0, #3", word: 0xE1A00180}
	g[12] = arm32MemGolden{line: "lsr r2, r3", word: 0xE1A02332}
	g[13] = arm32MemGolden{line: "lslseq r0, r1, #1", word: 0x01B00081}
	g[14] = arm32MemGolden{line: "rrxs r0, r1", word: 0xE1B00061}
	g[15] = arm32MemGolden{line: "asrs r4, r5, r6", word: 0xE1B04655}
	g[16] = arm32MemGolden{line: "ror r0, r1, #0", word: 0xE1A00001}
	return arm32CheckGoldens(g)
}

// An amount clang rejects is an error.
func TestParseArm32ShiftAliasRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 2)
	bad[0] = "lsl r0, r1, #32"
	bad[1] = "rrx r0, #1"
	return arm32CheckRejects(bad)
}

// An immediate with no rotated encoding, as clang substitutes it (arm32ImmAlt): MOV of a
// 16-bit value is MOVW, and MOV / MVN, AND / BIC, ADC / SBC, ADD / SUB and CMP / CMN swap
// with the complemented or negated immediate, flag-setting forms too.
func TestParseArm32ImmediateSubstitutions() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 20)
	g[0] = arm32MemGolden{line: "mov r0, #-1", word: 0xE3E00000}
	g[1] = arm32MemGolden{line: "add r0, r1, #-4", word: 0xE2410004}
	g[2] = arm32MemGolden{line: "sub r0, r1, #-4", word: 0xE2810004}
	g[3] = arm32MemGolden{line: "cmp r0, #-1", word: 0xE3700001}
	g[4] = arm32MemGolden{line: "cmn r0, #-1", word: 0xE3500001}
	g[5] = arm32MemGolden{line: "and r0, r1, #0xffffff00", word: 0xE3C100FF}
	g[6] = arm32MemGolden{line: "bic r0, r1, #0xffffff00", word: 0xE20100FF}
	g[7] = arm32MemGolden{line: "mvn r0, #-1", word: 0xE3A00000}
	g[8] = arm32MemGolden{line: "adc r0, r1, #-1", word: 0xE2C10000}
	g[9] = arm32MemGolden{line: "sbc r0, r1, #-1", word: 0xE2A10000}
	g[10] = arm32MemGolden{line: "movs r0, #-1", word: 0xE3F00000}
	g[11] = arm32MemGolden{line: "ands r0, r1, #0xffffff00", word: 0xE3D100FF}
	g[12] = arm32MemGolden{line: "adds r0, r1, #-4", word: 0xE2510004}
	g[13] = arm32MemGolden{line: "mvns r0, #0xff00ffff", word: 0xE3B008FF}
	g[14] = arm32MemGolden{line: "mov r0, #0xff00ffff", word: 0xE3E008FF}
	g[15] = arm32MemGolden{line: "mov r0, #0x1fe", word: 0xE30001FE}
	g[16] = arm32MemGolden{line: "mov r0, #0xffff", word: 0xE30F0FFF}
	g[17] = arm32MemGolden{line: "moveq r0, #0x1fe", word: 0x030001FE}
	g[18] = arm32MemGolden{line: "mov r0, 0x1fe", word: 0xE30001FE}
	g[19] = arm32MemGolden{line: "mov r0, -1", word: 0xE3E00000}
	return arm32CheckGoldens(g)
}

// Where neither the immediate nor its substitute encodes, as clang: MOVS has no MOVW
// form, MVN no 16-bit one, ORR / EOR / TST no complement, and a value with no form.
func TestParseArm32ImmediateSubstitutionRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 5)
	bad[0] = "movs r0, #0x1fe"
	bad[1] = "mvn r0, #0x1fe"
	bad[2] = "orr r0, r1, #0xffffff00"
	bad[3] = "mov r0, #0x12345"
	bad[4] = "tst r0, #0xffffff00"
	return arm32CheckRejects(bad)
}
