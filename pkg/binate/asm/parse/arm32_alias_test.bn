package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The shift instructions, each line's word as clang assembles it: MOV with a
// shifted register, an amount of 0 being the plain register, LSR / ASR #32 an
// amount field of 0.

// arm32CheckGoldens assembles each line of g alone and checks its word.
func arm32CheckGoldens(g @[]arm32MemGolden) testing.TestResult {
	for i := 0; i < len(g); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(g[i].line)
		if p.HasError { return fail(buf.Concat(g[i].line, buf.Concat(": ", p.ErrorMsg))) }
		if a.HasError { return fail(buf.Concat(g[i].line, buf.Concat(": ", a.ErrorMsg))) }
		if readWord(a.Sections[0], 0) != g[i].word {
			return fail(buf.Concat(g[i].line, ": encoded differently from clang"))
		}
	}
	return ""
}

// arm32CheckRejects assembles each line alone and checks it is an error.
func arm32CheckRejects(bad @[]*[]readonly char) testing.TestResult {
	for i := 0; i < len(bad); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(bad[i])
		if !p.HasError && !a.HasError { return fail(buf.Concat(bad[i], ": accepted")) }
	}
	return ""
}

func TestParseArm32ShiftAliases() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 17)
	g[0] = arm32MemGolden{line: "lsl r0, r1, #3", word: 0xE1A00181}
	g[1] = arm32MemGolden{line: "lsr r0, r1, #3", word: 0xE1A001A1}
	g[2] = arm32MemGolden{line: "asr r0, r1, #3", word: 0xE1A001C1}
	g[3] = arm32MemGolden{line: "ror r0, r1, #3", word: 0xE1A001E1}
	g[4] = arm32MemGolden{line: "lsl r0, r1, r2", word: 0xE1A00211}
	g[5] = arm32MemGolden{line: "ror r0, r1, r2", word: 0xE1A00271}
	g[6] = arm32MemGolden{line: "lsls r0, r1, #1", word: 0xE1B00081}
	g[7] = arm32MemGolden{line: "rrx r0, r1", word: 0xE1A00061}
	g[8] = arm32MemGolden{line: "lsr r0, r1, #32", word: 0xE1A00021}
	g[9] = arm32MemGolden{line: "asr r0, r1, #32", word: 0xE1A00041}
	g[10] = arm32MemGolden{line: "lsl r0, r1, #0", word: 0xE1A00001}
	g[11] = arm32MemGolden{line: "lsl r0, #3", word: 0xE1A00180}
	g[12] = arm32MemGolden{line: "lsr r2, r3", word: 0xE1A02332}
	g[13] = arm32MemGolden{line: "lslseq r0, r1, #1", word: 0x01B00081}
	g[14] = arm32MemGolden{line: "rrxs r0, r1", word: 0xE1B00061}
	g[15] = arm32MemGolden{line: "asrs r4, r5, r6", word: 0xE1B04655}
	g[16] = arm32MemGolden{line: "ror r0, r1, #0", word: 0xE1A00001}
	return arm32CheckGoldens(g)
}

// An amount clang rejects is an error.
func TestParseArm32ShiftAliasRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 2)
	bad[0] = "lsl r0, r1, #32"
	bad[1] = "rrx r0, #1"
	return arm32CheckRejects(bad)
}
