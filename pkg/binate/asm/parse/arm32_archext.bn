package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// parseArchExtensionDirective handles ".arch_extension [no]name", as clang reads it: an
// extension of the architecture in effect adds its features (Parser.Arm32Feats), or with `no`
// (in any case) removes them, for the instructions after it (armArchExt).  An extension the
// architecture cannot have ("architectural extension 'X' is not allowed for the current base
// architecture"), one clang does not support in ARM code ("unsupported architectural extension:
// X") and an unknown name ("unknown architectural extension: X") are errors.  The FP, SIMD and
// crypto extensions set only their own features so far.
func parseArchExtensionDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected architecture extension name")
		return l, tok
	}
	// bnlint:allow managed-to-raw-assign - tok is a live token; Text outlives the reads
	var full *[]readonly char = tok.Text
	var on bool = len(full) < 2 || !mnemIs(full[0:2], "no")
	var name *[]readonly char = full
	if !on { name = full[2:len(full)] }
	var add uint64
	var drop uint64
	var needs uint64
	var kind int
	add, drop, needs, kind = armArchExt(name)
	if kind == armExtUnsupported {
		setErr(p, buf.Concat("unsupported architectural extension: ", name))
		return l, tok
	}
	if kind == armExtUnknown {
		// clang names an extension LLVM knows (but ARM code has not) as written, any other without
		// its `no`.
		var shown *[]readonly char = name
		if armLLVMOnlyExt(name) { shown = full }
		setErr(p, buf.Concat("unknown architectural extension: ", shown))
		return l, tok
	}
	if kind == armExtNever || p.Arm32Feats & needs != needs {
		// clang names `nocrypto`'s by the first extension crypto stands for.
		var shown *[]readonly char = name
		if !on && charsEqual(name, "crypto") { shown = "sha2" }
		setErr(p,
				buf.Concat(buf.Concat("architectural extension '", shown),
						"' is not allowed for the current base architecture"))
		return l, tok
	}
	if on {
		p.Arm32Feats = p.Arm32Feats | add
	} else {
		p.Arm32Feats = p.Arm32Feats & ~drop
	}
	l, tok = LexNext(l)
	return l, tok
}

// The kinds of `.arch_extension` name armArchExt reports: one the architecture may have
// (armExtKnown), one ARM code may never have (armExtNever: M-profile extensions), one clang does
// not support (armExtUnsupported) and an unknown name (armExtUnknown).
const (
	armExtKnown int = iota
	armExtNever
	armExtUnsupported
	armExtUnknown
)

// armArchExt returns the features the extension name adds, those `no<name>` drops, the
// architecture levels it needs (as clang allows it: idiv, mp, virt on ARMv7, A or R; sec on
// ARMv6K; the ARMv8 ones; fp16 on ARMv8.2), and its kind (armExt*).  virt brings hardware divide
// with it, and noidiv drops virt too, as in clang.
func armArchExt(name *[]readonly char) (uint64, uint64, uint64, int) {
	if charsEqual(name, "idiv") { return armHwDivArm, armHwDivArm | armVirt, armV7, armExtKnown }
	if charsEqual(name, "mp") { return armMP, armMP, armV7, armExtKnown }
	if charsEqual(name, "sec") { return armSec, armSec, armV6K, armExtKnown }
	if charsEqual(name, "virt") { return armVirt | armHwDivArm, armVirt, armV7, armExtKnown }
	if charsEqual(name, "crc") { return armCRC, armCRC, armV8, armExtKnown }
	if charsEqual(name, "ras") { return armRAS, armRAS, armV8, armExtKnown }
	if charsEqual(name, "crypto") { return armSHA2 | armAES, armSHA2 | armAES, armV8, armExtKnown }
	if charsEqual(name, "sha2") { return armSHA2, armSHA2, armV8, armExtKnown }
	if charsEqual(name, "aes") { return armAES, armAES, armV8, armExtKnown }
	if charsEqual(name, "fp") { return armFP, armFP, armV8, armExtKnown }
	if charsEqual(name, "simd") { return armSIMD, armSIMD, armV8, armExtKnown }
	if charsEqual(name, "fp16") { return armFP16, armFP16, armV8_2, armExtKnown }
	if charsEqual(name, "mve.fp") || charsEqual(name, "pacbti") || charsEqual(name, "lob") {
		return 0, 0, 0, armExtNever
	}
	if charsEqual(name, "os") || charsEqual(name, "iwmmxt") || charsEqual(name, "iwmmxt2") ||
			charsEqual(name, "maverick") || charsEqual(name, "xscale") {
		return 0, 0, 0, armExtUnsupported
	}
	return 0, 0, 0, armExtUnknown
}

// armLLVMOnlyExt reports whether name is an extension LLVM's ARM target parser knows that clang's
// `.arch_extension` does not take: dotprod, dsp, sb, fp16fml, bf16, i8mm, mve, cdecp0 .. cdecp7,
// fp.dp and none.
func armLLVMOnlyExt(name *[]readonly char) bool {
	if charsEqual(name, "dotprod") || charsEqual(name, "dsp") || charsEqual(name, "sb") ||
			charsEqual(name, "fp16fml") || charsEqual(name, "bf16") || charsEqual(name, "i8mm") ||
			charsEqual(name, "mve") || charsEqual(name, "fp.dp") || charsEqual(name, "none") {
		return true
	}
	return len(name) == 6 && armHasPrefix(name, "cdecp") && name[5] >= '0' && name[5] <= '7'
}
