package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// armGateIs is in arm32_feat_test.bn.

// `.arch_extension` adds an extension's features, or with `no` removes them, where the
// architecture may have it — idiv, mp and virt from ARMv7, sec from ARMv6K, crc and the other
// ARMv8 ones from ARMv8, fp16 from ARMv8.2 — virt bringing hardware divide with it and noidiv
// taking virt; the rest with clang's messages.
func TestArm32ArchExtension() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv7-a\n.arch_extension idiv", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".arch armv7-r\n.arch_extension idiv", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".arch armv7-a\n.arch_extension virt", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".arch armv7-a\n.arch_extension virt\n.arch_extension noidiv", "sdiv r0, r0, r1",
			"!instruction requires: divide in ARM")
	e = armGateIs(e, ".arch_extension noidiv", "sdiv r0, r0, r1",
			"!instruction requires: divide in ARM")
	e = armGateIs(e, ".arch_extension novirt", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-a8\n.arch_extension idiv", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".arch armv6\n.arch_extension idiv", "nop",
			"!architectural extension 'idiv' is not allowed for the current base architecture")
	e = armGateIs(e, ".arch armv6\n.arch_extension sec", "nop",
			"!architectural extension 'sec' is not allowed for the current base architecture")
	e = armGateIs(e, ".arch armv6k\n.arch_extension nosec", "nop", "E320F000")
	e = armGateIs(e, ".arch_extension crc", "nop",
			"!architectural extension 'crc' is not allowed for the current base architecture")
	e = armGateIs(e, ".arch armv8-a\n.arch_extension nocrc\n.arch_extension ras", "nop", "E320F000")
	e = armGateIs(e, ".arch armv8-a\n.arch_extension fp16", "nop",
			"!architectural extension 'fp16' is not allowed for the current base architecture")
	e = armGateIs(e, ".arch armv8.2-a\n.arch_extension fp16", "nop", "E320F000")
	e = armGateIs(e, ".arch_extension nocrypto", "nop",
			"!architectural extension 'sha2' is not allowed for the current base architecture")
	e = armGateIs(e, ".arch armv9-a\n.arch_extension mve.fp", "nop",
			"!architectural extension 'mve.fp' is not allowed for the current base architecture")
	e = armGateIs(e, ".arch_extension noiwmmxt", "nop", "!unsupported architectural extension: iwmmxt")
	e = armGateIs(e, ".arch_extension nodotprod", "nop", "!unknown architectural extension: nodotprod")
	e = armGateIs(e, ".arch_extension nohwdiv", "nop", "!unknown architectural extension: hwdiv")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The `no` prefix is taken in any case, the extension name only as written; clang names an
// unknown extension without its `no` unless LLVM knows it (dotprod, sb ..); lob, like the other
// M-profile extensions, is never allowed in ARM code.
func TestArm32ArchExtensionNames() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch_extension NOidiv", "sdiv r0, r0, r1",
			"!instruction requires: divide in ARM")
	e = armGateIs(e, ".arch armv7-a\n.arch_extension Noidiv\n.arch_extension virt", "sdiv r0, r0, r1",
			"E710F110")
	e = armGateIs(e, ".arch_extension noIDIV", "nop", "!unknown architectural extension: IDIV")
	e = armGateIs(e, ".arch_extension NOCRYPTO", "nop", "!unknown architectural extension: CRYPTO")
	e = armGateIs(e, ".arch_extension nobogus", "nop", "!unknown architectural extension: bogus")
	e = armGateIs(e, ".arch_extension nonoidiv", "nop", "!unknown architectural extension: noidiv")
	e = armGateIs(e, ".arch_extension none", "nop", "!unknown architectural extension: ne")
	e = armGateIs(e, ".arch_extension nonone", "nop", "!unknown architectural extension: nonone")
	e = armGateIs(e, ".arch_extension nosb", "nop", "!unknown architectural extension: nosb")
	e = armGateIs(e, ".arch_extension nocdecp7", "nop", "!unknown architectural extension: nocdecp7")
	e = armGateIs(e, ".arch_extension nocdecp8", "nop", "!unknown architectural extension: cdecp8")
	e = armGateIs(e, ".arch_extension nolob", "nop",
			"!architectural extension 'lob' is not allowed for the current base architecture")
	if len(e) > 0 { return fail(e) }
	return ""
}
