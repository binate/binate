package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The extend, bitfield, reverse and count-leading-zeros families arm32BitsKind names.
const (
	bitsExtend int = iota + 1
	bitsExtendAdd
	bitsBfc
	bitsBfi
	bitsSbfx
	bitsUbfx
	bitsRev
	bitsRev16
	bitsRevsh
	bitsRbit
	bitsClz
)

// arm32BitsKind returns the family name names (0 for none) and, for an extend or extend-add, its
// operation (arm32.EXT_SXTB16 ..).
func arm32BitsKind(name *[]readonly char) (int, int) {
	if mnemIs(name, "bfc") { return bitsBfc, 0 }
	if mnemIs(name, "bfi") { return bitsBfi, 0 }
	if mnemIs(name, "sbfx") { return bitsSbfx, 0 }
	if mnemIs(name, "ubfx") { return bitsUbfx, 0 }
	if mnemIs(name, "rev") { return bitsRev, 0 }
	if mnemIs(name, "rev16") { return bitsRev16, 0 }
	if mnemIs(name, "revsh") { return bitsRevsh, 0 }
	if mnemIs(name, "rbit") { return bitsRbit, 0 }
	if mnemIs(name, "clz") { return bitsClz, 0 }
	var op int = arm32ExtendOp(name, "xt")
	if op >= 0 { return bitsExtend, op }
	op = arm32ExtendOp(name, "xta")
	if op >= 0 { return bitsExtendAdd, op }
	return 0, 0
}

// arm32ExtendOp returns the extend operation of name -- `s` or `u`, then infix (`xt` for an
// extend, `xta` for an extend-and-add), then `b16`, `b` or `h` -- or -1.
func arm32ExtendOp(name *[]readonly char, infix *[]readonly char) int {
	var n int = len(name)
	var m int = len(infix)
	if n < m + 2 || !mnemIs(name[1:m + 1], infix) { return -1 }
	var signed bool = mnemIs(name[0:1], "s")
	if !signed && !mnemIs(name[0:1], "u") { return -1 }
	var rest *[]readonly char = name[m + 1:n]
	var op int = -1
	if mnemIs(rest, "b16") { op = arm32.EXT_SXTB16 }
	if mnemIs(rest, "b") { op = arm32.EXT_SXTB }
	if mnemIs(rest, "h") { op = arm32.EXT_SXTH }
	if op < 0 || signed { return op }
	return op + 4 // the unsigned operation of each
}

// parseArm32Rotation parses an extend's optional `, ror #n` (tok the token after the last
// register): the rotation (0 when there is none) and whether one was written, or ok false with
// p's error set.  The name is ROR in lower or upper case, the amount a constant with `#` or `$`,
// as clang takes them; the encoder checks its value.
func parseArm32Rotation(p @Parser, l Lexer, tok Token) (Lexer, Token, int, bool, bool) {
	if tok.Kind != TOK_COMMA { return l, tok, 0, false, true }
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || !mnemIs(tok.Text, "ror") || !arm32OneCase(tok.Text) {
		setErr(p, "operand must be a register in range [r0, r14]")
		return l, tok, 0, true, false
	}
	l, tok = LexNext(l)
	var amtL Lexer
	var prefixed bool
	amtL, prefixed = arm32ImmPrefix(l, tok, true)
	if !prefixed {
		setErr(p, "'#' expected")
		return l, tok, 0, true, false
	}
	l, tok = LexNext(amtL)
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok || r.FromDiff || !intFits(r.Val) {
		setErr(p, exprErr(r, "constant expression expected"))
		return l, tok, 0, true, false
	}
	return l, tok, cast(int, r.Val), true, true
}

// parseArm32HashImm parses BFC / BFI's `, #imm` (tok the comma): `#` or `$` (`$8` is `$` and 8)
// before a constant, as clang takes them; or ok false with p's error set.
func parseArm32HashImm(p @Parser, l Lexer, tok Token) (Lexer, Token, int, bool) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "too few operands for instruction")
		return l, tok, 0, false
	}
	l, tok = LexNext(l)
	var immL Lexer
	var prefixed bool
	immL, prefixed = arm32ImmPrefix(l, tok, true)
	if !prefixed {
		setErr(p, "'#' expected")
		return l, tok, 0, false
	}
	l, tok = LexNext(immL)
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok || r.FromDiff || !intFits(r.Val) {
		setErr(p, exprErr(r, "constant expression expected"))
		return l, tok, 0, false
	}
	return l, tok, cast(int, r.Val), true
}

// parseArm32Bits assembles an extend, bitfield, reverse or CLZ (arm32BitsKind) from its operands
// after Rd (tok the token after it), as clang takes them: an extend `Rd, Rm{, ror #n}`, an
// extend-add `Rd, Rn, Rm{, ror #n}`; BFC `Rd, #lsb, #width`, BFI `Rd, Rn, #lsb, #width` (the
// immediates with `#` or `$`), SBFX / UBFX `Rd, Rn, lsb, width` (with `#`, a lone `$` or neither);
// the reverses and CLZ `Rd, Rm`.  CLZ needs ARMv5T, the reverses ARMv6 (RBIT ARMv6T2), an
// extend's rotation ARMv6, the bitfields ARMv6T2; clang gates no extend without one.  The encoder
// checks the registers and the immediates.  Reports whether baseMnem is one (it is then
// assembled, or the error set).
func parseArm32Bits(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		rd int) bool {
	var kind int
	var op int
	kind, op = arm32BitsKind(baseMnem)
	if kind == 0 { return false }
	var a @asm.Assembler = p.Asm
	var regs @[]int = make_slice(int, 4)
	regs[0] = rd
	var got int
	var ok bool
	if kind == bitsExtend || kind == bitsExtendAdd {
		var n int = 2
		if kind == bitsExtendAdd { n = 3 }
		l, tok, got, ok = parseArm32Regs(p, l, tok, regs, n)
		if !ok { return true }
		var rot int
		var rotated bool
		if got == n {
			l, tok, rot, rotated, ok = parseArm32Rotation(p, l, tok)
			if !ok { return true }
		}
		if !arm32ExactOperands(p, tok, got, n) { return true }
		if rotated && !armRequire(p, armV6, "armv6") { return true }
		if kind == bitsExtend {
			arm32.Extend(a, cond, op, rd, regs[1], rot)
		} else {
			arm32.ExtendAdd(a, cond, op, rd, regs[1], regs[2], rot)
		}
		return true
	}
	if kind == bitsBfc || kind == bitsBfi || kind == bitsSbfx || kind == bitsUbfx {
		var n int = 2
		if kind == bitsBfc { n = 1 }
		l, tok, got, ok = parseArm32Regs(p, l, tok, regs, n)
		if !ok { return true }
		if got < n {
			setErr(p, "too few operands for instruction")
			return true
		}
		var lsb int
		var width int
		if kind == bitsBfc || kind == bitsBfi {
			l, tok, lsb, ok = parseArm32HashImm(p, l, tok)
			if ok { l, tok, width, ok = parseArm32HashImm(p, l, tok) }
		} else {
			l, tok, lsb, ok = parseArm32ImmOperand(p, l, tok)
			if ok { l, tok, width, ok = parseArm32ImmOperand(p, l, tok) }
		}
		if !ok || !arm32ExactOperands(p, tok, n, n) || !armRequire(p, armV6T2, "armv6t2") {
			return true
		}
		if kind == bitsBfc { arm32.Bfc(a, cond, rd, lsb, width) }
		if kind == bitsBfi { arm32.Bfi(a, cond, rd, regs[1], lsb, width) }
		if kind == bitsSbfx { arm32.Sbfx(a, cond, rd, regs[1], lsb, width) }
		if kind == bitsUbfx { arm32.Ubfx(a, cond, rd, regs[1], lsb, width) }
		return true
	}
	l, tok, got, ok = parseArm32Regs(p, l, tok, regs, 2)
	if !ok || !arm32ExactOperands(p, tok, got, 2) { return true }
	var feat uint64 = armV6
	var featName *[]readonly char = "armv6"
	if kind == bitsRbit {
		feat = armV6T2
		featName = "armv6t2"
	}
	if kind == bitsClz {
		feat = armV5T
		featName = "armv5t"
	}
	if !armRequire(p, feat, featName) { return true }
	if kind == bitsRev { arm32.Rev(a, cond, rd, regs[1]) }
	if kind == bitsRev16 { arm32.Rev16(a, cond, rd, regs[1]) }
	if kind == bitsRevsh { arm32.Revsh(a, cond, rd, regs[1]) }
	if kind == bitsRbit { arm32.Rbit(a, cond, rd, regs[1]) }
	if kind == bitsClz { arm32.Clz(a, cond, rd, regs[1]) }
	return true
}
