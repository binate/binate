package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The extend, bitfield, reverse and CLZ instructions as clang (Apple clang 21, armv7ve) takes
// them, with its words: an extend's rotation named ROR in lower or upper case, its amount with
// `#` or `$`; an extend-add with Rn PC as the plain extend; BFC / BFI's immediates with `#` or
// `$`, SBFX / UBFX's with `#` or none; PC where clang takes it.  (armGateIs is in
// arm32_feat_test.bn.)
func TestArm32BitsForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "sxtb r0, r1", "E6AF0071")
	e = armGateIs(e, "", "sxtb r0, r1, ror #8", "E6AF0471")
	e = armGateIs(e, "", "sxtb r0, r1, ror #0", "E6AF0071")
	e = armGateIs(e, "", "sxtb r0, r1, ROR #8", "E6AF0471")
	e = armGateIs(e, "", "sxtb r0, r1, ror $8", "E6AF0471")
	e = armGateIs(e, "", "sxtb r0, r1, ror $ 8", "E6AF0471")
	e = armGateIs(e, "", "sxth r0, r1, ror #16", "E6BF0871")
	e = armGateIs(e, "", "sxtb16 r0, r1, ror #8", "E68F0471")
	e = armGateIs(e, "", "uxth r0, r1, ror #24", "E6FF0C71")
	e = armGateIs(e, "", "uxtb16 r0, r1", "E6CF0071")
	e = armGateIs(e, "", "sxtbeq r0, r1, ror #8", "06AF0471")
	e = armGateIs(e, "", "sxtab r0, r1, r2", "E6A10072")
	e = armGateIs(e, "", "sxtab r0, pc, r2", "E6AF0072")
	e = armGateIs(e, "", "sxtah r0, r1, r2, ror #16", "E6B10872")
	e = armGateIs(e, "", "sxtab16 r0, r1, r2", "E6810072")
	e = armGateIs(e, "", "uxtab r0, r1, r2, ror #24", "E6E10C72")
	e = armGateIs(e, "", "uxtah r0, r1, r2", "E6F10072")
	e = armGateIs(e, "", "uxtab16 r0, r1, r2, ror #8", "E6C10472")
	e = armGateIs(e, "", "bfc r0, #8, #8", "E7CF041F")
	e = armGateIs(e, "", "bfc r0, #31, #1", "E7DF0F9F")
	e = armGateIs(e, "", "bfc r0, $8, $8", "E7CF041F")
	e = armGateIs(e, "", "bfc pc, #0, #1", "E7C0F01F")
	e = armGateIs(e, "", "bfi r0, r1, #0, #32", "E7DF0011")
	e = armGateIs(e, "", "bfi r0, pc, #8, #8", "E7CF041F")
	e = armGateIs(e, "", "bfieq r0, r1, #8, #8", "07CF0411")
	e = armGateIs(e, "", "sbfx r0, r1, #8, #8", "E7A70451")
	e = armGateIs(e, "", "sbfx r0, r1, 8, 8", "E7A70451")
	e = armGateIs(e, "", "sbfx r0, r1, #31, #1", "E7A00FD1")
	e = armGateIs(e, "", "ubfx r0, r1, $ 8, #8", "E7E70451")
	e = armGateIs(e, "", "rev pc, r1", "E6BFFF31")
	e = armGateIs(e, "", "rev16 r0, r1", "E6BF0FB1")
	e = armGateIs(e, "", "revsh r0, r1", "E6FF0FB1")
	e = armGateIs(e, "", "rbit r0, pc", "E6FF0F3F")
	e = armGateIs(e, "", "clz pc, r1", "E16FFF11")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The forms clang rejects: a rotation other than 0, 8, 16 or 24, a shift other than ROR (a
// mixed-case ROR included), a rotation without `#` or `$`; a bitfield lsb or width out of its
// range, BFC / BFI's immediates without `#`, SBFX / UBFX's with `$` before a number; PC where clang
// rejects it; too few or too many operands; S; and the extends' rotations before ARMv6 (an
// extend without one is taken), the reverses before ARMv6 (RBIT ARMv6T2), the bitfields before
// ARMv6T2, CLZ before ARMv5T.
func TestArm32BitsRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "sxtb r0, r1, ror #4", "!'ror' rotate amount must be 8, 16, or 24")
	e = armGateIs(e, "", "sxtb r0, r1, ror #32", "!'ror' rotate amount must be 8, 16, or 24")
	e = armGateIs(e, "", "sxtb r0, r1, lsl #8", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "sxtb r0, r1, Ror #8", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "sxtb r0, r1, ror 8", "!'#' expected")
	e = armGateIs(e, "", "sxtb r0, r1, ror r2", "!'#' expected")
	e = armGateIs(e, "", "sxtb pc, r1", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "sxtab r0, r1, pc", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "sxtab r0, r1", "!too few operands for instruction")
	e = armGateIs(e, "", "bfc r0, #31, #2", "!'width' operand must be in the range [1,32-lsb]")
	e = armGateIs(e, "", "bfc r0, #32, #1", "!'lsb' operand must be in the range [0,31]")
	e = armGateIs(e, "", "bfc r0, #8, 8", "!'#' expected")
	e = armGateIs(e, "", "bfi pc, r1, #8, #8", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "sbfx r0, r1, #31, #2", "!bitfield width must be in range [1,32-lsb]")
	e = armGateIs(e, "", "sbfx r0, r1, #0, #0", "!operand must be an immediate in the range [1,32]")
	e = armGateIs(e, "", "ubfx r0, pc, #8, #8", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "ubfx r0, r1, $8, #8", "!")
	e = armGateIs(e, "", "rev r0", "!too few operands for instruction")
	e = armGateIs(e, "", "rev r0, r1, r2", "!too many operands for instruction")
	e = armGateIs(e, "", "clzs r0, r1", "!instruction 'clz' can not set flags")
	e = armGateIs(e, ".arch armv5te", "sxtb r0, r1", "E6AF0071")
	e = armGateIs(e, ".arch armv5te", "uxtab16 r0, r1, r2", "E6C10072")
	e = armGateIs(e, ".arch armv5te", "sxtb r0, r1, ror #0", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv6", "sxtab r0, r1, r2, ror #8", "E6A10472")
	e = armGateIs(e, ".arch armv5te", "rev r0, r1", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv6", "rbit r0, r1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv6", "bfc r0, #8, #8", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv6t2", "ubfx r0, r1, #8, #8", "E7E70451")
	e = armGateIs(e, ".arch armv4t", "clz r0, r1", "!instruction requires: armv5t")
	e = armGateIs(e, ".arch armv5t", "clz r0, r1", "E16F0F11")
	if len(e) > 0 { return fail(e) }
	return ""
}
