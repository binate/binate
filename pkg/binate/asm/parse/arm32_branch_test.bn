package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Branches (arm32_instr.bn, arm32_target.bn), each word and relocation count as clang assembles
// them (`--target=arm-linux-gnueabihf -march=armv7ve`).

// BXJ takes any register and condition; BLX (immediate) to a number is encoded in place, the H
// bit its bit 1.  A branch's number is read as 32 bits, as clang reads it (0xFFFFFFF8 is -8).
func TestParseArm32BxjBlxNumber() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 17)
	g[0] = arm32MemGolden{line: "bxj r1", word: 0xE12FFF21}
	g[1] = arm32MemGolden{line: "bxjeq lr", word: 0x012FFF2E}
	g[2] = arm32MemGolden{line: "bxj pc", word: 0xE12FFF2F}
	g[3] = arm32MemGolden{line: "BXJ R1", word: 0xE12FFF21}
	g[4] = arm32MemGolden{line: "bxj.w r1", word: 0xE12FFF21}
	g[5] = arm32MemGolden{line: "blx #4", word: 0xFA000001}
	g[6] = arm32MemGolden{line: "blx #6", word: 0xFB000001}
	g[7] = arm32MemGolden{line: "blx #-6", word: 0xFBFFFFFE}
	g[8] = arm32MemGolden{line: "blx 8", word: 0xFA000002}
	g[9] = arm32MemGolden{line: "blx #0x1fffffe", word: 0xFB7FFFFF}
	g[10] = arm32MemGolden{line: "blx #-8", word: 0xFAFFFFFE}
	g[11] = arm32MemGolden{line: "b #0xfffffff8", word: 0xEAFFFFFE}
	g[12] = arm32MemGolden{line: "bl #0xfffffff8", word: 0xEBFFFFFE}
	g[13] = arm32MemGolden{line: "blx #0xfffffff8", word: 0xFAFFFFFE}
	g[14] = arm32MemGolden{line: "b #0xfe000000", word: 0xEA800000}
	g[15] = arm32MemGolden{line: "blx #0xfe000000", word: 0xFA800000}
	g[16] = arm32MemGolden{line: "blx #0xfffffffa", word: 0xFBFFFFFE}
	return arm32CheckGoldens(g)
}

// A BL, conditional or not, or a BLX to a label stays a relocation, as clang leaves it for the
// linker to pick BL or BLX by the target's instruction set -- to a local label in the section
// too, and to `.±N` (a label made at `.`); a B to a local label or `.±N` is resolved in place.
// A register's name is a label's in a branch target, or after `#` (or inside an expression) in
// an ADR's; a name clang does not read as a register (d32, s32) is a label's anywhere.
func TestParseArm32BranchRelocations() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, "lbl: nop\nbl lbl", "E320F000 EBFFFFFE ", 1)
	e = arm32PoolCase(e, "bl lbl\nlbl: nop", "EBFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "bleq lbl\nlbl: nop", "0BFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "blx lbl\nlbl: nop", "FAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "lbl: nop\nblx lbl+4", "E320F000 FAFFFFFF ", 1)
	e = arm32PoolCase(e, "b lbl\nlbl: nop", "EAFFFFFF E320F000 ", 0)
	e = arm32PoolCase(e, "bl .+8\nnop\nnop", "EB000000 E320F000 E320F000 ", 1)
	e = arm32PoolCase(e, "blne .", "1BFFFFFE ", 1)
	e = arm32PoolCase(e, "blx .\nnop", "FAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "b .+8\nnop\nnop", "EA000000 E320F000 E320F000 ", 0)
	e = arm32PoolCase(e, "b r1\nr1: nop", "EAFFFFFF E320F000 ", 0)
	e = arm32PoolCase(e, "bl sp\nsp: nop", "EBFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "blx #r1\nr1: nop", "FAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "adr r0, #r1\nr1: nop", "E24F0004 E320F000 ", 0)
	e = arm32PoolCase(e, "adr r0, (r1)\nr1: nop", "E24F0004 E320F000 ", 0)
	e = arm32PoolCase(e, "adr r0, 4+r1\nr1: nop", "E28F0000 E320F000 ", 0)
	e = arm32PoolCase(e, "b d0\nd0: nop", "EAFFFFFF E320F000 ", 0)
	e = arm32PoolCase(e, "bl fpscr\nfpscr: nop", "EBFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "blx d32\nd32: nop", "FAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "adr r0, d32\nd32: nop", "E24F0004 E320F000 ", 0)
	e = arm32PoolCase(e, "ldr r0, s32\ns32: nop", "E51F0004 E320F000 ", 0)
	return e
}

// What clang rejects: a missing or extra operand, a BX / BXJ operand that is no register, a BLX
// number that is odd or out of reach, and a register's name other than a core register's as
// BLX's operand, or any register's as ADR's, a literal load's or a preload's.  Kept differences,
// where clang takes the line but drops part of it: a condition on BLX (immediate), which has
// none; a relocated BLX whose addend is not a multiple of 4 (clang loses its bit 1, having no H
// bit in a relocated BLX); a branch number wider than 32 bits (clang keeps the low 32).
func TestParseArm32BranchRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 28)
	bad[0] = "bx"
	bad[1] = "bxj"
	bad[2] = "blx"
	bad[3] = "blx r1, r2"
	bad[4] = "bx #4"
	bad[5] = "bxj [r1]"
	bad[6] = "blx #3"
	bad[7] = "blx #0x2000000"
	bad[8] = "adr r0, r1"
	bad[9] = "adr r0, sp"
	bad[10] = "adr r0, v1"
	bad[11] = "adr r0, R1"
	bad[12] = "adr r0, r1+4"
	bad[13] = "blxeq ext"
	bad[14] = "blxne ext"
	bad[15] = "bx r1x"
	bad[16] = "blx d0"
	bad[17] = "blx S5"
	bad[18] = "blx apsr"
	bad[19] = "blx fpscr"
	bad[20] = "adr r0, d0"
	bad[21] = "adr r0, cpsr"
	bad[22] = "adr r0, q15"
	bad[23] = "ldr r0, fpscr"
	bad[24] = "pld q15"
	bad[25] = "ldrd r0, r1, d0"
	bad[26] = "b #0x100000000"
	bad[27] = "blx #0x100000000"
	var r testing.TestResult = arm32CheckRejects(bad)
	if len(r) != 0 { return r }
	var src @[]*[]readonly char = make_slice(*[]readonly char, 3)
	src[0] = "blx lbl+2\nlbl: nop"
	src[1] = "blx .+2\nnop"
	src[2] = ".global ext\nblx ext+6"
	for i := 0; i < len(src); i++ {
		var p @Parser = arm32Source(src[i])
		if !p.HasError && !p.Asm.HasError { return fail(buf.Concat(src[i], ": accepted")) }
	}
	return ""
}

// BLX (immediate) needs ARMv5T, as BLX (register) does; BXJ is taken on every architecture, as
// clang takes it.
func TestParseArm32BranchGates() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv4t", "blx #4", "!instruction requires: armv5t")
	e = armGateIs(e, ".cpu arm7tdmi", "blx #4", "!instruction requires: armv5t")
	e = armGateIs(e, ".arch armv5t", "blx #4", "FA000001")
	e = armGateIs(e, ".arch armv4", "bxj r1", "E12FFF21")
	return e
}
