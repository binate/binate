package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// MCR / MRC, MCRR / MRRC and CDP with their 2 forms, each word as clang assembles it: a coprocessor
// and its registers in any case, with or without an `r` after the letter, `#` optional on an
// opcode, MCR / MRC's opc2 optional, MCR's PC and MRC's APSR_nzcv.
func TestParseArm32CoprocMoves() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 32)
	g[0] = arm32MemGolden{line: "mcr p15, 0, r0, c1, c0, 0", word: 0xEE010F10}
	g[1] = arm32MemGolden{line: "mcr p15, 0, r0, c1, c0", word: 0xEE010F10}
	g[2] = arm32MemGolden{line: "mcr p15, #0, r0, c1, c0, #0", word: 0xEE010F10}
	g[3] = arm32MemGolden{line: "mcreq p14, 7, r12, c15, c15, 7", word: 0x0EEFCEFF}
	g[4] = arm32MemGolden{line: "mcr p15, 0, pc, c1, c0, 0", word: 0xEE01FF10}
	g[5] = arm32MemGolden{line: "mcr p15, 0, sp, c1, c0, 0", word: 0xEE01DF10}
	g[6] = arm32MemGolden{line: "mcr P15, 0, R0, C1, C0, 0", word: 0xEE010F10}
	g[7] = arm32MemGolden{line: "mcr p0, 0, r0, c1, c0, 0", word: 0xEE010010}
	g[8] = arm32MemGolden{line: "mrc p15, 0, r0, c1, c0, 0", word: 0xEE110F10}
	g[9] = arm32MemGolden{line: "mrc p15, 0, apsr_nzcv, c1, c0, 0", word: 0xEE11FF10}
	g[10] = arm32MemGolden{line: "mrc p15, 0, sp, c1, c0, 0", word: 0xEE11DF10}
	g[11] = arm32MemGolden{line: "mrc p15, 0, r0, c1, c0, 0x1", word: 0xEE110F30}
	g[12] = arm32MemGolden{line: "mcr2 p15, 0, r0, c1, c0, 0", word: 0xFE010F10}
	g[13] = arm32MemGolden{line: "mrc2 p14, 7, r12, c15, c15, 7", word: 0xFEFFCEFF}
	g[14] = arm32MemGolden{line: "mcrr p15, 0, r0, r1, c2", word: 0xEC410F02}
	g[15] = arm32MemGolden{line: "mcrr p15, 15, r0, r1, c15", word: 0xEC410FFF}
	g[16] = arm32MemGolden{line: "mcrreq p14, 3, r2, r3, c4", word: 0x0C432E34}
	g[17] = arm32MemGolden{line: "mcrr p15, 0, r0, r0, c2", word: 0xEC400F02}
	g[18] = arm32MemGolden{line: "mcrr p15, 0, r0, sp, c2", word: 0xEC4D0F02}
	g[19] = arm32MemGolden{line: "mrrc p15, 0, r0, r1, c2", word: 0xEC510F02}
	g[20] = arm32MemGolden{line: "mrrc p15, 0, r0, r0, c2", word: 0xEC500F02}
	g[21] = arm32MemGolden{line: "mcrr2 p15, 0, r0, r1, c2", word: 0xFC410F02}
	g[22] = arm32MemGolden{line: "mrrc2 p15, 0, r0, r1, c2", word: 0xFC510F02}
	g[23] = arm32MemGolden{line: "cdp p15, 0, c1, c2, c3, 0", word: 0xEE021F03}
	g[24] = arm32MemGolden{line: "cdp p15, 15, c1, c2, c3, 7", word: 0xEEF21FE3}
	g[25] = arm32MemGolden{line: "cdpeq p14, 3, c15, c14, c13, 2", word: 0x0E3EFE4D}
	g[26] = arm32MemGolden{line: "cdp2 p15, 0, c1, c2, c3, 0", word: 0xFE021F03}
	g[27] = arm32MemGolden{line: "cdp2 p14, 15, c15, c14, c13, 7", word: 0xFEFEFEED}
	g[28] = arm32MemGolden{line: "mcr p15, 0, r0, cr1, cr0, 0", word: 0xEE010F10}
	g[29] = arm32MemGolden{line: "mcr PR15, 0, r0, CR1, C0, 0", word: 0xEE010F10}
	g[30] = arm32MemGolden{line: "cdp pr15, 0, cr1, cr2, cr15, 0", word: 0xEE021F0F}
	g[31] = arm32MemGolden{line: "mcrr p15, 0, r0, r1, cr2", word: 0xEC410F02}
	return arm32CheckGoldens(g)
}

// LDC / STC{2}{L} with an immediate offset, writeback, a post-index or an option, each word as
// clang assembles it: the offset with `#`, `$` or neither, `#-0` subtracted, an expression.
func TestParseArm32CoprocLoadStore() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 36)
	g[0] = arm32MemGolden{line: "ldc p15, c1, [r0]", word: 0xED901F00}
	g[1] = arm32MemGolden{line: "ldc p15, c1, [r0, #4]", word: 0xED901F01}
	g[2] = arm32MemGolden{line: "ldc p15, c1, [r0, #-4]", word: 0xED101F01}
	g[3] = arm32MemGolden{line: "ldc p15, c1, [r0, #1020]", word: 0xED901FFF}
	g[4] = arm32MemGolden{line: "ldc p15, c1, [r0, #-0]", word: 0xED101F00}
	g[5] = arm32MemGolden{line: "ldc p15, c1, [r0, #4]!", word: 0xEDB01F01}
	g[6] = arm32MemGolden{line: "ldc p15, c1, [r0]!", word: 0xEDB01F00}
	g[7] = arm32MemGolden{line: "ldc p15, c1, [r0], #4", word: 0xECB01F01}
	g[8] = arm32MemGolden{line: "ldc p15, c1, [r0], #-4", word: 0xEC301F01}
	g[9] = arm32MemGolden{line: "ldc p15, c1, [r0], #-0", word: 0xEC301F00}
	g[10] = arm32MemGolden{line: "ldc p15, c1, [r0], {5}", word: 0xEC901F05}
	g[11] = arm32MemGolden{line: "ldc p15, c1, [r0], {255}", word: 0xEC901FFF}
	g[12] = arm32MemGolden{line: "ldc p15, c1, [pc, #4]", word: 0xED9F1F01}
	g[13] = arm32MemGolden{line: "ldc p15, c1, [pc, #4]!", word: 0xEDBF1F01}
	g[14] = arm32MemGolden{line: "ldc p15, c1, [sp]", word: 0xED9D1F00}
	g[15] = arm32MemGolden{line: "ldcl p15, c1, [r0]", word: 0xEDD01F00}
	g[16] = arm32MemGolden{line: "ldceq p15, c1, [r0, #4]", word: 0x0D901F01}
	g[17] = arm32MemGolden{line: "ldcleq p15, c1, [r0, #4]", word: 0x0DD01F01}
	g[18] = arm32MemGolden{line: "ldc2 p15, c1, [r0]", word: 0xFD901F00}
	g[19] = arm32MemGolden{line: "ldc2l p15, c1, [r0, #4]!", word: 0xFDF01F01}
	g[20] = arm32MemGolden{line: "ldc p15, c1, [r0, 4]", word: 0xED901F01}
	g[21] = arm32MemGolden{line: "ldc p15, c1, [r0, $4]", word: 0xED901F01}
	g[22] = arm32MemGolden{line: "ldc p15, c1, [r0, #4*2]", word: 0xED901F02}
	g[23] = arm32MemGolden{line: "ldc p15, c1, [r0, #-4*2]", word: 0xED101F02}
	g[24] = arm32MemGolden{line: "stc p15, c1, [r0]", word: 0xED801F00}
	g[25] = arm32MemGolden{line: "stc p15, c1, [r0, #-1020]", word: 0xED001FFF}
	g[26] = arm32MemGolden{line: "stc p15, c1, [r0], #4", word: 0xECA01F01}
	g[27] = arm32MemGolden{line: "stc p15, c1, [r0], {7}", word: 0xEC801F07}
	g[28] = arm32MemGolden{line: "stcl p15, c1, [r0, #4]!", word: 0xEDE01F01}
	g[29] = arm32MemGolden{line: "stc2 p15, c1, [r0]", word: 0xFD801F00}
	g[30] = arm32MemGolden{line: "stc2l p15, c1, [r0], #-8", word: 0xFC601F02}
	g[31] = arm32MemGolden{line: "stc p15, c1, [pc], #4", word: 0xECAF1F01}
	g[32] = arm32MemGolden{line: "stceq p15, c1, [r0]", word: 0x0D801F00}
	g[33] = arm32MemGolden{line: "ldcls p15, c1, [r0]", word: 0x9D901F00}
	g[34] = arm32MemGolden{line: "ldc p15, cr1, [r0]", word: 0xED901F00}
	g[35] = arm32MemGolden{line: "stc pr14, cr3, [r0]", word: 0xED803E00}
	return arm32CheckGoldens(g)
}

// A coprocessor load / store of a local label in its own section, or of `.±N`, resolved in place,
// each word as clang assembles it, with no relocation.
func TestParseArm32CoprocLabels() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, "ldc p15, c1, lbl\nlbl: nop", "ED1F1F01 E320F000 ", 0)
	e = arm32PoolCase(e, "lbl: nop\nldc p15, c1, lbl", "E320F000 ED1F1F03 ", 0)
	e = arm32PoolCase(e, "ldc p15, c1, lbl+4\nlbl: nop\nnop", "ED9F1F00 E320F000 E320F000 ", 0)
	e = arm32PoolCase(e, "ldc p15, c1, #lbl\nlbl: nop", "ED1F1F01 E320F000 ", 0)
	e = arm32PoolCase(e, "ldc p15, c1, .+8\nnop\nnop", "ED9F1F00 E320F000 E320F000 ", 0)
	e = arm32PoolCase(e, "ldc p15, c1, .", "ED1F1F02 ", 0)
	e = arm32PoolCase(e, "ldc2 p15, c1, lbl\nlbl: nop", "FD1F1F01 E320F000 ", 0)
	e = arm32PoolCase(e, "ldcl p15, c1, lbl\nlbl: nop", "ED5F1F01 E320F000 ", 0)
	e = arm32PoolCase(e, "stc p15, c1, .-4\nnop", "ED0F1F03 E320F000 ", 0)
	e = arm32PoolCase(e, "ldc p15, c1, .+1028", "ED9F1FFF ", 0)
	e = arm32PoolCase(e, "stc p15, c1, .-1012", "ED0F1FFF ", 0)
	return e
}

// A coprocessor load / store reaches a label 1020 bytes from PC either way, each word as clang
// assembles it.
func TestParseArm32CoprocLabelReach() testing.TestResult {
	var src @[]*[]readonly char = @[]*[]readonly char{"ldc p15, c1, lbl\n.zero 1024\nlbl: nop",
			"lbl: nop\n.zero 1008\nstc p15, c1, lbl"}
	var want @[]*[]readonly char = @[]*[]readonly char{"ED9F1FFF ", "ED0F1FFF "}
	for i := 0; i < len(src); i++ {
		var p @Parser = arm32Source(src[i])
		if p.HasError || p.Asm.HasError { return fail(buf.Concat(src[i], ": rejected")) }
		if !plContains(sectionWordsHex(p, 0), want[i]) {
			return fail(buf.Concat(src[i], ": not clang's word"))
		}
	}
	return ""
}

// What clang rejects of them: a field past its range, a coprocessor or register not so named, MRC's
// PC, MCRR / MRRC's, a 2 form with a condition, a missing or extra operand, an offset that is no
// multiple of 4 or past 1020, a register index, an option past 255, below 0 or after `#`, a number
// target; and a label clang has no relocation for (a global, weak or undefined one, one with
// `(PLT)`, a difference) or past 1020 bytes, or one that is not a multiple of 4 away (a kept
// difference: clang encodes a wrong offset).
func TestParseArm32CoprocRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 41)
	bad[0] = "mcr p15, 8, r0, c1, c0, 0"
	bad[1] = "mcr p15, 0, r0, c1, c0, 8"
	bad[2] = "mcr p16, 0, r0, c1, c0, 0"
	bad[3] = "mcr p15, 0, r0, c16, c0, 0"
	bad[4] = "mcr 15, 0, r0, c1, c0, 0"
	bad[5] = "mcr p15, 0, r0, 1, c0, 0"
	bad[6] = "mcr p15, $0, r0, c1, c0, 0"
	bad[7] = "mcr p01, 0, r0, c1, c0, 0"
	bad[8] = "mrc p15, 0, pc, c1, c0, 0"
	bad[9] = "mrc2 p15, 0, pc, c1, c0, 0"
	bad[10] = "mcrr p15, 16, r0, r1, c2"
	bad[11] = "mcrr p15, 0, pc, r1, c2"
	bad[12] = "mrrc p15, 0, pc, r1, c2"
	bad[13] = "cdp p15, 16, c1, c2, c3, 0"
	bad[14] = "cdp p15, 0, c1, c2, c3, 8"
	bad[15] = "cdp p15, 0, c1, c2, c3"
	bad[16] = "mcr2eq p15, 0, r0, c1, c0, 0"
	bad[17] = "mcrr2eq p15, 0, r0, r1, c2"
	bad[18] = "cdp2eq p15, 0, c1, c2, c3, 0"
	bad[19] = "ldc2eq p15, c1, [r0]"
	bad[20] = "mcr p15, 0, r0, c1, c0, 0, 1"
	bad[21] = "mcr p15, 0, r0"
	bad[22] = "mcr"
	bad[23] = "ldc p15, c1, [r0, #1024]"
	bad[24] = "ldc p15, c1, [r0, #2]"
	bad[25] = "ldc p15, c16, [r0]"
	bad[26] = "ldc p15, c1, [r0, r1]"
	bad[27] = "ldc p15, c1, [r0], r1"
	bad[28] = "ldc p15, c1, [r0, #4]!, #4"
	bad[29] = "ldc p15, c1, [r0], {256}"
	bad[30] = "ldc p15, c1, [r0], {-1}"
	bad[31] = "ldc p15, c1, [r0], {#5}"
	bad[32] = "ldc p15, c1, [r0], #1024"
	bad[33] = "ldc p15, c1, 8"
	bad[34] = "ldc p15, c1, #8"
	bad[35] = "ldc p15, c1, r0"
	bad[36] = "mcr p15, 0, r0, cr01, c0, 0"
	bad[37] = "mcr p15, 0, r0, cr16, c0, 0"
	bad[38] = "mcr pr, 0, r0, c1, c0, 0"
	bad[39] = "mcr p15, 0, r0, cr, c0, 0"
	bad[40] = "ldc p15, c1, .+2"
	var r testing.TestResult = arm32CheckRejects(bad)
	if len(r) != 0 { return r }
	var src @[]*[]readonly char = make_slice(*[]readonly char, 8)
	src[0] = "ldc p15, c1, g\n.global g\ng: nop"
	src[1] = "ldc p15, c1, lbl(PLT)\nlbl: nop"
	src[2] = "ldc p15, c1, lbl\n.uint8 1\nlbl: nop"
	src[3] = "ldc p15, c1, lbl\n.section data\nlbl: .uint32 0"
	src[4] = "ldc p15, c1, w\n.weak w\nw: nop"
	src[5] = "ldc p15, c1, ext"
	src[6] = "ldc p15, c1, lbl\n.zero 1028\nlbl: nop"
	src[7] = "lbl: nop\n.zero 1012\nstc p15, c1, lbl"
	for i := 0; i < len(src); i++ {
		var p @Parser = arm32Source(src[i])
		if !p.HasError && !p.Asm.HasError { return fail(buf.Concat(src[i], ": accepted")) }
	}
	return ""
}

// cpMessageIs appends to e unless the line insn fails with exactly clang's message msg.
func cpMessageIs(e @[]char, insn *[]readonly char, msg *[]readonly char) @[]char {
	var p @Parser = dataSource("arm32", buf.Concat(".section text\n", buf.Concat(insn, "\n")),
			asm.OBJ_ELF)
	var want @[]char = buf.Concat("error: ", msg)
	var n int = len(p.ErrorMsg)
	if p.HasError && n >= len(want) && charsEqual(p.ErrorMsg[n - len(want):n], want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(insn, ": "), buf.Concat(p.ErrorMsg, "\n")))
}

// The messages clang gives for a coprocessor instruction's bad operand: a non-register where MCR's
// Rt goes, where MCRR / MRRC's go (PC as well: clang lists that range among its fixes), where MRC's
// goes; `.±N` past 1020 bytes; a coprocessor register's name as a load / store target; an offset
// that is no multiple of 4 or past 1020; an option or an opcode past its range; a coprocessor not
// so named; a 2 form with a condition.
func TestParseArm32CoprocMessages() testing.TestResult {
	var e @[]char = ""
	var r15 *[]readonly char = "operand must be a register in range [r0, r15]"
	var r14 *[]readonly char = "operand must be a register in range [r0, r14]"
	var bad *[]readonly char = "invalid operand for instruction"
	var far *[]readonly char = "out of range pc-relative fixup value"
	e = cpMessageIs(e, "mcr p15, 0, c1, c1, c0, 0", r15)
	e = cpMessageIs(e, "mcr p15, 0, apsr_nzcv, c1, c0, 0", r15)
	e = cpMessageIs(e, "mcrr p15, 0, c1, r1, c2", r14)
	e = cpMessageIs(e, "mrrc p15, 0, r0, apsr_nzcv, c2", r14)
	e = cpMessageIs(e, "mcrr p15, 0, pc, r1, c2", r14)
	e = cpMessageIs(e, "mrc p15, 0, c1, c1, c0, 0",
			"operand must be a register in range [r0, r14] or apsr_nzcv")
	e = cpMessageIs(e, "ldc p15, c1, .+1032", far)
	e = cpMessageIs(e, "stc p15, c1, .-1028", far)
	e = cpMessageIs(e, "ldc p15, c1, c2", bad)
	e = cpMessageIs(e, "stc p15, c1, CR15", bad)
	e = cpMessageIs(e, "ldc p15, c1, [r0, #1024]", bad)
	e = cpMessageIs(e, "ldc p15, c1, [r0, #2]", bad)
	e = cpMessageIs(e, "ldc p15, c1, [r0], {256}",
			"coprocessor option must be an immediate in range [0, 255]")
	e = cpMessageIs(e, "mcr p15, 8, r0, c1, c0, 0", "operand must be an immediate in the range [0,7]")
	e = cpMessageIs(e, "mcrr p15, 16, r0, r1, c2", "operand must be an immediate in the range [0,15]")
	e = cpMessageIs(e, "mcr p16, 0, r0, c1, c0, 0", bad)
	e = cpMessageIs(e, "mcr2eq p15, 0, r0, c1, c0, 0",
			"instruction 'mcr2' is not predicable, but condition code specified")
	return e
}

// ARMv8 keeps only coprocessors 14 and 15 and drops CDP and the 2 forms, as clang has it; ARMv7
// has them all.
func TestParseArm32CoprocGates() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv8-a", "mcr p15, 0, r0, c1, c0, 0", "EE010F10")
	e = armGateIs(e, ".arch armv8-a", "mrc p14, 0, r0, c1, c0, 0", "EE110E10")
	e = armGateIs(e, ".arch armv8-a", "ldc p15, c1, [r0]", "ED901F00")
	e = armGateIs(e, ".arch armv8-a", "mcrr p14, 0, r0, r1, c2", "EC410E02")
	e = armGateIs(e, ".arch armv8-a", "mcr p13, 0, r0, c1, c0, 0", "!invalid operand for instruction")
	e = armGateIs(e, ".arch armv8-a", "ldc p0, c1, [r0]", "!invalid operand for instruction")
	e = armGateIs(e, ".arch armv8-a", "cdp p15, 0, c1, c2, c3, 0", "!invalid instruction")
	e = armGateIs(e, ".arch armv8-a", "mcr2 p15, 0, r0, c1, c0, 0", "!invalid instruction")
	e = armGateIs(e, ".arch armv8-a", "ldc2 p14, c1, [r0]", "!invalid instruction")
	e = armGateIs(e, ".arch armv7-a", "cdp2 p13, 0, c1, c2, c3, 0", "FE021D03")
	e = armGateIs(e, ".arch armv4", "mcrr p0, 0, r0, r1, c2", "EC410002")
	return e
}
