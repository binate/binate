package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/sys"

// The processor-mode changes, as clang takes them: CPS #mode, CPSIE / CPSID flags{, #mode} (`#`
// optional; the flags a, i and f in any case and order, each once, or `none` in lower case),
// SRS{mode} {SP{!},} #mode and RFE{mode} Rn{!} -- none with a condition.

// arm32SrsRfeMode returns the addressing mode (arm32.BT_*) of SRS or RFE with a mode suffix, none
// meaning IA, whether it is SRS, and whether name is one.  The stack names map by direction:
// SRS stores (FD = DB, FA = IB, EA = IA, ED = DA), RFE loads (FD = IA, FA = DA, EA = DB, ED = IB).
func arm32SrsRfeMode(name *[]readonly char) (int, bool, bool) {
	if len(name) != 3 && len(name) != 5 { return 0, false, false }
	var srs bool = mnemIs(name[0:3], "srs")
	if !srs && !mnemIs(name[0:3], "rfe") { return 0, false, false }
	if len(name) == 3 { return arm32.BT_IA, srs, true }
	var sufs @[]*[]readonly char = @[]*[]readonly char{"ia", "ib", "da", "db", "fd", "fa", "ea", "ed"}
	var store @[]int = @[]int{arm32.BT_IA, arm32.BT_IB, arm32.BT_DA, arm32.BT_DB, arm32.BT_DB,
			arm32.BT_IB, arm32.BT_IA, arm32.BT_DA}
	var load @[]int = @[]int{arm32.BT_IA, arm32.BT_IB, arm32.BT_DA, arm32.BT_DB, arm32.BT_IA,
			arm32.BT_DA, arm32.BT_DB, arm32.BT_IB}
	for i := 0; i < len(sufs); i++ {
		if !mnemIs(name[3:5], sufs[i]) { continue }
		if srs { return store[i], true, true }
		return load[i], false, true
	}
	return 0, false, false
}

// arm32IsModeChangeMnem reports whether name is CPS, CPSIE, CPSID, or SRS or RFE with a mode
// suffix or none.
func arm32IsModeChangeMnem(name *[]readonly char) bool {
	_, _, ok := arm32SrsRfeMode(name)
	return ok || mnemIs(name, "cps") || mnemIs(name, "cpsie") || mnemIs(name, "cpsid")
}

// parseArm32ModeChange assembles CPS / CPSIE / CPSID, SRS or RFE (baseMnem; l the lexer after
// the mnemonic), reporting whether baseMnem is one.
func parseArm32ModeChange(p @Parser, l Lexer, baseMnem *[]readonly char, cond int) bool {
	mode, srs, ok := arm32SrsRfeMode(baseMnem)
	var cps bool = mnemIs(baseMnem, "cps") || mnemIs(baseMnem, "cpsie") || mnemIs(baseMnem, "cpsid")
	if !ok && !cps { return false }
	if cond != arm32.COND_AL {
		if cps {
			arm32NotPredicable(p, "cps")
		} else {
			arm32NotPredicable(p, baseMnem)
		}
		return true
	}
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind == TOK_EOF {
		// clang takes CPSIE / CPSID with no flag as CPS #2 / #3, which changes to no mode there is.
		setErr(p, "too few operands for instruction")
		return true
	}
	if cps {
		parseArm32Cps(p, l, tok, baseMnem)
	} else if srs {
		parseArm32Srs(p, l, tok, mode)
	} else {
		parseArm32Rfe(p, l, tok, mode)
	}
	return true
}

// parseArm32ModeNumber parses a mode number, 0..31, from tok (`#` optional) through the end of the
// line, returning it, or ok false with p's error set.
func parseArm32ModeNumber(p @Parser, l Lexer, tok Token) (int, bool) {
	var r ExprResult
	l, tok, r = parseArm32OperandExpr(p, l, tok)
	if !r.Ok || r.FromDiff || r.Val < 0 || r.Val > 31 {
		setErr(p, "operand must be an immediate in the range [0,31]")
		return 0, false
	}
	if !arm32EndOfOperands(p, tok) { return 0, false }
	return cast(int, r.Val), true
}

// parseArm32Cps assembles CPS (name: cps, cpsie or cpsid) from its first operand, tok.
func parseArm32Cps(p @Parser, l Lexer, tok Token, name *[]readonly char) {
	if mnemIs(name, "cps") {
		mode, ok := parseArm32ModeNumber(p, l, tok)
		if ok { sys.Cps(p.Asm, sys.CPS_NONE, 0, mode) }
		return
	}
	var flags int = 0
	var none bool = tok.Kind == TOK_IDENT && charsEqual(tok.Text, "none")
	if tok.Kind == TOK_IDENT && !none {
		for i := 0; i < len(tok.Text); i++ {
			var c char = arm32Lower(tok.Text[i])
			var bit int = 0
			if c == 'a' { bit = sys.CPS_A }
			if c == 'i' { bit = sys.CPS_I }
			if c == 'f' { bit = sys.CPS_F }
			if bit == 0 || flags & bit != 0 {
				flags = 0
				break
			}
			flags = flags | bit
		}
	}
	if flags == 0 && !none {
		setErr(p, "invalid operand for instruction")
		return
	}
	var imod int = sys.CPS_IE
	if mnemIs(name, "cpsid") { imod = sys.CPS_ID }
	l, tok = LexNext(l)
	if tok.Kind == TOK_COMMA {
		l, tok = LexNext(l)
		mode, ok := parseArm32ModeNumber(p, l, tok)
		if ok { sys.Cps(p.Asm, imod, flags, mode) }
		return
	}
	if arm32AtEOL(p, tok) { sys.Cps(p.Asm, imod, flags, -1) }
}

// parseArm32Srs assembles SRS in mode (arm32.BT_*) from its first operand, tok: SP, with `!` to
// write back, then the mode number, or the mode number alone.
func parseArm32Srs(p @Parser, l Lexer, tok Token, mode int) {
	var writeback bool = false
	if tok.Kind == TOK_LBRACKET || (tok.Kind == TOK_IDENT && parseArm32Reg(tok.Text) >= 0) {
		if tok.Kind != TOK_IDENT || parseArm32Reg(tok.Text) != arm32.SP {
			setErr(p, "operand must be a register sp")
			return
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_BANG {
			writeback = true
			l, tok = LexNext(l)
		}
		if tok.Kind != TOK_COMMA {
			setErr(p, "too few operands for instruction")
			return
		}
		l, tok = LexNext(l)
	}
	number, ok := parseArm32ModeNumber(p, l, tok)
	if ok { sys.Srs(p.Asm, mode, writeback, number) }
}

// parseArm32Rfe assembles RFE in mode (arm32.BT_*) from its operand, tok: Rn, with `!` to write
// back.
func parseArm32Rfe(p @Parser, l Lexer, tok Token, mode int) {
	var rn int = -1
	if tok.Kind == TOK_IDENT { rn = parseArm32Reg(tok.Text) }
	if rn < 0 {
		setErr(p, "operand must be a register in range [r0, r15]")
		return
	}
	var writeback bool = false
	l, tok = LexNext(l)
	if tok.Kind == TOK_BANG {
		writeback = true
		l, tok = LexNext(l)
	}
	if tok.Kind == TOK_COMMA {
		setErr(p, "invalid operand for instruction")
		return
	}
	if arm32AtEOL(p, tok) { sys.Rfe(p.Asm, mode, rn, writeback) }
}
