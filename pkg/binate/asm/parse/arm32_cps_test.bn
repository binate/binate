package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// CPS #mode (`#` optional) and CPSIE / CPSID of a, i and f in any case and order, or of `none`
// (in lower case), with a mode or none, each word as clang assembles it.
func TestParseArm32Cps() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 21)
	g[0] = arm32MemGolden{line: "cps #16", word: 0xF1020010}
	g[1] = arm32MemGolden{line: "cps #0x1f", word: 0xF102001F}
	g[2] = arm32MemGolden{line: "cps 16", word: 0xF1020010}
	g[3] = arm32MemGolden{line: "cpsie i", word: 0xF1080080}
	g[4] = arm32MemGolden{line: "cpsie a", word: 0xF1080100}
	g[5] = arm32MemGolden{line: "cpsie f", word: 0xF1080040}
	g[6] = arm32MemGolden{line: "cpsie aif", word: 0xF10801C0}
	g[7] = arm32MemGolden{line: "cpsid if", word: 0xF10C00C0}
	g[8] = arm32MemGolden{line: "cpsie i, #16", word: 0xF10A0090}
	g[9] = arm32MemGolden{line: "cpsid aif, #0x13", word: 0xF10E01D3}
	g[10] = arm32MemGolden{line: "cpsie fia", word: 0xF10801C0}
	g[11] = arm32MemGolden{line: "cpsie I", word: 0xF1080080}
	g[12] = arm32MemGolden{line: "CPSID AIF", word: 0xF10C01C0}
	g[13] = arm32MemGolden{line: "cpsie i,#16", word: 0xF10A0090}
	g[14] = arm32MemGolden{line: "cpsie i, 16", word: 0xF10A0090}
	g[15] = arm32MemGolden{line: "cpsid A", word: 0xF10C0100}
	g[16] = arm32MemGolden{line: "cpsie fi, #31", word: 0xF10A00DF}
	g[17] = arm32MemGolden{line: "cpsie none", word: 0xF1080000}
	g[18] = arm32MemGolden{line: "cpsid none", word: 0xF10C0000}
	g[19] = arm32MemGolden{line: "cpsie none, #16", word: 0xF10A0010}
	g[20] = arm32MemGolden{line: "cpsid none, #31", word: 0xF10E001F}
	return arm32CheckGoldens(g)
}

// SRS and RFE in each addressing mode, the stack names mapped by direction (SRS FD is DB, RFE FD
// is IA), with and without writeback, SRS's SP optional and its `#` too, each word as clang
// assembles it.
func TestParseArm32SrsRfe() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 29)
	g[0] = arm32MemGolden{line: "srs sp!, #16", word: 0xF8ED0510}
	g[1] = arm32MemGolden{line: "srs sp, #16", word: 0xF8CD0510}
	g[2] = arm32MemGolden{line: "srsdb sp!, #19", word: 0xF96D0513}
	g[3] = arm32MemGolden{line: "srsia sp, #0x1f", word: 0xF8CD051F}
	g[4] = arm32MemGolden{line: "srsda sp, #19", word: 0xF84D0513}
	g[5] = arm32MemGolden{line: "srsib sp!, #19", word: 0xF9ED0513}
	g[6] = arm32MemGolden{line: "srsfd sp!, #19", word: 0xF96D0513}
	g[7] = arm32MemGolden{line: "srsea sp, #19", word: 0xF8CD0513}
	g[8] = arm32MemGolden{line: "srsfa sp, #19", word: 0xF9CD0513}
	g[9] = arm32MemGolden{line: "srsed sp, #19", word: 0xF84D0513}
	g[10] = arm32MemGolden{line: "srs #19", word: 0xF8CD0513}
	g[11] = arm32MemGolden{line: "srsdb #19", word: 0xF94D0513}
	g[12] = arm32MemGolden{line: "srs sp!, 19", word: 0xF8ED0513}
	g[13] = arm32MemGolden{line: "srs 19", word: 0xF8CD0513}
	g[14] = arm32MemGolden{line: "srs SP!, #19", word: 0xF8ED0513}
	g[15] = arm32MemGolden{line: "srs sp !, #19", word: 0xF8ED0513}
	g[16] = arm32MemGolden{line: "rfe r0", word: 0xF8900A00}
	g[17] = arm32MemGolden{line: "rfe r0!", word: 0xF8B00A00}
	g[18] = arm32MemGolden{line: "rfeia r1", word: 0xF8910A00}
	g[19] = arm32MemGolden{line: "rfedb r2!", word: 0xF9320A00}
	g[20] = arm32MemGolden{line: "rfeda r3", word: 0xF8130A00}
	g[21] = arm32MemGolden{line: "rfeib r4!", word: 0xF9B40A00}
	g[22] = arm32MemGolden{line: "rfefd r5", word: 0xF8950A00}
	g[23] = arm32MemGolden{line: "rfeea r6", word: 0xF9160A00}
	g[24] = arm32MemGolden{line: "rfefa r7", word: 0xF8170A00}
	g[25] = arm32MemGolden{line: "rfeed r8", word: 0xF9980A00}
	g[26] = arm32MemGolden{line: "rfe pc", word: 0xF89F0A00}
	g[27] = arm32MemGolden{line: "rfe sp!", word: 0xF8BD0A00}
	g[28] = arm32MemGolden{line: "rfe r0 !", word: 0xF8B00A00}
	return arm32CheckGoldens(g)
}

// What clang rejects of them: a mode past 31, a condition, a repeated or unknown flag, a mode
// in a flag's place, `$` or an undefined name, an SRS base other than SP, a bracketed register, a
// second RFE operand, `none` in another case or with a flag.  A kept difference: CPSIE / CPSID
// with no flag, which clang takes as CPS #2 / #3 (no mode there is), are errors.
func TestParseArm32ModeChangeRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 21)
	bad[0] = "cps #32"
	bad[1] = "cpseq #16"
	bad[2] = "cpsie"
	bad[3] = "cpsid"
	bad[4] = "cpsie ii"
	bad[5] = "cpsie aaif"
	bad[6] = "cpsie #16"
	bad[7] = "cpsie, i"
	bad[8] = "cps $16"
	bad[9] = "cps #N"
	bad[10] = "srs sp!, #32"
	bad[11] = "srseq sp, #19"
	bad[12] = "srs r0, #19"
	bad[13] = "srs [sp]!, #19"
	bad[14] = "srs sp!, $19"
	bad[15] = "srs sp"
	bad[16] = "rfeeq r0"
	bad[17] = "rfe [r0]"
	bad[18] = "rfe r0, r1"
	bad[19] = "cpsie NONE"
	bad[20] = "cpsie nonea"
	return arm32CheckRejects(bad)
}
