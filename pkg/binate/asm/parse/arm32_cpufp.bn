package "pkg/binate/asm/parse"

// armCPUFP returns the FP features (arm32_fpfeat.bn) clang gives CPU name -- one of the ARM (A32)
// CPUs armCPUFeats knows -- for the instructions after a `.cpu` naming it: VFPv2 on the ARM11s
// with an F and mpcore; VFPv3 with 16 D registers on the Cortex-R4F and R5, with the half
// conversions on the R7 and R8; NEON on the Cortex-A8, with the half conversions on the A9 and
// with VFPv4 on the other ARMv7-A CPUs; ARMv8's FP and NEON on the ARMv8 and ARMv9 CPUs, with
// crypto, the dot products, full FP16, its multiply-adds, BF16 and the int8 matrix multiplies as
// each has them; none on the rest.
func armCPUFP(name *[]readonly char) uint64 {
	var v8 uint64 = armFpV8 | armFpNEON
	var crypto uint64 = v8 | armFpCrypto
	var mm uint64 = armFpDotProd | armFpBF16 | armFpI8MM
	if charsEqual(name, "arm1136jf-s") || charsEqual(name, "arm1156t2f-s") ||
			charsEqual(name, "arm1176jzf-s") || charsEqual(name, "mpcore") {
		return armFPSet(0, armFpVFP2)
	}
	if charsEqual(name, "cortex-r4f") || charsEqual(name, "cortex-r5") {
		return armFPSet(0, armFpVFP3D16)
	}
	if charsEqual(name, "cortex-r7") || charsEqual(name, "cortex-r8") {
		return armFPSet(0, armFpVFP3D16 | armFpHalf)
	}
	if charsEqual(name, "cortex-a8") { return armFPSet(0, armFpNEON) }
	if charsEqual(name, "cortex-a9") { return armFPSet(0, armFpNEON | armFpHalf) }
	if charsEqual(name, "cortex-a5") || charsEqual(name, "cortex-a7") ||
			charsEqual(name, "cortex-a12") || charsEqual(name, "cortex-a15") ||
			charsEqual(name, "cortex-a17") || charsEqual(name, "krait") || charsEqual(name, "swift") {
		return armFPSet(0, armFpNEON | armFpVFP4)
	}
	if charsEqual(name, "cortex-a32") || charsEqual(name, "cortex-a35") ||
			charsEqual(name, "cortex-a53") || charsEqual(name, "cortex-a57") ||
			charsEqual(name, "cortex-a72") || charsEqual(name, "cortex-a73") ||
			charsEqual(name, "cyclone") || charsEqual(name, "exynos-m3") || charsEqual(name, "kryo") {
		return armFPSet(0, crypto)
	}
	if charsEqual(name, "cortex-a55") || charsEqual(name, "cortex-a75") ||
			charsEqual(name, "neoverse-n1") {
		return armFPSet(0, crypto | armFpDotProd)
	}
	if charsEqual(name, "cortex-a76") || charsEqual(name, "cortex-a76ae") ||
			charsEqual(name, "cortex-a77") || charsEqual(name, "cortex-a78") ||
			charsEqual(name, "cortex-a78ae") || charsEqual(name, "cortex-a78c") ||
			charsEqual(name, "cortex-x1") || charsEqual(name, "cortex-x1c") ||
			charsEqual(name, "exynos-m4") || charsEqual(name, "exynos-m5") {
		return armFPSet(0, crypto | armFpFullFP16 | armFpDotProd)
	}
	if charsEqual(name, "neoverse-v1") { return armFPSet(0, crypto | armFpFullFP16 | mm) }
	if charsEqual(name, "cortex-a510") || charsEqual(name, "cortex-a710") ||
			charsEqual(name, "neoverse-n2") {
		return armFPSet(0, v8 | armFpFP16FML | mm)
	}
	if charsEqual(name, "cortex-r52") || charsEqual(name, "cortex-r52plus") {
		return armFPSet(0, v8)
	}
	return 0
}
