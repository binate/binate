package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// `.cpu` sets clang's FP features for each ARM (A32) CPU (fpSeen, arm32_fpfeat_test.bn).
func TestArm32CPUFP() testing.TestResult {
	var e @[]char = ""
	e = fpIs(e, ".cpu arm1020e", "")
	e = fpIs(e, ".cpu arm1020t", "")
	e = fpIs(e, ".cpu arm1022e", "")
	e = fpIs(e, ".cpu arm10e", "")
	e = fpIs(e, ".cpu arm10tdmi", "")
	e = fpIs(e, ".cpu arm1136j-s", "")
	e = fpIs(e, ".cpu arm1136jf-s", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".cpu arm1156t2-s", "")
	e = fpIs(e, ".cpu arm1156t2f-s", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".cpu arm1176jz-s", "")
	e = fpIs(e, ".cpu arm1176jzf-s", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".cpu arm710t", "")
	e = fpIs(e, ".cpu arm720t", "")
	e = fpIs(e, ".cpu arm7tdmi", "")
	e = fpIs(e, ".cpu arm7tdmi-s", "")
	e = fpIs(e, ".cpu arm8", "")
	e = fpIs(e, ".cpu arm810", "")
	e = fpIs(e, ".cpu arm9", "")
	e = fpIs(e, ".cpu arm920", "")
	e = fpIs(e, ".cpu arm920t", "")
	e = fpIs(e, ".cpu arm922t", "")
	e = fpIs(e, ".cpu arm926ej-s", "")
	e = fpIs(e, ".cpu arm940t", "")
	e = fpIs(e, ".cpu arm946e-s", "")
	e = fpIs(e, ".cpu arm966e-s", "")
	e = fpIs(e, ".cpu arm968e-s", "")
	e = fpIs(e, ".cpu arm9e", "")
	e = fpIs(e, ".cpu arm9tdmi", "")
	e = fpIs(e, ".cpu cortex-a12", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a15", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a17", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a32", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a35", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a5", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a510",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon ffp16 fml dot bf16 i8mm d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a53", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a55",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a57", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a7", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a710",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon ffp16 fml dot bf16 i8mm d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a72", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a73", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a75",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a76",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a76ae",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a77",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a78",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a78ae",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a78c",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a8", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a9", "vfp2 fp64 d32 vfp3 fp16 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-r4", "")
	e = fpIs(e, ".cpu cortex-r4f", "vfp2 fp64 vfp3 regs regs64")
	e = fpIs(e, ".cpu cortex-r5", "vfp2 fp64 vfp3 regs regs64")
	e = fpIs(e, ".cpu cortex-r52", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-r52plus", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-r7", "vfp2 fp64 vfp3 fp16 regs regs64")
	e = fpIs(e, ".cpu cortex-r8", "vfp2 fp64 vfp3 fp16 regs regs64")
	e = fpIs(e, ".cpu cortex-x1",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-x1c",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cyclone", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu ep9312", "")
	e = fpIs(e, ".cpu exynos-m3", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu exynos-m4",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu exynos-m5",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu generic", "")
	e = fpIs(e, ".cpu iwmmxt", "")
	e = fpIs(e, ".cpu krait", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu kryo", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".cpu mpcore", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".cpu mpcorenovfp", "")
	e = fpIs(e, ".cpu neoverse-n1",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot d32sp regs regs64")
	e = fpIs(e, ".cpu neoverse-n2",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon ffp16 fml dot bf16 i8mm d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu neoverse-v1",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 dot bf16 i8mm d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu strongarm", "")
	e = fpIs(e, ".cpu strongarm110", "")
	e = fpIs(e, ".cpu strongarm1100", "")
	e = fpIs(e, ".cpu strongarm1110", "")
	e = fpIs(e, ".cpu swift", "vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".cpu xscale", "")
	return e
}
