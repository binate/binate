package "pkg/binate/asm/parse"

// armCPUFeats returns the features of CPU name — one of clang's ARM (A32) CPUs — for the
// instructions after a `.cpu` naming it, and whether it is one.  Each CPU has its
// architecture's levels and the extensions clang gives it, which differ even within a level
// (cortex-a7 / a12 / a15 / a17 divide in ARM state, a5 / a8 / a9 do not).  `generic`, and the
// ARMv4 CPUs (arm8, strongarm ..), have no level beyond ARMv4.
func armCPUFeats(name *[]readonly char) (uint64, bool) {
	var v4t uint64 = armV4T
	var v5t uint64 = v4t | armV5T
	var v5te uint64 = v5t | armV5TE
	var v6 uint64 = v5te | armV6
	var v6k uint64 = v6 | armV6K
	var v6t2 uint64 = v6k | armV6T2
	var v7 uint64 = v6t2 | armV7
	var v8 uint64 = v7 | armV8
	var v82 uint64 = v8 | armV8_1 | armV8_2
	var v84 uint64 = v82 | armV8_3 | armV8_4
	var v9 uint64 = v84 | armV8_5 | armV9
	// The extensions most ARMv7-A / ARMv8 CPUs have.
	var a7x uint64 = armHwDivArm | armMP | armSec | armVirt
	if charsEqual(name, "arm1020e") { return v5te, true }
	if charsEqual(name, "arm1020t") { return v5t, true }
	if charsEqual(name, "arm1022e") { return v5te, true }
	if charsEqual(name, "arm10e") { return v5te, true }
	if charsEqual(name, "arm10tdmi") { return v5t, true }
	if charsEqual(name, "arm1136j-s") { return v6, true }
	if charsEqual(name, "arm1136jf-s") { return v6, true }
	if charsEqual(name, "arm1156t2-s") { return v6t2, true }
	if charsEqual(name, "arm1156t2f-s") { return v6t2, true }
	if charsEqual(name, "arm1176jz-s") { return v6k | armSec, true }
	if charsEqual(name, "arm1176jzf-s") { return v6k | armSec, true }
	if charsEqual(name, "arm710t") { return v4t, true }
	if charsEqual(name, "arm720t") { return v4t, true }
	if charsEqual(name, "arm7tdmi") { return v4t, true }
	if charsEqual(name, "arm7tdmi-s") { return v4t, true }
	if charsEqual(name, "arm8") { return 0, true }
	if charsEqual(name, "arm810") { return 0, true }
	if charsEqual(name, "arm9") { return v4t, true }
	if charsEqual(name, "arm920") { return v4t, true }
	if charsEqual(name, "arm920t") { return v4t, true }
	if charsEqual(name, "arm922t") { return v4t, true }
	if charsEqual(name, "arm926ej-s") { return v5te, true }
	if charsEqual(name, "arm940t") { return v4t, true }
	if charsEqual(name, "arm946e-s") { return v5te, true }
	if charsEqual(name, "arm966e-s") { return v5te, true }
	if charsEqual(name, "arm968e-s") { return v5te, true }
	if charsEqual(name, "arm9e") { return v5te, true }
	if charsEqual(name, "arm9tdmi") { return v4t, true }
	if charsEqual(name, "cortex-a12") { return v7 | a7x, true }
	if charsEqual(name, "cortex-a15") { return v7 | a7x, true }
	if charsEqual(name, "cortex-a17") { return v7 | a7x, true }
	if charsEqual(name, "cortex-a32") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "cortex-a35") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "cortex-a5") { return v7 | armMP | armSec, true }
	if charsEqual(name, "cortex-a510") { return v9 | a7x | armCRC | armRAS | armSB, true }
	if charsEqual(name, "cortex-a53") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "cortex-a55") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a57") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "cortex-a7") { return v7 | a7x, true }
	if charsEqual(name, "cortex-a710") { return v9 | a7x | armCRC | armRAS | armSB, true }
	if charsEqual(name, "cortex-a72") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "cortex-a73") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "cortex-a75") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a76") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a76ae") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a77") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a78") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a78ae") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a78c") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-a8") { return v7 | armSec, true }
	if charsEqual(name, "cortex-a9") { return v7 | armMP | armSec, true }
	if charsEqual(name, "cortex-r4") { return v7 | armRProf, true }
	if charsEqual(name, "cortex-r4f") { return v7 | armRProf, true }
	if charsEqual(name, "cortex-r5") { return v7 | armRProf | armHwDivArm, true }
	if charsEqual(name, "cortex-r52") {
		return v8 | armRProf | armHwDivArm | armMP | armVirt | armCRC, true
	}
	if charsEqual(name, "cortex-r52plus") {
		return v8 | armRProf | armHwDivArm | armMP | armVirt | armCRC, true
	}
	if charsEqual(name, "cortex-r7") { return v7 | armRProf | armHwDivArm | armMP, true }
	if charsEqual(name, "cortex-r8") { return v7 | armRProf | armHwDivArm | armMP, true }
	if charsEqual(name, "cortex-x1") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cortex-x1c") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "cyclone") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "ep9312") { return v4t, true }
	if charsEqual(name, "exynos-m3") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "exynos-m4") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "exynos-m5") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "generic") { return 0, true }
	if charsEqual(name, "iwmmxt") { return v5te, true }
	if charsEqual(name, "krait") { return v7 | armHwDivArm, true }
	if charsEqual(name, "kryo") { return v8 | a7x | armCRC, true }
	if charsEqual(name, "mpcore") { return v6k, true }
	if charsEqual(name, "mpcorenovfp") { return v6k, true }
	if charsEqual(name, "neoverse-n1") { return v82 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "neoverse-n2") { return v9 | a7x | armCRC | armRAS | armSB, true }
	if charsEqual(name, "neoverse-v1") { return v84 | a7x | armCRC | armRAS, true }
	if charsEqual(name, "strongarm") { return 0, true }
	if charsEqual(name, "strongarm110") { return 0, true }
	if charsEqual(name, "strongarm1100") { return 0, true }
	if charsEqual(name, "strongarm1110") { return 0, true }
	if charsEqual(name, "swift") { return v7 | armHwDivArm | armMP, true }
	if charsEqual(name, "xscale") { return v5te, true }
	return 0, false
}
