package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// armGateIs is in arm32_feat_test.bn.

// `.cpu` gives the CPU's features: the ARMv4 CPUs (and `generic`) lack bx; the ARMv4T ones blx
// and clz; ARMv5TE / ARMv6 ones movw; cortex-a8 / a9 / r4 hardware divide, which a7 / a15 / r5 /
// v8 CPUs have; and `.arch` / `.cpu` replace each other's features, the later one winning.
func TestArm32CPUGating() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".cpu strongarm", "bx lr", "!instruction requires: armv4t")
	e = armGateIs(e, ".cpu generic", "bx lr", "!instruction requires: armv4t")
	e = armGateIs(e, ".cpu arm7tdmi", "bx lr", "E12FFF1E")
	e = armGateIs(e, ".cpu arm7tdmi", "clz r0, r1", "!instruction requires: armv5t")
	e = armGateIs(e, ".cpu arm926ej-s", "blx r1", "E12FFF31")
	e = armGateIs(e, ".cpu arm1136j-s", "movw r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".cpu arm1136j-s", "nop", "E1A00000")
	e = armGateIs(e, ".cpu arm1176jz-s", "nop", "E320F000")
	e = armGateIs(e, ".cpu arm1156t2-s", "movw r0, #1", "E3000001")
	e = armGateIs(e, ".cpu cortex-a8", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".cpu cortex-a9", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".cpu cortex-r4", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".cpu cortex-a7", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-r5", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-a53", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-a15\n.arch armv6", "clz r0, r1", "E16F0F11")
	e = armGateIs(e, ".cpu cortex-a15\n.arch armv6", "movw r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv6\n.cpu cortex-a15", "movw r0, #1", "E3000001")
	if len(e) > 0 { return fail(e) }
	return ""
}
