package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// armGateIs is in arm32_feat_test.bn.

// `.cpu` gives the CPU's features: the ARMv4 CPUs (and `generic`) lack bx; the ARMv4T ones blx
// and clz; ARMv5TE / ARMv6 ones movw; cortex-a8 / a9 / r4 hardware divide, which a7 / a15 / r5 /
// v8 CPUs have; and `.arch` / `.cpu` replace each other's features, the later one winning.
func TestArm32CPUGating() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".cpu strongarm", "bx lr", "!instruction requires: armv4t")
	e = armGateIs(e, ".cpu generic", "bx lr", "!instruction requires: armv4t")
	e = armGateIs(e, ".cpu arm7tdmi", "bx lr", "E12FFF1E")
	e = armGateIs(e, ".cpu arm7tdmi", "clz r0, r1", "!instruction requires: armv5t")
	e = armGateIs(e, ".cpu arm926ej-s", "blx r1", "E12FFF31")
	e = armGateIs(e, ".cpu arm1136j-s", "movw r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".cpu arm1136j-s", "nop", "E1A00000")
	e = armGateIs(e, ".cpu arm1176jz-s", "nop", "E320F000")
	e = armGateIs(e, ".cpu arm1156t2-s", "movw r0, #1", "E3000001")
	e = armGateIs(e, ".cpu cortex-a8", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".cpu cortex-a9", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".cpu cortex-r4", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".cpu cortex-a7", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-r5", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-a53", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".cpu cortex-a15\n.arch armv6", "clz r0, r1", "E16F0F11")
	e = armGateIs(e, ".cpu cortex-a15\n.arch armv6", "movw r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv6\n.cpu cortex-a15", "movw r0, #1", "E3000001")
	if len(e) > 0 { return fail(e) }
	return ""
}

// armCPUGroupIs appends to e a failure unless each CPU in cpus (space-separated) gates bx lr, clz,
// movw, sdiv and nop's hint form as flags says, a '+' or '-' for each in that order.
func armCPUGroupIs(e @[]char, flags *[]readonly char, cpus *[]readonly char) @[]char {
	var insns @[]*[]readonly char = @[]*[]readonly char{"bx lr", "clz r0, r1", "movw r0, #1",
			"sdiv r0, r0, r1", "nop"}
	var ok @[]*[]readonly char = @[]*[]readonly char{"E12FFF1E", "E16F0F11", "E3000001", "E710F110",
			"E320F000"}
	var no @[]*[]readonly char = @[]*[]readonly char{"!instruction requires: armv4t",
			"!instruction requires: armv5t", "!instruction requires: armv6t2",
			"!instruction requires: divide in ARM", "E1A00000"}
	var start int = 0
	for i := 0; i <= len(cpus); i++ {
		if i < len(cpus) && cpus[i] != ' ' { continue }
		var ctx @[]char = buf.Concat(".cpu ", cpus[start:i])
		for k := 0; k < len(insns); k++ {
			var want *[]readonly char = no[k]
			if flags[k] == '+' { want = ok[k] }
			e = armGateIs(e, ctx, insns[k], want)
		}
		start = i + 1
	}
	return e
}

// Every CPU clang knows gates the instructions as clang has it (probed: bx at ARMv4T, clz at
// ARMv5T, movw at ARMv6T2, sdiv with hardware divide, nop's hint at ARMv6K).
func TestArm32CPUTableGating() testing.TestResult {
	var e @[]char = ""
	e = armCPUGroupIs(e, "++---",
			"arm1020e arm1020t arm1022e arm10e arm10tdmi arm1136j-s arm1136jf-s "
					"arm926ej-s arm946e-s arm966e-s arm968e-s arm9e iwmmxt xscale")
	e = armCPUGroupIs(e, "+++-+",
			"arm1156t2-s arm1156t2f-s cortex-a5 cortex-a8 cortex-a9 cortex-r4 "
					"cortex-r4f")
	e = armCPUGroupIs(e, "++--+", "arm1176jz-s arm1176jzf-s mpcore mpcorenovfp")
	e = armCPUGroupIs(e, "+----",
			"arm710t arm720t arm7tdmi arm7tdmi-s arm9 arm920 arm920t arm922t "
					"arm940t arm9tdmi ep9312")
	e = armCPUGroupIs(e, "-----",
			"arm8 arm810 generic strongarm strongarm110 strongarm1100 strongarm1110")
	e = armCPUGroupIs(e, "+++++",
			"cortex-a12 cortex-a15 cortex-a17 cortex-a32 cortex-a35 cortex-a510 "
					"cortex-a53 cortex-a55 cortex-a57 cortex-a7 cortex-a710 cortex-a72 "
					"cortex-a73 cortex-a75 cortex-a76 cortex-a76ae cortex-a77 cortex-a78 "
					"cortex-a78ae cortex-a78c cortex-r5 cortex-r52 cortex-r52plus "
					"cortex-r7 cortex-r8 cortex-x1 cortex-x1c cyclone exynos-m3 exynos-m4 "
					"exynos-m5 krait kryo neoverse-n1 neoverse-n2 neoverse-v1 swift")
	if len(e) > 0 { return fail(e) }
	return ""
}
