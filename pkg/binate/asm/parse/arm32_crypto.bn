package "pkg/binate/asm/parse"

// The two-register crypto instructions -- AESE, AESD, AESMC and AESIMC (.8, any 8-bit type
// standing for it) with AES, SHA1H, SHA1SU1 and SHA256SU0 (.32, any 32-bit type standing for it)
// with SHA2, each with ARMv8, on two Q registers -- as clang takes them: NEON's two-register ones
// (arm32_neon2.bn), their mnemonics split as clang splits every mnemonic, but no condition nor a
// flag-setting `s` on a name starting with aes, sha1 or sha256, whether or not it names one
// (aesimcs is aesim with CS, "instruction 'aesim' is not predicable, ...").

// arm32CryptoPrefix reports whether name (lowercase) starts with aes, sha1 or sha256, the names
// clang takes no condition and no `s` on.
func arm32CryptoPrefix(name *[]readonly char) bool {
	var prefixes @[]*[]readonly char = @[]*[]readonly char{"aes", "sha1", "sha256"}
	for i := 0; i < len(prefixes); i++ {
		var n int = len(prefixes[i])
		if len(name) >= n && charsEqual(name[0:n], prefixes[i]) { return true }
	}
	return false
}

// parseArm32Crypto assembles a crypto instruction, mnem the mnemonic as written and l the lexer
// after it, reporting whether mnem starts as one does (arm32CryptoPrefix): an `s` after the name,
// then a condition, is clang's error, as is a name that names none.
func parseArm32Crypto(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	if !arm32CryptoPrefix(lower[0:dot]) { return false }
	name, cond, carry := arm32VdpSplit(lower[0:dot])
	if carry {
		arm32VfpFlagsErr(p, name)
		return true
	}
	if !arm32NeonUnconditional(p, name, cond) { return true }
	if arm32Neon2Op(name) == 0 {
		arm32VdpNone(p, l)
		return true
	}
	arm32VdpMatch(p, l, name, cond, lower[dot:len(lower)])
	return true
}
