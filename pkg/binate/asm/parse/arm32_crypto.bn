package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// The crypto instructions -- AESE, AESD, AESMC and AESIMC (.8, any 8-bit type standing for it) with
// AES, and SHA1H, SHA1SU1 and SHA256SU0 (.32, any 32-bit type standing for it) with SHA2, on two Q
// registers; SHA1C, SHA1P, SHA1M, SHA1SU0, SHA256H, SHA256H2 and SHA256SU1 (.32, any 32-bit type
// standing for it) with SHA2 on three; each with ARMv8 -- as clang takes them: the two-register
// ones among NEON's (arm32_neon2.bn), their mnemonics split as clang splits every mnemonic, but no
// condition nor a flag-setting `s` on a name starting with aes, sha1 or sha256, whether or not it
// names one (aesimcs is aesim with CS, "instruction 'aesim' is not predicable, ...").

// arm32CryptoPrefix reports whether name (lowercase) starts with aes, sha1 or sha256, the names
// clang takes no condition and no `s` on.
func arm32CryptoPrefix(name *[]readonly char) bool {
	var prefixes @[]*[]readonly char = @[]*[]readonly char{"aes", "sha1", "sha256"}
	for i := 0; i < len(prefixes); i++ {
		var n int = len(prefixes[i])
		if len(name) >= n && charsEqual(name[0:n], prefixes[i]) { return true }
	}
	return false
}

// parseArm32Crypto assembles a crypto instruction, mnem the mnemonic as written and l the lexer
// after it, reporting whether mnem starts as one does (arm32CryptoPrefix): an `s` after the name,
// then a condition, is clang's error, as is a name that names none.
func parseArm32Crypto(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	if !arm32CryptoPrefix(lower[0:dot]) { return false }
	name, cond, carry := arm32VdpSplit(lower[0:dot])
	if carry {
		arm32VfpFlagsErr(p, name)
		return true
	}
	if !arm32NeonUnconditional(p, name, cond) { return true }
	if arm32Neon2Op(name) == 0 && arm32Crypto3Op(name) == 0 {
		arm32VdpNone(p, l)
		return true
	}
	arm32VdpMatch(p, l, name, cond, lower[dot:len(lower)])
	return true
}

// arm32Crypto3Op returns the operation (neon.THREE_SHA1C .. THREE_SHA256SU1) name (lowercase,
// split) has on three Q registers, or 0.
func arm32Crypto3Op(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"sha1c", "sha1p", "sha1m", "sha1su0",
			"sha256h", "sha256h2", "sha256su1"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return neon.THREE_SHA1C + i }
	}
	return 0
}

// arm32Crypto3Cands returns the one encoding clang has for a three-register crypto name: .32 on
// three Q registers, with no condition operand, SHA2's feature with ARMv8's.
func arm32Crypto3Cands() @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 1)
	var q int = matchKindQ
	matchAdd(list, matchType32, 0, matchOps(q, q, q), matchNeedSHA2 | matchNeedV8, matchFormSIMDNoCond)
	return list
}

// arm32Crypto3Emit assembles name (arm32Crypto3Op) on its three Q registers, items.
func arm32Crypto3Emit(p @Parser, name *[]readonly char, items @[]arm32MatchItem) {
	neon.Three(p.Asm, arm32Crypto3Op(name), neon.DT_32, arm32NeonReg(items[0]), arm32NeonReg(items[1]),
			arm32NeonReg(items[2]))
}
