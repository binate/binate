package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// arm32CryptoCtx is the directives that give the crypto instructions their features: ARMv8 with
// the crypto FPU (AES, SHA2 and NEON).
var arm32CryptoCtx *[]readonly char = ".arch armv8-a\n.fpu crypto-neon-fp-armv8"

// Only names starting with aes, sha1 or sha256 are the crypto names' (not shadd8's).
func TestArm32CryptoPrefix() testing.TestResult {
	if !arm32CryptoPrefix("aesimc") || !arm32CryptoPrefix("sha1heq") || !arm32CryptoPrefix("sha256x") {
		return fail("a crypto name is not one")
	}
	if arm32CryptoPrefix("shadd8") || arm32CryptoPrefix("sha2") || arm32CryptoPrefix("ae") {
		return fail("another name is a crypto one")
	}
	return ""
}

// The crypto instructions as clang assembles them: each name, the 8- and 32-bit types any type of
// the size stands for, high registers, upper case, and AES or SHA2 alone with ARMv8; and a core
// name starting with sha (shadd8) as before.
func TestParseArm32CryptoForms() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32CryptoCtx
	e = armGateIs(e, c, "aese.8 q0, q1", "F3B00302")
	e = armGateIs(e, c, "aesd.8 q0, q1", "F3B00342")
	e = armGateIs(e, c, "aesmc.8 q0, q1", "F3B00382")
	e = armGateIs(e, c, "aesimc.8 q0, q1", "F3B003C2")
	e = armGateIs(e, c, "sha1h.32 q0, q1", "F3B902C2")
	e = armGateIs(e, c, "sha1su1.32 q0, q1", "F3BA0382")
	e = armGateIs(e, c, "sha256su0.32 q0, q1", "F3BA03C2")
	e = armGateIs(e, c, "aese.8 q15, q14", "F3F0E32C")
	e = armGateIs(e, c, "sha256su0.32 q8, q15", "F3FA03EE")
	e = armGateIs(e, c, "aese.p8 q0, q1", "F3B00302")
	e = armGateIs(e, c, "sha1h.f32 q0, q1", "F3B902C2")
	e = armGateIs(e, c, "AESE.8 Q0, Q1", "F3B00302")
	e = armGateIs(e, ".arch armv8-a\n.fpu neon-fp-armv8\n.arch_extension aes", "aese.8 q0, q1",
			"F3B00302")
	e = armGateIs(e, ".arch armv8-a\n.fpu neon-fp-armv8\n.arch_extension sha2", "sha1h.32 q0, q1",
			"F3B902C2")
	e = armGateIs(e, c, "shadd8 r0, r1, r2", "E6310F92")
	return e
}

// What clang does not take of them, with its message: a feature missing, D registers, an operand
// too few or too many, another size or none, no condition and no `s` on a name starting with aes,
// sha1 or sha256 (whether or not it names one), and a name that names none.
func TestParseArm32CryptoRejects() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32CryptoCtx
	var v8 *[]readonly char = ".arch armv8-a\n.fpu neon-fp-armv8"
	e = armMsgIs(e, "", "aese.8 q0, q1", "instruction requires: aes armv8")
	e = armMsgIs(e, "", "sha1h.32 q0, q1", "instruction requires: sha2 armv8")
	e = armMsgIs(e, v8, "aese.8 q0, q1", "instruction requires: aes")
	e = armMsgIs(e, v8, "sha1h.32 q0, q1", "instruction requires: sha2")
	e = armMsgIs(e, c, "aese.8 d0, d1", "invalid instruction")
	e = armMsgIs(e, c, "aese.8 q0, d1", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "aese.8 q0", "too few operands for instruction")
	e = armMsgIs(e, c, "aese.8 q0, q1, q2", "too many operands for instruction")
	e = armMsgIs(e, c, "aese.32 q0, q1", "invalid operand for instruction")
	e = armMsgIs(e, c, "aese q0, q1", "invalid instruction")
	e = armMsgIs(e, c, "aeseeq.8 q0, q1",
			"instruction 'aese' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "aesimcs.8 q0, q1",
			"instruction 'aesim' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "aeses.8 q0, q1",
			"instruction 'aese' can not set flags, but 's' suffix specified")
	e = armMsgIs(e, c, "aesms.8 q0, q1",
			"instruction 'aesm' can not set flags, but 's' suffix specified")
	e = armMsgIs(e, c, "sha1hseq.32 q0, q1",
			"instruction 'sha1h' can not set flags, but 's' suffix specified")
	e = armMsgIs(e, c, "aesx.8 q0, q1", "invalid instruction")
	return e
}
