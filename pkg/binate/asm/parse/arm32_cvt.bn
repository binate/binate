package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// The VFP conversions and ARMv8's FP instructions (asm/arm32/vfp), as clang takes them: VCVT
// between precisions, with 32-bit integers and with fixed point; VCVTR; VCVTB / VCVTT with half
// precision and BFloat16; VCVTA / VCVTN / VCVTP / VCVTM; VJCVT; VRINTA .. VRINTX; VSELEQ / VSELVS
// / VSELGE / VSELGT; VMAXNM / VMINNM; and the pre-UAL names fsitos .. ftouizd.  Clang splits the
// mnemonic into a name, a condition and an `s` (arm32CvtSplit), reads the data types from its
// suffixes, and matches the types and operands against each encoding the name has
// (arm32CvtCands): the first that matches is assembled, else its near misses make the error
// (arm32_cvt_match.bn).

// The instructions (arm32CvtName).
const (
	cvtVcvt int = iota
	cvtVcvtr
	cvtVcvtb
	cvtVcvtt
	cvtVcvta
	cvtVcvtn
	cvtVcvtp
	cvtVcvtm
	cvtVjcvt
	cvtVrinta
	cvtVrintn
	cvtVrintp
	cvtVrintm
	cvtVrintr
	cvtVrintz
	cvtVrintx
	cvtVseleq
	cvtVselvs
	cvtVselge
	cvtVselgt
	cvtVmaxnm
	cvtVminnm
	cvtNames
)

// arm32CvtName returns the name of instruction i (cvtVcvt .. cvtVminnm).
func arm32CvtName(i int) *[]readonly char {
	if i == cvtVcvt { return "vcvt" }
	if i == cvtVcvtr { return "vcvtr" }
	if i == cvtVcvtb { return "vcvtb" }
	if i == cvtVcvtt { return "vcvtt" }
	if i == cvtVcvta { return "vcvta" }
	if i == cvtVcvtn { return "vcvtn" }
	if i == cvtVcvtp { return "vcvtp" }
	if i == cvtVcvtm { return "vcvtm" }
	if i == cvtVjcvt { return "vjcvt" }
	if i == cvtVrinta { return "vrinta" }
	if i == cvtVrintn { return "vrintn" }
	if i == cvtVrintp { return "vrintp" }
	if i == cvtVrintm { return "vrintm" }
	if i == cvtVrintr { return "vrintr" }
	if i == cvtVrintz { return "vrintz" }
	if i == cvtVrintx { return "vrintx" }
	if i == cvtVseleq { return "vseleq" }
	if i == cvtVselvs { return "vselvs" }
	if i == cvtVselge { return "vselge" }
	if i == cvtVselgt { return "vselgt" }
	if i == cvtVmaxnm { return "vmaxnm" }
	return "vminnm"
}

// arm32CvtIndex returns the instruction name names (lowercase), or -1.
func arm32CvtIndex(name *[]readonly char) int {
	for i := 0; i < cvtNames; i++ {
		if charsEqual(name, arm32CvtName(i)) { return i }
	}
	return -1
}

// arm32CvtUnpredicable reports whether instruction i takes no condition: VCVTA .. VCVTM, VRINTA ..
// VRINTM, VSEL and VMAXNM / VMINNM.
func arm32CvtUnpredicable(i int) bool {
	return (i >= cvtVcvta && i <= cvtVcvtm) || (i >= cvtVrinta && i <= cvtVrintm) || i >= cvtVseleq
}

// arm32CvtSplit splits head, a lowercase mnemonic before its first `.`, as clang does: a condition
// off the end, then an `s` (whether there was one returned) -- neither from a name it keeps whole,
// one of VCVTA .. VCVTM, VRINTA .. VRINTM, VMAXNM and VMINNM, or any name starting with vsel.
func arm32CvtSplit(head *[]readonly char) (*[]readonly char, int, bool) {
	var i int = arm32CvtIndex(head)
	var whole bool = len(head) >= 4 && charsEqual(head[0:4], "vsel")
	if whole || (i >= 0 && arm32CvtUnpredicable(i)) { return head, arm32.COND_AL, false }
	var cond int = arm32.COND_AL
	if len(head) > 2 {
		var c int = parseArm32CondCode(head[len(head) - 2:len(head)])
		if c >= 0 {
			cond = c
			head = head[0:len(head) - 2]
		}
	}
	if len(head) > 0 && head[len(head) - 1] == 's' { return head[0:len(head) - 1], cond, true }
	return head, cond, false
}

// arm32CvtAlias returns the index of the pre-UAL name name (lowercase), one of fsitos, fsitod,
// fuitos, fuitod, ftosis, ftosid, ftouis, ftouid, ftosizs, ftosizd, ftouizs and ftouizd, or -1.
func arm32CvtAlias(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"fsitos", "fsitod", "fuitos", "fuitod",
			"ftosis", "ftosid", "ftouis", "ftouid", "ftosizs", "ftosizd", "ftouizs", "ftouizd"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return i }
	}
	return -1
}

// arm32CvtAliasIs returns the instruction pre-UAL name a (arm32CvtAlias) is and its data types:
// fsito* and fuito* VCVT from a signed or unsigned integer, ftosi* and ftoui* VCVTR to one,
// ftosiz* and ftouiz* VCVT to one, the float .F32 after an `s` and .F64 after a `d`.
func arm32CvtAliasIs(a int) (int, int, int) {
	var float int = cvtTypeF32
	if a % 2 == 1 { float = cvtTypeF64 }
	var integer int = cvtTypeS32
	if (a / 2) % 2 == 1 { integer = cvtTypeU32 }
	if a < 4 { return cvtVcvt, float, integer }
	if a < 8 { return cvtVcvtr, integer, float }
	return cvtVcvt, integer, float
}

// arm32CvtAliasStem reports whether name starts with a pre-UAL name's stem (fsito, fuito, ftosi,
// ftoui), where clang reads the `s` of a name that is not whole as a flag-setting suffix.
func arm32CvtAliasStem(name *[]readonly char) bool {
	if len(name) < 5 { return false }
	var stem *[]readonly char = name[0:5]
	return charsEqual(stem, "fsito") || charsEqual(stem, "fuito") || charsEqual(stem, "ftosi") ||
			charsEqual(stem, "ftoui")
}

// The data types of a mnemonic's suffixes (arm32CvtType), 0 for none.
const (
	cvtTypeF16 int = iota + 1
	cvtTypeF32                // .f32, or clang's .f
	cvtTypeF64                // .f64, or clang's .d
	cvtTypeS16
	cvtTypeU16
	cvtTypeS32
	cvtTypeU32
	cvtTypeBF16
	cvtTypeOther              // no type any encoding has
)

// arm32CvtType returns the data type the suffix t (lowercase, no `.`) names (cvtType*).
func arm32CvtType(t *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"f16", "f32", "f64", "s16", "u16", "s32",
			"u32", "bf16"}
	for i := 0; i < len(names); i++ {
		if charsEqual(t, names[i]) { return cvtTypeF16 + i }
	}
	if charsEqual(t, "f") { return cvtTypeF32 }
	if charsEqual(t, "d") { return cvtTypeF64 }
	return cvtTypeOther
}

// arm32CvtSuffixes reads the data types among the `.` suffixes rest (lowercase, from the first
// `.`) as clang does -- `.w` is none, `.n` its error -- into types (up to three kept), returning
// how many there are and whether there is no `.n`, setting the error if there is.
func arm32CvtSuffixes(p @Parser, rest *[]readonly char, types @[]int) (int, bool) {
	var n int = 0
	var start int = 1
	for i := 1; i <= len(rest); i++ {
		if i < len(rest) && rest[i] != '.' { continue }
		var part *[]readonly char = rest[start:i]
		start = i + 1
		if charsEqual(part, "w") { continue }
		if charsEqual(part, "n") {
			setErr(p, "instruction with .n (narrow) qualifier not allowed in arm mode")
			return 0, false
		}
		if n < len(types) { types[n] = arm32CvtType(part) }
		n = n + 1
	}
	return n, true
}

// parseArm32Cvt assembles a VFP conversion or one of ARMv8's FP instructions, mnem the mnemonic as
// written and l the lexer after it, reporting whether mnem names one.
func parseArm32Cvt(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) < 4 || (arm32Lower(mnem[0]) != 'v' && arm32Lower(mnem[0]) != 'f') { return false }
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	var head @[]char = lower[0:dot]
	var types @[]int = make_slice(int, 3)
	// A pre-UAL name, whole and with VFPv2, is the VCVT or VCVTR it stands for.
	var a int = arm32CvtAlias(head)
	if a >= 0 && dot == len(mnem) && p.Arm32FP & armFpVFP2SP != 0 {
		var idx int
		idx, types[0], types[1] = arm32CvtAliasIs(a)
		parseArm32CvtOperands(p, l, idx, arm32.COND_AL, types, 2)
		return true
	}
	name, cond, carry := arm32CvtSplit(head)
	var idx int = arm32CvtIndex(name)
	if carry {
		// After an `s`, a condition clang did not split off: vcvteqs is VCVTEQ with an `s`.
		var base *[]readonly char = name
		if len(name) > 2 && parseArm32CondCode(name[len(name) - 2:len(name)]) >= 0 {
			base = name[0:len(name) - 2]
		}
		if idx < 0 && arm32CvtIndex(base) < 0 && !charsEqual(base, "vrint") && !arm32CvtAliasStem(name) {
			return false
		}
		arm32VfpFlagsErr(p, name)
		return true
	}
	if idx < 0 {
		// No instruction clang has: a pre-UAL name that is not whole, vrint, or a name starting vsel
		// (which clang never splits) that is none of VSELEQ, VSELVS, VSELGE, VSELGT.
		var vsel bool = len(head) >= 4 && charsEqual(head[0:4], "vsel")
		if arm32CvtAlias(name) < 0 && !charsEqual(name, "vrint") && !vsel { return false }
		// clang reports a `.n` before it looks for the instruction.
		_, narrowOk := arm32CvtSuffixes(p, lower[dot:len(lower)], types)
		if narrowOk { setErr(p, "invalid instruction") }
		return true
	}
	if cond != arm32.COND_AL && arm32CvtUnpredicable(idx) {
		setErr(p,
				buf.Concat(buf.Concat("instruction '", name),
						"' is not predicable, but condition code specified"))
		return true
	}
	nt, ok := arm32CvtSuffixes(p, lower[dot:len(lower)], types)
	if !ok { return true }
	parseArm32CvtOperands(p, l, idx, cond, types, nt)
	return true
}
