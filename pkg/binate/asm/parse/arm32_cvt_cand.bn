package "pkg/binate/asm/parse"

// The conversion instructions' encodings, as clang matches them (arm32_match_cand.bn).

// arm32CvtCands returns instruction idx's encodings in the order clang tries them: by how many
// types and operands (a condition operand included) they have, fewest first.
func arm32CvtCands(idx int) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 128)
	var s int = matchKindS
	var d int = matchKindD
	var q int = matchKindQ
	var vfp2 int = matchNeedVFP2
	var dp int = matchNeedVFP2 | matchNeedDP
	var full int = matchNeedFull16
	var neon int = matchNeedNEON
	var f16 int = matchTypeF16
	var f32 int = matchTypeF32
	var f64 int = matchTypeF64
	var s16 int = matchTypeS16
	var u16 int = matchTypeU16
	var s32 int = matchTypeS32
	var u32 int = matchTypeU32
	if idx == cvtVcvt {
		matchAddPairs(list, @[]int{f64, f32, f64, s32, f64, u32}, matchOps(d, s, 0), dp, matchFormVFP)
		matchAdd(list, f32, f64, matchOps(s, d, 0), dp, matchFormVFP)
		matchAddPairs(list, @[]int{f32, s32, f32, u32, s32, f32, u32, f32}, matchOps(s, s, 0), vfp2,
				matchFormVFP)
		matchAddPairs(list, @[]int{f16, s32, f16, u32, s32, f16, u32, f16}, matchOps(s, s, 0), full,
				matchFormVFP)
		matchAddPairs(list, @[]int{s32, f64, u32, f64}, matchOps(s, d, 0), dp, matchFormVFP)
		var neon32 @[]int = @[]int{s32, f32, u32, f32, f32, s32, f32, u32}
		var neon16 @[]int = @[]int{s16, f16, u16, f16, f16, s16, f16, u16}
		matchAddPairs(list, neon32, matchOps(d, d, 0), neon, matchFormNEON)
		matchAddPairs(list, neon32, matchOps(q, q, 0), neon, matchFormNEON)
		matchAddPairs(list, neon16, matchOps(d, d, 0), neon | full, matchFormNEON)
		matchAddPairs(list, neon16, matchOps(q, q, 0), neon | full, matchFormNEON)
		matchAdd(list, f16, f32, matchOps(d, q, 0), neon | matchNeedHalf, matchFormNEON)
		matchAdd(list, f32, f16, matchOps(q, d, 0), neon | matchNeedHalf, matchFormNEON)
		matchAdd(list, matchTypeBF16, f32, matchOps(d, q, 0), matchNeedBF16 | neon, matchFormNEON)
		matchAddPairs(list, neon32, matchOps(matchKindMQ, matchKindMQ, 0), matchNeedMVEFP, matchFormMVE)
		matchAddPairs(list, neon16, matchOps(matchKindMQ, matchKindMQ, 0), matchNeedMVEFP, matchFormMVE)
		var fb16 int = matchKindFbits16
		var fb32 int = matchKindFbits32
		cvtAddFixed(list, f16, s, full, fb16, fb32)
		cvtAddFixed(list, f32, s, vfp2, fb16, fb32)
		cvtAddFixed(list, f64, d, dp, fb16, fb32)
		matchAddPairs(list, neon32, matchOps(d, d, matchKindImm), neon, matchFormNEON)
		matchAddPairs(list, neon32, matchOps(q, q, matchKindImm), neon, matchFormNEON)
		matchAddPairs(list, neon16, matchOps(d, d, matchKindImm), neon | full, matchFormNEON)
		matchAddPairs(list, neon16, matchOps(q, q, matchKindImm), neon | full, matchFormNEON)
		matchAddPairs(list, neon32, matchOps(d, d, matchKindZero), neon, matchFormNEON)
		matchAddPairs(list, neon32, matchOps(q, q, matchKindZero), neon, matchFormNEON)
		matchAddPairs(list, neon16, matchOps(d, d, matchKindZero), neon, matchFormNEON)
		matchAddPairs(list, neon16, matchOps(q, q, matchKindZero), neon, matchFormNEON)
		matchAddPairs(list, neon32, matchOps(matchKindMQ, matchKindMQ, matchKindMFbits32), matchNeedMVEFP,
				matchFormMVE)
		matchAddPairs(list, neon16, matchOps(matchKindMQ, matchKindMQ, matchKindMFbits16), matchNeedMVEFP,
				matchFormMVE)
	} else if idx == cvtVcvtr {
		matchAddPairs(list, @[]int{s32, f64, u32, f64}, matchOps(s, d, 0), dp, matchFormVFP)
		matchAddPairs(list, @[]int{s32, f32, u32, f32}, matchOps(s, s, 0), vfp2, matchFormVFP)
		matchAddPairs(list, @[]int{s32, f16, u32, f16}, matchOps(s, s, 0), full, matchFormVFP)
	} else if idx == cvtVcvtb || idx == cvtVcvtt {
		matchAddPairs(list, @[]int{f32, f16, f16, f32}, matchOps(s, s, 0), matchNeedHalf, matchFormVFP)
		matchAdd(list, f64, f16, matchOps(d, s, 0), matchNeedV8FP | matchNeedDP, matchFormVFP)
		matchAdd(list, f16, f64, matchOps(s, d, 0), matchNeedV8FP | matchNeedDP, matchFormVFP)
		matchAdd(list, matchTypeBF16, f32, matchOps(s, s, 0), matchNeedBF16, matchFormVFP)
		matchAddPairs(list, @[]int{f16, f32, f32, f16}, matchOps(matchKindMQ, matchKindMQ, 0),
				matchNeedMVEFP, matchFormMVE)
	} else if idx >= cvtVcvta && idx <= cvtVcvtm {
		var vfp int = matchFormVFPNoCond
		matchAddPairs(list, @[]int{s32, f16, u32, f16}, matchOps(s, s, 0), full, vfp)
		matchAddPairs(list, @[]int{s32, f32, u32, f32}, matchOps(s, s, 0), matchNeedV8FP, vfp)
		matchAddPairs(list, @[]int{s32, f64, u32, f64}, matchOps(s, d, 0), matchNeedV8FP | matchNeedDP,
				vfp)
		var v8 int = matchNeedV8 | neon
		matchAddPairs(list, @[]int{s32, f32, u32, f32}, matchOps(d, d, 0), v8, matchFormNEONNoCond)
		matchAddPairs(list, @[]int{s32, f32, u32, f32}, matchOps(q, q, 0), v8, matchFormNEONNoCond)
		matchAddPairs(list, @[]int{s16, f16, u16, f16}, matchOps(d, d, 0), v8 | full, matchFormNEONNoCond)
		matchAddPairs(list, @[]int{s16, f16, u16, f16}, matchOps(q, q, 0), v8 | full, matchFormNEONNoCond)
		matchAddPairs(list, @[]int{s32, f32, u32, f32, s16, f16, u16, f16},
				matchOps(matchKindMQ, matchKindMQ, 0), matchNeedMVEFP, matchFormMVE)
	} else if idx == cvtVjcvt {
		matchAdd(list, s32, f64, matchOps(s, d, 0), matchNeedV8FP | matchNeedV8_3, matchFormVFP)
	} else if idx >= cvtVrinta && idx <= cvtVrintx {
		cvtAddRint(list, idx)
	} else {
		cvtAddThree(list, idx)
	}
	for i := 1; i < list.n; i++ {
		var c arm32MatchCand = list.c[i]
		var j int = i
		for j > 0 && arm32MatchLength(list.c[j - 1]) > arm32MatchLength(c) {
			list.c[j] = list.c[j - 1]
			j = j - 1
		}
		list.c[j] = c
	}
	return list
}

// cvtAddFixed appends the fixed-point VCVTs on floating point of type float (in register kind
// reg, needing need): to and from 16- and 32-bit integers, with their fraction bits' kinds fb16
// and fb32.
func cvtAddFixed(list @arm32MatchList, float int, reg int, need int, fb16 int, fb32 int) {
	var ints @[]int = @[]int{matchTypeS16, matchTypeU16, matchTypeS32, matchTypeU32}
	for i := 0; i < len(ints); i++ {
		var fb int = fb16
		if i >= 2 { fb = fb32 }
		matchAdd(list, ints[i], float, matchOps(reg, reg, fb), need, matchFormVFP)
		matchAdd(list, float, ints[i], matchOps(reg, reg, fb), need, matchFormVFP)
	}
}

// cvtAddRint appends VRINT idx's encodings: .F16 / .F32 / .F64 and clang's .F16.F16 / .F32.F32 /
// .F64.F64, and NEON's but for VRINTR.
func cvtAddRint(list @arm32MatchList, idx int) {
	var s int = matchKindS
	var d int = matchKindD
	var q int = matchKindQ
	var full int = matchNeedFull16
	var neon int = matchNeedNEON
	var v8 int = matchNeedV8 | neon
	var f16 int = matchTypeF16
	var f32 int = matchTypeF32
	var f64 int = matchTypeF64
	var vfp int = matchFormVFP
	if idx <= cvtVrintm { vfp = matchFormVFPNoCond }
	matchAdd(list, f16, 0, matchOps(s, s, 0), full, vfp)
	matchAdd(list, f32, 0, matchOps(s, s, 0), matchNeedV8FP, vfp)
	matchAdd(list, f64, 0, matchOps(d, d, 0), matchNeedV8FP | matchNeedDP, vfp)
	if idx != cvtVrintr {
		matchAdd(list, f32, 0, matchOps(d, d, 0), v8, matchFormNEONNoCond)
		matchAdd(list, f32, 0, matchOps(q, q, 0), v8, matchFormNEONNoCond)
		matchAdd(list, f16, 0, matchOps(d, d, 0), v8 | full, matchFormNEONNoCond)
		matchAdd(list, f16, 0, matchOps(q, q, 0), v8 | full, matchFormNEONNoCond)
		matchAdd(list, f32, 0, matchOps(matchKindMQ, matchKindMQ, 0), matchNeedMVEFP, matchFormMVE)
		matchAdd(list, f16, 0, matchOps(matchKindMQ, matchKindMQ, 0), matchNeedMVEFP, matchFormMVE)
	}
	matchAdd(list, f16, f16, matchOps(s, s, 0), full, vfp)
	matchAdd(list, f32, f32, matchOps(s, s, 0), matchNeedV8FP, vfp)
	matchAdd(list, f64, f64, matchOps(d, d, 0), matchNeedV8FP | matchNeedDP, vfp)
	if idx != cvtVrintr {
		matchAdd(list, f32, f32, matchOps(d, d, 0), neon, matchFormNEONNoCond)
		matchAdd(list, f32, f32, matchOps(q, q, 0), neon, matchFormNEONNoCond)
		matchAdd(list, f16, f16, matchOps(d, d, 0), neon | full, matchFormNEONNoCond)
		matchAdd(list, f16, f16, matchOps(q, q, 0), neon | full, matchFormNEONNoCond)
	}
}

// cvtAddThree appends VSEL's or VMAXNM / VMINNM's (idx) encodings: .F16 / .F32 / .F64 on three
// registers, and NEON's for VMAXNM / VMINNM.
func cvtAddThree(list @arm32MatchList, idx int) {
	var s int = matchKindS
	var d int = matchKindD
	var q int = matchKindQ
	var full int = matchNeedFull16
	var v8fp int = matchNeedV8FP
	var vfp int = matchFormVFPNoCond
	matchAdd(list, matchTypeF16, 0, matchOps(s, s, s), full, vfp)
	matchAdd(list, matchTypeF32, 0, matchOps(s, s, s), v8fp, vfp)
	matchAdd(list, matchTypeF64, 0, matchOps(d, d, d), v8fp | matchNeedDP, vfp)
	if idx < cvtVmaxnm { return }
	var neon int = v8fp | matchNeedNEON
	matchAdd(list, matchTypeF32, 0, matchOps(d, d, d), neon, matchFormNEONNoCond)
	matchAdd(list, matchTypeF32, 0, matchOps(q, q, q), neon, matchFormNEONNoCond)
	matchAdd(list, matchTypeF16, 0, matchOps(d, d, d), neon | full, matchFormNEONNoCond)
	matchAdd(list, matchTypeF16, 0, matchOps(q, q, q), neon | full, matchFormNEONNoCond)
	var mq int = matchKindMQ
	matchAdd(list, matchTypeF32, 0, matchOps(mq, mq, mq), matchNeedMVEFP, matchFormMVE)
	matchAdd(list, matchTypeF16, 0, matchOps(mq, mq, mq), matchNeedMVEFP, matchFormMVE)
}
