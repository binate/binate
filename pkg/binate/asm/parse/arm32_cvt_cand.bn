package "pkg/binate/asm/parse"

// The encodings clang matches a conversion's types and operands against (arm32CvtCands): each
// with its data types, its operands' kinds and the features it needs, NEON's and MVE's as well as
// the VFP's -- they decide what clang reports when none matches, and a form NEON's matches is
// reported as not supported.

// The features an encoding needs (arm32CvtCand.need), in the order clang names missing ones.  MVE
// (M-profile's vector extension, Thumb only) is never in effect here, but clang offers its
// encodings in ARM code too, as "instruction requires: mve.fp".
const (
	cvtNeedBF16 int = 1    // "BFloat16 floating point extension"
	cvtNeedDP int = 2      // "double precision VFP"
	cvtNeedHalf int = 4    // "half-float conversions"
	cvtNeedV8FP int = 8    // "FPARMv8"
	cvtNeedFull16 int = 16 // "full half-float"
	cvtNeedMVEFP int = 32  // "mve.fp"
	cvtNeedNEON int = 64   // "NEON"
	cvtNeedV8 int = 128    // "armv8"
	cvtNeedV8_3 int = 256  // "armv8.3a"
	cvtNeedVFP2 int = 512  // "VFP2"
)

// The kinds of an encoding's operands (arm32CvtCand.ops): an S, D or Q register; a fixed-point
// VCVT's fraction bits for 16 or 32 bits as clang bounds them (0 .. 17, 1 .. 33); any immediate;
// the number 0 (NEON's VCVT with no fraction bits); an MVE Q register (Q0 .. Q7); MVE's fraction
// bits for 16 or 32 bits (1 .. 16, 1 .. 32).
const (
	cvtKindS int = iota + 1
	cvtKindD
	cvtKindQ
	cvtKindFbits16
	cvtKindFbits32
	cvtKindImm
	cvtKindZero
	cvtKindMQ
	cvtKindMFbits16
	cvtKindMFbits32
)

// The kinds of encoding (arm32CvtCand.form): the VFP's, assembled here, with a condition operand
// or (VCVTA .. VCVTM, VRINTA .. VRINTM, VSEL, VMAXNM / VMINNM) without one; NEON's with one, and
// without one (VRINT*, VCVTA .. VCVTM, VMAXNM / VMINNM); MVE's, which have none either, but a
// predicate operand of their own that clang counts in ordering them.  clang matches a written
// condition, other than AL, against an encoding's condition operand, and against its first type or
// operand where it has none.
const (
	cvtFormVFP int = iota
	cvtFormVFPNoCond
	cvtFormNEON
	cvtFormNEONNoCond
	cvtFormMVE
)

// arm32CvtCand is one encoding of a conversion instruction: its data types (cvtType*, 0 for none),
// its operands' kinds (cvtKind*, four bits each from the first, 0 past the last), the features it
// needs (cvtNeed*), and its kind (cvtForm*).
type arm32CvtCand struct {
	t1   int
	t2   int
	ops  int
	need int
	form int
}

// arm32CvtCandList collects an instruction's encodings in the order clang tries them.
type arm32CvtCandList struct {
	c @[]arm32CvtCand
	n int
}

// cvtOps packs operand kinds a, b and c (0 for none) as arm32CvtCand.ops does.
func cvtOps(a int, b int, c int) int { return a | (b << 4) | (c << 8) }

// cvtAdd appends an encoding to list.
func cvtAdd(list @arm32CvtCandList, t1 int, t2 int, ops int, need int, form int) {
	var c arm32CvtCand
	c.t1 = t1
	c.t2 = t2
	c.ops = ops
	c.need = need
	c.form = form
	list.c[list.n] = c
	list.n = list.n + 1
}

// cvtAddPairs appends, for each data-type pair in pairs (two entries each), an encoding on the
// operand kinds ops with the features need.
func cvtAddPairs(list @arm32CvtCandList, pairs @[]int, ops int, need int, form int) {
	for i := 0; i + 1 < len(pairs); i = i + 2 { cvtAdd(list, pairs[i], pairs[i + 1], ops, need, form) }
}

// arm32CvtCands returns instruction idx's encodings in the order clang tries them: by how many
// types and operands (a condition operand included) they have, fewest first.
func arm32CvtCands(idx int) @arm32CvtCandList {
	var list @arm32CvtCandList = make(arm32CvtCandList)
	list.c = make_slice(arm32CvtCand, 128)
	var s int = cvtKindS
	var d int = cvtKindD
	var q int = cvtKindQ
	var vfp2 int = cvtNeedVFP2
	var dp int = cvtNeedVFP2 | cvtNeedDP
	var full int = cvtNeedFull16
	var neon int = cvtNeedNEON
	var f16 int = cvtTypeF16
	var f32 int = cvtTypeF32
	var f64 int = cvtTypeF64
	var s16 int = cvtTypeS16
	var u16 int = cvtTypeU16
	var s32 int = cvtTypeS32
	var u32 int = cvtTypeU32
	if idx == cvtVcvt {
		cvtAddPairs(list, @[]int{f64, f32, f64, s32, f64, u32}, cvtOps(d, s, 0), dp, cvtFormVFP)
		cvtAdd(list, f32, f64, cvtOps(s, d, 0), dp, cvtFormVFP)
		cvtAddPairs(list, @[]int{f32, s32, f32, u32, s32, f32, u32, f32}, cvtOps(s, s, 0), vfp2,
				cvtFormVFP)
		cvtAddPairs(list, @[]int{f16, s32, f16, u32, s32, f16, u32, f16}, cvtOps(s, s, 0), full,
				cvtFormVFP)
		cvtAddPairs(list, @[]int{s32, f64, u32, f64}, cvtOps(s, d, 0), dp, cvtFormVFP)
		var neon32 @[]int = @[]int{s32, f32, u32, f32, f32, s32, f32, u32}
		var neon16 @[]int = @[]int{s16, f16, u16, f16, f16, s16, f16, u16}
		cvtAddPairs(list, neon32, cvtOps(d, d, 0), neon, cvtFormNEON)
		cvtAddPairs(list, neon32, cvtOps(q, q, 0), neon, cvtFormNEON)
		cvtAddPairs(list, neon16, cvtOps(d, d, 0), neon | full, cvtFormNEON)
		cvtAddPairs(list, neon16, cvtOps(q, q, 0), neon | full, cvtFormNEON)
		cvtAdd(list, f16, f32, cvtOps(d, q, 0), neon | cvtNeedHalf, cvtFormNEON)
		cvtAdd(list, f32, f16, cvtOps(q, d, 0), neon | cvtNeedHalf, cvtFormNEON)
		cvtAdd(list, cvtTypeBF16, f32, cvtOps(d, q, 0), cvtNeedBF16 | neon, cvtFormNEON)
		cvtAddPairs(list, neon32, cvtOps(cvtKindMQ, cvtKindMQ, 0), cvtNeedMVEFP, cvtFormMVE)
		cvtAddPairs(list, neon16, cvtOps(cvtKindMQ, cvtKindMQ, 0), cvtNeedMVEFP, cvtFormMVE)
		var fb16 int = cvtKindFbits16
		var fb32 int = cvtKindFbits32
		cvtAddFixed(list, f16, s, full, fb16, fb32)
		cvtAddFixed(list, f32, s, vfp2, fb16, fb32)
		cvtAddFixed(list, f64, d, dp, fb16, fb32)
		cvtAddPairs(list, neon32, cvtOps(d, d, cvtKindImm), neon, cvtFormNEON)
		cvtAddPairs(list, neon32, cvtOps(q, q, cvtKindImm), neon, cvtFormNEON)
		cvtAddPairs(list, neon16, cvtOps(d, d, cvtKindImm), neon | full, cvtFormNEON)
		cvtAddPairs(list, neon16, cvtOps(q, q, cvtKindImm), neon | full, cvtFormNEON)
		cvtAddPairs(list, neon32, cvtOps(d, d, cvtKindZero), neon, cvtFormNEON)
		cvtAddPairs(list, neon32, cvtOps(q, q, cvtKindZero), neon, cvtFormNEON)
		cvtAddPairs(list, neon16, cvtOps(d, d, cvtKindZero), neon, cvtFormNEON)
		cvtAddPairs(list, neon16, cvtOps(q, q, cvtKindZero), neon, cvtFormNEON)
		cvtAddPairs(list, neon32, cvtOps(cvtKindMQ, cvtKindMQ, cvtKindMFbits32), cvtNeedMVEFP, cvtFormMVE)
		cvtAddPairs(list, neon16, cvtOps(cvtKindMQ, cvtKindMQ, cvtKindMFbits16), cvtNeedMVEFP, cvtFormMVE)
	} else if idx == cvtVcvtr {
		cvtAddPairs(list, @[]int{s32, f64, u32, f64}, cvtOps(s, d, 0), dp, cvtFormVFP)
		cvtAddPairs(list, @[]int{s32, f32, u32, f32}, cvtOps(s, s, 0), vfp2, cvtFormVFP)
		cvtAddPairs(list, @[]int{s32, f16, u32, f16}, cvtOps(s, s, 0), full, cvtFormVFP)
	} else if idx == cvtVcvtb || idx == cvtVcvtt {
		cvtAddPairs(list, @[]int{f32, f16, f16, f32}, cvtOps(s, s, 0), cvtNeedHalf, cvtFormVFP)
		cvtAdd(list, f64, f16, cvtOps(d, s, 0), cvtNeedV8FP | cvtNeedDP, cvtFormVFP)
		cvtAdd(list, f16, f64, cvtOps(s, d, 0), cvtNeedV8FP | cvtNeedDP, cvtFormVFP)
		cvtAdd(list, cvtTypeBF16, f32, cvtOps(s, s, 0), cvtNeedBF16, cvtFormVFP)
		cvtAddPairs(list, @[]int{f16, f32, f32, f16}, cvtOps(cvtKindMQ, cvtKindMQ, 0), cvtNeedMVEFP,
				cvtFormMVE)
	} else if idx >= cvtVcvta && idx <= cvtVcvtm {
		var vfp int = cvtFormVFPNoCond
		cvtAddPairs(list, @[]int{s32, f16, u32, f16}, cvtOps(s, s, 0), full, vfp)
		cvtAddPairs(list, @[]int{s32, f32, u32, f32}, cvtOps(s, s, 0), cvtNeedV8FP, vfp)
		cvtAddPairs(list, @[]int{s32, f64, u32, f64}, cvtOps(s, d, 0), cvtNeedV8FP | cvtNeedDP, vfp)
		var v8 int = cvtNeedV8 | neon
		cvtAddPairs(list, @[]int{s32, f32, u32, f32}, cvtOps(d, d, 0), v8, cvtFormNEONNoCond)
		cvtAddPairs(list, @[]int{s32, f32, u32, f32}, cvtOps(q, q, 0), v8, cvtFormNEONNoCond)
		cvtAddPairs(list, @[]int{s16, f16, u16, f16}, cvtOps(d, d, 0), v8 | full, cvtFormNEONNoCond)
		cvtAddPairs(list, @[]int{s16, f16, u16, f16}, cvtOps(q, q, 0), v8 | full, cvtFormNEONNoCond)
		cvtAddPairs(list, @[]int{s32, f32, u32, f32, s16, f16, u16, f16}, cvtOps(cvtKindMQ, cvtKindMQ, 0),
				cvtNeedMVEFP, cvtFormMVE)
	} else if idx == cvtVjcvt {
		cvtAdd(list, s32, f64, cvtOps(s, d, 0), cvtNeedV8FP | cvtNeedV8_3, cvtFormVFP)
	} else if idx >= cvtVrinta && idx <= cvtVrintx {
		cvtAddRint(list, idx)
	} else {
		cvtAddThree(list, idx)
	}
	for i := 1; i < list.n; i++ {
		var c arm32CvtCand = list.c[i]
		var j int = i
		for j > 0 && arm32CvtLength(list.c[j - 1]) > arm32CvtLength(c) {
			list.c[j] = list.c[j - 1]
			j = j - 1
		}
		list.c[j] = c
	}
	return list
}

// arm32CvtHasCond reports whether encoding c has a condition operand (cvtForm*).
func arm32CvtHasCond(c arm32CvtCand) bool { return c.form == cvtFormVFP || c.form == cvtFormNEON }

// arm32CvtIsVFP reports whether encoding c is the VFP's, which this assembler assembles.
func arm32CvtIsVFP(c arm32CvtCand) bool {
	return c.form == cvtFormVFP || c.form == cvtFormVFPNoCond
}

// arm32CvtLength returns how many types and operands encoding c has, its condition operand and an
// MVE one's predicate operand counted, by which clang orders encodings.
func arm32CvtLength(c arm32CvtCand) int {
	var n int = 0
	if arm32CvtHasCond(c) || c.form == cvtFormMVE { n = 1 }
	if c.t1 != 0 { n = n + 1 }
	if c.t2 != 0 { n = n + 1 }
	var k int = 0
	for arm32CvtKindAt(c.ops, k) != 0 { k = k + 1 }
	return n + k
}

// cvtAddFixed appends the fixed-point VCVTs on floating point of type float (in register kind
// reg, needing need): to and from 16- and 32-bit integers, with their fraction bits' kinds fb16
// and fb32.
func cvtAddFixed(list @arm32CvtCandList, float int, reg int, need int, fb16 int, fb32 int) {
	var ints @[]int = @[]int{cvtTypeS16, cvtTypeU16, cvtTypeS32, cvtTypeU32}
	for i := 0; i < len(ints); i++ {
		var fb int = fb16
		if i >= 2 { fb = fb32 }
		cvtAdd(list, ints[i], float, cvtOps(reg, reg, fb), need, cvtFormVFP)
		cvtAdd(list, float, ints[i], cvtOps(reg, reg, fb), need, cvtFormVFP)
	}
}

// cvtAddRint appends VRINT idx's encodings: .F16 / .F32 / .F64 and clang's .F16.F16 / .F32.F32 /
// .F64.F64, and NEON's but for VRINTR.
func cvtAddRint(list @arm32CvtCandList, idx int) {
	var s int = cvtKindS
	var d int = cvtKindD
	var q int = cvtKindQ
	var full int = cvtNeedFull16
	var neon int = cvtNeedNEON
	var v8 int = cvtNeedV8 | neon
	var f16 int = cvtTypeF16
	var f32 int = cvtTypeF32
	var f64 int = cvtTypeF64
	var vfp int = cvtFormVFP
	if idx <= cvtVrintm { vfp = cvtFormVFPNoCond }
	cvtAdd(list, f16, 0, cvtOps(s, s, 0), full, vfp)
	cvtAdd(list, f32, 0, cvtOps(s, s, 0), cvtNeedV8FP, vfp)
	cvtAdd(list, f64, 0, cvtOps(d, d, 0), cvtNeedV8FP | cvtNeedDP, vfp)
	if idx != cvtVrintr {
		cvtAdd(list, f32, 0, cvtOps(d, d, 0), v8, cvtFormNEONNoCond)
		cvtAdd(list, f32, 0, cvtOps(q, q, 0), v8, cvtFormNEONNoCond)
		cvtAdd(list, f16, 0, cvtOps(d, d, 0), v8 | full, cvtFormNEONNoCond)
		cvtAdd(list, f16, 0, cvtOps(q, q, 0), v8 | full, cvtFormNEONNoCond)
		cvtAdd(list, f32, 0, cvtOps(cvtKindMQ, cvtKindMQ, 0), cvtNeedMVEFP, cvtFormMVE)
		cvtAdd(list, f16, 0, cvtOps(cvtKindMQ, cvtKindMQ, 0), cvtNeedMVEFP, cvtFormMVE)
	}
	cvtAdd(list, f16, f16, cvtOps(s, s, 0), full, vfp)
	cvtAdd(list, f32, f32, cvtOps(s, s, 0), cvtNeedV8FP, vfp)
	cvtAdd(list, f64, f64, cvtOps(d, d, 0), cvtNeedV8FP | cvtNeedDP, vfp)
	if idx != cvtVrintr {
		cvtAdd(list, f32, f32, cvtOps(d, d, 0), neon, cvtFormNEONNoCond)
		cvtAdd(list, f32, f32, cvtOps(q, q, 0), neon, cvtFormNEONNoCond)
		cvtAdd(list, f16, f16, cvtOps(d, d, 0), neon | full, cvtFormNEONNoCond)
		cvtAdd(list, f16, f16, cvtOps(q, q, 0), neon | full, cvtFormNEONNoCond)
	}
}

// cvtAddThree appends VSEL's or VMAXNM / VMINNM's (idx) encodings: .F16 / .F32 / .F64 on three
// registers, and NEON's for VMAXNM / VMINNM.
func cvtAddThree(list @arm32CvtCandList, idx int) {
	var s int = cvtKindS
	var d int = cvtKindD
	var q int = cvtKindQ
	var full int = cvtNeedFull16
	var v8fp int = cvtNeedV8FP
	var vfp int = cvtFormVFPNoCond
	cvtAdd(list, cvtTypeF16, 0, cvtOps(s, s, s), full, vfp)
	cvtAdd(list, cvtTypeF32, 0, cvtOps(s, s, s), v8fp, vfp)
	cvtAdd(list, cvtTypeF64, 0, cvtOps(d, d, d), v8fp | cvtNeedDP, vfp)
	if idx < cvtVmaxnm { return }
	var neon int = v8fp | cvtNeedNEON
	cvtAdd(list, cvtTypeF32, 0, cvtOps(d, d, d), neon, cvtFormNEONNoCond)
	cvtAdd(list, cvtTypeF32, 0, cvtOps(q, q, q), neon, cvtFormNEONNoCond)
	cvtAdd(list, cvtTypeF16, 0, cvtOps(d, d, d), neon | full, cvtFormNEONNoCond)
	cvtAdd(list, cvtTypeF16, 0, cvtOps(q, q, q), neon | full, cvtFormNEONNoCond)
	var mq int = cvtKindMQ
	cvtAdd(list, cvtTypeF32, 0, cvtOps(mq, mq, mq), cvtNeedMVEFP, cvtFormMVE)
	cvtAdd(list, cvtTypeF16, 0, cvtOps(mq, mq, mq), cvtNeedMVEFP, cvtFormMVE)
}
