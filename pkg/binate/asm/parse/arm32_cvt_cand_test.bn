package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Each instruction's encodings fit their list and come in the order clang tries them, fewest
// types and operands first, counting a condition operand and an MVE predicate operand as LLVM's
// asm strings have them: VCVT.F32.S32 Sd, Sm (with a condition) 5, VRINTA.F32 Sd, Sm (none) 3,
// NEON's VCVT.F32.S32 Dd, Dm (with one) 5, NEON's VRINTZ.F32 Dd, Dm (none) 3, MVE's VRINTZ.F32
// Qd, Qm (its predicate) 4.  arm32CvtReport keeps the message of the encoding with more where two
// are off by an unnamed operand at one place.
func TestArm32CvtCandsOrdered() testing.TestResult {
	var c arm32CvtCand
	c.t1 = cvtTypeF32
	c.t2 = cvtTypeS32
	c.ops = cvtOps(cvtKindS, cvtKindS, 0)
	if arm32CvtLength(c) != 5 { return fail("VCVT.F32.S32 Sd, Sm is not 5 long") }
	c.form = cvtFormNEON
	c.ops = cvtOps(cvtKindD, cvtKindD, 0)
	if arm32CvtLength(c) != 5 { return fail("NEON's VCVT.F32.S32 Dd, Dm is not 5 long") }
	c.t2 = 0
	c.form = cvtFormVFPNoCond
	c.ops = cvtOps(cvtKindS, cvtKindS, 0)
	if arm32CvtLength(c) != 3 { return fail("VRINTA.F32 Sd, Sm is not 3 long") }
	c.form = cvtFormNEONNoCond
	if arm32CvtLength(c) != 3 { return fail("NEON's VRINTZ.F32 is not 3 long") }
	c.form = cvtFormMVE
	if arm32CvtLength(c) != 4 { return fail("MVE's VRINTZ.F32 is not 4 long") }
	for idx := 0; idx < cvtNames; idx++ {
		var list @arm32CvtCandList = arm32CvtCands(idx)
		if list.n == 0 || list.n > len(list.c) { return fail("an instruction's encodings do not fit") }
		for i := 1; i < list.n; i++ {
			if arm32CvtLength(list.c[i]) < arm32CvtLength(list.c[i - 1]) {
				return fail("an instruction's encodings are not fewest first")
			}
		}
	}
	return ""
}

// The VFP encodings of VCVT.F64.F32 and VJCVT need what clang's do: VFPv2 and double precision;
// ARMv8's FP and ARMv8.3.
func TestArm32CvtCandsNeed() testing.TestResult {
	var list @arm32CvtCandList = arm32CvtCands(cvtVcvt)
	var found bool = false
	for i := 0; i < list.n; i++ {
		var c arm32CvtCand = list.c[i]
		if c.t1 == cvtTypeF64 && c.t2 == cvtTypeF32 && c.form == cvtFormVFP {
			if c.need != cvtNeedVFP2 | cvtNeedDP || c.ops != cvtOps(cvtKindD, cvtKindS, 0) {
				return fail("VCVT.F64.F32 does not need clang's features")
			}
			found = true
		}
	}
	if !found { return fail("VCVT has no VCVT.F64.F32") }
	list = arm32CvtCands(cvtVjcvt)
	if list.n != 1 || list.c[0].need != cvtNeedV8FP | cvtNeedV8_3 {
		return fail("VJCVT does not need clang's features")
	}
	return ""
}
