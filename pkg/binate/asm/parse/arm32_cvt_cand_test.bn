package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The VFP encodings of VCVT.F64.F32 and VJCVT need what clang's do: VFPv2 and double precision;
// ARMv8's FP and ARMv8.3.
func TestArm32CvtCandsNeed() testing.TestResult {
	var list @arm32MatchList = arm32CvtCands(cvtVcvt)
	var found bool = false
	for i := 0; i < list.n; i++ {
		var c arm32MatchCand = list.c[i]
		if c.t1 == matchTypeF64 && c.t2 == matchTypeF32 && c.form == matchFormVFP {
			if c.need != matchNeedVFP2 | matchNeedDP || c.ops != matchOps(matchKindD, matchKindS, 0) {
				return fail("VCVT.F64.F32 does not need clang's features")
			}
			found = true
		}
	}
	if !found { return fail("VCVT has no VCVT.F64.F32") }
	list = arm32CvtCands(cvtVjcvt)
	if list.n != 1 || list.c[0].need != matchNeedV8FP | matchNeedV8_3 {
		return fail("VJCVT does not need clang's features")
	}
	return ""
}
