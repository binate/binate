package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// Assembling the VFP encoding a conversion's operands matched (arm32CvtEmit), after the checks
// clang makes of a matched instruction: no condition on a half-precision one, the same register
// as a fixed-point VCVT's source and destination; and, where clang takes fraction bits past the
// encoding's range (17 for 16 bits, 33 for 32, which it wraps into another value), an error.

// arm32CvtSize returns the width of floating-point type t (cvtType*): 16, 32 or 64; 0 for none.
func arm32CvtSize(t int) int {
	if t == cvtTypeF16 { return 16 }
	if t == cvtTypeF32 { return 32 }
	if t == cvtTypeF64 { return 64 }
	return 0
}

// arm32CvtReg returns the register operand it is (vfp.S0 .. vfp.D31).
func arm32CvtReg(it arm32CvtItem) int {
	if it.kind == cvtItemD { return vfp.D0 + it.n }
	return vfp.S0 + it.n
}

// arm32CvtEmit assembles conversion instruction idx under cond as VFP encoding c, its operands
// items, or sets clang's error for what clang rejects of it once matched.
func arm32CvtEmit(p @Parser, idx int, cond int, c arm32CvtCand, items @[]arm32CvtItem) {
	if cond != arm32.COND_AL && c.need & cvtNeedFull16 != 0 {
		setErr(p, "instruction is not predicable")
		return
	}
	var fixed bool = idx == cvtVcvt && arm32CvtKindAt(c.ops, 2) != 0
	if fixed && items[0].n != items[1].n {
		setErr(p, "source and destination registers must be the same")
		return
	}
	var a int = arm32CvtReg(items[0])
	var b int = arm32CvtReg(items[1])
	var to int = arm32CvtSize(c.t1)
	var from int = arm32CvtSize(c.t2)
	var signed bool = c.t1 == cvtTypeS16 || c.t1 == cvtTypeS32 || c.t2 == cvtTypeS16 ||
			c.t2 == cvtTypeS32
	if fixed {
		var bits int = 32
		if c.t1 == cvtTypeS16 || c.t1 == cvtTypeU16 || c.t2 == cvtTypeS16 || c.t2 == cvtTypeU16 {
			bits = 16
		}
		var fbits int64 = items[2].val
		if fbits == cast(int64, bits + 1) {
			if bits == 16 {
				setErr(p, "operand must be an immediate in the range [0,16]")
			} else {
				setErr(p, "operand must be an immediate in the range [1,32]")
			}
			return
		}
		var size int = to + from
		vfp.VcvtFixed(p.Asm, cond, size, from != 0, signed, bits, a, cast(int, fbits))
	} else if idx == cvtVcvt && to != 0 && from != 0 {
		vfp.VcvtFP(p.Asm, cond, to, a, b)
	} else if idx == cvtVcvt && to != 0 {
		vfp.VcvtFromInt(p.Asm, cond, to, signed, a, b)
	} else if idx == cvtVcvt || idx == cvtVcvtr {
		vfp.VcvtToInt(p.Asm, cond, from, signed, idx == cvtVcvtr, a, b)
	} else if (idx == cvtVcvtb || idx == cvtVcvtt) && c.t1 == cvtTypeBF16 {
		vfp.VcvtBF16(p.Asm, cond, idx == cvtVcvtt, a, b)
	} else if idx == cvtVcvtb || idx == cvtVcvtt {
		vfp.VcvtHalf(p.Asm, cond, idx == cvtVcvtt, to == 16, to + from - 16, a, b)
	} else if idx >= cvtVcvta && idx <= cvtVcvtm {
		vfp.VcvtRound(p.Asm, vfp.RM_A + idx - cvtVcvta, from, signed, a, b)
	} else if idx == cvtVjcvt {
		vfp.Vjcvt(p.Asm, cond, a, b)
	} else if idx >= cvtVrinta && idx <= cvtVrintx {
		vfp.Vrint(p.Asm, cond, vfp.RM_A + idx - cvtVrinta, to, a, b)
	} else if idx >= cvtVseleq && idx <= cvtVselgt {
		var ccs @[]int = @[]int{arm32.COND_EQ, arm32.COND_VS, arm32.COND_GE, arm32.COND_GT}
		vfp.Vsel(p.Asm, ccs[idx - cvtVseleq], to, a, b, arm32CvtReg(items[2]))
	} else {
		vfp.Vmaxnm(p.Asm, idx == cvtVminnm, to, a, b, arm32CvtReg(items[2]))
	}
}
