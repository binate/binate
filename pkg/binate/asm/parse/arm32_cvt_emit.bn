package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/neon"
import "pkg/binate/asm/arm32/vfp"

// Assembling the VFP encoding a conversion's operands matched (arm32CvtEmit), or NEON's VMAXNM /
// VMINNM and VCVT between floating point and integers (arm32CvtNeon), after the checks clang makes
// of a matched instruction: no condition on a half-precision one, the same register as a VFP
// fixed-point VCVT's source and destination; and, where clang takes fraction bits past the
// encoding's range (17 for 16 bits, 33 for 32, any at all for NEON's, which it wraps into another
// value or instruction), an error.

// arm32CvtSize returns the width of floating-point type t (matchType*): 16, 32 or 64; 0 for none.
func arm32CvtSize(t int) int {
	if t == matchTypeF16 { return 16 }
	if t == matchTypeF32 { return 32 }
	if t == matchTypeF64 { return 64 }
	return 0
}

// arm32CvtReg returns the register operand it is (vfp.S0 .. vfp.D31).
func arm32CvtReg(it arm32MatchItem) int {
	if it.kind == matchItemD { return vfp.D0 + it.n }
	return vfp.S0 + it.n
}

// arm32CvtEmit assembles conversion instruction idx under cond as encoding c (the VFP's, or NEON's
// VMAXNM / VMINNM or VCVT), its operands items, or sets clang's error for what clang rejects of it
// once matched.
func arm32CvtEmit(p @Parser, idx int, cond int, c arm32MatchCand, items @[]arm32MatchItem) {
	if c.form == matchFormSIMD {
		arm32CvtNeon(p, idx, cond, c, items)
		return
	}
	if c.form == matchFormSIMDNoCond {
		var op int = neon.THREE_VMAXNM
		if idx == cvtVminnm { op = neon.THREE_VMINNM }
		neon.Three(p.Asm, op, arm32NeonDT(c.t1), arm32NeonReg(items[0]), arm32NeonReg(items[1]),
				arm32NeonReg(items[2]))
		return
	}
	if cond != arm32.COND_AL && c.need & matchNeedFull16 != 0 {
		setErr(p, "instruction is not predicable")
		return
	}
	var fixed bool = idx == cvtVcvt && arm32MatchKindAt(c.ops, 2) != 0
	if fixed && items[0].n != items[1].n {
		setErr(p, "source and destination registers must be the same")
		return
	}
	var a int = arm32CvtReg(items[0])
	var b int = arm32CvtReg(items[1])
	var to int = arm32CvtSize(c.t1)
	var from int = arm32CvtSize(c.t2)
	var signed bool = c.t1 == matchTypeS16 || c.t1 == matchTypeS32 || c.t2 == matchTypeS16 ||
			c.t2 == matchTypeS32
	if fixed {
		var bits int = 32
		if c.t1 == matchTypeS16 || c.t1 == matchTypeU16 || c.t2 == matchTypeS16 || c.t2 == matchTypeU16 {
			bits = 16
		}
		var fbits int64 = items[2].val
		if fbits == cast(int64, bits + 1) {
			if bits == 16 {
				setErr(p, "operand must be an immediate in the range [0,16]")
			} else {
				setErr(p, "operand must be an immediate in the range [1,32]")
			}
			return
		}
		var size int = to + from
		vfp.VcvtFixed(p.Asm, cond, size, from != 0, signed, bits, a, cast(int, fbits))
	} else if idx == cvtVcvt && to != 0 && from != 0 {
		vfp.VcvtFP(p.Asm, cond, to, a, b)
	} else if idx == cvtVcvt && to != 0 {
		vfp.VcvtFromInt(p.Asm, cond, to, signed, a, b)
	} else if idx == cvtVcvt || idx == cvtVcvtr {
		vfp.VcvtToInt(p.Asm, cond, from, signed, idx == cvtVcvtr, a, b)
	} else if (idx == cvtVcvtb || idx == cvtVcvtt) && c.t1 == matchTypeBF16 {
		vfp.VcvtBF16(p.Asm, cond, idx == cvtVcvtt, a, b)
	} else if idx == cvtVcvtb || idx == cvtVcvtt {
		vfp.VcvtHalf(p.Asm, cond, idx == cvtVcvtt, to == 16, to + from - 16, a, b)
	} else if idx >= cvtVcvta && idx <= cvtVcvtm {
		vfp.VcvtRound(p.Asm, vfp.RM_A + idx - cvtVcvta, from, signed, a, b)
	} else if idx == cvtVjcvt {
		vfp.Vjcvt(p.Asm, cond, a, b)
	} else if idx >= cvtVrinta && idx <= cvtVrintx {
		vfp.Vrint(p.Asm, cond, vfp.RM_A + idx - cvtVrinta, to, a, b)
	} else if idx >= cvtVseleq && idx <= cvtVselgt {
		var ccs @[]int = @[]int{arm32.COND_EQ, arm32.COND_VS, arm32.COND_GE, arm32.COND_GT}
		vfp.Vsel(p.Asm, ccs[idx - cvtVseleq], to, a, b, arm32CvtReg(items[2]))
	} else {
		vfp.Vmaxnm(p.Asm, idx == cvtVminnm, to, a, b, arm32CvtReg(items[2]))
	}
}

// parseArm32CvtOperands assembles conversion instruction idx under cond, its nt data types types
// (the first three kept), from its operands after l: the first of its encodings that matches, or
// clang's error.
func parseArm32CvtOperands(p @Parser, l Lexer, idx int, cond int, types @[]int, nt int) {
	items, ni, ok := arm32MatchOperands(p, l)
	if !ok { return }
	var list @arm32MatchList = arm32CvtCands(idx)
	var i int = arm32MatchRun(p, list, cond, types, nt, items, ni)
	if i >= 0 { arm32CvtEmit(p, idx, cond, list.c[i], items) }
}

// arm32CvtNeon assembles NEON's VCVT between floating point and integers (instruction idx) under
// cond as encoding c, its operands items -- Vd, Vm and a fixed-point one's fraction bits, 0 for the
// integer conversion -- unconditional; fraction bits past 1..e for e-bit elements or not a
// constant, which clang takes as any expression and wraps into another value or instruction, are
// an error here.
func arm32CvtNeon(p @Parser, idx int, cond int, c arm32MatchCand, items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, arm32CvtName(idx), cond) { return }
	var fbits int64 = 0
	if arm32MatchKindAt(c.ops, 2) != 0 {
		var e int64 = 32
		if c.t1 == matchTypeS16 || c.t1 == matchTypeU16 || c.t2 == matchTypeS16 || c.t2 == matchTypeU16 {
			e = 16
		}
		fbits = items[2].val
		if !items[2].known || fbits < 0 || fbits > e {
			if e == 16 {
				setErr(p, "operand must be an immediate in the range [1,16]")
			} else {
				setErr(p, "operand must be an immediate in the range [1,32]")
			}
			return
		}
	}
	neon.Cvt(p.Asm, arm32NeonDT(c.t1), arm32NeonDT(c.t2), arm32NeonReg(items[0]),
			arm32NeonReg(items[1]), cast(int, fbits))
}
