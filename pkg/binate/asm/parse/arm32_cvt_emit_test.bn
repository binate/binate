package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// What clang rejects of a conversion its operands matched: a condition on a half-precision one,
// a fixed-point VCVT's source other than its destination; and fraction bits clang takes past the
// encoding's range and wraps (17 for 16 bits, 33 for 32), which are errors here.
func TestParseArm32CvtMatchedRejects() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armMsgIs(e, f, "vrintreq.f16 s0, s1", "instruction is not predicable")
	e = armMsgIs(e, f, "vcvteq.f16.s32 s0, s1", "instruction is not predicable")
	e = armMsgIs(e, f, "vcvteq.f16.s16 s0, s0, #1", "instruction is not predicable")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s1, #1", "source and destination registers must be the same")
	e = armMsgIs(e, f, "fsitos s0, s1, #1", "source and destination registers must be the same")
	e = armMsgIs(e, f, "vcvt.f32.s16 s0, s0, #17", "operand must be an immediate in the range [0,16]")
	e = armMsgIs(e, f, "vcvt.u32.f64 d1, d1, #33", "operand must be an immediate in the range [1,32]")
	return e
}

// Each assembling branch with high registers, as clang assembles it: a precision VCVT, from and
// to an integer, fixed point, VCVTT with F64, VCVTT.BF16 with a condition, VCVTN, VJCVT with one,
// VRINTN and VRINTX, VSELVS, VMINNM.
func TestParseArm32CvtHighRegisters() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armGateIs(e, f, "vcvt.f64.f32 d17, s31", "EEF71AEF")
	e = armGateIs(e, f, "vcvt.f64.s32 d31, s5", "EEF8FBE2")
	e = armGateIs(e, f, "vcvtr.s32.f64 s7, d20", "EEFD3B64")
	e = armGateIs(e, f, "vcvt.u16.f64 d17, d17, #3", "EEFF1B66")
	e = armGateIs(e, f, "vcvt.f16.u32 s31, s31, #32", "EEFBF9C0")
	e = armGateIs(e, f, "vcvtt.f16.f64 s5, d30", "EEF32BEE")
	e = armGateIs(e, f, "vcvttlt.bf16.f32 s31, s2", "BEF3F9C1")
	e = armGateIs(e, f, "vcvtn.u32.f64 s31, d17", "FEFDFB61")
	e = armGateIs(e, f, "vjcvtvs.s32.f64 s31, d31", "6EF9FBEF")
	e = armGateIs(e, f, "vrintn.f64 d17, d18", "FEF91B62")
	e = armGateIs(e, f, "vrintxmi.f64 d31, d0", "4EF7FB40")
	e = armGateIs(e, f, "vselvs.f64 d17, d18, d19", "FE521BA3")
	e = armGateIs(e, f, "vminnm.f64 d31, d30, d29", "FECEFBED")
	return e
}
