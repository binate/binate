package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// What clang rejects of a conversion its operands matched: a condition on a half-precision one,
// a fixed-point VCVT's source other than its destination; and fraction bits clang takes past the
// encoding's range and wraps (17 for 16 bits, 33 for 32), which are errors here.
func TestParseArm32CvtMatchedRejects() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armMsgIs(e, f, "vrintreq.f16 s0, s1", "instruction is not predicable")
	e = armMsgIs(e, f, "vcvteq.f16.s32 s0, s1", "instruction is not predicable")
	e = armMsgIs(e, f, "vcvteq.f16.s16 s0, s0, #1", "instruction is not predicable")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s1, #1", "source and destination registers must be the same")
	e = armMsgIs(e, f, "fsitos s0, s1, #1", "source and destination registers must be the same")
	e = armMsgIs(e, f, "vcvt.f32.s16 s0, s0, #17", "operand must be an immediate in the range [0,16]")
	e = armMsgIs(e, f, "vcvt.u32.f64 d1, d1, #33", "operand must be an immediate in the range [1,32]")
	return e
}

// Each assembling branch with high registers, as clang assembles it: a precision VCVT, from and
// to an integer, fixed point, VCVTT with F64, VCVTT.BF16 with a condition, VCVTN, VJCVT with one,
// VRINTN and VRINTX, VSELVS, VMINNM.
func TestParseArm32CvtHighRegisters() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armGateIs(e, f, "vcvt.f64.f32 d17, s31", "EEF71AEF")
	e = armGateIs(e, f, "vcvt.f64.s32 d31, s5", "EEF8FBE2")
	e = armGateIs(e, f, "vcvtr.s32.f64 s7, d20", "EEFD3B64")
	e = armGateIs(e, f, "vcvt.u16.f64 d17, d17, #3", "EEFF1B66")
	e = armGateIs(e, f, "vcvt.f16.u32 s31, s31, #32", "EEFBF9C0")
	e = armGateIs(e, f, "vcvtt.f16.f64 s5, d30", "EEF32BEE")
	e = armGateIs(e, f, "vcvttlt.bf16.f32 s31, s2", "BEF3F9C1")
	e = armGateIs(e, f, "vcvtn.u32.f64 s31, d17", "FEFDFB61")
	e = armGateIs(e, f, "vjcvtvs.s32.f64 s31, d31", "6EF9FBEF")
	e = armGateIs(e, f, "vrintn.f64 d17, d18", "FEF91B62")
	e = armGateIs(e, f, "vrintxmi.f64 d31, d0", "4EF7FB40")
	e = armGateIs(e, f, "vselvs.f64 d17, d18, d19", "FE521BA3")
	e = armGateIs(e, f, "vminnm.f64 d31, d30, d29", "FECEFBED")
	return e
}

// NEON's VMAXNM / VMINNM, assembled here, as clang takes them: .F32 on D and Q registers with
// ARMv8's FP and NEON, .F16 with full FP16; without ARMv8's FP its error, and a Q register among
// D registers the D register's near miss.
func TestParseArm32CvtNeonMaxnm() testing.TestResult {
	var e @[]char = ""
	var v8 *[]readonly char = ".arch armv8-a"
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, v8, "vmaxnm.f32 d0, d1, d2", "F3010F12")
	e = armGateIs(e, v8, "vminnm.f32 q8, q9, q10", "F3620FF4")
	e = armGateIs(e, h, "vminnm.f16 q1, q2, q3", "F3342F56")
	e = armGateIs(e, h, "vmaxnm.f16 d0, d1, d2", "F3110F12")
	e = armMsgIs(e, "", "vmaxnm.f32 d0, d1, d2", "instruction requires: FPARMv8")
	e = armMsgIs(e, v8, "vmaxnm.f32 d0, d1, q2", "operand must be a register in range [d0, d31]")
	return e
}

// NEON's VCVT between floating point and integers as clang assembles it: the integer conversion
// (#0 the same, and for 16-bit elements without full FP16 too, as clang takes it), and by fraction
// bits 1..32 (an expression clang computes, high registers, Vd other than Vm), with full FP16 the
// 16-bit forms by 1..16; the pre-UAL names on D and Q registers, as clang takes them.
func TestParseArm32CvtNeon() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armGateIs(e, "", "vcvt.s32.f32 d0, d1", "F3BB0701")
	e = armGateIs(e, "", "vcvt.f32.u32 d0, d1", "F3BB0681")
	e = armGateIs(e, "", "vcvt.u32.f32 q15, q14", "F3FBE7EC")
	e = armGateIs(e, "", "vcvt.s32.f32 d0, d1, #0", "F3BB0701")
	e = armGateIs(e, "", "vcvt.s16.f16 d0, d1, #0", "F3B70701")
	e = armGateIs(e, "", "vcvt.f16.u16 q0, q1, #0", "F3B706C2")
	e = armGateIs(e, "", "vcvt.s32.f32 d0, d1, #1", "F2BF0F11")
	e = armGateIs(e, "", "vcvt.s32.f32 d0, d1, #32", "F2A00F11")
	e = armGateIs(e, "", "vcvt.s32.f32 d0, d1, #8+8", "F2B00F11")
	e = armGateIs(e, "", "vcvt.s32.f32 d31, d30, #5", "F2FBFF3E")
	e = armGateIs(e, "", "vcvt.f32.u32 q15, q14, #31", "F3E1EE7C")
	e = armGateIs(e, "", "vcvt.s32.f32 d0, d2, #3", "F2BD0F12")
	e = armGateIs(e, f, "vcvt.s16.f16 d0, d1", "F3B70701")
	e = armGateIs(e, f, "vcvt.s16.f16 d0, d1, #16", "F2B00D11")
	e = armGateIs(e, f, "vcvt.f16.u16 q0, q1, #3", "F3BD0C52")
	e = armGateIs(e, f, "vcvt.f16.s16 d31, d30, #16", "F2F0FC3E")
	e = armGateIs(e, "", "fsitos d0, d1", "F3BB0601")
	e = armGateIs(e, "", "ftouizs q0, q1, #0", "F3BB07C2")
	return e
}

// What clang does not take of them, with its message: Vd and Vm of two lengths, one register, no
// NEON; and here a condition, which clang drops, and fraction bits past 1..e or not a constant,
// which clang wraps into another instruction (#33 VMOV by an immediate).  The half-precision
// conversion of D and Q registers is not assembled yet.
func TestParseArm32CvtNeonRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = armMsgIs(e, "", "vcvt.s32.f32 q0, d1, #5", several)
	e = armMsgIs(e, "", "vcvt.s32.f32 d0, #5", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, ".fpu vfpv3", "vcvt.s32.f32 d0, d1, #0", "instruction requires: NEON")
	e = armMsgIs(e, "", "vcvteq.s32.f32 d0, d1",
			"instruction 'vcvt' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vcvt.s32.f32 d0, d1, #33", "operand must be an immediate in the range [1,32]")
	e = armMsgIs(e, "", "vcvt.f32.u32 q0, q1, #-1", "operand must be an immediate in the range [1,32]")
	e = armMsgIs(e, "", "vcvt.s32.f32 d0, d1, #x", "operand must be an immediate in the range [1,32]")
	e = armMsgIs(e, arm32CvtFull, "vcvt.s16.f16 d0, d1, #17",
			"operand must be an immediate in the range [1,16]")
	e = armMsgIs(e, ".fpu neon-fp16", "vcvt.f16.f32 d0, q1",
			"NEON (Advanced SIMD) instructions are not supported yet")
	return e
}
