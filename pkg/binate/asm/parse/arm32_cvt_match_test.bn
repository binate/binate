package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// cvtQuote returns "instruction '" name, then rest.
func cvtQuote(name *[]readonly char, rest *[]readonly char) @[]char {
	return buf.Concat(buf.Concat("instruction '", name), rest)
}

// cvtMsgIs appends to e a failure unless insn, after the directives ctx, is rejected with exactly
// the message want.
func cvtMsgIs(e @[]char, ctx *[]readonly char, insn *[]readonly char,
		want *[]readonly char) @[]char {
	var src @[]char = buf.Concat(buf.Concat(ctx, "\n.section text\n"), buf.Concat(insn, "\n"))
	var p @Parser = dataSource("arm32", src, asm.OBJ_ELF)
	var where @[]char = buf.Concat(buf.Concat(buf.Concat("`", ctx), "` / `"), buf.Concat(insn, "`: "))
	if !p.HasError { return buf.Concat(e, buf.Concat(where, "accepted\n")) }
	var msg @[]char = p.ErrorMsg
	for i := 0; i + 7 <= len(p.ErrorMsg); i++ {
		if charsEqual(p.ErrorMsg[i:i + 7], "error: ") { msg = p.ErrorMsg[i + 7:len(p.ErrorMsg)] }
	}
	if !charsEqual(msg, want) { return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n"))) }
	return e
}

// clang's message for a conversion whose operands match no encoding, from its near misses: one
// off by an operand of a kind it names, by an operand it does not name, by too few or too many
// operands, or by features alone (named in clang's order) is that message; several are its
// "invalid instruction, any one of the following would fix this:"; none "invalid instruction".
// Two encodings off by an unnamed operand at one place count once.
func TestParseArm32CvtNearMisses() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = cvtMsgIs(e, f, "vcvt.f64.f32 d0", "too few operands for instruction")
	e = cvtMsgIs(e, f, "vcvt.f64.f32 d0, s1, s2", "too many operands for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s1, #1, #2", "too many operands for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s1, s2", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #64", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #lbl", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #1.5", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, d0, #1", several)
	e = cvtMsgIs(e, ".fpu vfpv2", "vcvt.f32.s32 s0, d0, #1",
			"operand must be a register in range [s0, s31]")
	e = cvtMsgIs(e, f, "vcvt.f64.s32 d0, s0, #1", several)
	e = cvtMsgIs(e, f, "vcvt.f32.f32 s0, s1", several)
	e = cvtMsgIs(e, f, "vcvt.f64.f64 d0, d1", "invalid instruction")
	e = cvtMsgIs(e, f, "vcvt.f32 s0, s1", "invalid instruction")
	e = cvtMsgIs(e, f, "vjcvt.u32.f64 s0, d1", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vjcvt.s32.f64 d0, d1", "operand must be a register in range [s0, s31]")
	e = cvtMsgIs(e, f, "vseleq.f32 s0, s1, d2", "operand must be a register in range [s0, s31]")
	e = cvtMsgIs(e, f, "vmaxnm.f64 d0, d1, s2", "operand must be a register in range [d0, d31]")
	e = cvtMsgIs(e, f, "vrinta.f32.f64 s0, d1", "invalid instruction")
	e = cvtMsgIs(e, f, "vrintz.f32.f64 s0, s1", "invalid operand for instruction")
	e = cvtMsgIs(e, ".fpu vfpv2", "vcvt.f32.f64 s0, d17",
			"operand must be a register in range [d0, d15]")
	e = cvtMsgIs(e, ".fpu none", "vcvt.f32.f64 s0, d17", "invalid instruction")
	return e
}

// clang's message for a conversion whose features are not in effect, and for NEON's and MVE's
// forms: the features named in clang's order, NEON's assembled as this assembler's "not
// supported yet".
func TestParseArm32CvtGates() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = cvtMsgIs(e, ".fpu none", "vcvt.f64.f32 d0, s1",
			"instruction requires: double precision VFP VFP2")
	e = cvtMsgIs(e, ".fpu vfpv3xd", "vcvt.f64.f32 d0, s1",
			"instruction requires: double precision VFP")
	e = cvtMsgIs(e, "", "vcvtb.f64.f16 d0, s1", "instruction requires: FPARMv8")
	e = cvtMsgIs(e, ".fpu none", "vcvta.s32.f64 s0, d1",
			"instruction requires: double precision VFP FPARMv8")
	e = cvtMsgIs(e, "", "vcvt.f16.s32 s0, s1", several)
	e = cvtMsgIs(e, ".fpu none", "vcvt.f16.s32 s0, s1", "instruction requires: full half-float")
	e = cvtMsgIs(e, "", "vjcvt.s32.f64 s0, d1", "instruction requires: FPARMv8 armv8.3a")
	e = cvtMsgIs(e, ".arch armv8.2-a", "vjcvt.s32.f64 s0, d1", "instruction requires: armv8.3a")
	e = cvtMsgIs(e, "", "vcvtb.bf16.f32 s0, s1",
			"instruction requires: BFloat16 floating point extension")
	e = cvtMsgIs(e, "", "vcvtb.f32.f16 s0, s1", "instruction requires: half-float conversions")
	e = cvtMsgIs(e, "", "vrinta.f32 d0, d1", "instruction requires: armv8")
	e = cvtMsgIs(e, ".fpu vfpv2", "vrinta.f32 d0, d1", "instruction requires: NEON armv8")
	e = cvtMsgIs(e, ".arch armv8-a", "vrinta.f32 d0, d1",
			"NEON (Advanced SIMD) instructions are not supported yet")
	e = cvtMsgIs(e, "", "vcvt.f32.s32 d0, d1",
			"NEON (Advanced SIMD) instructions are not supported yet")
	e = cvtMsgIs(e, "", "vcvtb.f16.f32 q0, q1", "instruction requires: mve.fp")
	e = cvtMsgIs(e, ".fpu vfpv2", "vcvt.f32.s32 q0, q1", several)
	e = cvtMsgIs(e, "", "vcvt.s16.f16 d0, d1", several)
	e = cvtMsgIs(e, "", "vrintz.f32 q8, q9", "instruction requires: armv8")
	return e
}

// clang's messages for a conversion's operands as written: a sign or a floating-point literal
// with no `#`, a `#` with nothing after it, a missing comma, a comma with nothing after it, an
// empty operand, one starting with a token no operand starts with, an expression that does not
// parse; a register or a prefixed immediate with a `!` after it, which clang reads as two
// operands; a `:lower16:`-style prefix or a quoted name, which it reads as an immediate.
func TestParseArm32CvtOperandSyntax() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, -1", "unexpected token in operand")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, 1.0", "unexpected token in operand")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #", "unknown token in expression")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0 #1", "unexpected token in argument list")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0,", "unexpected token in operand")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 , s1", "unexpected token in operand")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, =1", "unexpected token in operand")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #-", "unknown token in expression")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #(1+", "unknown token in expression")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s1!", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #3!", "too many operands for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, $3!", "invalid instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, :lower16:x", "operand must be a register in range [s0, s31]")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, #:lower16:3", "invalid operand for instruction")
	e = cvtMsgIs(e, f, "vcvt.f32.s32 s0, s0, \"x\"", "invalid operand for instruction")
	return e
}

// A condition other than AL is an operand to clang, matched against an encoding's condition
// operand and, where an encoding has none (NEON's VRINT*, MVE's), against its first type or
// operand; AL is none.
func TestParseArm32CvtCondition() testing.TestResult {
	var e @[]char = ""
	var v8 *[]readonly char = ".arch armv8-a"
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = cvtMsgIs(e, "", "vrintzeq.f32 d0, d1", "invalid operand for instruction")
	e = cvtMsgIs(e, v8, "vrintzeq.f32 d0, d1", several)
	e = cvtMsgIs(e, "", "vcvtbeq.f16.f32 q0, q1", "invalid instruction")
	e = cvtMsgIs(e, ".fpu vfpv2", "vcvteq.s32.f32 q0, q1, #3", "instruction requires: NEON")
	e = cvtMsgIs(e, v8, "vrintzne.f32 s0, d1", "operand must be a register in range [s0, s31]")
	e = cvtMsgIs(e, v8, "vrintzeq.f32 d0", "invalid instruction")
	e = cvtMsgIs(e, "", "vrintzal.f32 d0, d1", "instruction requires: armv8")
	return e
}
