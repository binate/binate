package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// arm32CvtFull is the directives that give every FP feature a conversion needs: ARMv8.6's FP
// (with BFloat16, ARMv8.3) and full FP16.
var arm32CvtFull *[]readonly char = ".arch armv8.6-a\n.arch_extension fp16"

// Each conversion and ARMv8 FP instruction in a form of each kind, as clang assembles it: VCVT
// between precisions, to and from integers, to and from fixed point (fraction bits after `#`,
// with no `#`, as an expression, a constant defined before), VCVTR, VCVTB / VCVTT with half
// precision and BFloat16, VCVTA / VCVTM, VJCVT, VRINT* (clang's .F32.F32 too), VSEL, VMAXNM /
// VMINNM; the types in any case, clang's .f and .d, `.w` anywhere among them; conditions; clang's
// NEON alias vcvtq.
func TestParseArm32CvtForms() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armGateIs(e, f, "vcvt.f64.f32 d0, s1", "EEB70AE0")
	e = armGateIs(e, f, "vcvt.f32.f64 s0, d1", "EEB70BC1")
	e = armGateIs(e, f, "vcvteq.f64.f32 d0, s1", "0EB70AE0")
	e = armGateIs(e, f, "vcvt.f32.s32 s0, s1", "EEB80AE0")
	e = armGateIs(e, f, "vcvt.f64.u32 d0, s1", "EEB80B60")
	e = armGateIs(e, f, "vcvt.f16.s32 s0, s1", "EEB809E0")
	e = armGateIs(e, f, "vcvt.u32.f64 s0, d1", "EEBC0BC1")
	e = armGateIs(e, f, "vcvtr.s32.f32 s0, s1", "EEBD0A60")
	e = armGateIs(e, f, "vcvt.f32.s16 s0, s0, #1", "EEBA0A67")
	e = armGateIs(e, f, "vcvt.f32.s16 s0, s0, #0", "EEBA0A48")
	e = armGateIs(e, f, "vcvt.u32.f64 d0, d0, #32", "EEBF0BC0")
	e = armGateIs(e, f, "vcvt.s32.f16 s0, s0, #1", "EEBE09EF")
	e = armGateIs(e, f, "vcvt.f32.s32 s0, s0, 1", "EEBA0AEF")
	e = armGateIs(e, f, "vcvt.f32.s32 s0, s0, (2)", "EEBA0ACF")
	e = armGateIs(e, f, "vcvt.f32.s32 s0, s0, #+1", "EEBA0AEF")
	e = armGateIs(e, f, "vcvt.f32.s32 s0, s0, #1+0.0", "EEBA0AEF")
	e = armGateIs(e, f, "x = 3\nvcvt.f32.s32 s0, s0, #x", "EEBA0AEE")
	e = armGateIs(e, f, "vcvtb.f32.f16 s0, s1", "EEB20A60")
	e = armGateIs(e, f, "vcvtt.f16.f64 s0, d1", "EEB30BC1")
	e = armGateIs(e, f, "vcvtb.bf16.f32 s0, s1", "EEB30960")
	e = armGateIs(e, f, "vcvta.s32.f32 s0, s1", "FEBC0AE0")
	e = armGateIs(e, f, "vcvtm.u32.f64 s0, d1", "FEBF0B41")
	e = armGateIs(e, f, "vjcvt.s32.f64 s0, d1", "EEB90BC1")
	e = armGateIs(e, f, "vjcvteq.s32.f64 s0, d1", "0EB90BC1")
	e = armGateIs(e, f, "vrinta.f32 s0, s1", "FEB80A60")
	e = armGateIs(e, f, "vrinta.f32.f32 s0, s1", "FEB80A60")
	e = armGateIs(e, f, "vrintz.f64 d0, d1", "EEB60BC1")
	e = armGateIs(e, f, "vrintzeq.f32 s0, s1", "0EB60AE0")
	e = armGateIs(e, f, "vrintx.f32 s0, s1", "EEB70A60")
	e = armGateIs(e, f, "vseleq.f32 s0, s1, s2", "FE000A81")
	e = armGateIs(e, f, "vselgt.f16 s0, s1, s2", "FE300981")
	e = armGateIs(e, f, "vmaxnm.f32 s0, s1, s2", "FE800A81")
	e = armGateIs(e, f, "vminnm.f64 d0, d1, d2", "FE810B42")
	e = armGateIs(e, f, "VCVT.F32.S32 S0, S1", "EEB80AE0")
	e = armGateIs(e, f, "vcvt.f.s32 s0, s1", "EEB80AE0")
	e = armGateIs(e, f, "vcvt.d.f32 d0, s1", "EEB70AE0")
	e = armGateIs(e, f, "vseleq.d d0, d1, d2", "FE010B02")
	e = armGateIs(e, f, "vcvt.w.f32.s32 s0, s1", "EEB80AE0")
	e = armGateIs(e, f, "vrinta.w.f32 s0, s1", "FEB80A60")
	e = armGateIs(e, f, "vcvtq.f32.s32 s0, s1", "EEB80AE0")
	e = armGateIs(e, f, "vcvtqeq.s32.f32 s0, s1", "0EBD0AE0")
	return e
}

// Clang's split of a conversion's mnemonic: a condition off the end then an `s` (vcvtal is VCVT
// with AL, vcvtne VCVT with NE, vcvtmi VCVT with MI), but VCVTA .. VCVTM, VRINTA .. VRINTM and
// VMAXNM / VMINNM whole (vcvtaal is VCVTA with AL); the pre-UAL names whole only, with VFPv2.
func TestParseArm32CvtNames() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armGateIs(e, f, "vcvtal.s32.f32 s0, s1", "EEBD0AE0")
	e = armGateIs(e, f, "vcvtne.s32.f32 s0, s1", "1EBD0AE0")
	e = armGateIs(e, f, "vcvtmi.s32.f32 s0, s1", "4EBD0AE0")
	e = armGateIs(e, f, "vcvtaal.s32.f32 s0, s1", "FEBC0AE0")
	e = armGateIs(e, f, "vrintaal.f32 s0, s1", "FEB80A60")
	e = armGateIs(e, f, "vmaxnmal.f32 s0, s1, s2", "FE800A81")
	e = armGateIs(e, f, "fsitos s0, s1", "EEB80AE0")
	e = armGateIs(e, f, "fsitod d0, s1", "EEB80BE0")
	e = armGateIs(e, f, "ftosid s0, d1", "EEBD0B41")
	e = armGateIs(e, f, "ftouizs s0, s1", "EEBC0AE0")
	e = armGateIs(e, f, "FSITOS s0, s1", "EEB80AE0")
	e = armGateIs(e, ".fpu vfpv2", "ftosizd s0, d1", "EEBD0BC1")
	return e
}

// What clang does not take of a conversion's mnemonic, with its message: an `s` after the name
// (after a condition too, read as part of the name), a condition on one that takes none, `.n`, a
// pre-UAL name with a condition, a suffix or an `s` (or with no VFPv2), vrint and a vsel name
// clang has not (`.n` first, as clang reports it before it looks for the instruction).
func TestParseArm32CvtNameRejects() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	e = armMsgIs(e, f, "vcvts.f32.s32 s0, s1", armQuote("vcvt", flags))
	e = armMsgIs(e, f, "vcvteqs.f32.s32 s0, s1", armQuote("vcvteq", flags))
	e = armMsgIs(e, f, "VCVTS.F32.S32 s0, s1", armQuote("vcvt", flags))
	e = armMsgIs(e, f, "vmaxnms.f32 s0, s1, s2", armQuote("vmaxnm", flags))
	e = armMsgIs(e, f, "vcvtas.s32.f32 s0, s1", armQuote("vcvta", flags))
	e = armMsgIs(e, f, "vrints.f32 s0, s1", armQuote("vrint", flags))
	e = armMsgIs(e, f, "fsitoseq s0, s1", armQuote("fsito", flags))
	e = armMsgIs(e, f, "ftosizss s0, s1", armQuote("ftosizs", flags))
	e = armMsgIs(e, ".fpu none", "fsitos s0, s1", armQuote("fsito", flags))
	e = armMsgIs(e, f, "vcvtaeq.s32.f32 s0, s1",
			"instruction 'vcvta' is not predicable, but condition code specified")
	e = armMsgIs(e, f, "vrintmeq.f32 s0, s1",
			"instruction 'vrintm' is not predicable, but condition code specified")
	e = armMsgIs(e, f, "vcvt.f32.s32.n s0, s1",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armMsgIs(e, f, "fsitod.w d0, s1", "invalid instruction")
	e = armMsgIs(e, f, "fsitod.n d0, s1",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armMsgIs(e, f, "vsel.n.f32 s0, s1, s2",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armMsgIs(e, f, "fsitodeq d0, s1", "invalid instruction")
	e = armMsgIs(e, ".fpu none", "fsitod d0, s1", "invalid instruction")
	e = armMsgIs(e, f, "vrintal.f32 s0, s1", "invalid instruction")
	e = armMsgIs(e, f, "vselne.f32 s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, f, "vselgts.f32 s0, s1, s2", "invalid instruction")
	return e
}

// arm32CvtSplit and arm32MatchType as clang reads a mnemonic and its types.
func TestArm32CvtSplitAndType() testing.TestResult {
	name, cond, carry := arm32CvtSplit("vcvteq")
	if !charsEqual(name, "vcvt") || cond != arm32.COND_EQ || carry { return fail("vcvteq") }
	name, cond, carry = arm32CvtSplit("vcvtaeq")
	if !charsEqual(name, "vcvta") || cond != arm32.COND_EQ || carry { return fail("vcvtaeq") }
	name, cond, carry = arm32CvtSplit("vcvta")
	if !charsEqual(name, "vcvta") || cond != arm32.COND_AL || carry { return fail("vcvta") }
	name, cond, carry = arm32CvtSplit("vcvteqs")
	if !charsEqual(name, "vcvteq") || cond != arm32.COND_AL || !carry { return fail("vcvteqs") }
	name, cond, carry = arm32CvtSplit("vselvs")
	if !charsEqual(name, "vselvs") || cond != arm32.COND_AL || carry { return fail("vselvs") }
	if arm32MatchType("f") != matchTypeF32 || arm32MatchType("d") != matchTypeF64 ||
			arm32MatchType("bf16") != matchTypeBF16 || arm32MatchType("q32") != matchTypeOther {
		return fail("a data type is not as clang reads it")
	}
	return ""
}
