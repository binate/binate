package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// parseArm32DataProc parses an arithmetic or logical instruction — and, eor, sub, rsb, add, adc,
// sbc, rsc, orr, bic — after its Rd (tok the token after it), and reports whether baseMnem is
// one: `Rd, Rn, op2`, or `Rd, op2` for `Rd, Rd, op2` as clang takes it (`add r0, #1`, `and r0,
// r1, lsl #2`), op2 an immediate, a register, or one shifted by an immediate or a register; an
// immediate with no encoding is replaced as clang replaces it (arm32ImmFor).
func parseArm32DataProc(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		setFlags bool, rd int) bool {
	if !arm32IsDataProc(baseMnem) { return false }
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return true
	}
	l, tok = LexNext(l)
	var op2 arm32.Operand
	l, tok, op2, _ = parseArm32Operand(p, l, tok)
	if p.HasError { return true }
	var rn int = rd
	if tok.Kind == TOK_COMMA && op2.Kind == arm32.OP_REG {
		rn = op2.Reg
		l, tok, op2 = expectArm32CommaOp(p, l, tok)
	}
	if !arm32AtEOL(p, tok) { return true }
	var m *[]readonly char
	var ok bool
	m, op2, ok = arm32ImmFor(p, baseMnem, setFlags, op2, rd)
	if !ok { return true }
	emitArm32DataProc(p.Asm, m, cond, setFlags, rd, rn, op2)
	return true
}

// arm32IsDataProc reports whether mnem (no condition or S) is an arithmetic or logical
// instruction that takes `Rd, Rn, op2`.
func arm32IsDataProc(mnem *[]readonly char) bool {
	return mnemIs(mnem, "and") || mnemIs(mnem, "eor") || mnemIs(mnem, "sub") || mnemIs(mnem, "rsb") ||
			mnemIs(mnem, "add") || mnemIs(mnem, "adc") || mnemIs(mnem, "sbc") || mnemIs(mnem, "rsc") ||
			mnemIs(mnem, "orr") || mnemIs(mnem, "bic")
}

// emitArm32DataProc emits the arithmetic or logical instruction mnem `Rd, Rn, op2`.
func emitArm32DataProc(a @asm.Assembler, mnem *[]readonly char, cond int, setFlags bool, rd int,
		rn int, op2 arm32.Operand) {
	if mnemIs(mnem, "add") {
		arm32.Add(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "sub") {
		arm32.Sub(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "rsb") {
		arm32.Rsb(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "adc") {
		arm32.Adc(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "sbc") {
		arm32.Sbc(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "rsc") {
		arm32.Rsc(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "and") {
		arm32.And(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "orr") {
		arm32.Orr(a, cond, setFlags, rd, rn, op2)
	} else if mnemIs(mnem, "eor") {
		arm32.Eor(a, cond, setFlags, rd, rn, op2)
	} else {
		arm32.Bic(a, cond, setFlags, rd, rn, op2)
	}
}
