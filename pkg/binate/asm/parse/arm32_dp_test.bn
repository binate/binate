package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The arithmetic and logical instructions as clang (Apple clang 21) takes them, with its
// encodings: `Rd, op2` for `Rd, Rd, op2`; `asl` for `lsl`, in any case and in memory operands
// too; `.w` qualifiers ignored and `.n` an error; PC where clang rejects it — in a
// register-shifted register's ADC / SBC Rd or Rn, CMP's Rn, MOV / MVN's Rd, and the shift
// instructions' register forms — and taken elsewhere.  (armGateIs is in arm32_feat_test.bn.)
func TestArm32DataProcForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "add r0, r1", "E0800001")
	e = armGateIs(e, "", "adds r0, #1", "E2900001")
	e = armGateIs(e, "", "sub r0, r1, lsl #2", "E0400101")
	e = armGateIs(e, "", "rsc r0, r1, asr r3", "E0E00351")
	e = armGateIs(e, "", "and r0, r1, r2, asl #2", "E0010102")
	e = armGateIs(e, "", "mov r0, r1, ASL r2", "E1A00211")
	e = armGateIs(e, "", "ldr r0, [r1, r2, asl #2]", "E7910102")
	e = armGateIs(e, "", "add.w r0, r1, r2", "E0810002")
	e = armGateIs(e, "", "add.w.w r0, r1, r2", "E0810002")
	e = armGateIs(e, "", "add.W r0, r1, r2", "E0810002")
	e = armGateIs(e, "", "add.n.w r0, r1, r2",
			"!instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armGateIs(e, "", "nop.w", "E320F000")
	e = armGateIs(e, "", "add.n r0, r1, r2",
			"!instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armGateIs(e, "", "add pc, r1, r2, lsl r3", "E081F312")
	e = armGateIs(e, "", "mov r0, pc, lsl r2", "E1A0021F")
	e = armGateIs(e, "", "cmp r1, pc, lsl r3", "E151031F")
	e = armGateIs(e, "", "mvn r0, r1, lsl pc", "E1E00F11")
	e = armGateIs(e, "", "lsl pc, r1, #1", "E1A0F081")
	e = armGateIs(e, "", "adc pc, r1, r2, lsl r3", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "cmp pc, r2, lsl r3", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "mov pc, r1, lsl r3", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "lsl r0, pc, r2", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "lsl r0, r1, pc", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "lsl pc, r1", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "asl r0, r1, #2", "!unknown instruction")
	if len(e) > 0 { return fail(e) }
	return ""
}

// Data-processing operands as clang reads them: register names in any case, the APCS names
// (a1 .. a4, v1 .. v8, sb, sl) among them, and no leading zero (`r01` is a symbol); `$` for `#`;
// `imm8, rot` with or without either prefix; and MOVW for a 16-bit MOV immediate into PC.
func TestArm32DataProcOperands() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "add Sp, R1, a1", "E081D000")
	e = armGateIs(e, "", "mov a1, v8", "E1A0000B")
	e = armGateIs(e, "", "add sb, sl, a4", "E08A9003")
	e = armGateIs(e, "", "MOV R0, PC", "E1A0000F")
	e = armGateIs(e, "", "mov r0, r01",
			"!data-processing operand must be a register, shifted register, or immediate")
	e = armGateIs(e, "", "add r0, r1, $4", "E2810004")
	e = armGateIs(e, "", "add r0, r1, $ 4", "E2810004")
	e = armGateIs(e, "", "mov r0, $(1+2)", "E3A00003")
	e = armGateIs(e, "", "add r0, r1, r2, lsl $2", "E0810102")
	e = armGateIs(e, "", "mov r0, 255, 2", "E3A001FF")
	e = armGateIs(e, "", "mov r0, $255, $2", "E3A001FF")
	e = armGateIs(e, "", "mov r0, 255, #2", "E3A001FF")
	e = armGateIs(e, "", "movw pc, #0x1234", "E301F234")
	e = armGateIs(e, "", "mov pc, #0x1234", "E301F234")
	e = armGateIs(e, "", "movt pc, #0x1234", "!operand must be a register in range [r0, r14]")
	if len(e) > 0 { return fail(e) }
	return ""
}

// An immediate a label difference decides is left to a fixup, as clang leaves it, forward or
// backward, written with `#` or starting with a label's name: an instruction takes it only in its
// own encoding (no MVN for MOV, no SUB for ADD), MOV takes none, and a shift amount or an `imm8,
// rot` none either.  A constant's name stands for its value, as a number does (`add r0, r1, 4`),
// MOV's 16-bit value as MOVW, as clang has it (clang takes a name only where MOVW, a substitute or
// a shift instruction's amount does; bnas, wherever a number goes).  No MOV / MVN or CMP / CMN
// substitute is made with SP or PC, as clang makes none.
func TestArm32DataProcImmediates() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "K = 4", "add r0, r1, K", "E2810004")
	e = armGateIs(e, "K = 0xFF000000", "add r0, r1, K", "E28104FF")
	e = armGateIs(e, "K = 0xFF", "mov r0, K", "E30000FF")
	e = armGateIs(e, "K = 0x1234", "mov r0, K+1", "E3010235")
	e = armGateIs(e, "K = 4", "moveq r0, K", "03000004")
	e = armGateIs(e, "K = 4", "mov r0, (K)", "E3A00004")
	e = armGateIs(e, "K = 4", "movs r0, K", "E3B00004")
	e = armGateIs(e, ".arch armv6\nK = 4", "mov r0, K", "E3A00004")
	e = armGateIs(e, "K = -1", "mov r0, K", "E3E00000")
	e = armGateIs(e, "K = -2", "mvn r0, K", "E3A00001")
	e = armGateIs(e, "K = 4", "lsl r0, r1, K", "E1A00201")
	e = armGateIs(e, "K = 4", "lsl r0, K", "E1A00200")
	e = armGateIs(e, "", "add r0, r1, #b-a\na:\nnop\nb:", "E2810004 E320F000")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, #b-a", "E320F000 E2810004")
	e = armGateIs(e, "", "a:\nnop\nb:\nmov r0, #b-a",
			"!immediate expression for mov requires :lower16: or :upper16")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, #a-b", "!out of range immediate fixup value")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, r2, lsl #b-a", "!invalid immediate shift value")
	e = armGateIs(e, "", "a:\nnop\nb:\nlsl r0, r1, #b-a", "!invalid immediate shift value")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, #b-a, 2", "!too many operands for instruction")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, #4, b-a", "!constant expression expected")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, b-a+4", "E320F000 E2810008")
	e = armGateIs(e, "", "a:\nnop\nb:\nmov r0, b-a",
			"!immediate expression for mov requires :lower16: or :upper16")
	e = armGateIs(e, "", "a:\nnop\nb:\nadd r0, r1, b-a, 2", "!too many operands for instruction")
	e = armGateIs(e, "", "mov r0, #-1", "E3E00000")
	e = armGateIs(e, "", "add sp, sp, #-4", "E24DD004")
	e = armGateIs(e, "", "mov sp, #-1",
			"!data-processing immediate is not an 8-bit value rotated right by an even amount")
	e = armGateIs(e, "", "mvn pc, #-1",
			"!data-processing immediate is not an 8-bit value rotated right by an even amount")
	e = armGateIs(e, "", "cmp sp, #-1",
			"!data-processing immediate is not an 8-bit value rotated right by an even amount")
	e = armGateIs(e, "", "cmn pc, #-1",
			"!data-processing immediate is not an 8-bit value rotated right by an even amount")
	if len(e) > 0 { return fail(e) }
	return ""
}
