package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// The exclusives, load-acquires and store-releases, and SWP arm32ExclKind names: which operands
// each takes.
const (
	exclLoad int = iota + 1 // LDREX / LDAEX / LDA: Rt, [Rn]
	exclStore               // STREX / STLEX: Rd, Rt, [Rn]
	exclRelease             // STL: Rt, [Rn]
	exclSwap                // SWP / SWPB: Rt, Rt2, [Rn]
)

// The orderings arm32ExclKind names: exclusive (LDREX / STREX, and SWP), acquire-exclusive (LDAEX /
// STLEX), acquire / release alone (LDA / STL).
const (
	exclOrdEx int = iota
	exclOrdAcqEx
	exclOrdAcq
)

// arm32ExclKind returns the operand shape (exclLoad ..; 0 for none) of the instruction name
// names, its access size (arm32.EX_WORD ..) and its ordering (exclOrdEx ..).
func arm32ExclKind(name *[]readonly char) (int, int, int) {
	if mnemIs(name, "swp") { return exclSwap, arm32.EX_WORD, exclOrdEx }
	if mnemIs(name, "swpb") { return exclSwap, arm32.EX_BYTE, exclOrdEx }
	var kind int = 0
	var ord int = exclOrdEx
	var n int = 5
	if len(name) >= 5 && mnemIs(name[0:5], "ldrex") {
		kind = exclLoad
	} else if len(name) >= 5 && mnemIs(name[0:5], "strex") {
		kind = exclStore
	} else if len(name) >= 5 && mnemIs(name[0:5], "ldaex") {
		kind = exclLoad
		ord = exclOrdAcqEx
	} else if len(name) >= 5 && mnemIs(name[0:5], "stlex") {
		kind = exclStore
		ord = exclOrdAcqEx
	} else if len(name) >= 3 && mnemIs(name[0:3], "lda") {
		kind = exclLoad
		ord = exclOrdAcq
		n = 3
	} else if len(name) >= 3 && mnemIs(name[0:3], "stl") {
		kind = exclRelease
		ord = exclOrdAcq
		n = 3
	} else {
		return 0, 0, 0
	}
	var rest *[]readonly char = name[n:len(name)]
	if len(rest) == 0 { return kind, arm32.EX_WORD, ord }
	if mnemIs(rest, "b") { return kind, arm32.EX_BYTE, ord }
	if mnemIs(rest, "h") { return kind, arm32.EX_HALF, ord }
	if mnemIs(rest, "d") && ord != exclOrdAcq { return kind, arm32.EX_DOUBLE, ord }
	return 0, 0, 0
}

// parseArm32ExclMem parses an exclusive's memory operand, `, [Rn]` (tok the comma): the base
// register, or -1 with p's error set.
func parseArm32ExclMem(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "too few operands for instruction")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_LBRACKET {
		setErr(p, "invalid operand for instruction")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	var rn int = -1
	if tok.Kind == TOK_IDENT { rn = parseArm32Reg(tok.Text) }
	if rn < 0 {
		setErr(p, "invalid operand for instruction")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "invalid operand for instruction")
		return l, tok, -1
	}
	l, tok = LexNext(l)
	return l, tok, rn
}

// parseArm32ExclPair parses a doubleword's `, Rt2` after Rt (tok the comma), as clang takes it:
// Rt2 Rt + 1 or, with none written and Rt below R12 (R12 from ARMv8), implied; or ok false with
// p's error set (load: "destination ...", else "source ...").
func parseArm32ExclPair(p @Parser, l Lexer, tok Token, load bool, rt int) (Lexer, Token, bool) {
	var what *[]readonly char = "source"
	if load { what = "destination" }
	var l2 Lexer
	var t2 Token
	l2, t2 = LexNext(l)
	if tok.Kind == TOK_COMMA && t2.Kind == TOK_IDENT && parseArm32Reg(t2.Text) >= 0 {
		var rt2 int = parseArm32Reg(t2.Text)
		if rt2 != rt + 1 {
			// clang names the sequence first; an odd Rt with Rt + 1 is the encoder's error.
			setErr(p, buf.Concat(what, " operands must be sequential"))
			return l2, t2, false
		}
		l, tok = LexNext(l2)
		return l, tok, true
	}
	if rt > arm32.IP || rt == arm32.IP && p.Arm32Feats & armV8 == 0 {
		// clang implies Rt + 1 only below SP -- SP itself from ARMv8.
		setErr(p, buf.Concat(what, " operands must be sequential"))
		return l, tok, false
	}
	return l, tok, true
}

// parseArm32Excl assembles an exclusive, a load-acquire or store-release, or SWP / SWPB
// (arm32ExclKind) from its operands after the first register (tok the token after it), as clang
// takes them: the memory operand `[Rn]` alone; a doubleword's Rt2 Rt + 1 (or implied for an Rt
// below R12).  The acquire / release forms need ARMv8; SWP is gone from ARMv8; clang gates the
// other exclusives on no architecture.  The encoder checks the rest.  Reports whether baseMnem is
// one (it is then assembled, or the error set).
func parseArm32Excl(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		first int) bool {
	var kind int
	var size int
	var ord int
	kind, size, ord = arm32ExclKind(baseMnem)
	if kind == 0 { return false }
	var rd int = -1
	var rt int = first
	var rt2 int = -1
	var ok bool
	if kind == exclStore || kind == exclSwap {
		// The status register (STREX) or Rt (SWP) came first; the next register follows.
		if tok.Kind != TOK_COMMA {
			setErr(p, "too few operands for instruction")
			return true
		}
		l, tok = LexNext(l)
		var r int = -1
		if tok.Kind == TOK_IDENT { r = parseArm32Reg(tok.Text) }
		if r < 0 {
			setErr(p, "invalid operand for instruction")
			return true
		}
		l, tok = LexNext(l)
		if kind == exclStore {
			rd = first
			rt = r
		} else {
			rt2 = r
		}
	}
	if size == arm32.EX_DOUBLE {
		l, tok, ok = parseArm32ExclPair(p, l, tok, kind == exclLoad, rt)
		if !ok { return true }
	}
	var rn int
	l, tok, rn = parseArm32ExclMem(p, l, tok)
	if rn < 0 || !arm32AtEOL(p, tok) { return true }
	if ord != exclOrdEx && !armRequire(p, armV8, "acquire/release") { return true }
	if kind == exclSwap && p.Arm32Feats & armV8 != 0 {
		setErr(p, "instruction requires: armv7 or earlier")
		return true
	}
	var a @asm.Assembler = p.Asm
	if kind == exclLoad && ord == exclOrdAcq {
		arm32.Lda(a, cond, size, rt, rn)
	} else if kind == exclLoad {
		arm32.Ldrex(a, cond, size, ord == exclOrdAcqEx, rt, rn)
	} else if kind == exclStore {
		arm32.Strex(a, cond, size, ord == exclOrdAcqEx, rd, rt, rn)
	} else if kind == exclRelease {
		arm32.Stl(a, cond, size, rt, rn)
	} else {
		arm32.Swp(a, cond, size == arm32.EX_BYTE, rt, rt2, rn)
	}
	return true
}

// parseArm32Clrex assembles CLREX (l just past the mnemonic), as clang takes it: no operand,
// unconditional (`al` only), from ARMv6K.  Reports whether baseMnem is CLREX.
func parseArm32Clrex(p @Parser, l Lexer, baseMnem *[]readonly char, cond int) bool {
	if !mnemIs(baseMnem, "clrex") { return false }
	if cond != arm32.COND_AL {
		setErr(p, "instruction 'clrex' is not predicable, but condition code specified")
		return true
	}
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF {
		setErr(p, "too many operands for instruction")
		return true
	}
	if armRequire(p, armV6K, "armv6k") { arm32.Clrex(p.Asm) }
	return true
}
