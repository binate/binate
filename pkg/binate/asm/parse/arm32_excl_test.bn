package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The exclusives, load-acquires and store-releases, SWP and CLREX as clang takes them, with its
// words: any register (PC, SP, a status register equal to Rt or Rn), `[Rn]` with spaces, a
// doubleword's pair or one register, a condition (`stlexhs` is STLEX with HS); and the gates --
// none for the exclusives (LDREX on ARMv4), CLREX from ARMv6K, the acquire / release forms from
// ARMv8, SWP before it.  (armGateIs is in arm32_feat_test.bn.)
func TestArm32ExclForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldrex r0, [r1]", "E1910F9F")
	e = armGateIs(e, "", "ldrex pc, [pc]", "E19FFF9F")
	e = armGateIs(e, "", "ldrexb sp, [r0]", "E1D0DF9F")
	e = armGateIs(e, "", "ldrex r0, [ r1 ]", "E1910F9F")
	e = armGateIs(e, "", "strex r0, r0, [r0]", "E1800F90")
	e = armGateIs(e, "", "strex pc, r2, [r1]", "E181FF92")
	e = armGateIs(e, "", "strexh r1, r1, [r1]", "E1E11F91")
	e = armGateIs(e, "", "ldrexd r0, r1, [r4]", "E1B40F9F")
	e = armGateIs(e, "", "ldrexd r12, sp, [pc]", "E1BFCF9F")
	e = armGateIs(e, "", "ldrexd r2, [r4]", "E1B42F9F")
	e = armGateIs(e, "", "strexd r5, r0, r1, [r4]", "E1A45F90")
	e = armGateIs(e, "", "strexd pc, r0, r1, [r4]", "E1A4FF90")
	e = armGateIs(e, "", "strexd r5, r0, [r4]", "E1A45F90")
	e = armGateIs(e, "", "swp r0, r2, [r1]", "E1010092")
	e = armGateIs(e, "", "swpb sp, r2, [pc]", "E14FD092")
	e = armGateIs(e, "", "swpeq r0, r2, [r1]", "01010092")
	e = armGateIs(e, "", "clrex", "F57FF01F")
	e = armGateIs(e, "", "clrexal", "F57FF01F")
	e = armGateIs(e, ".arch armv8-a", "lda r0, [r1]", "E1910C9F")
	e = armGateIs(e, ".arch armv8-a", "stl pc, [r1]", "E181FC9F")
	e = armGateIs(e, ".arch armv8-a", "ldaex sp, [r1]", "E191DE9F")
	e = armGateIs(e, ".arch armv8-a", "stlexhs r0, r2, [r1]", "21810E92")
	e = armGateIs(e, ".arch armv8-a", "ldaexd r0, r1, [r2]", "E1B20E9F")
	e = armGateIs(e, ".arch armv8-a", "stlexd r4, r0, r1, [r2]", "E1A24E90")
	e = armGateIs(e, ".arch armv8-a", "ldrexd r12, [r4]", "E1B4CF9F")
	e = armGateIs(e, ".arch armv4", "ldrex r0, [r1]", "E1910F9F")
	e = armGateIs(e, ".arch armv6k", "clrex", "F57FF01F")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The forms clang rejects: an offset or writeback on the base, a register for the memory operand;
// a doubleword pair that starts odd or is not sequential, or one register R12 before ARMv8; PC as
// SWP's Rt; CLREX with a condition or an operand; S; and the gates -- CLREX before ARMv6K, the
// acquire / release forms before ARMv8, SWP from ARMv8.
func TestArm32ExclRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldrex r0, [r1, #0]", "!invalid operand for instruction")
	e = armGateIs(e, "", "ldrex r0, [r1]!", "!")
	e = armGateIs(e, "", "ldrex r0, r1", "!invalid operand for instruction")
	e = armGateIs(e, "", "ldrexd r1, r2, [r4]", "!destination operands must start at an even register")
	e = armGateIs(e, "", "ldrexd r0, r2, [r4]", "!destination operands must be sequential")
	e = armGateIs(e, "", "ldrexd r1, r3, [r4]", "!destination operands must be sequential")
	e = armGateIs(e, "", "strexd r5, r0, r2, [r4]", "!source operands must be sequential")
	e = armGateIs(e, "", "ldrexd r12, [r4]", "!destination operands must be sequential")
	e = armGateIs(e, "", "swp pc, r2, [r1]", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "clrexeq",
			"!instruction 'clrex' is not predicable, but condition code specified")
	e = armGateIs(e, "", "clrex #0", "!too many operands for instruction")
	e = armGateIs(e, "", "strexs r0, r2, [r1]", "!can not set flags")
	e = armGateIs(e, ".arch armv6", "clrex", "!instruction requires: armv6k")
	e = armGateIs(e, "", "lda r0, [r1]", "!instruction requires: acquire/release")
	e = armGateIs(e, ".arch armv8-a", "swp r0, r2, [r1]", "!instruction requires: armv7 or earlier")
	e = armGateIs(e, ".arch armv8-a", "ldabs r0, [r1]", "!can not set flags")
	if len(e) > 0 { return fail(e) }
	return ""
}
