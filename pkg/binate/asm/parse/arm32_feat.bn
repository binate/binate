package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// ARM instruction-set features (Parser.Arm32Feats), as clang's assembler gates A32 instructions
// by them: the architecture levels, each implying those before it, the R profile, and the
// extensions.  armMOnly marks an M-profile architecture, whose code is Thumb only; it is
// never in effect.  The FP, SIMD, SHA2, AES and FP16 bits are set only by `.arch_extension` so
// far, as no instruction the parser takes needs them.
const (
	armV4T uint64 = 0x1
	armV5T uint64 = 0x2
	armV5TE uint64 = 0x4
	armV6 uint64 = 0x8
	armV6K uint64 = 0x10
	armV6T2 uint64 = 0x20
	armV7 uint64 = 0x40
	armV8 uint64 = 0x80
	armV8_1 uint64 = 0x100
	armV8_2 uint64 = 0x200
	armV8_3 uint64 = 0x400
	armV8_4 uint64 = 0x800
	armV8_5 uint64 = 0x1000
	armV8_6 uint64 = 0x2000
	armV8_7 uint64 = 0x4000
	armV8_8 uint64 = 0x8000
	armV8_9 uint64 = 0x10000
	armV9 uint64 = 0x20000
	armV9_1 uint64 = 0x40000
	armV9_2 uint64 = 0x80000
	armV9_3 uint64 = 0x100000
	armV9_4 uint64 = 0x200000
	armV9_5 uint64 = 0x400000
	armV9_6 uint64 = 0x800000
	armRProf uint64 = 0x1000000
	armHwDivArm uint64 = 0x2000000
	armMP uint64 = 0x4000000
	armSec uint64 = 0x8000000
	armVirt uint64 = 0x10000000
	armCRC uint64 = 0x20000000
	armRAS uint64 = 0x40000000
	armSB uint64 = 0x80000000
	armFP uint64 = 0x100000000
	armSIMD uint64 = 0x200000000
	armSHA2 uint64 = 0x400000000
	armAES uint64 = 0x800000000
	armFP16 uint64 = 0x1000000000
	armMOnly uint64 = 0x8000000000000000
)

// armV7VEFeats returns armv7ve's features — armv7-a with hardware divide, the multiprocessing,
// security and virtualization extensions — the default for the assembler's arm32 targets
// (clang's -march=armv7ve, as bnc passes).
func armV7VEFeats() uint64 {
	return armV4T | armV5T | armV5TE | armV6 | armV6K | armV6T2 | armV7 | armHwDivArm | armMP |
			armSec | armVirt
}

// armRequire reports whether the features in effect include want, else sets clang's error
// naming what is missing ("instruction requires: <what>").
func armRequire(p @Parser, want uint64, what *[]readonly char) bool {
	if p.Arm32Feats & want == want { return true }
	setErr(p, buf.Concat("instruction requires: ", what))
	return false
}

// armArchNamed returns the features of the architecture name names (armMOnly for an M-profile
// one) and its Tag_CPU_name, and whether it names one, as clang reads `.arch`: a canonical name
// (armArchCanonical) or a synonym of one (armArchSynonym), matched against the end of each
// architecture's name in LLVM's order, the first match winning (so `7-a`, `v7`, `armv7l`,
// `thumbv7` are armv7-a).  armv5tej, armv7ve and armv8-r, which clang fails on, are taken as
// GNU as takes them; LLVM's placeholder `invalid` and Apple's armv7s and armv7k, which GNU as does
// not know, name none.
func armArchNamed(name *[]readonly char) (uint64, @[]char, bool) {
	var none @[]char
	var c @[]char
	var ok bool
	c, ok = armArchCanonical(name)
	if !ok { return 0, none, false }
	var s *[]readonly char = armArchSynonym(c)
	var v5te uint64 = armV4T | armV5T | armV5TE
	var v6k uint64 = v5te | armV6 | armV6K
	var v7 uint64 = v6k | armV6T2 | armV7
	var v8 uint64 = armV7VEFeats() | armV8 | armCRC
	var v82 uint64 = v8 | armV8_1 | armV8_2 | armRAS
	var v85 uint64 = v82 | armV8_3 | armV8_4 | armV8_5 | armSB
	var v87 uint64 = v85 | armV8_6 | armV8_7
	var v89 uint64 = v87 | armV8_8 | armV8_9
	var v9 uint64 = v85 | armV9
	var v94 uint64 = v89 | armV9 | armV9_1 | armV9_2 | armV9_3 | armV9_4
	if armHasSuffix("invalid", s) { return 0, none, false }
	if armHasSuffix("armv4", s) { return 0, buf.CopyStr("4"), true }
	if armHasSuffix("armv4t", s) { return armV4T, buf.CopyStr("4T"), true }
	if armHasSuffix("armv5t", s) { return armV4T | armV5T, buf.CopyStr("5T"), true }
	if armHasSuffix("armv5te", s) { return v5te, buf.CopyStr("5TE"), true }
	if armHasSuffix("armv5tej", s) { return v5te, buf.CopyStr("5TEJ"), true }
	if armHasSuffix("armv6", s) { return v5te | armV6, buf.CopyStr("6"), true }
	if armHasSuffix("armv6k", s) { return v6k, buf.CopyStr("6K"), true }
	if armHasSuffix("armv6t2", s) { return v6k | armV6T2, buf.CopyStr("6T2"), true }
	if armHasSuffix("armv6kz", s) { return v6k | armSec, buf.CopyStr("6KZ"), true }
	if armHasSuffix("armv6-m", s) { return armMOnly, none, true }
	if armHasSuffix("armv7-a", s) { return v7, buf.CopyStr("7-A"), true }
	if armHasSuffix("armv7ve", s) { return armV7VEFeats(), buf.CopyStr("7VE"), true }
	if armHasSuffix("armv7-r", s) { return v7 | armRProf, buf.CopyStr("7-R"), true }
	if armHasSuffix("armv7-m", s) || armHasSuffix("armv7e-m", s) { return armMOnly, none, true }
	if armHasSuffix("armv8-a", s) { return v8, buf.CopyStr("8-A"), true }
	if armHasSuffix("armv8.1-a", s) { return v8 | armV8_1, buf.CopyStr("8.1-A"), true }
	if armHasSuffix("armv8.2-a", s) { return v82, buf.CopyStr("8.2-A"), true }
	if armHasSuffix("armv8.3-a", s) { return v82 | armV8_3, buf.CopyStr("8.3-A"), true }
	if armHasSuffix("armv8.4-a", s) { return v82 | armV8_3 | armV8_4, buf.CopyStr("8.4-A"), true }
	if armHasSuffix("armv8.5-a", s) { return v85, buf.CopyStr("8.5-A"), true }
	if armHasSuffix("armv8.6-a", s) { return v85 | armV8_6, buf.CopyStr("8.6-A"), true }
	if armHasSuffix("armv8.7-a", s) { return v87, buf.CopyStr("8.7-A"), true }
	if armHasSuffix("armv8.8-a", s) { return v87 | armV8_8, buf.CopyStr("8.8-A"), true }
	if armHasSuffix("armv8.9-a", s) { return v89, buf.CopyStr("8.9-A"), true }
	if armHasSuffix("armv9-a", s) { return v9, buf.CopyStr("9-A"), true }
	if armHasSuffix("armv9.1-a", s) { return v9 | armV8_6 | armV9_1, buf.CopyStr("9.1-A"), true }
	if armHasSuffix("armv9.2-a", s) {
		return v87 | armV9 | armV9_1 | armV9_2, buf.CopyStr("9.2-A"), true
	}
	if armHasSuffix("armv9.3-a", s) {
		return v87 | armV8_8 | armV9 | armV9_1 | armV9_2 | armV9_3, buf.CopyStr("9.3-A"), true
	}
	if armHasSuffix("armv9.4-a", s) { return v94, buf.CopyStr("9.4-A"), true }
	if armHasSuffix("armv9.5-a", s) { return v94 | armV9_5, buf.CopyStr("9.5-A"), true }
	if armHasSuffix("armv9.6-a", s) { return v94 | armV9_5 | armV9_6, buf.CopyStr("9.6-A"), true }
	if armHasSuffix("armv8-r", s) {
		return v7 | armV8 | armRProf | armHwDivArm | armMP | armVirt | armCRC, buf.CopyStr("8-R"), true
	}
	if armHasSuffix("armv8-m.base", s) || armHasSuffix("armv8-m.main", s) ||
			armHasSuffix("armv8.1-m.main", s) {
		return armMOnly, none, true
	}
	if armHasSuffix("iwmmxt", s) { return v5te, buf.CopyStr("iwmmxt"), true }
	if armHasSuffix("iwmmxt2", s) { return v5te, buf.CopyStr("iwmmxt2"), true }
	if armHasSuffix("xscale", s) { return v5te, buf.CopyStr("xscale"), true }
	return 0, none, false
}

// armArchCanonical returns name as LLVM's ARM::getCanonicalArchName has it — a leading `arm`,
// `thumb`, `arm64` (`arm64e`, `arm64_32`) or `aarch64` (`aarch64_32`, `aarch64_be`) and an `eb`
// after it or at the end dropped, what follows such a prefix required to start `v<digit>` — and
// whether it is well formed.
func armArchCanonical(name *[]readonly char) (@[]char, bool) {
	var none @[]char
	var off int = -1
	if armHasPrefix(name, "arm64_32") {
		off = 8
	} else if armHasPrefix(name, "arm64e") {
		off = 6
	} else if armHasPrefix(name, "arm64") {
		off = 5
	} else if armHasPrefix(name, "aarch64_32") {
		off = 10
	} else if armHasPrefix(name, "arm") {
		off = 3
	} else if armHasPrefix(name, "thumb") {
		off = 5
	} else if armHasPrefix(name, "aarch64") {
		off = 7
		if armContains(name, "eb") { return none, false }
		if armHasPrefix(name[7:len(name)], "_be") { off = 10 }
	}
	var a *[]readonly char = name
	if off >= 0 && armHasPrefix(name[off:len(name)], "eb") {
		off = off + 2
	} else if armHasSuffix(name, "eb") {
		a = name[0:len(name) - 2]
	}
	if off >= 0 { a = a[off:len(a)] }
	if len(a) == 0 { return buf.CopyStr(name), true }
	if off >= 0 {
		if len(a) >= 2 && (a[0] != 'v' || !isDigit(a[1])) { return none, false }
		if armContains(a, "eb") { return none, false }
	}
	return buf.CopyStr(a), true
}

// armArchSynonym returns the architecture name LLVM's ARM::getArchSynonym gives the canonical
// name c, or c.
func armArchSynonym(c *[]readonly char) *[]readonly char {
	var from @[]*[]readonly char = @[]*[]readonly char{"v5", "v5e", "v6j", "v6hl", "v6m", "v6sm",
			"v6s-m", "v6z", "v6zk", "v7", "v7a", "v7hl", "v7l", "v7r", "v7m", "v7em", "v8", "v8a", "v8l",
			"aarch64", "arm64", "v8.1a", "v8.2a", "v8.3a", "v8.4a", "v8.5a", "v8.6a", "v8.7a", "v8.8a",
			"v8.9a", "v8r", "v9", "v9a", "v9.1a", "v9.2a", "v9.3a", "v9.4a", "v9.5a", "v9.6a", "v8m.base",
			"v8m.main", "v8.1m.main"}
	var to @[]*[]readonly char = @[]*[]readonly char{"v5t", "v5te", "v6", "v6k", "v6-m", "v6-m",
			"v6-m", "v6kz", "v6kz", "v7-a", "v7-a", "v7-a", "v7-a", "v7-r", "v7-m", "v7e-m", "v8-a", "v8-a",
			"v8-a", "v8-a", "v8-a", "v8.1-a", "v8.2-a", "v8.3-a", "v8.4-a", "v8.5-a", "v8.6-a", "v8.7-a",
			"v8.8-a", "v8.9-a", "v8-r", "v9-a", "v9-a", "v9.1-a", "v9.2-a", "v9.3-a", "v9.4-a", "v9.5-a",
			"v9.6-a", "v8-m.base", "v8-m.main", "v8.1-m.main"}
	for i := 0; i < len(from); i++ {
		if charsEqual(from[i], c) { return to[i] }
	}
	return c
}

// setArmArch makes the architecture name names (armArchNamed) the one in effect for what follows,
// as `.arch` does: its features; and, for the object, its name for Tag_CPU_name and for iwmmxt /
// iwmmxt2 Tag_WMMX_arch, where none is set explicitly (asm.Assembler.ArmArchName, ArmWMMX) — the
// last `.arch`'s.  An unknown name and an M-profile architecture, for which clang switches to
// Thumb code, are errors.
func setArmArch(p @Parser, name *[]readonly char) bool {
	var feats uint64
	var attr @[]char
	var ok bool
	feats, attr, ok = armArchNamed(name)
	if !ok {
		setErr(p, "Unknown arch name")
		return false
	}
	if feats == armMOnly {
		setErr(p,
				quotedName(name,
						" is an M-profile architecture, whose code is Thumb only; the assembler "
								"writes ARM (A32) code only"))
		return false
	}
	p.Arm32Feats = feats
	p.Asm.ArmArchName = attr
	p.Asm.ArmWMMX = 0
	if charsEqual(attr, "iwmmxt") { p.Asm.ArmWMMX = 1 }
	if charsEqual(attr, "iwmmxt2") { p.Asm.ArmWMMX = 2 }
	return true
}

// armHasPrefix reports whether s starts with pre, case and all.
func armHasPrefix(s *[]readonly char, pre *[]readonly char) bool {
	return len(s) >= len(pre) && charsEqual(s[0:len(pre)], pre)
}

// armHasSuffix reports whether s ends with suf, case and all.
func armHasSuffix(s *[]readonly char, suf *[]readonly char) bool {
	return len(s) >= len(suf) && charsEqual(s[len(s) - len(suf):len(s)], suf)
}

// armContains reports whether s contains sub, case and all.
func armContains(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if charsEqual(s[i:i + len(sub)], sub) { return true }
	}
	return false
}
