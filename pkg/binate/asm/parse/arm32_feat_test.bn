package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The ARM feature model (arm32_feat.bn, arm32_cpus.bn, arm32_archext.bn): `.arch`, `.cpu` and
// `.arch_extension` set the features in effect, which gate instructions as clang (Apple clang
// 21, -march=armv7ve) gates them.  The encodings are clang's.

// armTextWords returns p's text section as space-separated hex words.
func armTextWords(p @Parser) @[]char {
	var s @asm.Section = sectionNamed(p, "text")
	var out @[]char = ""
	for at := 0; at + 4 <= s.Len; at = at + 4 {
		var w uint32 = readWord(s, at)
		var digits *[]readonly char = "0123456789ABCDEF"
		var hex @[]char = make_slice(char, 8)
		for k := 0; k < 8; k++ { hex[k] = digits[(w >> cast(uint32, 28 - 4 * k)) & 15] }
		if len(out) > 0 { out = buf.Concat(out, " ") }
		out = buf.Concat(out, hex)
	}
	return out
}

// armGateIs appends to e a failure unless insn, after the directives ctx, assembles on arm32 to
// the words want (hex) — or, want starting with '!', is rejected with an error containing the
// rest.
func armGateIs(e @[]char, ctx *[]readonly char, insn *[]readonly char,
		want *[]readonly char) @[]char {
	var src @[]char = buf.Concat(buf.Concat(ctx, "\n.section text\n"), buf.Concat(insn, "\n"))
	var p @Parser = dataSource("arm32", src, asm.OBJ_ELF)
	var where @[]char = buf.Concat(buf.Concat(buf.Concat("`", ctx), "` / `"), buf.Concat(insn, "`: "))
	if len(want) > 0 && want[0] == '!' {
		if !p.HasError { return buf.Concat(e, buf.Concat(where, "accepted\n")) }
		if !plContains(p.ErrorMsg, want[1:len(want)]) {
			return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n")))
		}
		return e
	}
	if p.HasError { return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n"))) }
	var got @[]char = armTextWords(p)
	if !charsEqual(got, want) { return buf.Concat(e, buf.Concat(where, buf.Concat(got, "\n"))) }
	return e
}

// Each gated instruction is rejected below its architecture level and taken at it — bx at
// ARMv4T, blx <reg> and clz at ARMv5T, movw / movt at ARMv6T2, sdiv / udiv with hardware divide
// (armv7ve's, armv8-a's; not armv7-a's or armv7-r's) — with clang's message; nop is the ARMv6K
// hint, before that `mov r0, r0`, its condition kept.  The default is armv7ve.
func TestArm32ArchGating() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, "", "nopeq", "0320F000")
	e = armGateIs(e, ".arch armv4", "bx lr", "!instruction requires: armv4t")
	e = armGateIs(e, ".arch armv4", "bkpt #1", "E1200071")
	e = armGateIs(e, "", "bkptal #1", "E1200071")
	e = armGateIs(e, "", "bkpteq #1",
			"!instruction 'bkpt' is not predicable, but condition code specified")
	e = armGateIs(e, ".arch armv4", "ldrh r0, [r1]", "E1D100B0")
	e = armGateIs(e, ".arch armv4t", "bx lr", "E12FFF1E")
	e = armGateIs(e, ".arch armv4t", "blx r1", "!instruction requires: armv5t")
	e = armGateIs(e, ".arch armv4t", "clz r0, r1", "!instruction requires: armv5t")
	e = armGateIs(e, ".arch armv5t", "blx r1", "E12FFF31")
	e = armGateIs(e, ".arch armv5t", "clz r0, r1", "E16F0F11")
	e = armGateIs(e, ".arch armv6k", "movw r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv6k", "movt r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv6t2", "movw r0, #1", "E3000001")
	e = armGateIs(e, ".arch armv6t2", "movt r0, #1", "E3400001")
	e = armGateIs(e, ".arch armv7-a", "sdiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".arch armv7-r", "udiv r0, r0, r1", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".arch armv8-a", "udiv r0, r0, r1", "E730F110")
	e = armGateIs(e, ".arch armv6", "nop", "E1A00000")
	e = armGateIs(e, ".arch armv6", "nopeq", "01A00000")
	e = armGateIs(e, ".arch armv6k", "nop", "E320F000")
	// armv7ve, armv5tej and armv8-r, which clang fails on, as GNU as takes them.
	e = armGateIs(e, ".arch armv7-a\n.arch armv7ve", "sdiv r0, r0, r1", "E710F110")
	e = armGateIs(e, ".arch armv5tej", "movw r0, #1", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv8-r", "sdiv r0, r0, r1", "E710F110")
	if len(e) > 0 { return fail(e) }
	return ""
}

// clang substitutes MOVW for a MOV, and for a literal-pool load, of a 16-bit value with no rotated
// encoding only from ARMv6T2: before, the MOV is rejected and the load reads the pool.
func TestArm32MovwSubstitutionGated() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv6t2", "mov r0, #0x1234", "E3010234")
	e = armGateIs(e, ".arch armv6t2", "ldr r0, =0x1234", "E3010234")
	e = armGateIs(e, ".arch armv6", "mov r0, #0x1234", "!immediate")
	// The load's offset is filled by the fixup resolution, after parsing.
	e = armGateIs(e, ".arch armv6", "ldr r0, =0x1234", "E59F0000 00001234")
	if len(e) > 0 { return fail(e) }
	return ""
}

// armArchIs appends to e a failure unless `.arch name` makes attr the object's Tag_CPU_name where
// none is set explicitly (asm.Assembler.ArmArchName) — or, attr starting with '!', is rejected
// with an error containing the rest.
func armArchIs(e @[]char, name *[]readonly char, attr *[]readonly char) @[]char {
	var p @Parser = dataSource("arm32", buf.Concat(buf.Concat(".arch ", name), "\n"), asm.OBJ_ELF)
	var where @[]char = buf.Concat(buf.Concat("`.arch ", name), "`: ")
	if len(attr) > 0 && attr[0] == '!' {
		if !p.HasError { return buf.Concat(e, buf.Concat(where, "accepted\n")) }
		if !plContains(p.ErrorMsg, attr[1:len(attr)]) {
			return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n")))
		}
		return e
	}
	if p.HasError { return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n"))) }
	if charsEqual(p.Asm.ArmArchName, attr) { return e }
	return buf.Concat(e, buf.Concat(where, buf.Concat(p.Asm.ArmArchName, "\n")))
}

// `.arch` reads an architecture name as clang does (LLVM's canonical names and synonyms, matched
// at the end of each name in LLVM's order) and sets Tag_CPU_name to its short name — but the
// assembler's own instruction-set names (aarch64 / arm64, arm32 / arm, x64 / x86_64) keep their
// meaning, where clang reads aarch64 / arm64 as ARMv8-A; armv7ve,
// armv5tej and armv8-r as GNU as takes them; an M-profile architecture (Thumb only), Apple's
// armv7s / armv7k, an unknown name and a block comment after the name are errors.
func TestArm32ArchNames() testing.TestResult {
	var e @[]char = ""
	e = armArchIs(e, "armv7-a", "7-A")
	e = armArchIs(e, "v7", "7-A")
	e = armArchIs(e, "7-a", "7-A")
	e = armArchIs(e, "armv7l", "7-A")
	e = armArchIs(e, "armebv7", "7-A")
	e = armArchIs(e, "thumbv7", "7-A")
	e = armArchIs(e, "-a", "7-A")
	e = armArchIs(e, "r", "7-R")
	e = armArchIs(e, "4", "4")
	e = armArchIs(e, "4t", "4T")
	e = armArchIs(e, "armv5", "5T")
	e = armArchIs(e, "armv5e", "5TE")
	e = armArchIs(e, "armv6hl", "6K")
	e = armArchIs(e, "armv6zk", "6KZ")
	e = armArchIs(e, "t2", "6T2")
	e = armArchIs(e, "armv8l", "8-A")
	e = armArchIs(e, "armv8.1a", "8.1-A")
	e = armArchIs(e, "armv9", "9-A")
	e = armArchIs(e, "v9.4a", "9.4-A")
	e = armArchIs(e, "iwmmxt2", "iwmmxt2")
	e = armArchIs(e, "xscale", "xscale")
	e = armArchIs(e, "armv7ve", "7VE")
	e = armArchIs(e, "armv5tej", "5TEJ")
	e = armArchIs(e, "armv8-r", "8-R")
	e = armArchIs(e, "armv7-a // c", "7-A")
	e = armArchIs(e, "7a", "!Unknown arch name")
	e = armArchIs(e, "8", "!Unknown arch name")
	e = armArchIs(e, "armv6-k", "!Unknown arch name")
	e = armArchIs(e, "invalid", "!Unknown arch name")
	e = armArchIs(e, "armv7s", "!Unknown arch name")
	e = armArchIs(e, "armv7k", "!Unknown arch name")
	e = armArchIs(e, "ARMv7-A", "!Unknown arch name")
	e = armArchIs(e, "armv7-a /* c */", "!Unknown arch name")
	e = armArchIs(e, "armv7-m", "!M-profile architecture")
	if len(e) > 0 { return fail(e) }
	return ""
}

// An ARM architecture name in `.arch` before any instruction set is chosen chooses arm32.
func TestArm32ArchChoosesArm32() testing.TestResult {
	var p @Parser = newTestParser()
	p.Asm.ObjFormat = asm.OBJ_ELF
	p.ParseSource(".arch armv6t2\n.section text\nmovw r0, #1\n")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Arch != ARCH_ARM32 { return fail("`.arch armv6t2` did not choose arm32") }
	if !charsEqual(armTextWords(p), "E3000001") { return fail("movw is not E3000001") }
	return ""
}

// `.arch` sets the object's Tag_CPU_name only where nothing sets it explicitly, in either order
// (`.cpu`, `.eabi_attribute`), and for iwmmxt / iwmmxt2 Tag_WMMX_arch 1 / 2; the last `.arch`
// decides, dropping an earlier one's WMMX.
func TestArm32ArchAttrDefaults() testing.TestResult {
	var p @Parser = dataSource("arm32", ".arch iwmmxt2\n", asm.OBJ_ELF)
	if p.HasError || p.Asm.ArmWMMX != 2 { return fail("iwmmxt2 is not WMMX 2") }
	p = dataSource("arm32", ".arch iwmmxt\n.arch armv7-a\n", asm.OBJ_ELF)
	if p.HasError || p.Asm.ArmWMMX != 0 || !charsEqual(p.Asm.ArmArchName, "7-A") {
		return fail("a later .arch does not replace iwmmxt's name and WMMX")
	}
	p = dataSource("arm32", ".cpu cortex-a8\n.arch armv6\n", asm.OBJ_ELF)
	if p.HasError || p.Asm.NumArmAttrs != 1 || !charsEqual(p.Asm.ArmAttrs[0].Str, "cortex-a8") {
		return fail("`.arch` after `.cpu` replaced the explicit Tag_CPU_name")
	}
	return ""
}
