package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// fpSeen returns the FP features in effect for p as clang's instructions show them, each named by
// what the instruction clang was asked to take needs: vfp2 (VADD.F32 S), fp64 (VADD.F64 D0), d32
// (VADD.F64 D16), vfp3 (VMOV.F32 #1.0), fp16 (VCVTB.F32.F16), vfp4 (VFMA.F32), v8 (VRINTA.F32),
// neon (VADD.I32 D), aes (AESE), sha2 (SHA1H), ffp16 (VADD.F16), fml (VFMAL.F16), dot (VSDOT),
// bf16 (VDOT.BF16), i8mm (VSMMLA), d32sp (VMOV.F32 S and VLDR D16), and the FP registers alone:
// regs (VMOV.F32 S), regs64 (VMOV.F64 D) and regs16 (VLDR.16).
func fpSeen(p @Parser) @[]char {
	var fp uint64 = p.Arm32FP
	var v8 bool = p.Arm32Feats & armV8 != 0
	var dp uint64 = armFpVFP2SP | armFpDP
	var has @[]bool = @[]bool{fp & armFpVFP2SP != 0, fp & dp == dp,
			fp & (dp | armFpD32) == dp | armFpD32, fp & armFpVFP3D16SP != 0, fp & armFpHalf != 0,
			fp & armFpVFP4D16SP != 0, fp & armFpV8D16SP != 0, fp & armFpNEON != 0, v8 && fp & armFpAES != 0,
			v8 && fp & armFpSHA2 != 0, fp & armFpFullFP16 != 0,
			fp & (armFpNEON | armFpFP16FML) == armFpNEON | armFpFP16FML, fp & armFpDotProd != 0,
			fp & armFpBF16 != 0, fp & armFpI8MM != 0, fp & (armFpRegs | armFpD32) == armFpRegs | armFpD32,
			fp & armFpRegs != 0, fp & armFpRegs64 != 0, fp & armFpRegs16 != 0}
	var names @[]*[]readonly char = @[]*[]readonly char{"vfp2", "fp64", "d32", "vfp3", "fp16", "vfp4",
			"v8", "neon", "aes", "sha2", "ffp16", "fml", "dot", "bf16", "i8mm", "d32sp", "regs", "regs64",
			"regs16"}
	var s @[]char = ""
	for i := 0; i < len(names); i++ {
		if !has[i] { continue }
		if len(s) > 0 { s = buf.Concat(s, " ") }
		s = buf.Concat(s, names[i])
	}
	return s
}

// fpSeenAfter returns fpSeen after the directives in ctx (`|` separating them), the target's
// operating system os ("linux", or "" for none), or the error.
func fpSeenAfter(os *[]readonly char, ctx *[]readonly char) @[]char {
	p, _ := newArm32Parser()
	p.SetTargetOs(os)
	var src @[]char = make_slice(char, len(ctx))
	for i := 0; i < len(ctx); i++ {
		src[i] = ctx[i]
		if ctx[i] == '|' { src[i] = '\n' }
	}
	p.ParseSource(src)
	if p.HasError { return buf.Concat("error: ", p.ErrorMsg) }
	return fpSeen(p)
}

// fpOsIs appends to e unless fpSeenAfter(os, ctx) is want, clang's.
func fpOsIs(e @[]char, os *[]readonly char, ctx *[]readonly char, want *[]readonly char) @[]char {
	var got @[]char = fpSeenAfter(os, ctx)
	if charsEqual(got, want) { return e }
	var where @[]char = buf.Concat(buf.Concat(buf.Concat("`", ctx), "` on "), os)
	return buf.Concat(e,
			buf.Concat(buf.Concat(where, ": "),
					buf.Concat(buf.Concat(got, " (clang: "), buf.Concat(want, ")\n"))))
}

// fpIs is fpOsIs on Linux.
func fpIs(e @[]char, ctx *[]readonly char, want *[]readonly char) @[]char {
	return fpOsIs(e, "linux", ctx, want)
}

// Each target starts with clang's FP features: VFPv3 with NEON on Linux (and before the target
// is known), none with no OS, not even the FP registers, where `.fpu`, `.arch` and `.cpu` set
// them as on Linux.
func TestArm32FPTargets() testing.TestResult {
	p, _ := newArm32Parser()
	var e @[]char = ""
	if !charsEqual(fpSeen(p), "vfp2 fp64 d32 vfp3 neon d32sp regs regs64") {
		e = buf.Concat("a new parser's FP features: ", fpSeen(p))
	}
	e = fpOsIs(e, "", "", "")
	e = fpOsIs(e, "", ".fpu vfpv3xd", "vfp2 vfp3 regs")
	e = fpOsIs(e, "", ".fpu none", "")
	e = fpOsIs(e, "", ".fpu neon", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpOsIs(e, "", ".arch armv7-a", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpOsIs(e, "", ".arch armv8-a|.arch_extension nofp", "fp16 d32sp regs regs64")
	e = fpOsIs(e, "", ".cpu cortex-a9", "vfp2 fp64 d32 vfp3 fp16 neon d32sp regs regs64")
	e = fpOsIs(e, "", ".arch armv8-a|.fpu none", "regs regs64")
	e = fpOsIs(e, "", ".fpu vfpv2", "vfp2 fp64 regs regs64")
	e = fpOsIs(e, "", ".fpu vfpv4|.fpu softvfp", "regs regs64")
	e = fpOsIs(e, "", ".arch armv8-r", "vfp2 vfp3 fp16 vfp4 v8 regs")
	e = fpOsIs(e, "", ".arch armv7ve", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpOsIs(e, "", ".fpu vfpv3xd|.fpu vfpv4", "vfp2 fp64 d32 vfp3 fp16 vfp4 d32sp regs regs64")
	return e
}

// The second pass (a label difference pending on the first) starts from the target's FP features
// again, not those a new parser has.
func TestArm32FPSecondPass() testing.TestResult {
	p, _ := newArm32Parser()
	p.SetTargetOs("")
	p.ParseSource(".section data\n.uint32 lb - la\nla: .uint32 0\nlb:\n")
	if p.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	if !present(p.Prev) { return fail("no second pass") }
	if p.Arm32FP != 0 { return fail(buf.Concat("the second pass's FP features: ", fpSeen(p))) }
	return ""
}

// `.fpu` sets clang's FP features for each FPU and synonym (after `.arch armv8.2-a`, where every
// feature is allowed), and `.arch_extension` sets or clears them with what they imply or what
// implies them, as clang does, in sequences of the directives.
func TestArm32FPDirectives() testing.TestResult {
	var e @[]char = ""
	e = fpIs(e, ".arch armv8.2-a|.fpu none", "regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfp", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv2", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv3", "vfp2 fp64 d32 vfp3 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv3-fp16", "vfp2 fp64 d32 vfp3 fp16 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv3-d16", "vfp2 fp64 vfp3 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv3-d16-fp16", "vfp2 fp64 vfp3 fp16 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv3xd", "vfp2 vfp3 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv3xd-fp16", "vfp2 vfp3 fp16 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv4", "vfp2 fp64 d32 vfp3 fp16 vfp4 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv4-d16", "vfp2 fp64 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fpv4-sp-d16", "vfp2 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fpv5-d16", "vfp2 fp64 vfp3 fp16 vfp4 v8 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fpv5-sp-d16", "vfp2 vfp3 fp16 vfp4 v8 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp-armv8", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp-armv8-fullfp16-d16",
			"vfp2 fp64 vfp3 fp16 vfp4 v8 ffp16 regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp-armv8-fullfp16-sp-d16",
			"vfp2 vfp3 fp16 vfp4 v8 ffp16 regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.fpu neon", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu neon-vfpv3", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu neon-fp16", "vfp2 fp64 d32 vfp3 fp16 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu neon-vfpv4",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu neon-fp-armv8",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu crypto-neon-fp-armv8",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu softvfp", "regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfp3", "vfp2 fp64 d32 vfp3 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfp4", "vfp2 fp64 d32 vfp3 fp16 vfp4 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfp2", "vfp2 fp64 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfp3-d16", "vfp2 fp64 vfp3 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfp4-d16", "vfp2 fp64 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp4-sp-d16", "vfp2 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu vfpv4-sp-d16", "vfp2 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp4-dp-d16", "vfp2 fp64 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fpv4-dp-d16", "vfp2 fp64 vfp3 fp16 vfp4 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp5-sp-d16", "vfp2 vfp3 fp16 vfp4 v8 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fp5-dp-d16", "vfp2 fp64 vfp3 fp16 vfp4 v8 regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fpv5-dp-d16", "vfp2 fp64 vfp3 fp16 vfp4 v8 regs regs64")
	e = fpIs(e, ".arch armv8-a", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nofp", "fp16 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nosimd", "fp16 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nocrypto",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension noaes",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nosha2",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nofp|.arch_extension fp",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nofp|.arch_extension simd",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nofp|.arch_extension crypto",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nofp|.arch_extension aes",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 ffp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.fpu none|.arch_extension fp16",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 ffp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16|.arch_extension nofp16",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8-a|.fpu vfpv2|.arch_extension fp",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu vfpv3-d16|.arch_extension simd",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu fpv5-sp-d16", "vfp2 vfp3 fp16 vfp4 v8 regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu vfpv3xd", "vfp2 vfp3 regs regs64")
	e = fpIs(e, ".arch armv7-a|.fpu vfpv3-d16|.arch armv7-a",
			"vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".fpu vfpv2|.arch armv7-a", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8.6-a|.fpu neon", "vfp2 fp64 d32 vfp3 neon dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv8.6-a|.fpu vfpv4", "vfp2 fp64 d32 vfp3 fp16 vfp4 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.6-a|.fpu crypto-neon-fp-armv8",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16|.fpu neon-fp-armv8",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16|.fpu fp-armv8-fullfp16-d16",
			"vfp2 fp64 vfp3 fp16 vfp4 v8 ffp16 regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a510|.fpu neon",
			"vfp2 fp64 d32 vfp3 neon dot bf16 i8mm d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a510|.arch_extension nofp16",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot bf16 i8mm d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a510|.arch_extension nosimd", "fp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a510|.arch_extension nosimd|.arch_extension simd",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension nofp16",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu vfpv3-d16|.arch_extension fp",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu vfpv3xd|.arch_extension fp",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu vfpv3xd|.arch_extension simd",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.fpu fpv5-sp-d16|.arch_extension crypto",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.fpu fpv5-sp-d16|.arch_extension fp16",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 ffp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-r5|.arch armv7-a", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".fpu neon|.cpu cortex-r5", "vfp2 fp64 vfp3 regs regs64")
	e = fpIs(e, ".fpu vfpv4", "vfp2 fp64 d32 vfp3 fp16 vfp4 d32sp regs regs64")
	e = fpIs(e, ".fpu neon", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".fpu crypto-neon-fp-armv8", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon d32sp regs regs64")
	e = fpIs(e, ".fpu fp-armv8", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64")
	e = fpIs(e, ".fpu vfpv3xd", "vfp2 vfp3 regs regs64")
	e = fpIs(e, ".arch armv7-a|.fpu vfpv3-d16|.fpu neon", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8-a|.arch_extension nofp|.fpu vfpv4",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16|.arch_extension nofp",
			"fp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16|.arch_extension nosimd",
			"fp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".arch armv8.2-a|.arch_extension fp16|.arch_extension nocrypto",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 ffp16 d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a510|.arch_extension nosimd|.arch_extension fp",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-a510|.arch_extension nofp|.arch_extension crypto",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64 regs16")
	e = fpIs(e, ".cpu cortex-r5|.arch_extension sec", "vfp2 fp64 vfp3 regs regs64")
	e = fpIs(e, ".cpu cortex-a53|.arch_extension nosha2|.arch_extension aes",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes d32sp regs regs64")
	return e
}

// `.arch` sets clang's FP features for each ARM (A32) architecture, whatever came before.
func TestArm32FPArchs() testing.TestResult {
	var e @[]char = ""
	e = fpIs(e, ".arch armv4", "")
	e = fpIs(e, ".arch armv4t", "")
	e = fpIs(e, ".arch armv5t", "")
	e = fpIs(e, ".arch armv5te", "")
	e = fpIs(e, ".arch armv5tej", "")
	e = fpIs(e, ".arch armv6", "")
	e = fpIs(e, ".arch armv6k", "")
	e = fpIs(e, ".arch armv6t2", "")
	e = fpIs(e, ".arch armv6kz", "")
	e = fpIs(e, ".arch armv7-a", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv7-r", "")
	e = fpIs(e, ".arch armv8-a", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.1-a", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.2-a", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.3-a", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 d32sp regs regs64")
	e = fpIs(e, ".arch armv8.4-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot d32sp regs regs64")
	e = fpIs(e, ".arch armv8.5-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot d32sp regs regs64")
	e = fpIs(e, ".arch armv8.6-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv8.7-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv8.8-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv8.9-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv9-a", "vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot d32sp regs regs64")
	e = fpIs(e, ".arch armv9.1-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv9.2-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv9.3-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon aes sha2 dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv9.4-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv9.5-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch armv9.6-a",
			"vfp2 fp64 d32 vfp3 fp16 vfp4 v8 neon dot bf16 i8mm d32sp regs regs64")
	e = fpIs(e, ".arch iwmmxt", "")
	e = fpIs(e, ".arch iwmmxt2", "")
	e = fpIs(e, ".arch xscale", "")
	e = fpIs(e, ".arch armv7ve", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".arch armv8-r", "vfp2 vfp3 fp16 vfp4 v8 regs")
	e = fpIs(e, ".fpu vfpv4|.arch armv7ve", "vfp2 fp64 d32 vfp3 neon d32sp regs regs64")
	e = fpIs(e, ".cpu cortex-a76|.arch armv8-r", "vfp2 vfp3 fp16 vfp4 v8 regs")
	e = fpIs(e, ".fpu vfpv2|.arch armv8-r", "vfp2 vfp3 fp16 vfp4 v8 regs")
	return e
}

// Setting a feature sets all it implies (ARMv8's FP whole, crypto, FP16FML and the other NEON
// extensions imply every feature); clearing one clears all that implies it, and not what it
// implies: clearing VFPv2 without double precision from everything leaves the FP registers,
// double precision, 32 D registers and the half conversions.
func TestArm32FPClosure() testing.TestResult {
	var all uint64 = armFPSet(0,
			armFpV8 | armFpCrypto | armFpFP16FML | armFpDotProd | armFpBF16 | armFpI8MM)
	var regs uint64 = armFpRegs | armFpRegs16 | armFpRegs64
	if all != (armFpLast << 1) - 1 { return fail("not every feature is implied") }
	if armFPClear(all, armFpVFP2SP) != regs | armFpDP | armFpD32 | armFpHalf {
		return fail("clearing VFPv2 SP left the wrong features")
	}
	if armFPSet(0, armFpVFP3D16) !=
			regs & ~armFpRegs16 | armFpDP | armFpVFP2 | armFpVFP2SP | armFpVFP3D16 | armFpVFP3D16SP {
		return fail("VFPv3 D16 implies the wrong features")
	}
	return ""
}

// Every FPU the attributes know (asm.ArmFPUAttrs) has its FP features, and no other.
func TestArm32FPUNames() testing.TestResult {
	var names @[]*[]readonly char = @[]*[]readonly char{"none", "softvfp", "vfp", "vfpv2", "vfp2",
			"vfpv3", "vfp3", "vfpv3-fp16", "vfpv3-d16", "vfp3-d16", "vfpv3-d16-fp16", "vfpv3xd",
			"vfpv3xd-fp16", "vfpv4", "vfp4", "vfpv4-d16", "vfp4-d16", "fp4-dp-d16", "fpv4-dp-d16",
			"fpv4-sp-d16", "fp4-sp-d16", "vfpv4-sp-d16", "fpv5-d16", "fp5-dp-d16", "fpv5-dp-d16",
			"fpv5-sp-d16", "fp5-sp-d16", "fp-armv8", "fp-armv8-fullfp16-d16", "fp-armv8-fullfp16-sp-d16",
			"neon", "neon-vfpv3", "neon-fp16", "neon-vfpv4", "neon-fp-armv8", "crypto-neon-fp-armv8",
			"vfpv5"}
	for i := 0; i < len(names); i++ {
		_, _, _, attrs := asm.ArmFPUAttrs(names[i])
		_, fp := armFPU(names[i])
		if attrs != fp { return fail(buf.Concat("the FPU lists differ on ", names[i])) }
		if !fp && i + 1 < len(names) { return fail(buf.Concat("an FPU unknown: ", names[i])) }
	}
	return ""
}
