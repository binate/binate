package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// arm32MoveWide is the immediate operand of a MOVW or MOVT (or of a MOV that is one): a
// number (Sym empty, the value in Imm), or a `:lower16:` / `:upper16:` operand a relocation
// fills -- its kind (arm32.FIX_MOVW_ABS_NC, FIX_MOVT_ABS, FIX_MOVW_PREL_NC or FIX_MOVT_PREL),
// symbol and addend.
type arm32MoveWide struct {
	Imm    int
	Sym    @[]char
	Kind   int
	Addend int64
}

// arm32HalfNext reports whether the operand after the comma tok (l just after it) is a
// `:lower16:` / `:upper16:` one: a `:` after an optional `#` or `$`.
func arm32HalfNext(l Lexer, tok Token) bool {
	if tok.Kind != TOK_COMMA { return false }
	var t Token
	l, t = LexNext(l)
	if t.Kind == TOK_HASH || t.Kind == TOK_DOLLAR { l, t = LexNext(l) }
	return t.Kind == TOK_COLON
}

// parseArm32MoveWideImm parses MOVW / MOVT's `, imm` (tok the comma), as clang takes it: `#` or
// `$` before the immediate or neither (parseArm32OperandExpr), and the immediate a number, a
// constant's name, or a `:lower16:` / `:upper16:` operand (parseArm32Half).  A label difference
// outside one is an error, as clang leaves it to a fixup these instructions take only through
// one; so is a value that does not fit the host's int (rather than truncated by the cast).  The
// encoder checks the immediate's own range.
func parseArm32MoveWideImm(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32MoveWide, bool) {
	var mw arm32MoveWide
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return l, tok, mw, false
	}
	l, tok = LexNext(l)
	var halfL Lexer = l
	var halfTok Token = tok
	if halfTok.Kind == TOK_HASH || halfTok.Kind == TOK_DOLLAR { halfL, halfTok = LexNext(halfL) }
	if halfTok.Kind == TOK_COLON { return parseArm32Half(p, halfL) }
	var r ExprResult
	l, tok, r = parseArm32OperandExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid immediate"))
		return l, tok, mw, false
	}
	if r.FromDiff {
		setErr(p, "immediate expression for mov requires :lower16: or :upper16")
		return l, tok, mw, false
	}
	if !intFits(r.Val) {
		setErr(p, "immediate out of range")
		return l, tok, mw, false
	}
	mw.Imm = cast(int, r.Val)
	return l, tok, mw, true
}

// parseArm32Half parses a `:lower16:` / `:upper16:` operand from after its first `:` (l) to the
// end of its expression, as clang reads one: the operator in lower case, then an expression for
// the whole of which it stands --
//   - a number (a difference of two locations fixed here included): its low or high 16 bits,
//     the immediate itself;
//   - a symbol (or `.`) plus a number: the half of that address, a relocation
//     (R_ARM_MOVW_ABS_NC / R_ARM_MOVT_ABS);
//   - a symbol less `.` or a label in this section, plus a number: the half of the distance
//     from the instruction (R_ARM_MOVW_PREL_NC / R_ARM_MOVT_PREL), the label's own distance
//     folded into the addend.
// The relocation follows the operator, not the instruction (`movw r0, #:upper16:sym` is
// R_ARM_MOVT_ABS), as clang has it.
func parseArm32Half(p @Parser, l Lexer) (Lexer, Token, arm32MoveWide, bool) {
	var mw arm32MoveWide
	var tok Token
	l, tok = LexNext(l)
	var upper bool = tok.Kind == TOK_IDENT && charsEqual(tok.Text, "upper16")
	if !upper && !(tok.Kind == TOK_IDENT && charsEqual(tok.Text, "lower16")) {
		setErr(p, "unexpected prefix in operand")
		return l, tok, mw, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COLON {
		setErr(p, "unexpected token after prefix")
		return l, tok, mw, false
	}
	l, tok = LexNext(l)
	var r ExprResult
	var folds int = p.AcrossFolds
	l, tok, r = parseLevel(p, l, tok, 0)
	r = acrossAtomsResult(p, folds, r)
	if !r.Ok {
		setErr(p, exprErr(r, "expected relocatable expression"))
		return l, tok, mw, false
	}
	if r.Pending || !isSymbolic(r) && !hasNeg(r) {
		// A number (a placeholder 0 while it waits for a later label).
		if r.Val < -0x80000000 || r.Val > 0xFFFFFFFF {
			setErr(p, "a :lower16: / :upper16: value outside the 32-bit range (must be -2^31..2^32-1)")
			return l, tok, mw, false
		}
		var v int64 = r.Val & 0xFFFFFFFF
		if upper { v = v >> 16 }
		mw.Imm = cast(int, v & 0xFFFF)
		return l, tok, mw, true
	}
	mw.Kind = arm32.FIX_MOVW_ABS_NC
	if upper { mw.Kind = arm32.FIX_MOVT_ABS }
	mw.Addend = r.Val
	if hasNeg(r) {
		var ok bool
		mw.Addend, ok = arm32HalfDistance(p, r)
		if !ok { return l, tok, mw, false }
		mw.Kind = arm32.FIX_MOVW_PREL_NC
		if upper { mw.Kind = arm32.FIX_MOVT_PREL }
	}
	mw.Sym = r.Sym
	if r.Dot {
		mw.Sym = dotLabel(p)
		if p.Asm.HasError { return l, tok, mw, false }
	}
	return l, tok, mw, true
}

// arm32HalfDistance returns the addend of a `:lower16:` / `:upper16:` difference r (sym - N + a,
// N `.` or a label in this section) once the PC-relative relocation subtracts the instruction's
// own address: a + (the instruction - N).  N anywhere else, or `.` less a symbol, has no
// relocation: ok false, with p's error set.
func arm32HalfDistance(p @Parser, r ExprResult) (int64, bool) {
	if r.Dot {
		setErr(p, "the current location minus a symbol (`. - sym`) has no ELF relocation")
		return 0, false
	}
	if r.NegDot { return r.Val, true }
	if isExternal(p, r.Neg) {
		setErr(p,
				quotedName(asm.LabelForMessage(r.Neg), " is external: no ELF relocation subtracts a symbol"))
		return 0, false
	}
	var nl diffLocation = locationOf(p, r.Neg, false)
	if !nl.Ok || nl.Sec != p.Asm.Current {
		setErr(p,
				quotedName(asm.LabelForMessage(r.Neg),
						" is in another section than the instruction: no ELF relocation subtracts it"))
		return 0, false
	}
	unmarkAliasesOf(p, r.Neg) // folded into the addend
	return r.Val + cast(int64, p.Asm.CurrentOffset()) - cast(int64, nl.Off), true
}

// emitArm32MoveWide emits MOVW Rd (MOVT when top) with the immediate operand mw.
func emitArm32MoveWide(a @asm.Assembler, cond int, top bool, rd int, mw arm32MoveWide) {
	if len(mw.Sym) == 0 {
		if top {
			arm32.Movt(a, cond, rd, mw.Imm)
		} else {
			arm32.Movw(a, cond, rd, mw.Imm)
		}
		return
	}
	if top {
		arm32.MovtRef(a, cond, rd, mw.Sym, mw.Kind, mw.Addend)
	} else {
		arm32.MovwRef(a, cond, rd, mw.Sym, mw.Kind, mw.Addend)
	}
}
