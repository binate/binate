package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// armTextRelocs returns the relocations p's text section is left with, `KIND label` each, in
// order and space-separated, KIND a MOVW / MOVT relocation's name (another kind's number).
func armTextRelocs(p @Parser) @[]char {
	var s @asm.Section = sectionNamed(p, "text")
	var out @[]char = ""
	for i := 0; i < s.NumFixups; i++ {
		var f asm.Fixup = s.Fixups[i]
		if f.Kind < 0 { continue } // resolved
		var k @[]char = buf.CopyStr("?")
		if f.Kind == arm32.FIX_MOVW_ABS_NC { k = buf.CopyStr("MOVW_ABS_NC") }
		if f.Kind == arm32.FIX_MOVT_ABS { k = buf.CopyStr("MOVT_ABS") }
		if f.Kind == arm32.FIX_MOVW_PREL_NC { k = buf.CopyStr("MOVW_PREL_NC") }
		if f.Kind == arm32.FIX_MOVT_PREL { k = buf.CopyStr("MOVT_PREL") }
		if len(out) > 0 { out = buf.Concat(out, " ") }
		out = buf.Concat(buf.Concat(out, k), buf.Concat(" ", asm.LabelForMessage(f.Label)))
	}
	return out
}

// armHalfIs appends to e a failure unless insn, after the directives ctx, assembles on arm32 to
// the words want once its fixups are resolved (arm32.ResolveFixups writes a relocation's addend
// into its field, where clang's object has it) and leaves the relocations rels (armTextRelocs)
// -- or, want starting with '!', is rejected with an error containing the rest.
func armHalfIs(e @[]char, ctx *[]readonly char, insn *[]readonly char, want *[]readonly char,
		rels *[]readonly char) @[]char {
	if len(want) > 0 && want[0] == '!' { return armGateIs(e, ctx, insn, want) }
	var src @[]char = buf.Concat(buf.Concat(ctx, "\n.section text\n"), buf.Concat(insn, "\n"))
	var p @Parser = dataSource("arm32", src, asm.OBJ_ELF)
	var where @[]char = buf.Concat(buf.Concat(buf.Concat("`", ctx), "` / `"), buf.Concat(insn, "`: "))
	if p.HasError { return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n"))) }
	if !arm32.ResolveFixups(p.Asm) {
		return buf.Concat(e, buf.Concat(where, buf.Concat(p.Asm.ErrorMsg, "\n")))
	}
	var got @[]char = armTextWords(p)
	if !charsEqual(got, want) { return buf.Concat(e, buf.Concat(where, buf.Concat(got, "\n"))) }
	var gotRels @[]char = armTextRelocs(p)
	if !charsEqual(gotRels, rels) {
		return buf.Concat(e, buf.Concat(where, buf.Concat(gotRels, "\n")))
	}
	return e
}

// `:lower16:` / `:upper16:` operands of MOVW, MOVT and MOV, each case's words and relocations
// as clang (Apple clang 21, armv7ve ELF) makes them: `#`, `$` or no prefix; the relocation
// following the operator, not the instruction; the addend in the immediate; a number or a
// fixed difference folded to its half; a symbol less `.` or a label of this section
// PC-relative, the label's distance from the instruction in the addend.  A low-half addend past
// 16 bits keeps its low 16 bits, all the relocation needs (clang rejects an explicit one).
func TestArm32HalfOperands() testing.TestResult {
	var e @[]char = ""
	var g *[]readonly char = ".global ext"
	e = armHalfIs(e, g, "movw r0, #:lower16:ext", "E3000000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movt r0, #:upper16:ext", "E3400000", "MOVT_ABS ext")
	e = armHalfIs(e, g, "movw r0, :lower16:ext", "E3000000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw r0, $:lower16:ext", "E3000000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw r0, # :lower16: ext", "E3000000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "mov r0, #:lower16:ext", "E3000000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "mov r0, #:upper16:ext", "E3000000", "MOVT_ABS ext")
	e = armHalfIs(e, g, "moveq r0, #:lower16:ext", "03000000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw r0, #:upper16:ext", "E3000000", "MOVT_ABS ext")
	e = armHalfIs(e, g, "movt r0, #:lower16:ext", "E3400000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:ext+4", "E3000004", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movt r0, #:upper16:ext+4", "E3400004", "MOVT_ABS ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:ext - 4", "E30F0FFC", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:ext+0x7FFF", "E3070FFF", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movt r0, #:upper16:ext-0x8000", "E3480000", "MOVT_ABS ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:ext+0x8000", "E3080000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:ext-0x8001", "E3070FFF", "MOVW_ABS_NC ext")
	e = armHalfIs(e, g, "movw pc, #:lower16:ext", "E300F000", "MOVW_ABS_NC ext")
	e = armHalfIs(e, buf.Concat(g, "\nA = ext + 4"), "movw r0, #:lower16:A", "E3000004",
			"MOVW_ABS_NC ext")
	e = armHalfIs(e, "", "lbl: nop\nmovt r0, #:upper16:lbl+8", "E320F000 E3400008", "MOVT_ABS lbl")
	e = armHalfIs(e, "", "movw r0, #:lower16:0x12345678", "E3050678", "")
	e = armHalfIs(e, "", "movt r0, #:upper16:0x12345678", "E3410234", "")
	e = armHalfIs(e, "", "movw r0, #:upper16:0x12345678", "E3010234", "")
	e = armHalfIs(e, "", "mov r0, #:lower16:0x12345678", "E3050678", "")
	e = armHalfIs(e, "", "movt r0, #:upper16:-4", "E34F0FFF", "")
	e = armHalfIs(e, "K = 0x12345678", "movt r0, #:upper16:K", "E3410234", "")
	e = armHalfIs(e, "", "a: nop\nb: nop\nmovw r0, #:lower16:(b-a)", "E320F000 E320F000 E3000004", "")
	e = armHalfIs(e, "", "movw r0, #:lower16:(b-a)\na: nop\nb: nop", "E3000004 E320F000 E320F000", "")
	e = armHalfIs(e, "", "lbl: nop\nmovw r0, #:lower16:(lbl - .)", "E320F000 E30F0FFC", "")
	if len(e) > 0 { return fail(e) }
	return ""
}

// A PC-relative `:lower16:` / `:upper16:` (clang's R_ARM_MOVW_PREL_NC / R_ARM_MOVT_PREL): a symbol
// less `.` or a label of this section, earlier or later, the label's distance from the
// instruction folded into the addend; a symbol subtracted that is external or elsewhere has no
// relocation.
func TestArm32HalfPcRelative() testing.TestResult {
	var e @[]char = ""
	var g *[]readonly char = ".global ext"
	e = armHalfIs(e, g, "movw r0, #:lower16:(ext - .)", "E3000000", "MOVW_PREL_NC ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:ext - .", "E3000000", "MOVW_PREL_NC ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:(ext - (1f + 8))\n1: nop", "E30F0FF4 E320F000",
			"MOVW_PREL_NC ext")
	e = armHalfIs(e, g, "movt r0, #:upper16:(ext - (1f + 8))\n1: nop", "E34F0FF4 E320F000",
			"MOVT_PREL ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:(ext - lbl)\nlbl: nop", "E30F0FFC E320F000",
			"MOVW_PREL_NC ext")
	e = armHalfIs(e, g, "movw r0, #:lower16:(ext - lbl + 4)\nlbl: nop", "E3000000 E320F000",
			"MOVW_PREL_NC ext")
	e = armHalfIs(e, ".section data\nd: .uint32 0", "movw r0, #:lower16:(d - .)", "E3000000",
			"MOVW_PREL_NC d")
	e = armHalfIs(e, buf.Concat(g, "\n.global ext2"), "movw r0, #:lower16:(ext - ext2)", "!ext2", "")
	e = armHalfIs(e, g, "movw r0, #:lower16:(. - ext)", "!", "")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The forms clang rejects: an operator in upper case or missing its second `:`, a half outside
// MOV / MOVW / MOVT (a number's too) or in MOVS or before ARMv6T2, a high-half addend outside
// [-0x8000, 0x7FFF], an expression no relocation is (`(ext+4)*2`), and a rotation after it.
func TestArm32HalfRejects() testing.TestResult {
	var e @[]char = ""
	var g *[]readonly char = ".global ext"
	e = armGateIs(e, g, "movw r0, #:LOWER16:ext", "!unexpected prefix in operand")
	e = armGateIs(e, g, "movw r0, #:lower16 ext", "!unexpected token after prefix")
	e = armGateIs(e, g, "add r0, r0, #:lower16:ext", "!expected relocatable expression")
	e = armGateIs(e, "", "cmp r0, #:lower16:4", "!expected relocatable expression")
	e = armGateIs(e, g, "mvn r0, #:lower16:ext", "!expected relocatable expression")
	e = armGateIs(e, "", "movs r0, #:lower16:4", "!expected relocatable expression")
	e = armGateIs(e, buf.Concat(".arch armv6\n", g), "mov r0, #:lower16:ext",
			"!expected relocatable expression")
	e = armGateIs(e, buf.Concat(".arch armv6\n", g), "movw r0, #:lower16:ext",
			"!instruction requires: armv6t2")
	e = armGateIs(e, g, "movt r0, #:upper16:ext-0x8001", "!addend must be in [-0x8000, 0x7FFF]")
	e = armGateIs(e, g, "movw r0, #:lower16:(ext+4)*2", "!")
	e = armGateIs(e, g, "movw r0, #:lower16:ext, 2", "!")
	e = armGateIs(e, g, "movt pc, #:upper16:ext", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "movw r0, #:lower16:0x123456789", "!outside the 32-bit range")
	if len(e) > 0 { return fail(e) }
	return ""
}

// armHalfWordIs appends to e a failure unless src assembles on arm32, its fixups resolved
// (armHalfIs), with the word want at byte at of its text section.
func armHalfWordIs(e @[]char, src *[]readonly char, at int, want uint32) @[]char {
	var p @Parser = dataSource("arm32", buf.Concat(buf.Concat(".section text\n", src), "\n"),
			asm.OBJ_ELF)
	var where @[]char = buf.Concat(buf.Concat("`", src), "`: ")
	if p.HasError { return buf.Concat(e, buf.Concat(where, buf.Concat(p.ErrorMsg, "\n"))) }
	if !arm32.ResolveFixups(p.Asm) {
		return buf.Concat(e, buf.Concat(where, buf.Concat(p.Asm.ErrorMsg, "\n")))
	}
	var s @asm.Section = sectionNamed(p, "text")
	if at + 4 > s.Len || readWord(s, at) != want {
		return buf.Concat(e, buf.Concat(where, "wrong word\n"))
	}
	return e
}

// A distance or difference past 16 bits (a gap of 0x8000 bytes or more): a low-half relocation
// keeps the addend's low 16 bits, all it needs -- clang's bytes for a distance it folds; a
// high-half one takes none, an error (clang truncates it there, a wrong high half); a fixed
// difference is its true half (clang: "Relocation Not In Range").
func TestArm32HalfAddendRange() testing.TestResult {
	var e @[]char = ""
	e = armHalfWordIs(e, ".global ext\nlbl: .zero 0x8000\nmovw r0, #:lower16:(ext - lbl)", 0x8000,
			0xE3080000)
	e = armHalfWordIs(e, ".global ext\nmovw r0, #:lower16:(ext - lbl)\n.zero 0x9000\nlbl: nop", 0,
			0xE3060FFC)
	e = armHalfWordIs(e, "movw r0, #:lower16:(b - a)\na: .zero 0x9000\nb: nop", 0, 0xE3090000)
	e = armHalfWordIs(e, "a: .zero 0x20000\nb: nop\nmovt r0, #:upper16:(b - a)", 0x20004, 0xE3400002)
	e = armGateIs(e, ".global ext", "movt r0, #:upper16:(ext - 1f)\n.zero 0x8000\n1: nop",
			"!a MOVT relocation's addend must be in [-0x8000, 0x7FFF]")
	e = armGateIs(e, ".global ext", "lbl: .zero 0x9000\nmovt r0, #:upper16:(ext - lbl)",
			"!a MOVT relocation's addend must be in [-0x8000, 0x7FFF]")
	if len(e) > 0 { return fail(e) }
	return ""
}
