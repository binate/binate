package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// --- ARM32 instruction dispatch ---

// parseArm32Instruction parses an ARM32 mnemonic (with optional condition
// suffix and S flag) and its operands, then emits via the arm32 encoding package.
func parseArm32Instruction(p @Parser, l Lexer, mnemTok Token) {
	// clang's NEON aliases vaddq .. vcvtq are the instructions without the q (arm32_qalias.bn).
	var renamed @[]char = arm32QAlias(p, mnemTok.Text)
	if p.HasError { return }
	if len(renamed) > 0 { mnemTok.Text = renamed }
	// bnlint:allow managed-to-raw-assign - mnemTok is a live token; Text outlives the read
	var mnem *[]readonly char = mnemTok.Text
	var a @asm.Assembler = p.Asm
	// --- VFP instructions: data processing (arm32_vfp.bn), VMOV (arm32_vmov.bn), VMRS / VMSR,
	// VINS / VMOVX (arm32_vmrs.bn), the conversions and ARMv8's (arm32_cvt.bn), VLDR / VSTR
	// (arm32_vldr.bn), VLDM / VSTM and VPUSH / VPOP (arm32_vldm.bn); their data types, `.w` and
	// `.n` are in the mnemonic ---
	if parseArm32Vfp(p, l, mnem) { return }
	if parseArm32Vmov(p, l, mnem) { return }
	if parseArm32Vmrs(p, l, mnem) { return }
	if parseArm32Cvt(p, l, mnem) { return }
	if parseArm32Vldr(p, l, mnem) { return }
	if parseArm32Vldm(p, l, mnem) { return }

	// `.w` width qualifiers are taken and ignored, as clang takes them in ARM code (they pick a
	// Thumb encoding's width); `.n` is an error there.
	for len(mnem) > 2 && mnem[len(mnem) - 2] == '.' &&
			(arm32Lower(mnem[len(mnem) - 1]) == 'w' || arm32Lower(mnem[len(mnem) - 1]) == 'n') {
		if arm32Lower(mnem[len(mnem) - 1]) == 'n' {
			setErr(p, "instruction with .n (narrow) qualifier not allowed in arm mode")
			return
		}
		mnem = mnem[0:len(mnem) - 2]
	}

	// Split mnemonic into base + condition + S flag
	var baseMnem *[]readonly char
	var cond int = arm32.COND_AL
	var setFlags bool = false
	baseMnem, cond, setFlags = splitMnem(mnem)
	p.Arm32DataProc = arm32IsDataProc(baseMnem) || mnemIs(baseMnem, "mov") ||
			mnemIs(baseMnem, "mvn") || mnemIs(baseMnem, "cmp") || mnemIs(baseMnem, "cmn") ||
			mnemIs(baseMnem, "tst") || mnemIs(baseMnem, "teq")
	p.Arm32ImmDiff = false
	p.Arm32ImmName = false
	if setFlags && !arm32SetsFlags(baseMnem) {
		var msg @[]char = buf.Concat("instruction '", baseMnem)
		setErr(p, buf.Concat(msg, "' can not set flags, but 's' suffix specified"))
		return
	}

	// --- System and hint instructions (arm32_sys.bn) ---
	if parseArm32System(p, l, baseMnem, cond) { return }

	// --- Coprocessor instructions (arm32_cp.bn) ---
	if parseArm32Coproc(p, l, baseMnem, cond) { return }

	// --- B / BL target (arm32_target.bn) ---
	if mnemIs(baseMnem, "b") || mnemIs(baseMnem, "bl") {
		parseArm32Branch(p, l, cond, mnemIs(baseMnem, "bl"))
		return
	}

	// --- BX / BXJ / BLX reg, BLX label (arm32_target.bn) ---
	if mnemIs(baseMnem, "bx") || mnemIs(baseMnem, "bxj") || mnemIs(baseMnem, "blx") {
		var tok Token
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF {
			setErr(p, "too few operands for instruction")
			return
		}
		var reg int = -1
		if tok.Kind == TOK_IDENT { reg = parseArm32Reg(tok.Text) }
		if reg < 0 && mnemIs(baseMnem, "blx") && !(tok.Kind == TOK_IDENT && arm32RegisterName(tok.Text)) {
			parseArm32BlxTarget(p, l, tok, cond)
			return
		}
		if reg < 0 {
			setErr(p, "operand must be a register in range [r0, r15]")
			return
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_COMMA {
			setErr(p, "too many operands for instruction")
			return
		}
		if !arm32AtEOL(p, tok) { return }
		if mnemIs(baseMnem, "bxj") {
			arm32.Bxj(a, cond, reg)
		} else if mnemIs(baseMnem, "bx") {
			if armRequire(p, armV4T, "armv4t") { arm32.Bx(a, cond, reg) }
		} else if armRequire(p, armV5T, "armv5t") {
			arm32.Blx(a, cond, reg)
		}
		return
	}

	// --- PUSH / POP {reglist} ---
	if mnemIs(baseMnem, "push") || mnemIs(baseMnem, "pop") {
		var tok Token
		l, tok = LexNext(l)
		if tok.Kind != TOK_LBRACE {
			setErr(p, "expected '{' for register list")
			return
		}
		var mask int = 0
		l, tok, mask = parseArm32RegList(p, l)
		if !arm32AtEOL(p, tok) { return }
		if mnemIs(baseMnem, "push") {
			arm32.Push(a, cond, mask)
		} else {
			arm32.Pop(a, cond, mask)
		}
		return
	}

	// --- LDM / STM, every addressing mode and stack alias ---
	if parseArm32BlockTransfer(p, l, baseMnem, cond) { return }

	// --- PLD / PLDW / PLI <mem> (arm32_memd.bn), CLREX (arm32_excl.bn) ---
	if parseArm32Preload(p, l, baseMnem, cond) { return }
	if parseArm32Clrex(p, l, baseMnem, cond) { return }

	// --- Instructions that start with a register ---
	var tok Token
	l, tok = LexNext(l)
	var rd int = parseArm32Reg(tok.Text)
	if rd < 0 { setErr(p, "expected register"); return }
	l, tok = LexNext(l)

	// --- LSL / LSR / ASR / ROR / RRX: MOV with a shifted register ---
	if parseArm32ShiftAlias(p, l, tok, baseMnem, cond, setFlags, rd) { return }

	// --- ADR Rd, target: an ADD / SUB from PC ---
	if mnemIs(baseMnem, "adr") {
		parseArm32Adr(p, l, tok, cond, rd)
		return
	}

	// --- MOVW/MOVT Rd, #imm16 or a :lower16: / :upper16: operand ---
	if mnemIs(baseMnem, "movw") || mnemIs(baseMnem, "movt") {
		var mw arm32MoveWide
		var ok bool
		l, tok, mw, ok = parseArm32MoveWideImm(p, l, tok)
		if !ok || !arm32AtEOL(p, tok) || !armRequire(p, armV6T2, "armv6t2") { return }
		emitArm32MoveWide(a, cond, mnemIs(baseMnem, "movt"), rd, mw)
		return
	}
	// MOV with a :lower16: / :upper16: operand is MOVW, as clang has it (none for MOVS, or before
	// ARMv6T2).
	if mnemIs(baseMnem, "mov") && arm32HalfNext(l, tok) {
		if setFlags || p.Arm32Feats & armV6T2 == 0 {
			setErr(p, "expected relocatable expression")
			return
		}
		var mw arm32MoveWide
		var ok bool
		l, tok, mw, ok = parseArm32MoveWideImm(p, l, tok)
		if !ok || !arm32AtEOL(p, tok) { return }
		emitArm32MoveWide(a, cond, false, rd, mw)
		return
	}

	// --- MOV/MVN Rd, op2 (an immediate with no encoding as clang substitutes it:
	// arm32ImmAlt) ---
	if mnemIs(baseMnem, "mov") || mnemIs(baseMnem, "mvn") {
		var op arm32.Operand
		l, tok, op = expectArm32CommaOp(p, l, tok)
		if !arm32AtEOL(p, tok) { return }
		var m *[]readonly char
		var ok bool
		m, op, ok = arm32ImmFor(p, baseMnem, setFlags, op, rd)
		if !ok { return }
		if mnemIs(m, "movw") {
			arm32.Movw(a, cond, rd, op.Imm)
		} else if mnemIs(m, "mov") {
			arm32.Mov(a, cond, setFlags, rd, op)
		} else {
			arm32.Mvn(a, cond, setFlags, rd, op)
		}
		return
	}

	// --- CMP/CMN/TST/TEQ Rn, op2 (Rd is really Rn here) ---
	if mnemIs(baseMnem, "cmp") || mnemIs(baseMnem, "cmn") {
		var op arm32.Operand
		l, tok, op = expectArm32CommaOp(p, l, tok)
		if !arm32AtEOL(p, tok) { return }
		var m *[]readonly char
		var ok bool
		m, op, ok = arm32ImmFor(p, baseMnem, false, op, rd)
		if !ok { return }
		if mnemIs(m, "cmp") {
			arm32.Cmp(a, cond, rd, op)
		} else {
			arm32.Cmn(a, cond, rd, op)
		}
		return
	}
	if mnemIs(baseMnem, "tst") {
		var op arm32.Operand
		l, tok, op = expectArm32CommaOp(p, l, tok)
		if !arm32AtEOL(p, tok) { return }
		var ok bool
		_, op, ok = arm32ImmFor(p, baseMnem, false, op, rd)
		if !ok { return }
		arm32.Tst(a, cond, rd, op)
		return
	}
	if mnemIs(baseMnem, "teq") {
		var op arm32.Operand
		l, tok, op = expectArm32CommaOp(p, l, tok)
		if !arm32AtEOL(p, tok) { return }
		var ok bool
		_, op, ok = arm32ImmFor(p, baseMnem, false, op, rd)
		if !ok { return }
		arm32.Teq(a, cond, rd, op)
		return
	}

	// --- Loads and stores: Rt, memop (arm32_mem.bn) ---
	if parseArm32LoadStore(p, l, tok, baseMnem, cond, rd) { return }
	if parseArm32Ldrd(p, l, tok, baseMnem, cond, rd) { return }
	if parseArm32Excl(p, l, tok, baseMnem, cond, rd) { return }

	// --- Multiplies and divides (arm32_mul.bn) ---
	if parseArm32Multiply(p, l, tok, baseMnem, cond, setFlags, rd) { return }

	// --- Saturate, parallel add / subtract, select, absolute differences, pack (arm32_media.bn) ---
	if parseArm32Media(p, l, tok, baseMnem, cond, rd) { return }

	// --- Extend, bitfield, reverse, count leading zeros (arm32_bits.bn) ---
	if parseArm32Bits(p, l, tok, baseMnem, cond, rd) { return }

	// --- Arithmetic and logical: Rd, Rn, op2, or Rd, op2 for Rd, Rd, op2 (arm32_dp.bn) ---
	if parseArm32DataProc(p, l, tok, baseMnem, cond, setFlags, rd) { return }

	setErr(p, "unknown instruction")
}

// parseArm32LabelRef parses a label reference whose expression starts at tok: a symbol
// plus a number (`lbl`, `lbl+4+4`, `4+lbl`, `(lbl+4)`, an alias), returning the symbol, the
// addend and the token after it.  A number (a constant included) or `.` is an error: such a
// target is an offset from the instruction, which these operands do not take.
func parseArm32LabelRef(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, int, bool) {
	var none @[]char
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid label operand"))
		return l, tok, none, 0, false
	}
	if len(r.Sym) == 0 {
		setErr(p, "expected a label, not a number or '.'")
		return l, tok, none, 0, false
	}
	if !intFits(r.Val) {
		setErr(p, "label addend out of range")
		return l, tok, none, 0, false
	}
	return l, tok, r.Sym, cast(int, r.Val), true
}

// arm32AtEOL reports whether the line is still free of errors and tok — the token after
// the instruction's last operand — ends it, setting the error when it does not, so a line
// with trailing text (an extra operand, `junk`) is rejected before anything is emitted.
func arm32AtEOL(p @Parser, tok Token) bool {
	if !p.HasError && tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the instruction's operands")
	}
	return !p.HasError
}
