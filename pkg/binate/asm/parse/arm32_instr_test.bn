	p.ParseLine("and r0, r1, #0xFF")
	if p.HasError { return fail(p.ErrorMsg) }
	var inst uint32 = readWord(a.Sections[0], 0)
	if inst != 0xE20100FF {
		return fail("AND R0, R1, #0xFF parse wrong")
	}
	return ""
}

// arm32SrcWord parses src (lines split on '\n') for arm32, resolves its fixups and returns
// the word at off, or fails.
func arm32SrcWord(src *[]readonly char, off int) (uint32, @[]char) {
	var p @Parser
	var a @asm.Assembler
	p, a = newArm32Parser()
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
	p.Finish()
	if p.HasError { return 0, buf.CopyStr(p.ErrorMsg) }
	if !arm32.ResolveFixups(a) { return 0, buf.CopyStr(a.ErrorMsg) }
	return readWord(a.Sections[0], off), ""
}

// arm32SrcWordIs checks that src's word at off is want (clang's).
func arm32SrcWordIs(e @[]char, src *[]readonly char, off int, want uint32) @[]char {
	w, err := arm32SrcWord(src, off)
	if len(err) > 0 { return goldenFail(e, src, err) }
	if w != want { return goldenFail(e, src, "not clang's word") }
	return e
}

// A label operand takes a `+` / `-` addend — one number or a parenthesized expression, as
// AArch64 does — into its fixup: clang's words (armv7-linux-gnueabi) in place and, against
// an external, with the REL field holding addend - 8.
func TestParseArm32LabelAddends() testing.TestResult {
	var e @[]char = ""
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nldr r0, lbl+4", 8, 0xE51F000C)
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nldr r0, lbl + 4", 8, 0xE51F000C)
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nldr r0, lbl+(2*2)", 8, 0xE51F000C)
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nldrh r0, lbl+2", 8, 0xE15F00BE)
	e = arm32SrcWordIs(e, "lbl: nop\nnop\nb lbl+4", 8, 0xEAFFFFFD)
	e = arm32SrcWordIs(e, "lbl: nop\nb lbl-4", 4, 0xEAFFFFFC)
	e = arm32SrcWordIs(e, "1: .uint32 1\nldr r0, 1b+4", 4, 0xE51F0008)
	e = arm32SrcWordIs(e, "ldr r0, ext+4", 0, 0xE51F0004)
	e = arm32SrcWordIs(e, "bl ext+8", 0, 0xEB000000)
	e = arm32SrcWordIs(e, "lbl: nop\nnop\nbeq lbl+4", 8, 0x0AFFFFFD)
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nstr r0, lbl+4", 8, 0xE50F000C)
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nstrb r0, lbl+4", 8, 0xE54F000C)
	e = arm32SrcWordIs(e, "lbl: .uint32 1\n.uint32 2\nldrsh r0, lbl+2", 8, 0xE15F00FE)
	e = arm32SrcWordIs(e, "ldrsb r0, ext+3", 0, 0xE15F00D5)
	e = arm32SrcWordIs(e, "ldr r0, ext-4", 0, 0xE51F000C)
	e = arm32SrcWordIs(e, "b ext+4", 0, 0xEAFFFFFF)
	e = arm32SrcWordIs(e, "bl ext-4", 0, 0xEBFFFFFD)
	return e
}

// `@` starts a line comment on arm32 (ARM's comment character), outside a string or
// character literal (clang: `mov r0, r1 @ comment` is E1A00001; `.ascii "a@b"` is 61 40 62);
// and `, rrx` ends its operand (`add r0, r1, r2, rrx` is E0810062).
func TestParseArm32AtCommentAndRrx() testing.TestResult {
	var e @[]char = ""
	e = arm32SrcWordIs(e, "mov r0, r1 @ comment", 0, 0xE1A00001)
	e = arm32SrcWordIs(e, "add r0, r1, r2 @ x, y", 0, 0xE0810002)
	e = arm32SrcWordIs(e, ".ascii \"a@b\" @ c", 0, 0x00624061)
	e = arm32SrcWordIs(e, "add r0, r1, r2, rrx", 0, 0xE0810062)
	return e
}

// Text after an instruction's last operand — a stray token, an extra operand — is rejected
// with nothing emitted, after every instruction shape (conditional and flag-setting
// mnemonics included) and every operand form; so are a memory operand left unclosed or
// with a dangling post-index comma (clang: "']' expected", "unexpected token in operand"),
// and a label operand followed by a stray token after its addend.
func TestParseArm32TrailingTextRejected() testing.TestResult {
	var bad @[]@[]char = make_slice(@[]char, 33)
	bad[0] = "nop x"
	bad[1] = "bkpt #1 x"
	bad[2] = "svc #0 x"
	bad[3] = "b lbl x"
	bad[4] = "bl lbl, r0"
	bad[5] = "bx lr x"
	bad[6] = "blx r0 x"
	bad[7] = "push {r0} x"
	bad[8] = "ldm r0, {r1} x"
	bad[9] = "clz r0, r1 x"
	bad[10] = "movw r0, #1 x"
	bad[11] = "mov r0, #1, r2"
	bad[12] = "cmp r0, #1 x"
	bad[13] = "ldr r0, [r1] x"
	bad[14] = "ldr r0, lbl x"
	bad[15] = "mul r0, r1, r2 x"
	bad[16] = "mla r0, r1, r2, r3 x"
	bad[17] = "umull r0, r1, r2, r3 x"
	bad[18] = "add r0, r1, r2 junk"
	bad[19] = "add r0, r1, r2, rrx #3"
	bad[20] = "ldr r0, lbl+4+4 x"
	bad[21] = "ldr r0, (lbl+2) x"
	bad[22] = "ldr r0, [r1, #4]! x"
	bad[23] = "ldr r0, [r1], #4 x"
	bad[24] = "ldr r0, [r1], r2 x"
	bad[25] = "ldr r0, [r1, r2] x"
	bad[26] = "ldr r0, [r1, r2, lsl #2] x"
	bad[27] = "add r0, r1, r2, lsl #2 x"
	bad[28] = "add r0, r1, r2, lsl r3 x"
	bad[29] = "addeq r0, r1, r2 x"
	bad[30] = "beq lbl x"
	bad[31] = "ldr r0, [r1, #4"
	bad[32] = "ldr r0, [r1],"
	for i := 0; i < len(bad); i++ {
		var p @Parser
		p, _ = newArm32Parser()
		var r testing.TestResult = lineRejected(p, bad[i])
		if len(r) > 0 { return r }
	}
	return ""
}

// Through the text parser: references to a `.global` / `.weak` symbol in the file's own
// section stay relocations (as clang leaves them), and one to a local label resolves in
// place.
func TestParseArm32GlobalWeakTargets() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newArm32Parser()
	var lines @[]@[]char = make_slice(@[]char, 8)
	lines[0] = ".global g"
	lines[1] = ".weak w"
	lines[2] = "g: .uint32 1"
	lines[3] = "w: .uint32 2"
	lines[4] = "loc: .uint32 3"
	lines[5] = "b g"
	lines[6] = "ldr r0, w"
	lines[7] = "b loc"
	for i := 0; i < len(lines); i++ { p.ParseLine(lines[i]) }
	p.Finish()
	if p.HasError { return fail(p.ErrorMsg) }
	if !arm32.ResolveFixups(a) { return fail(a.ErrorMsg) }
	if !a.Finalize() || a.HasError { return fail(a.ErrorMsg) }
	if a.NumRelocs != 2 { return fail("expected relocations for g and w only") }
	if readWord(a.Sections[0], 20) != 0xEAFFFFFB { return fail("b loc not resolved in place") }
	return ""
}
