package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"

// arm32BlockMode returns whether baseMnem names a block transfer (LDM / STM) and,
// if so, whether it loads and its addressing mode: the explicit modes (`ia`, `ib`,
// `da`, `db`, plain LDM / STM being IA) and the stack aliases clang takes, a full
// descending stack's LDMFD = LDMIA / STMFD = STMDB and an empty ascending one's
// LDMEA = LDMDB / STMEA = STMIA.
func arm32BlockMode(baseMnem *[]readonly char) (bool, bool, int) {
	if mnemIs(baseMnem, "ldm") || mnemIs(baseMnem, "ldmia") || mnemIs(baseMnem, "ldmfd") {
		return true, true, arm32.BT_IA
	}
	if mnemIs(baseMnem, "ldmib") { return true, true, arm32.BT_IB }
	if mnemIs(baseMnem, "ldmda") { return true, true, arm32.BT_DA }
	if mnemIs(baseMnem, "ldmdb") || mnemIs(baseMnem, "ldmea") { return true, true, arm32.BT_DB }
	if mnemIs(baseMnem, "stm") || mnemIs(baseMnem, "stmia") || mnemIs(baseMnem, "stmea") {
		return true, false, arm32.BT_IA
	}
	if mnemIs(baseMnem, "stmib") { return true, false, arm32.BT_IB }
	if mnemIs(baseMnem, "stmda") { return true, false, arm32.BT_DA }
	if mnemIs(baseMnem, "stmdb") || mnemIs(baseMnem, "stmfd") { return true, false, arm32.BT_DB }
	return false, false, 0
}

// parseArm32BlockTransfer assembles `ldm{mode}{cond} Rn{!}, {reglist}{^}` and the
// STM forms (arm32BlockMode); `^` transfers the user-mode registers.  As in clang
// (for ARMv7), `^` takes writeback only on an LDM whose list holds PC (the
// exception return), and any other LDM with writeback must not load Rn (which
// arm32.BlockTransfer rejects).  Reports whether baseMnem was a block transfer (it is
// then assembled, or the error set).
func parseArm32BlockTransfer(p @Parser, l Lexer, baseMnem *[]readonly char, cond int) bool {
	var isBT bool
	var load bool
	var mode int
	isBT, load, mode = arm32BlockMode(baseMnem)
	if !isBT { return false }
	var tok Token
	l, tok = LexNext(l)
	var baseReg int = parseArm32Reg(tok.Text)
	if baseReg < 0 {
		setErr(p, "expected register for LDM/STM")
		return true
	}
	l, tok = LexNext(l)
	var wb bool = false
	if tok.Kind == TOK_BANG {
		wb = true
		l, tok = LexNext(l)
	}
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' after the base register")
		return true
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_LBRACE {
		setErr(p, "expected '{' for register list")
		return true
	}
	var mask int = 0
	l, tok, mask = parseArm32RegList(p, l)
	var user bool = false
	if tok.Kind == TOK_CARET {
		user = true
		l, tok = LexNext(l)
	}
	if !arm32AtEOL(p, tok) { return true }
	if user && wb && (!load || (mask & 0x8000) == 0) {
		setErr(p, "writeback with '^' is only an LDM with PC in its register list")
		return true
	}
	arm32.BlockTransfer(p.Asm, cond, load, mode, baseReg, wb, user, mask)
	return true
}
