package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// LDM / STM in every addressing mode and stack alias clang takes, each line's word as
// clang assembles it (`clang -target armv7a-none-eabi`).  (arm32CheckGoldens /
// arm32CheckRejects are in arm32_alias_test.bn.)

func TestParseArm32BlockTransfers() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 26)
	g[0] = arm32MemGolden{line: "ldmfd r0, {r1}", word: 0xE8900002}
	g[1] = arm32MemGolden{line: "stmfd r0, {r1}", word: 0xE9000002}
	g[2] = arm32MemGolden{line: "ldmea r0, {r1}", word: 0xE9100002}
	g[3] = arm32MemGolden{line: "stmea r0, {r1}", word: 0xE8800002}
	g[4] = arm32MemGolden{line: "stmia r0, {r1}", word: 0xE8800002}
	g[5] = arm32MemGolden{line: "ldmia r0, {r1}", word: 0xE8900002}
	g[6] = arm32MemGolden{line: "ldmib r0, {r1}", word: 0xE9900002}
	g[7] = arm32MemGolden{line: "ldmda r0, {r1}", word: 0xE8100002}
	g[8] = arm32MemGolden{line: "stmib r0, {r1}", word: 0xE9800002}
	g[9] = arm32MemGolden{line: "stmda r0, {r1}", word: 0xE8000002}
	g[10] = arm32MemGolden{line: "ldm r0, {r1}^", word: 0xE8D00002}
	g[11] = arm32MemGolden{line: "stmdb sp, {r0, r1}^", word: 0xE94D0003}
	g[12] = arm32MemGolden{line: "ldmib r0, {r1, r2}", word: 0xE9900006}
	g[13] = arm32MemGolden{line: "ldmda r0!, {r1}", word: 0xE8300002}
	g[14] = arm32MemGolden{line: "stmib sp, {r0}^", word: 0xE9CD0001}
	g[15] = arm32MemGolden{line: "ldm r0!, {r1, pc}^", word: 0xE8F08002}
	g[16] = arm32MemGolden{line: "ldm r0, {r1, pc}^", word: 0xE8D08002}
	g[17] = arm32MemGolden{line: "ldmdbeq r0!, {r1, r2}", word: 0x09300006}
	g[18] = arm32MemGolden{line: "ldmfdne sp!, {r4-r6, pc}", word: 0x18BD8070}
	g[19] = arm32MemGolden{line: "stmfdeq sp!, {r4, lr}", word: 0x092D4010}
	g[20] = arm32MemGolden{line: "stm r1!, {r0, r1}", word: 0xE8A10003}
	g[21] = arm32MemGolden{line: "ldmda r1!, {r1, pc}^", word: 0xE8718002}
	g[22] = arm32MemGolden{line: "ldm r0!, {r0, pc}^", word: 0xE8F08001}
	g[23] = arm32MemGolden{line: "ldm sp!, {r0}", word: 0xE8BD0001}
	g[24] = arm32MemGolden{line: "stmdb r0!, {r1, r2, r3}", word: 0xE920000E}
	g[25] = arm32MemGolden{line: "ldm r0, {r1, r2}", word: 0xE8900006}
	return arm32CheckGoldens(g)
}

// Forms clang rejects: the stack aliases it does not take (LDMED, LDMFA, STMFA,
// STMED), `^` with writeback on an STM or on an LDM whose list lacks PC, an LDM with
// writeback loading its base, the cond before the mode (pre-UAL `ldmeqia`), and a
// missing comma or register list.
func TestParseArm32BlockTransferRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 11)
	bad[0] = "ldmed r0, {r1}"
	bad[1] = "ldmfa r0, {r1}"
	bad[2] = "stmfa r0, {r1}"
	bad[3] = "stmed r0, {r1}"
	bad[4] = "stmdb sp!, {r0}^"
	bad[5] = "ldmdbeq r0!, {r1, r2}^"
	bad[6] = "ldmia r0!, {r0, r1}"
	bad[7] = "ldm r0!, {r0}"
	bad[8] = "ldmeqia r0, {r1}"
	bad[9] = "ldm r0 {r1}"
	bad[10] = "ldm r0, r1"
	return arm32CheckRejects(bad)
}
