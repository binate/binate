package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// An instruction's operands matched against its encodings as clang's matcher does: an encoding
// whose types and operands all match, its features in effect, is the instruction; one off by a
// single type or operand, by too few or too many operands, or by its features alone, is a near
// miss, and the near misses (one message each, duplicates dropped as clang drops them) make the
// error: none "invalid instruction", one its message, more clang's "invalid instruction, any one
// of the following would fix this:".

// arm32MatchKindAt returns the kind of operand i (from 0) of an encoding's ops, 0 past the last.
func arm32MatchKindAt(ops int64, i int) int { return cast(int, (ops >> cast(uint, 7 * i)) & 127) }

// arm32MatchItemIs reports whether operand it is of kind k (matchKind*); an expression that is no
// number (a label, `.`, one with a `:lower16:`-style prefix) is VLDR's address, M-profile's too.
func arm32MatchItemIs(p @Parser, k int, it arm32MatchItem) bool {
	if k == matchKindS { return it.kind == matchItemS }
	if k == matchKindD { return it.kind == matchItemD }
	if k == matchKindQ { return it.kind == matchItemQ }
	if k == matchKindMQ { return it.kind == matchItemQ && it.n <= 7 }
	if k == matchKindImm { return it.kind == matchItemImm }
	var addr bool = k == matchKindAddr5 || k == matchKindAddr5H || k == matchKindAddr7
	if addr && it.kind == matchItemImm { return !it.known && !it.real }
	if k == matchKindAddr5 { return arm32MatchMemIn(it, 4, 1020) }
	if k == matchKindAddr5H { return arm32MatchMemIn(it, 2, 510) }
	if k == matchKindAddr7 { return it.n != arm32.PC && arm32MatchMemIn(it, 4, 508) }
	if k == matchKindMemPlain {
		return it.kind == matchItemMem && it.plain && it.n >= 0 && it.n != arm32.PC
	}
	if k == matchKindBang { return it.kind == matchItemBang }
	if k >= matchKindSysFpscr && k <= matchKindSysP0 {
		return it.kind == matchItemSys && it.n == k - matchKindSysFpscr + matchSysFpscr
	}
	if k == matchKindCore { return it.kind == matchItemCore }
	if k == matchKindCoreNoPC { return it.kind == matchItemCore && it.n != arm32.PC }
	if k == matchKindDScalar16 { return it.kind == matchItemD && it.n <= 7 }
	if k == matchKindDScalar32 { return it.kind == matchItemD && it.n <= 15 }
	// clang keeps a lane's low 32 bits (d2[4294967299] is lane 3).
	if k == matchKindLane16 { return it.kind == matchItemLane && cast(uint32, it.val) < 4 }
	if k == matchKindLane32 { return it.kind == matchItemLane && cast(uint32, it.val) < 2 }
	if k == matchKindLane8 { return it.kind == matchItemLane && cast(uint32, it.val) < 8 }
	if k == matchKindLane0to15 { return it.kind == matchItemLane && cast(uint32, it.val) < 16 }
	if k == matchKindLanePair2 {
		return it.kind == matchItemLane && (cast(uint32, it.val) == 2 || cast(uint32, it.val) == 3)
	}
	if k == matchKindRGPR {
		var sp bool = it.n != arm32.SP || p.Arm32Feats & armV8 != 0
		return it.kind == matchItemCore && it.n != arm32.PC && sp
	}
	if k == matchKindSList { return it.kind == matchItemList && it.list == matchListS }
	if k == matchKindDList { return it.kind == matchItemList && it.list == matchListD }
	if k == matchKindSListVPR { return it.kind == matchItemList && it.list == matchListSVPR }
	if k == matchKindDListVPR { return it.kind == matchItemList && it.list == matchListDVPR }
	if it.kind != matchItemImm || !it.known { return false }
	if k >= matchKindNSplatI16 && k <= matchKindNMovRep8x64 {
		return !it.sub && arm32NeonImmIs(k, it.val)
	}
	if k == matchKindFPImm { return !it.sub && arm32VmovFPImm8(it.val) >= 0 }
	if k == matchKindImm7s4 { return it.val % 4 == 0 && it.val >= -508 && it.val <= 508 }
	if k >= matchKindShr8 && k <= matchKindShr64 {
		return it.val >= 1 && it.val <= cast(int64, 8 << (k - matchKindShr8))
	}
	if k >= matchKindShl8 && k <= matchKindShl32 {
		return it.val >= 0 && it.val < cast(int64, 8 << (k - matchKindShl8))
	}
	if k >= matchKindShll8 && k <= matchKindShll32 {
		return it.val >= 1 && it.val < cast(int64, 8 << (k - matchKindShll8))
	}
	if k >= matchKindShllMax8 && k <= matchKindShllMax32 {
		return it.val == cast(int64, 8 << (k - matchKindShllMax8))
	}
	if k == matchKindFbits16 { return it.val >= 0 && it.val <= 17 }
	if k == matchKindFbits32 { return it.val >= 1 && it.val <= 33 }
	if k == matchKindMFbits16 { return it.val >= 1 && it.val <= 16 }
	if k == matchKindMFbits32 { return it.val >= 1 && it.val <= 32 }
	return it.val == 0
}

// arm32MatchMemIn reports whether it is a memory operand with a core base register, no alignment
// and an offset that is a known multiple of scale within +/-most (its negative zero too).
func arm32MatchMemIn(it arm32MatchItem, scale int64, most int64) bool {
	if it.kind != matchItemMem || it.index || it.align || !it.known { return false }
	return it.val % scale == 0 && it.val >= -most && it.val <= most
}

// The ways an encoding can be off (arm32MatchMiss.kind): matched outright, by one type or operand,
// by too few operands, by features only, or by more.
const (
	matchMissNone int = iota
	matchMissOperand
	matchMissTooFew
	matchMissFeature
	matchMissFar
)

// arm32MatchMiss is how an encoding matches: kind (matchMiss*); for one type or operand off, its
// place in what was written (a condition first, then types, then operands), the class of what was
// wanted there (a kind clang names, arm32MatchNamed; 0 for a type or another operand, which it does
// not) and whether it was an operand past the last; for features only, the missing ones.
type arm32MatchMiss struct {
	kind     int
	at       int
	class    int
	tooMany  bool
	features int
}

// arm32MatchTry matches encoding c against what was written -- a condition other than AL (cond),
// then the nt types, then the ni operands (items holding the first of them) -- place by place
// against the encoding's own, its condition operand first where it has one.
func arm32MatchTry(p @Parser, c arm32MatchCand, cond int, types @[]int, nt int,
		items @[]arm32MatchItem, ni int) arm32MatchMiss {
	var m arm32MatchMiss
	var lead int = 0
	if cond != arm32.COND_AL { lead = 1 }
	var slot int = 0
	if lead == 1 && arm32MatchHasCond(c) { slot = 1 }
	var ft int = 0
	if c.t1 != 0 { ft = 1 }
	if c.t2 != 0 { ft = 2 }
	var fk int = 0
	for arm32MatchKindAt(c.ops, fk) != 0 { fk = fk + 1 }
	var written int = lead + nt + ni
	var places int = slot + ft + fk
	var problems int = 0
	for i := 0; i < places; i++ {
		if i >= written {
			if problems == 0 { m.kind = matchMissTooFew }
			problems = problems + 1
			break
		}
		var ok bool = i < slot
		var class int = 0
		if i >= slot && i < slot + ft {
			var want int = c.t1
			if i - slot == 1 { want = c.t2 }
			ok = i >= lead && i - lead < nt && arm32MatchTypeIs(types[i - lead], want)
		} else if i >= slot + ft {
			var k int = arm32MatchKindAt(c.ops, i - slot - ft)
			if arm32MatchNamed(k) { class = k }
			var at int = i - lead - nt
			ok = at >= 0 && at < len(items) && arm32MatchItemIs(p, k, items[at])
		}
		if !ok {
			problems = problems + 1
			if problems > 1 { break }
			m.kind = matchMissOperand
			m.at = i
			m.class = class
		}
	}
	// Each operand past the last is one more mismatch (clang matches it against no operand).
	if problems <= 1 && written > places {
		if problems == 0 {
			m.kind = matchMissOperand
			m.at = places
			m.tooMany = true
		}
		problems = problems + written - places
	}
	var missing int = arm32MatchMissing(p, c.need)
	if problems > 1 || (problems == 1 && missing != 0) {
		m.kind = matchMissFar
	} else if problems == 0 && missing != 0 {
		m.kind = matchMissFeature
		m.features = missing
	}
	return m
}

// arm32MatchNamed reports whether clang names operand kind k (matchKind*) when another is written
// in its place, as a register class, a list of them or the range of NEON's right shift's or
// VSHLL's amount; it reports any other kind as an invalid operand, which counts once at one place.
func arm32MatchNamed(k int) bool {
	return k <= matchKindQ || k == matchKindMQ || k == matchKindCore || k == matchKindCoreNoPC ||
			k == matchKindSList || k == matchKindDList || k == matchKindRGPR || k == matchKindDScalar16 ||
			k == matchKindDScalar32 || (k >= matchKindShr8 && k <= matchKindShr64) ||
			(k >= matchKindShll8 && k <= matchKindShllMax32)
}

// arm32MatchOperandMessage returns clang's message for an operand of class (arm32MatchMiss.class)
// wanted where another was written, or for one past the last (tooMany).
func arm32MatchOperandMessage(p @Parser, class int, tooMany bool) *[]readonly char {
	if class == matchKindS { return "operand must be a register in range [s0, s31]" }
	if class == matchKindD { return arm32VfpRange(p, 64) }
	if class == matchKindQ { return "operand must be a register in range [q0, q15]" }
	if class == matchKindMQ { return "operand must be a register in range [q0, q7]" }
	if class == matchKindCore { return "operand must be a register in range [r0, r15]" }
	if class == matchKindCoreNoPC { return "operand must be a register in range [r0, r14]" }
	if class == matchKindShr8 { return "operand must be an immediate in the range [1,8]" }
	if class == matchKindShr16 { return "operand must be an immediate in the range [1,16]" }
	if class == matchKindShr32 { return "operand must be an immediate in the range [1,32]" }
	if class == matchKindShr64 { return "operand must be an immediate in the range [1,64]" }
	if class >= matchKindShll8 && class <= matchKindShllMax32 {
		var messages @[]*[]readonly char = @[]*[]readonly char{
				"operand must be an immediate in the range [1,7]",
				"operand must be an immediate in the range [1,15]",
				"operand must be an immediate in the range [1,31]",
				"operand must be an immediate in the range [8,8]",
				"operand must be an immediate in the range [16,16]",
				"operand must be an immediate in the range [32,32]"}
		return messages[class - matchKindShll8]
	}
	if class == matchKindDScalar16 { return "operand must be a register in range [d0, d7]" }
	if class == matchKindDScalar32 { return "operand must be a register in range [d0, d15]" }
	if class == matchKindRGPR {
		if p.Arm32Feats & armV8 != 0 { return "operand must be a register in range [r0, r14]" }
		return "operand must be a register in range [r0, r12] or r14"
	}
	if class == matchKindSList { return "operand must be a list of registers in range [s0, s31]" }
	if class == matchKindDList {
		if p.Arm32FP & armFpD32 != 0 { return "operand must be a list of registers in range [d0, d31]" }
		return "operand must be a list of registers in range [d0, d15]"
	}
	if tooMany { return "too many operands for instruction" }
	return "invalid operand for instruction"
}

// arm32MatchReport sets clang's error for the n encodings' matches misses, taken last first as
// clang takes them: an operand at a place already reported with the same class (or, wanting a
// type or number, the same) is dropped, as are a set of missing features already reported and a
// second "too few operands".
func arm32MatchReport(p @Parser, misses @[]arm32MatchMiss, n int) {
	var count int = 0
	var message @[]char = ""
	var seenAt @[]int = make_slice(int, n)
	var seenClass @[]int = make_slice(int, n)
	var seenFeatures @[]int = make_slice(int, n)
	var operands int = 0
	var features int = 0
	var tooFew bool = false
	for i := n - 1; i >= 0; i-- {
		var m arm32MatchMiss = misses[i]
		var text @[]char = ""
		if m.kind == matchMissOperand {
			var dup bool = false
			for j := 0; j < operands; j++ {
				if seenAt[j] == m.at && seenClass[j] == m.class { dup = true }
			}
			if dup { continue }
			seenAt[operands] = m.at
			seenClass[operands] = m.class
			operands = operands + 1
			text = buf.CopyStr(arm32MatchOperandMessage(p, m.class, m.tooMany))
		} else if m.kind == matchMissFeature {
			var dup bool = false
			for j := 0; j < features; j++ {
				if seenFeatures[j] == m.features { dup = true }
			}
			if dup { continue }
			seenFeatures[features] = m.features
			features = features + 1
			text = arm32MatchFeatureNames(m.features)
		} else if m.kind == matchMissTooFew {
			if tooFew { continue }
			tooFew = true
			text = buf.CopyStr("too few operands for instruction")
		} else {
			continue
		}
		count = count + 1
		message = text
	}
	if count == 0 {
		setErr(p, "invalid instruction")
	} else if count == 1 {
		setErr(p, message)
	} else {
		setErr(p, "invalid instruction, any one of the following would fix this:")
	}
}

// arm32MatchRun matches what was written -- a condition other than AL (cond), nt data types (types
// holding the first of them) and ni operands (items holding the first of them) -- against list's
// encodings in turn, returning the first that matches; else -1, with the near misses' error set
// (MVE's encodings never match, their features never in effect here).
func arm32MatchRun(p @Parser, list @arm32MatchList, cond int, types @[]int, nt int,
		items @[]arm32MatchItem, ni int) int {
	var misses @[]arm32MatchMiss = make_slice(arm32MatchMiss, list.n)
	for i := 0; i < list.n; i++ {
		misses[i] = arm32MatchTry(p, list.c[i], cond, types, nt, items, ni)
		if misses[i].kind != matchMissNone { continue }
		return i
	}
	arm32MatchReport(p, misses, list.n)
	return -1
}
