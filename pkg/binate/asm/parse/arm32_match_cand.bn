package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// The encodings clang matches an instruction's types and operands against (arm32_match.bn): each
// with its data types, its operands' kinds and the features it needs, NEON's and MVE's as well as
// the VFP's -- they decide what clang reports when none matches, and a form NEON's matches is
// reported as not supported.

// The features an encoding needs (arm32MatchCand.need), in the order clang names missing ones (its
// predicates' names, alphabetical).  M-profile's (MVE, ARMv8.1-M's FP system registers, the ARMv8-M
// Security Extensions) are never in effect here, but clang offers their encodings in ARM code too,
// as "instruction requires: mve.fp" and the like.
const (
	matchNeedSec8M int = 1     // "ARMv8-M Security Extensions"
	matchNeedBF16 int = 2      // "BFloat16 floating point extension"
	matchNeedDP int = 4        // "double precision VFP"
	matchNeedHalf int = 8      // "half-float conversions"
	matchNeedV8FP int = 16     // "FPARMv8"
	matchNeedFPRegs int = 32   // "fp registers"
	matchNeedFPRegs16 int = 64 // "16-bit fp registers"
	matchNeedFull16 int = 128  // "full half-float"
	matchNeedMVEFP int = 256   // "mve.fp"
	matchNeedMVE int = 512     // "mve"
	matchNeedNEON int = 1024   // "NEON"
	matchNeedV8 int = 2048     // "armv8"
	matchNeedV8_1M int = 4096  // "armv8.1m.main"
	matchNeedV8_3 int = 8192   // "armv8.3a"
	matchNeedVFP2 int = 16384  // "VFP2"
)

// The kinds of an encoding's operands (arm32MatchCand.ops): an S, D or Q register; a fixed-point
// VCVT's fraction bits for 16 or 32 bits as clang bounds them (0 .. 17, 1 .. 33); any immediate;
// the number 0 (NEON's VCVT with no fraction bits); an MVE Q register (Q0 .. Q7); MVE's fraction
// bits for 16 or 32 bits (1 .. 16, 1 .. 32); VLDR's address -- [Rn, #imm] with imm a multiple of
// 4 within +/-1020, or a label -- and VLDR.16's ([Rn, #imm] with imm even within +/-510, or a
// label); M-profile's VLDR address ([Rn, #imm], Rn not PC, imm a multiple of 4 within +/-508, or
// a label), a plain [Rn] (Rn not PC), and its post-index (a multiple of 4 within +/-508); a `!`;
// and the system registers M-profile's VLDR names (in matchSys* order).
const (
	matchKindS int = iota + 1
	matchKindD
	matchKindQ
	matchKindFbits16
	matchKindFbits32
	matchKindImm
	matchKindZero
	matchKindMQ
	matchKindMFbits16
	matchKindMFbits32
	matchKindAddr5
	matchKindAddr5H
	matchKindAddr7
	matchKindMemPlain
	matchKindImm7s4
	matchKindBang
	matchKindSysFpscr
	matchKindSysFpscrNzcvqc
	matchKindSysFpcxtns
	matchKindSysFpcxts
	matchKindSysVpr
	matchKindSysP0
)

// The kinds of encoding (arm32MatchCand.form): the VFP's, assembled here, with a condition operand
// or (VCVTA .. VCVTM, VRINTA .. VRINTM, VSEL, VMAXNM / VMINNM) without one; NEON's with one, and
// without one (VRINT*, VCVTA .. VCVTM, VMAXNM / VMINNM); MVE's, which have none either, but a
// predicate operand of their own that clang counts in ordering them.  clang matches a written
// condition, other than AL, against an encoding's condition operand, and against its first type or
// operand where it has none.
const (
	matchFormVFP int = iota
	matchFormVFPNoCond
	matchFormNEON
	matchFormNEONNoCond
	matchFormMVE
)

// arm32MatchCand is one encoding of an instruction: its data types (matchType*, 0 for none), its
// operands' kinds (matchKind*, five bits each from the first, 0 past the last), the features it
// needs (matchNeed*), and its kind (matchForm*).
type arm32MatchCand struct {
	t1   int
	t2   int
	ops  int
	need int
	form int
}

// arm32MatchList collects an instruction's encodings in the order clang tries them.
type arm32MatchList struct {
	c @[]arm32MatchCand
	n int
}

// matchOps packs operand kinds a, b and c (0 for none) as arm32MatchCand.ops does.
func matchOps(a int, b int, c int) int { return a | (b << 5) | (c << 10) }

// matchAdd appends an encoding to list.
func matchAdd(list @arm32MatchList, t1 int, t2 int, ops int, need int, form int) {
	var c arm32MatchCand
	c.t1 = t1
	c.t2 = t2
	c.ops = ops
	c.need = need
	c.form = form
	list.c[list.n] = c
	list.n = list.n + 1
}

// matchAddPairs appends, for each data-type pair in pairs (two entries each), an encoding on the
// operand kinds ops with the features need.
func matchAddPairs(list @arm32MatchList, pairs @[]int, ops int, need int, form int) {
	for i := 0; i + 1 < len(pairs); i = i + 2 {
		matchAdd(list, pairs[i], pairs[i + 1], ops, need, form)
	}
}

// arm32MatchSort orders list's encodings as clang tries them: by length (arm32MatchLength),
// fewest first, those of one length in the order they were added.
func arm32MatchSort(list @arm32MatchList) {
	for i := 1; i < list.n; i++ {
		var c arm32MatchCand = list.c[i]
		var j int = i
		for j > 0 && arm32MatchLength(list.c[j - 1]) > arm32MatchLength(c) {
			list.c[j] = list.c[j - 1]
			j = j - 1
		}
		list.c[j] = c
	}
}

// arm32MatchHasCond reports whether encoding c has a condition operand (matchForm*).
func arm32MatchHasCond(c arm32MatchCand) bool {
	return c.form == matchFormVFP || c.form == matchFormNEON
}

// arm32MatchIsVFP reports whether encoding c is the VFP's, which this assembler assembles.
func arm32MatchIsVFP(c arm32MatchCand) bool {
	return c.form == matchFormVFP || c.form == matchFormVFPNoCond
}

// arm32MatchLength returns how many types and operands encoding c has, its condition operand and an
// MVE one's predicate operand counted, by which clang orders encodings.
func arm32MatchLength(c arm32MatchCand) int {
	var n int = 0
	if arm32MatchHasCond(c) || c.form == matchFormMVE { n = 1 }
	if c.t1 != 0 { n = n + 1 }
	if c.t2 != 0 { n = n + 1 }
	var k int = 0
	for arm32MatchKindAt(c.ops, k) != 0 { k = k + 1 }
	return n + k
}

// arm32MatchMissing returns the features need (matchNeed*) asks for that are not in effect.
func arm32MatchMissing(p @Parser, need int) int {
	var fp uint64 = p.Arm32FP
	var have int = 0
	if fp & armFpBF16 != 0 { have = have | matchNeedBF16 }
	if fp & armFpRegs != 0 { have = have | matchNeedFPRegs }
	if fp & armFpRegs16 != 0 { have = have | matchNeedFPRegs16 }
	if fp & armFpDP != 0 { have = have | matchNeedDP }
	if fp & armFpHalf != 0 { have = have | matchNeedHalf }
	if fp & armFpV8D16SP != 0 { have = have | matchNeedV8FP }
	if fp & armFpFullFP16 != 0 { have = have | matchNeedFull16 }
	if fp & armFpNEON != 0 { have = have | matchNeedNEON }
	if p.Arm32Feats & armV8 != 0 { have = have | matchNeedV8 }
	if p.Arm32Feats & armV8_3 != 0 { have = have | matchNeedV8_3 }
	if fp & armFpVFP2SP != 0 { have = have | matchNeedVFP2 }
	return need & ~have
}

// arm32MatchFeatureNames returns clang's "instruction requires:" message for the missing features
// missing (matchNeed*), named in clang's order.
func arm32MatchFeatureNames(missing int) @[]char {
	var names @[]*[]readonly char = @[]*[]readonly char{"ARMv8-M Security Extensions",
			"BFloat16 floating point extension", "double precision VFP", "half-float conversions", "FPARMv8",
			"fp registers", "16-bit fp registers", "full half-float", "mve.fp", "mve", "NEON", "armv8",
			"armv8.1m.main", "armv8.3a", "VFP2"}
	var out @[]char = buf.CopyStr("instruction requires:")
	for i := 0; i < len(names); i++ {
		if missing & (1 << i) != 0 { out = buf.Concat(buf.Concat(out, " "), names[i]) }
	}
	return out
}
