package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// The encodings clang matches an instruction's types and operands against (arm32_match.bn): each
// with its data types, its operands' kinds and the features it needs, NEON's and MVE's as well as
// the VFP's -- they decide what clang reports when none matches, and a form NEON's matches is
// reported as not supported.

// The features an encoding needs (arm32MatchCand.need), in the order clang names missing ones (its
// predicates' names, alphabetical).  M-profile's (MVE, ARMv8.1-M's FP system registers, the ARMv8-M
// Security Extensions, ARMv8-M's mainline, ARMv8.1-M's FP registers) are never in effect here, but
// clang offers their encodings in ARM code too, as "instruction requires: mve.fp" and the like.
const (
	matchNeedSec8M int = 1          // "ARMv8-M Security Extensions"
	matchNeedAES int = 2            // "aes"
	matchNeedBF16 int = 4           // "BFloat16 floating point extension"
	matchNeedDP int = 8             // "double precision VFP"
	matchNeedDotProd int = 16       // "dotprod"
	matchNeedHalf int = 32          // "half-float conversions"
	matchNeedFP16FML int = 64       // "full half-float fml"
	matchNeedV8FP int = 128         // "FPARMv8"
	matchNeedFPRegs int = 256       // "fp registers"
	matchNeedFPRegs16 int = 512     // "16-bit fp registers"
	matchNeedFPRegs64 int = 1024    // "64-bit fp registers"
	matchNeedFPRegsV8_1M int = 2048 // "armv8.1m.main with FP or MVE"
	matchNeedFull16 int = 4096      // "full half-float"
	matchNeedMVEFP int = 8192       // "mve.fp"
	matchNeedMVE int = 16384        // "mve"
	matchNeedNEON int = 32768       // "NEON"
	matchNeedSHA2 int = 65536       // "sha2"
	matchNeedV8 int = 131072        // "armv8"
	matchNeedV8M int = 262144       // "armv8m.main"
	matchNeedV8_1M int = 524288     // "armv8.1m.main"
	matchNeedV8_1 int = 1048576     // "armv8.1a"
	matchNeedV8_3 int = 2097152     // "armv8.3a"
	matchNeedVFP2 int = 4194304     // "VFP2"
	matchNeedVFP3 int = 8388608     // "VFP3"
	matchNeedVFP4 int = 16777216    // "VFP4"
)

// The kinds of an encoding's operands (arm32MatchCand.ops): an S, D or Q register; a fixed-point
// VCVT's fraction bits for 16 or 32 bits as clang bounds them (0 .. 17, 1 .. 33); any immediate;
// the number 0 (VFP's VCMP with 0, NEON's VCVT with no fraction bits and its comparisons with 0);
// an MVE Q register (Q0 .. Q7); MVE's fraction bits for 16 or 32 bits (1 .. 16, 1 .. 32); VLDR's
// address -- [Rn, #imm] with imm a multiple of 4 within +/-1020, or a label -- and VLDR.16's ([Rn,
// #imm] with imm even within +/-510, or a label); M-profile's VLDR address ([Rn, #imm], Rn not PC,
// imm a multiple of 4 within +/-508, or a label), a plain [Rn] (Rn not PC), and its post-index (a
// multiple of 4 within +/-508); a `!`; the system registers M-profile's VLDR names (in matchSys*
// order); a core register (R0..R15, or R0..R14); a list of S or D registers, and one with VPR after
// them (or VPR alone, an S list's); MVE's core register (rGPR: R0..R12 and R14, and R13 too from
// ARMv8); NEON's scalar register for 16-bit and for 32-bit elements (D0..D7, D0..D15; S0..S15 for
// VFMAL's and VFMSL's by an S register) and its lane (0..3, 0..1); a right shift's amount for 8- ..
// 64-bit elements (1..8 .. 1..64), MVE's left shift's for 8- .. 32-bit ones (0..7 .. 0..31), and
// VSHLL's for 8- .. 32-bit ones (1..7 .. 1..31, and the element size, 8 .. 32, alone); NEON's
// modified immediates as clang's operand classes take them (arm32NeonImmIs); a floating-point
// immediate an 8-bit one encodes (as its single-precision bits); a lane of an 8-bit element (0..7),
// of an MVE Q register's 8-bit one (0..15), the second of MVE's lane pairs (2..3), and lane 0 alone
// (VCMLA.F32's by a scalar); an immediate 0..1, 0..3, 0..7 or 0..15 (VEXT's index); a complex
// rotation, 0, 90, 180 or 270 (VCMLA's) or 90 or 270 (VCADD's); a vector list of one to four D
// registers one after another, no lane (a D register alone the list of one, a Q register the list
// of two).
const (
	matchKindS int = iota + 1
	matchKindD
	matchKindQ
	matchKindFbits16
	matchKindFbits32
	matchKindImm
	matchKindZero
	matchKindMQ
	matchKindMFbits16
	matchKindMFbits32
	matchKindAddr5
	matchKindAddr5H
	matchKindAddr7
	matchKindMemPlain
	matchKindImm7s4
	matchKindBang
	matchKindSysFpscr
	matchKindSysFpscrNzcvqc
	matchKindSysFpcxtns
	matchKindSysFpcxts
	matchKindSysVpr
	matchKindSysP0
	matchKindCore
	matchKindCoreNoPC
	matchKindSList
	matchKindDList
	matchKindSListVPR
	matchKindDListVPR
	matchKindRGPR
	matchKindDScalar16
	matchKindDScalar32
	matchKindSScalar
	matchKindLane16
	matchKindLane32
	matchKindShr8
	matchKindShr16
	matchKindShr32
	matchKindShr64
	matchKindShl8
	matchKindShl16
	matchKindShl32
	matchKindShll8
	matchKindShll16
	matchKindShll32
	matchKindShllMax8
	matchKindShllMax16
	matchKindShllMax32
	matchKindNSplatI16
	matchKindNSplatI32
	matchKindNSplatNotI16
	matchKindNSplatNotI32
	matchKindNVmovI32
	matchKindNVmovI32Neg
	matchKindNInvRep8x16
	matchKindNInvRep8x32
	matchKindNInvRep8x64
	matchKindNMovRep16x32
	matchKindNMovRep16x64
	matchKindNMovRep32x64
	matchKindNSplatI8
	matchKindNSplatI64
	matchKindNMovRep8x16
	matchKindNMovRep8x32
	matchKindNMovRep8x64
	matchKindFPImm
	matchKindLane8
	matchKindLane0to15
	matchKindLanePair2
	matchKindLane64
	matchKindImm0_1
	matchKindImm0_3
	matchKindImm0_7
	matchKindImm0_15
	matchKindRotEven
	matchKindRotOdd
	matchKindVecOneD
	matchKindVecDPair
	matchKindVecThreeD
	matchKindVecFourD
)

// The kinds of the vector lists of NEON's element and structure loads and stores
// (arm32NeonLdStItemIs), three families each a run of kinds from its first (arm32NeonLdStListKind):
// two to four D registers every other one, no lane (the count less 2 on from the first); of all
// lanes, one to four D registers one after another (the count less 1), then two to four every other
// one (4 more than the count less 2); of one lane, one to four D registers one after another of 8-,
// 16- or 32-bit elements (three kinds a count, the sizes in turn), then two to four every other one
// of 16- or 32-bit elements (12 on, two kinds a count).
const (
	matchKindVecSpaced int = matchKindVecFourD + 1
	matchKindVecAll int = matchKindVecSpaced + 3
	matchKindVecLane int = matchKindVecAll + 7
)

// The kinds of the addresses of NEON's element and structure loads and stores
// (arm32NeonLdStItemIs): [Rn] (any core register) with no alignment, or one of 16, 32 or 64 bits,
// 64 or 128, or 64, 128 or 256 (clang's AlignedMemory and DupAlignedMemory classes, which differ
// only in name).
const (
	matchKindAlignNone int = iota + matchKindVecLane + 18
	matchKindAlign16
	matchKindAlign32
	matchKindAlign64
	matchKindAlign64or128
	matchKindAlign64or128or256
)

// The kinds of encoding (arm32MatchCand.form): the VFP's, with a condition operand or (VCVTA ..
// VCVTM, VRINTA .. VRINTM, VSEL, VMAXNM / VMINNM) without one; MVE's, which have none either, but
// a predicate operand of their own that clang counts in ordering them, and whose features are
// never in effect here (they are near misses only), and MVE's with a condition operand (its moves
// between a core register and a lane); and NEON's, with a condition operand, which
// clang drops (an error here, arm32NeonUnconditional), and without one (VRINT*, VCVTA .. VCVTM,
// VMAXNM / VMINNM, VMULL.P64).  clang matches a written condition, other than AL, against an
// encoding's condition operand, and against its first type or operand where it has none.
const (
	matchFormVFP int = iota
	matchFormVFPNoCond
	matchFormMVE
	matchFormMVECond
	matchFormSIMD
	matchFormSIMDNoCond
)

// arm32MatchCand is one encoding of an instruction: its data types (matchType*, 0 for none), its
// operands' kinds (matchKind*, seven bits each from the first, 0 past the last), the features it
// needs (matchNeed*), its kind (matchForm*), and what it is to an instruction that tags its
// encodings to tell them apart (tag; 0 for none).
type arm32MatchCand struct {
	t1   int
	t2   int
	ops  int64
	need int
	form int
	tag  int
}

// arm32MatchList collects an instruction's encodings in the order clang tries them.
type arm32MatchList struct {
	c @[]arm32MatchCand
	n int
}

// matchOps packs operand kinds a, b and c (0 for none) as arm32MatchCand.ops does.
func matchOps(a int, b int, c int) int64 {
	return cast(int64, a) | (cast(int64, b) << 7) | (cast(int64, c) << 14)
}

// matchOps4 packs operand kinds a, b, c and d as arm32MatchCand.ops does.
func matchOps4(a int, b int, c int, d int) int64 {
	return matchOps(a, b, c) | (cast(int64, d) << 21)
}

// matchOps6 packs operand kinds a .. f as arm32MatchCand.ops does.
func matchOps6(a int, b int, c int, d int, e int, f int) int64 {
	return matchOps4(a, b, c, d) | (cast(int64, e) << 28) | (cast(int64, f) << 35)
}

// matchAdd appends an encoding to list.
func matchAdd(list @arm32MatchList, t1 int, t2 int, ops int64, need int, form int) {
	var c arm32MatchCand
	c.t1 = t1
	c.t2 = t2
	c.ops = ops
	c.need = need
	c.form = form
	list.c[list.n] = c
	list.n = list.n + 1
}

// matchAddPairs appends, for each data-type pair in pairs (two entries each), an encoding on the
// operand kinds ops with the features need.
func matchAddPairs(list @arm32MatchList, pairs @[]int, ops int64, need int, form int) {
	for i := 0; i + 1 < len(pairs); i = i + 2 {
		matchAdd(list, pairs[i], pairs[i + 1], ops, need, form)
	}
}

// arm32MatchSort orders list's encodings as clang tries them: by length (arm32MatchLength),
// fewest first, those of one length in the order they were added.
func arm32MatchSort(list @arm32MatchList) {
	for i := 1; i < list.n; i++ {
		var c arm32MatchCand = list.c[i]
		var j int = i
		for j > 0 && arm32MatchLength(list.c[j - 1]) > arm32MatchLength(c) {
			list.c[j] = list.c[j - 1]
			j = j - 1
		}
		list.c[j] = c
	}
}

// arm32MatchHasCond reports whether encoding c has a condition operand (matchForm*).
func arm32MatchHasCond(c arm32MatchCand) bool {
	return c.form == matchFormVFP || c.form == matchFormSIMD || c.form == matchFormMVECond
}

// arm32MatchLength returns how many types and operands encoding c has, its condition operand and an
// MVE one's predicate operand counted, by which clang orders encodings.
func arm32MatchLength(c arm32MatchCand) int {
	var n int = 0
	if arm32MatchHasCond(c) || c.form == matchFormMVE { n = 1 }
	if c.t1 != 0 { n = n + 1 }
	if c.t2 != 0 { n = n + 1 }
	var k int = 0
	for arm32MatchKindAt(c.ops, k) != 0 { k = k + 1 }
	return n + k
}

// arm32MatchMissing returns the features need (matchNeed*) asks for that are not in effect.
func arm32MatchMissing(p @Parser, need int) int {
	var fp uint64 = p.Arm32FP
	var have int = 0
	if fp & armFpAES != 0 { have = have | matchNeedAES }
	if fp & armFpBF16 != 0 { have = have | matchNeedBF16 }
	if fp & armFpRegs != 0 { have = have | matchNeedFPRegs }
	if fp & armFpRegs16 != 0 { have = have | matchNeedFPRegs16 }
	if fp & armFpRegs64 != 0 { have = have | matchNeedFPRegs64 }
	if fp & armFpDP != 0 { have = have | matchNeedDP }
	if fp & armFpDotProd != 0 { have = have | matchNeedDotProd }
	if fp & armFpHalf != 0 { have = have | matchNeedHalf }
	if fp & armFpFP16FML != 0 { have = have | matchNeedFP16FML }
	if fp & armFpV8D16SP != 0 { have = have | matchNeedV8FP }
	if fp & armFpFullFP16 != 0 { have = have | matchNeedFull16 }
	if fp & armFpNEON != 0 { have = have | matchNeedNEON }
	if fp & armFpSHA2 != 0 { have = have | matchNeedSHA2 }
	if p.Arm32Feats & armV8 != 0 { have = have | matchNeedV8 }
	if p.Arm32Feats & armV8_1 != 0 { have = have | matchNeedV8_1 }
	if p.Arm32Feats & armV8_3 != 0 { have = have | matchNeedV8_3 }
	if fp & armFpVFP2SP != 0 { have = have | matchNeedVFP2 }
	if fp & armFpVFP3D16SP != 0 { have = have | matchNeedVFP3 }
	if fp & armFpVFP4D16SP != 0 { have = have | matchNeedVFP4 }
	return need & ~have
}

// arm32MatchFeatureNames returns clang's "instruction requires:" message for the missing features
// missing (matchNeed*), named in clang's order.
func arm32MatchFeatureNames(missing int) @[]char {
	var names @[]*[]readonly char = @[]*[]readonly char{"ARMv8-M Security Extensions", "aes",
			"BFloat16 floating point extension", "double precision VFP", "dotprod", "half-float conversions",
			"full half-float fml", "FPARMv8", "fp registers", "16-bit fp registers", "64-bit fp registers",
			"armv8.1m.main with FP or MVE", "full half-float", "mve.fp", "mve", "NEON", "sha2", "armv8",
			"armv8m.main", "armv8.1m.main", "armv8.1a", "armv8.3a", "VFP2", "VFP3", "VFP4"}
	var out @[]char = buf.CopyStr("instruction requires:")
	for i := 0; i < len(names); i++ {
		if missing & (1 << i) != 0 { out = buf.Concat(buf.Concat(out, " "), names[i]) }
	}
	return out
}
