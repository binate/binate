package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each instruction's encodings fit their list and come in the order clang tries them, fewest
// types and operands first, counting a condition operand and an MVE predicate operand as LLVM's
// asm strings have them: VCVT.F32.S32 Sd, Sm (with a condition) 5, VRINTA.F32 Sd, Sm (none) 3,
// NEON's VCVT.F32.S32 Dd, Dm (with one) 5, NEON's VRINTZ.F32 Dd, Dm (none) 3, MVE's VRINTZ.F32
// Qd, Qm (its predicate) 4.  arm32MatchReport keeps the message of the encoding with more where two
// are off by an unnamed operand at one place.  VLDR's encodings, the conversions', each fit.
func TestArm32MatchLength() testing.TestResult {
	var c arm32MatchCand
	c.t1 = matchTypeF32
	c.t2 = matchTypeS32
	c.ops = matchOps(matchKindS, matchKindS, 0)
	if arm32MatchLength(c) != 5 { return fail("VCVT.F32.S32 Sd, Sm is not 5 long") }
	c.form = matchFormSIMD
	c.ops = matchOps(matchKindD, matchKindD, 0)
	if arm32MatchLength(c) != 5 { return fail("NEON's VCVT.F32.S32 Dd, Dm is not 5 long") }
	c.t2 = 0
	c.form = matchFormVFPNoCond
	c.ops = matchOps(matchKindS, matchKindS, 0)
	if arm32MatchLength(c) != 3 { return fail("VRINTA.F32 Sd, Sm is not 3 long") }
	c.form = matchFormSIMDNoCond
	if arm32MatchLength(c) != 3 { return fail("NEON's VRINTZ.F32 is not 3 long") }
	c.form = matchFormMVE
	if arm32MatchLength(c) != 4 { return fail("MVE's VRINTZ.F32 is not 4 long") }
	for idx := 0; idx <= cvtNames; idx++ {
		var list @arm32MatchList
		if idx < cvtNames {
			list = arm32CvtCands(idx)
		} else {
			list = arm32VldrCands()
		}
		if list.n == 0 || list.n > len(list.c) { return fail("an instruction's encodings do not fit") }
		for i := 1; i < list.n; i++ {
			if arm32MatchLength(list.c[i]) < arm32MatchLength(list.c[i - 1]) {
				return fail("an instruction's encodings are not fewest first")
			}
		}
	}
	return ""
}

// The encodings with a condition operand are the VFP's and NEON's that have one (VADD.I8 Dd, Dn,
// Dm, 5 long), not those without (VMAXNM.F32 Dd, Dn, Dm, 4 long) or MVE's; the missing features
// are named in clang's order, VFP4 last.
func TestArm32MatchForms() testing.TestResult {
	var c arm32MatchCand
	c.t1 = matchTypeF32
	c.ops = matchOps(matchKindD, matchKindD, matchKindD)
	var forms @[]int = @[]int{matchFormVFP, matchFormVFPNoCond, matchFormMVE, matchFormSIMD,
			matchFormSIMDNoCond}
	var conds @[]bool = @[]bool{true, false, false, true, false}
	for i := 0; i < len(forms); i++ {
		c.form = forms[i]
		if arm32MatchHasCond(c) != conds[i] {
			return fail("a form has a condition operand or not wrongly")
		}
	}
	c.form = matchFormSIMD
	if arm32MatchLength(c) != 5 { return fail("NEON's VADD.I8 Dd, Dn, Dm is not 5 long") }
	c.form = matchFormSIMDNoCond
	if arm32MatchLength(c) != 4 { return fail("NEON's VMAXNM.F32 Dd, Dn, Dm is not 4 long") }
	var names @[]char = arm32MatchFeatureNames(matchNeedVFP4 | matchNeedNEON | matchNeedFull16)
	if !charsEqual(names, "instruction requires: full half-float NEON VFP4") {
		return fail(buf.Concat("the missing features are named wrongly: ", names))
	}
	return ""
}
