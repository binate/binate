package "pkg/binate/asm/parse"

// A register list as clang's operand parser reads one, for an instruction matched against its
// encodings (arm32_match.bn): `{`, registers and ranges of one class, in order, then `}`.

// The classes of register list (arm32MatchItem.list), as clang makes them: core registers (APSR
// among them or not), S or D registers -- consecutive and ascending -- with VPR after them or not,
// or VPR alone (an S list's).
const (
	matchListCore int = iota + 1
	matchListS
	matchListD
	matchListSVPR
	matchListDVPR
)

// The ways a list is read (arm32MatchRegList's mode): as most instructions' lists; as VLLDM's and
// VLSTM's, which take D16..D31 with 16 D registers too; as VSCCLRM's, which also takes D registers
// after S31.
const (
	matchListPlain int = iota
	matchListLazy
	matchListClear
)

// The registers a list names (arm32MatchListReg): none (a name clang reads as no register), a core
// register, APSR, an S, D or Q register, VPR, the pseudo-register ra_auth_code, or another
// register clang knows, which no list holds.
const (
	matchRegNone int = iota
	matchRegCore
	matchRegAPSR
	matchRegS
	matchRegD
	matchRegQ
	matchRegVPR
	matchRegAuth
	matchRegOther
)

// matchRegVPROrder is VPR's place in a list's order, after every S and D register.
const matchRegVPROrder int = 64

// arm32MatchListReg returns the register tok names as clang's register parser reads one in a list
// read in mode (matchList*): its kind (matchReg*) and number -- D16..D31 only with 32 D registers
// or in a lazy or clearing list, Q8..Q15 always, as clang has them.
func arm32MatchListReg(p @Parser, tok Token, mode int) (int, int) {
	if tok.Kind != TOK_IDENT { return matchRegNone, 0 }
	var t @[]char = tok.Text
	if parseArm32Reg(t) >= 0 { return matchRegCore, parseArm32Reg(t) }
	if arm32VfpReg(t, 's') >= 0 { return matchRegS, arm32VfpReg(t, 's') }
	var d int = arm32VfpReg(t, 'd')
	if d >= 0 && (d < 16 || p.Arm32FP & armFpD32 != 0 || mode != matchListPlain) {
		return matchRegD, d
	}
	if d >= 0 { return matchRegNone, 0 }
	var q int = arm32VfpReg(t, 'q')
	if q >= 0 && q <= 15 { return matchRegQ, q }
	if q >= 0 { return matchRegNone, 0 }
	if mnemIs(t, "vpr") { return matchRegVPR, matchRegVPROrder }
	if mnemIs(t, "apsr") { return matchRegAPSR, 15 }
	if mnemIs(t, "ra_auth_code") { return matchRegAuth, 12 }
	if arm32MatchOtherReg(t) { return matchRegOther, 0 }
	return matchRegNone, 0
}

// arm32MatchOtherReg reports whether name, in any case, is a register clang knows that no list
// holds: a status or FP system register, P0, ZR.
func arm32MatchOtherReg(name *[]readonly char) bool {
	return mnemIs(name, "cpsr") || mnemIs(name, "spsr") || mnemIs(name, "apsr_nzcv") ||
			mnemIs(name, "itstate") || mnemIs(name, "fpscr") || mnemIs(name, "fpscr_nzcv") ||
			mnemIs(name, "fpscr_nzcvqc") || mnemIs(name, "fpsid") || mnemIs(name, "fpexc") ||
			mnemIs(name, "fpinst") || mnemIs(name, "fpinst2") || mnemIs(name, "mvfr0") ||
			mnemIs(name, "mvfr1") || mnemIs(name, "mvfr2") || mnemIs(name, "p0") ||
			mnemIs(name, "fpcxtns") || mnemIs(name, "fpcxts") || mnemIs(name, "zr")
}

// arm32MatchListHolds reports whether a list of class cls (matchReg*: core, core with APSR, S, D,
// or VPR's, which holds S, D and VPR) holds a register of kind kind.
func arm32MatchListHolds(cls int, kind int, n int) bool {
	if cls == matchRegCore { return kind == matchRegCore }
	if cls == matchRegAPSR {
		// GPRwithAPSRnosp: R0..R12, LR and APSR.
		return kind == matchRegAPSR || (kind == matchRegCore && n != 13 && n != 15)
	}
	if cls == matchRegVPR { return kind == matchRegS || kind == matchRegD || kind == matchRegVPR }
	return kind == cls
}

// arm32MatchRegList reads a register list as clang does, l the lexer after its `{`, in mode
// (matchList*): a register, then more after commas and ranges after `-`, all of the first one's
// class (a Q register its two D registers; APSR after core registers makes a list with APSR, VPR
// after S or D registers one with VPR, and in a clearing list D16 after S31 one of FP registers),
// an S or D list's consecutive and ascending; and `}`.  It returns the lexer and the token after
// the `}`, the list (arm32MatchItem: list its class, n and count its S or D registers, caret for a
// `^` after it), and whether it was read, setting clang's error if not.
func arm32MatchRegList(p @Parser, l Lexer, mode int) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	it.kind = matchItemList
	var tok Token
	l, tok = LexNext(l)
	kind, num := arm32MatchListReg(p, tok, mode)
	if !arm32MatchListRegOk(p, kind) { return l, tok, it, false }
	if kind == matchRegOther {
		setErr(p, "invalid register in register list")
		return l, tok, it, false
	}
	var first int = num
	if kind == matchRegQ {
		kind = matchRegD
		first = 2 * num
		num = 2 * num + 1
	}
	var front int = kind
	var cls int = kind
	var prev int = num
	var top int = num
	var vpr bool = kind == matchRegVPR
	var adjust int = 0
	l, tok = LexNext(l)
	for tok.Kind == TOK_COMMA || tok.Kind == TOK_MINUS {
		var minus bool = tok.Kind == TOK_MINUS
		l, tok = LexNext(l)
		nk, nn := arm32MatchListReg(p, tok, mode)
		if !arm32MatchListRegOk(p, nk) { return l, tok, it, false }
		var isQ bool = nk == matchRegQ
		if isQ {
			nk = matchRegD
			nn = 2 * nn
			if minus { nn = nn + 1 }
		}
		if minus {
			if nk == kind && nn == num {
				l, tok = LexNext(l)
				continue
			}
			if nk == matchRegOther {
				setErr(p, "invalid register in register list")
				return l, tok, it, false
			}
			if num > nn {
				setErr(p, "bad range in register list")
				return l, tok, it, false
			}
			if nk != kind {
				// clang walks its own register numbering from one class to the other, which may
				// never end; a range is of one class here.
				setErr(p, "invalid register in register list")
				return l, tok, it, false
			}
		} else {
			if cls == matchRegCore && nk == matchRegAPSR { cls = matchRegAPSR }
			if nk == matchRegVPR && (cls == matchRegS || cls == matchRegD || cls == matchRegVPR) {
				cls = matchRegVPR
				vpr = true
				kind = nk
				num = nn
				prev = nn
				l, tok = LexNext(l)
				continue
			}
			var clears bool = mode == matchListClear && kind == matchRegS && num == 31
			if clears && nk == matchRegD && nn == 16 {
				adjust = 16
				cls = matchRegVPR
			}
			if !arm32MatchListHolds(cls, nk, nn) {
				setErr(p, "invalid register in register list")
				return l, tok, it, false
			}
			if !arm32MatchListNext(p, cls, nk, nn + adjust, prev) { return l, tok, it, false }
		}
		kind = nk
		num = nn
		prev = nn + adjust
		if isQ && !minus {
			num = nn + 1
			prev = nn + 1
		}
		if (kind == matchRegS || kind == matchRegD) && prev > top { top = prev }
		l, tok = LexNext(l)
	}
	if tok.Kind != TOK_RBRACE {
		setErr(p, "'}' expected")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_CARET {
		it.caret = true
		l, tok = LexNext(l)
	}
	it.list = matchListCore
	if front == matchRegD { it.list = matchListD }
	if front == matchRegS { it.list = matchListS }
	if vpr && front == matchRegD { it.list = matchListDVPR }
	if vpr && front != matchRegD { it.list = matchListSVPR }
	it.n = first
	it.count = top - first + 1
	return l, tok, it, true
}

// arm32MatchListRegOk reports whether kind (matchReg*) is a register a list may name, setting
// clang's error if not: "register expected" for none, "pseudo-register not allowed" for
// ra_auth_code.
func arm32MatchListRegOk(p @Parser, kind int) bool {
	if kind == matchRegNone {
		setErr(p, "register expected")
		return false
	}
	if kind == matchRegAuth {
		setErr(p, "pseudo-register not allowed")
		return false
	}
	return true
}

// arm32MatchListNext reports whether a register of kind kind at place at in the order may follow
// one at prev in a list of class cls, setting clang's error if not: a core register may come out
// of order (clang warns), an S or D register must come right after the one before.
func arm32MatchListNext(p @Parser, cls int, kind int, at int, prev int) bool {
	var fp bool = cls != matchRegCore && cls != matchRegAPSR
	if at < prev && kind != matchRegCore && kind != matchRegAPSR {
		setErr(p, "register list not in ascending order")
		return false
	}
	if fp && at != prev + 1 {
		setErr(p, "non-contiguous register range")
		return false
	}
	return true
}
