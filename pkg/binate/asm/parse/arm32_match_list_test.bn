package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// A register list as clang reads one: Q registers as D pairs, ranges (chained, a register to
// itself, from or to a Q register), any case, D16..D31 only with 32 D registers but Q8..Q15 always.
func TestParseArm32MatchRegList() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vldm r0, {q0-q1}", "EC900B08")
	e = armGateIs(e, "", "vldm r0, {q0, d2}", "EC900B06")
	e = armGateIs(e, "", "vpush {q4-q7}", "ED2D8B10")
	e = armGateIs(e, "", "vldm r0, {q0, q1}", "EC900B08")
	e = armGateIs(e, "", "vldm r0, {q15}", "ECD0EB04")
	e = armGateIs(e, "", "vldm r0, {d0-q1}", "EC900B08")
	e = armGateIs(e, "", "vldm r0, {q0-d3}", "EC900B08")
	e = armGateIs(e, "", "vldm r0, {D0-D1}", "EC900B04")
	e = armGateIs(e, "", "vldm r0, {d0-d1, d2-d3}", "EC900B08")
	e = armGateIs(e, "", "vldm r0, {d0, d1-d3}", "EC900B08")
	e = armGateIs(e, "", "vldm r0, {s0-s0}", "EC900A01")
	e = armGateIs(e, "", "vldm r0, {d1-d1, d2}", "EC901B04")
	e = armGateIs(e, "", "vldm r0, {s0-s1-s2}", "EC900A03")
	e = armGateIs(e, "", "vldm r0, {d15-d16}", "EC90FB04")
	e = armGateIs(e, ".fpu vfpv2", "vldm r0, {q8}", "ECD00B04")
	return e
}

// clang's messages for a list: no register, an unknown name or a number; no `}`; a register of
// another class, or one clang knows no list holds; a pseudo-register; a range backwards; an S or
// D register out of order or not the next; D16 with 16 D registers, and Q16 or past at all; a
// range to another class (which clang walks through its own register numbering, never ending or
// ending where it may); and lists clang reads that VLDM does not take -- core registers (out of
// order, APSR, SP among them), VPR with S or D registers.
func TestParseArm32MatchRegListRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var invalid *[]readonly char = "invalid register in register list"
	var expected *[]readonly char = "register expected"
	e = armMsgIs(e, "", "vldm r0, {}", expected)
	e = armMsgIs(e, "", "vldm r0, {foo}", expected)
	e = armMsgIs(e, "", "vldm r0, {#1}", expected)
	e = armMsgIs(e, "", "vldm r0, {d0-}", expected)
	e = armMsgIs(e, "", "vldm r0, {d31, d32}", expected)
	e = armMsgIs(e, "", "vldm r0, {q16}", expected)
	e = armMsgIs(e, "", "vldm r0, {d0-q16}", expected)
	e = armMsgIs(e, "", "vpush {q20}", expected)
	e = armMsgIs(e, "", "vldr d0, {q16}", expected)
	e = armMsgIs(e, "", "vldm r0, {d0", "'}' expected")
	e = armMsgIs(e, "", "vldm r0, {d0 d1}", "'}' expected")
	e = armMsgIs(e, "", "vldm r0, {s0, d1}", invalid)
	e = armMsgIs(e, "", "vldm r0, {r0, s0}", invalid)
	e = armMsgIs(e, "", "vldm r0, {s0, r0}", invalid)
	e = armMsgIs(e, "", "vldm r0, {s31, d16}", invalid)
	e = armMsgIs(e, "", "vldm r0, {fpscr}", invalid)
	e = armMsgIs(e, "", "vldm r0, {CPSR}", invalid)
	e = armMsgIs(e, "", "vldm r0, {apsr_nzcv}", invalid)
	e = armMsgIs(e, "", "vldm r0, {zr}", invalid)
	e = armMsgIs(e, "", "vldm r0, {p0}", invalid)
	e = armMsgIs(e, "", "vldm r0, {d0-s1}", invalid)
	e = armMsgIs(e, "", "vldm r0, {ra_auth_code}", "pseudo-register not allowed")
	e = armMsgIs(e, "", "vldm r0, {r0, ra_auth_code}", "pseudo-register not allowed")
	e = armMsgIs(e, "", "vldm r0, {r0-ra_auth_code}", "pseudo-register not allowed")
	e = armMsgIs(e, "", "vldm r0, {d2-d0}", "bad range in register list")
	e = armMsgIs(e, "", "vldm r0, {r2-r0}", "bad range in register list")
	e = armMsgIs(e, "", "vldm r0, {s1, s0}", "register list not in ascending order")
	e = armMsgIs(e, "", "vldm r0, {vpr, s0}", "register list not in ascending order")
	e = armMsgIs(e, "", "vldm r0, {d0, d2}", "non-contiguous register range")
	e = armMsgIs(e, "", "vldm r0, {d0, d0}", "non-contiguous register range")
	e = armMsgIs(e, "", "vldm r0, {d0, q1}", "non-contiguous register range")
	e = armMsgIs(e, "", "vldm r0, {d0-d1, d1}", "non-contiguous register range")
	e = armMsgIs(e, ".fpu vfpv2", "vldm r0, {d16}", expected)
	e = armMsgIs(e, ".fpu vfpv2", "vldm r0, {d15-d16}", expected)
	e = armMsgIs(e, ".fpu vfpv2", "vpush {d0, d16}", expected)
	e = armMsgIs(e, "", "vldm r0, {r0}", several)
	e = armMsgIs(e, "", "vldm r0, {r1, r0}", several)
	e = armMsgIs(e, "", "vldm r0, {r0-r2}", several)
	e = armMsgIs(e, "", "vldm r0, {sp}", several)
	e = armMsgIs(e, "", "vldm r0, {lr-pc}", several)
	e = armMsgIs(e, "", "vldm r0, {apsr}", several)
	e = armMsgIs(e, "", "vldm r0, {r0, apsr}", several)
	e = armMsgIs(e, "", "vldm r0, {apsr, r0}", several)
	e = armMsgIs(e, "", "vpush {r0}", several)
	e = armMsgIs(e, "", "vldm r0, {vpr}", several)
	e = armMsgIs(e, "", "vldm r0, {s0, vpr}", several)
	e = armMsgIs(e, "", "vldm r0, {s0, s1, vpr}", several)
	e = armMsgIs(e, "", "vldm r0, {d0, vpr}", several)
	return e
}
