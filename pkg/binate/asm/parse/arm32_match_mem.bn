package "pkg/binate/asm/parse"

// A memory operand and a system register's name as clang's operand parser reads them, for an
// instruction matched against its encodings (arm32_match.bn).

// The system registers M-profile's VLDR / VSTR name (arm32MatchItem.n of a matchItemSys).
const (
	matchSysFpscr int = iota + 1
	matchSysFpscrNzcvqc
	matchSysFpcxtns
	matchSysFpcxts
	matchSysVpr
	matchSysP0
)

// arm32MatchSysReg returns the system register name names (matchSys*), in any case, or 0.
func arm32MatchSysReg(name *[]readonly char) int {
	if mnemIs(name, "fpscr") { return matchSysFpscr }
	if mnemIs(name, "fpscr_nzcvqc") { return matchSysFpscrNzcvqc }
	if mnemIs(name, "fpcxtns") { return matchSysFpcxtns }
	if mnemIs(name, "fpcxts") { return matchSysFpcxts }
	if mnemIs(name, "vpr") { return matchSysVpr }
	if mnemIs(name, "p0") { return matchSysP0 }
	return 0
}

// arm32MatchMem reads a memory operand as clang does, l the lexer after its `[`: a register (a core
// register for an operand an encoding here takes); then `]`; or an alignment, `:` after the
// register or after a comma (arm32MatchAlign), and `]`; or a comma and an offset -- an expression
// after `#` or `$`, or without one when it starts with a number, a character, `(` or a constant's
// name (arm32MemOffsetStart; arm32MatchMemOffset) -- or a register index, `±Rm` perhaps with a
// shift after it (arm32MatchShift), and `]`.  It returns the lexer and the token after the `]`, the
// operand, and whether it was read, setting clang's error if not: "register expected" where a
// register goes, "malformed memory operand" for anything but a comma, `:` or `]` after the base,
// "']' expected" where the `]` goes.
func arm32MatchMem(p @Parser, l Lexer) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	it.kind = matchItemMem
	it.known = true
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || !arm32RegisterName(tok.Text) {
		setErr(p, "register expected")
		return l, tok, it, false
	}
	it.n = parseArm32Reg(tok.Text)
	it.index = it.n < 0
	l, tok = LexNext(l)
	if tok.Kind == TOK_RBRACKET {
		it.plain = true
		l, tok = LexNext(l)
		return l, tok, it, true
	}
	if tok.Kind != TOK_COMMA && tok.Kind != TOK_COLON {
		setErr(p, "malformed memory operand")
		return l, tok, it, false
	}
	if tok.Kind == TOK_COMMA { l, tok = LexNext(l) }
	var ok bool
	var immL Lexer
	var prefixed bool
	immL, prefixed = arm32ImmPrefix(l, tok, true)
	if tok.Kind == TOK_COLON {
		it.align = true
		l, tok, ok = arm32MatchAlign(p, l)
	} else if prefixed || arm32MemOffsetStart(p, tok) {
		l, tok, it, ok = arm32MatchMemOffset(p, l, tok, immL, prefixed, it)
	} else {
		if tok.Kind == TOK_MINUS || tok.Kind == TOK_PLUS { l, tok = LexNext(l) }
		if tok.Kind != TOK_IDENT || !arm32RegisterName(tok.Text) {
			setErr(p, "register expected")
			return l, tok, it, false
		}
		it.index = true
		ok = true
		l, tok = LexNext(l)
		if tok.Kind == TOK_COMMA { l, tok, ok = arm32MatchShift(p, l) }
	}
	if !ok { return l, tok, it, false }
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "']' expected")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	return l, tok, it, true
}

// arm32MatchMemOffset reads a memory operand's immediate offset at tok into it (immL the lexer
// after the `#` or `$` when prefixed): an expression, `#-0` clang's negative zero (sub), and a
// floating-point literal other than zero no number an encoding here takes.  It returns the lexer
// and the token after it, the operand, and whether it was read, setting the error if not.
func arm32MatchMemOffset(p @Parser, l Lexer, tok Token, immL Lexer, prefixed bool,
		it arm32MatchItem) (Lexer, Token, arm32MatchItem, bool) {
	var negative bool = arm32PrefixedMinus(l, tok)
	if prefixed { l, tok = LexNext(immL) }
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	if !r.Ok && !charsEqual(r.Err, "invalid operand for instruction") {
		setErr(p, exprErr(r, "unknown token in expression"))
		return l, tok, it, false
	}
	it.known = r.Ok && !r.FromDiff && !r.Pending && !isSymbolic(r) && !hasNeg(r)
	it.val = r.Val
	it.sub = negative && it.known && r.Val == 0
	if !r.Ok { l, tok = arm32MatchSkipTo(l, tok, TOK_RBRACKET) }
	return l, tok, it, true
}

// arm32MatchAlign reads a memory operand's alignment as clang does, l the lexer after its `:`: a
// constant, 16, 32, 64, 128 or 256 (clang's "constant expression expected" for no number, its
// "alignment specifier must be 16, 32, 64, 128, or 256 bits" for another, a floating-point literal
// other than zero too).  It returns the lexer and the token after it and whether it was read,
// setting the error if not.
func arm32MatchAlign(p @Parser, l Lexer) (Lexer, Token, bool) {
	var tok Token
	l, tok = LexNext(l)
	var dollarReal bool
	_, dollarReal = arm32DollarReal(l, tok)
	if dollarReal {
		// `$` before a floating-point literal: neither a name nor a number to clang's expressions.
		setErr(p, "invalid token in expression")
		return l, tok, false
	}
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	var real bool = !r.Ok && charsEqual(r.Err, "invalid operand for instruction")
	if !r.Ok && !real {
		setErr(p, exprErr(r, "unknown token in expression"))
		return l, tok, false
	}
	if !real && (r.FromDiff || r.Pending || isSymbolic(r) || hasNeg(r)) {
		setErr(p, "constant expression expected")
		return l, tok, false
	}
	var v int64 = r.Val
	if real || (v != 16 && v != 32 && v != 64 && v != 128 && v != 256) {
		setErr(p, "alignment specifier must be 16, 32, 64, 128, or 256 bits")
		return l, tok, false
	}
	return l, tok, true
}

// arm32MatchShift reads the shift after a memory operand's register index as clang does, l the
// lexer after the comma: a shift (arm32MatchShiftMost), then, but for rrx, `#` (or `$`) and a
// constant amount within the shift's range.  It returns the lexer and the token after it and
// whether it was read, setting clang's error if not: "illegal shift operator", "'#' expected",
// "shift amount must be an immediate", "immediate shift value out of range".
func arm32MatchShift(p @Parser, l Lexer) (Lexer, Token, bool) {
	var tok Token
	l, tok = LexNext(l)
	var most int64 = -1
	if tok.Kind == TOK_IDENT { most = arm32MatchShiftMost(tok.Text) }
	if most < 0 {
		setErr(p, "illegal shift operator")
		return l, tok, false
	}
	l, tok = LexNext(l)
	if most == 0 { return l, tok, true }
	immL, prefixed := arm32ImmPrefix(l, tok, true)
	if !prefixed {
		setErr(p, "'#' expected")
		return l, tok, false
	}
	l, tok = LexNext(immL)
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	var real bool = !r.Ok && charsEqual(r.Err, "invalid operand for instruction")
	if !r.Ok && !real {
		setErr(p, exprErr(r, "unknown token in expression"))
		return l, tok, false
	}
	if !real && (r.FromDiff || r.Pending || isSymbolic(r) || hasNeg(r)) {
		setErr(p, "shift amount must be an immediate")
		return l, tok, false
	}
	if real || r.Val < 0 || r.Val > most {
		setErr(p, "immediate shift value out of range")
		return l, tok, false
	}
	return l, tok, true
}

// arm32MatchShiftMost returns the largest amount of the shift name names, as clang reads a memory
// operand's (all in lower or all in upper case): 31 for lsl (asl) and ror, 32 for lsr and asr, 0
// for rrx (which takes none), the largest int64 for uxtw (which clang does not bound), and -1 for
// any other name.
func arm32MatchShiftMost(name *[]readonly char) int64 {
	if charsEqual(name, "lsl") || charsEqual(name, "LSL") || charsEqual(name, "asl") ||
			charsEqual(name, "ASL") || charsEqual(name, "ror") || charsEqual(name, "ROR") {
		return 31
	}
	if charsEqual(name, "lsr") || charsEqual(name, "LSR") || charsEqual(name, "asr") ||
			charsEqual(name, "ASR") {
		return 32
	}
	if charsEqual(name, "rrx") || charsEqual(name, "RRX") { return 0 }
	if charsEqual(name, "uxtw") || charsEqual(name, "UXTW") { return 0x7fffffffffffffff }
	return -1
}

// arm32MatchSkipTo returns the lexer and token at the next token of kind kind (or the end of the
// line) from tok.
func arm32MatchSkipTo(l Lexer, tok Token, kind int) (Lexer, Token) {
	for tok.Kind != TOK_EOF && tok.Kind != kind { l, tok = LexNext(l) }
	return l, tok
}
