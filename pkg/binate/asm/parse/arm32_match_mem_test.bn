package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// A memory operand as clang reads it, with its messages: no register at the base or where an index
// goes ("register expected"; a sign, a number or a label there too), anything but a comma, `:` or
// `]` after the base ("malformed memory operand", VCVT's operand too), no closing bracket ("']'
// expected"), a register index (S1 too), a symbol's offset (a constant defined later is a symbol
// there), a floating-point literal (clang's number, its bit pattern) or a character's value no
// multiple of 4 taking no address VLDR takes.  A constant's name is the offset, as an LDR's is
// (clang reads it as a register: "register expected").
func TestParseArm32MatchMem() testing.TestResult {
	var e @[]char = ""
	var bad *[]readonly char = "invalid operand for instruction"
	var malformed *[]readonly char = "malformed memory operand"
	e = armMsgIs(e, "", "vldr d0, [r16]", "register expected")
	e = armMsgIs(e, "", "vldr s0, [r0, lsl #2]", "register expected")
	e = armMsgIs(e, "", "vldr s0, [r0, -4]", "register expected")
	e = armMsgIs(e, "", "vldr s0, [r0, lbl]\nlbl: nop", "register expected")
	e = armMsgIs(e, "", "vldr s0, [r0", malformed)
	e = armMsgIs(e, "", "vldr s0, [r0 #4]", malformed)
	e = armMsgIs(e, "", "vcvt.s32.f32 s0, [r0", malformed)
	e = armMsgIs(e, "", "vldr d0, [r0, #4", "']' expected")
	e = armMsgIs(e, "", "vldr s0, [r0, r1 #4]", "']' expected")
	e = armMsgIs(e, "", "vldr s0, [r0, r1]", bad)
	e = armMsgIs(e, "", "vldr d0, [r0, s1]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, #x]\nx = 4", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, #1.0]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, 'a']", bad)
	e = armGateIs(e, "", "x = 4\nvldr s0, [r0, #x]", "ED900A01")
	e = armGateIs(e, "", "vldr s0, [r0, #(2+2)]", "ED900A01")
	e = armGateIs(e, "", "K = 8\nvldr s0, [r0, K]", "ED900A02")
	return e
}

// A memory operand's alignment and its index's shift as clang reads them, with its messages: an
// alignment after the base or after the comma, which no VLDR address has, one other than 16 .. 256
// bits (a floating-point literal too) or no number, no `]` after it; a shift in mixed case or of
// another name, one with no `#`, an amount past its shift's range (32 for lsl, a floating-point
// literal) or no number -- and shifts clang reads (lsr #32, asl, uxtw past 32, rrx) on an index
// VLDR does not take.
func TestParseArm32MatchMemShift() testing.TestResult {
	var e @[]char = ""
	var bad *[]readonly char = "invalid operand for instruction"
	var align *[]readonly char = "alignment specifier must be 16, 32, 64, 128, or 256 bits"
	var far *[]readonly char = "immediate shift value out of range"
	var illegal *[]readonly char = "illegal shift operator"
	e = armMsgIs(e, "", "vldr s0, [r0:64]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, :64]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0:63]", align)
	e = armMsgIs(e, "", "vldr s0, [r0:64.0]", align)
	e = armMsgIs(e, "", "vldr s0, [r0:x]", "constant expression expected")
	e = armMsgIs(e, "", "vldr s0, [r0:64", "']' expected")
	e = armMsgIs(e, "", "vldr s0, [r0, r1, Lsl #2]", illegal)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, foo #2]", illegal)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsl]", "'#' expected")
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsl r2]", "'#' expected")
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsl #32]", far)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsl #40]", far)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsl #1.0]", far)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsl #lbl]\nlbl: nop", "shift amount must be an immediate")
	e = armMsgIs(e, "", "vldr s0, [r0, r1, lsr #32]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, asl #31]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, uxtw #99]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, r1, rrx]", bad)
	return e
}

// The system registers M-profile's VLDR / VSTR name, in any case, as clang reads them (clang's
// encodings of them want ARMv8.1-M, never in effect here), with a `!` after one an operand of its
// own; their address is no PC-relative one, but a label.
func TestParseArm32MatchSysReg() testing.TestResult {
	if arm32MatchSysReg("fpscr") != matchSysFpscr || arm32MatchSysReg("FPCXTS") != matchSysFpcxts ||
			arm32MatchSysReg("p0") != matchSysP0 || arm32MatchSysReg("fpexc") != 0 {
		return fail("a system register's name is not as clang reads it")
	}
	var e @[]char = ""
	e = armMsgIs(e, "", "vldr fpscr, [r0, #4]!", "instruction requires: armv8.1m.main")
	e = armMsgIs(e, "", "vldr fpcxts, [r0, #4]!",
			"instruction requires: ARMv8-M Security Extensions armv8.1m.main")
	e = armMsgIs(e, "", "vldr fpscr, [r0]",
			"invalid instruction, any one of the following would fix this:")
	e = armMsgIs(e, "", "vldr fpscr!, [r0]", "invalid instruction")
	e = armMsgIs(e, "", "vldr fpscr, [pc, #4]!", "invalid instruction")
	e = armMsgIs(e, "", "vldr fpscr, [pc], #4", "invalid instruction")
	e = armMsgIs(e, "", "vldr fpscr, #lbl!\nlbl: nop", "instruction requires: armv8.1m.main")
	e = armMsgIs(e, "", "vldr fpcxts, #lbl!\nlbl: nop",
			"instruction requires: ARMv8-M Security Extensions armv8.1m.main")
	e = armMsgIs(e, "", "vldr fpscr, lbl\nlbl: nop",
			"invalid instruction, any one of the following would fix this:")
	if len(e) > 0 { return e }
	return ""
}
