package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// What an instruction matched against its encodings (arm32_match.bn) was written as: its data
// types, read from the mnemonic's `.` suffixes, and its operands, each as clang's operand parser
// reads it.

// The data types of a mnemonic's suffixes (arm32MatchType), 0 for none.
const (
	matchTypeF16 int = iota + 1
	matchTypeF32                // .f32, or clang's .f
	matchTypeF64                // .f64, or clang's .d
	matchTypeS16
	matchTypeU16
	matchTypeS32
	matchTypeU32
	matchTypeBF16
	matchTypeOther              // no type any encoding has
)

// arm32MatchType returns the data type the suffix t (lowercase, no `.`) names (matchType*).
func arm32MatchType(t *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"f16", "f32", "f64", "s16", "u16", "s32",
			"u32", "bf16"}
	for i := 0; i < len(names); i++ {
		if charsEqual(t, names[i]) { return matchTypeF16 + i }
	}
	if charsEqual(t, "f") { return matchTypeF32 }
	if charsEqual(t, "d") { return matchTypeF64 }
	return matchTypeOther
}

// arm32MatchSuffixes reads the data types among the `.` suffixes rest (lowercase, from the first
// `.`) as clang does -- `.w` is none, `.n` its error -- into types (up to three kept), returning
// how many there are and whether there is no `.n`, setting the error if there is.
func arm32MatchSuffixes(p @Parser, rest *[]readonly char, types @[]int) (int, bool) {
	var n int = 0
	var start int = 1
	for i := 1; i <= len(rest); i++ {
		if i < len(rest) && rest[i] != '.' { continue }
		var part *[]readonly char = rest[start:i]
		start = i + 1
		if charsEqual(part, "w") { continue }
		if charsEqual(part, "n") {
			setErr(p, "instruction with .n (narrow) qualifier not allowed in arm mode")
			return 0, false
		}
		if n < len(types) { types[n] = arm32MatchType(part) }
		n = n + 1
	}
	return n, true
}

// The kinds of operand read (arm32MatchItem.kind).
const (
	matchItemS int = iota + 1
	matchItemD
	matchItemQ
	matchItemImm
	matchItemOther
)

// arm32MatchItem is an operand as written: an S, D or Q register (n its number), an expression (val
// its value when known, a number rather than a symbol, a location or a difference of them), or
// anything else; bang for a register or a prefixed immediate with a `!` after it, which clang reads
// as one more operand.
type arm32MatchItem struct {
	kind  int
	n     int
	val   int64
	known bool
	bang  bool
}

// arm32MatchSkip returns the lexer and token at the end of an operand clang reads as no register or
// number this encoding can take: the next comma, or the end of the line.
func arm32MatchSkip(l Lexer, tok Token) (Lexer, Token) {
	for tok.Kind != TOK_EOF && tok.Kind != TOK_COMMA { l, tok = LexNext(l) }
	return l, tok
}

// arm32MatchOperand reads the operand at tok as clang does: an S, D (D16 .. D31 only with 32 D
// registers; clang reads the name as a symbol otherwise) or Q register, another register (either
// with a `!` after it), an expression after `#` or a lone `$` (a `!` after it too), or one with no
// prefix that does not start with a sign or a floating-point literal -- a floating-point zero in
// it is 0, and another floating-point literal makes it no number clang's matcher takes -- or
// another operand clang reads (arm32MatchOtherStart), which no encoding here takes.  It returns the
// lexer and the token after it, the operand, and whether it was read, setting the error if not.
func arm32MatchOperand(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	it.kind = matchItemOther
	if tok.Kind == TOK_IDENT && tok.Text[0] != '$' && arm32RegisterName(tok.Text) {
		var s int = arm32VfpReg(tok.Text, 's')
		var d int = arm32VfpReg(tok.Text, 'd')
		var q int = arm32VfpReg(tok.Text, 'q')
		if s >= 0 {
			it.kind = matchItemS
			it.n = s
		} else if d >= 0 && (d < 16 || p.Arm32FP & armFpD32 != 0) {
			it.kind = matchItemD
			it.n = d
		} else if q >= 0 {
			it.kind = matchItemQ
			it.n = q
		}
		if it.kind != matchItemOther || d < 0 {
			l, tok = LexNext(l)
			if tok.Kind == TOK_BANG {
				it.bang = true
				l, tok = LexNext(l)
			}
			return l, tok, it, true
		}
	}
	if tok.Kind == TOK_FLOAT || arm32SignedStart(tok) {
		setErr(p, "unexpected token in operand")
		return l, tok, it, false
	}
	var expr bool = tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR || tok.Kind == TOK_IDENT ||
			tok.Kind == TOK_INT || tok.Kind == TOK_CHAR || tok.Kind == TOK_LPAREN || tok.Kind == TOK_DOT
	if !expr {
		if !arm32MatchOtherStart(tok) {
			setErr(p, "unexpected token in operand")
			return l, tok, it, false
		}
		if tok.Kind == TOK_COLON || tok.Kind == TOK_STRING { it.kind = matchItemImm }
		l, tok = arm32MatchSkip(l, tok)
		return l, tok, it, true
	}
	var negative bool = arm32PrefixedMinus(l, tok)
	var prefixed bool = tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR
	// A `!` after an immediate with a prefix (`$4` lexes as a name) is an operand of its own.
	var bangOk bool = prefixed || (tok.Kind == TOK_IDENT && tok.Text[0] == '$')
	if prefixed {
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
			setErr(p, "unknown token in expression")
			return l, tok, it, false
		}
		if tok.Kind == TOK_COLON || tok.Kind == TOK_STRING {
			it.kind = matchItemImm
			l, tok = arm32MatchSkip(l, tok)
			return l, tok, it, true
		}
	}
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	it.kind = matchItemImm
	if !r.Ok {
		// A floating-point literal other than zero (Parser.ExprZeroReals) is a number no encoding
		// here takes; any other failure is clang's parse error.
		if !charsEqual(r.Err, "invalid operand for instruction") {
			setErr(p, exprErr(r, "unknown token in expression"))
			return l, tok, it, false
		}
		l, tok = arm32MatchSkip(l, tok)
		return l, tok, it, true
	}
	it.known = !r.FromDiff && !r.Pending && !isSymbolic(r) && !hasNeg(r)
	it.val = r.Val
	if negative && it.known && it.val == 0 { it.val = -2147483648 }
	if bangOk && tok.Kind == TOK_BANG {
		it.bang = true
		l, tok = LexNext(l)
	}
	return l, tok, it, true
}

// arm32MatchOtherStart reports whether tok starts an operand clang reads that no encoding here
// takes: a memory operand, a register list, or an immediate this reader leaves unread -- one with
// a `:lower16:`-style prefix, a quoted symbol name.
func arm32MatchOtherStart(tok Token) bool {
	return tok.Kind == TOK_LBRACKET || tok.Kind == TOK_LBRACE || tok.Kind == TOK_COLON ||
			tok.Kind == TOK_STRING
}

// arm32MatchOperands reads the operands after l, keeping the first six (more are only counted),
// and returns them, how many there are, and whether they were read, setting the error if not.
func arm32MatchOperands(p @Parser, l Lexer) (@[]arm32MatchItem, int, bool) {
	var items @[]arm32MatchItem = make_slice(arm32MatchItem, 6)
	var n int = 0
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF {
		var it arm32MatchItem
		var ok bool
		l, tok, it, ok = arm32MatchOperand(p, l, tok)
		if !ok { return items, n, false }
		if n < len(items) { items[n] = it }
		n = n + 1
		if it.bang {
			if n < len(items) { items[n].kind = matchItemOther }
			n = n + 1
		}
		if tok.Kind == TOK_EOF { break }
		if tok.Kind != TOK_COMMA {
			setErr(p, "unexpected token in argument list")
			return items, n, false
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
			setErr(p, "unexpected token in operand")
			return items, n, false
		}
	}
	return items, n, true
}
