package "pkg/binate/asm/parse"

// What an instruction matched against its encodings (arm32_match.bn) was written as: its data
// types, read from the mnemonic's `.` suffixes, and its operands, each as clang's operand parser
// reads it.

// The data types of a mnemonic's suffixes (arm32MatchType), 0 for none: the floating-point,
// integer and sized types clang's encodings name, and clang's .f and .d read as .f32 and .f64.
const (
	matchTypeF16 int = iota + 1
	matchTypeF32
	matchTypeF64
	matchTypeS16
	matchTypeU16
	matchTypeS32
	matchTypeU32
	matchTypeBF16
	matchTypeS8
	matchTypeU8
	matchTypeS64
	matchTypeU64
	matchTypeI8
	matchTypeI16
	matchTypeI32
	matchTypeI64
	matchTypeP8
	matchTypeP16
	matchType8
	matchType16
	matchType32
	matchType64
	matchTypeOther              // no type any encoding has
)

// arm32MatchType returns the data type the suffix t (lowercase, no `.`) names (matchType*).
func arm32MatchType(t *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"f16", "f32", "f64", "s16", "u16", "s32",
			"u32", "bf16", "s8", "u8", "s64", "u64", "i8", "i16", "i32", "i64", "p8", "p16", "8", "16", "32",
			"64"}
	for i := 0; i < len(names); i++ {
		if charsEqual(t, names[i]) { return matchTypeF16 + i }
	}
	if charsEqual(t, "f") { return matchTypeF32 }
	if charsEqual(t, "d") { return matchTypeF64 }
	return matchTypeOther
}

// arm32MatchTypeAlias returns the type clang's token aliases let written type w stand for too
// (.s32 and .u32 for .i32, .i32 and .f32 for .32, .p8 for .8, ...), or 0 for none.
func arm32MatchTypeAlias(w int) int {
	if w == matchTypeS8 || w == matchTypeU8 { return matchTypeI8 }
	if w == matchTypeS16 || w == matchTypeU16 { return matchTypeI16 }
	if w == matchTypeS32 || w == matchTypeU32 { return matchTypeI32 }
	if w == matchTypeS64 || w == matchTypeU64 { return matchTypeI64 }
	if w == matchTypeI8 || w == matchTypeP8 { return matchType8 }
	if w == matchTypeI16 || w == matchTypeP16 { return matchType16 }
	if w == matchTypeI32 || w == matchTypeF32 { return matchType32 }
	if w == matchTypeI64 || w == matchTypeF64 { return matchType64 }
	return 0
}

// arm32MatchTypeIs reports whether written type w matches an encoding's type want: the same type,
// or one w stands for through clang's token aliases (arm32MatchTypeAlias), in turn.
func arm32MatchTypeIs(w int, want int) bool {
	for w != 0 {
		if w == want { return true }
		w = arm32MatchTypeAlias(w)
	}
	return false
}

// arm32MatchSuffixes reads the data types among the `.` suffixes rest (lowercase, from the first
// `.`) as clang does -- `.w` is none, `.n` its error -- into types (up to three kept), returning
// how many there are and whether there is no `.n`, setting the error if there is.
func arm32MatchSuffixes(p @Parser, rest *[]readonly char, types @[]int) (int, bool) {
	var n int = 0
	var start int = 1
	for i := 1; i <= len(rest); i++ {
		if i < len(rest) && rest[i] != '.' { continue }
		var part *[]readonly char = rest[start:i]
		start = i + 1
		if charsEqual(part, "w") { continue }
		if charsEqual(part, "n") {
			setErr(p, "instruction with .n (narrow) qualifier not allowed in arm mode")
			return 0, false
		}
		if n < len(types) { types[n] = arm32MatchType(part) }
		n = n + 1
	}
	return n, true
}

// The kinds of operand read (arm32MatchItem.kind).
const (
	matchItemS int = iota + 1
	matchItemD
	matchItemQ
	matchItemImm
	matchItemMem
	matchItemSys
	matchItemBang
	matchItemCore
	matchItemList
	matchItemLane
	matchItemOther
)

// arm32MatchItem is an operand as written: an S, D or Q register (n its number); an expression (val
// its value when known -- a number rather than a symbol, a location or a difference of them -- sym
// the symbol it is relative to, dot when it is relative to `.`; real for a floating-point literal
// other than zero, which clang reads as a number, its bit pattern; prefix for one with a
// `:lower16:`-style prefix; quoted for a quoted symbol name, which this reader leaves unread); a
// memory operand (arm32MatchMem: n its core base register, or index for another register or an
// index; val, known and sub, clang's negative zero, its offset; plain for no offset at all, align
// for an alignment); a system register's name (arm32MatchSysReg: n); a `!`, which clang reads as an
// operand of its own after a register, an immediate with a prefix or a memory operand (bang marks
// one to follow); a core register (n); a register list (arm32MatchRegList: list its class, n and
// count its S or D registers; caret for the `^` clang reads as an operand after it); a lane, which
// clang reads as an operand of its own after a register (lane marks one to follow, laneNum its
// number; a matchItemLane holds it in val); or anything else.
type arm32MatchItem struct {
	kind    int
	n       int
	val     int64
	known   bool
	sym     @[]char
	dot     bool
	real    bool
	prefix  bool
	quoted  bool
	sub     bool
	index   bool
	plain   bool
	align   bool
	bang    bool
	list    int
	count   int
	caret   bool
	lane    bool
	laneNum int64
}

// arm32MatchSkip returns the lexer and token at the end of an operand clang reads as no register or
// number this encoding can take: the next comma, or the end of the line.
func arm32MatchSkip(l Lexer, tok Token) (Lexer, Token) {
	for tok.Kind != TOK_EOF && tok.Kind != TOK_COMMA { l, tok = LexNext(l) }
	return l, tok
}

// arm32MatchOperand reads the operand at tok as clang does: an S, D (D16 .. D31 only with 32 D
// registers; clang reads the name as a symbol otherwise) or Q register, another register or a
// system register's name (arm32MatchSysReg), each with a `!` after it or not, a memory operand
// (arm32MatchMem; a `!` after it too), an expression after `#` or a lone `$` (a `!` after it too;
// a `$` before a floating-point literal is one), or one with no prefix that does not start with a
// sign or a floating-point literal -- a floating-point zero in it is 0, and another floating-point
// literal makes it no number clang's matcher takes -- an immediate with a `:lower16:`-style prefix
// (arm32MatchPrefixed), or another operand clang reads (arm32MatchOtherStart), which this reader
// leaves unread; a register list is read in mode (arm32MatchRegList).  It returns the lexer and the
// token after it, the operand, and whether it was read, setting the error if not.
func arm32MatchOperand(p @Parser, l Lexer, tok Token,
		mode int) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	it.kind = matchItemOther
	if tok.Kind == TOK_IDENT && arm32MatchSysReg(tok.Text) > 0 {
		it.kind = matchItemSys
		it.n = arm32MatchSysReg(tok.Text)
		l, tok = LexNext(l)
		return arm32MatchAfterReg(p, l, tok, it)
	}
	if tok.Kind == TOK_LBRACKET {
		var ok bool
		l, tok, it, ok = arm32MatchMem(p, l)
		if ok && tok.Kind == TOK_BANG {
			it.bang = true
			l, tok = LexNext(l)
		}
		return l, tok, it, ok
	}
	if tok.Kind == TOK_IDENT && tok.Text[0] != '$' && arm32RegisterName(tok.Text) {
		var s int = arm32VfpReg(tok.Text, 's')
		var d int = arm32VfpReg(tok.Text, 'd')
		var q int = arm32VfpReg(tok.Text, 'q')
		if s >= 0 {
			it.kind = matchItemS
			it.n = s
		} else if d >= 0 && (d < 16 || p.Arm32FP & armFpD32 != 0) {
			it.kind = matchItemD
			it.n = d
		} else if q >= 0 {
			it.kind = matchItemQ
			it.n = q
		} else if parseArm32Reg(tok.Text) >= 0 {
			it.kind = matchItemCore
			it.n = parseArm32Reg(tok.Text)
		}
		if it.kind != matchItemOther || d < 0 {
			l, tok = LexNext(l)
			return arm32MatchAfterReg(p, l, tok, it)
		}
	}
	if tok.Kind == TOK_FLOAT || arm32SignedStart(tok) {
		setErr(p, "unexpected token in operand")
		return l, tok, it, false
	}
	var expr bool = tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR || tok.Kind == TOK_IDENT ||
			tok.Kind == TOK_INT || tok.Kind == TOK_CHAR || tok.Kind == TOK_LPAREN || tok.Kind == TOK_DOT
	if !expr {
		if !arm32MatchOtherStart(tok) {
			setErr(p, "unexpected token in operand")
			return l, tok, it, false
		}
		if tok.Kind == TOK_COLON { return arm32MatchPrefixed(p, l) }
		if tok.Kind == TOK_LBRACE { return arm32MatchRegList(p, l, mode) }
		if tok.Kind == TOK_STRING { it = arm32MatchQuoted() }
		l, tok = arm32MatchSkip(l, tok)
		return l, tok, it, true
	}
	var after Lexer
	var real bool
	after, real = arm32DollarReal(l, tok)
	if real {
		// clang reads the `$` before a floating-point literal as the prefix, not part of a name.
		l = after
		tok.Kind = TOK_DOLLAR
	}
	var negative bool = arm32PrefixedMinus(l, tok)
	var prefixed bool = tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR
	// A `!` after an immediate with a prefix (`$4` lexes as a name) is an operand of its own.
	var bangOk bool = prefixed || (tok.Kind == TOK_IDENT && tok.Text[0] == '$')
	if prefixed {
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
			setErr(p, "unknown token in expression")
			return l, tok, it, false
		}
		if tok.Kind == TOK_COLON { return arm32MatchPrefixed(p, l) }
		if tok.Kind == TOK_STRING {
			l, tok = arm32MatchSkip(l, tok)
			return l, tok, arm32MatchQuoted(), true
		}
	}
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	it.kind = matchItemImm
	if !r.Ok {
		// A floating-point literal other than zero (Parser.ExprZeroReals) is a number no encoding
		// here takes; any other failure is clang's parse error.
		if !charsEqual(r.Err, "invalid operand for instruction") {
			setErr(p, exprErr(r, "unknown token in expression"))
			return l, tok, it, false
		}
		it.real = true
		l, tok = arm32MatchSkip(l, tok)
		return l, tok, it, true
	}
	it.known = !r.FromDiff && !r.Pending && !isSymbolic(r) && !hasNeg(r)
	it.val = r.Val
	it.sym = r.Sym
	it.dot = r.Dot
	if negative && it.known && it.val == 0 { it.val = -2147483648 }
	if bangOk && tok.Kind == TOK_BANG {
		it.bang = true
		l, tok = LexNext(l)
	}
	return l, tok, it, true
}

// arm32MatchAfterReg reads what clang reads after a register, it, at tok (l the lexer after it): a
// `!` (it.bang) or a lane, `[`, a constant expression and `]` (it.lane, it.laneNum; clang's
// "immediate value expected for vector index" for no number, "']' expected").  It returns the lexer
// and the token after them, the register, and whether they were read, setting the error if not.
func arm32MatchAfterReg(p @Parser, l Lexer, tok Token,
		it arm32MatchItem) (Lexer, Token, arm32MatchItem, bool) {
	if tok.Kind == TOK_BANG {
		it.bang = true
		l, tok = LexNext(l)
		return l, tok, it, true
	}
	if tok.Kind != TOK_LBRACKET { return l, tok, it, true }
	l, tok = LexNext(l)
	if tok.Kind == TOK_STRING {
		// A quoted symbol name, no number.
		setErr(p, "immediate value expected for vector index")
		return l, tok, it, false
	}
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	// A floating-point literal other than zero is a number (its bit pattern), a lane none has.
	var real bool = !r.Ok && charsEqual(r.Err, "invalid operand for instruction")
	if real {
		l, tok = arm32MatchSkipTo(l, tok, TOK_RBRACKET)
		r.Val = -1
	} else if !r.Ok {
		setErr(p, exprErr(r, "unknown token in expression"))
		return l, tok, it, false
	}
	if !real && (r.FromDiff || r.Pending || isSymbolic(r) || hasNeg(r)) {
		setErr(p, "immediate value expected for vector index")
		return l, tok, it, false
	}
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "']' expected")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	it.lane = true
	it.laneNum = r.Val
	return l, tok, it, true
}

// arm32MatchQuoted returns the immediate a quoted symbol name starts, which the reader leaves
// unread (the expression parser reads no quoted name).
func arm32MatchQuoted() arm32MatchItem {
	var it arm32MatchItem
	it.kind = matchItemImm
	it.quoted = true
	return it
}

// arm32MatchPrefixed reads an immediate with a `:lower16:`-style prefix as clang does, l the lexer
// after its first `:`: a prefix clang has for ELF (lower16, upper16, lower0_7, lower8_15, upper0_7,
// upper8_15, in lower case), its second `:`, perhaps a `#`, and an expression -- an operand no
// encoding here relocates.  It returns the lexer and the token after it, the operand, and whether
// it was read, setting clang's error if not.
func arm32MatchPrefixed(p @Parser, l Lexer) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	it.kind = matchItemImm
	it.prefix = true
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected prefix identifier in operand")
		return l, tok, it, false
	}
	var t @[]char = tok.Text
	if !charsEqual(t, "lower16") && !charsEqual(t, "upper16") && !charsEqual(t, "lower0_7") &&
			!charsEqual(t, "lower8_15") && !charsEqual(t, "upper0_7") && !charsEqual(t, "upper8_15") {
		setErr(p, "unexpected prefix in operand")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COLON {
		setErr(p, "unexpected token after prefix")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_HASH { l, tok = LexNext(l) }
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	if !r.Ok {
		// A floating-point literal other than zero (Parser.ExprZeroReals) is a number.
		if !charsEqual(r.Err, "invalid operand for instruction") {
			setErr(p, exprErr(r, "unknown token in expression"))
			return l, tok, it, false
		}
		l, tok = arm32MatchSkip(l, tok)
	}
	return l, tok, it, true
}

// arm32DollarReal returns the lexer after the `$` of tok when tok is a name that starts with `$`
// and a floating-point literal follows the `$` (which clang reads as the `$` and a number, not as
// one name), and whether it is.
func arm32DollarReal(l Lexer, tok Token) (Lexer, bool) {
	if tok.Kind != TOK_IDENT || len(tok.Text) < 2 || tok.Text[0] != '$' { return l, false }
	var after Lexer
	after, _ = arm32ImmPrefix(l, tok, true)
	var next Token
	_, next = LexNext(after)
	return after, next.Kind == TOK_FLOAT
}

// arm32MatchOtherStart reports whether tok starts an operand clang reads that an expression does
// not: a register list (arm32MatchRegList), a quoted symbol name (left unread), or an immediate
// with a `:lower16:`-style prefix (arm32MatchPrefixed).
func arm32MatchOtherStart(tok Token) bool {
	return tok.Kind == TOK_LBRACE || tok.Kind == TOK_COLON || tok.Kind == TOK_STRING
}

// arm32MatchOperands reads the operands after l, keeping the first six (more are only counted),
// and returns them, how many there are, and whether they were read, setting the error if not.
func arm32MatchOperands(p @Parser, l Lexer) (@[]arm32MatchItem, int, bool) {
	return arm32MatchOperandsIn(p, l, matchListPlain)
}

// arm32MatchOperandsIn is arm32MatchOperands with a register list read in mode (matchList*).
func arm32MatchOperandsIn(p @Parser, l Lexer, mode int) (@[]arm32MatchItem, int, bool) {
	var items @[]arm32MatchItem = make_slice(arm32MatchItem, 6)
	var n int = 0
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF {
		var it arm32MatchItem
		var ok bool
		l, tok, it, ok = arm32MatchOperand(p, l, tok, mode)
		if !ok { return items, n, false }
		if n < len(items) { items[n] = it }
		n = n + 1
		if it.bang {
			if n < len(items) { items[n].kind = matchItemBang }
			n = n + 1
		}
		if it.caret {
			if n < len(items) { items[n].kind = matchItemOther }
			n = n + 1
		}
		if it.lane {
			if n < len(items) {
				items[n].kind = matchItemLane
				items[n].val = it.laneNum
				items[n].known = true
			}
			n = n + 1
		}
		if tok.Kind == TOK_EOF { break }
		if tok.Kind != TOK_COMMA {
			setErr(p, "unexpected token in argument list")
			return items, n, false
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
			setErr(p, "unexpected token in operand")
			return items, n, false
		}
	}
	return items, n, true
}
