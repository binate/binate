package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// clang's messages for a conversion's operands as written: a sign or a floating-point literal
// with no `#`, a `#` with nothing after it, a missing comma, a comma with nothing after it, an
// empty operand, one starting with a token no operand starts with, an expression that does not
// parse; a register or a prefixed immediate with a `!` after it, which clang reads as two
// operands; a `:lower16:`-style prefix or a quoted name, which it reads as an immediate.
func TestParseArm32CvtOperandSyntax() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, -1", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, 1.0", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #", "unknown token in expression")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0 #1", "unexpected token in argument list")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0,", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 , s1", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, =1", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #-", "unknown token in expression")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #(1+", "unknown token in expression")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s1!", "invalid operand for instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #3!", "too many operands for instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, $3!", "invalid instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, :lower16:x", "operand must be a register in range [s0, s31]")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #:lower16:3", "invalid operand for instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, \"x\"", "invalid operand for instruction")
	return e
}

// An immediate with a `:lower16:`-style prefix as clang reads it, with its messages: a prefix it
// does not have (`:foo:`, `:LOWER16:`, VCVT's too) or no name, no second `:`, no expression,
// something after it (a `!` too); one it reads, ELF's `:upper8_15:` included, with a `#` before or
// after it or a floating-point literal, is VLDR's address with no relocation.  A `$` before a
// floating-point literal is the prefix, not part of a name (as an alignment, neither).
func TestParseArm32MatchPrefixed() testing.TestResult {
	var e @[]char = ""
	var reloc *[]readonly char = "expected relocatable expression"
	var bad *[]readonly char = "invalid operand for instruction"
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = armMsgIs(e, "", "vldr s0, :foo:x", "unexpected prefix in operand")
	e = armMsgIs(e, "", "vldr s0, :LOWER16:x", "unexpected prefix in operand")
	e = armMsgIs(e, "", "vcvt.f32.s32 s0, s0, :foo:x", "unexpected prefix in operand")
	e = armMsgIs(e, "", "vldr s0, :5:x", "expected prefix identifier in operand")
	e = armMsgIs(e, "", "vldr s0, :lower16 x", "unexpected token after prefix")
	e = armMsgIs(e, "", "vldr s0, :lower16:", "unknown token in expression")
	e = armMsgIs(e, "", "vldr s0, :lower16:x!", "unexpected token in argument list")
	e = armMsgIs(e, "", "vldr s0, :lower16:x foo", "unexpected token in argument list")
	e = armMsgIs(e, "", "vldr s0, :lower16:x, s1", "too many operands for instruction")
	e = armMsgIs(e, "", "vcvt.f32.s32 s0, s0, :lower16:x", bad)
	e = armMsgIs(e, "", "vldr s0, :upper8_15:x", reloc)
	e = armMsgIs(e, "", "vldr s0, #:lower16:#x", reloc)
	e = armMsgIs(e, "", "vldr s0, :lower16:1.5", reloc)
	e = armMsgIs(e, "", "vldr s0, $1.5", bad)
	e = armMsgIs(e, "", "vldr s0, $0.0", bad)
	e = armMsgIs(e, "", "vcvt.f32.s32 s0, s0, $0.0", several)
	e = armMsgIs(e, "", "vldr s0, [r0:$1.5]", "invalid token in expression")
	e = arm32PoolCase(e, "$lbl: nop\nvldr s0, $lbl", "E320F000 ED1F0A03 ", 0)
	return e
}
