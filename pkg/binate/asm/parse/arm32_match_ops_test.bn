package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// clang's messages for a conversion's operands as written: a sign or a floating-point literal
// with no `#`, a `#` with nothing after it, a missing comma, a comma with nothing after it, an
// empty operand, one starting with a token no operand starts with, an expression that does not
// parse; a register or a prefixed immediate with a `!` after it, which clang reads as two
// operands; a `:lower16:`-style prefix or a quoted name, which it reads as an immediate.
func TestParseArm32CvtOperandSyntax() testing.TestResult {
	var e @[]char = ""
	var f *[]readonly char = arm32CvtFull
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, -1", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, 1.0", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #", "unknown token in expression")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0 #1", "unexpected token in argument list")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0,", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 , s1", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, =1", "unexpected token in operand")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #-", "unknown token in expression")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #(1+", "unknown token in expression")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s1!", "invalid operand for instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #3!", "too many operands for instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, $3!", "invalid instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, :lower16:x", "operand must be a register in range [s0, s31]")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, #:lower16:3", "invalid operand for instruction")
	e = armMsgIs(e, f, "vcvt.f32.s32 s0, s0, \"x\"", "invalid operand for instruction")
	return e
}
