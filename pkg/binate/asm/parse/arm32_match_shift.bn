package "pkg/binate/asm/parse"

// A register shifted by an immediate or a register (`r2, lsl #1`), as clang's operand parser reads
// one: the shift is an operand of its own, which clang folds into the register before it -- an
// operand no VFP or NEON encoding takes.

// arm32MatchRegShiftMost returns the largest amount of shift name, in any case, as clang reads a
// register's shift: 31 for lsl (asl) and ror, 32 for lsr and asr, 0 for rrx (which takes none), and
// -1 for any other name.
func arm32MatchRegShiftMost(name *[]readonly char) int64 {
	if mnemIs(name, "lsl") || mnemIs(name, "asl") || mnemIs(name, "ror") { return 31 }
	if mnemIs(name, "lsr") || mnemIs(name, "asr") { return 32 }
	if mnemIs(name, "rrx") { return 0 }
	return -1
}

// arm32MatchRegToken reports whether tok is a register's name as clang's operand parser reads one:
// any register (arm32RegisterName), but D16 .. D31 only with 32 D registers (a symbol's name
// otherwise).
func arm32MatchRegToken(p @Parser, tok Token) bool {
	if tok.Kind != TOK_IDENT || tok.Text[0] == '$' || !arm32RegisterName(tok.Text) { return false }
	var d int = arm32VfpReg(tok.Text, 'd')
	return d < 16 || p.Arm32FP & armFpD32 != 0
}

// arm32MatchRegShift reads the shift at tok, a shift's name of largest amount most
// (arm32MatchRegShiftMost), as clang does after a register: rrx alone; else `#` (or `$`) and a
// constant within 0 .. most (a floating-point literal other than zero, which clang reads as its
// bit pattern, none), or a register.  It returns the lexer and the token after it and whether it
// was read, setting clang's error if not: the expression's own, "invalid immediate shift value"
// for one that is no constant, "immediate shift value out of range", "expected immediate or
// register in shift operand".
func arm32MatchRegShift(p @Parser, l Lexer, tok Token, most int64) (Lexer, Token, bool) {
	l, tok = LexNext(l)
	if most == 0 { return l, tok, true }
	immL, prefixed := arm32ImmPrefix(l, tok, true)
	if !prefixed {
		if !arm32MatchRegToken(p, tok) {
			setErr(p, "expected immediate or register in shift operand")
			return l, tok, false
		}
		l, tok = LexNext(l)
		return l, tok, true
	}
	l, tok = LexNext(immL)
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	var real bool = !r.Ok && charsEqual(r.Err, "invalid operand for instruction")
	if !r.Ok && !real {
		setErr(p, exprErr(r, "unknown token in expression"))
		return l, tok, false
	}
	if !real && (r.FromDiff || r.Pending || isSymbolic(r) || hasNeg(r)) {
		setErr(p, "invalid immediate shift value")
		return l, tok, false
	}
	if real || r.Val < 0 || r.Val > most {
		setErr(p, "immediate shift value out of range")
		return l, tok, false
	}
	return l, tok, true
}
