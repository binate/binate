package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// A shift's name, in any case, has its largest amount (asl as lsl; rrx none); uxtw, a memory
// operand's, is none here.  A register's name is any register clang reads, D16 .. D31 only with 32
// D registers.
func TestArm32MatchRegShiftNames() testing.TestResult {
	if arm32MatchRegShiftMost("LSL") != 31 || arm32MatchRegShiftMost("Asl") != 31 ||
			arm32MatchRegShiftMost("ror") != 31 || arm32MatchRegShiftMost("lsr") != 32 ||
			arm32MatchRegShiftMost("ASR") != 32 || arm32MatchRegShiftMost("rrx") != 0 {
		return fail("a shift's largest amount is wrong")
	}
	if arm32MatchRegShiftMost("uxtw") != -1 || arm32MatchRegShiftMost("lsls") != -1 {
		return fail("a name that is no register's shift is one")
	}
	return ""
}

// A shift after a register is an operand clang folds into the register, one no encoding of these
// instructions takes, so the near misses at its place make the error: a NEON Q form's register
// class, a two-operand form's one too many, none of MVE's (which want MVE too); in any case, by
// an immediate (`$` for `#`, an expression) or a register (any, D16 only with 32 D registers),
// rrx with none.
func TestParseArm32MatchRegShiftNearMisses() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #1", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, LSL #1", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, asl #31", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsr #32", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, rrx", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl r3", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl d16", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl $1", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #(1+1)", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #0.0", several)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, fpscr, lsl #1", several)
	e = armMsgIs(e, "", "vmla.i8 q0, q1, r2, lsl #1", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, "", "vmlas.i8 q0, q1, r2, lsl #1", "invalid instruction")
	e = armMsgIs(e, "", "vadd.f32 s0, s1, lsl #1", "operand must be a register in range [s0, s31]")
	e = armMsgIs(e, "", "vcvt.f32.s32 s0, s1, lsl #1", "operand must be a register in range [s0, s31]")
	return e
}

// What clang does not read as a shift, with its message: a shift after no register (an immediate,
// a label, a list, a memory operand, a register with `!` or a lane, another shift, nothing); no
// amount, or one that is no `#` or register (D16 without 32 D registers); an amount that is no
// constant, out of range for its shift (32 for lsl and ror, 33 for lsr), negative, a
// floating-point literal other than zero or a character's code; no expression after `#`; a token
// after the shift.
func TestParseArm32MatchRegShiftRejects() testing.TestResult {
	var e @[]char = ""
	var notReg *[]readonly char = "shift must be of a register"
	var amount *[]readonly char = "expected immediate or register in shift operand"
	var outOfRange *[]readonly char = "immediate shift value out of range"
	var stray *[]readonly char = "unexpected token in argument list"
	e = armMsgIs(e, "", "vadd.i8 q0, q1, #1, lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, lbl, lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, {d0}, lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, [r0], lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2!, lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, d2[0], lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, rrx, lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #1, lsl #2", notReg)
	e = armMsgIs(e, "", "vadd.i8 lsl #1", notReg)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl", amount)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl ,", amount)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl 1", amount)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl foo", amount)
	e = armMsgIs(e, ".fpu vfpv3-d16", "vadd.i8 q0, q1, r2, lsl d16", amount)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #x", "invalid immediate shift value")
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl $x", "invalid immediate shift value")
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #32", outOfRange)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, ror #32", outOfRange)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsr #33", outOfRange)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #-1", outOfRange)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #1.0", outOfRange)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #'a'", outOfRange)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #", "unknown token in expression")
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, rrx #1", stray)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl r3!", stray)
	e = armMsgIs(e, "", "vadd.i8 q0, q1, r2, lsl #1!", stray)
	return e
}
