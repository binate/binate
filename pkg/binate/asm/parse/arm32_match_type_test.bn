package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Written types match an encoding's through clang's token aliases, in turn: .s32 and .u32 stand for
// .i32, which stands for .32; .f32 and clang's .f for .32 too, .f64 and .d for .64, .p8 for .8;
// not the other way, and .f16 for none of them.
func TestArm32MatchTypeIs() testing.TestResult {
	if !arm32MatchTypeIs(matchTypeS32, matchType32) || !arm32MatchTypeIs(matchTypeU32, matchTypeI32) ||
			!arm32MatchTypeIs(arm32MatchType("f"), matchType32) ||
			!arm32MatchTypeIs(arm32MatchType("d"), matchType64) ||
			!arm32MatchTypeIs(matchTypeP8, matchType8) {
		return fail("a written type does not stand for clang's alias of it")
	}
	if arm32MatchTypeIs(matchType32, matchTypeS32) || arm32MatchTypeIs(matchTypeI32, matchTypeS32) ||
			arm32MatchTypeIs(matchTypeF16, matchType16) {
		return fail("a written type stands for one clang's aliases do not give it")
	}
	return ""
}
