package "pkg/binate/asm/parse"

// A NEON vector list as clang's parseVectorList reads one, where an encoding of the mnemonic takes
// one (arm32MatchOperandsAt's listMask): `{`, D registers -- one after another or every other one,
// written one by one or as a range, a Q register for its two -- each with the same lane (none,
// `[]` for all, or `[n]`), then `}`; or a D register alone, its lane making a list of one.  clang
// computes a list's registers on its own numbering of every register, so it takes a list with a
// core, S or system register as D registers (`{r0}` as {d0}, `{d31, fpinst2}` as three), and a Q
// register alone with no lane as its first D register (`q1` as d2); each is silently another
// operand than the one written, an error here -- a list with another register "invalid register in
// register list" at its first register, "non-contiguous register range" after one, and a Q
// register alone once an encoding takes it (arm32MatchItem.qalone).

// The lanes a vector list's registers name (arm32MatchItem.vlanes): none, all (`[]`), or one.
const (
	vecLanesNone int = iota
	vecLanesAll
	vecLanesOne
)

// arm32MatchVecReg returns the kind (matchReg*) and number of the register tok names as clang's
// tryParseRegister reads one here (arm32MatchListReg's: a core, S, D -- D16..D31 only with 32 D
// registers -- or Q register, or another register clang knows), or none.
func arm32MatchVecReg(p @Parser, tok Token) (int, int) {
	if tok.Kind != TOK_IDENT || tok.Text[0] == '$' { return matchRegNone, 0 }
	return arm32MatchListReg(p, tok, matchListPlain)
}

// arm32VecLaneSyntax reports whether err, an expression's error (none for a token it does not
// read), is the expression parser's own, a token it does not read, rather than a valid expression
// that is no number.
func arm32VecLaneSyntax(err *[]readonly char) bool {
	if len(err) == 0 { return true }
	for i := 0; i + 5 <= len(err); i++ {
		if charsEqual(err[i:i + 5], "token") { return true }
	}
	return false
}

// arm32MatchVecLane reads a register's lane as clang's parseVectorLane does, at tok (l the lexer
// after it): `[`, then `]` for all lanes, or a `#` or not, a constant 0..7 and `]`; anything else
// is none.  It returns the lexer and the token after it, the lanes (vecLanes*), the index, and
// whether it was read, setting clang's error if not (the expression parser's for a token it does
// not read, "lane index must be empty or an integer" for an expression that is no number, "']'
// expected", "lane index out of range").
func arm32MatchVecLane(p @Parser, l Lexer, tok Token) (Lexer, Token, int, int64, bool) {
	if tok.Kind != TOK_LBRACKET { return l, tok, vecLanesNone, 0, true }
	l, tok = LexNext(l)
	if tok.Kind == TOK_RBRACKET {
		l, tok = LexNext(l)
		return l, tok, vecLanesAll, 0, true
	}
	if tok.Kind == TOK_HASH { l, tok = LexNext(l) }
	if tok.Kind == TOK_STRING {
		setErr(p, "lane index must be empty or an integer")
		return l, tok, 0, 0, false
	}
	var r ExprResult
	p.ExprZeroReals = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.ExprZeroReals = false
	// A floating-point literal other than zero is a number to clang, its bit pattern: no lane.
	var real bool = !r.Ok && charsEqual(r.Err, "invalid operand for instruction")
	if !r.Ok && !real && arm32VecLaneSyntax(r.Err) {
		setErr(p, exprErr(r, "unknown token in expression"))
		return l, tok, 0, 0, false
	}
	if real {
		l, tok = arm32MatchSkipTo(l, tok, TOK_RBRACKET)
		r.Val = -1
	} else if !r.Ok || r.FromDiff || r.Pending || isSymbolic(r) || hasNeg(r) {
		setErr(p, "lane index must be empty or an integer")
		return l, tok, 0, 0, false
	}
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "']' expected")
		return l, tok, 0, 0, false
	}
	l, tok = LexNext(l)
	if r.Val < 0 || r.Val > 7 {
		setErr(p, "lane index out of range")
		return l, tok, 0, 0, false
	}
	return l, tok, vecLanesOne, r.Val, true
}

// arm32MatchVecList reads a vector list at tok as clang's parseVectorList does (l the lexer after
// tok): a list in braces, or a register alone (arm32MatchVecSingle).  It returns the lexer and the
// token after it, the operand (matchItemVecList: n its first D register, count, spaced, vlanes and
// laneNum; or the register read), and whether it was read, setting clang's error if not.
func arm32MatchVecList(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	if tok.Kind != TOK_LBRACE { return arm32MatchVecSingle(p, l, tok) }
	it.kind = matchItemVecList
	l, tok = LexNext(l)
	kind, first := arm32MatchVecReg(p, tok)
	if kind == matchRegNone {
		setErr(p, "register expected")
		return l, tok, it, false
	}
	if kind != matchRegD && kind != matchRegQ {
		setErr(p, "invalid register in register list")
		return l, tok, it, false
	}
	var count int = 1
	var spacing int = 0
	if kind == matchRegQ {
		first = 2 * first
		spacing = 1
		count = 2
	}
	var reg int = first + count - 1
	l, tok = LexNext(l)
	var lanes int
	var index int64
	var ok bool
	l, tok, lanes, index, ok = arm32MatchVecLane(p, l, tok)
	if !ok { return l, tok, it, false }
	for tok.Kind == TOK_COMMA || tok.Kind == TOK_MINUS {
		var dash bool = tok.Kind == TOK_MINUS
		if dash && spacing == 2 {
			setErr(p, "sequential registers in double spaced list")
			return l, tok, it, false
		}
		if dash && spacing == 0 { spacing = 1 }
		l, tok = LexNext(l)
		k, n := arm32MatchVecReg(p, tok)
		if k == matchRegNone {
			setErr(p, "register expected")
			return l, tok, it, false
		}
		l, tok = LexNext(l)
		var next int = n
		if k == matchRegQ { next = 2 * n }
		if dash {
			if k == matchRegQ { next = next + 1 }
			if (k == matchRegD || k == matchRegQ) && next == reg { continue }
			if k != matchRegD && k != matchRegQ {
				setErr(p, "invalid register in register list")
				return l, tok, it, false
			}
			if reg > next {
				setErr(p, "bad range in register list")
				return l, tok, it, false
			}
			count = count + next - reg
		} else if k == matchRegQ {
			if spacing == 2 {
				setErr(p, "invalid register in double-spaced list (must be 'D' register')")
				return l, tok, it, false
			}
			spacing = 1
			if next != reg + 1 {
				setErr(p, "non-contiguous register range")
				return l, tok, it, false
			}
			next = next + 1
			count = count + 2
		} else {
			if spacing == 0 {
				spacing = 1
				if k == matchRegD && next == reg + 2 { spacing = 2 }
			}
			if k != matchRegD || next != reg + spacing {
				setErr(p, "non-contiguous register range")
				return l, tok, it, false
			}
			count = count + 1
		}
		reg = next
		var nextLanes int
		var nextIndex int64
		l, tok, nextLanes, nextIndex, ok = arm32MatchVecLane(p, l, tok)
		if !ok { return l, tok, it, false }
		if nextLanes != lanes || nextIndex != index {
			setErr(p, "mismatched lane index in register list")
			return l, tok, it, false
		}
	}
	if tok.Kind != TOK_RBRACE {
		setErr(p, "'}' expected")
		return l, tok, it, false
	}
	l, tok = LexNext(l)
	it.n = first
	it.count = count
	it.spaced = spacing == 2
	it.vlanes = lanes
	it.laneNum = index
	return l, tok, it, true
}

// arm32MatchVecSingle reads a register alone where clang reads a vector list, at tok (l the lexer
// after it): a D register with no lane is the register, with a lane a list of it; a Q register with
// a lane a list of its two D registers, with none clang's first D register of it (marked qalone);
// another register the register alone, nothing after it read; any other operand as
// arm32MatchOperand reads it.
func arm32MatchVecSingle(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	kind, n := arm32MatchVecReg(p, tok)
	if kind == matchRegNone { return arm32MatchOperand(p, l, tok, matchListPlain) }
	if kind != matchRegD && kind != matchRegQ {
		it.kind = matchItemOther
		if kind == matchRegCore { it.kind = matchItemCore }
		if kind == matchRegS { it.kind = matchItemS }
		it.n = n
		l, tok = LexNext(l)
		return l, tok, it, true
	}
	var count int = 1
	if kind == matchRegQ {
		n = 2 * n
		count = 2
	}
	l, tok = LexNext(l)
	var lanes int
	var index int64
	var ok bool
	l, tok, lanes, index, ok = arm32MatchVecLane(p, l, tok)
	if !ok { return l, tok, it, false }
	if lanes == vecLanesNone {
		it.kind = matchItemD
		it.n = n
		it.qalone = kind == matchRegQ
		return l, tok, it, true
	}
	it.kind = matchItemVecList
	it.n = n
	it.count = count
	it.vlanes = lanes
	it.laneNum = index
	return l, tok, it, true
}
