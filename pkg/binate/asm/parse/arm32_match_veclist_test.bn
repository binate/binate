package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// A vector list as clang reads one, with its errors: no register, a register out of sequence (a
// core register after D registers), a range backwards or past the list's first register's kind, a
// lane out of range or not a number, lanes that differ, no `}`; and here a core or S register
// starting a list and a Q register alone with no lane, which clang reads as another register's
// number and as its first D register.
func TestParseArm32VecListErrors() testing.TestResult {
	var e @[]char = ""
	e = armMsgIs(e, "", "vtbl.8 d0, q1, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d3-d1}, d2", "bad range in register list")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[8]}, d2", "lane index out of range")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, d2[0]}, d3", "mismatched lane index in register list")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, r0}, d2", "non-contiguous register range")
	e = armMsgIs(e, "", "vtbl.8 d0, {r0}, d2", "invalid register in register list")
	e = armMsgIs(e, "", "vtbl.8 d0, {}, d2", "register expected")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, }, d2", "register expected")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, d2, d4}, d5", "non-contiguous register range")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1 d2}, d3", "'}' expected")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1-r1}, d3", "invalid register in register list")
	e = armMsgIs(e, "", "vtbl.8 d0, {s1}, d3", "invalid register in register list")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1}, q2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbleq.8 d0, {d1}, d2",
			"instruction 'vtbl' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[x]}, d2", "lane index must be empty or an integer")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[-1]}, d2", "lane index out of range")
	return e
}

// The errors of what clang reads around a vector list: another register in a list (in a range, or
// after D registers), a lane that is no number (syntax the expression parser's error, a valid
// expression clang's own), a register other than D or Q alone with something after it, a shift
// after a lane's list, a Q register alone where no encoding matches (clang's errors first); and
// here a list clang computes on its own register numbering ({d30, d31, fpinst2}, {fpscr}).
func TestParseArm32VecListAround() testing.TestResult {
	var e @[]char = ""
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, fpscr}, d2", "non-contiguous register range")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1-fpscr}, d2", "invalid register in register list")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[#]}, d2", "unknown token in expression")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[1+]}, d2", "unknown token in expression")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[foo-foo]}, d2", "lane index must be empty or an integer")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[-foo]}, d2", "lane index must be empty or an integer")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[\"a\"]}, d2", "lane index must be empty or an integer")
	e = armMsgIs(e, "", "vtbl.8 d0, r1!, d2", "unexpected token in argument list")
	e = armMsgIs(e, "", "vtbl.8 d0, s1[0], d2", "unexpected token in argument list")
	e = armMsgIs(e, "", "vtbl.8 d0, fpscr!, d2", "unexpected token in argument list")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1}, r2!", "unexpected token in argument list")
	e = armMsgIs(e, "", "vtbl.8 d0, d1[0], lsl #2", "shift must be of a register")
	e = armMsgIs(e, "", "vtbl.8 d0, d1[], lsl #2", "shift must be of a register")
	e = armMsgIs(e, "", "vtbl.8 d0, q1!, d2", "unexpected token in argument list")
	e = armMsgIs(e, "", "vtbl.8.8 d0, q1, d2", "invalid instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d30, d31, fpinst2}, d2", "non-contiguous register range")
	e = armMsgIs(e, "", "vtbl.8 d0, {fpscr}, d2", "invalid register in register list")
	return e
}
