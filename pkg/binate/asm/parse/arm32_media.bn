package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The saturate, parallel add / subtract, select, absolute-difference and pack families
// arm32MediaKind names.
const (
	mediaQadd int = iota + 1
	mediaQsub
	mediaQdadd
	mediaQdsub
	mediaSsat
	mediaUsat
	mediaSsat16
	mediaUsat16
	mediaParallel
	mediaSel
	mediaUsad8
	mediaUsada8
	mediaPkhbt
	mediaPkhtb
)

// arm32MediaKind returns the family name names (0 for none) and, for a parallel add / subtract,
// its prefix (arm32.PAR_S ..) and operation (arm32.PAR_ADD16 ..).
func arm32MediaKind(name *[]readonly char) (int, int, int) {
	if mnemIs(name, "qadd") { return mediaQadd, 0, 0 }
	if mnemIs(name, "qsub") { return mediaQsub, 0, 0 }
	if mnemIs(name, "qdadd") { return mediaQdadd, 0, 0 }
	if mnemIs(name, "qdsub") { return mediaQdsub, 0, 0 }
	if mnemIs(name, "ssat") { return mediaSsat, 0, 0 }
	if mnemIs(name, "usat") { return mediaUsat, 0, 0 }
	if mnemIs(name, "ssat16") { return mediaSsat16, 0, 0 }
	if mnemIs(name, "usat16") { return mediaUsat16, 0, 0 }
	if mnemIs(name, "sel") { return mediaSel, 0, 0 }
	if mnemIs(name, "usad8") { return mediaUsad8, 0, 0 }
	if mnemIs(name, "usada8") { return mediaUsada8, 0, 0 }
	if mnemIs(name, "pkhbt") { return mediaPkhbt, 0, 0 }
	if mnemIs(name, "pkhtb") { return mediaPkhtb, 0, 0 }
	var prefix int
	var op int
	prefix, op = arm32ParallelOp(name)
	if prefix != 0 { return mediaParallel, prefix, op }
	return 0, 0, 0
}

// arm32ParallelOp returns the prefix and operation of the parallel add / subtract name names,
// prefix 0 for none: a prefix (s, q, sh, u, uq, uh) and then an operation (add16, asx, sax,
// sub16, add8, sub8, or the old names addsubx and subaddx for asx and sax) -- not qaddsubx,
// which clang does not know.
func arm32ParallelOp(name *[]readonly char) (int, int) {
	var n int = len(name)
	if n < 4 { return 0, 0 }
	var prefix int = 0
	var rest *[]readonly char = name
	if mnemIs(name[0:2], "sh") || mnemIs(name[0:2], "uq") || mnemIs(name[0:2], "uh") {
		prefix = arm32.PAR_SH
		if mnemIs(name[0:2], "uq") { prefix = arm32.PAR_UQ }
		if mnemIs(name[0:2], "uh") { prefix = arm32.PAR_UH }
		rest = name[2:n]
		if arm32ParallelOpOf(rest) < 0 { prefix = 0 }
	}
	if prefix == 0 {
		if mnemIs(name[0:1], "s") { prefix = arm32.PAR_S }
		if mnemIs(name[0:1], "q") { prefix = arm32.PAR_Q }
		if mnemIs(name[0:1], "u") { prefix = arm32.PAR_U }
		rest = name[1:n]
	}
	var op int = arm32ParallelOpOf(rest)
	if prefix == 0 || op < 0 || prefix == arm32.PAR_Q && mnemIs(rest, "addsubx") { return 0, 0 }
	return prefix, op
}

// arm32ParallelOpOf returns the parallel operation name names (arm32.PAR_ADD16 ..), or -1.
func arm32ParallelOpOf(name *[]readonly char) int {
	if mnemIs(name, "add16") { return arm32.PAR_ADD16 }
	if mnemIs(name, "asx") || mnemIs(name, "addsubx") { return arm32.PAR_ASX }
	if mnemIs(name, "sax") || mnemIs(name, "subaddx") { return arm32.PAR_SAX }
	if mnemIs(name, "sub16") { return arm32.PAR_SUB16 }
	if mnemIs(name, "add8") { return arm32.PAR_ADD8 }
	if mnemIs(name, "sub8") { return arm32.PAR_SUB8 }
	return -1
}

// parseArm32Regs parses `, Rx` up to n registers into regs after Rd (regs[0]), tok the token
// after the last register read: it returns how many there are, or ok false with p's error set
// -- "too many operands for instruction" for a comma past the nth.
func parseArm32Regs(p @Parser, l Lexer, tok Token, regs @[]int, n int) (Lexer, Token, int, bool) {
	var got int = 1
	for got < n && tok.Kind == TOK_COMMA {
		var r int
		l, tok, r = expectArm32CommaReg(p, l, tok)
		if p.HasError { return l, tok, got, false }
		regs[got] = r
		got = got + 1
	}
	return l, tok, got, true
}

// arm32ExactOperands reports whether the operands ended after exactly n registers (got of them
// read, tok after the last), setting clang's error if not.
func arm32ExactOperands(p @Parser, tok Token, got int, n int) bool {
	if tok.Kind == TOK_COMMA {
		setErr(p, "too many operands for instruction")
		return false
	}
	if !arm32AtEOL(p, tok) { return false }
	if got < n {
		setErr(p, "too few operands for instruction")
		return false
	}
	return true
}

// parseArm32ImmOperand parses `, #imm` (or `$` or no prefix, as parseArm32OperandExpr reads it;
// tok the comma) into a value fitting the host's int, a constant (not a label difference, as
// clang requires), or ok false with p's error set.
func parseArm32ImmOperand(p @Parser, l Lexer, tok Token) (Lexer, Token, int, bool) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "too few operands for instruction")
		return l, tok, 0, false
	}
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = parseArm32OperandExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "expected an immediate"))
		return l, tok, 0, false
	}
	if r.FromDiff {
		// clang wants a constant here, not one a label difference decides.
		setErr(p, "constant expression expected")
		return l, tok, 0, false
	}
	if !intFits(r.Val) {
		setErr(p, "immediate out of range")
		return l, tok, 0, false
	}
	return l, tok, cast(int, r.Val), true
}

// The shifts a saturate's or a pack's operand may give (parseArm32ShiftImm): none, LSL, ASL (which
// only PKHBT takes, as clang has it), ASR, another, or (a pack's) an amount with no shift name.
const (
	mediaShiftNone int = iota
	mediaShiftLSL
	mediaShiftASL
	mediaShiftASR
	mediaShiftOther
	mediaShiftBare
)

// parseArm32ShiftImm parses an optional `, <shift> #amount` (tok the token after the last
// register) into the shift (mediaShiftNone when there is none) and its amount, a constant, or ok
// false with p's error set.  The amount takes `#` or `$`, as clang takes them.  A saturate's
// (not pack) shift name is LSL or ASR in lower or upper case only (another or a mixed-case one
// is mediaShiftOther); a pack's is in any case, its amount may omit the `#`, and an amount with
// no shift name is the pack's own shift (mediaShiftBare), as clang takes them.
func parseArm32ShiftImm(p @Parser, l Lexer, tok Token, pack bool) (Lexer, Token, int, int, bool) {
	if tok.Kind != TOK_COMMA { return l, tok, mediaShiftNone, 0, true }
	l, tok = LexNext(l)
	var shift int = mediaShiftBare
	if tok.Kind == TOK_IDENT && parseArm32ShiftKind(tok.Text) >= 0 {
		shift = mediaShiftOther
		if pack || arm32OneCase(tok.Text) {
			if mnemIs(tok.Text, "lsl") { shift = mediaShiftLSL }
			if mnemIs(tok.Text, "asr") { shift = mediaShiftASR }
		}
		if mnemIs(tok.Text, "asl") { shift = mediaShiftASL }
		l, tok = LexNext(l)
	} else if !pack {
		setErr(p, "expected a shift")
		return l, tok, 0, 0, false
	}
	var r ExprResult
	if shift == mediaShiftBare {
		// A pack's bare amount is clang's general operand (`$4` a name, `#-0` a negative zero).
		l, tok, r = parseArm32OperandExpr(p, l, tok)
	} else {
		var amtL Lexer
		var prefixed bool
		// After a shift name `$4` is `$` and 4, as clang reads it.
		amtL, prefixed = arm32ImmPrefix(l, tok, true)
		if prefixed {
			l, tok = LexNext(amtL)
		} else if !pack {
			setErr(p, "'#' expected")
			return l, tok, 0, 0, false
		} else if arm32SignedStart(tok) {
			setErr(p, "unexpected token in operand")
			return l, tok, 0, 0, false
		}
		l, tok, r = ParseExpr(p, l, tok)
	}
	if !r.Ok {
		setErr(p, exprErr(r, "invalid shift amount"))
		return l, tok, 0, 0, false
	}
	if r.FromDiff {
		setErr(p, "constant expression expected")
		return l, tok, 0, 0, false
	}
	if !intFits(r.Val) {
		setErr(p, "immediate value out of range")
		return l, tok, 0, 0, false
	}
	return l, tok, shift, cast(int, r.Val), true
}

// parseArm32Media assembles a saturate, parallel add / subtract, select, absolute-difference or
// pack instruction (arm32MediaKind) from its operands after Rd (tok the token after it), as clang
// takes them: QADD .. QDSUB `Rd, Rm, Rn`; SSAT / USAT `Rd, #imm, Rn{, lsl|asr #n}`, SSAT16 /
// USAT16 without the shift; the parallel ones, SEL and USAD8 `Rd, Rn, Rm`, USADA8 with Ra;
// PKHBT `Rd, Rn, Rm{, lsl #n}`, PKHTB `Rd, Rn, Rm, asr #n` (with no shift, PKHBT with Rn and Rm
// exchanged).  SSAT16 .. PKHTB and SSAT / USAT's shift need ARMv6; clang gates none of the others
// (QADD, SSAT and the parallel ones included).  The encoder checks the registers and the
// immediates.  Reports whether baseMnem is one (it is then assembled, or the error set).
func parseArm32Media(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		rd int) bool {
	var kind int
	var prefix int
	var op int
	kind, prefix, op = arm32MediaKind(baseMnem)
	if kind == 0 { return false }
	var regs @[]int = make_slice(int, 4)
	regs[0] = rd
	var got int
	var ok bool
	if kind == mediaSsat || kind == mediaUsat || kind == mediaSsat16 || kind == mediaUsat16 {
		var imm int
		l, tok, imm, ok = parseArm32ImmOperand(p, l, tok)
		if !ok { return true }
		l, tok, got, ok = parseArm32Regs(p, l, tok, regs, 2)
		if !ok { return true }
		var shift int = mediaShiftNone
		var amount int = 0
		if kind == mediaSsat || kind == mediaUsat {
			l, tok, shift, amount, ok = parseArm32ShiftImm(p, l, tok, false)
			if !ok { return true }
			// clang takes SSAT / USAT's shift (even LSL #0) from ARMv6 only.
			if shift != mediaShiftNone && !armRequire(p, armV6, "armv6") { return true }
		}
		if !arm32ExactOperands(p, tok, got, 2) || !arm32MediaGate(p, kind) { return true }
		emitArm32Saturate(p, kind, cond, rd, imm, regs[1], shift, amount)
		return true
	}
	var n int = 3
	if kind == mediaUsada8 { n = 4 }
	l, tok, got, ok = parseArm32Regs(p, l, tok, regs, n)
	if !ok { return true }
	if kind == mediaPkhbt || kind == mediaPkhtb {
		var shift int
		var amount int
		l, tok, shift, amount, ok = parseArm32ShiftImm(p, l, tok, true)
		if !ok || !arm32ExactOperands(p, tok, got, 3) || !arm32MediaGate(p, kind) { return true }
		emitArm32Pack(p, kind, cond, regs, shift, amount)
		return true
	}
	if !arm32ExactOperands(p, tok, got, n) || !arm32MediaGate(p, kind) { return true }
	var a @asm.Assembler = p.Asm
	if kind == mediaQadd { arm32.Qadd(a, cond, rd, regs[1], regs[2]) }
	if kind == mediaQsub { arm32.Qsub(a, cond, rd, regs[1], regs[2]) }
	if kind == mediaQdadd { arm32.Qdadd(a, cond, rd, regs[1], regs[2]) }
	if kind == mediaQdsub { arm32.Qdsub(a, cond, rd, regs[1], regs[2]) }
	if kind == mediaParallel { arm32.Parallel(a, cond, prefix, op, rd, regs[1], regs[2]) }
	if kind == mediaSel { arm32.Sel(a, cond, rd, regs[1], regs[2]) }
	if kind == mediaUsad8 { arm32.Usad8(a, cond, rd, regs[1], regs[2]) }
	if kind == mediaUsada8 { arm32.Usada8(a, cond, rd, regs[1], regs[2], regs[3]) }
	return true
}

// arm32MediaGate reports whether the architecture has the family kind (SSAT16 .. PKHTB:
// ARMv6), setting clang's error if not.
func arm32MediaGate(p @Parser, kind int) bool {
	if kind == mediaSsat16 || kind == mediaUsat16 || kind == mediaSel || kind == mediaUsad8 ||
			kind == mediaUsada8 || kind == mediaPkhbt || kind == mediaPkhtb {
		return armRequire(p, armV6, "armv6")
	}
	return true
}

// emitArm32Saturate emits SSAT .. USAT16 (kind) Rd, #imm, Rn with SSAT / USAT's shift, which
// clang takes as LSL or ASR only.
func emitArm32Saturate(p @Parser, kind int, cond int, rd int, imm int, rn int, shift int,
		amount int) {
	var a @asm.Assembler = p.Asm
	if kind == mediaSsat16 {
		arm32.Ssat16(a, cond, rd, imm, rn)
		return
	}
	if kind == mediaUsat16 {
		arm32.Usat16(a, cond, rd, imm, rn)
		return
	}
	var sk int = arm32.LSL
	if shift == mediaShiftASR { sk = arm32.ASR }
	if shift == mediaShiftASL || shift == mediaShiftOther {
		setErr(p, "operand must be a register in range [r0, r14]")
		return
	}
	if kind == mediaSsat {
		arm32.Ssat(a, cond, rd, imm, rn, sk, amount)
	} else {
		arm32.Usat(a, cond, rd, imm, rn, sk, amount)
	}
}

// emitArm32Pack emits PKHBT / PKHTB (kind) Rd, Rn, Rm with its shift: PKHBT's LSL (or ASL),
// PKHTB's ASR, an amount with no shift name the instruction's own, and PKHTB with none as PKHBT
// with Rn and Rm exchanged, as clang has them; the amount in the range of the named form (clang
// takes a bare PKHTB amount of 0 as 32 and wraps one past 32, which bnas does not).
func emitArm32Pack(p @Parser, kind int, cond int, regs @[]int, shift int, amount int) {
	var a @asm.Assembler = p.Asm
	if kind == mediaPkhbt {
		if shift != mediaShiftNone && shift != mediaShiftLSL && shift != mediaShiftASL &&
				shift != mediaShiftBare {
			setErr(p, "lsl operand expected.")
			return
		}
		arm32.Pkhbt(a, cond, regs[0], regs[1], regs[2], amount)
		return
	}
	if shift == mediaShiftNone {
		arm32.Pkhbt(a, cond, regs[0], regs[2], regs[1], 0)
		return
	}
	if shift != mediaShiftASR && shift != mediaShiftBare {
		setErr(p, "asr operand expected.")
		return
	}
	arm32.Pkhtb(a, cond, regs[0], regs[1], regs[2], amount)
}
