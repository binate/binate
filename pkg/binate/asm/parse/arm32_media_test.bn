package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The saturate, parallel add / subtract, select, absolute-difference and pack instructions as
// clang (Apple clang 21, armv7ve) takes them, with its words: QADD's `Rd, Rm, Rn`; the
// saturate width with `#` or none, its shift's name in lower or upper case and amount with `#` or
// `$`; the old ADDSUBX / SUBADDX names; USADA8 with Ra PC as USAD8; PKHBT's LSL or ASL, PKHTB's
// ASR, in any case, the amount with or without `#`, or with no shift name; PKHTB with no shift as
// PKHBT with Rn and Rm exchanged.  (armGateIs is in arm32_feat_test.bn.)
func TestArm32MediaForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "qadd r0, r1, r2", "E1020051")
	e = armGateIs(e, "", "qdsub r0, r1, r2", "E1620051")
	e = armGateIs(e, "", "ssat r0, #8, r1", "E6A70011")
	e = armGateIs(e, "", "ssat r0, 8, r1", "E6A70011")
	e = armGateIs(e, "", "ssat r0, #32, r1, asr #32", "E6BF0051")
	e = armGateIs(e, "", "usat r0, #7, r1, LSL #3", "E6E70191")
	e = armGateIs(e, "", "ssat16 r0, #16, r1", "E6AF0F31")
	e = armGateIs(e, "", "usat16 r0, #0, r1", "E6E00F31")
	e = armGateIs(e, "", "sadd16eq r0, r1, r2", "06110F12")
	e = armGateIs(e, "", "uhsubaddx r0, r1, r2", "E6710F52")
	e = armGateIs(e, "", "shasx r0, r1, r2", "E6310F32")
	e = armGateIs(e, "", "uqsub8 r0, r1, r2", "E6610FF2")
	e = armGateIs(e, "", "sel pc, r1, r2", "E681FFB2")
	e = armGateIs(e, "", "usada8 r0, r1, r2, pc", "E780F211")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, asl #3", "E6810192")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, ASR #32", "E6810052")
	e = armGateIs(e, "", "pkhtb r0, r1, r2", "E6820011")
	e = armGateIs(e, "", "ssat r0, #8, r1, lsl $4", "E6A70211")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, lsl 4", "E6810212")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, #4", "E6810212")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, asr 4", "E6810252")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, 32", "E6810052")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The forms clang rejects: QADDSUBX (clang knows no such name), PC where clang rejects it, a
// saturate width or shift out of its range, a saturate shift other than LSL or ASR (ASL and a
// mixed-case name included), SSAT16's shift, PKHBT's ASR and PKHTB's LSL, a label difference as a
// width (clang wants a constant), too few or too many registers, S; a bare PKHTB amount outside
// 1..32 too (which clang takes as 32 or wraps); and
// SSAT16 .. PKHTB and SSAT / USAT's shift before ARMv6 (QADD, SSAT and the parallel ones are
// taken before it, as clang takes them).
func TestArm32MediaRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "qaddsubx r0, r1, r2", "!unknown instruction")
	e = armGateIs(e, "", "qadd r0, r1, pc", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "ssat r0, #0, r1", "!operand must be an immediate in the range [1,32]")
	e = armGateIs(e, "", "usat r0, #32, r1", "!operand must be an immediate in the range [0,31]")
	e = armGateIs(e, "", "ssat r0, #8, r1, asr #33", "!'asr' shift amount must be in range [1,32]")
	e = armGateIs(e, "", "ssat r0, #8, r1, asl #3", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "ssat r0, #8, r1, lsl r2", "!'#' expected")
	e = armGateIs(e, "", "ssat16 r0, #8, r1, lsl #4", "!too many operands for instruction")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, asr #4", "!lsl operand expected.")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, lsl #4", "!asr operand expected.")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, asr #0", "!immediate value out of range")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, #0", "!immediate value out of range")
	e = armGateIs(e, "", "pkhtb r0, r1, r2, #33", "!immediate value out of range")
	e = armGateIs(e, "", "ssat r0, #8, r1, Lsl #4", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, $4", "!")
	e = armGateIs(e, "", ".La: nop\n.Lb: ssat r0, #(.Lb-.La), r1", "!constant expression expected")
	e = armGateIs(e, "", "sadd16 r0, r1", "!too few operands for instruction")
	e = armGateIs(e, "", "usad8 r0, r1, r2, r3", "!too many operands for instruction")
	e = armGateIs(e, "", "sadd16s r0, r1, r2", "!instruction 'sadd16' can not set flags")
	e = armGateIs(e, ".arch armv4", "qadd r0, r1, r2", "E1020051")
	e = armGateIs(e, ".arch armv4", "sadd16 r0, r1, r2", "E6110F12")
	e = armGateIs(e, ".arch armv4", "ssat r0, #8, r1", "E6A70011")
	e = armGateIs(e, ".arch armv5te", "usat r0, #7, r1, lsl #0", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv6", "usat r0, #7, r1, asr #3", "E6E701D1")
	e = armGateIs(e, ".arch armv5te", "ssat16 r0, #8, r1", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv5te", "pkhtb r0, r1, r2", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv5te", "sel r0, r1, r2", "!instruction requires: armv6")
	if len(e) > 0 { return fail(e) }
	return ""
}
