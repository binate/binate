package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The loads and stores arm32MemKind names.
const (
	memLdr int = iota + 1
	memStr
	memLdrb
	memStrb
	memLdrh
	memStrh
	memLdrsb
	memLdrsh
	memLdrt
	memStrt
	memLdrbt
	memStrbt
	memLdrht
	memStrht
	memLdrsbt
	memLdrsht
)

// arm32MemKind returns the load or store name names (memLdr ..), or 0.
func arm32MemKind(name *[]readonly char) int {
	if mnemIs(name, "ldr") { return memLdr }
	if mnemIs(name, "str") { return memStr }
	if mnemIs(name, "ldrb") { return memLdrb }
	if mnemIs(name, "strb") { return memStrb }
	if mnemIs(name, "ldrh") { return memLdrh }
	if mnemIs(name, "strh") { return memStrh }
	if mnemIs(name, "ldrsb") { return memLdrsb }
	if mnemIs(name, "ldrsh") { return memLdrsh }
	if mnemIs(name, "ldrt") { return memLdrt }
	if mnemIs(name, "strt") { return memStrt }
	if mnemIs(name, "ldrbt") { return memLdrbt }
	if mnemIs(name, "strbt") { return memStrbt }
	if mnemIs(name, "ldrht") { return memLdrht }
	if mnemIs(name, "strht") { return memStrht }
	if mnemIs(name, "ldrsbt") { return memLdrsbt }
	if mnemIs(name, "ldrsht") { return memLdrsht }
	return 0
}

// arm32MemHalf reports whether kind is a halfword or signed-byte load or store (or its T form).
func arm32MemHalf(kind int) bool {
	return kind == memLdrh || kind == memStrh || kind == memLdrsb || kind == memLdrsh ||
			kind == memLdrht || kind == memStrht || kind == memLdrsbt || kind == memLdrsht
}

// parseArm32LoadStore assembles a load or store (arm32MemKind) from its operand after Rt (tok the
// token after it), as clang takes it: a memory operand (parseArm32MemOperand); a PC-relative
// target (parseArm32MemTarget), except for a T form; LDR's `=expr` (parseArm32PoolLoad).  A T
// form's `[Rn]` is its post-index by 0, which STRHT does not take, as clang has it.  The encoder
// checks the rest.  Reports whether baseMnem is one (it is then assembled, or the error set).
func parseArm32LoadStore(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		rt int) bool {
	var kind int = arm32MemKind(baseMnem)
	if kind == 0 { return false }
	if tok.Kind != TOK_COMMA {
		setErr(p, "too few operands for instruction")
		return true
	}
	l, tok = LexNext(l)
	if kind == memLdr && tok.Kind == TOK_EQUALS {
		parseArm32PoolLoad(p, l, tok, cond, rt)
		return true
	}
	var unpriv bool = kind >= memLdrt
	var op arm32.Operand
	if tok.Kind == TOK_LBRACKET {
		var bare bool
		// A halfword T form's post-index takes `$4` as a name, as clang has it.
		l, tok, op, bare = parseArm32MemOperand(p, l, arm32MemHalf(kind) && !unpriv)
		if unpriv && bare {
			if kind == memStrht {
				setErr(p, "too few operands for instruction")
				return true
			}
			op = arm32.MemPost(op.Reg, 0)
		}
	} else if unpriv {
		setErr(p, "invalid operand for instruction")
		return true
	} else {
		l, tok, op = parseArm32MemTarget(p, l, tok)
	}
	if !arm32AtEOL(p, tok) { return true }
	var a @asm.Assembler = p.Asm
	if kind == memLdr { arm32.Ldr(a, cond, rt, op) }
	if kind == memStr { arm32.Str(a, cond, rt, op) }
	if kind == memLdrb { arm32.Ldrb(a, cond, rt, op) }
	if kind == memStrb { arm32.Strb(a, cond, rt, op) }
	if kind == memLdrh { arm32.Ldrh(a, cond, rt, op) }
	if kind == memStrh { arm32.Strh(a, cond, rt, op) }
	if kind == memLdrsb { arm32.Ldrsb(a, cond, rt, op) }
	if kind == memLdrsh { arm32.Ldrsh(a, cond, rt, op) }
	if kind == memLdrt { arm32.Ldrt(a, cond, rt, op) }
	if kind == memStrt { arm32.Strt(a, cond, rt, op) }
	if kind == memLdrbt { arm32.Ldrbt(a, cond, rt, op) }
	if kind == memStrbt { arm32.Strbt(a, cond, rt, op) }
	if kind == memLdrht { arm32.Ldrht(a, cond, rt, op) }
	if kind == memStrht { arm32.Strht(a, cond, rt, op) }
	if kind == memLdrsbt { arm32.Ldrsbt(a, cond, rt, op) }
	if kind == memLdrsht { arm32.Ldrsht(a, cond, rt, op) }
	return true
}

// parseArm32MemTarget parses a load's or store's PC-relative target starting at tok, as clang
// takes it: a label{+addend} or a location relative to `.` (`.+8`, `(.-4)`, `8+.`: the address that
// many bytes from this instruction), after `#` or `$` or neither -- without them, not starting with
// `-`, `+` or `~`, which clang's general operand parser rejects.  A number (an absolute address), a
// label difference and an unprefixed register are no target.
func parseArm32MemTarget(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32.Operand) {
	if tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR {
		// After the prefix a register's name is a symbol's (`ldr r0, #r1`), as clang reads it.
		l, tok = LexNext(l)
	} else if arm32SignedStart(tok) {
		setErr(p, "unexpected token in operand")
		return l, tok, arm32.Imm(0)
	} else if tok.Kind == TOK_IDENT && parseArm32Reg(tok.Text) >= 0 {
		setErr(p, "invalid operand for instruction")
		return l, tok, arm32.Imm(0)
	}
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid load / store target"))
		return l, tok, arm32.Imm(0)
	}
	if len(r.Sym) == 0 && !r.Dot {
		setErr(p, "expected a label or '.' as a load / store target")
		return l, tok, arm32.Imm(0)
	}
	if r.Dot {
		// PC reads this instruction + 8.
		if !intFits(r.Val - 8) {
			setErr(p, "load / store target out of range")
			return l, tok, arm32.Imm(0)
		}
		return l, tok, arm32.MemImm(arm32.PC, cast(int, r.Val - 8))
	}
	if !intFits(r.Val) {
		setErr(p, "label addend out of range")
		return l, tok, arm32.Imm(0)
	}
	return l, tok, arm32.LabelAddend(r.Sym, cast(int, r.Val))
}

// arm32MemOffsetStart reports whether tok starts a memory operand's offset written without `#`
// or `$` (`[r1, 4]`, `[r1], 4`), as clang takes it: a number, `(`, a character or a constant's
// name -- not a sign, which starts a register index (`[r1, -r2]`) or nothing clang takes.
func arm32MemOffsetStart(p @Parser, tok Token) bool {
	if tok.Kind == TOK_INT || tok.Kind == TOK_LPAREN || tok.Kind == TOK_CHAR { return true }
	return tok.Kind == TOK_IDENT && arm32NamesNumber(p, tok.Text)
}

// parseArm32MemOffset parses a memory operand's immediate offset from tok -- `#` or `$` (with
// names, `$4` as `$` and 4) and a constant, or a constant alone (arm32MemOffsetStart) -- into the
// offset and whether it is clang's negative zero (`#-0`, `#-1+1`: subtracted, arm32.SubIndex),
// or ok false with p's error set.  A label difference is an offset only where diffOk.
func parseArm32MemOffset(p @Parser, l Lexer, tok Token, names bool,
		diffOk bool) (Lexer, Token, int, bool, bool) {
	var negative bool = arm32PrefixedMinus(l, tok)
	var offL Lexer
	var prefixed bool
	offL, prefixed = arm32ImmPrefix(l, tok, names)
	if prefixed { l, tok = LexNext(offL) }
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid memory offset"))
		return l, tok, 0, false, false
	}
	if r.FromDiff && !diffOk {
		// clang wants a constant here, not one a label difference decides.
		setErr(p, "constant expression expected")
		return l, tok, 0, false, false
	}
	var off int
	var fits bool
	off, fits = arm32IntOf(p, r.Val, "memory offset")
	if !fits { return l, tok, 0, false, false }
	return l, tok, off, negative && off == 0 && !r.FromDiff, true
}

// arm32MemSub returns the memory operand op, its offset subtracted (arm32.SubIndex) when sub.
func arm32MemSub(op arm32.Operand, sub bool) arm32.Operand {
	if sub { return arm32.SubIndex(op) }
	return op
}

// parseArm32MemOperand parses a memory operand, the lexer just past its `[`:
//
//	[Rn]            [Rn]!           [Rn, #±imm]         [Rn, #±imm]!
//	[Rn, ±Rm]       [Rn, ±Rm]!      [Rn, ±Rm, shift]    [Rn, ±Rm, shift]!
//	[Rn], #±imm     [Rn], ±Rm       [Rn], ±Rm, shift
//
// where shift is `lsl` / `lsr` / `asr` / `ror` `#amount` or `rrx`, a `-` before Rm subtracts the
// index from the base (arm32.SubIndex), and an immediate is parseArm32MemOffset's.  half marks a
// halfword or signed-byte load or store, whose post-index reads `$4` as `$` and 4 and whose
// offset is no label difference (a word's or byte's is, pre-indexed), as clang has them.  bare
// reports a plain `[Rn]`.
func parseArm32MemOperand(p @Parser, l Lexer, half bool) (Lexer, Token, arm32.Operand, bool) {
	var tok Token
	l, tok = LexNext(l) // the base register
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected register in memory operand")
		return l, tok, arm32.Imm(0), false
	}
	var baseReg int = parseArm32Reg(tok.Text)
	if baseReg < 0 {
		setErr(p, "invalid base register")
		return l, tok, arm32.Imm(0), false
	}
	l, tok = LexNext(l)

	var off int
	var sub bool
	var ok bool
	if tok.Kind == TOK_RBRACKET {
		l, tok = LexNext(l)
		if tok.Kind == TOK_BANG {
			// [Rn]! -- writeback of a zero offset.
			l, tok = LexNext(l)
			return l, tok, arm32.MemPre(baseReg, 0), false
		}
		if tok.Kind != TOK_COMMA { return l, tok, arm32.MemImm(baseReg, 0), true }
		// Post-indexed: [Rn], #imm or [Rn], ±Rm[, shift].
		l, tok = LexNext(l)
		var postL Lexer
		var postPrefixed bool
		postL, postPrefixed = arm32ImmPrefix(l, tok, half)
		if postPrefixed || arm32MemOffsetStart(p, tok) {
			l, tok, off, sub, ok = parseArm32MemOffset(p, l, tok, half, false)
			if !ok { return l, tok, arm32.Imm(0), false }
			return l, tok, arm32MemSub(arm32.MemPost(baseReg, off), sub), false
		}
		var idx arm32MemIndex
		l, tok, idx = parseArm32MemIndex(p, l, tok)
		if !idx.ok {
			setErr(p, "expected a #imm or register post-index after '],'")
			return l, tok, arm32.Imm(0), false
		}
		if idx.shifted {
			return l, tok, idx.sub(arm32.MemPostSReg(baseReg, idx.reg, idx.shift, idx.amount)), false
		}
		return l, tok, idx.sub(arm32.MemPostReg(baseReg, idx.reg)), false
	}

	if tok.Kind != TOK_COMMA {
		setErr(p, "invalid memory operand")
		return l, tok, arm32.Imm(0), false
	}
	l, tok = LexNext(l)
	var offL Lexer
	var offPrefixed bool
	offL, offPrefixed = arm32ImmPrefix(l, tok, true)
	if offPrefixed || arm32MemOffsetStart(p, tok) {
		// [Rn, #imm] or [Rn, #imm]! (`$` for `#`, as clang takes it here)
		l, tok, off, sub, ok = parseArm32MemOffset(p, l, tok, true, !half)
		if !ok { return l, tok, arm32.Imm(0), false }
		if tok.Kind != TOK_RBRACKET {
			setErr(p, "expected ']' to close the memory operand")
			return l, tok, arm32.Imm(0), false
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_BANG {
			l, tok = LexNext(l)
			return l, tok, arm32MemSub(arm32.MemPre(baseReg, off), sub), false
		}
		return l, tok, arm32MemSub(arm32.MemImm(baseReg, off), sub), false
	}
	// [Rn, ±Rm[, shift]] or the same with `!`.
	var idx arm32MemIndex
	l, tok, idx = parseArm32MemIndex(p, l, tok)
	if !idx.ok || tok.Kind != TOK_RBRACKET {
		setErr(p, "invalid memory operand")
		return l, tok, arm32.Imm(0), false
	}
	l, tok = LexNext(l)
	var pre bool = false
	if tok.Kind == TOK_BANG {
		pre = true
		l, tok = LexNext(l)
	}
	if idx.shifted {
		if pre {
			return l, tok, idx.sub(arm32.MemPreSReg(baseReg, idx.reg, idx.shift, idx.amount)), false
		}
		return l, tok, idx.sub(arm32.MemSReg(baseReg, idx.reg, idx.shift, idx.amount)), false
	}
	if pre { return l, tok, idx.sub(arm32.MemPreReg(baseReg, idx.reg)), false }
	return l, tok, idx.sub(arm32.MemReg(baseReg, idx.reg)), false
}

// arm32MemIndex is a memory operand's register index: `±Rm`, optionally with a
// shift (`, lsl #2`, `, rrx`).
type arm32MemIndex struct {
	ok      bool
	reg     int
	negated bool
	shifted bool
	shift   int
	amount  int
}

// sub returns op with the index subtracted when the index was written `-Rm`.
func (idx arm32MemIndex) sub(op arm32.Operand) arm32.Operand {
	if idx.negated { return arm32.SubIndex(op) }
	return op
}

// parseArm32MemIndex parses a register index starting at tok: an optional `+`
// or `-`, the register, and an optional `, shift #amount` or `, rrx`.  ok is
// false when tok does not start one; a malformed shift is reported.
func parseArm32MemIndex(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32MemIndex) {
	var idx arm32MemIndex
	if tok.Kind == TOK_MINUS || tok.Kind == TOK_PLUS {
		idx.negated = tok.Kind == TOK_MINUS
		l, tok = LexNext(l)
	}
	if tok.Kind != TOK_IDENT { return l, tok, idx }
	idx.reg = parseArm32Reg(tok.Text)
	if idx.reg < 0 { return l, tok, idx }
	idx.ok = true
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA { return l, tok, idx }
	// A comma followed by a shift name; anything else is left for the caller.
	var l2 Lexer = l
	var tok2 Token
	l2, tok2 = LexNext(l2)
	if tok2.Kind != TOK_IDENT { return l, tok, idx }
	var sk int = parseArm32ShiftKind(tok2.Text)
	if sk < 0 { return l, tok, idx }
	if !arm32OneCase(tok2.Text) {
		// clang takes a memory operand's shift name in lower or upper case only.
		setErr(p, "illegal shift operator")
		idx.ok = false
		return l2, tok2, idx
	}
	idx.shifted = true
	idx.shift = sk
	l2, tok2 = LexNext(l2)
	if sk == arm32.RRX { return l2, tok2, idx }
	var amtL Lexer
	var prefixed bool
	amtL, prefixed = arm32ImmPrefix(l2, tok2, true)
	if !prefixed {
		setErr(p, "expected '#' and a shift amount")
		idx.ok = false
		return l2, tok2, idx
	}
	l2, tok2 = LexNext(amtL)
	var amt ExprResult
	l2, tok2, amt = ParseExpr(p, l2, tok2)
	if !amt.Ok {
		setErr(p, exprErr(amt, "invalid shift amount"))
		idx.ok = false
		return l2, tok2, idx
	}
	if amt.FromDiff {
		// clang wants a constant here, not one a label difference decides.
		setErr(p, "shift amount must be an immediate")
		idx.ok = false
		return l2, tok2, idx
	}
	var fits bool
	idx.amount, fits = arm32IntOf(p, amt.Val, "shift amount")
	if !fits { idx.ok = false }
	return l2, tok2, idx
}
