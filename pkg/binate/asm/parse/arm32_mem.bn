package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"

// parseArm32MemOperand parses a memory operand, the lexer just past its `[`:
//
//	[Rn]            [Rn]!           [Rn, #±imm]         [Rn, #±imm]!
//	[Rn, ±Rm]       [Rn, ±Rm]!      [Rn, ±Rm, shift]    [Rn, ±Rm, shift]!
//	[Rn], #±imm     [Rn], ±Rm       [Rn], ±Rm, shift
//
// where shift is `lsl` / `lsr` / `asr` / `ror` `#amount` or `rrx`, and a `-`
// before Rm subtracts the index from the base (arm32.SubIndex).
func parseArm32MemOperand(p @Parser, l Lexer) (Lexer, Token, arm32.Operand) {
	var tok Token
	l, tok = LexNext(l) // the base register
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected register in memory operand")
		return l, tok, arm32.Imm(0)
	}
	var baseReg int = parseArm32Reg(tok.Text)
	if baseReg < 0 {
		setErr(p, "invalid base register")
		return l, tok, arm32.Imm(0)
	}
	l, tok = LexNext(l)

	if tok.Kind == TOK_RBRACKET {
		l, tok = LexNext(l)
		if tok.Kind == TOK_BANG {
			// [Rn]! -- writeback of a zero offset.
			l, tok = LexNext(l)
			return l, tok, arm32.MemPre(baseReg, 0)
		}
		if tok.Kind != TOK_COMMA {
			return l, tok, arm32.MemImm(baseReg, 0)
		}
		// Post-indexed: [Rn], #imm or [Rn], ±Rm[, shift].
		l, tok = LexNext(l)
		if tok.Kind == TOK_HASH {
			var op arm32.Operand
			l, tok, op = parseArm32Imm(p, l)
			return l, tok, arm32.MemPost(baseReg, op.Imm)
		}
		var idx arm32MemIndex
		l, tok, idx = parseArm32MemIndex(p, l, tok)
		if !idx.ok {
			setErr(p, "expected a #imm or register post-index after '],'")
			return l, tok, arm32.Imm(0)
		}
		if idx.shifted {
			return l, tok, idx.sub(arm32.MemPostSReg(baseReg, idx.reg, idx.shift, idx.amount))
		}
		return l, tok, idx.sub(arm32.MemPostReg(baseReg, idx.reg))
	}

	if tok.Kind != TOK_COMMA {
		setErr(p, "invalid memory operand")
		return l, tok, arm32.Imm(0)
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_HASH {
		// [Rn, #imm] or [Rn, #imm]!
		var op arm32.Operand
		l, tok, op = parseArm32Imm(p, l)
		if tok.Kind != TOK_RBRACKET {
			setErr(p, "expected ']' to close the memory operand")
			return l, tok, arm32.Imm(0)
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_BANG {
			l, tok = LexNext(l)
			return l, tok, arm32.MemPre(baseReg, op.Imm)
		}
		return l, tok, arm32.MemImm(baseReg, op.Imm)
	}
	// [Rn, ±Rm[, shift]] or the same with `!`.
	var idx arm32MemIndex
	l, tok, idx = parseArm32MemIndex(p, l, tok)
	if !idx.ok || tok.Kind != TOK_RBRACKET {
		setErr(p, "invalid memory operand")
		return l, tok, arm32.Imm(0)
	}
	l, tok = LexNext(l)
	var pre bool = false
	if tok.Kind == TOK_BANG {
		pre = true
		l, tok = LexNext(l)
	}
	if idx.shifted {
		if pre { return l, tok, idx.sub(arm32.MemPreSReg(baseReg, idx.reg, idx.shift, idx.amount)) }
		return l, tok, idx.sub(arm32.MemSReg(baseReg, idx.reg, idx.shift, idx.amount))
	}
	if pre { return l, tok, idx.sub(arm32.MemPreReg(baseReg, idx.reg)) }
	return l, tok, idx.sub(arm32.MemReg(baseReg, idx.reg))
}

// arm32MemIndex is a memory operand's register index: `±Rm`, optionally with a
// shift (`, lsl #2`, `, rrx`).
type arm32MemIndex struct {
	ok      bool
	reg     int
	negated bool
	shifted bool
	shift   int
	amount  int
}

// sub returns op with the index subtracted when the index was written `-Rm`.
func (idx arm32MemIndex) sub(op arm32.Operand) arm32.Operand {
	if idx.negated { return arm32.SubIndex(op) }
	return op
}

// parseArm32MemIndex parses a register index starting at tok: an optional `+`
// or `-`, the register, and an optional `, shift #amount` or `, rrx`.  ok is
// false when tok does not start one; a malformed shift is reported.
func parseArm32MemIndex(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32MemIndex) {
	var idx arm32MemIndex
	if tok.Kind == TOK_MINUS || tok.Kind == TOK_PLUS {
		idx.negated = tok.Kind == TOK_MINUS
		l, tok = LexNext(l)
	}
	if tok.Kind != TOK_IDENT { return l, tok, idx }
	idx.reg = parseArm32Reg(tok.Text)
	if idx.reg < 0 { return l, tok, idx }
	idx.ok = true
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA { return l, tok, idx }
	// A comma followed by a shift name; anything else is left for the caller.
	var l2 Lexer = l
	var tok2 Token
	l2, tok2 = LexNext(l2)
	if tok2.Kind != TOK_IDENT { return l, tok, idx }
	var sk int = parseArm32ShiftKind(tok2.Text)
	if sk < 0 { return l, tok, idx }
	idx.shifted = true
	idx.shift = sk
	l2, tok2 = LexNext(l2)
	if sk == arm32.RRX { return l2, tok2, idx }
	if tok2.Kind != TOK_HASH {
		setErr(p, "expected '#' and a shift amount")
		idx.ok = false
		return l2, tok2, idx
	}
	l2, tok2 = LexNext(l2)
	var amt ExprResult
	l2, tok2, amt = ParseExpr(p, l2, tok2)
	if !amt.Ok {
		setErr(p, exprErr(amt, "invalid shift amount"))
		idx.ok = false
		return l2, tok2, idx
	}
	var fits bool
	idx.amount, fits = arm32IntOf(p, amt.Val, "shift amount")
	if !fits { idx.ok = false }
	return l2, tok2, idx
}
