package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Memory operands, each line's word as clang assembles it (`clang -target
// armv7a-none-eabi`): writeback of a zero offset, a subtracted register index,
// a shifted index pre- and post-indexed, and `rrx`.

// arm32MemGolden pairs an instruction with clang's encoding of it.
type arm32MemGolden struct {
	line *[]readonly char
	word uint32
}

// arm32MemGoldens returns the memory-operand forms and their encodings.
func arm32MemGoldens() @[]arm32MemGolden {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 22)
	g[0] = arm32MemGolden{line: "ldr r0, [r1]!", word: 0xE5B10000}
	g[1] = arm32MemGolden{line: "ldr r0, [r1, r2, lsl #2]!", word: 0xE7B10102}
	g[2] = arm32MemGolden{line: "ldr r0, [r1], r2, lsl #2", word: 0xE6910102}
	g[3] = arm32MemGolden{line: "ldr r0, [r1], -r2", word: 0xE6110002}
	g[4] = arm32MemGolden{line: "ldr r0, [r1, -r2]", word: 0xE7110002}
	g[5] = arm32MemGolden{line: "ldr r0, [r1, -r2]!", word: 0xE7310002}
	g[6] = arm32MemGolden{line: "ldr r0, [r1, -r2, lsl #3]", word: 0xE7110182}
	g[7] = arm32MemGolden{line: "ldr r0, [r1, r2, rrx]", word: 0xE7910062}
	g[8] = arm32MemGolden{line: "ldr r0, [r1], r2, rrx", word: 0xE6910062}
	g[9] = arm32MemGolden{line: "str r0, [r1, -r2, asr #5]!", word: 0xE72102C2}
	g[10] = arm32MemGolden{line: "ldrh r0, [r1, -r2]", word: 0xE11100B2}
	g[11] = arm32MemGolden{line: "ldrh r0, [r1], -r2", word: 0xE01100B2}
	g[12] = arm32MemGolden{line: "ldrh r0, [r1]!", word: 0xE1F100B0}
	g[13] = arm32MemGolden{line: "ldr r0, [r1, +r2]", word: 0xE7910002}
	g[14] = arm32MemGolden{line: "ldr r0, [r1, r2, lsr #32]", word: 0xE7910022}
	g[15] = arm32MemGolden{line: "ldrb r0, [r1, -r2, lsl #1]!", word: 0xE7710082}
	g[16] = arm32MemGolden{line: "strb r3, [r4], -r5, ror #7", word: 0xE64433E5}
	g[17] = arm32MemGolden{line: "ldr r0, [r1], #-4", word: 0xE4110004}
	g[18] = arm32MemGolden{line: "ldrh r0, [r1, -r2]!", word: 0xE13100B2}
	g[19] = arm32MemGolden{line: "strh r0, [r1], r2", word: 0xE08100B2}
	g[20] = arm32MemGolden{line: "ldrsb r0, [r1, -r2]", word: 0xE11100D2}
	g[21] = arm32MemGolden{line: "ldr r0, [r1, r2, ror #0]", word: 0xE7910002}
	return g
}

func TestParseArm32MemOperandForms() testing.TestResult {
	var g @[]arm32MemGolden = arm32MemGoldens()
	for i := 0; i < len(g); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(g[i].line)
		if p.HasError { return fail(buf.Concat(g[i].line, buf.Concat(": ", p.ErrorMsg))) }
		if readWord(a.Sections[0], 0) != g[i].word {
			return fail(buf.Concat(g[i].line, ": encoded differently from clang"))
		}
	}
	return ""
}

// A pre-indexed offset and a shift amount take `$` for `#` (a word's or byte's post-indexed offset
// does not; a halfword's reads `$4` as `$` and 4), and a shift name is all lower or all upper
// case, as clang has them.
func TestParseArm32MemOperandSpelling() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldr r0, [r1, $4]", "E5910004")
	e = armGateIs(e, "", "ldr r0, [r1, $-4]", "E5110004")
	e = armGateIs(e, "", "ldr r0, [r1, r2, lsl $2]", "E7910102")
	e = armGateIs(e, "", "ldr r0, [r1, r2, LSL #2]", "E7910102")
	e = armGateIs(e, "", "ldr r0, [r1, r2, Lsl #2]", "!illegal shift operator")
	e = armGateIs(e, "", "ldr r0, [r1], $4", "!expected a #imm or register post-index after '],'")
	e = armGateIs(e, "", "ldrh r0, [r1], $4", "E0D100B4")
	if len(e) > 0 { return fail(e) }
	return ""
}

// Forms clang rejects are errors: a shift amount out of its range, and a shift
// on a halfword / signed-byte access, which has no shifted-index form.
func TestParseArm32MemOperandRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 3)
	bad[0] = "ldr r0, [r1, r2, lsl #32]"
	bad[1] = "ldrh r0, [r1, r2, lsl #1]"
	bad[2] = "ldr r0, [r1, r2, rrx #1]"
	for i := 0; i < len(bad); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(bad[i])
		if !p.HasError && !a.HasError { return fail(buf.Concat(bad[i], ": accepted")) }
	}
	return ""
}

// The loads and stores as clang takes them, with its words: an offset without `#` (`[r1, 4]`,
// `[r1], 4`); clang's negative zero (`#-0`, `$-0`, `#-1+1`, `#-K` with K 0) subtracted, the U bit
// clear; `#` before a PC-relative target (`ldr r0, #lbl`, `ldrh r0, #.-8`), or none before one
// starting with `(` or a number (`ldr r0, (.+8)`, `ldrb r0, 4+.`); a word's pre-indexed
// offset as a label difference; the T forms, `[Rn]` as the post-index by 0, Rt the base, PC as
// LDRBT's Rt; LDRB's PC as Rt writing its base back.
func TestArm32LoadStoreForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldr r0, [r1, #-0]", "E5110000")
	e = armGateIs(e, "", "ldrb r0, [r1], #-1+1", "E4510000")
	e = armGateIs(e, "", "ldrsh r0, [r1, $-0]", "E15100F0")
	e = armGateIs(e, "K = 0", "ldr r0, [r1, #-K]", "E5110000")
	e = armGateIs(e, "", "ldr r0, [r1, 4]", "E5910004")
	e = armGateIs(e, "", "ldr r0, [r1], 4", "E4910004")
	e = armGateIs(e, "", "ldr r0, [r1, (4)]!", "E5B10004")
	e = arm32SrcWordIs(e, "lbl: nop\nldr r0, #lbl", 4, 0xE51F000C)
	e = arm32SrcWordIs(e, "ldrsb r0, #fwd\nfwd: nop", 0, 0xE15F00D4)
	e = armGateIs(e, "", "ldr r0, (.+8)", "E59F0000")
	e = armGateIs(e, "", "ldrb r0, 4+.", "E55F0004")
	e = armGateIs(e, "", "ldrh r0, (.-4)", "E15F00BC")
	e = armGateIs(e, "", "ldrsh r0, (.)", "E15F00F8")
	e = armGateIs(e, "", "ldrh r0, #.-8", "E15F01B0")
	e = armGateIs(e, "", ".La: nop\n.Lb: ldr r0, [r1, #.Lb-.La]", "E320F000 E5910004")
	e = armGateIs(e, "", "ldrt r0, [r1]", "E4B10000")
	e = armGateIs(e, "", "ldrht r0, [r1]", "E0F100B0")
	e = armGateIs(e, "", "ldrt r1, [r1], #4", "E4B11004")
	e = armGateIs(e, "", "ldrteq r0, [r1], #4", "04B10004")
	e = armGateIs(e, "", "ldrbt pc, [r1], r3, lsl #2", "E6F1F103")
	e = armGateIs(e, "", "strht r0, [r1], #4", "E0E100B4")
	e = armGateIs(e, "", "ldrsbt sp, [r1], r3", "E0B1D0D3")
	e = armGateIs(e, "", "ldrsht r0, [r1], #-0", "E07100F0")
	e = armGateIs(e, "", "ldrb pc, [r1], #4", "E4D1F004")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The loads and stores clang rejects: a form writing its base back with Rt as the base (not a T
// form), LDRB's PC as Rt in a form that does not, STRHT's `[Rn]` and `], $4`, a T form's offset or
// pre-indexed operand or label, a label difference as a halfword's offset or a post-index or an
// index's shift, a number, a register or a target starting with `+` / `~` without `#`, PC as a
// halfword T load's Rt with a register index, a shifted halfword index.
func TestArm32LoadStoreRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldr r1, [r1, #4]!",
			"!destination register and base register can't be identical")
	e = armGateIs(e, "", "str r1, [r1], #4", "!source register and base register can't be identical")
	e = armGateIs(e, "", "ldrb pc, [r1]", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "strht r0, [r1]", "!too few operands for instruction")
	e = armGateIs(e, "", "strht r0, [r1], $4", "!expected a #imm or register post-index")
	e = armGateIs(e, "", "ldrt r0, [r1, #4]", "!take a post-indexed operand")
	e = armGateIs(e, "", "ldrt r0, lbl\nlbl: nop", "!invalid operand for instruction")
	e = armGateIs(e, "", ".La: nop\n.Lb: ldrh r0, [r1, #.Lb-.La]", "!constant expression expected")
	e = armGateIs(e, "", ".La: nop\n.Lb: ldr r0, [r1], #.Lb-.La", "!constant expression expected")
	e = armGateIs(e, "", "ldr r0, #4", "!expected a label")
	e = armGateIs(e, "", "ldr r0, +lbl\nlbl: nop", "!unexpected token in operand")
	e = armGateIs(e, "", "ldr r0, ~0+lbl\nlbl: nop", "!unexpected token in operand")
	e = armGateIs(e, "", "ldr r0, r1", "!invalid operand for instruction")
	e = armGateIs(e, "", ".La: nop\n.Lb: ldr r0, [r1, r2, lsl #.Lb-.La]",
			"!shift amount must be an immediate")
	e = armGateIs(e, "", "ldrht pc, [r1], r3", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "ldrsbt r0, [r1], r2, lsl #1", "!(no shift)")
	if len(e) > 0 { return fail(e) }
	return ""
}
