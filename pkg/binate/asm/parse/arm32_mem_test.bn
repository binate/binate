package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Memory operands, each line's word as clang assembles it (`clang -target
// armv7a-none-eabi`): writeback of a zero offset, a subtracted register index,
// a shifted index pre- and post-indexed, and `rrx`.

// arm32MemGolden pairs an instruction with clang's encoding of it.
type arm32MemGolden struct {
	line *[]readonly char
	word uint32
}

// arm32MemGoldens returns the memory-operand forms and their encodings.
func arm32MemGoldens() @[]arm32MemGolden {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 22)
	g[0] = arm32MemGolden{line: "ldr r0, [r1]!", word: 0xE5B10000}
	g[1] = arm32MemGolden{line: "ldr r0, [r1, r2, lsl #2]!", word: 0xE7B10102}
	g[2] = arm32MemGolden{line: "ldr r0, [r1], r2, lsl #2", word: 0xE6910102}
	g[3] = arm32MemGolden{line: "ldr r0, [r1], -r2", word: 0xE6110002}
	g[4] = arm32MemGolden{line: "ldr r0, [r1, -r2]", word: 0xE7110002}
	g[5] = arm32MemGolden{line: "ldr r0, [r1, -r2]!", word: 0xE7310002}
	g[6] = arm32MemGolden{line: "ldr r0, [r1, -r2, lsl #3]", word: 0xE7110182}
	g[7] = arm32MemGolden{line: "ldr r0, [r1, r2, rrx]", word: 0xE7910062}
	g[8] = arm32MemGolden{line: "ldr r0, [r1], r2, rrx", word: 0xE6910062}
	g[9] = arm32MemGolden{line: "str r0, [r1, -r2, asr #5]!", word: 0xE72102C2}
	g[10] = arm32MemGolden{line: "ldrh r0, [r1, -r2]", word: 0xE11100B2}
	g[11] = arm32MemGolden{line: "ldrh r0, [r1], -r2", word: 0xE01100B2}
	g[12] = arm32MemGolden{line: "ldrh r0, [r1]!", word: 0xE1F100B0}
	g[13] = arm32MemGolden{line: "ldr r0, [r1, +r2]", word: 0xE7910002}
	g[14] = arm32MemGolden{line: "ldr r0, [r1, r2, lsr #32]", word: 0xE7910022}
	g[15] = arm32MemGolden{line: "ldrb r0, [r1, -r2, lsl #1]!", word: 0xE7710082}
	g[16] = arm32MemGolden{line: "strb r3, [r4], -r5, ror #7", word: 0xE64433E5}
	g[17] = arm32MemGolden{line: "ldr r0, [r1], #-4", word: 0xE4110004}
	g[18] = arm32MemGolden{line: "ldrh r0, [r1, -r2]!", word: 0xE13100B2}
	g[19] = arm32MemGolden{line: "strh r0, [r1], r2", word: 0xE08100B2}
	g[20] = arm32MemGolden{line: "ldrsb r0, [r1, -r2]", word: 0xE11100D2}
	g[21] = arm32MemGolden{line: "ldr r0, [r1, r2, ror #0]", word: 0xE7910002}
	return g
}

func TestParseArm32MemOperandForms() testing.TestResult {
	var g @[]arm32MemGolden = arm32MemGoldens()
	for i := 0; i < len(g); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(g[i].line)
		if p.HasError { return fail(buf.Concat(g[i].line, buf.Concat(": ", p.ErrorMsg))) }
		if readWord(a.Sections[0], 0) != g[i].word {
			return fail(buf.Concat(g[i].line, ": encoded differently from clang"))
		}
	}
	return ""
}

// Forms clang rejects are errors: a shift amount out of its range, and a shift
// on a halfword / signed-byte access, which has no shifted-index form.
func TestParseArm32MemOperandRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 3)
	bad[0] = "ldr r0, [r1, r2, lsl #32]"
	bad[1] = "ldrh r0, [r1, r2, lsl #1]"
	bad[2] = "ldr r0, [r1, r2, rrx #1]"
	for i := 0; i < len(bad); i++ {
		var p @Parser
		var a @asm.Assembler
		p, a = newArm32Parser()
		p.ParseLine(bad[i])
		if !p.HasError && !a.HasError { return fail(buf.Concat(bad[i], ": accepted")) }
	}
	return ""
}
