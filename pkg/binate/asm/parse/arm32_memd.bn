package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// parseArm32Ldrd assembles LDRD / STRD from its operands after Rt (tok the token after it), as
// clang takes them: `Rt, Rt2, <mem>`, Rt2 Rt + 1 ("destination operands must be sequential",
// "source ..." for STRD; an odd Rt "Rt must be even-numbered"), or `Rt, [...]` with Rt + 1 implied
// for an Rt below R12 (R12 from ARMv8) and no register post-index; <mem> a memory operand with a
// halfword's spellings (parseArm32MemOperand) or a PC-relative target (parseArm32MemTarget).  The
// offset and PC-relative forms need ARMv5TE; clang gates no form writing its base back.  The
// encoder checks the rest.  Reports whether baseMnem is one (it is then assembled, or the error
// set).
func parseArm32Ldrd(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		rt int) bool {
	var load bool = mnemIs(baseMnem, "ldrd")
	if !load && !mnemIs(baseMnem, "strd") { return false }
	if tok.Kind != TOK_COMMA {
		setErr(p, "too few operands for instruction")
		return true
	}
	l, tok = LexNext(l)
	var one bool = !(tok.Kind == TOK_IDENT && parseArm32Reg(tok.Text) >= 0)
	if !one {
		var rt2 int = parseArm32Reg(tok.Text)
		if rt2 != rt + 1 {
			if rt % 2 != 0 {
				setErr(p, "Rt must be even-numbered")
			} else if load {
				setErr(p, "destination operands must be sequential")
			} else {
				setErr(p, "source operands must be sequential")
			}
			return true
		}
		l, tok = LexNext(l)
		if tok.Kind != TOK_COMMA {
			setErr(p, "too few operands for instruction")
			return true
		}
		l, tok = LexNext(l)
	} else if rt > arm32.IP || rt == arm32.IP && p.Arm32Feats & armV8 == 0 ||
			tok.Kind != TOK_LBRACKET {
		// clang takes the one-register form only before a memory operand, with Rt + 1 below SP
		// (SP itself from ARMv8).
		setErr(p, "invalid instruction")
		return true
	}
	var op arm32.Operand
	if tok.Kind == TOK_LBRACKET {
		// The one-register form's post-index reads `$4` as a name, a word's; neither takes a
		// label difference as an offset.
		l, tok, op, _ = parseArm32MemOperand(p, l, !one, false)
	} else {
		l, tok, op = parseArm32MemTarget(p, l, tok)
	}
	if !arm32AtEOL(p, tok) { return true }
	if one && op.Kind == arm32.OP_MEM_POST_REG {
		// clang's one-register form takes no register post-index.
		setErr(p, "invalid operand for instruction")
		return true
	}
	var writeback bool = op.Kind == arm32.OP_MEM_PRE || op.Kind == arm32.OP_MEM_POST ||
			op.Kind == arm32.OP_MEM_PRE_REG || op.Kind == arm32.OP_MEM_POST_REG
	if !writeback && !armRequire(p, armV5TE, "armv5te") { return true }
	if load {
		arm32.Ldrd(p.Asm, cond, rt, op)
	} else {
		arm32.Strd(p.Asm, cond, rt, op)
	}
	return true
}

// parseArm32Preload assembles PLD, PLDW or PLI from its operand after the mnemonic (l just past
// it), as clang takes them: unconditional (`al` only), the operand a memory operand
// (parseArm32MemOperand) or a PC-relative target (parseArm32MemTarget); PLI needs ARMv7, PLDW the
// multiprocessing extension.  The encoder checks the rest.  Reports whether baseMnem is one (it
// is then assembled, or the error set).
func parseArm32Preload(p @Parser, l Lexer, baseMnem *[]readonly char, cond int) bool {
	var pldw bool = mnemIs(baseMnem, "pldw")
	var pli bool = mnemIs(baseMnem, "pli")
	if !pldw && !pli && !mnemIs(baseMnem, "pld") { return false }
	if cond != arm32.COND_AL {
		var msg @[]char = buf.Concat("instruction '", baseMnem)
		setErr(p, buf.Concat(msg, "' is not predicable, but condition code specified"))
		return true
	}
	var tok Token
	l, tok = LexNext(l)
	var op arm32.Operand
	if tok.Kind == TOK_LBRACKET {
		l, tok, op, _ = parseArm32MemOperand(p, l, false, true)
	} else {
		l, tok, op = parseArm32MemTarget(p, l, tok)
	}
	if !arm32AtEOL(p, tok) { return true }
	var a @asm.Assembler = p.Asm
	if pli {
		if armRequire(p, armV7, "armv7") { arm32.Pli(a, op) }
	} else if pldw {
		if armRequire(p, armMP, "mp-extensions") { arm32.Pldw(a, op) }
	} else {
		arm32.Pld(a, op)
	}
	return true
}
