package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// LDRD / STRD and the preloads as clang takes them, with its words: a register pair or one
// register (Rt + 1 implied; R12 from ARMv8), R12 with SP; a halfword's offset spellings (`$8`
// post-indexed, an offset without `#`); PC-relative targets; PLD / PLDW / PLI with `al`, a
// shifted index, clang's negative zero; and the gates -- LDRD's offset forms from ARMv5TE (its
// writeback forms before, as clang takes them), PLI from ARMv7, PLDW with the multiprocessing
// extension, PLD always.  (armGateIs is in arm32_feat_test.bn.)
func TestArm32DoubleAndPreloadForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldrd r0, r1, [r4]", "E1C400D0")
	e = armGateIs(e, "", "ldrd r0, [r4]", "E1C400D0")
	e = armGateIs(e, "", "strd r12, sp, [r4]", "E1C4C0F0")
	e = armGateIs(e, "", "ldrd r0, r1, [r4, #-0]", "E14400D0")
	e = armGateIs(e, "", "strd r0, r1, [r4], $8", "E0C400F8")
	e = armGateIs(e, "", "ldrd r6, r7, [r4], $4", "E0C460D4")
	e = armGateIs(e, ".arch armv8-a", "ldrd r12, [r4]", "E1C4C0D0")
	e = armGateIs(e, "", "ldrd r0, r1, [r4, 8]", "E1C400D8")
	e = armGateIs(e, "", "ldrd r0, r1, [r4, r0]!", "E1A400D0")
	e = armGateIs(e, "", "strdhs r0, r1, [r4]", "21C400F0")
	e = armGateIs(e, "", "ldrd r0, r1, .+8", "E1CF00D0")
	e = arm32SrcWordIs(e, "lbl: nop\nldrd r0, r1, #lbl", 4, 0xE14F00DC)
	e = armGateIs(e, "", "pld [r1, -r2, lsl #2]", "F751F102")
	e = armGateIs(e, "", "pldw [r1, #-0]", "F511F000")
	e = armGateIs(e, "", "pli [r1, r2, rrx]", "F6D1F062")
	e = armGateIs(e, "", "pldal [r1]", "F5D1F000")
	e = armGateIs(e, "", "pld .+8", "F5DFF000")
	e = arm32SrcWordIs(e, "lbl: nop\npli lbl", 4, 0xF45FF00C)
	e = armGateIs(e, ".arch armv4", "ldrd r0, r1, [r4], #8", "E0C400D8")
	e = armGateIs(e, ".arch armv4", "ldrd r0, r1, [r4, #8]", "!instruction requires: armv5te")
	e = armGateIs(e, ".arch armv5te", "ldrd r0, r1, [r4, r5]", "E18400D5")
	e = armGateIs(e, ".arch armv4", "pld [r1]", "F5D1F000")
	e = armGateIs(e, ".arch armv6t2", "pli [r1]", "!instruction requires: armv7")
	e = armGateIs(e, ".arch armv7-a", "pldw [r1]", "!instruction requires: mp-extensions")
	e = armGateIs(e, ".arch armv7-a\n.arch_extension mp", "pldw [r1]", "F591F000")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The forms clang rejects: an odd Rt, a second register that is not Rt + 1, one register R12 or
// R14 or with a register post-index, a `$4` post-index (a name there) or a PC-relative target, a
// writeback with Rt or Rt + 1 as the base, a shifted index, a third register; a preload with a
// condition, writeback, a register or a number.
func TestArm32DoubleAndPreloadRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "ldrd r1, r2, [r4]", "!Rt must be even-numbered")
	e = armGateIs(e, "", "ldrd r0, r2, [r4]", "!destination operands must be sequential")
	e = armGateIs(e, "", "strd r0, r2, [r4]", "!source operands must be sequential")
	e = armGateIs(e, "", "ldrd r12, [r4]", "!invalid instruction")
	e = armGateIs(e, "", "strd r0, [r4], r5", "!invalid operand for instruction")
	e = armGateIs(e, "", "ldrd r6, [r4], $4", "!expected a #imm or register post-index")
	e = armGateIs(e, "", "lbl: nop\nldrd r0, lbl", "!invalid instruction")
	e = armGateIs(e, "", "strd r0, .+8", "!invalid instruction")
	e = armGateIs(e, "", "ldrd r0, r1, [r1], #8",
			"!base register needs to be different from destination registers")
	e = armGateIs(e, "", "strd r0, r1, [r0]!", "!source register and base register can't be identical")
	e = armGateIs(e, "", "ldrd r0, r1, [r4, r5, lsl #2]", "!(no shift)")
	e = armGateIs(e, "", "ldrd r0, r1, r2, [r4]", "!invalid operand for instruction")
	e = armGateIs(e, "", "pldeq [r1]",
			"!instruction 'pld' is not predicable, but condition code specified")
	e = armGateIs(e, "", "pli [r1], #4", "!take an offset form")
	e = armGateIs(e, "", "pldw [r1]!", "!take an offset form")
	e = armGateIs(e, "", "pld r1", "!invalid operand for instruction")
	e = armGateIs(e, "", "pld #4", "!expected a label")
	if len(e) > 0 { return fail(e) }
	return ""
}
