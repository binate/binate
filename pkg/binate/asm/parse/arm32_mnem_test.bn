package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Mnemonic splitting (splitMnem: base, condition, `s`), and the `s` suffix (set the flags)
// taken only by the data-processing instructions that write a register and the multiplies:
// on any other — a load / store, a compare, a branch, a MOVW — it is an error, as clang
// rejects it, not silently dropped.  (arm32Source is in arm32_pool_test.bn, sectionWordsHex
// in aarch64_pool_test.bn, plContains in parse_line_test.bn.)

// suffixReject checks that line is rejected with a diagnostic containing want.
func suffixReject(e @[]char, line *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = arm32Source(line)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = p.Asm.ErrorMsg }
	if !p.HasError && !p.Asm.HasError { return goldenFail(e, line, "accepted") }
	if !plContains(msg, want) { return goldenFail(e, line, buf.Concat("wrong diagnostic: ", msg)) }
	return e
}

func TestArm32SuffixS() testing.TestResult {
	var e @[]char = ""
	e = suffixReject(e, "ldrs r0, [r1]",
			"instruction 'ldr' can not set flags, but 's' suffix specified")
	e = suffixReject(e, "ldrsne r0, [r1]", "instruction 'ldr' can not set flags")
	e = suffixReject(e, "ldrs r0, =1", "instruction 'ldr' can not set flags")
	e = suffixReject(e, "strs r0, [r1]", "instruction 'str' can not set flags")
	e = suffixReject(e, "ldrbs r0, [r1]", "instruction 'ldrb' can not set flags")
	e = suffixReject(e, "pushs {r0}", "instruction 'push' can not set flags")
	e = suffixReject(e, "cmps r0, r1", "instruction 'cmp' can not set flags")
	e = suffixReject(e, "tsts r0, r1", "instruction 'tst' can not set flags")
	e = suffixReject(e, "movws r0, #1", "instruction 'movw' can not set flags")
	e = suffixReject(e, "bxs lr", "instruction 'bx' can not set flags")
	e = suffixReject(e, "bs .", "instruction 'b' can not set flags")
	e = suffixReject(e, "clzs r0, r1", "instruction 'clz' can not set flags")
	e = suffixReject(e, "nops", "instruction 'nop' can not set flags")
	var p @Parser = arm32Source(
			"movs r0, #1\nadds r0, r0, r1\nmuls r0, r1, r2\numulls r0, r1, r2, r3\nbls lbl\nlbl:")
	if p.HasError || p.Asm.HasError {
		return fail(buf.Concat("a flag-setting form refused: ", p.ErrorMsg))
	}
	var got @[]char = sectionWordsHex(p, 0)
	if !charsEqual(got, "E3B00001 E0900001 E0100291 E0910392 9AFFFFFF ") {
		return fail(buf.Concat("assembled to ", got))
	}
	return e
}

func TestSplitMnemSimple() testing.TestResult {
	var base *[]readonly char
	var cond int = 0
	var s bool = false
	base, cond, s = splitMnem("add")
	if !mnemIs(base, "add") || cond != arm32.COND_AL || s {
		return fail("add split wrong")
	}
	return ""
}

func TestSplitMnemCond() testing.TestResult {
	var base *[]readonly char
	var cond int = 0
	var s bool = false
	base, cond, s = splitMnem("addeq")
	if !mnemIs(base, "add") || cond != arm32.COND_EQ || s {
		return fail("addeq split wrong")
	}
	return ""
}

func TestSplitMnemS() testing.TestResult {
	var base *[]readonly char
	var cond int = 0
	var s bool = false
	base, cond, s = splitMnem("adds")
	if !mnemIs(base, "add") || cond != arm32.COND_AL || !s {
		return fail("adds split wrong")
	}
	return ""
}

func TestSplitMnemSCond() testing.TestResult {
	var base *[]readonly char
	var cond int = 0
	var s bool = false
	base, cond, s = splitMnem("addseq")
	if !mnemIs(base, "add") || cond != arm32.COND_EQ || !s {
		return fail("addseq split wrong")
	}
	return ""
}

