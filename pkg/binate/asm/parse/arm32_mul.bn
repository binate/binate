package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"

// The multiply and divide families arm32MulKind names: each mnemonic (or, for the halfword and
// suffixed forms, its family) as the parser dispatches it.
const (
	mulMul int = iota + 1
	mulMla
	mulMls
	mulUmull
	mulUmlal
	mulSmull
	mulSmlal
	mulUmaal
	mulSmlaXY
	mulSmlawY
	mulSmulwY
	mulSmlalXY
	mulSmulXY
	mulSmlad
	mulSmlsd
	mulSmuad
	mulSmusd
	mulSmlald
	mulSmlsld
	mulSmmla
	mulSmmls
	mulSmmul
	mulSdiv
	mulUdiv
)

// arm32MulKind returns the multiply or divide family name names (0 for none), with its halves --
// nTop for an `x` of `t` (Rn's top half), mTop for a `y` of `t` (Rm's) -- or its suffix in mTop
// (`x`: Rm's halves exchanged; `r`: rounded).
func arm32MulKind(name *[]readonly char) (int, bool, bool) {
	if mnemIs(name, "mul") { return mulMul, false, false }
	if mnemIs(name, "mla") { return mulMla, false, false }
	if mnemIs(name, "mls") { return mulMls, false, false }
	if mnemIs(name, "umull") { return mulUmull, false, false }
	if mnemIs(name, "umlal") { return mulUmlal, false, false }
	if mnemIs(name, "smull") { return mulSmull, false, false }
	if mnemIs(name, "smlal") { return mulSmlal, false, false }
	if mnemIs(name, "umaal") { return mulUmaal, false, false }
	if mnemIs(name, "sdiv") { return mulSdiv, false, false }
	if mnemIs(name, "udiv") { return mulUdiv, false, false }
	var kind int
	var suffix bool
	kind, suffix = arm32MulSuffixed(name)
	if kind != 0 { return kind, false, suffix }
	return arm32MulHalves(name)
}

// arm32MulSuffixed returns the dual and most-significant-word family name names, and whether it
// has its `x` or `r` suffix, or 0.
func arm32MulSuffixed(name *[]readonly char) (int, bool) {
	if len(name) == 0 { return 0, false }
	var base *[]readonly char = name
	var suffix bool = false
	var last char = arm32Lower(name[len(name) - 1])
	if len(name) == 6 && (last == 'x' || last == 'r') {
		base = name[0:5]
		suffix = true
	} else if len(name) == 7 && last == 'x' {
		base = name[0:6]
		suffix = true
	}
	if mnemIs(base, "smlad") && (!suffix || last == 'x') { return mulSmlad, suffix }
	if mnemIs(base, "smlsd") && (!suffix || last == 'x') { return mulSmlsd, suffix }
	if mnemIs(base, "smuad") && (!suffix || last == 'x') { return mulSmuad, suffix }
	if mnemIs(base, "smusd") && (!suffix || last == 'x') { return mulSmusd, suffix }
	if mnemIs(base, "smlald") { return mulSmlald, suffix }
	if mnemIs(base, "smlsld") { return mulSmlsld, suffix }
	if mnemIs(base, "smmla") && (!suffix || last == 'r') { return mulSmmla, suffix }
	if mnemIs(base, "smmls") && (!suffix || last == 'r') { return mulSmmls, suffix }
	if mnemIs(base, "smmul") && (!suffix || last == 'r') { return mulSmmul, suffix }
	return 0, false
}

// arm32MulHalves returns the halfword family name names (SMLA<x><y> .. SMULW<y>) and its halves,
// or 0.
func arm32MulHalves(name *[]readonly char) (int, bool, bool) {
	var n int = len(name)
	if n < 6 || !arm32HalfLetter(name[n - 1]) { return 0, false, false }
	var mTop bool = arm32Lower(name[n - 1]) == 't'
	var xTop bool = arm32Lower(name[n - 2]) == 't'
	if n == 7 && mnemIs(name[0:5], "smlal") && arm32HalfLetter(name[5]) {
		return mulSmlalXY, xTop, mTop
	}
	if n != 6 { return 0, false, false }
	if mnemIs(name[0:5], "smlaw") { return mulSmlawY, false, mTop }
	if mnemIs(name[0:5], "smulw") { return mulSmulwY, false, mTop }
	if !arm32HalfLetter(name[4]) { return 0, false, false }
	if mnemIs(name[0:4], "smla") { return mulSmlaXY, xTop, mTop }
	if mnemIs(name[0:4], "smul") { return mulSmulXY, xTop, mTop }
	return 0, false, false
}

// arm32HalfLetter reports whether c names a halfword: `b` (bottom) or `t` (top), in any case.
func arm32HalfLetter(c char) bool {
	var l char = arm32Lower(c)
	return l == 'b' || l == 't'
}

// arm32MulOperands returns the number of registers the family kind takes.
func arm32MulOperands(kind int) int {
	if kind == mulMul || kind == mulSmulwY || kind == mulSmulXY || kind == mulSmuad ||
			kind == mulSmusd || kind == mulSmmul || kind == mulSdiv || kind == mulUdiv {
		return 3
	}
	return 4
}

// arm32MulFeature returns the features the family kind needs and clang's name for them (0 for
// none).
func arm32MulFeature(kind int) (uint64, *[]readonly char) {
	if kind == mulMls { return armV6T2, "armv6t2" }
	if kind == mulSmlaXY || kind == mulSmlawY || kind == mulSmulwY || kind == mulSmlalXY ||
			kind == mulSmulXY {
		return armV5TE, "armv5te"
	}
	if kind == mulSdiv || kind == mulUdiv { return armHwDivArm, "divide in ARM" }
	if kind >= mulSmlad || kind == mulUmaal { return armV6, "armv6" }
	return 0, ""
}

// parseArm32Multiply assembles a multiply or divide (arm32MulKind) from its operands after Rd
// (tok the token after it), as clang takes them: its three or four registers -- MUL (from
// ARMv6), SDIV and UDIV also `Rd, Rm` for `Rd, Rd, Rm` -- each family gated by its architecture;
// the encoder checks the registers (PC where clang rejects it, a long multiply's RdLo and RdHi the
// same).  Reports whether baseMnem is one (it is then assembled, or the error set).
func parseArm32Multiply(p @Parser, l Lexer, tok Token, baseMnem *[]readonly char, cond int,
		setFlags bool, rd int) bool {
	var kind int
	var nTop bool
	var mTop bool
	kind, nTop, mTop = arm32MulKind(baseMnem)
	if kind == 0 { return false }
	var n int = arm32MulOperands(kind)
	var regs @[]int = make_slice(int, 4)
	regs[0] = rd
	var got int = 1
	for got < n && tok.Kind == TOK_COMMA {
		var r int
		l, tok, r = expectArm32CommaReg(p, l, tok)
		if p.HasError { return true }
		regs[got] = r
		got = got + 1
	}
	if tok.Kind == TOK_COMMA {
		setErr(p, "too many operands for instruction")
		return true
	}
	if !arm32AtEOL(p, tok) { return true }
	if got < n {
		if got != 2 || (kind != mulMul && kind != mulSdiv && kind != mulUdiv) {
			setErr(p, "too few operands for instruction")
			return true
		}
		// `mul Rd, Rm` is `mul Rd, Rd, Rm`, whose destination is also a factor, which ARMv6
		// first allows: clang takes the form from there.
		if kind == mulMul && !armRequire(p, armV6, "armv6") { return true }
		regs[2] = regs[1]
		regs[1] = rd
	}
	var feat uint64
	var featName *[]readonly char
	feat, featName = arm32MulFeature(kind)
	if feat != 0 && !armRequire(p, feat, featName) { return true }
	emitArm32Multiply(p, kind, cond, setFlags, regs, nTop, mTop)
	return true
}

// emitArm32Multiply emits the multiply or divide of family kind with the registers r (in the
// order the instruction lists them), S, halves and suffix as parseArm32Multiply read them.
func emitArm32Multiply(p @Parser, kind int, cond int, s bool, r @[]int, nTop bool, mTop bool) {
	var a @asm.Assembler = p.Asm
	if kind == mulMul { arm32.Mul(a, cond, s, r[0], r[1], r[2]) }
	if kind == mulMla { arm32.Mla(a, cond, s, r[0], r[1], r[2], r[3]) }
	if kind == mulMls { arm32.Mls(a, cond, r[0], r[1], r[2], r[3]) }
	if kind == mulUmull { arm32.Umull(a, cond, s, r[0], r[1], r[2], r[3]) }
	if kind == mulUmlal { arm32.Umlal(a, cond, s, r[0], r[1], r[2], r[3]) }
	if kind == mulSmull { arm32.Smull(a, cond, s, r[0], r[1], r[2], r[3]) }
	if kind == mulSmlal { arm32.Smlal(a, cond, s, r[0], r[1], r[2], r[3]) }
	if kind == mulUmaal { arm32.Umaal(a, cond, r[0], r[1], r[2], r[3]) }
	if kind == mulSmlaXY { arm32.SmlaXY(a, cond, r[0], r[1], r[2], r[3], nTop, mTop) }
	if kind == mulSmlawY { arm32.SmlawY(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmulwY { arm32.SmulwY(a, cond, r[0], r[1], r[2], mTop) }
	if kind == mulSmlalXY { arm32.SmlalXY(a, cond, r[0], r[1], r[2], r[3], nTop, mTop) }
	if kind == mulSmulXY { arm32.SmulXY(a, cond, r[0], r[1], r[2], nTop, mTop) }
	if kind == mulSmlad { arm32.Smlad(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmlsd { arm32.Smlsd(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmuad { arm32.Smuad(a, cond, r[0], r[1], r[2], mTop) }
	if kind == mulSmusd { arm32.Smusd(a, cond, r[0], r[1], r[2], mTop) }
	if kind == mulSmlald { arm32.Smlald(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmlsld { arm32.Smlsld(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmmla { arm32.Smmla(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmmls { arm32.Smmls(a, cond, r[0], r[1], r[2], r[3], mTop) }
	if kind == mulSmmul { arm32.Smmul(a, cond, r[0], r[1], r[2], mTop) }
	if kind == mulSdiv { arm32.Sdiv(a, cond, r[0], r[1], r[2]) }
	if kind == mulUdiv { arm32.Udiv(a, cond, r[0], r[1], r[2]) }
}
