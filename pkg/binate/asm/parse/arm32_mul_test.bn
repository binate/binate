package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The multiplies and divides as clang (Apple clang 21, armv7ve) takes them, with its words: each
// family, `Rd, Rm` for MUL, SDIV and UDIV, S and conditions; PC where clang takes it.
// (armGateIs is in arm32_feat_test.bn.)
func TestArm32MultiplyForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "mul r0, r1, r2", "E0000291")
	e = armGateIs(e, "", "mul r0, r1", "E0000190")
	e = armGateIs(e, "", "mulseq r0, r1, r2", "00100291")
	e = armGateIs(e, "", "mla r0, r1, r2, r3", "E0203291")
	e = armGateIs(e, "", "mls r0, r1, r2, r3", "E0603291")
	e = armGateIs(e, "", "sdiv r0, r1", "E710F110")
	e = armGateIs(e, "", "udiv pc, r1, r2", "E73FF211")
	e = armGateIs(e, "", "umull pc, r1, r2, r3", "E081F392")
	e = armGateIs(e, "", "umlal r0, r1, r2, r3", "E0A10392")
	e = armGateIs(e, "", "smlals r0, r1, r2, r3", "E0F10392")
	e = armGateIs(e, "", "umaal r0, r1, r2, r3", "E0410392")
	e = armGateIs(e, "", "smlatb r0, r1, r2, r3", "E10032A1")
	e = armGateIs(e, "", "smlabbeq r0, r1, r2, r3", "01003281")
	e = armGateIs(e, "", "smlawt r0, r1, r2, r3", "E12032C1")
	e = armGateIs(e, "", "smulwb r0, r1, r2", "E12002A1")
	e = armGateIs(e, "", "smlaltt r0, r1, r2, r3", "E14103E2")
	e = armGateIs(e, "", "smultb r0, r1, r2", "E16002A1")
	e = armGateIs(e, "", "smladx r0, r1, r2, r3", "E7003231")
	e = armGateIs(e, "", "smusdx r0, r1, r2", "E700F271")
	e = armGateIs(e, "", "smlsldx r0, r1, r2, r3", "E7410372")
	e = armGateIs(e, "", "smmlsr r0, r1, r2, r3", "E75032F1")
	e = armGateIs(e, "", "smmulreq r0, r1, r2", "0750F231")
	if len(e) > 0 { return fail(e) }
	return ""
}

// The forms clang rejects: too few or too many registers (only MUL, SDIV and UDIV have a
// two-register form), S on a multiply without one, PC where clang rejects it, a long multiply's
// RdLo and RdHi the same, and each family before its architecture (the halfword ones ARMv5TE, the
// dual and most-significant-word ones and UMAAL ARMv6, MLS ARMv6T2, the divides the divide
// extension; MUL's two-register form ARMv6).
func TestArm32MultiplyRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "mla r0, r1, r2", "!too few operands for instruction")
	e = armGateIs(e, "", "mul r0", "!too few operands for instruction")
	e = armGateIs(e, "", "smulbb r0, r1", "!too few operands for instruction")
	e = armGateIs(e, "", "mla r0, r1, r2, r3, r4", "!too many operands for instruction")
	e = armGateIs(e, "", "mlss r0, r1, r2, r3", "!instruction 'mls' can not set flags")
	e = armGateIs(e, "", "smlabbs r0, r1, r2, r3", "!instruction 'smlabb' can not set flags")
	e = armGateIs(e, "", "mul pc, r1, r2", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "smlad r0, r1, pc, r3", "!operand must be a register in range [r0, r14]")
	e = armGateIs(e, "", "umull r0, r0, r2, r3",
			"!unpredictable instruction, RdHi and RdLo must be different")
	e = armGateIs(e, ".arch armv5t", "smlabb r0, r1, r2, r3", "!instruction requires: armv5te")
	e = armGateIs(e, ".arch armv5te", "smlabb r0, r1, r2, r3", "E1003281")
	e = armGateIs(e, ".arch armv5te", "umaal r0, r1, r2, r3", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv6", "smmul r0, r1, r2", "E750F211")
	e = armGateIs(e, ".arch armv6", "mls r0, r1, r2, r3", "!instruction requires: armv6t2")
	e = armGateIs(e, ".arch armv7-a", "sdiv r0, r1, r2", "!instruction requires: divide in ARM")
	e = armGateIs(e, ".arch armv5te", "mul r0, r1", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv5te", "mul r0, r0, r1", "E0000190")
	e = armGateIs(e, ".arch armv6", "mul r0, r1", "E0000190")
	if len(e) > 0 { return fail(e) }
	return ""
}
