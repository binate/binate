package "pkg/binate/asm/parse"

// NEON's two registers, miscellaneous: VABS and VNEG, .S8, .S16, .S32, .F32 and (with full FP16)
// .F16 on two D or two Q registers, which clang matches with the VFP's encodings of the names
// (arm32_varith.bn) and this assembler does not have yet (matchFormNEON); and MVE's encodings of
// them, on Q0..Q7, as near misses.

// arm32Neon2Most is the most NEON and MVE encodings a name has (arm32Neon2Add).
const arm32Neon2Most int = 15

// arm32Neon2Add appends NEON's and MVE's two-register encodings of name (lowercase, split) to list:
// each type on D registers and on Q registers, NEON's (F16's with full FP16), then on MVE's Q
// registers (MVE's FP for the floating-point ones).
func arm32Neon2Add(list @arm32MatchList, name *[]readonly char) {
	if !charsEqual(name, "vabs") && !charsEqual(name, "vneg") { return }
	var types @[]int = @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeF32, matchTypeF16}
	var d int = matchKindD
	var q int = matchKindQ
	for i := 0; i < len(types); i++ {
		var need int = matchNeedNEON
		if types[i] == matchTypeF16 { need = need | matchNeedFull16 }
		matchAdd(list, types[i], 0, matchOps(d, d, 0), need, matchFormNEON)
		matchAdd(list, types[i], 0, matchOps(q, q, 0), need, matchFormNEON)
	}
	var mq int = matchKindMQ
	for i := 0; i < len(types); i++ {
		var need int = matchNeedMVE
		if types[i] == matchTypeF32 || types[i] == matchTypeF16 { need = matchNeedMVEFP }
		matchAdd(list, types[i], 0, matchOps(mq, mq, 0), need, matchFormMVE)
	}
}
