package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// NEON's two registers, miscellaneous (asm/arm32/neon's Two), as clang takes them, on two D or two
// Q registers: VREV64 / VREV32 / VREV16 (.8 .. .32 / .8 .. .16 / .8), VTRN / VUZP / VZIP (.8 ..
// .32) and VCNT (.8), a data type standing for its size (.i8, .s8 or .p8 for .8, .f32 for .32);
// VPADDL / VPADAL (.S / .U 8 .. 32); VCLS, VQABS and VQNEG (.S8 .. .S32); VCLZ (.I8 .. .I32); VMVN
// and VSWP with no data type or a size (any type standing for one), which they ignore; VABS and
// VNEG (.S8 .. .S32, .F32 and with full FP16 .F16), among the VFP's encodings of those names
// (arm32_varith.bn); VRECPE / VRSQRTE (.U32, .F32 and with full FP16 .F16); and the narrowing
// VMOVN (.I16 .. .I64), VQMOVN (.S / .U 16 .. 64) and VQMOVUN (.S16 .. .S64), a D register of a Q
// register.  VUZP.32 and VZIP.32 on D registers are VTRN.32, as clang assembles them.  MVE's
// encodings of VREV*, VCLS, VCLZ, VQABS, VQNEG, VABS, VNEG and VMVN (on Q0..Q7, VMVN with no data
// type) are near misses.  The comparisons with 0 -- VCEQ (.I8 .. .I32), VCGE, VCGT, VCLE and VCLT
// (.S8 .. .S32), each with .F32 and with full FP16 .F16 -- take Vd, Vm, #0 or Vd, #0 for Vd, Vd,
// #0, among the encodings of NEON's three-register comparisons of those names (arm32_neon3.bn).

// arm32Neon2Most is the most NEON and MVE encodings a name has (arm32Neon2Add).
const arm32Neon2Most int = 15

// arm32Neon2Op returns the operation (neon.TWO_*) name (lowercase, split) has on two registers,
// or 0.
func arm32Neon2Op(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"vrev64", "vrev32", "vrev16", "vpaddl",
			"vpadal", "vcls", "vclz", "vcnt", "vmvn", "vqabs", "vqneg", "vabs", "vneg", "vswp", "vtrn",
			"vuzp", "vzip", "vmovn", "vqmovun", "vqmovn", "vrecpe", "vrsqrte"}
	var ops @[]int = @[]int{neon.TWO_VREV64, neon.TWO_VREV32, neon.TWO_VREV16, neon.TWO_VPADDL,
			neon.TWO_VPADAL, neon.TWO_VCLS, neon.TWO_VCLZ, neon.TWO_VCNT, neon.TWO_VMVN, neon.TWO_VQABS,
			neon.TWO_VQNEG, neon.TWO_VABS, neon.TWO_VNEG, neon.TWO_VSWP, neon.TWO_VTRN, neon.TWO_VUZP,
			neon.TWO_VZIP, neon.TWO_VMOVN, neon.TWO_VQMOVUN, neon.TWO_VQMOVN, neon.TWO_VRECPE,
			neon.TWO_VRSQRTE}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return ops[i] }
	}
	return 0
}

// arm32Neon2Types returns two-register operation op's (neon.TWO_*) data types, as clang's
// encodings name them (0 for none).
func arm32Neon2Types(op int) @[]int {
	var sizes @[]int = @[]int{matchType8, matchType16, matchType32}
	var signed @[]int = @[]int{matchTypeS8, matchTypeS16, matchTypeS32}
	if op == neon.TWO_VREV64 || op == neon.TWO_VTRN || op == neon.TWO_VUZP || op == neon.TWO_VZIP {
		return sizes
	}
	if op == neon.TWO_VREV32 { return @[]int{matchType8, matchType16} }
	if op == neon.TWO_VREV16 || op == neon.TWO_VCNT { return @[]int{matchType8} }
	if op == neon.TWO_VPADDL || op == neon.TWO_VPADAL {
		return @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeU8, matchTypeU16, matchTypeU32}
	}
	if op == neon.TWO_VCLZ { return @[]int{matchTypeI8, matchTypeI16, matchTypeI32} }
	if op == neon.TWO_VMVN || op == neon.TWO_VSWP {
		return @[]int{0, matchType8, matchType16, matchType32, matchType64}
	}
	if op == neon.TWO_VABS || op == neon.TWO_VNEG {
		return @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeF32, matchTypeF16}
	}
	if op == neon.TWO_VMOVN { return @[]int{matchTypeI16, matchTypeI32, matchTypeI64} }
	if op == neon.TWO_VQMOVUN { return @[]int{matchTypeS16, matchTypeS32, matchTypeS64} }
	if op == neon.TWO_VQMOVN {
		return @[]int{matchTypeS16, matchTypeS32, matchTypeS64, matchTypeU16, matchTypeU32, matchTypeU64}
	}
	if op == neon.TWO_VRECPE || op == neon.TWO_VRSQRTE {
		return @[]int{matchTypeU32, matchTypeF32, matchTypeF16}
	}
	return signed
}

// arm32Neon2Add appends name's two-register encodings (arm32Neon2Op) to list: NEON's, each data
// type on D registers and on Q registers (a narrowing one's on a D and a Q register), F16's with
// full FP16; then MVE's, on Q0..Q7 (the floating-point ones MVE's FP).
func arm32Neon2Add(list @arm32MatchList, name *[]readonly char) {
	var op int = arm32Neon2Op(name)
	if op == 0 { return }
	var types @[]int = arm32Neon2Types(op)
	var d int = matchKindD
	var q int = matchKindQ
	var narrow bool = op == neon.TWO_VMOVN || op == neon.TWO_VQMOVUN || op == neon.TWO_VQMOVN
	for i := 0; i < len(types); i++ {
		var need int = matchNeedNEON
		if types[i] == matchTypeF16 { need = need | matchNeedFull16 }
		if narrow {
			matchAdd(list, types[i], 0, matchOps(d, q, 0), need, matchFormSIMD)
			continue
		}
		matchAdd(list, types[i], 0, matchOps(d, d, 0), need, matchFormSIMD)
		matchAdd(list, types[i], 0, matchOps(q, q, 0), need, matchFormSIMD)
	}
	var mve bool = op == neon.TWO_VREV64 || op == neon.TWO_VREV32 || op == neon.TWO_VREV16 ||
			op == neon.TWO_VCLS || op == neon.TWO_VCLZ || op == neon.TWO_VQABS || op == neon.TWO_VQNEG ||
			op == neon.TWO_VABS || op == neon.TWO_VNEG || op == neon.TWO_VMVN
	if !mve { return }
	var mq int = matchKindMQ
	if op == neon.TWO_VMVN {
		matchAdd(list, 0, 0, matchOps(mq, mq, 0), matchNeedMVE, matchFormMVE)
		return
	}
	for i := 0; i < len(types); i++ {
		var need int = matchNeedMVE
		if types[i] == matchTypeF32 || types[i] == matchTypeF16 { need = matchNeedMVEFP }
		matchAdd(list, types[i], 0, matchOps(mq, mq, 0), need, matchFormMVE)
	}
}

// arm32Neon2Emit assembles two-register name (arm32Neon2Op) under cond as encoding c, its operands
// items -- Vd and Vm -- unconditional: VUZP.32 and VZIP.32 on D registers as VTRN.32.
func arm32Neon2Emit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var op int = arm32Neon2Op(name)
	var onD bool = arm32MatchKindAt(c.ops, 0) == matchKindD
	if (op == neon.TWO_VUZP || op == neon.TWO_VZIP) && c.t1 == matchType32 && onD {
		op = neon.TWO_VTRN
	}
	neon.Two(p.Asm, op, arm32NeonDT(c.t1), arm32NeonReg(items[0]), arm32NeonReg(items[1]))
}

// arm32Neon2ZeroMost is the most comparisons with 0 a name has (arm32Neon2ZeroAdd).
const arm32Neon2ZeroMost int = 20

// arm32Neon2ZeroOp returns the comparison with 0 (neon.TWO_VCGT0 .. TWO_VCLT0) name (lowercase,
// split) has, or 0.
func arm32Neon2ZeroOp(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"vcgt", "vcge", "vceq", "vcle", "vclt"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return neon.TWO_VCGT0 + i }
	}
	return 0
}

// arm32Neon2ZeroAdd appends name's comparisons with 0 (arm32Neon2ZeroOp) to list: each data type's
// Vd, Vm, #0 and Vd, #0, on D registers and on Q registers, F16's with full FP16.
func arm32Neon2ZeroAdd(list @arm32MatchList, name *[]readonly char) {
	var op int = arm32Neon2ZeroOp(name)
	if op == 0 { return }
	var types @[]int
	if op == neon.TWO_VCEQ0 {
		types = @[]int{matchTypeI8, matchTypeI16, matchTypeI32, matchTypeF32, matchTypeF16}
	} else {
		types = @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeF32, matchTypeF16}
	}
	var d int = matchKindD
	var q int = matchKindQ
	var z int = matchKindZero
	var simd int = matchFormSIMD
	for i := 0; i < len(types); i++ {
		var need int = matchNeedNEON
		if types[i] == matchTypeF16 { need = need | matchNeedFull16 }
		matchAdd(list, types[i], 0, matchOps(d, d, z), need, simd)
		matchAdd(list, types[i], 0, matchOps(q, q, z), need, simd)
		matchAdd(list, types[i], 0, matchOps(d, z, 0), need, simd)
		matchAdd(list, types[i], 0, matchOps(q, z, 0), need, simd)
	}
}

// arm32Neon2ZeroCand reports whether encoding c of name is NEON's comparison with 0, a zero among
// its operands.
func arm32Neon2ZeroCand(name *[]readonly char, c arm32MatchCand) bool {
	if c.form != matchFormSIMD || arm32Neon2ZeroOp(name) == 0 { return false }
	return arm32MatchKindAt(c.ops, 1) == matchKindZero || arm32MatchKindAt(c.ops, 2) == matchKindZero
}

// arm32Neon2ZeroEmit assembles comparison with 0 name (arm32Neon2ZeroOp) under cond as encoding c,
// its operands items -- Vd, Vm and the zero, or Vd and the zero for Vd, Vd, #0 -- unconditional.
func arm32Neon2ZeroEmit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var vd int = arm32NeonReg(items[0])
	var vm int = vd
	if arm32MatchKindAt(c.ops, 2) != 0 { vm = arm32NeonReg(items[1]) }
	neon.Two(p.Asm, arm32Neon2ZeroOp(name), arm32NeonDT(c.t1), vd, vm)
}
