package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each two-register name's encodings: NEON's for each data type on D and on Q registers (a
// narrowing one's on a D and a Q register) and MVE's, VABS / VNEG five types each, VMVN five
// (none and the sizes) and MVE's one with no type, VQMOVN six and no MVE; other names none.
func TestArm32Neon2Encodings() testing.TestResult {
	var names @[]*[]readonly char = @[]*[]readonly char{"vneg", "vmvn", "vqmovn", "vsqrt"}
	var counts @[]int = @[]int{15, 11, 6, 0}
	var simd @[]int = @[]int{10, 10, 6, 0}
	for i := 0; i < len(names); i++ {
		var list @arm32MatchList = make(arm32MatchList)
		list.c = make_slice(arm32MatchCand, arm32Neon2Most)
		arm32Neon2Add(list, names[i])
		var n int = 0
		for j := 0; j < list.n; j++ {
			if list.c[j].form == matchFormSIMD { n = n + 1 }
		}
		if list.n != counts[i] || n != simd[i] {
			return fail(buf.Concat("wrong count of two-register encodings: ", names[i]))
		}
	}
	return ""
}

// The two-register instructions as clang assembles them: each name, a data type standing for a
// size or for I, VMVN and VSWP with none or any, high registers, VUZP.32 and VZIP.32 on D
// registers as VTRN.32, the narrowing moves, with full FP16 the .F16 forms, and clang's aliases
// VMVNQ, VSWPQ, VZIPQ and VABSQ (on D registers as well as Q).
func TestParseArm32Neon2Forms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vrev64.8 d0, d1", "F3B00001")
	e = armGateIs(e, "", "vrev64.f32 q0, q1", "F3B80042")
	e = armGateIs(e, "", "vrev32.p8 d0, d1", "F3B00081")
	e = armGateIs(e, "", "vrev16.s8 q15, q14", "F3F0E16C")
	e = armGateIs(e, "", "vpaddl.u16 d0, d1", "F3B40281")
	e = armGateIs(e, "", "vpadal.s32 q0, q1", "F3B80642")
	e = armGateIs(e, "", "vcls.s8 d31, d30", "F3F0F42E")
	e = armGateIs(e, "", "vclz.u32 d0, d1", "F3B80481")
	e = armGateIs(e, "", "vcnt.p8 q0, q1", "F3B00542")
	e = armGateIs(e, "", "vmvn d0, d1", "F3B00581")
	e = armGateIs(e, "", "vmvn.f32 q0, q1", "F3B005C2")
	e = armGateIs(e, "", "vqabs.s16 d0, d1", "F3B40701")
	e = armGateIs(e, "", "vqneg.s32 q0, q1", "F3B807C2")
	e = armGateIs(e, "", "vabs.s8 d0, d1", "F3B10301")
	e = armGateIs(e, "", "vneg.f32 q0, q1", "F3B907C2")
	e = armGateIs(e, "", "vswp d0, d1", "F3B20001")
	e = armGateIs(e, "", "vswp.i64 q0, q1", "F3B20042")
	e = armGateIs(e, "", "vtrn.8 d0, d1", "F3B20081")
	e = armGateIs(e, "", "vuzp.32 d0, d1", "F3BA0081")
	e = armGateIs(e, "", "vzip.32 d0, d1", "F3BA0081")
	e = armGateIs(e, "", "vuzp.16 q0, q1", "F3B60142")
	e = armGateIs(e, "", "vzip.f32 q0, q1", "F3BA01C2")
	e = armGateIs(e, "", "vmovn.i16 d0, q1", "F3B20202")
	e = armGateIs(e, "", "vmovn.u64 d31, q15", "F3FAF22E")
	e = armGateIs(e, "", "vqmovn.u32 d0, q1", "F3B602C2")
	e = armGateIs(e, "", "vqmovun.s64 d0, q1", "F3BA0242")
	e = armGateIs(e, "", "vrecpe.u32 d0, d1", "F3BB0401")
	e = armGateIs(e, "", "vrsqrte.f32 q0, q1", "F3BB05C2")
	e = armGateIs(e, arm32CvtFull, "vabs.f16 d0, d1", "F3B50701")
	e = armGateIs(e, arm32CvtFull, "vrecpe.f16 q0, q1", "F3B70542")
	e = armGateIs(e, arm32CvtFull, "vrsqrte.f16 d0, d1", "F3B70581")
	e = armGateIs(e, "", "vmvnq q0, q1", "F3B005C2")
	e = armGateIs(e, "", "vmvnq d0, d1", "F3B00581")
	e = armGateIs(e, "", "vswpq q0, q1", "F3B20042")
	e = armGateIs(e, "", "vzipq.32 d0, d1", "F3BA0081")
	e = armGateIs(e, "", "vabsq.s8 q0, q1", "F3B10342")
	return e
}

// What clang does not take of them, with its message: a data type a name has not, registers of
// other lengths, an operand too few or too many, no NEON (with MVE's encodings near misses too),
// .F16 without full FP16 beside the .F32 form; and here a condition, which clang drops.
func TestParseArm32Neon2Rejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vrev16.16 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vcls.u8 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmovn.i8 d0, q1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmovn.i16 q0, q1", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vtrn.8 d0, q1", several)
	e = armMsgIs(e, "", "vswp.f16 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vabs.s8 d0", "too few operands for instruction")
	e = armMsgIs(e, "", "vrecpe.s32 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vcnt.16 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vqmovun.u16 d0, q1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vabs.i8 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vneg.f16 d0, d1", several)
	e = armMsgIs(e, v3, "vabs.s8 q0, q1", several)
	e = armMsgIs(e, v3, "vclz.i8 q0, q1", several)
	e = armMsgIs(e, v3, "vcnt.8 q0, q1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vmvn q0, q1", several)
	e = armMsgIs(e, "", "vrev64.8 d0, d1, d2", "too many operands for instruction")
	e = armMsgIs(e, "", "vmovn.i16 d0, d1", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, "", "vrev64eq.8 d0, d1",
			"instruction 'vrev64' is not predicable, but condition code specified")
	return e
}

// Each comparison with 0 is its operation (VCLE's and VCLT's their own, not VCGE's and VCGT's with
// the operands swapped), with five data types' four forms each; other names none.
func TestArm32Neon2ZeroEncodings() testing.TestResult {
	if arm32Neon2ZeroOp("vcle") != neon.TWO_VCLE0 || arm32Neon2ZeroOp("vceq") != neon.TWO_VCEQ0 ||
			arm32Neon2ZeroOp("vadd") != 0 {
		return fail("a comparison with 0 has the wrong operation")
	}
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32Neon2ZeroMost)
	arm32Neon2ZeroAdd(list, "vclt")
	if list.n != 20 { return fail("VCLT has not 20 comparisons with 0") }
	for i := 0; i < list.n; i++ {
		if !arm32Neon2ZeroCand("vclt", list.c[i]) { return fail("a comparison with 0 is not one") }
	}
	return ""
}

// The comparisons with 0 as clang assembles them: Vd, Vm, #0 and Vd, #0, an S type standing for
// VCEQ's I, the zero as #0, 0, #0.0 or an expression of 0, high registers, clang's alias VCEQQ, and
// with full FP16 the .F16 forms; and the three-register comparisons still.
func TestParseArm32Neon2ZeroForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vceq.i8 d0, d1, #0", "F3B10101")
	e = armGateIs(e, "", "vceq.s16 q0, q1, #0", "F3B50142")
	e = armGateIs(e, "", "vcge.s8 d0, #0", "F3B10080")
	e = armGateIs(e, "", "vcgt.s32 q15, q14, #0", "F3F9E06C")
	e = armGateIs(e, "", "vcle.s16 d0, d1, #0", "F3B50181")
	e = armGateIs(e, "", "vclt.s8 d31, d30, #0", "F3F1F22E")
	e = armGateIs(e, "", "vcge.f32 d0, #0", "F3B90480")
	e = armGateIs(e, "", "vceq.f32 q0, q1, 0", "F3B90542")
	e = armGateIs(e, "", "vcgt.f32 d0, d1, #0.0", "F3B90401")
	e = armGateIs(e, "", "vclt.s8 d0, d1, #1-1", "F3B10201")
	e = armGateIs(e, "", "vceqq.i8 q0, q1, #0", "F3B10142")
	e = armGateIs(e, "", "vceqq.i8 q0, #0", "F3B10140")
	e = armGateIs(e, arm32CvtFull, "vceq.f16 d0, d1, #0", "F3B50501")
	e = armGateIs(e, arm32CvtFull, "vcle.f16 q0, q1, #0", "F3B505C2")
	e = armGateIs(e, "", "vcgt.s8 d0, d1", "F2000301")
	return e
}

// What clang does not take of them, with its message: an immediate other than 0 (or a negative zero
// or a symbol), a data type the comparison has not (VCEQ.I64, VCGE.U8 beside the three-register
// form's), registers of two lengths, .F16 without full FP16, no NEON.
func TestParseArm32Neon2ZeroRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vceq.i8 d0, d1, #1", several)
	e = armMsgIs(e, "", "vceq.i64 d0, d1, #0", "invalid operand for instruction")
	e = armMsgIs(e, "", "vcge.u8 d0, d1, #0", several)
	e = armMsgIs(e, "", "vceq.i8 d0, q1, #0", several)
	e = armMsgIs(e, "", "vceq.f16 d0, d1, #0", several)
	e = armMsgIs(e, "", "vceq.i8 d0, d1, #-0", several)
	e = armMsgIs(e, "", "vceq.i8 d0, d1, #x", several)
	e = armMsgIs(e, v3, "vceq.i8 d0, d1, #0", "instruction requires: NEON")
	return e
}
