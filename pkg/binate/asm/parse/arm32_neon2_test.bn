package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// VABS and VNEG have NEON's five types on D and on Q registers and MVE's five on its Q registers;
// other names none.
func TestArm32Neon2Encodings() testing.TestResult {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32Neon2Most)
	arm32Neon2Add(list, "vneg")
	if list.n != 15 { return fail("VNEG has not 15 NEON and MVE encodings") }
	var neon int = 0
	for i := 0; i < list.n; i++ {
		if list.c[i].form == matchFormNEON { neon = neon + 1 }
	}
	if neon != 10 { return fail("VNEG has not 10 NEON encodings") }
	var none @arm32MatchList = make(arm32MatchList)
	none.c = make_slice(arm32MatchCand, arm32Neon2Most)
	arm32Neon2Add(none, "vsqrt")
	if none.n != 0 { return fail("VSQRT has NEON encodings") }
	return ""
}

// NEON's forms are offered, not yet assembled; their near misses make clang's errors: a type only
// NEON has (.S8) or MVE's with no NEON; .F16 without full FP16 beside the .F32 form, a type off.
func TestParseArm32Neon2NearMisses() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = armMsgIs(e, "", "vabs.s8 d0, d1", "NEON (Advanced SIMD) instructions are not supported yet")
	e = armMsgIs(e, "", "vneg.f32 q0, q1", "NEON (Advanced SIMD) instructions are not supported yet")
	e = armMsgIs(e, "", "vabs.s8 d0", "too few operands for instruction")
	e = armMsgIs(e, "", "vabs.i8 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, ".fpu vfpv3", "vabs.s8 q0, q1", several)
	e = armMsgIs(e, "", "vneg.f16 d0, d1", several)
	return e
}
