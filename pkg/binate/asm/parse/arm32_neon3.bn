package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/neon"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"

// NEON's three registers of the same length (asm/arm32/neon's Three), as clang takes them: Dd, Dn,
// Dm or Qd, Qn, Qm with a data type the instruction's encodings name (or one clang's token aliases
// stand for it: .s32 or .u32 for .i32, .i32 or .f32 for .32, ...), most with a two-operand form
// (Vd, Vm for Vd, Vd, Vm); the bitwise ones with no type or any size; VCLE / VCLT / VACLE / VACLT
// as VCGE / VCGT / VACGE / VACGT with the operands swapped, as the register shifts' Vd, Vm, Vn swap
// them.  VADD, VSUB, VMUL, VMLA, VMLS, VFMA and VFMS are the VFP's too, whose encodings clang
// matches with these (arm32_varith.bn), and MVE's VMLAS and VFMAS have MVE's only.  clang takes a
// condition on these unconditional instructions and drops it, which is an error here.  The
// parser that matches them is arm32_vdp.bn.

// A three-same name's data types (arm32Neon3Name): integers of no sign 8 .. 32 bits (or 8 .. 64),
// signed or unsigned 8 .. 32 (or 8 .. 64), signed 16 and 32, a size of 8 .. 32, none or a size
// (bitwise), none only, signed 8 .. 32 (MVE's VQDMULH); or no integer types (floating point
// only).
const (
	neon3None int = iota
	neon3I
	neon3I64
	neon3SU
	neon3SU64
	neon3S
	neon3Size
	neon3Bits
	neon3Bare
	neon3S8
)

// The ways of a three-same name (arm32Neon3Name, a mask): a floating-point form (F32, F16); a
// polynomial one (P8); a two-operand form, or one with no type only; its operands swapped; D
// registers only; an F32 form needing VFPv4 as well as NEON (the fused ones).
const (
	neon3Float int = 1
	neon3Poly int = 2
	neon3TwoOp int = 4
	neon3TwoOpBare int = 8
	neon3Swap int = 16
	neon3DOnly int = 32
	neon3Fused int = 64
)

// neon3MveOnly is the operation (arm32Neon3Name) of a name with MVE's encodings only.
const neon3MveOnly int = -1

// arm32Neon3Name returns the operation (neon.THREE_*, or neon3MveOnly) name (lowercase, split)
// names, its integer data types (neon3*) and its ways (a mask of neon3Float .. neon3Fused), or op
// 0.
func arm32Neon3Name(name *[]readonly char) (int, int, int) {
	var two int = neon3TwoOp
	var fl int = neon3Float | neon3TwoOp
	if charsEqual(name, "vadd") { return neon.THREE_VADD, neon3I64, fl }
	if charsEqual(name, "vsub") { return neon.THREE_VSUB, neon3I64, fl }
	if charsEqual(name, "vmul") { return neon.THREE_VMUL, neon3I, fl | neon3Poly }
	if charsEqual(name, "vmla") { return neon.THREE_VMLA, neon3I, neon3Float }
	if charsEqual(name, "vmls") { return neon.THREE_VMLS, neon3I, neon3Float }
	if charsEqual(name, "vfma") { return neon.THREE_VFMA, neon3None, neon3Float | neon3Fused }
	if charsEqual(name, "vfms") { return neon.THREE_VFMS, neon3None, neon3Float | neon3Fused }
	if charsEqual(name, "vmlas") || charsEqual(name, "vfmas") { return neon3MveOnly, neon3None, 0 }
	if charsEqual(name, "vhadd") { return neon.THREE_VHADD, neon3SU, two }
	if charsEqual(name, "vhsub") { return neon.THREE_VHSUB, neon3SU, two }
	if charsEqual(name, "vrhadd") { return neon.THREE_VRHADD, neon3SU, two }
	if charsEqual(name, "vqadd") { return neon.THREE_VQADD, neon3SU64, two }
	if charsEqual(name, "vqsub") { return neon.THREE_VQSUB, neon3SU64, two }
	if charsEqual(name, "vand") { return neon.THREE_VAND, neon3Bits, two }
	if charsEqual(name, "vbic") { return neon.THREE_VBIC, neon3Bits, neon3TwoOpBare }
	if charsEqual(name, "vorr") { return neon.THREE_VORR, neon3Bits, two }
	if charsEqual(name, "vorn") { return neon.THREE_VORN, neon3Bare, 0 }
	if charsEqual(name, "veor") { return neon.THREE_VEOR, neon3Bits, two }
	if charsEqual(name, "vbsl") { return neon.THREE_VBSL, neon3Bits, 0 }
	if charsEqual(name, "vbit") { return neon.THREE_VBIT, neon3Bits, 0 }
	if charsEqual(name, "vbif") { return neon.THREE_VBIF, neon3Bits, 0 }
	if charsEqual(name, "vceq") { return neon.THREE_VCEQ, neon3I, fl }
	if charsEqual(name, "vcge") { return neon.THREE_VCGE, neon3SU, fl }
	if charsEqual(name, "vcgt") { return neon.THREE_VCGT, neon3SU, fl }
	if charsEqual(name, "vcle") { return neon.THREE_VCGE, neon3SU, neon3Float | neon3Swap }
	if charsEqual(name, "vclt") { return neon.THREE_VCGT, neon3SU, neon3Float | neon3Swap }
	if charsEqual(name, "vacge") { return neon.THREE_VACGE, neon3None, fl }
	if charsEqual(name, "vacgt") { return neon.THREE_VACGT, neon3None, fl }
	if charsEqual(name, "vacle") { return neon.THREE_VACGE, neon3None, fl | neon3Swap }
	if charsEqual(name, "vaclt") { return neon.THREE_VACGT, neon3None, fl | neon3Swap }
	if charsEqual(name, "vtst") { return neon.THREE_VTST, neon3Size, two }
	if charsEqual(name, "vabd") { return neon.THREE_VABD, neon3SU, fl }
	if charsEqual(name, "vaba") { return neon.THREE_VABA, neon3SU, 0 }
	if charsEqual(name, "vmax") { return neon.THREE_VMAX, neon3SU, fl }
	if charsEqual(name, "vmin") { return neon.THREE_VMIN, neon3SU, fl }
	if charsEqual(name, "vpadd") { return neon.THREE_VPADD, neon3I, fl | neon3DOnly }
	if charsEqual(name, "vpmax") { return neon.THREE_VPMAX, neon3SU, fl | neon3DOnly }
	if charsEqual(name, "vpmin") { return neon.THREE_VPMIN, neon3SU, fl | neon3DOnly }
	if charsEqual(name, "vqdmulh") { return neon.THREE_VQDMULH, neon3S, two }
	if charsEqual(name, "vqrdmulh") { return neon.THREE_VQRDMULH, neon3S, two }
	if charsEqual(name, "vrecps") { return neon.THREE_VRECPS, neon3None, fl }
	if charsEqual(name, "vrsqrts") { return neon.THREE_VRSQRTS, neon3None, fl }
	if charsEqual(name, "vshl") { return neon.THREE_VSHL, neon3SU64, two | neon3Swap }
	if charsEqual(name, "vrshl") { return neon.THREE_VRSHL, neon3SU64, two | neon3Swap }
	if charsEqual(name, "vqshl") { return neon.THREE_VQSHL, neon3SU64, two | neon3Swap }
	if charsEqual(name, "vqrshl") { return neon.THREE_VQRSHL, neon3SU64, two | neon3Swap }
	return 0, neon3None, 0
}

// arm32Neon3Types returns the data types (matchType*, 0 for none) of integer set set and ways ways,
// in the order clang's encodings come, into types, and how many.
func arm32Neon3Types(set int, ways int, types @[]int) int {
	var n int = 0
	if set == neon3I || set == neon3I64 { n = arm32Neon3Add(types, n, matchTypeI8, 3) }
	if set == neon3I64 { n = arm32Neon3Add(types, n, matchTypeI64, 1) }
	if set == neon3SU || set == neon3SU64 {
		n = arm32Neon3Put(types, n, @[]int{matchTypeS8, matchTypeS16, matchTypeS32})
		if set == neon3SU64 { n = arm32Neon3Put(types, n, @[]int{matchTypeS64}) }
		n = arm32Neon3Put(types, n, @[]int{matchTypeU8, matchTypeU16, matchTypeU32})
		if set == neon3SU64 { n = arm32Neon3Put(types, n, @[]int{matchTypeU64}) }
	}
	if set == neon3S { n = arm32Neon3Put(types, n, @[]int{matchTypeS16, matchTypeS32}) }
	if set == neon3S8 { n = arm32Neon3Put(types, n, @[]int{matchTypeS8, matchTypeS16, matchTypeS32}) }
	if set == neon3Size { n = arm32Neon3Add(types, n, matchType8, 3) }
	if set == neon3Bits || set == neon3Bare { n = arm32Neon3Put(types, n, @[]int{0}) }
	if set == neon3Bits { n = arm32Neon3Add(types, n, matchType8, 4) }
	if ways & neon3Poly != 0 { n = arm32Neon3Put(types, n, @[]int{matchTypeP8}) }
	if ways & neon3Float != 0 { n = arm32Neon3Put(types, n, @[]int{matchTypeF32, matchTypeF16}) }
	return n
}

// arm32Neon3Put puts the data types more into types from n and returns where they end.
func arm32Neon3Put(types @[]int, n int, more @[]int) int {
	for i := 0; i < len(more); i++ { types[n + i] = more[i] }
	return n + len(more)
}

// arm32Neon3Add puts the count data types from first (matchType*, consecutive) into types from n
// and returns where they end.
func arm32Neon3Add(types @[]int, n int, first int, count int) int {
	for i := 0; i < count; i++ { types[n + i] = first + i }
	return n + count
}

// The MVE forms of a three-same name (arm32Neon3Mve, a mask): Qd, Qn, Qm; Qd, Qn, Rm; Qda, Rm.
const (
	neon3MveQQQ int = 1
	neon3MveQQR int = 2
	neon3MveQR int = 4
)

// arm32Neon3Mve returns the data types (neon3*, and neon3Float for F32 and F16 with MVE's FP) and
// forms (neon3Mve*) of name's MVE encodings, which clang offers in ARM code as near misses -- but
// not its MVE aliases (the bitwise ones with a type), which want Thumb code too.
func arm32Neon3Mve(name *[]readonly char) (int, int, int) {
	var both int = neon3MveQQQ | neon3MveQQR
	var shift int = neon3MveQQQ | neon3MveQR
	if charsEqual(name, "vadd") || charsEqual(name, "vsub") || charsEqual(name, "vmul") {
		return neon3I, neon3Float, both
	}
	if charsEqual(name, "vmla") || charsEqual(name, "vmlas") { return neon3I, 0, neon3MveQQR }
	if charsEqual(name, "vfma") { return neon3None, neon3Float, both }
	if charsEqual(name, "vfms") { return neon3None, neon3Float, neon3MveQQQ }
	if charsEqual(name, "vfmas") { return neon3None, neon3Float, neon3MveQQR }
	if charsEqual(name, "vhadd") || charsEqual(name, "vhsub") || charsEqual(name, "vqadd") ||
			charsEqual(name, "vqsub") {
		return neon3SU, 0, both
	}
	if charsEqual(name, "vrhadd") || charsEqual(name, "vmax") || charsEqual(name, "vmin") {
		return neon3SU, 0, neon3MveQQQ
	}
	if charsEqual(name, "vand") || charsEqual(name, "vbic") || charsEqual(name, "vorr") ||
			charsEqual(name, "vorn") || charsEqual(name, "veor") {
		return neon3Bare, 0, neon3MveQQQ
	}
	if charsEqual(name, "vabd") { return neon3SU, neon3Float, neon3MveQQQ }
	if charsEqual(name, "vqdmulh") || charsEqual(name, "vqrdmulh") { return neon3S8, 0, both }
	if charsEqual(name, "vshl") || charsEqual(name, "vrshl") || charsEqual(name, "vqshl") ||
			charsEqual(name, "vqrshl") {
		return neon3SU, 0, shift
	}
	return neon3None, 0, 0
}

// arm32Neon3Cands returns the encodings clang tries for three-same name, of integer set set and
// ways ways: the VFP's of a name it shares (arm32VarithAddVfp); each data type on three D
// registers and three Q registers (D only for the pairwise ones), and on two of each where it has
// a two-operand form, all NEON's (F16's with full FP16, a fused one's F32 with VFPv4); then MVE's
// (arm32Neon3Mve), on Q0..Q7 and MVE's core registers.
func arm32Neon3Cands(name *[]readonly char, set int, ways int) @arm32MatchList {
	var types @[]int = make_slice(int, 16)
	var nt int = arm32Neon3Types(set, ways, types)
	var mset int
	var mways int
	var forms int
	mset, mways, forms = arm32Neon3Mve(name)
	var mtypes @[]int = make_slice(int, 16)
	var mt int = 0
	if forms != 0 { mt = arm32Neon3Types(mset, mways, mtypes) }
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32VarithMost + 4 * nt + 3 * mt)
	arm32VarithAddVfp(list, name)
	var d int = matchKindD
	var q int = matchKindQ
	for i := 0; i < nt; i++ {
		var need int = matchNeedNEON
		if types[i] == matchTypeF16 { need = need | matchNeedFull16 }
		if types[i] == matchTypeF32 && ways & neon3Fused != 0 { need = need | matchNeedVFP4 }
		var two bool = ways & neon3TwoOp != 0 || (ways & neon3TwoOpBare != 0 && types[i] == 0)
		var both bool = ways & neon3DOnly == 0
		matchAdd(list, types[i], 0, matchOps(d, d, d), need, matchFormSIMD)
		if both { matchAdd(list, types[i], 0, matchOps(q, q, q), need, matchFormSIMD) }
		if two { matchAdd(list, types[i], 0, matchOps(d, d, 0), need, matchFormSIMD) }
		if two && both { matchAdd(list, types[i], 0, matchOps(q, q, 0), need, matchFormSIMD) }
	}
	var mq int = matchKindMQ
	var r int = matchKindRGPR
	var mve int = matchFormMVE
	for i := 0; i < mt; i++ {
		var need int = matchNeedMVE
		if mtypes[i] == matchTypeF32 || mtypes[i] == matchTypeF16 { need = matchNeedMVEFP }
		if forms & neon3MveQQQ != 0 { matchAdd(list, mtypes[i], 0, matchOps(mq, mq, mq), need, mve) }
		if forms & neon3MveQQR != 0 { matchAdd(list, mtypes[i], 0, matchOps(mq, mq, r), need, mve) }
		if forms & neon3MveQR != 0 { matchAdd(list, mtypes[i], 0, matchOps(mq, r, 0), need, mve) }
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonUnconditional reports whether cond is AL, setting the error for one written on name, an
// unconditional NEON instruction, if not: clang takes the condition and drops it, an error here in
// its own words for an instruction that has none.
func arm32NeonUnconditional(p @Parser, name *[]readonly char, cond int) bool {
	if cond == arm32.COND_AL { return true }
	setErr(p,
			buf.Concat(buf.Concat("instruction '", name),
					"' is not predicable, but condition code specified"))
	return false
}

// arm32NeonReg returns operand it, a D or Q register, as asm/arm32/neon names it.
func arm32NeonReg(it arm32MatchItem) int {
	if it.kind == matchItemQ { return neon.Q0 + it.n }
	return vfp.D0 + it.n
}

// arm32NeonDT returns data type t (matchType*, 0 for none) as asm/arm32/neon names it.
func arm32NeonDT(t int) int {
	if t >= matchTypeI8 && t <= matchTypeI64 { return neon.DT_I8 + t - matchTypeI8 }
	if t == matchTypeS8 { return neon.DT_S8 }
	if t == matchTypeS16 { return neon.DT_S16 }
	if t == matchTypeS32 { return neon.DT_S32 }
	if t == matchTypeS64 { return neon.DT_S64 }
	if t == matchTypeU8 { return neon.DT_U8 }
	if t == matchTypeU16 { return neon.DT_U16 }
	if t == matchTypeU32 { return neon.DT_U32 }
	if t == matchTypeU64 { return neon.DT_U64 }
	if t == matchTypeP8 { return neon.DT_P8 }
	if t == matchTypeP64 { return neon.DT_P64 }
	if t == matchTypeF16 { return neon.DT_F16 }
	if t == matchTypeF32 { return neon.DT_F32 }
	if t >= matchType8 && t <= matchType64 { return neon.DT_8 + t - matchType8 }
	return 0
}

// arm32Neon3Emit assembles the three-same operation op of name (ways its arm32Neon3Name ways) as
// encoding c, its operands items -- Vd, Vn, Vm, or Vd, Vm for Vd, Vd, Vm, Vn and Vm swapped for a
// swapping name -- unconditional.
func arm32Neon3Emit(p @Parser, name *[]readonly char, op int, ways int, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var vd int = arm32NeonReg(items[0])
	var vn int = vd
	var vm int = arm32NeonReg(items[1])
	if arm32MatchKindAt(c.ops, 2) != 0 {
		vn = vm
		vm = arm32NeonReg(items[2])
	}
	if ways & neon3Swap != 0 {
		var t int = vn
		vn = vm
		vm = t
	}
	neon.Three(p.Asm, op, arm32NeonDT(c.t1), vd, vn, vm)
}
