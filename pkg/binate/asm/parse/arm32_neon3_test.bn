package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// NEON's three registers of the same length as clang assembles them: D and Q forms, two-operand
// forms, each kind of data type (and clang's aliases of one: .s16 for VCEQ's .i16, .p8 or .f32 for
// VTST's sizes, .d for VEOR's), the bitwise ones with no type or a size, the swapped VCLE / VCLT /
// VACLE / VACLT and register shifts, a pairwise one, F16 with full FP16.
func TestParseArm32Neon3Forms() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vhadd.s8 d0, d1, d2", "F2010002")
	e = armGateIs(e, "", "vhadd.u32 q0, q1", "F3200042")
	e = armGateIs(e, "", "vrhadd.s16 d0, d1", "F2100101")
	e = armGateIs(e, "", "vqadd.s64 d0, d1, d2", "F2310012")
	e = armGateIs(e, "", "vqsub.u64 q0, q1", "F3300252")
	e = armGateIs(e, "", "vand d0, d1, d2", "F2010112")
	e = armGateIs(e, "", "vand.i32 d0, d1", "F2000111")
	e = armGateIs(e, "", "vand.f32 q0, q1, q2", "F2020154")
	e = armGateIs(e, "", "vbic d0, d1", "F2100111")
	e = armGateIs(e, "", "vorn q0, q1, q2", "F2320154")
	e = armGateIs(e, "", "veor.d q0, q1", "F3000152")
	e = armGateIs(e, "", "vbsl.8 d0, d1, d2", "F3110112")
	e = armGateIs(e, "", "vbit.f64 d0, d1, d2", "F3210112")
	e = armGateIs(e, "", "vceq.i8 d0, d1, d2", "F3010812")
	e = armGateIs(e, "", "vceq.s16 d0, d1, d2", "F3110812")
	e = armGateIs(e, "", "vceq.f32 q0, q1", "F2000E42")
	e = armGateIs(e, "", "vcge.u8 d0, d1, d2", "F3010312")
	e = armGateIs(e, "", "vcle.s8 d0, d1, d2", "F2020311")
	e = armGateIs(e, "", "vclt.f32 q0, q1, q2", "F3240E42")
	e = armGateIs(e, "", "vacle.f32 d0, d1", "F3010E10")
	e = armGateIs(e, "", "vaclt.f32 q0, q1", "F3220E50")
	e = armGateIs(e, "", "vtst.8 q0, q1", "F2000852")
	e = armGateIs(e, "", "vtst.p8 d0, d1, d2", "F2010812")
	e = armGateIs(e, "", "vtst.f32 d0, d1, d2", "F2210812")
	e = armGateIs(e, "", "vabd.f32 d0, d1, d2", "F3210D02")
	e = armGateIs(e, "", "vaba.u16 q0, q1, q2", "F3120754")
	e = armGateIs(e, "", "vpadd.f32 d0, d1", "F3000D01")
	e = armGateIs(e, "", "vpmin.u32 d0, d1, d2", "F3210A12")
	e = armGateIs(e, "", "vqdmulh.s16 d0, d1, d2", "F2110B02")
	e = armGateIs(e, "", "vrecps.f32 d0, d1, d2", "F2010F12")
	e = armGateIs(e, "", "vrsqrts.f q0, q1", "F2200F52")
	e = armGateIs(e, "", "vshl.s32 d0, d1, d2", "F2220401")
	e = armGateIs(e, "", "vshl.s32 d0, d1", "F2210400")
	e = armGateIs(e, "", "vqrshl.u8 q0, q1", "F3020550")
	e = armGateIs(e, h, "vceq.f16 d0, d1, d2", "F2110E02")
	e = armGateIs(e, h, "vmax.f16 q0, q1, q2", "F2120F44")
	return e
}

// The names the VFP has too, in their NEON forms as clang assembles them: integer, polynomial and
// floating-point types, two-operand forms (VADD, VMUL), a signed type for VMLS's integer one, the
// fused ones with VFPv4 (or full FP16), and the q aliases vaddq and vmulq.
func TestParseArm32Neon3VfpNames() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vadd.i8 d0, d1, d2", "F2010802")
	e = armGateIs(e, "", "vadd.i64 q0, q1", "F2300842")
	e = armGateIs(e, "", "vsub.f32 q0, q1, q2", "F2220D44")
	e = armGateIs(e, "", "vmul.p8 d0, d1", "F3000911")
	e = armGateIs(e, "", "vmul.p8 d0, d1, d2", "F3010912")
	e = armGateIs(e, h, "vmul.f16 d0, d1, d2", "F3110D12")
	e = armGateIs(e, "", "vmla.i32 q0, q1, q2", "F2220944")
	e = armGateIs(e, "", "vmls.f32 d0, d1, d2", "F2210D12")
	e = armGateIs(e, "", "vmls.s16 d0, d1, d2", "F3110902")
	e = armGateIs(e, ".fpu neon-vfpv4", "vfma.f32 q0, q1, q2", "F2020C54")
	e = armGateIs(e, h, "vfms.f16 d0, d1, d2", "F2310C12")
	e = armGateIs(e, "", "vaddq.f32 q0, q1, q2", "F2020D44")
	e = armGateIs(e, "", "vmulq.i16 d0, d1", "F2100911")
	return e
}

// What clang does not take of those NEON forms: two operands for VMLA; a type VMUL has not; the
// fused ones without VFPv4 (and NEON); a condition (here the not-predicable error); an `s` after
// VMLS, VFMS or MVE's VMLAS, which end in one of their own; and MVE's encodings of them as near
// misses: VMLAS / VFMAS, VMLA's and VADD's with a core register (SP only from ARMv8), not VFMS's.
func TestParseArm32Neon3VfpNameRejects() testing.TestResult {
	var e @[]char = ""
	var v3 *[]readonly char = ".fpu vfpv3"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	var cond *[]readonly char = "' is not predicable, but condition code specified"
	e = armMsgIs(e, "", "vmla.i8 d0, d1", "too few operands for instruction")
	e = armMsgIs(e, "", "vmul.i64 d0, d1, d2", "invalid operand for instruction")
	e = armMsgIs(e, v3, "vfma.f32 d0, d1, d2", "instruction requires: NEON VFP4")
	e = armMsgIs(e, ".fpu neon", "vfma.f32 d0, d1, d2", "instruction requires: VFP4")
	e = armMsgIs(e, "", "vmlseq.i8 d0, d1, d2", armQuote("vmls", cond))
	e = armMsgIs(e, "", "vmlss.f32 d0, d1, d2", armQuote("vmls", flags))
	e = armMsgIs(e, "", "vfmss.f32 d0, d1, d2", armQuote("vfms", flags))
	e = armMsgIs(e, "", "vmlass.i8 q0, q1, r2", armQuote("vmlas", flags))
	e = armMsgIs(e, v3, "vmlas.i8 q0, q1, r2", "instruction requires: mve")
	e = armMsgIs(e, v3, "vfmas.f32 q0, q1, r2", "instruction requires: mve.fp")
	e = armMsgIs(e, v3, "vmla.i8 q0, q1, r2", "instruction requires: mve")
	e = armMsgIs(e, "", "vmla.i8 q0, q1, r2",
			"invalid instruction, any one of the following would fix this:")
	e = armMsgIs(e, v3, "vadd.f32 q0, q1, r2", "instruction requires: mve.fp")
	e = armMsgIs(e, v3, "vfma.f16 q0, q1, r2", "instruction requires: mve.fp")
	e = armMsgIs(e, v3, "vfms.f32 q0, q1, r2", "invalid instruction")
	e = armMsgIs(e, v3, "vmlas q0, q1, r2", "invalid instruction")
	e = armMsgIs(e, v3, "vmul.i16 q0, q1, sp", "invalid instruction")
	e = armMsgIs(e, ".arch armv8-a\n.fpu vfpv3", "vmul.i16 q0, q1, sp", "instruction requires: mve")
	return e
}

// What clang does not take of them, with its message: a data type the instruction has not, or
// none; a Q form of a pairwise one; a type on VORN; too few operands for a three-operand-only one;
// a D and a Q register mixed; F16 without full FP16 (with the F32 form's near miss); no NEON; an
// `s` after the name; and here a condition, which clang drops.
func TestParseArm32Neon3Rejects() testing.TestResult {
	var e @[]char = ""
	var bad *[]readonly char = "invalid operand for instruction"
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var few *[]readonly char = "too few operands for instruction"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	var cond *[]readonly char = "' is not predicable, but condition code specified"
	e = armMsgIs(e, "", "vhadd.i8 d0, d1, d2", bad)
	e = armMsgIs(e, "", "vhadd d0, d1, d2", bad)
	e = armMsgIs(e, "", "vhadd.s64 d0, d1, d2", bad)
	e = armMsgIs(e, "", "vqdmulh.s8 d0, d1, d2", bad)
	e = armMsgIs(e, "", "vtst.i64 d0, d1, d2", bad)
	e = armMsgIs(e, "", "vacge.s32 d0, d1, d2", bad)
	e = armMsgIs(e, "", "vpadd.f32 q0, q1, q2", "invalid instruction")
	e = armMsgIs(e, "", "vorn.i32 d0, d1, d2", "invalid instruction")
	e = armMsgIs(e, "", "vaba.s8 d0, d1", few)
	e = armMsgIs(e, "", "vbsl d0, d1", few)
	e = armMsgIs(e, "", "vhadd.s8 d0, d1, q2", several)
	e = armMsgIs(e, "", "vceq.f16 d0, d1, d2", several)
	e = armMsgIs(e, "", "vrecps.f16 d0, d1", several)
	e = armMsgIs(e, ".fpu vfpv3", "vhadd.s8 d0, d1, d2", "instruction requires: NEON")
	e = armMsgIs(e, ".fpu vfpv4", "vand d0, d1, d2", "instruction requires: NEON")
	e = armMsgIs(e, ".fpu none", "vceq.f32 d0, d1, d2", "instruction requires: NEON")
	e = armMsgIs(e, "", "vhadds.s8 d0, d1, d2", armQuote("vhadd", flags))
	e = armMsgIs(e, "", "vceqs.i8 d0, d1, d2", armQuote("vceq", flags))
	e = armMsgIs(e, "", "vrecpss.f32 d0, d1, d2", armQuote("vrecps", flags))
	e = armMsgIs(e, "", "vhaddeq.s8 d0, d1, d2", armQuote("vhadd", cond))
	e = armMsgIs(e, "", "vceqeq.i8 d0, d1, d2", armQuote("vceq", cond))
	e = armMsgIs(e, "", "vhaddeqs.s8 d0, d1, d2", armQuote("vhaddeq", flags))
	return e
}

// The near misses clang's MVE encodings of these names add in ARM code, where NEON's drop out (no
// NEON): Q0..Q7 with a core register MVE takes (Qd, Qn, Rm; Qda, Rm; SP only from ARMv8, PC
// never), and none for Q8 or VABD's core register (MVE has no such VABD); with NEON, a type only
// MVE has (VQDMULH.S8); but not MVE's aliases, which want Thumb code (VAND.F16 is NEON's one near
// miss).  And a lane, which clang reads as an operand of its own after a register: a number (a
// floating-point literal's bit pattern too), with its messages.
func TestParseArm32Neon3MveAndLanes() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var mve *[]readonly char = "instruction requires: mve"
	var v3 *[]readonly char = ".fpu vfpv3"
	var v8 *[]readonly char = ".arch armv8-a\n.fpu vfpv3"
	e = armMsgIs(e, v3, "vhadd.s8 q0, q1, r2", mve)
	e = armMsgIs(e, v3, "vshl.s8 q0, r1", mve)
	e = armMsgIs(e, v3, "vqdmulh.s8 q0, q1, r2", mve)
	e = armMsgIs(e, v3, "vqsub.s8 q0, q1, r12", mve)
	e = armMsgIs(e, v3, "vhadd.s8 q0, q1, sp", "invalid instruction")
	e = armMsgIs(e, v8, "vhadd.s8 q0, q1, sp", mve)
	e = armMsgIs(e, v8, "vshl.s8 q0, sp", mve)
	e = armMsgIs(e, v3, "vhadd.s8 q0, q1, pc", "invalid instruction")
	e = armMsgIs(e, v8, "vhadd.s8 q0, q1, pc", "invalid instruction")
	e = armMsgIs(e, v3, "vhadd.s8 q8, q1, r2", "invalid instruction")
	e = armMsgIs(e, v3, "vabd.f32 q0, q1, r2", "invalid instruction")
	e = armMsgIs(e, v3, "vabd.f32 q0, q1, q2", several)
	e = armMsgIs(e, v3, "vhadd.s8 q0, q1, q2", several)
	e = armMsgIs(e, "", "vqdmulh.s8 q0, q1, q2", several)
	e = armMsgIs(e, "", "vand.f16 q0, q1, q2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vrhadd.s8 d0, d1, d2[1]", "too many operands for instruction")
	e = armMsgIs(e, "", "vrhadd.s8 d0, d1, d2[1.0]", "too many operands for instruction")
	e = armMsgIs(e, "", "vrhadd.s8 d0, d1[x], d2", "immediate value expected for vector index")
	e = armMsgIs(e, "", "vrhadd.s8 d0, d1, d2[\"a\"]", "immediate value expected for vector index")
	e = armMsgIs(e, "", "vrhadd.s8 d0, d1[1, d2", "']' expected")
	return e
}

// clang's NEON q aliases of these names (vandq, vbicq, veorq, vorrq, vminq, vmaxq, vshlq, vceqq,
// vcleq) are the instructions, D and Q forms alike, with a condition after the q (clang's, and
// here the not-predicable error) or an `s`; vcleq alone is VCLE, and vcleq.s8 VCL with EQ, as
// clang splits it; without NEON none is an instruction.
func TestParseArm32Neon3QAliases() testing.TestResult {
	var e @[]char = ""
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	var cond *[]readonly char = "' is not predicable, but condition code specified"
	e = armGateIs(e, "", "vandq q0, q1, q2", "F2020154")
	e = armGateIs(e, "", "vandq d0, d1, d2", "F2010112")
	e = armGateIs(e, "", "vandq.i32 q0, q1, q2", "F2020154")
	e = armGateIs(e, "", "vbicq d0, d1", "F2100111")
	e = armGateIs(e, "", "veorq q0, q1", "F3000152")
	e = armGateIs(e, "", "vorrq q0, q1, q2", "F2220154")
	e = armGateIs(e, "", "vminq.s8 q0, q1, q2", "F2020654")
	e = armGateIs(e, "", "vminq.f32 d0, d1, d2", "F2210F02")
	e = armGateIs(e, "", "vmaxq.u16 q0, q1", "F3100642")
	e = armGateIs(e, "", "vshlq.s8 q0, q1, q2", "F2040442")
	e = armGateIs(e, "", "vceqq.i8 q0, q1, q2", "F3020854")
	e = armMsgIs(e, "", "vceqqeq.i8 q0, q1, q2", armQuote("vceq", cond))
	e = armMsgIs(e, "", "vcleqeq.s8 q0, q1, q2", armQuote("vcle", cond))
	e = armMsgIs(e, "", "vandqs q0, q1, q2", armQuote("vandq", flags))
	e = armMsgIs(e, "", "vcleqs.s8 q0, q1, q2", armQuote("vcleq", flags))
	e = armMsgIs(e, "", "vcleq q0, q1, q2", "invalid instruction")
	e = armMsgIs(e, "", "vminq q0, q1, q2", "invalid operand for instruction")
	e = armMsgIs(e, ".fpu vfpv3", "vandq q0, q1, q2", "invalid instruction")
	return e
}

// ARMv8.1's VQRDMLAH and VQRDMLSH as clang assembles them: .S16 and .S32 on D and Q registers and
// by a scalar (D0..D7 and lanes 0..3 for .S16, D0..D15 and lanes 0..1 for .S32), high registers,
// upper case, AL.
func TestParseArm32NeonV8_1() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = ".arch armv8.1-a"
	e = armGateIs(e, c, "vqrdmlah.s16 d0, d1, d2", "F3110B12")
	e = armGateIs(e, c, "vqrdmlah.s32 q15, q14, q13", "F36CEBFA")
	e = armGateIs(e, c, "vqrdmlsh.s16 d31, d30, d29", "F35EFCBD")
	e = armGateIs(e, c, "vqrdmlsh.s32 q0, q1, q2", "F3220C54")
	e = armGateIs(e, c, "vqrdmlah.s16 d0, d1, d7[3]", "F2910E6F")
	e = armGateIs(e, c, "vqrdmlah.s32 q15, q14, d15[1]", "F3ECEEEF")
	e = armGateIs(e, c, "vqrdmlsh.s16 q0, q1, d2[1]", "F3920F4A")
	e = armGateIs(e, c, "vqrdmlsh.s32 d0, d1, d2[0]", "F2A10F42")
	e = armGateIs(e, c, "VQRDMLAH.S16 D0, D1, D2", "F3110B12")
	e = armGateIs(e, c, "vqrdmlahal.s16 d0, d1, d2", "F3110B12")
	return e
}

// What clang does not take of them, with its message: no ARMv8.1, no NEON, neither (in clang's
// order of features), a scalar register or lane past the size's (the other size's a near miss too),
// another type or none, no two-operand form, a core register (MVE's VQRDMLAH a near miss), an
// operand too many; and here a condition, which clang drops.
func TestParseArm32NeonV8_1Rejects() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = ".arch armv8.1-a"
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = armMsgIs(e, "", "vqrdmlah.s16 d0, d1, d2", "instruction requires: armv8.1a")
	e = armMsgIs(e, ".arch armv8-a", "vqrdmlsh.s32 q0, q1, d2[1]", "instruction requires: armv8.1a")
	e = armMsgIs(e, ".arch armv8.1-a\n.fpu vfpv4", "vqrdmlah.s16 d0, d1, d2",
			"instruction requires: NEON")
	e = armMsgIs(e, ".fpu vfpv4", "vqrdmlah.s16 d0, d1, d2", "instruction requires: NEON armv8.1a")
	e = armMsgIs(e, "", "vqrdmlah.s16 q0, q1, r2", "instruction requires: mve")
	e = armMsgIs(e, c, "vqrdmlah.s16 d0, d1, d8[0]", several)
	e = armMsgIs(e, c, "vqrdmlah.s32 d0, d1, d2[2]", several)
	e = armMsgIs(e, c, "vqrdmlah.s16 d0, d1, d2[4]", "invalid operand for instruction")
	e = armMsgIs(e, c, "vqrdmlah.i16 d0, d1, d2", "invalid operand for instruction")
	e = armMsgIs(e, c, "vqrdmlah d0, d1, d2", "invalid instruction")
	e = armMsgIs(e, c, "vqrdmlah.s16 d0, d1", "too few operands for instruction")
	e = armMsgIs(e, c, "vqrdmlah.s16 d0, d2[1]", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, c, "vqrdmlsh.s16 q0, q1, r2", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "vqrdmlah.s16 d0, d1, d2, d3", "invalid operand for instruction")
	e = armMsgIs(e, c, "vqrdmlaheq.s16 d0, d1, d2",
			"instruction 'vqrdmlah' is not predicable, but condition code specified")
	return e
}
