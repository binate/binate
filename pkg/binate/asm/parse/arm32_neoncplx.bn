package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// ARMv8.3's complex-number instructions, VCMLA and VCADD (asm/arm32/neon's Cmla, CmlaLane and
// Cadd), as clang takes them: .F32, and .F16 with full FP16, on three D or three Q registers and a
// rotation -- VCMLA's 0, 90, 180 or 270, VCADD's 90 or 270, clang's named classes ("complex
// rotation must be 0, 90, 180 or 270") -- and VCMLA by a scalar too (.F16's D0..D15 with lane 0..1,
// .F32's any D register with lane 0), with NEON and ARMv8.3; MVE's VCMLA (.F32, .F16) and VCADD
// (and .I8 .. .I32) on Q0..Q7 as near misses.  clang takes no condition on them, an error before
// their operands are read (arm32VdpNoCond).

// The instructions here (arm32NeonCplxOp).
const (
	neonCplxMla int = iota + 1
	neonCplxAdd
)

// arm32NeonCplxOp returns which of these name (lowercase, split) is (neonCplx*), or 0 for none.
func arm32NeonCplxOp(name *[]readonly char) int {
	if charsEqual(name, "vcmla") { return neonCplxMla }
	if charsEqual(name, "vcadd") { return neonCplxAdd }
	return 0
}

// arm32NeonCplxCands returns the encodings clang tries for name (arm32NeonCplxOp), in its order:
// NEON's .F32 on Q, then D registers, and .F16's (with full FP16), with no condition operand;
// VCMLA's by a scalar; then MVE's.
func arm32NeonCplxCands(name *[]readonly char) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 10)
	var op int = arm32NeonCplxOp(name)
	var d int = matchKindD
	var q int = matchKindQ
	var mq int = matchKindMQ
	var rot int = matchKindRotEven
	if op == neonCplxAdd { rot = matchKindRotOdd }
	var nc int = matchFormSIMDNoCond
	var need int = matchNeedNEON | matchNeedV8_3
	var half int = need | matchNeedFull16
	var f32 int = matchTypeF32
	var f16 int = matchTypeF16
	matchAdd(list, f32, 0, matchOps4(q, q, q, rot), need, nc)
	matchAdd(list, f32, 0, matchOps4(d, d, d, rot), need, nc)
	matchAdd(list, f16, 0, matchOps4(q, q, q, rot), half, nc)
	matchAdd(list, f16, 0, matchOps4(d, d, d, rot), half, nc)
	if op == neonCplxMla {
		var lane int = matchKindLane64
		matchAdd(list, f32, 0, matchOps6(q, q, d, lane, rot, 0), need, nc)
		matchAdd(list, f32, 0, matchOps6(d, d, d, lane, rot, 0), need, nc)
		var dm int = matchKindDScalar32
		lane = matchKindLane32
		matchAdd(list, f16, 0, matchOps6(q, q, dm, lane, rot, 0), half, nc)
		matchAdd(list, f16, 0, matchOps6(d, d, dm, lane, rot, 0), half, nc)
		matchAdd(list, f32, 0, matchOps4(mq, mq, mq, rot), matchNeedMVEFP, matchFormMVE)
		matchAdd(list, f16, 0, matchOps4(mq, mq, mq, rot), matchNeedMVEFP, matchFormMVE)
	} else {
		var mve int = matchFormMVE
		matchAdd(list, f32, 0, matchOps4(mq, mq, mq, rot), matchNeedMVEFP, mve)
		matchAdd(list, matchTypeI16, 0, matchOps4(mq, mq, mq, rot), matchNeedMVE, mve)
		matchAdd(list, matchTypeI32, 0, matchOps4(mq, mq, mq, rot), matchNeedMVE, mve)
		matchAdd(list, matchTypeI8, 0, matchOps4(mq, mq, mq, rot), matchNeedMVE, mve)
		matchAdd(list, f16, 0, matchOps4(mq, mq, mq, rot), matchNeedMVEFP, mve)
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonCplxEmit assembles name (arm32NeonCplxOp) as encoding c, its operands items: Vd, Vn, Vm
// and the rotation, or for VCMLA by a scalar Vd, Vn, Dm, the lane and the rotation.
func arm32NeonCplxEmit(p @Parser, name *[]readonly char, c arm32MatchCand,
		items @[]arm32MatchItem) {
	var size int = 16
	if c.t1 == matchTypeF32 { size = 32 }
	var vd int = arm32NeonReg(items[0])
	var vn int = arm32NeonReg(items[1])
	var vm int = arm32NeonReg(items[2])
	if arm32NeonCplxOp(name) == neonCplxAdd {
		neon.Cadd(p.Asm, size, vd, vn, vm, cast(int, items[3].val))
		return
	}
	if arm32MatchKindAt(c.ops, 4) == 0 {
		neon.Cmla(p.Asm, size, vd, vn, vm, cast(int, items[3].val))
		return
	}
	var x int = cast(int, cast(uint32, items[3].val))
	neon.CmlaLane(p.Asm, size, vd, vn, vm, x, cast(int, items[4].val))
}
