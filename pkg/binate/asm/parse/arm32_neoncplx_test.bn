package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// arm32NeonCplxCtx is the directives that give the complex-number instructions their features:
// ARMv8.3 (with NEON) and full FP16.
var arm32NeonCplxCtx *[]readonly char = ".arch armv8.3-a\n.arch_extension fp16"

// The complex-number instructions as clang assembles them: VCMLA .F32 and .F16 on D and Q
// registers and by a scalar (.F32's lane 0 of any D register, .F16's D0..D15 with lanes 0..1),
// VCADD .F32 on Q and .F16 on D registers, each rotation, a rotation written with no `#` or in
// hex, upper case, and .F32 with ARMv8.3 alone.
func TestParseArm32NeonCplx() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32NeonCplxCtx
	e = armGateIs(e, c, "vcmla.f32 d0, d1, d2, #0", "FC310802")
	e = armGateIs(e, c, "vcmla.f16 q15, q14, q13, #90", "FCECE8EA")
	e = armGateIs(e, c, "vcmla.f32 q0, q1, d2[0], #90", "FE920842")
	e = armGateIs(e, c, "vcmla.f32 q15, q12, d31[0], #270", "FEF8E8EF")
	e = armGateIs(e, c, "vcmla.f16 q1, q6, d1[1], #180", "FE2C2861")
	e = armGateIs(e, c, "vcmla.f16 d18, d31, d6[0], #180", "FE6F2886")
	e = armGateIs(e, c, "vcmla.f32 q0, q1, q2, #180", "FD320844")
	e = armGateIs(e, c, "vcmla.f16 d0, d1, d2, #270", "FDA10802")
	e = armGateIs(e, c, "vcadd.f32 q0, q1, q2, #270", "FD920844")
	e = armGateIs(e, c, "vcadd.f16 d31, d30, d29, #90", "FCCEF8AD")
	e = armGateIs(e, c, "vcmla.f32 d0, d1, d2, 90", "FCB10802")
	e = armGateIs(e, c, "vcmla.f32 d0, d1, d2, #0x5a", "FCB10802")
	e = armGateIs(e, c, "VCMLA.F32 D0, D1, D2, #90", "FCB10802")
	e = armGateIs(e, ".arch armv8.3-a", "vcmla.f32 d0, d1, d2, #90", "FCB10802")
	return e
}

// What clang does not take of them, with its message: a rotation outside the named class (45, -90,
// a floating-point literal, a label; 0 and 180 for VCADD), no ARMv8.3, no full FP16 or NEON (in
// clang's order of features), a lane past the scalar's, a scalar past D15 for .F16, a type of no
// encoding or none, an operand too few or too many, a register of another class (MVE's VCADD a
// near miss for .I32); a condition (the error before the operands are read), an `s`.
func TestParseArm32NeonCplxRejects() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32NeonCplxCtx
	var even *[]readonly char = "complex rotation must be 0, 90, 180 or 270"
	var odd *[]readonly char = "complex rotation must be 90 or 270"
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d2, #45", even)
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d2, #-90", even)
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d2, #90.0", even)
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d2, lbl", even)
	e = armMsgIs(e, c, "vcadd.f32 d0, d1, d2, #0", odd)
	e = armMsgIs(e, c, "vcadd.f32 d0, d1, d2, #180", odd)
	e = armMsgIs(e, "", "vcmla.f32 d0, d1, d2, #90", "instruction requires: armv8.3a")
	e = armMsgIs(e, "", "vcmla.f16 d0, d1, d2, #90", "instruction requires: full half-float armv8.3a")
	e = armMsgIs(e, ".arch armv8.3-a\n.fpu vfpv4", "vcmla.f16 d0, d1, d2, #90",
			"instruction requires: full half-float NEON")
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d0[1], #90", several)
	e = armMsgIs(e, c, "vcmla.f16 d0, d1, d2[2], #0", "invalid operand for instruction")
	e = armMsgIs(e, c, "vcmla.f16 d0, d1, d16[1], #0", "operand must be a register in range [d0, d15]")
	e = armMsgIs(e, c, "vcmla.f64 d0, d1, d2, #90", "invalid operand for instruction")
	e = armMsgIs(e, c, "vcmla d0, d1, d2, #90", "invalid instruction")
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d2", "too few operands for instruction")
	e = armMsgIs(e, c, "vcmla.f32 d0, d1, d2, #90, #0", several)
	e = armMsgIs(e, c, "vcmla.f32 q0, q1, d2, #90", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "vcadd.f32 q0, q1, r2, #90", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "vcadd.i32 q0, q1, q2, #90", several)
	e = armMsgIs(e, c, "vcmlaeq.f32 d0, d1, d2, #90",
			"instruction 'vcmla' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "vcadds.f32 d0, d1, d2, #90",
			"instruction 'vcadd' can not set flags, but 's' suffix specified")
	return e
}
