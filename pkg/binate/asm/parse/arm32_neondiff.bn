package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// NEON's three registers of different lengths (asm/arm32/neon's Diff), as clang takes them: the
// long ones (VADDL, VSUBL, VABAL, VABDL, VMLAL, VMLSL, VMULL, VQDMLAL, VQDMLSL, VQDMULL) Qd, Dn,
// Dm; the wide ones (VADDW, VSUBW) Qd, Qn, Dm and Qd, Dm for Qd, Qd, Dm; the narrowing ones
// (VADDHN, VRADDHN, VSUBHN, VRSUBHN) Dd, Qn, Qm.  Their data types are .S8 .. .S32 and .U8 ..
// .U32 (the saturating ones .S16 and .S32; VMULL .P8 and ARMv8's .P64 with AES, which wants no
// NEON and has no condition operand), and .I16 .. .I64 for the narrowing ones (.S or .U standing
// for .I).  MVE has none of these names.

// arm32NeonDiffOp returns the operation (neon.DIFF_*) name (lowercase, split) names, or 0.
func arm32NeonDiffOp(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"vaddl", "vaddw", "vsubl", "vsubw", "vaddhn",
			"vraddhn", "vabal", "vsubhn", "vrsubhn", "vabdl", "vmlal", "vqdmlal", "vmlsl", "vqdmlsl",
			"vmull", "vqdmull"}
	var ops @[]int = @[]int{neon.DIFF_VADDL, neon.DIFF_VADDW, neon.DIFF_VSUBL, neon.DIFF_VSUBW,
			neon.DIFF_VADDHN, neon.DIFF_VRADDHN, neon.DIFF_VABAL, neon.DIFF_VSUBHN, neon.DIFF_VRSUBHN,
			neon.DIFF_VABDL, neon.DIFF_VMLAL, neon.DIFF_VQDMLAL, neon.DIFF_VMLSL, neon.DIFF_VQDMLSL,
			neon.DIFF_VMULL, neon.DIFF_VQDMULL}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return ops[i] }
	}
	return 0
}

// arm32NeonDiffCands returns the encodings clang tries for name (arm32NeonDiffOp), in its order:
// each data type on the registers' lengths, and for a wide one on two registers as well.
func arm32NeonDiffCands(name *[]readonly char) @arm32MatchList {
	var op int = arm32NeonDiffOp(name)
	var q int = matchKindQ
	var d int = matchKindD
	var ops int = matchOps(q, d, d)
	var wide bool = op == neon.DIFF_VADDW || op == neon.DIFF_VSUBW
	if wide { ops = matchOps(q, q, d) }
	var narrow bool = op == neon.DIFF_VADDHN || op == neon.DIFF_VRADDHN || op == neon.DIFF_VSUBHN ||
			op == neon.DIFF_VRSUBHN
	if narrow { ops = matchOps(d, q, q) }
	var types @[]int = @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeU8, matchTypeU16,
			matchTypeU32}
	if op == neon.DIFF_VQDMLAL || op == neon.DIFF_VQDMLSL || op == neon.DIFF_VQDMULL {
		types = @[]int{matchTypeS16, matchTypeS32}
	}
	if narrow { types = @[]int{matchTypeI16, matchTypeI32, matchTypeI64} }
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 2 * len(types) + 2)
	for i := 0; i < len(types); i++ {
		matchAdd(list, types[i], 0, ops, matchNeedNEON, matchFormSIMD)
		if wide { matchAdd(list, types[i], 0, matchOps(q, d, 0), matchNeedNEON, matchFormSIMD) }
	}
	if op == neon.DIFF_VMULL {
		matchAdd(list, matchTypeP8, 0, ops, matchNeedNEON, matchFormSIMD)
		matchAdd(list, matchTypeP64, 0, ops, matchNeedV8 | matchNeedAES, matchFormSIMDNoCond)
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonDiffEmit assembles operation op (neon.DIFF_*) of name under cond as encoding c, its
// operands items -- Vd, Vn, Vm, or Qd, Dm for Qd, Qd, Dm -- unconditional.
func arm32NeonDiffEmit(p @Parser, name *[]readonly char, op int, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var vd int = arm32NeonReg(items[0])
	var vn int = vd
	var vm int = arm32NeonReg(items[1])
	if arm32MatchKindAt(c.ops, 2) != 0 {
		vn = vm
		vm = arm32NeonReg(items[2])
	}
	neon.Diff(p.Asm, op, arm32NeonDT(c.t1), vd, vn, vm)
}
