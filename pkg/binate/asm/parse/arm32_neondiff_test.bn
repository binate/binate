package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each name is its operation; VADDW and VSUBW have two operand forms per type, VMULL P8 and P64
// besides its six, the saturating ones two types, the narrowing ones three; the long multiplies
// their by-scalar encodings too (four for VMULL, two for VQDMLAL).
func TestArm32NeonDiffEncodings() testing.TestResult {
	if arm32NeonDiffOp("vaddl") != neon.DIFF_VADDL ||
			arm32NeonDiffOp("vqdmull") != neon.DIFF_VQDMULL || arm32NeonDiffOp("vadd") != 0 {
		return fail("a three-different-lengths name's operation is wrong")
	}
	var names @[]*[]readonly char = @[]*[]readonly char{"vaddl", "vaddw", "vmull", "vqdmlal",
			"vrsubhn"}
	var counts @[]int = @[]int{6, 12, 12, 4, 3}
	for i := 0; i < len(names); i++ {
		if arm32NeonDiffCands(names[i]).n != counts[i] {
			return fail(buf.Concat("wrong count of encodings: ", names[i]))
		}
	}
	return ""
}

// The long, wide and narrowing operations as clang assembles them: .S / .U types (and .S / .U for
// the narrowing ones' .I), high registers, VADDW / VSUBW's two-operand form, VMULL.P8 and, with
// ARMv8 and AES, VMULL.P64.
func TestParseArm32NeonDiffForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vaddl.s8 q0, d1, d2", "F2810002")
	e = armGateIs(e, "", "vaddl.u32 q8, d17, d31", "F3E100AF")
	e = armGateIs(e, "", "vaddw.s16 q0, q1, d2", "F2920102")
	e = armGateIs(e, "", "vaddw.s16 q0, d1", "F2900101")
	e = armGateIs(e, "", "vsubw.u8 q0, d1", "F3800301")
	e = armGateIs(e, "", "vsubl.s32 q8, d17, d31", "F2E102AF")
	e = armGateIs(e, "", "vaddhn.i64 d31, q15, q14", "F2EEF4AC")
	e = armGateIs(e, "", "vaddhn.u32 d0, q1, q2", "F2920404")
	e = armGateIs(e, "", "vraddhn.s16 d0, q1, q2", "F3820404")
	e = armGateIs(e, "", "vsubhn.i64 d0, q1, q2", "F2A20604")
	e = armGateIs(e, "", "vrsubhn.i32 d31, q15, q14", "F3DEF6AC")
	e = armGateIs(e, "", "vabal.s32 q8, d17, d31", "F2E105AF")
	e = armGateIs(e, "", "vabdl.u16 q0, d1, d2", "F3910702")
	e = armGateIs(e, "", "vmlal.u8 q8, d17, d31", "F3C108AF")
	e = armGateIs(e, "", "vmlsl.s16 q0, d1, d2", "F2910A02")
	e = armGateIs(e, "", "vmull.p8 q8, d17, d31", "F2C10EAF")
	e = armGateIs(e, "", "vmull.u32 q0, d1, d2", "F3A10C02")
	e = armGateIs(e, ".arch armv8-a", "vmull.p64 q8, d17, d31", "F2E10EAF")
	e = armGateIs(e, "", "vqdmull.s16 q8, d17, d31", "F2D10DAF")
	e = armGateIs(e, "", "vqdmlal.s32 q0, d1, d2", "F2A10902")
	e = armGateIs(e, "", "vqdmlsl.s16 q8, d17, d31", "F2D10BAF")
	return e
}

// What clang does not take of them, with its message: a type they have not (.I8 for VADDL, .S8
// for VQDMULL); too few operands; VADDW's Q, Q (its two forms' near misses); a Q register where a D
// register is; no NEON; VMULL.P64 without ARMv8 (and the P8 form a type off), and without AES (no
// NEON wanted); an `s` after the name, and here a condition, which clang drops.
func TestParseArm32NeonDiffRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	var cond *[]readonly char = "' is not predicable, but condition code specified"
	e = armMsgIs(e, "", "vaddl.i8 q0, d1, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vqdmull.s8 q0, d1, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vaddl.s8 q0, d1", "too few operands for instruction")
	e = armMsgIs(e, "", "vaddhn.i16 d0, q1", "too few operands for instruction")
	e = armMsgIs(e, "", "vaddw.s8 q0, q1", several)
	e = armMsgIs(e, "", "vaddl.s8 q0, d1, q2", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, ".fpu vfpv3", "vaddl.s8 q0, d1, d2", "instruction requires: NEON")
	e = armMsgIs(e, "", "vmull.p64 q0, d1, d2", several)
	e = armMsgIs(e, ".arch armv8-a\n.arch_extension nocrypto", "vmull.p64 q0, d1, d2",
			"instruction requires: aes")
	e = armMsgIs(e, ".arch armv8-a\n.arch_extension nosimd", "vmull.p64 q0, d1, d2",
			"instruction requires: aes")
	e = armMsgIs(e, "", "vmullseq.s8 q0, d1, d2", armQuote("vmull", flags))
	e = armMsgIs(e, "", "vaddleq.s8 q0, d1, d2", armQuote("vaddl", cond))
	return e
}

// A mnemonic that starts with VMULL and ends with .P64 is never predicable to clang: a condition
// split off it is its error, naming what is left (VMUL for vmulle.p64; vmulla for vmullals.p64,
// no instruction), before the operands are read, NEON in effect or not, in any case, after an
// `s`'s; .P64 then .W or .N has a condition matched against the encodings (and the `.n` error
// first), AL none.
func TestParseArm32NeonDiffP64Condition() testing.TestResult {
	var e @[]char = ""
	var v8 *[]readonly char = ".arch armv8-a"
	var cond *[]readonly char = "' is not predicable, but condition code specified"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	e = armMsgIs(e, v8, "vmulleq.p64 q0, d1, d2", armQuote("vmull", cond))
	e = armMsgIs(e, v8, "VMULLEQ.P64 q0, d1, d2", armQuote("vmull", cond))
	e = armMsgIs(e, v8, "vmulleq.w.p64 q0, d1, d2", armQuote("vmull", cond))
	e = armMsgIs(e, ".fpu vfpv3", "vmulleq.p64 q0,, d1", armQuote("vmull", cond))
	e = armMsgIs(e, v8, "vmulle.p64 q0, d1, d2", armQuote("vmul", cond))
	e = armMsgIs(e, v8, "vmullals.p64 q0, d1, d2", armQuote("vmulla", cond))
	e = armMsgIs(e, v8, "vmullseq.p64 q0, d1, d2", armQuote("vmull", flags))
	e = armMsgIs(e, v8, "vmulleq.p64.w q0, d1, d2", "invalid operand for instruction")
	e = armMsgIs(e, v8, "vmulleq.p64.n q0, d1, d2",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armGateIs(e, v8, "vmullal.p64 q0, d1, d2", "F2A10E02")
	e = armGateIs(e, v8, "VMULL.P64 q0, d1, d2", "F2A10E02")
	return e
}
