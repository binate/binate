package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/asm/arm32/vfp"

// ARMv8.2's dot products, VSDOT.S8 and VUDOT.U8, and FP16 multiply-adds long, VFMAL.F16 and
// VFMSL.F16 (asm/arm32/neon's Dot, DotLane, Fmal and FmalLane), as clang takes them: VSDOT / VUDOT
// on three D or three Q registers, or on two and a scalar (D0..D15, lane 0..1), with the dot
// product; VFMAL / VFMSL as Qd, Dn, Dm or Dd, Sn, Sm, or by a scalar -- Dm[x] (D0..D7, x 0..3) or
// Sm[x] (S0..S15, x 0..1) -- with NEON and FP16FML.  clang takes no condition on them, an error
// before their operands are read (arm32VdpNoCond).

// The instructions here (arm32NeonDotOp).
const (
	neonDotS int = iota + 1
	neonDotU
	neonDotFmal
	neonDotFmsl
)

// arm32NeonDotOp returns which of these name (lowercase, split) is (neonDot*), or 0 for none.
func arm32NeonDotOp(name *[]readonly char) int {
	if charsEqual(name, "vsdot") { return neonDotS }
	if charsEqual(name, "vudot") { return neonDotU }
	if charsEqual(name, "vfmal") { return neonDotFmal }
	if charsEqual(name, "vfmsl") { return neonDotFmsl }
	return 0
}

// arm32NeonDotCands returns the encodings clang tries for name (arm32NeonDotOp), in its order, none
// with a condition operand: VSDOT's (.S8) and VUDOT's (.U8) on Q, then D registers, and by a
// scalar; VFMAL's and VFMSL's (.F16) as Qd, Dn, Dm, then Dd, Sn, Sm, and by a scalar.
func arm32NeonDotCands(name *[]readonly char) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 4)
	var op int = arm32NeonDotOp(name)
	var d int = matchKindD
	var q int = matchKindQ
	var nc int = matchFormSIMDNoCond
	if op == neonDotS || op == neonDotU {
		var t int = matchTypeS8
		if op == neonDotU { t = matchTypeU8 }
		var dot int = matchNeedDotProd
		matchAdd(list, t, 0, matchOps(q, q, q), dot, nc)
		matchAdd(list, t, 0, matchOps(d, d, d), dot, nc)
		matchAdd(list, t, 0, matchOps4(q, q, matchKindDScalar32, matchKindLane32), dot, nc)
		matchAdd(list, t, 0, matchOps4(d, d, matchKindDScalar32, matchKindLane32), dot, nc)
	} else {
		var fml int = matchNeedNEON | matchNeedFP16FML
		var s int = matchKindS
		var h int = matchTypeF16
		matchAdd(list, h, 0, matchOps(q, d, d), fml, nc)
		matchAdd(list, h, 0, matchOps(d, s, s), fml, nc)
		matchAdd(list, h, 0, matchOps4(q, d, matchKindDScalar16, matchKindLane16), fml, nc)
		matchAdd(list, h, 0, matchOps4(d, s, matchKindSScalar, matchKindLane32), fml, nc)
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonDotReg returns operand it, an S, D or Q register, as asm/arm32/neon names it.
func arm32NeonDotReg(it arm32MatchItem) int {
	if it.kind == matchItemS { return vfp.S0 + it.n }
	return arm32NeonReg(it)
}

// arm32NeonDotEmit assembles name (arm32NeonDotOp) as encoding c, its operands items: Vd, Vn, Vm,
// and by a scalar the lane (its low 32 bits, as clang takes it).
func arm32NeonDotEmit(p @Parser, name *[]readonly char, c arm32MatchCand, items @[]arm32MatchItem) {
	var op int = arm32NeonDotOp(name)
	var vd int = arm32NeonDotReg(items[0])
	var vn int = arm32NeonDotReg(items[1])
	var vm int = arm32NeonDotReg(items[2])
	var byLane bool = arm32MatchKindAt(c.ops, 3) != 0
	var x int = 0
	if byLane { x = cast(int, cast(uint32, items[3].val)) }
	if op == neonDotS || op == neonDotU {
		if byLane {
			neon.DotLane(p.Asm, op == neonDotU, vd, vn, vm, x)
		} else {
			neon.Dot(p.Asm, op == neonDotU, vd, vn, vm)
		}
		return
	}
	if byLane {
		neon.FmalLane(p.Asm, op == neonDotFmsl, vd, vn, vm, x)
	} else {
		neon.Fmal(p.Asm, op == neonDotFmsl, vd, vn, vm)
	}
}
