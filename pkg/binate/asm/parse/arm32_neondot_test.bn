package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// arm32NeonDotCtx is the directive that gives the dot products and the FP16 multiply-adds long
// their features: a CPU with NEON, the dot product and FP16FML.
var arm32NeonDotCtx *[]readonly char = ".cpu cortex-a710"

// The dot products and FP16 multiply-adds long as clang assembles them: VSDOT / VUDOT on D and Q
// registers and by a scalar (D0..D15, lanes 0..1); VFMAL / VFMSL as Dd, Sn, Sm and Qd, Dn, Dm and
// by a scalar (S0..S15 with lanes 0..1, D0..D7 with 0..3); high registers, upper case, AL, the dot
// product alone (cortex-a55).
func TestParseArm32NeonDot() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32NeonDotCtx
	e = armGateIs(e, c, "vsdot.s8 d0, d1, d2", "FC210D02")
	e = armGateIs(e, c, "vudot.u8 q15, q14, q13", "FC6CEDFA")
	e = armGateIs(e, c, "vsdot.s8 q0, q1, d2[1]", "FE220D62")
	e = armGateIs(e, c, "vudot.u8 d0, d1, d15[1]", "FE210D3F")
	e = armGateIs(e, c, "vfmal.f16 d0, s1, s2", "FC200891")
	e = armGateIs(e, c, "vfmal.f16 d31, s31, s30", "FC6FF89F")
	e = armGateIs(e, c, "vfmsl.f16 q15, d31, d30", "FCEFE8FE")
	e = armGateIs(e, c, "vfmal.f16 d0, s1, s15[1]", "FE0008BF")
	e = armGateIs(e, c, "vfmsl.f16 q0, d1, d7[3]", "FE11087F")
	e = armGateIs(e, c, "vfmal.f16 q0, d1, d2[1]", "FE01085A")
	e = armGateIs(e, c, "vfmal.f16 q0, d1, d1[2]", "FE010871")
	e = armGateIs(e, c, "VSDOT.S8 D0, D1, D2", "FC210D02")
	e = armGateIs(e, c, "vudotal.u8 q0, q1, d2[1]", "FE220D72")
	e = armGateIs(e, ".cpu cortex-a55", "vsdot.s8 d0, d1, d2", "FC210D02")
	return e
}

// What clang does not take of them, with its message: no dot product, no FP16FML, neither it nor
// NEON (in clang's order of features), a scalar register or lane past those it takes (the other
// form a near miss too), another type or none, too few or too many operands, a register of another
// class in each place; a condition (the error before the operands are read), an `s`.
func TestParseArm32NeonDotRejects() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32NeonDotCtx
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var bad *[]readonly char = "invalid operand for instruction"
	e = armMsgIs(e, ".arch armv8.2-a", "vsdot.s8 d0, d1, d2", "instruction requires: dotprod")
	e = armMsgIs(e, ".cpu cortex-a76", "vfmal.f16 d0, s1, s2",
			"instruction requires: full half-float fml")
	e = armMsgIs(e, ".cpu cortex-a710\n.fpu vfpv4", "vfmsl.f16 q0, d1, d7[3]",
			"instruction requires: full half-float fml NEON")
	e = armMsgIs(e, c, "vsdot.s8 d0, d1, d16[1]", several)
	e = armMsgIs(e, c, "vsdot.s8 d0, d1, d2[2]", bad)
	e = armMsgIs(e, c, "vfmal.f16 d0, s1, s16[1]", several)
	e = armMsgIs(e, c, "vfmal.f16 q0, d1, d8[3]", several)
	e = armMsgIs(e, c, "vfmal.f16 d0, s1, s2[2]", bad)
	e = armMsgIs(e, c, "vsdot.u8 d0, d1, d2", bad)
	e = armMsgIs(e, c, "vfmal.f32 d0, s1, s2", bad)
	e = armMsgIs(e, c, "vsdot d0, d1, d2", "invalid instruction")
	e = armMsgIs(e, c, "vsdot.s8 q0, q1", "too few operands for instruction")
	e = armMsgIs(e, c, "vsdot.s8 d0, d1, d2, d3", bad)
	e = armMsgIs(e, c, "vsdot.s8 q0, q1, r2", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "vfmal.f16 d0, d1, d2", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "vfmal.f16 d0, s1, d2", "operand must be a register in range [s0, s31]")
	e = armMsgIs(e, c, "vfmal.f16 q0, s1, s2", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, c, "vfmal.f16 d0, s1, d2[1]", "operand must be a register in range [s0, s15]")
	e = armMsgIs(e, c, "vfmal.f16 q0, d1, s2[1]", "operand must be a register in range [d0, d7]")
	e = armMsgIs(e, c, "vsdoteq.s8 q0, q1",
			"instruction 'vsdot' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "vfmalhs.f16 d0, s1, s2",
			"instruction 'vfmal' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "vsdots.s8 d0, d1, d2",
			"instruction 'vsdot' can not set flags, but 's' suffix specified")
	return e
}
