package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// NEON's modified immediates (asm/arm32/neon's ModImm), as clang takes them, among the encodings of
// the names they share: VORR and VBIC (.I16, .I32) and clang's VAND (as VBIC of the inverted
// value), and VMVN (.I16, .I32, and as clang's aliases also .I64), on a D or a Q register.  Each
// encoding takes the values clang's operand class of it does (arm32NeonImmIs): VMVN.I32 of a value
// whose inversion VMOV.I32 takes (and VMVN.I32 does not take the value) is that VMOV of the
// inversion, VMVN of a value all of whose bytes are one byte VMOV.I8 of that byte inverted,
// VMVN.I32 or .I64 of a repeated 16- or 32-bit element VMVN of the element.  clang looks only at a
// value's low bits (32 of them, or its aliases' elements), so it takes values past the data type's
// range (vbic.i16 #0x1000000ff is #0xff); those are errors here.  So is clang's negative zero
// (`#-0`), which clang takes as -2^31 (vorr.i32 #-0 is #0x80000000): no class takes it here.  MVE's
// VORR, VBIC and VMVN .I16 and .I32 on Q0 .. Q7 are encodings too, never in effect, clang's near
// misses (its MVE VAND and VORN, aliases that want Thumb as well, are none in ARM state).

// arm32NeonImmMost is the most modified-immediate encodings a name has (arm32NeonImmAdd).
const arm32NeonImmMost int = 20

// arm32NeonI32Vmov reports clang's isValidNEONi32vmovImm: whether v, as 64 bits, is one byte of
// a 32-bit word's four, or 0x0000NNFF or 0x00NNFFFF.
func arm32NeonI32Vmov(v int64) bool {
	var u uint64 = bit_cast(uint64, v)
	return u & 0xFFFFFFFFFFFFFF00 == 0 || u & 0xFFFFFFFFFFFF00FF == 0 || u & 0xFFFFFFFFFF00FFFF == 0 ||
			u & 0xFFFFFFFF00FFFFFF == 0 || u & 0xFFFFFFFFFFFF00FF == 0xFF || u & 0xFFFFFFFFFF00FFFF == 0xFFFF
}

// arm32NeonRep reports clang's isNEONReplicate: whether v (not 0), inverted when inv, holds the
// same element of width bits n times from its lowest, the element a 16-bit one's 0x00NN or 0xNN00
// and a 32-bit one's of arm32NeonI32Vmov.
func arm32NeonRep(v int64, width int, n int, inv bool) bool {
	if v == 0 { return false }
	var u uint64 = bit_cast(uint64, v)
	if inv { u = ~u }
	var mask uint64 = (cast(uint64, 1) << cast(uint, width)) - 1
	var elem uint64 = u & mask
	if width == 16 && elem & 0xFF != 0 && elem & 0xFF00 != 0 { return false }
	if width == 32 && !arm32NeonI32Vmov(bit_cast(int64, elem)) { return false }
	for i := 1; i < n; i++ {
		u = u >> cast(uint, width)
		if u & mask != elem { return false }
	}
	return true
}

// arm32NeonOneByte reports clang's isNEONi16splat (n 2) or isNEONi32splat (n 4) of the 32 bits
// u: 0, or one byte of the n nonzero (an i16's no more than 16 bits).
func arm32NeonOneByte(u uint32, n int) bool {
	if n == 2 && u > 0xFFFF { return false }
	var count int = 0
	for i := 0; i < n; i++ {
		if (u >> cast(uint, 8 * i)) & 0xFF != 0 { count = count + 1 }
	}
	return count <= 1
}

// arm32NeonImmIs reports whether value v is of modified-immediate kind k (matchKindNSplatI16 ..
// matchKindNMovRep32x64), as clang's operand class of it takes it.
func arm32NeonImmIs(k int, v int64) bool {
	var u uint32 = cast(uint32, bit_cast(uint64, v))
	if k == matchKindNSplatI16 { return !arm32NeonRep(v, 8, 2, false) && arm32NeonOneByte(u, 2) }
	if k == matchKindNSplatI32 { return !arm32NeonRep(v, 8, 4, false) && arm32NeonOneByte(u, 4) }
	if k == matchKindNSplatNotI16 { return arm32NeonOneByte(~u & 0xFFFF, 2) }
	if k == matchKindNSplatNotI32 { return arm32NeonOneByte(~u, 4) }
	if k == matchKindNVmovI32 { return !arm32NeonRep(v, 8, 4, false) && arm32NeonI32Vmov(v) }
	if k == matchKindNVmovI32Neg { return arm32NeonI32Vmov(bit_cast(int64, ~bit_cast(uint64, v))) }
	if k >= matchKindNInvRep8x16 && k <= matchKindNInvRep8x64 {
		var n @[]int = @[]int{2, 4, 8}
		return arm32NeonRep(v, 8, n[k - matchKindNInvRep8x16], true)
	}
	var widths @[]int = @[]int{16, 16, 32}
	var counts @[]int = @[]int{2, 4, 2}
	var i int = k - matchKindNMovRep16x32
	if i == 1 || i == 2 {
		// A 64-bit value clang's VMOV.I64 takes is not a repeated element of its.
		var allBytes bool = true
		for b := 0; b < 8; b++ {
			var x uint64 = (bit_cast(uint64, v) >> cast(uint, 8 * b)) & 0xFF
			if x != 0 && x != 0xFF { allBytes = false }
		}
		if allBytes { return false }
	}
	return arm32NeonRep(v, widths[i], counts[i], false)
}

// arm32NeonImmAdd appends name's modified-immediate encodings to list, each on a D register and
// a Q register: VORR's and VBIC's .I16 and .I32, VAND's (VBIC of the inverted value), VMVN's
// .I16, .I32 and clang's aliases of it; and MVE's VORR, VBIC and VMVN .I16 and .I32.
func arm32NeonImmAdd(list @arm32MatchList, name *[]readonly char) {
	var types @[]int
	var kinds @[]int
	if charsEqual(name, "vorr") || charsEqual(name, "vbic") {
		types = @[]int{matchTypeI16, matchTypeI32}
		kinds = @[]int{matchKindNSplatI16, matchKindNSplatI32}
	} else if charsEqual(name, "vand") {
		types = @[]int{matchTypeI16, matchTypeI32}
		kinds = @[]int{matchKindNSplatNotI16, matchKindNSplatNotI32}
	} else if charsEqual(name, "vmvn") {
		var i16 int = matchTypeI16
		var i32 int = matchTypeI32
		var i64 int = matchTypeI64
		types = @[]int{i16, i16, i32, i32, i32, i32, i64, i64, i64}
		kinds = @[]int{matchKindNSplatI16, matchKindNInvRep8x16, matchKindNVmovI32, matchKindNInvRep8x32,
				matchKindNMovRep16x32, matchKindNVmovI32Neg, matchKindNInvRep8x64, matchKindNMovRep16x64,
				matchKindNMovRep32x64}
	} else {
		return
	}
	for i := 0; i < len(types); i++ {
		matchAdd(list, types[i], 0, matchOps(matchKindD, kinds[i], 0), matchNeedNEON, matchFormSIMD)
		matchAdd(list, types[i], 0, matchOps(matchKindQ, kinds[i], 0), matchNeedNEON, matchFormSIMD)
	}
	var k32 int = matchKindNSplatI32
	if charsEqual(name, "vmvn") {
		k32 = matchKindNVmovI32
	} else if charsEqual(name, "vand") {
		return
	}
	var mq int = matchKindMQ
	matchAdd(list, matchTypeI16, 0, matchOps(mq, matchKindNSplatI16, 0), matchNeedMVE, matchFormMVE)
	matchAdd(list, matchTypeI32, 0, matchOps(mq, k32, 0), matchNeedMVE, matchFormMVE)
}

// arm32NeonImmCand reports whether encoding c is a modified immediate's, one its second operand.
func arm32NeonImmCand(c arm32MatchCand) bool {
	var k int = arm32MatchKindAt(c.ops, 1)
	return k >= matchKindNSplatI16 && k <= matchKindNMovRep32x64
}

// arm32NeonImmEmit assembles modified-immediate name under cond as encoding c, its operands items
// -- Vd and the immediate -- unconditional, as the instruction c's operand class makes of it; a
// value past its data type's range, which clang cuts to the element's bits, is an error here.
func arm32NeonImmEmit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var v int64 = items[1].val
	if c.t1 == matchTypeI16 && (v < -32768 || v > 65535) {
		setErr(p, "operand must be an immediate in the range [-32768,65535]")
		return
	}
	if c.t1 == matchTypeI32 && (v < -2147483648 || v > 4294967295) {
		setErr(p, "operand must be an immediate in the range [-2147483648,4294967295]")
		return
	}
	var u uint64 = bit_cast(uint64, v)
	var k int = arm32MatchKindAt(c.ops, 1)
	var op int = neon.IMM_VMVN
	if charsEqual(name, "vorr") { op = neon.IMM_VORR }
	if charsEqual(name, "vbic") || charsEqual(name, "vand") { op = neon.IMM_VBIC }
	var dt int = neon.DT_I16
	var value uint64 = u & 0xFFFF
	if k == matchKindNSplatI32 || k == matchKindNVmovI32 || k == matchKindNMovRep32x64 {
		dt = neon.DT_I32
		value = u & 0xFFFFFFFF
	} else if k == matchKindNSplatNotI16 {
		value = ~u & 0xFFFF
	} else if k == matchKindNSplatNotI32 {
		dt = neon.DT_I32
		value = ~u & 0xFFFFFFFF
	} else if k == matchKindNVmovI32Neg {
		op = neon.IMM_VMOV
		dt = neon.DT_I32
		value = ~u & 0xFFFFFFFF
	} else if k >= matchKindNInvRep8x16 && k <= matchKindNInvRep8x64 {
		op = neon.IMM_VMOV
		dt = neon.DT_I8
		value = ~u & 0xFF
	}
	neon.ModImm(p.Asm, op, dt, arm32NeonReg(items[0]), value)
}
