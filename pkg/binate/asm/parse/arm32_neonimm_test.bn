package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Each modified-immediate operand class takes the values clang's does: VORR / VBIC's one byte of
// two or four bytes (0 too, but no byte repeated), VAND's the same of the inverted value,
// VMVN.I32's a VMOV.I32 form, and its alias's a value whose inversion of all 64 bits is one (-256,
// ~0xFF, but not 0xFFFFFF00), and the repeated elements of clang's other aliases (no 64-bit value
// VMOV.I64 takes).
func TestArm32NeonImmIs() testing.TestResult {
	var yes @[]int = @[]int{matchKindNSplatI16, matchKindNSplatI16, matchKindNSplatI32,
			matchKindNSplatNotI16, matchKindNSplatNotI32, matchKindNVmovI32, matchKindNVmovI32Neg,
			matchKindNInvRep8x32, matchKindNMovRep16x32, matchKindNMovRep32x64, matchKindNInvRep8x64,
			matchKindNMovRep16x64}
	var yesV @[]int64 = @[]int64{0, 0xAB00, 0xAB0000, -256, -256, 0xABFFFF, -256, 0x54545454, 0xAB00AB,
			0x0000AB000000AB00, 0x5454545454545454, 0x00AB00AB00AB00AB}
	for i := 0; i < len(yes); i++ {
		if !arm32NeonImmIs(yes[i], yesV[i]) { return fail("a modified immediate is not its class's") }
	}
	var no @[]int = @[]int{matchKindNSplatI16, matchKindNSplatI16, matchKindNSplatI32,
			matchKindNVmovI32, matchKindNVmovI32Neg, matchKindNInvRep8x16, matchKindNMovRep16x64,
			matchKindNSplatNotI16, matchKindNSplatNotI32}
	var noV @[]int64 = @[]int64{0xFFFF, 0x1FF, 0x1FF00, 0xABABABAB, 0xFFFFFF00, 0, -1, 0x1234,
			0x12345678}
	for i := 0; i < len(no); i++ {
		if arm32NeonImmIs(no[i], noV[i]) {
			return fail("a value is a modified-immediate class's it is not")
		}
	}
	return ""
}

// The modified immediates as clang assembles them: VORR and VBIC .I16 and .I32 (a type standing for
// I, no #, high registers, -2^31 written out), VAND as VBIC of the inverted value, VMVN's own forms
// and clang's aliases of it (VMOV.I32 of the inversion, its ones-filled forms too, VMOV.I8 of an
// inverted repeated byte, VMVN.I16 or .I32 of a repeated element).
func TestParseArm32NeonImmForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vorr.i16 d0, #0xab", "F382091B")
	e = armGateIs(e, "", "vorr.i32 q0, #0xab000000", "F382075B")
	e = armGateIs(e, "", "vorr.s32 d0, #0xab00", "F382031B")
	e = armGateIs(e, "", "vbic.i16 d0, #0xab00", "F3820B3B")
	e = armGateIs(e, "", "vbic.u16 q15, #0xff", "F3C7E97F")
	e = armGateIs(e, "", "vand.i32 d0, #0xffffff00", "F387013F")
	e = armGateIs(e, "", "vand.i16 d0, #-256", "F387093F")
	e = armGateIs(e, "", "vand.i16 d0, #-1", "F2800930")
	e = armGateIs(e, "", "vmvn.i16 d0, #0xab00", "F3820A3B")
	e = armGateIs(e, "", "vmvn.i32 d0, #0xabffff", "F3820D3B")
	e = armGateIs(e, "", "vmvn.i32 d0, #-2", "F2800011")
	e = armGateIs(e, "", "vmvn.i32 d0, #0xabababab", "F2850E14")
	e = armGateIs(e, "", "vmvn.i16 d0, #0xffff", "F2800E10")
	e = armGateIs(e, "", "vmvn.i64 d0, #-1", "F2800E10")
	e = armGateIs(e, "", "vmvn.i32 d0, #0x00ff00ff", "F387083F")
	e = armGateIs(e, "", "vmvn.i64 d0, #0xab000000ab000000", "F382063B")
	e = armGateIs(e, "", "vmvn.i64 q0, #0x00ab00ab00ab00ab", "F382087B")
	e = armGateIs(e, "", "vorr.i32 d0, 0xff", "F387011F")
	e = armGateIs(e, "", "vorr.i32 d31, #0xff", "F3C7F11F")
	e = armGateIs(e, "", "vbic.i32 d0, #0xab0000", "F382053B")
	e = armGateIs(e, "", "vorr.i32 d0, #-2147483648", "F3800710")
	e = armGateIs(e, "", "vmvn.i32 d0, #-0xac00", "F3820C1B")
	e = armGateIs(e, "", "vmvn.i32 q9, #-0xab0001", "F3C2245B")
	return e
}

// What clang does not take of them, with its message: a value no class takes, a data type none has,
// three operands, no NEON (and on Q0 .. Q7 no MVE, for VORR, VBIC and VMVN's own forms), a
// floating-point literal; and here a condition, which clang drops, a value past the data type's
// range, which clang cuts to its low bits, and clang's negative zero, which clang takes as -2^31.
func TestParseArm32NeonImmRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vorr.i32 d0, #0x1ff", several)
	e = armMsgIs(e, "", "vorr.i8 d0, #1", several)
	e = armMsgIs(e, "", "vbic.i16 d0, #0xffff", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmvn.i8 d0, #1", several)
	e = armMsgIs(e, "", "vmvn.i64 d0, #0xab", several)
	e = armMsgIs(e, "", "vand.i32 d0, #0xff", several)
	e = armMsgIs(e, "", "vorr.i32 d0, d1, #0xff", several)
	e = armMsgIs(e, v3, "vorr.i32 d0, #0xff", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vbic.i16 q1, #0xab00", several)
	e = armMsgIs(e, v3, "vorr.i32 q8, #0xff", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vmvn.i32 q0, #0xabffff", several)
	e = armMsgIs(e, v3, "vand.i32 q0, #0xffffff00", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vmvn.i32 q7, #0xabababab", "instruction requires: NEON")
	e = armMsgIs(e, "", "vorr.i32 d0, #1.5", several)
	e = armMsgIs(e, "", "vorreq.i32 d0, #0xff",
			"instruction 'vorr' is not predicable, but condition code specified")
	var r16 *[]readonly char = "operand must be an immediate in the range [-32768,65535]"
	var r32 *[]readonly char = "operand must be an immediate in the range [-2147483648,4294967295]"
	e = armMsgIs(e, "", "vbic.i16 d0, #0x1000000ff", r16)
	e = armMsgIs(e, "", "vmvn.i16 d0, #0x10000", r16)
	e = armMsgIs(e, "", "vorr.i32 d0, #0x1000000ff", r32)
	e = armMsgIs(e, "", "vmvn.i32 d0, #0xff00ff00ff00ff00", r32)
	e = armMsgIs(e, "", "vorr.i32 d0, #-0", several)
	e = armMsgIs(e, "", "vbic.i32 d0, #-(0)", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmvn.i16 d0, #-0x0", several)
	return e
}
