package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/asm/arm32/vfp"

// NEON's element and structure loads and stores, VLD1 .. VLD4 and VST1 .. VST4 (asm/arm32/neon's
// Elems, ElemLane and ElemDup), as clang takes them: a type (.8, .16, .32, .64 for VLD1 / VST1, or
// a type clang's token aliases stand for), a vector list (arm32MatchVecList) -- of multiple
// structures, of one lane (`[n]`), or, to load, of all lanes (`[]`) -- and an address, [Rn] or
// [Rn:align] with an alignment the form takes (clang's named classes, "alignment must be 64 or
// omitted" and the like), then nothing, `!` (write-back) or a post-index register (R0..R12 or R14,
// R13 too from ARMv8).  clang tries them in the order of its table (arm32NeonLdStCands).  It
// drops a condition, takes a Q register alone with no lane as its first D register, encodes a PC
// base (UNPREDICTABLE) and, from ARMv8, an SP post-index as [Rn]!; each is an error here.

// arm32NeonLdStOp returns how many structures name (lowercase, split) loads or stores, 1 .. 4, and
// whether it loads; 0 for a name none of these.
func arm32NeonLdStOp(name *[]readonly char) (int, bool) {
	if len(name) != 4 || name[0] != 'v' || name[3] < '1' || name[3] > '4' { return 0, false }
	var load bool = name[1] == 'l' && name[2] == 'd'
	if !load && (name[1] != 's' || name[2] != 't') { return 0, false }
	return cast(int, name[3]) - cast(int, '0'), load
}

// arm32NeonLdStLists returns which written operands clang reads as vector lists for name
// (arm32NeonLdStOp), cond its condition and nt its types (arm32MatchPlaces): its list's places,
// with NEON in effect; none otherwise.
func arm32NeonLdStLists(p @Parser, name *[]readonly char, cond int, nt int) int {
	n, _ := arm32NeonLdStOp(name)
	if n == 0 || p.Arm32FP & armFpNEON == 0 { return 0 }
	return arm32MatchPlaces(1, cond, nt)
}

// arm32NeonLdStMost is the most encodings a load or store has (VLD1's; arm32NeonLdStCands).
const arm32NeonLdStMost int = 75

// arm32NeonLdStCands returns the encodings clang tries for name (arm32NeonLdStOp), in its order:
// for .16, .32, .64 (VLD1 / VST1 only) and .8 in turn, its forms (arm32NeonLdStForms).
func arm32NeonLdStCands(name *[]readonly char) @arm32MatchList {
	n, load := arm32NeonLdStOp(name)
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32NeonLdStMost)
	var sizes @[]int = @[]int{16, 32, 64, 8}
	for i := 0; i < len(sizes); i++ {
		if sizes[i] != 64 || n == 1 { arm32NeonLdStForms(list, n, load, sizes[i]) }
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonLdStForms appends the forms of n structures (loads when load) of size-bit elements, in
// clang's order -- its lists by the names of clang's classes, a list of all lanes (to load), of
// multiple structures and of one lane in turn: for 1, two D registers, four, one, three; for 2, two
// D registers, two every other one, four, then the lanes of two and of two every other one; for 3
// and 4, n D registers, then n every other one -- each with the alignments it takes: a list of
// multiple structures 64 bits (one or three registers), 64 or 128 (two), or 64, 128 or 256 (four);
// one of all lanes or of one lane those of n elements of size bits (arm32NeonLdStUnitAlign).  A
// list of 64-bit elements has no lanes here, nor one of one lane of 8-bit elements every other
// register.  Each form is appended with the address alone, then with `!` and with a post-index
// register after it; clang tries all those with the address alone first (arm32MatchSort).
func arm32NeonLdStForms(list @arm32MatchList, n int, load bool, size int) {
	var all int = vecLanesAll
	var none int = vecLanesNone
	var one int = vecLanesOne
	// Each list as count, every other register (1) or not (0), and its lanes.
	var forms @[]int = @[]int{3, 0, all, 3, 0, none, 3, 0, one, 3, 1, all, 3, 1, none, 3, 1, one}
	if n == 1 {
		forms = @[]int{2, 0, all, 2, 0, none, 4, 0, none, 1, 0, all, 1, 0, none, 1, 0, one, 3, 0, none}
	} else if n == 2 {
		forms = @[]int{2, 0, all, 2, 0, none, 2, 1, all, 2, 1, none, 4, 0, none, 2, 0, one, 2, 1, one}
	} else if n == 4 {
		forms = @[]int{4, 0, all, 4, 0, none, 4, 0, one, 4, 1, all, 4, 1, none, 4, 1, one}
	}
	var types @[]int = @[]int{matchType8, matchType16, matchType32, matchType64}
	var t int = types[arm32NeonLdStSizeIndex(size)]
	for i := 0; i + 2 < len(forms); i = i + 3 {
		var count int = forms[i]
		var spaced bool = forms[i + 1] == 1
		var lanes int = forms[i + 2]
		if (lanes == all && !load) || (lanes != none && size == 64) ||
				(lanes == one && spaced && size == 8) {
			continue
		}
		var lk int = arm32NeonLdStListKind(count, spaced, lanes, size)
		var ak int = arm32NeonLdStUnitAlign(n, size)
		if lanes == none {
			var aligns @[]int = @[]int{matchKindAlign64, matchKindAlign64or128, matchKindAlign64,
					matchKindAlign64or128or256}
			ak = aligns[count - 1]
		}
		var need int = matchNeedNEON
		var simd int = matchFormSIMD
		matchAdd(list, t, 0, matchOps(lk, ak, 0), need, simd)
		matchAdd(list, t, 0, matchOps(lk, ak, matchKindBang), need, simd)
		matchAdd(list, t, 0, matchOps(lk, ak, matchKindRGPR), need, simd)
	}
}

// arm32NeonLdStSizeIndex returns 0, 1, 2 or 3 for elements of size 8, 16, 32 or 64 bits.
func arm32NeonLdStSizeIndex(size int) int {
	if size == 16 { return 1 }
	if size == 32 { return 2 }
	if size == 64 { return 3 }
	return 0
}

// arm32NeonLdStUnitAlign returns the address kind of a list of all lanes or of one lane of n
// structures of size-bit elements: the alignment of the n elements, none for 8 bits (VLD1 of
// 8-bit elements) and for VLD3 / VST3, 64 or 128 for 128 bits (VLD4 / VST4 of 32-bit ones).
func arm32NeonLdStUnitAlign(n int, size int) int {
	var unit int = n * size
	if n == 3 || unit == 8 { return matchKindAlignNone }
	if unit == 16 { return matchKindAlign16 }
	if unit == 32 { return matchKindAlign32 }
	if unit == 64 { return matchKindAlign64 }
	return matchKindAlign64or128
}

// arm32NeonLdStListKind returns the kind (matchKind*) of a list of count D registers, every other
// one when spaced, with lanes (vecLanes*) of size-bit elements.
func arm32NeonLdStListKind(count int, spaced bool, lanes int, size int) int {
	if lanes == vecLanesNone && spaced { return matchKindVecSpaced + count - 2 }
	if lanes == vecLanesNone { return matchKindVecOneD + count - 1 }
	if lanes == vecLanesAll && spaced { return matchKindVecAll + 4 + count - 2 }
	if lanes == vecLanesAll { return matchKindVecAll + count - 1 }
	var w int = arm32NeonLdStSizeIndex(size)
	if spaced { return matchKindVecLane + 12 + (count - 2) * 2 + w - 1 }
	return matchKindVecLane + (count - 1) * 3 + w
}

// arm32NeonLdStShape returns the shape of list kind k (from matchKindVecSpaced on; the families
// arm32NeonLdStListKind numbers): its count of D registers, whether they are every other one, its
// lanes (vecLanes*), and the last lane it takes; a count of 0 for an address kind.
func arm32NeonLdStShape(k int) (int, bool, int, int64) {
	if k < matchKindVecAll { return k - matchKindVecSpaced + 2, true, vecLanesNone, 0 }
	if k < matchKindVecAll + 4 { return k - matchKindVecAll + 1, false, vecLanesAll, 0 }
	if k < matchKindVecLane { return k - matchKindVecAll - 2, true, vecLanesAll, 0 }
	if k < matchKindVecLane + 12 {
		var i int = k - matchKindVecLane
		return i / 3 + 1, false, vecLanesOne, cast(int64, 7 >> (i % 3))
	}
	if k < matchKindAlignNone {
		var j int = k - matchKindVecLane - 12
		return j / 2 + 2, true, vecLanesOne, cast(int64, 3 >> (j % 2))
	}
	return 0, false, 0, 0
}

// arm32NeonLdStItemIs reports whether operand it is of kind k, a list or an address kind of these
// (from matchKindVecSpaced on; arm32NeonLdStShape): a list of that shape (a lane no later
// than its last), or a memory operand with a core base register, no offset, and no alignment or
// one the kind takes.
func arm32NeonLdStItemIs(k int, it arm32MatchItem) bool {
	count, spaced, lanes, last := arm32NeonLdStShape(k)
	if count > 0 {
		return it.kind == matchItemVecList && it.count == count && it.spaced == spaced &&
				it.vlanes == lanes && (lanes != vecLanesOne || it.laneNum <= last)
	}
	if it.kind != matchItemMem || it.index || (!it.plain && !it.align) { return false }
	var bits int = it.alignTo
	if it.plain || k == matchKindAlignNone { return it.plain }
	if k == matchKindAlign16 { return bits == 16 }
	if k == matchKindAlign32 { return bits == 32 }
	if k == matchKindAlign64 { return bits == 64 }
	if k == matchKindAlign64or128 { return bits == 64 || bits == 128 }
	return bits == 64 || bits == 128 || bits == 256
}

// arm32NeonLdStAlignMessage returns clang's message for an address of kind k (matchKindAlignNone
// .. matchKindAlign64or128or256) wanted where another operand was written.
func arm32NeonLdStAlignMessage(k int) *[]readonly char {
	var messages @[]*[]readonly char = @[]*[]readonly char{"alignment must be omitted",
			"alignment must be 16 or omitted", "alignment must be 32 or omitted",
			"alignment must be 64 or omitted", "alignment must be 64, 128 or omitted",
			"alignment must be 64, 128, 256 or omitted"}
	return messages[k - matchKindAlignNone]
}

// arm32NeonLdStEmit assembles name (arm32NeonLdStOp; unconditional) as encoding c, its operands
// items: the list, the address, and `!` or a post-index register when c has one.
func arm32NeonLdStEmit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var list arm32MatchItem = items[0]
	if list.qalone {
		// clang takes a Q register alone here as its first D register.
		setErr(p, "invalid operand for instruction")
		return
	}
	// The list is a vector list or a D register alone (arm32MatchVecList reads it).
	var count int = 1
	if list.kind == matchItemVecList { count = list.count }
	n, load := arm32NeonLdStOp(name)
	var sizes @[]int = @[]int{8, 16, 32, 64}
	var size int = sizes[c.t1 - matchType8]
	var post int = neon.LDST_PLAIN
	if arm32MatchKindAt(c.ops, 2) == matchKindBang { post = neon.LDST_WB }
	if arm32MatchKindAt(c.ops, 2) == matchKindRGPR { post = items[2].n }
	var dd int = vfp.D0 + list.n
	var rn int = items[1].n
	var align int = items[1].alignTo
	if list.vlanes == vecLanesOne {
		var lane int = cast(int, list.laneNum)
		neon.ElemLane(p.Asm, load, n, size, dd, list.spaced, lane, rn, align, post)
	} else if list.vlanes == vecLanesAll {
		neon.ElemDup(p.Asm, n, size, dd, count, list.spaced, rn, align, post)
	} else {
		neon.Elems(p.Asm, load, n, size, dd, count, list.spaced, rn, align, post)
	}
}
