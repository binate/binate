package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// VLD1 .. VLD4 and VST1 .. VST4 of multiple structures as clang assembles them: each count of
// registers, one after another and every other one, written one by one, as a range, as Q
// registers or as a D register alone, high registers, every alignment (64, 128 and 256 bits), `!`
// and a post-index register (LR too), and types clang's token aliases stand for.
func TestParseArm32NeonLdSt() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vld1.8 {d0}, [r1]", "F421070F")
	e = armGateIs(e, "", "vld1.8 d5, [r1]", "F421570F")
	e = armGateIs(e, "", "vld1.16 {d1, d2}, [r4:64]", "F4241A5F")
	e = armGateIs(e, "", "vld1.32 {d0-d2}, [r1]", "F421068F")
	e = armGateIs(e, "", "vld1.64 {d3-d6}, [r6:256]!", "F42632FD")
	e = armGateIs(e, "", "vld1.8 {q0, q1}, [r5:128], r7", "F4250227")
	e = armGateIs(e, "", "vld1.8 {d16-d19}, [r0]", "F460020F")
	e = armGateIs(e, "", "vld1.8 {d0}, [r0:64]!", "F420071D")
	e = armGateIs(e, "", "vld1.8 {d0}, [r0], lr", "F420070E")
	e = armGateIs(e, "", "vld1.8 {d0, d1}, [r0:128]", "F4200A2F")
	e = armGateIs(e, "", "vld1.16 {d0-d3}, [r0:64]", "F420025F")
	e = armGateIs(e, "", "vst1.32 {d0-d3}, [r0:128]", "F40002AF")
	e = armGateIs(e, "", "vld2.8 {d0, d1}, [r0:64]", "F420081F")
	e = armGateIs(e, "", "vst2.16 {d0, d1}, [r0:128]", "F400086F")
	e = armGateIs(e, "", "vld2.32 {d0, d2}, [r0:128]", "F42009AF")
	e = armGateIs(e, "", "vld3.8 {d0-d2}, [r0:64]", "F420041F")
	e = armGateIs(e, "", "vld4.8 {d0-d3}, [r0:64]", "F420001F")
	e = armGateIs(e, "", "vst4.16 {d0, d2, d4, d6}, [r0:128]", "F400016F")
	e = armGateIs(e, "", "vld1.8 {d0}, [r0 :64]", "F420071F")
	e = armGateIs(e, "", "vld1.8 {d0}, [r0, :64]", "F420071F")
	e = armGateIs(e, "", "vld1.8 {d0}, [sp]", "F42D070F")
	e = armGateIs(e, "", "vld2.8 {d0, d2}, [r1]", "F421090F")
	e = armGateIs(e, "", "vld2.8 {q0, q1}, [r0]", "F420030F")
	e = armGateIs(e, "", "vld3.32 {d1, d3, d5}, [r4:64]!", "F424159D")
	e = armGateIs(e, "", "vld4.8 {d0, d2, d4, d6}, [r6:256], r7", "F4260137")
	e = armGateIs(e, "", "vst1.8 {d0}, [r1]", "F401070F")
	e = armGateIs(e, "", "vst1.8 {d0}, [r0]!", "F400070D")
	e = armGateIs(e, "", "vst2.32 {q0, q1}, [r5:128]", "F40503AF")
	e = armGateIs(e, "", "vst3.16 {d0-d2}, [r1]", "F401044F")
	e = armGateIs(e, "", "vst4.32 {d28-d31}, [r1]!", "F441C08D")
	e = armGateIs(e, "", "vst4.32 {d0-d3}, [r0:256], r2", "F40000B2")
	e = armGateIs(e, "", "vld1.i8 {d0}, [r0]", "F420070F")
	e = armGateIs(e, "", "vld1.s16 {d0}, [r0]", "F420074F")
	e = armGateIs(e, "", "vld1.f32 {d0}, [r0]", "F420078F")
	e = armGateIs(e, "", "vld1.p8 {d0}, [r0]", "F420070F")
	e = armGateIs(e, "", "vld1.f64 {d0}, [r0]", "F42007CF")
	e = armGateIs(e, "", "vld1.u64 {d0}, [r0]", "F42007CF")
	return e
}

// One lane and all lanes as clang assembles them: each count of registers, one after another and
// every other one, a register alone with a lane (a Q register's two too), the last lane of each
// size, each alignment each count and size takes (VLD4.32's 64 and 128 bits), `!` and a
// post-index register.
func TestParseArm32NeonLdStLanes() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vld1.8 {d4[7]}, [r1]", "F4A140EF")
	e = armGateIs(e, "", "vld1.16 {d3[3]}, [r2:16]", "F4A234DF")
	e = armGateIs(e, "", "vld1.16 d5[2], [r1]", "F4A1548F")
	e = armGateIs(e, "", "vld1.32 {d2[1]}, [r3:32]!", "F4A328BD")
	e = armGateIs(e, "", "vld1.32 {d0[1]}, [r0:32]", "F4A008BF")
	e = armGateIs(e, "", "vld2.16 {d0[1], d2[1]}, [r3:32]", "F4A3057F")
	e = armGateIs(e, "", "vld3.8 {d4[0], d5[0], d6[0]}, [r1], r7", "F4A14207")
	e = armGateIs(e, "", "vld4.32 {d0[1], d2[1], d4[1], d6[1]}, [r5:128]", "F4A50BEF")
	e = armGateIs(e, "", "vld4.32 {d0[1], d1[1], d2[1], d3[1]}, [r0:128]", "F4A00BAF")
	e = armGateIs(e, "", "vst4.8 {d0[2], d1[2], d2[2], d3[2]}, [r3:32]", "F483035F")
	e = armGateIs(e, "", "vld2.8 {d0[1], d1[1]}, [r0:16]", "F4A0013F")
	e = armGateIs(e, "", "vld2.32 {d0[1], d1[1]}, [r0:64]", "F4A0099F")
	e = armGateIs(e, "", "vst2.32 {d1[1], d3[1]}, [r0:64]", "F48019DF")
	e = armGateIs(e, "", "vld3.16 {d0[1], d2[1], d4[1]}, [r0]", "F4A0066F")
	e = armGateIs(e, "", "vst3.32 {d0[1], d2[1], d4[1]}, [r0]!", "F4800ACD")
	e = armGateIs(e, "", "vld4.16 {d0[3], d1[3], d2[3], d3[3]}, [r0:64]", "F4A007DF")
	e = armGateIs(e, "", "vld4.32 {d0[1], d1[1], d2[1], d3[1]}, [r0:64]", "F4A00B9F")
	e = armGateIs(e, "", "vst4.16 {d0[1], d2[1], d4[1], d6[1]}, [r0:64]", "F480077F")
	e = armGateIs(e, "", "vld1.8 {d0[]}, [r1]", "F4A10C0F")
	e = armGateIs(e, "", "vld1.8 d7[], [r1]", "F4A17C0F")
	e = armGateIs(e, "", "vld1.8 q1[], [r1]", "F4A12C2F")
	e = armGateIs(e, "", "vld1.16 {d0[], d1[]}, [r2:16]!", "F4A20C7D")
	e = armGateIs(e, "", "vld2.32 {d0[], d2[]}, [r4:64]", "F4A40DBF")
	e = armGateIs(e, "", "vld3.16 {d1[], d3[], d5[]}, [r1]", "F4A11E6F")
	e = armGateIs(e, "", "vld4.32 {d0[], d1[], d2[], d3[]}, [r5:128]", "F4A50FDF")
	e = armGateIs(e, "", "vld4.32 {d0[], d2[], d4[], d6[]}, [r0:128]", "F4A00FFF")
	e = armGateIs(e, "", "vld4.16 {d0[], d2[], d4[], d6[]}, [r0:64]", "F4A00F7F")
	e = armGateIs(e, "", "vld4.8 {d0[], d2[], d4[], d6[]}, [r3:32], r7", "F4A30F37")
	e = armGateIs(e, "", "vld1.32 {d0[]}, [r0:32]", "F4A00C9F")
	e = armGateIs(e, "", "vld1.32 {d0[], d1[]}, [r0:32]", "F4A00CBF")
	e = armGateIs(e, "", "vld2.8 {d0[], d1[]}, [r0:16]", "F4A00D1F")
	e = armGateIs(e, "", "vld2.8 {d0[], d2[]}, [r0:16]", "F4A00D3F")
	e = armGateIs(e, "", "vld2.16 {d0[], d1[]}, [r0:32]", "F4A00D5F")
	e = armGateIs(e, "", "vld3.32 {d0[], d1[], d2[]}, [r0]", "F4A00E8F")
	e = armGateIs(e, "", "vld3.8 {d0[], d2[], d4[]}, [r0]!", "F4A00E2D")
	e = armGateIs(e, "", "vld4.32 {d0[], d1[], d2[], d3[]}, [r0:64]", "F4A00F9F")
	e = armGateIs(e, "", "vld4.8 {d0[], d1[], d2[], d3[]}, [r0:32]", "F4A00F1F")
	return e
}

// What clang does not take of them, with its message: an alignment the form does not take (with
// another form a near miss too), a list of another length or spacing, a lane past the size's or of
// 64-bit elements, all lanes to store, an offset, a register index or a base other than a core
// register, no address, an immediate or SP as the post-index, `!` and a post-index register, no
// type, a type of no form, no NEON; and here a condition, a Q register alone with no lane (clang's
// first D register of it), a PC base (UNPREDICTABLE) and SP as the post-index from ARMv8 (clang's
// [Rn]!).
func TestParseArm32NeonLdStRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var bad *[]readonly char = "invalid operand for instruction"
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0:16]", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0:128]", several)
	e = armMsgIs(e, "", "vld1.16 {d0}, [r0:16]", several)
	e = armMsgIs(e, "", "vld3.8 {d0, d2, d4}, [r0:128]", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld4.32 {d0-d3}, [r0:16]", "alignment must be 64, 128, 256 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0, d2}, [r0]", bad)
	e = armMsgIs(e, "", "vld2.8 {d0}, [r0]", bad)
	e = armMsgIs(e, "", "vld1.8 {d0-d7}, [r0]", bad)
	e = armMsgIs(e, "", "vld1.32 {d0[2]}, [r0]", several)
	e = armMsgIs(e, "", "vld1.64 {d0[1]}, [r0]", several)
	e = armMsgIs(e, "", "vst1.8 {d0[]}, [r0]", bad)
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0, #8]", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0, #0]", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0, r1]", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0}, [d0]", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0}, r0", "alignment must be 64 or omitted")
	e = armMsgIs(e, "", "vld1.8 {d0}", "too few operands for instruction")
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0], #8", several)
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0], sp", several)
	e = armMsgIs(e, "", "vld1.8 {d0}, [r0]!, r1", "too many operands for instruction")
	e = armMsgIs(e, "", "vld1 {d0}, [r0]", "invalid instruction")
	e = armMsgIs(e, "", "vld2.64 {d0, d1}, [r0]", bad)
	e = armMsgIs(e, "", "vld1.f16 {d0}, [r0]", bad)
	e = armMsgIs(e, "", "vld1s.8 {d0}, [r0]",
			"instruction 'vld1' can not set flags, but 's' suffix specified")
	e = armMsgIs(e, ".fpu vfpv3", "vld1.8 {d0}, [r0]", "invalid instruction")
	e = armMsgIs(e, "", "vld1eq.8 {d0}, [r0]",
			"instruction 'vld1' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vld1.8 q0, [r0]", bad)
	e = armMsgIs(e, "", "vld1.8 {d0}, [pc]",
			"arm32: a NEON load's or store's base register is R0..R14")
	e = armMsgIs(e, ".arch armv8-a", "vld1.8 {d0}, [r0], sp",
			"arm32: a NEON load's or store's post-index register is R0..R12 or R14")
	return e
}
