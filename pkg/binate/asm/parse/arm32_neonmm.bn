package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// The BFloat16 and Int8 matrix forms (asm/arm32/neon's BfDot, BfDotLane, Bfmal, BfmalLane, Mmla,
// UsDot and UsDotLane), as clang takes them: with BF16 and NEON, VDOT.BF16 on three D or three Q
// registers or two and a scalar (D0..D15, lane 0..1), VFMAB.BF16 / VFMAT.BF16 on three Q registers
// or two and a scalar (D0..D7, lane 0..3), VMMLA.BF16 on three Q registers; with the Int8 matrix
// multiply, VSMMLA.S8, VUMMLA.U8 and VUSMMLA.S8 on three Q registers, VUSDOT.S8 as VDOT.BF16 is,
// and VSUDOT.U8 by a scalar only.  clang takes no condition on them, an error before their operands
// are read (arm32VdpNoCond).

// The instructions here (arm32NeonMmOp).
const (
	neonMmDot int = iota + 1
	neonMmFmab
	neonMmFmat
	neonMmMmla
	neonMmSmmla
	neonMmUmmla
	neonMmUsmmla
	neonMmUsdot
	neonMmSudot
)

// arm32NeonMmOp returns which of these name (lowercase, split) is (neonMm*), or 0 for none.
func arm32NeonMmOp(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"vdot", "vfmab", "vfmat", "vmmla", "vsmmla",
			"vummla", "vusmmla", "vusdot", "vsudot"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return neonMmDot + i }
	}
	return 0
}

// arm32NeonMmCands returns the encodings clang tries for name (arm32NeonMmOp), in its order, none
// with a condition operand: on Q registers, then D registers, then by a scalar, each as name takes
// them.
func arm32NeonMmCands(name *[]readonly char) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 4)
	var op int = arm32NeonMmOp(name)
	var d int = matchKindD
	var q int = matchKindQ
	var nc int = matchFormSIMDNoCond
	var t int = matchTypeBF16
	var need int = matchNeedBF16 | matchNeedNEON
	if op >= neonMmSmmla {
		need = matchNeedI8MM
		t = matchTypeS8
		if op == neonMmUmmla || op == neonMmSudot { t = matchTypeU8 }
	}
	var dm int = matchKindDScalar32
	var lane int = matchKindLane32
	if op == neonMmFmab || op == neonMmFmat {
		dm = matchKindDScalar16
		lane = matchKindLane16
	}
	if op != neonMmSudot { matchAdd(list, t, 0, matchOps(q, q, q), need, nc) }
	if op == neonMmDot || op == neonMmUsdot { matchAdd(list, t, 0, matchOps(d, d, d), need, nc) }
	var byScalar bool = op == neonMmDot || op == neonMmFmab || op == neonMmFmat || op == neonMmUsdot ||
			op == neonMmSudot
	if byScalar { matchAdd(list, t, 0, matchOps4(q, q, dm, lane), need, nc) }
	if op == neonMmDot || op == neonMmUsdot || op == neonMmSudot {
		matchAdd(list, t, 0, matchOps4(d, d, dm, lane), need, nc)
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonMmEmit assembles name (arm32NeonMmOp) as encoding c, its operands items: Vd, Vn, Vm,
// and by a scalar the lane (its low 32 bits, as clang takes it).
func arm32NeonMmEmit(p @Parser, name *[]readonly char, c arm32MatchCand, items @[]arm32MatchItem) {
	var op int = arm32NeonMmOp(name)
	var vd int = arm32NeonReg(items[0])
	var vn int = arm32NeonReg(items[1])
	var vm int = arm32NeonReg(items[2])
	var byLane bool = arm32MatchKindAt(c.ops, 3) != 0
	var x int = 0
	if byLane { x = cast(int, cast(uint32, items[3].val)) }
	if op == neonMmDot && byLane {
		neon.BfDotLane(p.Asm, vd, vn, vm, x)
	} else if op == neonMmDot {
		neon.BfDot(p.Asm, vd, vn, vm)
	} else if (op == neonMmFmab || op == neonMmFmat) && byLane {
		neon.BfmalLane(p.Asm, op == neonMmFmat, vd, vn, vm, x)
	} else if op == neonMmFmab || op == neonMmFmat {
		neon.Bfmal(p.Asm, op == neonMmFmat, vd, vn, vm)
	} else if op == neonMmUsdot && !byLane {
		neon.UsDot(p.Asm, vd, vn, vm)
	} else if op == neonMmUsdot || op == neonMmSudot {
		neon.UsDotLane(p.Asm, op == neonMmSudot, vd, vn, vm, x)
	} else {
		var mm int = 0
		if op == neonMmMmla { mm = neon.MMLA_BF16 }
		if op == neonMmSmmla { mm = neon.MMLA_S8 }
		if op == neonMmUmmla { mm = neon.MMLA_U8 }
		if op == neonMmUsmmla { mm = neon.MMLA_US8 }
		neon.Mmla(p.Asm, mm, vd, vn, vm)
	}
}
