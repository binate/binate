package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// arm32NeonMmCtx is the directive that gives the BFloat16 and Int8 matrix forms their features:
// ARMv8.6 (with NEON, BF16 and the Int8 matrix multiply).
var arm32NeonMmCtx *[]readonly char = ".arch armv8.6-a"

// The BFloat16 and Int8 matrix forms as clang assembles them: VDOT.BF16 on Q and D registers and
// by a scalar; VFMAB / VFMAT on Q registers and by a scalar (lane 2 too); VMMLA, VSMMLA, VUMMLA and
// VUSMMLA; VUSDOT on D registers and by a scalar; VSUDOT by a scalar; upper case, AL, and the
// features of a CPU that has them (neoverse-v1).
func TestParseArm32NeonMm() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32NeonMmCtx
	e = armGateIs(e, c, "vdot.bf16 q0, q1, q2", "FC020D44")
	e = armGateIs(e, c, "vdot.bf16 d1, d2, d4", "FC021D04")
	e = armGateIs(e, c, "vdot.bf16 q5, q4, d1[1]", "FE08AD61")
	e = armGateIs(e, c, "vfmab.bf16 q0, q1, q2", "FC320814")
	e = armGateIs(e, c, "vfmat.bf16 q5, q4, d1[2]", "FE38A871")
	e = armGateIs(e, c, "vmmla.bf16 q0, q1, q2", "FC020C44")
	e = armGateIs(e, c, "vsmmla.s8 q0, q1, q2", "FC220C44")
	e = armGateIs(e, c, "vummla.u8 q1, q2, q4", "FC242C58")
	e = armGateIs(e, c, "vusmmla.s8 q0, q1, q2", "FCA20C44")
	e = armGateIs(e, c, "vusdot.s8 d1, d2, d4", "FCA21D04")
	e = armGateIs(e, c, "vusdot.s8 q15, q10, d3[1]", "FEC4EDE3")
	e = armGateIs(e, c, "vsudot.u8 d7, d14, d1[1]", "FE8E7D31")
	e = armGateIs(e, c, "VMMLA.BF16 Q0, Q1, Q2", "FC020C44")
	e = armGateIs(e, c, "vdotal.bf16 q0, q1, q2", "FC020D44")
	e = armGateIs(e, ".cpu neoverse-v1", "vfmab.bf16 q0, q1, d2[1]", "FE32081A")
	return e
}

// What clang does not take of them, with its message: no BF16, no Int8 matrix multiply, BF16
// without NEON (in clang's order of features), a scalar register or lane past those it takes, D
// registers where only Q registers go, VSUDOT with no scalar, another type or none, an operand too
// few or too many, a core register; a condition (the error before the operands are read), an `s`.
func TestParseArm32NeonMmRejects() testing.TestResult {
	var e @[]char = ""
	var c *[]readonly char = arm32NeonMmCtx
	var bad *[]readonly char = "invalid operand for instruction"
	e = armMsgIs(e, ".arch armv8.5-a", "vdot.bf16 q0, q1, q2",
			"instruction requires: BFloat16 floating point extension")
	e = armMsgIs(e, ".cpu cortex-a76", "vsudot.u8 q0, q1, d2[1]",
			"instruction requires: 8-bit integer matrix multiply")
	e = armMsgIs(e, ".arch armv8.6-a\n.fpu vfpv4", "vfmab.bf16 q0, q1, d2[1]",
			"instruction requires: BFloat16 floating point extension NEON")
	e = armMsgIs(e, c, "vdot.bf16 q0, q1, d16[0]", "operand must be a register in range [d0, d15]")
	e = armMsgIs(e, c, "vdot.bf16 q0, q1, d2[2]", bad)
	e = armMsgIs(e, c, "vfmab.bf16 q0, q1, d8[0]", "operand must be a register in range [d0, d7]")
	e = armMsgIs(e, c, "vfmab.bf16 q0, q1, d2[4]", bad)
	e = armMsgIs(e, c, "vfmab.bf16 d0, d1, d2", "invalid instruction")
	e = armMsgIs(e, c, "vmmla.bf16 d0, d1, d2", "invalid instruction")
	e = armMsgIs(e, c, "vsudot.u8 d0, d1, d2", "too few operands for instruction")
	e = armMsgIs(e, c, "vsudot.u8 q0, q1, q2", "invalid instruction")
	e = armMsgIs(e, c, "vsmmla.u8 q0, q1, q2", bad)
	e = armMsgIs(e, c, "vmmla.f16 q0, q1, q2", bad)
	e = armMsgIs(e, c, "vsmmla q0, q1, q2", "invalid instruction")
	e = armMsgIs(e, c, "vusdot.s8 q0, q1, q2, q3", "too many operands for instruction")
	e = armMsgIs(e, c, "vdot.bf16 q0, q1, r2", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, c, "vdoteq.bf16 q0, q1, r2",
			"instruction 'vdot' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "vusdoths.s8 q0, q1, q2",
			"instruction 'vusdot' is not predicable, but condition code specified")
	e = armMsgIs(e, c, "vmmlas.bf16 q0, q1, q2",
			"instruction 'vmmla' can not set flags, but 's' suffix specified")
	return e
}
