package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/asm/arm32/vfp"

// NEON's VEXT and VDUP (asm/arm32/neon's Ext, DupCore and DupLane), as clang takes them: VEXT.8,
// .16, .32 on D and Q registers and .64 on Q registers, an index of the register's elements (a
// named range, 0..7 .. 0..1 on D, 0..15 .. 0..1 on Q), and with two registers too (Vd, Vm, #index
// for Vd, Vd, Vm, #index); VDUP.8, .16, .32 to a D or a Q register from a core register (with its
// condition) or from a D register's lane; and MVE's VDUP from a core register to Q0 .. Q7, as
// near misses.

// The instructions here (arm32NeonPermOp).
const (
	neonPermVext int = iota + 1
	neonPermVdup
)

// arm32NeonPermOp returns which of these name (lowercase, split) is (neonPerm*), or 0 for none.
func arm32NeonPermOp(name *[]readonly char) int {
	if charsEqual(name, "vext") { return neonPermVext }
	if charsEqual(name, "vdup") { return neonPermVdup }
	return 0
}

// arm32NeonPermCands returns the encodings clang tries for name (arm32NeonPermOp), in its order.
func arm32NeonPermCands(name *[]readonly char) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 24)
	var d int = matchKindD
	var q int = matchKindQ
	var neon int = matchNeedNEON
	var simd int = matchFormSIMD
	var sizes @[]int = @[]int{matchType8, matchType16, matchType32, matchType64}
	if arm32NeonPermOp(name) == neonPermVext {
		var onD @[]int = @[]int{matchKindImm0_7, matchKindImm0_3, matchKindImm0_1, 0}
		var onQ @[]int = @[]int{matchKindImm0_15, matchKindImm0_7, matchKindImm0_3, matchKindImm0_1}
		for i := 0; i < len(sizes); i++ {
			if onD[i] != 0 {
				matchAdd(list, sizes[i], 0, matchOps4(d, d, d, onD[i]), neon, simd)
			}
			matchAdd(list, sizes[i], 0, matchOps4(q, q, q, onQ[i]), neon, simd)
			if onD[i] != 0 { matchAdd(list, sizes[i], 0, matchOps(d, d, onD[i]), neon, simd) }
			matchAdd(list, sizes[i], 0, matchOps(q, q, onQ[i]), neon, simd)
		}
	} else {
		var r int = matchKindCore
		var lanes @[]int = @[]int{matchKindLane8, matchKindLane16, matchKindLane32}
		for i := 0; i < 3; i++ {
			matchAdd(list, sizes[i], 0, matchOps(d, r, 0), neon, matchFormVFP)
			matchAdd(list, sizes[i], 0, matchOps(q, r, 0), neon, matchFormVFP)
			matchAdd(list, sizes[i], 0, matchOps(d, d, lanes[i]), neon, simd)
			matchAdd(list, sizes[i], 0, matchOps(q, d, lanes[i]), neon, simd)
			matchAdd(list, sizes[i], 0, matchOps(matchKindMQ, matchKindRGPR, 0), matchNeedMVE, matchFormMVE)
		}
	}
	arm32MatchSort(list)
	return list
}

// arm32NeonPermEmit assembles name (arm32NeonPermOp) under cond as encoding c, its operands items:
// VEXT (unconditional; with two registers Vd is Vn too), VDUP from a core register under cond, or
// from a lane (unconditional; the lane its low 32 bits, as clang takes it).
func arm32NeonPermEmit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	var size int = 8
	if c.t1 == matchType16 { size = 16 }
	if c.t1 == matchType32 { size = 32 }
	if c.t1 == matchType64 { size = 64 }
	var vd int = arm32NeonReg(items[0])
	if arm32NeonPermOp(name) == neonPermVdup && arm32MatchKindAt(c.ops, 1) == matchKindCore {
		neon.DupCore(p.Asm, cond, size, vd, items[1].n)
		return
	}
	if !arm32NeonUnconditional(p, name, cond) { return }
	if arm32NeonPermOp(name) == neonPermVdup {
		neon.DupLane(p.Asm, size, vd, vfp.D0 + items[1].n, cast(int, cast(uint32, items[2].val)))
		return
	}
	if arm32MatchKindAt(c.ops, 3) == 0 {
		neon.Ext(p.Asm, size, vd, vd, arm32NeonReg(items[1]), cast(int, items[2].val))
		return
	}
	neon.Ext(p.Asm, size, vd, arm32NeonReg(items[1]), arm32NeonReg(items[2]), cast(int, items[3].val))
}
