package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// VEXT and VDUP as clang assembles them: VEXT of each element size on D and Q registers, at the
// ends of its index's range, a type standing for the size (.i8, .s16, .f32, .p8), with two
// registers; VDUP from a core register (high registers, SP and PC, a condition, a type standing
// for the size) and from a lane (high registers, the last lane of each size, a type standing for
// the size).
func TestParseArm32NeonPerm() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vext.8 d0, d1, d2, #3", "F2B10302")
	e = armGateIs(e, "", "vext.8 q0, q1, q2, #15", "F2B20F44")
	e = armGateIs(e, "", "vext.16 d0, d1, d2, #3", "F2B10602")
	e = armGateIs(e, "", "vext.16 q0, q1, q2, #7", "F2B20E44")
	e = armGateIs(e, "", "vext.32 d0, d1, d2, #1", "F2B10402")
	e = armGateIs(e, "", "vext.32 q15, q14, q13, #3", "F2FCECEA")
	e = armGateIs(e, "", "vext.64 q0, q1, q2, #1", "F2B20844")
	e = armGateIs(e, "", "vext.i8 d0, d1, d2, #1", "F2B10102")
	e = armGateIs(e, "", "vext.s16 d0, d1, d2, #1", "F2B10202")
	e = armGateIs(e, "", "vext.f32 d0, d1, d2, #1", "F2B10402")
	e = armGateIs(e, "", "vext.p8 d0, d1, d2, #1", "F2B10102")
	e = armGateIs(e, "", "vext.8 d0, d1, #3", "F2B00301")
	e = armGateIs(e, "", "vext.8 q15, q1, #15", "F2FEEFC2")
	e = armGateIs(e, "", "vext.64 q0, q1, #1", "F2B00842")
	e = armGateIs(e, "", "vdup.8 d0, r0", "EEC00B10")
	e = armGateIs(e, "", "vdup.16 q15, lr", "EEAEEBB0")
	e = armGateIs(e, "", "vdup.32 d31, r12", "EE8FCB90")
	e = armGateIs(e, "", "vdup.32 q0, sp", "EEA0DB10")
	e = armGateIs(e, "", "vdup.32 d0, pc", "EE80FB10")
	e = armGateIs(e, "", "vdupeq.8 q1, r1", "0EE21B10")
	e = armGateIs(e, "", "vdup.i32 d0, r0", "EE800B10")
	e = armGateIs(e, "", "vdup.f32 q0, r0", "EEA00B10")
	e = armGateIs(e, "", "vdup.u16 d0, r0", "EE800B30")
	e = armGateIs(e, "", "vdup.8 d0, d1[7]", "F3BF0C01")
	e = armGateIs(e, "", "vdup.8 q0, d31[0]", "F3B10C6F")
	e = armGateIs(e, "", "vdup.16 d0, d1[3]", "F3BE0C01")
	e = armGateIs(e, "", "vdup.32 q15, d16[1]", "F3FCEC60")
	e = armGateIs(e, "", "vdup.f32 d0, d1[1]", "F3BC0C01")
	e = armGateIs(e, "", "vdup.p8 q0, d1[1]", "F3B30C41")
	e = armGateIs(e, "", "vdup.32 q8, r0", "EEA00B90")
	return e
}

// What clang does not take of them, with its message: VEXT.64 on D registers, no type, an index
// past the range (a named range's message where it is the only near miss), a Q register among D
// registers; VDUP.64, no type, a lane past the register's, a Q register's lane, an S register, a
// D register with no lane; no NEON (and MVE's VDUP to Q0 .. Q7 a near miss); and here a condition
// on VEXT or a VDUP of a lane, which clang drops.
func TestParseArm32NeonPermRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vext.64 d0, d1, d2, #0", "invalid operand for instruction")
	e = armMsgIs(e, "", "vext d0, d1, d2, #1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vext.8 d0, d1, d2, #8", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vext.64 q0, q1, q2, #16", "operand must be an immediate in the range [0,1]")
	e = armMsgIs(e, "", "vext.32 q0, q1, q2, #16", "operand must be an immediate in the range [0,3]")
	e = armMsgIs(e, "", "vext.8 q0, q1, q2, #16", "operand must be an immediate in the range [0,15]")
	e = armMsgIs(e, "", "vext.32 d0, d1, #2", several)
	e = armMsgIs(e, "", "vext.8 d0, d1, #8", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vext.16 d0, d1, d2, #4", several)
	e = armMsgIs(e, "", "vext.32 q0, q1, q2, #4", several)
	e = armMsgIs(e, "", "vext.64 q0, q1, q2, #2", several)
	e = armMsgIs(e, "", "vexteq.8 d0, d1, d2, #3",
			"instruction 'vext' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vext.8 d0, d1, q2, #3", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vext.8 d0, d1, d2, #-1", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vdup.64 d0, r0", "invalid operand for instruction")
	e = armMsgIs(e, "", "vdup d0, r0", "invalid instruction")
	e = armMsgIs(e, "", "vdup.32 d0, d1[2]", several)
	e = armMsgIs(e, "", "vdup.16 d0, d1[4]", several)
	e = armMsgIs(e, "", "vdup.8 d0, d1[8]", "invalid operand for instruction")
	e = armMsgIs(e, "", "vdupeq.32 d0, d1[1]",
			"instruction 'vdup' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vdup.32 q0, q1[1]", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vdup.32 d0, s1", "operand must be a register in range [r0, r15]")
	e = armMsgIs(e, "", "vdup.32 q0, d1", several)
	e = armMsgIs(e, v3, "vdup.32 d0, r0", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vdup.32 q0, r0", several)
	e = armMsgIs(e, v3, "vdup.32 d0, d1[1]", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vext.8 d0, d1, d2, #1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vdup.32 q0, d1[1]", "instruction requires: NEON")
	return e
}

// VTBL and VTBX as clang assembles them: lists of one to four D registers written one by one, as a
// range (one register long too, up to D31), as Q registers and D and Q registers mixed, a D
// register alone; a type standing for .8.
func TestParseArm32NeonTbl() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vtbl.8 d0, {d1}, d2", "F3B10802")
	e = armGateIs(e, "", "vtbl.8 d0, {d1, d2}, d3", "F3B10903")
	e = armGateIs(e, "", "vtbl.8 d0, {d1, d2, d3}, d4", "F3B10A04")
	e = armGateIs(e, "", "vtbl.8 d0, {d1, d2, d3, d4}, d5", "F3B10B05")
	e = armGateIs(e, "", "vtbl.8 d0, {d1-d4}, d5", "F3B10B05")
	e = armGateIs(e, "", "vtbl.8 d31, {d28-d31}, d30", "F3FCFBAE")
	e = armGateIs(e, "", "vtbx.8 d0, {d1}, d2", "F3B10842")
	e = armGateIs(e, "", "vtbx.8 d0, {d1-d3}, d2", "F3B10A42")
	e = armGateIs(e, "", "vtbl.8 d0, d1, d2", "F3B10802")
	e = armGateIs(e, "", "vtbl.8 d0, {q1}, d2", "F3B20902")
	e = armGateIs(e, "", "vtbl.8 d0, {q1, q2}, d2", "F3B20B02")
	e = armGateIs(e, "", "vtbl.8 d0, {d1, q1}, d2", "F3B10A02")
	e = armGateIs(e, "", "vtbl.8 d0, {d1-d1}, d3", "F3B10803")
	e = armGateIs(e, "", "vtbl.8 d0, {d1-q1}, d3", "F3B10A03")
	e = armGateIs(e, "", "vtbl.i8 d0, {d1}, d2", "F3B10802")
	e = armGateIs(e, "", "vtbl.u8 d0, {d1}, d2", "F3B10802")
	e = armGateIs(e, "", "vtbl.p8 d0, {d1}, d2", "F3B10802")
	e = armGateIs(e, "", "vtbl.8 d0, {d0-d3}, d4", "F3B00B04")
	return e
}

// What clang does not take of VTBL and VTBX, with its message: every other register, five
// registers, a lane, a type other than .8 or none, a Q destination, the list in another place, a
// list as Vm, too few or too many operands, no NEON.
func TestParseArm32NeonTblRejects() testing.TestResult {
	var e @[]char = ""
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, d3}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1-d5}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, d2, d3, d4, d5}, d6", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[]}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[0]}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.16 d0, {d1}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl d0, {d1}, d2", "invalid instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1}", "too few operands for instruction")
	e = armMsgIs(e, "", "vtbl.8 {d1}, d0, d2", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1}, {d2}", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, d2}, d3, d4", "too many operands for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[1+1]}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1[#1]}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 d0, {d1, d3, d5}, d2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vtbl.8 q0, {d1}, d2", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, v3, "vtbl.8 d0, {d1}, d2", "invalid instruction")
	return e
}
