package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"

// NEON's two registers and a scalar (asm/arm32/neon's Scalar), as clang takes them, among the
// encodings of the names they share (arm32_neon3.bn, arm32_neondiff.bn): VMUL, VMLA and VMLS (.I16
// / .I32, .S or .U standing for .I, .F32, and .F16 with full FP16), VQDMULH / VQRDMULH (.S16 /
// .S32) and ARMv8.1's VQRDMLAH / VQRDMLSH (.S16 / .S32) as Dd, Dn, Dm[x] or Qd, Qn, Dm[x], VMUL
// with Vd, Dm[x] too; the long ones VMULL, VMLAL, VMLSL (.S16 / .S32 / .U16 / .U32) and VQDMULL,
// VQDMLAL, VQDMLSL (.S16 / .S32) as Qd, Dn, Dm[x].  The scalar is D0..D7 with lanes 0..3 for 16-bit
// elements, D0..D15 with lanes 0..1 for 32-bit ones.

// arm32NeonScalarMost is the most by-scalar encodings a name has (arm32NeonScalarAdd).
const arm32NeonScalarMost int = 16

// arm32NeonScalarOp returns the operation (neon.SCALAR_*) name (lowercase, split) has by a scalar,
// or 0.
func arm32NeonScalarOp(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"vmla", "vmlal", "vqdmlal", "vmls", "vmlsl",
			"vqdmlsl", "vmul", "vmull", "vqdmull", "vqdmulh", "vqrdmulh", "vqrdmlah", "vqrdmlsh"}
	var ops @[]int = @[]int{neon.SCALAR_VMLA, neon.SCALAR_VMLAL, neon.SCALAR_VQDMLAL, neon.SCALAR_VMLS,
			neon.SCALAR_VMLSL, neon.SCALAR_VQDMLSL, neon.SCALAR_VMUL, neon.SCALAR_VMULL, neon.SCALAR_VQDMULL,
			neon.SCALAR_VQDMULH, neon.SCALAR_VQRDMULH, neon.SCALAR_VQRDMLAH, neon.SCALAR_VQRDMLSH}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return ops[i] }
	}
	return 0
}

// arm32NeonScalarAdd appends name's by-scalar encodings (arm32NeonScalarOp) to list: each data type
// on D registers and on Q registers (a long one's Q result of a D register), the scalar of the
// type's element size, and VMUL's on two registers as well.
func arm32NeonScalarAdd(list @arm32MatchList, name *[]readonly char) {
	var op int = arm32NeonScalarOp(name)
	if op == 0 { return }
	var long bool = op == neon.SCALAR_VMLAL || op == neon.SCALAR_VQDMLAL || op == neon.SCALAR_VMLSL ||
			op == neon.SCALAR_VQDMLSL || op == neon.SCALAR_VMULL || op == neon.SCALAR_VQDMULL
	var types @[]int = @[]int{matchTypeI16, matchTypeI32, matchTypeF32, matchTypeF16}
	var v81 bool = op == neon.SCALAR_VQRDMLAH || op == neon.SCALAR_VQRDMLSH
	if op == neon.SCALAR_VQDMULH || op == neon.SCALAR_VQRDMULH || op == neon.SCALAR_VQDMLAL ||
			op == neon.SCALAR_VQDMLSL || op == neon.SCALAR_VQDMULL || v81 {
		types = @[]int{matchTypeS16, matchTypeS32}
	}
	if op == neon.SCALAR_VMLAL || op == neon.SCALAR_VMLSL || op == neon.SCALAR_VMULL {
		types = @[]int{matchTypeS16, matchTypeS32, matchTypeU16, matchTypeU32}
	}
	var d int = matchKindD
	var q int = matchKindQ
	for i := 0; i < len(types); i++ {
		var t int = types[i]
		var reg int = matchKindDScalar32
		var lane int = matchKindLane32
		if t == matchTypeI16 || t == matchTypeS16 || t == matchTypeU16 || t == matchTypeF16 {
			reg = matchKindDScalar16
			lane = matchKindLane16
		}
		var need int = matchNeedNEON
		if t == matchTypeF16 { need = need | matchNeedFull16 }
		if v81 { need = need | matchNeedV8_1 }
		var simd int = matchFormSIMD
		if long {
			matchAdd(list, t, 0, matchOps4(q, d, reg, lane), need, simd)
			continue
		}
		matchAdd(list, t, 0, matchOps4(d, d, reg, lane), need, simd)
		matchAdd(list, t, 0, matchOps4(q, q, reg, lane), need, simd)
		if op != neon.SCALAR_VMUL { continue }
		matchAdd(list, t, 0, matchOps(d, reg, lane), need, simd)
		matchAdd(list, t, 0, matchOps(q, reg, lane), need, simd)
	}
}

// arm32NeonScalarCand reports whether encoding c is a by-scalar one, a lane among its operands.
func arm32NeonScalarCand(c arm32MatchCand) bool {
	for i := 0; i < 4; i++ {
		var k int = arm32MatchKindAt(c.ops, i)
		if k == matchKindLane16 || k == matchKindLane32 { return true }
	}
	return false
}

// arm32NeonScalarEmit assembles name (arm32NeonScalarOp) under cond as by-scalar encoding c, its
// operands items -- Vd, Vn, Dm and the lane, or Vd, Dm and the lane for Vd, Vd, Dm[x] --
// unconditional.
func arm32NeonScalarEmit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var vd int = arm32NeonReg(items[0])
	var vn int = vd
	var at int = 1
	if arm32MatchKindAt(c.ops, 3) != 0 {
		vn = arm32NeonReg(items[1])
		at = 2
	}
	var lane int = cast(int, cast(uint32, items[at + 1].val))
	neon.Scalar(p.Asm, arm32NeonScalarOp(name), arm32NeonDT(c.t1), vd, vn, arm32NeonReg(items[at]),
			lane)
}
