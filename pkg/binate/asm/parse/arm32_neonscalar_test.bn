package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each by-scalar name is its operation; VMUL has four encodings per type (D, Q, and both on two
// registers), VMLA two, the long ones one, over four types (two for the saturating ones); a name
// with none none.
func TestArm32NeonScalarEncodings() testing.TestResult {
	if arm32NeonScalarOp("vmull") != neon.SCALAR_VMULL || arm32NeonScalarOp("vadd") != 0 {
		return fail("a by-scalar name's operation is wrong")
	}
	var names @[]*[]readonly char = @[]*[]readonly char{"vmul", "vmla", "vmull", "vqdmull", "vqdmulh",
			"vadd"}
	var counts @[]int = @[]int{16, 8, 4, 2, 4, 0}
	for i := 0; i < len(names); i++ {
		var list @arm32MatchList = make(arm32MatchList)
		list.c = make_slice(arm32MatchCand, arm32NeonScalarMost)
		arm32NeonScalarAdd(list, names[i])
		if list.n != counts[i] {
			return fail(buf.Concat("wrong count of by-scalar encodings: ", names[i]))
		}
	}
	return ""
}

// The by-scalar forms as clang assembles them: each kind of type (.S / .U for .I), the scalar's
// highest register and lane for each element size, D and Q forms, VMUL on two registers, the long
// and saturating ones, .F16 with full FP16, a lane's low 32 bits.
func TestParseArm32NeonScalarForms() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vmul.i16 d0, d1, d2[0]", "F2910842")
	e = armGateIs(e, "", "vmul.s16 q8, q9, d7[3]", "F3D208EF")
	e = armGateIs(e, "", "vmul.u32 d0, d1, d15[1]", "F2A1086F")
	e = armGateIs(e, "", "vmul.f32 q0, q1, d2[0]", "F3A20942")
	e = armGateIs(e, "", "vmul.i16 d0, d1[0]", "F2900841")
	e = armGateIs(e, "", "vmul.f32 q0, d1[0]", "F3A00941")
	e = armGateIs(e, h, "vmul.f16 d31, d30, d7[1]", "F2DEF9CF")
	e = armGateIs(e, "", "vmla.i32 d31, d30, d7[1]", "F2EEF0E7")
	e = armGateIs(e, h, "vmla.f16 q8, q9, d7[3]", "F3D201EF")
	e = armGateIs(e, "", "vmls.i16 d0, d1, d2[2]", "F2910462")
	e = armGateIs(e, "", "vmls.f d0, d1, d8[0]", "F2A10548")
	e = armGateIs(e, "", "vmlal.u32 q15, d31, d15[1]", "F3EFE2EF")
	e = armGateIs(e, "", "vmlsl.s16 q0, d1, d2[0]", "F2910642")
	e = armGateIs(e, "", "vmull.s32 q15, d31, d15[1]", "F2EFEAEF")
	e = armGateIs(e, "", "vmull.u16 q0, d1, d2[0]", "F3910A42")
	e = armGateIs(e, "", "vqdmull.s32 q15, d31, d15[1]", "F2EFEBEF")
	e = armGateIs(e, "", "vqdmlal.s16 q0, d1, d2[0]", "F2910342")
	e = armGateIs(e, "", "vqdmlsl.s32 q0, d1, d2[0]", "F2A10742")
	e = armGateIs(e, "", "vqdmulh.s16 q8, q9, d7[3]", "F3D20CEF")
	e = armGateIs(e, "", "vqrdmulh.s32 d31, d30, d7[1]", "F2EEFDE7")
	e = armGateIs(e, "", "vmul.i16 d0, d1, d2[4294967299]", "F291086A")
	e = armGateIs(e, "", "vmul.i32 d0, d1, d2[0x100000001]", "F2A10862")
	return e
}

// What clang does not take of them, with its message: a scalar register past the element size's
// (D8 for 16 bits, D16 for 32; with the three-same form's one operand too many and the other
// size's type a near miss), or no D register; a lane past it (alone, the three-same form's extra
// operand the same place), or a negative one; no lane where VMLA has only by-scalar Q forms; a
// lane on Vn; a type no by-scalar form has; no NEON; one operand too many after the lane; the
// lane's own errors.
func TestParseArm32NeonScalarRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var bad *[]readonly char = "invalid operand for instruction"
	e = armMsgIs(e, "", "vmul.i16 d0, d1, d8[0]", several)
	e = armMsgIs(e, "", "vmul.i32 d0, d1, d16[0]", several)
	e = armMsgIs(e, "", "vmull.s16 q0, d1, d8[0]", several)
	e = armMsgIs(e, "", "vmul.i16 d0, d1, q2[0]", "operand must be a register in range [d0, d7]")
	e = armMsgIs(e, "", "vmul.i16 d0, d1, r2[0]", "operand must be a register in range [d0, d7]")
	e = armMsgIs(e, "", "vmul.i16 d0, d1, d2[4]", bad)
	e = armMsgIs(e, "", "vmull.s16 q0, d1, d2[4]", bad)
	e = armMsgIs(e, "", "vmul.i16 d0, d1, d2[-1]", bad)
	e = armMsgIs(e, "", "vmul.i32 d0, d1, d2[2]", several)
	e = armMsgIs(e, "", "vmla.i16 q0, q1, d2", several)
	e = armMsgIs(e, "", "vmul.i16 d0, d1[0], d2[0]", "invalid instruction")
	e = armMsgIs(e, "", "vmul.i8 d0, d1, d2[0]", several)
	e = armMsgIs(e, ".fpu vfpv3", "vmul.i16 d0, d1, d2[0]", "instruction requires: NEON")
	e = armMsgIs(e, "", "vmul.i16 d0, d1, d2[0], d3", "too many operands for instruction")
	e = armMsgIs(e, "", "vmull.s16 q0, d1[0]", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vmla.i16 d0, d1[0]", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vqdmulh.s16 d0, d1[0]", several)
	e = armMsgIs(e, "", "vmul.i16 d0, d1, d2[x]", "immediate value expected for vector index")
	return e
}

// clang's pre-UAL aliases fmuls and fmacs (VMUL.F32, VMLA.F32) take the by-scalar forms too.
func TestParseArm32NeonScalarPreUal() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "fmuls d0, d1, d2[0]", "F2A10942")
	e = armGateIs(e, "", "fmuls d0, d1[0]", "F2A00941")
	e = armGateIs(e, "", "fmacs q0, q1, d2[1]", "F3A20162")
	return e
}
