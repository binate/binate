package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/buf"

// NEON's shifts by an immediate (asm/arm32/neon's Shift), as clang takes them: Vd, Vm, #n or Vd, #n
// for Vd, Vd, #n, on D or Q registers.  The right shifts VSHR, VSRA, VRSHR, VRSRA (.S8 .. .S64,
// .U8 .. .U64) and VSRI (.8 .. .64, a type standing for its size) shift by 1..e, the element size;
// the left shifts VSHL (.I8 .. .I64, .S or .U standing for .I), VSLI (.8 .. .64), VQSHL (.S / .U)
// and VQSHLU (.S) by any expression clang takes, which it wraps into 0..e-1 (vshl.i8 d0, d1, #63
// is a shift by 7), where an amount past 0..e-1, or no constant, is an error here.  MVE's
// encodings of VSHR, VRSHR, VSHL, VQSHL, VQSHLU, VSRI and VSLI (8 .. 32 bits, on Q0..Q7, its left
// shifts by 0..e-1) are near misses.  VSHL and VQSHL by a register are NEON's three-same
// (arm32_neon3.bn).  The narrowing shifts take Dd, Qm, #n, shifting by 1..e/2 (the result's
// element size): VSHRN and VRSHRN (.I16 .. .I64), VQSHRN and VQRSHRN (.S / .U 16 .. 64), VQSHRUN
// and VQRSHRUN (.S); the long VSHLL (.S / .U 8 .. 32) Qd, Dm, #n by 1..e-1, and by e (.I, .S or .U
// standing for it); VMOVL (.S / .U 8 .. 32) Qd, Dm is VSHLL by 0.

// arm32NeonShiftMost is the most shift-by-immediate encodings a name has (arm32NeonShiftAdd).
const arm32NeonShiftMost int = 38

// arm32NeonShiftOp returns the operation (neon.SHIFT_*) name (lowercase, split) has by an
// immediate (VMOVL's VSHLL), or 0.
func arm32NeonShiftOp(name *[]readonly char) int {
	var names @[]*[]readonly char = @[]*[]readonly char{"vshr", "vsra", "vrshr", "vrsra", "vsri",
			"vshl", "vsli", "vqshlu", "vqshl", "vshrn", "vrshrn", "vqshrn", "vqrshrn", "vqshrun", "vqrshrun",
			"vshll", "vmovl"}
	var ops @[]int = @[]int{neon.SHIFT_VSHR, neon.SHIFT_VSRA, neon.SHIFT_VRSHR, neon.SHIFT_VRSRA,
			neon.SHIFT_VSRI, neon.SHIFT_VSHL, neon.SHIFT_VSLI, neon.SHIFT_VQSHLU, neon.SHIFT_VQSHL,
			neon.SHIFT_VSHRN, neon.SHIFT_VRSHRN, neon.SHIFT_VQSHRN, neon.SHIFT_VQRSHRN, neon.SHIFT_VQSHRUN,
			neon.SHIFT_VQRSHRUN, neon.SHIFT_VSHLL, neon.SHIFT_VSHLL}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return ops[i] }
	}
	return 0
}

// arm32NeonShiftTypes returns shift operation op's (neon.SHIFT_*) data types, of the elements it
// shifts (VSHLL's of its shifts by 1..e-1).
func arm32NeonShiftTypes(op int) @[]int {
	if op == neon.SHIFT_VSRI || op == neon.SHIFT_VSLI {
		return @[]int{matchType8, matchType16, matchType32, matchType64}
	}
	if op == neon.SHIFT_VSHL { return @[]int{matchTypeI8, matchTypeI16, matchTypeI32, matchTypeI64} }
	if op == neon.SHIFT_VQSHLU { return @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeS64} }
	if op == neon.SHIFT_VSHRN || op == neon.SHIFT_VRSHRN {
		return @[]int{matchTypeI16, matchTypeI32, matchTypeI64}
	}
	if op == neon.SHIFT_VQSHRUN || op == neon.SHIFT_VQRSHRUN {
		return @[]int{matchTypeS16, matchTypeS32, matchTypeS64}
	}
	if op == neon.SHIFT_VQSHRN || op == neon.SHIFT_VQRSHRN {
		return @[]int{matchTypeS16, matchTypeS32, matchTypeS64, matchTypeU16, matchTypeU32, matchTypeU64}
	}
	if op == neon.SHIFT_VSHLL {
		return @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeU8, matchTypeU16, matchTypeU32}
	}
	return @[]int{matchTypeS8, matchTypeS16, matchTypeS32, matchTypeS64, matchTypeU8, matchTypeU16,
			matchTypeU32, matchTypeU64}
}

// arm32NeonShiftSize returns data type t's element size code (0 for 8 bits .. 3 for 64).
func arm32NeonShiftSize(t int) int {
	if t == matchType8 || t == matchTypeI8 || t == matchTypeS8 || t == matchTypeU8 { return 0 }
	if t == matchType16 || t == matchTypeI16 || t == matchTypeS16 || t == matchTypeU16 { return 1 }
	if t == matchType32 || t == matchTypeI32 || t == matchTypeS32 || t == matchTypeU32 { return 2 }
	return 3
}

// The ranges of a shift's amount (arm32NeonShiftAmount): a right shift's (1..e), MVE's left
// shift's (0..e-1), VSHLL's (1..e-1), and VSHLL's by the element size (e).
const (
	shiftAmountRight int = iota
	shiftAmountLeft
	shiftAmountLong
	shiftAmountLongMax
)

// arm32NeonShiftAmount returns the kind of a shift's amount of range rng (shiftAmount*) for
// elements of size code size (0 for 8 bits .. 2 for 32; a right shift's to 3, for 64).
func arm32NeonShiftAmount(rng int, size int) int {
	var kinds @[]int = @[]int{matchKindShr8, matchKindShr16, matchKindShr32, matchKindShr64}
	if rng == shiftAmountLeft { kinds = @[]int{matchKindShl8, matchKindShl16, matchKindShl32} }
	if rng == shiftAmountLong { kinds = @[]int{matchKindShll8, matchKindShll16, matchKindShll32} }
	if rng == shiftAmountLongMax {
		kinds = @[]int{matchKindShllMax8, matchKindShllMax16, matchKindShllMax32}
	}
	return kinds[size]
}

// arm32NeonShiftAdd appends name's shift-by-immediate encodings (arm32NeonShiftOp) to list: a
// narrowing or long shift's (arm32NeonShiftAddResized); else NEON's, each data type on D and on Q
// registers, on three operands and on two, the amount a right shift's range or any immediate, then
// MVE's (but for VSRA and VRSRA, which MVE has not), 8 .. 32 bits on Q0..Q7, the amount a right
// shift's or a left shift's range.
func arm32NeonShiftAdd(list @arm32MatchList, name *[]readonly char) {
	var op int = arm32NeonShiftOp(name)
	if op == 0 { return }
	if op >= neon.SHIFT_VSHRN {
		arm32NeonShiftAddResized(list, name, op)
		return
	}
	var right bool = op <= neon.SHIFT_VSRI
	var types @[]int = arm32NeonShiftTypes(op)
	var d int = matchKindD
	var q int = matchKindQ
	var neonNeed int = matchNeedNEON
	var simd int = matchFormSIMD
	for i := 0; i < len(types); i++ {
		var amount int = matchKindImm
		if right { amount = arm32NeonShiftAmount(shiftAmountRight, arm32NeonShiftSize(types[i])) }
		matchAdd(list, types[i], 0, matchOps(d, d, amount), neonNeed, simd)
		matchAdd(list, types[i], 0, matchOps(q, q, amount), neonNeed, simd)
		matchAdd(list, types[i], 0, matchOps(d, amount, 0), neonNeed, simd)
		matchAdd(list, types[i], 0, matchOps(q, amount, 0), neonNeed, simd)
	}
	if op == neon.SHIFT_VSRA || op == neon.SHIFT_VRSRA { return }
	var mq int = matchKindMQ
	for i := 0; i < len(types); i++ {
		var size int = arm32NeonShiftSize(types[i])
		if size == 3 { continue }
		var rng int = shiftAmountLeft
		if right { rng = shiftAmountRight }
		matchAdd(list, types[i], 0, matchOps(mq, mq, arm32NeonShiftAmount(rng, size)), matchNeedMVE,
				matchFormMVE)
	}
}

// arm32NeonShiftAddResized appends to list the encodings of name, a narrowing or long shift by an
// immediate (op its arm32NeonShiftOp), all NEON's: a narrowing one's, each data type's Dd, Qm and
// an amount of 1..e/2; VSHLL's, each .S and .U type's Qd, Dm and an amount of 1..e-1, then each .I
// type's Qd, Dm and the element size; VMOVL's, each type's Qd, Dm.
func arm32NeonShiftAddResized(list @arm32MatchList, name *[]readonly char, op int) {
	var types @[]int = arm32NeonShiftTypes(op)
	var d int = matchKindD
	var q int = matchKindQ
	var neonNeed int = matchNeedNEON
	var simd int = matchFormSIMD
	var vmovl bool = charsEqual(name, "vmovl")
	for i := 0; i < len(types); i++ {
		var size int = arm32NeonShiftSize(types[i])
		var ops int64 = matchOps(q, d, 0)
		if op != neon.SHIFT_VSHLL {
			ops = matchOps(d, q, arm32NeonShiftAmount(shiftAmountRight, size - 1))
		} else if !vmovl {
			ops = matchOps(q, d, arm32NeonShiftAmount(shiftAmountLong, size))
		}
		matchAdd(list, types[i], 0, ops, neonNeed, simd)
	}
	if op != neon.SHIFT_VSHLL || vmovl { return }
	var wide @[]int = @[]int{matchTypeI8, matchTypeI16, matchTypeI32}
	for i := 0; i < len(wide); i++ {
		var amount int = arm32NeonShiftAmount(shiftAmountLongMax, i)
		matchAdd(list, wide[i], 0, matchOps(q, d, amount), neonNeed, simd)
	}
}

// arm32NeonShiftCands returns the encodings clang tries for a shift-by-immediate name that has no
// three-same ones (all but VSHL and VQSHL), in its order.
func arm32NeonShiftCands(name *[]readonly char) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32NeonShiftMost)
	arm32NeonShiftAdd(list, name)
	arm32MatchSort(list)
	return list
}

// arm32NeonShiftCand reports whether encoding c of name is a shift by an immediate: an amount among
// its operands, or VMOVL's (a VSHLL by 0).
func arm32NeonShiftCand(name *[]readonly char, c arm32MatchCand) bool {
	if charsEqual(name, "vmovl") { return true }
	for i := 1; i < 3; i++ {
		var k int = arm32MatchKindAt(c.ops, i)
		if k == matchKindImm || (k >= matchKindShr8 && k <= matchKindShllMax32) { return true }
	}
	return false
}

// arm32NeonShiftEmit assembles shift-by-immediate name (arm32NeonShiftOp) under cond as encoding c,
// its operands items -- Vd, Vm and the amount, Vd and the amount for Vd, Vd, #n, or VMOVL's Vd and
// Vm (an amount of 0) -- unconditional; a left shift's amount, which clang takes as any expression
// and wraps, is an error here past 0..e-1 or not a constant.
func arm32NeonShiftEmit(p @Parser, name *[]readonly char, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if !arm32NeonUnconditional(p, name, cond) { return }
	var vd int = arm32NeonReg(items[0])
	var vm int = vd
	var at int = 1
	var second int = arm32MatchKindAt(c.ops, 1)
	if second == matchKindD || second == matchKindQ {
		vm = arm32NeonReg(items[1])
		at = 2
	}
	var kind int = arm32MatchKindAt(c.ops, at)
	var amount int64 = 0
	if kind != 0 { amount = items[at].val }
	var size int = arm32NeonShiftSize(c.t1)
	if kind == matchKindImm && (!items[at].known || amount < 0 || amount >= cast(int64, 8 << size)) {
		var ranges @[]*[]readonly char = @[]*[]readonly char{"[0,7]", "[0,15]", "[0,31]", "[0,63]"}
		setErr(p, buf.Concat("operand must be an immediate in the range ", ranges[size]))
		return
	}
	neon.Shift(p.Asm, arm32NeonShiftOp(name), arm32NeonDT(c.t1), vd, vm, cast(int, amount))
}
