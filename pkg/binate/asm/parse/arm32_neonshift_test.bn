package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each shift name is its operation; a right shift's (VSHR) eight types on four operand shapes
// and MVE's six, VSRA's none of MVE's, VSRI's four sizes and MVE's three; a name with none none.
func TestArm32NeonShiftEncodings() testing.TestResult {
	if arm32NeonShiftOp("vqshlu") != neon.SHIFT_VQSHLU || arm32NeonShiftOp("vadd") != 0 {
		return fail("a shift name's operation is wrong")
	}
	var names @[]*[]readonly char = @[]*[]readonly char{"vshr", "vsra", "vsri", "vshl", "vqshl",
			"vadd"}
	var counts @[]int = @[]int{38, 32, 19, 19, 38, 0}
	for i := 0; i < len(names); i++ {
		if arm32NeonShiftCands(names[i]).n != counts[i] {
			return fail(buf.Concat("wrong count of shift encodings: ", names[i]))
		}
	}
	return ""
}

// The shifts by an immediate as clang assembles them: right shifts by 1..e (VSRI's size types,
// .p8 or .i64 standing for one), left shifts by 0..e-1 (VSHL's .S / .U standing for .I), the
// two-operand form, high registers.
func TestParseArm32NeonShiftForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vshr.s8 d0, d1, #1", "F28F0011")
	e = armGateIs(e, "", "vshr.u8 d0, d1, #8", "F3880011")
	e = armGateIs(e, "", "vsra.s64 d0, d1, #64", "F2800191")
	e = armGateIs(e, "", "vrshr.s32 d0, #1", "F2BF0210")
	e = armGateIs(e, "", "vrsra.u16 q0, #1", "F39F0350")
	e = armGateIs(e, "", "vsri.p8 d0, d1, #1", "F38F0411")
	e = armGateIs(e, "", "vsri.i64 d0, d1, #64", "F3800491")
	e = armGateIs(e, "", "vshl.i8 d0, d1, #0", "F2880511")
	e = armGateIs(e, "", "vshl.s8 d0, d1, #7", "F28F0511")
	e = armGateIs(e, "", "vshl.u64 q0, #1", "F28105D0")
	e = armGateIs(e, "", "vsli.s16 d0, d1, #15", "F39F0511")
	e = armGateIs(e, "", "vqshl.u64 d0, d1, #63", "F3BF0791")
	e = armGateIs(e, "", "vqshlu.s32 d0, d1, #0", "F3A00611")
	e = armGateIs(e, "", "vshr.s8 q15, q14, #3", "F2CDE07C")
	e = armGateIs(e, "", "vqshl.u8 d31, d30, #5", "F3CDF73E")
	e = armGateIs(e, "", "vshl.s8 d0, d1, d2", "F2020401")
	return e
}

// What clang does not take of them, with its message: a right shift's amount past its range
// (alone, or with the next size's form a type off), a register for it, a type the shift has not,
// two operands of different lengths, no NEON (and MVE's forms of the Q ones near misses too); and
// here a left shift's amount past 0..e-1 or no constant, which clang wraps (vshl.i8 #63 is #7).
func TestParseArm32NeonShiftRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vshr.s8 d0, d1, #0", "operand must be an immediate in the range [1,8]")
	e = armMsgIs(e, "", "vshr.s64 d0, d1, #65", "operand must be an immediate in the range [1,64]")
	e = armMsgIs(e, "", "vshr.s8 d0, d1, #9", several)
	e = armMsgIs(e, "", "vshr.s8 d0, d1, d2", "operand must be an immediate in the range [1,8]")
	e = armMsgIs(e, "", "vshr.i8 d0, d1, #1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vqshlu.u8 d0, d1, #1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vshr.s8 q0, d1, #1", several)
	e = armMsgIs(e, v3, "vshr.s8 d0, d1, #1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vshr.s8 q0, q1, #1", several)
	e = armMsgIs(e, v3, "vsra.s8 q0, q1, #1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vshr.s8 q0, q1, #9", "invalid instruction")
	e = armMsgIs(e, "", "vshl.i8 d0, d1, #8", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vshl.i8 d0, d1, #-1", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vsli.64 d0, d1, #64", "operand must be an immediate in the range [0,63]")
	e = armMsgIs(e, "", "vqshl.s16 d0, d1, #x", "operand must be an immediate in the range [0,15]")
	e = armMsgIs(e, "", "vshreq.s8 d0, d1, #1",
			"instruction 'vshr' is not predicable, but condition code specified")
	return e
}
