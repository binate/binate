package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/neon"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each shift name is its operation; a right shift's (VSHR) eight types on four operand shapes
// and MVE's six, VSRA's none of MVE's, VSRI's four sizes and MVE's three; a name with none none.
func TestArm32NeonShiftEncodings() testing.TestResult {
	if arm32NeonShiftOp("vqshlu") != neon.SHIFT_VQSHLU || arm32NeonShiftOp("vadd") != 0 {
		return fail("a shift name's operation is wrong")
	}
	var names @[]*[]readonly char = @[]*[]readonly char{"vshr", "vsra", "vsri", "vshl", "vqshl",
			"vadd"}
	var counts @[]int = @[]int{38, 32, 19, 19, 38, 0}
	for i := 0; i < len(names); i++ {
		if arm32NeonShiftCands(names[i]).n != counts[i] {
			return fail(buf.Concat("wrong count of shift encodings: ", names[i]))
		}
	}
	return ""
}

// The shifts by an immediate as clang assembles them: right shifts by 1..e (VSRI's size types,
// .p8 or .i64 standing for one), left shifts by 0..e-1 (VSHL's .S / .U standing for .I), the
// two-operand form, high registers.
func TestParseArm32NeonShiftForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vshr.s8 d0, d1, #1", "F28F0011")
	e = armGateIs(e, "", "vshr.u8 d0, d1, #8", "F3880011")
	e = armGateIs(e, "", "vsra.s64 d0, d1, #64", "F2800191")
	e = armGateIs(e, "", "vrshr.s32 d0, #1", "F2BF0210")
	e = armGateIs(e, "", "vrsra.u16 q0, #1", "F39F0350")
	e = armGateIs(e, "", "vsri.p8 d0, d1, #1", "F38F0411")
	e = armGateIs(e, "", "vsri.i64 d0, d1, #64", "F3800491")
	e = armGateIs(e, "", "vshl.i8 d0, d1, #0", "F2880511")
	e = armGateIs(e, "", "vshl.s8 d0, d1, #7", "F28F0511")
	e = armGateIs(e, "", "vshl.u64 q0, #1", "F28105D0")
	e = armGateIs(e, "", "vsli.s16 d0, d1, #15", "F39F0511")
	e = armGateIs(e, "", "vqshl.u64 d0, d1, #63", "F3BF0791")
	e = armGateIs(e, "", "vqshlu.s32 d0, d1, #0", "F3A00611")
	e = armGateIs(e, "", "vshr.s8 q15, q14, #3", "F2CDE07C")
	e = armGateIs(e, "", "vqshl.u8 d31, d30, #5", "F3CDF73E")
	e = armGateIs(e, "", "vshl.s8 d0, d1, d2", "F2020401")
	return e
}

// What clang does not take of them, with its message: a right shift's amount past its range
// (alone, or with the next size's form a type off), a register for it, a type the shift has not,
// two operands of different lengths, no NEON (and MVE's forms of the Q ones near misses too); and
// here a left shift's amount past 0..e-1 or no constant, which clang wraps (vshl.i8 #63 is #7).
func TestParseArm32NeonShiftRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "vshr.s8 d0, d1, #0", "operand must be an immediate in the range [1,8]")
	e = armMsgIs(e, "", "vshr.s64 d0, d1, #65", "operand must be an immediate in the range [1,64]")
	e = armMsgIs(e, "", "vshr.s8 d0, d1, #9", several)
	e = armMsgIs(e, "", "vshr.s8 d0, d1, d2", "operand must be an immediate in the range [1,8]")
	e = armMsgIs(e, "", "vshr.i8 d0, d1, #1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vqshlu.u8 d0, d1, #1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vshr.s8 q0, d1, #1", several)
	e = armMsgIs(e, v3, "vshr.s8 d0, d1, #1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vshr.s8 q0, q1, #1", several)
	e = armMsgIs(e, v3, "vsra.s8 q0, q1, #1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vshr.s8 q0, q1, #9", "invalid instruction")
	e = armMsgIs(e, "", "vshl.i8 d0, d1, #8", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vshl.i8 d0, d1, #-1", "operand must be an immediate in the range [0,7]")
	e = armMsgIs(e, "", "vsli.64 d0, d1, #64", "operand must be an immediate in the range [0,63]")
	e = armMsgIs(e, "", "vqshl.s16 d0, d1, #x", "operand must be an immediate in the range [0,15]")
	e = armMsgIs(e, "", "vshreq.s8 d0, d1, #1",
			"instruction 'vshr' is not predicable, but condition code specified")
	return e
}

// The narrowing shifts' encodings, one per data type (VSHRN's three, VQSHRN's six, VQRSHRUN's
// three); VSHLL's six by 1..e-1 and three by e; VMOVL's six; each of them a shift by an immediate
// (VMOVL's with no amount among its operands).
func TestArm32NeonShiftResizedEncodings() testing.TestResult {
	var names @[]*[]readonly char = @[]*[]readonly char{"vshrn", "vqshrn", "vqrshrun", "vshll",
			"vmovl"}
	var counts @[]int = @[]int{3, 6, 3, 9, 6}
	for i := 0; i < len(names); i++ {
		var list @arm32MatchList = arm32NeonShiftCands(names[i])
		if list.n != counts[i] { return fail(buf.Concat("wrong count of shift encodings: ", names[i])) }
		for j := 0; j < list.n; j++ {
			if !arm32NeonShiftCand(names[i], list.c[j]) {
				return fail(buf.Concat("an encoding is not a shift's: ", names[i]))
			}
		}
	}
	if arm32NeonShiftOp("vmovl") != neon.SHIFT_VSHLL { return fail("VMOVL is not VSHLL") }
	return ""
}

// The narrowing and long shifts as clang assembles them: each narrowing name, by 1..e/2 (VSHRN's
// .S standing for .I), high registers; VSHLL by 1..e-1 and by e (.I, or .U standing for it); VMOVL.
func TestParseArm32NeonShiftResizedForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vshrn.i16 d0, q1, #1", "F28F0812")
	e = armGateIs(e, "", "vshrn.s16 d0, q1, #8", "F2880812")
	e = armGateIs(e, "", "vshrn.i64 d0, q1, #32", "F2A00812")
	e = armGateIs(e, "", "vrshrn.i32 d0, q1, #16", "F2900852")
	e = armGateIs(e, "", "vqshrn.s16 d0, q1, #8", "F2880912")
	e = armGateIs(e, "", "vqshrn.u64 d0, q1, #1", "F3BF0912")
	e = armGateIs(e, "", "vqshrun.s32 d0, q1, #9", "F3970812")
	e = armGateIs(e, "", "vqrshrn.u32 d0, q1, #15", "F3910952")
	e = armGateIs(e, "", "vqrshrun.s64 d0, q1, #32", "F3A00852")
	e = armGateIs(e, "", "vshrn.i16 d31, q15, #1", "F2CFF83E")
	e = armGateIs(e, "", "vshll.s8 q0, d1, #1", "F2890A11")
	e = armGateIs(e, "", "vshll.s8 q0, d1, #8", "F3B20301")
	e = armGateIs(e, "", "vshll.u8 q0, d1, #8", "F3B20301")
	e = armGateIs(e, "", "vshll.i16 q0, d1, #16", "F3B60301")
	e = armGateIs(e, "", "vshll.u32 q0, d1, #31", "F3BF0A11")
	e = armGateIs(e, "", "vshll.u16 q15, d31, #1", "F3D1EA3F")
	e = armGateIs(e, "", "vshll.i8 q15, d31, #8", "F3F2E32F")
	e = armGateIs(e, "", "vmovl.s8 q0, d1", "F2880A11")
	e = armGateIs(e, "", "vmovl.u32 q15, d31", "F3E0EA3F")
	return e
}

// What clang does not take of them, with its message: an amount past the range (VSHLL's two ranges
// both near misses, and the next size's type), a register for it, registers of other lengths, a
// type the name has not, an operand too few or too many, no NEON; and here a condition.
func TestParseArm32NeonShiftResizedRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var badType *[]readonly char = "invalid operand for instruction"
	e = armMsgIs(e, "", "vshll.s8 q0, d1, #0", several)
	e = armMsgIs(e, "", "vshll.i8 q0, d1, #0", "operand must be an immediate in the range [8,8]")
	e = armMsgIs(e, "", "vshll.i8 q0, d1, #1", several)
	e = armMsgIs(e, "", "vshll.i8 q0, d1, d2", "operand must be an immediate in the range [8,8]")
	e = armMsgIs(e, "", "vshll.s32 q0, d1, #33", several)
	e = armMsgIs(e, "", "vshll.s8 d0, d1, #1", "operand must be a register in range [q0, q15]")
	e = armMsgIs(e, "", "vshll.s64 q0, d1, #1", badType)
	e = armMsgIs(e, "", "vshll.s8 q0, d1", "too few operands for instruction")
	e = armMsgIs(e, "", "vshrn.i16 d0, q1, #0", "operand must be an immediate in the range [1,8]")
	e = armMsgIs(e, "", "vshrn.i16 d0, q1, #9", several)
	e = armMsgIs(e, "", "vshrn.i64 d0, q1, #33", "operand must be an immediate in the range [1,32]")
	e = armMsgIs(e, "", "vshrn.i16 q0, q1, #1", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vshrn.i8 d0, q1, #1", badType)
	e = armMsgIs(e, "", "vqshrun.u16 d0, q1, #1", badType)
	e = armMsgIs(e, "", "vmovl.i8 q0, d1", badType)
	e = armMsgIs(e, "", "vmovl.s8 q0, q1", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vmovl.s8 q0, d1, #1", "too many operands for instruction")
	e = armMsgIs(e, "", "vmovl.s8 q0, #1", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, ".fpu vfpv3", "vmovl.s8 q0, d1", "instruction requires: NEON")
	e = armMsgIs(e, "", "vmovleq.s8 q0, d1",
			"instruction 'vmovl' is not predicable, but condition code specified")
	return e
}
