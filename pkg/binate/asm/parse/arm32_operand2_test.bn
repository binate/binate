package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Text-assembler tests for the ARM32 data-processing second operand
// (Operand2).  An immediate is an 8-bit value rotated right by an EVEN
// amount, so a value that needs an odd rotation has no encoding and the
// line must be rejected.  A shifted register spells its shift in the text;
// the shift fields must encode what clang encodes: `ror #0` is the plain
// register (the ROR-by-0 field pattern means RRX), `rrx` is that pattern,
// and `lsr #32` is the LSR-by-0 field pattern.  Expected words are clang's
// (`clang -target armv7a-none-eabi -c`, disassembled with objdump).
// Helper newArm32Parser is in arm32_test.bn.

func TestParseArm32AndImmUnrotated() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	return lineEmitsWord(p, "and r0, r1, #0xff", 0xE20100FF)
}

// 0x204 is 0x81 rotated right by 30 (an even rotation).
func TestParseArm32AndImmEvenRotation() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	return lineEmitsWord(p, "and r0, r1, #0x204", 0xE2010F81)
}

// 0x102 is 0x81 rotated right by 31: every 8-bit window holding its set
// bits needs an odd rotation, so no Operand2 immediate spells it.
func TestParseArm32AndImmOddRotationRejected() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	return lineRejected(p, "and r0, r1, #0x102")
}

func TestParseArm32AddRegRrx() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	return lineEmitsWord(p, "add r0, r1, r2, rrx", 0xE0810062)
}

// A rotate by zero is no shift: the plain register, not RRX.
func TestParseArm32AddRegRorZero() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	return lineEmitsWord(p, "add r0, r1, r2, ror #0", 0xE0810002)
}

// LSR #32 is encoded with a zero shift-amount field.
func TestParseArm32AddRegLsr32() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	return lineEmitsWord(p, "add r0, r1, r2, lsr #32", 0xE0810022)
}
