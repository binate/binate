package "pkg/binate/asm/parse"

// clang's `(PLT)` suffix on an arm32 PC-relative target's symbol (`bl ext(PLT)`, `adr r0,
// lbl(PLT)`, `ldr r0, lbl(PLT)+4`): the symbol is the same, and the reference stays a
// relocation whatever the symbol is -- clang never resolves a reference with a suffix in place,
// not even to a local label in its own section.  The suffix follows the symbol's name directly
// (an addend may follow it, not come between), in any case and spacing; a numeric local label
// reference and a number constant's name take none.

// arm32PltSuffix consumes a `(PLT)` suffix at cur, the token after a symbol's name, reporting
// whether there was one; otherwise l and cur are returned as they were.
func arm32PltSuffix(l Lexer, cur Token) (Lexer, Token, bool) {
	if cur.Kind != TOK_LPAREN { return l, cur, false }
	var nl Lexer = l
	var t Token
	nl, t = LexNext(nl)
	if t.Kind != TOK_IDENT || !mnemIs(t.Text, "plt") { return l, cur, false }
	nl, t = LexNext(nl)
	if t.Kind != TOK_RPAREN { return l, cur, false }
	nl, t = LexNext(nl)
	return nl, t, true
}

// arm32FixupCount returns the number of fixups in the current section (0 outside one).
func arm32FixupCount(p @Parser) int {
	if p.Asm.Current < 0 { return 0 }
	return p.Asm.Sections[p.Asm.Current].NumFixups
}

// arm32KeepPltFixup keeps as a relocation (asm.Fixup.Keep) the fixup an instruction just made for
// a target with a `(PLT)` suffix (Parser.Arm32Plt): the current section's fixup at index before,
// the number of fixups the section had before the instruction.  An instruction that failed made
// none to keep.
func arm32KeepPltFixup(p @Parser, before int) {
	if !p.Arm32Plt || p.HasError || p.Asm.HasError { return }
	if arm32FixupCount(p) != before + 1 {
		setErr(p, "internal error: a (PLT) target made no single fixup")
		return
	}
	p.Asm.KeepFixup(p.Asm.Current, before)
}
