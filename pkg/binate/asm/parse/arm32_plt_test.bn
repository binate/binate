package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// arm32PltSuffix consumes `(PLT)` in any case and spacing, returning the token after it, and
// leaves anything else -- another name, a missing `)`, no `(` -- as it was.
func TestArm32PltSuffix() testing.TestResult {
	var srcs @[]*[]readonly char = make_slice(*[]readonly char, 6)
	srcs[0] = "(PLT)+4"
	srcs[1] = "( plt )"
	srcs[2] = "(GOT)"
	srcs[3] = "(PLT"
	srcs[4] = "+4"
	srcs[5] = "(PLT)(PLT)"
	var want @[]bool = make_slice(bool, 6)
	want[0] = true
	want[1] = true
	want[5] = true
	for i := 0; i < len(srcs); i++ {
		var l Lexer = NewLexer(srcs[i], 1)
		var tok Token
		l, tok = LexNext(l)
		var first int = tok.Kind
		var got bool
		_, tok, got = arm32PltSuffix(l, tok)
		if got != want[i] { return fail(buf.Concat(srcs[i], ": wrong suffix")) }
		if !got && tok.Kind != first { return fail(buf.Concat(srcs[i], ": consumed")) }
	}
	var l2 Lexer = NewLexer("(PLT)+4", 1)
	var t2 Token
	l2, t2 = LexNext(l2)
	_, t2, _ = arm32PltSuffix(l2, t2)
	if t2.Kind != TOK_PLUS { return fail("(PLT)+4: the token after the suffix is not +") }
	return ""
}

// A PC-relative target's symbol takes `(PLT)` -- a branch's, an ADR's, a literal load's or
// store's, a preload's -- with an addend after it or before the symbol, written with `#` or in
// parentheses: the reference stays a relocation even to a local label in its own section, as
// clang keeps it.
func TestParseArm32PltTargets() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, "b lbl(PLT)\nlbl: nop", "EAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "b lbl(PLT)+4\nlbl: nop", "EAFFFFFF E320F000 ", 1)
	e = arm32PoolCase(e, "b 4+lbl(PLT)\nlbl: nop", "EAFFFFFF E320F000 ", 1)
	e = arm32PoolCase(e, "b lbl(plt)\nlbl: nop", "EAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "b lbl ( PLT )\nlbl: nop", "EAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "b #lbl(PLT)\nlbl: nop", "EAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "b (lbl(PLT))\nlbl: nop", "EAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "bl lbl(PLT)\nlbl: nop", "EBFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "blx lbl(PLT)\nlbl: nop", "FAFFFFFE E320F000 ", 1)
	e = arm32PoolCase(e, "adr r0, lbl(PLT)\nlbl: nop", "E24F0008 E320F000 ", 1)
	e = arm32PoolCase(e, "adr r0, lbl(PLT)+4\nlbl: nop", "E24F0004 E320F000 ", 1)
	e = arm32PoolCase(e, "ldr r0, lbl(PLT)\nlbl: nop", "E51F0008 E320F000 ", 1)
	e = arm32PoolCase(e, "ldrb r0, lbl(PLT)\nlbl: nop", "E55F0008 E320F000 ", 1)
	e = arm32PoolCase(e, "ldrh r0, lbl(PLT)\nlbl: nop", "E15F00B8 E320F000 ", 1)
	e = arm32PoolCase(e, "ldrd r0, r1, lbl(PLT)\nlbl: nop", "E14F00D8 E320F000 ", 1)
	e = arm32PoolCase(e, "pld lbl(PLT)\nlbl: nop", "F55FF008 E320F000 ", 1)
	e = arm32PoolCase(e, "str r0, lbl(PLT)\nlbl: nop", "E50F0008 E320F000 ", 1)
	// The suffix keeps its own reference, not the next one to the label.
	e = arm32PoolCase(e, "b lbl(PLT)\nb lbl\nlbl: nop", "EAFFFFFE EAFFFFFF E320F000 ", 1)
	return e
}

// The suffix follows a symbol's name in a PC-relative target and nowhere else: not a number,
// `.` or a parenthesized symbol, not after an addend or twice, not another relocation
// specifier, not in a symbol combined with anything but a number added or subtracted, not after
// a numeric local label reference, and not in a literal-pool load, a data directive or
// `:lower16:` (clang: "invalid fixup").
func TestParseArm32PltRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 12)
	bad[0] = "b 4(PLT)"
	bad[1] = "b .(PLT)"
	bad[2] = "b (ext)(PLT)"
	bad[3] = "bl ext+4(PLT)"
	bad[4] = "b ext(PLT)(PLT)"
	bad[5] = "b ext(GOT)"
	bad[6] = "b ext(PLT)*2"
	bad[7] = "b ext(PLT)-ext2"
	bad[8] = "b 4-ext(PLT)"
	bad[9] = "ldr r0, =ext(PLT)"
	bad[10] = ".uint32 ext(PLT)"
	bad[11] = "movw r0, #:lower16:ext(PLT)"
	var r testing.TestResult = arm32CheckRejects(bad)
	if len(r) != 0 { return r }
	var src @[]*[]readonly char = make_slice(*[]readonly char, 3)
	src[0] = "bl 1f(PLT)\n1: nop"
	src[1] = "1: nop\nbl 1b(PLT)"
	src[2] = "1: nop\nadr r0, 1b(PLT)"
	for i := 0; i < len(src); i++ {
		var p @Parser = arm32Source(src[i])
		if !p.HasError && !p.Asm.HasError { return fail(buf.Concat(src[i], ": accepted")) }
	}
	return ""
}
