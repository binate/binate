package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// Literal pools on arm32: `ldr{cond} Rt, =expr`, as clang assembles it for A32.  A number
// is the first of MOV (its 32-bit pattern a rotated 8-bit immediate), MVN (its complement
// one) and MOVW (at most 0xFFFF) that encodes it — except into SP or PC, which always load
// it; any other value is a 4-byte entry in the section's pool (aarch64_pool.bn), which an
// LDR (literal) loads — a number's 32-bit pattern, or a symbol plus a number as an
// absolute word (R_ARM_ABS32).  A number, or a symbol's addend, is read as written and
// must lie in [-2^31, 2^32), where clang keeps the low 32 bits of an addend, and of a
// number whose low 32 bits make a MOV / MVN (rejecting the rest).

// parseArm32PoolLoad parses the `=expr` operand of `ldr{cond} rd, =expr` (tok the '=', l
// just after it) and emits the move or the literal load.
func parseArm32PoolLoad(p @Parser, l Lexer, tok Token, cond int, rd int) {
	l, tok = LexNext(l)
	var key @[]char = poolNameKey(l, tok)
	var constKey @[]char = poolConstKey(p, key)
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid literal-pool value"))
		return
	}
	if !arm32AtEOL(p, tok) { return }
	if r.Dot {
		r.Sym = dotLabel(p)
		if p.Asm.HasError { return }
	}
	if len(r.Sym) == 0 {
		if r.Val < -2147483648 || r.Val > 4294967295 {
			setErr(p, "the literal-pool value does not fit a register")
			return
		}
		// A label difference's value is always an entry, as clang's is (its value — pending
		// on a first pass — then decides no size).
		if rd != arm32.SP && rd != arm32.PC && !r.FromDiff {
			// The value's 32-bit pattern, as the signed int the encoders take on any host.
			var v int = cast(int, cast(int32, r.Val & 0xFFFFFFFF))
			if arm32.EncodeRotImm(v).Ok {
				arm32.Mov(p.Asm, cond, false, rd, arm32.Imm(v))
				return
			}
			var nv int = cast(int, cast(int32, (r.Val ^ -1) & 0xFFFFFFFF))
			if arm32.EncodeRotImm(nv).Ok {
				arm32.Mvn(p.Asm, cond, false, rd, arm32.Imm(nv))
				return
			}
			if (r.Val & 0xFFFFFFFF) <= 0xFFFF {
				arm32.Movw(p.Asm, cond, rd, cast(int, r.Val & 0xFFFF))
				return
			}
		}
		key = buf.CopyStr(poolKeyNumber)
		if r.FromDiff { key = constKey }
	} else {
		if r.Val < -2147483648 || r.Val > 4294967295 {
			setErr(p, "literal-pool addend out of range")
			return
		}
		if len(constKey) > 0 {
			key = constKey
		} else if len(key) > 0 && isDigit(key[0]) {
			key = buf.CopyStr(r.Sym) // a numeric label's instance
		}
	}
	var label @[]char = poolEntry(p, false, r.Sym, r.Val, key)
	arm32.Ldr(p.Asm, cond, rd, arm32.Label(label))
}
