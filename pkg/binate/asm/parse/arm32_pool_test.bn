package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// arm32 literal pools (`ldr{cond} Rt, =expr`) against clang's words (`clang -c -target
// armv7a-none-eabi`): MOV / MVN / MOVW for a number they encode, else a 4-byte entry,
// shared only while pending (clang starts afresh after `.ltorg`); a symbol entry holds its
// addend in the word, as clang's REL objects do.  (newArm32Parser / readWord are in
// arm32_test.bn, sectionWordsHex in aarch64_pool_test.bn, plContains in
// parse_line_test.bn, goldenFail in aarch64_golden_test.bn.)

// arm32Source assembles the multi-line src for arm32 ELF as the driver does.
func arm32Source(src *[]readonly char) @Parser { return arm32SourceIn(src, asm.OBJ_ELF) }

// arm32SourceIn is arm32Source with the object format format while parsing.
func arm32SourceIn(src *[]readonly char, format int) @Parser {
	p, a := newArm32Parser()
	a.ObjFormat = format
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
	p.Finish()
	a.ObjFormat = asm.OBJ_ELF
	if !p.HasError && !a.HasError && a.CheckTemporaryLabels() {
		arm32.ResolveFixups(a)
		if !a.HasError { a.Finalize() }
	}
	return p
}

// arm32PoolCase checks that src assembles to exactly the words want with nRelocs
// relocations.
func arm32PoolCase(e @[]char, src *[]readonly char, want *[]readonly char, nRelocs int) @[]char {
	var p @Parser = arm32Source(src)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var got @[]char = sectionWordsHex(p, 0)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	if p.Asm.NumRelocs != nRelocs { return goldenFail(e, src, "wrong number of relocations") }
	return e
}

// arm32PoolSrc is clang's choice of move or entry, sharing and symbol entries.
var arm32PoolSrc *[]readonly char =
	".global ext\nf:\nldr r0, =0xff\nldr r0, =0x100\nldr r0, =0xff000000\n"
			"ldr r0, =0xffffff00\nldr r0, =-1\nldr r0, =0x1234\nldr r0, =0xffff\nldr r0, =0x10000\n"
			"ldr r0, =0x12345678\nldr r1, =0x12345678\nldr r2, =f\nldr r3, =f+4\nldr r4, =ext\n"
			"ldr r5, =ext\nldr r6, =0\nldr r7, =-256\nldrne r8, =0x12345678\nldr pc, =ext\nbx lr"

// MOV, then MVN, then MOVW, when one encodes the number; else an entry, shared by value or
// plain name (`f+4` its own), a symbol's an absolute word.
func TestArm32PoolForms() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, arm32PoolSrc,
			"E3A000FF E3A00C01 E3A004FF E3E000FF E3E00000 E3010234 E30F0FFF E3A00801 E59F0024 "
					"E59F1020 E59F2020 E59F3020 E59F4020 E59F501C E3A06000 E3E070FF 159F8004 E59FF00C "
					"E12FFF1E 12345678 00000000 00000004 00000000 ",
			3)
	var p @Parser = arm32Source(arm32PoolSrc)
	if !p.HasError && p.Asm.NumRelocs == 3 {
		var r asm.Relocation = p.Asm.Relocs[1]
		if r.Offset != 0x54 || r.Kind != 0 || !charsEqual(p.Asm.Symbols[r.Symbol].Name, "f") ||
				r.Addend != 4 {
			e = goldenFail(e, "ldr r3, =f+4", "not an absolute word f + 4")
		}
	}
	return e
}

// `.ltorg` emits the pending entries; a later load gets a new entry (no sharing with an
// emitted one, a number's or a symbol's); `1b` and `.` (the load's own address) are symbol
// entries (`.`'s word holds 4 once the ELF writer moves its relocation to the section
// symbol, as clang's does; here, before that, 0).  Numbers with one 32-bit pattern but
// different values get an entry each, as clang's do.
func TestArm32PoolLtorg() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e,
			"1: ldr r0, =1b\nldr r1, =.\nldr r2, =0x11111111\n.ltorg\nldr r3, =0x11111111\nbx lr",
			"E59F0004 E59F1004 E59F2004 00000000 00000000 11111111 E59F3000 E12FFF1E 11111111 ", 2)
	e = arm32PoolCase(e, "f: ldr r0, =f\n.ltorg\nldr r1, =f\nbx lr",
			"E51F0004 00000000 E59F1000 E12FFF1E 00000000 ", 2)
	e = arm32PoolCase(e, "ldr r0, =0x92345678\nldr r1, =-0x6dcba988\nbx lr",
			"E59F0004 E59F1004 E12FFF1E 92345678 92345678 ", 0)
	return e
}

// SP and PC always load a number from the pool, never a MOV / MVN / MOVW (MOVW into PC is
// UNPREDICTABLE), as clang assembles them.
func TestArm32PoolSpPc() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, "ldr sp, =0xff\nldr pc, =0x1234\nldr sp, =-1\nldr r0, =0xff",
			"E59FD008 E59FF008 E59FD008 E3A000FF 000000FF 00001234 FFFFFFFF ", 0)
	return e
}

// arm32 has no Mach-O output, so with the object format unknown a load still shares an
// entry across a label (no atom to keep it in).
func TestArm32PoolNoAtoms() testing.TestResult {
	var p @Parser = arm32SourceIn("ldr r0, =0x12345678\ng: ldr r1, =0x12345678", asm.OBJ_UNKNOWN)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	var got @[]char = sectionWordsHex(p, 0)
	if !charsEqual(got, "E59F0000 E51F1004 12345678 ") {
		return fail(buf.Concat("assembled to ", got))
	}
	return ""
}

// A condition carries to the move or the load; the number range's ends and SP.
func TestArm32PoolConditions() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e,
			"ldrne r0, =0xff\nldrne r1, =0x1234\nldrne r2, =0xffffff00\nldr r3, =-0x80000000\n"
					"ldr r4, =0x7fffffff\nldr sp, =0x12345678\nbx lr",
			"13A000FF 13011234 13E020FF E3A03102 E3E04102 E59FD000 E12FFF1E 12345678 ", 0)
	return e
}

// arm32PoolReject checks that src is rejected (by the parser or the assembler) with a
// diagnostic containing want.
func arm32PoolReject(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = arm32Source(src)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = p.Asm.ErrorMsg }
	if !p.HasError && !p.Asm.HasError { return goldenFail(e, src, "accepted") }
	if !plContains(msg, want) { return goldenFail(e, src, buf.Concat("wrong diagnostic: ", msg)) }
	return e
}

// Rejected: a number or a symbol's addend outside [-2^31, 2^32) (deliberately — clang keeps
// the low 32 bits of an addend, and of a number whose low 32 bits make a MOV / MVN), the
// byte / halfword loads and a store (as clang), a shift, an empty value, an undeclared
// symbol (this assembler's rule); and an entry out of the load's reach (4092 bytes past the
// PC at most, an entry being word-aligned) names it.
func TestArm32PoolRejects() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolReject(e, "ldr r0, =0x100000000", "does not fit a register")
	e = arm32PoolReject(e, "ldr r0, =-0x80000001", "does not fit a register")
	e = arm32PoolReject(e, "ldrb r0, =1", "")
	e = arm32PoolReject(e, "ldrh r0, =1", "")
	e = arm32PoolReject(e, "ldr r0, =1, lsl 2", "")
	e = arm32PoolReject(e, "ldr r0, =", "")
	e = arm32PoolReject(e, "str r0, =1", "")
	e = arm32PoolReject(e, "ldr r0, =ext", "undefined symbol 'ext'")
	e = arm32PoolReject(e, "f: ldr r0, =f+0x100000000", "addend out of range")
	e = arm32PoolReject(e, "ldr r0, =0x12345678\n.zero 4100", "'literal pool entry 0' is out of range")
	// The farthest entry a load reaches: PC (the load + 8) + 4092.
	var far @Parser = arm32Source("ldr r0, =0x12345678\n.zero 4096")
	if far.HasError || far.Asm.HasError || readWord(far.Asm.Sections[0], 0) != 0xE59F0FFC {
		e = goldenFail(e, ".zero 4096", "the entry at PC + 4092 not reached")
	}
	return e
}
