package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/sys"

// MRS and MSR, as clang takes them: of APSR / CPSR or SPSR -- MSR's with a field mask
// (arm32PsrMask) and a register or an immediate (`#imm` or `#imm8, rot`) -- or, with the
// virtualization extensions, of a banked register (arm32BankedReg), in any case.

// arm32BankedReg returns the number (SYSm: R:M:M1) of the banked register name, in any case, and
// whether name is one: R8..R12, SP and LR of User and FIQ mode; LR and SP of IRQ, SVC, ABT, UND
// and MON mode; ELR and SP of HYP mode; the SPSR of FIQ, IRQ, SVC, ABT, UND, MON and HYP mode.
func arm32BankedReg(name *[]readonly char) (int, bool) {
	var names @[]*[]readonly char = @[]*[]readonly char{"r8_usr", "r9_usr", "r10_usr", "r11_usr",
			"r12_usr", "sp_usr", "lr_usr", "r8_fiq", "r9_fiq", "r10_fiq", "r11_fiq", "r12_fiq", "sp_fiq",
			"lr_fiq", "lr_irq", "sp_irq", "lr_svc", "sp_svc", "lr_abt", "sp_abt", "lr_und", "sp_und",
			"lr_mon", "sp_mon", "elr_hyp", "sp_hyp", "spsr_fiq", "spsr_irq", "spsr_svc", "spsr_abt",
			"spsr_und", "spsr_mon", "spsr_hyp"}
	var nums @[]int = @[]int{0, 1, 2, 3, 4, 5, 6, 8, 9, 10, 11, 12, 13, 14, 16, 17, 18, 19, 20, 21, 22,
			23, 28, 29, 30, 31, 46, 48, 50, 52, 54, 60, 62}
	for i := 0; i < len(names); i++ {
		if mnemIs(name, names[i]) { return nums[i], true }
	}
	return 0, false
}

// arm32PsrMask returns the status register an MSR names (spsr for SPSR) and its field mask, and
// whether name is one: APSR with _nzcvq, _g or _nzcvqg (none is nzcvq); CPSR or SPSR with a set
// of c, x, s and f, each once and in any order (none, or _all, is fc) -- the register's name in
// any case, its fields in lower case, as clang reads them.
func arm32PsrMask(name *[]readonly char) (bool, int, bool) {
	var cut int = 0
	for cut < len(name) && name[cut] != '_' { cut = cut + 1 }
	var reg *[]readonly char = name[0:cut]
	var fields *[]readonly char = ""
	if cut < len(name) { fields = name[cut + 1:len(name)] }
	if mnemIs(reg, "apsr") {
		if len(fields) == 0 || charsEqual(fields, "nzcvq") { return false, sys.PSR_F, true }
		if charsEqual(fields, "g") { return false, sys.PSR_S, true }
		if charsEqual(fields, "nzcvqg") { return false, sys.PSR_F | sys.PSR_S, true }
		return false, 0, false
	}
	if !mnemIs(reg, "cpsr") && !mnemIs(reg, "spsr") { return false, 0, false }
	var spsr bool = mnemIs(reg, "spsr")
	if len(fields) == 0 || charsEqual(fields, "all") { return spsr, sys.PSR_F | sys.PSR_C, true }
	var mask int = 0
	for i := 0; i < len(fields); i++ {
		var bit int = 0
		if fields[i] == 'c' { bit = sys.PSR_C }
		if fields[i] == 'x' { bit = sys.PSR_X }
		if fields[i] == 's' { bit = sys.PSR_S }
		if fields[i] == 'f' { bit = sys.PSR_F }
		if bit == 0 || mask & bit != 0 { return false, 0, false }
		mask = mask | bit
	}
	return spsr, mask, true
}

// parseArm32Psr assembles MRS (MSR when msr) from the operands after the mnemonic (l the lexer
// past it).
func parseArm32Psr(p @Parser, l Lexer, msr bool, cond int) {
	var first Token
	l, first = LexNext(l)
	var comma Token
	l, comma = LexNext(l)
	if first.Kind == TOK_EOF || comma.Kind == TOK_EOF {
		setErr(p, "too few operands for instruction")
		return
	}
	if comma.Kind != TOK_COMMA {
		setErr(p, "unexpected token in operand")
		return
	}
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind == TOK_EOF {
		setErr(p, "too few operands for instruction")
		return
	}
	if msr {
		parseArm32MsrOperand(p, l, first, tok, cond)
		return
	}
	// MRS Rd, <status or banked register>.
	var rd int = -1
	if first.Kind == TOK_IDENT { rd = parseArm32Reg(first.Text) }
	if rd < 0 || rd == arm32.PC {
		setErr(p, "operand must be a register in range [r0, r14]")
		return
	}
	var sysm int = -1
	var named bool = tok.Kind == TOK_IDENT
	var spsr bool = named && mnemIs(tok.Text, "spsr")
	if !spsr && !(named && (mnemIs(tok.Text, "apsr") || mnemIs(tok.Text, "cpsr"))) {
		var banked bool = false
		if named { sysm, banked = arm32BankedReg(tok.Text) }
		if !banked || p.Arm32Feats & armVirt == 0 {
			setErr(p, "invalid operand for instruction")
			return
		}
	}
	l, tok = LexNext(l)
	if !arm32EndOfOperands(p, tok) { return }
	if sysm >= 0 {
		sys.MrsBanked(p.Asm, cond, rd, sysm)
	} else {
		sys.Mrs(p.Asm, cond, rd, spsr)
	}
}

// arm32EndOfOperands reports whether tok ends the line, setting clang's error for another
// operand or other text when it does not.
func arm32EndOfOperands(p @Parser, tok Token) bool {
	if tok.Kind == TOK_COMMA {
		setErr(p, "too many operands for instruction")
		return false
	}
	return arm32AtEOL(p, tok)
}

// parseArm32MsrOperand assembles MSR <first>, <operand starting at tok> (l the lexer past tok):
// first a banked register (a register operand only) or a status register with its fields.
func parseArm32MsrOperand(p @Parser, l Lexer, first Token, tok Token, cond int) {
	var sysm int = -1
	var spsr bool = false
	var mask int = 0
	var ok bool = false
	if first.Kind == TOK_IDENT && p.Arm32Feats & armVirt != 0 { sysm, ok = arm32BankedReg(first.Text) }
	if !ok {
		sysm = -1
		if first.Kind == TOK_IDENT { spsr, mask, ok = arm32PsrMask(first.Text) }
	}
	if !ok {
		setErr(p, "invalid operand for instruction")
		return
	}
	var rn int = -1
	if tok.Kind == TOK_IDENT { rn = parseArm32Reg(tok.Text) }
	if rn >= 0 {
		l, tok = LexNext(l)
		if !arm32EndOfOperands(p, tok) { return }
		if sysm >= 0 {
			if rn == arm32.PC {
				setErr(p, "operand must be a register in range [r0, r14]")
				return
			}
			sys.MsrBanked(p.Asm, cond, sysm, rn)
		} else {
			sys.Msr(p.Asm, cond, spsr, mask, rn)
		}
		return
	}
	if sysm >= 0 {
		setErr(p, "invalid operand for instruction")
		return
	}
	imm8, rot, fits := parseArm32MsrImm(p, l, tok)
	if fits { sys.MsrImm(p.Asm, cond, spsr, mask, imm8, rot) }
}

// parseArm32MsrImm parses MSR's immediate starting at tok (l the lexer past it) through the end of
// the line -- after `#`, `$` or neither, a value with a rotated 8-bit encoding (a 32-bit pattern,
// signed or not; anything wider is an error), or an 8-bit value and an even rotation, 0..30, the
// rotation too after `#`, `$` or neither -- returning its imm8 and rotation field, or ok false
// with p's error set.
func parseArm32MsrImm(p @Parser, l Lexer, tok Token) (int, int, bool) {
	var prefixed bool
	l, prefixed = arm32ImmPrefix(l, tok, true)
	if prefixed { l, tok = LexNext(l) }
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok || r.FromDiff {
		setErr(p, exprErr(r, "constant expression expected"))
		return 0, 0, false
	}
	if tok.Kind == TOK_COMMA {
		var rotTok Token
		l, rotTok = LexNext(l)
		var rotPrefixed bool
		l, rotPrefixed = arm32ImmPrefix(l, rotTok, true)
		if rotPrefixed { l, rotTok = LexNext(l) }
		var rr ExprResult
		l, tok, rr = ParseExpr(p, l, rotTok)
		if !rr.Ok || rr.FromDiff {
			setErr(p, exprErr(rr, "constant expression expected"))
			return 0, 0, false
		}
		if !arm32EndOfOperands(p, tok) { return 0, 0, false }
		if r.Val < 0 || r.Val > 255 {
			setErr(p, "immediate operand must a number in the range [0, 255]")
			return 0, 0, false
		}
		if rr.Val < 0 || rr.Val > 30 || rr.Val % 2 != 0 {
			setErr(p, "immediate operand must an even number in the range [0, 30]")
			return 0, 0, false
		}
		return cast(int, r.Val), cast(int, rr.Val / 2), true
	}
	if !arm32AtEOL(p, tok) { return 0, 0, false }
	var v int64 = r.Val
	if v < -0x80000000 || v > 0xFFFFFFFF {
		setErr(p, "immediate out of range")
		return 0, 0, false
	}
	var ri arm32.RotImmResult = arm32.EncodeRotImm(cast(int, cast(int32, v & 0xFFFFFFFF)))
	if !ri.Ok {
		setErr(p, "invalid operand for instruction")
		return 0, 0, false
	}
	return ri.Imm8, ri.Rot4, true
}
