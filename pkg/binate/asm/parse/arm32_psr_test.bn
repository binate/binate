package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// MRS and MSR of APSR / CPSR / SPSR, each word as clang assembles it: the register's name in any
// case, MSR's fields (c, x, s, f; APSR's nzcvq, g) in lower case and any order, none or `all`
// being fc (APSR's nzcvq); a register operand, PC and SP included for MSR.
func TestParseArm32MrsMsr() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 31)
	g[0] = arm32MemGolden{line: "mrs r0, apsr", word: 0xE10F0000}
	g[1] = arm32MemGolden{line: "mrs r0, cpsr", word: 0xE10F0000}
	g[2] = arm32MemGolden{line: "mrs r0, spsr", word: 0xE14F0000}
	g[3] = arm32MemGolden{line: "mrseq r1, cpsr", word: 0x010F1000}
	g[4] = arm32MemGolden{line: "mrs sp, apsr", word: 0xE10FD000}
	g[5] = arm32MemGolden{line: "MRS R0, CPSR", word: 0xE10F0000}
	g[6] = arm32MemGolden{line: "msr apsr_nzcvq, r0", word: 0xE128F000}
	g[7] = arm32MemGolden{line: "msr apsr_g, r0", word: 0xE124F000}
	g[8] = arm32MemGolden{line: "msr apsr_nzcvqg, r1", word: 0xE12CF001}
	g[9] = arm32MemGolden{line: "msr apsr, r0", word: 0xE128F000}
	g[10] = arm32MemGolden{line: "msr APSR_g, r0", word: 0xE124F000}
	g[11] = arm32MemGolden{line: "msr cpsr_fc, r0", word: 0xE129F000}
	g[12] = arm32MemGolden{line: "msr cpsr_fsxc, r0", word: 0xE12FF000}
	g[13] = arm32MemGolden{line: "msr cpsr_c, r0", word: 0xE121F000}
	g[14] = arm32MemGolden{line: "msr cpsr_f, r0", word: 0xE128F000}
	g[15] = arm32MemGolden{line: "msr cpsr_s, r0", word: 0xE124F000}
	g[16] = arm32MemGolden{line: "msr cpsr_x, r0", word: 0xE122F000}
	g[17] = arm32MemGolden{line: "msr spsr_fc, r0", word: 0xE169F000}
	g[18] = arm32MemGolden{line: "msr spsr_c, r0", word: 0xE161F000}
	g[19] = arm32MemGolden{line: "msr spsr_fsxc, r2", word: 0xE16FF002}
	g[20] = arm32MemGolden{line: "msr cpsr, r0", word: 0xE129F000}
	g[21] = arm32MemGolden{line: "msr spsr, r0", word: 0xE169F000}
	g[22] = arm32MemGolden{line: "msr cpsr_cf, r0", word: 0xE129F000}
	g[23] = arm32MemGolden{line: "msr cpsr_all, r0", word: 0xE129F000}
	g[24] = arm32MemGolden{line: "msr spsr_all, r0", word: 0xE169F000}
	g[25] = arm32MemGolden{line: "msr cpsr_, r0", word: 0xE129F000}
	g[26] = arm32MemGolden{line: "msr cpsr_fs, r0", word: 0xE12CF000}
	g[27] = arm32MemGolden{line: "msr cpsr_sf, r0", word: 0xE12CF000}
	g[28] = arm32MemGolden{line: "msreq cpsr_fc, r0", word: 0x0129F000}
	g[29] = arm32MemGolden{line: "msr cpsr_fc, pc", word: 0xE129F00F}
	g[30] = arm32MemGolden{line: "msr cpsr_fc, sp", word: 0xE129F00D}
	return arm32CheckGoldens(g)
}

// MSR of an immediate, `#`, `$` or neither, each word as clang assembles it: a value with a
// rotated 8-bit encoding, or an 8-bit value and an even rotation (`#`, `$` or neither too).
func TestParseArm32MsrImm() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 14)
	g[0] = arm32MemGolden{line: "msr apsr_nzcvq, #0xf0000000", word: 0xE328F20F}
	g[1] = arm32MemGolden{line: "msr cpsr_f, #0xf0000000", word: 0xE328F20F}
	g[2] = arm32MemGolden{line: "msr cpsr_fc, #0x10", word: 0xE329F010}
	g[3] = arm32MemGolden{line: "msr spsr_c, #0x13", word: 0xE361F013}
	g[4] = arm32MemGolden{line: "msr apsr_g, #0", word: 0xE324F000}
	g[5] = arm32MemGolden{line: "msr cpsr_fc, #1, 2", word: 0xE329F101}
	g[6] = arm32MemGolden{line: "msr apsr_nzcvq, #0x10000000", word: 0xE328F201}
	g[7] = arm32MemGolden{line: "msr cpsr_fc, 0x10", word: 0xE329F010}
	g[8] = arm32MemGolden{line: "msr cpsr_fc, $0x10", word: 0xE329F010}
	g[9] = arm32MemGolden{line: "msr cpsr_fc, #0xff000000", word: 0xE329F4FF}
	g[10] = arm32MemGolden{line: "msr cpsr_fc, #0x3fc", word: 0xE329FFFF}
	g[11] = arm32MemGolden{line: "msr cpsr_fc, #255, 30", word: 0xE329FFFF}
	g[12] = arm32MemGolden{line: "msr cpsr_fc, #1, $2", word: 0xE329F101}
	g[13] = arm32MemGolden{line: "msr cpsr_fc, #1, #2", word: 0xE329F101}
	return arm32CheckGoldens(g)
}

// MRS and MSR of a banked register (armv7ve has the virtualization extensions), its name in any
// case, each word as clang assembles it.
func TestParseArm32Banked() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 28)
	g[0] = arm32MemGolden{line: "mrs r0, r8_usr", word: 0xE1000200}
	g[1] = arm32MemGolden{line: "mrs r0, sp_usr", word: 0xE1050200}
	g[2] = arm32MemGolden{line: "mrs r0, lr_usr", word: 0xE1060200}
	g[3] = arm32MemGolden{line: "mrs r0, r12_fiq", word: 0xE10C0200}
	g[4] = arm32MemGolden{line: "mrs r0, sp_fiq", word: 0xE10D0200}
	g[5] = arm32MemGolden{line: "mrs r0, lr_irq", word: 0xE1000300}
	g[6] = arm32MemGolden{line: "mrs r0, sp_svc", word: 0xE1030300}
	g[7] = arm32MemGolden{line: "mrs r0, spsr_svc", word: 0xE1420300}
	g[8] = arm32MemGolden{line: "mrs r0, spsr_hyp", word: 0xE14E0300}
	g[9] = arm32MemGolden{line: "mrs r0, elr_hyp", word: 0xE10E0300}
	g[10] = arm32MemGolden{line: "mrs r0, sp_hyp", word: 0xE10F0300}
	g[11] = arm32MemGolden{line: "mrs r0, spsr_mon", word: 0xE14C0300}
	g[12] = arm32MemGolden{line: "mrs r0, lr_mon", word: 0xE10C0300}
	g[13] = arm32MemGolden{line: "mrs r0, sp_mon", word: 0xE10D0300}
	g[14] = arm32MemGolden{line: "mrs r0, spsr_fiq", word: 0xE14E0200}
	g[15] = arm32MemGolden{line: "mrs r0, SP_USR", word: 0xE1050200}
	g[16] = arm32MemGolden{line: "mrs sp, r8_usr", word: 0xE100D200}
	g[17] = arm32MemGolden{line: "mrseq r0, r8_usr", word: 0x01000200}
	g[18] = arm32MemGolden{line: "msr r8_usr, r0", word: 0xE120F200}
	g[19] = arm32MemGolden{line: "msr sp_usr, r1", word: 0xE125F201}
	g[20] = arm32MemGolden{line: "msr spsr_irq, r2", word: 0xE160F302}
	g[21] = arm32MemGolden{line: "msr elr_hyp, r3", word: 0xE12EF303}
	g[22] = arm32MemGolden{line: "msr sp_hyp, r4", word: 0xE12FF304}
	g[23] = arm32MemGolden{line: "msr lr_abt, r5", word: 0xE124F305}
	g[24] = arm32MemGolden{line: "msr spsr_und, r6", word: 0xE166F306}
	g[25] = arm32MemGolden{line: "msr r10_fiq, r7", word: 0xE12AF207}
	g[26] = arm32MemGolden{line: "msr r8_usr, sp", word: 0xE120F20D}
	g[27] = arm32MemGolden{line: "msrne sp_svc, r2", word: 0x1123F302}
	return arm32CheckGoldens(g)
}

// What clang rejects of them: MRS into PC, a field on MRS's register, another register, a
// repeated or upper-case field, a missing or extra operand, an immediate with no encoding, a value
// past 8 bits or an odd rotation, PC to or from a banked register, a banked register's immediate.
func TestParseArm32PsrRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 27)
	bad[0] = "mrs pc, cpsr"
	bad[1] = "mrs r0, cpsr_all"
	bad[2] = "mrs r0, cpsr_fc"
	bad[3] = "mrs r0, apsr_nzcv"
	bad[4] = "mrs r0"
	bad[5] = "mrs cpsr, r0"
	bad[6] = "mrs r0, cpsr, r1"
	bad[7] = "mrs r0, r13_usr"
	bad[8] = "mrs r0, lr_hyp"
	bad[9] = "msr cpsr_ff, r0"
	bad[10] = "msr CPSR_FC, r0"
	bad[11] = "msr apsr_NZCVQ, r0"
	bad[12] = "msr apsr_gnzcvq, r0"
	bad[13] = "msr apsr_c, r0"
	bad[14] = "msr spsr_nzcvq, r0"
	bad[15] = "msr cpsr_fsxcf, r0"
	bad[16] = "msr cpsr, r0, r1"
	bad[17] = "msr cpsr_fc"
	bad[18] = "msr r0, cpsr"
	bad[19] = "msr cpsr_f, #0x101"
	bad[20] = "msr cpsr_fc, #-1"
	bad[21] = "msr cpsr_fc, #0x102"
	bad[22] = "msr cpsr_fc, #256, 0"
	bad[23] = "msr cpsr_fc, #1, 3"
	bad[24] = "msr sp_usr, pc"
	bad[25] = "mrs pc, r8_usr"
	bad[26] = "msr r8_usr, #1"
	return arm32CheckRejects(bad)
}

// Without the virtualization extensions a banked register is no operand, as in clang.
func TestParseArm32BankedGate() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv7-a", "mrs r0, r8_usr", "!invalid operand for instruction")
	e = armGateIs(e, ".arch armv7-a", "msr r8_usr, r0", "!invalid operand for instruction")
	e = armGateIs(e, ".arch armv7-a", "mrs r0, cpsr", "E10F0000")
	e = armGateIs(e, ".arch armv4", "msr cpsr_fc, r0", "E129F000")
	return e
}
