package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// clang's NEON mnemonic aliases: vaddq, vsubq, vmulq, vabsq, vmovq, vmvnq, vcvtq, vandq, vbicq,
// veorq, vorrq, vminq, vmaxq, vshlq, vshrq, vcleq, vceqq, vzipq and vswpq are the instructions
// without the q -- every form of them, VFP's too -- when NEON is in effect, and no instruction
// otherwise.

// arm32QAlias returns mnem (an ARM mnemonic as written) with the q of one of clang's NEON
// aliases dropped, its condition and suffixes kept (vaddqeq.f32 is vaddeq.f32), or "" for a
// mnemonic that is none; or "" with clang's error set: "invalid instruction" without NEON (its
// `.n` error and the operands' errors, l the lexer after mnem, first), and its flag-setting error
// for an `s` after the name (vaddqs, vaddqeqs, vcleqs).  Clang splits the name as it splits every
// mnemonic: a condition off the end, then an `s`; but it takes vcleq as the alias it is when that
// is all the mnemonic is.
func arm32QAlias(p @Parser, l Lexer, mnem *[]readonly char) @[]char {
	if len(mnem) < 5 || arm32Lower(mnem[0]) != 'v' { return "" }
	if mnemIs(mnem, "vcleq") {
		if p.Arm32FP & armFpNEON == 0 {
			arm32VdpNone(p, l)
			return ""
		}
		return buf.CopyStr(mnem[0:4])
	}
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		if mnem[i] == '.' { dot = i }
	}
	var end int = dot
	if end > 2 && parseArm32CondCode(mnem[end - 2:end]) >= 0 { end = end - 2 }
	var carry bool = arm32Lower(mnem[end - 1]) == 's'
	if carry { end = end - 1 }
	var base int = end
	var cut bool = carry && !arm32QAliasName(mnem[0:end]) && base > 2
	if cut && parseArm32CondCode(mnem[base - 2:base]) >= 0 { base = base - 2 }
	if !arm32QAliasName(mnem[0:base]) { return "" }
	if carry {
		var name @[]char = make_slice(char, end)
		for i := 0; i < end; i++ { name[i] = arm32Lower(mnem[i]) }
		arm32VfpFlagsErr(p, name)
		return ""
	}
	if p.Arm32FP & armFpNEON == 0 {
		// clang reports a `.n` before it looks for the instruction.
		var narrow bool = false
		for i := dot; i + 1 < len(mnem); i++ {
			var ends bool = i + 2 == len(mnem) || mnem[i + 2] == '.'
			if mnem[i] == '.' && arm32Lower(mnem[i + 1]) == 'n' && ends { narrow = true }
		}
		if narrow {
			setErr(p, "instruction with .n (narrow) qualifier not allowed in arm mode")
		} else {
			arm32VdpNone(p, l)
		}
		return ""
	}
	var out @[]char = make_slice(char, len(mnem) - 1)
	for i := 0; i < len(out); i++ {
		var from int = i
		if i >= 4 { from = i + 1 }
		out[i] = mnem[from]
	}
	return out
}

// arm32QAliasName reports whether name, in any case, is one of clang's NEON q aliases.
func arm32QAliasName(name *[]readonly char) bool {
	var names @[]*[]readonly char = @[]*[]readonly char{"vaddq", "vsubq", "vmulq", "vabsq", "vmovq",
			"vmvnq", "vcvtq", "vandq", "vbicq", "veorq", "vorrq", "vminq", "vmaxq", "vshlq", "vshrq",
			"vcleq", "vceqq", "vzipq", "vswpq"}
	for i := 0; i < len(names); i++ {
		if mnemIs(name, names[i]) { return true }
	}
	return false
}
