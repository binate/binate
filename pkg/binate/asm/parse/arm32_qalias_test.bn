package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// clang's NEON aliases vaddq .. vmovq, as clang assembles them with NEON (the default Linux
// target): the instruction without the q, with a condition, `.w`, in any case.
func TestParseArm32QAlias() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vaddq.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vaddqeq.f32 s0, s1, s2", "0E300A81")
	e = armGateIs(e, "", "VADDQ.F32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vaddq.f32.w s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vsubq.f32 s0, s1", "EE300A60")
	e = armGateIs(e, "", "vmulq.f64 d0, d1, d2", "EE210B02")
	e = armGateIs(e, "", "vabsqeq.f64 d0, d1", "0EB00BC1")
	e = armGateIs(e, "", "vmovq.f32 s0, #1.0", "EEB70A00")
	e = armGateIs(e, "", "vmovq r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "vmovq.32 d0[1], r0", "EE200B10")
	return e
}

// What clang does not take of them: an `s` after the name (after a condition too, read as part
// of the name), and any of them without NEON (a `.n` reported first).
func TestParseArm32QAliasRejects() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vaddqs.f32 s0, s1, s2", "!instruction 'vaddq' can not set flags")
	e = armGateIs(e, "", "vaddqeqs.f32 s0, s1, s2", "!instruction 'vaddqeq' can not set flags")
	e = armGateIs(e, "", "VCVTQS.F32.S32 s0, s1", "!instruction 'vcvtq' can not set flags")
	e = armGateIs(e, ".fpu vfpv2", "vaddqs.f32 s0, s1, s2", "!instruction 'vaddq' can not set flags")
	e = armGateIs(e, ".fpu vfpv2", "vaddq.f32 s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, ".fpu vfpv2", "vmovq s0, s1", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vcvtq.f32.s32 s0, s1", "!invalid instruction")
	e = armGateIs(e, ".fpu vfpv2", "vaddq.f32.n s0, s1, s2", "!instruction with .n (narrow)")
	e = armGateIs(e, ".fpu vfpv2", "vcvtq.n.f32.s32 s0, s1", "!instruction with .n (narrow)")
	return e
}
