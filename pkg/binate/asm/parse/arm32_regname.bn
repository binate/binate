package "pkg/binate/asm/parse"

// arm32RegisterName reports whether clang's ARM parser reads name as a register, in any case: a
// core register (parseArm32Reg), s0..s31, d0..d31, q0..q15 (no leading zero), a status register,
// a floating-point system register, or one of a few more.  Such a name is no label where an
// operand takes a label but not that register -- ADR's, a literal load's or preload's, BLX's
// other than a core register's -- so clang rejects it there (after `#` it is a label's, and a
// branch reads it as one).
func arm32RegisterName(name *[]readonly char) bool {
	if parseArm32Reg(name) >= 0 { return true }
	if len(name) >= 2 && len(name) <= 3 {
		var c char = arm32Lower(name[0])
		var limit int = -1
		if c == 's' || c == 'd' { limit = 31 }
		if c == 'q' { limit = 15 }
		var n int = 0
		for i := 1; i < len(name) && limit >= 0; i++ {
			if name[i] < '0' || name[i] > '9' || (i == 1 && name[i] == '0' && len(name) > 2) { limit = -1 }
			n = n * 10 + cast(int, name[i]) - cast(int, '0')
		}
		if limit >= 0 && n <= limit { return true }
	}
	var others @[]*[]readonly char = @[]*[]readonly char{"apsr", "apsr_nzcv", "cpsr", "spsr", "fpscr",
			"fpscr_nzcv", "fpscr_nzcvqc", "fpexc", "fpsid", "fpinst", "fpinst2", "mvfr0", "mvfr1", "mvfr2",
			"fpcxtns", "fpcxts", "vpr", "p0", "ra_auth_code", "itstate", "zr"}
	for i := 0; i < len(others); i++ {
		if mnemIs(name, others[i]) { return true }
	}
	return false
}
