package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The names clang's ARM parser reads as registers, in any case, and near misses it reads as
// labels: a number past the bank (d32, s32, q16), a leading zero, a register pair, a mode's
// banked register, a PSR with fields, an AArch64 name, a coprocessor's.
func TestArm32RegisterName() testing.TestResult {
	var regs @[]*[]readonly char = @[]*[]readonly char{"r0", "R15", "sp", "a1", "v8", "sb", "ip", "s0",
			"S31", "d0", "D31", "q0", "Q15", "s9", "apsr", "APSR_NZCV", "cpsr", "spsr", "fpscr",
			"fpscr_nzcv", "fpscr_nzcvqc", "fpexc", "fpsid", "fpinst", "fpinst2", "mvfr0", "mvfr1", "mvfr2",
			"fpcxtns", "fpcxts", "vpr", "p0", "Ra_Auth_Code", "itstate", "ZR"}
	for i := 0; i < len(regs); i++ {
		if !arm32RegisterName(regs[i]) { return fail(buf.Concat(regs[i], ": not a register")) }
	}
	var labels @[]*[]readonly char = @[]*[]readonly char{"d32", "s32", "q16", "d01", "s05", "q00",
			"r16", "r0_r1", "d0_d1", "sp_usr", "lr_svc", "cpsr_fc", "apsr_g", "mvfr3", "p15", "c0", "x0",
			"w0", "lbl", "s", "d"}
	for i := 0; i < len(labels); i++ {
		if arm32RegisterName(labels[i]) { return fail(buf.Concat(labels[i], ": a register")) }
	}
	return ""
}
