package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/sys"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// The system and hint instructions (asm/arm32/sys), as clang takes them: the ones with one
// immediate -- SVC (SWI), BKPT, UDF, HVC, HLT, SMC (SMI), HINT, DBG, SETPAN -- with or without
// `#` and an expression; the ones with none -- NOP, the named hints, ERET, SB, SSBB, PSSBB, DFB,
// TSB CSYNC, TRAP (UDF #0xFDEE); the barriers DMB, DSB and ISB with an option's name or number;
// SETEND BE / LE.  An
// instruction that has no condition field is an error with one, and each is gated by the
// architecture or extension that has it.

// arm32NotPredicable sets clang's error for a condition on an instruction that has none.
func arm32NotPredicable(p @Parser, name *[]readonly char) {
	setErr(p,
			buf.Concat(buf.Concat("instruction '", name),
					"' is not predicable, but condition code specified"))
}

// arm32SysImmInfo returns, for an instruction with one immediate operand, the largest immediate
// (its range is 0..that, or -1 when name is no such instruction), the features it needs and
// clang's name for them, and whether it takes a condition.
func arm32SysImmInfo(name *[]readonly char) (int, uint64, *[]readonly char, bool) {
	if mnemIs(name, "svc") || mnemIs(name, "swi") { return 0xFFFFFF, 0, "", true }
	if mnemIs(name, "bkpt") || mnemIs(name, "udf") { return 0xFFFF, 0, "", false }
	if mnemIs(name, "hvc") { return 0xFFFF, armVirt, "virtualization-extensions", false }
	if mnemIs(name, "hlt") { return 0xFFFF, armV8, "armv8", false }
	if mnemIs(name, "smc") || mnemIs(name, "smi") { return 15, armSec, "TrustZone", true }
	if mnemIs(name, "hint") { return 239, armV6, "armv6", true }
	if mnemIs(name, "dbg") { return 15, armV7, "armv7", true }
	if mnemIs(name, "setpan") { return 1, armV8 | armV8_1, "armv8.1a", false }
	return -1, 0, "", false
}

// parseArm32SysImm assembles the instruction name with one immediate operand (arm32SysImmInfo),
// l the lexer after the mnemonic.  BKPT alone is BKPT #0, as clang takes it.
func parseArm32SysImm(p @Parser, l Lexer, name *[]readonly char, cond int) {
	max, feat, what, predicable := arm32SysImmInfo(name)
	if !predicable && cond != arm32.COND_AL {
		arm32NotPredicable(p, name)
		return
	}
	var b @strings.Builder = strings.NewBuilder()
	b.Write("operand must be an immediate in the range [0,")
	if max == 0xFFFFFF {
		b.Write("0xffffff")
	} else {
		stringutils.WriteInt(b, max)
	}
	b.WriteByte(']')
	var rangeMsg @[]char = buf.CopyStr(b.String())
	var tok Token
	l, tok = LexNext(l)
	var n int64 = 0
	if tok.Kind == TOK_EOF && !mnemIs(name, "bkpt") {
		if mnemIs(name, "hlt") || mnemIs(name, "setpan") {
			setErr(p, "invalid instruction")
		} else {
			setErr(p, "too few operands for instruction")
		}
		return
	}
	if tok.Kind != TOK_EOF {
		var r ExprResult
		l, tok, r = parseArm32OperandExpr(p, l, tok)
		if !r.Ok {
			setErr(p, exprErr(r, rangeMsg))
			return
		}
		if r.FromDiff {
			// clang wants a constant here, not one a label difference decides.
			setErr(p, "constant expression expected")
			return
		}
		if !arm32AtEOL(p, tok) { return }
		if r.Val < 0 || r.Val > cast(int64, max) {
			setErr(p, rangeMsg)
			return
		}
		n = r.Val
	}
	// clang reads HINT #20 as CSDB, and HINT #16 as ESB where RAS has it, neither predicable.
	if mnemIs(name, "hint") && cond != arm32.COND_AL &&
			(n == cast(int64, sys.HINT_CSDB) ||
					(n == cast(int64, sys.HINT_ESB) && p.Arm32Feats & armRAS != 0)) {
		if n == cast(int64, sys.HINT_CSDB) {
			arm32NotPredicable(p, "csdb")
		} else {
			arm32NotPredicable(p, "esb")
		}
		return
	}
	if mnemIs(name, "setpan") && p.Arm32Feats & armV8 == 0 {
		setErr(p, "instruction requires: armv8 armv8.1a")
		return
	}
	if feat != 0 && !armRequire(p, feat, what) { return }
	var v int = cast(int, n)
	if mnemIs(name, "svc") || mnemIs(name, "swi") { sys.Svc(p.Asm, cond, v) }
	if mnemIs(name, "bkpt") { sys.Bkpt(p.Asm, v) }
	if mnemIs(name, "udf") { sys.Udf(p.Asm, v) }
	if mnemIs(name, "hvc") { sys.Hvc(p.Asm, v) }
	if mnemIs(name, "hlt") { sys.Hlt(p.Asm, v) }
	if mnemIs(name, "smc") || mnemIs(name, "smi") { sys.Smc(p.Asm, cond, v) }
	if mnemIs(name, "hint") { sys.Hint(p.Asm, cond, v) }
	if mnemIs(name, "dbg") { sys.Dbg(p.Asm, cond, v) }
	if mnemIs(name, "setpan") { sys.Setpan(p.Asm, v) }
}

// The instructions with no operand besides the hints' (arm32SysBareInfo), by what they emit.
const (
	sysBareEret int = -2
	sysBareSb int = -3
	sysBareSsbb int = -4
	sysBarePssbb int = -5
	sysBareDfb int = -6
	sysBareTsb int = -7
	sysBareTrap int = -8
)

// arm32SysBareInfo returns, for an instruction with no operand (TSB's CSYNC aside), the hint it
// is (a HINT number) or one of the sysBare* codes, -1 when name is no such instruction; the
// features it needs and clang's name for them; and whether it takes a condition.
func arm32SysBareInfo(name *[]readonly char) (int, uint64, *[]readonly char, bool) {
	if mnemIs(name, "yield") { return sys.HINT_YIELD, armV6K, "armv6k", true }
	if mnemIs(name, "wfe") { return sys.HINT_WFE, armV6K, "armv6k", true }
	if mnemIs(name, "wfi") { return sys.HINT_WFI, armV6K, "armv6k", true }
	if mnemIs(name, "sev") { return sys.HINT_SEV, armV6K, "armv6k", true }
	if mnemIs(name, "sevl") { return sys.HINT_SEVL, armV8, "armv8", true }
	if mnemIs(name, "csdb") { return sys.HINT_CSDB, armV6K, "armv6k", false }
	if mnemIs(name, "esb") { return sys.HINT_ESB, armRAS, "ras", false }
	if mnemIs(name, "clrbhb") { return sys.HINT_CLRBHB, armV8, "armv8", false }
	if mnemIs(name, "eret") { return sysBareEret, armVirt, "virtualization-extensions", true }
	if mnemIs(name, "sb") { return sysBareSb, armSB, "sb", false }
	if mnemIs(name, "ssbb") { return sysBareSsbb, armV7, "data-barriers", false }
	if mnemIs(name, "pssbb") { return sysBarePssbb, armV7, "data-barriers", false }
	if mnemIs(name, "dfb") { return sysBareDfb, armFDB, "full-data-barrier", false }
	if mnemIs(name, "tsb") { return sysBareTsb, armV8_4, "armv8.4a", false }
	if mnemIs(name, "trap") { return sysBareTrap, 0, "", false }
	return -1, 0, "", false
}

// parseArm32SysBare assembles the instruction name with no operand (arm32SysBareInfo), l the lexer
// after the mnemonic: TSB takes CSYNC, the one option it has.
func parseArm32SysBare(p @Parser, l Lexer, name *[]readonly char, cond int) {
	code, feat, what, predicable := arm32SysBareInfo(name)
	// clang finds SB's condition before its feature, the others' feature first.
	if code == sysBareSb && cond != arm32.COND_AL {
		arm32NotPredicable(p, name)
		return
	}
	if feat != 0 && !armRequire(p, feat, what) { return }
	if !predicable && cond != arm32.COND_AL {
		arm32NotPredicable(p, name)
		return
	}
	var tok Token
	l, tok = LexNext(l)
	if code == sysBareTsb {
		if tok.Kind == TOK_EOF {
			setErr(p, "too few operands for instruction")
			return
		}
		if tok.Kind != TOK_IDENT || !mnemIs(tok.Text, "csync") {
			setErr(p, "invalid operand for instruction")
			return
		}
		l, tok = LexNext(l)
	}
	if tok.Kind != TOK_EOF {
		setErr(p, "too many operands for instruction")
		return
	}
	if code >= 0 { sys.Hint(p.Asm, cond, code) }
	if code == sysBareEret { sys.Eret(p.Asm, cond) }
	if code == sysBareSb { sys.Sb(p.Asm) }
	if code == sysBareSsbb { sys.Dsb(p.Asm, 0) }
	if code == sysBarePssbb { sys.Dsb(p.Asm, 4) }
	if code == sysBareDfb { sys.Dsb(p.Asm, 12) }
	if code == sysBareTsb { sys.Hint(p.Asm, arm32.COND_AL, sys.HINT_TSB_CSYNC) }
	if code == sysBareTrap { sys.Udf(p.Asm, 0xFDEE) }
}

// arm32BarrierOption returns the option a barrier option's name stands for, in any case (the LD
// ones ARMv8's; UN, UNST, SH and SHST the old names of NSH, NSHST, ISH and ISHST), and whether name
// is one.
func arm32BarrierOption(name *[]readonly char) (int, bool) {
	var names @[]*[]readonly char = @[]*[]readonly char{"oshld", "oshst", "osh", "nshld", "nshst",
			"nsh", "ishld", "ishst", "ish", "ld", "st", "sy", "un", "unst", "sh", "shst"}
	var opts @[]int = @[]int{sys.BAR_OSHLD, sys.BAR_OSHST, sys.BAR_OSH, sys.BAR_NSHLD, sys.BAR_NSHST,
			sys.BAR_NSH, sys.BAR_ISHLD, sys.BAR_ISHST, sys.BAR_ISH, sys.BAR_LD, sys.BAR_ST, sys.BAR_SY,
			sys.BAR_NSH, sys.BAR_NSHST, sys.BAR_ISH, sys.BAR_ISHST}
	for i := 0; i < len(names); i++ {
		if mnemIs(name, names[i]) { return opts[i], true }
	}
	return 0, false
}

// parseArm32Barrier assembles DMB, DSB or ISB (name; l the lexer after the mnemonic), from ARMv7:
// an option's name (ISB's only SY; an LD one from ARMv8), a number 0..15 after `#` or `$` or
// starting with a digit (clang takes no other expression there, nor another name), or nothing,
// SY.
func parseArm32Barrier(p @Parser, l Lexer, name *[]readonly char, cond int) {
	if !armRequire(p, armV7, "data-barriers") { return }
	if cond != arm32.COND_AL {
		arm32NotPredicable(p, name)
		return
	}
	var tok Token
	l, tok = LexNext(l)
	var option int = sys.BAR_SY
	if tok.Kind != TOK_EOF {
		var named int
		var isName bool = false
		var dollar bool = tok.Kind == TOK_IDENT && len(tok.Text) > 0 && tok.Text[0] == '$'
		if tok.Kind == TOK_IDENT && !dollar {
			named, isName = arm32BarrierOption(tok.Text)
			if !isName {
				setErr(p, "invalid operand for instruction")
				return
			}
		} else if tok.Kind != TOK_INT && tok.Kind != TOK_HASH && tok.Kind != TOK_DOLLAR && !dollar {
			setErr(p, "expected an immediate or barrier type")
			return
		}
		if isName {
			var ld bool = named == sys.BAR_LD || named == sys.BAR_ISHLD || named == sys.BAR_NSHLD ||
					named == sys.BAR_OSHLD
			if (mnemIs(name, "isb") && named != sys.BAR_SY) || (ld && p.Arm32Feats & armV8 == 0) {
				setErr(p, "invalid operand for instruction")
				return
			}
			option = named
			l, tok = LexNext(l)
		} else {
			var prefixed bool
			l, prefixed = arm32ImmPrefix(l, tok, true)
			if prefixed { l, tok = LexNext(l) }
			var r ExprResult
			l, tok, r = ParseExpr(p, l, tok)
			if !r.Ok || r.FromDiff {
				setErr(p, "constant expression expected")
				return
			}
			if r.Val < 0 || r.Val > 15 {
				setErr(p, "immediate value out of range")
				return
			}
			option = cast(int, r.Val)
		}
		if !arm32AtEOL(p, tok) { return }
	}
	if mnemIs(name, "dmb") { sys.Dmb(p.Asm, option) }
	if mnemIs(name, "dsb") { sys.Dsb(p.Asm, option) }
	if mnemIs(name, "isb") { sys.Isb(p.Asm, option) }
}

// parseArm32Setend assembles SETEND BE / LE (l the lexer after the mnemonic).
func parseArm32Setend(p @Parser, l Lexer, cond int) {
	if cond != arm32.COND_AL {
		arm32NotPredicable(p, "setend")
		return
	}
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind == TOK_EOF {
		setErr(p, "too few operands for instruction")
		return
	}
	if tok.Kind != TOK_IDENT || !(mnemIs(tok.Text, "be") || mnemIs(tok.Text, "le")) {
		setErr(p, "'be' or 'le' operand expected")
		return
	}
	var big bool = mnemIs(tok.Text, "be")
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF {
		setErr(p, "too many operands for instruction")
		return
	}
	sys.Setend(p.Asm, big)
}

// parseArm32System assembles a system or hint instruction -- one of this file's, MRS / MSR
// (arm32_psr.bn), CPS / SRS / RFE (arm32_cps.bn) -- from baseMnem and cond (l the lexer after the
// mnemonic), reporting whether baseMnem is one.
func parseArm32System(p @Parser, l Lexer, baseMnem *[]readonly char, cond int) bool {
	if mnemIs(baseMnem, "nop") {
		var tok Token
		l, tok = LexNext(l)
		if tok.Kind != TOK_EOF {
			setErr(p, "too many operands for instruction")
			return true
		}
		// clang's NOP is the ARMv6K hint; before ARMv6K it is MOV r0, r0.
		if p.Arm32Feats & armV6K != 0 {
			sys.Nop(p.Asm, cond)
		} else {
			arm32.Mov(p.Asm, cond, false, arm32.R0, arm32.Reg(arm32.R0))
		}
		return true
	}
	max, _, _, _ := arm32SysImmInfo(baseMnem)
	if max >= 0 {
		parseArm32SysImm(p, l, baseMnem, cond)
		return true
	}
	code, _, _, _ := arm32SysBareInfo(baseMnem)
	if code != -1 {
		parseArm32SysBare(p, l, baseMnem, cond)
		return true
	}
	if mnemIs(baseMnem, "dmb") || mnemIs(baseMnem, "dsb") || mnemIs(baseMnem, "isb") {
		parseArm32Barrier(p, l, baseMnem, cond)
		return true
	}
	if mnemIs(baseMnem, "setend") {
		parseArm32Setend(p, l, cond)
		return true
	}
	if mnemIs(baseMnem, "mrs") || mnemIs(baseMnem, "msr") {
		parseArm32Psr(p, l, mnemIs(baseMnem, "msr"), cond)
		return true
	}
	return parseArm32ModeChange(p, l, baseMnem, cond)
}

// arm32IsSystemMnem reports whether name is a system or hint instruction parseArm32System takes.
func arm32IsSystemMnem(name *[]readonly char) bool {
	max, _, _, _ := arm32SysImmInfo(name)
	code, _, _, _ := arm32SysBareInfo(name)
	return max >= 0 || code != -1 || mnemIs(name, "nop") || mnemIs(name, "dmb") ||
			mnemIs(name, "dsb") || mnemIs(name, "isb") || mnemIs(name, "setend") || mnemIs(name, "mrs") ||
			mnemIs(name, "msr") || arm32IsModeChangeMnem(name)
}
