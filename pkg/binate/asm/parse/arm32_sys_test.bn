package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The system instructions with one immediate, `#` optional and an expression allowed, each word as
// clang assembles it: SVC (SWI), BKPT (alone, #0), UDF, HVC, SMC (SMI), HINT, DBG.
func TestParseArm32SysImm() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 26)
	g[0] = arm32MemGolden{line: "svc #0", word: 0xEF000000}
	g[1] = arm32MemGolden{line: "svc 5", word: 0xEF000005}
	g[2] = arm32MemGolden{line: "svc #0xffffff", word: 0xEFFFFFFF}
	g[3] = arm32MemGolden{line: "svceq #1", word: 0x0F000001}
	g[4] = arm32MemGolden{line: "swi #3", word: 0xEF000003}
	g[5] = arm32MemGolden{line: "swieq 4", word: 0x0F000004}
	g[6] = arm32MemGolden{line: "bkpt", word: 0xE1200070}
	g[7] = arm32MemGolden{line: "bkpt 5", word: 0xE1200075}
	g[8] = arm32MemGolden{line: "bkpt #0xffff", word: 0xE12FFF7F}
	g[9] = arm32MemGolden{line: "udf #0", word: 0xE7F000F0}
	g[10] = arm32MemGolden{line: "udf #65535", word: 0xE7FFFFFF}
	g[11] = arm32MemGolden{line: "hvc #65535", word: 0xE14FFF7F}
	g[12] = arm32MemGolden{line: "hvc 1", word: 0xE1400071}
	g[13] = arm32MemGolden{line: "hvc #1+1", word: 0xE1400072}
	g[14] = arm32MemGolden{line: "smc #15", word: 0xE160007F}
	g[15] = arm32MemGolden{line: "smceq #1", word: 0x01600071}
	g[16] = arm32MemGolden{line: "smi #1", word: 0xE1600071}
	g[17] = arm32MemGolden{line: "smc #(3*5)", word: 0xE160007F}
	g[18] = arm32MemGolden{line: "hint #5", word: 0xE320F005}
	g[19] = arm32MemGolden{line: "hint 5", word: 0xE320F005}
	g[20] = arm32MemGolden{line: "hint #0x10", word: 0xE320F010}
	g[21] = arm32MemGolden{line: "hinteq #5", word: 0x0320F005}
	g[22] = arm32MemGolden{line: "hinteq #16", word: 0x0320F010}
	g[23] = arm32MemGolden{line: "dbg #15", word: 0xE320F0FF}
	g[24] = arm32MemGolden{line: "dbgeq #3", word: 0x0320F0F3}
	g[25] = arm32MemGolden{line: "dbg 5", word: 0xE320F0F5}
	return arm32CheckGoldens(g)
}

// What clang rejects of them: an immediate past its range or below 0, `$` and a name, a missing
// operand, a condition where there is none, HINT #20 with one (it is CSDB), an extra operand.
func TestParseArm32SysImmRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 24)
	bad[0] = "svc #0x1000000"
	bad[1] = "svc $5"
	bad[2] = "svc"
	bad[3] = "svc #-1"
	bad[4] = "bkpteq #1"
	bad[5] = "bkpt #0x10000"
	bad[6] = "bkpt $1"
	bad[7] = "bkpt #-1"
	bad[8] = "udf #65536"
	bad[9] = "udf"
	bad[10] = "udfeq #1"
	bad[11] = "hvceq #1"
	bad[12] = "hvc"
	bad[13] = "smc #16"
	bad[14] = "smc"
	bad[15] = "smc $1"
	bad[16] = "hint #240"
	bad[17] = "hint $5"
	bad[18] = "hinteq #20"
	bad[19] = "dbg #16"
	bad[20] = "dbg"
	bad[21] = "dbg $5"
	bad[22] = "svc #1, 2"
	bad[23] = "eret r0"
	return arm32CheckRejects(bad)
}

// The instructions with no operand, each word as clang assembles it: NOP and the named hints
// (`.w` ignored), ERET, SSBB and PSSBB (DSB #0 and #4), TRAP (UDF #0xFDEE).
func TestParseArm32SysBare() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 16)
	g[0] = arm32MemGolden{line: "nop", word: 0xE320F000}
	g[1] = arm32MemGolden{line: "nopeq", word: 0x0320F000}
	g[2] = arm32MemGolden{line: "nop.w", word: 0xE320F000}
	g[3] = arm32MemGolden{line: "yield", word: 0xE320F001}
	g[4] = arm32MemGolden{line: "yieldeq", word: 0x0320F001}
	g[5] = arm32MemGolden{line: "yield.w", word: 0xE320F001}
	g[6] = arm32MemGolden{line: "wfe", word: 0xE320F002}
	g[7] = arm32MemGolden{line: "wfi", word: 0xE320F003}
	g[8] = arm32MemGolden{line: "wfine", word: 0x1320F003}
	g[9] = arm32MemGolden{line: "sev", word: 0xE320F004}
	g[10] = arm32MemGolden{line: "csdb", word: 0xE320F014}
	g[11] = arm32MemGolden{line: "eret", word: 0xE160006E}
	g[12] = arm32MemGolden{line: "ereteq", word: 0x0160006E}
	g[13] = arm32MemGolden{line: "ssbb", word: 0xF57FF040}
	g[14] = arm32MemGolden{line: "pssbb", word: 0xF57FF044}
	g[15] = arm32MemGolden{line: "trap", word: 0xE7FFDEFE}
	return arm32CheckGoldens(g)
}

// What clang rejects of them: an operand, a condition where there is none, and on armv7ve the
// ones a later architecture or an extension has.
func TestParseArm32SysBareRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 16)
	bad[0] = "csdbeq"
	bad[1] = "nop r0"
	bad[2] = "yield r0"
	bad[3] = "wfe #1"
	bad[4] = "csdb r0"
	bad[5] = "ssbb sy"
	bad[6] = "pssbb #0"
	bad[7] = "pssbbeq"
	bad[8] = "sevl"
	bad[9] = "esb"
	bad[10] = "sb"
	bad[11] = "clrbhb"
	bad[12] = "dfb"
	bad[13] = "tsb csync"
	bad[14] = "trapeq"
	bad[15] = "trap #1"
	return arm32CheckRejects(bad)
}

// Each is gated as clang gates it: the named hints from ARMv6K (HINT from ARMv6, DBG from
// ARMv7), SEVL / CLRBHB / HLT from ARMv8, SETPAN from ARMv8.1, TSB CSYNC from ARMv8.4, ESB with RAS
// (where a conditional HINT #16 is ESB too), SB from ARMv8.5, DFB on ARMv8-R, HVC / ERET
// with the virtualization extensions, SMC with TrustZone.
func TestParseArm32SysGates() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv8.5-a", "sevl", "E320F005")
	e = armGateIs(e, ".arch armv8.5-a", "esb", "E320F010")
	e = armGateIs(e, ".arch armv8.5-a", "sb", "F57FF070")
	e = armGateIs(e, ".arch armv8.5-a", "clrbhb", "E320F016")
	e = armGateIs(e, ".arch armv8.5-a", "tsb csync", "E320F012")
	e = armGateIs(e, ".arch armv8.5-a", "setpan #1", "F1100200")
	e = armGateIs(e, ".arch armv8.5-a", "setpan 0", "F1100000")
	e = armGateIs(e, ".arch armv8.5-a", "hlt #63", "E100037F")
	e = armGateIs(e, ".arch armv8.5-a", "hlt #65535", "E10FFF7F")
	e = armGateIs(e, ".arch armv8.5-a", "setpan #2",
			"!operand must be an immediate in the range [0,1]")
	e = armGateIs(e, ".arch armv8.5-a", "hlteq #1", "!instruction 'hlt' is not predicable")
	e = armGateIs(e, ".arch armv8.5-a", "esbeq", "!instruction 'esb' is not predicable")
	e = armGateIs(e, ".arch armv8.2-a", "hinteq #16", "!instruction 'esb' is not predicable")
	e = armGateIs(e, ".arch armv8.3-a", "tsb csync", "!instruction requires: armv8.4a")
	e = armGateIs(e, ".cpu cortex-r52", "dfb", "F57FF04C")
	e = armGateIs(e, ".arch armv8-r", "dfb", "F57FF04C")
	e = armGateIs(e, ".arch armv6", "yield", "!instruction requires: armv6k")
	e = armGateIs(e, ".arch armv6", "hint #5", "E320F005")
	e = armGateIs(e, ".arch armv5te", "hint #5", "!instruction requires: armv6")
	e = armGateIs(e, ".arch armv6k", "dbg #0", "!instruction requires: armv7")
	e = armGateIs(e, ".arch armv6k", "dmb", "!instruction requires: data-barriers")
	e = armGateIs(e, ".arch armv7-a", "hvc #0", "!instruction requires: virtualization-extensions")
	e = armGateIs(e, ".arch armv7-a", "eret", "!instruction requires: virtualization-extensions")
	e = armGateIs(e, ".arch armv7-a", "smc #0", "!instruction requires: TrustZone")
	e = armGateIs(e, ".arch armv8-a", "setpan #1", "!instruction requires: armv8.1a")
	e = armGateIs(e, ".arch armv7-a", "setpan #1", "!instruction requires: armv8 armv8.1a")
	e = armGateIs(e, ".arch armv8-a", "sevl", "E320F005")
	e = armGateIs(e, ".arch armv8-a", "hlt #0", "E1000070")
	e = armGateIs(e, ".arch armv7-a", "hlt #0", "!instruction requires: armv8")
	return e
}

// DMB, DSB and ISB with an option's name in any case (UN, UNST, SH and SHST the old names of NSH,
// NSHST, ISH and ISHST), a number (`#`, `$` or a digit first) or none, SY, each word as clang
// assembles it; ARMv8's LD options.
func TestParseArm32Barriers() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 28)
	g[0] = arm32MemGolden{line: "dmb", word: 0xF57FF05F}
	g[1] = arm32MemGolden{line: "dmb sy", word: 0xF57FF05F}
	g[2] = arm32MemGolden{line: "dmb st", word: 0xF57FF05E}
	g[3] = arm32MemGolden{line: "dmb ish", word: 0xF57FF05B}
	g[4] = arm32MemGolden{line: "dmb ishst", word: 0xF57FF05A}
	g[5] = arm32MemGolden{line: "dmb nsh", word: 0xF57FF057}
	g[6] = arm32MemGolden{line: "dmb nshst", word: 0xF57FF056}
	g[7] = arm32MemGolden{line: "dmb osh", word: 0xF57FF053}
	g[8] = arm32MemGolden{line: "dmb oshst", word: 0xF57FF052}
	g[9] = arm32MemGolden{line: "dmb #0", word: 0xF57FF050}
	g[10] = arm32MemGolden{line: "dmb #15", word: 0xF57FF05F}
	g[11] = arm32MemGolden{line: "dmb SY", word: 0xF57FF05F}
	g[12] = arm32MemGolden{line: "dmb un", word: 0xF57FF057}
	g[13] = arm32MemGolden{line: "dmb unst", word: 0xF57FF056}
	g[14] = arm32MemGolden{line: "dmb 5", word: 0xF57FF055}
	g[15] = arm32MemGolden{line: "dmb $5", word: 0xF57FF055}
	g[16] = arm32MemGolden{line: "dmb ISHst", word: 0xF57FF05A}
	g[17] = arm32MemGolden{line: "dmb.w sy", word: 0xF57FF05F}
	g[18] = arm32MemGolden{line: "dsb", word: 0xF57FF04F}
	g[19] = arm32MemGolden{line: "dsb ish", word: 0xF57FF04B}
	g[20] = arm32MemGolden{line: "dsb #4", word: 0xF57FF044}
	g[21] = arm32MemGolden{line: "isb", word: 0xF57FF06F}
	g[22] = arm32MemGolden{line: "isb sy", word: 0xF57FF06F}
	g[23] = arm32MemGolden{line: "isb #0", word: 0xF57FF060}
	g[24] = arm32MemGolden{line: "isb 15", word: 0xF57FF06F}
	g[25] = arm32MemGolden{line: "dmb sh", word: 0xF57FF05B}
	g[26] = arm32MemGolden{line: "dmb SHST", word: 0xF57FF05A}
	g[27] = arm32MemGolden{line: "dsb sh", word: 0xF57FF04B}
	return arm32CheckGoldens(g)
}

// What clang rejects of them: an LD option before ARMv8, an option past 15 or below 0, a name
// after `#`, ISB's options other than SY, a condition, a second operand, a number not after `#`
// or `$` nor starting with a digit, another name -- a constant's too.  (A barrier's number wider
// than 32 bits, which clang truncates, is an error, as every immediate's is.)
func TestParseArm32BarrierRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 19)
	bad[0] = "dmb ld"
	bad[1] = "dmb ishld"
	bad[2] = "dsb ld"
	bad[3] = "dmb #16"
	bad[4] = "dmb #-1"
	bad[5] = "dmb #sy"
	bad[6] = "isb ish"
	bad[7] = "isb ld"
	bad[8] = "dmbeq sy"
	bad[9] = "dsbeq ish"
	bad[10] = "isbeq"
	bad[11] = "dmb sy, ish"
	bad[12] = "dmb (5)"
	bad[13] = "dmb -0"
	bad[14] = "dmb +5"
	bad[15] = "isb (15)"
	bad[16] = "dmb foo"
	bad[17] = "isb sh"
	bad[18] = "dsb #0x100000005"
	var r testing.TestResult = arm32CheckRejects(bad)
	if len(r) != 0 { return r }
	var p @Parser = arm32Source("N = 7\ndmb N")
	if !p.HasError { return fail("dmb of a constant's name was taken") }
	return ""
}

// ARMv8 has the LD options.
func TestParseArm32BarrierLd() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, ".arch armv8-a", "dmb ld", "F57FF05D")
	e = armGateIs(e, ".arch armv8-a", "dmb ishld", "F57FF059")
	e = armGateIs(e, ".arch armv8-a", "dsb oshld", "F57FF041")
	e = armGateIs(e, ".arch armv8-a", "dsb #9", "F57FF049")
	e = armGateIs(e, ".arch armv8-a", "isb ld", "!invalid operand for instruction")
	return e
}

// SETEND BE / LE, in any case, as clang assembles them.
func TestParseArm32Setend() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 4)
	g[0] = arm32MemGolden{line: "setend be", word: 0xF1010200}
	g[1] = arm32MemGolden{line: "setend le", word: 0xF1010000}
	g[2] = arm32MemGolden{line: "setend BE", word: 0xF1010200}
	g[3] = arm32MemGolden{line: "setend LE", word: 0xF1010000}
	return arm32CheckGoldens(g)
}

// What clang rejects of SETEND: a condition, no operand, another one, two.
func TestParseArm32SetendRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 5)
	bad[0] = "setendeq be"
	bad[1] = "setend"
	bad[2] = "setend xe"
	bad[3] = "setend be, le"
	bad[4] = "setend #be"
	return arm32CheckRejects(bad)
}
