package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// PC-relative targets -- a branch's and an ADR's -- as clang takes them, '#' optional: a
// label{+addend}, with clang's `(PLT)` suffix allowed after the symbol (`bl ext(PLT)`, `adr r0,
// ext(PLT)`, arm32_plt.bn); `.±N`, the address N bytes from this instruction; or a number, the
// offset from PC (which reads this instruction + 8).  A label difference
// (`b l2-l1`) is an error (diffTargetError): it is a number, but clang reads it as an
// absolute address there.  Without `#` or `$`, a target may not start with `-`, `+` or `~`, as
// clang's general operand parser has it; an ADR number that starts with `-` after its prefix and
// comes to 0 is SUB Rd, PC, #0, clang's negative zero.

// parseArm32PcTarget parses the PC-relative target starting at tok (what names it in
// errors) through the end of the line, returning it, or ok=false with p's error set.  A
// number is returned unchecked against the host's int; a symbol's addend and a `.±N`
// fit it.
func parseArm32PcTarget(p @Parser, l Lexer, tok Token, what *[]readonly char) (ExprResult, bool) {
	var r ExprResult
	if tok.Kind == TOK_HASH || tok.Kind == TOK_DOLLAR {
		l, tok = LexNext(l)
	} else if arm32SignedStart(tok) {
		setErr(p, "unexpected token in operand")
		return r, false
	}
	if tok.Kind != TOK_IDENT && tok.Kind != TOK_DOT && !startsNumericExpr(tok) {
		setErr(p, buf.Concat("expected the ", what))
		return r, false
	}
	p.Arm32PltOk = true
	l, tok, r = parseSymExpr(p, l, tok)
	p.Arm32PltOk = false
	if !r.Ok {
		setErr(p, exprErr(r, buf.Concat("invalid ", what)))
		return r, false
	}
	if !arm32AtEOL(p, tok) { return r, false }
	if r.Plt { p.Arm32Plt = true }
	if len(r.Sym) == 0 && !r.Dot && r.FromDiff {
		diffTargetError(p)
		return r, false
	}
	if r.Dot && !intFits(r.Val) {
		setErr(p, buf.Concat(what, " out of range"))
		return r, false
	}
	return r, true
}

// parseArm32Branch assembles B{cond} (BL{cond} when link) to the target after the
// mnemonic (l is the lexer just past it).  A BL to `.±N` is to a label made at `.` (dotLabel),
// as clang has it, since a BL stays a relocation; a B to one is encoded in place.
func parseArm32Branch(p @Parser, l Lexer, cond int, link bool) {
	var tok Token
	l, tok = LexNext(l)
	var r ExprResult
	var ok bool
	r, ok = parseArm32PcTarget(p, l, tok, "branch target")
	if !ok { return }
	if r.Dot && link {
		r.Sym = dotLabel(p)
		if p.Asm.HasError { return }
	}
	if len(r.Sym) > 0 {
		arm32.BAddend(p.Asm, cond, link, r.Sym, r.Val)
		return
	}
	if r.Dot {
		if !intFits(r.Val) {
			setErr(p, "branch target out of range")
			return
		}
		arm32.BOffset(p.Asm, cond, link, cast(int, r.Val))
		return
	}
	var offset int
	var fits bool
	offset, fits = arm32BranchOffset(p, r.Val)
	if fits { arm32.BOffset(p.Asm, cond, link, offset) }
}

// arm32BranchOffset returns a branch's number target v -- the offset from PC, which reads the
// instruction + 8 -- as the offset from the instruction, v read as a 32-bit value, as clang reads
// it (0xFFFFFFF8 is -8).  A value wider than 32 bits, which clang truncates, is an error: ok false
// with p's error set.
func arm32BranchOffset(p @Parser, v int64) (int, bool) {
	if v >= 0x80000000 && v <= 0xFFFFFFFF { v = v - 0x100000000 }
	if v < -0x80000000 || v > 0x7FFFFFFF || !intFits(v + 8) {
		setErr(p, "branch target out of range")
		return 0, false
	}
	return cast(int, v + 8), true
}

// parseArm32BlxTarget assembles BLX (immediate) to the target starting at tok, from ARMv5T: a
// label or `.±N` (a label made at `.`) stays a relocation, its addend a multiple of 4 (bnas
// writes no H bit into a relocated BLX); a number is encoded in place, its bit 1 the H bit.  A
// condition other than AL is an error: BLX (immediate) has none, and clang drops it.
func parseArm32BlxTarget(p @Parser, l Lexer, tok Token, cond int) {
	if cond != arm32.COND_AL {
		setErr(p, "instruction 'blx' is not predicable, but condition code specified")
		return
	}
	var r ExprResult
	var ok bool
	r, ok = parseArm32PcTarget(p, l, tok, "branch target")
	if !ok || !armRequire(p, armV5T, "armv5t") { return }
	if r.Dot {
		r.Sym = dotLabel(p)
		if p.Asm.HasError { return }
	}
	if len(r.Sym) > 0 {
		arm32.BlxLabel(p.Asm, r.Sym, r.Val)
		return
	}
	var offset int
	var fits bool
	offset, fits = arm32BranchOffset(p, r.Val)
	if fits { arm32.BlxOffset(p.Asm, offset) }
}

// parseArm32Adr assembles `adr Rd, target` (arm32.Adr for a label; arm32.AdrOffset
// otherwise).  A number is read as a 32-bit value, as clang reads it (0xFF000000 is
// -0x1000000); -2^31 (which clang encodes as `sub Rd, pc, #0`) and a value wider than
// 32 bits (which clang truncates) are errors, as is one whose magnitude has no rotated
// encoding even where clang takes the other sign's (`#0x7FFFFFFC` as `sub Rd, pc,
// #0x80000004`).  tok is the token after Rd.
func parseArm32Adr(p @Parser, l Lexer, tok Token, cond int, rd int) {
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ','")
		return
	}
	l, tok = LexNext(l)
	if tok.Kind == TOK_IDENT && arm32RegisterName(tok.Text) {
		// clang reads a register's name there as the register, which ADR does not take (after
		// `#`, or inside an expression, it is a label's: `adr r0, #r1`).
		setErr(p, "invalid operand for instruction")
		return
	}
	var negative bool = arm32PrefixedMinus(l, tok)
	var r ExprResult
	var ok bool
	r, ok = parseArm32PcTarget(p, l, tok, "ADR target")
	if !ok { return }
	if negative && len(r.Sym) == 0 && !r.Dot && r.Val == 0 {
		// clang's negative zero: SUB Rd, PC, #0 rather than ADD.
		arm32.Sub(p.Asm, cond, false, rd, arm32.PC, arm32.Imm(0))
		return
	}
	if len(r.Sym) > 0 {
		arm32.Adr(p.Asm, cond, rd, r.Sym, r.Val)
		return
	}
	if r.Dot {
		if !intFits(r.Val - 8) {
			setErr(p, "ADR target out of range")
			return
		}
		arm32.AdrOffset(p.Asm, cond, rd, cast(int, r.Val - 8))
		return
	}
	var v int64 = r.Val
	if v >= 0x80000000 && v <= 0xFFFFFFFF { v = v - 0x100000000 }
	if v <= -0x80000000 || v > 0x7FFFFFFF || !intFits(v) {
		setErr(p, "ADR target out of range")
		return
	}
	arm32.AdrOffset(p.Asm, cond, rd, cast(int, v))
}
