package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// PC-relative targets (arm32_target.bn): branches, ADR and literal loads, each word as
// clang assembles it (`clang -target armv7a-none-eabi`).  (arm32CheckGoldens /
// arm32CheckRejects are in arm32_alias_test.bn, arm32PoolCase / arm32Source in
// arm32_pool_test.bn.)

// A branch or literal-load target written as `.±N` (N bytes from this instruction) or
// a number (the offset from PC, which reads this instruction + 8).
func TestParseArm32PcRelativeTargets() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 9)
	g[0] = arm32MemGolden{line: "b .+8", word: 0xEA000000}
	g[1] = arm32MemGolden{line: "beq .-4", word: 0x0AFFFFFD}
	g[2] = arm32MemGolden{line: "b 8", word: 0xEA000002}
	g[3] = arm32MemGolden{line: "b #8", word: 0xEA000002}
	g[4] = arm32MemGolden{line: "b .", word: 0xEAFFFFFE}
	g[5] = arm32MemGolden{line: "blne .", word: 0x1BFFFFFE}
	g[6] = arm32MemGolden{line: "ldr r0, .+12", word: 0xE59F0004}
	g[7] = arm32MemGolden{line: "ldr r1, .", word: 0xE51F1008}
	g[8] = arm32MemGolden{line: "ldrh r1, .+16", word: 0xE1DF10B8}
	return arm32CheckGoldens(g)
}

// Targets out of reach -- a branch more than 32 MiB away, a load more than 4095 bytes
// from PC -- and a malformed `(PLT)` suffix are errors.
func TestParseArm32PcRelativeTargetRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 6)
	bad[0] = "b .+0x4000000"
	bad[1] = "b .-0x2000000"
	bad[2] = "b 2"
	bad[3] = "ldr r2, .-4092"
	bad[4] = "b ext(PLT"
	bad[5] = "bl ext+4(PLT)"
	return arm32CheckRejects(bad)
}

// `bl ext(PLT)` is `bl ext`, as clang takes it: the -8 baked in (EBFFFFFE) and one
// call relocation; to a local label the suffix changes nothing either, the branch
// resolved in place.
func TestParseArm32BranchPltSuffix() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, ".global ext\nbl ext(PLT)", "EBFFFFFE ", 1)
	e = arm32PoolCase(e, "b a\nbl a(PLT)\na:", "EA000000 EBFFFFFF ", 0)
	return e
}

// ADR, each word as clang assembles it: a number (the offset from PC, '#' optional), a
// location `.±N`, a label behind or ahead in this section (resolved in place), and an
// external symbol, whose REL addend -- PC's read-ahead and any `+N` -- is baked into an
// ADD / SUB with an R_ARM_ALU_PC_G0 relocation.
func TestParseArm32Adr() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 6)
	g[0] = arm32MemGolden{line: "adr r0, 8", word: 0xE28F0008}
	g[1] = arm32MemGolden{line: "adr r0, #0x100", word: 0xE28F0C01}
	g[2] = arm32MemGolden{line: "adr r0, 0x100", word: 0xE28F0C01}
	g[3] = arm32MemGolden{line: "adr r0, #-8", word: 0xE24F0008}
	g[4] = arm32MemGolden{line: "adr r0, .+16", word: 0xE28F0008}
	g[5] = arm32MemGolden{line: "adreq r3, .-8", word: 0x024F3010}
	var r testing.TestResult = arm32CheckGoldens(g)
	if len(r) != 0 { return r }
	var e @[]char = ""
	var z4 *[]readonly char = "00000000 00000000 00000000 00000000 "
	var z8 @[]char = buf.Concat(z4, z4)
	e = arm32PoolCase(e, "a:\n.zero 32\nadr r0, a", buf.Concat(z8, "E24F0028 "), 0)
	e = arm32PoolCase(e, ".zero 36\nadr r1, b\n.zero 40\nb:",
			buf.Concat(buf.Concat(z8, "00000000 E28F1024 "), buf.Concat(z8, "00000000 00000000 ")), 0)
	e = arm32PoolCase(e, "a:\nadr r2, a+12\nadreq r3, a-4", "E28F2004 024F3010 ", 0)
	e = arm32PoolCase(e, ".global ext\nadr r0, ext", "E24F0008 ", 1)
	e = arm32PoolCase(e, ".global ext\nadr r0, ext+16", "E28F0008 ", 1)
	e = arm32PoolCase(e, ".global ext\nadr r0, ext-4", "E24F000C ", 1)
	return e
}

// Forms clang rejects: a missing or memory operand, trailing text, and a distance with
// no rotated 8-bit encoding (a number, or a label 0x102 bytes from PC).
func TestParseArm32AdrRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 4)
	bad[0] = "adr r0"
	bad[1] = "adr r0, [r1]"
	bad[2] = "adr r0, ext junk"
	bad[3] = "adr r0, 0x101"
	var r testing.TestResult = arm32CheckRejects(bad)
	if len(r) != 0 { return r }
	var p @Parser = arm32Source("adr r0, b\n.zero 0x106\nb:")
	if !p.HasError && !p.Asm.HasError { return fail("an ADR to a label 0x102 from PC was accepted") }
	return ""
}

// A label difference is a number, but clang reads it as an absolute address where a
// branch or ADR target stands (a relocation against *ABS*), not an offset: an error, as on
// AArch64 -- directly, through a constant, or as `.+8-.`.
func TestParseArm32DiffTargetRejects() testing.TestResult {
	var src @[]*[]readonly char = make_slice(*[]readonly char, 5)
	src[0] = "l1: nop\nl2: nop\nb l2-l1"
	src[1] = "l1: nop\nl2: nop\nbl l2-l1"
	src[2] = "l1: nop\nl2: nop\nadr r0, l2-l1"
	src[3] = "l1: nop\nl2: nop\nN = l2-l1\nb N"
	src[4] = "b .+8-."
	for i := 0; i < len(src); i++ {
		var p @Parser = arm32Source(src[i])
		if !p.HasError && !p.Asm.HasError { return fail(buf.Concat(src[i], ": accepted")) }
	}
	return ""
}

// An ADR number is read as clang reads it, as a 32-bit value: `#0xff000000` is `sub r0,
// pc, #0x1000000` (E24F0401).  A symbol takes clang's `(PLT)` suffix (E24F0008 and an
// R_ARM_ALU_PC_G0 relocation).  -2^31 (which clang encodes as `sub r0, pc, #0`) and
// anything wider than 32 bits (which clang truncates) are errors.
func TestParseArm32AdrWideNumbers() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 1)
	g[0] = arm32MemGolden{line: "adr r0, #0xff000000", word: 0xE24F0401}
	var r testing.TestResult = arm32CheckGoldens(g)
	if len(r) != 0 { return r }
	var e @[]char = ""
	e = arm32PoolCase(e, ".global ext\nadr r0, ext(PLT)", "E24F0008 ", 1)
	if len(e) != 0 { return e }
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 4)
	bad[0] = "adr r0, #0x80000000"
	bad[1] = "adr r0, #-0x80000000"
	bad[2] = "adr r0, #0x100000000"
	bad[3] = "adr r0, ext+4(PLT)"
	return arm32CheckRejects(bad)
}

// A shift amount or an SVC / BKPT immediate wider than the encoding is an error, as in
// clang -- never truncated to its low bits on a host whose int is 32 bits.
func TestParseArm32WideAmountRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 5)
	bad[0] = "lsl r0, r1, #0x100000002"
	bad[1] = "mov r0, r1, lsl #0x100000002"
	bad[2] = "ldr r0, [r1, r2, lsl #0x100000002]"
	bad[3] = "svc #0x100000005"
	bad[4] = "bkpt #0x100000005"
	return arm32CheckRejects(bad)
}

// POP of SP, the register it writes back, is an error, as in clang.
func TestParseArm32PopSpRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 2)
	bad[0] = "pop {sp}"
	bad[1] = "pop {r0, sp}"
	return arm32CheckRejects(bad)
}

// PUSH / POP of one register is the STR / LDR clang emits, of several STMDB / LDM.
func TestParseArm32PushPopForms() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 6)
	g[0] = arm32MemGolden{line: "push {r0}", word: 0xE52D0004}
	g[1] = arm32MemGolden{line: "pop {r0}", word: 0xE49D0004}
	g[2] = arm32MemGolden{line: "pusheq {lr}", word: 0x052DE004}
	g[3] = arm32MemGolden{line: "pop {pc}", word: 0xE49DF004}
	g[4] = arm32MemGolden{line: "push {r4, lr}", word: 0xE92D4010}
	g[5] = arm32MemGolden{line: "pop {r4, pc}", word: 0xE8BD8010}
	return arm32CheckGoldens(g)
}
