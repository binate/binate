func TestParseArm32ArchDirective() testing.TestResult {
	var p @Parser
	p, _ = newArm32Parser()
	p.Arch = ARCH_UNKNOWN // reset
	p.ParseLine(".arch arm32")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Arch != ARCH_ARM32 {
		return fail("arch not set to ARM32")
	}
	return ""
}

// TestParseArm32BaremetalConstructs runs the instruction/label shapes the
// bare-metal runtime files (runtime/baremetal_arm32/crt0.s + semihost.s) rely
// on — dot-less forward/backward local-label branches, an external `.global`
// bl that must survive as a relocation, movw/movt immediates for the stack
// pointer, push/pop register lists, and post-indexed ldrb — through the full
// parse -> arm32.ResolveFixups -> Finalize pipeline.
// A regression here would break bnc's `bnas`-assembled arm32-baremetal link.
func TestParseArm32BaremetalConstructs() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newArm32Parser()
	p.ParseLine(".global bn_entry") // external reference -> undefined symbol
	p.ParseLine(".global _start")
	p.ParseLine("_start:")
	p.ParseLine("movw sp, #0x0000") // hardcoded stack top (crt0.s)
	p.ParseLine("movt sp, #0x4100")
	p.ParseLine("bl bn_entry") // external call -> relocation
	p.ParseLine("cmp r2, #0")
	p.ParseLine("beq done") // forward local branch
	p.ParseLine("loop:")
	p.ParseLine("ldrb r4, [r1], #1") // post-indexed addressing
	p.ParseLine("subs r2, r2, #1")
	p.ParseLine("bne loop") // backward local branch
	p.ParseLine("done:")
	p.ParseLine("push {r0, r4}")
	p.ParseLine("pop {r0, r4}")
	p.ParseLine("bx lr")
	if p.HasError { return fail(p.ErrorMsg) }
	arm32.ResolveFixups(a)
	if !a.Finalize() || a.HasError {
		return fail("baremetal-shape assembly failed to finalize")
	}
	// The two same-section local branches (beq done / bne loop) resolve in
	// place; only the external `bl bn_entry` is left as a relocation.
	if a.NumRelocs != 1 {
		return fail("expected exactly 1 relocation (the external bl)")
	}
	return ""
}

// An immediate with its rotation written out (`#imm8, #rot`) is encoded as
// written, and a number without '#' is an immediate, each as clang assembles
// it.
func TestParseArm32ImmediateForms() testing.TestResult {
	var g @[]arm32MemGolden = make_slice(arm32MemGolden, 9)
	g[0] = arm32MemGolden{line: "mov r0, #255, #30", word: 0xE3A00FFF}
	g[1] = arm32MemGolden{line: "mov r0, #1, #2", word: 0xE3A00101}
	g[2] = arm32MemGolden{line: "mov r0, #4, #2", word: 0xE3A00104}
	g[3] = arm32MemGolden{line: "movs r0, #255, #2", word: 0xE3B001FF}
	g[4] = arm32MemGolden{line: "add r0, r1, #255, #30", word: 0xE2810FFF}
	g[5] = arm32MemGolden{line: "cmp r0, #1, #2", word: 0xE3500101}
	g[6] = arm32MemGolden{line: "svc 5", word: 0xEF000005}
	g[7] = arm32MemGolden{line: "svc 0x123456", word: 0xEF123456}
	g[8] = arm32MemGolden{line: "mov r0, 5", word: 0xE3A00005}
	return arm32CheckGoldens(g)
}

// A written rotation clang rejects -- a value past 8 bits, an odd rotation --
// is an error.
func TestParseArm32ImmediateRotationRejects() testing.TestResult {
	var bad @[]*[]readonly char = make_slice(*[]readonly char, 2)
	bad[0] = "mov r0, #256, #2"
	bad[1] = "mov r0, #1, #3"
	return arm32CheckRejects(bad)
}

// clang's general operand -- a saturate width, a bitfield's lsb or width, a pack's amount, SVC /
// BKPT's, MOVW / MOVT's, a shift instruction's amount, a branch or ADR target -- takes no `-`,
// `+` or `~` at its start without `#` or `$` ("unexpected token in operand"), and makes a
// prefixed expression that starts with `-` and comes to 0 a negative zero: out of each such
// operand's range, ADR's SUB form.  The data-processing immediate, the shift and rotation amounts
// after a shift name and BFC / BFI's lsb have their own parsers in clang, without that rule.  SVC
// and BKPT want a constant, not a label difference.  (armGateIs is in arm32_feat_test.bn.)
func TestArm32GeneralOperand() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "sbfx r0, r1, #-0, #8", "!operand must be an immediate in the range [0,31]")
	e = armGateIs(e, "", "ubfx r0, r1, $-1+1, #8", "!operand must be an immediate in the range [0,31]")
	e = armGateIs(e, "", "usat16 r0, #-0, r1", "!operand must be an immediate in the range [0,15]")
	e = armGateIs(e, "", "usat r0, #-0+1, r1", "E6E10011")
	e = armGateIs(e, "", "sbfx r0, r1, #8, #-0+8", "E7A70451")
	e = armGateIs(e, "", "ssat r0, (8), r1", "E6A70011")
	e = armGateIs(e, "", "ssat r0, -1+9, r1", "!unexpected token in operand")
	e = armGateIs(e, "", "sbfx r0, r1, 8, +8", "!unexpected token in operand")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, #-0", "!immediate value out of range")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, ~-5", "!unexpected token in operand")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, lsl +4", "!unexpected token in operand")
	e = armGateIs(e, "", "pkhbt r0, r1, r2, lsl #-0", "E6810012")
	e = armGateIs(e, "", "svc #-0", "!SVC immediate out of range")
	e = armGateIs(e, "", "svc #(-0)", "EF000000")
	e = armGateIs(e, "", "svc +1", "!unexpected token in operand")
	e = armGateIs(e, "", ".La: nop\n.Lb: svc #.Lb-.La", "!constant expression expected")
	e = armGateIs(e, "", "svc #.-.", "!constant expression expected")
	e = armGateIs(e, "", ".La:\n.Lb: bkpt #-(.Lb-.La)", "!constant expression expected")
	e = armGateIs(e, "", "bkpt #-1+1", "!BKPT immediate out of range")
	e = armGateIs(e, "", "bkpt -0", "!unexpected token in operand")
	e = armGateIs(e, "", "movw r0, #-0", "!MOVW / MOVT immediate out of range")
	e = armGateIs(e, "", "movw r0, #(-0)", "E3000000")
	e = armGateIs(e, "", "movt r0, +1", "!unexpected token in operand")
	e = armGateIs(e, "", "lsl r0, r1, #-0", "!LSL shift amount out of range")
	e = armGateIs(e, "", "lsl r0, r1, #(-0)", "E1A00001")
	e = armGateIs(e, "", "lsl r0, -0", "!unexpected token in operand")
	e = armGateIs(e, "", "b -8", "!unexpected token in operand")
	e = armGateIs(e, "", "b #-8", "EAFFFFFE")
	e = armGateIs(e, "", "b (-8)", "EAFFFFFE")
	e = armGateIs(e, "", "adr r0, #-0", "E24F0000")
	e = armGateIs(e, "", "adr pc, $-0", "E24FF000")
	e = armGateIs(e, "", "adreq r0, #-1+1", "024F0000")
	e = armGateIs(e, "", "adr r0, #(-0)", "E28F0000")
	e = armGateIs(e, "", "adr r0, +8", "!unexpected token in operand")
	e = armGateIs(e, "", "mov r0, #-0", "E3A00000")
	e = armGateIs(e, "", "mov r0, -1", "E3E00000")
	e = armGateIs(e, "", "mov r0, r1, lsl #-0", "E1A00001")
	e = armGateIs(e, "", "bfc r0, #-0, #8", "E7C7001F")
	e = armGateIs(e, "", "sxtb r0, r1, ror #-0", "E6AF0071")
	if len(e) > 0 { return fail(e) }
	return ""
}
