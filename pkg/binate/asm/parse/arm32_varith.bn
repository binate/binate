package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// The VFP's encodings of the three-same names it shares with NEON (arm32_neon3.bn), which clang
// matches with NEON's and MVE's: VADD, VSUB and VMUL (each with Vd, Vm for Vd, Vd, Vm too), VMLA
// and VMLS, and VFPv4's fused VFMA and VFMS, each .F32 on S registers, .F64 on D registers and
// ARMv8.2's .F16 on S registers (unconditional).

// arm32VarithMost is the most VFP encodings a name has (arm32VarithAddVfp).
const arm32VarithMost int = 6

// arm32VarithOp returns the VFP operation (vfp.ARITH_*) three-same name name (lowercase, split)
// names, or -1 for a name the VFP has not.
func arm32VarithOp(name *[]readonly char) int {
	if charsEqual(name, "vadd") { return vfp.ARITH_ADD }
	if charsEqual(name, "vsub") { return vfp.ARITH_SUB }
	if charsEqual(name, "vmul") { return vfp.ARITH_MUL }
	if charsEqual(name, "vmla") { return vfp.ARITH_MLA }
	if charsEqual(name, "vmls") { return vfp.ARITH_MLS }
	if charsEqual(name, "vfma") { return vfp.ARITH_FMA }
	if charsEqual(name, "vfms") { return vfp.ARITH_FMS }
	return -1
}

// arm32VarithAddVfp appends the VFP's encodings of three-same name name to list: .F32, .F64 and
// .F16 on three registers, and on two where the name has a two-operand form, needing VFPv2 (VFPv4
// for a fused one), double precision as well for .F64, and full FP16 for .F16.
func arm32VarithAddVfp(list @arm32MatchList, name *[]readonly char) {
	var op int = arm32VarithOp(name)
	if op < 0 { return }
	var base int = matchNeedVFP2
	if op == vfp.ARITH_FMA || op == vfp.ARITH_FMS { base = matchNeedVFP4 }
	var s int = matchKindS
	var d int = matchKindD
	var form int = matchFormVFP
	matchAdd(list, matchTypeF32, 0, matchOps(s, s, s), base, form)
	matchAdd(list, matchTypeF64, 0, matchOps(d, d, d), base | matchNeedDP, form)
	matchAdd(list, matchTypeF16, 0, matchOps(s, s, s), matchNeedFull16, form)
	if op != vfp.ARITH_ADD && op != vfp.ARITH_SUB && op != vfp.ARITH_MUL { return }
	matchAdd(list, matchTypeF32, 0, matchOps(s, s, 0), base, form)
	matchAdd(list, matchTypeF64, 0, matchOps(d, d, 0), base | matchNeedDP, form)
	matchAdd(list, matchTypeF16, 0, matchOps(s, s, 0), matchNeedFull16, form)
}

// arm32VarithEmit assembles VFP operation op (vfp.ARITH_*) under cond as encoding c, its operands
// items -- Vd, Vn, Vm, or Vd, Vm for Vd, Vd, Vm -- or sets clang's error for a .F16 one with a
// condition, which it reports as not predicable.
func arm32VarithEmit(p @Parser, op int, cond int, c arm32MatchCand, items @[]arm32MatchItem) {
	if c.t1 == matchTypeF16 && cond != arm32.COND_AL {
		setErr(p, "instruction is not predicable")
		return
	}
	var vd int = arm32CvtReg(items[0])
	var vn int = vd
	var vm int = arm32CvtReg(items[1])
	if arm32MatchKindAt(c.ops, 2) != 0 {
		vn = vm
		vm = arm32CvtReg(items[2])
	}
	vfp.Arith3(p.Asm, cond, op, arm32CvtSize(c.t1), vd, vn, vm)
}
