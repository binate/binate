package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// The VFP's data-processing encodings, which clang matches with NEON's and MVE's of the same names
// (arm32_vdp.bn): on three registers VADD, VSUB, VMUL, VNMUL and VDIV (each with Vd, Vm for Vd,
// Vd, Vm too), the multiply-accumulates VMLA, VMLS, VNMLA and VNMLS, VFPv4's fused VFMA, VFMS,
// VFNMA and VFNMS; on two VABS, VNEG, VSQRT (with no type too, sized by its registers), VCMP and
// VCMPE (Vd, #0 too) -- each .F32 on S registers, .F64 on D registers and ARMv8.2's .F16 on S
// registers (unconditional) -- and clang's instruction aliases fsubs / fsubd (VSUB), faddd (VADD)
// and fcmpzs / fcmpzd (VCMP with #0), with no type.

// arm32VarithUnary is the operation (arm32VarithOp) of the first two-register instruction: the
// three-register ones are vfp.ARITH_*, the two-register ones arm32VarithUnary + vfp.UNARY_*.
const arm32VarithUnary int = vfp.ARITH_FMS + 1

// arm32VarithMost is the most VFP encodings a name has (arm32VarithAddVfp).
const arm32VarithMost int = 6

// arm32VarithOp returns the VFP operation (arm32VarithUnary) name (lowercase, split) names, or -1
// for a name the VFP has not.
func arm32VarithOp(name *[]readonly char) int {
	var u int = arm32VarithUnary
	var names @[]*[]readonly char = @[]*[]readonly char{"vadd", "vsub", "vmul", "vnmul", "vdiv",
			"vmla", "vmls", "vnmla", "vnmls", "vfma", "vfms", "vfnma", "vfnms", "vabs", "vneg", "vsqrt",
			"vcmp", "vcmpe", "fsubs", "fsubd", "faddd", "fcmpzs", "fcmpzd"}
	var ops @[]int = @[]int{vfp.ARITH_ADD, vfp.ARITH_SUB, vfp.ARITH_MUL, vfp.ARITH_NMUL, vfp.ARITH_DIV,
			vfp.ARITH_MLA, vfp.ARITH_MLS, vfp.ARITH_NMLA, vfp.ARITH_NMLS, vfp.ARITH_FMA, vfp.ARITH_FMS,
			vfp.ARITH_FNMA, vfp.ARITH_FNMS, u + vfp.UNARY_ABS, u + vfp.UNARY_NEG, u + vfp.UNARY_SQRT,
			u + vfp.UNARY_CMP, u + vfp.UNARY_CMPE, vfp.ARITH_SUB, vfp.ARITH_SUB, vfp.ARITH_ADD,
			u + vfp.UNARY_CMP, u + vfp.UNARY_CMP}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return ops[i] }
	}
	return -1
}

// arm32VarithAddVfp appends the VFP's encodings of name (lowercase, split) to list: .F32 on S
// registers, .F64 on D and .F16 on S, on three registers (and two for VADD, VSUB, VMUL, VNMUL,
// VDIV) or two, Vd, #0 too for VCMP / VCMPE, and no type on S or D for VSQRT; or a pre-UAL
// instruction alias's, with no type.  Each needs VFPv2 (VFPv4 for a fused one), double precision
// as well for .F64 and D registers, full FP16 for .F16.
func arm32VarithAddVfp(list @arm32MatchList, name *[]readonly char) {
	var op int = arm32VarithOp(name)
	if op < 0 { return }
	var u int = arm32VarithUnary
	var base int = matchNeedVFP2
	if op == vfp.ARITH_FMA || op == vfp.ARITH_FMS || op == vfp.ARITH_FNMA || op == vfp.ARITH_FNMS {
		base = matchNeedVFP4
	}
	var dp int = base | matchNeedDP
	var full int = matchNeedFull16
	var s int = matchKindS
	var d int = matchKindD
	var z int = matchKindZero
	var form int = matchFormVFP
	if name[0] == 'f' {
		var r int = s
		var need int = base
		if name[len(name) - 1] == 'd' {
			r = d
			need = dp
		}
		if op == u + vfp.UNARY_CMP {
			matchAdd(list, 0, 0, matchOps(r, 0, 0), need, form)
		} else {
			matchAdd(list, 0, 0, matchOps(r, r, r), need, form)
		}
		return
	}
	if op < u {
		matchAdd(list, matchTypeF32, 0, matchOps(s, s, s), base, form)
		matchAdd(list, matchTypeF64, 0, matchOps(d, d, d), dp, form)
		matchAdd(list, matchTypeF16, 0, matchOps(s, s, s), full, form)
		var two bool = op == vfp.ARITH_ADD || op == vfp.ARITH_SUB || op == vfp.ARITH_MUL ||
				op == vfp.ARITH_NMUL || op == vfp.ARITH_DIV
		if !two { return }
		matchAdd(list, matchTypeF32, 0, matchOps(s, s, 0), base, form)
		matchAdd(list, matchTypeF64, 0, matchOps(d, d, 0), dp, form)
		matchAdd(list, matchTypeF16, 0, matchOps(s, s, 0), full, form)
		return
	}
	matchAdd(list, matchTypeF32, 0, matchOps(s, s, 0), base, form)
	matchAdd(list, matchTypeF64, 0, matchOps(d, d, 0), dp, form)
	matchAdd(list, matchTypeF16, 0, matchOps(s, s, 0), full, form)
	if op == u + vfp.UNARY_SQRT {
		matchAdd(list, 0, 0, matchOps(s, s, 0), base, form)
		matchAdd(list, 0, 0, matchOps(d, d, 0), dp, form)
	}
	if op >= u + vfp.UNARY_CMP {
		matchAdd(list, matchTypeF32, 0, matchOps(s, z, 0), base, form)
		matchAdd(list, matchTypeF64, 0, matchOps(d, z, 0), dp, form)
		matchAdd(list, matchTypeF16, 0, matchOps(s, z, 0), full, form)
	}
}

// arm32VarithEmit assembles VFP operation op (arm32VarithOp) under cond as encoding c, its operands
// items -- Vd, Vn, Vm, or Vd, Vm for Vd, Vd, Vm; Vd, Vm; Vd and #0 (or Vd alone) -- or sets clang's
// error for a .F16 one with a condition, which it reports as not predicable.  An encoding with no
// type has the size of its registers.
func arm32VarithEmit(p @Parser, op int, cond int, c arm32MatchCand, items @[]arm32MatchItem) {
	var size int = arm32CvtSize(c.t1)
	if size == 0 {
		size = 32
		if items[0].kind == matchItemD { size = 64 }
	}
	if size == 16 && cond != arm32.COND_AL {
		setErr(p, "instruction is not predicable")
		return
	}
	var vd int = arm32CvtReg(items[0])
	var u int = arm32VarithUnary
	if op < u {
		var vn int = vd
		var vm int = arm32CvtReg(items[1])
		if arm32MatchKindAt(c.ops, 2) != 0 {
			vn = vm
			vm = arm32CvtReg(items[2])
		}
		vfp.Arith3(p.Asm, cond, op, size, vd, vn, vm)
		return
	}
	var second int = arm32MatchKindAt(c.ops, 1)
	if second == 0 || second == matchKindZero {
		vfp.CmpZero(p.Asm, cond, op == u + vfp.UNARY_CMPE, size, vd)
		return
	}
	vfp.Arith2(p.Asm, cond, op - u, size, vd, arm32CvtReg(items[1]))
}
