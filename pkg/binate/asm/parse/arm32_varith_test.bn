package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The VFP's names have its operations, NEON's and MVE's own none; a name's encodings: six for
// VADD, VSUB, VMUL, VNMUL and VDIV (three types, on three registers and on two) and VCMP (with
// #0), five for VSQRT (with no type), three for the others, one for an instruction alias
// (fsubs, fcmpzd), none for a NEON-only name.
func TestArm32VarithEncodings() testing.TestResult {
	if arm32VarithOp("vadd") != vfp.ARITH_ADD || arm32VarithOp("vfms") != vfp.ARITH_FMS {
		return fail("a shared name's VFP operation is wrong")
	}
	if arm32VarithOp("vhadd") != -1 || arm32VarithOp("vmlas") != -1 || arm32VarithOp("fadds") != -1 {
		return fail("a name the VFP has not has a VFP operation")
	}
	var cmp int = arm32VarithUnary + vfp.UNARY_CMP
	if arm32VarithOp("vnmul") != vfp.ARITH_NMUL || arm32VarithOp("fcmpzd") != cmp {
		return fail("a VFP name's operation is wrong")
	}
	var names @[]*[]readonly char = @[]*[]readonly char{"vadd", "vsub", "vmul", "vmla", "vmls", "vfma",
			"vfms", "vhadd", "vnmul", "vdiv", "vnmla", "vfnms", "vabs", "vsqrt", "vcmpe", "fsubs", "fcmpzd"}
	var counts @[]int = @[]int{6, 6, 6, 3, 3, 3, 3, 0, 6, 6, 3, 3, 3, 5, 6, 1, 1}
	for i := 0; i < len(names); i++ {
		var list @arm32MatchList = make(arm32MatchList)
		list.c = make_slice(arm32MatchCand, arm32VarithMost)
		arm32VarithAddVfp(list, names[i])
		if list.n != counts[i] { return fail(buf.Concat("wrong count of VFP encodings: ", names[i])) }
	}
	return ""
}

// The VFP's forms of the shared names as clang assembles them: .F32 / .F64 / .F16 (and clang's .f
// and .d) on three registers, and on two for VADD / VSUB / VMUL; a condition kept; `.w` ignored;
// VFMA / VFMS with VFPv4; VMLS with a condition after it (vmlseq), and the q alias vaddq.
func TestParseArm32VarithVfp() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vadd.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vsub.f64 d0, d1, d2", "EE310B42")
	e = armGateIs(e, "", "vmul.f32 s0, s1", "EE200A20")
	e = armGateIs(e, "", "vadd.f64 d16, d17", "EE700BA1")
	e = armGateIs(e, "", "vmla.f32 s0, s1, s2", "EE000A81")
	e = armGateIs(e, "", "vmlseq.f64 d0, d1, d2", "0E010B42")
	e = armGateIs(e, "", "vmlseq.f32 s0, s1, s2", "0E000AC1")
	e = armGateIs(e, ".fpu vfpv4", "vfma.f32 s0, s1, s2", "EEA00A81")
	e = armGateIs(e, ".fpu vfpv4", "vfms.f64 d0, d1, d2", "EEA10B42")
	e = armGateIs(e, h, "vadd.f16 s0, s1", "EE300920")
	e = armGateIs(e, h, "vmla.f16 s0, s1, s2", "EE000981")
	e = armGateIs(e, h, "vfma.f16 s0, s1, s2", "EEA00981")
	e = armGateIs(e, "", "vaddeq.f32 s0, s1, s2", "0E300A81")
	e = armGateIs(e, "", "vmul.f s0, s1, s2", "EE200A81")
	e = armGateIs(e, "", "vsub.d d0, d1, d2", "EE310B42")
	e = armGateIs(e, "", "vadd.w.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vaddq.f32 s0, s1, s2", "EE300A81")
	return e
}

// What clang does not take of them, with its message: .F16 with a condition (not predicable);
// two operands for VMLA or VFMA; VFMA without VFPv4, VADD without VFPv2, .F64 without double
// precision; a type that is the other registers' only; no type; too many operands; MVE's VMLAS
// and VFMAS on S registers; an `s` after the name.
func TestParseArm32VarithRejects() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	e = armMsgIs(e, h, "vaddeq.f16 s0, s1, s2", "instruction is not predicable")
	e = armMsgIs(e, "", "vmla.f32 s0, s1", "too few operands for instruction")
	e = armMsgIs(e, "", "vfma.f64 d0, d1", "invalid instruction")
	e = armMsgIs(e, "", "vfma.f32 s0, s1, s2", "instruction requires: VFP4")
	e = armMsgIs(e, "", "vfmseq.f32 s0, s1, s2", "instruction requires: VFP4")
	e = armMsgIs(e, ".fpu vfpv3", "vfma.f64 d0, d1, d2", "instruction requires: VFP4")
	e = armMsgIs(e, ".fpu none", "vadd.f32 s0, s1, s2", "instruction requires: VFP2")
	e = armMsgIs(e, ".fpu vfpv3xd", "vadd.f64 d0, d1, d2",
			"instruction requires: double precision VFP")
	e = armMsgIs(e, "", "vadd.f64 s0, s1, s2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vadd s0, s1, s2", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmla s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, "", "vmul.f32 s0, s1, s2, s3", "too many operands for instruction")
	e = armMsgIs(e, "", "vmlas.f32 s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, "", "vfmas.f32 s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, "", "vmulseq.f32 s0, s1, s2", armQuote("vmul", flags))
	return e
}

// An operand list clang does not take, with its message: too few or too many operands, a stray
// or doubled comma, a token after an operand, an operand that is no register of the type's kind
// (out of range, written with a leading zero, a core register; the last of three, which is also
// one too many for VADD's Vd, Vm, two near misses; a D register as VABS.F32's last, which its
// NEON form takes after a D register; a compare's operand that is no register and no zero, which
// misses both VCMP's register and its #0), Vd, Vm where only Vd, Vn, Vm is.
func TestParseArm32VfpOperandRejects() testing.TestResult {
	var e @[]char = ""
	var s *[]readonly char = "!operand must be a register in range [s0, s31]"
	var several *[]readonly char = "!invalid instruction, any one of the following would fix this:"
	e = armGateIs(e, "", "vadd.f32", "!too few operands for instruction")
	e = armGateIs(e, "", "vdiv.f32 s0", "!too few operands for instruction")
	e = armGateIs(e, "", "vneg.f32 s0", "!too few operands for instruction")
	e = armGateIs(e, "", "vmla.f32 s0, s1", "!too few operands for instruction")
	e = armGateIs(e, "", "vnmla.f64 d0, d1", "!too few operands for instruction")
	e = armGateIs(e, ".fpu vfpv4", "vfma.f32 s0, s1", "!too few operands for instruction")
	e = armGateIs(e, "", "vfma.f32 s0, s1", "!invalid instruction")
	e = armGateIs(e, "", "vadd.f32 s0, s1, s2, s3", "!too many operands for instruction")
	e = armGateIs(e, "", "vabs.f32 s0, s1, s2", "!too many operands for instruction")
	e = armGateIs(e, "", "vsqrt.f32 s0, s1, s2", "!too many operands for instruction")
	e = armGateIs(e, "", "vcmp.f32 s0, #0.0, s1", "!too many operands for instruction")
	e = armGateIs(e, "", "vcmp.f32 s0, #0, #0", "!too many operands for instruction")
	e = armGateIs(e, "", "vadd.f32 s0, s1, s2,", "!unexpected token in operand")
	e = armGateIs(e, "", "vadd.f32 s0, s1,, s2", "!unexpected token in operand")
	e = armGateIs(e, "", "vadd.f32 s0, s1, s2 s3", "!unexpected token in argument list")
	e = armGateIs(e, "", "vadd.f32 s01, s1, s2", s)
	e = armGateIs(e, "", "vadd.f32 s0, r1, s2", s)
	e = armGateIs(e, "", "vadd.f32 s0, s1, s32", several)
	e = armGateIs(e, "", "vadd.f32 s0, s1, d2", several)
	e = armGateIs(e, "", "vabs.f32 s0, d1", several)
	e = armGateIs(e, "", "vadd.f64 d0, d1, d32", several)
	e = armGateIs(e, "", "vadd.f64 d0, d1, s2", several)
	e = armGateIs(e, "", "vcmp.f64 d0, s1", several)
	e = armGateIs(e, "", "vcmp.f32 s0, lbl", several)
	e = armGateIs(e, "", "vcmp.f32 s0, #-(0)", several)
	e = armGateIs(e, "", "vcmp.f32 s0, -0", "!unexpected token in operand")
	e = armGateIs(e, "", "vcmp.f32 s0, #1.0", several)
	e = armGateIs(e, "", "vcmp.f32 s0, #+0.0", "EEB50A40")
	return e
}

// What clang's matcher reports for operands it does not take: "invalid instruction" for any
// operand error when a feature is missing too, and for several wrong operands (a written type the
// only thing wrong apart: "invalid operand for instruction"); one wrong operand's own message,
// D0 .. D15 its range without 32 D registers; .F16 with a condition and no full FP16 the missing
// feature.  A register's name is no VCMP zero with no `#`, even as a constant's (a near miss of
// both VCMP's forms); another constant's name is.
func TestParseArm32VfpNearMiss() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "!invalid instruction, any one of the following would fix this:"
	var d15 *[]readonly char = "!operand must be a register in range [d0, d15]"
	e = armGateIs(e, ".fpu none", "vmla.f32 s0, s1", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vadd.f64 d0", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vadd.f32 s0, s32, s1", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vcmp.f32 s0, #1", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vaddeq.f16 s0, s1, s2", "!instruction requires: full half-float")
	e = armGateIs(e, ".fpu none", "vadd.f16 s0, s1", "!instruction requires: full half-float")
	e = armGateIs(e, ".fpu vfpv3-d16", "vadd.f64 d16, d17", "!invalid instruction")
	e = armGateIs(e, ".fpu vfpv3-d16", "vadd.f64 d16, d17, d18", "!invalid instruction")
	e = armGateIs(e, ".fpu vfpv3-d16", "fsqrtd d16, d17", "!invalid instruction")
	e = armGateIs(e, ".fpu vfpv3-d16", "vnmul.f64 d0, d16", d15)
	e = armGateIs(e, ".fpu vfpv3-d16", "vadd.f64 d0, d32, d1", d15)
	e = armGateIs(e, ".fpu vfpv3-d16", "faddd d16, d1", d15)
	e = armGateIs(e, ".fpu vfpv3-d16", "vcmp.f64 d16, #0", d15)
	e = armGateIs(e, "", "vsqrt.f32 d0, d1", "!invalid operand for instruction")
	e = armGateIs(e, "", "fsubs d0, d1, d2", "!invalid instruction")
	e = armGateIs(e, "", "fcmpzd s0", "!operand must be a register in range [d0, d31]")
	e = armGateIs(e, ".set d1, 0", "vcmp.f32 s0, d1", several)
	e = armGateIs(e, ".set r1, 0", "vcmp.f32 s0, r1", several)
	e = armGateIs(e, ".set d1, 0", "vcmp.f32 s0, #d1", "EEB50A40")
	e = armGateIs(e, ".set zero, 0", "vcmp.f32 s0, zero", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #0.0+0", "!invalid sign in float literal")
	e = armGateIs(e, "", "vcmp.f32 s0, #(0", "!expected ')'")
	return e
}

// Each instruction is gated as clang gates it, with its message: VFPv2 (none on bare metal, after
// `.fpu none` or `nofp`), VFPv4 for the fused ones, double precision for .F64 (not after
// `.fpu vfpv3xd` or `fpv5-sp-d16`), 32 D registers for D16 .. D31 (not after `.fpu vfpv2` or
// `vfpv3-d16`; "invalid instruction" when a feature is missing too), full FP16 for .F16 (one
// of two near misses where the .F32 form, a type off, has its features).
func TestParseArm32VfpGates() testing.TestResult {
	var e @[]char = ""
	var nofp *[]readonly char = ".arch armv8-a\n.arch_extension nofp"
	e = armGateIs(e, ".fpu none", "vadd.f32 s0, s1, s2", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu none", "vadd.f64 d0, d1, d2",
			"!instruction requires: double precision VFP VFP2")
	e = armGateIs(e, ".fpu none", "vadd.f64 d16, d1, d2", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vfma.f64 d0, d1, d2",
			"!instruction requires: double precision VFP VFP4")
	e = armGateIs(e, nofp, "vadd.f64 d16, d1, d2", "!instruction requires: VFP2")
	e = armGateIs(e, nofp, "vcmp.f64 d0, #0", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu vfpv2", "vadd.f64 d16, d1, d2",
			"!operand must be a register in range [d0, d15]")
	e = armGateIs(e, ".fpu vfpv2", "vmla.f64 d0, d1, d15", "EE010B0F")
	e = armGateIs(e, ".fpu vfpv3-d16", "vnmla.f64 d0, d1, d16",
			"!operand must be a register in range [d0, d15]")
	e = armGateIs(e, ".fpu vfpv3xd", "vadd.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, ".fpu vfpv3xd", "vsqrt.f64 d0, d1", "!instruction requires: double precision VFP")
	e = armGateIs(e, ".fpu vfpv3xd", "vfma.f64 d0, d1, d2",
			"!instruction requires: double precision VFP VFP4")
	e = armGateIs(e, ".fpu vfpv3xd", "vadd.f64 d16, d1, d2", "!invalid instruction")
	e = armGateIs(e, ".fpu fpv5-sp-d16", "vfma.f32 s0, s1, s2", "EEA00A81")
	e = armGateIs(e, ".fpu fpv5-sp-d16", "vcmp.f64 d0, #0",
			"!instruction requires: double precision VFP")
	e = armGateIs(e, "", "vfma.f32 s0, s1, s2", "!instruction requires: VFP4")
	e = armGateIs(e, "", "vfnms.f64 d0, d1, d2", "!instruction requires: VFP4")
	e = armGateIs(e, "", "vfma.f16 s0, s1, s2", "!instruction requires: full half-float")
	e = armGateIs(e, ".fpu fp-armv8", "vadd.f16 s0, s1, s2",
			"!invalid instruction, any one of the following would fix this:")
	e = armGateIs(e, ".cpu cortex-a76", "vdiv.f16 s0, s1, s2", "EE800981")
	return e
}
