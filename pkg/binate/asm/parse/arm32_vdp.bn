package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"

// The VFP's and NEON's data-processing instructions and NEON's element and structure loads and
// stores, as clang takes them: each name's encodings -- NEON's three registers of the same length
// (arm32_neon3.bn) and of different lengths (arm32_neondiff.bn), two registers and a scalar
// (arm32_neonscalar.bn), shifts by an immediate (arm32_neonshift.bn) and two registers
// (arm32_neon2.bn), VEXT and VDUP (arm32_neonperm.bn), the loads and stores (arm32_neonldst.bn),
// the dot products and FP16 multiply-adds long (arm32_neondot.bn), the complex-number ones
// (arm32_neoncplx.bn), the BFloat16 and Int8 matrix ones (arm32_neonmm.bn), the three-register
// crypto ones (arm32_crypto.bn), the VFP's (arm32_varith.bn), MVE's as near misses -- matched in
// one list (arm32_match.bn), and the VFP's pre-UAL names as clang's aliases of them
// (arm32_vfp_preual.bn).  clang splits a mnemonic as it splits every mnemonic -- a condition off
// the end, then an `s` -- but for the names it keeps whole or ending in an `s` (arm32VdpSplit); an
// `s` it reads as a flag-setting suffix none of these takes.

// arm32VdpSplit splits name (lowercase, before its first `.`) as clang's splitMnemonic does: whole
// when it is one clang keeps whole (arm32VdpWhole), else a condition off the end, then an `s` (but
// for the names that end in one, arm32VdpKeepsS).  It returns the name, the condition and whether
// an `s` came off.
func arm32VdpSplit(name *[]readonly char) (@[]char, int, bool) {
	var out @[]char = buf.CopyStr(name)
	if arm32VdpWhole(name) { return out, arm32.COND_AL, false }
	var cond int = arm32.COND_AL
	if len(out) > 2 && parseArm32CondCode(out[len(out) - 2:len(out)]) >= 0 {
		cond = parseArm32CondCode(out[len(out) - 2:len(out)])
		out = out[0:len(out) - 2]
	}
	if len(out) > 1 && out[len(out) - 1] == 's' && !arm32VdpKeepsS(out) {
		return out[0:len(out) - 1], cond, true
	}
	return out, cond, false
}

// arm32VdpWhole reports whether clang's splitMnemonic keeps name (lowercase) whole, as one of the
// V and F names it knows end as a condition does or has none: VCEQ, VCLS, VMLS, VNMLS, VACGE,
// VCGE, VCLT, VACGT, VACLT, VACLE, VCGT, VCLE, VABAL, VMLAL, VPADAL, VQDMLAL, FMULS, VMAXNM,
// VMINNM, VCVTA .. VCVTM, VRINTA .. VRINTM, VSEL*, VINS, VMOVX, VDOT, VMMLA, VUDOT, VSDOT, VCMLA,
// VCADD, VFMAL, VFMSL.
func arm32VdpWhole(name *[]readonly char) bool {
	var names @[]*[]readonly char = @[]*[]readonly char{"vceq", "vcls", "vmls", "vnmls", "vacge",
			"vcge", "vclt", "vacgt", "vaclt", "vacle", "vcgt", "vcle", "vabal", "vmlal", "vpadal", "vqdmlal",
			"fmuls", "vmaxnm", "vminnm", "vcvta", "vcvtn", "vcvtp", "vcvtm", "vrinta", "vrintn", "vrintp",
			"vrintm", "vins", "vmovx", "vdot", "vmmla", "vudot", "vsdot", "vcmla", "vcadd", "vfmal", "vfmsl"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return true }
	}
	return len(name) >= 4 && charsEqual(name[0:4], "vsel")
}

// arm32VdpKeepsS reports whether name (lowercase, its condition off) is one of the V and F names
// clang knows end in an `s` it does not read as a flag-setting suffix: VABS, VCLS, VMLS, VMRS,
// VNMLS, VQABS, VRECPS, VRSQRTS, VFMS, VFNMS, VFMAS, VMLAS, and FLDS, FMRS, FSQRTS, FSUBS, FSTS,
// FCPYS, FDIVS, FMULS, FCMPS, FCMPZS, FCONSTS.
func arm32VdpKeepsS(name *[]readonly char) bool {
	var names @[]*[]readonly char = @[]*[]readonly char{"vabs", "vcls", "vmls", "vmrs", "vnmls",
			"vqabs", "vrecps", "vrsqrts", "vfms", "vfnms", "vfmas", "vmlas", "flds", "fmrs", "fsqrts",
			"fsubs", "fsts", "fcpys", "fdivs", "fmuls", "fcmps", "fcmpzs", "fconsts"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return true }
	}
	return false
}

// arm32VdpKnown reports whether name (lowercase, split) is an instruction of these: NEON's
// three-same names (arm32Neon3Name), its three-different-lengths ones (arm32NeonDiffOp), its shifts
// by an immediate (arm32NeonShiftOp), its two-register ones (arm32Neon2Op), VEXT and VDUP
// (arm32NeonPermOp), the VFP's (arm32VarithOp), NEON's loads and stores (arm32NeonLdStOp), the
// three-register crypto ones (arm32Crypto3Op), the dot products and FP16 multiply-adds long
// (arm32NeonDotOp), the complex-number ones (arm32NeonCplxOp) and the BFloat16 and Int8 matrix ones
// (arm32NeonMmOp).
func arm32VdpKnown(name *[]readonly char) bool {
	op, _, _ := arm32Neon3Name(name)
	ldst, _ := arm32NeonLdStOp(name)
	return op != 0 || arm32NeonDiffOp(name) > 0 || arm32NeonShiftOp(name) > 0 ||
			arm32Neon2Op(name) > 0 || arm32VarithOp(name) >= 0 || arm32NeonPermOp(name) > 0 || ldst > 0 ||
			arm32Crypto3Op(name) > 0 || arm32NeonDotOp(name) > 0 || arm32NeonCplxOp(name) > 0 ||
			arm32NeonMmOp(name) > 0
}

// arm32VdpStarts reports whether name (lowercase) starts with an instruction of these
// (arm32VdpKnown): clang reads an `s` after any name as a flag-setting suffix (vaddxs is 'vaddx'
// with one), and these take that error for the names that start with theirs.
func arm32VdpStarts(name *[]readonly char) bool {
	for n := len(name); n >= 4; n-- {
		if arm32VdpKnown(name[0:n]) { return true }
	}
	return false
}

// arm32VdpCands returns the encodings clang tries for name (lowercase, split; arm32VdpKnown): a
// three-same name's (arm32Neon3Cands, the VFP's among them), a three-different-lengths one's
// (arm32NeonDiffCands), a shift-by-immediate one's (arm32NeonShiftCands), VEXT's or VDUP's
// (arm32NeonPermCands), a load's or store's (arm32NeonLdStCands), a three-register crypto one's
// (arm32Crypto3Cands), a dot product's or FP16 multiply-add long's (arm32NeonDotCands), a
// complex-number one's (arm32NeonCplxCands), a BFloat16 or Int8 matrix one's (arm32NeonMmCands), or
// the VFP's (arm32VarithAddVfp) with NEON's and MVE's two-register ones (arm32Neon2Add) and
// modified immediates (arm32NeonImmAdd), in the order clang tries them.
func arm32VdpCands(name *[]readonly char) @arm32MatchList {
	op, set, ways := arm32Neon3Name(name)
	if op != 0 { return arm32Neon3Cands(name, set, ways) }
	ldst, _ := arm32NeonLdStOp(name)
	if ldst > 0 { return arm32NeonLdStCands(name) }
	if arm32Crypto3Op(name) > 0 { return arm32Crypto3Cands() }
	if arm32NeonDotOp(name) > 0 { return arm32NeonDotCands(name) }
	if arm32NeonCplxOp(name) > 0 { return arm32NeonCplxCands(name) }
	if arm32NeonMmOp(name) > 0 { return arm32NeonMmCands(name) }
	if arm32NeonDiffOp(name) > 0 { return arm32NeonDiffCands(name) }
	if arm32NeonShiftOp(name) > 0 { return arm32NeonShiftCands(name) }
	if arm32NeonPermOp(name) > 0 { return arm32NeonPermCands(name) }
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32VarithMost + arm32Neon2Most + arm32NeonImmMost)
	arm32VarithAddVfp(list, name)
	arm32Neon2Add(list, name)
	arm32NeonImmAdd(list, name)
	arm32MatchSort(list)
	return list
}

// parseArm32Vdp assembles a VFP or NEON data-processing instruction or a NEON load or store
// (arm32VdpKnown), or a pre-UAL name of one (parseArm32VfpPreUal), mnem the mnemonic as written
// and l the lexer after it, reporting whether mnem names one.
func parseArm32Vdp(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) < 4 { return false }
	var first char = arm32Lower(mnem[0])
	if first != 'v' && first != 'f' { return false }
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	if first == 'f' { return parseArm32VfpPreUal(p, l, lower, dot) }
	name, cond, carry := arm32VdpSplit(lower[0:dot])
	if carry {
		if !arm32VdpStarts(name) { return false }
		arm32VfpFlagsErr(p, name)
		return true
	}
	if arm32VdpUnpredicable(lower) && !arm32NeonUnconditional(p, name, cond) { return true }
	if arm32VdpNoCond(name) && !arm32NeonUnconditional(p, name, cond) { return true }
	if !arm32VdpKnown(name) { return false }
	arm32VdpMatch(p, l, name, cond, lower[dot:len(lower)])
	return true
}

// arm32VdpNoCond reports whether name (lowercase, split) is one clang takes no condition on, its
// error before the operands are read: VSDOT, VUDOT, VFMAL and VFMSL (arm32NeonDotOp), VCMLA and
// VCADD (arm32NeonCplxOp), and the BFloat16 and Int8 matrix ones (arm32NeonMmOp).
func arm32VdpNoCond(name *[]readonly char) bool {
	return arm32NeonDotOp(name) > 0 || arm32NeonCplxOp(name) > 0 || arm32NeonMmOp(name) > 0
}

// arm32VdpUnpredicable reports whether clang takes the mnemonic lower (lowercase, its suffixes too)
// as one that is never predicable, a condition split off it (whatever the name it leaves) the
// error before the operands are read: one that starts with vmull and ends with .p64 (vmulleq.p64;
// vmulle.p64, which is VMUL with LE, and vmullxeq.p64, no name at all, alike).
func arm32VdpUnpredicable(lower *[]readonly char) bool {
	var p64 bool = len(lower) >= 4 && charsEqual(lower[len(lower) - 4:len(lower)], ".p64")
	return p64 && len(lower) >= 5 && charsEqual(lower[0:5], "vmull")
}

// arm32VdpMatch assembles instruction name (lowercase, split; arm32VdpKnown) under cond, rest its
// `.` suffixes (lowercase), from its operands after l: the first of its encodings that matches,
// or clang's error.
func arm32VdpMatch(p @Parser, l Lexer, name *[]readonly char, cond int, rest *[]readonly char) {
	var types @[]int = make_slice(int, 3)
	nt, ok := arm32MatchSuffixes(p, rest, types)
	if !ok { return }
	var lists int = arm32NeonPermLists(p, name, cond, nt) | arm32NeonLdStLists(p, name, cond, nt)
	items, ni, read := arm32MatchOperandsVec(p, l, lists)
	if !read { return }
	var list @arm32MatchList = arm32VdpCands(name)
	var i int = arm32MatchRun(p, list, cond, types, nt, items, ni)
	if i < 0 { return }
	ldst, _ := arm32NeonLdStOp(name)
	if ldst > 0 {
		arm32NeonLdStEmit(p, name, cond, list.c[i], items)
		return
	}
	if arm32Crypto3Op(name) > 0 {
		arm32Crypto3Emit(p, name, items)
		return
	}
	if arm32NeonDotOp(name) > 0 {
		arm32NeonDotEmit(p, name, list.c[i], items)
		return
	}
	if arm32NeonCplxOp(name) > 0 {
		arm32NeonCplxEmit(p, name, list.c[i], items)
		return
	}
	if arm32NeonMmOp(name) > 0 {
		arm32NeonMmEmit(p, name, list.c[i], items)
		return
	}
	if arm32NeonPermOp(name) > 0 {
		arm32NeonPermEmit(p, name, cond, list.c[i], items)
		return
	}
	if list.c[i].form == matchFormVFP {
		arm32VarithEmit(p, arm32VarithOp(name), cond, list.c[i], items)
		return
	}
	if arm32NeonImmCand(list.c[i]) {
		arm32NeonImmEmit(p, name, cond, list.c[i], items)
		return
	}
	if arm32Neon2ZeroCand(name, list.c[i]) {
		arm32Neon2ZeroEmit(p, name, cond, list.c[i], items)
		return
	}
	if arm32NeonScalarCand(list.c[i]) {
		arm32NeonScalarEmit(p, name, cond, list.c[i], items)
		return
	}
	if arm32NeonShiftCand(name, list.c[i]) {
		arm32NeonShiftEmit(p, name, cond, list.c[i], items)
		return
	}
	if arm32Neon2Op(name) > 0 {
		arm32Neon2Emit(p, name, cond, list.c[i], items)
		return
	}
	var diff int = arm32NeonDiffOp(name)
	if diff > 0 {
		arm32NeonDiffEmit(p, name, diff, cond, list.c[i], items)
		return
	}
	op, _, ways := arm32Neon3Name(name)
	if op <= 0 {
		// Only NEON's three-same, three-different-lengths, by-scalar, shift and two-register
		// encodings are assembled here.
		setErr(p, "NEON (Advanced SIMD) instructions are not supported yet")
		return
	}
	arm32Neon3Emit(p, name, op, ways, cond, list.c[i], items)
}

// arm32VdpNone sets clang's error for a mnemonic that names no instruction, "invalid instruction",
// once the operands after l are read as clang reads them first (an error among them is the
// error).
func arm32VdpNone(p @Parser, l Lexer) {
	_, _, read := arm32MatchOperands(p, l)
	if read { setErr(p, "invalid instruction") }
}
