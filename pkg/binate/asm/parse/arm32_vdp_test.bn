package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each VFP data-processing instruction in each data type, as clang assembles it (VFPv4 for the
// fused ones, full FP16 for .F16): registers in any case, the type .F32 / .F / .F64 / .D / .F16 in
// any case, a condition before it, Vd, Vm for Vd, Vd, Vm where clang takes it, VSQRT with no type.
func TestParseArm32VfpForms() testing.TestResult {
	var e @[]char = ""
	var vfpHalf *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vadd.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vadd.f64 d0, d1, d2", "EE310B02")
	e = armGateIs(e, "", "vadd.f64 d16, d17, d31", "EE710BAF")
	e = armGateIs(e, "", "vadd.f32 s0, s1", "EE300A20")
	e = armGateIs(e, "", "VADD.F32 S0, S1, S2", "EE300A81")
	e = armGateIs(e, "", "vadd.f s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vadd.F s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vadd.d d0, d1, d2", "EE310B02")
	e = armGateIs(e, "", "vdiv.D d0, d1", "EE800B01")
	e = armGateIs(e, "", "vcmp.d d0, #0", "EEB50B40")
	e = armGateIs(e, "", "fsqrts.d d0, d1", "EEB10BC1")
	e = armGateIs(e, "", "vaddeq.f32 s0, s1, s2", "0E300A81")
	e = armGateIs(e, "", "vsub.f32 s31, s30, s29", "EE7FFA6E")
	e = armGateIs(e, "", "vsub.f32 s0, s1", "EE300A60")
	e = armGateIs(e, "", "vmul.f64 d1, d2, d3", "EE221B03")
	e = armGateIs(e, "", "vmul.f32 s0, s1", "EE200A20")
	e = armGateIs(e, "", "vnmul.f32 s0, s1, s2", "EE200AC1")
	e = armGateIs(e, "", "vnmul.f32 s0, s1", "EE200A60")
	e = armGateIs(e, "", "vnmul.f64 d16, d1, d2", "EE610B42")
	e = armGateIs(e, "", "vdiv.f64 d0, d1, d2", "EE810B02")
	e = armGateIs(e, "", "vdiv.f32 s0, s1", "EE800A20")
	e = armGateIs(e, "", "vmla.f32 s0, s1, s2", "EE000A81")
	e = armGateIs(e, "", "vmls.f64 d0, d1, d2", "EE010B42")
	e = armGateIs(e, "", "vnmla.f32 s0, s1, s2", "EE100AC1")
	e = armGateIs(e, "", "vnmls.f64 d0, d1, d2", "EE110B02")
	e = armGateIs(e, "", "vmlsls.f32 s0, s1, s2", "9E000AC1")
	e = armGateIs(e, "", "vnmlsls.f64 d0, d1, d2", "9E110B02")
	e = armGateIs(e, ".fpu vfpv4", "vfma.f32 s0, s1, s2", "EEA00A81")
	e = armGateIs(e, ".fpu vfpv4", "vfms.f64 d0, d1, d2", "EEA10B42")
	e = armGateIs(e, ".fpu vfpv4", "vfnma.f64 d0, d1, d2", "EE910B42")
	e = armGateIs(e, ".fpu vfpv4", "vfnms.f32 s0, s1, s2", "EE900A81")
	e = armGateIs(e, ".fpu vfpv4", "vfmsls.f32 s0, s1, s2", "9EA00AC1")
	e = armGateIs(e, ".fpu vfpv4", "vfnmsls.f32 s0, s1, s2", "9E900A81")
	e = armGateIs(e, "", "vabs.f32 s0, s1", "EEB00AE0")
	e = armGateIs(e, "", "vabsls.f32 s0, s1", "9EB00AE0")
	e = armGateIs(e, "", "vneg.f64 d0, d1", "EEB10B41")
	e = armGateIs(e, "", "vneg.f s0, s1", "EEB10A60")
	e = armGateIs(e, "", "vsqrt.f32 s0, s1", "EEB10AE0")
	e = armGateIs(e, "", "vsqrteq.f64 d0, d1", "0EB10BC1")
	e = armGateIs(e, "", "vsqrtvs.f32 s0, s1", "6EB10AE0")
	e = armGateIs(e, "", "vsqrt s0, s1", "EEB10AE0")
	e = armGateIs(e, "", "vsqrt d16, d17", "EEF10BE1")
	e = armGateIs(e, "", "vsqrteq s0, s1", "0EB10AE0")
	e = armGateIs(e, "", "vcmp.f32 s0, s1", "EEB40A60")
	e = armGateIs(e, "", "vcmpe.f64 d0, d1", "EEB40BC1")
	e = armGateIs(e, "", "vcmpeq.f32 s0, s1", "0EB40A60")
	e = armGateIs(e, "", "vcmpeeq.f32 s0, s1", "0EB40AE0")
	e = armGateIs(e, "", "vdivhs.f64 d0, d1, d2", "2E810B02")
	e = armGateIs(e, "", "vnmulal.f32 s0, s1, s2", "EE200AC1")
	e = armGateIs(e, vfpHalf, "vadd.f16 s0, s1, s2", "EE300981")
	e = armGateIs(e, vfpHalf, "vsub.f16 s31, s30, s29", "EE7FF96E")
	e = armGateIs(e, vfpHalf, "vadd.f16 s0, s1", "EE300920")
	e = armGateIs(e, vfpHalf, "vmla.f16 s0, s1, s2", "EE000981")
	e = armGateIs(e, vfpHalf, "vnmls.f16 s0, s1, s2", "EE100981")
	e = armGateIs(e, vfpHalf, "vfnma.f16 s0, s1, s2", "EE9009C1")
	e = armGateIs(e, vfpHalf, "vabs.F16 s0, s1", "EEB009E0")
	e = armGateIs(e, vfpHalf, "vsqrt.f16 s0, s1", "EEB109E0")
	e = armGateIs(e, vfpHalf, "vcmpe.f16 s0, s1", "EEB409E0")
	e = armGateIs(e, vfpHalf, "vcmp.f16 s0, #0", "EEB50940")
	return e
}

// VCMP / VCMPE compare with zero as clang writes it: a constant expression that comes to 0 after
// `#` (`#0x0`, `#(0)`, `#1-1`, `#+0`, `# 0`) or with none, a floating-point zero in it reading as
// 0 (`#0.0`, `#(-0.0)`, `#0.0*1`); not clang's negative zero (`#-0`, `#-0.0`, `#-(0.0)`), another
// floating-point literal (each then a near miss of VCMP's register and of its #0), a sign or a
// floating-point literal with no `#`.
func TestParseArm32VfpCompareZero() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "!invalid instruction, any one of the following would fix this:"
	e = armGateIs(e, "", "vcmp.f32 s0, #0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #0.0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #0.0e0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f64 d0, #0.000", "EEB50B40")
	e = armGateIs(e, "", "vcmpe.f64 d0, #0", "EEB50BC0")
	e = armGateIs(e, "", "vcmpe.f32 s0, #0", "EEB50AC0")
	e = armGateIs(e, "", "vcmp.f32 s0, 0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #0x0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #(0)", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #1-1", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #+0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, # 0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f64 d16, #0", "EEF50B40")
	e = armGateIs(e, "", "vcmp.f32 s17, #0", "EEF58A40")
	e = armGateIs(e, "", "vcmpe.f64 d31, #0.0", "EEF5FBC0")
	e = armGateIs(e, "", "vcmp.f32 s0, #(0.0)", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #((0.0))", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #(-0.0)", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #(0.0)+0", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #0.0*1", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, (0.0)", "EEB50A40")
	e = armGateIs(e, "", "vcmp.f32 s0, #-(0.0)", several)
	e = armGateIs(e, "", "vcmp.f32 s0, #(0.5)", several)
	e = armGateIs(e, "", "vcmp.f32 s0, #1", several)
	e = armGateIs(e, "", "vcmp.f32 s0, #-0", several)
	e = armGateIs(e, "", "vcmp.f32 s0, #-0.0", several)
	e = armGateIs(e, "", "vcmp.f32 s0, $0", several)
	e = armGateIs(e, "", "vcmp.f32 s0, 0.0", "!unexpected token in operand")
	e = armGateIs(e, "", "vcmp.f32 s0, d1", several)
	return e
}

// `.w` anywhere among a mnemonic's suffixes is no suffix, as clang takes it; `.n` is its error.
// After a pre-UAL name: none of them after a plain one; `.w` after fsubs, fsubd, fcmpzs and
// fcmpzd, but no type; `.w` and a type after fsqrts and fsqrtd, which are VSQRT with no type.
func TestParseArm32VfpSuffixes() testing.TestResult {
	var e @[]char = ""
	var narrow *[]readonly char = "!instruction with .n (narrow) qualifier not allowed in arm mode"
	e = armGateIs(e, "", "vadd.w.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vaddeq.w.f32 s0, s1, s2", "0E300A81")
	e = armGateIs(e, "", "vadd.w.w.f32 s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vadd.F32.W s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "vsqrt.w.f64 d0, d1", "EEB10BC1")
	e = armGateIs(e, "", "vcmp.w.f32 s0, #0", "EEB50A40")
	e = armGateIs(e, "", "vadd.w s0, s1, s2", "!invalid operand for instruction")
	e = armGateIs(e, "", "vadd.n.f32 s0, s1, s2", narrow)
	e = armGateIs(e, "", "vadd.f32.n s0, s1, s2", narrow)
	e = armGateIs(e, "", "fsubs.w s0, s1, s2", "EE300AC1")
	e = armGateIs(e, "", "fsubseq.w s0, s1, s2", "0E300AC1")
	e = armGateIs(e, "", "fcmpzs.w s0", "EEB50A40")
	e = armGateIs(e, "", "fcmpzdeq.w d1", "0EB51B40")
	e = armGateIs(e, "", "fsubs.f32 s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, "", "fsubs.n s0, s1, s2", narrow)
	e = armGateIs(e, "", "fsqrts.f64 d0, d1", "EEB10BC1")
	e = armGateIs(e, "", "fsqrtdeq s0, s1", "0EB10AE0")
	e = armGateIs(e, "", "fsqrts d16, d17", "EEF10BE1")
	e = armGateIs(e, "", "fsqrts.w d16, d17", "EEF10BE1")
	e = armGateIs(e, "", "fsqrts.32 s0, s1", "!invalid operand for instruction")
	e = armGateIs(e, "", "fadds.w s0, s1, s2", "!instruction 'fadd' can not set flags")
	e = armGateIs(e, "", "fmuls.w s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, "", "faddd.w d0, d1, d2", "!invalid instruction")
	return e
}

// A mnemonic clang does not take: an `s` after the name, no type (VSQRT apart), two types, one
// that is no float type, a condition after the type, a condition on .F16.
func TestParseArm32VfpMnemonicRejects() testing.TestResult {
	var e @[]char = ""
	var vfpHalf *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vadds.f32 s0, s1, s2", "!instruction 'vadd' can not set flags")
	e = armGateIs(e, "", "vaddseq.f32 s0, s1, s2", "!instruction 'vadd' can not set flags")
	e = armGateIs(e, "", "vabss.f32 s0, s1", "!instruction 'vabs' can not set flags")
	e = armGateIs(e, "", "vmlss.f32 s0, s1, s2", "!instruction 'vmls' can not set flags")
	e = armGateIs(e, "", "vcmpes.f32 s0, s1", "!instruction 'vcmpe' can not set flags")
	e = armGateIs(e, "", "vaddeqs.f32 s0, s1, s2", "!instruction 'vaddeq' can not set flags")
	e = armGateIs(e, "", "vabsss.f32 s0, s1", "!instruction 'vabss' can not set flags")
	e = armGateIs(e, "", "vaddxs.f32 s0, s1, s2", "!instruction 'vaddx' can not set flags")
	e = armGateIs(e, "", "vmlas.f32 s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, "", "vfmas.f32 s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, "", "vadd s0, s1, s2", "!invalid operand for instruction")
	e = armGateIs(e, "", "vdiv d0, d1, d2", "!invalid operand for instruction")
	e = armGateIs(e, "", "vmla s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, "", "vneg s0, s1", "!invalid instruction")
	e = armGateIs(e, "", "vcmp s0, s1", "!invalid instruction")
	e = armGateIs(e, "", "vadd.f32.f32 s0, s1, s2", "!invalid instruction")
	e = armGateIs(e, "", "vadd.32 s0, s1, s2", "!invalid operand for instruction")
	e = armGateIs(e, "", "vadd.d s0, s1, s2", "!invalid operand for instruction")
	e = armGateIs(e, "", "vadd.f32eq s0, s1, s2", "!invalid operand for instruction")
	e = armGateIs(e, vfpHalf, "vaddeq.f16 s0, s1, s2", "!instruction is not predicable")
	return e
}

// clang's split of a mnemonic: the names it keeps whole (vmls, fmuls, vsel*), a condition off the
// end (vmlseq; vmlals is vmla with LS; fmacs is fma with CS), then an `s` (but for the names that
// end in one: vmlas, fsubs).  The names known and the names that start with one.
func TestArm32VdpSplit() testing.TestResult {
	var heads @[]*[]readonly char = @[]*[]readonly char{"vmls", "vmlseq", "vmlss", "vmlas", "vmlals",
			"fmacs", "fmuls", "fsubseq", "vselgt", "vfmseq", "vaddeqs"}
	var names @[]*[]readonly char = @[]*[]readonly char{"vmls", "vmls", "vmls", "vmlas", "vmla", "fma",
			"fmuls", "fsubs", "vselgt", "vfms", "vaddeq"}
	var conds @[]int = @[]int{arm32.COND_AL, arm32.COND_EQ, arm32.COND_AL, arm32.COND_AL,
			arm32.COND_LS, arm32.COND_CS, arm32.COND_AL, arm32.COND_EQ, arm32.COND_AL, arm32.COND_EQ,
			arm32.COND_AL}
	var carries @[]bool = @[]bool{false, false, true, false, false, false, false, false, false, false,
			true}
	for i := 0; i < len(heads); i++ {
		name, cond, carry := arm32VdpSplit(heads[i])
		if !charsEqual(name, names[i]) || cond != conds[i] || carry != carries[i] {
			return fail(buf.Concat("a mnemonic is split wrongly: ", heads[i]))
		}
	}
	if !arm32VdpKnown("vhadd") || !arm32VdpKnown("vdiv") || !arm32VdpKnown("faddd") ||
			arm32VdpKnown("vmov") || arm32VdpKnown("vmaxnm") {
		return fail("the instructions known are wrong")
	}
	if !arm32VdpStarts("vaddx") || !arm32VdpStarts("vmaxnm") || arm32VdpStarts("vmovx") ||
			arm32VdpStarts("vcvt") {
		return fail("the names that start with a known one are wrong")
	}
	return ""
}

// An `s` after a name that starts with one of these is clang's flag-setting error, naming what is
// before the `s`: a NEON one, VMAXNM and VDIV with an `s` and one more, a condition before the
// `s`.
func TestParseArm32VdpFlags() testing.TestResult {
	var e @[]char = ""
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	e = armMsgIs(e, "", "vhaddxs.s8 d0, d1, d2", armQuote("vhaddx", flags))
	e = armMsgIs(e, "", "vmaxnmss.f32 s0, s1, s2", armQuote("vmaxnms", flags))
	e = armMsgIs(e, "", "vdivss.f32 s0, s1, s2", armQuote("vdivs", flags))
	e = armMsgIs(e, "", "vnmlaeqs.f32 s0, s1, s2", armQuote("vnmlaeq", flags))
	e = armMsgIs(e, "", "vsqrteqs s0, s1", armQuote("vsqrteq", flags))
	e = armMsgIs(e, "", "vcmpes.f32 s0, s1", armQuote("vcmpe", flags))
	return e
}
