package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"

// The VFP data-processing instructions (asm/arm32/vfp), as clang takes them: VADD / VSUB / VMUL /
// VNMUL / VDIV, the multiply-accumulates VMLA / VMLS / VNMLA / VNMLS, VFPv4's fused VFMA / VFMS /
// VFNMA / VFNMS, VABS / VNEG / VSQRT and VCMP / VCMPE (with a register or #0), each with one data
// type -- .F32 (or .F) on S registers, .F64 on D registers, ARMv8.2's .F16 on S registers and
// unconditional -- `.w` anywhere among the suffixes, and the pre-UAL names clang keeps (fadds,
// faddd, .., fcmpzs, fcmpzd).  VADD, VSUB, VMUL, VNMUL and VDIV also take Vd, Vm for Vd, Vd, Vm;
// VSQRT with no type is .F32 on S registers and .F64 on D registers.  Each is gated by the FP
// features as clang gates it (arm32_vfp_ops.bn).

// arm32VfpUnary is the index (arm32VfpName) of the first two-register instruction: the
// three-register ones are vfp.ARITH_*, the two-register ones arm32VfpUnary + vfp.UNARY_*.
const arm32VfpUnary int = vfp.ARITH_FMS + 1

// arm32VfpName returns the name of VFP data-processing instruction idx (arm32VfpUnary), or "".
func arm32VfpName(idx int) *[]readonly char {
	if idx == vfp.ARITH_MLA { return "vmla" }
	if idx == vfp.ARITH_MLS { return "vmls" }
	if idx == vfp.ARITH_NMLS { return "vnmls" }
	if idx == vfp.ARITH_NMLA { return "vnmla" }
	if idx == vfp.ARITH_MUL { return "vmul" }
	if idx == vfp.ARITH_NMUL { return "vnmul" }
	if idx == vfp.ARITH_ADD { return "vadd" }
	if idx == vfp.ARITH_SUB { return "vsub" }
	if idx == vfp.ARITH_DIV { return "vdiv" }
	if idx == vfp.ARITH_FNMS { return "vfnms" }
	if idx == vfp.ARITH_FNMA { return "vfnma" }
	if idx == vfp.ARITH_FMA { return "vfma" }
	if idx == vfp.ARITH_FMS { return "vfms" }
	if idx == arm32VfpUnary + vfp.UNARY_ABS { return "vabs" }
	if idx == arm32VfpUnary + vfp.UNARY_NEG { return "vneg" }
	if idx == arm32VfpUnary + vfp.UNARY_SQRT { return "vsqrt" }
	if idx == arm32VfpUnary + vfp.UNARY_CMP { return "vcmp" }
	if idx == arm32VfpUnary + vfp.UNARY_CMPE { return "vcmpe" }
	return ""
}

// arm32VfpBase returns the index (arm32VfpName) of the instruction name names, in any case, or -1.
func arm32VfpBase(name *[]readonly char) int {
	for i := 0; i < arm32VfpUnary + vfp.UNARY_CMPE + 1; i++ {
		if mnemIs(name, arm32VfpName(i)) { return i }
	}
	return -1
}

// arm32VfpStarts reports whether name starts with a VFP data-processing instruction's name, in
// any case.
func arm32VfpStarts(name *[]readonly char) bool {
	for i := 0; i < arm32VfpUnary + vfp.UNARY_CMPE + 1; i++ {
		var n *[]readonly char = arm32VfpName(i)
		if len(name) >= len(n) && mnemIs(name[0:len(n)], n) { return true }
	}
	return false
}

// arm32VfpMnem is a VFP data-processing mnemonic as clang reads it (parseArm32Vfp).
type arm32VfpMnem struct {
	idx   int // the instruction (arm32VfpName)
	size  int // its data size, 16, 32 or 64; 0 for VSQRT with none, sized by its registers
	cond  int // its condition
	typed bool // the size is a type suffix written after the name
	zero  bool // a pre-UAL compare with zero (fcmpzs, fcmpzd), whose one operand is Vd
	pair  bool // takes Vd, Vm for Vd, Vd, Vm
}

// The pre-UAL names' sorts (arm32VfpAlias): a plain one takes no condition and no suffix; one of
// fsubs, fsubd, fcmpzs and fcmpzd may have a condition and `.w`; fsqrts and fsqrtd are VSQRT with
// no type, which may have a condition, `.w` and a type.
const (
	vfpAliasNone int = iota
	vfpAliasPlain
	vfpAliasCond
	vfpAliasSqrt
)

// arm32VfpAlias returns the pre-UAL name head is (the mnemonic before its first `.`, in any case)
// as an instruction (with idx, size, cond, zero and pair set), and its sort (vfpAlias*).
func arm32VfpAlias(head *[]readonly char) (arm32VfpMnem, int) {
	var m arm32VfpMnem
	m.cond = arm32.COND_AL
	if len(head) < 5 || arm32Lower(head[0]) != 'f' { return m, vfpAliasNone }
	var names @[]*[]readonly char = @[]*[]readonly char{"fadds", "faddd", "fsubs", "fsubd", "fmuls",
			"fmuld", "fdivs", "fdivd", "fmacs", "fmacd", "fnegs", "fnegd", "fsqrts", "fsqrtd", "fcmps",
			"fcmpd", "fcmpzs", "fcmpzd"}
	var u int = arm32VfpUnary
	var index @[]int = @[]int{vfp.ARITH_ADD, vfp.ARITH_ADD, vfp.ARITH_SUB, vfp.ARITH_SUB,
			vfp.ARITH_MUL, vfp.ARITH_MUL, vfp.ARITH_DIV, vfp.ARITH_DIV, vfp.ARITH_MLA, vfp.ARITH_MLA,
			u + vfp.UNARY_NEG, u + vfp.UNARY_NEG, u + vfp.UNARY_SQRT, u + vfp.UNARY_SQRT, u + vfp.UNARY_CMP,
			u + vfp.UNARY_CMP, u + vfp.UNARY_CMP, u + vfp.UNARY_CMP}
	for i := 0; i < len(names); i++ {
		var name *[]readonly char = names[i]
		var sort int = vfpAliasPlain
		if i == 2 || i == 3 || i >= 16 { sort = vfpAliasCond }
		if i == 12 || i == 13 { sort = vfpAliasSqrt }
		if !mnemIs(head, name) {
			if sort == vfpAliasPlain || len(head) != len(name) + 2 || !mnemIs(head[0:len(name)], name) {
				continue
			}
			m.cond = parseArm32CondCode(head[len(name):len(head)])
			if m.cond < 0 {
				m.cond = arm32.COND_AL
				continue
			}
		}
		m.idx = index[i]
		m.size = 32
		if i % 2 == 1 { m.size = 64 }
		if sort == vfpAliasSqrt { m.size = 0 }
		m.zero = i >= 16
		m.pair = i <= 1 || (i >= 4 && i <= 7)
		return m, sort
	}
	return m, vfpAliasNone
}

// arm32VfpHead returns the instruction head names (arm32VfpName; head a mnemonic before its first
// `.`) and its condition, as clang splits it: the whole a name (vmls), else a condition off the
// end, then a name.  The index is -1 for none, -2 for vmlas and vfmas, which clang takes as names
// it has not, and -3 for a name with an `s` clang reads as a flag-setting suffix it can not take
// (vadds, vaddeqs, vabsss; the name it read before the `s` returned too).
func arm32VfpHead(head *[]readonly char) (int, int, *[]readonly char) {
	var i int = arm32VfpBase(head)
	if i >= 0 { return i, arm32.COND_AL, "" }
	var cond int = arm32.COND_AL
	var name *[]readonly char = head
	if len(head) > 2 {
		var c int = parseArm32CondCode(head[len(head) - 2:len(head)])
		if c >= 0 {
			cond = c
			name = head[0:len(head) - 2]
		}
	}
	i = arm32VfpBase(name)
	if i >= 0 { return i, cond, "" }
	if mnemIs(name, "vmlas") || mnemIs(name, "vfmas") { return -2, cond, "" }
	if len(name) > 1 && arm32Lower(name[len(name) - 1]) == 's' {
		var before *[]readonly char = name[0:len(name) - 1]
		if arm32VfpStarts(before) { return -3, cond, before }
	}
	return -1, arm32.COND_AL, ""
}

// arm32VfpType returns the data size the type suffix t names (no `.`): 16, 32 (f32 or f) or 64,
// in any case, or -1 for one that is no float type.
func arm32VfpType(t *[]readonly char) int {
	if mnemIs(t, "f16") { return 16 }
	if mnemIs(t, "f32") || mnemIs(t, "f") { return 32 }
	if mnemIs(t, "f64") { return 64 }
	return -1
}

// arm32VfpSuffixType reads the `.` suffixes of a VFP mnemonic, rest (from its first `.`): `.w`,
// in any case, is no suffix; `.n` is clang's error.  It returns the data type among them (without
// its `.`; "" for none), how many there are, and whether there is no `.n`, setting the error if
// there is.
func arm32VfpSuffixType(p @Parser, rest *[]readonly char) (*[]readonly char, int, bool) {
	var t *[]readonly char = ""
	var n int = 0
	var start int = 1
	for i := 1; i <= len(rest); i++ {
		if i < len(rest) && rest[i] != '.' { continue }
		var part *[]readonly char = rest[start:i]
		start = i + 1
		if mnemIs(part, "w") { continue }
		if mnemIs(part, "n") {
			setErr(p, "instruction with .n (narrow) qualifier not allowed in arm mode")
			return "", 0, false
		}
		t = part
		n = n + 1
	}
	return t, n, true
}

// arm32VfpSuffixes reads the `.` suffixes of a VFP mnemonic as arm32VfpSuffixType does, returning
// the data size of the one type among them (0 for none, -1 for more than one, -2 for one that is
// no float type) and whether there is no `.n`.
func arm32VfpSuffixes(p @Parser, rest *[]readonly char) (int, bool) {
	t, n, ok := arm32VfpSuffixType(p, rest)
	if !ok { return 0, false }
	if n == 0 { return 0, true }
	if n > 1 { return -1, true }
	var size int = arm32VfpType(t)
	if size < 0 { return -2, true }
	return size, true
}

// How a mnemonic's head names an instruction (arm32VfpNamed): not at all, as is or with a
// condition, or with an `s` clang reads as a flag-setting suffix the instruction can not take.
const (
	vfpNamedNone int = iota
	vfpNamedOk
	vfpNamedFlags
)

// arm32VfpNamed reports how head (a mnemonic before its first `.`) names the instruction name, in
// any case, as clang splits it (vfpNamed*): name itself, or name with a condition after it (the
// condition returned); or, after any condition, name and more ending in an `s` (the name before
// the `s` returned too: vmrss, vmoveqs).
func arm32VfpNamed(head *[]readonly char, name *[]readonly char) (int, int, *[]readonly char) {
	if mnemIs(head, name) { return vfpNamedOk, arm32.COND_AL, "" }
	var cond int = arm32.COND_AL
	var rest *[]readonly char = head
	if len(head) > 2 {
		var c int = parseArm32CondCode(head[len(head) - 2:len(head)])
		if c >= 0 {
			cond = c
			rest = head[0:len(head) - 2]
		}
	}
	if mnemIs(rest, name) { return vfpNamedOk, cond, "" }
	if len(rest) > len(name) && arm32Lower(rest[len(rest) - 1]) == 's' &&
			mnemIs(rest[0:len(name)], name) {
		return vfpNamedFlags, cond, rest[0:len(rest) - 1]
	}
	return vfpNamedNone, arm32.COND_AL, ""
}

// arm32VfpFlagsErr sets clang's error for an `s` suffix after the instruction name.
func arm32VfpFlagsErr(p @Parser, name *[]readonly char) {
	setErr(p,
			buf.Concat(buf.Concat("instruction '", name), "' can not set flags, but 's' suffix specified"))
}

// arm32VfpReg returns the number of the S (letter 's') or D ('d') register name names, in any
// case and without a leading zero, or -1.
func arm32VfpReg(name *[]readonly char, letter char) int {
	if len(name) < 2 || len(name) > 3 || arm32Lower(name[0]) != letter { return -1 }
	var n int = 0
	for i := 1; i < len(name); i++ {
		if name[i] < '0' || name[i] > '9' || (i == 1 && name[i] == '0' && len(name) > 2) { return -1 }
		n = n * 10 + cast(int, name[i]) - cast(int, '0')
	}
	if n > 31 { return -1 }
	return n
}

// parseArm32Vfp assembles a VFP data-processing instruction, mnem the mnemonic as written (its
// `.` suffixes included) and l the lexer after it, reporting whether mnem names one.
func parseArm32Vfp(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) == 0 || (arm32Lower(mnem[0]) != 'v' && arm32Lower(mnem[0]) != 'f') { return false }
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		if mnem[i] == '.' { dot = i }
	}
	var head *[]readonly char = mnem[0:dot]
	m, sort := arm32VfpAlias(head)
	if sort != vfpAliasNone {
		return parseArm32VfpAliasSuffixes(p, l, m, sort, head, mnem[dot:len(mnem)])
	}
	idx, cond, flags := arm32VfpHead(head)
	if idx == -1 { return false }
	if idx == -2 {
		setErr(p, "invalid instruction")
		return true
	}
	if idx == -3 {
		setErr(p,
				buf.Concat(buf.Concat("instruction '", flags), "' can not set flags, but 's' suffix specified"))
		return true
	}
	m.idx = idx
	m.cond = cond
	m.pair = idx >= vfp.ARITH_MUL && idx <= vfp.ARITH_DIV
	size, ok := arm32VfpSuffixes(p, mnem[dot:len(mnem)])
	if !ok { return true }
	if size == 0 && idx != arm32VfpUnary + vfp.UNARY_SQRT {
		if m.pair {
			setErr(p, "invalid operand for instruction")
		} else {
			setErr(p, "invalid instruction")
		}
		return true
	}
	if size == -1 {
		setErr(p, "invalid instruction")
		return true
	}
	if size == -2 {
		setErr(p, "invalid operand for instruction")
		return true
	}
	m.size = size
	m.typed = size != 0
	parseArm32VfpOperands(p, l, m)
	return true
}

// parseArm32VfpAliasSuffixes assembles the pre-UAL instruction m of sort (vfpAlias*), head its
// name and rest its `.` suffixes, as clang takes them: none after a plain name (clang reads the
// `s` of fadds, fmacs or fnegs then as a flag-setting suffix), `.w` after the others, and one
// type after fsqrts or fsqrtd.  It reports true, the mnemonic being one.
func parseArm32VfpAliasSuffixes(p @Parser, l Lexer, m arm32VfpMnem, sort int, head *[]readonly char,
		rest *[]readonly char) bool {
	if len(rest) > 0 && sort == vfpAliasPlain {
		if mnemIs(head, "fadds") || mnemIs(head, "fmacs") || mnemIs(head, "fnegs") {
			setErr(p,
					buf.Concat(buf.Concat("instruction '", head[0:len(head) - 1]),
							"' can not set flags, but 's' suffix specified"))
		} else {
			setErr(p, "invalid instruction")
		}
		return true
	}
	size, ok := arm32VfpSuffixes(p, rest)
	if !ok { return true }
	if size != 0 && sort == vfpAliasCond {
		setErr(p, "invalid instruction")
		return true
	}
	if size == -1 {
		setErr(p, "invalid instruction")
		return true
	}
	if size == -2 {
		setErr(p, "invalid operand for instruction")
		return true
	}
	if size > 0 {
		m.size = size
		m.typed = true
	}
	parseArm32VfpOperands(p, l, m)
	return true
}
