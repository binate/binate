package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"

// arm32VfpRange returns clang's message for an operand that is no register of size's kind, or a D
// register past those there are: an S register for 32 bits (or 16), a D register for 64, D0 ..
// D15 without 32 D registers (armFpD32).
func arm32VfpRange(p @Parser, size int) *[]readonly char {
	if size != 64 { return "operand must be a register in range [s0, s31]" }
	if p.Arm32FP & armFpD32 == 0 { return "operand must be a register in range [d0, d15]" }
	return "operand must be a register in range [d0, d31]"
}

// What parseArm32VfpZero found: VCMP's zero (vfpZeroOk), an operand clang reads that is not
// zero, with no error set (vfpZeroWrong), or an error, set (vfpZeroError).
const (
	vfpZeroOk int = iota
	vfpZeroWrong
	vfpZeroError
)

// parseArm32VfpZero parses VCMP's #0 at tok, as clang takes it: a constant expression that comes
// to 0, after `#` or with none (not starting with a sign then, nor a floating-point literal), but
// not clang's negative zero (`#-0`, `#-0.0`); a floating-point zero in it is 0 (`#0.0`, `#(0.0)`,
// `(0.0)`), and any other floating-point literal no zero (Parser.ExprZeroReals).  A register's
// name, written with no `#`, is no zero either.  It returns the lexer and the token after it and
// what it found (vfpZero*).
func parseArm32VfpZero(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind == TOK_FLOAT {
		setErr(p, "unexpected token in operand")
		return l, tok, vfpZeroError
	}
	if tok.Kind == TOK_DOLLAR || (tok.Kind == TOK_IDENT && arm32RegisterName(tok.Text)) {
		return l, tok, vfpZeroWrong
	}
	var name bool = tok.Kind == TOK_IDENT
	if tok.Kind == TOK_HASH {
		var next Token
		_, next = LexNext(l)
		name = next.Kind == TOK_IDENT
	}
	var r ExprResult
	var signed bool = arm32SignedStart(tok)
	p.ExprZeroReals = true
	l, tok, r = parseArm32OperandExpr(p, l, tok)
	p.ExprZeroReals = false
	if !r.Ok {
		// clang reads a sign with no `#` as no operand, a name or a floating-point literal as the
		// wrong one.
		if !signed && (name || charsEqual(r.Err, "invalid operand for instruction")) {
			return l, tok, vfpZeroWrong
		}
		var fallback *[]readonly char = "invalid operand for instruction"
		if signed { fallback = "unexpected token in operand" }
		setErr(p, exprErr(r, fallback))
		return l, tok, vfpZeroError
	}
	if r.FromDiff || r.Pending || r.Val != 0 || len(r.Sym) != 0 { return l, tok, vfpZeroWrong }
	return l, tok, vfpZeroOk
}

// arm32VfpMissing returns, as clang names them, the FP features VFP data-processing instruction
// idx on data of size bits needs that are not in effect, or "": full FP16 for .F16 ("full
// half-float"); VFPv4 for the fused multiply-adds, VFPv2 for the rest; double precision for .F64
// too ("double precision VFP VFP2").
func arm32VfpMissing(p @Parser, idx int, size int) @[]char {
	var fp uint64 = p.Arm32FP
	if size == 16 {
		if fp & armFpFullFP16 != 0 { return "" }
		return buf.CopyStr("full half-float")
	}
	var base uint64 = armFpVFP2SP
	var name *[]readonly char = "VFP2"
	if idx >= vfp.ARITH_FNMS && idx <= vfp.ARITH_FMS {
		base = armFpVFP4D16SP
		name = "VFP4"
	}
	var missing @[]char = ""
	if size == 64 && fp & armFpDP == 0 { missing = buf.CopyStr("double precision VFP") }
	if fp & base == 0 {
		if len(missing) > 0 { missing = buf.Concat(missing, " ") }
		missing = buf.Concat(missing, name)
	}
	return missing
}

// parseArm32VfpOperands assembles VFP data-processing instruction m from its operands after l:
// registers, as written, and VCMP's zero; arm32VfpJudge decides what clang makes of them.
func parseArm32VfpOperands(p @Parser, l Lexer, m arm32VfpMnem) {
	var most int = 2
	if m.idx < arm32VfpUnary { most = 3 }
	if m.zero { most = 1 }
	var compare bool = m.idx >= arm32VfpUnary + vfp.UNARY_CMP
	var texts @[]@[]char = make_slice(@[]char, 3)
	var n int = 0
	var zeroAt int = -1
	var zeroWrong bool = false
	var cut bool = false
	var tooMany bool = false
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF {
		if n == most {
			tooMany = true
			break
		}
		var letter char = 's'
		if m.size == 64 { letter = 'd' }
		var reg bool = tok.Kind == TOK_IDENT && arm32VfpReg(tok.Text, letter) >= 0
		if compare && n == 1 && !reg {
			var found int
			l, tok, found = parseArm32VfpZero(p, l, tok)
			if found == vfpZeroError { return }
			zeroAt = 1
			n = 2
			if found == vfpZeroWrong {
				zeroWrong = true
				cut = true
				break
			}
		} else if tok.Kind == TOK_IDENT {
			texts[n] = buf.CopyStr(tok.Text)
			n = n + 1
			l, tok = LexNext(l)
		} else {
			// Not a register's name: the operand clang's matcher fails on; read no further.
			n = n + 1
			cut = true
			break
		}
		if tok.Kind == TOK_EOF { break }
		if tok.Kind != TOK_COMMA {
			setErr(p, "unexpected token in argument list")
			return
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
			setErr(p, "unexpected token in operand")
			return
		}
	}
	if m.size == 0 {
		m.size = 32
		if n > 0 && arm32VfpReg(texts[0], 'd') >= 0 { m.size = 64 }
	}
	var count *[]readonly char = ""
	if tooMany {
		count = "too many operands for instruction"
	} else if !cut && n < most && !(most == 3 && n == 2 && m.pair) {
		count = "too few operands for instruction"
	}
	arm32VfpJudge(p, m, texts, n, zeroAt, zeroWrong, count)
}

// arm32VfpJudge assembles VFP data-processing instruction m from its n operands -- texts the
// registers as written ("" for an operand that is none), zeroAt VCMP's zero (-1 for none),
// zeroWrong when that is no zero, count clang's message for too few or too many ("" for neither)
// -- or sets clang's error, as its matcher reports one: when the instruction needs a feature that
// is not in effect, any operand error is "invalid instruction", and the missing features
// otherwise (arm32VfpMissing); a .F16 one with a condition is not predicable; one wrong operand
// is its own error, several "invalid instruction" (or "invalid operand for instruction" when a
// written type is the only thing wrong, every register the other kind).
func arm32VfpJudge(p @Parser, m arm32VfpMnem, texts @[]@[]char, n int, zeroAt int, zeroWrong bool,
		count *[]readonly char) {
	var missing @[]char = arm32VfpMissing(p, m.idx, m.size)
	if m.size == 16 && m.cond != arm32.COND_AL {
		if len(missing) > 0 {
			setErr(p, "instruction requires: full half-float")
		} else {
			setErr(p, "instruction is not predicable")
		}
		return
	}
	if len(count) > 0 {
		if len(missing) > 0 {
			setErr(p, "invalid instruction")
		} else {
			setErr(p, count)
		}
		return
	}
	var letter char = 's'
	var other char = 'd'
	if m.size == 64 {
		letter = 'd'
		other = 's'
	}
	var regs @[]int = make_slice(int, 3)
	var bad int = 0
	var message *[]readonly char = ""
	var swapped bool = true
	for i := 0; i < n; i++ {
		if i == zeroAt {
			if zeroWrong {
				bad = bad + 1
				message = "invalid operand for instruction"
				swapped = false
			}
			continue
		}
		var r int = -1
		if len(texts[i]) > 0 { r = arm32VfpReg(texts[i], letter) }
		if r < 0 || (m.size == 64 && r >= 16 && p.Arm32FP & armFpD32 == 0) {
			bad = bad + 1
			message = arm32VfpRange(p, m.size)
		}
		if len(texts[i]) == 0 || arm32VfpReg(texts[i], other) < 0 { swapped = false }
		regs[i] = r
	}
	if bad > 0 {
		if len(missing) > 0 || (bad > 1 && !(m.typed && swapped)) {
			setErr(p, "invalid instruction")
		} else if bad > 1 {
			setErr(p, "invalid operand for instruction")
		} else {
			setErr(p, message)
		}
		return
	}
	if len(missing) > 0 {
		setErr(p, buf.Concat("instruction requires: ", missing))
		return
	}
	arm32VfpEmit(p, m, regs, n, zeroAt >= 0 || m.zero)
}

// arm32VfpEmit emits VFP data-processing instruction m with its n registers' numbers regs, zero
// for a compare with zero.
func arm32VfpEmit(p @Parser, m arm32VfpMnem, regs @[]int, n int, zero bool) {
	var first int = vfp.S0
	if m.size == 64 { first = vfp.D0 }
	if m.idx < arm32VfpUnary {
		var vn int = regs[1]
		var vm int = regs[2]
		if n == 2 {
			vn = regs[0]
			vm = regs[1]
		}
		vfp.Arith3(p.Asm, m.cond, m.idx, m.size, first + regs[0], first + vn, first + vm)
	} else if zero {
		vfp.CmpZero(p.Asm, m.cond, m.idx == arm32VfpUnary + vfp.UNARY_CMPE, m.size, first + regs[0])
	} else {
		vfp.Arith2(p.Asm, m.cond, m.idx - arm32VfpUnary, m.size, first + regs[0], first + regs[1])
	}
}
