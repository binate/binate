package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"

// The VFP's pre-UAL data-processing names, as clang takes them.  With VFPv2 in effect, clang's
// mnemonic aliases make a mnemonic that is exactly fadds .. fsqrtd the instruction (and type) they
// name -- fadds VADD.F32, fsqrtd VSQRT with none -- every form of it, NEON's too.  Any other
// mnemonic is split as clang splits every one (arm32VdpSplit): an `s` after the name is clang's
// flag-setting error (faddseq is fadds with EQ, so fadd with an `s`; fmacs.w is fma with CS);
// fsubs, fsubd, fcmpzs and fcmpzd are instruction aliases of their own (with a condition, with no
// type); fsqrts and fsqrtd are VSQRT again; the other names clang aliases once more to the
// instruction and type, which matches no instruction; and faddd without VFPv2 is an instruction
// alias whose features are missing.

// arm32VfpPreUalAlias returns the instruction and type suffix (with its `.`, or "") clang's
// mnemonic alias makes of name (lowercase), or "" and "" for a name that has none.
func arm32VfpPreUalAlias(name *[]readonly char) (*[]readonly char, *[]readonly char) {
	var names @[]*[]readonly char = @[]*[]readonly char{"fadds", "faddd", "fmuls", "fmuld", "fdivs",
			"fdivd", "fmacs", "fmacd", "fnegs", "fnegd", "fcmps", "fcmpd", "fsqrts", "fsqrtd"}
	var targets @[]*[]readonly char = @[]*[]readonly char{"vadd", "vadd", "vmul", "vmul", "vdiv",
			"vdiv", "vmla", "vmla", "vneg", "vneg", "vcmp", "vcmp", "vsqrt", "vsqrt"}
	var types @[]*[]readonly char = @[]*[]readonly char{".f32", ".f64", ".f32", ".f64", ".f32", ".f64",
			".f32", ".f64", ".f32", ".f64", ".f32", ".f64", "", ""}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return targets[i], types[i] }
	}
	return "", ""
}

// arm32VfpPreUalStarts reports whether head (lowercase) starts with one of the pre-UAL names:
// those clang aliases (arm32VfpPreUalAlias) and its instruction aliases fsubs, fsubd, fcmpzs and
// fcmpzd.
func arm32VfpPreUalStarts(head *[]readonly char) bool {
	var names @[]*[]readonly char = @[]*[]readonly char{"fadds", "faddd", "fmuls", "fmuld", "fdivs",
			"fdivd", "fmacs", "fmacd", "fnegs", "fnegd", "fcmps", "fcmpd", "fsqrts", "fsqrtd", "fsubs",
			"fsubd", "fcmpzs", "fcmpzd"}
	for i := 0; i < len(names); i++ {
		var n *[]readonly char = names[i]
		if len(head) >= len(n) && charsEqual(head[0:len(n)], n) { return true }
	}
	return false
}

// parseArm32VfpPreUal assembles a mnemonic that starts with a pre-UAL name (arm32VfpPreUalStarts),
// lower the mnemonic in lower case and dot where its `.` suffixes start, as clang takes it, and l
// the lexer after it; it reports whether lower is one.
func parseArm32VfpPreUal(p @Parser, l Lexer, lower *[]readonly char, dot int) bool {
	var head *[]readonly char = lower[0:dot]
	if !arm32VfpPreUalStarts(head) { return false }
	var vfp2 bool = arm32MatchMissing(p, matchNeedVFP2) == 0
	if dot == len(lower) && vfp2 {
		target, suffix := arm32VfpPreUalAlias(head)
		if len(target) > 0 {
			arm32VdpMatch(p, l, target, arm32.COND_AL, suffix)
			return true
		}
	}
	name, cond, carry := arm32VdpSplit(head)
	if carry {
		arm32VfpFlagsErr(p, name)
		return true
	}
	target, _ := arm32VfpPreUalAlias(name)
	if vfp2 && charsEqual(target, "vsqrt") {
		arm32VdpMatch(p, l, target, cond, lower[dot:len(lower)])
		return true
	}
	if (vfp2 && len(target) > 0) || arm32VarithOp(name) < 0 {
		// No instruction; clang reports a `.n` and the operands' errors before it looks for one.
		var types @[]int = make_slice(int, 3)
		_, ok := arm32MatchSuffixes(p, lower[dot:len(lower)], types)
		if ok { arm32VdpNone(p, l) }
		return true
	}
	arm32VdpMatch(p, l, name, cond, lower[dot:len(lower)])
	return true
}
