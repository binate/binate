package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The pre-UAL names clang keeps, in any case, as clang assembles them: a condition after fsubs,
// fsubd, fsqrts, fsqrtd, fcmpzs and fcmpzd only, two registers for three after fadds, faddd,
// fmuls, fmuld, fdivs and fdivd only, no type; others are errors.
func TestParseArm32VfpPreUal() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "fadds s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "FADDS s0, s1, s2", "EE300A81")
	e = armGateIs(e, "", "fadds s0, s1", "EE300A20")
	e = armGateIs(e, "", "faddd d0, d1, d2", "EE310B02")
	e = armGateIs(e, "", "fsubs s0, s1, s2", "EE300AC1")
	e = armGateIs(e, "", "fsubd d0, d1, d2", "EE310B42")
	e = armGateIs(e, "", "fmuls s0, s1, s2", "EE200A81")
	e = armGateIs(e, "", "fmuld d0, d1, d2", "EE210B02")
	e = armGateIs(e, "", "fdivs s0, s1, s2", "EE800A81")
	e = armGateIs(e, "", "fdivd d0, d1, d2", "EE810B02")
	e = armGateIs(e, "", "fmacs s0, s1, s2", "EE000A81")
	e = armGateIs(e, "", "fmacd d0, d1, d2", "EE010B02")
	e = armGateIs(e, "", "fnegs s0, s1", "EEB10A60")
	e = armGateIs(e, "", "fnegd d0, d1", "EEB10B41")
	e = armGateIs(e, "", "fsqrts s0, s1", "EEB10AE0")
	e = armGateIs(e, "", "fsqrtd d0, d1", "EEB10BC1")
	e = armGateIs(e, "", "fcmps s0, s1", "EEB40A60")
	e = armGateIs(e, "", "fcmpd d0, d1", "EEB40B41")
	e = armGateIs(e, "", "fcmpzs s0", "EEB50A40")
	e = armGateIs(e, "", "fcmpzd d0", "EEB50B40")
	e = armGateIs(e, "", "fsubseq s1, s2, s3", "0E710A61")
	e = armGateIs(e, "", "fsubsal s1, s2, s3", "EE710A61")
	e = armGateIs(e, "", "fsubdEQ d1, d2, d3", "0E321B43")
	e = armGateIs(e, "", "fsqrtseq s1, s2", "0EF10AC1")
	e = armGateIs(e, "", "fsqrtdeq d1, d2", "0EB11BC2")
	e = armGateIs(e, "", "fcmpzseq s1", "0EF50A40")
	e = armGateIs(e, "", "fcmpzdEQ d1", "0EB51B40")
	e = armGateIs(e, "", "fmuls s1, s2", "EE600A81")
	e = armGateIs(e, "", "fdivd d1, d2", "EE811B02")
	e = armGateIs(e, "", "fsubs s1, s2", "!too few operands for instruction")
	e = armGateIs(e, "", "fsubd d1, d2", "!too few operands for instruction")
	e = armGateIs(e, "", "fmacs s1, s2", "!too few operands for instruction")
	e = armGateIs(e, "", "fadddeq d1, d2, d3", "!")
	e = armGateIs(e, "", "fcmpdeq d1, d2", "!")
	e = armGateIs(e, "", "fcmpzs s0, s1", "!too many operands for instruction")
	e = armGateIs(e, "", "fnegd d0, d1, d2", "!too many operands for instruction")
	e = armGateIs(e, "", "faddseq s0, s1, s2", "!")
	e = armGateIs(e, "", "fabss s0, s1", "!")
	e = armGateIs(e, "", "fnmuls s0, s1, s2", "!")
	e = armGateIs(e, "", "fcmpes s0, s1", "!")
	return e
}

// clang's mnemonic aliases: each name's instruction and type, VSQRT's none; none for the others.
// The names that start with a pre-UAL one.
func TestArm32VfpPreUalNames() testing.TestResult {
	target, suffix := arm32VfpPreUalAlias("fadds")
	if !charsEqual(target, "vadd") || !charsEqual(suffix, ".f32") {
		return fail("fadds is not VADD.F32")
	}
	target, suffix = arm32VfpPreUalAlias("fcmpd")
	if !charsEqual(target, "vcmp") || !charsEqual(suffix, ".f64") {
		return fail("fcmpd is not VCMP.F64")
	}
	target, suffix = arm32VfpPreUalAlias("fsqrtd")
	if !charsEqual(target, "vsqrt") || len(suffix) != 0 { return fail("fsqrtd is not VSQRT") }
	target, _ = arm32VfpPreUalAlias("fsubs")
	if len(target) != 0 { return fail("fsubs has a mnemonic alias") }
	if !arm32VfpPreUalStarts("fcmpzdeq") || !arm32VfpPreUalStarts("fmacs") ||
			arm32VfpPreUalStarts("fcmpe") || arm32VfpPreUalStarts("fadd") {
		return fail("the names that start with a pre-UAL one are wrong")
	}
	return ""
}

// The aliases as clang takes them: every form of the instruction, NEON's too (fadds on D
// registers, fmuls on Q, fmacs); fsqrts and fsqrtd VSQRT on S or D registers.  Split as clang
// splits: an `s` after fadd, fmac, fneg (faddseq; before a `.n`), fmacs.w (fma with CS), fdivs.w
// (fdi with VS), fadddeq and fmulseq (aliased again to no instruction, after a `.n`), fsqrtd on Q
// registers.  Without VFPv2: faddd's and fsubs's features, fadds's `s`, fsqrts no instruction.
// The instruction aliases' operands: fcmpzs with a type or #0, fcmpzd on an S register.
func TestParseArm32VfpPreUalForms() testing.TestResult {
	var e @[]char = ""
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	var narrow *[]readonly char = "instruction with .n (narrow) qualifier not allowed in arm mode"
	e = armGateIs(e, "", "fadds d0, d1, d2", "F2010D02")
	e = armGateIs(e, "", "fmuls q0, q1", "F3000D52")
	e = armGateIs(e, "", "fmacs d0, d1, d2", "F2010D12")
	e = armGateIs(e, "", "fsqrts d0, d1", "EEB10BC1")
	e = armGateIs(e, "", "fsqrtd s0, s1", "EEB10AE0")
	e = armGateIs(e, "", "fcmps s0, #0", "EEB50A40")
	e = armMsgIs(e, "", "faddseq s0, s1, s2", armQuote("fadd", flags))
	e = armMsgIs(e, "", "faddseq.n s0, s1, s2", armQuote("fadd", flags))
	e = armMsgIs(e, "", "fmacseq s0, s1, s2", armQuote("fmac", flags))
	e = armMsgIs(e, "", "fnegseq s0, s1", armQuote("fneg", flags))
	e = armMsgIs(e, "", "fmacs.w s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, "", "fdivs.w s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, "", "fadddeq d0, d1, d2", "invalid instruction")
	e = armMsgIs(e, "", "fmulseq s0, s1, s2", "invalid instruction")
	e = armMsgIs(e, "", "fmulseq.n s0, s1, s2", narrow)
	e = armMsgIs(e, "", "fsqrts.n s0, s1", narrow)
	e = armMsgIs(e, "", "fsqrtd q0, q1", "invalid instruction")
	e = armMsgIs(e, ".fpu none", "faddd d0, d1, d2", "instruction requires: double precision VFP VFP2")
	e = armMsgIs(e, ".fpu none", "fsubs s0, s1, s2", "instruction requires: VFP2")
	e = armMsgIs(e, ".fpu none", "fcmpzs s0", "instruction requires: VFP2")
	e = armMsgIs(e, ".fpu none", "fadds s0, s1, s2", armQuote("fadd", flags))
	e = armMsgIs(e, ".fpu none", "fsqrts s0, s1", "invalid instruction")
	e = armMsgIs(e, "", "fcmpzs.f32 s0", "invalid instruction")
	e = armMsgIs(e, "", "fcmpzs s0, #0", "too many operands for instruction")
	e = armMsgIs(e, "", "fcmpzd s0", "operand must be a register in range [d0, d31]")
	return e
}

// A mnemonic that names no instruction is clang's "invalid instruction" once its operands are
// read, their errors first: a doubled comma, a missing comma, a memory operand unclosed, a comma
// at the end, an expression that is none; and so for a q alias without NEON, after a `.n`.
func TestParseArm32VfpPreUalOperandsFirst() testing.TestResult {
	var e @[]char = ""
	var v3 *[]readonly char = ".fpu vfpv3"
	e = armMsgIs(e, "", "fdivs.w s0, s1,, s2", "unexpected token in operand")
	e = armMsgIs(e, "", "fmulseq s0, s1 s2", "unexpected token in argument list")
	e = armMsgIs(e, "", "fmacs.w s0, [r0", "malformed memory operand")
	e = armMsgIs(e, "", "fadddeq d0,", "unexpected token in operand")
	e = armMsgIs(e, ".fpu none", "fsqrts q0, (", "unknown token in expression")
	e = armMsgIs(e, v3, "vaddq.f32 s0, s1,, s2", "unexpected token in operand")
	e = armMsgIs(e, v3, "vcleq q0, q1,, q2", "unexpected token in operand")
	e = armMsgIs(e, v3, "vcleq q0, q1, q2", "invalid instruction")
	e = armMsgIs(e, v3, "vaddq.n q0, q1,, q2",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	return e
}
