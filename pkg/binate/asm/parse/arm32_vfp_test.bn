package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/builtins/testing"

// An S or D register's number, in any case, with no leading zero and within its range; how a
// mnemonic names an instruction (as is, with a condition, or with an `s` and the name before it);
// the message for a register past those there are.
func TestArm32VfpHelpers() testing.TestResult {
	if arm32VfpReg("s31", 's') != 31 || arm32VfpReg("D7", 'd') != 7 || arm32VfpReg("s01", 's') != -1 ||
			arm32VfpReg("d32", 'd') != -1 || arm32VfpReg("q1", 's') != -1 {
		return fail("an S or D register's number is wrong")
	}
	named, cond, _ := arm32VfpNamed("vmrseq", "vmrs")
	if named != vfpNamedOk || cond != arm32.COND_EQ { return fail("vmrseq is not VMRS with EQ") }
	flags, _, before := arm32VfpNamed("vmovxs", "vmov")
	if flags != vfpNamedFlags || !charsEqual(before, "vmovx") {
		return fail("vmovxs is not 'vmovx' with an `s`")
	}
	none, _, _ := arm32VfpNamed("vmovx", "vmov")
	if none != vfpNamedNone { return fail("vmovx names VMOV") }
	var d16 @Parser = dataSource("arm32", ".fpu vfpv3-d16\n", asm.OBJ_ELF)
	if !charsEqual(arm32VfpRange(d16, 64), "operand must be a register in range [d0, d15]") ||
			!charsEqual(arm32VfpRange(d16, 32), "operand must be a register in range [s0, s31]") {
		return fail("a register's range message is wrong")
	}
	return ""
}
