package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// VLDM / VSTM, VPUSH / VPOP and the pre-UAL FLDMX / FSTMX (asm/arm32/vfp), as clang takes them:
// VLDM{IA|DB} Rn{!}, a list of S or D registers (DB with write-back; VLDM alone is VLDMIA), any of
// clang's data types after it ignored; VPUSH / VPOP {list}, with .8, .16, .32 or .64 (or a type
// clang's token aliases stand for) or none; FLDM{IA|DB}X Rn{!}, a list of D registers, and its
// VFPv2 aliases fldmfdx, fldmeax, fstmfdx and fstmeax.  clang splits the mnemonic as it splits
// every mnemonic (a condition off the end, then an `s`), reads the list (arm32MatchRegList) and
// matches the types and operands against its encodings (arm32_match.bn), M-profile's VLLDM /
// VLSTM and VSCCLRM among them, which only decide its message here.

// The multiple loads and stores (arm32VldmName's kind): VLDM / VSTM, VPUSH / VPOP, FLDMX / FSTMX,
// M-profile's VLLDM / VLSTM and VSCCLRM.
const (
	vldmNone int = iota
	vldmMulti
	vldmPush
	vldmX
	vldmLazy
	vldmClear
)

// arm32VldmName returns what name (lowercase, split) names: its kind (vldm*), whether it loads,
// whether it decrements before, and whether it is one of clang's VFPv2 aliases of FLDMX / FSTMX.
func arm32VldmName(name *[]readonly char) (int, bool, bool, bool) {
	if charsEqual(name, "vldm") || charsEqual(name, "vldmia") { return vldmMulti, true, false, false }
	if charsEqual(name, "vldmdb") { return vldmMulti, true, true, false }
	if charsEqual(name, "vstm") || charsEqual(name, "vstmia") { return vldmMulti, false, false, false }
	if charsEqual(name, "vstmdb") { return vldmMulti, false, true, false }
	if charsEqual(name, "vpush") { return vldmPush, false, true, false }
	if charsEqual(name, "vpop") { return vldmPush, true, false, false }
	if charsEqual(name, "fldmiax") { return vldmX, true, false, false }
	if charsEqual(name, "fldmdbx") { return vldmX, true, true, false }
	if charsEqual(name, "fstmiax") { return vldmX, false, false, false }
	if charsEqual(name, "fstmdbx") { return vldmX, false, true, false }
	if charsEqual(name, "fldmfdx") { return vldmX, true, false, true }
	if charsEqual(name, "fldmeax") { return vldmX, true, true, true }
	if charsEqual(name, "fstmeax") { return vldmX, false, false, true }
	if charsEqual(name, "fstmfdx") { return vldmX, false, true, true }
	if charsEqual(name, "vlldm") { return vldmLazy, true, false, false }
	if charsEqual(name, "vlstm") { return vldmLazy, false, false, false }
	if charsEqual(name, "vscclrm") { return vldmClear, false, false, false }
	return vldmNone, false, false, false
}

// arm32VldmCands returns the encodings clang tries for a name of kind (vldm*), decrementing before
// when db, in its order: VLDM's and FLDMX's Rn and a list, Rn! and a list (DB has only these) --
// VLDM's of D or S registers, FLDMX's of D only -- VPUSH's list with no type, .8, .16, .32 or .64;
// all with the FP registers.  M-profile's VLLDM Rn (not PC) and a D list (the ARMv8-M Security
// Extensions and ARMv8-M's mainline, or ARMv8.1-M's), or Rn alone; VSCCLRM's S or D list with VPR
// (the Security Extensions and ARMv8.1-M).
func arm32VldmCands(kind int, db bool) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 16)
	var form int = matchFormVFP
	var fp int = matchNeedFPRegs
	var core int = matchKindCore
	var bang int = matchKindBang
	if kind == vldmMulti || kind == vldmX {
		if !db { matchAdd(list, 0, 0, matchOps(core, matchKindDList, 0), fp, form) }
		matchAdd(list, 0, 0, matchOps(core, bang, matchKindDList), fp, form)
	}
	if kind == vldmMulti {
		if !db { matchAdd(list, 0, 0, matchOps(core, matchKindSList, 0), fp, form) }
		matchAdd(list, 0, 0, matchOps(core, bang, matchKindSList), fp, form)
	}
	if kind == vldmPush {
		var types @[]int = @[]int{0, matchType8, matchType16, matchType32, matchType64}
		for i := 0; i < len(types); i++ {
			matchAdd(list, types[i], 0, matchOps(matchKindDList, 0, 0), fp, form)
			matchAdd(list, types[i], 0, matchOps(matchKindSList, 0, 0), fp, form)
		}
	}
	if kind == vldmLazy {
		var lazy int = matchNeedSec8M | matchNeedV8M
		matchAdd(list, 0, 0, matchOps(matchKindCoreNoPC, matchKindDList, 0), lazy, form)
		matchAdd(list, 0, 0, matchOps(matchKindCoreNoPC, 0, 0), lazy, form)
		matchAdd(list, 0, 0, matchOps(matchKindCoreNoPC, matchKindDList, 0),
				matchNeedSec8M | matchNeedV8_1M, form)
	}
	if kind == vldmClear {
		var clear int = matchNeedSec8M | matchNeedV8_1M
		matchAdd(list, 0, 0, matchOps(matchKindDListVPR, 0, 0), clear, form)
		matchAdd(list, 0, 0, matchOps(matchKindSListVPR, 0, 0), clear, form)
	}
	arm32MatchSort(list)
	return list
}

// parseArm32Vldm assembles a multiple load or store (arm32VldmName), mnem the mnemonic as written
// and l the lexer after it, reporting whether mnem names one.
func parseArm32Vldm(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) < 4 || (arm32Lower(mnem[0]) != 'v' && arm32Lower(mnem[0]) != 'f') { return false }
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	var name @[]char = lower[0:dot]
	var cond int = arm32.COND_AL
	if len(name) > 2 && parseArm32CondCode(name[len(name) - 2:len(name)]) >= 0 {
		cond = parseArm32CondCode(name[len(name) - 2:len(name)])
		name = name[0:len(name) - 2]
	}
	if name[len(name) - 1] == 's' {
		// An `s` after the name, with a condition after it (split off first) or before it.
		var text @[]char = name[0:len(name) - 1]
		var base @[]char = text
		if len(base) > 2 && parseArm32CondCode(base[len(base) - 2:len(base)]) >= 0 {
			base = base[0:len(base) - 2]
		}
		known, _, _, _ := arm32VldmName(base)
		if known == vldmNone { return false }
		arm32VfpFlagsErr(p, text)
		return true
	}
	kind, load, db, alias := arm32VldmName(name)
	if kind == vldmNone { return false }
	var types @[]int = make_slice(int, len(mnem))
	nt, ok := arm32MatchSuffixes(p, lower[dot:len(lower)], types)
	if !ok { return true }
	if kind == vldmMulti { nt = arm32VldmKeptTypes(types, nt) }
	var mode int = matchListPlain
	if kind == vldmLazy { mode = matchListLazy }
	if kind == vldmClear { mode = matchListClear }
	items, ni, read := arm32MatchOperandsIn(p, l, mode)
	if !read { return true }
	// Without VFPv2 clang has no alias of FLDMX / FSTMX, which it finds once it has read the operands.
	if alias && p.Arm32FP & armFpVFP2SP == 0 {
		setErr(p, "invalid instruction")
		return true
	}
	var list @arm32MatchList = arm32VldmCands(kind, db)
	var i int = arm32MatchRun(p, list, cond, types, nt, items, ni)
	if i >= 0 { arm32VldmEmit(p, kind, load, db, cond, list.c[i], items) }
	return true
}

// arm32VldmKeptTypes drops from the nt types the data types clang ignores after VLDM / VSTM (.8 ..
// .64, .i8 .. .i64, .s8 .. .s64, .u8 .. .u64, .p8, .p16, .f32, .f64, .f and .d), keeping the others
// (.f16, .bf16, a type clang has not), in order, and returns how many are kept.
func arm32VldmKeptTypes(types @[]int, nt int) int {
	var kept int = 0
	for i := 0; i < nt && i < len(types); i++ {
		var t int = types[i]
		if t == matchTypeF16 || t == matchTypeBF16 || t == matchTypeOther {
			types[kept] = t
			kept = kept + 1
		}
	}
	return kept
}

// arm32VldmEmit assembles a multiple load (or store when !load) of kind (vldm*), decrementing
// before when db, under cond as VFP encoding c with its operands items, after clang's check of a
// matched VLDMIA / VSTMIA without write-back (a D list of 16 at most).
func arm32VldmEmit(p @Parser, kind int, load bool, db bool, cond int, c arm32MatchCand,
		items @[]arm32MatchItem) {
	if kind == vldmLazy || kind == vldmClear {
		// M-profile's VLLDM / VLSTM and VSCCLRM, which only ARMv8-M's Thumb code has.
		setErr(p, "arm32: no ARM encoding of a VLLDM / VLSTM or VSCCLRM")
		return
	}
	var rn int = arm32.SP
	var wb bool = true
	var at arm32MatchItem = items[0]
	if kind != vldmPush {
		rn = items[0].n
		wb = arm32MatchKindAt(c.ops, 1) == matchKindBang
		at = items[1]
		if wb { at = items[2] }
	}
	var first int = vfp.S0 + at.n
	if at.list == matchListD { first = vfp.D0 + at.n }
	if kind == vldmMulti && !wb && at.list == matchListD && at.count > 16 {
		setErr(p, "list of registers must be at least 1 and at most 16")
		return
	}
	if kind == vldmPush && load {
		vfp.Vpop(p.Asm, cond, first, at.count)
	} else if kind == vldmPush {
		vfp.Vpush(p.Asm, cond, first, at.count)
	} else if kind == vldmX && load {
		vfp.Fldmx(p.Asm, cond, db, wb, rn, first, at.count)
	} else if kind == vldmX {
		vfp.Fstmx(p.Asm, cond, db, wb, rn, first, at.count)
	} else if load {
		vfp.Vldm(p.Asm, cond, db, wb, rn, first, at.count)
	} else {
		vfp.Vstm(p.Asm, cond, db, wb, rn, first, at.count)
	}
}
