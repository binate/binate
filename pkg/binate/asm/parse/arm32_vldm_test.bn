package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// VLDM / VSTM, VPUSH / VPOP and FLDMX / FSTMX as clang assembles them: IA and DB, write-back, S
// and D lists, VLDM alone as VLDMIA, a condition, VLDM's ignored data types and `.w`, VPUSH's
// types, PC as the base; FLDMX's X forms and their VFPv2 aliases; a D list past 16 with
// write-back; with the FP registers only.
func TestParseArm32VldmForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vldm r0, {d0-d3}", "EC900B08")
	e = armGateIs(e, "", "vldmia r0!, {s0-s3}", "ECB00A04")
	e = armGateIs(e, "", "vldmdb r0!, {d0}", "ED300B02")
	e = armGateIs(e, "", "vstmdb sp!, {d8-d15}", "ED2D8B10")
	e = armGateIs(e, "", "vstmia r1, {s5-s7}", "ECC12A03")
	e = armGateIs(e, "", "vpush {d8-d15}", "ED2D8B10")
	e = armGateIs(e, "", "vpop {s0, s1}", "ECBD0A02")
	e = armGateIs(e, "", "vpusheq {d0}", "0D2D0B02")
	e = armGateIs(e, "", "vpush.f64 {d0}", "ED2D0B02")
	e = armGateIs(e, "", "vpush.i8 {d0}", "ED2D0B02")
	e = armGateIs(e, "", "vpush.u32 {s0}", "ED2D0A01")
	e = armGateIs(e, "", "vpush.f {s0}", "ED2D0A01")
	e = armGateIs(e, "", "vldm.32 r0, {s0}", "EC900A01")
	e = armGateIs(e, "", "vldmia.32.64 r0, {d0}", "EC900B02")
	e = armGateIs(e, "", "vldmia.w r0, {d0}", "EC900B02")
	e = armGateIs(e, "", "vldmiaeq r0, {d0}", "0C900B02")
	e = armGateIs(e, "", "vldmeq r0, {d0}", "0C900B02")
	e = armGateIs(e, "", "vldm r15!, {d0}", "ECBF0B02")
	e = armGateIs(e, "", "vldm pc, {d0}", "EC9F0B02")
	e = armGateIs(e, "", "vldmia r0, {d16-d31}", "ECD00B20")
	e = armGateIs(e, "", "vldmia r0!, {d0-d16}", "ECB00B22")
	e = armGateIs(e, "", "vpush {d0-d31}", "ED2D0B40")
	e = armGateIs(e, "", "vpush {s0-s31}", "ED2D0A20")
	e = armGateIs(e, "", "fldmiax r0, {d0}", "EC900B03")
	e = armGateIs(e, "", "fldmdbx r0!, {d0}", "ED300B03")
	e = armGateIs(e, "", "fstmiax r0!, {d0-d1}", "ECA00B05")
	e = armGateIs(e, "", "fldmfdx r0!, {d0}", "ECB00B03")
	e = armGateIs(e, "", "fstmfdx r0!, {d0}", "ED200B03")
	e = armGateIs(e, "", "fldmeaxeq r0!, {d0}", "0D300B03")
	e = armGateIs(e, "", "fldmiaxeq r0, {d0}", "0C900B03")
	e = armGateIs(e, ".fpu none", "vpush {d0}", "ED2D0B02")
	e = armGateIs(e, ".fpu none", "fldmiax r0, {d0}", "EC900B03")
	return e
}

// What clang does not take of them, with its message: VLDMDB without write-back; no list or too
// many operands; a base that is no core register; a D list past 16 without write-back; an `s`
// after the name; a type VLDM does not ignore, two on VPUSH, any on FLDMX; the gates (the FP
// registers; VFPv2 for FLDMX's aliases, found after the operands -- clang adds a "did you mean"
// with the FP registers, which bnas never gives).
func TestParseArm32VldmRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	var core *[]readonly char = "operand must be a register in range [r0, r15]"
	e = armMsgIs(e, "", "vldmdb r0, {d0}", "invalid instruction")
	e = armMsgIs(e, "", "vldm r0", "too few operands for instruction")
	e = armMsgIs(e, "", "vpush", "too few operands for instruction")
	e = armMsgIs(e, "", "vldm {d0}", "invalid instruction")
	e = armMsgIs(e, "", "vldm r0, {d0}, r1", "too many operands for instruction")
	e = armMsgIs(e, "", "vldm r0, {s0}^", "too many operands for instruction")
	e = armMsgIs(e, "", "vldm #4, {d0}", core)
	e = armMsgIs(e, "", "vldm [r0], {d0}", core)
	e = armMsgIs(e, "", "vpush sp!, {d0}", "invalid instruction")
	e = armMsgIs(e, "", "vpush {d0}, {d1}", several)
	e = armMsgIs(e, "", "vpush d0", several)
	e = armMsgIs(e, "", "vldm r0!!, {d0}", "unexpected token in argument list")
	e = armMsgIs(e, "", "vpop {d0}!", "unexpected token in argument list")
	e = armMsgIs(e, "", "vldmia r0, {d0-d16}", "list of registers must be at least 1 and at most 16")
	e = armMsgIs(e, "", "vldmias r0, {d0}", armQuote("vldmia", flags))
	e = armMsgIs(e, "", "vldms r0, {d0}", armQuote("vldm", flags))
	e = armMsgIs(e, "", "vpops {d0}", armQuote("vpop", flags))
	e = armMsgIs(e, "", "vpusheqs {d0}", armQuote("vpusheq", flags))
	e = armMsgIs(e, "", "fldmiaxs r0, {d0}", armQuote("fldmiax", flags))
	e = armMsgIs(e, "", "vldmia.f16 r0, {d0}", "invalid instruction")
	e = armMsgIs(e, "", "vpush.f16 {s0}", "invalid operand for instruction")
	e = armMsgIs(e, "", "vpush.32.32 {s0}", "invalid instruction")
	e = armMsgIs(e, "", "fldmiax.32 r0, {d0}", "invalid instruction")
	e = armMsgIs(e, ".arch armv6", "vpush {d0}", "instruction requires: fp registers")
	e = armMsgIs(e, ".fpu none", "fldmfdx r0!, {d0}", "invalid instruction")
	e = armMsgIs(e, ".fpu none", "fldmfdx r0!, {d0", "'}' expected")
	return e
}

// M-profile's VLLDM / VLSTM and VSCCLRM, which clang offers in ARM code only as near misses: a
// base, a list or neither, with the ARMv8-M Security Extensions and ARMv8-M's (or ARMv8.1-M's)
// mainline; VSCCLRM's list with VPR, D registers after S31 too.
func TestParseArm32VldmMProfile() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var main1 *[]readonly char = "instruction requires: ARMv8-M Security Extensions armv8.1m.main"
	e = armMsgIs(e, "", "vlldm r0", "instruction requires: ARMv8-M Security Extensions armv8m.main")
	e = armMsgIs(e, "", "vlldm r0, {d0-d15}", several)
	e = armMsgIs(e, "", "vlldm r0, {d0-d16}", several)
	e = armMsgIs(e, ".fpu vfpv2", "vlldm r0, {d0-d31}", several)
	e = armMsgIs(e, "", "vlstmeq r1, {d0-d15}", several)
	e = armMsgIs(e, "", "vlldm pc", "invalid instruction")
	e = armMsgIs(e, "", "vlldm r0, {s0}", "invalid instruction")
	e = armMsgIs(e, "", "vlldm r0!", "invalid instruction")
	e = armMsgIs(e, "", "vlldm.32 r0", "invalid instruction")
	e = armMsgIs(e, "", "vscclrm {s0, vpr}", main1)
	e = armMsgIs(e, "", "vscclrm {vpr}", main1)
	e = armMsgIs(e, "", "vscclrmeq {s0, vpr}", main1)
	e = armMsgIs(e, "", "vscclrm {s30, s31, d16, vpr}", main1)
	e = armMsgIs(e, "", "vscclrm {d15, d16, vpr}", main1)
	e = armMsgIs(e, "", "vscclrm {d0}", "invalid instruction")
	e = armMsgIs(e, "", "vscclrm {s31, d16}", "invalid instruction")
	e = armMsgIs(e, "", "vscclrm {s0, d1}", "invalid register in register list")
	return e
}
