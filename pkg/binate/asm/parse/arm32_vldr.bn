package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"

// VLDR and VSTR (asm/arm32/vfp), as clang takes them: Sd or Dd and an address -- [Rn{, #imm}] or
// a label or `.±N` (PC-relative, in place) -- with no type, .32 / .64 (VFPv2's, or a type clang's
// token aliases stand for them: .f32, .i32, .s32, .f, .d, ...) or .16 (ARMv8.2's half precision,
// unconditional); and the pre-UAL names flds, fldd, fsts and fstd (VFPv2's).  clang splits the
// mnemonic as it splits every mnemonic (a condition off the end, then an `s`, but for flds and
// fsts), and matches the types and operands against its encodings (arm32_match.bn), M-profile's
// VLDR / VSTR of a system register among them.

// arm32VldrName returns whether name (lowercase, split) is VLDR or VSTR and its load flag: vldr,
// vstr, or the pre-UAL flds, fldd, fsts, fstd (alias true).
func arm32VldrName(name *[]readonly char) (bool, bool, bool) {
	if charsEqual(name, "vldr") { return true, true, false }
	if charsEqual(name, "vstr") { return true, false, false }
	if charsEqual(name, "flds") || charsEqual(name, "fldd") { return true, true, true }
	if charsEqual(name, "fsts") || charsEqual(name, "fstd") { return true, false, true }
	return false, false, false
}

// arm32VldrCands returns VLDR's (or VSTR's: the same) encodings in the order clang tries them: the
// VFP's -- Dd or Sd with no type (the FP registers), .16 (the 16-bit FP registers), .32 and .64
// (VFPv2) -- and M-profile's of FPSCR, FPSCR_nzcvqc (the FP registers and ARMv8.1-M), FPCXTNS,
// FPCXTS (the ARMv8-M Security Extensions and ARMv8.1-M), VPR and P0 (MVE and ARMv8.1-M): an
// offset, a pre-index (`!`) or a post-index.
func arm32VldrCands() @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, 32)
	var vfp int = matchFormVFP
	matchAdd(list, 0, 0, matchOps(matchKindD, matchKindAddr5, 0), matchNeedFPRegs, vfp)
	matchAdd(list, 0, 0, matchOps(matchKindS, matchKindAddr5, 0), matchNeedFPRegs, vfp)
	matchAdd(list, matchType16, 0, matchOps(matchKindS, matchKindAddr5H, 0), matchNeedFPRegs16, vfp)
	matchAdd(list, matchType32, 0, matchOps(matchKindS, matchKindAddr5, 0), matchNeedVFP2, vfp)
	matchAdd(list, matchType64, 0, matchOps(matchKindD, matchKindAddr5, 0), matchNeedVFP2, vfp)
	for k := matchKindSysFpscr; k <= matchKindSysP0; k++ {
		var need int = matchNeedV8_1M
		switch k {
		case matchKindSysFpscr, matchKindSysFpscrNzcvqc:
			need = need | matchNeedFPRegs
		case matchKindSysFpcxtns, matchKindSysFpcxts:
			need = need | matchNeedSec8M
		case matchKindSysVpr, matchKindSysP0:
			need = need | matchNeedMVE
		}
		matchAdd(list, 0, 0, matchOps(k, matchKindAddr7, 0), need, vfp)
		matchAdd(list, 0, 0, matchOps(k, matchKindAddr7, matchKindBang), need, vfp)
		matchAdd(list, 0, 0, matchOps(k, matchKindMemPlain, matchKindImm7s4), need, vfp)
	}
	arm32MatchSort(list)
	return list
}

// parseArm32Vldr assembles VLDR or VSTR (or a pre-UAL name for one), mnem the mnemonic as written
// and l the lexer after it, reporting whether mnem names one.
func parseArm32Vldr(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) < 4 || (arm32Lower(mnem[0]) != 'v' && arm32Lower(mnem[0]) != 'f') { return false }
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	var name @[]char = lower[0:dot]
	var cond int = arm32.COND_AL
	if len(name) > 2 && parseArm32CondCode(name[len(name) - 2:len(name)]) >= 0 {
		cond = parseArm32CondCode(name[len(name) - 2:len(name)])
		name = name[0:len(name) - 2]
	}
	var carry bool = name[len(name) - 1] == 's' && !charsEqual(name, "flds") &&
			!charsEqual(name, "fsts")
	if carry {
		// An `s` after the name, with a condition after it (vldrseq, split off first) or before it
		// (vldreqs, which clang leaves on the name it reports).
		var text @[]char = name[0:len(name) - 1]
		var base @[]char = text
		if len(base) > 2 && parseArm32CondCode(base[len(base) - 2:len(base)]) >= 0 {
			base = base[0:len(base) - 2]
		}
		known, _, _ := arm32VldrName(base)
		if !known { return false }
		arm32VfpFlagsErr(p, text)
		return true
	}
	known, load, alias := arm32VldrName(name)
	if !known { return false }
	var types @[]int = make_slice(int, 3)
	nt, ok := arm32MatchSuffixes(p, lower[dot:len(lower)], types)
	if !ok { return true }
	items, ni, read := arm32MatchOperands(p, l)
	if !read { return true }
	// Without VFPv2 clang has no pre-UAL name, which it finds once it has read the operands.
	if alias && p.Arm32FP & armFpVFP2SP == 0 {
		setErr(p, "invalid instruction")
		return true
	}
	var list @arm32MatchList = arm32VldrCands()
	var i int = arm32MatchRun(p, list, cond, types, nt, items, ni)
	if i >= 0 { arm32VldrEmit(p, cond, load, list.c[i], items) }
	return true
}

// arm32VldrEmit assembles VLDR (VSTR when !load) under cond as VFP encoding c, its register and
// address items, after clang's check of a matched instruction (no condition on .16).  A `.±N`
// target is its PC-relative offset (arm32VldrDot), a label one resolved in place (a local label in
// its own section); one with a `:lower16:`-style prefix has no relocation here (clang's "expected
// relocatable expression"), nor a label difference (clang's "unsupported relocation type"), and a
// quoted symbol name is a target the expression reader does not read.
func arm32VldrEmit(p @Parser, cond int, load bool, c arm32MatchCand, items @[]arm32MatchItem) {
	if items[0].kind != matchItemS && items[0].kind != matchItemD {
		// M-profile's VLDR of a system register, which only ARMv8.1-M's Thumb code has.
		setErr(p, "arm32: no ARM encoding of a VLDR / VSTR of a system register")
		return
	}
	var size int = 32
	if c.t1 == matchType16 { size = 16 }
	if items[0].kind == matchItemD { size = 64 }
	if size == 16 && cond != arm32.COND_AL {
		setErr(p, "instruction is not predicable")
		return
	}
	var vd int = vfp.S0 + items[0].n
	if size == 64 { vd = vfp.D0 + items[0].n }
	var at arm32MatchItem = items[1]
	var op arm32.Operand
	if at.kind == matchItemMem {
		op = arm32MemSub(arm32.MemImm(at.n, cast(int, at.val)), at.sub)
	} else if at.prefix {
		setErr(p, "expected relocatable expression")
		return
	} else if at.quoted {
		setErr(p, "invalid load / store target")
		return
	} else if at.dot {
		var ok bool
		op, ok = arm32VldrDot(p, size, at.val - 8)
		if !ok { return }
	} else if len(at.sym) > 0 && intFits(at.val) {
		op = arm32.LabelAddend(at.sym, cast(int, at.val))
	} else {
		setErr(p, "unsupported relocation type")
		return
	}
	if load {
		vfp.Vldr(p.Asm, cond, size, vd, op)
	} else {
		vfp.Vstr(p.Asm, cond, size, vd, op)
	}
}

// arm32VldrDot returns [PC, #off], the address off bytes from PC, as a VLDR of size (16, 32 or 64)
// takes it, or false with clang's error: .16's an even offset ("invalid value for this fixup",
// which clang checks first) within 255 halfwords, the others' within 255 words (clang's "out of
// range pc-relative fixup value" past them) and, here, a multiple of 4 ("misaligned pc-relative
// fixup value"; clang drops the low bits, encoding another address).
func arm32VldrDot(p @Parser, size int, off int64) (arm32.Operand, bool) {
	if size == 16 && off % 2 != 0 {
		setErr(p, "invalid value for this fixup")
		return arm32.Imm(0), false
	}
	var unit int64 = 4
	if size == 16 { unit = 2 }
	if off >= 256 * unit || off <= -256 * unit {
		setErr(p, "out of range pc-relative fixup value")
		return arm32.Imm(0), false
	}
	if off % 4 != 0 && size != 16 {
		setErr(p, "misaligned pc-relative fixup value")
		return arm32.Imm(0), false
	}
	return arm32.MemImm(arm32.PC, cast(int, off)), true
}
