package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// VLDR and VSTR as clang assembles them: S and D registers, an offset either way (clang's #-0 too),
// PC as the base, the types clang's encodings and token aliases give (.32, .64, .f32, .f, .d, .i16,
// .16 with full FP16), `.w`, conditions; the pre-UAL flds, fldd, fsts and fstd, with a condition
// and a type too.
func TestParseArm32VldrForms() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vldr s0, [r0]", "ED900A00")
	e = armGateIs(e, "", "vldr s0, [r0, #-4]", "ED100A01")
	e = armGateIs(e, "", "vldr s0, [r0, #1020]", "ED900AFF")
	e = armGateIs(e, "", "vldr s0, [r0, #-0]", "ED100A00")
	e = armGateIs(e, "", "vldr d16, [sp, #-1020]", "ED5D0BFF")
	e = armGateIs(e, "", "vstr d31, [r0, #-8]", "ED40FB02")
	e = armGateIs(e, "", "vldr s0, [pc, #8]", "ED9F0A02")
	e = armGateIs(e, "", "vldr s0, [ r0 , # 4 ]", "ED900A01")
	e = armGateIs(e, "", "vldr s0, [r0, 4]", "ED900A01")
	e = armGateIs(e, "", "vldreq s0, [r0]", "0D900A00")
	e = armGateIs(e, "", "vldr.32 s0, [r0]", "ED900A00")
	e = armGateIs(e, "", "vldr.f s0, [r0]", "ED900A00")
	e = armGateIs(e, "", "vldr.s32 s0, [r0]", "ED900A00")
	e = armGateIs(e, "", "vldr.d d0, [r0]", "ED900B00")
	e = armGateIs(e, "", "vldr.w s0, [r0]", "ED900A00")
	e = armGateIs(e, h, "vldr.16 s0, [r0, #2]", "ED900901")
	e = armGateIs(e, h, "vldr.i16 s0, [r0, #510]", "ED9009FF")
	e = armGateIs(e, h, "vstr.16 s0, [r0, #-2]", "ED000901")
	e = armGateIs(e, "", "flds s0, [r0, #4]", "ED900A01")
	e = armGateIs(e, "", "fldd d0, [r0, #8]", "ED900B02")
	e = armGateIs(e, "", "fsts s0, [r0]", "ED800A00")
	e = armGateIs(e, "", "fstdeq d3, [sp]", "0D8D3B00")
	e = armGateIs(e, "", "fldseq.32 s0, [r0]", "0D900A00")
	return e
}

// A label or `.±N` as VLDR's / VSTR's address, PC-relative and resolved in place, as clang
// assembles it: ahead, behind, a `#` before it, an addend, `.` itself; .16's too, in halfwords.
func TestParseArm32VldrLabels() testing.TestResult {
	var e @[]char = ""
	e = arm32PoolCase(e, "vldr d0, lbl\nnop\nlbl: nop", "ED9F0B00 E320F000 E320F000 ", 0)
	e = arm32PoolCase(e, "lbl: nop\nvldr s0, lbl", "E320F000 ED1F0A03 ", 0)
	e = arm32PoolCase(e, "vstr d0, lbl\nlbl: nop", "ED0F0B01 E320F000 ", 0)
	e = arm32PoolCase(e, "vldr s0, #lbl\nlbl: nop", "ED1F0A01 E320F000 ", 0)
	e = arm32PoolCase(e, "vldreq d0, lbl\nlbl: nop", "0D1F0B01 E320F000 ", 0)
	e = arm32PoolCase(e, "vldr s0, lbl+4\nlbl: nop\nnop", "ED9F0A00 E320F000 E320F000 ", 0)
	e = arm32PoolCase(e, "fldd d0, lbl\nlbl: nop", "ED1F0B01 E320F000 ", 0)
	e = arm32PoolCase(e, "vldr s0, .+8", "ED9F0A00 ", 0)
	e = arm32PoolCase(e, "vldr s0, .", "ED1F0A02 ", 0)
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16\n"
	e = arm32PoolCase(e, buf.Concat(h, "vldr.16 s0, lbl\nnop\nlbl: nop"),
			"ED9F0900 E320F000 E320F000 ", 0)
	e = arm32PoolCase(e, buf.Concat(h, "lbl: nop\nvldr.16 s0, lbl"), "E320F000 ED1F0906 ", 0)
	e = arm32PoolCase(e, buf.Concat(h, "vstr.16 s1, lbl\nlbl: nop"), "ED4F0902 E320F000 ", 0)
	e = arm32PoolCase(e, buf.Concat(h, "vldr.16 s0, .+8"), "ED9F0900 ", 0)
	e = arm32PoolCase(e, buf.Concat(h, "vldr.16 s0, .+518"), "ED9F09FF ", 0)
	return e
}

// What clang does not take of VLDR / VSTR's operands, with its message: .f16 and .8; a condition
// on .16; a writeback or post-index; an offset out of range or no multiple of the size; a register
// index; a floating-point literal (clang's number, its bit pattern); a `.±N` out of reach -- .16's
// odd one first ("invalid value for this fixup"), and here one no multiple of 4, which clang
// encodes as another address -- a label difference and a `:lower16:`-style operand (no
// relocation); a quoted symbol name, which bnas does not read.
func TestParseArm32VldrRejects() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	var bad *[]readonly char = "invalid operand for instruction"
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var far *[]readonly char = "out of range pc-relative fixup value"
	var reloc *[]readonly char = "expected relocatable expression"
	e = armMsgIs(e, h, "vldr.f16 s0, [r0, #2]", bad)
	e = armMsgIs(e, h, "vldr.8 s0, [r0]", bad)
	e = armMsgIs(e, h, "vldreq.16 s0, [r0, #2]", "instruction is not predicable")
	e = armMsgIs(e, "", "vldr s0, [r0, #4]!", "too many operands for instruction")
	e = armMsgIs(e, "", "vldr s0, [r0], #4", "too many operands for instruction")
	e = armMsgIs(e, "", "vldr s0, [r0, #1024]", bad)
	e = armMsgIs(e, "", "vldr s0, [r0, #2]", bad)
	e = armMsgIs(e, h, "vldr.16 s0, [r0, #512]", several)
	e = armMsgIs(e, "", "vldr s0, [r0, -r1]", bad)
	e = armMsgIs(e, "", "vldr s0, #1.0", bad)
	e = armMsgIs(e, "", "vldr s0, .+2000", far)
	e = armMsgIs(e, "", "vldr s0, .+1033", far)
	e = armMsgIs(e, "", "vldr d0, .-1028", far)
	e = armMsgIs(e, "", "vldr s0, .+6", "misaligned pc-relative fixup value")
	e = armMsgIs(e, "", "vldr s0, .+1029", "misaligned pc-relative fixup value")
	e = armMsgIs(e, h, "vldr.16 s0, .+520", far)
	e = armMsgIs(e, h, "vldr.16 s0, .-504", far)
	e = armMsgIs(e, h, "vldr.16 s0, .+9", "invalid value for this fixup")
	e = armMsgIs(e, h, "vldr.16 s0, .+601", "invalid value for this fixup")
	e = armMsgIs(e, "", "vldr s0, lbl2-lbl\nlbl: nop\nlbl2: nop", "unsupported relocation type")
	e = armMsgIs(e, "", "vldr s0, :lower16:x", reloc)
	e = armMsgIs(e, "", "vldr s0, #:upper16:lbl\nlbl: nop", reloc)
	e = armMsgIs(e, "", "vldr s0, \"lbl\"\nlbl: nop", "invalid load / store target")
	if len(e) != 0 { return e }
	// A label with no relocation (global, weak, undefined, in another section), out of reach or no
	// multiple of 4 (2 for .16) away.
	var src @[]*[]readonly char = make_slice(*[]readonly char, 8)
	src[0] = "vldr s0, ext"
	src[1] = "vldr s0, g\n.global g\ng: nop"
	src[2] = "vldr d0, w\n.weak w\nw: nop"
	src[3] = "vstr s0, lbl\n.section data\nlbl: .uint32 0"
	src[4] = "vldr s0, lbl\n.zero 1028\nlbl: nop"
	src[5] = "vldr s0, lbl\n.uint8 1\nlbl: nop"
	src[6] = ".arch armv8.2-a\n.arch_extension fp16\nvldr.16 s0, lbl\n.zero 1\nlbl: nop"
	src[7] = ".arch armv8.2-a\n.arch_extension fp16\nvldr.16 s0, lbl\n.zero 520\nlbl: nop"
	for i := 0; i < len(src); i++ {
		var p @Parser = arm32Source(src[i])
		if !p.HasError && !p.Asm.HasError { return fail(buf.Concat(src[i], ": accepted")) }
	}
	return ""
}

// VLDR / VSTR's mnemonic as clang reads it, with its message: an `s` after the name, before or
// after a condition (clang names what is left once it splits off the condition at the end, then
// the `s`); the gates (the FP registers, VFPv2 for the typed and pre-UAL spellings -- read after
// the operands, whose errors come first -- the 16-bit FP registers for .16).
func TestParseArm32VldrMnemonicRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var flags *[]readonly char = "' can not set flags, but 's' suffix specified"
	e = armMsgIs(e, "", "vldrs s0, [r0]", armQuote("vldr", flags))
	e = armMsgIs(e, "", "vldreqs s0, [r0]", armQuote("vldreq", flags))
	e = armMsgIs(e, "", "vldrseq s0, [r0]", armQuote("vldr", flags))
	e = armMsgIs(e, "", "vldrsal s0, [r0]", armQuote("vldr", flags))
	e = armMsgIs(e, "", "vldreqseq s0, [r0]", armQuote("vldreq", flags))
	e = armMsgIs(e, "", "fstdseq d0, [r0]", armQuote("fstd", flags))
	e = armMsgIs(e, "", "fldsseq s0, [r0]", armQuote("flds", flags))
	e = armMsgIs(e, ".arch armv6", "vldr s0, [r0]", "instruction requires: fp registers")
	e = armMsgIs(e, ".fpu none", "vldr.32 s0, [r0]", "instruction requires: VFP2")
	e = armMsgIs(e, ".fpu none", "flds s0, [r0]", "invalid instruction")
	e = armMsgIs(e, ".fpu none", "flds s0, [r0", "malformed memory operand")
	e = armMsgIs(e, ".fpu none", "vldr.16 s0, [r0]", "instruction requires: 16-bit fp registers")
	e = armMsgIs(e, "", "vldr.16 s0, [r0]", several)
	e = armMsgIs(e, ".fpu vfpv2", "vldr d16, [r0]", several)
	return e
}
