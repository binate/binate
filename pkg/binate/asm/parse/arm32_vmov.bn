package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/std/strconv"

// VMOV as clang takes it: every encoding of the name -- the VFP's moves between registers and its
// floating-point immediates, NEON's lane moves, modified immediates and register copy (VORR), MVE's
// as near misses -- matched in one list (arm32_vmov_cand.bn, arm32_match.bn), and the pre-UAL names
// clang keeps for them.  clang maps a name to another (its mnemonic aliases) before it splits the
// mnemonic, the whole of it, and again after, the name alone: fcpys and fcpyd only whole (VMOV.F32
// and VMOV.F64), fmrs, fmsr, fmrdd, fmrds, fmrrd and fmdrr either way (VMOV), each with VFPv2 in
// effect (and no instruction otherwise); fmdhr and fmdlr (VMOV.32 Dd[1] or Dd[0], Rt), fconsts and
// fconstd (VMOV.F32 / .F64 by an immediate's 8-bit encoding) are names of their own.

// The instructions here (arm32VmovName): VMOV, fmdhr, fmdlr, fconsts and fconstd.
const (
	vmovNameVmov int = iota + 1
	vmovNameFmdhr
	vmovNameFmdlr
	vmovNameFconsts
	vmovNameFconstd
)

// arm32VmovWhole returns the type (matchType*, 0 for none) of the VMOV the whole mnemonic lower
// (lowercase, its suffixes too) is through one of clang's mnemonic aliases, with VFPv2 in effect,
// and whether it is one: fcpys (.F32), fcpyd (.F64), fmrs, fmsr, fmrdd, fmrds, fmrrd, fmdrr.
func arm32VmovWhole(p @Parser, lower *[]readonly char) (int, bool) {
	if p.Arm32FP & armFpVFP2SP == 0 { return 0, false }
	if charsEqual(lower, "fcpys") { return matchTypeF32, true }
	if charsEqual(lower, "fcpyd") { return matchTypeF64, true }
	return 0, arm32VmovPreUal(lower)
}

// arm32VmovPreUal reports whether name (lowercase) is one of clang's pre-UAL names it takes as
// VMOV whether whole or split: fmrs, fmsr, fmrdd, fmrds, fmrrd, fmdrr.
func arm32VmovPreUal(name *[]readonly char) bool {
	var names @[]*[]readonly char = @[]*[]readonly char{"fmrs", "fmsr", "fmrdd", "fmrds", "fmrrd",
			"fmdrr"}
	for i := 0; i < len(names); i++ {
		if charsEqual(name, names[i]) { return true }
	}
	return false
}

// arm32VmovName returns the instruction (vmovName*) name (lowercase, split) is, with VFPv2 in
// effect for the pre-UAL names clang maps to VMOV, or 0 for none; and whether name is one of these
// or a pre-UAL name of one at all (clang's "invalid instruction" for one it does not map).
func arm32VmovName(p @Parser, name *[]readonly char) (int, bool) {
	if charsEqual(name, "vmov") { return vmovNameVmov, true }
	if charsEqual(name, "fmdhr") { return vmovNameFmdhr, true }
	if charsEqual(name, "fmdlr") { return vmovNameFmdlr, true }
	if charsEqual(name, "fconsts") { return vmovNameFconsts, true }
	if charsEqual(name, "fconstd") { return vmovNameFconstd, true }
	var preUal bool = arm32VmovPreUal(name) || charsEqual(name, "fcpys") || charsEqual(name, "fcpyd")
	if !preUal { return 0, false }
	if p.Arm32FP & armFpVFP2SP != 0 && arm32VmovPreUal(name) { return vmovNameVmov, true }
	return 0, true
}

// arm32VmovFPMask returns which written operands (bit j for operand j, from 0) clang reads as a
// floating-point immediate (arm32VmovFPOperand) when they start with `#` or `$`: the operands that
// come where an encoding of the mnemonic it parses has one (clang's operand parser runs by the
// operand's place, its condition, if not AL, and each type counted), with that encoding's features
// in effect -- for VMOV (mode vmovNameVmov) with a .F16, .F32 or .F64 among its suffixes rest
// (lowercase), places 2 and 3 (VFPv3, full FP16 or NEON); for fconsts and fconstd (mode
// vmovNameFconsts), 1 and 2 (VFPv3).  cond is the condition and nt the number of types.
func arm32VmovFPMask(p @Parser, mode int, cond int, nt int, rest *[]readonly char) int {
	var fp uint64 = p.Arm32FP
	var first int = 2
	if mode == vmovNameFconsts {
		if fp & armFpVFP3D16SP == 0 { return 0 }
		first = 1
	} else if mode == vmovNameVmov {
		if fp & (armFpVFP3D16SP | armFpFullFP16 | armFpNEON) == 0 { return 0 }
		var vmovf bool = false
		var start int = 1
		for i := 1; i <= len(rest); i++ {
			if i < len(rest) && rest[i] != '.' { continue }
			var part *[]readonly char = rest[start:i]
			start = i + 1
			if charsEqual(part, "f16") || charsEqual(part, "f32") || charsEqual(part, "f64") {
				vmovf = true
			}
		}
		if !vmovf { return 0 }
	} else {
		return 0
	}
	return arm32MatchPlaces(first, cond, nt)
}

// arm32VmovFPMode returns how clang reads a floating-point immediate (arm32VmovFPMask's mode) for
// the mnemonic it parses: VMOV's way for vmov as written and the names clang maps to a VMOV whole
// before it reads the operands (whole, the whole mnemonic as written, written; vmovq, vmovq.f32 and
// vmovq.f64 the NEON aliases), fconsts' way for fconsts and fconstd (kind, vmovName*), else none --
// the names clang maps once split only as it matches (fmrs.f32, fmrseq, vmovqeq.f32).
func arm32VmovFPMode(kind int, name *[]readonly char, whole bool, written *[]readonly char) int {
	if kind == vmovNameFconsts || kind == vmovNameFconstd { return vmovNameFconsts }
	if whole { return vmovNameVmov }
	if len(written) > 4 && arm32Lower(written[4]) == 'q' {
		var w @[]char = make_slice(char, len(written))
		for i := 0; i < len(written); i++ { w[i] = arm32Lower(written[i]) }
		if charsEqual(w, "vmovq") || charsEqual(w, "vmovq.f32") || charsEqual(w, "vmovq.f64") {
			return vmovNameVmov
		}
		return 0
	}
	if charsEqual(name, "vmov") { return vmovNameVmov }
	return 0
}

// arm32VmovLitBits returns the single-precision bits of the value a floating-point literal (text,
// as the lexer took it) rounds to (to nearest, ties to even; past the range, infinity), its sign
// bit set for neg as clang sets it, and whether text is one strconv.ParseFloat reads.
func arm32VmovLitBits(neg bool, text *[]readonly char) (int64, bool) {
	f, err := strconv.ParseFloat(text, 32)
	var b uint64 = bit_cast(uint64, f)
	var inf bool = b & 0x7FFFFFFFFFFFFFFF == 0x7FF0000000000000
	if present(err) && !inf { return 0, false }
	var bits int64 = arm32VmovSingle(b)
	if neg { bits = bits ^ 0x80000000 }
	return bits, true
}

// arm32VmovSingle returns the single-precision bits of b, a float64's bits that hold a value single
// precision holds (strconv.ParseFloat's at bitSize 32): zero, infinity, a normal value, or one
// below 2^-126, which single precision holds as a subnormal.
func arm32VmovSingle(b uint64) int64 {
	var sign int64 = cast(int64, b >> 63) << 31
	var exp int = cast(int, (b >> 52) & 0x7FF)
	var man uint64 = b & 0xFFFFFFFFFFFFF
	if exp == 0 { return sign }
	if exp == 0x7FF { return sign | 0x7F800000 }
	var e int = exp - 1023
	if e >= -126 { return sign | (cast(int64, e + 127) << 23) | cast(int64, man >> 29) }
	return sign | cast(int64, (man | (cast(uint64, 1) << 52)) >> cast(uint, -e - 97))
}

// arm32VmovFPBits returns the single-precision bits of the value an 8-bit floating-point immediate
// imm8 (abcdefgh) encodes: a, NOT(b), b five times, cdefgh, 19 zeros.
func arm32VmovFPBits(imm8 int) int64 {
	var u int64 = cast(int64, imm8)
	var b int64 = (u >> 6) & 1
	var bits int64 = ((u >> 7) << 31) | ((b ^ 1) << 30) | ((u & 63) << 19)
	if b != 0 { bits = bits | 0x3E000000 }
	return bits
}

// arm32VmovFPImm8 returns the 8-bit floating-point immediate whose value has the single-precision
// bits v (arm32VmovFPBits), or -1 for none (clang's isFPImm).
func arm32VmovFPImm8(v int64) int {
	if v < 0 || v > 0xFFFFFFFF || v & 0x7FFFF != 0 { return -1 }
	var b int64 = (v >> 25) & 1
	var five int64 = (v >> 25) & 31
	if (b == 1 && five != 31) || (b == 0 && five != 0) || ((v >> 30) & 1) == b { return -1 }
	return cast(int, ((v >> 31) << 7) | (b << 6) | ((v >> 19) & 63))
}

// arm32VmovFPOperand reads the operand at tok as clang's parseFPImm reads a floating-point
// immediate, l the lexer after tok: `#` or `$`, a `-` (a sign, which clang drops before an
// integer), and a floating-point literal (VMOV's, vmovf: the single-precision bits of the value it
// rounds to, arm32VmovLitBits) or an integer 0 .. 255 (fconsts' and
// fconstd's: the 8-bit encoding, its value's bits); anything else clang's "invalid floating point
// immediate".  It returns the lexer and the token after it, the operand, and whether it was read,
// setting the error if not.
func arm32VmovFPOperand(p @Parser, l Lexer, tok Token,
		vmovf bool) (Lexer, Token, arm32MatchItem, bool) {
	var it arm32MatchItem
	it.kind = matchItemImm
	l, _ = arm32ImmPrefix(l, tok, true)
	var next Token
	l, next = LexNext(l)
	var neg bool = next.Kind == TOK_MINUS
	if neg { l, next = LexNext(l) }
	if next.Kind == TOK_FLOAT && vmovf {
		it.val, it.known = arm32VmovLitBits(neg, next.Text)
		it.real = !it.known
	} else if (next.Kind == TOK_INT || next.Kind == TOK_CHAR) && !vmovf {
		if next.Ival < 0 || next.Ival > 255 {
			setErr(p, "encoded floating point value out of range")
			return l, next, it, false
		}
		it.known = true
		it.val = arm32VmovFPBits(cast(int, next.Ival))
	} else {
		setErr(p, "invalid floating point immediate")
		return l, next, it, false
	}
	l, tok = LexNext(l)
	return l, tok, it, true
}

// parseArm32Vmov assembles a VMOV or a pre-UAL name of one (arm32VmovName), mnem the mnemonic (as
// written, but for a NEON q alias's q, which written keeps) and l the lexer after it, reporting
// whether mnem names one.
func parseArm32Vmov(p @Parser, l Lexer, mnem *[]readonly char, written *[]readonly char) bool {
	if len(mnem) < 4 { return false }
	var first char = arm32Lower(mnem[0])
	if first != 'v' && first != 'f' { return false }
	var lower @[]char = make_slice(char, len(mnem))
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		lower[i] = arm32Lower(mnem[i])
		if mnem[i] == '.' { dot = i }
	}
	var types @[]int = make_slice(int, 3)
	var nt int = 0
	var kind int = vmovNameVmov
	var cond int = arm32.COND_AL
	var rest @[]char = lower[dot:len(lower)]
	var name @[]char = buf.CopyStr("vmov")
	t, whole := arm32VmovWhole(p, lower)
	if whole {
		rest = ""
		if t != 0 {
			types[0] = t
			nt = 1
			rest = ".f32"
			if t == matchTypeF64 { rest = ".f64" }
		}
	} else {
		split, c, carry := arm32VdpSplit(lower[0:dot])
		name = split
		if carry {
			// An `s` after one of these names, or one with a condition, is clang's flag-setting
			// suffix (vmovs, fmrseqs).
			_, ours := arm32VmovName(p, name)
			var n int = len(name)
			if !ours && n > 2 && parseArm32CondCode(name[n - 2:n]) >= 0 {
				_, ours = arm32VmovName(p, name[0:n - 2])
			}
			if !ours { return false }
			arm32VfpFlagsErr(p, name)
			return true
		}
		named, ours := arm32VmovName(p, name)
		if !ours { return false }
		var ok bool
		nt, ok = arm32MatchSuffixes(p, rest, types)
		if !ok { return true }
		if named == 0 {
			arm32VdpNone(p, l)
			return true
		}
		kind = named
		cond = c
	}
	var mode int = arm32VmovFPMode(kind, name, whole, written)
	var fpMask int = arm32VmovFPMask(p, mode, cond, nt, rest)
	items, ni, read := arm32MatchOperandsFP(p, l, fpMask, mode == vmovNameVmov)
	if !read { return true }
	var list @arm32MatchList = arm32VmovCands(kind)
	var i int = arm32MatchRun(p, list, cond, types, nt, items, ni)
	if i < 0 { return true }
	arm32VmovEmit(p, cond, list.c[i], items)
	return true
}
