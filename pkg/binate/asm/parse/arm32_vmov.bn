package "pkg/binate/asm/parse"

// The VFP moves VMOV (asm/arm32/vfp), as clang takes them, by their operands: Sd, Sm (.F32, .F
// or no type) and Dd, Dm (.F64); Vd, #imm (.F32, .F64, .F16; a floating-point literal an 8-bit
// immediate encodes); Sn, Rt and Rt, Sn (an 8-, 16- or 32-bit type or none; .F16 the
// half-precision move); Dm, Rt, Rt2 and Rt, Rt2, Dm (.F64 or none); Sm, Sm + 1, Rt, Rt2 and Rt,
// Rt2, Sm, Sm + 1 (no type); Dd[x], Rt and Rt, Dn[x] (a 32-bit type or none) -- and the pre-UAL
// names clang keeps for them (arm32_vmov_alias.bn).  The other VMOVs are NEON's.

// The kinds of VMOV operand (arm32VmovOperand).
const (
	vmovOpS int = iota // an S register (n)
	vmovOpD            // a D register (n)
	vmovOpR            // a core register (n)
	vmovOpLane         // a D register's lane (n, lane)
	vmovOpFloat        // a floating-point immediate (imm8; -1 for one no 8-bit immediate encodes)
	vmovOpInt          // an integer immediate (n its value, 1 << 20 for one past that)
	vmovOpQ            // a Q register (NEON's)
	vmovOpOther        // anything else (another name)
)

// arm32VmovOperand is a VMOV operand as written.
type arm32VmovOperand struct {
	kind int
	n    int
	lane int
	imm8 int
}

// The classes of VMOV data type (arm32VmovType).
const (
	vmovTypeNone int = iota
	vmovTypeF32             // .f32
	vmovTypeF               // .f, .F32's spelling everywhere but an immediate
	vmovTypeF64
	vmovTypeD               // .d, .F64's spelling everywhere but an immediate
	vmovTypeF16
	vmovTypeI32             // .32, .i32, .s32, .u32
	vmovTypeI16             // .16, .i16, .s16, .u16, .p16
	vmovTypeI8              // .8, .i8, .s8, .u8, .p8
	vmovTypeI64             // .64, .i64, .s64, .u64 (NEON\'s)
	vmovTypeOther
)

// arm32VmovType returns the class (vmovType*) of the data type t (no `.`; "" for none), in any
// case.
func arm32VmovType(t *[]readonly char) int {
	if len(t) == 0 { return vmovTypeNone }
	if mnemIs(t, "f32") { return vmovTypeF32 }
	if mnemIs(t, "f") { return vmovTypeF }
	if mnemIs(t, "f64") { return vmovTypeF64 }
	if mnemIs(t, "d") { return vmovTypeD }
	if mnemIs(t, "f16") { return vmovTypeF16 }
	if mnemIs(t, "32") || mnemIs(t, "i32") || mnemIs(t, "s32") || mnemIs(t, "u32") {
		return vmovTypeI32
	}
	if mnemIs(t, "16") || mnemIs(t, "i16") || mnemIs(t, "s16") || mnemIs(t, "u16") ||
			mnemIs(t, "p16") {
		return vmovTypeI16
	}
	if mnemIs(t, "8") || mnemIs(t, "i8") || mnemIs(t, "s8") || mnemIs(t, "u8") || mnemIs(t, "p8") {
		return vmovTypeI8
	}
	if mnemIs(t, "64") || mnemIs(t, "i64") || mnemIs(t, "s64") || mnemIs(t, "u64") {
		return vmovTypeI64
	}
	return vmovTypeOther
}

// parseArm32VmovLane reads a lane, `[` a constant expression `]`, at tok (the `[`), returning the
// lexer and token after it and the lane (-1 for one past 7), or false with the error set (clang's
// "immediate value expected for vector index" for an expression that is no constant).
func parseArm32VmovLane(p @Parser, l Lexer, tok Token) (Lexer, Token, int, bool) {
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid operand for instruction"))
		return l, tok, 0, false
	}
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "expected ']'")
		return l, tok, 0, false
	}
	if r.FromDiff || r.Pending || isSymbolic(r) || hasNeg(r) {
		setErr(p, "immediate value expected for vector index")
		return l, tok, 0, false
	}
	l, tok = LexNext(l)
	var lane int = -1
	if r.Val >= 0 && r.Val <= 7 { lane = cast(int, r.Val) }
	return l, tok, lane, true
}

// parseArm32VmovOperand reads the VMOV operand at tok (l the lexer after it): a register, a D
// register's lane, or an immediate -- `#` or `$`, perhaps `-`, and a floating-point literal (the
// value it rounds to in single precision, floatLitSingleImm) or an integer (a character literal
// too), as clang reads a floating-point immediate.  It returns the lexer and the token after
// it, the operand, and whether it was read, setting the error if not.
func parseArm32VmovOperand(p @Parser, l Lexer, tok Token) (Lexer, Token, arm32VmovOperand, bool) {
	var op arm32VmovOperand
	op.kind = vmovOpOther
	var dollar bool = tok.Kind == TOK_IDENT && len(tok.Text) > 1 && tok.Text[0] == '$'
	if tok.Kind == TOK_IDENT && !dollar {
		var s int = arm32VfpReg(tok.Text, 's')
		var d int = arm32VfpReg(tok.Text, 'd')
		var q int = arm32VfpReg(tok.Text, 'q')
		var r int = parseArm32Reg(tok.Text)
		l, tok = LexNext(l)
		if s >= 0 {
			op.kind = vmovOpS
			op.n = s
		} else if d >= 0 && tok.Kind == TOK_LBRACKET {
			var lane int
			var ok bool
			l, tok, lane, ok = parseArm32VmovLane(p, l, tok)
			if !ok { return l, tok, op, false }
			op.kind = vmovOpLane
			op.n = d
			op.lane = lane
		} else if d >= 0 {
			op.kind = vmovOpD
			op.n = d
		} else if q >= 0 && q < 16 {
			op.kind = vmovOpQ
			op.n = q
		} else if r >= 0 {
			op.kind = vmovOpR
			op.n = r
		}
		return l, tok, op, true
	}
	if tok.Kind == TOK_FLOAT {
		setErr(p, "unexpected token in operand")
		return l, tok, op, false
	}
	if tok.Kind != TOK_HASH && tok.Kind != TOK_DOLLAR && !dollar {
		l, tok = LexNext(l)
		return l, tok, op, true
	}
	// A name starting with `$` is `$` and what follows, as clang reads it (`$1.0`).
	l, _ = arm32ImmPrefix(l, tok, true)
	var next Token
	l, next = LexNext(l)
	var neg bool = next.Kind == TOK_MINUS
	if neg { l, next = LexNext(l) }
	if next.Kind == TOK_FLOAT {
		op.kind = vmovOpFloat
		op.imm8 = floatLitSingleImm(neg, next.Text)
	} else if next.Kind == TOK_INT || next.Kind == TOK_CHAR {
		// clang drops a sign before an integer here.
		op.kind = vmovOpInt
		op.n = 1 << 20
		if next.Ival >= 0 && next.Ival < 1 << 20 { op.n = cast(int, next.Ival) }
	} else {
		setErr(p, "invalid floating point immediate")
		return l, next, op, false
	}
	l, tok = LexNext(l)
	return l, tok, op, true
}

// parseArm32VmovOperands reads a VMOV's operands after l, up to five (five being too many),
// returning them, how many, and whether they were read, setting the error if not.
func parseArm32VmovOperands(p @Parser, l Lexer) (@[]arm32VmovOperand, int, bool) {
	var ops @[]arm32VmovOperand = make_slice(arm32VmovOperand, 5)
	var n int = 0
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF && n < 5 {
		var ok bool
		l, tok, ops[n], ok = parseArm32VmovOperand(p, l, tok)
		if !ok { return ops, n, false }
		n = n + 1
		if tok.Kind == TOK_EOF { break }
		if tok.Kind != TOK_COMMA {
			setErr(p, "unexpected token in argument list")
			return ops, n, false
		}
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
			setErr(p, "unexpected token in operand")
			return ops, n, false
		}
	}
	return ops, n, true
}

// arm32VmovMnem is a VMOV as its mnemonic (or a pre-UAL name) gives it: its condition and data
// type class (vmovType*), and for a pre-UAL name the operand kinds it takes (shape: one of the
// vmovOp* per operand, packed four bits each from the first, 0 for a VMOV), whether an integer
// immediate is the encoding (fconsts, fconstd) and the lane a D register stands for (fmdhr,
// fmdlr; -1 for none).
type arm32VmovMnem struct {
	cond    int
	class   int
	shape   int
	encoded bool
	lane    int
}

// parseArm32Vmov assembles a VMOV or one of the pre-UAL names clang keeps for one, mnem the
// mnemonic as written and l the lexer after it, reporting whether mnem names one.
func parseArm32Vmov(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) == 0 || (arm32Lower(mnem[0]) != 'v' && arm32Lower(mnem[0]) != 'f') { return false }
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		if mnem[i] == '.' { dot = i }
	}
	var head *[]readonly char = mnem[0:dot]
	var m arm32VmovMnem
	m.lane = -1
	var known bool
	m, known = arm32VmovAlias(p, head, mnem[dot:len(mnem)])
	if p.HasError { return true }
	if !known {
		named, cond, before := arm32VfpNamed(head, "vmov")
		if named == vfpNamedNone { return false }
		if named == vfpNamedFlags {
			arm32VfpFlagsErr(p, before)
			return true
		}
		t, count, ok := arm32VfpSuffixType(p, mnem[dot:len(mnem)])
		if !ok { return true }
		if count > 1 {
			setErr(p, "invalid instruction")
			return true
		}
		if count == 1 && len(t) == 0 {
			setErr(p, "invalid operand for instruction")
			return true
		}
		m.cond = cond
		m.class = arm32VmovType(t)
		m.lane = -1
	}
	ops, n, read := parseArm32VmovOperands(p, l)
	if !read { return true }
	arm32VmovForm(p, m, ops, n)
	return true
}
