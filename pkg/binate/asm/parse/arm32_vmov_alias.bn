package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"

// vmovShape packs the operand kinds a, b, c and d (vmovOp*; -1 for none past the last) into
// arm32VmovMnem's shape: each kind + 1 in four bits, the first operand's lowest.
func vmovShape(a int, b int, c int, d int) int {
	var shape int = 0
	if d >= 0 { shape = d + 1 }
	if c >= 0 { shape = (shape << 4) | (c + 1) }
	if b >= 0 { shape = (shape << 4) | (b + 1) }
	return (shape << 4) | (a + 1)
}

// arm32VmovShapeIs reports whether the n operands ops are of the kinds shape (vmovShape) packs.
func arm32VmovShapeIs(shape int, ops @[]arm32VmovOperand, n int) bool {
	for i := 0; i < n; i++ {
		if shape & 15 != ops[i].kind + 1 { return false }
		shape = shape >> 4
	}
	return shape == 0
}

// arm32VmovAlias returns the VMOV the pre-UAL name head (the mnemonic before its first `.`, in any
// case) is, rest its `.` suffixes, and whether it is one, as clang takes them: fcpys (VMOV.F32
// Sd, Sm) and fcpyd (VMOV.F64 Dd, Dm) only as the whole mnemonic; fmrs (Rt, Sn), fmsr (Sn, Rt),
// fmdrr (Dm, Rt, Rt2), fmrrd (Rt, Rt2, Dm), fmdhr and fmdlr (Dd[1] or Dd[0], Rt), fconsts and
// fconstd (Vd and an immediate's 8-bit encoding) with a condition and `.w` too, and fmrs, fmsr,
// fmdrr and fmrrd a type as their VMOV takes one.  It sets the error for a suffix the name can not
// have.
func arm32VmovAlias(p @Parser, head *[]readonly char, rest *[]readonly char) (arm32VmovMnem, bool) {
	var m arm32VmovMnem
	m.cond = arm32.COND_AL
	m.lane = -1
	if len(head) < 4 || arm32Lower(head[0]) != 'f' { return m, false }
	if arm32VmovAliasName(head) < 0 && len(head) > 4 && arm32Lower(head[len(head) - 1]) == 's' {
		// A name with an `s` after it is clang's flag-setting suffix (fcpyss, fmrseqs).
		var before *[]readonly char = head[0:len(head) - 1]
		if arm32VmovAliasName(before) >= 0 ||
				(len(before) > 2 && arm32VmovAliasName(before[0:len(before) - 2]) >= 0 &&
						parseArm32CondCode(before[len(before) - 2:len(before)]) >= 0) {
			arm32VfpFlagsErr(p, before)
			return m, true
		}
	}
	for i := 0; i < 10; i++ {
		var name *[]readonly char = arm32VmovAliasAt(i)
		var cond int = arm32.COND_AL
		if !mnemIs(head, name) {
			if i < 2 || len(head) != len(name) + 2 || !mnemIs(head[0:len(name)], name) { continue }
			cond = parseArm32CondCode(head[len(name):len(head)])
			if cond < 0 { continue }
		}
		if i < 2 && len(rest) > 0 {
			setErr(p, "invalid instruction")
			return m, true
		}
		t, count, ok := arm32VfpSuffixType(p, rest)
		if !ok { return m, true }
		if count == 1 && len(t) == 0 {
			setErr(p, "invalid operand for instruction")
			return m, true
		}
		if count > 1 || (count == 1 && (i < 2 || i > 5)) {
			setErr(p, "invalid instruction")
			return m, true
		}
		m.cond = cond
		m.class = arm32VmovAliasClass(i)
		if count == 1 { m.class = arm32VmovType(t) }
		m.shape = arm32VmovAliasShape(i)
		m.encoded = i >= 8
		if i == 6 { m.lane = 1 }
		if i == 7 { m.lane = 0 }
		return m, true
	}
	return m, false
}

// arm32VmovAliasAt returns pre-UAL VMOV name i: fcpys, fcpyd, fmrs, fmsr, fmdrr, fmrrd, fmdhr,
// fmdlr, fconsts, fconstd.
func arm32VmovAliasAt(i int) *[]readonly char {
	if i == 0 { return "fcpys" }
	if i == 1 { return "fcpyd" }
	if i == 2 { return "fmrs" }
	if i == 3 { return "fmsr" }
	if i == 4 { return "fmdrr" }
	if i == 5 { return "fmrrd" }
	if i == 6 { return "fmdhr" }
	if i == 7 { return "fmdlr" }
	if i == 8 { return "fconsts" }
	if i == 9 { return "fconstd" }
	return ""
}

// arm32VmovAliasName returns the index (arm32VmovAliasAt) of the pre-UAL VMOV name name, in any
// case, or -1.
func arm32VmovAliasName(name *[]readonly char) int {
	for i := 0; i < 10; i++ {
		if mnemIs(name, arm32VmovAliasAt(i)) { return i }
	}
	return -1
}

// arm32VmovAliasClass returns the data type class (vmovType*) of pre-UAL VMOV name i.
func arm32VmovAliasClass(i int) int {
	if i == 0 || i == 8 { return vmovTypeF32 }
	if i == 1 || i == 9 { return vmovTypeF64 }
	if i == 6 || i == 7 { return vmovTypeI32 }
	return vmovTypeNone
}

// arm32VmovAliasShape returns the operand kinds (vmovShape) pre-UAL VMOV name i takes.
func arm32VmovAliasShape(i int) int {
	if i == 0 { return vmovShape(vmovOpS, vmovOpS, -1, -1) }
	if i == 1 { return vmovShape(vmovOpD, vmovOpD, -1, -1) }
	if i == 2 { return vmovShape(vmovOpR, vmovOpS, -1, -1) }
	if i == 3 { return vmovShape(vmovOpS, vmovOpR, -1, -1) }
	if i == 4 { return vmovShape(vmovOpD, vmovOpR, vmovOpR, -1) }
	if i == 5 { return vmovShape(vmovOpR, vmovOpR, vmovOpD, -1) }
	if i == 6 || i == 7 { return vmovShape(vmovOpD, vmovOpR, -1, -1) }
	if i == 8 { return vmovShape(vmovOpS, vmovOpInt, -1, -1) }
	return vmovShape(vmovOpD, vmovOpInt, -1, -1)
}
