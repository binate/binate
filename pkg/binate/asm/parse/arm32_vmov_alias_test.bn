package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The pre-UAL names clang keeps for VMOV, as clang assembles them: fcpys and fcpyd as the whole
// mnemonic only; fmrs, fmsr, fmdrr, fmrrd, fmdhr, fmdlr, fconsts and fconstd with a condition and
// `.w` too, fmrs, fmsr, fmdrr and fmrrd a type as their VMOV does; fconsts and fconstd take an
// immediate's 8-bit encoding (a sign before it dropped), not a floating-point literal, and need
// only VFPv3.
func TestParseArm32VmovAliases() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "fcpys s0, s1", "EEB00A60")
	e = armGateIs(e, "", "fcpyd d0, d1", "EEB00B41")
	e = armGateIs(e, "", "fmrs r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmsr s1, r0", "EE000A90")
	e = armGateIs(e, "", "fmrseq r0, s1", "0E100A90")
	e = armGateIs(e, "", "fmsreq s1, r0", "0E000A90")
	e = armGateIs(e, "", "fmrs.w r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmdrr d0, r0, r1", "EC410B10")
	e = armGateIs(e, "", "fmrrd r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "fmdrreq d0, r0, r1", "0C410B10")
	e = armGateIs(e, "", "fmrrdeq r0, r1, d0", "0C510B10")
	e = armGateIs(e, "", "fmdhr d0, r0", "EE200B10")
	e = armGateIs(e, "", "fmdlr d0, r0", "EE000B10")
	e = armGateIs(e, "", "fmdhreq d0, r0", "0E200B10")
	e = armGateIs(e, "", "fconsts s0, #112", "EEB70A00")
	e = armGateIs(e, "", "fconstd d0, #112", "EEB70B00")
	e = armGateIs(e, "", "fconstseq s0, #112", "0EB70A00")
	e = armGateIs(e, "", "fconstdeq d0, #112", "0EB70B00")
	e = armGateIs(e, "", "fconsts s0, #0x70", "EEB70A00")
	e = armGateIs(e, "", "fconsts.w s0, #112", "EEB70A00")
	e = armGateIs(e, "", "fconsts s0, #-1", "EEB00A01")
	e = armGateIs(e, "", "fconsts s0, #'p'", "EEB70A00")
	e = armGateIs(e, "", "fmrs.f32 r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmsr.16 s1, r0", "EE000A90")
	e = armGateIs(e, "", "fmdrr.f64 d0, r0, r1", "EC410B10")
	e = armGateIs(e, ".fpu vfpv3xd", "fconstd d0, #112", "EEB70B00")
	e = armGateIs(e, ".fpu vfpv2", "fconsts s0, #112", "!invalid instruction")
	e = armGateIs(e, "", "fmrs.f64 r0, s1", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmsr.64 s1, r0", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmdhr.32 d0, r0", "!invalid instruction")
	e = armGateIs(e, "", "fcpyseq s0, s1", "!")
	e = armGateIs(e, "", "fcpydeq d0, d1", "!")
	e = armGateIs(e, "", "fcpys.w s0, s1", "!invalid instruction")
	e = armGateIs(e, "", "fconsts s0, #256", "!encoded floating point value out of range")
	e = armGateIs(e, "", "fconsts s0, #1.0", "!invalid floating point immediate")
	e = armGateIs(e, "", "fconsts s0, 112", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmrs s1, r0", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmsrr s0, s1, r0, r1", "!")
	e = armGateIs(e, "", "fmrdh r0, d0", "!")
	return e
}
