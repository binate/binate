package "pkg/binate/asm/parse"

// VMOV's encodings as clang's table has them, in the order it tries those of one length: the VFP's,
// NEON's lane moves, its modified immediates (with clang's aliases of them) and register copy, and
// MVE's, which never match here; and fmdhr's, fmdlr's, fconsts' and fconstd's.

// What an encoding of VMOV is (arm32MatchCand.tag), for arm32VmovEmit: the VFP's moves between two
// D or two S registers, an S register and a core register (either way), a D register and two core
// registers, two S registers and two core registers, a half-precision S register and a core
// register, by an immediate (.F64, .F32, .F16), a D register's 32-bit lane and a core register;
// NEON's 8- and 16-bit lane moves, its modified immediates (VMOV, VMVN and VMOV.I8 of a repeated
// byte as the encoding's operand class makes of the value), its VMOV.F32 by a floating-point
// immediate, its copy (VORR); fmdhr's and fmdlr's (the high and the low lane); and MVE's.
const (
	vmovTagDD int = iota + 1
	vmovTagSS
	vmovTagRS
	vmovTagSR
	vmovTagRRD
	vmovTagDRR
	vmovTagRRSS
	vmovTagSSRR
	vmovTagRH
	vmovTagHR
	vmovTagImmD
	vmovTagImmS
	vmovTagImmH
	vmovTagFromLane32
	vmovTagToLane32
	vmovTagFromLane
	vmovTagToLane
	vmovTagModImm
	vmovTagImmF32
	vmovTagVorr
	vmovTagFmdhr
	vmovTagFmdlr
	vmovTagMVE
)

// arm32VmovMost is the most encodings an instruction here has (arm32VmovCands).
const arm32VmovMost int = 96

// matchAddTag appends an encoding to list, as matchAdd does, tagged tag.
func matchAddTag(list @arm32MatchList, t1 int, ops int64, need int, form int, tag int) {
	matchAdd(list, t1, 0, ops, need, form)
	list.c[list.n - 1].tag = tag
}

// arm32VmovAddVfp appends the VFP's VMOV encodings to list: VMOV.F64 Dd, Dm (64-bit FP registers);
// VMOV.F32 Sd, Sm (FP registers, and with no type VFPv2); Rt, Sn and Sn, Rt with no type (FP
// registers) or .8, .16, .32 (VFPv2); Rt, Rt2, Dm and Dm, Rt, Rt2 with no type (FP registers) or
// .F64 (VFPv2); Rt, Rt2, Sm, Sm1 and Sm, Sm1, Rt, Rt2 (FP registers); .F16 Rt, Sn and Sn, Rt
// (16-bit FP registers, Rt rGPR); .F64 Dd, .F32 Sd and .F16 Sd by an immediate (VFPv3 and double
// precision, VFPv3, full FP16); .32 or no type Rt, Dn[x] (FP registers) and Dd[x], Rt (VFPv2).
func arm32VmovAddVfp(list @arm32MatchList) {
	var s int = matchKindS
	var d int = matchKindD
	var r int = matchKindCore
	var g int = matchKindRGPR
	var fpi int = matchKindFPImm
	var lane int = matchKindLane32
	var regs int = matchNeedFPRegs
	var vfp2 int = matchNeedVFP2
	var vfp int = matchFormVFP
	matchAddTag(list, matchTypeF64, matchOps(d, d, 0), matchNeedFPRegs64, vfp, vmovTagDD)
	matchAddTag(list, matchTypeF32, matchOps(s, s, 0), regs, vfp, vmovTagSS)
	matchAddTag(list, 0, matchOps(s, s, 0), vfp2, vfp, vmovTagSS)
	matchAddTag(list, 0, matchOps(r, s, 0), regs, vfp, vmovTagRS)
	matchAddTag(list, 0, matchOps(s, r, 0), regs, vfp, vmovTagSR)
	var sized @[]int = @[]int{matchType8, matchType16, matchType32}
	for i := 0; i < len(sized); i++ {
		matchAddTag(list, sized[i], matchOps(r, s, 0), vfp2, vfp, vmovTagRS)
		matchAddTag(list, sized[i], matchOps(s, r, 0), vfp2, vfp, vmovTagSR)
	}
	matchAddTag(list, 0, matchOps(r, r, d), regs, vfp, vmovTagRRD)
	matchAddTag(list, matchTypeF64, matchOps(r, r, d), vfp2, vfp, vmovTagRRD)
	matchAddTag(list, 0, matchOps(d, r, r), regs, vfp, vmovTagDRR)
	matchAddTag(list, matchTypeF64, matchOps(d, r, r), vfp2, vfp, vmovTagDRR)
	matchAddTag(list, 0, matchOps4(r, r, s, s), regs, vfp, vmovTagRRSS)
	matchAddTag(list, 0, matchOps4(s, s, r, r), regs, vfp, vmovTagSSRR)
	matchAddTag(list, matchTypeF16, matchOps(g, s, 0), matchNeedFPRegs16, vfp, vmovTagRH)
	matchAddTag(list, matchTypeF16, matchOps(s, g, 0), matchNeedFPRegs16, vfp, vmovTagHR)
	matchAddTag(list, matchTypeF64, matchOps(d, fpi, 0), matchNeedVFP3 | matchNeedDP, vfp, vmovTagImmD)
	matchAddTag(list, matchTypeF32, matchOps(s, fpi, 0), matchNeedVFP3, vfp, vmovTagImmS)
	matchAddTag(list, matchTypeF16, matchOps(s, fpi, 0), matchNeedFull16, vfp, vmovTagImmH)
	matchAddTag(list, matchType32, matchOps(r, d, lane), regs, vfp, vmovTagFromLane32)
	matchAddTag(list, 0, matchOps(r, d, lane), regs, vfp, vmovTagFromLane32)
	matchAddTag(list, matchType32, matchOps(d, lane, r), vfp2, vfp, vmovTagToLane32)
	matchAddTag(list, 0, matchOps(d, lane, r), vfp2, vfp, vmovTagToLane32)
}

// arm32VmovAddNeon appends NEON's VMOV encodings to list: .S8, .U8, .S16, .U16 Rt, Dn[x] and .8,
// .16 Dd[x], Rt (each with its condition); by an immediate on a D and a Q register, .I8, .I16,
// .I32, .I64 and .F32 (an 8-bit floating-point immediate's value), and clang's aliases -- .I16,
// .I32, .I64 of a repeated byte (VMOV.I8), .I32 and .I64 of a repeated 16-bit element
// (VMOV.I16), .I64 of a repeated 32-bit one (VMOV.I32), .I32 of a value VMOV.I32 takes inverted
// (VMVN.I32), .F32 of a value VMOV.I32 takes as bits; and the copy Vd, Vm (VORR) of two D or two Q
// registers, with no type or any of .8 .. .64.
func arm32VmovAddNeon(list @arm32MatchList) {
	var d int = matchKindD
	var q int = matchKindQ
	var r int = matchKindCore
	var neon int = matchNeedNEON
	var vfp int = matchFormVFP
	var simd int = matchFormSIMD
	var from @[]int = @[]int{matchTypeS8, matchTypeU8, matchTypeS16, matchTypeU16}
	var fromLane @[]int = @[]int{matchKindLane8, matchKindLane8, matchKindLane16, matchKindLane16}
	for i := 0; i < len(from); i++ {
		matchAddTag(list, from[i], matchOps(r, d, fromLane[i]), neon, vfp, vmovTagFromLane)
	}
	matchAddTag(list, matchType8, matchOps(d, matchKindLane8, r), neon, vfp, vmovTagToLane)
	matchAddTag(list, matchType16, matchOps(d, matchKindLane16, r), neon, vfp, vmovTagToLane)
	var i8 int = matchTypeI8
	var i16 int = matchTypeI16
	var i32 int = matchTypeI32
	var i64 int = matchTypeI64
	var f32 int = matchTypeF32
	var types @[]int = @[]int{i8, i16, i32, i64, f32, i16, i32, i64, i32, i64, i64, i32, f32}
	var kinds @[]int = @[]int{matchKindNSplatI8, matchKindNSplatI16, matchKindNVmovI32,
			matchKindNSplatI64, matchKindFPImm, matchKindNMovRep8x16, matchKindNMovRep8x32,
			matchKindNMovRep8x64, matchKindNMovRep16x32, matchKindNMovRep16x64, matchKindNMovRep32x64,
			matchKindNVmovI32Neg, matchKindNVmovI32}
	for i := 0; i < len(types); i++ {
		var tag int = vmovTagModImm
		if kinds[i] == matchKindFPImm { tag = vmovTagImmF32 }
		matchAddTag(list, types[i], matchOps(d, kinds[i], 0), neon, simd, tag)
		matchAddTag(list, types[i], matchOps(q, kinds[i], 0), neon, simd, tag)
	}
	var sizes @[]int = @[]int{0, matchType8, matchType16, matchType32, matchType64}
	for i := 0; i < len(sizes); i++ {
		matchAddTag(list, sizes[i], matchOps(d, d, 0), neon, simd, vmovTagVorr)
		matchAddTag(list, sizes[i], matchOps(q, q, 0), neon, simd, vmovTagVorr)
	}
}

// arm32VmovAddMve appends MVE's VMOV encodings to list, as near misses: by an immediate on Q0 .. Q7
// (.I8, .I16, .I32, .I64, .F32); .32 Qd[x], Rt and Rt, Qd[x] (ARMv8.1-M's FP registers), .16, .8
// and .S16, .U16, .S8, .U8 (MVE and ARMv8.1-M), each with its condition; and Qd[2|3], Qd[0|1], Rt,
// Rt2 and Rt, Rt2, Qd[2|3], Qd[0|1] (MVE and ARMv8.1-M).
func arm32VmovAddMve(list @arm32MatchList) {
	var mq int = matchKindMQ
	var g int = matchKindRGPR
	var mve int = matchNeedMVE
	var mveM int = matchNeedMVE | matchNeedV8_1M
	var cond int = matchFormMVECond
	var types @[]int = @[]int{matchTypeI8, matchTypeI16, matchTypeI32, matchTypeI64, matchTypeF32}
	var kinds @[]int = @[]int{matchKindNSplatI8, matchKindNSplatI16, matchKindNVmovI32,
			matchKindNSplatI64, matchKindFPImm}
	for i := 0; i < len(types); i++ {
		matchAddTag(list, types[i], matchOps(mq, kinds[i], 0), mve, matchFormMVE, vmovTagMVE)
	}
	var l4 int = matchKindLane16
	var l8 int = matchKindLane8
	var l16 int = matchKindLane0to15
	var fpm int = matchNeedFPRegsV8_1M
	matchAddTag(list, matchType32, matchOps(mq, l4, g), fpm, cond, vmovTagMVE)
	matchAddTag(list, matchType32, matchOps(g, mq, l4), fpm, cond, vmovTagMVE)
	matchAddTag(list, matchType16, matchOps(mq, l8, g), mveM, cond, vmovTagMVE)
	matchAddTag(list, matchType8, matchOps(mq, l16, g), mveM, cond, vmovTagMVE)
	var from @[]int = @[]int{matchTypeS16, matchTypeU16, matchTypeS8, matchTypeU8}
	var fromLane @[]int = @[]int{l8, l8, l16, l16}
	for i := 0; i < len(from); i++ {
		matchAddTag(list, from[i], matchOps(g, mq, fromLane[i]), mveM, cond, vmovTagMVE)
	}
	var p2 int = matchKindLanePair2
	var p0 int = matchKindLane32
	matchAddTag(list, 0, matchOps6(mq, p2, mq, p0, g, g), mveM, cond, vmovTagMVE)
	matchAddTag(list, 0, matchOps6(g, g, mq, p2, mq, p0), mveM, cond, vmovTagMVE)
}

// arm32VmovCands returns the encodings clang tries for instruction kind (vmovName*), in its order:
// VMOV's (arm32VmovAddVfp, arm32VmovAddNeon, arm32VmovAddMve); fmdhr's and fmdlr's, Dd, Rt (VFPv2);
// fconsts' Sd and fconstd's Dd by an immediate (VFPv3).
func arm32VmovCands(kind int) @arm32MatchList {
	var list @arm32MatchList = make(arm32MatchList)
	list.c = make_slice(arm32MatchCand, arm32VmovMost)
	var d int = matchKindD
	var vfp int = matchFormVFP
	if kind == vmovNameVmov {
		arm32VmovAddVfp(list)
		arm32VmovAddNeon(list)
		arm32VmovAddMve(list)
	} else if kind == vmovNameFmdhr {
		matchAddTag(list, 0, matchOps(d, matchKindCore, 0), matchNeedVFP2, vfp, vmovTagFmdhr)
	} else if kind == vmovNameFmdlr {
		matchAddTag(list, 0, matchOps(d, matchKindCore, 0), matchNeedVFP2, vfp, vmovTagFmdlr)
	} else if kind == vmovNameFconsts {
		matchAddTag(list, 0, matchOps(matchKindS, matchKindFPImm, 0), matchNeedVFP3, vfp, vmovTagImmS)
	} else {
		matchAddTag(list, 0, matchOps(d, matchKindFPImm, 0), matchNeedVFP3, vfp, vmovTagImmD)
	}
	arm32MatchSort(list)
	return list
}
