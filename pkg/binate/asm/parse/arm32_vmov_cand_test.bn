package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// VMOV's encodings: every one tagged, no more of them than the list holds, in order of length;
// fmdhr, fmdlr, fconsts and fconstd one each.
func TestArm32VmovCands() testing.TestResult {
	var list @arm32MatchList = arm32VmovCands(vmovNameVmov)
	if list.n < 80 || list.n > arm32VmovMost { return fail("VMOV has not its encodings") }
	for i := 0; i < list.n; i++ {
		if list.c[i].tag == 0 { return fail("a VMOV encoding is not tagged") }
		if i > 0 && arm32MatchLength(list.c[i]) < arm32MatchLength(list.c[i - 1]) {
			return fail("VMOV's encodings are not in order of length")
		}
	}
	var others @[]int = @[]int{vmovNameFmdhr, vmovNameFmdlr, vmovNameFconsts, vmovNameFconstd}
	for i := 0; i < len(others); i++ {
		if arm32VmovCands(others[i]).n != 1 { return fail("a pre-UAL VMOV name has not one encoding") }
	}
	return ""
}

// NEON's VMOVs as clang assembles them: the 8- and 16-bit lane moves (signed and unsigned, high
// registers, PC and SP, a condition, .S32 and .U8 as .32 and .8), by an immediate (.I8 .. .I64,
// .F32 by a floating-point immediate, an integer type standing for I, an expression) and clang's
// aliases (a repeated byte, 16-bit and 32-bit element, VMVN.I32 of the inversion, .F32 of a value
// whose single-precision bits VMOV.I32 takes as VMOV.I32 of them -- 0.0, -0.0, 32.0, 2^23, a
// subnormal), the copy as VORR (no type, any of .8 .. .64), vmovq; a lane's low 32 bits.
func TestParseArm32VmovNeon() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vmov.s8 r0, d1[7]", "EE710B70")
	e = armGateIs(e, "", "vmov.u8 lr, d31[0]", "EEDFEB90")
	e = armGateIs(e, "", "vmov.s16 r2, d16[3]", "EE302BF0")
	e = armGateIs(e, "", "vmov.u16 r3, d2[1]", "EE923B70")
	e = armGateIs(e, "", "vmov.8 d1[7], r0", "EE610B70")
	e = armGateIs(e, "", "vmov.16 d31[2], r12", "EE2FCBB0")
	e = armGateIs(e, "", "vmovgt.s8 r0, d1[3]", "CE510B70")
	e = armGateIs(e, "", "vmoveq.16 d1[1], sp", "0E01DB70")
	e = armGateIs(e, "", "vmov.i8 d0, #0xab", "F3820E1B")
	e = armGateIs(e, "", "vmov.i8 q15, #255", "F3C7EE5F")
	e = armGateIs(e, "", "vmov.i16 d0, #0xab00", "F3820A1B")
	e = armGateIs(e, "", "vmov.i16 q1, #0x00ab", "F382285B")
	e = armGateIs(e, "", "vmov.i32 d0, #0xab0000", "F382041B")
	e = armGateIs(e, "", "vmov.i32 q2, #0xabff", "F3824C5B")
	e = armGateIs(e, "", "vmov.i32 d0, #0xabffff", "F3820D1B")
	e = armGateIs(e, "", "vmov.i64 d0, #0xff00ff0000ff00ff", "F3820E35")
	e = armGateIs(e, "", "vmov.i64 q8, #-1", "F3C70E7F")
	e = armGateIs(e, "", "vmov.i16 d0, #0xabab", "F3820E1B")
	e = armGateIs(e, "", "vmov.i32 d0, #0xabababab", "F3820E1B")
	e = armGateIs(e, "", "vmov.i64 d0, #0x5454545454545454", "F2850E14")
	e = armGateIs(e, "", "vmov.i32 d0, #0xab00ab00", "F3820A1B")
	e = armGateIs(e, "", "vmov.i64 q0, #0x00ab00ab00ab00ab", "F382085B")
	e = armGateIs(e, "", "vmov.i64 d0, #0x0000ab000000ab00", "F382021B")
	e = armGateIs(e, "", "vmov.i32 d0, #-2", "F2800031")
	e = armGateIs(e, "", "vmov.f32 d0, #1.0", "F2870F10")
	e = armGateIs(e, "", "vmov.f32 q15, #-31.0", "F3C3EF5F")
	e = armGateIs(e, "", "vmov.f32 d0, #0.0", "F2800010")
	e = armGateIs(e, "", "vmov.f32 d0, #-0.0", "F3800610")
	e = armGateIs(e, "", "vmov.f32 d0, #32.0", "F2840612")
	e = armGateIs(e, "", "vmov.f32 q0, #-128.0", "F3840653")
	e = armGateIs(e, "", "vmov.f32 d0, #0.03125", "F283061D")
	e = armGateIs(e, "", "vmov.f32 d0, #8388608.0", "F284061B")
	e = armGateIs(e, "", "vmov.f32 d0, #1.4e-45", "F2800011")
	e = armGateIs(e, "", "vmov.s32 d0, #0xab", "F382001B")
	e = armGateIs(e, "", "vmov.u16 d0, #0xab", "F382081B")
	e = armGateIs(e, "", "vmov d0, d1", "F2210111")
	e = armGateIs(e, "", "vmov q15, q14", "F26CE1FC")
	e = armGateIs(e, "", "vmov.i8 d0, d1", "F2210111")
	e = armGateIs(e, "", "vmov.s16 q0, q1", "F2220152")
	e = armGateIs(e, "", "vmov.f32 d31, d30", "F26EF1BE")
	e = armGateIs(e, "", "vmovq q0, q1", "F2220152")
	e = armGateIs(e, "", "vmovq.f32 q0, #1.0", "F2870F50")
	e = armGateIs(e, "", "vmov.i32 d0, #(1 << 8)", "F2800211")
	e = armGateIs(e, "", "vmov.i32 d0, #0x1ff", "F2800C11")
	e = armGateIs(e, "", "vmov.s32 r0, d0[0]", "EE100B10")
	e = armGateIs(e, "", "vmov.u8 d0[0], r0", "EE400B10")
	e = armGateIs(e, "", "vmov.32 r0, d0[4294967297]", "EE300B10")
	e = armGateIs(e, "", "vmov.s8 r0, d0[4294967303]", "EE700B70")
	e = armGateIs(e, "", "vmov.8 d0[4294967303], r0", "EE600B70")
	e = armGateIs(e, "", "vmov.16 d0[4294967299], r0", "EE200B70")
	e = armGateIs(e, "", "vmov.32 d0[4294967297], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 r0, d0[-4294967295]", "EE300B10")
	return e
}

// What clang does not take of them, with its message: a value no class takes, a type none has, a
// lane past the register's, an integer for .F32, the lane moves of other types, MVE's (as near
// misses, Q8 not even that), no NEON (VFPv3's floating-point immediate read only with VFPv3), D16
// without 32 D registers; and here a condition, which clang drops, a value past the data type's
// range, which clang cuts to its low bits, and clang's negative zero, which clang takes as -2^31
// (a value after a `-` whose low 32 bits are 0, -2^32 too).
func TestParseArm32VmovNeonRejects() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var v3 *[]readonly char = ".fpu vfpv3"
	var v2 *[]readonly char = ".fpu vfpv2"
	var d16 *[]readonly char = ".fpu vfpv3-d16"
	e = armMsgIs(e, "", "vmov.i32 q0, #0xffab0000", several)
	e = armMsgIs(e, "", "vmov.p8 d0, #1", several)
	e = armMsgIs(e, "", "vmov.p64 d0, d1", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmov.i8 d0, #0x100", several)
	e = armMsgIs(e, "", "vmov.i8 d0, #-1", several)
	e = armMsgIs(e, "", "vmov.i16 d0, #0x1ff", several)
	e = armMsgIs(e, "", "vmov.i64 d0, #0xab", several)
	e = armMsgIs(e, "", "vmov.i32 d0, #0xffffff00", several)
	e = armMsgIs(e, "", "vmov.f32 d0, #1", "invalid floating point immediate")
	e = armMsgIs(e, "", "vmov.f32 d0, #0.1", several)
	e = armMsgIs(e, "", "vmov.f64 d0, #0.0", several)
	e = armMsgIs(e, "", "vmov.i32 s0, #1", several)
	e = armMsgIs(e, "", "vmov.s8 r0, d0[8]", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmov.16 d0[4], r0", several)
	e = armMsgIs(e, "", "vmov.8 r0, d0[0]", "invalid operand for instruction")
	e = armMsgIs(e, "", "vmov.32 q0[1], r0", several)
	e = armMsgIs(e, "", "vmov.32 r0, q0[1]", several)
	e = armMsgIs(e, "", "vmov.8 q0[9], r0", "instruction requires: mve armv8.1m.main")
	e = armMsgIs(e, "", "vmov.s16 r0, q1[5]", "instruction requires: mve armv8.1m.main")
	e = armMsgIs(e, "", "vmov r0, r1, q0[2], q0[0]", "instruction requires: mve armv8.1m.main")
	e = armMsgIs(e, "", "vmov q0[2], q0[0], r0, r1", "instruction requires: mve armv8.1m.main")
	e = armMsgIs(e, "", "vmov.32 q8[1], r0", "operand must be a register in range [d0, d31]")
	e = armMsgIs(e, "", "vmov.i64 q0, #0x1ff", several)
	e = armMsgIs(e, "", "vmoveq.i32 d0, #1",
			"instruction 'vmov' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vmoveq d0, d1",
			"instruction 'vmov' is not predicable, but condition code specified")
	e = armMsgIs(e, "", "vmov.i16 d0, #0x1000000ab",
			"operand must be an immediate in the range [-32768,65535]")
	e = armMsgIs(e, "", "vmov.i32 d0, #0x1000000ab", several)
	e = armMsgIs(e, "", "vmov.i32 d0, #0x1abababab",
			"operand must be an immediate in the range [-2147483648,4294967295]")
	e = armMsgIs(e, "", "vmov.i32 d0, #-0", several)
	e = armMsgIs(e, "", "vmov.i16 d0, #-0", several)
	e = armMsgIs(e, v3, "vmov.i32 d0, #1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vmov.i8 q0, #1", several)
	e = armMsgIs(e, v3, "vmov.f32 q0, #1.0", several)
	e = armMsgIs(e, v2, "vmov.f32 q0, #1.0", "invalid instruction")
	e = armMsgIs(e, v3, "vmov.f32 q0, #0.0", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vmov.s8 r0, d1[1]", several)
	e = armMsgIs(e, v3, "vmov.8 d1[1], r0", several)
	e = armMsgIs(e, v3, "vmov d0, d1", "instruction requires: NEON")
	e = armMsgIs(e, v3, "vmov.i64 q0, #0xff00", several)
	e = armMsgIs(e, d16, "vmov.32 d16[1], r0", "unexpected token in argument list")
	e = armMsgIs(e, "", "vmov.i64 d1, #-0x100000000", several)
	e = armMsgIs(e, "", "vmov.i64 q0, #-0x1000000000000", several)
	e = armMsgIs(e, "", "vmov.i64 d0, #-0x100000001", several)
	return e
}
