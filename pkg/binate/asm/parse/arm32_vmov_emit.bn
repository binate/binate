package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/neon"
import "pkg/binate/asm/arm32/vfp"

// arm32VmovEmit assembles a VMOV (or fmdhr, fmdlr, fconsts, fconstd) under cond as encoding c
// (arm32VmovCands), a lane its low 32 bits as clang takes it, its operands items, with the checks
// clang makes once an encoding matches: a VMOV of two S registers and two core registers wants the
// S registers sequential, the half-precision forms are unconditional and NEON's modified immediates
// and copy are too (clang drops the condition; an error here), and a modified immediate's value is
// within its data type's range (clang looks only at its low bits).
func arm32VmovEmit(p @Parser, cond int, c arm32MatchCand, items @[]arm32MatchItem) {
	var t int = c.tag
	if t == vmovTagDD {
		vfp.VmovReg(p.Asm, cond, 64, vfp.D0 + items[0].n, vfp.D0 + items[1].n)
	} else if t == vmovTagSS {
		vfp.VmovReg(p.Asm, cond, 32, vfp.S0 + items[0].n, vfp.S0 + items[1].n)
	} else if t == vmovTagRS {
		vfp.VmovSingleToCore(p.Asm, cond, items[0].n, vfp.S0 + items[1].n)
	} else if t == vmovTagSR {
		vfp.VmovCoreToSingle(p.Asm, cond, vfp.S0 + items[0].n, items[1].n)
	} else if t == vmovTagRRD {
		vfp.VmovDoubleToCores(p.Asm, cond, items[0].n, items[1].n, vfp.D0 + items[2].n)
	} else if t == vmovTagDRR {
		vfp.VmovCoresToDouble(p.Asm, cond, vfp.D0 + items[0].n, items[1].n, items[2].n)
	} else if t == vmovTagRRSS {
		if items[3].n != items[2].n + 1 {
			setErr(p, "source operands must be sequential")
			return
		}
		vfp.VmovSinglesToCores(p.Asm, cond, items[0].n, items[1].n, vfp.S0 + items[2].n)
	} else if t == vmovTagSSRR {
		if items[1].n != items[0].n + 1 {
			setErr(p, "destination operands must be sequential")
			return
		}
		vfp.VmovCoresToSingles(p.Asm, cond, vfp.S0 + items[0].n, items[2].n, items[3].n)
	} else if t == vmovTagRH || t == vmovTagHR || t == vmovTagImmH {
		arm32VmovEmitHalf(p, t, cond, items)
	} else if t == vmovTagImmD || t == vmovTagImmS {
		var size int = 32
		var first int = vfp.S0
		if t == vmovTagImmD {
			size = 64
			first = vfp.D0
		}
		vfp.VmovImm(p.Asm, cond, size, first + items[0].n, arm32VmovFPImm8(items[1].val))
	} else if t == vmovTagFromLane32 {
		vfp.VmovLaneToCore(p.Asm, cond, items[0].n, vfp.D0 + items[1].n,
				cast(int, cast(uint32, items[2].val)))
	} else if t == vmovTagToLane32 {
		vfp.VmovCoreToLane(p.Asm, cond, vfp.D0 + items[0].n, cast(int, cast(uint32, items[1].val)),
				items[2].n)
	} else if t == vmovTagFmdhr || t == vmovTagFmdlr {
		var x int = 0
		if t == vmovTagFmdhr { x = 1 }
		vfp.VmovCoreToLane(p.Asm, cond, vfp.D0 + items[0].n, x, items[1].n)
	} else if t == vmovTagFromLane {
		var size int = 8
		if c.t1 == matchTypeS16 || c.t1 == matchTypeU16 { size = 16 }
		var unsigned bool = c.t1 == matchTypeU8 || c.t1 == matchTypeU16
		neon.VmovFromLane(p.Asm, cond, size, unsigned, items[0].n, vfp.D0 + items[1].n,
				cast(int, cast(uint32, items[2].val)))
	} else if t == vmovTagToLane {
		var size int = 8
		if c.t1 == matchType16 { size = 16 }
		neon.VmovToLane(p.Asm, cond, size, vfp.D0 + items[0].n, cast(int, cast(uint32, items[1].val)),
				items[2].n)
	} else if !arm32NeonUnconditional(p, "vmov", cond) {
		return
	} else if t == vmovTagModImm {
		arm32VmovEmitModImm(p, c, items)
	} else if t == vmovTagImmF32 {
		neon.ModImm(p.Asm, neon.IMM_VMOV, neon.DT_F32, arm32NeonReg(items[0]),
				bit_cast(uint64, items[1].val))
	} else if t == vmovTagVorr {
		var r int = arm32NeonReg(items[1])
		neon.Three(p.Asm, neon.THREE_VORR, 0, arm32NeonReg(items[0]), r, r)
	} else {
		setErr(p, "internal error: a VMOV encoding with no emitter matched")
	}
}

// arm32VmovEmitHalf assembles VMOV.F16 Rt, Sn (tag vmovTagRH), Sn, Rt (vmovTagHR) or Sd, #imm
// (vmovTagImmH), its operands items, under cond: clang's "instruction is not predicable" for a
// condition.
func arm32VmovEmitHalf(p @Parser, t int, cond int, items @[]arm32MatchItem) {
	if cond != arm32.COND_AL {
		setErr(p, "instruction is not predicable")
		return
	}
	if t == vmovTagRH {
		vfp.VmovHalfToCore(p.Asm, items[0].n, vfp.S0 + items[1].n)
	} else if t == vmovTagHR {
		vfp.VmovCoreToHalf(p.Asm, vfp.S0 + items[0].n, items[1].n)
	} else {
		vfp.VmovImm(p.Asm, cond, 16, vfp.S0 + items[0].n, arm32VmovFPImm8(items[1].val))
	}
}

// arm32VmovEmitModImm assembles NEON's VMOV by a modified immediate as encoding c (its data type
// and its immediate's operand class), its operands items: the value within the data type's range
// (.I16 and .I32), then VMOV of the element the class finds in it -- of the value as .I8, .I16,
// .I32 or .I64, of a repeated byte as .I8, of a repeated 16- or 32-bit element as .I16 or .I32 --
// or VMVN.I32 of its inversion.
func arm32VmovEmitModImm(p @Parser, c arm32MatchCand, items @[]arm32MatchItem) {
	var v int64 = items[1].val
	if c.t1 == matchTypeI16 && (v < -32768 || v > 65535) {
		setErr(p, "operand must be an immediate in the range [-32768,65535]")
		return
	}
	if c.t1 == matchTypeI32 && (v < -2147483648 || v > 4294967295) {
		setErr(p, "operand must be an immediate in the range [-2147483648,4294967295]")
		return
	}
	var u uint64 = bit_cast(uint64, v)
	var k int = arm32MatchKindAt(c.ops, 1)
	var op int = neon.IMM_VMOV
	var dt int = neon.DT_I32
	var value uint64 = u & 0xFFFFFFFF
	if k == matchKindNSplatI8 || (k >= matchKindNMovRep8x16 && k <= matchKindNMovRep8x64) {
		dt = neon.DT_I8
		value = u & 0xFF
	} else if k == matchKindNSplatI16 || k == matchKindNMovRep16x32 || k == matchKindNMovRep16x64 {
		dt = neon.DT_I16
		value = u & 0xFFFF
	} else if k == matchKindNSplatI64 {
		dt = neon.DT_I64
		value = u
	} else if k == matchKindNVmovI32Neg {
		op = neon.IMM_VMVN
		value = ~u & 0xFFFFFFFF
	}
	neon.ModImm(p.Asm, op, dt, arm32NeonReg(items[0]), value)
}
