package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// What clang does not take of VMOV, with its message: S registers out of sequence, an integer or
// another literal no 8-bit immediate encodes, a literal with no `#`, a type the form has not,
// too few or too many operands, a lane past 1; and the gates -- the FP registers, VFPv2 for a
// lane's write and for the forms with no type, VFPv3 for an immediate, double precision for .F64,
// 32 D registers past D15, NEON for a D register copy, the 16-bit FP registers and full FP16 for
// .F16 (unconditional, not with PC) -- each clang's one message or its several, as its near
// misses add up.
func TestParseArm32VmovRejects() testing.TestResult {
	var e @[]char = ""
	var half *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	var bad *[]readonly char = "!invalid operand for instruction"
	var fpi *[]readonly char = "!invalid floating point immediate"
	var several *[]readonly char = "!invalid instruction, any one of the following would fix this:"
	e = armGateIs(e, "", "vmov s31, s0, r0, r1", "!destination operands must be sequential")
	e = armGateIs(e, "", "vmov s0, s2, r0, r1", "!destination operands must be sequential")
	e = armGateIs(e, "", "vmov r0, r1, s0, s2", "!source operands must be sequential")
	e = armGateIs(e, "", "vmov.f32 s0, #1", fpi)
	e = armGateIs(e, "", "vmov.f32 s0, #0x70", fpi)
	e = armGateIs(e, "", "vmov.f32 s0, #(1.0)", fpi)
	e = armGateIs(e, "", "vmov.f32 s0, #+1.0", fpi)
	e = armGateIs(e, "", "vmov.f32 s0, #1.0+0", "!")
	e = armGateIs(e, "", "vmov.f32 s0, 1.0", "!unexpected token in operand")
	e = armGateIs(e, "", "vmov.f32 s0, #0.1", several)
	e = armGateIs(e, "", "vmov.f32 s0, #0.0", several)
	e = armGateIs(e, "", "vmov.f32 s0, #32.0", several)
	e = armGateIs(e, "", "vmov.f s0, #1.0", several)
	e = armGateIs(e, "", "vmov.f64 s0, s1", bad)
	e = armGateIs(e, "", "vmov.f32 r0, r1, d0", bad)
	e = armGateIs(e, "", "vmov.f16 s0, r0", several)
	e = armGateIs(e, "", "vmov.64 s0, r0", bad)
	e = armGateIs(e, "", "vmov.d s0, r0", bad)
	e = armGateIs(e, "", "vmov.d d0, #1.0", several)
	e = armGateIs(e, "", "vmov.d s0, s1", bad)
	e = armGateIs(e, "", "vmov.i64 r0, s0", bad)
	e = armGateIs(e, "", "vmov.32.32 s0, r0", "!invalid instruction")
	e = armGateIs(e, "", "vmov.n s0, r0", "!instruction with .n (narrow) qualifier not allowed")
	e = armGateIs(e, "", "vmov.32 d0[2], r0", several)
	e = armGateIs(e, "", "vmov s0", "!too few operands for instruction")
	e = armGateIs(e, "", "vmov r0, r1, d0, d1, d2", "!invalid instruction")
	e = armGateIs(e, ".arch armv6", "vmov s0, r0", "!instruction requires: fp registers")
	e = armGateIs(e, ".arch armv6", "vmov.f32 s0, #1.0", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "vmov.32 d0[1], r0", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu none", "vmov.32 r0, d0[1]", "EE300B10")
	e = armGateIs(e, ".fpu none", "vmov s0, s1", several)
	e = armGateIs(e, ".fpu none", "vmov.f32 s0, s1", "EEB00A60")
	e = armGateIs(e, ".fpu none", "vmov s0, r0", "EE000A10")
	e = armGateIs(e, ".fpu none", "vmov.32 s0, r0", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu none", "vmov r0, r1, d0", "EC510B10")
	e = armGateIs(e, ".fpu none", "vmov.f64 r0, r1, d0", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu none", "fmrs r0, s1", "!invalid instruction")
	e = armGateIs(e, ".fpu none", "fmdhr d0, r0", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu none", "vmov.f32 s0, #1.0",
			"!operand must be a register in range [s0, s31]")
	e = armGateIs(e, ".fpu vfpv2", "vmov.f64 d16, d1",
			"!operand must be a register in range [d0, d15]")
	e = armGateIs(e, ".fpu vfpv2", "vmov d16, r0, r1",
			"!operand must be a register in range [d0, d15]")
	e = armGateIs(e, ".fpu vfpv2", "vmov d0, d1", "!instruction requires: NEON")
	e = armGateIs(e, ".fpu vfpv3xd", "vmov.f64 d0, #1.0", several)
	e = armGateIs(e, ".fpu vfpv3xd", "vmov.f32 s0, #1.0", "EEB70A00")
	e = armGateIs(e, half, "vmov.f16 s0, #1.0", "EEB70900")
	e = armGateIs(e, half, "vmov.f16 r0, s1", "EE100990")
	e = armGateIs(e, half, "vmov.f16 s1, r0", "EE000990")
	e = armGateIs(e, half, "vmov.f16 sp, s1", "EE10D990")
	e = armGateIs(e, half, "vmoveq.f16 r0, s1", "!instruction is not predicable")
	e = armGateIs(e, half, "vmov.f16 pc, s1", several)
	e = armGateIs(e, "", "vmov. s0, s1", bad)
	e = armGateIs(e, "", "vmoveq. r0, s0", bad)
	e = armGateIs(e, "", "fmrs. r0, s0", bad)
	e = armGateIs(e, ".fpu vfpv2", "vmov.i32 d0, #1", "!instruction requires: NEON")
	e = armGateIs(e, "", "fcpyss s0, s1", "!instruction 'fcpys' can not set flags")
	e = armGateIs(e, "", "fmrseqs r0, s1", "!instruction 'fmrseq' can not set flags")
	e = armGateIs(e, "", "vmov.32 d0[lbl], r0", "!immediate value expected for vector index")
	return e
}
