package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"

// arm32VmovNeed reports whether the FP features want are in effect, else sets clang's
// "instruction requires: what" -- or, with a D register past D15 too (high) and no 32 D
// registers, its "invalid instruction".
func arm32VmovNeed(p @Parser, want uint64, what *[]readonly char, high bool) bool {
	if p.Arm32FP & want == want { return true }
	if high && p.Arm32FP & armFpD32 == 0 {
		setErr(p, "invalid instruction")
	} else {
		setErr(p, buf.Concat("instruction requires: ", what))
	}
	return false
}

// arm32VmovHigh reports whether any of the n operands ops is a D register past D15 (or its lane).
func arm32VmovHigh(ops @[]arm32VmovOperand, n int) bool {
	for i := 0; i < n; i++ {
		if (ops[i].kind == vmovOpD || ops[i].kind == vmovOpLane) && ops[i].n >= 16 { return true }
	}
	return false
}

// arm32VmovD32 reports whether the D registers among the n operands ops are ones there are (D16
// .. D31 only with 32 D registers), else sets clang's error.
func arm32VmovD32(p @Parser, ops @[]arm32VmovOperand, n int) bool {
	if !arm32VmovHigh(ops, n) || p.Arm32FP & armFpD32 != 0 { return true }
	setErr(p, "operand must be a register in range [d0, d15]")
	return false
}

// arm32VmovNeon sets the error for a VMOV that is NEON's (a D register copy with no type, a lane
// of 8 or 16 bits): clang's when NEON is not in effect.
func arm32VmovNeon(p @Parser) {
	if p.Arm32FP & armFpNEON == 0 {
		setErr(p, "instruction requires: NEON")
	} else {
		setErr(p, "NEON (Advanced SIMD) instructions are not supported yet")
	}
}

// arm32VmovIsNeon reports whether the VMOV m with its n operands ops is one of NEON's: a Q
// register; an integer immediate to a D register or with an integer type; a floating-point one
// to a D register as .F32 or .F; a copy of D registers as .F32 (fcpys too) or with an integer
// type.
func arm32VmovIsNeon(m arm32VmovMnem, ops @[]arm32VmovOperand, n int) bool {
	for i := 0; i < n; i++ {
		if ops[i].kind == vmovOpQ { return true }
	}
	if n != 2 || ops[0].kind != vmovOpD { return false }
	var c int = m.class
	var integer bool = c == vmovTypeI32 || c == vmovTypeI16 || c == vmovTypeI8 || c == vmovTypeI64
	var single bool = c == vmovTypeF32 || c == vmovTypeF
	if ops[1].kind == vmovOpInt { return !m.encoded && integer }
	if ops[1].kind == vmovOpFloat { return single }
	return ops[1].kind == vmovOpD && (single || integer)
}

// arm32VmovForm assembles the VMOV m with its n operands ops (parseArm32VmovOperands), as clang
// takes them, or sets clang's error.
func arm32VmovForm(p @Parser, m arm32VmovMnem, ops @[]arm32VmovOperand, n int) {
	if n > 4 {
		setErr(p, "too many operands for instruction")
		return
	}
	if n < 2 {
		setErr(p, "too few operands for instruction")
		return
	}
	if arm32VmovIsNeon(m, ops, n) {
		arm32VmovNeon(p)
		return
	}
	if m.shape != 0 {
		// clang's pre-UAL names for the moves need VFPv2 (its other spellings, the FP registers),
		// fmdhr, fmdlr, fconsts and fconstd apart.
		if !m.encoded && m.lane < 0 && p.Arm32FP & armFpVFP2SP == 0 {
			setErr(p, "invalid instruction")
			return
		}
		if m.encoded && n == 2 && ops[1].kind == vmovOpFloat {
			setErr(p, "invalid floating point immediate")
			return
		}
		if !arm32VmovShapeIs(m.shape, ops, n) {
			setErr(p, "invalid operand for instruction")
			return
		}
		if m.lane >= 0 {
			ops[0].kind = vmovOpLane
			ops[0].lane = m.lane
		}
		if m.encoded {
			if ops[1].n > 255 {
				setErr(p, "encoded floating point value out of range")
				return
			}
			ops[1].kind = vmovOpFloat
			ops[1].imm8 = ops[1].n
		}
	} else if n == 2 && ops[1].kind == vmovOpInt {
		if m.class == vmovTypeI32 || m.class == vmovTypeI16 || m.class == vmovTypeI8 ||
				m.class == vmovTypeI64 {
			arm32VmovNeon(p)
		} else {
			setErr(p, "invalid floating point immediate")
		}
		return
	} else if n == 2 && ops[1].kind == vmovOpFloat && m.class == vmovTypeF {
		setErr(p, "invalid operand for instruction")
		return
	}
	if n == 2 {
		arm32VmovTwo(p, m, ops)
	} else if n == 3 {
		arm32VmovPair(p, m, ops)
	} else {
		arm32VmovSingles(p, m, ops)
	}
}

// arm32VmovTwo assembles a two-operand VMOV: a register copy, an immediate, an S register to or
// from a core register, a D register's 32-bit lane to or from one.
func arm32VmovTwo(p @Parser, m arm32VmovMnem, ops @[]arm32VmovOperand) {
	var a arm32VmovOperand = ops[0]
	var b arm32VmovOperand = ops[1]
	var c int = m.class
	var any32 bool = c == vmovTypeNone || c == vmovTypeF32 || c == vmovTypeF || c == vmovTypeI32
	var high bool = arm32VmovHigh(ops, 2)
	if a.kind == vmovOpS && b.kind == vmovOpS {
		if c != vmovTypeNone && c != vmovTypeF32 && c != vmovTypeF {
			setErr(p, "invalid operand for instruction")
		} else if (c == vmovTypeNone && arm32VmovNeed(p, armFpVFP2SP, "VFP2", false)) ||
				(c != vmovTypeNone && arm32VmovNeed(p, armFpRegs, "fp registers", false)) {
			vfp.VmovReg(p.Asm, m.cond, 32, vfp.S0 + a.n, vfp.S0 + b.n)
		}
	} else if a.kind == vmovOpD && b.kind == vmovOpD {
		if c == vmovTypeF16 || c == vmovTypeOther {
			setErr(p, "invalid operand for instruction")
		} else if c != vmovTypeF64 && c != vmovTypeD {
			arm32VmovNeon(p)
		} else if arm32VmovNeed(p, armFpRegs64, "64-bit fp registers", high) && arm32VmovD32(p, ops, 2) {
			vfp.VmovReg(p.Asm, m.cond, 64, vfp.D0 + a.n, vfp.D0 + b.n)
		}
	} else if (a.kind == vmovOpS && b.kind == vmovOpR) || (a.kind == vmovOpR && b.kind == vmovOpS) {
		arm32VmovCore(p, m, a, b)
	} else if (a.kind == vmovOpLane && b.kind == vmovOpR) ||
			(a.kind == vmovOpR && b.kind == vmovOpLane) {
		var lane arm32VmovOperand = a
		if a.kind == vmovOpR { lane = b }
		if c == vmovTypeI16 || c == vmovTypeI8 {
			arm32VmovNeon(p)
		} else if !any32 || lane.lane < 0 || lane.lane > 1 {
			setErr(p, "invalid operand for instruction")
		} else if a.kind == vmovOpLane {
			if arm32VmovNeed(p, armFpVFP2SP, "VFP2", high) && arm32VmovD32(p, ops, 2) {
				vfp.VmovCoreToLane(p.Asm, m.cond, vfp.D0 + a.n, a.lane, arm32.R0 + b.n)
			}
		} else if arm32VmovNeed(p, armFpRegs, "fp registers", high) && arm32VmovD32(p, ops, 2) {
			vfp.VmovLaneToCore(p.Asm, m.cond, arm32.R0 + a.n, vfp.D0 + b.n, b.lane)
		}
	} else if (a.kind == vmovOpS || a.kind == vmovOpD) && b.kind == vmovOpFloat {
		arm32VmovImm(p, m, a, b, high)
	} else {
		setErr(p, "invalid operand for instruction")
	}
}

// arm32VmovCore assembles VMOV Sn, Rt or Rt, Sn (a, b): an 8-, 16- or 32-bit type (VFPv2, a
// spelling clang has only with it) or none, or .F16, the half-precision move (unconditional, not
// with PC).
func arm32VmovCore(p @Parser, m arm32VmovMnem, a arm32VmovOperand, b arm32VmovOperand) {
	var c int = m.class
	var s arm32VmovOperand = a
	var r arm32VmovOperand = b
	if a.kind == vmovOpR {
		s = b
		r = a
	}
	if c == vmovTypeF16 {
		if !arm32VmovNeed(p, armFpRegs16, "16-bit fp registers", false) { return }
		if m.cond != arm32.COND_AL {
			setErr(p, "instruction is not predicable")
			return
		}
		if r.n == arm32.PC {
			setErr(p, "operand must be a register in range [r0, r14]")
			return
		}
		if a.kind == vmovOpR {
			vfp.VmovHalfToCore(p.Asm, arm32.R0 + r.n, vfp.S0 + s.n)
		} else {
			vfp.VmovCoreToHalf(p.Asm, vfp.S0 + s.n, arm32.R0 + r.n)
		}
		return
	}
	if c == vmovTypeF64 || c == vmovTypeD || c == vmovTypeI64 || c == vmovTypeOther {
		setErr(p, "invalid operand for instruction")
		return
	}
	if c != vmovTypeNone && !arm32VmovNeed(p, armFpVFP2SP, "VFP2", false) { return }
	if !arm32VmovNeed(p, armFpRegs, "fp registers", false) { return }
	if a.kind == vmovOpR {
		vfp.VmovSingleToCore(p.Asm, m.cond, arm32.R0 + r.n, vfp.S0 + s.n)
	} else {
		vfp.VmovCoreToSingle(p.Asm, m.cond, vfp.S0 + s.n, arm32.R0 + r.n)
	}
}

// arm32VmovImm assembles VMOV.F32 / .F16 Sd, #imm or VMOV.F64 Dd, #imm (a the register, b the
// immediate), gated as clang gates it: the FP registers, VFPv3 (else a register is what clang
// wants there), double precision for .F64, full FP16 for .F16 -- fconsts and fconstd VFPv3 only.
func arm32VmovImm(p @Parser, m arm32VmovMnem, a arm32VmovOperand, b arm32VmovOperand, high bool) {
	var size int = 0
	if a.kind == vmovOpS && m.class == vmovTypeF32 { size = 32 }
	if a.kind == vmovOpS && m.class == vmovTypeF16 { size = 16 }
	if a.kind == vmovOpD && m.class == vmovTypeF64 { size = 64 }
	if size == 0 || b.imm8 < 0 {
		setErr(p, "invalid operand for instruction")
		return
	}
	var fp uint64 = p.Arm32FP
	if size == 16 {
		if !arm32VmovNeed(p, armFpFullFP16, "full half-float", false) { return }
		if m.cond != arm32.COND_AL {
			setErr(p, "instruction is not predicable")
			return
		}
	} else if fp & armFpRegs == 0 || (m.encoded && fp & armFpVFP3D16SP == 0) {
		setErr(p, "invalid instruction")
		return
	} else if fp & armFpVFP3D16SP == 0 {
		setErr(p, arm32VfpRange(p, size))
		return
	} else if size == 64 && !m.encoded && !arm32VmovNeed(p, armFpDP, "double precision VFP", high) {
		return
	}
	if !arm32VmovD32(p, @[]arm32VmovOperand{a}, 1) { return }
	var first int = vfp.S0
	if size == 64 { first = vfp.D0 }
	vfp.VmovImm(p.Asm, m.cond, size, first + a.n, b.imm8)
}

// arm32VmovPair assembles VMOV Dm, Rt, Rt2 or Rt, Rt2, Dm (.F64 or .D, VFPv2's spellings, or no
// type).
func arm32VmovPair(p @Parser, m arm32VmovMnem, ops @[]arm32VmovOperand) {
	var toD bool = ops[0].kind == vmovOpD && ops[1].kind == vmovOpR && ops[2].kind == vmovOpR
	var fromD bool = ops[0].kind == vmovOpR && ops[1].kind == vmovOpR && ops[2].kind == vmovOpD
	if (!toD && !fromD) ||
			(m.class != vmovTypeNone && m.class != vmovTypeF64 && m.class != vmovTypeD) {
		setErr(p, "invalid operand for instruction")
		return
	}
	var high bool = arm32VmovHigh(ops, 3)
	if (m.class != vmovTypeNone && !arm32VmovNeed(p, armFpVFP2SP, "VFP2", high)) ||
			!arm32VmovNeed(p, armFpRegs, "fp registers", high) || !arm32VmovD32(p, ops, 3) {
		return
	}
	if toD {
		vfp.VmovCoresToDouble(p.Asm, m.cond, vfp.D0 + ops[0].n, arm32.R0 + ops[1].n, arm32.R0 + ops[2].n)
	} else {
		vfp.VmovDoubleToCores(p.Asm, m.cond, arm32.R0 + ops[0].n, arm32.R0 + ops[1].n, vfp.D0 + ops[2].n)
	}
}

// arm32VmovSingles assembles VMOV Sm, Sm + 1, Rt, Rt2 or Rt, Rt2, Sm, Sm + 1 (no type), the S
// registers sequential.
func arm32VmovSingles(p @Parser, m arm32VmovMnem, ops @[]arm32VmovOperand) {
	var s int = vmovOpS
	var r int = vmovOpR
	var toS bool = ops[0].kind == s && ops[1].kind == s && ops[2].kind == r && ops[3].kind == r
	var fromS bool = ops[0].kind == r && ops[1].kind == r && ops[2].kind == s && ops[3].kind == s
	if (!toS && !fromS) || m.class != vmovTypeNone {
		setErr(p, "invalid operand for instruction")
		return
	}
	if toS && ops[1].n != ops[0].n + 1 {
		setErr(p, "destination operands must be sequential")
		return
	}
	if fromS && ops[3].n != ops[2].n + 1 {
		setErr(p, "source operands must be sequential")
		return
	}
	if !arm32VmovNeed(p, armFpRegs, "fp registers", false) { return }
	if toS {
		vfp.VmovCoresToSingles(p.Asm, m.cond, vfp.S0 + ops[0].n, arm32.R0 + ops[2].n, arm32.R0 + ops[3].n)
	} else {
		vfp.VmovSinglesToCores(p.Asm, m.cond, arm32.R0 + ops[0].n, arm32.R0 + ops[1].n, vfp.S0 + ops[2].n)
	}
}
