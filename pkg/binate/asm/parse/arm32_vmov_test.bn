package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Each VFP VMOV form as clang assembles it: a register copy (.F32, .F or no type for S registers,
// .F64 for D), an immediate (any spelling clang takes of a floating-point literal an 8-bit
// immediate encodes), an S register to or from a core register (any 8-, 16- or 32-bit type, PC
// too), a D register to or from two, two S registers to or from two, a D register's 32-bit lane
// (a constant expression in its brackets) to or from one.
func TestParseArm32VmovForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vmov.f32 s0, s1", "EEB00A60")
	e = armGateIs(e, "", "vmov s0, s1", "EEB00A60")
	e = armGateIs(e, "", "vmov.f s0, s1", "EEB00A60")
	e = armGateIs(e, "", "vmoveq.f32 s0, s1", "0EB00A60")
	e = armGateIs(e, "", "vmov.f64 d0, d1", "EEB00B41")
	e = armGateIs(e, "", "vmov.f64 d16, d1", "EEF00B41")
	e = armGateIs(e, "", "vmov.f32 s0, #1.0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #-2.5", "EEB80A04")
	e = armGateIs(e, "", "vmov.f64 d0, #31.0", "EEB30B0F")
	e = armGateIs(e, "", "vmov.f64 d16, #0.125", "EEF40B00")
	e = armGateIs(e, "", "vmov.f32 s0, #1.9375", "EEB70A0F")
	e = armGateIs(e, "", "vmov.f32 s0, #15.5", "EEB20A0F")
	e = armGateIs(e, "", "vmov.f32 s0, # 1.0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, $1.0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #1.0e0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #0x1.0p0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f64 d0, #-0.1875", "EEBC0B08")
	e = armGateIs(e, "", "vmov s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov r0, s0", "EE100A10")
	e = armGateIs(e, "", "vmov.f32 s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov.i32 s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov.u16 r0, s0", "EE100A10")
	e = armGateIs(e, "", "vmov.p8 s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov s0, pc", "EE00FA10")
	e = armGateIs(e, "", "vmov pc, s0", "EE10FA10")
	e = armGateIs(e, "", "vmov r0, s31", "EE1F0A90")
	e = armGateIs(e, "", "vmov d0, r0, r1", "EC410B10")
	e = armGateIs(e, "", "vmov r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "vmov d16, r0, r1", "EC410B30")
	e = armGateIs(e, "", "vmov.f64 r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "vmov d0, sp, r1", "EC41DB10")
	e = armGateIs(e, "", "vmov r0, r0, d0", "EC500B10")
	e = armGateIs(e, "", "vmov s0, s1, r0, r1", "EC410A10")
	e = armGateIs(e, "", "vmov r0, r1, s0, s1", "EC510A10")
	e = armGateIs(e, "", "vmov s30, s31, r0, r1", "EC410A1F")
	e = armGateIs(e, "", "vmov s0, s1, pc, r1", "EC41FA10")
	e = armGateIs(e, "", "vmov.32 d0[1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 r0, d0[1]", "EE300B10")
	e = armGateIs(e, "", "vmov d0[1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov r0, d0[0]", "EE100B10")
	e = armGateIs(e, "", "vmov.32 d16[0], r0", "EE000B90")
	e = armGateIs(e, "", "vmov.s32 r0, d0[1]", "EE300B10")
	e = armGateIs(e, "", "vmov.f32 d0[1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0 [1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0[1+0], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0[0x1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0[1], pc", "EE20FB10")
	e = armGateIs(e, "", "vmov.w s0, r0", "EE000A10")
	e = armGateIs(e, ".set x, 1", "vmov.32 d0[x], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.f32 s0, #1.00000005", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #1.9999999999", "EEB00A00")
	e = armGateIs(e, "", "vmov.f32 s0, #0x1.000001p0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f64 d0, #1.0000000000000002", "EEB70B00")
	e = armGateIs(e, ".arch armv8.2-a\n.arch_extension fp16", "vmov.f16 s0, #1.00000005", "EEB70900")
	return e
}
