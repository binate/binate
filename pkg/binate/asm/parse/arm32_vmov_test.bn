package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Each VFP VMOV form as clang assembles it: a register copy (.F32, .F or no type for S registers,
// .F64 or .D for D), an immediate (any spelling clang takes of a floating-point literal an 8-bit
// immediate encodes), an S register to or from a core register (any 8-, 16- or 32-bit type, PC
// too), a D register to or from two, two S registers to or from two, a D register's 32-bit lane
// (a constant expression in its brackets) to or from one.
func TestParseArm32VmovForms() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "vmov.f32 s0, s1", "EEB00A60")
	e = armGateIs(e, "", "vmov s0, s1", "EEB00A60")
	e = armGateIs(e, "", "vmov.f s0, s1", "EEB00A60")
	e = armGateIs(e, "", "vmoveq.f32 s0, s1", "0EB00A60")
	e = armGateIs(e, "", "vmov.f64 d0, d1", "EEB00B41")
	e = armGateIs(e, "", "vmov.f64 d16, d1", "EEF00B41")
	e = armGateIs(e, "", "vmov.d d16, d17", "EEF00B61")
	e = armGateIs(e, "", "vmov.d r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "fmdrr.d d0, r0, r1", "EC410B10")
	e = armGateIs(e, "", "vmov.f32 s0, #1.0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #-2.5", "EEB80A04")
	e = armGateIs(e, "", "vmov.f64 d0, #31.0", "EEB30B0F")
	e = armGateIs(e, "", "vmov.f64 d16, #0.125", "EEF40B00")
	e = armGateIs(e, "", "vmov.f32 s0, #1.9375", "EEB70A0F")
	e = armGateIs(e, "", "vmov.f32 s0, #15.5", "EEB20A0F")
	e = armGateIs(e, "", "vmov.f32 s0, # 1.0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, $1.0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #1.0e0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #0x1.0p0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f64 d0, #-0.1875", "EEBC0B08")
	e = armGateIs(e, "", "vmov s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov r0, s0", "EE100A10")
	e = armGateIs(e, "", "vmov.f32 s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov.i32 s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov.u16 r0, s0", "EE100A10")
	e = armGateIs(e, "", "vmov.p8 s0, r0", "EE000A10")
	e = armGateIs(e, "", "vmov s0, pc", "EE00FA10")
	e = armGateIs(e, "", "vmov pc, s0", "EE10FA10")
	e = armGateIs(e, "", "vmov r0, s31", "EE1F0A90")
	e = armGateIs(e, "", "vmov d0, r0, r1", "EC410B10")
	e = armGateIs(e, "", "vmov r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "vmov d16, r0, r1", "EC410B30")
	e = armGateIs(e, "", "vmov.f64 r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "vmov d0, sp, r1", "EC41DB10")
	e = armGateIs(e, "", "vmov r0, r0, d0", "EC500B10")
	e = armGateIs(e, "", "vmov s0, s1, r0, r1", "EC410A10")
	e = armGateIs(e, "", "vmov r0, r1, s0, s1", "EC510A10")
	e = armGateIs(e, "", "vmov s30, s31, r0, r1", "EC410A1F")
	e = armGateIs(e, "", "vmov s0, s1, pc, r1", "EC41FA10")
	e = armGateIs(e, "", "vmov.32 d0[1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 r0, d0[1]", "EE300B10")
	e = armGateIs(e, "", "vmov d0[1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov r0, d0[0]", "EE100B10")
	e = armGateIs(e, "", "vmov.32 d16[0], r0", "EE000B90")
	e = armGateIs(e, "", "vmov.s32 r0, d0[1]", "EE300B10")
	e = armGateIs(e, "", "vmov.f32 d0[1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0 [1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0[1+0], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0[0x1], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.32 d0[1], pc", "EE20FB10")
	e = armGateIs(e, "", "vmov.w s0, r0", "EE000A10")
	e = armGateIs(e, ".set x, 1", "vmov.32 d0[x], r0", "EE200B10")
	e = armGateIs(e, "", "vmov.f32 s0, #1.00000005", "EEB70A00")
	e = armGateIs(e, "", "vmov.f32 s0, #1.9999999999", "EEB00A00")
	e = armGateIs(e, "", "vmov.f32 s0, #0x1.000001p0", "EEB70A00")
	e = armGateIs(e, "", "vmov.f64 d0, #1.0000000000000002", "EEB70B00")
	e = armGateIs(e, ".arch armv8.2-a\n.arch_extension fp16", "vmov.f16 s0, #1.00000005", "EEB70900")
	return e
}

// The pre-UAL names clang keeps for VMOV, as clang assembles them: fcpys and fcpyd as the whole
// mnemonic only; fmrs, fmsr, fmdrr, fmrrd, fmrdd, fmrds (VMOV in any of its forms), fmdhr, fmdlr,
// fconsts and fconstd with a condition and `.w` too, fmrs, fmsr, fmdrr and fmrrd a type as their
// VMOV does; fconsts and fconstd take an immediate's 8-bit encoding (a sign before it dropped),
// not a floating-point literal, and need only VFPv3.
func TestParseArm32VmovAliases() testing.TestResult {
	var e @[]char = ""
	e = armGateIs(e, "", "fcpys s0, s1", "EEB00A60")
	e = armGateIs(e, "", "fcpyd d0, d1", "EEB00B41")
	e = armGateIs(e, "", "fmrs r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmsr s1, r0", "EE000A90")
	e = armGateIs(e, "", "fmrseq r0, s1", "0E100A90")
	e = armGateIs(e, "", "fmsreq s1, r0", "0E000A90")
	e = armGateIs(e, "", "fmrs.w r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmdrr d0, r0, r1", "EC410B10")
	e = armGateIs(e, "", "fmrrd r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "fmdrreq d0, r0, r1", "0C410B10")
	e = armGateIs(e, "", "fmrrdeq r0, r1, d0", "0C510B10")
	e = armGateIs(e, "", "fmdhr d0, r0", "EE200B10")
	e = armGateIs(e, "", "fmdlr d0, r0", "EE000B10")
	e = armGateIs(e, "", "fmdhreq d0, r0", "0E200B10")
	e = armGateIs(e, "", "fconsts s0, #112", "EEB70A00")
	e = armGateIs(e, "", "fconstd d0, #112", "EEB70B00")
	e = armGateIs(e, "", "fconstseq s0, #112", "0EB70A00")
	e = armGateIs(e, "", "fconstdeq d0, #112", "0EB70B00")
	e = armGateIs(e, "", "fconsts s0, #0x70", "EEB70A00")
	e = armGateIs(e, "", "fconsts.w s0, #112", "EEB70A00")
	e = armGateIs(e, "", "fconsts s0, #-1", "EEB00A01")
	e = armGateIs(e, "", "fconsts s0, #'p'", "EEB70A00")
	e = armGateIs(e, "", "fmrs.f32 r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmsr.16 s1, r0", "EE000A90")
	e = armGateIs(e, "", "fmdrr.f64 d0, r0, r1", "EC410B10")
	e = armGateIs(e, ".fpu vfpv3xd", "fconstd d0, #112", "EEB70B00")
	e = armGateIs(e, ".fpu vfpv2", "fconsts s0, #112", "!invalid instruction")
	e = armGateIs(e, "", "fmrs.f64 r0, s1", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmsr.64 s1, r0", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmdhr.32 d0, r0", "!invalid instruction")
	e = armGateIs(e, "", "fcpyseq s0, s1", "!")
	e = armGateIs(e, "", "fcpydeq d0, d1", "!")
	e = armGateIs(e, "", "fcpys.w s0, s1", "!invalid instruction")
	e = armGateIs(e, "", "fconsts s0, #256", "!encoded floating point value out of range")
	e = armGateIs(e, "", "fconsts s0, #1.0", "!invalid floating point immediate")
	e = armGateIs(e, "", "fconsts s0, 112", "!invalid operand for instruction")
	e = armGateIs(e, "", "fmrs s1, r0", "EE000A90")
	e = armGateIs(e, "", "fmrdd r0, r1, d0", "EC510B10")
	e = armGateIs(e, "", "fmrds r0, s1", "EE100A90")
	e = armGateIs(e, "", "fmsrr s0, s1, r0, r1", "!")
	e = armGateIs(e, "", "fmrdh r0, d0", "!")
	return e
}

// An 8-bit floating-point immediate's value as single-precision bits and back: each of the 256
// (1.0 is 0x70, -31.0 0xBF), and none for 0, 0.0's sign alone, 1.0 plus a bit, 2^32 and -1.
func TestArm32VmovFPImm8() testing.TestResult {
	for i := 0; i < 256; i++ {
		if arm32VmovFPImm8(arm32VmovFPBits(i)) != i { return fail("an 8-bit FP immediate is not itself") }
	}
	if arm32VmovFPBits(0x70) != 0x3F800000 || arm32VmovFPBits(0xBF) != 0xC1F80000 {
		return fail("an 8-bit FP immediate's bits are not its value's")
	}
	var no @[]int64 = @[]int64{0, 0x80000000, 0x3F800001, 0x100000000, -1}
	for i := 0; i < len(no); i++ {
		if arm32VmovFPImm8(no[i]) >= 0 { return fail("bits no 8-bit FP immediate has are taken") }
	}
	return ""
}

// Where clang reads a floating-point immediate, as it does: VMOV's operand at the third or fourth
// place, its condition (not AL) and types counted, with a .F16, .F32 or .F64 among them (an
// integer there "invalid floating point immediate"), fconsts' and fconstd's at the second or
// third (an integer past 255 "encoded floating point value out of range"); not for the names
// clang maps to VMOV only once split (fmrs.f32, fmrseq, vmovqeq, vmovq.f32.w), as their own
// encodings take a real literal as no number, while vmovq.f32 and vmovq, mapped whole, read one;
// and a `.n` after a pre-UAL name clang does not map.
func TestParseArm32VmovFPRead() testing.TestResult {
	var e @[]char = ""
	var several *[]readonly char = "invalid instruction, any one of the following would fix this:"
	var none *[]readonly char = ".fpu none"
	e = armMsgIs(e, "", "fmrs.f32 s0, #1.0", several)
	e = armMsgIs(e, "", "fmsr.f64 d0, #1.0", several)
	e = armGateIs(e, "", "fmrs.f32 d0, #112", "F2870010")
	e = armMsgIs(e, "", "fmrseq.f32 s0, #1.0", several)
	e = armGateIs(e, "", "vmovq.f32.w q0, #1", "F2800051")
	e = armMsgIs(e, "", "vmovqeq.f32 s0, #1.0", several)
	e = armMsgIs(e, "", "vmovq.f32.w q0, #1.0", several)
	e = armGateIs(e, "", "vmovq.f32 s0, #1.0", "EEB70A00")
	e = armMsgIs(e, "", "vmovq s0, #1.0", several)
	e = armMsgIs(e, "", "vmov.f32 s0, s1, #1", "invalid floating point immediate")
	e = armMsgIs(e, "", "vmoveq.f32 #1, s0", "invalid floating point immediate")
	e = armMsgIs(e, "", "vmov.f32.f32 s0, #1", "invalid floating point immediate")
	e = armMsgIs(e, "", "vmov.f32 d0[1], #1", "invalid floating point immediate")
	e = armMsgIs(e, "", "fconsts s0, s1, #300", "encoded floating point value out of range")
	e = armMsgIs(e, "", "fconstseq #300, s0", "encoded floating point value out of range")
	e = armMsgIs(e, "", "fconsts.f32 s0, #300", "encoded floating point value out of range")
	e = armMsgIs(e, "", "vmoval.f32 #1, s0", several)
	e = armMsgIs(e, "", "vmov.i32.f32 d0, #1", "invalid floating point immediate")
	e = armMsgIs(e, "", "fcpys.n s0, s1",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	e = armMsgIs(e, none, "fmrs.n r0, s0",
			"instruction with .n (narrow) qualifier not allowed in arm mode")
	return e
}

// litImmIs appends to e unless the 8-bit immediate of the value literal text (negated for neg)
// rounds to is want (-1 for none).
func litImmIs(e @[]char, neg bool, text *[]readonly char, want int) @[]char {
	bits, ok := arm32VmovLitBits(neg, text)
	if ok && arm32VmovFPImm8(bits) == want { return e }
	return buf.Concat(e, buf.Concat(text, ": not clang's immediate\n"))
}

// litBitsIs appends to e unless literal text rounds to the single-precision bits want.
func litBitsIs(e @[]char, text *[]readonly char, want int64) @[]char {
	bits, ok := arm32VmovLitBits(false, text)
	if ok && bits == want { return e }
	return buf.Concat(e, buf.Concat(text, ": not clang's bits\n"))
}

// A literal rounds to single precision as clang rounds it, to nearest with ties to even, and gives
// the 8-bit immediate of that value if one encodes it: within half a unit in the last place of an
// encodable value (half that below a power of two), the bounds included, it is that value; past
// them, or zero, too small or too large, it is none.  Decimal and hexadecimal literals alike.
func TestArm32VmovLitImm() testing.TestResult {
	var e @[]char = ""
	e = litImmIs(e, false, "1.0", 0x70)
	e = litImmIs(e, true, "2.5", 0x84)
	e = litImmIs(e, false, "31.0", 0x3F)
	e = litImmIs(e, false, "0.125", 0x40)
	e = litImmIs(e, false, "1.00000005", 0x70)
	e = litImmIs(e, false, "1.9999999999", 0x00)
	e = litImmIs(e, false, "0.124999999", 0x40)
	e = litImmIs(e, false, "1.0000000000000002", 0x70)
	e = litImmIs(e, false, "1.0000000000001", 0x70)
	e = litImmIs(e, false, "1.000000059604644775390625", 0x70)
	e = litImmIs(e, false, "1.000000059604644775390626", -1)
	e = litImmIs(e, false, "0.999999970197677612304687500", 0x70)
	e = litImmIs(e, false, "0.9999999701976776123046874", -1)
	e = litImmIs(e, false, "31.0000009", 0x3F)
	e = litImmIs(e, false, "31.000001", -1)
	e = litImmIs(e, false, "0.12499999627470970153808593750", 0x40)
	e = litImmIs(e, false, "0.12499999627470970153808593749", -1)
	e = litImmIs(e, false, "2.4999999", 0x04)
	e = litImmIs(e, false, "0x1.000001p0", 0x70)
	e = litImmIs(e, false, "0x1.0000008p0", 0x70)
	e = litImmIs(e, false, "0x1.0000018p0", -1)
	e = litImmIs(e, false, "0x1.fffffffp4", -1)
	e = litImmIs(e, false, "0x1.8p1", 0x08)
	e = litImmIs(e, false, "1e1", 0x24)
	e = litImmIs(e, false, "0.1", -1)
	e = litImmIs(e, false, "32.0", -1)
	e = litImmIs(e, false, "0.0", -1)
	e = litImmIs(e, false, "1e-400", -1)
	e = litImmIs(e, false, "1e400", -1)
	return e
}

// A literal's single-precision bits: 0.1 and 32.0 (no 8-bit immediate's), zero, underflow to zero
// and overflow to infinity, the smallest subnormal (decimal and hexadecimal), a larger subnormal
// and the largest, the largest normal value (a literal past halfway to 2^128 infinity), 2^23.
func TestArm32VmovLitBits() testing.TestResult {
	var e @[]char = ""
	e = litBitsIs(e, "0.1", 0x3DCCCCCD)
	e = litBitsIs(e, "32.0", 0x42000000)
	e = litBitsIs(e, "0.0", 0)
	e = litBitsIs(e, "1e-400", 0)
	e = litBitsIs(e, "1e400", 0x7F800000)
	e = litBitsIs(e, "1.4e-45", 1)
	e = litBitsIs(e, "0x1p-149", 1)
	e = litBitsIs(e, "0x1p-127", 0x00400000)
	e = litBitsIs(e, "1.1754942e-38", 0x007FFFFF)
	e = litBitsIs(e, "3.4028235e38", 0x7F7FFFFF)
	e = litBitsIs(e, "3.4028236e38", 0x7F800000)
	e = litBitsIs(e, "3.5e38", 0x7F800000)
	e = litBitsIs(e, "8388608.0", 0x4B000000)
	return e
}
