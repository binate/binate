package "pkg/binate/asm/parse"

import "pkg/binate/asm/arm32"
import "pkg/binate/asm/arm32/vfp"
import "pkg/binate/buf"

// VMRS and VMSR (asm/arm32/vfp) with the VFP system registers, their pre-UAL names fmrx, fmxr and
// fmstat (VMRS APSR_nzcv, FPSCR), and ARMv8.2's VINS and VMOVX -- as clang takes them: VMRS reads
// FPSID, FPSCR, MVFR0 .. MVFR2, FPEXC, FPINST, FPINST2 into R0 .. R14 (or APSR_nzcv, from FPSCR
// only); VMSR writes them but the MVFRs from R0 .. R14; FPSCR needs only the FP registers, MVFR2
// ARMv8's FP, the rest VFPv2.  VINS.F16 and VMOVX.F16 take S registers, full FP16, and no
// condition.

// arm32VmrsNeed reports whether the FP features want are in effect, else sets clang's
// "instruction requires: what".
func arm32VmrsNeed(p @Parser, want uint64, what *[]readonly char) bool {
	if p.Arm32FP & want == want { return true }
	setErr(p, buf.Concat("instruction requires: ", what))
	return false
}

// arm32VfpSysReg returns the VFP system register name names (vfp.FPSID .. vfp.FPINST2), in any
// case, or -1.
func arm32VfpSysReg(name *[]readonly char) int {
	if mnemIs(name, "fpsid") { return vfp.FPSID }
	if mnemIs(name, "fpscr") { return vfp.FPSCR }
	if mnemIs(name, "mvfr2") { return vfp.MVFR2 }
	if mnemIs(name, "mvfr1") { return vfp.MVFR1 }
	if mnemIs(name, "mvfr0") { return vfp.MVFR0 }
	if mnemIs(name, "fpexc") { return vfp.FPEXC }
	if mnemIs(name, "fpinst") { return vfp.FPINST }
	if mnemIs(name, "fpinst2") { return vfp.FPINST2 }
	return -1
}

// The instructions parseArm32Vmrs assembles.
const (
	vmrsRead int = iota // VMRS (fmrx)
	vmrsWrite           // VMSR (fmxr)
	vmrsStat            // fmstat: VMRS APSR_nzcv, FPSCR
	vmrsIns             // VINS.F16
	vmrsMovx            // VMOVX.F16
)

// arm32VmrsHead returns which instruction (vmrs*) head (a mnemonic before its first `.`) names,
// its condition and whether it is fmrx or fmxr (which need VFPv2), -1 for none -- setting clang's
// error, and returning -2, for an `s` it reads as a flag-setting suffix (vmrss; vinseq, which clang
// reads as VIN with EQ and S).
func arm32VmrsHead(p @Parser, head *[]readonly char) (int, int, bool) {
	for i := 0; i < 7; i++ {
		named, cond, before := arm32VfpNamed(head, arm32VmrsName(i))
		if named == vfpNamedFlags {
			arm32VfpFlagsErr(p, before)
			return -2, cond, false
		}
		if named != vfpNamedOk { continue }
		var kind int = arm32VmrsKind(i)
		if kind == vmrsIns && cond != arm32.COND_AL {
			arm32VfpFlagsErr(p, "vin")
			return -2, cond, false
		}
		return kind, cond, i == 2 || i == 3
	}
	return -1, arm32.COND_AL, false
}

// arm32VmrsName returns name i of those arm32VmrsHead knows: vmrs, vmsr, fmrx, fmxr, fmstat, vins,
// vmovx.
func arm32VmrsName(i int) *[]readonly char {
	if i == 0 { return "vmrs" }
	if i == 1 { return "vmsr" }
	if i == 2 { return "fmrx" }
	if i == 3 { return "fmxr" }
	if i == 4 { return "fmstat" }
	if i == 5 { return "vins" }
	return "vmovx"
}

// arm32VmrsKind returns the instruction (vmrs*) name i (arm32VmrsName) is.
func arm32VmrsKind(i int) int {
	if i == 0 || i == 2 { return vmrsRead }
	if i == 1 || i == 3 { return vmrsWrite }
	if i == 4 { return vmrsStat }
	if i == 5 { return vmrsIns }
	return vmrsMovx
}

// arm32VfpListEnd reports whether tok, after an instruction's last operand (l the lexer after
// it), ends the line, else sets clang's error: a comma and nothing more "unexpected token in
// operand", a comma and more "too many operands for instruction", anything else "unexpected token
// in argument list".
func arm32VfpListEnd(p @Parser, l Lexer, tok Token) bool {
	if tok.Kind == TOK_EOF { return true }
	if tok.Kind == TOK_COMMA {
		var next Token
		_, next = LexNext(l)
		if next.Kind == TOK_EOF || next.Kind == TOK_COMMA {
			setErr(p, "unexpected token in operand")
		} else {
			setErr(p, "too many operands for instruction")
		}
		return false
	}
	setErr(p, "unexpected token in argument list")
	return false
}

// parseArm32Vmrs assembles VMRS, VMSR, fmrx, fmxr, fmstat, VINS or VMOVX, mnem the mnemonic as
// written and l the lexer after it, reporting whether mnem names one.
func parseArm32Vmrs(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if len(mnem) == 0 || (arm32Lower(mnem[0]) != 'v' && arm32Lower(mnem[0]) != 'f') { return false }
	var dot int = len(mnem)
	for i := len(mnem) - 1; i >= 0; i-- {
		if mnem[i] == '.' { dot = i }
	}
	kind, cond, alias := arm32VmrsHead(p, mnem[0:dot])
	if kind == -1 { return false }
	if kind == -2 { return true }
	t, count, ok := arm32VfpSuffixType(p, mnem[dot:len(mnem)])
	if !ok { return true }
	if kind == vmrsIns || kind == vmrsMovx {
		if count != 1 || !mnemIs(t, "f16") {
			if count == 0 {
				setErr(p, "invalid instruction")
			} else {
				setErr(p, "invalid operand for instruction")
			}
			return true
		}
		if cond != arm32.COND_AL {
			arm32NotPredicable(p, "vmovx")
			return true
		}
		parseArm32VinsOperands(p, l, kind == vmrsIns)
		return true
	}
	if count > 0 {
		setErr(p, "invalid instruction")
		return true
	}
	parseArm32VmrsOperands(p, l, kind, cond, alias)
	return true
}

// parseArm32VmrsOperands assembles VMRS Rt, reg (kind vmrsRead), VMSR reg, Rt (vmrsWrite) or
// fmstat (vmrsStat, no operands) under cond from the operands after l; alias for fmrx or fmxr,
// which clang has only with VFPv2.
func parseArm32VmrsOperands(p @Parser, l Lexer, kind int, cond int, alias bool) {
	var tok Token
	l, tok = LexNext(l)
	if kind == vmrsStat {
		if tok.Kind == TOK_COMMA {
			setErr(p, "unexpected token in operand")
			return
		}
		if tok.Kind != TOK_EOF {
			setErr(p, "too many operands for instruction")
			return
		}
		if arm32VmrsNeed(p, armFpRegs, "fp registers") {
			vfp.Vmrs(p.Asm, cond, arm32.PC, vfp.FPSCR)
		}
		return
	}
	var names @[]@[]char = make_slice(@[]char, 2)
	for i := 0; i < 2; i++ {
		if tok.Kind == TOK_EOF {
			setErr(p, "too few operands for instruction")
			return
		}
		if tok.Kind != TOK_IDENT {
			setErr(p, "invalid operand for instruction")
			return
		}
		names[i] = buf.CopyStr(tok.Text)
		l, tok = LexNext(l)
		if i == 0 {
			if tok.Kind == TOK_EOF {
				setErr(p, "too few operands for instruction")
				return
			}
			if tok.Kind != TOK_COMMA {
				setErr(p, "unexpected token in argument list")
				return
			}
			l, tok = LexNext(l)
			if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
				setErr(p, "unexpected token in operand")
				return
			}
		}
	}
	if !arm32VfpListEnd(p, l, tok) { return }
	var core @[]char = names[0]
	var sys @[]char = names[1]
	if kind == vmrsWrite {
		core = names[1]
		sys = names[0]
	}
	var reg int = arm32VfpSysReg(sys)
	var rt int = parseArm32Reg(core)
	if kind == vmrsRead && mnemIs(core, "apsr_nzcv") { rt = arm32.PC }
	if reg < 0 || (kind == vmrsWrite && (reg == vfp.MVFR0 || reg == vfp.MVFR1 || reg == vfp.MVFR2)) {
		setErr(p, "invalid operand for instruction")
		return
	}
	if rt < 0 || (rt == arm32.PC && (kind == vmrsWrite || !mnemIs(core, "apsr_nzcv"))) ||
			(rt == arm32.PC && reg != vfp.FPSCR) {
		setErr(p, "operand must be a register in range [r0, r14]")
		return
	}
	if alias && p.Arm32FP & armFpVFP2SP == 0 {
		setErr(p, "invalid instruction")
		return
	}
	if reg == vfp.FPSCR {
		if !arm32VmrsNeed(p, armFpRegs, "fp registers") { return }
	} else if reg == vfp.MVFR2 {
		if !arm32VmrsNeed(p, armFpV8D16SP, "FPARMv8") { return }
	} else if !arm32VmrsNeed(p, armFpVFP2SP, "VFP2") {
		return
	}
	if kind == vmrsRead {
		vfp.Vmrs(p.Asm, cond, rt, reg)
	} else {
		vfp.Vmsr(p.Asm, cond, reg, rt)
	}
}

// parseArm32VinsOperands assembles VINS.F16 (ins) or VMOVX.F16 Sd, Sm from the operands after l.
func parseArm32VinsOperands(p @Parser, l Lexer, ins bool) {
	var regs @[]int = make_slice(int, 2)
	var tok Token
	l, tok = LexNext(l)
	for i := 0; i < 2; i++ {
		if tok.Kind == TOK_EOF {
			setErr(p, "too few operands for instruction")
			return
		}
		regs[i] = -1
		if tok.Kind == TOK_IDENT { regs[i] = arm32VfpReg(tok.Text, 's') }
		if regs[i] < 0 {
			setErr(p, "operand must be a register in range [s0, s31]")
			return
		}
		l, tok = LexNext(l)
		if i == 0 {
			if tok.Kind == TOK_EOF {
				setErr(p, "too few operands for instruction")
				return
			}
			if tok.Kind != TOK_COMMA {
				setErr(p, "unexpected token in argument list")
				return
			}
			l, tok = LexNext(l)
			if tok.Kind == TOK_EOF || tok.Kind == TOK_COMMA {
				setErr(p, "unexpected token in operand")
				return
			}
		}
	}
	if !arm32VfpListEnd(p, l, tok) { return }
	if !arm32VmrsNeed(p, armFpFullFP16, "full half-float") { return }
	if ins {
		vfp.Vins(p.Asm, vfp.S0 + regs[0], vfp.S0 + regs[1])
	} else {
		vfp.Vmovx(p.Asm, vfp.S0 + regs[0], vfp.S0 + regs[1])
	}
}
