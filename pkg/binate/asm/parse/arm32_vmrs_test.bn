package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// VMRS and VMSR with each system register, APSR_nzcv, SP, a condition and `.w`; fmrx, fmxr and
// fmstat; VINS and VMOVX -- as clang assembles them.
func TestParseArm32Vmrs() testing.TestResult {
	var e @[]char = ""
	var half *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	e = armGateIs(e, "", "vmrs r0, fpscr", "EEF10A10")
	e = armGateIs(e, "", "vmrs APSR_nzcv, fpscr", "EEF1FA10")
	e = armGateIs(e, "", "vmrs apsr_nzcv, FPSCR", "EEF1FA10")
	e = armGateIs(e, "", "vmrs APSR_NZCV, fpscr", "EEF1FA10")
	e = armGateIs(e, "", "vmrs r0, fpsid", "EEF00A10")
	e = armGateIs(e, "", "vmrs r0, mvfr0", "EEF70A10")
	e = armGateIs(e, "", "vmrs r0, mvfr1", "EEF60A10")
	e = armGateIs(e, "", "vmrs r0, FPEXC", "EEF80A10")
	e = armGateIs(e, "", "vmrs r0, fpinst", "EEF90A10")
	e = armGateIs(e, "", "vmrs r0, fpinst2", "EEFA0A10")
	e = armGateIs(e, "", "vmrs sp, fpscr", "EEF1DA10")
	e = armGateIs(e, "", "vmrseq r0, fpscr", "0EF10A10")
	e = armGateIs(e, "", "vmrs.w r0, fpscr", "EEF10A10")
	e = armGateIs(e, "", "vmsr fpscr, r0", "EEE10A10")
	e = armGateIs(e, "", "vmsr FPSCR, r0", "EEE10A10")
	e = armGateIs(e, "", "vmsr fpexc, r0", "EEE80A10")
	e = armGateIs(e, "", "vmsr fpsid, r0", "EEE00A10")
	e = armGateIs(e, "", "vmsr fpinst, r0", "EEE90A10")
	e = armGateIs(e, "", "vmsreq fpscr, r0", "0EE10A10")
	e = armGateIs(e, "", "vmsr fpscr, sp", "EEE1DA10")
	e = armGateIs(e, "", "fmrx r0, fpscr", "EEF10A10")
	e = armGateIs(e, "", "fmxr fpscr, r0", "EEE10A10")
	e = armGateIs(e, "", "fmrxeq r0, fpexc", "0EF80A10")
	e = armGateIs(e, "", "fmxreq fpscr, r0", "0EE10A10")
	e = armGateIs(e, "", "fmstat", "EEF1FA10")
	e = armGateIs(e, "", "fmstateq", "0EF1FA10")
	e = armGateIs(e, "", "fmstat.w", "EEF1FA10")
	e = armGateIs(e, half, "vmrs r0, mvfr2", "EEF50A10")
	e = armGateIs(e, half, "fmrx r0, mvfr2", "EEF50A10")
	e = armGateIs(e, half, "vins.f16 s0, s1", "FEB00AE0")
	e = armGateIs(e, half, "vmovx.f16 s0, s1", "FEB00A60")
	return e
}

// What clang does not take of them, with its message: PC or APSR_nzcv where it may not be, an
// MVFR or FPSCR_nzcv where it may not be, a type, an `s`, too many or too few operands, a
// condition on VINS (clang reads VIN with an `s`), VINS with no type or another, a D register;
// and the gates -- MVFR2 ARMv8's FP, the system registers other than FPSCR VFPv2, VINS full FP16.
func TestParseArm32VmrsRejects() testing.TestResult {
	var e @[]char = ""
	var half *[]readonly char = ".arch armv8.2-a\n.arch_extension fp16"
	var r14 *[]readonly char = "!operand must be a register in range [r0, r14]"
	var bad *[]readonly char = "!invalid operand for instruction"
	e = armGateIs(e, "", "vmrs r15, fpscr", r14)
	e = armGateIs(e, "", "vmrs pc, fpscr", r14)
	e = armGateIs(e, "", "vmrs apsr_nzcv, fpexc", r14)
	e = armGateIs(e, "", "vmrs apsr, fpscr", r14)
	e = armGateIs(e, "", "vmsr fpscr, pc", r14)
	e = armGateIs(e, "", "vmsr fpscr, apsr_nzcv", r14)
	e = armGateIs(e, "", "vmsr mvfr0, r0", bad)
	e = armGateIs(e, "", "fmxr mvfr0, r0", bad)
	e = armGateIs(e, "", "vmrs r0, fpscr_nzcv", bad)
	e = armGateIs(e, "", "vmsr.f32 fpscr, r0", "!invalid instruction")
	e = armGateIs(e, "", "vmrss r0, fpscr", "!instruction 'vmrs' can not set flags")
	e = armGateIs(e, "", "vmrs r0, fpscr, r1", "!too many operands for instruction")
	e = armGateIs(e, "", "vmrs r0", "!too few operands for instruction")
	e = armGateIs(e, "", "fmstat r0", "!too many operands for instruction")
	e = armGateIs(e, "", "vmrs r0, mvfr2", "!instruction requires: FPARMv8")
	e = armGateIs(e, ".fpu none", "vmrs r0, fpexc", "!instruction requires: VFP2")
	e = armGateIs(e, ".fpu none", "vmrs r0, fpscr", "EEF10A10")
	e = armGateIs(e, ".fpu none", "fmstat", "EEF1FA10")
	e = armGateIs(e, ".fpu none", "fmrx r0, fpscr", "!invalid instruction")
	e = armGateIs(e, ".arch armv6", "vmrs r0, fpscr", "!instruction requires: fp registers")
	e = armGateIs(e, half, "vinseq.f16 s0, s1", "!instruction 'vin' can not set flags")
	e = armGateIs(e, half, "vins s0, s1", "!invalid instruction")
	e = armGateIs(e, half, "vins.f32 s0, s1", bad)
	e = armGateIs(e, half, "vmovx.f16 d0, s1", "!operand must be a register in range [s0, s31]")
	e = armGateIs(e, "", "vins.f16 s0, s1", "!instruction requires: full half-float")
	e = armGateIs(e, half, "vmovxeq.f16 s0, s1", "!instruction 'vmovx' is not predicable")
	e = armGateIs(e, "", "vmrs r0, fpscr,", "!unexpected token in operand")
	e = armGateIs(e, "", "vmrs r0,", "!unexpected token in operand")
	e = armGateIs(e, "", "fmstat ,", "!unexpected token in operand")
	e = armGateIs(e, half, "vins.f16 s0, s1,", "!unexpected token in operand")
	e = armGateIs(e, "", "vmrs r0, fpscr x", "!unexpected token in argument list")
	return e
}
