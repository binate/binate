package "pkg/binate/asm/parse"

import "pkg/binate/buf"

// Expression evaluator for assembly operands and directives: integer and character
// literals, the names of constants defined on earlier lines (`N = 5`), parentheses, unary
// - + ~, and the binary operators * / % << >> + - | & ^, over 64-bit values.  A name that
// is not such a constant is an error where a number is read: a constant must be defined
// before it is used (clang resolves some later definitions at layout and rejects others,
// so a forward reference is never accepted).
//
// Where a symbol may stand (parseSymExpr), the value may also be a symbol plus a number —
// any other name is a symbol, an alias (`A = lbl + 8`) its symbol and addend, and `.` the
// current location — combined only by adding or subtracting numbers (`lbl+4+4`, `4+lbl`,
// `lbl-4+N*2`, `(lbl+4)`).  Anything else on a symbol (`-lbl`, `lbl*2`, `lbl+lbl`) is an
// error — but a difference of two locations (`l2 - l1`) whose distance is fixed is a
// number, anywhere a number is read (expr_diff.bn).
//
// clang evaluates binary operators with one of three precedence tables — a Darwin
// table for Mach-O (| & ^  <  << >>  <  + -  <  * / %), a GNU table for ELF and for
// directives (+ -  <  | & ^  <  * / % << >>), and C's for x86 Intel-syntax operands
// (|  <  ^  <  &  <  << >>  <  + -  <  * / %) — so the same unparenthesized
// expression can mean different things.  The evaluator uses the precedences all
// three share and rejects a mix they disagree on, so an expression never silently
// means something other than what clang reads in any of those contexts:
//   - accepted: * / % over + -; * / % over | & ^; << >> over | & ^; each group on
//     its own (left-associative);
//   - rejected at one parenthesization level: + - with << >>, + - with | & ^,
//     * / % with << >>, and two different bitwise operators (| with & or ^, & with
//     ^) — add parentheses to say which is meant.
// >> shifts a non-negative value (logically, as in clang's Mach-O and ELF tables);
// shifting a negative value right is an error, since x86 Intel syntax shifts
// arithmetically where the others shift logically.  Shift counts must lie in
// [0, 63], and / or % by zero and the overflowing minimum-value / -1 are errors,
// as is nesting past maxExprDepth.

// Operator groups, as bits of the set parseBinary reports for one level.
const (
	EG_MUL int = 1   // * / %
	EG_SHIFT int = 2 // << >>
	EG_ADD int = 4   // + -
	EG_OR int = 8    // |
	EG_XOR int = 16  // ^
	EG_AND int = 32  // &
)

// EG_BIT is every bitwise group; a level may use at most one of them.
const EG_BIT int = EG_OR | EG_XOR | EG_AND

// maxExprDepth bounds the nesting of parentheses and unary operators.
const maxExprDepth int = 256

// exprFail returns a failed ExprResult carrying (a copy of) msg.
func exprFail(msg *[]readonly char) ExprResult {
	var r ExprResult
	r.Err = buf.CopyStr(msg)
	return r
}

// exprOk returns an ExprResult with the given value and Ok=true.
func exprOk(val int64) ExprResult {
	var r ExprResult
	r.Val = val
	r.Ok = true
	return r
}

// exprErr returns r's diagnostic, or fallback when it carries none.
func exprErr(r ExprResult, fallback *[]readonly char) @[]char {
	if len(r.Err) > 0 { return r.Err }
	return buf.CopyStr(fallback)
}

// ParseExpr parses and evaluates a constant expression from the token stream, reading
// constants from p's table.  Returns the updated lexer and the result.
// cur is the current (already lexed) token; the function consumes tokens as needed.
func ParseExpr(p @Parser, l Lexer, cur Token) (Lexer, Token, ExprResult) {
	// Locations are read as in a symbol position, so a difference of two can fold to a
	// number; what is left a location is an error here.
	var first Token = cur
	var r ExprResult
	l, cur, r = parseLevel(p, l, cur, 0)
	if r.Ok && !r.Pending && (isSymbolic(r) || hasNeg(r)) { r = numberContextError(p, first, r) }
	return l, cur, r
}

// parseSymExpr is ParseExpr where a symbol may stand: the result may be a symbol plus a
// number (Sym) or the current location plus a number (Dot) — but no difference of two
// locations that is not fixed, which no symbol operand can take.
func parseSymExpr(p @Parser, l Lexer, cur Token) (Lexer, Token, ExprResult) {
	var r ExprResult
	l, cur, r = parseLevel(p, l, cur, 0)
	if r.Ok && hasNeg(r) {
		r = exprFail("a difference of locations in different sections or atoms is not a number")
	}
	return l, cur, r
}

// parseLevel parses one parenthesization level at nesting depth and rejects a mix of
// operator groups whose relative precedence clang's two tables disagree on.
func parseLevel(p @Parser, l Lexer, cur Token, depth int) (Lexer, Token, ExprResult) {
	var r ExprResult
	var groups int = 0
	l, cur, r, groups = parseBinary(p, l, cur, 1, depth)
	if !r.Ok { return l, cur, r }
	if (groups & (EG_ADD | EG_SHIFT)) == (EG_ADD | EG_SHIFT) ||
			((groups & EG_ADD) != 0 && (groups & EG_BIT) != 0) ||
			(groups & (EG_MUL | EG_SHIFT)) == (EG_MUL | EG_SHIFT) || bitGroupCount(groups & EG_BIT) > 1 {
		return l, cur,
			exprFail(
					"ambiguous operator precedence (Mach-O and ELF differ); add parentheses")
	}
	return l, cur, r
}

// binPrec returns the binary precedence of token kind k (the GNU table's, which
// agrees with the Darwin and Intel tables on every mix parseLevel accepts), or 0 when
// k is not a binary operator.
func binPrec(k int) int {
	if k == TOK_STAR || k == TOK_SLASH || k == TOK_PERCENT || k == TOK_SHL || k == TOK_SHR {
		return 3
	}
	if k == TOK_PIPE || k == TOK_AMP || k == TOK_CARET { return 2 }
	if k == TOK_PLUS || k == TOK_MINUS { return 1 }
	return 0
}

// binGroup returns the EG_* group of binary operator token kind k.
func binGroup(k int) int {
	if k == TOK_STAR || k == TOK_SLASH || k == TOK_PERCENT { return EG_MUL }
	if k == TOK_SHL || k == TOK_SHR { return EG_SHIFT }
	if k == TOK_PLUS || k == TOK_MINUS { return EG_ADD }
	if k == TOK_PIPE { return EG_OR }
	if k == TOK_CARET { return EG_XOR }
	return EG_AND
}

// bitGroupCount returns how many of the bitwise groups EG_OR, EG_XOR, EG_AND are in g.
func bitGroupCount(g int) int {
	var n int = 0
	if (g & EG_OR) != 0 { n = n + 1 }
	if (g & EG_XOR) != 0 { n = n + 1 }
	if (g & EG_AND) != 0 { n = n + 1 }
	return n
}

// parseBinary parses operands joined by binary operators of precedence >= minPrec
// (precedence climbing, left-associative), returning the value and the set of
// operator groups used at this level.
func parseBinary(p @Parser, l Lexer, cur Token, minPrec int,
		depth int) (Lexer, Token, ExprResult, int) {
	var marks int = p.NumAliasMarks
	var left ExprResult
	l, cur, left = parseUnary(p, l, cur, depth)
	if !left.Ok { return l, cur, left, 0 }
	var groups int = 0
	for binPrec(cur.Kind) >= minPrec {
		var op int = cur.Kind
		var prec int = binPrec(op)
		groups = groups | binGroup(op)
		l, cur = LexNext(l)
		var right ExprResult
		var rg int = 0
		l, cur, right, rg = parseBinary(p, l, cur, prec + 1, depth)
		groups = groups | rg
		if !right.Ok { return l, cur, right, groups }
		var folds bool = isSymbolic(left) || isSymbolic(right)
		left = combine(p, op, left, right)
		if !left.Ok { return l, cur, left, groups }
		if folds && left.FromDiff { unmarkAliases(p, marks) }
	}
	return l, cur, left, groups
}

// isSymbolic reports whether r is a symbol or the current location plus a number.
func isSymbolic(r ExprResult) bool {
	return len(r.Sym) > 0 || r.Dot
}

// combine evaluates `x op y`: a pending operand keeps the result pending; applyBinary on two
// numbers; two locations subtracted, their difference (differenceOf); on a symbolic
// operand, only a number added to it, or subtracted from it on the left.
func combine(p @Parser, op int, x ExprResult, y ExprResult) ExprResult {
	if x.Pending || y.Pending { return pendingResult(p) }
	if hasNeg(x) || hasNeg(y) { return combineDifference(op, x, y) }
	if !isSymbolic(x) && !isSymbolic(y) {
		var n ExprResult = applyBinary(op, x.Val, y.Val)
		n.FromDiff = x.FromDiff || y.FromDiff
		return n
	}
	if isSymbolic(x) && isSymbolic(y) {
		if op == TOK_MINUS { return differenceOf(p, x, y) }
		return exprFail("two symbols cannot be combined")
	}
	if op == TOK_PLUS || (op == TOK_MINUS && !isSymbolic(y)) {
		var r ExprResult = x
		if isSymbolic(y) { r = y }
		if op == TOK_PLUS {
			r.Val = x.Val + y.Val
		} else {
			r.Val = x.Val - y.Val
		}
		return r
	}
	return exprFail("a symbol takes only a number added to or subtracted from it")
}

// minInt64 is the most negative 64-bit value.
const minInt64 int64 = -9223372036854775807 - 1

// applyBinary evaluates `x op y` for binary operator token kind op.
func applyBinary(op int, x int64, y int64) ExprResult {
	if op == TOK_PLUS { return exprOk(x + y) }
	if op == TOK_MINUS { return exprOk(x - y) }
	if op == TOK_STAR { return exprOk(x * y) }
	if op == TOK_PIPE { return exprOk(x | y) }
	if op == TOK_AMP { return exprOk(x & y) }
	if op == TOK_CARET { return exprOk(x ^ y) }
	if op == TOK_SLASH || op == TOK_PERCENT {
		if y == 0 { return exprFail("division by zero in expression") }
		if x == minInt64 && y == -1 {
			// The quotient overflows 64 bits; the remainder is exactly 0.
			if op == TOK_SLASH { return exprFail("division overflow in expression") }
			return exprOk(0)
		}
		if op == TOK_SLASH { return exprOk(x / y) }
		return exprOk(x % y)
	}
	// << and >>: the count is 0..63; >> takes a non-negative value (so shifting in
	// zeros and shifting in sign bits agree).
	if y < 0 || y > 63 { return exprFail("shift count out of range [0, 63]") }
	if op == TOK_SHR && x < 0 {
		return exprFail("right shift of a negative value (arithmetic in x86 syntax, logical elsewhere)")
	}
	var ux uint64 = bit_cast(uint64, x)
	var n uint = cast(uint, y)
	if op == TOK_SHL { return exprOk(bit_cast(int64, ux << n)) }
	return exprOk(bit_cast(int64, ux >> n))
}

// parseUnary handles unary `-` (negation), `+` and `~` (bitwise NOT), then an atom.
func parseUnary(p @Parser, l Lexer, cur Token, depth int) (Lexer, Token, ExprResult) {
	if depth >= maxExprDepth { return l, cur, exprFail("expression nested too deeply") }
	if cur.Kind == TOK_MINUS || cur.Kind == TOK_PLUS || cur.Kind == TOK_TILDE {
		var op int = cur.Kind
		l, cur = LexNext(l)
		var inner ExprResult
		l, cur, inner = parseUnary(p, l, cur, depth + 1)
		return l, cur, applyUnary(p, op, inner)
	}
	return parseAtom(p, l, cur, depth)
}

// applyUnary evaluates unary op (- + ~) on inner: a pending value stays pending, a
// difference not fixed at assembly negates (its locations swapped), and any other symbol
// takes only `+`.  (Kept out of parseUnary, which recurses per nesting level, so its frame
// stays small.)
func applyUnary(p @Parser, op int, inner ExprResult) ExprResult {
	if !inner.Ok { return inner }
	if inner.Pending { return pendingResult(p) }
	if op == TOK_MINUS && hasNeg(inner) { return negatedDifference(inner) }
	if op != TOK_PLUS && (isSymbolic(inner) || hasNeg(inner)) {
		return exprFail("a symbol cannot be negated or complemented")
	}
	var r ExprResult = inner
	if op == TOK_MINUS { r = exprOk(0 - inner.Val) }
	if op == TOK_TILDE { r = exprOk(inner.Val ^ -1) } // ~x = x ^ -1
	r.FromDiff = inner.FromDiff
	return r
}

// parseAtom matches one terminal: an integer or character literal, a constant's name, any
// other name (a symbol), `.` (the current location), or a parenthesized sub-expression
// (its own precedence level).  Anything else fails.  Only the parenthesized case recurses;
// the others are parseTerminal's, which keeps this frame — one per nesting level — small.
func parseAtom(p @Parser, l Lexer, cur Token, depth int) (Lexer, Token, ExprResult) {
	if cur.Kind != TOK_LPAREN { return parseTerminal(p, l, cur) }
	l, cur = LexNext(l)
	var inner ExprResult
	l, cur, inner = parseLevel(p, l, cur, depth + 1)
	if !inner.Ok { return l, cur, inner }
	if cur.Kind != TOK_RPAREN { return l, cur, exprFail("expected ')' in expression") }
	l, cur = LexNext(l)
	return l, cur, inner
}

// parseTerminal matches parseAtom's non-parenthesized terminals.
func parseTerminal(p @Parser, l Lexer, cur Token) (Lexer, Token, ExprResult) {
	if cur.Kind == TOK_INT || cur.Kind == TOK_CHAR {
		var val int64 = cur.Ival
		l, cur = LexNext(l)
		return l, cur, exprOk(val)
	}
	if cur.Kind == TOK_IDENT {
		var r ExprResult = nameValue(p, cur.Text, true)
		if r.Ok { l, cur = LexNext(l) }
		return l, cur, r
	}
	if cur.Kind == TOK_DOT {
		var r ExprResult = exprOk(0)
		r.Dot = true
		l, cur = LexNext(l)
		return l, cur, r
	}
	if cur.Kind == TOK_ERROR { return l, cur, exprFail(cur.Text) }
	return l, cur, exprFail("")
}

// nameValue returns the value of name in an expression: a number constant's value, an
// alias's symbol and addend, or — when sym — the symbol it names (a numeric local label
// reference resolved to its instance); without sym only a number constant is accepted.
// A use of an alias made global or weak (outside a constant's definition) is the alias's
// own symbol, as clang relocates it — so that another object's definition can override a
// weak one.
func nameValue(p @Parser, name *[]readonly char, sym bool) ExprResult {
	var i int = constIndex(p, name)
	if i >= 0 && p.ConstPending[i] { return pendingResult(p) }
	if i >= 0 && len(p.ConstSyms[i]) == 0 {
		var n ExprResult = exprOk(p.ConstVals[i])
		n.FromDiff = p.ConstFromDiff[i]
		return n
	}
	if i >= 0 && !sym { return exprFail(quotedName(name, " is an alias of a symbol, not a number")) }
	if i < 0 && !sym {
		return exprFail(quotedName(name, " is not a constant defined before this line"))
	}
	var r ExprResult = exprOk(0)
	if i >= 0 {
		if !p.InConstDef {
			if !p.ConstUsed[i] { markAlias(p, i) }
			p.ConstUsed[i] = true
			if nameBound(p, name) {
				r.Sym = buf.CopyStr(name)
				return r
			}
		}
		r.Val = p.ConstVals[i]
		r.Sym = p.ConstSyms[i]
		return r
	}
	r.Sym = resolveLabel(p, name)
	return r
}
