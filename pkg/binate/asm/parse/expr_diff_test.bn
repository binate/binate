package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/asm/arm32"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Differences of two locations against clang's words (`clang -c -target aarch64-linux-gnu`;
// where clang takes no difference — a logical immediate, MOVK, a TBZ bit — the words of
// the same instruction with the folded number).  (labelsWordsHex is in
// aarch64_golden_labels_test.bn, goldenFail in aarch64_golden_test.bn, plContains in
// parse_line_test.bn.)

// diffSource assembles src — its own `.arch` / `.section` lines first — for format as the
// driver does (ParseSource, so a second pass runs when a label difference was pending),
// then resolves the fixups (AArch64's, or arm32's for arm32 input).
func diffSource(src *[]readonly char, format int) @Parser {
	var p @Parser = newTestParser()
	p.Asm.ObjFormat = format
	p.ParseSource(src)
	if !p.HasError && !p.Asm.HasError && p.Asm.CheckTemporaryLabels() {
		if p.Arch == ARCH_ARM32 {
			arm32.ResolveFixups(p.Asm)
		} else {
			aarch64.ResolveFixups(p.Asm)
		}
		if !p.Asm.HasError { p.Asm.Finalize() }
	}
	return p
}

// diffCase checks that src assembles for ELF to exactly the words want (first section).
func diffCase(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	return e
}

// diffReject checks that src is rejected for format with a diagnostic containing want.
func diffReject(e @[]char, src *[]readonly char, format int, want *[]readonly char) @[]char {
	var p @Parser = diffSource(src, format)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = p.Asm.ErrorMsg }
	if !p.HasError && !p.Asm.HasError { return goldenFail(e, src, "accepted") }
	if !plContains(msg, want) { return goldenFail(e, src, buf.Concat("wrong diagnostic: ", msg)) }
	return e
}

// sectionBytesHex returns the bytes of p's section si as lowercase hex.
func sectionBytesHex(p @Parser, si int) @[]char {
	var s @asm.Section = p.Asm.Sections[si]
	var digits *[]readonly char = "0123456789abcdef"
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < s.Len; i++ {
		b.WriteByte(digits[cast(int, s.Data[i] >> 4)])
		b.WriteByte(digits[cast(int, s.Data[i] & 15)])
	}
	return buf.CopyStr(b.String())
}

// A difference of two labels one section apart folds to a number wherever a number goes:
// an immediate — ADD, MOV, a load offset, arithmetic on it, and (where clang takes none)
// a logical immediate, MOVK and a TBZ bit — and a data value of every size.
func TestDiffFixed() testing.TestResult {
	var e @[]char = ""
	e = diffCase(e,
			".arch aarch64\n.section text\nl1: nop\nnop\nl2: nop\nmov x0, #(l2 - l1)\nadd x1, x1, #(l2-l1)\n"
					"ldr x3, [x4, #(l2 - l1)*2]\nand x5, x5, #(l2 - l1)\nmovk x6, #(l2 - l1), lsl #16\n"
					"tbz x7, #(l2 - l1), l1\nsub x8, x8, #(12 - (l2 - l1))",
			"D503201F D503201F D503201F D2800100 91002021 F9400883 927D00A5 F2A00106 3647FF07 D1001108 ")
	var p @Parser = diffSource(
			".arch aarch64\n.section text\nl1: nop\nnop\nl2: nop\n.section data\nd0: .uint32 l2 - l1\n"
					".uint64 l2 - l1\n.uint8 l2 - l1\n.uint16 l2 - l1\n.uint32 (l2 - l1) / 4\n"
					".uint32 (l2 - l1) * 3 + 1\n.int32 -(l2 - l1)\n.uint32 . - d0\n.int32 d0 - .",
			asm.OBJ_ELF)
	if p.HasError { return fail(buf.Concat("data rejected: ", p.ErrorMsg)) }
	var data @[]char = sectionBytesHex(p, 1)
	if !charsEqual(data, "0800000008000000000000000808000200000019000000f8ffffff1b000000e1ffffff") {
		return fail(buf.Concat("data assembled to ", data))
	}
	return e
}

// A difference whose label follows it (a second pass) — in data, ADD, MOV, a load offset,
// a logical immediate (whose placeholder 0 has no encoding on the first pass) and a
// constant defined from it; numeric labels; a difference across alignment padding.
func TestDiffForward() testing.TestResult {
	var e @[]char = ""
	e = diffCase(e,
			".arch aarch64\n.section text\n.uint32 l3 - l1\nmov x0, #(l3 - l1)\nadd x0, x0, #(l3 - l1)\n"
					"ldr x1, [x2, #(l3-l1)]\nand x3, x3, #(l3 - l1)\nD = l3 - l1\nmov x4, #D\n"
					"l1: nop\nnop\nl3: ret",
			"00000008 D2800100 91002000 F9400441 927D0063 D2800104 D503201F D503201F D65F03C0 ")
	e = diffCase(e,
			".arch aarch64\n.section text\n1: nop\n2: nop\nmov x0, #(2b - 1b)\nmov x1, #(3f - 2b)\n3: nop",
			"D503201F D503201F D2800080 D2800181 D503201F ")
	e = diffCase(e, ".arch aarch64\n.section text\nmov x0, #(l2 - l1)\nl1: nop\n.balign 16\nl2: nop",
			"D2800180 D503201F D503201F D503201F D503201F ")
	return e
}

// On Mach-O, two labels one atom apart (a temporary after a symbol) fold; two in
// different atoms do not, so their difference is no number — as on ELF two labels in
// different sections.
func TestDiffNotFixed() testing.TestResult {
	var e @[]char = ""
	var p @Parser = diffSource(
			".arch aarch64\n.section text\n_f:\nL1: nop\nL2: nop\nmov x0, #(L2 - L1)", asm.OBJ_MACHO)
	if p.HasError || !charsEqual(labelsWordsHex(p), "D503201F D503201F D2800080 ") {
		return fail(buf.Concat("one atom's difference not folded: ", p.ErrorMsg))
	}
	e = diffReject(e, ".arch aarch64\n.section text\n_a: nop\n_b: nop\nmov x0, #(_b - _a)",
			asm.OBJ_MACHO, "different sections or atoms is not a number")
	e = diffReject(e, ".arch aarch64\n.section text\n_a: nop\n_b: nop\nb _b - _a", asm.OBJ_MACHO,
			"different sections or atoms is not a number")
	e = diffReject(e, ".arch aarch64\n.section text\n_a: nop\n_b: nop\nD = _b - _a", asm.OBJ_MACHO,
			"different sections or atoms is not a number")
	e = diffReject(e, ".arch aarch64\n.section text\n_a: nop\n_b: nop\n.section data\n.uint32 _b - _a",
			asm.OBJ_MACHO, "different sections or atoms is not a number")
	e = diffReject(e, ".arch aarch64\n.section text\nl1: nop\n.section data\nd1: .uint32 d1 - l1",
			asm.OBJ_ELF, "different sections or atoms is not a number")
	return e
}

// Rejected: a forward difference deciding a size (a count, a fill size, an alignment), a
// constant used before its definition — an alias too, which a forward difference read as a
// label — a label defined nowhere (even one subtracted from itself, as clang: "can not be
// undefined in a subtraction expression"), a lone location as a number, and arithmetic
// other than adding a number on a difference that is not fixed.
func TestDiffRejects() testing.TestResult {
	var e @[]char = ""
	var arch *[]readonly char = ".arch aarch64\n.section text\n"
	e = diffReject(e, buf.Concat(arch, ".zero l3 - l1\nl1: nop\nl3: nop"), asm.OBJ_ELF,
			"cannot depend on a label after it")
	e = diffReject(e, buf.Concat(arch, ".balign l3 - l1\nl1: nop\nl3: nop"), asm.OBJ_ELF,
			"cannot depend on a label after it")
	e = diffReject(e, buf.Concat(arch, ".p2align l3 - l1\nl1: nop\nl3: nop"), asm.OBJ_ELF,
			"cannot depend on a label after it")
	e = diffReject(e, buf.Concat(arch, ".fill l3 - l1, 1, 0\nl1: nop\nl3: nop"), asm.OBJ_ELF,
			"cannot depend on a label after it")
	e = diffReject(e, buf.Concat(arch, ".fill 1, l3 - l1, 0\nl1: nop\nl3: nop"), asm.OBJ_ELF,
			"cannot depend on a label after it")
	e = diffReject(e, buf.Concat(arch, "mov x0, #(l1 - D)\nl1: nop\nD = 5"), asm.OBJ_ELF,
			"'D' was used as a symbol earlier")
	e = diffReject(e, buf.Concat(arch, "mov x0, #(A - l1)\nl1: nop\nl2: nop\nA = l2"), asm.OBJ_ELF,
			"'A' was used as a symbol earlier")
	e = diffReject(e, buf.Concat(arch, "mov x0, #(l1 - nowhere)\nl1: nop"), asm.OBJ_ELF,
			"'nowhere' is not a label defined anywhere")
	e = diffReject(e, buf.Concat(arch, "mov x0, #(nowhere - nowhere)"), asm.OBJ_ELF,
			"'nowhere' is not a label defined anywhere")
	e = diffReject(e,
			buf.Concat(arch, "mov x0, #(nowhere - nowhere)\nl1: nop\nmov x1, #(l2 - l1)\nl2: nop"),
			asm.OBJ_ELF, "'nowhere' is not a label defined anywhere")
	e = diffReject(e, buf.Concat(arch, "l1: nop\n.uint32 l1"), asm.OBJ_ELF,
			"'l1' is a location, not a number")
	e = diffReject(e, buf.Concat(arch, "1: nop\n.uint32 1b"), asm.OBJ_ELF,
			"'1b' is a location, not a number")
	e = diffReject(e, buf.Concat(arch, "1: nop\nl1: nop\nl5: nop\n.uint8 1b - l1 + l5"), asm.OBJ_ELF,
			"'l5' is a location, not a number")
	e = diffReject(e, buf.Concat(arch, "l9: nop\nA = l9\n.uint32 A + 4"), asm.OBJ_ELF,
			"'A' is an alias of a symbol, not a number")
	e = diffReject(e, buf.Concat(arch, "l9: nop\nA = l9\nl1: nop\nl5: nop\n.uint8 A - l1 + l5"),
			asm.OBJ_ELF, "'l5' is a location, not a number")
	e = diffReject(e, buf.Concat(arch, "_a: nop\n_b: nop\n.uint32 (_b - _a) * 2"), asm.OBJ_MACHO,
			"takes only a number added or subtracted")
	return e
}

// The second pass checks that every label landed where the first pass put it: a label
// at another offset is an error naming it.
func TestCheckSecondPassLayout() testing.TestResult {
	var p @Parser = newTestParser()
	p.Prev = asm.New(8)
	p.Prev.SetSection("text", -1)
	p.Prev.EmitUint32(0)
	p.Prev.DefineLabel("x")
	p.Asm.SetSection("text", -1)
	p.Asm.EmitUint32(0)
	p.Asm.DefineLabel("x")
	checkSecondPassLayout(p)
	if p.HasError { return fail("a label in place reported as moved") }
	var q @Parser = newTestParser()
	q.Prev = p.Prev
	q.Asm.SetSection("text", -1)
	q.Asm.EmitUint64(cast(uint64, 0))
	q.Asm.DefineLabel("x")
	checkSecondPassLayout(q)
	if !q.HasError || !plContains(q.ErrorMsg, "'x' moved on the second pass") {
		return fail(buf.Concat("a moved label not reported: ", q.ErrorMsg))
	}
	return ""
}

// arm32 instructions are four bytes too, so a forward difference takes a second pass
// (`mov r0, #4`, clang's E3A00004); an x86-64 instruction's size depends on its values, so
// one there is an error.
func TestDiffOtherArches() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseSource(".arch arm32\n.section text\nmov r0, #(l3 - l1)\nl1: nop\nl3: bx lr")
	if p.HasError { return fail(buf.Concat("arm32 rejected: ", p.ErrorMsg)) }
	if readWord(p.Asm.Sections[0], 0) != 0xE3A00004 { return fail("arm32 mov not #4") }
	var q @Parser = newTestParser()
	q.ParseSource(".arch x64\n.section text\nadd rax, 0 + (l3 - l1)\nl1: nop\nl3: ret")
	if !q.HasError || !plContains(q.ErrorMsg, "x86-64 instruction's size depends on its values") {
		return fail(buf.Concat("an x86-64 forward difference not rejected: ", q.ErrorMsg))
	}
	return ""
}

// A literal-pool value that is a label difference is an entry — never a move, even when the
// value would fit one, and when its label follows the load — of its own when written out
// (clang's words, AArch64 and armv6 ELF).  A difference that folds does not count as a use
// of the alias in it, so the alias may still be redefined.
func TestDiffPoolEntry() testing.TestResult {
	var e @[]char = ""
	e = diffCase(e,
			".arch aarch64\n.section text\nl1: nop\nl2: nop\nldr x0, =(l2 - l1)\nldr w1, =(l2 - l1)\n"
					"ldr x2, =(l2 - l1)\nldr x3, =(l3 - l1)\nb . + (l2 - l1)\nA = l1\n"
					"mov x4, #(l2 - A)\nA = l2\nb A\nl3: nop",
			"D503201F D503201F 58000100 18000121 58000142 58000163 14000001 D2800084 17FFFFF9 "
					"D503201F 00000004 00000000 00000004 00000000 00000004 00000000 00000024 00000000 ")
	e = diffCase(e,
			".arch arm32\n.section text\nl1: nop\nl2: nop\nldr r0, =(l2 - l1)\nldr r1, =(l3 - l1)\n"
					"l3: nop",
			"E1A00000 E1A00000 E59F0004 E59F1004 E1A00000 00000004 00000010 ")
	return e
}

// A constant's name (not a plain number's) shares its entry among the loads reading one
// definition — a difference, an alias whose value waits on a later label, and `.` plus a
// difference alike, on both passes — and a redefinition takes a new entry; W and X loads
// take entries of their sizes (clang's words).
func TestDiffPoolNamedConst() testing.TestResult {
	var e @[]char = ""
	var arch *[]readonly char = ".arch aarch64\n.section text\n"
	e = diffCase(e,
			buf.Concat(arch,
					"l1: nop\nl2: nop\nx = l2 - l1\nldr x2, =x\nldr x3, =x\nldr w4, =x\nl3: nop\n.ltorg\n"
							"l4: nop"),
			"D503201F D503201F 58000082 58000063 18000084 D503201F 00000004 00000000 00000004 "
					"D503201F ")
	e = diffCase(e,
			buf.Concat(arch,
					".global ext\nl1: nop\nx = ext + (l3 - l1)\nldr x1, =x\nldr x2, =x\nl3: nop\n"
							".ltorg\nl4: nop"), "D503201F 58000061 58000042 D503201F 00000000 00000000 D503201F ")
	e = diffCase(e,
			buf.Concat(arch, "l1: nop\nx = . + (l3 - l1)\nldr x1, =x\nldr x2, =x\nl3: nop\n.ltorg\nl4: nop"),
			"D503201F 58000061 58000042 D503201F 00000000 00000000 D503201F ")
	e = diffCase(e,
			buf.Concat(arch,
					"x = l3 - l1\nldr x0, =x\nx = l3 - l2\nldr x1, =x\nl1: nop\nl2: nop\nl3: nop\n"
							".ltorg"),
			"580000C0 580000E1 D503201F D503201F D503201F 00000000 00000008 00000000 00000004 "
					"00000000 ")
	e = diffCase(e,
			".arch arm32\n.section text\nl1: nop\nl2: nop\nx = l2 - l1\nldr r0, =x\nldr r1, =x\n"
					"l3: nop\n.ltorg\nl4: nop",
			"E1A00000 E1A00000 E59F0004 E59F1000 E1A00000 00000004 E1A00000 ")
	return e
}

// A global alias whose only use is in a difference that folds is not used through its
// symbol: it may be made global after, and redefined once global — as clang does; a branch
// to it is a use (TestAliasRejects).
func TestDiffAliasNotUsed() testing.TestResult {
	var e @[]char = ""
	var arch *[]readonly char = ".arch aarch64\n.section text\n"
	e = diffCase(e, buf.Concat(arch, "l1: nop\nl2: nop\nA = l1\nmov x0, #(l2 - A)\n.global A"),
			"D503201F D503201F D2800080 ")
	e = diffCase(e, buf.Concat(arch, ".global A\nl1: nop\nl2: nop\nA = l1\nmov x0, #(l2 - A)\nA = l2"),
			"D503201F D503201F D2800080 ")
	e = diffReject(e, buf.Concat(arch, ".global A\nl1: nop\nl2: nop\nA = l1\nb A\nA = l2"),
			asm.OBJ_ELF, "used since its definition")
	return e
}

// A label difference is no AArch64 PC-relative target (a branch, ADR / ADRP, a literal
// load): clang reads it there as an absolute address, where a number is an offset from the
// instruction here.  `.` plus the difference is that offset.
func TestDiffPCRelative() testing.TestResult {
	var e @[]char = ""
	var arch *[]readonly char = ".arch aarch64\n.section text\nl1: nop\nl2: nop\n"
	var want *[]readonly char = "is an absolute address"
	e = diffReject(e, buf.Concat(arch, "b l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "bl #(l2 - l1)"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "b.eq l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "cbz x0, l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "tbz x0, #1, l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "adr x0, l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "adrp x0, l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "ldr x0, l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "prfm pldl1keep, l2 - l1"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "D = (l2 - l1) * 2\nb D"), asm.OBJ_ELF, want)
	e = diffReject(e, buf.Concat(arch, "b l3 - l1\nl3: nop"), asm.OBJ_ELF, want)
	e = diffReject(e, ".arch aarch64\n.section text\nL1: nop\nL2: nop\nb L2 - L1", asm.OBJ_MACHO, want)
	e = diffCase(e, buf.Concat(arch, "b . + (l2 - l1)\nadr x0, . + (l2 - l1)\nldr x1, . + (l2 - l1)"),
			"D503201F D503201F 14000001 10000020 58000021 ")
	return e
}

// On Mach-O a temporary label is in the atom of the symbol defined before it — by order of
// definition, not by offset: one defined just before a symbol at the same offset is in the
// earlier atom, and `.` is in the atom of the symbol defined last; on a second pass too
// (clang's words and rejects).
func TestDiffAtomsByDefinition() testing.TestResult {
	var e @[]char = ""
	var arch *[]readonly char = ".arch aarch64\n.section text\n"
	var p @Parser = diffSource(
			buf.Concat(arch,
					"_f: nop\nL1:\n_g: nop\nL2: nop\nmov x0, #(L1 - _f)\nmov x1, #(. - _g)\n_h:\n"
							"mov x2, #(. - _h)"), asm.OBJ_MACHO)
	if p.HasError ||
			!charsEqual(labelsWordsHex(p), "D503201F D503201F D503201F D2800080 D2800181 D2800002 ") {
		return fail(buf.Concat("one atom's differences not folded: ", p.ErrorMsg))
	}
	p = diffSource(buf.Concat(arch, "_f: mov x0, #(L2 - L1)\nL1: nop\nL2: nop"), asm.OBJ_MACHO)
	if p.HasError || !charsEqual(labelsWordsHex(p), "D2800080 D503201F D503201F ") {
		return fail(buf.Concat("one atom's forward difference not folded: ", p.ErrorMsg))
	}
	var want *[]readonly char = "different sections or atoms is not a number"
	e = diffReject(e, buf.Concat(arch, "_f: nop\nL1:\n_g: nop\nmov x0, #(_g - L1)"), asm.OBJ_MACHO,
			want)
	e = diffReject(e, buf.Concat(arch, "_f: nop\n_g:\nmov x0, #(. - _f)"), asm.OBJ_MACHO, want)
	e = diffReject(e, buf.Concat(arch, "_f: mov x0, #(L2 - L1)\nL1:\n_g: nop\nL2: nop"), asm.OBJ_MACHO,
			want)
	return e
}

// A `.` label made on the second pass only — for a value pending on the first, here `.`
// plus a forward difference — shifts the names of the labels made after it; those labels,
// which no difference names, are not checked for having moved.
func TestDiffMadeLabelsAcrossPasses() testing.TestResult {
	var p @Parser = diffSource(
			".arch aarch64\n.section text\nldr x0, =. + (l3 - l1)\nC = .\nb C\nl1: nop\nl3: nop",
			asm.OBJ_ELF)
	if p.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return fail(buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var s @asm.Section = p.Asm.Sections[0]
	if readWord(s, 0) != 0x58000080 || readWord(s, 4) != 0x14000000 {
		return fail(buf.Concat("assembled to ", labelsWordsHex(p)))
	}
	return ""
}
