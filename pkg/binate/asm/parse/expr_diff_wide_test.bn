package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Label differences past a 32-bit host's int (2^31) and uint (2^32): a location's offset is
// an int64, so a 32-bit host folds them as a 64-bit one does.  (diffSource and
// sectionBytesHex are in expr_diff_test.bn, sectionIndex in parse_test.bn, goldenFail in
// aarch64_golden_test.bn.)

// diffWideCase checks that src assembles for ELF and that its data section holds exactly the
// bytes want (hex).
func diffWideCase(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var si int = sectionIndex(p, "data")
	if si < 0 { return goldenFail(e, src, "no data section") }
	var got @[]char = sectionBytesHex(p, si)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	return e
}

// Two labels 5 GiB apart in bss (five 1 GiB `.zero`s) differ by 0x140000000 either way; an
// alias 2^32 past a label is 2^32 from it.
func TestDiffPast4GiB() testing.TestResult {
	var e @[]char = ""
	e = diffWideCase(e,
			".arch aarch64\n.section bss\nl1: .zero 0x40000000\n.zero 0x40000000\n.zero 0x40000000\n"
					".zero 0x40000000\n.zero 0x40000000\nl2: .zero 8\n.section data\n.uint64 l2 - l1\n"
					".uint64 l1 - l2",
			"0000004001000000000000c0feffffff")
	e = diffWideCase(e,
			".arch aarch64\n.section data\nl1: .uint64 0\nA = l1 + 0x100000000\n.uint64 A - l1",
			"00000000000000000000000001000000")
	return e
}

// An alias 2^32 past a label is listed there, as a 64-bit host lists it (a symbol's offset
// is a uint64).  (listedAlias is in parse_const_list_test.bn.)
func TestAliasPast4GiB() testing.TestResult {
	return listedAlias("", "nop\nlbl: nop\nnop\nB = lbl + 0x100000000", "B", 0x100000004, true)
}
