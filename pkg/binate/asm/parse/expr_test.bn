package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// --- Expression tests ---

// exprTestParser returns a parser with no constants defined, for evaluating expressions
// directly.
func exprTestParser() @Parser {
	return NewParser(asm.New(8), "t.s")
}

func TestExprSimple() testing.TestResult {
	var l Lexer = NewLexer("42", 1)
	var tok Token
	l, tok = LexNext(l)
	var result ExprResult
	l, tok, result = ParseExpr(exprTestParser(), l, tok)
	if !result.Ok || result.Val != 42 { return fail("expected 42") }
	return ""
}

func TestExprArith() testing.TestResult {
	var l Lexer = NewLexer("3 + 4 * 2", 1)
	var tok Token
	l, tok = LexNext(l)
	var result ExprResult
	l, tok, result = ParseExpr(exprTestParser(), l, tok)
	// 3 + (4*2) = 11 (multiplication has higher precedence)
	if !result.Ok || result.Val != 11 { return fail("expected 11") }
	return ""
}

func TestExprBitwise() testing.TestResult {
	var l Lexer = NewLexer("(1 << 3) | 1", 1)
	var tok Token
	l, tok = LexNext(l)
	var result ExprResult
	l, tok, result = ParseExpr(exprTestParser(), l, tok)
	if !result.Ok || result.Val != 9 { return fail("expected 9") }
	return ""
}

// exprLineRejected parses src as one line of arch (".arch" name) in a text section and reports
// whether it was rejected.
func exprLineRejected(arch *[]readonly char, src *[]readonly char) bool {
	var p @Parser = newTestParser()
	p.ParseLine(buf.Concat(".arch ", arch))
	p.ParseLine(".section text")
	p.ParseLine(src)
	return p.HasError
}

// An expression the evaluator rejects fails the whole line on x64 and arm32 too — a
// memory displacement or scale, an imul immediate, a shift amount — rather than being
// dropped (which assembled `[rbx + 1<<2+1]` as `[rbx]`).
func TestExprRejectionFailsLineAllArches() testing.TestResult {
	if !exprLineRejected("x64", "mov rax, [rbx + 1<<2+1]") { return fail("x64 displacement") }
	if !exprLineRejected("x64", "mov rax, [rbx - 4|1+2]") { return fail("x64 negative displacement") }
	if !exprLineRejected("x64", "mov rax, [rbx + rcx*1<<1+1]") { return fail("x64 scale") }
	if !exprLineRejected("x64", "imul rax, rbx, 1<<2+1") { return fail("x64 imul immediate") }
	if !exprLineRejected("x64", "mov rax, 4|1&2") { return fail("x64 immediate") }
	if !exprLineRejected("arm32", "add r0, r1, r2, lsl #1<<1+1") { return fail("arm32 shift amount") }
	if !exprLineRejected("arm32", "ldr r0, [r1, r2, lsl #1<<64]") { return fail("arm32 index shift") }
	if !exprLineRejected("arm32", "svc #1<<64") { return fail("arm32 svc") }
	if !exprLineRejected("x64", "int 1/0") { return fail("x64 int") }
	if !exprLineRejected("arm32", "bkpt #1/0") { return fail("arm32 bkpt") }
	if !exprLineRejected("arm32", "movw r0, #1/0") { return fail("arm32 movw") }
	if !exprLineRejected("arm32", "movt r0, #1/0") { return fail("arm32 movt") }
	if !exprLineRejected("arm32", "mov r0, #1/0") { return fail("arm32 immediate") }
	if exprLineRejected("x64", "mov rax, [rbx + 8]") { return fail("x64 plain displacement") }
	return ""
}

// Evaluator rules for mixes clang's three tables (Darwin, GNU, x86 Intel) disagree
// on: two bitwise operators at one level, and a right shift of a negative value.
func TestExprBitwiseMixAndNegativeShift() testing.TestResult {
	var srcs @[]@[]char = make_slice(@[]char, 4)
	srcs[0] = buf.CopyStr("4 | 1 & 2")
	srcs[1] = buf.CopyStr("1 ^ 2 | 3")
	srcs[2] = buf.CopyStr("-16 >> 2")
	srcs[3] = buf.CopyStr("(1 << 63) >> 1")
	for i := 0; i < len(srcs); i++ {
		var l Lexer = NewLexer(srcs[i], 1)
		var tok Token
		l, tok = LexNext(l)
		var r ExprResult
		l, tok, r = ParseExpr(exprTestParser(), l, tok)
		if r.Ok { return fail(buf.Concat("accepted: ", srcs[i])) }
		if len(r.Err) == 0 { return fail(buf.Concat("no diagnostic for: ", srcs[i])) }
	}
	var l2 Lexer = NewLexer("(4 | 1) & 2 | 8", 1)
	var tok2 Token
	l2, tok2 = LexNext(l2)
	var r2 ExprResult
	l2, tok2, r2 = ParseExpr(exprTestParser(), l2, tok2)
	if r2.Ok { return fail("`(4 | 1) & 2 | 8` mixes & and | at the outer level") }
	return ""
}

// nestedExpr returns `1` wrapped in n levels of `open`/`close` (a unary operator
// has an empty close).
func nestedExpr(n int, open char, close char, hasClose bool) @[]char {
	var total int = n + 1
	if hasClose { total = total + n }
	var s @[]char = make_slice(char, total)
	for i := 0; i < n; i++ { s[i] = open }
	s[n] = '1'
	if hasClose {
		for i := 0; i < n; i++ { s[n + 1 + i] = close }
	}
	return s
}

// exprResultOf evaluates src as one whole expression.
func exprResultOf(src *[]readonly char) ExprResult {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = ParseExpr(exprTestParser(), l, tok)
	return r
}

// Nesting of parentheses and unary operators is bounded (the evaluator recurses
// per level): deep-but-reasonable nesting evaluates, and past maxExprDepth the
// expression fails with a diagnostic instead of exhausting the stack.
func TestExprNestingDepthLimit() testing.TestResult {
	var r ExprResult = exprResultOf(nestedExpr(maxExprDepth - 2, '(', ')', true))
	if !r.Ok || r.Val != 1 { return fail("deep parentheses under the limit") }
	r = exprResultOf(nestedExpr(maxExprDepth - 2, '~', ' ', false))
	if !r.Ok || r.Val != 1 { return fail("an even run of ~ under the limit") }
	r = exprResultOf(nestedExpr(maxExprDepth + 1, '(', ')', true))
	if r.Ok { return fail("parentheses past the limit accepted") }
	if !plContains(r.Err, "nested too deeply") { return fail(r.Err) }
	r = exprResultOf(nestedExpr(maxExprDepth + 1, '-', ' ', false))
	if r.Ok { return fail("unary minus past the limit accepted") }
	if !plContains(r.Err, "nested too deeply") { return fail(r.Err) }
	return ""
}
