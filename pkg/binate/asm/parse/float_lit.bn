package "pkg/binate/asm/parse"

// Floating-point literal values (TOK_FLOAT text, as the lexer accepted it: decimal
// `d.d`, `d.`, `.d` or `dEd`, each with an optional exponent where it has none, or
// hexadecimal `0xh.hPd`, `0x.hPd` or `0xhPd`).

// floatLitIsZero reports whether a floating-point literal's value is exactly zero:
// every digit of its significand (the part before the exponent) is 0.  A nonzero
// literal small enough to round to zero (`1e-400`) is not zero here.
func floatLitIsZero(text *[]readonly char) bool {
	var i int = 0
	var hex bool = len(text) > 1 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')
	if hex { i = 2 }
	for i < len(text) {
		var c char = text[i]
		if hex && (c == 'p' || c == 'P') { return true }
		if !hex && (c == 'e' || c == 'E') { return true }
		if c != '0' && c != '.' { return false }
		i = i + 1
	}
	return true
}

// FMOV's 8-bit floating-point immediate encodes ±(16 + n) / 16 × 2^e for n in [0, 15]
// and e in [-3, 4], so every such value times 128 is an integer in [16, 3968] (0.125 to
// 31.0).  A literal's value is decided exactly — never rounded — by computing value ×
// 128 as an integer.

// fp8Imm returns the 8-bit immediate (sign neg) of the value w / 128, w a positive
// integer, or -1 when no n and e give it.
func fp8Imm(neg bool, w uint64) int {
	for s := 0; s <= 7; s++ {
		var unit uint64 = cast(uint64, 1) << cast(uint64, s)
		var m uint64 = w >> cast(uint64, s)
		if w % unit == 0 && m >= 16 && m <= 31 {
			// value = m / 16 × 2^(s - 3): imm8<7> = sign, imm8<6> = NOT(s<2>),
			// imm8<5:4> = s<1:0>, imm8<3:0> = m - 16.
			var imm int = (cast(int, m) - 16) | ((s & 3) << 4)
			if (s & 4) == 0 { imm = imm | 0x40 }
			if neg { imm = imm | 0x80 }
			return imm
		}
	}
	return -1
}

// literalDigits scans the significand of a floating-point literal from text[i] (hex
// digits if hex, else decimal), stopping at the exponent letter or the end.  It
// returns the digits with the '.' removed, how many followed the '.', and where it
// stopped.
func literalDigits(text *[]readonly char, i int, hex bool) (@[]char, int, int) {
	var digits @[]char = make_slice(char, len(text))
	var n int = 0
	var frac int = -1
	for i < len(text) {
		var c char = text[i]
		if c == '.' {
			frac = 0
		} else if (hex && isHexDigit(c)) || (!hex && isDigit(c)) {
			digits[n] = c
			n = n + 1
			if frac >= 0 { frac = frac + 1 }
		} else {
			break
		}
		i = i + 1
	}
	if frac < 0 { frac = 0 }
	return digits[0:n], frac, i
}

// literalExp parses an optional exponent (letter, sign, decimal digits) at text[i],
// saturating its magnitude at bound + 1: every exponent past bound (which exceeds any
// significand-length shift plus every representable value's exponent) puts the value
// out of range alike, so saturating keeps the result exact.
func literalExp(text *[]readonly char, i int, bound int64) int64 {
	if i >= len(text) { return 0 }
	i = i + 1
	var neg bool = false
	if i < len(text) && (text[i] == '+' || text[i] == '-') {
		neg = text[i] == '-'
		i = i + 1
	}
	var v int64 = 0
	for i < len(text) && isDigit(text[i]) {
		if v <= bound { v = v * 10 + cast(int64, text[i]) - cast(int64, '0') }
		i = i + 1
	}
	if v > bound { v = bound + 1 }
	if neg { return -v }
	return v
}

// floatLitTimes128 returns a floating-point literal's value times 128 as an exact
// integer, or ok=false when that is not an integer below 2^40 or the significand has
// more digits than any 8-bit FP immediate needs (either way no 8-bit immediate has the
// value).  A zero literal gives 0.
func floatLitTimes128(text *[]readonly char) (uint64, bool) {
	var hex bool = len(text) > 1 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')
	var start int = 0
	if hex { start = 2 }
	digits, frac, end := literalDigits(text, start, hex)
	var exp int64 = literalExp(text, end, 4 * cast(int64, len(text)) + 100)
	// Drop leading zeros, and trailing zeros into the exponent (a digit is 4 bits of a
	// hex significand, a power of ten of a decimal one).
	var lo int = 0
	for lo < len(digits) && digits[lo] == '0' { lo = lo + 1 }
	var hi int = len(digits)
	var shift int64 = cast(int64, -frac)
	for hi > lo && digits[hi - 1] == '0' {
		hi = hi - 1
		shift = shift + 1
	}
	if lo == hi { return 0, true }
	if hi - lo > 12 { return 0, false }
	var base uint64 = 10
	if hex { base = 16 }
	var d uint64 = 0
	for k := lo; k < hi; k++ { d = d * base + cast(uint64, hexVal(digits[k])) }
	if hex { return scaleBinary(d, exp + 4 * shift + 7) }
	return scaleDecimal(d * 128, exp + shift)
}

// scaleBinary returns d × 2^q if it is an integer below 2^40, else ok=false.
func scaleBinary(d uint64, q int64) (uint64, bool) {
	var limit uint64 = cast(uint64, 1) << 40
	if q >= 0 {
		if q > 40 || d >= (limit >> cast(uint64, q)) { return 0, false }
		return d << cast(uint64, q), true
	}
	if q < -60 { return 0, false }
	var unit uint64 = cast(uint64, 1) << cast(uint64, -q)
	if d % unit != 0 || d / unit >= limit { return 0, false }
	return d / unit, true
}

// scaleDecimal returns d × 10^k if it is an integer below 2^40, else ok=false.  (Each
// loop ends within a few steps however large |k| is: d passes 2^40, or stops dividing.)
func scaleDecimal(d uint64, k int64) (uint64, bool) {
	var limit uint64 = cast(uint64, 1) << 40
	for k > 0 {
		if d >= limit { return 0, false }
		d = d * 10
		k = k - 1
	}
	for k < 0 {
		if d % 10 != 0 { return 0, false }
		d = d / 10
		k = k + 1
	}
	if d >= limit { return 0, false }
	return d, true
}
