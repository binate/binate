package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Floating-point literal lexing (litSeq / litKindCode are in lex_literal_test.bn).

// litFloat checks that all of src lexes to one TOK_FLOAT whose text is src and whose
// zero-ness is zero.
func litFloat(e @[]char, src *[]readonly char, zero bool) @[]char {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_FLOAT { return goldenFail(e, src, "did not lex as a floating-point literal") }
	if !charsEqual(tok.Text, src) { return goldenFail(e, src, "token text is not the literal") }
	if floatLitIsZero(tok.Text) != zero { return goldenFail(e, src, "wrong zero-ness") }
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF { return goldenFail(e, src, "did not consume the whole literal") }
	return e
}

// Decimal `d.d`, `d.`, `.d` with an optional exponent, `dEd` with a nonzero leading
// digit, and hexadecimal `0xh.hPd` are one TOK_FLOAT each.
func TestLexFloat() testing.TestResult {
	var e @[]char = ""
	e = litFloat(e, "0.0", true)
	e = litFloat(e, "0.", true)
	e = litFloat(e, ".0", true)
	e = litFloat(e, "0.00e7", true)
	e = litFloat(e, ".5", false)
	e = litFloat(e, "1.5e3", false)
	e = litFloat(e, "1.5E-3", false)
	e = litFloat(e, "5.e+1", false)
	e = litFloat(e, "1e5", false)
	e = litFloat(e, "0x1.8p1", false)
	e = litFloat(e, "0X1P-2", false)
	e = litFloat(e, "0x.8p0", false)
	e = litFloat(e, "0x0.0p0", true)
	e = litFloat(e, "0x1p3", false)
	e = litFloat(e, "123456789012345678901.5", false)
	e = litFloat(e, "100000000000000000000e-400", false)
	e = litFloat(e, "0x10000000000000000.0p-2000", false)
	return e
}

// Not floats: a GNU octal integer part ends the number before the '.' (whose `.5` is
// then a separate literal), and an exponent-only zero or a dangling exponent letter
// ends it before the letter; a hexadecimal float without its `p` exponent is an error;
// `.name` and dotted identifiers are unchanged.
func TestLexFloatBoundaries() testing.TestResult {
	var e @[]char = ""
	e = litSeq(e, "01.5", "NF")
	e = litSeq(e, "0e1", "NI")
	e = litSeq(e, "1.5e", "FI")
	e = litSeq(e, "1e", "NI")
	e = litSeq(e, "1e+", "NI+")
	e = litSeq(e, "0x1.8", "E")
	e = litSeq(e, "1.5.5", "FF")
	e = litSeq(e, ".global", ".I")
	e = litSeq(e, "memcpy.part.0", "I")
	e = litSeq(e, "0x1e5", "N")
	e = litSeq(e, "123456789012345678901", "E")
	e = litSeq(e, "0x10000000000000000", "E")
	return e
}

// times128Is checks floatLitTimes128(src): the exact value × 128, or not representable
// (want < 0).
func times128Is(e @[]char, src *[]readonly char, want int64) @[]char {
	w, ok := floatLitTimes128(src)
	if want < 0 {
		if ok { return goldenFail(e, src, "value taken as exact") }
		return e
	}
	if !ok || cast(int64, w) != want { return goldenFail(e, src, "wrong exact value") }
	return e
}

// A literal's value × 128 is exact however it is spelled (redundant zeros, hex floats,
// exponents); a value needing more precision — even one digit far down — is not.
func TestFloatLitTimes128() testing.TestResult {
	var e @[]char = ""
	e = times128Is(e, "0.125", 16)
	e = times128Is(e, "31.0", 3968)
	e = times128Is(e, "0.1250000000000000000000000", 16)
	e = times128Is(e, "000.125", 16)
	e = times128Is(e, "1.25e1", 1600)
	e = times128Is(e, "12500e-4", 160)
	e = times128Is(e, "0x1.8p1", 384)
	e = times128Is(e, "0x.8p0", 64)
	e = times128Is(e, "0x10.0p-7", 16)
	e = times128Is(e, ".0e-3", 0)
	e = times128Is(e, "0x0p99", 0)
	e = times128Is(e, "1.50000000000000000001", -1)
	e = times128Is(e, "0.0078125", 1)
	e = times128Is(e, "0.00390625", -1)
	e = times128Is(e, "1e100", -1)
	e = times128Is(e, "0x1p100", -1)
	e = times128Is(e, "0x1p-100", -1)
	return e
}

// fp8Imm packs sign : NOT(b) : cd : n for value w / 128 = (16 + n) / 16 × 2^(b:cd - 3).
func TestFp8Imm() testing.TestResult {
	if fp8Imm(false, 128) != 0x70 { return "1.0" }
	if fp8Imm(false, 256) != 0x00 { return "2.0" }
	if fp8Imm(true, 3968) != 0xBF { return "-31.0" }
	if fp8Imm(false, 16) != 0x40 { return "0.125" }
	if fp8Imm(false, 8) >= 0 { return "0.0625 has no 8-bit form" }
	if fp8Imm(false, 4096) >= 0 { return "32.0 has no 8-bit form" }
	if fp8Imm(false, 33) >= 0 { return "33/128 has no 8-bit form" }
	return ""
}

// longHexLiteral returns `0x1`, zeros zero hex digits, then `p` and exp.
func longHexLiteral(zeros int, exp *[]readonly char) @[]char {
	var s @[]char = make_slice(char, 4 + zeros + len(exp))
	s[0] = '0'
	s[1] = 'x'
	s[2] = '1'
	for i := 0; i < zeros; i++ { s[3 + i] = '0' }
	s[3 + zeros] = 'p'
	for i := 0; i < len(exp); i++ { s[4 + zeros + i] = exp[i] }
	return s
}

// An exponent of any size is exact against a significand of any length: 0x1 followed by
// 250000 zero digits is 2^1000000, so `p-1000000` makes exactly 1.0 and `p-10000000`
// a value far too small.
func TestFloatLitTimes128HugeExponent() testing.TestResult {
	var e @[]char = ""
	e = times128Is(e, longHexLiteral(250000, "-1000000"), 128)
	e = times128Is(e, longHexLiteral(250000, "-10000000"), -1)
	e = times128Is(e, longHexLiteral(250000, "-999999999999999999999999"), -1)
	e = times128Is(e, longHexLiteral(3, "-99999999999999999999"), -1)
	return e
}
