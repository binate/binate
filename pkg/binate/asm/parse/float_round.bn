package "pkg/binate/asm/parse"

// A floating-point literal's value as clang's ARM parser reads a VMOV immediate: rounded to IEEE
// single precision (to nearest, ties to even), which VFPv3's 8-bit immediate must then encode.
// Each value an 8-bit immediate encodes, ±m / 16 × 2^e (m 16 .. 31, e -3 .. 4), has a significand
// of at most five bits, so a literal rounds to it exactly when it lies within half a
// single-precision unit in the last place of it -- below a power of two, where the units are half
// as large, within half that -- the bounds included (the encodable value's significand is the
// even one).  The literal is compared with those bounds exactly, as decimal digits.

// decNum is an exact non-negative decimal: digits (0 .. 9, the most significant first, no leading
// zero) over 10^scale.
type decNum struct {
	digits @[]uint8
	scale  int
}

// decMulSmall returns d times k (2 .. 16).
func decMulSmall(d decNum, k int) decNum {
	var out @[]uint8 = make_slice(uint8, len(d.digits) + 2)
	var carry int = 0
	for i := len(d.digits) - 1; i >= -2; i-- {
		var v int = carry
		if i >= 0 { v = v + cast(int, d.digits[i]) * k }
		out[i + 2] = cast(uint8, v % 10)
		carry = v / 10
	}
	var r decNum
	r.scale = d.scale
	var lead int = 0
	for lead < len(out) && out[lead] == 0 { lead = lead + 1 }
	r.digits = out[lead:len(out)]
	return r
}

// decCmp returns the sign of a - b.
func decCmp(a decNum, b decNum) int {
	// The digits left of the point; with no leading zeros, more of them is the larger value.
	var ai int = len(a.digits) - a.scale
	var bi int = len(b.digits) - b.scale
	if len(a.digits) == 0 || len(b.digits) == 0 {
		if len(a.digits) == len(b.digits) { return 0 }
		if len(a.digits) == 0 { return -1 }
		return 1
	}
	if ai != bi {
		if ai < bi { return -1 }
		return 1
	}
	var n int = len(a.digits)
	if len(b.digits) > n { n = len(b.digits) }
	for i := 0; i < n; i++ {
		var x uint8 = 0
		var y uint8 = 0
		if i < len(a.digits) { x = a.digits[i] }
		if i < len(b.digits) { y = b.digits[i] }
		if x != y {
			if x < y { return -1 }
			return 1
		}
	}
	return 0
}

// decDyadic returns n / 2^29 exactly (n × 5^29 / 10^29).
func decDyadic(n uint64) decNum {
	var d decNum
	d.digits = make_slice(uint8, 20)
	var k int = 20
	for n > 0 {
		k = k - 1
		d.digits[k] = cast(uint8, n % 10)
		n = n / 10
	}
	d.digits = d.digits[k:20]
	for i := 0; i < 29; i++ { d = decMulSmall(d, 5) }
	d.scale = 29
	return d
}

// decOfLiteral returns a floating-point literal's value (text, as the lexer took it: decimal or
// `0x` hexadecimal with a `p` exponent), and whether it is one no 8-bit immediate is beyond the
// reach of: zero, at least 2^7 and below 2^-64 are not (nor near any).
func decOfLiteral(text *[]readonly char) (decNum, bool) {
	var r decNum
	var hex bool = len(text) > 1 && text[0] == '0' && (text[1] == 'x' || text[1] == 'X')
	var start int = 0
	if hex { start = 2 }
	digits, frac, end := literalDigits(text, start, hex)
	var exp int64 = literalExp(text, end, 4 * cast(int64, len(text)) + 1000)
	var lead int = 0
	for lead < len(digits) && digits[lead] == '0' { lead = lead + 1 }
	if lead == len(digits) { return r, false }
	if !hex {
		var scale int64 = cast(int64, frac) - exp
		var whole int64 = cast(int64, len(digits) - lead) - scale
		if whole > 3 || whole < -64 { return r, false }
		r.digits = make_slice(uint8, len(digits) - lead)
		for i := lead; i < len(digits); i++ { r.digits[i - lead] = cast(uint8, digits[i] - '0') }
		for scale < 0 {
			r = decMulSmall(r, 10)
			scale = scale + 1
		}
		r.scale = cast(int, scale)
		return r, true
	}
	// A hexadecimal significand times 2^q.
	var q int64 = exp - 4 * cast(int64, frac)
	var bits int64 = 4 * cast(int64, len(digits) - lead)
	if bits + q > 8 || bits + q < -213 { return r, false }
	r.digits = make_slice(uint8, 0)
	for i := lead; i < len(digits); i++ {
		r = decMulSmall(r, 16)
		r = decAddSmall(r, hexVal(digits[i]))
	}
	for q > 0 {
		r = decMulSmall(r, 2)
		q = q - 1
	}
	var shifts int = 0
	for q < 0 {
		r = decMulSmall(r, 5)
		q = q + 1
		shifts = shifts + 1
	}
	r.scale = shifts
	return r, true
}

// decAddSmall returns the integer d (scale 0) plus k (0 .. 15).
func decAddSmall(d decNum, k int) decNum {
	var out @[]uint8 = make_slice(uint8, len(d.digits) + 1)
	var carry int = k
	for i := len(d.digits) - 1; i >= -1; i-- {
		var v int = carry
		if i >= 0 { v = v + cast(int, d.digits[i]) }
		out[i + 1] = cast(uint8, v % 10)
		carry = v / 10
	}
	var lead int = 0
	for lead < len(out) && out[lead] == 0 { lead = lead + 1 }
	var r decNum
	r.digits = out[lead:len(out)]
	return r
}

// floatLitSingleImm returns the 8-bit immediate (sign neg) of the value a floating-point literal
// (text) rounds to in single precision, or -1 when no 8-bit immediate encodes that value.
func floatLitSingleImm(neg bool, text *[]readonly char) int {
	lit, ok := decOfLiteral(text)
	if !ok { return -1 }
	// The candidates in increasing order, index k = 16 s + (m - 16): m × 2^(s - 7), s 0 .. 7, in the
	// binade from 2^(s - 3); in units of 2^-29, v = m × 2^(s + 22), half a unit in the last place
	// 2^(s + 2) (2^(s + 1) below a power of two, m = 16).  Find the first whose upper bound is not
	// below the literal.
	var lo int = 0
	var hi int = 128
	for lo < hi {
		var mid int = (lo + hi) / 2
		var m uint64 = cast(uint64, 16 + mid % 16)
		var s uint64 = cast(uint64, mid / 16)
		var upper uint64 = (m << (s + 22)) + (cast(uint64, 1) << (s + 2))
		if decCmp(decDyadic(upper), lit) < 0 {
			lo = mid + 1
		} else {
			hi = mid
		}
	}
	if lo == 128 { return -1 }
	var m uint64 = cast(uint64, 16 + lo % 16)
	var s uint64 = cast(uint64, lo / 16)
	var below uint64 = cast(uint64, 1) << (s + 2)
	if m == 16 { below = cast(uint64, 1) << (s + 1) }
	if decCmp(decDyadic((m << (s + 22)) - below), lit) > 0 { return -1 }
	return fp8Imm(neg, m << s)
}
