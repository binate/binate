package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// roundIs appends to e unless floatLitSingleImm(neg, text) is want.
func roundIs(e @[]char, neg bool, text *[]readonly char, want int) @[]char {
	if floatLitSingleImm(neg, text) == want { return e }
	return buf.Concat(e, buf.Concat(text, ": not clang's immediate\n"))
}

// A literal rounds to single precision as clang rounds it, to nearest with ties to even, and gives
// the 8-bit immediate of that value if one encodes it: within half a unit in the last place of an
// encodable value (half that below a power of two), the bounds included, it is that value; past
// them, or zero, too small or too large, it is none.  Decimal and hexadecimal literals alike.
func TestFloatLitSingleImm() testing.TestResult {
	var e @[]char = ""
	e = roundIs(e, false, "1.0", 0x70)
	e = roundIs(e, true, "2.5", 0x84)
	e = roundIs(e, false, "31.0", 0x3F)
	e = roundIs(e, false, "0.125", 0x40)
	e = roundIs(e, false, "1.00000005", 0x70)
	e = roundIs(e, false, "1.9999999999", 0x00)
	e = roundIs(e, false, "0.124999999", 0x40)
	e = roundIs(e, false, "1.0000000000000002", 0x70)
	e = roundIs(e, false, "1.0000000000001", 0x70)
	e = roundIs(e, false, "1.000000059604644775390625", 0x70)
	e = roundIs(e, false, "1.000000059604644775390626", -1)
	e = roundIs(e, false, "0.999999970197677612304687500", 0x70)
	e = roundIs(e, false, "0.9999999701976776123046874", -1)
	e = roundIs(e, false, "31.0000009", 0x3F)
	e = roundIs(e, false, "31.000001", -1)
	e = roundIs(e, false, "0.12499999627470970153808593750", 0x40)
	e = roundIs(e, false, "0.12499999627470970153808593749", -1)
	e = roundIs(e, false, "2.4999999", 0x04)
	e = roundIs(e, false, "0x1.000001p0", 0x70)
	e = roundIs(e, false, "0x1.0000008p0", 0x70)
	e = roundIs(e, false, "0x1.0000018p0", -1)
	e = roundIs(e, false, "0x1.fffffffp4", -1)
	e = roundIs(e, false, "0x1.8p1", 0x08)
	e = roundIs(e, false, "1e1", 0x24)
	e = roundIs(e, false, "0.1", -1)
	e = roundIs(e, false, "32.0", -1)
	e = roundIs(e, false, "0.0", -1)
	e = roundIs(e, false, "1e-400", -1)
	e = roundIs(e, false, "1e400", -1)
	return e
}
