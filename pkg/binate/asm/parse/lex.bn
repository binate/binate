package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/std/strings"

// NewLexer returns a Lexer positioned at the start of src. `line` is the
// 1-based source line number that src begins on (the parser passes the
// current line so token positions stay accurate when a single source
// directive spans multiple Lex passes). Col is reset to 1.
func NewLexer(src *[]readonly char, line int) Lexer {
	var l Lexer
	l.Src = src
	l.Pos = 0
	l.Line = line
	l.Col = 1
	return l
}

// isAlpha reports whether c is an ASCII letter or underscore (the
// identifier-leading-character class for assembly identifiers).
func isAlpha(c char) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

// isDigit reports whether c is an ASCII decimal digit.
func isDigit(c char) bool {
	return c >= '0' && c <= '9'
}

// isHexDigit reports whether c is an ASCII hex digit (0-9, a-f, A-F).
func isHexDigit(c char) bool {
	return isDigit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

// isAlnum reports whether c is alphanumeric (identifier-continuation class).
func isAlnum(c char) bool {
	return isAlpha(c) || isDigit(c)
}

// isSpace reports whether c is a horizontal whitespace character (space
// or tab). Newlines are NOT considered space — they end a directive.
func isSpace(c char) bool {
	return c == ' ' || c == '\t'
}

// lexAdvance consumes one character and returns the updated lexer.
func lexAdvance(l Lexer) Lexer {
	l.Pos = l.Pos + 1
	l.Col = l.Col + 1
	return l
}

// lexSkipSpaces advances past spaces and tabs, returning the updated lexer.
func lexSkipSpaces(l Lexer) Lexer {
	for l.Pos < len(l.Src) && isSpace(l.Src[l.Pos]) {
		l.Pos = l.Pos + 1
		l.Col = l.Col + 1
	}
	return l
}

// hexVal returns the numeric value of an ASCII hex digit (0..15).
// Returns 0 for non-hex characters; callers should pre-validate with
// isHexDigit if that distinction matters.
func hexVal(c char) int {
	if c >= '0' && c <= '9' { return cast(int, c) - cast(int, '0') }
	if c >= 'a' && c <= 'f' { return cast(int, c) - cast(int, 'a') + 10 }
	if c >= 'A' && c <= 'F' { return cast(int, c) - cast(int, 'A') + 10 }
	return 0
}

// makeTok builds a Token of the given kind with the supplied text and
// source position. Used by LexNext for non-integer tokens.
func makeTok(kind int, text @[]char, line int, col int) Token {
	var t Token
	t.Kind = kind
	t.Text = text
	t.Line = line
	t.Col = col
	return t
}

// makeIntTok builds a TOK_INT token with the parsed integer value as
// well as the original text, for diagnostics that want to echo the
// literal exactly as written.
func makeIntTok(text @[]char, val int64, line int, col int) Token {
	var t Token
	t.Kind = TOK_INT
	t.Text = text
	t.Ival = val
	t.Line = line
	t.Col = col
	return t
}

// LexNext returns the next token and the updated lexer state.
func LexNext(l Lexer) (Lexer, Token) {
	l = lexSkipSpaces(l)

	if l.Pos >= len(l.Src) {
		return l, makeTok(TOK_EOF, "", l.Line, l.Col)
	}

	var c char = l.Src[l.Pos]
	var startCol int = l.Col

	// Line comment
	if c == '/' && l.Pos + 1 < len(l.Src) && l.Src[l.Pos + 1] == '/' {
		// Skip rest of line
		l.Pos = len(l.Src)
		return l, makeTok(TOK_EOF, "", l.Line, startCol)
	}

	// Identifier or keyword
	if isAlpha(c) {
		var start int = l.Pos
		for l.Pos < len(l.Src) && isAlnum(l.Src[l.Pos]) {
			l.Pos = l.Pos + 1
			l.Col = l.Col + 1
		}
		var text @[]char = buf.CopyStr(l.Src[start:l.Pos])
		return l, makeTok(TOK_IDENT, text, l.Line, startCol)
	}

	// Integer literal
	if isDigit(c) {
		var start int = l.Pos
		// int64 so a uint32/64-bit literal doesn't overflow a 32-bit host int
		// mid-accumulation (e.g. 0xDEADBEEF, which exceeds int32).
		var val int64 = 0
		if c == '0' && l.Pos + 1 < len(l.Src) {
			var next char = l.Src[l.Pos + 1]
			if next == 'x' || next == 'X' {
				// Hex
				l.Pos = l.Pos + 2
				l.Col = l.Col + 2
				for l.Pos < len(l.Src) && isHexDigit(l.Src[l.Pos]) {
					val = val * 16 + cast(int64, hexVal(l.Src[l.Pos]))
					l.Pos = l.Pos + 1
					l.Col = l.Col + 1
				}
				var text @[]char = buf.CopyStr(l.Src[start:l.Pos])
				return l, makeIntTok(text, val, l.Line, startCol)
			}
			if next == 'b' || next == 'B' {
				// Binary
				l.Pos = l.Pos + 2
				l.Col = l.Col + 2
				for l.Pos < len(l.Src) && (l.Src[l.Pos] == '0' || l.Src[l.Pos] == '1') {
					val = val * 2 + cast(int64, l.Src[l.Pos]) - cast(int64, '0')
					l.Pos = l.Pos + 1
					l.Col = l.Col + 1
				}
				var text @[]char = buf.CopyStr(l.Src[start:l.Pos])
				return l, makeIntTok(text, val, l.Line, startCol)
			}
			if next == 'o' || next == 'O' {
				// Octal
				l.Pos = l.Pos + 2
				l.Col = l.Col + 2
				for l.Pos < len(l.Src) && l.Src[l.Pos] >= '0' && l.Src[l.Pos] <= '7' {
					val = val * 8 + cast(int64, l.Src[l.Pos]) - cast(int64, '0')
					l.Pos = l.Pos + 1
					l.Col = l.Col + 1
				}
				var text @[]char = buf.CopyStr(l.Src[start:l.Pos])
				return l, makeIntTok(text, val, l.Line, startCol)
			}
		}
		// Decimal
		for l.Pos < len(l.Src) && isDigit(l.Src[l.Pos]) {
			val = val * 10 + cast(int64, l.Src[l.Pos]) - cast(int64, '0')
			l.Pos = l.Pos + 1
			l.Col = l.Col + 1
		}
		var text @[]char = buf.CopyStr(l.Src[start:l.Pos])
		return l, makeIntTok(text, val, l.Line, startCol)
	}

	// Character literal
	if c == '\'' {
		l = lexAdvance(l)
		if l.Pos >= len(l.Src) {
			return l, makeTok(TOK_ERROR, "", l.Line, startCol)
		}
		var ch char = l.Src[l.Pos]
		l = lexAdvance(l)
		// Handle escape sequences
		if ch == '\\' && l.Pos < len(l.Src) {
			var esc char = l.Src[l.Pos]
			l = lexAdvance(l)
			if esc == 'n' { ch = '\n' }
			if esc == 't' { ch = '\t' }
			if esc == '\\' { ch = '\\' }
			if esc == '\'' { ch = '\'' }
			if esc == '0' { ch = 0 }
		}
		if l.Pos < len(l.Src) && l.Src[l.Pos] == '\'' {
			l = lexAdvance(l)
		}
		var t Token
		t.Kind = TOK_CHAR
		t.Ival = cast(int64, ch)
		t.Line = l.Line
		t.Col = startCol
		return l, t
	}

	// String literal
	if c == '"' {
		l = lexAdvance(l)
		var sb @strings.Builder = strings.NewBuilder()
		for l.Pos < len(l.Src) && l.Src[l.Pos] != '"' {
			var sc char = l.Src[l.Pos]
			l = lexAdvance(l)
			if sc == '\\' && l.Pos < len(l.Src) {
				var esc char = l.Src[l.Pos]
				l = lexAdvance(l)
				if esc == 'n' { sc = '\n' }
				if esc == 't' { sc = '\t' }
				if esc == '\\' { sc = '\\' }
				if esc == '"' { sc = '"' }
				if esc == '0' { sc = 0 }
			}
			sb.WriteByte(sc)
		}
		if l.Pos < len(l.Src) {
			l = lexAdvance(l) // skip closing "
		}
		return l, makeTok(TOK_STRING, buf.CopyStr(sb.String()), l.Line, startCol)
	}

	// Two-character operators
	if c == '<' && l.Pos + 1 < len(l.Src) && l.Src[l.Pos + 1] == '<' {
		l = lexAdvance(l)
		l = lexAdvance(l)
		return l, makeTok(TOK_SHL, "", l.Line, startCol)
	}
	if c == '>' && l.Pos + 1 < len(l.Src) && l.Src[l.Pos + 1] == '>' {
		l = lexAdvance(l)
		l = lexAdvance(l)
		return l, makeTok(TOK_SHR, "", l.Line, startCol)
	}

	// Single-character tokens
	l = lexAdvance(l)
	if c == ',' { return l, makeTok(TOK_COMMA, "", l.Line, startCol) }
	if c == '[' { return l, makeTok(TOK_LBRACKET, "", l.Line, startCol) }
	if c == ']' { return l, makeTok(TOK_RBRACKET, "", l.Line, startCol) }
	if c == '#' { return l, makeTok(TOK_HASH, "", l.Line, startCol) }
	if c == '!' { return l, makeTok(TOK_BANG, "", l.Line, startCol) }
	if c == '.' { return l, makeTok(TOK_DOT, "", l.Line, startCol) }
	if c == ':' { return l, makeTok(TOK_COLON, "", l.Line, startCol) }
	if c == '@' { return l, makeTok(TOK_AT, "", l.Line, startCol) }
	if c == '=' { return l, makeTok(TOK_EQUALS, "", l.Line, startCol) }
	if c == '+' { return l, makeTok(TOK_PLUS, "", l.Line, startCol) }
	if c == '-' { return l, makeTok(TOK_MINUS, "", l.Line, startCol) }
	if c == '*' { return l, makeTok(TOK_STAR, "", l.Line, startCol) }
	if c == '/' { return l, makeTok(TOK_SLASH, "", l.Line, startCol) }
	if c == '%' { return l, makeTok(TOK_PERCENT, "", l.Line, startCol) }
	if c == '&' { return l, makeTok(TOK_AMP, "", l.Line, startCol) }
	if c == '|' { return l, makeTok(TOK_PIPE, "", l.Line, startCol) }
	if c == '^' { return l, makeTok(TOK_CARET, "", l.Line, startCol) }
	if c == '~' { return l, makeTok(TOK_TILDE, "", l.Line, startCol) }
	if c == '(' { return l, makeTok(TOK_LPAREN, "", l.Line, startCol) }
	if c == ')' { return l, makeTok(TOK_RPAREN, "", l.Line, startCol) }
	if c == '$' { return l, makeTok(TOK_DOLLAR, "", l.Line, startCol) }
	if c == '{' { return l, makeTok(TOK_LBRACE, "", l.Line, startCol) }
	if c == '}' { return l, makeTok(TOK_RBRACE, "", l.Line, startCol) }

	return l, makeTok(TOK_ERROR, "", l.Line, startCol)
}
