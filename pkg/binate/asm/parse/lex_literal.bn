package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/std/strings"

// Literal lexing: integers, floating-point literals, character literals and strings.
// A malformed literal is a TOK_ERROR token (whose text is the diagnostic), never a
// silently different value: an integer that does not fit 64 bits, a radix prefix
// with no digits, a hexadecimal float without its `p` exponent, an unknown or
// out-of-range escape, or an unterminated character / string literal.

// maxU64 is the largest unsigned 64-bit value, the integer literal limit.
const maxU64 uint64 = 0xFFFFFFFFFFFFFFFF

// digitVal returns c's value as a digit of radix (2, 8, 10 or 16), or -1.
func digitVal(c char, radix int) int {
	var v int = -1
	if isDigit(c) {
		v = cast(int, c) - cast(int, '0')
	} else if isHexDigit(c) {
		v = hexVal(c)
	}
	if v >= radix { return -1 }
	return v
}

// lexNumber lexes a numeric literal at l (whose current character is a digit).  An
// integer is `0x` / `0b` / `0o` prefixed hex / binary / octal, GNU-style octal for a
// leading zero followed by digits (`017` is 15; an 8 or 9 there is an error), or
// decimal; its value is the 64-bit pattern of the literal (so 0xFFFFFFFFFFFFFFFF is
// -1 as an int64), and an integer past 2^64 - 1 is an error rather than wrapping.  A
// decimal or hexadecimal integer part followed by a fraction or exponent continues as
// a floating-point literal (TOK_FLOAT; any size of integer part).
func lexNumber(l Lexer, startCol int) (Lexer, Token) {
	var start int = l.Pos
	var radix int = 10
	var src *[]readonly char = l.Src
	if src[l.Pos] == '0' && l.Pos + 1 < len(src) {
		var p char = src[l.Pos + 1]
		if p == 'x' || p == 'X' { radix = 16 }
		if p == 'b' || p == 'B' { radix = 2 }
		if p == 'o' || p == 'O' { radix = 8 }
		if radix != 10 {
			l = lexAdvance(lexAdvance(l))
			if radix == 16 && l.Pos + 1 < len(src) && src[l.Pos] == '.' && isHexDigit(src[l.Pos + 1]) {
				return lexHexFloat(l, start, startCol)
			}
			if l.Pos >= len(src) || digitVal(src[l.Pos], radix) < 0 {
				return l, makeTok(TOK_ERROR, "radix prefix with no digits", l.Line, startCol)
			}
		} else if isDigit(p) {
			radix = 8
			l = lexAdvance(l)
		}
	}
	var val uint64 = 0
	var r uint64 = cast(uint64, radix)
	var overflow bool = false
	for l.Pos < len(src) {
		var c char = src[l.Pos]
		if !isDigit(c) && !(radix == 16 && isHexDigit(c)) { break }
		var d int = digitVal(c, radix)
		if d < 0 {
			var msg *[]readonly char = "invalid digit in binary literal"
			if radix == 8 { msg = "invalid digit in octal literal" }
			return l, makeTok(TOK_ERROR, buf.CopyStr(msg), l.Line, startCol)
		}
		// Past 64 bits keep scanning: the digits may be a float's integer part.
		if overflow || val > (maxU64 - cast(uint64, d)) / r {
			overflow = true
		} else {
			val = val * r + cast(uint64, d)
		}
		l = lexAdvance(l)
	}
	// A decimal integer part (other than a GNU octal one) followed by '.' or an
	// exponent, or a hexadecimal one followed by '.' or a `p` exponent, continues as
	// a floating-point literal.
	if radix == 10 && l.Pos < len(src) && src[l.Pos] == '.' { return lexFloatFrac(l, start, startCol) }
	if radix == 10 && src[start] != '0' && expAt(src, l.Pos, 'e') {
		return lexFloatExp(l, start, startCol)
	}
	if radix == 16 && l.Pos < len(src) &&
			(src[l.Pos] == '.' || src[l.Pos] == 'p' || src[l.Pos] == 'P') {
		return lexHexFloat(l, start, startCol)
	}
	if overflow {
		return l, makeTok(TOK_ERROR, "integer literal does not fit 64 bits", l.Line, startCol)
	}
	var text @[]char = buf.CopyStr(src[start:l.Pos])
	return l, makeIntTok(text, cast(int64, val), l.Line, startCol)
}

// expAt reports whether src[i] starts an exponent with letter e (or its capital):
// the letter, an optional sign, and at least one decimal digit.  A letter without
// digits is not an exponent (and the literal ends before it).
func expAt(src *[]readonly char, i int, e char) bool {
	if i >= len(src) || (src[i] != e && src[i] != e - 32) { return false }
	var j int = i + 1
	if j < len(src) && (src[j] == '+' || src[j] == '-') { j = j + 1 }
	return j < len(src) && isDigit(src[j])
}

// lexFloatFrac finishes a decimal floating-point literal whose integer part (if any)
// is src[start:l.Pos] and whose '.' is at l.Pos: the '.', fraction digits, and an
// optional exponent.
func lexFloatFrac(l Lexer, start int, startCol int) (Lexer, Token) {
	l = lexAdvance(l)
	for l.Pos < len(l.Src) && isDigit(l.Src[l.Pos]) { l = lexAdvance(l) }
	if expAt(l.Src, l.Pos, 'e') { return lexFloatExp(l, start, startCol) }
	return l, makeTok(TOK_FLOAT, buf.CopyStr(l.Src[start:l.Pos]), l.Line, startCol)
}

// lexFloatExp finishes a floating-point literal at its exponent (expAt holds at
// l.Pos for the letter): the letter, an optional sign and the digits.
func lexFloatExp(l Lexer, start int, startCol int) (Lexer, Token) {
	l = lexAdvance(l)
	if l.Src[l.Pos] == '+' || l.Src[l.Pos] == '-' { l = lexAdvance(l) }
	for l.Pos < len(l.Src) && isDigit(l.Src[l.Pos]) { l = lexAdvance(l) }
	return l, makeTok(TOK_FLOAT, buf.CopyStr(l.Src[start:l.Pos]), l.Line, startCol)
}

// lexHexFloat finishes a hexadecimal floating-point literal (`0x1.8p3`) whose
// integer digits end at l.Pos: an optional '.' and hex fraction digits, then the
// required binary exponent `p` / `P`, optional sign and decimal digits.
func lexHexFloat(l Lexer, start int, startCol int) (Lexer, Token) {
	if l.Src[l.Pos] == '.' {
		l = lexAdvance(l)
		for l.Pos < len(l.Src) && isHexDigit(l.Src[l.Pos]) { l = lexAdvance(l) }
	}
	if !expAt(l.Src, l.Pos, 'p') {
		return l,
			makeTok(TOK_ERROR, "hexadecimal floating-point literal needs a p exponent", l.Line, startCol)
	}
	return lexFloatExp(l, start, startCol)
}

// lexEscape reads one escape sequence after a consumed backslash, returning its byte
// value, or -1 with a diagnostic: \b \f \n \r \t \\ \' \" (the C escapes), \NNN (one
// to three octal digits, at most 255), and \xH… (one or more hex digits, at most
// 0xFF — a longer value is an error, not truncated to its low byte).
func lexEscape(l Lexer) (Lexer, int, *[]readonly char) {
	var src *[]readonly char = l.Src
	if l.Pos >= len(src) { return l, -1, "unterminated escape sequence" }
	var e char = src[l.Pos]
	l = lexAdvance(l)
	if e == 'b' { return l, 8, "" }
	if e == 'f' { return l, 12, "" }
	if e == 'n' { return l, 10, "" }
	if e == 'r' { return l, 13, "" }
	if e == 't' { return l, 9, "" }
	if e == '\\' || e == '\'' || e == '"' { return l, cast(int, e), "" }
	if e >= '0' && e <= '7' {
		var v int = cast(int, e) - cast(int, '0')
		for n := 1; n < 3 && l.Pos < len(src) && src[l.Pos] >= '0' && src[l.Pos] <= '7'; n++ {
			v = v * 8 + cast(int, src[l.Pos]) - cast(int, '0')
			l = lexAdvance(l)
		}
		if v > 255 { return l, -1, "octal escape out of range (above \\377)" }
		return l, v, ""
	}
	if e == 'x' || e == 'X' {
		if l.Pos >= len(src) || !isHexDigit(src[l.Pos]) { return l, -1, "\\x escape with no hex digits" }
		var hv int = 0
		for l.Pos < len(src) && isHexDigit(src[l.Pos]) {
			hv = hv * 16 + hexVal(src[l.Pos])
			if hv > 255 { return l, -1, "hex escape out of range (above \\xff)" }
			l = lexAdvance(l)
		}
		return l, hv, ""
	}
	return l, -1, "unknown escape sequence"
}

// lexCharLit lexes a character literal at l (current character '\''): one character
// or one of the escapes charEscapeAgreed accepts, then the closing quote.
func lexCharLit(l Lexer, startCol int) (Lexer, Token) {
	var src *[]readonly char = l.Src
	l = lexAdvance(l)
	if l.Pos >= len(src) || src[l.Pos] == '\'' {
		return l, makeTok(TOK_ERROR, "empty or unterminated character literal", l.Line, startCol)
	}
	var v int = cast(int, src[l.Pos])
	l = lexAdvance(l)
	if v == cast(int, '\\') {
		// Only the escapes GNU as and clang read alike: clang takes `'\0'` as the
		// character '0' and rejects `'\101'` / `'\x41'`, all numeric escapes to GNU.
		if l.Pos >= len(src) || !charEscapeAgreed(src[l.Pos]) {
			return l,
				makeTok(TOK_ERROR, "character literal escape must be one of \\b \\f \\n \\r \\t \\\\ \\' \\\"",
						l.Line, startCol)
		}
		var msg *[]readonly char
		l, v, msg = lexEscape(l)
		if v < 0 { return l, makeTok(TOK_ERROR, buf.CopyStr(msg), l.Line, startCol) }
	}
	if l.Pos >= len(src) || src[l.Pos] != '\'' {
		return l, makeTok(TOK_ERROR, "unterminated character literal", l.Line, startCol)
	}
	l = lexAdvance(l)
	var t Token
	t.Kind = TOK_CHAR
	t.Ival = cast(int64, v)
	t.Line = l.Line
	t.Col = startCol
	return l, t
}

// charEscapeAgreed reports whether e, the character after a backslash, is an escape
// both GNU as and clang give the same value in a character literal.
func charEscapeAgreed(e char) bool {
	return e == 'b' || e == 'f' || e == 'n' || e == 'r' || e == 't' || e == '\\' || e == '\'' ||
			e == '"'
}

// lexStringLit lexes a string literal at l (current character '"') up to its closing
// quote, decoding escape sequences.
func lexStringLit(l Lexer, startCol int) (Lexer, Token) {
	var src *[]readonly char = l.Src
	l = lexAdvance(l)
	var sb @strings.Builder = strings.NewBuilder()
	for l.Pos < len(src) && src[l.Pos] != '"' {
		var c char = src[l.Pos]
		l = lexAdvance(l)
		if c == '\\' {
			var v int = 0
			var msg *[]readonly char
			l, v, msg = lexEscape(l)
			if v < 0 { return l, makeTok(TOK_ERROR, buf.CopyStr(msg), l.Line, startCol) }
			c = cast(char, v)
		}
		sb.WriteByte(c)
	}
	if l.Pos >= len(src) {
		return l, makeTok(TOK_ERROR, "unterminated string literal", l.Line, startCol)
	}
	l = lexAdvance(l) // the closing quote
	return l, makeTok(TOK_STRING, buf.CopyStr(sb.String()), l.Line, startCol)
}
