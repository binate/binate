package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Lexer tests for literals, comments and symbol names.  Every expected value is the
// one clang (`clang -c -target arm64-apple-macos11`) gives the same literal in a
// `.byte` / `.quad` / `.ascii` directive, except the `0o` octal prefix, which is this
// lexer's own spelling (clang rejects it).  Each table is a run of
// `e = lit…(e, …)` lines that accumulate failures via goldenFail.

// litHex renders s as uppercase hex pairs ("a\n" is "610A").
func litHex(s *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < len(s); i++ {
		stringutils.WriteHexByte(b, cast(int, s[i]))
	}
	return buf.CopyStr(b.String())
}

// litKindCode is the one-character code litSeq uses for a token kind.
func litKindCode(k int) char {
	if k == TOK_IDENT { return 'I' }
	if k == TOK_INT { return 'N' }
	if k == TOK_STRING { return 'S' }
	if k == TOK_CHAR { return 'C' }
	if k == TOK_ERROR { return 'E' }
	if k == TOK_SLASH { return '/' }
	if k == TOK_COLON { return ':' }
	if k == TOK_DOT { return '.' }
	if k == TOK_COMMA { return ',' }
	if k == TOK_PLUS { return '+' }
	if k == TOK_FLOAT { return 'F' }
	return '?'
}

// litSeq checks that src lexes to the token kinds coded by want (see litKindCode)
// and then TOK_EOF; lexing stops at the first TOK_ERROR, whose code ends the run.
func litSeq(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	var l Lexer = NewLexer(src, 1)
	var tok Token
	for n := 0; n < 32; n++ {
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF { break }
		b.WriteByte(litKindCode(tok.Kind))
		if tok.Kind == TOK_ERROR { break }
	}
	var got @[]char = buf.CopyStr(b.String())
	if !charsEqual(got, want) {
		return goldenFail(e, src, buf.Concat("lexed to token kinds ", got))
	}
	return e
}

// litInt checks that all of src lexes to one TOK_INT of value want whose text is src.
func litInt(e @[]char, src *[]readonly char, want int64) @[]char {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_INT { return goldenFail(e, src, "did not lex as an integer") }
	if tok.Ival != want { return goldenFail(e, src, "lexed to the wrong value") }
	if !charsEqual(tok.Text, src) { return goldenFail(e, src, "token text is not the literal") }
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF { return goldenFail(e, src, "did not consume the whole literal") }
	return e
}

// litNotInt checks that src does NOT lex as one complete integer literal (a single
// TOK_INT followed by TOK_EOF) — i.e. the malformed literal is not read as a number.
func litNotInt(e @[]char, src *[]readonly char) @[]char {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_INT { return e }
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF { return e }
	return goldenFail(e, src, "accepted as an integer literal")
}

// litStr checks that all of src lexes to one TOK_STRING whose bytes are wantHex.
func litStr(e @[]char, src *[]readonly char, wantHex *[]readonly char) @[]char {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_STRING { return goldenFail(e, src, "did not lex as a string") }
	var got @[]char = litHex(tok.Text)
	if !charsEqual(got, wantHex) { return goldenFail(e, src, buf.Concat("lexed to bytes ", got)) }
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF { return goldenFail(e, src, "did not consume the whole literal") }
	return e
}

// litChar checks that all of src lexes to one TOK_CHAR of value want.
func litChar(e @[]char, src *[]readonly char, want int64) @[]char {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_CHAR { return goldenFail(e, src, "did not lex as a character") }
	if tok.Ival != want { return goldenFail(e, src, "lexed to the wrong value") }
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF { return goldenFail(e, src, "did not consume the whole literal") }
	return e
}

// litIdent checks that src's first token is an identifier spelled want.
func litIdent(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT { return goldenFail(e, src, "did not start with an identifier") }
	if !charsEqual(tok.Text, want) {
		return goldenFail(e, src, buf.Concat("first identifier is ", tok.Text))
	}
	return e
}

// --- Integer literals ---

// A leading 0 followed by digits is octal (`017` is 15), while a bare 0 and
// literals starting 1-9 stay decimal.
func TestLexOctalLeadingZero() testing.TestResult {
	var e @[]char = ""
	e = litInt(e, "017", 15)
	e = litInt(e, "0777", 511)
	e = litInt(e, "0123", 83)
	e = litInt(e, "00", 0)
	e = litInt(e, "07", 7)
	e = litInt(e, "0", 0)
	e = litInt(e, "10", 10)
	e = litInt(e, "100", 100)
	return e
}

// The `0o` / `0O` prefix is octal too.
func TestLexOctalPrefix() testing.TestResult {
	var e @[]char = ""
	e = litInt(e, "0o17", 15)
	e = litInt(e, "0O17", 15)
	e = litInt(e, "0o0", 0)
	e = litInt(e, "0o777", 511)
	return e
}

// An 8 or 9 in a leading-zero octal literal is a TOK_ERROR, not a decimal reading
// (clang: "invalid octal number").
func TestLexOctalBadDigit() testing.TestResult {
	var e @[]char = ""
	e = litSeq(e, "08", "E")
	e = litSeq(e, "09", "E")
	e = litSeq(e, "0178", "E")
	e = litSeq(e, "0779", "E")
	var tok Token
	_, tok = LexNext(NewLexer("08", 1))
	if !charsEqual(tok.Text, "invalid digit in octal literal") {
		e = goldenFail(e, "08", "wrong diagnostic text")
	}
	return e
}

// The 64-bit boundary literals keep their bit pattern: 2^64-1 (clang: `.quad` of it is
// all ones) reads as -1, and 2^63-1 as itself.
func TestLexIntBoundaries() testing.TestResult {
	var e @[]char = ""
	e = litInt(e, "0xFFFFFFFFFFFFFFFF", -1)
	e = litInt(e, "18446744073709551615", -1)
	e = litInt(e, "0x7FFFFFFFFFFFFFFF", 9223372036854775807)
	e = litInt(e, "9223372036854775807", 9223372036854775807)
	return e
}

// A literal above 2^64-1 is not an integer (clang: "literal value out of range for
// directive"); it must not wrap to its low 64 bits.
func TestLexIntOverflowRejected() testing.TestResult {
	var e @[]char = ""
	e = litNotInt(e, "0x10000000000000000")
	e = litNotInt(e, "0x10000000000000001")
	e = litNotInt(e, "18446744073709551616")
	e = litNotInt(e, "02000000000000000000000")
	return e
}

// A radix prefix with no digits is not the integer 0 (clang: `0x`/`0xg` "invalid
// hexadecimal number"; `0b` is a directional-label reference; `0o` is not a literal).
func TestLexRadixPrefixNeedsDigits() testing.TestResult {
	var e @[]char = ""
	e = litNotInt(e, "0x")
	e = litNotInt(e, "0X")
	e = litNotInt(e, "0b")
	e = litNotInt(e, "0o")
	e = litNotInt(e, "0xg")
	return e
}

// --- Comments ---

// A `/* */` block comment is skipped wherever it appears and separates the tokens on
// either side of it (clang: `.byte 1 /**/ 2` is two tokens); a lone `/` is division.
func TestLexBlockComment() testing.TestResult {
	var e @[]char = ""
	e = litSeq(e, "add /* c */ x0", "II")
	e = litSeq(e, "/**/", "")
	e = litSeq(e, "/* a */ /* b */ 5", "N")
	e = litSeq(e, "/* a * / b */ 7", "N")
	e = litSeq(e, "/*/ */ 9", "N")
	e = litSeq(e, "1/**/2", "NN")
	e = litSeq(e, "8 / 2", "N/N")
	e = litSeq(e, "x // y /* z", "I")
	return e
}

// Tokens after a block comment keep accurate line and column positions.
func TestLexBlockCommentPosition() testing.TestResult {
	var tok Token
	_, tok = LexNext(NewLexer("/* c */x0", 1))
	if tok.Kind != TOK_IDENT || tok.Col != 8 { return fail("x0 after comment not at col 8") }
	var l Lexer = NewLexer("a/**/b", 1)
	l, tok = LexNext(l)
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || tok.Col != 6 { return fail("b after comment not at col 6") }
	_, tok = LexNext(NewLexer("/* c */ k", 9))
	if tok.Line != 9 || tok.Col != 9 { return fail("k after comment has the wrong position") }
	return ""
}

// A block comment with no closing `*/` on the line is a TOK_ERROR (clang:
// "unterminated /* comment"), including `/*/`, whose `/` cannot close it.
func TestLexBlockCommentUnterminated() testing.TestResult {
	var e @[]char = ""
	e = litSeq(e, "/* abc", "E")
	e = litSeq(e, "/*", "E")
	e = litSeq(e, "/*/", "E")
	e = litSeq(e, "x /* a *", "IE")
	e = litSeq(e, "5 /* a */ /* b", "NE")
	var tok Token
	_, tok = LexNext(NewLexer("/* abc", 1))
	if !charsEqual(tok.Text, "unterminated block comment") {
		e = goldenFail(e, "/* abc", "wrong diagnostic text")
	}
	return e
}

// --- Identifiers ---

// After its first character an identifier may contain '.' (the GNU symbol-name rule:
// clang accepts `memcpy.part.0:` as a label); a leading '.' is still its own token.
func TestLexDottedIdent() testing.TestResult {
	var e @[]char = ""
	e = litIdent(e, "memcpy.part.0", "memcpy.part.0")
	e = litIdent(e, "b.eq Ltgt", "b.eq")
	e = litIdent(e, "a..b", "a..b")
	e = litIdent(e, "_x.y", "_x.y")
	e = litIdent(e, "foo.:", "foo.")
	e = litSeq(e, "memcpy.part.0", "I")
	e = litSeq(e, "foo.:", "I:")
	e = litSeq(e, ".L1", ".I")
	e = litSeq(e, "sym.a+4", "I+N")
	e = litSeq(e, "x.y,z", "I,I")
	return e
}

// --- String and character literals ---

// The escapes the lexer supports give clang's bytes (`.ascii "a\n\t\\\"\0"` is
// 61 0A 09 5C 22 00), and comment markers inside a string are string bytes.
func TestLexStringEscapes() testing.TestResult {
	var e @[]char = ""
	e = litStr(e, "\"a\\n\\t\\\\\\\"\\0\"", "610A095C2200")
	e = litStr(e, "\"\"", "")
	e = litStr(e, "\"a//b/*c\"", "612F2F622F2A63")
	return e
}

// The remaining C escapes \r \b \f are their control bytes (clang: `.ascii "\r\b\f"`
// is 0D 08 0C), not a backslash with the letter dropped.
func TestLexStringCEscapes() testing.TestResult {
	var e @[]char = ""
	e = litStr(e, "\"\\r\"", "0D")
	e = litStr(e, "\"\\r\\b\\f\"", "0D080C")
	return e
}

// Octal (up to three digits) and \x hex escapes give the byte they name (clang:
// `.ascii "\101\x41\012\1234"` is 41 41 0A 53 34).
func TestLexStringNumericEscapes() testing.TestResult {
	var e @[]char = ""
	e = litStr(e, "\"\\101\"", "41")
	e = litStr(e, "\"\\x41\"", "41")
	e = litStr(e, "\"\\012\"", "0A")
	e = litStr(e, "\"\\101\\x41\\012\\1234\"", "41410A5334")
	return e
}

// A string with no closing quote on the line (clang: "expected string"), or with an
// unrecognized escape (clang: "invalid escape sequence"), is not a string token.
func TestLexStringMalformedRejected() testing.TestResult {
	var e @[]char = ""
	e = litSeq(e, "\"abc", "E")
	e = litSeq(e, "\"a\\\"", "E")
	e = litSeq(e, "\"a\\q\"", "E")
	return e
}

// Character literals and their supported escapes (clang: `.byte '\n', '\t', '\\',
// '\''` is 0A 09 5C 27).
func TestLexCharEscapes() testing.TestResult {
	var e @[]char = ""
	e = litChar(e, "'a'", 0x61)
	e = litChar(e, "'\\n'", 0x0A)
	e = litChar(e, "'\\t'", 0x09)
	e = litChar(e, "'\\\\'", 0x5C)
	e = litChar(e, "'\\''", 0x27)
	return e
}

// The \r \b \f character escapes are their control bytes (clang: `.byte '\r', '\b',
// '\f'` is 0D 08 0C), not a backslash.
func TestLexCharCEscapes() testing.TestResult {
	var e @[]char = ""
	e = litChar(e, "'\\r'", 0x0D)
	e = litChar(e, "'\\b'", 0x08)
	e = litChar(e, "'\\f'", 0x0C)
	return e
}

// A character literal takes only the escapes GNU as and clang agree on (`'\"'` is
// 0x22 to both); a numeric escape is an error, since clang reads `'\0'` as the
// character '0' (0x30) and rejects `'\101'` / `'\x41'` where GNU gives 0 / 0x41 —
// as is an escape neither defines, like `'\a'`.
func TestLexCharEscapesOnlyAgreed() testing.TestResult {
	var e @[]char = ""
	e = litChar(e, "'\\\"'", 0x22)
	e = litSeq(e, "'\\0'", "E")
	e = litSeq(e, "'\\101'", "E")
	e = litSeq(e, "'\\x41'", "E")
	e = litSeq(e, "'\\a'", "E")
	return e
}
