package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// NewParser returns a Parser bound to the given Assembler. The architecture
// is set to ARCH_UNKNOWN until a `.arch` directive (or an explicit setter)
// configures the per-arch instruction parser. filename is copied for use
// in diagnostics — the input slice does not need to outlive the Parser.
// The constant table is preallocated to 256 entries (grown on demand by
// the constant-definition path).
func NewParser(a @asm.Assembler, filename *[]readonly char) @Parser {
	var p @Parser = make(Parser)
	p.Asm = a
	p.Arch = ARCH_UNKNOWN
	p.FileName = buf.CopyStr(filename)
	p.LineNum = 0
	p.HasError = false
	p.ConstNames = make_slice(@[]char, 256)
	p.ConstVals = make_slice(int64, 256)
	p.NumConsts = 0
	return p
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// setErr records an error on the parser with file:line prefix.
// Only the first error is kept.
func setErr(p @Parser, msg *[]readonly char) {
	if !p.HasError {
		p.HasError = true
		// Format: filename:line: error: msg
		var b @strings.Builder = strings.NewBuilder()
		b.Write(p.FileName)
		b.WriteByte(':')
		stringutils.WriteInt(b, p.LineNum)
		b.Write(": error: ")
		b.Write(msg)
		p.ErrorMsg = buf.CopyStr(b.String())
	}
}

// lookupConst searches p.ConstNames for a constant by name.
// Returns (value, true) if found, (0, false) otherwise.
func lookupConst(p @Parser, name *[]readonly char) (int64, bool) {
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstNames[i], name) {
			return p.ConstVals[i], true
		}
	}
	return 0, false
}

// defineConst adds a named constant to the parser's constant table.
// Errors on redefinition. The name is copied.
func defineConst(p @Parser, name *[]readonly char, val int64) {
	// Check for redefinition
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstNames[i], name) {
			setErr(p, "constant redefinition")
			return
		}
	}
	if p.NumConsts >= len(p.ConstNames) {
		setErr(p, "too many constants")
		return
	}
	p.ConstNames[p.NumConsts] = buf.CopyStr(name)
	p.ConstVals[p.NumConsts] = val
	p.NumConsts = p.NumConsts + 1
}

// Resolve a local label name by prepending the last global label
func resolveLabel(p @Parser, name *[]readonly char) @[]char {
	if len(name) > 0 && name[0] == '.' {
		// Local label — prepend last global
		if len(p.LastGlobal) == 0 {
			setErr(p, "local label before any global label")
			return buf.CopyStr(name)
		}
		var b @strings.Builder = strings.NewBuilder()
		b.Write(p.LastGlobal)
		b.Write(name)
		return buf.CopyStr(b.String())
	}
	return buf.CopyStr(name)
}

// --- Line parsing ---

// ParseLine parses a single line of assembly text.  An error the assembler or an
// encoder raised while emitting the line (an operand with no encoding) is reported
// as this line's parse error, so it carries the file:line position and message.
func (p @Parser) ParseLine(line *[]readonly char) {
	var clean @[]char = prepareLine(p, line)
	parseLine(p, clean)
	if !p.HasError && p.Asm.HasError {
		setErr(p, p.Asm.ErrorMsg)
	}
}

// parseDotDirective parses a directive whose leading '.' is dot (already read from
// l): the directive name must follow it immediately (`.uint8`, not `. uint8`).
func parseDotDirective(p @Parser, l Lexer, dot Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || tok.Col != dot.Col + 1 {
		setErr(p, "expected a directive name immediately after '.'")
		return
	}
	parseDirective(p, l, tok)
}

// parseLine parses one line (ParseLine's body, before the assembler-error check).
func parseLine(p @Parser, line *[]readonly char) {
	p.LineNum = p.LineNum + 1
	var lexErr @[]char = firstLexError(line, p.LineNum)
	if len(lexErr) > 0 {
		setErr(p, lexErr)
		return
	}

	var l Lexer = NewLexer(line, p.LineNum)
	var tok Token
	l, tok = LexNext(l)

	// Skip empty lines and comment-only lines
	if tok.Kind == TOK_EOF {
		return
	}

	// Directive: starts with .
	if tok.Kind == TOK_DOT {
		parseDotDirective(p, l, tok)
		return
	}

	// Label or constant or instruction
	if tok.Kind == TOK_IDENT {
		// Peek at next token
		var l2 Lexer = l
		var tok2 Token
		l2, tok2 = LexNext(l2)

		// label:
		if tok2.Kind == TOK_COLON {
			var name @[]char = resolveLabel(p, tok.Text)
			p.Asm.DefineLabel(name)
			// Track last global label (for local label scoping)
			if len(tok.Text) > 0 && tok.Text[0] != '.' {
				p.LastGlobal = buf.CopyStr(tok.Text)
			}
			// Continue parsing rest of line (may have more labels, then an
			// instruction or directive, after this label)
			l, tok = LexNext(l2)
			for tok.Kind == TOK_IDENT {
				var l3 Lexer = l
				var tok3 Token
				l3, tok3 = LexNext(l3)
				if tok3.Kind != TOK_COLON { break }
				p.Asm.DefineLabel(resolveLabel(p, tok.Text))
				p.LastGlobal = buf.CopyStr(tok.Text)
				l, tok = LexNext(l3)
			}
			if tok.Kind == TOK_EOF {
				return
			}
			// Fall through to instruction parsing
			if tok.Kind == TOK_DOT {
				parseDotDirective(p, l, tok)
				return
			}
			parseInstruction(p, l, tok)
			return
		}

		// name = expr (constant definition)
		if tok2.Kind == TOK_EQUALS {
			// Own the name: LexNext below reassigns `tok`, which RefDecs this
			// IDENT's freshly-CopyStr'd Text (tok is its sole owner) to zero.
			// A raw borrow of tok.Text would dangle by the defineConst read.
			var name @[]char = buf.CopyStr(tok.Text)
			l, tok = LexNext(l2) // l2 is past =, get the expression token
			var result ExprResult
			l, tok, result = ParseExpr(l, tok)
			if !result.Ok {
				setErr(p, exprErr(result, "invalid constant expression"))
				return
			}
			if tok.Kind != TOK_EOF {
				setErr(p, "unexpected token after the constant's value")
				return
			}
			defineConst(p, name, result.Val)
			return
		}

		// Otherwise it's an instruction
		parseInstruction(p, l, tok)
		return
	}

	// Local label: .name:
	if tok.Kind == TOK_DOT {
		// Already handled above (directive case). This shouldn't be reached.
		setErr(p, "unexpected '.'")
		return
	}

	setErr(p, "unexpected token")
}

// --- Instruction parsing (dispatches to per-arch) ---

// parseInstruction dispatches to the architecture-specific instruction parser.
func parseInstruction(p @Parser, l Lexer, mnemTok Token) {
	if p.Arch == ARCH_AARCH64 {
		parseAarch64Instruction(p, l, mnemTok)
		return
	}
	if p.Arch == ARCH_ARM32 {
		parseArm32Instruction(p, l, mnemTok)
		return
	}
	if p.Arch == ARCH_X64 {
		parseX64Instruction(p, l, mnemTok)
		return
	}
	setErr(p, "no architecture set (missing .arch directive)")
}
