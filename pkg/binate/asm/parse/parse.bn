package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// NewParser returns a Parser bound to the given Assembler. The architecture
// is set to ARCH_UNKNOWN until a `.arch` directive (or an explicit setter)
// configures the per-arch instruction parser. filename is copied for use
// in diagnostics — the input slice does not need to outlive the Parser.
// The constant table starts with room for 16 entries and grows as constants are
// defined.
func NewParser(a @asm.Assembler, filename *[]readonly char) @Parser {
	var p @Parser = make(Parser)
	p.Asm = a
	p.Arch = ARCH_UNKNOWN
	p.FileName = buf.CopyStr(filename)
	p.LineNum = 0
	p.HasError = false
	p.ConstNames = make_slice(@[]char, 16)
	p.ConstVals = make_slice(int64, 16)
	p.NumConsts = 0
	p.NumLabelNums = make_slice(@[]char, 16)
	p.NumLabelCounts = make_slice(int, 16)
	p.FwdRefNums = make_slice(@[]char, 16)
	p.FwdRefInstances = make_slice(int, 16)
	p.FwdRefLines = make_slice(int, 16)
	return p
}

// charsEqual returns true if raw slices a and b have identical contents.
func charsEqual(a *[]readonly char, b *[]readonly char) bool {
	if len(a) != len(b) { return false }
	for i := 0; i < len(a); i++ {
		if a[i] != b[i] { return false }
	}
	return true
}

// setErr records an error on the parser with file:line prefix.
// Only the first error is kept.
func setErr(p @Parser, msg *[]readonly char) {
	if !p.HasError {
		p.HasError = true
		// Format: filename:line: error: msg
		var b @strings.Builder = strings.NewBuilder()
		b.Write(p.FileName)
		b.WriteByte(':')
		stringutils.WriteInt(b, p.LineNum)
		b.Write(": error: ")
		b.Write(msg)
		p.ErrorMsg = buf.CopyStr(b.String())
	}
}

// quotedName returns name in single quotes followed by rest, for a diagnostic about name.
func quotedName(name *[]readonly char, rest *[]readonly char) @[]char {
	return buf.Concat(buf.Concat(buf.Concat("'", name), "'"), rest)
}

// constIndex returns the index of the constant named name in p's table, or -1.
func constIndex(p @Parser, name *[]readonly char) int {
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstNames[i], name) { return i }
	}
	return -1
}

// lookupConst searches p.ConstNames for a constant by name.
// Returns (value, true) if found, (0, false) otherwise.
func lookupConst(p @Parser, name *[]readonly char) (int64, bool) {
	var i int = constIndex(p, name)
	if i < 0 { return 0, false }
	return p.ConstVals[i], true
}

// defineConst gives the constant name the value val: a new constant, or a new value
// for an existing one (each use sees the value defined last before it, as in clang).
// A name already defined as a label, declared global or weak, or used as a symbol on an
// earlier line cannot become a constant.  The name is copied.
func defineConst(p @Parser, name *[]readonly char, val int64) {
	var i int = constIndex(p, name)
	if i >= 0 {
		p.ConstVals[i] = val
		return
	}
	var si int = p.Asm.LookupSymbol(name)
	if si >= 0 && p.Asm.Symbols[si].Section >= 0 {
		setErr(p, quotedName(name, " is a label; it cannot be redefined as a constant"))
		return
	}
	if si >= 0 {
		// TODO: clang makes such a name a global / weak absolute symbol; the object
		// writers do not emit absolute symbols yet (plan-aa64-asm-symbols.md, 3b).
		setErr(p, quotedName(name, " is global or weak; a global or weak constant is not supported"))
		return
	}
	if usedAsSymbol(p, name) {
		setErr(p,
				quotedName(name, " was used as a symbol earlier; a constant must be defined before use"))
		return
	}
	if p.NumConsts >= len(p.ConstNames) {
		var n int = 2 * len(p.ConstNames)
		var names @[]@[]char = make_slice(@[]char, n)
		var vals @[]int64 = make_slice(int64, n)
		for j := 0; j < p.NumConsts; j++ {
			names[j] = p.ConstNames[j]
			vals[j] = p.ConstVals[j]
		}
		p.ConstNames = names
		p.ConstVals = vals
	}
	p.ConstNames[p.NumConsts] = buf.CopyStr(name)
	p.ConstVals[p.NumConsts] = val
	p.NumConsts = p.NumConsts + 1
}

// dropConst removes the constant named name, if any, keeping the others in order: a label
// of that name has just been defined, which the name means from now on (as in clang, where
// `N = 1` then `N:` makes N a label).
func dropConst(p @Parser, name *[]readonly char) {
	var i int = constIndex(p, name)
	if i < 0 { return }
	for j := i + 1; j < p.NumConsts; j++ {
		p.ConstNames[j - 1] = p.ConstNames[j]
		p.ConstVals[j - 1] = p.ConstVals[j]
	}
	p.NumConsts = p.NumConsts - 1
	p.ConstNames[p.NumConsts] = ""
}

// usedAsSymbol reports whether an earlier line referred to name as a symbol: a fixup in
// any section names it.
func usedAsSymbol(p @Parser, name *[]readonly char) bool {
	var a @asm.Assembler = p.Asm
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		for fi := 0; fi < sec.NumFixups; fi++ {
			if charsEqual(sec.Fixups[fi].Label, name) { return true }
		}
	}
	return false
}

// resolveLabel returns the symbol a name in an operand refers to: the name itself, or for
// a numeric local label reference (`1b`, `2f` — the only names that start with a digit)
// the label instance it means.  A constant's name is no symbol: that is an error here,
// where the operand takes only a symbol.
func resolveLabel(p @Parser, name *[]readonly char) @[]char {
	if len(name) > 0 && isDigit(name[0]) { return resolveNumLabelRef(p, name) }
	if constIndex(p, name) >= 0 { setErr(p, quotedName(name, " is a constant, not a symbol")) }
	return buf.CopyStr(name)
}

// --- Line parsing ---

// ParseLine parses a single line of assembly text.  An error the assembler or an
// encoder raised while emitting the line (an operand with no encoding) is reported
// as this line's parse error, so it carries the file:line position and message.
func (p @Parser) ParseLine(line *[]readonly char) {
	var clean @[]char = prepareLine(p, line)
	parseLine(p, clean)
	if !p.HasError && p.Asm.HasError {
		setErr(p, p.Asm.ErrorMsg)
	}
}

// parseLine parses one line (ParseLine's body, before the assembler-error check): any
// labels — `name:` or a numeric `N:` — then a directive (a `.` name), a constant
// definition (`name = expr`) or an instruction.
func parseLine(p @Parser, line *[]readonly char) {
	p.LineNum = p.LineNum + 1
	var lexErr @[]char = firstLexError(line, p.LineNum)
	if len(lexErr) > 0 {
		setErr(p, lexErr)
		return
	}
	if p.SplitLine {
		setErr(p,
				"a comment that spans lines splits a statement: text before its /* and "
						"after its */ (clang joins them into one statement)")
		return
	}

	var l Lexer = NewLexer(line, p.LineNum)
	var tok Token
	l, tok = LexNext(l)
	// An empty or comment-only line.
	if tok.Kind == TOK_EOF { return }

	var labeled bool = false
	for tok.Kind == TOK_IDENT || tok.Kind == TOK_INT {
		var l2 Lexer = l
		var tok2 Token
		l2, tok2 = LexNext(l2)
		if tok2.Kind != TOK_COLON { break }
		defineLineLabel(p, tok)
		if p.HasError { return }
		labeled = true
		l, tok = LexNext(l2)
	}
	if tok.Kind == TOK_EOF {
		// Only labels: a comment left open here interrupts no statement (clang's
		// `lbl: /* ... */ nop` is `lbl: nop`, as these two lines are).
		if labeled { p.CommentSplit = false }
		return
	}
	if tok.Kind == TOK_DOT {
		// A '.' that starts no name (`. uint8`, a lone `.`) names no directive.
		setErr(p, "expected a directive name immediately after '.'")
		return
	}
	if tok.Kind != TOK_IDENT {
		setErr(p, "unexpected token")
		return
	}
	var l2 Lexer = l
	var tok2 Token
	l2, tok2 = LexNext(l2)
	if tok2.Kind == TOK_EQUALS {
		if isDigit(tok.Text[0]) {
			setErr(p, "a numeric local label reference is not a constant name")
			return
		}
		parseConstDef(p, l2, tok)
		return
	}
	if tok.Text[0] == '.' {
		parseDirective(p, l, tok.Text[1:])
		return
	}
	parseInstruction(p, l, tok)
}

// defineLineLabel defines the label tok names at the current location: a symbol, or for
// an integer (`1:`, `0x1:`) the next instance of that numeric local label.  A numeric
// reference (`1b`) is no label name.
func defineLineLabel(p @Parser, tok Token) {
	if tok.Kind == TOK_INT {
		// (clang takes no label number of 2^63 or more.)
		if tok.Ival < 0 {
			setErr(p, "numeric local label out of range")
			return
		}
		defineNumLabel(p, tok.Ival)
		return
	}
	if isDigit(tok.Text[0]) {
		setErr(p, "a numeric local label reference is not a label name")
		return
	}
	p.Asm.DefineLabel(buf.CopyStr(tok.Text))
	if !p.Asm.HasError { dropConst(p, tok.Text) }
}

// parseConstDef parses `name = expr` (nameTok the name; l positioned after the '=').
func parseConstDef(p @Parser, l Lexer, nameTok Token) {
	var tok Token
	l, tok = LexNext(l)
	var result ExprResult
	l, tok, result = ParseExpr(p, l, tok)
	if !result.Ok {
		setErr(p, exprErr(result, "invalid constant expression"))
		return
	}
	if tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the constant's value")
		return
	}
	defineConst(p, nameTok.Text, result.Val)
}

// --- Instruction parsing (dispatches to per-arch) ---

// parseInstruction dispatches to the architecture-specific instruction parser.
func parseInstruction(p @Parser, l Lexer, mnemTok Token) {
	if p.Arch == ARCH_AARCH64 {
		parseAarch64Instruction(p, l, mnemTok)
		return
	}
	if p.Arch == ARCH_ARM32 {
		parseArm32Instruction(p, l, mnemTok)
		return
	}
	if p.Arch == ARCH_X64 {
		parseX64Instruction(p, l, mnemTok)
		return
	}
	setErr(p, "no architecture set (missing .arch directive)")
}
