package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// References to an alias (`A = lbl + 8`), as clang makes them.  A use of an alias outside a
// constant's definition stands for the alias itself (nameValue): its fixup names the alias,
// which Finish lists as a symbol at its location (listConstants), and the object writers
// treat it as any label there — a listed symbol the relocation names (on ELF a local one is
// made section-relative), a temporary moved to what contains it, or a reference resolved in
// place where its distance is fixed.  Two cases make a use name something else:
//   - an alias redefined after uses: those uses keep the definition they saw, through a
//     hidden alias of it (hideAliasUses), as clang's earlier uses relocate against the old
//     value — as do the aliases defined as it alone (`z = y`), with the `.size` it had;
//   - an alias of a symbol not defined here, which is never listed: its uses name that symbol
//     plus the alias's addend (foldUnlistedAliasUses), as clang's ELF writer makes them
//     (clang's Mach-O writer instead lists such an alias as undefined, which no link
//     resolves).
// An alias defined as another alias alone (`z = y`) keeps that one as its referent
// (Parser.ConstVia), whose `.size` it takes when it has none of its own (aliasSize).

// usesName reports whether a fixup (as its label or its subtracted one) or a pending
// literal-pool entry names name.
func usesName(p @Parser, name *[]readonly char) bool {
	if poolNamesSymbol(p, name) { return true }
	var a @asm.Assembler = p.Asm
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		for fi := 0; fi < sec.NumFixups; fi++ {
			var f asm.Fixup = sec.Fixups[fi]
			if charsEqual(f.Label, name) || charsEqual(f.Sub, name) { return true }
		}
	}
	return false
}

// renameUses makes every fixup and pending literal-pool entry naming from name to instead,
// with delta added to its addend (subtracted for a fixup's subtracted label).
func renameUses(p @Parser, from *[]readonly char, to *[]readonly char, delta int64) {
	for i := 0; i < p.NumPool; i++ {
		if p.PoolOffs[i] < 0 && charsEqual(p.PoolSyms[i], from) {
			p.PoolSyms[i] = buf.CopyStr(to)
			p.PoolVals[i] = p.PoolVals[i] + delta
		}
	}
	var a @asm.Assembler = p.Asm
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		for fi := 0; fi < sec.NumFixups; fi++ {
			if charsEqual(sec.Fixups[fi].Label, from) {
				sec.Fixups[fi].Label = buf.CopyStr(to)
				sec.Fixups[fi].Addend = sec.Fixups[fi].Addend + delta
			}
			if charsEqual(sec.Fixups[fi].Sub, from) {
				sec.Fixups[fi].Sub = buf.CopyStr(to)
				sec.Fixups[fi].Addend = sec.Fixups[fi].Addend - delta
			}
		}
	}
}

// hideAliasUses gives the uses so far of constant i, an alias about to be redefined, a hidden
// alias of its current definition — a temporary on every object format (a GeneratedLabelName,
// named by the definition's line, so the same on both passes) — so that they keep the
// location they referred to; the aliases defined as it alone refer to the hidden one, which
// takes its referent and the `.size` the name has now (clang's earlier symbol keeps it).
func hideAliasUses(p @Parser, i int) {
	var name @[]char = p.ConstNames[i]
	if !usesName(p, name) && !viaNames(p, name) { return }
	var hidden @[]char = asm.GeneratedLabelName(name, p.ConstLines[i])
	var sym @[]char = p.ConstSyms[i]
	var via @[]char = p.ConstVia[i]
	var line int = p.LineNum
	p.LineNum = p.ConstLines[i]
	defineConst(p, hidden, p.ConstVals[i], sym)
	p.LineNum = line
	if p.HasError { return }
	var hi int = constIndex(p, hidden)
	p.ConstUsed[hi] = true
	p.ConstVia[hi] = via
	size, sized := recordedSize(p, name)
	if sized { recordSymAttr(p, hidden, size, true) }
	for j := 0; j < p.NumConsts; j++ {
		if charsEqual(p.ConstVia[j], name) { p.ConstVia[j] = buf.CopyStr(hidden) }
	}
	renameUses(p, name, hidden, 0)
}

// viaNames reports whether a constant is defined as the alias name alone (Parser.ConstVia).
func viaNames(p @Parser, name *[]readonly char) bool {
	for j := 0; j < p.NumConsts; j++ {
		if charsEqual(p.ConstVia[j], name) { return true }
	}
	return false
}

// aliasTarget returns the symbol the alias name is defined as (its target), or name itself
// when it names no alias.
func aliasTarget(p @Parser, name *[]readonly char) @[]char {
	var i int = constIndex(p, name)
	if i < 0 || len(p.ConstSyms[i]) == 0 { return buf.CopyStr(name) }
	return p.ConstSyms[i]
}

// foldUnlistedAliasUses makes the uses of constant i, an alias of a symbol not defined here
// (never listed), name that symbol plus the alias's addend.
func foldUnlistedAliasUses(p @Parser, i int) {
	renameUses(p, p.ConstNames[i], p.ConstSyms[i], p.ConstVals[i])
}

// aliasSize returns the size alias i takes when it has no `.size` of its own: the nearest
// alias up its chain of plain referents (Parser.ConstVia: `z = y`, `y = x`) that has one, else
// base, its target's size — the chain clang's ELF writer follows for st_size.
func aliasSize(p @Parser, i int, base int64) int64 {
	var via @[]char = p.ConstVia[i]
	for steps := 0; len(via) > 0 && steps < p.NumConsts; steps++ {
		size, ok := recordedSize(p, via)
		if ok { return size }
		var vi int = constIndex(p, via)
		if vi < 0 { break }
		via = p.ConstVia[vi]
	}
	return base
}

// recordedSize returns the value of the last `.size` given name, and whether one was.
func recordedSize(p @Parser, name *[]readonly char) (int64, bool) {
	var size int64 = 0
	var ok bool = false
	for i := 0; i < p.NumSymAttrs; i++ {
		if p.SymAttrIsSize[i] && charsEqual(p.SymAttrNames[i], name) {
			size = p.SymAttrValues[i]
			ok = true
		}
	}
	return size, ok
}

// soleAliasName returns the alias a constant's definition names alone — its expression one
// alias's name, in any number of parentheses (`(y)`, `((y))`), starting at tok (l just after
// it) and ending where end is — or "" for any other definition.
func soleAliasName(p @Parser, tok Token, l Lexer, end Lexer) @[]char {
	var t Token = tok
	var k Lexer = l
	var parens int = 0
	for t.Kind == TOK_LPAREN {
		parens = parens + 1
		k, t = LexNext(k)
	}
	if t.Kind != TOK_IDENT { return "" }
	var i int = constIndex(p, t.Text)
	if i < 0 || len(p.ConstSyms[i]) == 0 { return "" }
	var name @[]char = buf.CopyStr(t.Text)
	for n := 0; n < parens; n++ {
		k, t = LexNext(k)
		if t.Kind != TOK_RPAREN { return "" }
	}
	k, _ = LexNext(k)
	if k.Pos != end.Pos { return "" }
	return name
}
