package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Global and weak aliases (`.global A` / `.weak A` / `.global_c A` with `A = sym + k`), as
// clang assembles them: listed with that binding at the alias's location, each use going
// through the alias's own symbol (a relocation against it on ELF, so that another object's
// definition can override a weak one), while a constant defined from one takes its target.
// (labelsCase / labelsReject / labelsSource are in aarch64_golden_labels_test.bn,
// aliasReloc in parse_alias_test.bn, listedSym in parse_const_list_test.bn, x64SrcReloc in
// x64_target_test.bn, plContains in parse_line_test.bn.)

// boundHeader defines lbl at 4 and l2 at 8, after one nop each.
var boundHeader *[]readonly char = "nop\nlbl: nop\nl2: nop\n"

// boundReloc checks that line, after boundHeader, leaves exactly one relocation, against
// sym with addend.
func boundReloc(e @[]char, line *[]readonly char, sym *[]readonly char, addend int) @[]char {
	return aliasReloc(e, buf.Concat(boundHeader, line), sym, addend)
}

// A use of a global or weak alias — a branch, a page, a :lo12:, with an addend of its own,
// on AArch64 and x86-64 — relocates against the alias, declared before or after its
// definition (but after any use of that definition), redefined before its first use,
// defined as `.`, or a number before, and declared again after a use; a constant defined
// from it takes its target, and its uses resolve here.  `.local` changes nothing.
func TestBoundAliasUses() testing.TestResult {
	var e @[]char = ""
	e = boundReloc(e, ".global A\nA = lbl\nbl A", "A", 0)
	e = boundReloc(e, ".weak W\nW = lbl + 4\nbl W+8", "W", 8)
	e = boundReloc(e, ".global A\nA = lbl\nadrp x0, A", "A", 0)
	e = boundReloc(e, ".global A\nA = lbl\nadd x0, x0, :lo12:A+4", "A", 4)
	e = boundReloc(e, "A = lbl\n.global A\nb A", "A", 0)
	e = boundReloc(e, ".global_c A\nA = lbl\nbl A", "A", 0)
	e = boundReloc(e, ".global A\nA = lbl\nA = l2\nbl A", "A", 0)
	e = boundReloc(e, ".global G\nG = 5\nG = lbl\nbl G", "G", 0)
	e = boundReloc(e, ".global A\nA = .\nbl A", "A", 0)
	e = boundReloc(e, ".global A\nA = lbl\nbl A\n.global A\n.weak A", "A", 0)
	e = boundReloc(e, "A = lbl\nb A\nA = l2\n.global A\nb A", "A", 0)
	e = x64SrcReloc(e, "f: nop\n.global A\nA = f\ncall A", "A", 0)
	e = x64SrcReloc(e, "f: nop\n.weak W\nW = f + 1\njmp W+2", "W", 2)
	e = labelsCase(e, buf.Concat(boundHeader, ".global A\nA = lbl\nC = A\nb C"),
			"D503201F D503201F D503201F 17FFFFFE ")
	e = labelsCase(e, buf.Concat(boundHeader, "A = lbl\n.local A\nb A"),
			"D503201F D503201F D503201F 17FFFFFE ")
	e = labelsCase(e, "lbl: nop\nA = lbl\nA = 7\n.global A\n.uint32 A", "D503201F 00000007 ")
	return e
}

// boundListed checks that src lists name with binding bind in section 0 at offset, an alt
// entry when alt.
func boundListed(e @[]char, src *[]readonly char, name *[]readonly char, bind int, offset uint,
		alt bool) @[]char {
	sym, err := listedSym(src, name)
	if len(err) > 0 { return goldenFail(e, src, err) }
	if sym.Abs || sym.Section != 0 || sym.Offset != offset || sym.AltEntry != alt ||
			sym.Binding != bind {
		return goldenFail(e, src, "not that binding, location or alt entry")
	}
	return e
}

// A global or weak alias is listed with its binding at its last definition's location — an
// alt entry unless exactly an atom-starting symbol, as a local one is, and always when weak
// (on Mach-O a weak symbol starting an atom would take the atom's code with it when a
// strong definition replaces it).  `.global_c` gives it the C prefix.
func TestBoundAliasListed() testing.TestResult {
	var e @[]char = ""
	e = boundListed(e, buf.Concat(boundHeader, ".global A\nA = lbl"), "A", asm.BIND_GLOBAL, 4, false)
	e = boundListed(e, buf.Concat(boundHeader, ".weak W\nW = lbl + 4"), "W", asm.BIND_WEAK, 8, true)
	e = boundListed(e, buf.Concat(boundHeader, ".weak W\nW = lbl"), "W", asm.BIND_WEAK, 4, true)
	e = boundListed(e, buf.Concat(boundHeader, "A = lbl\n.global A\nA = l2"), "A", asm.BIND_GLOBAL, 8,
			false)
	sym, err := listedSym(buf.Concat(boundHeader, ".global_c A\nA = lbl"), "A")
	if len(err) > 0 || !sym.CPrefix || sym.Binding != asm.BIND_GLOBAL {
		e = goldenFail(e, ".global_c A", "not a global alias with the C prefix")
	}
	return e
}

// boundReject checks that src is rejected with a diagnostic containing want.
func boundReject(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if !p.HasError { return goldenFail(e, src, "accepted") }
	if !plContains(p.ErrorMsg, want) {
		return goldenFail(e, src, buf.Concat("wrong diagnostic: ", p.ErrorMsg))
	}
	return e
}

// manyConsts returns definitions of C0 .. C(n-1), enough to grow the constant table.
func manyConsts(n int) @[]char {
	var s @[]char = ""
	for i := 0; i < n; i++ {
		var d @[]char = buf.CopyStr("C0 = 0\n")
		d[1] = cast(char, cast(int, 'a') + i) // C<letter>: a distinct name each
		s = buf.Concat(s, d)
	}
	return s
}

// A global or weak alias is rejected when it was used before being declared so (that use
// took its target) — tracked across the constant table's growth and a constant's removal —
// when redefined after a use (its symbol has one value), and when its target is not
// defined here (no object can list it; clang drops the alias and its binding).
func TestBoundAliasRejects() testing.TestResult {
	var e @[]char = ""
	var used *[]readonly char = "was used before being made global or weak"
	var redef *[]readonly char = "used since its definition; it cannot be redefined"
	e = boundReject(e, buf.Concat(boundHeader, "A = lbl\nb A\n.global A"), used)
	e = boundReject(e, buf.Concat(boundHeader, "A = lbl\nb A\n.weak A"), used)
	e = boundReject(e, buf.Concat(boundHeader, "A = lbl\nb A\n.global_c A"), used)
	var grown @[]char = buf.Concat(buf.Concat(boundHeader, "A = lbl\nb A\n"), manyConsts(20))
	e = boundReject(e, buf.Concat(grown, ".global A"), used)
	e = boundReject(e, buf.Concat(boundHeader, "N = 1\nA = lbl\nb A\nN: nop\n.global A"), used)
	e = boundReject(e, buf.Concat(boundHeader, ".global A\nA = lbl\nb A\nA = l2"), redef)
	e = boundReject(e, buf.Concat(boundHeader, ".weak A\nA = lbl\nb A\nA = 5"), redef)
	e = boundReject(e, ".global A\nA = ext\nbl A", "which is not defined here")
	var p @Parser = labelsSource("nop\n.weak W\nW = ext + 4\nnop", asm.OBJ_ELF)
	if !plHasPrefix(p.ErrorMsg, "test.s:5: error: 'W' is a global or weak alias of 'ext', which") {
		e = goldenFail(e, "W = ext + 4", buf.Concat("wrong diagnostic: ", p.ErrorMsg))
	}
	return e
}
