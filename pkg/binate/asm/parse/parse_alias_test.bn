package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Symbol-valued expressions on AArch64: a symbol plus numbers wherever a symbol is taken
// (`lbl+4+4`, `4+lbl`, `(lbl+4)`, `#lbl`), aliases (`A = lbl + 8`) and `.` definitions
// (`C = .`), against clang's words (`clang -c -target aarch64-linux-gnu`).  (labelsCase /
// labelsReject / labelsSource are in aarch64_golden_labels_test.bn, defsLineRejected in
// parse_const_test.bn.)

// aliasHeader defines the labels and aliases the cases below use: lbl at 4 and l2 at 8,
// after one nop each, A = lbl + 8, C = . (at 12) and N = 2.
var aliasHeader *[]readonly char = "nop\nlbl: nop\nl2: nop\nA = lbl + 8\nC = .\nN = 2\n"

// aliasCase checks that line, after aliasHeader (whose three nops it follows), assembles to
// the word want with no relocation.
func aliasCase(e @[]char, line *[]readonly char, want *[]readonly char) @[]char {
	var w @[]char = buf.Concat("D503201F D503201F D503201F ", want)
	return labelsCase(e, buf.Concat(aliasHeader, line), w)
}

// aliasReloc checks that src assembles for ELF with exactly one relocation, against sym
// with addend.
func aliasReloc(e @[]char, src *[]readonly char, sym *[]readonly char, addend int) @[]char {
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	if p.Asm.NumRelocs != 1 { return goldenFail(e, src, "not exactly one relocation") }
	var r asm.Relocation = p.Asm.Relocs[0]
	if !charsEqual(p.Asm.Symbols[r.Symbol].Name, sym) || r.Addend != addend {
		return goldenFail(e, src, "relocation against the wrong symbol or addend")
	}
	return e
}

// A symbol takes any sum or difference with numbers — constants included — in any order
// and parenthesized, and `#` may precede a symbol where one is taken (clang: `b #lbl`).
func TestSymExprOperands() testing.TestResult {
	var e @[]char = ""
	e = aliasCase(e, "b lbl+4+4", "14000000 ")
	e = aliasCase(e, "b lbl+2*2", "17FFFFFF ")
	e = aliasCase(e, "b lbl-4+8", "17FFFFFF ")
	e = aliasCase(e, "b 4+lbl", "17FFFFFF ")
	e = aliasCase(e, "b (lbl+4)", "17FFFFFF ")
	e = aliasCase(e, "b lbl + (4) + 4", "14000000 ")
	e = aliasCase(e, "b lbl - -4", "17FFFFFF ")
	e = aliasCase(e, "b lbl+N*2", "17FFFFFF ")
	e = aliasCase(e, "b . + 4 + 4", "14000002 ")
	e = aliasCase(e, "b #lbl", "17FFFFFE ")
	e = aliasCase(e, "b #4+lbl", "17FFFFFF ")
	e = aliasCase(e, "adr x0, lbl+4+4", "10000000 ")
	e = aliasCase(e, "adr x0, #lbl", "10FFFFC0 ")
	e = aliasCase(e, "cbz x0, #lbl", "B4FFFFC0 ")
	e = aliasCase(e, "tbz x0, #1, #lbl", "360FFFC0 ")
	e = aliasCase(e, "b.eq lbl+4+4", "54000000 ")
	e = aliasCase(e, "ldr x0, lbl+4+4", "58000000 ")
	e = aliasCase(e, "ldr x0, 4+lbl", "58FFFFE0 ")
	e = aliasCase(e, "ldr x0, #lbl", "58FFFFC0 ")
	e = aliasCase(e, "prfm pldl1keep, #lbl", "D8FFFFC0 ")
	e = aliasReloc(e, ".global ext\nbl ext+4+4", "ext", 8)
	e = aliasReloc(e, ".global ext\nadrp x0, (ext+8)", "ext", 8)
	e = aliasReloc(e, ".global ext\nldr x0, [x0, :lo12:4+ext]", "ext", 4)
	return e
}

// A symbol takes nothing but numbers added to or subtracted from it: no negation or
// scaling, no second symbol, no difference of two locations (clang evaluates `l2 - l1`
// only at layout), and no mix of + with a shift (the Mach-O and ELF precedences differ).
func TestSymExprRejects() testing.TestResult {
	var e @[]char = ""
	e = defsLineRejected(e, "lbl:", "b -lbl")
	e = defsLineRejected(e, "lbl:", "b lbl*2")
	e = defsLineRejected(e, "lbl:", "b lbl+lbl")
	e = defsLineRejected(e, "lbl:", "b lbl - lbl")
	e = defsLineRejected(e, "lbl:", "b lbl + 8 >> 1")
	e = defsLineRejected(e, "lbl:", "ldr x0, [x0, #lbl]")
	e = defsLineRejected(e, ".global ext", "add x0, x0, :lo12:(ext+4)*1")
	e = defsLineRejected(e, "lbl:", ".uint32 lbl")
	return e
}

// An alias names a symbol plus a number; each use sees its latest definition, and an
// alias of an alias, of a numeric local label or of a later or external symbol resolves
// to that symbol (clang: `F1 = 1f`, `T = .Ltmp`).  `C = .` names the location of its
// definition.
func TestAliases() testing.TestResult {
	var e @[]char = ""
	e = aliasCase(e, "b A", "14000000 ")
	e = aliasCase(e, "b A+4", "14000001 ")
	e = aliasCase(e, "adr x0, A", "10000000 ")
	e = aliasCase(e, "ldr x0, A", "58000000 ")
	e = aliasCase(e, "b C", "14000000 ")
	e = labelsCase(e, "l1: nop\nl2: nop\nA = l1\nb A\nA = l2\nb A",
			"D503201F D503201F 17FFFFFE 17FFFFFE ")
	e = labelsCase(e, "lbl: nop\nBA = lbl + 8\nBB = BA + 4\nb BB", "D503201F 14000002 ")
	e = labelsCase(e, "F1 = 1f\nb F1\n1: nop", "14000001 D503201F ")
	e = labelsCase(e, "T = .Ltmp\nb T\n.Ltmp: nop", "14000001 D503201F ")
	e = labelsCase(e, "nop\nC = .\nb C\nC = .\nb C", "D503201F 14000000 14000000 ")
	e = labelsCase(e, "nop\nC8 = . + 8\nb C8\nnop\nnop", "D503201F 14000002 D503201F D503201F ")
	e = labelsCase(e, "nop\nC = .\nnop\nb C", "D503201F D503201F 17FFFFFF ")
	e = labelsCase(e, "msl: nop\ncbz x0, #msl", "D503201F B4FFFFE0 ")
	e = aliasReloc(e, ".global ext\nE = ext + 4\nbl E", "ext", 4)
	e = aliasReloc(e, ".global ext\nE = ext + 4\nadrp x0, E+4", "ext", 8)
	return e
}

// An alias is no number (`#A`, a data value, an operand of `*`), and no alias is made of
// a difference of locations; an alias's name follows the constants' rules (a label's
// name is no alias), and a name an alias was defined from cannot later become a constant
// (a forward reference).  No alias is global or weak (TestAliasBindingRejected), and none
// lies before its section's start.  A label may not take an alias's name, a deliberate
// reject: clang binds the alias's earlier uses to that label too (`A = l1`, `b A`, `A:`
// branches to A), where they have already taken the alias's target here.
func TestAliasRejects() testing.TestResult {
	var e @[]char = ""
	e = labelsReject(e, "lbl: nop\nA = lbl\nadd x0, x1, #A")
	e = labelsReject(e, "lbl: nop\nA = lbl\n.uint32 A")
	e = labelsReject(e, "lbl: nop\nA = lbl\nM = A * 2")
	e = labelsReject(e, "lbl: nop\nA = lbl - lbl")
	e = labelsReject(e, "lbl: nop\nC = . - lbl")
	e = labelsReject(e, ".global A\nA = ext")
	e = labelsReject(e, "A = ext\n.weak A")
	e = labelsReject(e, "lbl: nop\nA = lbl - 8")
	e = labelsReject(e, "lbl: nop\nlbl = 4")
	e = labelsReject(e, "A = B\nB = 5")
	e = labelsReject(e, "lbl: nop\nA = lbl\nA: nop\nb A")
	e = labelsReject(e, "l1: nop\nA = l1\nb A\nA: nop")
	e = labelsReject(e, "nop\nC = .\nb C\nC: nop")
	return e
}

// `.` after a relocation qualifier names a label made at the instruction (clang: `add x0,
// x0, :lo12:.+8` relocates against the location of the add, plus 8).
func TestSymExprDotQualifier() testing.TestResult {
	var p @Parser = labelsSource("nop\nadd x0, x0, :lo12:.+8", asm.OBJ_ELF)
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumRelocs != 1 { return fail("not exactly one relocation") }
	var r asm.Relocation = p.Asm.Relocs[0]
	var sym asm.Symbol = p.Asm.Symbols[r.Symbol]
	if !asm.IsGeneratedLabel(sym.Name) || sym.Offset != 4 || r.Addend != 8 {
		return fail("the relocation is not against the add's location plus 8")
	}
	return ""
}

// A system operand name — a barrier option, hint target, system register, cache or TLB
// operation, `c<n>` — is a plain name: written after '#' or as an alias it is a symbol,
// and the line is rejected (as clang rejects it).
func TestSysNamesArePlain() testing.TestResult {
	var e @[]char = ""
	e = defsLineRejected(e, "", "dmb #ish")
	e = defsLineRejected(e, "", "isb #sy")
	e = defsLineRejected(e, "", "dsb #ishnxs")
	e = defsLineRejected(e, "", "bti #c")
	e = defsLineRejected(e, "", "psb #csync")
	e = defsLineRejected(e, "", "mrs x0, #midr_el1")
	e = defsLineRejected(e, "", "msr #tpidr_el0, x0")
	e = defsLineRejected(e, "", "msr #spsel, #1")
	e = defsLineRejected(e, "", "dc #civac, x0")
	e = defsLineRejected(e, "", "tlbi #vmalle1")
	e = defsLineRejected(e, "", "sys #0, #c7, c5, #0")
	e = defsLineRejected(e, "A = ish", "dmb A")
	e = defsLineRejected(e, "A = midr_el1", "mrs x0, A")
	e = defsLineRejected(e, "A = c7", "sys #0, A, c5, #0")
	e = defsLineRejected(e, "A = civac", "dc A, x0")
	e = defsLineRejected(e, "A = csync", "psb A")
	e = defsLineRejected(e, "A = c", "bti A")
	return e
}
