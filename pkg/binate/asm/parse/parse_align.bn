package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// Alignment padding in executable sections: where code may run through the padding
// (a loop head aligned after the code before it), `.balign` / `.p2align` without a
// fill value pad with the architecture's no-op instructions, byte for byte as clang
// (LLVM's writeNopData) does, rather than with zeros (a zero word is `udf #0` on
// AArch64, and 00 00 is `add [rax], al` on x86-64).

// x64NopBytes returns the LLVM x86-64 no-op of length n (1..10 bytes): nop, xchg ax,ax,
// then the `nopl` / `nopw` forms with growing displacements, the longest with a CS
// segment prefix.
func x64NopBytes(n int) *[]readonly uint8 {
	if n == 1 { return "\x90" }
	if n == 2 { return "\x66\x90" }
	if n == 3 { return "\x0f\x1f\x00" }
	if n == 4 { return "\x0f\x1f\x40\x00" }
	if n == 5 { return "\x0f\x1f\x44\x00\x00" }
	if n == 6 { return "\x66\x0f\x1f\x44\x00\x00" }
	if n == 7 { return "\x0f\x1f\x80\x00\x00\x00\x00" }
	if n == 8 { return "\x0f\x1f\x84\x00\x00\x00\x00\x00" }
	if n == 9 { return "\x66\x0f\x1f\x84\x00\x00\x00\x00\x00" }
	return "\x66\x2e\x0f\x1f\x84\x00\x00\x00\x00\x00"
}

// emitCodePadding emits pad bytes of no-op padding for p's architecture:
//   - AArch64: pad % 4 zero bytes (only unaligned data in a code section leaves a
//     remainder), then NOP words;
//   - ARM: `mov r0, r0` words, then LLVM's pattern for a 1..3-byte remainder;
//   - x86-64: no-ops of at most 10 bytes each, the last one shorter.
func emitCodePadding(p @Parser, pad int) {
	var a @asm.Assembler = p.Asm
	if p.Arch == ARCH_AARCH64 {
		for i := 0; i < pad % 4; i++ { a.EmitUint8(0) }
		for i := 0; i < pad / 4; i++ { a.EmitUint32(0xD503201F) }
		return
	}
	if p.Arch == ARCH_ARM32 {
		for i := 0; i < pad / 4; i++ { a.EmitUint32(0xE1A00000) }
		var rem int = pad % 4
		if rem >= 1 { a.EmitUint8(0) }
		if rem >= 2 { a.EmitUint8(0) }
		if rem == 3 { a.EmitUint8(0xA0) }
		return
	}
	if p.Arch == ARCH_X64 {
		var left int = pad
		for left > 0 {
			var n int = left
			if n > 10 { n = 10 }
			var b *[]readonly uint8 = x64NopBytes(n)
			for i := 0; i < len(b); i++ { a.EmitUint8(b[i]) }
			left = left - n
		}
		return
	}
	for i := 0; i < pad; i++ { a.EmitUint8(0) }
}

// alignPadInCode reports how many bytes padding the current section to align would
// take when that section is executable and align a valid (power-of-two, positive)
// alignment, or -1 when the padding is not code padding.
func alignPadInCode(p @Parser, align int) int {
	var a @asm.Assembler = p.Asm
	if a.Current < 0 || align <= 0 || (align & (align - 1)) != 0 { return -1 }
	var s @asm.Section = a.Sections[a.Current]
	if (s.Flags & asm.SF_EXEC) == 0 { return -1 }
	return (align - s.Len % align) % align
}
