package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Code-section alignment padding (parse_align.bn): no-ops byte for byte as clang
// emits them.  (dirRun is in parse_directive_test.bn, litHex in lex_literal_test.bn.)

// x64NopBytes is LLVM's x86-64 no-op table: lengths 1..10, each decoding as a
// single instruction (the byte strings are clang's `.p2align` padding).
func TestX64NopTable() testing.TestResult {
	var e @[]char = ""
	var want @[]@[]char = make_slice(@[]char, 10)
	want[0] = buf.CopyStr("90")
	want[1] = buf.CopyStr("6690")
	want[2] = buf.CopyStr("0F1F00")
	want[3] = buf.CopyStr("0F1F4000")
	want[4] = buf.CopyStr("0F1F440000")
	want[5] = buf.CopyStr("660F1F440000")
	want[6] = buf.CopyStr("0F1F8000000000")
	want[7] = buf.CopyStr("0F1F840000000000")
	want[8] = buf.CopyStr("660F1F840000000000")
	want[9] = buf.CopyStr("662E0F1F840000000000")
	for n := 1; n <= 10; n++ {
		var got @[]char = litHex(x64NopBytes(n))
		if !charsEqual(got, want[n - 1]) {
			e = goldenFail(e, want[n - 1], buf.Concat("table gave ", got))
		}
	}
	return e
}

// alignCode returns the hex bytes of the text section after parsing lines (joined by
// newlines) for arch, or "error: <msg>".
func alignCode(arch *[]readonly char, lines *[]readonly char) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(buf.Concat(".arch ", arch))
	p.ParseLine(".section text")
	dirRun(p, lines)
	if p.HasError { return buf.Concat("error: ", p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	return litHex(s.Data[0:s.Len])
}

// alignCodeIs checks alignCode(arch, lines) against want.
func alignCodeIs(e @[]char, arch *[]readonly char, lines *[]readonly char,
		want *[]readonly char) @[]char {
	var got @[]char = alignCode(arch, lines)
	if !charsEqual(got, want) { return goldenFail(e, lines, buf.Concat("emitted ", got)) }
	return e
}

// In a code section, `.balign` / `.p2align` without a fill pad with no-ops exactly as
// clang does — AArch64: leftover bytes as zeros, then NOP words; ARM: `mov r0, r0`
// words, then LLVM's 00 / 00 00 / 00 00 A0 remainder; x86-64: LLVM's multi-byte
// no-ops of at most 10 bytes — while an explicit fill still fills.
func TestDirectiveAlignCodeNopPadding() testing.TestResult {
	var e @[]char = ""
	e = alignCodeIs(e, "aarch64", "nop\n.p2align 3\nnop", "1F2003D51F2003D51F2003D5")
	e = alignCodeIs(e, "aarch64", "nop\n.uint8 1\n.p2align 3\nnop", "1F2003D5010000001F2003D5")
	e = alignCodeIs(e, "aarch64", "nop\n.p2align 4", "1F2003D51F2003D51F2003D51F2003D5")
	e = alignCodeIs(e, "aarch64", "nop\n.p2align 3, 0", "1F2003D500000000")
	e = alignCodeIs(e, "arm32", "nop\n.p2align 3\nnop", "0000A0E10000A0E10000A0E1")
	e = alignCodeIs(e, "arm32", "nop\n.uint8 1\n.p2align 3\nnop", "0000A0E1010000A00000A0E1")
	e = alignCodeIs(e, "x64", "ret\n.p2align 4", "C3662E0F1F8400000000000F1F440000")
	e = alignCodeIs(e, "x64", "ret\n.p2align 2", "C30F1F00")
	e = alignCodeIs(e, "x64", "ret\n.balign 8, 0xCC", "C3CCCCCCCCCCCCCC")
	return e
}
