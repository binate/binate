package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// The instruction set and the object format: `.arch` and the target it chooses.

// UseMachoFor reports whether arch's output on osName is Mach-O; see parse.bni.
func UseMachoFor(arch int, osName *[]readonly char) (bool, @[]char) {
	if len(osName) == 0 { return arch == ARCH_AARCH64, "" }
	if charsEqual(osName, "darwin") || charsEqual(osName, "macos") { return true, "" }
	if charsEqual(osName, "linux") { return false, "" }
	return false, buf.Concat("unknown os: ", osName)
}

// parseArchDirective handles ".arch name": an instruction set — aarch64 (arm64), arm32 (arm),
// x64 (x86_64) — or, for arm32 code (or code whose instruction set is not chosen yet, which it
// then makes arm32), an ARM architecture, read as clang reads it (the rest of the line, as
// `.cpu`'s name; setArmArch).  The instruction-set names keep their meaning in arm32 code too,
// where clang reads aarch64 and arm64 as ARMv8-A.
func parseArchDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	var wasArm bool = p.Arch == ARCH_ARM32
	var at Lexer = l
	l, tok = LexNext(l)
	var isa int = ARCH_UNKNOWN
	if tok.Kind == TOK_IDENT {
		if charsEqual(tok.Text, "aarch64") || charsEqual(tok.Text, "arm64") { isa = ARCH_AARCH64 }
		if charsEqual(tok.Text, "arm32") || charsEqual(tok.Text, "arm") { isa = ARCH_ARM32 }
		if charsEqual(tok.Text, "x64") || charsEqual(tok.Text, "x86_64") { isa = ARCH_X64 }
	}
	if isa == ARCH_UNKNOWN && (p.Arch == ARCH_ARM32 || p.Arch == ARCH_UNKNOWN) {
		var name @[]char
		var k int = armCommentIn(at)
		if p.Arch == ARCH_UNKNOWN && k >= 0 {
			// With no architecture yet, `@` is no comment character to prepareLine (ParseLine
			// prepares the line again once this makes it arm32): an ARM name ends at one
			// (`.arch armv7-a @ comment`), the rest of the statement its comment.
			at, name = restBeforeArmComment(p, at, k)
		} else {
			at, name = restOfLine(p, at)
		}
		var known bool
		_, _, known = armArchNamed(name)
		if known || p.Arch == ARCH_ARM32 {
			if !setArmArch(p, name) { return at, tok }
			isa = ARCH_ARM32
			l = at
		}
	}
	if isa == ARCH_UNKNOWN {
		if tok.Kind != TOK_IDENT {
			setErr(p, "expected architecture name")
		} else {
			setErr(p, "unknown architecture")
		}
		return l, tok
	}
	p.SetArch(isa)
	if p.OsKnown && p.Asm.ObjFormat == asm.OBJ_UNKNOWN {
		// The target is known now: its object format decides what the input means from
		// here on (which displacements and label differences are fixed).
		macho, merr := UseMachoFor(p.Arch, p.TargetOs)
		if len(merr) != 0 {
			setErr(p, merr)
			return l, tok
		}
		p.Asm.ObjFormat = asm.OBJ_ELF
		if macho { p.Asm.ObjFormat = asm.OBJ_MACHO }
	}
	l, tok = LexNext(l)
	if isa == ARCH_ARM32 && !wasArm && tok.Kind == TOK_AT {
		// `.arch arm @ comment`, the architecture new to the line: the `@` starts its comment.
		l.Col = l.Col + len(l.Src) - l.Pos
		l.Pos = len(l.Src)
		l, tok = LexNext(l)
	}
	return l, tok
}

// armCommentIn returns where an `@` (ARM's comment character) is in l's source from l on, before
// a `//` comment (whose text may hold one), or -1.
func armCommentIn(l Lexer) int {
	for i := l.Pos; i < len(l.Src); i++ {
		if l.Src[i] == '/' && i + 1 < len(l.Src) && l.Src[i + 1] == '/' { return -1 }
		if l.Src[i] == '@' { return i }
	}
	return -1
}

// restBeforeArmComment returns the text from l to the `@` at k (armCommentIn), the spaces around
// it dropped, and l at the end of the source: the rest is ARM's comment.  A `/* */` comment that
// begins after the text's start, before the `@`, makes it name nothing, as restOfLine's does.
func restBeforeArmComment(p @Parser, l Lexer, k int) (Lexer, @[]char) {
	l = lexSkipSpaces(l)
	var start int = l.Pos
	var name @[]char = buf.CopyStr("")
	if !commentWithin(p, start, k) {
		var end int = k
		for end > start && isSpace(l.Src[end - 1]) { end = end - 1 }
		name = buf.CopyStr(l.Src[start:end])
	}
	l.Col = l.Col + len(l.Src) - l.Pos
	l.Pos = len(l.Src)
	return l, name
}

// commentWithin reports whether a `/* */` comment begins in the statement being parsed after
// position lo and before hi (positions in the statement; p.CommentStarts, p.StmtStart).
func commentWithin(p @Parser, lo int, hi int) bool {
	for i := 0; i < len(p.CommentStarts); i++ {
		var c int = p.CommentStarts[i] - p.StmtStart
		if c > lo && c < hi { return true }
	}
	return false
}
