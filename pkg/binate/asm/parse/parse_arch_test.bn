package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// `.arch` on a line of several statements (parse_arch.bn).  (newTestParser, lineEmitsHex are in
// parse_test.bn, goldenFail in aarch64_golden_test.bn, linesEmit in parse_statement_test.bn,
// plContains in parse_line_test.bn.)

// A `/* */` comment in an earlier statement of the line is not in a later one: arm32's
// `mov r0, r1 /* x */; .fpu vfpv3` (and `.cpu`, `.arch armv7-a`) takes the name after the
// `;`, as clang does.  An `.arch` decides how the rest of its line splits: `.arch armv7-a;
// nop` and `.arch x64; .section text; nop` from a parser with no architecture yet — an
// `@` comment after an arm32 `.arch` included, on its line and in it (`.arch armv7-a @ c`,
// `.arch arm @ c`, a label before the `.arch`, an `@` in a `//` comment no ARM one), read as
// clang reads it (`clang -target armv7a-none-eabi`): no statement after the `@`, no `/*` in it
// opening a comment, nothing in it lexed, a `/* */` between the name and the `@` naming nothing
// — while `.arch aarch64; nop` is an error at the `;`, which AArch64 takes none of.
func TestStatementCommentsAndArch() testing.TestResult {
	var e @[]char = ""
	var dirs @[]*[]readonly char = @[]*[]readonly char{"mov r0, r1 /* x */; .fpu vfpv3",
			"mov r0, r1 /* x */; .cpu cortex-a8", "mov r0, r1 /* x */; .arch armv7-a"}
	for i := 0; i < len(dirs); i++ {
		var p @Parser = newTestParser()
		p.ParseLine(".arch arm32")
		p.ParseLine(".section text")
		var r testing.TestResult = lineEmitsHex(p, dirs[i], "01 00 a0 e1")
		if len(r) > 0 { e = goldenFail(e, dirs[i], r) }
	}
	var a @Parser = newTestParser()
	a.ParseLine(".section text")
	var r testing.TestResult = lineEmitsHex(a, ".arch armv7-a; nop", "00 f0 20 e3")
	if len(r) > 0 { e = goldenFail(e, ".arch armv7-a; nop", r) }
	var x @Parser = newTestParser()
	r = lineEmitsHex(x, ".arch x64; .section text; nop", "90")
	if len(r) > 0 { e = goldenFail(e, ".arch x64; .section text; nop", r) }
	var c @Parser = newTestParser()
	r = lineEmitsHex(c, ".arch armv7-a; .section text; nop @ a comment; with a `;`", "00 f0 20 e3")
	if len(r) > 0 { e = goldenFail(e, ".arch armv7-a; … nop @ …", r) }
	var d @Parser = newTestParser()
	d.ParseLine(".arch armv7-a @ a comment")
	d.ParseLine(".section text")
	r = lineEmitsHex(d, "nop", "00 f0 20 e3")
	if len(r) > 0 { e = goldenFail(e, ".arch armv7-a @ a comment", r) }
	var cases @[]@[]*[]readonly char = @[]@[]*[]readonly char{
			@[]*[]readonly char{".section text", ".arch armv7-a @ c; nop", "mov r1, r2"},
			@[]*[]readonly char{".arch armv7-a; .section text; nop @ x /* y", "nop", "@ */", "mov r1, r2"},
			@[]*[]readonly char{".arch armv7-a @ don't say \"hi", ".section text", "mov r1, r2"},
			@[]*[]readonly char{".arch armv7-a @ c /* d", ".section text", "mov r1, r2"},
			@[]*[]readonly char{".arch arm @ c", ".section text", "mov r1, r2"},
			@[]*[]readonly char{".arch arm32 @ c", ".section text", "mov r1, r2"},
			@[]*[]readonly char{".arch armv7-a // see @foo", ".section text", "mov r1, r2"},
			@[]*[]readonly char{".section text", "l: .arch armv7-a @ don't", "mov r1, r2"}}
	var hexes @[]*[]readonly char = @[]*[]readonly char{"02 10 a0 e1",
			"00 f0 20 e3 00 f0 20 e3 02 10 a0 e1", "02 10 a0 e1", "02 10 a0 e1", "02 10 a0 e1",
			"02 10 a0 e1", "02 10 a0 e1", "02 10 a0 e1"}
	for i := 0; i < len(cases); i++ {
		var q @Parser = newTestParser()
		r = linesEmit(q, cases[i], hexes[i])
		if len(r) > 0 { e = goldenFail(e, cases[i][0], r) }
	}
	var z @Parser = newTestParser()
	z.ParseLine(".arch armv7-a /* x */ @ c")
	if !z.HasError || !plContains(z.ErrorMsg, "unknown architecture") {
		e = goldenFail(e, ".arch armv7-a /* x */ @ c", buf.Concat("not rejected: ", z.ErrorMsg))
	}
	var y @Parser = newTestParser()
	y.ParseLine(".arch aarch64; nop")
	if !y.HasError || !plContains(y.ErrorMsg, "unexpected character ';'") {
		e = goldenFail(e, ".arch aarch64; nop", buf.Concat("not rejected: ", y.ErrorMsg))
	}
	return e
}
