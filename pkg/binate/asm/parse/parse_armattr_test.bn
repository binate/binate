package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The ARM build-attribute directives (parse_armattr.bn).  (dataSource and dataReject are in
// parse_data_test.bn.)

// armAttrIs reports whether p set ARM build attribute tag explicitly to num and str.
func armAttrIs(p @Parser, tag int64, num int64, str *[]readonly char) bool {
	for i := 0; i < p.Asm.NumArmAttrs; i++ {
		var attr asm.ArmAttr = p.Asm.ArmAttrs[i]
		if attr.Tag == tag { return attr.Num == num && charsEqual(attr.Str, str) }
	}
	return false
}

// `.eabi_attribute` takes a tag by name (clang's, an alias too) or number (an expression, a
// constant's name inside it) and a number, a string, or for Tag_compatibility both; a string's
// contents are kept as written, escapes and all, but Tag_also_compatible_with's, whose escapes
// are read — as clang does.  A tag set again takes the later value.
func TestEabiAttributeDirective() testing.TestResult {
	var p @Parser = dataSource("arm32",
			"two = 2\n.eabi_attribute Tag_CPU_arch, 7\n.eabi_attribute Tag_VFP_arch, 2 + two\n"
					".eabi_attribute (40 + 4), 0x80\n.eabi_attribute 67, \"2.09\"\n"
					".eabi_attribute Tag_compatibility, 1, \"gnu\"\n"
					".eabi_attribute Tag_CPU_name, \"a\\\\x41\"\n"
					".eabi_attribute Tag_also_compatible_with, \"\\006\\012\"\n"
					".eabi_attribute 129, \"x\" // a comment\n.eabi_attribute Tag_CPU_arch, 10\n"
					".eabi_attribute ABI_PCS_wchar_t, 4\n.eabi_attribute CPU_raw_name, \"r\"\n",
			asm.OBJ_ELF)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat(p.ErrorMsg, p.Asm.ErrorMsg)) }
	if p.Asm.NumArmAttrs != 10 { return fail("not 10 attributes") }
	if !armAttrIs(p, 18, 4, "") || !armAttrIs(p, 4, 0, "r") {
		return fail("a name without its Tag_ is not the tag")
	}
	if !armAttrIs(p, 6, 10, "") || !armAttrIs(p, 10, 4, "") || !armAttrIs(p, 44, 128, "") {
		return fail("the numbers are not as written, Tag_CPU_arch the later one")
	}
	if !armAttrIs(p, 67, 0, "2.09") || !armAttrIs(p, 32, 1, "gnu") || !armAttrIs(p, 129, 0, "x") {
		return fail("the strings are not as written")
	}
	if !armAttrIs(p, 5, 0, "a\\\\x41") { return fail("Tag_CPU_name's escapes were read") }
	if !armAttrIs(p, 65, 0, "\x06\x0a") {
		return fail("Tag_also_compatible_with's escapes were not read")
	}
	return ""
}

// `.cpu` sets Tag_CPU_name to the rest of its line (spaces around it dropped), the later of it
// and `.eabi_attribute Tag_CPU_name` winning; `.fpu` selects an FPU, the last one winning.
func TestCPUAndFPUDirectives() testing.TestResult {
	var p @Parser = dataSource("arm32",
			".fpu neon-vfpv4\n.cpu   cortex-a15  \n.eabi_attribute 5, \"x\"\n.cpu cortex-a9 @ c\n"
					".fpu /* c */ fp-armv8\n/* c */ .fpu  vfpv3-d16 // c\n",
			asm.OBJ_ELF)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat(p.ErrorMsg, p.Asm.ErrorMsg)) }
	if p.Asm.NumArmAttrs != 1 || !armAttrIs(p, 5, 0, "cortex-a9") {
		return fail("Tag_CPU_name is not the last .cpu's")
	}
	if !charsEqual(p.Asm.ArmFPU, "vfpv3-d16") { return fail("the FPU is not the last .fpu's") }
	p = dataSource("arm32", ".eabi_attribute 5, \"x\"\n.cpu cortex-a9\n.eabi_attribute 5, \"y\"\n",
			asm.OBJ_ELF)
	if p.HasError || !armAttrIs(p, 5, 0, "y") { return fail("Tag_CPU_name is not the last one") }
	return ""
}

// What clang rejects, with its messages; a Thumb-only CPU (clang switches to Thumb code, which
// the assembler does not write); and, unlike clang, a tag of 0 .. 3 or one or a number outside
// 32 bits; and the directives on another architecture.
func TestArmAttrDirectiveErrors() testing.TestResult {
	var e @[]char
	e = dataReject(e, "arm32", ".eabi_attribute tag_cpu_arch, 1\n", asm.OBJ_ELF,
			"attribute name not recognised: tag_cpu_arch")
	e = dataReject(e, "arm32", ".eabi_attribute Tag_NEON_arch, 1\n", asm.OBJ_ELF,
			"attribute name not recognised")
	e = dataReject(e, "arm32", ".eabi_attribute Tag_CPU_arch 1\n", asm.OBJ_ELF, "expected comma")
	e = dataReject(e, "arm32", ".eabi_attribute 6\n", asm.OBJ_ELF, "expected comma")
	e = dataReject(e, "arm32", ".eabi_attribute 4, 5\n", asm.OBJ_ELF, "bad string constant")
	e = dataReject(e, "arm32", ".eabi_attribute 32, 1\n", asm.OBJ_ELF, "expected comma")
	e = dataReject(e, "arm32", ".eabi_attribute 32, 1, 2\n", asm.OBJ_ELF, "bad string constant")
	e = dataReject(e, "arm32", ".eabi_attribute 6, \"x\"\n", asm.OBJ_ELF, "expected numeric constant")
	e = dataReject(e, "arm32", ".eabi_attribute 6, x\n", asm.OBJ_ELF, "")
	e = dataReject(e, "arm32", "a: .uint8 0\nb: .eabi_attribute 6, b - a\n", asm.OBJ_ELF,
			"expected numeric constant")
	e = dataReject(e, "arm32", ".eabi_attribute 6, 1, 2\n", asm.OBJ_ELF, "unexpected token")
	e = dataReject(e, "arm32", ".eabi_attribute 1, 1\n", asm.OBJ_ELF, "attribute tag out of range")
	e = dataReject(e, "arm32", ".eabi_attribute Tag_File, 1\n", asm.OBJ_ELF,
			"attribute tag out of range")
	e = dataReject(e, "arm32", ".eabi_attribute 0, 1\n", asm.OBJ_ELF, "attribute tag out of range")
	e = dataReject(e, "arm32", ".eabi_attribute -1, 1\n", asm.OBJ_ELF, "attribute tag out of range")
	e = dataReject(e, "arm32", ".eabi_attribute 0x100000000, 1\n", asm.OBJ_ELF,
			"attribute tag out of range")
	e = dataReject(e, "arm32", ".eabi_attribute 6, -1\n", asm.OBJ_ELF, "attribute value out of range")
	e = dataReject(e, "arm32", ".eabi_attribute 6, 0x100000000\n", asm.OBJ_ELF,
			"attribute value out of range")
	e = dataReject(e, "arm32", ".fpu NEON\n", asm.OBJ_ELF, "Unknown FPU name")
	e = dataReject(e, "arm32", ".fpu\n", asm.OBJ_ELF, "Unknown FPU name")
	e = dataReject(e, "arm32", ".cpu cortex - a15\n", asm.OBJ_ELF, "Unknown CPU name")
	e = dataReject(e, "arm32", ".cpu \"cortex-a15\"\n", asm.OBJ_ELF, "Unknown CPU name")
	e = dataReject(e, "arm32", ".cpu cortex-m3\n", asm.OBJ_ELF, "Thumb-only CPU")
	e = dataReject(e, "arm32", ".eabi_attribute Tag_, 1\n", asm.OBJ_ELF, "not recognised: Tag_")
	e = dataReject(e, "arm32", ".eabi_attribute File, 1\n", asm.OBJ_ELF, "attribute tag out of range")
	// clang reads a block comment after the name as part of it
	e = dataReject(e, "arm32", ".fpu vfpv3 /* c */\n", asm.OBJ_ELF, "Unknown FPU name")
	e = dataReject(e, "arm32", ".cpu cortex-a9 /* c\n */\n", asm.OBJ_ELF, "Unknown CPU name")
	e = dataReject(e, "aarch64", ".eabi_attribute 6, 1\n", asm.OBJ_ELF, "unknown directive")
	e = dataReject(e, "x64", ".fpu neon\n", asm.OBJ_ELF, "unknown directive")
	if len(e) > 0 { return fail(e) }
	return ""
}
