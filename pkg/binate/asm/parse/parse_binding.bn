package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// The binding directives' rules: which changes of a symbol's binding `.local`, `.global` /
// `.global_c` and `.weak` may make, as clang allows them, and the names `.local` declared.

// bindingChangeOk reports whether a `.local`, `.global` / `.global_c` or `.weak` directive
// (binding) may give name that binding, else sets the error.  On ELF, as in clang, `.local`
// may not follow `.global` or `.weak`, nor `.global` follow `.local` or `.weak` ("changed
// binding"); `.weak` may follow either, making the symbol weak (where clang warns).  On
// Mach-O `.global` may follow `.weak`, the symbol staying weak, and there is no `.local`
// (clang: "unknown directive").  Where the rule depends on the object format, it must be
// known.
func bindingChangeOk(p @Parser, name *[]readonly char, binding int) bool {
	var cur int = asm.BIND_LOCAL
	var si int = p.Asm.LookupSymbol(name)
	if si >= 0 { cur = p.Asm.Symbols[si].Binding }
	if binding == asm.BIND_LOCAL {
		if p.Asm.ObjFormat == asm.OBJ_UNKNOWN {
			setErr(p, ".local needs the object format, not yet known here")
			return false
		}
		if p.Asm.ObjFormat == asm.OBJ_MACHO {
			setErr(p, ".local is an ELF directive")
			return false
		}
		if cur != asm.BIND_LOCAL {
			setErr(p, quotedName(name, " changed binding to local (it is global or weak)"))
			return false
		}
		return true
	}
	if binding != asm.BIND_GLOBAL { return true }
	if cur == asm.BIND_WEAK {
		if p.Asm.ObjFormat == asm.OBJ_MACHO { return true }
		if p.Asm.ObjFormat == asm.OBJ_UNKNOWN {
			setErr(p, quotedName(name, " is weak; making it global needs the object format"))
			return false
		}
		setErr(p, quotedName(name, " changed binding to global (it is weak)"))
		return false
	}
	if declaredLocal(p, name) {
		setErr(p, quotedName(name, " changed binding to global (.local declared it)"))
		return false
	}
	return true
}

// recordLocal records that `.local` declared name.
func recordLocal(p @Parser, name @[]char) {
	if p.NumLocalNames >= len(p.LocalNames) {
		var names @[]@[]char = make_slice(@[]char, 2 * len(p.LocalNames))
		for j := 0; j < p.NumLocalNames; j++ { names[j] = p.LocalNames[j] }
		p.LocalNames = names
	}
	p.LocalNames[p.NumLocalNames] = name
	p.NumLocalNames = p.NumLocalNames + 1
}

// declaredLocal reports whether `.local` declared name.
func declaredLocal(p @Parser, name *[]readonly char) bool {
	for i := 0; i < p.NumLocalNames; i++ {
		if charsEqual(p.LocalNames[i], name) { return true }
	}
	return false
}
