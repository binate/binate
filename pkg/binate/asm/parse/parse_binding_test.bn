package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Binding changes between `.local`, `.global` / `.global_c` and `.weak`, as clang allows them
// (`clang -c -target aarch64-linux-gnu` and `-target arm64-apple-macos`, `.weak_definition`
// for `.weak` on Mach-O).  (diffSource / diffReject are in expr_diff_test.bn, visCheck in
// parse_visibility_test.bn, goldenFail in aarch64_golden_test.bn.)

// bindAccepted checks that src (after `.arch` / `.section` lines) assembles for format and
// leaves name with binding.
func bindAccepted(e @[]char, src *[]readonly char, format int, name *[]readonly char,
		binding int) @[]char {
	var full @[]char = buf.Concat(".arch aarch64\n.section text\n", src)
	var p @Parser = diffSource(full, format)
	if p.HasError { return goldenFail(e, full, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, full, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	return visCheck(e, p, full, name, binding, asm.VIS_DEFAULT, true)
}

// On ELF `.weak` may follow `.global` or `.local` and makes the symbol weak (clang warns),
// and `.local` may repeat or follow the label's definition; on Mach-O `.global` may follow
// `.weak`, which it stays.  `.weak` after `.global` needs no object format: the symbol is weak
// on both.
func TestBindingChangesAccepted() testing.TestResult {
	var e @[]char = ""
	e = bindAccepted(e, ".global x\n.weak x\nx: nop", asm.OBJ_ELF, "x", asm.BIND_WEAK)
	e = bindAccepted(e, ".local x\n.weak x\nx: nop", asm.OBJ_ELF, "x", asm.BIND_WEAK)
	e = bindAccepted(e, ".local x\n.local x\nx: nop", asm.OBJ_ELF, "x", asm.BIND_LOCAL)
	e = bindAccepted(e, "x: nop\n.local x", asm.OBJ_ELF, "x", asm.BIND_LOCAL)
	e = bindAccepted(e, ".weak _x\n.global _x\n_x: nop", asm.OBJ_MACHO, "_x", asm.BIND_WEAK)
	e = bindAccepted(e, ".weak x\n.global_c x\nx: nop", asm.OBJ_MACHO, "x", asm.BIND_WEAK)
	e = bindAccepted(e, ".global x\n.weak x\nx: nop", asm.OBJ_UNKNOWN, "x", asm.BIND_WEAK)
	return e
}

// On ELF `.local` after `.global` or `.weak`, and `.global` / `.global_c` after `.local` or
// `.weak`, are errors (clang: "x changed binding to STB_LOCAL" / "STB_GLOBAL"); `.local` is
// no Mach-O directive (clang: "unknown directive"); with the object format unknown, `.local`
// and `.global` after `.weak` cannot be checked, so they are errors too.  A trailing token
// after `.local`'s name is an error, as after every directive.
func TestBindingChangesRejected() testing.TestResult {
	var e @[]char = ""
	var pre *[]readonly char = ".arch aarch64\n.section text\n"
	var toLocal *[]readonly char = "changed binding to local"
	var toGlobal *[]readonly char = "changed binding to global"
	e = diffReject(e, buf.Concat(pre, ".global x\n.local x"), asm.OBJ_ELF, toLocal)
	e = diffReject(e, buf.Concat(pre, ".weak x\n.local x"), asm.OBJ_ELF, toLocal)
	e = diffReject(e, buf.Concat(pre, ".global_c x\n.local x"), asm.OBJ_ELF, toLocal)
	e = diffReject(e, buf.Concat(pre, ".local x\n.weak x\n.local x"), asm.OBJ_ELF, toLocal)
	e = diffReject(e, buf.Concat(pre, ".local x\n.global x"), asm.OBJ_ELF, toGlobal)
	e = diffReject(e, buf.Concat(pre, ".local x\n.global_c x"), asm.OBJ_ELF, toGlobal)
	e = diffReject(e, buf.Concat(pre, ".weak x\n.global x"), asm.OBJ_ELF, toGlobal)
	e = diffReject(e, buf.Concat(pre, ".weak x\n.global_c x"), asm.OBJ_ELF, toGlobal)
	e = diffReject(e, buf.Concat(pre, ".local x\n.weak x\n.global x"), asm.OBJ_ELF,
			"changed binding to global (it is weak)")
	e = diffReject(e, buf.Concat(pre, "A = lbl\n.global A\n.local A\nlbl: nop"), asm.OBJ_ELF, toLocal)
	e = diffReject(e, buf.Concat(pre, ".local _x"), asm.OBJ_MACHO, "ELF directive")
	e = diffReject(e, buf.Concat(pre, ".local x"), asm.OBJ_UNKNOWN, "object format")
	e = diffReject(e, buf.Concat(pre, ".weak x\n.global x"), asm.OBJ_UNKNOWN, "object format")
	e = diffReject(e, buf.Concat(pre, ".weak x\n.global_c x"), asm.OBJ_UNKNOWN, "object format")
	e = diffReject(e, buf.Concat(pre, ".local foo bar"), asm.OBJ_ELF, "unexpected token")
	return e
}
