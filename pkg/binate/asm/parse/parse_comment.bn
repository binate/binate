package "pkg/binate/asm/parse"

import "pkg/stdx/slices"

// Line preparation shared by every architecture's text parser: block comments that
// may span lines, a CRLF line ending, the statements of a line, and lexer errors anywhere
// on a line.

// prepareLine returns line ready for lexing: a trailing carriage return (a CRLF line
// ending) dropped, and every character inside a `/* ... */` comment — including one
// opened on an earlier line, tracked in p.InComment — replaced by a space, so the
// comment separates tokens without the lexer ever seeing it.  String and character
// literals are skipped, so a `/*` inside one is not a comment; a `//` line comment — and
// on arm32 an `@` one, ARM's comment character — ends the scan (a `/*` after it is part of
// that comment).  A comment that spans lines
// with statement text both before its `/*` and after its `*/` would be one statement
// to clang (`nop /* ... */ nop` is `nop nop`) but two lines here, so such a closing
// line is marked (p.SplitLine) for the parser to reject — unless the text before the
// comment was only labels, for which parseLine clears p.CommentSplit.  Where a `;` ends a
// statement (semicolonSeparates), the text that counts is the statement's: from the last `;`
// before the `/*`, and up to the first `;` after the `*/` (`nop; /* ... */ nop` and `nop /*
// ... */; nop` are two statements).  Each comment's start is recorded in p.CommentStarts.
func prepareLine(p @Parser, line *[]readonly char) @[]char {
	var n int = len(line)
	if n > 0 && line[n - 1] == '\r' { n = n - 1 }
	var out @[]char = make_slice(char, n)
	var quote char = 0 // the open literal's quote character, or 0 outside one
	var code bool = false // statement text seen on this line so far
	var fromEarlier bool = p.InComment // a comment opened on an earlier line is open
	var afterSplit bool = false // this line closed a comment that interrupted a statement
	var semis bool = semicolonSeparates(p)
	p.SplitLine = false
	var starts @[]int
	if p.InComment { starts = slices.Append[int](starts, 0) }
	var i int = 0
	for i < n {
		var c char = line[i]
		var next char = 0
		if i + 1 < n { next = line[i + 1] }
		if p.InComment {
			if c == '*' && next == '/' {
				p.InComment = false
				if fromEarlier { afterSplit = p.CommentSplit }
				fromEarlier = false
				out[i] = ' '
				out[i + 1] = ' '
				i = i + 2
				continue
			}
			out[i] = ' '
			i = i + 1
			continue
		}
		out[i] = c
		if quote == 0 && c == ';' && semis {
			// A new statement: no text of it seen yet, and none of it continues a comment.
			code = false
			afterSplit = false
			i = i + 1
			continue
		}
		if c != ' ' && c != '\t' && !(c == '/' && (next == '/' || next == '*')) {
			code = true
			if afterSplit { p.SplitLine = true }
		}
		if quote != 0 {
			if c == '\\' && i + 1 < n {
				out[i + 1] = next
				i = i + 2
				continue
			}
			if c == quote { quote = 0 }
			i = i + 1
			continue
		}
		if c == '"' || c == '\'' {
			quote = c
		} else if c == '/' && next == '/' {
			for j := i + 1; j < n; j++ { out[j] = line[j] }
			p.CommentStarts = starts
			return out
		} else if c == '@' && p.Arch == ARCH_ARM32 {
			// `@` starts a line comment in ARM assembly (`mov r0, r1 @ copy`), as `//` does.
			for j := i; j < n; j++ { out[j] = ' ' }
			p.CommentStarts = starts
			return out
		} else if c == '/' && next == '*' {
			p.InComment = true
			starts = slices.Append[int](starts, i)
			// A split still pending from an earlier line carries on through this comment.
			p.CommentSplit = code || afterSplit
			out[i] = ' '
			out[i + 1] = ' '
			i = i + 2
			continue
		}
		i = i + 1
	}
	p.CommentStarts = starts
	return out
}

// semicolonSeparates reports whether a `;` separates statements on p's architecture: on
// arm32 and x86-64, where clang takes it between statements (`nop; bx lr`, `l: nop; b l`),
// and before an architecture is known — clang always has one, and an `.arch` naming it can
// start the line (`.arch armv7-a; nop`).  AArch64 takes no `;`: clang reads it as a separator
// on ELF and as a comment on Mach-O, so the same text would mean two things, and the lexer
// rejects it.
func semicolonSeparates(p @Parser) bool {
	return p.Arch == ARCH_ARM32 || p.Arch == ARCH_X64 || p.Arch == ARCH_UNKNOWN
}

// statementEnd returns where the statement of the prepared line starting at from ends, and
// whether it is the line's last: at the first `;` outside a string or character literal and
// before a `//` comment where a `;` separates statements (semicolonSeparates), else at the
// line's end — or, on arm32, at an `@` comment (prepareLine's, for a line an earlier statement
// made arm32).  ParseLine asks once the statements before it are parsed, so an `.arch` among
// them decides (`.arch armv7-a; nop @ c`).
func statementEnd(p @Parser, line *[]readonly char, from int) (int, bool) {
	if !semicolonSeparates(p) { return len(line), true }
	var quote char = 0
	for i := from; i < len(line); i++ {
		var c char = line[i]
		if quote != 0 {
			if c == '\\' {
				i = i + 1
			} else if c == quote {
				quote = 0
			}
			continue
		}
		if c == '"' || c == '\'' {
			quote = c
		} else if c == '/' && i + 1 < len(line) && line[i + 1] == '/' {
			return len(line), true
		} else if c == '@' && p.Arch == ARCH_ARM32 {
			return i, true
		} else if c == ';' {
			return i, false
		}
	}
	return len(line), true
}

// commentInStatement returns where in the statement from start to end of the current line its
// last `/* ... */` comment begins (p.CommentStarts), or -1 for none.
func commentInStatement(p @Parser, start int, end int) int {
	var at int = -1
	for i := 0; i < len(p.CommentStarts); i++ {
		var c int = p.CommentStarts[i]
		if c >= start && c < end { at = c - start }
	}
	return at
}

// beforeArchArmComment returns the statement line, or, with no architecture yet, an `.arch`
// statement's text — labels before it included — before an `@`: an ARM name names the
// architecture that makes the rest ARM's comment (parseArchDirective), which no token is lexed
// from, as clang lexes none.
func beforeArchArmComment(p @Parser, line *[]readonly char) *[]readonly char {
	if p.Arch != ARCH_UNKNOWN { return line }
	var i int = 0
	for {
		for i < len(line) && isSpace(line[i]) { i = i + 1 }
		var j int = i
		for j < len(line) && isNameChar(line[j]) { j = j + 1 }
		if j == i || j >= len(line) || line[j] != ':' { break }
		i = j + 1
	}
	var d *[]readonly char = ".arch"
	if len(line) - i < len(d) || !charsEqual(line[i:i + len(d)], d) { return line }
	for k := i + len(d); k < len(line); k++ {
		if line[k] == '@' { return line[:k] }
	}
	return line
}

// firstLexError returns the diagnostic of the first malformed token on line (an
// unterminated string, a bad escape, an out-of-range literal, a stray character),
// or an empty slice when the whole line lexes cleanly.  Every parser rejects such a
// line with this message, whatever the architecture's operand syntax.
func firstLexError(line *[]readonly char, lineNum int) @[]char {
	var l Lexer = NewLexer(line, lineNum)
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF {
		if tok.Kind == TOK_ERROR { return tok.Text }
		l, tok = LexNext(l)
	}
	var none @[]char
	return none
}
