package "pkg/binate/asm/parse"

// Line preparation shared by every architecture's text parser: block comments that
// may span lines, a CRLF line ending, and lexer errors anywhere on a line.

// prepareLine returns line ready for lexing: a trailing carriage return (a CRLF line
// ending) dropped, and every character inside a `/* ... */` comment — including one
// opened on an earlier line, tracked in p.InComment — replaced by a space, so the
// comment separates tokens without the lexer ever seeing it.  String and character
// literals are skipped, so a `/*` inside one is not a comment; a `//` line comment — and
// on arm32 an `@` one, ARM's comment character — ends the scan (a `/*` after it is part of
// that comment).  A comment that spans lines
// with statement text both before its `/*` and after its `*/` would be one statement
// to clang (`nop /* ... */ nop` is `nop nop`) but two lines here, so such a closing
// line is marked (p.SplitLine) for the parser to reject — unless the text before the
// comment was only labels, for which parseLine clears p.CommentSplit.
func prepareLine(p @Parser, line *[]readonly char) @[]char {
	var n int = len(line)
	if n > 0 && line[n - 1] == '\r' { n = n - 1 }
	var out @[]char = make_slice(char, n)
	var quote char = 0 // the open literal's quote character, or 0 outside one
	var code bool = false // statement text seen on this line so far
	var fromEarlier bool = p.InComment // a comment opened on an earlier line is open
	var afterSplit bool = false // this line closed a comment that interrupted a statement
	p.SplitLine = false
	var i int = 0
	for i < n {
		var c char = line[i]
		var next char = 0
		if i + 1 < n { next = line[i + 1] }
		if p.InComment {
			if c == '*' && next == '/' {
				p.InComment = false
				if fromEarlier { afterSplit = p.CommentSplit }
				fromEarlier = false
				out[i] = ' '
				out[i + 1] = ' '
				i = i + 2
				continue
			}
			out[i] = ' '
			i = i + 1
			continue
		}
		out[i] = c
		if c != ' ' && c != '\t' && !(c == '/' && (next == '/' || next == '*')) {
			code = true
			if afterSplit { p.SplitLine = true }
		}
		if quote != 0 {
			if c == '\\' && i + 1 < n {
				out[i + 1] = next
				i = i + 2
				continue
			}
			if c == quote { quote = 0 }
			i = i + 1
			continue
		}
		if c == '"' || c == '\'' {
			quote = c
		} else if c == '/' && next == '/' {
			for j := i + 1; j < n; j++ { out[j] = line[j] }
			return out
		} else if c == '@' && p.Arch == ARCH_ARM32 {
			// `@` starts a line comment in ARM assembly (`mov r0, r1 @ copy`), as `//` does.
			for j := i; j < n; j++ { out[j] = ' ' }
			return out
		} else if c == '/' && next == '*' {
			p.InComment = true
			// A split still pending from an earlier line carries on through this comment.
			p.CommentSplit = code || afterSplit
			out[i] = ' '
			out[i + 1] = ' '
			i = i + 2
			continue
		}
		i = i + 1
	}
	return out
}

// firstLexError returns the diagnostic of the first malformed token on line (an
// unterminated string, a bad escape, an out-of-range literal, a stray character),
// or an empty slice when the whole line lexes cleanly.  Every parser rejects such a
// line with this message, whatever the architecture's operand syntax.
func firstLexError(line *[]readonly char, lineNum int) @[]char {
	var l Lexer = NewLexer(line, lineNum)
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF {
		if tok.Kind == TOK_ERROR { return tok.Text }
		l, tok = LexNext(l)
	}
	var none @[]char
	return none
}
