package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// Line preparation (prepareLine, firstLexError) and what it means for whole lines:
// block comments spanning lines on every architecture, CRLF line endings, and a
// malformed token failing its line.  (plA64 / plRejectAt3 / plContains are in
// parse_line_test.bn.)

// prepareLine blanks comment text to spaces — keeping every other character, and
// the columns — tracks a comment left open, leaves a `/*` inside a string or
// character literal alone, stops at a `//` line comment, and drops a trailing CR.
func TestPrepareLine() testing.TestResult {
	var p @Parser = newTestParser()
	var out @[]char = prepareLine(p, "a /* b */ c")
	if !charsEqual(out, "a         c") { return fail(buf.Concat("blanked: ", out)) }
	out = prepareLine(p, "x /* open")
	if !charsEqual(out, "x        ") || !p.InComment { return fail("an open comment") }
	out = prepareLine(p, "still */ y")
	if !charsEqual(out, "         y") || p.InComment { return fail("closing a comment") }
	out = prepareLine(p, ".ascii \"/*\", '/' // /* not opened")
	if p.InComment || !charsEqual(out, ".ascii \"/*\", '/' // /* not opened") {
		return fail("a string, a char literal and a line comment are not comments' openers")
	}
	out = prepareLine(p, ".ascii \"\\\"/*\"")
	if p.InComment { return fail("an escaped quote does not end the string") }
	out = prepareLine(p, "nop\r")
	if !charsEqual(out, "nop") { return fail("a trailing CR must be dropped") }
	return ""
}

// firstLexError reports the first malformed token's diagnostic, or nothing for a
// clean line.
func TestFirstLexError() testing.TestResult {
	if len(firstLexError("add x0, x1, #3 // c", 1)) != 0 { return fail("a clean line") }
	if len(firstLexError("add x0, x1, #0x", 1)) == 0 { return fail("a radix prefix with no digits") }
	if len(firstLexError(".ascii \"abc", 1)) == 0 { return fail("an unterminated string") }
	return ""
}

// A block comment may span lines (as in clang): everything from `/*` to the next `*/`,
// on this line or a later one, is not assembled — including a `//` or an instruction
// inside it — and a `/*` inside a string literal opens nothing.
func TestParseLineBlockCommentSpansLines() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("nop /* start")
	p.ParseLine("mov x0, x1 // inside the comment")
	p.ParseLine("still inside */ // then a line comment")
	p.ParseLine("/* a */ nop /* b")
	p.ParseLine("*/")
	p.ParseLine("/* opened with no statement before it")
	p.ParseLine("*/ nop")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.InComment { return fail("comment still open after its */") }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 12 { return fail("expected exactly three NOPs") }
	for off := 0; off < 12; off = off + 4 {
		if readInst(s, off) != 0xD503201F { return fail("expected NOP") }
	}
	var q @Parser = plA64()
	q.ParseLine(".ascii \"a/*b\"")
	q.ParseLine("nop")
	if q.HasError { return fail(q.ErrorMsg) }
	if q.InComment || q.Asm.Sections[0].Len != 8 { return fail("/* in a string opened a comment") }
	return ""
}

// A comment that spans lines with statement text both before its `/*` and after its
// `*/` is rejected on its closing line: clang would join the two into one statement
// (`nop /* ... */ nop` is `nop nop`, an error), where this line-based parser would
// assemble two.  The line that opened it is assembled; nothing of the closing line is.
// The split carries through a second comment that spans lines, and on every
// architecture.
func TestParseLineBlockCommentSplitsStatement() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("nop /* start")
	p.ParseLine("still inside")
	if p.HasError || p.Asm.Sections[0].Len != 4 { return fail("the opening line assembles its NOP") }
	var r testing.TestResult = lineRejected(p, "*/ nop")
	if len(r) > 0 { return r }
	if !plContains(p.ErrorMsg, "test.s:5:") { return fail(buf.Concat("error line: ", p.ErrorMsg)) }
	var q @Parser = plA64()
	q.ParseLine("nop /* a */ /* b")
	if q.HasError { return fail(q.ErrorMsg) }
	r = lineRejected(q, "*/ mov x0, x1")
	if len(r) > 0 { return r }
	var t @Parser = plA64()
	t.ParseLine(".ascii \"x\" /* c")
	if t.HasError { return fail(t.ErrorMsg) }
	r = lineRejected(t, "*/ .ascii \"y\"")
	if len(r) > 0 { return r }
	var u @Parser = plA64()
	u.ParseLine("nop /* a")
	u.ParseLine("*/ /* b")
	if u.HasError { return fail(u.ErrorMsg) }
	r = lineRejected(u, "*/ nop")
	if len(r) > 0 { return r }
	var x @Parser = newTestParser()
	x.ParseLine(".arch x64")
	x.ParseLine(".section text")
	x.ParseLine("ret /* a")
	if x.HasError { return fail(x.ErrorMsg) }
	return lineRejected(x, "*/ ret")
}

// Only labels before a comment that spans lines interrupt no statement: `lbl: /* ... */
// nop` is `lbl: nop` to clang, and the label and the NOP on the next line here — also
// through a second comment.
func TestParseLineBlockCommentAfterLabels() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("Lbl: Lbl2: /* a")
	p.ParseLine("*/ /* b")
	p.ParseLine("*/ nop")
	p.ParseLine("b Lbl")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 8 || readInst(s, 0) != 0xD503201F { return fail("expected the NOP, then b Lbl") }
	return ""
}

// The x64 and arm32 parsers see the same comment handling: a multi-line comment's
// lines are not assembled (clang: `xor eax, eax /* ...` over lines up to `*/`, then
// `ret` on the next line, is 31 C0 C3).
func TestParseLineBlockCommentX64() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch x64")
	p.ParseLine(".section text")
	p.ParseLine("xor eax, eax /* disabled:")
	p.ParseLine("mov eax, ecx")
	p.ParseLine("syscall */")
	p.ParseLine("ret")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 3 || s.Data[0] != 0x31 || s.Data[1] != 0xC0 || s.Data[2] != 0xC3 {
		return fail("expected 31 C0 C3")
	}
	return ""
}

// A block comment still open at the end of the file is an error (clang:
// "unterminated comment").
func TestParseFileUnterminatedComment() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var path @[]char = buf.Concat(dir, "/parse_unterminated_comment.s")
	f, err := os.Create(path)
	if present(err) { return fail("cannot create the test file") }
	_, _ = f.Write(".section text\nnop /* never closed\nnop\n")
	_ = f.Close()
	var p @Parser = newTestParser()
	p.Arch = ARCH_AARCH64
	p.ParseFile(path)
	if !p.HasError { return fail("an unterminated comment was accepted") }
	if !plContains(p.ErrorMsg, "unterminated") { return fail(p.ErrorMsg) }
	return ""
}

// A CRLF line ending is a line ending (the carriage return is not a token), and a
// directive name must follow its '.' directly (`. uint8` is an error, as in clang).
func TestParseLineCrlfAndDirectiveDot() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("nop\r")
	p.ParseLine("La: nop // c\r")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.Sections[0].Len != 8 { return fail("expected two NOPs") }
	var e @[]char = ""
	e = plRejectAt3(e, ". uint8 3")
	e = plRejectAt3(e, "La: . uint8 3")
	return e
}

// A malformed token anywhere on a line fails the line with the lexer's own diagnostic,
// whatever the architecture — the x64 and arm32 parsers included, which would
// otherwise stop reading at an operand they do not expect.
func TestParseLineLexErrorIsFatal() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine(".ascii \"\\q\"")
	if !p.HasError || !plContains(p.ErrorMsg, "escape") { return fail(p.ErrorMsg) }
	var x @Parser = newTestParser()
	x.ParseLine(".arch x64")
	x.ParseLine(".section text")
	x.ParseLine("mov eax, 1 \"unterminated")
	if !x.HasError { return fail("x64: an unterminated string was accepted") }
	var r @Parser = newTestParser()
	r.ParseLine(".arch arm32")
	r.ParseLine(".section text")
	r.ParseLine("mov r0, #1 0x")
	if !r.HasError { return fail("arm32: a radix prefix without digits was accepted") }
	return ""
}

// A character no token starts with (`;`, `?`, a backquote) fails its line with a
// message naming it, on every architecture: x64 and arm32 used to stop reading at it
// and silently drop the rest (`xor eax, eax ; ret` assembled without the `ret`).
func TestParseLineStrayCharacterIsFatal() testing.TestResult {
	var x @Parser = newTestParser()
	x.ParseLine(".arch x64")
	x.ParseLine(".section text")
	x.ParseLine("xor eax, eax ; ret")
	if !x.HasError || !plContains(x.ErrorMsg, "unexpected character ';'") { return fail(x.ErrorMsg) }
	var r @Parser = newTestParser()
	r.ParseLine(".arch arm32")
	r.ParseLine(".section text")
	r.ParseLine("add r0, r1, r2 ?")
	if !r.HasError || !plContains(r.ErrorMsg, "unexpected character '?'") { return fail(r.ErrorMsg) }
	var e @[]char = ""
	e = plRejectAt3(e, "nop `")
	return e
}
