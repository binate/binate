package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Common symbols: `.comm name, size[, align]` and `.lcomm name, size[, align]`, as clang reads
// them.

// parseCommonDirective handles `.comm` and, when local is set, `.lcomm`.  `.comm` declares a
// common (asm.Assembler.DefineCommon); `.lcomm`, and `.comm` of a name `.local` declared, define
// a local common in bss (DefineLocalCommon), as large as `.zero` allows.  An ELF `.lcomm`
// binds the name local as `.local` does, so `.global` may not follow it, nor may it follow
// `.global` or `.weak` (where clang makes the symbol local); on Mach-O a `.global` or
// `.private_extern` before or after it makes the zero-filled object global.  The alignment is
// a byte count for an ELF `.comm`, an exponent of two for Mach-O's `.comm` and `.lcomm`; an ELF
// `.lcomm` takes none (clang: "alignment not supported on this target").  It defaults to one
// byte, and since its meaning depends on the object format, an alignment (and `.lcomm`, whose
// binding does too) needs the format known.  A constant's name cannot be a common, where clang
// drops the constant.
func parseCommonDirective(p @Parser, l Lexer, local bool) (Lexer, Token) {
	var tok Token
	if local && !commonFormatKnown(p) { return l, tok }
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) {
		setErr(p, "expected symbol name")
		return l, tok
	}
	var name @[]char = buf.CopyStr(tok.Text)
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' and the common's size")
		return l, tok
	}
	l, tok = LexNext(l)
	var size int64 = 0
	var ok bool = false
	l, tok, size, ok = parseSizingExpr(p, l, tok, "expected the common's size")
	if !ok { return l, tok }
	var align int64 = 1
	if tok.Kind == TOK_COMMA {
		if !commonFormatKnown(p) { return l, tok }
		var macho bool = p.Asm.ObjFormat == asm.OBJ_MACHO
		if local && !macho {
			setErr(p, "an ELF .lcomm takes no alignment")
			return l, tok
		}
		l, tok = LexNext(l)
		l, tok, align, ok = parseSizingExpr(p, l, tok, "expected the common's alignment")
		if !ok { return l, tok }
		if macho {
			if align < 0 || align > 62 {
				setErr(p, "a Mach-O common's alignment is an exponent of two, from 0 to 62")
				return l, tok
			}
			align = cast(int64, 1) << cast(uint64, align)
		}
	}
	if constIndex(p, name) >= 0 {
		setErr(p, quotedName(name, " is a constant; it cannot be a common"))
		return l, tok
	}
	if !local && !declaredLocal(p, name) {
		p.Asm.DefineCommon(name, size, align)
		if !p.Asm.HasError { dropSymAttrs(p, name) }
		return l, tok
	}
	// A local common's bytes are held in bss, so it is bounded as `.zero` and `.balign` are.
	if size > maxDirectiveBytes || align > maxDirectiveBytes {
		setErr(p, "a local common's size or alignment is out of range")
		return l, tok
	}
	var elf bool = p.Asm.ObjFormat == asm.OBJ_ELF
	// A name `.global` or `.weak` declared (and nothing defined) may not become an ELF local
	// common; a defined one is DefineLocalCommon's error.
	var si int = p.Asm.LookupSymbol(name)
	if local && elf && si >= 0 && p.Asm.Symbols[si].Binding != asm.BIND_LOCAL &&
			p.Asm.Symbols[si].Section < 0 && !p.Asm.Symbols[si].Abs && !p.Asm.Symbols[si].Common {
		setErr(p, quotedName(name, " changed binding to local (it is global or weak)"))
		return l, tok
	}
	p.Asm.DefineLocalCommon(name, size, align)
	if p.Asm.HasError { return l, tok }
	dropSymAttrs(p, name)
	if local && elf && !declaredLocal(p, name) { recordLocal(p, name) }
	// The label starts a Mach-O atom, as a source label does, so a difference between two
	// local commons is a relocation, not a number.
	var bss int = p.Asm.Symbols[p.Asm.LookupSymbol(name)].Section
	notePoolAtom(p, name, bss)
	noteLabelGen(p, name, bss)
	return l, tok
}

// commonFormatKnown reports whether the object format is known, else sets the error.
func commonFormatKnown(p @Parser) bool {
	if p.Asm.ObjFormat != asm.OBJ_UNKNOWN { return true }
	setErr(p, ".lcomm, and a common's alignment, need the object format, not yet known here")
	return false
}
