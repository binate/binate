package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// `.comm` and `.lcomm` against clang's symbol tables (`clang -c -target aarch64-linux-gnu` and
// `-target arm64-apple-macos`; llvm-readelf -s / llvm-readobj --symbols).  (diffSource /
// diffReject are in expr_diff_test.bn, goldenFail in aarch64_golden_test.bn.)

// commonSrc assembles src after `.arch` / `.section` lines for format, failing e when it is
// rejected.
func commonSrc(e @[]char, src *[]readonly char, format int) (@[]char, @Parser, bool) {
	var full @[]char = buf.Concat(".arch aarch64\n.section text\n", src)
	var p @Parser = diffSource(full, format)
	if p.HasError { return goldenFail(e, full, buf.Concat("rejected: ", p.ErrorMsg)), p, false }
	if p.Asm.HasError {
		return goldenFail(e, full, buf.Concat("rejected: ", p.Asm.ErrorMsg)), p, false
	}
	return e, p, true
}

// isCommon reports whether p holds name as a common of size bytes aligned to align with binding
// and visibility vis.
func isCommon(p @Parser, name *[]readonly char, size int64, align int64, binding int,
		vis int) bool {
	var i int = p.Asm.LookupSymbol(name)
	if i < 0 { return false }
	var s asm.Symbol = p.Asm.Symbols[i]
	return s.Common && s.Size == size && s.CommonAlign == align && s.Binding == binding &&
			s.Visibility == vis && s.Section == -1
}

// isLocalCommon reports whether p holds name as a data object of size bytes at offset in bss,
// with binding.
func isLocalCommon(p @Parser, name *[]readonly char, offset uint, size int64, binding int) bool {
	var i int = p.Asm.LookupSymbol(name)
	if i < 0 { return false }
	var s asm.Symbol = p.Asm.Symbols[i]
	return !s.Common && s.Object && s.Section >= 0 &&
			charsEqual(p.Asm.Sections[s.Section].Name, "bss") && s.Offset == offset && s.Size == size &&
			s.Binding == binding
}

// ELF: `.comm` takes a byte alignment (1 when none is given) and keeps a binding or
// visibility given before or after; `.lcomm`, and `.comm` of a name `.local` declared, are
// local objects in bss (1-aligned for `.lcomm`); a reference to a common relocates against it.
func TestElfCommonDirectives() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".comm ca, 4, 4\n.comm cb, 100\n.lcomm la, 4\n.lcomm lb, 12\n"
			".local lo\n.comm lo, 24, 8\n.hidden ch\n.comm ch, 4, 4\n.weak cw\n.comm cw, 4, 4\n"
			".global cg\n.comm cg, 2, 2\n.comm ca, 4, 4\n.comm cz, 0\n.comm cv, 8, 8\n.weak cv\n"
			".section data\n.uint64 ca\n.uint64 la"
	e, p, ok := commonSrc(e, src, asm.OBJ_ELF)
	if !ok { return e }
	if !isCommon(p, "ca", 4, 4, asm.BIND_GLOBAL, asm.VIS_DEFAULT) { e = goldenFail(e, src, "ca") }
	if !isCommon(p, "cb", 100, 1, asm.BIND_GLOBAL, asm.VIS_DEFAULT) { e = goldenFail(e, src, "cb") }
	if !isCommon(p, "ch", 4, 4, asm.BIND_GLOBAL, asm.VIS_HIDDEN) { e = goldenFail(e, src, "ch") }
	if !isCommon(p, "cw", 4, 4, asm.BIND_WEAK, asm.VIS_DEFAULT) { e = goldenFail(e, src, "cw") }
	if !isCommon(p, "cg", 2, 2, asm.BIND_GLOBAL, asm.VIS_DEFAULT) { e = goldenFail(e, src, "cg") }
	if !isCommon(p, "cz", 0, 1, asm.BIND_GLOBAL, asm.VIS_DEFAULT) { e = goldenFail(e, src, "cz") }
	if !isCommon(p, "cv", 8, 8, asm.BIND_WEAK, asm.VIS_DEFAULT) { e = goldenFail(e, src, "cv") }
	if !isLocalCommon(p, "la", cast(uint, 0), 4, asm.BIND_LOCAL) { e = goldenFail(e, src, "la") }
	if !isLocalCommon(p, "lb", cast(uint, 4), 12, asm.BIND_LOCAL) { e = goldenFail(e, src, "lb") }
	if !isLocalCommon(p, "lo", cast(uint, 16), 24, asm.BIND_LOCAL) { e = goldenFail(e, src, "lo") }
	if p.Asm.NumRelocs != 2 || p.Asm.Relocs[0].Symbol != p.Asm.LookupSymbol("ca") {
		e = goldenFail(e, src, "no relocation against the common ca")
	}
	return e
}

// Mach-O: `.comm` and `.lcomm` take an exponent of two; `.private_extern` and `.weak` apply to a
// common; `.global` or `.private_extern` before or after `.lcomm` makes the bss object global.
func TestMachoCommonDirectives() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".comm _ca, 4, 2\n.comm _cb, 100\n.lcomm _la, 4\n.lcomm _lb, 12, 3\n"
			".private_extern _ch\n.comm _ch, 4, 2\n.weak _cw\n.comm _cw, 4\n.lcomm _lg, 4\n"
			".global _lg\n.global _lh\n.lcomm _lh, 4\n.private_extern _lp\n.lcomm _lp, 4, 2"
	e, p, ok := commonSrc(e, src, asm.OBJ_MACHO)
	if !ok { return e }
	if !isCommon(p, "_ca", 4, 4, asm.BIND_GLOBAL, asm.VIS_DEFAULT) { e = goldenFail(e, src, "_ca") }
	if !isCommon(p, "_cb", 100, 1, asm.BIND_GLOBAL, asm.VIS_DEFAULT) { e = goldenFail(e, src, "_cb") }
	if !isCommon(p, "_ch", 4, 4, asm.BIND_GLOBAL, asm.VIS_HIDDEN) { e = goldenFail(e, src, "_ch") }
	if !isCommon(p, "_cw", 4, 1, asm.BIND_WEAK, asm.VIS_DEFAULT) { e = goldenFail(e, src, "_cw") }
	if !isLocalCommon(p, "_la", cast(uint, 0), 4, asm.BIND_LOCAL) { e = goldenFail(e, src, "_la") }
	if !isLocalCommon(p, "_lb", cast(uint, 8), 12, asm.BIND_LOCAL) { e = goldenFail(e, src, "_lb") }
	if !isLocalCommon(p, "_lg", cast(uint, 20), 4, asm.BIND_GLOBAL) { e = goldenFail(e, src, "_lg") }
	if !isLocalCommon(p, "_lh", cast(uint, 24), 4, asm.BIND_GLOBAL) { e = goldenFail(e, src, "_lh") }
	if !isLocalCommon(p, "_lp", cast(uint, 28), 4, asm.BIND_GLOBAL) { e = goldenFail(e, src, "_lp") }
	var lp int = p.Asm.LookupSymbol("_lp")
	if lp < 0 || p.Asm.Symbols[lp].Visibility != asm.VIS_HIDDEN {
		e = goldenFail(e, src, "_lp not hidden")
	}
	return e
}

// On Mach-O each local common starts an atom, as a source label does, so the distance between
// two is a SUBTRACTOR relocation pair, as clang writes it — whether the difference comes before
// or after the labels (a second pass reads the first pass's atom counts).
func TestMachoLocalCommonDifference() testing.TestResult {
	var e @[]char = ""
	var srcs @[]@[]char = @[]@[]char{
			buf.CopyStr(".lcomm _la, 4\n.lcomm _lb, 12, 3\n.section data\n.uint64 _lb - _la"),
			buf.CopyStr(".section data\n.uint64 _lb - _la\n.lcomm _la, 4\n.lcomm _lb, 12, 3")}
	for i := 0; i < len(srcs); i++ {
		ne, p, ok := commonSrc(e, srcs[i], asm.OBJ_MACHO)
		e = ne
		if !ok { continue }
		if p.Asm.NumRelocs != 1 || !p.Asm.Relocs[0].HasSub ||
				p.Asm.Relocs[0].Symbol != p.Asm.LookupSymbol("_lb") ||
				p.Asm.Relocs[0].SubSymbol != p.Asm.LookupSymbol("_la") {
			e = goldenFail(e, srcs[i], "not a relocation pair _lb - _la")
		}
	}
	return e
}

// An alias of a local common is a data object of its size, as clang gives it the common's
// type and size; `.lcomm` before any `.section` leaves no section current.
func TestLocalCommonAliasAndNoSection() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".lcomm la, 12\n.global ya\nya = la + 4\nyl = la"
	e, p, ok := commonSrc(e, src, asm.OBJ_ELF)
	if !ok { return e }
	var names @[]@[]char = @[]@[]char{buf.CopyStr("ya"), buf.CopyStr("yl")}
	for i := 0; i < len(names); i++ {
		var si int = p.Asm.LookupSymbol(names[i])
		if si < 0 || !p.Asm.Symbols[si].Object || p.Asm.Symbols[si].Size != 12 {
			e = goldenFail(e, src, buf.Concat("not a 12-byte data object: ", names[i]))
		}
	}
	var first *[]readonly char = ".arch aarch64\n.lcomm la, 4\n.uint8 1"
	var q @Parser = diffSource(first, asm.OBJ_ELF)
	if !q.HasError && !q.Asm.HasError { e = goldenFail(e, first, "data with no section accepted") }
	var later *[]readonly char = ".arch aarch64\n.lcomm la, 4\n.section text\nnop"
	var r @Parser = diffSource(later, asm.OBJ_ELF)
	if r.HasError || r.Asm.HasError || r.Asm.LookupSymbol("la") < 0 {
		e = goldenFail(e, later, "`.lcomm` before any `.section` rejected")
	}
	return e
}

// clang's errors — an ELF alignment that is not a power of two, a negative size, an ELF common
// declared again with another size or alignment, a defined name, `.lcomm` twice or after
// `.comm`'s name made local, `.local` after `.comm`, `.global` after an ELF `.lcomm`, an ELF
// `.lcomm` alignment, a missing size or name — are errors here too.  So are clang's quirks: a
// label after `.comm` (clang makes the common an ordinary label), `.lcomm` after `.comm`
// (clang drops the common), a constant's name (clang drops the constant), a Mach-O common
// declared again with another size (clang keeps the last), an ELF `.lcomm` of a global or
// weak name (clang makes it local), and a Mach-O exponent out of range.  A local common is as
// large as `.zero` allows, and `.lcomm`, and an alignment, need the object format.
func TestCommonDirectivesRejected() testing.TestResult {
	var e @[]char = ""
	var pre *[]readonly char = ".arch aarch64\n.section text\n"
	var elf int = asm.OBJ_ELF
	e = diffReject(e, buf.Concat(pre, ".comm x, 4, 3"), elf, "power of two")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4, 0"), elf, "power of two")
	e = diffReject(e, buf.Concat(pre, ".comm x, -1"), elf, "negative size")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4, 4\n.comm x, 8, 4"), elf, "another size")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4, 4\n.comm x, 4, 8"), elf, "another size")
	e = diffReject(e, buf.Concat(pre, "x: nop\n.comm x, 4"), elf, "already defined")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4\nx: nop"), elf, "is a common")
	e = diffReject(e, buf.Concat(pre, ".lcomm x, 4\n.lcomm x, 4"), elf, "already defined")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4\n.lcomm x, 4"), elf, "already defined")
	e = diffReject(e, buf.Concat(pre, ".lcomm x, 4\n.comm x, 4"), elf, "already defined")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4\n.local x"), elf, "changed binding to local")
	e = diffReject(e, buf.Concat(pre, ".lcomm x, 4\n.global x"), elf, "changed binding to global")
	e = diffReject(e, buf.Concat(pre, ".global x\n.lcomm x, 4"), elf, "changed binding to local")
	e = diffReject(e, buf.Concat(pre, ".weak x\n.lcomm x, 4"), elf, "changed binding to local")
	e = diffReject(e, buf.Concat(pre, ".comm _x, 4, 2\n.comm _x, 8, 3"), asm.OBJ_MACHO, "another size")
	e = diffReject(e, buf.Concat(pre, ".lcomm buf, 0x80000000"), elf, "out of range")
	e = diffReject(e, buf.Concat(pre, ".lcomm _b, 4, 62"), asm.OBJ_MACHO, "out of range")
	e = diffReject(e, buf.Concat(pre, ".local x\n.comm x, 4, 0x10000000000"), elf, "out of range")
	e = diffReject(e, buf.Concat(pre, ".lcomm x, 4, 8"), elf, "takes no alignment")
	e = diffReject(e, buf.Concat(pre, "x = 5\n.comm x, 4"), elf, "is a constant")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4\nx = 5"), elf, "is a common")
	e = diffReject(e, buf.Concat(pre, ".comm x"), elf, "size")
	e = diffReject(e, buf.Concat(pre, ".comm"), elf, "expected symbol name")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4, 4 4"), elf, "unexpected token")
	e = diffReject(e, buf.Concat(pre, ".comm _x, 4, -1"), asm.OBJ_MACHO, "exponent of two")
	e = diffReject(e, buf.Concat(pre, ".comm _x, 4, 63"), asm.OBJ_MACHO, "exponent of two")
	e = diffReject(e, buf.Concat(pre, ".lcomm x, 4"), asm.OBJ_UNKNOWN, "object format")
	e = diffReject(e, buf.Concat(pre, ".comm x, 4, 4"), asm.OBJ_UNKNOWN, "object format")
	return e
}
