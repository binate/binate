package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/stdx/slices"

// The constant table: `name = expr` definitions — numbers and aliases (a symbol plus a
// number) — their rules against labels and symbols, and their entries in the object's
// symbol table.

// constIndex returns the index of the constant named name in p's table, or -1.
func constIndex(p @Parser, name *[]readonly char) int {
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstNames[i], name) { return i }
	}
	return -1
}

// nameBound reports whether `.global`, `.weak` or `.global_c` has declared name, which no
// label defines.
func nameBound(p @Parser, name *[]readonly char) bool {
	var si int = p.Asm.LookupSymbol(name)
	return si >= 0 && p.Asm.Symbols[si].Section < 0 && p.Asm.Symbols[si].Binding != asm.BIND_LOCAL
}

// lookupConst returns (value, true) for the number constant named name, and (0, false) when
// name is no constant or an alias (whose ConstVals entry is its addend, not a value).
func lookupConst(p @Parser, name *[]readonly char) (int64, bool) {
	var i int = constIndex(p, name)
	if i < 0 || len(p.ConstSyms[i]) > 0 { return 0, false }
	return p.ConstVals[i], true
}

// defineConst gives the constant name the value val — added to symbol sym for an alias,
// a number when sym is empty: a new constant, or a new value for an existing one (each
// use sees the value defined last before it, as in clang: a local alias's uses so far keep
// its old definition, hideAliasUses).  A name already defined as a label, or used as a
// symbol on an earlier line, cannot become a constant, and a global or weak alias used since
// its definition cannot be redefined: its uses go through its symbol, which can have one
// value only (clang lists two symbols of the name).  The name is copied.
func defineConst(p @Parser, name *[]readonly char, val int64, sym *[]readonly char) {
	if isEquiv(p, name) {
		setErr(p, quotedName(name, " was defined by .equiv; it cannot be redefined"))
		return
	}
	var i int = constIndex(p, name)
	if i >= 0 && len(p.ConstSyms[i]) > 0 && p.ConstUsed[i] && nameBound(p, name) {
		setErr(p,
				quotedName(name,
						" is a global or weak alias used since its definition; it cannot be redefined"))
		return
	}
	if i >= 0 {
		if len(p.ConstSyms[i]) > 0 {
			hideAliasUses(p, i)
			if p.HasError { return }
		}
		p.ConstVals[i] = val
		p.ConstSyms[i] = buf.CopyStr(sym)
		p.ConstVia[i] = ""
		p.ConstLines[i] = p.LineNum
		p.ConstUsed[i] = false
		p.ConstPending[i] = false
		p.ConstFromDiff[i] = false
		return
	}
	var si int = p.Asm.LookupSymbol(name)
	if si >= 0 && p.Asm.Symbols[si].Section >= 0 {
		setErr(p, quotedName(name, " is a label; it cannot be redefined as a constant"))
		return
	}
	if si >= 0 && p.Asm.Symbols[si].Common {
		setErr(p, quotedName(name, " is a common; it cannot be redefined as a constant"))
		return
	}
	if usedAsSymbol(p, name) {
		setErr(p,
				quotedName(name, " was used as a symbol earlier; a constant must be defined before use"))
		return
	}
	if p.NumConsts >= len(p.ConstNames) {
		var n int = 2 * len(p.ConstNames)
		var names @[]@[]char = make_slice(@[]char, n)
		var vals @[]int64 = make_slice(int64, n)
		var syms @[]@[]char = make_slice(@[]char, n)
		var lines @[]int = make_slice(int, n)
		var used @[]bool = make_slice(bool, n)
		var pending @[]bool = make_slice(bool, n)
		var fromDiff @[]bool = make_slice(bool, n)
		var via @[]@[]char = make_slice(@[]char, n)
		for j := 0; j < p.NumConsts; j++ {
			names[j] = p.ConstNames[j]
			vals[j] = p.ConstVals[j]
			syms[j] = p.ConstSyms[j]
			lines[j] = p.ConstLines[j]
			used[j] = p.ConstUsed[j]
			pending[j] = p.ConstPending[j]
			fromDiff[j] = p.ConstFromDiff[j]
			via[j] = p.ConstVia[j]
		}
		p.ConstNames = names
		p.ConstVals = vals
		p.ConstSyms = syms
		p.ConstLines = lines
		p.ConstUsed = used
		p.ConstPending = pending
		p.ConstFromDiff = fromDiff
		p.ConstVia = via
	}
	p.ConstNames[p.NumConsts] = buf.CopyStr(name)
	p.ConstVals[p.NumConsts] = val
	p.ConstSyms[p.NumConsts] = buf.CopyStr(sym)
	p.ConstLines[p.NumConsts] = p.LineNum
	p.ConstUsed[p.NumConsts] = false
	p.ConstPending[p.NumConsts] = false
	p.ConstFromDiff[p.NumConsts] = false
	p.ConstVia[p.NumConsts] = ""
	p.NumConsts = p.NumConsts + 1
}

// dropConst removes the constant named name, if any, keeping the others in order: a label
// of that name has just been defined, which the name means from now on (as in clang, where
// `N = 1` then `N:` makes N a label).
func dropConst(p @Parser, name *[]readonly char) {
	var i int = constIndex(p, name)
	if i < 0 { return }
	for j := i + 1; j < p.NumConsts; j++ {
		p.ConstNames[j - 1] = p.ConstNames[j]
		p.ConstVals[j - 1] = p.ConstVals[j]
		p.ConstSyms[j - 1] = p.ConstSyms[j]
		p.ConstLines[j - 1] = p.ConstLines[j]
		p.ConstUsed[j - 1] = p.ConstUsed[j]
		p.ConstPending[j - 1] = p.ConstPending[j]
		p.ConstFromDiff[j - 1] = p.ConstFromDiff[j]
		p.ConstVia[j - 1] = p.ConstVia[j]
	}
	p.NumConsts = p.NumConsts - 1
	p.ConstNames[p.NumConsts] = ""
	p.ConstSyms[p.NumConsts] = ""
	p.ConstVia[p.NumConsts] = ""
}

// usedAsSymbol reports whether an earlier line referred to name as a symbol: a fixup in
// any section names it, an alias was defined as it plus a number, a pending literal-pool
// entry holds it, or a label difference used it before any definition (DiffFwdNames).
func usedAsSymbol(p @Parser, name *[]readonly char) bool {
	for i := 0; i < p.NumDiffFwd; i++ {
		if charsEqual(p.DiffFwdNames[i], name) { return true }
	}
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstSyms[i], name) { return true }
	}
	return usesName(p, name)
}

// parseSetDirective handles `.set name, expr` and `.equ name, expr` (equiv false), and
// `.equiv name, expr` (l positioned after the directive's name): the constant's definition,
// as `name = expr` makes it (parseConstDef) — redefinable, each use the value defined last
// before it.  `.equiv` defines only a name not defined yet, as a constant or a label, and no
// later definition may redefine it (EquivNames), as in clang, which has no `.eqv`.
func parseSetDirective(p @Parser, l Lexer, equiv bool) (Lexer, Token) {
	var tok Token
	var name Token
	l, name = LexNext(l)
	if name.Kind != TOK_IDENT || len(name.Text) == 0 || isDigit(name.Text[0]) {
		setErr(p, "expected the constant's name")
		return l, tok
	}
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected ',' after the constant's name")
		return l, tok
	}
	if equiv && nameDefined(p, name.Text) {
		setErr(p, quotedName(name.Text, " is already defined; .equiv does not redefine a name"))
		return l, tok
	}
	parseConstDef(p, l, name)
	if equiv && !p.HasError {
		p.EquivNames = slices.Append[@[]char](p.EquivNames, buf.CopyStr(name.Text))
	}
	var eol Token
	eol.Kind = TOK_EOF
	return l, eol
}

// nameDefined reports whether name is defined: a constant, a label or a common.
func nameDefined(p @Parser, name *[]readonly char) bool {
	if constIndex(p, name) >= 0 { return true }
	var si int = p.Asm.LookupSymbol(name)
	return si >= 0 && (p.Asm.Symbols[si].Section >= 0 || p.Asm.Symbols[si].Common)
}

// isEquiv reports whether `.equiv` defined name (EquivNames).
func isEquiv(p @Parser, name *[]readonly char) bool {
	for i := 0; i < len(p.EquivNames); i++ {
		if charsEqual(p.EquivNames[i], name) { return true }
	}
	return false
}

// parseConstDef parses `name = expr` (nameTok the name; l positioned after the '='): a
// number, or an alias — a symbol plus a number (`A = lbl + 8`), or the current location
// plus a number (`C = .`), which names a label made here for it.
func parseConstDef(p @Parser, l Lexer, nameTok Token) {
	// clang registers the symbol assigned, then those its value uses (the value's labels are
	// noted when the value is a difference, and its symbol below).
	p.Asm.NoteMention(nameTok.Text)
	var tok Token
	l, tok = LexNext(l)
	var first Token = tok
	var start Lexer = l
	var result ExprResult
	p.InConstDef = true
	l, tok, result = parseSymExpr(p, l, tok)
	p.InConstDef = false
	if !result.Ok {
		setErr(p, exprErr(result, "invalid constant expression"))
		return
	}
	if tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the constant's value")
		return
	}
	if result.Pending {
		// The value waits for a label after this line (the second pass reads it).
		defineConst(p, nameTok.Text, 0, "")
		var ci int = constIndex(p, nameTok.Text)
		if ci >= 0 {
			p.ConstPending[ci] = true
			p.ConstFromDiff[ci] = true
		}
		return
	}
	if result.Dot {
		result.Sym = dotLabel(p)
		if p.Asm.HasError { return }
	}
	var via @[]char = soleAliasName(p, first, start, l)
	p.Asm.NoteMention(result.Sym)
	defineConst(p, nameTok.Text, result.Val, result.Sym)
	var di int = constIndex(p, nameTok.Text)
	if di >= 0 && !p.HasError {
		p.ConstFromDiff[di] = result.FromDiff
		p.ConstVia[di] = via
	}
}

// noteDotRead notes, where a `.` is read in an expression, the mention of the label dotLabel
// would make for it next, as clang registers the symbol it makes for a `.` while it parses the
// statement (asm.Assembler.ClearMarkMention puts it before the statement's mapping mark).
func noteDotRead(p @Parser) {
	if p.Asm.Current < 0 { return }
	p.Asm.NoteMention(asm.GeneratedLabelName(".", p.NumDotLabels))
	p.DotNoted = p.NumDotLabels + 1
}

// forgetDotNoted ends what noteDotRead noted for a statement or a data value: a `.` that made no
// label (it folded away) gives up its mention, which a later `.` must not inherit.
func forgetDotNoted(p @Parser) {
	if p.DotNoted == p.NumDotLabels + 1 {
		p.Asm.ForgetMention(asm.GeneratedLabelName(".", p.NumDotLabels))
	}
	p.DotNoted = 0
}

// dotLabel defines a label at the current location — what `.` means in this statement —
// and returns its name (a generated name no source label can take), mentioned where the `.`
// was read (noteDotRead).
func dotLabel(p @Parser) @[]char {
	var name @[]char = asm.GeneratedLabelName(".", p.NumDotLabels)
	p.NumDotLabels = p.NumDotLabels + 1
	p.Asm.DefineLabel(name)
	noteLabelGen(p, name, p.Asm.Current)
	return name
}

// listConstants enters the constants into the symbol table, as clang lists them, global or
// weak when `.global` / `.weak` declared them so: a number as an absolute symbol
// (asm.Symbol.Abs; every use is still its value, as in clang); an alias of a symbol defined
// here as a symbol at that location; a local alias of a symbol not defined here not at
// all (its uses name that symbol, foldUnlistedAliasUses), while a global or weak one is an
// error — no object can list it, where clang drops the alias and its binding.  An alias is
// an alt entry (asm.Symbol.AltEntry: on Mach-O it starts no atom) unless it is exactly an
// atom-starting symbol (`A = _f`) and not weak, so
// listing it changes no displacement the resolvers fixed — where clang flags an alias of a
// temporary (`A = Ltmp`) as no alt entry, though its own resolvers treat it as one.  The
// object writers leave out the temporaries (`.LN = 5`, `Lend = .`).
func listConstants(p @Parser) {
	var a @asm.Assembler = p.Asm
	for i := 0; i < p.NumConsts; i++ {
		var name @[]char = p.ConstNames[i]
		if len(p.ConstSyms[i]) == 0 {
			a.DefineAbsolute(name, p.ConstVals[i])
			continue
		}
		var ti int = a.LookupSymbol(p.ConstSyms[i])
		if ti < 0 || a.Symbols[ti].Section < 0 {
			if !nameBound(p, name) {
				foldUnlistedAliasUses(p, i)
				continue
			}
			p.LineNum = p.ConstLines[i]
			var msg @[]char = quotedName(name, " is a global or weak alias of ")
			setErr(p, buf.Concat(msg, quotedName(p.ConstSyms[i], ", which is not defined here")))
			return
		}
		var off int64 = cast(int64, a.Symbols[ti].Offset) + p.ConstVals[i]
		if off < 0 {
			p.LineNum = p.ConstLines[i]
			setErr(p, quotedName(name, " is an alias before the start of its section"))
			return
		}
		// A symbol offset is a uint, 32 bits on a 32-bit host.
		if cast(int64, cast(uint, off)) != off {
			p.LineNum = p.ConstLines[i]
			setErr(p, quotedName(name, " is an alias past the section offsets this host represents"))
			return
		}
		// A weak alias starting the atom would take that atom's code with it when a strong
		// definition elsewhere replaces it, so it is always an alt entry (where clang drops
		// the weak binding).
		var weak bool = nameBound(p, name) && a.Symbols[a.LookupSymbol(name)].Binding == asm.BIND_WEAK
		var alt bool = p.ConstVals[i] != 0 || !asm.StartsAtom(a.Symbols[ti]) || weak
		a.DefineAlias(name, a.Symbols[ti].Section, cast(uint, off), alt)
		if a.HasError { return }
		// An alias takes its target's type, merged with its own (aliasType), and the size of
		// the nearest alias up its chain with one, else its target's (aliasSize), as clang
		// gives it them (a local common's STT_OBJECT and st_size, a `.type` / `.size`).
		var ai int = a.LookupSymbol(name)
		a.Symbols[ai].AliasOf = buf.CopyStr(p.ConstSyms[i])
		a.Symbols[ai].DefOrder = a.Symbols[ti].DefOrder
		a.Symbols[ai].Type = aliasType(recordedType(p, name), a.Symbols[ti].Type)
		a.Symbols[ai].Size = aliasSize(p, i, a.Symbols[ti].Size)
	}
}
