package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// The constant table: `name = expr` definitions — numbers and aliases (a symbol plus a
// number) — their rules against labels and symbols, and their entries in the object's
// symbol table.

// constIndex returns the index of the constant named name in p's table, or -1.
func constIndex(p @Parser, name *[]readonly char) int {
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstNames[i], name) { return i }
	}
	return -1
}

// nameBound reports whether `.global`, `.weak` or `.global_c` has declared name, which no
// label defines.
func nameBound(p @Parser, name *[]readonly char) bool {
	var si int = p.Asm.LookupSymbol(name)
	return si >= 0 && p.Asm.Symbols[si].Section < 0 && p.Asm.Symbols[si].Binding != asm.BIND_LOCAL
}

// lookupConst returns (value, true) for the number constant named name, and (0, false) when
// name is no constant or an alias (whose ConstVals entry is its addend, not a value).
func lookupConst(p @Parser, name *[]readonly char) (int64, bool) {
	var i int = constIndex(p, name)
	if i < 0 || len(p.ConstSyms[i]) > 0 { return 0, false }
	return p.ConstVals[i], true
}

// defineConst gives the constant name the value val — added to symbol sym for an alias,
// a number when sym is empty: a new constant, or a new value for an existing one (each
// use sees the value defined last before it, as in clang).  A name already defined as a
// label, or used as a symbol on an earlier line, cannot become a constant, and a global
// or weak alias used since its definition cannot be redefined: its uses go through its
// symbol, which can have one value only (clang lists two symbols of the name).  The name
// is copied.
func defineConst(p @Parser, name *[]readonly char, val int64, sym *[]readonly char) {
	var i int = constIndex(p, name)
	if i >= 0 && len(p.ConstSyms[i]) > 0 && p.ConstUsed[i] && nameBound(p, name) {
		setErr(p,
				quotedName(name,
						" is a global or weak alias used since its definition; it cannot be redefined"))
		return
	}
	if i >= 0 {
		p.ConstVals[i] = val
		p.ConstSyms[i] = buf.CopyStr(sym)
		p.ConstLines[i] = p.LineNum
		p.ConstUsed[i] = false
		return
	}
	var si int = p.Asm.LookupSymbol(name)
	if si >= 0 && p.Asm.Symbols[si].Section >= 0 {
		setErr(p, quotedName(name, " is a label; it cannot be redefined as a constant"))
		return
	}
	if usedAsSymbol(p, name) {
		setErr(p,
				quotedName(name, " was used as a symbol earlier; a constant must be defined before use"))
		return
	}
	if p.NumConsts >= len(p.ConstNames) {
		var n int = 2 * len(p.ConstNames)
		var names @[]@[]char = make_slice(@[]char, n)
		var vals @[]int64 = make_slice(int64, n)
		var syms @[]@[]char = make_slice(@[]char, n)
		var lines @[]int = make_slice(int, n)
		var used @[]bool = make_slice(bool, n)
		for j := 0; j < p.NumConsts; j++ {
			names[j] = p.ConstNames[j]
			vals[j] = p.ConstVals[j]
			syms[j] = p.ConstSyms[j]
			lines[j] = p.ConstLines[j]
			used[j] = p.ConstUsed[j]
		}
		p.ConstNames = names
		p.ConstVals = vals
		p.ConstSyms = syms
		p.ConstLines = lines
		p.ConstUsed = used
	}
	p.ConstNames[p.NumConsts] = buf.CopyStr(name)
	p.ConstVals[p.NumConsts] = val
	p.ConstSyms[p.NumConsts] = buf.CopyStr(sym)
	p.ConstLines[p.NumConsts] = p.LineNum
	p.ConstUsed[p.NumConsts] = false
	p.NumConsts = p.NumConsts + 1
}

// dropConst removes the constant named name, if any, keeping the others in order: a label
// of that name has just been defined, which the name means from now on (as in clang, where
// `N = 1` then `N:` makes N a label).
func dropConst(p @Parser, name *[]readonly char) {
	var i int = constIndex(p, name)
	if i < 0 { return }
	for j := i + 1; j < p.NumConsts; j++ {
		p.ConstNames[j - 1] = p.ConstNames[j]
		p.ConstVals[j - 1] = p.ConstVals[j]
		p.ConstSyms[j - 1] = p.ConstSyms[j]
		p.ConstLines[j - 1] = p.ConstLines[j]
		p.ConstUsed[j - 1] = p.ConstUsed[j]
	}
	p.NumConsts = p.NumConsts - 1
	p.ConstNames[p.NumConsts] = ""
	p.ConstSyms[p.NumConsts] = ""
}

// usedAsSymbol reports whether an earlier line referred to name as a symbol: a fixup in
// any section names it, an alias was defined as it plus a number, or a pending
// literal-pool entry holds it.
func usedAsSymbol(p @Parser, name *[]readonly char) bool {
	for i := 0; i < p.NumConsts; i++ {
		if charsEqual(p.ConstSyms[i], name) { return true }
	}
	if poolNamesSymbol(p, name) { return true }
	var a @asm.Assembler = p.Asm
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		for fi := 0; fi < sec.NumFixups; fi++ {
			if charsEqual(sec.Fixups[fi].Label, name) { return true }
		}
	}
	return false
}

// parseConstDef parses `name = expr` (nameTok the name; l positioned after the '='): a
// number, or an alias — a symbol plus a number (`A = lbl + 8`), or the current location
// plus a number (`C = .`), which names a label made here for it.
func parseConstDef(p @Parser, l Lexer, nameTok Token) {
	var tok Token
	l, tok = LexNext(l)
	var result ExprResult
	p.InConstDef = true
	l, tok, result = parseSymExpr(p, l, tok)
	p.InConstDef = false
	if !result.Ok {
		setErr(p, exprErr(result, "invalid constant expression"))
		return
	}
	if tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the constant's value")
		return
	}
	if result.Dot {
		result.Sym = dotLabel(p)
		if p.Asm.HasError { return }
	}
	defineConst(p, nameTok.Text, result.Val, result.Sym)
}

// dotLabel defines a label at the current location — what `.` means in this statement —
// and returns its name (a generated name no source label can take).
func dotLabel(p @Parser) @[]char {
	var name @[]char = asm.GeneratedLabelName(".", p.NumDotLabels)
	p.NumDotLabels = p.NumDotLabels + 1
	p.Asm.DefineLabel(name)
	return name
}

// listConstants enters the constants into the symbol table, as clang lists them, global or
// weak when `.global` / `.weak` declared them so: a number as an absolute symbol
// (asm.Symbol.Abs; every use is still its value, as in clang); an alias of a symbol defined
// here as a symbol at that location; a local alias of a symbol not defined here not at
// all, while a global or weak one is an error — no object can list it, where clang drops
// the alias and its binding.  An alias is an alt entry (asm.Symbol.AltEntry: on Mach-O it
// starts no atom) unless it is exactly an atom-starting symbol (`A = _f`) and not weak, so
// listing it changes no displacement the resolvers fixed — where clang flags an alias of a
// temporary (`A = Ltmp`) as no alt entry, though its own resolvers treat it as one.  The
// object writers leave out the temporaries (`.LN = 5`, `Lend = .`).
func listConstants(p @Parser) {
	var a @asm.Assembler = p.Asm
	for i := 0; i < p.NumConsts; i++ {
		var name @[]char = p.ConstNames[i]
		if len(p.ConstSyms[i]) == 0 {
			a.DefineAbsolute(name, p.ConstVals[i])
			continue
		}
		var ti int = a.LookupSymbol(p.ConstSyms[i])
		if ti < 0 || a.Symbols[ti].Section < 0 {
			if !nameBound(p, name) { continue }
			p.LineNum = p.ConstLines[i]
			var msg @[]char = quotedName(name, " is a global or weak alias of ")
			setErr(p, buf.Concat(msg, quotedName(p.ConstSyms[i], ", which is not defined here")))
			return
		}
		var off int64 = cast(int64, a.Symbols[ti].Offset) + p.ConstVals[i]
		if off < 0 {
			p.LineNum = p.ConstLines[i]
			setErr(p, quotedName(name, " is an alias before the start of its section"))
			return
		}
		// A weak alias starting the atom would take that atom's code with it when a strong
		// definition elsewhere replaces it, so it is always an alt entry (where clang drops
		// the weak binding).
		var weak bool = nameBound(p, name) && a.Symbols[a.LookupSymbol(name)].Binding == asm.BIND_WEAK
		var alt bool = p.ConstVals[i] != 0 || !asm.StartsAtom(a.Symbols[ti]) || weak
		a.DefineAlias(name, a.Symbols[ti].Section, cast(uint, off), alt)
	}
}

// aliasUsedBeforeBinding reports (setting the error) that name, an alias being made global
// or weak, was used since its latest definition: that use took the alias's target, where a
// global or weak alias's uses go through its symbol.  Returns false when name is no alias
// used so, or one already global or weak (whose uses went through its symbol).
func aliasUsedBeforeBinding(p @Parser, name *[]readonly char) bool {
	var i int = constIndex(p, name)
	if i < 0 || len(p.ConstSyms[i]) == 0 || !p.ConstUsed[i] || nameBound(p, name) { return false }
	setErr(p,
			quotedName(name, " was used before being made global or weak; declare it before its uses"))
	return true
}
