package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Constants on arm32 and x86-64 (clang's bytes: `-target armv7-linux-gnueabi`,
// `-target x86_64-linux-gnu` with `.intel_syntax noprefix`), the constant table's growth,
// and the evaluator's diagnostic for a name that is no constant.
// (arm32SrcWordIs is in arm32_instr_test.bn, lineEmitsHex / lineRejected in parse_test.bn.)

// arm32ConstHeader defines the constants the arm32 cases use.
var arm32ConstHeader *[]readonly char = "N = 5\nM = 2\nK = 8\nNEG = -4\n"

// arm32ConstCase checks that line, after arm32ConstHeader, assembles to want.
func arm32ConstCase(e @[]char, line *[]readonly char, want uint32) @[]char {
	return arm32SrcWordIs(e, buf.Concat(arm32ConstHeader, line), 0, want)
}

// arm32ConstReject checks that line, after arm32ConstHeader, is rejected.
func arm32ConstReject(e @[]char, line *[]readonly char) @[]char {
	_, err := arm32SrcWord(buf.Concat(arm32ConstHeader, line), 0)
	if len(err) == 0 { return goldenFail(e, line, "accepted") }
	return e
}

// On arm32 a constant is read wherever an expression is: `#` immediates, offsets and
// shift amounts.  A branch or label operand takes no constant.
func TestConstArm32() testing.TestResult {
	var e @[]char = ""
	e = arm32ConstCase(e, "mov r0, #N", 0xE3A00005)
	e = arm32ConstCase(e, "add r0, r1, #N", 0xE2810005)
	e = arm32ConstCase(e, "sub r0, r1, #N*2", 0xE241000A)
	e = arm32ConstCase(e, "ldr r0, [r1, #NEG]", 0xE5110004)
	e = arm32ConstCase(e, "ldr r0, [r1], #K", 0xE4910008)
	e = arm32ConstCase(e, "ldrh r0, [r1, #N]", 0xE1D100B5)
	e = arm32ConstCase(e, "ldr r0, [r1, r2, lsl #M]", 0xE7910102)
	e = arm32ConstCase(e, "mov r0, r1, lsl #M", 0xE1A00101)
	e = arm32ConstCase(e, "svc #N", 0xEF000005)
	e = arm32ConstCase(e, "bkpt #N", 0xE1200075)
	e = arm32ConstCase(e, "movt r0, #N", 0xE3400005)
	e = arm32ConstReject(e, "add r0, r1, N")
	e = arm32ConstReject(e, "ldr r0, [r1, N]")
	e = arm32ConstReject(e, "mov r0, r1, lsl M")
	e = arm32ConstReject(e, "bl N")
	e = arm32ConstReject(e, "ldr r0, N")
	return e
}

// x64ConstCase checks that line, after the definitions `N = 5`, `S = 4` and `NEG = -8`,
// assembles to exactly the bytes hex.
func x64ConstCase(e @[]char, line *[]readonly char, hex *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine("N = 5")
	p.ParseLine("S = 4")
	p.ParseLine("NEG = -8")
	var r testing.TestResult = lineEmitsHex(p, line, hex)
	if len(r) > 0 { return goldenFail(e, line, r) }
	return e
}

// x64ConstReject checks that line, after `N = 5`, is rejected and emits nothing.
func x64ConstReject(e @[]char, line *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine("N = 5")
	var r testing.TestResult = lineRejected(p, line)
	if len(r) > 0 { return goldenFail(e, line, r) }
	return e
}

// On x86-64 a constant's name is an immediate, bare (`mov rax, N` moves 5, where `mov rax,
// lbl` loads from lbl) or in an expression, and a displacement inside brackets; a jump or
// call takes no constant.
func TestConstX64() testing.TestResult {
	var e @[]char = ""
	e = x64ConstCase(e, "mov rax, N", "48 c7 c0 05 00 00 00")
	e = x64ConstCase(e, "mov rax, N+2", "48 c7 c0 07 00 00 00")
	e = x64ConstCase(e, "mov rax, 2+N", "48 c7 c0 07 00 00 00")
	e = x64ConstCase(e, "mov eax, N", "b8 05 00 00 00")
	e = x64ConstCase(e, "add rax, N", "48 83 c0 05")
	e = x64ConstCase(e, "sub rax, N*2", "48 83 e8 0a")
	e = x64ConstCase(e, "mov rax, [rbx + N]", "48 8b 43 05")
	e = x64ConstCase(e, "mov rax, [rbx + N*2]", "48 8b 43 0a")
	e = x64ConstCase(e, "mov rax, [rbx - N]", "48 8b 43 fb")
	e = x64ConstCase(e, "mov rax, [rbx + NEG]", "48 8b 43 f8")
	e = x64ConstCase(e, "mov rax, qword ptr [rbx + N]", "48 8b 43 05")
	e = x64ConstCase(e, "mov rax, [rbx + rcx*S]", "48 8b 04 8b")
	e = x64ConstCase(e, "int N", "cd 05")
	e = x64ConstCase(e, "push N", "6a 05")
	e = x64ConstCase(e, "shl rax, N", "48 c1 e0 05")
	e = x64ConstReject(e, "call N")
	e = x64ConstReject(e, "jmp N")
	e = x64ConstReject(e, "je N")
	return e
}

// The constant table grows past its initial room, keeping every value and its order of
// definition.
func TestConstTableGrows() testing.TestResult {
	var p @Parser = newTestParser()
	for i := 0; i < 100; i++ {
		var b @strings.Builder = strings.NewBuilder()
		b.Write("C")
		writeDec(b, i)
		b.Write(" = ")
		writeDec(b, i * 3)
		p.ParseLine(b.String())
	}
	if p.HasError { return fail(p.ErrorMsg) }
	if p.NumConsts != 100 { return fail("expected 100 constants") }
	v0, ok0 := lookupConst(p, "C0")
	v99, ok99 := lookupConst(p, "C99")
	if !ok0 || v0 != 0 || !ok99 || v99 != 297 { return fail("a constant lost its value") }
	if !charsEqual(p.ConstNames[50], "C50") { return fail("definition order not kept") }
	return ""
}

// writeDec writes the non-negative n in decimal.
func writeDec(b @strings.Builder, n int) {
	if n >= 10 { writeDec(b, n / 10) }
	b.WriteByte(cast(char, 48 + n % 10)) // '0' + the digit
}

// A name in an expression that is no constant defined so far fails with a diagnostic
// naming it; a defined one reads its value.
func TestConstExprNames() testing.TestResult {
	var p @Parser = NewParser(asm.New(8), "t.s")
	p.ParseLine("N = 5")
	var l Lexer = NewLexer("N * 2 + 1", 1)
	var tok Token
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok || r.Val != 11 { return fail("N * 2 + 1 should be 11") }
	l = NewLexer("1 + Q", 1)
	l, tok = LexNext(l)
	l, tok, r = ParseExpr(p, l, tok)
	if r.Ok { return fail("an undefined name was accepted") }
	if !charsEqual(r.Err, "'Q' is not a constant defined before this line") {
		return fail(buf.Concat("wrong diagnostic: ", r.Err))
	}
	return ""
}
