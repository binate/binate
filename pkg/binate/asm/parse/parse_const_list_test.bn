package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The constants' symbol-table entries (listConstants), as clang lists them: a number as an
// absolute symbol with its last value, local unless made global or weak; an alias of a
// symbol defined here as a local symbol at that location, an alt entry unless it is
// exactly an atom-starting symbol; an alias of an undefined symbol not at all.
// (labelsSource is in aarch64_golden_labels_test.bn.)

// listedSym returns the symbol named name after src is assembled (ELF), or fails.
func listedSym(src *[]readonly char, name *[]readonly char) (asm.Symbol, @[]char) {
	var none asm.Symbol
	var p @Parser = labelsSource(src, asm.OBJ_ELF)
	if p.HasError { return none, buf.Concat("rejected: ", p.ErrorMsg) }
	if p.Asm.HasError { return none, buf.Concat("rejected: ", p.Asm.ErrorMsg) }
	var si int = p.Asm.LookupSymbol(name)
	if si < 0 { return none, buf.CopyStr("not a symbol") }
	return p.Asm.Symbols[si], ""
}

// listedAbs checks that src lists name as an absolute symbol of value with binding bind.
func listedAbs(e @[]char, src *[]readonly char, name *[]readonly char, value int64,
		bind int) @[]char {
	sym, err := listedSym(src, name)
	if len(err) > 0 { return goldenFail(e, src, err) }
	if !sym.Abs || sym.AbsValue != value || sym.Section != -1 || sym.Binding != bind {
		return goldenFail(e, src, "not an absolute symbol of that value and binding")
	}
	return e
}

// listedAlias checks that src lists name in section 0 at offset, an alt entry when alt.
func listedAlias(e @[]char, src *[]readonly char, name *[]readonly char, offset uint,
		alt bool) @[]char {
	sym, err := listedSym(src, name)
	if len(err) > 0 { return goldenFail(e, src, err) }
	if sym.Abs || sym.Section != 0 || sym.Offset != offset || sym.AltEntry != alt {
		return goldenFail(e, src, "not a symbol at that location / alt entry")
	}
	return e
}

// A number constant is a local absolute symbol with its last value, negative or 64-bit
// alike; a temporary's name is kept here too (the object writers leave it out).
func TestListConstantsNumbers() testing.TestResult {
	var e @[]char = ""
	e = listedAbs(e, "N = 5", "N", 5, asm.BIND_LOCAL)
	e = listedAbs(e, "N = 5\nN = N + 1", "N", 6, asm.BIND_LOCAL)
	e = listedAbs(e, "NEG = -3", "NEG", -3, asm.BIND_LOCAL)
	e = listedAbs(e, "BIG = 0x123456789", "BIG", 0x123456789, asm.BIND_LOCAL)
	e = listedAbs(e, "x3 = 7", "x3", 7, asm.BIND_LOCAL)
	e = listedAbs(e, ".LN = 5", ".LN", 5, asm.BIND_LOCAL)
	return e
}

// A number made global or weak — by `.global` / `.weak` / `.global_c`, before or after its
// definition — is listed with that binding and its last value, as clang lists it, while
// every use is still the value then defined (`.uint32 G` folds), as in clang.
func TestListConstantsBound() testing.TestResult {
	var e @[]char = ""
	e = listedAbs(e, ".global G\nG = 7", "G", 7, asm.BIND_GLOBAL)
	e = listedAbs(e, "G = 7\n.global G", "G", 7, asm.BIND_GLOBAL)
	e = listedAbs(e, ".weak W\nW = -1", "W", -1, asm.BIND_WEAK)
	e = listedAbs(e, "W = 1\n.weak W", "W", 1, asm.BIND_WEAK)
	e = listedAbs(e, "C = 1\n.global_c C", "C", 1, asm.BIND_GLOBAL)
	e = listedAbs(e, "G = 7\n.global G\nG = 8", "G", 8, asm.BIND_GLOBAL)
	e = listedAbs(e, "L = 1\n.local L", "L", 1, asm.BIND_LOCAL)
	e = labelsCase(e, ".global G\nG = 5\n.uint32 G\nG = 6\nadd x0, x1, #G", "00000005 91001820 ")
	e = labelsCase(e, ".weak W\nW = 5\nmov x0, #W", "D28000A0 ")
	return e
}

// An alias of a symbol defined here is a symbol at its last location: a plain one where
// it is exactly an atom-starting symbol (`A = lbl`, as clang lists it), an alt entry
// elsewhere — `lbl + 4`, `.`, and an alias of a temporary or numeric local label, which
// clang lists as no alt entry though its own resolvers treat it as one — so listing it
// changes no displacement.  An alias of an undefined symbol is not listed.
func TestListConstantsAliases() testing.TestResult {
	var e @[]char = ""
	var h *[]readonly char = "nop\nlbl: nop\nnop\n"
	e = listedAlias(e, buf.Concat(h, "A = lbl"), "A", 4, false)
	e = listedAlias(e, buf.Concat(h, "B = lbl + 4"), "B", 8, true)
	e = listedAlias(e, buf.Concat(h, "C = ."), "C", 12, true)
	e = listedAlias(e, buf.Concat(h, "A = lbl\nA = lbl + 4"), "A", 8, true)
	e = listedAlias(e, buf.Concat(h, "L = 1f\n1: nop"), "L", 12, true)
	e = listedAlias(e, buf.Concat(h, "T = Ltmp\nLtmp: nop"), "T", 12, true)
	_, err2 := listedSym(".global ext\nE = ext + 4", "E")
	if len(err2) == 0 { e = goldenFail(e, "E = ext + 4", "an alias of an undefined symbol listed") }
	// An alias found before its section's start is reported at its definition's line.
	var p @Parser = labelsSource("lbl: nop\nA = lbl - 8\nnop\nnop", asm.OBJ_ELF)
	if !plHasPrefix(p.ErrorMsg, "test.s:4: error: 'A' is an alias before the start") {
		e = goldenFail(e, "A = lbl - 8", buf.Concat("wrong diagnostic: ", p.ErrorMsg))
	}
	return e
}
