package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Constants (`name = expr`) on AArch64: definition, redefinition and the clashes with labels
// and symbols, then the operand positions a constant's name may stand in — each checked
// against clang's words (`clang -c -target aarch64-linux-gnu`, the same for Mach-O).
// (labelsCase / labelsReject are in aarch64_golden_labels_test.bn.)

// constHeader defines the constants the operand cases below use.
var constHeader *[]readonly char = "N = 5\nK = 8\nS = 3\nNEG = -8\n"

// constCase checks that line, after constHeader, assembles to exactly the words want.
func constCase(e @[]char, line *[]readonly char, want *[]readonly char) @[]char {
	return labelsCase(e, buf.Concat(constHeader, line), want)
}

// constReject checks that line, after constHeader, is rejected.
func constReject(e @[]char, line *[]readonly char) @[]char {
	return labelsReject(e, buf.Concat(constHeader, line))
}

// A constant may be redefined, and each use sees the value defined last before it (also
// in the new value's own expression); a definition may follow a label on its line.
func TestConstRedefinition() testing.TestResult {
	var e @[]char = ""
	e = labelsCase(e, "N = 5\nadd x0, x1, #N\nN = 6\nadd x0, x1, #N\nN = N + 1\nadd x0, x1, #N",
			"91001420 91001820 91001C20 ")
	e = labelsCase(e, "lbl: G = 4\nadd x0, x1, #G\nb lbl", "91001020 17FFFFFF ")
	e = labelsCase(e, "N = 1\nN = 2\n.uint32 N", "00000002 ")
	return e
}

// A constant may be named like a register, a condition or a shift: the name is the
// constant where an expression is read (`#x3`), and the register where one can stand.
func TestConstNamedLikeKeywords() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = "x3 = 7\neq = 2\nlsl = 3\nadd x0, x1, x3\nadd x0, x1, #x3\n"
			"add x0, x1, #eq\nadd x0, x1, #lsl\nldr x0, [x1, x3]"
	e = labelsCase(e, src, "8B030020 91001C20 91000820 91000C20 F8636820 ")
	return e
}

// A constant must be defined before it is used (clang resolves some later definitions at
// layout and rejects others): a use, as a number or as a symbol, before the definition is
// an error.
func TestConstForwardReferenceRejected() testing.TestResult {
	var e @[]char = ""
	e = labelsReject(e, "add x0, x1, #F\nF = 3")
	e = labelsReject(e, ".uint32 F\nF = 3")
	e = labelsReject(e, "b X\nX = 12")
	e = labelsReject(e, "adr x0, X\nX = 12")
	// A name used as a symbol is reported at its definition as a constant, rather than
	// as an undefined symbol at the end of the input.
	var p @Parser = labelsSource("b X\nX = 12", asm.OBJ_ELF)
	if !plHasPrefix(p.ErrorMsg, "test.s:4: error: 'X' was used as a symbol earlier") {
		e = goldenFail(e, "b X / X = 12", buf.Concat("wrong diagnostic: ", p.ErrorMsg))
	}
	return e
}

// A label's name cannot become a constant; a label defined with a constant's name turns
// the name into that label (as clang does), so the name is no longer a number after it.
func TestConstAndLabelNames() testing.TestResult {
	var e @[]char = ""
	e = labelsReject(e, "lbl:\nlbl = 9")
	e = labelsCase(e, "H = 1\nadd x0, x1, #H\nH:\nb H", "91000420 14000000 ")
	e = labelsReject(e, "H = 1\nH:\nadd x0, x1, #H")
	e = labelsReject(e, "H = 1\nH:\nH = 2")
	return e
}

// A constant cannot be made global or weak, in either order: a number (clang makes it a
// global / weak absolute symbol, which bnld does not yet read as defined) nor an alias
// (clang routes the object's own references through a global / weak alias, so that a
// strong definition elsewhere overrides a weak one, where they take its target here);
// `.local` is accepted.
func TestConstBindingRejected() testing.TestResult {
	var e @[]char = ""
	e = labelsReject(e, ".global G\nG = 7")
	e = labelsReject(e, "G = 7\n.global G")
	e = labelsReject(e, ".weak W\nW = 1")
	e = labelsReject(e, "W = 1\n.weak W")
	e = labelsReject(e, "C = 1\n.global_c C")
	e = labelsReject(e, "lbl: nop\n.global A\nA = lbl")
	e = labelsReject(e, "lbl: nop\nA = lbl\n.weak A")
	e = labelsReject(e, "lbl: nop\nA = lbl\n.global_c A")
	e = labelsCase(e, "L = 1\n.local L\nadd x0, x1, #L", "91000420 ")
	return e
}

// A constant's name is a number wherever an immediate, offset or shift amount is read —
// with or without '#' — and, as a branch or literal target, an offset from the
// instruction, as a number is (`b K` is `b 8`).
func TestConstOperands() testing.TestResult {
	var e @[]char = ""
	e = constCase(e, "add x0, x1, N", "91001420 ")
	e = constCase(e, "add x0, x1, N+1", "91001820 ")
	e = constCase(e, "add x0, x1, ~N&15", "91002820 ")
	e = constCase(e, "add x0, x1, #N, lsl #12", "91401420 ")
	e = constCase(e, "add x0, x1, x2, lsl #S", "8B020C20 ")
	e = constCase(e, "add x0, x1, w2, uxtw #S", "8B224C20 ")
	e = constCase(e, "cmp x0, N", "F100141F ")
	e = constCase(e, "mov x0, N", "D28000A0 ")
	e = constCase(e, "mov x0, NEG", "928000E0 ")
	e = constCase(e, "movz x0, N, lsl #16", "D2A000A0 ")
	e = constCase(e, "and x0, x1, K*2", "927C0020 ")
	e = constCase(e, "lsl x0, x1, N", "D37BE820 ")
	e = constCase(e, "ubfx x0, x1, N, S", "D3451C20 ")
	e = constCase(e, "tbz x0, N, .", "36280000 ")
	e = constCase(e, "ccmp x0, N, S, eq", "FA450803 ")
	e = constCase(e, "svc N", "D40000A1 ")
	e = constCase(e, "clrex N", "D503355F ")
	e = constCase(e, "movi v0.16b, N", "4F00E4A0 ")
	e = constCase(e, "movi v0.4s, #N, msl #K", "4F00C4A0 ")
	e = constCase(e, "ldr x0, [x1, N*8]", "F9401420 ")
	e = constCase(e, "ldr x0, [x1, NEG]", "F85F8020 ")
	e = constCase(e, "ldr x0, [x1], K", "F8408420 ")
	e = constCase(e, "ldr x0, [x1, K]!", "F8408C20 ")
	e = constCase(e, "ldr x0, [x1, x2, lsl #S]", "F8627820 ")
	e = constCase(e, "ldp x0, x1, [x2, K*2]", "A9410440 ")
	e = constCase(e, "ldr x0, K", "58000040 ")
	e = constCase(e, "ldr x0, 8", "58000040 ")
	e = constCase(e, "ldr x0, -8", "58FFFFC0 ")
	e = constCase(e, "prfm pldl1keep, K", "D8000040 ")
	e = constCase(e, "b K", "14000002 ")
	e = constCase(e, "bl K", "94000002 ")
	e = constCase(e, "b.eq K", "54000040 ")
	e = constCase(e, "cbz x0, K", "B4000040 ")
	e = constCase(e, "adr x0, K", "10000040 ")
	return e
}

// Where clang takes no constant, nor do we: after a bare constant no shift may follow, a
// shift amount needs '#' (or a leading literal), an add / sub immediate's shift only a
// literal amount, a barrier option no bare number, and an `adrp` target a page.
func TestConstOperandsRejected() testing.TestResult {
	var e @[]char = ""
	e = constReject(e, "add x0, x1, N, lsl #12")
	e = constReject(e, "add x0, x1, x2, lsl S")
	e = constReject(e, "add x0, x1, w2, uxtw S")
	e = constReject(e, "movz x0, #N, lsl K")
	e = constReject(e, "ldr x0, [x1, x2, lsl S]")
	e = constReject(e, "add x0, x1, #1, lsl #(K+4)")
	e = constReject(e, "dsb N")
	e = constReject(e, "adrp x0, K")
	e = constReject(e, "add x0, x1, #Q")
	return e
}

// defsLineRejected checks that line, after the definitions defs (lines separated by '\n'),
// is rejected and emits nothing — no bytes and no fixup.
func defsLineRejected(e @[]char, defs *[]readonly char, line *[]readonly char) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	var start int = 0
	for i := 0; i <= len(defs); i++ {
		if i == len(defs) || defs[i] == '\n' {
			p.ParseLine(defs[start:i])
			start = i + 1
		}
	}
	if p.HasError { return goldenFail(e, defs, buf.Concat("definitions rejected: ", p.ErrorMsg)) }
	p.ParseLine(line)
	if !p.HasError { return goldenFail(e, line, "accepted") }
	var sec @asm.Section = p.Asm.Sections[0]
	if sec.Len != 0 || sec.NumFixups != 0 { return goldenFail(e, line, "rejected, but emitted") }
	return e
}

// Deliberate rejects, where clang accepts: a bare constant named like a condition or a
// shift / extend is read as that name, so it is no symbol (`b eq`, `b lsl+4`, `adr x0,
// eq`) and no number (`add x0, x1, eq`, a post-index `lsl`), where clang reads the constant
// (`b eq` with eq = 16 branches 16 bytes ahead) — write `#eq` (PRFM, which takes a shift
// name as a label, takes the constant: `prfm pldl1keep, lsl`); and a relocation qualifier
// takes a symbol, not a constant (clang folds `:lo12:N` to the low 12 bits and relocates
// `:got:N` against an absolute symbol).  Each line emits nothing.
func TestConstDeliberateRejects() testing.TestResult {
	var e @[]char = ""
	e = defsLineRejected(e, "eq = 16", "b eq")
	e = defsLineRejected(e, "eq = 16", "adr x0, eq")
	e = defsLineRejected(e, "eq = 16", "cbz x0, eq")
	e = defsLineRejected(e, "eq = 8", "b eq+4")
	e = defsLineRejected(e, "eq = 8", "adr x0, eq+4")
	e = defsLineRejected(e, "lsl = 8", "b lsl")
	e = defsLineRejected(e, "lsl = 8", "b lsl+4")
	e = defsLineRejected(e, "eq = 2", "add x0, x1, eq")
	e = defsLineRejected(e, "lsl = 8", "ldr x0, [x1], lsl")
	e = defsLineRejected(e, "N = 5", "add x0, x0, :lo12:N")
	e = defsLineRejected(e, "N = 5", "adrp x0, :got:N")
	return e
}

// A bare name the operand scanner reads as a register or a modifier is never the
// constant of that name, which clang rejects too: a shift / extend / msl as an offset or
// literal target, and the SVE / SME / flag registers clang names in any operand.  A name
// clang reads as a constant there is one (`p0`, `za`), and after '#' every constant is a
// number (`lsl #x3`, `#msl`).
func TestConstReservedNames() testing.TestResult {
	var e @[]char = ""
	e = defsLineRejected(e, "lsl = 8", "ldr x0, lsl")
	e = defsLineRejected(e, "lsl = 8", "ldr x0, [x1, lsl]")
	e = defsLineRejected(e, "uxtw = 8", "ldr x0, [x1, uxtw]")
	e = defsLineRejected(e, "uxtw = 8", "ldr x0, uxtw")
	e = defsLineRejected(e, "msl = 8", "ldr x0, [x1, msl]")
	e = defsLineRejected(e, "msl = 8", "ldr x0, msl")
	e = defsLineRejected(e, "msl = 8", "add x0, x1, msl")
	e = defsLineRejected(e, "z0 = 8", "add x0, x1, z0")
	e = defsLineRejected(e, "Z31 = 8", "add x0, x1, Z31")
	e = defsLineRejected(e, "ffr = 8", "add x0, x1, ffr")
	e = defsLineRejected(e, "zt0 = 8", "add x0, x1, zt0")
	e = defsLineRejected(e, "fpcr = 8", "add x0, x1, fpcr")
	e = defsLineRejected(e, "fpsr = 8", "add x0, x1, fpsr")
	e = defsLineRejected(e, "nzcv = 8", "add x0, x1, nzcv")
	e = labelsCase(e, "p0 = 8\nadd x0, x1, p0", "91002020 ")
	e = labelsCase(e, "za = 8\nadd x0, x1, za", "91002020 ")
	e = labelsCase(e, "z32 = 8\nadd x0, x1, z32", "91002020 ")
	e = labelsCase(e, "msl = 8\nadd x0, x1, #msl", "91002020 ")
	e = labelsCase(e, "x3 = 7\nadd x0, x1, x2, lsl #x3", "8B021C20 ")
	e = labelsCase(e, "K = 16\nld1 {v0.4s}, [x0], K", "4CDF7800 ")
	e = labelsCase(e, "lsl = 8\nprfm pldl1keep, lsl", "D8000040 ")
	return e
}
