package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// The sized data directives, `.{u,}int{8,16,32,64} expr [, expr ...]`.  A number must fit
// the size, read as signed or unsigned (a 64-bit datum takes any value).  A symbol plus a
// number — a label, an external symbol, an alias, `.` — is a data relocation of the size
// (asm.FIX_DATA_ABS*), `.int32`'s a signed one (x86-64's R_X86_64_32S, where `.uint32`'s is
// R_X86_64_32 as clang's `.long`); a size the target has no relocation for is an error, as
// in clang: one byte on AArch64 ELF, eight on arm32.  A difference not fixed at assembly
// (`sym - .`, `sym - l` with l in the datum's own section, the minuend possibly external) is
// a PC-relative data relocation on ELF (parseDataDifference).

// dataValueOk reports whether v fits a size-byte datum, read as signed or unsigned
// (a 64-bit datum takes any value).
func dataValueOk(v int64, size int) bool {
	if size == 1 { return v >= -128 && v <= 255 }
	if size == 2 { return v >= -32768 && v <= 65535 }
	if size == 4 { return v >= -2147483648 && v <= 4294967295 }
	return true
}

// parseDataDirective handles a sized data directive (l just after its name): size is 1,
// 2, 4 or 8 bytes, signed for `.intN`.
func parseDataDirective(p @Parser, l Lexer, size int, signed bool) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	for {
		l, tok = parseDataItem(p, l, tok, size, signed)
		if p.HasError || p.Asm.HasError { return l, tok }
		if tok.Kind != TOK_COMMA { return l, tok }
		l, tok = LexNext(l)
	}
	return l, tok
}

// parseDataItem parses one value of a sized data directive at tok (l just after it) and
// emits it: a number (a placeholder 0 while it waits for a later label), or a symbol plus
// a number as a relocation of the size.
func parseDataItem(p @Parser, l Lexer, tok Token, size int, signed bool) (Lexer, Token) {
	var r ExprResult
	l, tok, r = parseLevel(p, l, tok, 0)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid data expression"))
		return l, tok
	}
	if !r.Pending && hasNeg(r) {
		emitDataDifference(p, r, size)
		return l, tok
	}
	if r.Pending || !isSymbolic(r) {
		if !dataValueOk(r.Val, size) {
			setErr(p, "data value does not fit the directive's size")
			return l, tok
		}
		emitDataNumber(p, r.Val, size)
		return l, tok
	}
	var kind int = dataFixupKind(p, size, signed)
	if kind < 0 { return l, tok }
	if !intFits(r.Val) ||
			((p.Arch == ARCH_ARM32 || p.Asm.ObjFormat == asm.OBJ_MACHO) && !dataValueOk(r.Val, size)) {
		// arm32 (REL) and Mach-O keep a data relocation's addend in the field itself.
		setErr(p, "data addend out of range for the field")
		return l, tok
	}
	if r.Dot {
		r.Sym = dotLabel(p)
		if p.Asm.HasError { return l, tok }
	}
	p.Asm.AddFixup(r.Sym, kind, cast(int, r.Val), size)
	p.Asm.Zero(size)
	return l, tok
}

// emitDataDifference emits a size-byte difference r not fixed at assembly (minuend S, subtrahend
// N): on ELF, a PC-relative relocation against S whose addend folds in the distance from N
// to the field — N must be `.` or a label in the datum's own section, as clang requires
// ("Cannot represent a difference across sections"); `. - S` has no relocation.  On Mach-O
// (a SUBTRACTOR pair) it is not yet supported.
func emitDataDifference(p @Parser, r ExprResult, size int) {
	if p.Asm.ObjFormat == asm.OBJ_UNKNOWN && p.Arch != ARCH_ARM32 {
		setErr(p, "a difference in data needs the object format, not yet known here")
		return
	}
	if p.Asm.ObjFormat == asm.OBJ_MACHO {
		setErr(p, "a difference of locations in different atoms is not supported in Mach-O data")
		return
	}
	if r.Dot {
		setErr(p, "the current location minus a symbol (`. - sym`) has no ELF relocation")
		return
	}
	var v int64 = r.Val
	if !r.NegDot {
		var nl diffLocation = locationOf(p, r.Neg, false)
		if !nl.Ok || nl.Sec != p.Asm.Current {
			setErr(p,
					quotedName(asm.LabelForMessage(r.Neg),
							" is in another section than the datum: no ELF relocation subtracts it"))
			return
		}
		v = v + cast(int64, p.Asm.CurrentOffset()) - cast(int64, nl.Off)
		unmarkAliasesOf(p, r.Neg) // folded into the addend
	}
	var kind int = dataPcrelKind(p, size)
	if kind < 0 { return }
	if !intFits(v) || (p.Arch == ARCH_ARM32 && !dataValueOk(v, size)) {
		setErr(p, "data addend out of range for the field")
		return
	}
	p.Asm.AddFixup(r.Sym, kind, cast(int, v), size)
	p.Asm.Zero(size)
}

// dataPcrelKind returns the PC-relative data relocation kind of a size-byte datum, or -1
// with the error set for a size the target has none for: AArch64 takes 2, 4 and 8 bytes,
// arm32 4 (R_ARM_REL32), x86-64 all four.
func dataPcrelKind(p @Parser, size int) int {
	if p.Arch == ARCH_ARM32 && size != 4 {
		setErr(p, "a PC-relative datum on arm32 is 4 bytes (R_ARM_REL32)")
		return -1
	}
	if p.Arch == ARCH_AARCH64 && size == 1 {
		setErr(p, "a 1-byte PC-relative datum has no AArch64 relocation")
		return -1
	}
	if size == 1 { return asm.FIX_DATA_PCREL8 }
	if size == 2 { return asm.FIX_DATA_PCREL16 }
	if size == 4 { return asm.FIX_DATA_PCREL32 }
	return asm.FIX_DATA_PCREL64
}

// emitDataNumber emits v as a size-byte little-endian datum.
func emitDataNumber(p @Parser, v int64, size int) {
	switch size {
	case 1:
		p.Asm.EmitUint8(cast(uint8, v))
	case 2:
		p.Asm.EmitUint16(cast(uint16, v))
	case 4:
		p.Asm.EmitUint32(cast(uint32, v))
	case 8:
		p.Asm.EmitUint64(cast(uint64, v))
	}
}

// dataFixupKind returns the data relocation kind of a size-byte symbol value (signed for
// `.intN`), or -1 with the error set for a size the target has no relocation for.
func dataFixupKind(p @Parser, size int, signed bool) int {
	if size == 1 {
		if p.Arch == ARCH_AARCH64 && p.Asm.ObjFormat == asm.OBJ_ELF {
			setErr(p, "a 1-byte datum has no AArch64 ELF relocation; only a number fits it")
			return -1
		}
		return asm.FIX_DATA_ABS8
	}
	if size == 2 { return asm.FIX_DATA_ABS16 }
	if size == 4 {
		if signed { return asm.FIX_DATA_ABS32S }
		return asm.FIX_DATA_ABS32
	}
	if p.Arch == ARCH_ARM32 {
		setErr(p, "an 8-byte datum has no arm32 relocation; only a number fits it")
		return -1
	}
	return asm.FIX_DATA_ABS64
}
