package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// Symbols in the sized data directives: a symbol plus a number is a data relocation of the
// directive's size (zeros in the data, the addend in the fixup), on each architecture; a
// size clang has no relocation for is rejected.  (sectionBytesHex is in
// expr_diff_test.bn.)

// dataSource assembles src for arch and format after `.section data` (section 0).
func dataSource(arch *[]readonly char, src *[]readonly char, format int) @Parser {
	var p @Parser = newTestParser()
	p.Asm.ObjFormat = format
	p.ParseSource(buf.Concat(buf.Concat(buf.Concat(".arch ", arch), "\n.section data\n"), src))
	return p
}

// dataFixupIs reports whether fixup i of p's section 0 is at off, of kind with addend,
// against label ("" for a label made for `.`).
func dataFixupIs(p @Parser, i int, off int, kind int, addend int, label *[]readonly char) bool {
	var s @asm.Section = p.Asm.Sections[0]
	if i >= s.NumFixups { return false }
	var f asm.Fixup = s.Fixups[i]
	if cast(int, f.Offset) != off || f.Kind != kind || f.Addend != addend { return false }
	if len(label) == 0 { return asm.IsGeneratedLabel(f.Label) }
	return charsEqual(f.Label, label)
}

// dataReject checks that src is rejected for arch and format with a diagnostic containing
// want.
func dataReject(e @[]char, arch *[]readonly char, src *[]readonly char, format int,
		want *[]readonly char) @[]char {
	var p @Parser = dataSource(arch, src, format)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = p.Asm.ErrorMsg }
	if !p.HasError && !p.Asm.HasError { return buf.Concat(buf.Concat(e, src), ": accepted\n") }
	if !plContains(msg, want) {
		return buf.Concat(buf.Concat(e, src), buf.Concat(": ", buf.Concat(msg, "\n")))
	}
	return e
}

// An external symbol, a label (here, forward too), an alias and `.` plus numbers, in data
// of each size, on AArch64 ELF: relocations ABS16 / ABS32 / signed ABS32 / ABS64 with the
// addend, zeros in the data, numbers in a list beside them unchanged.
func TestDataSymbols() testing.TestResult {
	var p @Parser = dataSource("aarch64",
			".global ext\nl: .uint16 ext + 2\n.uint32 ext\n.int32 ext - 4\n.uint64 l\n.uint64 . + 8\n"
					"A = l + 8\n.uint64 A\n.uint64 fwd\nfwd: .uint32 1, ext, 2",
			asm.OBJ_ELF)
	if p.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return fail(buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	if p.Asm.Sections[0].NumFixups != 8 { return fail("not eight fixups") }
	if !dataFixupIs(p, 0, 0, asm.FIX_DATA_ABS16, 2, "ext") { return fail("ext + 2 in a halfword") }
	if !dataFixupIs(p, 1, 2, asm.FIX_DATA_ABS32, 0, "ext") { return fail("ext in a word") }
	if !dataFixupIs(p, 2, 6, asm.FIX_DATA_ABS32S, -4, "ext") {
		return fail("ext - 4 in a signed word")
	}
	if !dataFixupIs(p, 3, 10, asm.FIX_DATA_ABS64, 0, "l") { return fail("l in a doubleword") }
	if !dataFixupIs(p, 4, 18, asm.FIX_DATA_ABS64, 8, "") { return fail(". + 8") }
	if !dataFixupIs(p, 5, 26, asm.FIX_DATA_ABS64, 8, "l") { return fail("the alias l + 8") }
	if !dataFixupIs(p, 6, 34, asm.FIX_DATA_ABS64, 0, "fwd") { return fail("the forward label") }
	if !dataFixupIs(p, 7, 46, asm.FIX_DATA_ABS32, 0, "ext") { return fail("ext in a list") }
	// 42 zero bytes (the relocated fields), then the list's 1, the field for ext, and 2.
	var b @strings.Builder = strings.NewBuilder()
	for i := 0; i < 42; i++ { b.Write("00") }
	b.Write("010000000000000002000000")
	var want @[]char = buf.CopyStr(b.String())
	if !charsEqual(sectionBytesHex(p, 0), want) {
		return fail(buf.Concat("data: ", sectionBytesHex(p, 0)))
	}
	return ""
}

// Each architecture's data relocation sizes, as clang's: arm32 1, 2 and 4 bytes, x86-64 all
// four (`.int32` signed), AArch64 Mach-O one byte too; AArch64 ELF has no 1-byte one and
// arm32 no 8-byte one.
func TestDataSymbolSizes() testing.TestResult {
	var e @[]char = ""
	var p @Parser = dataSource("arm32", ".global ext\n.uint8 ext + 1\n.uint16 ext\n.int32 ext",
			asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 0, asm.FIX_DATA_ABS8, 1, "ext") ||
			!dataFixupIs(p, 1, 1, asm.FIX_DATA_ABS16, 0, "ext") ||
			!dataFixupIs(p, 2, 3, asm.FIX_DATA_ABS32S, 0, "ext") {
		e = buf.Concat(e, "arm32 sizes\n")
	}
	p = dataSource("x64", ".global ext\n.uint8 ext\n.int16 ext\n.uint32 ext\n.int32 ext\n.int64 ext",
			asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 0, asm.FIX_DATA_ABS8, 0, "ext") ||
			!dataFixupIs(p, 1, 1, asm.FIX_DATA_ABS16, 0, "ext") ||
			!dataFixupIs(p, 2, 3, asm.FIX_DATA_ABS32, 0, "ext") ||
			!dataFixupIs(p, 3, 7, asm.FIX_DATA_ABS32S, 0, "ext") ||
			!dataFixupIs(p, 4, 11, asm.FIX_DATA_ABS64, 0, "ext") {
		e = buf.Concat(e, "x86-64 sizes\n")
	}
	p = dataSource("aarch64", ".global _ext\n.uint8 _ext + 3", asm.OBJ_MACHO)
	if p.HasError || !dataFixupIs(p, 0, 0, asm.FIX_DATA_ABS8, 3, "_ext") {
		e = buf.Concat(e, "aarch64 Mach-O byte\n")
	}
	e = dataReject(e, "aarch64", ".global ext\n.uint8 ext", asm.OBJ_ELF,
			"1-byte datum has no AArch64 ELF")
	e = dataReject(e, "arm32", ".global ext\n.uint64 ext", asm.OBJ_ELF, "8-byte datum has no arm32")
	e = dataReject(e, "aarch64", ".uint64 F\nF = 3", asm.OBJ_ELF, "'F' was used as a symbol earlier")
	e = dataReject(e, "aarch64", ".global ext\n.uint32 -ext", asm.OBJ_ELF, "cannot be negated")
	e = dataReject(e, "aarch64", ".global ext\n.uint32 ext * 2", asm.OBJ_ELF, "")
	return e
}

// Where a target keeps a data relocation's addend in the field itself — arm32's REL, Mach-O
// — the addend must fit the field (signed or unsigned); an ELF RELA addend (AArch64, x86-64)
// takes any value.
func TestDataAddendFitsField() testing.TestResult {
	var e @[]char = ""
	var want *[]readonly char = "data addend out of range for the field"
	e = dataReject(e, "arm32", ".global ext\n.uint8 ext + 256", asm.OBJ_ELF, want)
	e = dataReject(e, "arm32", ".global ext\n.uint16 ext - 32769", asm.OBJ_ELF, want)
	e = dataReject(e, "aarch64", ".global _ext\n.uint8 _ext + 300", asm.OBJ_MACHO, want)
	e = dataReject(e, "x64", ".global _ext\n.uint16 _ext + 65536", asm.OBJ_MACHO, want)
	var p @Parser = dataSource("arm32", ".global ext\n.uint8 ext + 255\n.int16 ext - 32768",
			asm.OBJ_ELF)
	if p.HasError { e = buf.Concat(e, "arm32 edges rejected\n") }
	p = dataSource("aarch64", ".global ext\n.uint16 ext + 70000", asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 0, asm.FIX_DATA_ABS16, 70000, "ext") {
		e = buf.Concat(e, "an AArch64 ELF addend beyond the field rejected\n")
	}
	p = dataSource("x64", ".global ext\n.uint8 ext + 300", asm.OBJ_ELF)
	if p.HasError { e = buf.Concat(e, "an x86-64 ELF addend beyond the field rejected\n") }
	return e
}

// A difference not fixed at assembly in data is, on ELF, a PC-relative relocation against
// the minuend whose addend folds in the distance from the subtrahend to the field: `.`, or a
// label in the datum's own section (here also one after it); the minuend may be in another
// section (here one after it) or external.
func TestDataDifferences() testing.TestResult {
	var p @Parser = dataSource("aarch64",
			".global ext\nd: .uint32 ext - .\n.uint64 f - .\n.uint16 ext - d + 2\n.uint32 ext - l\n"
					"l: .uint32 0\n.section text\nf: nop",
			asm.OBJ_ELF)
	if p.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return fail(buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	if !dataFixupIs(p, 0, 0, asm.FIX_DATA_PCREL32, 0, "ext") { return fail("ext - .") }
	if !dataFixupIs(p, 1, 4, asm.FIX_DATA_PCREL64, 0, "f") {
		return fail("f - . (f in text, after it)")
	}
	if !dataFixupIs(p, 2, 12, asm.FIX_DATA_PCREL16, 14, "ext") { return fail("ext - d + 2") }
	if !dataFixupIs(p, 3, 14, asm.FIX_DATA_PCREL32, -4, "ext") { return fail("ext - l (l after it)") }
	return ""
}

// The PC-relative data sizes, as clang's: x86-64 all four, arm32 4 bytes (R_ARM_REL32),
// AArch64 2, 4 and 8.
func TestDataDifferenceSizes() testing.TestResult {
	var e @[]char = ""
	var p @Parser = dataSource("x64",
			".global ext\n.uint8 ext - .\n.uint16 ext - .\n.uint32 ext - .\n.uint64 ext - .", asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 0, asm.FIX_DATA_PCREL8, 0, "ext") ||
			!dataFixupIs(p, 1, 1, asm.FIX_DATA_PCREL16, 0, "ext") ||
			!dataFixupIs(p, 2, 3, asm.FIX_DATA_PCREL32, 0, "ext") ||
			!dataFixupIs(p, 3, 7, asm.FIX_DATA_PCREL64, 0, "ext") {
		e = buf.Concat(e, "x86-64 sizes\n")
	}
	p = dataSource("arm32", ".global ext\n.uint32 ext - . + 4", asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 0, asm.FIX_DATA_PCREL32, 4, "ext") {
		e = buf.Concat(e, "arm32 REL32\n")
	}
	e = dataReject(e, "arm32", ".global ext\n.uint16 ext - .", asm.OBJ_ELF,
			"PC-relative datum on arm32 is 4 bytes")
	e = dataReject(e, "arm32", ".global ext\n.uint64 ext - .", asm.OBJ_ELF,
			"PC-relative datum on arm32 is 4 bytes")
	e = dataReject(e, "aarch64", ".global ext\n.uint8 ext - .", asm.OBJ_ELF,
			"1-byte PC-relative datum")
	return e
}

// A location added to a difference a fixed distance from the location it subtracts folds into
// the addend, as clang reads it: `ext - l1 + l2` is ext + (l2 - l1), `ext - . + l2` ext + (l2 -
// .) — absolute relocations.
func TestDataDifferenceReassociated() testing.TestResult {
	var p @Parser = dataSource("aarch64",
			".global ext\nl1: .uint32 0\nl2: .uint32 ext - l1 + l2\n.uint32 ext - . + l2", asm.OBJ_ELF)
	if p.HasError { return fail(buf.Concat("rejected: ", p.ErrorMsg)) }
	if !dataFixupIs(p, 0, 4, asm.FIX_DATA_ABS32, 4, "ext") { return fail("ext - l1 + l2") }
	if !dataFixupIs(p, 1, 8, asm.FIX_DATA_ABS32, -4, "ext") { return fail("ext - . + l2") }
	return ""
}

// Rejected on ELF: a subtrahend in another section ("Cannot represent a difference across
// sections" in clang), the current location minus a symbol, an external subtrahend; on
// Mach-O a difference in data is not yet supported.
func TestDataDifferenceRejects() testing.TestResult {
	var e @[]char = ""
	e = dataReject(e, "aarch64", ".global ext\n.section text\nt: nop\n.section data\n.uint32 ext - t",
			asm.OBJ_ELF, "'t' is in another section than the datum")
	e = dataReject(e, "aarch64", ".section text\nt: nop\n.section data\n.uint32 . - t", asm.OBJ_ELF,
			"(`. - sym`) has no ELF relocation")
	e = dataReject(e, "aarch64", ".global ext\n.uint32 . - ext", asm.OBJ_ELF,
			"'ext' is not a label defined anywhere")
	e = dataReject(e, "aarch64", ".global ext\nl: .uint32 l - ext", asm.OBJ_ELF,
			"'ext' is not a label defined anywhere")
	e = dataReject(e, "aarch64", ".global _ext\n.uint32 _ext - .", asm.OBJ_MACHO,
			"not supported in Mach-O data")
	return e
}

// An alias standing in a location folded into the addend — one added to a difference a fixed
// distance from its subtrahend, or a PC-relative datum's subtrahend — is not used through
// its symbol, so it may be made global after, as clang allows; the minuend's alias is.  A
// difference in data needs the object format; an undeclared minuend's error says to
// declare it.
func TestDataDifferenceAliasesAndErrors() testing.TestResult {
	var e @[]char = ""
	var p @Parser = dataSource("aarch64",
			".global ext\nl1: .uint32 0\nl2: .uint32 0\nA1 = l1\nA2 = l2 + 4\n.uint32 ext - A1 + A2\n"
					".global A2",
			asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 8, asm.FIX_DATA_ABS32, 8, "ext") {
		e = buf.Concat(e, buf.Concat("a folded alias made global: ", buf.Concat(p.ErrorMsg, "\n")))
	}
	p = dataSource("aarch64", ".global ext\nl1: .uint32 0\nA1 = l1\n.uint32 ext - A1\n.global A1",
			asm.OBJ_ELF)
	if p.HasError || !dataFixupIs(p, 0, 4, asm.FIX_DATA_PCREL32, 4, "ext") {
		e = buf.Concat(e, buf.Concat("a subtrahend alias made global: ", buf.Concat(p.ErrorMsg, "\n")))
	}
	e = dataReject(e, "aarch64",
			".section text\nf: nop\n.section data\nM = f\n.uint32 M - .\n.global M", asm.OBJ_ELF,
			"used before being made global")
	e = dataReject(e, "aarch64", ".global ext\n.uint32 ext - .", asm.OBJ_UNKNOWN,
			"needs the object format")
	e = dataReject(e, "aarch64", ".uint32 ext - .", asm.OBJ_ELF,
			"(an external symbol is declared .global)")
	return e
}
