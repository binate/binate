package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// --- Directive parsing ---
//
// Each directive's helper parses its operands and returns the lexer and the token
// after them; parseDirective then requires that token to end the line, so trailing
// text after a directive's operands is an error rather than silently ignored.

// parseDirective handles the directive name (its '.' dropped; l positioned after it):
// .arch, .section, .global, .global_c, .local, .weak, .balign, .p2align, .zero, .fill,
// .ascii, .asciz, and the sized data directives .{u,}int{8,16,32,64}.  `.align` is
// rejected: GNU and clang read its operand as a byte count on some targets and as a
// power of two on others (AArch64, ARM), so the same text would mean different
// alignments — .balign / .p2align say which.
func parseDirective(p @Parser, l Lexer, name *[]readonly char) {
	var tok Token
	var known bool = true
	if charsEqual(name, "arch") {
		l, tok = parseArchDirective(p, l)
	} else if charsEqual(name, "section") {
		l, tok = parseSectionDirective(p, l)
	} else if charsEqual(name, "global") {
		l, tok = parseSymbolDirective(p, l, asm.BIND_GLOBAL)
	} else if charsEqual(name, "global_c") {
		l, tok = parseCSymbolDirective(p, l)
	} else if charsEqual(name, "local") {
		l, tok = parseSymbolDirective(p, l, asm.BIND_LOCAL)
	} else if charsEqual(name, "weak") {
		l, tok = parseSymbolDirective(p, l, asm.BIND_WEAK)
	} else if charsEqual(name, "balign") {
		l, tok = parseAlignDirective(p, l, false)
	} else if charsEqual(name, "p2align") {
		l, tok = parseAlignDirective(p, l, true)
	} else if charsEqual(name, "align") {
		setErr(p, ".align is target-dependent (bytes or a power of two); use .balign or .p2align")
		return
	} else if charsEqual(name, "zero") {
		l, tok = parseZeroDirective(p, l)
	} else if charsEqual(name, "fill") {
		l, tok = parseFillDirective(p, l)
	} else if charsEqual(name, "ascii") {
		l, tok = parseAsciiDirective(p, l, false)
	} else if charsEqual(name, "asciz") {
		l, tok = parseAsciiDirective(p, l, true)
	} else if charsEqual(name, "uint8") || charsEqual(name, "int8") {
		l, tok = parseDataDirective(p, l, 1)
	} else if charsEqual(name, "uint16") || charsEqual(name, "int16") {
		l, tok = parseDataDirective(p, l, 2)
	} else if charsEqual(name, "uint32") || charsEqual(name, "int32") {
		l, tok = parseDataDirective(p, l, 4)
	} else if charsEqual(name, "uint64") || charsEqual(name, "int64") {
		l, tok = parseDataDirective(p, l, 8)
	} else {
		known = false
	}
	if !known {
		setErr(p, "unknown directive")
		return
	}
	if !p.HasError && tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the directive's operands")
	}
}

// parseArchDirective handles ".arch aarch64|arm64|arm32|arm|x64|x86_64".
func parseArchDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT {
		setErr(p, "expected architecture name")
		return l, tok
	}
	if charsEqual(tok.Text, "aarch64") || charsEqual(tok.Text, "arm64") {
		p.SetArch(ARCH_AARCH64)
	} else if charsEqual(tok.Text, "arm32") || charsEqual(tok.Text, "arm") {
		p.SetArch(ARCH_ARM32)
	} else if charsEqual(tok.Text, "x64") || charsEqual(tok.Text, "x86_64") {
		p.SetArch(ARCH_X64)
	} else {
		setErr(p, "unknown architecture")
		return l, tok
	}
	l, tok = LexNext(l)
	return l, tok
}

// parseSectionDirective handles ".section name".  A section name is bare (`text`,
// `rodata`): each object writer gives it its format's spelling (`.text`, `__TEXT,__text`),
// so a `.`-leading one would be doubled.
func parseSectionDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || tok.Text[0] == '.' || isDigit(tok.Text[0]) {
		setErr(p, "expected a bare section name (text, data, rodata, ...)")
		return l, tok
	}
	p.Asm.SetSection(tok.Text, -1)
	l, tok = LexNext(l)
	return l, tok
}

// parseSymbolDirective handles ".global name", ".local name" and ".weak name".
func parseSymbolDirective(p @Parser, l Lexer, binding int) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) {
		setErr(p, "expected symbol name")
		return l, tok
	}
	var name @[]char = buf.CopyStr(tok.Text)
	if binding != asm.BIND_LOCAL && aliasUsedBeforeBinding(p, name) {
		return l, tok
	}
	if binding == asm.BIND_GLOBAL {
		p.Asm.SetGlobal(name)
	} else if binding == asm.BIND_WEAK {
		p.Asm.SetWeak(name)
	}
	l, tok = LexNext(l)
	return l, tok
}

// parseCSymbolDirective handles ".global_c name": a global symbol that carries
// the platform C-symbol prefix (`_` on Mach-O, none on ELF — see
// Assembler.SetGlobalC), so one hand-written `.s` can define a Binate function
// symbol that resolves under both object formats.
func parseCSymbolDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) {
		setErr(p, "expected symbol name")
		return l, tok
	}
	var name @[]char = buf.CopyStr(tok.Text)
	if aliasUsedBeforeBinding(p, name) { return l, tok }
	p.Asm.SetGlobalC(name)
	l, tok = LexNext(l)
	return l, tok
}

// parseDirectiveExpr parses one expression operand of a directive (tok its first
// token), setting msg as the error when it is invalid.
func parseDirectiveExpr(p @Parser, l Lexer, tok Token,
		msg *[]readonly char) (Lexer, Token, int64, bool) {
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, msg))
		return l, tok, 0, false
	}
	return l, tok, r.Val, true
}

// byteValueOk reports whether v fits a byte, read as signed or unsigned.
func byteValueOk(v int64) bool { return v >= -128 && v <= 255 }

// maxDirectiveBytes bounds what one .zero / .fill / .balign / .p2align may emit or
// request (1 GiB): a larger count is far more likely a mistyped operand than a
// section anyone wants, and every count stays representable in a 32-bit host int.
const maxDirectiveBytes int64 = 0x40000000

// parseAlignDirective handles ".balign bytes [, fill]" (pow2 false: the alignment in
// bytes, a power of two) and ".p2align exp [, fill]" (pow2 true: 2^exp bytes), with
// fill a byte value — without one, zeros in a data section and no-op instructions in
// a code section; the alignment is at most maxDirectiveBytes.
func parseAlignDirective(p @Parser, l Lexer, pow2 bool) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	var align int64 = 0
	var ok bool = false
	l, tok, align, ok = parseDirectiveExpr(p, l, tok, "invalid alignment expression")
	if !ok { return l, tok }
	if pow2 {
		if align < 0 || align > 30 {
			setErr(p, ".p2align exponent out of range [0, 30]")
			return l, tok
		}
		var bytes int64 = 1
		for i := 0; cast(int64, i) < align; i++ { bytes = bytes * 2 }
		align = bytes
	} else if align < 0 || align > maxDirectiveBytes {
		setErr(p, ".balign alignment out of range")
		return l, tok
	}
	var fill int64 = 0
	if tok.Kind == TOK_COMMA {
		l, tok = LexNext(l)
		l, tok, fill, ok = parseDirectiveExpr(p, l, tok, "invalid fill expression")
		if !ok { return l, tok }
		if !byteValueOk(fill) {
			setErr(p, "fill value does not fit a byte")
			return l, tok
		}
	} else {
		// No fill in a code section: pad with no-ops, as clang does (AlignFill then
		// only records the section's alignment).
		var codePad int = alignPadInCode(p, cast(int, align))
		if codePad > 0 { emitCodePadding(p, codePad) }
	}
	p.Asm.AlignFill(cast(int, align), cast(uint8, fill))
	return l, tok
}

// parseZeroDirective handles ".zero count" (0 <= count <= maxDirectiveBytes).
func parseZeroDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	var n int64 = 0
	var ok bool = false
	l, tok, n, ok = parseDirectiveExpr(p, l, tok, "invalid zero count expression")
	if !ok { return l, tok }
	if n < 0 || n > maxDirectiveBytes {
		setErr(p, ".zero count out of range")
		return l, tok
	}
	p.Asm.Zero(cast(int, n))
	return l, tok
}

// parseFillDirective handles GNU's ".fill repeat [, size [, value]]": repeat copies
// of value as a size-byte little-endian quantity (size 0..8, default 1; value
// default 0).  GNU and clang keep only a 32-bit pattern, zero-extended for a size
// above 4, and truncate a value to a narrower size silently; here the value must be
// exactly what is emitted: for size 1..4 it must fit the size read as signed or
// unsigned, for size 5..8 it must lie in [0, 2^32 - 1].
func parseFillDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	var repeat int64 = 0
	var ok bool = false
	l, tok, repeat, ok = parseDirectiveExpr(p, l, tok, "invalid fill repeat expression")
	if !ok { return l, tok }
	var size int64 = 1
	var val int64 = 0
	if tok.Kind == TOK_COMMA {
		l, tok = LexNext(l)
		l, tok, size, ok = parseDirectiveExpr(p, l, tok, "invalid fill size expression")
		if !ok { return l, tok }
		if tok.Kind == TOK_COMMA {
			l, tok = LexNext(l)
			l, tok, val, ok = parseDirectiveExpr(p, l, tok, "invalid fill value expression")
			if !ok { return l, tok }
		}
	}
	if size < 0 || size > 8 {
		setErr(p, ".fill size out of range [0, 8]")
		return l, tok
	}
	if repeat < 0 || repeat > maxDirectiveBytes || repeat * size > maxDirectiveBytes {
		setErr(p, ".fill repeat count out of range")
		return l, tok
	}
	var fits bool = valueFitsBytes(val, cast(int, size))
	if size > 4 { fits = val >= 0 && val <= 0xFFFFFFFF }
	if !fits {
		setErr(p, ".fill value does not fit its size (a size above 4 takes 0 .. 2^32-1)")
		return l, tok
	}
	var u uint64 = bit_cast(uint64, val)
	for r := 0; cast(int64, r) < repeat; r++ {
		for b := 0; b < cast(int, size); b++ {
			p.Asm.EmitUint8(cast(uint8, (u >> cast(uint, 8 * b)) & 0xff))
		}
	}
	return l, tok
}

// valueFitsBytes reports whether v fits an n-byte field (0 <= n <= 4), read as signed
// or unsigned: [-2^(8n-1), 2^(8n) - 1]; only 0 fits 0 bytes.
func valueFitsBytes(v int64, n int) bool {
	if n == 0 { return v == 0 }
	var hi int64 = 1
	for i := 0; i < 8 * n; i++ { hi = hi * 2 }
	return v >= 0 - hi / 2 && v <= hi - 1
}

// parseAsciiDirective handles ".ascii str" and ".asciz str".
// nullTerm controls whether a null terminator is appended.
func parseAsciiDirective(p @Parser, l Lexer, nullTerm bool) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_STRING {
		setErr(p, "expected string literal")
		return l, tok
	}
	// bnlint:allow managed-to-raw-assign - tok is a live token; Text outlives the read
	var s *[]readonly char = tok.Text
	for i := 0; i < len(s); i++ {
		p.Asm.EmitUint8(s[i])
	}
	if nullTerm {
		p.Asm.EmitUint8(0)
	}
	l, tok = LexNext(l)
	return l, tok
}

// dataValueOk reports whether v fits a size-byte datum, read as signed or unsigned
// (a 64-bit datum takes any value).
func dataValueOk(v int64, size int) bool {
	if size == 1 { return v >= -128 && v <= 255 }
	if size == 2 { return v >= -32768 && v <= 65535 }
	if size == 4 { return v >= -2147483648 && v <= 4294967295 }
	return true
}

// parseDataDirective handles the sized data directives
// `.{u,}int{8,16,32,64} expr [, expr ...]`.  size is 1, 2, 4, or 8; a value that does
// not fit the size is an error rather than silently truncated.
func parseDataDirective(p @Parser, l Lexer, size int) (Lexer, Token) {
	var tok Token
	l, tok = LexNext(l)
	for {
		var v int64 = 0
		var ok bool = false
		l, tok, v, ok = parseDirectiveExpr(p, l, tok, "invalid data expression")
		if !ok { return l, tok }
		if !dataValueOk(v, size) {
			setErr(p, "data value does not fit the directive's size")
			return l, tok
		}
		switch size {
		case 1:
			p.Asm.EmitUint8(cast(uint8, v))
		case 2:
			p.Asm.EmitUint16(cast(uint16, v))
		case 4:
			p.Asm.EmitUint32(cast(uint32, v))
		case 8:
			p.Asm.EmitUint64(cast(uint64, v))
		}
		if tok.Kind != TOK_COMMA { return l, tok }
		l, tok = LexNext(l)
	}
	return l, tok
}
