package "pkg/binate/asm/parse"

import "pkg/binate/asm/elf"
import "pkg/binate/asm/macho"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// `.balign` beyond padding: the alignment it requests must be one an object file can
// express, and the section itself must end up at least that aligned — padding only
// aligns relative to the section start, so a section placed at a lower alignment by
// the linker leaves the "aligned" data misaligned.  Expectations are clang's
// (`clang -c -target arm64-apple-macos11`, `otool -l`).

// alignReadObj returns the first 64 KiB of the file at path, zero-padded (all zeros if
// it cannot be read).
func alignReadObj(path *[]readonly char) @[]uint8 {
	var data @[]uint8 = make_slice(uint8, 65536)
	f, oerr := os.Open(path)
	if present(oerr) { return data }
	var total int = 0
	for total < len(data) {
		n, _ := f.Read(data[total:len(data)])
		if n <= 0 { break }
		total = total + n
	}
	_ = f.Close()
	return data
}

// alignObjU32 reads the little-endian uint32 at off in b.
func alignObjU32(b *[]readonly uint8, off int) uint32 {
	return cast(uint32, b[off]) | (cast(uint32, b[off + 1]) << 8) | (cast(uint32, b[off + 2]) << 16) |
			(cast(uint32, b[off + 3]) << 24)
}

// A `.balign` that is not a power of two, or is negative, is an error (clang:
// "alignment must be a power of 2"): no object format can give a section such an
// alignment, so it could never be honored.
func TestDirectiveAlignPowerOfTwo() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".uint8 1\n.balign 3")
	e = dirReject(e, ".uint8 1\n.balign 12")
	e = dirReject(e, ".uint8 1\n.balign -4")
	e = dirReject(e, ".uint8 1\n.balign 6, 0xff")
	e = dirData(e, ".uint8 1\n.balign 16", "01000000000000000000000000000000")
	return e
}

// `.balign 64` in the data section raises the Mach-O section's alignment to at least
// 2^6 (clang: `.balign 64` in `__data` gives `align 2^6 (64)`).
func TestDirectiveAlignRaisesMachOSectionAlign() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var p @Parser = dirParse(".uint8 1\n.balign 64\n.uint64 5")
	if p.HasError { return fail(p.ErrorMsg) }
	if !p.Asm.Finalize() { return fail("finalize failed") }
	var path @[]char = buf.Concat(dir, "/parse_align_test_macho.o")
	if !macho.WriteARM64(p.Asm, path) { return fail("Mach-O write failed") }
	var obj @[]uint8 = alignReadObj(path)
	if alignObjU32(obj, 0) != 0xFEEDFACF || alignObjU32(obj, 32) != 0x19 {
		return fail("unexpected Mach-O layout (want MH_MAGIC_64 then LC_SEGMENT_64)")
	}
	// The first section_64 follows the 32-byte header and the 72-byte segment
	// command; its align field (a power-of-two exponent) is at offset 52.
	if alignObjU32(obj, 32 + 72 + 52) < 6 {
		return fail("data section's Mach-O alignment is below 2^6 after .balign 64")
	}
	return ""
}

// `.balign 64` in the data section raises the ELF section's sh_addralign to at least 64.
func TestDirectiveAlignRaisesElfSectionAlign() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var p @Parser = dirParse(".uint8 1\n.balign 64\n.uint64 5")
	if p.HasError { return fail(p.ErrorMsg) }
	if !p.Asm.Finalize() { return fail("finalize failed") }
	var path @[]char = buf.Concat(dir, "/parse_align_test_elf.o")
	if !elf.WriteAArch64(p.Asm, path) { return fail("ELF write failed") }
	var obj @[]uint8 = alignReadObj(path)
	if alignObjU32(obj, 0) != 0x464C457F || obj[4] != 2 {
		return fail("unexpected ELF header (want ELFCLASS64)")
	}
	// e_shoff (low 32 bits suffice for a small object) is at 0x28 and e_shentsize at
	// 0x3A; header 0 is the null section, so the data section's header is the next one,
	// with sh_addralign (low 32 bits) at offset 0x30.
	var shoff int = cast(int, alignObjU32(obj, 0x28))
	var shentsize int = cast(int, obj[0x3A]) | (cast(int, obj[0x3B]) << 8)
	if shoff <= 0 || shoff + 2 * shentsize > len(obj) { return fail("bad ELF section table") }
	if alignObjU32(obj, shoff + shentsize + 0x30) < 64 {
		return fail("data section's ELF sh_addralign is below 64 after .balign 64")
	}
	return ""
}
