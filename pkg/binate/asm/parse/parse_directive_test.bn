package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Directive tests.  Each case parses its lines ('\n'-separated) after `.section data`
// in a fresh parser and checks the bytes emitted into that section (as uppercase hex
// pairs) or that the lines are rejected.  The byte expectations are clang's for the
// equivalent GNU directive (`.byte`/`.short`/`.long`/`.quad`, `.balign`, `.zero`,
// `.fill n, 1, v`, `.ascii`), `clang -c -target arm64-apple-macos11`.

// dirRun parses each '\n'-separated line of src into p.
func dirRun(p @Parser, src *[]readonly char) {
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
}

// dirParse returns a fresh parser that has parsed `.section data` and then src.
func dirParse(src *[]readonly char) @Parser {
	var p @Parser = newTestParser()
	p.ParseLine(".section data")
	dirRun(p, src)
	return p
}

// dirHex returns the bytes of p's first section as uppercase hex pairs.
func dirHex(p @Parser) @[]char {
	var s @asm.Section = p.Asm.Sections[0]
	return litHex(s.Data[0:s.Len])
}

// dirData checks that src is accepted and emits exactly the bytes wantHex.
func dirData(e @[]char, src *[]readonly char, wantHex *[]readonly char) @[]char {
	var p @Parser = dirParse(src)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	var got @[]char = dirHex(p)
	if !charsEqual(got, wantHex) { return goldenFail(e, src, buf.Concat("emitted ", got)) }
	return e
}

// dirReject checks that src is rejected with an error.
func dirReject(e @[]char, src *[]readonly char) @[]char {
	var p @Parser = dirParse(src)
	if !p.HasError { return goldenFail(e, src, buf.Concat("accepted, emitting ", dirHex(p))) }
	return e
}

// --- End of line ---

// Every directive must end the line after its operands: a trailing token is an error
// rather than silently ignored (clang: "unexpected token" / "expected newline").
func TestDirectiveTrailingTokenRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".arch aarch64 junk")
	e = dirReject(e, ".arch aarch64, x64")
	e = dirReject(e, ".section text junk")
	e = dirReject(e, ".section text,")
	e = dirReject(e, ".global foo bar")
	e = dirReject(e, ".global_c foo bar")
	e = dirReject(e, ".local foo bar")
	e = dirReject(e, ".weak foo bar")
	e = dirReject(e, ".balign 4 4")
	e = dirReject(e, ".balign 4, 0 0")
	e = dirReject(e, ".zero 4 4")
	e = dirReject(e, ".fill 1, 2, 3 4")
	e = dirReject(e, ".ascii \"a\" x")
	e = dirReject(e, ".asciz \"a\" 1")
	e = dirReject(e, ".uint8 1 2")
	e = dirReject(e, ".uint16 1 2")
	e = dirReject(e, ".uint32 1 x")
	e = dirReject(e, ".uint64 1 (2)")
	e = dirReject(e, ".int8 1 ]")
	return e
}

// A `//` or `/* */` comment after (or among) a directive's operands is not a trailing
// token.
func TestDirectiveTrailingCommentAccepted() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".arch aarch64 // c", "")
	e = dirData(e, ".global foo /* c */", "")
	e = dirData(e, ".uint8 1 // c", "01")
	e = dirData(e, ".uint8 1 /* c */", "01")
	e = dirData(e, ".uint8 /* c */ 2", "02")
	e = dirData(e, ".uint8 1, /* c */ 2", "0102")
	e = dirData(e, ".asciz \"a\" // c", "6100")
	e = dirData(e, ".zero 1 // c", "00")
	e = dirData(e, "/* c */ .uint8 3", "03")
	return e
}

// An unknown directive name, or a '.' with no name after it, is an error.
func TestDirectiveUnknownRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".bogus 1")
	e = dirReject(e, ".uint24 1")
	e = dirReject(e, ".")
	e = dirReject(e, ". 1")
	return e
}

// --- Sized data ---

// Each sized directive emits its values little-endian, accepting both the signed and
// the unsigned range of its size (clang `.byte`/`.short`/`.long`/`.quad` bytes).
func TestDirectiveDataValues() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".uint8 255, -128, 0", "FF8000")
	e = dirData(e, ".int8 -1, 127, 255", "FF7FFF")
	e = dirData(e, ".uint16 65535, -32768", "FFFF0080")
	e = dirData(e, ".int16 0x1234", "3412")
	e = dirData(e, ".uint32 4294967295", "FFFFFFFF")
	e = dirData(e, ".int32 -2147483648", "00000080")
	e = dirData(e, ".uint32 0xDEADBEEF", "EFBEADDE")
	e = dirData(e, ".uint64 0xFFFFFFFFFFFFFFFF", "FFFFFFFFFFFFFFFF")
	e = dirData(e, ".uint64 18446744073709551615", "FFFFFFFFFFFFFFFF")
	e = dirData(e, ".uint64 0x8000000000000000", "0000000000000080")
	e = dirData(e, ".int64 -1", "FFFFFFFFFFFFFFFF")
	e = dirData(e, ".int64 0x0102030405060708", "0807060504030201")
	e = dirData(e, ".uint8 017, 0o17, 0x0f, 0b1111, 15", "0F0F0F0F0F")
	e = dirData(e, ".uint8 (1 + 2) * 3, ~0 & 0xff", "09FF")
	e = dirData(e, ".uint8 'a', '\\n'", "610A")
	e = dirData(e, ".uint8 1\n.uint16 2\n.uint8 3", "01020003")
	return e
}

// A value outside both the signed and unsigned range of the directive's size is an
// error, not truncated (clang: "out of range literal value").
func TestDirectiveDataRangeRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".uint8 256")
	e = dirReject(e, ".uint8 -129")
	e = dirReject(e, ".int8 256")
	e = dirReject(e, ".int8 -129")
	e = dirReject(e, ".uint8 1, 256")
	e = dirReject(e, ".uint8 0x80 + 0x80")
	e = dirReject(e, ".uint16 65536")
	e = dirReject(e, ".int16 -32769")
	e = dirReject(e, ".uint32 4294967296")
	e = dirReject(e, ".int32 -2147483649")
	e = dirReject(e, ".uint32 1 << 32")
	return e
}

// A missing or malformed operand expression is an error: empty, a dangling comma, `$`
// (no location-counter support), an unclosed '(', an invalid octal literal, and a
// division by zero.
func TestDirectiveDataExprRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".uint8")
	e = dirReject(e, ".uint8 1,")
	e = dirReject(e, ".uint8 ,1")
	e = dirReject(e, ".uint8 $")
	e = dirReject(e, ".uint8 $ + 1")
	e = dirReject(e, ".uint8 (1")
	e = dirReject(e, ".uint8 (1 + 2")
	e = dirReject(e, ".uint8 08")
	e = dirReject(e, ".uint8 0o18")
	e = dirReject(e, ".uint8 1 / 0")
	e = dirReject(e, ".uint8 1 % 0")
	return e
}

// --- Alignment and padding ---

// `.balign n [, fill]` pads to a multiple of n bytes and `.p2align k [, fill]` to a
// multiple of 2^k, with zeros or with the fill byte, which may be given signed or
// unsigned; alignment 1 (or `.balign 0`) and an already-aligned position pad nothing.
func TestDirectiveAlign() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".uint8 1\n.balign 4", "01000000")
	e = dirData(e, ".uint8 1\n.balign 4, 0xAB", "01ABABAB")
	e = dirData(e, ".uint8 1\n.balign 4, -1", "01FFFFFF")
	e = dirData(e, ".uint8 1\n.balign 4, -128", "01808080")
	e = dirData(e, ".uint8 1\n.balign 4, 255", "01FFFFFF")
	e = dirData(e, ".uint8 1\n.balign 2\n.uint8 2", "010002")
	e = dirData(e, ".uint32 1\n.balign 4", "01000000")
	e = dirData(e, ".balign 8", "")
	e = dirData(e, ".uint8 1\n.balign 0", "01")
	e = dirData(e, ".uint8 1\n.balign 1", "01")
	e = dirData(e, ".uint8 1\n.p2align 3", "0100000000000000")
	e = dirData(e, ".uint8 1\n.p2align 2, 0xAB", "01ABABAB")
	e = dirData(e, ".uint8 1\n.p2align 0", "01")
	return e
}

// A fill value that fits no byte, a missing alignment or fill expression, a `.p2align`
// exponent outside [0, 30], or a `.balign` past 1 GiB is an error; so is `.align`,
// whose operand GNU / clang read as bytes on some targets and as a power of two on
// others.
func TestDirectiveAlignRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".balign 4, 256")
	e = dirReject(e, ".balign 4, -129")
	e = dirReject(e, ".balign 4,")
	e = dirReject(e, ".balign")
	e = dirReject(e, ".balign , 1")
	e = dirReject(e, ".balign $")
	e = dirReject(e, ".balign 0x80000000")
	e = dirReject(e, ".p2align 31")
	e = dirReject(e, ".p2align -1")
	e = dirReject(e, ".align 4")
	e = dirReject(e, ".align 2, 0")
	return e
}

// `.zero n` emits n zero bytes.
func TestDirectiveZero() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".zero 3", "000000")
	e = dirData(e, ".zero 0", "")
	e = dirData(e, ".uint8 7\n.zero 2", "070000")
	e = dirData(e, ".zero 1 + 1", "0000")
	return e
}

// A negative or missing `.zero` count is an error (clang: "invalid number of bytes").
func TestDirectiveZeroRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".zero -1")
	e = dirReject(e, ".zero 0 - 5")
	e = dirReject(e, ".zero")
	e = dirReject(e, ".zero $")
	return e
}

// `.fill repeat [, size [, value]]` (GNU) emits repeat copies of value as a size-byte
// little-endian quantity — size defaults to 1 and value to 0; a size above 4 takes a
// value in [0, 2^32 - 1] (the pattern GNU and clang keep), zero-extended.
func TestDirectiveFill() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".fill 3, 1, 0xAB", "ABABAB")
	e = dirData(e, ".fill 3", "000000")
	e = dirData(e, ".fill 2, 2", "00000000")
	e = dirData(e, ".fill 0, 1, 1", "")
	e = dirData(e, ".fill 2, 1, -128", "8080")
	e = dirData(e, ".fill 2, 2, 0x1234", "34123412")
	e = dirData(e, ".fill 1, 3, 0x123456", "563412")
	e = dirData(e, ".fill 2, 4, -1", "FFFFFFFFFFFFFFFF")
	e = dirData(e, ".fill 1, 8, 0x01020304", "0403020100000000")
	e = dirData(e, ".fill 1 + 1, 1, 017", "0F0F")
	return e
}

// A negative repeat, a size outside [0, 8], a value that does not fit the size (for a
// size above 4: outside [0, 2^32 - 1], which GNU and clang would silently truncate),
// a count past 1 GiB, or a missing operand is an error.
func TestDirectiveFillRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".fill -1")
	e = dirReject(e, ".fill 2, 9")
	e = dirReject(e, ".fill 2, -1")
	e = dirReject(e, ".fill 2, 1, 256")
	e = dirReject(e, ".fill 2, 1, -129")
	e = dirReject(e, ".fill 1, 2, 0x10000")
	e = dirReject(e, ".fill 1, 8, 0x0102030405060708")
	e = dirReject(e, ".fill 1, 8, -1")
	e = dirReject(e, ".fill 0x40000001")
	e = dirReject(e, ".fill 0x20000001, 2")
	e = dirReject(e, ".fill 2,")
	e = dirReject(e, ".fill , 1")
	e = dirReject(e, ".fill 2, 1, 0, 0")
	return e
}

// --- Strings ---

// `.ascii` emits a string's bytes and `.asciz` adds a NUL (clang bytes, escapes
// included; comment markers inside the string are string bytes).
func TestDirectiveAscii() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".ascii \"ab\"", "6162")
	e = dirData(e, ".asciz \"ab\"", "616200")
	e = dirData(e, ".ascii \"\"", "")
	e = dirData(e, ".asciz \"\"", "00")
	e = dirData(e, ".ascii \"a\\n\\t\\\\\\\"\\0\"", "610A095C2200")
	e = dirData(e, ".ascii \"a//b/*c\"", "612F2F622F2A63")
	e = dirData(e, ".ascii \"x\"\n.asciz \"y\"", "787900")
	return e
}

// `.ascii` / `.asciz` need a string operand.
func TestDirectiveAsciiRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".ascii")
	e = dirReject(e, ".asciz")
	e = dirReject(e, ".ascii 5")
	e = dirReject(e, ".ascii foo")
	e = dirReject(e, ".asciz 'a'")
	return e
}

// --- Malformed literals in operands ---

// A literal beyond 64 bits is an error in any sized directive, not its low 64 bits
// (clang: "literal value out of range for directive") — so `.uint8
// 0x10000000000000001` is rejected rather than emitted as 01.
func TestDirectiveOversizedLiteralRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".uint64 0x10000000000000000")
	e = dirReject(e, ".uint64 18446744073709551616")
	e = dirReject(e, ".int64 02000000000000000000000")
	e = dirReject(e, ".uint8 0x10000000000000001")
	return e
}

// A radix prefix with no digits is an error, not the value 0 (clang: `.byte 0x`
// "invalid hexadecimal number"; `.byte 0b` "directional label undefined"; `.byte
// 0o` "unexpected token").
func TestDirectiveEmptyRadixLiteralRejected() testing.TestResult {
	var e @[]char = ""
	e = dirReject(e, ".uint8 0x")
	e = dirReject(e, ".uint8 0b")
	e = dirReject(e, ".uint8 0o")
	e = dirReject(e, ".uint8 0xg")
	return e
}

// String and character escapes beyond \n \t \\ \" \0 give clang's bytes in data:
// `.ascii "\r\b\f\101\x41\012"` is 0D 08 0C 41 41 0A and `.byte '\r'` is 0D.  A
// string with an unrecognized escape or no closing quote is rejected.
func TestDirectiveStringEscapes() testing.TestResult {
	var e @[]char = ""
	e = dirData(e, ".ascii \"\\r\\b\\f\\101\\x41\\012\"", "0D080C41410A")
	e = dirData(e, ".uint8 '\\r', '\\b', '\\f'", "0D080C")
	e = dirReject(e, ".ascii \"a\\q\"")
	e = dirReject(e, ".ascii \"abc")
	e = dirReject(e, ".asciz \"a\\\"")
	return e
}
