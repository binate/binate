package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/std/os"
import "pkg/std/strings"

// ParseFile reads an assembly file from disk and parses it (ParseSource) — the
// disk-reading half of the parser, kept apart from line / directive / instruction
// parsing.
func (p @Parser) ParseFile(path *[]readonly char) {
	f, oerr := os.Open(path)
	if present(oerr) {
		setErr(p, "cannot open file")
		return
	}
	// Read entire file into a Builder
	var cb @strings.Builder = strings.NewBuilder()
	var readBuf @[]uint8 = make_slice(uint8, 4096)
	for {
		// bnlint:allow managed-to-raw-assign - readBuf is a live managed buffer; outlives the read
		var raw *[]uint8 = readBuf
		n, _ := f.Read(raw)
		if n <= 0 {
			break
		}
		for i := 0; i < n; i++ {
			cb.WriteByte(readBuf[i])
		}
	}
	_ = f.Close()

	p.ParseSource(cb.String())
}

// ParseSource parses the whole input text, assembling it a second time when a label
// difference was pending; see parse.bni.
func (p @Parser) ParseSource(text *[]readonly char) {
	var arch int = p.Arch // a target set before the input, which a second pass keeps
	var format int = p.Asm.ObjFormat
	parseText(p, text)
	if p.HasError || !p.SawPending { return }
	var prev @asm.Assembler = asm.New(p.Asm.WordSize)
	*prev = *p.Asm
	var prevGens @[]int = p.LabelGens
	var os @[]char = p.TargetOs
	var osKnown bool = p.OsKnown
	p.Asm.Reset()
	p.Asm.ObjFormat = format
	var a @asm.Assembler = p.Asm
	var file @[]char = p.FileName
	*p = *NewParser(a, file)
	if arch != ARCH_UNKNOWN { p.SetArch(arch) }
	p.TargetOs = os
	p.OsKnown = osKnown
	p.Prev = prev
	p.PrevLabelGens = prevGens
	parseText(p, text)
	if !p.HasError { checkSecondPassLayout(p) }
}

// parseText parses text line by line via ParseLine, stopping at the first error, then
// ends the input (Finish).
func parseText(p @Parser, text *[]readonly char) {
	var lineStart int = 0
	for i := 0; i <= len(text); i++ {
		if i < len(text) && text[i] != '\n' { continue }
		if i == len(text) && lineStart >= len(text) { break }
		p.ParseLine(text[lineStart:i])
		if p.HasError { return }
		lineStart = i + 1
	}
	p.Finish()
}

// checkSecondPassLayout checks that the second pass placed every label where the first
// did, which the forward label differences it folded assumed: each symbol defined in a
// section on the first pass is at the same section and offset now — but the labels made
// for `.` and literal-pool entries, which no difference names (a pending value may make a
// `.` label on one pass only).
func checkSecondPassLayout(p @Parser) {
	for i := 0; i < p.Prev.NumSymbols; i++ {
		var s asm.Symbol = p.Prev.Symbols[i]
		if s.Section < 0 || isMadeLocationLabel(s.Name) { continue }
		var j int = p.Asm.LookupSymbol(s.Name)
		if j < 0 || p.Asm.Symbols[j].Section != s.Section || p.Asm.Symbols[j].Offset != s.Offset {
			setErr(p,
					quotedName(asm.LabelForMessage(s.Name),
							" moved on the second pass (a size depended on a label after it)"))
			return
		}
	}
}

// Finish ends the input after its last line; see parse.bni.
func (p @Parser) Finish() {
	if p.HasError { return }
	if p.InComment {
		setErr(p, "unterminated /* comment at the end of the file")
		return
	}
	flushAllPools(p)
	checkFwdRefs(p)
	if !p.HasError { listConstants(p) }
}

// isMadeLocationLabel reports whether name is a label the parser made for `.` (dotLabel)
// or a literal-pool entry: a GeneratedLabelName of base "." or "=".
func isMadeLocationLabel(name *[]readonly char) bool {
	return asm.IsGeneratedLabel(name) && len(name) > 3 && name[3] == cast(char, 2) &&
			(name[2] == '.' || name[2] == '=')
}
