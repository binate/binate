package "pkg/binate/asm/parse"

import "pkg/std/os"
import "pkg/std/strings"

// ParseFile reads an assembly file from disk and parses it line by line via
// ParseLine (the disk-reading half of the parser, kept apart from line/directive/
// instruction parsing).
func (p @Parser) ParseFile(path *[]readonly char) {
	f, oerr := os.Open(path)
	if present(oerr) {
		setErr(p, "cannot open file")
		return
	}
	// Read entire file into a Builder
	var cb @strings.Builder = strings.NewBuilder()
	var readBuf @[]uint8 = make_slice(uint8, 4096)
	for {
		// bnlint:allow managed-to-raw-assign - readBuf is a live managed buffer; outlives the read
		var raw *[]uint8 = readBuf
		n, _ := f.Read(raw)
		if n <= 0 {
			break
		}
		for i := 0; i < n; i++ {
			cb.WriteByte(readBuf[i])
		}
	}
	_ = f.Close()

	var fileData @[]readonly char = cb.String()
	var totalLen int = len(fileData)

	// Split into lines and parse each
	var lineStart int = 0
	for i := 0; i < totalLen; i++ {
		if fileData[i] == '\n' {
			// bnlint:allow managed-to-raw-assign - fileData is a live managed buffer; outlives the read
			var line *[]readonly char = fileData[lineStart:i]
			p.ParseLine(line)
			if p.HasError {
				return
			}
			lineStart = i + 1
		}
	}
	// Last line (if no trailing newline)
	if lineStart < totalLen {
		// bnlint:allow managed-to-raw-assign - fileData is a live managed buffer; outlives the read
		var line *[]readonly char = fileData[lineStart:totalLen]
		p.ParseLine(line)
	}
}
