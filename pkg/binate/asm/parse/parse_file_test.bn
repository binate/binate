package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/os"

// ParseFile reads a `.s` from disk and parses it line by line.  Write a tiny
// file, parse it, and confirm a labeled global symbol landed — proving the read,
// the line split, and the label/directive parse all ran.
func TestParseFileReadsAndParses() testing.TestResult {
	var dir @[]char = testTmpDir()
	if len(dir) == 0 { return fail("cannot create a temporary directory") }
	defer os.RemoveAll(dir)
	var path @[]char = buf.Concat(dir, "/parsefile_test.s")
	writeParseTestFile(path, ".arch aarch64\n.section text\nfoo:\n.global foo\n")
	var p @Parser = newTestParser()
	p.ParseFile(path)
	if p.HasError {
		return fail(p.ErrorMsg)
	}
	if p.Asm.NumSymbols != 1 {
		return fail("expected 1 symbol parsed from the file")
	}
	if p.Asm.Symbols[0].Binding != asm.BIND_GLOBAL {
		return fail("expected the file's .global label to be global")
	}
	return ""
}

// A missing path sets the parser error (cannot open) rather than parsing.
func TestParseFileMissing() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseFile("/nonexistent/definitely/missing.s")
	if !p.HasError {
		return fail("a missing file must set a parse error")
	}
	return ""
}

// writeParseTestFile writes s to path (create/truncate); best-effort for a test.
func writeParseTestFile(path *[]readonly char, s *[]readonly char) {
	f, _ := os.OpenFile(path, os.O_WRONLY | os.O_CREATE | os.O_TRUNC, cast(os.FileMode, 0o644))
	var b @[]uint8 = make_slice(uint8, len(s))
	for i := 0; i < len(s); i++ {
		b[i] = cast(uint8, s[i])
	}
	_, _ = f.Write(b)
	_ = f.Close()
}

// testTmpDir creates a fresh private directory for one test's output files, so
// concurrent runs of this package's tests (other sessions, CI shards) never write
// the same path; the caller removes it with `defer os.RemoveAll(dir)`.  Empty if
// it could not be created.
func testTmpDir() @[]char {
	dir, err := os.MkdirTemp("/tmp", "binate_parse_test_")
	if present(err) {
		var none @[]char
		return none
	}
	return dir
}
