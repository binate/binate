package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/arm32"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// `.`-leading and numeric local labels go through the shared line parser and resolveLabel,
// so the x86-64 and arm32 parsers take them wherever they take a symbol; on ELF each
// reference resolves in place (clang: `.Lf: jmp .Lf`, `1: b 1b` — `b` is EAFFFFFE).

// archLabelsCase parses src (lines split on '\n') with parser p, then resolves its
// temporary labels and fixups for an ELF object as the assemble driver does, checking that
// it is accepted and leaves no relocation.
func archLabelsCase(e @[]char, p @Parser, src *[]readonly char) @[]char {
	var start int = 0
	for i := 0; i <= len(src); i++ {
		if i == len(src) || src[i] == '\n' {
			p.ParseLine(src[start:i])
			start = i + 1
		}
	}
	p.Finish()
	if p.HasError { return goldenFail(e, src, p.ErrorMsg) }
	p.Asm.ObjFormat = asm.OBJ_ELF
	if !p.Asm.CheckTemporaryLabels() { return goldenFail(e, src, p.Asm.ErrorMsg) }
	if p.Arch == ARCH_X64 { x64.ResolveFixups(p.Asm) }
	if p.Arch == ARCH_ARM32 { arm32.ResolveFixups(p.Asm) }
	if !p.Asm.Finalize() || p.Asm.HasError { return goldenFail(e, src, p.Asm.ErrorMsg) }
	if p.Asm.NumRelocs != 0 { return goldenFail(e, src, "left a relocation") }
	return e
}

// x86-64: a JMP to a `.L` label and to a numeric label, backward and forward.
func TestParseX64LocalLabels() testing.TestResult {
	var e @[]char = ""
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	e = archLabelsCase(e, p, ".Lf: jmp .Lf\n1: jmp 1b\njmp 2f\n2: jmp 2b")
	if len(e) == 0 && readX64Byte(a.Sections[0], 0) != 0xE9 { return fail("jmp .Lf opcode wrong") }
	return e
}

// arm32: `.Lf: b .Lf` and `1: b 1b` are EAFFFFFE; `b 2f` then `2:` is EAFFFFFF.
func TestParseArm32LocalLabels() testing.TestResult {
	var e @[]char = ""
	var p @Parser
	var a @asm.Assembler
	p, a = newArm32Parser()
	e = archLabelsCase(e, p, ".Lf: b .Lf\n1: b 1b\nb 2f\n2: b 2b")
	if len(e) > 0 { return e }
	if readWord(a.Sections[0], 0) != 0xEAFFFFFE || readWord(a.Sections[0], 4) != 0xEAFFFFFE {
		return fail("b .Lf / b 1b wrong")
	}
	if readWord(a.Sections[0], 8) != 0xEAFFFFFF { return fail("b 2f wrong") }
	return e
}

// x86-64: clang takes no @GOTPCREL on a numeric local label reference.
func TestParseX64NumericLabelNoGotpcrel() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	p.ParseLine("1: mov rax, qword ptr [rip + 1b@GOTPCREL]")
	if !p.HasError { return fail("1b@GOTPCREL accepted") }
	var q @Parser
	q, _ = newX64Parser()
	q.ParseLine("mov rax, qword ptr [rip + sym@GOTPCREL]")
	if q.HasError { return fail(q.ErrorMsg) }
	return ""
}

// arm32: each load / store form to a label resolves to clang's PC-relative word; a register
// or immediate in its place, or a shifted register for a halfword form, is rejected (clang:
// "invalid operand"), not assembled as a [PC] access.
func TestParseArm32LiteralLoads() testing.TestResult {
	var e @[]char = ""
	var p @Parser
	var a @asm.Assembler
	p, a = newArm32Parser()
	e = archLabelsCase(e, p,
			"back: .uint32 0x11111111\nldr r0, back\nldr r1, fwd\nldrb r2, back\nstrb r2, fwd\n"
					"str r0, back\nldrh r3, fwd\nstrh r3, back\nldrsb r4, back\nldrsh r5, fwd\n"
					"ldr pc, back\nfwd: .uint32 0x22222222")
	if len(e) > 0 { return e }
	var want @[]uint32 = make_slice(uint32, 10)
	want[0] = 0xE51F000C
	want[1] = 0xE59F101C
	want[2] = 0xE55F2014
	want[3] = 0xE5CF2014
	want[4] = 0xE50F001C
	want[5] = 0xE1DF30BC
	want[6] = 0xE14F32B4
	want[7] = 0xE15F42D8
	want[8] = 0xE1DF50F0
	want[9] = 0xE51FF030
	for i := 0; i < 10; i++ {
		if readWord(a.Sections[0], 4 + 4 * i) != want[i] {
			return fail("a literal load / store is not clang's word")
		}
	}
	var bad @[]@[]char = make_slice(@[]char, 4)
	bad[0] = "ldr r0, r1"
	bad[1] = "ldr r0, #5"
	bad[2] = "ldrh r0, [r1, r2, lsl #1]"
	bad[3] = "ldrh r0, r1"
	for i := 0; i < 4; i++ {
		var q @Parser
		q, _ = newArm32Parser()
		q.ParseLine(bad[i])
		if !q.HasError { return fail(bad[i]) }
	}
	return ""
}
