package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Line-level parsing: constant definitions, several labels on one line, a '.' with no
// directive name, comments around instructions, and errors — the parser's own and
// those the assembler or an encoder raises while emitting a line — reported with the
// file:line of the offending line.  Instruction words are clang's
// (`clang -c -target arm64-apple-macos11`, `otool -tvV`).

// plHasPrefix reports whether s starts with pre.
func plHasPrefix(s *[]readonly char, pre *[]readonly char) bool {
	if len(s) < len(pre) { return false }
	return charsEqual(s[0:len(pre)], pre)
}

// plContains reports whether sub occurs in s.
func plContains(s *[]readonly char, sub *[]readonly char) bool {
	for i := 0; i + len(sub) <= len(s); i++ {
		if charsEqual(s[i:i + len(sub)], sub) { return true }
	}
	return false
}

// plA64 returns a parser that has parsed `.arch aarch64` (line 1) and `.section text`
// (line 2), so the next ParseLine is line 3.
func plA64() @Parser {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	return p
}

// plRejectAt3 checks that line, parsed as line 3 after plA64's setup, is rejected with
// a message positioned at test.s:3.
func plRejectAt3(e @[]char, line *[]readonly char) @[]char {
	var p @Parser = plA64()
	p.ParseLine(line)
	if !p.HasError { return goldenFail(e, line, "accepted") }
	if !plHasPrefix(p.ErrorMsg, "test.s:3: error: ") {
		return goldenFail(e, line, buf.Concat("error not at test.s:3: ", p.ErrorMsg))
	}
	return e
}

// plConst checks that line defines constant name with value want.
func plConst(e @[]char, line *[]readonly char, name *[]readonly char, want int64) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(line)
	if p.HasError { return goldenFail(e, line, buf.Concat("rejected: ", p.ErrorMsg)) }
	v, ok := lookupConst(p, name)
	if !ok { return goldenFail(e, line, "constant not defined") }
	if v != want { return goldenFail(e, line, "constant has the wrong value") }
	return e
}

// plConstReject checks that line is rejected and defines no constant.
func plConstReject(e @[]char, line *[]readonly char) @[]char {
	var p @Parser = newTestParser()
	p.ParseLine(line)
	if !p.HasError { return goldenFail(e, line, "accepted") }
	if p.NumConsts != 0 { return goldenFail(e, line, "defined a constant despite the error") }
	return e
}

// plExpr returns the result of ParseExpr over all of src and whether it consumed src.
func plExpr(src *[]readonly char) (ExprResult, bool) {
	var l Lexer = NewLexer(src, 1)
	var tok Token
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = ParseExpr(l, tok)
	return r, tok.Kind == TOK_EOF
}

// --- Constant definitions ---

// `name = expr` defines a constant; a comment may follow the value, and the name may
// contain '.' after its first character.
func TestParseLineConstDefined() testing.TestResult {
	var e @[]char = ""
	e = plConst(e, "K = 5", "K", 5)
	e = plConst(e, "K = 5 // c", "K", 5)
	e = plConst(e, "K = 5 /* c */", "K", 5)
	e = plConst(e, "K = 017", "K", 15)
	e = plConst(e, "K = 0o17", "K", 15)
	e = plConst(e, "K = (1 << 4) | 1", "K", 17)
	e = plConst(e, "K = -1", "K", -1)
	e = plConst(e, "K = 'a'", "K", 0x61)
	e = plConst(e, "a.b = 3", "a.b", 3)
	return e
}

// A token after the constant's value, or a malformed value, is an error and defines
// nothing (clang: "expected newline" for `K = 5 6`, "expected ')'" for `K = (1 + 2`,
// "invalid token in expression" for `K = $`).
func TestParseLineConstRejected() testing.TestResult {
	var e @[]char = ""
	e = plConstReject(e, "K = 5 6")
	e = plConstReject(e, "K = 5 junk")
	e = plConstReject(e, "K = 5,")
	e = plConstReject(e, "K = (1 + 2")
	e = plConstReject(e, "K = $")
	e = plConstReject(e, "K = 1 +")
	e = plConstReject(e, "K =")
	e = plConstReject(e, "K = 08")
	return e
}

// Redefining a constant is an error reported at the redefining line.
func TestParseLineConstRedefinitionRejected() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine("K = 1")
	p.ParseLine("K = 2")
	if !p.HasError { return fail("constant redefinition accepted") }
	if !plHasPrefix(p.ErrorMsg, "test.s:2: error: ") { return fail(p.ErrorMsg) }
	return ""
}

// ParseExpr fails on `$` (no name — a '$' starts one only before a letter, digit or '_'
// — and there is no location counter) and on a '(' with no matching ')'; balanced
// parentheses nest and are consumed.
func TestExprAtoms() testing.TestResult {
	var e @[]char = ""
	var r ExprResult
	var all bool = false
	r, all = plExpr("$")
	if r.Ok { e = goldenFail(e, "$", "accepted") }
	r, all = plExpr("$ + 1")
	if r.Ok { e = goldenFail(e, "$ + 1", "accepted") }
	r, all = plExpr("1 + $")
	if r.Ok { e = goldenFail(e, "1 + $", "accepted") }
	r, all = plExpr("(1 + 2")
	if r.Ok { e = goldenFail(e, "(1 + 2", "accepted") }
	r, all = plExpr("((1)")
	if r.Ok { e = goldenFail(e, "((1)", "accepted") }
	r, all = plExpr("(1 + 2]")
	if r.Ok { e = goldenFail(e, "(1 + 2]", "accepted") }
	r, all = plExpr("()")
	if r.Ok { e = goldenFail(e, "()", "accepted") }
	r, all = plExpr("((2 + 3)) * 2")
	if !r.Ok || r.Val != 10 || !all { e = goldenFail(e, "((2 + 3)) * 2", "not 10") }
	r, all = plExpr("(017)")
	if !r.Ok || r.Val != 15 || !all { e = goldenFail(e, "(017)", "not 15") }
	return e
}

// --- Labels ---

// Several labels may precede an instruction on one line; each is defined at the
// instruction's offset (clang: `La: Lb: nop` is one NOP, D503201F).
func TestParseLineMultipleLabels() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("La: Lb: nop")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumSymbols != 2 { return fail("expected 2 symbols") }
	if !charsEqual(p.Asm.Symbols[0].Name, "La") { return fail("first symbol is not La") }
	if !charsEqual(p.Asm.Symbols[1].Name, "Lb") { return fail("second symbol is not Lb") }
	if p.Asm.Symbols[0].Offset != 0 || p.Asm.Symbols[1].Offset != 0 {
		return fail("labels not at offset 0")
	}
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 4 || readInst(s, 0) != 0xD503201F { return fail("expected one NOP") }
	return ""
}

// A line of labels alone defines them all at the current offset, and the last one
// becomes the scope for local labels.
func TestParseLineLabelsOnly() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("nop")
	p.ParseLine("a: b: c:")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumSymbols != 3 { return fail("expected 3 symbols") }
	for i := 0; i < 3; i++ {
		if p.Asm.Symbols[i].Offset != 4 { return fail("label not at offset 4") }
	}
	if p.Asm.Sections[0].Len != 4 { return fail("a label-only line emitted code") }
	if !charsEqual(p.LastGlobal, "c") { return fail("last label is not the local-label scope") }
	return ""
}

// Labels may precede a directive on the same line.
func TestParseLineLabelsThenDirective() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".section data")
	p.ParseLine("d1: d2: .uint8 7")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumSymbols != 2 { return fail("expected 2 symbols") }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 1 || s.Data[0] != 7 { return fail("expected the byte 07") }
	return ""
}

// A label name may contain '.' (clang accepts `memcpy.part.0:`), and the same name
// resolves in a later directive.
func TestParseLineDottedLabel() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("memcpy.part.0:")
	p.ParseLine(".global memcpy.part.0")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumSymbols != 1 { return fail("expected 1 symbol") }
	if !charsEqual(p.Asm.Symbols[0].Name, "memcpy.part.0") { return fail("wrong symbol name") }
	if p.Asm.Symbols[0].Binding != asm.BIND_GLOBAL { return fail("symbol not global") }
	return ""
}

// A '.' after a label with no directive name (clang: `La: .` is an error), or an
// unknown directive name, is an error at that line.
func TestParseLineLabelDotWithoutName() testing.TestResult {
	var e @[]char = ""
	e = plRejectAt3(e, "La: .")
	e = plRejectAt3(e, "La: . 5")
	e = plRejectAt3(e, "La: Lb: .")
	e = plRejectAt3(e, "La: .bogus")
	e = plRejectAt3(e, ".")
	return e
}

// Defining one label twice on a line is the assembler's duplicate-label error,
// reported at that line (clang: "symbol 'La' is already defined").
func TestParseLineDuplicateLabelOnLine() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("La: La: nop")
	if !p.HasError { return fail("duplicate label accepted") }
	if !plHasPrefix(p.ErrorMsg, "test.s:3: error: ") { return fail(p.ErrorMsg) }
	if !plContains(p.ErrorMsg, "duplicate label") { return fail(p.ErrorMsg) }
	return ""
}

// --- Comments around instructions ---

// Block and line comments may surround an instruction (clang: each line is a NOP).
func TestParseLineCommentsAroundInstruction() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("/* c */ nop")
	p.ParseLine("nop /* c */")
	p.ParseLine("nop // c")
	p.ParseLine("La: /* c */ nop")
	p.ParseLine("/* c */")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 16 { return fail("expected four NOPs") }
	for off := 0; off < 16; off = off + 4 {
		if readInst(s, off) != 0xD503201F { return fail("expected NOP") }
	}
	return ""
}

// --- Errors and their positions ---

// A line that starts with neither a name nor '.' is an error at that line.
func TestParseLineUnexpectedStart() testing.TestResult {
	var e @[]char = ""
	e = plRejectAt3(e, "5")
	e = plRejectAt3(e, ", x0")
	e = plRejectAt3(e, "[x0]")
	e = plRejectAt3(e, "\"s\"")
	e = plRejectAt3(e, "08")
	return e
}

// An error the encoder raises while emitting a line is reported as that line's error
// with its file:line: `ldp x0, x1, [x2, #4]` has no encoding (clang: "index must be a
// multiple of 8"), while `ldp x0, x1, [x2, #16]` is A9410440.
func TestParseLineEncoderErrorHasLine() testing.TestResult {
	var good @Parser = plA64()
	good.ParseLine("ldp x0, x1, [x2, #16]")
	if good.HasError { return fail(good.ErrorMsg) }
	if readInst(good.Asm.Sections[0], 0) != 0xA9410440 { return fail("ldp #16 wrong") }
	var p @Parser = plA64()
	p.ParseLine("nop")
	p.ParseLine("ldp x0, x1, [x2, #4]")
	if !p.HasError { return fail("ldp with offset #4 accepted") }
	if !plHasPrefix(p.ErrorMsg, "test.s:4: error: ") { return fail(p.ErrorMsg) }
	return ""
}

// An error the assembler core raises (a label or data with no current section) is
// reported with the line's file:line and the assembler's message.
func TestParseLineAssemblerErrorHasLine() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine("foo:")
	if !p.HasError { return fail("label with no section accepted") }
	if !charsEqual(p.ErrorMsg, "test.s:1: error: no current section") { return fail(p.ErrorMsg) }
	var q @Parser = newTestParser()
	q.ParseLine("")
	q.ParseLine(".uint8 1")
	if !q.HasError { return fail("data with no section accepted") }
	if !charsEqual(q.ErrorMsg, "test.s:2: error: no current section") { return fail(q.ErrorMsg) }
	return ""
}

// Only the first error is kept: a later bad line does not replace its position.
func TestParseLineFirstErrorKept() testing.TestResult {
	var p @Parser = plA64()
	p.ParseLine("ldp x0, x1, [x2, #4]")
	p.ParseLine("5")
	if !p.HasError { return fail("errors not reported") }
	if !plHasPrefix(p.ErrorMsg, "test.s:3: error: ") { return fail(p.ErrorMsg) }
	return ""
}

// An instruction with no `.arch` in effect is an error at its line.
func TestParseLineNoArch() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".section text")
	p.ParseLine("nop")
	if !p.HasError { return fail("instruction with no .arch accepted") }
	if !plHasPrefix(p.ErrorMsg, "test.s:2: error: ") { return fail(p.ErrorMsg) }
	return ""
}
