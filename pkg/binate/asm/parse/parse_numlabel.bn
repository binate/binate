package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Numeric local labels: `N:` defines an instance of label N — any number of times — and
// `Nb` / `Nf` (lexed as one name, lexNumberOrLabelRef) refer to the nearest instance before
// / after the reference.  Instance k of N is the assembler-generated label
// asm.GeneratedLabelName(N, k), temporary on every object format — listed in a symbol
// table only when a relocation must name it.  N is keyed by its decimal text (`01:` and
// `0x1:` define label 1, as clang reads them).

// numLabelIndex returns the index of label number num (decimal) in p's table, or -1.
func numLabelIndex(p @Parser, num *[]readonly char) int {
	for i := 0; i < p.NumNumLabels; i++ {
		if charsEqual(p.NumLabelNums[i], num) { return i }
	}
	return -1
}

// defineNumLabel defines the next instance of numeric label v at the current location.
func defineNumLabel(p @Parser, v int64) {
	var num @[]char = decimalU64(cast(uint64, v))
	var i int = numLabelIndex(p, num)
	if i < 0 {
		if p.NumNumLabels == len(p.NumLabelNums) {
			p.NumLabelNums = growNames(p.NumLabelNums)
			p.NumLabelCounts = growInts(p.NumLabelCounts)
		}
		i = p.NumNumLabels
		p.NumLabelNums[i] = num
		p.NumLabelCounts[i] = 0
		p.NumNumLabels = p.NumNumLabels + 1
	}
	p.NumLabelCounts[i] = p.NumLabelCounts[i] + 1
	p.Asm.DefineLabel(asm.GeneratedLabelName(num, p.NumLabelCounts[i]))
}

// resolveNumLabelRef returns the label instance the reference ref (`Nb` / `Nf`) means: the
// latest instance of N defined so far, or the next one — recorded, so Finish reports it if
// it is never defined.  A backward reference to a label not yet defined is recorded as
// instance 0, which Finish always reports (clang: "directional label undefined"): resolving
// never fails mid-line, so no instruction parser emits a line whose reference is bad.
func resolveNumLabelRef(p @Parser, ref *[]readonly char) @[]char {
	var num *[]readonly char = ref[0:len(ref) - 1]
	var i int = numLabelIndex(p, num)
	var count int = 0
	if i >= 0 { count = p.NumLabelCounts[i] }
	var k int = count + 1
	if ref[len(ref) - 1] == 'b' { k = count }
	if k == 0 || k > count { recordFwdRef(p, num, k) }
	return asm.GeneratedLabelName(num, k)
}

// recordFwdRef records a reference to instance k of label number num at the current line:
// a forward one, or instance 0 for a backward one with none before.
func recordFwdRef(p @Parser, num *[]readonly char, k int) {
	if p.NumFwdRefs == len(p.FwdRefNums) {
		p.FwdRefNums = growNames(p.FwdRefNums)
		p.FwdRefInstances = growInts(p.FwdRefInstances)
		p.FwdRefLines = growInts(p.FwdRefLines)
	}
	p.FwdRefNums[p.NumFwdRefs] = buf.CopyStr(num)
	p.FwdRefInstances[p.NumFwdRefs] = k
	p.FwdRefLines[p.NumFwdRefs] = p.LineNum
	p.NumFwdRefs = p.NumFwdRefs + 1
}

// checkFwdRefs reports, at its line, the first recorded reference whose label instance
// was never defined (instance 0 never is).
func checkFwdRefs(p @Parser) {
	for j := 0; j < p.NumFwdRefs; j++ {
		var i int = numLabelIndex(p, p.FwdRefNums[j])
		if i < 0 || p.FwdRefInstances[j] == 0 || p.NumLabelCounts[i] < p.FwdRefInstances[j] {
			p.LineNum = p.FwdRefLines[j]
			setErr(p, "directional label undefined")
			return
		}
	}
}

// growNames returns a copy of xs with twice the length (at least 16).
func growNames(xs @[]@[]char) @[]@[]char {
	var n int = len(xs) * 2
	if n < 16 { n = 16 }
	var out @[]@[]char = make_slice(@[]char, n)
	for i := 0; i < len(xs); i++ { out[i] = xs[i] }
	return out
}

// growInts returns a copy of xs with twice the length (at least 16).
func growInts(xs @[]int) @[]int {
	var n int = len(xs) * 2
	if n < 16 { n = 16 }
	var out @[]int = make_slice(int, n)
	for i := 0; i < len(xs); i++ { out[i] = xs[i] }
	return out
}
