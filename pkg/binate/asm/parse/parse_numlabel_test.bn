package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Tests for the numeric local label table (parse_numlabel.bn): instances per number, the
// references' resolution, the forward-reference record and its end-of-input check, and
// the table's growth.

// Each definition of a number is its next instance, a generated label at the current
// location; the number is keyed by value (1 and 01 are one label).
func TestDefineNumLabelInstances() testing.TestResult {
	var p @Parser = plA64()
	defineNumLabel(p, 1)
	p.ParseLine("nop")
	defineNumLabel(p, 1)
	defineNumLabel(p, 10)
	if p.HasError || p.Asm.HasError { return fail("a definition failed") }
	if p.NumNumLabels != 2 { return fail("expected labels 1 and 10") }
	var i int = numLabelIndex(p, "1")
	if i < 0 || p.NumLabelCounts[i] != 2 { return fail("label 1 does not have two instances") }
	var s1 int = p.Asm.LookupSymbol(asm.GeneratedLabelName("1", 1))
	var s2 int = p.Asm.LookupSymbol(asm.GeneratedLabelName("1", 2))
	if s1 < 0 || s2 < 0 { return fail("an instance is not a generated label") }
	if p.Asm.Symbols[s1].Offset != 0 || p.Asm.Symbols[s2].Offset != 4 {
		return fail("the instances are not at their definitions")
	}
	return ""
}

// `Nb` is the latest instance and `Nf` the next; each forward reference is recorded with
// its line.
func TestResolveNumLabelRef() testing.TestResult {
	var p @Parser = plA64()
	defineNumLabel(p, 3)
	if !charsEqual(resolveNumLabelRef(p, "3b"), asm.GeneratedLabelName("3", 1)) {
		return fail("3b is not the first instance")
	}
	if !charsEqual(resolveNumLabelRef(p, "3f"), asm.GeneratedLabelName("3", 2)) {
		return fail("3f is not the second instance")
	}
	p.LineNum = 9
	_ = resolveNumLabelRef(p, "3f")
	_ = resolveNumLabelRef(p, "4f")
	if p.NumFwdRefs != 3 { return fail("expected three forward references recorded") }
	if p.FwdRefLines[0] == 9 || p.FwdRefLines[1] != 9 || p.FwdRefLines[2] != 9 {
		return fail("a forward reference does not keep its line")
	}
	if p.HasError { return fail(p.ErrorMsg) }
	return ""
}

// A backward reference with no instance before it is recorded as instance 0, not an error
// on its line (so no instruction parser emits a line half-resolved): Finish reports it at
// that line even when the label is defined later.
func TestBackwardRefBeforeAnyInstance() testing.TestResult {
	var p @Parser = plA64()
	p.LineNum = 5
	_ = resolveNumLabelRef(p, "5b")
	if p.HasError { return fail("5b reported on its line") }
	defineNumLabel(p, 5)
	checkFwdRefs(p)
	if !p.HasError || !plHasPrefix(p.ErrorMsg, "test.s:5: error: ") {
		return fail("5b before any 5: not reported at its line")
	}
	return ""
}

// checkFwdRefs reports a forward reference whose instance never came, at its own line,
// and is quiet once every one is defined.
func TestCheckFwdRefs() testing.TestResult {
	var p @Parser = plA64()
	p.LineNum = 7
	_ = resolveNumLabelRef(p, "2f")
	p.LineNum = 20
	checkFwdRefs(p)
	if !p.HasError || !plHasPrefix(p.ErrorMsg, "test.s:7: error: ") {
		return fail("an undefined 2f not reported at its line")
	}
	p = plA64()
	_ = resolveNumLabelRef(p, "2f")
	defineNumLabel(p, 2)
	checkFwdRefs(p)
	if p.HasError { return fail(p.ErrorMsg) }
	return ""
}

// The label and forward-reference tables grow past their initial size, keeping every
// entry.
func TestNumLabelTableGrows() testing.TestResult {
	var p @Parser = plA64()
	for v := 0; v < 40; v++ {
		defineNumLabel(p, cast(int64, v))
		_ = resolveNumLabelRef(p, buf.Concat(decimalU64(cast(uint64, v + 100)), "f"))
	}
	if p.NumNumLabels != 40 || p.NumFwdRefs != 40 { return fail("wrong table sizes") }
	for v := 0; v < 40; v++ {
		var i int = numLabelIndex(p, decimalU64(cast(uint64, v)))
		if i < 0 || p.NumLabelCounts[i] != 1 { return fail("an entry was lost in growth") }
	}
	return ""
}
