package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/binate/stringutils"
import "pkg/std/strings"

// Data regions in assembly text, as clang reads them for Mach-O: `.data_region` begins a run
// of data in a section — of jump-table entries with the operand `jt8`, `jt16` or `jt32` — and
// `.end_data_region` ends it (asm.Assembler.BeginDataRegion, EndDataRegion); the object lists
// each in LC_DATA_IN_CODE.  Regions do not nest, and one still open at the end of the input
// is an error (clang: "Data region not terminated").  clang knows neither directive for ELF.
// A literal pool is a data region too (flushPool).

// regionFormatOk reports whether the object format takes the data-region directive name,
// recording the error when it does not.
func regionFormatOk(p @Parser, name *[]readonly char) bool {
	if p.Asm.ObjFormat == asm.OBJ_UNKNOWN {
		setErr(p, buf.Concat(name, " needs the object format, not yet known here"))
		return false
	}
	if p.Asm.ObjFormat != asm.OBJ_MACHO {
		setErr(p, buf.Concat(name, " is a Mach-O directive"))
		return false
	}
	return true
}

// parseDataRegionDirective handles `.data_region`, with an optional jump-table operand.
func parseDataRegionDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	if !regionFormatOk(p, ".data_region") { return l, tok }
	if p.Asm.DataRegionOpen() {
		setErr(p,
				regionLineError(p, "the data region begun on line ",
						" is still open: data regions do not nest"))
		return l, tok
	}
	l, tok = LexNext(l)
	var kind int = asm.REGION_DATA
	if tok.Kind == TOK_IDENT {
		if charsEqual(tok.Text, "jt8") {
			kind = asm.REGION_JUMP_TABLE8
		} else if charsEqual(tok.Text, "jt16") {
			kind = asm.REGION_JUMP_TABLE16
		} else if charsEqual(tok.Text, "jt32") {
			kind = asm.REGION_JUMP_TABLE32
		} else {
			setErr(p, "unknown region type in `.data_region` (jt8, jt16 or jt32)")
			return l, tok
		}
		l, tok = LexNext(l)
	}
	p.Asm.BeginDataRegion(kind)
	p.DataRegionLine = p.LineNum
	return l, tok
}

// parseEndDataRegionDirective handles `.end_data_region`.
func parseEndDataRegionDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	if !regionFormatOk(p, ".end_data_region") { return l, tok }
	if !p.Asm.DataRegionOpen() {
		setErr(p, "`.end_data_region` with no data region open")
		return l, tok
	}
	p.Asm.EndDataRegion()
	l, tok = LexNext(l)
	return l, tok
}

// regionLineError returns before, the line of the `.data_region` that began the open data
// region, then after.
func regionLineError(p @Parser, before *[]readonly char, after *[]readonly char) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	b.Write(before)
	stringutils.WriteInt(b, p.DataRegionLine)
	b.Write(after)
	return buf.CopyStr(b.String())
}
