package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Data regions in assembly text (parse_region.bn) and literal pools as data regions.
// (dataSource and dataReject are in parse_data_test.bn: src's first line is line 3.)

// regionIs reports whether data region i of p is in section si from start to end, of kind.
func regionIs(p @Parser, i int, si int, start int, end int, kind int) bool {
	if i >= p.Asm.NumDataRegions { return false }
	var r asm.DataRegion = p.Asm.DataRegions[i]
	return r.Section == si && r.Start == start && r.End == end && r.Kind == kind
}

// `.data_region` with no operand, `jt8`, `jt16` or `jt32` and `.end_data_region` record a data
// region of that kind, in any section, as clang does for Mach-O.
func TestDataRegionDirectives() testing.TestResult {
	var p @Parser = dataSource("aarch64",
			".section text\nret\n.data_region jt32\n.uint32 1\n.end_data_region\n"
					".data_region jt8\n.uint8 1\n.end_data_region\n.data_region jt16\n.uint16 1\n"
					".end_data_region\n.data_region\n.uint8 1\n.end_data_region\n"
					".section data\n.data_region\n.uint32 9\n.end_data_region\n",
			asm.OBJ_MACHO)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat(p.ErrorMsg, p.Asm.ErrorMsg)) }
	// Mach-O: text is section 0, data section 1.
	if p.Asm.NumDataRegions != 5 || !regionIs(p, 0, 0, 4, 8, asm.REGION_JUMP_TABLE32) ||
			!regionIs(p, 1, 0, 8, 9, asm.REGION_JUMP_TABLE8) ||
			!regionIs(p, 2, 0, 9, 11, asm.REGION_JUMP_TABLE16) ||
			!regionIs(p, 3, 0, 11, 12, asm.REGION_DATA) || !regionIs(p, 4, 1, 0, 4, asm.REGION_DATA) {
		return fail("the regions are not as written")
	}
	return ""
}

// A literal pool is a data region, its alignment padding included, as clang marks one: at a
// `.ltorg` and at the end of the input, in the order the pools are emitted — at the end, the
// sections in the order of their first literal-pool entries, emitted or not, as clang orders
// them.
func TestLiteralPoolIsDataRegion() testing.TestResult {
	var p @Parser = dataSource("aarch64",
			".section text\n_f: ldr x0, =0x123456789\n ldr w1, =0x12345\n ret\n.ltorg\n"
					"_g: ldr x2, =0xabcdef12345\n ret\n",
			asm.OBJ_MACHO)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat(p.ErrorMsg, p.Asm.ErrorMsg)) }
	if p.Asm.NumDataRegions != 2 || !regionIs(p, 0, 0, 12, 28, asm.REGION_DATA) ||
			!regionIs(p, 1, 0, 36, 48, asm.REGION_DATA) {
		return fail("the pools are not the regions 12..28 and 36..48")
	}
	// data's pool is begun first, so emitted first at the end
	p = dataSource("aarch64",
			".section text\n_f: ret\n.section data\n_d: ldr x0, =0x123456789\n.section text\n"
					"_g: ldr x1, =0x223456789\n ret\n",
			asm.OBJ_MACHO)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat(p.ErrorMsg, p.Asm.ErrorMsg)) }
	if p.Asm.NumDataRegions != 2 || !regionIs(p, 0, 1, 4, 16, asm.REGION_DATA) ||
			!regionIs(p, 1, 0, 12, 24, asm.REGION_DATA) {
		return fail("data's pool, begun first, did not come first")
	}
	// text's pool is begun first (and emitted at the `.ltorg`), so its last one comes first
	p = dataSource("aarch64",
			".section text\n_f: ldr x0, =0x123456789\n.ltorg\n.section data\n"
					"_d: ldr x1, =0x223456789\n.section text\n_g: ldr x2, =0x323456789\n ret\n",
			asm.OBJ_MACHO)
	if p.HasError || p.Asm.HasError { return fail(buf.Concat(p.ErrorMsg, p.Asm.ErrorMsg)) }
	if p.Asm.NumDataRegions != 3 || !regionIs(p, 0, 0, 4, 16, asm.REGION_DATA) ||
			!regionIs(p, 1, 0, 24, 32, asm.REGION_DATA) || !regionIs(p, 2, 1, 4, 16, asm.REGION_DATA) {
		return fail("text's pool, begun first, did not come first at the end")
	}
	return ""
}

// The directives' errors: an unknown operand or text after it, nesting (a literal pool
// included), an end with none open or in another section, a region open at the end of the
// input, and either directive on ELF or before the format is known.
func TestDataRegionRejects() testing.TestResult {
	var e @[]char = ""
	var m int = asm.OBJ_MACHO
	e = dataReject(e, "aarch64", ".data_region jta32\n.end_data_region", m, "unknown region type")
	e = dataReject(e, "aarch64", ".data_region jt8 jt16\n.end_data_region", m, "unexpected token")
	e = dataReject(e, "aarch64", ".data_region\n.data_region jt8\n.end_data_region", m,
			"the data region begun on line 3 is still open: data regions do not nest")
	e = dataReject(e, "aarch64",
			".section text\nldr x0, =0x123456789\n.data_region\n.ltorg\n.end_data_region", m,
			"a literal pool while the data region begun on line 5 is open")
	e = dataReject(e, "aarch64", ".end_data_region", m, "`.end_data_region` with no data region open")
	e = dataReject(e, "aarch64", ".data_region\n.section text\n.end_data_region", m,
			"the section it began in")
	e = dataReject(e, "aarch64", ".uint8 1\n.data_region\n.uint8 2\n", m,
			"the data region begun on line 4 is not ended (`.end_data_region`)")
	e = dataReject(e, "x64", ".data_region\n.uint8 2\n", m, "begun on line 3 is not ended")
	e = dataReject(e, "aarch64", ".data_region\n", asm.OBJ_ELF, ".data_region is a Mach-O directive")
	e = dataReject(e, "aarch64", ".end_data_region\n", asm.OBJ_ELF,
			".end_data_region is a Mach-O directive")
	e = dataReject(e, "aarch64", ".data_region\n", asm.OBJ_UNKNOWN, "needs the object format")
	return e
}
