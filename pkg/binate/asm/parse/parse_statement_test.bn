package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The statements a `;` separates on arm32 and x86-64 (statementEnd) carry their own comment
// state, as clang reads them.  (newTestParser, lineEmitsHex are in parse_test.bn, goldenFail in
// aarch64_golden_test.bn, newX64Parser in x64_test.bn, plContains in parse_line_test.bn.)

// linesEmit parses lines on p in turn and returns "" when they assemble to the bytes hex, else
// what went wrong.
func linesEmit(p @Parser, lines @[]*[]readonly char, hex *[]readonly char) testing.TestResult {
	for i := 0; i + 1 < len(lines); i++ {
		p.ParseLine(lines[i])
		if p.HasError { return buf.Concat("rejected: ", p.ErrorMsg) }
	}
	return lineEmitsHex(p, lines[len(lines) - 1], hex)
}

// A comment that spans lines splits a statement only when the statement's own text comes
// before its `/*` and after its `*/`: a `;` after the `*/`, or before the `/*`, makes the two
// texts two statements — x86-64's `nop /*` / `*/ ; nop`, `nop; /*` / `*/ nop` and `nop; nop
// /*` / `*/; ret` assemble as clang assembles them (`clang -target x86_64-linux-gnu`) — while
// `l:; nop /*` / `*/ nop` is `nop nop` to clang, rejected here: the statement left open is
// `nop`, not the labels before the `;`.
func TestStatementCommentsSpanningLines() testing.TestResult {
	var e @[]char = ""
	var cases @[]@[]*[]readonly char = @[]@[]*[]readonly char{
			@[]*[]readonly char{"nop /*", "*/ ; nop"}, @[]*[]readonly char{"nop; /*", "*/ nop"},
			@[]*[]readonly char{"nop; nop /*", "*/; ret"}}
	var hexes @[]*[]readonly char = @[]*[]readonly char{"90 90", "90 90", "90 90 c3"}
	for i := 0; i < len(cases); i++ {
		p, _ := newX64Parser()
		var r testing.TestResult = linesEmit(p, cases[i], hexes[i])
		if len(r) > 0 { e = goldenFail(e, cases[i][0], r) }
	}
	var q @Parser
	q, _ = newX64Parser()
	q.ParseLine("l:; nop /*")
	q.ParseLine("*/ nop")
	if !q.HasError || !plContains(q.ErrorMsg, "a comment that spans lines splits a statement") {
		e = goldenFail(e, "l:; nop /*", buf.Concat("not rejected: ", q.ErrorMsg))
	}
	return e
}
