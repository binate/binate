package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/aarch64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// `.subsections_via_symbols` against clang (`clang -c -target arm64-apple-macos`; otool -h,
// -rv and -t): the directive claims the object's sections divisible at its symbols wherever
// in the input it is.  Without it the linker keeps each section whole, and clang patches
// every PC-relative reference within a section in place — one to a global or weak
// definition in another atom included; with it such a reference is a relocation, its field
// left zero.  (diffSource / diffReject are in expr_diff_test.bn, labelsWordsHex in
// aarch64_golden_labels_test.bn, goldenFail in aarch64_golden_test.bn.)

// subsecCase checks that src assembles for Mach-O to exactly the words want with nrel
// relocations, claiming subsections as subsections says.
func subsecCase(e @[]char, src *[]readonly char, subsections bool, nrel int,
		want *[]readonly char) @[]char {
	var p @Parser = diffSource(src, asm.OBJ_MACHO)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	if p.Asm.SubsectionsViaSymbols != subsections {
		return goldenFail(e, src, "wrong subsections flag")
	}
	if p.Asm.NumRelocs != nrel { return goldenFail(e, src, "wrong relocation count") }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, want) { return goldenFail(e, src, buf.Concat("assembled to ", got)) }
	return e
}

func TestSubsectionsViaSymbols() testing.TestResult {
	var e @[]char = ""
	e = subsecCase(e,
			".arch aarch64\n.section text\n.global _f\n_f: b.eq _g\nret\n.global _g\n_g: ret", false, 0,
			"54000040 D65F03C0 D65F03C0 ")
	e = subsecCase(e, ".arch aarch64\n.section text\n.global _f\n_f: bl _g\nret\n.global _g\n_g: ret",
			false, 0, "94000002 D65F03C0 D65F03C0 ")
	e = subsecCase(e,
			".arch aarch64\n.section text\n.global _f\n_f: adr x0, _g\nret\n.global _g\n"
					"_g: ret",
			false, 0, "10000040 D65F03C0 D65F03C0 ")
	e = subsecCase(e,
			".arch aarch64\n.section text\n.global _f\n_f: ldr x0, _g\nret\n.global _g\n"
					"_g: .uint64 1",
			false, 0, "58000040 D65F03C0 00000001 00000000 ")
	e = subsecCase(e, ".arch aarch64\n.section text\n.global _f\n_f: bl _g\nret\n.weak _g\n_g: ret",
			false, 0, "94000002 D65F03C0 D65F03C0 ")
	e = subsecCase(e, ".arch aarch64\n.section text\n_f: ret\n_g: bl _f", false, 0,
			"D65F03C0 97FFFFFF ")
	e = subsecCase(e,
			".arch aarch64\n.section text\n.global _f\n_f: bl _g\nret\n.global _g\n_g: ret\n"
					".subsections_via_symbols",
			true, 1, "94000000 D65F03C0 D65F03C0 ")
	e = subsecCase(e, ".subsections_via_symbols\n.arch aarch64\n.section text\n_f: ret\n_g: bl _f",
			true, 1, "D65F03C0 94000000 ")
	return e
}

// The flag set before the input (as a compiler sets it) holds through the second pass a
// forward label difference makes, so the reference to the other atom is still a relocation.
func TestSubsectionsKeptOnSecondPass() testing.TestResult {
	var src *[]readonly char = ".arch aarch64\n.section text\n.global _f\n_f: bl _g\n.uint32 Lb - La\n"
			"La: ret\nLb: ret\n.global _g\n_g: ret"
	var p @Parser = newTestParser()
	p.Asm.ObjFormat = asm.OBJ_MACHO
	p.Asm.SubsectionsViaSymbols = true
	p.ParseSource(src)
	if p.HasError { return goldenFail("", src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if !present(p.Prev) { return goldenFail("", src, "no second pass") }
	if !p.Asm.SubsectionsViaSymbols { return goldenFail("", src, "the flag was dropped") }
	if !p.Asm.CheckTemporaryLabels() || !aarch64.ResolveFixups(p.Asm) {
		return goldenFail("", src, buf.Concat("rejected: ", p.Asm.ErrorMsg))
	}
	p.Asm.Finalize()
	if p.Asm.NumRelocs != 1 { return goldenFail("", src, "bl _g is not a relocation") }
	var got @[]char = labelsWordsHex(p)
	if !charsEqual(got, "94000000 00000004 D65F03C0 D65F03C0 D65F03C0 ") {
		return goldenFail("", src, buf.Concat("assembled to ", got))
	}
	return ""
}

// The directive is Mach-O's (clang: "unknown directive" for ELF), needs the object format
// known, and takes no operands.
func TestSubsectionsViaSymbolsRejected() testing.TestResult {
	var e @[]char = ""
	e = diffReject(e, ".arch aarch64\n.section text\n.subsections_via_symbols", asm.OBJ_ELF,
			"Mach-O directive")
	e = diffReject(e, ".arch aarch64\n.subsections_via_symbols", asm.OBJ_UNKNOWN, "object format")
	e = diffReject(e, ".arch aarch64\n.subsections_via_symbols 1", asm.OBJ_MACHO, "unexpected token")
	return e
}
