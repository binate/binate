package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// The ELF symbol-attribute directives `.type name, <type>` and `.size name, expr`, as clang
// reads them.  Mach-O has neither (clang: "unknown directive"), so they need the object format
// known where they appear.  Each records its value, which Finish gives the symbol once every
// definition is known (applySymbolAttrs), as it gives the visibility directives'.

// symTypeUnique is what symTypeNamed returns for gnu_unique_object, which the assembler does
// not support: no binding here is GNU_UNIQUE.
const symTypeUnique int = -3

// parseTypeDirective handles ".type name, <type>", the comma optional, the type spelled as
// clang accepts it: a name (`function`), STT_<NAME>, a quoted name, or a name after `%`, `@`
// (not on ARM, where clang reads `@` as a comment) or `#` (not on x86-64, likewise).
func parseTypeDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	if !symAttrFormatOk(p, ".type") { return l, tok }
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) {
		setErr(p, "expected symbol name")
		return l, tok
	}
	var name @[]char = buf.CopyStr(tok.Text)
	l, tok = LexNext(l)
	if tok.Kind == TOK_COMMA { l, tok = LexNext(l) }
	if typePrefixOk(p, tok.Kind) { l, tok = LexNext(l) }
	if tok.Kind != TOK_IDENT && tok.Kind != TOK_STRING {
		setErr(p, "expected a symbol type: STT_<TYPE>, a name, \"<name>\", or a name after % (or @, #)")
		return l, tok
	}
	var t int = symTypeNamed(tok.Text)
	if t == symTypeUnique {
		setErr(p, "gnu_unique_object symbols are not supported")
		return l, tok
	}
	if t < 0 {
		setErr(p, quotedName(tok.Text, " is not a symbol type"))
		return l, tok
	}
	p.Asm.NoteMention(name) // clang registers the symbol here (not at `.size`), which orders its table
	recordSymAttr(p, name, cast(int64, t), false)
	l, tok = LexNext(l)
	return l, tok
}

// typePrefixOk reports whether a token of kind may introduce a `.type` name on p's target:
// `%` anywhere; `@` but on ARM and `#` but on x86-64, where each starts a comment for clang.
func typePrefixOk(p @Parser, kind int) bool {
	if kind == TOK_PERCENT { return true }
	if kind == TOK_AT { return p.Arch != ARCH_ARM32 }
	if kind == TOK_HASH { return p.Arch != ARCH_X64 }
	return false
}

// symTypeNamed returns the type (asm.SYM_*) a `.type` name spells — clang's names, each also
// as STT_<NAME>: function, object, common (an object), notype, gnu_indirect_function,
// tls_object — or symTypeUnique for gnu_unique_object, or -1 for no type.
func symTypeNamed(s *[]readonly char) int {
	if charsEqual(s, "function") || charsEqual(s, "STT_FUNC") { return asm.SYM_FUNC }
	if charsEqual(s, "object") || charsEqual(s, "STT_OBJECT") { return asm.SYM_OBJECT }
	if charsEqual(s, "common") || charsEqual(s, "STT_COMMON") { return asm.SYM_OBJECT }
	if charsEqual(s, "notype") || charsEqual(s, "STT_NOTYPE") { return asm.SYM_NOTYPE }
	if charsEqual(s, "gnu_indirect_function") || charsEqual(s, "STT_GNU_IFUNC") {
		return asm.SYM_IFUNC
	}
	if charsEqual(s, "tls_object") || charsEqual(s, "STT_TLS") { return asm.SYM_TLS }
	if charsEqual(s, "gnu_unique_object") { return symTypeUnique }
	return -1
}

// parseSizeDirective handles ".size name, expr", expr a number — a difference of two
// locations a fixed distance apart (`. - name`) may take a label after it, which a second
// pass decides — as clang requires ("Size expression must be absolute").
func parseSizeDirective(p @Parser, l Lexer) (Lexer, Token) {
	var tok Token
	if !symAttrFormatOk(p, ".size") { return l, tok }
	l, tok = LexNext(l)
	if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) {
		setErr(p, "expected symbol name")
		return l, tok
	}
	var name @[]char = buf.CopyStr(tok.Text)
	l, tok = LexNext(l)
	if tok.Kind != TOK_COMMA {
		setErr(p, "expected comma")
		return l, tok
	}
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "expected the symbol's size"))
		return l, tok
	}
	recordSymAttr(p, name, r.Val, true)
	return l, tok
}

// symAttrFormatOk reports whether the object format is known and ELF, which has the
// directive dir, else sets the error.
func symAttrFormatOk(p @Parser, dir *[]readonly char) bool {
	if p.Asm.ObjFormat == asm.OBJ_UNKNOWN {
		setErr(p, buf.Concat(dir, " needs the object format, not yet known here"))
		return false
	}
	if p.Asm.ObjFormat == asm.OBJ_MACHO {
		setErr(p, buf.Concat(dir, " is an ELF directive: a Mach-O object has no symbol types or sizes"))
		return false
	}
	return true
}

// recordSymAttr records that a `.size` (isSize) or `.type` directive gave name the value v.
func recordSymAttr(p @Parser, name @[]char, v int64, isSize bool) {
	if p.NumSymAttrs >= len(p.SymAttrNames) {
		var n int = 2 * len(p.SymAttrNames)
		var names @[]@[]char = make_slice(@[]char, n)
		var vals @[]int64 = make_slice(int64, n)
		var sizes @[]bool = make_slice(bool, n)
		for j := 0; j < p.NumSymAttrs; j++ {
			names[j] = p.SymAttrNames[j]
			vals[j] = p.SymAttrValues[j]
			sizes[j] = p.SymAttrIsSize[j]
		}
		p.SymAttrNames = names
		p.SymAttrValues = vals
		p.SymAttrIsSize = sizes
	}
	p.SymAttrNames[p.NumSymAttrs] = name
	p.SymAttrValues[p.NumSymAttrs] = v
	p.SymAttrIsSize[p.NumSymAttrs] = isSize
	p.NumSymAttrs = p.NumSymAttrs + 1
}

// dropSymAttrs forgets the `.type` and `.size` directives recorded for name so far: a common
// defined after them is an object of its own size, as clang makes it, where a `.size` kept
// would give the linker too few bytes to allocate.
func dropSymAttrs(p @Parser, name *[]readonly char) {
	var n int = 0
	for i := 0; i < p.NumSymAttrs; i++ {
		if charsEqual(p.SymAttrNames[i], name) { continue }
		p.SymAttrNames[n] = p.SymAttrNames[i]
		p.SymAttrValues[n] = p.SymAttrValues[i]
		p.SymAttrIsSize[n] = p.SymAttrIsSize[i]
		n = n + 1
	}
	p.NumSymAttrs = n
}

// recordedType returns the strongest type the `.type` directives recorded for name, or
// asm.SYM_NOTYPE for none, as clang combines a symbol's `.type`s.
func recordedType(p @Parser, name *[]readonly char) int {
	var t int = asm.SYM_NOTYPE
	for i := 0; i < p.NumSymAttrs; i++ {
		if p.SymAttrIsSize[i] || !charsEqual(p.SymAttrNames[i], name) { continue }
		if cast(int, p.SymAttrValues[i]) > t { t = cast(int, p.SymAttrValues[i]) }
	}
	return t
}

// aliasType returns the type of an alias whose own `.type`s give own and whose target's type is
// target, as clang's ELF writer merges them: its own function or indirect function keeps over a
// thread-local target, else the stronger of the two wins.
func aliasType(own int, target int) int {
	if target == asm.SYM_TLS && (own == asm.SYM_FUNC || own == asm.SYM_IFUNC) { return own }
	if own > target { return own }
	return target
}

// applySymbolAttrs gives each symbol what its `.type` and `.size` directives recorded — the
// strongest type, the last size.  Before the constants are listed (final false) it gives them
// only to the symbols already in the table, so that an alias then takes its target's, as clang
// gives it them; after (final true) to every name again, a `.type` of a name the input neither
// defines nor declares entering it as an external reference, as a visibility directive does
// (clang lists it so) — but not a temporary label, a constant the table does not list, nor a
// name `.local` declared — and a `.size` of one doing nothing (clang lists no symbol for it).
func applySymbolAttrs(p @Parser, final bool) {
	for i := 0; i < p.NumSymAttrs; i++ {
		var name @[]char = p.SymAttrNames[i]
		var isSize bool = p.SymAttrIsSize[i]
		if p.Asm.LookupSymbol(name) < 0 {
			if !final || isSize || constIndex(p, name) >= 0 || asm.IsTemporaryLabel(name, p.Asm.ObjFormat) ||
					declaredLocal(p, name) {
				continue
			}
			p.Asm.SetGlobal(name)
		}
		if isSize {
			p.Asm.SetSize(name, p.SymAttrValues[i])
		} else {
			p.Asm.SetType(name, cast(int, p.SymAttrValues[i]))
		}
	}
}
