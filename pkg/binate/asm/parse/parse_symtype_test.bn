package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The `.type` and `.size` directives (parse_symtype.bn) against clang's symbol tables
// (`clang -c -target aarch64-linux-gnu`, armv7a-linux-gnueabihf and x86_64-linux-gnu;
// llvm-readelf -s).  (diffSource / diffReject are in expr_diff_test.bn, goldenFail in
// aarch64_golden_test.bn.)

// attrCheck appends to e a failure for src unless p has a symbol name of type t and size n.
func attrCheck(e @[]char, p @Parser, src *[]readonly char, name *[]readonly char, t int,
		n int64) @[]char {
	var i int = p.Asm.LookupSymbol(name)
	if i >= 0 && p.Asm.Symbols[i].Type == t && p.Asm.Symbols[i].Size == n { return e }
	return goldenFail(e, src, buf.Concat("wrong type or size: ", name))
}

// attrSource parses src for an ELF target, appending to e a failure when it is rejected.
func attrSource(e @[]char, src *[]readonly char) (@Parser, @[]char) {
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	if p.HasError { return p, goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return p, goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	return p, e
}

// Every spelling clang takes for a type: a name, STT_<NAME>, a quoted name, or a name after
// `@`, `%` or `#` on AArch64, the comma optional; common is an object.
func TestTypeDirectiveSpellings() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\n.type f1, @function\n"
			".type f2, %function\n.type f3, \"function\"\n.type f4, STT_FUNC\n.type f5 STT_FUNC\n"
			".type f6, function\n.type f7, #function\n.type i1, @gnu_indirect_function\n"
			".type i2, STT_GNU_IFUNC\nf1:\nf2:\nf3:\nf4:\nf5:\nf6:\nf7:\ni1:\ni2: ret\n.section data\n"
			".type o1, @object\n.type o2, STT_OBJECT\n.type o3, @common\n.type o4, STT_COMMON\n"
			".type n1, @notype\n.type n2, STT_NOTYPE\no1:\no2:\no3:\no4:\nn1:\nn2: .uint64 1"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "f1", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f2", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f3", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f4", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f5", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f6", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f7", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "i1", asm.SYM_IFUNC, 0)
	e = attrCheck(e, p, src, "i2", asm.SYM_IFUNC, 0)
	e = attrCheck(e, p, src, "o1", asm.SYM_OBJECT, 0)
	e = attrCheck(e, p, src, "o2", asm.SYM_OBJECT, 0)
	e = attrCheck(e, p, src, "o3", asm.SYM_OBJECT, 0)
	e = attrCheck(e, p, src, "o4", asm.SYM_OBJECT, 0)
	e = attrCheck(e, p, src, "n1", asm.SYM_NOTYPE, 0)
	e = attrCheck(e, p, src, "n2", asm.SYM_NOTYPE, 0)
	return e
}

// A symbol given two types keeps the stronger (function over object over notype), in either
// order, as clang combines them; an alias takes its target's type and size, though they are
// given after it, and keeps the stronger against its own `.type`.
func TestTypeDirectiveCombines() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\n.type a, @function\n.type a, @object\n"
			".type b, @object\n.type b, @function\n.type c, @function\n.type c, @notype\n"
			"a:\nb:\nc:\nf: ret\nA = f\nB = f + 4\n.type f, @function\n.size f, 8\n.type B, @object"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "a", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "b", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "c", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "f", asm.SYM_FUNC, 8)
	e = attrCheck(e, p, src, "A", asm.SYM_FUNC, 8)
	e = attrCheck(e, p, src, "B", asm.SYM_FUNC, 8)
	return e
}

// `.size` takes a number: `. - f`, a difference with a label after it (decided on a second
// pass), a constant, a negative one; the last one wins.  It gives an undefined symbol its
// size, and makes no symbol for a name nothing else lists — where `.type` enters one as an
// undefined global, as clang lists both.
func TestSizeDirective() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\nf: ret\n.size f, . - f\n"
			".size g, .Lend - g\ng: ret\nret\n.Lend:\nh: ret\n.size h, 16\n.size h, 2\n"
			"k: ret\n.size k, -1\n.global u\n.size u, 4\n.size nothing, 4\n.type ext, @function"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "f", asm.SYM_NOTYPE, 4)
	e = attrCheck(e, p, src, "g", asm.SYM_NOTYPE, 8)
	e = attrCheck(e, p, src, "h", asm.SYM_NOTYPE, 2)
	e = attrCheck(e, p, src, "k", asm.SYM_NOTYPE, -1)
	e = attrCheck(e, p, src, "u", asm.SYM_NOTYPE, 4)
	e = attrCheck(e, p, src, "ext", asm.SYM_FUNC, 0)
	var x int = p.Asm.LookupSymbol("ext")
	if x < 0 || p.Asm.Symbols[x].Binding != asm.BIND_GLOBAL || p.Asm.Symbols[x].Section >= 0 {
		e = goldenFail(e, src, "ext is not an undefined global")
	}
	if p.Asm.LookupSymbol("nothing") >= 0 { e = goldenFail(e, src, "a symbol listed for nothing") }
	return e
}

// What clang rejects: a name that is no type, no type at all, `.size` without its comma or
// with a size that is not a number (a difference across sections, an external symbol); and
// what the assembler does not support — a thread-local or GNU_UNIQUE symbol.  `@` starts a
// comment on ARM and `#` on x86-64, so neither introduces a type there.  Mach-O has neither
// directive, and they need the object format known.
func TestSymAttrDirectiveRejects() testing.TestResult {
	var e @[]char = ""
	var pre *[]readonly char = ".arch aarch64\n.section text\nf: ret\n"
	e = diffReject(e, buf.Concat(pre, ".type f, @bogus"), asm.OBJ_ELF, "is not a symbol type")
	e = diffReject(e, buf.Concat(pre, ".type f"), asm.OBJ_ELF, "expected a symbol type")
	e = diffReject(e, buf.Concat(pre, ".size f 4"), asm.OBJ_ELF, "expected comma")
	e = diffReject(e, buf.Concat(pre, ".section data\ng: .uint8 1\n.section text\n.size f, g - f"),
			asm.OBJ_ELF, "")
	e = diffReject(e, buf.Concat(pre, ".global ext\n.size f, ext"), asm.OBJ_ELF, "")
	e = diffReject(e, buf.Concat(pre, ".type f, @tls_object"), asm.OBJ_ELF, "thread-local")
	e = diffReject(e, buf.Concat(pre, ".type f, STT_TLS"), asm.OBJ_ELF, "thread-local")
	e = diffReject(e, buf.Concat(pre, ".type f, @gnu_unique_object"), asm.OBJ_ELF, "gnu_unique_object")
	e = diffReject(e, ".arch arm32\n.section text\nf: bx lr\n.type f, @function", asm.OBJ_ELF,
			"expected a symbol type")
	e = diffReject(e, ".arch x64\n.section text\nf: ret\n.type f, #function", asm.OBJ_ELF,
			"expected a symbol type")
	e = diffReject(e, buf.Concat(pre, ".type f, @function"), asm.OBJ_MACHO, "is an ELF directive")
	e = diffReject(e, buf.Concat(pre, ".size f, 4"), asm.OBJ_MACHO, "is an ELF directive")
	e = diffReject(e, buf.Concat(pre, ".type f, @function"), asm.OBJ_UNKNOWN,
			"needs the object format")
	return e
}

// On ARM and x86-64 the spellings clang takes there are accepted: `%` and `#` on ARM, `%` and
// `@` on x86-64.
func TestTypeDirectiveArchSpellings() testing.TestResult {
	var e @[]char = ""
	var arm *[]readonly char = ".arch arm32\n.section text\n.type f, %function\n.type g, #function\n"
			"f:\ng: bx lr"
	var p @Parser
	p, e = attrSource(e, arm)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, arm, "f", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, arm, "g", asm.SYM_FUNC, 0)
	var x86 *[]readonly char = ".arch x64\n.section text\n.type f, %function\n.type g, @function\n"
			"f:\ng: ret"
	p, e = attrSource(e, x86)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, x86, "f", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, x86, "g", asm.SYM_FUNC, 0)
	return e
}

// A common defined after a `.type` and `.size` is an object of its own size, as clang makes
// it — `.lcomm` (d) and `.comm` (e) — while a `.type` and `.size` after one apply (f).
func TestSymAttrsAndCommons() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.type d, %function\n.size d, 16\n.lcomm d, 4\n"
			".type e, %function\n.size e, 16\n.comm e, 8, 8\n.lcomm f, 4\n.type f, %function\n"
			".size f, 12"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "d", asm.SYM_OBJECT, 4)
	e = attrCheck(e, p, src, "e", asm.SYM_OBJECT, 8)
	e = attrCheck(e, p, src, "f", asm.SYM_FUNC, 12)
	return e
}

// `.type` and `.size` give a constant (an absolute symbol), an undefined weak symbol and an
// external a visibility directive entered their type and size, as clang lists them; a
// temporary label gets no symbol.
func TestSymAttrsOnOtherSymbols() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\n.type N, %object\n.size N, 4\nN = 5\n"
			".weak w\n.type w, %function\n.size w, 3\n.hidden h\n.type h, %object\n.size h, 2\n"
			".type .Ltmp, @function"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "N", asm.SYM_OBJECT, 4)
	e = attrCheck(e, p, src, "w", asm.SYM_FUNC, 3)
	e = attrCheck(e, p, src, "h", asm.SYM_OBJECT, 2)
	var wi int = p.Asm.LookupSymbol("w")
	if wi >= 0 && p.Asm.Symbols[wi].Binding != asm.BIND_WEAK {
		e = goldenFail(e, src, "w is not weak")
	}
	var hi int = p.Asm.LookupSymbol("h")
	if hi >= 0 && p.Asm.Symbols[hi].Visibility != asm.VIS_HIDDEN {
		e = goldenFail(e, src, "h is not hidden")
	}
	if p.Asm.LookupSymbol(".Ltmp") >= 0 { e = goldenFail(e, src, "the temporary .Ltmp listed") }
	return e
}
