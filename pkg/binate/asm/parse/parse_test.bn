package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

func fail(msg @[]char) testing.TestResult { return msg }

func readInst(s @asm.Section, off int) uint32 {
	return cast(uint32, s.Data[off]) | (cast(uint32, s.Data[off + 1]) << 8) |
			(cast(uint32, s.Data[off + 2]) << 16) | (cast(uint32, s.Data[off + 3]) << 24)
}

func newTestParser() @Parser {
	var a @asm.Assembler = asm.New(8)
	return NewParser(a, "test.s")
}

// lineRejected parses one line and checks that it is reported as an error —
// by the parser itself, or by the instruction encoder, which records an
// unencodable operand on the Assembler — and that it emits nothing into the
// current section.
func lineRejected(p @Parser, line *[]readonly char) testing.TestResult {
	var s @asm.Section = p.Asm.Sections[p.Asm.Current]
	var before int = s.Len
	p.ParseLine(line)
	if !p.HasError && !p.Asm.HasError {
		return fail(buf.Concat("expected an error for: ", line))
	}
	if s.Len != before {
		return fail(buf.Concat("a rejected line emitted bytes: ", line))
	}
	return ""
}

// lineEmitsWord parses one line into an empty section and checks that it
// assembles, with no parser or encoder error, to exactly the one 32-bit
// little-endian instruction word want.
func lineEmitsWord(p @Parser, line *[]readonly char, want uint32) testing.TestResult {
	p.ParseLine(line)
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.HasError { return fail(p.Asm.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[p.Asm.Current]
	if s.Len != 4 {
		return fail(buf.Concat("expected exactly one instruction word for: ", line))
	}
	if readInst(s, 0) != want {
		return fail(buf.Concat("wrong encoding for: ", line))
	}
	return ""
}

// lineEmitsHex parses one line into an empty section and checks that it
// assembles, with no parser or encoder error, to exactly the bytes spelled
// by hex — pairs of hex digits, with anything else (e.g. the spaces between
// bytes in objdump's listing) ignored.
func lineEmitsHex(p @Parser, line *[]readonly char, hex *[]readonly char) testing.TestResult {
	p.ParseLine(line)
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.HasError { return fail(p.Asm.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[p.Asm.Current]
	var n int = 0
	var hi int = -1
	for i := 0; i < len(hex); i++ {
		if !isHexDigit(hex[i]) { continue }
		if hi < 0 {
			hi = hexVal(hex[i])
			continue
		}
		if n >= s.Len || cast(int, s.Data[n]) != hi * 16 + hexVal(hex[i]) {
			return fail(buf.Concat("wrong encoding for: ", line))
		}
		n++
		hi = -1
	}
	if n != s.Len {
		return fail(buf.Concat("wrong encoding length for: ", line))
	}
	return ""
}

// --- Directive tests ---

func TestParseArch() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	if p.HasError { return fail("arch directive failed") }
	if p.Arch != ARCH_AARCH64 { return fail("expected aarch64") }
	return ""
}

func TestParseSection() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumSections != 1 { return fail("expected 1 section") }
	return ""
}

func TestParseLabel() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("my_func:")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.NumSymbols != 1 { return fail("expected 1 symbol") }
	return ""
}

func TestParseGlobal() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("my_func:")
	p.ParseLine(".global my_func")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.Symbols[0].Binding != asm.BIND_GLOBAL {
		return fail("expected global binding")
	}
	return ""
}

// .global_c marks the symbol global AND flags it CPrefix (the platform C-symbol
// prefix, applied at object-write time — `_` on Mach-O, none on ELF).
func TestParseGlobalC() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".arch aarch64")
	p.ParseLine(".section text")
	p.ParseLine("my_func:")
	p.ParseLine(".global_c my_func")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.Symbols[0].Binding != asm.BIND_GLOBAL {
		return fail("expected global binding")
	}
	if !p.Asm.Symbols[0].CPrefix {
		return fail("expected CPrefix set by .global_c")
	}
	return ""
}

func TestParseData() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".section data")
	p.ParseLine(".uint32 0xDEADBEEF")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 4 { return fail("expected 4 bytes") }
	if s.Data[0] != 0xEF { return fail("wrong byte 0") }
	if s.Data[3] != 0xDE { return fail("wrong byte 3") }
	return ""
}

func TestParseAsciz() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".section rodata")
	p.ParseLine(".asciz \"hi\"")
	if p.HasError { return fail(p.ErrorMsg) }
	var s @asm.Section = p.Asm.Sections[0]
	if s.Len != 3 { return fail("expected 3 bytes") }
	if s.Data[0] != 'h' { return fail("expected 'h'") }
	if s.Data[2] != 0 { return fail("expected null") }
	return ""
}

func TestParseConst() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine("PAGE_SIZE = 4096")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.NumConsts != 1 { return fail("expected 1 constant") }
	if p.ConstVals[0] != 4096 { return fail("expected 4096") }
	return ""
}

// The constant NAME must survive: in `name = expr`, lexing the expression
// reassigns `tok`, which RefDecs the sole-owned IDENT `Text` the name borrowed.
// A raw borrow would dangle and store a corrupted name.  `xy = 0 + 99` lexes the
// second operand "99" (2 chars, same size as "xy") AFTER the "xy" Text is freed,
// so a regressed build reuses the freed slot and stores the const under "99" —
// the "xy" lookup then fails.
func TestParseConstNamePreserved() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine("xy = 0 + 99")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.NumConsts != 1 { return fail("expected 1 constant") }
	v, ok := lookupConst(p, "xy")
	if !ok { return fail("constant 'xy' missing — name clobbered by the freed borrow") }
	if v != 99 { return fail("xy should be 99") }
	return ""
}

func TestParseAlign() testing.TestResult {
	var p @Parser = newTestParser()
	p.ParseLine(".section text")
	p.ParseLine(".uint8 0x01")
	p.ParseLine(".align 4")
	if p.HasError { return fail(p.ErrorMsg) }
	if p.Asm.Sections[0].Len != 4 { return fail("expected 4 bytes after align") }
	return ""
}
