package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Thread-local symbols against clang's (`clang -c`, llvm-readelf -s / llvm-objdump --macho
// --syms): `.type name, tls_object` in each spelling, and Mach-O's `.tbss`.  (attrSource /
// attrCheck are in parse_symtype_test.bn, diffSource / diffReject in expr_diff_test.bn.)

// tls_object in each spelling clang takes is SYM_TLS, the strongest type: it wins over a
// function in either order, and an undefined name it types is an undefined global.
func TestTypeDirectiveTls() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section data\n.type t1, @tls_object\n"
			".type t2, STT_TLS\n.type t3, %tls_object\n.type t4, \"tls_object\"\n"
			".type t5, @function\n.type t5, @tls_object\n.type t6, @tls_object\n.type t6, @function\n"
			"t1:\nt2:\nt3:\nt4:\nt5:\nt6: .uint32 1\n.type ext, @tls_object"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "t1", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "t2", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "t3", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "t4", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "t5", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "t6", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "ext", asm.SYM_TLS, 0)
	var x int = p.Asm.LookupSymbol("ext")
	if x < 0 || p.Asm.Symbols[x].Binding != asm.BIND_GLOBAL || p.Asm.Symbols[x].Section >= 0 {
		e = goldenFail(e, src, "ext is not an undefined global")
	}
	return e
}

// An alias takes its target's type merged with its own, as clang's ELF writer merges them: its
// own function or indirect function keeps over a thread-local target (a label in tdata, which
// is SYM_TLS whatever its `.type`, or a tls_object in data); an object of its own, or none,
// takes the target's; and its own tls_object keeps over a function target.
func TestTlsAliasTypes() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section tdata\n.type a, @function\na: .uint32 1\n"
			".type alf, @function\nalf = a\n.type ali, @gnu_indirect_function\nali = a\n"
			".type alo, @object\nalo = a\nal = a\n.section data\n.type d, @tls_object\nd: .uint32 2\n"
			".type adf, @function\nadf = d\nad = d\n.section text\n.type f, @function\nf: ret\n"
			".type at, @tls_object\nat = f\n.type af, @object\naf = f"
	var p @Parser
	p, e = attrSource(e, src)
	if len(e) != 0 { return e }
	e = attrCheck(e, p, src, "a", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "alf", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "ali", asm.SYM_IFUNC, 0)
	e = attrCheck(e, p, src, "alo", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "al", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "d", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "adf", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "ad", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "f", asm.SYM_FUNC, 0)
	e = attrCheck(e, p, src, "at", asm.SYM_TLS, 0)
	e = attrCheck(e, p, src, "af", asm.SYM_FUNC, 0)
	return e
}

// tbssCheck appends to e a failure for src unless p has name in the section tbss at offset
// off with size n, global when global is set.
func tbssCheck(e @[]char, p @Parser, src *[]readonly char, name *[]readonly char, off int, n int64,
		global bool) @[]char {
	var i int = p.Asm.LookupSymbol(name)
	if i < 0 { return goldenFail(e, src, buf.Concat("not defined: ", name)) }
	var s asm.Symbol = p.Asm.Symbols[i]
	if s.Section < 0 || !charsEqual(p.Asm.Sections[s.Section].Name, "tbss") ||
			s.Offset != cast(uint, off) || s.Size != n || (s.Binding == asm.BIND_GLOBAL) != global {
		return goldenFail(e, src, buf.Concat("wrong place, size or binding: ", name))
	}
	return e
}

// Mach-O's `.tbss name, size[, align]` defines a zero-filled object in tbss (__thread_bss),
// aligned to 2^align bytes (one without it), local unless `.global` comes before or after it;
// tbss is thread-local and zero-filled.
func TestTbssDirective() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.tbss _b$tlv$init, 4, 2\n.tbss _c$tlv$init, 8\n"
			".global _g\n.tbss _g, 2, 3\n.tbss _h, 0\n.global _h\n.section text\nret"
	var p @Parser = diffSource(src, asm.OBJ_MACHO)
	if p.HasError || p.Asm.HasError {
		return goldenFail(e, src, buf.Concat(buf.Concat("rejected: ", p.ErrorMsg), p.Asm.ErrorMsg))
	}
	e = tbssCheck(e, p, src, "_b$tlv$init", 0, 4, false)
	e = tbssCheck(e, p, src, "_c$tlv$init", 4, 8, false)
	e = tbssCheck(e, p, src, "_g", 16, 2, true)
	e = tbssCheck(e, p, src, "_h", 18, 0, true)
	var t int = p.Asm.Symbols[p.Asm.LookupSymbol("_g")].Section
	if (p.Asm.Sections[t].Flags & asm.SF_TLS) == 0 || p.Asm.Sections[t].Align != 8 {
		e = goldenFail(e, src, "tbss is not thread-local, or not aligned to its largest object")
	}
	return e
}

// `.tbss` defines a symbol only on Mach-O, so it needs the format known; the size may not be
// negative, the alignment exponent not negative or past 30 (beyond which `.zero` could not
// hold it); a size is required; and a name already defined, or a constant's, is an error.
func TestTbssDirectiveRejects() testing.TestResult {
	var e @[]char = ""
	var pre *[]readonly char = ".arch aarch64\n"
	e = diffReject(e, buf.Concat(pre, ".tbss x, 4"), asm.OBJ_ELF, "only on Mach-O")
	e = diffReject(e, buf.Concat(pre, ".tbss x, 4"), asm.OBJ_UNKNOWN, "needs the object format")
	e = diffReject(e, buf.Concat(pre, ".tbss x, -1"), asm.OBJ_MACHO, "size out of range")
	e = diffReject(e, buf.Concat(pre, ".tbss x, 4, -1"), asm.OBJ_MACHO, "alignment out of range")
	e = diffReject(e, buf.Concat(pre, ".tbss x, 4, 31"), asm.OBJ_MACHO, "alignment out of range")
	e = diffReject(e, buf.Concat(pre, ".tbss x"), asm.OBJ_MACHO, "expected ','")
	e = diffReject(e, buf.Concat(pre, ".section data\nx: .uint32 1\n.tbss x, 4"), asm.OBJ_MACHO,
			"already defined")
	e = diffReject(e, buf.Concat(pre, ".tbss x, 4\n.tbss x, 4"), asm.OBJ_MACHO, "already defined")
	e = diffReject(e, buf.Concat(pre, "X = 5\n.tbss X, 4"), asm.OBJ_MACHO, "is a constant")
	return e
}
