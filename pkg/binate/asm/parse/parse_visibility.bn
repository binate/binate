package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"

// Symbol-visibility directives: `.hidden`, `.internal` and `.protected` (ELF) and
// `.private_extern` (Mach-O), each naming one or more symbols separated by commas, as in
// clang.  Each format's directives are errors in the other, where clang rejects them too, so
// they need the object format known where they appear.

// parseVisibilityDirective handles an ELF visibility directive (vis its asm.VIS_*), or
// `.private_extern` when privateExtern is set.  `.private_extern` makes each symbol global,
// as clang does, and hidden; an ELF directive only records the visibility, which Finish
// gives the symbol (applyVisibilities) once every definition is known.
func parseVisibilityDirective(p @Parser, l Lexer, vis int, privateExtern bool) (Lexer, Token) {
	var tok Token
	if !visibilityFormatOk(p, privateExtern) { return l, tok }
	for {
		l, tok = LexNext(l)
		if tok.Kind != TOK_IDENT || isDigit(tok.Text[0]) {
			setErr(p, "expected symbol name")
			return l, tok
		}
		var name @[]char = buf.CopyStr(tok.Text)
		if privateExtern {
			p.Asm.SetGlobal(name)
			p.Asm.SetVisibility(name, asm.VIS_HIDDEN)
		} else {
			recordVisibility(p, name, vis)
		}
		l, tok = LexNext(l)
		if tok.Kind != TOK_COMMA { return l, tok }
	}
}

// visibilityFormatOk reports whether the object format is known and has the directive —
// Mach-O for `.private_extern` (privateExtern), ELF for the others — else sets the error.
func visibilityFormatOk(p @Parser, privateExtern bool) bool {
	if p.Asm.ObjFormat == asm.OBJ_UNKNOWN {
		setErr(p, "a visibility directive needs the object format, not yet known here")
		return false
	}
	var macho bool = p.Asm.ObjFormat == asm.OBJ_MACHO
	if privateExtern && !macho {
		setErr(p, ".private_extern is a Mach-O directive (ELF: .hidden)")
		return false
	}
	if !privateExtern && macho {
		setErr(p, ".hidden, .internal and .protected are ELF directives (Mach-O: .private_extern)")
		return false
	}
	return true
}

// recordVisibility records that an ELF visibility directive gave name the visibility vis.
func recordVisibility(p @Parser, name @[]char, vis int) {
	if p.NumVis >= len(p.VisNames) {
		var n int = 2 * len(p.VisNames)
		var names @[]@[]char = make_slice(@[]char, n)
		var vals @[]int = make_slice(int, n)
		for j := 0; j < p.NumVis; j++ {
			names[j] = p.VisNames[j]
			vals[j] = p.VisValues[j]
		}
		p.VisNames = names
		p.VisValues = vals
	}
	p.VisNames[p.NumVis] = name
	p.VisValues[p.NumVis] = vis
	p.NumVis = p.NumVis + 1
}

// applyVisibilities gives each symbol an ELF visibility directive named its visibility, the
// last one given winning, as in clang.  A name the input neither defines nor declares is an
// external reference, entered global as `.global` would enter it (clang lists it so) — but
// not a temporary label, nor a constant the symbol table does not list (a local alias of a
// symbol not defined here), which clang lists no symbol for either; nor a name `.local`
// declared, which stays undefined, so a reference to it is an error (clang lists it as an
// undefined local, which no linker resolves).
func applyVisibilities(p @Parser) {
	for i := 0; i < p.NumVis; i++ {
		var name @[]char = p.VisNames[i]
		if p.Asm.LookupSymbol(name) < 0 {
			if constIndex(p, name) >= 0 || asm.IsTemporaryLabel(name, p.Asm.ObjFormat) ||
					declaredLocal(p, name) {
				continue
			}
			p.Asm.SetGlobal(name)
		}
		p.Asm.SetVisibility(name, p.VisValues[i])
	}
}
