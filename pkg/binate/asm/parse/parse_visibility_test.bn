package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Symbol-visibility directives against clang's symbol tables (`clang -c -target
// aarch64-linux-gnu` for `.hidden`, `.internal` and `.protected`, `-target
// arm64-apple-macos` for `.private_extern`; llvm-readelf -s / llvm-readobj --symbols).
// (diffSource / diffReject are in expr_diff_test.bn, goldenFail in aarch64_golden_test.bn.)

// visSymIs reports whether p's symbol table holds name with binding, visibility vis, and
// defined or not as defined says.
func visSymIs(p @Parser, name *[]readonly char, binding int, vis int, defined bool) bool {
	var i int = p.Asm.LookupSymbol(name)
	if i < 0 { return false }
	var s asm.Symbol = p.Asm.Symbols[i]
	return s.Binding == binding && s.Visibility == vis && (s.Section >= 0 || s.Abs) == defined
}

// visCheck appends to e a failure for src when visSymIs does not hold.
func visCheck(e @[]char, p @Parser, src *[]readonly char, name *[]readonly char, binding int,
		vis int, defined bool) @[]char {
	if visSymIs(p, name, binding, vis, defined) { return e }
	return goldenFail(e, src, buf.Concat("wrong binding or visibility: ", name))
}

// The ELF directives, each naming a list: a label keeps its binding (local b, c, loc, e;
// global a, d; weak w) and takes the visibility, the last one given winning (e); a name
// never defined is an undefined global (u, x1, x2 — and z, referred to without `.global`);
// a constant is listed with its visibility (N absolute, B an alias), but a local alias of a
// symbol not defined here (A) and an undefined temporary (.Ly) are not listed.
func TestElfVisibilityDirectives() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\n.global a\n.hidden a\na: ret\n"
			".internal b, c\nb: ret\nc: ret\n.protected d\n.global d\nd: ret\n.global u\n"
			".hidden u\n.weak w\n.hidden w\nw: ret\n.hidden loc\nloc: ret\n.hidden x1, x2\n"
			".protected e\n.hidden e\ne: ret\nbl z\n.hidden z\n.hidden .Ly\n.hidden N\nN = 5\n"
			".global ext\n.hidden A\nA = ext\n.hidden B\nB = loc + 4\nbl u"
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	e = visCheck(e, p, src, "a", asm.BIND_GLOBAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "b", asm.BIND_LOCAL, asm.VIS_INTERNAL, true)
	e = visCheck(e, p, src, "c", asm.BIND_LOCAL, asm.VIS_INTERNAL, true)
	e = visCheck(e, p, src, "d", asm.BIND_GLOBAL, asm.VIS_PROTECTED, true)
	e = visCheck(e, p, src, "u", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	e = visCheck(e, p, src, "w", asm.BIND_WEAK, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "loc", asm.BIND_LOCAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "x1", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	e = visCheck(e, p, src, "x2", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	e = visCheck(e, p, src, "e", asm.BIND_LOCAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "z", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	e = visCheck(e, p, src, "N", asm.BIND_LOCAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "B", asm.BIND_LOCAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "ext", asm.BIND_GLOBAL, asm.VIS_DEFAULT, false)
	if p.Asm.LookupSymbol("A") >= 0 { e = goldenFail(e, src, "the alias A listed") }
	if p.Asm.LookupSymbol(".Ly") >= 0 { e = goldenFail(e, src, "the temporary .Ly listed") }
	return e
}

// `.private_extern` makes each named symbol global and hidden — a private external —
// defined here or not, a weak one staying weak.
func TestPrivateExternDirective() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\n.global _a\n.private_extern _a\n"
			"_a: ret\n.private_extern _b\n_b: ret\n.private_extern _u, _u2\n.private_extern _w\n"
			".weak _w\n_w: ret\nbl _u"
	var p @Parser = diffSource(src, asm.OBJ_MACHO)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	e = visCheck(e, p, src, "_a", asm.BIND_GLOBAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "_b", asm.BIND_GLOBAL, asm.VIS_HIDDEN, true)
	e = visCheck(e, p, src, "_u", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	e = visCheck(e, p, src, "_u2", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	e = visCheck(e, p, src, "_w", asm.BIND_WEAK, asm.VIS_HIDDEN, true)
	return e
}

// Each format's visibility directives are errors in the other (clang: "unknown directive"
// on Mach-O, "unable to emit symbol attribute" on ELF) and need the object format known;
// a list needs a symbol name before and after each comma, and nothing else — an empty one
// is an error, as an empty `.global` is, where clang takes either as doing nothing.
func TestVisibilityDirectivesRejected() testing.TestResult {
	var e @[]char = ""
	var pre *[]readonly char = ".arch aarch64\n.section text\n"
	e = diffReject(e, buf.Concat(pre, ".hidden a"), asm.OBJ_MACHO, "ELF directives")
	e = diffReject(e, buf.Concat(pre, ".internal a"), asm.OBJ_MACHO, "ELF directives")
	e = diffReject(e, buf.Concat(pre, ".protected a"), asm.OBJ_MACHO, "ELF directives")
	e = diffReject(e, buf.Concat(pre, ".private_extern a"), asm.OBJ_ELF, "Mach-O directive")
	e = diffReject(e, buf.Concat(pre, ".hidden a"), asm.OBJ_UNKNOWN, "object format")
	e = diffReject(e, buf.Concat(pre, ".hidden"), asm.OBJ_ELF, "expected symbol name")
	e = diffReject(e, buf.Concat(pre, ".hidden a,"), asm.OBJ_ELF, "expected symbol name")
	e = diffReject(e, buf.Concat(pre, ".hidden a b"), asm.OBJ_ELF, "unexpected token")
	e = diffReject(e, buf.Concat(pre, ".hidden 1"), asm.OBJ_ELF, "expected symbol name")
	e = diffReject(e, buf.Concat(pre, ".private_extern _a,"), asm.OBJ_MACHO, "expected symbol name")
	e = diffReject(e, buf.Concat(pre, ".private_extern Lt\nLt: ret"), asm.OBJ_MACHO,
			"cannot be global")
	e = diffReject(e, buf.Concat(pre, "_f: ret\nA = _f + 4\nbl A\n.private_extern A"), asm.OBJ_MACHO,
			"used before being made global")
	// A name `.local` declared stays undefined, so a reference to it has no symbol.
	e = diffReject(e, buf.Concat(pre, ".local lx\n.hidden lx\nbl lx"), asm.OBJ_ELF, "undefined symbol")
	return e
}

// A hidden external read by a label difference waiting for a later label: the first pass
// enters ext (an undefined global), so the second pass takes the difference as one against
// an external, a PC-relative relocation against ext, as clang makes it.
func TestHiddenExternalDifference() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section data\n.uint64 ext - .\n.hidden ext"
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	e = visCheck(e, p, src, "ext", asm.BIND_GLOBAL, asm.VIS_HIDDEN, false)
	if p.Asm.NumRelocs != 1 || p.Asm.Relocs[0].Symbol != p.Asm.LookupSymbol("ext") {
		e = goldenFail(e, src, "no relocation against ext")
	}
	return e
}
