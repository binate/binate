package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Directive counts in a zero-fill section past 1 GiB (maxDirectiveBytes).  (diffSource and
// diffReject are in expr_diff_test.bn, sectionIndex in parse_test.bn, goldenFail in
// aarch64_golden_test.bn.)

// zeroFillLen appends to e a failure unless src assembles for format with the section named
// name want bytes long.
func zeroFillLen(e @[]char, src *[]readonly char, format int, name *[]readonly char,
		want int64) @[]char {
	var p @Parser = diffSource(src, format)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var si int = sectionIndex(p, name)
	if si < 0 { return goldenFail(e, src, buf.Concat("no section ", name)) }
	if p.Asm.Sections[si].Len != want { return goldenFail(e, src, "the section's length is wrong") }
	return e
}

// bss and tbss count their zero bytes, so `.zero`, a `.fill` of zeros, `.lcomm` (or `.local`
// and `.comm`) and `.tbss` take counts past 1 GiB, bounded only by what the target can count
// (4 GiB on a 32-bit one); a section that holds its bytes keeps the bound, for zeros too, and
// so does a `.fill` of non-zero bytes in bss.
func TestZeroFillCountsPast1GiB() testing.TestResult {
	var e @[]char = ""
	var elf int = asm.OBJ_ELF
	e = zeroFillLen(e, ".arch aarch64\n.section bss\n.zero 0x100000000\n.fill 0x80000000, 2, 0", elf,
			"bss", 0x200000000)
	e = zeroFillLen(e, ".arch aarch64\n.section text\n.lcomm big, 0x100000000", elf, "bss",
			0x100000000)
	e = zeroFillLen(e, ".arch aarch64\n.section text\n.local x\n.comm x, 0x100000000, 8", elf, "bss",
			0x100000000)
	e = zeroFillLen(e, ".arch aarch64\n.tbss t, 0x100000000", asm.OBJ_MACHO, "tbss", 0x100000000)
	e = zeroFillLen(e, ".arch armv7-a\n.section bss\n.zero 0xC0000000", elf, "bss", 0xC0000000)
	e = diffReject(e, ".arch armv7-a\n.section bss\n.zero 0x100000000", elf, "4 GiB")
	e = diffReject(e, ".arch aarch64\n.section data\n.zero 0x40000001", elf,
			".zero count out of range")
	e = diffReject(e, ".arch aarch64\n.section data\n.fill 0x40000001, 1, 0", elf,
			".fill repeat count out of range")
	e = diffReject(e, ".arch aarch64\n.section bss\n.fill 0x40000001, 1, 1", elf,
			".fill repeat count out of range")
	e = diffReject(e, ".arch aarch64\n.section bss\n.fill 0x4000000000000000, 2, 0", elf,
			".fill repeat count out of range")
	return e
}
