package "pkg/binate/asm/parse"

import "pkg/binate/asm"

// The names the input refers to and nothing defines.  A name nothing defines or declares is
// an undefined global symbol for the linker, as clang makes it (`bl ext` with no `.global
// ext`).  The parser declares it (declareExterns) rather than the assembler, whose Finalize
// still rejects a reference to a symbol it was never given: to its in-process users, the
// native backends, which declare each external they call, such a reference is a definition
// they failed to emit.  A temporary label must be defined here, and so must a name `.local`
// declared (checkLocalsDefined).

// checkLocalsDefined reports, as the error, a name `.local` declared (and not made `.weak`
// after) that a reference uses and nothing defines: declareExterns would make it global, and
// `.local` says it is not.
// (clang lists such a name as an undefined local symbol, which no link can resolve.)  It runs
// after listConstants, so that a use through a local alias of the name (`A = x`, `bl A`)
// names the name itself (foldUnlistedAliasUses).
func checkLocalsDefined(p @Parser) {
	for i := 0; i < p.NumLocalNames; i++ {
		var name @[]char = p.LocalNames[i]
		if !usesName(p, name) || nameDefined(p, name) { continue }
		var si int = p.Asm.LookupSymbol(name)
		if si >= 0 &&
				(p.Asm.Symbols[si].Section >= 0 || p.Asm.Symbols[si].Abs || p.Asm.Symbols[si].Common ||
						p.Asm.Symbols[si].Binding != asm.BIND_LOCAL) {
			continue
		}
		setErr(p,
				quotedName(name, " is declared .local and never defined: an undefined symbol is global"))
		return
	}
}

// declareExterns makes each name a fixup refers to (as its label or its subtracted one)
// that the symbol table does not hold, and that is not a temporary label, an undefined
// global symbol, as `.global` would (declareExtern).  It runs after listConstants, which
// makes the uses of an alias of a symbol not defined here name that symbol, and before the
// last applySymbolAttrs, so that the name takes the `.size` and `.type` given it, as clang
// gives them.
func declareExterns(p @Parser) {
	var a @asm.Assembler = p.Asm
	for si := 0; si < a.NumSections; si++ {
		var sec @asm.Section = a.Sections[si]
		for fi := 0; fi < sec.NumFixups && !p.HasError; fi++ {
			declareExtern(p, sec.Fixups[fi].Label)
			declareExtern(p, sec.Fixups[fi].Sub)
		}
	}
}

// declareExtern makes name, which a fixup refers to, an undefined global symbol unless the
// symbol table holds it or it is a temporary label; a name a temporary label on one object
// format and not on the other (`Lx`, `.Lx`) needs the format known (objFormatHere).
func declareExtern(p @Parser, name *[]readonly char) {
	if len(name) == 0 || p.Asm.LookupSymbol(name) >= 0 { return }
	var format int = objFormatHere(p)
	if format == asm.OBJ_UNKNOWN &&
			asm.IsTemporaryLabel(name, asm.OBJ_ELF) != asm.IsTemporaryLabel(name, asm.OBJ_MACHO) {
		setErr(p,
				quotedName(name,
						" is defined nowhere here; whether it is a temporary label needs the object format, "
								"not yet known here"))
		return
	}
	if !asm.IsTemporaryLabel(name, format) { p.Asm.SetGlobal(name) }
}

// objFormatHere returns the object format, or ELF for arm32 while it is not yet known (arm32
// has no Mach-O output).
func objFormatHere(p @Parser) int {
	if p.Asm.ObjFormat == asm.OBJ_UNKNOWN && p.Arch == ARCH_ARM32 { return asm.OBJ_ELF }
	return p.Asm.ObjFormat
}
