package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// A name the file neither defines nor declares is an undefined global symbol for the
// linker, as clang makes it: each reference to it is a relocation against it -- a call
// and a conditional branch on AArch64 ELF, a call on Mach-O, a call and a literal-pool
// word on arm32, a call, a jump and a load on x86-64.  A temporary label must still be
// defined here, and so must a name `.local` declared, used directly or through a local
// alias.  (A reference the object format has no relocation for, a Mach-O conditional
// branch, is the object writer's error, a case of TestAssembleFileReportsAssemblerErrors.)

// externRef checks that p, which assembled src, holds name as an undefined global symbol
// with its nRelocs relocations all against it.
func externRef(e @[]char, src *[]readonly char, p @Parser, name *[]readonly char,
		nRelocs int) @[]char {
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var si int = p.Asm.LookupSymbol(name)
	if si < 0 || p.Asm.Symbols[si].Section >= 0 || p.Asm.Symbols[si].Binding != asm.BIND_GLOBAL {
		return goldenFail(e, src, "the name is not an undefined global symbol")
	}
	if p.Asm.NumRelocs != nRelocs { return goldenFail(e, src, "wrong number of relocations") }
	for i := 0; i < p.Asm.NumRelocs; i++ {
		if p.Asm.Relocs[i].Symbol != si { return goldenFail(e, src, "a relocation is not against it") }
	}
	return e
}

func TestUndefinedNameIsExternal() testing.TestResult {
	var e @[]char = ""
	var s1 *[]readonly char = ".arch aarch64\n.section text\nbl ext\nb.eq ext\n"
	e = externRef(e, s1, diffSource(s1, asm.OBJ_ELF), "ext", 2)
	var s2 *[]readonly char = ".arch aarch64\n.section text\nbl _ext\n"
	e = externRef(e, s2, diffSource(s2, asm.OBJ_MACHO), "_ext", 1)
	var s3 *[]readonly char = "ldr r0, =ext\nbl ext"
	e = externRef(e, s3, arm32Source(s3), "ext", 2)
	var s4 *[]readonly char = "call ext\njmp ext\nlea rax, [rip + ext]"
	e = externRef(e, s4, x64Source(s4), "ext", 3)
	e = diffReject(e, ".arch aarch64\n.section text\nb .Lnone\n", asm.OBJ_ELF,
			"undefined temporary label '.Lnone'")
	e = diffReject(e, ".arch aarch64\n.section text\n.local lx\nbl lx\n", asm.OBJ_ELF,
			"declared .local")
	e = diffReject(e, ".arch aarch64\n.section text\n.local lx\nA = lx\nbl A\n", asm.OBJ_ELF,
			"declared .local")
	e = diffReject(e, ".arch aarch64\n.section data\n.local lx\n.uint32 lx - .\n", asm.OBJ_ELF,
			"declared .local")
	return e
}

// A name `.local` declared and then `.weak` is weak (where clang warns): a reference to it,
// defined nowhere, is a relocation against an undefined weak symbol.
func TestUndefinedLocalMadeWeak() testing.TestResult {
	var src *[]readonly char = ".arch aarch64\n.section text\n.local x\n.weak x\nbl x\n"
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	if p.HasError { return goldenFail("", src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail("", src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var si int = p.Asm.LookupSymbol("x")
	if si < 0 || p.Asm.Symbols[si].Section >= 0 || p.Asm.Symbols[si].Binding != asm.BIND_WEAK {
		return goldenFail("", src, "x is not an undefined weak symbol")
	}
	if p.Asm.NumRelocs != 1 || p.Asm.Relocs[0].Symbol != si {
		return goldenFail("", src, "the call is not a relocation against x")
	}
	return ""
}

// A name defined nowhere in a label difference is an external symbol, as one `.global`
// declares: on ELF the minuend of a PC-relative datum (R_AARCH64_PREL32 against it); on Mach-O
// either side of a datum (ARM64_RELOC_SUBTRACTOR and UNSIGNED), each as clang makes it.
func TestUndefinedNameInADifference() testing.TestResult {
	var e @[]char = ""
	var s1 *[]readonly char = ".arch aarch64\n.section data\n.uint32 ext - .\n"
	e = externRef(e, s1, diffSource(s1, asm.OBJ_ELF), "ext", 1)
	var s2 *[]readonly char = ".arch aarch64\n.section data\n_a: .uint64 _a - _ext\n"
	var p @Parser = diffSource(s2, asm.OBJ_MACHO)
	e = externSubtracted(e, s2, p, "_ext")
	var s3 *[]readonly char = ".arch aarch64\n.section data\n_a: .uint64 _ext - .\n"
	e = externRef(e, s3, diffSource(s3, asm.OBJ_MACHO), "_ext", 1)
	// A temporary label must still be defined; an undeclared subtrahend on ELF has no relocation,
	// as a declared one has none.
	e = diffReject(e, ".arch aarch64\n.section data\n.uint32 .Lx - .\n", asm.OBJ_ELF,
			"'.Lx' is not a label defined anywhere")
	e = diffReject(e, ".arch aarch64\n.section data\nl: .uint32 l - ext\n", asm.OBJ_ELF,
			"'ext' is external: no ELF relocation subtracts a symbol")
	return e
}

// externSubtracted checks that p, which assembled src, holds name as an undefined global symbol
// that its one relocation subtracts.
func externSubtracted(e @[]char, src *[]readonly char, p @Parser, name *[]readonly char) @[]char {
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	if p.Asm.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.Asm.ErrorMsg)) }
	var si int = p.Asm.LookupSymbol(name)
	if si < 0 || p.Asm.Symbols[si].Section >= 0 || p.Asm.Symbols[si].Binding != asm.BIND_GLOBAL {
		return goldenFail(e, src, "the name is not an undefined global symbol")
	}
	if p.Asm.NumRelocs != 1 || !p.Asm.Relocs[0].HasSub || p.Asm.Relocs[0].SubSymbol != si {
		return goldenFail(e, src, "the relocation does not subtract it")
	}
	return e
}

// A name only referred to takes the `.size` and `.type` given it, as clang gives them
// (`.size ext, 4` / `bl ext`: an undefined global of st_size 4).
func TestUndefinedNameTakesItsSize() testing.TestResult {
	var e @[]char = ""
	var src *[]readonly char = ".arch aarch64\n.section text\n.size ext, 4\nbl ext\n"
	var p @Parser = diffSource(src, asm.OBJ_ELF)
	e = externRef(e, src, p, "ext", 1)
	var si int = p.Asm.LookupSymbol("ext")
	if len(e) == 0 && p.Asm.Symbols[si].Size != 4 { e = goldenFail(e, src, "the size is not 4") }
	return e
}

// Whether a name defined nowhere is a temporary label (`.Lx` on ELF, `Lx` on Mach-O), which
// must be defined, or an external, needs the object format, but for arm32 (ELF); a name
// neither (`ext`) does not.
func TestUndefinedNameNeedsTheFormatToBeTemporary() testing.TestResult {
	var e @[]char = ""
	var want *[]readonly char = "needs the object format"
	e = diffReject(e, ".arch aarch64\n.section text\nbl .Lx\n", asm.OBJ_UNKNOWN, want)
	e = diffReject(e, ".arch aarch64\n.section text\nbl Lx\n", asm.OBJ_UNKNOWN, want)
	// arm32 has no Mach-O output: it takes ELF's temporary labels.
	e = externRef(e, "bl Lx", arm32SourceIn("bl Lx", asm.OBJ_UNKNOWN), "Lx", 1)
	var pt @Parser = arm32SourceIn("bl .Lx", asm.OBJ_UNKNOWN)
	if !plContains(pt.ErrorMsg, "undefined temporary label '.Lx'") &&
			!plContains(pt.Asm.ErrorMsg, "undefined temporary label '.Lx'") {
		e = goldenFail(e, "bl .Lx", "an undefined .Lx is not reported as a temporary label")
	}
	var src *[]readonly char = ".arch aarch64\n.section text\nbl ext\n"
	var p @Parser = newTestParser()
	p.ParseSource(src)
	if p.HasError { return goldenFail(e, src, buf.Concat("rejected: ", p.ErrorMsg)) }
	var si int = p.Asm.LookupSymbol("ext")
	if si < 0 || p.Asm.Symbols[si].Binding != asm.BIND_GLOBAL {
		return goldenFail(e, src, "the name is not a global symbol")
	}
	return e
}
