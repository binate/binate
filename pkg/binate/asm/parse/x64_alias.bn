package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sys"

// Other spellings clang takes in Intel syntax: `clr reg` (xor reg, reg, at any size); `inb`,
// `inw`, `inl` and `outb`, `outw`, `outl` with the port alone (a number -128..255 or dx), the
// accumulator implied by the suffix (AT&T's names); and `mov.s`, a move between registers in its
// other encoding (x64.MovS).  The encoders check the operands.

// x64AliasInstruction parses and emits the instruction mnem (l just after it) when it is one of
// these, and reports whether it was.
func x64AliasInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var port int = x64WordIndex(mnem, " inb inw inl outb outw outl ")
	var clr bool = mnemIs(mnem, "clr")
	var movs bool = mnemIs(mnem, "mov.s")
	if port < 0 && !clr && !movs { return false }
	var n int = 1
	if movs { n = 2 }
	first, second, _, ok := parseX64SysOperands(p, l, n)
	if !ok { return true }
	if clr {
		if first.Kind != x64.OP_REG {
			setErr(p, "clr takes a register")
			return true
		}
		x64.Xor(p.Asm, first, first)
	} else if movs {
		x64.MovS(p.Asm, first, second)
	} else {
		var size int = x64.SZ8
		if port % 3 == 1 { size = x64.SZ16 }
		if port % 3 == 2 { size = x64.SZ32 }
		var acc x64.Operand = x64.Reg(x64.RAX, size)
		if port < 3 {
			sys.In(p.Asm, acc, first)
		} else {
			sys.Out(p.Asm, first, acc)
		}
	}
	return true
}
