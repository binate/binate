package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The other spellings (x64_alias.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`).  (x64SrcHex and x64LineRejected are in x64_target_test.bn.)

// clr at each size, R8..R15, SPL..DIL and AH; inb .. outl with a port number or dx; mov.s at each
// size, in upper case.
func TestX64Aliases() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "clr eax", "31 c0")
	e = x64SrcHex(e, "clr al", "30 c0")
	e = x64SrcHex(e, "clr ax", "66 31 c0")
	e = x64SrcHex(e, "CLR rax", "48 31 c0")
	e = x64SrcHex(e, "clr r9", "4d 31 c9")
	e = x64SrcHex(e, "clr r9b", "45 30 c9")
	e = x64SrcHex(e, "clr ah", "30 e4")
	e = x64SrcHex(e, "clr sil", "40 30 f6")
	e = x64SrcHex(e, "inb 1", "e4 01")
	e = x64SrcHex(e, "inw 1", "66 e5 01")
	e = x64SrcHex(e, "inl 1", "e5 01")
	e = x64SrcHex(e, "outb 1", "e6 01")
	e = x64SrcHex(e, "outw 1", "66 e7 01")
	e = x64SrcHex(e, "OUTL 1", "e7 01")
	e = x64SrcHex(e, "inb dx", "ec")
	e = x64SrcHex(e, "inl dx", "ed")
	e = x64SrcHex(e, "outb dx", "ee")
	e = x64SrcHex(e, "outw dx", "66 ef")
	e = x64SrcHex(e, "N = 4\ninb N", "e4 04")
	e = x64SrcHex(e, "mov.s eax, ebx", "8b c3")
	e = x64SrcHex(e, "MOV.S rax, rbx", "48 8b c3")
	e = x64SrcHex(e, "mov.s al, bl", "8a c3")
	e = x64SrcHex(e, "mov.s ax, bx", "66 8b c3")
	e = x64SrcHex(e, "mov.s r9, r10", "4d 8b ca")
	e = x64SrcHex(e, "mov.s sil, al", "40 8a f0")
	e = x64SrcHex(e, "mov.s ah, al", "8a e0")
	return e
}

// What clang rejects: clr of memory; the port past 255, the accumulator written, a 64-bit form,
// no port; mov.s with memory, an immediate, two sizes, ah beside a REX.
func TestX64AliasRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "clr [rax]")
	e = x64LineRejected(e, "clr")
	e = x64LineRejected(e, "inb 256")
	e = x64LineRejected(e, "inb al, dx")
	e = x64LineRejected(e, "inb al, 1")
	e = x64LineRejected(e, "outb 1, al")
	e = x64LineRejected(e, "inq 1")
	e = x64LineRejected(e, "inb")
	e = x64LineRejected(e, "inb cx")
	e = x64LineRejected(e, "mov.s eax, [rbx]")
	e = x64LineRejected(e, "mov.s eax, 1")
	e = x64LineRejected(e, "mov.s eax, bx")
	e = x64LineRejected(e, "mov.s ah, sil")
	return e
}
