package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/avx"

// The VEX- and XOP-encoded vector instructions (pkg/binate/asm/x64/avx's instruction table), as
// clang takes them in Intel syntax: a mnemonic the table has, with up to five operands — XMM
// registers xmm0..xmm15, YMM registers ymm0..ymm15, general registers, memory (a gather's with an
// XMM or YMM index: x64_mem.bn), immediates.  The table's encoder checks the operands.  A data16
// prefix cannot stand before one, as GNU as says ("data size prefix invalid"; clang emits the 66
// before the prefix), and neither can lock, a repeat prefix or xacquire / xrelease (x64_prefix.bn).

// x64YmmIndex returns i of the register name ymm<i> (in any case, i 0..15 with no leading zero),
// or -1.
func x64YmmIndex(name *[]readonly char) int { return x64VecIndex(name, "ymm") }

// x64AvxInstruction parses and emits the AVX instruction mnem (l just after it) when the table has
// it, and reports whether it did.
func x64AvxInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !avx.Has(mnem) { return false }
	if p.X64Data16 {
		setErr(p, "data16 cannot stand before a VEX- or XOP-encoded instruction (GNU as: data size "
				"prefix invalid)")
		return true
	}
	var tok Token
	l, tok = LexNext(l)
	var ops [5]x64.Operand
	var n int = 0
	for tok.Kind != TOK_EOF {
		if n == 5 {
			setErr(p, "a VEX-encoded instruction takes up to five operands")
			return true
		}
		if n > 0 {
			if tok.Kind != TOK_COMMA {
				setErr(p, "expected ','")
				return true
			}
			l, tok = LexNext(l)
		}
		var op x64.Operand
		p.X64Vsib = true
		l, tok, op = parseX64Operand(p, l, tok)
		p.X64Vsib = false
		if p.HasError || !x64TlsCallOk(p, op) { return true }
		ops[n] = op
		n++
	}
	x64EmitSeg(p)
	_ = avx.Emit(p.Asm, mnem, ops[0:n])
	return true
}
