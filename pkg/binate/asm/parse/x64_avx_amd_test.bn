package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AMD's FMA4 and XOP vector instructions (x64_avx.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form of the table's AMD
// part, with registers 8..15 and memory with a base of r10 where the form takes them; the encodings
// in full are package avx's tests.  (x64SrcHex and x64LineRejected are in x64_target_test.bn,
// x64LineErrorHas in x64_prefix_test.bn.)

func TestX64AvxAmd() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vfmaddpd xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 69 0a d0")
	e = x64SrcHex(e, "vfmaddpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 69 0a f0")
	e = x64SrcHex(e, "vfmaddpd ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 69 12 e0")
	e = x64SrcHex(e, "vfmaddpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 69 12 80")
	e = x64SrcHex(e, "vfmaddps xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 68 0a d0")
	e = x64SrcHex(e, "vfmaddps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 68 0a f0")
	e = x64SrcHex(e, "vfmaddps ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 68 12 e0")
	e = x64SrcHex(e, "vfmaddps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 68 12 80")
	e = x64SrcHex(e, "vfmaddsd xmm9, xmm11, xmm13, qword ptr [r10]", "c4 43 a1 6b 0a d0")
	e = x64SrcHex(e, "vfmaddsd xmm9, xmm11, qword ptr [r10], xmm15", "c4 43 21 6b 0a f0")
	e = x64SrcHex(e, "vfmaddss xmm9, xmm11, xmm13, dword ptr [r10]", "c4 43 a1 6a 0a d0")
	e = x64SrcHex(e, "vfmaddss xmm9, xmm11, dword ptr [r10], xmm15", "c4 43 21 6a 0a f0")
	e = x64SrcHex(e, "vfmaddsubpd xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 5d 0a d0")
	e = x64SrcHex(e, "vfmaddsubpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 5d 0a f0")
	e = x64SrcHex(e, "vfmaddsubpd ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 5d 12 e0")
	e = x64SrcHex(e, "vfmaddsubpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 5d 12 80")
	e = x64SrcHex(e, "vfmaddsubps xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 5c 0a d0")
	e = x64SrcHex(e, "vfmaddsubps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 5c 0a f0")
	e = x64SrcHex(e, "vfmaddsubps ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 5c 12 e0")
	e = x64SrcHex(e, "vfmaddsubps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 5c 12 80")
	e = x64SrcHex(e, "vfmsubaddpd xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 5f 0a d0")
	e = x64SrcHex(e, "vfmsubaddpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 5f 0a f0")
	e = x64SrcHex(e, "vfmsubaddpd ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 5f 12 e0")
	e = x64SrcHex(e, "vfmsubaddpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 5f 12 80")
	e = x64SrcHex(e, "vfmsubaddps xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 5e 0a d0")
	e = x64SrcHex(e, "vfmsubaddps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 5e 0a f0")
	e = x64SrcHex(e, "vfmsubaddps ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 5e 12 e0")
	e = x64SrcHex(e, "vfmsubaddps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 5e 12 80")
	e = x64SrcHex(e, "vfmsubpd xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 6d 0a d0")
	e = x64SrcHex(e, "vfmsubpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 6d 0a f0")
	e = x64SrcHex(e, "vfmsubpd ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 6d 12 e0")
	e = x64SrcHex(e, "vfmsubpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 6d 12 80")
	e = x64SrcHex(e, "vfmsubps xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 6c 0a d0")
	e = x64SrcHex(e, "vfmsubps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 6c 0a f0")
	e = x64SrcHex(e, "vfmsubps ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 6c 12 e0")
	e = x64SrcHex(e, "vfmsubps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 6c 12 80")
	e = x64SrcHex(e, "vfmsubsd xmm9, xmm11, xmm13, qword ptr [r10]", "c4 43 a1 6f 0a d0")
	e = x64SrcHex(e, "vfmsubsd xmm9, xmm11, qword ptr [r10], xmm15", "c4 43 21 6f 0a f0")
	e = x64SrcHex(e, "vfmsubss xmm9, xmm11, xmm13, dword ptr [r10]", "c4 43 a1 6e 0a d0")
	e = x64SrcHex(e, "vfmsubss xmm9, xmm11, dword ptr [r10], xmm15", "c4 43 21 6e 0a f0")
	e = x64SrcHex(e, "vfnmaddpd xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 79 0a d0")
	e = x64SrcHex(e, "vfnmaddpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 79 0a f0")
	e = x64SrcHex(e, "vfnmaddpd ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 79 12 e0")
	e = x64SrcHex(e, "vfnmaddpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 79 12 80")
	e = x64SrcHex(e, "vfnmaddps xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 78 0a d0")
	e = x64SrcHex(e, "vfnmaddps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 78 0a f0")
	e = x64SrcHex(e, "vfnmaddps ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 78 12 e0")
	e = x64SrcHex(e, "vfnmaddps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 78 12 80")
	e = x64SrcHex(e, "vfnmaddsd xmm9, xmm11, xmm13, qword ptr [r10]", "c4 43 a1 7b 0a d0")
	e = x64SrcHex(e, "vfnmaddsd xmm9, xmm11, qword ptr [r10], xmm15", "c4 43 21 7b 0a f0")
	e = x64SrcHex(e, "vfnmaddss xmm9, xmm11, xmm13, dword ptr [r10]", "c4 43 a1 7a 0a d0")
	e = x64SrcHex(e, "vfnmaddss xmm9, xmm11, dword ptr [r10], xmm15", "c4 43 21 7a 0a f0")
	e = x64SrcHex(e, "vfnmsubpd xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 7d 0a d0")
	e = x64SrcHex(e, "vfnmsubpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 7d 0a f0")
	e = x64SrcHex(e, "vfnmsubpd ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 7d 12 e0")
	e = x64SrcHex(e, "vfnmsubpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 7d 12 80")
	e = x64SrcHex(e, "vfnmsubps xmm9, xmm11, xmm13, xmmword ptr [r10]", "c4 43 a1 7c 0a d0")
	e = x64SrcHex(e, "vfnmsubps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 7c 0a f0")
	e = x64SrcHex(e, "vfnmsubps ymm10, ymm12, ymm14, ymmword ptr [r10]", "c4 43 9d 7c 12 e0")
	e = x64SrcHex(e, "vfnmsubps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 7c 12 80")
	e = x64SrcHex(e, "vfnmsubsd xmm9, xmm11, xmm13, qword ptr [r10]", "c4 43 a1 7f 0a d0")
	e = x64SrcHex(e, "vfnmsubsd xmm9, xmm11, qword ptr [r10], xmm15", "c4 43 21 7f 0a f0")
	e = x64SrcHex(e, "vfnmsubss xmm9, xmm11, xmm13, dword ptr [r10]", "c4 43 a1 7e 0a d0")
	e = x64SrcHex(e, "vfnmsubss xmm9, xmm11, dword ptr [r10], xmm15", "c4 43 21 7e 0a f0")
	e = x64SrcHex(e, "vfrczpd xmm9, xmmword ptr [r10]", "8f 49 78 81 0a")
	e = x64SrcHex(e, "vfrczpd ymm10, ymmword ptr [r10]", "8f 49 7c 81 12")
	e = x64SrcHex(e, "vfrczps xmm9, xmmword ptr [r10]", "8f 49 78 80 0a")
	e = x64SrcHex(e, "vfrczps ymm10, ymmword ptr [r10]", "8f 49 7c 80 12")
	e = x64SrcHex(e, "vfrczsd xmm9, qword ptr [r10]", "8f 49 78 83 0a")
	e = x64SrcHex(e, "vfrczss xmm9, dword ptr [r10]", "8f 49 78 82 0a")
	e = x64SrcHex(e, "vpcmov xmm9, xmm11, xmmword ptr [r10], xmm15", "8f 48 20 a2 0a f0")
	e = x64SrcHex(e, "vpcmov ymm10, ymm12, ymmword ptr [r10], ymm8", "8f 48 1c a2 12 80")
	e = x64SrcHex(e, "vpcomb xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 cc 0a 01")
	e = x64SrcHex(e, "vpcomd xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 ce 0a 01")
	e = x64SrcHex(e, "vpcomq xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 cf 0a 01")
	e = x64SrcHex(e, "vpcomub xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 ec 0a 01")
	e = x64SrcHex(e, "vpcomud xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 ee 0a 01")
	e = x64SrcHex(e, "vpcomuq xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 ef 0a 01")
	e = x64SrcHex(e, "vpcomuw xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 ed 0a 01")
	e = x64SrcHex(e, "vpcomw xmm9, xmm11, xmmword ptr [r10], 1", "8f 48 20 cd 0a 01")
	e = x64SrcHex(e, "vphaddbd xmm9, xmmword ptr [r10]", "8f 49 78 c2 0a")
	e = x64SrcHex(e, "vphaddbq xmm9, xmmword ptr [r10]", "8f 49 78 c3 0a")
	e = x64SrcHex(e, "vphaddbw xmm9, xmmword ptr [r10]", "8f 49 78 c1 0a")
	e = x64SrcHex(e, "vphadddq xmm9, xmmword ptr [r10]", "8f 49 78 cb 0a")
	e = x64SrcHex(e, "vphaddubd xmm9, xmmword ptr [r10]", "8f 49 78 d2 0a")
	e = x64SrcHex(e, "vphaddubq xmm9, xmmword ptr [r10]", "8f 49 78 d3 0a")
	e = x64SrcHex(e, "vphaddubw xmm9, xmmword ptr [r10]", "8f 49 78 d1 0a")
	e = x64SrcHex(e, "vphaddudq xmm9, xmmword ptr [r10]", "8f 49 78 db 0a")
	e = x64SrcHex(e, "vphadduwd xmm9, xmmword ptr [r10]", "8f 49 78 d6 0a")
	e = x64SrcHex(e, "vphadduwq xmm9, xmmword ptr [r10]", "8f 49 78 d7 0a")
	e = x64SrcHex(e, "vphaddwd xmm9, xmmword ptr [r10]", "8f 49 78 c6 0a")
	e = x64SrcHex(e, "vphaddwq xmm9, xmmword ptr [r10]", "8f 49 78 c7 0a")
	e = x64SrcHex(e, "vphsubbw xmm9, xmmword ptr [r10]", "8f 49 78 e1 0a")
	e = x64SrcHex(e, "vphsubdq xmm9, xmmword ptr [r10]", "8f 49 78 e3 0a")
	e = x64SrcHex(e, "vphsubwd xmm9, xmmword ptr [r10]", "8f 49 78 e2 0a")
	e = x64SrcHex(e, "vpmacsdd xmm9, xmm11, xmmword ptr [r10], xmm15", "8f 48 20 9e 0a f0")
	e = x64SrcHex(e, "vpmacsdqh xmm9, xmm11, xmmword ptr [r10], xmm15", "8f 48 20 9f 0a f0")
	e = x64SrcHex(e, "vpmacsdql xmm9, xmm11, xmmword ptr [r10], xmm15", "8f 48 20 97 0a f0")
	e = x64SrcHex(e, "vpmacssdd xmm9, xmm11, xmmword ptr [r10], xmm15", "8f 48 20 8e 0a f0")
