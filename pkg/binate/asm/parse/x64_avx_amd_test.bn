// XOP's compare names (vpcomltb .. vpcomtrueuq) in any case; vpermil2ps's imm4, 0..15 and a
// number; the W FMA4 and XOP choose between registers.
func TestX64AvxAmdNames() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vpcomltb xmm0, xmm1, xmm2", "8f e8 70 cc c2 00")
	e = x64SrcHex(e, "vpcomtrueuq xmm9, xmm10, xmm11", "8f 48 28 ef cb 07")
	e = x64SrcHex(e, "VPCOMNEQUW xmm0, xmm1, xmmword ptr [rax]", "8f e8 70 ed 00 05")
	e = x64SrcHex(e, "vpcomgeud xmm0, xmm1, xmm2", "8f e8 70 ee c2 03")
	e = x64SrcHex(e, "vpcomfalsed xmm0, xmm1, xmm2", "8f e8 70 ce c2 06")
	e = x64SrcHex(e, "vpcomeqq xmm0, xmm1, xmm2", "8f e8 70 cf c2 04")
	e = x64LineRejected(e, "vpcomneb xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "vpcomltb xmm0, xmm1, xmm2, 1")
	e = x64SrcHex(e, "vpermil2ps xmm1, xmm2, xmm3, xmm4, 0", "c4 e3 69 48 cb 40")
	e = x64SrcHex(e, "vpermil2ps xmm1, xmm2, xmm3, xmm4, 15", "c4 e3 69 48 cb 4f")
	e = x64LineErrorHas(e, "vpermil2ps xmm1, xmm2, xmm3, xmm4, 16", "takes an immediate of 0..15 last")
	e = x64LineErrorHas(e, "vpermil2ps xmm1, xmm2, xmm3, [rax], 16",
			"takes an immediate of 0..15 last")
	e = x64LineErrorHas(e, "{vex} vpcmov xmm0, xmm1, xmm2, xmm3",
			"stand before a VEX-encoded instruction")
	e = x64LineRejected(e, "{vex3} vpcomltb xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "{vex2} vfrczps xmm0, xmm1")
	e = x64LineRejected(e, "vpermil2ps xmm1, xmm2, xmm3, xmm4, -1")
	e = x64LineRejected(e, "vpermil2ps xmm1, xmm2, xmm3, xmm4, offset x")
	e = x64LineRejected(e, "vpermil2ps xmm1, xmm2, xmm3, xmm4")
	e = x64SrcHex(e, "vfmaddps xmm1, xmm2, xmm3, xmm4", "c4 e3 e9 68 cc 30")
	e = x64SrcHex(e, "vpcmov xmm1, xmm2, xmm3, xmm4", "8f e8 68 a2 cb 40")
	return e
}
