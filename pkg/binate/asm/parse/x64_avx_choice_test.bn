}

// A general register of each width (r12, r12d, r12w, r12b) where a form takes one: clang's W bit
// and its rejections.
func TestX64AvxGpWidths() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vpinsrb xmm1, xmm2, r12, 1", "c4 c3 69 20 cc 01")
	e = x64SrcHex(e, "vpinsrb xmm1, xmm2, r12d, 1", "c4 c3 69 20 cc 01")
	e = x64LineRejected(e, "vpinsrb xmm1, xmm2, r12w, 1")
	e = x64LineRejected(e, "vpinsrb xmm1, xmm2, r12b, 1")
	e = x64SrcHex(e, "vpinsrw xmm1, xmm2, r12, 1", "c4 c1 69 c4 cc 01")
	e = x64SrcHex(e, "vpinsrw xmm1, xmm2, r12d, 1", "c4 c1 69 c4 cc 01")
	e = x64LineRejected(e, "vpinsrw xmm1, xmm2, r12w, 1")
	e = x64LineRejected(e, "vpinsrw xmm1, xmm2, r12b, 1")
	e = x64LineRejected(e, "vpinsrd xmm1, xmm2, r12, 1")
	e = x64SrcHex(e, "vpinsrd xmm1, xmm2, r12d, 1", "c4 c3 69 22 cc 01")
	e = x64LineRejected(e, "vpinsrd xmm1, xmm2, r12w, 1")
	e = x64LineRejected(e, "vpinsrd xmm1, xmm2, r12b, 1")
	e = x64SrcHex(e, "vpinsrq xmm1, xmm2, r12, 1", "c4 c3 e9 22 cc 01")
	e = x64LineRejected(e, "vpinsrq xmm1, xmm2, r12d, 1")
	e = x64LineRejected(e, "vpinsrq xmm1, xmm2, r12w, 1")
	e = x64LineRejected(e, "vpinsrq xmm1, xmm2, r12b, 1")
	e = x64SrcHex(e, "vpextrb r12, xmm1, 1", "c4 c3 79 14 cc 01")
	e = x64SrcHex(e, "vpextrb r12d, xmm1, 1", "c4 c3 79 14 cc 01")
	e = x64LineRejected(e, "vpextrb r12w, xmm1, 1")
	e = x64LineRejected(e, "vpextrb r12b, xmm1, 1")
	e = x64SrcHex(e, "vpextrw r12, xmm1, 1", "c5 79 c5 e1 01")
	e = x64SrcHex(e, "vpextrw r12d, xmm1, 1", "c5 79 c5 e1 01")
	e = x64LineRejected(e, "vpextrw r12w, xmm1, 1")
	e = x64LineRejected(e, "vpextrw r12b, xmm1, 1")
	e = x64LineRejected(e, "vpextrd r12, xmm1, 1")
	e = x64SrcHex(e, "vpextrd r12d, xmm1, 1", "c4 c3 79 16 cc 01")
	e = x64LineRejected(e, "vpextrd r12w, xmm1, 1")
	e = x64LineRejected(e, "vpextrd r12b, xmm1, 1")
	e = x64SrcHex(e, "vpextrq r12, xmm1, 1", "c4 c3 f9 16 cc 01")
	e = x64LineRejected(e, "vpextrq r12d, xmm1, 1")
	e = x64LineRejected(e, "vpextrq r12w, xmm1, 1")
	e = x64LineRejected(e, "vpextrq r12b, xmm1, 1")
	e = x64SrcHex(e, "vpmovmskb r12, ymm1", "c5 7d d7 e1")
	e = x64SrcHex(e, "vpmovmskb r12d, ymm1", "c5 7d d7 e1")
	e = x64LineRejected(e, "vpmovmskb r12w, ymm1")
	e = x64LineRejected(e, "vpmovmskb r12b, ymm1")
	e = x64SrcHex(e, "vmovd xmm1, r12", "c4 c1 f9 6e cc")
	e = x64SrcHex(e, "vmovd xmm1, r12d", "c4 c1 79 6e cc")
	e = x64LineRejected(e, "vmovd xmm1, r12w")
	e = x64LineRejected(e, "vmovd xmm1, r12b")
	e = x64SrcHex(e, "vmovd r12, xmm1", "c4 c1 f9 7e cc")
	e = x64SrcHex(e, "vmovd r12d, xmm1", "c4 c1 79 7e cc")
	e = x64LineRejected(e, "vmovd r12w, xmm1")
	e = x64LineRejected(e, "vmovd r12b, xmm1")
	e = x64SrcHex(e, "vmovq xmm1, r12", "c4 c1 f9 6e cc")
	e = x64LineRejected(e, "vmovq xmm1, r12d")
	e = x64LineRejected(e, "vmovq xmm1, r12w")
	e = x64LineRejected(e, "vmovq xmm1, r12b")
	e = x64SrcHex(e, "vmovq r12, xmm1", "c4 c1 f9 7e cc")
	e = x64LineRejected(e, "vmovq r12d, xmm1")
	e = x64LineRejected(e, "vmovq r12w, xmm1")
	e = x64LineRejected(e, "vmovq r12b, xmm1")
	e = x64SrcHex(e, "vextractps r12, xmm1, 1", "c4 c3 79 17 cc 01")
	e = x64SrcHex(e, "vextractps r12d, xmm1, 1", "c4 c3 79 17 cc 01")
	e = x64LineRejected(e, "vextractps r12w, xmm1, 1")
	e = x64LineRejected(e, "vextractps r12b, xmm1, 1")
	e = x64SrcHex(e, "vmovmskps r12, xmm1", "c5 78 50 e1")
	e = x64SrcHex(e, "vmovmskps r12d, xmm1", "c5 78 50 e1")
	e = x64LineRejected(e, "vmovmskps r12w, xmm1")
	e = x64LineRejected(e, "vmovmskps r12b, xmm1")
	e = x64SrcHex(e, "vcvtsi2ss xmm1, xmm2, r12", "c4 c1 ea 2a cc")
	e = x64SrcHex(e, "vcvtsi2ss xmm1, xmm2, r12d", "c4 c1 6a 2a cc")
	e = x64LineRejected(e, "vcvtsi2ss xmm1, xmm2, r12w")
	e = x64LineRejected(e, "vcvtsi2ss xmm1, xmm2, r12b")
	e = x64SrcHex(e, "vcvtss2si r12, xmm1", "c4 61 fa 2d e1")
	e = x64SrcHex(e, "vcvtss2si r12d, xmm1", "c5 7a 2d e1")
	e = x64LineRejected(e, "vcvtss2si r12w, xmm1")
	e = x64LineRejected(e, "vcvtss2si r12b, xmm1")
	return e
}
