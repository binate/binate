package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The VEX table's choice among the forms that fit (x64_avx.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): each register form of map 0F with its
// last register in 8..15, where clang swaps a commutative instruction's sources, or moves between
// registers in a store form, to reach the two-byte prefix C5 (and where it does not); and the
// general registers each form takes, of each width.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn.)

// The floating-point forms.
func TestX64AvxChoiceFp() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps xmm0, xmm1, xmm8", "c5 b8 58 c1")
	e = x64SrcHex(e, "vaddps ymm0, ymm1, ymm8", "c5 bc 58 c1")
	e = x64SrcHex(e, "vaddpd xmm0, xmm1, xmm8", "c5 b9 58 c1")
	e = x64SrcHex(e, "vaddpd ymm0, ymm1, ymm8", "c5 bd 58 c1")
	e = x64SrcHex(e, "vaddss xmm0, xmm1, xmm8", "c4 c1 72 58 c0")
	e = x64SrcHex(e, "vaddsd xmm0, xmm1, xmm8", "c4 c1 73 58 c0")
	e = x64SrcHex(e, "vmulps xmm0, xmm1, xmm8", "c5 b8 59 c1")
	e = x64SrcHex(e, "vmulps ymm0, ymm1, ymm8", "c5 bc 59 c1")
	e = x64SrcHex(e, "vmulpd xmm0, xmm1, xmm8", "c5 b9 59 c1")
	e = x64SrcHex(e, "vmulpd ymm0, ymm1, ymm8", "c5 bd 59 c1")
	e = x64SrcHex(e, "vmulss xmm0, xmm1, xmm8", "c4 c1 72 59 c0")
	e = x64SrcHex(e, "vmulsd xmm0, xmm1, xmm8", "c4 c1 73 59 c0")
	e = x64SrcHex(e, "vsubps xmm0, xmm1, xmm8", "c4 c1 70 5c c0")
	e = x64SrcHex(e, "vsubps ymm0, ymm1, ymm8", "c4 c1 74 5c c0")
	e = x64SrcHex(e, "vsubpd xmm0, xmm1, xmm8", "c4 c1 71 5c c0")
	e = x64SrcHex(e, "vsubpd ymm0, ymm1, ymm8", "c4 c1 75 5c c0")
	e = x64SrcHex(e, "vsubss xmm0, xmm1, xmm8", "c4 c1 72 5c c0")
	e = x64SrcHex(e, "vsubsd xmm0, xmm1, xmm8", "c4 c1 73 5c c0")
	e = x64SrcHex(e, "vminps xmm0, xmm1, xmm8", "c4 c1 70 5d c0")
	e = x64SrcHex(e, "vminps ymm0, ymm1, ymm8", "c4 c1 74 5d c0")
	e = x64SrcHex(e, "vminpd xmm0, xmm1, xmm8", "c4 c1 71 5d c0")
