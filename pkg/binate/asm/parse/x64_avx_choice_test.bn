	e = x64SrcHex(e, "vcvtss2sd xmm0, xmm1, xmm8", "c4 c1 72 5a c0")
	e = x64SrcHex(e, "vcvtsd2ss xmm0, xmm1, xmm8", "c4 c1 73 5a c0")
	e = x64SrcHex(e, "vcvtps2pd xmm0, xmm8", "c4 c1 78 5a c0")
	e = x64SrcHex(e, "vcvtpd2ps xmm0, xmm8", "c4 c1 79 5a c0")
	e = x64SrcHex(e, "vcvtdq2ps xmm0, xmm8", "c4 c1 78 5b c0")
