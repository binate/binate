package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX forms of VAES, VPCLMULQDQ, GFNI, SM4, AVX512-IFMA and AVX512-VNNI (avx_table_ext.bn's)
// (x64_avx.bn, x64_evex.bn, x64_mem.bn) against clang's bytes (`clang --target=x86_64-linux-gnu
// -c`, `.intel_syntax noprefix`): a line for each form with registers 16..31 and its decorations,
// and with memory and a compressed displacement where it takes them.  The encodings in full are
// package avx's tests.
func TestX64AvxEvexExt() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaesdec xmm17, xmm18, [rax + 64]", "62 e2 6d 00 de 48 04")
	e = x64SrcHex(e, "vaesdec ymm17, ymm18, [rax + 64]", "62 e2 6d 20 de 48 02")
	e = x64SrcHex(e, "vaesdec zmm17, zmm18, [rax + 64]", "62 e2 6d 40 de 48 01")
	e = x64SrcHex(e, "vaesdeclast xmm17, xmm18, [rax + 64]", "62 e2 6d 00 df 48 04")
	e = x64SrcHex(e, "vaesdeclast ymm17, ymm18, [rax + 64]", "62 e2 6d 20 df 48 02")
	e = x64SrcHex(e, "vaesdeclast zmm17, zmm18, [rax + 64]", "62 e2 6d 40 df 48 01")
	e = x64SrcHex(e, "vaesenc xmm17, xmm18, [rax + 64]", "62 e2 6d 00 dc 48 04")
	e = x64SrcHex(e, "vaesenc ymm17, ymm18, [rax + 64]", "62 e2 6d 20 dc 48 02")
	e = x64SrcHex(e, "vaesenc zmm17, zmm18, [rax + 64]", "62 e2 6d 40 dc 48 01")
	e = x64SrcHex(e, "vaesenclast xmm17, xmm18, [rax + 64]", "62 e2 6d 00 dd 48 04")
	e = x64SrcHex(e, "vaesenclast ymm17, ymm18, [rax + 64]", "62 e2 6d 20 dd 48 02")
	e = x64SrcHex(e, "vaesenclast zmm17, zmm18, [rax + 64]", "62 e2 6d 40 dd 48 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb xmm17, xmm18, qword ptr [rax]{1to2}, 1",
			"62 e3 ed 10 cf 08 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb xmm17, xmm18, [rax + 64], 1", "62 e3 ed 00 cf 48 04 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb ymm17, ymm18, qword ptr [rax]{1to4}, 1",
			"62 e3 ed 30 cf 08 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb ymm17, ymm18, [rax + 64], 1", "62 e3 ed 20 cf 48 02 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb zmm17, zmm18, qword ptr [rax]{1to8}, 1",
			"62 e3 ed 50 cf 08 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb zmm17, zmm18, [rax + 64], 1", "62 e3 ed 40 cf 48 01 01")
	e = x64SrcHex(e, "vgf2p8affineqb xmm17, xmm18, qword ptr [rax]{1to2}, 1", "62 e3 ed 10 ce 08 01")
	e = x64SrcHex(e, "vgf2p8affineqb xmm17, xmm18, [rax + 64], 1", "62 e3 ed 00 ce 48 04 01")
	e = x64SrcHex(e, "vgf2p8affineqb ymm17, ymm18, qword ptr [rax]{1to4}, 1", "62 e3 ed 30 ce 08 01")
	e = x64SrcHex(e, "vgf2p8affineqb ymm17, ymm18, [rax + 64], 1", "62 e3 ed 20 ce 48 02 01")
	e = x64SrcHex(e, "vgf2p8affineqb zmm17, zmm18, qword ptr [rax]{1to8}, 1", "62 e3 ed 50 ce 08 01")
	e = x64SrcHex(e, "vgf2p8affineqb zmm17, zmm18, [rax + 64], 1", "62 e3 ed 40 ce 48 01 01")
	e = x64SrcHex(e, "vgf2p8mulb xmm17 {k5} {z}, xmm18, [rax]", "62 e2 6d 85 cf 08")
	e = x64SrcHex(e, "vgf2p8mulb xmm17, xmm18, [rax + 64]", "62 e2 6d 00 cf 48 04")
	e = x64SrcHex(e, "vgf2p8mulb ymm17 {k5} {z}, ymm18, [rax]", "62 e2 6d a5 cf 08")
	e = x64SrcHex(e, "vgf2p8mulb ymm17, ymm18, [rax + 64]", "62 e2 6d 20 cf 48 02")
	e = x64SrcHex(e, "vgf2p8mulb zmm17 {k5} {z}, zmm18, [rax]", "62 e2 6d c5 cf 08")
	e = x64SrcHex(e, "vgf2p8mulb zmm17, zmm18, [rax + 64]", "62 e2 6d 40 cf 48 01")
	e = x64SrcHex(e, "vpclmulqdq xmm17, xmm18, [rax + 64], 1", "62 e3 6d 00 44 48 04 01")
	e = x64SrcHex(e, "vpclmulqdq ymm17, ymm18, [rax + 64], 1", "62 e3 6d 20 44 48 02 01")
	e = x64SrcHex(e, "vpclmulqdq zmm17, zmm18, [rax + 64], 1", "62 e3 6d 40 44 48 01 01")
	e = x64SrcHex(e, "vsm4key4 xmm17, xmm18, [rax + 64]", "62 e2 6e 00 da 48 04")
	e = x64SrcHex(e, "vsm4key4 ymm17, ymm18, [rax + 64]", "62 e2 6e 20 da 48 02")
	e = x64SrcHex(e, "vsm4key4 zmm17, zmm18, [rax + 64]", "62 e2 6e 40 da 48 01")
	e = x64SrcHex(e, "vsm4rnds4 xmm17, xmm18, [rax + 64]", "62 e2 6f 00 da 48 04")
	e = x64SrcHex(e, "vsm4rnds4 ymm17, ymm18, [rax + 64]", "62 e2 6f 20 da 48 02")
	e = x64SrcHex(e, "vsm4rnds4 zmm17, zmm18, [rax + 64]", "62 e2 6f 40 da 48 01")
	e = x64SrcHex(e, "vpmadd52luq xmm17, xmm18, qword ptr [rax]{1to2}", "62 e2 ed 10 b4 08")
	e = x64SrcHex(e, "vpmadd52luq xmm17, xmm18, [rax + 64]", "62 e2 ed 00 b4 48 04")
	e = x64SrcHex(e, "vpmadd52luq ymm17, ymm18, qword ptr [rax]{1to4}", "62 e2 ed 30 b4 08")
	e = x64SrcHex(e, "vpmadd52luq ymm17, ymm18, [rax + 64]", "62 e2 ed 20 b4 48 02")
	e = x64SrcHex(e, "vpmadd52luq zmm17, zmm18, qword ptr [rax]{1to8}", "62 e2 ed 50 b4 08")
	e = x64SrcHex(e, "vpmadd52luq zmm17, zmm18, [rax + 64]", "62 e2 ed 40 b4 48 01")
	e = x64SrcHex(e, "vpmadd52huq xmm17, xmm18, qword ptr [rax]{1to2}", "62 e2 ed 10 b5 08")
	e = x64SrcHex(e, "vpmadd52huq xmm17, xmm18, [rax + 64]", "62 e2 ed 00 b5 48 04")
	e = x64SrcHex(e, "vpmadd52huq ymm17, ymm18, qword ptr [rax]{1to4}", "62 e2 ed 30 b5 08")
	e = x64SrcHex(e, "vpmadd52huq ymm17, ymm18, [rax + 64]", "62 e2 ed 20 b5 48 02")
	e = x64SrcHex(e, "vpmadd52huq zmm17, zmm18, qword ptr [rax]{1to8}", "62 e2 ed 50 b5 08")
	e = x64SrcHex(e, "vpmadd52huq zmm17, zmm18, [rax + 64]", "62 e2 ed 40 b5 48 01")
	e = x64SrcHex(e, "vpdpbusd xmm17, xmm18, dword ptr [rax]{1to4}", "62 e2 6d 10 50 08")
	e = x64SrcHex(e, "vpdpbusd xmm17, xmm18, [rax + 64]", "62 e2 6d 00 50 48 04")
	e = x64SrcHex(e, "vpdpbusd ymm17, ymm18, dword ptr [rax]{1to8}", "62 e2 6d 30 50 08")
	e = x64SrcHex(e, "vpdpbusd ymm17, ymm18, [rax + 64]", "62 e2 6d 20 50 48 02")
	e = x64SrcHex(e, "vpdpbusd zmm17, zmm18, dword ptr [rax]{1to16}", "62 e2 6d 50 50 08")
	e = x64SrcHex(e, "vpdpbusd zmm17, zmm18, [rax + 64]", "62 e2 6d 40 50 48 01")
	e = x64SrcHex(e, "vpdpbusds xmm17, xmm18, dword ptr [rax]{1to4}", "62 e2 6d 10 51 08")
	e = x64SrcHex(e, "vpdpbusds xmm17, xmm18, [rax + 64]", "62 e2 6d 00 51 48 04")
	e = x64SrcHex(e, "vpdpbusds ymm17, ymm18, dword ptr [rax]{1to8}", "62 e2 6d 30 51 08")
	e = x64SrcHex(e, "vpdpbusds ymm17, ymm18, [rax + 64]", "62 e2 6d 20 51 48 02")
	e = x64SrcHex(e, "vpdpbusds zmm17, zmm18, dword ptr [rax]{1to16}", "62 e2 6d 50 51 08")
	e = x64SrcHex(e, "vpdpbusds zmm17, zmm18, [rax + 64]", "62 e2 6d 40 51 48 01")
	e = x64SrcHex(e, "vpdpwssd xmm17, xmm18, dword ptr [rax]{1to4}", "62 e2 6d 10 52 08")
	e = x64SrcHex(e, "vpdpwssd xmm17, xmm18, [rax + 64]", "62 e2 6d 00 52 48 04")
	e = x64SrcHex(e, "vpdpwssd ymm17, ymm18, dword ptr [rax]{1to8}", "62 e2 6d 30 52 08")
	e = x64SrcHex(e, "vpdpwssd ymm17, ymm18, [rax + 64]", "62 e2 6d 20 52 48 02")
	e = x64SrcHex(e, "vpdpwssd zmm17, zmm18, dword ptr [rax]{1to16}", "62 e2 6d 50 52 08")
	e = x64SrcHex(e, "vpdpwssd zmm17, zmm18, [rax + 64]", "62 e2 6d 40 52 48 01")
	e = x64SrcHex(e, "vpdpwssds xmm17, xmm18, dword ptr [rax]{1to4}", "62 e2 6d 10 53 08")
	e = x64SrcHex(e, "vpdpwssds xmm17, xmm18, [rax + 64]", "62 e2 6d 00 53 48 04")
	e = x64SrcHex(e, "vpdpwssds ymm17, ymm18, dword ptr [rax]{1to8}", "62 e2 6d 30 53 08")
	e = x64SrcHex(e, "vpdpwssds ymm17, ymm18, [rax + 64]", "62 e2 6d 20 53 48 02")
	e = x64SrcHex(e, "vpdpwssds zmm17, zmm18, dword ptr [rax]{1to16}", "62 e2 6d 50 53 08")
	e = x64SrcHex(e, "vpdpwssds zmm17, zmm18, [rax + 64]", "62 e2 6d 40 53 48 01")
	return e
}
