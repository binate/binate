package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX forms of FMA, F16C and vpermps / vpermpd (x64_avx.bn, x64_evex.bn) against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form, with
// registers 16..31 in each field and a broadcast, else a write mask (and zeroing), where it takes
// one; a line with [rax + 64] for each with memory (the displacement compressed); and a line with
// its rounding or SAE operand for each that takes one.  The encodings in full are package avx's
// tests.
func TestX64AvxEvexFma() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vfmadd132pd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e2 ed 10 98 08")
	e = x64SrcHex(e, "vfmadd132pd xmm17, xmm18, [rax + 64]", "62 e2 ed 00 98 48 04")
	e = x64SrcHex(e, "vfmadd132pd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e2 ed 30 98 08")
	e = x64SrcHex(e, "vfmadd132pd ymm17, ymm18, [rax + 64]", "62 e2 ed 20 98 48 02")
	e = x64SrcHex(e, "vfmadd132pd zmm17, zmm18, qword ptr [rax]{1to8}", "62 e2 ed 50 98 08")
	e = x64SrcHex(e, "vfmadd132pd zmm17, zmm18, [rax + 64]", "62 e2 ed 40 98 48 01")
	e = x64SrcHex(e, "vfmadd132pd zmm17, zmm18, zmm20, {rn-sae}", "62 a2 ed 10 98 cc")
	e = x64SrcHex(e, "vfmadd132ps xmm17, xmm18, dword ptr [rax]{1to4}", "62 e2 6d 10 98 08")
	e = x64SrcHex(e, "vfmadd132ps xmm17, xmm18, [rax + 64]", "62 e2 6d 00 98 48 04")
	e = x64SrcHex(e, "vfmadd132ps ymm17, ymm18, dword ptr [rax]{1to8}", "62 e2 6d 30 98 08")
	e = x64SrcHex(e, "vfmadd132ps ymm17, ymm18, [rax + 64]", "62 e2 6d 20 98 48 02")
	e = x64SrcHex(e, "vfmadd132ps zmm17, zmm18, dword ptr [rax]{1to16}", "62 e2 6d 50 98 08")
	e = x64SrcHex(e, "vfmadd132ps zmm17, zmm18, [rax + 64]", "62 e2 6d 40 98 48 01")
	e = x64SrcHex(e, "vfmadd132ps zmm17, zmm18, zmm20, {rn-sae}", "62 a2 6d 10 98 cc")
	e = x64SrcHex(e, "vfmadd132sd xmm17 {k5} {z}, xmm18, [rax]", "62 e2 ed 85 99 08")
	e = x64SrcHex(e, "vfmadd132sd xmm17, xmm18, [rax + 64]", "62 e2 ed 00 99 48 08")
	e = x64SrcHex(e, "vfmadd132sd xmm17, xmm18, xmm20, {rn-sae}", "62 a2 ed 10 99 cc")
