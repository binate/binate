// What GNU as rejects and clang warns of: a complex multiply whose destination is one of its
// sources (the CPU faults).
func TestX64AvxEvexFp16Rejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "vfmulcph xmm1, xmm1, xmm2", "differs from its sources")
	e = x64LineRejected(e, "vfmulcph xmm1, xmm2, xmm1")
	e = x64LineRejected(e, "vfcmaddcsh xmm20, xmm20, dword ptr [rax]")
	e = x64LineRejected(e, "vfmaddcph zmm1 {k1}, zmm2, zmm1, {rn-sae}")
	e = x64SrcHex(e, "vfmulcph xmm1, xmm2, [rax]", "62 f6 6e 08 d6 08")
	e = x64SrcHex(e, "vfcmaddcsh xmm20, xmm21, dword ptr [rax]", "62 e6 57 00 57 20")
	return e
}
