package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX512-FP16's arithmetic (avx_table_evex_fp16.bn's) (x64_avx.bn, x64_evex.bn) against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form,
// with registers 16..31 in each field and a broadcast, else a write mask (and zeroing), where it
// takes one; a line with [rax + 64] for each with memory (the displacement compressed); and a line
// with its rounding or SAE operand for each that takes one.  The encodings in full are package
// avx's tests.
func TestX64AvxEvexFp16() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddph xmm17, xmm18, word ptr [rax]{1to8}", "62 e5 6c 10 58 08")
	e = x64SrcHex(e, "vaddph xmm17, xmm18, [rax + 64]", "62 e5 6c 00 58 48 04")
	e = x64SrcHex(e, "vaddph ymm17, ymm18, word ptr [rax]{1to16}", "62 e5 6c 30 58 08")
	e = x64SrcHex(e, "vaddph ymm17, ymm18, [rax + 64]", "62 e5 6c 20 58 48 02")
	e = x64SrcHex(e, "vaddph zmm17, zmm18, word ptr [rax]{1to32}", "62 e5 6c 50 58 08")
	e = x64SrcHex(e, "vaddph zmm17, zmm18, [rax + 64]", "62 e5 6c 40 58 48 01")
	e = x64SrcHex(e, "vaddph zmm17, zmm18, zmm20, {rn-sae}", "62 a5 6c 10 58 cc")
	e = x64SrcHex(e, "vaddsh xmm17 {k5} {z}, xmm18, [rax]", "62 e5 6e 85 58 08")
	e = x64SrcHex(e, "vaddsh xmm17, xmm18, [rax + 64]", "62 e5 6e 00 58 48 20")
	e = x64SrcHex(e, "vaddsh xmm17, xmm18, xmm20, {rn-sae}", "62 a5 6e 10 58 cc")
	e = x64SrcHex(e, "vcmpph k1, xmm18, word ptr [rax]{1to8}, 1", "62 f3 6c 10 c2 08 01")
	e = x64SrcHex(e, "vcmpph k1, xmm18, [rax + 64], 1", "62 f3 6c 00 c2 48 04 01")
	e = x64SrcHex(e, "vcmpph k1, ymm18, word ptr [rax]{1to16}, 1", "62 f3 6c 30 c2 08 01")
	e = x64SrcHex(e, "vcmpph k1, ymm18, [rax + 64], 1", "62 f3 6c 20 c2 48 02 01")
	e = x64SrcHex(e, "vcmpph k1, zmm18, word ptr [rax]{1to32}, 1", "62 f3 6c 50 c2 08 01")
	e = x64SrcHex(e, "vcmpph k1, zmm18, [rax + 64], 1", "62 f3 6c 40 c2 48 01 01")
	e = x64SrcHex(e, "vcmpph k1, zmm18, zmm20, {sae}, 1", "62 b3 6c 10 c2 cc 01")
	e = x64SrcHex(e, "vcomish xmm17, [rax + 64]", "62 e5 7c 08 2f 48 20")
	e = x64SrcHex(e, "vcomish xmm17, xmm18, {sae}", "62 a5 7c 18 2f ca")
	e = x64SrcHex(e, "vdivph xmm17, xmm18, word ptr [rax]{1to8}", "62 e5 6c 10 5e 08")
	e = x64SrcHex(e, "vdivph xmm17, xmm18, [rax + 64]", "62 e5 6c 00 5e 48 04")
	e = x64SrcHex(e, "vdivph ymm17, ymm18, word ptr [rax]{1to16}", "62 e5 6c 30 5e 08")
