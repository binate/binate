package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX512-FP16's conversions and moves (avx_table_evex_fp16cvt.bn's) (x64_avx.bn, x64_evex.bn)
// against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line
// for each form, with registers 16..31 in each field and a broadcast, else a write mask (and
// zeroing), where it takes one; a line with [rax + 64] for each with memory (the displacement
// compressed); and a line with its rounding or SAE operand for each that takes one.  The encodings
// in full are package avx's tests.
func TestX64AvxEvexFp16Cvt() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vcvtdq2ph xmm17, dword ptr [rax]{1to4}", "62 e5 7c 18 5b 08")
