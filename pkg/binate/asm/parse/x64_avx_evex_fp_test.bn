package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX-512's floating-point instructions with no VEX form (x64_avx.bn, x64_evex.bn) against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form,
// with registers 16..31 in each field and a broadcast, else a write mask (and zeroing), where it
// takes one; a line with [rax + 64] for each with memory (the displacement compressed); and a line
// with its rounding or SAE operand for each that takes one.  The encodings in full are package
// avx's tests.
func TestX64AvxEvexFp() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vblendmpd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e2 ed 10 65 08")
	e = x64SrcHex(e, "vblendmpd xmm17, xmm18, [rax + 64]", "62 e2 ed 00 65 48 04")
	e = x64SrcHex(e, "vblendmpd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e2 ed 30 65 08")
	e = x64SrcHex(e, "vblendmpd ymm17, ymm18, [rax + 64]", "62 e2 ed 20 65 48 02")
	e = x64SrcHex(e, "vblendmpd zmm17, zmm18, qword ptr [rax]{1to8}", "62 e2 ed 50 65 08")
	e = x64SrcHex(e, "vblendmpd zmm17, zmm18, [rax + 64]", "62 e2 ed 40 65 48 01")
	e = x64SrcHex(e, "vblendmps xmm17, xmm18, dword ptr [rax]{1to4}", "62 e2 6d 10 65 08")
	e = x64SrcHex(e, "vblendmps xmm17, xmm18, [rax + 64]", "62 e2 6d 00 65 48 04")
	e = x64SrcHex(e, "vblendmps ymm17, ymm18, dword ptr [rax]{1to8}", "62 e2 6d 30 65 08")
	e = x64SrcHex(e, "vblendmps ymm17, ymm18, [rax + 64]", "62 e2 6d 20 65 48 02")
	e = x64SrcHex(e, "vblendmps zmm17, zmm18, dword ptr [rax]{1to16}", "62 e2 6d 50 65 08")
	e = x64SrcHex(e, "vblendmps zmm17, zmm18, [rax + 64]", "62 e2 6d 40 65 48 01")
	e = x64SrcHex(e, "vbroadcastf32x2 ymm17 {k5} {z}, [rax]", "62 e2 7d ad 19 08")
	e = x64SrcHex(e, "vbroadcastf32x2 ymm17, [rax + 64]", "62 e2 7d 28 19 48 08")
	e = x64SrcHex(e, "vbroadcastf32x2 zmm17 {k5} {z}, [rax]", "62 e2 7d cd 19 08")
	e = x64SrcHex(e, "vbroadcastf32x2 zmm17, [rax + 64]", "62 e2 7d 48 19 48 08")
	e = x64SrcHex(e, "vbroadcastf32x4 ymm17 {k5} {z}, [rax]", "62 e2 7d ad 1a 08")
	e = x64SrcHex(e, "vbroadcastf32x4 ymm17, [rax + 64]", "62 e2 7d 28 1a 48 04")
	e = x64SrcHex(e, "vbroadcastf32x4 zmm17 {k5} {z}, [rax]", "62 e2 7d cd 1a 08")
	e = x64SrcHex(e, "vbroadcastf32x4 zmm17, [rax + 64]", "62 e2 7d 48 1a 48 04")
	e = x64SrcHex(e, "vbroadcastf32x8 zmm17 {k5} {z}, [rax]", "62 e2 7d cd 1b 08")
	e = x64SrcHex(e, "vbroadcastf32x8 zmm17, [rax + 64]", "62 e2 7d 48 1b 48 02")
