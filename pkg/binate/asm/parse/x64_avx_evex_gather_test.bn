// What clang or GNU as rejects: a gather without its write mask, with zeroing or k0; an index of
// another width, or 16..31 in a VEX gather; a prefetch's memory of another size or index; a vector
// index outside a gather, scatter or prefetch; and what clang takes but the CPU faults on (GNU as
// and clang warn): a gather whose destination is its index.
func TestX64AvxEvexGatherRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "vgatherdps xmm1 {k1}, [rax + xmm1*4]",
			"a destination and an index register that differ")
	e = x64LineErrorHas(e, "vgatherdps ymm1 {k1}, [rax + ymm1*4]",
			"a destination and an index register that differ")
	e = x64LineErrorHas(e, "vgatherdps zmm1 {k1}, [rax + zmm1*4]",
			"a destination and an index register that differ")
	e = x64LineErrorHas(e, "vgatherdpd xmm1 {k1}, [rax + xmm1*4]",
			"a destination and an index register that differ")
	e = x64LineErrorHas(e, "vgatherdpd ymm1 {k1}, [rax + xmm1*4]",
			"a destination and an index register that differ")
	e = x64LineErrorHas(e, "vgatherdpd zmm1 {k1}, [rax + ymm1*4]",
			"a destination and an index register that differ")
	e = x64LineRejected(e, "vgatherdps zmm1 {k1} {z}, [rax + zmm2*4]")
	e = x64LineRejected(e, "vgatherdps zmm1 {k0}, [rax + zmm2*4]")
	e = x64LineRejected(e, "vgatherdps xmm1, [rax + xmm17*4], xmm3")
	e = x64LineRejected(e, "vgatherdps ymm1, [rax + zmm2*4], ymm3")
	e = x64LineRejected(e, "vgatherpf0dps qword ptr [rax + zmm2*4] {k1}")
	e = x64LineRejected(e, "vgatherpf0dps [rax + ymm2*4] {k1}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, [rax + zmm2*4]")
	e = x64LineRejected(e, "mov rax, [rbx + zmm2*4]")
	e = x64LineRejected(e, "vscatterdps [rax + zmm2*4], zmm1")
	e = x64LineErrorHas(e, "vgatherdps zmm1, [rax + zmm2*4]", "takes a write mask")
	e = x64LineErrorHas(e, "vgatherpf0dps [rax + zmm2*4]", "takes a write mask")
	e = x64LineErrorHas(e, "vgatherdps ymm1, [rax + xmm2*4], ymm3", "takes other operands")
	e = x64LineErrorHas(e, "vgatherdps xmm17, [rax + xmm2*4], xmm3", "takes other operands")
	e = x64LineErrorHas(e, "{vex} vscatterdps [rax + xmm2*4] {k1}, xmm3", "takes other operands")
	return e
}
