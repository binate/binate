package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX gathers (avx_table_gather.bn's), with XMM, YMM and ZMM indexes 0..31 (x64_avx.bn,
// x64_evex.bn, x64_mem.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): a line for each form with registers 16..31 and its decorations, and
// with memory and a compressed displacement where it takes them.  The encodings in full are package
// avx's tests.
func TestX64AvxEvexGather() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [rax + xmm2*4]", "62 f2 7d 09 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, dword ptr [rax + xmm2*4]", "62 f2 7d 09 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm17 {k1}, [rax + xmm18*4]", "62 e2 7d 01 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm31 {k1}, [rax + xmm30*4]", "62 22 7d 01 92 3c b0")
	e = x64SrcHex(e, "vgatherdps xmm2 {k1}, [rax + xmm1*4]", "62 f2 7d 09 92 14 88")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [r9 + xmm2*8 + 64]", "62 d2 7d 09 92 4c d1 10")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [rax + xmm2*1 + 4]", "62 f2 7d 09 92 4c 10 01")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [rax + xmm2*2 - 128]", "62 f2 7d 09 92 4c 50 e0")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [xmm2*4]", "62 f2 7d 09 92 0c 95 00 00 00 00")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [rsp + xmm2*4 + 512]", "62 f2 7d 09 92 8c 94 00 02 00 00")
	e = x64SrcHex(e, "vgatherdps xmm1 {k1}, [rbp + xmm2*8]", "62 f2 7d 09 92 4c d5 00")
	e = x64SrcHex(e, "vgatherdps ymm1 {k1}, [rax + ymm2*4]", "62 f2 7d 29 92 0c 90")
	e = x64SrcHex(e, "vgatherdps ymm1 {k1}, dword ptr [rax + ymm2*4]", "62 f2 7d 29 92 0c 90")
	e = x64SrcHex(e, "vgatherdps ymm17 {k1}, [rax + ymm18*4]", "62 e2 7d 21 92 0c 90")
	e = x64SrcHex(e, "vgatherdps ymm31 {k1}, [rax + ymm30*4]", "62 22 7d 21 92 3c b0")
	e = x64SrcHex(e, "vgatherdps ymm2 {k1}, [rax + ymm1*4]", "62 f2 7d 29 92 14 88")
