	e = x64SrcHex(e, "vpabsq zmm17, [rax + 64]", "62 e2 fd 48 1f 48 01")
	e = x64SrcHex(e, "vpandd xmm17, xmm18, dword ptr [rax]{1to4}", "62 e1 6d 10 db 08")
