package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX-512's integer instructions with no VEX form but moves (avx_table_evex_int.bn's), with the
// compare predicates' names (vpcmpltub ..) (x64_avx.bn, x64_evex.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form, with registers
// 16..31 in each field and a broadcast, else a write mask (and zeroing), where it takes one, and a
// line with [rax + 64] for each with memory (the displacement compressed).  The encodings in full
// are package avx's tests.
func TestX64AvxEvexInt() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "valignd xmm17, xmm18, dword ptr [rax]{1to4}, 1", "62 e3 6d 10 03 08 01")
	e = x64SrcHex(e, "valignd xmm17, xmm18, [rax + 64], 1", "62 e3 6d 00 03 48 04 01")
	e = x64SrcHex(e, "valignd ymm17, ymm18, dword ptr [rax]{1to8}, 1", "62 e3 6d 30 03 08 01")
	e = x64SrcHex(e, "valignd ymm17, ymm18, [rax + 64], 1", "62 e3 6d 20 03 48 02 01")
	e = x64SrcHex(e, "valignd zmm17, zmm18, dword ptr [rax]{1to16}, 1", "62 e3 6d 50 03 08 01")
	e = x64SrcHex(e, "valignd zmm17, zmm18, [rax + 64], 1", "62 e3 6d 40 03 48 01 01")
	e = x64SrcHex(e, "valignq xmm17, xmm18, qword ptr [rax]{1to2}, 1", "62 e3 ed 10 03 08 01")
	e = x64SrcHex(e, "valignq xmm17, xmm18, [rax + 64], 1", "62 e3 ed 00 03 48 04 01")
	e = x64SrcHex(e, "valignq ymm17, ymm18, qword ptr [rax]{1to4}, 1", "62 e3 ed 30 03 08 01")
	e = x64SrcHex(e, "valignq ymm17, ymm18, [rax + 64], 1", "62 e3 ed 20 03 48 02 01")
	e = x64SrcHex(e, "valignq zmm17, zmm18, qword ptr [rax]{1to8}, 1", "62 e3 ed 50 03 08 01")
	e = x64SrcHex(e, "valignq zmm17, zmm18, [rax + 64], 1", "62 e3 ed 40 03 48 01 01")
	e = x64SrcHex(e, "vdbpsadbw xmm17 {k5} {z}, xmm18, [rax], 1", "62 e3 6d 85 42 08 01")
	e = x64SrcHex(e, "vdbpsadbw xmm17, xmm18, [rax + 64], 1", "62 e3 6d 00 42 48 04 01")
	e = x64SrcHex(e, "vdbpsadbw ymm17 {k5} {z}, ymm18, [rax], 1", "62 e3 6d a5 42 08 01")
	e = x64SrcHex(e, "vdbpsadbw ymm17, ymm18, [rax + 64], 1", "62 e3 6d 20 42 48 02 01")
	e = x64SrcHex(e, "vdbpsadbw zmm17 {k5} {z}, zmm18, [rax], 1", "62 e3 6d c5 42 08 01")
	e = x64SrcHex(e, "vdbpsadbw zmm17, zmm18, [rax + 64], 1", "62 e3 6d 40 42 48 01 01")
	e = x64SrcHex(e, "vpabsq xmm17, qword ptr [rax]{1to2}", "62 e2 fd 18 1f 08")
	e = x64SrcHex(e, "vpabsq xmm17, [rax + 64]", "62 e2 fd 08 1f 48 04")
	e = x64SrcHex(e, "vpabsq ymm17, qword ptr [rax]{1to4}", "62 e2 fd 38 1f 08")
	e = x64SrcHex(e, "vpabsq ymm17, [rax + 64]", "62 e2 fd 28 1f 48 02")
