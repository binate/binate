	e = x64SrcHex(e, "vpaddusb zmm17 {k5} {z}, zmm18, [rax]", "62 e1 6d c5 dc 08")
	e = x64SrcHex(e, "vpaddusb zmm17, zmm18, [rax + 64]", "62 e1 6d 40 dc 48 01")
