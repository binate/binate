	e = x64SrcHex(e, "vpavgw ymm17 {k5} {z}, ymm18, [rax]", "62 e1 6d a5 e3 08")
	e = x64SrcHex(e, "vpavgw ymm17, ymm18, [rax + 64]", "62 e1 6d 20 e3 48 02")
