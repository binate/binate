package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX forms of the VEX table's integer arithmetic (avx_table_int.bn's) (x64_avx.bn,
// x64_evex.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax
// noprefix`): a line for each form, with registers 16..31 in each field and a broadcast, else a
// write mask (and zeroing), where it takes one, and a line with [rax + 64] for each with memory
// (the displacement compressed).  The encodings in full are package avx's tests.
func TestX64AvxEvexIntArith() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vpabsb xmm17 {k5} {z}, [rax]", "62 e2 7d 8d 1c 08")
	e = x64SrcHex(e, "vpabsb xmm17, [rax + 64]", "62 e2 7d 08 1c 48 04")
	e = x64SrcHex(e, "vpabsb ymm17 {k5} {z}, [rax]", "62 e2 7d ad 1c 08")
	e = x64SrcHex(e, "vpabsb ymm17, [rax + 64]", "62 e2 7d 28 1c 48 02")
	e = x64SrcHex(e, "vpabsb zmm17 {k5} {z}, [rax]", "62 e2 7d cd 1c 08")
	e = x64SrcHex(e, "vpabsb zmm17, [rax + 64]", "62 e2 7d 48 1c 48 01")
	e = x64SrcHex(e, "vpabsd xmm17, dword ptr [rax]{1to4}", "62 e2 7d 18 1e 08")
	e = x64SrcHex(e, "vpabsd xmm17, [rax + 64]", "62 e2 7d 08 1e 48 04")
	e = x64SrcHex(e, "vpabsd ymm17, dword ptr [rax]{1to8}", "62 e2 7d 38 1e 08")
	e = x64SrcHex(e, "vpabsd ymm17, [rax + 64]", "62 e2 7d 28 1e 48 02")
	e = x64SrcHex(e, "vpabsd zmm17, dword ptr [rax]{1to16}", "62 e2 7d 58 1e 08")
	e = x64SrcHex(e, "vpabsd zmm17, [rax + 64]", "62 e2 7d 48 1e 48 01")
	e = x64SrcHex(e, "vpabsw xmm17 {k5} {z}, [rax]", "62 e2 7d 8d 1d 08")
	e = x64SrcHex(e, "vpabsw xmm17, [rax + 64]", "62 e2 7d 08 1d 48 04")
	e = x64SrcHex(e, "vpabsw ymm17 {k5} {z}, [rax]", "62 e2 7d ad 1d 08")
	e = x64SrcHex(e, "vpabsw ymm17, [rax + 64]", "62 e2 7d 28 1d 48 02")
	e = x64SrcHex(e, "vpabsw zmm17 {k5} {z}, [rax]", "62 e2 7d cd 1d 08")
	e = x64SrcHex(e, "vpabsw zmm17, [rax + 64]", "62 e2 7d 48 1d 48 01")
	e = x64SrcHex(e, "vpaddb xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6d 85 fc 08")
	e = x64SrcHex(e, "vpaddb xmm17, xmm18, [rax + 64]", "62 e1 6d 00 fc 48 04")
	e = x64SrcHex(e, "vpaddb ymm17 {k5} {z}, ymm18, [rax]", "62 e1 6d a5 fc 08")
	e = x64SrcHex(e, "vpaddb ymm17, ymm18, [rax + 64]", "62 e1 6d 20 fc 48 02")
	e = x64SrcHex(e, "vpaddb zmm17 {k5} {z}, zmm18, [rax]", "62 e1 6d c5 fc 08")
	e = x64SrcHex(e, "vpaddb zmm17, zmm18, [rax + 64]", "62 e1 6d 40 fc 48 01")
	e = x64SrcHex(e, "vpaddd xmm17, xmm18, dword ptr [rax]{1to4}", "62 e1 6d 10 fe 08")
	e = x64SrcHex(e, "vpaddd xmm17, xmm18, [rax + 64]", "62 e1 6d 00 fe 48 04")
	e = x64SrcHex(e, "vpaddd ymm17, ymm18, dword ptr [rax]{1to8}", "62 e1 6d 30 fe 08")
	e = x64SrcHex(e, "vpaddd ymm17, ymm18, [rax + 64]", "62 e1 6d 20 fe 48 02")
	e = x64SrcHex(e, "vpaddd zmm17, zmm18, dword ptr [rax]{1to16}", "62 e1 6d 50 fe 08")
	e = x64SrcHex(e, "vpaddd zmm17, zmm18, [rax + 64]", "62 e1 6d 40 fe 48 01")
	e = x64SrcHex(e, "vpaddq xmm17, xmm18, qword ptr [rax]{1to2}", "62 e1 ed 10 d4 08")
	e = x64SrcHex(e, "vpaddq xmm17, xmm18, [rax + 64]", "62 e1 ed 00 d4 48 04")
	e = x64SrcHex(e, "vpaddq ymm17, ymm18, qword ptr [rax]{1to4}", "62 e1 ed 30 d4 08")
	e = x64SrcHex(e, "vpaddq ymm17, ymm18, [rax + 64]", "62 e1 ed 20 d4 48 02")
	e = x64SrcHex(e, "vpaddq zmm17, zmm18, qword ptr [rax]{1to8}", "62 e1 ed 50 d4 08")
	e = x64SrcHex(e, "vpaddq zmm17, zmm18, [rax + 64]", "62 e1 ed 40 d4 48 01")
	e = x64SrcHex(e, "vpaddsb xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6d 85 ec 08")
