	e = x64SrcHex(e, "vpavgb ymm17 {k5} {z}, ymm18, [rax]", "62 e1 6d a5 e0 08")
	e = x64SrcHex(e, "vpavgb ymm17, ymm18, [rax + 64]", "62 e1 6d 20 e0 48 02")
	e = x64SrcHex(e, "vpavgb zmm17 {k5} {z}, zmm18, [rax]", "62 e1 6d c5 e0 08")
	e = x64SrcHex(e, "vpavgb zmm17, zmm18, [rax + 64]", "62 e1 6d 40 e0 48 01")
	e = x64SrcHex(e, "vpavgw xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6d 85 e3 08")
