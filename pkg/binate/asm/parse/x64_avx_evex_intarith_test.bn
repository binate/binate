	e = x64SrcHex(e, "vpaddsw ymm17 {k5} {z}, ymm18, [rax]", "62 e1 6d a5 ed 08")
	e = x64SrcHex(e, "vpaddsw ymm17, ymm18, [rax + 64]", "62 e1 6d 20 ed 48 02")
	e = x64SrcHex(e, "vpaddsw zmm17 {k5} {z}, zmm18, [rax]", "62 e1 6d c5 ed 08")
	e = x64SrcHex(e, "vpaddsw zmm17, zmm18, [rax + 64]", "62 e1 6d 40 ed 48 01")
	e = x64SrcHex(e, "vpaddusb xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6d 85 dc 08")
