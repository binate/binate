	e = x64SrcHex(e, "vpaddsb zmm17 {k5} {z}, zmm18, [rax]", "62 e1 6d c5 ec 08")
	e = x64SrcHex(e, "vpaddsb zmm17, zmm18, [rax + 64]", "62 e1 6d 40 ec 48 01")
	e = x64SrcHex(e, "vpaddsw xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6d 85 ed 08")
