package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX forms of the VEX table's integer logic, compares, shifts, packs, shuffles and moves
// (avx_table_int_logic.bn's and avx_table_int_move.bn's) (x64_avx.bn, x64_evex.bn) against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form,
// with registers 16..31 in each field and a broadcast, else a write mask (and zeroing), where it
// takes one, and a line with [rax + 64] for each with memory (the displacement compressed).  The
// encodings in full are package avx's tests.
func TestX64AvxEvexIntLogic() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vmovd xmm17, [rax + 64]", "62 e1 7d 08 6e 48 10")
	e = x64SrcHex(e, "vmovd xmm17, r9", "62 c1 fd 08 6e c9")
	e = x64SrcHex(e, "vmovd [rax + 64], xmm18", "62 e1 7d 08 7e 50 10")
	e = x64SrcHex(e, "vmovd r9, xmm18", "62 c1 fd 08 7e d1")
	e = x64SrcHex(e, "vmovntdq [rax + 64], xmm18", "62 e1 7d 08 e7 50 04")
	e = x64SrcHex(e, "vmovntdq [rax + 64], ymm18", "62 e1 7d 28 e7 50 02")
	e = x64SrcHex(e, "vmovntdq [rax + 64], zmm18", "62 e1 7d 48 e7 50 01")
	e = x64SrcHex(e, "vmovntdqa xmm17, [rax + 64]", "62 e2 7d 08 2a 48 04")
	e = x64SrcHex(e, "vmovntdqa ymm17, [rax + 64]", "62 e2 7d 28 2a 48 02")
	e = x64SrcHex(e, "vmovntdqa zmm17, [rax + 64]", "62 e2 7d 48 2a 48 01")
	e = x64SrcHex(e, "vmovq xmm17, [rax + 64]", "62 e1 fe 08 7e 48 08")
	e = x64SrcHex(e, "vmovq xmm17, r9", "62 c1 fd 08 6e c9")
	e = x64SrcHex(e, "vmovq r9, xmm18", "62 c1 fd 08 7e d1")
	e = x64SrcHex(e, "vmovq [rax + 64], xmm18", "62 e1 fd 08 d6 50 08")
	e = x64SrcHex(e, "vmovq.s xmm17, xmm18", "62 a1 fd 08 d6 d1")
	e = x64SrcHex(e, "vpackssdw xmm17, xmm18, dword ptr [rax]{1to4}", "62 e1 6d 10 6b 08")
	e = x64SrcHex(e, "vpackssdw xmm17, xmm18, [rax + 64]", "62 e1 6d 00 6b 48 04")
	e = x64SrcHex(e, "vpackssdw ymm17, ymm18, dword ptr [rax]{1to8}", "62 e1 6d 30 6b 08")
	e = x64SrcHex(e, "vpackssdw ymm17, ymm18, [rax + 64]", "62 e1 6d 20 6b 48 02")
	e = x64SrcHex(e, "vpackssdw zmm17, zmm18, dword ptr [rax]{1to16}", "62 e1 6d 50 6b 08")
	e = x64SrcHex(e, "vpackssdw zmm17, zmm18, [rax + 64]", "62 e1 6d 40 6b 48 01")
	e = x64SrcHex(e, "vpacksswb xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6d 85 63 08")
