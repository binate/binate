package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX-512's integer moves with no VEX form (avx_table_evex_intmove.bn's), with vp2intersect's
// destination pair and compress / expand's scale (x64_avx.bn, x64_evex.bn) against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form, with
// registers 16..31 in each field and a broadcast, else a write mask (and zeroing), where it takes
// one, and a line with [rax + 64] for each with memory (the displacement compressed).  The
// encodings in full are package avx's tests.
func TestX64AvxEvexIntMove() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vbroadcasti32x2 xmm17 {k5} {z}, [rax]", "62 e2 7d 8d 59 08")
	e = x64SrcHex(e, "vbroadcasti32x2 xmm17, [rax + 64]", "62 e2 7d 08 59 48 08")
	e = x64SrcHex(e, "vbroadcasti32x2 ymm17 {k5} {z}, [rax]", "62 e2 7d ad 59 08")
	e = x64SrcHex(e, "vbroadcasti32x2 ymm17, [rax + 64]", "62 e2 7d 28 59 48 08")
	e = x64SrcHex(e, "vbroadcasti32x2 zmm17 {k5} {z}, [rax]", "62 e2 7d cd 59 08")
	e = x64SrcHex(e, "vbroadcasti32x2 zmm17, [rax + 64]", "62 e2 7d 48 59 48 08")
	e = x64SrcHex(e, "vbroadcasti32x4 ymm17 {k5} {z}, [rax]", "62 e2 7d ad 5a 08")
	e = x64SrcHex(e, "vbroadcasti32x4 ymm17, [rax + 64]", "62 e2 7d 28 5a 48 04")
	e = x64SrcHex(e, "vbroadcasti32x4 zmm17 {k5} {z}, [rax]", "62 e2 7d cd 5a 08")
	e = x64SrcHex(e, "vbroadcasti32x4 zmm17, [rax + 64]", "62 e2 7d 48 5a 48 04")
	e = x64SrcHex(e, "vbroadcasti32x8 zmm17 {k5} {z}, [rax]", "62 e2 7d cd 5b 08")
	e = x64SrcHex(e, "vbroadcasti32x8 zmm17, [rax + 64]", "62 e2 7d 48 5b 48 02")
	e = x64SrcHex(e, "vbroadcasti64x2 ymm17 {k5} {z}, [rax]", "62 e2 fd ad 5a 08")
	e = x64SrcHex(e, "vbroadcasti64x2 ymm17, [rax + 64]", "62 e2 fd 28 5a 48 04")
	e = x64SrcHex(e, "vbroadcasti64x2 zmm17 {k5} {z}, [rax]", "62 e2 fd cd 5a 08")
	e = x64SrcHex(e, "vbroadcasti64x2 zmm17, [rax + 64]", "62 e2 fd 48 5a 48 04")
	e = x64SrcHex(e, "vbroadcasti64x4 zmm17 {k5} {z}, [rax]", "62 e2 fd cd 5b 08")
	e = x64SrcHex(e, "vbroadcasti64x4 zmm17, [rax + 64]", "62 e2 fd 48 5b 48 02")
	e = x64SrcHex(e, "vextracti32x4 [rax] {k5}, ymm18, 1", "62 e3 7d 2d 39 10 01")
	e = x64SrcHex(e, "vextracti32x4 [rax + 64], ymm18, 1", "62 e3 7d 28 39 50 04 01")
	e = x64SrcHex(e, "vextracti32x4 [rax] {k5}, zmm18, 1", "62 e3 7d 4d 39 10 01")
	e = x64SrcHex(e, "vextracti32x4 [rax + 64], zmm18, 1", "62 e3 7d 48 39 50 04 01")
