	e = x64SrcHex(e, "vunpcklps ymm17, ymm18, dword ptr [rax]{1to8}", "62 e1 6c 30 14 08")
	e = x64SrcHex(e, "vunpcklps ymm17, ymm18, [rax + 64]", "62 e1 6c 20 14 48 02")
