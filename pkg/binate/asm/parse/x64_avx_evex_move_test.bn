	e = x64SrcHex(e, "vunpckhps zmm17, zmm18, [rax + 64]", "62 e1 6c 40 15 48 01")
	e = x64SrcHex(e, "vunpcklpd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e1 ed 10 14 08")
