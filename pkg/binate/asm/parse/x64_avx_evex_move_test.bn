	e = x64SrcHex(e, "vmovhpd xmm17, xmm18, [rax + 64]", "62 e1 ed 00 16 48 08")
	e = x64SrcHex(e, "vmovhlps xmm17, xmm18, xmm20", "62 a1 6c 00 12 cc")
	e = x64SrcHex(e, "vmovlhps xmm17, xmm18, xmm20", "62 a1 6c 00 16 cc")
	e = x64SrcHex(e, "vmovntps [rax + 64], xmm18", "62 e1 7c 08 2b 50 04")
	e = x64SrcHex(e, "vmovntps [rax + 64], ymm18", "62 e1 7c 28 2b 50 02")
	e = x64SrcHex(e, "vmovntps [rax + 64], zmm18", "62 e1 7c 48 2b 50 01")
	e = x64SrcHex(e, "vmovntpd [rax + 64], xmm18", "62 e1 fd 08 2b 50 04")
	e = x64SrcHex(e, "vmovntpd [rax + 64], ymm18", "62 e1 fd 28 2b 50 02")
	e = x64SrcHex(e, "vmovntpd [rax + 64], zmm18", "62 e1 fd 48 2b 50 01")
	e = x64SrcHex(e, "vshufps xmm17, xmm18, dword ptr [rax]{1to4}, 1", "62 e1 6c 10 c6 08 01")
	e = x64SrcHex(e, "vshufps xmm17, xmm18, [rax + 64], 1", "62 e1 6c 00 c6 48 04 01")
	e = x64SrcHex(e, "vshufps ymm17, ymm18, dword ptr [rax]{1to8}, 1", "62 e1 6c 30 c6 08 01")
	e = x64SrcHex(e, "vshufps ymm17, ymm18, [rax + 64], 1", "62 e1 6c 20 c6 48 02 01")
	e = x64SrcHex(e, "vshufps zmm17, zmm18, dword ptr [rax]{1to16}, 1", "62 e1 6c 50 c6 08 01")
	e = x64SrcHex(e, "vshufps zmm17, zmm18, [rax + 64], 1", "62 e1 6c 40 c6 48 01 01")
	e = x64SrcHex(e, "vshufpd xmm17, xmm18, qword ptr [rax]{1to2}, 1", "62 e1 ed 10 c6 08 01")
	e = x64SrcHex(e, "vshufpd xmm17, xmm18, [rax + 64], 1", "62 e1 ed 00 c6 48 04 01")
	e = x64SrcHex(e, "vshufpd ymm17, ymm18, qword ptr [rax]{1to4}, 1", "62 e1 ed 30 c6 08 01")
	e = x64SrcHex(e, "vshufpd ymm17, ymm18, [rax + 64], 1", "62 e1 ed 20 c6 48 02 01")
	e = x64SrcHex(e, "vshufpd zmm17, zmm18, qword ptr [rax]{1to8}, 1", "62 e1 ed 50 c6 08 01")
	e = x64SrcHex(e, "vshufpd zmm17, zmm18, [rax + 64], 1", "62 e1 ed 40 c6 48 01 01")
	e = x64SrcHex(e, "vunpcklps xmm17, xmm18, dword ptr [rax]{1to4}", "62 e1 6c 10 14 08")
