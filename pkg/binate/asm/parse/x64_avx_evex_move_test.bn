package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX forms of the table's moves part (x64_avx.bn, x64_evex.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each, with registers 16..31
// in each field and a broadcast, else a write mask (and zeroing), where it takes one; a line with
// [rax + 64] for each with memory (the displacement compressed by the memory's size); and a line
// with its rounding or SAE operand for each that takes one.  The encodings in full are package
// avx's tests.
func TestX64AvxEvexMove() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vmovaps xmm17 {k5} {z}, [rax]", "62 e1 7c 8d 28 08")
	e = x64SrcHex(e, "vmovaps xmm17, [rax + 64]", "62 e1 7c 08 28 48 04")
	e = x64SrcHex(e, "vmovaps ymm17 {k5} {z}, [rax]", "62 e1 7c ad 28 08")
	e = x64SrcHex(e, "vmovaps ymm17, [rax + 64]", "62 e1 7c 28 28 48 02")
	e = x64SrcHex(e, "vmovaps zmm17 {k5} {z}, [rax]", "62 e1 7c cd 28 08")
	e = x64SrcHex(e, "vmovaps zmm17, [rax + 64]", "62 e1 7c 48 28 48 01")
	e = x64SrcHex(e, "vmovaps [rax] {k5}, xmm18", "62 e1 7c 0d 29 10")
	e = x64SrcHex(e, "vmovaps [rax + 64], xmm18", "62 e1 7c 08 29 50 04")
	e = x64SrcHex(e, "vmovaps [rax] {k5}, ymm18", "62 e1 7c 2d 29 10")
	e = x64SrcHex(e, "vmovaps [rax + 64], ymm18", "62 e1 7c 28 29 50 02")
	e = x64SrcHex(e, "vmovaps [rax] {k5}, zmm18", "62 e1 7c 4d 29 10")
	e = x64SrcHex(e, "vmovaps [rax + 64], zmm18", "62 e1 7c 48 29 50 01")
	e = x64SrcHex(e, "vmovapd xmm17 {k5} {z}, [rax]", "62 e1 fd 8d 28 08")
	e = x64SrcHex(e, "vmovapd xmm17, [rax + 64]", "62 e1 fd 08 28 48 04")
	e = x64SrcHex(e, "vmovapd ymm17 {k5} {z}, [rax]", "62 e1 fd ad 28 08")
	e = x64SrcHex(e, "vmovapd ymm17, [rax + 64]", "62 e1 fd 28 28 48 02")
	e = x64SrcHex(e, "vmovapd zmm17 {k5} {z}, [rax]", "62 e1 fd cd 28 08")
	e = x64SrcHex(e, "vmovapd zmm17, [rax + 64]", "62 e1 fd 48 28 48 01")
	e = x64SrcHex(e, "vmovapd [rax] {k5}, xmm18", "62 e1 fd 0d 29 10")
	e = x64SrcHex(e, "vmovapd [rax + 64], xmm18", "62 e1 fd 08 29 50 04")
	e = x64SrcHex(e, "vmovapd [rax] {k5}, ymm18", "62 e1 fd 2d 29 10")
	e = x64SrcHex(e, "vmovapd [rax + 64], ymm18", "62 e1 fd 28 29 50 02")
	e = x64SrcHex(e, "vmovapd [rax] {k5}, zmm18", "62 e1 fd 4d 29 10")
	e = x64SrcHex(e, "vmovapd [rax + 64], zmm18", "62 e1 fd 48 29 50 01")
	e = x64SrcHex(e, "vmovups xmm17 {k5} {z}, [rax]", "62 e1 7c 8d 10 08")
	e = x64SrcHex(e, "vmovups xmm17, [rax + 64]", "62 e1 7c 08 10 48 04")
	e = x64SrcHex(e, "vmovups ymm17 {k5} {z}, [rax]", "62 e1 7c ad 10 08")
	e = x64SrcHex(e, "vmovups ymm17, [rax + 64]", "62 e1 7c 28 10 48 02")
	e = x64SrcHex(e, "vmovups zmm17 {k5} {z}, [rax]", "62 e1 7c cd 10 08")
	e = x64SrcHex(e, "vmovups zmm17, [rax + 64]", "62 e1 7c 48 10 48 01")
	e = x64SrcHex(e, "vmovups [rax] {k5}, xmm18", "62 e1 7c 0d 11 10")
	e = x64SrcHex(e, "vmovups [rax + 64], xmm18", "62 e1 7c 08 11 50 04")
	e = x64SrcHex(e, "vmovups [rax] {k5}, ymm18", "62 e1 7c 2d 11 10")
	e = x64SrcHex(e, "vmovups [rax + 64], ymm18", "62 e1 7c 28 11 50 02")
	e = x64SrcHex(e, "vmovups [rax] {k5}, zmm18", "62 e1 7c 4d 11 10")
	e = x64SrcHex(e, "vmovups [rax + 64], zmm18", "62 e1 7c 48 11 50 01")
	e = x64SrcHex(e, "vmovupd xmm17 {k5} {z}, [rax]", "62 e1 fd 8d 10 08")
	e = x64SrcHex(e, "vmovupd xmm17, [rax + 64]", "62 e1 fd 08 10 48 04")
	e = x64SrcHex(e, "vmovupd ymm17 {k5} {z}, [rax]", "62 e1 fd ad 10 08")
	e = x64SrcHex(e, "vmovupd ymm17, [rax + 64]", "62 e1 fd 28 10 48 02")
	e = x64SrcHex(e, "vmovupd zmm17 {k5} {z}, [rax]", "62 e1 fd cd 10 08")
	e = x64SrcHex(e, "vmovupd zmm17, [rax + 64]", "62 e1 fd 48 10 48 01")
	e = x64SrcHex(e, "vmovupd [rax] {k5}, xmm18", "62 e1 fd 0d 11 10")
	e = x64SrcHex(e, "vmovupd [rax + 64], xmm18", "62 e1 fd 08 11 50 04")
	e = x64SrcHex(e, "vmovupd [rax] {k5}, ymm18", "62 e1 fd 2d 11 10")
	e = x64SrcHex(e, "vmovupd [rax + 64], ymm18", "62 e1 fd 28 11 50 02")
	e = x64SrcHex(e, "vmovupd [rax] {k5}, zmm18", "62 e1 fd 4d 11 10")
	e = x64SrcHex(e, "vmovupd [rax + 64], zmm18", "62 e1 fd 48 11 50 01")
	e = x64SrcHex(e, "vmovss xmm17 {k5} {z}, [rax]", "62 e1 7e 8d 10 08")
	e = x64SrcHex(e, "vmovss xmm17, [rax + 64]", "62 e1 7e 08 10 48 10")
	e = x64SrcHex(e, "vmovss [rax] {k5}, xmm18", "62 e1 7e 0d 11 10")
	e = x64SrcHex(e, "vmovss [rax + 64], xmm18", "62 e1 7e 08 11 50 10")
	e = x64SrcHex(e, "vmovss xmm17 {k5} {z}, xmm18, xmm20", "62 a1 6e 85 10 cc")
	e = x64SrcHex(e, "vmovsd xmm17 {k5} {z}, [rax]", "62 e1 ff 8d 10 08")
	e = x64SrcHex(e, "vmovsd xmm17, [rax + 64]", "62 e1 ff 08 10 48 08")
	e = x64SrcHex(e, "vmovsd [rax] {k5}, xmm18", "62 e1 ff 0d 11 10")
	e = x64SrcHex(e, "vmovsd [rax + 64], xmm18", "62 e1 ff 08 11 50 08")
	e = x64SrcHex(e, "vmovsd xmm17 {k5} {z}, xmm18, xmm20", "62 a1 ef 85 10 cc")
	e = x64SrcHex(e, "vmovlps [rax + 64], xmm18", "62 e1 7c 08 13 50 08")
	e = x64SrcHex(e, "vmovlps xmm17, xmm18, [rax + 64]", "62 e1 6c 00 12 48 08")
