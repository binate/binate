	e = x64SrcHex(e, "vunpcklpd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e1 ed 30 14 08")
	e = x64SrcHex(e, "vunpcklpd ymm17, ymm18, [rax + 64]", "62 e1 ed 20 14 48 02")
	e = x64SrcHex(e, "vunpcklpd zmm17, zmm18, qword ptr [rax]{1to8}", "62 e1 ed 50 14 08")
	e = x64SrcHex(e, "vunpcklpd zmm17, zmm18, [rax + 64]", "62 e1 ed 40 14 48 01")
	e = x64SrcHex(e, "vunpckhpd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e1 ed 10 15 08")
	e = x64SrcHex(e, "vunpckhpd xmm17, xmm18, [rax + 64]", "62 e1 ed 00 15 48 04")
	e = x64SrcHex(e, "vunpckhpd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e1 ed 30 15 08")
	e = x64SrcHex(e, "vunpckhpd ymm17, ymm18, [rax + 64]", "62 e1 ed 20 15 48 02")
	e = x64SrcHex(e, "vunpckhpd zmm17, zmm18, qword ptr [rax]{1to8}", "62 e1 ed 50 15 08")
	e = x64SrcHex(e, "vunpckhpd zmm17, zmm18, [rax + 64]", "62 e1 ed 40 15 48 01")
	e = x64SrcHex(e, "vmovddup xmm17 {k5} {z}, [rax]", "62 e1 ff 8d 12 08")
	e = x64SrcHex(e, "vmovddup xmm17, [rax + 64]", "62 e1 ff 08 12 48 08")
	e = x64SrcHex(e, "vmovddup ymm17 {k5} {z}, [rax]", "62 e1 ff ad 12 08")
