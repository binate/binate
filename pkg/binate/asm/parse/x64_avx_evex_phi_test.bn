package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Xeon Phi's AVX512ER, 4FMAPS, 4VNNIW and AVX512PF (avx_table_evex_phi.bn's) (x64_avx.bn,
// x64_evex.bn, x64_mem.bn) against clang's (GNU as's for AVX512PF, which clang no longer has) bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form with
// registers 16..31 and its decorations, and with memory and a compressed displacement where it
// takes them.  The encodings in full are package avx's tests.
func TestX64AvxEvexPhi() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vexp2ps zmm17, dword ptr [rax]{1to16}", "62 e2 7d 58 c8 08")
	e = x64SrcHex(e, "vexp2ps zmm17, [rax + 64]", "62 e2 7d 48 c8 48 01")
	e = x64SrcHex(e, "vexp2ps zmm17, zmm18, {sae}", "62 a2 7d 18 c8 ca")
	e = x64SrcHex(e, "vexp2pd zmm17, qword ptr [rax]{1to8}", "62 e2 fd 58 c8 08")
	e = x64SrcHex(e, "vexp2pd zmm17, [rax + 64]", "62 e2 fd 48 c8 48 01")
	e = x64SrcHex(e, "vexp2pd zmm17, zmm18, {sae}", "62 a2 fd 18 c8 ca")
	e = x64SrcHex(e, "vrcp28ps zmm17, dword ptr [rax]{1to16}", "62 e2 7d 58 ca 08")
	e = x64SrcHex(e, "vrcp28ps zmm17, [rax + 64]", "62 e2 7d 48 ca 48 01")
	e = x64SrcHex(e, "vrcp28ps zmm17, zmm18, {sae}", "62 a2 7d 18 ca ca")
	e = x64SrcHex(e, "vrcp28pd zmm17, qword ptr [rax]{1to8}", "62 e2 fd 58 ca 08")
	e = x64SrcHex(e, "vrcp28pd zmm17, [rax + 64]", "62 e2 fd 48 ca 48 01")
	e = x64SrcHex(e, "vrcp28pd zmm17, zmm18, {sae}", "62 a2 fd 18 ca ca")
	e = x64SrcHex(e, "vrcp28ss xmm17 {k5} {z}, xmm18, [rax]", "62 e2 6d 85 cb 08")
	e = x64SrcHex(e, "vrcp28ss xmm17, xmm18, [rax + 64]", "62 e2 6d 00 cb 48 10")
	e = x64SrcHex(e, "vrcp28ss xmm17, xmm18, xmm20, {sae}", "62 a2 6d 10 cb cc")
	e = x64SrcHex(e, "vrcp28sd xmm17 {k5} {z}, xmm18, [rax]", "62 e2 ed 85 cb 08")
	e = x64SrcHex(e, "vrcp28sd xmm17, xmm18, [rax + 64]", "62 e2 ed 00 cb 48 08")
	e = x64SrcHex(e, "vrcp28sd xmm17, xmm18, xmm20, {sae}", "62 a2 ed 10 cb cc")
	e = x64SrcHex(e, "vrsqrt28ps zmm17, dword ptr [rax]{1to16}", "62 e2 7d 58 cc 08")
	e = x64SrcHex(e, "vrsqrt28ps zmm17, [rax + 64]", "62 e2 7d 48 cc 48 01")
	e = x64SrcHex(e, "vrsqrt28ps zmm17, zmm18, {sae}", "62 a2 7d 18 cc ca")
	e = x64SrcHex(e, "vrsqrt28pd zmm17, qword ptr [rax]{1to8}", "62 e2 fd 58 cc 08")
	e = x64SrcHex(e, "vrsqrt28pd zmm17, [rax + 64]", "62 e2 fd 48 cc 48 01")
	e = x64SrcHex(e, "vrsqrt28pd zmm17, zmm18, {sae}", "62 a2 fd 18 cc ca")
	e = x64SrcHex(e, "vrsqrt28ss xmm17 {k5} {z}, xmm18, [rax]", "62 e2 6d 85 cd 08")
	e = x64SrcHex(e, "vrsqrt28ss xmm17, xmm18, [rax + 64]", "62 e2 6d 00 cd 48 10")
	e = x64SrcHex(e, "vrsqrt28ss xmm17, xmm18, xmm20, {sae}", "62 a2 6d 10 cd cc")
	e = x64SrcHex(e, "vrsqrt28sd xmm17 {k5} {z}, xmm18, [rax]", "62 e2 ed 85 cd 08")
	e = x64SrcHex(e, "vrsqrt28sd xmm17, xmm18, [rax + 64]", "62 e2 ed 00 cd 48 08")
	e = x64SrcHex(e, "vrsqrt28sd xmm17, xmm18, xmm20, {sae}", "62 a2 ed 10 cd cc")
	e = x64SrcHex(e, "v4fmaddps zmm17 {k5} {z}, zmm18, [rax]", "62 e2 6f c5 9a 08")
	e = x64SrcHex(e, "v4fmaddps zmm17, zmm18, [rax + 64]", "62 e2 6f 40 9a 48 04")
	e = x64SrcHex(e, "v4fmaddss xmm17 {k5} {z}, xmm18, [rax]", "62 e2 6f 85 9b 08")
	e = x64SrcHex(e, "v4fmaddss xmm17, xmm18, [rax + 64]", "62 e2 6f 00 9b 48 04")
	e = x64SrcHex(e, "v4fnmaddps zmm17 {k5} {z}, zmm18, [rax]", "62 e2 6f c5 aa 08")
	e = x64SrcHex(e, "v4fnmaddps zmm17, zmm18, [rax + 64]", "62 e2 6f 40 aa 48 04")
	e = x64SrcHex(e, "v4fnmaddss xmm17 {k5} {z}, xmm18, [rax]", "62 e2 6f 85 ab 08")
	e = x64SrcHex(e, "v4fnmaddss xmm17, xmm18, [rax + 64]", "62 e2 6f 00 ab 48 04")
	e = x64SrcHex(e, "vp4dpwssd zmm17 {k5} {z}, zmm18, [rax]", "62 e2 6f c5 52 08")
	e = x64SrcHex(e, "vp4dpwssd zmm17, zmm18, [rax + 64]", "62 e2 6f 40 52 48 04")
	e = x64SrcHex(e, "vp4dpwssds zmm17 {k5} {z}, zmm18, [rax]", "62 e2 6f c5 53 08")
	e = x64SrcHex(e, "vp4dpwssds zmm17, zmm18, [rax + 64]", "62 e2 6f 40 53 48 04")
	e = x64SrcHex(e, "vgatherpf0dps [rax + zmm2*4] {k1}", "62 f2 7d 49 c6 0c 90")
	e = x64SrcHex(e, "vgatherpf0dps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c6 4c d1 10")
	e = x64SrcHex(e, "vgatherpf0dps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c6 0c 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf0qps [rax + zmm2*4] {k1}", "62 f2 7d 49 c7 0c 90")
	e = x64SrcHex(e, "vgatherpf0qps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c7 4c d1 10")
	e = x64SrcHex(e, "vgatherpf0qps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c7 0c 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf0dpd [rax + ymm2*4] {k1}", "62 f2 fd 49 c6 0c 90")
	e = x64SrcHex(e, "vgatherpf0dpd qword ptr [r9 + ymm18*8 + 64] {k7}", "62 d2 fd 47 c6 4c d1 08")
	e = x64SrcHex(e, "vgatherpf0dpd [ymm31*2 + 4] {k2}", "62 b2 fd 42 c6 0c 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf0qpd [rax + zmm2*4] {k1}", "62 f2 fd 49 c7 0c 90")
	e = x64SrcHex(e, "vgatherpf0qpd qword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 fd 47 c7 4c d1 08")
	e = x64SrcHex(e, "vgatherpf0qpd [zmm31*2 + 4] {k2}", "62 b2 fd 42 c7 0c 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf1dps [rax + zmm2*4] {k1}", "62 f2 7d 49 c6 14 90")
	e = x64SrcHex(e, "vgatherpf1dps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c6 54 d1 10")
	e = x64SrcHex(e, "vgatherpf1dps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c6 14 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf1qps [rax + zmm2*4] {k1}", "62 f2 7d 49 c7 14 90")
	e = x64SrcHex(e, "vgatherpf1qps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c7 54 d1 10")
	e = x64SrcHex(e, "vgatherpf1qps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c7 14 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf1dpd [rax + ymm2*4] {k1}", "62 f2 fd 49 c6 14 90")
	e = x64SrcHex(e, "vgatherpf1dpd qword ptr [r9 + ymm18*8 + 64] {k7}", "62 d2 fd 47 c6 54 d1 08")
	e = x64SrcHex(e, "vgatherpf1dpd [ymm31*2 + 4] {k2}", "62 b2 fd 42 c6 14 7d 04 00 00 00")
	e = x64SrcHex(e, "vgatherpf1qpd [rax + zmm2*4] {k1}", "62 f2 fd 49 c7 14 90")
	e = x64SrcHex(e, "vgatherpf1qpd qword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 fd 47 c7 54 d1 08")
	e = x64SrcHex(e, "vgatherpf1qpd [zmm31*2 + 4] {k2}", "62 b2 fd 42 c7 14 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf0dps [rax + zmm2*4] {k1}", "62 f2 7d 49 c6 2c 90")
	e = x64SrcHex(e, "vscatterpf0dps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c6 6c d1 10")
	e = x64SrcHex(e, "vscatterpf0dps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c6 2c 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf0qps [rax + zmm2*4] {k1}", "62 f2 7d 49 c7 2c 90")
	e = x64SrcHex(e, "vscatterpf0qps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c7 6c d1 10")
	e = x64SrcHex(e, "vscatterpf0qps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c7 2c 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf0dpd [rax + ymm2*4] {k1}", "62 f2 fd 49 c6 2c 90")
	e = x64SrcHex(e, "vscatterpf0dpd qword ptr [r9 + ymm18*8 + 64] {k7}", "62 d2 fd 47 c6 6c d1 08")
	e = x64SrcHex(e, "vscatterpf0dpd [ymm31*2 + 4] {k2}", "62 b2 fd 42 c6 2c 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf0qpd [rax + zmm2*4] {k1}", "62 f2 fd 49 c7 2c 90")
	e = x64SrcHex(e, "vscatterpf0qpd qword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 fd 47 c7 6c d1 08")
	e = x64SrcHex(e, "vscatterpf0qpd [zmm31*2 + 4] {k2}", "62 b2 fd 42 c7 2c 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf1dps [rax + zmm2*4] {k1}", "62 f2 7d 49 c6 34 90")
	e = x64SrcHex(e, "vscatterpf1dps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c6 74 d1 10")
	e = x64SrcHex(e, "vscatterpf1dps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c6 34 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf1qps [rax + zmm2*4] {k1}", "62 f2 7d 49 c7 34 90")
	e = x64SrcHex(e, "vscatterpf1qps dword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 7d 47 c7 74 d1 10")
	e = x64SrcHex(e, "vscatterpf1qps [zmm31*2 + 4] {k2}", "62 b2 7d 42 c7 34 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf1dpd [rax + ymm2*4] {k1}", "62 f2 fd 49 c6 34 90")
	e = x64SrcHex(e, "vscatterpf1dpd qword ptr [r9 + ymm18*8 + 64] {k7}", "62 d2 fd 47 c6 74 d1 08")
	e = x64SrcHex(e, "vscatterpf1dpd [ymm31*2 + 4] {k2}", "62 b2 fd 42 c6 34 7d 04 00 00 00")
	e = x64SrcHex(e, "vscatterpf1qpd [rax + zmm2*4] {k1}", "62 f2 fd 49 c7 34 90")
	e = x64SrcHex(e, "vscatterpf1qpd qword ptr [r9 + zmm18*8 + 64] {k7}", "62 d2 fd 47 c7 74 d1 08")
	e = x64SrcHex(e, "vscatterpf1qpd [zmm31*2 + 4] {k2}", "62 b2 fd 42 c7 34 7d 04 00 00 00")
	return e
}
