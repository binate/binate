package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX-512's scatters (avx_table_gather.bn's), with XMM, YMM and ZMM indexes 0..31 (x64_avx.bn,
// x64_evex.bn, x64_mem.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): a line for each form with registers 16..31 and its decorations, and
// with memory and a compressed displacement where it takes them.  The encodings in full are package
// avx's tests.
func TestX64AvxEvexScatter() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vscatterdps [rax + xmm2*4] {k1}, xmm1", "62 f2 7d 09 a2 0c 90")
	e = x64SrcHex(e, "vscatterdps dword ptr [rax + xmm2*4] {k1}, xmm1", "62 f2 7d 09 a2 0c 90")
	e = x64SrcHex(e, "vscatterdps [rax + xmm18*4] {k1}, xmm17", "62 e2 7d 01 a2 0c 90")
	e = x64SrcHex(e, "vscatterdps [rax + xmm30*4] {k1}, xmm31", "62 22 7d 01 a2 3c b0")
	e = x64SrcHex(e, "vscatterdps [rax + xmm1*4] {k1}, xmm1", "62 f2 7d 09 a2 0c 88")
	e = x64SrcHex(e, "vscatterdps [r9 + xmm2*8 + 64] {k1}, xmm1", "62 d2 7d 09 a2 4c d1 10")
	e = x64SrcHex(e, "vscatterdps [rax + xmm2*1 + 4] {k1}, xmm1", "62 f2 7d 09 a2 4c 10 01")
	e = x64SrcHex(e, "vscatterdps [rax + xmm2*2 - 128] {k1}, xmm1", "62 f2 7d 09 a2 4c 50 e0")
	e = x64SrcHex(e, "vscatterdps [xmm2*4] {k1}, xmm1", "62 f2 7d 09 a2 0c 95 00 00 00 00")
	e = x64SrcHex(e, "vscatterdps [rax + ymm2*4] {k1}, ymm1", "62 f2 7d 29 a2 0c 90")
	e = x64SrcHex(e, "vscatterdps dword ptr [rax + ymm2*4] {k1}, ymm1", "62 f2 7d 29 a2 0c 90")
	e = x64SrcHex(e, "vscatterdps [rax + ymm18*4] {k1}, ymm17", "62 e2 7d 21 a2 0c 90")
	e = x64SrcHex(e, "vscatterdps [rax + ymm30*4] {k1}, ymm31", "62 22 7d 21 a2 3c b0")
	e = x64SrcHex(e, "vscatterdps [rax + ymm1*4] {k1}, ymm1", "62 f2 7d 29 a2 0c 88")
	e = x64SrcHex(e, "vscatterdps [r9 + ymm2*8 + 64] {k1}, ymm1", "62 d2 7d 29 a2 4c d1 10")
