	e = x64SrcHex(e, "vminpd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e1 ed 10 5d 08")
	e = x64SrcHex(e, "vminpd xmm17, xmm18, [rax + 64]", "62 e1 ed 00 5d 48 04")
	e = x64SrcHex(e, "vminpd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e1 ed 30 5d 08")
