package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The EVEX forms of the table's arithmetic part (x64_avx.bn, x64_evex.bn) against clang's bytes
// (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each, with registers
// 16..31 in each field and a broadcast, else a write mask (and zeroing), where it takes one; a line
// with [rax + 64] for each with memory (the displacement compressed by the memory's size), after
// {evex} where no operand asks for EVEX; and a line with its rounding or SAE operand for each that
// takes one.  The encodings in full are package avx's tests.
func TestX64AvxEvexArith() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps xmm17, xmm18, dword ptr [rax]{1to4}", "62 e1 6c 10 58 08")
	e = x64SrcHex(e, "vaddps xmm17, xmm18, [rax + 64]", "62 e1 6c 00 58 48 04")
	e = x64SrcHex(e, "vaddps ymm17, ymm18, dword ptr [rax]{1to8}", "62 e1 6c 30 58 08")
	e = x64SrcHex(e, "vaddps ymm17, ymm18, [rax + 64]", "62 e1 6c 20 58 48 02")
	e = x64SrcHex(e, "vaddps zmm17, zmm18, dword ptr [rax]{1to16}", "62 e1 6c 50 58 08")
	e = x64SrcHex(e, "vaddps zmm17, zmm18, [rax + 64]", "62 e1 6c 40 58 48 01")
	e = x64SrcHex(e, "vaddps zmm17, zmm18, zmm20, {rn-sae}", "62 a1 6c 10 58 cc")
	e = x64SrcHex(e, "vaddpd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e1 ed 10 58 08")
	e = x64SrcHex(e, "vaddpd xmm17, xmm18, [rax + 64]", "62 e1 ed 00 58 48 04")
	e = x64SrcHex(e, "vaddpd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e1 ed 30 58 08")
	e = x64SrcHex(e, "vaddpd ymm17, ymm18, [rax + 64]", "62 e1 ed 20 58 48 02")
	e = x64SrcHex(e, "vaddpd zmm17, zmm18, qword ptr [rax]{1to8}", "62 e1 ed 50 58 08")
	e = x64SrcHex(e, "vaddpd zmm17, zmm18, [rax + 64]", "62 e1 ed 40 58 48 01")
	e = x64SrcHex(e, "vaddpd zmm17, zmm18, zmm20, {rn-sae}", "62 a1 ed 10 58 cc")
	e = x64SrcHex(e, "vaddss xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6e 85 58 08")
	e = x64SrcHex(e, "vaddss xmm17, xmm18, [rax + 64]", "62 e1 6e 00 58 48 10")
	e = x64SrcHex(e, "vaddss xmm17, xmm18, xmm20, {rn-sae}", "62 a1 6e 10 58 cc")
	e = x64SrcHex(e, "vaddsd xmm17 {k5} {z}, xmm18, [rax]", "62 e1 ef 85 58 08")
	e = x64SrcHex(e, "vaddsd xmm17, xmm18, [rax + 64]", "62 e1 ef 00 58 48 08")
	e = x64SrcHex(e, "vaddsd xmm17, xmm18, xmm20, {rn-sae}", "62 a1 ef 10 58 cc")
	e = x64SrcHex(e, "vmulps xmm17, xmm18, dword ptr [rax]{1to4}", "62 e1 6c 10 59 08")
	e = x64SrcHex(e, "vmulps xmm17, xmm18, [rax + 64]", "62 e1 6c 00 59 48 04")
	e = x64SrcHex(e, "vmulps ymm17, ymm18, dword ptr [rax]{1to8}", "62 e1 6c 30 59 08")
	e = x64SrcHex(e, "vmulps ymm17, ymm18, [rax + 64]", "62 e1 6c 20 59 48 02")
	e = x64SrcHex(e, "vmulps zmm17, zmm18, dword ptr [rax]{1to16}", "62 e1 6c 50 59 08")
	e = x64SrcHex(e, "vmulps zmm17, zmm18, [rax + 64]", "62 e1 6c 40 59 48 01")
	e = x64SrcHex(e, "vmulps zmm17, zmm18, zmm20, {rn-sae}", "62 a1 6c 10 59 cc")
	e = x64SrcHex(e, "vmulpd xmm17, xmm18, qword ptr [rax]{1to2}", "62 e1 ed 10 59 08")
	e = x64SrcHex(e, "vmulpd xmm17, xmm18, [rax + 64]", "62 e1 ed 00 59 48 04")
	e = x64SrcHex(e, "vmulpd ymm17, ymm18, qword ptr [rax]{1to4}", "62 e1 ed 30 59 08")
	e = x64SrcHex(e, "vmulpd ymm17, ymm18, [rax + 64]", "62 e1 ed 20 59 48 02")
	e = x64SrcHex(e, "vmulpd zmm17, zmm18, qword ptr [rax]{1to8}", "62 e1 ed 50 59 08")
	e = x64SrcHex(e, "vmulpd zmm17, zmm18, [rax + 64]", "62 e1 ed 40 59 48 01")
	e = x64SrcHex(e, "vmulpd zmm17, zmm18, zmm20, {rn-sae}", "62 a1 ed 10 59 cc")
	e = x64SrcHex(e, "vmulss xmm17 {k5} {z}, xmm18, [rax]", "62 e1 6e 85 59 08")
