	e = x64SrcHex(e, "vpdpbsud xmm9, xmm11, xmmword ptr [r10]", "c4 42 22 50 0a")
	e = x64SrcHex(e, "vpdpbsud ymm10, ymm12, ymmword ptr [r10]", "c4 42 1e 50 12")
	e = x64SrcHex(e, "vpdpbsuds xmm9, xmm11, xmmword ptr [r10]", "c4 42 22 51 0a")
	e = x64SrcHex(e, "vpdpbsuds ymm10, ymm12, ymmword ptr [r10]", "c4 42 1e 51 12")
	e = x64SrcHex(e, "vpdpbuud xmm9, xmm11, xmmword ptr [r10]", "c4 42 20 50 0a")
	e = x64SrcHex(e, "vpdpbuud ymm10, ymm12, ymmword ptr [r10]", "c4 42 1c 50 12")
	e = x64SrcHex(e, "vpdpbuuds xmm9, xmm11, xmmword ptr [r10]", "c4 42 20 51 0a")
	e = x64SrcHex(e, "vpdpbuuds ymm10, ymm12, ymmword ptr [r10]", "c4 42 1c 51 12")
	e = x64SrcHex(e, "vpdpwsud xmm9, xmm11, xmmword ptr [r10]", "c4 42 22 d2 0a")
	e = x64SrcHex(e, "vpdpwsud ymm10, ymm12, ymmword ptr [r10]", "c4 42 1e d2 12")
	e = x64SrcHex(e, "vpdpwsuds xmm9, xmm11, xmmword ptr [r10]", "c4 42 22 d3 0a")
	e = x64SrcHex(e, "vpdpwsuds ymm10, ymm12, ymmword ptr [r10]", "c4 42 1e d3 12")
	e = x64SrcHex(e, "vpdpwusd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 d2 0a")
	e = x64SrcHex(e, "vpdpwusd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d d2 12")
	e = x64SrcHex(e, "vpdpwusds xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 d3 0a")
	e = x64SrcHex(e, "vpdpwusds ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d d3 12")
	e = x64SrcHex(e, "vpdpwuud xmm9, xmm11, xmmword ptr [r10]", "c4 42 20 d2 0a")
	e = x64SrcHex(e, "vpdpwuud ymm10, ymm12, ymmword ptr [r10]", "c4 42 1c d2 12")
	e = x64SrcHex(e, "vpdpwuuds xmm9, xmm11, xmmword ptr [r10]", "c4 42 20 d3 0a")
	e = x64SrcHex(e, "vpdpwuuds ymm10, ymm12, ymmword ptr [r10]", "c4 42 1c d3 12")
	e = x64SrcHex(e, "{vex} vcvtneps2bf16 xmm9, xmmword ptr [r10]", "c4 42 7a 72 0a")
	e = x64SrcHex(e, "{vex} vcvtneps2bf16 xmm9, ymmword ptr [r10]", "c4 42 7e 72 0a")
	e = x64SrcHex(e, "{vex} vpdpbusd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 50 0a")
