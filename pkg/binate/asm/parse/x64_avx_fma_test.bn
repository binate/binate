	e = x64SrcHex(e, "{vex} vpmadd52huq ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d b5 12")
	e = x64SrcHex(e, "{vex} vpmadd52luq xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 b4 0a")
	e = x64SrcHex(e, "{vex} vpmadd52luq ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d b4 12")
	return e
}

// vpclmulqdq's names for its selectors, at 128 and 256 bits; the instructions clang encodes as EVEX
// unless {vex}, {vex2} or {vex3} is written, as clang (vcvtneps2bf16, whose EVEX form is not here
// yet, takes one).
func TestX64AvxExtNames() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vpclmullqlqdq xmm0, xmm1, xmm2", "c4 e3 71 44 c2 00")
	e = x64SrcHex(e, "vpclmulhqlqdq xmm0, xmm1, xmmword ptr [rax]", "c4 e3 71 44 00 01")
	e = x64SrcHex(e, "vpclmullqhqdq ymm0, ymm1, ymm2", "c4 e3 75 44 c2 10")
	e = x64SrcHex(e, "VPCLMULHQHQDQ ymm9, ymm10, ymm11", "c4 43 2d 44 cb 11")
	e = x64LineRejected(e, "vpclmullqlqdq xmm0, xmm1, xmm2, 1")
	e = x64LineRejected(e, "vpclmullqlqdq xmm0, xmm1")
	e = x64SrcHex(e, "{vex3} vpdpbusd xmm0, xmm1, xmm2", "c4 e2 71 50 c2")
	e = x64SrcHex(e, "{vex2} vpdpbusd xmm0, xmm1, xmm2", "c4 e2 71 50 c2")
	e = x64SrcHex(e, "fs {vex} vpdpbusd xmm0, xmm1, [rax]", "64 c4 e2 71 50 00")
	e = x64SrcHex(e, "{vex} vpdpbusd xmm0, xmm1, xmm2 ; vpdpbusd xmm0, xmm1, xmm2",
			"c4 e2 71 50 c2 62 f2 75 08 50 c2")
	e = x64SrcHex(e, "vpdpbusd xmm0, xmm1, xmm2", "62 f2 75 08 50 c2")
	e = x64SrcHex(e, "vpdpbusd ymm0, ymm1, ymm2", "62 f2 75 28 50 c2")
	e = x64LineErrorHas(e, "vcvtneps2bf16 xmm0, xmm1", "takes {vex} here")
	e = x64SrcHex(e, "vpmadd52luq xmm0, xmm1, xmm2", "62 f2 f5 08 b4 c2")
	e = x64SrcHex(e, "{vex} vpdpbssd xmm0, xmm1, xmm2", "c4 e2 73 50 c2")
	e = x64SrcHex(e, "vpdpbssd xmm0, xmm1, xmm2", "c4 e2 73 50 c2")
	return e
}
