package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// FMA3 and AVX's extensions (x64_avx.bn) against clang's bytes (`clang --target=x86_64-linux-gnu
// -c`, `.intel_syntax noprefix`): a line for each form of the table's FMA and extensions' parts,
// with registers 8..15 and memory with a base of r10 where the form takes them, after {vex} those
// clang encodes otherwise as EVEX; the encodings in full are package avx's tests.  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// The FMA part.
func TestX64AvxFma() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vfmadd132ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 98 0a")
	e = x64SrcHex(e, "vfmadd132ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 98 12")
	e = x64SrcHex(e, "vfmadd132pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 98 0a")
	e = x64SrcHex(e, "vfmadd132pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d 98 12")
	e = x64SrcHex(e, "vfmadd132ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 99 0a")
	e = x64SrcHex(e, "vfmadd132sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 99 0a")
	e = x64SrcHex(e, "vfmadd213ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 a8 0a")
	e = x64SrcHex(e, "vfmadd213ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d a8 12")
	e = x64SrcHex(e, "vfmadd213pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 a8 0a")
	e = x64SrcHex(e, "vfmadd213pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d a8 12")
	e = x64SrcHex(e, "vfmadd213ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 a9 0a")
	e = x64SrcHex(e, "vfmadd213sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 a9 0a")
	e = x64SrcHex(e, "vfmadd231ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 b8 0a")
	e = x64SrcHex(e, "vfmadd231ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d b8 12")
	e = x64SrcHex(e, "vfmadd231pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 b8 0a")
	e = x64SrcHex(e, "vfmadd231pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d b8 12")
	e = x64SrcHex(e, "vfmadd231ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 b9 0a")
	e = x64SrcHex(e, "vfmadd231sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 b9 0a")
	e = x64SrcHex(e, "vfmsub132ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 9a 0a")
	e = x64SrcHex(e, "vfmsub132ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 9a 12")
	e = x64SrcHex(e, "vfmsub132pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 9a 0a")
	e = x64SrcHex(e, "vfmsub132pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d 9a 12")
	e = x64SrcHex(e, "vfmsub132ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 9b 0a")
	e = x64SrcHex(e, "vfmsub132sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 9b 0a")
	e = x64SrcHex(e, "vfmsub213ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 aa 0a")
	e = x64SrcHex(e, "vfmsub213ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d aa 12")
	e = x64SrcHex(e, "vfmsub213pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 aa 0a")
	e = x64SrcHex(e, "vfmsub213pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d aa 12")
	e = x64SrcHex(e, "vfmsub213ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 ab 0a")
	e = x64SrcHex(e, "vfmsub213sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 ab 0a")
	e = x64SrcHex(e, "vfmsub231ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 ba 0a")
	e = x64SrcHex(e, "vfmsub231ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d ba 12")
	e = x64SrcHex(e, "vfmsub231pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 ba 0a")
	e = x64SrcHex(e, "vfmsub231pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d ba 12")
	e = x64SrcHex(e, "vfmsub231ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 bb 0a")
	e = x64SrcHex(e, "vfmsub231sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 bb 0a")
	e = x64SrcHex(e, "vfnmadd132ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 9c 0a")
	e = x64SrcHex(e, "vfnmadd132ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 9c 12")
	e = x64SrcHex(e, "vfnmadd132pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 9c 0a")
	e = x64SrcHex(e, "vfnmadd132pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d 9c 12")
	e = x64SrcHex(e, "vfnmadd132ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 9d 0a")
	e = x64SrcHex(e, "vfnmadd132sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 9d 0a")
	e = x64SrcHex(e, "vfnmadd213ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 ac 0a")
	e = x64SrcHex(e, "vfnmadd213ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d ac 12")
	e = x64SrcHex(e, "vfnmadd213pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 ac 0a")
	e = x64SrcHex(e, "vfnmadd213pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d ac 12")
	e = x64SrcHex(e, "vfnmadd213ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 ad 0a")
	e = x64SrcHex(e, "vfnmadd213sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 ad 0a")
	e = x64SrcHex(e, "vfnmadd231ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 bc 0a")
	e = x64SrcHex(e, "vfnmadd231ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d bc 12")
	e = x64SrcHex(e, "vfnmadd231pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 bc 0a")
	e = x64SrcHex(e, "vfnmadd231pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d bc 12")
	e = x64SrcHex(e, "vfnmadd231ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 bd 0a")
	e = x64SrcHex(e, "vfnmadd231sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 bd 0a")
	e = x64SrcHex(e, "vfnmsub132ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 9e 0a")
	e = x64SrcHex(e, "vfnmsub132ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 9e 12")
	e = x64SrcHex(e, "vfnmsub132pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 9e 0a")
	e = x64SrcHex(e, "vfnmsub132pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d 9e 12")
	e = x64SrcHex(e, "vfnmsub132ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 9f 0a")
	e = x64SrcHex(e, "vfnmsub132sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 9f 0a")
	e = x64SrcHex(e, "vfnmsub213ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 ae 0a")
	e = x64SrcHex(e, "vfnmsub213ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d ae 12")
	e = x64SrcHex(e, "vfnmsub213pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 ae 0a")
	e = x64SrcHex(e, "vfnmsub213pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d ae 12")
	e = x64SrcHex(e, "vfnmsub213ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 af 0a")
	e = x64SrcHex(e, "vfnmsub213sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 af 0a")
	e = x64SrcHex(e, "vfnmsub231ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 be 0a")
	e = x64SrcHex(e, "vfnmsub231ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d be 12")
	e = x64SrcHex(e, "vfnmsub231pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 be 0a")
	e = x64SrcHex(e, "vfnmsub231pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d be 12")
	e = x64SrcHex(e, "vfnmsub231ss xmm9, xmm11, dword ptr [r10]", "c4 42 21 bf 0a")
	e = x64SrcHex(e, "vfnmsub231sd xmm9, xmm11, qword ptr [r10]", "c4 42 a1 bf 0a")
	e = x64SrcHex(e, "vfmaddsub132ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 96 0a")
	e = x64SrcHex(e, "vfmaddsub132ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 96 12")
	e = x64SrcHex(e, "vfmaddsub132pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 96 0a")
	e = x64SrcHex(e, "vfmaddsub132pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d 96 12")
	e = x64SrcHex(e, "vfmaddsub213ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 a6 0a")
	e = x64SrcHex(e, "vfmaddsub213ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d a6 12")
	e = x64SrcHex(e, "vfmaddsub213pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 a6 0a")
	e = x64SrcHex(e, "vfmaddsub213pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d a6 12")
	e = x64SrcHex(e, "vfmaddsub231ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 b6 0a")
	e = x64SrcHex(e, "vfmaddsub231ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d b6 12")
	e = x64SrcHex(e, "vfmaddsub231pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 b6 0a")
	e = x64SrcHex(e, "vfmaddsub231pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d b6 12")
	e = x64SrcHex(e, "vfmsubadd132ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 97 0a")
	e = x64SrcHex(e, "vfmsubadd132ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 97 12")
	e = x64SrcHex(e, "vfmsubadd132pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 97 0a")
	e = x64SrcHex(e, "vfmsubadd132pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d 97 12")
	e = x64SrcHex(e, "vfmsubadd213ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 a7 0a")
	e = x64SrcHex(e, "vfmsubadd213ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d a7 12")
	e = x64SrcHex(e, "vfmsubadd213pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 a7 0a")
	e = x64SrcHex(e, "vfmsubadd213pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d a7 12")
	e = x64SrcHex(e, "vfmsubadd231ps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 b7 0a")
	e = x64SrcHex(e, "vfmsubadd231ps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d b7 12")
	e = x64SrcHex(e, "vfmsubadd231pd xmm9, xmm11, xmmword ptr [r10]", "c4 42 a1 b7 0a")
	e = x64SrcHex(e, "vfmsubadd231pd ymm10, ymm12, ymmword ptr [r10]", "c4 42 9d b7 12")
	return e
}

// The extensions' part.
func TestX64AvxExt() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vcvtph2ps xmm9, qword ptr [r10]", "c4 42 79 13 0a")
	e = x64SrcHex(e, "vcvtph2ps ymm10, xmmword ptr [r10]", "c4 42 7d 13 12")
	e = x64SrcHex(e, "vcvtps2ph qword ptr [r10], xmm11, 1", "c4 43 79 1d 1a 01")
	e = x64SrcHex(e, "vcvtps2ph xmmword ptr [r10], ymm12, 1", "c4 43 7d 1d 22 01")
	e = x64SrcHex(e, "vaesenc xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 dc 0a")
	e = x64SrcHex(e, "vaesenc ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d dc 12")
	e = x64SrcHex(e, "vaesenclast xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 dd 0a")
	e = x64SrcHex(e, "vaesenclast ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d dd 12")
	e = x64SrcHex(e, "vaesdec xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 de 0a")
	e = x64SrcHex(e, "vaesdec ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d de 12")
	e = x64SrcHex(e, "vaesdeclast xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 df 0a")
	e = x64SrcHex(e, "vaesdeclast ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d df 12")
	e = x64SrcHex(e, "vaesimc xmm9, xmmword ptr [r10]", "c4 42 79 db 0a")
	e = x64SrcHex(e, "vaeskeygenassist xmm9, xmmword ptr [r10], 1", "c4 43 79 df 0a 01")
	e = x64SrcHex(e, "vpclmulqdq xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 44 0a 01")
	e = x64SrcHex(e, "vpclmulqdq ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 44 12 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 a1 cf 0a 01")
	e = x64SrcHex(e, "vgf2p8affineinvqb ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 9d cf 12 01")
	e = x64SrcHex(e, "vgf2p8affineqb xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 a1 ce 0a 01")
	e = x64SrcHex(e, "vgf2p8affineqb ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 9d ce 12 01")
	e = x64SrcHex(e, "vgf2p8mulb xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 cf 0a")
	e = x64SrcHex(e, "vgf2p8mulb ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d cf 12")
	e = x64SrcHex(e, "vsha512msg1 ymm10, xmm11", "c4 42 7f cc d3")
	e = x64SrcHex(e, "vsha512msg2 ymm10, ymm12", "c4 42 7f cd d4")
	e = x64SrcHex(e, "vsha512rnds2 ymm10, ymm12, xmm13", "c4 42 1f cb d5")
	e = x64SrcHex(e, "vsm3msg1 xmm9, xmm11, xmmword ptr [r10]", "c4 42 20 da 0a")
	e = x64SrcHex(e, "vsm3msg2 xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 da 0a")
	e = x64SrcHex(e, "vsm3rnds2 xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 de 0a 01")
	e = x64SrcHex(e, "vsm4key4 xmm9, xmm11, xmmword ptr [r10]", "c4 42 22 da 0a")
	e = x64SrcHex(e, "vsm4key4 ymm10, ymm12, ymmword ptr [r10]", "c4 42 1e da 12")
	e = x64SrcHex(e, "vsm4rnds4 xmm9, xmm11, xmmword ptr [r10]", "c4 42 23 da 0a")
