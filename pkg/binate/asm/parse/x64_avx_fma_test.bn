	e = x64SrcHex(e, "vbcstnebf162ps xmm9, word ptr [r10]", "c4 42 7a b1 0a")
	e = x64SrcHex(e, "vbcstnebf162ps ymm10, word ptr [r10]", "c4 42 7e b1 12")
	e = x64SrcHex(e, "vbcstnesh2ps xmm9, word ptr [r10]", "c4 42 79 b1 0a")
	e = x64SrcHex(e, "vbcstnesh2ps ymm10, word ptr [r10]", "c4 42 7d b1 12")
	e = x64SrcHex(e, "vcvtneebf162ps xmm9, xmmword ptr [r10]", "c4 42 7a b0 0a")
	e = x64SrcHex(e, "vcvtneebf162ps ymm10, ymmword ptr [r10]", "c4 42 7e b0 12")
	e = x64SrcHex(e, "vcvtneeph2ps xmm9, xmmword ptr [r10]", "c4 42 79 b0 0a")
