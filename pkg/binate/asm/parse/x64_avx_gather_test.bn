package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The gathers (x64_avx.bn) and their memory operands with a vector index (x64_mem.bn) against
// clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): the index
// written first or second, scaled either way or not, with no base, RSP, RBP, R12 or R13 as the
// base, XMM4 (SIB index 4), registers 8..15, an element's size written or none, a segment, a
// symbol as the displacement; each gather's forms.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn, x64TlsCase in x64_tls_test.bn.)
func TestX64AvxGather() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm2*4], xmm3", "c4 e2 61 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm2], xmm3", "c4 e2 61 92 0c 10")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm2*4 + rax], xmm3", "c4 e2 61 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm2 + rax], xmm3", "c4 e2 61 92 0c 10")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + 4*xmm2], xmm3", "c4 e2 61 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm2*4], xmm3", "c4 e2 61 92 0c 95 00 00 00 00")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm2], xmm3", "c4 e2 61 92 0c 15 00 00 00 00")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm2*4 + 16], xmm3", "c4 e2 61 92 0c 95 10 00 00 00")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm2*4 + 8], xmm3", "c4 e2 61 92 4c 90 08")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm2*4 + 128], xmm3", "c4 e2 61 92 8c 90 80 00 00 00")
	e = x64SrcHex(e, "vgatherdps xmm1, [rsp + xmm2*4], xmm3", "c4 e2 61 92 0c 94")
	e = x64SrcHex(e, "vgatherdps xmm1, [rbp + xmm2*4], xmm3", "c4 e2 61 92 4c 95 00")
	e = x64SrcHex(e, "vgatherdps xmm1, [r13 + xmm2*4], xmm3", "c4 c2 61 92 4c 95 00")
	e = x64SrcHex(e, "vgatherdps xmm1, [r12 + xmm12*8], xmm3", "c4 82 61 92 0c e4")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm4*4], xmm3", "c4 e2 61 92 0c a0")
	e = x64SrcHex(e, "vgatherdps xmm9, [r9 + xmm10*2], xmm11", "c4 02 21 92 0c 51")
	e = x64SrcHex(e, "vgatherdps xmm1, dword ptr [rax + xmm2*4], xmm3", "c4 e2 61 92 0c 90")
	e = x64SrcHex(e, "vgatherdps ymm1, [rax + ymm2*4], ymm3", "c4 e2 65 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm1, fs:[rax + xmm2*4], xmm3", "64 c4 e2 61 92 0c 90")
	e = x64SrcHex(e, "vgatherdpd ymm1, [rax + xmm2*8], ymm3", "c4 e2 e5 92 0c d0")
	e = x64SrcHex(e, "vgatherdpd ymm1, qword ptr [rax + xmm2*8], ymm3", "c4 e2 e5 92 0c d0")
	e = x64SrcHex(e, "vgatherqps xmm1, [rax + ymm2*4], xmm3", "c4 e2 65 93 0c 90")
	e = x64SrcHex(e, "vgatherqps xmm1, [rax + xmm2*4], xmm3", "c4 e2 61 93 0c 90")
	e = x64SrcHex(e, "vpgatherqq ymm1, [rax + ymm2*8], ymm3", "c4 e2 e5 91 0c d0")
	e = x64SrcHex(e, "{disp32} vgatherdps xmm1, [rax + xmm2*4], xmm3", "c4 e2 61 92 8c 90 00 00 00 00")
	e = x64SrcHex(e, "vgatherdps xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 19 92 4c 9a 08")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm2*8], xmm3", "c4 e2 61 92 0c d0")
	e = x64SrcHex(e, "vgatherdps ymm9, dword ptr [r10 + ymm11*4 + 8], ymm12", "c4 02 1d 92 4c 9a 08")
	e = x64SrcHex(e, "vgatherdps ymm1, [rax + ymm2*8], ymm3", "c4 e2 65 92 0c d0")
	e = x64SrcHex(e, "vgatherdpd xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 99 92 4c 9a 08")
	e = x64SrcHex(e, "vgatherdpd xmm1, [rax + xmm2*8], xmm3", "c4 e2 e1 92 0c d0")
	e = x64SrcHex(e, "vgatherdpd ymm9, qword ptr [r10 + xmm11*4 + 8], ymm12", "c4 02 9d 92 4c 9a 08")
	e = x64SrcHex(e, "vgatherdpd ymm1, [rax + xmm2*8], ymm3", "c4 e2 e5 92 0c d0")
	e = x64SrcHex(e, "vgatherqps xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 19 93 4c 9a 08")
	e = x64SrcHex(e, "vgatherqps xmm1, [rax + xmm2*8], xmm3", "c4 e2 61 93 0c d0")
	e = x64SrcHex(e, "vgatherqps xmm9, dword ptr [r10 + ymm11*4 + 8], xmm12", "c4 02 1d 93 4c 9a 08")
	e = x64SrcHex(e, "vgatherqps xmm1, [rax + ymm2*8], xmm3", "c4 e2 65 93 0c d0")
	e = x64SrcHex(e, "vgatherqpd xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 99 93 4c 9a 08")
	e = x64SrcHex(e, "vgatherqpd xmm1, [rax + xmm2*8], xmm3", "c4 e2 e1 93 0c d0")
	e = x64SrcHex(e, "vgatherqpd ymm9, qword ptr [r10 + ymm11*4 + 8], ymm12", "c4 02 9d 93 4c 9a 08")
	e = x64SrcHex(e, "vgatherqpd ymm1, [rax + ymm2*8], ymm3", "c4 e2 e5 93 0c d0")
	e = x64SrcHex(e, "vpgatherdd xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 19 90 4c 9a 08")
	e = x64SrcHex(e, "vpgatherdd xmm1, [rax + xmm2*8], xmm3", "c4 e2 61 90 0c d0")
	e = x64SrcHex(e, "vpgatherdd ymm9, dword ptr [r10 + ymm11*4 + 8], ymm12", "c4 02 1d 90 4c 9a 08")
	e = x64SrcHex(e, "vpgatherdd ymm1, [rax + ymm2*8], ymm3", "c4 e2 65 90 0c d0")
	e = x64SrcHex(e, "vpgatherdq xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 99 90 4c 9a 08")
	e = x64SrcHex(e, "vpgatherdq xmm1, [rax + xmm2*8], xmm3", "c4 e2 e1 90 0c d0")
	e = x64SrcHex(e, "vpgatherdq ymm9, qword ptr [r10 + xmm11*4 + 8], ymm12", "c4 02 9d 90 4c 9a 08")
	e = x64SrcHex(e, "vpgatherdq ymm1, [rax + xmm2*8], ymm3", "c4 e2 e5 90 0c d0")
	e = x64SrcHex(e, "vpgatherqd xmm9, dword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 19 91 4c 9a 08")
	e = x64SrcHex(e, "vpgatherqd xmm1, [rax + xmm2*8], xmm3", "c4 e2 61 91 0c d0")
	e = x64SrcHex(e, "vpgatherqd xmm9, dword ptr [r10 + ymm11*4 + 8], xmm12", "c4 02 1d 91 4c 9a 08")
	e = x64SrcHex(e, "vpgatherqd xmm1, [rax + ymm2*8], xmm3", "c4 e2 65 91 0c d0")
	e = x64SrcHex(e, "vpgatherqq xmm9, qword ptr [r10 + xmm11*4 + 8], xmm12", "c4 02 99 91 4c 9a 08")
	e = x64SrcHex(e, "vpgatherqq xmm1, [rax + xmm2*8], xmm3", "c4 e2 e1 91 0c d0")
	e = x64SrcHex(e, "vpgatherqq ymm9, qword ptr [r10 + ymm11*4 + 8], ymm12", "c4 02 9d 91 4c 9a 08")
	e = x64SrcHex(e, "vpgatherqq ymm1, [rax + ymm2*8], ymm3", "c4 e2 e5 91 0c d0")
	e = x64SrcHex(e, "vgatherdps xmm1, 8[rax + xmm2*4], xmm3", "c4 e2 61 92 4c 90 08")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax][xmm2*4], xmm3", "c4 e2 61 92 0c 90")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm2*4][rax + 8], xmm3", "c4 e2 61 92 4c 90 08")
	e = x64SrcHex(e, "vgatherdps xmm1, [rax + xmm4], xmm3", "c4 e2 61 92 0c 20")
	e = x64SrcHex(e, "vgatherdps xmm1, [xmm4 + rsp], xmm3", "c4 e2 61 92 0c 24")
	e = x64TlsCase(e, "vgatherdps xmm1, fs:[rax + xmm2*4 + x@TPOFF], xmm3",
			"64 c4 e2 61 92 8c 90 00 00 00 00", x64.FIX_TPOFF32, 7, 0)
	e = x64TlsCase(e, "vgatherdps xmm1, [x + xmm2*4], xmm3", "c4 e2 61 92 0c 95 00 00 00 00",
			x64.FIX_ABS32S, 6, 0)
	e = x64TlsCase(e, "vgatherdps xmm1, [rax + xmm2*4 + x], xmm3", "c4 e2 61 92 8c 90 00 00 00 00",
			x64.FIX_ABS32S, 6, 0)
	return e
}

// What clang or GNU as rejects: a general index or none, an element's size other than the form's,
// an index of the other width, a scale of 3, two vector registers, a vector index beside rip (clang
// reads it as no base); 32-bit addressing (this assembler's own limit; both take it); destination,
// index and mask registers alike (#UD: clang
// and GNU as warn); a vector index outside a gather (clang encodes the general register of its
// number, GNU as rejects it).
func TestX64AvxGatherRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "vgatherdps xmm1, [rip + xmm2*4], xmm3", "rip takes no vector index")
	e = x64LineRejected(e, "vgatherdps xmm1, [rax + rbx*4], xmm3")
	e = x64LineRejected(e, "vgatherdps xmm1, [rax], xmm3")
	e = x64LineRejected(e, "vgatherdps xmm1, qword ptr [rax + xmm2*4], xmm3")
	e = x64LineRejected(e, "vgatherdps xmm1, xmmword ptr [rax + xmm2*4], xmm3")
	e = x64LineRejected(e, "vgatherdps xmm1, [rax + ymm2*4], xmm3")
	e = x64LineRejected(e, "vgatherdps ymm1, [rax + xmm2*4], ymm3")
	e = x64LineRejected(e, "vgatherdps xmm1, [rax + xmm2*3], xmm3")
	e = x64LineRejected(e, "vgatherdps xmm1, [xmm2 + xmm3], xmm4")
	e = x64LineRejected(e, "vgatherdps xmm1, [eax + xmm2*4], xmm3")
	e = x64LineErrorHas(e, "vpgatherdd xmm1, [rax + xmm2*4], xmm1",
			"takes destination, index and mask registers that all differ")
	e = x64LineErrorHas(e, "vpgatherdd xmm1, [rax + xmm1*4], xmm3",
			"takes destination, index and mask registers that all differ")
	e = x64LineErrorHas(e, "vpgatherdd xmm1, [rax + xmm2*4], xmm2",
			"takes destination, index and mask registers that all differ")
	e = x64LineRejected(e, "mov eax, [rax + xmm2*4]")
	e = x64LineRejected(e, "vaddps xmm0, xmm1, [rax + xmm2*4]")
	e = x64LineRejected(e, "addps xmm0, [rax + xmm2*4]")
	e = x64LineErrorHas(e, "vgatherqps xmm1, [rax + ymm1*4], xmm2", "registers that all differ")
	e = x64LineErrorHas(e, "vmovaps xmm1, [rax + xmm2*4]",
			"takes no memory operand with a vector index")
	return e
}
