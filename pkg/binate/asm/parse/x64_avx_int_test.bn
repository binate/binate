	e = x64SrcHex(e, "vpandn ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d df 12")
	e = x64SrcHex(e, "vpblendvb xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 4c 0a f0")
	e = x64SrcHex(e, "vpblendvb ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 4c 12 80")
	e = x64SrcHex(e, "vpblendw xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 0e 0a 01")
	e = x64SrcHex(e, "vpblendw ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 0e 12 01")
