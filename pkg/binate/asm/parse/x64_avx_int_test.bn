package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The VEX-encoded integer instructions (x64_avx.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form of the table's
// integer parts but those clang swaps operands into (x64_avx_choice_test.bn's), with registers
// 8..15 and memory with a base of r10 where the form takes them; the encodings in full are package
// avx's tests.  (x64SrcHex is in x64_target_test.bn.)

// The integer arithmetic part.
func TestX64AvxInt() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vmpsadbw xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 42 0a 01")
	e = x64SrcHex(e, "vmpsadbw ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 42 12 01")
	e = x64SrcHex(e, "vpabsb xmm9, xmmword ptr [r10]", "c4 42 79 1c 0a")
	e = x64SrcHex(e, "vpabsb ymm10, ymmword ptr [r10]", "c4 42 7d 1c 12")
	e = x64SrcHex(e, "vpabsd xmm9, xmmword ptr [r10]", "c4 42 79 1e 0a")
	e = x64SrcHex(e, "vpabsd ymm10, ymmword ptr [r10]", "c4 42 7d 1e 12")
	e = x64SrcHex(e, "vpabsw xmm9, xmmword ptr [r10]", "c4 42 79 1d 0a")
	e = x64SrcHex(e, "vpabsw ymm10, ymmword ptr [r10]", "c4 42 7d 1d 12")
	e = x64SrcHex(e, "vpaddb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 fc 0a")
	e = x64SrcHex(e, "vpaddb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d fc 12")
	e = x64SrcHex(e, "vpaddd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 fe 0a")
	e = x64SrcHex(e, "vpaddd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d fe 12")
	e = x64SrcHex(e, "vpaddq xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 d4 0a")
	e = x64SrcHex(e, "vpaddq ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d d4 12")
	e = x64SrcHex(e, "vpaddsb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 ec 0a")
	e = x64SrcHex(e, "vpaddsb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d ec 12")
	e = x64SrcHex(e, "vpaddsw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 ed 0a")
	e = x64SrcHex(e, "vpaddsw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d ed 12")
	e = x64SrcHex(e, "vpaddusb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 dc 0a")
	e = x64SrcHex(e, "vpaddusb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d dc 12")
	e = x64SrcHex(e, "vpaddusw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 dd 0a")
	e = x64SrcHex(e, "vpaddusw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d dd 12")
	e = x64SrcHex(e, "vpaddw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 fd 0a")
	e = x64SrcHex(e, "vpaddw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d fd 12")
	e = x64SrcHex(e, "vpavgb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 e0 0a")
	e = x64SrcHex(e, "vpavgb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d e0 12")
	e = x64SrcHex(e, "vpavgw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 e3 0a")
	e = x64SrcHex(e, "vpavgw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d e3 12")
	e = x64SrcHex(e, "vphaddd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 02 0a")
	e = x64SrcHex(e, "vphaddd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 02 12")
	e = x64SrcHex(e, "vphaddsw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 03 0a")
	e = x64SrcHex(e, "vphaddsw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 03 12")
	e = x64SrcHex(e, "vphaddw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 01 0a")
	e = x64SrcHex(e, "vphaddw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 01 12")
	e = x64SrcHex(e, "vphsubd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 06 0a")
	e = x64SrcHex(e, "vphsubd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 06 12")
	e = x64SrcHex(e, "vphsubsw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 07 0a")
	e = x64SrcHex(e, "vphsubsw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 07 12")
	e = x64SrcHex(e, "vphsubw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 05 0a")
	e = x64SrcHex(e, "vphsubw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 05 12")
	e = x64SrcHex(e, "vpmaddubsw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 04 0a")
	e = x64SrcHex(e, "vpmaddubsw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 04 12")
	e = x64SrcHex(e, "vpmaddwd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 f5 0a")
	e = x64SrcHex(e, "vpmaddwd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d f5 12")
	e = x64SrcHex(e, "vpmaxsb xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 3c 0a")
	e = x64SrcHex(e, "vpmaxsb ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 3c 12")
	e = x64SrcHex(e, "vpmaxsd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 3d 0a")
	e = x64SrcHex(e, "vpmaxsd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 3d 12")
	e = x64SrcHex(e, "vpmaxsw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 ee 0a")
	e = x64SrcHex(e, "vpmaxsw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d ee 12")
	e = x64SrcHex(e, "vpmaxub xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 de 0a")
	e = x64SrcHex(e, "vpmaxub ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d de 12")
	e = x64SrcHex(e, "vpmaxud xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 3f 0a")
	e = x64SrcHex(e, "vpmaxud ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 3f 12")
	e = x64SrcHex(e, "vpmaxuw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 3e 0a")
	e = x64SrcHex(e, "vpmaxuw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 3e 12")
	e = x64SrcHex(e, "vpminsb xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 38 0a")
	e = x64SrcHex(e, "vpminsb ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 38 12")
	e = x64SrcHex(e, "vpminsd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 39 0a")
	e = x64SrcHex(e, "vpminsd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 39 12")
	e = x64SrcHex(e, "vpminsw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 ea 0a")
	e = x64SrcHex(e, "vpminsw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d ea 12")
	e = x64SrcHex(e, "vpminub xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 da 0a")
	e = x64SrcHex(e, "vpminub ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d da 12")
	e = x64SrcHex(e, "vpminud xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 3b 0a")
	e = x64SrcHex(e, "vpminud ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 3b 12")
	e = x64SrcHex(e, "vpminuw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 3a 0a")
	e = x64SrcHex(e, "vpminuw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 3a 12")
	e = x64SrcHex(e, "vpmuldq xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 28 0a")
	e = x64SrcHex(e, "vpmuldq ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 28 12")
	e = x64SrcHex(e, "vpmulhrsw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 0b 0a")
	e = x64SrcHex(e, "vpmulhrsw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 0b 12")
	e = x64SrcHex(e, "vpmulhuw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 e4 0a")
	e = x64SrcHex(e, "vpmulhuw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d e4 12")
	e = x64SrcHex(e, "vpmulhw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 e5 0a")
	e = x64SrcHex(e, "vpmulhw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d e5 12")
	e = x64SrcHex(e, "vpmulld xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 40 0a")
	e = x64SrcHex(e, "vpmulld ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 40 12")
	e = x64SrcHex(e, "vpmullw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 d5 0a")
	e = x64SrcHex(e, "vpmullw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d d5 12")
	e = x64SrcHex(e, "vpmuludq xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 f4 0a")
	e = x64SrcHex(e, "vpmuludq ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d f4 12")
	e = x64SrcHex(e, "vpsadbw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 f6 0a")
	e = x64SrcHex(e, "vpsadbw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d f6 12")
	e = x64SrcHex(e, "vpsignb xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 08 0a")
	e = x64SrcHex(e, "vpsignb ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 08 12")
	e = x64SrcHex(e, "vpsignd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 0a 0a")
	e = x64SrcHex(e, "vpsignd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 0a 12")
	e = x64SrcHex(e, "vpsignw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 09 0a")
	e = x64SrcHex(e, "vpsignw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 09 12")
	e = x64SrcHex(e, "vpsubb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 f8 0a")
	e = x64SrcHex(e, "vpsubb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d f8 12")
	e = x64SrcHex(e, "vpsubd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 fa 0a")
	e = x64SrcHex(e, "vpsubd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d fa 12")
	e = x64SrcHex(e, "vpsubq xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 fb 0a")
	e = x64SrcHex(e, "vpsubq ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d fb 12")
	e = x64SrcHex(e, "vpsubsb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 e8 0a")
	e = x64SrcHex(e, "vpsubsb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d e8 12")
	e = x64SrcHex(e, "vpsubsw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 e9 0a")
	e = x64SrcHex(e, "vpsubsw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d e9 12")
	e = x64SrcHex(e, "vpsubusb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 d8 0a")
	e = x64SrcHex(e, "vpsubusb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d d8 12")
	e = x64SrcHex(e, "vpsubusw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 d9 0a")
	e = x64SrcHex(e, "vpsubusw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d d9 12")
	e = x64SrcHex(e, "vpsubw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 f9 0a")
	e = x64SrcHex(e, "vpsubw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d f9 12")
	e = x64SrcHex(e, "vphminposuw xmm9, xmmword ptr [r10]", "c4 42 79 41 0a")
	return e
}

// The integer logic part.
func TestX64AvxIntLogic() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vpackssdw xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 6b 0a")
	e = x64SrcHex(e, "vpackssdw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 6b 12")
	e = x64SrcHex(e, "vpacksswb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 63 0a")
	e = x64SrcHex(e, "vpacksswb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 63 12")
	e = x64SrcHex(e, "vpackusdw xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 2b 0a")
	e = x64SrcHex(e, "vpackusdw ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 2b 12")
	e = x64SrcHex(e, "vpackuswb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 67 0a")
	e = x64SrcHex(e, "vpackuswb ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 67 12")
	e = x64SrcHex(e, "vpalignr xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 0f 0a 01")
	e = x64SrcHex(e, "vpalignr ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 0f 12 01")
	e = x64SrcHex(e, "vpand xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 db 0a")
	e = x64SrcHex(e, "vpand ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d db 12")
