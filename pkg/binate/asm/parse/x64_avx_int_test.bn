	e = x64SrcHex(e, "vpcmpeqw ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 75 12")
	e = x64SrcHex(e, "vpcmpgtb xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 64 0a")
