package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The VEX-encoded floating-point moves, shuffles and AVX's own instructions (x64_avx.bn) against
// clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each
// form of the table's moves part, with registers 8..15 and memory with a base of r8..r15 where
// the form takes them.  (x64SrcHex is in x64_target_test.bn.)
func TestX64AvxMove() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vmovaps xmm9, xmmword ptr [r10]", "c4 41 78 28 0a")
	e = x64SrcHex(e, "vmovaps ymm10, ymmword ptr [r10]", "c4 41 7c 28 12")
	e = x64SrcHex(e, "vmovaps xmmword ptr [r10], xmm11", "c4 41 78 29 1a")
	e = x64SrcHex(e, "vmovaps ymmword ptr [r10], ymm12", "c4 41 7c 29 22")
	e = x64SrcHex(e, "vmovapd xmm9, xmmword ptr [r10]", "c4 41 79 28 0a")
	e = x64SrcHex(e, "vmovapd ymm10, ymmword ptr [r10]", "c4 41 7d 28 12")
	e = x64SrcHex(e, "vmovapd xmmword ptr [r10], xmm11", "c4 41 79 29 1a")
	e = x64SrcHex(e, "vmovapd ymmword ptr [r10], ymm12", "c4 41 7d 29 22")
	e = x64SrcHex(e, "vmovups xmm9, xmmword ptr [r10]", "c4 41 78 10 0a")
	e = x64SrcHex(e, "vmovups ymm10, ymmword ptr [r10]", "c4 41 7c 10 12")
	e = x64SrcHex(e, "vmovups xmmword ptr [r10], xmm11", "c4 41 78 11 1a")
	e = x64SrcHex(e, "vmovups ymmword ptr [r10], ymm12", "c4 41 7c 11 22")
	e = x64SrcHex(e, "vmovupd xmm9, xmmword ptr [r10]", "c4 41 79 10 0a")
	e = x64SrcHex(e, "vmovupd ymm10, ymmword ptr [r10]", "c4 41 7d 10 12")
	e = x64SrcHex(e, "vmovupd xmmword ptr [r10], xmm11", "c4 41 79 11 1a")
	e = x64SrcHex(e, "vmovupd ymmword ptr [r10], ymm12", "c4 41 7d 11 22")
	e = x64SrcHex(e, "vmovss xmm9, dword ptr [r10]", "c4 41 7a 10 0a")
	e = x64SrcHex(e, "vmovss dword ptr [r10], xmm11", "c4 41 7a 11 1a")
	e = x64SrcHex(e, "vmovss xmm9, xmm11, xmm13", "c4 41 22 10 cd")
	e = x64SrcHex(e, "vmovsd xmm9, qword ptr [r10]", "c4 41 7b 10 0a")
	e = x64SrcHex(e, "vmovsd qword ptr [r10], xmm11", "c4 41 7b 11 1a")
	e = x64SrcHex(e, "vmovsd xmm9, xmm11, xmm13", "c4 41 23 10 cd")
	e = x64SrcHex(e, "vmovlps qword ptr [r10], xmm11", "c4 41 78 13 1a")
	e = x64SrcHex(e, "vmovlps xmm9, xmm11, qword ptr [r10]", "c4 41 20 12 0a")
	e = x64SrcHex(e, "vmovhps qword ptr [r10], xmm11", "c4 41 78 17 1a")
	e = x64SrcHex(e, "vmovhps xmm9, xmm11, qword ptr [r10]", "c4 41 20 16 0a")
	e = x64SrcHex(e, "vmovlpd qword ptr [r10], xmm11", "c4 41 79 13 1a")
	e = x64SrcHex(e, "vmovlpd xmm9, xmm11, qword ptr [r10]", "c4 41 21 12 0a")
	e = x64SrcHex(e, "vmovhpd qword ptr [r10], xmm11", "c4 41 79 17 1a")
	e = x64SrcHex(e, "vmovhpd xmm9, xmm11, qword ptr [r10]", "c4 41 21 16 0a")
	e = x64SrcHex(e, "vmovhlps xmm9, xmm11, xmm13", "c4 41 20 12 cd")
	e = x64SrcHex(e, "vmovlhps xmm9, xmm11, xmm13", "c4 41 20 16 cd")
	e = x64SrcHex(e, "vmovmskps r9d, xmm11", "c4 41 78 50 cb")
	e = x64SrcHex(e, "vmovmskps r9d, ymm12", "c4 41 7c 50 cc")
	e = x64SrcHex(e, "vmovmskpd r9d, xmm11", "c4 41 79 50 cb")
	e = x64SrcHex(e, "vmovmskpd r9d, ymm12", "c4 41 7d 50 cc")
	e = x64SrcHex(e, "vmovntps xmmword ptr [r10], xmm11", "c4 41 78 2b 1a")
	e = x64SrcHex(e, "vmovntps ymmword ptr [r10], ymm12", "c4 41 7c 2b 22")
	e = x64SrcHex(e, "vmovntpd xmmword ptr [r10], xmm11", "c4 41 79 2b 1a")
	e = x64SrcHex(e, "vmovntpd ymmword ptr [r10], ymm12", "c4 41 7d 2b 22")
	e = x64SrcHex(e, "vshufps xmm9, xmm11, xmmword ptr [r10], 1", "c4 41 20 c6 0a 01")
	e = x64SrcHex(e, "vshufps ymm10, ymm12, ymmword ptr [r10], 1", "c4 41 1c c6 12 01")
	e = x64SrcHex(e, "vshufpd xmm9, xmm11, xmmword ptr [r10], 1", "c4 41 21 c6 0a 01")
	e = x64SrcHex(e, "vshufpd ymm10, ymm12, ymmword ptr [r10], 1", "c4 41 1d c6 12 01")
	e = x64SrcHex(e, "vunpcklps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 14 0a")
	e = x64SrcHex(e, "vunpcklps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 14 12")
	e = x64SrcHex(e, "vunpckhps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 15 0a")
	e = x64SrcHex(e, "vunpckhps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 15 12")
	e = x64SrcHex(e, "vunpcklpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 14 0a")
	e = x64SrcHex(e, "vunpcklpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 14 12")
	e = x64SrcHex(e, "vunpckhpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 15 0a")
	e = x64SrcHex(e, "vunpckhpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 15 12")
	e = x64SrcHex(e, "vmovddup xmm9, qword ptr [r10]", "c4 41 7b 12 0a")
	e = x64SrcHex(e, "vmovddup ymm10, ymmword ptr [r10]", "c4 41 7f 12 12")
	e = x64SrcHex(e, "vmovshdup xmm9, xmmword ptr [r10]", "c4 41 7a 16 0a")
	e = x64SrcHex(e, "vmovshdup ymm10, ymmword ptr [r10]", "c4 41 7e 16 12")
	e = x64SrcHex(e, "vmovsldup xmm9, xmmword ptr [r10]", "c4 41 7a 12 0a")
	e = x64SrcHex(e, "vmovsldup ymm10, ymmword ptr [r10]", "c4 41 7e 12 12")
	e = x64SrcHex(e, "vblendps xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 0c 0a 01")
	e = x64SrcHex(e, "vblendps ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 0c 12 01")
	e = x64SrcHex(e, "vblendpd xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 0d 0a 01")
	e = x64SrcHex(e, "vblendpd ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 0d 12 01")
	e = x64SrcHex(e, "vblendvps xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 4a 0a f0")
	e = x64SrcHex(e, "vblendvps ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 4a 12 80")
	e = x64SrcHex(e, "vblendvpd xmm9, xmm11, xmmword ptr [r10], xmm15", "c4 43 21 4b 0a f0")
	e = x64SrcHex(e, "vblendvpd ymm10, ymm12, ymmword ptr [r10], ymm8", "c4 43 1d 4b 12 80")
	e = x64SrcHex(e, "vinsertps xmm9, xmm11, dword ptr [r10], 1", "c4 43 21 21 0a 01")
	e = x64SrcHex(e, "vextractps dword ptr [r10], xmm11, 1", "c4 43 79 17 1a 01")
	e = x64SrcHex(e, "vbroadcastss xmm9, dword ptr [r10]", "c4 42 79 18 0a")
	e = x64SrcHex(e, "vbroadcastss ymm10, dword ptr [r10]", "c4 42 7d 18 12")
	e = x64SrcHex(e, "vbroadcastsd ymm10, qword ptr [r10]", "c4 42 7d 19 12")
	e = x64SrcHex(e, "vbroadcastf128 ymm10, xmmword ptr [r10]", "c4 42 7d 1a 12")
	e = x64SrcHex(e, "vinsertf128 ymm10, ymm12, xmmword ptr [r10], 1", "c4 43 1d 18 12 01")
	e = x64SrcHex(e, "vextractf128 xmmword ptr [r10], ymm12, 1", "c4 43 7d 19 22 01")
	e = x64SrcHex(e, "vperm2f128 ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 06 12 01")
	e = x64SrcHex(e, "vpermilps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 0c 0a")
	e = x64SrcHex(e, "vpermilps xmm9, xmmword ptr [r10], 1", "c4 43 79 04 0a 01")
	e = x64SrcHex(e, "vpermilps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 0c 12")
	e = x64SrcHex(e, "vpermilps ymm10, ymmword ptr [r10], 1", "c4 43 7d 04 12 01")
	e = x64SrcHex(e, "vpermilpd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 0d 0a")
	e = x64SrcHex(e, "vpermilpd xmm9, xmmword ptr [r10], 1", "c4 43 79 05 0a 01")
	e = x64SrcHex(e, "vpermilpd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 0d 12")
	e = x64SrcHex(e, "vpermilpd ymm10, ymmword ptr [r10], 1", "c4 43 7d 05 12 01")
	e = x64SrcHex(e, "vmaskmovps xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 2c 0a")
	e = x64SrcHex(e, "vmaskmovps ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 2c 12")
	e = x64SrcHex(e, "vmaskmovps xmmword ptr [r10], xmm11, xmm13", "c4 42 21 2e 2a")
	e = x64SrcHex(e, "vmaskmovps ymmword ptr [r10], ymm12, ymm14", "c4 42 1d 2e 32")
	e = x64SrcHex(e, "vmaskmovpd xmm9, xmm11, xmmword ptr [r10]", "c4 42 21 2d 0a")
	e = x64SrcHex(e, "vmaskmovpd ymm10, ymm12, ymmword ptr [r10]", "c4 42 1d 2d 12")
	e = x64SrcHex(e, "vmaskmovpd xmmword ptr [r10], xmm11, xmm13", "c4 42 21 2f 2a")
	e = x64SrcHex(e, "vmaskmovpd ymmword ptr [r10], ymm12, ymm14", "c4 42 1d 2f 32")
	e = x64SrcHex(e, "vtestps xmm9, xmmword ptr [r10]", "c4 42 79 0e 0a")
	e = x64SrcHex(e, "vtestps ymm10, ymmword ptr [r10]", "c4 42 7d 0e 12")
	e = x64SrcHex(e, "vtestpd xmm9, xmmword ptr [r10]", "c4 42 79 0f 0a")
	e = x64SrcHex(e, "vtestpd ymm10, ymmword ptr [r10]", "c4 42 7d 0f 12")
	e = x64SrcHex(e, "vzeroupper", "c5 f8 77")
	e = x64SrcHex(e, "vzeroall", "c5 fc 77")
	e = x64SrcHex(e, "vldmxcsr dword ptr [r10]", "c4 c1 78 ae 12")
	e = x64SrcHex(e, "vstmxcsr dword ptr [r10]", "c4 c1 78 ae 1a")
	e = x64SrcHex(e, "vmovaps.s xmm9, xmm11", "c4 41 78 29 d9")
	e = x64SrcHex(e, "vmovaps.s ymm10, ymm12", "c4 41 7c 29 e2")
	e = x64SrcHex(e, "vmovapd.s xmm9, xmm11", "c4 41 79 29 d9")
	e = x64SrcHex(e, "vmovapd.s ymm10, ymm12", "c4 41 7d 29 e2")
	e = x64SrcHex(e, "vmovups.s xmm9, xmm11", "c4 41 78 11 d9")
	e = x64SrcHex(e, "vmovups.s ymm10, ymm12", "c4 41 7c 11 e2")
	e = x64SrcHex(e, "vmovupd.s xmm9, xmm11", "c4 41 79 11 d9")
	e = x64SrcHex(e, "vmovupd.s ymm10, ymm12", "c4 41 7d 11 e2")
	e = x64SrcHex(e, "vmovss.s xmm9, xmm11, xmm13", "c4 41 22 11 e9")
	e = x64SrcHex(e, "vmovsd.s xmm9, xmm11, xmm13", "c4 41 23 11 e9")
	return e
}
