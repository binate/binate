package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The VEX-encoded floating-point instructions (x64_avx.bn) against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): a line for each form of the table's
// arithmetic part, with registers 8..15 and memory with a base of r8..r15 where the form takes
// them; the encodings in full are package avx's tests.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn, x64TlsCase in x64_tls_test.bn.)
func TestX64AvxArith() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 58 0a")
	e = x64SrcHex(e, "vaddps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 58 12")
	e = x64SrcHex(e, "vaddpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 58 0a")
	e = x64SrcHex(e, "vaddpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 58 12")
	e = x64SrcHex(e, "vaddss xmm9, xmm11, dword ptr [r10]", "c4 41 22 58 0a")
	e = x64SrcHex(e, "vaddsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 58 0a")
	e = x64SrcHex(e, "vmulps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 59 0a")
	e = x64SrcHex(e, "vmulps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 59 12")
	e = x64SrcHex(e, "vmulpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 59 0a")
	e = x64SrcHex(e, "vmulpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 59 12")
	e = x64SrcHex(e, "vmulss xmm9, xmm11, dword ptr [r10]", "c4 41 22 59 0a")
	e = x64SrcHex(e, "vmulsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 59 0a")
	e = x64SrcHex(e, "vsubps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 5c 0a")
	e = x64SrcHex(e, "vsubps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 5c 12")
	e = x64SrcHex(e, "vsubpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 5c 0a")
	e = x64SrcHex(e, "vsubpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 5c 12")
	e = x64SrcHex(e, "vsubss xmm9, xmm11, dword ptr [r10]", "c4 41 22 5c 0a")
	e = x64SrcHex(e, "vsubsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 5c 0a")
	e = x64SrcHex(e, "vminps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 5d 0a")
	e = x64SrcHex(e, "vminps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 5d 12")
	e = x64SrcHex(e, "vminpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 5d 0a")
	e = x64SrcHex(e, "vminpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 5d 12")
	e = x64SrcHex(e, "vminss xmm9, xmm11, dword ptr [r10]", "c4 41 22 5d 0a")
	e = x64SrcHex(e, "vminsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 5d 0a")
	e = x64SrcHex(e, "vdivps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 5e 0a")
	e = x64SrcHex(e, "vdivps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 5e 12")
	e = x64SrcHex(e, "vdivpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 5e 0a")
	e = x64SrcHex(e, "vdivpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 5e 12")
	e = x64SrcHex(e, "vdivss xmm9, xmm11, dword ptr [r10]", "c4 41 22 5e 0a")
	e = x64SrcHex(e, "vdivsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 5e 0a")
	e = x64SrcHex(e, "vmaxps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 5f 0a")
	e = x64SrcHex(e, "vmaxps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 5f 12")
	e = x64SrcHex(e, "vmaxpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 5f 0a")
	e = x64SrcHex(e, "vmaxpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 5f 12")
	e = x64SrcHex(e, "vmaxss xmm9, xmm11, dword ptr [r10]", "c4 41 22 5f 0a")
	e = x64SrcHex(e, "vmaxsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 5f 0a")
	e = x64SrcHex(e, "vsqrtps xmm9, xmmword ptr [r10]", "c4 41 78 51 0a")
	e = x64SrcHex(e, "vsqrtps ymm10, ymmword ptr [r10]", "c4 41 7c 51 12")
	e = x64SrcHex(e, "vsqrtpd xmm9, xmmword ptr [r10]", "c4 41 79 51 0a")
	e = x64SrcHex(e, "vsqrtpd ymm10, ymmword ptr [r10]", "c4 41 7d 51 12")
	e = x64SrcHex(e, "vsqrtss xmm9, xmm11, dword ptr [r10]", "c4 41 22 51 0a")
	e = x64SrcHex(e, "vsqrtsd xmm9, xmm11, qword ptr [r10]", "c4 41 23 51 0a")
	e = x64SrcHex(e, "vrcpps xmm9, xmmword ptr [r10]", "c4 41 78 53 0a")
	e = x64SrcHex(e, "vrcpps ymm10, ymmword ptr [r10]", "c4 41 7c 53 12")
	e = x64SrcHex(e, "vrcpss xmm9, xmm11, dword ptr [r10]", "c4 41 22 53 0a")
	e = x64SrcHex(e, "vrsqrtps xmm9, xmmword ptr [r10]", "c4 41 78 52 0a")
	e = x64SrcHex(e, "vrsqrtps ymm10, ymmword ptr [r10]", "c4 41 7c 52 12")
	e = x64SrcHex(e, "vrsqrtss xmm9, xmm11, dword ptr [r10]", "c4 41 22 52 0a")
	e = x64SrcHex(e, "vandps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 54 0a")
	e = x64SrcHex(e, "vandps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 54 12")
	e = x64SrcHex(e, "vandpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 54 0a")
	e = x64SrcHex(e, "vandpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 54 12")
	e = x64SrcHex(e, "vandnps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 55 0a")
	e = x64SrcHex(e, "vandnps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 55 12")
	e = x64SrcHex(e, "vandnpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 55 0a")
	e = x64SrcHex(e, "vandnpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 55 12")
	e = x64SrcHex(e, "vorps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 56 0a")
	e = x64SrcHex(e, "vorps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 56 12")
	e = x64SrcHex(e, "vorpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 56 0a")
	e = x64SrcHex(e, "vorpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 56 12")
	e = x64SrcHex(e, "vxorps xmm9, xmm11, xmmword ptr [r10]", "c4 41 20 57 0a")
	e = x64SrcHex(e, "vxorps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1c 57 12")
	e = x64SrcHex(e, "vxorpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 57 0a")
	e = x64SrcHex(e, "vxorpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 57 12")
	e = x64SrcHex(e, "vcmpps xmm9, xmm11, xmmword ptr [r10], 1", "c4 41 20 c2 0a 01")
	e = x64SrcHex(e, "vcmpps ymm10, ymm12, ymmword ptr [r10], 1", "c4 41 1c c2 12 01")
	e = x64SrcHex(e, "vcmppd xmm9, xmm11, xmmword ptr [r10], 1", "c4 41 21 c2 0a 01")
	e = x64SrcHex(e, "vcmppd ymm10, ymm12, ymmword ptr [r10], 1", "c4 41 1d c2 12 01")
	e = x64SrcHex(e, "vcmpss xmm9, xmm11, dword ptr [r10], 1", "c4 41 22 c2 0a 01")
	e = x64SrcHex(e, "vcmpsd xmm9, xmm11, qword ptr [r10], 1", "c4 41 23 c2 0a 01")
	e = x64SrcHex(e, "vcomiss xmm9, dword ptr [r10]", "c4 41 78 2f 0a")
	e = x64SrcHex(e, "vcomisd xmm9, qword ptr [r10]", "c4 41 79 2f 0a")
	e = x64SrcHex(e, "vucomiss xmm9, dword ptr [r10]", "c4 41 78 2e 0a")
	e = x64SrcHex(e, "vucomisd xmm9, qword ptr [r10]", "c4 41 79 2e 0a")
	e = x64SrcHex(e, "vcvtsi2ss xmm9, xmm11, dword ptr [r10]", "c4 41 22 2a 0a")
	e = x64SrcHex(e, "vcvtsi2ss xmm9, xmm11, qword ptr [r10]", "c4 41 a2 2a 0a")
	e = x64SrcHex(e, "vcvtsi2sd xmm9, xmm11, dword ptr [r10]", "c4 41 23 2a 0a")
	e = x64SrcHex(e, "vcvtsi2sd xmm9, xmm11, qword ptr [r10]", "c4 41 a3 2a 0a")
	e = x64SrcHex(e, "vcvtss2si r9d, dword ptr [r10]", "c4 41 7a 2d 0a")
	e = x64SrcHex(e, "vcvtss2si r9, dword ptr [r10]", "c4 41 fa 2d 0a")
	e = x64SrcHex(e, "vcvtsd2si r9d, qword ptr [r10]", "c4 41 7b 2d 0a")
	e = x64SrcHex(e, "vcvtsd2si r9, qword ptr [r10]", "c4 41 fb 2d 0a")
	e = x64SrcHex(e, "vcvttss2si r9d, dword ptr [r10]", "c4 41 7a 2c 0a")
	e = x64SrcHex(e, "vcvttss2si r9, dword ptr [r10]", "c4 41 fa 2c 0a")
	e = x64SrcHex(e, "vcvttsd2si r9d, qword ptr [r10]", "c4 41 7b 2c 0a")
	e = x64SrcHex(e, "vcvttsd2si r9, qword ptr [r10]", "c4 41 fb 2c 0a")
	e = x64SrcHex(e, "vcvtss2sd xmm9, xmm11, dword ptr [r10]", "c4 41 22 5a 0a")
	e = x64SrcHex(e, "vcvtsd2ss xmm9, xmm11, qword ptr [r10]", "c4 41 23 5a 0a")
	e = x64SrcHex(e, "vcvtps2pd xmm9, qword ptr [r10]", "c4 41 78 5a 0a")
	e = x64SrcHex(e, "vcvtps2pd ymm10, xmmword ptr [r10]", "c4 41 7c 5a 12")
	e = x64SrcHex(e, "vcvtpd2ps xmm9, xmmword ptr [r10]", "c4 41 79 5a 0a")
	e = x64SrcHex(e, "vcvtpd2ps xmm9, ymmword ptr [r10]", "c4 41 7d 5a 0a")
	e = x64SrcHex(e, "vcvtdq2ps xmm9, xmmword ptr [r10]", "c4 41 78 5b 0a")
	e = x64SrcHex(e, "vcvtdq2ps ymm10, ymmword ptr [r10]", "c4 41 7c 5b 12")
	e = x64SrcHex(e, "vcvtps2dq xmm9, xmmword ptr [r10]", "c4 41 79 5b 0a")
	e = x64SrcHex(e, "vcvtps2dq ymm10, ymmword ptr [r10]", "c4 41 7d 5b 12")
	e = x64SrcHex(e, "vcvttps2dq xmm9, xmmword ptr [r10]", "c4 41 7a 5b 0a")
	e = x64SrcHex(e, "vcvttps2dq ymm10, ymmword ptr [r10]", "c4 41 7e 5b 12")
	e = x64SrcHex(e, "vcvtdq2pd xmm9, qword ptr [r10]", "c4 41 7a e6 0a")
	e = x64SrcHex(e, "vcvtdq2pd ymm10, xmmword ptr [r10]", "c4 41 7e e6 12")
	e = x64SrcHex(e, "vcvtpd2dq xmm9, xmmword ptr [r10]", "c4 41 7b e6 0a")
	e = x64SrcHex(e, "vcvtpd2dq xmm9, ymmword ptr [r10]", "c4 41 7f e6 0a")
	e = x64SrcHex(e, "vcvttpd2dq xmm9, xmmword ptr [r10]", "c4 41 79 e6 0a")
	e = x64SrcHex(e, "vcvttpd2dq xmm9, ymmword ptr [r10]", "c4 41 7d e6 0a")
	e = x64SrcHex(e, "vaddsubps xmm9, xmm11, xmmword ptr [r10]", "c4 41 23 d0 0a")
	e = x64SrcHex(e, "vaddsubps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1f d0 12")
	e = x64SrcHex(e, "vaddsubpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 d0 0a")
	e = x64SrcHex(e, "vaddsubpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d d0 12")
	e = x64SrcHex(e, "vhaddps xmm9, xmm11, xmmword ptr [r10]", "c4 41 23 7c 0a")
	e = x64SrcHex(e, "vhaddps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1f 7c 12")
	e = x64SrcHex(e, "vhaddpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 7c 0a")
	e = x64SrcHex(e, "vhaddpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 7c 12")
	e = x64SrcHex(e, "vhsubps xmm9, xmm11, xmmword ptr [r10]", "c4 41 23 7d 0a")
	e = x64SrcHex(e, "vhsubps ymm10, ymm12, ymmword ptr [r10]", "c4 41 1f 7d 12")
	e = x64SrcHex(e, "vhsubpd xmm9, xmm11, xmmword ptr [r10]", "c4 41 21 7d 0a")
	e = x64SrcHex(e, "vhsubpd ymm10, ymm12, ymmword ptr [r10]", "c4 41 1d 7d 12")
	e = x64SrcHex(e, "vdpps xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 40 0a 01")
	e = x64SrcHex(e, "vdpps ymm10, ymm12, ymmword ptr [r10], 1", "c4 43 1d 40 12 01")
	e = x64SrcHex(e, "vdppd xmm9, xmm11, xmmword ptr [r10], 1", "c4 43 21 41 0a 01")
	e = x64SrcHex(e, "vroundps xmm9, xmmword ptr [r10], 1", "c4 43 79 08 0a 01")
	e = x64SrcHex(e, "vroundps ymm10, ymmword ptr [r10], 1", "c4 43 7d 08 12 01")
	e = x64SrcHex(e, "vroundpd xmm9, xmmword ptr [r10], 1", "c4 43 79 09 0a 01")
	e = x64SrcHex(e, "vroundpd ymm10, ymmword ptr [r10], 1", "c4 43 7d 09 12 01")
	e = x64SrcHex(e, "vroundss xmm9, xmm11, dword ptr [r10], 1", "c4 43 21 0a 0a 01")
	e = x64SrcHex(e, "vroundsd xmm9, xmm11, qword ptr [r10], 1", "c4 43 21 0b 0a 01")
	return e
}

// The pseudo-prefixes: {vex3}'s three-byte prefix, with clang's swaps undone; {vex} and {vex2}
// leaving the choice as it is; the last of them counting; before a VEX instruction of another
// package's (andn); after prefixes written as instructions; for its own statement only. A segment
// override and {disp32} as before any instruction; [rip + x].
func TestX64AvxPrefixes() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps xmm0, xmm1, xmm8", "c5 b8 58 c1")
	e = x64SrcHex(e, "{vex3} vaddps xmm0, xmm1, xmm2", "c4 e1 70 58 c2")
	e = x64SrcHex(e, "{vex3} vaddps xmm0, xmm1, xmm8", "c4 c1 70 58 c0")
	e = x64SrcHex(e, "{VEX3} vmovaps xmm0, xmm8", "c4 c1 78 28 c0")
	e = x64SrcHex(e, "{vex} vaddps xmm0, xmm1, xmm8", "c5 b8 58 c1")
	e = x64SrcHex(e, "{vex2} vaddps xmm0, xmm8, xmm9", "c4 c1 38 58 c1")
	e = x64SrcHex(e, "{vex} {vex3} vaddps xmm0, xmm1, xmm2", "c4 e1 70 58 c2")
	e = x64SrcHex(e, "{vex3} {vex} vaddps xmm0, xmm1, xmm2", "c5 f0 58 c2")
	e = x64SrcHex(e, "{vex3} vzeroupper", "c4 e1 78 77")
	e = x64SrcHex(e, "{vex} andn eax, ebx, ecx", "c4 e2 60 f2 c1")
	e = x64SrcHex(e, "fs {vex3} vaddps xmm0, xmm1, xmm2", "64 c4 e1 70 58 c2")
	e = x64SrcHex(e, "cs {vex3} vaddps xmm0, xmm8, xmm1", "2e c4 e1 38 58 c1")
	e = x64SrcHex(e, "fs {vex3} vmovaps xmm0, xmm8", "64 c4 c1 78 28 c0")
	e = x64SrcHex(e, "fs gs {vex3} vaddps xmm0, xmm1, xmm2", "64 65 c4 e1 70 58 c2")
	e = x64SrcHex(e, "{vex3} vaddps xmm0, xmm1, xmm2 ; vaddps xmm0, xmm1, xmm2",
			"c4 e1 70 58 c2 c5 f0 58 c2")
	e = x64SrcHex(e, "{vex3} vcmpeqps xmm0, xmm1, xmm8", "c4 c1 70 c2 c0 00")
	e = x64SrcHex(e, "fs vaddps xmm0, xmm1, [rax]", "64 c5 f0 58 00")
	e = x64SrcHex(e, "vaddps xmm0, xmm1, fs:[rax]", "64 c5 f0 58 00")
	e = x64SrcHex(e, "{disp32} vaddps xmm0, xmm1, [rax]", "c5 f0 58 80 00 00 00 00")
	e = x64SrcHex(e, "VADDPS YMM0, YMM1, YMMWORD PTR [RAX]", "c5 f4 58 00")
	e = x64TlsCase(e, "vcmpps xmm0, xmm1, xmmword ptr [rip + x], 1", "c5 f0 c2 05 00 00 00 00 01",
			x64.FIX_REL32_LEA, 4, -1)
	return e
}

// What clang or GNU as rejects: {vex} .. {vex3} before an instruction without a VEX form (an
// XOP-encoded one, which GNU as takes, or a prefix written as an instruction), {rex},
// rex64, lock, a repeat prefix, xacquire and data16 before a VEX one (GNU as; clang emits them),
// operands no form takes, memory of no size where its size picks the form, more than five
// operands, a YMM register as a base, {evex} (AVX-512, not here yet).
func TestX64AvxRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "{vex} add eax, ebx", "stand before a VEX-encoded instruction")
	e = x64LineRejected(e, "{vex3} addps xmm0, xmm1")
	e = x64LineRejected(e, "{vex2} nop")
	e = x64LineErrorHas(e, "{vex} bextr eax, ebx, 0x10", "stand before a VEX-encoded instruction")
	e = x64LineRejected(e, "{vex3} blcfill eax, ebx")
	e = x64LineErrorHas(e, "{vex3} fs vaddps xmm0, xmm1, xmm2", "after prefixes")
	e = x64LineRejected(e, "fs {vex3} gs vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "{vex3} fs {vex} vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "{rex} vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "rex64 vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "lock vaddps xmm0, xmm1, [rax]")
	e = x64LineRejected(e, "rep vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "xacquire vaddps xmm0, xmm1, [rax]")
	e = x64LineErrorHas(e, "data16 vaddps xmm0, xmm1, xmm2", "data16 cannot stand before a VEX")
	e = x64LineRejected(e, "vaddps xmm0, xmm1, ymm2")
	e = x64LineRejected(e, "vaddps xmm0, xmm1, xmmword ptr [ymm2]")
	e = x64LineErrorHas(e, "vcvtpd2ps xmm0, [rax]", "ambiguous operand size")
	e = x64LineErrorHas(e, "vaddps xmm0, xmm1, xmm2, xmm3, xmm4, xmm5", "up to five operands")
	e = x64LineRejected(e, "vcmpeqps xmm0, xmm1, xmm2, 1")
	e = x64LineRejected(e, "{evex} vaddps xmm0, xmm1, xmm2")
	return e
}
