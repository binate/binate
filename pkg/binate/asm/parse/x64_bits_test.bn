package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The bit instructions through the parser, against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).  (x64SrcHex and x64LineRejected are
// in x64_target_test.bn.)

// bt / bts / btr / btc with a register or an imm8, bsf / bsr, lzcnt / tzcnt / popcnt, bswap; an
// unsized memory destination takes the register's size.
func TestX64BitInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "bt rax, rbx", "48 0f a3 d8")
	e = x64SrcHex(e, "bt [rbx], rax", "48 0f a3 03")
	e = x64SrcHex(e, "bt qword ptr [rbx], 70", "48 0f ba 23 46")
	e = x64SrcHex(e, "bt ax, 15", "66 0f ba e0 0f")
	e = x64SrcHex(e, "bts rax, rbx", "48 0f ab d8")
	e = x64SrcHex(e, "btr rax, 3", "48 0f ba f0 03")
	e = x64SrcHex(e, "btc dword ptr [rbx], ecx", "0f bb 0b")
	e = x64SrcHex(e, "BTC r8, r9", "4d 0f bb c8")
	e = x64SrcHex(e, "bsf rax, rbx", "48 0f bc c3")
	e = x64SrcHex(e, "bsr eax, [rbx]", "0f bd 03")
	e = x64SrcHex(e, "lzcnt ax, bx", "66 f3 0f bd c3")
	e = x64SrcHex(e, "tzcnt r8d, r9d", "f3 45 0f bc c1")
	e = x64SrcHex(e, "popcnt rax, rbx", "f3 48 0f b8 c3")
	e = x64SrcHex(e, "popcnt ax, word ptr [rbx]", "66 f3 0f b8 03")
	// The prefixes' order: segment, 66, F3, REX, then the opcode.
	e = x64SrcHex(e, "lzcnt ax, word ptr fs:[r8]", "64 66 f3 41 0f bd 00")
	e = x64SrcHex(e, "bswap eax", "0f c8")
	e = x64SrcHex(e, "bswap r8", "49 0f c8")
	return e
}

// No 8-bit form, an offset past an imm8, a symbol or cl as the offset, an unsized memory operand
// beside an immediate, and a 16-bit or memory bswap are errors, as in clang.
func TestX64BitRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "bt al, bl")
	e = x64LineRejected(e, "bt rax, 256")
	e = x64LineRejected(e, "bt rax, offset x")
	e = x64LineRejected(e, "bt rax, cl")
	e = x64LineRejected(e, "bt [rbx], 3")
	e = x64LineRejected(e, "bsf al, bl")
	e = x64LineRejected(e, "popcnt al, bl")
	e = x64LineRejected(e, "bswap ax")
	e = x64LineRejected(e, "bswap [rbx]")
	e = x64LineRejected(e, "bswap rax, rbx")
	return e
}
