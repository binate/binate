package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"

// The x86-64 instructions named for a condition, as clang takes them: `set<cc>` with a byte
// register or memory operand (an unsized one is a byte), its name also with a byte suffix
// (`setneb`), and `cmov<cc>` with a 16-, 32- or 64-bit register and a register or memory operand
// of its size; <cc> any of the condition's spellings (parseX64CondCode: `ne` and `nz`, `b`, `c` and
// `nae`, `p` and `pe`, ...).

// x64CondMnem returns the condition code of mnem when it is prefix (`set`, `cmov`, any case)
// followed by a condition's spelling, else -1.
func x64CondMnem(mnem *[]readonly char, prefix *[]readonly char) int {
	if len(mnem) <= len(prefix) || !mnemIs(mnem[0:len(prefix)], prefix) { return -1 }
	return parseX64CondCode(mnem[len(prefix):len(mnem)])
}

// x64SetccMnem returns the condition code of the set<cc> mnem — `set` and a condition's spelling,
// or that and the byte suffix `b` (`setneb`; `setb` is `set` and the condition `b`) — else -1.
func x64SetccMnem(mnem *[]readonly char) int {
	var cc int = x64CondMnem(mnem, "set")
	if cc >= 0 || len(mnem) < 5 { return cc }
	var last char = mnem[len(mnem) - 1]
	if last != 'b' && last != 'B' { return -1 }
	return x64CondMnem(mnem[0:len(mnem) - 1], "set")
}

// x64SetccOperandOk reports whether op's size suits a SETcc — a byte, or none (an unsized memory
// operand is a byte; an operand of another kind is left to the encoder to reject) — else sets the
// error (clang: "invalid operand").
func x64SetccOperandOk(p @Parser, op x64.Operand) bool {
	if op.Size == 0 || op.Size == x64.SZ8 { return true }
	setErr(p, "setcc takes a byte register or memory operand")
	return false
}
