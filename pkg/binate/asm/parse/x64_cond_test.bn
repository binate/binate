package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// set<cc>, cmov<cc>, the condition codes' spellings, and movzx / movsx / movsxd, against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`) — but the jumps to a
// label behind them, which bnas encodes as rel32 where clang relaxes them to rel8.  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn, x64TlsCase in x64_tls_test.bn.)

// cmov<cc> and set<cc> with each spelling of a condition (pe / po included, also for jcc); set<cc>
// of a byte register or a byte of memory, unsized or not.
func TestX64CondInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "cmovne rax, rbx", "48 0f 45 c3")
	e = x64SrcHex(e, "cmove eax, [rbx]", "0f 44 03")
	e = x64SrcHex(e, "cmovz ax, bx", "66 0f 44 c3")
	e = x64SrcHex(e, "cmovpe rax, rbx", "48 0f 4a c3")
	e = x64SrcHex(e, "cmovpo rax, rbx", "48 0f 4b c3")
	e = x64SrcHex(e, "cmovnae rax, rbx", "48 0f 42 c3")
	e = x64SrcHex(e, "cmovc rax, rbx", "48 0f 42 c3")
	e = x64SrcHex(e, "cmovnc rax, rbx", "48 0f 43 c3")
	e = x64SrcHex(e, "cmovna rax, rbx", "48 0f 46 c3")
	e = x64SrcHex(e, "cmovnbe rax, rbx", "48 0f 47 c3")
	e = x64SrcHex(e, "cmovnge rax, rbx", "48 0f 4c c3")
	e = x64SrcHex(e, "CMOVNL rax, rbx", "48 0f 4d c3")
	e = x64SrcHex(e, "cmovng rax, rbx", "48 0f 4e c3")
	e = x64SrcHex(e, "cmovnle rax, rbx", "48 0f 4f c3")
	e = x64SrcHex(e, "cmovne rax, [rbx]", "48 0f 45 03")
	e = x64SrcHex(e, "setne al", "0f 95 c0")
	e = x64SrcHex(e, "sete byte ptr [rbx]", "0f 94 03")
	e = x64SrcHex(e, "setne [rbx]", "0f 95 03")
	e = x64SrcHex(e, "setpe al", "0f 9a c0")
	e = x64SrcHex(e, "setpo r8b", "41 0f 9b c0")
	e = x64SrcHex(e, "setne spl", "40 0f 95 c4")
	e = x64SrcHex(e, "setnae dil", "40 0f 92 c7")
	e = x64SrcHex(e, "setneb al", "0f 95 c0")
	e = x64SrcHex(e, "setbb al", "0f 92 c0")
	e = x64SrcHex(e, "setnbb al", "0f 93 c0")
	e = x64SrcHex(e, "setb al", "0f 92 c0")
	e = x64SrcHex(e, "setpob [rbx]", "0f 9b 03")
	e = x64SrcHex(e, "SETNEB AL", "0f 95 c0")
	e = x64SrcHex(e, "setne fs:[rax]", "64 0f 95 00")
	var rel int = x64.FIX_REL32_LEA
	e = x64TlsCase(e, "setne [rip + x]", "0f 95 05 00 00 00 00", rel, 3, 0)
	e = x64TlsCase(e, "cmovne rax, [rip + x]", "48 0f 45 05 00 00 00 00", rel, 4, 0)
	e = x64SrcHex(e, "1:\njpe 1b", "0f 8a fa ff ff ff")
	e = x64SrcHex(e, "1:\njpo 1b", "0f 8b fa ff ff ff")
	return e
}

// movzx / movsx from a byte or word register or memory (sized, or unsized beside a 16-bit
// destination: a byte), movsxd from a dword (an unsized memory source a dword).
func TestX64Extensions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "movzx eax, bl", "0f b6 c3")
	e = x64SrcHex(e, "movzx eax, byte ptr [rbx]", "0f b6 03")
	e = x64SrcHex(e, "movzx rax, bl", "48 0f b6 c3")
	e = x64SrcHex(e, "movzx ax, bl", "66 0f b6 c3")
	e = x64SrcHex(e, "movzx eax, bx", "0f b7 c3")
	e = x64SrcHex(e, "movzx rax, word ptr [rbx]", "48 0f b7 03")
	e = x64SrcHex(e, "movsx eax, bl", "0f be c3")
	e = x64SrcHex(e, "movsx rax, bx", "48 0f bf c3")
	e = x64SrcHex(e, "movsx rax, al", "48 0f be c0")
	e = x64SrcHex(e, "movsx r8, sil", "4c 0f be c6")
	e = x64SrcHex(e, "movzx r9d, spl", "44 0f b6 cc")
	e = x64SrcHex(e, "movsxd rax, ebx", "48 63 c3")
	e = x64SrcHex(e, "movsxd rax, dword ptr [rbx]", "48 63 03")
	e = x64SrcHex(e, "movsxd rax, [rbx]", "48 63 03")
	e = x64SrcHex(e, "movzx ax, [rbx]", "66 0f b6 03")
	e = x64SrcHex(e, "movsx r10w, [rbx]", "66 44 0f be 13")
	var rel int = x64.FIX_REL32_LEA
	e = x64TlsCase(e, "movsxd rax, [rip + x]", "48 63 05 00 00 00 00", rel, 3, 0)
	e = x64TlsCase(e, "movzx ax, [rip + x]", "66 0f b6 05 00 00 00 00", rel, 4, 0)
	return e
}

// What clang rejects: cmov<cc> of bytes, to memory or from an immediate, or with one operand, or
// a suffix; set<cc> of a wider register or memory or an immediate, with no operand or two, or a
// suffix other than b; movzx / movsx from an unsized or 32-bit source, to a byte, or a word into
// 16 bits; movsxd to 32 bits or from a word.  A @tlscall operand marks only a call.
func TestX64CondRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "cmovne al, bl")
	e = x64LineRejected(e, "cmovne [rbx], rax")
	e = x64LineRejected(e, "cmovne rax, 5")
	e = x64LineRejected(e, "cmovne rax")
	e = x64LineRejected(e, "cmovxx rax, rbx")
	e = x64LineRejected(e, "setne ax")
	e = x64LineRejected(e, "setne word ptr [rbx]")
	e = x64LineRejected(e, "setne qword ptr [rbx]")
	e = x64LineRejected(e, "setne")
	e = x64LineRejected(e, "setne al, bl")
	e = x64LineRejected(e, "setne 5")
	e = x64LineRejected(e, "setneb ax")
	e = x64LineRejected(e, "setnew al")
	e = x64LineRejected(e, "cmovneq rax, rbx")
	e = x64LineRejected(e, "setne [rax + x@tlscall]")
	e = x64LineRejected(e, "movzx rax, ebx")
	e = x64LineRejected(e, "movzx eax, [rbx]")
	e = x64LineRejected(e, "movsx eax, [rbx]")
	e = x64LineRejected(e, "movzx bl, al")
	e = x64LineRejected(e, "movsx rax, ebx")
	e = x64LineRejected(e, "movsxd eax, ebx")
	e = x64LineRejected(e, "movsxd rax, word ptr [rbx]")
	e = x64LineRejected(e, "movzx ax, word ptr [rbx]")
	return e
}
