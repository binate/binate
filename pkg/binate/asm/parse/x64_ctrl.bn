package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/ctrl"

// The x86-64 control instructions (ctrl) with operands, as clang takes them: `enter size,
// level`; retf / retfq with an optional imm16, as ret's; loop / loope / loopz / loopne / loopnz /
// jrcxz / jecxz to a label plus numbers (a rel8, x64.FIX_REL8); and ljmp / lcall through a far
// pointer in memory, whose size the operand writes — dword, fword or tbyte ptr (m16:16, m16:32,
// m16:64) — as jmp / call through one (x64.JmpMem, CallMem).  (leave, hlt, pause, int1 and iret /
// iretd / iretq take none: x64_zero.bn.)

// x64CtrlInstruction parses and emits the control instruction mnem (l just after it) when it
// names one with operands, and reports whether it did.
func x64CtrlInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if mnemIs(mnem, "enter") {
		parseX64Enter(p, l)
	} else if mnemIs(mnem, "retf") || mnemIs(mnem, "retfq") {
		parseX64Retf(p, l, mnem)
	} else if x64LoopMnem(mnem) {
		parseX64Loop(p, l, mnem)
	} else if mnemIs(mnem, "ljmp") || mnemIs(mnem, "lcall") {
		parseX64FarJump(p, l, mnem)
	} else {
		return false
	}
	return true
}

// x64LoopMnem reports whether mnem names a loop instruction: loop, loope, loopz, loopne, loopnz,
// jrcxz or jecxz.
func x64LoopMnem(mnem *[]readonly char) bool {
	return mnemIs(mnem, "loop") || mnemIs(mnem, "loope") || mnemIs(mnem, "loopz") ||
			mnemIs(mnem, "loopne") || mnemIs(mnem, "loopnz") || mnemIs(mnem, "jrcxz") ||
			mnemIs(mnem, "jecxz")
}

// parseX64Enter parses `enter size, level` from l (just after the mnemonic) and emits it.
func parseX64Enter(p @Parser, l Lexer) {
	var tok Token
	l, tok = LexNext(l)
	var size int64 = 0
	var ok bool = false
	l, tok, size, ok = parseX64Imm(p, l, tok, "enter")
	if !ok { return }
	if tok.Kind != TOK_COMMA {
		setErr(p, "enter takes a frame size and a nesting level")
		return
	}
	l, tok = LexNext(l)
	var level int64 = 0
	l, tok, level, ok = parseX64Imm(p, l, tok, "enter")
	if ok && x64AtEOL(p, tok) { ctrl.Enter(p.Asm, size, level) }
}

// parseX64Retf parses retf / retfq (mnem) and its optional imm16 from l (just after the mnemonic)
// and emits it.
func parseX64Retf(p @Parser, l Lexer, mnem *[]readonly char) {
	var size int = x64.SZ32
	if mnemIs(mnem, "retfq") { size = x64.SZ64 }
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind == TOK_EOF {
		ctrl.Retf(p.Asm, size)
		return
	}
	var v int64 = 0
	var ok bool = false
	l, tok, v, ok = parseX64Imm(p, l, tok, "retf")
	if ok && x64AtEOL(p, tok) { ctrl.RetfImm(p.Asm, size, v) }
}

// parseX64Loop parses the loop instruction mnem's target (x64LoopMnem) from l (just after the
// mnemonic) and emits it.
func parseX64Loop(p @Parser, l Lexer, mnem *[]readonly char) {
	var tok Token
	l, tok = LexNext(l)
	// A rel8 holds no PLT reference (clang: "32 bit reloc applied to a field with a different size").
	var ahead Lexer = l
	var t Token = tok
	for t.Kind != TOK_EOF {
		if t.Kind == TOK_AT {
			setErr(p, "a loop instruction's rel8 takes no @PLT")
			return
		}
		ahead, t = LexNext(ahead)
	}
	var target @[]char
	var addend int64 = 0
	var ok bool = false
	l, tok, target, addend, ok = parseX64Target(p, l, tok)
	if !ok || !x64AtEOL(p, tok) { return }
	if mnemIs(mnem, "loop") {
		ctrl.Loop(p.Asm, target, addend)
	} else if mnemIs(mnem, "loope") || mnemIs(mnem, "loopz") {
		ctrl.Loope(p.Asm, target, addend)
	} else if mnemIs(mnem, "loopne") || mnemIs(mnem, "loopnz") {
		ctrl.Loopne(p.Asm, target, addend)
	} else if mnemIs(mnem, "jrcxz") {
		ctrl.Jrcxz(p.Asm, target, addend)
	} else {
		ctrl.Jecxz(p.Asm, target, addend)
	}
}

// parseX64FarJump parses ljmp / lcall's (mnem) far pointer in memory, sized dword, fword or
// tbyte, from l (just after the mnemonic) and emits the far jump or call.
func parseX64FarJump(p @Parser, l Lexer, mnem *[]readonly char) {
	var tok Token
	l, tok = LexNext(l)
	var mem x64.Operand
	l, tok, mem = parseX64Operand(p, l, tok)
	if p.HasError || !x64AtEOL(p, tok) || !x64TlsCallOk(p, mem) { return }
	if !x64IsMemory(mem) || (mem.Size != x64.SZ32 && mem.Size != x64.SZ48 && mem.Size != x64.SZ80) {
		setErr(p, "ljmp and lcall go through a far pointer in memory: dword, fword or tbyte ptr")
		return
	}
	x64EmitSeg(p)
	if mnemIs(mnem, "ljmp") {
		x64.JmpMem(p.Asm, mem)
	} else {
		x64.CallMem(p.Asm, mem)
	}
}
