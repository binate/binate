package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The control instructions (x64_ctrl.bn, x64_zero.bn) and the far jumps and calls against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`), int1 against GNU as's;
// the far pointers sized as the operand says, where clang's jmp / call drop a dword's 66 and a
// tbyte's REX.W and its ljmp has REX.W at every size.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn.)

// enter, leave, retf / retfq, iret / iretd / iretq, hlt, pause, int1; the loop instructions to a
// label before them and after (a block label: a rel8 to one in the same atom is resolved), with an
// addend, and to a numeric local label.
func TestX64ControlInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "enter 16, 0", "c8 10 00 00")
	e = x64SrcHex(e, "enter 65535, 255", "c8 ff ff ff")
	e = x64SrcHex(e, "enter -1, 0", "c8 ff ff 00")
	e = x64SrcHex(e, "enter 16, -128", "c8 10 00 80")
	e = x64SrcHex(e, "ENTER 8, 1", "c8 08 00 01")
	e = x64SrcHex(e, "N = 4\nenter N, 0", "c8 04 00 00")
	e = x64SrcHex(e, "enter 4*4, 1", "c8 10 00 01")
	e = x64SrcHex(e, "leave", "c9")
	e = x64SrcHex(e, "LEAVE", "c9")
	e = x64SrcHex(e, "retf", "cb")
	e = x64SrcHex(e, "retfq", "48 cb")
	e = x64SrcHex(e, "retf 8", "ca 08 00")
	e = x64SrcHex(e, "retfq 8", "48 ca 08 00")
	e = x64SrcHex(e, "retf -1", "ca ff ff")
	e = x64SrcHex(e, "iret", "66 cf")
	e = x64SrcHex(e, "iretd", "cf")
	e = x64SrcHex(e, "iretq", "48 cf")
	e = x64SrcHex(e, "hlt", "f4")
	e = x64SrcHex(e, "pause", "f3 90")
	e = x64SrcHex(e, "int1", "f1")
	e = x64SrcHex(e, "lbl2: loop lbl2", "e2 fe")
	e = x64SrcHex(e, "lbl2: loope lbl2", "e1 fe")
	e = x64SrcHex(e, "lbl2: loopz lbl2", "e1 fe")
	e = x64SrcHex(e, "lbl2: loopne lbl2", "e0 fe")
	e = x64SrcHex(e, "lbl2: loopnz lbl2", "e0 fe")
	e = x64SrcHex(e, "lbl2: jrcxz lbl2", "e3 fe")
	e = x64SrcHex(e, "lbl2: jecxz lbl2", "67 e3 fd")
	e = x64SrcHex(e, "loop Lfwd\nnop\nLfwd:", "e2 01 90")
	e = x64SrcHex(e, "loop Lfwd + 2\nLfwd:", "e2 02")
	e = x64SrcHex(e, "loop Lfwd - 2\nnop\nnop\nLfwd:", "e2 00 90 90")
	e = x64SrcHex(e, "loop 1f\n1:", "e2 00")
	e = x64SrcHex(e, "1:\nloop 1b", "e2 fe")
	return e
}

// jmp / call through a far pointer in memory, and ljmp / lcall, which need its size: dword ptr
// m16:16 (66), fword ptr m16:32, tbyte ptr m16:64 (REX.W), with a segment override, a REX base,
// an index and a RIP-relative one.
func TestX64FarJumps() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "jmp fword ptr [rax]", "ff 28")
	e = x64SrcHex(e, "call fword ptr [rax]", "ff 18")
	e = x64SrcHex(e, "jmp dword ptr [rax]", "66 ff 28")
	e = x64SrcHex(e, "call dword ptr [rax]", "66 ff 18")
	e = x64SrcHex(e, "jmp tbyte ptr [rax]", "48 ff 28")
	e = x64SrcHex(e, "call tbyte ptr [rax]", "48 ff 18")
	e = x64SrcHex(e, "jmp fword ptr [r8]", "41 ff 28")
	e = x64SrcHex(e, "jmp fword ptr [rbx + rcx*4 + 8]", "ff 6c 8b 08")
	e = x64SrcHex(e, "jmp fword ptr gs:[rax]", "65 ff 28")
	e = x64SrcHex(e, "ljmp fword ptr [rax]", "ff 28")
	e = x64SrcHex(e, "lcall fword ptr [rax]", "ff 18")
	e = x64SrcHex(e, "ljmp dword ptr fs:[rbx]", "64 66 ff 2b")
	e = x64SrcHex(e, "lcall tbyte ptr [r12 + 8]", "49 ff 5c 24 08")
	e = x64SrcHex(e, "lcall dword ptr [rax]", "66 ff 18")
	e = x64SrcHex(e, "Ldat:\ncall fword ptr [rip + Ldat + 8]", "ff 1d 02 00 00 00")
	return e
}

// What clang rejects — enter's level or size missing, a symbol for either, a loop's target that
// is a number, `.`, a register or memory, or takes @PLT, the q / l spellings — and what clang
// keeps the low bits of (enter's and retf's immediates past their fields); a far jump or call
// through memory of no far pointer's size, or ljmp / lcall without a size.
func TestX64ControlRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "enter 16")
	e = x64LineRejected(e, "enter lbl, 0")
	e = x64LineRejected(e, "enter 16, lbl")
	e = x64LineRejected(e, "enter 65536, 0")
	e = x64LineRejected(e, "enter -32769, 0")
	e = x64LineRejected(e, "enter 16, 256")
	e = x64LineRejected(e, "enterq 16, 0")
	e = x64LineRejected(e, "leave 1")
	e = x64LineRejected(e, "leaveq")
	e = x64LineRejected(e, "retf 65536")
	e = x64LineRejected(e, "retf lbl")
	e = x64LineRejected(e, "retfw")
	e = x64LineRejected(e, "iretw")
	e = x64LineRejected(e, "into")
	e = x64LineRejected(e, "loop 0")
	e = x64LineRejected(e, "loop .")
	e = x64LineRejected(e, "loop rcx")
	e = x64LineRejected(e, "loop [rax]")
	e = x64LineRejected(e, "loop lbl@PLT")
	e = x64LineRejected(e, "loopq lbl")
	e = x64LineRejected(e, "jcxz lbl")
	e = x64LineRejected(e, "ljmp [rax]")
	e = x64LineRejected(e, "lcall [rax]")
	e = x64LineRejected(e, "ljmp qword ptr [rax]")
	e = x64LineRejected(e, "ljmp rax")
	e = x64LineRejected(e, "call word ptr [rax]")
	e = x64LineRejected(e, "jmp byte ptr [rax]")
	e = x64LineRejected(e, "mov eax, fword ptr [rbx]")
	e = x64LineRejected(e, "inc fword ptr [rbx]")
	e = x64LineRejected(e, "push tbyte ptr [rbx]")
	e = x64LineRejected(e, "add tbyte ptr [rbx], 1")
	e = x64LineRejected(e, "cmpxchg16b tbyte ptr [rbx]")
	e = x64LineRejected(e, "setne fword ptr [rbx]")
	e = x64LineRejected(e, "stos fword ptr [rdi]")
	e = x64LineRejected(e, "lock leave")
	e = x64LineRejected(e, "rep loop lbl")
	return e
}
