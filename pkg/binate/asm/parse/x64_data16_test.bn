package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// data16 before an instruction whose operand-size immediate its 66 narrows is an error: bnas, clang
// and GNU as all emit the imm32 (GNU as alone narrows push's), which the CPU reads as an imm16 and
// the rest as another instruction.  The 16-bit forms are written with a 16-bit operand, and the
// 16-bit push of an immediate as GNU as writes it, `pushw imm` or `push word ptr imm` (clang has no
// pushw, and drops the size from `push word ptr 0x1234`: 68 imm32).  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn, x64TlsCase in
// x64_tls_test.bn.)

func TestX64Data16Immediates() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "data16 add eax, 1", "66 83 c0 01")
	e = x64SrcHex(e, "data16 add rax, 0x12345678", "66 48 05 78 56 34 12")
	e = x64SrcHex(e, "data16 mov rax, 1", "66 48 c7 c0 01 00 00 00")
	e = x64SrcHex(e, "data16 push 1", "66 6a 01")
	e = x64SrcHex(e, "data16 mov eax, ebx", "66 89 d8")
	// rex64's REX.W overrides the 66: a 64-bit operation's imm32 stands, as in GNU as.
	e = x64SrcHex(e, "data16 rex64 add eax, 0x12345678", "66 48 05 78 56 34 12")
	e = x64SrcHex(e, "rex64 data16 add eax, 0x12345678", "66 48 05 78 56 34 12")
	e = x64SrcHex(e, "data16 rex64 mov dword ptr [rax], 1", "66 48 c7 00 01 00 00 00")
	e = x64SrcHex(e, "data16 rex64 push 0x1234", "66 48 68 34 12 00 00")
	// The flag is its statement's.
	e = x64SrcHex(e, "data16 mov ax, 1; mov eax, 1", "66 66 b8 01 00 b8 01 00 00 00")
	e = x64LineErrorHas(e, "data16 {rex} add eax, 0x12345678", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 mov eax, 1", "data16's 66 would narrow its immediate")
	e = x64LineErrorHas(e, "data16 mov r9d, 0x12345678", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 mov eax, offset x", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 add eax, 0x12345678", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 add ecx, 0x12345678", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 add eax, offset x", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 test eax, 1", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 test dword ptr [rax], 1", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 imul eax, ebx, 1000", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 mov dword ptr [rax], 1", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 push 0x1234", "would narrow its immediate")
	e = x64LineErrorHas(e, "data16 push offset x", "would narrow its immediate")
	return e
}

// `pushw imm` and `push word ptr imm` (a number, a constant expression or `offset sym`), as GNU as
// reads them; GNU as takes `push word ptr 2*3` as 66 68 06 00, bnas the shorter 66 6a 06 as it
// would `pushw 2*3`, and truncates `pushw 0x10000`, an error here.
func TestX64Pushw() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "pushw 0x1234", "66 68 34 12")
	e = x64SrcHex(e, "pushw 1", "66 6a 01")
	e = x64SrcHex(e, "pushw -1", "66 6a ff")
	e = x64SrcHex(e, "pushw 0xffff", "66 6a ff")
	e = x64SrcHex(e, "pushw -129", "66 68 7f ff")
	e = x64SrcHex(e, "PUSHW 2*3", "66 6a 06")
	e = x64SrcHex(e, "push word ptr 1", "66 6a 01")
	e = x64SrcHex(e, "push word ptr 0x1234", "66 68 34 12")
	e = x64SrcHex(e, "push word ptr -1", "66 6a ff")
	e = x64SrcHex(e, "push word ptr 2*3", "66 6a 06")
	e = x64SrcHex(e, "push word ptr [rax]", "66 ff 30")
	e = x64SrcHex(e, "pushw fs", "66 0f a0")
	e = x64TlsCase(e, "pushw offset x", "66 68 00 00", asm.FIX_DATA_ABS16, 2, 0)
	e = x64TlsCase(e, "push word ptr offset x", "66 68 00 00", asm.FIX_DATA_ABS16, 2, 0)
	e = x64TlsCase(e, "push word ptr x", "66 ff 34 25 00 00 00 00", x64.FIX_ABS32S, 4, 0)
	e = x64SrcHex(e, "rex64 pushw 1", "66 48 6a 01")
	e = x64LineErrorHas(e, "rex64 pushw 0x1234", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 push word ptr 0x1234", "would widen its immediate")
	e = x64LineRejected(e, "pushw 0x10000")
	e = x64LineRejected(e, "pushw -32769")
	e = x64LineErrorHas(e, "pushw rax", "pushw takes fs, gs or an immediate")
	e = x64LineErrorHas(e, "pushw word ptr [rax]", "pushw takes fs, gs or an immediate")
	e = x64LineRejected(e, "push qword ptr 1")
	e = x64LineRejected(e, "mov eax, word ptr 1")
	return e
}

// data16 before a relative branch is an error: the 66 makes xbegin's rel32 a rel16 on every CPU,
// and a near branch's on AMD's (Intel ignores it in 64-bit mode); bnas and clang emit the rel32,
// GNU as narrows xbegin and call.  With rex64's REX.W the 66 has no effect: the general-dynamic TLS
// call stands.
func TestX64Data16Branches() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "data16 jmp x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 je x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 call x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 call x@PLT", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 xbegin x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 loop x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 jrcxz x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 jecxz x", "data16 before a relative branch")
	e = x64LineErrorHas(e, "data16 {rex} jmp x", "data16 before a relative branch")
	e = x64TlsCase(e, "data16 data16 rex64 call x@PLT", "66 66 48 e8 00 00 00 00", x64.FIX_REL32, 4, 0)
	e = x64TlsCase(e, "data16 rex64 jmp x", "66 48 e9 00 00 00 00", x64.FIX_REL32, 3, 0)
	return e
}
