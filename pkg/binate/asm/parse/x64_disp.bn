package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"

// An x86-64 operand written as an expression, as clang reads Intel syntax: a displacement before
// a memory operand's brackets (`8[rbx]`, `x + 8[rbx]`, `x@TPOFF[rax]`, `x[rip]`), summed with
// each bracket group after it (`x[rbx][8]`; x64_mem.bn) — its terms those of a group, but no
// register; or one with no brackets, which is a memory operand at its absolute address when it
// has a symbol (`mov rax, x`, `push x`, `qword ptr x + 8`, a bare `x@TPOFF`: clang's [disp32])
// and otherwise an immediate (`mov rax, N`; a label difference in parentheses, `(l2 - l1)`, folded
// to its number).  After a segment override a number with no brackets is the absolute address
// too (`fs:8`); after a size it is an error (clang reads `qword ptr 8` as the immediate 8).

// The places an expression operand stands (parseX64ExprOperand).
const (
	x64ExprPlain int = 0 // no size or segment override before it: a number alone is an immediate
	x64ExprSized int = 1 // after `byte` ... `qword ptr`: a number alone is an error
	x64ExprSeg int = 2   // after a segment override: a number alone is the absolute address
)

// parseX64ExprOperand parses the operand that starts with the expression at tok (l just after
// it), standing at where (x64ExprPlain, x64ExprSized, x64ExprSeg), for an access of size bits.
// Where it is plain, it may be a memory operand (x64ExprIsMemory), and is the immediate when
// what it has folds to numbers.
func parseX64ExprOperand(p @Parser, l Lexer, tok Token, size int,
		where int) (Lexer, Token, x64.Operand) {
	var m x64MemAcc = newX64MemAcc()
	l, tok, m = parseX64MemTerms(p, l, tok, m, true)
	if !p.HasError { l, tok, m = parseX64MemGroups(p, l, tok, m) }
	if p.HasError { return l, tok, x64.Imm(0) }
	if m.Groups == 0 && len(m.Sym) == 0 {
		if where == x64ExprSized && m.DiffConsts == 0 {
			setErr(p,
					"a size takes a memory operand, in brackets or a symbol (clang reads a number after "
							"it as an immediate)")
			return l, tok, x64.Imm(0)
		}
		// (A label-difference constant is a memory operand at its address: x64_imm.bn.)
		if where == x64ExprPlain && m.DiffConsts == 0 {
			if m.Loose && m.NDisp > 1 { return l, tok, x64LooseTermError(p) }
			return l, tok, x64.Imm64(m.Disp)
		}
	}
	return l, tok, x64MemOperandOf(p, m, size)
}

// x64ExprIsMemory reports whether the operand that starts with the expression at tok (l just
// after it), with no size or segment override before it, may be a memory operand: one with a
// bracket group, an '@' operator, or a symbol — a name that is not a register's or a number
// constant's (an alias is a symbol plus a number; a label may be one of a difference that folds
// to a number).  Otherwise it is a number (x64NumberOperand).
func x64ExprIsMemory(p @Parser, l Lexer, tok Token) bool {
	var depth int = 0
	for tok.Kind != TOK_EOF {
		if tok.Kind == TOK_LPAREN { depth = depth + 1 }
		if tok.Kind == TOK_RPAREN { depth = depth - 1 }
		if tok.Kind == TOK_COMMA && depth <= 0 { return false }
		if tok.Kind == TOK_LBRACKET || tok.Kind == TOK_AT { return true }
		if tok.Kind == TOK_IDENT && !isX64RegisterName(tok.Text) {
			var i int = constIndex(p, tok.Text)
			if i < 0 || len(p.ConstSyms[i]) > 0 { return true }
		}
		l, tok = LexNext(l)
	}
	return false
}

// x64MemOperandOf returns the memory operand m sums, for an access of size bits: RIP-relative
// with `rip` (x64RipOperandOf); else its base, index and displacement, the displacement a
// symbol's when it has one (x64.MemSym: the symbol's address, FIX_ABS32S, or a thread-local
// offset) — with no register, the absolute address, [disp32] or past it a 64-bit one
// (x64.MemAddr64).
func x64MemOperandOf(p @Parser, m x64MemAcc, size int) x64.Operand {
	if m.Loose && m.NDisp > 1 { return x64LooseTermError(p) }
	// clang reads a label-difference constant as a second symbol.
	if m.DiffConsts > 0 && len(m.Sym) > 0 {
		setErr(p, intelDiffConstSymbolError().Err)
		return x64.Imm(0)
	}
	// (Beside rip the numbers are the relocation's addend, any 64-bit value.)
	if m.Rip { return x64RipOperandOf(p, m, size) }
	if x64RipOperatorKind(m.Op) {
		setErr(p,
				"@GOTPCREL, @GOTTPOFF, @TLSGD, @TLSLD, @tlsdesc and @TLVP are RIP-relative: [rip + "
						"sym@GOTTPOFF]")
		return x64.Imm(0)
	}
	if m.Disp < -2147483648 || m.Disp > 2147483647 {
		if m.Base < 0 && m.Index < 0 { return x64WideAddress(m, size) }
		setErr(p, "a memory operand's displacement is a signed 32-bit value")
		return x64.Imm(0)
	}
	var base int = m.Base
	var index int = m.Index
	if index == x64.RSP {
		if m.Scale != 1 || base < 0 || base == x64.RSP {
			setErr(p, "rsp cannot be a memory operand's index")
			return x64.Imm(0)
		}
		index = base
		base = x64.RSP
	}
	var disp int = cast(int, m.Disp)
	if len(m.Sym) > 0 {
		var kind int = m.Op
		if kind == 0 { kind = x64.FIX_ABS32S }
		return x64.MemSym(base, index, m.Scale, m.Sym, kind, disp, size)
	}
	if index < 0 && base < 0 { return x64.MemAbs(disp, size) }
	var op x64.Operand = x64.Mem(base, disp, size)
	if index >= 0 { op = x64.MemIdx(base, index, m.Scale, disp, size) }
	// clang gives a displacement it reads as a symbol 32 bits, whatever its value.
	op.Disp32 = m.DiffConsts > 0
	return op
}

// x64WideAddress returns the absolute operand m sums, its address past a sign-extended 32 bits
// (x64.MemAddr64), for an access of size bits: one only the moffs form of MOV and MOVABS takes
// (the other encoders reject it, where clang keeps its low 32 bits).  An address clang reads as a
// symbol — a symbol's, the numbers its addend, or a label-difference constant's — clang's MOV
// encodes as a disp32 (keeping a constant's low 32 bits), where its MOVABS takes it whole; it is
// marked Disp32, which Mov rejects.
func x64WideAddress(m x64MemAcc, size int) x64.Operand {
	var op x64.Operand = x64.MemAddr64(m.Disp, size)
	if len(m.Sym) > 0 {
		op.Label = m.Sym
		op.Fix = m.Op
		if op.Fix == 0 { op.Fix = x64.FIX_ABS32S }
	}
	op.Disp32 = len(m.Sym) > 0 || m.DiffConsts > 0
	return op
}

// x64RipOperandOf returns the RIP-relative operand m sums (m.Rip), for an access of size bits:
// with no other register, and a symbol — plain, `[rip + x + 8]` (x64.RipLabelAddend), or with a
// slot or descriptor operator and no number (x64.RipGotLabel, RipTlvp, RipTls).
func x64RipOperandOf(p @Parser, m x64MemAcc, size int) x64.Operand {
	if m.Base >= 0 || m.Index >= 0 {
		setErr(p, "rip takes no other register in a memory operand (clang drops rip beside one)")
		return x64.Imm(0)
	}
	if len(m.Sym) == 0 {
		// `[rip + disp]` with no symbol has no relocation to form.
		setErr(p, "rip-relative operand needs a symbol: [rip + label]")
		return x64.Imm(0)
	}
	if m.Op == x64.FIX_TPOFF32 || m.Op == x64.FIX_DTPOFF32 {
		setErr(p, "@TPOFF and @DTPOFF are offsets, not RIP-relative: [base + sym@TPOFF]")
		return x64.Imm(0)
	}
	if m.Op == x64.FIX_TLSCALL {
		x64TlsCallError(p)
		return x64.Imm(0)
	}
	var op x64.Operand
	if m.Op == 0 {
		op = x64.RipLabelAddend(m.Sym, m.Disp)
		op.Size = size
		return op
	}
	// A GOT slot, a thread-local slot or a descriptor plus an addend is nothing: clang emits the
	// non-relaxable GOTPCREL with one, drops it after @GOTTPOFF on a mov and keeps it after
	// @TLSGD; Mach-O has no form for one.
	if m.Disp != 0 {
		if m.Op == x64SpecGot {
			setErr(p, "a GOT-indirect operand takes no addend")
		} else if m.Op == x64SpecTlvp {
			setErr(p, "a thread-local variable reference (@TLVP) takes no addend")
		} else {
			setErr(p, "a thread-local slot or descriptor reference takes no addend")
		}
		return x64.Imm(0)
	}
	if m.Op == x64SpecGot {
		op = x64.RipGotLabel(m.Sym)
	} else if m.Op == x64SpecTlvp {
		op = x64.RipTlvp(m.Sym)
	} else {
		op = x64.RipTls(m.Sym, m.Op)
	}
	op.Size = size
	return op
}
