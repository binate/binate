package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// A symbol in a memory operand (x64_mem.bn) and operands written as expressions (x64_disp.bn)
// against clang's bytes and relocations (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax
// noprefix`, llvm-objdump -dr): the relocated field a zero placeholder.  (x64TlsCase is in
// x64_tls_test.bn, x64SrcHex and x64LineRejected in x64_target_test.bn, x64SrcRejected and
// x64Diff in x64_imm_test.bn.)

// A symbol plus numbers is a memory operand's displacement — with a base, an index or neither,
// in any order — always 32 bits, relocated as R_X86_64_32S (x64.FIX_ABS32S), the numbers its
// addend; an alias is its symbol and addend, a constant a number beside it.
func TestX64MemSymbolTerm() testing.TestResult {
	var e @[]char = ""
	var s int = x64.FIX_ABS32S
	e = x64TlsCase(e, "mov rax, [x]", "48 8b 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov rax, [x + 8]", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, [8 + x]", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, [x - 8]", "48 8b 04 25 00 00 00 00", s, 4, -8)
	e = x64TlsCase(e, "mov rax, [8 - 4 + x]", "48 8b 04 25 00 00 00 00", s, 4, 4)
	e = x64TlsCase(e, "mov rax, [(x + 8)]", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, [rbx + x]", "48 8b 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov rax, [x + rbx]", "48 8b 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov rax, [x - 8 + rbx]", "48 8b 83 00 00 00 00", s, 3, -8)
	e = x64TlsCase(e, "mov rax, [rbx + (x + 8)]", "48 8b 83 00 00 00 00", s, 3, 8)
	e = x64TlsCase(e, "mov rax, [x + rcx*4]", "48 8b 04 8d 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov rax, [rbx + rcx*4 + x]", "48 8b 84 8b 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov eax, [x]", "8b 04 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov qword ptr [x], 5", "48 c7 04 25 00 00 00 00 05 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "lea rax, [rbx + x]", "48 8d 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "add rax, [x]", "48 03 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "push qword ptr [x]", "ff 34 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "jmp qword ptr [x]", "ff 24 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "call [x]", "ff 14 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "A = x + 4\nmov rax, [rbx + A]", "48 8b 83 00 00 00 00", s, 3, 4)
	e = x64TlsCase(e, "N = 5\nmov rax, [rbx + x + N]", "48 8b 83 00 00 00 00", s, 3, 5)
	return e
}

// With no brackets, an operand with a symbol is a memory operand at its absolute address — sized
// by its instruction, a size, or 64 bits for PUSH / POP — its operator after the symbol
// (`x@TPOFF`); an operand of numbers is the immediate, a constant's name and a label difference
// in parentheses included.
func TestX64BareSymbolOperand() testing.TestResult {
	var e @[]char = ""
	var s int = x64.FIX_ABS32S
	var tp int = x64.FIX_TPOFF32
	e = x64TlsCase(e, "mov rax, x", "48 8b 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov rax, x + 8", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, 8 + x", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, x - 8", "48 8b 04 25 00 00 00 00", s, 4, -8)
	e = x64TlsCase(e, "mov rax, (x + 8)", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "N = 5\nmov rax, N + x", "48 8b 04 25 00 00 00 00", s, 4, 5)
	e = x64TlsCase(e, "A = x + 4\nmov rax, A", "48 8b 04 25 00 00 00 00", s, 4, 4)
	e = x64TlsCase(e, "mov eax, x", "8b 04 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov x, rax", "48 89 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov qword ptr x, 5", "48 c7 04 25 00 00 00 00 05 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov byte ptr x, 1", "c6 04 25 00 00 00 00 01", s, 3, 0)
	e = x64TlsCase(e, "mov rax, qword ptr x + 8", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "lea rax, x", "48 8d 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "push x", "ff 34 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "pop qword ptr x", "8f 04 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "jmp qword ptr x", "ff 24 25 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "inc qword ptr x", "48 ff 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "shl qword ptr x, 1", "48 d1 24 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "imul rax, x, 3", "48 6b 04 25 00 00 00 00 03", s, 4, 0)
	e = x64TlsCase(e, "imul rax, x", "48 0f af 04 25 00 00 00 00", s, 5, 0)
	e = x64TlsCase(e, "test x, rax", "48 85 04 25 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov rax, fs:x", "64 48 8b 04 25 00 00 00 00", s, 5, 0)
	e = x64TlsCase(e, "mov rax, x@TPOFF", "48 8b 04 25 00 00 00 00", tp, 4, 0)
	e = x64TlsCase(e, "mov rax, x@TPOFF + 8", "48 8b 04 25 00 00 00 00", tp, 4, 8)
	e = x64TlsCase(e, "mov rax, qword ptr x@TPOFF", "48 8b 04 25 00 00 00 00", tp, 4, 0)
	e = x64SrcHex(e, "N = 5\nmov rax, N + 4", "48 c7 c0 09 00 00 00")
	e = x64SrcHex(e, "mov rax, -8 | 4", "48 c7 c0 fc ff ff ff")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov rax, (L2 - L1)"), "90 90 48 c7 c0 01 00 00 00")
	// A label-difference constant is a memory operand at its address, sized or not (x64_imm.bn).
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov rax, qword ptr N"), "90 90 48 8b 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "call qword ptr N"), "90 90 ff 14 25 01 00 00 00")
	return e
}

// A displacement written before the brackets adds to them, and several bracket groups sum:
// numbers (`8[rbx]`, `N[rbx]`, `[rbx][rcx*4][8]`), and a symbol or a symbol and its operator.
func TestX64DispBeforeBrackets() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mov rax, 8[rbx]", "48 8b 43 08")
	e = x64SrcHex(e, "mov rax, -8[rbx]", "48 8b 43 f8")
	e = x64SrcHex(e, "mov rax, 8[rbx + rcx*4]", "48 8b 44 8b 08")
	e = x64SrcHex(e, "mov rax, 8[rbx + 4]", "48 8b 43 0c")
	e = x64SrcHex(e, "mov rax, (8)[rbx]", "48 8b 43 08")
	e = x64SrcHex(e, "mov rax, 1 << 2[rbx]", "48 8b 43 04")
	e = x64SrcHex(e, "mov rax, 2 * 4[rbx]", "48 8b 43 08")
	e = x64SrcHex(e, "N = 5\nmov rax, N[rbx]", "48 8b 43 05")
	e = x64SrcHex(e, "mov rax, [rbx][rcx]", "48 8b 04 0b")
	e = x64SrcHex(e, "mov rax, [rbx][rcx*4][8]", "48 8b 44 8b 08")
	e = x64SrcHex(e, "mov rax, [rbx + 8][rcx]", "48 8b 44 0b 08")
	e = x64SrcHex(e, "mov rax, 8[rbx][rcx*4]", "48 8b 44 8b 08")
	e = x64SrcHex(e, "mov qword ptr 8[rbx], rax", "48 89 43 08")
	e = x64SrcHex(e, "mov 8[rbx], rax", "48 89 43 08")
	e = x64SrcHex(e, "lea rax, 8[rbx + rcx]", "48 8d 44 0b 08")
	e = x64SrcHex(e, "mov rax, fs:8[rbx]", "64 48 8b 43 08")
	e = x64SrcHex(e, "call 8[rbx]", "ff 53 08")
	e = x64SrcHex(e, "jmp 8[rbx]", "ff 63 08")
	e = x64SrcHex(e, "mov rax, (3 | 4)[rbx]", "48 8b 43 07")
	e = x64SrcHex(e, "mov rax, [rbx + 3 | 4][rcx]", "48 8b 44 0b 07")
	var s int = x64.FIX_ABS32S
	e = x64TlsCase(e, "mov rax, x[rbx]", "48 8b 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov rax, x+8[rbx]", "48 8b 83 00 00 00 00", s, 3, 8)
	e = x64TlsCase(e, "mov rax, 8 + x[rbx]", "48 8b 83 00 00 00 00", s, 3, 8)
	e = x64TlsCase(e, "mov rax, x - 8[rbx]", "48 8b 83 00 00 00 00", s, 3, -8)
	e = x64TlsCase(e, "mov rax, x + 2 * 4[rbx]", "48 8b 83 00 00 00 00", s, 3, 8)
	e = x64TlsCase(e, "mov rax, x[rbx - 8]", "48 8b 83 00 00 00 00", s, 3, -8)
	e = x64TlsCase(e, "mov rax, x[rbx + rcx*4 + 8]", "48 8b 84 8b 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, x[rbx][rcx]", "48 8b 84 0b 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "mov rax, x[rbx][8]", "48 8b 83 00 00 00 00", s, 3, 8)
	e = x64TlsCase(e, "mov rax, [rbx][x]", "48 8b 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov rax, [x][rbx - 8][8]", "48 8b 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov rax, (x + 8)[rbx]", "48 8b 83 00 00 00 00", s, 3, 8)
	e = x64TlsCase(e, "mov rax, x[8]", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, 8[x]", "48 8b 04 25 00 00 00 00", s, 4, 8)
	e = x64TlsCase(e, "mov rax, qword ptr x[rbx]", "48 8b 83 00 00 00 00", s, 3, 0)
	e = x64TlsCase(e, "mov rax, fs:x[rbx]", "64 48 8b 83 00 00 00 00", s, 4, 0)
	e = x64TlsCase(e, "call x[rbx]", "ff 93 00 00 00 00", s, 2, 0)
	e = x64TlsCase(e, "jmp qword ptr x[rbx]", "ff a3 00 00 00 00", s, 2, 0)
	e = x64TlsCase(e, "MOV RAX, x[RBX]", "48 8b 83 00 00 00 00", s, 3, 0)
	return e
}

// An operator follows its symbol before the brackets as within them: `x@TPOFF[rax]`, numbers
// after it or in the brackets its addend, `x@tlscall[rax]` on CALL.
func TestX64OperatorBeforeBrackets() testing.TestResult {
	var e @[]char = ""
	var tp int = x64.FIX_TPOFF32
	e = x64TlsCase(e, "mov rax, x@TPOFF[rax]", "48 8b 80 00 00 00 00", tp, 3, 0)
	e = x64TlsCase(e, "mov rax, x@TPOFF[rax + 8]", "48 8b 80 00 00 00 00", tp, 3, 8)
	e = x64TlsCase(e, "mov rax, x@TPOFF+8[rax]", "48 8b 80 00 00 00 00", tp, 3, 8)
	e = x64TlsCase(e, "mov rax, x@TPOFF - 8[rax]", "48 8b 80 00 00 00 00", tp, 3, -8)
	e = x64TlsCase(e, "mov rax, 8 + x@TPOFF[rax]", "48 8b 80 00 00 00 00", tp, 3, 8)
	e = x64TlsCase(e, "mov rax, x@TPOFF + 2 * 4[rax]", "48 8b 80 00 00 00 00", tp, 3, 8)
	e = x64TlsCase(e, "mov rax, [x@TPOFF][rax]", "48 8b 80 00 00 00 00", tp, 3, 0)
	e = x64TlsCase(e, "mov rax, x@TPOFF[rax][rbx]", "48 8b 84 18 00 00 00 00", tp, 4, 0)
	e = x64TlsCase(e, "mov rax, fs:x@TPOFF[rbx]", "64 48 8b 83 00 00 00 00", tp, 4, 0)
	e = x64TlsCase(e, "mov rax, x@DTPOFF[rax]", "48 8b 80 00 00 00 00", x64.FIX_DTPOFF32, 3, 0)
	e = x64TlsCase(e, "call x@tlscall[rax]", "ff 10", x64.FIX_TLSCALL, 0, 0)
	e = x64TlsCase(e, "call qword ptr x@tlscall[rax]", "ff 10", x64.FIX_TLSCALL, 0, 0)
	return e
}

// `rip` stands anywhere in the operand, a symbol beside it RIP-relative (its fixup the PC32 one,
// the numbers its addend), and the RIP-relative operators may follow the symbol before the
// brackets, `+ 0` beside them.
func TestX64RipAnywhere() testing.TestResult {
	var e @[]char = ""
	var rel int = x64.FIX_REL32_LEA
	e = x64TlsCase(e, "mov rax, x[rip]", "48 8b 05 00 00 00 00", rel, 3, 0)
	e = x64TlsCase(e, "mov rax, x[rip + 8]", "48 8b 05 00 00 00 00", rel, 3, 8)
	e = x64TlsCase(e, "mov rax, x+8[rip]", "48 8b 05 00 00 00 00", rel, 3, 8)
	e = x64TlsCase(e, "mov rax, [x + rip]", "48 8b 05 00 00 00 00", rel, 3, 0)
	e = x64TlsCase(e, "mov rax, [8 + rip + x]", "48 8b 05 00 00 00 00", rel, 3, 8)
	e = x64TlsCase(e, "mov rax, [rip][x][8]", "48 8b 05 00 00 00 00", rel, 3, 8)
	e = x64TlsCase(e, "mov rax, x[rip][8]", "48 8b 05 00 00 00 00", rel, 3, 8)
	e = x64TlsCase(e, "mov rax, x[RIP]", "48 8b 05 00 00 00 00", rel, 3, 0)
	// The numbers beside rip are the relocation's addend, not a disp32: any 64-bit value.
	e = x64TlsCase(e, "mov rax, [rip + x + 0x80000000]", "48 8b 05 00 00 00 00", rel, 3, 0x80000000)
	e = x64TlsCase(e, "mov rax, x[rip - 0x80000004]", "48 8b 05 00 00 00 00", rel, 3, -0x80000004)
	e = x64TlsCase(e, "lea rax, x[rip]", "48 8d 05 00 00 00 00", rel, 3, 0)
	e = x64TlsCase(e, "call x[rip]", "ff 15 00 00 00 00", rel, 2, 0)
	e = x64TlsCase(e, "jmp qword ptr x[rip]", "ff 25 00 00 00 00", rel, 2, 0)
	e = x64TlsCase(e, "mov rax, x@gottpoff[rip]", "48 8b 05 00 00 00 00", x64.FIX_GOTTPOFF, 3, 0)
	e = x64TlsCase(e, "add rax, x@gottpoff[rip]", "48 03 05 00 00 00 00", x64.FIX_GOTTPOFF, 3, 0)
	e = x64TlsCase(e, "lea rdi, x@tlsgd[rip]", "48 8d 3d 00 00 00 00", x64.FIX_TLSGD, 3, 0)
	e = x64TlsCase(e, "lea rdi, x@tlsld[rip]", "48 8d 3d 00 00 00 00", x64.FIX_TLSLD, 3, 0)
	e = x64TlsCase(e, "lea rax, x@tlsdesc[rip]", "48 8d 05 00 00 00 00", x64.FIX_TLSDESC, 3, 0)
	e = x64TlsCase(e, "mov rax, x@GOTPCREL[rip]", "48 8b 05 00 00 00 00", x64.FIX_GOTPCREL, 3, 0)
	e = x64TlsCase(e, "mov rax, [x@GOTPCREL + rip]", "48 8b 05 00 00 00 00", x64.FIX_GOTPCREL, 3, 0)
	e = x64TlsCase(e, "mov rax, [rip + x@GOTPCREL + 0]", "48 8b 05 00 00 00 00", x64.FIX_GOTPCREL, 3,
			0)
	e = x64TlsCase(e, "mov rax, x@TLVP[rip]", "48 8b 05 00 00 00 00", x64.FIX_TLVP, 3, 0)
	return e
}

// What clang misreads is an error: a subtracted or negated symbol (clang adds it), a scaled one
// (clang drops the scale), two symbols, `rip` beside another register or scaled (clang drops
// it), a slot or descriptor operator or @PLT outside `[rip + ...]`, a number beside a slot, a
// register before the brackets or with none (clang drops it), an operator after anything but a
// symbol's name, and a size before a bare number (clang's immediate).  So is what clang rejects:
// text after the brackets, an operator after them.
func TestX64MemSymbolRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "mov rax, [rbx - x]")
	e = x64LineRejected(e, "mov rax, [-x]")
	e = x64LineRejected(e, "mov rax, -x[rbx]")
	e = x64LineRejected(e, "mov rax, 8 - x")
	e = x64LineRejected(e, "mov rax, [rip - x]")
	e = x64LineRejected(e, "mov rax, [rbx - x@TPOFF]")
	e = x64LineRejected(e, "mov rax, [x*2]")
	e = x64LineRejected(e, "mov rax, [rbx + x*1]")
	e = x64LineRejected(e, "mov rax, x*2")
	e = x64LineRejected(e, "mov rax, [x | 4]")
	e = x64LineRejected(e, "mov rax, [x + y]")
	e = x64LineRejected(e, "mov rax, x[y]")
	e = x64LineRejected(e, "mov rax, x[x]")
	e = x64LineRejected(e, "mov rax, [x@TPOFF + y]")
	e = x64LineRejected(e, "mov rax, x@TPOFF[y]")
	e = x64LineRejected(e, "mov rax, x[y@TPOFF]")
	e = x64LineRejected(e, "mov rax, x@TPOFF + y@TPOFF")
	e = x64LineRejected(e, "mov rax, [rip + rbx]")
	e = x64LineRejected(e, "mov rax, [rbx + rip]")
	e = x64LineRejected(e, "mov rax, x[rip][rbx]")
	e = x64LineRejected(e, "mov rax, [rip + x][rbx]")
	e = x64LineRejected(e, "mov rax, [rip*2 + x]")
	e = x64LineRejected(e, "mov rax, [2*rip + x]")
	e = x64LineRejected(e, "mov rax, [rip + rip + x]")
	e = x64LineRejected(e, "mov rax, x@TPOFF[rip]")
	e = x64LineRejected(e, "mov rax, x@GOTPCREL[rip + 8]")
	e = x64LineRejected(e, "mov rax, x@GOTPCREL[rip][8]")
	e = x64LineRejected(e, "mov rax, x@GOTPCREL")
	e = x64LineRejected(e, "mov rax, x@gottpoff")
	e = x64LineRejected(e, "mov rax, x@GOTPCREL[rbx]")
	e = x64LineRejected(e, "mov rax, x@gottpoff[rbx]")
	e = x64LineRejected(e, "mov rax, x@PLT[rbx]")
	e = x64LineRejected(e, "mov rax, x@TPOFF + rbx")
	e = x64LineRejected(e, "mov rax, x + rbx")
	e = x64LineRejected(e, "mov rax, x + 8@TPOFF[rax]")
	e = x64LineRejected(e, "mov rax, (x)@TPOFF[rax]")
	e = x64LineRejected(e, "mov rax, x@TPOFF * 2[rax]")
	e = x64LineRejected(e, "mov rax, [rbx + 3 | 4][8]")
	e = x64LineRejected(e, "mov rax, [rbx + x + 0x80000000]")
	e = x64LineRejected(e, "mov rax, x[rbx]@TPOFF")
	e = x64LineRejected(e, "mov rax, [rbx]8")
	e = x64LineRejected(e, "mov rax, [rbx]+8")
	e = x64LineRejected(e, "jmp x@tlscall[rax]")
	e = x64LineRejected(e, "mov rax, qword ptr 8")
	e = x64LineRejected(e, "mov qword ptr 8, 1")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, [x + N]"), "cannot be combined")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, x[rbx + N]"), "cannot be combined")
	e = x64SrcRejected(e, "mov rax, 1f@GOTPCREL[rip]\n1:", "numeric local label")
	e = x64SrcRejected(e, "mov rax, x@GOTPCREL*2[rip]", "only + or -")
	e = x64SrcRejected(e, "mov rax, [x@TPOFF*2 + rax]", "only + or -")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, [rbx + L2 - L1]"), "in parentheses")
	return e
}

// An absolute address past a sign-extended 32 bits is MOV's moffs form with AL / AX / EAX / RAX
// (`mov rax, [0x123456789]` 48 A1 and the 8-byte address; one that fits stays [disp32]), and MOVABS
// with memory is always that form — a number, a symbol (R_X86_64_64), a thread-local offset
// (TPOFF64), after a segment override too.
func TestX64Moffs() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mov rax, [0x123456789]", "48 a1 89 67 45 23 01 00 00 00")
	e = x64SrcHex(e, "mov [0x123456789], al", "a2 89 67 45 23 01 00 00 00")
	e = x64SrcHex(e, "mov ax, [0x123456789]", "66 a1 89 67 45 23 01 00 00 00")
	e = x64SrcHex(e, "mov rax, [0x80000000]", "48 a1 00 00 00 80 00 00 00 00")
	e = x64SrcHex(e, "mov rax, [-0x80000000]", "48 8b 04 25 00 00 00 80")
	e = x64SrcHex(e, "mov rax, fs:[0x123456789]", "64 48 a1 89 67 45 23 01 00 00 00")
	e = x64SrcHex(e, "movabs al, [0x10]", "a0 10 00 00 00 00 00 00 00")
	e = x64SrcHex(e, "movabs [0x10], rax", "48 a3 10 00 00 00 00 00 00 00")
	e = x64SrcHex(e, "movabs rax, qword ptr [0x10]", "48 a1 10 00 00 00 00 00 00 00")
	e = x64SrcHex(e, "movabs rax, fs:[0x10]", "64 48 a1 10 00 00 00 00 00 00 00")
	var abs int = asm.FIX_DATA_ABS64
	e = x64TlsCase(e, "movabs rax, [x]", "48 a1 00 00 00 00 00 00 00 00", abs, 2, 0)
	e = x64TlsCase(e, "movabs rax, x", "48 a1 00 00 00 00 00 00 00 00", abs, 2, 0)
	e = x64TlsCase(e, "movabs rax, [x + 8]", "48 a1 00 00 00 00 00 00 00 00", abs, 2, 8)
	e = x64TlsCase(e, "movabs [x], eax", "a3 00 00 00 00 00 00 00 00", abs, 1, 0)
	e = x64TlsCase(e, "movabs rax, [x@TPOFF]", "48 a1 00 00 00 00 00 00 00 00", x64.FIX_TPOFF64, 2, 0)
	// MOVABS takes whole an address clang reads as a symbol: a symbol's with an addend past 32 bits,
	// a label-difference constant's past them.
	var big int64 = 0x100000000
	e = x64TlsCase(e, "movabs rax, [x + 0x100000000]", "48 a1 00 00 00 00 00 00 00 00", abs, 2, big)
	e = x64TlsCase(e, "movabs rax, x + 0x100000000", "48 a1 00 00 00 00 00 00 00 00", abs, 2, big)
	e = x64TlsCase(e, "movabs rax, [x@TPOFF + 0x100000000]", "48 a1 00 00 00 00 00 00 00 00",
			x64.FIX_TPOFF64, 2, big)
	e = x64SrcHex(e, buf.Concat(x64Diff, "movabs rax, [N + 0x100000000]"),
			"90 90 48 a1 01 00 00 00 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "movabs rax, N + 0x100000000"),
			"90 90 48 a1 01 00 00 00 01 00 00 00")
	return e
}

// What clang reads with the address's low 32 bits kept is an error — a 64-bit address with
// another register or instruction, and MOV's of an address clang reads as a symbol (a disp32 to
// it) — and so is what it rejects: MOVABS's memory with another register, a base, rip or a size
// other than the register's.
func TestX64MoffsRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "mov rbx, [0x123456789]")
	e = x64LineRejected(e, "add rax, [0x123456789]")
	e = x64LineRejected(e, "lea rax, [0x123456789]")
	e = x64LineRejected(e, "movabs rbx, [x]")
	e = x64LineRejected(e, "movabs rax, [rbx]")
	e = x64LineRejected(e, "movabs rax, [rip + x]")
	e = x64LineRejected(e, "movabs rax, byte ptr [0x10]")
	e = x64LineRejected(e, "push qword ptr [0x123456789]")
	e = x64LineRejected(e, "jmp qword ptr [0x123456789]")
	e = x64LineRejected(e, "mov rbx, fs:[0x123456789]")
	e = x64LineRejected(e, "movabs rbx, fs:[0x10]")
	e = x64LineRejected(e, "mov rax, [x + 0x100000000]")
	e = x64LineRejected(e, "mov rax, [x@TPOFF + 0x100000000]")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, [N + 0x100000000]"), "movabs takes it whole")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, [N + 0x7fffffff]"), "movabs takes it whole")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, N + 0x100000000"), "movabs takes it whole")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, fs:[N - 0x80000002]"), "movabs takes it whole")
	return e
}
