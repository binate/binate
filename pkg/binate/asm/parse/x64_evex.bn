package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/avx"

// AVX-512's operands as clang takes them in Intel syntax: the registers xmm16 .. xmm31, ymm16 ..
// ymm31, zmm0 .. zmm31 and k0 .. k7; an operand's decorations after it — a write mask {k1} ..
// {k7} and zeroing {z} (on the first operand), a broadcast {1to2} .. {1to32} (on memory) — and
// the rounding operands {rn-sae}, {rd-sae}, {ru-sae}, {rz-sae} and {sae}, with spaces inside the
// braces as clang takes them.  The names in the braces but a mask register's are in lower case, as
// GNU as has them (clang also takes a rounding operand's `sae` after its `-` in any case:
// {rn-SAE}); zeroing without a mask is the encoder's error (pkg/binate/asm/x64/avx), as GNU as's
// (clang drops the {z}).

// x64RegIndex returns i of the register name <kind><i> (in any case, i of one or two digits with no
// leading zero), or -1.
func x64RegIndex(name *[]readonly char, kind *[]readonly char) int {
	var n int = len(kind)
	if len(name) < n + 1 || len(name) > n + 2 || !mnemIs(name[0:n], kind) { return -1 }
	var v int = 0
	for i := n; i < len(name); i++ {
		if name[i] < '0' || name[i] > '9' { return -1 }
		v = v * 10 + cast(int, name[i]) - cast(int, '0')
	}
	if len(name) == n + 2 && name[n] == '0' { return -1 }
	return v
}

// x64EvexReg returns the number and size of an AVX-512 register's name (in any case): xmm16 ..
// xmm31 (avx.XMM16 + i - 16, x64.SZ128), ymm16 .. ymm31 (avx.YMM16 + i - 16), zmm0 .. zmm31
// (avx.ZMM0 + i, x64.SZ512) or k0 .. k7 (avx.K0 + i, x64.SZ64) — or -1 and 0.
func x64EvexReg(name *[]readonly char) (int, int) {
	var i int = x64RegIndex(name, "xmm")
	if i >= 16 && i <= 31 { return avx.XMM16 + i - 16, x64.SZ128 }
	i = x64RegIndex(name, "ymm")
	if i >= 16 && i <= 31 { return avx.YMM16 + i - 16, x64.SZ256 }
	i = x64RegIndex(name, "zmm")
	if i >= 0 && i <= 31 { return avx.ZMM0 + i, x64.SZ512 }
	i = x64RegIndex(name, "k")
	if i >= 0 && i <= 7 { return avx.K0 + i, x64.SZ64 }
	return -1, 0
}

// parseX64Decorations reads the decorations of op after it (tok a `{`, l just after it) — {k1} ..
// {k7} (a mask register's name, in any case), {z} and {1to2} .. {1to32} (after memory), each at
// most once, in any order — into op's Mask, Zero and Bcst, and returns the token after them.
func parseX64Decorations(p @Parser, l Lexer, tok Token,
		op x64.Operand) (Lexer, Token, x64.Operand) {
	for tok.Kind == TOK_LBRACE {
		var d Token
		l, d = LexNext(l)
		var reg int = -1
		var regSize int = 0
		if d.Kind == TOK_IDENT { reg, regSize = x64EvexReg(d.Text) }
		if d.Kind == TOK_INT && d.Ival == 1 {
			var n Token
			l, n = LexNext(l)
			var count int = x64BroadcastCount(n)
			if count < 0 {
				setErr(p, "a broadcast is {1to2}, {1to4}, {1to8}, {1to16} or {1to32}")
			} else if op.Bcst != 0 || !x64.IsMem(op) {
				setErr(p, "a broadcast {1toN} follows a memory operand, once")
			}
			op.Bcst = count
		} else if d.Kind == TOK_IDENT && charsEqual(d.Text, "z") {
			if op.Zero { setErr(p, "zeroing {z} is written once") }
			op.Zero = true
		} else if regSize == x64.SZ64 && reg > avx.K0 {
			if op.Mask != 0 { setErr(p, "a write mask is written once") }
			op.Mask = reg - avx.K0
		} else if regSize == x64.SZ64 {
			setErr(p, "k0 is no write mask (it stands for none): write {k1} .. {k7}")
		} else {
			setErr(p, "a decoration is a write mask {k1} .. {k7}, zeroing {z} or a broadcast {1toN}")
		}
		if p.HasError { return l, tok, op }
		var close Token
		l, close = LexNext(l)
		if close.Kind != TOK_RBRACE {
			setErr(p, "expected '}' after a decoration")
			return l, close, op
		}
		l, tok = LexNext(l)
	}
	return l, tok, op
}

// x64BroadcastCount returns N of a broadcast's `to<N>` (tok; N 2, 4, 8, 16 or 32, in lower case),
// or -1.
func x64BroadcastCount(tok Token) int {
	if tok.Kind != TOK_IDENT { return -1 }
	if charsEqual(tok.Text, "to2") { return 2 }
	if charsEqual(tok.Text, "to4") { return 4 }
	if charsEqual(tok.Text, "to8") { return 8 }
	if charsEqual(tok.Text, "to16") { return 16 }
	if charsEqual(tok.Text, "to32") { return 32 }
	return -1
}

// parseX64Rounding reads a rounding operand (tok a `{`, l just after it): {rn-sae}, {rd-sae},
// {ru-sae} or {rz-sae} (x64.Round 0..3) or {sae} (x64.Round 4), and returns the token after it.
func parseX64Rounding(p @Parser, l Lexer, tok Token) (Lexer, Token, x64.Operand) {
	var d Token
	l, d = LexNext(l)
	var mode int = -1
	if d.Kind == TOK_IDENT && charsEqual(d.Text, "sae") {
		mode = 4
	} else if d.Kind == TOK_IDENT {
		if charsEqual(d.Text, "rn") { mode = 0 }
		if charsEqual(d.Text, "rd") { mode = 1 }
		if charsEqual(d.Text, "ru") { mode = 2 }
		if charsEqual(d.Text, "rz") { mode = 3 }
		var minus Token
		var sae Token
		l, minus = LexNext(l)
		l, sae = LexNext(l)
		if minus.Kind != TOK_MINUS || sae.Kind != TOK_IDENT || !charsEqual(sae.Text, "sae") { mode = -1 }
	}
	var close Token
	l, close = LexNext(l)
	if mode < 0 || close.Kind != TOK_RBRACE {
		setErr(p, "a rounding operand is {rn-sae}, {rd-sae}, {ru-sae}, {rz-sae} or {sae}")
		return l, close, x64.Imm(0)
	}
	l, tok = LexNext(l)
	return l, tok, x64.Round(mode)
}
