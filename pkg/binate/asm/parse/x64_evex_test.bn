package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// AVX-512's operands (x64_evex.bn) against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`): the registers' names in any case, the decorations in each order and
// spacing clang takes, the rounding operands where each instruction takes them, a compare
// predicate's name with {sae}, the compressed displacement, {disp8} / {disp32} and {evex}.
func TestX64EvexOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps ZMM31, Zmm30, zmm29", "62 01 0c 40 58 fd")
	e = x64SrcHex(e, "vaddps ymm31, ymm16, ymm17", "62 21 7c 20 58 f9")
	e = x64SrcHex(e, "vaddps xmm16, xmm1, xmm2", "62 e1 74 08 58 c2")
	e = x64SrcHex(e, "kmovw K7, K0", "c5 f8 90 f8")
	e = x64SrcHex(e, "vaddps xmm31 {k7} {z}, xmm30, xmm29", "62 01 0c 87 58 fd")
	e = x64SrcHex(e, "vaddps xmm0 {k1}, xmm1, xmm16", "62 b1 74 09 58 c0")
	e = x64SrcHex(e, "vaddps zmm0 {k1}, zmm1, zmm2", "62 f1 74 49 58 c2")
	e = x64SrcHex(e, "vaddps zmm0{k1}, zmm1, zmm2", "62 f1 74 49 58 c2")
	e = x64SrcHex(e, "vaddps zmm0 { k1 }, zmm1, zmm2", "62 f1 74 49 58 c2")
	e = x64SrcHex(e, "vaddps zmm0 {K1}, zmm1, zmm2", "62 f1 74 49 58 c2")
	e = x64SrcHex(e, "vaddps zmm0 {k1}{z}, zmm1, zmm2", "62 f1 74 c9 58 c2")
	e = x64SrcHex(e, "vaddps zmm0 {z}{k1}, zmm1, zmm2", "62 f1 74 c9 58 c2")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, dword ptr [rax]{1to16}", "62 f1 74 58 58 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, dword ptr [rax] {1to16}", "62 f1 74 58 58 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, [rax]{1to16}", "62 f1 74 58 58 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, dword ptr [rax]{ 1to16 }", "62 f1 74 58 58 00")
	e = x64SrcHex(e, "vaddps zmm0 {k1}, zmm1, dword ptr [rax]{1to16}", "62 f1 74 59 58 00")
	e = x64SrcHex(e, "vcvtpd2ps xmm0, [rax]{1to2}", "62 f1 fd 18 5a 00")
	e = x64SrcHex(e, "vcvtpd2ps xmm0, qword ptr [rax]{1to4}", "62 f1 fd 38 5a 00")
	e = x64SrcHex(e, "vcvtpd2ps ymm0, [rax]{1to8}", "62 f1 fd 58 5a 00")
	e = x64SrcHex(e, "vpermilpd zmm0 {k1}, [rax]{1to8}, 3", "62 f3 fd 59 05 00 03")
	e = x64SrcHex(e, "vmovaps zmmword ptr [rax] {k1}, zmm0", "62 f1 7c 49 29 00")
	e = x64SrcHex(e, "vmovaps zmm0 {k1} {z}, zmmword ptr [rax]", "62 f1 7c c9 28 00")
	e = x64SrcHex(e, "vmovss xmm0 {k1} {z}, xmm1, xmm2", "62 f1 76 89 10 c2")
	e = x64SrcHex(e, "vbroadcastss zmm0 {k1}, xmm1", "62 f2 7d 49 18 c1")
	e = x64SrcHex(e, "vextractps eax, xmm16, 1", "62 e3 7d 08 17 c0 01")
	return e
}

func TestX64EvexRounding() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps zmm0 {k1} {z}, zmm1, zmm2, {rn-sae}", "62 f1 74 99 58 c2")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmm2, { rn-sae }", "62 f1 74 18 58 c2")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmm2, {rn - sae}", "62 f1 74 18 58 c2")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmm2, {rd-sae}", "62 f1 74 38 58 c2")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmm2, {ru-sae}", "62 f1 74 58 58 c2")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmm2, {rz-sae}", "62 f1 74 78 58 c2")
	e = x64SrcHex(e, "vaddss xmm0, xmm1, xmm2, {rn-sae}", "62 f1 76 18 58 c2")
	e = x64SrcHex(e, "vsqrtss xmm0 {k1}, xmm1, xmm2, {ru-sae}", "62 f1 76 59 51 c2")
	e = x64SrcHex(e, "vminps zmm0, zmm1, zmm2, {sae}", "62 f1 74 18 5d c2")
	e = x64SrcHex(e, "vcmpps k1, zmm0, zmm1, {sae}, 1", "62 f1 7c 18 c2 c9 01")
	e = x64SrcHex(e, "vcmpps k1 {k2}, zmm0, zmm1, 1", "62 f1 7c 4a c2 c9 01")
	e = x64SrcHex(e, "vcmpeqps k1, zmm0, zmm1, {sae}", "62 f1 7c 18 c2 c9 00")
	e = x64SrcHex(e, "vcmpeqps k1 {k2}, zmm0, zmm1", "62 f1 7c 4a c2 c9 00")
	e = x64SrcHex(e, "vcmpeqps k1, zmm0, dword ptr [rax]{1to16}", "62 f1 7c 58 c2 08 00")
	e = x64SrcHex(e, "vcmpeqss k1, xmm0, xmm1, {sae}", "62 f1 7e 18 c2 c9 00")
	e = x64SrcHex(e, "vcvtsi2ss xmm0, xmm1, {rn-sae}, eax", "62 f1 76 18 2a c0")
	e = x64SrcHex(e, "vcvtsi2sd xmm0, xmm1, {rn-sae}, rax", "62 f1 f7 18 2a c0")
	e = x64SrcHex(e, "vcvtss2si eax, xmm0, {rn-sae}", "62 f1 7e 18 2d c0")
	e = x64SrcHex(e, "vcvttss2si eax, xmm0, {sae}", "62 f1 7e 18 2c c0")
	e = x64SrcHex(e, "vcvtsi2sd xmm16, xmm1, dword ptr [rax + 4]", "62 e1 77 08 2a 40 01")
	e = x64SrcHex(e, "vcvtsi2sd xmm16, xmm1, qword ptr [rax + 8]", "62 e1 f7 08 2a 40 01")
	return e
}

// The displacement compressed by the memory's size, or a broadcast's element's, where it divides
// it and the quotient fits a byte, else 32 bits; and after {disp8} / {disp32}.
func TestX64EvexDisp() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax + 64]", "62 f1 74 48 58 40 01")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax + 4]", "62 f1 74 48 58 80 04 00 00 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax + 8128]", "62 f1 74 48 58 40 7f")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax + 8192]", "62 f1 74 48 58 80 00 20 00 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax - 8192]", "62 f1 74 48 58 40 80")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax - 8256]", "62 f1 74 48 58 80 c0 df ff ff")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rbp]", "62 f1 74 48 58 45 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [r13]", "62 d1 74 48 58 45 00")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rsp + 128]", "62 f1 74 48 58 44 24 02")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, zmmword ptr [rax*2]", "62 f1 74 48 58 04 45 00 00 00 00")
	e = x64SrcHex(e, "vaddps zmm31, zmm30, zmmword ptr [r15 + 64]", "62 41 0c 40 58 7f 01")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, dword ptr [rax + 64]{1to16}", "62 f1 74 58 58 40 10")
	e = x64SrcHex(e, "vaddps zmm0, zmm1, dword ptr [rax + 4]{1to16}", "62 f1 74 58 58 40 01")
	e = x64SrcHex(e, "{disp8} vaddps zmm0, zmm1, [rax]", "62 f1 74 48 58 40 00")
	e = x64SrcHex(e, "{disp32} vaddps zmm0, zmm1, [rax + 64]", "62 f1 74 48 58 80 40 00 00 00")
	e = x64SrcHex(e, "{disp8} vaddps zmm0, zmm1, [rax + 4]", "62 f1 74 48 58 80 04 00 00 00")
	return e
}

// {evex}: the EVEX form where the VEX one would do, before prefixes are written; with {vex3} the
// last counts.
func TestX64EvexPseudo() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "{evex} vaddps xmm0, xmm1, xmm2", "62 f1 74 08 58 c2")
	e = x64SrcHex(e, "{EVEX} vaddps xmm0, xmm1, xmm2", "62 f1 74 08 58 c2")
	e = x64SrcHex(e, "{evex} vaddps zmm0, zmm1, zmm2", "62 f1 74 48 58 c2")
	e = x64SrcHex(e, "{evex} vaddps xmm0 {k1}, xmm1, xmm2", "62 f1 74 09 58 c2")
	e = x64SrcHex(e, "{evex} vmovaps xmm0, xmm1", "62 f1 7c 08 28 c1")
	e = x64SrcHex(e, "{evex} vmovss xmm0, xmm1, xmm2", "62 f1 76 08 10 c2")
	e = x64SrcHex(e, "{evex} vcvtsi2sd xmm0, xmm1, eax", "62 f1 77 08 2a c0")
	e = x64SrcHex(e, "{evex} {disp32} vaddps xmm0, xmm1, [rax]", "62 f1 74 08 58 80 00 00 00 00")
	e = x64SrcHex(e, "fs {evex} vaddps xmm0, xmm1, [rax]", "64 62 f1 74 08 58 00")
	e = x64SrcHex(e, "fs vaddps zmm0, zmm1, [rax]", "64 62 f1 74 48 58 00")
	e = x64SrcHex(e, "{vex3} {evex} vaddps xmm0, xmm1, xmm2", "62 f1 74 08 58 c2")
	e = x64SrcHex(e, "{evex} {vex3} vaddps xmm0, xmm1, xmm2", "c4 e1 70 58 c2")
	return e
}

// What clang or GNU as rejects: k0 or k8 as a write mask, a decoration's or rounding operand's name
// not in lower case, a decoration twice, a broadcast after a register, of another count or element,
// a write mask or zeroing off the first operand, where the form takes none, or a store's zeroing,
// a rounding operand out of its place or on a form that takes the other, braces not closed; an
// instruction with no EVEX form after {evex}, {evex} before a prefix or beside {rex}, {vex} with
// EVEX's operands, data16; and what clang takes that GNU as does not: zeroing without a write mask
// (clang drops it), zeroing after another operand (clang drops it), an immediate as the rounding
// mode (clang reads it as one).
func TestX64EvexRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "vaddps zmm0 {k0}, zmm1, zmm2", "k0 is no write mask")
	e = x64LineRejected(e, "vaddps zmm0 {k8}, zmm1, zmm2")
	e = x64LineRejected(e, "vaddps zmm0 {k1} {Z}, zmm1, zmm2")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, dword ptr [rax]{1TO16}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmm2, {RN-SAE}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmm2, {rn-SAE}")
	e = x64LineRejected(e, "vminps zmm0, zmm1, zmm2, {SAE}")
	e = x64LineErrorHas(e, "vaddps zmm0 {k1} {k2}, zmm1, zmm2", "once")
	e = x64LineErrorHas(e, "vaddps zmm0 {k1} {z} {z}, zmm1, zmm2", "once")
	e = x64LineErrorHas(e, "vaddps zmm0, zmm1, dword ptr [rax]{1to16}{1to16}", "once")
	e = x64LineErrorHas(e, "vaddps zmm0, zmm1, zmm2{1to16}", "follows a memory operand")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, dword ptr [rax]{1to8}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, qword ptr [rax]{1to16}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, dword ptr [rax]{2to16}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, dword ptr [rax]{1to3}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1 {k1}, zmm2")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmmword ptr [rax] {k1}")
	e = x64LineRejected(e, "vcomiss xmm0 {k1}, xmm1")
	e = x64LineRejected(e, "kmovw k1 {k2}, k3")
	e = x64LineRejected(e, "vcmpps k1 {k2} {z}, zmm0, zmm1, 1")
	e = x64LineRejected(e, "vmovaps zmmword ptr [rax] {k1} {z}, zmm0")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmm2, {sae}")
	e = x64LineRejected(e, "vminps zmm0, zmm1, zmm2, {rn-sae}")
	e = x64LineRejected(e, "vaddps ymm0, ymm1, ymm2, {rn-sae}")
	e = x64LineRejected(e, "vaddps zmm0, {rn-sae}, zmm1, zmm2")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmmword ptr [rax], {rn-sae}")
	e = x64LineRejected(e, "vcmpps k1, zmm0, zmm1, 1, {sae}")
	e = x64LineRejected(e, "vcvtsi2sd xmm0, xmm1, {rn-sae}, eax")
	e = x64LineRejected(e, "vcvtsi2ss xmm0, xmm1, eax, {rn-sae}")
	e = x64LineErrorHas(e, "vcvtsi2sd xmm16, xmm1, [rax]", "ambiguous operand size")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmm2, {rn-sae")
	e = x64LineRejected(e, "vaddps zmm0 {k1, zmm1, zmm2")
	e = x64LineRejected(e, "vaddps zmm0 {}, zmm1, zmm2")
	e = x64LineErrorHas(e, "{evex} vzeroupper", "no EVEX form")
	e = x64LineRejected(e, "{evex} kandw k1, k2, k3")
	e = x64LineRejected(e, "{evex} kmovw k1, k2")
	e = x64LineRejected(e, "{evex} vfmaddps xmm0, xmm1, xmm2, xmm3")
	e = x64LineRejected(e, "{evex} vcmpps xmm0, xmm1, xmm2, 0")
	e = x64LineErrorHas(e, "{evex} mov eax, ebx", "stands before an EVEX-encoded instruction")
	e = x64LineErrorHas(e, "{evex} fs vaddps xmm0, xmm1, [rax]", "after prefixes")
	e = x64LineRejected(e, "{evex} {rex} vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "{rex} {evex} vaddps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "{rex} vaddps zmm0, zmm1, zmm2")
	e = x64LineRejected(e, "{vex} vaddps zmm0, zmm1, zmm2")
	e = x64LineRejected(e, "{vex} vaddps xmm0 {k1}, xmm1, xmm2")
	e = x64LineErrorHas(e, "data16 vaddps zmm0, zmm1, zmm2", "data16 cannot stand before")
	e = x64LineErrorHas(e, "vaddps zmm0 {z}, zmm1, zmm2", "beside a write mask")
	e = x64LineRejected(e, "vmovaps zmmword ptr [rax] {z}, zmm0")
	e = x64LineRejected(e, "vaddps zmm0 {k1}, zmm1, zmm2 {z}")
	e = x64LineRejected(e, "vaddps zmm0, zmm1, zmm2, 1")
	e = x64LineRejected(e, "vaddss xmm0, xmm1, xmm2, 1")
	e = x64LineRejected(e, "mov rax, zmm0")
	return e
}
