package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// `[rip + x@GOTPCREL]` operands in every instruction that takes memory, against clang's bytes and
// relocations (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).  (x64TlsCase is in
// x64_tls_test.bn, x64LineRejected in x64_target_test.bn.)

// The fixup of each by what a linker may rewrite, as clang marks it: the 64-bit MOV load
// FIX_GOTPCREL (R_X86_64_REX_GOTPCRELX); a 32- or 64-bit register loaded or operated on from a
// slot (MOV, the ALU group, TEST either way) and CALL / JMP relaxable — FIX_REX_GOTPCRELX with a
// REX prefix, FIX_GOTPCRELX without; any other FIX_GOTPCREL_PLAIN (a store, 8 / 16 bits, an
// immediate after it, which comes off the addend, and LEA, as GNU as: clang's relaxable 64-bit
// LEA is rewritten into an ALU operation by GNU ld and lld).
func TestX64GotOperands() testing.TestResult {
	var e @[]char = ""
	var rx int = x64.FIX_GOTPCRELX
	var rrx int = x64.FIX_REX_GOTPCRELX
	var pl int = x64.FIX_GOTPCREL_PLAIN
	e = x64TlsCase(e, "mov rax, qword ptr [rip + x@GOTPCREL]", "48 8b 05 00 00 00 00",
			x64.FIX_GOTPCREL, 3, 0)
	e = x64TlsCase(e, "mov eax, dword ptr [rip + x@GOTPCREL]", "8b 05 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "mov eax, [rip + x@GOTPCREL]", "8b 05 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "mov r8d, dword ptr [rip + x@GOTPCREL]", "44 8b 05 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "mov eax, dword ptr x@GOTPCREL[rip]", "8b 05 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "add rax, qword ptr [rip + x@GOTPCREL]", "48 03 05 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "cmp eax, dword ptr [rip + x@GOTPCREL]", "3b 05 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "sbb r8, qword ptr [rip + x@GOTPCREL]", "4c 1b 05 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "test qword ptr [rip + x@GOTPCREL], rax", "48 85 05 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "test eax, dword ptr [rip + x@GOTPCREL]", "85 05 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "lea rax, [rip + x@GOTPCREL]", "48 8d 05 00 00 00 00", pl, 3, 0)
	e = x64TlsCase(e, "lea eax, [rip + x@GOTPCREL]", "8d 05 00 00 00 00", pl, 2, 0)
	e = x64TlsCase(e, "lea r8d, [rip + x@GOTPCREL]", "44 8d 05 00 00 00 00", pl, 3, 0)
	e = x64TlsCase(e, "call qword ptr [rip + x@GOTPCREL]", "ff 15 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "jmp [rip + x@GOTPCREL]", "ff 25 00 00 00 00", rx, 2, 0)
	e = x64TlsCase(e, "jmp fword ptr [rip + x@GOTPCREL]", "ff 2d 00 00 00 00", pl, 2, 0)
	e = x64TlsCase(e, "add qword ptr [rip + x@GOTPCREL], rax", "48 01 05 00 00 00 00", pl, 3, 0)
	e = x64TlsCase(e, "mov qword ptr [rip + x@GOTPCREL], rax", "48 89 05 00 00 00 00", pl, 3, 0)
	e = x64TlsCase(e, "lock add qword ptr [rip + x@GOTPCREL], rax", "f0 48 01 05 00 00 00 00", pl, 4,
			0)
	e = x64TlsCase(e, "mov ax, word ptr [rip + x@GOTPCREL]", "66 8b 05 00 00 00 00", pl, 3, 0)
	e = x64TlsCase(e, "mov al, byte ptr [rip + x@GOTPCREL]", "8a 05 00 00 00 00", pl, 2, 0)
	e = x64TlsCase(e, "xchg rax, qword ptr [rip + x@GOTPCREL]", "48 87 05 00 00 00 00", pl, 3, 0)
	e = x64TlsCase(e, "push qword ptr [rip + x@GOTPCREL]", "ff 35 00 00 00 00", pl, 2, 0)
	e = x64TlsCase(e, "imul rax, qword ptr [rip + x@GOTPCREL]", "48 0f af 05 00 00 00 00", pl, 4, 0)
	e = x64TlsCase(e, "add qword ptr [rip + x@GOTPCREL], 1", "48 83 05 00 00 00 00 01", pl, 3, -1)
	e = x64TlsCase(e, "cmp dword ptr [rip + x@GOTPCREL], 1000", "81 3d 00 00 00 00 e8 03 00 00", pl, 2,
			-4)
	return e
}

// A GOT slot with an addend (clang: the slot's address plus it, past the slot), one with a base but
// rip, and the moffs form are errors.
func TestX64GotRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "add rax, qword ptr [rip + x@GOTPCREL + 8]")
	e = x64LineRejected(e, "call qword ptr [rip + x@GOTPCREL + 4]")
	e = x64LineRejected(e, "mov eax, dword ptr [rip + x@GOTPCREL - 4]")
	e = x64LineRejected(e, "add rax, qword ptr [rbx + x@GOTPCREL]")
	e = x64LineRejected(e, "movabs rax, [rip + x@GOTPCREL]")
	e = x64LineRejected(e, "mov qword ptr [rip + x@GOTPCREL], qword ptr [rax]")
	return e
}
