package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/gpext"

// The x86-64 general-purpose extensions (pkg/binate/asm/x64/gpext), as clang takes them: BMI1 and
// BMI2 (andn, bextr, blsi, blsmsk, blsr, bzhi, mulx, pdep, pext, rorx, sarx, shlx, shrx), AMD's
// TBM (blcfill, blci, blcic, blcmsk, blcs, blsfill, blsic, t1mskc, tzmsk, and bextr with an
// immediate), adcx / adox, movbe, crc32, movrs and movnti; the remote atomics aadd / aand / aor /
// axor; and cmp<cc>xadd, any of x64's condition spellings between `cmp` and `xadd`.  Their encoders
// check the operands; crc32's source in memory needs a size, which no other operand gives it
// (clang: "ambiguous operand size").

// x64GpextThree reports whether mnem names an extension instruction with three operands.
func x64GpextThree(mnem *[]readonly char) bool {
	return mnemIs(mnem, "andn") || mnemIs(mnem, "bextr") || mnemIs(mnem, "bzhi") ||
			mnemIs(mnem, "mulx") || mnemIs(mnem, "pdep") || mnemIs(mnem, "pext") || mnemIs(mnem, "rorx") ||
			mnemIs(mnem, "sarx") || mnemIs(mnem, "shlx") || mnemIs(mnem, "shrx") ||
			x64CmpccxaddCond(mnem) >= 0
}

// x64CmpccxaddCond returns the condition (x64.CC_*) of the cmp<cc>xadd mnem names, or -1.
func x64CmpccxaddCond(mnem *[]readonly char) int {
	var n int = len(mnem)
	if n < 8 || !mnemIs(mnem[0:3], "cmp") || !mnemIs(mnem[n - 4:n], "xadd") { return -1 }
	return parseX64CondCode(mnem[3:n - 4])
}

// x64GpextTwo reports whether mnem names an extension instruction with two operands.
func x64GpextTwo(mnem *[]readonly char) bool {
	return mnemIs(mnem, "blsi") || mnemIs(mnem, "blsmsk") || mnemIs(mnem, "blsr") ||
			mnemIs(mnem, "blcfill") || mnemIs(mnem, "blci") || mnemIs(mnem, "blcic") ||
			mnemIs(mnem, "blcmsk") || mnemIs(mnem, "blcs") || mnemIs(mnem, "blsfill") ||
			mnemIs(mnem, "blsic") || mnemIs(mnem, "t1mskc") || mnemIs(mnem, "tzmsk") ||
			mnemIs(mnem, "adcx") || mnemIs(mnem, "adox") || mnemIs(mnem, "movbe") || mnemIs(mnem, "crc32") ||
			x64WordIndex(mnem, " aadd aand aor axor movrs movnti ") >= 0
}

// x64GpextInstruction parses and emits the extension instruction mnem (l just after it) when it
// names one, and reports whether it did.
func x64GpextInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	var three bool = x64GpextThree(mnem)
	if !three && !x64GpextTwo(mnem) { return false }
	var tok Token
	l, tok = LexNext(l)
	var dst x64.Operand
	l, tok, dst = parseX64Operand(p, l, tok)
	if p.HasError { return true }
	var src x64.Operand
	l, tok, src = expectX64CommaOp(p, l, tok)
	if p.HasError { return true }
	var third x64.Operand = x64.Imm(0)
	if three {
		l, tok, third = expectX64CommaOp(p, l, tok)
		if p.HasError { return true }
	}
	if !x64AtEOL(p, tok) || !x64TlsCallOk(p, dst) || !x64TlsCallOk(p, src) || !x64TlsCallOk(p, third) {
		return true
	}
	if mnemIs(mnem, "crc32") && x64Unsized(src) {
		x64AmbiguousSize(p, mnem)
		return true
	}
	x64EmitSeg(p)
	if three {
		x64EmitGpextThree(p.Asm, mnem, dst, src, third)
	} else {
		x64EmitGpextTwo(p.Asm, mnem, dst, src)
	}
	return true
}

// x64EmitGpextThree emits the three-operand extension instruction mnem (x64GpextThree).
func x64EmitGpextThree(a @asm.Assembler, mnem *[]readonly char, dst x64.Operand, src x64.Operand,
		third x64.Operand) {
	var cc int = x64CmpccxaddCond(mnem)
	if cc >= 0 {
		gpext.Cmpccxadd(a, cc, dst, src, third)
		return
	}
	if mnemIs(mnem, "andn") {
		gpext.Andn(a, dst, src, third)
	} else if mnemIs(mnem, "bextr") {
		gpext.Bextr(a, dst, src, third)
	} else if mnemIs(mnem, "bzhi") {
		gpext.Bzhi(a, dst, src, third)
	} else if mnemIs(mnem, "mulx") {
		gpext.Mulx(a, dst, src, third)
	} else if mnemIs(mnem, "pdep") {
		gpext.Pdep(a, dst, src, third)
	} else if mnemIs(mnem, "pext") {
		gpext.Pext(a, dst, src, third)
	} else if mnemIs(mnem, "rorx") {
		gpext.Rorx(a, dst, src, third)
	} else if mnemIs(mnem, "sarx") {
		gpext.Sarx(a, dst, src, third)
	} else if mnemIs(mnem, "shlx") {
		gpext.Shlx(a, dst, src, third)
	} else {
		gpext.Shrx(a, dst, src, third)
	}
}

// x64EmitGpextTwo emits the two-operand extension instruction mnem (x64GpextTwo).
func x64EmitGpextTwo(a @asm.Assembler, mnem *[]readonly char, dst x64.Operand, src x64.Operand) {
	if mnemIs(mnem, "blsi") {
		gpext.Blsi(a, dst, src)
	} else if mnemIs(mnem, "blsmsk") {
		gpext.Blsmsk(a, dst, src)
	} else if mnemIs(mnem, "blsr") {
		gpext.Blsr(a, dst, src)
	} else if mnemIs(mnem, "blcfill") {
		gpext.Blcfill(a, dst, src)
	} else if mnemIs(mnem, "blci") {
		gpext.Blci(a, dst, src)
	} else if mnemIs(mnem, "blcic") {
		gpext.Blcic(a, dst, src)
	} else if mnemIs(mnem, "blcmsk") {
		gpext.Blcmsk(a, dst, src)
	} else if mnemIs(mnem, "blcs") {
		gpext.Blcs(a, dst, src)
	} else if mnemIs(mnem, "blsfill") {
		gpext.Blsfill(a, dst, src)
	} else if mnemIs(mnem, "blsic") {
		gpext.Blsic(a, dst, src)
	} else if mnemIs(mnem, "t1mskc") {
		gpext.T1mskc(a, dst, src)
	} else if mnemIs(mnem, "tzmsk") {
		gpext.Tzmsk(a, dst, src)
	} else if mnemIs(mnem, "adcx") {
		gpext.Adcx(a, dst, src)
	} else if mnemIs(mnem, "adox") {
		gpext.Adox(a, dst, src)
	} else if mnemIs(mnem, "movbe") {
		gpext.Movbe(a, dst, src)
	} else if mnemIs(mnem, "aadd") {
		gpext.Aadd(a, dst, src)
	} else if mnemIs(mnem, "aand") {
		gpext.Aand(a, dst, src)
	} else if mnemIs(mnem, "aor") {
		gpext.Aor(a, dst, src)
	} else if mnemIs(mnem, "axor") {
		gpext.Axor(a, dst, src)
	} else if mnemIs(mnem, "movrs") {
		gpext.Movrs(a, dst, src)
	} else if mnemIs(mnem, "movnti") {
		gpext.Movnti(a, dst, src)
	} else {
		gpext.Crc32(a, dst, src)
	}
}
