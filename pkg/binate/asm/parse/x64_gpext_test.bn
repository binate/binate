package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// The general-purpose extensions (x64_gpext.bn) against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`); the encodings are checked in full by
// package gpext's tests, these the parsing.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn, x64TlsCase in x64_tls_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// Every mnemonic, in upper case too, with registers, memory of each written size and of none, a
// segment override before the VEX and XOP prefixes and the legacy ones, and immediates written as
// expressions.
func TestX64GpextInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "andn rax, r15, qword ptr [r12 + r13*8 + 8]", "c4 82 80 f2 44 ec 08")
	e = x64SrcHex(e, "andn eax, ebx, [rcx]", "c4 e2 60 f2 01")
	e = x64SrcHex(e, "ANDN eax, ebx, ecx", "c4 e2 60 f2 c1")
	e = x64SrcHex(e, "andn r15, r14, qword ptr gs:[r13 + r12*4]", "65 c4 02 88 f2 7c a5 00")
	e = x64SrcHex(e, "bextr r15d, dword ptr [r14 + 4], r13d", "c4 42 10 f7 7e 04")
	e = x64SrcHex(e, "bextr rax, [rbx], rcx", "c4 e2 f0 f7 03")
	e = x64SrcHex(e, "blsi rax, qword ptr [rbx]", "c4 e2 f8 f3 1b")
	e = x64SrcHex(e, "blsmsk r8, r9", "c4 c2 b8 f3 d1")
	e = x64SrcHex(e, "blsr eax, [rbx]", "c4 e2 78 f3 0b")
	e = x64SrcHex(e, "bzhi rax, qword ptr [rbx], r8", "c4 e2 b8 f5 03")
	e = x64SrcHex(e, "mulx r8, r9, r10", "c4 42 b3 f6 c2")
	e = x64SrcHex(e, "mulx rax, rbx, [rcx]", "c4 e2 e3 f6 01")
	e = x64SrcHex(e, "pdep rax, r8, qword ptr [rbx]", "c4 e2 bb f5 03")
	e = x64SrcHex(e, "pext r12, r13, r14", "c4 42 92 f5 e6")
	e = x64SrcHex(e, "rorx rax, qword ptr [rbx], 63", "c4 e3 fb f0 03 3f")
	e = x64SrcHex(e, "rorx eax, ebx, 3 + 4", "c4 e3 7b f0 c3 07")
	e = x64SrcHex(e, "rorx r8d, r9d, -1", "c4 43 7b f0 c1 ff")
	e = x64SrcHex(e, "N = 4\nrorx eax, ebx, N", "c4 e3 7b f0 c3 04")
	e = x64SrcHex(e, "sarx eax, ebx, ecx", "c4 e2 72 f7 c3")
	e = x64SrcHex(e, "shlx rax, qword ptr [rbx], rcx", "c4 e2 f1 f7 03")
	e = x64SrcHex(e, "shrx r8d, r9d, r10d", "c4 42 2b f7 c1")
	e = x64SrcHex(e, "blcfill r15d, dword ptr [r14 + r13*2]", "8f 89 00 01 0c 6e")
	e = x64SrcHex(e, "blci r9d, dword ptr fs:[rax]", "64 8f e9 30 02 30")
	e = x64SrcHex(e, "blci rax, qword ptr [rbx]", "8f e9 f8 02 33")
	e = x64SrcHex(e, "blcic eax, ebx", "8f e9 78 01 eb")
	e = x64SrcHex(e, "blcmsk r8, r9", "8f c9 b8 02 c9")
	e = x64SrcHex(e, "blcs eax, ebx", "8f e9 78 01 db")
	e = x64SrcHex(e, "blsfill eax, ebx", "8f e9 78 01 d3")
	e = x64SrcHex(e, "blsic eax, ebx", "8f e9 78 01 f3")
	e = x64SrcHex(e, "t1mskc eax, ebx", "8f e9 78 01 fb")
	e = x64SrcHex(e, "TZMSK eax, ebx", "8f e9 78 01 e3")
	e = x64SrcHex(e, "bextr eax, ebx, 0x1234", "8f ea 78 10 c3 34 12 00 00")
	e = x64SrcHex(e, "bextr eax, [rbx], 5", "8f ea 78 10 03 05 00 00 00")
	e = x64SrcHex(e, "bextr rax, rbx, -0x80000000", "8f ea f8 10 c3 00 00 00 80")
	e = x64SrcHex(e, "adcx r15d, dword ptr fs:[r14]", "64 66 45 0f 38 f6 3e")
	e = x64SrcHex(e, "adcx eax, [rbx]", "66 0f 38 f6 03")
	e = x64SrcHex(e, "adox r8, r9", "f3 4d 0f 38 f6 c1")
	e = x64SrcHex(e, "movbe eax, dword ptr [rbx]", "0f 38 f0 03")
	e = x64SrcHex(e, "movbe [rbx], eax", "0f 38 f1 03")
	e = x64SrcHex(e, "movbe word ptr fs:[rbx], ax", "64 66 0f 38 f1 03")
	e = x64SrcHex(e, "movbe r15w, word ptr [r14 + r13*2 + 0x1000]", "66 47 0f 38 f0 bc 6e 00 10 00 00")
	e = x64SrcHex(e, "crc32 eax, bx", "66 f2 0f 38 f1 c3")
	e = x64SrcHex(e, "crc32 rax, byte ptr [rbx]", "f2 48 0f 38 f0 03")
	e = x64SrcHex(e, "crc32 eax, sil", "f2 40 0f 38 f0 c6")
	e = x64SrcHex(e, "crc32 r15, qword ptr [r14 + r13*8 - 8]", "f2 4f 0f 38 f1 7c ee f8")
	e = x64SrcHex(e, "CRC32 eax, ebx", "f2 0f 38 f1 c3")
	return e
}

// `[rip + x]` operands' rel32s, counting past an imm8 or imm32 after them; GOT slots, whose
// relocation is the plain GOTPCREL; and symbolic immediates.
func TestX64GpextSymbols() testing.TestResult {
	var e @[]char = ""
	var rel int = x64.FIX_REL32_LEA
	var got int = x64.FIX_GOTPCREL_PLAIN
	e = x64TlsCase(e, "andn eax, ebx, dword ptr [rip + x]", "c4 e2 60 f2 05 00 00 00 00", rel, 5, 0)
	e = x64TlsCase(e, "rorx eax, dword ptr [rip + x], 1", "c4 e3 7b f0 05 00 00 00 00 01", rel, 5, -1)
	e = x64TlsCase(e, "bextr eax, dword ptr [rip + x], 7", "8f ea 78 10 05 00 00 00 00 07 00 00 00",
			rel, 5, -4)
	e = x64TlsCase(e, "blci eax, dword ptr [rip + x]", "8f e9 78 02 35 00 00 00 00", rel, 5, 0)
	e = x64TlsCase(e, "adox eax, dword ptr [rip + x]", "f3 0f 38 f6 05 00 00 00 00", rel, 5, 0)
	e = x64TlsCase(e, "crc32 eax, byte ptr [rip + x]", "f2 0f 38 f0 05 00 00 00 00", rel, 5, 0)
	e = x64TlsCase(e, "andn eax, ebx, dword ptr [rip + x@GOTPCREL]", "c4 e2 60 f2 05 00 00 00 00", got,
			5, 0)
	e = x64TlsCase(e, "movbe eax, dword ptr [rip + x@GOTPCREL]", "0f 38 f0 05 00 00 00 00", got, 4, 0)
	e = x64TlsCase(e, "crc32 eax, dword ptr [rip + x@GOTPCREL]", "f2 0f 38 f1 05 00 00 00 00", got, 5,
			0)
	e = x64TlsCase(e, "adcx rax, qword ptr [rip + x@GOTPCREL]", "66 48 0f 38 f6 05 00 00 00 00", got,
			6, 0)
	e = x64TlsCase(e, "rorx eax, dword ptr [rip + x@GOTPCREL], 3", "c4 e3 7b f0 05 00 00 00 00 03",
			got, 5, -1)
	e = x64TlsCase(e, "rorx eax, ebx, offset x", "c4 e3 7b f0 c3 00", asm.FIX_DATA_ABS8, 5, 0)
	e = x64TlsCase(e, "bextr eax, ebx, offset x", "8f ea 78 10 c3 00 00 00 00", asm.FIX_DATA_ABS32, 5,
			0)
	e = x64TlsCase(e, "bextr rax, rbx, offset x + 4", "8f ea f8 10 c3 00 00 00 00", x64.FIX_ABS32S, 5,
			4)
	return e
}

// What clang rejects: operands of the wrong size or kind, a count out of range, the wrong number
// of operands, crc32's unsized memory, GNU as's AT&T-only crc32b / crc32l / crc32q; and what it
// takes that bnas does not: a lock or repeat prefix (clang drops a lock before andn), and APX's
// EVEX-encoded forms, movbe between registers and adcx / adox with three operands.
func TestX64GpextRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "andn ax, bx, cx")
	e = x64LineRejected(e, "andn eax, ebx, rcx")
	e = x64LineRejected(e, "andn eax, ebx, 5")
	e = x64LineRejected(e, "andn eax, ebx, qword ptr [rcx]")
	e = x64LineRejected(e, "andn dword ptr [rax], ebx, ecx")
	e = x64LineRejected(e, "andn eax, ebx")
	e = x64LineRejected(e, "blsi eax, ebx, ecx")
	e = x64LineRejected(e, "sarx rax, rbx, ecx")
	e = x64LineRejected(e, "rorx eax, ebx, ecx")
	e = x64LineRejected(e, "rorx eax, ebx, 256")
	e = x64LineRejected(e, "rorx eax, ebx, -129")
	e = x64LineRejected(e, "bextr eax, ebx, 0x100000000")
	e = x64LineRejected(e, "bextr rax, rbx, 0xffffffff")
	e = x64LineRejected(e, "tzmsk eax, 5")
	e = x64LineRejected(e, "adcx ax, bx")
	e = x64LineRejected(e, "adcx rax, dword ptr [rbx]")
	e = x64LineRejected(e, "movbe al, byte ptr [rbx]")
	e = x64LineRejected(e, "movbe dword ptr [rbx], 5")
	e = x64LineRejected(e, "crc32 ax, bx")
	e = x64LineRejected(e, "crc32 rax, ebx")
	e = x64LineRejected(e, "crc32 rax, word ptr [rbx]")
	e = x64LineRejected(e, "crc32b eax, bl")
	e = x64LineRejected(e, "crc32l eax, ebx")
	e = x64LineRejected(e, "crc32q rax, rbx")
	e = x64LineErrorHas(e, "crc32 eax, [rbx]", "ambiguous operand size")
	e = x64LineRejected(e, "lock andn eax, ebx, dword ptr [rcx]")
	e = x64LineRejected(e, "lock adcx eax, dword ptr [rcx]")
	e = x64LineRejected(e, "rep andn eax, ebx, ecx")
	e = x64LineRejected(e, "repne crc32 eax, ebx")
	e = x64LineErrorHas(e, "movbe eax, ebx", "APX")
	e = x64LineRejected(e, "adox rax, rbx, rcx")
	e = x64LineRejected(e, "adcx eax, ebx, ecx")
	return e
}

// The remote atomics and cmp<cc>xadd, every condition spelling and upper case among them; what
// clang rejects (operands of the wrong kind or size); and what GNU as rejects that clang emits: a
// lock prefix.
func TestX64RemoteAtomics() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "aadd dword ptr [rax], ebx", "0f 38 fc 18")
	e = x64SrcHex(e, "AADD [rax], rbx", "48 0f 38 fc 18")
	e = x64SrcHex(e, "aadd [r9], r10d", "45 0f 38 fc 11")
	e = x64SrcHex(e, "aand qword ptr [rax], rbx", "66 48 0f 38 fc 18")
	e = x64SrcHex(e, "aor [rax], ebx", "f2 0f 38 fc 18")
	e = x64SrcHex(e, "axor [rax], ebx", "f3 0f 38 fc 18")
	e = x64TlsCase(e, "axor qword ptr [rip + x], rax", "f3 48 0f 38 fc 05 00 00 00 00",
			x64.FIX_REL32_LEA, 6, 0)
	var conds *[]readonly char =
		" o no b c nae ae nb nc e z ne nz be na a nbe s ns p pe np po l nge ge "
				"nl le ng g nle "
	var codes *[]readonly char =
		"e0 e1 e2 e2 e2 e3 e3 e3 e4 e4 e5 e5 e6 e6 e7 e7 e8 e9 ea ea eb eb ec ec "
				"ed ed ee ee ef ef "
	var start int = 1
	var k int = 0
	for i := 1; i < len(conds); i++ {
		if conds[i] != ' ' { continue }
		var line @[]char = buf.Concat(buf.Concat("cmp", conds[start:i]), "xadd [rax], ebx, ecx")
		e = x64SrcHex(e, line, buf.Concat(buf.Concat("c4 e2 71 ", codes[k * 3:k * 3 + 2]), " 18"))
		start = i + 1
		k++
	}
	e = x64SrcHex(e, "CMPZXADD qword ptr [rax], rbx, rcx", "c4 e2 f1 e4 18")
	e = x64SrcHex(e, "cmpnzxadd [r9], r10, r11", "c4 42 a1 e5 11")
	e = x64TlsCase(e, "cmpzxadd qword ptr [rip + x], rbx, rcx", "c4 e2 f1 e4 1d 00 00 00 00",
			x64.FIX_REL32_LEA, 5, 0)
	e = x64LineRejected(e, "aadd [rax], 5")
	e = x64LineRejected(e, "aadd ebx, [rax]")
	e = x64LineRejected(e, "aadd word ptr [rax], bx")
	e = x64LineRejected(e, "cmpexadd eax, ebx, ecx")
	e = x64LineRejected(e, "cmpexadd [rax], ebx, rcx")
	e = x64LineRejected(e, "cmpexadd dword ptr [rax], rbx, rcx")
	e = x64LineRejected(e, "cmpexadd [rax], ebx")
	e = x64LineRejected(e, "cmpxadd [rax], ebx, ecx")
	e = x64LineRejected(e, "lock aadd [rax], ebx")
	e = x64LineRejected(e, "lock cmpexadd [rax], ebx, ecx")
	e = x64LineErrorHas(e, "cmpoxadd eax, ebx, ecx", "cmp<cc>xadd")
	return e
}

// MOVRS at each size, SPL..DIL and R8..R15, memory of the written size and of none, in upper case,
// a `[rip + x]` operand; what clang rejects (a register source, a memory destination, memory of
// another size); and what GNU as rejects that clang emits: a lock or repeat prefix.
func TestX64Movrs() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "movrs eax, dword ptr [rbx]", "0f 38 8b 03")
	e = x64SrcHex(e, "MOVRS rax, [rbx]", "48 0f 38 8b 03")
	e = x64SrcHex(e, "movrs ax, word ptr [rbx]", "66 0f 38 8b 03")
	e = x64SrcHex(e, "movrs al, [rbx]", "0f 38 8a 03")
	e = x64SrcHex(e, "movrs sil, [rbx]", "40 0f 38 8a 33")
	e = x64SrcHex(e, "movrs r9b, [rbx]", "44 0f 38 8a 0b")
	e = x64SrcHex(e, "movrs r9, [r10]", "4d 0f 38 8b 0a")
	e = x64TlsCase(e, "movrs eax, [rip + x]", "0f 38 8b 05 00 00 00 00", x64.FIX_REL32_LEA, 4, 0)
	e = x64LineRejected(e, "movrs eax, ebx")
	e = x64LineRejected(e, "movrs dword ptr [rbx], eax")
	e = x64LineRejected(e, "movrs eax, qword ptr [rbx]")
	e = x64LineRejected(e, "lock movrs eax, [rbx]")
	e = x64LineRejected(e, "rep movrs eax, [rbx]")
	return e
}
