package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The high-byte registers ah, ch, dh and bh against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`); the encodings in full are package
// x64's tests, these the parsing.  (x64SrcHex and x64LineRejected are in x64_target_test.bn,
// x64TlsCase in x64_tls_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// Each name, in upper case too, wherever an 8-bit register stands: moves, extensions, the ALU
// group, the one-operand group, shifts, setcc, xchg, cmpxchg / xadd with a lock, crc32, movrs,
// memory of each kind beside them.
func TestX64HighByteRegisters() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mov ah, al", "88 c4")
	e = x64SrcHex(e, "mov al, AH", "88 e0")
	e = x64SrcHex(e, "mov bh, ch", "88 ef")
	e = x64SrcHex(e, "mov dh, 5", "b6 05")
	e = x64SrcHex(e, "mov ah, byte ptr [rax]", "8a 20")
	e = x64SrcHex(e, "mov byte ptr [rbx + rcx*2 + 8], dh", "88 74 4b 08")
	e = x64SrcHex(e, "mov ah, byte ptr fs:[rax]", "64 8a 20")
	e = x64SrcHex(e, "mov ah, byte ptr [0x1000]", "8a 24 25 00 10 00 00")
	e = x64TlsCase(e, "mov ah, byte ptr [rip + x]", "8a 25 00 00 00 00", x64.FIX_REL32_LEA, 2, 0)
	e = x64SrcHex(e, "movzx eax, ah", "0f b6 c4")
	e = x64SrcHex(e, "movzx ax, bh", "66 0f b6 c7")
	e = x64SrcHex(e, "movsx ecx, dh", "0f be ce")
	e = x64SrcHex(e, "add ah, 1", "80 c4 01")
	e = x64SrcHex(e, "add byte ptr [rax], ah", "00 20")
	e = x64SrcHex(e, "cmp ah, dl", "38 d4")
	e = x64SrcHex(e, "test ah, 1", "f6 c4 01")
	e = x64SrcHex(e, "xor ah, ah", "30 e4")
	e = x64SrcHex(e, "neg ch", "f6 dd")
	e = x64SrcHex(e, "idiv dh", "f6 fe")
	e = x64SrcHex(e, "shr ah, cl", "d2 ec")
	e = x64SrcHex(e, "sar bh, 3", "c0 ff 03")
	e = x64SrcHex(e, "sete ah", "0f 94 c4")
	e = x64SrcHex(e, "xchg ah, al", "86 e0")
	e = x64SrcHex(e, "lock xadd byte ptr [rax], ah", "f0 0f c0 20")
	e = x64SrcHex(e, "cmpxchg byte ptr [rax], ah", "0f b0 20")
	e = x64SrcHex(e, "crc32 eax, ah", "f2 0f 38 f0 c4")
	e = x64SrcHex(e, "movrs ah, [rbx]", "0f 38 8a 23")
	return e
}

// What clang rejects: a high-byte register beside a REX prefix (R8..R15 anywhere, SPL..DIL, a
// 64-bit operand; clang's "can't encode 'ah' in an instruction requiring ... REX prefix"), as an
// address, as an indirect target, where only the accumulator or CL stands, at another size.
func TestX64HighByteRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "mov ah, r8b",
			"cannot be encoded in an instruction that needs a REX prefix")
	e = x64LineRejected(e, "mov ah, sil")
	e = x64LineRejected(e, "mov spl, ah")
	e = x64LineRejected(e, "mov ah, byte ptr [r8]")
	e = x64LineRejected(e, "mov ah, byte ptr [rax + r9]")
	e = x64LineRejected(e, "movzx rax, ah")
	e = x64LineRejected(e, "movzx r8d, ah")
	e = x64LineRejected(e, "xchg ah, sil")
	e = x64LineRejected(e, "crc32 rax, ah")
	e = x64LineRejected(e, "mov eax, ah")
	e = x64LineRejected(e, "mov al, byte ptr [ah]")
	e = x64LineRejected(e, "jmp ah")
	e = x64LineRejected(e, "push ah")
	e = x64LineRejected(e, "in ah, dx")
	e = x64LineRejected(e, "shl al, ch")
	e = x64LineRejected(e, "movabs ah, byte ptr [0x123456789]")
	return e
}

// rex64 before an instruction naming ah, bh, ch or dh is an error, as GNU as has it (with the
// REX their codes are spl..dil; clang emits it); before others, and an implicit AH (lahf), it is
// emitted.
func TestX64Rex64BesideHighByte() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "rex64 mov ah, al", "rex64 cannot stand before ah, bh, ch or dh")
	e = x64LineRejected(e, "rex64 add byte ptr [rax], AH")
	e = x64LineRejected(e, "rex64 fs mov bh, byte ptr [rax]")
	e = x64SrcHex(e, "rex64 mov al, bl", "48 88 d8")
	e = x64SrcHex(e, "rex64 lahf", "48 9f")
	return e
}
