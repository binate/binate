package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/buf"

// x86-64 numeric operands, as clang's Intel-syntax parser reads them.  A number, a character
// literal, `-`, `~` or `(` starts an immediate (as does a constant's name, x64ConstOperand).
// The name of a constant a label difference decided (`N = L2 - L1`; ExprResult.DiffConst) is
// a symbol to clang: alone, parenthesized or with numbers added or subtracted (`N`, `(N)`,
// `N + 4`, `4 + N`, `N - 1`) it is a memory reference to that absolute address — `mov rax, N`
// loads from [1] — and in brackets a displacement.  Any other arithmetic on it clang misreads
// (`-N` and `N*2` are [1] to it, `~N` [0], `[rbx - N]` adds N), and two label differences in
// one operand or one beside a symbol it rejects, so all of those are errors here
// (Parser.IntelOperands).  So, as in clang, are a unary `+`, a `-` right after a `-` (`- -1`,
// `1 - -1`; `-(-1)` is fine), `.` (Intel syntax does not read it as the current location),
// and a register's name in an expression — a constant named like a register included, which
// clang reads as the register wherever it stands (`K1 = 5` / `add eax, (K1)`).  A difference
// written in the operand itself (`[rbx + (l2 - l1)]`) folds to a number, as it does everywhere
// (clang takes no symbol there at all).

// x64ImmStart reports whether tok starts a numeric operand other than a constant's name: a
// number or character literal, a unary `-`, `~` or `+` (the evaluator rejects `+`), or `(`.
func x64ImmStart(tok Token) bool {
	return tok.Kind == TOK_INT || tok.Kind == TOK_CHAR || tok.Kind == TOK_MINUS ||
			tok.Kind == TOK_TILDE || tok.Kind == TOK_PLUS || tok.Kind == TOK_LPAREN
}

// x64NumberOperand returns the operand the numeric expression r is: a memory operand at its
// address (MemAbs, sized by its instruction) when r is a label-difference constant clang reads
// as a symbol (r.DiffConst), else an immediate.
func x64NumberOperand(p @Parser, r ExprResult) x64.Operand {
	if !r.DiffConst || r.Pending { return x64.Imm64(r.Val) }
	if r.Val < -2147483648 || r.Val > 2147483647 {
		setErr(p, "a memory operand's displacement is a signed 32-bit value")
		return x64.Imm(0)
	}
	return x64.MemAbs(cast(int, r.Val), 0)
}

// intelDiffConstSum reports whether `x op y`, one or both of them a label-difference constant
// (ExprResult.DiffConst), is a form clang reads correctly: a number no label difference decided
// added to one, or subtracted from one on the left.
func intelDiffConstSum(op int, x ExprResult, y ExprResult) bool {
	if x.FromDiff && y.FromDiff { return false }
	return op == TOK_PLUS || (op == TOK_MINUS && x.DiffConst)
}

// intelDiffConstError is the error for other arithmetic on a label-difference constant in an
// x86-64 operand (intelDiffConstSum).
func intelDiffConstError() ExprResult {
	return exprFail(
			"a constant from a label difference takes only a number added or subtracted in an "
					"x86-64 operand (clang reads it as a symbol and misreads other arithmetic on it)")
}

// intelDiffConstSymbolError is the error for a symbol combined with a label-difference
// constant in an x86-64 operand (clang: "cannot use more than one symbol").
func intelDiffConstSymbolError() ExprResult {
	return exprFail(
			"a symbol and a constant from a label difference cannot be combined in an x86-64 "
					"operand (clang reads both as symbols)")
}

// intelUnaryPlusError is the error for a unary `+` in an x86-64 operand (clang: "unknown token
// in expression").
func intelUnaryPlusError() ExprResult {
	return exprFail("a unary '+' in an x86-64 operand, which clang does not take")
}

// intelMinusMinusError is the error for a `-` right after a `-` in an x86-64 operand (clang:
// "unknown token in expression").
func intelMinusMinusError() ExprResult {
	return exprFail(
			"a '-' right after a '-' in an x86-64 operand, which clang does not take; add "
					"parentheses")
}

// intelRegisterNameError is the error for a register's name in an expression in an x86-64
// operand: clang reads the register there, even where a constant has that name.
func intelRegisterNameError(p @Parser, name *[]readonly char) ExprResult {
	if constIndex(p, name) >= 0 {
		return exprFail(
				quotedName(name, " is a constant named like a register, which clang reads there"))
	}
	return exprFail(quotedName(name, " is a register, which cannot stand in an expression here"))
}

// parseX64Imm parses the immediate of INT / RET / IMUL's third operand (mnem, upper case, names
// it in messages) at tok: a constant expression that fits an int, not a label-difference
// constant (a symbol to clang: "invalid operand", or for IMUL an APX memory form).  Returns the
// value and whether it is one, the error set when not.
func parseX64Imm(p @Parser, l Lexer, tok Token, mnem *[]readonly char) (Lexer, Token, int64, bool) {
	var r ExprResult
	l, tok, r = ParseExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, buf.Concat("expected immediate for ", mnem)))
		return l, tok, 0, false
	}
	if r.DiffConst {
		setErr(p, "a constant from a label difference is a memory reference to clang, not an immediate")
		return l, tok, 0, false
	}
	if !intFits(r.Val) {
		setErr(p, buf.Concat(mnem, " immediate out of range"))
		return l, tok, 0, false
	}
	return l, tok, r.Val, true
}
