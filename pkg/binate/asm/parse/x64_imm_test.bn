package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// Text-assembler tests for x86-64 ALU immediates.  An immediate is checked
// against the operation width: a 64-bit operation takes at most a
// sign-extended imm32, and a 16- or 32-bit operation takes a value that
// fits the width (read either signed or unsigned); anything else is
// rejected rather than truncated.  Among the in-range values, the short
// sign-extended imm8 form (83 /n ib) is chosen on the value at the
// operation width, as clang does.  Expected bytes are clang's
// (`clang -target x86_64-apple-macos -c`, Intel syntax, disassembled with
// objdump).  Helper newX64Parser is in x64_test.bn.

// 0x1234 does not fit imm8, so the 0x66-prefixed form takes a 2-byte imm16.
func TestParseX64AndImm16() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineEmitsHex(p, "and cx, 0x1234", "66 81 e1 34 12")
}

// 0xfffffff0 is -16 at 32 bits, so it takes the imm8 form.
func TestParseX64AndImm32AsImm8() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineEmitsHex(p, "and ecx, 0xfffffff0", "83 e1 f0")
}

func TestParseX64AndImm64NegativeImm8() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineEmitsHex(p, "and rcx, -16", "48 83 e1 f0")
}

// 2^32 does not fit a sign-extended imm32.
func TestParseX64AndImm64TooWideRejected() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineRejected(p, "and rcx, 0x100000000")
}

// 0x80000000 as an imm32 sign-extends to 0xffffffff80000000, which is not
// the value written.
func TestParseX64AndImm64SignExtensionRejected() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineRejected(p, "and rcx, 0x80000000")
}

// 0x10000 does not fit 16 bits.  clang accepts this line and silently
// truncates it to `and cx, 0`; it is rejected here instead.
func TestParseX64AndImm16TooWideRejected() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineRejected(p, "and cx, 0x10000")
}

// x64Diff is a preamble defining N, a constant a label difference decides (1), M computed from
// it (2) and a plain constant K, after two one-byte instructions; L-prefixed labels, so the
// difference is fixed on both object formats.
var x64Diff *[]readonly char = "L1: nop\nL2: nop\nN = L2 - L1\nM = N * 2\nK = 8\n"

// x64SrcRejected appends to e a failure unless src is rejected with a message holding want.
func x64SrcRejected(e @[]char, src *[]readonly char, want *[]readonly char) @[]char {
	var p @Parser = x64Source(src)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = p.Asm.ErrorMsg }
	if (p.HasError || p.Asm.HasError) && plContains(msg, want) { return e }
	return goldenFail(e, src, buf.Concat("not rejected as expected: ", msg))
}

// A constant a label difference decided is a symbol to clang: bare, parenthesized or with a
// number added or subtracted it is a memory operand at that absolute address — a 4-byte
// [disp32] — in every operand position; in brackets a displacement, always 32 bits with a
// base; a constant computed from it on its own line counts too (clang's bytes).
func TestX64DiffConstOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov rax, N"), "90 90 48 8b 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, (N)"), "90 90 8b 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, N + 4"), "90 90 8b 04 25 05 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, 4 + N"), "90 90 8b 04 25 05 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, N - 1"), "90 90 8b 04 25 00 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, N + K"), "90 90 8b 04 25 09 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov rax, M"), "90 90 48 8b 04 25 02 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "push N"), "90 90 ff 34 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "test eax, N"), "90 90 85 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "lea rax, N"), "90 90 48 8d 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov N, eax"), "90 90 89 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [N]"), "90 90 8b 04 25 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [N + 4]"), "90 90 8b 04 25 05 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rbx + N]"), "90 90 8b 83 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rbx + N - 1]"), "90 90 8b 83 00 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rbp + N - 1]"), "90 90 8b 85 00 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rbx + (N)]"), "90 90 8b 83 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rbx + rcx*2 + N]"), "90 90 8b 84 4b 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rcx*2 + N]"), "90 90 8b 04 4d 01 00 00 00")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, [rbx + K]"), "90 90 8b 43 08")
	e = x64SrcHex(e, buf.Concat(x64Diff, "mov eax, K"), "90 90 b8 08 00 00 00")
	return e
}

// What clang misreads or rejects is an error: arithmetic on such a constant other than a
// number added or subtracted (`-N`, `~N` and `N*2` lose the operator, `[rbx - N]` adds N, to
// clang), two of them, one beside a symbol, one as a scale, and one as an INT / RET immediate.
func TestX64DiffConstRejected() testing.TestResult {
	var e @[]char = ""
	var arith *[]readonly char = "takes only a number added or subtracted"
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, -N"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, ~N"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, N * 2"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, 2 * N"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, 4 - N"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, N + N"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx - N]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [-N]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx + -N]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx + N*2]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx + N + N]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx + N + M]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rcx*N]"), "no scale")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "lea rax, [rip + L1 + N]"), "cannot be combined")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "call L1 + N"), "cannot be combined")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "ret N"), "a memory reference to clang")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "int N"), "a memory reference to clang")
	if len(e) > 0 { return fail(e) }
	return ""
}

// `(`, `~` and a character literal start an immediate, as clang reads them.
func TestX64ImmediateStarts() testing.TestResult {
	var e @[]char = ""
	e = x64SizeCase(e, "mov eax, (1 + 2)", "b8 03 00 00 00")
	e = x64SizeCase(e, "mov eax, ~8", "b8 f7 ff ff ff")
	e = x64SizeCase(e, "mov eax, 'a'", "b8 61 00 00 00")
	e = x64SizeCase(e, "add rax, (8)", "48 83 c0 08")
	e = x64SizeCase(e, "ret ~0", "c2 ff ff")
	if len(e) > 0 { return fail(e) }
	return ""
}

// A unary `+` is an error anywhere in an x86-64 operand, as clang has it ("unknown token in
// expression"); `.` is not the current location there.
func TestX64UnaryPlusAndDotRejected() testing.TestResult {
	var e @[]char = ""
	var plus *[]readonly char = "a unary '+'"
	e = x64RejectCase(e, "mov eax, +2", plus)
	e = x64RejectCase(e, "mov eax, 1 + +2", plus)
	e = x64RejectCase(e, "mov eax, (+2)", plus)
	e = x64RejectCase(e, "mov eax, -+2", plus)
	e = x64RejectCase(e, "mov eax, [+8]", plus)
	e = x64RejectCase(e, "mov eax, [rax + +8]", plus)
	e = x64RejectCase(e, "ret +8", plus)
	e = x64RejectCase(e, "int +3", plus)
	e = x64SrcRejected(e, "L1: nop\nret . - L1", "'.' is not the current location")
	e = x64SrcRejected(e, "L1: nop\nmov eax, (. - L1)", "'.' is not the current location")
	if len(e) > 0 { return fail(e) }
	return ""
}

// `int 3`, however written, is the one-byte INT3, as clang writes it; any other vector is
// INT imm8.  INT / RET take the general operand's checks: a constant named like a register is
// an error (clang reads the register).
func TestX64IntAndRetImmediates() testing.TestResult {
	var e @[]char = ""
	e = x64SizeCase(e, "int 3", "cc")
	e = x64SizeCase(e, "int 1 + 2", "cc")
	e = x64SizeCase(e, "int (3)", "cc")
	e = x64SizeCase(e, "int 4", "cd 04")
	e = x64SizeCase(e, "int 0x80", "cd 80")
	e = x64SrcRejected(e, "ss = 16\nret ss", "named like a register")
	e = x64SrcRejected(e, "ss = 16\nint ss", "named like a register")
	if len(e) > 0 { return fail(e) }
	return ""
}

// IMUL's immediate takes INT / RET's checks: a label-difference constant there is an APX memory
// form to clang (`imul eax, ebx, N` is `imul eax, ebx, dword ptr [1]`), so it is an error, as
// is a third operand after a memory operand; a constant named like a register is an error.
func TestX64ImulImmediateChecks() testing.TestResult {
	var e @[]char = ""
	e = x64SrcRejected(e, buf.Concat(x64Diff, "imul eax, ebx, N"), "a memory reference to clang")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "imul eax, ebx, (N)"), "a memory reference to clang")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "imul eax, dword ptr [rbx], N"),
			"a memory reference to clang")
	e = x64SrcRejected(e, "CS = 4\nimul eax, ebx, CS", "named like a register")
	e = x64SizeCase(e, "imul eax, ebx, 10", "6b c3 0a")
	if len(e) > 0 { return fail(e) }
	return ""
}

// clang reads a register's name as the register wherever it stands in an expression, a
// constant of that name included, so it is an error anywhere in an x86-64 operand's
// expression, not only as its first token (`K1 = 5` / `add eax, (K1)` is `add eax, 0` to clang).
func TestX64RegisterNameInExpression() testing.TestResult {
	var e @[]char = ""
	var named *[]readonly char = "named like a register"
	e = x64SrcRejected(e, "K1 = 5\nadd eax, (K1)", named)
	e = x64SrcRejected(e, "K1 = 5\nmov eax, ~K1", named)
	e = x64SrcRejected(e, "K1 = 5\nmov eax, 0 + K1", named)
	e = x64SrcRejected(e, "K1 = 5\nmov eax, -(K1)", named)
	e = x64SrcRejected(e, "ss = 16\npush (ss)", named)
	e = x64SrcRejected(e, "ss = 16\nmov eax, 'a' + ss", named)
	e = x64SrcRejected(e, "CS = 4\nret (CS)", named)
	e = x64SrcRejected(e, "ss = 16\nint 1 + ss", named)
	e = x64SrcRejected(e, "CS = 4\nmov eax, [rbx + (CS)]", named)
	e = x64RejectCase(e, "mov eax, (rbx)", "'rbx' is a register")
	if len(e) > 0 { return fail(e) }
	return ""
}

// Two label differences in one operand are an error to clang ("cannot use more than one
// symbol"), a written one beside a label-difference constant included; a `-` right after a `-`
// is too ("unknown token in expression"), while `-(-1)` and `1 + -1` are fine.
func TestX64DifferencePairsAndMinusMinus() testing.TestResult {
	var e @[]char = ""
	var arith *[]readonly char = "takes only a number added or subtracted"
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, N + (L2 - L1)"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov rax, (L2 - L1) + N"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx + (L2 - L1) + N]"), arith)
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov eax, [rbx + N + (L2 - L1)]"), arith)
	var mm *[]readonly char = "a '-' right after a '-'"
	e = x64RejectCase(e, "mov eax, --1", mm)
	e = x64RejectCase(e, "mov eax, - -1", mm)
	e = x64RejectCase(e, "mov eax, 1 - -1", mm)
	e = x64RejectCase(e, "mov eax, -1 - -1", mm)
	e = x64RejectCase(e, "mov eax, [rbx - -1]", mm)
	e = x64RejectCase(e, "mov eax, [--1]", mm)
	e = x64SizeCase(e, "mov eax, -(-1)", "b8 01 00 00 00")
	e = x64SizeCase(e, "mov eax, 1 + -1", "b8 00 00 00 00")
	e = x64SizeCase(e, "mov eax, 2 * -1", "b8 fe ff ff ff")
	e = x64SizeCase(e, "mov eax, [rbx + -1]", "8b 43 ff")
	if len(e) > 0 { return fail(e) }
	return ""
}

// Two memory operands are the instruction's error, not a size problem: `add dword ptr [rbx], N`
// is two memory operands (clang: "invalid operand for instruction").
func TestX64TwoMemoryOperands() testing.TestResult {
	var e @[]char = ""
	e = x64SrcRejected(e, buf.Concat(x64Diff, "add dword ptr [rbx], N"), "unsupported operand kinds")
	e = x64SrcRejected(e, buf.Concat(x64Diff, "mov qword ptr [rbx], N"), "unsupported operand kinds")
	if len(e) > 0 { return fail(e) }
	return ""
}
