package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Text-assembler tests for x86-64 ALU immediates.  An immediate is checked
// against the operation width: a 64-bit operation takes at most a
// sign-extended imm32, and a 16- or 32-bit operation takes a value that
// fits the width (read either signed or unsigned); anything else is
// rejected rather than truncated.  Among the in-range values, the short
// sign-extended imm8 form (83 /n ib) is chosen on the value at the
// operation width, as clang does.  Expected bytes are clang's
// (`clang -target x86_64-apple-macos -c`, Intel syntax, disassembled with
// objdump).  Helper newX64Parser is in x64_test.bn.

// 0x1234 does not fit imm8, so the 0x66-prefixed form takes a 2-byte imm16.
func TestParseX64AndImm16() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineEmitsHex(p, "and cx, 0x1234", "66 81 e1 34 12")
}

// 0xfffffff0 is -16 at 32 bits, so it takes the imm8 form.
func TestParseX64AndImm32AsImm8() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineEmitsHex(p, "and ecx, 0xfffffff0", "83 e1 f0")
}

func TestParseX64AndImm64NegativeImm8() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineEmitsHex(p, "and rcx, -16", "48 83 e1 f0")
}

// 2^32 does not fit a sign-extended imm32.
func TestParseX64AndImm64TooWideRejected() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineRejected(p, "and rcx, 0x100000000")
}

// 0x80000000 as an imm32 sign-extends to 0xffffffff80000000, which is not
// the value written.
func TestParseX64AndImm64SignExtensionRejected() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineRejected(p, "and rcx, 0x80000000")
}

// 0x10000 does not fit 16 bits.  clang accepts this line and silently
// truncates it to `and cx, 0`; it is rejected here instead.
func TestParseX64AndImm16TooWideRejected() testing.TestResult {
	var p @Parser
	p, _ = newX64Parser()
	return lineRejected(p, "and cx, 0x10000")
}
