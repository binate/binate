package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// --- x86-64 Jcc mnemonic parsing ---

// parseJccMnem checks if a mnemonic is a Jcc instruction.
// Returns the condition code, or -1 if not a Jcc.
func parseJccMnem(mnem *[]readonly char) int {
	if len(mnem) < 2 { return -1 }
	if mnem[0] != 'j' && mnem[0] != 'J' { return -1 }
	var suffix *[]readonly char = mnem[1:len(mnem)]
	return parseX64CondCode(suffix)
}

// --- x86-64 instruction dispatch ---

// parseX64Instruction parses an x86-64 mnemonic (Intel syntax) and its
// operands, then emits the instruction via the x64 encoding package.
func parseX64Instruction(p @Parser, l Lexer, mnemTok Token) {
	// bnlint:allow managed-to-raw-assign - mnemTok is a live token; Text outlives the read
	var mnem *[]readonly char = mnemTok.Text
	var a @asm.Assembler = p.Asm
	p.X64Seg = 0
	if x64PrefixInstruction(p, l, mnemTok) { return }

	// --- RET / RETN, with an optional imm16 of stack to release ---
	if mnemIs(mnem, "ret") || mnemIs(mnem, "retn") {
		var tok Token
		l, tok = LexNext(l)
		if tok.Kind == TOK_EOF {
			x64.Ret(a)
			return
		}
		var rv int64 = 0
		var rok bool = false
		l, tok, rv, rok = parseX64Imm(p, l, tok, "RET")
		if rok && x64AtEOL(p, tok) { x64.RetImm(a, cast(int, rv)) }
		return
	}

	// --- No operands (x64_zero.bn) ---
	if x64ZeroOperand(a, mnem, false) {
		var next Token
		l, next = LexNext(l)
		if x64AtEOL(p, next) { _ = x64ZeroOperand(a, mnem, true) }
		return
	}

	// --- INT imm8: `int 3` is the one-byte INT3, as clang writes it ---
	if mnemIs(mnem, "int") {
		var tok Token
		l, tok = LexNext(l)
		var iv int64 = 0
		var iok bool = false
		l, tok, iv, iok = parseX64Imm(p, l, tok, "INT")
		if !iok || !x64AtEOL(p, tok) { return }
		if iv == 3 {
			x64.Int3(a)
		} else {
			x64.Int(a, cast(int, iv))
		}
		return
	}

	// --- Jcc / JMP / CALL: a label plus numbers, or (JMP / CALL) a 64-bit register or memory ---
	var jccCode int = parseJccMnem(mnem)
	if jccCode >= 0 || mnemIs(mnem, "jmp") || mnemIs(mnem, "call") {
		var tok Token
		l, tok = LexNext(l)
		if jccCode < 0 && x64MemStart(l, tok) {
			var mem x64.Operand
			l, tok, mem = parseX64Operand(p, l, tok)
			if !x64AtEOL(p, tok) { return }
			if mnemIs(mnem, "jmp") && !x64TlsCallOk(p, mem) { return }
			x64EmitSeg(p)
			if mnemIs(mnem, "jmp") {
				x64.JmpMem(a, mem)
			} else {
				x64.CallMem(a, mem)
			}
			return
		}
		if tok.Kind == TOK_IDENT && jccCode < 0 {
			reg, sz := parseX64Reg(tok.Text)
			if reg >= 0 {
				if sz != x64.SZ64 {
					setErr(p, "an indirect jump or call takes a 64-bit register")
					return
				}
				l, tok = LexNext(l)
				if !x64AtEOL(p, tok) { return }
				if mnemIs(mnem, "jmp") {
					x64.JmpReg(a, reg)
				} else {
					x64.CallReg(a, reg)
				}
				return
			}
		}
		var target @[]char
		var addend int64 = 0
		var ok bool = false
		l, tok, target, addend, ok = parseX64Target(p, l, tok)
		if !ok || !x64AtEOL(p, tok) { return }
		// A jump to a symbol is one clang may relax: a fragment boundary (fixedDistance).
		if !mnemIs(mnem, "call") { noteFragBoundary(p, a.Current) }
		if jccCode >= 0 {
			x64.JccAddend(a, jccCode, target, addend)
		} else if mnemIs(mnem, "jmp") {
			x64.JmpAddend(a, target, addend)
		} else {
			x64.CallAddend(a, target, addend)
		}
		return
	}

	// --- First operand ---
	var tok Token
	l, tok = LexNext(l)
	var dst x64.Operand
	l, tok, dst = parseX64Operand(p, l, tok)
	if p.HasError { return }

	// --- Shifts and rotates (x64_shift.bn) ---
	if x64IsShift(mnem) {
		parseX64Shift(p, l, tok, mnem, dst)
		return
	}

	// --- One-operand instructions (IMUL's one-operand form among them) ---
	if isX64OneOperand(mnem) || (mnemIs(mnem, "imul") && tok.Kind == TOK_EOF) {
		if !x64AtEOL(p, tok) || !x64TlsCallOk(p, dst) { return }
		var sized bool = false
		dst, sized = x64SizeOne(p, mnem, dst)
		if !sized { return }
		x64EmitSeg(p)
		if mnemIs(mnem, "push") { x64.Push(a, dst) }
		if mnemIs(mnem, "pop") { x64.Pop(a, dst) }
		if mnemIs(mnem, "inc") { x64.Inc(a, dst) }
		if mnemIs(mnem, "dec") { x64.Dec(a, dst) }
		if mnemIs(mnem, "neg") { x64.Neg(a, dst) }
		if mnemIs(mnem, "not") { x64.Not(a, dst) }
		if mnemIs(mnem, "idiv") { x64.Idiv(a, dst) }
		if mnemIs(mnem, "div") { x64.Div(a, dst) }
		if mnemIs(mnem, "mul") { x64.Mul1(a, dst) }
		if mnemIs(mnem, "imul") { x64.Imul1(a, dst) }
		return
	}

	// --- Two-operand instructions: dst, src ---
	var src x64.Operand
	l, tok, src = expectX64CommaOp(p, l, tok)
	if p.HasError { return }
	// (IMUL's third operand is read below; anything else must end the line here.)
	if !mnemIs(mnem, "imul") && !x64AtEOL(p, tok) { return }
	if !isX64TwoOperand(mnem) {
		setErr(p, "unknown instruction")
		return
	}
	if !x64TlsCallOk(p, dst) || !x64TlsCallOk(p, src) { return }
	var sizedTwo bool = false
	dst, src, sizedTwo = x64SizeTwo(p, mnem, dst, src)
	if !sizedTwo { return }
	x64EmitSeg(p)

	if mnemIs(mnem, "mov") { x64.Mov(a, dst, src); return }
	if mnemIs(mnem, "movabs") { x64.MovAbs(a, dst, src); return }
	if mnemIs(mnem, "lea") { x64.Lea(a, dst, src); return }
	if mnemIs(mnem, "add") { x64.Add(a, dst, src); return }
	if mnemIs(mnem, "adc") { x64.Adc(a, dst, src); return }
	if mnemIs(mnem, "sub") { x64.Sub(a, dst, src); return }
	if mnemIs(mnem, "sbb") { x64.Sbb(a, dst, src); return }
	if mnemIs(mnem, "and") { x64.And(a, dst, src); return }
	if mnemIs(mnem, "or") { x64.Or(a, dst, src); return }
	if mnemIs(mnem, "xor") { x64.Xor(a, dst, src); return }
	if mnemIs(mnem, "cmp") { x64.Cmp(a, dst, src); return }
	if mnemIs(mnem, "test") { x64.Test(a, dst, src); return }
	if mnemIs(mnem, "xchg") { x64.Xchg(a, dst, src); return }

	// IMUL: two-operand or three-operand
	if mnemIs(mnem, "imul") {
		// Check for third operand (imm)
		if tok.Kind == TOK_COMMA {
			l, tok = LexNext(l)
			if x64OffsetStart(tok) {
				var sym x64.Operand
				l, tok, sym = parseX64Offset(p, l)
				if !p.HasError && x64AtEOL(p, tok) { x64.Imul3Op(a, dst, src, sym) }
				return
			}
			var mv int64 = 0
			var mok bool = false
			l, tok, mv, mok = parseX64Imm(p, l, tok, "IMUL")
			if mok && x64AtEOL(p, tok) { x64.Imul3(a, dst, src, cast(int, mv)) }
			return
		}
		if !x64AtEOL(p, tok) { return }
		// `imul r, imm` is `imul r, r, imm`, as clang reads it.
		if src.Kind == x64.OP_IMM {
			x64.Imul3Op(a, dst, dst, src)
		} else {
			x64.Imul2(a, dst, src)
		}
		return
	}
}

// isX64TwoOperand reports whether mnem takes two operands (IMUL also one or three): mov, movabs,
// lea, the ALU group (with adc and sbb), test, xchg and imul.
func isX64TwoOperand(mnem *[]readonly char) bool {
	return mnemIs(mnem, "mov") || mnemIs(mnem, "movabs") || mnemIs(mnem, "lea") ||
			mnemIs(mnem, "add") || mnemIs(mnem, "adc") || mnemIs(mnem, "sub") || mnemIs(mnem, "sbb") ||
			mnemIs(mnem, "and") || mnemIs(mnem, "or") || mnemIs(mnem, "xor") || mnemIs(mnem, "cmp") ||
			mnemIs(mnem, "test") || mnemIs(mnem, "xchg") || mnemIs(mnem, "imul")
}

// isX64OneOperand reports whether mnem takes one operand: push, pop, inc, dec, neg, not,
// idiv, div and mul.
func isX64OneOperand(mnem *[]readonly char) bool {
	return mnemIs(mnem, "push") || mnemIs(mnem, "pop") || mnemIs(mnem, "inc") || mnemIs(mnem, "dec") ||
			mnemIs(mnem, "neg") || mnemIs(mnem, "not") || mnemIs(mnem, "idiv") || mnemIs(mnem, "div") ||
			mnemIs(mnem, "mul")
}

// parseX64Target parses a jump or call target whose expression starts at tok: a symbol
// plus numbers (`lbl`, `lbl+4+4`, `4+lbl`, an alias), or a symbol with `@PLT` (no addend; a
// branch to an undefined symbol is relocated through the PLT anyway), returning the
// symbol, the addend and the token after it.  A number, a register's name and `.` — which
// Intel syntax does not read as the current location (clang: "unknown token in
// expression"; the evaluator rejects it) — are errors.
func parseX64Target(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, int64, bool) {
	var none @[]char
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid jump or call target"))
		return l, tok, none, 0, false
	}
	if len(r.Sym) == 0 {
		setErr(p, "a jump or call target is a label, not a number")
		return l, tok, none, 0, false
	}
	if tok.Kind == TOK_AT {
		l, tok = LexNext(l)
		if tok.Kind != TOK_IDENT || !mnemIs(tok.Text, "plt") {
			setErr(p, "expected PLT after '@'")
			return l, tok, none, 0, false
		}
		// (clang takes no @PLT on a numeric local label reference, nor after an addend.)
		if asm.IsGeneratedLabel(r.Sym) || r.Val != 0 {
			setErr(p, "@PLT takes a plain symbol")
			return l, tok, none, 0, false
		}
		l, tok = LexNext(l)
	}
	return l, tok, r.Sym, r.Val, true
}

// x64MemStart reports whether tok (l just after it) begins a jump or call's memory operand: '[', a
// segment override, a size and `ptr`, '[' or a segment override, or a displacement with brackets
// after it (`x[rbx]`, `8[rbx]`, `x[rip]`) — not a symbol plus numbers alone, the direct target.
func x64MemStart(l Lexer, tok Token) bool {
	if tok.Kind == TOK_LBRACKET || x64SegStart(l, tok) { return true }
	if tok.Kind == TOK_IDENT && parseX64SizePrefix(tok.Text) != 0 {
		var next Token
		var after Lexer = l
		after, next = LexNext(after)
		if next.Kind == TOK_LBRACKET { return true }
		if next.Kind == TOK_IDENT && (mnemIs(next.Text, "ptr") || x64SegStart(after, next)) {
			return true
		}
	}
	for tok.Kind != TOK_EOF {
		if tok.Kind == TOK_LBRACKET { return true }
		l, tok = LexNext(l)
	}
	return false
}

// x64AtEOL reports whether the line is still free of errors and tok — the token after the
// instruction's last operand — ends it, setting the error when it does not, so a line with
// trailing text (an extra operand, `junk`) is rejected before anything is emitted.
func x64AtEOL(p @Parser, tok Token) bool {
	if !p.HasError && tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the instruction's operands")
	}
	return !p.HasError
}
