package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// --- x86-64 Jcc mnemonic parsing ---

// parseJccMnem checks if a mnemonic is a Jcc instruction.
// Returns the condition code, or -1 if not a Jcc.
func parseJccMnem(mnem *[]readonly char) int {
	if len(mnem) < 2 { return -1 }
	if mnem[0] != 'j' && mnem[0] != 'J' { return -1 }
	var suffix *[]readonly char = mnem[1:len(mnem)]
	return parseX64CondCode(suffix)
}

// --- x86-64 instruction dispatch ---

// parseX64Instruction parses an x86-64 mnemonic (Intel syntax) and its
// operands, then emits the instruction via the x64 encoding package.
func parseX64Instruction(p @Parser, l Lexer, mnemTok Token) {
	// bnlint:allow managed-to-raw-assign - mnemTok is a live token; Text outlives the read
	var mnem *[]readonly char = mnemTok.Text
	var a @asm.Assembler = p.Asm

	// --- Zero-operand ---
	if mnemIs(mnem, "nop") || mnemIs(mnem, "ret") || mnemIs(mnem, "syscall") || mnemIs(mnem, "cqo") ||
			mnemIs(mnem, "cdq") || mnemIs(mnem, "ud2") || mnemIs(mnem, "int3") {
		var next Token
		l, next = LexNext(l)
		if !x64AtEOL(p, next) { return }
		if mnemIs(mnem, "nop") { x64.Nop(a) }
		if mnemIs(mnem, "ret") { x64.Ret(a) }
		if mnemIs(mnem, "syscall") { x64.Syscall(a) }
		if mnemIs(mnem, "cqo") { x64.Cqo(a) }
		if mnemIs(mnem, "cdq") { x64.Cdq(a) }
		if mnemIs(mnem, "ud2") { x64.Ud2(a) }
		if mnemIs(mnem, "int3") { x64.Int3(a) }
		return
	}

	// --- INT imm8 ---
	if mnemIs(mnem, "int") {
		var tok Token
		l, tok = LexNext(l)
		var result ExprResult
		l, tok, result = ParseExpr(p, l, tok)
		if !result.Ok {
			setErr(p, exprErr(result, "expected immediate for INT"))
			return
		}
		if x64AtEOL(p, tok) { x64.Int(a, cast(int, result.Val)) }
		return
	}

	// --- Jcc / JMP / CALL: a label plus numbers, or (JMP / CALL) a 64-bit register ---
	var jccCode int = parseJccMnem(mnem)
	if jccCode >= 0 || mnemIs(mnem, "jmp") || mnemIs(mnem, "call") {
		var tok Token
		l, tok = LexNext(l)
		if tok.Kind == TOK_IDENT && jccCode < 0 {
			reg, sz := parseX64Reg(tok.Text)
			if reg >= 0 {
				if sz != x64.SZ64 {
					setErr(p, "an indirect jump or call takes a 64-bit register")
					return
				}
				l, tok = LexNext(l)
				if !x64AtEOL(p, tok) { return }
				if mnemIs(mnem, "jmp") {
					x64.JmpReg(a, reg)
				} else {
					x64.CallReg(a, reg)
				}
				return
			}
		}
		var target @[]char
		var addend int = 0
		var ok bool = false
		l, tok, target, addend, ok = parseX64Target(p, l, tok)
		if !ok || !x64AtEOL(p, tok) { return }
		if jccCode >= 0 {
			x64.JccAddend(a, jccCode, target, addend)
		} else if mnemIs(mnem, "jmp") {
			x64.JmpAddend(a, target, addend)
		} else {
			x64.CallAddend(a, target, addend)
		}
		return
	}

	// --- First operand ---
	var tok Token
	l, tok = LexNext(l)
	var dst x64.Operand
	l, tok, dst = parseX64Operand(p, l, tok)
	if p.HasError { return }

	// --- One-operand instructions ---
	if isX64OneOperand(mnem) {
		if !x64AtEOL(p, tok) { return }
		if mnemIs(mnem, "push") { x64.Push(a, dst) }
		if mnemIs(mnem, "pop") { x64.Pop(a, dst) }
		if mnemIs(mnem, "inc") { x64.Inc(a, dst) }
		if mnemIs(mnem, "dec") { x64.Dec(a, dst) }
		if mnemIs(mnem, "neg") { x64.Neg(a, dst) }
		if mnemIs(mnem, "not") { x64.Not(a, dst) }
		if mnemIs(mnem, "idiv") { x64.Idiv(a, dst) }
		if mnemIs(mnem, "div") { x64.Div(a, dst) }
		return
	}

	// --- Two-operand instructions: dst, src ---
	var src x64.Operand
	l, tok, src = expectX64CommaOp(p, l, tok)
	if p.HasError { return }
	// (IMUL's third operand is read below; anything else must end the line here.)
	if !mnemIs(mnem, "imul") && !x64AtEOL(p, tok) { return }

	if mnemIs(mnem, "mov") { x64.Mov(a, dst, src); return }
	if mnemIs(mnem, "lea") { x64.Lea(a, dst, src); return }
	if mnemIs(mnem, "add") { x64.Add(a, dst, src); return }
	if mnemIs(mnem, "sub") { x64.Sub(a, dst, src); return }
	if mnemIs(mnem, "and") { x64.And(a, dst, src); return }
	if mnemIs(mnem, "or") { x64.Or(a, dst, src); return }
	if mnemIs(mnem, "xor") { x64.Xor(a, dst, src); return }
	if mnemIs(mnem, "cmp") { x64.Cmp(a, dst, src); return }
	if mnemIs(mnem, "test") { x64.Test(a, dst, src); return }
	if mnemIs(mnem, "shl") { x64.Shl(a, dst, src); return }
	if mnemIs(mnem, "shr") { x64.Shr(a, dst, src); return }
	if mnemIs(mnem, "sar") { x64.Sar(a, dst, src); return }

	// IMUL: two-operand or three-operand
	if mnemIs(mnem, "imul") {
		// Check for third operand (imm)
		if tok.Kind == TOK_COMMA {
			l, tok = LexNext(l)
			var result ExprResult
			l, tok, result = ParseExpr(p, l, tok)
			if !result.Ok {
				setErr(p, exprErr(result, "invalid imul immediate"))
				return
			}
			if x64AtEOL(p, tok) { x64.Imul3(a, dst, src, cast(int, result.Val)) }
			return
		}
		if x64AtEOL(p, tok) { x64.Imul2(a, dst, src) }
		return
	}

	setErr(p, "unknown instruction")
}

// isX64OneOperand reports whether mnem takes one operand: push, pop, inc, dec, neg, not,
// idiv and div.
func isX64OneOperand(mnem *[]readonly char) bool {
	return mnemIs(mnem, "push") || mnemIs(mnem, "pop") || mnemIs(mnem, "inc") || mnemIs(mnem, "dec") ||
			mnemIs(mnem, "neg") || mnemIs(mnem, "not") || mnemIs(mnem, "idiv") || mnemIs(mnem, "div")
}

// parseX64Target parses a jump or call target whose expression starts at tok: a symbol
// plus numbers (`lbl`, `lbl+4+4`, `4+lbl`, an alias), or a symbol with `@PLT` (no addend; a
// branch to an undefined symbol is relocated through the PLT anyway), returning the
// symbol, the addend and the token after it.  A number, a register's name and `.` — which
// Intel syntax does not read as the current location (clang: "unknown token in
// expression") — are errors.
func parseX64Target(p @Parser, l Lexer, tok Token) (Lexer, Token, @[]char, int, bool) {
	var none @[]char
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid jump or call target"))
		return l, tok, none, 0, false
	}
	if r.Dot {
		setErr(p, "'.' is not the current location in Intel syntax")
		return l, tok, none, 0, false
	}
	if len(r.Sym) == 0 {
		setErr(p, "a jump or call target is a label, not a number")
		return l, tok, none, 0, false
	}
	if isX64RegisterName(r.Sym) {
		setErr(p, "a register is not a jump or call target here")
		return l, tok, none, 0, false
	}
	if !intFits(r.Val) {
		setErr(p, "jump or call addend out of range")
		return l, tok, none, 0, false
	}
	if tok.Kind == TOK_AT {
		l, tok = LexNext(l)
		if tok.Kind != TOK_IDENT || !mnemIs(tok.Text, "plt") {
			setErr(p, "expected PLT after '@'")
			return l, tok, none, 0, false
		}
		// (clang takes no @PLT on a numeric local label reference, nor after an addend.)
		if asm.IsGeneratedLabel(r.Sym) || r.Val != 0 {
			setErr(p, "@PLT takes a plain symbol")
			return l, tok, none, 0, false
		}
		l, tok = LexNext(l)
	}
	return l, tok, r.Sym, cast(int, r.Val), true
}

// x64AtEOL reports whether the line is still free of errors and tok — the token after the
// instruction's last operand — ends it, setting the error when it does not, so a line with
// trailing text (an extra operand, `junk`) is rejected before anything is emitted.
func x64AtEOL(p @Parser, tok Token) bool {
	if !p.HasError && tok.Kind != TOK_EOF {
		setErr(p, "unexpected token after the instruction's operands")
	}
	return !p.HasError
}
