package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// Instruction dispatch tests for x64_instr.bn.
// Helpers newX64Parser, readX64Byte, checkX64Bytes are in x64_test.bn.

// A rejected instruction leaves nothing in its section (parse.bn's x64InstructionFailed), after
// earlier bytes too: not a segment override or the bytes written before an encoder found an
// operand it cannot encode, nor the fixup of an immediate written after it, nor the whole of an
// instruction the pending-value rule rejects (`offset L2 - L1` with the labels still to come).
func TestX64RejectedInstructionLeavesNothing() testing.TestResult {
	var lines @[]@[]char = @[]@[]char{"movabs rbx, fs:[0x10]", "fs add rax, [0x123456789]",
			"test qword ptr [0x123456789], offset x", "mov rax, offset L2 - L1"}
	for i := 0; i < len(lines); i++ {
		p, a := newX64Parser()
		p.ParseLine("nop")
		var r testing.TestResult = lineRejected(p, lines[i])
		if len(r) > 0 { return r }
		if asm.HeldLen(a.Sections[0]) != 1 || a.Sections[0].NumFixups != 0 {
			return fail(buf.Concat("a rejected line left bytes or a fixup: ", lines[i]))
		}
	}
	return ""
}

func TestParseX64Imul2() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	// imul rax, rcx = 48 0F AF C1
	p.ParseLine("imul rax, rcx")
	if p.HasError { return fail(p.ErrorMsg) }
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x0F
	expected[2] = 0xAF
	expected[3] = 0xC1
	if !checkX64Bytes(a.Sections[0], 0, expected) {
		return fail("imul rax, rcx encoding wrong")
	}
	return ""
}

func TestParseX64Imul3() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	// imul rax, rcx, 10 = 48 6B C1 0A
	p.ParseLine("imul rax, rcx, 10")
	if p.HasError { return fail(p.ErrorMsg) }
	var expected @[]int = make_slice(int, 4)
	expected[0] = 0x48
	expected[1] = 0x6B
	expected[2] = 0xC1
	expected[3] = 0x0A
	if !checkX64Bytes(a.Sections[0], 0, expected) {
		return fail("imul rax, rcx, 10 encoding wrong")
	}
	return ""
}

