// The trap instructions: ud2 (0F 0B) and int3 (CC).
func TestParseX64Traps() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	p.ParseLine("ud2")
	p.ParseLine("int3")
	if p.HasError { return fail(p.ErrorMsg) }
	var expected @[]int = make_slice(int, 3)
	expected[0] = 0x0F
	expected[1] = 0x0B
	expected[2] = 0xCC
	if a.Sections[0].Len != 3 || !checkX64Bytes(a.Sections[0], 0, expected) {
		return fail("ud2 / int3 encodings wrong")
	}
	return ""
}

func TestParseX64Int80() testing.TestResult {
	var p @Parser
	var a @asm.Assembler
	p, a = newX64Parser()
	// int 0x80 = CD 80
	p.ParseLine("int 0x80")
	if p.HasError { return fail(p.ErrorMsg) }
	var expected @[]int = make_slice(int, 2)
	expected[0] = 0xCD
	expected[1] = 0x80
	if !checkX64Bytes(a.Sections[0], 0, expected) {
		return fail("int 0x80 encoding wrong")
	}
	return ""
}

// RET and RETN take an optional imm16 of stack to release, as clang reads them: `ret` and
// `retn` are C3, `ret 8`, `retn 8`, `ret 3+5` and `ret 0` are C2 iw.  A symbol, a second
// operand or a value outside -32768..65535 is rejected.
func TestParseX64RetImm() testing.TestResult {
	var e @[]char = ""
	e = x64SizeCase(e, "ret", "c3")
	e = x64SizeCase(e, "retn", "c3")
	e = x64SizeCase(e, "ret 8", "c2 08 00")
	e = x64SizeCase(e, "retn 8", "c2 08 00")
	e = x64SizeCase(e, "ret 3+5", "c2 08 00")
	e = x64SizeCase(e, "ret 0", "c2 00 00")
	e = x64SizeCase(e, "ret -1", "c2 ff ff")
	e = x64RejectCase(e, "ret 65536", "ret immediate out of range")
	e = x64RejectCase(e, "ret -32769", "ret immediate out of range")
	e = x64RejectCase(e, "ret x", "'x' is not a constant defined before this line")
	e = x64RejectCase(e, "ret 8, 4", "unexpected token")
	if len(e) > 0 { return fail(e) }
	return ""
}
