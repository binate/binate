package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"

// The lock prefix: `lock` before an instruction on its line takes only one that writes memory
// atomically — add, adc, and, or, sub, sbb, xor, inc, dec, neg, not, bts, btr, btc, xadd,
// cmpxchg, cmpxchg8b, cmpxchg16b or xchg, with a memory destination (either operand of xchg, which
// writes both) — as GNU as checks (clang emits the 0xF0 before anything, an instruction that
// faults with #UD when run).  A `lock` alone on its line is the prefix, as in both, the next line
// unchecked.

// x64Lockable reports whether mnem may follow a lock prefix.
func x64Lockable(mnem *[]readonly char) bool {
	return mnemIs(mnem, "add") || mnemIs(mnem, "adc") || mnemIs(mnem, "and") || mnemIs(mnem, "or") ||
			mnemIs(mnem, "sub") || mnemIs(mnem, "sbb") || mnemIs(mnem, "xor") || mnemIs(mnem, "inc") ||
			mnemIs(mnem, "dec") || mnemIs(mnem, "neg") || mnemIs(mnem, "not") || mnemIs(mnem, "bts") ||
			mnemIs(mnem, "btr") || mnemIs(mnem, "btc") || mnemIs(mnem, "xadd") || mnemIs(mnem, "cmpxchg") ||
			mnemIs(mnem, "cmpxchg8b") || mnemIs(mnem, "cmpxchg16b") || mnemIs(mnem, "xchg")
}

// x64LockOk reports whether the instruction mnem, whose destination is dst and source src (an
// immediate 0 for none), suits the lock prefix its line wrote (Parser.X64Lock), if any — else
// sets the error.
func x64LockOk(p @Parser, mnem *[]readonly char, dst x64.Operand, src x64.Operand) bool {
	if !p.X64Lock { return true }
	if !x64Lockable(mnem) {
		setErr(p, "lock takes an instruction that writes memory atomically (add, adc, and, or, sub, sbb, "
				"xor, inc, dec, neg, not, bts, btr, btc, xadd, cmpxchg, cmpxchg8b, cmpxchg16b, xchg)")
		return false
	}
	if !x64IsMemory(dst) && !(mnemIs(mnem, "xchg") && x64IsMemory(src)) {
		setErr(p, "lock takes an instruction whose destination is memory")
		return false
	}
	return true
}

// The lock-elision hints: `xacquire` / `xrelease` before an instruction on their line take only
// one whose lock they elide — a lock-prefixed lockable instruction but cmpxchg16b, as GNU as
// checks, or an xchg with a memory operand (locked without the prefix; the SDM's pairing, where
// GNU as also takes a register xchg in the 86 / 87 form) — and `xrelease` also a mov to memory
// from a register or an immediate (88 / 89 / C6 / C7, not the moffs form A2 / A3); clang emits
// the F2 / F3 before anything, which can make another instruction of it (`xacquire movbe` is
// CRC32, `xrelease bsf` TZCNT).

// x64HleMnemOk reports whether the instruction mnem may follow the lock-elision hint its line
// wrote (Parser.X64Hle), if any, by its name (after lock's check of its own, x64LockOk; its
// operands are x64HleOk's), else sets the error.
func x64HleMnemOk(p @Parser, mnem *[]readonly char) bool {
	if p.X64Hle == 0 { return true }
	if p.X64Lock && !mnemIs(mnem, "cmpxchg16b") { return true }
	if !p.X64Lock && (mnemIs(mnem, "xchg") || (p.X64Hle == 0xF3 && mnemIs(mnem, "mov"))) {
		return true
	}
	x64HleError(p)
	return false
}

// x64HleOk reports whether the operands of mnem, dst and src, suit the lock-elision hint its line
// wrote, if any (a lock-prefixed instruction's are lock's, x64LockOk; without one, an xchg needs a
// memory operand and a mov a memory destination with no 64-bit address), else sets the error.
func x64HleOk(p @Parser, mnem *[]readonly char, dst x64.Operand, src x64.Operand) bool {
	if p.X64Hle == 0 || p.X64Lock { return true }
	if mnemIs(mnem, "mov") && x64IsMemory(dst) && !dst.Addr64 { return true }
	if mnemIs(mnem, "xchg") && (x64IsMemory(dst) || x64IsMemory(src)) { return true }
	x64HleError(p)
	return false
}

// x64HleError sets the error for an instruction the lock-elision hint its line wrote does not
// take.
func x64HleError(p @Parser) {
	if p.X64Hle == 0xF2 {
		setErr(p, "xacquire takes a lock-prefixed instruction (not cmpxchg16b) or an xchg with memory")
	} else {
		setErr(p, "xrelease takes a lock-prefixed instruction (not cmpxchg16b), an xchg with memory or "
				"a mov to memory (not the moffs form)")
	}
}
