package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"

// The lock prefix: `lock` before an instruction on its line takes only one that writes memory
// atomically — add, adc, and, or, sub, sbb, xor, inc, dec, neg, not, bts, btr, btc, xadd,
// cmpxchg, cmpxchg8b, cmpxchg16b or xchg, with a memory destination (either operand of xchg, which
// writes both) — as GNU as checks (clang emits the 0xF0 before anything, an instruction that
// faults with #UD when run).  A `lock` alone on its line is the prefix, as in both, the next line
// unchecked.

// x64Lockable reports whether mnem may follow a lock prefix.
func x64Lockable(mnem *[]readonly char) bool {
	return mnemIs(mnem, "add") || mnemIs(mnem, "adc") || mnemIs(mnem, "and") || mnemIs(mnem, "or") ||
			mnemIs(mnem, "sub") || mnemIs(mnem, "sbb") || mnemIs(mnem, "xor") || mnemIs(mnem, "inc") ||
			mnemIs(mnem, "dec") || mnemIs(mnem, "neg") || mnemIs(mnem, "not") || mnemIs(mnem, "bts") ||
			mnemIs(mnem, "btr") || mnemIs(mnem, "btc") || mnemIs(mnem, "xadd") || mnemIs(mnem, "cmpxchg") ||
			mnemIs(mnem, "cmpxchg8b") || mnemIs(mnem, "cmpxchg16b") || mnemIs(mnem, "xchg")
}

// x64LockOk reports whether the instruction mnem, whose destination is dst and source src (an
// immediate 0 for none), suits the lock prefix its line wrote (Parser.X64Lock), if any — else
// sets the error.
func x64LockOk(p @Parser, mnem *[]readonly char, dst x64.Operand, src x64.Operand) bool {
	if !p.X64Lock { return true }
	if !x64Lockable(mnem) {
		setErr(p,
				"lock takes an instruction that writes memory atomically (add, adc, and, or, sub, sbb, "
						"xor, inc, dec, neg, not, bts, btr, btc, xadd, cmpxchg, cmpxchg8b, cmpxchg16b, xchg)")
		return false
	}
	if !x64IsMemory(dst) && !(mnemIs(mnem, "xchg") && x64IsMemory(src)) {
		setErr(p, "lock takes an instruction whose destination is memory")
		return false
	}
	return true
}
