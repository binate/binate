package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The lock prefix and its instructions (x64_lock.bn), xadd / cmpxchg / cmpxchg8b / cmpxchg16b and
// the lock-elision hints, against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`).  (x64SrcHex and x64LineRejected are in x64_target_test.bn.)

// lock before each kind of lockable instruction with a memory destination (xchg's memory either
// operand), on its line or alone on the line before, or with one other prefix alone after it (the
// instruction clang reads there); an operand's segment override and a 0x66 before the F0, as clang
// orders them;
// xacquire / xrelease; xadd, cmpxchg and cmpxchg8b / cmpxchg16b (unsized, or qword / xmmword).
func TestX64Lock() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "lock add qword ptr [rbx], rax", "f0 48 01 03")
	e = x64SrcHex(e, "lock add [rbx], rax", "f0 48 01 03")
	e = x64SrcHex(e, "lock inc qword ptr [rbx]", "f0 48 ff 03")
	e = x64SrcHex(e, "lock xadd [rbx], rax", "f0 48 0f c1 03")
	e = x64SrcHex(e, "lock cmpxchg [rbx], rcx", "f0 48 0f b1 0b")
	e = x64SrcHex(e, "lock cmpxchg16b [rbx]", "f0 48 0f c7 0b")
	e = x64SrcHex(e, "lock cmpxchg8b [r8]", "f0 41 0f c7 08")
	e = x64SrcHex(e, "lock bts qword ptr [rbx], 3", "f0 48 0f ba 2b 03")
	e = x64SrcHex(e, "lock xchg [rbx], rax", "f0 48 87 03")
	e = x64SrcHex(e, "lock xchg rax, [rbx]", "f0 48 87 03")
	e = x64SrcHex(e, "lock xchg cx, word ptr [rbx]", "66 f0 87 0b")
	e = x64SrcHex(e, "LOCK neg dword ptr [rbx]", "f0 f7 1b")
	e = x64SrcHex(e, "lock", "f0")
	e = x64SrcHex(e, "lock\nadd [rbx], rax", "f0 48 01 03")
	e = x64SrcHex(e, "lock; add [rbx], rax", "f0 48 01 03")
	e = x64SrcHex(e, "lock add dword ptr fs:[rbx], 1", "64 f0 83 03 01")
	e = x64SrcHex(e, "lock add word ptr fs:[rbx], ax", "64 66 f0 01 03")
	e = x64SrcHex(e, "lock xadd word ptr [rbx], ax", "66 f0 0f c1 03")
	e = x64SrcHex(e, "lock inc word ptr [rbx]", "66 f0 ff 03")
	e = x64SrcHex(e, "xacquire lock add word ptr [rbx], ax", "f2 66 f0 01 03")
	e = x64SrcHex(e, "data16 lock add [rbx], eax", "66 f0 01 03")
	e = x64SrcHex(e, "data16 lock add word ptr [rbx], ax", "66 66 f0 01 03")
	e = x64SrcHex(e, "rex64 lock add [rbx], eax", "48 f0 01 03")
	e = x64SrcHex(e, "lock fs", "f0 64")
	e = x64SrcHex(e, "lock data16", "f0 66")
	e = x64SrcHex(e, "lock rex64", "f0 48")
	e = x64SrcHex(e, "lock xacquire", "f0 f2")
	e = x64SrcHex(e, "lock xrelease", "f0 f3")
	e = x64SrcHex(e, "lock fs\nadd [rbx], eax", "f0 64 01 03")
	e = x64SrcHex(e, "fs lock add [rbx], eax", "64 f0 01 03")
	e = x64SrcHex(e, "xacquire lock add [rbx], eax", "f2 f0 01 03")
	e = x64SrcHex(e, "xrelease mov [rbx], eax", "f3 89 03")
	e = x64SrcHex(e, "xadd rax, rbx", "48 0f c1 d8")
	e = x64SrcHex(e, "xadd byte ptr [rbx], cl", "0f c0 0b")
	e = x64SrcHex(e, "cmpxchg cx, dx", "66 0f b1 d1")
	e = x64SrcHex(e, "cmpxchg8b [rbx]", "0f c7 0b")
	e = x64SrcHex(e, "cmpxchg8b qword ptr [rbx]", "0f c7 0b")
	e = x64SrcHex(e, "cmpxchg16b [rbx]", "48 0f c7 0b")
	e = x64SrcHex(e, "cmpxchg16b xmmword ptr [rbx]", "48 0f c7 0b")
	return e
}

// lock before an instruction that writes no memory atomically or whose destination is a register
// (clang emits it, to fault with #UD), two locks, and what clang rejects: another prefix between
// lock and its instruction, a register or the wrong size for cmpxchg8b / cmpxchg16b, an xmmword
// elsewhere.
func TestX64LockRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "lock add rax, rbx")
	e = x64LineRejected(e, "lock add rax, [rbx]")
	e = x64LineRejected(e, "lock xchg rax, rbx")
	e = x64LineRejected(e, "lock xadd rax, rbx")
	e = x64LineRejected(e, "lock mov [rbx], rax")
	e = x64LineRejected(e, "lock nop")
	e = x64LineRejected(e, "lock bt [rbx], rax")
	e = x64LineRejected(e, "lock shl qword ptr [rbx], 1")
	e = x64LineRejected(e, "lock jmp x")
	e = x64LineRejected(e, "lock setne [rbx]")
	e = x64LineRejected(e, "lock lock add [rbx], eax")
	e = x64LineRejected(e, "lock fs add [rbx], eax")
	e = x64LineRejected(e, "lock data16 add [rbx], eax")
	e = x64LineRejected(e, "lock rex64 add [rbx], eax")
	e = x64LineRejected(e, "lock xacquire add [rbx], eax")
	e = x64LineRejected(e, "lock xrelease xchg [rbx], eax")
	e = x64LineRejected(e, "lock fs ds")
	e = x64LineRejected(e, "lock fs lock")
	e = x64LineRejected(e, "lock lock")
	e = x64LineRejected(e, "lock inc rax")
	e = x64LineRejected(e, "cmpxchg8b rax")
	e = x64LineRejected(e, "cmpxchg16b qword ptr [rbx]")
	e = x64LineRejected(e, "cmpxchg8b xmmword ptr [rbx]")
	e = x64LineRejected(e, "mov rax, xmmword ptr [rbx]")
	return e
}
