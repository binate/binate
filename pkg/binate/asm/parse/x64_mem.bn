package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"

// An x86-64 memory operand (`[...]` in Intel syntax) is a sum of terms: those of each bracket
// group (`[rbx][rcx*4]` is [rbx + rcx*4]) and of a displacement written before them (`8[rbx]`,
// x64_disp.bn).  A group's terms are joined by `+` and `-`, each sign applying to the term after
// it alone (`[rbx - 8 + 4]` is rbx - 4):
//   - at most two 64-bit general registers — a base, and an index, scaled when written
//     `reg*s` or `s*reg` (s 1, 2, 4 or 8, a number or a constant's name); an unscaled
//     second register is the index (scale 1).  A register is never subtracted, and RSP is
//     no index: `[rbx + rsp]` takes RSP as the base and RBX as the index, as clang does;
//   - `rip`, the RIP-relative form, anywhere (`[rip + x]`, `[x + rip]`, `x[rip]`) but with no
//     other register (clang drops rip beside one) and a symbol (x64_disp.bn's x64MemOperandOf);
//   - displacement terms, each a number (`8`, `K*2`, `(l2 - l1)`), summing to a signed
//     32-bit value (clang silently keeps the low 32 bits of a wider one, and relocates a wider
//     addend of a symbol, which the encoder rejects) — but any 64-bit addend beside rip, as
//     clang's relocation takes it.  An operand of displacements alone is the absolute address
//     [disp32].  A label-difference constant
//     (x64_imm.bn) is at most one term, added (`[rbx + N]`, not `[rbx - N]`, which clang
//     misreads as rbx + N);
//   - at most one symbol term, added: a symbol plus numbers (`x`, `x + 8`, `(x + 8)`), relocated
//     as the displacement (x64.MemSym, R_X86_64_32S), or a symbol and its '@' operator
//     (`x@TPOFF`, `x@GOTPCREL`; x64_tls.bn).  clang adds a subtracted symbol (`[rbx - x]` is
//     rbx + x) and drops a scale on one (`[x*2]`), so those are errors.
// clang reads the operand with C's precedences, under which | ^ & << >> bind more loosely
// than + and -, while a term here ends at + and -; so a displacement term using one of them
// outside parentheses is taken only as the operand's one displacement term, not subtracted
// (`[rbx + 8 | 4]`, `[1 << 2 + rbx]`), and is an error otherwise (`[rbx + 3 | 4 + 1]` is
// 7 in clang).

// x64MemAcc is a memory operand's terms summed so far, across the displacement written before
// its brackets and each bracket group (parseX64MemTerms).
type x64MemAcc struct {
	Base       int // the base register, -1 for none
	Index      int // the index register, -1 for none
	Scale      int // the index's scale
	Rip        bool // a `rip` term
	Disp       int64 // the numbers' sum, the symbol term's included
	NDisp      int // the displacement terms, the symbol term included
	Loose      bool // a displacement term used | ^ & << >> outside parentheses
	DiffConsts int // label-difference constant terms (x64_imm.bn)
	DiffTerms  int // terms a label difference decided, written or a constant
	Groups     int // the bracket groups
	Sym        @[]char // the symbol term's symbol, empty for none
	Op         int // its operator (x64OperatorKind), 0 for none
}

// newX64MemAcc returns an x64MemAcc with no terms.
func newX64MemAcc() x64MemAcc {
	var m x64MemAcc
	m.Base = -1
	m.Index = -1
	m.Scale = 1
	return m
}

// parseX64MemOperand parses a memory operand after its first '[' (l just after it) — that
// group, then any after it — for an access of size bits (0: not written, x64_size.bn).
func parseX64MemOperand(p @Parser, l Lexer, size int) (Lexer, Token, x64.Operand) {
	var tok Token
	l, tok = LexNext(l)
	var m x64MemAcc = newX64MemAcc()
	l, tok, m = parseX64MemTerms(p, l, tok, m, false)
	if !p.HasError { l, tok, m = parseX64MemGroups(p, l, tok, m) }
	if p.HasError { return l, tok, x64.Imm(0) }
	return l, tok, x64MemOperandOf(p, m, size)
}

// parseX64MemGroups adds to m the bracket groups at tok (l just after it): each '[', its terms
// and its ']', up to a token that is no '['.
func parseX64MemGroups(p @Parser, l Lexer, tok Token, m x64MemAcc) (Lexer, Token, x64MemAcc) {
	for tok.Kind == TOK_LBRACKET {
		l, tok = LexNext(l)
		l, tok, m = parseX64MemTerms(p, l, tok, m, false)
		if p.HasError { break }
	}
	return l, tok, m
}

// parseX64MemTerms adds to m the terms from tok (l just after it): a bracket group's, after its
// '[', through its ']' — or, bare, a displacement written before any bracket (x64_disp.bn),
// which takes no register, up to the first token that is not + or -.
func parseX64MemTerms(p @Parser, l Lexer, tok Token, m x64MemAcc,
		bare bool) (Lexer, Token, x64MemAcc) {
	if !bare && tok.Kind == TOK_RBRACKET {
		setErr(p, "empty memory operand")
		return l, tok, m
	}
	if tok.Kind == TOK_PLUS {
		setErr(p, intelUnaryPlusError().Err)
		return l, tok, m
	}
	var neg bool = tok.Kind == TOK_MINUS
	if tok.Kind == TOK_MINUS {
		l, tok = LexNext(l)
		// A leading sign is a unary operator to clang (unlike a sign between terms).
		if tok.Kind == TOK_TILDE {
			setErr(p, intelTildeError().Err)
			return l, tok, m
		}
		if tok.Kind == TOK_MINUS {
			setErr(p, intelMinusMinusError().Err)
			return l, tok, m
		}
	}
	for {
		l, tok, m = parseX64MemTerm(p, l, tok, m, neg, bare)
		if p.HasError { return l, tok, m }
		if tok.Kind != TOK_PLUS && tok.Kind != TOK_MINUS { break }
		neg = tok.Kind == TOK_MINUS
		l, tok = LexNext(l)
		if neg && tok.Kind == TOK_MINUS {
			setErr(p, intelMinusMinusError().Err)
			return l, tok, m
		}
	}
	if bare { return l, tok, m }
	if tok.Kind != TOK_RBRACKET {
		setErr(p, "expected '+', '-' or ']' in the memory operand")
		return l, tok, m
	}
	l, tok = LexNext(l)
	m.Groups = m.Groups + 1
	return l, tok, m
}

// parseX64MemTerm adds to m the term at tok (l just after it), subtracted when neg: `rip`, a
// register term, a symbol and its operator, or a displacement term — a number, or a symbol plus
// numbers.  bare is parseX64MemTerms's.
func parseX64MemTerm(p @Parser, l Lexer, tok Token, m x64MemAcc, neg bool,
		bare bool) (Lexer, Token, x64MemAcc) {
	var rip bool = tok.Kind == TOK_IDENT && mnemIs(tok.Text, "rip")
	var reg int = -1
	var sc int = 0
	if !rip {
		l, tok, reg, sc = parseX64RegTerm(p, l, tok)
		if p.HasError { return l, tok, m }
	}
	if (rip || reg >= 0) && bare {
		setErr(p,
				"a displacement before a memory operand's brackets, or with none, takes no register; a "
						"register goes in brackets")
		return l, tok, m
	}
	if rip || reg >= 0 {
		if neg {
			setErr(p, "a register cannot be subtracted in a memory operand")
			return l, tok, m
		}
		if rip { return x64RipTerm(p, l, tok, m) }
		if sc == 0 && m.Base < 0 {
			m.Base = reg
		} else if m.Index < 0 {
			m.Index = reg
			if sc > 0 { m.Scale = sc }
		} else {
			setErr(p, "a memory operand takes at most a base and an index register")
		}
		return l, tok, m
	}
	if x64OpTermStart(l, tok) {
		var sym @[]char
		var kind int = 0
		var v int64 = 0
		l, tok, sym, kind, v = parseX64OpTerm(p, l, tok)
		if p.HasError { return l, tok, m }
		if binPrec(tok.Kind) >= 2 {
			setErr(p, "only + or - follows a symbol's '@' operator (clang drops `* 2` after `x@TPOFF`)")
			return l, tok, m
		}
		return l, tok, x64AddSymbol(p, m, sym, kind, v, neg)
	}
	var r ExprResult
	var groups int = 0
	l, tok, r, groups = parseX64DispTerm(p, l, tok)
	if p.HasError { return l, tok, m }
	if !r.Pending && isSymbolic(r) { return l, tok, x64AddSymbol(p, m, r.Sym, 0, r.Val, neg) }
	if r.FromDiff && !r.Pending { m.DiffTerms = m.DiffTerms + 1 }
	if r.DiffConst {
		if neg {
			x64DiffConstTermError(p)
			return l, tok, m
		}
		m.DiffConsts = m.DiffConsts + 1
	}
	if m.DiffConsts > 0 && m.DiffTerms > 1 {
		x64DiffConstTermError(p)
		return l, tok, m
	}
	if (groups & (EG_BIT | EG_SHIFT)) != 0 {
		if neg {
			x64LooseTermError(p)
			return l, tok, m
		}
		m.Loose = true
	}
	if neg {
		m.Disp = m.Disp - r.Val
	} else {
		m.Disp = m.Disp + r.Val
	}
	m.NDisp = m.NDisp + 1
	return l, tok, m
}

// x64RipTerm adds to m the `rip` term at tok (l just after it): once, unscaled.
func x64RipTerm(p @Parser, l Lexer, tok Token, m x64MemAcc) (Lexer, Token, x64MemAcc) {
	if m.Rip {
		setErr(p, "a memory operand takes rip once")
		return l, tok, m
	}
	m.Rip = true
	l, tok = LexNext(l)
	if binPrec(tok.Kind) >= 2 { setErr(p, "rip takes no scale: [rip + symbol]") }
	return l, tok, m
}

// x64AddSymbol adds to m the symbol term sym — its operator kind (x64OperatorKind, 0 for none)
// and v the number with it — subtracted when neg: an error, as is a second symbol term (clang
// adds a lone subtracted symbol, and takes one symbol per operand).
func x64AddSymbol(p @Parser, m x64MemAcc, sym @[]char, kind int, v int64, neg bool) x64MemAcc {
	if neg {
		setErr(p,
				"a symbol cannot be subtracted or negated in a memory operand (clang adds a lone one); a "
						"label difference goes in parentheses, (l2 - l1)")
		return m
	}
	if len(m.Sym) > 0 {
		setErr(p, "a memory operand takes one symbol")
		return m
	}
	m.Sym = sym
	m.Op = kind
	m.Disp = m.Disp + v
	m.NDisp = m.NDisp + 1
	return m
}

// x64LooseTermError sets the error for a displacement term using | ^ & << >> outside
// parentheses beside another displacement term or subtracted (parseX64MemTerms).
func x64LooseTermError(p @Parser) x64.Operand {
	setErr(p,
			"ambiguous operator precedence in a memory operand (clang binds | ^ & << >> more "
					"loosely than + and -); add parentheses")
	return x64.Imm(0)
}

// parseX64RegTerm parses the memory-operand term at tok (l just after it) when it is a
// register term — `reg`, `reg*s` or `s*reg` — returning the register and the scale written
// (0 when none); otherwise it returns register -1, consuming nothing.  A register's name
// other than a 64-bit general register's is an error, as is an operator other than + and -
// after the term (`rcx*2*2`, which clang reads as rcx*2).
func parseX64RegTerm(p @Parser, l Lexer, tok Token) (Lexer, Token, int, int) {
	var reg int = -1
	var sc int = 0
	if tok.Kind == TOK_IDENT && isX64RegisterName(tok.Text) {
		reg = x64MemReg(p, tok.Text)
		if reg < 0 { return l, tok, -1, 0 }
		l, tok = LexNext(l)
		if tok.Kind == TOK_STAR {
			l, tok = LexNext(l)
			l, tok, sc = parseX64Scale(p, l, tok)
			if p.HasError { return l, tok, -1, 0 }
		}
	} else {
		// `s*reg`: a number or a name, '*', then a register's name.
		if tok.Kind != TOK_INT && tok.Kind != TOK_IDENT { return l, tok, -1, 0 }
		var peek Lexer = l
		var star Token
		var regTok Token
		peek, star = LexNext(peek)
		if star.Kind != TOK_STAR { return l, tok, -1, 0 }
		peek, regTok = LexNext(peek)
		if regTok.Kind != TOK_IDENT || !isX64RegisterName(regTok.Text) { return l, tok, -1, 0 }
		l, tok, sc = parseX64Scale(p, l, tok)
		if p.HasError { return l, tok, -1, 0 }
		reg = x64MemReg(p, regTok.Text)
		if reg < 0 { return l, tok, -1, 0 }
		l, tok = LexNext(l) // the register's name
		l, tok = LexNext(l)
	}
	if binPrec(tok.Kind) >= 2 {
		setErr(p, "a memory operand's register term is reg, reg*scale or scale*reg")
		return l, tok, -1, 0
	}
	return l, tok, reg, sc
}

// x64MemReg returns the register a memory operand names name (a register's name): a
// 64-bit general register, or -1 with the error set for any other.
func x64MemReg(p @Parser, name *[]readonly char) int {
	reg, sz := parseX64Reg(name)
	if reg >= 0 && sz == x64.SZ64 { return reg }
	if reg >= 0 {
		setErr(p,
				quotedName(name,
						" is not a 64-bit register; a memory operand's base and index are (32-bit "
								"addressing is not supported)"))
		return -1
	}
	if mnemIs(name, "rip") {
		setErr(p, "rip takes no scale: [rip + symbol]")
		return -1
	}
	setErr(p, quotedName(name, " is not a base or index register"))
	return -1
}

// parseX64Scale parses an index register's scale at tok (l just after it): one number or
// constant's name, 1, 2, 4 or 8 — clang takes no other, and reads a register's name as the
// register even where a constant has that name.
func parseX64Scale(p @Parser, l Lexer, tok Token) (Lexer, Token, int) {
	if tok.Kind != TOK_INT && tok.Kind != TOK_IDENT {
		setErr(p, "a memory operand's scale is a number or a constant's name")
		return l, tok, 0
	}
	if tok.Kind == TOK_IDENT && isX64RegisterName(tok.Text) {
		setErr(p, quotedName(tok.Text, " is a register, not a scale"))
		return l, tok, 0
	}
	var first Token = tok
	var r ExprResult
	l, tok, r = parseTerminal(p, l, tok)
	if r.Ok && !r.Pending && (isSymbolic(r) || hasNeg(r)) { r = numberContextError(p, first, r) }
	if !r.Ok {
		setErr(p, exprErr(r, "invalid scale in memory operand"))
		return l, tok, 0
	}
	if r.Pending { return l, tok, 1 } // an x86-64 instruction with one is an error
	if r.DiffConst {
		setErr(p, "a label-difference constant is no scale (clang reads it as a symbol)")
		return l, tok, 0
	}
	if r.Val != 1 && r.Val != 2 && r.Val != 4 && r.Val != 8 {
		setErr(p, "a memory operand's scale is 1, 2, 4 or 8")
		return l, tok, 0
	}
	return l, tok, cast(int, r.Val)
}

// parseX64DispTerm parses a displacement term at tok (l just after it) — operators binding
// tighter than + and - over a number, or a symbol plus numbers (a symbol only added to, or
// subtracted from on its right: `x*2` is an error) — returning it and the operator groups used
// outside parentheses.
func parseX64DispTerm(p @Parser, l Lexer, tok Token) (Lexer, Token, ExprResult, int) {
	var first Token = tok
	var r ExprResult
	var groups int = 0
	var folds int = p.AcrossFolds
	l, tok, r, groups = parseBinary(p, l, tok, 2, 0)
	if r.Ok && ambiguousMix(groups) {
		r = exprFail("ambiguous operator precedence (Mach-O and ELF differ); add parentheses")
	}
	r = acrossAtomsResult(p, folds, r)
	if r.Ok && !r.Pending && (hasNeg(r) || r.Dot) { r = numberContextError(p, first, r) }
	if !r.Ok { setErr(p, exprErr(r, "invalid displacement in memory operand")) }
	return l, tok, r, groups
}

// x64DiffConstTermError sets the error for a label-difference constant subtracted in a memory
// operand, or beside another term a label difference decided (parseX64MemTerm).
func x64DiffConstTermError(p @Parser) x64.Operand {
	setErr(p, intelDiffConstError().Err)
	return x64.Imm(0)
}
