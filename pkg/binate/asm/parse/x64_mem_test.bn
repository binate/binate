package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/buf"
import "pkg/builtins/testing"

// x86-64 memory operands against clang's bytes (`clang -target x86_64-linux-gnu -c`, Intel
// syntax, after `C = 4`): each sign applies to the term after it alone, a register term is
// reg, reg*scale or scale*reg anywhere in the sum, a displacement term may use | or << only
// as the one displacement term, RSP after another register is the base, and an operand
// without a base is an index alone or the absolute [disp32].

// memCase checks that `mov rax, qword <op>`, after `C = 4`, assembles to exactly hex.
func memCase(e @[]char, op *[]readonly char, hex *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine("C = 4")
	var r testing.TestResult = lineEmitsHex(p, buf.Concat("mov rax, qword ", op), hex)
	if len(r) == 0 { return e }
	return buf.Concat(buf.Concat(e, r), "\n")
}

// memReject checks that `mov rax, qword <op>`, after `C = 4`, is rejected with a diagnostic
// containing want.
func memReject(e @[]char, op *[]readonly char, want *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine("C = 4")
	var line @[]char = buf.Concat("mov rax, qword ", op)
	p.ParseLine(line)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = p.Asm.ErrorMsg }
	if !p.HasError && !p.Asm.HasError { return buf.Concat(buf.Concat(e, line), ": accepted\n") }
	if !plContains(msg, want) {
		return buf.Concat(buf.Concat(buf.Concat(e, line), ": wrong diagnostic: "), buf.Concat(msg, "\n"))
	}
	return e
}

func TestX64MemTerms() testing.TestResult {
	var e @[]char = ""
	e = memCase(e, "[rbx - 8 + 4]", "48 8b 43 fc")
	e = memCase(e, "[rbx - 8 - 4]", "48 8b 43 f4")
	e = memCase(e, "[rbx + 8 - 4]", "48 8b 43 04")
	e = memCase(e, "[rbx + rcx*4 + 4]", "48 8b 44 8b 04")
	e = memCase(e, "[rbx + rcx*2 - 1]", "48 8b 44 4b ff")
	e = memCase(e, "[rbx + 8 + rcx]", "48 8b 44 0b 08")
	e = memCase(e, "[8 + rbx]", "48 8b 43 08")
	e = memCase(e, "[-8 + rbx]", "48 8b 43 f8")
	e = memCase(e, "[rbx + 2*rcx]", "48 8b 04 4b")
	e = memCase(e, "[rbx + 4*rcx + 8]", "48 8b 44 8b 08")
	e = memCase(e, "[rbx + C*rcx]", "48 8b 04 8b")
	e = memCase(e, "[rbx + rcx*C]", "48 8b 04 8b")
	e = memCase(e, "[rcx*2 + rbx]", "48 8b 04 4b")
	e = memCase(e, "[rbx + rsp]", "48 8b 04 1c")
	e = memCase(e, "[rcx*1 + rsp]", "48 8b 04 0c")
	e = memCase(e, "[rbx - (8 + 4)]", "48 8b 43 f4")
	e = memCase(e, "[rbx - 8*2]", "48 8b 43 f0")
	e = memCase(e, "[rbx + (8)]", "48 8b 43 08")
	e = memCase(e, "[rbx + 1 << 2]", "48 8b 43 04")
	e = memCase(e, "[1 << 2 + rbx]", "48 8b 43 04")
	e = memCase(e, "[rbx + 8 | 4]", "48 8b 43 0c")
	e = memCase(e, "[3 | 4 + rbx]", "48 8b 43 07")
	e = memCase(e, "[rbx + C - 2]", "48 8b 43 02")
	e = memCase(e, "[rbx - C + 2]", "48 8b 43 fe")
	e = memCase(e, "[8]", "48 8b 04 25 08 00 00 00")
	e = memCase(e, "[-1]", "48 8b 04 25 ff ff ff ff")
	e = memCase(e, "[0x7fffffff]", "48 8b 04 25 ff ff ff 7f")
	e = memCase(e, "[rcx*2 + 8]", "48 8b 04 4d 08 00 00 00")
	e = memCase(e, "[rbx*2]", "48 8b 04 5d 00 00 00 00")
	e = memCase(e, "[rcx*1]", "48 8b 04 0d 00 00 00 00")
	e = memCase(e, "[r12 + r13*8 + 0x100]", "4b 8b 84 ec 00 01 00 00")
	e = memCase(e, "[r13]", "49 8b 45 00")
	e = memCase(e, "[rbp - 8]", "48 8b 45 f8")
	e = memCase(e, "[rsp + 8]", "48 8b 44 24 08")
	e = memCase(e, "[r12 + 8]", "49 8b 44 24 08")
	e = memCase(e, "[rbx + rcx*8 - 0x80]", "48 8b 44 cb 80")
	e = memCase(e, "[r15*8]", "4a 8b 04 fd 00 00 00 00")
	e = memCase(e, "[rbx + 0x7fffffff]", "48 8b 83 ff ff ff 7f")
	e = memCase(e, "[rbx - 0x80000000]", "48 8b 83 00 00 00 80")
	return e
}

// A label difference fixed at assembly (ELF: one section) is a number in a displacement term
// (clang takes no symbol there at all).
func TestX64MemLabelDifference() testing.TestResult {
	p, a := newX64Parser()
	a.ObjFormat = asm.OBJ_ELF
	p.ParseLine("l1: nop")
	p.ParseLine("l2: nop")
	return lineEmitsHex(p, "mov rax, qword [rbx + (l2 - l1)]", "90 90 48 8b 43 01")
}

// Rejected: a | ^ & << >> term beside another displacement term or subtracted (clang's C
// precedences read those differently: `[rbx + 3 | 4 + 1]` is 7, `[rbx - 8 | 4]` -4,
// `[rbx - 7 >> 1]` -4), a third register, a subtracted register, a scale other than one
// number or constant of 1, 2, 4 or 8 (clang reads `rcx*2*2` as rcx*2), RSP as an index, a
// register other than a 64-bit general one, a displacement beyond 32 bits (clang keeps its
// low 32 bits), a symbol, and a missing ']'.
func TestX64MemRejects() testing.TestResult {
	var e @[]char = ""
	var loose *[]readonly char = "ambiguous operator precedence in a memory operand"
	e = memReject(e, "[rbx + 3 | 4 + 1]", loose)
	e = memReject(e, "[rbx - 8 | 4]", loose)
	e = memReject(e, "[rbx + 1 << 2 + 1]", loose)
	e = memReject(e, "[rbx - 7 >> 1]", loose)
	e = memReject(e, "[rbx + 8 - 8 | 4]", loose)
	e = memReject(e, "[rbx + 1 + 2 * 3 | 4]", loose)
	e = memReject(e, "[rbx + rcx + rdx]", "at most a base and an index")
	e = memReject(e, "[rbx + rcx*2 + rdx*2]", "at most a base and an index")
	e = memReject(e, "[rbx - rcx]", "cannot be subtracted")
	e = memReject(e, "[-rbx]", "cannot be subtracted")
	e = memReject(e, "[rbx + rcx*3]", "scale is 1, 2, 4 or 8")
	e = memReject(e, "[rbx + 3*rcx]", "scale is 1, 2, 4 or 8")
	e = memReject(e, "[rbx + rcx*2*2]", "register term is reg, reg*scale or scale*reg")
	e = memReject(e, "[rbx + 2*rcx*2]", "register term is reg, reg*scale or scale*reg")
	e = memReject(e, "[rbx + rcx << 1]", "register term is reg, reg*scale or scale*reg")
	e = memReject(e, "[rbx + rcx*(2)]", "scale is a number or a constant's name")
	e = memReject(e, "[rbx + rcx*lbl]", "lbl")
	e = memReject(e, "[rsp*2]", "rsp cannot be a memory operand's index")
	e = memReject(e, "[rsp*1]", "rsp cannot be a memory operand's index")
	e = memReject(e, "[rsp + rsp]", "rsp cannot be a memory operand's index")
	e = memReject(e, "[rbx + rsp*2]", "rsp cannot be a memory operand's index")
	e = memReject(e, "[eax]", "not a 64-bit register")
	e = memReject(e, "[rbx + ecx]", "not a 64-bit register")
	e = memReject(e, "[xmm0]", "is not a base or index register")
	e = memReject(e, "[rbx + rip]", "rip only begins a memory operand")
	e = memReject(e, "[rbx + 0x80000000]", "signed 32-bit value")
	e = memReject(e, "[rbx - 0x80000001]", "signed 32-bit value")
	e = memReject(e, "[0xffffffff]", "signed 32-bit value")
	e = memReject(e, "[rbx + lbl]", "'lbl' is not a constant defined before this line")
	e = memReject(e, "[rbx + 8", "expected '+', '-' or ']'")
	e = memReject(e, "[rbx 8]", "expected '+', '-' or ']'")
	e = memReject(e, "[]", "empty memory operand")
	e = memReject(e, "[rbx + rcx*rcx]", "'rcx' is a register, not a scale")
	e = memReject(e, "[rbx + rcx*xmm0]", "'xmm0' is a register, not a scale")
	return e
}

// A constant named like a register is not read as a scale either (clang reads the
// register there).
func TestX64MemScaleNamedLikeRegister() testing.TestResult {
	p, _ := newX64Parser()
	p.ParseLine("k1 = 4")
	p.ParseLine("mov rax, qword [rbx + rcx*k1]")
	if !p.HasError || !plContains(p.ErrorMsg, "'k1' is a register, not a scale") {
		return fail(buf.Concat("rcx*k1 not rejected: ", p.ErrorMsg))
	}
	return ""
}
