package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// A symbol as an x86-64 instruction's immediate, `offset sym [± n]` (x64.ImmSym), as clang takes
// it: a symbol plus numbers in any order, the symbol optionally followed by a thread-local offset
// operator, `offset sym@TPOFF` / `@DTPOFF`, and an addend after it (parseX64TlsAddend).  A number
// after `offset` (a constant's name, a fixed label difference: clang's value) is that immediate;
// `.` is an error, and so are the other operators (clang relocates `offset x@GOTTPOFF` as a slot
// reference in an imm32).  The encoders choose the field and its relocation, and reject a symbol
// where an instruction has no such field (a shift count).

// x64OffsetStart reports whether tok begins `offset ...`.
func x64OffsetStart(tok Token) bool { return tok.Kind == TOK_IDENT && mnemIs(tok.Text, "offset") }

// parseX64Offset parses the operand after `offset` (l just after it).
func parseX64Offset(p @Parser, l Lexer) (Lexer, Token, x64.Operand) {
	var tok Token
	l, tok = LexNext(l)
	var r ExprResult
	l, tok, r = parseSymExpr(p, l, tok)
	if !r.Ok {
		setErr(p, exprErr(r, "invalid operand after offset (a symbol plus numbers)"))
		return l, tok, x64.Imm(0)
	}
	if r.Dot {
		setErr(p, "offset takes a symbol or a number, not `.`")
		return l, tok, x64.Imm(0)
	}
	// (A value waiting for a later label is an error at the instruction, as everywhere on x86-64.)
	if r.Pending || !isSymbolic(r) {
		if tok.Kind == TOK_AT {
			setErr(p, "a thread-local operator takes a symbol")
			return l, tok, x64.Imm(0)
		}
		return l, tok, x64.Imm64(r.Val)
	}
	if tok.Kind != TOK_AT { return l, tok, x64.ImmSym(r.Sym, r.Val, 0) }
	if asm.IsGeneratedLabel(r.Sym) {
		setErr(p, "a thread-local operator takes a symbol")
		return l, tok, x64.Imm(0)
	}
	l, tok = LexNext(l)
	var kind int = 0
	if tok.Kind == TOK_IDENT && mnemIs(tok.Text, "tpoff") { kind = x64.FIX_TPOFF32 }
	if tok.Kind == TOK_IDENT && mnemIs(tok.Text, "dtpoff") { kind = x64.FIX_DTPOFF32 }
	if kind == 0 {
		setErr(p, "an immediate takes the thread-local offsets @TPOFF and @DTPOFF")
		return l, tok, x64.Imm(0)
	}
	l, tok = LexNext(l)
	var addend int64 = 0
	var ok bool = false
	l, tok, addend, ok = parseX64TlsAddend(p, l, tok)
	if !ok { return l, tok, x64.Imm(0) }
	return l, tok, x64.ImmSym(r.Sym, r.Val + addend, kind)
}
