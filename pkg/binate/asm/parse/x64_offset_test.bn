package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// `offset sym` immediates (x64_offset.bn) against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).  (x64TlsCase is in x64_tls_test.bn,
// x64LineRejected in x64_target_test.bn.)

// `offset x` plus numbers on either side, in the operation-width field of each instruction that
// takes one, with `movabs`; a thread-local offset after the symbol, an addend after the operator.
func TestX64Offset() testing.TestResult {
	var e @[]char = ""
	var s32 int = asm.FIX_DATA_ABS32
	var s64 int = x64.FIX_ABS32S
	e = x64TlsCase(e, "mov rax, offset x", "48 c7 c0 00 00 00 00", s64, 3, 0)
	e = x64TlsCase(e, "mov eax, OFFSET x", "b8 00 00 00 00", s32, 1, 0)
	e = x64TlsCase(e, "mov ecx, offset x + 8", "b9 00 00 00 00", s32, 1, 8)
	e = x64TlsCase(e, "mov ecx, offset 8 + x", "b9 00 00 00 00", s32, 1, 8)
	e = x64TlsCase(e, "mov ax, offset x", "66 b8 00 00", asm.FIX_DATA_ABS16, 2, 0)
	e = x64TlsCase(e, "mov al, offset x", "b0 00", asm.FIX_DATA_ABS8, 1, 0)
	e = x64TlsCase(e, "movabs rax, offset x + 8", "48 b8 00 00 00 00 00 00 00 00", asm.FIX_DATA_ABS64,
			2, 8)
	e = x64TlsCase(e, "add rax, offset x", "48 81 c0 00 00 00 00", s64, 3, 0)
	e = x64TlsCase(e, "sub rbx, offset x", "48 81 eb 00 00 00 00", s64, 3, 0)
	e = x64TlsCase(e, "and ecx, offset x", "81 e1 00 00 00 00", s32, 2, 0)
	e = x64TlsCase(e, "push offset x", "68 00 00 00 00", s64, 1, 0)
	e = x64TlsCase(e, "imul rax, rbx, offset x", "48 69 c3 00 00 00 00", s64, 3, 0)
	e = x64TlsCase(e, "mov qword ptr [rbx], offset x", "48 c7 03 00 00 00 00", s64, 3, 0)
	e = x64TlsCase(e, "mov rax, offset x@TPOFF + 8", "48 c7 c0 00 00 00 00", x64.FIX_TPOFF32, 3, 8)
	e = x64TlsCase(e, "add rax, offset x@dtpoff", "48 81 c0 00 00 00 00", x64.FIX_DTPOFF32, 3, 0)
	e = x64TlsCase(e, "movabs rax, offset x@TPOFF", "48 b8 00 00 00 00 00 00 00 00", x64.FIX_TPOFF64,
			2, 0)
	e = x64TlsCase(e, "E = x + 8\nmov eax, offset E", "b8 00 00 00 00", s32, 1, 8)
	// A number after `offset` is that immediate (clang's for a constant's name).
	e = x64SrcHex(e, "N = 5\nmov rax, offset N", "48 c7 c0 05 00 00 00")
	e = x64SrcHex(e, "mov eax, offset 7", "b8 07 00 00 00")
	return e
}

// What clang errors on or relocates as nonsense is an error: nothing after `offset`, another
// operator, a thread-local offset after a number or in an 8- or 16-bit field, a symbol as a shift
// count, an INT vector or RET's stack release, `movabs` into a 32-bit register; and a label
// difference waiting for later labels, as in every x86-64 instruction (its size depends on it).
func TestX64OffsetRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "mov rax, offset N@TPOFF")
	e = x64LineRejected(e, "mov rax, offset")
	e = x64LineRejected(e, "mov rax, offset x@GOTTPOFF")
	e = x64LineRejected(e, "mov rax, offset x@PLT")
	e = x64LineRejected(e, "mov rax, offset x@TPOFF * 2")
	e = x64LineRejected(e, "mov ax, offset x@TPOFF")
	e = x64LineRejected(e, "shl rax, offset x")
	e = x64LineRejected(e, "int offset x")
	e = x64LineRejected(e, "ret offset x")
	e = x64LineRejected(e, "movabs eax, offset x")
	e = x64SrcRejected(e, "mov rax, offset L2 - L1\nL1: nop\nL2: nop", "size depends on its values")
	return e
}
