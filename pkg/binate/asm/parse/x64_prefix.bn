package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64/prefix"
import "pkg/binate/asm/x64/strop"

// The x86-64 prefixes written as instructions of their own, as clang takes them: `data16`,
// `rex64`, `lock` (x64_lock.bn), the repeat prefixes `rep`, `repe`, `repz` (F3) and `repne`,
// `repnz` (F2), the lock-elision hints `xacquire` (F2) and `xrelease` (F3), and the six segment
// names, alone or before another on the line (`data16 data16 rex64 call __tls_get_addr@PLT`,
// `lock add [rbx], eax`, `rep movsb`), each its one byte.  The instruction after a lock or a
// repeat prefix comes straight after it, as clang reads it (`lock fs add ...` is an error, `fs
// lock add ...` is not), and one with prefixes alone after it is an error, as GNU as has it
// (`lock fs`, `rep fs`: clang emits the bytes); a lock-elision hint may have prefixes between it
// and its instruction (`xacquire fs lock add ...`), not prefixes alone (`xacquire lock`).  A
// repeat prefix with an instruction after it takes only one it repeats or changes — a string
// instruction (x64_str.bn), ret, nop without operands (F3 90 is PAUSE), bsf or bsr (F3: TZCNT /
// LZCNT), xstore, and (rep, repe or repz alone, standing for the F3 it carries) a PadLock
// instruction whose F3 is its own (x64PadlockOwnRep) — as GNU as checks (clang emits the F3 / F2
// before anything).  It
// stands where it is written, but before bsf / bsr after their operand's segment override, as
// clang orders them (`rep bsf eax, dword ptr fs:[rbx]` is 64 F3 0F BC 03; `rep movs byte ptr
// [rdi], byte ptr fs:[rsi]` F3 64 A4).  An instruction takes one of the repeat prefixes and
// lock-elision hints, its F2 / F3 byte, and no lock beside a repeat prefix: the instructions each
// takes are not the same ones.  (clang emits both bytes before an instruction, and keeps only the
// first of a `rep lock` or `lock rep` alone.)  A lock-elision hint with an instruction after it
// takes only one whose lock it elides (x64_lock.bn).

// x64PrefixesOnly reports whether tok and the tokens after it (l just after tok) to the end of the
// line are all prefixes written as instructions.
func x64PrefixesOnly(l Lexer, tok Token) bool {
	for tok.Kind != TOK_EOF {
		if tok.Kind != TOK_IDENT || !x64PrefixName(tok.Text) { return false }
		l, tok = LexNext(l)
	}
	return true
}

// x64HighByteAhead reports whether the rest of the line from l names ah, bh, ch or dh: rex64 before
// them would make them spl..dil, which GNU as rejects (clang emits the REX).
func x64HighByteAhead(l Lexer) bool {
	var t Token
	l, t = LexNext(l)
	for t.Kind != TOK_EOF {
		if t.Kind == TOK_IDENT && x64WordIndex(t.Text, " ah bh ch dh ") >= 0 { return true }
		l, t = LexNext(l)
	}
	return false
}

// x64RepName reports whether name names a repeat prefix: rep, repe, repz, repne or repnz.
func x64RepName(name *[]readonly char) bool {
	return mnemIs(name, "rep") || mnemIs(name, "repe") || mnemIs(name, "repz") ||
			mnemIs(name, "repne") || mnemIs(name, "repnz")
}

// x64HleName reports whether name names a lock-elision hint: xacquire or xrelease.
func x64HleName(name *[]readonly char) bool {
	return mnemIs(name, "xacquire") || mnemIs(name, "xrelease")
}

// x64PrefixName reports whether name names a prefix written as an instruction: `data16`, `rex64`,
// `lock`, a repeat prefix (x64RepName), a lock-elision hint (x64HleName) or a segment name.
func x64PrefixName(name *[]readonly char) bool {
	return x64SegOf(name) != 0 || mnemIs(name, "data16") || mnemIs(name, "rex64") ||
			mnemIs(name, "lock") || x64RepName(name) || x64HleName(name)
}

// x64PrefixInstruction assembles mnemTok (l just after it) when it names a prefix written as
// an instruction (x64PrefixName), then the instruction after it on the line, if any, and reports
// whether it did.
func x64PrefixInstruction(p @Parser, l Lexer, mnemTok Token) bool {
	// bnlint:allow managed-to-raw-assign - mnemTok is a live token; Text outlives the read
	var mnem *[]readonly char = mnemTok.Text
	if !x64PrefixName(mnem) { return false }
	// {rex} before prefixes alone, no instruction after them: its 40 goes first, as clang and GNU
	// as write it (no opcode follows for it to stand before).
	if p.Asm.X64Rex && x64PrefixesOnly(l, mnemTok) { p.Asm.EmitInstrUint8(0x40) }
	var tok Token
	l, tok = LexNext(l)
	// Pseudo-prefixes may follow a prefix but lock and the repeat prefixes, whose instruction comes
	// straight after them (x64_pseudo.bn).
	if tok.Kind == TOK_LBRACE && !mnemIs(mnem, "lock") && !x64RepName(mnem) {
		l, tok = parseX64PseudoPrefixes(p, l, tok)
		if p.HasError { return true }
		p.Asm.X64Rex = p.X64ForceRex
		p.Asm.X64Disp = p.X64Disp
	}
	if tok.Kind != TOK_EOF && tok.Kind != TOK_IDENT {
		setErr(p, "a prefix is followed by an instruction or ends the line")
		return true
	}
	if !x64PrefixPairOk(p, mnem, tok) { return true }
	if mnemIs(mnem, "rex64") && tok.Kind == TOK_IDENT && x64HighByteAhead(l) {
		setErr(p, "rex64 cannot stand before ah, bh, ch or dh: beside a REX prefix their codes are spl, "
				"bpl, sil and dil")
		return true
	}
	var lock bool = mnemIs(mnem, "lock")
	var rep bool = x64RepName(mnem)
	// The instruction after a lock emits its 0xF0, and bsf / bsr a repeat prefix's byte, after
	// any segment override (x64EmitSeg), as clang orders them.
	// A repeat prefix before a PadLock instruction with its own F3 is that F3: it is held, and the
	// instruction emits it (x64PadlockOwnRep).
	var later bool = tok.Kind == TOK_IDENT &&
			(lock ||
					(rep && (mnemIs(tok.Text, "bsf") || mnemIs(tok.Text, "bsr") || x64PadlockOwnRep(tok.Text))))
	if (lock || rep) && tok.Kind == TOK_IDENT && x64PrefixName(tok.Text) {
		setErr(p, "lock or a repeat prefix is followed by its instruction, not another prefix")
		return true
	}
	if tok.Kind == TOK_EOF && p.X64Hle != 0 {
		setErr(p, "a lock-elision hint is followed by its instruction, not prefixes alone")
		return true
	}
	x64EmitPrefix(p, mnem, later)
	if tok.Kind == TOK_IDENT { parseX64Instruction(p, l, tok) }
	return true
}

// x64PrefixPairOk reports whether the prefix mnem may stand before tok and after the prefixes its
// line wrote — one lock, one of the repeat prefixes and lock-elision hints (Parser.X64Rep,
// X64Hle), and no lock beside a repeat prefix — else sets the error.
func x64PrefixPairOk(p @Parser, mnem *[]readonly char, tok Token) bool {
	var nextLock bool = tok.Kind == TOK_IDENT && mnemIs(tok.Text, "lock")
	var nextRep bool = tok.Kind == TOK_IDENT && x64RepName(tok.Text)
	var nextHle bool = tok.Kind == TOK_IDENT && x64HleName(tok.Text)
	if mnemIs(mnem, "lock") && nextLock {
		setErr(p, "an instruction takes one lock prefix")
		return false
	}
	if (x64RepName(mnem) || x64HleName(mnem)) && (p.X64Rep || p.X64Hle != 0 || nextRep || nextHle) {
		setErr(p, "an instruction takes one of rep, repe, repz, repne, repnz, xacquire and xrelease")
		return false
	}
	if (mnemIs(mnem, "lock") && nextRep) || (x64RepName(mnem) && nextLock) {
		setErr(p, "no instruction takes both lock and a repeat prefix")
		return false
	}
	return true
}

// x64EmitPrefix emits the prefix mnem (x64PrefixName) — or, with later, has the instruction after
// it emit a lock's 0xF0 or a repeat prefix's byte (Parser.X64Lock, X64RepByte) — and notes a
// repeat prefix or lock-elision hint (Parser.X64Rep, X64Hle).
func x64EmitPrefix(p @Parser, mnem *[]readonly char, later bool) {
	var seg int = x64SegOf(mnem)
	if seg != 0 {
		prefix.SegPrefix(p.Asm, seg)
	} else if mnemIs(mnem, "data16") {
		prefix.Data16(p.Asm)
	} else if mnemIs(mnem, "rex64") {
		prefix.Rex64(p.Asm)
	} else if mnemIs(mnem, "lock") {
		if later {
			p.X64Lock = true
		} else {
			prefix.Lock(p.Asm)
		}
	} else if x64RepName(mnem) {
		p.X64Rep = true
		var b int = 0xF3
		if mnemIs(mnem, "repne") || mnemIs(mnem, "repnz") { b = 0xF2 }
		if later {
			p.X64RepByte = b
		} else if b == 0xF3 {
			strop.Rep(p.Asm)
		} else {
			strop.Repne(p.Asm)
		}
	} else if mnemIs(mnem, "xacquire") {
		p.X64Hle = 0xF2
		prefix.Xacquire(p.Asm)
	} else {
		p.X64Hle = 0xF3
		prefix.Xrelease(p.Asm)
	}
}

// x64RepOk reports whether the instruction mnem (l just after it) may follow the repeat prefix
// its line wrote (Parser.X64Rep), if any — a string instruction, ret, nop without operands, bsf,
// bsr, xstore, or a PadLock instruction with its own F3 after F3 — else sets the error.
func x64RepOk(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !p.X64Rep { return true }
	var kind int = -1
	kind, _ = x64StrMnem(mnem)
	// (movsd and cmpsd with an XMM register are SSE's, x64_sse.bn, where GNU as takes no repeat
	// prefix.)
	if kind >= 0 && (mnemIs(mnem, "movsd") || mnemIs(mnem, "cmpsd")) && x64XmmOnLine(l) { kind = -1 }
	if kind >= 0 || mnemIs(mnem, "ret") || mnemIs(mnem, "retn") || mnemIs(mnem, "bsf") ||
			mnemIs(mnem, "bsr") || mnemIs(mnem, "xstore") || mnemIs(mnem, "xstorerng") {
		return true
	}
	if x64PadlockOwnRep(mnem) {
		if p.X64RepByte == 0xF3 { return true }
		setErr(p, "repne and repnz cannot stand before an instruction whose F3 is its own")
		return false
	}
	if mnemIs(mnem, "nop") {
		var next Token
		_, next = LexNext(l)
		if next.Kind == TOK_EOF { return true }
	}
	setErr(p, "a repeat prefix takes a string instruction (movs, cmps, scas, lods, stos, ins, outs), "
			"ret, nop, bsf, bsr or a PadLock instruction")
	return false
}
