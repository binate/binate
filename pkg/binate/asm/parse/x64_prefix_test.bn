package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"

// The prefixes written as instructions and how they combine (x64_prefix.bn), against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn.)

// `data16`, `rex64` and a segment's name are instructions of their own, alone or before another
// on the line (another prefix included), each its one byte as written — but rex64 before an
// instruction, its REX.W where the instruction's REX goes (x64_rex64_test.bn).
func TestX64PrefixInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fs", "64")
	e = x64SrcHex(e, "gs nop", "65 90")
	e = x64SrcHex(e, "fs fs mov eax, dword ptr [rbx]", "64 64 8b 03")
	e = x64SrcHex(e, "fs mov eax, dword ptr gs:[rbx]", "64 65 8b 03")
	e = x64SrcHex(e, "data16", "66")
	e = x64SrcHex(e, "rex64", "48")
	e = x64SrcHex(e, "data16 mov ax, bx", "66 66 89 d8")
	e = x64SrcHex(e, "data16 mov eax, dword ptr fs:[rbx]", "66 64 8b 03")
	e = x64SrcHex(e, "DATA16 REX64 ret", "66 48 c3")
	return e
}

// rep / repe / repz (F3) and repne / repnz (F2) alone, before each string instruction, ret, nop,
// bsf and bsr, written where they stand among the other prefixes (before a 66, REX or an
// operand's segment override, after a prefix written before them) but before bsf / bsr after the
// segment override.
func TestX64RepeatPrefixes() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "rep movsb", "f3 a4")
	e = x64SrcHex(e, "repe cmpsq", "f3 48 a7")
	e = x64SrcHex(e, "repz scasw", "f3 66 af")
	e = x64SrcHex(e, "repne stosd", "f2 ab")
	e = x64SrcHex(e, "repnz lodsb", "f2 ac")
	e = x64SrcHex(e, "rep insb", "f3 6c")
	e = x64SrcHex(e, "rep outsd", "f3 6f")
	e = x64SrcHex(e, "rep movs qword ptr [rdi], qword ptr [rsi]", "f3 48 a5")
	e = x64SrcHex(e, "rep movs byte ptr [rdi], byte ptr fs:[rsi]", "f3 64 a4")
	e = x64SrcHex(e, "repe cmps byte ptr gs:[rsi], byte ptr [rdi]", "f3 65 a6")
	e = x64SrcHex(e, "rep lods al, byte ptr ds:[rsi]", "f3 ac")
	e = x64SrcHex(e, "rep", "f3")
	e = x64SrcHex(e, "repne", "f2")
	e = x64SrcHex(e, "rep ret", "f3 c3")
	e = x64SrcHex(e, "rep ret 8", "f3 c2 08 00")
	e = x64SrcHex(e, "rep retn", "f3 c3")
	e = x64SrcHex(e, "rep nop", "f3 90")
	e = x64SrcHex(e, "rep bsf rax, qword ptr [rbx]", "f3 48 0f bc 03")
	e = x64SrcHex(e, "rep bsr ax, bx", "f3 66 0f bd c3")
	e = x64SrcHex(e, "repne bsf eax, ebx", "f2 0f bc c3")
	e = x64SrcHex(e, "rep bsf eax, dword ptr fs:[rbx]", "64 f3 0f bc 03")
	e = x64SrcHex(e, "rep bsr ax, word ptr gs:[rbx]", "65 f3 66 0f bd 03")
	e = x64SrcHex(e, "repne bsr rax, qword ptr fs:[rbx]", "64 f2 48 0f bd 03")
	e = x64SrcHex(e, "repe bsr eax, dword ptr es:[rbx]", "26 f3 0f bd 03")
	e = x64SrcHex(e, "rep bsf eax, dword ptr ds:[rbx]", "3e f3 0f bc 03")
	e = x64SrcHex(e, "fs rep bsf eax, dword ptr gs:[rbx]", "64 65 f3 0f bc 03")
	e = x64SrcHex(e, "rep; movsb", "f3 a4")
	e = x64SrcHex(e, "rep\nadd eax, ebx", "f3 01 d8")
	e = x64SrcHex(e, "fs rep movsb", "64 f3 a4")
	e = x64SrcHex(e, "data16 rep movsb", "66 f3 a4")
	e = x64SrcHex(e, "rex64 rep movsb", "f3 48 a4")
	e = x64SrcHex(e, "rex64 rep", "48 f3")
	e = x64SrcHex(e, "REP stosb", "f3 aa")
	return e
}

// x64LineErrorHas adds line to the failures e unless it is an error whose message holds msg.
func x64LineErrorHas(e @[]char, line *[]readonly char, msg *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine(line)
	if p.HasError && plContains(p.ErrorMsg, msg) { return e }
	return goldenFail(e, line, buf.Concat("error: ", p.ErrorMsg))
}

// A repeat prefix before an instruction it does not repeat or change (clang emits it), two of the
// repeat prefixes and lock-elision hints, a lock beside a repeat prefix (none takes both), and
// what clang rejects: another prefix between a repeat prefix and its instruction, operands a
// string instruction does not take; and prefixes alone after a repeat prefix, which GNU as
// rejects (clang emits the bytes).
func TestX64RepeatPrefixRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "rep add eax, ebx")
	e = x64LineRejected(e, "rep add [rbx], eax")
	e = x64LineRejected(e, "rep mov eax, ebx")
	e = x64LineRejected(e, "rep jmp lbl")
	e = x64LineRejected(e, "repne call lbl")
	e = x64LineErrorHas(e, "rep nop eax", "a repeat prefix takes")
	e = x64LineRejected(e, "rep rep movsb")
	e = x64LineRejected(e, "rep repne movsb")
	e = x64LineRejected(e, "xacquire rep movsb")
	e = x64LineRejected(e, "xrelease rep movsb")
	e = x64LineRejected(e, "rep xacquire")
	e = x64LineRejected(e, "xacquire xacquire lock add [rbx], eax")
	e = x64LineRejected(e, "xacquire xrelease lock add [rbx], eax")
	e = x64LineRejected(e, "xacquire fs xrelease lock add [rbx], eax")
	e = x64LineRejected(e, "lock rep")
	e = x64LineRejected(e, "rep lock")
	e = x64LineRejected(e, "lock rep movsb")
	e = x64LineRejected(e, "rep lock movsb")
	e = x64LineRejected(e, "rep fs movsb")
	e = x64LineRejected(e, "rep data16 movsb")
	e = x64LineRejected(e, "rep rex64 movsb")
	e = x64LineRejected(e, "rep xrelease movsb")
	e = x64LineRejected(e, "rep movsb al")
	e = x64LineRejected(e, "rep fs")
	e = x64LineRejected(e, "rep data16")
	e = x64LineRejected(e, "rep rex64")
	e = x64LineRejected(e, "repne fs")
	return e
}
