package "pkg/binate/asm/parse"

// The x86-64 pseudo-prefixes, as clang takes them: `{disp8}`, `{disp32}` and `{rex}`, in any
// case, before a statement's instruction: after its labels, or after a prefix written as an
// instruction but lock and the repeat prefixes, whose instruction comes straight after them
// (x64_prefix.bn; GNU as takes them there too).  {disp8} gives a memory operand with a base and a
// displacement of 0 an 8-bit one, {disp32} a 32-bit one whatever its value (the last of the two
// counts); neither changes another operand, nor an instruction with no ModR/M byte (a string
// instruction's explicit operands, xlat's), as clang and GNU as (asm.Assembler.X64Disp).  {rex}
// puts a REX prefix right before the opcode where the instruction has none of its own
// (asm.Assembler.X64Rex), and first before prefixes alone; it is an error beside ah..dh, as
// clang's (GNU as drops it from register and memory forms, and keeps it before an immediate,
// making ah spl), and before a VEX- or XOP-encoded instruction.  {vex}, {vex2}, {vex3}, {evex},
// {rex2} and {nf}, which choose among encodings this assembler does not have, are errors, as is
// any other name (clang: "unknown prefix").

// parseX64PseudoPrefixes reads the pseudo-prefixes from tok (a `{`; l just after it) into
// Parser.X64Disp and X64ForceRex, and returns the token after them, which must name the
// instruction (GNU as: "pseudo prefix without instruction"), else sets the error.
func parseX64PseudoPrefixes(p @Parser, l Lexer, tok Token) (Lexer, Token) {
	for tok.Kind == TOK_LBRACE {
		var name Token
		l, name = LexNext(l)
		var close Token
		l, close = LexNext(l)
		if name.Kind != TOK_IDENT || close.Kind != TOK_RBRACE {
			setErr(p, "a pseudo-prefix is a name in braces: {disp8}, {disp32} or {rex}")
			return l, tok
		}
		if mnemIs(name.Text, "disp8") {
			p.X64Disp = 8
		} else if mnemIs(name.Text, "disp32") {
			p.X64Disp = 32
		} else if mnemIs(name.Text, "rex") {
			p.X64ForceRex = true
		} else if x64WordIndex(name.Text, " vex vex2 vex3 evex rex2 nf ") >= 0 {
			setErr(p, quotedName(name.Text, " chooses among encodings this assembler does not have"))
			return l, tok
		} else {
			setErr(p, quotedName(name.Text, " is no pseudo-prefix (unknown prefix)"))
			return l, tok
		}
		l, tok = LexNext(l)
	}
	var after Token
	_, after = LexNext(l)
	if tok.Kind != TOK_IDENT || tok.Text[0] == '.' || after.Kind == TOK_EQUALS ||
			after.Kind == TOK_COLON {
		setErr(p, "a pseudo-prefix is followed by its instruction")
	}
	return l, tok
}
