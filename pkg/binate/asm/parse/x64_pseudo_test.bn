package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The pseudo-prefixes (x64_pseudo.bn) against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`) — and GNU as's where they differ:
// `{rex} fs mov` puts the REX after the segment override, as GNU as (clang writes it first, where
// the processor ignores it).  (x64SrcHex and x64LineRejected are in x64_target_test.bn,
// x64TlsCase in x64_tls_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// {disp8} and {disp32} on each base form, an index, rip, an absolute address, a symbol's
// displacement, a VEX instruction, the last of the two; neither changes a register operand.
func TestX64PseudoDisp() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "{disp8} mov eax, [rbx]", "8b 43 00")
	e = x64SrcHex(e, "{DISP8} mov eax, [rbp]", "8b 45 00")
	e = x64SrcHex(e, "{disp8} mov eax, [rbx + 0x100]", "8b 83 00 01 00 00")
	e = x64SrcHex(e, "{disp8} mov eax, [rbx + rcx*4]", "8b 44 8b 00")
	e = x64SrcHex(e, "{disp8} mov eax, [rsp]", "8b 44 24 00")
	e = x64SrcHex(e, "{disp8} mov eax, [r13]", "41 8b 45 00")
	e = x64SrcHex(e, "{disp8} mov eax, [rcx*4]", "8b 04 8d 00 00 00 00")
	e = x64SrcHex(e, "{disp8} mov ah, byte ptr [rbx]", "8a 63 00")
	e = x64SrcHex(e, "{disp8} lea rax, [rbx]", "48 8d 43 00")
	e = x64SrcHex(e, "{disp8} mov eax, ebx", "89 d8")
	e = x64SrcHex(e, "{disp32} mov eax, [rbx]", "8b 83 00 00 00 00")
	e = x64SrcHex(e, "{disp32} mov eax, [rbp]", "8b 85 00 00 00 00")
	e = x64SrcHex(e, "{disp32} mov eax, [rbx + rcx*4]", "8b 84 8b 00 00 00 00")
	e = x64SrcHex(e, "{disp32} mov eax, [rsp + 8]", "8b 84 24 08 00 00 00")
	e = x64SrcHex(e, "{disp32} add dword ptr [rax], 1", "83 80 00 00 00 00 01")
	e = x64SrcHex(e, "{disp32} movnti [rax], ebx", "0f c3 98 00 00 00 00")
	e = x64SrcHex(e, "{disp8} andn eax, ebx, [rax]", "c4 e2 60 f2 40 00")
	e = x64SrcHex(e, "{disp8} {disp32} mov eax, [rbx]", "8b 83 00 00 00 00")
	e = x64SrcHex(e, "{disp32} {disp8} mov eax, [rbx]", "8b 43 00")
	e = x64TlsCase(e, "{disp8} mov eax, [rip + x]", "8b 05 00 00 00 00", x64.FIX_REL32_LEA, 2, 0)
	e = x64SrcHex(e, "{disp8} mov eax, [rbx]\nmov eax, [rbx]", "8b 43 00 8b 03")
	e = x64SrcHex(e, "{disp32} movs byte ptr [rdi], byte ptr [rsi]", "a4")
	e = x64SrcHex(e, "{disp32} stos dword ptr [rdi], eax", "ab")
	e = x64SrcHex(e, "{disp32} xlat byte ptr [rbx]", "d7")
	e = x64SrcHex(e, "{disp8} lods eax, dword ptr [rsi]", "ad")
	return e
}

// {rex}: 40 before the opcode, after legacy prefixes (lock, a mandatory F3, a segment override
// written either way, data16), merged into a REX of the instruction's own (rex64's: clang writes
// 48 40, the 48 then ignored); on the forms without operands, pushes, jumps and the aliases; for
// its statement alone.  A pseudo-prefix may follow a prefix written as an instruction but lock and
// the repeat prefixes.
func TestX64PseudoRex() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "{rex} mov eax, ebx", "40 89 d8")
	e = x64SrcHex(e, "{ REX } mov rax, rbx", "48 89 d8")
	e = x64SrcHex(e, "{rex} mov r8d, ebx", "41 89 d8")
	e = x64SrcHex(e, "{rex} add al, bl", "40 00 d8")
	e = x64SrcHex(e, "{rex} nop", "40 90")
	e = x64SrcHex(e, "{rex} pause", "f3 40 90")
	e = x64SrcHex(e, "{rex} push rbx", "40 53")
	e = x64SrcHex(e, "{rex} xchg eax, ebx", "40 93")
	e = x64SrcHex(e, "{rex} rdtsc", "40 0f 31")
	e = x64SrcHex(e, "{rex} lock add [rax], eax", "f0 40 01 00")
	e = x64SrcHex(e, "{rex} fs mov eax, [rbx]", "64 40 8b 03")
	e = x64SrcHex(e, "fs mov eax, [rbx]", "64 8b 03")
	e = x64SrcHex(e, "fs {rex} mov eax, [rbx]", "64 40 8b 03")
	e = x64SrcHex(e, "fs gs {rex} {disp8} mov eax, [rbx]", "64 65 40 8b 43 00")
	e = x64SrcHex(e, "cs {disp32} mov eax, [rbx]", "2e 8b 83 00 00 00 00")
	e = x64SrcHex(e, "data16 {rex} mov eax, ebx", "66 40 89 d8")
	e = x64SrcHex(e, "{rex} data16 mov eax, ebx", "66 40 89 d8")
	e = x64SrcHex(e, "rex64 {rex} mov eax, ebx", "48 89 d8")
	e = x64SrcHex(e, "xacquire {rex} lock add [rax], eax", "f2 f0 40 01 00")
	e = x64SrcHex(e, "{rex} cmpxchg16b [rax]", "48 0f c7 08")
	e = x64SrcHex(e, "{rex} mov.s eax, ebx", "40 8b c3")
	e = x64SrcHex(e, "{rex} clr eax", "40 31 c0")
	e = x64SrcHex(e, "{rex} inb 1", "40 e4 01")
	e = x64SrcHex(e, "{rex} {rex} mov eax, ebx\nmov eax, ebx", "40 89 d8 89 d8")
	e = x64TlsCase(e, "{rex} jmp x", "40 e9 00 00 00 00", x64.FIX_REL32, 2, 0)
	e = x64TlsCase(e, "{rex} mov eax, [rip + x@GOTPCREL]", "40 8b 05 00 00 00 00",
			x64.FIX_REX_GOTPCRELX, 3, 0)
	e = x64TlsCase(e, "{rex} call [rip + x@GOTPCREL]", "40 ff 15 00 00 00 00", x64.FIX_REX_GOTPCRELX,
			3, 0)
	e = x64TlsCase(e, "mov eax, [rip + x@GOTPCREL]", "8b 05 00 00 00 00", x64.FIX_GOTPCRELX, 2, 0)
	return e
}

// {rex} before prefixes alone, with no instruction after them on the line: its 40 first, as clang
// and GNU as write it, for that statement alone.
func TestX64PseudoRexBeforePrefixes() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "{rex} fs", "40 64")
	e = x64SrcHex(e, "{rex} data16", "40 66")
	e = x64SrcHex(e, "{rex} lock", "40 f0")
	e = x64SrcHex(e, "{rex} rep", "40 f3")
	e = x64SrcHex(e, "{rex} rex64", "40 48")
	e = x64SrcHex(e, "{rex} fs gs", "40 64 65")
	e = x64SrcHex(e, "{rex} fs\nnop", "40 64 90")
	e = x64SrcHex(e, "{rex} fs ; nop", "40 64 90")
	return e
}

// What clang rejects: {rex} beside ah..dh (GNU as drops the REX instead), before a VEX- or
// XOP-encoded instruction; a pseudo-prefix alone, before a directive, a constant or a label, after
// a prefix, of another name ({disp16}, GNU as's {load} / {store}), or choosing an encoding this
// assembler does not have yet ({evex} .. {nf}).  ({vex} .. {vex3} are x64_avx_test.bn's.)
func TestX64PseudoRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "{rex} mov ah, al",
			"cannot be encoded in an instruction that needs a REX prefix")
	e = x64LineRejected(e, "{rex} mov.s ah, al")
	e = x64LineRejected(e, "{rex} andn eax, ebx, ecx")
	e = x64LineRejected(e, "{rex} llwpcb eax")
	e = x64LineErrorHas(e, "{rex}", "a pseudo-prefix is followed by its instruction")
	e = x64LineRejected(e, "{rex} .byte 1")
	e = x64LineRejected(e, "{rex} y = 1")
	e = x64LineRejected(e, "{rex} y: nop")
	e = x64LineRejected(e, "lock {rex} add [rax], eax")
	e = x64LineRejected(e, "rep {rex} movsb")
	e = x64LineRejected(e, "fs {rex}")
	e = x64LineRejected(e, "{rex nop")
	e = x64LineRejected(e, "{} nop")
	e = x64LineErrorHas(e, "{disp16} mov eax, [rbx]", "unknown prefix")
	e = x64LineRejected(e, "{load} mov eax, ebx")
	e = x64LineRejected(e, "{store} mov eax, ebx")
	e = x64LineErrorHas(e, "{evex} vaddps xmm0, xmm1, xmm2", "does not have")
	e = x64LineRejected(e, "{evex} mov eax, ebx")
	e = x64LineRejected(e, "{nf} add eax, ebx")
	return e
}
