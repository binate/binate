package "pkg/binate/asm/parse"

// The names clang's Intel-syntax x86-64 assembler reads as registers, whether or not this
// parser encodes them: a constant so named cannot stand as a number where a register can,
// since clang reads the register there (`ss = 16` then `mov rax, ss` moves the segment
// register).

// x64ConstOperand reports whether name is a constant that stands as a number in an operand
// (an immediate, or a displacement in brackets); a constant named like a register is an
// error there (clang reads the register), reported on p.
func x64ConstOperand(p @Parser, name *[]readonly char) bool {
	if constIndex(p, name) < 0 { return false }
	if isX64RegisterName(name) {
		setErr(p, quotedName(name, " is a constant named like a register, which clang reads there"))
		return false
	}
	return true
}

// isX64RegisterName reports whether name (case-insensitively) names an x86-64 register
// clang knows: the general registers of every width (r8..r31 included, with their d / w / b
// forms), ah / bh / ch / dh, rip / eip / ip, riz / eiz, the segment registers, st, mm0..7,
// xmm / ymm / zmm 0..31, k0..7, tmm0..7, cr0..15 and dr0..15.
func isX64RegisterName(name *[]readonly char) bool {
	var lower [8]char
	if len(name) == 0 || len(name) > len(lower) { return false }
	for i := 0; i < len(name); i++ {
		var c char = name[i]
		if c >= 'A' && c <= 'Z' { c = c + ('a' - 'A') }
		lower[i] = c
	}
	var n *[]readonly char = lower[0:len(name)]
	var fixed *[]readonly char = " rax rbx rcx rdx rsi rdi rbp rsp eax ebx ecx edx esi edi ebp esp "
			"ax bx cx dx si di bp sp al bl cl dl ah bh ch dh sil dil bpl spl "
			"rip eip ip riz eiz cs ds es fs gs ss st "
	if wordIn(n, fixed) { return true }
	if regNumbered(n, "r", 8, 31, true) { return true }
	if regNumbered(n, "mm", 0, 7, false) || regNumbered(n, "k", 0, 7, false) ||
			regNumbered(n, "tmm", 0, 7, false) {
		return true
	}
	if regNumbered(n, "xmm", 0, 31, false) || regNumbered(n, "ymm", 0, 31, false) ||
			regNumbered(n, "zmm", 0, 31, false) {
		return true
	}
	return regNumbered(n, "cr", 0, 15, false) || regNumbered(n, "dr", 0, 15, false)
}

// wordIn reports whether w occurs in list as a space-delimited word (list starts and ends
// with a space).
func wordIn(w *[]readonly char, list *[]readonly char) bool {
	for i := 0; i + len(w) + 1 < len(list); i++ {
		if list[i] != ' ' || list[i + len(w) + 1] != ' ' { continue }
		if charsEqual(list[i + 1:i + 1 + len(w)], w) { return true }
	}
	return false
}

// regNumbered reports whether n is prefix followed by a decimal lo..hi with no leading
// zero, and — sized — optionally one of the width suffixes d, w or b (r8d, r8w, r8b).
func regNumbered(n *[]readonly char, prefix *[]readonly char, lo int, hi int, sized bool) bool {
	if len(n) <= len(prefix) || !charsEqual(n[0:len(prefix)], prefix) { return false }
	var end int = len(n)
	var last char = n[end - 1]
	if sized && (last == 'd' || last == 'w' || last == 'b') { end = end - 1 }
	var digits *[]readonly char = n[len(prefix):end]
	if len(digits) == 0 || len(digits) > 2 || (len(digits) == 2 && digits[0] == '0') { return false }
	var v int = 0
	for i := 0; i < len(digits); i++ {
		if digits[i] < '0' || digits[i] > '9' { return false }
		v = v * 10 + cast(int, digits[i]) - 48 // the digit's value ('0' is 48)
	}
	return v >= lo && v <= hi
}
