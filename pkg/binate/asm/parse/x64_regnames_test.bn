package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The x86-64 register names clang reads, and constants so named (clang's bytes:
// `-target x86_64-linux-gnu` with `.intel_syntax noprefix`).  (newX64Parser is in
// x64_test.bn, lineEmitsHex / lineRejected in parse_test.bn.)

// Every register family clang knows is a register name, in any case; a name that only
// looks like one (`st0`, `r8l`, `r32`, `xmm32`, `k8`, `r08`) is not.
func TestX64RegisterNames() testing.TestResult {
	var e @[]char = ""
	var regs *[]readonly char =
	" rax RSP r8 r15d r31w R31B eax esp ax sp al AH bh ch dh sil dil bpl spl rip eip "
			"ip riz eiz cs ds es fs gs ss st mm0 mm7 xmm0 XMM31 ymm15 zmm31 k0 k7 tmm0 tmm7 cr0 "
			"cr15 dr0 dr15 "
	var nonRegs *[]readonly char = " st0 r8l r32 r7 xmm32 mm8 k8 tmm8 cr16 r08 rx foo ra "
	var start int = 1
	for i := 1; i < len(regs); i++ {
		if regs[i] != ' ' { continue }
		if !isX64RegisterName(regs[start:i]) { e = goldenFail(e, regs[start:i], "not a register") }
		start = i + 1
	}
	start = 1
	for i := 1; i < len(nonRegs); i++ {
		if nonRegs[i] != ' ' { continue }
		if isX64RegisterName(nonRegs[start:i]) { e = goldenFail(e, nonRegs[start:i], "a register") }
		start = i + 1
	}
	return e
}

// x64RegConstCase checks that line, after the definition def, assembles to the bytes hex.
func x64RegConstCase(e @[]char, def *[]readonly char, line *[]readonly char,
		hex *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine(def)
	var r testing.TestResult = lineEmitsHex(p, line, hex)
	if len(r) > 0 { return goldenFail(e, line, r) }
	return e
}

// x64RegConstReject checks that line, after the definition def, is rejected and emits
// nothing.
func x64RegConstReject(e @[]char, def *[]readonly char, line *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine(def)
	var r testing.TestResult = lineRejected(p, line)
	if len(r) > 0 { return goldenFail(e, line, r) }
	return e
}

// A constant named like a register clang knows is no number where an operand stands
// alone (clang reads the register: `ss = 16` then `mov rax, ss` moves the segment register,
// and `mov al, ah` moves ah), whether or not this parser encodes that register; a name
// clang does not read as a register (`st0`, `r8l`) is the constant.
func TestConstX64RegisterNames() testing.TestResult {
	var e @[]char = ""
	e = x64RegConstReject(e, "ss = 16", "mov rax, ss")
	e = x64RegConstReject(e, "cs = 8", "mov rax, cs")
	e = x64RegConstReject(e, "ah = 5", "mov al, ah")
	e = x64RegConstReject(e, "R16 = 3", "mov rax, R16")
	e = x64RegConstReject(e, "r31b = 3", "mov rax, r31b")
	e = x64RegConstReject(e, "xmm1 = 7", "mov rax, xmm1")
	e = x64RegConstReject(e, "rip = 9", "mov rax, rip")
	e = x64RegConstReject(e, "ch = 2", "mov rax, [rbx + ch]")
	e = x64RegConstCase(e, "st0 = 3", "mov rax, st0", "48 c7 c0 03 00 00 00")
	e = x64RegConstCase(e, "r8l = 4", "mov rax, r8l", "48 c7 c0 04 00 00 00")
	return e
}
