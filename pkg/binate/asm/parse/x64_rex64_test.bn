package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// rex64 before an instruction is its REX.W, as GNU as places it (`as` 2.42, Intel syntax): after
// the legacy and mandatory prefixes, merged into a REX prefix of the instruction's own; clang
// writes 48 where rex64 stands, which the CPU ignores before another REX or a mandatory prefix.
// Before prefixes alone, or alone, it is its 48 (two of them too).  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn, x64TlsCase in
// x64_tls_test.bn.)

func TestX64Rex64Placement() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "rex64 mov r9d, eax", "49 89 c1")
	e = x64SrcHex(e, "rex64 add r9d, 0x100", "49 81 c1 00 01 00 00")
	e = x64SrcHex(e, "rex64 fs mov eax, dword ptr [rbx]", "64 48 8b 03")
	e = x64SrcHex(e, "rex64 mov eax, dword ptr fs:[0]", "64 48 8b 04 25 00 00 00 00")
	e = x64SrcHex(e, "rex64 data16 mov eax, ebx", "66 48 89 d8")
	e = x64SrcHex(e, "data16 rex64 ret", "66 48 c3")
	e = x64SrcHex(e, "rex64 lock add dword ptr [rax], eax", "f0 48 01 00")
	e = x64SrcHex(e, "rex64 {rex} mov eax, ebx", "48 89 d8")
	e = x64SrcHex(e, "rex64", "48")
	e = x64SrcHex(e, "rex64 fs", "48 64")
	e = x64SrcHex(e, "rex64 rex64", "48 48")
	e = x64SrcHex(e, "data16 rex64 rex64", "66 48 48")
	e = x64SrcHex(e, "rex64 nop", "48 90")
	e = x64SrcHex(e, "rex64 push rax", "48 50")
	e = x64SrcHex(e, "rex64 xchg eax, ebx", "48 93")
	e = x64SrcHex(e, "rex64 movsd", "48 a5")
	e = x64SrcHex(e, "rex64 in al, dx", "48 ec")
	e = x64SrcHex(e, "rex64 bswap eax", "48 0f c8")
	e = x64SrcHex(e, "rex64 movzx eax, bl", "48 0f b6 c3")
	e = x64SrcHex(e, "rex64 cmpxchg dword ptr [rax], ebx", "48 0f b1 18")
	return e
}

// rex64 before SSE / MMX instructions (after the mandatory prefix), x87 (the waiting forms' REX
// after their FWAIT), and the immediates REX.W leaves as they are.
func TestX64Rex64Forms() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "rex64 addps xmm9, xmm1", "4c 0f 58 c9")
	e = x64SrcHex(e, "rex64 movd xmm0, eax", "66 48 0f 6e c0")
	e = x64SrcHex(e, "rex64 pextrw eax, xmm0, 1", "66 48 0f c5 c0 01")
	e = x64SrcHex(e, "rex64 emms", "48 0f 77")
	e = x64SrcHex(e, "rex64 fld dword ptr [rax]", "48 d9 00")
	e = x64SrcHex(e, "rex64 fstcw word ptr [rax]", "9b 48 d9 38")
	e = x64SrcHex(e, "rex64 fwait", "48 9b")
	e = x64SrcHex(e, "rex64 finit", "9b 48 db e3")
	e = x64SrcHex(e, "rex64 fstsw ax", "9b 48 df e0")
	e = x64SrcHex(e, "rex64 add eax, 1", "48 83 c0 01")
	e = x64SrcHex(e, "rex64 add ax, 1", "66 48 83 c0 01")
	e = x64SrcHex(e, "rex64 test eax, 1", "48 a9 01 00 00 00")
	e = x64SrcHex(e, "rex64 imul eax, ebx, 1000", "48 69 c3 e8 03 00 00")
	e = x64SrcHex(e, "rex64 mov dword ptr [rax], 1", "48 c7 00 01 00 00 00")
	e = x64SrcHex(e, "rex64 mov al, 1", "48 b0 01")
	e = x64SrcHex(e, "rex64 push 0x1234", "48 68 34 12 00 00")
	e = x64SrcHex(e, "rex64 ret 8", "48 c2 08 00")
	e = x64SrcHex(e, "rex64 enter 8, 0", "48 c8 08 00 00")
	var rrx int = x64.FIX_REX_GOTPCRELX
	e = x64TlsCase(e, "rex64 mov eax, dword ptr [rip + x@GOTPCREL]", "48 8b 05 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "rex64 add eax, dword ptr [rip + x@GOTPCREL]", "48 03 05 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "rex64 test dword ptr [rip + x@GOTPCREL], eax", "48 85 05 00 00 00 00", rrx, 3,
			0)
	e = x64TlsCase(e, "rex64 call qword ptr [rip + x@GOTPCREL]", "48 ff 15 00 00 00 00", rrx, 3, 0)
	e = x64TlsCase(e, "rex64 jmp qword ptr [rip + x@GOTPCREL]", "48 ff 25 00 00 00 00", rrx, 3, 0)
	// The general-dynamic TLS sequence's call (to __tls_get_addr; x64TlsCase's symbol is x), and its
	// prefixes written in the other order.
	e = x64TlsCase(e, "data16 data16 rex64 call x@PLT", "66 66 48 e8 00 00 00 00", x64.FIX_REL32, 4, 0)
	e = x64TlsCase(e, "rex64 data16 data16 call x@PLT", "66 66 48 e8 00 00 00 00", x64.FIX_REL32, 4, 0)
	return e
}

// What GNU as rejects: rex64 before an instruction with a REX.W of its own, two rex64 prefixes,
// rex64 before a VEX instruction; and, past GNU as and clang (which emit the bytes, which the CPU
// reads as a longer instruction), rex64 before an immediate REX.W widens — MOV's B8+r one, a
// 16-bit one.
func TestX64Rex64Rejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineErrorHas(e, "rex64 mov rax, rbx", "rex64 before an instruction with a REX.W of its own")
	e = x64LineErrorHas(e, "rex64 cvtsi2sd xmm0, rax", "a REX.W of its own")
	e = x64LineErrorHas(e, "rex64 mov qword ptr [rax], 1", "a REX.W of its own")
	e = x64LineErrorHas(e, "rex64 rex64 mov eax, ebx", "an instruction takes one rex64 prefix")
	e = x64LineErrorHas(e, "rex64 fs rex64 mov eax, ebx", "an instruction takes one rex64 prefix")
	e = x64LineErrorHas(e, "rex64 andn eax, ebx, ecx", "takes no REX prefix")
	e = x64LineErrorHas(e, "rex64 mov eax, 1", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 mov r9d, 0x12345678", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 mov ax, 1", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 add ax, 0x1234", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 add cx, 0x1234", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 test ax, 1", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 test word ptr [rax], 1", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 mov word ptr [rax], 1", "would widen its immediate")
	e = x64LineErrorHas(e, "rex64 imul ax, bx, 1000", "would widen its immediate")
	return e
}
