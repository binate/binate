package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"

// x86-64 segment overrides and the prefixes written as instructions, as clang takes them: a
// memory operand's `seg:` (es, cs, ss, ds, fs, gs; after the operand's size, before its
// brackets: `dword ptr fs:[rbx]`), or `seg:` and a displacement, with brackets after it or none
// (`fs:8[rbx]`, `qword ptr fs:0`, `fs:x@TPOFF`, GCC's spelling; x64_disp.bn), its prefix emitted
// before the instruction's own (x64.SegPrefix);
// and `data16`, `rex64`, `lock` (x64_lock.bn), `xacquire`, `xrelease` and the six segment names as
// instructions of their own, alone or before another on the line (`data16 data16 rex64 call
// __tls_get_addr@PLT`, `lock add [rbx], eax`), each its one byte.  A GOT
// slot or a thread-local slot or descriptor (`[rip + x@GOTTPOFF]`, `[rax + x@tlscall]`) takes
// no segment override: the load would read another address.

// x64SegOf returns the segment override prefix (x64.SEG_*) name names, or 0 for none.
func x64SegOf(name *[]readonly char) int {
	if mnemIs(name, "es") { return x64.SEG_ES }
	if mnemIs(name, "cs") { return x64.SEG_CS }
	if mnemIs(name, "ss") { return x64.SEG_SS }
	if mnemIs(name, "ds") { return x64.SEG_DS }
	if mnemIs(name, "fs") { return x64.SEG_FS }
	if mnemIs(name, "gs") { return x64.SEG_GS }
	return 0
}

// x64PrefixName reports whether name names a prefix written as an instruction: `data16`, `rex64`,
// `lock`, `xacquire`, `xrelease` or a segment name.
func x64PrefixName(name *[]readonly char) bool {
	return x64SegOf(name) != 0 || mnemIs(name, "data16") || mnemIs(name, "rex64") ||
			mnemIs(name, "lock") || mnemIs(name, "xacquire") || mnemIs(name, "xrelease")
}

// x64PrefixInstruction assembles mnemTok (l just after it) when it names a prefix written as
// an instruction (x64PrefixName), then the instruction after it on the line, if any, and reports
// whether it did.  The instruction after a `lock` comes straight after it, as clang reads it
// (`lock fs add ...` is an error; `fs lock add ...` is not), but for one prefix alone after it,
// which clang takes as the instruction: `lock fs` is F0 64.
func x64PrefixInstruction(p @Parser, l Lexer, mnemTok Token) bool {
	// bnlint:allow managed-to-raw-assign - mnemTok is a live token; Text outlives the read
	var mnem *[]readonly char = mnemTok.Text
	if !x64PrefixName(mnem) { return false }
	var seg int = x64SegOf(mnem)
	var lock bool = mnemIs(mnem, "lock")
	var tok Token
	l, tok = LexNext(l)
	if tok.Kind != TOK_EOF && tok.Kind != TOK_IDENT {
		setErr(p, "a prefix is followed by an instruction or ends the line")
		return true
	}
	if lock && p.X64Lock {
		setErr(p, "an instruction takes one lock prefix")
		return true
	}
	if lock && tok.Kind == TOK_IDENT && x64PrefixName(tok.Text) && !mnemIs(tok.Text, "lock") {
		var after Token
		_, after = LexNext(l)
		if after.Kind != TOK_EOF {
			setErr(p, "lock is followed by the instruction it locks, not another prefix")
			return true
		}
		x64.Lock(p.Asm)
		parseX64Instruction(p, l, tok)
		return true
	}
	if seg != 0 {
		x64.SegPrefix(p.Asm, seg)
	} else if mnemIs(mnem, "data16") {
		x64.Data16(p.Asm)
	} else if mnemIs(mnem, "rex64") {
		x64.Rex64(p.Asm)
	} else if lock {
		// With an instruction after it, the instruction emits the 0xF0 (x64EmitSeg).
		if tok.Kind == TOK_EOF {
			x64.Lock(p.Asm)
		} else {
			p.X64Lock = true
		}
	} else if mnemIs(mnem, "xacquire") {
		x64.Xacquire(p.Asm)
	} else {
		x64.Xrelease(p.Asm)
	}
	if tok.Kind == TOK_IDENT { parseX64Instruction(p, l, tok) }
	return true
}

// x64SegStart reports whether tok (l just after it) begins a segment override: a segment's name
// and ':'.
func x64SegStart(l Lexer, tok Token) bool {
	if tok.Kind != TOK_IDENT || x64SegOf(tok.Text) == 0 { return false }
	var colon Token
	l, colon = LexNext(l)
	return colon.Kind == TOK_COLON
}

// parseX64SegOperand parses a memory operand with a segment override at tok (x64SegStart; l just
// after it) for an access of size bits (0: not written): `seg:[...]` or `seg:` and a
// displacement (x64_disp.bn).  It records the prefix (Parser.X64Seg), one per instruction.
func parseX64SegOperand(p @Parser, l Lexer, tok Token, size int) (Lexer, Token, x64.Operand) {
	if p.X64Seg != 0 {
		setErr(p, "an instruction takes one segment override")
		return l, tok, x64.Imm(0)
	}
	p.X64Seg = x64SegOf(tok.Text)
	l, tok = LexNext(l) // ':'
	l, tok = LexNext(l)
	var op x64.Operand
	if tok.Kind == TOK_LBRACKET {
		l, tok, op = parseX64MemOperand(p, l, size)
	} else {
		l, tok, op = parseX64ExprOperand(p, l, tok, size, x64ExprSeg)
	}
	if p.HasError { return l, tok, x64.Imm(0) }
	if op.Kind == x64.OP_RIPGOTLABEL || op.Kind == x64.OP_RIPTLVP ||
			(op.Kind == x64.OP_RIPLABEL && op.Fix != 0) ||
			(op.Kind == x64.OP_MEM && op.Fix == x64.FIX_TLSCALL) {
		setErr(p,
				"a GOT slot or thread-local slot or descriptor reference takes no segment override "
						"(the load would read another address)")
		return l, tok, x64.Imm(0)
	}
	return l, tok, op
}

// x64EmitSeg emits the segment override prefix the instruction's operands wrote (Parser.X64Seg),
// if any, before the instruction, and has the instruction take the lock prefix its line wrote
// before it (Parser.X64Lock), if any, after any 0x66 (x64.LockNext) — clang's order (`lock add
// word ptr fs:[rbx], ax` is 64 66 F0 01 03).
func x64EmitSeg(p @Parser) {
	if p.X64Seg != 0 { x64.SegPrefix(p.Asm, p.X64Seg) }
	if p.X64Lock { x64.LockNext(p.Asm) }
}
