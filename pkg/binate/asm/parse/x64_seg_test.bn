package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// Segment overrides and the prefixes written as instructions (x64_seg.bn) against clang's
// bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`).  (x64SrcHex and
// x64LineRejected are in x64_target_test.bn.)

// A memory operand's segment override is its prefix, first: after the operand's size or with
// none, any of the six names in any case, before brackets or a bare displacement.
func TestX64SegOverrides() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mov eax, dword ptr fs:[rbx + 8]", "64 8b 43 08")
	e = x64SrcHex(e, "mov eax, dword ptr gs:[rbx]", "65 8b 03")
	e = x64SrcHex(e, "mov dword ptr fs:[rbx], 5", "64 c7 03 05 00 00 00")
	e = x64SrcHex(e, "mov ax, word ptr fs:[rbx]", "64 66 8b 03")
	e = x64SrcHex(e, "mov r8w, word ptr fs:[r9]", "64 66 45 8b 01")
	e = x64SrcHex(e, "mov eax, fs:[rbx]", "64 8b 03")
	e = x64SrcHex(e, "mov rax, qword ptr fs:0", "64 48 8b 04 25 00 00 00 00")
	e = x64SrcHex(e, "mov rax, qword ptr fs:[0]", "64 48 8b 04 25 00 00 00 00")
	e = x64SrcHex(e, "mov rax, qword ptr gs:[0x60]", "65 48 8b 04 25 60 00 00 00")
	e = x64SrcHex(e, "add rax, qword ptr fs:[0]", "64 48 03 04 25 00 00 00 00")
	e = x64SrcHex(e, "mov eax, dword ptr es:[rbx]", "26 8b 03")
	e = x64SrcHex(e, "mov eax, dword ptr cs:[rbx]", "2e 8b 03")
	e = x64SrcHex(e, "mov eax, dword ptr ss:[rbx]", "36 8b 03")
	e = x64SrcHex(e, "mov eax, dword ptr ds:[rbx]", "3e 8b 03")
	e = x64SrcHex(e, "mov eax, dword ptr FS:[rbx]", "64 8b 03")
	e = x64SrcHex(e, "mov eax, dword ptr fs : [rbx]", "64 8b 03")
	e = x64SrcHex(e, "push qword ptr fs:[rbx]", "64 ff 33")
	e = x64SrcHex(e, "lea rax, fs:[rbx]", "64 48 8d 03")
	e = x64SrcHex(e, "inc dword ptr fs:[rbx]", "64 ff 03")
	e = x64SrcHex(e, "imul eax, dword ptr fs:[rbx], 5", "64 6b 03 05")
	e = x64SrcHex(e, "shl dword ptr fs:[rbx], 1", "64 d1 23")
	e = x64SrcHex(e, "test dword ptr fs:[rbx], eax", "64 85 03")
	e = x64SrcHex(e, "mov dword ptr fs:8, eax", "64 89 04 25 08 00 00 00")
	// The override is one instruction's: the next line has none.
	e = x64SrcHex(e, "mov eax, dword ptr fs:[rbx]\nmov eax, dword ptr [rbx]", "64 8b 03 8b 03")
	return e
}

// `data16`, `rex64` and a segment's name are instructions of their own, alone or before another
// on the line (another prefix included), each its one byte as written.
func TestX64PrefixInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "fs", "64")
	e = x64SrcHex(e, "gs nop", "65 90")
	e = x64SrcHex(e, "fs fs mov eax, dword ptr [rbx]", "64 64 8b 03")
	e = x64SrcHex(e, "fs mov eax, dword ptr gs:[rbx]", "64 65 8b 03")
	e = x64SrcHex(e, "data16", "66")
	e = x64SrcHex(e, "rex64", "48")
	e = x64SrcHex(e, "rex64 mov rax, rbx", "48 48 89 d8")
	e = x64SrcHex(e, "data16 mov ax, bx", "66 66 89 d8")
	e = x64SrcHex(e, "data16 mov eax, dword ptr fs:[rbx]", "66 64 8b 03")
	e = x64SrcHex(e, "DATA16 REX64 ret", "66 48 c3")
	return e
}

// x64LineFails checks that line is an error.  (A prefix written as an instruction is emitted
// before the instruction after it is read, as a statement of its own.)
func x64LineFails(e @[]char, line *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine(line)
	if !p.HasError && !p.Asm.HasError { return goldenFail(e, line, "accepted") }
	return e
}

// A segment override is an error where clang takes none — two, one inside the brackets, one
// before the size, one on a register — and so is a bare operand other than a displacement (a
// register, nothing), a prefix followed by anything but an instruction, and a segment override
// on a GOT slot or a thread-local slot, however written.
func TestX64SegRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "mov eax, dword ptr fs:gs:[rbx]")
	e = x64LineRejected(e, "mov eax, dword ptr [fs:rbx]")
	e = x64LineRejected(e, "mov eax, fs:dword ptr [rbx]")
	e = x64LineRejected(e, "mov eax, fs:ebx")
	e = x64LineRejected(e, "mov eax, dword ptr fs:rbx")
	e = x64LineRejected(e, "mov eax, dword ptr fs:")
	e = x64LineRejected(e, "mov eax, dword ptr fs:[rbx] + 4")
	e = x64LineRejected(e, "data16 ,")
	e = x64LineRejected(e, "fs 5")
	e = x64LineRejected(e, "mov rax, qword ptr fs:[rip + x@GOTTPOFF]")
	e = x64LineRejected(e, "lea rdi, gs:[rip + x@TLSGD]")
	e = x64LineRejected(e, "mov rax, fs:[rip + x@GOTPCREL]")
	e = x64LineRejected(e, "mov rax, fs:x@gottpoff[rip]")
	e = x64LineFails(e, "rex64 bogus")
	e = x64LineFails(e, "data16 fs:")
	return e
}
