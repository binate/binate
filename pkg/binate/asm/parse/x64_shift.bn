package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"

// The x86-64 shifts and rotates, as clang takes them: `rol` / `ror` / `rcl` / `rcr` / `shl` (and
// its other name `sal`) / `shr` / `sar` with a register or memory operand and a count — an imm8
// (-128..255) or `cl` — or no count for a count of 1 (`shl rax` is `shl rax, 1`); and `shld` /
// `shrd` with a register or memory operand, a register and a count, or no count for `cl`.

// x64ShiftExt returns the ModR/M extension of the shift or rotate mnem — rol 0, ror 1, rcl 2,
// rcr 3, shl and sal 4, shr 5, sar 7 — or -1 for another mnemonic.
func x64ShiftExt(mnem *[]readonly char) int {
	if mnemIs(mnem, "rol") { return 0 }
	if mnemIs(mnem, "ror") { return 1 }
	if mnemIs(mnem, "rcl") { return 2 }
	if mnemIs(mnem, "rcr") { return 3 }
	if mnemIs(mnem, "shl") || mnemIs(mnem, "sal") { return 4 }
	if mnemIs(mnem, "shr") { return 5 }
	if mnemIs(mnem, "sar") { return 7 }
	return -1
}

// x64IsShift reports whether mnem is a shift or rotate (x64ShiftExt), shld or shrd.
func x64IsShift(mnem *[]readonly char) bool {
	return x64ShiftExt(mnem) >= 0 || mnemIs(mnem, "shld") || mnemIs(mnem, "shrd")
}

// parseX64Shift finishes the shift or rotate mnem (x64IsShift) whose first operand dst has been
// parsed, tok the token after it (l just after it), and emits it.
func parseX64Shift(p @Parser, l Lexer, tok Token, mnem *[]readonly char, dst x64.Operand) {
	var double bool = mnemIs(mnem, "shld") || mnemIs(mnem, "shrd")
	var src x64.Operand = x64.Imm(0)
	if double {
		l, tok, src = expectX64CommaOp(p, l, tok)
		if p.HasError { return }
	}
	var count x64.Operand = x64.Imm(1)
	if double { count = x64.Reg(x64.RCX, x64.SZ8) }
	if tok.Kind == TOK_COMMA {
		l, tok = LexNext(l)
		l, tok, count = parseX64Operand(p, l, tok)
		if p.HasError { return }
	}
	if !x64AtEOL(p, tok) || !x64TlsCallOk(p, dst) || !x64TlsCallOk(p, src) || !x64TlsCallOk(p, count) {
		return
	}
	var sized bool = false
	if double {
		// The count is no size; the register beside the destination is.
		dst, src, sized = x64SizeTwo(p, mnem, dst, src)
	} else {
		dst, sized = x64SizeOne(p, mnem, dst)
	}
	if !sized { return }
	x64EmitSeg(p)
	var a @asm.Assembler = p.Asm
	if mnemIs(mnem, "shld") {
		x64.Shld(a, dst, src, count)
	} else if mnemIs(mnem, "shrd") {
		x64.Shrd(a, dst, src, count)
	} else {
		var ext int = x64ShiftExt(mnem)
		if ext == 0 { x64.Rol(a, dst, count) }
		if ext == 1 { x64.Ror(a, dst, count) }
		if ext == 2 { x64.Rcl(a, dst, count) }
		if ext == 3 { x64.Rcr(a, dst, count) }
		if ext == 4 { x64.Shl(a, dst, count) }
		if ext == 5 { x64.Shr(a, dst, count) }
		if ext == 7 { x64.Sar(a, dst, count) }
	}
}
