package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The shifts, rotates, mul and imul against clang's bytes (`clang --target=x86_64-linux-gnu -c`,
// `.intel_syntax noprefix`).  (x64SrcHex and x64LineRejected are in x64_target_test.bn,
// x64TlsCase in x64_tls_test.bn.)

// Each shift and rotate with a count of 1, an imm8 or cl, or no count (a count of 1); sal is
// shl; shld / shrd with an imm8 or cl, or no count (cl).
func TestX64Shifts() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "rol rax, 1", "48 d1 c0")
	e = x64SrcHex(e, "rol rax, 3", "48 c1 c0 03")
	e = x64SrcHex(e, "rol rax, cl", "48 d3 c0")
	e = x64SrcHex(e, "rol rax", "48 d1 c0")
	e = x64SrcHex(e, "ror eax, 1", "d1 c8")
	e = x64SrcHex(e, "rcl cx, 3", "66 c1 d1 03")
	e = x64SrcHex(e, "rcr bl, cl", "d2 db")
	e = x64SrcHex(e, "sal rax, 1", "48 d1 e0")
	e = x64SrcHex(e, "SAL rax, 3", "48 c1 e0 03")
	e = x64SrcHex(e, "shl rax", "48 d1 e0")
	e = x64SrcHex(e, "shr qword ptr [rbx], 1", "48 d1 2b")
	e = x64SrcHex(e, "sar dword ptr [rbx], cl", "d3 3b")
	e = x64SrcHex(e, "rol byte ptr [rbx], 7", "c0 03 07")
	e = x64SrcHex(e, "rol rax, 255", "48 c1 c0 ff")
	e = x64SrcHex(e, "rol rax, -1", "48 c1 c0 ff")
	e = x64SrcHex(e, "rol rax, 0", "48 c1 c0 00")
	e = x64SrcHex(e, "rol spl, 1", "40 d0 c4")
	e = x64SrcHex(e, "rol r8b, cl", "41 d2 c0")
	e = x64SrcHex(e, "shld rax, rbx, 3", "48 0f a4 d8 03")
	e = x64SrcHex(e, "shld rax, rbx, cl", "48 0f a5 d8")
	e = x64SrcHex(e, "shld [rbx], rax, 3", "48 0f a4 03 03")
	e = x64SrcHex(e, "shld ax, bx, 3", "66 0f a4 d8 03")
	e = x64SrcHex(e, "shld eax, ebx, cl", "0f a5 d8")
	e = x64SrcHex(e, "shld rax, rbx", "48 0f a5 d8")
	e = x64SrcHex(e, "shrd rax, rbx, 3", "48 0f ac d8 03")
	e = x64SrcHex(e, "shrd rax, rbx, cl", "48 0f ad d8")
	e = x64SrcHex(e, "shrd qword ptr [rbx], rcx, 1", "48 0f ac 0b 01")
	return e
}

// A count past an imm8 or in another register, a symbol as a count, no size for memory, an
// 8-bit shld, and missing operands are errors, as in clang.
func TestX64ShiftRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "rol rax, 256")
	e = x64LineRejected(e, "rol rax, al")
	e = x64LineRejected(e, "rol rax, ecx")
	e = x64LineRejected(e, "shl rax, cx")
	e = x64LineRejected(e, "rol rax, offset x")
	e = x64LineRejected(e, "rol rax, x")
	e = x64LineRejected(e, "rol [rbx], 1")
	e = x64LineRejected(e, "rcr [rbx]")
	e = x64LineRejected(e, "shld al, bl, 3")
	e = x64LineRejected(e, "shld rax")
	e = x64LineRejected(e, "shld rax, 3")
	e = x64LineRejected(e, "rol rax, 1, 2")
	return e
}

// mul and the one-operand imul (F6 / F7 /4, /5); `imul r, imm` is `imul r, r, imm` (6B with an
// imm8, 69 past it or with a symbol), as clang reads it.
func TestX64MulImul() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "mul rcx", "48 f7 e1")
	e = x64SrcHex(e, "mul byte ptr [rbx]", "f6 23")
	e = x64SrcHex(e, "mul cl", "f6 e1")
	e = x64SrcHex(e, "imul rcx", "48 f7 e9")
	e = x64SrcHex(e, "imul byte ptr [rbx]", "f6 2b")
	e = x64SrcHex(e, "imul ax, bx", "66 0f af c3")
	e = x64SrcHex(e, "imul rax, 5", "48 6b c0 05")
	e = x64SrcHex(e, "imul rax, 300", "48 69 c0 2c 01 00 00")
	e = x64SrcHex(e, "imul eax, -1", "6b c0 ff")
	e = x64SrcHex(e, "imul ax, 300", "66 69 c0 2c 01")
	e = x64SrcHex(e, "imul rax, rbx, 5", "48 6b c3 05")
	e = x64SrcHex(e, "imul rax, [rbx], 300", "48 69 03 2c 01 00 00")
	e = x64TlsCase(e, "imul rax, offset x", "48 69 c0 00 00 00 00", x64.FIX_ABS32S, 3, 0)
	e = x64SrcHex(e, "imul rax ; nop", "48 f7 e8 90")
	e = x64SrcHex(e, "mul ecx // the comment", "f7 e1")
	e = x64LineRejected(e, "imul rax junk")
	e = x64LineRejected(e, "imul al, 5")
	e = x64LineRejected(e, "mul [rbx]")
	e = x64LineRejected(e, "mul rax, rbx")
	return e
}
