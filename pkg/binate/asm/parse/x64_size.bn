package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/buf"

// x86-64 operand sizes in the text parser, as clang reads Intel syntax: a memory operand written
// without `byte` / `word` / `dword` / `qword ptr` has no size (0) until its instruction gives it
// one — the register operand's, or 64 bits for PUSH / POP; LEA's is an address, whose size is
// not read.  An instruction with no register to take the size from (an immediate, a shift count,
// or no other operand) is ambiguous, an error (clang: "ambiguous operand size").

// x64Unsized reports whether op is a memory operand, RIP-relative ones included, written without
// a size.
func x64Unsized(op x64.Operand) bool { return x64IsMemory(op) && op.Size == 0 }

// x64IsMemory reports whether op is a memory operand, RIP-relative ones included.
func x64IsMemory(op x64.Operand) bool { return op.Kind == x64.OP_MEM || op.Kind == x64.OP_RIPLABEL }

// x64AmbiguousSize sets the error for mnem's operand that has no size.
func x64AmbiguousSize(p @Parser, mnem *[]readonly char) {
	var msg @[]char = buf.Concat("ambiguous operand size for '", mnem)
	setErr(p, buf.Concat(msg, "' (write byte, word, dword or qword ptr)"))
}

// x64SizeOne gives the operand of the one-operand mnem its size when it has none: 64 bits for
// PUSH / POP; any other is ambiguous.  Reports whether the operand is sized.
func x64SizeOne(p @Parser, mnem *[]readonly char, op x64.Operand) (x64.Operand, bool) {
	if !x64Unsized(op) { return op, true }
	if mnemIs(mnem, "push") || mnemIs(mnem, "pop") {
		op.Size = x64.SZ64
		return op, true
	}
	x64AmbiguousSize(p, mnem)
	return op, false
}

// x64SizeTwo gives an unsized memory operand of the two-operand mnem the size of its register
// operand — but a shift's count, which is no size — or, for LEA, any size; reports whether both
// operands are then sized.  Two memory operands are left for the instruction to reject (no
// instruction here takes two), rather than reported as a size problem.
func x64SizeTwo(p @Parser, mnem *[]readonly char, dst x64.Operand,
		src x64.Operand) (x64.Operand, x64.Operand, bool) {
	if mnemIs(mnem, "lea") {
		if x64Unsized(src) { src.Size = x64.SZ64 }
		return dst, src, true
	}
	if x64IsMemory(dst) && x64IsMemory(src) { return dst, src, true }
	var shift bool = mnemIs(mnem, "shl") || mnemIs(mnem, "shr") || mnemIs(mnem, "sar")
	if x64Unsized(dst) && src.Kind == x64.OP_REG && !shift {
		dst.Size = src.Size
	} else if x64Unsized(src) && dst.Kind == x64.OP_REG {
		src.Size = dst.Size
	}
	if x64Unsized(dst) || x64Unsized(src) {
		x64AmbiguousSize(p, mnem)
		return dst, src, false
	}
	return dst, src, true
}
