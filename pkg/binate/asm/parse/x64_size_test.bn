package "pkg/binate/asm/parse"

import "pkg/binate/buf"
import "pkg/builtins/testing"
import "pkg/std/strings"

// x86-64 operand sizes (x64_size.bn) against clang's bytes (`clang -c -target x86_64-linux-gnu`,
// Intel syntax).  (newX64Parser is in x64_test.bn.)

// x64Hex returns the bytes of p's first section as lowercase hex pairs, space separated.
func x64Hex(p @Parser) @[]char {
	var b @strings.Builder = strings.NewBuilder()
	var digits *[]readonly char = "0123456789abcdef"
	for i := 0; i < p.Asm.Sections[0].Len; i++ {
		var v int = cast(int, p.Asm.Sections[0].Data[i])
		if i > 0 { b.WriteByte(' ') }
		b.WriteByte(digits[v >> 4])
		b.WriteByte(digits[v & 15])
	}
	return buf.CopyStr(b.String())
}

// x64SizeCase appends to e a failure unless line assembles to clang's bytes want.
func x64SizeCase(e @[]char, line *[]readonly char, want *[]readonly char) @[]char {
	p, _ := newX64Parser()
	p.ParseLine(line)
	if p.HasError { return buf.Concat(e, buf.Concat(buf.Concat(line, ": rejected: "), p.ErrorMsg)) }
	var got @[]char = x64Hex(p)
	if charsEqual(got, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(line, ": assembled to "), buf.Concat(got, "; ")))
}

// An unsized memory operand takes the register operand's size — a 4-, 1-, 2- or 8-byte store or
// load, TEST, CMP, ADD and IMUL alike — PUSH / POP's is 64-bit, and LEA's is not read.
func TestX64UnsizedMemoryTakesRegisterSize() testing.TestResult {
	var e @[]char = ""
	e = x64SizeCase(e, "mov [rax], ecx", "89 08")
	e = x64SizeCase(e, "mov ecx, [rax]", "8b 08")
	e = x64SizeCase(e, "mov [rax], cl", "88 08")
	e = x64SizeCase(e, "mov [rax], ax", "66 89 00")
	e = x64SizeCase(e, "mov [rbx + 8], r9", "4c 89 4b 08")
	e = x64SizeCase(e, "test [rax], ecx", "85 08")
	e = x64SizeCase(e, "cmp ecx, [rax]", "3b 08")
	e = x64SizeCase(e, "add [rax], edx", "01 10")
	e = x64SizeCase(e, "imul eax, [rax]", "0f af 00")
	e = x64SizeCase(e, "imul eax, [rax], 5", "6b 00 05")
	e = x64SizeCase(e, "push [rax]", "ff 30")
	e = x64SizeCase(e, "pop [rax]", "8f 00")
	e = x64SizeCase(e, "lea rax, [rbx]", "48 8d 03")
	e = x64SizeCase(e, "lea eax, byte ptr [rbx]", "8d 03")
	e = x64SizeCase(e, "sub byte ptr [rax], cl", "28 08")
	e = x64SizeCase(e, "inc dword ptr [rax]", "ff 00")
	e = x64SizeCase(e, "shl word ptr [rax], cl", "66 d3 20")
	return e
}

// x64RejectCase appends to e a failure unless line is rejected with a message holding want.
func x64RejectCase(e @[]char, line *[]readonly char, want *[]readonly char) @[]char {
	p, a := newX64Parser()
	p.ParseLine(line)
	var msg @[]char = p.ErrorMsg
	if !p.HasError { msg = a.ErrorMsg }
	if (p.HasError || a.HasError) && plContains(msg, want) { return e }
	return buf.Concat(e, buf.Concat(buf.Concat(line, ": "), buf.Concat(msg, "; ")))
}

// What clang rejects: an unsized memory operand with no register to size it — an immediate,
// a shift count, no other operand, RIP-relative ones too (clang: "ambiguous operand size") —
// and register / memory operands of different sizes, RIP-relative and GOT-indirect ones included
// (clang: "invalid operand").  A mnemonic the parser does not know is unknown, whatever its
// operands' sizes.
func TestX64OperandSizeRejects() testing.TestResult {
	var e @[]char = ""
	var ambiguous @[]@[]char = @[]@[]char{"add [rax], 1", "mov [rax], 1", "inc [rax]", "shl [rax], 1",
			"shl [rax], cl", "cmp [rax], 5", "neg [rax]", "test [rax], 1", "mov [rip + x], 5",
			"add [rip + x], 1"}
	for i := 0; i < len(ambiguous); i++ {
		e = x64RejectCase(e, ambiguous[i], "ambiguous operand size")
	}
	var differ @[]@[]char = @[]@[]char{"mov qword ptr [rax], ecx", "mov ecx, qword ptr [rax]",
			"mov rax, ecx", "add rax, ecx", "test eax, rcx", "imul eax, qword ptr [rax]", "imul eax, rcx, 5",
			"mov rax, dword ptr [rip + x]", "mov dword ptr [rip + x], rax",
			"mov rax, dword ptr [rip + x@GOTPCREL]"}
	for i := 0; i < len(differ); i++ { e = x64RejectCase(e, differ[i], "operand sizes differ") }
	e = x64RejectCase(e, "adc [rax], 1", "unknown instruction")
	e = x64RejectCase(e, "bt [rax], 3", "unknown instruction")
	return e
}
