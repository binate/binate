package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/sse"

// The SSE instructions (pkg/binate/asm/x64/sse's instruction table), as clang takes them in Intel
// syntax: a mnemonic the table has, with up to three operands — XMM registers xmm0..xmm15,
// general registers, memory, an immediate.  movsd and cmpsd are the table's with an XMM register
// among their operands, else the string instructions (x64_str.bn).  The table's encoder checks
// the operands.  A lock or repeat prefix cannot stand before one (as GNU as says; clang takes
// them, and reads rep addps as addss).

// x64XmmIndex returns i of the register name xmm<i> (in any case, i 0..15 with no leading zero),
// or -1.
func x64XmmIndex(name *[]readonly char) int {
	if len(name) < 4 || len(name) > 5 || !mnemIs(name[0:3], "xmm") { return -1 }
	var v int = 0
	for i := 3; i < len(name); i++ {
		if name[i] < '0' || name[i] > '9' { return -1 }
		v = v * 10 + cast(int, name[i]) - cast(int, '0')
	}
	if len(name) == 5 && name[3] == '0' { return -1 }
	if v > 15 { return -1 }
	return v
}

// x64XmmOnLine reports whether a token from l to the end of the line names an XMM register.
func x64XmmOnLine(l Lexer) bool {
	var t Token
	l, t = LexNext(l)
	for t.Kind != TOK_EOF {
		if t.Kind == TOK_IDENT && x64XmmIndex(t.Text) >= 0 { return true }
		l, t = LexNext(l)
	}
	return false
}

// x64SseInstruction parses and emits the SSE instruction mnem (l just after it) when the table has
// it, and reports whether it did.
func x64SseInstruction(p @Parser, l Lexer, mnem *[]readonly char) bool {
	if !sse.Has(mnem) { return false }
	var tok Token
	l, tok = LexNext(l)
	var op1 x64.Operand = x64.Imm(0)
	var op2 x64.Operand = x64.Imm(0)
	var op3 x64.Operand = x64.Imm(0)
	var n int = 0
	for tok.Kind != TOK_EOF && n < 3 {
		if n > 0 {
			if tok.Kind != TOK_COMMA {
				setErr(p, "expected ','")
				return true
			}
			l, tok = LexNext(l)
		}
		var op x64.Operand
		l, tok, op = parseX64Operand(p, l, tok)
		if p.HasError || !x64TlsCallOk(p, op) { return true }
		if n == 0 { op1 = op }
		if n == 1 { op2 = op }
		if n == 2 { op3 = op }
		n++
	}
	if !x64AtEOL(p, tok) { return true }
	x64EmitSeg(p)
	_ = sse.Emit(p.Asm, mnem, n, op1, op2, op3)
	return true
}
