package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The SSE3, SSSE3, SSE4.1 and SSE4.2 instructions (x64_sse.bn, the table's SSE3 .. SSE4.2 part)
// against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): each
// name and operand shape clang takes, with registers 8..15 and mm7 where the shape has a register;
// the encodings in full are package sse's tests.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// SSE3's and SSSE3's operations, and SSE4's on XMM registers alone, with XMM and MMX registers and
// every memory form of a few.
func TestX64Sse4Operations() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "addsubpd xmm1, xmm9", "66 41 0f d0 c9")
	e = x64SrcHex(e, "addsubpd xmm9, [rax]", "66 44 0f d0 08")
	e = x64SrcHex(e, "addsubpd xmm1, xmmword ptr [r10]", "66 41 0f d0 0a")
	e = x64SrcHex(e, "addsubps xmm1, xmm9", "f2 41 0f d0 c9")
	e = x64SrcHex(e, "haddpd xmm1, xmm9", "66 41 0f 7c c9")
	e = x64SrcHex(e, "haddps xmm1, xmm9", "f2 41 0f 7c c9")
	e = x64SrcHex(e, "hsubpd xmm1, xmm9", "66 41 0f 7d c9")
	e = x64SrcHex(e, "hsubps xmm1, xmm9", "f2 41 0f 7d c9")
	e = x64SrcHex(e, "movshdup xmm1, xmm9", "f3 41 0f 16 c9")
	e = x64SrcHex(e, "movsldup xmm1, xmm9", "f3 41 0f 12 c9")
	e = x64SrcHex(e, "pabsb xmm1, xmm9", "66 41 0f 38 1c c9")
	e = x64SrcHex(e, "pabsb mm0, mm7", "0f 38 1c c7")
	e = x64SrcHex(e, "pabsw xmm1, xmm9", "66 41 0f 38 1d c9")
	e = x64SrcHex(e, "pabsw mm0, mm7", "0f 38 1d c7")
	e = x64SrcHex(e, "pabsd xmm1, xmm9", "66 41 0f 38 1e c9")
	e = x64SrcHex(e, "pabsd mm0, mm7", "0f 38 1e c7")
	e = x64SrcHex(e, "phaddw xmm1, xmm9", "66 41 0f 38 01 c9")
	e = x64SrcHex(e, "phaddw mm0, mm7", "0f 38 01 c7")
	e = x64SrcHex(e, "phaddd xmm1, xmm9", "66 41 0f 38 02 c9")
	e = x64SrcHex(e, "phaddd mm0, mm7", "0f 38 02 c7")
	e = x64SrcHex(e, "phaddsw xmm1, xmm9", "66 41 0f 38 03 c9")
	e = x64SrcHex(e, "phaddsw mm0, mm7", "0f 38 03 c7")
	e = x64SrcHex(e, "phsubw xmm1, xmm9", "66 41 0f 38 05 c9")
	e = x64SrcHex(e, "phsubw mm0, mm7", "0f 38 05 c7")
	e = x64SrcHex(e, "phsubd xmm1, xmm9", "66 41 0f 38 06 c9")
	e = x64SrcHex(e, "phsubd mm0, mm7", "0f 38 06 c7")
	e = x64SrcHex(e, "phsubsw xmm1, xmm9", "66 41 0f 38 07 c9")
	e = x64SrcHex(e, "phsubsw mm0, mm7", "0f 38 07 c7")
	e = x64SrcHex(e, "pmaddubsw xmm1, xmm9", "66 41 0f 38 04 c9")
	e = x64SrcHex(e, "pmaddubsw mm0, mm7", "0f 38 04 c7")
	e = x64SrcHex(e, "pmulhrsw xmm1, xmm9", "66 41 0f 38 0b c9")
	e = x64SrcHex(e, "pmulhrsw mm0, mm7", "0f 38 0b c7")
	e = x64SrcHex(e, "pshufb xmm1, xmm9", "66 41 0f 38 00 c9")
	e = x64SrcHex(e, "pshufb xmm9, [rax]", "66 44 0f 38 00 08")
	e = x64SrcHex(e, "pshufb xmm1, xmmword ptr [r10]", "66 41 0f 38 00 0a")
	e = x64SrcHex(e, "pshufb mm0, mm7", "0f 38 00 c7")
	e = x64SrcHex(e, "pshufb mm7, [rax]", "0f 38 00 38")
	e = x64SrcHex(e, "pshufb mm7, qword ptr [rax]", "0f 38 00 38")
	e = x64SrcHex(e, "pshufb mm7, mmword ptr [rax]", "0f 38 00 38")
	e = x64SrcHex(e, "psignb xmm1, xmm9", "66 41 0f 38 08 c9")
	e = x64SrcHex(e, "psignb mm0, mm7", "0f 38 08 c7")
	e = x64SrcHex(e, "psignw xmm1, xmm9", "66 41 0f 38 09 c9")
	e = x64SrcHex(e, "psignw mm0, mm7", "0f 38 09 c7")
	e = x64SrcHex(e, "psignd xmm1, xmm9", "66 41 0f 38 0a c9")
	e = x64SrcHex(e, "psignd mm0, mm7", "0f 38 0a c7")
	e = x64SrcHex(e, "packusdw xmm1, xmm9", "66 41 0f 38 2b c9")
	e = x64SrcHex(e, "pcmpeqq xmm1, xmm9", "66 41 0f 38 29 c9")
	e = x64SrcHex(e, "phminposuw xmm1, xmm9", "66 41 0f 38 41 c9")
	e = x64SrcHex(e, "pmaxsb xmm1, xmm9", "66 41 0f 38 3c c9")
	e = x64SrcHex(e, "pmaxsd xmm1, xmm9", "66 41 0f 38 3d c9")
	e = x64SrcHex(e, "pmaxud xmm1, xmm9", "66 41 0f 38 3f c9")
	e = x64SrcHex(e, "pmaxuw xmm1, xmm9", "66 41 0f 38 3e c9")
	e = x64SrcHex(e, "pminsb xmm1, xmm9", "66 41 0f 38 38 c9")
	e = x64SrcHex(e, "pminsd xmm1, xmm9", "66 41 0f 38 39 c9")
	e = x64SrcHex(e, "pminud xmm1, xmm9", "66 41 0f 38 3b c9")
	e = x64SrcHex(e, "pminuw xmm1, xmm9", "66 41 0f 38 3a c9")
	e = x64SrcHex(e, "pmuldq xmm1, xmm9", "66 41 0f 38 28 c9")
	e = x64SrcHex(e, "pmulld xmm1, xmm9", "66 41 0f 38 40 c9")
	e = x64SrcHex(e, "pmulld xmm9, [rax]", "66 44 0f 38 40 08")
	e = x64SrcHex(e, "pmulld xmm1, xmmword ptr [r10]", "66 41 0f 38 40 0a")
	e = x64SrcHex(e, "ptest xmm1, xmm9", "66 41 0f 38 17 c9")
	e = x64SrcHex(e, "pcmpgtq xmm1, xmm9", "66 41 0f 38 37 c9")
	return e
}

// SSE3's lddqu and movddup, and SSSE3's palignr.
func TestX64Sse4Moves() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "lddqu xmm9, [rax]", "f2 44 0f f0 08")
	e = x64SrcHex(e, "lddqu xmm1, xmmword ptr [r10]", "f2 41 0f f0 0a")
	e = x64SrcHex(e, "movddup xmm1, xmm9", "f2 41 0f 12 c9")
	e = x64SrcHex(e, "movddup xmm9, [rax]", "f2 44 0f 12 08")
	e = x64SrcHex(e, "movddup xmm9, qword ptr [rax]", "f2 44 0f 12 08")
	e = x64SrcHex(e, "movddup xmm9, mmword ptr [rax]", "f2 44 0f 12 08")
	e = x64SrcHex(e, "palignr xmm1, xmm9, 1", "66 41 0f 3a 0f c9 01")
	e = x64SrcHex(e, "palignr xmm9, [rax], 1", "66 44 0f 3a 0f 08 01")
	e = x64SrcHex(e, "palignr xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 0f 0a 01")
	e = x64SrcHex(e, "palignr mm0, mm7, 1", "0f 3a 0f c7 01")
	e = x64SrcHex(e, "palignr mm7, [rax], 1", "0f 3a 0f 38 01")
	e = x64SrcHex(e, "palignr mm7, qword ptr [rax], 1", "0f 3a 0f 38 01")
	e = x64SrcHex(e, "palignr mm7, mmword ptr [rax], 1", "0f 3a 0f 38 01")
	return e
}

// SSE4.1's blends (the variable ones with or without their xmm0 written), dot products, extracts
// and inserts, movntdqa, mpsadbw, the sign and zero extensions and rounding; SSE4.2's string
// compares.
func TestX64Sse4BlendsExtracts() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "blendpd xmm1, xmm9, 1", "66 41 0f 3a 0d c9 01")
	e = x64SrcHex(e, "blendpd xmm9, [rax], 1", "66 44 0f 3a 0d 08 01")
	e = x64SrcHex(e, "blendpd xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 0d 0a 01")
	e = x64SrcHex(e, "blendps xmm1, xmm9, 1", "66 41 0f 3a 0c c9 01")
	e = x64SrcHex(e, "blendps xmm9, [rax], 1", "66 44 0f 3a 0c 08 01")
	e = x64SrcHex(e, "blendps xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 0c 0a 01")
	e = x64SrcHex(e, "blendvpd xmm1, xmm9", "66 41 0f 38 15 c9")
	e = x64SrcHex(e, "blendvpd xmm9, [rax]", "66 44 0f 38 15 08")
	e = x64SrcHex(e, "blendvpd xmm1, xmmword ptr [r10]", "66 41 0f 38 15 0a")
	e = x64SrcHex(e, "blendvpd xmm9, xmm0", "66 44 0f 38 15 c8")
	e = x64SrcHex(e, "blendvpd xmm0, xmm9", "66 41 0f 38 15 c1")
	e = x64SrcHex(e, "blendvpd xmm0, [rax]", "66 0f 38 15 00")
	e = x64SrcHex(e, "blendvpd xmm0, xmmword ptr [r10]", "66 41 0f 38 15 02")
	e = x64SrcHex(e, "blendvpd xmm0, xmm0", "66 0f 38 15 c0")
	e = x64SrcHex(e, "blendvpd xmm1, xmm9, xmm0", "66 41 0f 38 15 c9")
	e = x64SrcHex(e, "blendvpd xmm9, [rax], xmm0", "66 44 0f 38 15 08")
	e = x64SrcHex(e, "blendvpd xmm1, xmmword ptr [r10], xmm0", "66 41 0f 38 15 0a")
	e = x64SrcHex(e, "blendvpd xmm9, xmm0, xmm0", "66 44 0f 38 15 c8")
	e = x64SrcHex(e, "blendvpd xmm0, xmm9, xmm0", "66 41 0f 38 15 c1")
	e = x64SrcHex(e, "blendvpd xmm0, [rax], xmm0", "66 0f 38 15 00")
	e = x64SrcHex(e, "blendvpd xmm0, xmmword ptr [r10], xmm0", "66 41 0f 38 15 02")
	e = x64SrcHex(e, "blendvpd xmm0, xmm0, xmm0", "66 0f 38 15 c0")
	e = x64SrcHex(e, "blendvps xmm1, xmm9", "66 41 0f 38 14 c9")
	e = x64SrcHex(e, "blendvps xmm9, [rax]", "66 44 0f 38 14 08")
	e = x64SrcHex(e, "blendvps xmm1, xmmword ptr [r10]", "66 41 0f 38 14 0a")
	e = x64SrcHex(e, "blendvps xmm9, xmm0", "66 44 0f 38 14 c8")
	e = x64SrcHex(e, "blendvps xmm0, xmm9", "66 41 0f 38 14 c1")
	e = x64SrcHex(e, "blendvps xmm0, [rax]", "66 0f 38 14 00")
	e = x64SrcHex(e, "blendvps xmm0, xmmword ptr [r10]", "66 41 0f 38 14 02")
	e = x64SrcHex(e, "blendvps xmm0, xmm0", "66 0f 38 14 c0")
	e = x64SrcHex(e, "blendvps xmm1, xmm9, xmm0", "66 41 0f 38 14 c9")
	e = x64SrcHex(e, "blendvps xmm9, [rax], xmm0", "66 44 0f 38 14 08")
	e = x64SrcHex(e, "blendvps xmm1, xmmword ptr [r10], xmm0", "66 41 0f 38 14 0a")
	e = x64SrcHex(e, "blendvps xmm9, xmm0, xmm0", "66 44 0f 38 14 c8")
	e = x64SrcHex(e, "blendvps xmm0, xmm9, xmm0", "66 41 0f 38 14 c1")
	e = x64SrcHex(e, "blendvps xmm0, [rax], xmm0", "66 0f 38 14 00")
	e = x64SrcHex(e, "blendvps xmm0, xmmword ptr [r10], xmm0", "66 41 0f 38 14 02")
	e = x64SrcHex(e, "blendvps xmm0, xmm0, xmm0", "66 0f 38 14 c0")
	e = x64SrcHex(e, "dppd xmm1, xmm9, 1", "66 41 0f 3a 41 c9 01")
	e = x64SrcHex(e, "dppd xmm9, [rax], 1", "66 44 0f 3a 41 08 01")
	e = x64SrcHex(e, "dppd xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 41 0a 01")
	e = x64SrcHex(e, "dpps xmm1, xmm9, 1", "66 41 0f 3a 40 c9 01")
	e = x64SrcHex(e, "dpps xmm9, [rax], 1", "66 44 0f 3a 40 08 01")
	e = x64SrcHex(e, "dpps xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 40 0a 01")
	e = x64SrcHex(e, "extractps eax, xmm9, 1", "66 44 0f 3a 17 c8 01")
	e = x64SrcHex(e, "extractps rax, xmm9, 1", "66 44 0f 3a 17 c8 01")
	e = x64SrcHex(e, "extractps [rax], xmm9, 1", "66 44 0f 3a 17 08 01")
	e = x64SrcHex(e, "extractps dword ptr [rax], xmm9, 1", "66 44 0f 3a 17 08 01")
	e = x64SrcHex(e, "insertps xmm1, xmm9, 1", "66 41 0f 3a 21 c9 01")
	e = x64SrcHex(e, "insertps xmm9, [rax], 1", "66 44 0f 3a 21 08 01")
	e = x64SrcHex(e, "insertps xmm9, dword ptr [rax], 1", "66 44 0f 3a 21 08 01")
	e = x64SrcHex(e, "movntdqa xmm9, [rax]", "66 44 0f 38 2a 08")
	e = x64SrcHex(e, "movntdqa xmm1, xmmword ptr [r10]", "66 41 0f 38 2a 0a")
	e = x64SrcHex(e, "mpsadbw xmm1, xmm9, 1", "66 41 0f 3a 42 c9 01")
	e = x64SrcHex(e, "mpsadbw xmm9, [rax], 1", "66 44 0f 3a 42 08 01")
	e = x64SrcHex(e, "mpsadbw xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 42 0a 01")
	e = x64SrcHex(e, "pblendvb xmm1, xmm9", "66 41 0f 38 10 c9")
	e = x64SrcHex(e, "pblendvb xmm9, [rax]", "66 44 0f 38 10 08")
	e = x64SrcHex(e, "pblendvb xmm1, xmmword ptr [r10]", "66 41 0f 38 10 0a")
	e = x64SrcHex(e, "pblendvb xmm9, xmm0", "66 44 0f 38 10 c8")
	e = x64SrcHex(e, "pblendvb xmm0, xmm9", "66 41 0f 38 10 c1")
	e = x64SrcHex(e, "pblendvb xmm0, [rax]", "66 0f 38 10 00")
	e = x64SrcHex(e, "pblendvb xmm0, xmmword ptr [r10]", "66 41 0f 38 10 02")
	e = x64SrcHex(e, "pblendvb xmm0, xmm0", "66 0f 38 10 c0")
	e = x64SrcHex(e, "pblendvb xmm1, xmm9, xmm0", "66 41 0f 38 10 c9")
	e = x64SrcHex(e, "pblendvb xmm9, [rax], xmm0", "66 44 0f 38 10 08")
	e = x64SrcHex(e, "pblendvb xmm1, xmmword ptr [r10], xmm0", "66 41 0f 38 10 0a")
	e = x64SrcHex(e, "pblendvb xmm9, xmm0, xmm0", "66 44 0f 38 10 c8")
	e = x64SrcHex(e, "pblendvb xmm0, xmm9, xmm0", "66 41 0f 38 10 c1")
	e = x64SrcHex(e, "pblendvb xmm0, [rax], xmm0", "66 0f 38 10 00")
	e = x64SrcHex(e, "pblendvb xmm0, xmmword ptr [r10], xmm0", "66 41 0f 38 10 02")
	e = x64SrcHex(e, "pblendvb xmm0, xmm0, xmm0", "66 0f 38 10 c0")
	e = x64SrcHex(e, "pblendw xmm1, xmm9, 1", "66 41 0f 3a 0e c9 01")
	e = x64SrcHex(e, "pblendw xmm9, [rax], 1", "66 44 0f 3a 0e 08 01")
	e = x64SrcHex(e, "pblendw xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 0e 0a 01")
	e = x64SrcHex(e, "pextrb eax, xmm9, 1", "66 44 0f 3a 14 c8 01")
	e = x64SrcHex(e, "pextrb rax, xmm9, 1", "66 44 0f 3a 14 c8 01")
	e = x64SrcHex(e, "pextrb [rax], xmm9, 1", "66 44 0f 3a 14 08 01")
	e = x64SrcHex(e, "pextrb byte ptr [rax], xmm9, 1", "66 44 0f 3a 14 08 01")
	e = x64SrcHex(e, "pextrd eax, xmm9, 1", "66 44 0f 3a 16 c8 01")
	e = x64SrcHex(e, "pextrd [rax], xmm9, 1", "66 44 0f 3a 16 08 01")
	e = x64SrcHex(e, "pextrd dword ptr [rax], xmm9, 1", "66 44 0f 3a 16 08 01")
	e = x64SrcHex(e, "pextrq rax, xmm9, 1", "66 4c 0f 3a 16 c8 01")
	e = x64SrcHex(e, "pextrq [rax], xmm9, 1", "66 4c 0f 3a 16 08 01")
	e = x64SrcHex(e, "pextrq qword ptr [rax], xmm9, 1", "66 4c 0f 3a 16 08 01")
	e = x64SrcHex(e, "pextrq mmword ptr [rax], xmm9, 1", "66 4c 0f 3a 16 08 01")
	e = x64SrcHex(e, "pinsrb xmm1, r9d, 1", "66 41 0f 3a 20 c9 01")
	e = x64SrcHex(e, "pinsrb xmm1, r9, 1", "66 41 0f 3a 20 c9 01")
	e = x64SrcHex(e, "pinsrb xmm9, [rax], 1", "66 44 0f 3a 20 08 01")
	e = x64SrcHex(e, "pinsrb xmm9, byte ptr [rax], 1", "66 44 0f 3a 20 08 01")
	e = x64SrcHex(e, "pinsrd xmm1, r9d, 1", "66 41 0f 3a 22 c9 01")
	e = x64SrcHex(e, "pinsrd xmm9, [rax], 1", "66 44 0f 3a 22 08 01")
	e = x64SrcHex(e, "pinsrd xmm9, dword ptr [rax], 1", "66 44 0f 3a 22 08 01")
	e = x64SrcHex(e, "pinsrq xmm1, r9, 1", "66 49 0f 3a 22 c9 01")
	e = x64SrcHex(e, "pinsrq xmm9, [rax], 1", "66 4c 0f 3a 22 08 01")
	e = x64SrcHex(e, "pinsrq xmm9, qword ptr [rax], 1", "66 4c 0f 3a 22 08 01")
	e = x64SrcHex(e, "pinsrq xmm9, mmword ptr [rax], 1", "66 4c 0f 3a 22 08 01")
	e = x64SrcHex(e, "pmovsxbw xmm1, xmm9", "66 41 0f 38 20 c9")
	e = x64SrcHex(e, "pmovsxbw xmm9, [rax]", "66 44 0f 38 20 08")
	e = x64SrcHex(e, "pmovsxbw xmm9, qword ptr [rax]", "66 44 0f 38 20 08")
	e = x64SrcHex(e, "pmovsxbw xmm9, mmword ptr [rax]", "66 44 0f 38 20 08")
	e = x64SrcHex(e, "pmovsxbd xmm1, xmm9", "66 41 0f 38 21 c9")
	e = x64SrcHex(e, "pmovsxbd xmm9, [rax]", "66 44 0f 38 21 08")
	e = x64SrcHex(e, "pmovsxbd xmm9, dword ptr [rax]", "66 44 0f 38 21 08")
	e = x64SrcHex(e, "pmovsxbq xmm1, xmm9", "66 41 0f 38 22 c9")
	e = x64SrcHex(e, "pmovsxbq xmm9, [rax]", "66 44 0f 38 22 08")
	e = x64SrcHex(e, "pmovsxbq xmm9, word ptr [rax]", "66 44 0f 38 22 08")
	e = x64SrcHex(e, "pmovsxwd xmm1, xmm9", "66 41 0f 38 23 c9")
	e = x64SrcHex(e, "pmovsxwd xmm9, [rax]", "66 44 0f 38 23 08")
	e = x64SrcHex(e, "pmovsxwd xmm9, qword ptr [rax]", "66 44 0f 38 23 08")
	e = x64SrcHex(e, "pmovsxwd xmm9, mmword ptr [rax]", "66 44 0f 38 23 08")
	e = x64SrcHex(e, "pmovsxwq xmm1, xmm9", "66 41 0f 38 24 c9")
	e = x64SrcHex(e, "pmovsxwq xmm9, [rax]", "66 44 0f 38 24 08")
	e = x64SrcHex(e, "pmovsxwq xmm9, dword ptr [rax]", "66 44 0f 38 24 08")
	e = x64SrcHex(e, "pmovsxdq xmm1, xmm9", "66 41 0f 38 25 c9")
	e = x64SrcHex(e, "pmovsxdq xmm9, [rax]", "66 44 0f 38 25 08")
	e = x64SrcHex(e, "pmovsxdq xmm9, qword ptr [rax]", "66 44 0f 38 25 08")
	e = x64SrcHex(e, "pmovsxdq xmm9, mmword ptr [rax]", "66 44 0f 38 25 08")
	e = x64SrcHex(e, "pmovzxbw xmm1, xmm9", "66 41 0f 38 30 c9")
	e = x64SrcHex(e, "pmovzxbw xmm9, [rax]", "66 44 0f 38 30 08")
	e = x64SrcHex(e, "pmovzxbw xmm9, qword ptr [rax]", "66 44 0f 38 30 08")
	e = x64SrcHex(e, "pmovzxbw xmm9, mmword ptr [rax]", "66 44 0f 38 30 08")
	e = x64SrcHex(e, "pmovzxbd xmm1, xmm9", "66 41 0f 38 31 c9")
	e = x64SrcHex(e, "pmovzxbd xmm9, [rax]", "66 44 0f 38 31 08")
	e = x64SrcHex(e, "pmovzxbd xmm9, dword ptr [rax]", "66 44 0f 38 31 08")
	e = x64SrcHex(e, "pmovzxbq xmm1, xmm9", "66 41 0f 38 32 c9")
	e = x64SrcHex(e, "pmovzxbq xmm9, [rax]", "66 44 0f 38 32 08")
	e = x64SrcHex(e, "pmovzxbq xmm9, word ptr [rax]", "66 44 0f 38 32 08")
	e = x64SrcHex(e, "pmovzxwd xmm1, xmm9", "66 41 0f 38 33 c9")
	e = x64SrcHex(e, "pmovzxwd xmm9, [rax]", "66 44 0f 38 33 08")
	e = x64SrcHex(e, "pmovzxwd xmm9, qword ptr [rax]", "66 44 0f 38 33 08")
	e = x64SrcHex(e, "pmovzxwd xmm9, mmword ptr [rax]", "66 44 0f 38 33 08")
	e = x64SrcHex(e, "pmovzxwq xmm1, xmm9", "66 41 0f 38 34 c9")
	e = x64SrcHex(e, "pmovzxwq xmm9, [rax]", "66 44 0f 38 34 08")
	e = x64SrcHex(e, "pmovzxwq xmm9, dword ptr [rax]", "66 44 0f 38 34 08")
	e = x64SrcHex(e, "pmovzxdq xmm1, xmm9", "66 41 0f 38 35 c9")
	e = x64SrcHex(e, "pmovzxdq xmm9, [rax]", "66 44 0f 38 35 08")
	e = x64SrcHex(e, "pmovzxdq xmm9, qword ptr [rax]", "66 44 0f 38 35 08")
	e = x64SrcHex(e, "pmovzxdq xmm9, mmword ptr [rax]", "66 44 0f 38 35 08")
	e = x64SrcHex(e, "roundpd xmm1, xmm9, 1", "66 41 0f 3a 09 c9 01")
	e = x64SrcHex(e, "roundpd xmm9, [rax], 1", "66 44 0f 3a 09 08 01")
	e = x64SrcHex(e, "roundpd xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 09 0a 01")
	e = x64SrcHex(e, "roundps xmm1, xmm9, 1", "66 41 0f 3a 08 c9 01")
	e = x64SrcHex(e, "roundps xmm9, [rax], 1", "66 44 0f 3a 08 08 01")
	e = x64SrcHex(e, "roundps xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 08 0a 01")
	e = x64SrcHex(e, "roundsd xmm1, xmm9, 1", "66 41 0f 3a 0b c9 01")
	e = x64SrcHex(e, "roundsd xmm9, [rax], 1", "66 44 0f 3a 0b 08 01")
	e = x64SrcHex(e, "roundsd xmm9, qword ptr [rax], 1", "66 44 0f 3a 0b 08 01")
	e = x64SrcHex(e, "roundsd xmm9, mmword ptr [rax], 1", "66 44 0f 3a 0b 08 01")
	e = x64SrcHex(e, "roundss xmm1, xmm9, 1", "66 41 0f 3a 0a c9 01")
	e = x64SrcHex(e, "roundss xmm9, [rax], 1", "66 44 0f 3a 0a 08 01")
	e = x64SrcHex(e, "roundss xmm9, dword ptr [rax], 1", "66 44 0f 3a 0a 08 01")
	e = x64SrcHex(e, "pcmpestri xmm1, xmm9, 1", "66 41 0f 3a 61 c9 01")
	e = x64SrcHex(e, "pcmpestri xmm9, [rax], 1", "66 44 0f 3a 61 08 01")
	e = x64SrcHex(e, "pcmpestri xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 61 0a 01")
	e = x64SrcHex(e, "pcmpestrm xmm1, xmm9, 1", "66 41 0f 3a 60 c9 01")
	e = x64SrcHex(e, "pcmpestrm xmm9, [rax], 1", "66 44 0f 3a 60 08 01")
	e = x64SrcHex(e, "pcmpestrm xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 60 0a 01")
	e = x64SrcHex(e, "pcmpistri xmm1, xmm9, 1", "66 41 0f 3a 63 c9 01")
	e = x64SrcHex(e, "pcmpistri xmm9, [rax], 1", "66 44 0f 3a 63 08 01")
	e = x64SrcHex(e, "pcmpistri xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 63 0a 01")
	e = x64SrcHex(e, "pcmpistrm xmm1, xmm9, 1", "66 41 0f 3a 62 c9 01")
	e = x64SrcHex(e, "pcmpistrm xmm9, [rax], 1", "66 44 0f 3a 62 08 01")
	e = x64SrcHex(e, "pcmpistrm xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 62 0a 01")
	return e
}

// What clang rejects: pextrd / pinsrd with a 64-bit register, pextrq / pinsrq with a 32-bit one, a
// variable blend's third operand other than xmm0, the extensions' memory of another size, SSE4's
// instructions on MMX registers, lddqu / movntdqa from a register; and a lock, repeat or data16
// prefix (GNU as); rex64 before them, as GNU as places it.
func TestX64Sse4Rejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "pextrd rax, xmm0, 1")
	e = x64LineRejected(e, "pinsrd xmm0, rax, 1")
	e = x64LineRejected(e, "pextrq eax, xmm0, 1")
	e = x64LineRejected(e, "pinsrq xmm0, eax, 1")
	e = x64LineRejected(e, "blendvps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "pblendvb xmm0, xmm1, xmm9")
	e = x64LineRejected(e, "pmovzxbq xmm0, dword ptr [rax]")
	e = x64LineRejected(e, "pmovsxbw xmm0, xmmword ptr [rax]")
	e = x64LineRejected(e, "pmulld mm0, mm1")
	e = x64LineRejected(e, "ptest mm0, mm1")
	e = x64LineRejected(e, "lddqu xmm0, xmm1")
	e = x64LineRejected(e, "movntdqa xmm0, xmm1")
	e = x64LineRejected(e, "roundss xmm0, qword ptr [rax], 1")
	e = x64LineRejected(e, "pshufb xmm0, mm1")
	e = x64LineRejected(e, "lock pshufb xmm0, [rax]")
	e = x64LineRejected(e, "rep ptest xmm0, xmm1")
	e = x64LineErrorHas(e, "data16 pshufb mm0, mm1", "data16 cannot stand before an SSE or MMX")
	// rex64 is the instruction's REX.W, as GNU as places it: pextrd's becomes pextrq, and pinsrq has
	// one of its own.
	e = x64SrcHex(e, "rex64 pextrd eax, xmm0, 1", "66 48 0f 3a 16 c0 01")
	e = x64SrcHex(e, "rex64 pinsrd xmm9, dword ptr [r10], 1", "66 4d 0f 3a 22 0a 01")
	e = x64LineErrorHas(e, "rex64 pinsrq xmm0, [rax], 1", "a REX.W of its own")
	e = x64LineErrorHas(e, "rex64 pextrq rax, xmm0, 1", "a REX.W of its own")
	return e
}
