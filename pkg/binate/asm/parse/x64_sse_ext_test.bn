package "pkg/binate/asm/parse"

import "pkg/binate/asm"
import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The extensions of the SSE table's fourth part (x64_sse.bn): AES, CLMUL, SHA, GFNI's legacy forms,
// Key Locker's with XMM operands, SSE4a, 3DNow!, against clang's bytes (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): each name and operand shape clang
// takes, with registers 8..15 and mm7 where the shape has a register; the encodings in full are
// package sse's tests.  (x64SrcHex and x64LineRejected are in x64_target_test.bn, x64LineErrorHas
// in x64_prefix_test.bn, x64TlsCase in x64_tls_test.bn.)

// AES, CLMUL (its selectors' names), SHA, GFNI, Key Locker and SSE4a.
func TestX64SseExtCrypto() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "aesenc xmm1, xmm9", "66 41 0f 38 dc c9")
	e = x64SrcHex(e, "aesenc xmm9, [rax]", "66 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesenc xmm1, xmmword ptr [r10]", "66 41 0f 38 dc 0a")
	e = x64SrcHex(e, "aesenclast xmm1, xmm9", "66 41 0f 38 dd c9")
	e = x64SrcHex(e, "aesenclast xmm9, [rax]", "66 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesenclast xmm1, xmmword ptr [r10]", "66 41 0f 38 dd 0a")
	e = x64SrcHex(e, "aesdec xmm1, xmm9", "66 41 0f 38 de c9")
	e = x64SrcHex(e, "aesdec xmm9, [rax]", "66 44 0f 38 de 08")
	e = x64SrcHex(e, "aesdec xmm1, xmmword ptr [r10]", "66 41 0f 38 de 0a")
	e = x64SrcHex(e, "aesdeclast xmm1, xmm9", "66 41 0f 38 df c9")
	e = x64SrcHex(e, "aesdeclast xmm9, [rax]", "66 44 0f 38 df 08")
	e = x64SrcHex(e, "aesdeclast xmm1, xmmword ptr [r10]", "66 41 0f 38 df 0a")
	e = x64SrcHex(e, "aesimc xmm1, xmm9", "66 41 0f 38 db c9")
	e = x64SrcHex(e, "aesimc xmm9, [rax]", "66 44 0f 38 db 08")
	e = x64SrcHex(e, "aesimc xmm1, xmmword ptr [r10]", "66 41 0f 38 db 0a")
	e = x64SrcHex(e, "aeskeygenassist xmm1, xmm9, 1", "66 41 0f 3a df c9 01")
	e = x64SrcHex(e, "aeskeygenassist xmm9, [rax], 1", "66 44 0f 3a df 08 01")
	e = x64SrcHex(e, "aeskeygenassist xmm1, xmmword ptr [r10], 1", "66 41 0f 3a df 0a 01")
	e = x64SrcHex(e, "pclmulqdq xmm1, xmm9, 1", "66 41 0f 3a 44 c9 01")
	e = x64SrcHex(e, "pclmulqdq xmm9, [rax], 1", "66 44 0f 3a 44 08 01")
	e = x64SrcHex(e, "pclmulqdq xmm1, xmmword ptr [r10], 1", "66 41 0f 3a 44 0a 01")
	e = x64SrcHex(e, "pclmullqlqdq xmm1, xmm9", "66 41 0f 3a 44 c9 00")
	e = x64SrcHex(e, "pclmullqlqdq xmm9, [rax]", "66 44 0f 3a 44 08 00")
	e = x64SrcHex(e, "pclmullqlqdq xmm1, xmmword ptr [r10]", "66 41 0f 3a 44 0a 00")
	e = x64SrcHex(e, "pclmulhqlqdq xmm1, xmm9", "66 41 0f 3a 44 c9 01")
	e = x64SrcHex(e, "pclmulhqlqdq xmm9, [rax]", "66 44 0f 3a 44 08 01")
	e = x64SrcHex(e, "pclmulhqlqdq xmm1, xmmword ptr [r10]", "66 41 0f 3a 44 0a 01")
	e = x64SrcHex(e, "pclmullqhqdq xmm1, xmm9", "66 41 0f 3a 44 c9 10")
	e = x64SrcHex(e, "pclmullqhqdq xmm9, [rax]", "66 44 0f 3a 44 08 10")
	e = x64SrcHex(e, "pclmullqhqdq xmm1, xmmword ptr [r10]", "66 41 0f 3a 44 0a 10")
	e = x64SrcHex(e, "pclmulhqhqdq xmm1, xmm9", "66 41 0f 3a 44 c9 11")
	e = x64SrcHex(e, "pclmulhqhqdq xmm9, [rax]", "66 44 0f 3a 44 08 11")
	e = x64SrcHex(e, "pclmulhqhqdq xmm1, xmmword ptr [r10]", "66 41 0f 3a 44 0a 11")
	e = x64SrcHex(e, "sha1rnds4 xmm1, xmm9, 1", "41 0f 3a cc c9 01")
	e = x64SrcHex(e, "sha1rnds4 xmm9, [rax], 1", "44 0f 3a cc 08 01")
	e = x64SrcHex(e, "sha1rnds4 xmm1, xmmword ptr [r10], 1", "41 0f 3a cc 0a 01")
	e = x64SrcHex(e, "sha1nexte xmm1, xmm9", "41 0f 38 c8 c9")
	e = x64SrcHex(e, "sha1nexte xmm9, [rax]", "44 0f 38 c8 08")
	e = x64SrcHex(e, "sha1nexte xmm1, xmmword ptr [r10]", "41 0f 38 c8 0a")
	e = x64SrcHex(e, "sha1msg1 xmm1, xmm9", "41 0f 38 c9 c9")
	e = x64SrcHex(e, "sha1msg1 xmm9, [rax]", "44 0f 38 c9 08")
	e = x64SrcHex(e, "sha1msg1 xmm1, xmmword ptr [r10]", "41 0f 38 c9 0a")
	e = x64SrcHex(e, "sha1msg2 xmm1, xmm9", "41 0f 38 ca c9")
	e = x64SrcHex(e, "sha1msg2 xmm9, [rax]", "44 0f 38 ca 08")
	e = x64SrcHex(e, "sha1msg2 xmm1, xmmword ptr [r10]", "41 0f 38 ca 0a")
	e = x64SrcHex(e, "sha256rnds2 xmm1, xmm9", "41 0f 38 cb c9")
	e = x64SrcHex(e, "sha256rnds2 xmm9, [rax]", "44 0f 38 cb 08")
	e = x64SrcHex(e, "sha256rnds2 xmm1, xmmword ptr [r10]", "41 0f 38 cb 0a")
	e = x64SrcHex(e, "sha256rnds2 xmm1, xmm9, xmm0", "41 0f 38 cb c9")
	e = x64SrcHex(e, "sha256rnds2 xmm9, [rax], xmm0", "44 0f 38 cb 08")
	e = x64SrcHex(e, "sha256rnds2 xmm1, xmmword ptr [r10], xmm0", "41 0f 38 cb 0a")
	e = x64SrcHex(e, "sha256msg1 xmm1, xmm9", "41 0f 38 cc c9")
	e = x64SrcHex(e, "sha256msg1 xmm9, [rax]", "44 0f 38 cc 08")
	e = x64SrcHex(e, "sha256msg1 xmm1, xmmword ptr [r10]", "41 0f 38 cc 0a")
	e = x64SrcHex(e, "sha256msg2 xmm1, xmm9", "41 0f 38 cd c9")
	e = x64SrcHex(e, "sha256msg2 xmm9, [rax]", "44 0f 38 cd 08")
	e = x64SrcHex(e, "sha256msg2 xmm1, xmmword ptr [r10]", "41 0f 38 cd 0a")
	e = x64SrcHex(e, "gf2p8affineqb xmm1, xmm9, 1", "66 41 0f 3a ce c9 01")
	e = x64SrcHex(e, "gf2p8affineqb xmm9, [rax], 1", "66 44 0f 3a ce 08 01")
	e = x64SrcHex(e, "gf2p8affineqb xmm1, xmmword ptr [r10], 1", "66 41 0f 3a ce 0a 01")
	e = x64SrcHex(e, "gf2p8affineinvqb xmm1, xmm9, 1", "66 41 0f 3a cf c9 01")
	e = x64SrcHex(e, "gf2p8affineinvqb xmm9, [rax], 1", "66 44 0f 3a cf 08 01")
	e = x64SrcHex(e, "gf2p8affineinvqb xmm1, xmmword ptr [r10], 1", "66 41 0f 3a cf 0a 01")
	e = x64SrcHex(e, "gf2p8mulb xmm1, xmm9", "66 41 0f 38 cf c9")
	e = x64SrcHex(e, "gf2p8mulb xmm9, [rax]", "66 44 0f 38 cf 08")
	e = x64SrcHex(e, "gf2p8mulb xmm1, xmmword ptr [r10]", "66 41 0f 38 cf 0a")
	e = x64SrcHex(e, "aesenc128kl xmm9, [rax]", "f3 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesenc128kl xmm9, byte ptr [rax]", "f3 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesenc128kl xmm9, word ptr [rax]", "f3 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesenc128kl xmm9, dword ptr [rax]", "f3 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesenc128kl xmm9, qword ptr [rax]", "f3 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesenc128kl xmm1, xmmword ptr [r10]", "f3 41 0f 38 dc 0a")
	e = x64SrcHex(e, "aesenc128kl xmm9, mmword ptr [rax]", "f3 44 0f 38 dc 08")
	e = x64SrcHex(e, "aesdec128kl xmm9, [rax]", "f3 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesdec128kl xmm9, byte ptr [rax]", "f3 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesdec128kl xmm9, word ptr [rax]", "f3 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesdec128kl xmm9, dword ptr [rax]", "f3 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesdec128kl xmm9, qword ptr [rax]", "f3 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesdec128kl xmm1, xmmword ptr [r10]", "f3 41 0f 38 dd 0a")
	e = x64SrcHex(e, "aesdec128kl xmm9, mmword ptr [rax]", "f3 44 0f 38 dd 08")
	e = x64SrcHex(e, "aesenc256kl xmm9, [rax]", "f3 44 0f 38 de 08")
	e = x64SrcHex(e, "aesenc256kl xmm9, byte ptr [rax]", "f3 44 0f 38 de 08")
	e = x64SrcHex(e, "aesenc256kl xmm9, word ptr [rax]", "f3 44 0f 38 de 08")
	e = x64SrcHex(e, "aesenc256kl xmm9, dword ptr [rax]", "f3 44 0f 38 de 08")
	e = x64SrcHex(e, "aesenc256kl xmm9, qword ptr [rax]", "f3 44 0f 38 de 08")
	e = x64SrcHex(e, "aesenc256kl xmm1, xmmword ptr [r10]", "f3 41 0f 38 de 0a")
	e = x64SrcHex(e, "aesenc256kl xmm9, mmword ptr [rax]", "f3 44 0f 38 de 08")
	e = x64SrcHex(e, "aesdec256kl xmm9, [rax]", "f3 44 0f 38 df 08")
	e = x64SrcHex(e, "aesdec256kl xmm9, byte ptr [rax]", "f3 44 0f 38 df 08")
	e = x64SrcHex(e, "aesdec256kl xmm9, word ptr [rax]", "f3 44 0f 38 df 08")
	e = x64SrcHex(e, "aesdec256kl xmm9, dword ptr [rax]", "f3 44 0f 38 df 08")
	e = x64SrcHex(e, "aesdec256kl xmm9, qword ptr [rax]", "f3 44 0f 38 df 08")
	e = x64SrcHex(e, "aesdec256kl xmm1, xmmword ptr [r10]", "f3 41 0f 38 df 0a")
	e = x64SrcHex(e, "aesdec256kl xmm9, mmword ptr [rax]", "f3 44 0f 38 df 08")
	e = x64SrcHex(e, "loadiwkey xmm1, xmm9", "f3 41 0f 38 dc c9")
	e = x64SrcHex(e, "extrq xmm1, xmm9", "66 41 0f 79 c9")
	e = x64SrcHex(e, "extrq xmm9, 1, 1", "66 41 0f 78 c1 01 01")
	e = x64SrcHex(e, "insertq xmm1, xmm9", "f2 41 0f 79 c9")
	e = x64SrcHex(e, "insertq xmm1, xmm9, 1, 2", "f2 41 0f 78 c9 01 02")
	e = x64SrcHex(e, "movntss [rax], xmm9", "f3 44 0f 2b 08")
	e = x64SrcHex(e, "movntss dword ptr [rax], xmm9", "f3 44 0f 2b 08")
	e = x64SrcHex(e, "movntsd [rax], xmm9", "f2 44 0f 2b 08")
	e = x64SrcHex(e, "movntsd qword ptr [rax], xmm9", "f2 44 0f 2b 08")
	e = x64SrcHex(e, "movntsd mmword ptr [rax], xmm9", "f2 44 0f 2b 08")
	e = x64SrcHex(e, "extrq xmm9, 1, 2", "66 41 0f 78 c1 01 02")
	e = x64SrcHex(e, "insertq xmm9, xmm9, 1, 2", "f2 45 0f 78 c9 01 02")
	e = x64TlsCase(e, "extrq xmm1, 2, offset x", "66 0f 78 c1 02 00", asm.FIX_DATA_ABS8, 5, 0)
	return e
}

// 3DNow! (0F 0F, its opcode after ModR/M) and femms; a `[rip + x]` operand's rel32 counts the
// opcode after it, as GNU as's does (clang's addresses the byte after the target, -4).
func TestX64SseExt3dnow() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "pavgusb mm0, mm7", "0f 0f c7 bf")
	e = x64SrcHex(e, "pf2id mm0, mm7", "0f 0f c7 1d")
	e = x64SrcHex(e, "pf2iw mm0, mm7", "0f 0f c7 1c")
	e = x64SrcHex(e, "pfacc mm0, mm7", "0f 0f c7 ae")
	e = x64SrcHex(e, "pfadd mm0, mm7", "0f 0f c7 9e")
	e = x64SrcHex(e, "pfadd mm7, [rax]", "0f 0f 38 9e")
	e = x64SrcHex(e, "pfadd mm7, qword ptr [rax]", "0f 0f 38 9e")
	e = x64SrcHex(e, "pfadd mm7, mmword ptr [rax]", "0f 0f 38 9e")
	e = x64SrcHex(e, "pfcmpeq mm0, mm7", "0f 0f c7 b0")
	e = x64SrcHex(e, "pfcmpge mm0, mm7", "0f 0f c7 90")
	e = x64SrcHex(e, "pfcmpgt mm0, mm7", "0f 0f c7 a0")
	e = x64SrcHex(e, "pfmax mm0, mm7", "0f 0f c7 a4")
	e = x64SrcHex(e, "pfmin mm0, mm7", "0f 0f c7 94")
	e = x64SrcHex(e, "pfmul mm0, mm7", "0f 0f c7 b4")
	e = x64SrcHex(e, "pfnacc mm0, mm7", "0f 0f c7 8a")
	e = x64SrcHex(e, "pfpnacc mm0, mm7", "0f 0f c7 8e")
	e = x64SrcHex(e, "pfrcp mm0, mm7", "0f 0f c7 96")
	e = x64SrcHex(e, "pfrcpit1 mm0, mm7", "0f 0f c7 a6")
	e = x64SrcHex(e, "pfrcpit2 mm0, mm7", "0f 0f c7 b6")
	e = x64SrcHex(e, "pfrsqit1 mm0, mm7", "0f 0f c7 a7")
	e = x64SrcHex(e, "pfrsqrt mm0, mm7", "0f 0f c7 97")
	e = x64SrcHex(e, "pfsub mm0, mm7", "0f 0f c7 9a")
	e = x64SrcHex(e, "pfsubr mm0, mm7", "0f 0f c7 aa")
	e = x64SrcHex(e, "pi2fd mm0, mm7", "0f 0f c7 0d")
	e = x64SrcHex(e, "pi2fw mm0, mm7", "0f 0f c7 0c")
	e = x64SrcHex(e, "pmulhrw mm0, mm7", "0f 0f c7 b7")
	e = x64SrcHex(e, "pswapd mm0, mm7", "0f 0f c7 bb")
	e = x64SrcHex(e, "femms", "0f 0e")
	e = x64TlsCase(e, "pfadd mm7, qword ptr [rip + x]", "0f 0f 3d 00 00 00 00 9e", x64.FIX_REL32_LEA,
			3, -1)
	return e
}

// What clang rejects: Key Locker's handle in a register, loadiwkey from memory, sha256rnds2's third
// operand other than xmm0, SSE4a's immediates past 8 bits or three of them, the movnt stores from
// another size, 3DNow! on XMM registers, the CLMUL names with an immediate; and a lock, repeat or
// data16 prefix (GNU as).
func TestX64SseExtRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "aesenc128kl xmm0, xmm1")
	e = x64LineRejected(e, "loadiwkey xmm0, [rax]")
	e = x64LineRejected(e, "sha256rnds2 xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "insertq xmm0, xmm1, 1, 256")
	e = x64LineRejected(e, "extrq xmm0, 1, 2, 3")
	e = x64LineRejected(e, "insertq xmm0, [rax], 1, 2")
	e = x64LineRejected(e, "extrq [rax], 1, 2")
	e = x64LineRejected(e, "movntss qword ptr [rax], xmm0")
	e = x64LineRejected(e, "movntsd xmm0, xmm1")
	e = x64LineRejected(e, "pfadd xmm0, xmm1")
	e = x64LineRejected(e, "pclmullqlqdq xmm0, xmm1, 1")
	e = x64LineRejected(e, "femms mm0")
	e = x64LineRejected(e, "lock aesenc xmm0, [rax]")
	e = x64LineRejected(e, "rep pfadd mm0, mm1")
	e = x64LineErrorHas(e, "data16 pfadd mm0, mm1", "data16 cannot stand before an SSE or MMX")
	return e
}
