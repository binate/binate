package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The SSE2 packed-integer and MMX instructions (x64_sse.bn, the table's packed-integer part)
// against clang's bytes (`clang --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): each
// name and operand shape clang takes, with registers 8..15 and mm7 where the shape has a
// register; the encodings in full are package sse's tests.  (x64SrcHex and x64LineRejected are in
// x64_target_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// The packed arithmetic, compares, logic, packs and unpacks: XMM and MMX registers, and every
// memory form of a few.
func TestX64SsePacked() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "packsswb xmm0, xmm9", "66 41 0f 63 c1")
	e = x64SrcHex(e, "packsswb xmm9, [rax]", "66 44 0f 63 08")
	e = x64SrcHex(e, "packsswb xmm0, xmmword ptr [r10]", "66 41 0f 63 02")
	e = x64SrcHex(e, "packsswb mm0, mm7", "0f 63 c7")
	e = x64SrcHex(e, "packsswb mm7, [rax]", "0f 63 38")
	e = x64SrcHex(e, "packsswb mm7, qword ptr [rax]", "0f 63 38")
	e = x64SrcHex(e, "packsswb mm7, mmword ptr [rax]", "0f 63 38")
	e = x64SrcHex(e, "packssdw xmm0, xmm9", "66 41 0f 6b c1")
	e = x64SrcHex(e, "packssdw mm0, mm7", "0f 6b c7")
	e = x64SrcHex(e, "packuswb xmm0, xmm9", "66 41 0f 67 c1")
	e = x64SrcHex(e, "packuswb mm0, mm7", "0f 67 c7")
	e = x64SrcHex(e, "paddb xmm0, xmm9", "66 41 0f fc c1")
	e = x64SrcHex(e, "paddb mm0, mm7", "0f fc c7")
	e = x64SrcHex(e, "paddw xmm0, xmm9", "66 41 0f fd c1")
	e = x64SrcHex(e, "paddw mm0, mm7", "0f fd c7")
	e = x64SrcHex(e, "paddd xmm0, xmm9", "66 41 0f fe c1")
	e = x64SrcHex(e, "paddd mm0, mm7", "0f fe c7")
	e = x64SrcHex(e, "paddq xmm0, xmm9", "66 41 0f d4 c1")
	e = x64SrcHex(e, "paddq mm0, mm7", "0f d4 c7")
	e = x64SrcHex(e, "paddsb xmm0, xmm9", "66 41 0f ec c1")
	e = x64SrcHex(e, "paddsb mm0, mm7", "0f ec c7")
	e = x64SrcHex(e, "paddsw xmm0, xmm9", "66 41 0f ed c1")
	e = x64SrcHex(e, "paddsw mm0, mm7", "0f ed c7")
	e = x64SrcHex(e, "paddusb xmm0, xmm9", "66 41 0f dc c1")
	e = x64SrcHex(e, "paddusb mm0, mm7", "0f dc c7")
	e = x64SrcHex(e, "paddusw xmm0, xmm9", "66 41 0f dd c1")
	e = x64SrcHex(e, "paddusw mm0, mm7", "0f dd c7")
	e = x64SrcHex(e, "pand xmm0, xmm9", "66 41 0f db c1")
	e = x64SrcHex(e, "pand mm0, mm7", "0f db c7")
	e = x64SrcHex(e, "pandn xmm0, xmm9", "66 41 0f df c1")
	e = x64SrcHex(e, "pandn mm0, mm7", "0f df c7")
	e = x64SrcHex(e, "pavgb xmm0, xmm9", "66 41 0f e0 c1")
	e = x64SrcHex(e, "pavgb mm0, mm7", "0f e0 c7")
	e = x64SrcHex(e, "pavgw xmm0, xmm9", "66 41 0f e3 c1")
	e = x64SrcHex(e, "pavgw mm0, mm7", "0f e3 c7")
	e = x64SrcHex(e, "pcmpeqb xmm0, xmm9", "66 41 0f 74 c1")
	e = x64SrcHex(e, "pcmpeqb mm0, mm7", "0f 74 c7")
	e = x64SrcHex(e, "pcmpeqw xmm0, xmm9", "66 41 0f 75 c1")
	e = x64SrcHex(e, "pcmpeqw mm0, mm7", "0f 75 c7")
	e = x64SrcHex(e, "pcmpeqd xmm0, xmm9", "66 41 0f 76 c1")
	e = x64SrcHex(e, "pcmpeqd mm0, mm7", "0f 76 c7")
	e = x64SrcHex(e, "pcmpgtb xmm0, xmm9", "66 41 0f 64 c1")
	e = x64SrcHex(e, "pcmpgtb mm0, mm7", "0f 64 c7")
	e = x64SrcHex(e, "pcmpgtw xmm0, xmm9", "66 41 0f 65 c1")
	e = x64SrcHex(e, "pcmpgtw mm0, mm7", "0f 65 c7")
	e = x64SrcHex(e, "pcmpgtd xmm0, xmm9", "66 41 0f 66 c1")
	e = x64SrcHex(e, "pcmpgtd mm0, mm7", "0f 66 c7")
	e = x64SrcHex(e, "pmaddwd xmm0, xmm9", "66 41 0f f5 c1")
	e = x64SrcHex(e, "pmaddwd mm0, mm7", "0f f5 c7")
	e = x64SrcHex(e, "pmaxsw xmm0, xmm9", "66 41 0f ee c1")
	e = x64SrcHex(e, "pmaxsw mm0, mm7", "0f ee c7")
	e = x64SrcHex(e, "pmaxub xmm0, xmm9", "66 41 0f de c1")
	e = x64SrcHex(e, "pmaxub mm0, mm7", "0f de c7")
	e = x64SrcHex(e, "pminsw xmm0, xmm9", "66 41 0f ea c1")
	e = x64SrcHex(e, "pminsw mm0, mm7", "0f ea c7")
	e = x64SrcHex(e, "pminub xmm0, xmm9", "66 41 0f da c1")
	e = x64SrcHex(e, "pminub mm0, mm7", "0f da c7")
	e = x64SrcHex(e, "pmulhuw xmm0, xmm9", "66 41 0f e4 c1")
	e = x64SrcHex(e, "pmulhuw mm0, mm7", "0f e4 c7")
	e = x64SrcHex(e, "pmulhw xmm0, xmm9", "66 41 0f e5 c1")
	e = x64SrcHex(e, "pmulhw mm0, mm7", "0f e5 c7")
	e = x64SrcHex(e, "pmullw xmm0, xmm9", "66 41 0f d5 c1")
	e = x64SrcHex(e, "pmullw mm0, mm7", "0f d5 c7")
	e = x64SrcHex(e, "pmuludq xmm0, xmm9", "66 41 0f f4 c1")
	e = x64SrcHex(e, "pmuludq mm0, mm7", "0f f4 c7")
	e = x64SrcHex(e, "por xmm0, xmm9", "66 41 0f eb c1")
	e = x64SrcHex(e, "por mm0, mm7", "0f eb c7")
	e = x64SrcHex(e, "psadbw xmm0, xmm9", "66 41 0f f6 c1")
	e = x64SrcHex(e, "psadbw mm0, mm7", "0f f6 c7")
	e = x64SrcHex(e, "psubb xmm0, xmm9", "66 41 0f f8 c1")
	e = x64SrcHex(e, "psubb mm0, mm7", "0f f8 c7")
	e = x64SrcHex(e, "psubw xmm0, xmm9", "66 41 0f f9 c1")
	e = x64SrcHex(e, "psubw mm0, mm7", "0f f9 c7")
	e = x64SrcHex(e, "psubd xmm0, xmm9", "66 41 0f fa c1")
	e = x64SrcHex(e, "psubd mm0, mm7", "0f fa c7")
	e = x64SrcHex(e, "psubq xmm0, xmm9", "66 41 0f fb c1")
	e = x64SrcHex(e, "psubq mm0, mm7", "0f fb c7")
	e = x64SrcHex(e, "psubsb xmm0, xmm9", "66 41 0f e8 c1")
	e = x64SrcHex(e, "psubsb mm0, mm7", "0f e8 c7")
	e = x64SrcHex(e, "psubsw xmm0, xmm9", "66 41 0f e9 c1")
	e = x64SrcHex(e, "psubsw mm0, mm7", "0f e9 c7")
	e = x64SrcHex(e, "psubusb xmm0, xmm9", "66 41 0f d8 c1")
	e = x64SrcHex(e, "psubusb mm0, mm7", "0f d8 c7")
	e = x64SrcHex(e, "psubusw xmm0, xmm9", "66 41 0f d9 c1")
	e = x64SrcHex(e, "psubusw mm0, mm7", "0f d9 c7")
	e = x64SrcHex(e, "punpckhbw xmm0, xmm9", "66 41 0f 68 c1")
	e = x64SrcHex(e, "punpckhbw mm0, mm7", "0f 68 c7")
	e = x64SrcHex(e, "punpckhwd xmm0, xmm9", "66 41 0f 69 c1")
	e = x64SrcHex(e, "punpckhwd mm0, mm7", "0f 69 c7")
	e = x64SrcHex(e, "punpckhdq xmm0, xmm9", "66 41 0f 6a c1")
	e = x64SrcHex(e, "punpckhdq mm0, mm7", "0f 6a c7")
	e = x64SrcHex(e, "punpckhqdq xmm0, xmm9", "66 41 0f 6d c1")
	e = x64SrcHex(e, "punpcklbw xmm0, xmm9", "66 41 0f 60 c1")
	e = x64SrcHex(e, "punpcklbw xmm9, [rax]", "66 44 0f 60 08")
	e = x64SrcHex(e, "punpcklbw xmm0, xmmword ptr [r10]", "66 41 0f 60 02")
	e = x64SrcHex(e, "punpcklbw mm0, mm7", "0f 60 c7")
	e = x64SrcHex(e, "punpcklbw mm7, [rax]", "0f 60 38")
	e = x64SrcHex(e, "punpcklbw mm7, dword ptr [rax]", "0f 60 38")
	e = x64SrcHex(e, "punpcklwd xmm0, xmm9", "66 41 0f 61 c1")
	e = x64SrcHex(e, "punpcklwd mm0, mm7", "0f 61 c7")
	e = x64SrcHex(e, "punpckldq xmm0, xmm9", "66 41 0f 62 c1")
	e = x64SrcHex(e, "punpckldq mm0, mm7", "0f 62 c7")
	e = x64SrcHex(e, "punpcklqdq xmm0, xmm9", "66 41 0f 6c c1")
	e = x64SrcHex(e, "punpcklqdq xmm9, [rax]", "66 44 0f 6c 08")
	e = x64SrcHex(e, "punpcklqdq xmm0, xmmword ptr [r10]", "66 41 0f 6c 02")
	e = x64SrcHex(e, "pxor xmm0, xmm9", "66 41 0f ef c1")
	e = x64SrcHex(e, "pxor xmm9, [rax]", "66 44 0f ef 08")
	e = x64SrcHex(e, "pxor xmm0, xmmword ptr [r10]", "66 41 0f ef 02")
	e = x64SrcHex(e, "pxor mm0, mm7", "0f ef c7")
	e = x64SrcHex(e, "pxor mm7, [rax]", "0f ef 38")
	e = x64SrcHex(e, "pxor mm7, qword ptr [rax]", "0f ef 38")
	e = x64SrcHex(e, "pxor mm7, mmword ptr [rax]", "0f ef 38")
	return e
}

// The shifts (by a register, memory or an immediate), shuffles, pextrw / pinsrw and pmovmskb.
func TestX64SseShiftsShuffles() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "psllw xmm0, xmm9", "66 41 0f f1 c1")
	e = x64SrcHex(e, "psllw xmm9, [rax]", "66 44 0f f1 08")
	e = x64SrcHex(e, "psllw xmm0, xmmword ptr [r10]", "66 41 0f f1 02")
	e = x64SrcHex(e, "psllw xmm9, 1", "66 41 0f 71 f1 01")
	e = x64SrcHex(e, "psllw mm0, mm7", "0f f1 c7")
	e = x64SrcHex(e, "psllw mm7, [rax]", "0f f1 38")
	e = x64SrcHex(e, "psllw mm7, qword ptr [rax]", "0f f1 38")
	e = x64SrcHex(e, "psllw mm7, mmword ptr [rax]", "0f f1 38")
	e = x64SrcHex(e, "psllw mm7, 1", "0f 71 f7 01")
	e = x64SrcHex(e, "pslld xmm0, xmm9", "66 41 0f f2 c1")
	e = x64SrcHex(e, "pslld xmm9, [rax]", "66 44 0f f2 08")
	e = x64SrcHex(e, "pslld xmm0, xmmword ptr [r10]", "66 41 0f f2 02")
	e = x64SrcHex(e, "pslld xmm9, 1", "66 41 0f 72 f1 01")
	e = x64SrcHex(e, "pslld mm0, mm7", "0f f2 c7")
	e = x64SrcHex(e, "pslld mm7, [rax]", "0f f2 38")
	e = x64SrcHex(e, "pslld mm7, qword ptr [rax]", "0f f2 38")
	e = x64SrcHex(e, "pslld mm7, mmword ptr [rax]", "0f f2 38")
	e = x64SrcHex(e, "pslld mm7, 1", "0f 72 f7 01")
	e = x64SrcHex(e, "psllq xmm0, xmm9", "66 41 0f f3 c1")
	e = x64SrcHex(e, "psllq xmm9, [rax]", "66 44 0f f3 08")
	e = x64SrcHex(e, "psllq xmm0, xmmword ptr [r10]", "66 41 0f f3 02")
	e = x64SrcHex(e, "psllq xmm9, 1", "66 41 0f 73 f1 01")
	e = x64SrcHex(e, "psllq mm0, mm7", "0f f3 c7")
	e = x64SrcHex(e, "psllq mm7, [rax]", "0f f3 38")
	e = x64SrcHex(e, "psllq mm7, qword ptr [rax]", "0f f3 38")
	e = x64SrcHex(e, "psllq mm7, mmword ptr [rax]", "0f f3 38")
	e = x64SrcHex(e, "psllq mm7, 1", "0f 73 f7 01")
	e = x64SrcHex(e, "psraw xmm0, xmm9", "66 41 0f e1 c1")
	e = x64SrcHex(e, "psraw xmm9, [rax]", "66 44 0f e1 08")
	e = x64SrcHex(e, "psraw xmm0, xmmword ptr [r10]", "66 41 0f e1 02")
	e = x64SrcHex(e, "psraw xmm9, 1", "66 41 0f 71 e1 01")
	e = x64SrcHex(e, "psraw mm0, mm7", "0f e1 c7")
	e = x64SrcHex(e, "psraw mm7, [rax]", "0f e1 38")
	e = x64SrcHex(e, "psraw mm7, qword ptr [rax]", "0f e1 38")
	e = x64SrcHex(e, "psraw mm7, mmword ptr [rax]", "0f e1 38")
	e = x64SrcHex(e, "psraw mm7, 1", "0f 71 e7 01")
	e = x64SrcHex(e, "psrad xmm0, xmm9", "66 41 0f e2 c1")
	e = x64SrcHex(e, "psrad xmm9, [rax]", "66 44 0f e2 08")
	e = x64SrcHex(e, "psrad xmm0, xmmword ptr [r10]", "66 41 0f e2 02")
	e = x64SrcHex(e, "psrad xmm9, 1", "66 41 0f 72 e1 01")
	e = x64SrcHex(e, "psrad mm0, mm7", "0f e2 c7")
	e = x64SrcHex(e, "psrad mm7, [rax]", "0f e2 38")
	e = x64SrcHex(e, "psrad mm7, qword ptr [rax]", "0f e2 38")
	e = x64SrcHex(e, "psrad mm7, mmword ptr [rax]", "0f e2 38")
	e = x64SrcHex(e, "psrad mm7, 1", "0f 72 e7 01")
	e = x64SrcHex(e, "psrlw xmm0, xmm9", "66 41 0f d1 c1")
	e = x64SrcHex(e, "psrlw xmm9, [rax]", "66 44 0f d1 08")
	e = x64SrcHex(e, "psrlw xmm0, xmmword ptr [r10]", "66 41 0f d1 02")
	e = x64SrcHex(e, "psrlw xmm9, 1", "66 41 0f 71 d1 01")
	e = x64SrcHex(e, "psrlw mm0, mm7", "0f d1 c7")
	e = x64SrcHex(e, "psrlw mm7, [rax]", "0f d1 38")
	e = x64SrcHex(e, "psrlw mm7, qword ptr [rax]", "0f d1 38")
	e = x64SrcHex(e, "psrlw mm7, mmword ptr [rax]", "0f d1 38")
	e = x64SrcHex(e, "psrlw mm7, 1", "0f 71 d7 01")
	e = x64SrcHex(e, "psrld xmm0, xmm9", "66 41 0f d2 c1")
	e = x64SrcHex(e, "psrld xmm9, [rax]", "66 44 0f d2 08")
	e = x64SrcHex(e, "psrld xmm0, xmmword ptr [r10]", "66 41 0f d2 02")
	e = x64SrcHex(e, "psrld xmm9, 1", "66 41 0f 72 d1 01")
	e = x64SrcHex(e, "psrld mm0, mm7", "0f d2 c7")
	e = x64SrcHex(e, "psrld mm7, [rax]", "0f d2 38")
	e = x64SrcHex(e, "psrld mm7, qword ptr [rax]", "0f d2 38")
	e = x64SrcHex(e, "psrld mm7, mmword ptr [rax]", "0f d2 38")
	e = x64SrcHex(e, "psrld mm7, 1", "0f 72 d7 01")
	e = x64SrcHex(e, "psrlq xmm0, xmm9", "66 41 0f d3 c1")
	e = x64SrcHex(e, "psrlq xmm9, [rax]", "66 44 0f d3 08")
	e = x64SrcHex(e, "psrlq xmm0, xmmword ptr [r10]", "66 41 0f d3 02")
	e = x64SrcHex(e, "psrlq xmm9, 1", "66 41 0f 73 d1 01")
	e = x64SrcHex(e, "psrlq mm0, mm7", "0f d3 c7")
	e = x64SrcHex(e, "psrlq mm7, [rax]", "0f d3 38")
	e = x64SrcHex(e, "psrlq mm7, qword ptr [rax]", "0f d3 38")
	e = x64SrcHex(e, "psrlq mm7, mmword ptr [rax]", "0f d3 38")
	e = x64SrcHex(e, "psrlq mm7, 1", "0f 73 d7 01")
	e = x64SrcHex(e, "pslldq xmm9, 1", "66 41 0f 73 f9 01")
	e = x64SrcHex(e, "psrldq xmm9, 1", "66 41 0f 73 d9 01")
	e = x64SrcHex(e, "pshufd xmm0, xmm9, 1", "66 41 0f 70 c1 01")
	e = x64SrcHex(e, "pshufd xmm9, [rax], 1", "66 44 0f 70 08 01")
	e = x64SrcHex(e, "pshufd xmm0, xmmword ptr [r10], 1", "66 41 0f 70 02 01")
	e = x64SrcHex(e, "pshufhw xmm0, xmm9, 1", "f3 41 0f 70 c1 01")
	e = x64SrcHex(e, "pshufhw xmm9, [rax], 1", "f3 44 0f 70 08 01")
	e = x64SrcHex(e, "pshufhw xmm0, xmmword ptr [r10], 1", "f3 41 0f 70 02 01")
	e = x64SrcHex(e, "pshuflw xmm0, xmm9, 1", "f2 41 0f 70 c1 01")
	e = x64SrcHex(e, "pshuflw xmm9, [rax], 1", "f2 44 0f 70 08 01")
	e = x64SrcHex(e, "pshuflw xmm0, xmmword ptr [r10], 1", "f2 41 0f 70 02 01")
	e = x64SrcHex(e, "pshufw mm0, mm7, 1", "0f 70 c7 01")
	e = x64SrcHex(e, "pshufw mm7, [rax], 1", "0f 70 38 01")
	e = x64SrcHex(e, "pshufw mm7, qword ptr [rax], 1", "0f 70 38 01")
	e = x64SrcHex(e, "pshufw mm7, mmword ptr [rax], 1", "0f 70 38 01")
	e = x64SrcHex(e, "pextrw eax, xmm9, 1", "66 41 0f c5 c1 01")
	e = x64SrcHex(e, "pextrw eax, mm7, 1", "0f c5 c7 01")
	e = x64SrcHex(e, "pextrw rax, xmm9, 1", "66 41 0f c5 c1 01")
	e = x64SrcHex(e, "pextrw rax, mm7, 1", "0f c5 c7 01")
	e = x64SrcHex(e, "pextrw [rax], xmm9, 1", "66 44 0f 3a 15 08 01")
	e = x64SrcHex(e, "pextrw word ptr [rax], xmm9, 1", "66 44 0f 3a 15 08 01")
	e = x64SrcHex(e, "pinsrw xmm0, r9d, 1", "66 41 0f c4 c1 01")
	e = x64SrcHex(e, "pinsrw xmm0, r9, 1", "66 41 0f c4 c1 01")
	e = x64SrcHex(e, "pinsrw xmm9, [rax], 1", "66 44 0f c4 08 01")
	e = x64SrcHex(e, "pinsrw xmm9, word ptr [rax], 1", "66 44 0f c4 08 01")
	e = x64SrcHex(e, "pinsrw mm0, r9d, 1", "41 0f c4 c1 01")
	e = x64SrcHex(e, "pinsrw mm0, r9, 1", "41 0f c4 c1 01")
	e = x64SrcHex(e, "pinsrw mm7, [rax], 1", "0f c4 38 01")
	e = x64SrcHex(e, "pinsrw mm7, word ptr [rax], 1", "0f c4 38 01")
	e = x64SrcHex(e, "pmovmskb eax, xmm9", "66 41 0f d7 c1")
	e = x64SrcHex(e, "pmovmskb eax, mm7", "0f d7 c7")
	e = x64SrcHex(e, "pmovmskb rax, xmm9", "66 41 0f d7 c1")
	e = x64SrcHex(e, "pmovmskb rax, mm7", "0f d7 c7")
	return e
}

// movd, movq and the other moves, their stores and `.s` forms; the MMX conversions.
func TestX64SseIntMoves() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "movd xmm0, r9d", "66 41 0f 6e c1")
	e = x64SrcHex(e, "movd xmm0, r9", "66 49 0f 6e c1")
	e = x64SrcHex(e, "movd xmm9, [rax]", "66 44 0f 6e 08")
	e = x64SrcHex(e, "movd xmm9, dword ptr [rax]", "66 44 0f 6e 08")
	e = x64SrcHex(e, "movd mm0, r9d", "41 0f 6e c1")
	e = x64SrcHex(e, "movd mm0, r9", "49 0f 6e c1")
	e = x64SrcHex(e, "movd mm7, [rax]", "0f 6e 38")
	e = x64SrcHex(e, "movd mm7, dword ptr [rax]", "0f 6e 38")
	e = x64SrcHex(e, "movd eax, xmm9", "66 44 0f 7e c8")
	e = x64SrcHex(e, "movd eax, mm7", "0f 7e f8")
	e = x64SrcHex(e, "movd rax, xmm9", "66 4c 0f 7e c8")
	e = x64SrcHex(e, "movd rax, mm7", "48 0f 7e f8")
	e = x64SrcHex(e, "movd [rax], xmm9", "66 44 0f 7e 08")
	e = x64SrcHex(e, "movd [rax], mm7", "0f 7e 38")
	e = x64SrcHex(e, "movd dword ptr [rax], xmm9", "66 44 0f 7e 08")
	e = x64SrcHex(e, "movd dword ptr [rax], mm7", "0f 7e 38")
	e = x64SrcHex(e, "movq xmm0, xmm9", "f3 41 0f 7e c1")
	e = x64SrcHex(e, "movq xmm0, r9", "66 49 0f 6e c1")
	e = x64SrcHex(e, "movq xmm9, [rax]", "f3 44 0f 7e 08")
	e = x64SrcHex(e, "movq xmm9, qword ptr [rax]", "f3 44 0f 7e 08")
	e = x64SrcHex(e, "movq xmm9, mmword ptr [rax]", "f3 44 0f 7e 08")
	e = x64SrcHex(e, "movq mm0, mm7", "0f 6f c7")
	e = x64SrcHex(e, "movq mm0, r9", "49 0f 6e c1")
	e = x64SrcHex(e, "movq mm7, [rax]", "0f 6f 38")
	e = x64SrcHex(e, "movq mm7, qword ptr [rax]", "0f 6f 38")
	e = x64SrcHex(e, "movq mm7, mmword ptr [rax]", "0f 6f 38")
	e = x64SrcHex(e, "movq rax, xmm9", "66 4c 0f 7e c8")
	e = x64SrcHex(e, "movq rax, mm7", "48 0f 7e f8")
	e = x64SrcHex(e, "movq [rax], xmm9", "66 44 0f d6 08")
	e = x64SrcHex(e, "movq [rax], mm7", "0f 7f 38")
	e = x64SrcHex(e, "movq qword ptr [rax], xmm9", "66 44 0f d6 08")
	e = x64SrcHex(e, "movq qword ptr [rax], mm7", "0f 7f 38")
	e = x64SrcHex(e, "movq mmword ptr [rax], xmm9", "66 44 0f d6 08")
	e = x64SrcHex(e, "movq mmword ptr [rax], mm7", "0f 7f 38")
	e = x64SrcHex(e, "movq.s xmm0, xmm9", "66 44 0f d6 c8")
	e = x64SrcHex(e, "movq.s mm0, mm7", "0f 7f f8")
	e = x64SrcHex(e, "movdqa xmm0, xmm9", "66 41 0f 6f c1")
	e = x64SrcHex(e, "movdqa xmm9, [rax]", "66 44 0f 6f 08")
	e = x64SrcHex(e, "movdqa xmm0, xmmword ptr [r10]", "66 41 0f 6f 02")
	e = x64SrcHex(e, "movdqa [rax], xmm9", "66 44 0f 7f 08")
	e = x64SrcHex(e, "movdqa xmmword ptr [r10], xmm0", "66 41 0f 7f 02")
	e = x64SrcHex(e, "movdqa.s xmm0, xmm9", "66 44 0f 7f c8")
	e = x64SrcHex(e, "movdqu xmm0, xmm9", "f3 41 0f 6f c1")
	e = x64SrcHex(e, "movdqu xmm9, [rax]", "f3 44 0f 6f 08")
	e = x64SrcHex(e, "movdqu xmm0, xmmword ptr [r10]", "f3 41 0f 6f 02")
	e = x64SrcHex(e, "movdqu [rax], xmm9", "f3 44 0f 7f 08")
	e = x64SrcHex(e, "movdqu xmmword ptr [r10], xmm0", "f3 41 0f 7f 02")
	e = x64SrcHex(e, "movdqu.s xmm0, xmm9", "f3 44 0f 7f c8")
	e = x64SrcHex(e, "movntdq [rax], xmm9", "66 44 0f e7 08")
	e = x64SrcHex(e, "movntdq xmmword ptr [r10], xmm0", "66 41 0f e7 02")
	e = x64SrcHex(e, "movntq [rax], mm7", "0f e7 38")
	e = x64SrcHex(e, "movntq qword ptr [rax], mm7", "0f e7 38")
	e = x64SrcHex(e, "movntq mmword ptr [rax], mm7", "0f e7 38")
	e = x64SrcHex(e, "maskmovdqu xmm0, xmm9", "66 41 0f f7 c1")
	e = x64SrcHex(e, "maskmovq mm0, mm7", "0f f7 c7")
	e = x64SrcHex(e, "movq2dq xmm0, mm7", "f3 0f d6 c7")
	e = x64SrcHex(e, "movdq2q mm0, xmm9", "f2 41 0f d6 c1")
	e = x64SrcHex(e, "cvtpi2ps xmm0, mm7", "0f 2a c7")
	e = x64SrcHex(e, "cvtpi2ps xmm9, [rax]", "44 0f 2a 08")
	e = x64SrcHex(e, "cvtpi2ps xmm9, qword ptr [rax]", "44 0f 2a 08")
	e = x64SrcHex(e, "cvtpi2ps xmm9, mmword ptr [rax]", "44 0f 2a 08")
	e = x64SrcHex(e, "cvtps2pi mm0, xmm9", "41 0f 2d c1")
	e = x64SrcHex(e, "cvtps2pi mm7, [rax]", "0f 2d 38")
	e = x64SrcHex(e, "cvtps2pi mm7, qword ptr [rax]", "0f 2d 38")
	e = x64SrcHex(e, "cvtps2pi mm7, mmword ptr [rax]", "0f 2d 38")
	e = x64SrcHex(e, "cvttps2pi mm0, xmm9", "41 0f 2c c1")
	e = x64SrcHex(e, "cvttps2pi mm7, [rax]", "0f 2c 38")
	e = x64SrcHex(e, "cvttps2pi mm7, qword ptr [rax]", "0f 2c 38")
	e = x64SrcHex(e, "cvttps2pi mm7, mmword ptr [rax]", "0f 2c 38")
	e = x64SrcHex(e, "cvtpi2pd xmm0, mm7", "66 0f 2a c7")
	e = x64SrcHex(e, "cvtpi2pd xmm9, [rax]", "66 44 0f 2a 08")
	e = x64SrcHex(e, "cvtpi2pd xmm9, qword ptr [rax]", "66 44 0f 2a 08")
	e = x64SrcHex(e, "cvtpi2pd xmm9, mmword ptr [rax]", "66 44 0f 2a 08")
	e = x64SrcHex(e, "cvtpd2pi mm0, xmm9", "66 41 0f 2d c1")
	e = x64SrcHex(e, "cvtpd2pi mm7, [rax]", "66 0f 2d 38")
	e = x64SrcHex(e, "cvtpd2pi mm0, xmmword ptr [r10]", "66 41 0f 2d 02")
	e = x64SrcHex(e, "cvttpd2pi mm0, xmm9", "66 41 0f 2c c1")
	e = x64SrcHex(e, "cvttpd2pi mm7, [rax]", "66 0f 2c 38")
	e = x64SrcHex(e, "cvttpd2pi mm0, xmmword ptr [r10]", "66 41 0f 2c 02")
	return e
}

// The register names mm0 .. mm7 in any case, and emms; what clang rejects: mm8, mm00 (a symbol's
// name, so memory) as the destination, an MMX register in a general-purpose or x87 instruction or
// as a base, punpcklbw's 64-bit memory with MMX and punpckhbw's 32-bit, movd's 64-bit memory,
// movq's 32-bit register; and a lock, repeat or data16 prefix (GNU as), which emms and the string
// movsd take.
func TestX64SseMmx() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "PADDB MM7, Mm0", "0f fc f8")
	e = x64SrcHex(e, "emms", "0f 77")
	e = x64SrcHex(e, "data16 emms", "66 0f 77")
	e = x64SrcHex(e, "data16 movsd", "66 a5")
	e = x64LineErrorHas(e, "data16 paddb mm0, mm1",
			"data16 cannot stand before an SSE or MMX instruction")
	e = x64LineRejected(e, "data16 addps xmm0, xmm1")
	e = x64LineRejected(e, "data16 movsd xmm0, xmm1")
	e = x64LineRejected(e, "data16 cvtsi2sd xmm0, eax")
	e = x64LineRejected(e, "emms mm0")
	e = x64LineRejected(e, "paddb mm8, mm0")
	e = x64LineRejected(e, "paddb mm00, mm0")
	e = x64LineRejected(e, "add rax, mm0")
	e = x64LineRejected(e, "mov mm0, rax")
	e = x64LineRejected(e, "push mm0")
	e = x64LineRejected(e, "fld mm0")
	e = x64LineErrorHas(e, "mov rax, qword ptr [mm0]", "is not a base or index register")
	e = x64LineRejected(e, "punpcklbw mm0, qword ptr [rax]")
	e = x64LineRejected(e, "punpckhbw mm0, dword ptr [rax]")
	e = x64LineRejected(e, "movd xmm0, qword ptr [rax]")
	e = x64LineRejected(e, "movq xmm0, eax")
	e = x64LineRejected(e, "movq rax, rbx")
	e = x64LineRejected(e, "pextrw word ptr [rax], mm0, 1")
	e = x64LineRejected(e, "pslldq mm0, 1")
	e = x64LineRejected(e, "paddb mm0, xmm1")
	e = x64LineRejected(e, "lock movq qword ptr [rax], mm0")
	e = x64LineRejected(e, "rep movd eax, mm0")
	return e
}
