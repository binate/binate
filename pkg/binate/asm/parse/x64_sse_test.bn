package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/builtins/testing"

// The SSE instructions (x64_sse.bn) against clang's bytes and relocations (`clang
// --target=x86_64-linux-gnu -c`, `.intel_syntax noprefix`): each encoding form of the SSE / SSE2
// floating-point instructions with registers 0..7 and 8..15, memory sized and unsized; the
// encodings in full are package sse's tests, these the parsing.  (x64SrcHex and x64LineRejected
// are in x64_target_test.bn, x64TlsCase in x64_tls_test.bn, x64LineErrorHas in x64_prefix_test.bn.)

// The arithmetic, logic, compares and conversions.
func TestX64SseFp() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "addps xmm0, xmm1", "0f 58 c1")
	e = x64SrcHex(e, "addps xmm9, xmm9", "45 0f 58 c9")
	e = x64SrcHex(e, "addpd xmm0, xmm1", "66 0f 58 c1")
	e = x64SrcHex(e, "addpd xmm9, xmm9", "66 45 0f 58 c9")
	e = x64SrcHex(e, "addss xmm0, xmm1", "f3 0f 58 c1")
	e = x64SrcHex(e, "addss xmm9, xmm9", "f3 45 0f 58 c9")
	e = x64SrcHex(e, "addsd xmm0, xmm1", "f2 0f 58 c1")
	e = x64SrcHex(e, "addsd xmm9, xmm9", "f2 45 0f 58 c9")
	e = x64SrcHex(e, "mulps xmm0, xmm1", "0f 59 c1")
	e = x64SrcHex(e, "mulps xmm9, xmm9", "45 0f 59 c9")
	e = x64SrcHex(e, "mulpd xmm0, xmm1", "66 0f 59 c1")
	e = x64SrcHex(e, "mulpd xmm9, xmm9", "66 45 0f 59 c9")
	e = x64SrcHex(e, "mulss xmm0, xmm1", "f3 0f 59 c1")
	e = x64SrcHex(e, "mulss xmm9, xmm9", "f3 45 0f 59 c9")
	e = x64SrcHex(e, "mulsd xmm0, xmm1", "f2 0f 59 c1")
	e = x64SrcHex(e, "mulsd xmm9, xmm9", "f2 45 0f 59 c9")
	e = x64SrcHex(e, "subps xmm0, xmm1", "0f 5c c1")
	e = x64SrcHex(e, "subps xmm9, xmm9", "45 0f 5c c9")
	e = x64SrcHex(e, "subpd xmm0, xmm1", "66 0f 5c c1")
	e = x64SrcHex(e, "subpd xmm9, xmm9", "66 45 0f 5c c9")
	e = x64SrcHex(e, "subss xmm0, xmm1", "f3 0f 5c c1")
	e = x64SrcHex(e, "subss xmm9, xmm9", "f3 45 0f 5c c9")
	e = x64SrcHex(e, "subsd xmm0, xmm1", "f2 0f 5c c1")
	e = x64SrcHex(e, "subsd xmm9, xmm9", "f2 45 0f 5c c9")
	e = x64SrcHex(e, "minps xmm0, xmm1", "0f 5d c1")
	e = x64SrcHex(e, "minps xmm9, xmm9", "45 0f 5d c9")
	e = x64SrcHex(e, "minpd xmm0, xmm1", "66 0f 5d c1")
	e = x64SrcHex(e, "minpd xmm9, xmm9", "66 45 0f 5d c9")
	e = x64SrcHex(e, "minss xmm0, xmm1", "f3 0f 5d c1")
	e = x64SrcHex(e, "minss xmm9, xmm9", "f3 45 0f 5d c9")
	e = x64SrcHex(e, "minsd xmm0, xmm1", "f2 0f 5d c1")
	e = x64SrcHex(e, "minsd xmm9, xmm9", "f2 45 0f 5d c9")
	e = x64SrcHex(e, "divps xmm0, xmm1", "0f 5e c1")
	e = x64SrcHex(e, "divps xmm9, xmm9", "45 0f 5e c9")
	e = x64SrcHex(e, "divpd xmm0, xmm1", "66 0f 5e c1")
	e = x64SrcHex(e, "divpd xmm9, xmm9", "66 45 0f 5e c9")
	e = x64SrcHex(e, "divss xmm0, xmm1", "f3 0f 5e c1")
	e = x64SrcHex(e, "divss xmm9, xmm9", "f3 45 0f 5e c9")
	e = x64SrcHex(e, "divsd xmm0, xmm1", "f2 0f 5e c1")
	e = x64SrcHex(e, "divsd xmm9, xmm9", "f2 45 0f 5e c9")
	e = x64SrcHex(e, "maxps xmm0, xmm1", "0f 5f c1")
	e = x64SrcHex(e, "maxps xmm9, xmm9", "45 0f 5f c9")
	e = x64SrcHex(e, "maxpd xmm0, xmm1", "66 0f 5f c1")
	e = x64SrcHex(e, "maxpd xmm9, xmm9", "66 45 0f 5f c9")
	e = x64SrcHex(e, "maxss xmm0, xmm1", "f3 0f 5f c1")
	e = x64SrcHex(e, "maxss xmm9, xmm9", "f3 45 0f 5f c9")
	e = x64SrcHex(e, "maxsd xmm0, xmm1", "f2 0f 5f c1")
	e = x64SrcHex(e, "maxsd xmm9, xmm9", "f2 45 0f 5f c9")
	e = x64SrcHex(e, "sqrtps xmm0, xmm1", "0f 51 c1")
	e = x64SrcHex(e, "sqrtps xmm9, xmm9", "45 0f 51 c9")
	e = x64SrcHex(e, "sqrtpd xmm0, xmm1", "66 0f 51 c1")
	e = x64SrcHex(e, "sqrtpd xmm9, xmm9", "66 45 0f 51 c9")
	e = x64SrcHex(e, "sqrtss xmm0, xmm1", "f3 0f 51 c1")
	e = x64SrcHex(e, "sqrtss xmm9, xmm9", "f3 45 0f 51 c9")
	e = x64SrcHex(e, "sqrtsd xmm0, xmm1", "f2 0f 51 c1")
	e = x64SrcHex(e, "sqrtsd xmm9, xmm9", "f2 45 0f 51 c9")
	e = x64SrcHex(e, "rcpps xmm0, xmm1", "0f 53 c1")
	e = x64SrcHex(e, "rcpps xmm9, xmm9", "45 0f 53 c9")
	e = x64SrcHex(e, "rcpss xmm0, xmm1", "f3 0f 53 c1")
	e = x64SrcHex(e, "rcpss xmm9, xmm9", "f3 45 0f 53 c9")
	e = x64SrcHex(e, "rsqrtps xmm0, xmm1", "0f 52 c1")
	e = x64SrcHex(e, "rsqrtps xmm9, xmm9", "45 0f 52 c9")
	e = x64SrcHex(e, "rsqrtss xmm0, xmm1", "f3 0f 52 c1")
	e = x64SrcHex(e, "rsqrtss xmm9, xmm9", "f3 45 0f 52 c9")
	e = x64SrcHex(e, "andps xmm0, xmm1", "0f 54 c1")
	e = x64SrcHex(e, "andps xmm9, xmm9", "45 0f 54 c9")
	e = x64SrcHex(e, "andpd xmm0, xmm1", "66 0f 54 c1")
	e = x64SrcHex(e, "andpd xmm9, xmm9", "66 45 0f 54 c9")
	e = x64SrcHex(e, "andnps xmm0, xmm1", "0f 55 c1")
	e = x64SrcHex(e, "andnps xmm9, xmm9", "45 0f 55 c9")
	e = x64SrcHex(e, "andnpd xmm0, xmm1", "66 0f 55 c1")
	e = x64SrcHex(e, "andnpd xmm9, xmm9", "66 45 0f 55 c9")
	e = x64SrcHex(e, "orps xmm0, xmm1", "0f 56 c1")
	e = x64SrcHex(e, "orps xmm9, xmm9", "45 0f 56 c9")
	e = x64SrcHex(e, "orpd xmm0, xmm1", "66 0f 56 c1")
	e = x64SrcHex(e, "orpd xmm9, xmm9", "66 45 0f 56 c9")
	e = x64SrcHex(e, "xorps xmm0, xmm1", "0f 57 c1")
	e = x64SrcHex(e, "xorps xmm9, xmm9", "45 0f 57 c9")
	e = x64SrcHex(e, "xorpd xmm0, xmm1", "66 0f 57 c1")
	e = x64SrcHex(e, "xorpd xmm9, xmm9", "66 45 0f 57 c9")
	e = x64SrcHex(e, "cmpps xmm0, xmm1, 5", "0f c2 c1 05")
	e = x64SrcHex(e, "cmpps xmm9, xmm9, 5", "45 0f c2 c9 05")
	e = x64SrcHex(e, "cmppd xmm0, xmm1, 5", "66 0f c2 c1 05")
	e = x64SrcHex(e, "cmppd xmm9, xmm9, 5", "66 45 0f c2 c9 05")
	e = x64SrcHex(e, "cmpss xmm0, xmm1, 5", "f3 0f c2 c1 05")
	e = x64SrcHex(e, "cmpss xmm9, xmm9, 5", "f3 45 0f c2 c9 05")
	e = x64SrcHex(e, "cmpsd xmm0, xmm1, 5", "f2 0f c2 c1 05")
	e = x64SrcHex(e, "cmpsd xmm9, xmm9, 5", "f2 45 0f c2 c9 05")
	e = x64SrcHex(e, "comiss xmm0, xmm1", "0f 2f c1")
	e = x64SrcHex(e, "comiss xmm9, xmm9", "45 0f 2f c9")
	e = x64SrcHex(e, "comisd xmm0, xmm1", "66 0f 2f c1")
	e = x64SrcHex(e, "comisd xmm9, xmm9", "66 45 0f 2f c9")
	e = x64SrcHex(e, "ucomiss xmm0, xmm1", "0f 2e c1")
	e = x64SrcHex(e, "ucomiss xmm9, xmm9", "45 0f 2e c9")
	e = x64SrcHex(e, "ucomisd xmm0, xmm1", "66 0f 2e c1")
	e = x64SrcHex(e, "ucomisd xmm9, xmm9", "66 45 0f 2e c9")
	e = x64SrcHex(e, "cvtsi2ss xmm0, eax", "f3 0f 2a c0")
	e = x64SrcHex(e, "cvtsi2ss xmm9, r9", "f3 4d 0f 2a c9")
	e = x64SrcHex(e, "cvtsi2sd xmm0, eax", "f2 0f 2a c0")
	e = x64SrcHex(e, "cvtsi2sd xmm9, r9", "f2 4d 0f 2a c9")
	e = x64SrcHex(e, "cvtss2si eax, xmm1", "f3 0f 2d c1")
	e = x64SrcHex(e, "cvtss2si r9, xmm9", "f3 4d 0f 2d c9")
	return e
}

// The moves, shuffles and unpacks, the `.s` forms.
func TestX64SseFpMoves() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "cvtsd2si eax, xmm1", "f2 0f 2d c1")
	e = x64SrcHex(e, "cvtsd2si r9, xmm9", "f2 4d 0f 2d c9")
	e = x64SrcHex(e, "cvttss2si eax, xmm1", "f3 0f 2c c1")
	e = x64SrcHex(e, "cvttss2si r9, xmm9", "f3 4d 0f 2c c9")
	e = x64SrcHex(e, "cvttsd2si eax, xmm1", "f2 0f 2c c1")
	e = x64SrcHex(e, "cvttsd2si r9, xmm9", "f2 4d 0f 2c c9")
	e = x64SrcHex(e, "cvtss2sd xmm0, xmm1", "f3 0f 5a c1")
	e = x64SrcHex(e, "cvtss2sd xmm9, xmm9", "f3 45 0f 5a c9")
	e = x64SrcHex(e, "cvtsd2ss xmm0, xmm1", "f2 0f 5a c1")
	e = x64SrcHex(e, "cvtsd2ss xmm9, xmm9", "f2 45 0f 5a c9")
	e = x64SrcHex(e, "cvtps2pd xmm0, xmm1", "0f 5a c1")
	e = x64SrcHex(e, "cvtps2pd xmm9, xmm9", "45 0f 5a c9")
	e = x64SrcHex(e, "cvtpd2ps xmm0, xmm1", "66 0f 5a c1")
	e = x64SrcHex(e, "cvtpd2ps xmm9, xmm9", "66 45 0f 5a c9")
	e = x64SrcHex(e, "cvtdq2ps xmm0, xmm1", "0f 5b c1")
	e = x64SrcHex(e, "cvtdq2ps xmm9, xmm9", "45 0f 5b c9")
	e = x64SrcHex(e, "cvtps2dq xmm0, xmm1", "66 0f 5b c1")
	e = x64SrcHex(e, "cvtps2dq xmm9, xmm9", "66 45 0f 5b c9")
	e = x64SrcHex(e, "cvttps2dq xmm0, xmm1", "f3 0f 5b c1")
	e = x64SrcHex(e, "cvttps2dq xmm9, xmm9", "f3 45 0f 5b c9")
	e = x64SrcHex(e, "cvtdq2pd xmm0, xmm1", "f3 0f e6 c1")
	e = x64SrcHex(e, "cvtdq2pd xmm9, xmm9", "f3 45 0f e6 c9")
	e = x64SrcHex(e, "cvtpd2dq xmm0, xmm1", "f2 0f e6 c1")
	e = x64SrcHex(e, "cvtpd2dq xmm9, xmm9", "f2 45 0f e6 c9")
	e = x64SrcHex(e, "cvttpd2dq xmm0, xmm1", "66 0f e6 c1")
	e = x64SrcHex(e, "cvttpd2dq xmm9, xmm9", "66 45 0f e6 c9")
	e = x64SrcHex(e, "movaps xmm0, xmm1", "0f 28 c1")
	e = x64SrcHex(e, "movaps xmm9, xmm9", "45 0f 28 c9")
	e = x64SrcHex(e, "movaps xmmword ptr [rax], xmm0", "0f 29 00")
	e = x64SrcHex(e, "movaps xmmword ptr [r10], xmm9", "45 0f 29 0a")
	e = x64SrcHex(e, "movaps.s xmm1, xmm0", "0f 29 c1")
	e = x64SrcHex(e, "movaps.s xmm9, xmm9", "45 0f 29 c9")
	e = x64SrcHex(e, "movapd xmm0, xmm1", "66 0f 28 c1")
	e = x64SrcHex(e, "movapd xmm9, xmm9", "66 45 0f 28 c9")
	e = x64SrcHex(e, "movapd xmmword ptr [rax], xmm0", "66 0f 29 00")
	e = x64SrcHex(e, "movapd xmmword ptr [r10], xmm9", "66 45 0f 29 0a")
	e = x64SrcHex(e, "movapd.s xmm1, xmm0", "66 0f 29 c1")
	e = x64SrcHex(e, "movapd.s xmm9, xmm9", "66 45 0f 29 c9")
	e = x64SrcHex(e, "movups xmm0, xmm1", "0f 10 c1")
	e = x64SrcHex(e, "movups xmm9, xmm9", "45 0f 10 c9")
	e = x64SrcHex(e, "movups xmmword ptr [rax], xmm0", "0f 11 00")
	e = x64SrcHex(e, "movups xmmword ptr [r10], xmm9", "45 0f 11 0a")
	e = x64SrcHex(e, "movups.s xmm1, xmm0", "0f 11 c1")
	e = x64SrcHex(e, "movups.s xmm9, xmm9", "45 0f 11 c9")
	e = x64SrcHex(e, "movupd xmm0, xmm1", "66 0f 10 c1")
	e = x64SrcHex(e, "movupd xmm9, xmm9", "66 45 0f 10 c9")
	e = x64SrcHex(e, "movupd xmmword ptr [rax], xmm0", "66 0f 11 00")
	e = x64SrcHex(e, "movupd xmmword ptr [r10], xmm9", "66 45 0f 11 0a")
	e = x64SrcHex(e, "movupd.s xmm1, xmm0", "66 0f 11 c1")
	e = x64SrcHex(e, "movupd.s xmm9, xmm9", "66 45 0f 11 c9")
	e = x64SrcHex(e, "movss xmm0, xmm1", "f3 0f 10 c1")
	e = x64SrcHex(e, "movss xmm9, xmm9", "f3 45 0f 10 c9")
	e = x64SrcHex(e, "movss dword ptr [rax], xmm0", "f3 0f 11 00")
	e = x64SrcHex(e, "movss dword ptr [r10], xmm9", "f3 45 0f 11 0a")
	e = x64SrcHex(e, "movss.s xmm1, xmm0", "f3 0f 11 c1")
	e = x64SrcHex(e, "movss.s xmm9, xmm9", "f3 45 0f 11 c9")
	e = x64SrcHex(e, "movsd xmm0, xmm1", "f2 0f 10 c1")
	e = x64SrcHex(e, "movsd xmm9, xmm9", "f2 45 0f 10 c9")
	e = x64SrcHex(e, "movsd qword ptr [rax], xmm0", "f2 0f 11 00")
	e = x64SrcHex(e, "movsd qword ptr [r10], xmm9", "f2 45 0f 11 0a")
	e = x64SrcHex(e, "movsd.s xmm1, xmm0", "f2 0f 11 c1")
	e = x64SrcHex(e, "movsd.s xmm9, xmm9", "f2 45 0f 11 c9")
	e = x64SrcHex(e, "movlps xmm0, qword ptr [rax]", "0f 12 00")
	e = x64SrcHex(e, "movlps xmm9, qword ptr [r10]", "45 0f 12 0a")
	e = x64SrcHex(e, "movlps qword ptr [rax], xmm0", "0f 13 00")
	e = x64SrcHex(e, "movlps qword ptr [r10], xmm9", "45 0f 13 0a")
	e = x64SrcHex(e, "movhps xmm0, qword ptr [rax]", "0f 16 00")
	e = x64SrcHex(e, "movhps xmm9, qword ptr [r10]", "45 0f 16 0a")
	e = x64SrcHex(e, "movhps qword ptr [rax], xmm0", "0f 17 00")
	e = x64SrcHex(e, "movhps qword ptr [r10], xmm9", "45 0f 17 0a")
	e = x64SrcHex(e, "movlpd xmm0, qword ptr [rax]", "66 0f 12 00")
	e = x64SrcHex(e, "movlpd xmm9, qword ptr [r10]", "66 45 0f 12 0a")
	e = x64SrcHex(e, "movlpd qword ptr [rax], xmm0", "66 0f 13 00")
	e = x64SrcHex(e, "movlpd qword ptr [r10], xmm9", "66 45 0f 13 0a")
	e = x64SrcHex(e, "movhpd xmm0, qword ptr [rax]", "66 0f 16 00")
	e = x64SrcHex(e, "movhpd xmm9, qword ptr [r10]", "66 45 0f 16 0a")
	e = x64SrcHex(e, "movhpd qword ptr [rax], xmm0", "66 0f 17 00")
	e = x64SrcHex(e, "movhpd qword ptr [r10], xmm9", "66 45 0f 17 0a")
	e = x64SrcHex(e, "movhlps xmm0, xmm1", "0f 12 c1")
	e = x64SrcHex(e, "movhlps xmm9, xmm9", "45 0f 12 c9")
	e = x64SrcHex(e, "movlhps xmm0, xmm1", "0f 16 c1")
	e = x64SrcHex(e, "movlhps xmm9, xmm9", "45 0f 16 c9")
	e = x64SrcHex(e, "movmskps eax, xmm1", "0f 50 c1")
	e = x64SrcHex(e, "movmskps r9d, xmm9", "45 0f 50 c9")
	e = x64SrcHex(e, "movmskpd eax, xmm1", "66 0f 50 c1")
	e = x64SrcHex(e, "movmskpd r9d, xmm9", "66 45 0f 50 c9")
	e = x64SrcHex(e, "movntps xmmword ptr [rax], xmm0", "0f 2b 00")
	e = x64SrcHex(e, "movntps xmmword ptr [r10], xmm9", "45 0f 2b 0a")
	e = x64SrcHex(e, "movntpd xmmword ptr [rax], xmm0", "66 0f 2b 00")
	e = x64SrcHex(e, "movntpd xmmword ptr [r10], xmm9", "66 45 0f 2b 0a")
	e = x64SrcHex(e, "shufps xmm0, xmm1, 5", "0f c6 c1 05")
	e = x64SrcHex(e, "shufps xmm9, xmm9, 5", "45 0f c6 c9 05")
	e = x64SrcHex(e, "shufpd xmm0, xmm1, 5", "66 0f c6 c1 05")
	e = x64SrcHex(e, "shufpd xmm9, xmm9, 5", "66 45 0f c6 c9 05")
	e = x64SrcHex(e, "unpcklps xmm0, xmm1", "0f 14 c1")
	e = x64SrcHex(e, "unpcklps xmm9, xmm9", "45 0f 14 c9")
	e = x64SrcHex(e, "unpckhps xmm0, xmm1", "0f 15 c1")
	e = x64SrcHex(e, "unpckhps xmm9, xmm9", "45 0f 15 c9")
	e = x64SrcHex(e, "unpcklpd xmm0, xmm1", "66 0f 14 c1")
	e = x64SrcHex(e, "unpcklpd xmm9, xmm9", "66 45 0f 14 c9")
	e = x64SrcHex(e, "unpckhpd xmm0, xmm1", "66 0f 15 c1")
	e = x64SrcHex(e, "unpckhpd xmm9, xmm9", "66 45 0f 15 c9")
	return e
}

// The register names xmm0 .. xmm15, in any case; the compare predicates' names; movsd and cmpsd
// the SSE ones with an XMM register, the string ones without; a segment override, rip, {rex}.
func TestX64SseNames() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "ADDPS XMM15, Xmm8", "45 0f 58 f8")
	e = x64SrcHex(e, "cmpeqps xmm0, xmm1", "0f c2 c1 00")
	e = x64SrcHex(e, "cmpnltsd xmm9, qword ptr [rax]", "f2 44 0f c2 08 05")
	e = x64SrcHex(e, "cmpeq_oqps xmm0, xmm1", "0f c2 c1 00")
	e = x64SrcHex(e, "cmplt_osss xmm0, xmm1", "f3 0f c2 c1 01")
	e = x64SrcHex(e, "cmple_ospd xmm0, xmm1", "66 0f c2 c1 02")
	e = x64SrcHex(e, "cmpunord_qsd xmm0, xmm1", "f2 0f c2 c1 03")
	e = x64SrcHex(e, "cmpneq_uqps xmm0, xmm1", "0f c2 c1 04")
	e = x64SrcHex(e, "cmpnlt_usss xmm0, xmm1", "f3 0f c2 c1 05")
	e = x64SrcHex(e, "cmpnle_uspd xmm0, xmm1", "66 0f c2 c1 06")
	e = x64SrcHex(e, "CMPORD_QSD xmm0, qword ptr [rax]", "f2 0f c2 00 07")
	e = x64SrcHex(e, "rep movsd", "f3 a5")
	e = x64SrcHex(e, "repne cmpsd", "f2 a7")
	e = x64SrcHex(e, "movsd xmm0, xmm1", "f2 0f 10 c1")
	e = x64SrcHex(e, "movsd qword ptr [rax], xmm9", "f2 44 0f 11 08")
	e = x64SrcHex(e, "movsd", "a5")
	e = x64SrcHex(e, "movsd dword ptr [rdi], dword ptr [rsi]", "a5")
	e = x64SrcHex(e, "cmpsd xmm0, xmm1, 7", "f2 0f c2 c1 07")
	e = x64SrcHex(e, "cmpsd", "a7")
	e = x64SrcHex(e, "addpd xmm0, xmmword ptr fs:[rax]", "64 66 0f 58 00")
	e = x64SrcHex(e, "{rex} addps xmm0, xmm1", "40 0f 58 c1")
	e = x64SrcHex(e, "{disp8} movaps xmm0, xmmword ptr [rbx]", "0f 28 43 00")
	e = x64TlsCase(e, "addps xmm0, xmmword ptr [rip + x]", "0f 58 05 00 00 00 00", x64.FIX_REL32_LEA,
			3, 0)
	e = x64TlsCase(e, "cmpps xmm0, xmmword ptr [rip + x], 1", "0f c2 05 00 00 00 00 01",
			x64.FIX_REL32_LEA, 3, -1)
	return e
}

// What clang rejects: memory of another size, a register where memory goes and the other way,
// three operands, an immediate past 8 bits, cvtsi2ss's unsized memory, xmm16, xmm01 (a symbol's
// name, so memory) as the destination, an XMM register in a general-purpose instruction, the
// predicates clang lacks; and a lock or repeat prefix (GNU as), movsd's and cmpsd's among them.
func TestX64SseRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "addps xmm0, qword ptr [rax]")
	e = x64LineRejected(e, "addss xmm0, qword ptr [rax]")
	e = x64LineRejected(e, "addsd xmm0, dword ptr [rax]")
	e = x64LineRejected(e, "movlps xmm0, xmm1")
	e = x64LineRejected(e, "movhlps xmm0, [rax]")
	e = x64LineRejected(e, "movntps xmm0, xmm1")
	e = x64LineRejected(e, "movaps.s xmm0, [rax]")
	e = x64LineRejected(e, "addps xmm0, xmm1, xmm2")
	e = x64LineRejected(e, "shufps xmm0, xmm1, 256")
	e = x64LineErrorHas(e, "cvtsi2ss xmm0, [rax]", "ambiguous operand size")
	e = x64LineRejected(e, "addps xmm16, xmm1")
	e = x64LineRejected(e, "addps xmm01, xmm1")
	e = x64LineRejected(e, "mov eax, xmm0")
	e = x64LineRejected(e, "add xmm0, 1")
	e = x64LineRejected(e, "cmptrueps xmm0, xmm1")
	e = x64LineRejected(e, "cmpeqps xmm0, xmm1, 0")
	e = x64LineRejected(e, "lock addps xmm0, [rax]")
	e = x64LineRejected(e, "rep addps xmm0, xmm1")
	e = x64LineRejected(e, "rep movsd xmm0, xmm1")
	e = x64LineRejected(e, "repnz movsd qword ptr [rax], xmm9")
	e = x64LineRejected(e, "repne cmpsd xmm0, xmm1, 0")
	e = x64LineRejected(e, "rep movsd xmm0, qword ptr fs:[rax]")
	e = x64LineRejected(e, "lock movsd xmm0, qword ptr [rax]")
	e = x64LineRejected(e, "xacquire lock addps xmm0, [rax]")
	e = x64LineErrorHas(e, "cmpeqps xmm0, rax", "cmpeqps: takes other operands")
	e = x64LineErrorHas(e, "cvtsi2ss eax, [rax]", "cvtsi2ss: takes other operands")
	e = x64LineErrorHas(e, "cvtsi2ss xmm0, [rax], 1", "cvtsi2ss: takes other operands")
	e = x64LineRejected(e, "movsd xmm0")
	return e
}
