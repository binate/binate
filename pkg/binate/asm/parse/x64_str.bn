package "pkg/binate/asm/parse"

import "pkg/binate/asm/x64"
import "pkg/binate/asm/x64/prefix"
import "pkg/binate/asm/x64/strop"
import "pkg/binate/buf"

// The x86-64 string instructions (strop), as clang takes them: movs, cmps, scas, lods, stos, ins
// and outs, with the element's size as a suffix (b, w, d, q; ins and outs no q) and no operands,
// or with their operands written out, which give the size where the name does not (`movs byte
// ptr [rdi], byte ptr fs:[rsi]`, `cmps [rsi], dword ptr [rdi]`, `lods eax, [rsi]`, `stos [rdi],
// al`, `scas byte ptr [rdi]`, `ins byte ptr [rdi], dx`, `outs dx, word ptr [rsi]`).  An operand
// is exactly the [rsi] or [rdi] its instruction reads, or its accumulator or dx: [rdi] takes no
// segment override but es:, its own; [rsi] takes any, ds: (its own) emitting nothing, as clang.
// Another register, a displacement or the two swapped is an error, where clang ignores what is
// written there and GNU as warns.  (movsd and cmpsd also name SSE instructions of XMM registers,
// which the text parser does not take.)  XLAT (parseX64Xlat) is `xlatb`, or `xlat` with its
// [rbx] written, under the same rules: a byte, any segment, ds: emitting nothing.

// The string instructions (x64StrMnem).
const (
	x64StrMovs int = 0
	x64StrCmps int = 1
	x64StrScas int = 2
	x64StrLods int = 3
	x64StrStos int = 4
	x64StrIns int = 5
	x64StrOuts int = 6
)

// x64StrName returns the name of the string instruction kind (x64StrMovs ..), without a suffix.
func x64StrName(kind int) *[]readonly char {
	if kind == x64StrMovs { return "movs" }
	if kind == x64StrCmps { return "cmps" }
	if kind == x64StrScas { return "scas" }
	if kind == x64StrLods { return "lods" }
	if kind == x64StrStos { return "stos" }
	if kind == x64StrIns { return "ins" }
	return "outs"
}

// x64SuffixSize returns the operand size (x64.SZ8 .. SZ64) a size suffix names — b, w, d or q —
// or 0 for none.
func x64SuffixSize(c char) int {
	if c == 'b' || c == 'B' { return x64.SZ8 }
	if c == 'w' || c == 'W' { return x64.SZ16 }
	if c == 'd' || c == 'D' { return x64.SZ32 }
	if c == 'q' || c == 'Q' { return x64.SZ64 }
	return 0
}

// x64StrMnem returns the string instruction mnem names (x64StrMovs ..) and the element size its
// suffix gives (0 for none), or -1 if it names none.
func x64StrMnem(mnem *[]readonly char) (int, int) {
	for k := x64StrMovs; k <= x64StrOuts; k++ {
		var base *[]readonly char = x64StrName(k)
		if mnemIs(mnem, base) { return k, 0 }
		if len(mnem) != len(base) + 1 || !mnemIs(mnem[0:len(base)], base) { continue }
		var size int = x64SuffixSize(mnem[len(base)])
		if size == x64.SZ64 && k >= x64StrIns { return -1, 0 }
		if size != 0 { return k, size }
	}
	return -1, 0
}

// x64StrForm returns the n operands the string instruction kind takes written out, one
// character each — S its [rsi], D its [rdi], A its accumulator (al, ax, eax, rax), X dx — or ""
// if it takes no n.
func x64StrForm(kind int, n int) *[]readonly char {
	if n == 2 {
		if kind == x64StrMovs { return "DS" }
		if kind == x64StrCmps { return "SD" }
		if kind == x64StrScas { return "AD" }
		if kind == x64StrLods { return "AS" }
		if kind == x64StrStos { return "DA" }
		if kind == x64StrIns { return "DX" }
		return "XS"
	}
	if n == 1 {
		if kind == x64StrScas || kind == x64StrStos { return "D" }
		if kind == x64StrLods { return "S" }
	}
	return ""
}

// x64StrUsage returns the error message for operands the string instruction kind does not take.
func x64StrUsage(kind int) *[]readonly char {
	if kind == x64StrMovs { return "movs's operands are [rdi] and [rsi]" }
	if kind == x64StrCmps { return "cmps's operands are [rsi] and [rdi]" }
	if kind == x64StrScas { return "scas's operands are its accumulator and [rdi], or [rdi]" }
	if kind == x64StrLods { return "lods's operands are its accumulator and [rsi], or [rsi]" }
	if kind == x64StrStos { return "stos's operands are [rdi] and its accumulator, or [rdi]" }
	if kind == x64StrIns { return "ins's operands are [rdi] and dx" }
	return "outs's operands are dx and [rsi]"
}

// x64StrMemIs reports whether op is exactly [base]: no index, displacement or symbol.
func x64StrMemIs(op x64.Operand, base int) bool {
	return op.Kind == x64.OP_MEM && op.Base == base && op.Index < 0 && op.Disp == 0 &&
			len(op.Label) == 0 && !op.Abs && !op.Disp32 && !op.Addr64 && op.Fix == 0
}

// x64StrOperand checks the operand op, written with the segment override seg (0 for none),
// against role (x64StrForm) of the string instruction kind, and returns the element size so far:
// size, or op's when size is 0.  Else it sets the error.
func x64StrOperand(p @Parser, kind int, role char, op x64.Operand, seg int, size int) (int, bool) {
	if role == 'A' || role == 'X' {
		var reg int = x64.RAX
		if role == 'X' { reg = x64.RDX }
		if op.Kind != x64.OP_REG || op.Reg != reg || (role == 'X' && op.Size != x64.SZ16) {
			setErr(p, x64StrUsage(kind))
			return 0, false
		}
		if role == 'X' { return size, true }
	} else {
		var base int = x64.RSI
		if role == 'D' { base = x64.RDI }
		if !x64StrMemIs(op, base) {
			setErr(p, x64StrUsage(kind))
			return 0, false
		}
		if role == 'D' && seg != 0 && seg != prefix.SEG_ES {
			setErr(p, "a string instruction's [rdi] takes no segment override but es:, its own")
			return 0, false
		}
	}
	if op.Size == 0 { return size, true }
	if size != 0 && size != op.Size {
		setErr(p, "a string instruction's operands and name give different sizes")
		return 0, false
	}
	return op.Size, true
}

// parseX64String parses the operands of the string instruction kind (x64StrMovs ..), whose
// name's suffix gives the element size (0 for none), from l (just after its name), and emits it,
// after the segment override its [rsi] operand writes, if any.
func parseX64String(p @Parser, l Lexer, kind int, size int) {
	var ops @[]x64.Operand = make_slice(x64.Operand, 2)
	var segs @[]int = make_slice(int, 2)
	var n int = 0
	var tok Token
	l, tok = LexNext(l)
	for tok.Kind != TOK_EOF && n < 2 {
		if n > 0 {
			if tok.Kind != TOK_COMMA { break }
			l, tok = LexNext(l)
		}
		var op x64.Operand
		l, tok, op = parseX64Operand(p, l, tok)
		if p.HasError { return }
		ops[n] = op
		segs[n] = p.X64Seg
		p.X64Seg = 0
		n++
	}
	if !x64AtEOL(p, tok) { return }
	var form *[]readonly char = x64StrForm(kind, n)
	if n > 0 && len(form) == 0 {
		setErr(p, x64StrUsage(kind))
		return
	}
	var ok bool = true
	for i := 0; i < n; i++ {
		size, ok = x64StrOperand(p, kind, form[i], ops[i], segs[i], size)
		if !ok { return }
		if form[i] == 'S' && segs[i] != prefix.SEG_DS { p.X64Seg = segs[i] }
	}
	if size == 0 {
		setErr(p, buf.Concat("ambiguous operand size for ", x64StrName(kind)))
		return
	}
	x64EmitSeg(p)
	if kind == x64StrMovs { strop.Movs(p.Asm, size) }
	if kind == x64StrCmps { strop.Cmps(p.Asm, size) }
	if kind == x64StrScas { strop.Scas(p.Asm, size) }
	if kind == x64StrLods { strop.Lods(p.Asm, size) }
	if kind == x64StrStos { strop.Stos(p.Asm, size) }
	if kind == x64StrIns { strop.Ins(p.Asm, size) }
	if kind == x64StrOuts { strop.Outs(p.Asm, size) }
}

// parseX64Xlat parses xlatb or xlat (mnem; l just after it) and emits it: xlatb without operands,
// xlat with its operand written, exactly [rbx], a byte or of no size, in any segment (ds:, its
// own, emitting nothing).  clang ignores what xlat's operand says, segment included; GNU as warns
// on another address and emits the segment.
func parseX64Xlat(p @Parser, l Lexer, mnem *[]readonly char) {
	var tok Token
	l, tok = LexNext(l)
	if mnemIs(mnem, "xlatb") {
		if x64AtEOL(p, tok) { strop.Xlat(p.Asm) }
		return
	}
	if tok.Kind == TOK_EOF {
		setErr(p, "xlat takes its operand, byte ptr [rbx] (xlatb has none)")
		return
	}
	var op x64.Operand
	l, tok, op = parseX64Operand(p, l, tok)
	if p.HasError || !x64AtEOL(p, tok) { return }
	if !x64StrMemIs(op, x64.RBX) || (op.Size != 0 && op.Size != x64.SZ8) {
		setErr(p, "xlat takes byte ptr [rbx]")
		return
	}
	if p.X64Seg == prefix.SEG_DS { p.X64Seg = 0 }
	x64EmitSeg(p)
	strop.Xlat(p.Asm)
}
