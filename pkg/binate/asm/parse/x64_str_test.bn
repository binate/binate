package "pkg/binate/asm/parse"

import "pkg/builtins/testing"

// The string instructions (x64_str.bn) against clang's bytes (`clang --target=x86_64-linux-gnu
// -c`, `.intel_syntax noprefix`).  (x64SrcHex and x64LineRejected are in x64_target_test.bn.)

// Each instruction by its suffix, at each size; with its operands written out, sized by a `ptr`,
// its accumulator or its suffix, one sized operand enough; a segment override on [rsi] (ds:
// emitting nothing) and es: on [rdi] (nothing); a segment written as an instruction before it.
func TestX64StringInstructions() testing.TestResult {
	var e @[]char = ""
	e = x64SrcHex(e, "movsb", "a4")
	e = x64SrcHex(e, "movsw", "66 a5")
	e = x64SrcHex(e, "movsd", "a5")
	e = x64SrcHex(e, "movsq", "48 a5")
	e = x64SrcHex(e, "cmpsb", "a6")
	e = x64SrcHex(e, "cmpsq", "48 a7")
	e = x64SrcHex(e, "scasw", "66 af")
	e = x64SrcHex(e, "lodsd", "ad")
	e = x64SrcHex(e, "stosq", "48 ab")
	e = x64SrcHex(e, "insb", "6c")
	e = x64SrcHex(e, "insw", "66 6d")
	e = x64SrcHex(e, "insd", "6d")
	e = x64SrcHex(e, "outsb", "6e")
	e = x64SrcHex(e, "outsw", "66 6f")
	e = x64SrcHex(e, "outsd", "6f")
	e = x64SrcHex(e, "MOVSB", "a4")
	e = x64SrcHex(e, "Stosq", "48 ab")
	e = x64SrcHex(e, "movs byte ptr [rdi], byte ptr [rsi]", "a4")
	e = x64SrcHex(e, "movs qword ptr es:[rdi], qword ptr fs:[rsi]", "64 48 a5")
	e = x64SrcHex(e, "cmps word ptr gs:[rsi], word ptr es:[rdi]", "65 66 a7")
	e = x64SrcHex(e, "scas eax, dword ptr [rdi]", "af")
	e = x64SrcHex(e, "scas byte ptr [rdi]", "ae")
	e = x64SrcHex(e, "lods rax, qword ptr fs:[rsi]", "64 48 ad")
	e = x64SrcHex(e, "lods dword ptr [rsi]", "ad")
	e = x64SrcHex(e, "stos word ptr es:[rdi], ax", "66 ab")
	e = x64SrcHex(e, "stos qword ptr [rdi]", "48 ab")
	e = x64SrcHex(e, "ins dword ptr [rdi], dx", "6d")
	e = x64SrcHex(e, "ins dword ptr es:[rdi], dx", "6d")
	e = x64SrcHex(e, "outs dx, word ptr fs:[rsi]", "64 66 6f")
	e = x64SrcHex(e, "outs dx, dword ptr es:[rsi]", "26 6f")
	e = x64SrcHex(e, "movsb byte ptr [rdi], byte ptr [rsi]", "a4")
	e = x64SrcHex(e, "stosd dword ptr [rdi], eax", "ab")
	e = x64SrcHex(e, "movs byte ptr [rdi], [rsi]", "a4")
	e = x64SrcHex(e, "movs [rdi], byte ptr [rsi]", "a4")
	e = x64SrcHex(e, "movs byte ptr [rdi], byte ptr es:[rsi]", "26 a4")
	e = x64SrcHex(e, "movs byte ptr [rdi], byte ptr ds:[rsi]", "a4")
	e = x64SrcHex(e, "lods al, byte ptr cs:[rsi]", "2e ac")
	e = x64SrcHex(e, "lods al, byte ptr ss:[rsi]", "36 ac")
	e = x64SrcHex(e, "stos [rdi], al", "aa")
	e = x64SrcHex(e, "stos [rdi], eax", "ab")
	e = x64SrcHex(e, "scas al, [rdi]", "ae")
	e = x64SrcHex(e, "lods al, [rsi]", "ac")
	e = x64SrcHex(e, "movs byte ptr [rdi], byte ptr [rsi + 0]", "a4")
	e = x64SrcHex(e, "stosb [rdi], al", "aa")
	e = x64SrcHex(e, "stosb [rdi]", "aa")
	e = x64SrcHex(e, "movsd [rdi], [rsi]", "a5")
	e = x64SrcHex(e, "movsq [rdi], [rsi]", "48 a5")
	e = x64SrcHex(e, "cmpsb [rsi], [rdi]", "a6")
	e = x64SrcHex(e, "scasb al, [rdi]", "ae")
	e = x64SrcHex(e, "insb [rdi], dx", "6c")
	e = x64SrcHex(e, "outsd dx, [rsi]", "6f")
	e = x64SrcHex(e, "fs movsb", "64 a4")
	return e
}

// What clang rejects — no quadword ins / outs, no size, sizes that differ, a segment override
// other than es: on [rdi], another accumulator or port, the wrong operands — and what clang
// encodes without reading it: another register than rsi / rdi, a displacement, an index, the two
// swapped.
func TestX64StringRejects() testing.TestResult {
	var e @[]char = ""
	e = x64LineRejected(e, "insq")
	e = x64LineRejected(e, "outsq")
	e = x64LineRejected(e, "movs")
	e = x64LineRejected(e, "movs [rdi], [rsi]")
	e = x64LineRejected(e, "lods [rsi]")
	e = x64LineRejected(e, "ins [rdi], dx")
	e = x64LineRejected(e, "movs byte ptr [rdi], word ptr [rsi]")
	e = x64LineRejected(e, "movsb word ptr [rdi], word ptr [rsi]")
	e = x64LineRejected(e, "stosb [rdi], ax")
	e = x64LineRejected(e, "scas eax, byte ptr [rdi]")
	e = x64LineRejected(e, "movs byte ptr fs:[rdi], byte ptr [rsi]")
	e = x64LineRejected(e, "stos byte ptr ds:[rdi], al")
	e = x64LineRejected(e, "ins dword ptr fs:[rdi], dx")
	e = x64LineRejected(e, "stos byte ptr [rdi], cl")
	e = x64LineRejected(e, "lods dx, word ptr [rsi]")
	e = x64LineRejected(e, "ins byte ptr [rdi], al")
	e = x64LineRejected(e, "ins byte ptr [rdi], edx")
	e = x64LineRejected(e, "ins qword ptr [rdi], dx")
	e = x64LineRejected(e, "outs dx, qword ptr [rsi]")
	e = x64LineRejected(e, "movs xmmword ptr [rdi], xmmword ptr [rsi]")
	e = x64LineRejected(e, "lods al")
	e = x64LineRejected(e, "stos al")
	e = x64LineRejected(e, "scasb al")
	e = x64LineRejected(e, "insb dx")
	e = x64LineRejected(e, "movsb al")
	e = x64LineRejected(e, "movs byte ptr [rdi]")
	e = x64LineRejected(e, "movs byte ptr [rdi], byte ptr [rsi], 1")
	e = x64LineRejected(e, "movs byte ptr [rdi], byte ptr [lbl]")
	e = x64LineRejected(e, "movs byte ptr [rsi], byte ptr [rdi]")
	e = x64LineRejected(e, "cmps byte ptr [rdi], byte ptr [rsi]")
	e = x64LineRejected(e, "movs byte ptr [rdi], byte ptr [rax]")
	e = x64LineRejected(e, "movs byte ptr [rdi + 8], byte ptr [rsi]")
	e = x64LineRejected(e, "movs byte ptr [rdi], byte ptr [rsi + rax]")
	e = x64LineRejected(e, "movs byte ptr [rdi], byte ptr [rip]")
	return e
}
